+    if value == "nova_rt_len" or value == "nova_rt_len_any" or value == "nova_rt_str_len" or value == "nova_rt_dict_len" or value == "nova_rt_find" or value == "nova_rt_index_of" or value == "nova_rt_str_count" or value == "nova_rt_char_count"
