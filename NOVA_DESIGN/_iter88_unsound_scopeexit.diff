+        return true
+    if value == "nova_rt_regex_replace" or value == "nova_rt_regex_replace_all"
+        return true
+    if value == "nova_rt_split" or value == "nova_rt_splitlines" or value == "nova_rt_regex_split" or value == "nova_rt_regex_find_all" or value == "nova_rt_chars" or value == "nova_rt_range" or value == "nova_rt_range_from_to"
+        return true
+    if value == "nova_rt_list_map" or value == "nova_rt_list_filter" or value == "nova_rt_dict_keys" or value == "nova_rt_dict_values" or value == "nova_rt_dict_items"
+        return true
+    false
