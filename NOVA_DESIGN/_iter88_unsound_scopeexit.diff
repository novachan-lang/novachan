+// pointer-validated (0/non-heap -> no-op) and the ASAN gate is the empirical backstop.
+fn _rc_owned_producer(value: string) -> bool
+    if value == "nova_rt_str_concat" or value == "nova_rt_int_to_str" or value == "nova_rt_float_to_str" or value == "nova_rt_bool_to_str" or value == "nova_rt_any_to_str"
+        return true
+    if value == "nova_rt_slice" or value == "nova_rt_upper" or value == "nova_rt_lower" or value == "nova_rt_trim" or value == "nova_rt_lstrip" or value == "nova_rt_rstrip" or value == "nova_rt_repeat"
+        return true
