+// ── §18 bridge: fold a face's read-set into a runtime-registrable multi-word bitmask ──
+//
+// PRISM_M3_4_REACTIVITY_DESIGN.md §18: readset_of computes WHICH leaf paths a face reads; this
+// section turns that into WHERE each leaf lives in a fixed bit numbering, and folds a face's
+// read-set into that numbering. §3's whole performance argument ("intersection is a bitmask
+// AND, not a graph walk") requires the numbering to be STABLE across compilations of the SAME
+// source -- so it is derived from each struct's DECLARED field order (tables.sdefs, itself
+// built by a plain top-to-bottom sweep of the parsed program, build_readset_tables ~34592),
+// never from dict iteration. A single uint64 (the shape @redact's ir_sredact/redact_mask uses,
+// ~26628 / nova_runtime.c:22296) is NOT enough: §18 measured PrismConState at 134 reachable
+// leaves, so the mask here is a WORD ARRAY (index = leaf/64, bit = leaf%64), matching §18's own
+// recommendation over an interned-path-set id (which would lose the "one instruction" property).
+
+type FaceReadsetInfo
+    leaf_count: int     // total reachable leaves of the face's state type (informational only
+                         // for now -- nothing consumes it yet; a future changeset/invalidation
+                         // slice sizes a changeset bitmask against this SAME numbering)
+    words: list           // list<int> -- word i covers leaves [64*i, 64*i+64); bit j of word i
+                          // is set iff leaf (64*i+j) is a key of the face's read-set
+
+// Enumerate ALL reachable leaf paths of `type_name` (a struct or enum-variant name), in a FIXED
+// depth-first order determined SOLELY by each struct's DECLARED field order -- the numbering
+// leaf-index-to-bit assignment is built on. Mirrors readset_of's own "leaf vs struct field" rule
+// exactly (§15.2 point 4, rs_walk_expr ~34799): a field whose declared type is itself a known
+// struct is expanded IN PLACE (so a face's dotted read-set paths, e.g. "inventory.gold", always
+// resolve to a path this same enumeration also produces); any other declared type terminates the
+// path there as a leaf.
+//
+// `visiting` tracks types on the CURRENT path only (removed via `del` on the way back out, not
+// "ever seen") -- so two sibling fields of the SAME struct type (two Address fields on one
+// Order, say) both expand fully and independently. A type re-entered while still an ancestor of
+// itself (a cyclic struct graph, which could never be a finite-size value anyway) is treated as
+// a leaf instead of recursing forever -- defensive robustness, not a real program shape this
+// corpus contains.
+fn leaf_paths_of(type_name: string, tables: ReadsetTables, prefix: string, visiting: dict, out: list)
+    if not contains(tables.sdefs, type_name) or contains(visiting, type_name)
+        if prefix != ""
+            push(out, prefix)
+        return
+    let fields = tables.sdefs[type_name]
+    if len(fields) == 0
+        if prefix != ""
+            push(out, prefix)
+        return
+    visiting[type_name] = 1
+    for p in fields
+        match p
+            Param(pname, ptype, pdefault) =>
+                let path = pname
+                if prefix != ""
+                    path = prefix + "." + pname
+                leaf_paths_of(ptype, tables, path, visiting, out)
+    del(visiting, type_name)
+
+// Fold a face's read-set (leaf-path -> 1, from readset_of) into a multi-word bitmask over
+// `leaves` (the FULL declared-order leaf enumeration from leaf_paths_of): bit j of word i is set
+// iff leaves[64*i + j] is a key of `readset`. Word count = ceil(len(leaves) / 64) -- NEVER
+// silently truncated to one word the way `ir_sredact`'s single uint64 is (that cap is fine for
+// @redact's real-world field counts; it is NOT fine for a 134-leaf state type). `1 << 63` is
+// exact in NOVA (verified: shifts 1..63 all produce the correct two's-complement bit pattern --
+// only a shift COUNT of 64 is broken), so a word genuinely covers all 64 bits, not 63.
+fn fold_readset_mask(readset: dict, leaves: list) -> list
+    let word_count = (len(leaves) + 63) / 64
+    let words = []
+    let wi = 0
+    while wi < word_count
+        push(words, 0)
+        wi = wi + 1
+    let i = 0
+    for leaf in leaves
+        if contains(readset, leaf)
+            let word_idx = i / 64
+            let bit = i % 64
+            words[word_idx] = words[word_idx] + (1 << bit)
+        i = i + 1
+    words
+
+// Does `annotations` (a Stmt's annotation list) carry `@face`? Factored out because
+// build_face_readsets needs the same test twice (a whole-program fast-path scan, then a
+// per-function check) -- mirrors check_face_annotations's own two-pass shape (~34912).
+fn _has_face_annotation(annotations: list) -> bool
+    for a in annotations
+        match a
+            Expr(at, av, an2, ac, af, al) =>
+                if at == "ann" and av == "face"
