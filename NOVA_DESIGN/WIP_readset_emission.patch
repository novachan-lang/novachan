+    false
+
+// The other half of §18's bridge: for every `@face` function in the fully-desugared program,
+// compute its read-set (readset_of) and fold it (fold_readset_mask) into a multi-word bitmask
+// over its state parameter's full leaf enumeration (leaf_paths_of) -- exactly the data a
+// `nova_rt_register_face_readset_*` call needs. Called once per compilation from
+// compile_ir_core_named, stashed on IrBuilder (b.ir_face_readsets) for the @main emission pass
+// to register at runtime, following the nova_rt_register_struct_redact call-emission pattern
+// (~29364).
+//
+// By the time this runs (post parse_program), every @face function has ALREADY passed
+// check_face_annotations's rules 1-3 -- a violation is a fatal parse_errors exit(1) long before
+// compile_ir_core_named even builds an IrBuilder -- so "at least one struct-typed parameter" is
+// guaranteed for any program that reached codegen. The `if sp_type != ""` guard below is
+// defensive only: this function makes no assumption that its caller always went through that
+// gate (e.g. a KAT may call it directly against a hand-built fixture).
+//
+// "The state parameter" = the FIRST parameter (in declared order) whose type is a known struct
+// -- the canonical `f(s: T) -> Node` shape §3/§4 assume throughout; a face with more than one
+// struct-typed parameter is not a shape this design has a story for yet (none exist in the
+// corpus today), so only the first is registered rather than guessing which one matters.
+fn build_face_readsets(stmts: list) -> dict
+    let any_face = false
+    for s in stmts
+        match s
+            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
+                if tag == "fn" and _has_face_annotation(annotations)
+                    any_face = true
+    if not any_face
+        return {}
+    let tables = build_readset_tables(stmts)
+    let ctx = ReadsetCtx(tables, {})
+    let result = {}
+    let seen = {}
+    for s in stmts
+        match s
+            Stmt(tag, name, ret_expr, body, params, else_body, annotations, sline) =>
+                if tag == "fn" and not ends_with(name, "__ens_impl") and not ends_with(name, "__memo_impl") and _has_face_annotation(annotations) and not contains(seen, name)
+                    seen[name] = 1
+                    let sp_name = ""
+                    let sp_type = ""
+                    for p in params
+                        match p
+                            Param(pname, ptype, pdefault) =>
+                                if sp_type == "" and contains(tables.sdefs, ptype)
+                                    sp_name = pname
+                                    sp_type = ptype
+                    if sp_type != ""
+                        let leaves = []
+                        leaf_paths_of(sp_type, tables, "", {}, leaves)
+                        let rs = readset_of(name, sp_name, sp_type, ctx)
+                        let words = fold_readset_mask(rs, leaves)
+                        result[name] = FaceReadsetInfo(len(leaves), words)
+    result
+
