+/* ── Face read-set registry (PRISM M3.4 §3's runtime bridge, PRISM_M3_4_REACTIVITY_DESIGN.md
+   §18) ── The compiler folds each `@face` function's read-set (readset_of + build_face_readsets,
+   nova_compiler.nova ~34861/~35060) into a bitmask over its state type's leaf paths at compile
+   time, and emits a registration call here -- the EXACT same shape as the struct-redact registry
+   above (a meta call establishes the entry, then per-index calls fill it in). The one thing that
+   is NOT the same shape: `redact_mask` is a single uint64_t, which §18 measured is not enough --
+   the real corpus's PrismConState has 134 reachable leaves. So this is a WORD ARRAY, word i
+   covering leaves [64i, 64i+64), keeping invalidation a register-level AND across a handful of
+   words rather than forcing a hash-set lookup. Keyed by `face_id` = type_name_hash(face_name)
+   (the SAME compile-time DJB2 hash used for struct-name hashing, nova_compiler.nova ~11754) --
+   a face is a FUNCTION, not a type, so it gets its own id space rather than borrowing a struct's.
+
+   SCOPE: this only STORES the data so it exists at runtime. Nothing consumes it yet --
+   invalidation (AND against a changeset) is a later slice (§3/§4b). */
+typedef struct {
+    int64_t   face_id;
+    int32_t   leaf_count;   /* total reachable leaves of the state type; informational only for
+                                now, kept so a future changeset slice can size itself against the
+                                SAME leaf numbering without re-deriving it */
+    int32_t   word_count;
+    uint64_t* words;        /* calloc'd to word_count words; NULL (and word_count reset to 0) if
+                                allocation failed at registration time -- fails closed to "no
+                                words stored", exactly like nova_rt_register_struct_meta above
+                                does for its fnames/ftypes arrays, never aborts the process */
+} NovaFaceReadset;
+#define NOVA_MAX_FACE_READSETS 4096
+static NovaFaceReadset g_face_readset[NOVA_MAX_FACE_READSETS];
+static int             g_face_readset_count = 0;
+void nova_rt_register_face_readset_meta(int64_t face_id, int64_t leaf_count, int64_t word_count) {
+    if (g_face_readset_count >= NOVA_MAX_FACE_READSETS) return;
+    for (int i = 0; i < g_face_readset_count; i++)
+        if (g_face_readset[i].face_id == face_id) return;   /* idempotent */
+    int wc = (int)word_count; if (wc < 0) wc = 0;
+    uint64_t* w = NULL;
+    if (wc > 0) {
+        w = (uint64_t*)calloc((size_t)wc, sizeof(uint64_t));
+        if (!w) wc = 0;   /* OOM: store an empty (zero-word) entry rather than crash or corrupt */
+    }
+    int idx = g_face_readset_count++;
+    g_face_readset[idx].face_id    = face_id;
+    g_face_readset[idx].leaf_count = (int32_t)((leaf_count < 0) ? 0 : leaf_count);
+    g_face_readset[idx].word_count = (int32_t)wc;
+    g_face_readset[idx].words      = w;
+}
+void nova_rt_register_face_readset_word(int64_t face_id, int64_t word_idx, int64_t word_bits) {
+    for (int i = 0; i < g_face_readset_count; i++) {
