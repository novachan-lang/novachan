+// TIER 1: return-position unification. For a function WITH a concrete return annotation
+// (is_open=false) this is strict (a `-> int` that returns a string must error). For an
+// UN-annotated function (is_open=true) it does an eager TOLERANT JOIN of the return types:
+// the first concrete return sets the type; a later return of a DIFFERENT concrete kind widens
+// the return var to `any` (heterogeneous returns are legal — NOVA's zero-annotation, first-class
+// `any` thesis); unit/nothing/var are absorbed (an early `return 0` in an otherwise-unit
+// procedure stays its inferred type, not a false int-vs-unit conflict). When all returns AGREE
+// the concrete type is preserved (no perf/typing loss for the common case).
+fn ti_ret_constrain(st: TiState, retvar: NType, rt: NType, line: int, is_open: bool)
+    if not is_open
+        ti_constrain(st, retvar, rt, line)
+        return
+    match retvar
+        NType(rvk, rvn, rvp, rv_id) =>
+            if rvk != "var"
+                // ret var already concrete (e.g. bound to `any`) — nothing to narrow
+                return
+            let wr = ti_walk(st, retvar)
+            let wt = ti_walk(st, rt)
+            match wr
+                NType(rk, rn, rp, ri) =>
+                    if rk == "any"
+                        return
+                    if rk == "var"
+                        // first concrete return sets the type (later disagreement widens below)
+                        match wt
+                            NType(tk, tn, tp, tid) =>
+                                if tk != "var"
+                                    ti_bind(st, rv_id, wt)
+                        return
+                    // retvar already a concrete non-any type: compare the incoming kind
+                    match wt
+                        NType(tk, tn, tp, tid) =>
+                            if tk == "var" or tk == "any" or tk == "unit" or tk == "nothing"
+                                return
+                            if tk == rk
+                                return
+                            // genuine concrete conflict among un-annotated returns -> widen to `any`
+                            ti_bind(st, rv_id, nt_any())
+
