// ============================================================================
// NOVA Standard Library — std/web/url_builder
// ============================================================================
// Incremental URL construction: start from a base, append path segments and
// query parameters one call at a time, then build the final string. Complements
// std/net/uri (parse a URI you already have) and std/net/querystring (encode a
// whole dict of params at once, sorted) — this module is for the common
// imperative pattern of assembling a URL a piece at a time, preserving the
// EXACT order params were added (not sorted, unlike qs_build).
//
// Percent-encoding is delegated entirely to std/encoding/percent's
// pct_encode_component (RFC 3986: unreserved chars A-Za-z0-9-._~ pass
// through, everything else becomes %XX) — no encoding logic is duplicated
// here.
//
// Internal dict layout:
//   b["base"]     : string        base URL, trailing '/' stripped
//   b["path"]     : list of string  raw (unencoded) path segments, in order
//   b["params"]   : list of [key,val]  raw (unencoded) query pairs, in order
//                                       (each element is a 2-element list)
//   b["fragment"] : string        raw (unencoded) fragment, "" if unset
//
// Public API (prefix ub_):
//   ub_new(base)              -> dict     create a builder from a base URL
//   ub_path(b, segment)                  append one path segment
//   ub_param(b, key, val)                append one query parameter
//   ub_fragment(b, frag)                 set (or replace) the fragment
//   ub_build(b)                -> string  assemble the final URL
//   ub_params_str(b)           -> string  just the "k1=v1&k2=v2" query string
//                                        (no leading '?'), "" if no params
//
// Every path segment, key, value, and the fragment are percent-encoded
// independently when building — a segment or value containing '/', '?', '&',
// '=', or '#' is safely escaped and cannot corrupt the resulting URL's
// structure. Duplicate parameter keys are preserved (both instances appear
// in the query string, e.g. ub_param twice with key "tag" yields
// "tag=a&tag=b") — the caller controls repetition, this module never dedupes.
//
// LEAF (besides percent) — imports only std/encoding/percent (also a leaf).
// ============================================================================

import std/encoding/percent

// ── ub_new ────────────────────────────────────────────────────────────────────
// Creates a builder from a base URL. A single trailing '/' on base is
// stripped so ub_new("https://x.com") and ub_new("https://x.com/") behave
// identically once path segments are appended.
//
// Examples:
//   ub_new("https://api.example.com")   -> base "https://api.example.com"
//   ub_new("https://api.example.com/")  -> base "https://api.example.com"
fn ub_new(base: string) -> dict
    let b = {}
    let trimmed = base
    let n = len(base)
    if n > 0 and char_at(base, n - 1) == "/"
        trimmed = slice(base, 0, n - 1)
    b["base"] = trimmed
    b["path"] = []
    b["params"] = []
    b["fragment"] = ""
    return b

// ── ub_path ───────────────────────────────────────────────────────────────────
// Appends one raw (unencoded) path segment. Percent-encoding happens at
// ub_build time, so segments may safely contain any character, including
// '/', which will be escaped (a segment is treated as one opaque unit, not
// itself a multi-segment sub-path).
fn ub_path(b: dict, segment: string)
    let path = b["path"]
    path.push(segment)

// ── ub_param ──────────────────────────────────────────────────────────────────
// Appends one raw (unencoded) query parameter, preserving insertion order.
// Calling ub_param with the same key more than once adds multiple entries
// (no deduplication or overwrite).
fn ub_param(b: dict, key: string, val: string)
    let params = b["params"]
    let pair = [key, val]
    params.push(pair)

// ── ub_fragment ───────────────────────────────────────────────────────────────
// Sets (or replaces) the raw (unencoded) URL fragment.
fn ub_fragment(b: dict, frag: string)
    b["fragment"] = frag

// ── ub_params_str ─────────────────────────────────────────────────────────────
// Returns just the query string "k1=v1&k2=v2" (no leading '?'), with keys
// and values percent-encoded, in the exact order they were added via
// ub_param. Returns "" if no parameters were added.
fn ub_params_str(b: dict) -> string
    let params = b["params"]
    let n = len(params)
    let out = ""
    for i in 0..n
        let pair = params[i]
        let enc_k = pct_encode_component(pair[0])
        let enc_v = pct_encode_component(pair[1])
        if i == 0
            out = enc_k + "=" + enc_v
        else
            out += "&" + enc_k + "=" + enc_v
    return out

// ── ub_build ──────────────────────────────────────────────────────────────────
// Assembles the final URL: base, then each path segment percent-encoded and
// '/'-joined, then "?" + ub_params_str(b) if any params were added, then
// "#" + percent-encoded fragment if one was set.
//
// Example:
//   let b = ub_new("https://api.example.com")
//   ub_path(b, "users")
//   ub_path(b, "42")
//   ub_param(b, "sort", "name")
//   ub_param(b, "q", "a b")
//   ub_fragment(b, "top")
//   ub_build(b) -> "https://api.example.com/users/42?sort=name&q=a%20b#top"
fn ub_build(b: dict) -> string
    let result = b["base"]
    let path = b["path"]
    let np = len(path)
    for i in 0..np
        result += "/" + pct_encode_component(path[i])
    let qs = ub_params_str(b)
    if len(qs) > 0
        result += "?" + qs
    let frag = b["fragment"]
    if len(frag) > 0
        result += "#" + pct_encode_component(frag)
    return result
