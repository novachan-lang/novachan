// ============================================================================
// NOVA Standard Library — std/functional/ftakewhile.nova
// Prefix-splitting combinators: take_while, drop_while, span.
// Pure NOVA, no imports.
// ============================================================================

// ftw_take_while(pred, xs) — returns the longest prefix of xs for which pred is true.
fn ftw_take_while(pred, xs)
    let result = []
    let i = 0
    let n = len(xs)
    while i < n
        if not pred(xs[i])
            return result
        push(result, xs[i])
        i += 1
    result

// ftw_drop_while(pred, xs) — returns xs with the leading pred-true prefix removed.
fn ftw_drop_while(pred, xs)
    let i = 0
    let n = len(xs)
    while i < n
        if not pred(xs[i])
            return xs[i:]
        i += 1
    []

// ftw_span(pred, xs) — splits xs into [taken, dropped] where taken=take_while and dropped=drop_while.
fn ftw_span(pred, xs)
    let taken = []
    let i = 0
    let n = len(xs)
    while i < n
        if not pred(xs[i])
            let result = []
            push(result, taken)
            push(result, xs[i:])
            return result
        push(taken, xs[i])
        i += 1
    let result = []
    push(result, taken)
    push(result, [])
    result
