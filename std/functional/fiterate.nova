// ============================================================================
// NOVA Standard Library — std/functional/fiterate.nova
// Iterative application of a function: apply_n, iterate / nest_list.
// Pure NOVA, no imports. All fns take a function argument.
// ============================================================================

// fi_apply_n(f, n, x) — apply unary f to x exactly n times.
// fi_apply_n(f, 0, x) returns x unchanged.
fn fi_apply_n(f, n, x)
    let v = x
    for i in 0..n
        v = f(v)
    v

// fi_iterate(f, x, n) — list of the first n iterates starting at x.
// Returns [x, f(x), f(f(x)), ...] with n elements total.
// fi_iterate(f, x, 0) returns [].
fn fi_iterate(f, x, n)
    let result = []
    if n <= 0
        return result
    let v = x
    push(result, v)
    for i in 1..n
        v = f(v)
        push(result, v)
    result

// fi_nest_list(f, x, n) — alias for fi_iterate; Mathematica-style name.
// Returns [x, f(x), f(f(x)), ...] with n elements total.
fn fi_nest_list(f, x, n)
    fi_iterate(f, x, n)
