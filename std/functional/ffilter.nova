// ============================================================================
// NOVA Standard Library — std/functional/ffilter.nova
// Filter higher-order functions: select or reject elements by predicate.
// Pure NOVA, no imports. Leaf module — imports nothing.
// ============================================================================

// ff_filter(pred, xs) — returns a new list containing only elements where pred(x) is true.
fn ff_filter(pred, xs)
    let result = []
    for i in 0..len(xs)
        if pred(xs[i])
            push(result, xs[i])
    result

// ff_reject(pred, xs) — returns a new list containing only elements where pred(x) is false.
fn ff_reject(pred, xs)
    let result = []
    for i in 0..len(xs)
        if not pred(xs[i])
            push(result, xs[i])
    result

// ff_partition(pred, xs) — returns a 2-element list [kept, rejected] splitting xs by pred.
fn ff_partition(pred, xs)
    let kept = []
    let rejected = []
    for i in 0..len(xs)
        if pred(xs[i])
            push(kept, xs[i])
        else
            push(rejected, xs[i])
    let result = []
    push(result, kept)
    push(result, rejected)
    result
