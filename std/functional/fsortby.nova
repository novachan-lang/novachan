// ============================================================================
// NOVA Standard Library — std/functional/fsortby.nova
// Higher-order sort/min/max by a key function.
// Pure NOVA, no imports. All fns take a function argument.
// ============================================================================

// fs_sort_by(keyfn, xs) — stable ascending sort by keyfn(element).
// Uses done-flag insertion sort to guarantee stability without sentinel tricks.
fn fs_sort_by(keyfn, xs)
    let n = len(xs)
    if n == 0
        return []
    // Copy into a mutable result list.
    let result = [xs[ci] for ci in 0..n]
    // Insertion sort with done flag — no negative-index sentinel needed.
    for i in 1..n
        let cur = result[i]
        let cur_key = keyfn(cur)
        let j = i - 1
        let done = false
        while j >= 0 and not done
            let jkey = keyfn(result[j])
            if jkey > cur_key
                result[j + 1] = result[j]
                j = j - 1
            else
                done = true
        result[j + 1] = cur
    result

// fs_min_by(keyfn, xs) — element in xs with the smallest keyfn value.
// Returns null on empty list.
fn fs_min_by(keyfn, xs)
    let n = len(xs)
    if n == 0
        return null
    let best = xs[0]
    let best_key = keyfn(xs[0])
    for i in 1..n
        let k = keyfn(xs[i])
        if k < best_key
            best = xs[i]
            best_key = k
    best

// fs_max_by(keyfn, xs) — element in xs with the largest keyfn value.
// Returns null on empty list.
fn fs_max_by(keyfn, xs)
    let n = len(xs)
    if n == 0
        return null
    let best = xs[0]
    let best_key = keyfn(xs[0])
    for i in 1..n
        let k = keyfn(xs[i])
        if k > best_key
            best = xs[i]
            best_key = k
    best
