// ============================================================================
// NOVA Standard Library — std/functional/freduce.nova
// Reduce higher-order functions: fold, scanl over a list.
// Pure NOVA, no imports. Leaf module — imports nothing.
// ============================================================================

// fr_foldl(f, init, xs) — left fold: accumulate from left with f(acc, x), returns final value.
fn fr_foldl(f, init, xs)
    let acc = init
    let i = 0
    while i < len(xs)
        acc = f(acc, xs[i])
        i = i + 1
    acc

// fr_foldr(f, init, xs) — right fold: accumulate from right with f(x, acc), returns final value.
fn fr_foldr(f, init, xs)
    let acc = init
    let i = len(xs) - 1
    while i >= 0
        acc = f(xs[i], acc)
        i = i - 1
    acc

// fr_scanl(f, init, xs) — returns list of successive accumulator values including init.
fn fr_scanl(f, init, xs)
    let result = []
    let acc = init
    push(result, acc)
    let i = 0
    while i < len(xs)
        acc = f(acc, xs[i])
        push(result, acc)
        i = i + 1
    result
