// ============================================================================
// NOVA Standard Library — std/functional/fpredicate.nova
// Predicate combinators: all, any, none, count, find_index over a list.
// Pure NOVA, no imports. All functions take a predicate fn and a list.
// ============================================================================

// fpr_all(pred, xs) — returns true iff pred(x) is true for every element in xs.
fn fpr_all(pred, xs)
    for i in 0..len(xs)
        if not pred(xs[i])
            return false
    true

// fpr_any(pred, xs) — returns true iff pred(x) is true for at least one element in xs.
fn fpr_any(pred, xs)
    for i in 0..len(xs)
        if pred(xs[i])
            return true
    false

// fpr_none(pred, xs) — returns true iff pred(x) is false for every element in xs.
fn fpr_none(pred, xs)
    for i in 0..len(xs)
        if pred(xs[i])
            return false
    true

// fpr_count(pred, xs) — returns the number of elements in xs for which pred is true.
fn fpr_count(pred, xs)
    len([x for x in xs if pred(x)])

// fpr_find_index(pred, xs) — returns the first index where pred is true, or -1 if none.
fn fpr_find_index(pred, xs)
    for i in 0..len(xs)
        if pred(xs[i])
            return i
    -1
