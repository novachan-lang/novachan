// ============================================================================
// NOVA Standard Library — std/functional/fcombinator.nova
// Basic function combinators: flip, on, apply, apply2, twice.
// Pure NOVA, no imports. Leaf module.
// ============================================================================

// fc_flip(f, a, b) — calls f with arguments reversed: f(b, a).
fn fc_flip(f, a, b)
    f(b, a)

// fc_on(f, g, a, b) — applies g to both a and b, then combines with f: f(g(a), g(b)).
fn fc_on(f, g, a, b)
    let ga = g(a)
    let gb = g(b)
    f(ga, gb)

// fc_apply(f, x) — applies f to x: f(x). Identity combinator.
fn fc_apply(f, x)
    f(x)

// fc_apply2(f, a, b) — applies f to two arguments: f(a, b).
fn fc_apply2(f, a, b)
    f(a, b)

// fc_twice(f, x) — applies f to x twice: f(f(x)).
fn fc_twice(f, x)
    let inner = f(x)
    f(inner)
