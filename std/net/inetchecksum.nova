// ============================================================================
// NOVA Standard Library — std/net/inetchecksum
// ============================================================================
// RFC 1071 ones-complement 16-bit internet checksum used by IPv4 headers,
// ICMP, UDP, and TCP.  Pure NOVA, no imports, no UB, fully bounds-checked.
//
// PUBLIC API:
//   inet_checksum(b: bytes) -> int
//     Compute the RFC 1071 internet checksum over all bytes in b.
//     Returns a 16-bit value in [0, 0xFFFF].
//     Special case: empty input → 0xFFFF (ones-complement of zero).
//     Odd-length input: last byte is treated as the HIGH byte of a word
//     (its corresponding low byte is implicitly 0x00), per RFC 1071 §4.1.
//
//   inet_checksum_verify(b: bytes) -> bool
//     Returns true iff the ones-complement sum of all 16-bit words in b
//     equals 0xFFFF (i.e. the stored checksum is correct).
//     Use this after embedding the checksum field in the header.
//
//   inet_add_words(a: int, b: int) -> int
//     Ones-complement 16-bit addition with carry fold.
//     a and b must be in [0, 0xFFFF].  Result is in [0, 0xFFFF].
//     Carries above bit 15 are folded back into bit 0, per RFC 1071 §3.
//
// DESIGN NOTES:
//   * NOVA ints are signed 64-bit; accumulator stays safely under 2^32 for
//     any input up to ~2 MB, so no overflow occurs before the carry folds.
//   * >> is ARITHMETIC in NOVA; we always mask with & 0xFFFF after every
//     right-shift to stay in [0, 0xFFFF].
//   * All private helpers carry the _ick_ prefix to avoid symbol collisions.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Fold a 32-bit accumulator until no carry remains above bit 15,
// then return the ones-complement (bitwise NOT, masked to 16 bits).
fn _ick_fold_and_complement(acc: int) -> int
    while (acc >> 16) != 0
        acc = (acc & 0xFFFF) + ((acc >> 16) & 0xFFFF)
    return (~acc) & 0xFFFF

// ── Public API ────────────────────────────────────────────────────────────────

// inet_checksum(b) -> 16-bit RFC 1071 checksum.
// Empty input → 0xFFFF (ones-complement of zero-sum).
// Odd-length input → last byte placed in high byte of final word.
fn inet_checksum(b) -> int
    let acc = 0
    let i = 0
    let n = bytes_len(b)
    while i + 1 < n
        acc = acc + ((bytes_get(b, i) << 8) | bytes_get(b, i + 1))
        i = i + 2
    if i < n
        acc = acc + (bytes_get(b, i) << 8)
    return _ick_fold_and_complement(acc)

// inet_checksum_verify(b) -> true if the included checksum is correct.
// Computes the ones-complement sum of all 16-bit words; a correct header
// yields a sum of 0xFFFF after carry folding (the complement of 0x0000).
fn inet_checksum_verify(b) -> bool
    let acc = 0
    let i = 0
    let n = bytes_len(b)
    while i + 1 < n
        acc = acc + ((bytes_get(b, i) << 8) | bytes_get(b, i + 1))
        i = i + 2
    if i < n
        acc = acc + (bytes_get(b, i) << 8)
    while (acc >> 16) != 0
        acc = (acc & 0xFFFF) + ((acc >> 16) & 0xFFFF)
    return acc == 0xFFFF

// inet_add_words(a, b) -> ones-complement 16-bit sum with carry fold.
// a and b must each be in [0, 0xFFFF].
fn inet_add_words(a, b) -> int
    let s = a + b
    s = (s & 0xFFFF) + ((s >> 16) & 0xFFFF)
    return s & 0xFFFF
