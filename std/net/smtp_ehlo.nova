// ============================================================================
// NOVA Standard Library — std/net/smtp_ehlo
// ============================================================================
// EHLO response extension parsing (RFC 5321 §4.1.1.1 / RFC 1869).
//
// An EHLO reply is a 250 multi-line reply whose FIRST line is the server's
// greeting (domain + optional text) and whose remaining lines are one
// "ehlo-keyword [SP ehlo-param]" extension announcement each, e.g.:
//   250-mail.example.com
//   250-SIZE 10485760
//   250-STARTTLS
//   250 AUTH PLAIN LOGIN
//
// This module parses the EXTENSION lines (greeting already stripped by the
// caller — e.g. via std/net/smtp_line's smtp_ehlo_caps, or lines[1:] of
// std/net/smtp_response's line-by-line "text" accumulation).
//
// PUBLIC API:
//   smtp_ehlo_parse(lines: list) -> dict
//     Map each extension line to {NAME (uppercased) -> param string}.
//     "SIZE 10485760"    -> key "SIZE", value "10485760"
//     "STARTTLS"         -> key "STARTTLS", value ""
//     "AUTH PLAIN LOGIN" -> key "AUTH", value "PLAIN LOGIN"
//     A blank line is skipped. A duplicate keyword's LAST occurrence wins
//     (matches ordinary dict-assignment semantics — servers should not repeat
//     a keyword, but this module does not treat it as an error).
//
// DESIGN NOTES:
//   * The keyword is the first whitespace-delimited token; RFC 1869 restricts
//     it to letters/digits/hyphen, but this parser does not validate that —
//     it simply splits on the first space, matching the "verb arg" shape
//     used consistently across this SMTP module family.
//   * Private helpers prefixed _ehlo_.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _ehlo_trim: strip leading/trailing ASCII spaces (space + tab).
fn _ehlo_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and (slice(s, start, start + 1) == " " or slice(s, start, start + 1) == chr(9))
        start = start + 1
    let stop = n
    while stop > start and (slice(s, stop - 1, stop) == " " or slice(s, stop - 1, stop) == chr(9))
        stop = stop - 1
    slice(s, start, stop)

// ── Public API ───────────────────────────────────────────────────────────────

// smtp_ehlo_parse: map extension lines to {NAME -> param}.
fn smtp_ehlo_parse(lines: list) -> dict
    let out = {}
    let n = len(lines)
    for li in 0..n
        let raw = _ehlo_trim(lines[li])
        let llen = len(raw)
        if llen > 0
            // Split on first space: keyword / param.
            let i = 0
            while i < llen and slice(raw, i, i + 1) != " "
                i = i + 1
            let name = upper(slice(raw, 0, i))
            let param = ""
            if i < llen
                param = _ehlo_trim(slice(raw, i + 1, llen))
            out[name] = param
    out
