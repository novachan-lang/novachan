// ============================================================================
// NOVA Standard Library — std/net/udp_header
// ============================================================================
// RFC 768 — 8-byte UDP header parse/build, operating on a plain `list` of
// byte values (0..255). See std/net/udphdr.nova for the `bytes`-typed
// equivalent.
//
// Wire layout (8 bytes, all fields big-endian):
//   Bytes 0-1 : src_port (u16)
//   Bytes 2-3 : dst_port (u16)
//   Bytes 4-5 : length   (u16) — header + payload byte count (min 8)
//   Bytes 6-7 : checksum (u16) — 0 disables per RFC 768
//
// PUBLIC API:
//   udp_parse(bytes: list) -> dict
//     Returns {} if fewer than 8 bytes.
//     Keys: src_port, dst_port, length, checksum.
//
//   udp_build(hdr: dict) -> list
//     Builds an 8-byte header. Missing keys default to 0. The checksum
//     field is written verbatim from hdr["checksum"] — UDP checksum
//     requires the pseudo-header (see std/net/pseudo_header) plus payload,
//     so it is NOT computed here.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

fn _udh_get(h: dict, key: string) -> int
    if contains(h, key)
        return h[key]
    0

fn _udh_r16(b: list, i: int) -> int
    ((b[i] & 0xFF) << 8) | (b[i + 1] & 0xFF)

fn _udh_w16(out: list, v: int) -> list
    push(out, (v >> 8) & 0xFF)
    push(out, v & 0xFF)
    out

// ── Public API ────────────────────────────────────────────────────────────────

fn udp_parse(bytes: list) -> dict
    if len(bytes) < 8
        return {}
    let src = _udh_r16(bytes, 0)
    let dst = _udh_r16(bytes, 2)
    let ln = _udh_r16(bytes, 4)
    let csum = _udh_r16(bytes, 6)
    {"src_port": src, "dst_port": dst, "length": ln, "checksum": csum}

fn udp_build(hdr: dict) -> list
    let src = _udh_get(hdr, "src_port")
    let dst = _udh_get(hdr, "dst_port")
    let ln = _udh_get(hdr, "length")
    let csum = _udh_get(hdr, "checksum")
    let out = []
    out = _udh_w16(out, src & 0xFFFF)
    out = _udh_w16(out, dst & 0xFFFF)
    out = _udh_w16(out, ln & 0xFFFF)
    out = _udh_w16(out, csum & 0xFFFF)
    out
