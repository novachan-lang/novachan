// ============================================================================
// NOVA Standard Library — std/net/udphdr
// ============================================================================
// RFC 768 — 8-byte UDP header codec (big-endian wire format).
//
// Wire layout (8 bytes, all fields big-endian):
//   Bytes 0-1 : src_port  (u16) — source port number
//   Bytes 2-3 : dst_port  (u16) — destination port number
//   Bytes 4-5 : length    (u16) — length of header + data in bytes (min 8)
//   Bytes 6-7 : checksum  (u16) — ones-complement checksum (0 = disabled)
//
// PUBLIC API:
//   udp_encode(h: dict) -> bytes
//     h keys: "src_port", "dst_port", "length", "checksum"
//     Missing keys default to 0. Returns 8-byte big-endian wire encoding.
//
//   udp_decode(b: bytes) -> dict
//     Decodes 8-byte UDP header from b (reads bytes 0..7).
//     Returns {"src_port","dst_port","length","checksum"} on success.
//     Returns {} if bytes_len(b) < 8 (bounds-safe; never crashes).
//
// NOTE: The "length" field in the UDP header covers header+payload and is
// set by the caller. This module encodes/decodes the header only; it does
// not append or validate the payload bytes.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// Read a big-endian u16 from bytes b at position i.
// Caller MUST ensure bytes_len(b) >= i+2.
fn _udp_read_u16(b, i)
    ((bytes_get(b, i) << 8) | bytes_get(b, i + 1)) & 0xFFFF

// Append a big-endian u16 value v to bytes out; return new bytes.
fn _udp_write_u16(out, v)
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// Read an integer field from dict h at key; return 0 if absent.
fn _udp_get(h, key)
    if key in h
        return h[key]
    0

// ── Public API ────────────────────────────────────────────────────────────────

// udp_encode: dict -> 8-byte big-endian UDP header wire bytes.
//
// Keys used from h:
//   "src_port"  (u16) — source port
//   "dst_port"  (u16) — destination port
//   "length"    (u16) — header + payload byte count (caller sets; min 8)
//   "checksum"  (u16) — ones-complement checksum; 0 disables per RFC 768
//
// All missing keys default to 0. Returns exactly 8 bytes.
//
// Example:
//   udp_encode({"src_port": 0xC000, "dst_port": 0x0035, "length": 0x0026, "checksum": 0})
//   => 8 bytes: C0 00 00 35 00 26 00 00
fn udp_encode(h)
    let src = _udp_get(h, "src_port")
    let dst = _udp_get(h, "dst_port")
    let len = _udp_get(h, "length")
    let cks = _udp_get(h, "checksum")
    let out = bytes(0)
    out = _udp_write_u16(out, src & 0xFFFF)
    out = _udp_write_u16(out, dst & 0xFFFF)
    out = _udp_write_u16(out, len & 0xFFFF)
    out = _udp_write_u16(out, cks & 0xFFFF)
    out

// udp_decode: bytes -> dict
//
// Decodes 8 bytes from b starting at offset 0.
// Returns {"src_port", "dst_port", "length", "checksum"} on success.
// Returns {} if bytes_len(b) < 8 (never crashes on short input).
//
// Example:
//   let hdr = udp_decode(wire_bytes)
//   print(str(hdr["dst_port"]))   // e.g. 53 for DNS
fn udp_decode(b)
    let empty = {}
    if bytes_len(b) < 8
        return empty
    let src = _udp_read_u16(b, 0)
    let dst = _udp_read_u16(b, 2)
    let len = _udp_read_u16(b, 4)
    let cks = _udp_read_u16(b, 6)
    {"src_port": src, "dst_port": dst, "length": len, "checksum": cks}
