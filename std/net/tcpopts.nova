// ============================================================================
// NOVA Standard Library — std/net/tcpopts
// ============================================================================
// RFC 793 / RFC 1323 / RFC 2018 / RFC 7323 — TCP options TLV codec.
//
// TCP options occupy the options field of the TCP header (up to 40 bytes).
// Each option is either a single-byte (EOL/NOP) or a TLV triple
// (Kind, Length, Value...) where Length includes the Kind and Length bytes.
//
// Supported option kinds:
//   EOL      = 0  (End of Option List, 1 byte)
//   NOP      = 1  (No-Operation pad, 1 byte)
//   MSS      = 2  (Maximum Segment Size, len=4; u16 value)
//   WSCALE   = 3  (Window Scale, len=3; u8 shift count)
//   SACKPERM = 4  (SACK Permitted, len=2; no value)
//   SACK     = 5  (Selective ACK, len=2+8*n; pairs of u32 left/right edges)
//   TIMESTAMP= 8  (Timestamps, len=10; two u32: TSval, TSecr)
//
// PUBLIC API:
//   tcpopt_encode(opts: list) -> bytes
//     Encode a list of option dicts to wire bytes. Each dict must have a
//     "kind" key. Kind 2 (MSS) needs "value" (u16). Kind 3 (WSCALE) needs
//     "value" (u8). Kind 5 (SACK) needs "blocks" (list of [left,right] pairs).
//     Kind 8 (TIMESTAMP) needs "tsval" and "tsecr" (each u32). Unknown kinds
//     with a "data" bytes value are emitted verbatim (TLV). Single-byte kinds
//     (0,1) emit only the kind byte.
//     Does NOT auto-pad to 4-byte boundary — caller appends NOP/EOL as needed.
//
//   tcpopt_decode(b: bytes) -> list
//     Decode all options from the full bytes buffer b (starting at offset 0).
//     Returns a list of dicts, each with at least "kind". Stops on EOL or
//     end-of-buffer. On any bounds violation, stops and returns options so far.
//
//   tcpopt_mss(b: bytes) -> int
//     Scan b for an MSS option (kind=2) and return its u16 value, or -1 if
//     not found or MSS is malformed.
//
// DESIGN NOTES:
//   * All multi-byte fields are big-endian (network byte order).
//   * SACK blocks list elements are two-element lists [left, right] (u32 each).
//   * TIMESTAMP stores both halves as separate u32 ints ("tsval", "tsecr").
//   * Bounds are checked on EVERY byte read; malformed input returns partial
//     or empty results, never crashes.
//   * >> is ARITHMETIC in NOVA; mask with 0xFF / 0xFFFFFFFF as needed.
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _to_ to avoid collisions.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// Read big-endian u16 from bytes b at position i.
// Caller must ensure i + 1 < bytes_len(b).
fn _to_read_u16(b: bytes, i: int) -> int
    ((bytes_get(b, i) << 8) | bytes_get(b, i + 1)) & 0xFFFF

// Read big-endian u32 from bytes b at position i.
// Caller must ensure i + 3 < bytes_len(b).
fn _to_read_u32(b: bytes, i: int) -> int
    let b0 = bytes_get(b, i)
    let b1 = bytes_get(b, i + 1)
    let b2 = bytes_get(b, i + 2)
    let b3 = bytes_get(b, i + 3)
    let hi = ((b0 << 24) | (b1 << 16)) & 0xFFFF0000
    let lo = ((b2 << 8) | b3) & 0xFFFF
    (hi | lo) & 0xFFFFFFFF

// Append big-endian u16 to accumulator out; return new bytes.
fn _to_write_u16(out: bytes, v: int) -> bytes
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// Append big-endian u32 to accumulator out; return new bytes.
fn _to_write_u32(out: bytes, v: int) -> bytes
    out = bytes_append(out, (v >> 24) & 0xFF)
    out = bytes_append(out, (v >> 16) & 0xFF)
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// Safe int field from dict, default 0.
fn _to_get(d: dict, key: string) -> int
    if contains(d, key)
        return d[key]
    0

// Encode one option dict to bytes; appended to out.
fn _to_enc_one(out: bytes, opt: dict) -> bytes
    let k = _to_get(opt, "kind")
    if k == 0
        out = bytes_append(out, 0)
        return out
    if k == 1
        out = bytes_append(out, 1)
        return out
    if k == 2
        let v = _to_get(opt, "value")
        out = bytes_append(out, 2)
        out = bytes_append(out, 4)
        out = _to_write_u16(out, v & 0xFFFF)
        return out
    if k == 3
        let v = _to_get(opt, "value")
        out = bytes_append(out, 3)
        out = bytes_append(out, 3)
        out = bytes_append(out, v & 0xFF)
        return out
    if k == 4
        out = bytes_append(out, 4)
        out = bytes_append(out, 2)
        return out
    if k == 5
        let blocks = opt["blocks"]
        let nb = len(blocks)
        let optlen = 2 + nb * 8
        out = bytes_append(out, 5)
        out = bytes_append(out, optlen & 0xFF)
        let bi = 0
        while bi < nb
            let blk = blocks[bi]
            out = _to_write_u32(out, blk[0] & 0xFFFFFFFF)
            out = _to_write_u32(out, blk[1] & 0xFFFFFFFF)
            bi = bi + 1
        return out
    if k == 8
        let tsval = _to_get(opt, "tsval")
        let tsecr = _to_get(opt, "tsecr")
        out = bytes_append(out, 8)
        out = bytes_append(out, 10)
        out = _to_write_u32(out, tsval & 0xFFFFFFFF)
        out = _to_write_u32(out, tsecr & 0xFFFFFFFF)
        return out
    if contains(opt, "data")
        let dat = opt["data"]
        let dlen = bytes_len(dat)
        out = bytes_append(out, k & 0xFF)
        out = bytes_append(out, (2 + dlen) & 0xFF)
        out = bytes_concat(out, dat)
        return out
    out = bytes_append(out, k & 0xFF)
    out = bytes_append(out, 2)
    out

// Decode SACK blocks from b starting at base, nb blocks. Returns list.
fn _to_dec_sack_blocks(b: bytes, base: int, nb: int) -> list
    let n = bytes_len(b)
    let blocks = []
    let bi = 0
    while bi < nb
        let lo = base + bi * 8
        if lo + 7 < n
            let lval = _to_read_u32(b, lo)
            let rval = _to_read_u32(b, lo + 4)
            let blk = [lval, rval]
            push(blocks, blk)
        bi = bi + 1
    blocks

// ── Public API ────────────────────────────────────────────────────────────────

// tcpopt_encode: list of option dicts -> wire bytes.
//
// Each option dict must have "kind". Additional keys per kind:
//   kind=2 (MSS):       "value" u16
//   kind=3 (WSCALE):    "value" u8
//   kind=5 (SACK):      "blocks" list of [left32, right32] pairs
//   kind=8 (TIMESTAMP): "tsval" u32, "tsecr" u32
//   kind=0 or 1:        no additional keys (single byte)
//   other kind:         "data" bytes appended verbatim (len = 2 + bytes_len(data))
//
// Returns wire bytes. Does NOT pad to 4-byte boundary.
fn tcpopt_encode(opts: list) -> bytes
    let out = bytes(0)
    let i = 0
    while i < len(opts)
        out = _to_enc_one(out, opts[i])
        i = i + 1
    out

// tcpopt_decode: bytes -> list of option dicts.
//
// Decodes all options from b (full buffer, starting at offset 0).
// Stops at EOL (kind=0), unknown option past bounds, or end-of-buffer.
// Each returned dict has at least "kind". Additional fields per kind:
//   kind=2 (MSS):       "value" u16
//   kind=3 (WSCALE):    "value" u8
//   kind=5 (SACK):      "blocks" list of [left32, right32] pairs
//   kind=8 (TIMESTAMP): "tsval" u32, "tsecr" u32
//
// Malformed or truncated input: returns options decoded so far, then stops.
fn tcpopt_decode(b: bytes) -> list
    let result = []
    let n = bytes_len(b)
    let i = 0
    let running = 1
    while running == 1 and i < n
        let k = bytes_get(b, i)
        if k == 0
            running = 0
        else
            if k == 1
                let opt = {"kind": 1}
                push(result, opt)
                i = i + 1
            else
                if i + 1 >= n
                    running = 0
                else
                    let optlen = bytes_get(b, i + 1)
                    if optlen < 2 or i + optlen > n
                        running = 0
                    else
                        let consumed = _to_dec_opt(result, b, n, i, k, optlen)
                        if consumed == 0
                            running = 0
                        else
                            i = i + optlen
    result

// Decode one TLV option at position i into result list.
// Returns 1 if decoded successfully, 0 if malformed.
fn _to_dec_opt(result: list, b: bytes, n: int, i: int, k: int, optlen: int) -> int
    if k == 2
        if optlen != 4 or i + 3 >= n
            return 0
        let v = _to_read_u16(b, i + 2)
        let opt = {"kind": 2, "value": v}
        push(result, opt)
        return 1
    if k == 3
        if optlen != 3 or i + 2 >= n
            return 0
        let v = bytes_get(b, i + 2)
        let opt = {"kind": 3, "value": v}
        push(result, opt)
        return 1
    if k == 4
        let opt = {"kind": 4}
        push(result, opt)
        return 1
    if k == 5
        let datalen = optlen - 2
        if datalen < 0 or (datalen % 8) != 0
            return 0
        let nb = datalen / 8
        let blocks = _to_dec_sack_blocks(b, i + 2, nb)
        if len(blocks) != nb
            return 0
        let opt = {"kind": 5, "blocks": blocks}
        push(result, opt)
        return 1
    if k == 8
        if optlen != 10 or i + 9 >= n
            return 0
        let tsval = _to_read_u32(b, i + 2)
        let tsecr = _to_read_u32(b, i + 6)
        let opt = {"kind": 8, "tsval": tsval, "tsecr": tsecr}
        push(result, opt)
        return 1
    let dat = bytes_slice(b, i + 2, i + optlen)
    let opt = {"kind": k, "data": dat}
    push(result, opt)
    1

// tcpopt_mss: scan bytes for MSS option (kind=2), return its u16 value or -1.
//
// Parses options sequentially from the start of b. Stops at EOL, end-of-buffer,
// or a bounds violation. Returns the first MSS value found, or -1 if absent.
fn tcpopt_mss(b: bytes) -> int
    let opts = tcpopt_decode(b)
    let i = 0
    let found = -1
    while i < len(opts) and found == -1
        let opt = opts[i]
        if opt["kind"] == 2
            found = opt["value"]
        i = i + 1
    found
