// ============================================================================
// NOVA Standard Library — std/net/mqtt_fixed
// ============================================================================
// MQTT 3.1.1 (ISO/IEC 20922) — fixed header + remaining-length varint codec.
//
// MQTT wire uses a variable-length encoding for the "Remaining Length" field:
//   - Each byte uses 7 bits of data (0x7F mask) and 1 continuation bit (0x80).
//   - Values 0..127  encode as 1 byte.
//   - Values 128..16383 encode as 2 bytes.
//   - Values 16384..2097151 encode as 3 bytes.
//   - Values 2097152..268435455 encode as 4 bytes (max).
//
// MQTT packet types (4-bit field in byte 0 bits 7..4):
//   CONNECT=1, CONNACK=2, PUBLISH=3, SUBSCRIBE=8
//
// PUBLIC API:
//   mqtt_remlen_encode(n: int) -> list
//     Encode integer n as MQTT remaining-length varint.
//     Returns a list of ints (1..4 bytes), each 0..255.
//     n must be 0..268435455.
//
//   mqtt_remlen_decode(bytes: list, pos: int) -> list
//     Decode MQTT remaining-length varint from byte-list starting at pos.
//     Returns [decoded_value, next_pos].
//     Reads at most 4 bytes. Returns [-1, pos] on error.
//
//   mqtt_fixed_header(pkt_type: int, flags: int, remlen: int) -> list
//     Build a complete MQTT fixed header.
//     Returns byte-list: [byte0, ...remlen_varint_bytes...].
//     byte0 = (pkt_type << 4) | (flags & 0x0F).
//
// CONSTANTS (for reference):
//   CONNECT=1, CONNACK=2, PUBLISH=3, SUBSCRIBE=8
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Public API ──────────────────────────────────────────────────────────────

// mqtt_remlen_encode: encode n as MQTT remaining-length varint.
// Returns a list of 1..4 bytes (each 0..255).
fn mqtt_remlen_encode(n: int) -> list
    let out = []
    let v = n
    let done = 0
    if done == 0
        let b = v & 0x7F
        let v2 = v >> 7
        if v2 > 0
            b = b | 0x80
        push(out, b)
        v = v2
        if v == 0
            done = 1
    if done == 0
        let b = v & 0x7F
        let v2 = v >> 7
        if v2 > 0
            b = b | 0x80
        push(out, b)
        v = v2
        if v == 0
            done = 1
    if done == 0
        let b = v & 0x7F
        let v2 = v >> 7
        if v2 > 0
            b = b | 0x80
        push(out, b)
        v = v2
        if v == 0
            done = 1
    if done == 0
        let b = v & 0x7F
        push(out, b)
    out

// mqtt_remlen_decode: decode MQTT remaining-length varint from byte-list blist
// starting at position pos. Returns [value, next_pos] or [-1, pos] on error.
fn mqtt_remlen_decode(blist: list, pos: int) -> list
    let total = len(blist)
    let value = 0
    let shift = 0
    let cur = pos
    let ok = 1
    let running = 1
    if running == 1
        if cur >= total
            ok = 0
            running = 0
        if ok == 1 and running == 1
            let byte = blist[cur]
            cur = cur + 1
            value = value | ((byte & 0x7F) << shift)
            shift = shift + 7
            if (byte & 0x80) == 0
                running = 0
            if shift >= 28 and running == 1
                ok = 0
                running = 0
    if running == 1
        if cur >= total
            ok = 0
            running = 0
        if ok == 1 and running == 1
            let byte = blist[cur]
            cur = cur + 1
            value = value | ((byte & 0x7F) << shift)
            shift = shift + 7
            if (byte & 0x80) == 0
                running = 0
            if shift >= 28 and running == 1
                ok = 0
                running = 0
    if running == 1
        if cur >= total
            ok = 0
            running = 0
        if ok == 1 and running == 1
            let byte = blist[cur]
            cur = cur + 1
            value = value | ((byte & 0x7F) << shift)
            shift = shift + 7
            if (byte & 0x80) == 0
                running = 0
            if shift >= 28 and running == 1
                ok = 0
                running = 0
    if running == 1
        if cur >= total
            ok = 0
            running = 0
        if ok == 1 and running == 1
            let byte = blist[cur]
            cur = cur + 1
            value = value | ((byte & 0x7F) << shift)
            running = 0
    if ok == 0
        return [-1, pos]
    [value, cur]

// mqtt_fixed_header: build MQTT fixed header byte-list.
// pkt_type: 1=CONNECT, 2=CONNACK, 3=PUBLISH, 8=SUBSCRIBE etc.
// flags: lower 4 bits (e.g. 0 for most, 2 for SUBSCRIBE)
// remlen: remaining length integer (encoded as varint)
fn mqtt_fixed_header(pkt_type: int, flags: int, remlen: int) -> list
    let out = []
    let byte0 = ((pkt_type << 4) & 0xF0) | (flags & 0x0F)
    push(out, byte0)
    let rl = mqtt_remlen_encode(remlen)
    let i = 0
    let n = len(rl)
    while i < n
        push(out, rl[i])
        i = i + 1
    out
