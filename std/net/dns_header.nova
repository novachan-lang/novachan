// ============================================================================
// NOVA Standard Library — std/net/dns_header
// ============================================================================
// RFC 1035 §4.1.1 — 12-byte DNS message header codec (big-endian wire format).
//
// Wire layout (12 bytes, all fields big-endian):
//   Bytes 0-1  : ID      (u16) — query identifier
//   Bytes 2-3  : FLAGS   (u16) — QR|OPCODE(4)|AA|TC|RD|RA|Z(3)|RCODE(4)
//   Bytes 4-5  : QDCOUNT (u16) — question count
//   Bytes 6-7  : ANCOUNT (u16) — answer count
//   Bytes 8-9  : NSCOUNT (u16) — authority record count
//   Bytes 10-11: ARCOUNT (u16) — additional record count
//
// FLAGS bit packing:
//   QR     bit 15       (1=response, 0=query)
//   OPCODE bits 14..11  (4 bits)
//   AA     bit 10       (authoritative answer)
//   TC     bit 9        (truncated)
//   RD     bit 8        (recursion desired)
//   RA     bit 7        (recursion available)
//   Z      bits 6..4    (reserved, must be 0)
//   RCODE  bits 3..0    (response code)
//
// PUBLIC API:
//   dns_header_encode(h: dict) -> bytes
//     h keys: "id","qr","opcode","aa","tc","rd","ra","rcode",
//             "qdcount","ancount","nscount","arcount"
//     Missing keys default to 0. Returns 12-byte big-endian wire encoding.
//
//   dns_header_decode(b: bytes, pos: int) -> list
//     Decodes 12 bytes starting at pos from b.
//     Returns [header_dict, pos+12] on success.
//     Returns [{}, pos] if fewer than 12 bytes available (bounds-safe).
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// Read a big-endian u16 from bytes b at position i.
// Caller MUST ensure i+1 < bytes_len(b).
fn _dh_read_u16(b: bytes, i: int) -> int
    ((bytes_get(b, i) << 8) | bytes_get(b, i + 1)) & 0xFFFF

// Append a big-endian u16 to accumulator out; return new bytes.
fn _dh_write_u16(out: bytes, v: int) -> bytes
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// Read an integer field from a dict; default to 0 if key absent.
fn _dh_get(h: dict, key: string) -> int
    if contains(h, key)
        return h[key]
    0

// ── Public API ────────────────────────────────────────────────────────────────

// dns_header_encode: dict -> 12-byte big-endian DNS header wire bytes.
//
// Example:
//   dns_header_encode({"id": 0x1234, "rd": 1, "qdcount": 1})
//   => bytes of length 12; byte[0]=0x12, byte[1]=0x34, byte[2]=0x01, byte[3]=0x00, u16@4=1
//
// All missing dict keys default to 0 (clean query by default).
fn dns_header_encode(h: dict) -> bytes
    let id      = _dh_get(h, "id")
    let qr      = _dh_get(h, "qr")
    let opcode  = _dh_get(h, "opcode")
    let aa      = _dh_get(h, "aa")
    let tc      = _dh_get(h, "tc")
    let rd      = _dh_get(h, "rd")
    let ra      = _dh_get(h, "ra")
    let rcode   = _dh_get(h, "rcode")
    let qdcount = _dh_get(h, "qdcount")
    let ancount = _dh_get(h, "ancount")
    let nscount = _dh_get(h, "nscount")
    let arcount = _dh_get(h, "arcount")
    let flags = ((qr & 1) << 15) | ((opcode & 0xF) << 11) | ((aa & 1) << 10) | ((tc & 1) << 9) | ((rd & 1) << 8) | ((ra & 1) << 7) | (rcode & 0xF)
    let out = bytes(0)
    out = _dh_write_u16(out, id & 0xFFFF)
    out = _dh_write_u16(out, flags & 0xFFFF)
    out = _dh_write_u16(out, qdcount & 0xFFFF)
    out = _dh_write_u16(out, ancount & 0xFFFF)
    out = _dh_write_u16(out, nscount & 0xFFFF)
    out = _dh_write_u16(out, arcount & 0xFFFF)
    out

// dns_header_decode: bytes, pos -> [header_dict, next_pos]
//
// Decodes 12 bytes from b starting at pos.
// Returns [parsed_dict, pos+12] on success.
// Returns [{}, pos] if bounds check fails (fewer than pos+12 bytes available).
//
// The returned dict has keys:
//   "id","qr","opcode","aa","tc","rd","ra","rcode","qdcount","ancount","nscount","arcount"
//
// Example:
//   let result = dns_header_decode(wire_bytes, 0)
//   let hdr = result[0]
//   let next = result[1]
//   print(str(hdr["id"]))
fn dns_header_decode(b: bytes, pos: int) -> list
    let empty = {}
    let fail = [empty, pos]
    if pos < 0
        return fail
    if bytes_len(b) < pos + 12
        return fail
    let id    = _dh_read_u16(b, pos)
    let flags = _dh_read_u16(b, pos + 2)
    let qd    = _dh_read_u16(b, pos + 4)
    let an    = _dh_read_u16(b, pos + 6)
    let ns    = _dh_read_u16(b, pos + 8)
    let ar    = _dh_read_u16(b, pos + 10)
    let qr     = (flags >> 15) & 1
    let opcode = (flags >> 11) & 0xF
    let aa     = (flags >> 10) & 1
    let tc     = (flags >> 9) & 1
    let rd     = (flags >> 8) & 1
    let ra     = (flags >> 7) & 1
    let rcode  = flags & 0xF
    let hdr = {"id": id, "qr": qr, "opcode": opcode, "aa": aa, "tc": tc, "rd": rd, "ra": ra, "rcode": rcode, "qdcount": qd, "ancount": an, "nscount": ns, "arcount": ar}
    [hdr, pos + 12]
