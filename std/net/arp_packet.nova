// ============================================================================
// NOVA Standard Library — std/net/arp_packet
// ============================================================================
// RFC 826 — generic ARP packet parse/build, operating on a plain `list` of
// byte values (0..255). Unlike std/net/arppkt.nova (which is hardcoded to
// IPv4-over-Ethernet: htype=1, ptype=0x0800, hlen=6, plen=4), this module
// reads/writes hw_type, proto_type, hw_len and proto_len from the wire and
// sizes the address fields accordingly — general enough for any hw/proto
// address length combination the wire declares.
//
// Wire layout (variable length: 8-byte fixed part + 2*(hw_len+proto_len)):
//   Bytes 0-1 : hw_type    (u16) — 1 = Ethernet
//   Bytes 2-3 : proto_type (u16) — 0x0800 = IPv4
//   Byte  4   : hw_len     (u8)  — hardware address length (6 for MAC)
//   Byte  5   : proto_len  (u8)  — protocol address length (4 for IPv4)
//   Bytes 6-7 : opcode     (u16) — 1 = REQUEST, 2 = REPLY
//   Next hw_len bytes      : sender_hw
//   Next proto_len bytes   : sender_ip (protocol address, despite the name)
//   Next hw_len bytes      : target_hw
//   Next proto_len bytes   : target_ip
//
// PUBLIC API:
//   arp_parse(bytes: list) -> dict
//     Returns {} if the fixed 8-byte part or the variable-length address
//     fields don't fit in `bytes` (bounds-safe).
//     Keys: hw_type, proto_type, hw_len, proto_len, opcode,
//           sender_hw (list), sender_ip (list), target_hw (list), target_ip (list).
//
//   arp_build(hdr: dict) -> list
//     hw_type defaults to 1, proto_type to 0x0800, opcode to 1.
//     hw_len/proto_len default to the length of sender_hw/sender_ip if
//     present, else 6/4. sender_hw/sender_ip/target_hw/target_ip default to
//     zero-filled lists of the resolved hw_len/proto_len.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

fn _arpp_get(h: dict, key: string) -> int
    if contains(h, key)
        return h[key]
    0

fn _arpp_r16(b: list, i: int) -> int
    ((b[i] & 0xFF) << 8) | (b[i + 1] & 0xFF)

fn _arpp_w16(out: list, v: int) -> list
    push(out, (v >> 8) & 0xFF)
    push(out, v & 0xFF)
    out

// Read exactly n bytes from b starting at offset i into a new list.
// Caller ensures i+n <= len(b).
fn _arpp_slice(b: list, i: int, n: int) -> list
    let r = [b[i + k] & 0xFF for k in 0..n]
    r

// Append list field (n bytes) to out; pads with zero if field has fewer
// than n elements, truncates if it has more.
fn _arpp_w_field(out: list, field: list, n: int) -> list
    let k = 0
    let fl = len(field)
    while k < n
        let v = 0
        if k < fl
            v = field[k]
        push(out, v & 0xFF)
        k = k + 1
    out

// ── Public API ────────────────────────────────────────────────────────────────

fn arp_parse(bytes: list) -> dict
    if len(bytes) < 8
        return {}
    let htype = _arpp_r16(bytes, 0)
    let ptype = _arpp_r16(bytes, 2)
    let hlen = bytes[4] & 0xFF
    let plen = bytes[5] & 0xFF
    let oper = _arpp_r16(bytes, 6)
    let total = 8 + 2 * hlen + 2 * plen
    if len(bytes) < total
        return {}
    let sha = _arpp_slice(bytes, 8, hlen)
    let spa = _arpp_slice(bytes, 8 + hlen, plen)
    let tha = _arpp_slice(bytes, 8 + hlen + plen, hlen)
    let tpa = _arpp_slice(bytes, 8 + 2 * hlen + plen, plen)
    {"hw_type": htype, "proto_type": ptype, "hw_len": hlen, "proto_len": plen, "opcode": oper, "sender_hw": sha, "sender_ip": spa, "target_hw": tha, "target_ip": tpa}

fn arp_build(hdr: dict) -> list
    let htype = 1
    if contains(hdr, "hw_type")
        htype = hdr["hw_type"]
    let ptype = 0x0800
    if contains(hdr, "proto_type")
        ptype = hdr["proto_type"]
    let oper = 1
    if contains(hdr, "opcode")
        oper = hdr["opcode"]
    let sha = []
    if contains(hdr, "sender_hw")
        sha = hdr["sender_hw"]
    let spa = []
    if contains(hdr, "sender_ip")
        spa = hdr["sender_ip"]
    let tha = []
    if contains(hdr, "target_hw")
        tha = hdr["target_hw"]
    let tpa = []
    if contains(hdr, "target_ip")
        tpa = hdr["target_ip"]
    let hlen = 6
    if contains(hdr, "hw_len")
        hlen = hdr["hw_len"]
    else
        if len(sha) > 0
            hlen = len(sha)
    let plen = 4
    if contains(hdr, "proto_len")
        plen = hdr["proto_len"]
    else
        if len(spa) > 0
            plen = len(spa)
    let out = []
    out = _arpp_w16(out, htype & 0xFFFF)
    out = _arpp_w16(out, ptype & 0xFFFF)
    push(out, hlen & 0xFF)
    push(out, plen & 0xFF)
    out = _arpp_w16(out, oper & 0xFFFF)
    out = _arpp_w_field(out, sha, hlen)
    out = _arpp_w_field(out, spa, plen)
    out = _arpp_w_field(out, tha, hlen)
    out = _arpp_w_field(out, tpa, plen)
    out
