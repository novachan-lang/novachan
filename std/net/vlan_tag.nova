// ============================================================================
// NOVA Standard Library — std/net/vlan_tag
// ============================================================================
// IEEE 802.1Q VLAN tag parse/build, operating on a plain `list` of byte
// values (0..255). Standalone codec for the 4-byte tag itself (TPID + TCI);
// std/net/eth_frame2.nova composes this with a full Ethernet II frame.
//
// Wire layout (4 bytes, big-endian):
//   Bytes 0-1 : TPID (u16) — 0x8100 identifies an 802.1Q tag
//   Bytes 2-3 : TCI  (u16) — bits 15-13 = PCP, bit 12 = DEI, bits 11-0 = VID
//
// PUBLIC API:
//   vlan_parse(bytes: list) -> dict
//     Returns {} if fewer than 4 bytes.
//     Keys: tpid, pcp (0..7), dei (0/1), vlan_id (0..4095).
//     Does NOT require tpid == 0x8100 — callers that need to validate a tag
//     is genuinely 802.1Q should check the "tpid" field themselves (this
//     module also decodes 802.1ad/QinQ TPIDs such as 0x88A8 the same way).
//
//   vlan_build(tag: dict) -> list
//     Returns exactly 4 bytes. tpid defaults to 0x8100, pcp/dei/vlan_id
//     default to 0.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

fn _vlt_get(h: dict, key: string) -> int
    if contains(h, key)
        return h[key]
    0

fn _vlt_r16(b: list, i: int) -> int
    ((b[i] & 0xFF) << 8) | (b[i + 1] & 0xFF)

// ── Public API ────────────────────────────────────────────────────────────────

fn vlan_parse(bytes: list) -> dict
    if len(bytes) < 4
        return {}
    let tpid = _vlt_r16(bytes, 0)
    let tci = _vlt_r16(bytes, 2)
    let pcp = (tci >> 13) & 0x7
    let dei = (tci >> 12) & 0x1
    let vid = tci & 0x0FFF
    {"tpid": tpid, "pcp": pcp, "dei": dei, "vlan_id": vid}

fn vlan_build(tag: dict) -> list
    let tpid = 0x8100
    if contains(tag, "tpid")
        tpid = tag["tpid"]
    let pcp = _vlt_get(tag, "pcp")
    let dei = _vlt_get(tag, "dei")
    let vid = _vlt_get(tag, "vlan_id")
    let tci = ((pcp & 0x7) << 13) | ((dei & 0x1) << 12) | (vid & 0x0FFF)
    let out = []
    push(out, (tpid >> 8) & 0xFF)
    push(out, tpid & 0xFF)
    push(out, (tci >> 8) & 0xFF)
    push(out, tci & 0xFF)
    out
