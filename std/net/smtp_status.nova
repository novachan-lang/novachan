// ============================================================================
// NOVA Standard Library — std/net/smtp_status
// ============================================================================
// SMTP reply code classification and human-readable text (RFC 5321 §4.2.1,
// §4.2.3).
//
// PUBLIC API:
//   smtp_class(code: int) -> string
//     Classify a 3-digit reply code by its first digit:
//       1xx -> "info"                 (positive preliminary; rare in SMTP)
//       2xx -> "positive"             (positive completion)
//       3xx -> "intermediate"         (positive intermediate, e.g. 354)
//       4xx -> "negative_transient"   (transient negative completion)
//       5xx -> "negative_permanent"   (permanent negative completion)
//       else -> "unknown"             (out of the 100..599 range)
//
//   smtp_status_text(code: int) -> string
//     Human-readable RFC 5321 description for common codes: 220, 221, 250,
//     354, 421, 450, 451, 500, 501, 503, 550, 553, 554. "" for any other
//     code (not an error — callers should fall back to the server's own
//     reply text, which this function does not have access to).
//
// LEAF — imports NOTHING.
// ============================================================================

// smtp_class: classify a reply code by its first digit.
fn smtp_class(code: int) -> string
    if code >= 100 and code <= 199
        return "info"
    if code >= 200 and code <= 299
        return "positive"
    if code >= 300 and code <= 399
        return "intermediate"
    if code >= 400 and code <= 499
        return "negative_transient"
    if code >= 500 and code <= 599
        return "negative_permanent"
    "unknown"

// smtp_status_text: human-readable description for common reply codes.
fn smtp_status_text(code: int) -> string
    if code == 220
        return "Service ready"
    if code == 221
        return "Service closing transmission channel"
    if code == 250
        return "Requested mail action okay, completed"
    if code == 354
        return "Start mail input; end with <CRLF>.<CRLF>"
    if code == 421
        return "Service not available, closing transmission channel"
    if code == 450
        return "Requested mail action not taken: mailbox unavailable"
    if code == 451
        return "Requested action aborted: local error in processing"
    if code == 500
        return "Syntax error, command unrecognized"
    if code == 501
        return "Syntax error in parameters or arguments"
    if code == 503
        return "Bad sequence of commands"
    if code == 550
        return "Requested action not taken: mailbox unavailable"
    if code == 553
        return "Requested action not taken: mailbox name not allowed"
    if code == 554
        return "Transaction failed"
    ""
