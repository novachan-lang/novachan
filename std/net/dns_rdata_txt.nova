// ============================================================================
// NOVA Standard Library — std/net/dns_rdata_txt
// ============================================================================
// DNS TXT RDATA codec (RFC 1035 §3.3.14).
//
// TXT RDATA is a sequence of one or more character-strings.
// Each character-string is:
//   1 length byte (0..255) + that many octets of data.
//
// PUBLIC API:
//   dns_txt_encode(strings: list) -> bytes
//     Encode a list of strings as TXT RDATA wire bytes.
//     Each element is length-prefixed (1 byte, 0..255).
//     Strings longer than 255 bytes are skipped (clamped safe).
//     Returns empty bytes for an empty input list.
//
//   dns_txt_decode(b: bytes) -> list
//     Decode TXT RDATA wire bytes into a list of BYTES character-strings
//     (binary-safe — a character-string is arbitrary octets per RFC 1035
//     §3.3, not text; returning NOVA `string` would silently NUL-truncate
//     any character-string containing a 0x00 byte, corrupting the data).
//     Reads character-strings in sequence until all bytes are consumed.
//     On malformed input (truncated length or data) stops early and
//     returns whatever character-strings were successfully decoded
//     (never crashes).
//
// KAT VECTORS:
//   dns_txt_encode(["hello"])       -> [5,104,101,108,108,111]  (6 bytes)
//   dns_txt_decode([5,104,...,111]) -> [bytes("hello")]          (round-trip)
//   dns_txt_encode(["ab","cde"])    -> [2,97,98,3,99,100,101]   (7 bytes)
//   dns_txt_decode above            -> [bytes("ab"),bytes("cde")] (round-trip)
//   dns_txt_decode([3,0x41,0x00,0x42]) -> [bytes([0x41,0x00,0x42])] — the
//     embedded 0x00 round-trips intact (proves binary-safety).
//
// DESIGN NOTES:
//   - LEAF module — imports NOTHING.
//   - All byte reads are bounds-checked (i < bytes_len).
//   - Binary wire data uses the bytes type exclusively.
//   - Private helpers prefixed _txt_ to avoid symbol collisions.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _txt_str_to_bytes_len: return the number of bytes in a NOVA string.
// Used to enforce the 255-byte limit per character-string.
fn _txt_str_byte_len(s: string) -> int
    len(s)

// ── Public API ────────────────────────────────────────────────────────────────

// dns_txt_encode: list of strings -> TXT RDATA wire bytes.
// Each string is emitted as: 1 length byte + that many ASCII bytes.
// Strings longer than 255 bytes are silently skipped (RFC 1035 cap).
// Empty list -> returns bytes(0) (zero-length RDATA; valid for some uses).
//
// Example:
//   dns_txt_encode(["hello"]) -> bytes [5,104,101,108,108,111]
//   dns_txt_encode(["ab","cde"]) -> bytes [2,97,98,3,99,100,101]
fn dns_txt_encode(strings: list) -> bytes
    let out = bytes(0)
    for i in 0..len(strings)
        let s = strings[i]
        let n = _txt_str_byte_len(s)
        if n <= 255
            out = bytes_append(out, n)
            let j = 0
            while j < n
                out = bytes_append(out, ord(char_at(s, j)))
                j += 1
    out

// dns_txt_decode: TXT RDATA wire bytes -> list of BYTES character-strings
// (binary-safe; never use string here — TXT content is arbitrary octets
// and a NOVA string silently NUL-truncates at an embedded 0x00 byte).
// Reads character-strings in sequence.
// On truncated input (length byte present but not enough data) stops early.
// Never crashes on any input.
//
// Example:
//   dns_txt_decode(bytes [5,104,101,108,108,111]) -> [bytes("hello")]
//   dns_txt_decode(bytes [2,97,98,3,99,100,101])  -> [bytes("ab"),bytes("cde")]
//   dns_txt_decode(bytes [3,0x41,0x00,0x42])      -> [bytes([0x41,0x00,0x42])]
fn dns_txt_decode(b: bytes) -> list
    let result = []
    let blen = bytes_len(b)
    let pos = 0
    while pos < blen
        let n = bytes_get(b, pos)
        pos += 1
        if pos + n > blen
            return result
        let s = bytes_slice(b, pos, pos + n)
        result.push(s)
        pos += n
    result
