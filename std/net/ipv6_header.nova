// ============================================================================
// NOVA Standard Library — std/net/ipv6_header
// ============================================================================
// RFC 8200 — 40-byte IPv6 fixed header parse/build, operating on a plain
// `list` of byte values (0..255). See std/net/ipv6hdr.nova for the
// `bytes`-typed equivalent.
//
// Wire layout (40 bytes, all multi-byte fields big-endian):
//   Bytes 0-3  : version(4)|traffic_class(8)|flow_label(20)
//   Bytes 4-5  : payload_length (u16)
//   Byte  6    : next_header (u8)
//   Byte  7    : hop_limit (u8)
//   Bytes 8-23 : source address (16 bytes)
//   Bytes 24-39: destination address (16 bytes)
//
// PUBLIC API:
//   ipv6_parse(bytes: list) -> dict
//     Returns {} if fewer than 40 bytes or version != 6.
//     Keys: version, traffic_class, flow_label, payload_length, next_header,
//           hop_limit, src_ip (list of 8 ints, one per 16-bit group),
//           dst_ip (list of 8 ints).
//
//   ipv6_build(hdr: dict) -> list
//     Builds a 40-byte header. version defaults to 6. src_ip/dst_ip default
//     to 8 zero groups if absent or not exactly 8 elements long.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

fn _iph6_get(h: dict, key: string) -> int
    if key in h
        return h[key]
    0

fn _iph6_r16(b: list, i: int) -> int
    ((b[i] & 0xFF) << 8) | (b[i + 1] & 0xFF)

// Read 8 consecutive 16-bit big-endian groups starting at byte offset off.
fn _iph6_r_addr(b: list, off: int) -> list
    let groups = [_iph6_r16(b, off + g * 2) for g in 0..8]
    groups

// Append 8 groups (16 bytes) to out, big-endian, one group per 2 bytes.
// If addr does not have exactly 8 elements, writes 16 zero bytes instead.
fn _iph6_w_addr(out: list, addr: list) -> list
    let g = 0
    let ok = len(addr) == 8
    while g < 8
        let v = 0
        if ok
            v = addr[g]
        push(out, (v >> 8) & 0xFF)
        push(out, v & 0xFF)
        g += 1
    out

// ── Public API ────────────────────────────────────────────────────────────────

fn ipv6_parse(bytes: list) -> dict
    if len(bytes) < 40
        return {}
    let b0 = bytes[0] & 0xFF
    let b1 = bytes[1] & 0xFF
    let b2 = bytes[2] & 0xFF
    let b3 = bytes[3] & 0xFF
    let ver = (b0 >> 4) & 0xF
    if ver != 6
        return {}
    let tc = ((b0 & 0xF) << 4) | ((b1 >> 4) & 0xF)
    let fl = (((b1 & 0xF) << 16) | (b2 << 8) | b3) & 0xFFFFF
    let plen = _iph6_r16(bytes, 4)
    let nh = bytes[6] & 0xFF
    let hl = bytes[7] & 0xFF
    let src = _iph6_r_addr(bytes, 8)
    let dst = _iph6_r_addr(bytes, 24)
    {"version": ver, "traffic_class": tc, "flow_label": fl, "payload_length": plen, "next_header": nh, "hop_limit": hl, "src_ip": src, "dst_ip": dst}

fn ipv6_build(hdr: dict) -> list
    let ver = 6
    if "version" in hdr
        ver = hdr["version"]
    let tc = _iph6_get(hdr, "traffic_class")
    let fl = _iph6_get(hdr, "flow_label")
    let plen = _iph6_get(hdr, "payload_length")
    let nh = _iph6_get(hdr, "next_header")
    let hl = _iph6_get(hdr, "hop_limit")
    let b0 = ((ver & 0xF) << 4) | ((tc >> 4) & 0xF)
    let b1 = ((tc & 0xF) << 4) | ((fl >> 16) & 0xF)
    let b2 = (fl >> 8) & 0xFF
    let b3 = fl & 0xFF
    let out = []
    push(out, b0 & 0xFF)
    push(out, b1 & 0xFF)
    push(out, b2 & 0xFF)
    push(out, b3 & 0xFF)
    push(out, (plen >> 8) & 0xFF)
    push(out, plen & 0xFF)
    push(out, nh & 0xFF)
    push(out, hl & 0xFF)
    let src = []
    if "src_ip" in hdr
        src = hdr["src_ip"]
    let dst = []
    if "dst_ip" in hdr
        dst = hdr["dst_ip"]
    out = _iph6_w_addr(out, src)
    out = _iph6_w_addr(out, dst)
    out
