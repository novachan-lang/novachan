// ============================================================================
// NOVA Standard Library — std/net/portname
// ============================================================================
// Well-known TCP/UDP port <-> service name mapping.
//
// PUBLIC API:
//   pn_service(port: int) -> string
//     Return the service name for a well-known port, or "" if unknown.
//     Examples: pn_service(22) -> "ssh", pn_service(80) -> "http".
//
//   pn_port(service: string) -> int
//     Return the port number for a service name, or -1 if unknown.
//     Examples: pn_port("https") -> 443, pn_port("unknown") -> -1.
//
// COVERAGE (both directions):
//   20  ftp-data   |  21  ftp       |  22  ssh        |  23  telnet
//   25  smtp       |  53  dns       |  80  http        | 110  pop3
//  143  imap       | 443  https     | 993  imaps       | 995  pop3s
// 3306  mysql      |5432  postgresql|6379  redis       |8080  http-alt
//27017  mongodb
// ============================================================================

fn pn_service(port: int) -> string
    if port == 20 then return "ftp-data"
    if port == 21 then return "ftp"
    if port == 22 then return "ssh"
    if port == 23 then return "telnet"
    if port == 25 then return "smtp"
    if port == 53 then return "dns"
    if port == 80 then return "http"
    if port == 110 then return "pop3"
    if port == 143 then return "imap"
    if port == 443 then return "https"
    if port == 993 then return "imaps"
    if port == 995 then return "pop3s"
    if port == 3306 then return "mysql"
    if port == 5432 then return "postgresql"
    if port == 6379 then return "redis"
    if port == 8080 then return "http-alt"
    if port == 27017 then return "mongodb"
    return ""

fn pn_port(service: string) -> int
    if service == "ftp-data" then return 20
    if service == "ftp" then return 21
    if service == "ssh" then return 22
    if service == "telnet" then return 23
    if service == "smtp" then return 25
    if service == "dns" then return 53
    if service == "http" then return 80
    if service == "pop3" then return 110
    if service == "imap" then return 143
    if service == "https" then return 443
    if service == "imaps" then return 993
    if service == "pop3s" then return 995
    if service == "mysql" then return 3306
    if service == "postgresql" then return 5432
    if service == "redis" then return 6379
    if service == "http-alt" then return 8080
    if service == "mongodb" then return 27017
    return -1
