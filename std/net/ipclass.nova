// ============================================================================
// NOVA Standard Library — std/net/ipclass
// ============================================================================
// IPv4 address classification.  Distinct from std/net/ip (which handles
// parsing/formatting/CIDR); this module classifies addresses by class and
// well-known range membership.
//
// PUBLIC API:
//   ic_class(s: string) -> string
//     Returns the RFC 791 address class for the given dotted-quad:
//       "A"  first octet 0..127
//       "B"  first octet 128..191
//       "C"  first octet 192..223
//       "D"  first octet 224..239  (multicast)
//       "E"  first octet 240..255  (reserved/experimental)
//     Returns "" on malformed input.
//
//   ic_is_private(s: string) -> bool
//     RFC 1918 private address spaces:
//       10.0.0.0/8        (first octet == 10)
//       172.16.0.0/12     (first octet == 172, second octet 16..31)
//       192.168.0.0/16    (first octet == 192, second octet == 168)
//     Returns false on malformed input.
//
//   ic_is_loopback(s: string) -> bool
//     127.0.0.0/8  (first octet == 127).
//     Returns false on malformed input.
//
//   ic_is_multicast(s: string) -> bool
//     224.0.0.0/4  (first octet 224..239, i.e. class D).
//     Returns false on malformed input.
//
//   ic_is_link_local(s: string) -> bool
//     169.254.0.0/16  (first octet == 169, second octet == 254).
//     Returns false on malformed input.
//
// DESIGN NOTES:
//   * All classification is done on the parsed octet integers, never on string
//     comparisons, so "010.0.0.1" and "10.0.0.1" classify identically.
//   * Private helpers are prefixed _ic_ to avoid collisions in the merged
//     binary when multiple std modules are loaded together.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Returns true iff s is non-empty and contains only ASCII decimal digits.
fn _ic_digits_only(s: string) -> bool
    if len(s) == 0
        return false
    for i in 0..len(s)
        let b = ord(char_at(s, i))
        if b < 48 or b > 57
            return false
    true

// Parse one octet string to 0..255, or -1 on any error.
fn _ic_parse_octet(s: string) -> int
    if not _ic_digits_only(s)
        return -1
    let v = parse_int(s)
    if v < 0 or v > 255
        return -1
    v

// Parse a dotted-quad and return a list of the four octet ints.
// Returns an empty list on any malformed input.
fn _ic_octets(s: string) -> list
    let parts = split(s, ".")
    if len(parts) != 4
        return []
    let a = _ic_parse_octet(parts[0])
    if a < 0
        return []
    let b = _ic_parse_octet(parts[1])
    if b < 0
        return []
    let c = _ic_parse_octet(parts[2])
    if c < 0
        return []
    let d = _ic_parse_octet(parts[3])
    if d < 0
        return []
    let result = []
    result.push(a)
    result.push(b)
    result.push(c)
    result.push(d)
    result

// ── Public API ────────────────────────────────────────────────────────────────

// ic_class: return RFC 791 address class letter, or "" on bad input.
//
// "10.0.0.1"    -> "A"   (first octet 0..127)
// "172.16.0.1"  -> "B"   (first octet 128..191)
// "192.168.1.1" -> "C"   (first octet 192..223)
// "224.0.0.1"   -> "D"   (first octet 224..239)
// "240.0.0.1"   -> "E"   (first octet 240..255)
fn ic_class(s: string) -> string
    let octs = _ic_octets(s)
    if len(octs) == 0
        return ""
    let first = octs[0]
    if first >= 0 and first <= 127
        return "A"
    if first >= 128 and first <= 191
        return "B"
    if first >= 192 and first <= 223
        return "C"
    if first >= 224 and first <= 239
        return "D"
    "E"

// ic_is_private: RFC 1918 private address check.
//
// "10.1.2.3"      -> true   (10.0.0.0/8)
// "172.16.5.5"    -> true   (172.16.0.0/12)
// "172.31.255.255"-> true   (172.16.0.0/12, second octet 16..31)
// "172.32.0.1"    -> false  (outside /12 range)
// "192.168.1.1"   -> true   (192.168.0.0/16)
// "8.8.8.8"       -> false
fn ic_is_private(s: string) -> bool
    let octs = _ic_octets(s)
    if len(octs) == 0
        return false
    let a = octs[0]
    let b = octs[1]
    if a == 10
        return true
    if a == 172
        if b >= 16 and b <= 31
            return true
    if a == 192 and b == 168
        return true
    false

// ic_is_loopback: 127.0.0.0/8 check.
//
// "127.0.0.1"   -> true
// "127.255.0.1" -> true
// "128.0.0.1"   -> false
fn ic_is_loopback(s: string) -> bool
    let octs = _ic_octets(s)
    if len(octs) == 0
        return false
    octs[0] == 127

// ic_is_multicast: 224.0.0.0/4 check (class D, first octet 224..239).
//
// "224.0.0.1"   -> true
// "239.255.1.1" -> true
// "240.0.0.1"   -> false
fn ic_is_multicast(s: string) -> bool
    let octs = _ic_octets(s)
    if len(octs) == 0
        return false
    let a = octs[0]
    a >= 224 and a <= 239

// ic_is_link_local: 169.254.0.0/16 check.
//
// "169.254.1.1"  -> true
// "169.254.0.0"  -> true
// "169.253.1.1"  -> false
// "170.254.1.1"  -> false
fn ic_is_link_local(s: string) -> bool
    let octs = _ic_octets(s)
    if len(octs) == 0
        return false
    octs[0] == 169 and octs[1] == 254
