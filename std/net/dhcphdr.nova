// ============================================================================
// NOVA Standard Library — std/net/dhcphdr
// ============================================================================
// RFC 2131 — DHCP/BOOTP fixed header codec (big-endian wire format).
//
// Wire layout (240 bytes exactly; all multi-byte fields big-endian):
//   Byte   0     : op           — 1=BOOTREQUEST, 2=BOOTREPLY
//   Byte   1     : htype        — hardware type (1=Ethernet)
//   Byte   2     : hlen         — hardware address length (6 for MAC)
//   Byte   3     : hops         — relay agent hop count
//   Bytes  4-7   : xid          (u32) — transaction ID
//   Bytes  8-9   : secs         (u16) — seconds elapsed
//   Bytes 10-11  : flags        (u16) — broadcast flag in MSB
//   Bytes 12-15  : ciaddr       (u32) — client IP address
//   Bytes 16-19  : yiaddr       (u32) — 'your' (client) IP address
//   Bytes 20-23  : siaddr       (u32) — next server IP address
//   Bytes 24-27  : giaddr       (u32) — relay agent IP address
//   Bytes 28-43  : chaddr       (16 bytes) — client hardware address
//   Bytes 44-107 : sname        (64 bytes) — server host name (zero-padded)
//   Bytes 108-235: file         (128 bytes) — boot file name (zero-padded)
//   Bytes 236-239: magic_cookie (u32) — always 0x63825363 (RFC 2131)
//
// PUBLIC API:
//   dhcp_encode(h: dict) -> bytes
//     h keys: "op","htype","hlen","hops","xid","secs","flags",
//             "ciaddr","yiaddr","siaddr","giaddr",
//             "chaddr" (bytes, 1..16 bytes; zero-padded to 16),
//             "sname"  (bytes, optional; zero-padded to 64),
//             "file"   (bytes, optional; zero-padded to 128)
//     Missing scalar keys default to 0.  Returns exactly 240 bytes.
//     magic_cookie is ALWAYS written as 0x63825363 (caller cannot override).
//
//   dhcp_decode(b: bytes) -> dict
//     Decodes the first 240 bytes of b as a DHCP header.
//     Returns {} on short input (bytes_len(b) < 240).
//     Returns {"op","htype","hlen","hops","xid","secs","flags",
//              "ciaddr","yiaddr","siaddr","giaddr","chaddr","magic_cookie"}
//     where "chaddr" is the 16-byte hardware address field as bytes.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// Read a big-endian u16 from b at position i (caller ensures bounds).
fn _dh_r16(b, i)
    ((bytes_get(b, i) << 8) | bytes_get(b, i + 1)) & 0xFFFF

// Read a big-endian u32 from b at position i (caller ensures bounds).
fn _dh_r32(b, i)
    let hi = (bytes_get(b, i) << 24) | (bytes_get(b, i + 1) << 16)
    let lo = (bytes_get(b, i + 2) << 8) | bytes_get(b, i + 3)
    (hi | lo) & 0xFFFFFFFF

// Append a big-endian u16 to out; return new bytes.
fn _dh_w16(out, v)
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// Append a big-endian u32 to out; return new bytes.
fn _dh_w32(out, v)
    out = bytes_append(out, (v >> 24) & 0xFF)
    out = bytes_append(out, (v >> 16) & 0xFF)
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// Read an integer field from dict h at key; return 0 if absent.
fn _dh_get(h, key)
    if key in h
        return h[key]
    0

// Append exactly n bytes from src into out, zero-padding if src is shorter.
// src must be a bytes value or absent (if absent, write n zero bytes).
fn _dh_pad_bytes(out, src, n)
    let src_len = bytes_len(src)
    for i in 0..n
        if i < src_len
            out = bytes_append(out, bytes_get(src, i))
        else
            out = bytes_append(out, 0)
    out

// ── Public API ────────────────────────────────────────────────────────────────

// dhcp_encode: dict -> 240-byte DHCP header wire bytes.
//
// The magic cookie (bytes 236-239) is always 0x63825363 per RFC 2131 §3.
// The "chaddr" value must be a bytes value (up to 16 bytes; zero-padded).
// The "sname" and "file" fields are optional bytes values (zero-padded).
//
// Example:
//   dhcp_encode({"op":1,"htype":1,"hlen":6,"hops":0,
//                "xid":0x3903F326,"secs":0,"flags":0x8000,
//                "ciaddr":0,"yiaddr":0,"siaddr":0,"giaddr":0,
//                "chaddr":chaddr_bytes})
//   => 240 bytes; byte[0]==1; u32@4==0x3903F326; u32@236==0x63825363
fn dhcp_encode(h)
    let op     = _dh_get(h, "op")
    let htype  = _dh_get(h, "htype")
    let hlen   = _dh_get(h, "hlen")
    let hops   = _dh_get(h, "hops")
    let xid    = _dh_get(h, "xid")
    let secs   = _dh_get(h, "secs")
    let flags  = _dh_get(h, "flags")
    let ciaddr = _dh_get(h, "ciaddr")
    let yiaddr = _dh_get(h, "yiaddr")
    let siaddr = _dh_get(h, "siaddr")
    let giaddr = _dh_get(h, "giaddr")
    let out = bytes(0)
    out = bytes_append(out, op & 0xFF)
    out = bytes_append(out, htype & 0xFF)
    out = bytes_append(out, hlen & 0xFF)
    out = bytes_append(out, hops & 0xFF)
    out = _dh_w32(out, xid & 0xFFFFFFFF)
    out = _dh_w16(out, secs & 0xFFFF)
    out = _dh_w16(out, flags & 0xFFFF)
    out = _dh_w32(out, ciaddr & 0xFFFFFFFF)
    out = _dh_w32(out, yiaddr & 0xFFFFFFFF)
    out = _dh_w32(out, siaddr & 0xFFFFFFFF)
    out = _dh_w32(out, giaddr & 0xFFFFFFFF)
    let chaddr_src = bytes(0)
    if "chaddr" in h
        chaddr_src = h["chaddr"]
    out = _dh_pad_bytes(out, chaddr_src, 16)
    let sname_src = bytes(0)
    if "sname" in h
        sname_src = h["sname"]
    out = _dh_pad_bytes(out, sname_src, 64)
    let file_src = bytes(0)
    if "file" in h
        file_src = h["file"]
    out = _dh_pad_bytes(out, file_src, 128)
    out = _dh_w32(out, 0x63825363)
    out

// dhcp_decode: bytes -> dict
//
// Decodes the first 240 bytes of b as a DHCP/BOOTP fixed header.
// Returns {} on short input (fewer than 240 bytes); never crashes.
//
// "chaddr" in the returned dict is the 16-byte hardware-address field as bytes.
// "magic_cookie" is returned so callers can verify it equals 0x63825363.
//
// Example:
//   let hdr = dhcp_decode(wire)
//   print(str(hdr["op"]))           // 1 = request, 2 = reply
//   print(str(hdr["xid"]))          // transaction ID
//   print(str(hdr["magic_cookie"])) // should be 1670007651 = 0x63825363
fn dhcp_decode(b)
    let empty = {}
    if bytes_len(b) < 240
        return empty
    let op     = bytes_get(b, 0)
    let htype  = bytes_get(b, 1)
    let hlen   = bytes_get(b, 2)
    let hops   = bytes_get(b, 3)
    let xid    = _dh_r32(b, 4)
    let secs   = _dh_r16(b, 8)
    let flags  = _dh_r16(b, 10)
    let ciaddr = _dh_r32(b, 12)
    let yiaddr = _dh_r32(b, 16)
    let siaddr = _dh_r32(b, 20)
    let giaddr = _dh_r32(b, 24)
    let chaddr = bytes_slice(b, 28, 44)
    let magic  = _dh_r32(b, 236)
    {"op": op, "htype": htype, "hlen": hlen, "hops": hops, "xid": xid, "secs": secs, "flags": flags, "ciaddr": ciaddr, "yiaddr": yiaddr, "siaddr": siaddr, "giaddr": giaddr, "chaddr": chaddr, "magic_cookie": magic}
