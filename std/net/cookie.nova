// ============================================================================
// NOVA Standard Library — std/net/cookie
// ============================================================================
// HTTP cookie parsing and serialization.
//
// PUBLIC API:
//   ck_parse(header: string) -> dict
//     Parse a Cookie request header value ("a=1; b=2") into a dict mapping
//     cookie name -> value strings.  Trims leading/trailing spaces around
//     each pair.  On duplicate names, last value wins.  Cookie values with
//     no '=' get value "".
//
//   ck_build(pairs: dict) -> string
//     Serialise a dict of name->value cookies into a Cookie header value
//     ("a=1; b=2").  Keys are sorted for deterministic output.
//
//   ck_set_cookie(name: string, value: string, opts: dict) -> string
//     Build a Set-Cookie response header value.  Always emits "name=value".
//     Appends (in order):
//       "; Path=<v>"     if opts has key "path"
//       "; Domain=<v>"   if opts has key "domain"
//       "; Max-Age=<v>"  if opts has key "max_age"
//       "; HttpOnly"     if opts has key "HttpOnly" and value is truthy
//       "; Secure"       if opts has key "Secure" and value is truthy
//       "; SameSite=<v>" if opts has key "samesite"
//
// DESIGN NOTES:
//   * Parsing splits on "; " (semicolon+space) per RFC 6265 §5.2.
//     We also handle bare ";" with optional surrounding spaces via trim.
//   * Bare flags HttpOnly and Secure: the spec emits them without a value.
//     We check contains(opts, key) — if present, the value is emitted only
//     if it is truthy (non-zero int or non-empty string).
//   * NOVA dict missing-key yields int 0, not "".  Always guard with
//     contains() before reading a value as string.
//   * type_of(v)=="int" vs "string" used to pick the truthy check path.
//   * All private helpers prefixed _ck_ to avoid symbol collisions.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _ck_trim: strip leading and trailing ASCII spaces (0x20) from a string.
fn _ck_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and char_at(s, start) == " "
        start += 1
    let stop = n - 1
    while stop >= start and char_at(s, stop) == " "
        stop -= 1
    if start > stop
        return ""
    slice(s, start, stop + 1)

// _ck_split_first_eq: split on the first '=' in s.
// Returns a 2-element list [left, right].  If no '=' found returns [s, ""].
fn _ck_split_first_eq(s: string) -> list
    let n = len(s)
    let i = 0
    let found = -1
    while i < n
        if char_at(s, i) == "="
            found = i
            i = n
        else
            i += 1
    let res = []
    if found < 0
        res.push(s)
        res.push("")
    else
        res.push(slice(s, 0, found))
        res.push(slice(s, found + 1, n))
    res

// _ck_truthy: return 1 if dict value at opts[key] is truthy.
// int: non-zero is truthy.  string: non-empty is truthy.  Anything else: truthy.
fn _ck_truthy(opts: dict, key: string) -> int
    if key not in opts
        return 0
    let v = opts[key]
    if type_of(v) == "int"
        if v == 0
            return 0
        return 1
    if type_of(v) == "string"
        if v == ""
            return 0
        return 1
    1

// _ck_str_val: safely read a string value from opts; returns "" if absent.
fn _ck_str_val(opts: dict, key: string) -> string
    if key not in opts
        return ""
    str(opts[key])

// ── Public API ────────────────────────────────────────────────────────────────

// ck_parse: parse a Cookie header value into a dict of name->value strings.
//
// Examples:
//   ck_parse("a=1; b=2")         -> {"a":"1", "b":"2"}
//   ck_parse("session=abc123")   -> {"session":"abc123"}
//   ck_parse("x=hello world")    -> {"x":"hello world"}
//   ck_parse("")                 -> {}
fn ck_parse(header: string) -> dict
    let result = {}
    if len(header) == 0
        return result
    let parts = split(header, ";")
    for i in 0..len(parts)
        let raw = _ck_trim(parts[i])
        if len(raw) > 0
            let pair = _ck_split_first_eq(raw)
            let name = _ck_trim(pair[0])
            let value = _ck_trim(pair[1])
            if len(name) > 0
                result[name] = value
    result

// ck_build: serialise a name->value dict to a Cookie header value.
// Keys are sorted for deterministic output, pairs joined by "; ".
//
// Examples:
//   ck_build({"a":"1","b":"2"})  -> "a=1; b=2"
//   ck_build({"z":"9","a":"1"})  -> "a=1; z=9"
//   ck_build({})                 -> ""
fn ck_build(pairs: dict) -> string
    let ks = keys(pairs)
    sort(ks)
    let result = ""
    for i in 0..len(ks)
        let k = ks[i]
        let v = pairs[k]
        let seg = k + "=" + str(v)
        if i == 0
            result = seg
        else
            result += "; " + seg
    result

// ck_set_cookie: build a Set-Cookie response header value.
//
// Recognised opts keys:
//   "path"      -> "; Path=<value>"
//   "domain"    -> "; Domain=<value>"
//   "max_age"   -> "; Max-Age=<value>"
//   "HttpOnly"  -> "; HttpOnly"  (emitted if present and truthy)
//   "Secure"    -> "; Secure"    (emitted if present and truthy)
//   "samesite"  -> "; SameSite=<value>"
//
// Examples:
//   ck_set_cookie("sid","xyz",{})                     -> "sid=xyz"
//   ck_set_cookie("sid","xyz",{"path":"/"})           -> "sid=xyz; Path=/"
//   ck_set_cookie("sid","xyz",{"HttpOnly":1})         -> "sid=xyz; HttpOnly"
//   ck_set_cookie("a","b",{"path":"/","domain":"example.com","max_age":"3600","HttpOnly":1,"Secure":1,"samesite":"Strict"})
//     -> "a=b; Path=/; Domain=example.com; Max-Age=3600; HttpOnly; Secure; SameSite=Strict"
fn ck_set_cookie(name: string, value: string, opts: dict) -> string
    let result = name + "=" + value
    if "path" in opts
        result += "; Path=" + _ck_str_val(opts, "path")
    if "domain" in opts
        result += "; Domain=" + _ck_str_val(opts, "domain")
    if "max_age" in opts
        result += "; Max-Age=" + _ck_str_val(opts, "max_age")
    if _ck_truthy(opts, "HttpOnly") == 1
        result += "; HttpOnly"
    if _ck_truthy(opts, "Secure") == 1
        result += "; Secure"
    if "samesite" in opts
        result += "; SameSite=" + _ck_str_val(opts, "samesite")
    result

// _ck_to_lower: convert ASCII uppercase letters to lowercase in s.
fn _ck_to_lower(s: string) -> string
    let n = len(s)
    let result = ""
    for i in 0..n
        let c = char_at(s, i)
        let o = ord(c)
        if o >= 65 and o <= 90
            result += chr(o + 32)
        else
            result += c
    result

// ck_parse_set_cookie: parse a Set-Cookie response header value.
//
// Splits on ";", trims each part, splits first part on first "=" to extract
// cookie name and value.  Remaining parts are attributes:
//   - If the part contains "=", key=lowercased-attr-name, value=attr-value.
//   - If bare (no "="), key=lowercased-attr-name, value="true".
//
// Returns a dict:
//   { "name": <string>, "value": <string>, "attrs": <dict> }
//
// Example:
//   ck_parse_set_cookie("sid=xyz; Path=/; HttpOnly; Max-Age=3600")
//   -> { "name":"sid", "value":"xyz",
//        "attrs": { "path":"/", "httponly":"true", "max-age":"3600" } }
fn ck_parse_set_cookie(header: string) -> dict
    let result = {}
    let attrs = {}
    result["name"] = ""
    result["value"] = ""
    result["attrs"] = attrs
    if len(header) == 0
        return result
    let parts = split(header, ";")
    // First part is name=value
    let first = _ck_trim(parts[0])
    let pair = _ck_split_first_eq(first)
    result["name"] = _ck_trim(pair[0])
    result["value"] = _ck_trim(pair[1])
    // Remaining parts are attributes
    for i in 1..len(parts)
        let raw = _ck_trim(parts[i])
        if len(raw) > 0
            let ap = _ck_split_first_eq(raw)
            let ak = _ck_to_lower(_ck_trim(ap[0]))
            let av = _ck_trim(ap[1])
            if len(av) == 0
                attrs[ak] = "true"
            else
                attrs[ak] = av
    result["attrs"] = attrs
    result

// ck_serialize: build a Set-Cookie response header value from components.
//
// Emits "name=value" then appends attribute pairs sorted by attribute name.
// Each attribute: if value is "true" (the sentinel for valueless flags) the
// attribute name is emitted without "=" and with title-cased first letter;
// otherwise "Attrname=value" is emitted with title-case.
//
// To preserve original capitalisation for well-known attrs, the caller should
// store attrs with lowercased keys (matching ck_parse_set_cookie output) and
// we apply simple title-case (first letter uppercased, rest as-is) when emitting.
//
// Examples:
//   ck_serialize("sid","xyz",{})                   -> "sid=xyz"
//   ck_serialize("sid","xyz",{"path":"/"})         -> "sid=xyz; Path=/"
//   ck_serialize("sid","xyz",{"httponly":"true"})  -> "sid=xyz; Httponly"
fn ck_serialize(name: string, value: string, attrs_dict: dict) -> string
    let result = name + "=" + value
    let aks = keys(attrs_dict)
    sort(aks)
    for i in 0..len(aks)
        let ak = aks[i]
        let av = str(attrs_dict[ak])
        // Title-case the key: uppercase first char
        let titled = ""
        if len(ak) > 0
            let fc = ord(char_at(ak, 0))
            if fc >= 97 and fc <= 122
                titled = chr(fc - 32) + slice(ak, 1, len(ak))
            else
                titled = ak
        else
            titled = ak
        if av == "true"
            result += "; " + titled
        else
            result += "; " + titled + "=" + av
    result
