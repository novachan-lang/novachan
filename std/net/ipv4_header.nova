// ============================================================================
// NOVA Standard Library — std/net/ipv4_header
// ============================================================================
// RFC 791 — 20-byte IPv4 fixed header parse/build, operating on a plain
// `list` of byte values (0..255). See std/net/ipv4hdr.nova for the
// `bytes`-typed dict-codec equivalent; this module is the `list`-typed
// sibling for packet-crafting-style code that builds packets as int lists.
// IPv4 options (when ihl > 5) are handled separately by std/net/ip_options.
//
// Wire layout (20 bytes, all multi-byte fields big-endian):
//   Byte  0    : version(4b) | IHL(4b)        — normally 0x45
//   Byte  1    : TOS / DSCP+ECN
//   Bytes 2-3  : Total Length (u16)
//   Bytes 4-5  : Identification (u16)
//   Bytes 6-7  : Flags(3b) | Fragment Offset(13b)
//   Byte  8    : TTL
//   Byte  9    : Protocol (1=ICMP, 6=TCP, 17=UDP, ...)
//   Bytes 10-11: Header Checksum (u16, RFC 1071)
//   Bytes 12-15: Source IP (u32)
//   Bytes 16-19: Destination IP (u32)
//
// PUBLIC API:
//   ipv4_parse(bytes: list) -> dict
//     Parses the first 20 bytes of `bytes` as a fixed IPv4 header.
//     Returns {} if fewer than 20 bytes, version != 4, or ihl < 5.
//     Keys: version, ihl, tos, total_length, identification, flags,
//           fragment_offset, ttl, protocol, checksum, src_ip, dst_ip.
//
//   ipv4_build(hdr: dict) -> list
//     Builds a 20-byte header from hdr (missing keys default to 0; version
//     defaults to 4; ihl defaults to 5 and is clamped up to 5 if lower).
//     The checksum field is COMPUTED (RFC 1071 over the 20 header bytes
//     with the checksum field zeroed) and embedded — any "checksum" key
//     supplied in hdr is ignored.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

fn _iph_get(h: dict, key: string) -> int
    if key in h
        return h[key]
    0

fn _iph_r16(b: list, i: int) -> int
    ((b[i] & 0xFF) << 8) | (b[i + 1] & 0xFF)

fn _iph_r32(b: list, i: int) -> int
    let hi = ((b[i] & 0xFF) << 24) | ((b[i + 1] & 0xFF) << 16)
    let lo = ((b[i + 2] & 0xFF) << 8) | (b[i + 3] & 0xFF)
    (hi | lo) & 0xFFFFFFFF

fn _iph_w16(out: list, v: int) -> list
    push(out, (v >> 8) & 0xFF)
    push(out, v & 0xFF)
    out

fn _iph_w32(out: list, v: int) -> list
    push(out, (v >> 24) & 0xFF)
    push(out, (v >> 16) & 0xFF)
    push(out, (v >> 8) & 0xFF)
    push(out, v & 0xFF)
    out

// RFC 1071 ones-complement checksum over a list of byte ints.
fn _iph_checksum(b: list) -> int
    let acc = 0
    let i = 0
    let n = len(b)
    while i + 1 < n
        acc += (((b[i] & 0xFF) << 8) | (b[i + 1] & 0xFF))
        i += 2
    if i < n
        acc += ((b[i] & 0xFF) << 8)
    while (acc >> 16) != 0
        acc = (acc & 0xFFFF) + ((acc >> 16) & 0xFFFF)
    (~acc) & 0xFFFF

// ── Public API ────────────────────────────────────────────────────────────────

fn ipv4_parse(bytes: list) -> dict
    if len(bytes) < 20
        return {}
    let verihl = bytes[0] & 0xFF
    let ver = (verihl >> 4) & 0xF
    let ihl = verihl & 0xF
    if ver != 4
        return {}
    if ihl < 5
        return {}
    let tos = bytes[1] & 0xFF
    let tlen = _iph_r16(bytes, 2)
    let ident = _iph_r16(bytes, 4)
    let ff = _iph_r16(bytes, 6)
    let flags = (ff >> 13) & 0x7
    let fro = ff & 0x1FFF
    let ttl = bytes[8] & 0xFF
    let proto = bytes[9] & 0xFF
    let csum = _iph_r16(bytes, 10)
    let src = _iph_r32(bytes, 12)
    let dst = _iph_r32(bytes, 16)
    {"version": ver, "ihl": ihl, "tos": tos, "total_length": tlen, "identification": ident, "flags": flags, "fragment_offset": fro, "ttl": ttl, "protocol": proto, "checksum": csum, "src_ip": src, "dst_ip": dst}

fn ipv4_build(hdr: dict) -> list
    let ver = 4
    if "version" in hdr
        ver = hdr["version"]
    let ihl = 5
    if "ihl" in hdr
        ihl = hdr["ihl"]
    if ihl < 5
        ihl = 5
    let tos = _iph_get(hdr, "tos")
    let tlen = _iph_get(hdr, "total_length")
    let ident = _iph_get(hdr, "identification")
    let flags = _iph_get(hdr, "flags")
    let fro = _iph_get(hdr, "fragment_offset")
    let ttl = _iph_get(hdr, "ttl")
    let proto = _iph_get(hdr, "protocol")
    let src = _iph_get(hdr, "src_ip")
    let dst = _iph_get(hdr, "dst_ip")
    let verihl = ((ver & 0xF) << 4) | (ihl & 0xF)
    let ff = ((flags & 0x7) << 13) | (fro & 0x1FFF)
    let out = []
    push(out, verihl & 0xFF)
    push(out, tos & 0xFF)
    out = _iph_w16(out, tlen & 0xFFFF)
    out = _iph_w16(out, ident & 0xFFFF)
    out = _iph_w16(out, ff & 0xFFFF)
    push(out, ttl & 0xFF)
    push(out, proto & 0xFF)
    out = _iph_w16(out, 0)
    out = _iph_w32(out, src & 0xFFFFFFFF)
    out = _iph_w32(out, dst & 0xFFFFFFFF)
    let csum = _iph_checksum(out)
    out[10] = (csum >> 8) & 0xFF
    out[11] = csum & 0xFF
    out
