// ============================================================================
// NOVA Standard Library — std/net/dns_types
// ============================================================================
// DNS constants and name<->number maps (RFC 1035 + updates).
//
// PUBLIC API:
//   dns_type_num(name: string) -> int
//     Return the numeric QTYPE for the given mnemonic, e.g. "A"->1.
//     Returns 0 for unknown names.
//
//   dns_type_name(num: int) -> string
//     Return the mnemonic for a numeric QTYPE, e.g. 1->"A".
//     Returns "" for unknown numbers.
//
//   dns_class_num(name: string) -> int
//     Return the numeric QCLASS for the given mnemonic, e.g. "IN"->1.
//     Returns 0 for unknown names.
//
//   dns_class_name(num: int) -> string
//     Return the mnemonic for a numeric QCLASS, e.g. 1->"IN".
//     Returns "" for unknown numbers.
//
//   dns_rcode_name(num: int) -> string
//     Return the mnemonic for a numeric RCODE, e.g. 3->"NXDOMAIN".
//     Returns "" for unknown codes.
//
//   dns_opcode_name(num: int) -> string
//     Return the mnemonic for a numeric OPCODE, e.g. 0->"QUERY".
//     Returns "" for unknown codes.
//
// TYPE values (RFC 1035 + RFC 3596 + RFC 2782):
//   A=1, NS=2, CNAME=5, SOA=6, PTR=12, MX=15, TXT=16, AAAA=28, SRV=33, OPT=41
//
// CLASS values (RFC 1035):
//   IN=1, CS=2, CH=3, HS=4
//
// OPCODE values (RFC 1035):
//   QUERY=0, IQUERY=1, STATUS=2
//
// RCODE values (RFC 1035):
//   NOERROR=0, FORMERR=1, SERVFAIL=2, NXDOMAIN=3, NOTIMP=4, REFUSED=5
//
// LEAF — imports NOTHING.
// ============================================================================

// dns_type_num: return the numeric QTYPE for the given mnemonic.
// Returns 0 for unknown names.
fn dns_type_num(name: string) -> int
    if name == "A" then return 1
    if name == "NS" then return 2
    if name == "CNAME" then return 5
    if name == "SOA" then return 6
    if name == "PTR" then return 12
    if name == "MX" then return 15
    if name == "TXT" then return 16
    if name == "AAAA" then return 28
    if name == "SRV" then return 33
    if name == "OPT" then return 41
    return 0

// dns_type_name: return the mnemonic for a numeric QTYPE.
// Returns "" for unknown numbers.
fn dns_type_name(num: int) -> string
    if num == 1 then return "A"
    if num == 2 then return "NS"
    if num == 5 then return "CNAME"
    if num == 6 then return "SOA"
    if num == 12 then return "PTR"
    if num == 15 then return "MX"
    if num == 16 then return "TXT"
    if num == 28 then return "AAAA"
    if num == 33 then return "SRV"
    if num == 41 then return "OPT"
    return ""

// dns_class_num: return the numeric QCLASS for the given mnemonic.
// Returns 0 for unknown names.
fn dns_class_num(name: string) -> int
    if name == "IN" then return 1
    if name == "CS" then return 2
    if name == "CH" then return 3
    if name == "HS" then return 4
    return 0

// dns_class_name: return the mnemonic for a numeric QCLASS.
// Returns "" for unknown numbers.
fn dns_class_name(num: int) -> string
    if num == 1 then return "IN"
    if num == 2 then return "CS"
    if num == 3 then return "CH"
    if num == 4 then return "HS"
    return ""

// dns_rcode_name: return the mnemonic for a numeric RCODE.
// Returns "" for unknown codes.
fn dns_rcode_name(num: int) -> string
    if num == 0 then return "NOERROR"
    if num == 1 then return "FORMERR"
    if num == 2 then return "SERVFAIL"
    if num == 3 then return "NXDOMAIN"
    if num == 4 then return "NOTIMP"
    if num == 5 then return "REFUSED"
    return ""

// dns_opcode_name: return the mnemonic for a numeric OPCODE.
// Returns "" for unknown codes.
fn dns_opcode_name(num: int) -> string
    if num == 0 then return "QUERY"
    if num == 1 then return "IQUERY"
    if num == 2 then return "STATUS"
    return ""
