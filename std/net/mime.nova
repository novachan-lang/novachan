// ============================================================================
// NOVA Standard Library — std/net/mime
// ============================================================================
// MIME type lookup from file extension and reverse lookup.
//
// PUBLIC API:
//   mime_type(filename: string) -> string
//     Return the MIME content-type for the given filename, determined by the
//     extension after the last '.'.  Extension matching is case-insensitive.
//     Returns "" if the extension is absent or unrecognised.
//
//   mime_ext(content_type: string) -> string
//     Return a representative file extension for the given MIME type string,
//     without a leading dot.  Returns "" if unrecognised.
//
// DESIGN NOTES:
//   * Uses if-chains (no module-level multi-line list) per NOVA gotchas.
//   * Private helpers prefixed _mime_ to avoid symbol collisions.
//   * Extension extraction uses split() on "." and takes the last part.
//   * lower() (native builtin) is used for case-insensitive extension matching.
//
// LEAF — imports NOTHING.
// ============================================================================

// _mime_ext_of: extract the lowercased extension from a filename.
// Returns "" if no '.' is present in the filename (i.e. no extension).
fn _mime_ext_of(filename: string) -> string
    let parts = split(filename, ".")
    let n = len(parts)
    if n <= 1
        return ""
    lower(parts[n - 1])

// mime_type: return the MIME content-type for filename's extension.
// Returns "" if extension is absent or not in the table.
fn mime_type(filename: string) -> string
    let ext = _mime_ext_of(filename)
    if ext == ""
        return ""
    // text
    if ext == "html" then return "text/html"
    if ext == "htm"  then return "text/html"
    if ext == "css"  then return "text/css"
    if ext == "txt"  then return "text/plain"
    if ext == "csv"  then return "text/csv"
    if ext == "xml"  then return "application/xml"
    // scripts / data
    if ext == "js"   then return "application/javascript"
    if ext == "json" then return "application/json"
    // images
    if ext == "png"  then return "image/png"
    if ext == "jpg"  then return "image/jpeg"
    if ext == "jpeg" then return "image/jpeg"
    if ext == "gif"  then return "image/gif"
    if ext == "svg"  then return "image/svg+xml"
    if ext == "webp" then return "image/webp"
    if ext == "ico"  then return "image/x-icon"
    if ext == "bmp"  then return "image/bmp"
    if ext == "tiff" then return "image/tiff"
    if ext == "tif"  then return "image/tiff"
    // documents
    if ext == "pdf"  then return "application/pdf"
    // archives
    if ext == "zip"  then return "application/zip"
    if ext == "gz"   then return "application/gzip"
    if ext == "tar"  then return "application/x-tar"
    if ext == "bz2"  then return "application/x-bzip2"
    if ext == "xz"   then return "application/x-xz"
    if ext == "7z"   then return "application/x-7z-compressed"
    if ext == "rar"  then return "application/x-rar-compressed"
    // audio / video
    if ext == "mp3"  then return "audio/mpeg"
    if ext == "wav"  then return "audio/wav"
    if ext == "ogg"  then return "audio/ogg"
    if ext == "flac" then return "audio/flac"
    if ext == "aac"  then return "audio/aac"
    if ext == "mp4"  then return "video/mp4"
    if ext == "webm" then return "video/webm"
    if ext == "ogv"  then return "video/ogg"
    if ext == "avi"  then return "video/x-msvideo"
    if ext == "mov"  then return "video/quicktime"
    if ext == "mkv"  then return "video/x-matroska"
    // fonts
    if ext == "woff"  then return "font/woff"
    if ext == "woff2" then return "font/woff2"
    if ext == "ttf"   then return "font/ttf"
    if ext == "otf"   then return "font/otf"
    // binary / misc
    if ext == "wasm" then return "application/wasm"
    if ext == "bin"  then return "application/octet-stream"
    if ext == "exe"  then return "application/octet-stream"
    if ext == "dll"  then return "application/octet-stream"
    ""

// mime_ext: return a representative file extension for a MIME content-type.
// Returns "" if the type is not recognised.
fn mime_ext(content_type: string) -> string
    if content_type == "text/html"                      then return "html"
    if content_type == "text/css"                       then return "css"
    if content_type == "text/plain"                     then return "txt"
    if content_type == "text/csv"                       then return "csv"
    if content_type == "application/xml"                then return "xml"
    if content_type == "text/xml"                       then return "xml"
    if content_type == "application/javascript"         then return "js"
    if content_type == "text/javascript"                then return "js"
    if content_type == "application/json"               then return "json"
    if content_type == "image/png"                      then return "png"
    if content_type == "image/jpeg"                     then return "jpg"
    if content_type == "image/gif"                      then return "gif"
    if content_type == "image/svg+xml"                  then return "svg"
    if content_type == "image/webp"                     then return "webp"
    if content_type == "image/x-icon"                   then return "ico"
    if content_type == "image/bmp"                      then return "bmp"
    if content_type == "image/tiff"                     then return "tiff"
    if content_type == "application/pdf"                then return "pdf"
    if content_type == "application/zip"                then return "zip"
    if content_type == "application/gzip"               then return "gz"
    if content_type == "application/x-tar"              then return "tar"
    if content_type == "application/x-bzip2"            then return "bz2"
    if content_type == "application/x-xz"               then return "xz"
    if content_type == "application/x-7z-compressed"    then return "7z"
    if content_type == "application/x-rar-compressed"   then return "rar"
    if content_type == "audio/mpeg"                     then return "mp3"
    if content_type == "audio/wav"                      then return "wav"
    if content_type == "audio/ogg"                      then return "ogg"
    if content_type == "audio/flac"                     then return "flac"
    if content_type == "audio/aac"                      then return "aac"
    if content_type == "video/mp4"                      then return "mp4"
    if content_type == "video/webm"                     then return "webm"
    if content_type == "video/ogg"                      then return "ogv"
    if content_type == "video/x-msvideo"                then return "avi"
    if content_type == "video/quicktime"                then return "mov"
    if content_type == "video/x-matroska"               then return "mkv"
    if content_type == "font/woff"                      then return "woff"
    if content_type == "font/woff2"                     then return "woff2"
    if content_type == "font/ttf"                       then return "ttf"
    if content_type == "font/otf"                       then return "otf"
    if content_type == "application/wasm"               then return "wasm"
    if content_type == "application/octet-stream"       then return "bin"
    ""
