// ============================================================================
// NOVA Standard Library — std/net/gopher
// ============================================================================
// Gopher protocol codec — RFC 1436, TEXT protocol (no live sockets).
//
// PUBLIC API:
//   gopher_item(type, display, selector, host, port) -> string
//     Build one Gopher menu item line:
//       TYPE + display + TAB + selector + TAB + host + TAB + port + CRLF
//     TYPE is a single character (e.g. "0","1","7","9","i","h","g").
//     port is an int; converted to string internally.
//
//   gopher_parse_item(line: string) -> dict
//     Parse one Gopher menu item line (with or without trailing CRLF) into:
//       "type"     -> string  (single character)
//       "display"  -> string  (display text)
//       "selector" -> string  (selector string)
//       "host"     -> string  (hostname)
//       "port"     -> int     (port number)
//     Malformed/empty input: returns dict with empty strings and port 0.
//
//   gopher_menu(items: list) -> string
//     Build a complete Gopher menu from a list of item strings (as returned
//     by gopher_item). Concatenates all items and appends "." + CRLF as the
//     end-of-menu sentinel per RFC 1436.
//
//   gopher_info(text: string) -> string
//     Build an info line (type 'i') with fake selector/host/port as
//     conventional placeholders: selector="", host="error.host", port=1.
//     Returns: "i" + text + TAB + "" + TAB + "error.host" + TAB + "1" + CRLF
//
// DESIGN NOTES:
//   * TAB = chr(9).  CRLF = chr(13) + chr(10).
//   * RFC 1436 type chars: 0=text, 1=dir, 7=search, 9=binary, i=info,
//     h=HTML, g=GIF, I=image, s=sound, d=doc, += redundant server.
//   * gopher_parse_item strips trailing CRLF/LF before parsing.
//   * A line with fewer than 4 TAB-separated fields is malformed;
//     parser returns the zero-value dict.
//   * Port field is parsed with a simple digit loop; non-numeric -> 0.
//   * All private helpers prefixed _gopher_.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _gopher_tab: return TAB character
fn _gopher_tab() -> string
    chr(9)

// _gopher_crlf: return CRLF string
fn _gopher_crlf() -> string
    chr(13) + chr(10)

// _gopher_rtrim_crlf: strip trailing CR (13) and LF (10) from s
fn _gopher_rtrim_crlf(s: string) -> string
    let n = len(s)
    let stop = n
    let cr = chr(13)
    let lf = chr(10)
    let going = 1
    while stop > 0 and going == 1
        let c = slice(s, stop - 1, stop)
        if c == cr or c == lf
            stop -= 1
        else
            going = 0
    slice(s, 0, stop)

// _gopher_find_tab: return index of next TAB at or after start, or n if none
fn _gopher_find_tab(s: string, start: int, n: int) -> int
    let tab = chr(9)
    for i in start..n
        if slice(s, i, i + 1) == tab
            return i
    n

// _gopher_is_digit: 1 if character c (single char string) is '0'..'9'
fn _gopher_is_digit(c: string) -> int
    let o = ord(c)
    if o >= 48 and o <= 57
        return 1
    0

// _gopher_parse_port: parse an ASCII decimal integer string into int (0 if invalid)
fn _gopher_parse_port(s: string) -> int
    let n = len(s)
    if n == 0
        return 0
    let val = 0
    let i = 0
    let ok = 1
    while i < n and ok == 1
        let c = slice(s, i, i + 1)
        if _gopher_is_digit(c) == 0
            ok = 0
        else
            val *= 10 + (ord(c) - 48)
            i += 1
    if ok == 0
        return 0
    val

// ── Public API ───────────────────────────────────────────────────────────────

// gopher_item: build one Gopher menu item line.
//
// Format:  TYPE + display + TAB + selector + TAB + host + TAB + str(port) + CRLF
//
// Examples:
//   gopher_item("1","Home","/","example.com",70)
//     -> "1Home\t/\texample.com\t70\r\n"
//   gopher_item("0","README","/README.txt","gopher.floodgap.com",70)
//     -> "0README\t/README.txt\tgopher.floodgap.com\t70\r\n"
fn gopher_item(itype: string, display: string, selector: string, host: string, port: int) -> string
    let tab = _gopher_tab()
    let crlf = _gopher_crlf()
    itype + display + tab + selector + tab + host + tab + str(port) + crlf

// gopher_parse_item: parse one Gopher menu item line into a structured dict.
//
// Expected format: TYPE + display + TAB + selector + TAB + host + TAB + port + CRLF
// The TYPE character is the very first character of the line (before display text).
// Trailing CRLF or bare LF is stripped before parsing.
//
// Returns dict with keys: "type", "display", "selector", "host", "port"
// On malformed input (< 4 TAB-separated fields after stripping type): returns
// dict with empty strings and port=0.
//
// Examples:
//   gopher_parse_item("1Home\t/\texample.com\t70\r\n")
//     -> {"type":"1","display":"Home","selector":"/","host":"example.com","port":70}
//   gopher_parse_item("iHello world\t\terror.host\t1\r\n")
//     -> {"type":"i","display":"Hello world","selector":"","host":"error.host","port":1}
fn gopher_parse_item(line: string) -> dict
    let result = {}
    result["type"] = ""
    result["display"] = ""
    result["selector"] = ""
    result["host"] = ""
    result["port"] = 0

    let s = _gopher_rtrim_crlf(line)
    let n = len(s)

    // Need at least 1 char for type
    if n < 1
        return result

    // First character is the item type
    let itype = slice(s, 0, 1)
    result["type"] = itype

    // Find first TAB: separates display from selector
    let t1 = _gopher_find_tab(s, 1, n)
    // display is between position 1 and first TAB
    result["display"] = slice(s, 1, t1)

    // If no TAB found, malformed (no selector/host/port)
    if t1 >= n
        return result

    // Find second TAB: separates selector from host
    let t2 = _gopher_find_tab(s, t1 + 1, n)
    result["selector"] = slice(s, t1 + 1, t2)

    if t2 >= n
        return result

    // Find third TAB: separates host from port
    let t3 = _gopher_find_tab(s, t2 + 1, n)
    result["host"] = slice(s, t2 + 1, t3)

    if t3 >= n
        return result

    // Port is everything after third TAB (already stripped CRLF)
    let port_str = slice(s, t3 + 1, n)
    result["port"] = _gopher_parse_port(port_str)

    result

// gopher_menu: build a complete Gopher menu from a list of item strings.
//
// Concatenates all items (each already a full item line with CRLF) and appends
// the RFC 1436 end-of-menu sentinel: "." + CRLF.
//
// items: list of strings, each produced by gopher_item() or gopher_info().
//
// Example:
//   gopher_menu(["1Home\t/\texample.com\t70\r\n"])
//     -> "1Home\t/\texample.com\t70\r\n.\r\n"
fn gopher_menu(items: list) -> string
    let out_parts = []
    let i = 0
    let n = len(items)
    while i < n
        push(out_parts, str(items[i]))
        i += 1
    let out = join(out_parts, "")
    out + "." + _gopher_crlf()

// gopher_info: build an info-type (type 'i') Gopher menu line.
//
// Info lines carry human-readable text with conventional placeholder
// selector="", host="error.host", port=1 (widely used convention).
//
// Example:
//   gopher_info("Welcome to Gopherspace!")
//     -> "iWelcome to Gopherspace!\t\terror.host\t1\r\n"
fn gopher_info(text: string) -> string
    let tab = _gopher_tab()
    let crlf = _gopher_crlf()
    "i" + text + tab + "" + tab + "error.host" + tab + "1" + crlf
