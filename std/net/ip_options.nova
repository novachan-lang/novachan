// ============================================================================
// NOVA Standard Library — std/net/ip_options
// ============================================================================
// RFC 791 §3.1 — IPv4 options-field parsing, operating on a plain `list` of
// byte values (0..255). Consumes the options region that follows the fixed
// 20-byte header parsed by std/net/ipv4_header (options exist iff ihl > 5).
//
// Each option is either:
//   * a single byte  — type 0 (End of Option List) or type 1 (No-Operation), or
//   * a TLV triple    — type(1) | length(1, INCLUDES the type+length bytes) | data(length-2)
//
// PUBLIC API:
//   ip_opts_parse(bytes: list, ihl: int) -> list
//     `bytes` is the full header buffer starting at offset 0 (byte 0 =
//     version/ihl, options begin at byte 20). `ihl` is the header length in
//     32-bit words (as decoded by ipv4_header.ipv4_parse); the options
//     region spans bytes [20, ihl*4).
//     Returns a list of option dicts {"type": int, "length": int, "data": list}.
//     Stops (returning what was decoded so far) at: End of Option List (type
//     0), end of the options region, or any malformed length (length < 2,
//     or an option that would run past the options region / past `bytes`).
//     Bounds-safe: never reads outside `bytes`; returns [] if ihl < 5.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// Slice n bytes from b starting at offset i into a new list.
// Caller ensures i+n <= len(b).
fn _ipo_slice(b: list, i: int, n: int) -> list
    let r = [b[i + k] & 0xFF for k in 0..n]
    r

// ── Public API ────────────────────────────────────────────────────────────────

fn ip_opts_parse(bytes: list, ihl: int) -> list
    let opts = []
    if ihl < 5
        return opts
    let n = len(bytes)
    let region_end = ihl * 4
    if region_end > n
        region_end = n
    let i = 20
    let running = 1
    while running == 1 and i < region_end
        let t = bytes[i] & 0xFF
        if t == 0
            push(opts, {"type": 0, "length": 1, "data": []})
            running = 0
        else if t == 1
            push(opts, {"type": 1, "length": 1, "data": []})
            i = i + 1
        else
            if i + 1 >= region_end
                running = 0
            else
                let optlen = bytes[i + 1] & 0xFF
                if optlen < 2 or i + optlen > region_end
                    running = 0
                else
                    let data = _ipo_slice(bytes, i + 2, optlen - 2)
                    push(opts, {"type": t, "length": optlen, "data": data})
                    i = i + optlen
    opts
