// std/search/search_bounds.nova — Lower/upper bound and count over sorted ascending int lists.
// All functions are pure, deterministic, and import nothing.
// Follows STL lower_bound / upper_bound semantics exactly.

// sb_lower_bound — first index i such that a[i] >= t; returns len(a) if all elements < t.
// Invariant: all elements in a[0..lo) are < t; a[hi..n) are >= t.
fn sb_lower_bound(a: list, t: int) -> int
    let n = len(a)
    let lo = 0
    let hi = n
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if a[mid] < t
            lo = mid + 1
        else
            hi = mid
    lo

// sb_upper_bound — first index i such that a[i] > t; returns len(a) if all elements <= t.
// Invariant: all elements in a[0..lo) are <= t; a[hi..n) are > t.
fn sb_upper_bound(a: list, t: int) -> int
    let n = len(a)
    let lo = 0
    let hi = n
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if a[mid] <= t
            lo = mid + 1
        else
            hi = mid
    lo

// sb_count — number of occurrences of t in sorted list a.
// Equals upper_bound(t) - lower_bound(t).
fn sb_count(a: list, t: int) -> int
    let lb = sb_lower_bound(a, t)
    let ub = sb_upper_bound(a, t)
    ub - lb

// sb_insertion_point — index at which t should be inserted to keep a sorted; equals lower_bound.
// If t is already present, returns the index of the first occurrence.
fn sb_insertion_point(a: list, t: int) -> int
    sb_lower_bound(a, t)
