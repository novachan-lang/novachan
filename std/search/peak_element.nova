// std/search/peak_element.nova — find a peak element in an unsorted array.
// A peak is an index i where a[i] > a[i-1] (or i==0) AND a[i] > a[i+1] (or i==len-1).
// Out-of-bounds neighbors are treated as -infinity.
// All functions use binary search on the slope: O(log n).
// LEAF — imports NOTHING.

// pk_is_peak — returns true if index i is a peak in array a.
fn pk_is_peak(a: list, i: int) -> bool
    let n = len(a)
    if n == 0
        return false
    if i < 0 or i >= n
        return false
    let left_ok = true
    if i > 0
        if a[i] <= a[i - 1]
            left_ok = false
    let right_ok = true
    if i < n - 1
        if a[i] <= a[i + 1]
            right_ok = false
    left_ok and right_ok

// pk_find_peak — returns the index of A peak element via binary search.
// Guaranteed to find a peak (every non-empty array has at least one).
// Returns -1 only for an empty array.
fn pk_find_peak(a: list) -> int
    let n = len(a)
    if n == 0
        return -1
    if n == 1
        return 0
    let lo = 0
    let hi = n - 1
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if a[mid] < a[mid + 1]
            lo = mid + 1
        else
            hi = mid
    lo

// pk_find_peak_value — returns the value of a peak element.
// Returns -1 for an empty array (by convention; caller should check length).
fn pk_find_peak_value(a: list) -> int
    let idx = pk_find_peak(a)
    if idx == -1
        return -1
    a[idx]
