// std/search/interpolation_search.nova — interpolation search on a sorted ascending array.
// Uses the probe formula: pos = lo + (t - a[lo]) * (hi - lo) / (a[hi] - a[lo]).
// Division-by-zero (a[hi] == a[lo]) is handled specially: if t == a[lo] return lo, else -1.
// Average O(log log n) for uniform distributions; worst case O(n) for clustered data.
// LEAF — imports NOTHING.

// is_search — returns the index of target t in sorted ascending array a, or -1 if absent.
fn is_search(a: list, t: int) -> int
    let n = len(a)
    if n == 0
        return -1
    let lo = 0
    let hi = n - 1
    let found = -1
    let done = false
    while not done and lo <= hi and t >= a[lo] and t <= a[hi]
        let range_val = a[hi] - a[lo]
        if range_val == 0
            // All elements in [lo..hi] are equal; check if t matches.
            if a[lo] == t
                found = lo
            done = true
        else
            let pos = lo + (t - a[lo]) * (hi - lo) / range_val
            if pos < lo
                pos = lo
            if pos > hi
                pos = hi
            if a[pos] == t
                found = pos
                done = true
            else if a[pos] < t
                lo = pos + 1
            else
                hi = pos - 1
    found

// is_contains — returns true if target t is present in sorted ascending array a.
fn is_contains(a: list, t: int) -> bool
    let idx = is_search(a, t)
    idx >= 0
