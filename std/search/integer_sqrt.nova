// std/search/integer_sqrt.nova — integer root algorithms via binary search.
// All functions use pure integer arithmetic; no floating-point operations.
// LEAF — imports NOTHING.
//
// Contract: n >= 0 for all functions. k >= 1 for iq_nth_root.
//
// Public API:
//   iq_isqrt(n)              -> int   floor(sqrt(n))
//   iq_icbrt(n)              -> int   floor(cbrt(n))
//   iq_nth_root(n, k)        -> int   floor(n^(1/k))
//   iq_is_perfect_square(n)  -> bool  n == m*m for some integer m >= 0
//   iq_is_perfect_power(n)   -> bool  n == m^k for some m >= 2, k >= 2

// _iq_pow — integer exponentiation: base^exp (exp >= 0, base >= 0).
// Stops early and returns a sentinel (n+1) if the result would overflow
// past the supplied ceiling `ceil`, to avoid huge multiplications.
fn _iq_pow_capped(base: int, exp: int, ceil: int) -> int
    if exp == 0
        return 1
    let result = 1
    let b = base
    let e = exp
    while e > 0
        if e % 2 == 1
            result = result * b
            if result > ceil
                return ceil + 1
        b = b * b
        if b > ceil and e > 1
            return ceil + 1
        e = e / 2
    result

// iq_isqrt — floor of the square root of n (n >= 0).
// Uses binary search: finds largest m such that m*m <= n.
fn iq_isqrt(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 1
    let lo = 1
    let hi = n
    // Upper bound: sqrt(n) <= n/2 for n >= 4; cap to avoid huge range
    if hi > n / 2 + 1
        hi = n / 2 + 1
    let result = 0
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        let sq = mid * mid
        if sq == n
            return mid
        if sq < n
            result = mid
            lo = mid + 1
        if sq > n
            hi = mid - 1
    result

// iq_icbrt — floor of the cube root of n (n >= 0).
// Uses binary search: finds largest m such that m*m*m <= n.
fn iq_icbrt(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 1
    let lo = 1
    let hi = n
    // Upper bound: cbrt(n) <= n for all n>=0; cap to n/2+1 for n>=8
    if hi > n / 2 + 1
        hi = n / 2 + 1
    let result = 0
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        let cube = mid * mid * mid
        if cube == n
            return mid
        if cube < n
            result = mid
            lo = mid + 1
        if cube > n
            hi = mid - 1
    result

// iq_nth_root — floor of the k-th root of n (n >= 0, k >= 1).
// Uses binary search: finds largest m such that m^k <= n.
// Uses _iq_pow_capped to guard against intermediate overflow.
fn iq_nth_root(n: int, k: int) -> int
    if k <= 0
        return -1
    if k == 1
        return n
    if n <= 0
        return 0
    if n == 1
        return 1
    let lo = 1
    let hi = n
    // Tighter upper bound: for k>=2, root <= sqrt(n) roughly; use n itself as safe cap
    let result = 0
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        let pw = _iq_pow_capped(mid, k, n)
        if pw == n
            return mid
        if pw < n
            result = mid
            lo = mid + 1
        if pw > n
            hi = mid - 1
    result

// iq_is_perfect_square — true iff n is a perfect square (n >= 0).
// Computes floor(sqrt(n)) and checks that its square equals n.
fn iq_is_perfect_square(n: int) -> bool
    if n < 0
        return false
    let m = iq_isqrt(n)
    m * m == n

// iq_is_perfect_power — true iff n == m^k for some integer m >= 2 and k >= 2.
// n == 0, 1 are excluded by definition (no m >= 2 satisfies them for useful powers).
// Tries each exponent k from 2 up to log2(n), binary-searching for m each time.
fn iq_is_perfect_power(n: int) -> bool
    if n < 4
        return false
    // Maximum possible exponent: 2^k <= n means k <= log2(n).
    // We iterate k = 2, 3, 4, ... until 2^k > n.
    let k = 2
    let two_k = 4
    while two_k <= n
        let m = iq_nth_root(n, k)
        // m must be >= 2 (definition requires base >= 2)
        if m >= 2
            let pw = _iq_pow_capped(m, k, n)
            if pw == n
                return true
        k = k + 1
        two_k = two_k * 2
    false
