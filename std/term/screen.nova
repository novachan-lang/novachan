// std/term/screen.nova — ANSI terminal screen/line clearing and scrolling.
//
// All functions return escape sequence strings built with chr(27) for ESC.
// CSI = chr(27) + "[".  No string interpolation (no { } in strings).
//
// API:
//   clear_screen()      -> str   ESC[2J  — erase entire display
//   clear_screen_home() -> str   ESC[2J + ESC[H — erase display then cursor home
//   clear_line()        -> str   ESC[2K  — erase entire current line
//   clear_to_eol()      -> str   ESC[0K  — erase from cursor to end of line
//   clear_to_eos()      -> str   ESC[0J  — erase from cursor to end of screen
//   scroll_up(n)        -> str   ESC[nS  — scroll up n lines (n>=1, clamped)
//   scroll_down(n)      -> str   ESC[nT  — scroll down n lines (n>=1, clamped)
//   alt_screen_on()     -> str   ESC[?1049h — enter alternate screen buffer
//   alt_screen_off()    -> str   ESC[?1049l — leave alternate screen buffer

// Internal: CSI prefix = ESC + "["
fn _csi() -> str
    let esc = chr(27)
    let result = esc + "["
    result

// Erase entire display (cursor position unchanged).
fn clear_screen() -> str
    let result = _csi() + "2J"
    result

// Erase entire display then move cursor to home (1,1).
fn clear_screen_home() -> str
    let esc = chr(27)
    let erase = _csi() + "2J"
    let home = esc + "[H"
    let result = erase + home
    result

// Erase entire current line (cursor column unchanged).
fn clear_line() -> str
    let result = _csi() + "2K"
    result

// Erase from cursor to end of current line.
fn clear_to_eol() -> str
    let result = _csi() + "0K"
    result

// Erase from cursor to end of screen.
fn clear_to_eos() -> str
    let result = _csi() + "0J"
    result

// Scroll display up by n lines (new lines appear at the bottom).
// n is clamped to at least 1.
fn scroll_up(n: int) -> str
    let count = 1 if n < 1 else n
    let result = _csi() + str(count) + "S"
    result

// Scroll display down by n lines (new lines appear at the top).
// n is clamped to at least 1.
fn scroll_down(n: int) -> str
    let count = 1 if n < 1 else n
    let result = _csi() + str(count) + "T"
    result

// Enter the alternate screen buffer (saves primary screen state).
fn alt_screen_on() -> str
    let result = _csi() + "?1049h"
    result

// Leave the alternate screen buffer (restores primary screen state).
fn alt_screen_off() -> str
    let result = _csi() + "?1049l"
    result
