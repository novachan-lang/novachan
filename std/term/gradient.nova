// ============================================================================
// NOVA Standard Library — std/term/gradient
// ============================================================================
// Per-character truecolor gradient and rainbow colouring.
//
// Each character is wrapped with ESC[38;2;r;g;bm (truecolor fg) and the
// whole result ends with ESC[0m (SGR reset).  Empty text returns "" (no
// bare escape codes emitted).
//
// ESCAPE SEQUENCE NOTES
//   ESC = chr(27).  Build sequences via concatenation — NEVER "\e"/"\x1b"
//   and NEVER literal { } in strings (triggers NOVA interpolation).
//
// PUBLIC API
//   gradient(text, r1,g1,b1, r2,g2,b2) -> str
//     Linear-interpolate truecolor fg from (r1,g1,b1) to (r2,g2,b2) across
//     all characters in text.  Each channel clamped 0..255.
//     Single character: uses the start colour.
//     Empty text: returns "" (documented choice — no orphan reset emitted).
//
//   rainbow(text) -> str
//     Cycles hue evenly across the characters (HSV: S=1, V=1).
//     Uses integer arithmetic throughout (no floats required).
//     Empty text: returns "".
//
// INTERNAL HELPERS (all _gr_ prefixed to avoid symbol collisions)

// ── private helpers ────────────────────────────────────────────────────────────

// Clamp v to [0, 255].
fn _gr_clamp(v: int) -> int
    let r = v
    if r < 0
        r = 0
    if r > 255
        r = 255
    r

// Build ESC[38;2;r;g;bm — truecolor foreground SGR.
fn _gr_fg(r: int, g: int, b: int) -> str
    let esc = chr(27)
    esc + "[38;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m"

// SGR reset: ESC[0m.
fn _gr_reset() -> str
    let esc = chr(27)
    esc + "[0m"

// Linear interpolate one channel from a to b.
//   step = 0..steps-1;  steps >= 1.
//   When steps==1 (single char), returns a (start colour).
fn _gr_lerp(a: int, b: int, step: int, steps: int) -> int
    let result = a
    if steps > 1
        // result = a + (b-a)*step/(steps-1)  — all integer, truncating
        let diff = b - a
        let num = diff * step
        let denom = steps - 1
        result = a + num / denom
    _gr_clamp(result)

// ── HSV integer helper for rainbow ─────────────────────────────────────────────
// Convert hue h (0..359) to RGB (0..255), S=1 V=1 HSV.
// Sector s = h/60; fraction f = (h mod 60)*255/60.
// Standard HSV sector map:
//   s=0: (255, f, 0)     s=1: (255-f, 255, 0)  s=2: (0, 255, f)
//   s=3: (0, 255-f, 255) s=4: (f, 0, 255)      s=5: (255, 0, 255-f)
// Returns packed int: r*1000000 + g*1000 + b.

fn _gr_hue_unpack_r(packed: int) -> int
    packed / 1000000

fn _gr_hue_unpack_g(packed: int) -> int
    (packed / 1000) - (packed / 1000000) * 1000

fn _gr_hue_unpack_b(packed: int) -> int
    packed - (packed / 1000) * 1000

fn _gr_hue_to_rgb(h: int) -> int
    let hh = h
    if hh < 0
        hh = 0
    if hh > 359
        hh = 359
    let sector = hh / 60
    let frac = (hh - sector * 60) * 255 / 60
    let rv = 0
    let gv = 0
    let bv = 0
    if sector == 0
        rv = 255
        gv = frac
        bv = 0
    if sector == 1
        rv = 255 - frac
        gv = 255
        bv = 0
    if sector == 2
        rv = 0
        gv = 255
        bv = frac
    if sector == 3
        rv = 0
        gv = 255 - frac
        bv = 255
    if sector == 4
        rv = frac
        gv = 0
        bv = 255
    if sector == 5
        rv = 255
        gv = 0
        bv = 255 - frac
    rv * 1000000 + gv * 1000 + bv

// ── public API ────────────────────────────────────────────────────────────────

// gradient(text, r1,g1,b1, r2,g2,b2) -> str
//   Applies a linear truecolor fg gradient across each character.
//   Empty text returns "".
fn gradient(text: str, r1: int, g1: int, b1: int, r2: int, g2: int, b2: int) -> str
    let n = len(text)
    if n == 0
        return ""
    let cr1 = _gr_clamp(r1)
    let cg1 = _gr_clamp(g1)
    let cb1 = _gr_clamp(b1)
    let cr2 = _gr_clamp(r2)
    let cg2 = _gr_clamp(g2)
    let cb2 = _gr_clamp(b2)
    let result = ""
    for i in 0..n
        let ch = slice(text, i, i + 1)
        let r = _gr_lerp(cr1, cr2, i, n)
        let g = _gr_lerp(cg1, cg2, i, n)
        let b = _gr_lerp(cb1, cb2, i, n)
        result = result + _gr_fg(r, g, b) + ch
    result + _gr_reset()

// rainbow(text) -> str
//   Cycles hue 0..359 evenly across characters (HSV S=1,V=1).
//   Empty text returns "".
fn rainbow(text: str) -> str
    let n = len(text)
    if n == 0
        return ""
    let result_parts = []
    for i in 0..n
        let ch = slice(text, i, i + 1)
        let hue = 0
        if n > 1
            hue = i * 360 / n
        let packed = _gr_hue_to_rgb(hue)
        let rv = _gr_hue_unpack_r(packed)
        let gv = _gr_hue_unpack_g(packed)
        let bv = _gr_hue_unpack_b(packed)
        push(result_parts, _gr_fg(rv, gv, bv) + ch)
    let result = join(result_parts, "")
    result + _gr_reset()
