// std/term/progress.nova — Progress bar and percentage rendering (pure strings).
//
// No ANSI escape sequences needed — outputs plain ASCII art strings.
// Suitable for embedding in terminal lines or combining with style sequences.
//
// PUBLIC API
//   bar(percent, width)                    -> "[####----]"  fill='#' empty='-'
//   bar_chars(percent, width, fill, empty) -> "[====....]"  custom chars
//   pct_str(done, total)                   -> "75%"  integer percent; div-by-zero guarded
//   gauge(value, max, width)               -> "[####----]"  like bar but from absolute values

// ── private helpers ────────────────────────────────────────────────────────────

// Clamp an int to [lo, hi].
fn _pg_clamp(v: int, lo: int, hi: int) -> int
    let result = v
    if v < lo
        result = lo
    if v > hi
        result = hi
    result

// Repeat a single-character string `ch` exactly `n` times (n >= 0).
fn _pg_repeat(ch: string, n: int) -> string
    let result = ""
    let i = 0
    while i < n
        result = result + ch
        i = i + 1
    result

// ── public API ─────────────────────────────────────────────────────────────────

// bar(percent, width) -> "[####----]"
//   percent: integer 0..100 (clamped).
//   width:   inner bar width in characters (clamped to >= 1).
//   fill_char = '#', empty_char = '-'.
fn bar(percent: int, width: int) -> string
    let result = bar_chars(percent, width, "#", "-")
    result

// bar_chars(percent, width, fill_char, empty_char) -> "[====....]"
//   percent: integer 0..100 (clamped).
//   width:   inner bar width (clamped to >= 1).
//   fill_char / empty_char: single-character strings.
fn bar_chars(percent: int, width: int, fill_char: string, empty_char: string) -> string
    let safe_pct = _pg_clamp(percent, 0, 100)
    let safe_w   = _pg_clamp(width, 1, 1000)
    // filled = floor(safe_pct * safe_w / 100)
    let filled = safe_pct * safe_w / 100
    let empty  = safe_w - filled
    let result = "[" + _pg_repeat(fill_char, filled) + _pg_repeat(empty_char, empty) + "]"
    result

// pct_str(done, total) -> "75%"
//   Returns integer (floor) percent string.  Guards against total==0 (returns "0%").
fn pct_str(done: int, total: int) -> string
    let result = "0%"
    if total > 0
        let p = done * 100 / total
        result = str(p) + "%"
    result

// gauge(value, max, width) -> "[####----]"
//   Like bar() but takes raw value + max.  Clamped: value in [0, max].
//   max <= 0 treated as empty bar (0%).
fn gauge(value: int, max: int, width: int) -> string
    let result = "[" + _pg_repeat("-", _pg_clamp(width, 1, 1000)) + "]"
    if max > 0
        let safe_v = _pg_clamp(value, 0, max)
        let pct    = safe_v * 100 / max
        result = bar(pct, width)
    result
