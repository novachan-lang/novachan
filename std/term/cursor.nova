// std/term/cursor.nova — ANSI cursor movement CSI sequences.
//
// All functions return the raw escape string (no side effects).
// The caller writes to stdout to apply the cursor movement.
//
// ESCAPE SEQUENCE NOTES
//   ESC = chr(27).  CSI = chr(27)+"[".
//   Sequences are built via string concatenation — NEVER literal { } (triggers
//   NOVA interpolation) and NEVER "\e" or "\x1b" (not supported).
//
// RANGE VALIDATION
//   n, row, col must be >= 1.  Values < 1 are clamped to 1.
//   cursor_col(c): c clamped to >= 1.
//
// PUBLIC API
//   cursor_up(n)         -> ESC[nA        move cursor up n rows
//   cursor_down(n)       -> ESC[nB        move cursor down n rows
//   cursor_fwd(n)        -> ESC[nC        move cursor right n columns
//   cursor_back(n)       -> ESC[nD        move cursor left n columns
//   cursor_goto(row,col) -> ESC[row;colH  move to absolute position (1-based)
//   cursor_col(c)        -> ESC[cG        move to column c (1-based) on current row
//   cursor_save()        -> ESC[s         save cursor position (ANSI/SCO)
//   cursor_restore()     -> ESC[u         restore cursor position (ANSI/SCO)
//   cursor_hide()        -> ESC[?25l      hide cursor
//   cursor_show()        -> ESC[?25h      show cursor

// ── private helpers ────────────────────────────────────────────────────────────

// Clamp an int to >= 1.
fn _cur_clamp1(v: int) -> int
    let result = 1 if v < 1 else v
    result

// Build CSI prefix.
fn _cur_csi() -> string
    let esc = chr(27)
    let result = esc + "["
    result

// ── public API ────────────────────────────────────────────────────────────────

// cursor_up(n) -> ESC[nA
fn cursor_up(n: int) -> string
    let safe_n = _cur_clamp1(n)
    let result = _cur_csi() + str(safe_n) + "A"
    result

// cursor_down(n) -> ESC[nB
fn cursor_down(n: int) -> string
    let safe_n = _cur_clamp1(n)
    let result = _cur_csi() + str(safe_n) + "B"
    result

// cursor_fwd(n) -> ESC[nC  (forward = right)
fn cursor_fwd(n: int) -> string
    let safe_n = _cur_clamp1(n)
    let result = _cur_csi() + str(safe_n) + "C"
    result

// cursor_back(n) -> ESC[nD  (back = left)
fn cursor_back(n: int) -> string
    let safe_n = _cur_clamp1(n)
    let result = _cur_csi() + str(safe_n) + "D"
    result

// cursor_goto(row, col) -> ESC[row;colH  (1-based absolute position)
fn cursor_goto(row: int, col: int) -> string
    let safe_row = _cur_clamp1(row)
    let safe_col = _cur_clamp1(col)
    let result = _cur_csi() + str(safe_row) + ";" + str(safe_col) + "H"
    result

// cursor_col(c) -> ESC[cG  (move to column c on current row, 1-based)
fn cursor_col(c: int) -> string
    let safe_c = _cur_clamp1(c)
    let result = _cur_csi() + str(safe_c) + "G"
    result

// cursor_save() -> ESC[s  (save cursor position, ANSI/SCO extension)
fn cursor_save() -> string
    let result = _cur_csi() + "s"
    result

// cursor_restore() -> ESC[u  (restore cursor position, ANSI/SCO extension)
fn cursor_restore() -> string
    let result = _cur_csi() + "u"
    result

// cursor_hide() -> ESC[?25l  (hide the cursor)
fn cursor_hide() -> string
    let result = _cur_csi() + "?25l"
    result

// cursor_show() -> ESC[?25h  (show the cursor)
fn cursor_show() -> string
    let result = _cur_csi() + "?25h"
    result
