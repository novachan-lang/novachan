// ============================================================================
// NOVA Standard Library — std/term/columns
// ============================================================================
// Align strings into padded columns. Pure strings — no escapes, no floats,
// no bytes. All functions validate inputs and handle empty cases safely.
//
// PUBLIC API
//   pad_cell(s, width, align) -> str
//     Pad (or truncate) s to exactly `width` visible characters.
//     align = "left"   — s flush-left,  trailing spaces
//     align = "right"  — s flush-right, leading  spaces
//     align = "center" — s centred; odd surplus space goes on the right
//     width <= 0 returns "". s longer than width is truncated to width.
//
//   columnize(items, ncols, colwidth) -> list
//     Distribute items row-by-row into ncols columns.
//     Each cell is padded to colwidth via pad_cell(..., "left").
//     Returns a list of row-strings (each row = ncols cells concatenated).
//     Trailing cells in the last row are filled with spaces.
//     Returns [] when items is empty, ncols < 1, or colwidth < 1.
//
//   table_simple(rows) -> list
//     rows = list of lists of cell strings (2-D table).
//     Auto-computes each column's width = max cell length in that column.
//     Returns a list of row-strings; cells in each row are separated by a
//     single space.  Cells are truncated if longer than the column width
//     (they set the width, so this only applies to rows that are shorter
//     than the widest row — short rows are padded with empty-string cells).
//     Returns [] when rows is empty.
// ============================================================================

// ── _spaces(n) ────────────────────────────────────────────────────────────────
// Build a string of exactly n spaces. Returns "" for n <= 0.
fn _spaces(n: int) -> str
    let out_parts = []
    for i in 0..n
        push(out_parts, " ")
    let out = join(out_parts, "")
    out

// ── pad_cell ──────────────────────────────────────────────────────────────────

// Pad or truncate s to exactly width characters.
// align: "left" | "right" | "center"   (any other value treated as "left")
// width <= 0 → ""
// len(s) > width → truncate to width
fn pad_cell(s: str, width: int, align: str) -> str
    if width <= 0
        return ""
    let slen = len(s)
    // Truncate if too long
    let src = s
    if slen > width
        src = slice(s, 0, width)
        slen = width
    let pad = width - slen
    if pad == 0
        return src
    if align == "right"
        return _spaces(pad) + src
    if align == "center"
        let left_pad = pad / 2
        let right_pad = pad - left_pad
        return _spaces(left_pad) + src + _spaces(right_pad)
    // Default: "left"
    src + _spaces(pad)

// ── columnize ─────────────────────────────────────────────────────────────────

// Lay items into a grid of ncols columns, each colwidth characters wide.
// Returns a list of row strings. Empty cells are padded with spaces.
fn columnize(items: list, ncols: int, colwidth: int) -> list
    let result = []
    let nitems = len(items)
    if nitems == 0
        return result
    if ncols < 1
        return result
    if colwidth < 1
        return result
    // Number of rows = ceil(nitems / ncols)
    let nrows = (nitems + ncols - 1) / ncols
    let row = 0
    while row < nrows
        let rowstr = ""
        for col in 0..ncols
            let idx = row * ncols + col
            let cell = ""
            if idx < nitems
                cell = items[idx]
            rowstr += pad_cell(cell, colwidth, "left")
        push(result, rowstr)
        row += 1
    result

// ── _col_count ────────────────────────────────────────────────────────────────
// Return the number of columns in a 2-D table (= max row length).
fn _col_count(rows: list) -> int
    let nrows = len(rows)
    let ncols = 0
    for i in 0..nrows
        let rlen = len(rows[i])
        if rlen > ncols
            ncols = rlen
    ncols

// ── _col_widths ───────────────────────────────────────────────────────────────
// Compute max cell width for each column index 0..ncols-1.
fn _col_widths(rows: list, ncols: int) -> list
    let widths = []
    let c = 0
    while c < ncols
        push(widths, 0)
        c += 1
    let nrows = len(rows)
    for r in 0..nrows
        let row = rows[r]
        let rlen = len(row)
        c = 0
        while c < ncols
            if c < rlen
                let cw = len(row[c])
                if cw > widths[c]
                    widths[c] = cw
            c += 1
    widths

// ── table_simple ──────────────────────────────────────────────────────────────

// Format a 2-D table with auto-width columns, single-space separator.
// rows: list of list of str.  Returns list of str (one per row).
fn table_simple(rows: list) -> list
    let result = []
    let nrows = len(rows)
    if nrows == 0
        return result
    let ncols = _col_count(rows)
    if ncols == 0
        return result
    let widths = _col_widths(rows, ncols)
    for r in 0..nrows
        let row = rows[r]
        let rlen = len(row)
        let rowstr = ""
        let c = 0
        while c < ncols
            let cell = ""
            if c < rlen
                cell = row[c]
            let w = widths[c]
            let padded = pad_cell(cell, w, "left")
            if c == 0
                rowstr = padded
            else
                rowstr += " " + padded
            c += 1
        push(result, rowstr)
    result
