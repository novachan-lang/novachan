// ============================================================================
// NOVA Standard Library — std/term/box
// ============================================================================
// Draw a text box with a border around a list of lines.
//
// Styles
//   "ascii"  — portable ASCII: corner=+, horizontal=-, vertical=|
//   "single" — Unicode light box-drawing (U+2500 family)
//   "double" — Unicode double-line box-drawing (U+2550 family)
//   "round"  — Unicode rounded corners, light sides
//
// Border characters by style:
//   style    tl   tr   bl   br   h    v
//   ascii    +    +    +    +    -    |
//   single   ┌    ┐    └    ┘    ─    │
//   double   ╔    ╗    ╚    ╝    ═    ║
//   round    ╭    ╮    ╰    ╯    ─    │
//
// Layout:
//   inner    = max content line length  (0 for empty lines list)
//   top row  = tl + h*(inner+2) + tr
//   body row = v + " " + line_right_padded_to_inner + " " + v
//   bot row  = bl + h*(inner+2) + br
//
// box_titled: title is embedded in the top border left-anchored:
//   top = tl + h + " " + title + " " + h*(inner+2 - len(title) - 3) + tr
//   title is clipped when len(title) > inner-1  (leaves room for one h + corners).
//
// hrule: standalone horizontal rule — h*width, no corners.
//
// Public API:
//   box(lines, style)              -> list  bordered output lines
//   box_titled(lines, title, style)-> list  box with title in top border
//   hrule(width, style)            -> string  horizontal rule of given width
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Repeat string ch exactly n times. Returns "" for n <= 0.
fn _box_repeat(ch, n) -> string
    let result = ""
    let i = 0
    while i < n
        result = result + ch
        i = i + 1
    result

// Find the maximum len() across all strings in a list.
// Returns 0 for an empty list.
fn _box_max_len(lines) -> int
    let mx = 0
    let i = 0
    let n = len(lines)
    while i < n
        let l = len(lines[i])
        if l > mx
            mx = l
        i = i + 1
    mx

// Pad string s with trailing spaces until len == width.
// If len(s) >= width, returns s unchanged.
fn _box_pad(s, width) -> string
    let need = width - len(s)
    let result = s + _box_repeat(" ", need)
    result

// Return six border chars for the given style as a list: [tl, tr, bl, br, h, v].
// Unknown styles fall back to ascii.
fn _box_chars(style) -> list
    let chars = []
    if style == "single"
        push(chars, "┌")
        push(chars, "┐")
        push(chars, "└")
        push(chars, "┘")
        push(chars, "─")
        push(chars, "│")
    else
        if style == "double"
            push(chars, "╔")
            push(chars, "╗")
            push(chars, "╚")
            push(chars, "╝")
            push(chars, "═")
            push(chars, "║")
        else
            if style == "round"
                push(chars, "╭")
                push(chars, "╮")
                push(chars, "╰")
                push(chars, "╯")
                push(chars, "─")
                push(chars, "│")
            else
                // ascii (default, and fallback for unknown styles)
                push(chars, "+")
                push(chars, "+")
                push(chars, "+")
                push(chars, "+")
                push(chars, "-")
                push(chars, "|")
    chars

// ── public API ───────────────────────────────────────────────────────────────

// box(lines, style) -> list of strings
//
// Returns a list of bordered text lines. Each content line is right-padded to
// the maximum content width. The returned list always has len(lines)+2 elements
// (top, all body rows, bottom).
//
// Empty lines list: returns 2 elements (top and bottom only).
//
// Examples (ascii style):
//   box(["hi"], "ascii")      -> ["+----+", "| hi |", "+----+"]
//   box(["ab","c"], "ascii")  -> ["+----+", "| ab |", "| c  |", "+----+"]
//   box([], "ascii")          -> ["+--+", "+--+"]
fn box(lines, style) -> list
    let chars = _box_chars(style)
    let tl = chars[0]
    let tr = chars[1]
    let bl = chars[2]
    let br = chars[3]
    let h  = chars[4]
    let v  = chars[5]
    let inner = _box_max_len(lines)
    let top = tl + _box_repeat(h, inner + 2) + tr
    let bot = bl + _box_repeat(h, inner + 2) + br
    let out = []
    push(out, top)
    let i = 0
    let n = len(lines)
    while i < n
        let padded = _box_pad(lines[i], inner)
        let row = v + " " + padded + " " + v
        push(out, row)
        i = i + 1
    push(out, bot)
    out

// box_titled(lines, title, style) -> list of strings
//
// Like box() but embeds the title into the top border, left-anchored:
//   top = tl + h + " " + title + " " + h*(fill) + tr
//   where fill = inner + 2 - len(title) - 3
//   (inner+2 total chars between corners; first char is h, then sp+title+sp,
//    then fill h-chars to reach the right corner).
//
// If len(title) > inner - 1, the title is clipped to inner - 1 characters
// so that fill >= 0 is always guaranteed.
//
// When title is empty, top reverts to tl + h*(inner+2) + tr (same as box()).
fn box_titled(lines, title, style) -> list
    let chars = _box_chars(style)
    let tl = chars[0]
    let tr = chars[1]
    let bl = chars[2]
    let br = chars[3]
    let h  = chars[4]
    let v  = chars[5]
    let inner = _box_max_len(lines)
    let span = inner + 2
    let real_title = title
    let max_title = span - 3
    if len(title) > max_title
        if max_title < 0
            real_title = ""
        else
            real_title = slice(title, 0, max_title)
    let fill = span - len(real_title) - 3
    let top = ""
    if len(real_title) == 0
        top = tl + _box_repeat(h, span) + tr
    else
        top = tl + h + " " + real_title + " " + _box_repeat(h, fill) + tr
    let bot = bl + _box_repeat(h, span) + br
    let out = []
    push(out, top)
    let i = 0
    let n = len(lines)
    while i < n
        let padded = _box_pad(lines[i], inner)
        let row = v + " " + padded + " " + v
        push(out, row)
        i = i + 1
    push(out, bot)
    out

// hrule(width, style) -> string
//
// Returns a standalone horizontal rule of exactly 'width' horizontal border
// characters (no corners). width is clamped to >= 0.
//
// Examples:
//   hrule(3, "ascii")  -> "---"
//   hrule(4, "single") -> "────"
//   hrule(0, "ascii")  -> ""
fn hrule(width, style) -> string
    let safe_w = width
    if width < 0
        safe_w = 0
    let chars = _box_chars(style)
    let h = chars[4]
    let result = _box_repeat(h, safe_w)
    result
