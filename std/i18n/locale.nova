// ============================================================================
// NOVA Standard Library — std/i18n/locale
// ============================================================================
// Minimal internationalization primitives: locale-aware number/currency
// formatting, nested-dict translation lookup, plural word selection, and
// text direction. Deliberately dependency-free (no ICU) — covers the common
// "format a number the way a user's locale expects" cases without pulling in
// a full CLDR implementation.
//
// Public API:
//   i18n_new(lang)                          -> dict locale
//   i18n_format_number(locale, n)           -> string
//   i18n_format_currency(locale, amount, symbol) -> string
//   i18n_translate(translations, lang, key) -> string
//   i18n_plural(n, singular, plural)        -> string
//   i18n_direction(lang)                    -> "ltr" | "rtl"
//
// Locale dict shape: {"lang": lang, "decimal_sep": ".", "thousand_sep": ",",
//                      "dir": "ltr"}
// ============================================================================

// i18n_direction: RTL script languages get "rtl", everything else "ltr".
fn i18n_direction(lang) -> string
    if lang == "ar" or lang == "he" or lang == "fa" or lang == "ur" or lang == "yi" or lang == "ps" or lang == "sd" or lang == "dv"
        return "rtl"
    "ltr"

// i18n_new: build a locale settings dict. Languages that conventionally use
// "." as the thousands grouping separator and "," as the decimal separator
// (most continental-European locales) get the "euro style" separators;
// everything else defaults to the "en" style ("," grouping, "." decimal).
fn i18n_new(lang) -> dict
    let loc = {}
    loc["lang"] = lang
    let euro_style = false
    if lang == "de" or lang == "fr" or lang == "es" or lang == "it" or lang == "pt" or lang == "ru" or lang == "pl" or lang == "nl"
        euro_style = true
    if euro_style
        loc["decimal_sep"] = ","
        loc["thousand_sep"] = "."
    else
        loc["decimal_sep"] = "."
        loc["thousand_sep"] = ","
    loc["dir"] = i18n_direction(lang)
    loc

// i18n_format_number: insert the locale's thousand separator every 3 digits
// from the right. Integer-valued formatting only (use i18n_format_currency
// for fractional amounts). Handles negative values.
fn i18n_format_number(locale, n) -> string
    let sep = locale["thousand_sep"]
    let neg = false
    let v = int(n)
    if v < 0
        neg = true
        v = 0 - v
    let s = str(v)
    let out_parts = []
    let len_s = len(s)
    for i in 0..len_s
        push(out_parts, slice(s, i, i + 1))
        let pos_from_right = len_s - i
        if pos_from_right > 1 and (pos_from_right - 1) % 3 == 0
            push(out_parts, sep)
    let out = join(out_parts, "")
    if neg
        out = "-" + out
    out

// i18n_format_currency: symbol-prefixed amount, grouped integer part, locale
// decimal separator, always 2 fractional digits. Rounds to the nearest cent
// (via integer-cents arithmetic so no float rounding artifacts leak into the
// output).
fn i18n_format_currency(locale, amount, symbol) -> string
    let af = amount * 1.0
    let neg = false
    if af < 0.0
        neg = true
        af = 0.0 - af
    let cents_total = round(af * 100.0)
    let whole = cents_total / 100
    let cents = cents_total % 100
    let whole_str = i18n_format_number(locale, whole)
    let cents_str = str(cents)
    if len(cents_str) < 2
        cents_str = "0" + cents_str
    let dec_sep = locale["decimal_sep"]
    let result = symbol + whole_str + dec_sep + cents_str
    if neg
        result = "-" + result
    result

// i18n_translate: look up translations[lang][key]; falls back to the raw key
// (never crashes on a missing lang or missing key — a missing translation
// showing the key itself is the standard "graceful degradation" behavior).
fn i18n_translate(translations, lang, key) -> string
    if lang not in translations
        return key
    let table = translations[lang]
    if key not in table
        return key
    table[key]

// i18n_plural: selects the grammatically correct word form for a count.
// English-style binary pluralization (n == 1 -> singular, else plural).
fn i18n_plural(n, singular, plural) -> string
    if n == 1
        return singular
    plural

// ============================================================================
fn main()
    print("std/i18n/locale loaded")
