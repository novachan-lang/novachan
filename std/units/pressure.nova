// std/units/pressure.nova — Pressure unit conversions (SI base: pascal).
// LEAF — imports NOTHING; all helpers are private (_pressure_ prefix).
//
// Supported unit codes (lowercase):
//   pa    pascal               (1.0 Pa)
//   kpa   kilopascal           (1000.0 Pa)
//   bar   bar                  (100000.0 Pa)
//   mbar  millibar             (100.0 Pa)
//   atm   standard atmosphere  (101325.0 Pa — exact, by NIST definition)
//   psi   pound-force/sq inch  (6894.757293 Pa)
//   mmhg  millimetre of Hg     (133.322387415 Pa  = torr)
//   inhg  inch of Hg           (3386.389 Pa — NIST 0°C conventional)
//   hpa   hectopascal          (100.0 Pa  = mbar alias)
//
// Unknown units return 0.0.
//
// Public API:
//   pressure_factor(unit)                      -> float  Pa per unit
//   pressure_to_base(value, unit)              -> float  unit -> Pa
//   pressure_from_base(value, unit)            -> float  Pa -> unit
//   pressure_convert(value, from_unit, to)     -> float  direct conversion
//   pressure_is_supported(unit)                -> int  (1=yes, 0=no)
//   pressure_units()                           -> list  of supported codes

// pressure_factor — returns Pa-per-unit factor; 0.0 for unknown units.
fn pressure_factor(unit: string) -> float
    let factors = {"pa": 1.0, "kpa": 1000.0, "bar": 100000.0, "mbar": 100.0, "atm": 101325.0, "psi": 6894.757293, "mmhg": 133.322387415, "inhg": 3386.389, "hpa": 100.0}
    let r = factors[unit] if unit in factors else 0.0
    r

// pressure_to_base — convert value in given unit to pascal.
fn pressure_to_base(value: float, unit: string) -> float
    let f = pressure_factor(unit)
    let result = value * f
    result

// pressure_from_base — convert pascal value to given unit.
fn pressure_from_base(value: float, unit: string) -> float
    let f = pressure_factor(unit)
    let result = 0.0
    if f > 0.0
        result = value / f
    result

// pressure_convert — convert value from one pressure unit to another.
fn pressure_convert(value: float, from_unit: string, to_unit: string) -> float
    let base = pressure_to_base(value, from_unit)
    let result = pressure_from_base(base, to_unit)
    result

// pressure_is_supported — returns 1 if unit code is recognised, 0 otherwise.
fn pressure_is_supported(unit: string) -> int
    let f = pressure_factor(unit)
    let ok = 1 if f > 0.0 else 0
    ok

// pressure_units — returns list of all supported unit codes.
fn pressure_units() -> list
    let us = ["pa", "kpa", "bar", "mbar", "atm", "psi", "mmhg", "inhg", "hpa"]
    us
