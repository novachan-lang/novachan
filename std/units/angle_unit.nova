// std/units/angle_unit.nova — Angle unit conversions. Base unit = radian (rad).
//
// Supported units (code -> radians):
//   rad    = 1.0
//   deg    = PI/180.0         = 0.0174532925199433
//   grad   = PI/200.0         = 0.0157079632679490
//   turn   = 2*PI             = 6.283185307179586
//   arcmin = PI/(180*60)      = 0.0002908882086657
//   arcsec = PI/(180*3600)    = 0.0000048481368111
//
// All conversions are pure scale factors (no trig), so no float-ABI risk.
// Unknown unit -> 0.0 (documented behavior).

// Return list of supported unit codes.
fn angle_unit_units() -> list
    ["rad", "deg", "grad", "turn", "arcmin", "arcsec"]

// Return factor: how many radians equals 1 of `unit`. Returns 0.0 for unknown.
// PI = 3.141592653589793; factors computed from exact definitions.
fn angle_unit_factor(unit: string) -> float
    let PI = 3.141592653589793
    let factors = {"rad": 1.0, "deg": PI / 180.0, "grad": PI / 200.0, "turn": PI * 2.0, "arcmin": PI / (180.0 * 60.0), "arcsec": PI / (180.0 * 3600.0)}
    let result = factors[unit] if unit in factors else 0.0
    result

// Return 1 if `unit` is in the supported set, 0 otherwise.
fn angle_unit_is_supported(unit: string) -> int
    let f = angle_unit_factor(unit)
    let result = 1 if f > 0.0 else 0
    result

// Convert `value` in `unit` to radians (the base unit).
fn angle_unit_to_base(value: float, unit: string) -> float
    let f = angle_unit_factor(unit)
    let r = value * f
    r

// Convert `value` radians to `unit`. Returns 0.0 if unit unknown.
fn angle_unit_from_base(value: float, unit: string) -> float
    let f = angle_unit_factor(unit)
    let result = 0.0
    if f > 0.0
        result = value / f
    result

// Convert `value` from `from_unit` to `to_unit`.
fn angle_unit_convert(value: float, from_unit: string, to_unit: string) -> float
    let base = angle_unit_to_base(value, from_unit)
    let result = angle_unit_from_base(base, to_unit)
    result

// Convenience: degrees to radians.
fn deg_to_rad(deg: float) -> float
    let PI = 3.141592653589793
    let f = PI / 180.0
    let r = deg * f
    r

// Convenience: radians to degrees.
fn rad_to_deg(rad: float) -> float
    let PI = 3.141592653589793
    let f = 180.0 / PI
    let r = rad * f
    r

// Convenience: degrees to gradians (1 deg = 10/9 grad).
fn deg_to_grad(deg: float) -> float
    let f = 10.0 / 9.0
    let r = deg * f
    r
