// std/units/speed.nova — Speed / velocity unit conversions (SI base: metre per second).
// LEAF — imports NOTHING; all helpers are private (_speed_ prefix).
//
// Supported unit codes (lowercase):
//   mps   metres per second    (1.0 m/s)
//   kmh   kilometres per hour  (0.2777777778 m/s  = 1000/3600)
//   mph   miles per hour       (0.44704 m/s)
//   fps   feet per second      (0.3048 m/s)
//   kn    knot                 (0.5144444444 m/s  = 1852/3600)
//   mach  Mach number (ISA sea level, 20°C, 343 m/s)
//
// Unknown units return 0.0.
//
// Public API:
//   speed_factor(unit)                    -> float  metres-per-second per unit
//   speed_to_base(value, unit)            -> float  unit -> m/s
//   speed_from_base(value, unit)          -> float  m/s -> unit
//   speed_convert(value, from_unit, to)   -> float  direct conversion
//   speed_is_supported(unit)              -> int  (1=yes, 0=no)
//   speed_units()                         -> list  of supported codes
//   mps_to_kmh(v)                         -> float  convenience
//   kmh_to_mph(v)                         -> float  convenience

// speed_factor — returns m/s per unit; 0.0 for unknown units.
fn speed_factor(unit: string) -> float
    let r = 0.0
    if unit == "mps"
        r = 1.0
    if unit == "kmh"
        // 1 km/h = 1000/3600 m/s = 0.2777777778
        let n = 1000.0
        let d = 3600.0
        r = n / d
    if unit == "mph"
        r = 0.44704
    if unit == "fps"
        r = 0.3048
    if unit == "kn"
        // 1 knot = 1852/3600 m/s = 0.5144444444
        let n = 1852.0
        let d = 3600.0
        r = n / d
    if unit == "mach"
        r = 343.0
    r

// speed_to_base — convert value in given unit to m/s.
fn speed_to_base(value: float, unit: string) -> float
    let f = speed_factor(unit)
    let result = value * f
    result

// speed_from_base — convert m/s value to given unit.
fn speed_from_base(value: float, unit: string) -> float
    let f = speed_factor(unit)
    let result = 0.0
    if f > 0.0
        result = value / f
    result

// speed_convert — convert value from one speed unit to another.
fn speed_convert(value: float, from_unit: string, to_unit: string) -> float
    let base = speed_to_base(value, from_unit)
    let result = speed_from_base(base, to_unit)
    result

// speed_is_supported — returns 1 if unit code is recognised, 0 otherwise.
fn speed_is_supported(unit: string) -> int
    let f = speed_factor(unit)
    let ok = 0
    if f > 0.0
        ok = 1
    ok

// speed_units — returns list of all supported unit codes.
fn speed_units() -> list
    let us = []
    push(us, "mps")
    push(us, "kmh")
    push(us, "mph")
    push(us, "fps")
    push(us, "kn")
    push(us, "mach")
    us

// mps_to_kmh — convenience: metres per second to kilometres per hour.
fn mps_to_kmh(v: float) -> float
    let d = 1000.0
    let n = 3600.0
    let factor = n / d
    let r = v * factor
    r

// kmh_to_mph — convenience: kilometres per hour to miles per hour.
fn kmh_to_mph(v: float) -> float
    // 1 km/h = 1/1.609344 mph  =>  factor = 1000/(1609.344) = 0.6213711922
    let r = speed_convert(v, "kmh", "mph")
    r
