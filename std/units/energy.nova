// std/units/energy.nova — Energy unit conversions (SI base: joule).
// LEAF — imports NOTHING; all helpers are private (_energy_ prefix).
//
// Supported unit codes (lowercase):
//   j     joule                (1.0 J)
//   kj    kilojoule            (1000.0 J)
//   mj    megajoule            (1000000.0 J)
//   cal   thermochemical cal   (4.184 J — NIST exact)
//   kcal  kilocalorie          (4184.0 J)
//   wh    watt-hour            (3600.0 J)
//   kwh   kilowatt-hour        (3600000.0 J)
//   btu   British thermal unit (1055.05585262 J — ISO 31-4)
//   ftlb  foot-pound-force     (1.3558179483 J)
//
// Unknown units return 0.0.
//
// Public API:
//   energy_factor(unit)                    -> float  J per unit
//   energy_to_base(value, unit)            -> float  unit -> J
//   energy_from_base(value, unit)          -> float  J -> unit
//   energy_convert(value, from_unit, to)   -> float  direct conversion
//   energy_is_supported(unit)              -> int  (1=yes, 0=no)
//   energy_units()                         -> list  of supported codes

// energy_factor — returns joules-per-unit factor; 0.0 for unknown units.
fn energy_factor(unit: string) -> float
    let r = 0.0
    if unit == "j"
        r = 1.0
    if unit == "kj"
        r = 1000.0
    if unit == "mj"
        r = 1000000.0
    if unit == "cal"
        r = 4.184
    if unit == "kcal"
        r = 4184.0
    if unit == "wh"
        r = 3600.0
    if unit == "kwh"
        r = 3600000.0
    if unit == "btu"
        r = 1055.05585262
    if unit == "ftlb"
        r = 1.3558179483
    r

// energy_to_base — convert value in given unit to joules.
fn energy_to_base(value: float, unit: string) -> float
    let f = energy_factor(unit)
    let result = value * f
    result

// energy_from_base — convert joule value to given unit.
fn energy_from_base(value: float, unit: string) -> float
    let f = energy_factor(unit)
    let result = 0.0
    if f > 0.0
        result = value / f
    result

// energy_convert — convert value from one energy unit to another.
fn energy_convert(value: float, from_unit: string, to_unit: string) -> float
    let base = energy_to_base(value, from_unit)
    let result = energy_from_base(base, to_unit)
    result

// energy_is_supported — returns 1 if unit code is recognised, 0 otherwise.
fn energy_is_supported(unit: string) -> int
    let f = energy_factor(unit)
    let ok = 0
    if f > 0.0
        ok = 1
    ok

// energy_units — returns list of all supported unit codes.
fn energy_units() -> list
    let us = []
    push(us, "j")
    push(us, "kj")
    push(us, "mj")
    push(us, "cal")
    push(us, "kcal")
    push(us, "wh")
    push(us, "kwh")
    push(us, "btu")
    push(us, "ftlb")
    us
