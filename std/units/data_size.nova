// std/units/data_size.nova — Digital data-size unit conversions. Base unit = byte (b).
//
// Decimal (SI) units (powers of 1000):
//   b    = 1.0
//   kb   = 1000.0
//   mb   = 1000000.0
//   gb   = 1000000000.0
//   tb   = 1000000000000.0
//
// Binary (IEC) units (powers of 1024):
//   kib  = 1024.0
//   mib  = 1048576.0          (1024*1024)
//   gib  = 1073741824.0       (1024^3)
//   tib  = 1099511627776.0    (1024^4)
//
// Bit:
//   bit  = 0.125              (1/8 byte)
//
// Unknown unit -> 0.0 (documented behavior).

// Return list of supported unit codes.
fn data_size_units() -> list
    let us = []
    push(us, "b")
    push(us, "kb")
    push(us, "mb")
    push(us, "gb")
    push(us, "tb")
    push(us, "kib")
    push(us, "mib")
    push(us, "gib")
    push(us, "tib")
    push(us, "bit")
    us

// Return factor: how many bytes equals 1 of `unit`. Returns 0.0 for unknown.
fn data_size_factor(unit: string) -> float
    let result = 0.0
    if unit == "b"
        result = 1.0
    if unit == "kb"
        result = 1000.0
    if unit == "mb"
        result = 1000000.0
    if unit == "gb"
        result = 1000000000.0
    if unit == "tb"
        result = 1000000000000.0
    if unit == "kib"
        result = 1024.0
    if unit == "mib"
        result = 1048576.0
    if unit == "gib"
        result = 1073741824.0
    if unit == "tib"
        result = 1099511627776.0
    if unit == "bit"
        result = 0.125
    result

// Return 1 if `unit` is in the supported set, 0 otherwise.
fn data_size_is_supported(unit: string) -> int
    let f = data_size_factor(unit)
    let result = 0
    if f > 0.0
        result = 1
    result

// Convert `value` in `unit` to bytes (the base unit).
fn data_size_to_base(value: float, unit: string) -> float
    let f = data_size_factor(unit)
    let r = value * f
    r

// Convert `value` bytes to `unit`. Returns 0.0 if unit unknown.
fn data_size_from_base(value: float, unit: string) -> float
    let f = data_size_factor(unit)
    let result = 0.0
    if f > 0.0
        result = value / f
    result

// Convert `value` from `from_unit` to `to_unit`.
fn data_size_convert(value: float, from_unit: string, to_unit: string) -> float
    let base = data_size_to_base(value, from_unit)
    let result = data_size_from_base(base, to_unit)
    result

// Convenience: kilobytes to bytes.
fn kb_to_b(kb: float) -> float
    let r = kb * 1000.0
    r

// Convenience: bytes to kilobytes.
fn b_to_kb(b: float) -> float
    let r = b / 1000.0
    r

// Convenience: kibibytes to bytes.
fn kib_to_b(kib: float) -> float
    let r = kib * 1024.0
    r

// Convenience: bytes to kibibytes.
fn b_to_kib(b: float) -> float
    let r = b / 1024.0
    r

// Convenience: mebibytes to kibibytes (= 1024).
fn mib_to_kib(mib: float) -> float
    let r = mib * 1024.0
    r

// Convenience: bytes to bits.
fn b_to_bit(b: float) -> float
    let r = b * 8.0
    r
