// ── gm_program ───────────────────────────────────────────────────────────────

// gm_program(name) -> int
//   Reverse lookup: return the program number (0..127) for the given
//   GM instrument name, or -1 if the name is not found.
fn gm_program(name)
    let result = -1
    if name == "Acoustic Grand Piano"
        result = 0
    else if name == "Bright Acoustic Piano"
        result = 1
    else if name == "Electric Grand Piano"
        result = 2
    else if name == "Honky-tonk Piano"
        result = 3
    else if name == "Electric Piano 1"
        result = 4
