// ── gm_drum ──────────────────────────────────────────────────────────────────

// gm_drum(note) -> string
//   Return the GM percussion name for note number 35..81 (channel 10).
//   Returns "Undefined" for out-of-range or unassigned notes.
fn gm_drum(note)
    let result = "Undefined"
    if note == 35
        result = "Acoustic Bass Drum"
    else if note == 36
        result = "Bass Drum 1"
    else if note == 37
        result = "Side Stick"
    else if note == 38
        result = "Acoustic Snare"
    else if note == 39
        result = "Hand Clap"
    else if note == 40
        result = "Electric Snare"
    else if note == 41
        result = "Low Floor Tom"
    else if note == 42
        result = "Closed Hi-Hat"
    else if note == 43
        result = "High Floor Tom"
    else if note == 44
        result = "Pedal Hi-Hat"
    else if note == 45
        result = "Low Tom"
    else if note == 46
        result = "Open Hi-Hat"
    else if note == 47
        result = "Low-Mid Tom"
    else if note == 48
        result = "Hi-Mid Tom"
    else if note == 49
        result = "Crash Cymbal 1"
    else if note == 50
        result = "High Tom"
    else if note == 51
        result = "Ride Cymbal 1"
    else if note == 52
        result = "Chinese Cymbal"
    else if note == 53
        result = "Ride Bell"
    else if note == 54
        result = "Tambourine"
    else if note == 55
        result = "Splash Cymbal"
    else if note == 56
        result = "Cowbell"
    else if note == 57
        result = "Crash Cymbal 2"
    else if note == 58
        result = "Vibraslap"
    else if note == 59
        result = "Ride Cymbal 2"
    else if note == 60
        result = "Hi Bongo"
    else if note == 61
        result = "Low Bongo"
    else if note == 62
        result = "Mute Hi Conga"
    else if note == 63
        result = "Open Hi Conga"
    else if note == 64
        result = "Low Conga"
    else if note == 65
        result = "High Timbale"
    else if note == 66
        result = "Low Timbale"
    else if note == 67
        result = "High Agogo"
    else if note == 68
        result = "Low Agogo"
    else if note == 69
        result = "Cabasa"
    else if note == 70
        result = "Maracas"
    else if note == 71
        result = "Short Whistle"
    else if note == 72
        result = "Long Whistle"
    else if note == 73
        result = "Short Guiro"
    else if note == 74
        result = "Long Guiro"
    else if note == 75
        result = "Claves"
    else if note == 76
        result = "Hi Wood Block"
    else if note == 77
        result = "Low Wood Block"
    else if note == 78
        result = "Mute Cuica"
    else if note == 79
        result = "Open Cuica"
    else if note == 80
        result = "Mute Triangle"
    else if note == 81
        result = "Open Triangle"
    result

// ── gm_family ────────────────────────────────────────────────────────────────

// gm_family(program) -> string
//   Return the instrument family name for program 0..127.
//   Families are groups of 8 programs: family_index = program / 8.
//   GM Level 1 defines 16 families (indices 0..15).
//   Returns "Undefined" for out-of-range values.
fn gm_family(program)
    let result = "Undefined"
    if program >= 0
        if program <= 127
            let fam = program / 8
            if fam == 0
                result = "Piano"
            else if fam == 1
                result = "Chromatic Perc"
            else if fam == 2
                result = "Organ"
            else if fam == 3
                result = "Guitar"
            else if fam == 4
                result = "Bass"
            else if fam == 5
                result = "Strings"
            else if fam == 6
                result = "Ensemble"
            else if fam == 7
                result = "Brass"
            else if fam == 8
                result = "Reed"
            else if fam == 9
                result = "Pipe"
            else if fam == 10
                result = "Synth Lead"
            else if fam == 11
                result = "Synth Pad"
            else if fam == 12
                result = "Synth Effects"
            else if fam == 13
                result = "Ethnic"
            else if fam == 14
                result = "Percussive"
            else if fam == 15
                result = "Sound Effects"
    result
