// ============================================================================
// NOVA Standard Library — std/midi/gm
// ============================================================================
// General MIDI (GM Level 1) instrument and drum name lookup.
//
// GM PROGRAM NUMBERS (0..127)
//   Programs are divided into 16 families of 8 instruments each.
//   Family index = program / 8 (integer division).
//   The 16 families: Piano, Chromatic Perc, Organ, Guitar, Bass,
//   Strings, Ensemble, Brass, Reed, Pipe, Synth Lead, Synth Pad,
//   Synth Effects, Ethnic, Percussive, Sound Effects.
//
// GM PERCUSSION (channel 10, note numbers 35..81)
//   Percussion is on MIDI channel 10 (0-indexed: 9). Note numbers
//   map directly to drum hit types, not pitches.
//
// PUBLIC API
//   gm_instrument(program) -> string
//     Return the GM instrument name for program 0..127.
//     Returns "Undefined" for out-of-range values.
//
//   gm_program(name) -> int
//     Return the program number for the given instrument name.
//     Returns -1 if the name is not a valid GM instrument name.
//
//   gm_drum(note) -> string
//     Return the GM percussion name for the given note number (35..81).
//     Returns "Undefined" for out-of-range or unmapped values.
//
//   gm_family(program) -> string
//     Return the instrument family name for program 0..127.
//     Returns "Undefined" for out-of-range values.
// ============================================================================

// ── gm_instrument ────────────────────────────────────────────────────────────

// gm_instrument(program) -> string
//   Return the GM Level 1 instrument name for the given program number (0..127).
//   Out-of-range values return "Undefined".
fn gm_instrument(program)
    let result = "Undefined"
    if program == 0
        result = "Acoustic Grand Piano"
    else if program == 1
        result = "Bright Acoustic Piano"
    else if program == 2
        result = "Electric Grand Piano"
    else if program == 3
        result = "Honky-tonk Piano"
    else if program == 4
        result = "Electric Piano 1"
    else if program == 5
        result = "Electric Piano 2"
    else if program == 6
        result = "Harpsichord"
