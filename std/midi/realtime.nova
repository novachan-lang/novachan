// ============================================================================
// NOVA Standard Library — std/midi/realtime
// ============================================================================
// MIDI System Real-Time and System Common message encoding.
//
// MIDI WIRE FORMAT — SYSTEM REAL-TIME (single byte, no data bytes)
//   Real-time messages may be interleaved in any MIDI data stream.
//   Each is a single status byte with the high bit set (0xF8..0xFF range).
//
//   Clock          0xF8  — 24 ppqn timing clock pulse
//   Start          0xFA  — start playback from beginning
//   Continue       0xFB  — resume playback at current position
//   Stop           0xFC  — stop playback
//   ActiveSensing  0xFE  — keep-alive (sent every ~300ms when idle)
//   Reset          0xFF  — reset all receivers to power-up state
//
// MIDI WIRE FORMAT — SYSTEM COMMON
//   MTC Quarter Frame  0xF1 + 1 data byte (message type & value, 0..127)
//   Song Position Ptr  0xF2 + lsb7 + msb7  (14-bit beat position, little-endian 7-bit)
//   Song Select        0xF3 + 1 data byte   (song number 0..127)
//   Tune Request       0xF6  (single byte, no data)
//
// SONG POSITION ENCODING (14-bit, 0..16383)
//   lsb7 = beats14 & 0x7F          (7 least-significant bits)
//   msb7 = (beats14 >> 7) & 0x7F   (7 most-significant bits)
//   wire: [0xF2, lsb7, msb7]
//
// VALIDATION
//   Data bytes clamped to 0..127 (high bit cleared).
//   beats14 clamped to 0..16383.
//
// PUBLIC API
//   rt_clock()            -> list  [0xF8]
//   rt_start()            -> list  [0xFA]
//   rt_stop()             -> list  [0xFC]
//   rt_continue()         -> list  [0xFB]
//   rt_active_sensing()   -> list  [0xFE]
//   rt_reset()            -> list  [0xFF]
//   mtc_quarter_frame(b)  -> list  [0xF1, b & 0x7F]
//   song_position(b14)    -> list  [0xF2, lsb7, msb7]
//   song_select(n)        -> list  [0xF3, n & 0x7F]
//   tune_request()        -> list  [0xF6]
//   is_realtime(byte)     -> bool  true if byte is a real-time status byte
// ============================================================================

// ── System Real-Time messages (single byte) ──────────────────────────────────

// rt_clock() -> list
//   MIDI Timing Clock. Sent 24 times per quarter note when syncing.
fn rt_clock()
    let msg = []
    push(msg, 0xF8)
    msg

// rt_start() -> list
//   Start playback from the beginning of the sequence.
fn rt_start()
    let msg = []
    push(msg, 0xFA)
    msg

// rt_stop() -> list
//   Stop playback.
fn rt_stop()
    let msg = []
    push(msg, 0xFC)
    msg

// rt_continue() -> list
//   Continue playback from the current position.
fn rt_continue()
    let msg = []
    push(msg, 0xFB)
    msg

// rt_active_sensing() -> list
//   Active Sensing keep-alive. Sent when no other MIDI data is flowing.
fn rt_active_sensing()
    let msg = []
    push(msg, 0xFE)
    msg

// rt_reset() -> list
//   Reset all receivers to power-up default state.
//   Note: 0xFF is also the SysEx Reset status; context determines usage.
fn rt_reset()
    let msg = []
    push(msg, 0xFF)
    msg

// ── System Common messages ────────────────────────────────────────────────────

// mtc_quarter_frame(b) -> list
//   MTC Quarter Frame message. b encodes message type (bits 6-4) and value
//   (bits 3-0). Clamped to 0..127 (data byte range).
fn mtc_quarter_frame(b)
    let data = b & 0x7F
    let msg = []
    push(msg, 0xF1)
    push(msg, data)
    msg

// song_position(beats14) -> list
//   Song Position Pointer. beats14 is the number of MIDI beats (sixteenth notes)
//   since the start of the song, 0..16383 (14-bit). Encoded as two 7-bit bytes,
//   LSB first (little-endian 7-bit).
fn song_position(beats14)
    let clamped = beats14
    if clamped < 0
        clamped = 0
    else if clamped > 16383
        clamped = 16383
    let lsb7 = clamped & 0x7F
    let msb7 = (clamped >> 7) & 0x7F
    let msg = []
    push(msg, 0xF2)
    push(msg, lsb7)
    push(msg, msb7)
    msg

// song_select(n) -> list
//   Song Select. n selects a song/sequence 0..127. Clamped to data byte range.
fn song_select(n)
    let data = n & 0x7F
    let msg = []
    push(msg, 0xF3)
    push(msg, data)
    msg

// tune_request() -> list
//   Tune Request. Analog synthesizers respond by tuning their oscillators.
fn tune_request()
    let msg = []
    push(msg, 0xF6)
    msg

// ── Query / classification ────────────────────────────────────────────────────

// is_realtime(byte) -> bool
//   Return true if byte is a MIDI System Real-Time status byte.
//   Real-time status bytes: 0xF8, 0xF9, 0xFA, 0xFB, 0xFC, 0xFD, 0xFE, 0xFF.
//   Per MIDI 1.0 spec, any byte in the range 0xF8..0xFF is a real-time message.
fn is_realtime(b)
    let result = 0
    if b >= 0xF8
        result = 1
    result == 1
