// ============================================================================
// NOVA Standard Library — std/midi/message
// ============================================================================
// Channel Voice Message encode/decode (MIDI 1.0 spec).
//
// MIDI WIRE FORMAT
//   Every channel voice message starts with a STATUS BYTE (high bit set):
//     status = (type_nibble << 4) | channel    (channel 0..15)
//   Followed by 1 or 2 DATA BYTES (high bit clear, values 0..127).
//
//   Message types (type_nibble values):
//     NoteOff      0x8  — status, note, velocity
//     NoteOn       0x9  — status, note, velocity
//     PolyAT       0xA  — status, note, pressure
//     CC           0xB  — status, controller, value
//     ProgramChg   0xC  — status, program          (1 data byte)
//     ChanAT       0xD  — status, pressure          (1 data byte)
//     PitchBend    0xE  — status, lsb7, msb7
//
// PITCH BEND ENCODING (14-bit, unsigned 0..16383, center=8192)
//   lsb7 = value & 0x7F           (least-significant 7 bits)
//   msb7 = (value >> 7) & 0x7F    (most-significant 7 bits)
//   wire: [status, lsb7, msb7]
//
// VALIDATION
//   Channel:    0..15
//   Data bytes: 0..127
//   Pitch bend: 0..16383
//   Out-of-range inputs are clamped to valid range (safe, not erroring).
//
// PUBLIC API
//   note_on(ch, note, vel)          -> list   [0x9c, note, vel]
//   note_off(ch, note, vel)         -> list   [0x8c, note, vel]
//   control_change(ch, ctrl, val)   -> list   [0xBc, ctrl, val]
//   program_change(ch, prog)        -> list   [0xCc, prog]
//   pitch_bend(ch, value14)         -> list   [0xEc, lsb7, msb7]
//   poly_aftertouch(ch, note, val)  -> list   [0xAc, note, val]
//   channel_aftertouch(ch, val)     -> list   [0xDc, val]
//   msg_decode(bytes_list)          -> dict   {type, channel, ...data}
//
// SYMBOL PREFIX: _midi_msg_ for all private helpers.
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Clamp v to [lo..hi].
fn _midi_msg_clamp(v, lo, hi) -> int
    let out = v
    if v < lo
        out = lo
    if v > hi
        out = hi
    out

// Build status byte: type_nibble (4-bit) | channel (clamped 0..15).
fn _midi_msg_status(type_nibble, ch) -> int
    let c = _midi_msg_clamp(ch, 0, 15)
    ((type_nibble & 0xF) << 4) | c

// Clamp a MIDI data byte to 0..127.
fn _midi_msg_data(v) -> int
    _midi_msg_clamp(v, 0, 127)

// ── encode functions ─────────────────────────────────────────────────────────

// note_on(ch, note, vel) -> [0x9c, note, vel]
fn note_on(ch, note, vel) -> list
    let msg = []
    push(msg, _midi_msg_status(9, ch))
    push(msg, _midi_msg_data(note))
    push(msg, _midi_msg_data(vel))
    msg

// note_off(ch, note, vel) -> [0x8c, note, vel]
fn note_off(ch, note, vel) -> list
    let msg = []
    push(msg, _midi_msg_status(8, ch))
    push(msg, _midi_msg_data(note))
    push(msg, _midi_msg_data(vel))
    msg

// control_change(ch, ctrl, val) -> [0xBc, ctrl, val]
fn control_change(ch, ctrl, val) -> list
    let msg = []
    push(msg, _midi_msg_status(11, ch))
    push(msg, _midi_msg_data(ctrl))
    push(msg, _midi_msg_data(val))
    msg

// program_change(ch, prog) -> [0xCc, prog]
fn program_change(ch, prog) -> list
    let msg = []
    push(msg, _midi_msg_status(12, ch))
    push(msg, _midi_msg_data(prog))
    msg

// pitch_bend(ch, value14) -> [0xEc, lsb7, msb7]
// value14: 0..16383, center=8192.
// lsb7 = value14 & 0x7F; msb7 = (value14 >> 7) & 0x7F
fn pitch_bend(ch, value14) -> list
    let v = _midi_msg_clamp(value14, 0, 16383)
    let lsb7 = v & 0x7F
    let msb7 = (v >> 7) & 0x7F
    let msg = []
    push(msg, _midi_msg_status(14, ch))
    push(msg, lsb7)
    push(msg, msb7)
    msg

// poly_aftertouch(ch, note, val) -> [0xAc, note, val]
fn poly_aftertouch(ch, note, val) -> list
    let msg = []
    push(msg, _midi_msg_status(10, ch))
    push(msg, _midi_msg_data(note))
    push(msg, _midi_msg_data(val))
    msg

// channel_aftertouch(ch, val) -> [0xDc, val]
fn channel_aftertouch(ch, val) -> list
    let msg = []
    push(msg, _midi_msg_status(13, ch))
    push(msg, _midi_msg_data(val))
    msg

// ── decode ───────────────────────────────────────────────────────────────────

// msg_decode(bytes_list) -> dict
// Returns dict with keys: "type" (string), "channel" (int), plus message-type
// specific keys. Returns {"type":"unknown","channel":0} for unrecognised input.
//
// Keys per type:
//   note_on/note_off:   "note", "velocity"
//   poly_aftertouch:    "note", "pressure"
//   control_change:     "controller", "value"
//   program_change:     "program"
//   channel_aftertouch: "pressure"
//   pitch_bend:         "value"  (reconstructed 14-bit, 0..16383)
fn msg_decode(bytes_list) -> dict
    let n = len(bytes_list)
    let result = {}
    if n < 1
        result["type"] = "unknown"
        result["channel"] = 0
        return result
    let sb = bytes_list[0]
    // Status byte must have high bit set.
    if sb < 128
        result["type"] = "unknown"
        result["channel"] = 0
        return result
    let type_nibble = (sb >> 4) & 0xF
    let ch = sb & 0xF
    result["channel"] = ch
    // NoteOff 0x8
    if type_nibble == 8
        result["type"] = "note_off"
        let note = 0
        let vel = 0
        if n > 1
            note = bytes_list[1]
        if n > 2
            vel = bytes_list[2]
        result["note"] = note
        result["velocity"] = vel
        return result
    // NoteOn 0x9
    if type_nibble == 9
        result["type"] = "note_on"
        let note = 0
        let vel = 0
        if n > 1
            note = bytes_list[1]
        if n > 2
            vel = bytes_list[2]
        result["note"] = note
        result["velocity"] = vel
        return result
    // PolyAT 0xA
    if type_nibble == 10
        result["type"] = "poly_aftertouch"
        let note = 0
        let pressure = 0
        if n > 1
            note = bytes_list[1]
        if n > 2
            pressure = bytes_list[2]
        result["note"] = note
        result["pressure"] = pressure
        return result
    // CC 0xB
    if type_nibble == 11
        result["type"] = "control_change"
        let ctrl = 0
        let val = 0
        if n > 1
            ctrl = bytes_list[1]
        if n > 2
            val = bytes_list[2]
        result["controller"] = ctrl
        result["value"] = val
        return result
    // ProgramChange 0xC
    if type_nibble == 12
        result["type"] = "program_change"
        let prog = 0
        if n > 1
            prog = bytes_list[1]
        result["program"] = prog
        return result
    // ChanAT 0xD
    if type_nibble == 13
        result["type"] = "channel_aftertouch"
        let pressure = 0
        if n > 1
            pressure = bytes_list[1]
        result["pressure"] = pressure
        return result
    // PitchBend 0xE
    if type_nibble == 14
        result["type"] = "pitch_bend"
        let lsb7 = 0
        let msb7 = 0
        if n > 1
            lsb7 = bytes_list[1] & 0x7F
        if n > 2
            msb7 = bytes_list[2] & 0x7F
        result["value"] = lsb7 | (msb7 << 7)
        return result
    // Unknown / System messages
    result["type"] = "unknown"
    return result
