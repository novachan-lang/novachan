// std/geometry3d/cg3_barycentric3.nova — Tetrahedral point-in-tetrahedron tests (exact integer).
//
// A 3D point is a 3-element integer list [x, y, z].
// All arithmetic is EXACT INTEGER — no floats, no division, no sqrt.
// Strategy: sign of scalar triple product (b-a).((c-a)x(d-a)) = 6*signed volume.
// pt is inside tetrahedron abcd iff the four sub-tetrahedra formed by replacing
// each vertex with pt all have the same orientation sign as the whole, allowing
// zero for points on the boundary faces/edges/vertices.
// Degenerate (coplanar) tetrahedra: orient returns 0; pt is never strictly inside.
// LEAF — imports NOTHING.

// _cgb3_cross: cross product u x v.
fn _cgb3_cross(u: list, v: list) -> list
    let r = [u[1]*v[2]-u[2]*v[1], u[2]*v[0]-u[0]*v[2], u[0]*v[1]-u[1]*v[0]]
    r

// _cgb3_sub: vector b - a.
fn _cgb3_sub(a: list, b: list) -> list
    let r = [b[0]-a[0], b[1]-a[1], b[2]-a[2]]
    r

// _cgb3_dot: dot product u . v.
fn _cgb3_dot(u: list, v: list) -> int
    u[0]*v[0] + u[1]*v[1] + u[2]*v[2]

// _cgb3_orient: signed scalar triple product (b-a) . ((c-a) x (d-a)).
// Equals 6 * signed volume of tetrahedron abcd.
// Positive = positive orientation, zero = degenerate (coplanar), negative = reversed.
fn _cgb3_orient(a: list, b: list, c: list, d: list) -> int
    let ba = _cgb3_sub(a, b)
    let ca = _cgb3_sub(a, c)
    let da = _cgb3_sub(a, d)
    let cx = _cgb3_cross(ca, da)
    _cgb3_dot(ba, cx)

// _cgb3_sign: sign of an integer (-1, 0, or 1).
fn _cgb3_sign(v: int) -> int
    1 if v > 0 else (-1 if v < 0 else 0)

// cgb3_in_tetrahedron: true iff pt is inside or on the boundary of tetrahedron abcd.
// Uses the four sub-tetrahedra method: pt is inside iff orient(pt,b,c,d),
// orient(a,pt,c,d), orient(a,b,pt,d), orient(a,b,c,pt) all have the same sign
// as orient(a,b,c,d), where zero is treated as "same" (boundary).
// Degenerate tetrahedra always return false.
fn cgb3_in_tetrahedron(a: list, b: list, c: list, d: list, pt: list) -> bool
    let s0 = _cgb3_orient(a, b, c, d)
    if s0 == 0
        return false
    let s1 = _cgb3_orient(pt, b, c, d)
    let s2 = _cgb3_orient(a, pt, c, d)
    let s3 = _cgb3_orient(a, b, pt, d)
    let s4 = _cgb3_orient(a, b, c, pt)
    if s0 > 0
        if s1 < 0
            return false
        if s2 < 0
            return false
        if s3 < 0
            return false
        if s4 < 0
            return false
        return true
    if s1 > 0
        return false
    if s2 > 0
        return false
    if s3 > 0
        return false
    if s4 > 0
        return false
    true

// cgb3_strictly_inside: true iff pt is strictly inside tetrahedron abcd (not on any face/edge/vertex).
// All four sub-tetra orientations must have the same NON-ZERO sign as the whole.
fn cgb3_strictly_inside(a: list, b: list, c: list, d: list, pt: list) -> bool
    let s0 = _cgb3_orient(a, b, c, d)
    if s0 == 0
        return false
    let s1 = _cgb3_orient(pt, b, c, d)
    let s2 = _cgb3_orient(a, pt, c, d)
    let s3 = _cgb3_orient(a, b, pt, d)
    let s4 = _cgb3_orient(a, b, c, pt)
    if s0 > 0
        if s1 <= 0
            return false
        if s2 <= 0
            return false
        if s3 <= 0
            return false
        if s4 <= 0
            return false
        return true
    if s1 >= 0
        return false
    if s2 >= 0
        return false
    if s3 >= 0
        return false
    if s4 >= 0
        return false
    true

// cgb3_on_boundary: true iff pt is on the boundary of tetrahedron abcd (face/edge/vertex)
// but not in the exterior. Boundary = in_tetrahedron AND at least one sub-orient is zero.
fn cgb3_on_boundary(a: list, b: list, c: list, d: list, pt: list) -> bool
    if not cgb3_in_tetrahedron(a, b, c, d, pt)
        return false
    let s1 = _cgb3_orient(pt, b, c, d)
    let s2 = _cgb3_orient(a, pt, c, d)
    let s3 = _cgb3_orient(a, b, pt, d)
    let s4 = _cgb3_orient(a, b, c, pt)
    s1 == 0 or s2 == 0 or s3 == 0 or s4 == 0
