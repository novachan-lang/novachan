// std/geometry3d/cg3_lattice3.nova — 3D integer lattice geometry (exact integer arithmetic).
//
// Points are 3-element integer lists [x,y,z].
// All arithmetic is EXACT INTEGER — no floats, no approximation.
//
// Public API (prefix cgll3_):
//   cgll3_gcd3(a, b, c)                      -> int   GCD of three non-negative integers
//   cgll3_collinear(a, b, c)                  -> bool  true iff a,b,c are collinear
//   cgll3_coplanar4(a, b, c, d)               -> bool  true iff a,b,c,d are coplanar
//   cgll3_segment_lattice_points(a, b)        -> int   lattice points strictly between a and b
//
// LEAF — imports NOTHING.

// _cgll3_gcd2: Euclidean GCD of two non-negative integers.
fn _cgll3_gcd2(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = y
        y = x - (x / y) * y
        x = t
    x

// _cgll3_iabs: absolute value of an integer.
fn _cgll3_iabs(x: int) -> int
    let r = x
    if x < 0
        r = 0 - x
    r

// cgll3_gcd3: GCD of three non-negative integers a, b, c.
// Uses gcd(a, gcd(b, c)).  cgll3_gcd3(0,0,0) = 0 by convention.
fn cgll3_gcd3(a: int, b: int, c: int) -> int
    _cgll3_gcd2(a, _cgll3_gcd2(b, c))

// cgll3_collinear: true iff 3D points a, b, c are collinear.
// Three points are collinear iff the cross product (b-a) x (c-a) is the zero vector.
// cross = [u1,u2,u3] where u = b-a, v = c-a:
//   cross[0] = u[1]*v[2] - u[2]*v[1]
//   cross[1] = u[2]*v[0] - u[0]*v[2]
//   cross[2] = u[0]*v[1] - u[1]*v[0]
fn cgll3_collinear(a: list, b: list, c: list) -> bool
    let ux = b[0] - a[0]
    let uy = b[1] - a[1]
    let uz = b[2] - a[2]
    let vx = c[0] - a[0]
    let vy = c[1] - a[1]
    let vz = c[2] - a[2]
    let cx = uy * vz - uz * vy
    let cy = uz * vx - ux * vz
    let cz = ux * vy - uy * vx
    cx == 0 and cy == 0 and cz == 0

// cgll3_coplanar4: true iff 4 points a, b, c, d lie in the same plane.
// Uses the scalar triple product: (b-a) . ((c-a) x (d-a)) == 0.
// This is the 3x3 determinant of [b-a, c-a, d-a], which is 6 * signed volume of the tetrahedron.
fn cgll3_coplanar4(a: list, b: list, c: list, d: list) -> bool
    let bax = b[0] - a[0]
    let bay = b[1] - a[1]
    let baz = b[2] - a[2]
    let cax = c[0] - a[0]
    let cay = c[1] - a[1]
    let caz = c[2] - a[2]
    let dax = d[0] - a[0]
    let day = d[1] - a[1]
    let daz = d[2] - a[2]
    let crx = cay * daz - caz * day
    let cry = caz * dax - cax * daz
    let crz = cax * day - cay * dax
    let triple = bax * crx + bay * cry + baz * crz
    triple == 0

// cgll3_segment_lattice_points: number of lattice points strictly between a and b.
// Formula: gcd(|dx|, |dy|, |dz|) - 1, where dx=b[0]-a[0] etc.
// If a == b, gcd(0,0,0) = 0, so result = 0 - 1 = -1; we clamp to 0.
fn cgll3_segment_lattice_points(a: list, b: list) -> int
    let dx = _cgll3_iabs(b[0] - a[0])
    let dy = _cgll3_iabs(b[1] - a[1])
    let dz = _cgll3_iabs(b[2] - a[2])
    let g = cgll3_gcd3(dx, dy, dz)
    let result = g - 1
    if result < 0
        result = 0
    result
