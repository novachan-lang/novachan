// std/geometry3d/cg3_orientation.nova — 3D tetrahedron orientation (exact integer arithmetic).
//
// A 3D point/vector is a 3-element integer list [x, y, z].
// All results are EXACT — no floats, no rounding.
// Degenerate inputs (coplanar points) return 0 / true as appropriate.
// LEAF — imports NOTHING.

// _cgo3_cross: internal cross product of integer 3-vectors a x b.
// Returns [a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]].
fn _cgo3_cross(a: list, b: list) -> list
    let a0 = a[0]
    let a1 = a[1]
    let a2 = a[2]
    let b0 = b[0]
    let b1 = b[1]
    let b2 = b[2]
    let cx = a1 * b2 - a2 * b1
    let cy = a2 * b0 - a0 * b2
    let cz = a0 * b1 - a1 * b0
    let result = [cx, cy, cz]
    result

// _cgo3_dot: internal dot product of integer 3-vectors a . b.
fn _cgo3_dot(a: list, b: list) -> int
    let a0 = a[0]
    let a1 = a[1]
    let a2 = a[2]
    let b0 = b[0]
    let b1 = b[1]
    let b2 = b[2]
    let d = a0 * b0 + a1 * b1 + a2 * b2
    d

// _cgo3_sub: internal component-wise subtraction a - b.
fn _cgo3_sub(a: list, b: list) -> list
    let a0 = a[0]
    let a1 = a[1]
    let a2 = a[2]
    let b0 = b[0]
    let b1 = b[1]
    let b2 = b[2]
    let result = [a0 - b0, a1 - b1, a2 - b2]
    result

// cgo3_triple: scalar triple product a . (b x c).
// Equals the signed volume of the parallelepiped spanned by a, b, c.
fn cgo3_triple(a: list, b: list, c: list) -> int
    let bxc = _cgo3_cross(b, c)
    let t = _cgo3_dot(a, bxc)
    t

// cgo3_orient: sign of the signed volume of tetrahedron (a, b, c, d).
// Computes sign of (b-a) . ((c-a) x (d-a)).
// Returns 1 if positive orientation (d above plane abc in CCW sense),
//        -1 if negative orientation,
//         0 if a, b, c, d are coplanar.
fn cgo3_orient(a: list, b: list, c: list, d: list) -> int
    let ab = _cgo3_sub(b, a)
    let ac = _cgo3_sub(c, a)
    let ad = _cgo3_sub(d, a)
    let acxad = _cgo3_cross(ac, ad)
    let vol = _cgo3_dot(ab, acxad)
    1 if vol > 0 else (-1 if vol < 0 else 0)

// cgo3_coplanar: true iff points a, b, c, d are coplanar (orient == 0).
fn cgo3_coplanar(a: list, b: list, c: list, d: list) -> bool
    let s = cgo3_orient(a, b, c, d)
    s == 0
