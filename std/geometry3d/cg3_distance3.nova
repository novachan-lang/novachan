// std/geometry3d/cg3_distance3.nova — Exact-integer squared distances in 3D.
//
// Points are 3-element integer lists [x,y,z].  A plane is [nx,ny,nz,d] where
// the plane equation is nx*x + ny*y + nz*z + d = 0.
// ALL results are EXACT — no floats, no sqrt.
//
// Public API (prefix cgd3_):
//   cgd3_point_point_sq(a, b)       -> int       squared Euclidean distance |a-b|^2
//   cgd3_point_segment_sq(pt, a, b) -> list      [num,den] squared dist to SEGMENT ab
//   cgd3_point_plane_sq(pt, plane)  -> list      [num,den] squared dist to plane
//
// Degenerate cases:
//   segment a==b : distance to the point a.
//   plane normal (0,0,0): returns [0,1] (undefined plane, treat as zero distance).
//
// LEAF — imports NOTHING.

// _cgd3_gcd: Euclidean GCD of two non-negative integers.
fn _cgd3_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = y
        y = x - (x / y) * y
        x = t
    x

// _cgd3_reduce: reduce rational [num, den] by GCD.  den always positive; num >= 0.
fn _cgd3_reduce(num: int, den: int) -> list
    let result = []
    if num == 0
        push(result, 0)
        push(result, 1)
    else
        let g = _cgd3_gcd(num, den)
        push(result, num / g)
        push(result, den / g)
    result

// cgd3_point_point_sq: squared Euclidean distance between two 3D integer points a and b.
// Returns (a[0]-b[0])^2 + (a[1]-b[1])^2 + (a[2]-b[2])^2 as an int.
fn cgd3_point_point_sq(a: list, b: list) -> int
    let dx = a[0] - b[0]
    let dy = a[1] - b[1]
    let dz = a[2] - b[2]
    dx * dx + dy * dy + dz * dz

// cgd3_point_segment_sq: squared distance from pt to the SEGMENT [a,b], clamped to endpoints.
//
// Let AB = b-a, AP = pt-a.
// t_num = dot(AP, AB),  t_den = dot(AB, AB) = |AB|^2.
// If t_den == 0 (a==b degenerate): return squared dist to a.
// If t_num <= 0: nearest point is a.
// If t_num >= t_den: nearest point is b.
// Otherwise (interior): dist^2 = |AP|^2 - t_num^2 / t_den
//   = (|AP|^2 * t_den - t_num^2) / t_den  — always >= 0 by Cauchy-Schwarz.
// Returns [num, den] reduced by GCD.
fn cgd3_point_segment_sq(pt: list, a: list, b: list) -> list
    let abx = b[0] - a[0]
    let aby = b[1] - a[1]
    let abz = b[2] - a[2]
    let apx = pt[0] - a[0]
    let apy = pt[1] - a[1]
    let apz = pt[2] - a[2]
    let t_den = abx * abx + aby * aby + abz * abz
    let result = []
    if t_den == 0
        let dsq = apx * apx + apy * apy + apz * apz
        push(result, dsq)
        push(result, 1)
    else
        let t_num = apx * abx + apy * aby + apz * abz
        if t_num <= 0
            let dsq = apx * apx + apy * apy + apz * apz
            push(result, dsq)
            push(result, 1)
        else if t_num >= t_den
            let bpx = pt[0] - b[0]
            let bpy = pt[1] - b[1]
            let bpz = pt[2] - b[2]
            let dsq = bpx * bpx + bpy * bpy + bpz * bpz
            push(result, dsq)
            push(result, 1)
        else
            let ap_sq = apx * apx + apy * apy + apz * apz
            let num = ap_sq * t_den - t_num * t_num
            let den = t_den
            let r = _cgd3_reduce(num, den)
            push(result, r[0])
            push(result, r[1])
    result

// cgd3_point_plane_sq: squared distance from pt to the plane [nx,ny,nz,d].
//
// Plane equation: nx*x + ny*y + nz*z + d = 0.
// dist^2 = (nx*px + ny*py + nz*pz + d)^2 / (nx^2 + ny^2 + nz^2).
// Returns [num, den] reduced by GCD.
// Degenerate (zero normal): returns [0, 1].
fn cgd3_point_plane_sq(pt: list, plane: list) -> list
    let nx = plane[0]
    let ny = plane[1]
    let nz = plane[2]
    let d = plane[3]
    let norm_sq = nx * nx + ny * ny + nz * nz
    let result = []
    if norm_sq == 0
        push(result, 0)
        push(result, 1)
    else
        let dot_plus_d = nx * pt[0] + ny * pt[1] + nz * pt[2] + d
        let num = dot_plus_d * dot_plus_d
        let den = norm_sq
        let r = _cgd3_reduce(num, den)
        push(result, r[0])
        push(result, r[1])
    result
