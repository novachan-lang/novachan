// std/geometry3d/cg3_convex3.nova — Convex polyhedron half-space membership tests (exact integer).
//
// A convex polyhedron is represented as a list of half-space planes.
// Each plane is a 4-element integer list [nx, ny, nz, d].
// A point pt = [x,y,z] is INSIDE half-space [nx,ny,nz,d] iff:
//   nx*x + ny*y + nz*z + d <= 0
// (i.e. the inward-normal convention: the feasible side is where the value is <= 0).
// A point is ON the boundary of a half-space iff the value equals 0.
//
// Public API (prefix cgc3_):
//   cgc3_in_halfspaces(planes, pt)    -> bool   true iff pt satisfies ALL half-spaces
//   cgc3_count_inside(planes, points) -> int    number of points in points[] inside all half-spaces
//   cgc3_on_boundary(planes, pt)      -> bool   inside all AND on at least one boundary face
//
// LEAF — imports NOTHING.

// _cgc3_eval: evaluate nx*x + ny*y + nz*z + d for plane and point.
fn _cgc3_eval(plane: list, pt: list) -> int
    plane[0] * pt[0] + plane[1] * pt[1] + plane[2] * pt[2] + plane[3]

// cgc3_in_halfspaces: true iff pt is inside (or on the boundary of) all half-spaces.
// The point is inside half-space i iff _cgc3_eval(planes[i], pt) <= 0.
fn cgc3_in_halfspaces(planes: list, pt: list) -> bool
    let n = len(planes)
    for i in 0..n
        if _cgc3_eval(planes[i], pt) > 0
            return false
    return true

// cgc3_count_inside: count how many points in points[] are inside all half-spaces.
fn cgc3_count_inside(planes: list, points: list) -> int
    let np = len(points)
    let count = 0
    for i in 0..np
        if cgc3_in_halfspaces(planes, points[i])
            count += 1
    count

// cgc3_on_boundary: true iff pt is inside all half-spaces AND on at least one face.
// "On a face" means _cgc3_eval(plane, pt) == 0 for that plane.
fn cgc3_on_boundary(planes: list, pt: list) -> bool
    let n = len(planes)
    let on_face = false
    for i in 0..n
        let v = _cgc3_eval(planes[i], pt)
        if v > 0
            return false
        if v == 0
            on_face = true
    on_face
