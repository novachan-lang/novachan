// std/geometry3d/cg3_line3.nova — 3-D infinite-line relations (exact integer arithmetic).
//
// Points/vectors are 3-element int lists [x,y,z].
// All results are exact: distances as [num,den] GCD-reduced rationals, booleans as bool.
//
// Public API (prefix cgl3_):
//   cgl3_point_dist_sq(pt, a, b) -> list   [num,den] squared dist from pt to infinite line ab
//   cgl3_are_parallel(a, b, c, d) -> bool  lines ab and cd have parallel directions
//   cgl3_are_skew(a, b, c, d)    -> bool   lines ab and cd are skew (not coplanar)
//
// LEAF — imports nothing.

// _cgl3_gcd: Euclidean GCD of two non-negative integers.
fn _cgl3_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = y
        y = x - (x / y) * y
        x = t
    x

// _cgl3_cross: 3-D cross product of vectors u and v; returns [ux,uy,uz] x [vx,vy,vz].
fn _cgl3_cross(ux: int, uy: int, uz: int, vx: int, vy: int, vz: int) -> list
    let rx = uy * vz - uz * vy
    let ry = uz * vx - ux * vz
    let rz = ux * vy - uy * vx
    let r = []
    push(r, rx)
    push(r, ry)
    push(r, rz)
    r

// _cgl3_dot: 3-D dot product of vectors u and v.
fn _cgl3_dot(ux: int, uy: int, uz: int, vx: int, vy: int, vz: int) -> int
    ux * vx + uy * vy + uz * vz

// cgl3_point_dist_sq: squared distance from pt to the infinite line through a and b.
// Formula: dist^2 = |(pt-a) x (b-a)|^2 / |b-a|^2 (GCD-reduced).
// Degenerate case (a == b): returns squared distance from pt to point a.
fn cgl3_point_dist_sq(pt: list, a: list, b: list) -> list
    let dx = b[0] - a[0]
    let dy = b[1] - a[1]
    let dz = b[2] - a[2]
    let den = dx * dx + dy * dy + dz * dz
    let result = []
    if den == 0
        let ex = pt[0] - a[0]
        let ey = pt[1] - a[1]
        let ez = pt[2] - a[2]
        let dsq = ex * ex + ey * ey + ez * ez
        push(result, dsq)
        push(result, 1)
    else
        let ex = pt[0] - a[0]
        let ey = pt[1] - a[1]
        let ez = pt[2] - a[2]
        let cv = _cgl3_cross(ex, ey, ez, dx, dy, dz)
        let cx = cv[0]
        let cy = cv[1]
        let cz = cv[2]
        let num = cx * cx + cy * cy + cz * cz
        if num == 0
            push(result, 0)
            push(result, 1)
        else
            let g = _cgl3_gcd(num, den)
            push(result, num / g)
            push(result, den / g)
    result

// cgl3_are_parallel: true iff infinite lines ab and cd have parallel (or anti-parallel) directions.
// Direction vectors: u = b-a, v = d-c. Parallel iff u x v == [0,0,0].
fn cgl3_are_parallel(a: list, b: list, c: list, d: list) -> bool
    let ux = b[0] - a[0]
    let uy = b[1] - a[1]
    let uz = b[2] - a[2]
    let vx = d[0] - c[0]
    let vy = d[1] - c[1]
    let vz = d[2] - c[2]
    let cv = _cgl3_cross(ux, uy, uz, vx, vy, vz)
    cv[0] == 0 and cv[1] == 0 and cv[2] == 0

// cgl3_are_skew: true iff infinite lines ab and cd are skew (not coplanar).
// Lines are coplanar iff the scalar triple product (c-a) . ((b-a) x (d-c)) == 0.
// Skew iff that triple product != 0 AND lines are not parallel.
// (Parallel lines are coplanar or coincident; skew requires non-zero triple product.)
fn cgl3_are_skew(a: list, b: list, c: list, d: list) -> bool
    let ux = b[0] - a[0]
    let uy = b[1] - a[1]
    let uz = b[2] - a[2]
    let vx = d[0] - c[0]
    let vy = d[1] - c[1]
    let vz = d[2] - c[2]
    let wx = c[0] - a[0]
    let wy = c[1] - a[1]
    let wz = c[2] - a[2]
    let cv = _cgl3_cross(ux, uy, uz, vx, vy, vz)
    let stp = _cgl3_dot(wx, wy, wz, cv[0], cv[1], cv[2])
    stp != 0
