// std/geometry3d/cg3_aabb3.nova — 3-D axis-aligned bounding box (exact integer arithmetic).
//
// A bounding box is a 6-element int list [xmin, ymin, zmin, xmax, ymax, zmax].
// Points are 3-element int lists [x, y, z].
//
// Public API (prefix cga3_):
//   cga3_bbox(points)         -> list  [xmin,ymin,zmin,xmax,ymax,zmax] of point cloud
//   cga3_contains(bbox, pt)   -> bool  true if pt is strictly inside or on the boundary
//   cga3_volume(bbox)         -> int   (xmax-xmin)*(ymax-ymin)*(zmax-zmin)
//   cga3_intersects(b1, b2)   -> bool  true if two AABBs have non-empty overlap (inclusive)
//
// LEAF — imports nothing.

// _cga3_min2: minimum of two integers.
fn _cga3_min2(a: int, b: int) -> int
    let r = a
    if b < a
        r = b
    r

// _cga3_max2: maximum of two integers.
fn _cga3_max2(a: int, b: int) -> int
    let r = a
    if b > a
        r = b
    r

// cga3_bbox: compute the AABB [xmin,ymin,zmin,xmax,ymax,zmax] of a non-empty point cloud.
fn cga3_bbox(points: list) -> list
    let p0 = points[0]
    let xmin = p0[0]
    let ymin = p0[1]
    let zmin = p0[2]
    let xmax = p0[0]
    let ymax = p0[1]
    let zmax = p0[2]
    for i in 1..len(points)
        let p = points[i]
        xmin = _cga3_min2(xmin, p[0])
        ymin = _cga3_min2(ymin, p[1])
        zmin = _cga3_min2(zmin, p[2])
        xmax = _cga3_max2(xmax, p[0])
        ymax = _cga3_max2(ymax, p[1])
        zmax = _cga3_max2(zmax, p[2])
    let r = []
    push(r, xmin)
    push(r, ymin)
    push(r, zmin)
    push(r, xmax)
    push(r, ymax)
    push(r, zmax)
    r

// cga3_contains: true if point pt is inside or on the boundary of bbox (inclusive).
fn cga3_contains(bbox: list, pt: list) -> bool
    let x = pt[0]
    let y = pt[1]
    let z = pt[2]
    x >= bbox[0] and x <= bbox[3] and y >= bbox[1] and y <= bbox[4] and z >= bbox[2] and z <= bbox[5]

// cga3_volume: volume of the AABB = dx * dy * dz (exact integer).
fn cga3_volume(bbox: list) -> int
    let dx = bbox[3] - bbox[0]
    let dy = bbox[4] - bbox[1]
    let dz = bbox[5] - bbox[2]
    dx * dy * dz

// cga3_intersects: true if two AABBs have a non-empty overlap (touching counts).
// Overlap on each axis: max(b1.min, b2.min) <= min(b1.max, b2.max).
fn cga3_intersects(b1: list, b2: list) -> bool
    let ox = _cga3_max2(b1[0], b2[0]) <= _cga3_min2(b1[3], b2[3])
    let oy = _cga3_max2(b1[1], b2[1]) <= _cga3_min2(b1[4], b2[4])
    let oz = _cga3_max2(b1[2], b2[2]) <= _cga3_min2(b1[5], b2[5])
    ox and oy and oz
