// std/geometry3d/cg3_vector.nova — 3D integer vector primitives (exact arithmetic).
//
// A 3D point/vector is a 3-element integer list [x, y, z].
// All results are EXACT integers — no floats, no rounding.
// Degenerate inputs (zero vectors) are handled correctly.
// LEAF — imports NOTHING.

// cgv3_cross: cross product a x b = [a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]].
fn cgv3_cross(a: list, b: list) -> list
    let a0 = a[0]
    let a1 = a[1]
    let a2 = a[2]
    let b0 = b[0]
    let b1 = b[1]
    let b2 = b[2]
    let cx = a1 * b2 - a2 * b1
    let cy = a2 * b0 - a0 * b2
    let cz = a0 * b1 - a1 * b0
    let result = [cx, cy, cz]
    result

// cgv3_dot: dot product a . b = a[0]*b[0] + a[1]*b[1] + a[2]*b[2].
fn cgv3_dot(a: list, b: list) -> int
    let a0 = a[0]
    let a1 = a[1]
    let a2 = a[2]
    let b0 = b[0]
    let b1 = b[1]
    let b2 = b[2]
    let d = a0 * b0 + a1 * b1 + a2 * b2
    d

// cgv3_norm_sq: squared magnitude |a|^2 = a[0]^2 + a[1]^2 + a[2]^2.
fn cgv3_norm_sq(a: list) -> int
    let a0 = a[0]
    let a1 = a[1]
    let a2 = a[2]
    let nsq = a0 * a0 + a1 * a1 + a2 * a2
    nsq

// cgv3_add: component-wise addition a + b.
fn cgv3_add(a: list, b: list) -> list
    let a0 = a[0]
    let a1 = a[1]
    let a2 = a[2]
    let b0 = b[0]
    let b1 = b[1]
    let b2 = b[2]
    let result = [a0 + b0, a1 + b1, a2 + b2]
    result

// cgv3_sub: component-wise subtraction a - b.
fn cgv3_sub(a: list, b: list) -> list
    let a0 = a[0]
    let a1 = a[1]
    let a2 = a[2]
    let b0 = b[0]
    let b1 = b[1]
    let b2 = b[2]
    let result = [a0 - b0, a1 - b1, a2 - b2]
    result

// cgv3_scale: scalar multiplication s * a.
fn cgv3_scale(a: list, s: int) -> list
    let a0 = a[0]
    let a1 = a[1]
    let a2 = a[2]
    let result = [a0 * s, a1 * s, a2 * s]
    result
