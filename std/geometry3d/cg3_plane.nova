// std/geometry3d/cg3_plane.nova — 3D integer plane operations (exact arithmetic).
//
// A plane is represented as [nx, ny, nz, d] where the plane equation is
//   n . p + d = 0  (i.e. nx*px + ny*py + nz*pz + d = 0).
// Given three points a, b, c: n = (b-a) x (c-a),  d = -(n . a).
// All results are EXACT integers or [num,den] reduced rationals — no floats.
// Degenerate cases (collinear or coincident input points give a zero normal) handled.
// LEAF — imports NOTHING.

// _cgp3_iabs: absolute value of integer x.
fn _cgp3_iabs(x: int) -> int
    let r = x
    if x < 0
        r = 0 - x
    r

// _cgp3_gcd: greatest common divisor of two non-negative integers (Euclidean algorithm).
fn _cgp3_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = y
        y = x - (x / y) * y
        x = t
    x

// cgp3_from_points: construct plane [nx,ny,nz,d] passing through points a, b, c.
// Normal n = (b-a) x (c-a); d = -(n . a).
// If a, b, c are collinear the normal is [0,0,0] and d=0 (degenerate plane).
fn cgp3_from_points(a: list, b: list, c: list) -> list
    let a0 = a[0]
    let a1 = a[1]
    let a2 = a[2]
    let ab0 = b[0] - a0
    let ab1 = b[1] - a1
    let ab2 = b[2] - a2
    let ac0 = c[0] - a0
    let ac1 = c[1] - a1
    let ac2 = c[2] - a2
    let nx = ab1 * ac2 - ab2 * ac1
    let ny = ab2 * ac0 - ab0 * ac2
    let nz = ab0 * ac1 - ab1 * ac0
    let d = 0 - (nx * a0 + ny * a1 + nz * a2)
    let result = [nx, ny, nz, d]
    result

// cgp3_side: which side of the plane is point pt on?
// Evaluates n . pt + d (where plane = [nx,ny,nz,d]).
// Returns  1 if positive side, -1 if negative side, 0 if on the plane.
fn cgp3_side(plane: list, pt: list) -> int
    let nx = plane[0]
    let ny = plane[1]
    let nz = plane[2]
    let d = plane[3]
    let val = nx * pt[0] + ny * pt[1] + nz * pt[2] + d
    let result = 0
    if val > 0
        result = 1
    if val < 0
        result = -1
    result

// cgp3_dist_sq: squared distance from pt to the plane, as reduced rational [num, den].
// Formula: dist^2 = (n . pt + d)^2 / |n|^2.
// If the plane is degenerate (|n|^2 == 0), returns [0, 1].
fn cgp3_dist_sq(plane: list, pt: list) -> list
    let nx = plane[0]
    let ny = plane[1]
    let nz = plane[2]
    let d = plane[3]
    let val = nx * pt[0] + ny * pt[1] + nz * pt[2] + d
    let num = val * val
    let den = nx * nx + ny * ny + nz * nz
    let result = []
    if den == 0
        push(result, 0)
        push(result, 1)
    else
        if num == 0
            push(result, 0)
            push(result, 1)
        else
            let g = _cgp3_gcd(num, den)
            push(result, num / g)
            push(result, den / g)
    result

// cgp3_contains: true iff point pt lies exactly on the plane (n . pt + d == 0).
fn cgp3_contains(plane: list, pt: list) -> bool
    let nx = plane[0]
    let ny = plane[1]
    let nz = plane[2]
    let d = plane[3]
    let val = nx * pt[0] + ny * pt[1] + nz * pt[2] + d
    val == 0
