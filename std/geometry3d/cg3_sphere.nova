// std/geometry3d/cg3_sphere.nova — Sphere predicates in exact integer arithmetic.
//
// A sphere is represented as a center point [x,y,z] plus an integer squared radius r_sq.
// All arithmetic is EXACT INTEGER — no floats, no sqrt, no rounding.
// Degenerate inputs (r_sq=0 = single point) are handled correctly.
// LEAF — imports NOTHING.

// cgs3_dist_sq: squared Euclidean distance between two 3D points.
fn cgs3_dist_sq(a: list, b: list) -> int
    let dx = a[0] - b[0]
    let dy = a[1] - b[1]
    let dz = a[2] - b[2]
    dx*dx + dy*dy + dz*dz

// cgs3_contains: true iff point pt is inside or on the sphere (center, r_sq).
// Equivalent to dist^2(center, pt) <= r_sq.
fn cgs3_contains(center: list, r_sq: int, pt: list) -> bool
    let d2 = cgs3_dist_sq(center, pt)
    d2 <= r_sq

// cgs3_on_surface: true iff point pt lies exactly on the sphere surface.
// Equivalent to dist^2(center, pt) == r_sq.
fn cgs3_on_surface(center: list, r_sq: int, pt: list) -> bool
    let d2 = cgs3_dist_sq(center, pt)
    d2 == r_sq

// cgs3_spheres_intersect: true iff two spheres touch or overlap.
// Spheres intersect iff dist(c1,c2) <= r1 + r2, i.e. dist^2 <= (r1+r2)^2.
// Since r1=sqrt(r1_sq), r2=sqrt(r2_sq): (r1+r2)^2 = r1_sq + r2_sq + 2*sqrt(r1_sq*r2_sq).
// Exact case analysis avoiding sqrt:
//   Let diff = d2 - r1_sq - r2_sq.
//   If diff <= 0: d2 <= r1_sq+r2_sq <= (r1+r2)^2, so TRUE.
//   If diff > 0: condition becomes diff <= 2*sqrt(r1_sq*r2_sq).
//     Both sides positive; squaring: diff^2 <= 4*r1_sq*r2_sq.
fn cgs3_spheres_intersect(c1: list, r1_sq: int, c2: list, r2_sq: int) -> bool
    let d2 = cgs3_dist_sq(c1, c2)
    let diff = d2 - r1_sq - r2_sq
    if diff <= 0
        return true
    let lhs = diff * diff
    let rhs = 4 * r1_sq * r2_sq
    lhs <= rhs
