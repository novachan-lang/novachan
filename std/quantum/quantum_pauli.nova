// std/quantum/quantum_pauli.nova — single-qubit Pauli algebra (I, X, Y, Z).
// Imports std/quantum/quantum_state. A single-qubit Pauli is a char "I"/"X"/"Y"/"Z".
//
// This module deliberately reconstructs the single-qubit "apply a 2x2 matrix
// to qubit q" primitive locally (see _qpl_apply_single) rather than importing
// std/quantum/quantum_gate1 — quantum_pauli's job is Pauli GROUP algebra
// (multiplication table, (anti)commutation) plus the one expectation-value
// use of matrix application; it stays independent of the gate-library module
// so callers who only need Pauli algebra don't pull in the whole gate set.
//
// Public API (prefix qpl_):
//   qpl_matrix(p)                  -> list  2x2 complex matrix [[c00,c01],[c10,c11]] for Pauli p
//   qpl_mul(a, b)                  -> list  [phase, result_char]; a*b = phase * result_char
//   qpl_commute(a, b)              -> int   1 if a,b commute (equal, or either is "I"), else 0
//   qpl_anticommute(a, b)          -> int   1 if a,b anticommute (distinct, both non-"I"), else 0
//   qpl_expect_x1000(state, p, q)  -> int   round(<state|P_q|state> * 1000), P=Pauli p on qubit q
//   qpl_string_matches(pstr, qstr) -> int   1 if two Pauli strings are equal (same length+chars)

import std/quantum/quantum_state

// ── internal helpers ────────────────────────────────────────────────────────

// _qpl_round1000 — round x*1000 to the nearest int, handling negative x correctly.
fn _qpl_round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

// _qpl_mat — assemble a 2x2 matrix [[c00,c01],[c10,c11]] from 4 complex numbers.
fn _qpl_mat(c00: list, c01: list, c10: list, c11: list) -> list
    let row0 = []
    push(row0, c00)
    push(row0, c01)
    let row1 = []
    push(row1, c10)
    push(row1, c11)
    let m = []
    push(m, row0)
    push(m, row1)
    m

// _qpl_index — map a Pauli char to its cyclic index: X=0, Y=1, Z=2, I=-1 ("not one of X/Y/Z").
fn _qpl_index(p: string) -> int
    if p == "X"
        return 0
    if p == "Y"
        return 1
    if p == "Z"
        return 2
    0 - 1

// _qpl_from_index — inverse of _qpl_index for indices 0/1/2.
fn _qpl_from_index(idx: int) -> string
    if idx == 0
        return "X"
    if idx == 1
        return "Y"
    "Z"

// ── Pauli matrices ───────────────────────────────────────────────────────────

// qpl_matrix — the 2x2 matrix for Pauli char p. Unknown chars fall back to I
// (identity), matching the convention that "I" is the algebra's neutral element.
fn qpl_matrix(p: string) -> list
    if p == "X"
        return _qpl_mat(qst_c(0.0, 0.0), qst_c(1.0, 0.0), qst_c(1.0, 0.0), qst_c(0.0, 0.0))
    if p == "Y"
        return _qpl_mat(qst_c(0.0, 0.0), qst_c(0.0, 0.0 - 1.0), qst_c(0.0, 1.0), qst_c(0.0, 0.0))
    if p == "Z"
        return _qpl_mat(qst_c(1.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0 - 1.0, 0.0))
    _qpl_mat(qst_c(1.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0, 0.0), qst_c(1.0, 0.0))

// ── Pauli group multiplication ───────────────────────────────────────────────

// qpl_mul — multiply two single-qubit Paulis a*b. Returns [phase, result_char]
// where phase is a complex [re,im] (one of +-1, +-i) and result_char is I/X/Y/Z.
// Rules: I is neutral (phase 1). P*P == I (phase 1) for P in {X,Y,Z}. For
// distinct non-I a,b, the result is the third Pauli; the phase is +i when
// (a,b) is a step of the cyclic order X->Y->Z->X, else -i.
fn qpl_mul(a: string, b: string) -> list
    let ia = _qpl_index(a)
    let ib = _qpl_index(b)
    let phase = qst_c(1.0, 0.0)
    let result_char = "I"
    if ia == (0 - 1)
        result_char = b
    else if ib == (0 - 1)
        result_char = a
    else if ia == ib
        result_char = "I"
    else
        let ic = 3 - ia - ib
        result_char = _qpl_from_index(ic)
        let next = (ia + 1) % 3
        if next == ib
            phase = qst_c(0.0, 1.0)
        else
            phase = qst_c(0.0, 0.0 - 1.0)
    let r = []
    push(r, phase)
    push(r, result_char)
    r

// qpl_commute — 1 if a and b commute: equal, or either is "I". Else 0
// (any two distinct non-"I" Paulis anticommute).
fn qpl_commute(a: string, b: string) -> int
    if a == b
        return 1
    if a == "I"
        return 1
    if b == "I"
        return 1
    0

// qpl_anticommute — the complement of qpl_commute over the valid Pauli
// alphabet {I,X,Y,Z}: 1 if a,b are distinct and both non-"I", else 0.
fn qpl_anticommute(a: string, b: string) -> int
    let c = qpl_commute(a, b)
    1 - c

// ── expectation value ────────────────────────────────────────────────────────

// _qpl_apply_single — apply a 2x2 `mat` to qubit `q` of an n-qubit `state`.
// For every basis index i with bit q == 0, let j be the index with bit q
// flipped: new[i] = m00*amp[i] + m01*amp[j], new[j] = m10*amp[i] + m11*amp[j].
fn _qpl_apply_single(state: list, q: int, mat: list) -> list
    let n = qst_num_qubits(state)
    let dim = qst_dim(state)
    let out = [qst_amp(state, k) for k in 0..dim]
    let m00 = mat[0][0]
    let m01 = mat[0][1]
    let m10 = mat[1][0]
    let m11 = mat[1][1]
    let i = 0
    while i < dim
        if qst_bit(i, n, q) == 0
            let j = qst_flip_bit(i, n, q)
            let a0 = qst_amp(state, i)
            let a1 = qst_amp(state, j)
            let t0 = qst_cadd(qst_cmul(m00, a0), qst_cmul(m01, a1))
            let t1 = qst_cadd(qst_cmul(m10, a0), qst_cmul(m11, a1))
            out[i] = t0
            out[j] = t1
        i = i + 1
    out

// qpl_expect_x1000 — round(<state|P_q|state> * 1000) where P is the single-qubit
// Pauli `p` acting on qubit `q`. Computed as Re(sum_i conj(amp_psi[i]) * amp_Ppsi[i]).
fn qpl_expect_x1000(state: list, p: string, q: int) -> int
    let mat = qpl_matrix(p)
    let pstate = _qpl_apply_single(state, q, mat)
    let dim = qst_dim(state)
    let total = 0.0
    for i in 0..dim
        let psi = qst_amp(state, i)
        let ppsi = qst_amp(pstate, i)
        let conj_psi = qst_cconj(psi)
        let prod = qst_cmul(conj_psi, ppsi)
        let re = prod[0]
        total = total + re
    _qpl_round1000(total)

// ── Pauli strings ────────────────────────────────────────────────────────────

// qpl_string_matches — 1 if two Pauli strings (e.g. "XYZI") have equal length
// and equal content, else 0.
fn qpl_string_matches(pstr: string, qstr: string) -> int
    if len(pstr) != len(qstr)
        return 0
    if pstr == qstr
        return 1
    0
