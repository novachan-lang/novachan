// std/quantum/quantum_state.nova — complex numbers + n-qubit state vectors.
// LEAF — imports NOTHING.
//
// Representation (PINNED — every module in std/quantum uses this):
//   COMPLEX number  = 2-element list of floats [re, im].
//   SINGLE QUBIT    = 2-element list of complex [amp0, amp1] (same shape as a 1-qubit state).
//   n-QUBIT STATE   = flat list of 2^n complex amplitudes, indexed by computational basis state.
//     Qubit order is BIG-ENDIAN: qubit 0 is the MOST-significant bit. For n qubits, the basis
//     index of |b0 b1 ... b(n-1)> = b0*2^(n-1) + b1*2^(n-2) + ... + b(n-1)*2^0.
//
// Public API (prefix qst_):
//   qst_c(re, im)                 -> list   build a complex number (forces float)
//   qst_cadd(x, y)                -> list   complex add
//   qst_csub(x, y)                -> list   complex subtract
//   qst_cmul(x, y)                -> list   complex multiply
//   qst_cscale(x, s)              -> list   scale complex x by real float s
//   qst_cconj(x)                  -> list   complex conjugate
//   qst_cabs2(x)                  -> float  squared magnitude
//   qst_zero(n)                   -> list   n-qubit |0...0>
//   qst_basis(n, index)           -> list   n-qubit |index>
//   qst_dim(state)                -> int    2^n = len(state)
//   qst_num_qubits(state)         -> int    n such that 2^n == len(state)
//   qst_amp(state, index)         -> list   complex amplitude at basis index (copy)
//   qst_set_amp(state, index, c)  -> list   set state[index]=c, mutates + returns state
//   qst_norm2(state)              -> float  sum of |amp|^2 over all amplitudes
//   qst_normalize(state)          -> list   new state scaled to unit norm (unchanged copy if norm2==0)
//   qst_prob(state, index)        -> float  |amp(index)|^2
//   qst_prob_x1000(state, index)  -> int    round(prob*1000)
//   qst_to_probs(state)           -> list   list of |amp|^2 for all basis states
//   qst_kron(a, b)                -> list   tensor product of two states
//   qst_equal_x1000(a, b)         -> int    1 if states match within 1/1000, else 0
//   qst_bit(index, n, q)          -> int    value (0/1) of qubit q (q=0 is MSB) in basis index
//   qst_flip_bit(index, n, q)     -> int    index with qubit q's bit flipped
//   qst_set_bit(index, n, q, v)   -> int    index with qubit q set to v (0/1)

// ── complex number helpers ──────────────────────────────────────────────────

// qst_c — build a complex number [re, im], forcing both parts to float.
fn qst_c(re: float, im: float) -> list
    let rr = re * 1.0
    let ri = im * 1.0
    let r = []
    push(r, rr)
    push(r, ri)
    r

// qst_cadd — complex add: [xr+yr, xi+yi].
fn qst_cadd(x: list, y: list) -> list
    let rre = x[0] + y[0]
    let rim = x[1] + y[1]
    let r = []
    push(r, rre)
    push(r, rim)
    r

// qst_csub — complex subtract: [xr-yr, xi-yi].
fn qst_csub(x: list, y: list) -> list
    let rre = x[0] - y[0]
    let rim = x[1] - y[1]
    let r = []
    push(r, rre)
    push(r, rim)
    r

// qst_cmul — complex multiply: (xr+xi*i)(yr+yi*i) = [xr*yr-xi*yi, xr*yi+xi*yr].
fn qst_cmul(x: list, y: list) -> list
    let xr = x[0]
    let xi = x[1]
    let yr = y[0]
    let yi = y[1]
    let rre = xr * yr - xi * yi
    let rim = xr * yi + xi * yr
    let r = []
    push(r, rre)
    push(r, rim)
    r

// qst_cscale — scale complex x by a real float scalar s.
fn qst_cscale(x: list, s: float) -> list
    let rre = x[0] * s
    let rim = x[1] * s
    let r = []
    push(r, rre)
    push(r, rim)
    r

// qst_cconj — complex conjugate: [re, -im].
fn qst_cconj(x: list) -> list
    let rim = 0.0 - x[1]
    let r = []
    push(r, x[0])
    push(r, rim)
    r

// qst_cabs2 — squared magnitude re*re + im*im.
fn qst_cabs2(x: list) -> float
    let re = x[0]
    let im = x[1]
    let re2 = re * re
    let im2 = im * im
    let total = re2 + im2
    total

// ── internal helpers ────────────────────────────────────────────────────────

// _qst_pow2 — 2^k for k >= 0, via a while loop.
fn _qst_pow2(k: int) -> int
    let r = 1
    for i in 0..k
        r = r * 2
    r

// _qst_round1000 — round x*1000 to the nearest int, handling negative x correctly.
fn _qst_round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

// ── state constructors / accessors ──────────────────────────────────────────

// qst_zero — n-qubit |0...0>: amp[0]=1, rest 0.
fn qst_zero(n: int) -> list
    let dim = _qst_pow2(n)
    let s = []
    push(s, qst_c(1.0, 0.0))
    for i in 1..dim
        push(s, qst_c(0.0, 0.0))
    s

// qst_basis — n-qubit |index>: amp[index]=1, rest 0.
fn qst_basis(n: int, index: int) -> list
    let dim = _qst_pow2(n)
    let s = []
    for i in 0..dim
        if i == index
            push(s, qst_c(1.0, 0.0))
        else
            push(s, qst_c(0.0, 0.0))
    s

// qst_dim — dimension of a state (2^n).
fn qst_dim(state: list) -> int
    len(state)

// qst_num_qubits — n such that 2^n == len(state), found by doubling from 1.
fn qst_num_qubits(state: list) -> int
    let dim = len(state)
    let n = 0
    let p = 1
    while p < dim
        p = p * 2
        n += 1
    n

// qst_amp — the complex amplitude at basis index (returns a copy).
fn qst_amp(state: list, index: int) -> list
    let a = state[index]
    qst_c(a[0], a[1])

// qst_set_amp — set state[index]=c (mutates the list in place; also returns it).
fn qst_set_amp(state: list, index: int, c: list) -> list
    state[index] = c
    state

// qst_norm2 — sum of |amp|^2 over all amplitudes.
fn qst_norm2(state: list) -> float
    let n = len(state)
    let i = 0
    let total = 0.0
    while i < n
        let a2 = qst_cabs2(state[i])
        total += a2
        i += 1
    total

// qst_normalize — return a NEW state scaled to unit norm. If norm2==0.0 the
// returned state has the same (zero) amplitudes, just in a fresh list.
fn qst_normalize(state: list) -> list
    let n2 = qst_norm2(state)
    let n = len(state)
    let inv = 1.0
    if n2 != 0.0
        let nrm = sqrt(n2)
        inv = 1.0 / nrm
    let out = []
    for i in 0..n
        push(out, qst_cscale(state[i], inv))
    out

// qst_prob — probability of basis index: |amp(index)|^2.
fn qst_prob(state: list, index: int) -> float
    qst_cabs2(state[index])

// qst_prob_x1000 — round(prob*1000) to the nearest int (prob is always >= 0).
fn qst_prob_x1000(state: list, index: int) -> int
    let p = qst_prob(state, index)
    _qst_round1000(p)

// qst_to_probs — list of |amp|^2 for every basis state.
fn qst_to_probs(state: list) -> list
    let n = len(state)
    let out = []
    for i in 0..n
        push(out, qst_cabs2(state[i]))
    out

// qst_kron — tensor product of states a (len na) and b (len nb): result[i*nb+j] = a[i]*b[j].
fn qst_kron(a: list, b: list) -> list
    let na = len(a)
    let nb = len(b)
    let out = []
    for i in 0..na
        for j in 0..nb
            push(out, qst_cmul(a[i], b[j]))
    out

// qst_equal_x1000 — 1 if a and b have equal length and every amplitude matches
// within 1/1000 (compared via rounded re/im), else 0.
fn qst_equal_x1000(a: list, b: list) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let i = 0
    let ok = 1
    while i < na
        let ca = a[i]
        let cb = b[i]
        let are = _qst_round1000(ca[0])
        let aim = _qst_round1000(ca[1])
        let bre = _qst_round1000(cb[0])
        let bim = _qst_round1000(cb[1])
        if are != bre
            ok = 0
        if aim != bim
            ok = 0
        i += 1
    ok

// ── bit helpers (index arithmetic over big-endian basis indices) ───────────

// qst_bit — value (0/1) of qubit q in an n-qubit basis index. q=0 is the MSB:
// bit value = (index / 2^(n-1-q)) mod 2.
fn qst_bit(index: int, n: int, q: int) -> int
    let shift = n - 1 - q
    let place = _qst_pow2(shift)
    let divided = index / place
    divided % 2

// qst_flip_bit — return index with qubit q's bit flipped (XOR the 2^(n-1-q) place).
fn qst_flip_bit(index: int, n: int, q: int) -> int
    let shift = n - 1 - q
    let place = _qst_pow2(shift)
    let bit = qst_bit(index, n, q)
    if bit == 1
        return index - place
    index + place

// qst_set_bit — return index with qubit q set to v (0/1).
fn qst_set_bit(index: int, n: int, q: int, v: int) -> int
    let cur = qst_bit(index, n, q)
    if cur == v
        return index
    qst_flip_bit(index, n, q)
