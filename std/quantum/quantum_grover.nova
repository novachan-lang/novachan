// std/quantum/quantum_grover.nova — Grover's search algorithm.
// Imports std/quantum/quantum_state, std/quantum/quantum_gate1, std/quantum/quantum_measure.
//
// Representation (matches quantum_state.nova — PINNED across std/quantum):
//   COMPLEX number  = 2-element list of floats [re, im].
//   n-QUBIT STATE   = flat list of 2^n complex amplitudes, BIG-ENDIAN (qubit 0 = MSB).
//
// Grover's algorithm searches an unsorted space of N=2^n items for a single marked
// `target` index using O(sqrt(N)) oracle calls (vs O(N) classically):
//   1. Start in the equal superposition of all N basis states (qgr_uniform).
//   2. Repeat floor((pi/4)*sqrt(N)) times (qgr_optimal_iterations):
//        a. Oracle: flip the sign of the marked amplitude (qgr_oracle).
//        b. Diffusion: invert every amplitude about the mean (qgr_diffusion).
//   3. Measure — the marked index now has near-certain probability.
//
// Public API (prefix qgr_):
//   qgr_uniform(n)                  -> list  n-qubit equal superposition, amp = 1/sqrt(2^n)
//   qgr_oracle(state, target)       -> list  phase-flip amp[target] (marks it)
//   qgr_diffusion(state)            -> list  inversion about the mean (amplitude amplification)
//   qgr_iterate(state, target)      -> list  one Grover iteration = diffusion(oracle(state))
//   qgr_optimal_iterations(n)       -> int   floor((pi/4)*sqrt(2^n)) — iteration count that
//                                            maximizes P(measuring target) for N=2^n, 1 marked item
//   qgr_search(n, target)           -> list  full Grover search: uniform + optimal iterations
//   qgr_search_result(n, target)    -> int   basis index most likely after qgr_search

import std/quantum/quantum_state
import std/quantum/quantum_gate1
import std/quantum/quantum_measure

// ── internal helpers ────────────────────────────────────────────────────────

// _qgr_pow2 — 2^k for k >= 0, via a while loop.
fn _qgr_pow2(k: int) -> int
    let r = 1
    for i in 0..k
        r = r * 2
    r

// _qgr_mean — the complex mean of every amplitude in `state`. Shared building
// block for qgr_diffusion (inversion-about-the-mean needs the mean once per call).
fn _qgr_mean(state: list) -> list
    let dim = qst_dim(state)
    let sum = qst_c(0.0, 0.0)
    for i in 0..dim
        sum = qst_cadd(sum, qst_amp(state, i))
    let dim_f = dim * 1.0
    let inv = 1.0 / dim_f
    qst_cscale(sum, inv)

// ── construction ─────────────────────────────────────────────────────────────

// qgr_uniform — n-qubit equal superposition: start at |0...0> and apply a
// Hadamard to every qubit in turn (threading the state through the while loop).
// Every amplitude ends at 1/sqrt(2^n).
fn qgr_uniform(n: int) -> list
    let state = qst_zero(n)
    for q in 0..n
        state = qg1_apply_h(state, q)
    state

// ── Grover operators ────────────────────────────────────────────────────────

// qgr_oracle — phase oracle marking basis index `target`: negate amp[target]
// (multiply by -1), every other amplitude unchanged.
fn qgr_oracle(state: list, target: int) -> list
    let dim = qst_dim(state)
    let out = []
    for i in 0..dim
        push(out, qst_amp(state, i))
    let old = qst_amp(out, target)
    let flipped = qst_cscale(old, -1.0)
    qst_set_amp(out, target, flipped)
    out

// qgr_diffusion — inversion about the mean: new_amp[i] = 2*mean - amp[i],
// where mean is the complex average of every amplitude. This is the standard
// Grover diffusion operator (reflection about the average amplitude): it
// amplifies any amplitude below the mean and shrinks any amplitude above it —
// after the oracle's phase flip, the marked amplitude sits furthest below the
// mean and so grows fastest across iterations.
fn qgr_diffusion(state: list) -> list
    let dim = qst_dim(state)
    let mean = _qgr_mean(state)
    let two_mean = qst_cscale(mean, 2.0)
    let out = []
    for i in 0..dim
        let ai = qst_amp(state, i)
        push(out, qst_csub(two_mean, ai))
    out

// qgr_iterate — one Grover iteration: oracle then diffusion.
fn qgr_iterate(state: list, target: int) -> list
    qgr_diffusion(qgr_oracle(state, target))

// ── search ───────────────────────────────────────────────────────────────────

// qgr_optimal_iterations — floor((pi/4)*sqrt(2^n)), the iteration count that
// maximizes P(measuring the marked item) for a single marked item among 2^n.
fn qgr_optimal_iterations(n: int) -> int
    let dim = _qgr_pow2(n)
    let dim_f = dim * 1.0
    let root = sqrt(dim_f)
    let PI = pi()
    let factor = PI / 4.0
    let product = factor * root
    float_to_int(product)

// qgr_search — full Grover search over n qubits for basis index `target`:
// build the uniform superposition, then apply qgr_optimal_iterations(n)
// Grover iterations (threading the state through the while loop).
fn qgr_search(n: int, target: int) -> list
    let state = qgr_uniform(n)
    let iters = qgr_optimal_iterations(n)
    for i in 0..iters
        state = qgr_iterate(state, target)
    state

// qgr_search_result — the most-likely basis index after qgr_search(n, target).
fn qgr_search_result(n: int, target: int) -> int
    qms_most_likely(qgr_search(n, target))
