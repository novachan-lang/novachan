// std/quantum/quantum_qubit.nova — single-qubit constructors and measurement stats.
// LEAF — imports NOTHING (owns its own tiny complex helpers; does not depend on quantum_state).
//
// Representation (PINNED — matches quantum_state.nova):
//   COMPLEX number = 2-element list of floats [re, im].
//   A QUBIT        = 2-element list of complex [amp0, amp1].
//
// Public API (prefix qbt_):
//   qbt_make(a0re, a0im, a1re, a1im)  -> list   [[a0re,a0im],[a1re,a1im]] (forces float)
//   qbt_zero()                        -> list   |0>
//   qbt_one()                         -> list   |1>
//   qbt_plus()                        -> list   |+> = (|0>+|1>)/sqrt(2)
//   qbt_minus()                       -> list   |-> = (|0>-|1>)/sqrt(2)
//   qbt_plus_i()                      -> list   |+i> = (|0>+i|1>)/sqrt(2)
//   qbt_minus_i()                     -> list   |-i> = (|0>-i|1>)/sqrt(2)
//   qbt_amp0(q)                       -> list   complex amplitude of |0> (copy)
//   qbt_amp1(q)                       -> list   complex amplitude of |1> (copy)
//   qbt_prob0(q)                      -> float  |amp0|^2
//   qbt_prob1(q)                      -> float  |amp1|^2
//   qbt_prob0_x1000(q)                -> int    round(prob0*1000)
//   qbt_prob1_x1000(q)                -> int    round(prob1*1000)
//   qbt_norm2(q)                      -> float  prob0+prob1
//   qbt_normalize(q)                  -> list   new qubit scaled to unit norm
//   qbt_is_normalized_x1000(q)        -> int    1 if round(norm2*1000)==1000, else 0

// ── internal helpers ────────────────────────────────────────────────────────

// _qbt_copy_c — copy a 2-element complex [re, im] into a fresh list.
fn _qbt_copy_c(c: list) -> list
    let r = []
    push(r, c[0])
    push(r, c[1])
    r

// _qbt_cabs2 — squared magnitude of a complex number: re*re + im*im.
fn _qbt_cabs2(c: list) -> float
    let re = c[0]
    let im = c[1]
    let re2 = re * re
    let im2 = im * im
    let total = re2 + im2
    total

// _qbt_round1000 — round x*1000 to the nearest int, handling negative x correctly.
fn _qbt_round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

// _qbt_cscale — scale a single complex amplitude [re,im] by a real float s.
fn _qbt_cscale(c: list, s: float) -> list
    let rre = c[0] * s
    let rim = c[1] * s
    let r = []
    push(r, rre)
    push(r, rim)
    r

// qbt_make — build a qubit [[a0re,a0im],[a1re,a1im]], forcing all four parts to float.
fn qbt_make(a0re: float, a0im: float, a1re: float, a1im: float) -> list
    let r0re = a0re * 1.0
    let r0im = a0im * 1.0
    let r1re = a1re * 1.0
    let r1im = a1im * 1.0
    let amp0 = []
    push(amp0, r0re)
    push(amp0, r0im)
    let amp1 = []
    push(amp1, r1re)
    push(amp1, r1im)
    let q = []
    push(q, amp0)
    push(q, amp1)
    q

// ── measurement stats + normalize (kept close to qbt_make; see order note above) ──

// qbt_prob0 — |amp0|^2.
fn qbt_prob0(q: list) -> float
    _qbt_cabs2(q[0])

// qbt_prob1 — |amp1|^2.
fn qbt_prob1(q: list) -> float
    _qbt_cabs2(q[1])

// qbt_norm2 — prob0+prob1.
fn qbt_norm2(q: list) -> float
    let p0 = qbt_prob0(q)
    let p1 = qbt_prob1(q)
    let total = p0 + p1
    total

// qbt_normalize — return a NEW qubit scaled to unit norm (unchanged copy if norm2==0.0).
fn qbt_normalize(q: list) -> list
    let n2 = qbt_norm2(q)
    let inv = 1.0
    if n2 != 0.0
        let nrm = sqrt(n2)
        inv = 1.0 / nrm
    let out = []
    let i = 0
    while i < 2
        push(out, _qbt_cscale(q[i], inv))
        i = i + 1
    out

// ── constructors ─────────────────────────────────────────────────────────────

// qbt_zero — the |0> qubit.
fn qbt_zero() -> list
    qbt_make(1.0, 0.0, 0.0, 0.0)

// qbt_one — the |1> qubit.
fn qbt_one() -> list
    qbt_make(0.0, 0.0, 1.0, 0.0)

// _qbt_inv_sqrt2 — 1/sqrt(2), shared by the four superposition constructors
// (avoids repeating the same 1.0/sqrt(2.0) in each — anti-duplication).
fn _qbt_inv_sqrt2() -> float
    let two = 2.0
    let s = sqrt(two)
    let r = 1.0 / s
    r

// qbt_plus — |+> = (|0>+|1>)/sqrt(2).
fn qbt_plus() -> list
    let r = _qbt_inv_sqrt2()
    qbt_make(r, 0.0, r, 0.0)

// qbt_minus — |-> = (|0>-|1>)/sqrt(2).
fn qbt_minus() -> list
    let r = _qbt_inv_sqrt2()
    let negr = 0.0 - r
    qbt_make(r, 0.0, negr, 0.0)

// qbt_plus_i — |+i> = (|0>+i|1>)/sqrt(2).
fn qbt_plus_i() -> list
    let r = _qbt_inv_sqrt2()
    qbt_make(r, 0.0, 0.0, r)

// qbt_minus_i — |-i> = (|0>-i|1>)/sqrt(2).
fn qbt_minus_i() -> list
    let r = _qbt_inv_sqrt2()
    let negr = 0.0 - r
    qbt_make(r, 0.0, 0.0, negr)

// ── accessors ────────────────────────────────────────────────────────────────

// qbt_amp0 — complex amplitude of |0> (copy).
fn qbt_amp0(q: list) -> list
    _qbt_copy_c(q[0])

// qbt_amp1 — complex amplitude of |1> (copy).
fn qbt_amp1(q: list) -> list
    _qbt_copy_c(q[1])

// qbt_prob0_x1000 — round(prob0*1000).
fn qbt_prob0_x1000(q: list) -> int
    let p = qbt_prob0(q)
    _qbt_round1000(p)

// qbt_prob1_x1000 — round(prob1*1000).
fn qbt_prob1_x1000(q: list) -> int
    let p = qbt_prob1(q)
    _qbt_round1000(p)

// qbt_is_normalized_x1000 — 1 if round(norm2*1000)==1000, else 0.
fn qbt_is_normalized_x1000(q: list) -> int
    let n2 = qbt_norm2(q)
    let r = _qbt_round1000(n2)
    if r == 1000
        return 1
    0
