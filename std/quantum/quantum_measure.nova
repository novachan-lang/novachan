// std/quantum/quantum_measure.nova — single-qubit measurement statistics over an n-qubit state.
// Imports std/quantum/quantum_state. PINNED API — other std/quantum modules import this module.
//
// Representation (matches quantum_state.nova):
//   COMPLEX number = 2-element list of floats [re, im].
//   n-QUBIT STATE  = flat list of 2^n complex amplitudes, big-endian (qubit 0 = MSB).
//
// Public API (prefix qms_):
//   qms_prob_qubit(state, q, outcome)        -> float  P(qubit q measures to `outcome`, 0/1)
//   qms_prob_qubit_x1000(state, q, outcome)  -> int    round(prob*1000)
//   qms_expect_z(state, q)                   -> float  <Z> on qubit q = P(0) - P(1)
//   qms_expect_z_x1000(state, q)             -> int    round(expect*1000)
//   qms_collapse(state, q, outcome)          -> list   post-measurement normalized state
//                                                       (unchanged input if outcome has 0 prob)
//   qms_probs(state)                         -> list   |amp|^2 for every basis state
//   qms_most_likely(state)                   -> int    basis index with highest |amp|^2 (ties -> smallest)
//   qms_prob_outcome_x1000(state, index)     -> int    round(|amp(index)|^2 * 1000)

import std/quantum/quantum_state

// ── internal helpers ────────────────────────────────────────────────────────

// _qms_round1000 — round x*1000 to the nearest int, handling negative x correctly.
fn _qms_round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

// ── qubit-level measurement statistics ──────────────────────────────────────

// qms_prob_qubit — P(qubit q measures to `outcome`) = sum of |amp(i)|^2 over
// every basis index i whose qubit-q bit equals `outcome`.
fn qms_prob_qubit(state: list, q: int, outcome: int) -> float
    let n = qst_num_qubits(state)
    let dim = qst_dim(state)
    let total = 0.0
    for i in 0..dim
        if qst_bit(i, n, q) == outcome
            let p = qst_prob(state, i)
            total = total + p
    total

// qms_prob_qubit_x1000 — round(qms_prob_qubit(...)*1000).
fn qms_prob_qubit_x1000(state: list, q: int, outcome: int) -> int
    let p = qms_prob_qubit(state, q, outcome)
    _qms_round1000(p)

// qms_expect_z — <Z> on qubit q = P(qubit q == 0) - P(qubit q == 1).
fn qms_expect_z(state: list, q: int) -> float
    let p0 = qms_prob_qubit(state, q, 0)
    let p1 = qms_prob_qubit(state, q, 1)
    let e = p0 - p1
    e

// qms_expect_z_x1000 — round(qms_expect_z(...)*1000).
fn qms_expect_z_x1000(state: list, q: int) -> int
    let e = qms_expect_z(state, q)
    _qms_round1000(e)

// qms_collapse — post-measurement state after observing qubit q == outcome:
// zero every amplitude whose qubit-q bit != outcome, then renormalize. If
// `outcome` has zero probability under `state`, the input is returned
// unchanged (documented — there is no valid post-measurement state to build).
fn qms_collapse(state: list, q: int, outcome: int) -> list
    let p = qms_prob_qubit(state, q, outcome)
    if p == 0.0
        return state
    let n = qst_num_qubits(state)
    let dim = qst_dim(state)
    let out = []
    for i in 0..dim
        if qst_bit(i, n, q) == outcome
            push(out, qst_amp(state, i))
        else
            push(out, qst_c(0.0, 0.0))
    qst_normalize(out)

// ── whole-state distribution ─────────────────────────────────────────────────

// qms_probs — |amp|^2 for every basis state (delegates to qst_to_probs).
fn qms_probs(state: list) -> list
    qst_to_probs(state)

// qms_most_likely — basis index with the highest |amp|^2. Ties resolve to
// the smallest index (strict `>` keeps the first index seen at the max).
fn qms_most_likely(state: list) -> int
    let dim = qst_dim(state)
    let best = 0
    let best_p = qst_prob(state, 0)
    for i in 1..dim
        let p = qst_prob(state, i)
        if p > best_p
            best_p = p
            best = i
    best

// qms_prob_outcome_x1000 — round(|amp(index)|^2 * 1000) for a single basis outcome.
fn qms_prob_outcome_x1000(state: list, index: int) -> int
    let p = qst_prob(state, index)
    _qms_round1000(p)
