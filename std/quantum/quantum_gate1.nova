// std/quantum/quantum_gate1.nova — single-qubit gate matrices + gate application.
// Imports std/quantum/quantum_state (complex numbers + n-qubit state vectors).
//
// Representation (matches quantum_state.nova):
//   COMPLEX number = 2-element list of floats [re, im].
//   GATE MATRIX    = 2x2 complex matrix as a list of 2 rows, each a list of 2
//                    complex numbers: [[c00,c01],[c10,c11]].
//
// Public API (prefix qg1_):
//   qg1_i()                      -> list  identity
//   qg1_x()                      -> list  Pauli-X
//   qg1_y()                      -> list  Pauli-Y
//   qg1_z()                      -> list  Pauli-Z
//   qg1_h()                      -> list  Hadamard
//   qg1_s()                      -> list  S (phase, sqrt(Z))
//   qg1_t()                      -> list  T (sqrt(S))
//   qg1_sdg()                    -> list  S dagger
//   qg1_tdg()                    -> list  T dagger
//   qg1_rx(theta)                -> list  rotation about X by theta radians
//   qg1_ry(theta)                -> list  rotation about Y by theta radians
//   qg1_rz(theta)                -> list  rotation about Z by theta radians
//   qg1_phase(theta)             -> list  diag(1, e^{i theta})
//   qg1_apply(state, gate, q)    -> list  apply a 2x2 gate matrix to qubit q of state
//   qg1_apply_x(state, q)        -> list  qg1_apply(state, qg1_x(), q)
//   qg1_apply_h(state, q)        -> list  qg1_apply(state, qg1_h(), q)
//   qg1_apply_z(state, q)        -> list  qg1_apply(state, qg1_z(), q)
//   qg1_apply_y(state, q)        -> list  qg1_apply(state, qg1_y(), q)
//   qg1_apply_s(state, q)        -> list  qg1_apply(state, qg1_s(), q)
//   qg1_apply_t(state, q)        -> list  qg1_apply(state, qg1_t(), q)

import std/quantum/quantum_state

// ── internal helpers ────────────────────────────────────────────────────────

// _qg1_mat — assemble a 2x2 gate matrix [[c00,c01],[c10,c11]] from 4 complex numbers.
fn _qg1_mat(c00: list, c01: list, c10: list, c11: list) -> list
    let row0 = []
    push(row0, c00)
    push(row0, c01)
    let row1 = []
    push(row1, c10)
    push(row1, c11)
    let m = []
    push(m, row0)
    push(m, row1)
    m

// ── gate matrix constructors ────────────────────────────────────────────────

// qg1_i — identity [[1,0],[0,1]].
fn qg1_i() -> list
    _qg1_mat(qst_c(1.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0, 0.0), qst_c(1.0, 0.0))

// qg1_x — Pauli-X [[0,1],[1,0]].
fn qg1_x() -> list
    _qg1_mat(qst_c(0.0, 0.0), qst_c(1.0, 0.0), qst_c(1.0, 0.0), qst_c(0.0, 0.0))

// qg1_y — Pauli-Y [[0,-i],[i,0]].
fn qg1_y() -> list
    _qg1_mat(qst_c(0.0, 0.0), qst_c(0.0, -1.0), qst_c(0.0, 1.0), qst_c(0.0, 0.0))

// qg1_z — Pauli-Z [[1,0],[0,-1]].
fn qg1_z() -> list
    _qg1_mat(qst_c(1.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0, 0.0), qst_c(-1.0, 0.0))

// qg1_h — Hadamard [[r,r],[r,-r]] with r = 1/sqrt(2).
fn qg1_h() -> list
    let r = 1.0 / sqrt(2.0)
    let nr = 0.0 - r
    _qg1_mat(qst_c(r, 0.0), qst_c(r, 0.0), qst_c(r, 0.0), qst_c(nr, 0.0))

// qg1_s — phase gate [[1,0],[0,i]].
fn qg1_s() -> list
    _qg1_mat(qst_c(1.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0, 1.0))

// qg1_sdg — S dagger [[1,0],[0,-i]].
fn qg1_sdg() -> list
    _qg1_mat(qst_c(1.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0, -1.0))

// qg1_t — T gate [[1,0],[0,e^{i pi/4}]].
fn qg1_t() -> list
    let PI = 3.14159265358979323846
    let a = PI / 4.0
    let cr = cos(a)
    let ci = sin(a)
    _qg1_mat(qst_c(1.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0, 0.0), qst_c(cr, ci))

// qg1_tdg — T dagger [[1,0],[0,e^{-i pi/4}]].
fn qg1_tdg() -> list
    let PI = 3.14159265358979323846
    let a = PI / 4.0
    let cr = cos(a)
    let si = sin(a)
    let ni = 0.0 - si
    _qg1_mat(qst_c(1.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0, 0.0), qst_c(cr, ni))

// qg1_rx — rotation about X: [[cos(t/2), -i sin(t/2)], [-i sin(t/2), cos(t/2)]].
fn qg1_rx(theta: float) -> list
    let h = theta / 2.0
    let c = cos(h)
    let s = sin(h)
    let ns = 0.0 - s
    _qg1_mat(qst_c(c, 0.0), qst_c(0.0, ns), qst_c(0.0, ns), qst_c(c, 0.0))

// qg1_ry — rotation about Y: [[cos(t/2), -sin(t/2)], [sin(t/2), cos(t/2)]].
fn qg1_ry(theta: float) -> list
    let h = theta / 2.0
    let c = cos(h)
    let s = sin(h)
    let ns = 0.0 - s
    _qg1_mat(qst_c(c, 0.0), qst_c(ns, 0.0), qst_c(s, 0.0), qst_c(c, 0.0))

// qg1_rz — rotation about Z: [[e^{-i t/2},0],[0,e^{i t/2}]].
fn qg1_rz(theta: float) -> list
    let h = theta / 2.0
    let c = cos(h)
    let s = sin(h)
    let ns = 0.0 - s
    _qg1_mat(qst_c(c, ns), qst_c(0.0, 0.0), qst_c(0.0, 0.0), qst_c(c, s))

// qg1_phase — diag(1, e^{i theta}).
fn qg1_phase(theta: float) -> list
    let cr = cos(theta)
    let ci = sin(theta)
    _qg1_mat(qst_c(1.0, 0.0), qst_c(0.0, 0.0), qst_c(0.0, 0.0), qst_c(cr, ci))

// ── core apply + convenience wrappers ───────────────────────────────────────

// qg1_apply — apply a 2x2 `gate` matrix to qubit `q` of an n-qubit `state`.
// For every basis index i with bit q == 0, let j be the index with bit q
// flipped (bit q == 1). The pair (amp[i], amp[j]) transforms as a 2-vector
// under `gate`: new[i] = g00*a0 + g01*a1, new[j] = g10*a0 + g11*a1.
// This is the single shared core used by every convenience wrapper below —
// it is written ONCE here and never duplicated.
fn qg1_apply(state: list, gate: list, q: int) -> list
    let n = qst_num_qubits(state)
    let dim = qst_dim(state)
    let out = [qst_amp(state, k) for k in 0..dim]
    let g00 = gate[0][0]
    let g01 = gate[0][1]
    let g10 = gate[1][0]
    let g11 = gate[1][1]
    for i in 0..dim
        if qst_bit(i, n, q) == 0
            let j = qst_flip_bit(i, n, q)
            let a0 = qst_amp(state, i)
            let a1 = qst_amp(state, j)
            let t0 = qst_cadd(qst_cmul(g00, a0), qst_cmul(g01, a1))
            let t1 = qst_cadd(qst_cmul(g10, a0), qst_cmul(g11, a1))
            out[i] = t0
            out[j] = t1
    out

// qg1_apply_x — apply Pauli-X to qubit q.
fn qg1_apply_x(state: list, q: int) -> list
    qg1_apply(state, qg1_x(), q)

// qg1_apply_h — apply Hadamard to qubit q.
fn qg1_apply_h(state: list, q: int) -> list
    qg1_apply(state, qg1_h(), q)

// qg1_apply_z — apply Pauli-Z to qubit q.
fn qg1_apply_z(state: list, q: int) -> list
    qg1_apply(state, qg1_z(), q)

// qg1_apply_y — apply Pauli-Y to qubit q.
fn qg1_apply_y(state: list, q: int) -> list
    qg1_apply(state, qg1_y(), q)

// qg1_apply_s — apply the S gate to qubit q.
fn qg1_apply_s(state: list, q: int) -> list
    qg1_apply(state, qg1_s(), q)

// qg1_apply_t — apply the T gate to qubit q.
fn qg1_apply_t(state: list, q: int) -> list
    qg1_apply(state, qg1_t(), q)
