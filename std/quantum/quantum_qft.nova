// std/quantum/quantum_qft.nova — Quantum Fourier Transform as a direct matrix
// transform on the amplitude vector (NOT via gates).
// FOUNDATION-ONLY: imports quantum_state only. The QFT is computed by its closed-form
// DFT-matrix definition, not by composing rotation/Hadamard gates.
//
// Representation (matches quantum_state.nova — PINNED across std/quantum):
//   COMPLEX number  = 2-element list of floats [re, im].
//   n-QUBIT STATE   = flat list of N=2^n complex amplitudes, BIG-ENDIAN (qubit 0 = MSB).
//
// Definition: QFT maps amplitude vector x (length N) to y where
//   y[k] = (1/sqrt(N)) * sum_{j=0}^{N-1} x[j] * omega^(j*k),   omega = e^(2*pi*i/N)
// The inverse QFT uses omega^(-j*k) with the same 1/sqrt(N) normalization (the QFT
// matrix is unitary, so its inverse is its conjugate transpose).
//
// Public API (prefix qft_):
//   qft_omega(N, power)              -> list  complex omega^power = e^(2*pi*i*power/N)
//   qft_apply(state)                 -> list  QFT of `state` (n taken from qst_num_qubits)
//   qft_inverse(state)               -> list  inverse QFT of `state`
//   qft_matrix_entry_x1000_re(N,r,c) -> int   round(Re(omega^(r*c))/sqrt(N) * 1000) —
//                                              a single testable QFT-matrix-entry probe

import std/quantum/quantum_state

// ── internal helpers ────────────────────────────────────────────────────────

// _qft_round1000 — round x*1000 to the nearest int, handling negative x correctly.
fn _qft_round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

// _qft_inv_sqrt_n — 1/sqrt(N), the QFT normalization factor. Shared by the transform
// engine and the matrix-entry probe (anti-duplication).
fn _qft_inv_sqrt_n(N: int) -> float
    let nf = N * 1.0
    let s = sqrt(nf)
    let r = 1.0 / s
    r

// qft_omega — the complex root of unity omega^power, omega = e^(2*pi*i/N):
// [cos(2*pi*power/N), sin(2*pi*power/N)].
fn qft_omega(N: int, power: int) -> list
    let PI = pi()
    let nf = N * 1.0
    let pf = power * 1.0
    let angle = 2.0 * PI * pf / nf
    let cv = cos(angle)
    let sv = sin(angle)
    qst_c(cv, sv)

// _qft_transform — shared DFT engine for qft_apply/qft_inverse. `fwd`=1 computes the
// forward QFT (exponent +j*k), `fwd`=0 the inverse (exponent -j*k). Forward and inverse
// differ only in the sign of the exponent, so they share this one nested loop
// (anti-duplication: no separate near-identical forward/inverse loop bodies).
fn _qft_transform(state: list, fwd: int) -> list
    let N = len(state)
    let invsqrtn = _qft_inv_sqrt_n(N)
    let y = []
    let k = 0
    while k < N
        let acc = qst_c(0.0, 0.0)
        let j = 0
        while j < N
            let jk = (j * k) % N
            let power = jk
            if fwd == 0
                power = (N - jk) % N
            let w = qft_omega(N, power)
            let term = qst_cmul(state[j], w)
            acc = qst_cadd(acc, term)
            j += 1
        push(y, qst_cscale(acc, invsqrtn))
        k += 1
    y

// qft_apply — apply the QFT to `state`: y[k] = (1/sqrt(N)) * sum_j x[j]*omega^(j*k).
fn qft_apply(state: list) -> list
    _qft_transform(state, 1)

// qft_inverse — apply the inverse QFT to `state`: y[k] = (1/sqrt(N)) * sum_j x[j]*omega^(-j*k).
fn qft_inverse(state: list) -> list
    _qft_transform(state, 0)

// qft_matrix_entry_x1000_re — round(Re(omega^(r*c))/sqrt(N) * 1000): a single testable
// probe into entry (r,c) of the NxN QFT matrix.
fn qft_matrix_entry_x1000_re(N: int, r: int, c: int) -> int
    let rc = (r * c) % N
    let w = qft_omega(N, rc)
    let invsqrtn = _qft_inv_sqrt_n(N)
    let re = w[0] * invsqrtn
    _qft_round1000(re)
