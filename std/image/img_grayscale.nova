// std/image/img_grayscale.nova — RGB <-> grayscale conversion.
//
// Image model: grayscale = flat list of ints 0..255, length w*h, row-major.
//              RGB       = flat list of ints 0..255, length w*h*3, triples [r,g,b].
//
// API:
//   rgb_to_gray(rgb_px, w, h) -> list   luminance: (r*299 + g*587 + b*114) / 1000
//   gray_to_rgb(gray_px)      -> list   replicate each gray value as [g,g,g]

// rgb_to_gray: convert RGB pixel list to grayscale using ITU-601 luminance weights.
// rgb_px must have length w*h*3. Returns list of length w*h.
fn rgb_to_gray(rgb_px: list, w: int, h: int) -> list
    let out = []
    let n = w * h
    for i in 0..n
        let base = i * 3
        let r = rgb_px[base]
        let g = rgb_px[base + 1]
        let b = rgb_px[base + 2]
        let lum = (r * 299 + g * 587 + b * 114) / 1000
        out.push(lum)
    out

// gray_to_rgb: replicate each grayscale value into [g, g, g] RGB triples.
// Returns list of length 3*len(gray_px).
fn gray_to_rgb(gray_px: list) -> list
    let out = []
    let n = len(gray_px)
    for i in 0..n
        let g = gray_px[i]
        out.push(g)
        out.push(g)
        out.push(g)
    out
