// std/image/img_quantize.nova — Grayscale quantization and posterization.
// LEAF — imports NOTHING.
//
// Image model: flat list of ints 0..255 (no spatial dimensions needed here).
//
// Public API:
//   img_quantize(px, levels) -> list
//       Map each pixel value to the nearest of 'levels' evenly-spaced values
//       spanning 0..255.  For levels=1, every pixel maps to 0.
//       For levels=N (N>=2): palette = [0, 255/(N-1), 2*255/(N-1), ..., 255].
//       Nearest is determined by minimum absolute distance.
//   img_posterize(px, bits) -> list
//       Reduce each pixel to 'bits' bits per channel.
//       Equivalent to img_quantize(px, 2^bits).
//       bits=1 -> 2 levels (0 or 255), bits=8 -> 256 levels (identity).
//
// FLOAT HAZARDS obeyed:
//   * abs(float)/abs(int) not used for floats — use if/else for float abs.
//   * No bare multi-term float return — bind to named lets.
//   * Integer division for ints; explicit *1.0 for floats.

// _qtz_nearest — map int pixel value v (0..255) to nearest palette value.
// palette_step is 255.0 / (levels-1) when levels >= 2.
// For levels=1, always returns 0.
fn _qtz_nearest(v: int, levels: int) -> int
    if levels <= 1
        return 0
    let stepf = 255.0 / ((levels - 1) * 1.0)
    let vf = v * 1.0
    // Find nearest palette index: round(v / step) clamped to [0, levels-1].
    let idx_raw = vf / stepf
    let idx = float_to_int(idx_raw + 0.5)
    if idx < 0
        idx = 0
    if idx >= levels
        idx = levels - 1
    // Palette value at index.
    let palv_f = idx * 1.0 * stepf
    let palv = float_to_int(palv_f + 0.5)
    // Clamp to [0, 255].
    if palv < 0
        palv = 0
    if palv > 255
        palv = 255
    palv

// img_quantize — reduce each pixel to the nearest of 'levels' evenly-spaced values.
// levels=1  -> all pixels become 0.
// levels=2  -> 0 or 255.
// levels=4  -> 0, 85, 170, 255.
// levels=256 -> identity (each value maps to itself).
fn img_quantize(px: list, levels: int) -> list
    let out = []
    let n = len(px)
    let i = 0
    while i < n
        let pv = px[i]
        let qv = _qtz_nearest(pv, levels)
        out.push(qv)
        i = i + 1
    out

// _qtz_pow2 — compute 2^bits using repeated multiplication (bits is small, 1..8).
fn _qtz_pow2(bits: int) -> int
    let result = 1
    let k = 0
    while k < bits
        result = result * 2
        k = k + 1
    result

// img_posterize — reduce pixel depth to 'bits' bits (1..8).
// Equivalent to img_quantize(px, 2^bits).
// bits=1 -> 2 levels (0 or 255).
// bits=2 -> 4 levels.
// bits=8 -> 256 levels (identity).
fn img_posterize(px: list, bits: int) -> list
    let levels = _qtz_pow2(bits)
    img_quantize(px, levels)
