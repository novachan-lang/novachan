// std/image/img_crop.nova — Grayscale image crop and padding.
//
// IMAGE MODEL:
//   Grayscale image = flat list of ints 0..255 in row-major order.
//   Pixel at (row, col) is px[row * w + col].
//
// API:
//   img_crop(px, w, h, x, y, cw, ch) -> list
//       Extract a cw x ch sub-image starting at column x, row y.
//   img_pad(px, w, h, pad, value) -> list
//       Add a border of 'value' pixels around the image, 'pad' pixels wide.
//       Result size: (w + 2*pad) x (h + 2*pad).

// img_crop: extract a cw x ch region starting at (col=x, row=y).
// Returns a new flat list of cw*ch pixels in row-major order.
fn img_crop(px: list, w: int, h: int, x: int, y: int, cw: int, ch: int) -> list
    let out = []
    for row in 0..ch
        let col = 0
        while col < cw
            let src_row = y + row
            let src_col = x + col
            let idx = src_row * w + src_col
            let pv = px[idx]
            out.push(pv)
            col = col + 1
    out

// img_pad: add a border of 'pad' pixels with value 'value' around the image.
// New width = w + 2*pad, new height = h + 2*pad.
fn img_pad(px: list, w: int, h: int, pad: int, value: int) -> list
    let nw = w + 2 * pad
    let nh = h + 2 * pad
    let total = nw * nh
    let out = []
    // Pre-fill with value
    for i in 0..total
        out.push(value)
    // Copy source pixels into the interior
    for row in 0..h
        let col = 0
        while col < w
            let src_idx = row * w + col
            let dst_row = row + pad
            let dst_col = col + pad
            let dst_idx = dst_row * nw + dst_col
            let pv = px[src_idx]
            out[dst_idx] = pv
            col = col + 1
    out
