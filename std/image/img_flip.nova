// std/image/img_flip.nova — Horizontal and vertical flip for grayscale images.
//
// IMAGE MODEL: flat list of ints 0..255 in row-major order.
// Pixel at (row, col) is px[row*w + col].
//
// API:
//   img_flip_h(px, w, h) -> list   mirror each row left-right
//   img_flip_v(px, w, h) -> list   reverse row order top-bottom

// img_flip_h: mirror each row left-right.
// For each row r, column c maps to column (w-1-c).
fn img_flip_h(px, w, h)
    let out = []
    let r = 0
    while r < h
        let c = 0
        while c < w
            let src = r * w + (w - 1 - c)
            let v = px[src]
            out.push(v)
            c = c + 1
        r = r + 1
    out

// img_flip_v: reverse row order top-bottom.
// Row r in output comes from row (h-1-r) in input.
fn img_flip_v(px, w, h)
    let out = []
    let r = 0
    while r < h
        let src_row = h - 1 - r
        let c = 0
        while c < w
            let src = src_row * w + c
            let v = px[src]
            out.push(v)
            c = c + 1
        r = r + 1
    out
