// std/image/resize.nova — Nearest-neighbor resize, crop, and flips for
// grayscale images.
//
// IMAGE MODEL: flat list of ints 0..255 in row-major order.
// Pixel at (row, col) is px[row*w + col].
//
// PREFIX: ir_  (private helpers: _ir_)
//
// Every indexed read of the source pixel list is bounds-checked; out-of-range
// source coordinates (crop past an edge, an undersized pixel list) read as 0
// rather than reading out of bounds.
//
// API:
//   ir_resize_nn(pixels, src_w, src_h, dst_w, dst_h) -> list  nearest-neighbor resize
//   ir_crop(pixels, w, h, x, y, cw, ch)               -> list  crop region [x,y,cw,ch]
//   ir_flip_h(pixels, w, h)                           -> list  mirror left-right
//   ir_flip_v(pixels, w, h)                           -> list  mirror top-bottom

// ── private helpers ──────────────────────────────────────────────────────────

// _ir_ifloor: float -> int, truncation (floor for non-negative floats).
fn _ir_ifloor(f: float) -> int
    float_to_int(f)

// _ir_safe_read: read pixels[idx] if in-range, else 0.
fn _ir_safe_read(pixels: list, idx: int, n: int) -> int
    let v = 0
    if idx >= 0 and idx < n
        v = pixels[idx]
    v

// ── resize ────────────────────────────────────────────────────────────────────

// ir_resize_nn: scale an src_w x src_h image to dst_w x dst_h using
// nearest-neighbor sampling. For output pixel (r,c):
//   src_r = floor(r * src_h / dst_h),  src_c = floor(c * src_w / dst_w)
// Degenerate dst_w==0 or dst_h==0 returns [] (the generating loops never run,
// so no division by zero is ever evaluated).
fn ir_resize_nn(pixels: list, src_w: int, src_h: int, dst_w: int, dst_h: int) -> list
    let out = []
    let n = len(pixels)
    let fsw = src_w * 1.0
    let fsh = src_h * 1.0
    let fdw = dst_w * 1.0
    let fdh = dst_h * 1.0
    for r in 0..dst_h
        let fr = r * 1.0
        let sy_f = fr * fsh
        let sy_frac = sy_f / fdh
        let sy = _ir_ifloor(sy_frac)
        if sy < 0
            sy = 0
        if sy >= src_h
            sy = src_h - 1
        let c = 0
        while c < dst_w
            let fc = c * 1.0
            let sx_f = fc * fsw
            let sx_frac = sx_f / fdw
            let sx = _ir_ifloor(sx_frac)
            if sx < 0
                sx = 0
            if sx >= src_w
                sx = src_w - 1
            let idx = sy * src_w + sx
            let v = _ir_safe_read(pixels, idx, n)
            out.push(v)
            c += 1
    out

// ── crop ──────────────────────────────────────────────────────────────────────

// ir_crop: extract a cw x ch region starting at (x,y). Source coordinates
// outside [0,w) x [0,h) read as 0 (out-of-frame padding), never out-of-bounds.
fn ir_crop(pixels: list, w: int, h: int, x: int, y: int, cw: int, ch: int) -> list
    let out = []
    let n = len(pixels)
    for ry in 0..ch
        let sy = y + ry
        let rx = 0
        while rx < cw
            let sx = x + rx
            let v = 0
            if sx >= 0 and sx < w and sy >= 0 and sy < h
                let idx = sy * w + sx
                v = _ir_safe_read(pixels, idx, n)
            out.push(v)
            rx += 1
    out

// ── flips ─────────────────────────────────────────────────────────────────────

// ir_flip_h: mirror each row left-right.
fn ir_flip_h(pixels: list, w: int, h: int) -> list
    let out = []
    let n = len(pixels)
    for r in 0..h
        let c = 0
        while c < w
            let sc = w - 1 - c
            let idx = r * w + sc
            let v = _ir_safe_read(pixels, idx, n)
            out.push(v)
            c += 1
    out

// ir_flip_v: mirror rows top-bottom.
fn ir_flip_v(pixels: list, w: int, h: int) -> list
    let out = []
    let n = len(pixels)
    for r in 0..h
        let sr = h - 1 - r
        let c = 0
        while c < w
            let idx = sr * w + c
            let v = _ir_safe_read(pixels, idx, n)
            out.push(v)
            c += 1
    out
