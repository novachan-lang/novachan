// std/image/img_histogram.nova — Grayscale image histogram and equalization.
//
// IMAGE MODEL:
//   Grayscale image = flat list of ints 0..255 in row-major order.
//
// API:
//   img_histogram(px) -> list
//       Returns 256-element count array: hist[v] = number of pixels with value v.
//   hist_min(px) -> int
//       Minimum pixel value in the image.
//   hist_max(px) -> int
//       Maximum pixel value in the image.
//   hist_mean(px) -> int
//       Integer mean pixel value (floor of sum/count).
//   img_equalize(px) -> list
//       Histogram equalization: remap pixel values so the CDF is linear.
//       For a uniform-intensity image, output equals input.

// img_histogram: count occurrences of each pixel value 0..255.
fn img_histogram(px: list) -> list
    // Build 256-element array initialized to 0
    let hist = []
    for i in 0..256
        hist.push(0)
    // Count pixels
    let n = len(px)
    for j in 0..n
        let v = px[j]
        hist[v] = hist[v] + 1
    hist

// hist_min: minimum pixel value present in the image.
fn hist_min(px: list) -> int
    let n = len(px)
    let mn = 255
    for i in 0..n
        let v = px[i]
        if v < mn
            mn = v
    mn

// hist_max: maximum pixel value present in the image.
fn hist_max(px: list) -> int
    let n = len(px)
    let mx = 0
    for i in 0..n
        let v = px[i]
        if v > mx
            mx = v
    mx

// hist_mean: integer mean (floor of sum/count).
fn hist_mean(px: list) -> int
    let n = len(px)
    let sum = 0
    let i = 0
    while i < n
        sum = sum + px[i]
        i = i + 1
    let result = 0
    if n > 0
        result = sum / n
    result

// img_equalize: histogram equalization.
// Algorithm:
//   1. Compute histogram.
//   2. Compute CDF (cumulative distribution function).
//   3. Find cdf_min = first non-zero CDF value.
//   4. Apply equalization formula:
//      eq(v) = round((cdf(v) - cdf_min) / (n - cdf_min) * 255)
//      where n = total number of pixels.
//   For a uniform image, all pixels have the same value, CDF is a step function,
//   and the equalized output equals the input.
fn img_equalize(px: list) -> list
    let n = len(px)
    // Degenerate: empty image
    let out = []
    if n == 0
        out
    if n > 0
        let hist = img_histogram(px)
        // Build CDF: cdf[i] = sum of hist[0..i]
        let cdf = []
        let running = 0
        for k in 0..256
            running = running + hist[k]
            cdf.push(running)
        // Find cdf_min: the smallest non-zero CDF value
        let cdf_min = n
        for m in 0..256
            let cv = cdf[m]
            if cv > 0
                if cv < cdf_min
                    cdf_min = cv
        // denominator = n - cdf_min; if 0 return input unchanged
        let denom = n - cdf_min
        if denom == 0
            // All pixels same value: output == input
            for ii in 0..n
                out.push(px[ii])
        if denom > 0
            // Build lookup table
            let lut = []
            for p in 0..256
                let cv = cdf[p]
                // eq = round((cv - cdf_min) * 255 / denom)
                let num = (cv - cdf_min) * 255
                // integer round: (num + denom/2) / denom
                let half = denom / 2
                let eq = (num + half) / denom
                if eq < 0
                    eq = 0
                if eq > 255
                    eq = 255
                lut.push(eq)
            // Map pixels through LUT
            for qi in 0..n
                let pv = px[qi]
                let ev = lut[pv]
                out.push(ev)
    out
