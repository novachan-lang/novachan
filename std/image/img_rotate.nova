// std/image/img_rotate.nova — 90/180/270-degree clockwise rotations for grayscale images.
//
// IMAGE MODEL: flat list of ints 0..255 in row-major order.
// Pixel at (row, col) is px[row*w + col].
//
// Clockwise 90: new image is h x w (new_w=h, new_h=w).
//   dst[c][h-1-r]  <-  src[r][c]
//   i.e. dst_row=c, dst_col=h-1-r  => dst[c*(h) + (h-1-r)] = src[r*w + c]
//   Equivalently: out pixel at (dst_r, dst_c) = src[(h-1-dst_c)*w + dst_r]
//   where dst_r in [0, w), dst_c in [0, h)
//
// API:
//   img_rotate_90(px, w, h)  -> list  clockwise 90, new dims h x w
//   img_rotate_180(px, w, h) -> list  180 degrees, same dims w x h
//   img_rotate_270(px, w, h) -> list  clockwise 270 (=ccw 90), new dims h x w

// img_rotate_90: clockwise 90 degrees.
// Output image has new_w=h, new_h=w.
// dst(r,c) = src(h-1-c, r)   where r in [0,w), c in [0,h)
fn img_rotate_90(px, w, h)
    let out = []
    // new_w = h, new_h = w
    let r = 0
    while r < w
        let c = 0
        while c < h
            let src_row = h - 1 - c
            let src_col = r
            let src = src_row * w + src_col
            let v = px[src]
            out.push(v)
            c = c + 1
        r = r + 1
    out

// img_rotate_180: 180 degrees (same dims).
// dst(r,c) = src(h-1-r, w-1-c)
fn img_rotate_180(px, w, h)
    let out = []
    let r = 0
    while r < h
        let c = 0
        while c < w
            let src_row = h - 1 - r
            let src_col = w - 1 - c
            let src = src_row * w + src_col
            let v = px[src]
            out.push(v)
            c = c + 1
        r = r + 1
    out

// img_rotate_270: clockwise 270 (= counter-clockwise 90).
// Output image has new_w=h, new_h=w.
// dst(r,c) = src(c, w-1-r)   where r in [0,w), c in [0,h)
fn img_rotate_270(px, w, h)
    let out = []
    // new_w = h, new_h = w
    let r = 0
    while r < w
        let c = 0
        while c < h
            let src_row = c
            let src_col = w - 1 - r
            let src = src_row * w + src_col
            let v = px[src]
            out.push(v)
            c = c + 1
        r = r + 1
    out
