// std/permutation/perm_inverse.nova — inverse permutation and related tests.
// LEAF — imports NOTHING.
//
// A permutation of {0..n-1} is a list p where p[i] is the image of i.
// The inverse inv satisfies inv[p[i]] = i for all i.
//
// Public API:
//   pi_inverse(p)                      -> list  inverse permutation of p
//   pi_is_involution(p)                -> bool  true iff p equals its own inverse (p^2 = id)
//   pi_compose_inverse_is_identity(p)  -> bool  sanity: p composed with inv(p) gives identity

// pi_inverse — compute the inverse of permutation p: inv[p[i]] = i.
fn pi_inverse(p) -> any
    let n = len(p)
    let inv = [0 for i in 0..n]
    for j in 0..n
        inv[p[j]] = j
    inv

// _pi_equal — true iff two lists of the same length are element-wise equal.
fn _pi_equal(a, b) -> bool
    let n = len(a)
    if n != len(b)
        return false
    let i = 0
    while i < n
        if a[i] != b[i]
            return false
        i += 1
    true

// _pi_compose — (p after q)[i] = p[q[i]]; used internally for sanity check.
fn _pi_compose(p, q) -> any
    let n = len(q)
    let r = []
    for i in 0..n
        push(r, p[q[i]])
    r

// _pi_identity — identity permutation [0,1,...,n-1] for internal use.
fn _pi_identity(n: int) -> any
    let r = []
    let i = 0
    while i < n
        push(r, i)
        i += 1
    r

// pi_is_involution — true iff p equals its own inverse, i.e. p(p(i)) = i for all i.
fn pi_is_involution(p) -> bool
    let inv = pi_inverse(p)
    _pi_equal(p, inv)

// pi_compose_inverse_is_identity — sanity check: p composed with inv(p) is the identity.
fn pi_compose_inverse_is_identity(p) -> bool
    let inv = pi_inverse(p)
    let composed = _pi_compose(p, inv)
    let id = _pi_identity(len(p))
    _pi_equal(composed, id)
