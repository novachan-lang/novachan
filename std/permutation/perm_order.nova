// std/permutation/perm_order.nova — order of a permutation in the symmetric group.
// LEAF — imports NOTHING. Permutation p is a list, p[i] = image of i (0-indexed).
//
// Public API:
//   po_order(p)         -> int   order of p (LCM of its cycle lengths)
//   po_is_order(p, k)   -> bool  true iff k is exactly the order of p
//   po_power_order(p,k) -> int   order of p^k

// _po_gcd — greatest common divisor via Euclidean algorithm (both args non-negative)
fn _po_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = y
        y = x - (x / y) * y
        x = t
    x

// _po_lcm — least common multiple of two non-negative integers
fn _po_lcm(a: int, b: int) -> int
    if a == 0 or b == 0
        return 0
    let g = _po_gcd(a, b)
    a / g * b

// _po_copy_visited — allocate a visited array of n zeros
fn _po_make_visited(n: int) -> any
    let vis = [0 for i in 0..n]
    vis

// po_order — order of permutation p = LCM of its cycle lengths.
// Identity (fixed point) cycles of length 1 contribute 1 to the LCM and are correct.
// po_order([]) = 1 (empty permutation is the identity; LCM of empty set = 1).
fn po_order(p) -> int
    let n = len(p)
    if n == 0
        return 1
    let vis = _po_make_visited(n)
    let result = 1
    let i = 0
    while i < n
        if vis[i] == 0
            // walk the cycle starting at i
            let clen = 0
            let j = i
            while vis[j] == 0
                vis[j] = 1
                j = p[j]
                clen = clen + 1
            result = _po_lcm(result, clen)
        i = i + 1
    result

// po_is_order — true iff k is exactly the order of p (p^k = identity AND k is minimal).
fn po_is_order(p, k: int) -> bool
    po_order(p) == k

// _po_compose_once — compose q after r: result[i] = q[r[i]]
fn _po_compose_once(q, r) -> any
    let n = len(q)
    let out = []
    for i in 0..n
        push(out, q[r[i]])
    out

// _po_copy — shallow copy of list p
fn _po_copy(p) -> any
    let out = []
    let i = 0
    let n = len(p)
    while i < n
        push(out, p[i])
        i = i + 1
    out

// _po_power — p^k by repeated squaring (k >= 0)
fn _po_power(p, k: int) -> any
    let n = len(p)
    // start with identity
    let acc = [i for i in 0..n]
    let base = _po_copy(p)
    let exp = k
    while exp > 0
        if exp - (exp / 2) * 2 == 1
            acc = _po_compose_once(base, acc)
        base = _po_compose_once(base, base)
        exp = exp / 2
    acc

// po_power_order — order of p^k in the group.
// By group theory: order(p^k) = order(p) / gcd(order(p), k).
fn po_power_order(p, k: int) -> int
    let ord = po_order(p)
    if ord == 0
        return 1
    let g = _po_gcd(ord, k)
    ord / g
