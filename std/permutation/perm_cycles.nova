// std/permutation/perm_cycles.nova — cycle decomposition of a permutation.
// LEAF — imports NOTHING.
//
// A permutation of {0..n-1} is a list p where p[i] is the image of i.
// Cycle decomposition: every permutation splits uniquely into disjoint cycles.
// Fixed points (p[i] == i) appear as 1-cycles.
// Canonical form: each cycle starts with its smallest element;
// cycles are ordered by their first (smallest) element ascending.
//
// Public API:
//   pcy_cycles(p)         -> list  cycle decomposition (list of lists)
//   pcy_cycle_count(p)    -> int   number of cycles (including 1-cycles)
//   pcy_cycle_lengths(p)  -> list  lengths of cycles in canonical cycle order
//   pcy_cycle_type(p)     -> list  multiset of cycle lengths sorted ascending

// _pcy_sort_asc — insertion sort of an int list ascending; returns sorted copy.
fn _pcy_sort_asc(xs) -> any
    let n = len(xs)
    let a = [xs[k] for k in 0..n]
    let i = 1
    while i < n
        let key = a[i]
        let j = i - 1
        while j >= 0 and a[j] > key
            a[j + 1] = a[j]
            j = j - 1
        a[j + 1] = key
        i = i + 1
    a

// pcy_cycles — canonical cycle decomposition of p including fixed-point 1-cycles.
// Each cycle is rotated so its minimum element is first; cycles sorted by first element.
fn pcy_cycles(p) -> any
    let n = len(p)
    // visited[i] = 1 once element i has been assigned to a cycle
    let visited = [0 for k in 0..n]
    let cycles = []
    let start = 0
    while start < n
        if visited[start] == 0
            // Trace the cycle beginning at 'start'
            let cycle = []
            let cur = start
            while visited[cur] == 0
                visited[cur] = 1
                push(cycle, cur)
                cur = p[cur]
            // Rotate cycle so its minimum element is first.
            // Find index of minimum in cycle.
            let min_val = cycle[0]
            let min_idx = 0
            for m in 1..len(cycle)
                if cycle[m] < min_val
                    min_val = cycle[m]
                    min_idx = m
            // Build rotated cycle
            let rotated = [cycle[(min_idx + ci) % len(cycle)] for ci in 0..len(cycle)]
            push(cycles, rotated)
        start = start + 1
    // Sort cycles by their first (minimum) element ascending.
    // Since we iterate start from 0..n-1 and always begin a cycle at the first
    // unvisited element, AND we rotate each cycle so its minimum is first,
    // the cycles are naturally produced in ascending order of their minimum element.
    // (The start of each new cycle is the smallest element not yet visited, which
    //  IS the minimum of that cycle because all smaller elements were already visited.)
    // So no explicit sort is needed; cycles are already in canonical order.
    cycles

// pcy_cycle_count — number of cycles in the cycle decomposition (including 1-cycles).
fn pcy_cycle_count(p) -> int
    let cs = pcy_cycles(p)
    len(cs)

// pcy_cycle_lengths — lengths of cycles in canonical order (matching pcy_cycles order).
fn pcy_cycle_lengths(p) -> any
    let cs = pcy_cycles(p)
    let result = [len(cs[i]) for i in 0..len(cs)]
    result

// pcy_cycle_type — multiset of cycle lengths sorted ascending (the partition of n).
fn pcy_cycle_type(p) -> any
    let lengths = pcy_cycle_lengths(p)
    _pcy_sort_asc(lengths)
