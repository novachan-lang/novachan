// std/permutation/perm_apply.nova — apply a permutation to a list or string.
// LEAF — imports NOTHING. Permutation p is a list, p[i] = image of i (0-indexed).
// Gather (pa_apply): result[i] = a[p[i]]  — "where does position i come FROM?"
// Scatter (pa_apply_inverse): result[p[i]] = a[i]  — "where does element i GO?"
//
// Public API:
//   pa_apply(p, a)          -> list   gather: result[i] = a[p[i]]
//   pa_apply_inverse(p, a)  -> list   scatter: result[p[i]] = a[i]
//   pa_apply_string(p, s)   -> string gather-permute characters of s

// pa_apply — gather permutation: result[i] = a[p[i]].
// Rearranges list a so that position i receives the element at position p[i].
fn pa_apply(p, a) -> any
    let n = len(p)
    let result = [a[p[i]] for i in 0..n]
    result

// _pa_make_zeros — allocate a list of n zeros (placeholder for scatter output)
fn _pa_make_zeros(n: int) -> any
    let out = []
    for i in 0..n
        push(out, 0)
    out

// pa_apply_inverse — scatter permutation: result[p[i]] = a[i].
// Equivalent to applying the INVERSE permutation via gather.
fn pa_apply_inverse(p, a) -> any
    let n = len(p)
    let result = _pa_make_zeros(n)
    for i in 0..n
        result[p[i]] = a[i]
    result

// pa_apply_string — gather-permute characters of string s by permutation p.
// result[i] = s[p[i]] (character at position p[i] moves to position i).
// Uses slice(s, idx, idx+1) to extract the character at each permuted index.
fn pa_apply_string(p, s: string) -> string
    let n = len(p)
    let result_parts = []
    for i in 0..n
        let idx = p[i]
        push(result_parts, slice(s, idx, idx + 1))
    let result = join(result_parts, "")
    result
