// std/permutation/perm_sign.nova — sign (parity) of a permutation.
// LEAF — imports NOTHING. Permutation p is a list, p[i] = image of i (0-indexed).
// Sign = (-1)^(n - number_of_cycles). A transposition has sign -1; even perms have +1.
//
// Public API:
//   ps_sign(p)    -> int   +1 (even permutation) or -1 (odd permutation)
//   ps_parity(p)  -> int   0 (even) or 1 (odd)
//   ps_is_even(p) -> bool  true iff permutation is even

// _ps_make_visited — allocate a visited array of n zeros
fn _ps_make_visited(n: int) -> any
    let vis = [0 for i in 0..n]
    vis

// _ps_cycle_count — number of cycles in permutation p (including fixed points as 1-cycles)
fn _ps_cycle_count(p) -> int
    let n = len(p)
    if n == 0
        return 0
    let vis = _ps_make_visited(n)
    let cycles = 0
    for i in 0..n
        if vis[i] == 0
            cycles += 1
            let j = i
            while vis[j] == 0
                vis[j] = 1
                j = p[j]
    cycles

// ps_sign — sign of permutation p: +1 if even, -1 if odd.
// sign = (-1)^(n - number_of_cycles). Empty permutation is even (+1).
fn ps_sign(p) -> int
    let n = len(p)
    if n == 0
        return 1
    let c = _ps_cycle_count(p)
    let exp = n - c
    // even exponent -> +1; odd -> -1
    if exp - (exp / 2) * 2 == 0
        return 1
    return -1

// ps_parity — 0 if even permutation, 1 if odd.
fn ps_parity(p) -> int
    if ps_sign(p) == 1
        return 0
    return 1

// ps_is_even — true iff p is an even permutation.
fn ps_is_even(p) -> bool
    ps_sign(p) == 1
