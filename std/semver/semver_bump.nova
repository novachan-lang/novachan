// std/semver/semver_bump.nova — SemVer 2.0.0 version-bump helpers.
//
// Parses a version string into [major, minor, patch, prerelease, build]
// (prerelease and build are '' when absent), increments the requested
// component per SemVer §8, and returns a canonicalised "X.Y.Z" string.
// Prerelease and build metadata are ALWAYS dropped on any bump (§8).
//
// Public API (prefix svb_):
//   svb_major(v)       — bump major, reset minor+patch to 0, drop pre+build
//   svb_minor(v)       — bump minor, reset patch to 0, drop pre+build
//   svb_patch(v)       — bump patch, drop pre+build
//   svb_bump(v, kind)  — dispatch on kind in {"major","minor","patch"}
//
// KAT vectors (§8, hand-verified):
//   svb_major("1.2.3")       = "2.0.0"   (1+1=2, reset)
//   svb_minor("1.2.3")       = "1.3.0"   (2+1=3, reset patch)
//   svb_patch("1.2.3")       = "1.2.4"   (3+1=4)
//   svb_major("1.2.3-alpha") = "2.0.0"   (pre dropped)
//   svb_minor("1.0.0")       = "1.1.0"
//   svb_bump("1.2.3","patch")= "1.2.4"
//   svb_patch("1.2.3-rc")    = "1.2.4"   (pre dropped)

// Parse a non-negative decimal integer from string s.
// Returns 0 on empty or malformed input.
fn _svb_parse_int(s) -> int
    let n = len(s)
    let i = 0
    let v = 0
    while i < n
        let ch = slice(s, i, i + 1)
        let d = ord(ch) - 48
        if d >= 0 and d <= 9
            v = v * 10 + d
        i = i + 1
    return v

// Parse "MAJOR.MINOR.PATCH[-prerelease][+build]" into a 5-element list
// [major(int), minor(int), patch(int), prerelease(str), build(str)].
// Malformed or missing components default to 0 / ''.
fn _svb_parse(s) -> list
    let core = s
    let pre = ""
    let build = ""
    let plen = len(s)
    let pi = 0
    while pi < plen
        if slice(s, pi, pi + 1) == "+"
            build = slice(s, pi + 1, plen)
            core = slice(s, 0, pi)
            plen = pi
        pi = pi + 1
    let dlen = len(core)
    let di = 0
    while di < dlen
        if slice(core, di, di + 1) == "-"
            pre = slice(core, di + 1, dlen)
            core = slice(core, 0, di)
            di = dlen
        di = di + 1
    let parts = split(core, ".")
    let major = 0
    let minor = 0
    let patch = 0
    if len(parts) >= 1
        major = _svb_parse_int(parts[0])
    if len(parts) >= 2
        minor = _svb_parse_int(parts[1])
    if len(parts) >= 3
        patch = _svb_parse_int(parts[2])
    return [major, minor, patch, pre, build]

// Format [major, minor, patch] as "X.Y.Z" (prerelease/build always dropped on bump).
fn _svb_format(major, minor, patch) -> str
    return str(major) + "." + str(minor) + "." + str(patch)

// Increment major, reset minor and patch to 0, drop prerelease and build.
fn svb_major(v) -> str
    let p = _svb_parse(v)
    return _svb_format(p[0] + 1, 0, 0)

// Increment minor, reset patch to 0, drop prerelease and build.
fn svb_minor(v) -> str
    let p = _svb_parse(v)
    return _svb_format(p[0], p[1] + 1, 0)

// Increment patch, drop prerelease and build (SemVer §8).
fn svb_patch(v) -> str
    let p = _svb_parse(v)
    return _svb_format(p[0], p[1], p[2] + 1)

// Dispatch bump by kind: "major", "minor", or "patch". Unknown kind returns v unchanged.
fn svb_bump(v, kind) -> str
    if kind == "major"
        return svb_major(v)
    if kind == "minor"
        return svb_minor(v)
    if kind == "patch"
        return svb_patch(v)
    return v
