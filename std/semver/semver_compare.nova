// std/semver/semver_compare.nova — SemVer 2.0.0 precedence comparison.
// Implements §11: compare major, minor, patch numerically; a pre-release version
// has LOWER precedence than the release; build metadata is IGNORED.
// Self-contained: imports nothing.

// _svc_parse_uint — scan decimal digits from s; return integer value (0 on error).
fn _svc_parse_uint(s: string) -> int
    let n = len(s)
    if n == 0
        return 0
    let val = 0
    for i in 0..n
        let d = ord(slice(s, i, i + 1)) - 48
        if d < 0 or d > 9
            return 0
        val = val * 10 + d
    val

// _svc_find_char — first index of ch in s, or -1.
fn _svc_find_char(s: string, ch: string) -> int
    let n = len(s)
    for i in 0..n
        if slice(s, i, i + 1) == ch
            return i
    0 - 1

// _svc_all_digits — true if id is non-empty and every char is 0-9.
fn _svc_all_digits(id: string) -> bool
    let n = len(id)
    if n == 0
        return false
    for i in 0..n
        let d = ord(slice(id, i, i + 1)) - 48
        if d < 0 or d > 9
            return false
    true

// _svc_parse — parse s into [major, minor, patch, prerelease]; build stripped.
fn _svc_parse(s: string) -> list
    let pre = ""
    let core = s
    let plus = _svc_find_char(core, "+")
    if plus >= 0
        core = slice(core, 0, plus)
    let dash = _svc_find_char(core, "-")
    if dash >= 0
        pre = slice(core, dash + 1, len(core))
        core = slice(core, 0, dash)
    let parts = split(core, ".")
    let major = 0
    let minor = 0
    let patch = 0
    if len(parts) >= 1
        major = _svc_parse_uint(parts[0])
    if len(parts) >= 2
        minor = _svc_parse_uint(parts[1])
    if len(parts) >= 3
        patch = _svc_parse_uint(parts[2])
    let result = [major, minor, patch, pre]
    result

// _svc_cmp_pre — compare two prerelease strings per SemVer §11.4.
// Empty string means no pre-release = HIGHEST precedence.
fn _svc_cmp_pre(pre_a: string, pre_b: string) -> int
    if pre_a == "" and pre_b == ""
        return 0
    if pre_a == ""
        return 1
    if pre_b == ""
        return 0 - 1
    let pa = split(pre_a, ".")
    let pb = split(pre_b, ".")
    let la = len(pa)
    let lb = len(pb)
    let minl = la
    if lb < la
        minl = lb
    for i in 0..minl
        let ia = pa[i]
        let ib = pb[i]
        let ia_num = _svc_all_digits(ia)
        let ib_num = _svc_all_digits(ib)
        if ia_num and ib_num
            let va = _svc_parse_uint(ia)
            let vb = _svc_parse_uint(ib)
            if va < vb
                return 0 - 1
            if va > vb
                return 1
        else
            if ia_num and not ib_num
                return 0 - 1
            if not ia_num and ib_num
                return 1
            if ia < ib
                return 0 - 1
            if ia > ib
                return 1
    if la < lb
        return 0 - 1
    if la > lb
        return 1
    0

// svc_compare — compare two SemVer strings per §11; returns -1, 0, or 1.
// Build metadata is ignored; a pre-release lowers precedence.
fn svc_compare(a: string, b: string) -> int
    let pa = _svc_parse(a)
    let pb = _svc_parse(b)
    if pa[0] < pb[0]
        return 0 - 1
    if pa[0] > pb[0]
        return 1
    if pa[1] < pb[1]
        return 0 - 1
    if pa[1] > pb[1]
        return 1
    if pa[2] < pb[2]
        return 0 - 1
    if pa[2] > pb[2]
        return 1
    let pre_a = pa[3]
    let pre_b = pb[3]
    _svc_cmp_pre(pre_a, pre_b)

// svc_lt — true when a has strictly lower precedence than b.
fn svc_lt(a: string, b: string) -> bool
    svc_compare(a, b) < 0

// svc_gt — true when a has strictly higher precedence than b.
fn svc_gt(a: string, b: string) -> bool
    svc_compare(a, b) > 0

// svc_eq — true when a and b have equal precedence (build metadata ignored).
fn svc_eq(a: string, b: string) -> bool
    svc_compare(a, b) == 0
