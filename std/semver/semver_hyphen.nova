// std/semver/semver_hyphen -- SemVer 2.0.0 hyphen ranges.
// LEAF -- imports NOTHING.
//
// A hyphen range 'lo - hi' means >=lo AND <=hi (INCLUSIVE on both ends).
// SemVer §2.3: '1.2.3 - 2.3.4' := >=1.2.3 <=2.3.4.
//
// Public API:
//   svh_satisfies(version, lo, hi)        -> int  (1 if lo<=version<=hi, 0 otherwise)
//   svh_satisfies_range(version, range)   -> int  (range = 'lo - hi' string; parses then delegates)

// PRIVATE: parse non-negative integer from digit string; -1 on bad input.
fn _svh_parse_int(s: string) -> int
    let n = len(s)
    if n == 0
        return -1
    let v = 0
    for i in 0..n
        let o = ord(char_at(s, i))
        if o < 48 or o > 57
            return -1
        v = v * 10 + (o - 48)
    v

// PRIVATE: parse 'major.minor.patch[-pre][+build]' -> [maj, min, pat, pre, build] as list.
// Missing numeric parts default to 0; pre-release and build default to "".
fn _svh_parse_ver(v: string) -> list
    let maj = 0
    let mn = 0
    let pat = 0
    let pre = ""
    let bld = ""
    // split on '+' first to isolate build metadata
    let bplus = split(v, "+")
    let core = bplus[0]
    if len(bplus) >= 2
        bld = bplus[1]
    // split core on '-' to isolate pre-release
    let dashparts = split(core, "-")
    let vercore = dashparts[0]
    if len(dashparts) >= 2
        for pi in 1..len(dashparts)
            if pre == ""
                pre = dashparts[pi]
            else
                pre += "-" + dashparts[pi]
    let parts = split(vercore, ".")
    if len(parts) >= 1
        let pm = _svh_parse_int(parts[0])
        if pm >= 0
            maj = pm
    if len(parts) >= 2
        let pn = _svh_parse_int(parts[1])
        if pn >= 0
            mn = pn
    if len(parts) >= 3
        let pp = _svh_parse_int(parts[2])
        if pp >= 0
            pat = pp
    [maj, mn, pat, pre, bld]

// PRIVATE: compare two pre-release identifier strings per SemVer §11.
// A purely-numeric identifier < an alphanumeric one.
// Returns -1, 0, or 1.
fn _svh_cmp_pre_id(a: string, b: string) -> int
    if a == b
        return 0
    let an = _svh_parse_int(a)
    let bn = _svh_parse_int(b)
    if an >= 0
        if bn >= 0
            if an < bn
                return -1
            if an > bn
                return 1
            return 0
        // an numeric, bn alphanumeric: numeric < alpha
        return -1
    if bn >= 0
        // an alphanumeric, bn numeric: alpha > numeric
        return 1
    // both alphanumeric: lexicographic
    if a < b
        return -1
    if a > b
        return 1
    0

// PRIVATE: compare full pre-release strings per SemVer §11.4.
// "" (no pre-release) > any non-empty pre-release.
fn _svh_cmp_pre(apre: string, bpre: string) -> int
    if apre == bpre
        return 0
    if apre == ""
        return 1
    if bpre == ""
        return -1
    // both non-empty: compare identifier by identifier
    let aids = split(apre, ".")
    let bids = split(bpre, ".")
    let na = len(aids)
    let nb = len(bids)
    let shorter = na
    if nb < shorter
        shorter = nb
    let i = 0
    let result = 0
    let done = 0
    while i < shorter
        if done == 0
            let c = _svh_cmp_pre_id(aids[i], bids[i])
            if c != 0
                result = c
                done = 1
        i += 1
    if done == 0
        if na < nb
            return -1
        if na > nb
            return 1
    result

// PRIVATE: compare two fully-parsed versions. Returns -1, 0, or 1.
// Build metadata (index 4) ignored per SemVer §10.
fn _svh_cmp_parsed(ap: list, bp: list) -> int
    let amaj = ap[0]
    let amin = ap[1]
    let apat = ap[2]
    let apre = ap[3]
    let bmaj = bp[0]
    let bmin = bp[1]
    let bpat = bp[2]
    let bpre = bp[3]
    if amaj < bmaj
        return -1
    if amaj > bmaj
        return 1
    if amin < bmin
        return -1
    if amin > bmin
        return 1
    if apat < bpat
        return -1
    if apat > bpat
        return 1
    _svh_cmp_pre(apre, bpre)

// PRIVATE: find the index of the first occurrence of needle in haystack, or -1.
fn _svh_index_of(haystack: string, needle: string) -> int
    let hn = len(haystack)
    let nn = len(needle)
    if nn == 0
        return 0
    if nn > hn
        return -1
    for i in 0..(hn - nn + 1)
        let mtch = 1
        for j in 0..nn
            if mtch == 1 and char_at(haystack, i + j) != char_at(needle, j)
                mtch = 0
        if mtch == 1
            return i
    return -1

// PRIVATE: trim leading and trailing spaces from s.
fn _svh_trim(s: string) -> string
    let n = len(s)
    // scan forward to find first non-space
    let start = 0
    let i = 0
    let found_s = 0
    while i < n and found_s == 0
        if char_at(s, i) != " "
            start = i
            found_s = 1
        i += 1
    if found_s == 0
        return ""
    // scan backward to find last non-space
    let end = n
    let j = n - 1
    let found_e = 0
    while j >= start and found_e == 0
        if char_at(s, j) != " "
            end = j + 1
            found_e = 1
        j -= 1
    slice(s, start, end)

// svh_satisfies("1.5.0", "1.2.3", "2.3.4") -> 1
// svh_satisfies("2.3.4", "1.2.3", "2.3.4") -> 1  (inclusive upper)
// svh_satisfies("2.4.0", "1.2.3", "2.3.4") -> 0
fn svh_satisfies(version: string, lo: string, hi: string) -> int
    let vp = _svh_parse_ver(version)
    let lp = _svh_parse_ver(lo)
    let hp = _svh_parse_ver(hi)
    // version >= lo
    let clo = _svh_cmp_parsed(vp, lp)
    if clo < 0
        return 0
    // version <= hi
    let chi = _svh_cmp_parsed(vp, hp)
    if chi > 0
        return 0
    1

// svh_satisfies_range("1.5.0", "1.2.3 - 2.3.4") -> 1
// Parses 'lo - hi' (space-hyphen-space separator) and delegates to svh_satisfies.
fn svh_satisfies_range(version: string, range: string) -> int
    // find " - " separator (space-hyphen-space)
    let sep = " - "
    let idx = _svh_index_of(range, sep)
    if idx < 0
        return 0
    let lo = _svh_trim(slice(range, 0, idx))
    let hi = _svh_trim(slice(range, idx + 3, len(range)))
    svh_satisfies(version, lo, hi)
