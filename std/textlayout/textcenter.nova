// ============================================================================
// NOVA Standard Library — std/textlayout/textcenter
// ============================================================================
// Center lines within a fixed-width column.
//
// All widths are measured in ASCII characters (1 byte = 1 column).
// No floats, no external imports.
//
// Public API:
//   tcen_center(line, width) -> string
//       Center a single line.  When padding is odd the extra space goes on the
//       RIGHT (right-heavy; matches Python str.center semantics).
//
//   tcen_center_block(text, width) -> string
//       Center every line of a multi-line text independently.
//
//   tcen_center_left_bias(line, width) -> string
//       Center with odd extra space going on the LEFT (left-heavy).
//       NOTE: for odd total padding, this places more on the left, so the
//       output length == width but the text sits slightly to the right.
//
//   tcen_pad_both(line, left, right) -> string
//       Pad a line with exactly `left` spaces on the left and `right` on the
//       right, regardless of the line's length.
//
//   tcen_offset(len, width) -> int
//       Left-padding count when centering content of length `len` in `width`
//       (right-heavy: odd extra goes right, so left = total/2).
//
//   tcen_center_in(line, width, fill) -> string
//       Center `line` within `width` using a custom fill character.
//       Odd extra fill goes on the RIGHT.
//
//   tcen_banner(text, width, fill) -> string
//       Center `text` in a line of exactly `width` fill characters, replacing
//       the appropriate number of fill chars with spaces around the text.
//       Equivalent to tcen_center_in(text, width, fill).
//
// LEAF — imports NOTHING.

// ── private helpers ──────────────────────────────────────────────────────────

// Repeat single-char string ch exactly n times (returns "" when n <= 0).
fn _tcen_rep(ch, n) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + ch
        i = i + 1
    out

// Split text into lines on chr(10).  A trailing newline does NOT produce a
// final empty element; "" returns [].
fn _tcen_split_lines(text) -> list
    let result = []
    let n = len(text)
    if n == 0
        return result
    let cur = ""
    let i = 0
    while i < n
        let ch = slice(text, i, i + 1)
        if ch == chr(10)
            result = result + [cur]
            cur = ""
        else
            cur = cur + ch
        i = i + 1
    if len(cur) > 0
        result = result + [cur]
    result

// Join a list of strings with chr(10).
fn _tcen_join(lines) -> string
    let out = ""
    let i = 0
    let n = len(lines)
    while i < n
        if i > 0
            out = out + chr(10)
        out = out + lines[i]
        i = i + 1
    out

// ── public API ───────────────────────────────────────────────────────────────

// tcen_offset(len, width) -> int
// Returns the number of fill chars to place on the LEFT when centering content
// of length `len` in a field of `width`.  Right-heavy: total/2 goes left,
// remainder goes right.
// tcen_offset(2, 6) == 2  (total_pad=4, left=2, right=2)
// tcen_offset(2, 5) == 1  (total_pad=3, left=1, right=2)
fn tcen_offset(len, width) -> int
    let total = width - len
    if total <= 0
        return 0
    total / 2

// tcen_pad_both(line, left, right) -> string
// Prepend `left` spaces and append `right` spaces to `line`.
fn tcen_pad_both(line, left, right) -> string
    _tcen_rep(" ", left) + line + _tcen_rep(" ", right)

// tcen_center(line, width) -> string
// Center a single line within `width` columns.  If the line is already >= width
// it is returned unchanged.  Odd extra padding goes on the RIGHT.
// tcen_center("hi", 6) == "  hi  "
// tcen_center("hi", 5) == " hi  "  (3 total pad: left=1, right=2)
// tcen_center("abc", 3) == "abc"
fn tcen_center(line, width) -> string
    let llen = len(line)
    if llen >= width
        return line
    let total = width - llen
    let left = total / 2
    let right = total - left
    tcen_pad_both(line, left, right)

// tcen_center_left_bias(line, width) -> string
// Center with odd extra padding going to the LEFT.
// tcen_center_left_bias("hi", 5) == "  hi "  (3 total pad: left=2, right=1)
// NOTE: the prompt KAT says tcen_center_left_bias("hi", 5) == "  hi " which
// is 5 chars total.  Here left=ceil(3/2)=2, right=floor(3/2)=1.
fn tcen_center_left_bias(line, width) -> string
    let llen = len(line)
    if llen >= width
        return line
    let total = width - llen
    // Left-bias: left gets the remainder (ceiling division)
    let right = total / 2
    let left = total - right
    tcen_pad_both(line, left, right)

// tcen_center_block(text, width) -> string
// Center every line of a multi-line text within `width`.
fn tcen_center_block(text, width) -> string
    let lines = _tcen_split_lines(text)
    let n = len(lines)
    if n == 0
        return ""
    let result = []
    let i = 0
    while i < n
        result = result + [tcen_center(lines[i], width)]
        i = i + 1
    _tcen_join(result)

// tcen_center_in(line, width, fill) -> string
// Center `line` within `width` using a custom `fill` character (single char).
// Odd extra fill goes on the RIGHT.
// tcen_center_in("hi", 6, "*") == "**hi**"
fn tcen_center_in(line, width, fill) -> string
    let llen = len(line)
    if llen >= width
        return line
    let total = width - llen
    let left = total / 2
    let right = total - left
    _tcen_rep(fill, left) + line + _tcen_rep(fill, right)

// tcen_banner(text, width, fill) -> string
// Center `text` in a line of `width` fill characters.
// Equivalent to tcen_center_in.
// tcen_banner("AB", 6, "-") == "--AB--"
fn tcen_banner(text, width, fill) -> string
    tcen_center_in(text, width, fill)
