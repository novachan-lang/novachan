// ============================================================================
// NOVA Standard Library — std/textlayout/textpad
// ============================================================================
// Padding and alignment of a single ASCII text line.
//
// Width is measured in characters (1 byte = 1 column).
//
// Public API (prefix tp_):
//   tp_repeat(ch, n)              -> string  repeat ch n times
//   tp_ljust(s, width)            -> string  left-justify, pad right with spaces
//   tp_rjust(s, width)            -> string  right-justify, pad left with spaces
//   tp_center(s, width)           -> string  center; extra space goes to the RIGHT
//   tp_ljust_ch(s, width, ch)     -> string  left-justify, pad right with ch
//   tp_rjust_ch(s, width, ch)     -> string  right-justify, pad left with ch
//   tp_center_ch(s, width, ch)    -> string  center with ch; extra goes to the RIGHT
//   tp_zfill(s, width)            -> string  zero-pad numeric string, sign-aware
//   tp_truncate_pad(s, width)     -> string  truncate OR pad to EXACTLY width
//
// LEAF — imports nothing; all helpers prefixed tp_.

// ── public API ────────────────────────────────────────────────────────────────

// tp_repeat: build a string by repeating ch exactly n times.
// If n <= 0 returns "".
fn tp_repeat(ch, n) -> string
    let out_parts = []
    for i in 0..n
        push(out_parts, ch)
    let out = join(out_parts, "")
    out

// tp_ljust: left-justify s in a field of width, padding the right with spaces.
// If len(s) >= width, return s unchanged (no truncation).
fn tp_ljust(s, width) -> string
    let slen = len(s)
    let result = s
    if slen < width
        result = s + tp_repeat(" ", width - slen)
    result

// tp_rjust: right-justify s in a field of width, padding the left with spaces.
// If len(s) >= width, return s unchanged (no truncation).
fn tp_rjust(s, width) -> string
    let slen = len(s)
    let result = s
    if slen < width
        result = tp_repeat(" ", width - slen) + s
    result

// tp_center: center s in a field of width, padding with spaces.
// When total padding is odd, the extra space goes to the RIGHT.
// If len(s) >= width, return s unchanged (no truncation).
fn tp_center(s, width) -> string
    let slen = len(s)
    let result = s
    if slen < width
        let total_pad = width - slen
        let left_pad = total_pad / 2
        let right_pad = total_pad - left_pad
        result = tp_repeat(" ", left_pad) + s + tp_repeat(" ", right_pad)
    result

// tp_ljust_ch: left-justify s, padding right with the character ch.
// If len(s) >= width, return s unchanged.
fn tp_ljust_ch(s, width, ch) -> string
    let slen = len(s)
    let result = s
    if slen < width
        result = s + tp_repeat(ch, width - slen)
    result

// tp_rjust_ch: right-justify s, padding left with the character ch.
// If len(s) >= width, return s unchanged.
fn tp_rjust_ch(s, width, ch) -> string
    let slen = len(s)
    let result = s
    if slen < width
        result = tp_repeat(ch, width - slen) + s
    result

// tp_center_ch: center s with character ch as padding.
// When total padding is odd, the extra character goes to the RIGHT.
// If len(s) >= width, return s unchanged.
fn tp_center_ch(s, width, ch) -> string
    let slen = len(s)
    let result = s
    if slen < width
        let total_pad = width - slen
        let left_pad = total_pad / 2
        let right_pad = total_pad - left_pad
        result = tp_repeat(ch, left_pad) + s + tp_repeat(ch, right_pad)
    result

// tp_zfill: zero-pad a numeric string to at least width characters.
// Sign-aware: if s starts with '+' or '-', the sign is preserved at the front
// and zeros are inserted after it. If len(s) >= width, return s unchanged.
fn tp_zfill(s, width) -> string
    let slen = len(s)
    let result = s
    if slen < width
        let first = slice(s, 0, 1)
        if first == "+" or first == "-"
            let rest = slice(s, 1, slen)
            let zeros = tp_repeat("0", width - slen)
            result = first + zeros + rest
        else
            result = tp_repeat("0", width - slen) + s
    result

// tp_truncate_pad: return a string of EXACTLY width characters.
// If len(s) > width, hard-truncate to width. If len(s) < width, pad right
// with spaces. If len(s) == width, return s unchanged.
fn tp_truncate_pad(s, width) -> string
    let slen = len(s)
    let result = s
    if slen > width
        result = slice(s, 0, width)
    else
        if slen < width
            result = s + tp_repeat(" ", width - slen)
    result
