// ============================================================================
// NOVA Standard Library — std/textlayout/justify
// ============================================================================
// Full (newspaper-style) justification of text lines.
//
// Public API:
//   jf_justify(line, width) -> string
//       Distribute extra spaces between words so the line is exactly `width`
//       chars wide.  Extra spaces are distributed left-first (leftmost gaps get
//       the remainder spaces).  A single word (no gap) is left-padded with
//       trailing spaces.  An already-wide-enough or oversized line is returned
//       as-is.
//
//   jf_justify_text(text, width) -> string
//       Word-wrap `text` to `width`, then fully justify every line EXCEPT the
//       last line of each paragraph (paragraphs are separated by blank lines).
//       The last line of each paragraph is left as-is (greedy-wrapped).
//
//   jf_gaps(nwords) -> int
//       Number of inter-word gaps for nwords words (nwords - 1).
//
//   jf_distribute(extra, gaps) -> list
//       Returns a list of `gaps` integers: base spaces per gap, with the first
//       (extra mod gaps) gaps each getting one additional space.
//
//   jf_word_count(line) -> int
//       Count whitespace-delimited words in a line.
//
//   jf_is_last_line(lines, idx) -> bool
//       True when idx is the index of the last line in the list.
//
// LEAF — imports NOTHING.

// ── private helpers ──────────────────────────────────────────────────────────

// Split a string on literal " " (space), skipping empty tokens (collapsed
// spaces) — matches std split(line, " ") filtered of empty parts.
fn _jf_split_words(line) -> list
    [w for w in split(line, " ") if len(w) > 0]

// Split text into lines on chr(10). A trailing newline does NOT produce a final
// empty element. Uses index/slice (not char-by-char concat) — O(n) total.
fn _jf_split_lines(text) -> list
    let result = []
    let n = len(text)
    if n == 0
        return result
    let start = 0
    for i in 0..n
        let ch = slice(text, i, i + 1)
        if ch == chr(10)
            push(result, slice(text, start, i))
            start = i + 1
    if start < n
        push(result, slice(text, start, n))
    result

// Greedy word-wrap: returns list of line strings, each <= width chars where
// possible.  Words longer than width stand alone on their own line.
// Irregular control flow (running line-length budget) — kept as a loop, but
// appends use push() (in-place) instead of `lines = lines + [...]`.
fn _jf_wrap(text, width) -> list
    let lines = []
    let words = _jf_split_words(text)
    let nw = len(words)
    if nw == 0
        return lines
    let cur = ""
    let cur_len = 0
    let i = 0
    while i < nw
        let word = words[i]
        let wlen = len(word)
        if cur_len == 0
            cur = word
            cur_len = wlen
        else
            if cur_len + 1 + wlen <= width
                cur = cur + " " + word
                cur_len = cur_len + 1 + wlen
            else
                push(lines, cur)
                cur = word
                cur_len = wlen
        i = i + 1
    if cur_len > 0
        push(lines, cur)
    lines

// Justify every line in `wrapped` except the last, which is left as-is
// (greedy-wrapped). Shared by both paragraph-flush sites in jf_justify_text.
// NOTE: comprehensions only bind a single loop variable (`for x in xs`) — the
// index+value form `for i, v in xs` is statement-only, so this needs the last-
// line check kept as a plain loop with push().
fn _jf_justify_wrapped(wrapped, width) -> list
    let wn = len(wrapped)
    let result = []
    for i, ln in wrapped
        if i < wn - 1
            push(result, jf_justify(ln, width))
        else
            push(result, ln)
    result

// ── public API ───────────────────────────────────────────────────────────────

// jf_gaps(nwords) -> int
// Number of inter-word gaps for nwords words (nwords-1; 0 when nwords <= 1).
fn jf_gaps(nwords) -> int
    if nwords <= 1
        return 0
    nwords - 1

// jf_distribute(extra, gaps) -> list
// Returns a list of `gaps` ints: each gap gets base spaces, and the first
// (extra mod gaps) gaps each get one additional space.
// jf_distribute(5, 2) == [3, 2]  (base = 5/2 = 2; 1 extra remainder → first gap gets +1)
// jf_distribute(2, 2) == [1, 1]  (base = 1; 0 remainder)
fn jf_distribute(extra, gaps) -> list
    if gaps <= 0
        return []
    let base = extra / gaps
    let remainder = extra - base * gaps
    [base + 1 if i < remainder else base for i in 0..gaps]

// jf_word_count(line) -> int
// Count the number of whitespace-delimited words in a line.
fn jf_word_count(line) -> int
    let words = _jf_split_words(line)
    len(words)

// jf_is_last_line(lines, idx) -> bool
// True when idx points to the last element of lines.
fn jf_is_last_line(lines, idx) -> bool
    idx == len(lines) - 1

// jf_justify(line, width) -> string
// Fully justify `line` to exactly `width` chars by distributing spaces between
// words.  Extra spaces fill leftmost gaps first.  A single word (or empty line)
// is left-padded to `width` with trailing spaces.
// jf_justify("the quick fox", 15) == "the  quick  fox"
// jf_justify("a b c", 7) == "a  b  c"
// jf_justify("word", 8) == "word    "
fn jf_justify(line, width) -> string
    let words = _jf_split_words(line)
    let nw = len(words)
    if nw == 0
        return repeat(" ", width)
    if nw == 1
        // Single word: left-justify by padding on the right.
        let w = words[0]
        let pad = width - len(w)
        if pad > 0
            return w + repeat(" ", pad)
        return w
    // Compute total char count of all words.
    let total_word_chars = sum([len(w) for w in words])
    let gaps = jf_gaps(nw)
    // Total extra spaces to distribute = width - word chars - minimum 1 space per gap.
    let extra = width - total_word_chars - gaps
    // If extra is negative the line is already at or over width; return as-is.
    if extra < 0
        return join(words, " ")
    // Distribute the extra spaces across gaps (each gap already has 1 base space).
    let bonus = jf_distribute(extra, gaps)
    // Each gap = 1 (base space) + bonus[g] extra spaces, followed by words[g+1].
    let pieces = [repeat(" ", 1 + bonus[g]) + words[g + 1] for g in 0..gaps]
    join([words[0], ...pieces], "")

// jf_justify_text(text, width) -> string
// Greedy-wrap text to width, then fully justify every line except the last line
// of each paragraph.  Paragraphs are separated by blank lines (empty lines in
// the original text); blank lines are preserved as blank lines in the output.
fn jf_justify_text(text, width) -> string
    let raw_lines = _jf_split_lines(text)
    let n = len(raw_lines)
    if n == 0
        return ""
    // Collect paragraphs (runs of non-empty lines) separated by blank lines.
    // We process each paragraph through wrap, then justify all but last line.
    // Irregular control flow (paragraph accumulation + flush-on-blank-line) —
    // kept as a loop, but every append uses push() (in-place) instead of `+`.
    let out_lines = []
    let para_lines = []
    for raw in raw_lines
        if len(raw) == 0
            // Blank line: flush current paragraph first.
            if len(para_lines) > 0
                let wrapped = _jf_wrap(join(para_lines, " "), width)
                for ln in _jf_justify_wrapped(wrapped, width)
                    push(out_lines, ln)
                para_lines = []
            push(out_lines, "")
        else
            push(para_lines, raw)
    // Flush last paragraph.
    if len(para_lines) > 0
        let wrapped = _jf_wrap(join(para_lines, " "), width)
        for ln in _jf_justify_wrapped(wrapped, width)
            push(out_lines, ln)
    join(out_lines, chr(10))
