// ============================================================================
// NOVA Standard Library — std/textlayout/texttable
// ============================================================================
// ASCII table rendering with full border, no-border, alignment, and header
// variants.  All functions operate on a list-of-rows, where each row is a
// list of cell strings.  Column widths are auto-sized to the widest cell.
//
// Border format (1 space padding each side of cell content):
//   +-------+-----+
//   | cell  | c2  |
//   +-------+-----+
//
// Public API (all functions prefixed ttab_):
//   ttab_col_widths(rows) -> list
//       Return a list of ints: the max cell length in each column across all
//       rows.  Handles ragged rows (missing cells treated as width 0).
//
//   ttab_separator(widths) -> string
//       Build the '+---+---+' separator line.  Each column contributes
//       (width + 2) dashes (1 space padding each side); columns delimited by '+'.
//
//   ttab_row(cells, widths) -> string
//       Build a '| cell | cell |' data line.  Each cell is left-justified to
//       its column width; padded with 1 space each side.
//
//   ttab_render(rows) -> string
//       Full bordered table: separator / row / separator / ... / row / separator.
//       Lines joined with chr(10).  Empty rows list returns just the header
//       separator (a single separator line with zero columns).
//
//   ttab_render_no_border(rows) -> string
//       Space-separated, left-aligned columns with no border characters.
//       Columns separated by 2 spaces.  Lines joined with chr(10).
//
//   ttab_render_align(rows, aligns) -> string
//       Full bordered table with per-column alignment.  `aligns` is a list of
//       strings: "l" (left, default), "r" (right), "c" (center).
//
//   ttab_header(rows) -> string
//       Render with the first row treated as a header: header row / separator /
//       data rows.  Uses full border.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── private helpers ────────────────────────────────────────────────────────

// Cell text at index c, or "" if row has fewer columns (ragged rows).
fn _ttab_cell_at(row, c) -> string
    if c < len(row)
        return row[c]
    ""

// Alignment code at index c, or "l" (left) default if aligns has fewer entries.
fn _ttab_align_at(aligns, c) -> string
    if c < len(aligns)
        return aligns[c]
    "l"

// Left-justify: pad on the right with spaces to `width` (no-op if already >= width).
fn _ttab_pad_left(cell, width) -> string
    let pad = width - len(cell)
    if pad > 0
        return cell + repeat(" ", pad)
    cell

// Right-justify: pad on the left with spaces to `width`.
fn _ttab_pad_right(cell, width) -> string
    let pad = width - len(cell)
    if pad > 0
        return repeat(" ", pad) + cell
    cell

// Center: split padding left/right (left gets the smaller half on an odd total).
fn _ttab_pad_center(cell, width) -> string
    let total = width - len(cell)
    if total <= 0
        return cell
    let lpad = total / 2
    let rpad = total - lpad
    repeat(" ", lpad) + cell + repeat(" ", rpad)

// Dispatch on alignment code: "r" right, "c" center, else ("l" / unknown) left.
fn _ttab_pad_align(cell, width, al) -> string
    if al == "r"
        return _ttab_pad_right(cell, width)
    if al == "c"
        return _ttab_pad_center(cell, width)
    _ttab_pad_left(cell, width)

// ── public API ───────────────────────────────────────────────────────────────

// ttab_col_widths(rows) -> list
// Compute per-column maximum cell widths across all rows (list of row lists).
// Ragged rows: any column absent in a row contributes width 0.
fn ttab_col_widths(rows) -> list
    let ncols = reduce(rows, (acc, row) => max(acc, len(row)), 0)
    let widths = [0 for _ in 0..ncols]
    for row in rows
        for c, cell in row
            let clen = len(cell)
            if clen > widths[c]
                widths[c] = clen
    widths

// ttab_separator(widths) -> string
// Build '+-----+----+' line.  Each column i contributes '+' + '-'*(widths[i]+2).
// A final '+' closes the line.
fn ttab_separator(widths) -> string
    let pieces = ["+" + repeat("-", widths[i] + 2) for i in 0..len(widths)]
    join(pieces, "") + "+"

// ttab_row(cells, widths) -> string
// Build '| cell  | c2 |' line.  Each cell is left-justified to widths[i],
// preceded by '| ' and followed by ' '.  A final '|' closes the line.
fn ttab_row(cells, widths) -> string
    let n = len(widths)
    let pieces = ["| " + _ttab_pad_left(_ttab_cell_at(cells, i), widths[i]) + " " for i in 0..n]
    join(pieces, "") + "|"

// ttab_render(rows) -> string
// Render a full bordered ASCII table.
// Format: separator / (row + separator) for each row.
// Returns a single separator line for an empty rows list.
fn ttab_render(rows) -> string
    let widths = ttab_col_widths(rows)
    let sep = ttab_separator(widths)
    let body = flatten([[ttab_row(row, widths), sep] for row in rows])
    join([sep, ...body], chr(10))

// Space-separated (no border) rendering of a single row: columns joined by 2
// spaces; every column except the last is left-padded to its width, the last
// column is left unpadded (avoids trailing spaces).
fn _ttab_row_no_border(row, widths) -> string
    let ncols = len(widths)
    let pieces = [_ttab_pad_left(_ttab_cell_at(row, c), widths[c]) if c < ncols - 1 else _ttab_cell_at(row, c) for c in 0..ncols]
    join(pieces, "  ")

// ttab_render_no_border(rows) -> string
// Space-separated, left-aligned columns with no border.  Columns separated by
// 2 spaces.  Lines joined with chr(10).
fn ttab_render_no_border(rows) -> string
    if len(rows) == 0
        return ""
    let widths = ttab_col_widths(rows)
    join([_ttab_row_no_border(row, widths) for row in rows], chr(10))

// Full-border rendering of a single row with per-column alignment.
fn _ttab_row_align(row, widths, aligns) -> string
    let ncols = len(widths)
    let pieces = ["| " + _ttab_pad_align(_ttab_cell_at(row, c), widths[c], _ttab_align_at(aligns, c)) + " " for c in 0..ncols]
    join(pieces, "") + "|"

// ttab_render_align(rows, aligns) -> string
// Like ttab_render but per-column alignment.  aligns[i] = "l", "r", or "c".
// Missing alignment entries default to "l".
fn ttab_render_align(rows, aligns) -> string
    let widths = ttab_col_widths(rows)
    let sep = ttab_separator(widths)
    let body = flatten([[_ttab_row_align(row, widths, aligns), sep] for row in rows])
    join([sep, ...body], chr(10))

// ttab_header(rows) -> string
// Render with the first row as a header row, separated from data rows below.
// Format: sep / header-row / sep / data-row / sep / data-row / sep ...
// If rows is empty, returns "".
fn ttab_header(rows) -> string
    let nrows = len(rows)
    if nrows == 0
        return ""
    let widths = ttab_col_widths(rows)
    let sep = ttab_separator(widths)
    let data_rows = list_slice(rows, 1, nrows)
    let body = flatten([[ttab_row(row, widths), sep] for row in data_rows])
    join([sep, ttab_row(rows[0], widths), sep, ...body], chr(10))
