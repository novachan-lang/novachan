// ============================================================================
// NOVA Standard Library — std/textlayout/texttable
// ============================================================================
// ASCII table rendering with full border, no-border, alignment, and header
// variants.  All functions operate on a list-of-rows, where each row is a
// list of cell strings.  Column widths are auto-sized to the widest cell.
//
// Border format (1 space padding each side of cell content):
//   +-------+-----+
//   | cell  | c2  |
//   +-------+-----+
//
// Public API (all functions prefixed ttab_):
//   ttab_col_widths(rows) -> list
//       Return a list of ints: the max cell length in each column across all
//       rows.  Handles ragged rows (missing cells treated as width 0).
//
//   ttab_separator(widths) -> string
//       Build the '+---+---+' separator line.  Each column contributes
//       (width + 2) dashes (1 space padding each side); columns delimited by '+'.
//
//   ttab_row(cells, widths) -> string
//       Build a '| cell | cell |' data line.  Each cell is left-justified to
//       its column width; padded with 1 space each side.
//
//   ttab_render(rows) -> string
//       Full bordered table: separator / row / separator / ... / row / separator.
//       Lines joined with chr(10).  Empty rows list returns just the header
//       separator (a single separator line with zero columns).
//
//   ttab_render_no_border(rows) -> string
//       Space-separated, left-aligned columns with no border characters.
//       Columns separated by 2 spaces.  Lines joined with chr(10).
//
//   ttab_render_align(rows, aligns) -> string
//       Full bordered table with per-column alignment.  `aligns` is a list of
//       strings: "l" (left, default), "r" (right), "c" (center).
//
//   ttab_header(rows) -> string
//       Render with the first row treated as a header: header row / separator /
//       data rows.  Uses full border.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── private helpers (called only at top level, not from inside loops) ─────────

// Join a list of strings with chr(10).
fn _ttab_join_lines(lines) -> string
    let n = len(lines)
    if n == 0
        return ""
    let nl = chr(10)
    let out = ""
    let i = 0
    while i < n
        if i > 0
            out = out + nl
        out = out + lines[i]
        i = i + 1
    out

// ── public API ───────────────────────────────────────────────────────────────

// ttab_col_widths(rows) -> list
// Compute per-column maximum cell widths across all rows (list of row lists).
// Ragged rows: any column absent in a row contributes width 0.
fn ttab_col_widths(rows) -> list
    let nrows = len(rows)
    let widths = []
    let ncols = 0
    // First pass: determine number of columns.
    let r = 0
    while r < nrows
        let row = rows[r]
        if len(row) > ncols
            ncols = len(row)
        r = r + 1
    // Initialise all column widths to 0.
    let c = 0
    while c < ncols
        widths = widths + [0]
        c = c + 1
    // Second pass: update column widths.
    let r2 = 0
    while r2 < nrows
        let row = rows[r2]
        let nc = len(row)
        let c2 = 0
        while c2 < nc
            let clen = len(row[c2])
            if clen > widths[c2]
                // Rebuild widths list with updated value.
                let new_w = []
                let k = 0
                while k < ncols
                    if k == c2
                        new_w = new_w + [clen]
                    else
                        new_w = new_w + [widths[k]]
                    k = k + 1
                widths = new_w
            c2 = c2 + 1
        r2 = r2 + 1
    widths

// ttab_separator(widths) -> string
// Build '+-----+----+' line.  Each column i contributes '+' + '-'*(widths[i]+2).
// A final '+' closes the line.  Repetition is inlined to avoid nested fn-call bug.
fn ttab_separator(widths) -> string
    let n = len(widths)
    let out = ""
    let i = 0
    while i < n
        out = out + "+"
        let ndash = widths[i] + 2
        let j = 0
        while j < ndash
            out = out + "-"
            j = j + 1
        i = i + 1
    out + "+"

// ttab_row(cells, widths) -> string
// Build '| cell  | c2 |' line.  Each cell is left-justified to widths[i],
// preceded by '| ' and followed by ' '.  A final '|' closes the line.
// Padding is inlined to avoid nested fn-call-in-loop bug.
fn ttab_row(cells, widths) -> string
    let n = len(widths)
    let out = ""
    let i = 0
    while i < n
        let cell = ""
        if i < len(cells)
            cell = cells[i]
        out = out + "| " + cell
        let slen = len(cell)
        let cw = widths[i]
        let p = slen
        while p < cw
            out = out + " "
            p = p + 1
        out = out + " "
        i = i + 1
    out + "|"

// ttab_render(rows) -> string
// Render a full bordered ASCII table.
// Format: separator / (row + separator) for each row.
// Returns a single separator line for an empty rows list.
fn ttab_render(rows) -> string
    let nrows = len(rows)
    let widths = ttab_col_widths(rows)
    let sep = ttab_separator(widths)
    let lines = [sep]
    let r = 0
    while r < nrows
        lines = lines + [ttab_row(rows[r], widths)]
        lines = lines + [sep]
        r = r + 1
    _ttab_join_lines(lines)

// ttab_render_no_border(rows) -> string
// Space-separated, left-aligned columns with no border.  Columns separated by
// 2 spaces.  Lines joined with chr(10).  Padding is inlined.
fn ttab_render_no_border(rows) -> string
    let nrows = len(rows)
    if nrows == 0
        return ""
    let widths = ttab_col_widths(rows)
    let ncols = len(widths)
    let lines = []
    let r = 0
    while r < nrows
        let row = rows[r]
        let line = ""
        let c = 0
        while c < ncols
            let cell = ""
            if c < len(row)
                cell = row[c]
            if c > 0
                line = line + "  "
            // Last column: no padding (avoid trailing spaces).
            if c < ncols - 1
                line = line + cell
                let slen = len(cell)
                let cw = widths[c]
                let p = slen
                while p < cw
                    line = line + " "
                    p = p + 1
            else
                line = line + cell
            c = c + 1
        lines = lines + [line]
        r = r + 1
    _ttab_join_lines(lines)

// ttab_render_align(rows, aligns) -> string
// Like ttab_render but per-column alignment.  aligns[i] = "l", "r", or "c".
// Missing alignment entries default to "l".  All padding inlined.
fn ttab_render_align(rows, aligns) -> string
    let nrows = len(rows)
    let widths = ttab_col_widths(rows)
    let ncols = len(widths)
    let nalign = len(aligns)
    let sep = ttab_separator(widths)
    let lines = [sep]
    let r = 0
    while r < nrows
        let row = rows[r]
        let out = ""
        let c = 0
        while c < ncols
            let cell = ""
            if c < len(row)
                cell = row[c]
            let al = "l"
            if c < nalign
                al = aligns[c]
            let cw = widths[c]
            let slen = len(cell)
            let padded = ""
            if al == "r"
                // right-justify: pad on the left
                let lpad = cw - slen
                if lpad < 0
                    lpad = 0
                let pp = 0
                while pp < lpad
                    padded = padded + " "
                    pp = pp + 1
                padded = padded + cell
            else
                if al == "c"
                    // center: split padding left and right
                    let total = cw - slen
                    if total < 0
                        total = 0
                    let lpad = total / 2
                    let rpad = total - lpad
                    let pp = 0
                    while pp < lpad
                        padded = padded + " "
                        pp = pp + 1
                    padded = padded + cell
                    let qp = 0
                    while qp < rpad
                        padded = padded + " "
                        qp = qp + 1
                else
                    // left-justify: pad on the right
                    padded = cell
                    let pp = slen
                    while pp < cw
                        padded = padded + " "
                        pp = pp + 1
            out = out + "| " + padded + " "
            c = c + 1
        lines = lines + [out + "|"]
        lines = lines + [sep]
        r = r + 1
    _ttab_join_lines(lines)

// ttab_header(rows) -> string
// Render with the first row as a header row, separated from data rows below.
// Format: sep / header-row / sep / data-row / sep / data-row / sep ...
// If rows is empty, returns "".
fn ttab_header(rows) -> string
    let nrows = len(rows)
    if nrows == 0
        return ""
    let widths = ttab_col_widths(rows)
    let sep = ttab_separator(widths)
    let lines = [sep]
    // Header row (first row).
    lines = lines + [ttab_row(rows[0], widths)]
    lines = lines + [sep]
    // Remaining data rows.
    let r = 1
    while r < nrows
        lines = lines + [ttab_row(rows[r], widths)]
        lines = lines + [sep]
        r = r + 1
    _ttab_join_lines(lines)
