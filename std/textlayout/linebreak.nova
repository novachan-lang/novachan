// ============================================================================
// NOVA Standard Library — std/textlayout/linebreak
// ============================================================================
// Line-breaking algorithms for paragraph layout.  All functions operate on a
// pre-tokenised list of words (strings, no whitespace).
//
// Public API (all functions prefixed lb_):
//   lb_word_widths(words) -> list
//       Return a list of the character widths (int) of each word.
//
//   lb_fits_line(words, start, end, width) -> bool
//       True if words[start..end-1] fit on one line of given width.
//       Fitting means: sum of word lengths + (end-start-1) spaces <= width.
//
//   lb_line_count(words, width) -> int
//       Number of lines produced by greedy breaking with the given width.
//
//   lb_greedy(words, width) -> list
//       Greedy line break: return a list of lists, where each inner list
//       contains the start and (exclusive) end index of the words on that line.
//       e.g. [[0,2],[2,4]] for a two-line result.
//
//   lb_greedy_lines(words, width) -> list
//       Like lb_greedy but return each line as a joined string (words joined
//       with single spaces).
//
//   lb_break_points(words, width) -> list
//       Return the list of start-word-indices for all lines except the first.
//       e.g. [2] means the second line starts at word index 2.
//
//   lb_cost_greedy(words, width) -> int
//       Badness of the greedy layout: sum of squared trailing-space counts on
//       all lines EXCEPT the last (last line is not penalised).
//
//   lb_balance(words, width) -> list
//       Balance-break: minimise the maximum line length by binary-searching
//       over the target width [max_word_width .. width], then applying greedy
//       at the winning width.  Returns a list of joined line strings.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Join words[start..end-1] with single spaces.
fn _lb_join_range(words, start, end_idx) -> string
    let out = ""
    let i = start
    while i < end_idx
        if i > start
            out = out + " "
        out = out + words[i]
        i = i + 1
    out

// Max of two ints.
fn _lb_max2(a, b) -> int
    if a > b
        return a
    b

// ── public API ───────────────────────────────────────────────────────────────

// lb_word_widths(words) -> list
// Return a list of character widths of each word in the input list.
fn lb_word_widths(words) -> list
    let n = len(words)
    let out = []
    for i in 0..n
        out = out + [len(words[i])]
    out

// lb_fits_line(words, start, end_idx, width) -> bool
// True iff words[start..end_idx-1] (end_idx exclusive) fit in `width` chars.
// Width used = sum(word_lens) + (end_idx - start - 1) spaces.
// A range with start == end_idx is empty and always fits.
fn lb_fits_line(words, start, end_idx, width) -> bool
    if end_idx <= start
        return 1
    let total = 0
    let i = start
    while i < end_idx
        total = total + len(words[i])
        i = i + 1
    let spaces = end_idx - start - 1
    total = total + spaces
    if total <= width
        return 1
    0

// lb_line_count(words, width) -> int
// Number of lines when the greedy algorithm is applied to `words` at `width`.
fn lb_line_count(words, width) -> int
    let n = len(words)
    if n == 0
        return 0
    let count = 1
    let cur_len = 0
    for i in 0..n
        let wlen = len(words[i])
        if i == 0
            cur_len = wlen
        else
            if cur_len + 1 + wlen <= width
                cur_len = cur_len + 1 + wlen
            else
                count = count + 1
                cur_len = wlen
    count

// lb_greedy(words, width) -> list
// Greedy line break: return list of [start, end] pairs (end exclusive).
// A word longer than width is placed alone on its own line.
fn lb_greedy(words, width) -> list
    let n = len(words)
    let lines = []
    if n == 0
        return lines
    let line_start = 0
    let cur_len = 0
    for i in 0..n
        let wlen = len(words[i])
        if i == line_start
            // First word on this line — always fits.
            cur_len = wlen
        else
            if cur_len + 1 + wlen <= width
                cur_len = cur_len + 1 + wlen
            else
                // Flush current line.
                lines = lines + [[line_start, i]]
                line_start = i
                cur_len = wlen
    // Flush the last line.
    lines = lines + [[line_start, n]]
    lines

// lb_greedy_lines(words, width) -> list
// Like lb_greedy but return each segment as a joined string.
fn lb_greedy_lines(words, width) -> list
    let segs = lb_greedy(words, width)
    let n = len(segs)
    let out = []
    for i in 0..n
        let seg = segs[i]
        out = out + [_lb_join_range(words, seg[0], seg[1])]
    out

// lb_break_points(words, width) -> list
// Return the start-word-indices of all lines except the first.
// e.g. two lines starting at 0 and 2 → [2].
fn lb_break_points(words, width) -> list
    let segs = lb_greedy(words, width)
    let n = len(segs)
    let out = []
    // Skip index 0 (the first line always starts at 0).
    let i = 1
    while i < n
        let seg = segs[i]
        out = out + [seg[0]]
        i = i + 1
    out

// lb_cost_greedy(words, width) -> int
// Badness = sum of squared trailing-space counts for all lines except the last.
// Trailing spaces on line i = width - (sum of word widths + spaces between).
fn lb_cost_greedy(words, width) -> int
    let segs = lb_greedy(words, width)
    let n = len(segs)
    if n == 0
        return 0
    let total_cost = 0
    // All segments except the last contribute to cost.
    for i in 0..(n - 1)
        let seg = segs[i]
        let s = seg[0]
        let e = seg[1]
        // Line width used.
        let used = 0
        let j = s
        while j < e
            used = used + len(words[j])
            j = j + 1
        used = used + (e - s - 1)
        let trailing = width - used
        total_cost = total_cost + trailing * trailing
    total_cost

// lb_balance(words, width) -> list
// Balance-break: binary-search for the smallest target_width in
// [max_word_width .. width] such that the greedy layout uses the fewest lines,
// then return lb_greedy_lines at that target_width.
// This minimises the maximum line length (≈ balances the paragraph).
fn lb_balance(words, width) -> list
    let n = len(words)
    if n == 0
        return []
    // Find the maximum single-word width (minimum feasible target).
    let max_word = 0
    for i in 0..n
        let wl = len(words[i])
        if wl > max_word
            max_word = wl
    if max_word >= width
        return lb_greedy_lines(words, width)
    // Binary search for the smallest target_width that keeps the same line
    // count as the full `width`.
    let base_lines = lb_line_count(words, width)
    let lo = max_word
    let hi = width
    while lo < hi
        let mid = (lo + hi) / 2
        let lc = lb_line_count(words, mid)
        if lc <= base_lines
            hi = mid
        else
            lo = mid + 1
    lb_greedy_lines(words, lo)
