// ============================================================================
// NOVA Standard Library — std/textlayout/textindent
// ============================================================================
// Line-level indentation and dedentation utilities for multi-line text.
//
// All functions treat a multi-line text as a single string with lines separated
// by chr(10).  No floats, no external imports.
//
// Public API:
//   ti_indent(text, prefix) -> string
//       Prepend `prefix` to every line of text (including empty lines).
//
//   ti_indent_n(text, n) -> string
//       Indent every line by exactly n spaces.
//
//   ti_dedent(text) -> string
//       Remove the longest common leading-whitespace prefix from all non-empty
//       lines.  Empty lines are left unchanged.
//
//   ti_dedent_n(text, n) -> string
//       Remove up to n leading spaces from each line (stops at first non-space
//       or when n spaces have been consumed).
//
//   ti_common_indent(text) -> int
//       Return the number of leading space characters shared by ALL non-empty
//       lines (tabs are not counted — spaces only).
//
//   ti_strip_lines(text) -> string
//       Strip trailing whitespace (spaces and tabs) from each line.
//
//   ti_indent_first(text, prefix) -> string
//       Indent only the first line with prefix; other lines are unchanged.
//
//   ti_indent_rest(text, prefix) -> string
//       Indent every line except the first with prefix; first line is unchanged.
//
// LEAF — imports NOTHING.

// ── private helpers ──────────────────────────────────────────────────────────

// Repeat a single-char string ch exactly n times.
fn _ti_rep(ch, n) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + ch
        i = i + 1
    out

// Split text into lines on chr(10).  A trailing newline does NOT produce an
// extra empty element; "" returns [].
fn _ti_split_lines(text) -> list
    let result = []
    let n = len(text)
    if n == 0
        return result
    let cur = ""
    let i = 0
    while i < n
        let ch = slice(text, i, i + 1)
        if ch == chr(10)
            result = result + [cur]
            cur = ""
        else
            cur = cur + ch
        i = i + 1
    if len(cur) > 0
        result = result + [cur]
    result

// Join a list of strings with chr(10).
fn _ti_join(lines) -> string
    let out = ""
    let i = 0
    let n = len(lines)
    while i < n
        if i > 0
            out = out + chr(10)
        out = out + lines[i]
        i = i + 1
    out

// Count leading space characters (chr(32) only) in line.
fn _ti_leading_spaces(line) -> int
    let n = len(line)
    let i = 0
    while i < n
        if slice(line, i, i + 1) != " "
            return i
        i = i + 1
    n

// Return the smaller of two ints.
fn _ti_min(a, b) -> int
    if a < b
        return a
    b

// Strip trailing spaces and tabs from a single line.
fn _ti_rstrip(line) -> string
    let n = len(line)
    let end = n
    while end > 0
        let ch = slice(line, end - 1, end)
        if ch == " " or ch == chr(9)
            end = end - 1
        else
            return slice(line, 0, end)
    ""

// ── public API ───────────────────────────────────────────────────────────────

// ti_indent(text, prefix) -> string
// Prepend `prefix` to every line (including blank lines).
// ti_indent("a\nb", "  ") == "  a\n  b"
fn ti_indent(text, prefix) -> string
    let lines = _ti_split_lines(text)
    let n = len(lines)
    if n == 0
        return ""
    let result = []
    let i = 0
    while i < n
        result = result + [prefix + lines[i]]
        i = i + 1
    _ti_join(result)

// ti_indent_n(text, n) -> string
// Indent every line by exactly n spaces.
// ti_indent_n("x\ny", 4) == "    x\n    y"
fn ti_indent_n(text, n) -> string
    let prefix = _ti_rep(" ", n)
    ti_indent(text, prefix)

// ti_common_indent(text) -> int
// Count leading spaces common to ALL non-empty lines.  Returns 0 if any
// non-empty line starts with a non-space or if text has no non-empty lines.
fn ti_common_indent(text) -> int
    let lines = _ti_split_lines(text)
    let nl = len(lines)
    let common = 1000000
    let found = 0
    let i = 0
    while i < nl
        let line = lines[i]
        if len(line) > 0
            let sp = _ti_leading_spaces(line)
            if found == 0
                common = sp
                found = 1
            else
                common = _ti_min(common, sp)
        i = i + 1
    if found == 0
        return 0
    common

// ti_dedent(text) -> string
// Remove the longest common leading-whitespace prefix from all non-empty lines.
// Empty lines are passed through unchanged.
// ti_dedent("    a\n      b") == "a\n  b"  (common=4)
fn ti_dedent(text) -> string
    let common = ti_common_indent(text)
    if common == 0
        return text
    let lines = _ti_split_lines(text)
    let n = len(lines)
    let result = []
    let i = 0
    while i < n
        let line = lines[i]
        if len(line) > 0
            result = result + [slice(line, common, len(line))]
        else
            result = result + [line]
        i = i + 1
    _ti_join(result)

// ti_dedent_n(text, n) -> string
// Remove up to n leading spaces from each line.
// ti_dedent_n("    x", 2) == "  x"
fn ti_dedent_n(text, n) -> string
    let lines = _ti_split_lines(text)
    let nl = len(lines)
    if nl == 0
        return ""
    let result = []
    let i = 0
    while i < nl
        let line = lines[i]
        let llen = len(line)
        let removed = 0
        while removed < n and removed < llen and slice(line, removed, removed + 1) == " "
            removed = removed + 1
        result = result + [slice(line, removed, llen)]
        i = i + 1
    _ti_join(result)

// ti_strip_lines(text) -> string
// Strip trailing whitespace (spaces and tabs) from each line.
fn ti_strip_lines(text) -> string
    let lines = _ti_split_lines(text)
    let n = len(lines)
    if n == 0
        return ""
    let result = []
    let i = 0
    while i < n
        result = result + [_ti_rstrip(lines[i])]
        i = i + 1
    _ti_join(result)

// ti_indent_first(text, prefix) -> string
// Indent only the first line; remaining lines are unchanged.
// ti_indent_first("a\nb", "> ") == "> a\nb"
fn ti_indent_first(text, prefix) -> string
    let lines = _ti_split_lines(text)
    let n = len(lines)
    if n == 0
        return ""
    let result = [prefix + lines[0]]
    let i = 1
    while i < n
        result = result + [lines[i]]
        i = i + 1
    _ti_join(result)

// ti_indent_rest(text, prefix) -> string
// Indent every line EXCEPT the first; the first line is unchanged.
// ti_indent_rest("a\nb", ">") == "a\n>b"
fn ti_indent_rest(text, prefix) -> string
    let lines = _ti_split_lines(text)
    let n = len(lines)
    if n == 0
        return ""
    let result = [lines[0]]
    let i = 1
    while i < n
        result = result + [prefix + lines[i]]
        i = i + 1
    _ti_join(result)
