// std/io/linereader — Line-by-line cursor over a text string.
// lr_new(text)->dict; lr_has_next/lr_next/lr_peek/lr_reset/lr_remaining/lr_all/lr_line_no.
// Private helpers prefixed _lr_ to avoid cross-module collisions.

fn lr_new(text: string)
    let lines = split(text, chr(10))
    let lr = {"lines": lines, "pos": 0}
    return lr

fn lr_has_next(lr)
    let lines = lr["lines"]
    let pos = lr["pos"]
    if pos < len(lines)
        return true
    return false

fn lr_next(lr)
    let lines = lr["lines"]
    let pos = lr["pos"]
    if pos >= len(lines)
        return ""
    let line = lines[pos]
    lr["pos"] = pos + 1
    return line

fn lr_peek(lr)
    let lines = lr["lines"]
    let pos = lr["pos"]
    if pos >= len(lines)
        return ""
    return lines[pos]

fn lr_reset(lr)
    lr["pos"] = 0

fn lr_remaining(lr) -> int
    let lines = lr["lines"]
    let pos = lr["pos"]
    let r = len(lines) - pos
    if r < 0
        return 0
    return r

fn lr_all(lr)
    let lines = lr["lines"]
    let pos = lr["pos"]
    let result = []
    let i = pos
    while i < len(lines)
        result.push(lines[i])
        i = i + 1
    return result

fn lr_line_no(lr) -> int
    return lr["pos"] + 1
