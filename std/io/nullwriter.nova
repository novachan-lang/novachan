// std/io/nullwriter — null writer that discards content but tracks statistics.
//
// WHAT: A null writer behaves like /dev/null for in-memory write operations:
//       every write call discards the content immediately but counts how many
//       bytes and write calls were made.  The writer is represented as a plain
//       dict so callers can inspect or pass it freely.
//
// WHY: Null writers are useful for:
//   - Benchmarking write pipelines without I/O overhead.
//   - Unit-testing code that emits output without caring about the content.
//   - Satisfying writer interfaces when the caller must supply a sink but the
//     result is intentionally thrown away.
//
// DESIGN: The writer dict stores exactly two integer counters:
//   "bytes"  -> total bytes discarded across all write calls
//   "writes" -> total number of write calls made (nw_write or nw_writeln)
//
// nw_writeln adds len(s)+1 to "bytes" to account for the implicit newline
// that a real line-oriented writer would append.
//
// All private helpers are prefixed "_nw_" to avoid cross-module collisions.
//
// API:
//   nw_new()         -> dict   create a fresh null writer (bytes=0, writes=0)
//   nw_write(w, s)   -> void   discard s, add len(s) to bytes, increment writes
//   nw_writeln(w, s) -> void   discard s+newline, add len(s)+1 to bytes, increment writes
//   nw_bytes(w)      -> int    total bytes discarded so far
//   nw_writes(w)     -> int    total write calls made so far
//   nw_reset(w)      -> void   reset both counters to zero

// ─── Public API ──────────────────────────────────────────────────────────────

// Create a new null writer with both counters initialised to zero.
fn nw_new() -> dict
    let w = {}
    w["bytes"] = 0
    w["writes"] = 0
    w

// Discard s and record its length in bytes; increment the write counter.
fn nw_write(w: dict, s: string)
    w["bytes"] = w["bytes"] + len(s)
    w["writes"] = w["writes"] + 1

// Discard s (plus an implicit newline) and record len(s)+1 in bytes;
// increment the write counter.
fn nw_writeln(w: dict, s: string)
    w["bytes"] = w["bytes"] + len(s) + 1
    w["writes"] = w["writes"] + 1

// Return the total number of bytes discarded since creation or last reset.
fn nw_bytes(w: dict) -> int
    w["bytes"]

// Return the total number of write calls made since creation or last reset.
fn nw_writes(w: dict) -> int
    w["writes"]

// Reset both counters to zero without replacing the dict itself.
fn nw_reset(w: dict)
    w["bytes"] = 0
    w["writes"] = 0
