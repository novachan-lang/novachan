// std/io/teewriter — duplicate writes to N in-memory string sinks.
//
// WHAT: A tee writer fans every write call out to N independent string
//       buffers simultaneously, letting the caller later read each buffer
//       independently.  Useful for capturing output that must go to multiple
//       destinations (e.g. a log sink AND an in-memory assertion buffer),
//       testing emit helpers without touching real I/O, or splitting a single
//       stream into N filtered consumers.
//
// WHY: The "tee" primitive (named after the Unix tee(1) command) appears
//      whenever output must be observed at multiple points without duplicating
//      the write logic.  Implementing it by hand means repeating the
//      append-to-each loop everywhere; centralising it here keeps callers
//      clean and makes buffer management obvious.
//
// DESIGN: The tee dict stores:
//   "n"        -> int   number of sinks
//   "buf_<i>"  -> string  accumulated content of sink i  (0-based)
//
// All private helpers are prefixed "_tt_" to avoid cross-module collisions.
//
// API:
//   tt_new(n)        -> dict   create a tee with n empty string sinks
//   tt_write(t, s)   -> void   append s to every sink
//   tt_writeln(t, s) -> void   append s + newline to every sink
//   tt_get(t, i)     -> string contents of sink i (0-based)
//   tt_count(t)      -> int    number of sinks
//   tt_clear(t)      -> void   reset every sink to ""

// ─── internal helpers ────────────────────────────────────────────────────────

// Return the dict key for sink index i.
fn _tt_key(i: int) -> string
    "_tt_buf_" + str(i)

// ─── Public API ──────────────────────────────────────────────────────────────

// Create a new tee writer with n independent empty string sinks.
fn tt_new(n: int) -> dict
    let t = {}
    t["n"] = n
    let i = 0
    while i < n
        let k = _tt_key(i)
        t[k] = ""
        i = i + 1
    t

// Append s verbatim to every sink (no newline added).
fn tt_write(t: dict, s: string)
    let n = t["n"]
    let i = 0
    while i < n
        let k = _tt_key(i)
        t[k] = t[k] + s
        i = i + 1

// Append s + newline to every sink.
fn tt_writeln(t: dict, s: string)
    let n = t["n"]
    let line = s + chr(10)
    let i = 0
    while i < n
        let k = _tt_key(i)
        t[k] = t[k] + line
        i = i + 1

// Return the accumulated contents of sink i (0-based).
fn tt_get(t: dict, i: int) -> string
    let k = _tt_key(i)
    t[k]

// Return the number of sinks in the tee.
fn tt_count(t: dict) -> int
    t["n"]

// Reset every sink to the empty string without changing the sink count.
fn tt_clear(t: dict)
    let n = t["n"]
    let i = 0
    while i < n
        let k = _tt_key(i)
        t[k] = ""
        i = i + 1
