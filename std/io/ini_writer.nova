// std/io/ini_writer — incremental INI writer with comment support.
//
// DUPLICATE-SURVEY NOTE: THREE existing modules already parse+write INI —
// std/data/ini.nova (ini_parse/ini_write), std/encoding/inifmt.nova
// (ini_parse/ini_serialize), and std/os/ini_config.nova (ic_parse/ic_build)
// — but their write sides all take a COMPLETE nested dict (section -> key ->
// value) and none of them can emit a COMMENT: every one of them treats
// comments purely as something the PARSER strips on read, never something
// the WRITER can produce. This module is a genuine complement, not a
// duplicate: it (1) is an INCREMENTAL builder (iniw_set/iniw_add_comment
// calls interleave freely and preserve call order in the rendered output —
// no need to pre-assemble a nested dict), and (2) can emit "; text" comment
// lines at any point within a section, which no existing writer supports.
//
// Model: a section is an ORDERED LIST of entries (comment or key/value), so
// that iniw_add_comment(w, sec, "note") followed by iniw_set(w, sec, k, v)
// renders the comment BEFORE that key, and vice versa — full fidelity to
// call order, not just to final key/value contents.
//
// PUBLIC API (prefix iniw_):
//   iniw_new()                          -> dict    a fresh empty writer
//   iniw_set(w, section, key, value)    ->         set/update key=value in
//                                                    `section` (updating an
//                                                    existing key keeps its
//                                                    original position)
//   iniw_add_comment(w, section, text)  ->         append a comment entry;
//                                                    `text` is split on LF
//                                                    into one "; line" per
//                                                    line so a multi-line
//                                                    comment renders as
//                                                    several comment lines
//   iniw_to_string(w)                   -> string  render full INI text
//                                                    (default section "" —
//                                                    if used — first, with
//                                                    no header; named
//                                                    sections follow in
//                                                    first-seen order)
//   iniw_section_count(w)               -> int     number of sections
//   iniw_key_count(w, section)          -> int     number of key/value
//                                                    entries (comments not
//                                                    counted) in `section`,
//                                                    0 if section is unknown
//
// A value is auto-quoted (wrapped in double quotes) when writing it
// unquoted would not round-trip through a standard INI parser: empty, or
// containing a space/tab/';'/'#' (matching std/data/ini.nova's quoting
// rule, for round-trip compatibility with that module's ini_parse).
//
// LEAF — imports NOTHING.

fn iniw_new() -> dict
    let w = {}
    w["order"] = []
    w["sections"] = {}
    return w

// _iniw_ensure_section: register `section` (idempotent), preserving
// first-seen order in w["order"].
fn _iniw_ensure_section(w: dict, section: string)
    let sections = w["sections"]
    if contains(sections, section) == false
        sections[section] = []
        w["sections"] = sections
        let order = w["order"]
        push(order, section)

// iniw_set: set key=value in `section`. If the key already has an entry in
// this section, its value is updated IN PLACE (original position kept);
// otherwise a new entry is appended.
fn iniw_set(w: dict, section: string, key: string, value: string)
    _iniw_ensure_section(w, section)
    let sections = w["sections"]
    let entries = sections[section]
    let n = len(entries)
    let i = 0
    let found = 0
    while i < n
        let e = entries[i]
        if e["t"] == "kv" and e["k"] == key
            e["v"] = value
            entries[i] = e
            found = 1
            i = n
        else
            i = i + 1
    if found == 0
        let entry = {}
        entry["t"] = "kv"
        entry["k"] = key
        entry["v"] = value
        push(entries, entry)
    sections[section] = entries
    w["sections"] = sections

// iniw_add_comment: append one comment entry per LF-separated line of text.
fn iniw_add_comment(w: dict, section: string, text: string)
    _iniw_ensure_section(w, section)
    let sections = w["sections"]
    let entries = sections[section]
    let lines = split(text, chr(10))
    for i in 0..len(lines)
        let entry = {}
        entry["t"] = "c"
        entry["v"] = lines[i]
        push(entries, entry)
    sections[section] = entries
    w["sections"] = sections

fn iniw_section_count(w: dict) -> int
    let order = w["order"]
    return len(order)

fn iniw_key_count(w: dict, section: string) -> int
    let sections = w["sections"]
    if contains(sections, section) == false
        return 0
    let entries = sections[section]
    let n = len(entries)
    let count = 0
    for i in 0..n
        let e = entries[i]
        if e["t"] == "kv"
            count = count + 1
    return count

// _iniw_needs_quote: matches std/data/ini.nova's round-trip quoting rule.
fn _iniw_needs_quote(v: string) -> int
    let bts = str_to_bytes(v)
    let n = bytes_len(bts)
    if n == 0
        return 1
    for i in 0..n
        let b = bytes_get(bts, i)
        if b == 32 or b == 9 or b == 59 or b == 35
            return 1
    return 0

fn _iniw_write_value(v: string) -> string
    if _iniw_needs_quote(v) == 1
        return chr(34) + v + chr(34)
    return v

// _iniw_write_section_body: append every entry (comment or kv) in order.
fn _iniw_write_section_body(entries: list, buf: any)
    let n = len(entries)
    for i in 0..n
        let e = entries[i]
        if e["t"] == "c"
            buf_append(buf, "; ")
            buf_append(buf, e["v"])
            buf_append_char(buf, 10)
        else
            buf_append(buf, e["k"])
            buf_append(buf, " = ")
            buf_append(buf, _iniw_write_value(e["v"]))
            buf_append_char(buf, 10)

// iniw_to_string: render the full document. Default section "" (if used)
// is emitted first with no [header]; named sections follow in first-seen
// order, each preceded by a [name] header line.
fn iniw_to_string(w: dict) -> string
    let order = w["order"]
    let sections = w["sections"]
    let buf = buffer()
    let first = 1
    if contains(sections, "")
        let entries = sections[""]
        _iniw_write_section_body(entries, buf)
        first = 0
    for i in 0..len(order)
        let sec = order[i]
        if sec != ""
            if first == 0
                buf_append_char(buf, 10)
            first = 0
            buf_append_char(buf, 91)
            buf_append(buf, sec)
            buf_append_char(buf, 93)
            buf_append_char(buf, 10)
            let entries = sections[sec]
            _iniw_write_section_body(entries, buf)
    return buf_to_str(buf)

fn main()
    print("std/io/ini_writer loaded")
