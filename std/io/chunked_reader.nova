// std/io/chunked_reader.nova — Stateful fixed-size and delimiter-based
// chunked reading over a text string.
//
// DUPLICATE-SURVEY NOTE: the originally-assigned name for this slot was
// "fixed_width" (fixed-width columnar field record parser/writer). That
// already exists VERBATIM at std/data/fixedwidth.nova — same fxw_ prefix,
// same three functions (fxw_parse/fxw_parse_all/fxw_format). Rebuilding it
// would be a byte-for-byte duplicate. This module instead covers a
// different io/ niche that is genuinely absent: repeatedly pulling
// FIXED-SIZE chunks (or delimiter-bounded chunks) out of a text stream with
// a mutable cursor. std/io/linereader.nova only splits on newlines,
// std/io/limitreader.nova enforces a single global cap (not repeated
// chunking), and std/io/cursor.nova is a bounds-checked reader over a
// native `bytes` buffer with Result-returning fixed-width numeric reads
// (u16be/etc) — none of them offer "give me the next N characters,
// repeatedly, from a string" or "give me the text up to the next
// delimiter, repeatedly", which this module provides.
//
// Representation: a chunked-reader state is a dict:
//   {"text": string, "pos": int, "size": int}
// Dicts are mutated in place (the shared-codebase convention — see
// std/sketch/reservoir.nova's rs_add / std/io/linereader.nova's lr_next):
// callers pass the same reader value to successive calls without
// reassignment.
//
// Public API (prefix chk_):
//   chk_new(text, size)         -> dict    new reader, size = fixed chunk length (>=1)
//   chk_has_more(r)             -> bool    true iff unread text remains
//   chk_next(r)                 -> string  next chunk of up to `size` chars,
//                                            advances pos; "" if exhausted
//   chk_remaining(r)            -> int     count of unread characters
//   chk_reset(r)                -> unit    rewind pos to 0
//   chk_split(text, size)       -> list    eager: text split into a list of
//                                            fixed-size chunks (last one may
//                                            be shorter)
//   chk_count_chunks(text, size) -> int    number of fixed-size chunks
//                                            text would split into (ceil)
//   chk_next_delim(r, delim)    -> string  text up to (not including) the
//                                            next occurrence of delim,
//                                            advancing pos past the
//                                            delimiter; if delim is not
//                                            found, returns the remaining
//                                            text and exhausts the reader
//
// LEAF — imports NOTHING.

// chk_new: new chunked-reader state. size is clamped to >= 1.
fn chk_new(text, size)
    let s = size
    if s < 1
        s = 1
    let r = {}
    r["text"] = text
    r["pos"] = 0
    r["size"] = s
    return r

// chk_has_more: true iff there is unread text left.
fn chk_has_more(r)
    let text = r["text"]
    let pos = r["pos"]
    return pos < len(text)

// chk_remaining: number of unread characters.
fn chk_remaining(r)
    let text = r["text"]
    let pos = r["pos"]
    let rem = len(text) - pos
    if rem < 0
        return 0
    return rem

// chk_reset: rewind the reader to the start of its text.
fn chk_reset(r)
    r["pos"] = 0

// chk_next: the next chunk of up to `size` characters, advancing pos.
// Returns "" once exhausted.
fn chk_next(r)
    let text = r["text"]
    let pos = r["pos"]
    let size = r["size"]
    let n = len(text)
    if pos >= n
        return ""
    let end = pos + size
    if end > n
        end = n
    let chunk = slice(text, pos, end)
    r["pos"] = end
    return chunk

// chk_next_delim: text from the current position up to (not including) the
// next occurrence of delim (a single-character or multi-character string),
// advancing pos past the delimiter. If delim does not occur again, returns
// all remaining text and exhausts the reader (pos = len(text)).
fn chk_next_delim(r, delim)
    let text = r["text"]
    let pos = r["pos"]
    let n = len(text)
    if pos >= n
        return ""
    let dn = len(delim)
    let i = pos
    let found = -1
    while i <= n - dn
        if slice(text, i, i + dn) == delim
            found = i
            i = n
        else
            i = i + 1
    if found < 0
        let rest = slice(text, pos, n)
        r["pos"] = n
        return rest
    let piece = slice(text, pos, found)
    r["pos"] = found + dn
    return piece

// chk_split: eagerly split text into a list of fixed-size chunks (the last
// one may be shorter than size).
fn chk_split(text, size)
    let s = size
    if s < 1
        s = 1
    let n = len(text)
    let out = []
    let i = 0
    while i < n
        let e = i + s
        if e > n
            e = n
        push(out, slice(text, i, e))
        i = e
    return out

// chk_count_chunks: number of fixed-size chunks text would split into
// (ceil(len(text) / size)). Returns 0 for empty text.
fn chk_count_chunks(text, size)
    let s = size
    if s < 1
        s = 1
    let n = len(text)
    if n == 0
        return 0
    let full = n / s
    let rem = n - full * s
    if rem > 0
        return full + 1
    return full
