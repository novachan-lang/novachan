// ============================================================================
// NOVA Standard Library — std/encoding/latin1
// ============================================================================
// Latin-1 (ISO-8859-1) codec over bytes.
//
// ISO-8859-1 is a trivial but widely-used single-byte encoding where each
// codepoint U+0000..U+00FF maps to exactly the byte value 0x00..0xFF. It
// underpins HTTP/1.1 default charset, MIME latin1, legacy C-library locales,
// and many wire protocols. Because every byte value is a valid codepoint, this
// codec NEVER fails on input — there are no illegal sequences.
//
// BINARY-SAFETY PROPERTY:
//   NOVA strings are NUL-terminated C-string-shaped: a 0x00 inside a string
//   silently truncates it (reference_nova_string_nul_truncation). Latin-1
//   strings containing U+0000 (e.g. raw ISO-8859-1 data with a 0x00 byte)
//   CANNOT be represented as a NOVA string. The ENCODE side converts a NOVA
//   string (codepoints 0..255 guaranteed by the caller) to `bytes`; the DECODE
//   side converts `bytes` to a NOVA string, which is safe as long as no byte
//   is 0x00. The is_latin1 check returns false for strings containing chr(0)
//   so callers know when the round-trip is sound.
//
// PUBLIC API:
//   l1_encode(s: string) -> bytes
//     Encodes a string whose codepoints are all in 0..255 to raw bytes.
//     Each character becomes exactly one byte equal to ord(char).
//     If a codepoint is > 255 the byte is silently stored as (codepoint & 0xFF)
//     — callers SHOULD check l1_is_latin1 first for strict correctness.
//
//   l1_decode(b: bytes) -> string
//     Converts raw bytes to a string by mapping each byte to chr(byte).
//     Since NOVA chr() builds a one-character string and concatenation works,
//     this is always well-defined for byte values 1..255.
//     A 0x00 byte in input will produce chr(0) which NUL-truncates the
//     resulting string — callers must avoid 0x00 bytes for text use.
//
//   l1_is_latin1(s: string) -> bool
//     Returns true iff every character in s has ord <= 255.
//     (All ASCII strings trivially satisfy this. Any char with ord > 255 fails.)
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _l1_ to avoid collisions when other
//   std modules are compiled into the same binary.
//
// LEAF — imports NOTHING.

// ── Public API ────────────────────────────────────────────────────────────────

// l1_encode: encode a Latin-1 string to raw bytes.
//
// Each character in s maps to exactly one byte equal to ord(char) & 0xFF.
// The resulting bytes object has bytes_len == len(s).
//
// Pre-condition (not enforced): every char in s has ord <= 255.
// Characters with ord > 255 are silently truncated to the low 8 bits.
//
// Examples:
//   l1_encode("AB")        -> bytes of [65, 66],  bytes_len = 2
//   l1_encode("Hi!")       -> bytes of [72, 105, 33], bytes_len = 3
//   l1_encode(chr(200))    -> bytes of [200], bytes_len = 1
//   l1_encode("")          -> bytes of [],    bytes_len = 0
fn l1_encode(s) -> any
    let n = len(s)
    let out = bytes(0)
    for i in 0..n
        let b = ord(s[i]) & 0xFF
        out = bytes_append(out, b)
    out

// l1_decode: decode raw bytes to a Latin-1 string.
//
// Each byte b maps to chr(b), building the string by concatenation.
// bytes_len(input) == len(result) for all inputs that contain no 0x00 bytes.
// A 0x00 byte in `b` will NUL-truncate the resulting NOVA string — callers
// must ensure no 0x00 bytes exist when text fidelity is required.
//
// Examples:
//   l1_decode(bytes of [65, 66])         -> "AB"
//   l1_decode(bytes of [72, 105, 33])    -> "Hi!"
//   l1_decode(bytes of [200])            -> chr(200)
//   l1_decode(bytes of [])               -> ""
fn l1_decode(b) -> string
    let n = bytes_len(b)
    let out_parts = []
    for i in 0..n
        let bv = bytes_get(b, i) & 0xFF
        push(out_parts, chr(bv))
    let out = join(out_parts, "")
    out

// l1_is_latin1: test whether every character in s is in the Latin-1 range.
//
// Returns true iff for all i: ord(s[i]) <= 255.
// ASCII strings (ord <= 127) always return true.
// Empty string returns true (vacuously).
//
// Examples:
//   l1_is_latin1("hello")   -> true
//   l1_is_latin1(chr(200))  -> true   (U+00C8 is in Latin-1)
//   l1_is_latin1(chr(256))  -> false  (U+0100 is outside Latin-1)
//   l1_is_latin1("")        -> true
fn l1_is_latin1(s) -> bool
    let n = len(s)
    for i in 0..n
        if ord(s[i]) > 255
            return false
    true
