// ============================================================================
// NOVA Standard Library — std/encoding/varint
// ============================================================================
// LEB128 variable-length integer encoding over native `bytes`.
//
// LEB128 (Little-Endian Base-128) is the wire format used by Protocol Buffers,
// DWARF debug info, WebAssembly, and many other binary protocols. It encodes
// small integers compactly: values 0..127 occupy ONE byte, values 128..16383
// occupy TWO bytes, etc.  Large values cost more bytes — up to 10 bytes for a
// 64-bit integer — but the common case is cheap.
//
// UNSIGNED ENCODING (vi_encode / vi_decode):
//   Each byte stores 7 payload bits. The high bit (0x80) is a "more bytes
//   follow" flag. The last byte of an encoding has the high bit clear.
//   Payload bits are ordered LSB-first across the byte sequence.
//
//   Example: 300 = 0b1_0010_1100
//     byte 0: 0b1_010_1100 | 0x80 = 0xAC  (7 low bits + continuation)
//     byte 1: 0b0_000_0010           = 0x02  (remaining bits, no continuation)
//     → [0xAC, 0x02] = [172, 2]
//
// SIGNED ENCODING (vi_encode_signed / vi_decode_signed):
//   Uses zigzag mapping before LEB128 so that small negative integers also
//   encode compactly. The mapping is:
//     encode:  n >= 0  =>  2*n          (even: 0->0, 1->2, 2->4, ...)
//              n <  0  =>  -2*n - 1     (odd:  -1->1, -2->3, -3->5, ...)
//     decode:  u even  =>  u / 2
//              u odd   =>  -((u + 1) / 2)
//
// PUBLIC API:
//   vi_encode(n)              -> bytes   unsigned LEB128 of non-negative n
//   vi_decode(buf, pos)       -> list    [value, next_pos]; unsigned LEB128
//   vi_size(n)                -> int     byte count that vi_encode would produce
//   vi_encode_signed(n)       -> bytes   zigzag + unsigned LEB128; n may be neg
//   vi_decode_signed(buf,pos) -> list    [value, next_pos]; reverse zigzag
//
// ARITHMETIC HAZARDS:
//   >> IS ARITHMETIC IN NOVA (sign-extends negative values).
//   For unsigned shifts we always mask: (n >> k) & _VI_MASK63 or similar.
//   The zigzag encode uses explicit if/else instead of bit-tricks to avoid
//   the 1<<63 / n>>63 overflow hazard documented in reference_nova_shift64_broken.
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _vi_ to avoid cross-module collisions.
//
// LEAF — imports NOTHING.

// ── Private constants / helpers ───────────────────────────────────────────────

// Mask to keep the low 7 payload bits of any value.
fn _vi_low7(n) -> int
    n & 0x7F

// True when n needs more LEB128 bytes (n >= 128 in unsigned context).
// n is always non-negative at the call site.
fn _vi_more(n) -> int
    if n >= 128
        1
    else
        0

// ── Public API ────────────────────────────────────────────────────────────────

// vi_encode: encode a non-negative integer as unsigned LEB128 bytes.
//
// Precondition: n >= 0.  Negative inputs produce an empty bytes(0).
//
// The encoding loop:
//   while n >= 128:
//       emit (n & 0x7F) | 0x80   -- 7 low bits with continuation flag
//       n = (n >> 7) & mask      -- shift right 7; mask clears sign-ext bits
//   emit n & 0x7F               -- last byte, high bit 0
//
// NOVA's >> is arithmetic, but n is non-negative throughout the loop so
// sign-extension never activates.  We mask after the shift anyway for safety.
fn vi_encode(n) -> any
    let buf = bytes(0)
    if n < 0
        return buf
    let v = n
    let going = 1
    while going == 1
        if v >= 128
            buf = bytes_append(buf, (_vi_low7(v)) | 0x80)
            v = (v >> 7) & 0x00FFFFFFFFFFFFFF
        else
            buf = bytes_append(buf, _vi_low7(v))
            going = 0
    buf

// vi_decode: decode an unsigned LEB128 integer from buf starting at pos.
//
// Returns a 2-element list: [decoded_value, next_pos].
// Reads bytes until it finds one with the high bit clear (or runs out of buf).
// If pos is past the end of buf, returns [0, pos] (safe zero-return).
//
// Payload bits are accumulated LSB-first: bit group i contributes 7*i bits.
fn vi_decode(buf, pos) -> list
    let result = [0, pos]
    let value = 0
    let shift = 0
    let i = pos
    let nb = bytes_len(buf)
    let going = 1
    while going == 1 and i < nb
        let b = bytes_get(buf, i) & 0xFF
        let payload = b & 0x7F
        value = value | (payload << shift)
        shift += 7
        i += 1
        if (b & 0x80) == 0
            going = 0
    result[0] = value
    result[1] = i
    result

// vi_size: return the number of bytes vi_encode(n) would produce.
//
// Equivalent to ceil(bits_needed / 7) but computed iteratively to stay
// consistent with vi_encode without duplicating the loop body.
// n >= 0 required; returns 1 for n == 0 (zero encodes as a single 0x00 byte).
fn vi_size(n) -> int
    if n < 0
        return 0
    let count = 0
    let v = n
    let going = 1
    while going == 1
        count += 1
        v = (v >> 7) & 0x00FFFFFFFFFFFFFF
        if v == 0
            going = 0
    count

// vi_encode_signed: encode a signed integer using zigzag + unsigned LEB128.
//
// Zigzag mapping (avoids sign-extension hazards from >> on negatives in NOVA):
//   n >= 0  =>  2 * n          (maps 0->0, 1->2, 2->4, ...)
//   n <  0  =>  (-2 * n) - 1  (maps -1->1, -2->3, -3->5, ...)
//
// After zigzag the value is non-negative, so standard vi_encode applies.
fn vi_encode_signed(n) -> any
    let u = 0
    if n >= 0
        u = 2 * n
    else
        u = (-2 * n) - 1
    vi_encode(u)

// vi_decode_signed: decode a zigzag + unsigned LEB128 signed integer.
//
// Returns [value, next_pos] just like vi_decode, but un-applies zigzag:
//   u even  =>  u / 2
//   u odd   =>  -((u + 1) / 2)
fn vi_decode_signed(buf, pos) -> list
    let raw = vi_decode(buf, pos)
    let u = raw[0]
    let next = raw[1]
    let signed_val = 0
    if (u & 1) == 0
        signed_val = u / 2
    else
        signed_val = -((u + 1) / 2)
    [signed_val, next]
