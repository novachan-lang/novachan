// ============================================================================
// NOVA Standard Library — std/encoding/ndjson
// ============================================================================
// NDJSON / JSON Lines (jsonlines.org).
//
// One JSON value per physical line. A "physical line" is delimited by a RAW
// newline byte in the text — never by a `\n` *escape sequence* that appears
// inside a JSON string literal. Those two are different things at the byte
// level: the escape sequence is the two ASCII bytes `\` and `n` (backslash,
// then the letter n); a raw newline is the single control byte 0x0A. Because
// we split on the single control byte only, a string value such as
// `{"c":"x\ny"}` (where `\n` is the two-byte escape written in the source)
// is never split — json_decode is the one that turns that two-byte escape
// into an actual 0x0A character inside the decoded string, not us.
//
// PUBLIC API:
//   ndjson_parse(text) -> list
//     Parse an NDJSON document into a list of decoded JSON values, one per
//     non-blank line (REUSES json_decode -- no hand-rolled JSON parsing).
//     - Blank lines (empty, or whitespace-only after CR-strip) are skipped.
//     - Both LF ("\n") and CRLF ("\r\n") line endings are accepted.
//     - A trailing newline (or its absence) does not change the result.
//     - Empty input -> [].
//
//   ndjson_write(values) -> string
//     Serialize a list of values to NDJSON text: one json_stringify per
//     line, each followed by a trailing "\n" (including the last line).
//     Empty list -> "" (zero lines, no trailing newline to add).
//
// DESIGN NOTES:
//   • Uses native json_decode / json_stringify — no hand-rolled JSON.
//   • Line splitting: split(text, chr(10)). CRLF-terminated lines keep a
//     trailing chr(13), which _ndj_strip_cr removes before the blank-line
//     test and before handing the line to json_decode (a stray CR byte
//     inside what should be the JSON value would otherwise make it invalid
//     JSON — e.g. `{"a":1}\r` is not valid JSON on its own).
//   • "Blank" = trim(line) == "" after CR-strip, so whitespace-only lines
//     (e.g. a line of only spaces) are treated as blank too, matching the
//     lenient behavior of common NDJSON readers.
//   • ndjson_write always appends a trailing "\n" after every line
//     (including the last), per NDJSON convention (jsonlines.org: files
//     SHOULD end with a newline). This differs deliberately from a plain
//     `join`, which would place newlines only *between* elements.
//   • Single-exit style throughout to avoid the NOVA return-null mistag.
//   • Brace interpolation hazard: this file's comments use literal braces
//     only in comments (never in string literals), so no chr(123)/chr(125)
//     escaping is needed here.
//
// LEAF — imports NOTHING (json_decode / json_stringify / trim / split /
// slice / chr / ord / len are native builtins).
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// Strip a single trailing CR (chr(13)) from a line, if present.
// Lets ndjson_parse handle both LF-only and CRLF line endings uniformly.
fn _ndj_strip_cr(line) -> string
    let result = line
    let n = len(line)
    if n > 0
        if ord(line[n - 1]) == 13
            result = slice(line, 0, n - 1)
    result

// Return 1 if `line` is blank (empty or whitespace-only) after CR-stripping.
fn _ndj_is_blank(line) -> int
    let stripped = _ndj_strip_cr(line)
    let trimmed = trim(stripped)
    let result = 0
    if len(trimmed) == 0
        result = 1
    result

// ── Public API ───────────────────────────────────────────────────────────────

// ndjson_parse: parse an NDJSON text into a list of decoded JSON values.
//
// Algorithm:
//   1. Split on chr(10) (raw newline byte) to get candidate lines. Escaped
//      "\n" sequences *inside* a JSON string literal are two ordinary bytes
//      (backslash, n) at this point in the text -- they are not the 0x0A
//      byte we split on, so they never cause a spurious split.
//   2. Strip a trailing chr(13) from each candidate (CRLF tolerance).
//   3. Skip blank lines (empty or whitespace-only).
//   4. Pass each remaining line to json_decode and collect the result.
//
// Returns an empty list for empty or all-blank input.
fn ndjson_parse(text) -> list
    let results = []
    let lines = split(text, chr(10))
    let i = 0
    let n = len(lines)
    while i < n
        let raw = lines[i]
        if _ndj_is_blank(raw) == 0
            let line = _ndj_strip_cr(raw)
            let val = json_decode(line)
            results.push(val)
        i += 1
    results

// ndjson_write: serialize a list of values to NDJSON text.
//
// Each element is json_stringify'd and followed by a trailing "\n" -- so
// the output always has exactly one "\n" per input value, including after
// the last one. An empty list produces "" (no lines at all).
fn ndjson_write(values) -> string
    let result_parts = []
    let i = 0
    let n = len(values)
    while i < n
        let line = json_stringify(values[i])
        push(result_parts, line + chr(10))
        i += 1
    let result = join(result_parts, "")
    result
