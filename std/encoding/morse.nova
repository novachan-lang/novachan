// ============================================================================
// NOVA Standard Library — std/encoding/morse
// ============================================================================
// International Morse code (ITU-R M.1677-1) for letters A-Z and digits 0-9.
// Spaces in the input are treated as word separators.
//
// PUBLIC API:
//   mo_encode(s: string) -> string
//     Encode a string to Morse code.
//     - Letters (A-Z, case-insensitive) are converted to dot/dash sequences.
//     - Digits (0-9) are converted to their Morse equivalents.
//     - Individual letter/digit codes are separated by a single space " ".
//     - Input spaces (word boundaries) become " / " in the output.
//     - Unknown characters are silently skipped.
//
//   mo_decode(s: string) -> string
//     Decode a Morse code string back to plaintext (uppercase).
//     - Single space " " between letter codes (within a word).
//     - " / " between words (produces a space character in output).
//     - Unknown codes are replaced with "?".
//
// KNOWN-ANSWER EXAMPLES:
//   mo_encode("SOS")      == "... --- ..."
//   mo_encode("HI")       == ".... .."
//   mo_encode("A B")      == ".- / -...."
//   mo_encode("E")        == "."
//   mo_encode("1")        == ".----"
//   mo_decode("... --- ...") == "SOS"
//   mo_decode(".- / -....")  == "A B"
//   mo_decode(mo_encode("HELLO")) == "HELLO"
//
// LEAF — imports NOTHING.

// ── Private: letter/digit -> Morse dot/dash string ───────────────────────────

// Return the Morse code for a single UPPERCASE letter (A-Z) or digit (0-9).
// Returns "" for any other character so callers can skip it.
fn _mo_char_code(c) -> string
    if c == "A" then return ".-"
    if c == "B" then return "-..."
    if c == "C" then return "-.-."
    if c == "D" then return "-.."
    if c == "E" then return "."
    if c == "F" then return "..-."
    if c == "G" then return "--."
    if c == "H" then return "...."
    if c == "I" then return ".."
    if c == "J" then return ".---"
    if c == "K" then return "-.-"
    if c == "L" then return ".-.."
    if c == "M" then return "--"
    if c == "N" then return "-."
    if c == "O" then return "---"
    if c == "P" then return ".--."
    if c == "Q" then return "--.-"
    if c == "R" then return ".-."
    if c == "S" then return "..."
    if c == "T" then return "-"
    if c == "U" then return "..-"
    if c == "V" then return "...-"
    if c == "W" then return ".--"
    if c == "X" then return "-..-"
    if c == "Y" then return "-.--"
    if c == "Z" then return "--.."
    if c == "0" then return "-----"
    if c == "1" then return ".----"
    if c == "2" then return "..---"
    if c == "3" then return "...--"
    if c == "4" then return "....-"
    if c == "5" then return "....."
    if c == "6" then return "-...."
    if c == "7" then return "--..."
    if c == "8" then return "---.."
    if c == "9" then return "----."
    ""

// ── Private: uppercase a single character ────────────────────────────────────

fn _mo_upper_char(c) -> string
    let b = ord(c)
    if b >= 97 and b <= 122
        return chr(b - 32)
    c

// ── Private: Morse dot/dash string -> letter/digit ───────────────────────────

// Reverse lookup: dot/dash pattern -> uppercase character (or "?" if unknown).
fn _mo_decode_symbol(sym) -> string
    if sym == ".-"   then return "A"
    if sym == "-..." then return "B"
    if sym == "-.-." then return "C"
    if sym == "-.."  then return "D"
    if sym == "."    then return "E"
    if sym == "..-." then return "F"
    if sym == "--."  then return "G"
    if sym == "...." then return "H"
    if sym == ".."   then return "I"
    if sym == ".---" then return "J"
    if sym == "-.-"  then return "K"
    if sym == ".-.." then return "L"
    if sym == "--"   then return "M"
    if sym == "-."   then return "N"
    if sym == "---"  then return "O"
    if sym == ".--." then return "P"
    if sym == "--.-" then return "Q"
    if sym == ".-."  then return "R"
    if sym == "..."  then return "S"
    if sym == "-"    then return "T"
    if sym == "..-"  then return "U"
    if sym == "...-" then return "V"
    if sym == ".--"  then return "W"
    if sym == "-..-" then return "X"
    if sym == "-.--" then return "Y"
    if sym == "--.." then return "Z"
    if sym == "-----" then return "0"
    if sym == ".----" then return "1"
    if sym == "..---" then return "2"
    if sym == "...--" then return "3"
    if sym == "....-" then return "4"
    if sym == "....." then return "5"
    if sym == "-...." then return "6"
    if sym == "--..." then return "7"
    if sym == "---.." then return "8"
    if sym == "----." then return "9"
    "?"

// ── Public API ───────────────────────────────────────────────────────────────

// mo_encode: convert plaintext to Morse code.
//
// Letters A-Z (case-insensitive) and digits 0-9 are encoded.
// Input spaces become " / " (word separator). Unknown chars are skipped.
//
// Examples:
//   mo_encode("SOS")  == "... --- ..."
//   mo_encode("HI")   == ".... .."
//   mo_encode("A B")  == ".- / -...."
//   mo_encode("1")    == ".----"
fn mo_encode(s) -> string
    let out = ""
    let n = len(s)
    let i = 0
    // track whether we need a separator before the next symbol
    let need_sep = 0
    while i < n
        let c = _mo_upper_char(s[i])
        if c == " "
            // word boundary: emit " / " but only if we have already emitted something
            if need_sep == 1
                out = out + " / "
                need_sep = 0
        else
            let code = _mo_char_code(c)
            if len(code) > 0
                if need_sep == 1
                    out = out + " "
                out = out + code
                need_sep = 1
        i = i + 1
    out

// mo_decode: convert Morse code back to plaintext (uppercase).
//
// Single space between letter symbols within a word.
// " / " separates words (produces a space in the output).
// Unknown symbols are replaced with "?".
//
// Examples:
//   mo_decode("... --- ...")  == "SOS"
//   mo_decode(".- / -....")  == "A B"
//   mo_decode(mo_encode("HELLO")) == "HELLO"
fn mo_decode(s) -> string
    let out = ""
    let n = len(s)
    let i = 0
    // accumulate current symbol characters
    let sym = ""
    // process character by character; symbols are separated by " "
    // word separators are " / " which we detect as " / "
    while i < n
        let c = s[i]
        if c == " "
            // look ahead: is this " / " (word separator)?
            // pattern " / " means: current char is space, next is '/', then space
            if i + 2 < n and s[i+1] == "/" and s[i+2] == " "
                // flush current symbol if any
                if len(sym) > 0
                    out = out + _mo_decode_symbol(sym)
                    sym = ""
                // emit word space
                out = out + " "
                // skip " / " (3 chars total: we consumed the leading space here)
                i = i + 3
            else
                // plain inter-letter space: flush current symbol
                if len(sym) > 0
                    out = out + _mo_decode_symbol(sym)
                    sym = ""
                i = i + 1
        else
            sym = sym + c
            i = i + 1
    // flush the last symbol
    if len(sym) > 0
        out = out + _mo_decode_symbol(sym)
    out
