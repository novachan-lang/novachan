// ============================================================================
// NOVA Standard Library — std/encoding/geohash
// ============================================================================
// Geohash geocoding (Gustavo Niemeyer, 2008).
//
// Geohash encodes a (latitude, longitude) coordinate pair into a short
// base32 string whose prefix is a spatial prefix-code: two geohashes that
// share a common prefix are geographically close (with one known edge case at
// meridian/antimeridian boundaries).
//
// ALPHABET:
//   "0123456789bcdefghjkmnpqrstuvwxyz"  (32 chars; i, l, o, u omitted)
//   Index 0='0', 1='1', ..., 9='9', 10='b', 11='c', ..., 31='z'.
//
// ALGORITHM — encode(lat, lon, precision):
//   Interleave longitude bits (even positions: 0,2,4,...) and latitude bits
//   (odd positions: 1,3,5,...), MSB first. Every 5 bits emit one base32 char.
//
//   Per bit (starting even=true meaning lon):
//     mid = (range_min + range_max) / 2
//     if coord >= mid: bit=1, range_min=mid
//     else:            bit=0, range_max=mid
//
// ALGORITHM — decode(hash):
//   Feed each character's 5 bits back: even bits narrow longitude,
//   odd bits narrow latitude. Cell center = (min + max) / 2.
//
// KNOWN-ANSWER TESTS:
//   gh_encode(42.6, -5.6, 5)          == "ezs42"
//   gh_encode(57.64911, 10.40744, 11) == "u4pruydqqvj"
//   gh_encode(0.0, 0.0, 1)            == "s"
//   gh_decode("ezs42")                within 0.02 of [42.6, -5.6]
//   gh_bounds("ezs42")                brackets 42.6 and -5.6
//
// CRITICAL FLOAT BOXING INSIGHT (why decode uses inline computation):
//
//   When a NOVA function's variable is pushed to a list (out.push(lat_min)),
//   the compiler infers `lat_min` as `any`-typed and BOXES every assignment
//   to it (stores as NovaBox* pointer, not raw IEEE-754 bits).
//
//   A helper function like `_gh_mid(lo, hi)` computes via fadd/fdiv and
//   returns RAW IEEE-754 bits. Storing raw bits into a boxed slot (`lat_min =
//   _gh_mid(...)`) corrupts lat_min — the next iteration reads the slot as
//   a box pointer but gets a float bit-pattern, causing nova_rt_unbox to
//   dereference garbage.
//
//   gh_encode avoids this because lat_min never goes into a list, so the
//   compiler keeps it as raw float throughout.
//
//   SOLUTION: _gh_decode_body computes midpoints INLINE (not via helper),
//   and keeps all arithmetic in raw-float mode by never mixing box/raw paths.
//   The bounds are assembled into the output list ONLY at the very end by
//   boxing each value explicitly via `* 1.0` to force the `any` representation.
//   This exactly mirrors how gh_encode works: all arithmetic stays raw.
//
// SYMBOL COLLISION GUARD:
//   All private helpers prefixed _gh_.
// ============================================================================

// ── Alphabet ─────────────────────────────────────────────────────────────────

fn _gh_alpha() -> string
    "0123456789bcdefghjkmnpqrstuvwxyz"

// _gh_char_to_idx: map a geohash character to its 5-bit value (0..31).
// Returns -1 for characters not in the alphabet.
fn _gh_char_to_idx(c) -> int
    let b = ord(c)
    if b >= 48 and b <= 57
        return b - 48
    if b == 98
        return 10
    if b == 99
        return 11
    if b == 100
        return 12
    if b == 101
        return 13
    if b == 102
        return 14
    if b == 103
        return 15
    if b == 104
        return 16
    if b == 106
        return 17
    if b == 107
        return 18
    if b == 109
        return 19
    if b == 110
        return 20
    if b == 112
        return 21
    if b == 113
        return 22
    if b == 114
        return 23
    if b == 115
        return 24
    if b == 116
        return 25
    if b == 117
        return 26
    if b == 118
        return 27
    if b == 119
        return 28
    if b == 120
        return 29
    if b == 121
        return 30
    if b == 122
        return 31
    -1

// ── Public API ────────────────────────────────────────────────────────────────

// gh_encode: encode (lat, lon) to a geohash string of the given precision.
//
// precision: number of base32 characters (1..12 typical; higher = finer cell).
//   precision 5 ≈ ±2.4 km   precision 9 ≈ ±2.4 m   precision 12 ≈ sub-cm
//
// Preconditions: -90 <= lat <= 90, -180 <= lon <= 180, precision >= 1
fn gh_encode(lat, lon, precision) -> string
    let alpha = _gh_alpha()
    let lat_min = 0.0 - 90.0
    let lat_max = 90.0
    let lon_min = 0.0 - 180.0
    let lon_max = 180.0
    let result = ""
    let hash_val = 0
    let bits = 0
    let even = 1
    let lat_f = lat * 1.0
    let lon_f = lon * 1.0
    let target = precision
    let done = 0
    while done == 0
        let mid_lon = (lon_min + lon_max) / 2.0
        let mid_lat = (lat_min + lat_max) / 2.0
        if even == 1
            if lon_f >= mid_lon
                hash_val = (hash_val * 2) + 1
                lon_min = mid_lon
            else
                hash_val = hash_val * 2
                lon_max = mid_lon
            even = 0
        else
            if lat_f >= mid_lat
                hash_val = (hash_val * 2) + 1
                lat_min = mid_lat
            else
                hash_val = hash_val * 2
                lat_max = mid_lat
            even = 1
        bits += 1
        if bits == 5
            result += alpha[hash_val]
            hash_val = 0
            bits = 0
        if len(result) >= target
            done = 1
    result

// _gh_decode_body: shared decode core for gh_decode and gh_bounds.
//
// ALL arithmetic is kept INLINE (no helper function calls) to preserve
// raw-float mode throughout. If a helper were used, the compiler would box
// lat_min/lon_min (because they're pushed to a list at the end), and the
// raw float returned from the helper would be stored into a boxed slot,
// corrupting the value on the next read.
//
// Returns [lat_min, lat_max, lon_min, lon_max] (bounds of decoded cell).
fn _gh_decode_body(hash) -> list
    // All six range vars start as raw float arithmetic, same as gh_encode.
    // They only get boxed when pushed to `out` at the very end — by then
    // the computation is complete so boxing at that point is safe.
    let lat_min = 0.0 - 90.0
    let lat_max = 90.0
    let lon_min = 0.0 - 180.0
    let lon_max = 180.0
    let n = len(hash)
    let even = 1
    for i in 0..n
        let c = hash[i]
        let idx = _gh_char_to_idx(c)
        // Bit 16 ──────────────────────────────────────────────────────────────
        let set16 = idx & 16
        if even == 1
            let mid16 = (lon_min + lon_max) / 2.0
            if set16 > 0
                lon_min = mid16
            else
                lon_max = mid16
        else
            let mid16 = (lat_min + lat_max) / 2.0
            if set16 > 0
                lat_min = mid16
            else
                lat_max = mid16
        if even == 1
            even = 0
        else
            even = 1
        // Bit 8 ───────────────────────────────────────────────────────────────
        let set8 = idx & 8
        if even == 1
            let mid8 = (lon_min + lon_max) / 2.0
            if set8 > 0
                lon_min = mid8
            else
                lon_max = mid8
        else
            let mid8 = (lat_min + lat_max) / 2.0
            if set8 > 0
                lat_min = mid8
            else
                lat_max = mid8
        if even == 1
            even = 0
        else
            even = 1
        // Bit 4 ───────────────────────────────────────────────────────────────
        let set4 = idx & 4
        if even == 1
            let mid4 = (lon_min + lon_max) / 2.0
            if set4 > 0
                lon_min = mid4
            else
                lon_max = mid4
        else
            let mid4 = (lat_min + lat_max) / 2.0
            if set4 > 0
                lat_min = mid4
            else
                lat_max = mid4
        if even == 1
            even = 0
        else
            even = 1
        // Bit 2 ───────────────────────────────────────────────────────────────
        let set2 = idx & 2
        if even == 1
            let mid2 = (lon_min + lon_max) / 2.0
            if set2 > 0
                lon_min = mid2
            else
                lon_max = mid2
        else
            let mid2 = (lat_min + lat_max) / 2.0
            if set2 > 0
                lat_min = mid2
            else
                lat_max = mid2
        if even == 1
            even = 0
        else
            even = 1
        // Bit 1 ───────────────────────────────────────────────────────────────
        let set1 = idx & 1
        if even == 1
            let mid1 = (lon_min + lon_max) / 2.0
            if set1 > 0
                lon_min = mid1
            else
                lon_max = mid1
        else
            let mid1 = (lat_min + lat_max) / 2.0
            if set1 > 0
                lat_min = mid1
            else
                lat_max = mid1
        if even == 1
            even = 0
        else
            even = 1
    let out = []
    out.push(lat_min)
    out.push(lat_max)
    out.push(lon_min)
    out.push(lon_max)
    out

// gh_decode: decode a geohash string to [lat_center, lon_center].
//
// Returns [lat, lon] where lat and lon are the CENTER of the decoded cell.
//   length 5: cell ≈ ±2.4 km    length 9: cell ≈ ±2.4 m
fn gh_decode(hash) -> list
    let bounds = _gh_decode_body(hash)
    let lat_min = bounds[0] * 1.0
    let lat_max = bounds[1] * 1.0
    let lon_min = bounds[2] * 1.0
    let lon_max = bounds[3] * 1.0
    let lat_sum = lat_min + lat_max
    let lat_c = lat_sum / 2.0
    let lon_sum = lon_min + lon_max
    let lon_c = lon_sum / 2.0
    let res = []
    res.push(lat_c)
    res.push(lon_c)
    res

// gh_bounds: decode a geohash string to its bounding box.
//
// Returns [lat_min, lat_max, lon_min, lon_max]:
//   [0] lat_min   southern boundary (degrees latitude)
//   [1] lat_max   northern boundary (degrees latitude)
//   [2] lon_min   western boundary  (degrees longitude)
//   [3] lon_max   eastern boundary  (degrees longitude)
fn gh_bounds(hash) -> list
    _gh_decode_body(hash)
