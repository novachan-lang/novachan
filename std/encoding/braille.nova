// ============================================================================
// NOVA Standard Library — std/encoding/braille
// ============================================================================
// Braille Grade-1 (uncontracted) encoding / decoding for Unicode Braille
// Patterns (U+2800–U+283F).
//
// A Braille cell is the Unicode character U+2800 + bitmask, where dot k sets
// bit (k-1).  Dots 1-6 are used for standard Grade-1 text:
//   dot 1 -> bit 0 (value 1)
//   dot 2 -> bit 1 (value 2)
//   dot 3 -> bit 2 (value 4)
//   dot 4 -> bit 3 (value 8)
//   dot 5 -> bit 4 (value 16)
//   dot 6 -> bit 5 (value 32)
//
// Supported input: lowercase letters a-z and space.  Unknown characters in
// br_from_text are passed through as-is; br_to_text silently drops cells
// that don't map back to a known character.
//
// PUBLIC API:
//   br_dots(ch)           -> list of int   Dot numbers for one letter/space.
//   br_cell(dots)         -> string        One Braille char from a dot list.
//   br_from_text(s)       -> string        Encode a string to Braille.
//   br_to_text(braille)   -> string        Decode a Braille string back to text.
//
// KNOWN-ANSWER EXAMPLES:
//   br_dots("a")  == [1]
//   br_dots("c")  == [1,4]
//   br_cell([1])  == from_codepoint(10241)   // U+2801
//   br_from_text("a") == from_codepoint(10241)
//   br_from_text("b") == from_codepoint(10243)
//   br_from_text(" ") == from_codepoint(10240)
//   br_to_text(br_from_text("hello")) == "hello"
//
// LEAF — imports NOTHING.

// ── Private: dot number -> bit value lookup ──────────────────────────────────
//
// Maps dot numbers 1-6 to their corresponding bitmask contributions.
// This avoids a pow2(d-1) call which triggers a NOVA int/float ABI issue
// when the argument is derived from a list element inside a while loop.
fn _br_dot_val(d) -> int
    let t = [1, 2, 4, 8, 16, 32]
    if d >= 1 and d <= 6
        return t[d - 1]
    0

// Compute the bitmask for a list of dot numbers (each 1-6).
fn _br_dots_to_mask(dots) -> int
    reduce(dots, (acc, d) => acc + _br_dot_val(d), 0)

// ── Private: letter -> dot list ──────────────────────────────────────────────

fn _br_char_dots(ch) -> list
    let t = {
        "a": [1], "b": [1, 2], "c": [1, 4], "d": [1, 4, 5], "e": [1, 5],
        "f": [1, 2, 4], "g": [1, 2, 4, 5], "h": [1, 2, 5], "i": [2, 4],
        "j": [2, 4, 5], "k": [1, 3], "l": [1, 2, 3], "m": [1, 3, 4],
        "n": [1, 3, 4, 5], "o": [1, 3, 5], "p": [1, 2, 3, 4],
        "q": [1, 2, 3, 4, 5], "r": [1, 2, 3, 5], "s": [2, 3, 4],
        "t": [2, 3, 4, 5], "u": [1, 3, 6], "v": [1, 2, 3, 6],
        "w": [2, 4, 5, 6], "x": [1, 3, 4, 6], "y": [1, 3, 4, 5, 6],
        "z": [1, 3, 5, 6], " ": [],
    }
    t.get(ch, [])

// ── Private: bitmask -> letter ───────────────────────────────────────────────
//
// Each letter's mask is computed from its dot list:
//   a=[1]           mask=1
//   b=[1,2]         mask=3
//   c=[1,4]         mask=9
//   d=[1,4,5]       mask=25
//   e=[1,5]         mask=17
//   f=[1,2,4]       mask=11
//   g=[1,2,4,5]     mask=27
//   h=[1,2,5]       mask=19
//   i=[2,4]         mask=10
//   j=[2,4,5]       mask=26
//   k=[1,3]         mask=5
//   l=[1,2,3]       mask=7
//   m=[1,3,4]       mask=13
//   n=[1,3,4,5]     mask=29
//   o=[1,3,5]       mask=21
//   p=[1,2,3,4]     mask=15
//   q=[1,2,3,4,5]   mask=31
//   r=[1,2,3,5]     mask=23
//   s=[2,3,4]       mask=14
//   t=[2,3,4,5]     mask=30
//   u=[1,3,6]       mask=37
//   v=[1,2,3,6]     mask=39
//   w=[2,4,5,6]     mask=58
//   x=[1,3,4,6]     mask=45
//   y=[1,3,4,5,6]   mask=61
//   z=[1,3,5,6]     mask=53
//   space=[]        mask=0
fn _br_mask_to_char(mask) -> string
    let t = {
        0: " ", 1: "a", 3: "b", 9: "c", 25: "d", 17: "e", 11: "f",
        27: "g", 19: "h", 10: "i", 26: "j", 5: "k", 7: "l", 13: "m",
        29: "n", 21: "o", 15: "p", 31: "q", 23: "r", 14: "s", 30: "t",
        37: "u", 39: "v", 58: "w", 45: "x", 61: "y", 53: "z",
    }
    t.get(mask, "")

// ── Private: decode one Braille UTF-8 cell ───────────────────────────────────
//
// Read a UTF-8 braille cell (U+2800-U+28FF) from byte-string bs at byte
// position pos.  Each cell encodes as the 3-byte UTF-8 sequence:
//   0xE2 (226) 0xA0 (160) (0x80+mask) where mask = codepoint - 0x2800.
// Returns the bitmask (0-63) or -1 if the bytes do not form a valid Braille
// cell from the basic 6-dot block (U+2800-U+283F, mask 0-63).
fn _br_read_cell(bs, pos) -> int
    let blen = bytes_len(bs)
    if pos + 2 >= blen
        return -1
    let b0 = bytes_get(bs, pos)
    let b1 = bytes_get(bs, pos + 1)
    let b2 = bytes_get(bs, pos + 2)
    // UTF-8 for U+2800-U+28FF: lead byte=0xE2=226, cont1=0xA0=160, cont2=0x80..0xBF
    if b0 == 226 and b1 == 160 and b2 >= 128 and b2 <= 191
        return b2 - 128
    -1

// ── Private: check if a character is a known braille-encodable character ─────
fn _br_is_known(ch) -> int
    if ch == " " then return 1
    if len(_br_char_dots(ch)) > 0 then return 1
    0

// ── Public API ───────────────────────────────────────────────────────────────

// br_dots: return the list of Braille dot numbers for a lowercase letter
// or space.  Returns [] for unknown input.
//
// Examples:
//   br_dots("a") == [1]
//   br_dots("c") == [1, 4]
//   br_dots(" ") == []
fn br_dots(ch) -> list
    _br_char_dots(ch)

// br_cell: given a list of dot numbers (1-6), return the single Braille
// Unicode character string.
//
// Examples:
//   br_cell([1])     == from_codepoint(10241)   // "a" U+2801
//   br_cell([1,2])   == from_codepoint(10243)   // "b" U+2803
//   br_cell([])      == from_codepoint(10240)   // space U+2800
//   br_cell([1,4])   == from_codepoint(10249)   // "c" U+2809
fn br_cell(dots) -> string
    let mask = _br_dots_to_mask(dots)
    // U+2800 = 10240
    from_codepoint(10240 + mask)

// br_from_text: encode a plaintext string to Unicode Braille.
//
// Lowercase letters a-z and spaces are encoded to their Grade-1 Braille
// cell.  Unknown characters are passed through unchanged.
//
// Examples:
//   br_from_text("a") == from_codepoint(10241)
//   br_from_text("b") == from_codepoint(10243)
//   br_from_text(" ") == from_codepoint(10240)
//   br_from_text("hello")  -- five Braille cells
fn br_from_text(s) -> string
    let out = ""
    for ch in s
        if _br_is_known(ch) == 1
            let dots = _br_char_dots(ch)
            let mask = _br_dots_to_mask(dots)
            out = out + from_codepoint(10240 + mask)
        else
            out = out + ch
    out

// br_to_text: decode a Unicode Braille string back to plaintext.
//
// Each Braille cell (3-byte UTF-8 U+2800-U+28FF) is mapped back to the
// corresponding lowercase letter or space.  Cells that don't correspond to a
// known Grade-1 letter are silently dropped.  Non-Braille bytes are also
// skipped.
//
// Examples:
//   br_to_text(br_from_text("hello")) == "hello"
//   br_to_text(br_from_text("abc"))   == "abc"
fn br_to_text(braille) -> string
    let bs = str_to_bytes(braille)
    let blen = bytes_len(bs)
    let out_parts = []
    let i = 0
    while i < blen
        let mask = _br_read_cell(bs, i)
        if mask >= 0
            let ch = _br_mask_to_char(mask)
            if len(ch) > 0
                push(out_parts, ch)
            i = i + 3
        else
            i = i + 1
    let out = join(out_parts, "")
    out
