// ============================================================================
// NOVA Standard Library — std/encoding/crc16
// ============================================================================
// CRC-16 checksum variants over `bytes` values.
//
// VARIANTS PROVIDED:
//   c16_ccitt_false(data: bytes) -> int
//     CRC-16/CCITT-FALSE: poly=0x1021, init=0xFFFF, no bit-reflection.
//     Used in: HDLC, SD cards, some Bluetooth profiles, SpaceWire.
//     KAT: "123456789" -> 0x29B1 (10673)
//
//   c16_xmodem(data: bytes) -> int
//     CRC-16/XMODEM (aka CRC-16/ACORN): poly=0x1021, init=0x0000, no reflect.
//     Used in: XMODEM file transfer protocol, some aerospace protocols.
//     KAT: "123456789" -> 0x31C3 (12739)
//
//   c16_modbus(data: bytes) -> int
//     CRC-16/MODBUS: poly=0x8005 (processed reflected as 0xA001), init=0xFFFF,
//     bit-reflection of both input bytes and final CRC (LSB-first processing).
//     Used in: Modbus RTU serial protocol, widely in industrial automation.
//     KAT: "123456789" -> 0x4B37 (19255)
//
// ALGORITHM — bit-by-bit (no lookup table):
//   All three variants use a bit-by-bit loop. No table pre-computation means
//   no multi-line list literals (which NOVA does not support) and no startup
//   cost. For the byte volumes typical of Modbus/HDLC frames (<512 bytes) this
//   is plenty fast.
//
// ARITHMETIC HAZARD — >> IS ARITHMETIC IN NOVA:
//   NOVA's right-shift sign-extends. We must mask after every shift:
//     (crc >> 1) & 0x7FFF  — preserve only the 15 bits we want
//     (crc >> 15) & 1      — extract only the MSB (bit 15), not sign bit
//   We also mask the accumulator with &0xFFFF at every XOR to prevent
//   accumulation of garbage in high bits.
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _c16_ to avoid collisions when multiple
//   std modules are compiled into the same binary.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Build a bytes value from an ASCII string. Used in tests and internally.
// NB: Input must be pure ASCII (bytes 1..127); 0x00 input chars would
// produce a 0x00 byte which the _bytes helper cannot represent safely via
// string indexing — but for CRC KAT inputs ("123456789") this is fine.
fn _bytes(s) -> any
    let out = bytes(0)
    let i = 0
    let n = len(s)
    while i < n
        out = bytes_append(out, ord(char_at(s, i)) & 0xFF)
        i = i + 1
    out

// ── CRC-16/CCITT-FALSE ────────────────────────────────────────────────────────
//
// poly=0x1021, init=0xFFFF, RefIn=false, RefOut=false, XorOut=0x0000
//
// Algorithm (MSB-first, no reflection):
//   For each byte B, for each bit b7..b0 (MSB first):
//     crc_bit15 = (crc >> 15) & 1    ← top bit before shift
//     crc = ((crc << 1) | incoming_bit) & 0xFFFF
//     if crc_bit15 == 1: crc = crc XOR 0x1021   (& 0xFFFF kept)
//
// Equivalent standard formulation (process byte 8 bits, MSB first):
//   For each byte B:
//     crc = crc XOR (B << 8)
//     for 8 iterations:
//       msb = (crc >> 15) & 1      ← arithmetic-safe extraction
//       crc = (crc << 1) & 0xFFFF ← keep 16 bits
//       if msb == 1: crc = (crc XOR 0x1021) & 0xFFFF

fn c16_ccitt_false(data) -> int
    let crc = 0xFFFF
    let nb = bytes_len(data)
    let i = 0
    while i < nb
        let b = bytes_get(data, i) & 0xFF
        // XOR byte into high octet of CRC register
        crc = (crc ^ (b << 8)) & 0xFFFF
        // Process 8 bits, MSB first
        let bit = 0
        while bit < 8
            let msb = (crc >> 15) & 1
            crc = (crc << 1) & 0xFFFF
            if msb == 1
                crc = (crc ^ 0x1021) & 0xFFFF
            bit = bit + 1
        i = i + 1
    crc & 0xFFFF

// ── CRC-16/XMODEM ─────────────────────────────────────────────────────────────
//
// poly=0x1021, init=0x0000, RefIn=false, RefOut=false, XorOut=0x0000
//
// Identical to CCITT-FALSE but starts with crc=0x0000 instead of 0xFFFF.
// This is the variant used in the original XMODEM file transfer protocol.

fn c16_xmodem(data) -> int
    let crc = 0x0000
    let nb = bytes_len(data)
    let i = 0
    while i < nb
        let b = bytes_get(data, i) & 0xFF
        crc = (crc ^ (b << 8)) & 0xFFFF
        let bit = 0
        while bit < 8
            let msb = (crc >> 15) & 1
            crc = (crc << 1) & 0xFFFF
            if msb == 1
                crc = (crc ^ 0x1021) & 0xFFFF
            bit = bit + 1
        i = i + 1
    crc & 0xFFFF

// ── CRC-16/MODBUS ─────────────────────────────────────────────────────────────
//
// poly=0x8005, init=0xFFFF, RefIn=true, RefOut=true, XorOut=0x0000
//
// Because input and output are both reflected (LSB-first processing),
// the equivalent algorithm processes poly in its reflected form 0xA001:
//
//   For each byte B:
//     crc = crc XOR B                          (XOR into low byte)
//     for 8 iterations:
//       lsb = crc & 1                          (LSB-first: check low bit)
//       crc = (crc >> 1) & 0x7FFF             (right-shift, mask arithmetic)
//       if lsb == 1: crc = (crc ^ 0xA001) & 0xFFFF
//
// The reflected poly 0xA001 = bit-reverse of 0x8005 (16 bits):
//   0x8005 = 1000 0000 0000 0101 b
//   reflect = 1010 0000 0000 0001 b = 0xA001 ✓

fn c16_modbus(data) -> int
    let crc = 0xFFFF
    let nb = bytes_len(data)
    let i = 0
    while i < nb
        let b = bytes_get(data, i) & 0xFF
        // XOR byte into low octet (LSB-first / reflected processing)
        crc = (crc ^ b) & 0xFFFF
        // Process 8 bits, LSB first
        let bit = 0
        while bit < 8
            let lsb = crc & 1
            // Arithmetic-safe right-shift: mask away sign-extended bits
            crc = (crc >> 1) & 0x7FFF
            if lsb == 1
                crc = (crc ^ 0xA001) & 0xFFFF
            bit = bit + 1
        i = i + 1
    crc & 0xFFFF
