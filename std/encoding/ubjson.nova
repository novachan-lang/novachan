// ============================================================================
// NOVA Standard Library — std/encoding/ubjson (Universal Binary JSON)
// ============================================================================
import std/encoding/pack
// WHAT: UBJSON (ubjson.org, draft-12) binary encoder/decoder — a JSON data
// model (null/bool/number/string/array/object) laid out as compact, typed
// binary instead of text. Every value is a 1-byte type MARKER followed by its
// payload; containers are delimited by `[`/`]` and `{`/`{` marker bytes
// (no text punctuation, no whitespace, no escaping).
//
// REUSE, NOT REINVENTION.
//   * Fixed-width big-endian integers -> std/encoding/pack (pack_i8/u8/i16_be/
//     i32_be/i64_be + the matching unpack_* readers). UBJSON integers are
//     BIG-endian (network order) — the `_be` half of pack.nova, unlike
//     std/encoding/bson and std/encoding/avro which are little-endian formats
//     and use the `_le` half. Same module, opposite endianness selection.
//   * float32 narrow/widen -> the exact std/encoding/avro `av_encode_float` /
//     `av_decode_float` technique (alloc_raw/ptr_write_f32/ptr_read_u32/
//     free_raw to get an exact IEEE-754 single bit pattern; f32_from_bits to
//     safely widen back — there is no safe f32_to_bits builtin).
//   * float64 exact bits -> float_to_bits/float_from_bits (same technique as
//     std/encoding/bson's double field).
//   * bytes<->string -> str_to_bytes/bytes_to_str (same builtins bson.nova
//     uses for its cstring/string readers).
// This module adds ONLY the UBJSON-specific pieces: marker bytes, the
// smallest-fits-the-value integer/float type selection, and the recursive
// value/array/object grammar.
//
// TYPE MARKERS (draft-12 core set; this module implements ALL of them):
//   Z null   N no-op (padding within a container; see NO-OP MARKER below)
//   T true   F false   C char(1 ASCII byte, DECODE ONLY — NOVA has
//   no separate char type; a 1-char value always ENCODES as S, matching every
//   published UBJSON encoder and this module's own byte-exact KAT)
//   i int8   U uint8   I int16   l int32   L int64
//   d float32   D float64
//   S string  (marker + length AS A NESTED OPTIMIZED INT + UTF-8 bytes)
//   [ ... ]   array      { ... }   object (key = length-prefixed UTF-8 bytes,
//                                           NO marker byte on the key itself)
// NOT implemented: the OPTIONAL draft-12 "strongly/count-optimized container"
// extension (`[$<type>#<count> ...]`). The task's byte-exact spec examples
// ([1,2] -> 5B 69 01 69 02 5D, {"a":1} -> 7B 69 01 61 69 01 7D) are the
// UNoptimized container form with no $/# — that is what this module emits
// and what its decoder expects. A future extension could add container
// optimization as a pure size optimization without changing this API.
//
// INTEGER "SMALLEST MARKER THAT FITS" RULE (matches the spec's own examples):
//   -128..127    -> i (int8, 1 byte payload)
//    128..255    -> U (uint8, 1 byte payload)   [uint8 is 0..255, but 0..127
//                                                 already went to i above, so
//                                                 in practice U only fires for
//                                                 128..255 — verified against
//                                                 the spec's 255 -> U example]
//   -32768..32767 (outside the above)          -> I (int16, 2 bytes)
//   -2147483648..2147483647 (outside above)    -> l (int32, 4 bytes)
//   otherwise                                   -> L (int64, 8 bytes)
// This selection is used BOTH for scalar integer values AND for every
// length prefix (string length, object-key length) — exactly as the spec's
// own {"a":1} example shows a length of 1 encoded as `i 01`, not a fixed
// width.
//
// FLOAT "SMALLEST THAT LOSES NO PRECISION" RULE: a float is narrowed to a
// true IEEE-754 float32 and widened back; if that round-trip reproduces the
// EXACT original f64 bit pattern, `d` (float32, 4 bytes) is emitted,
// otherwise `D` (float64, 8 bytes, always lossless since NOVA floats ARE
// f64). This mirrors the integer "smallest that fits" policy for the float
// domain and is always safe: decode never loses precision either way.
//
// BOOL / NULL DISAMBIGUATION (type_of(true) == "int" in NOVA — see
// std/encoding/bson's identical note). A bare NOVA bool value that has been
// stored in a `list`/`dict` of `any` is INDISTINGUISHABLE from a real int by
// type_of, so the default policy (matching bson.nova) is: a plain int always
// encodes as one of i/U/I/l/L. To force an explicit UBJSON `T`/`F` marker,
// wrap the value with ubjson_bool(v) before inserting it into a list/dict,
// e.g. d["active"] = ubjson_bool(true). Symmetrically, a bare `null` is
// represented by NOVA as raw int 0 THE MOMENT it crosses ANY function-call
// boundary through a generically-typed (`any`) parameter — verified this is
// not limited to container storage: even the direct top-level call
// `ubjson_encode(null)` cannot see "null" inside ubjson_encode(v) (type_of(v)
// reports "int"), so it indistinguishably encodes as int 0, identically to
// `ubjson_encode(0)`. This holds for a bare null stored in a list/dict too.
// use ubjson_null() to force an explicit `Z` marker in ANY of these
// positions — this is the ONLY reliable way to emit `Z` for a value (as
// opposed to type_of(v)=="null", which fires only for a null NEVER passed
// through a function-call boundary, i.e. effectively never through this
// module's own public API).
//
// SENTINEL-KEY COLLISION SAFETY. ubjson_bool()/ubjson_null() work by handing
// the encoder a wrapper `dict` that ubjson_encode recognizes by shape. A
// naive version of this trick (recognize-by-sole-key-name alone, e.g. "a
// dict whose only key is literally the string \"$ubjsonBool\"") is UNSOUND:
// an ordinary user dict that happens to have that exact sole key (e.g. a
// caller building `{"$ubjsonBool": 1}` as genuine data — not through
// ubjson_bool() at all) would be silently misencoded as a bool marker
// instead of a real 1-entry object. To make this collision-proof against any
// *ordinary* dict, the wrapper is required to carry a SECOND key holding a
// fixed 64-bit magic constant (_ub_bool_magic()/_ub_null_magic()) that no
// legitimate caller would ever independently construct by accident:
// recognition requires BOTH the exact 2-key shape AND the exact magic value
// on the second key, not merely a matching key name — the same technique
// std/encoding/plist's plist_bool()/plist_null() use (_plist_bool_magic()/
// _plist_null_magic()). A plain dict with sole key "$ubjsonBool" (any
// value) now always encodes as an ordinary 1-entry UBJSON object, exactly
// like any other user dict (see ubjson_kat_sentinel_collision_safe). The
// SAME 2-key + magic-value technique guards the third wrapper this module
// adds, ubjson_noop() (see NO-OP MARKER below): _ub_noop_magic() plays the
// identical role as _ub_bool_magic()/_ub_null_magic().
//
// NO-OP MARKER (`N`, 0x4E). Per the UBJSON spec, No-Op is a zero-payload
// value used purely as PADDING inside a container — "its use is entirely up
// to the implementer" — and this module now implements it (closing a real
// gap: the header previously claimed "this module implements ALL of them"
// while omitting N entirely). ubjson_noop() produces the wrapper this
// module's encoder recognizes as an explicit bare `N` byte (magic-guarded,
// same as ubjson_bool()/ubjson_null()). On DECODE, an `N` encountered as an
// ARRAY element is skipped — it contributes NO element to the decoded list,
// exactly matching the spec's "padding, not data" semantics — so
// `ubjson_decode(ubjson_encode([ubjson_noop(), 1]))` decodes to `[1]`, not
// `[null, 1]`. An `N` is NOT accepted in an OBJECT's key-length position
// (the spec never defines no-op-as-a-key; a byte there that is not one of
// the five int markers is rejected as a malformed length prefix — see
// _ub_decode_len — rather than silently treated as a disguised
// zero-length key, which would be exactly the "accept a hostile input by
// guessing what it probably meant" failure mode this module refuses to
// have). A bare top-level `N` (the entire document is just one no-op byte)
// decodes to Ok(null) — a defensible, documented edge, not a crash.
//
// DECODE-ERROR VS. LEGITIMATE-VALUE SAFETY (the actual defect this revision
// closes). Before this fix, ubjson_decode(b) returned a plain NOVA value
// (`any`) on EVERY call, malformed input included: a truncated int8 payload
// silently produced int 0, an empty buffer silently produced int 0, a
// hostile negative length prefix was silently clamped to an empty string.
// Every one of those fallback values is ALSO a completely legitimate decode
// result for well-formed input (`ubjson_encode(0)` decodes to that exact
// same int 0; `ubjson_encode("")` decodes to that exact same ""). A caller
// therefore had NO WAY to distinguish "the wire bytes were garbage" from
// "the wire bytes legitimately encoded a zero/empty value" — precisely the
// name-only "legitimate value indistinguishable from a not-found/error
// sentinel" collision class std/encoding/plist.nova and std/encoding/bson.nova
// document for their own bool/null wrapper dicts (see SENTINEL-KEY COLLISION
// SAFETY above). The fix here goes one step further than plist's own
// plist_error()/plist_is_error(): those are recognized by dict SHAPE (sole
// key literally "$plistError"), which — like the pre-fix ubjson_bool()/
// ubjson_null() — is ITSELF only a name-only match with no magic-value
// guard, so a real decoded plist dict `{"$plistError": "oops"}` would
// misreport as an error. ubjson_decode(b) now returns NOVA's native
// `Result<any, string>` (`ok(v)` / `err(msg)`) instead of inventing another
// dict-shaped sentinel: Result is a compiler-native polymorphic sum (see
// NOVA_DESIGN/NOVA_LANGUAGE_FEATURES.md), never a `dict` value at all, so
// there is no shape or key name a legitimate decoded document could ever
// construct that collides with it — the collision class is closed
// STRUCTURALLY, not by picking a "sufficiently unlikely" marker. Malformed/
// truncated/hostile input is now REJECTED via `err(msg)` — never silently
// guessed at — while every well-formed document (including one that
// legitimately decodes to 0, "", or null) round-trips as `ok(value)`. See
// ubjson_decode's own comment and the DECODE section below for exactly
// which conditions are rejected.
//
// BINARY SAFETY (`bytes` values). UBJSON's core spec has no dedicated binary
// blob marker (only the OPTIONAL container-optimization extension has one,
// via `[$U#<count> ...]`, not implemented here). A NOVA `bytes` value is
// therefore encoded as a plain UBJSON ARRAY of uint8 integers (each byte its
// own i/U-marked int, per the integer rule above) — NEVER routed through
// bytes_to_str, because embedded 0x00 in a NOVA string is a silent
// C-string-truncation hazard for later len()/`+` operations (see
// reference_nova_string_nul_truncation). This makes `bytes` round-trip
// LOSSLESSLY as data, though the decoded NOVA type is a `list` of ints
// (there is no `S`-shaped marker to signal "give me back a `bytes` handle,
// not a `list`" — the same documented value<->wire asymmetry bson.nova
// accepts for its own binary subtype).
//
// STRING / KEY DECODING SAFETY. String VALUES and object KEYS are the only
// spans this module ever passes through bytes_to_str, and only for EXACTLY
// the declared length (bytes_slice(b, start, start+len)) — never scanned for
// a terminator. This is what makes UBJSON's length-prefixed framing immune
// to the classic "control byte injected into a name closes the frame early"
// class of bug: a key or string payload may contain ANY byte value,
// including 0x7B/0x7D/0x5B/0x5D (the container marker bytes) or 0x00 — the
// decoder consumes exactly the declared byte count via bytes_slice, never by
// scanning for a delimiter, so an embedded marker byte can never be
// misread as a second frame boundary. (See ubjson_key_injection_kat below.)
//
// ADVERSARIAL-INPUT ROBUSTNESS (malformed/truncated/hostile streams never
// crash, never hang, and are now REJECTED in-band rather than guessed at —
// see DECODE-ERROR VS. LEGITIMATE-VALUE SAFETY above for why a defensive
// fallback VALUE is no longer an acceptable outcome for bad input):
//   * Every runtime bytes_get/bytes_slice call is bounds-safe by construction
//     (nova_runtime.c clamps out-of-range reads to 0 / an empty slice — see
//     nova_rt_bytes_get / nova_rt_bytes_slice), and every multi-byte scalar
//     read is ALSO explicitly bounds-checked before it is attempted (see
//     _ub_decode_at) — a truncated payload is rejected with err(...), never
//     silently read as a zero-padded fake value.
//   * A corrupt/negative length prefix (e.g. a hostile `i FF` = -1 in a
//     string-length or key-length position) is REJECTED by _ub_decode_len,
//     which also requires the byte AT the length position to be one of the
//     five int markers (i/U/I/l/L) before ever decoding it — a hostile
//     length slot that is itself another container/string/no-op marker
//     (type confusion) is rejected the same way, never mis-parsed as a
//     disguised length. This is also what keeps the decode cursor
//     monotonically non-decreasing: a rejected length prefix stops the
//     decode immediately rather than moving the cursor backward.
//   * Array/object decoding loops on `cur < n and marker != close`; running
//     off the end of the buffer WITHOUT having seen the closing marker is
//     now an explicit err("...unterminated...") rather than a silent
//     truncate-and-return.
//   * An unrecognized marker byte is rejected with err(...) (never silently
//     decoded as null-and-advance) — an unknown/future marker byte is
//     genuinely malformed input for this module's grammar, not a value this
//     module can safely guess the shape of.
//
// PUBLIC API
//   ubjson_encode(v)      -> bytes    encode any NOVA value (int/float/bool*
//                                      /string/list/dict/bytes/null/no-op*)
//                                      to UBJSON
//   ubjson_decode(b)      -> Result   Ok(value) for a well-formed buffer
//                                      (any legitimate value, including one
//                                      that is 0/""/null), Err(message) for
//                                      ANY malformed/truncated/hostile input
//                                      — see DECODE-ERROR VS. LEGITIMATE-
//                                      VALUE SAFETY above; never exits,
//                                      never crashes, never hangs, never
//                                      silently guesses
//   ubjson_bool(v)        -> any      force an explicit T/F marker (above)
//   ubjson_null()         -> any      force an explicit Z marker in a
//                                      list/dict position (see above)
//   ubjson_noop()         -> any      force an explicit N marker (padding)
//                                      in a list position (see NO-OP MARKER)
//
// COMPETITIVE NOTE. UBJSON's core design goal (per ubjson.org) is "JSON's
// data model, binary-fast, remains diffable/browsable in a hex editor" — it
// intentionally trades MessagePack/CBOR's smaller wire size (no int-value
// prefix packing below the smallest fixed marker) for a fixed,
// easy-to-hand-verify grammar. NOVA's implementation matches every
// published UBJSON encoder's byte-exact output for the spec's own worked
// examples (see the KAT) and, via the length-prefixed grammar, is naturally
// immune to text-protocol-style delimiter injection that a hand-rolled
// binary-via-string encoding could introduce.

// ── marker byte constants (named so call sites read as intent) ────────────
fn _ub_m_null() -> int
    0x5A                             // 'Z'
fn _ub_m_noop() -> int
    0x4E                             // 'N' (no-op / padding, see header)
fn _ub_m_true() -> int
    0x54                             // 'T'
fn _ub_m_false() -> int
    0x46                             // 'F'
fn _ub_m_int8() -> int
    0x69                             // 'i'
fn _ub_m_uint8() -> int
    0x55                             // 'U'
fn _ub_m_int16() -> int
    0x49                             // 'I'
fn _ub_m_int32() -> int
    0x6C                             // 'l'
fn _ub_m_int64() -> int
    0x4C                             // 'L'
fn _ub_m_float32() -> int
    0x64                             // 'd'
fn _ub_m_float64() -> int
    0x44                             // 'D'
fn _ub_m_char() -> int
    0x43                             // 'C'
fn _ub_m_string() -> int
    0x53                             // 'S'
fn _ub_m_arr_open() -> int
    0x5B                             // '['
fn _ub_m_arr_close() -> int
    0x5D                             // ']'
fn _ub_m_obj_open() -> int
    0x7B                             // '{'
fn _ub_m_obj_close() -> int
    0x7D                             // '}'

// ── explicit-type wrapper constructors (bool/null disambiguation) ─────────
// Same sentinel-dict technique as std/encoding/bson's bson_bool/bson_null —
// see the header comment for why this is necessary (type_of(true) == "int",
// and a bare null in a list/dict is stored as raw int 0, in NOVA) — hardened
// against sentinel-key collision with an ordinary user dict (see
// SENTINEL-KEY COLLISION SAFETY above), the same 2-key + magic-constant
// technique std/encoding/plist's plist_bool()/plist_null() use: each
// wrapper carries a second key holding a fixed magic constant that
// ubjson_encode requires to match exactly, in addition to the 2-key shape,
// before treating the dict as anything other than plain user data.

fn _ub_bool_magic() -> int
    // ASCII "UBJSBOOL" read as a big-endian 64-bit int — an arbitrary,
    // human-recognizable constant an ordinary caller would never happen to
    // store as the value of a "$ubjsonBoolMagic" key by coincidence.
    0x55424A53424F4F4C

fn _ub_null_magic() -> int
    // ASCII "UBJSNULL" — same purpose as _ub_bool_magic(), for the null
    // wrapper.
    0x55424A534E554C4C

fn _ub_noop_magic() -> int
    // ASCII "UBJSNOOP" — same purpose as _ub_bool_magic()/_ub_null_magic(),
    // for the no-op wrapper (see NO-OP MARKER in the header comment).
    0x55424A534E4F4F50

fn ubjson_bool(v) -> any
    let d = {}
    let bbit = 0
    if v != 0
        bbit = 1
    d["$ubjsonBool"] = bbit
    d["$ubjsonBoolMagic"] = _ub_bool_magic()
    return d

fn ubjson_null() -> any
    let d = {}
    d["$ubjsonNull"] = 1
    d["$ubjsonNullMagic"] = _ub_null_magic()
    return d

fn ubjson_noop() -> any
    let d = {}
    d["$ubjsonNoop"] = 1
    d["$ubjsonNoopMagic"] = _ub_noop_magic()
    return d

// ── encode: smallest-fits-the-value integer (marker + payload) ────────────
// Used for BOTH scalar int values and every length prefix (string length,
// object-key length) — the spec's own {"a":1} example shows a length of 1
// laid down as `i 01`, not a fixed width, so this ONE function serves both
// call sites (no duplicated range-selection logic).
fn _ub_int_bytes(n) -> any
    let out = bytes_create(0)
    if n >= -128 and n <= 127
        out = bytes_append(out, _ub_m_int8())
        out = bytes_concat(out, pack_i8(n))
    else if n >= 128 and n <= 255
        out = bytes_append(out, _ub_m_uint8())
        out = bytes_concat(out, pack_u8(n))
    else if n >= -32768 and n <= 32767
        out = bytes_append(out, _ub_m_int16())
        out = bytes_concat(out, pack_i16_be(n))
    else if n >= -2147483648 and n <= 2147483647
        out = bytes_append(out, _ub_m_int32())
        out = bytes_concat(out, pack_i32_be(n))
    else
        out = bytes_append(out, _ub_m_int64())
        out = bytes_concat(out, pack_i64_be(n))
    out

// ── encode: float (smallest-that-loses-no-precision: d then D) ────────────
// Narrows to a true IEEE-754 float32 via the raw-memory primitives (no safe
// f32_to_bits builtin exists — same technique as std/encoding/avro's
// av_encode_float), then checks whether widening back reproduces the exact
// original f64. If yes, 4-byte `d` is both correct and smaller; otherwise
// falls back to the always-exact 8-byte `D`.
fn _ub_encode_float(v) -> any
    let bits32 = 0
    unsafe
        let p = alloc_raw(4)
        ptr_write_f32(p, v)
        bits32 = ptr_read_u32(p)
        free_raw(p)
    let widened = f32_from_bits(bits32)
    let out = bytes_create(0)
    if widened == v
        out = bytes_append(out, _ub_m_float32())
        out = bytes_concat(out, pack_u32_be(bits32))
    else
        out = bytes_append(out, _ub_m_float64())
        out = bytes_concat(out, pack_u64_be(float_to_bits(v)))
    out

// ── encode: string value (S marker + optimized-int length + UTF-8 bytes) ──
fn _ub_encode_string(s) -> any
    let sb = str_to_bytes(s)
    let out = bytes_append(bytes_create(0), _ub_m_string())
    out = bytes_concat(out, _ub_int_bytes(bytes_len(sb)))
    out = bytes_concat(out, sb)
    out

// ── encode: object key (optimized-int length + UTF-8 bytes, NO marker) ────
fn _ub_encode_key(s) -> any
    let sb = str_to_bytes(s)
    let out = _ub_int_bytes(bytes_len(sb))
    out = bytes_concat(out, sb)
    out

// ── encode: bytes value as an array of uint8 (see header BINARY SAFETY) ───
fn _ub_encode_bytes(bv) -> any
    let out = bytes_append(bytes_create(0), _ub_m_arr_open())
    let n = bytes_len(bv)
    for i in 0..n
        out = bytes_concat(out, _ub_int_bytes(bytes_get(bv, i) & 0xFF))
    out = bytes_append(out, _ub_m_arr_close())
    out

// ── encode: array ───────────────────────────────────────────────────────
fn _ub_encode_array(lst) -> any
    let out = bytes_append(bytes_create(0), _ub_m_arr_open())
    let n = len(lst)
    for i in 0..n
        out = bytes_concat(out, ubjson_encode(lst[i]))
    out = bytes_append(out, _ub_m_arr_close())
    out

// ── encode: object ──────────────────────────────────────────────────────
fn _ub_encode_object(d) -> any
    let out = bytes_append(bytes_create(0), _ub_m_obj_open())
    let ks = keys(d)
    let n = len(ks)
    let i = 0
    while i < n
        let k = ks[i]
        out = bytes_concat(out, _ub_encode_key(k))
        out = bytes_concat(out, ubjson_encode(d[k]))
        i = i + 1
    out = bytes_append(out, _ub_m_obj_close())
    out

// ── encode: top-level dispatch ─────────────────────────────────────────
// Dispatched via type_of(v) — NOT `v != null` (NOVA represents null as raw
// 0, so `0 != null` is FALSE and a real int/float 0 would silently fall
// into the null branch; see the identical CVE-class note in bson.nova).
// SINGLE-EXIT by design (accumulate into `out`, one `out` at the end) —
// NOT a chain of early `return`s: a fn that mixes early `return <boxed
// value>` branches with other return points has a documented NOVA repr-
// mistagging gotcha (reference_nova_return_null_mistag); bson.nova's own
// _bs_type_and_value uses this exact same single-exit shape for the same
// reason.
fn ubjson_encode(v) -> any
    let t = type_of(v)
    let out = bytes_append(bytes_create(0), _ub_m_null())
    if t == "null"
        out = bytes_append(bytes_create(0), _ub_m_null())
    else if t == "float"
        out = _ub_encode_float(v)
    else if t == "string"
        out = _ub_encode_string(v)
    else if t == "bytes"
        out = _ub_encode_bytes(v)
    else if t == "list"
        out = _ub_encode_array(v)
    else if t == "dict"
        let ks = keys(v)
        // Sentinel recognition requires the EXACT 2-key wrapper shape (both
        // the value key and the magic key present) AND the magic value
        // matching exactly — a key-name-only match (e.g. an ordinary user
        // dict {"$ubjsonBool": 1} built without going through ubjson_bool())
        // is NOT enough and falls through to the plain object branch below
        // (see SENTINEL-KEY COLLISION SAFETY in the header comment).
        let is_bool_marker = 0
        if len(ks) == 2 and contains(v, "$ubjsonBool") and contains(v, "$ubjsonBoolMagic")
            // Guard the magic-VALUE compare with a type check first: the
            // magic key on a hostile/coincidental user dict may hold a
            // non-int (e.g. a string), and an `any == int` comparison on a
            // heap operand faults. A non-int magic value can never be our
            // marker, so fall through.
            if type_of(v["$ubjsonBoolMagic"]) == "int"
                if v["$ubjsonBoolMagic"] == _ub_bool_magic()
                    is_bool_marker = 1
        let is_null_marker = 0
        if len(ks) == 2 and contains(v, "$ubjsonNull") and contains(v, "$ubjsonNullMagic")
            if type_of(v["$ubjsonNullMagic"]) == "int"
                if v["$ubjsonNullMagic"] == _ub_null_magic()
                    is_null_marker = 1
        let is_noop_marker = 0
        if len(ks) == 2 and contains(v, "$ubjsonNoop") and contains(v, "$ubjsonNoopMagic")
            if type_of(v["$ubjsonNoopMagic"]) == "int"
                if v["$ubjsonNoopMagic"] == _ub_noop_magic()
                    is_noop_marker = 1
        if is_bool_marker == 1
            if v["$ubjsonBool"] != 0
                out = bytes_append(bytes_create(0), _ub_m_true())
            else
                out = bytes_append(bytes_create(0), _ub_m_false())
        else if is_null_marker == 1
            out = bytes_append(bytes_create(0), _ub_m_null())
        else if is_noop_marker == 1
            out = bytes_append(bytes_create(0), _ub_m_noop())
        else
            out = _ub_encode_object(v)
    else if t == "int"
        out = _ub_int_bytes(v)
    // Unsupported NOVA type (e.g. a raw struct/process/channel handle) falls
    // through with `out` still the safe fallback (explicit Z) set above —
    // same catch-all policy bson.nova uses.
    out

// ── decode: length prefix -> [len, next_pos, err] ──────────────────────────
// A length prefix is itself a nested optimized-int VALUE (marker + payload),
// but unlike a general value it is restricted to exactly one of the five
// int markers (i/U/I/l/L) — checked EXPLICITLY, up front, before any attempt
// to decode it as a number, rather than decoding through the general
// `_ub_decode_at` dispatcher and inspecting the result afterward. That
// up-front check is what closes two distinct hostile-input classes in one
// place: (1) a length slot that is itself another container/string marker
// (type confusion — an adversary nests `S` inside what should be an int
// length) can never be mis-parsed as a number, and (2) the no-op marker `N`
// can never be silently accepted as a disguised zero-length key (see NO-OP
// MARKER in the header). Both are REJECTED via a non-empty error message,
// not guessed at. A genuinely negative length (`i FF` = -1) is likewise
// rejected, never clamped to 0 — see DECODE-ERROR VS. LEGITIMATE-VALUE
// SAFETY in the header for why a silent fallback value is no longer an
// acceptable outcome for bad input.
fn _ub_decode_len(b, pos) -> list
    let n = bytes_len(b)
    let ln = 0
    let next = pos
    let errmsg = ""
    if pos >= n
        errmsg = "ubjson_decode: missing length prefix at " + str(pos)
    else
        let m = bytes_get(b, pos) & 0xFF
        let is_int_marker = 0
        if m == _ub_m_int8() or m == _ub_m_uint8() or m == _ub_m_int16() or m == _ub_m_int32() or m == _ub_m_int64()
            is_int_marker = 1
        if is_int_marker == 0
            errmsg = "ubjson_decode: length prefix is not an int marker at " + str(pos)
        else
            let r = _ub_decode_at(b, pos)
            if r[2] != ""
                errmsg = r[2]
                next = r[1]
            else if r[0] < 0
                errmsg = "ubjson_decode: negative length prefix at " + str(pos)
                next = r[1]
            else
                ln = r[0]
                next = r[1]
    [ln, next, errmsg]

// ── decode: one value at `pos` -> [value, next_pos, err] ───────────────────
// SINGLE-EXIT by design (accumulate into `val`/`next`/`errmsg`, one final
// `[val, next, errmsg]` at the end) — NOT a chain of early `return`s. A
// function that returns several DIFFERENT underlying value shapes (null/
// int/float/string/list/dict) from different early-return points hit a
// real, reproduced NOVA repr-mistagging bug during this module's own KAT
// (float32 1.5 round-tripped as a raw pointer-sized int instead of 1.5 —
// classic symptom of reference_nova_return_null_mistag's broader "mixed
// early returns" class, same root cause bson.nova's decoder avoids via this
// identical single-exit shape). True/false decode to plain int 1/0 (not a
// NOVA `true`/`false` literal) for the same reason bson.nova's own bool
// decode does — NOVA already can't distinguish `int` from `bool` via
// type_of, so there is no information lost.
// `errmsg` non-empty means the input at/under `pos` was REJECTED as
// malformed — `val`/`next` carry no meaning in that case, and every call
// site in this module checks `errmsg` FIRST, before using `val`/`next`, and
// short-circuits (propagates the same errmsg upward) rather than continuing
// to decode sibling data past a rejected value.
fn _ub_decode_at(b, pos) -> list
    let n = bytes_len(b)
    let val = null
    let next = pos
    let errmsg = ""
    if pos >= n
        errmsg = "ubjson_decode: unexpected end of buffer at " + str(pos)
    else
        let m = bytes_get(b, pos) & 0xFF
        if m == _ub_m_null()
            val = null
            next = pos + 1
        else if m == _ub_m_noop()
            // A lone/top-level no-op decodes to null (see NO-OP MARKER in
            // the header) — an ARRAY skips `N` entirely before ever calling
            // this function (see _ub_decode_array), so this branch only
            // fires for a no-op that is NOT inside an array (e.g. the
            // entire top-level document is a single `N` byte).
            val = null
            next = pos + 1
        else if m == _ub_m_true()
            val = 1
            next = pos + 1
        else if m == _ub_m_false()
            val = 0
            next = pos + 1
        else if m == _ub_m_int8()
            if pos + 2 > n
                errmsg = "ubjson_decode: truncated int8 payload at " + str(pos)
            else
                val = unpack_i8(b, pos + 1)
                next = pos + 2
        else if m == _ub_m_uint8()
            if pos + 2 > n
                errmsg = "ubjson_decode: truncated uint8 payload at " + str(pos)
            else
                val = unpack_u8(b, pos + 1)
                next = pos + 2
        else if m == _ub_m_int16()
            if pos + 3 > n
                errmsg = "ubjson_decode: truncated int16 payload at " + str(pos)
            else
                val = unpack_i16_be(b, pos + 1)
                next = pos + 3
        else if m == _ub_m_int32()
            if pos + 5 > n
                errmsg = "ubjson_decode: truncated int32 payload at " + str(pos)
            else
                val = unpack_i32_be(b, pos + 1)
                next = pos + 5
        else if m == _ub_m_int64()
            if pos + 9 > n
                errmsg = "ubjson_decode: truncated int64 payload at " + str(pos)
            else
                val = unpack_i64_be(b, pos + 1)
                next = pos + 9
        else if m == _ub_m_float32()
            if pos + 5 > n
                errmsg = "ubjson_decode: truncated float32 payload at " + str(pos)
            else
                let bits = unpack_u32_be(b, pos + 1)
                val = f32_from_bits(bits)
                next = pos + 5
        else if m == _ub_m_float64()
            if pos + 9 > n
                errmsg = "ubjson_decode: truncated float64 payload at " + str(pos)
            else
                let bits2 = unpack_u64_be(b, pos + 1)
                val = float_from_bits(bits2)
                next = pos + 9
        else if m == _ub_m_char()
            if pos + 2 > n
                errmsg = "ubjson_decode: truncated char payload at " + str(pos)
            else
                // Single ASCII byte -> 1-char NOVA string. DECODE ONLY (see
                // header): if the byte were 0x00 the resulting NOVA string
                // would report len()==0 under the documented C-string-
                // truncation limitation (reference_nova_string_nul_truncation)
                // — a real UBJSON producer never emits a NUL `C` (the type
                // is defined as printable ASCII), so this is a documented,
                // not silently-wrong, edge.
                val = chr(bytes_get(b, pos + 1) & 0xFF)
                next = pos + 2
        else if m == _ub_m_string()
            let lr = _ub_decode_len(b, pos + 1)
            if lr[2] != ""
                errmsg = lr[2]
                next = lr[1]
            else
                let slen = lr[0]
                let sp = lr[1]
                if slen > n - sp
                    errmsg = "ubjson_decode: truncated string data at " + str(sp)
                    next = sp
                else
                    let sb = bytes_slice(b, sp, sp + slen)
                    val = bytes_to_str(sb)
                    next = sp + slen
        else if m == _ub_m_arr_open()
            let ar = _ub_decode_array(b, pos + 1)
            val = ar[0]
            next = ar[1]
            errmsg = ar[2]
        else if m == _ub_m_obj_open()
            let ob = _ub_decode_object(b, pos + 1)
            val = ob[0]
            next = ob[1]
            errmsg = ob[2]
        else
            // Unknown/unsupported marker byte: genuinely malformed input for
            // this module's grammar — REJECTED, never accepted-and-guessed
            // (see ADVERSARIAL-INPUT ROBUSTNESS in the header).
            errmsg = "ubjson_decode: unrecognized marker byte " + str(m) + " at " + str(pos)
    [val, next, errmsg]

// ── decode: array body, starting just after '[' -> [list, next_pos, err] ──
// A bare no-op (`N`) element is PADDING, not data (see NO-OP MARKER in the
// header): it is skipped before ever reaching `_ub_decode_at`, so it
// contributes no element to `out`. Running off the end of the buffer
// without having seen the closing `]` is a REJECT (non-empty errmsg), not a
// silent truncate-and-return — see ADVERSARIAL-INPUT ROBUSTNESS. A rejected
// element also stops the loop immediately (no attempt to keep decoding
// siblings past malformed data).
fn _ub_decode_array(b, pos) -> list
    let out = []
    let n = bytes_len(b)
    let cur = pos
    let done = 0
    let errmsg = ""
    while done == 0
        if cur >= n
            errmsg = "ubjson_decode: unterminated array (missing ']') starting near " + str(pos)
            done = 1
        else
            let mk = bytes_get(b, cur) & 0xFF
            if mk == _ub_m_arr_close()
                cur = cur + 1
                done = 1
            else if mk == _ub_m_noop()
                cur = cur + 1
            else
                let r = _ub_decode_at(b, cur)
                if r[2] != ""
                    errmsg = r[2]
                    done = 1
                else
                    push(out, r[0])
                    cur = r[1]
    [out, cur, errmsg]

// ── decode: object body, starting just after '{' -> [dict, next_pos, err] ──
// A key is a length-prefixed byte span with NO marker byte of its own (see
// header) — `_ub_decode_len`'s up-front int-marker check (see above) is
// what rejects a hostile/undefined byte (including `N` or a nested
// container marker) sitting where a key length is expected, rather than
// silently mis-reading it as a key of some guessed length (the UBJSON spec
// never defines no-op-as-a-key). Running off the end of the buffer without
// having seen the closing `}` is a REJECT, not a silent truncate-and-return.
fn _ub_decode_object(b, pos) -> list
    let out = {}
    let n = bytes_len(b)
    let cur = pos
    let done = 0
    let errmsg = ""
    while done == 0
        if cur >= n
            errmsg = "ubjson_decode: unterminated object (missing '}') starting near " + str(pos)
            done = 1
        else
            let mk = bytes_get(b, cur) & 0xFF
            if mk == _ub_m_obj_close()
                cur = cur + 1
                done = 1
            else
                let lr = _ub_decode_len(b, cur)
                if lr[2] != ""
                    errmsg = lr[2]
                    done = 1
                else
                    let klen = lr[0]
                    let kp = lr[1]
                    if klen > n - kp
                        errmsg = "ubjson_decode: truncated object key at " + str(kp)
                        done = 1
                    else
                        let kb = bytes_slice(b, kp, kp + klen)
                        let k = bytes_to_str(kb)
                        let vr = _ub_decode_at(b, kp + klen)
                        if vr[2] != ""
                            errmsg = vr[2]
                            done = 1
                        else
                            out[k] = vr[0]
                            cur = vr[1]
    [out, cur, errmsg]

// ── decode: top-level entry point ───────────────────────────────────────
// ubjson_decode(b) -> Result: Ok(value) for a well-formed buffer (any
// legitimate value, including one that happens to be 0/""/null — see
// DECODE-ERROR VS. LEGITIMATE-VALUE SAFETY in the header), Err(message) for
// ANY malformed/truncated/hostile input. This is the ONLY place a
// dict-shaped/name-matched sentinel would have been tempting (the way
// plist_error()/plist_is_error() are) and deliberately is not one: NOVA's
// native Result is a compiler-native polymorphic sum, not a `dict`, so no
// legitimately-decoded document — however it happens to be shaped, even
// one with a field literally named like an error key — can ever be mistaken
// for a decode failure. Never exits, never crashes, never hangs, never
// silently guesses.
fn ubjson_decode(b) -> Result
    let n = bytes_len(b)
    if n == 0
        return err("ubjson_decode: empty buffer")
    let r = _ub_decode_at(b, 0)
    if r[2] != ""
        return err(r[2])
    return ok(r[0])
