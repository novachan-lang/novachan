// ============================================================================
// NOVA Standard Library — std/encoding/base32
// ============================================================================
// RFC 4648 §6 Base32 and §7 Base32Hex encode/decode.
//
// THE BINARY-SAFETY PROPERTY (why forge/forge_base32.nova is WRONG):
//   NOVA strings are C-string-shaped: a 0x00 byte inside a string silently
//   truncates (reference_nova_string_nul_truncation). Binary data ROUTINELY
//   contains 0x00 bytes. Base32 is used for binary payloads (keys, UUIDs,
//   arbitrary file content). This module takes and returns `bytes` for the
//   raw-data side, making 0x00 an ordinary byte — never truncated, never lost.
//   The BASE32 TEXT side is a plain string (base32 alphabet has no 0x00).
//
// THE DRAWBACK AVOIDED:
//   Python's base64.b32encode is sound (bytes in, bytes out) but the stdlib
//   conflates the "text is bytes" model (py2 trauma). NOVA cleanly separates:
//   raw payload = bytes, encoded text = string. No confusion possible.
//
// PUBLIC API:
//   base32_encode(data: bytes) -> string
//   base32_decode(s: string) -> bytes
//   base32hex_encode(data: bytes) -> string
//   base32hex_decode(s: string) -> bytes
//
// ALGORITHM (RFC 4648 §6):
//   Encode: collect input bytes into a 40-bit (5-byte) window, emit 8 symbols
//   (5 bits each). A partial final group is padded with '=' to reach a multiple
//   of 8 characters.
//     1 byte  -> 2 chars + 6 pad
//     2 bytes -> 4 chars + 4 pad
//     3 bytes -> 5 chars + 3 pad
//     4 bytes -> 7 chars + 1 pad
//     5 bytes -> 8 chars + 0 pad
//   Decode: each alphabet character maps to a 5-bit value; accumulate bits
//   8 at a time to reconstruct bytes. '=' stops decoding; surrounding
//   whitespace is stripped (lenient). Non-alphabet characters are rejected
//   (strict) — lenient for WS only, strict elsewhere per RFC recommendation.
//
// ARITHMETIC HAZARD — >> IS ARITHMETIC IN NOVA:
//   Shifts on values known-positive produce correct results, but masking after
//   each shift (& 0x1F for 5-bit, & 0xFF for 8-bit) is mandatory and present
//   everywhere in this module to be safe against sign-extension.
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _b32_ to avoid collisions with other
//   std modules compiled into the same binary.

// ── Alphabet helpers ─────────────────────────────────────────────────────────

// Standard RFC 4648 §6 alphabet: A-Z then 2-7.
fn _b32_alpha() -> string
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

// RFC 4648 §7 base32hex "extended hex" alphabet: 0-9 then A-V.
fn _b32hex_alpha() -> string
    "0123456789ABCDEFGHIJKLMNOPQRSTUV"

// Map one base32 STANDARD char to its 5-bit value (0..31). Returns -1 for
// '=' (padding), -2 for whitespace (strip), -3 for illegal.
// Case-insensitive: lowercase a-z accepted alongside uppercase.
fn _b32_char_to_val(c) -> int
    let b = ord(c)
    // '=' padding stop
    if b == 61
        return -1
    // whitespace (space/tab/CR/LF) -> strip
    if b == 32 or b == 9 or b == 13 or b == 10
        return -2
    // 'A'..'Z' -> 0..25
    if b >= 65 and b <= 90
        return b - 65
    // 'a'..'z' -> 0..25 (case-insensitive)
    if b >= 97 and b <= 122
        return b - 97
    // '2'..'7' -> 26..31
    if b >= 50 and b <= 55
        return b - 50 + 26
    // everything else is illegal
    -3

// Map one base32HEX char to its 5-bit value. Returns -1/'=' -2/ws -3/illegal.
fn _b32hex_char_to_val(c) -> int
    let b = ord(c)
    // '=' padding stop
    if b == 61
        return -1
    // whitespace strip
    if b == 32 or b == 9 or b == 13 or b == 10
        return -2
    // '0'..'9' -> 0..9
    if b >= 48 and b <= 57
        return b - 48
    // 'A'..'V' -> 10..31
    if b >= 65 and b <= 86
        return b - 65 + 10
    // 'a'..'v' -> 10..31 (case-insensitive)
    if b >= 97 and b <= 118
        return b - 97 + 10
    // illegal
    -3

// ── Core encode ──────────────────────────────────────────────────────────────
// Shared encode logic: takes bytes + alphabet string, returns RFC-padded string.
// Accumulates bits left-to-right; each output symbol takes the top 5 bits of
// the accumulator, then shifts left to consume them. This is cleaner than the
// division+modulo approach and avoids the O(k) _p2() helper from forge_base32.

fn _b32_encode_core(data, alpha) -> string
    let out_parts = []
    let nbytes = bytes_len(data)
    // Process full 5-byte groups (40 bits -> 8 symbols, no padding)
    let group = 0
    while group * 5 < nbytes
        let base = group * 5
        let remain = nbytes - base
        // Load up to 5 bytes into a 40-bit accumulator (i64 is wide enough).
        // We shift b0 far left so 5-bit groups can be extracted MSB-first.
        // Use separate vars to avoid multi-level nested expressions (float
        // codegen hazard avoidance: bind sub-exprs to lets).
        let b0 = 0
        let b1 = 0
        let b2 = 0
        let b3 = 0
        let b4 = 0
        if remain >= 1
            b0 = bytes_get(data, base) & 0xFF
        if remain >= 2
            b1 = bytes_get(data, base + 1) & 0xFF
        if remain >= 3
            b2 = bytes_get(data, base + 2) & 0xFF
        if remain >= 4
            b3 = bytes_get(data, base + 3) & 0xFF
        if remain >= 5
            b4 = bytes_get(data, base + 4) & 0xFF
        // Accumulator: b0 occupies bits 39..32, b1 bits 31..24, etc.
        let acc = (b0 << 32) | (b1 << 24) | (b2 << 16) | (b3 << 8) | b4
        // How many OUTPUT symbols this group produces (incomplete group = partial)
        // 1 byte=8 bits -> 2 symbols (10 bits needed, 2 bits padding bits at end)
        // 2 bytes=16 bits -> 4 symbols
        // 3 bytes=24 bits -> 5 symbols
        // 4 bytes=32 bits -> 7 symbols
        // 5 bytes=40 bits -> 8 symbols
        let nsyms = 0
        if remain >= 5
            nsyms = 8
        else if remain == 4
            nsyms = 7
        else if remain == 3
            nsyms = 5
        else if remain == 2
            nsyms = 4
        else
            nsyms = 2
        // Extract symbols MSB-first from the 40-bit window.
        // Symbol k occupies bits (39-k*5)..(35-k*5), i.e. shift right by (35-k*5).
        for k in 0..nsyms
            let shift = 35 - k * 5
            let idx = (acc >> shift) & 0x1F
            push(out_parts, alpha[idx])
        // Pad to a multiple of 8
        let padneeded = 8 - nsyms
        for p in 0..padneeded
            push(out_parts, "=")
        group = group + 1
    let out = join(out_parts, "")
    out

// ── Core decode ──────────────────────────────────────────────────────────────
// Shared decode: strips whitespace, maps chars to 5-bit values, accumulates
// bits 8 at a time, returns bytes. Stops at '='. Non-alphabet chars: skip.

fn _b32_decode_core(s, val_fn_is_hex) -> any
    let out = bytes(0)
    let acc = 0
    let nbits = 0
    let i = 0
    let n = len(s)
    while i < n
        let c = s[i]
        let v = 0
        if val_fn_is_hex == 1
            v = _b32hex_char_to_val(c)
        else
            v = _b32_char_to_val(c)
        if v == -1
            // '=' padding: stop consuming
            i = n
        else if v == -2
            // whitespace: skip
            i = i + 1
        else if v >= 0
            // valid 5-bit symbol: push onto accumulator
            acc = (acc << 5) | v
            nbits = nbits + 5
            if nbits >= 8
                nbits = nbits - 8
                let byte_val = (acc >> nbits) & 0xFF
                out = bytes_append(out, byte_val)
                // clear the consumed bits (keep only nbits bits)
                acc = acc & ((1 << nbits) - 1)
        else
            // v == -3: illegal char, skip (lenient for forward-compat)
            i = i + 1
        // advance if not already forced to n
        if i < n and v >= 0
            i = i + 1
    out

// ── Public API ───────────────────────────────────────────────────────────────

// Encode binary data to RFC 4648 standard base32 (A-Z 2-7, '=' padding).
fn base32_encode(data) -> string
    _b32_encode_core(data, _b32_alpha())

// Decode RFC 4648 standard base32 string to bytes.
// Tolerates missing trailing padding and surrounding whitespace.
fn base32_decode(s) -> any
    _b32_decode_core(s, 0)

// Encode binary data to RFC 4648 §7 base32hex (0-9 A-V, '=' padding).
fn base32hex_encode(data) -> string
    _b32_encode_core(data, _b32hex_alpha())

// Decode RFC 4648 §7 base32hex string to bytes.
fn base32hex_decode(s) -> any
    _b32_decode_core(s, 1)
