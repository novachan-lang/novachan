// ============================================================================
// NOVA Standard Library — std/encoding/rot13
// ============================================================================
// Caesar/ROT13 ciphers for ASCII letter rotation.
// Non-letter characters (digits, punctuation, whitespace) are passed through
// unchanged. Case is preserved on all operations.
//
// PUBLIC API:
//   rot13(s: string) -> string
//     Rotate every ASCII letter by 13 positions (A-M -> N-Z, N-Z -> A-M,
//     a-m -> n-z, n-z -> a-m). Self-inverse: rot13(rot13(s)) == s.
//
//   caesar_encode(s: string, shift: int) -> string
//     Rotate every ASCII letter forward by `shift` positions (0..25).
//     shift=13 is identical to rot13. Non-letters are unchanged.
//
//   caesar_decode(s: string, shift: int) -> string
//     Reverse of caesar_encode: rotate letters backward by `shift`.
//     caesar_decode(caesar_encode(s, k), k) == s for any k in 0..25.
//
// IMPLEMENTATION NOTES:
//   - All work is byte-level via ord()/chr(). Pure NOVA, no imports.
//   - shift is normalised modulo 26 internally so callers may pass any int.
//   - Private helpers prefixed _rot_ to avoid symbol collisions in the
//     same binary.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Rotate a single ASCII letter codepoint `b` by `sh` positions (0..25).
// `base` is 65 for uppercase, 97 for lowercase.
// Returns the rotated codepoint.
fn _rot_shift_byte(b, base, sh) -> int
    ((b - base + sh) - ((b - base + sh) / 26) * 26) + base

// Apply a shift to a single character, preserving case, leaving non-letters
// unchanged.
fn _rot_char(c, sh) -> string
    let b = ord(c)
    // uppercase A-Z  (65..90)
    if b >= 65 and b <= 90
        return chr(_rot_shift_byte(b, 65, sh))
    // lowercase a-z  (97..122)
    if b >= 97 and b <= 122
        return chr(_rot_shift_byte(b, 97, sh))
    // non-letter: pass through
    c

// ── Public API ────────────────────────────────────────────────────────────────

// rot13: rotate every ASCII letter by 13 (self-inverse).
//
// Examples:
//   rot13("Hello")            == "Uryyb"
//   rot13("Uryyb")            == "Hello"
//   rot13("abc")              == "nop"
//   rot13("Hello, World!")    == "Uryyb, Jbeyq!"
fn rot13(s) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        out = out + _rot_char(s[i], 13)
        i = i + 1
    out

// caesar_encode: rotate every ASCII letter forward by `shift` positions.
//
// `shift` is reduced modulo 26 automatically.
// Examples:
//   caesar_encode("abc", 1)   == "bcd"
//   caesar_encode("xyz", 3)   == "abc"
//   caesar_encode("Hello", 13) == rot13("Hello")
//   caesar_encode("a1!", 1)   == "b1!"
fn caesar_encode(s, shift) -> string
    // normalise shift to 0..25
    let sh = shift - (shift / 26) * 26
    if sh < 0
        sh = sh + 26
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        out = out + _rot_char(s[i], sh)
        i = i + 1
    out

// caesar_decode: reverse of caesar_encode.
//
// Rotates every ASCII letter backward by `shift` positions.
// caesar_decode(caesar_encode(s, k), k) == s for any integer k.
// Examples:
//   caesar_decode(caesar_encode("Test", 5), 5) == "Test"
fn caesar_decode(s, shift) -> string
    // decode = encode by (26 - shift) mod 26
    let sh = shift - (shift / 26) * 26
    if sh < 0
        sh = sh + 26
    let inv = 26 - sh
    if inv == 26
        inv = 0
    caesar_encode(s, inv)
