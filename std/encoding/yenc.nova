// ============================================================================
// NOVA Standard Library — std/encoding/yenc
// ============================================================================
// yEnc binary-to-text codec (originally designed for Usenet binaries).
//
// ALGORITHM:
//   Encode: for each byte b, compute e = (b + 42) % 256.
//   If e is a critical byte (NUL=0, LF=10, CR=13, '='=61) emit '=' (61)
//   followed by (e + 64) % 256. Otherwise emit e directly.
//   The encoded stream is a bytes value (may contain high bytes).
//
//   Decode: consume encoded bytes one at a time.
//   If current byte is '=' (61): read the next byte c, output (c - 64 - 42) % 256,
//   using modulo-256 wrap to handle the arithmetic correctly.
//   Otherwise: output (byte - 42) % 256 with mod-256 wrap.
//
// ARITHMETIC NOTE:
//   All arithmetic is mod 256 to stay in the 0..255 range.
//   Subtraction can go negative in NOVA (i64); the + 256 trick keeps it
//   positive: ((x % 256) + 256) % 256.
//
// BINARY SAFETY:
//   The module operates entirely on `bytes` values, so 0x00 bytes are
//   handled without C-string truncation.
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _ye_ to avoid collisions.
//
// PUBLIC API:
//   ye_encode(data: bytes) -> bytes
//   ye_decode(data: bytes) -> bytes
// ============================================================================

// _ye_mod256: wrap an integer to 0..255 (handles negative subtraction results).
fn _ye_mod256(v) -> int
    let r = v % 256
    if r < 0
        r += 256
    r

// ye_encode: encode a bytes value using the yEnc algorithm.
// Returns a bytes value (encoded output, which may contain high bytes ≥128).
fn ye_encode(data) -> any
    let n = bytes_len(data)
    let out = bytes(0)
    for i in 0..n
        let b = bytes_get(data, i)
        let e = _ye_mod256(b + 42)
        // Critical bytes that must be escaped: NUL(0), LF(10), CR(13), '='(61)
        if e == 0 or e == 10 or e == 13 or e == 61
            out = bytes_append(out, 61)
            let escaped = _ye_mod256(e + 64)
            out = bytes_append(out, escaped)
        if e != 0 and e != 10 and e != 13 and e != 61
            out = bytes_append(out, e)
    out

// ye_decode: decode a yEnc-encoded bytes value back to the original bytes.
// Returns the decoded bytes value.
fn ye_decode(data) -> any
    let n = bytes_len(data)
    let out = bytes(0)
    let i = 0
    while i < n
        let b = bytes_get(data, i)
        if b == 61
            // Escape: consume the next byte and decode it
            i += 1
            if i < n
                let c = bytes_get(data, i)
                let decoded = _ye_mod256(c - 64 - 42)
                out = bytes_append(out, decoded)
        if b != 61
            let decoded2 = _ye_mod256(b - 42)
            out = bytes_append(out, decoded2)
        i += 1
    out
