// ============================================================================
// NOVA Standard Library — std/encoding/atbash
// ============================================================================
// Atbash cipher: a simple letter-substitution cipher where each letter is
// replaced by its mirror in the alphabet (A<->Z, B<->Y, ..., M<->N).
// The cipher is self-inverse: at_transform(at_transform(s)) == s.
// Case is preserved. Non-letter characters pass through unchanged.
//
// PUBLIC API:
//   at_transform(s: string) -> string
//     Apply the Atbash cipher to every ASCII letter in `s`.
//     Uppercase letters: A(65)->Z(90), B(66)->Y(89), ..., Z(90)->A(65)
//     Lowercase letters: a(97)->z(122), b(98)->y(121), ..., z(122)->a(97)
//     Non-letters (digits, punctuation, whitespace, etc.) are passed through
//     unchanged.
//
// IMPLEMENTATION NOTES:
//   - Pure NOVA, no imports. All work via ord()/chr().
//   - Private helper prefixed _at_ to avoid link-time symbol collisions.
//   - Self-inverse: applying at_transform twice returns the original string.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Map a single character through the Atbash substitution.
// Uppercase A-Z: new_code = 65 + (90 - b)  i.e. 155 - b
// Lowercase a-z: new_code = 97 + (122 - b) i.e. 219 - b
// Non-letter: return c unchanged.
fn _at_char(c) -> string
    let b = ord(c)
    if b >= 65 and b <= 90
        return chr(155 - b)
    if b >= 97 and b <= 122
        return chr(219 - b)
    c

// ── Public API ────────────────────────────────────────────────────────────────

// at_transform: apply the Atbash cipher to every ASCII letter in `s`.
//
// The transformation is self-inverse:
//   at_transform(at_transform(s)) == s  for all strings s
//
// Examples:
//   at_transform("ABC")              == "ZYX"
//   at_transform("Hello")            == "Svool"
//   at_transform("abc")              == "zyx"
//   at_transform("Hi!")              == "Sr!"
//   at_transform("")                 == ""
//   at_transform(at_transform("test")) == "test"
fn at_transform(s) -> string
    let out_parts = []
    let i = 0
    let n = len(s)
    while i < n
        let c = s[i]
        push(out_parts, _at_char(c))
        i += 1
    let out = join(out_parts, "")
    out
