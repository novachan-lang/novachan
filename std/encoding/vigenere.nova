// ============================================================================
// NOVA Standard Library — std/encoding/vigenere
// ============================================================================
// Vigenere polyalphabetic substitution cipher (letters only).
//
// The key repeats over LETTER positions only — non-letter characters (digits,
// spaces, punctuation) are passed through unchanged and do NOT advance the
// key position.  Case is preserved in the output.  The key itself is treated
// case-insensitively (a-z and A-Z are both valid).
//
// PUBLIC API:
//   vg_encrypt(text: string, key: string) -> string
//     Encrypt `text` with the Vigenere cipher using `key`.
//     Returns the ciphertext with non-letters passed through unchanged.
//
//   vg_decrypt(text: string, key: string) -> string
//     Decrypt a Vigenere-encrypted string.
//     vg_decrypt(vg_encrypt(s, k), k) == s  for any s and non-empty key k.
//
// KAT (published test vectors):
//   vg_encrypt("ATTACKATDAWN", "LEMON") == "LXFOPVEFRNHR"
//   vg_decrypt("LXFOPVEFRNHR", "LEMON") == "ATTACKATDAWN"
//   vg_encrypt("HELLO",        "KEY")   == "RIJVS"
//   vg_decrypt("RIJVS",        "KEY")   == "HELLO"
//   vg_encrypt("abc",          "abc")   == "ace"
//
// IMPLEMENTATION NOTES:
//   - Pure NOVA, no imports.
//   - All arithmetic is modular (mod 26) using integer division trick.
//   - Private helpers prefixed vg_ to avoid link collisions.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Normalise a codepoint to an uppercase letter offset in 0..25.
// Input must be an ASCII letter (A-Z or a-z).
fn _vg_letter_offset(b) -> int
    let off = b
    if off >= 97 and off <= 122
        off = off - 32
    off - 65

// Return the normalised key offset for position `ki` in `key`, where `key`
// may contain only letters (any case).  ki is already reduced mod key length
// by the caller.
fn _vg_key_off(key, ki) -> int
    _vg_letter_offset(ord(key[ki]))

// Encrypt one character `c` with key offset `koff` (0..25).
// `c` must be an ASCII letter; case is preserved in the output.
fn _vg_enc_char(c, koff) -> string
    let b = ord(c)
    let base = 65
    if b >= 97 and b <= 122
        base = 97
    let poff = b - base
    let coff = poff + koff
    coff = coff - (coff / 26) * 26
    chr(base + coff)

// Decrypt one character `c` with key offset `koff` (0..25).
fn _vg_dec_char(c, koff) -> string
    let b = ord(c)
    let base = 65
    if b >= 97 and b <= 122
        base = 97
    let coff = b - base
    let poff = coff - koff + 26
    poff = poff - (poff / 26) * 26
    chr(base + poff)

// ── Public API ────────────────────────────────────────────────────────────────

// vg_encrypt: encrypt `text` with the Vigenere cipher using `key`.
//
// Key characters must be ASCII letters (A-Z or a-z); other characters in
// `key` will produce undefined results.  Non-letter characters in `text` are
// copied to the output without advancing the key index.
//
// Examples:
//   vg_encrypt("ATTACKATDAWN", "LEMON") == "LXFOPVEFRNHR"
//   vg_encrypt("Hello, World!", "KEY")  == "Rijvs, Uqvnd!"  (non-letters pass through)
//   vg_encrypt("abc", "abc")            == "ace"
fn vg_encrypt(text, key) -> string
    let klen = len(key)
    let n = len(text)
    let out = ""
    let i = 0
    let ki = 0
    while i < n
        let c = text[i]
        let b = ord(c)
        let is_letter = 0
        if b >= 65 and b <= 90
            is_letter = 1
        if b >= 97 and b <= 122
            is_letter = 1
        if is_letter == 1
            let koff = _vg_key_off(key, ki)
            out = out + _vg_enc_char(c, koff)
            ki = ki + 1
            if ki >= klen
                ki = 0
        if is_letter == 0
            out = out + c
        i = i + 1
    out

// vg_decrypt: decrypt a Vigenere-encrypted string.
//
// Inverse of vg_encrypt: vg_decrypt(vg_encrypt(s, k), k) == s.
// Non-letter characters are passed through and do not advance the key index.
//
// Examples:
//   vg_decrypt("LXFOPVEFRNHR", "LEMON") == "ATTACKATDAWN"
//   vg_decrypt("RIJVS", "KEY")           == "HELLO"
fn vg_decrypt(text, key) -> string
    let klen = len(key)
    let n = len(text)
    let out = ""
    let i = 0
    let ki = 0
    while i < n
        let c = text[i]
        let b = ord(c)
        let is_letter = 0
        if b >= 65 and b <= 90
            is_letter = 1
        if b >= 97 and b <= 122
            is_letter = 1
        if is_letter == 1
            let koff = _vg_key_off(key, ki)
            out = out + _vg_dec_char(c, koff)
            ki = ki + 1
            if ki >= klen
                ki = 0
        if is_letter == 0
            out = out + c
        i = i + 1
    out
