// ============================================================================
// NOVA Standard Library — std/encoding/basecrockford
// ============================================================================
// Crockford's Base32 — a human-friendly base-32 encoding designed for
// readability and transcription safety. Reference: https://www.crockford.com/base32.html
//
// WHY CROCKFORD DIFFERS FROM RFC 4648 BASE32:
//   RFC 4648 Base32 encodes arbitrary binary byte sequences using an
//   alphabet of A-Z and 2-7, requiring padding and treating the payload
//   as a bitstream. Crockford Base32 encodes non-negative INTEGERS using
//   the alphabet "0123456789ABCDEFGHJKMNPQRSTVWXYZ" (32 symbols, omitting
//   I, L, O, U to prevent visual ambiguity). No padding is needed — the
//   value 0 encodes as "0", and the encoding is compact (no wasted bits
//   for non-multiple-of-5 byte sequences). Decoding is case-insensitive
//   and also accepts legacy confusion substitutions: I and L → 1, O → 0,
//   hyphens are ignored (separators for readability).
//
// THE CHECK SYMBOL EXTENSION:
//   Crockford defines an optional 37-symbol extended alphabet for a single
//   check character appended to the encoded string. The check symbol is
//   computed as (n mod 37), mapping values 0-31 to the base alphabet and
//   values 32-36 to the supplementary characters "*~$=U". This catches
//   the most common single-digit transcription errors and transpositions.
//
// PUBLIC API:
//   bc_encode(n)          -> string  (n >= 0; returns "0" for n == 0)
//   bc_decode(s)          -> int     (case-insensitive; I/L->1, O->0; hyphens ignored)
//   bc_encode_check(n)    -> string  (bc_encode(n) + check symbol for n mod 37)
//   bc_decode_check(s)    -> int     (returns -1 on check-symbol mismatch)
//
// ARITHMETIC HAZARD — >> IS ARITHMETIC IN NOVA:
//   All right-shifts that extract digit values mask with & 0x1F to guard
//   against sign extension on large values.
//
// NOVA GOTCHAS:
//   - Integer division: a/b truncates toward zero.
//   - No && or || — use 'and'/'or'.
//   - Unused locals are compile errors — be careful.
//   - dict keys are strings; use str() to convert int keys.
//
// SYMBOL COLLISION GUARD:
//   All private helpers use the _bck_ prefix.

// ── Alphabet ─────────────────────────────────────────────────────────────────

// The 32-symbol Crockford alphabet (indices 0..31).
// Omits I, L, O, U to reduce transcription errors.
fn _bck_alpha() -> string
    "0123456789ABCDEFGHJKMNPQRSTVWXYZ"

// The 5 supplementary check symbols for values 32..36 (mod 37).
fn _bck_check_extra() -> string
    "*~$=U"

// Return the Crockford Base32 character for a digit value 0..31.
fn _bck_digit(v) -> string
    let alpha = _bck_alpha()
    alpha[v]

// Return the check character for a check value 0..36.
fn _bck_check_char(v) -> string
    if v < 32
        return _bck_digit(v)
    let extra = _bck_check_extra()
    extra[v - 32]

// ── Decode value for a single character ──────────────────────────────────────
//
// Returns 0..31 for valid base-32 symbols (after substitution rules).
// Returns -1 for hyphen (ignore in caller).
// Returns -2 for whitespace (strip in caller).
// Returns -3 for illegal characters.
// The substitution rules (Crockford spec §4):
//   O/o → 0    (letter oh → zero)
//   I/i → 1    (letter eye → one)
//   L/l → 1    (letter el → one)
// Note: U and u are NOT in the main alphabet and NOT mapped (they appear
// only in the check-symbol extension, not in the main data encoding).

fn _bck_char_to_val(c) -> int
    let b = ord(c)
    // Hyphen: separator, ignore
    if b == 45
        return -1
    // Whitespace: strip
    if b == 32 or b == 9 or b == 13 or b == 10
        return -2
    // '0'..'9' → 0..9  (ASCII 48..57)
    if b >= 48 and b <= 57
        return b - 48
    // Uppercase
    if b >= 65 and b <= 90
        // A-H → 10..17  (skip I=73)
        if b >= 65 and b <= 72
            return b - 65 + 10
        // I → 1 (substitution: letter I looks like 1)
        if b == 73
            return 1
        // J-K → 18..19  (skip nothing between J(74) and K(75))
        if b >= 74 and b <= 75
            return b - 74 + 18
        // L → 1 (substitution: letter L looks like 1)
        if b == 76
            return 1
        // M-N → 20..21  (77..78)
        if b >= 77 and b <= 78
            return b - 77 + 20
        // O → 0 (substitution: letter O looks like 0)
        if b == 79
            return 0
        // P-T → 22..26  (80..84)
        if b >= 80 and b <= 84
            return b - 80 + 22
        // U: not in main alphabet (only a check symbol) — illegal in data
        if b == 85
            return -3
        // V → 27  (86)
        if b == 86
            return 27
        // W-X-Y-Z → 28..31  (87..90)
        if b >= 87 and b <= 90
            return b - 87 + 28
        return -3
    // Lowercase: recurse via upcase arithmetic
    if b >= 97 and b <= 122
        // Same logic but b - 32 gives the uppercase codepoint
        let ub = b - 32
        if ub >= 65 and ub <= 72
            return ub - 65 + 10
        if ub == 73
            return 1
        if ub >= 74 and ub <= 75
            return ub - 74 + 18
        if ub == 76
            return 1
        if ub >= 77 and ub <= 78
            return ub - 77 + 20
        if ub == 79
            return 0
        if ub >= 80 and ub <= 84
            return ub - 80 + 22
        if ub == 85
            return -3
        if ub == 86
            return 27
        if ub >= 87 and ub <= 90
            return ub - 87 + 28
        return -3
    -3

// Return the check value (0..36) for a check-symbol character,
// or -1 if the character is not a valid check symbol.
fn _bck_check_char_to_val(c) -> int
    // Standard data symbols 0..31 are also valid check symbols.
    let dv = _bck_char_to_val(c)
    if dv >= 0
        return dv
    // Supplementary check symbols: * ~ $ = U (upper or lower)
    let b = ord(c)
    if b == 42
        return 32
    if b == 126
        return 33
    if b == 36
        return 34
    if b == 61
        return 35
    // 'U' or 'u'
    if b == 85 or b == 117
        return 36
    -1

// ── Encode ────────────────────────────────────────────────────────────────────

// bc_encode: encode a non-negative integer as a Crockford Base32 string.
// bc_encode(0) == "0" (single zero, not empty string).
// Algorithm: repeated integer division by 32, collect remainders LSB-first,
// then reverse. Each remainder is a 5-bit value mapped to the alphabet.
fn bc_encode(n) -> string
    if n == 0
        return "0"
    // Collect digits least-significant-first.
    let digits_parts = []
    let v = n
    while v > 0
        let rem = v - (v / 32) * 32
        push(digits_parts, _bck_digit(rem))
        v = v / 32
    let digits = join(digits_parts, "")
    // Reverse to produce most-significant-first output.
    let result_parts = []
    let ri = len(digits) - 1
    while ri >= 0
        push(result_parts, digits[ri])
        ri -= 1
    let result = join(result_parts, "")
    result

// ── Decode ────────────────────────────────────────────────────────────────────

// bc_decode: decode a Crockford Base32 string to a non-negative integer.
// Case-insensitive. Hyphens are silently ignored (allowed as separators).
// Applies substitution rules: O/o → 0, I/i → 1, L/l → 1.
// Returns the decoded integer value. Illegal characters are skipped
// (lenient, matching Crockford's stated intent for user-typed input).
fn bc_decode(s) -> int
    let n = len(s)
    let result = 0
    for i in 0..n
        let c = s[i]
        let v = _bck_char_to_val(c)
        // -1 = hyphen (ignore), -2 = whitespace (ignore), -3 = illegal (skip)
        if v >= 0
            result = result * 32 + v
    result

// ── Check-symbol encode ───────────────────────────────────────────────────────

// bc_encode_check: encode n as Crockford Base32 and append a check symbol.
// The check symbol represents (n mod 37) using the extended 37-symbol alphabet.
// This allows single-character errors and adjacent transpositions to be detected.
fn bc_encode_check(n) -> string
    let base = bc_encode(n)
    let check_val = n - (n / 37) * 37
    let check_sym = _bck_check_char(check_val)
    base + check_sym

// ── Check-symbol decode ───────────────────────────────────────────────────────

// bc_decode_check: decode a Crockford Base32 string with trailing check symbol.
// Strips and verifies the final character as a check symbol.
// Returns the decoded integer if the check symbol matches (n mod 37).
// Returns -1 if the check symbol is missing or does not match.
fn bc_decode_check(s) -> int
    let n = len(s)
    if n == 0
        return -1
    // The last character is the check symbol.
    let last_c = s[n - 1]
    let check_sym_val = _bck_check_char_to_val(last_c)
    if check_sym_val < 0
        return -1
    // Decode the data portion (everything except the last character).
    let data_part_parts = []
    for i in 0..(n - 1)
        push(data_part_parts, s[i])
    let data_part = join(data_part_parts, "")
    let decoded = bc_decode(data_part)
    // Verify check symbol.
    let expected = decoded - (decoded / 37) * 37
    if expected == check_sym_val
        return decoded
    -1
