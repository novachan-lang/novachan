// ============================================================================
// NOVA Standard Library — std/encoding/hexdump
// ============================================================================
// Classic hexdump formatting of a bytes value, suitable for debugging,
// protocol analysis, and hex editors. Mirrors the output style of tools like
// `xxd -g 1` and Python's `binascii.hexlify` with added offset+ASCII gutter.
//
// PUBLIC API:
//   hd_dump(data: bytes) -> string
//     Full hexdump: every 16 bytes produces one line of the form
//       "OOOOOOOO  HH HH HH … HH  |AAAA…A|"
//     where:
//       OOOOOOOO  = 8 lowercase hex digits, the byte offset of the first byte
//                   in this row (zero-padded).
//       HH        = 2 lowercase hex digits per byte, space-separated (16 cols).
//                   The last (short) line is padded with spaces to the same
//                   column width as a full line.
//       AAAA…A    = ASCII gutter: printable bytes (32 ≤ b ≤ 126) shown as-is;
//                   all others shown as '.'.
//     Lines are joined with chr(10). Empty input returns "".
//
//   hd_hexline(data: bytes) -> string
//     Just the hex portion for the given bytes (no offset, no ASCII gutter).
//     Bytes are space-separated lowercase hex pairs, e.g. "48 69 2f".
//     Useful for logging a single chunk without the full dump decoration.
//
// DESIGN NOTES:
//   • All arithmetic on byte values masks with & 0xFF to guard against NOVA's
//     arithmetic right-shift sign-extension.
//   • Integer division '/' truncates toward zero in NOVA — safe for positive
//     offsets.
//   • Braces in string literals interpolate in NOVA; none appear here.
//   • Private helpers are prefixed _hd_ to avoid symbol collisions.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Lowercase hex alphabet.
fn _hd_alpha() -> string
    "0123456789abcdef"

// Convert a non-negative integer `n` to a zero-padded lowercase hex string of
// exactly `width` digits. Only called with widths 2 and 8 in this module.
// Produces at most `width` digits (right-aligned, zero-padded on the left).
fn _hd_int_to_hex(n, width) -> string
    let alpha = _hd_alpha()
    let result = ""
    let i = 0
    while i < width
        let nibble = (n >> (4 * (width - 1 - i))) & 0x0F
        result = result + alpha[nibble]
        i = i + 1
    result

// Produce "HH" (two lowercase hex chars) for one byte value b (0..255).
fn _hd_byte_hex(b) -> string
    let alpha = _hd_alpha()
    let hi = (b >> 4) & 0x0F
    let lo = b & 0x0F
    alpha[hi] + alpha[lo]

// Produce the ASCII gutter character for byte value b:
//   printable ASCII (32 ≤ b ≤ 126) → the character itself
//   everything else                 → "."
fn _hd_ascii_char(b) -> string
    if b >= 32 and b <= 126
        return chr(b)
    "."

// Repeat string `s` exactly `n` times. Returns "" for n <= 0.
fn _hd_repeat(s, n) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + s
        i = i + 1
    out

// ── Public API ────────────────────────────────────────────────────────────────

// hd_hexline: the raw hex columns for the given bytes, space-separated.
//
// Each byte → exactly two lowercase hex chars. Bytes are joined by " ".
// No offset prefix, no ASCII gutter, no padding.
//
// Examples:
//   hd_hexline(bytes [0x48,0x69])       == "48 69"
//   hd_hexline(bytes [0x00,0xFF,0x10])  == "00 ff 10"
//   hd_hexline(bytes [])                == ""
fn hd_hexline(data) -> string
    let nb = bytes_len(data)
    if nb == 0
        return ""
    let out = _hd_byte_hex(bytes_get(data, 0) & 0xFF)
    let i = 1
    while i < nb
        out = out + " " + _hd_byte_hex(bytes_get(data, i) & 0xFF)
        i = i + 1
    out

// hd_dump: full hexdump of `data`, one line per 16 bytes.
//
// Line format (all parts concatenated, no extra separator):
//   8-char offset  "  "  47-char hex cols  "  |"  ascii gutter  "|"
//
// The 47-char hex cols: 16 bytes × "HH " minus the trailing space = 47 chars.
// (i.e. "HH HH HH HH HH HH HH HH HH HH HH HH HH HH HH HH" — 47 chars)
// Short last lines are right-padded with spaces to 47 chars before the gutter.
//
// Empty input returns "".
fn hd_dump(data) -> string
    let nb = bytes_len(data)
    if nb == 0
        return ""
    // Full hex cols for 16 bytes = 16*2 + 15 spaces = 47 chars.
    let full_hex_width = 47
    let out = ""
    let row = 0
    let first_row = 1
    while row * 16 < nb
        let offset = row * 16
        // ── hex columns for this row ─────────────────────────────────────────
        let hex_part = ""
        let ascii_part = ""
        let col = 0
        while col < 16 and (offset + col) < nb
            let b = bytes_get(data, offset + col) & 0xFF
            if col == 0
                hex_part = _hd_byte_hex(b)
            else
                hex_part = hex_part + " " + _hd_byte_hex(b)
            ascii_part = ascii_part + _hd_ascii_char(b)
            col = col + 1
        // ── pad hex cols to full_hex_width ───────────────────────────────────
        let hex_len = len(hex_part)
        let pad_needed = full_hex_width - hex_len
        if pad_needed > 0
            hex_part = hex_part + _hd_repeat(" ", pad_needed)
        // ── assemble line ────────────────────────────────────────────────────
        let line = _hd_int_to_hex(offset, 8) + "  " + hex_part + "  |" + ascii_part + "|"
        if first_row == 1
            out = line
            first_row = 0
        else
            out = out + chr(10) + line
        row = row + 1
    out
