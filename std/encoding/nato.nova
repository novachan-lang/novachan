// ============================================================================
// NOVA Standard Library — std/encoding/nato
// ============================================================================
// NATO phonetic alphabet (ICAO/ITU standard).
// Maps letters A-Z (case-insensitive) and digits 0-9 to their spoken words.
//
// PUBLIC API:
//   nato_word(ch: string) -> string
//     Convert a single character to its NATO phonetic word.
//     - Letters A-Z (case-insensitive): Alpha, Bravo, ..., Zulu
//     - Digits 0-9: Zero, One, Two, Three, Four, Five, Six, Seven, Eight, Niner
//     - Space " " is skipped (returns "")
//     - Any other character: returned as-is
//
//   nato_spell(s: string) -> list
//     Spell out every non-space character of s as NATO words.
//     Returns a list of strings (one word per character, spaces are skipped).
//
//   nato_spell_string(s: string) -> string
//     Like nato_spell but returns the words joined by a single space.
//
// KNOWN-ANSWER EXAMPLES:
//   nato_word("A")  == "Alpha"
//   nato_word("B")  == "Bravo"
//   nato_word("Z")  == "Zulu"
//   nato_word("5")  == "Five"
//   nato_word("n")  == "November"
//   nato_spell("AB")          == ["Alpha","Bravo"]
//   nato_spell_string("SOS")  == "Sierra Oscar Sierra"
//
// LEAF — imports NOTHING.

// ── Private: uppercase a single character ────────────────────────────────────

fn _nato_upper(c) -> string
    let b = ord(c)
    if b >= 97 and b <= 122
        return chr(b - 32)
    c

// ── Private: uppercase letter/digit -> NATO word ─────────────────────────────

// Input must already be uppercase. Returns "" for unknown/space.
fn _nato_word_upper(c) -> string
    if c == "A" then return "Alpha"
    if c == "B" then return "Bravo"
    if c == "C" then return "Charlie"
    if c == "D" then return "Delta"
    if c == "E" then return "Echo"
    if c == "F" then return "Foxtrot"
    if c == "G" then return "Golf"
    if c == "H" then return "Hotel"
    if c == "I" then return "India"
    if c == "J" then return "Juliet"
    if c == "K" then return "Kilo"
    if c == "L" then return "Lima"
    if c == "M" then return "Mike"
    if c == "N" then return "November"
    if c == "O" then return "Oscar"
    if c == "P" then return "Papa"
    if c == "Q" then return "Quebec"
    if c == "R" then return "Romeo"
    if c == "S" then return "Sierra"
    if c == "T" then return "Tango"
    if c == "U" then return "Uniform"
    if c == "V" then return "Victor"
    if c == "W" then return "Whiskey"
    if c == "X" then return "X-ray"
    if c == "Y" then return "Yankee"
    if c == "Z" then return "Zulu"
    if c == "0" then return "Zero"
    if c == "1" then return "One"
    if c == "2" then return "Two"
    if c == "3" then return "Three"
    if c == "4" then return "Four"
    if c == "5" then return "Five"
    if c == "6" then return "Six"
    if c == "7" then return "Seven"
    if c == "8" then return "Eight"
    if c == "9" then return "Niner"
    ""

// ── Public API ───────────────────────────────────────────────────────────────

// nato_word: convert a single character to its NATO phonetic word.
//
// Case-insensitive for letters. Digits 0-9 use ICAO spoken forms (9 = Niner).
// Space returns "". Any other character is returned as-is.
//
// Examples:
//   nato_word("A") == "Alpha"
//   nato_word("z") == "Zulu"
//   nato_word("5") == "Five"
//   nato_word("?") == "?"
fn nato_word(ch) -> string
    let u = _nato_upper(ch)
    let w = _nato_word_upper(u)
    if len(w) > 0
        return w
    // space => skip (return empty); anything else => return as-is
    if u == " "
        return ""
    u

// nato_spell: spell out every non-space character as NATO words.
//
// Returns a list of strings. Input spaces are silently skipped.
//
// Examples:
//   nato_spell("AB")  == ["Alpha", "Bravo"]
//   nato_spell("SOS") == ["Sierra", "Oscar", "Sierra"]
fn nato_spell(s) -> list
    let result = []
    let n = len(s)
    let i = 0
    while i < n
        let c = s[i]
        if c != " "
            let w = nato_word(c)
            if len(w) > 0
                result.push(w)
        i = i + 1
    result

// nato_spell_string: spell out a string as space-joined NATO words.
//
// Spaces in the input are silently skipped.
//
// Examples:
//   nato_spell_string("SOS")   == "Sierra Oscar Sierra"
//   nato_spell_string("NOVA")  == "November Oscar Victor Alpha"
fn nato_spell_string(s) -> string
    let words = nato_spell(s)
    join(words, " ")
