// ============================================================================
// NOVA Standard Library — std/cipher/beaufort
// ============================================================================
// Beaufort cipher — a polyalphabetic reciprocal substitution cipher.
//
// STANDARD BEAUFORT:
//   C[i] = (K[i] - P[i]) mod 26
//
//   Because the operation is its own inverse (applying encrypt twice returns
//   the original plaintext), the cipher is called "reciprocal" or an
//   "involution": beaufort_decrypt == beaufort_encrypt.
//
// GERMAN / VARIANT BEAUFORT:
//   C[i] = (P[i] - K[i]) mod 26
//
//   This is the variant used in German Enigma-family literature. It is NOT
//   self-reciprocal; decrypt is the standard Beaufort of the ciphertext.
//   Equivalently: variant_encrypt(pt, key) == beaufort_encrypt(ct, key)
//   when reversed is the variant Beaufort.
//
//   Relationship: variant_beaufort_encrypt(pt, key) ==
//                 beaufort_encrypt(pt, key) shifted by ... no, they are
//                 truly distinct. variant produces the Vigenère encryption
//                 of the plaintext with the negated key mod 26, i.e. it is
//                 the Vigenère cipher with key REVERSED in sign.
//
// I/J HANDLING:
//   The Beaufort cipher operates on the full 26-letter A-Z alphabet, so I
//   and J remain distinct.  No I/J merging is performed.
//
// INPUT NORMALISATION:
//   All inputs are uppercased.  Non-letter characters are silently dropped
//   from the plaintext/ciphertext.  Key non-letters are also dropped (the
//   effective key is its letter-only projection).
//
// KEY HANDLING:
//   The key is cycled (repeating keyword).  If the key is empty after
//   normalisation, encrypt/decrypt return "" (safe no-op).
//
// PUBLIC API:
//   beaufort_encrypt(pt, key)  -> string   Standard Beaufort (= decrypt)
//   beaufort_decrypt(ct, key)  -> string   Standard Beaufort (= encrypt)
//   beaufort_variant(pt, key)  -> string   Variant / German Beaufort (P-K)
//
// KNOWN VECTORS:
//   beaufort_encrypt("A", "B") == "B"
//     proof: (ord('B')-ord('A')) mod 26 = (1-0) mod 26 = 1 → chr(65+1)='B'
//
//   beaufort_encrypt("DEFENDTHEEASTWALLOFTHECASTLE", "FORTIFICATION")
//     == "CKMPVCPVWPIWUJOGIUAPVWRIWUUK"
//     (standard Beaufort; key cycles over the 28-letter plaintext)
//
//   beaufort_variant("A", "B") == "Z"
//     proof: (ord('A')-ord('B')) mod 26 = (0-1+26) mod 26 = 25 → 'Z'
//
// INVOLUTION PROPERTY (standard Beaufort only):
//   beaufort_encrypt(beaufort_encrypt(pt, key), key) == normalised(pt)
//   beaufort_decrypt(beaufort_encrypt(pt, key), key) == normalised(pt)
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// Safe non-negative modulo: ((x % m) + m) % m
fn _bft_mod(x, m) -> int
    let r = x - (x / m) * m
    if r < 0
        r += m
    r

// Normalise: uppercase, keep only A-Z.
fn _bft_normalise(s) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(slice(s, i, i + 1))
        if b >= 97 and b <= 122
            b -= 32
        if b >= 65 and b <= 90
            out += chr(b)
        i += 1
    out

// ── Public API ────────────────────────────────────────────────────────────────

// beaufort_encrypt: standard Beaufort cipher.
//
// For each letter in the normalised plaintext pt, and the corresponding
// cycling key letter k from the normalised key:
//   C = (k_index - p_index) mod 26
//
// Because this formula is its own inverse, beaufort_encrypt == beaufort_decrypt.
// This involution property holds: beaufort_encrypt(beaufort_encrypt(pt,key),key)
// equals the normalised plaintext.
//
// If key normalises to "" (empty or all-non-letters), returns "".
//
// Examples:
//   beaufort_encrypt("A", "B") == "B"
//   beaufort_encrypt("DEFENDTHEEASTWALLOFTHECASTLE", "FORTIFICATION")
//       == "CKMPVCPVWPIWUJOGIUAPVWRIWUUK"
//   beaufort_encrypt("", "KEY") == ""
fn beaufort_encrypt(pt, key) -> string
    let norm_pt = _bft_normalise(pt)
    let norm_key = _bft_normalise(key)
    let klen = len(norm_key)
    if klen == 0
        return ""
    let n = len(norm_pt)
    let out = ""
    let i = 0
    while i < n
        let p = ord(slice(norm_pt, i, i + 1)) - 65
        let ki = i - (i / klen) * klen
        let k = ord(slice(norm_key, ki, ki + 1)) - 65
        let c = _bft_mod(k - p, 26)
        out += chr(c + 65)
        i += 1
    out

// beaufort_decrypt: standard Beaufort cipher (identical to encrypt).
//
// The Beaufort cipher is an involution, so decryption is the same operation
// as encryption.  This function exists as a named alias for clarity.
//
// Examples:
//   beaufort_decrypt("B", "B") == "A"
//   beaufort_decrypt("CKMPVCPVWPIWUJOGIUAPVWRIWUUK", "FORTIFICATION")
//       == "DEFENDTHEEASTWALLOFTHECASTLE"
fn beaufort_decrypt(ct, key) -> string
    beaufort_encrypt(ct, key)

// beaufort_variant: German / variant Beaufort cipher.
//
// C[i] = (P[i] - K[i]) mod 26
//
// This is NOT self-reciprocal and NOT the inverse of standard Beaufort.
// To decrypt variant ciphertext, add K back: P = (C + K) mod 26.
// That is equivalent to Vigenère decryption, because variant Beaufort IS
// Vigenère encryption with the key shifted by 13 ... actually: variant
// Beaufort encrypt = Vigenère encrypt with negated key.
//
// Inverse: if CT = beaufort_variant(PT, KEY), then
//   PT[i] = (CT[i] + KEY[i]) mod 26  (add key to recover plaintext).
//
// Examples:
//   beaufort_variant("A", "B") == "Z"   (0 - 1 + 26) mod 26 = 25
//   beaufort_variant("B", "B") == "A"   (1 - 1) mod 26 = 0
//   beaufort_variant("HELLO", "KEY")    == "XANBK"
fn beaufort_variant(pt, key) -> string
    let norm_pt = _bft_normalise(pt)
    let norm_key = _bft_normalise(key)
    let klen = len(norm_key)
    if klen == 0
        return ""
    let n = len(norm_pt)
    let out_parts = []
    for i in 0..n
        let p = ord(slice(norm_pt, i, i + 1)) - 65
        let ki = i - (i / klen) * klen
        let k = ord(slice(norm_key, ki, ki + 1)) - 65
        let c = _bft_mod(p - k, 26)
        push(out_parts, chr(c + 65))
    let out = join(out_parts, "")
    out
