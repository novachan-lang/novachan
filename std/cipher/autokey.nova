// ============================================================================
// NOVA Standard Library — std/cipher/autokey
// ============================================================================
// Autokey cipher: a Vigenère variant where the key stream is formed by
// appending the plaintext to the keyword.  Proposed by Blaise de Vigenère
// (1586) and later refined by various cryptographers.
//
// KEY STREAM CONSTRUCTION:
//   keystream = keyword ++ plaintext   (for encryption)
//   keystream[i] = keyword[i]          for i < len(keyword)
//   keystream[i] = plaintext[i - len(keyword)]  for i >= len(keyword)
//
// ENCRYPTION:
//   C[i] = (P[i] + K[i]) mod 26   where K = keystream (as above)
//
// DECRYPTION (progressive):
//   P[0..len(keyword)-1] = (C[i] - keyword[i] + 26) mod 26
//   P[i] = (C[i] - P[i-len(keyword)] + 26) mod 26   for i >= len(keyword)
//   Each decrypted plaintext letter immediately extends the key.
//
// I/J HANDLING:
//   This cipher operates on the full 26-letter A-Z alphabet.
//   No I/J merging is performed.
//
// INPUT NORMALISATION:
//   All inputs are uppercased and non-letter characters are silently dropped.
//   The keyword is normalised the same way.
//
// PUBLIC API:
//   autokey_encrypt(pt, keyword) -> string
//   autokey_decrypt(ct, keyword) -> string
//
// KNOWN TEST VECTOR:
//   autokey_encrypt("ATTACKATDAWN", "QUEENLY") == "QNXEPVYTWTWP"
//   autokey_decrypt("QNXEPVYTWTWP", "QUEENLY") == "ATTACKATDAWN"
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private: normalise ────────────────────────────────────────────────────────

// Uppercase and drop non-letter characters.
fn _ak_normalise(s) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(slice(s, i, i + 1))
        if b >= 97 and b <= 122
            b = b - 32
        if b >= 65 and b <= 90
            out = out + chr(b)
        i = i + 1
    out

// ── Public API ────────────────────────────────────────────────────────────────

// autokey_encrypt: encrypt plaintext with the Autokey cipher.
//
// The key stream begins with the normalised keyword, then continues with the
// normalised plaintext.  Each ciphertext letter is:
//   C[i] = (P[i] + K[i]) mod 26
//
// Both pt and keyword are normalised (uppercase, non-letters dropped) before use.
// An empty keyword is treated as no keyword prefix (key stream = plaintext itself).
// Empty plaintext returns "".
//
// Examples:
//   autokey_encrypt("ATTACKATDAWN", "QUEENLY") == "QNXEPVYTWTWP"
//   autokey_encrypt("", "KEY") == ""
fn autokey_encrypt(pt, keyword) -> string
    let norm_kw = _ak_normalise(keyword)
    let norm_pt = _ak_normalise(pt)
    let pt_len = len(norm_pt)
    let kw_len = len(norm_kw)
    if pt_len == 0
        return ""
    let out = ""
    let i = 0
    while i < pt_len
        let p = ord(slice(norm_pt, i, i + 1)) - 65
        let k = 0
        if i < kw_len
            k = ord(slice(norm_kw, i, i + 1)) - 65
        if i >= kw_len
            k = ord(slice(norm_pt, i - kw_len, i - kw_len + 1)) - 65
        let c = (p + k) - ((p + k) / 26) * 26
        out = out + chr(c + 65)
        i = i + 1
    out

// autokey_decrypt: decrypt ciphertext with the Autokey cipher.
//
// Decryption is progressive: the keyword provides the first len(keyword) key
// letters, and each recovered plaintext letter extends the key stream.
//   P[i] = (C[i] - K[i] + 26) mod 26
//   For i >= len(keyword): K[i] = P[i - len(keyword)]
//
// Both ct and keyword are normalised before use.
// Empty ciphertext returns "".
//
// Examples:
//   autokey_decrypt("QNXEPVYTWTWP", "QUEENLY") == "ATTACKATDAWN"
//   autokey_decrypt(autokey_encrypt(pt, key), key) == normalise(pt)
fn autokey_decrypt(ct, keyword) -> string
    let norm_kw = _ak_normalise(keyword)
    let norm_ct = _ak_normalise(ct)
    let ct_len = len(norm_ct)
    let kw_len = len(norm_kw)
    if ct_len == 0
        return ""
    // Build recovered plaintext progressively as a list so we can index back.
    let pt_chars = []
    let i = 0
    while i < ct_len
        let c = ord(slice(norm_ct, i, i + 1)) - 65
        let k = 0
        if i < kw_len
            k = ord(slice(norm_kw, i, i + 1)) - 65
        if i >= kw_len
            k = pt_chars[i - kw_len]
        let raw = c - k + 26
        let p = raw - (raw / 26) * 26
        push(pt_chars, p)
        i = i + 1
    // Convert integer list to string
    let out = ""
    let j = 0
    while j < ct_len
        out = out + chr(pt_chars[j] + 65)
        j = j + 1
    out
