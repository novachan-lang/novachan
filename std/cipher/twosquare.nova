// ============================================================================
// NOVA Standard Library — std/cipher/twosquare
// ============================================================================
// Two-Square (Double Playfair) cipher — horizontal variant.
//
// Two independent 5×5 Polybius squares are built from two keyword strings.
// I and J are merged (J is treated as I throughout).  Encryption operates on
// digraphs (pairs of uppercase letters).  The plaintext is normalised to
// uppercase letters with J→I and all non-letters stripped; if the resulting
// string has an odd length, a trailing 'X' is appended.
//
// ENCRYPTION RULE (horizontal variant):
//   Let (r1, c1) = position of plaintext letter 1 in square 1.
//   Let (r2, c2) = position of plaintext letter 2 in square 2.
//   - Same column (c1 == c2):
//       ciphertext digraph = unchanged (both letters pass through).
//   - Different columns (c1 != c2):
//       ciphertext[0] = sq1[r1][c2]   (same row in sq1, col from sq2)
//       ciphertext[1] = sq2[r2][c1]   (same row in sq2, col from sq1)
//
// DECRYPTION RULE:
//   Structurally identical to encryption — the rectangle rule is self-inverse
//   under the same pair of squares.  Given ciphertext pair (c1 in sq1, c2 in sq2):
//   - Look up positions of c1 in sq1 and c2 in sq2.
//   - Same column: return unchanged.
//   - Different columns: swap columns.
//
// I/J HANDLING:
//   The 5×5 square uses 25 of the 26 English letters.  J is merged into I:
//   - When building a square, 'J' is skipped entirely.
//   - Any 'J' in the plaintext is mapped to 'I' before encryption.
//   - The decrypted output will contain 'I' wherever 'J' appeared.
//
// PUBLIC API:
//   twosquare_encrypt(pt: string, key1: string, key2: string) -> string
//     Normalise (uppercase, J→I, drop non-letters, pad X if odd), then
//     encrypt in digraphs.  Returns uppercase ciphertext.
//
//   twosquare_decrypt(ct: string, key1: string, key2: string) -> string
//     Decrypt a two-square ciphertext.  Returns uppercase plaintext.
//     Trailing X padding (if any) is preserved.
//
// ROUND-TRIP GUARANTEE:
//   twosquare_decrypt(twosquare_encrypt(pt, k1, k2), k1, k2) == normalise(pt)
//   where normalise = uppercase + J→I + drop-non-letters + even-pad.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private: normalise one ASCII letter codepoint ────────────────────────────

// _ts_upper: if codepoint b is lowercase a-z, return uppercase; else unchanged.
fn _ts_upper(b) -> int
    if b >= 97 and b <= 122
        return b - 32
    b

// _ts_is_letter: 1 if b (possibly converted to upper) is A-Z, else 0.
fn _ts_is_letter(b) -> int
    let u = _ts_upper(b)
    if u >= 65 and u <= 90
        return 1
    0

// _ts_norm_char: given a codepoint, return the normalised uppercase character
// that belongs in a Polybius square (J→I, others unchanged).
// Returns "" if the codepoint is not an ASCII letter.
fn _ts_norm_char(b) -> string
    let u = _ts_upper(b)
    if u < 65 or u > 90
        return ""
    // J(74) -> I(73)
    if u == 74
        u = 73
    chr(u)

// ── Private: square construction ─────────────────────────────────────────────

// _ts_build_square: build a 5×5 Polybius square from `key`.
// Returns a list of 25 single-character strings, stored row-major.
// Key letters come first (deduplicated, J→I merged), then A-Z remainder
// (J omitted from the alphabet).
fn _ts_build_square(key) -> list
    // Track which of the 25 square letters are placed.
    // Use a dict keyed by the letter character (A-Z minus J).
    let placed = {}
    let sq = []
    let klen = len(key)
    // Phase 1: place key letters
    for ki in 0..klen
        let ch = _ts_norm_char(ord(key[ki]))
        if ch != ""
            if ch not in placed
                placed[ch] = 1
                let dummy = push(sq, ch)
    // Phase 2: fill remaining alphabet letters A-Z (skip J)
    let ai = 65
    while ai <= 90
        if ai != 74
            let ch2 = chr(ai)
            if ch2 not in placed
                placed[ch2] = 1
                let dummy2 = push(sq, ch2)
        ai += 1
    sq

// _ts_find_in_square: find the (row, col) position of letter `ch` in square `sq`.
// `ch` must be an uppercase letter (I, not J); square has 25 entries.
// Returns a list [row, col] (0..4 each).
fn _ts_find_in_square(sq, ch) -> list
    let pos = 0
    let found = 0
    while pos < 25
        if sq[pos] == ch
            found = pos
        pos += 1
    let result = []
    let dummy = push(result, found / 5)
    let dummy2 = push(result, found - (found / 5) * 5)
    result

// ── Private: normalise plaintext ──────────────────────────────────────────────

// _ts_normalise: uppercase, J→I, drop non-letters, pad with X if odd.
fn _ts_normalise(pt) -> string
    let out = ""
    let n = len(pt)
    for i in 0..n
        let ch = _ts_norm_char(ord(pt[i]))
        if ch != ""
            out += ch
    // Pad to even length
    let outlen = len(out)
    let rem = outlen - (outlen / 2) * 2
    if rem == 1
        out += "X"
    out

// ── Private: encrypt/decrypt one digraph ──────────────────────────────────────

// _ts_transform_pair: apply the two-square rectangle rule to a pair (a, b).
// sq1 is used for `a`, sq2 is used for `b`.
// This function is self-inverse: transform(transform(a,b)) == (a,b).
fn _ts_transform_pair(sq1, sq2, a, b) -> string
    let pos1 = _ts_find_in_square(sq1, a)
    let pos2 = _ts_find_in_square(sq2, b)
    let r1 = pos1[0]
    let c1 = pos1[1]
    let r2 = pos2[0]
    let c2 = pos2[1]
    if c1 == c2
        // Same column: pass through unchanged
        return a + b
    // Rectangle swap: cross the columns
    let out1 = sq1[r1 * 5 + c2]
    let out2 = sq2[r2 * 5 + c1]
    out1 + out2

// ── Public API ────────────────────────────────────────────────────────────────

// twosquare_encrypt: encrypt plaintext with the horizontal two-square cipher.
//
// `pt`   — plaintext (any case, any characters; J→I, non-letters stripped)
// `key1` — keyword for square 1 (case-insensitive; J treated as I)
// `key2` — keyword for square 2
//
// Normalises input: uppercases, maps J→I, drops non-letters, pads X if odd.
// Returns uppercase ciphertext of even length, or "" if input has no letters.
//
// Examples:
//   twosquare_encrypt("HELP", "EXAMPLE", "KEYWORD") — deterministic result
//   twosquare_decrypt(twosquare_encrypt(pt, k1, k2), k1, k2) == normalise(pt)
fn twosquare_encrypt(pt, key1, key2) -> string
    let norm = _ts_normalise(pt)
    let n = len(norm)
    if n == 0
        return ""
    let sq1 = _ts_build_square(key1)
    let sq2 = _ts_build_square(key2)
    let out = ""
    let i = 0
    while i < n
        let p1 = norm[i]
        let p2 = norm[i + 1]
        out += _ts_transform_pair(sq1, sq2, p1, p2)
        i += 2
    out

// twosquare_decrypt: decrypt a two-square ciphertext.
//
// `ct`   — ciphertext produced by twosquare_encrypt (uppercase letters only)
// `key1` — same keyword used for square 1 during encryption
// `key2` — same keyword used for square 2 during encryption
//
// Returns uppercase plaintext.  J will not appear (was merged to I at encrypt time).
// Trailing X padding (if any) is preserved.
//
// Round-trip: twosquare_decrypt(twosquare_encrypt(pt, k1, k2), k1, k2) == normalise(pt)
//
// Empty ciphertext returns "".
fn twosquare_decrypt(ct, key1, key2) -> string
    let n = len(ct)
    if n == 0
        return ""
    let sq1 = _ts_build_square(key1)
    let sq2 = _ts_build_square(key2)
    let out_parts = []
    let i = 0
    while i < n
        let c1 = ct[i]
        let c2 = ct[i + 1]
        push(out_parts, _ts_transform_pair(sq1, sq2, c1, c2))
        i += 2
    let out = join(out_parts, "")
    out
