// ============================================================================
// NOVA Standard Library — std/cipher/hill
// ============================================================================
// Hill cipher (2x2 matrix over Z_26).
//
// The Hill cipher is a polygraphic substitution cipher using linear algebra.
// The key is a 2x2 matrix K over Z_26. Encryption processes the plaintext in
// digraphs (pairs of letters). Each digraph [p0, p1] is treated as a column
// vector and multiplied by K mod 26:
//
//   [c0]   [a b] [p0]   [a*p0 + b*p1]
//   [c1] = [c d] [p1] = [c*p0 + d*p1]  (all mod 26)
//
// The key must be invertible mod 26: gcd(det(K), 26) == 1.
// det(K) = a*d - b*c.
//
// Decryption multiplies by K^-1 mod 26:
//   K^-1 = det_inv * adjugate(K) mod 26
//         = det_inv * [[d, -b], [-c, a]] mod 26
//   where det_inv = modular inverse of det(K) mod 26.
//
// INPUT NORMALIZATION:
//   - Uppercase letters A-Z only (A=0..Z=25).
//   - Non-letters are DROPPED from the input.
//   - If the plaintext has an odd number of letters after normalization,
//     a padding letter 'X' (index 23) is appended.
//
// I/J HANDLING:
//   - Standard Hill cipher collapses I and J into I (25-letter square).
//   - This implementation uses the FULL 26-letter alphabet (A-Z, no merge).
//   - This is the dominant modern convention for the 2x2 Hill cipher.
//
// PUBLIC API:
//   mod_inverse(a, m) -> int
//     Returns x such that a*x ≡ 1 (mod m), or -1 if no inverse exists.
//     Uses the extended Euclidean algorithm.
//
//   hill_invertible(key4) -> bool
//     Returns true iff key4=[a,b,c,d] forms an invertible matrix mod 26.
//     Equivalently: gcd(a*d - b*c, 26) == 1.
//
//   hill_encrypt(pt, key4) -> string
//     Encrypt plaintext pt with the Hill cipher using key key4=[a,b,c,d].
//     Normalizes pt to uppercase letters only; pads with 'X' if odd length.
//     Returns uppercase ciphertext.
//
//   hill_decrypt(ct, key4) -> string
//     Decrypt Hill-cipher ciphertext ct using key key4=[a,b,c,d].
//     Normalizes ct to uppercase letters only.
//     Returns uppercase plaintext.
//
// KAT:
//   mod_inverse(3, 26) == 9
//   mod_inverse(9, 26) == 3
//   hill_invertible([3,3,2,5]) == true
//   hill_invertible([2,4,2,4]) == false  (det=0)
//   hill_encrypt("HELP", [3,3,2,5]) == "HIAT"
//   hill_decrypt(hill_encrypt(pt, [3,3,2,5]), [3,3,2,5]) == pt  (round-trip)
//
// COMPLEXITY: O(n) time, O(n) space.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// _hill_gcd: greatest common divisor via Euclidean algorithm.
fn _hill_gcd(a, b) -> int
    let x = a
    let y = b
    if x < 0
        x = 0 - x
    if y < 0
        y = 0 - y
    let result = 0
    let done = 0
    while done == 0
        if y == 0
            result = x
            done = 1
        if done == 0
            let tmp = y
            y = x - (x / y) * y
            x = tmp
    result

// _hill_mod26: reduce x modulo 26, always returning a value in 0..25.
fn _hill_mod26(x) -> int
    let r = x - (x / 26) * 26
    if r < 0
        r = r + 26
    r

// _hill_normalize: uppercase the string, drop non-letters, return cleaned string.
fn _hill_normalize(s) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(s[i])
        if b >= 65 and b <= 90
            out = out + s[i]
        if b >= 97 and b <= 122
            out = out + chr(b - 32)
        i = i + 1
    out

// ── Public API ────────────────────────────────────────────────────────────────

// mod_inverse: compute the modular inverse of a mod m using extended Euclidean.
// Returns x in 0..m-1 such that (a * x) % m == 1, or -1 if no inverse exists.
//
// Examples:
//   mod_inverse(3, 26) == 9    (3*9=27=1 mod 26)
//   mod_inverse(9, 26) == 3    (9*3=27=1 mod 26)
//   mod_inverse(2, 26) == -1   (gcd(2,26)=2, no inverse)
fn mod_inverse(a, m) -> int
    // Extended Euclidean algorithm iteratively.
    // We maintain: old_r*a + old_s*m = old_gcd path
    let r0 = a
    let r1 = m
    let s0 = 1
    let s1 = 0
    let done = 0
    let result = -1
    while done == 0
        if r1 == 0
            if r0 == 1
                // Normalize s0 into 0..m-1
                let v = s0 - (s0 / m) * m
                if v < 0
                    v = v + m
                result = v
            done = 1
        if done == 0
            let q = r0 / r1
            let tmp_r = r1
            r1 = r0 - q * r1
            r0 = tmp_r
            let tmp_s = s1
            s1 = s0 - q * s1
            s0 = tmp_s
    result

// hill_invertible: returns true iff key4 forms an invertible 2x2 matrix mod 26.
// key4 = [a, b, c, d] representing the matrix [[a,b],[c,d]].
// Invertible iff gcd(a*d - b*c, 26) == 1.
//
// Examples:
//   hill_invertible([3,3,2,5]) == true   (det=9, gcd(9,26)=1)
//   hill_invertible([2,4,2,4]) == false  (det=0, gcd(0,26)=26)
//   hill_invertible([1,0,0,1]) == true   (identity, det=1)
fn hill_invertible(key4) -> bool
    let a = key4[0]
    let b = key4[1]
    let c = key4[2]
    let d = key4[3]
    let det = a * d - b * c
    _hill_gcd(det, 26) == 1

// hill_encrypt: encrypt plaintext pt using the 2x2 Hill cipher key key4.
// key4 = [a, b, c, d] — the matrix [[a,b],[c,d]], must be invertible mod 26.
// Normalizes pt to uppercase letters, drops non-letters.
// Pads with 'X' if the letter count is odd (needed for digraph processing).
// Returns uppercase ciphertext.
//
// Examples:
//   hill_encrypt("HELP", [3,3,2,5]) == "HIAT"
//   hill_encrypt("",     [3,3,2,5]) == ""
//   hill_encrypt("A",    [3,3,2,5]) == result of encrypting "AX"
fn hill_encrypt(pt, key4) -> string
    let a = key4[0]
    let b = key4[1]
    let c = key4[2]
    let d = key4[3]
    // Normalize
    let norm = _hill_normalize(pt)
    // Pad with X if odd length
    let nlen = len(norm)
    if nlen - (nlen / 2) * 2 == 1
        norm = norm + "X"
    let n = len(norm)
    let out = ""
    let i = 0
    while i < n
        let p0 = ord(norm[i]) - 65
        let p1 = ord(norm[i + 1]) - 65
        let c0 = _hill_mod26(a * p0 + b * p1)
        let c1 = _hill_mod26(c * p0 + d * p1)
        out = out + chr(c0 + 65)
        out = out + chr(c1 + 65)
        i = i + 2
    out

// hill_decrypt: decrypt Hill-cipher ciphertext ct using key key4.
// key4 = [a, b, c, d] — must be invertible mod 26.
// Normalizes ct to uppercase letters.
// Returns uppercase plaintext (may include trailing 'X' padding if encrypt padded).
//
// Examples:
//   hill_decrypt("HIAT", [3,3,2,5]) == "HELP"
//   hill_decrypt(hill_encrypt(s, k), k) == s  for s with even letter count
fn hill_decrypt(ct, key4) -> string
    let a = key4[0]
    let b = key4[1]
    let c = key4[2]
    let d = key4[3]
    let det = a * d - b * c
    let det_inv = mod_inverse(det, 26)
    // Inverse matrix: det_inv * [[d, -b], [-c, a]] mod 26
    let ia = _hill_mod26(det_inv * d)
    let ib = _hill_mod26(0 - det_inv * b)
    let ic = _hill_mod26(0 - det_inv * c)
    let id = _hill_mod26(det_inv * a)
    // Normalize ciphertext
    let norm = _hill_normalize(ct)
    let n = len(norm)
    let out_parts = []
    let i = 0
    while i < n
        let p0 = ord(norm[i]) - 65
        let p1 = ord(norm[i + 1]) - 65
        let c0 = _hill_mod26(ia * p0 + ib * p1)
        let c1 = _hill_mod26(ic * p0 + id * p1)
        push(out_parts, chr(c0 + 65))
        push(out_parts, chr(c1 + 65))
        i = i + 2
    let out = join(out_parts, "")
    out
