// std/cipher/scytale -- Scytale transposition cipher. LEAF -- imports NOTHING.
//
// The scytale is one of the oldest known ciphers, used by ancient Sparta.
// A strip of parchment is wound around a rod (the "scytale") of a given
// diameter. Text is written across the rod (left-to-right across each turn),
// then the strip is unwound — the message is scrambled. The recipient winds
// the strip around a rod of the same diameter to read it.
//
// Modern formulation:
//   - Normalize plaintext: uppercase A-Z only, drop non-letters.
//   - Pad with 'X' so length is divisible by `columns`.
//   - Write the padded plaintext row-by-row into a grid of `columns` columns.
//   - Read the ciphertext column-by-column (top-to-bottom, left-to-right).
//
// Decryption reverses: given CT of length L and `columns`, compute
//   rows = L / columns  (L is always divisible by columns after encrypt)
// Fill a grid column-by-column from CT, then read row-by-row.
//
// I/J handling: both I and J are treated as distinct letters (26-letter
// alphabet). The scytale is a pure transposition cipher — no substitution —
// so I/J merging is not needed or applied.
//
// Public API:
//   scytale_encrypt(pt, columns) -> string
//   scytale_decrypt(ct, columns) -> string

// _scy_normalize: uppercase A-Z only, drop everything else.
fn _scy_normalize(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = upper(slice(s, i, i + 1))
        let o = ord(c)
        if o >= 65
            if o <= 90
                out = out + c
        i = i + 1
    out

// scytale_encrypt(pt, columns) -> ciphertext string.
//
// columns is the rod diameter = number of columns in the write grid.
// If columns <= 0, returns the normalized plaintext unchanged.
// Plaintext is normalized then padded with 'X' to a full rectangle.
// Ciphertext is produced by reading each column top-to-bottom.
fn scytale_encrypt(pt: string, columns: int) -> string
    let norm = _scy_normalize(pt)
    if columns <= 0
        return norm
    let plen = len(norm)
    if plen == 0
        return ""
    // Pad to multiple of columns.
    let rem = plen % columns
    let padded = norm
    if rem != 0
        let pad_count = columns - rem
        let pi = 0
        while pi < pad_count
            padded = padded + "X"
            pi = pi + 1
    let total = len(padded)
    let nrows = total / columns
    // Read column-by-column from the row-major grid.
    let out = ""
    let col = 0
    while col < columns
        let row = 0
        while row < nrows
            out = out + slice(padded, row * columns + col, row * columns + col + 1)
            row = row + 1
        col = col + 1
    out

// scytale_decrypt(ct, columns) -> plaintext string (may have trailing X padding).
//
// CT is normalized first (uppercase, letters only). The padded ciphertext
// length must be divisible by `columns` — if not (e.g. the caller passes raw
// non-normalized CT with a different length), we still handle it gracefully by
// treating nrows = ceil(clen / columns) and filling incomplete columns.
//
// Callers who know the original plaintext length should strip trailing 'X'
// padding after calling this function.
fn scytale_decrypt(ct: string, columns: int) -> string
    let norm = _scy_normalize(ct)
    if columns <= 0
        return norm
    let clen = len(norm)
    if clen == 0
        return ""
    // Compute grid dimensions.
    // After encrypt, clen is always divisible by columns.
    // nrows = clen / columns (integer division, exact).
    let nrows = clen / columns
    let leftover = clen % columns
    // If leftover != 0 the input wasn't produced by our encrypt
    // (or was manually truncated). Handle gracefully: nrows=floor, leftover
    // columns get one extra row.
    if leftover != 0
        nrows = nrows + 1
    // Allocate flat grid[nrows * columns] initialized to "".
    let grid = []
    let gi = 0
    while gi < nrows * columns
        push(grid, "")
        gi = gi + 1
    // Fill grid column-by-column from ciphertext.
    // Column col has (nrows) rows if col < leftover (when leftover != 0),
    // otherwise (nrows - 1) rows. When leftover == 0 all columns have nrows.
    let pos = 0
    let col = 0
    while col < columns
        let col_len = nrows
        if leftover != 0
            if col >= leftover
                col_len = nrows - 1
        let row = 0
        while row < col_len
            grid[row * columns + col] = slice(norm, pos, pos + 1)
            pos = pos + 1
            row = row + 1
        col = col + 1
    // Read grid row-by-row.
    let out = ""
    let r = 0
    while r < nrows
        let c = 0
        while c < columns
            out = out + grid[r * columns + c]
            c = c + 1
        r = r + 1
    out
