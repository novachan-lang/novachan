// std/compress/gzip_member -- gzip member header/footer parser (RFC 1952)
//
// A gzip member starts with a 10-byte header:
//   byte 0: 0x1F (31)  magic byte 1
//   byte 1: 0x8B (139) magic byte 2
//   byte 2: CM  -- compression method (8 = deflate)
//   byte 3: FLG -- flags (bit0=FTEXT, bit1=FHCRC, bit2=FEXTRA, bit3=FNAME, bit4=FCOMMENT)
//   bytes 4-7: MTIME (u32le) -- modification time (Unix epoch seconds)
//   byte 8: XFL -- extra flags
//   byte 9: OS  -- operating system (0=FAT, 3=Unix, 255=unknown)
//
// The footer occupies the LAST 8 bytes of the member:
//   CRC32 u32le (bytes len-8..len-5)
//   ISIZE u32le (bytes len-4..len-1) -- uncompressed size mod 2^32

// _gm_u32le: read a little-endian u32 from buf at byte position p.
fn _gm_u32le(buf: any, p: int) -> int
    return buf[p] + buf[p+1]*256 + buf[p+2]*65536 + buf[p+3]*16777216

// gz_magic_check: return true if buf starts with the gzip magic bytes 0x1F 0x8B.
fn gz_magic_check(buf: any) -> bool
    if len(buf) < 2
        return false
    if buf[0] != 31
        return false
    if buf[1] != 139
        return false
    return true

// gz_method: return the compression method byte (byte 2; 8 = deflate).
fn gz_method(buf: any) -> int
    if len(buf) < 3
        return 0
    return buf[2]

// gz_flags: return the FLG byte (byte 3).
fn gz_flags(buf: any) -> int
    if len(buf) < 4
        return 0
    return buf[3]

// gz_flag_ftext: return true if the FTEXT flag bit (bit 0) is set.
fn gz_flag_ftext(buf: any) -> bool
    if len(buf) < 4
        return false
    let f = buf[3]
    let b = f & 1
    if b == 1
        return true
    return false

// gz_flag_fhcrc: return true if the FHCRC flag bit (bit 1) is set.
fn gz_flag_fhcrc(buf: any) -> bool
    if len(buf) < 4
        return false
    let f = buf[3]
    let b = f & 2
    if b == 2
        return true
    return false

// gz_flag_fextra: return true if the FEXTRA flag bit (bit 2) is set.
fn gz_flag_fextra(buf: any) -> bool
    if len(buf) < 4
        return false
    let f = buf[3]
    let b = f & 4
    if b == 4
        return true
    return false

// gz_flag_fname: return true if the FNAME flag bit (bit 3) is set.
fn gz_flag_fname(buf: any) -> bool
    if len(buf) < 4
        return false
    let f = buf[3]
    let b = f & 8
    if b == 8
        return true
    return false

// gz_flag_fcomment: return true if the FCOMMENT flag bit (bit 4) is set.
fn gz_flag_fcomment(buf: any) -> bool
    if len(buf) < 4
        return false
    let f = buf[3]
    let b = f & 16
    if b == 16
        return true
    return false

// gz_mtime: return MTIME as a u32le integer (bytes 4-7).
fn gz_mtime(buf: any) -> int
    if len(buf) < 8
        return 0
    return _gm_u32le(buf, 4)

// gz_xfl: return XFL byte (byte 8).
fn gz_xfl(buf: any) -> int
    if len(buf) < 9
        return 0
    return buf[8]

// gz_os: return OS byte (byte 9).
fn gz_os(buf: any) -> int
    if len(buf) < 10
        return 0
    return buf[9]

// gz_os_name: return human-readable OS name.
fn gz_os_name(buf: any) -> string
    let os = gz_os(buf)
    if os == 3
        return "Unix"
    if os == 0
        return "FAT"
    if os == 255
        return "unknown"
    return "other"

// gz_footer_crc32: return CRC32 from footer (u32le at buf[len-8..len-5]).
fn gz_footer_crc32(buf: any) -> int
    let n = len(buf)
    if n < 8
        return 0
    return _gm_u32le(buf, n-8)

// gz_footer_isize: return ISIZE from footer (u32le at buf[len-4..len-1]).
fn gz_footer_isize(buf: any) -> int
    let n = len(buf)
    if n < 4
        return 0
    return _gm_u32le(buf, n-4)
