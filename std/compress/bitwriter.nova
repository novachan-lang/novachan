// ============================================================================
// NOVA Standard Library — std/compress/bitwriter
// ============================================================================
// Bit-level writer and reader — the foundation layer for entropy coders,
// Huffman serialisation, LZ-family streams, and any algorithm that packs
// data at sub-byte granularity.
//
// A writer accumulates individual bits or multi-bit values into an ordered
// bit-string (a string of '0'/'1' characters). A reader walks that string
// left-to-right, consuming bits on demand.
//
// The bit ordering convention used throughout is MSB-first: when you write
// the value 5 in 3 bits you get "101" (bit 2, bit 1, bit 0 from left to
// right). This matches the natural human reading direction and the ordering
// used by Huffman code books and DEFLATE canonical codes.
//
// PUBLIC API — writer side:
//   bwr_new_writer()             -> dict   create a fresh bit writer
//   bwr_write_bit(w, b)                    append one bit (0 or 1)
//   bwr_write_bits(w, value, nbits)        append nbits from value, MSB first
//   bwr_to_bitstring(w)          -> string the accumulated '0'/'1' string
//   bwr_bit_count(w)             -> int    total bits written so far
//
// PUBLIC API — reader side:
//   bwr_new_reader(bitstring)    -> dict   create a reader over a bit-string
//   bwr_read_bit(r)              -> int    consume and return the next bit (0/1)
//   bwr_read_bits(r, nbits)      -> int    consume nbits, return value MSB first
//   bwr_remaining(r)             -> int    bits not yet consumed
//
// INVARIANTS:
//   bwr_to_bitstring only contains '0' and '1' characters.
//   bwr_read_bit beyond end of string returns 0 (safe underflow).
//   bwr_write_bits with nbits==0 is a no-op.
//   round-trip: write value V in N bits then read N bits yields V (0 <= V < 2^N).
//
// IMPLEMENTATION NOTES:
//   The internal representation is a plain string of '0'/'1'. While a packed
//   byte array would be more memory-efficient for production use, the string
//   representation keeps the code simple, debuggable, and avoids any dependency
//   on the native bytes API. Performance is adequate for codec development and
//   testing; byte-packing can be layered above this module.
//
//   Writer dict keys:  "bits" (string accumulator), "n" (int bit count)
//   Reader dict keys:  "bits" (source string), "pos" (int cursor), "n" (int total)
//
// SYMBOL COLLISION GUARD:
//   All private helpers prefixed _bwr_ to avoid link collisions.
//
// LEAF — imports NOTHING.

// ── Private helpers ────────────────────────────────────────────────────────────

// Extract bit at position idx from value v (MSB first within nbits).
// idx 0 = most-significant, idx nbits-1 = least-significant.
// Returns 0 or 1.
fn _bwr_bit_at(v, nbits, idx) -> int
    let shift = nbits - 1 - idx
    let shifted = v / _bwr_pow2(shift)
    shifted % 2

// Integer power of 2: 2^exp. Used to avoid the << operator.
// Returns 1 for exp==0, 2 for exp==1, etc.
fn _bwr_pow2(exp) -> int
    let result = 1
    let i = 0
    while i < exp
        let dummy = 0
        result = result * 2
        i = i + 1
    result

// ── Writer public API ──────────────────────────────────────────────────────────

// bwr_new_writer: create a new empty bit writer.
//
// Returns a dict with:
//   "bits" -> "" (the accumulated bit-string)
//   "n"    -> 0  (total bits written)
//
// Example:
//   let w = bwr_new_writer()
//   bwr_bit_count(w) == 0
fn bwr_new_writer() -> dict
    let w = {}
    w["bits"] = ""
    w["n"] = 0
    w

// bwr_write_bit: append a single bit b (0 or 1) to writer w.
//
// b is treated as a boolean integer: 0 -> '0', anything else -> '1'.
// Modifies w in place (dict reference semantics).
//
// Example:
//   bwr_write_bit(w, 1)   // appends '1'
//   bwr_write_bit(w, 0)   // appends '0'
fn bwr_write_bit(w, b)
    if b == 0
        w["bits"] = w["bits"] + "0"
    else
        w["bits"] = w["bits"] + "1"
    w["n"] = w["n"] + 1

// bwr_write_bits: append nbits bits from value, MSB first.
//
// value: non-negative integer whose low nbits are written.
// nbits: number of bits to write (0 = no-op, must be >= 0).
//
// The most-significant of the nbits bits is written first (leftmost in
// the output string). This matches the canonical bit ordering used by
// Huffman codes and DEFLATE.
//
// Example:
//   bwr_write_bits(w, 5, 3)  // writes "101" (5 = 0b101)
//   bwr_write_bits(w, 0, 4)  // writes "0000"
fn bwr_write_bits(w, value, nbits)
    let i = 0
    while i < nbits
        let dummy = 0
        let b = _bwr_bit_at(value, nbits, i)
        bwr_write_bit(w, b)
        i = i + 1

// bwr_to_bitstring: return the accumulated bit-string from writer w.
//
// Returns a string containing only '0' and '1' characters, in the order
// bits were written (leftmost = first written = most significant in each
// bwr_write_bits call).
//
// Example:
//   let w = bwr_new_writer()
//   bwr_write_bits(w, 5, 3)
//   bwr_to_bitstring(w) == "101"
fn bwr_to_bitstring(w) -> string
    w["bits"]

// bwr_bit_count: return the total number of bits written to w so far.
//
// Example:
//   let w = bwr_new_writer()
//   bwr_write_bits(w, 5, 3)
//   bwr_bit_count(w) == 3
fn bwr_bit_count(w) -> int
    w["n"]

// ── Reader public API ──────────────────────────────────────────────────────────

// bwr_new_reader: create a reader that will consume bits from bitstring.
//
// bitstring: a string of '0'/'1' characters (as produced by bwr_to_bitstring).
// The reader starts at position 0 (leftmost character = first bit).
//
// Returns a dict with:
//   "bits" -> bitstring (the source)
//   "pos"  -> 0         (current read cursor)
//   "n"    -> len(bitstring) (total bits available)
//
// Example:
//   let r = bwr_new_reader("101")
//   bwr_remaining(r) == 3
fn bwr_new_reader(bitstring) -> dict
    let r = {}
    r["bits"] = bitstring
    r["pos"] = 0
    r["n"] = len(bitstring)
    r

// bwr_read_bit: consume and return the next bit (0 or 1) from reader r.
//
// Advances the read cursor by 1. If the reader is exhausted (no bits
// remaining), returns 0 without advancing (safe underflow convention).
//
// Example:
//   let r = bwr_new_reader("10")
//   bwr_read_bit(r) == 1
//   bwr_read_bit(r) == 0
//   bwr_read_bit(r) == 0  // exhausted -> 0
fn bwr_read_bit(r) -> int
    let pos = r["pos"]
    let total = r["n"]
    let result = 0
    if pos < total
        let ch = r["bits"][pos]
        if ch == "1"
            result = 1
        else
            result = 0
        r["pos"] = pos + 1
    result

// bwr_read_bits: consume nbits from reader r and return their integer value.
//
// Reads bits MSB first (the first bit read becomes the most-significant bit
// of the returned integer). nbits==0 returns 0 immediately.
//
// If fewer than nbits remain, the missing bits are treated as 0 (safe
// underflow — same contract as bwr_read_bit).
//
// Example:
//   let r = bwr_new_reader("1011")
//   bwr_read_bits(r, 3) == 5   // "101" MSB-first = 4+0+1 = 5
//   bwr_read_bit(r) == 1       // "1"
fn bwr_read_bits(r, nbits) -> int
    let value = 0
    let i = 0
    while i < nbits
        let dummy = 0
        let b = bwr_read_bit(r)
        value = value * 2 + b
        i = i + 1
    value

// bwr_remaining: return the number of bits not yet consumed by reader r.
//
// Example:
//   let r = bwr_new_reader("1011")
//   bwr_remaining(r) == 4
//   bwr_read_bit(r)
//   bwr_remaining(r) == 3
fn bwr_remaining(r) -> int
    r["n"] - r["pos"]
