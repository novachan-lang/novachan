// ============================================================================
// NOVA Standard Library — std/compress/bwt_pipeline
// ============================================================================
// Burrows-Wheeler Transform (BWT) operating on BYTE-LISTS (list of ints 0-255).
//
// Unlike std/compress/bwt (which operates on strings), this module works
// entirely with byte-lists so it handles all 256 byte values including 0x00
// without NOVA's NUL-string-truncation hazard.
//
// ALGORITHM — FORWARD:
//   1. Build n cyclic rotation indices [0..n-1].
//   2. Sort indices lexicographically by their cyclic rotation of the input.
//   3. The transformed output is the last character of each sorted rotation,
//      i.e. bytes[(rot_start + n - 1) % n] for each sorted rotation start.
//   4. The primary index is the row in the sorted matrix whose rotation
//      starts at offset 0 (== the original sequence).
//
// ALGORITHM — INVERSE (LF-mapping):
//   Given last column L and primaryIndex:
//   1. F = sorted(L).
//   2. Build LF[i]: the k-th occurrence of L[i] in L maps to the k-th
//      occurrence of L[i] in F.
//   3. Walk n steps from primaryIndex, collecting L[row] each step; reverse.
//
// PUBLIC API:
//   bwt_forward(bytes) -> list
//     Returns [transformed_bytes, primary_index] where transformed_bytes is
//     a list of ints (the BWT last column) and primary_index is an int.
//     Empty input returns [[], 0].
//
//   bwt_inverse(transformed_bytes, primary_index) -> list
//     Reconstructs and returns the original byte-list.
//     Empty input returns [].
//
// COMPLEXITY:
//   Forward: O(n^2) sort steps each O(n) comparison = O(n^3) worst case.
//   Inverse: O(n) LF-mapping walk. Suitable for n < 512.
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _bwtp_.
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// _bwtp_pmod: non-negative modulo (x >= 0, m > 0).
fn _bwtp_pmod(xv, mv) -> int
    xv - (xv / mv) * mv

// _bwtp_rcmp: compare cyclic rotations of byte-list `bv` (length `nv`).
// Returns 1 if rotation starting at ra is strictly less than rotation at rb.
// Returns 0 otherwise (equal or greater).
fn _bwtp_rcmp(bv, nv, ra, rb) -> int
    let ci = 0
    let cres = 0
    let cdone = 0
    while ci < nv and cdone == 0
        let cpa = _bwtp_pmod(ra + ci, nv)
        let cpb = _bwtp_pmod(rb + ci, nv)
        let cca = bv[cpa]
        let ccb = bv[cpb]
        if cca < ccb
            cres = 1
            cdone = 1
        else
            if cca > ccb
                cdone = 1
            else
                ci = ci + 1
    cres

// _bwtp_sortidx: insertion sort of rotation indices by cyclic rotation order.
// Builds a new sorted list (push-only) to avoid NOVA list-index-assignment
// RC-tag bugs. O(n^3) worst case; correct for all n.
fn _bwtp_sortidx(bv, nv, src) -> list
    let ssorted = []
    let ssi = 0
    while ssi < nv
        let sskey = src[ssi]
        let sspos = len(ssorted)
        let ssj = 0
        let ssdone = 0
        while ssj < len(ssorted) and ssdone == 0
            let ssexist = ssorted[ssj]
            if _bwtp_rcmp(bv, nv, sskey, ssexist) == 1
                sspos = ssj
                ssdone = 1
            else
                ssj = ssj + 1
        let ssnew = []
        let ssk = 0
        while ssk < sspos
            push(ssnew, ssorted[ssk])
            ssk = ssk + 1
        push(ssnew, sskey)
        let ssk2 = sspos
        while ssk2 < len(ssorted)
            push(ssnew, ssorted[ssk2])
            ssk2 = ssk2 + 1
        ssorted = ssnew
        ssi = ssi + 1
    ssorted

// ── Public API ────────────────────────────────────────────────────────────────

// bwt_forward(bytes) -> list
//
// Compute the BWT of a byte-list `bytes` (list of ints 0-255).
//
// Returns a two-element list:
//   result[0] — transformed byte-list (list of ints, same length as bytes)
//   result[1] — primary_index (int): row in sorted rotation matrix whose
//               rotation equals the original sequence (needed for inverse).
//
// Examples:
//   bwt_forward([])             == [[], 0]
//   bwt_forward([97])           == [[97], 0]
//   bwt_forward([98,97,110,97,110,97])  // "banana"
//       transformed = [110,110,98,97,97,97], primary_index = 3
fn bwt_forward(bytes) -> list
    let tn = len(bytes)
    if tn == 0
        let ter = [[], 0]
        return ter
    // Build index list [0..tn-1] push-only
    let tsrc = []
    let tk = 0
    while tk < tn
        push(tsrc, tk)
        tk = tk + 1
    // Sort rotation indices
    let tidxs = _bwtp_sortidx(bytes, tn, tsrc)
    // Extract last column and find primary index
    let ttransformed = []
    let tprimary = 0
    let ti = 0
    while ti < tn
        let trot = tidxs[ti]
        let tlp = _bwtp_pmod(trot + tn - 1, tn)
        push(ttransformed, bytes[tlp])
        if trot == 0
            tprimary = ti
        ti = ti + 1
    let tres = [ttransformed, tprimary]
    tres

// bwt_inverse(transformed_bytes, primary_index) -> list
//
// Reconstruct the original byte-list from the BWT last column and primary index.
//
// Parameters:
//   transformed_bytes — list of ints produced by bwt_forward(x)[0]
//   primary_index     — int produced by bwt_forward(x)[1]
//
// Returns the original byte-list.
//
// Uses the LF-mapping algorithm:
//   Sort transformed_bytes to get first column F.
//   Build LF[i]: k-th occurrence of L[i] in L maps to k-th occurrence in F.
//   Walk n steps from primary_index collecting L[row]; reverse.
fn bwt_inverse(transformed_bytes, primary_index) -> list
    let ivn = len(transformed_bytes)
    if ivn == 0
        let empty = []
        return empty
    // Count frequencies of each byte value in L
    let ivfreq = {}
    let ivi = 0
    while ivi < ivn
        let ivb = transformed_bytes[ivi]
        let ivk = str(ivb)
        if contains(ivfreq, ivk)
            ivfreq[ivk] = ivfreq[ivk] + 1
        else
            ivfreq[ivk] = 1
        ivi = ivi + 1
    // Find sorted unique byte values (collect all 256 possible, filter present)
    // Build cumulative start offset in F for each byte value
    let ivfstart = {}
    let ivcumul = 0
    let ivbv = 0
    while ivbv < 256
        let ivbk = str(ivbv)
        if contains(ivfreq, ivbk)
            ivfstart[ivbk] = ivcumul
            ivcumul = ivcumul + ivfreq[ivbk]
        ivbv = ivbv + 1
    // Build LF array: scan L left-to-right
    let ivseen = {}
    let ivLF = []
    let ivi2 = 0
    while ivi2 < ivn
        let ivb2 = transformed_bytes[ivi2]
        let ivbk2 = str(ivb2)
        let ivrank = 0
        if contains(ivseen, ivbk2)
            ivrank = ivseen[ivbk2]
        ivseen[ivbk2] = ivrank + 1
        push(ivLF, ivfstart[ivbk2] + ivrank)
        ivi2 = ivi2 + 1
    // Walk ivn steps from primary_index, collecting L[row]
    let ivout_rev = []
    let ivrow = primary_index
    let ivstep = 0
    while ivstep < ivn
        push(ivout_rev, transformed_bytes[ivrow])
        ivrow = ivLF[ivrow]
        ivstep = ivstep + 1
    // Reverse to get original
    let ivout = []
    let ivri = ivn - 1
    while ivri >= 0
        push(ivout, ivout_rev[ivri])
        ivri = ivri - 1
    ivout
