// ============================================================================
// NOVA Standard Library — std/compress/mtf_order1
// ============================================================================
// Move-to-Front Transform — byte-list variant (operates on list of ints 0-255).
//
// Unlike std/compress/mtf (which operates on strings), this module works
// entirely with byte-lists so it handles all 256 byte values including 0x00
// without NOVA's NUL-string-truncation hazard.
//
// ALGORITHM:
//   Maintain a working alphabet: a list of 256 integers, initially [0,1,...,255]
//   (position k holds ordinal k at the start).
//
//   ENCODE — for each input byte value b:
//     1. Find pos = current position of b in the working alphabet.
//     2. Emit pos as the encoded value.
//     3. Move b to the front (position 0) of the alphabet.
//
//   DECODE — for each encoded index pos:
//     1. Emit the byte at position pos in the working alphabet.
//     2. Move that byte to the front.
//
//   Locally-repeated bytes always encode to 0 (after their first occurrence),
//   which is why MTF pairs well after BWT (BWT clusters equal bytes together).
//
// PUBLIC API:
//   mtf_encode(bytes) -> list
//     Encode a byte-list (list of ints 0-255) using MTF with the default
//     256-symbol alphabet [0,1,...,255].
//     Returns a list of integer indices (0-255), one per input byte.
//
//   mtf_decode(codes) -> list
//     Invert mtf_encode: reconstruct the original byte-list from encoded indices.
//     Returns a list of ints 0-255.
//
// INVARIANTS:
//   mtf_decode(mtf_encode(bytes)) == bytes  for all valid byte-lists.
//   mtf_encode([0,0,0]) == [0, 0, 0]  (byte 0 is already at position 0)
//   mtf_encode([1,1,1]) == [1, 0, 0]  (byte 1 at pos 1 first, then pos 0)
//   mtf_encode([65,65,65]) == [65, 0, 0]  ('A'=65 at pos 65 first, then 0)
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _mtfo_.
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// _mtfo_default_alpha: build the default 256-element alphabet [0,1,...,255].
// Stored as integers to avoid NUL-truncation. Called fresh per encode/decode.
fn _mtfo_default_alpha() -> list
    let alpha = [i for i in 0..256]
    alpha

// _mtfo_find: linear scan for integer value `v` in list `alpha`.
// Returns the index of the first occurrence, or -1 if not found.
fn _mtfo_find(alpha, v) -> int
    let n = len(alpha)
    let i = 0
    let found = -1
    let done = 0
    while i < n and done == 0
        if alpha[i] == v
            found = i
            done = 1
        i = i + 1
    found

// _mtfo_move_front: rebuild alphabet with element at `pos` moved to position 0.
// Returns a NEW list; all other elements shift right by one.
fn _mtfo_move_front(alpha, pos) -> list
    let n = len(alpha)
    let moved = alpha[pos]
    let out = []
    push(out, moved)
    for i in 0..n
        if i != pos
            push(out, alpha[i])
    out

// ── Public API ────────────────────────────────────────────────────────────────

// mtf_encode(bytes) -> list
//
// Apply MTF transform to a byte-list using the default 256-symbol alphabet.
//
// Each input byte value b is replaced by its current position in the working
// alphabet, then moved to the front. Repeated bytes encode as 0 (or small
// indices). This pairs well after BWT which groups equal bytes.
//
// Known-answer examples:
//   mtf_encode([0,0,0])    == [0, 0, 0]   byte 0 is always at position 0
//   mtf_encode([1,1,1])    == [1, 0, 0]   byte 1 starts at pos 1, then 0
//   mtf_encode([65,65,65]) == [65, 0, 0]  'A'=65 starts at pos 65, then 0
//   mtf_encode([65,66,65]) == [65, 66, 1] 'A' at 65, 'B' at 66 (shifted), 'A' now at 1
fn mtf_encode(bytes) -> list
    let alpha = _mtfo_default_alpha()
    let out = []
    let n = len(bytes)
    for i in 0..n
        let b = bytes[i]
        let pos = _mtfo_find(alpha, b)
        push(out, pos)
        alpha = _mtfo_move_front(alpha, pos)
    out

// mtf_decode(codes) -> list
//
// Invert mtf_encode. Given a list of integer indices produced by mtf_encode,
// reconstruct the original byte-list using the default 256-symbol alphabet.
//
// For each index pos in `codes`:
//   1. Emit the byte value at position pos in the working alphabet.
//   2. Move that byte value to position 0.
//
// Round-trip guarantee:
//   mtf_decode(mtf_encode(bytes)) == bytes  for all valid byte-lists.
fn mtf_decode(codes) -> list
    let alpha = _mtfo_default_alpha()
    let out = []
    let n = len(codes)
    for i in 0..n
        let pos = codes[i]
        let b = alpha[pos]
        push(out, b)
        alpha = _mtfo_move_front(alpha, pos)
    out
