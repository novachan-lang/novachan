// ============================================================================
// NOVA Standard Library — std/compress/delta_of_delta
// ============================================================================
// Double-delta encoding (delta-of-delta, DoD) for integer sequences.
//
// Regular delta encoding stores first differences. Double-delta goes one level
// further: it stores the first value, the first delta, and then the deltas of
// those deltas. For sequences with a constant step (timestamps from a fixed
// rate sensor, arithmetic progressions), the deltas-of-deltas are ALL ZERO,
// giving excellent compression when combined with a subsequent entropy coder.
//
// The classic application is Facebook's Gorilla TSDB, which achieved 1.37
// bytes/point for timestamp streams using DoD + variable-length coding.
//
// PUBLIC API:
//   dod_encode(ints) -> list
//     Encode an integer list to double-delta form.
//     Returns [] for empty input.
//     Returns [v0] for a singleton.
//     Returns [v0, d0] for a two-element input.
//     Returns [v0, d0, dd1, dd2, ...] for longer inputs,
//     where d0 = ints[1]-ints[0] and dd_i = (ints[i+1]-ints[i]) - d0_prev.
//
//   dod_decode(encoded) -> list
//     Reconstruct the original integer list from a double-delta encoding.
//     Inverse of dod_encode.
//     dod_decode(dod_encode(xs)) == xs for all integer lists xs.
//
// ENCODING LAYOUT:
//   Position 0:    first value (verbatim)
//   Position 1:    first delta = ints[1] - ints[0]   (omitted if len < 2)
//   Position 2..:  deltas-of-deltas = delta[i] - delta[i-1]
//
// KEY PROPERTY:
//   For a constant-rate sequence [a, a+k, a+2k, a+3k, ...]:
//     deltas   = [k, k, k, ...]
//     dod vals = [0, 0, 0, ...]
//   The encoded stream collapses to [a, k, 0, 0, 0, ...] — run-length
//   encodable to just 3 values regardless of sequence length.
//
// ALGORITHM:
//   Two O(n) passes (one encode, one decode). No heap beyond output list.
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _dod_ to avoid link collisions.
//
// LEAF — imports NOTHING.

// ── Public API ────────────────────────────────────────────────────────────────

// dod_encode: convert an integer list to double-delta (delta-of-delta) form.
//
// Examples:
//   dod_encode([])                  -> []
//   dod_encode([5])                 -> [5]
//   dod_encode([10, 20])            -> [10, 10]
//   dod_encode([100, 110, 120, 130]) -> [100, 10, 0, 0]  (constant delta)
//   dod_encode([1, 2, 4, 7, 11])    -> [1, 1, 1, 1, 1]  (second diffs = 1)
fn dod_encode(ints) -> list
    let n = len(ints)
    let out = []
    if n == 0
        return out
    // First value verbatim.
    push(out, ints[0])
    if n == 1
        return out
    // First delta.
    let d0 = ints[1] - ints[0]
    push(out, d0)
    if n == 2
        return out
    // For each subsequent element, compute the new delta and subtract the
    // previous delta to get the delta-of-delta.
    let prev_d = d0
    let i = 2
    while i < n
        let cur_d = ints[i] - ints[i - 1]
        let dd = cur_d - prev_d
        push(out, dd)
        prev_d = cur_d
        i = i + 1
    out

// dod_decode: reconstruct an integer list from its double-delta encoding.
//
// Inverse of dod_encode. Performs two cumulative sums:
//   first  to recover deltas from deltas-of-deltas,
//   second to recover values from deltas.
//
// dod_decode(dod_encode(xs)) == xs for all integer lists xs.
//
// Examples:
//   dod_decode([])                 -> []
//   dod_decode([5])                -> [5]
//   dod_decode([10, 10])           -> [10, 20]
//   dod_decode([100, 10, 0, 0])    -> [100, 110, 120, 130]
fn dod_decode(encoded) -> list
    let n = len(encoded)
    let out = []
    if n == 0
        return out
    // First value is verbatim.
    let v0 = encoded[0]
    push(out, v0)
    if n == 1
        return out
    // Second element is the first delta.
    let first_d = encoded[1]
    let v1 = v0 + first_d
    push(out, v1)
    if n == 2
        return out
    // Remaining elements are deltas-of-deltas.
    // Accumulate delta first, then accumulate value.
    let cur_d = first_d
    let cur_v = v1
    let i = 2
    while i < n
        let dd = encoded[i]
        cur_d = cur_d + dd        // recover delta by accumulating dod
        cur_v = cur_v + cur_d     // recover value by accumulating delta
        push(out, cur_v)
        i = i + 1
    out
