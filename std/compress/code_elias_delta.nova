// ============================================================================
// NOVA Standard Library — std/compress/code_elias_delta
// ============================================================================
// Elias delta universal code for positive integers (n >= 1).
//
// A BITSTREAM is a LIST of ints, each 0 or 1, MSB-first in emission order.
// This is the canonical integer-code bit-list API used across std/compress.
//
// ELIAS DELTA CODING (n >= 1):
//   Let k = floor(log2(n))           (bit-length of n minus 1)
//   Let N = k + 1                    (bit-length of n)
//   Emit gamma_encode(N), then the low k bits of n (the leading 1 is implicit).
//
//   Gamma encode of N:
//     Let j = floor(log2(N))         (number of leading zeros)
//     Emit j zeros, then N in binary (j+1 bits, MSB first)
//
//   Examples:
//     n=1:  k=0, N=1, gamma(1)=[1],        0 low bits -> [1]
//     n=2:  k=1, N=2, gamma(2)=[0,1,0],    low 1 bit of 2=0  -> [0,1,0,0]
//     n=3:  k=1, N=2, gamma(2)=[0,1,0],    low 1 bit of 3=1  -> [0,1,0,1]
//     n=4:  k=2, N=3, gamma(3)=[0,1,1],    low 2 bits of 4=00 -> [0,1,1,0,0]
//     n=5:  k=2, N=3, gamma(3)=[0,1,1],    low 2 bits of 5=01 -> [0,1,1,0,1]
//     n=9:  k=3, N=4, gamma(4)=[0,0,1,0,0],low 3 bits of 9=001 -> [0,0,1,0,0,0,0,1]
//
// DECODING:
//   1. Count leading zeros in bitstream at pos -> j (that is k for gamma sub-decode)
//   2. Read j+1 bits as integer N (= k+1 where k is log2 of original n)
//   3. k_orig = N - 1
//   4. If k_orig == 0: value = 1, done.
//   5. Read k_orig more bits as the low bits; value = (1 << k_orig) | low_bits.
//
// SECONDARY API — pack_bits:
//   pack_bits(bit_list) -> list of byte values (0-255).
//   Packs 8 bits per byte, MSB-first, zero-padding the last byte if needed.
//
// PUBLIC API:
//   delta_encode(n)          -> list  [0/1 ints]
//   delta_decode(bits, pos)  -> list  [value, next_pos]
//   pack_bits(bit_list)      -> list  [byte values]
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _ced_.
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _ced_floor_log2: floor(log2(n)) for n >= 1.
// n=1->0, n=2->1, n=3->1, n=4->2, ...
fn _ced_floor_log2(n) -> int
    let k = 0
    let v = n
    while v > 1
        let _dummy = 0
        v = v / 2
        k = k + 1
    k

// _ced_push_int_bits: append nbits MSB-first binary representation of v
// to the list out (MUTATES out via push). Returns nothing useful.
fn _ced_push_int_bits(out, v, nbits) -> int
    if nbits <= 0
        return 0
    let i = nbits - 1
    while i >= 0
        let bit = (v >> i) & 1
        push(out, bit)
        i = i - 1
    0

// _ced_gamma_into: gamma-encode positive integer n and push bits into out.
// Gamma code: j leading zeros then n in j+1 bits, where j=floor(log2(n)).
fn _ced_gamma_into(out, n) -> int
    let j = _ced_floor_log2(n)
    for zi in 0..j
        let _d = 0
        push(out, 0)
    _ced_push_int_bits(out, n, j + 1)
    0

// ── Public API ───────────────────────────────────────────────────────────────

// delta_encode: Elias delta code for n >= 1.
// Returns a list of ints (each 0 or 1), MSB first.
//
// Algorithm:
//   k = floor(log2(n))
//   N = k + 1  (bit-length of n)
//   gamma_encode(N) ++ low k bits of n
fn delta_encode(n) -> list
    let bits = []
    if n < 1
        return bits
    let k = _ced_floor_log2(n)
    let cap_n = k + 1
    _ced_gamma_into(bits, cap_n)
    _ced_push_int_bits(bits, n, k)
    bits

// delta_decode: decode one Elias delta value from bit-list bits, starting at pos.
// Returns [value, next_pos].
// next_pos is the index immediately after the last consumed bit.
// Malformed/truncated input returns [-1, len(bits)].
//
// Algorithm:
//   1. Count leading zeros at pos -> j; advance pos past them.
//   2. Read j+1 bits at pos -> N (the gamma-decoded bit-length); advance pos.
//   3. k_orig = N - 1.
//   4. If k_orig == 0: value = 1.
//   5. Else read k_orig bits -> low_bits; value = (1 << k_orig) | low_bits.
fn delta_decode(bits, pos) -> list
    let blen = len(bits)
    let result = []
    // Step 1: count leading zeros
    let j = 0
    let cur = pos
    let counting = 1
    while cur < blen and counting == 1
        let _d = 0
        if bits[cur] == 0
            j = j + 1
            cur = cur + 1
        else
            counting = 0
    // cur now points at the '1' bit (or we ran off the end)
    if cur >= blen
        push(result, -1)
        push(result, blen)
        return result
    // Step 2: read j+1 bits as N (includes the '1' we're sitting on)
    let need = j + 1
    if cur + need > blen
        push(result, -1)
        push(result, blen)
        return result
    let cap_n = 0
    for ri in 0..need
        let _d2 = 0
        cap_n = cap_n * 2 + bits[cur + ri]
    cur = cur + need
    // Step 3: k_orig = N - 1
    let k_orig = cap_n - 1
    if k_orig == 0
        // value = 1
        push(result, 1)
        push(result, cur)
        return result
    // Step 5: read k_orig low bits
    if cur + k_orig > blen
        push(result, -1)
        push(result, blen)
        return result
    let low_bits = 0
    for li in 0..k_orig
        let _d3 = 0
        low_bits = low_bits * 2 + bits[cur + li]
    cur = cur + k_orig
    let value = (1 << k_orig) | low_bits
    push(result, value)
    push(result, cur)
    result

// pack_bits: pack a list of 0/1 ints into bytes (8 bits per byte, MSB-first).
// The last byte is zero-padded on the right if len(bit_list) is not a multiple of 8.
// Returns a list of ints in [0..255].
fn pack_bits(bit_list) -> list
    let out = []
    let n = len(bit_list)
    let i = 0
    while i < n
        let _d = 0
        let byte_val = 0
        for b in 0..8
            let _d2 = 0
            byte_val = byte_val * 2
            if i + b < n
                byte_val = byte_val + bit_list[i + b]
        push(out, byte_val)
        i = i + 8
    out
