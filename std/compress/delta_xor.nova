// ============================================================================
// NOVA Standard Library — std/compress/delta_xor
// ============================================================================
// Delta and XOR filters — reversible preprocessing transforms that convert
// smooth or correlated byte sequences into sequences with smaller values,
// greatly improving the effectiveness of downstream entropy coders (Huffman,
// LZ, etc.).
//
// DELTA FILTER (byte-level differencing):
//   delta_encode: byte i is replaced by (byte[i] - byte[i-1]) & 0xFF.
//                 byte[0] is stored unchanged (it is the reference).
//   delta_decode: the inverse — reconstruct byte[i] by cumulative summation.
//
//   For a ramp [10, 11, 12, 13], delta_encode produces [10, 1, 1, 1].
//   This compresses extremely well for smooth sequences (sensor data,
//   grayscale images, audio PCM).
//
// XOR FILTER (byte-level XOR differencing):
//   xor_encode: byte i is replaced by (byte[i] XOR byte[i-1]).
//               byte[0] is stored unchanged (it is the reference).
//   xor_decode: the inverse — reconstruct byte[i] by cumulative XOR.
//
//   XOR is preferred over delta for data where the dominant correlation
//   is bitwise rather than arithmetic (e.g., serialized floats, bitmaps).
//
// Both filters are their own inverse structure (encode then decode = identity)
// and are O(n) single-pass with no extra allocation beyond the output list.
//
// PUBLIC API:
//   delta_encode(bytes) -> byte-list
//   delta_decode(bytes) -> byte-list
//   xor_encode(bytes)   -> byte-list
//   xor_decode(bytes)   -> byte-list
//
// ROUND-TRIP GUARANTEES:
//   delta_decode(delta_encode(x)) == x for all byte-lists x.
//   xor_decode(xor_encode(x))     == x for all byte-lists x.
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _dxf_
//
// LEAF — imports NOTHING.

// ── Public API ────────────────────────────────────────────────────────────────

// delta_encode: apply the delta filter to a byte-list.
//
// Returns a byte-list of the same length. The first byte is stored unchanged.
// Each subsequent byte[i] is replaced by (byte[i] - byte[i-1]) & 0xFF so that
// the result fits in [0, 255].
//
// For smooth/slowly-changing data, the output has many small values (near 0
// or near 255 for small negative deltas in unsigned 8-bit arithmetic).
//
// Published vector:
//   delta_encode([10, 11, 12, 13]) == [10, 1, 1, 1]
//   delta_encode([20, 15, 10, 5])  == [20, 251, 251, 251]  (−5 & 0xFF = 251)
//
// Examples:
//   delta_encode([])        -> []
//   delta_encode([42])      -> [42]
//   delta_encode([10,11,12,13]) -> [10, 1, 1, 1]
fn delta_encode(bytes) -> list
    let n = len(bytes)
    let out = []
    if n == 0
        return out
    let prev = bytes[0]
    out.push(prev)
    let i = 1
    while i < n
        let cur = bytes[i]
        let d = (cur - prev) & 0xFF
        out.push(d)
        prev = cur
        i = i + 1
    out

// delta_decode: invert the delta filter.
//
// The first byte is the absolute reference; each subsequent byte is a signed
// delta stored modulo 256. Decode by cumulative addition modulo 256.
//
// delta_decode(delta_encode(x)) == x for all byte-lists x.
//
// Examples:
//   delta_decode([])            -> []
//   delta_decode([42])          -> [42]
//   delta_decode([10, 1, 1, 1]) -> [10, 11, 12, 13]
fn delta_decode(bytes) -> list
    let n = len(bytes)
    let out = []
    if n == 0
        return out
    let acc = bytes[0]
    out.push(acc)
    let i = 1
    while i < n
        let d = bytes[i]
        acc = (acc + d) & 0xFF
        out.push(acc)
        i = i + 1
    out

// xor_encode: apply the XOR filter to a byte-list.
//
// Returns a byte-list of the same length. The first byte is stored unchanged.
// Each subsequent byte[i] is replaced by (byte[i] XOR byte[i-1]).
//
// XOR differences stay in [0, 255] naturally (no masking needed beyond XOR).
// Useful when data has bitwise correlation (floating-point exponents, palettes).
//
// Examples:
//   xor_encode([])            -> []
//   xor_encode([0xFF, 0xFF])  -> [0xFF, 0x00]
//   xor_encode([10, 12, 10])  -> [10, 6, 6]   (10^12=6, 12^10=6)
fn xor_encode(bytes) -> list
    let n = len(bytes)
    let out = []
    if n == 0
        return out
    let prev = bytes[0]
    out.push(prev)
    let i = 1
    while i < n
        let cur = bytes[i]
        out.push(cur ^ prev)
        prev = cur
        i = i + 1
    out

// xor_decode: invert the XOR filter.
//
// The first byte is the absolute reference; each subsequent byte is XOR'd
// with the previous decoded byte to recover the original.
//
// xor_decode(xor_encode(x)) == x for all byte-lists x.
//
// Examples:
//   xor_decode([])         -> []
//   xor_decode([10, 6, 6]) -> [10, 12, 10]   (10; 10^6=12; 12^6=10)
fn xor_decode(bytes) -> list
    let n = len(bytes)
    let out = []
    if n == 0
        return out
    let prev = bytes[0]
    out.push(prev)
    let i = 1
    while i < n
        let d = bytes[i]
        let cur = d ^ prev
        out.push(cur)
        prev = cur
        i = i + 1
    out
