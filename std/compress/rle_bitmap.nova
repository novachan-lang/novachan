// ============================================================================
// NOVA Standard Library — std/compress/rle_bitmap
// ============================================================================
// Bit-run-length encoding for bitmaps (lists of 0/1 values).
//
// This codec is directly based on the scheme used in CCITT Group 3/4 fax
// compression and common bitmap RLE formats:
//   - The compressed form is a list of run lengths (positive integers).
//   - Run lengths alternate between the count of 0-bits and the count of 1-bits,
//     starting with the count of leading 0-bits (which may be 0 if the first bit
//     is 1).
//   - To decode: start with bit value 0, emit that many bits, flip, emit next
//     run length, repeat until all runs are consumed.
//
// Example:
//   bits = [0, 0, 1, 1, 1, 0, 1]
//   runs = [2, 3, 1, 1]   (2 zeros, 3 ones, 1 zero, 1 one)
//
//   bits = [1, 1, 1, 0, 0, 1]
//   runs = [0, 3, 2, 1]   (0 leading zeros, 3 ones, 2 zeros, 1 one)
//
// EDGE CASES:
//   Empty bit-list -> [] (zero runs)
//   All-zeros      -> [n] (one run: n zeros)
//   All-ones       -> [0, n] (zero leading zeros, then n ones)
//
// PUBLIC API:
//   rle_bitmap_compress(bits) -> list    (run lengths, starting with count of 0s)
//   rle_bitmap_decompress(runs) -> list  (bit-list of 0s and 1s)
//
// ROUND-TRIP GUARANTEE:
//   rle_bitmap_decompress(rle_bitmap_compress(bits)) == bits for all bit-lists.
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _rlbm_
//
// LEAF — imports NOTHING.

// ── Public API ────────────────────────────────────────────────────────────────

// rle_bitmap_compress: encode a bit-list as alternating run lengths.
//
// Input: a list of ints, each 0 or 1.
// Output: a list of non-negative integers (run lengths).
//   runs[0] = count of leading 0-bits (may be 0 if first bit is 1)
//   runs[1] = count of following 1-bits
//   runs[2] = count of following 0-bits
//   ... alternating 0-runs and 1-runs.
//
// Empty input returns [].
//
// Examples:
//   rle_bitmap_compress([])              -> []
//   rle_bitmap_compress([0,0,1,1,1,0,1]) -> [2, 3, 1, 1]
//   rle_bitmap_compress([1,1,1,0,0,1])   -> [0, 3, 2, 1]
//   rle_bitmap_compress([0,0,0,0])        -> [4]
//   rle_bitmap_compress([1,1,1,1])        -> [0, 4]
fn rle_bitmap_compress(bits) -> list
    let n = len(bits)
    let runs = []
    if n == 0
        return runs
    // Alternate between bit values 0 and 1, starting at 0.
    // For each segment, count consecutive bits equal to cur_bit.
    let cur_bit = 0
    let pos = 0
    while pos < n
        // Count how many consecutive bits equal cur_bit starting at pos.
        let run_len = 0
        while pos < n and bits[pos] == cur_bit
            run_len = run_len + 1
            pos = pos + 1
        runs.push(run_len)
        // Flip to next bit value.
        if cur_bit == 0
            cur_bit = 1
        else
            cur_bit = 0
    runs

// rle_bitmap_decompress: reconstruct a bit-list from alternating run lengths.
//
// Input: a list of non-negative integers (run lengths) as produced by
//   rle_bitmap_compress.
// Output: a list of 0/1 integers.
//
// Starts with bit value 0, emits runs[0] zeros, flips to 1, emits runs[1] ones,
// etc. A run length of 0 is valid (emits nothing for that segment).
//
// rle_bitmap_decompress(rle_bitmap_compress(bits)) == bits for all bit-lists.
//
// Examples:
//   rle_bitmap_decompress([])         -> []
//   rle_bitmap_decompress([2,3,1,1])  -> [0,0,1,1,1,0,1]
//   rle_bitmap_decompress([0,3,2,1])  -> [1,1,1,0,0,1]
//   rle_bitmap_decompress([4])        -> [0,0,0,0]
//   rle_bitmap_decompress([0,4])      -> [1,1,1,1]
fn rle_bitmap_decompress(runs) -> list
    let nr = len(runs)
    let out = []
    let cur_bit = 0
    let i = 0
    while i < nr
        let run_len = runs[i]
        let j = 0
        while j < run_len
            out.push(cur_bit)
            j = j + 1
        // Flip bit.
        if cur_bit == 0
            cur_bit = 1
        else
            cur_bit = 0
        i = i + 1
    out
