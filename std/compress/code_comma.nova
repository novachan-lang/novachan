// ============================================================================
// NOVA Standard Library — std/compress/code_comma
// ============================================================================
// Comma codes: self-delimiting integer codes that use a third "comma" symbol
// as a terminator, enabling variable-length codes over a ternary digit alphabet.
//
// THEORY (base-3 comma code):
//   The classical comma code over {0, 1, 2} uses digit 2 as the comma/terminator.
//   All codewords consist of base-2 digits (0 or 1) followed by a single 2.
//   This means:
//     - Each codeword is a prefix-free, self-delimiting sequence.
//     - The digit 2 NEVER appears in the payload, only as the final delimiter.
//     - Codes are NOT the base-3 representation of n; instead, n's value is
//       encoded in the binary (base-2) digits that precede the comma.
//
// ENCODING CONVENTION (comma3):
//   We use bijective base-2 encoding: every non-negative integer n maps to
//   a unique sequence of {0,1}* followed by a single 2.
//
//   Let m = n + 1.  (so m >= 1)
//   Let k = floor(log2(m)).  (number of bits after the implicit leading 1)
//   Payload = k bits: the binary digits of m from bit k-1 down to bit 0
//             (i.e., all bits of m except the leading 1-bit).
//   Code = payload ++ [2].
//
//   Decoding: read digits until hitting 2; restore m = 1 followed by
//   the payload bits; return n = m - 1.
//   For empty payload: m = 1, so n = 0.
//
// EXAMPLES:
//   n=0:   m=1, k=0, payload=[],      code=[2]
//   n=1:   m=2, k=1, payload=[0],     code=[0,2]
//   n=2:   m=3, k=1, payload=[1],     code=[1,2]
//   n=3:   m=4, k=2, payload=[0,0],   code=[0,0,2]
//   n=4:   m=5, k=2, payload=[0,1],   code=[0,1,2]
//   n=5:   m=6, k=2, payload=[1,0],   code=[1,0,2]
//   n=6:   m=7, k=2, payload=[1,1],   code=[1,1,2]
//   n=7:   m=8, k=3, payload=[0,0,0], code=[0,0,0,2]
//   n=100: m=101, k=6, payload=[1,0,0,1,0,1], code=[1,0,0,1,0,1,2]
//
// PROPERTIES:
//   - Self-delimiting: the comma (2) ends each code; safe to concatenate.
//   - Prefix-free: no code is a prefix of another (comma terminates).
//   - Bijective: every n >= 0 has a unique code; no n is skipped.
//   - Length of comma3_encode(n) = floor(log2(n+1)) + 1 digits (incl. comma).
//
// PUBLIC API:
//   comma3_encode(n) -> list
//     Encode non-negative integer n as a list of digits in {0,1,2}.
//     The final element is always 2 (the comma). n must be >= 0.
//     Returns [2] for n=0. Returns [] for n < 0 (guard).
//
//   comma3_decode(digits, pos) -> list
//     Decode one comma-code from the digit list starting at index pos.
//     Returns [value, next_pos] where next_pos is the index immediately
//     after the consumed comma (2) digit.
//     Returns [-1, len(digits)] on truncated/malformed input (no 2 found).
//
//   comma3_encode_seq(nums) -> list
//     Encode a list of non-negative integers into a single concatenated
//     digit list (each integer's code includes its trailing 2 delimiter).
//
//   comma3_decode_seq(digits) -> list
//     Decode ALL comma-codes from a digit list produced by comma3_encode_seq.
//     Returns a list of decoded values. Stops when pos >= len(digits).
//     Stops early on malformed input (missing comma before end of stream).
//
// SYMBOL COLLISION GUARD:
//   All private helpers use prefix _cc3_ to avoid link collisions.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// _cc3_floor_log2: return floor(log2(n)) for n >= 1.
// n=1 -> 0, n=2 -> 1, n=3 -> 1, n=4 -> 2, ...
fn _cc3_floor_log2(n) -> int
    let k = 0
    let v = n
    while v > 1
        v = v / 2
        k += 1
    k

// _cc3_int_to_bits: convert integer v to an nbits-wide MSB-first list of 0/1 ints.
// v must fit in nbits bits. nbits=0 returns [].
fn _cc3_int_to_bits(v, nbits) -> list
    let out = []
    if nbits <= 0
        return out
    let i = nbits - 1
    while i >= 0
        let bit = (v >> i) & 1
        push(out, bit)
        i -= 1
    out

// ── Public API ────────────────────────────────────────────────────────────────

// comma3_encode: encode non-negative integer n as a base-3 comma code.
//
// Algorithm:
//   m = n + 1
//   k = floor(log2(m))         // number of payload bits (0 for n=0, m=1)
//   emit the k low-order bits of m (MSB-first), then emit 2
//
// The k low-order bits of m are bits k-1 down to 0 of m.
// Since m has exactly k+1 significant bits with the top bit always 1,
// we skip that leading 1 and emit only the remaining k bits.
//
// Examples:
//   comma3_encode(0) -> [2]
//   comma3_encode(1) -> [0, 2]
//   comma3_encode(2) -> [1, 2]
//   comma3_encode(3) -> [0, 0, 2]
//   comma3_encode(4) -> [0, 1, 2]
//   comma3_encode(5) -> [1, 0, 2]
//   comma3_encode(6) -> [1, 1, 2]
//   comma3_encode(7) -> [0, 0, 0, 2]
fn comma3_encode(n) -> list
    let out = []
    if n < 0
        return out
    let m = n + 1
    let k = _cc3_floor_log2(m)
    // Emit k payload bits: bits k-1 down to 0 of m.
    // These are exactly the bits BELOW the leading 1 of m.
    let i = k - 1
    while i >= 0
        let bit = (m >> i) & 1
        push(out, bit)
        i -= 1
    // Append the comma delimiter
    push(out, 2)
    out

// comma3_decode: decode one comma-code from digit list at offset pos.
//
// Reads digits from pos until a 2 is encountered. Payload digits (0 or 1)
// are accumulated as binary bits to reconstruct m = 1 || payload_bits.
// Returns n = m - 1.
//
// Returns [value, next_pos] where next_pos is immediately after the 2.
// Returns [-1, len(digits)] on malformed input (no 2 before end of list).
//
// Examples:
//   comma3_decode([2], 0)                   -> [0, 1]
//   comma3_decode([0, 2], 0)                -> [1, 2]
//   comma3_decode([1, 2], 0)                -> [2, 2]
//   comma3_decode([0, 0, 2], 0)             -> [3, 3]
//   comma3_decode([1, 0, 0, 1, 0, 1, 2], 0) -> [100, 7]
fn comma3_decode(digits, pos) -> list
    let dlen = len(digits)
    let result = []
    let cur = pos
    // m accumulates: start with implicit leading 1
    let m = 1
    let found = 0
    while cur < dlen and found == 0
        let d = digits[cur]
        if d == 2
            // consumed the comma; next_pos = cur + 1
            found = 1
        else
            // payload bit: shift m left and OR in bit
            m = m * 2 + d
        cur += 1
    if found == 0
        // reached end without finding a comma
        push(result, -1)
        push(result, dlen)
        return result
    push(result, m - 1)
    push(result, cur)
    result

// comma3_encode_seq: encode a list of non-negative integers into a concatenated
// digit list where each code is terminated by its 2-digit comma.
//
// The output can be decoded by comma3_decode_seq.
//
// Example:
//   comma3_encode_seq([3, 1, 4]) ->
//     [0,0,2] ++ [0,2] ++ [0,1,2]
//     = [0,0,2,0,2,0,1,2]
fn comma3_encode_seq(nums) -> list
    let out = []
    let i = 0
    let n = len(nums)
    while i < n
        let code = comma3_encode(nums[i])
        let j = 0
        let clen = len(code)
        while j < clen
            push(out, code[j])
            j += 1
        i += 1
    out

// comma3_decode_seq: decode all comma-codes from a concatenated digit list.
//
// Reads codes sequentially from the start of digits until pos >= len(digits).
// Each code is delimited by a 2, which is consumed but not included in output.
// Returns a list of decoded non-negative integer values.
// Stops early on malformed input (no 2 before end of stream).
//
// Example:
//   comma3_decode_seq([0,0,2,0,2,0,1,2]) -> [3, 1, 4]
fn comma3_decode_seq(digits) -> list
    let out = []
    let dlen = len(digits)
    let pos = 0
    while pos < dlen
        let res = comma3_decode(digits, pos)
        if res[0] == -1
            // malformed: stop decoding
            pos = dlen
        else
            push(out, res[0])
            pos = res[1]
    out
