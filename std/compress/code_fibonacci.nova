// ============================================================================
// NOVA Standard Library — std/compress/code_fibonacci
// ============================================================================
// Fibonacci coding (Zeckendorf representation) for positive integers n >= 1.
//
// THEORY:
//   Every positive integer has a unique representation as a sum of
//   non-consecutive Fibonacci numbers (Zeckendorf's theorem, 1972).
//   Fibonacci coding exploits this to produce a self-delimiting integer code.
//
// FIBONACCI SEQUENCE USED (no duplicate 1):
//   F[0]=1, F[1]=2, F[2]=3, F[3]=5, F[4]=8, F[5]=13, F[6]=21, ...
//   F[k] = F[k-1] + F[k-2], F[0]=1, F[1]=2.
//
// ENCODING (n >= 1):
//   1. Find Zeckendorf decomposition: which Fibonacci numbers sum to n,
//      with no two consecutive Fibonacci numbers used.
//   2. Emit one bit per Fibonacci position from smallest (F[0]=1) upward:
//      1 if that Fib is in the decomposition, 0 otherwise.
//      Only emit up to the highest Fib used.
//   3. Append a terminating 1 bit — the code always ends with "11"
//      (the last bit of the payload is 1 since the highest Fib is always
//      included, and the terminator follows immediately).
//
// DECODING (bits, pos):
//   1. From pos, scan for the "11" terminator (two consecutive 1-bits).
//      The first "1" of "11" is the last payload bit; the second is the
//      terminator.
//   2. Accumulate: for each bit at offset i from pos, if bit==1 add F[i].
//   3. The terminator bit is NOT added (it is consumed but ignored).
//   4. Return [value, next_pos] where next_pos is immediately after "11".
//
// EXAMPLES:
//   n=1:  Zeckendorf=1=F[0].            Payload=[1]. Code=[1,1].
//   n=2:  Zeckendorf=2=F[1].            Payload=[0,1]. Code=[0,1,1].
//   n=3:  Zeckendorf=3=F[2].            Payload=[0,0,1]. Code=[0,0,1,1].
//   n=4:  Zeckendorf=4=3+1=F[2]+F[0].   Payload=[1,0,1]. Code=[1,0,1,1].
//   n=5:  Zeckendorf=5=F[3].            Payload=[0,0,0,1]. Code=[0,0,0,1,1].
//   n=6:  Zeckendorf=6=5+1=F[3]+F[0].   Payload=[1,0,0,1]. Code=[1,0,0,1,1].
//   n=7:  Zeckendorf=7=5+2=F[3]+F[1].   Payload=[0,1,0,1]. Code=[0,1,0,1,1].
//   n=8:  Zeckendorf=8=F[4].            Payload=[0,0,0,0,1]. Code=[0,0,0,0,1,1].
//   n=10: Zeckendorf=10=8+2=F[4]+F[1].  Payload=[0,1,0,0,1]. Code=[0,1,0,0,1,1].
//   n=12: Zeckendorf=12=8+3+1=F[4]+F[2]+F[0]. Payload=[1,0,1,0,1]. Code=[1,0,1,0,1,1].
//
// SELF-DELIMITATION:
//   The "11" terminator means codes can be concatenated in a bit-list and
//   decoded sequentially without any length prefix. The "11" never appears
//   within the payload because Zeckendorf uses no two consecutive Fibonacci
//   numbers (so two adjacent 1-bits in the payload can't occur).
//
// BIT LENGTH:
//   fib_encode(n) uses floor(log_phi(n*sqrt(5))) + 2 bits, approximately
//   1.44*log2(n) + 2. Shorter than Elias gamma for small n, longer for
//   very large n — optimal for near-geometric distributions (zipfian data).
//
// PUBLIC API:
//   fib_encode(n) -> list
//     Returns a list of 0/1 ints (MSB is the terminator). n must be >= 1.
//     Returns [] for n < 1 (invalid input guard).
//
//   fib_decode(bits, pos) -> list
//     Decode one Fibonacci-coded value from bits (list of 0/1 ints)
//     starting at index pos.
//     Returns [value, next_pos]. Returns [-1, len(bits)] on malformed input.
//
// SYMBOL COLLISION GUARD:
//   All private helpers use prefix _fib_ to avoid link collisions.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// _fib_build_table: build Fibonacci table up to cover value n.
// Returns list of Fibonacci numbers F[0]=1, F[1]=2, F[2]=3, ...
// up to and including the largest Fibonacci <= n.
// Minimum 2 entries are always returned (handles n=1 correctly).
fn _fib_build_table(n) -> list
    let tbl = []
    push(tbl, 1)
    push(tbl, 2)
    let a = 1
    let b = 2
    let done = 0
    while done == 0
        let c = a + b
        if c <= n
            push(tbl, c)
            a = b
            b = c
        else
            done = 1
    tbl

// _fib_zeckendorf: compute Zeckendorf decomposition of n (>= 1).
// Returns a list of bit positions (0-indexed) where the Fibonacci
// number is included. Greedy algorithm: always take the largest
// Fibonacci number that fits.
// We return the bit ARRAY itself (one entry per Fib slot, 0 or 1).
fn _fib_zeckendorf(n) -> list
    let tbl = _fib_build_table(n)
    let tsz = len(tbl)
    // Work from largest Fib down (greedy = unique Zeckendorf).
    let bits = [0 for i in 0..tsz]
    let rem = n
    let j = tsz - 1
    while j >= 0
        let fv = tbl[j]
        if fv <= rem
            bits[j] = 1
            rem -= fv
        j -= 1
    bits

// ── Public API ────────────────────────────────────────────────────────────────

// fib_encode: encode positive integer n >= 1 as a Fibonacci code.
//
// Returns a list of 0/1 ints. The list ends with [.., 1, 1] (the last
// payload bit is always 1 since the highest Fibonacci is always included,
// and the terminating 1 follows immediately).
//
// Algorithm:
//   1. Compute Zeckendorf bits (0-indexed from smallest Fib).
//   2. Find the highest set bit (index of largest Fib used).
//   3. Emit bits [0..highest_set] in order (from lowest Fib to highest).
//   4. Append a 1 (terminator). Trailing zeros between lowest and highest
//      ARE emitted (they are meaningful payload positions).
//   By Zeckendorf, the highest bit is always 1, so code ends with [1, 1].
//
// Examples:
//   fib_encode(1) -> [1, 1]            (Zeckendorf bits=[1], highest=0)
//   fib_encode(2) -> [0, 1, 1]         (Zeckendorf bits=[0,1], highest=1)
//   fib_encode(4) -> [1, 0, 1, 1]      (Zeckendorf bits=[1,0,1], highest=2)
//   fib_encode(6) -> [1, 0, 0, 1, 1]   (Zeckendorf bits=[1,0,0,1], highest=3)
fn fib_encode(n) -> list
    if n < 1
        let empty = []
        return empty
    let zb = _fib_zeckendorf(n)
    let zsz = len(zb)
    // Find highest set bit index
    let highest = 0
    let hi = zsz - 1
    let found_hi = 0
    while hi >= 0 and found_hi == 0
        if zb[hi] == 1
            highest = hi
            found_hi = 1
        hi -= 1
    // Emit bits from index 0 to highest (inclusive)
    let out = []
    let i = 0
    while i <= highest
        push(out, zb[i])
        i += 1
    // Terminating 1
    push(out, 1)
    out

// fib_decode: decode one Fibonacci-coded value from bit-list bits at pos.
//
// Scans for the "11" terminator (two consecutive 1-bits). The bit at
// position (pos + i) contributes F[i] to the sum when it is 1, for all
// i from 0 up to (but not including) the terminator position.
//
// Returns [value, next_pos] where next_pos is the index immediately after
// the terminator (ready for the next code in a concatenated stream).
// Returns [-1, len(bits)] on malformed/truncated input.
//
// Example:
//   bits = [1, 1]          -> value=1, next_pos=2
//   bits = [0, 1, 1]       -> value=2, next_pos=3
//   bits = [1, 0, 0, 1, 1] -> value=6, next_pos=5
fn fib_decode(bits, pos) -> list
    let blen = len(bits)
    let result = []
    // Need at least 2 bits for the shortest code [1,1]
    if pos + 1 >= blen
        push(result, -1)
        push(result, blen)
        return result
    // Build Fibonacci table large enough. We don't know how large n will be,
    // but we can build up to 64 entries (covers all 64-bit integers).
    // We build incrementally as we scan.
    let tbl = []
    push(tbl, 1)
    push(tbl, 2)
    let fa = 1
    let fb = 2
    for i in 0..62
        let fc = fa + fb
        push(tbl, fc)
        fa = fb
        fb = fc
    // Now scan bits from pos looking for "11"
    let value = 0
    let cur = pos
    let prev = 0
    let found = 0
    let fib_idx = 0
    let next_pos = blen
    let scan_done = 0
    while scan_done == 0
        if cur >= blen
            // Ran out of bits without finding "11" terminator
            push(result, -1)
            push(result, blen)
            return result
        let bit = bits[cur]
        if prev == 1 and bit == 1
            // Found "11" — prev was the last payload bit (already counted),
            // this bit is the terminator (not counted).
            next_pos = cur + 1
            found = 1
            scan_done = 1
        else
            // This bit is a payload bit — accumulate Fibonacci value
            if bit == 1
                if fib_idx < len(tbl)
                    value += tbl[fib_idx]
            fib_idx += 1
            prev = bit
            cur += 1
    if found == 1
        push(result, value)
        push(result, next_pos)
    else
        push(result, -1)
        push(result, blen)
    result
