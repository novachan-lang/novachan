// std/vector/vec_arith.nova — Element-wise integer vector arithmetic.
// A vector is a list of integers [x0, x1, ...].
// All operations are EXACT — no floats, no rounding.
// LEAF — imports NOTHING.
//
// Public API (prefix va_):
//   va_add(a, b)    -> list   element-wise a[i] + b[i]; length = min(len(a),len(b))
//   va_sub(a, b)    -> list   element-wise a[i] - b[i]; length = min(len(a),len(b))
//   va_scale(a, s)  -> list   multiply every element by scalar s
//   va_negate(a)    -> list   negate every element (equivalent to va_scale(a,-1))
//   va_zeros(n)     -> list   length-n vector of zeroes

// va_add — element-wise sum of two integer vectors; result length = min(len(a), len(b)).
fn va_add(a, b)
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n
        n = nb
    let result = []
    for i in 0..n
        push(result, a[i] + b[i])
    result

// va_sub — element-wise difference a[i]-b[i]; result length = min(len(a), len(b)).
fn va_sub(a, b)
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n
        n = nb
    let result = []
    for i in 0..n
        push(result, a[i] - b[i])
    result

// va_scale — multiply every element of a by integer scalar s.
fn va_scale(a, s)
    let n = len(a)
    let result = []
    for i in 0..n
        push(result, a[i] * s)
    result

// va_negate — negate every element of a (unary minus on each component).
fn va_negate(a)
    let n = len(a)
    let result = []
    for i in 0..n
        push(result, 0 - a[i])
    result

// va_zeros — return a fresh length-n zero vector [0, 0, ..., 0].
fn va_zeros(n)
    let result = [0 for i in 0..n]
    result
