// std/vector/vec_projection.nova — exact integer/rational projection relations on N-d int vectors.
// A vector is a list of integers. LEAF — imports NOTHING.
// Rationals are represented as [num, den] with den > 0, reduced by gcd.

// _gcd: non-negative gcd via Euclidean algorithm
fn _vp_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    if x < 0
        x = 0 - x
    if y < 0
        y = 0 - y
    while y != 0
        let t = y
        y = x - (x / y) * y
        x = t
    x

// _reduce: reduce rational [num, den] to lowest terms with den > 0
fn _vp_reduce(num: int, den: int) -> list
    if den == 0
        let r = [0, 0]
        return r
    let n = num
    let d = den
    if d < 0
        n = 0 - n
        d = 0 - d
    let g = _vp_gcd(n, d)
    if g == 0
        g = 1
    let r = [n / g, d / g]
    r

// _dot: dot product of two integer vectors
fn _vp_dot(a: list, b: list) -> int
    let n = len(a)
    let m = len(b)
    if m < n
        n = m
    let s = 0
    for i in 0..n
        s += a[i] * b[i]
    s

// _normsq: squared magnitude of an integer vector
fn _vp_normsq(a: list) -> int
    let s = 0
    for i in 0..len(a)
        s += a[i] * a[i]
    s

// vp_coeff: projection coefficient of a onto b = (a.b) / |b|^2, as reduced rational [num, den].
// Returns [0,0] sentinel if b is the zero vector (|b|^2 == 0).
fn vp_coeff(a: list, b: list) -> list
    let d = _vp_dot(a, b)
    let n2 = _vp_normsq(b)
    _vp_reduce(d, n2)

// vp_is_orthogonal: true if a and b are orthogonal (dot product == 0).
fn vp_is_orthogonal(a: list, b: list) -> bool
    _vp_dot(a, b) == 0

// vp_is_parallel: true if a and b are parallel ((a.b)^2 == |a|^2 * |b|^2).
// This is the Cauchy-Schwarz equality condition, exact over integers.
// Returns false if either vector is zero (zero vector is not considered parallel).
fn vp_is_parallel(a: list, b: list) -> bool
    let na2 = _vp_normsq(a)
    let nb2 = _vp_normsq(b)
    if na2 == 0
        return false
    if nb2 == 0
        return false
    let dot = _vp_dot(a, b)
    dot * dot == na2 * nb2
