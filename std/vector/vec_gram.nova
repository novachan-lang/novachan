// std/vector/vec_gram.nova — Gram matrix and Gram determinant (exact integer arithmetic).
// Vectors are lists of integers [x0, x1, ...].
// The Gram matrix G[i][j] = v_i · v_j is always symmetric and positive-semidefinite.
// The Gram determinant = det(G) = squared volume of the parallelepiped spanned by the vectors.
// All arithmetic is EXACT integer — no floats, no sqrt, no approximations.
// LEAF — imports NOTHING.
//
// Public API (prefix vg_):
//   vg_matrix(vectors)      -> list   NxN Gram matrix G where G[i][j] = vectors[i] . vectors[j]
//   vg_determinant(vectors) -> int    Gram determinant = det(G); exact non-negative integer
//   vg_volume_sq(vectors)   -> int    alias for vg_determinant (squared volume of parallelepiped)

// _vg_dot — dot product of two integer vectors; exact integer result.
fn _vg_dot(a, b)
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n
        n = nb
    let s = 0
    for i in 0..n
        s += a[i] * b[i]
    s

// _vg_gcd — Euclidean GCD of two integers; result is non-negative.
fn _vg_gcd(a, b)
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    a

// _vg_mat_det — exact integer determinant of an NxN matrix via Bareiss algorithm.
// Uses fraction-free Gaussian elimination: at step k,
//   M[i][j] = (M[k][k]*M[i][j] - M[i][k]*M[k][j]) / pivot_prev
// where pivot_prev is M[k-1][k-1] from the previous step (1 for k=0).
// Result is exact because Bareiss guarantees exact integer division at each step.
fn _vg_mat_det(m)
    let n = len(m)
    if n == 0
        return 1
    if n == 1
        return m[0][0]
    // copy m into a mutable list of rows (rebuild pattern)
    let mat = [[m[ci][cj] for cj in 0..n] for ci in 0..n]
    // track sign for row swaps
    let sign = 1
    let prev = 1
    for k in 0..(n - 1)
        // find a non-zero pivot in column k at or below row k
        let pivot_row = -1
        for sr in k..n
            if mat[sr][k] != 0
                pivot_row = sr
                break
        if pivot_row == -1
            // singular matrix: determinant is 0
            return 0
        // swap rows k and pivot_row if needed
        if pivot_row != k
            let tmp = mat[k]
            mat = [(mat[pivot_row] if si == k else (tmp if si == pivot_row else mat[si])) for si in 0..n]
            sign = 0 - sign
        // Bareiss elimination for rows below k
        let pkk = mat[k][k]
        let new_mat2 = []
        for i in 0..n
            if i <= k
                push(new_mat2, mat[i])
            else
                let old_row = mat[i]
                let pik = old_row[k]
                let new_row = []
                for j in 0..n
                    if j <= k
                        push(new_row, 0)
                    else
                        let val = pkk * old_row[j] - pik * mat[k][j]
                        let dv = val / prev
                        push(new_row, dv)
                push(new_mat2, new_row)
        mat = new_mat2
        prev = pkk
    let raw = sign * mat[n - 1][n - 1]
    raw

// vg_matrix — build the NxN Gram matrix G where G[i][j] = vectors[i] . vectors[j].
// Returns a list of N rows, each a list of N integers.
fn vg_matrix(vectors)
    let n = len(vectors)
    [[_vg_dot(vectors[i], vectors[j]) for j in 0..n] for i in 0..n]

// vg_determinant — exact integer Gram determinant (squared parallelepiped volume).
// Returns 0 for empty or linearly dependent sets of vectors.
fn vg_determinant(vectors)
    let n = len(vectors)
    if n == 0
        return 1
    let g = vg_matrix(vectors)
    let d = _vg_mat_det(g)
    d

// vg_volume_sq — alias for vg_determinant; squared volume of the parallelepiped.
fn vg_volume_sq(vectors)
    vg_determinant(vectors)
