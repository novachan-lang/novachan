// std/vector/vec_compare.nova — Lexicographic and componentwise integer vector comparisons.
// Vectors are lists of integers [x0, x1, ...]. ALL results are exact integers or booleans.
// Mismatched-length vectors: lex compares up to min(len(a),len(b)) then by length.
// LEAF — imports NOTHING.
//
// Public API (prefix vcmp_):
//   vcmp_lex(a, b)        -> int    lexicographic comparison: -1 if a<b, 0 if a==b, 1 if a>b
//   vcmp_dominates(a, b)  -> bool   true iff a[i] >= b[i] for ALL i in 0..min(len(a),len(b))-1
//   vcmp_min(a, b)        -> list   componentwise minimum: result[i] = min(a[i], b[i])
//   vcmp_max(a, b)        -> list   componentwise maximum: result[i] = max(a[i], b[i])

// vcmp_lex — lexicographic comparison of integer vectors.
// Returns -1 if a < b lexicographically, 0 if equal, 1 if a > b.
// Shorter vector is less if it is a prefix of the longer one.
fn vcmp_lex(a, b)
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n
        n = nb
    for i in 0..n
        let ai = a[i]
        let bi = b[i]
        if ai < bi
            return -1
        if ai > bi
            return 1
    if na < nb
        return -1
    if na > nb
        return 1
    0

// vcmp_dominates — true iff a[i] >= b[i] for every index in the common prefix.
// For empty vectors or zero-length common prefix, returns true (vacuously true).
fn vcmp_dominates(a, b)
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n
        n = nb
    for i in 0..n
        if a[i] < b[i]
            return false
    true

// vcmp_min — componentwise minimum over the common prefix of a and b.
// Result has length min(len(a), len(b)).
fn vcmp_min(a, b)
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n
        n = nb
    [(a[i] if a[i] < b[i] else b[i]) for i in 0..n]

// vcmp_max — componentwise maximum over the common prefix of a and b.
// Result has length min(len(a), len(b)).
fn vcmp_max(a, b)
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n
        n = nb
    [(a[i] if a[i] > b[i] else b[i]) for i in 0..n]
