// std/vector/vec_combination.nova — Integer vector linear combinations (exact arithmetic).
//
// Vectors are lists of integers [x0, x1, ...] of the same length.
// All arithmetic is EXACT INTEGER — no floats.
// Empty vector lists or mismatched lengths are handled safely.
// LEAF — imports NOTHING.
//
// Public API (prefix vco_):
//   vco_linear(vectors, coeffs) -> list   sum of coeffs[i] * vectors[i]
//   vco_add_scaled(a, b, s)     -> list   a + s*b component-wise
//   vco_barycentric(vectors, weights) -> list   weighted sum (same as vco_linear)

// vco_linear: compute the linear combination sum(coeffs[i] * vectors[i]) exactly.
// Returns the zero vector of the shared dimension if vectors is empty.
// If vectors is non-empty the dimension is taken from vectors[0].
fn vco_linear(vectors: list, coeffs: list) -> list
    let nv = len(vectors)
    if nv == 0
        let empty = []
        return empty
    let dim = len(vectors[0])
    let result = []
    let d = 0
    while d < dim
        push(result, 0)
        d = d + 1
    let i = 0
    while i < nv
        let c = coeffs[i]
        let v = vectors[i]
        let j = 0
        while j < dim
            result[j] = result[j] + c * v[j]
            j = j + 1
        i = i + 1
    result

// vco_add_scaled: return the list a + s*b component-wise (exact integer).
// Lengths of a and b must match; result has the same length.
fn vco_add_scaled(a: list, b: list, s: int) -> list
    let n = len(a)
    let result = []
    let i = 0
    while i < n
        push(result, a[i] + s * b[i])
        i = i + 1
    result

// vco_barycentric: weighted sum of vectors with given weights (identical to vco_linear).
// weights need not sum to 1; the result is the exact integer weighted sum.
fn vco_barycentric(vectors: list, weights: list) -> list
    vco_linear(vectors, weights)
