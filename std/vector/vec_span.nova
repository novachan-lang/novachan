// std/vector/vec_span.nova — Rank and span of a set of integer vectors (exact arithmetic).
//
// Vectors are lists of integers.  A "set of vectors" is a list of such lists.
// All computation is EXACT INTEGER — no floats, no tolerance.
// Uses exact integer Gaussian elimination (no divisions; multiplies to clear pivots).
// LEAF — imports NOTHING.
//
// Public API (prefix vs_):
//   vs_rank(vectors)            -> int    rank over the rationals via exact integer elim
//   vs_are_dependent(vectors)   -> bool   true when rank < number of vectors
//   vs_is_basis(vectors, dim)   -> bool   exactly dim vectors, each of length dim, rank==dim

// _vs_copy_row: copy a single integer row list into a fresh list.
fn _vs_copy_row(row: list) -> list
    let n = len(row)
    let out = []
    let i = 0
    while i < n
        push(out, row[i])
        i = i + 1
    out

// _vs_swap_rows: swap rows r1 and r2 in the 2D list m (in place).
fn _vs_swap_rows(m: list, r1: int, r2: int)
    let tmp = m[r1]
    m[r1] = m[r2]
    m[r2] = tmp

// _vs_elim_row: eliminate row target using pivot row pr for column col.
// Computes: m[target] = m[pr][col] * m[target] - m[target][col] * m[pr]
// This is an exact integer operation that zeroes m[target][col].
fn _vs_elim_row(m: list, pr: int, target: int, col: int)
    let pv = m[pr][col]
    let tc = m[target][col]
    let nc = len(m[pr])
    let j = 0
    while j < nc
        m[target][j] = pv * m[target][j] - tc * m[pr][j]
        j = j + 1

// vs_rank: compute the rank of the set of integer vectors over the rationals.
// Uses exact integer Gaussian elimination with column-by-column pivoting.
// Returns 0 for an empty set or if all vectors are zero.
fn vs_rank(vectors: list) -> int
    let nv = len(vectors)
    if nv == 0
        return 0
    let dim = len(vectors[0])
    if dim == 0
        return 0
    // Deep-copy all rows so we do not mutate the caller's data.
    let m = []
    let i = 0
    while i < nv
        push(m, _vs_copy_row(vectors[i]))
        i = i + 1
    // Exact integer Gaussian elimination.
    let pivot_row = 0
    let col = 0
    while col < dim
        if pivot_row >= nv
            col = dim
        else
            // Find a row at or below pivot_row with a non-zero entry in column col.
            let found = false
            let r = pivot_row
            while r < nv
                if not found
                    if m[r][col] != 0
                        found = true
                        if r != pivot_row
                            _vs_swap_rows(m, pivot_row, r)
                r = r + 1
            if found
                // Eliminate all rows below pivot_row in this column.
                let i2 = pivot_row + 1
                while i2 < nv
                    if m[i2][col] != 0
                        _vs_elim_row(m, pivot_row, i2, col)
                    i2 = i2 + 1
                pivot_row = pivot_row + 1
            col = col + 1
    pivot_row

// vs_are_dependent: true when the vectors are linearly dependent (rank < number of vectors).
// Empty set is considered independent (rank 0 == 0 vectors).
fn vs_are_dependent(vectors: list) -> bool
    let nv = len(vectors)
    if nv == 0
        return false
    let rk = vs_rank(vectors)
    rk < nv

// vs_is_basis: true when vectors form a basis for dim-dimensional space:
//   - exactly dim vectors are provided
//   - every vector has length dim
//   - the rank equals dim
fn vs_is_basis(vectors: list, dim: int) -> bool
    let nv = len(vectors)
    if nv != dim
        return false
    if nv == 0
        return dim == 0
    // Check that every vector has the correct dimension.
    let i = 0
    while i < nv
        if len(vectors[i]) != dim
            return false
        i = i + 1
    let rk = vs_rank(vectors)
    rk == dim
