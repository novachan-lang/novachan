// std/vector/vec_cross3.nova — Exact 3D integer cross product and derived operations.
// Vectors must be length-3 integer lists [x, y, z].
// All results are EXACT integers — no floats, no sqrt.
// LEAF — imports NOTHING.
//
// Public API (prefix vc_):
//   vc_cross(a, b)         -> list   3D cross product a x b = [ay*bz-az*by, az*bx-ax*bz, ax*by-ay*bx]
//   vc_triple(a, b, c)     -> int    scalar triple product a . (b x c)
//   vc_are_parallel(a, b)  -> bool   true iff a x b == [0,0,0]
//   vc_area_sq_4x(a, b)    -> int    |a x b|^2 = 4 * (triangle area)^2 for edges a and b

// vc_cross — 3D cross product of integer vectors a and b.
// Result: [a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]].
fn vc_cross(a, b)
    let cx = a[1] * b[2] - a[2] * b[1]
    let cy = a[2] * b[0] - a[0] * b[2]
    let cz = a[0] * b[1] - a[1] * b[0]
    [cx, cy, cz]

// vc_triple — scalar triple product a . (b x c); equals the determinant of [a|b|c].
// Positive = a,b,c form a right-handed frame; zero = coplanar.
fn vc_triple(a, b, c)
    let bxc = vc_cross(b, c)
    a[0] * bxc[0] + a[1] * bxc[1] + a[2] * bxc[2]

// vc_are_parallel — true iff a x b is the zero vector (a and b are parallel or one is zero).
fn vc_are_parallel(a, b)
    let cx = a[1] * b[2] - a[2] * b[1]
    let cy = a[2] * b[0] - a[0] * b[2]
    let cz = a[0] * b[1] - a[1] * b[0]
    if cx != 0
        return false
    if cy != 0
        return false
    if cz != 0
        return false
    true

// vc_area_sq_4x — |a x b|^2, which equals 4*(triangle_area)^2 for a triangle with edges a, b.
// Exact integer; no sqrt needed.
fn vc_area_sq_4x(a, b)
    let cx = a[1] * b[2] - a[2] * b[1]
    let cy = a[2] * b[0] - a[0] * b[2]
    let cz = a[0] * b[1] - a[1] * b[0]
    cx * cx + cy * cy + cz * cz
