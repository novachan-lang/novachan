// ============================================================================
// NOVA Standard Library — std/music/rhythm
// ============================================================================
// Note durations in ticks (PPQ = ticks per quarter note).
//
// TICK CONVENTION:
//   PPQ (Pulses Per Quarter note) = 480 by default (standard MIDI).
//   whole       = 4 * PPQ
//   half        = 2 * PPQ
//   quarter     = PPQ
//   eighth      = PPQ / 2
//   sixteenth   = PPQ / 4
//   thirty-second = PPQ / 8
//
// Augmentation dots add fractions of the base duration:
//   dotted        = ticks * 3 / 2   (adds half again)
//   double_dotted = ticks * 7 / 4   (adds three-quarters again)
//
// Tuplets: an n-tuplet fits n notes in the space of 2 normal beats.
//   tuplet(ticks, n) = ticks * 2 / n
//   E.g. triplet quarter (n=3): 480*2/3 = 320 ticks
//
// PUBLIC API
//   duration_ticks(name, ppq) -> int   ticks for named note value at given PPQ
//   dotted(ticks)             -> int   ticks * 3 / 2
//   double_dotted(ticks)      -> int   ticks * 7 / 4
//   tuplet(ticks, n)          -> int   ticks * 2 / n  (n-tuplet in space of 2)
//   note_value_name(ticks, ppq) -> string  reverse-lookup name for tick count
//   beats_in_bar(num, den, ppq) -> int     total ticks in a bar of num/den time
// ============================================================================

// ── public API ───────────────────────────────────────────────────────────────

// duration_ticks(name, ppq) -> int
//   Return the duration in ticks for the named note value at the given PPQ.
//   Recognised names: "whole", "half", "quarter", "eighth",
//                     "sixteenth", "thirty_second".
//   Returns 0 for unrecognised names.
fn duration_ticks(name, ppq)
    let result = 0
    if name == "whole"
        result = ppq * 4
    else if name == "half"
        result = ppq * 2
    else if name == "quarter"
        result = ppq
    else if name == "eighth"
        result = ppq / 2
    else if name == "sixteenth"
        result = ppq / 4
    else if name == "thirty_second"
        result = ppq / 8
    result

// dotted(ticks) -> int
//   Return the dotted duration: ticks * 3 / 2.
//   A dotted note lasts 1.5 times its base duration.
fn dotted(ticks)
    ticks * 3 / 2

// double_dotted(ticks) -> int
//   Return the double-dotted duration: ticks * 7 / 4.
//   A double-dotted note lasts 1.75 times its base duration.
fn double_dotted(ticks)
    ticks * 7 / 4

// tuplet(ticks, n) -> int
//   Return the duration of one note in an n-tuplet occupying 2 base durations.
//   Formula: ticks * 2 / n.
//   E.g. triplet quarter (n=3, ticks=480): 480*2/3 = 320 ticks.
//   Returns 0 if n is zero (guard against division by zero).
fn tuplet(ticks, n)
    let result = 0
    if n > 0
        result = ticks * 2 / n
    result

// note_value_name(ticks, ppq) -> string
//   Reverse-lookup: return the note value name for an exact tick count.
//   Checks whole, half, quarter, eighth, sixteenth, thirty_second.
//   Returns "?" for unrecognised tick counts.
fn note_value_name(ticks, ppq)
    let name = "?"
    if ticks == ppq * 4
        name = "whole"
    else if ticks == ppq * 2
        name = "half"
    else if ticks == ppq
        name = "quarter"
    else if ticks == ppq / 2
        name = "eighth"
    else if ticks == ppq / 4
        name = "sixteenth"
    else if ticks == ppq / 8
        name = "thirty_second"
    name

// beats_in_bar(num, den, ppq) -> int
//   Return the total number of ticks in one bar of num/den time at the given PPQ.
//   The denominator den is a power of 2 (1=whole, 2=half, 4=quarter, 8=eighth,
//   16=sixteenth, 32=thirty-second).
//   Formula: num * duration_ticks(den_name, ppq).
//   Returns 0 for unrecognised denominators.
fn beats_in_bar(num, den, ppq)
    let den_name = "?"
    if den == 1
        den_name = "whole"
    else if den == 2
        den_name = "half"
    else if den == 4
        den_name = "quarter"
    else if den == 8
        den_name = "eighth"
    else if den == 16
        den_name = "sixteenth"
    else if den == 32
        den_name = "thirty_second"
    let beat_ticks = duration_ticks(den_name, ppq)
    num * beat_ticks
