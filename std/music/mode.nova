// ============================================================================
// NOVA Standard Library — std/music/mode
// ============================================================================
// The seven diatonic modes: rotations of the C major scale (Ionian).
//
// INTERVAL PATTERNS (semitones from root, 7 notes):
//   Ionian     (mode 1): [0,2,4,5,7,9,11]  — major scale
//   Dorian     (mode 2): [0,2,3,5,7,9,10]
//   Phrygian   (mode 3): [0,1,3,5,7,8,10]
//   Lydian     (mode 4): [0,2,4,6,7,9,11]
//   Mixolydian (mode 5): [0,2,4,5,7,9,10]
//   Aeolian    (mode 6): [0,2,3,5,7,8,10]  — natural minor scale
//   Locrian    (mode 7): [0,1,3,5,6,8,10]
//
// MIDI convention: C4=60, A4=69. Pitch class = note % 12.
//
// PUBLIC API
//   mode_pattern(name)             -> list  7-element interval list (semitones from root)
//   mode_notes(root, name)         -> list  8 MIDI note numbers (root note + 7 scale tones)
//   mode_name(degree)              -> str   1->ionian ... 7->locrian
//   mode_of_major(major_root, deg) -> list  mode starting on scale degree deg of major_root
// ============================================================================

// ── private: return one interval from a named mode by position ───────────────

// _mode_ionian_interval(i) -> int
//   Returns the i-th interval (0..6) of the Ionian mode: [0,2,4,5,7,9,11].
fn _mode_ionian_interval(i)
    let v = 0
    if i == 0
        v = 0
    else if i == 1
        v = 2
    else if i == 2
        v = 4
    else if i == 3
        v = 5
    else if i == 4
        v = 7
    else if i == 5
        v = 9
    else
        v = 11
    v

// _mode_dorian_interval(i) -> int
//   Returns the i-th interval (0..6) of the Dorian mode: [0,2,3,5,7,9,10].
fn _mode_dorian_interval(i)
    let v = 0
    if i == 0
        v = 0
    else if i == 1
        v = 2
    else if i == 2
        v = 3
    else if i == 3
        v = 5
    else if i == 4
        v = 7
    else if i == 5
        v = 9
    else
        v = 10
    v

// _mode_phrygian_interval(i) -> int
//   Returns the i-th interval (0..6) of the Phrygian mode: [0,1,3,5,7,8,10].
fn _mode_phrygian_interval(i)
    let v = 0
    if i == 0
        v = 0
    else if i == 1
        v = 1
    else if i == 2
        v = 3
    else if i == 3
        v = 5
    else if i == 4
        v = 7
    else if i == 5
        v = 8
    else
        v = 10
    v

// _mode_lydian_interval(i) -> int
//   Returns the i-th interval (0..6) of the Lydian mode: [0,2,4,6,7,9,11].
fn _mode_lydian_interval(i)
    let v = 0
    if i == 0
        v = 0
    else if i == 1
        v = 2
    else if i == 2
        v = 4
    else if i == 3
        v = 6
    else if i == 4
        v = 7
    else if i == 5
        v = 9
    else
        v = 11
    v

// _mode_mixolydian_interval(i) -> int
//   Returns the i-th interval (0..6) of the Mixolydian mode: [0,2,4,5,7,9,10].
fn _mode_mixolydian_interval(i)
    let v = 0
    if i == 0
        v = 0
    else if i == 1
        v = 2
    else if i == 2
        v = 4
    else if i == 3
        v = 5
    else if i == 4
        v = 7
    else if i == 5
        v = 9
    else
        v = 10
    v

// _mode_aeolian_interval(i) -> int
//   Returns the i-th interval (0..6) of the Aeolian mode: [0,2,3,5,7,8,10].
fn _mode_aeolian_interval(i)
    let v = 0
    if i == 0
        v = 0
    else if i == 1
        v = 2
    else if i == 2
        v = 3
    else if i == 3
        v = 5
    else if i == 4
        v = 7
    else if i == 5
        v = 8
    else
        v = 10
    v

// _mode_locrian_interval(i) -> int
//   Returns the i-th interval (0..6) of the Locrian mode: [0,1,3,5,6,8,10].
fn _mode_locrian_interval(i)
    let v = 0
    if i == 0
        v = 0
    else if i == 1
        v = 1
    else if i == 2
        v = 3
    else if i == 3
        v = 5
    else if i == 4
        v = 6
    else if i == 5
        v = 8
    else
        v = 10
    v

// _mode_interval(name, i) -> int
//   Returns the i-th interval (0..6) for mode named 'name'.
//   Unknown names default to Ionian intervals.
fn _mode_interval(name, i)
    let v = 0
    if name == "ionian"
        v = _mode_ionian_interval(i)
    else if name == "dorian"
        v = _mode_dorian_interval(i)
    else if name == "phrygian"
        v = _mode_phrygian_interval(i)
    else if name == "lydian"
        v = _mode_lydian_interval(i)
    else if name == "mixolydian"
        v = _mode_mixolydian_interval(i)
    else if name == "aeolian"
        v = _mode_aeolian_interval(i)
    else if name == "locrian"
        v = _mode_locrian_interval(i)
    else
        v = _mode_ionian_interval(i)
    v

// ── public API ───────────────────────────────────────────────────────────────

// mode_pattern(name) -> list
//   Return the 7-element list of semitone intervals from the root for the
//   named mode (lowercase). E.g. mode_pattern("dorian") == [0,2,3,5,7,9,10].
//   Unknown names return Ionian pattern.
fn mode_pattern(name)
    let result = []
    let i = 0
    while i < 7
        push(result, _mode_interval(name, i))
        i += 1
    result

// mode_notes(root, name) -> list
//   Return a 7-element list of MIDI note numbers for the named mode starting
//   on MIDI note 'root'. Each element is root + mode_pattern[i].
//   E.g. mode_notes(62, "dorian") == [62,64,65,67,69,71,72].
fn mode_notes(root, name)
    let result = []
    for i in 0..7
        let interval = _mode_interval(name, i)
        push(result, root + interval)
    result

// mode_name(degree) -> str
//   Return the mode name for scale degree 1..7.
//   1=ionian, 2=dorian, 3=phrygian, 4=lydian, 5=mixolydian, 6=aeolian, 7=locrian.
//   Returns "unknown" for out-of-range degrees.
fn mode_name(degree)
    let name = "unknown"
    if degree == 1
        name = "ionian"
    else if degree == 2
        name = "dorian"
    else if degree == 3
        name = "phrygian"
    else if degree == 4
        name = "lydian"
    else if degree == 5
        name = "mixolydian"
    else if degree == 6
        name = "aeolian"
    else if degree == 7
        name = "locrian"
    name

// mode_of_major(major_root, degree) -> list
//   Return an 8-element list of MIDI note numbers for the mode starting on
//   scale degree 'degree' (1..7) of the major scale rooted at 'major_root'.
//
//   Algorithm:
//     1. Build the major scale from major_root (7 notes, Ionian pattern).
//     2. The new root = major_root + ionian_interval[degree-1].
//     3. The mode name for degree d is mode_name(d).
//     4. Return mode_notes(new_root, mode_name(degree)).
//
//   Example: mode_of_major(60, 2) -> D Dorian starting on note 62.
//     C major scale degrees: C=60, D=62, E=64, F=65, G=67, A=69, B=71.
//     Degree 2 = D = 62. D Dorian = mode_notes(62, "dorian").
fn mode_of_major(major_root, degree)
    // Clamp degree to 1..7 (treat out-of-range as degree 1).
    let deg = degree
    if deg < 1
        deg = 1
    else if deg > 7
        deg = 7
    // Interval of the requested degree within the Ionian (major) scale.
    let root_offset = _mode_ionian_interval(deg - 1)
    let new_root = major_root + root_offset
    let mname = mode_name(deg)
    mode_notes(new_root, mname)
