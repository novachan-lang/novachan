// std/game2d/circle_collide.nova
// Circle collision detection and utilities.
// Circles are represented as (cx, cy, r) float parameters.
// AABBs are [x, y, w, h] lists (top-left + size).
//
// All float arithmetic is bound to named lets to avoid the uninit-float-slot bug.
// abs(float) returns int — use if/else for float absolute value.
// sqrt() is the builtin.
//
// Private helpers use the _cch_ prefix.
// Public functions use the cc_ prefix.

// _cch_fabs — float absolute value.
fn _cch_fabs(x: float) -> float
    let r = x
    if x < 0.0
        r = 0.0 - x
    r

// _cch_fmin — float minimum.
fn _cch_fmin(a: float, b: float) -> float
    let r = a
    if b < a
        r = b
    r

// _cch_fmax — float maximum.
fn _cch_fmax(a: float, b: float) -> float
    let r = a
    if b > a
        r = b
    r

// cc_dist — Euclidean distance between two points.
// All sub-expressions bound to named lets to avoid float-codegen bug.
fn cc_dist(x1, y1, x2, y2) -> float
    let x1f = x1 * 1.0
    let y1f = y1 * 1.0
    let x2f = x2 * 1.0
    let y2f = y2 * 1.0
    let dx = x2f - x1f
    let dy = y2f - y1f
    let dsq = dx * dx + dy * dy
    let d = sqrt(dsq)
    d

// cc_circles — true if two circles overlap (d^2 <= (r1+r2)^2).
// Touching (d == r1+r2) counts as collision.
fn cc_circles(cx1, cy1, r1, cx2, cy2, r2) -> bool
    let dx = (cx2 - cx1) * 1.0
    let dy = (cy2 - cy1) * 1.0
    let dsq = dx * dx + dy * dy
    let rsum = (r1 + r2) * 1.0
    let rsumsq = rsum * rsum
    let result = dsq <= rsumsq
    result

// cc_circle_point — true if point (px,py) lies inside or on the circle.
fn cc_circle_point(cx, cy, r, px, py) -> bool
    let dx = (px - cx) * 1.0
    let dy = (py - cy) * 1.0
    let dsq = dx * dx + dy * dy
    let rsq = r * 1.0
    let rsqq = rsq * rsq
    let result = dsq <= rsqq
    result

// cc_closest_on_aabb — closest point on AABB [x,y,w,h] to point (px,py).
// Clamps each coordinate to [box.min, box.max].
fn cc_closest_on_aabb(px, py, box: list) -> any
    let bx = box[0] * 1.0
    let by = box[1] * 1.0
    let bw = box[2] * 1.0
    let bh = box[3] * 1.0
    let pxf = px * 1.0
    let pyf = py * 1.0
    let cx = _cch_fmax(bx, _cch_fmin(pxf, bx + bw))
    let cy = _cch_fmax(by, _cch_fmin(pyf, by + bh))
    let result = []
    push(result, cx)
    push(result, cy)
    result

// cc_circle_aabb — true if circle (cx,cy,r) overlaps AABB box.
// Finds closest point on AABB to circle centre; checks distance <= r.
fn cc_circle_aabb(cx, cy, r, box: list) -> bool
    let closest = cc_closest_on_aabb(cx, cy, box)
    let closestx = closest[0]
    let closesty = closest[1]
    let cxf = cx * 1.0
    let cyf = cy * 1.0
    let dx = closestx - cxf
    let dy = closesty - cyf
    let dsq = dx * dx + dy * dy
    let rf = r * 1.0
    let rsq = rf * rf
    let result = dsq <= rsq
    result

// cc_penetration — depth of overlap between two circles (0 if not colliding).
// depth = r1 + r2 - distance(centres).  Returns 0.0 when circles don't overlap.
fn cc_penetration(cx1, cy1, r1, cx2, cy2, r2) -> float
    let dx = (cx2 - cx1) * 1.0
    let dy = (cy2 - cy1) * 1.0
    let dsq = dx * dx + dy * dy
    let d = sqrt(dsq)
    let rsum = (r1 + r2) * 1.0
    let depth = 0.0
    if d < rsum
        depth = rsum - d
    depth

// cc_normal — unit vector from circle 1 centre to circle 2 centre.
// Returns [0,0] when centres are coincident (degenerate; no defined normal).
fn cc_normal(cx1, cy1, cx2, cy2) -> any
    let dx = (cx2 - cx1) * 1.0
    let dy = (cy2 - cy1) * 1.0
    let dsq = dx * dx + dy * dy
    let result = []
    if dsq < 0.0000001
        push(result, 0.0)
        push(result, 0.0)
        return result
    let d = sqrt(dsq)
    let nx = dx / d
    let ny = dy / d
    push(result, nx)
    push(result, ny)
    result

// cc_contains — true if point (px,py) is strictly inside circle (same as cc_circle_point).
// Alias for clarity; on-boundary also returns true.
fn cc_contains(cx, cy, r, px, py) -> bool
    let result = cc_circle_point(cx, cy, r, px, py)
    result
