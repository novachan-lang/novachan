// std/game2d/motion2d.nova -- 2D kinematics integration for game physics.
// Semi-implicit Euler integration, projectile motion, friction, lerp helpers.
// All float sub-expressions bound to named lets (uninit-float-slot safety).
// LEAF -- imports nothing.
//
// Public API (prefix mo_):
//   mo_integrate(px,py, vx,vy, ax,ay, dt)    -> any    semi-implicit Euler step
//   mo_projectile(px,py, vx,vy, gravity, t)  -> any    position at time t under gravity
//   mo_apply_friction(vx,vy, friction, dt)   -> any    exponential velocity decay
//   mo_velocity_at(vx,vy, ax,ay, t)          -> any    velocity after time t
//   mo_stop_distance(v, decel)               -> float  distance to stop: v^2 / (2*decel)
//   mo_clamp_speed(vx,vy, max)               -> any    cap speed to max
//   mo_lerp(a, b, t)                         -> float  linear interpolate scalars
//   mo_lerp2(ax,ay, bx,by, t)               -> any    linear interpolate 2D points

// _mo_absf -- float absolute value.
fn _mo_absf(v: float) -> float
    if v < 0.0
        return -v
    v

// mo_integrate -- semi-implicit Euler integration step.
// Order: v += a*dt first, then p += v*dt (semi-implicit, more stable than explicit).
// Returns [px, py, vx, vy] — new position and velocity.
fn mo_integrate(px: float, py: float, vx: float, vy: float, ax: float, ay: float, dt: float) -> any
    let nvx = vx + ax * dt
    let nvy = vy + ay * dt
    let npx = px + nvx * dt
    let npy = py + nvy * dt
    let result = []
    push(result, npx)
    push(result, npy)
    push(result, nvx)
    push(result, nvy)
    result

// mo_projectile -- position of a projectile at time t under constant gravity.
// Formula: x = px + vx*t; y = py + vy*t + 0.5*gravity*t^2
// gravity is typically negative (e.g. -9.81 for downward gravity).
// Returns [x, y].
fn mo_projectile(px: float, py: float, vx: float, vy: float, gravity: float, t: float) -> any
    let rx = px + vx * t
    let t2 = t * t
    let half_g = 0.5 * gravity
    let gt2 = half_g * t2
    let ry = py + vy * t + gt2
    let result = []
    push(result, rx)
    push(result, ry)
    result

// mo_apply_friction -- reduce velocity by friction coefficient per second.
// Uses exponential decay: v' = v * (1 - friction*dt), clamped so speed never reverses.
// friction=0.0 = no friction; friction=1.0 = full stop in 1 second.
// Returns [vx, vy].
fn mo_apply_friction(vx: float, vy: float, friction: float, dt: float) -> any
    let factor = friction * dt
    let keep = 1.0 - factor
    let clamped_keep = keep
    if clamped_keep < 0.0
        clamped_keep = 0.0
    let nvx = vx * clamped_keep
    let nvy = vy * clamped_keep
    let result = []
    push(result, nvx)
    push(result, nvy)
    result

// mo_velocity_at -- velocity after integrating constant acceleration for time t.
// Returns [vx + ax*t, vy + ay*t].
fn mo_velocity_at(vx: float, vy: float, ax: float, ay: float, t: float) -> any
    let nvx = vx + ax * t
    let nvy = vy + ay * t
    let result = []
    push(result, nvx)
    push(result, nvy)
    result

// mo_stop_distance -- distance needed to stop given speed v and deceleration decel.
// Formula: d = v^2 / (2 * decel).  Decel must be positive.
fn mo_stop_distance(v: float, decel: float) -> float
    let v2 = v * v
    let denom = 2.0 * decel
    let d = v2 / denom
    d

// mo_clamp_speed -- cap velocity (vx,vy) to max speed.
// Returns scaled [vx, vy] if magnitude exceeds max; otherwise returns unchanged.
fn mo_clamp_speed(vx: float, vy: float, max: float) -> any
    let vx2 = vx * vx
    let vy2 = vy * vy
    let s = vx2 + vy2
    let speed = sqrt(s)
    let result = []
    if speed <= max
        push(result, vx)
        push(result, vy)
        return result
    let scale = max / speed
    let nx = vx * scale
    let ny = vy * scale
    push(result, nx)
    push(result, ny)
    result

// mo_lerp -- linear interpolation between scalars a and b at parameter t in [0,1].
// Returns a + (b-a)*t.
fn mo_lerp(a: float, b: float, t: float) -> float
    let diff = b - a
    let delta = diff * t
    let r = a + delta
    r

// mo_lerp2 -- linear interpolation between 2D points (ax,ay) and (bx,by) at t.
// Returns [ax + (bx-ax)*t, ay + (by-ay)*t].
fn mo_lerp2(ax: float, ay: float, bx: float, by: float, t: float) -> any
    let dx = bx - ax
    let dy = by - ay
    let rx = ax + dx * t
    let ry = ay + dy * t
    let result = []
    push(result, rx)
    push(result, ry)
    result
