// std/parsing/wildcard.nova
// SQL LIKE-style wildcard matching.
// Meta-characters: % (any run of chars, including empty), _ (exactly one char).
// Escape: by default backslash (\) escapes % and _ to treat them literally.
// Distinct from std/automata/wildcard which uses * and ? (glob style).
// PREFIX: like_
//
// Public API:
//   like(text, pattern)         -> bool (1=match, 0=no match)  backslash escape
//   ilike(text, pattern)        -> bool  case-insensitive, backslash escape
//   like_e(text, pattern, esc)  -> bool  explicit single-char escape string

// _like_lower(s) -> string
// Lowercase ASCII A-Z -> a-z.
fn _like_lower(s)
    let n = len(s)
    let out = ""
    let i = 0
    while i < n
        let ch = slice(s, i, i + 1)
        let o = ord(ch)
        if o >= 65 and o <= 90
            out = out + chr(o + 32)
        else
            out = out + ch
        i = i + 1
    return out

// _like_tokenize(pattern, esc) -> list of dicts
// Converts pattern string into token list. Each token dict has "k" key:
//   "pct" -> % wildcard (any run)
//   "und" -> _ wildcard (exactly one char)
//   "lit" -> literal char, "c" key holds the char
// Escape char followed by %, _, or esc itself becomes a literal.
fn _like_tokenize(pattern, esc)
    let n = len(pattern)
    let toks = []
    let i = 0
    while i < n
        let ch = slice(pattern, i, i + 1)
        if len(esc) > 0 and ch == esc
            // Escape sequence: next char is literal (if present)
            if i + 1 < n
                let nx = slice(pattern, i + 1, i + 2)
                let t = {}
                t["k"] = "lit"
                t["c"] = nx
                push(toks, t)
                i = i + 2
            else
                // Trailing escape — treat as literal escape char
                let t = {}
                t["k"] = "lit"
                t["c"] = ch
                push(toks, t)
                i = i + 1
        else
            if ch == "%"
                let t = {}
                t["k"] = "pct"
                push(toks, t)
                i = i + 1
            else
                if ch == "_"
                    let t = {}
                    t["k"] = "und"
                    push(toks, t)
                    i = i + 1
                else
                    let t = {}
                    t["k"] = "lit"
                    t["c"] = ch
                    push(toks, t)
                    i = i + 1
    return toks

// _like_dp(text, toks) -> bool (1/0)
// DP matching of text against token list from _like_tokenize.
// dp["i,j"]=1 means toks[0..i) matches text[0..j).
// i ranges 0..pn (number of tokens), j ranges 0..tn.
fn _like_dp(text, toks)
    let pn = len(toks)
    let tn = len(text)
    let dp = {}
    dp["0,0"] = 1

    // Seed column j=0: only leading % tokens can match empty string
    let i = 1
    while i <= pn
        let prev_key = str(i - 1) + ",0"
        if contains(dp, prev_key)
            let tok = toks[i - 1]
            if tok["k"] == "pct"
                dp[str(i) + ",0"] = 1
        i = i + 1

    // Fill DP table
    let i = 1
    while i <= pn
        let tok = toks[i - 1]
        let tk = tok["k"]
        let j = 1
        while j <= tn
            let tch = slice(text, j - 1, j)
            let val = 0
            if tk == "pct"
                // % matches zero more chars: dp[i-1][j]
                let k1 = str(i - 1) + "," + str(j)
                if contains(dp, k1)
                    val = 1
                // % matches one more char: dp[i][j-1]
                if val == 0
                    let k2 = str(i) + "," + str(j - 1)
                    if contains(dp, k2)
                        val = 1
            else
                if tk == "und"
                    // _ matches exactly one char
                    let k1 = str(i - 1) + "," + str(j - 1)
                    if contains(dp, k1)
                        val = 1
                else
                    // literal: must match the text char
                    let lc = tok["c"]
                    if lc == tch
                        let k1 = str(i - 1) + "," + str(j - 1)
                        if contains(dp, k1)
                            val = 1
            if val == 1
                dp[str(i) + "," + str(j)] = 1
            j = j + 1
        i = i + 1

    let rk = str(pn) + "," + str(tn)
    if contains(dp, rk)
        return 1
    return 0

// like_e(text, pattern, esc) -> bool (1/0)
// SQL LIKE match with an explicit escape character.
// esc: single-char string used as escape, or "" to disable escaping.
fn like_e(text, pattern, esc)
    let e = ""
    if len(esc) > 0
        e = slice(esc, 0, 1)
    let toks = _like_tokenize(pattern, e)
    return _like_dp(text, toks)

// like(text, pattern) -> bool (1/0)
// SQL LIKE match. Backslash is the escape character.
// % matches any run (including empty). _ matches exactly one char.
// \% and \_ are treated as literal % and _. \\ is a literal backslash.
fn like(text, pattern)
    let toks = _like_tokenize(pattern, "\\")
    return _like_dp(text, toks)

// ilike(text, pattern) -> bool (1/0)
// Case-insensitive SQL LIKE match (ASCII only). Backslash escape.
fn ilike(text, pattern)
    let lt = _like_lower(text)
    let lp = _like_lower(pattern)
    let toks = _like_tokenize(lp, "\\")
    return _like_dp(lt, toks)
