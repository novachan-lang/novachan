// ============================================================================
// NOVA Standard Library — std/uuid/uuid_compare
// ============================================================================
// RFC 4122 / RFC 9562 UUID comparison and sorting.
//
// UUIDs in canonical 8-4-4-4-12 form compare LEXICOGRAPHICALLY over their
// lowercase hex characters (hyphens are at fixed positions and equal in both).
// Because both strings have identical length (36) and identical hyphen positions,
// lexicographic string comparison over lowercase chars IS byte-wise unsigned
// comparison — no parsing to bytes is needed for correctness.
//
// ucm_compare normalises to lowercase before comparing so "550E8400-..." and
// "550e8400-..." are treated identically in ordering.
//
// PUBLIC API:
//   ucm_compare(a, b)  -> int    -1 if a < b, 0 if a == b, 1 if a > b
//   ucm_eq(a, b)       -> bool   true iff a == b (case-insensitive)
//   ucm_sort(uuids)    -> list   ascending copy via selection sort
//
// SELF-CONTAINED: imports nothing.

// ── Private helpers ────────────────────────────────────────────────────────────

// Map a single hex character (upper or lower) to its lowercase equivalent.
// Non-hex-alphabet chars (hyphens, etc.) are returned unchanged — they compare
// correctly as literals since both UUIDs have identical structure.
fn _ucm_lower_char(c) -> string
    let b = ord(c)
    if b >= 65 and b <= 90
        return chr(b + 32)
    c

// Lowercase a full UUID string for case-insensitive operations.
fn _ucm_lower(s) -> string
    let n = len(s)
    let out_parts = []
    for i in 0..n
        push(out_parts, _ucm_lower_char(s[i]))
    let out = join(out_parts, "")
    out

// ── Public API ─────────────────────────────────────────────────────────────────

// ucm_compare: compare two UUID strings; returns -1, 0, or 1.
// Comparison is case-insensitive and byte-wise unsigned (via lowercase
// lexicographic order, which equals unsigned numerical order for hex digits
// and hyphens at identical positions).
// Malformed (wrong length) inputs: shorter string is considered less.
fn ucm_compare(a: string, b: string) -> int
    let la = _ucm_lower(a)
    let lb = _ucm_lower(b)
    let na = len(la)
    let nb = len(lb)
    let n = na
    if nb < n
        n = nb
    for i in 0..n
        let ca = ord(la[i])
        let cb = ord(lb[i])
        if ca < cb
            return -1
        if ca > cb
            return 1
    if na < nb
        return -1
    if na > nb
        return 1
    0

// ucm_eq: return true iff two UUID strings represent the same UUID value
// (comparison is case-insensitive).
fn ucm_eq(a: string, b: string) -> bool
    ucm_compare(a, b) == 0

// ucm_sort: return a new list with the same UUID strings sorted ascending.
// Uses selection sort so no negative-index sentinel is needed and no
// language-level sort primitive is required.
fn ucm_sort(uuids: list) -> list
    let n = len(uuids)
    // Copy into a fresh list so we don't mutate the caller's list.
    let out = [uuids[i] for i in 0..n]
    // Selection sort: for each position, find the minimum in the tail.
    for i2 in 0..n
        let min_idx = i2
        let j = i2 + 1
        while j < n
            if ucm_compare(out[j], out[min_idx]) == -1
                min_idx = j
            j = j + 1
        if min_idx != i2
            let tmp = out[i2]
            out[i2] = out[min_idx]
            out[min_idx] = tmp
    out
