// std/uuid/uuid_bytes.nova — UUID byte-array conversion utilities.
//
// A UUID is canonically represented as 16 bytes (ints 0-255) in big-endian
// order, matching the RFC 4122 wire format:
//   bytes[0..3]   = time_low (32 bits)
//   bytes[4..5]   = time_mid (16 bits)
//   bytes[6..7]   = time_hi_and_version (16 bits; version in high nibble of byte 6)
//   bytes[8]      = clock_seq_hi_res (variant in top 2 bits)
//   bytes[9]      = clock_seq_low
//   bytes[10..15] = node (48 bits)
//
// All functions are DETERMINISTIC (no RNG / clock).
// All private helpers carry the _ubt_ prefix to avoid link collisions.
//
// Public API (prefix ubt_):
//   ubt_to_bytes(uuid_str)              -> list  (16 ints 0-255; [] on error)
//   ubt_from_bytes(bytes16)             -> str   (canonical UUID; "" on error)
//   ubt_get_byte(uuid_str, i)           -> int   (i-th byte 0-15; -1 on error)
//   ubt_from_halves(hi_bytes8, lo_bytes8) -> str (build from two 8-byte halves)
//
// NOVA-specific hazards noted inline:
//   - '>>' is arithmetic; only shift small positive values or mask afterwards.
//   - No multi-line list/dict literals; build with while + push.
//   - 'and' / 'or' / 'not' (not &&/||/!).
//   - String indexing s[i] returns a 1-char string.

// ── Hex alphabet helpers ─────────────────────────────────────────────────────

// _ubt_hex_alpha — 16-char lowercase hex alphabet, index = nibble value.
fn _ubt_hex_alpha() -> str
    "0123456789abcdef"

// _ubt_hex_char_val — numeric value (0..15) of a hex char (upper or lower), or -1.
fn _ubt_hex_char_val(c: str) -> int
    let b = ord(c)
    if b >= 48 and b <= 57
        return b - 48
    if b >= 97 and b <= 102
        return b - 87
    if b >= 65 and b <= 70
        return b - 55
    -1

// _ubt_nibble_char — hex char for nibble v (0..15).
fn _ubt_nibble_char(v: int) -> str
    let ha = _ubt_hex_alpha()
    ha[v]

// _ubt_byte_hex — 2-char lowercase hex string for byte b (0..255).
fn _ubt_byte_hex(b: int) -> str
    let hi = b / 16
    let lo = b - hi * 16
    _ubt_nibble_char(hi) + _ubt_nibble_char(lo)

// ── Internal parse helper ─────────────────────────────────────────────────────

// _ubt_canonical_to_hex32 — strip hyphens from a 36-char canonical UUID; returns "" on error.
fn _ubt_canonical_to_hex32(s: str) -> str
    if len(s) != 36
        return ""
    if s[8] != "-" or s[13] != "-" or s[18] != "-" or s[23] != "-"
        return ""
    let out = ""
    for i in 0..36
        if i != 8 and i != 13 and i != 18 and i != 23
            out += s[i]
    out

// _ubt_normalize_to_hex32 — accept hex32 (32 chars) or canonical (36 chars); returns "" on error.
fn _ubt_normalize_to_hex32(s: str) -> str
    let n = len(s)
    if n == 32
        return s
    if n == 36
        return _ubt_canonical_to_hex32(s)
    ""

// ── Public API ───────────────────────────────────────────────────────────────

// ubt_to_bytes — parse a canonical or hex32 UUID string into a list of 16 ints (0-255).
// Returns [] on malformed input.
fn ubt_to_bytes(uuid_str: str) -> list
    let h = _ubt_normalize_to_hex32(uuid_str)
    if len(h) != 32
        return []
    let result = []
    for i in 0..16
        let hv = _ubt_hex_char_val(h[i * 2])
        let lv = _ubt_hex_char_val(h[i * 2 + 1])
        if hv < 0 or lv < 0
            return []
        push(result, hv * 16 + lv)
    result

// ubt_from_bytes — convert a list of exactly 16 ints (0-255) to a canonical UUID string.
// Returns "" if bytes16 does not have exactly 16 elements.
fn ubt_from_bytes(bytes16: list) -> str
    if len(bytes16) != 16
        return ""
    let out_parts = []
    let i = 0
    while i < 16
        push(out_parts, _ubt_byte_hex(bytes16[i]))
        if i == 3 or i == 5 or i == 7 or i == 9
            push(out_parts, "-")
        i += 1
    let out = join(out_parts, "")
    out

// ubt_get_byte — return the i-th byte (0..15) of the UUID as an int (0-255).
// Returns -1 on malformed input or out-of-range index.
fn ubt_get_byte(uuid_str: str, i: int) -> int
    if i < 0 or i > 15
        return -1
    let bs = ubt_to_bytes(uuid_str)
    if len(bs) != 16
        return -1
    bs[i]

// ubt_from_halves — build a UUID from two 8-byte lists (hi = bytes 0-7, lo = bytes 8-15).
// Returns "" if either half does not have exactly 8 elements.
fn ubt_from_halves(hi_bytes8: list, lo_bytes8: list) -> str
    if len(hi_bytes8) != 8 or len(lo_bytes8) != 8
        return ""
    let all16 = []
    for i in 0..8
        push(all16, hi_bytes8[i])
    for j in 0..8
        push(all16, lo_bytes8[j])
    ubt_from_bytes(all16)
