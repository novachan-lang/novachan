// ============================================================================
// NOVA Standard Library — std/uuid/uuid_v7
// ============================================================================
// RFC 9562 §5.7 UUID version 7: Unix time-ordered UUID.
//
// LAYOUT (128 bits):
//   bits  0-47  : 48-bit big-endian Unix millisecond timestamp  (bytes 0-5)
//   bits 48-51  : version nibble = 7                            (byte 6 high)
//   bits 52-63  : random (12 bits)                              (byte 6 lo + byte 7)
//   bits 64-65  : variant = 10 (RFC 4122)                       (byte 8 high 2 bits)
//   bits 66-127 : random (62 bits)                              (bytes 8 lo + 9-15)
//
// DETERMINISTIC: rand_bytes supplies ALL random bits (no real RNG call).
//   rand_bytes[0] -> byte 6 low nibble  (bits 52-59)
//   rand_bytes[1] -> byte 7             (bits 56-63, overlap fine — only 12 rand bits here)
//   rand_bytes[2] -> byte 8 random part (bits 66-71 after variant mask)
//   rand_bytes[3..9] -> bytes 9-15
//   If rand_bytes is shorter than needed the missing slots default to 0.
//
// MONOTONICITY NOTE: because the high 48 bits are the timestamp, UUIDs generated
// at later milliseconds sort lexicographically AFTER earlier ones — the property
// that makes v7 useful as a database primary key.
//
// PUBLIC API:
//   u7_from(unix_ms, rand_bytes) -> str   Build a v7 UUID string.
//   u7_timestamp(uuid_str)       -> int   Extract the 48-bit unix-ms timestamp.
//   u7_is_v7(uuid_str)           -> bool  True when uuid_str is a valid v7 UUID.
//
// SELF-CONTAINED: no imports; all helpers prefixed _u7_.

// ── Hex helpers ──────────────────────────────────────────────────────────────

// Lowercase hex alphabet; nibble value i -> hex character.
fn _u7_alpha() -> str
    "0123456789abcdef"

// Nibble value 0-15 -> single lowercase hex char.
fn _u7_nibble(v) -> str
    let a = _u7_alpha()
    a[v]

// Byte 0-255 -> two lowercase hex chars (high nibble first).
fn _u7_b2h(b) -> str
    let hi = b / 16
    let lo = b - hi * 16
    _u7_nibble(hi) + _u7_nibble(lo)

// Hex char (one char string, upper or lower) -> nibble value 0-15, or -1 if invalid.
fn _u7_hval(c) -> int
    let i = 0
    let a = _u7_alpha()
    while i < 16
        if a[i] == c
            return i
        i = i + 1
    // Check uppercase A-F by matching against lowercase equivalent.
    if c == "A"
        return 10
    if c == "B"
        return 11
    if c == "C"
        return 12
    if c == "D"
        return 13
    if c == "E"
        return 14
    if c == "F"
        return 15
    -1

// Parse two consecutive hex chars at position pos in string s -> byte 0-255.
// Returns -1 if either char is invalid hex.
fn _u7_parse_byte(s, pos) -> int
    let hi = _u7_hval(s[pos])
    let lo = _u7_hval(s[pos + 1])
    if hi < 0 or lo < 0
        return -1
    hi * 16 + lo

// ── UUID formatting helper ────────────────────────────────────────────────────

// Format 16 bytes as canonical UUID string "8-4-4-4-12".
fn _u7_format(bytes) -> str
    let out_parts = []
    for j in 0..16
        push(out_parts, _u7_b2h(bytes[j]))
        if j == 3 or j == 5 or j == 7 or j == 9
            push(out_parts, "-")
    let out = join(out_parts, "")
    out

// ── rand_bytes safe accessor ──────────────────────────────────────────────────

// Read rand_bytes[idx] safely; return 0 if out of range.
fn _u7_rb(rand_bytes, idx) -> int
    if idx >= len(rand_bytes)
        return 0
    rand_bytes[idx]

// ── u7_from ───────────────────────────────────────────────────────────────────

// Build a UUID v7 from a 48-bit unix millisecond timestamp and random bytes.
// rand_bytes supplies the random bits; missing bytes default to 0.
fn u7_from(unix_ms, rand_bytes) -> str
    // Encode the 48-bit timestamp into bytes 0-5 (big-endian).
    // We extract each byte from the high end of the 48-bit value.
    let b5 = unix_ms & 255
    let t1 = unix_ms / 256
    let b4 = t1 & 255
    let t2 = t1 / 256
    let b3 = t2 & 255
    let t3 = t2 / 256
    let b2 = t3 & 255
    let t4 = t3 / 256
    let b1 = t4 & 255
    let t5 = t4 / 256
    let b0 = t5 & 255
    // byte 6: high nibble = version 7 (0x70), low nibble from rand_bytes[0]
    let b6 = (_u7_rb(rand_bytes, 0) & 15) | 112
    // byte 7: random
    let b7 = _u7_rb(rand_bytes, 1)
    // byte 8: variant 10xx xxxx = (rand & 0x3F) | 0x80
    let b8 = (_u7_rb(rand_bytes, 2) & 63) | 128
    // bytes 9-15: random
    let b9  = _u7_rb(rand_bytes, 3)
    let b10 = _u7_rb(rand_bytes, 4)
    let b11 = _u7_rb(rand_bytes, 5)
    let b12 = _u7_rb(rand_bytes, 6)
    let b13 = _u7_rb(rand_bytes, 7)
    let b14 = _u7_rb(rand_bytes, 8)
    let b15 = _u7_rb(rand_bytes, 9)
    let bytes = [b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15]
    _u7_format(bytes)

// ── u7_timestamp ─────────────────────────────────────────────────────────────

// Extract the 48-bit Unix millisecond timestamp from a v7 UUID string.
// Returns 0 on malformed input.
fn u7_timestamp(uuid_str) -> int
    if len(uuid_str) != 36
        return 0
    // Bytes 0-5 are encoded in hex chars 0-11 (before the first dash at pos 8).
    // Canonical layout: positions 0-7 (8 hex chars = 4 bytes), dash at 8,
    // positions 9-12 (4 hex chars = 2 bytes), dash at 13.
    let p0 = _u7_parse_byte(uuid_str, 0)
    let p1 = _u7_parse_byte(uuid_str, 2)
    let p2 = _u7_parse_byte(uuid_str, 4)
    let p3 = _u7_parse_byte(uuid_str, 6)
    let p4 = _u7_parse_byte(uuid_str, 9)
    let p5 = _u7_parse_byte(uuid_str, 11)
    if p0 < 0 or p1 < 0 or p2 < 0 or p3 < 0 or p4 < 0 or p5 < 0
        return 0
    // Reconstruct 48-bit value: b0 is MSB.
    let ts = p0
    ts = ts * 256 + p1
    ts = ts * 256 + p2
    ts = ts * 256 + p3
    ts = ts * 256 + p4
    ts = ts * 256 + p5
    ts

// ── u7_is_v7 ─────────────────────────────────────────────────────────────────

// Return true if uuid_str is a well-formed RFC 9562 version-7 UUID.
// Checks: length 36, dashes at 8/13/18/23, all LOWERCASE hex digits elsewhere,
// version nibble at index 14 is '7', variant nibble at index 19 in {8,9,a,b}.
// Uppercase hex is rejected — canonical form per RFC 4122 is lowercase.
fn _u7_is_lower_hex(c) -> bool
    let a = _u7_alpha()
    for i in 0..16
        if a[i] == c
            return true
    false

fn u7_is_v7(uuid_str) -> bool
    if len(uuid_str) != 36
        return false
    // Check dashes and lowercase hex chars.
    for i in 0..36
        let c = uuid_str[i]
        if i == 8 or i == 13 or i == 18 or i == 23
            if c != "-"
                return false
        else
            if not _u7_is_lower_hex(c)
                return false
    // Version nibble at index 14 must be '7'.
    if uuid_str[14] != "7"
        return false
    // Variant nibble at index 19 must be 8, 9, a, or b.
    let vn = uuid_str[19]
    if vn != "8" and vn != "9" and vn != "a" and vn != "b"
        return false
    true
