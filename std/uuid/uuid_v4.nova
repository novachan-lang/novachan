// ============================================================================
// NOVA Standard Library — std/uuid/uuid_v4
// ============================================================================
// RFC 4122 / RFC 9562 version-4 (random) UUID construction and validation.
//
// A v4 UUID is 128 bits of (pseudo-)random data with two mandatory constraints:
//   - Byte 6, high nibble MUST be 0x4 (version = 4)
//   - Byte 8, top two bits MUST be 0b10 (RFC 4122 variant = 0x80..0xBF)
//     Encoding: byte8 = (byte8 & 0x3F) | 0x80
//
// u4_from_bytes accepts a LIST of 16 ints (0-255), applies the version and
// variant fields, then formats the canonical 8-4-4-4-12 lowercase hex string.
// The input is the raw random bytes — the caller is responsible for generating
// them (so that this module is deterministic and testable).
//
// PUBLIC API:
//   u4_from_bytes(bytes16)  -> string  build canonical v4 UUID from 16-byte list
//   u4_is_v4(uuid_str)      -> bool    true iff string is a valid canonical v4 UUID
//
// SELF-CONTAINED: imports nothing.

// ── Private helpers ────────────────────────────────────────────────────────────

// The lowercase hex alphabet (index 0..15 -> char).
fn _u4_alpha() -> string
    "0123456789abcdef"

// Convert a nibble value 0..15 to its lowercase hex character.
fn _u4_nibble_to_char(n: int) -> string
    let alpha = _u4_alpha()
    alpha[n & 0x0F]

// Convert one byte (0..255) to a 2-character lowercase hex string.
fn _u4_byte_to_hex(b: int) -> string
    _u4_nibble_to_char((b >> 4) & 0x0F) + _u4_nibble_to_char(b & 0x0F)

// Convert a lowercase or uppercase hex character to its nibble value (0..15).
// Returns -1 for any character outside the hex alphabet.
fn _u4_hex_char_to_val(c: string) -> int
    let b = ord(c)
    if b >= 48 and b <= 57
        return b - 48
    if b >= 97 and b <= 102
        return b - 87
    if b >= 65 and b <= 70
        return b - 55
    -1

// Parse a UUID string (36 chars, 8-4-4-4-12 format) into a 16-element byte
// list. Returns an empty list on any parse error (wrong length, wrong hyphens,
// or non-hex digit).
fn _u4_parse_bytes(s: string) -> list
    if len(s) != 36
        return []
    // Verify hyphens at canonical positions 8, 13, 18, 23.
    if s[8] != "-"
        return []
    if s[13] != "-"
        return []
    if s[18] != "-"
        return []
    if s[23] != "-"
        return []
    // Collect the 32 hex chars in order (skipping hyphens).
    let hex_chars_parts = []
    for i in 0..36
        if i != 8 and i != 13 and i != 18 and i != 23
            let v = _u4_hex_char_to_val(s[i])
            if v < 0
                return []
            push(hex_chars_parts, s[i])
    let hex_chars = join(hex_chars_parts, "")
    // Now hex_chars has exactly 32 chars; decode to 16 bytes.
    let result = []
    let j = 0
    while j < 32
        let hi = _u4_hex_char_to_val(hex_chars[j])
        let lo = _u4_hex_char_to_val(hex_chars[j + 1])
        push(result, (hi * 16 + lo) & 0xFF)
        j += 2
    result

// ── Public API ─────────────────────────────────────────────────────────────────

// u4_from_bytes: apply RFC 4122 v4 version/variant constraints to a 16-byte
// list and return the canonical lowercase UUID string.
// Byte 6: high nibble forced to 0x4 (version 4).
//   byte6_new = (byte6 & 0x0F) | 0x40
// Byte 8: top two bits forced to 0b10 (RFC 4122 variant).
//   byte8_new = (byte8 & 0x3F) | 0x80
// Returns '' if bytes16 does not have exactly 16 elements.
fn u4_from_bytes(bytes16: list) -> string
    if len(bytes16) != 16
        return ""
    // Copy the bytes so we don't mutate the caller's list.
    let b = []
    let i = 0
    while i < 16
        push(b, bytes16[i] & 0xFF)
        i += 1
    // Apply version nibble to byte 6.
    b[6] = (b[6] & 0x0F) | 0x40
    // Apply variant bits to byte 8.
    b[8] = (b[8] & 0x3F) | 0x80
    // Format as 8-4-4-4-12 hex groups separated by hyphens.
    let g0 = _u4_byte_to_hex(b[0]) + _u4_byte_to_hex(b[1]) + _u4_byte_to_hex(b[2]) + _u4_byte_to_hex(b[3])
    let g1 = _u4_byte_to_hex(b[4]) + _u4_byte_to_hex(b[5])
    let g2 = _u4_byte_to_hex(b[6]) + _u4_byte_to_hex(b[7])
    let g3 = _u4_byte_to_hex(b[8]) + _u4_byte_to_hex(b[9])
    let g4 = _u4_byte_to_hex(b[10]) + _u4_byte_to_hex(b[11]) + _u4_byte_to_hex(b[12]) + _u4_byte_to_hex(b[13]) + _u4_byte_to_hex(b[14]) + _u4_byte_to_hex(b[15])
    g0 + "-" + g1 + "-" + g2 + "-" + g3 + "-" + g4

// u4_is_v4: return true iff uuid_str is a canonical (lowercase) v4 UUID.
// Checks: length 36, correct hyphens, only lowercase hex digits, version
// nibble (char at index 14) == '4', variant nibble (char at index 19) in
// {'8','9','a','b'} (i.e. top two bits == 0b10).
fn u4_is_v4(uuid_str: string) -> bool
    if len(uuid_str) != 36
        return false
    if uuid_str[8] != "-"
        return false
    if uuid_str[13] != "-"
        return false
    if uuid_str[18] != "-"
        return false
    if uuid_str[23] != "-"
        return false
    // Version nibble must be '4'.
    if uuid_str[14] != "4"
        return false
    // Variant nibble must be one of 8,9,a,b.
    let vch = uuid_str[19]
    if vch != "8" and vch != "9" and vch != "a" and vch != "b"
        return false
    // All remaining chars must be lowercase hex digits.
    for i in 0..36
        if i != 8 and i != 13 and i != 18 and i != 23
            let v = _u4_hex_char_to_val(uuid_str[i])
            if v < 0
                return false
            // Reject uppercase (A-F have ord 65-70; val would be >= 0 but char > 'f').
            let b = ord(uuid_str[i])
            if b >= 65 and b <= 70
                return false
    true
