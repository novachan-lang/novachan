// std/proof/proof_search.nova — Propositional proof search: decide validity and emit certificates.
// LEAF — imports NOTHING.
//
// Formula tags: ["var",name], ["not",f], ["and",a,b], ["or",a,b], ["imp",a,b], ["bot"], ["top"].
// Assignment: list of [name, 0/1] pairs.
//
// Public API:
//   psrch_provable(f)       -> bool  true iff f is a propositional tautology (sound + complete)
//   psrch_prove(f)          -> any   certificate (list ["tableau",f]) or "none" if not provable
//   psrch_countermodel(f)   -> any   assignment falsifying f, or "none" if f is valid

// _psrch_fmttag — return the tag of a formula.
fn _psrch_fmttag(f) -> string
    if type_of(f) != "list"
        return "bad"
    if len(f) == 0
        return "bad"
    if type_of(f[0]) != "string"
        return "bad"
    f[0]

// _psrch_sub1 — sub-formula at index 1.
fn _psrch_sub1(f) -> any
    f[1]

// _psrch_sub2 — sub-formula at index 2.
fn _psrch_sub2(f) -> any
    f[2]

// _psrch_collect_vars — collect all distinct variable names from formula f into var_list.
fn _psrch_collect_vars(f, var_list)
    let tag = _psrch_fmttag(f)
    if tag == "var"
        let name = f[1]
        let n = len(var_list)
        let i = 0
        let found = 0
        while i < n
            if var_list[i] == name
                found = 1
            i += 1
        if found == 0
            push(var_list, name)
        return
    if tag == "not"
        _psrch_collect_vars(_psrch_sub1(f), var_list)
        return
    if tag == "and"
        _psrch_collect_vars(_psrch_sub1(f), var_list)
        _psrch_collect_vars(_psrch_sub2(f), var_list)
        return
    if tag == "or"
        _psrch_collect_vars(_psrch_sub1(f), var_list)
        _psrch_collect_vars(_psrch_sub2(f), var_list)
        return
    if tag == "imp"
        _psrch_collect_vars(_psrch_sub1(f), var_list)
        _psrch_collect_vars(_psrch_sub2(f), var_list)
        return

// _psrch_lookup — look up name in [name, val] pair list; returns -1 if missing.
fn _psrch_lookup(name, asgn) -> int
    let n = len(asgn)
    let i = 0
    while i < n
        let pair = asgn[i]
        if pair[0] == name
            return pair[1]
        i += 1
    -1

// _psrch_eval — evaluate formula under assignment. Returns 0 or 1.
fn _psrch_eval(f, asgn) -> int
    let tag = _psrch_fmttag(f)
    if tag == "var"
        let v = _psrch_lookup(f[1], asgn)
        if v == -1
            return 0
        return v
    if tag == "bot"
        return 0
    if tag == "top"
        return 1
    if tag == "not"
        let v = _psrch_eval(_psrch_sub1(f), asgn)
        if v == 0
            return 1
        return 0
    if tag == "and"
        let v1 = _psrch_eval(_psrch_sub1(f), asgn)
        if v1 == 0
            return 0
        return _psrch_eval(_psrch_sub2(f), asgn)
    if tag == "or"
        let v1 = _psrch_eval(_psrch_sub1(f), asgn)
        if v1 == 1
            return 1
        return _psrch_eval(_psrch_sub2(f), asgn)
    if tag == "imp"
        let v1 = _psrch_eval(_psrch_sub1(f), asgn)
        if v1 == 0
            return 1
        return _psrch_eval(_psrch_sub2(f), asgn)
    0

// _psrch_make_asgn — build assignment list from vars[] and bitmask i (bit k = value of vars[k]).
fn _psrch_make_asgn(vars, i) -> list
    let asgn = []
    let n = len(vars)
    let k = 0
    while k < n
        let pair = [vars[k], (i >> k) & 1]
        push(asgn, pair)
        k += 1
    asgn

// _psrch_is_tautology — truth-table check: true iff f is 1 under all 2^k assignments.
fn _psrch_is_tautology(f) -> bool
    let vars = []
    _psrch_collect_vars(f, vars)
    let k = len(vars)
    let total = 1 << k
    for i in 0..total
        let asgn = _psrch_make_asgn(vars, i)
        if _psrch_eval(f, asgn) == 0
            return false
    true

// _psrch_find_falsifier — find first assignment making f = 0; returns [] if none (f valid).
fn _psrch_find_falsifier(f) -> list
    let vars = []
    _psrch_collect_vars(f, vars)
    let k = len(vars)
    let total = 1 << k
    for i in 0..total
        let asgn = _psrch_make_asgn(vars, i)
        if _psrch_eval(f, asgn) == 0
            return asgn
    []

// psrch_provable — decide if f is a tautology (sound and complete by truth-table enumeration).
fn psrch_provable(f) -> bool
    _psrch_is_tautology(f)

// psrch_countermodel — return a falsifying assignment if f is not valid, else "none".
// Note: for f with no variables (e.g. "bot"), the empty list IS a valid countermodel.
fn psrch_countermodel(f) -> any
    if _psrch_is_tautology(f)
        return "none"
    _psrch_find_falsifier(f)

// ============================================================
// Tableau machinery for psrch_prove (certificate generation)
// ============================================================

// _psrch_fmteq — syntactic equality of two formula trees.
fn _psrch_fmteq(a, b) -> bool
    if type_of(a) != type_of(b)
        return false
    if type_of(a) == "string"
        return a == b
    if type_of(a) == "int"
        return a == b
    if type_of(a) != "list"
        return false
    if len(a) != len(b)
        return false
    let n = len(a)
    for i in 0..n
        if not _psrch_fmteq(a[i], b[i])
            return false
    true

// _psrch_branch_closed — true iff branch has ["T",f] and ["F",f] for some f.
fn _psrch_branch_closed(branch) -> bool
    let n = len(branch)
    for i in 0..n
        let sf = branch[i]
        if sf[0] == "T"
            let f = sf[1]
            let j = 0
            while j < n
                if branch[j][0] == "F"
                    if _psrch_fmteq(branch[j][1], f)
                        return true
                j += 1
    false

// _psrch_copy_branch — shallow copy a branch.
fn _psrch_copy_branch(branch) -> list
    let out = []
    let n = len(branch)
    for i in 0..n
        push(out, branch[i])
    out

// _psrch_branch_without_idx — copy branch excluding element at index idx.
fn _psrch_branch_without_idx(branch, idx) -> list
    let n = len(branch)
    let out = [branch[i] for i in 0..n if i != idx]
    out

// _psrch_sf_kind — classify signed formula: 0=literal, 1=alpha, 2=beta, 3=auto-close.
fn _psrch_sf_kind(sf) -> int
    let sign = sf[0]
    let tag = _psrch_fmttag(sf[1])
    if tag == "var"
        return 0
    if tag == "top"
        if sign == "F"
            return 3
        return 0
    if tag == "bot"
        if sign == "T"
            return 3
        return 0
    if sign == "T" and tag == "and"
        return 1
    if sign == "F" and tag == "or"
        return 1
    if sign == "F" and tag == "imp"
        return 1
    if sign == "T" and tag == "not"
        return 1
    if sign == "F" and tag == "not"
        return 1
    if sign == "F" and tag == "and"
        return 2
    if sign == "T" and tag == "or"
        return 2
    if sign == "T" and tag == "imp"
        return 2
    0

// _psrch_alpha_parts — return list of signed formulas produced by alpha expansion of sf.
fn _psrch_alpha_parts(sf) -> list
    let sign = sf[0]
    let f = sf[1]
    let tag = _psrch_fmttag(f)
    let r = []
    if sign == "T" and tag == "and"
        push(r, ["T", _psrch_sub1(f)])
        push(r, ["T", _psrch_sub2(f)])
        return r
    if sign == "F" and tag == "or"
        push(r, ["F", _psrch_sub1(f)])
        push(r, ["F", _psrch_sub2(f)])
        return r
    if sign == "F" and tag == "imp"
        push(r, ["T", _psrch_sub1(f)])
        push(r, ["F", _psrch_sub2(f)])
        return r
    if sign == "T" and tag == "not"
        push(r, ["F", _psrch_sub1(f)])
        return r
    if sign == "F" and tag == "not"
        push(r, ["T", _psrch_sub1(f)])
        return r
    r

// _psrch_beta_left — signed formula(s) to add to left sub-branch of beta split.
fn _psrch_beta_left(sf) -> list
    let sign = sf[0]
    let f = sf[1]
    let tag = _psrch_fmttag(f)
    let r = []
    if sign == "F" and tag == "and"
        push(r, ["F", _psrch_sub1(f)])
        return r
    if sign == "T" and tag == "or"
        push(r, ["T", _psrch_sub1(f)])
        return r
    if sign == "T" and tag == "imp"
        push(r, ["F", _psrch_sub1(f)])
        return r
    r

// _psrch_beta_right — signed formula(s) to add to right sub-branch of beta split.
fn _psrch_beta_right(sf) -> list
    let sign = sf[0]
    let f = sf[1]
    let tag = _psrch_fmttag(f)
    let r = []
    if sign == "F" and tag == "and"
        push(r, ["F", _psrch_sub2(f)])
        return r
    if sign == "T" and tag == "or"
        push(r, ["T", _psrch_sub2(f)])
        return r
    if sign == "T" and tag == "imp"
        push(r, ["T", _psrch_sub2(f)])
        return r
    r

// _psrch_find_expandable — find first index of a non-literal signed formula, or -1.
fn _psrch_find_expandable(branch) -> int
    let n = len(branch)
    for i in 0..n
        let k = _psrch_sf_kind(branch[i])
        if k != 0
            return i
    -1

// _psrch_tab_close — tableau expansion returning true iff all branches close.
// Each call processes exactly one expandable formula (removes it and recurses on expansions).
fn _psrch_tab_close(branch) -> bool
    if _psrch_branch_closed(branch)
        return true
    let idx = _psrch_find_expandable(branch)
    if idx == -1
        return false
    let sf = branch[idx]
    let kind = _psrch_sf_kind(sf)
    let rest = _psrch_branch_without_idx(branch, idx)
    if kind == 3
        return true
    if kind == 1
        let parts = _psrch_alpha_parts(sf)
        let nb = _psrch_copy_branch(rest)
        for ni in 0..len(parts)
            push(nb, parts[ni])
        return _psrch_tab_close(nb)
    if kind == 2
        let ladds = _psrch_beta_left(sf)
        let radds = _psrch_beta_right(sf)
        let bleft = _psrch_copy_branch(rest)
        for ni2 in 0..len(ladds)
            push(bleft, ladds[ni2])
        let bright = _psrch_copy_branch(rest)
        for ni3 in 0..len(radds)
            push(bright, radds[ni3])
        if not _psrch_tab_close(bleft)
            return false
        return _psrch_tab_close(bright)
    false

// psrch_prove — return a certificate list ["tableau", f] if f is provable, else "none".
fn psrch_prove(f) -> any
    if not _psrch_is_tautology(f)
        return "none"
    let init = []
    push(init, ["F", f])
    let closed = _psrch_tab_close(init)
    if closed
        let cert = ["tableau", f]
        return cert
    "none"
