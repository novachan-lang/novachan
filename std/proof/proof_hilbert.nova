// std/proof/proof_hilbert.nova — Hilbert-style proof checker for propositional logic.
// LEAF — imports NOTHING.
//
// Formula shape (tagged list) — same convention as proof_formula:
//   ["var", name] ; ["not", f] ; ["and", a, b] ; ["or", a, b] ; ["imp", a, b] ; ["bot"] ; ["top"]
//
// Axiom schemas (classical propositional):
//   A1: A -> (B -> A)
//   A2: (A -> (B -> C)) -> ((A -> B) -> (A -> C))
//   A3: (~A -> ~B) -> (B -> A)
//
// A PROOF is a list of steps. Each step is one of:
//   ["ax", formula]         — formula must be an instance of A1, A2, or A3
//   ["mp", i, j, formula]  — modus ponens: step i is the antecedent, step j is imp(step_i, formula)
//                             (0-based indices into previous steps)
//
// Public API: all prefixed phil_.

// ── Formula constructors (self-contained) ───────────────────────────────────

// phil_var — propositional variable.
fn phil_var(name: string) -> list
    let f = []
    push(f, "var")
    push(f, name)
    f

// phil_not — negation.
fn phil_not(a: list) -> list
    let f = []
    push(f, "not")
    push(f, a)
    f

// phil_and — conjunction.
fn phil_and(a: list, b: list) -> list
    let f = []
    push(f, "and")
    push(f, a)
    push(f, b)
    f

// phil_or — disjunction.
fn phil_or(a: list, b: list) -> list
    let f = []
    push(f, "or")
    push(f, a)
    push(f, b)
    f

// phil_imp — implication.
fn phil_imp(a: list, b: list) -> list
    let f = []
    push(f, "imp")
    push(f, a)
    push(f, b)
    f

// phil_bot — falsity.
fn phil_bot() -> list
    let f = []
    push(f, "bot")
    f

// phil_top — truth.
fn phil_top() -> list
    let f = []
    push(f, "top")
    f

// ── Inline truth-table oracle (for cross-check) ──────────────────────────────

// _phil_env_lookup — look up variable in env ([name,val] pairs).
fn _phil_env_lookup(name: string, env: list) -> int
    let n = len(env)
    let i = 0
    let result = 0
    while i < n
        let pair = env[i]
        if pair[0] == name
            result = pair[1]
        i += 1
    result

// _phil_eval — evaluate formula under env; returns 0 or 1.
fn _phil_eval(f: list, env: list) -> int
    let tag = f[0]
    let result = 0
    if tag == "bot"
        result = 0
    if tag == "top"
        result = 1
    if tag == "var"
        result = _phil_env_lookup(f[1], env)
    if tag == "not"
        let sv = _phil_eval(f[1], env)
        if sv == 0
            result = 1
    if tag == "and"
        let lv = _phil_eval(f[1], env)
        let rv = _phil_eval(f[2], env)
        if lv == 1
            if rv == 1
                result = 1
    if tag == "or"
        let lv2 = _phil_eval(f[1], env)
        if lv2 == 1
            result = 1
        if lv2 == 0
            let rv2 = _phil_eval(f[2], env)
            if rv2 == 1
                result = 1
    if tag == "imp"
        let lv3 = _phil_eval(f[1], env)
        let rv3 = _phil_eval(f[2], env)
        if lv3 == 0
            result = 1
        if lv3 == 1
            if rv3 == 1
                result = 1
    result

// _phil_collect_vars — collect unique variable names.
fn _phil_collect_vars(f: list, seen: dict, out: list)
    let tag = f[0]
    if tag == "var"
        let nm = f[1]
        if nm not in seen
            seen[nm] = 1
            push(out, nm)
    if tag == "not"
        _phil_collect_vars(f[1], seen, out)
    if tag == "and"
        _phil_collect_vars(f[1], seen, out)
        _phil_collect_vars(f[2], seen, out)
    if tag == "or"
        _phil_collect_vars(f[1], seen, out)
        _phil_collect_vars(f[2], seen, out)
    if tag == "imp"
        _phil_collect_vars(f[1], seen, out)
        _phil_collect_vars(f[2], seen, out)

// _phil_is_tautology — truth-table tautology check.
fn _phil_is_tautology(f: list) -> int
    let seen = {}
    let vars = []
    _phil_collect_vars(f, seen, vars)
    let nv = len(vars)
    let total = 1
    for k in 0..nv
        total = total * 2
    let all_true = 1
    let i = 0
    while i < total
        let env = []
        for b in 0..nv
            let pair = []
            push(pair, vars[b])
            push(pair, (i >> b) & 1)
            push(env, pair)
        if _phil_eval(f, env) == 0
            all_true = 0
        i += 1
    all_true

// ── Structural equality ───────────────────────────────────────────────────────

// _phil_eq — structural equality of two formulas.
fn _phil_eq(f: list, g: list) -> int
    let ft = f[0]
    let gt = g[0]
    if ft != gt
        return 0
    if ft == "bot"
        return 1
    if ft == "top"
        return 1
    if ft == "var"
        if f[1] == g[1]
            return 1
        return 0
    if ft == "not"
        return _phil_eq(f[1], g[1])
    if ft == "and"
        if _phil_eq(f[1], g[1]) == 0
            return 0
        return _phil_eq(f[2], g[2])
    if ft == "or"
        if _phil_eq(f[1], g[1]) == 0
            return 0
        return _phil_eq(f[2], g[2])
    if ft == "imp"
        if _phil_eq(f[1], g[1]) == 0
            return 0
        return _phil_eq(f[2], g[2])
    0

// ── Axiom schema matching (metavariable unification) ─────────────────────────
// We use a dict to record metavariable bindings during matching.
// Metavariable names in schemas: "A", "B", "C" (uppercase = meta).

// _phil_is_meta — true if a var-node is a metavariable (uppercase first char).
fn _phil_is_meta(name: string) -> int
    let o = ord(slice(name, 0, 1))
    if o >= 65
        if o <= 90
            return 1
    0

// _phil_match_schema — attempt to match schema against formula, recording bindings in dict.
// Returns 1 if match succeeds, 0 if inconsistency.
fn _phil_match_schema(schema: list, f: list, bindings: dict) -> int
    let stag = schema[0]
    if stag == "var"
        let sname = schema[1]
        if _phil_is_meta(sname) == 1
            // metavariable: check or record binding
            if sname in bindings
                let bound = bindings[sname]
                return _phil_eq(bound, f)
            else
                bindings[sname] = f
                return 1
        else
            // concrete variable: must match literally
            if f[0] != "var"
                return 0
            if f[1] == sname
                return 1
            return 0
    // Both must have same tag
    if stag != f[0]
        return 0
    if stag == "bot"
        return 1
    if stag == "top"
        return 1
    if stag == "not"
        return _phil_match_schema(schema[1], f[1], bindings)
    if stag == "and"
        if _phil_match_schema(schema[1], f[1], bindings) == 0
            return 0
        return _phil_match_schema(schema[2], f[2], bindings)
    if stag == "or"
        if _phil_match_schema(schema[1], f[1], bindings) == 0
            return 0
        return _phil_match_schema(schema[2], f[2], bindings)
    if stag == "imp"
        if _phil_match_schema(schema[1], f[1], bindings) == 0
            return 0
        return _phil_match_schema(schema[2], f[2], bindings)
    0

// ── Axiom schema definitions ──────────────────────────────────────────────────
// A1: A -> (B -> A)
fn _phil_schema_a1() -> list
    phil_imp(phil_var("A"), phil_imp(phil_var("B"), phil_var("A")))

// A2: (A -> (B -> C)) -> ((A -> B) -> (A -> C))
fn _phil_schema_a2() -> list
    phil_imp(phil_imp(phil_var("A"), phil_imp(phil_var("B"), phil_var("C"))), phil_imp(phil_imp(phil_var("A"), phil_var("B")), phil_imp(phil_var("A"), phil_var("C"))))

// A3: (~A -> ~B) -> (B -> A)
fn _phil_schema_a3() -> list
    phil_imp(phil_imp(phil_not(phil_var("A")), phil_not(phil_var("B"))), phil_imp(phil_var("B"), phil_var("A")))

// phil_is_axiom — true iff formula f matches A1, A2, or A3.
fn phil_is_axiom(f: list) -> bool
    let b1 = {}
    if _phil_match_schema(_phil_schema_a1(), f, b1) == 1
        return true
    let b2 = {}
    if _phil_match_schema(_phil_schema_a2(), f, b2) == 1
        return true
    let b3 = {}
    if _phil_match_schema(_phil_schema_a3(), f, b3) == 1
        return true
    false

// ── Proof step extraction ─────────────────────────────────────────────────────

// phil_step_formula — extract the formula from a proof step.
// ["ax", f] -> f ; ["mp", i, j, f] -> f
fn phil_step_formula(step: list) -> list
    let kind = step[0]
    if kind == "ax"
        return step[1]
    if kind == "mp"
        return step[3]
    // Unknown step kind: return empty
    []

// ── Proof checker ─────────────────────────────────────────────────────────────

// phil_check — verify every step in proof; return the last concluded formula or "FAIL" string.
// A proof is a list of steps. The result is a list (formula) or the string "FAIL".
fn phil_check(proof: list) -> list
    let n = len(proof)
    // Collect concluded formulas as we go
    let formulas = []
    for i in 0..n
        let step = proof[i]
        let kind = step[0]
        if kind == "ax"
            let f = step[1]
            if not phil_is_axiom(f)
                let fail = []
                push(fail, "FAIL")
                return fail
            push(formulas, f)
        else
            if kind == "mp"
                // step = ["mp", i, j, conclusion]
                // step[i] is antecedent; step[j] must be imp(antecedent, conclusion)
                let ant_idx = step[1]
                let imp_idx = step[2]
                let conc = step[3]
                if ant_idx >= i
                    let fail = []
                    push(fail, "FAIL")
                    return fail
                if imp_idx >= i
                    let fail = []
                    push(fail, "FAIL")
                    return fail
                let ant_f = formulas[ant_idx]
                let imp_f = formulas[imp_idx]
                // imp_f must be imp(ant_f, conc)
                if imp_f[0] != "imp"
                    let fail = []
                    push(fail, "FAIL")
                    return fail
                if _phil_eq(imp_f[1], ant_f) == 0
                    let fail = []
                    push(fail, "FAIL")
                    return fail
                if _phil_eq(imp_f[2], conc) == 0
                    let fail = []
                    push(fail, "FAIL")
                    return fail
                push(formulas, conc)
            else
                let fail = []
                push(fail, "FAIL")
                return fail
    if len(formulas) == 0
        let fail = []
        push(fail, "FAIL")
        return fail
    formulas[n - 1]

// phil_proves — true iff proof is valid and concludes exactly target.
fn phil_proves(proof: list, target: list) -> bool
    let result = phil_check(proof)
    if len(result) == 0
        return false
    if result[0] == "FAIL"
        return false
    _phil_eq(result, target) == 1
