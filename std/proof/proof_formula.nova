// std/proof/proof_formula.nova — propositional formula representation and semantic oracle.
// LEAF — imports NOTHING.
//
// Formula shape (tagged list):
//   ["var", name]   — propositional variable
//   ["not", f]      — negation
//   ["and", a, b]   — conjunction
//   ["or",  a, b]   — disjunction
//   ["imp", a, b]   — implication
//   ["bot"]         — falsity (constant false)
//   ["top"]         — truth (constant true)
//
// An ASSIGNMENT is a list of [name, 0/1] pairs.
// All public functions are prefixed pfm_.

// pfm_var — construct a variable formula.
fn pfm_var(name: string) -> list
    let f = []
    push(f, "var")
    push(f, name)
    f

// pfm_not — construct a negation formula.
fn pfm_not(a: list) -> list
    let f = []
    push(f, "not")
    push(f, a)
    f

// pfm_and — construct a conjunction formula.
fn pfm_and(a: list, b: list) -> list
    let f = []
    push(f, "and")
    push(f, a)
    push(f, b)
    f

// pfm_or — construct a disjunction formula.
fn pfm_or(a: list, b: list) -> list
    let f = []
    push(f, "or")
    push(f, a)
    push(f, b)
    f

// pfm_imp — construct an implication formula (a -> b).
fn pfm_imp(a: list, b: list) -> list
    let f = []
    push(f, "imp")
    push(f, a)
    push(f, b)
    f

// pfm_bot — construct the falsity constant.
fn pfm_bot() -> list
    let f = []
    push(f, "bot")
    f

// pfm_top — construct the truth constant.
fn pfm_top() -> list
    let f = []
    push(f, "top")
    f

// _pfm_env_lookup — look up variable name in assignment env (list of [name,val] pairs).
fn _pfm_env_lookup(name: string, env: list) -> int
    let n = len(env)
    let i = 0
    let result = 0
    while i < n
        let pair = env[i]
        if pair[0] == name
            result = pair[1]
        i += 1
    result

// pfm_eval — evaluate formula f under assignment env; returns 0 or 1.
fn pfm_eval(f: list, env: list) -> int
    let tag = f[0]
    let result = 0
    if tag == "bot"
        result = 0
    if tag == "top"
        result = 1
    if tag == "var"
        result = _pfm_env_lookup(f[1], env)
    if tag == "not"
        let sub = pfm_eval(f[1], env)
        if sub == 0
            result = 1
    if tag == "and"
        let lv = pfm_eval(f[1], env)
        let rv = pfm_eval(f[2], env)
        if lv == 1
            if rv == 1
                result = 1
    if tag == "or"
        let lv2 = pfm_eval(f[1], env)
        if lv2 == 1
            result = 1
        if lv2 == 0
            let rv2 = pfm_eval(f[2], env)
            if rv2 == 1
                result = 1
    if tag == "imp"
        let lv3 = pfm_eval(f[1], env)
        let rv3 = pfm_eval(f[2], env)
        if lv3 == 0
            result = 1
        if lv3 == 1
            if rv3 == 1
                result = 1
    result

// _pfm_collect_vars — recursively collect variable names into seen dict and out list.
fn _pfm_collect_vars(f: list, seen: dict, out: list)
    let tag = f[0]
    if tag == "var"
        let nm = f[1]
        if nm not in seen
            seen[nm] = 1
            push(out, nm)
    if tag == "not"
        _pfm_collect_vars(f[1], seen, out)
    if tag == "and"
        _pfm_collect_vars(f[1], seen, out)
        _pfm_collect_vars(f[2], seen, out)
    if tag == "or"
        _pfm_collect_vars(f[1], seen, out)
        _pfm_collect_vars(f[2], seen, out)
    if tag == "imp"
        _pfm_collect_vars(f[1], seen, out)
        _pfm_collect_vars(f[2], seen, out)

// _pfm_sort_strs — insertion sort a list of strings in-place.
fn _pfm_sort_strs(lst: list)
    let n = len(lst)
    let i = 1
    while i < n
        let key = lst[i]
        let j = i - 1
        let going = 1
        while going == 1
            if j < 0
                going = 0
            else
                if lst[j] > key
                    lst[j + 1] = lst[j]
                    j -= 1
                else
                    going = 0
        lst[j + 1] = key
        i += 1

// pfm_vars — return sorted list of unique variable names in formula f.
fn pfm_vars(f: list) -> list
    let seen = {}
    let out = []
    _pfm_collect_vars(f, seen, out)
    _pfm_sort_strs(out)
    out

// _pfm_make_env — build assignment env from names list and integer bitmask i.
fn _pfm_make_env(names: list, i: int) -> list
    let env = []
    let n = len(names)
    for k in 0..n
        let pair = []
        push(pair, names[k])
        push(pair, (i >> k) & 1)
        push(env, pair)
    env

// pfm_is_tautology — true iff formula f evaluates to 1 under ALL assignments.
fn pfm_is_tautology(f: list) -> bool
    let vars = pfm_vars(f)
    let nv = len(vars)
    let total = 1
    for k in 0..nv
        total = total * 2
    let all_true = 1
    for i in 0..total
        let env = _pfm_make_env(vars, i)
        if pfm_eval(f, env) == 0
            all_true = 0
    all_true == 1

// pfm_is_sat — true iff formula f evaluates to 1 under SOME assignment.
fn pfm_is_sat(f: list) -> bool
    let vars = pfm_vars(f)
    let nv = len(vars)
    let total = 1
    for k in 0..nv
        total = total * 2
    let found = 0
    for i in 0..total
        let env = _pfm_make_env(vars, i)
        if pfm_eval(f, env) == 1
            found = 1
    found == 1

// pfm_equal — structural equality of two formulas.
fn pfm_equal(f: list, g: list) -> bool
    let ft = f[0]
    let gt = g[0]
    if ft != gt
        return false
    if ft == "bot"
        return true
    if ft == "top"
        return true
    if ft == "var"
        return f[1] == g[1]
    if ft == "not"
        return pfm_equal(f[1], g[1])
    if ft == "and"
        let la = pfm_equal(f[1], g[1])
        let ra = pfm_equal(f[2], g[2])
        return la and ra
    if ft == "or"
        let lo = pfm_equal(f[1], g[1])
        let ro = pfm_equal(f[2], g[2])
        return lo and ro
    if ft == "imp"
        let li = pfm_equal(f[1], g[1])
        let ri = pfm_equal(f[2], g[2])
        return li and ri
    false

// pfm_size — total number of nodes (subformulas) in formula f.
fn pfm_size(f: list) -> int
    let tag = f[0]
    if tag == "bot"
        return 1
    if tag == "top"
        return 1
    if tag == "var"
        return 1
    if tag == "not"
        return 1 + pfm_size(f[1])
    if tag == "and"
        return 1 + pfm_size(f[1]) + pfm_size(f[2])
    if tag == "or"
        return 1 + pfm_size(f[1]) + pfm_size(f[2])
    if tag == "imp"
        return 1 + pfm_size(f[1]) + pfm_size(f[2])
    1
