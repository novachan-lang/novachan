// std/chem/nuclear.nova — Nuclear decay and radioactivity formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   decay_remaining(initial, half_life, time) -> float  N = N0 * 0.5^(t/t_half)
//   half_lives_elapsed(time, half_life)        -> float  n = t / t_half
//   decay_constant(half_life)                  -> float  lambda = ln(2) / t_half  (~0.693/t_half)
//   activity(n, decay_const)                   -> float  A = N * lambda
//
// All time parameters must use the same unit (e.g. years, seconds).
// activity returns in same unit^-1 (e.g. decays/second if lambda is in s^-1).

// decay_remaining — N(t) = N0 * 0.5^(t/t_half)
fn decay_remaining(initial, half_life, time)
    let exponent = time / half_life
    let factor = pow(0.5, exponent)
    let remaining = initial * factor
    return remaining

// half_lives_elapsed — how many half-lives fit in the elapsed time.
fn half_lives_elapsed(time, half_life)
    let n = time / half_life
    return n

// decay_constant — lambda = ln(2) / t_half = 0.693147.../t_half.
// Uses 0.693 as the approximation consistent with spec.
fn decay_constant(half_life)
    let ln2 = 0.693
    let lambda = ln2 / half_life
    return lambda

// activity — A = N * lambda (decays per unit time).
fn activity(n, decay_const)
    let a = n * decay_const
    return a
