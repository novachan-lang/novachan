// std/chem/gas_laws.nova — Ideal and combined gas law formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   R()                              -> float  ideal gas constant 8.314 J/(mol·K)
//   ideal_gas_pressure(n, t, v)      -> float  P = nRT/V
//   ideal_gas_volume(n, t, p)        -> float  V = nRT/P
//   boyles_p2(p1, v1, v2)           -> float  P2 = P1*V1/V2  (constant T)
//   charles_v2(v1, t1, t2)          -> float  V2 = V1*T2/T1  (constant P)
//   combined_gas(p1, v1, t1, t2, p2) -> float  V2 = P1*V1*T2 / (T1*P2)
//
// All temperatures in Kelvin, pressures in Pa, volumes in L or m^3 (consistent units).

// Ideal gas constant (J / mol·K).
fn R()
    let r = 8.314
    return r

// Ideal gas law: P = nRT/V
fn ideal_gas_pressure(n, t, v)
    let r = R()
    let nrt = n * r * t
    let p = nrt / v
    return p

// Ideal gas law: V = nRT/P
fn ideal_gas_volume(n, t, p)
    let r = R()
    let nrt = n * r * t
    let v = nrt / p
    return v

// Boyle's Law (constant T): P2 = P1*V1/V2
fn boyles_p2(p1, v1, v2)
    let p1v1 = p1 * v1
    let p2 = p1v1 / v2
    return p2

// Charles's Law (constant P): V2 = V1*T2/T1
fn charles_v2(v1, t1, t2)
    let v1t2 = v1 * t2
    let v2 = v1t2 / t1
    return v2

// Combined Gas Law: V2 = P1*V1*T2 / (T1*P2)
fn combined_gas(p1, v1, t1, t2, p2)
    let numerator = p1 * v1 * t2
    let denominator = t1 * p2
    let v2 = numerator / denominator
    return v2
