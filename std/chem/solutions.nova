// std/chem/solutions.nova — Solution concentration formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   molarity(moles, liters)                -> float  M = moles / liters
//   molality(moles, kg_solvent)            -> float  m = moles / kg_solvent
//   dilution_c2(c1, v1, v2)               -> float  C2 = C1*V1/V2
//   mass_percent(mass_solute, mass_solution) -> float  w/w% = 100*solute/solution
//   ppm(mass_solute, mass_solution)        -> float  parts per million = solute/solution * 1e6

// Molarity: M = moles / liters
fn molarity(moles, liters)
    let m = moles / liters
    return m

// Molality: m = moles / kg_solvent
fn molality(moles, kg_solvent)
    let ml = moles / kg_solvent
    return ml

// Dilution equation: C2 = C1*V1/V2  (C1V1 = C2V2)
fn dilution_c2(c1, v1, v2)
    let c1v1 = c1 * v1
    let c2 = c1v1 / v2
    return c2

// Mass percent: w/w% = 100 * mass_solute / mass_solution
fn mass_percent(mass_solute, mass_solution)
    let ratio = mass_solute / mass_solution
    let pct = 100.0 * ratio
    return pct

// Parts per million: ppm = mass_solute / mass_solution * 1_000_000
fn ppm(mass_solute, mass_solution)
    let ratio = mass_solute / mass_solution
    let million = 1000000.0
    let result = ratio * million
    return result
