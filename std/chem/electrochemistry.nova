// std/chem/electrochemistry.nova — Electrochemical cell formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   cell_potential(cathode, anode)       -> float  E_cell = E_cathode - E_anode
//   nernst(e0, n, q)                     -> float  E = E0 - (0.0257/n)*ln(Q)
//   faraday_moles_electrons(charge)      -> float  moles = charge / F  (F = 96485 C/mol)
//   is_spontaneous(cell_potential)       -> bool   spontaneous if E_cell > 0
//
// All potentials in Volts. charge in Coulombs. n = number of moles of electrons.
// nernst uses RT/F at 298 K: 0.0257 V (= 0.025693 V, approximated as 0.0257 V).

// Faraday constant (C/mol).
fn faraday()
    96485.0

// cell_potential — E_cell = E_cathode - E_anode (standard reduction potentials).
fn cell_potential(cathode, anode)
    let diff = cathode - anode
    return diff

// nernst — Nernst equation: E = E0 - (0.0257/n) * ln(Q).
// Uses natural log (ln). At Q=1, ln(1)=0 so E = E0.
fn nernst(e0, n, q)
    let lnq = log(q)
    let factor = 0.0257 / n
    let correction = factor * lnq
    let e = e0 - correction
    return e

// faraday_moles_electrons — moles of electrons from charge (C).
// moles = charge / F
fn faraday_moles_electrons(charge)
    let f = faraday()
    let moles = charge / f
    return moles

// is_spontaneous — returns true if cell potential > 0 (spontaneous reaction).
fn is_spontaneous(cell_pot)
    cell_pot > 0.0
