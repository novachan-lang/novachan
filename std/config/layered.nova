// ============================================================================
// NOVA Standard Library — std/config/layered.nova
// ============================================================================
// Layered configuration with precedence.  Layers are added one at a time;
// later-added layers have HIGHER precedence (they shadow earlier ones).
//
// Representation: a plain dict with a single key "layers" holding a list of
// dicts.  Index 0 = lowest precedence; last index = highest precedence.
//
// Public API
//   cfg_new()               -> dict           Create an empty layered config.
//   cfg_add_layer(c, d)                        Append dict d as the highest-
//                                              precedence layer.
//   cfg_get(c, key, dflt)   -> value           Look up key; return dflt when
//                                              absent in every layer.
//   cfg_get_int(c, key, d)  -> int             cfg_get + int coercion.
//   cfg_has(c, key)         -> int (bool)      1 if key present in any layer.
//   cfg_merged(c)           -> dict            Flat dict: all keys, highest-
//                                              precedence value wins.
//   cfg_keys(c)             -> list            Sorted list of all unique keys
//                                              across all layers.
// ============================================================================

// cfg_new: create a fresh, empty layered-config handle.
fn cfg_new()
    let c = {}
    let layers = []
    c["layers"] = layers
    return c

// cfg_add_layer: append dict d as the new highest-precedence layer.
fn cfg_add_layer(c, d)
    let layers = c["layers"]
    layers.push(d)

// cfg_has: return 1 if key is present in at least one layer, else 0.
// Scans from last (highest) to first (lowest) and stops early on first hit.
fn cfg_has(c, key)
    let layers = c["layers"]
    let n = len(layers)
    let i = n - 1
    while i >= 0
        let layer = layers[i]
        if contains(layer, key)
            return 1
        i = i - 1
    return 0

// cfg_get: return the value of key from the highest-precedence layer that
// defines it, or dflt if no layer contains the key.
fn cfg_get(c, key, dflt)
    let layers = c["layers"]
    let n = len(layers)
    let i = n - 1
    while i >= 0
        let layer = layers[i]
        if contains(layer, key)
            return layer[key]
        i = i - 1
    return dflt

// cfg_get_int: like cfg_get but coerce the result to int.
// If the key is absent the integer default d is returned unchanged.
fn cfg_get_int(c, key, d)
    let layers = c["layers"]
    let n = len(layers)
    let i = n - 1
    while i >= 0
        let layer = layers[i]
        if contains(layer, key)
            let raw = layer[key]
            return int(raw)
        i = i - 1
    return d

// cfg_merged: produce a single flat dict: union of all layers, with
// higher-precedence layers overriding lower ones.
// We iterate low-to-high so each later layer naturally overwrites earlier.
fn cfg_merged(c)
    let layers = c["layers"]
    let n = len(layers)
    let out = {}
    let i = 0
    while i < n
        let layer = layers[i]
        let ks = keys(layer)
        let kn = len(ks)
        let j = 0
        while j < kn
            let k = ks[j]
            out[k] = layer[k]
            j = j + 1
        i = i + 1
    return out

// cfg_keys: sorted list of all unique keys across all layers.
fn cfg_keys(c)
    let layers = c["layers"]
    let n = len(layers)
    let seen = {}
    let out = []
    let i = 0
    while i < n
        let layer = layers[i]
        let ks = keys(layer)
        let kn = len(ks)
        let j = 0
        while j < kn
            let k = ks[j]
            if contains(seen, k) == 0
                seen[k] = 1
                out.push(k)
            j = j + 1
        i = i + 1
    return sort(out)

fn main()
    print("layered config module loaded")
