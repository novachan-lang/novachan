// ============================================================================
// NOVA Standard Library — std/config/dotenv.nova
// ============================================================================
// .env file parser. Pure NOVA — no I/O; operates only on the text string
// passed in by the caller (use read_file to load a file before calling).
//
// Public API
//   de_parse(text) -> dict   Parse .env text into a key->value dict.
//   de_get(parsed, key) -> value   Safe dict lookup with guard.
//
// Parsing rules:
//   • Lines are split on newline (\n).
//   • Blank lines (after trim) are ignored.
//   • Lines whose first non-whitespace char is '#' are ignored (comments).
//   • Leading "export " (with one space) is stripped from the key side.
//   • The first '=' in the line separates key from value.
//   • Key is trimmed of surrounding whitespace.
//   • Value is trimmed of surrounding whitespace, then if it starts AND ends
//     with matching double-quote (") or single-quote (') those outer quotes
//     are stripped. Internal spaces/content within the quotes are kept as-is.
//   • Lines without '=' are silently skipped.
// ============================================================================

// _find_eq: return the index of the first '=' in s, or -1 if absent.
// We walk byte-by-byte using ord/slice rather than find() because find()
// returns the offset within the slice, not the absolute index — we need
// the absolute position to split key and value correctly.
fn _find_eq(s) -> int
    let n = len(s)
    for i in 0..n
        if ord(s[i]) == 61    // '=' is ASCII 61
            return i
    -1

// _strip_quotes: if s is surrounded by matching " or ' remove them.
// Only strips ONE layer of quotes (outermost pair). Internal quotes kept.
fn _strip_quotes(s) -> str
    let n = len(s)
    if n < 2
        return s
    let first = ord(s[0])
    let last  = ord(s[n - 1])
    // double-quote: ASCII 34; single-quote: ASCII 39
    if first == 34 and last == 34
        return slice(s, 1, n - 1)
    if first == 39 and last == 39
        return slice(s, 1, n - 1)
    s

// de_parse: parse .env-format text into a key->value string dict.
// The returned dict maps string keys to string values.
fn de_parse(text) -> dict
    let result = {}
    let lines = split(text, "\n")
    let i = 0
    let n = len(lines)
    while i < n
        let raw = lines[i]
        // Trim surrounding whitespace from the whole line
        let trimmed = trim(raw)
        // Skip blank lines
        if len(trimmed) == 0
            i += 1
            continue
        // Skip comment lines
        if starts_with(trimmed, "#")
            i += 1
            continue
        // Strip leading "export " prefix (with exactly one space)
        let work = trimmed
        if starts_with(work, "export ")
            work = slice(work, 7, len(work))
        // Find the '=' separator
        let eq = _find_eq(work)
        if eq < 0
            i += 1
            continue
        // Split into key and raw-value
        let key = trim(slice(work, 0, eq))
        let raw_val = trim(slice(work, eq + 1, len(work)))
        // Strip surrounding quotes from value
        let val = _strip_quotes(raw_val)
        // Only insert if key is non-empty
        if len(key) > 0
            result[key] = val
        i += 1
    result

// de_get: safely retrieve a value from a parsed dict.
// Returns the value string if the key exists, or "" if absent.
fn de_get(parsed, key) -> str
    if key in parsed
        return parsed[key]
    ""

fn main()
    print("dotenv module loaded")
