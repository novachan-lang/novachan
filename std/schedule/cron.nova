// std/schedule/cron.nova — standard 5-field cron expression parser
// ("minute hour day-of-month month day-of-week") and matcher.
//
// Each field supports the usual cron token grammar, comma-separated:
//   "*"          any value
//   "*/N"        every N-th value starting at the field's minimum
//   "N-M"        inclusive range
//   "N-M/S"      inclusive range, stepped by S
//   "N"          exact value
//   "a,b,c"      union of any of the above tokens
//
// cr_parse stores each field verbatim (as a string) — nothing is validated
// or expanded until cr_matches / cr_field_matches runs, so the same parsed
// expression can be tested against many (minute, hour, dom, month, dow)
// tuples cheaply.
//
// Public API (prefix cr_):
//   cr_parse(expr)                                        -> dict
//   cr_matches(parsed, minute, hour, dom, month, dow)      -> bool
//   cr_field_matches(field_str, value, max_val)            -> bool
//   cr_describe(parsed)                                    -> string
//   cr_next_fields(parsed, minute, hour)                   -> list  [next_minute, next_hour]
//
// LEAF — imports nothing.

// cr_parse: split a 5-field cron expression on single spaces into a dict
// with keys "minute", "hour", "dom", "month", "dow" (each a raw string).
fn cr_parse(expr: string) -> dict
    let parts = split(expr, " ")
    return {"minute": parts[0], "hour": parts[1], "dom": parts[2], "month": parts[3], "dow": parts[4]}

// Private: "N-M" or "N-M/S" range token (the /S part, if present, is
// handled by the caller before this is reached — this only sees "N-M").
fn _cr_range_matches(token: string, value: int) -> bool
    let parts = split(token, "-")
    let lo = int(parts[0])
    let hi = int(parts[1])
    return value >= lo and value <= hi

// Private: "*/S", "N/S" or "N-M/S" stepped token.
fn _cr_step_matches(token: string, value: int) -> bool
    let parts = split(token, "/")
    let base = parts[0]
    let step = int(parts[1])
    if step <= 0
        return false
    if base == "*"
        return value % step == 0
    if "-" in base
        let bp = split(base, "-")
        let lo = int(bp[0])
        let hi = int(bp[1])
        if value < lo or value > hi
            return false
        return (value - lo) % step == 0
    let lo2 = int(base)
    if value < lo2
        return false
    return (value - lo2) % step == 0

// Private: a single comma-separated token (no comma inside it).
fn _cr_token_matches(token: string, value: int) -> bool
    if token == "*"
        return true
    if "/" in token
        return _cr_step_matches(token, value)
    if "-" in token
        return _cr_range_matches(token, value)
    return int(token) == value

// cr_field_matches: true iff value satisfies field_str (a single cron
// field, comma-separated union of tokens). max_val documents the field's
// valid upper bound for callers; it is not required to interpret "*",
// which matches unconditionally.
fn cr_field_matches(field_str: string, value: int, max_val: int) -> bool
    for tok in split(field_str, ",")
        if _cr_token_matches(tok, value)
            return true
    return false

// cr_matches: true iff every field of parsed matches the given calendar
// point. Standard field ranges: minute 0-59, hour 0-23, dom 1-31,
// month 1-12, dow 0-6 (0 = Sunday).
fn cr_matches(parsed, minute: int, hour: int, dom: int, month: int, dow: int) -> bool
    if not cr_field_matches(parsed["minute"], minute, 59)
        return false
    if not cr_field_matches(parsed["hour"], hour, 23)
        return false
    if not cr_field_matches(parsed["dom"], dom, 31)
        return false
    if not cr_field_matches(parsed["month"], month, 12)
        return false
    if not cr_field_matches(parsed["dow"], dow, 6)
        return false
    return true

// Private: human-readable description of one field.
fn _cr_field_desc(name: string, val: string) -> string
    if val == "*"
        return "every " + name
    return name + "=" + val

// cr_describe: a compact human-readable summary of the parsed expression,
// e.g. "every minute, hour=9, every dom, every month, dow=1".
fn cr_describe(parsed) -> string
    let parts = [_cr_field_desc("minute", parsed["minute"]), _cr_field_desc("hour", parsed["hour"]), _cr_field_desc("dom", parsed["dom"]), _cr_field_desc("month", parsed["month"]), _cr_field_desc("dow", parsed["dow"])]
    return join(parts, ", ")

// cr_next_fields: the next (minute, hour) pair strictly after the given
// one that matches parsed's minute and hour fields, wrapping at 24:00 back
// to 00:00 (day-of-month/month/day-of-week are not considered — this is
// the "simple" minute/hour-only next match). Returns [-1, -1] if no
// minute/hour combination in a 24h day matches (only possible if the
// fields themselves are unsatisfiable, e.g. empty).
fn cr_next_fields(parsed, minute: int, hour: int) -> list
    let mn = parsed["minute"]
    let hr = parsed["hour"]
    let total = 24 * 60
    let start = hour * 60 + minute
    let i = start + 1
    let found_m = -1
    let found_h = -1
    let steps = 0
    while steps < total and found_m == -1
        let cand = i % total
        let h = cand / 60
        let m = cand % 60
        if cr_field_matches(mn, m, 59) and cr_field_matches(hr, h, 23)
            found_m = m
            found_h = h
        i += 1
        steps += 1
    return [found_m, found_h]
