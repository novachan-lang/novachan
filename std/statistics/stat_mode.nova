// std/statistics/stat_mode.nova — mode (most-frequent value) statistics.
// Input: int or float list compared by value equality.
// On empty list: smo_mode returns 0, smo_modes returns [], smo_frequency returns [], smo_is_multimodal returns false.
// Tie-breaking in smo_mode: smallest value wins (numerically, via sorted order).
// LEAF — imports NOTHING.

// Private: return a new list sorted ascending by int/float value (insertion sort, stable, O(n²)).
fn _smo_sorted(xs: list) -> list
    let out = []
    let i = 0
    while i < len(xs)
        let v = xs[i] * 1.0
        push(out, xs[i])
        let j = len(out) - 1
        while j > 0 and out[j - 1] * 1.0 > v
            out[j] = out[j - 1]
            j = j - 1
        out[j] = xs[i]
        i = i + 1
    out

// Private: count how many times value v appears in xs.
fn _smo_count(xs: list, v) -> int
    let c = 0
    let i = 0
    while i < len(xs)
        if xs[i] == v
            c = c + 1
        i = i + 1
    c

// Private: compute the maximum frequency in xs (0 if empty).
fn _smo_max_freq(xs: list) -> int
    let n = len(xs)
    if n == 0
        return 0
    let best = 0
    let i = 0
    while i < n
        let c = _smo_count(xs, xs[i])
        if c > best
            best = c
        i = i + 1
    best

// smo_mode: returns the most frequent value; on a tie returns the smallest.
fn smo_mode(xs: list) -> int
    let n = len(xs)
    if n == 0
        return 0
    let mf = _smo_max_freq(xs)
    let s = _smo_sorted(xs)
    let i = 0
    while i < n
        let v = s[i]
        let c = _smo_count(xs, v)
        if c == mf
            return v
        i = i + 1
    s[0]

// smo_modes: returns all values tied for the highest frequency, in ascending order.
fn smo_modes(xs: list) -> list
    let n = len(xs)
    if n == 0
        return []
    let mf = _smo_max_freq(xs)
    let s = _smo_sorted(xs)
    let result = []
    let prev_added = 0
    let has_prev = 0
    let i = 0
    while i < n
        let v = s[i]
        let c = _smo_count(xs, v)
        if c == mf
            if has_prev == 0 or prev_added != v
                push(result, v)
                prev_added = v
                has_prev = 1
        i = i + 1
    result

// smo_frequency: returns list of [value, count] pairs, sorted ascending by value.
// Each unique value appears exactly once.
fn smo_frequency(xs: list) -> list
    let n = len(xs)
    if n == 0
        return []
    let s = _smo_sorted(xs)
    let result = []
    let i = 0
    while i < n
        let v = s[i]
        if i == 0 or s[i - 1] != v
            let c = _smo_count(xs, v)
            let pair = [v, c]
            push(result, pair)
        i = i + 1
    result

// smo_is_multimodal: 1 iff more than one distinct value shares the maximum frequency, else 0.
fn smo_is_multimodal(xs: list) -> int
    let modes = smo_modes(xs)
    let n = len(modes)
    if n > 1
        return 1
    0
