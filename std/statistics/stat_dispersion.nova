// std/statistics/stat_dispersion.nova — dispersion / spread measures.
// Input: int or float list. Output: float.
// Empty list: all functions return 0.0.
// Population formulas used throughout (divide by n).
// LEAF — imports NOTHING.

// Private: sorted ascending copy of xs as floats (insertion sort; O(n²)).
fn _sd_sorted(xs: list) -> list
    let out = []
    for i in 0..len(xs)
        let v = xs[i] * 1.0
        push(out, v)
        let j = len(out) - 1
        while j > 0 and out[j - 1] > v
            out[j] = out[j - 1]
            j -= 1
        out[j] = v
    out

// Private: median of a SORTED float list of length n (n must be > 0).
fn _sd_median_of(s: list, n: int) -> float
    if n == 1
        return s[0] * 1.0
    if n % 2 == 1
        let mid = n / 2
        return s[mid] * 1.0
    let lo = s[n / 2 - 1] * 1.0
    let hi = s[n / 2] * 1.0
    let m = (lo + hi) / 2.0
    m

// Private: population mean of xs as float.
fn _sd_mean(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = 0.0
    for i in 0..n
        s += xs[i] * 1.0
    let m = s / (n * 1.0)
    m

// sd_range: maximum − minimum. Returns 0.0 on empty or single-element list.
fn sd_range(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let mn = xs[0] * 1.0
    let mx = xs[0] * 1.0
    for i in 1..n
        let v = xs[i] * 1.0
        if v < mn
            mn = v
        if v > mx
            mx = v
    let r = mx - mn
    r

// sd_mad_mean: mean absolute deviation from the (population) mean.
// = (1/n) * sum(|xi - mean|).
fn sd_mad_mean(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let mu = _sd_mean(xs)
    let acc = 0.0
    for i in 0..n
        let d = xs[i] * 1.0 - mu
        if d < 0.0
            d = 0.0 - d
        acc += d
    let result = acc / (n * 1.0)
    result

// sd_mad_median: mean absolute deviation from the median.
// = (1/n) * sum(|xi - median|).
fn sd_mad_median(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = _sd_sorted(xs)
    let med = _sd_median_of(s, n)
    let acc = 0.0
    for i in 0..n
        let d = xs[i] * 1.0 - med
        if d < 0.0
            d = 0.0 - d
        acc += d
    let result = acc / (n * 1.0)
    result

// sd_cv: coefficient of variation = population stddev / mean.
// Returns 0.0 when mean is 0 or list is empty.
fn sd_cv(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let mu = _sd_mean(xs)
    let mu_abs = mu
    if mu_abs < 0.0
        mu_abs = 0.0 - mu_abs
    if mu_abs < 0.000001
        return 0.0
    let acc = 0.0
    for i in 0..n
        let d = xs[i] * 1.0 - mu
        let dd = d * d
        acc += dd
    let nf = n * 1.0
    let pop_var = acc / nf
    let pop_std = sqrt(pop_var)
    let cv = pop_std / mu
    cv
