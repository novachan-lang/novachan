// std/statistics/stat_means.nova — alternative means over a numeric list.
// Distinct from std/math/stats (arithmetic mean/sum/median/stddev/percentile).
// All functions accept int or float lists; results are float.
// Empty list or invalid input: return 0.0 (never crash / divide-by-zero).
// LEAF — imports NOTHING.

// Private: convert a non-negative float to an integer (floor toward 0).
fn _sm_ftoi(fval: float) -> int
    let k = 0
    let acc = 0.0
    while acc + 1.0 <= fval
        acc = acc + 1.0
        k = k + 1
    k

// Private: sort a copy of xs ascending (insertion sort, stable).
fn _sm_sorted(xs: list) -> list
    let out = []
    for i in 0..len(xs)
        let v = xs[i] * 1.0
        push(out, v)
        let j = len(out) - 1
        while j > 0 and out[j - 1] > v
            out[j] = out[j - 1]
            j = j - 1
        out[j] = v
    out

// sm_geometric — n-th root of the product of all elements.
// Uses exp(mean(log(x))) for numerical stability.
// Returns 0.0 on empty list; 0.0 if any element is <= 0.
fn sm_geometric(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let log_sum = 0.0
    for i in 0..n
        let v = xs[i] * 1.0
        if v <= 0.0
            return 0.0
        let lv = log(v)
        log_sum = log_sum + lv
    let mean_log = log_sum / (n * 1.0)
    let result = exp(mean_log)
    result

// sm_harmonic — harmonic mean: n / sum(1/x).
// Returns 0.0 on empty list or if any element is 0.
fn sm_harmonic(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let recip_sum = 0.0
    for i in 0..n
        let v = xs[i] * 1.0
        if v == 0.0
            return 0.0
        recip_sum = recip_sum + 1.0 / v
    let result = (n * 1.0) / recip_sum
    result

// sm_weighted — weighted mean: sum(x*w) / sum(w).
// xs and ws must have the same length. Returns 0.0 on empty or mismatched lists.
fn sm_weighted(xs: list, ws: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    if len(ws) != n
        return 0.0
    let wsum = 0.0
    let wxsum = 0.0
    for i in 0..n
        let w = ws[i] * 1.0
        let x = xs[i] * 1.0
        wxsum = wxsum + x * w
        wsum = wsum + w
    if wsum == 0.0
        return 0.0
    let result = wxsum / wsum
    result

// sm_rms — root-mean-square: sqrt(mean of squares).
// Returns 0.0 on empty list.
fn sm_rms(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let sq_sum = 0.0
    for i in 0..n
        let v = xs[i] * 1.0
        sq_sum = sq_sum + v * v
    let mean_sq = sq_sum / (n * 1.0)
    let result = sqrt(mean_sq)
    result

// sm_trimmed — trimmed mean: arithmetic mean after dropping pct_int % from each end.
// pct_int is an integer percentage (e.g. 10 means drop 10% from each end).
// The number of elements to drop from each end = floor(n * pct_int / 100).
// Returns 0.0 on empty list. Returns arithmetic mean when pct_int = 0.
fn sm_trimmed(xs: list, pct_int: int) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = _sm_sorted(xs)
    let drop_f = n * 1.0 * pct_int * 1.0 / 100.0
    let drop = _sm_ftoi(drop_f)
    let lo = drop
    let hi = n - drop
    if lo >= hi
        return 0.0
    let acc = 0.0
    let i = lo
    while i < hi
        acc = acc + s[i] * 1.0
        i = i + 1
    let cnt = (hi - lo) * 1.0
    let result = acc / cnt
    result
