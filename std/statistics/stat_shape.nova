// std/statistics/stat_shape.nova — population moment-based shape statistics.
// All functions operate on a list of ints or floats.
// Empty or single-element lists return 0.0 (no division by zero).
// LEAF — imports NOTHING.

// Private: compute mean of a list as float.
fn _ssh_mean(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = 0.0
    for i in 0..n
        s = s + xs[i] * 1.0
    s / (n * 1.0)

// ssh_skewness — population skewness = m3 / m2^1.5, where mk = mean of (x-mean)^k.
// Zero for symmetric distributions; positive = right-tailed; negative = left-tailed.
fn ssh_skewness(xs: list) -> float
    let n = len(xs)
    if n < 2
        return 0.0
    let mu = _ssh_mean(xs)
    let acc2 = 0.0
    let acc3 = 0.0
    for i in 0..n
        let d = xs[i] * 1.0 - mu
        let d2 = d * d
        let d3 = d2 * d
        acc2 = acc2 + d2
        acc3 = acc3 + d3
    let fn_f = n * 1.0
    let m2 = acc2 / fn_f
    let m3 = acc3 / fn_f
    if m2 < 0.000001 and m2 > -0.000001
        return 0.0
    let denom = m2 * sqrt(m2)
    m3 / denom

// ssh_kurtosis — population kurtosis = m4 / m2^2.
// Normal distribution has kurtosis ~3; low kurtosis = flat-tailed.
fn ssh_kurtosis(xs: list) -> float
    let n = len(xs)
    if n < 2
        return 0.0
    let mu = _ssh_mean(xs)
    let acc2 = 0.0
    let acc4 = 0.0
    for i in 0..n
        let d = xs[i] * 1.0 - mu
        let d2 = d * d
        let d4 = d2 * d2
        acc2 = acc2 + d2
        acc4 = acc4 + d4
    let fn_f = n * 1.0
    let m2 = acc2 / fn_f
    let m4 = acc4 / fn_f
    if m2 < 0.000001 and m2 > -0.000001
        return 0.0
    let m2sq = m2 * m2
    m4 / m2sq

// ssh_excess_kurtosis — population excess kurtosis = kurtosis - 3.
// Zero for a normal distribution; negative = platykurtic; positive = leptokurtic.
// Returns 0.0 for empty or single-element lists.
fn ssh_excess_kurtosis(xs: list) -> float
    let n = len(xs)
    if n < 2
        return 0.0
    let k = ssh_kurtosis(xs)
    k - 3.0
