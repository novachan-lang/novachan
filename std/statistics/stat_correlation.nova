// std/statistics/stat_correlation.nova — population covariance and Pearson correlation.
// Operates on pairs of equal-length lists of ints or floats.
// Empty or mismatched lists return 0.0.
// LEAF — imports NOTHING.

// sc_variance — population variance = mean of squared deviations from the mean.
fn sc_variance(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = 0.0
    for i in 0..n
        s = s + xs[i] * 1.0
    let mu = s / (n * 1.0)
    let acc = 0.0
    for j in 0..n
        let d = xs[j] * 1.0 - mu
        acc = acc + d * d
    acc / (n * 1.0)

// sc_covariance — population covariance = mean of (x-mx)(y-my).
// Returns 0.0 if either list is empty or lengths differ.
fn sc_covariance(xs: list, ys: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    if len(ys) != n
        return 0.0
    let sx = 0.0
    let sy = 0.0
    for i in 0..n
        sx = sx + xs[i] * 1.0
        sy = sy + ys[i] * 1.0
    let fn_f = n * 1.0
    let mx = sx / fn_f
    let my = sy / fn_f
    let acc = 0.0
    for j in 0..n
        let dx = xs[j] * 1.0 - mx
        let dy = ys[j] * 1.0 - my
        acc = acc + dx * dy
    acc / fn_f

// sc_pearson — Pearson correlation coefficient = cov(xs,ys) / (stddev(xs) * stddev(ys)).
// Computes everything in one pass to avoid stale float-slot hazards.
// Returns 0.0 for empty, mismatched, or constant-valued inputs.
fn sc_pearson(xs: list, ys: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    if len(ys) != n
        return 0.0
    let sx = 0.0
    let sy = 0.0
    for i in 0..n
        sx = sx + xs[i] * 1.0
        sy = sy + ys[i] * 1.0
    let fn_f = n * 1.0
    let mx = sx / fn_f
    let my = sy / fn_f
    let cov_acc = 0.0
    let vx_acc = 0.0
    let vy_acc = 0.0
    for j in 0..n
        let dx = xs[j] * 1.0 - mx
        let dy = ys[j] * 1.0 - my
        cov_acc = cov_acc + dx * dy
        vx_acc = vx_acc + dx * dx
        vy_acc = vy_acc + dy * dy
    let cov_v = cov_acc / fn_f
    let var_x = vx_acc / fn_f
    let var_y = vy_acc / fn_f
    if var_x < 0.000001 and var_x > -0.000001
        return 0.0
    if var_y < 0.000001 and var_y > -0.000001
        return 0.0
    let sdx = sqrt(var_x)
    let sdy = sqrt(var_y)
    let denom = sdx * sdy
    cov_v / denom
