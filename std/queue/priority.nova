// std/queue/priority — array-based binary MIN-heap priority queue, wrapped
// in a dict for reference semantics.
//
// Representation:
//   {"items": []}  — items[i] is a [priority, value] pair; items[0] holds
//                    the minimum-priority pair (heap root).
//
// Heap invariant: items[i][0] <= items[2*i+1][0] and items[i][0] <= items[2*i+2][0]
// (every parent's priority is <= both its children's priorities). Ties in
// priority are broken arbitrarily by heap structure (not FIFO-stable).
//
// Public API:
//   pq_new()               -> queue dict (empty)
//   pq_push(pq, priority, value) -> (mutates pq)
//   pq_pop(pq)              -> any (value with the lowest priority; 0 if empty)
//   pq_peek(pq)              -> any (same, without removing; 0 if empty)
//   pq_size(pq)              -> int
//   pq_is_empty(pq)          -> bool
//
// LEAF — imports nothing.

// _pq_swap: swap items[a] and items[b] in-place.
fn _pq_swap(items, a, b)
    let tmp = items[a]
    items[a] = items[b]
    items[b] = tmp

// _pq_sift_up: move the pair at index i toward the root until the heap
// property holds, comparing by priority (index 0 of each pair).
fn _pq_sift_up(items, i)
    let done = 0
    while i > 0 and done == 0
        let parent = (i - 1) / 2
        let cur = items[i]
        let par = items[parent]
        if cur[0] < par[0]
            _pq_swap(items, i, parent)
            i = parent
        else
            done = 1

// _pq_sift_down: move the pair at index i toward the leaves until the heap
// property holds. Only considers indices in [0, n).
fn _pq_sift_down(items, i, n)
    let done = 0
    while done == 0
        let smallest = i
        let left = 2 * i + 1
        let right = 2 * i + 2
        if left < n
            if items[left][0] < items[smallest][0]
                smallest = left
        if right < n
            if items[right][0] < items[smallest][0]
                smallest = right
        if smallest == i
            done = 1
        else
            _pq_swap(items, i, smallest)
            i = smallest

// pq_new: create and return an empty priority queue.
fn pq_new() -> dict
    let q = {}
    q["items"] = []
    return q

// pq_push: insert value with the given priority in O(log n) (lower priority
// number = popped first).
fn pq_push(pq, priority, value)
    let items = pq["items"]
    let pair = [priority, value]
    push(items, pair)
    _pq_sift_up(items, len(items) - 1)

// pq_pop: remove and return the value with the lowest priority, in O(log n).
// Returns 0 if the queue is empty.
fn pq_pop(pq)
    let items = pq["items"]
    let n = len(items)
    if n == 0
        return 0
    let top = items[0]
    if n == 1
        items.pop()
        return top[1]
    let last = items.pop()
    items[0] = last
    _pq_sift_down(items, 0, len(items))
    return top[1]

// pq_peek: return the value with the lowest priority without removing it.
// Returns 0 if the queue is empty.
fn pq_peek(pq)
    let items = pq["items"]
    if len(items) == 0
        return 0
    return items[0][1]

// pq_size: number of entries in the queue.
fn pq_size(pq) -> int
    return len(pq["items"])

// pq_is_empty: true if the queue has no entries.
fn pq_is_empty(pq) -> bool
    return len(pq["items"]) == 0
