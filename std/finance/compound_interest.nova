// std/finance/compound_interest.nova — Compound interest and related functions.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float consts defined inside fn bodies (module-level float consts truncate to int).
//   * All intermediate results bound to named `let` variables.
//   * Never return a bare multi-term float expression — single-exit named result.
//   * ABS OF FLOAT: if x < 0.0 { 0.0 - x } else { x }  — NOT abs().
//   * Integer coercion: n * 1.0 to convert integer to float for division/pow.
//
// API:
//   compound(principal, rate, years, freq)
//       Final amount with periodic compounding: P*(1 + r/freq)^(freq*years)
//   effective_rate(nominal, freq)
//       Annual effective rate from nominal: (1 + nom/freq)^freq - 1
//   rule_of_72(rate)
//       Approximate years to double at rate: 72 / (rate * 100)
//   continuous_compound(principal, rate, years)
//       Continuous compounding: P * e^(r*t)

// Compound interest — final amount with periodic compounding.
// formula: A = P * (1 + r/freq)^(freq * years)
// freq = compounding periods per year (1=annual, 2=semi-annual, 12=monthly, etc.)
fn compound(principal: float, rate: float, years: float, freq: float) -> float
    let r_per = rate / freq
    let base = 1.0 + r_per
    let n = freq * years
    let grown = pow(base, n)
    let result = principal * grown
    result

// Annual effective rate (EAR) from a nominal rate compounded freq times per year.
// formula: EAR = (1 + nom/freq)^freq - 1
fn effective_rate(nominal: float, freq: float) -> float
    let r_per = nominal / freq
    let base = 1.0 + r_per
    let compounded = pow(base, freq)
    let result = compounded - 1.0
    result

// Rule of 72: approximate years to double at a given annual rate.
// rate is a decimal fraction (e.g. 0.08 for 8%).
// formula: years = 72 / (rate * 100)
fn rule_of_72(rate: float) -> float
    let rate_pct = rate * 100.0
    let result = 72.0 / rate_pct
    result

// Continuous compounding — final amount.
// formula: A = P * e^(r * t)
fn continuous_compound(principal: float, rate: float, years: float) -> float
    let exponent = rate * years
    let growth = exp(exponent)
    let result = principal * growth
    result
