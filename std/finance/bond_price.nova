// std/finance/bond_price.nova — Bond pricing functions.
// LEAF — imports NOTHING.
//
// Public API:
//   bond_price(face, coupon_rate, ytm, periods) -> float
//       Present value of a fixed-coupon bond (annual, end-of-period coupons).
//       coupon = face * coupon_rate  (per period)
//       PV_coupons = coupon * (1 - (1+ytm)^-n) / ytm
//       PV_face    = face / (1+ytm)^n
//       Price      = PV_coupons + PV_face
//       At par (coupon_rate == ytm) returns exactly face.
//       Zero-YTM edge: price = coupon*periods + face (no discounting).
//
// All rates are decimal fractions (e.g. 0.05 for 5%).
// periods is number of annual periods (int).
// NOVA float-codegen: every intermediate result is bound to a named let
// before further arithmetic (avoids uninit-slot bug).

// _bp_pow — raise base to a non-negative integer exponent iteratively.
fn _bp_pow(base: float, exp: int) -> float
    let result = 1.0
    let i = 0
    while i < exp
        result = result * base
        i = i + 1
    result

// bond_price — present value of a fixed-coupon bond.
//   coupon = face * coupon_rate
//   PV_coupons = coupon * (1 - 1/(1+ytm)^n) / ytm
//   PV_face    = face / (1+ytm)^n
//   Price      = PV_coupons + PV_face
// Zero-YTM edge: price = coupon*n + face.
fn bond_price(face: float, coupon_rate: float, ytm: float, periods: int) -> float
    let coupon = face * coupon_rate
    if ytm == 0.0
        let total = coupon * (periods * 1.0) + face
        return total
    let disc = 1.0 + ytm
    let disc_n = _bp_pow(disc, periods)
    let pv_face = face / disc_n
    let annuity_factor = (1.0 - 1.0 / disc_n) / ytm
    let pv_coupons = coupon * annuity_factor
    let result = pv_coupons + pv_face
    result
