// std/finance/npv.nova — Net Present Value (NPV) and Profitability Index.
// LEAF — imports NOTHING.
//
// Public API:
//   npv_compute(rate, cashflows)                    -> float
//       Sum of cf[t] / (1+rate)^t for t=0..len-1.
//       cashflows[0] is at time t=0 (e.g. -initial_investment when negative).
//
//   npv_with_initial(rate, initial, cashflows)      -> float
//       Convenience: -initial + npv_compute(rate, cashflows).
//       cashflows here represent future inflows (t=0..len-1 relative to now),
//       while initial is subtracted as the upfront cost.
//
//   npv_profitability_index(rate, initial, cashflows) -> float
//       (npv_compute(rate, cashflows)) / initial.
//       PI > 1 means the project adds value; PI < 1 means it destroys value.
//       Returns 0.0 if initial is 0.
//
// All cash-flow lists hold float values.
// rate is a decimal fraction (e.g. 0.10 for 10%).
// epsilon 0.01 adequate for monetary assertions.
//
// NOVA float-codegen note: every pow/multi-step float result is bound to a
// named `let` before use to avoid the uninit-slot register-allocation bug.

// _npv_pow — raise base to a non-negative integer exponent.
// Returns 1.0 for exp=0.  Used to compute (1+rate)^t.
fn _npv_pow(base: float, exp: int) -> float
    let result = 1.0
    let i = 0
    while i < exp
        result = result * base
        i = i + 1
    result

// npv_compute — core NPV: sum cf[t]/(1+rate)^t for t=0..len-1.
fn npv_compute(rate: float, cashflows: list) -> float
    let n = len(cashflows)
    if n == 0
        return 0.0
    let disc = 1.0 + rate
    let total = 0.0
    let t = 0
    while t < n
        let cf = cashflows[t] * 1.0
        let denom = _npv_pow(disc, t)
        let pv = cf / denom
        total = total + pv
        t = t + 1
    total

// npv_with_initial — -initial + discounted cashflows starting at t=1.
// The initial outlay happens at t=0 (now) and is subtracted as a cost.
// cashflows[0] is at t=1, cashflows[1] at t=2, etc.
// Equivalent to npv_compute(rate, [-initial] ++ cashflows).
fn npv_with_initial(rate: float, initial: float, cashflows: list) -> float
    let n = len(cashflows)
    let disc = 1.0 + rate
    let total = 0.0 - initial
    let i = 0
    while i < n
        let cf = cashflows[i] * 1.0
        let denom = _npv_pow(disc, i + 1)
        let pv = cf / denom
        total = total + pv
        i = i + 1
    total

// npv_profitability_index — ratio of NPV of future flows to initial investment.
// PI = npv_compute(rate, cashflows) / initial.
// Returns 0.0 when initial == 0 to avoid division by zero.
fn npv_profitability_index(rate: float, initial: float, cashflows: list) -> float
    if initial == 0.0
        return 0.0
    let pv = npv_compute(rate, cashflows)
    let pi = pv / initial
    pi
