// std/finance/depreciation.nova — asset depreciation methods.
// dep_straight_line(cost, salvage, life)          -> float  annual depreciation
// dep_declining_balance(cost, salvage, life, year, factor) -> float  DB for a given year
// dep_syd(cost, salvage, life, year)              -> float  sum-of-years-digits for a year
// dep_units(cost, salvage, total_units, units_this_period) -> float  units-of-production
// dep_book_value_sl(cost, salvage, life, year)    -> float  straight-line book value after year

// Straight-line: equal charge each period.
fn dep_straight_line(cost, salvage, life) -> float
    let c = cost * 1.0
    let s = salvage * 1.0
    let l = life * 1.0
    let r = (c - s) / l
    r

// Declining-balance: a fixed rate applied to the remaining book value each year.
// rate = factor / life.  Depreciation is capped so book value never falls below salvage.
fn dep_declining_balance(cost, salvage, life, year, factor) -> float
    let c = cost * 1.0
    let s = salvage * 1.0
    let l = life * 1.0
    let f = factor * 1.0
    let rate = f / l
    // book value at start of this year = cost * (1-rate)^(year-1)
    let bv = c
    for i in 1..year
        bv -= bv * rate
    // depreciation this year, but not below salvage
    let dep = bv * rate
    let floor_dep = bv - s
    if floor_dep < 0.0
        floor_dep = 0.0
    if dep > floor_dep
        dep = floor_dep
    dep

// Sum-of-years-digits: accelerated method weighting earlier years more.
// SYD_sum = life*(life+1)/2.  Year y charge = (life-y+1)/SYD_sum * (cost-salvage).
fn dep_syd(cost, salvage, life, year) -> float
    let c = cost * 1.0
    let s = salvage * 1.0
    let l = life * 1.0
    let y = year * 1.0
    let syd_sum = l * (l + 1.0) / 2.0
    let numerator = l - y + 1.0
    let r = numerator / syd_sum * (c - s)
    r

// Units-of-production: charge proportional to actual usage.
fn dep_units(cost, salvage, total_units, units_this_period) -> float
    let c = cost * 1.0
    let s = salvage * 1.0
    let t = total_units * 1.0
    let u = units_this_period * 1.0
    let r = (c - s) / t * u
    r

// Straight-line book value after completing `year` full periods.
fn dep_book_value_sl(cost, salvage, life, year) -> float
    let c = cost * 1.0
    let annual = dep_straight_line(cost, salvage, life)
    let y = year * 1.0
    let r = c - annual * y
    r

// --- Canonical-name aliases (task-spec names) ---

// straight_line: alias for dep_straight_line.
fn straight_line(cost: float, salvage: float, life: int) -> float
    let r = dep_straight_line(cost, salvage, life)
    r

// declining_balance(cost, rate, year): book value at start of year minus book value at end.
// Book value after k years = cost * (1-rate)^k
// Depreciation in year y = BV_start - BV_end = cost*(1-rate)^(y-1) - cost*(1-rate)^y
//                        = cost*(1-rate)^(y-1) * rate
fn declining_balance(cost: float, rate: float, year: int) -> float
    let c = cost * 1.0
    let r = rate * 1.0
    // compute (1-rate)^(year-1) via loop
    let bv = c
    for i in 1..year
        bv -= bv * r
    let dep = bv * r
    dep

// sum_of_years: alias for dep_syd.
fn sum_of_years(cost: float, salvage: float, life: int, year: int) -> float
    let r = dep_syd(cost, salvage, life, year)
    r
