// std/finance/roi.nova — Return-on-investment metrics.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float consts defined inside fn bodies (module-level float consts truncate to int).
//   * All intermediate results bound to named `let` variables.
//   * Never return a bare multi-term float expression — single-exit named result.
//   * ABS OF FLOAT: (if x < 0.0 then 0.0 - x else x) — NOT abs().
//   * Integer division: coerce with *1.0 to get float division.
//   * NO single-line `if cond then stmt` — always block body.
//
// API (PREFIX: roi_):
//   roi_simple(gain, cost) -> float        simple ROI: (gain - cost) / cost
//   roi_cagr(begin, end, years) -> float   compound annual growth rate: (end/begin)^(1/years) - 1
//   roi_payback_period(initial, annual_cashflow) -> float  years to recoup: initial / annual_cashflow
//   roi_annualized(total_return, years) -> float  annualized return: (1 + total_return)^(1/years) - 1

// Simple ROI: fraction of cost gained (or lost).
// formula: (gain - cost) / cost
// A gain of 1500 on a cost of 1000 returns 0.5 (50%).
fn roi_simple(gain: float, cost: float) -> float
    let diff = gain - cost
    let result = diff / cost
    result

// Compound Annual Growth Rate.
// formula: (end / begin)^(1 / years) - 1
// Measures the mean annual growth rate over multiple years.
fn roi_cagr(begin: float, end: float, years: float) -> float
    let ratio = end / begin
    let one = 1.0
    let exponent = one / years
    let grown = pow(ratio, exponent)
    let result = grown - one
    result

// Simple payback period: how many years until initial investment is recovered.
// formula: initial / annual_cashflow
// Returns a fractional year count.
fn roi_payback_period(initial: float, annual_cashflow: float) -> float
    let result = initial / annual_cashflow
    result

// Annualized return from a total return over multiple years.
// formula: (1 + total_return)^(1 / years) - 1
// total_return is a decimal fraction (e.g. 0.5 = 50% total).
fn roi_annualized(total_return: float, years: float) -> float
    let one = 1.0
    let base = one + total_return
    let exponent = one / years
    let grown = pow(base, exponent)
    let result = grown - one
    result
