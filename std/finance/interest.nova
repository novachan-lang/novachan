// std/finance/interest.nova — Interest calculation functions.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float consts defined inside fn bodies (module-level float consts truncate to int).
//   * All intermediate results bound to named `let` variables.
//   * Never return a bare multi-term float expression — single-exit named result.
//   * ABS OF FLOAT: (if x < 0.0 then 0.0 - x else x) — NOT abs().
//   * Integer division: coerce with *1.0 to get float division.
//   * NO single-line `if cond then stmt` — always block body.
//
// API (PREFIX: fint_):
//   fint_simple(principal, rate, years) -> float   simple interest earned: P*r*t
//   fint_compound(principal, rate, years, periods) -> float   final amount: P*(1+r/m)^(m*t)
//   fint_effective_rate(nominal, periods) -> float  EAR: (1+nom/m)^m - 1
//   fint_continuous(principal, rate, years) -> float  final amount: P*e^(r*t)
//   fint_rule_of_72(rate) -> float  years to double: 72/(rate*100)

// Simple interest earned (NOT total amount).
// formula: I = P * r * t
fn fint_simple(principal: float, rate: float, years: float) -> float
    let interest = principal * rate * years
    interest

// Compound interest — returns FINAL AMOUNT (principal + interest).
// formula: A = P * (1 + r/m)^(m*t)
// periods = compounding frequency per year (1=annual, 12=monthly, etc.)
fn fint_compound(principal: float, rate: float, years: float, periods: float) -> float
    let r_per_period = rate / periods
    let n = periods * years
    let base = 1.0 + r_per_period
    let grown = pow(base, n)
    let result = principal * grown
    result

// Annual effective rate from a nominal rate compounded m times per year.
// formula: EAR = (1 + nom/m)^m - 1
fn fint_effective_rate(nominal: float, periods: float) -> float
    let r_per_period = nominal / periods
    let base = 1.0 + r_per_period
    let compounded = pow(base, periods)
    let ear = compounded - 1.0
    ear

// Continuous compounding — returns FINAL AMOUNT.
// formula: A = P * e^(r*t)
fn fint_continuous(principal: float, rate: float, years: float) -> float
    let exponent = rate * years
    let growth = exp(exponent)
    let result = principal * growth
    result

// Rule of 72: approximate years required to double at a given annual rate.
// rate is a decimal fraction (e.g. 0.08 for 8%).
// formula: years = 72 / (rate * 100)
fn fint_rule_of_72(rate: float) -> float
    let rate_pct = rate * 100.0
    let years = 72.0 / rate_pct
    years
