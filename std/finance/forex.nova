// std/finance/forex.nova — Foreign exchange (forex) utility functions.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float consts defined inside fn bodies.
//   * All intermediate results bound to named `let` variables.
//   * Never return a bare multi-term float expression.
//   * ABS OF FLOAT: if x < 0.0 { 0.0 - x } else { x }  — NOT abs().
//
// API:
//   fx_convert(amount, rate)           Convert amount at given rate: amount * rate
//   cross_rate(a_to_usd, b_to_usd)    Cross rate A/B: a_to_usd / b_to_usd
//   pip_value(lot_size, pip)           Value of one pip: lot_size * pip
//   spread(bid, ask)                   Bid-ask spread: ask - bid

// Convert an amount from currency A to currency B using the given exchange rate.
// result = amount * rate
fn fx_convert(amount: float, rate: float) -> float
    let result = amount * rate
    result

// Compute the cross rate between two currencies both quoted against USD.
// e.g. a_to_usd = EUR/USD = 1.10, b_to_usd = GBP/USD = 1.25
// cross = EUR/GBP = 1.10 / 1.25 = 0.88
fn cross_rate(a_to_usd: float, b_to_usd: float) -> float
    let result = a_to_usd / b_to_usd
    result

// Value of one pip for a given lot size.
// pip_value = lot_size * pip
fn pip_value(lot_size: float, pip: float) -> float
    let result = lot_size * pip
    result

// Bid-ask spread: the difference between ask and bid prices.
// spread = ask - bid
fn spread(bid: float, ask: float) -> float
    let result = ask - bid
    result
