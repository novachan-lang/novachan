// std/finance/option_greeks.nova — Black-Scholes option Greeks.
// LEAF — imports nothing.
//
// All float intermediate results are bound to named lets to avoid NOVA float-ABI
// issues (float returned from a fn and passed to another call may arrive as raw bits).
// pow(x, 1.0) is used to stabilize float values returned from helper functions.
//
// Greeks (standard Black-Scholes):
//   delta_call = N(d1)
//   delta_put  = N(d1) - 1
//   gamma      = phi(d1) / (S * sigma * sqrt(T))
//   vega       = S * phi(d1) * sqrt(T)
//   theta_call = -(S*phi(d1)*sigma)/(2*sqrt(T)) - r*K*exp(-r*T)*N(d2)
//   rho_call   = K*T*exp(-r*T)*N(d2)

// _og_erf — Abramowitz-Stegun 7.1.26 approximation, max |error| ~ 2.5e-5.
fn _og_erf(x: float) -> float
    let neg = 0
    let ax = x
    if x < 0.0
        neg = 1
        ax = -x
    let p = 0.47047
    let a1 = 0.3480242
    let a2 = 0.0958798
    let a3 = 0.7478556
    let t = 1.0 / (1.0 + p * ax)
    let t2 = t * t
    let t3 = t2 * t
    let poly = a1 * t - a2 * t2 + a3 * t3
    let ax2 = ax * ax
    let e = exp(0.0 - ax2)
    let r = 1.0 - poly * e
    if neg == 1
        let neg_r = 0.0 - r
        return neg_r
    return r

// _og_ncdf — standard normal CDF via erf.
fn _og_ncdf(x: float) -> float
    let xstab = pow(x, 1.0)
    let sq2 = sqrt(2.0)
    let arg = xstab / sq2
    let er = _og_erf(arg)
    let er_stab = pow(er, 1.0)
    let r = 0.5 * (1.0 + er_stab)
    r

// _og_npdf — standard normal PDF: phi(x) = exp(-x^2/2) / sqrt(2*pi).
fn _og_npdf(x: float) -> float
    let xstab = pow(x, 1.0)
    let pi2 = 6.283185307179586
    let sq2pi = sqrt(pi2)
    let x2 = xstab * xstab
    let e = exp(0.0 - 0.5 * x2)
    let r = e / sq2pi
    r

// delta_call — N(d1); rate of change of call price w.r.t. underlying, in [0,1].
fn delta_call(S: float, K: float, T: float, r: float, sigma: float) -> float
    let sqrtT = sqrt(T)
    let logSK = log(S / K)
    let half_var = 0.5 * sigma * sigma
    let d1 = (logSK + (r + half_var) * T) / (sigma * sqrtT)
    let d1s = pow(d1, 1.0)
    let nd1 = _og_ncdf(d1s)
    let result = pow(nd1, 1.0)
    result

// delta_put — N(d1) - 1; rate of change of put price w.r.t. underlying, in [-1,0].
fn delta_put(S: float, K: float, T: float, r: float, sigma: float) -> float
    let sqrtT = sqrt(T)
    let logSK = log(S / K)
    let half_var = 0.5 * sigma * sigma
    let d1 = (logSK + (r + half_var) * T) / (sigma * sqrtT)
    let d1s = pow(d1, 1.0)
    let nd1 = _og_ncdf(d1s)
    let nd1s = pow(nd1, 1.0)
    let result = nd1s - 1.0
    result

// gamma — phi(d1)/(S*sigma*sqrt(T)); same for calls and puts, always positive.
fn gamma(S: float, K: float, T: float, r: float, sigma: float) -> float
    let sqrtT = sqrt(T)
    let logSK = log(S / K)
    let half_var = 0.5 * sigma * sigma
    let d1 = (logSK + (r + half_var) * T) / (sigma * sqrtT)
    let d1s = pow(d1, 1.0)
    let phi = _og_npdf(d1s)
    let phis = pow(phi, 1.0)
    let denom = S * sigma * sqrtT
    let result = phis / denom
    result

// vega — S*phi(d1)*sqrt(T); price change per unit change in sigma.
fn vega(S: float, K: float, T: float, r: float, sigma: float) -> float
    let sqrtT = sqrt(T)
    let logSK = log(S / K)
    let half_var = 0.5 * sigma * sigma
    let d1 = (logSK + (r + half_var) * T) / (sigma * sqrtT)
    let d1s = pow(d1, 1.0)
    let phi = _og_npdf(d1s)
    let phis = pow(phi, 1.0)
    let result = S * phis * sqrtT
    result

// theta_call — time decay of call option price (per year, typically negative).
//   = -(S*phi(d1)*sigma)/(2*sqrt(T)) - r*K*exp(-r*T)*N(d2)
fn theta_call(S: float, K: float, T: float, r: float, sigma: float) -> float
    let sqrtT = sqrt(T)
    let logSK = log(S / K)
    let half_var = 0.5 * sigma * sigma
    let d1 = (logSK + (r + half_var) * T) / (sigma * sqrtT)
    let d2 = d1 - sigma * sqrtT
    let d1s = pow(d1, 1.0)
    let d2s = pow(d2, 1.0)
    let phi = _og_npdf(d1s)
    let phis = pow(phi, 1.0)
    let nd2 = _og_ncdf(d2s)
    let nd2s = pow(nd2, 1.0)
    let disc = exp(0.0 - r * T)
    let term1 = 0.0 - (S * phis * sigma) / (2.0 * sqrtT)
    let term2 = 0.0 - r * K * disc * nd2s
    let result = term1 + term2
    result

// rho_call — sensitivity to interest rate: K*T*exp(-r*T)*N(d2).
fn rho_call(S: float, K: float, T: float, r: float, sigma: float) -> float
    let sqrtT = sqrt(T)
    let logSK = log(S / K)
    let half_var = 0.5 * sigma * sigma
    let d1 = (logSK + (r + half_var) * T) / (sigma * sqrtT)
    let d2 = d1 - sigma * sqrtT
    let d2s = pow(d2, 1.0)
    let nd2 = _og_ncdf(d2s)
    let nd2s = pow(nd2, 1.0)
    let disc = exp(0.0 - r * T)
    let result = K * T * disc * nd2s
    result
