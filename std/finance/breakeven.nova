// std/finance/breakeven.nova — Break-even analysis functions.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float consts defined inside fn bodies (module-level float consts truncate to int).
//   * All intermediate results bound to named `let` variables.
//   * Never return a bare multi-term float expression — single-exit named result.
//   * ABS OF FLOAT: (if x < 0.0 then 0.0 - x else x) — NOT abs().
//   * Integer division: coerce with *1.0 to get float division.
//   * NO single-line `if cond then stmt` — always block body.
//
// API (PREFIX: bev_):
//   bev_units(fixed_cost, price, vc) -> float
//       Break-even volume in units: fixed / (price - vc)
//   bev_revenue(fixed_cost, price, vc) -> float
//       Break-even revenue in dollars: bev_units * price
//   bev_margin(price, vc) -> float
//       Contribution margin per unit: price - vc
//   bev_margin_ratio(price, vc) -> float
//       Contribution margin ratio: (price - vc) / price
//   bev_target_profit_units(fixed, price, vc, target) -> float
//       Units needed to hit a target profit: (fixed + target) / (price - vc)

// Break-even volume in units.
// formula: Q = fixed_cost / (price - variable_cost)
fn bev_units(fixed_cost: float, price: float, vc: float) -> float
    let cm = price - vc
    let result = fixed_cost / cm
    result

// Break-even revenue.
// formula: R = bev_units * price
fn bev_revenue(fixed_cost: float, price: float, vc: float) -> float
    let cm = price - vc
    let units = fixed_cost / cm
    let result = units * price
    result

// Contribution margin per unit.
// formula: CM = price - variable_cost
fn bev_margin(price: float, vc: float) -> float
    let result = price - vc
    result

// Contribution margin ratio (as a decimal, e.g. 0.4 = 40%).
// formula: CMR = (price - vc) / price
fn bev_margin_ratio(price: float, vc: float) -> float
    let cm = price - vc
    let result = cm / price
    result

// Units required to achieve a target profit.
// formula: Q = (fixed + target_profit) / (price - vc)
fn bev_target_profit_units(fixed: float, price: float, vc: float, target: float) -> float
    let numerator = fixed + target
    let cm = price - vc
    let result = numerator / cm
    result
