// std/finance/black_scholes.nova — Black-Scholes European option pricing.
// LEAF — imports nothing.
//
// Inline erf approximation: Abramowitz & Stegun formula 7.1.26
//   erf(x) ≈ 1 - (a1*t + a2*t^2 + a3*t^3)*exp(-x^2)  where t = 1/(1+0.47047*x)
//   Max error |ε| <= 2.5e-5.  For x < 0 use antisymmetry: erf(-x) = -erf(x).
//
// normal_cdf(x) = 0.5 * (1 + erf(x / sqrt(2)))
//
// Black-Scholes formulas:
//   d1 = (ln(S/K) + (r + 0.5*σ²)*T) / (σ*√T)
//   d2 = d1 - σ*√T
//   call = S*N(d1) - K*exp(-r*T)*N(d2)
//   put  = K*exp(-r*T)*N(-d2) - S*N(-d1)

// _bs_erf — erf approximation, Abramowitz-Stegun 7.1.26
fn _bs_erf(x: float) -> float
    let neg = 0
    let ax = x
    if x < 0.0
        neg = 1
        ax = -x
    let p = 0.47047
    let a1 = 0.3480242
    let a2 = 0.0958798
    let a3 = 0.7478556
    let t = 1.0 / (1.0 + p * ax)
    let t2 = t * t
    let t3 = t2 * t
    let poly = a1 * t - a2 * t2 + a3 * t3
    let ax2 = ax * ax
    let e = exp(0.0 - ax2)
    let r = 1.0 - poly * e
    if neg == 1
        return 0.0 - r
    return r

// _bs_ncdf — standard normal CDF via erf
fn _bs_ncdf(x: float) -> float
    let sq2 = sqrt(2.0)
    let arg = x / sq2
    let er = _bs_erf(arg)
    let r = 0.5 * (1.0 + er)
    r

// bs_call — Black-Scholes European call option price.
//   S     = current stock price
//   K     = strike price
//   T     = time to expiry in years
//   r     = risk-free rate (continuously compounded, per year)
//   sigma = annual volatility
fn bs_call(S: float, K: float, T: float, r: float, sigma: float) -> float
    let sqrtT = sqrt(T)
    let logSK = log(S / K)
    let half_var = 0.5 * sigma * sigma
    let d1 = (logSK + (r + half_var) * T) / (sigma * sqrtT)
    let d2 = d1 - sigma * sqrtT
    let nd1 = _bs_ncdf(d1)
    let nd2 = _bs_ncdf(d2)
    let disc = exp(0.0 - r * T)
    let result = S * nd1 - K * disc * nd2
    result

// bs_put — Black-Scholes European put option price.
//   Uses put-call parity: P = C - S + K*exp(-r*T)
//   Equivalently: P = K*exp(-r*T)*N(-d2) - S*N(-d1)
fn bs_put(S: float, K: float, T: float, r: float, sigma: float) -> float
    let sqrtT = sqrt(T)
    let logSK = log(S / K)
    let half_var = 0.5 * sigma * sigma
    let d1 = (logSK + (r + half_var) * T) / (sigma * sqrtT)
    let d2 = d1 - sigma * sqrtT
    let nd1_neg = _bs_ncdf(0.0 - d1)
    let nd2_neg = _bs_ncdf(0.0 - d2)
    let disc = exp(0.0 - r * T)
    let result = K * disc * nd2_neg - S * nd1_neg
    result
