// std/finance/bond_duration.nova — Bond duration (interest-rate sensitivity) functions.
// LEAF — imports NOTHING.
//
// Public API:
//   macaulay_duration(face, coupon_rate, ytm, periods) -> float
//       Macaulay duration: weighted average time of bond cash flows.
//       D = (1/Price) * sum_{t=1}^{n} [ t * PV(CF_t) ]
//       where CF_t = face*coupon_rate for t<n, CF_n = face*coupon_rate + face.
//       For a zero-coupon bond: D == periods (all cash flow at maturity).
//       For a coupon bond: D < periods (early coupons reduce weighted average).
//       Returns 0.0 if periods==0 or price==0.
//
//   modified_duration(mac_dur, ytm, freq) -> float
//       Modified duration: measures % price change per 1% yield move.
//       MD = mac_dur / (1 + ytm/freq)
//       freq is compounding frequency per year (1 for annual, 2 for semi-annual).
//       Always less than Macaulay duration for ytm > 0.
//
// All rates are decimal fractions (e.g. 0.05 for 5%).
// periods is number of annual periods (int).
// NOVA float-codegen: every intermediate result is bound to a named let
// before further arithmetic (avoids uninit-slot bug).

// _bd_pow — raise base to a non-negative integer exponent iteratively.
fn _bd_pow(base: float, exp: int) -> float
    let result = 1.0
    let i = 0
    while i < exp
        result = result * base
        i = i + 1
    result

// _bd_price — internal bond price helper (avoids cross-module import).
//   PV_coupons = C * (1 - 1/(1+ytm)^n) / ytm
//   PV_face    = face / (1+ytm)^n
// Zero-YTM edge: price = C*n + face.
fn _bd_price(face: float, coupon_rate: float, ytm: float, periods: int) -> float
    let coupon = face * coupon_rate
    if ytm == 0.0
        let total = coupon * (periods * 1.0) + face
        return total
    let disc = 1.0 + ytm
    let disc_n = _bd_pow(disc, periods)
    let pv_face = face / disc_n
    let annuity_factor = (1.0 - 1.0 / disc_n) / ytm
    let pv_coupons = coupon * annuity_factor
    let result = pv_coupons + pv_face
    result

// macaulay_duration — weighted average time of bond cash flows (in periods).
//   D = (1/Price) * sum_{t=1}^{n} [ t * PV(CF_t) ]
// Cash flows: coupon at each t=1..n-1, coupon+face at t=n.
// Zero-YTM edge: each PV(CF_t) = CF_t (no discounting).
// Zero-coupon bond: all cash flow at t=n => D == n exactly.
fn macaulay_duration(face: float, coupon_rate: float, ytm: float, periods: int) -> float
    if periods == 0
        return 0.0
    let price = _bd_price(face, coupon_rate, ytm, periods)
    if price == 0.0
        return 0.0
    let coupon = face * coupon_rate
    let disc = 1.0 + ytm
    let weighted_sum = 0.0
    let t = 1
    while t <= periods
        let disc_t = _bd_pow(disc, t)
        let cf = coupon
        let pv_cf = cf / disc_t
        let contrib = (t * 1.0) * pv_cf
        weighted_sum = weighted_sum + contrib
        t = t + 1
    // Add weighted PV of face redemption at period n
    let disc_n = _bd_pow(disc, periods)
    let pv_face = face / disc_n
    let face_contrib = (periods * 1.0) * pv_face
    weighted_sum = weighted_sum + face_contrib
    let result = weighted_sum / price
    result

// modified_duration — price sensitivity per 1% yield change.
//   MD = mac_dur / (1 + ytm / freq)
// freq = compounding periods per year (1 = annual, 2 = semi-annual, etc.)
// Always MD < mac_dur for ytm > 0 and freq > 0.
fn modified_duration(mac_dur: float, ytm: float, freq: float) -> float
    let denom = 1.0 + ytm / freq
    let result = mac_dur / denom
    result
