// std/rational/rfrac_arith.nova — Arithmetic on exact rationals.
// LEAF — imports NOTHING.
//
// Representation (same as rfrac_core, self-contained):
//   rational = [num, den] in lowest terms, den > 0. Zero=[0,1]. Invalid=[0,0].
//
// All results are automatically reduced to lowest terms.
//
// Public API (prefix rfa_):
//   rfa_add(a, b)        -> rational  a + b
//   rfa_sub(a, b)        -> rational  a - b
//   rfa_mul(a, b)        -> rational  a * b
//   rfa_div(a, b)        -> rational  a / b  (b!=0; else [0,0])
//   rfa_pow(a, e)        -> rational  a^e (e integer; e<0 -> reciprocal; e==0 -> [1,1])
//   rfa_inv(a)           -> rational  1/a (alias for reciprocal; [0,0] if zero)
//   rfa_addmany(list)    -> rational  sum of a list of rationals
//   rfa_mulmany(list)    -> rational  product of a list of rationals

// _rfa_gcd — Euclidean GCD on absolute values (private).
fn _rfa_gcd(a: int, b: int) -> int
    let u = -a if a < 0 else a
    let v = -b if b < 0 else b
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// _rfa_make — reduce [n, d] to lowest terms, sign to numerator, den > 0.
// d == 0 -> [0, 0].
fn _rfa_make(n: int, d: int) -> list
    if d == 0
        return [0, 0]
    let num = -n if d < 0 else n
    let den = -d if d < 0 else d
    if num == 0
        return [0, 1]
    let an = -num if num < 0 else num
    let g = _rfa_gcd(an, den)
    [num / g, den / g]

// rfa_add — add two rationals: a/b + c/d = (a*d + c*b) / (b*d), then reduce.
// Cross-reduces intermediate factors to keep magnitudes small.
fn rfa_add(a: list, b: list) -> list
    let an = a[0]
    let ad = a[1]
    let bn = b[0]
    let bd = b[1]
    // guard invalid inputs
    if ad == 0 or bd == 0
        return [0, 0]
    // reduce denominator pair first: g = gcd(ad, bd)
    let g = _rfa_gcd(ad, bd)
    let ad_r = ad / g
    let bd_r = bd / g
    // new numerator: an * bd_r + bn * ad_r
    let top = an * bd_r + bn * ad_r
    // new denominator: ad * bd_r
    let bot = ad * bd_r
    _rfa_make(top, bot)

// rfa_sub — subtract two rationals: a - b = a + (-b).
fn rfa_sub(a: list, b: list) -> list
    let bn = b[0]
    let bd = b[1]
    rfa_add(a, [-bn, bd])

// rfa_mul — multiply two rationals: (an/ad) * (bn/bd) = (an*bn) / (ad*bd), reduced.
// Cross-reduces before multiplying to prevent overflow.
fn rfa_mul(a: list, b: list) -> list
    let an = a[0]
    let ad = a[1]
    let bn = b[0]
    let bd = b[1]
    if ad == 0 or bd == 0
        return [0, 0]
    // cross-reduce: gcd(an, bd) and gcd(bn, ad) before multiplying
    let aan = -an if an < 0 else an
    let abn = -bn if bn < 0 else bn
    let g1 = _rfa_gcd(aan, bd)
    let g2 = _rfa_gcd(abn, ad)
    let top = (an / g1) * (bn / g2)
    let bot = (ad / g2) * (bd / g1)
    _rfa_make(top, bot)

// rfa_div — divide two rationals: a / b = a * (bd/bn), reduced.
// Returns [0, 0] if b is zero.
fn rfa_div(a: list, b: list) -> list
    let bn = b[0]
    let bd = b[1]
    if bd == 0 or bn == 0
        return [0, 0]
    // reciprocal of b, then multiply; fix sign: if bn was negative, bd/bn flips sign
    let rb_fixed = _rfa_make(bd, bn)
    rfa_mul(a, rb_fixed)

// rfa_pow — raise rational a to integer exponent e.
// e == 0 -> [1, 1]. e < 0 -> reciprocal of a^(-e).
fn rfa_pow(a: list, e: int) -> list
    if e == 0
        return [1, 1]
    let exp = e
    let base = a
    if exp < 0
        // compute reciprocal of a first
        let an = a[0]
        let ad = a[1]
        if an == 0
            return [0, 0]
        base = _rfa_make(ad, an)
        exp = -exp
    // fast exponentiation by squaring
    let result = [1, 1]
    for i in 0..exp
        result = rfa_mul(result, base)
    result

// rfa_inv — multiplicative inverse of a rational (1/a); [0,0] if a is zero.
fn rfa_inv(a: list) -> list
    let an = a[0]
    let ad = a[1]
    if ad == 0 or an == 0
        return [0, 0]
    _rfa_make(ad, an)

// rfa_addmany — sum a list of rationals; empty list returns [0, 1].
fn rfa_addmany(lst: list) -> list
    let acc = [0, 1]
    for r in lst
        acc = rfa_add(acc, r)
    acc

// rfa_mulmany — product of a list of rationals; empty list returns [1, 1].
fn rfa_mulmany(lst: list) -> list
    let acc = [1, 1]
    for r in lst
        acc = rfa_mul(acc, r)
    acc
