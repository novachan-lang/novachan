// std/rational/rfrac_mixed.nova — Mixed number representation for rationals.
// All public functions use the rfm_ prefix.  LEAF — imports NOTHING.
//
// Representation: rational = [num, den] in lowest terms, den>0.
//   Zero = [0,1].  Invalid (den==0) = [0,0].
//
// Mixed number: [whole, frac_num, frac_den] where 0 <= frac_num < frac_den,
//   sign is carried on 'whole', and frac_num/frac_den is always non-negative.
//   Examples: 7/4 -> [1, 3, 4];  -7/4 -> [-1, 3, 4];  3/4 -> [0, 3, 4];  2 -> [2, 0, 1].
//
// Public API:
//   rfm_to_mixed(r)          -> [whole, frac_num, frac_den]
//   rfm_from_mixed(w, n, d)  -> rational  (magnitude |w| + n/d, sign of w)
//   rfm_to_string(r)         -> string  '1 3/4' / '-1 3/4' / '3/4' / '5'
//   rfm_whole_part(r)        -> int  truncated toward zero
//   rfm_proper_part(r)       -> rational  signed proper fractional remainder
//
// KNOWN ANSWERS (hand-verified):
//   rfm_to_mixed([7,4])       = [1,3,4]
//   rfm_to_mixed([-7,4])      = [-1,3,4]
//   rfm_to_mixed([3,4])       = [0,3,4]
//   rfm_to_mixed([8,4])       = [2,0,1]
//   rfm_from_mixed(1,3,4)     = [7,4]
//   rfm_from_mixed(-1,3,4)    = [-7,4]
//   rfm_to_string([7,4])      = '1 3/4'
//   rfm_to_string([5,1])      = '5'
//   rfm_to_string([3,4])      = '3/4'
//   rfm_to_string([-7,4])     = '-1 3/4'
//   rfm_whole_part([7,4])     = 1

// _gcd — Euclidean GCD on absolute values; result >= 0.
fn _gcd(a: int, b: int) -> int
    let aa = a
    if aa < 0
        aa = 0 - aa
    let bb = b
    if bb < 0
        bb = 0 - bb
    let done = 0
    while done == 0
        if bb == 0
            done = 1
        if done == 0
            let tmp = bb
            bb = aa - (aa / bb) * bb
            aa = tmp
    aa

// _make — reduce n/d to lowest terms with den>0.  den==0 -> [0,0].
fn _make(n: int, d: int) -> list
    if d == 0
        return [0, 0]
    let sn = n
    let sd = d
    if sd < 0
        sn = 0 - sn
        sd = 0 - sd
    if sn == 0
        return [0, 1]
    let g = _gcd(sn, sd)
    [sn / g, sd / g]

// rfm_to_mixed — convert rational [num, den] to mixed number [whole, frac_num, frac_den].
// The fractional part is always non-negative (0 <= frac_num < frac_den).
// Sign is carried on whole; frac_num and frac_den are always >= 0 with frac_den >= 1.
fn rfm_to_mixed(r: list) -> list
    let rn = r[0]
    let rd = r[1]
    if rd == 0
        return [0, 0, 0]
    // Truncate toward zero to get whole part
    let whole = rn / rd
    // Remainder: rn - whole*rd  (may be negative for negative rationals)
    let rem = rn - whole * rd
    // Make remainder non-negative: for negative rationals rem is negative
    if rem < 0
        rem = 0 - rem
    // Reduce the fractional part
    if rem == 0
        return [whole, 0, 1]
    let g = _gcd(rem, rd)
    let fn2 = rem / g
    let fd = rd / g
    [whole, fn2, fd]

// rfm_from_mixed — convert mixed number to rational.
// Magnitude = |w| + n/d, sign determined by w (negative if w<0, zero if w==0 and n==0).
fn rfm_from_mixed(w: int, n: int, d: int) -> list
    if d == 0
        return [0, 0]
    let aw = w
    if aw < 0
        aw = 0 - aw
    // magnitude numerator = aw*d + n
    let mag_n = aw * d + n
    let mag_d = d
    let result_n = mag_n
    if w < 0
        result_n = 0 - mag_n
    _make(result_n, mag_d)

// rfm_to_string — format rational as mixed number string.
// '1 3/4' for improper, '5' for integer, '3/4' for proper, '-3/4' for negative proper,
// '-1 3/4' for negative with whole part.
fn rfm_to_string(r: list) -> string
    let rn = r[0]
    let rd = r[1]
    if rd == 0
        return "undefined"
    let m = rfm_to_mixed(r)
    let whole = m[0]
    let fn2 = m[1]
    let fd = m[2]
    // Determine if the original rational is negative (for purely-fractional case)
    let neg = 0
    if rn < 0
        neg = 1
    // Pure integer?
    if fn2 == 0
        return str(whole)
    // Purely fractional (whole == 0): check original sign
    if whole == 0
        if neg == 1
            return "-" + str(fn2) + "/" + str(fd)
        return str(fn2) + "/" + str(fd)
    // Negative whole with fraction?
    if whole < 0
        let aw = 0 - whole
        return "-" + str(aw) + " " + str(fn2) + "/" + str(fd)
    // Positive with fraction
    str(whole) + " " + str(fn2) + "/" + str(fd)

// rfm_whole_part — integer part of r, truncated toward zero.
fn rfm_whole_part(r: list) -> int
    let rn = r[0]
    let rd = r[1]
    if rd == 0
        return 0
    rn / rd

// rfm_proper_part — signed proper fractional remainder of r.
// Result has |rfm_proper_part(r)| < 1 and same sign as r (or zero).
fn rfm_proper_part(r: list) -> list
    let rn = r[0]
    let rd = r[1]
    if rd == 0
        return [0, 0]
    let whole = rn / rd
    let rem_n = rn - whole * rd
    if rem_n == 0
        return [0, 1]
    _make(rem_n, rd)
