// std/rational/rfrac_convert.nova — Float bridge and rounding for exact rationals.
// LEAF — imports NOTHING.
//
// Rational representation: [num, den] of int, den > 0, gcd(|num|,den)=1.
// Zero = [0,1]. Invalid/undefined = [0,0].
//
// Public API (prefix rfv_):
//   rfv_to_float(r)           -> float    convert rational to float
//   rfv_from_float(x, maxden) -> rational best rational approximation via continued fractions
//   rfv_floor(r)              -> int      floor (correct for negatives)
//   rfv_ceil(r)               -> int      ceiling
//   rfv_round(r)              -> int      round half away from zero
//   rfv_trunc(r)              -> int      truncate toward zero
//   rfv_fractional_part(r)    -> rational r - floor(r), always in [0,1)

// _rfv_gcd — Euclidean GCD on absolute values.
fn _rfv_gcd(a, b)
    let u = a
    if u < 0
        u = 0 - u
    let v = b
    if v < 0
        v = 0 - v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// _rfv_make — build canonical rational [n,d] in lowest terms with den > 0.
// Invalid input (d==0) returns [0,0].
fn _rfv_make(n, d)
    let out = []
    if d == 0
        out.push(0)
        out.push(0)
        return out
    let num = n
    let den = d
    if den < 0
        num = 0 - num
        den = 0 - den
    if num == 0
        out.push(0)
        out.push(1)
        return out
    let an = num
    if an < 0
        an = 0 - an
    let g = _rfv_gcd(an, den)
    out.push(num / g)
    out.push(den / g)
    out

// _rfv_float_floor — compute floor of a non-negative float by subtracting 1.0 in a loop.
// Only used internally for small values (integer parts of CF coefficients, typically <1000).
fn _rfv_float_floor(x)
    let count = 0
    let v = x
    while v >= 1.0
        v = v - 1.0
        count = count + 1
    count

// rfv_to_float — convert rational r=[num,den] to float.
// Binds each sub-expression to a named let to avoid NOVA float-codegen hazards.
fn rfv_to_float(r)
    let n = r[0]
    let d = r[1]
    let fn_ = n * 1.0
    let fd = d * 1.0
    let res = fn_ / fd
    res

// rfv_from_float — best rational approximation to float x with denominator <= maxden.
// Uses the continued-fraction convergent (h/k) recurrence.
// Handles negative x by computing for |x| then restoring sign.
// Returns [0,1] for x=0 or maxden<1. Exact for terminating binary decimals.
fn rfv_from_float(x, maxden)
    let out = []
    if maxden < 1
        out.push(0)
        out.push(1)
        return out
    // Tolerance for "remainder is zero"
    let tol = 0.0000001
    // Extract sign and work with absolute value
    let xabs = x
    if xabs < 0.0
        xabs = 0.0 - xabs
    let sign = 1
    if x < 0.0
        sign = 0 - 1
    // Initial CF coefficient a0 = floor(xabs)
    let a0i = _rfv_float_floor(xabs)
    let remainder = xabs - a0i * 1.0
    // Initialize h/k recurrence: p_{-1}=1 q_{-1}=0; p_0=a0 q_0=1
    let h_prev = 1
    let k_prev = 0
    let h_curr = a0i
    let k_curr = 1
    let best_h = h_curr
    let best_k = k_curr
    let done = 0
    while done == 0
        // Check if remainder is essentially zero => terminate
        let rem_abs = remainder
        if rem_abs < 0.0
            rem_abs = 0.0 - rem_abs
        if rem_abs < tol
            done = 1
        if done == 0
            // Next CF coefficient: a_i = floor(1/remainder)
            let inv_rem = 1.0 / remainder
            let ai_val = _rfv_float_floor(inv_rem)
            if ai_val < 1
                ai_val = 1
            // Next convergent
            let h_new = ai_val * h_curr + h_prev
            let k_new = ai_val * k_curr + k_prev
            if k_new > maxden
                done = 1
            if done == 0
                best_h = h_new
                best_k = k_new
                h_prev = h_curr
                k_prev = k_curr
                h_curr = h_new
                k_curr = k_new
                // Update remainder: 1/remainder - a_i
                let new_rem = inv_rem - ai_val * 1.0
                remainder = new_rem
    // Restore sign to numerator
    let result_n = best_h
    if sign < 0
        result_n = 0 - best_h
    _rfv_make(result_n, best_k)

// rfv_floor — floor(num/den), correct for negative numerators.
// NOVA integer division truncates toward zero; for negatives we subtract 1 if not exact.
fn rfv_floor(r)
    let n = r[0]
    let d = r[1]
    let q = n / d
    if n < 0
        if q * d != n
            q = q - 1
    q

// rfv_ceil — ceiling(num/den), correct for all signs.
// ceil(n/d) = trunc(n/d) + 1 if there is a positive remainder, else trunc(n/d).
fn rfv_ceil(r)
    let n = r[0]
    let d = r[1]
    let q = n / d
    let rem = n - q * d
    if rem > 0
        q = q + 1
    q

// rfv_round — round half away from zero.
// Uses: round(n/d) = floor(|n|/d + 1/2) * sign(n)
//                  = floor((2*|n| + d) / (2*d)) * sign(n)
fn rfv_round(r)
    let n = r[0]
    let d = r[1]
    let an = n
    let sign = 1
    if n < 0
        an = 0 - n
        sign = 0 - 1
    // floor((2*an + d) / (2*d))
    let num2 = 2 * an + d
    let den2 = 2 * d
    let q = num2 / den2
    q * sign

// rfv_trunc — truncate toward zero (plain integer division).
fn rfv_trunc(r)
    let n = r[0]
    let d = r[1]
    n / d

// rfv_fractional_part — r - floor(r), always in [0,1).
// fractional_part(n/d) = (n - floor(n/d)*d) / d
fn rfv_fractional_part(r)
    let n = r[0]
    let d = r[1]
    let f = rfv_floor(r)
    let num = n - f * d
    _rfv_make(num, d)
