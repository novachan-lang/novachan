// std/rational/rfrac_core.nova — Foundation for exact rational arithmetic.
// LEAF — imports NOTHING.
//
// Representation: every rational is a 2-element list [num, den] of int,
// ALWAYS in lowest terms: gcd(|num|, den) == 1, den > 0.
// Zero is [0, 1].  An invalid/undefined value (e.g. division by zero) is [0, 0].
//
// Public API (prefix rf_):
//   rf_gcd(a, b)       -> int      Euclidean GCD on absolutes
//   rf_make(n, d)      -> rational reduce + sign to numerator; d==0 -> [0,0]
//   rf_num(r)          -> int      numerator
//   rf_den(r)          -> int      denominator
//   rf_neg(r)          -> rational negate
//   rf_abs(r)          -> rational absolute value
//   rf_reciprocal(r)   -> rational swap num/den; [0,0] if zero
//   rf_sign(r)         -> int      -1, 0, or 1
//   rf_is_zero(r)      -> bool     true iff num == 0 (and den != 0)
//   rf_is_integer(r)   -> bool     true iff den == 1 after reduction
//   rf_is_valid(r)     -> bool     true iff den != 0
//   rf_from_int(n)     -> rational [n, 1]
//   rf_to_string(r)    -> string   integers show as "5"; fractions as "3/4" or "-3/4"

// rf_gcd — Euclidean GCD of two integers (operates on their absolute values).
// gcd(0, 0) == 0 by convention.
fn rf_gcd(a: int, b: int) -> int
    let u = -a if a < 0 else a
    let v = -b if b < 0 else b
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// rf_make — construct a reduced rational from numerator n and denominator d.
// Sign is moved to the numerator; den is always positive.
// Returns [0, 0] when d == 0.
fn rf_make(n: int, d: int) -> list
    if d == 0
        return [0, 0]
    // move sign to numerator; make denominator positive
    let num = -n if d < 0 else n
    let den = -d if d < 0 else d
    if num == 0
        return [0, 1]
    let an = -num if num < 0 else num
    let g = rf_gcd(an, den)
    [num / g, den / g]

// rf_num — extract numerator from a rational.
fn rf_num(r: list) -> int
    r[0]

// rf_den — extract denominator from a rational.
fn rf_den(r: list) -> int
    r[1]

// rf_neg — negate a rational; [0,0] stays [0,0].
fn rf_neg(r: list) -> list
    let num = r[0]
    let den = r[1]
    if den == 0
        return [0, 0]
    [-num, den]

// rf_abs — absolute value of a rational.
fn rf_abs(r: list) -> list
    let num = r[0]
    let den = r[1]
    if den == 0
        return [0, 0]
    let an = -num if num < 0 else num
    [an, den]

// rf_reciprocal — swap numerator and denominator.
// Returns [0, 0] if the rational is zero (reciprocal undefined).
fn rf_reciprocal(r: list) -> list
    let num = r[0]
    let den = r[1]
    if den == 0 or num == 0
        return [0, 0]
    // num and den are already coprime; just swap, then fix sign
    // if original num was negative, after swap the new den (old num) is negative
    // rf_make will fix the sign
    rf_make(den, num)

// rf_sign — returns -1 if negative, 0 if zero, 1 if positive.
fn rf_sign(r: list) -> int
    let num = r[0]
    let den = r[1]
    if den == 0
        return 0
    if num < 0
        return -1
    if num > 0
        return 1
    0

// rf_is_zero — true iff the rational is zero (num == 0, den != 0).
fn rf_is_zero(r: list) -> bool
    let den = r[1]
    if den == 0
        return false
    r[0] == 0

// rf_is_integer — true iff the rational is a whole number (den == 1 after reduction).
fn rf_is_integer(r: list) -> bool
    r[1] == 1

// rf_is_valid — true iff the rational is a valid number (den != 0).
fn rf_is_valid(r: list) -> bool
    r[1] != 0

// rf_from_int — convert an integer to a rational [n, 1].
fn rf_from_int(n: int) -> list
    [n, 1]

// rf_to_string — human-readable string representation.
// Integers (den == 1) display as just the numerator. Fractions as "n/d".
fn rf_to_string(r: list) -> string
    let num = r[0]
    let den = r[1]
    if den == 1
        return str(num)
    str(num) + "/" + str(den)
