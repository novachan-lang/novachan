// std/rational/rfrac_approx.nova — Best rational approximations.
// All public functions use the rfx_ prefix.  LEAF — imports NOTHING.
//
// Representation: rational = [num, den] in lowest terms, den>0.
//   Zero = [0,1].  Invalid (den==0 input) = [0,0].
//
// Public API:
//   rfx_best_within(xn, xd, maxden) -> rational
//       Best approximation of the exact rational xn/xd with denominator <= maxden,
//       chosen via continued-fraction convergents and semiconvergents.
//   rfx_simplest_between(a, b) -> rational
//       The unique rational strictly between a and b (a < b) with the smallest
//       denominator (ties broken by smallest numerator).  Stern-Brocot search.
//   rfx_best_tol(xn, xd, tol_n, tol_d) -> rational
//       Simplest rational within tolerance tol_n/tol_d of xn/xd.
//
// KNOWN ANSWERS (hand-verified):
//   rfx_best_within(1,3,2)   -> [1,2]   (closest to 1/3 with den<=2 is 1/2)
//   rfx_best_within(314,100,10) -> [22,7]
//   rfx_best_within(22,7,100) -> [22,7]
//   rfx_simplest_between([1,3],[1,2]) -> [2,5]
//   rfx_simplest_between([0,1],[1,1]) -> [1,2]
//   rfx_simplest_between([3,10],[7,10]) -> [1,2]

// _gcd — Euclidean GCD on absolute values; result >= 0.
fn _gcd(a: int, b: int) -> int
    let aa = -a if a < 0 else a
    let bb = -b if b < 0 else b
    while bb != 0
        let tmp = bb
        bb = aa % bb
        aa = tmp
    aa

// _make — reduce n/d to lowest terms with den>0.  den==0 -> [0,0].
fn _make(n: int, d: int) -> list
    if d == 0
        return [0, 0]
    let sn = -n if d < 0 else n
    let sd = -d if d < 0 else d
    if sn == 0
        return [0, 1]
    let g = _gcd(sn, sd)
    [sn / g, sd / g]

// _abs_int — absolute value of integer.
fn _abs_int(x: int) -> int
    if x < 0
        return -x
    x

// _cmp_cross — compare p/q vs r/s by cross-multiplication (no float).
// Returns -1 if p/q < r/s, 0 if equal, 1 if p/q > r/s.
// Requires q>0 and s>0.
fn _cmp_cross(p: int, q: int, r: int, s: int) -> int
    let lhs = p * s
    let rhs = r * q
    if lhs < rhs
        return -1
    if lhs > rhs
        return 1
    0

// _dist2_cmp — compare |p/q - xn/xd| vs |r/s - xn/xd| using cross-mult.
// Returns -1 if first is closer, 0 if equal, 1 if second is closer.
// All denominators must be positive.
fn _dist2_cmp(p: int, q: int, r: int, s: int, xn: int, xd: int) -> int
    // |p/q - xn/xd| = |p*xd - xn*q| / (q*xd)
    // |r/s - xn/xd| = |r*xd - xn*s| / (s*xd)
    // Compare: |p*xd - xn*q| * s  vs  |r*xd - xn*s| * q
    let d1raw = p * xd - xn * q
    let d1 = -d1raw if d1raw < 0 else d1raw
    let d2raw = r * xd - xn * s
    let d2 = -d2raw if d2raw < 0 else d2raw
    let lhs = d1 * s
    let rhs = d2 * q
    if lhs < rhs
        return -1
    if lhs > rhs
        return 1
    0

// _rfx_consider — given a candidate rational cand_n/cand_d and the current
// best_n/best_d, return whichever is closer to axn/axd (cross-mult compare
// via _dist2_cmp), tie-broken by smaller denominator.  Returns [n, d].
fn _rfx_consider(cand_n: int, cand_d: int, best_n: int, best_d: int, axn: int, axd: int) -> list
    let c = _dist2_cmp(cand_n, cand_d, best_n, best_d, axn, axd)
    let rn = best_n
    let rd = best_d
    if c < 0
        rn = cand_n
        rd = cand_d
    else if c == 0 and cand_d < best_d
        rn = cand_n
        rd = cand_d
    [rn, rd]

// rfx_best_within — best rational approximation of xn/xd with den <= maxden.
// Uses continued-fraction convergents and semiconvergents on |xn|/|xd|, picks
// closest by cross-multiplication comparison, then re-applies sign.
fn rfx_best_within(xn: int, xd: int, maxden: int) -> list
    if xd == 0
        return [0, 0]
    if maxden <= 0
        return [0, 0]
    // Determine sign; work on absolute values for the CF.
    let axd = -xd if xd < 0 else xd
    let axn1 = -xn if xd < 0 else xn
    let negative = 1 if axn1 < 0 else 0
    let axn = -axn1 if axn1 < 0 else axn1
    // axn >= 0, axd > 0 now.
    // Integer part (floor of axn/axd)
    let whole = axn / axd
    // Run continued fraction on axn/axd to generate convergents.
    // h[-1]=1,h[0]=whole; k[-1]=0,k[0]=1
    let h_prev = 1
    let k_prev = 0
    let h_curr = whole
    let k_curr = 1
    // Initialise best with h_curr/k_curr (always fits: k_curr=1<=maxden when maxden>=1)
    let best_n = h_curr
    let best_d = k_curr
    // Remainder for continued fraction
    let rem_n = axn - whole * axd
    let rem_d = axd
    let done = 0
    while done == 0
        if rem_n == 0
            done = 1
        if done == 0
            // Next CF term: a = floor(rem_d / rem_n)
            let a = rem_d / rem_n
            // New convergent
            let h_next = a * h_curr + h_prev
            let k_next = a * k_curr + k_prev
            if k_next > maxden
                // Semiconvergent: largest t such that t*k_curr + k_prev <= maxden
                let t = (maxden - k_prev) / k_curr
                if t >= 1
                    let sc_n = t * h_curr + h_prev
                    let sc_d = t * k_curr + k_prev
                    if sc_d <= maxden
                        let r1 = _rfx_consider(sc_n, sc_d, best_n, best_d, axn, axd)
                        best_n = r1[0]
                        best_d = r1[1]
                done = 1
            if done == 0
                // Full convergent fits: update best
                let r2 = _rfx_consider(h_next, k_next, best_n, best_d, axn, axd)
                best_n = r2[0]
                best_d = r2[1]
                // Advance CF state
                let new_rem_n = rem_d - a * rem_n
                let new_rem_d = rem_n
                rem_n = new_rem_n
                rem_d = new_rem_d
                h_prev = h_curr
                k_prev = k_curr
                h_curr = h_next
                k_curr = k_next
    // Re-apply sign
    let final_n = -best_n if negative == 1 else best_n
    _make(final_n, best_d)

// rfx_simplest_between — simplest rational strictly between a and b (a < b).
// Uses Stern-Brocot mediant search.  Both a and b must be valid rationals.
fn rfx_simplest_between(a: list, b: list) -> list
    let an = a[0]
    let ad = a[1]
    let bn = b[0]
    let bd = b[1]
    if ad == 0 or bd == 0
        return [0, 0]
    // Stern-Brocot: maintain interval [lo_n/lo_d, hi_n/hi_d] and take mediants.
    // Initialise with integer bounds.
    let lo_n = an / ad
    let lo_d = 1
    // lo = floor(a)
    // If a is exactly an integer, lo must be < a, so lo = a - 1
    let r1 = _cmp_cross(lo_n, lo_d, an, ad)
    if r1 == 0
        lo_n -= 1
    let hi_n = bn / bd
    let hi_d = 1
    // hi = ceil(b) ... actually we want hi > b
    let r2 = _cmp_cross(hi_n, hi_d, bn, bd)
    if r2 <= 0
        hi_n += 1
    let found = 0
    let res_n = 0
    let res_d = 1
    while found == 0
        // mediant
        let med_n = lo_n + hi_n
        let med_d = lo_d + hi_d
        // is mediant > a?
        let ca = _cmp_cross(med_n, med_d, an, ad)
        // is mediant < b?
        let cb = _cmp_cross(med_n, med_d, bn, bd)
        if ca > 0 and cb < 0
            res_n = med_n
            res_d = med_d
            found = 1
        if found == 0
            if ca <= 0
                // mediant <= a: move lo up
                lo_n = med_n
                lo_d = med_d
            if cb >= 0
                // mediant >= b: move hi down
                hi_n = med_n
                hi_d = med_d
    _make(res_n, res_d)

// rfx_best_tol — simplest rational within tolerance tol_n/tol_d of xn/xd.
// Finds simplest rational p/q (smallest q, ties: smallest |p|) with
// |p/q - xn/xd| <= tol_n/tol_d.  Scans denominators 1,2,3,... until found.
fn rfx_best_tol(xn: int, xd: int, tol_n: int, tol_d: int) -> list
    if xd == 0 or tol_d == 0
        return [0, 0]
    // Normalise xn/xd sign so xd>0
    let sxn = -xn if xd < 0 else xn
    let sxd = -xd if xd < 0 else xd
    // Normalise tol so tol_d>0
    let stol_n1 = -tol_n if tol_d < 0 else tol_n
    let stol_d = -tol_d if tol_d < 0 else tol_d
    let stol_n = -stol_n1 if stol_n1 < 0 else stol_n1
    // For denominator d, we want p such that |p/d - sxn/sxd| <= stol_n/stol_d
    // i.e. |p*sxd*stol_d - sxn*d*stol_d| <= stol_n*d*sxd
    // i.e. p in [ sxn*d/sxd - stol_n*d/stol_d , sxn*d/sxd + stol_n*d/stol_d ]
    // Use integer arithmetic: p_lo = ceil((sxn*d*stol_d - stol_n*d*sxd) / (sxd*stol_d))
    //                          p_hi = floor((sxn*d*stol_d + stol_n*d*sxd) / (sxd*stol_d))
    let found = 0
    let res_n = 0
    let res_d = 1
    let d = 1
    while found == 0
        // center numerator times (sxd*stol_d): sxn * d * stol_d
        let center = sxn * d * stol_d
        // half-width in same units: stol_n * d * sxd
        let hw = stol_n * d * sxd
        let denom = sxd * stol_d
        // p_lo_num = center - hw  (need ceil division by denom>0)
        let lo_num = center - hw
        // ceil(lo_num / denom): if lo_num>=0 => (lo_num+denom-1)/denom; if negative => lo_num/denom
        let p_lo = (lo_num + denom - 1) / denom if lo_num >= 0 else lo_num / denom
        // p_hi_num = center + hw (floor division by denom>0)
        let hi_num = center + hw
        let p_hi = hi_num / denom if hi_num >= 0 else (hi_num - denom + 1) / denom
        // Among p_lo..p_hi, pick the p closest to 0 (smallest |p|) for simplicity
        if p_lo <= p_hi
            // find p in [p_lo, p_hi] with smallest |p|
            let best_p = p_lo
            let p = p_lo + 1
            let bp_abs = -best_p if best_p < 0 else best_p
            while p <= p_hi
                let pa = -p if p < 0 else p
                if pa < bp_abs
                    best_p = p
                    bp_abs = pa
                p += 1
            // Verify gcd(best_p, d) — we want reduced form
            let r = _make(best_p, d)
            res_n = r[0]
            res_d = r[1]
            found = 1
        if found == 0
            d += 1
    [res_n, res_d]
