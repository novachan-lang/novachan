// std/rational/rfrac_egyptian.nova — Egyptian (unit) fraction decomposition.
// All public functions use the rfe_ prefix.  LEAF — imports NOTHING.
//
// Representation: rational = [num, den] in lowest terms, den>0.
//   Zero = [0,1].  Invalid (den==0 input) = [0,0].
//
// Public API:
//   rfe_egyptian(an, ad)      -> list of int denominators
//       Greedy (Fibonacci-Sylvester) Egyptian fraction of an/ad.
//       Each step takes 1/ceil(ad/an) and subtracts; all denominators > 0 and distinct.
//   rfe_egyptian_sum(dens)    -> rational
//       Sum of 1/d_i for each d in dens, fully reduced.
//   rfe_is_unit(r)            -> bool (1 if num==1, else 0)
//   rfe_egyptian_length(an,ad)-> int  length of the greedy expansion.
//
// KNOWN ANSWERS (hand-verified):
//   rfe_egyptian(3,4)  -> [2,4]      (1/2 + 1/4)
//   rfe_egyptian(5,6)  -> [2,3]      (1/2 + 1/3)
//   rfe_egyptian(2,3)  -> [2,6]      (1/2 + 1/6)
//   rfe_egyptian(4,13) -> [4,18,468] (1/4 + 1/18 + 1/468)
//   rfe_egyptian_sum([2,4])    -> [3,4]
//   rfe_egyptian_sum([2,3,6])  -> [1,1]
//   rfe_is_unit([1,7]) -> true (1)
//   rfe_is_unit([2,7]) -> false (0)
//   ROUND-TRIP: rfe_egyptian_sum(rfe_egyptian(5,6)) -> [5,6]

// _gcd — Euclidean GCD on absolute values; result >= 0.
fn _gcd(a: int, b: int) -> int
    let aa = -a if a < 0 else a
    let bb = -b if b < 0 else b
    while bb != 0
        let tmp = bb
        bb = aa % bb
        aa = tmp
    aa

// _make — reduce n/d to lowest terms with den>0.  den==0 -> [0,0].
fn _make(n: int, d: int) -> list
    if d == 0
        return [0, 0]
    let sn = -n if d < 0 else n
    let sd = -d if d < 0 else d
    if sn == 0
        return [0, 1]
    let g = _gcd(sn, sd)
    [sn / g, sd / g]

// _ceil_div — ceiling division of a/b for b>0, a any sign.
fn _ceil_div(a: int, b: int) -> int
    let q = a / b
    // if remainder non-zero and a>0 (positive overshoot), add 1
    let r = a - q * b
    if r > 0
        q += 1
    q

// rfe_egyptian — greedy Egyptian fraction decomposition of an/ad.
// Returns a list of unit-fraction denominators (each >= 1) in increasing order.
// Input: 0 < an/ad <= 1 for canonical use; handles any positive fraction.
// If an/ad <= 0 or invalid, returns empty list.
fn rfe_egyptian(an: int, ad: int) -> list
    let result = []
    if an <= 0 or ad <= 0
        return result
    // Work with reduced form
    let g0 = _gcd(an, ad)
    let cn = an / g0
    let cd = ad / g0
    while cn != 0
        // k = ceil(cd / cn)
        let k = _ceil_div(cd, cn)
        push(result, k)
        // Subtract 1/k: new = cn/cd - 1/k = (cn*k - cd) / (cd*k)
        let new_n = cn * k - cd
        let new_d = cd * k
        if new_n == 0
            return result
        // Reduce
        let g = _gcd(new_n, new_d)
        cn = new_n / g
        cd = new_d / g
    result

// rfe_egyptian_sum — sum 1/d for each d in dens, returns reduced rational.
fn rfe_egyptian_sum(dens: list) -> list
    let acc_n = 0
    let acc_d = 1
    for d in dens
        if d != 0
            // acc + 1/d = (acc_n * d + acc_d) / (acc_d * d)
            let new_n = acc_n * d + acc_d
            let new_d = acc_d * d
            let r = _make(new_n, new_d)
            acc_n = r[0]
            acc_d = r[1]
    [acc_n, acc_d]

// rfe_is_unit — returns 1 (true) if r is a unit fraction (num==1), else 0.
fn rfe_is_unit(r: list) -> int
    1 if r[0] == 1 else 0

// rfe_egyptian_length — number of terms in the greedy Egyptian fraction of an/ad.
fn rfe_egyptian_length(an: int, ad: int) -> int
    let e = rfe_egyptian(an, ad)
    len(e)
