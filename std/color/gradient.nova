// std/color/gradient.nova — Color gradient utilities (RGB lists).
//
// FLOAT HAZARDS obeyed throughout:
//   * bare multi-term float return -> bind every intermediate to a named let.
//   * abs(float) returns int -> use if/else for float abs.
//   * '/' two ints = INTEGER division -> use floats for real division.
//   * float-vs-int compare unsound -> coerce *1.0 where needed.
//   * Single-exit pattern on every fn to avoid float-slot Heisenbug.
//
// All colors are represented as int lists [r, g, b] (channels 0..255).
//
// API:
//   grd_linear(a, b, steps) -> list   list of 'steps' RGB colors from a to b inclusive, linear
//   grd_at(a, b, t)         -> list   single RGB color at float position t in [0..1]
//   grd_multi(stops, steps) -> list   smooth gradient across multiple RGB stops, 'steps' colors

// Clamp an int to [0, 255]
fn _grd_clamp(v: int) -> int
    let result = v
    if v < 0
        result = 0
    if v > 255
        result = 255
    result

// Round a float to nearest int (non-negative safe: float_to_int truncates, +0.5 rounds)
fn _grd_round(v: float) -> int
    let r = float_to_int(v + 0.5)
    r

// Build a single RGB list from three ints
fn _grd_rgb(r: int, g: int, b: int) -> list
    let out = []
    out.push(r)
    out.push(g)
    out.push(b)
    out

// Linear interpolation: a + t*(b-a), rounded and clamped, for one channel.
fn _grd_lerp_chan(ac: int, bc: int, t: float) -> int
    let af = ac * 1.0
    let bf = bc * 1.0
    let diff = bf - af
    let v = af + t * diff
    let vi = _grd_round(v)
    let vc = _grd_clamp(vi)
    vc

// grd_at: interpolate between two RGB colors at float t in [0.0..1.0].
// t=0 returns a, t=1 returns b.
fn grd_at(a: list, b: list, t: float) -> list
    let ar = a[0]
    let ag = a[1]
    let ab = a[2]
    let br = b[0]
    let bg = b[1]
    let bb = b[2]
    let rc = _grd_lerp_chan(ar, br, t)
    let gc = _grd_lerp_chan(ag, bg, t)
    let bc = _grd_lerp_chan(ab, bb, t)
    let out = _grd_rgb(rc, gc, bc)
    out

// grd_linear: produce a list of 'steps' colors from a to b inclusive.
// steps=1 returns [a]; steps=2 returns [a, b]; steps>=2 includes both endpoints.
fn grd_linear(a: list, b: list, steps: int) -> list
    let out = []
    if steps <= 0
        out
    else
        if steps == 1
            let c0 = grd_at(a, b, 0.0)
            out.push(c0)
            out
        else
            let denom = (steps - 1) * 1.0
            for i in 0..steps
                let t = i * 1.0 / denom
                let c = grd_at(a, b, t)
                out.push(c)
            out

// grd_multi: smooth gradient across a list of RGB stop colors, producing 'steps' total colors.
// Stops are treated as evenly spaced. If stops has 0 or 1 entries, degenerates gracefully.
fn grd_multi(stops: list, steps: int) -> list
    let out = []
    let ns = len(stops)
    if ns == 0
        out
    else
        if steps <= 0
            out
        else
            if ns == 1
                let s0 = stops[0]
                for i in 0..steps
                    let c = grd_at(s0, s0, 0.0)
                    out.push(c)
                out
            else
                // ns >= 2: (ns-1) segments, each gets steps evenly spread over [0,1].
                // For position p in [0, steps-1], map to segment and local t.
                let nsegs = ns - 1
                for i in 0..steps
                    let pos = i * 1.0
                    let total = (steps - 1) * 1.0
                    // global t in [0, 1]
                    let gt = pos / total
                    // which segment: floor(gt * nsegs), clamped to [0, nsegs-1]
                    let seg_f = gt * (nsegs * 1.0)
                    let seg = float_to_int(seg_f)
                    let seg_clamped = seg
                    if seg_clamped >= nsegs
                        seg_clamped = nsegs - 1
                    // local t within segment
                    let seg_start = seg_clamped * 1.0
                    let lt = seg_f - seg_start
                    // guard lt in [0,1]
                    let lt2 = lt
                    if lt2 < 0.0
                        lt2 = 0.0
                    if lt2 > 1.0
                        lt2 = 1.0
                    let stop_a = stops[seg_clamped]
                    let stop_b = stops[seg_clamped + 1]
                    let c = grd_at(stop_a, stop_b, lt2)
                    out.push(c)
                out
