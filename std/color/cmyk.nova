// std/color/cmyk.nova — RGB <-> CMYK color-space conversion.
//
// All CMYK channels are integer percentages in range [0, 100].
// RGB channels are integers in range [0, 255].
//
// Standard CMYK model:
//   k = 1 - max(r,g,b)/255
//   c = (1 - r/255 - k) / (1 - k)   [0 if k==1]
//   m = (1 - g/255 - k) / (1 - k)   [0 if k==1]
//   y = (1 - b/255 - k) / (1 - k)   [0 if k==1]
//
// FLOAT HAZARDS obeyed throughout:
//   - Every intermediate float expression bound to a named let.
//   - float abs via if/else (not abs()).
//   - Integer division avoided by coercing ints to float via *1.0 before dividing.
//   - round via float_to_int(x + 0.5) for non-negative values.
//   - Single-exit pattern on each fn.
//
// API:
//   cmyk_from_rgb(rgb)        -> list [c, m, y, k]  (all 0..100 int)
//   cmyk_to_rgb(c, m, y, k)  -> list [r, g, b]      (all 0..255 int)

// _fround_pos: round a non-negative float to nearest integer.
fn _fround_pos(x: float) -> int
    let shifted = x + 0.5
    let result = float_to_int(shifted)
    result

// _cmyk_clamp100: clamp an int to [0, 100].
fn _cmyk_clamp100(v: int) -> int
    if v > 100
        return 100
    if v < 0
        return 0
    v

// cmyk_from_rgb: convert an [r, g, b] list (0..255 each) to [c, m, y, k] (0..100 each).
fn cmyk_from_rgb(rgb: list) -> list
    let r = rgb[0]
    let g = rgb[1]
    let b = rgb[2]

    // find max channel to compute k
    let max_rg = r if r > g else g
    let maxc = max_rg if max_rg > b else b

    // k as float in [0,1]
    let maxf = maxc * 1.0
    let kf = 1.0 - maxf / 255.0

    // black-only case: pure black
    if kf >= 1.0
        return [0, 0, 0, 100]

    // denominator = 1 - k
    let denom = 1.0 - kf

    // c channel
    let rf = r * 1.0
    let cf = (1.0 - rf / 255.0 - kf) / denom
    let ci = _cmyk_clamp100(_fround_pos(cf * 100.0))

    // m channel
    let gf = g * 1.0
    let mf = (1.0 - gf / 255.0 - kf) / denom
    let mi = _cmyk_clamp100(_fround_pos(mf * 100.0))

    // y channel
    let bf = b * 1.0
    let yf = (1.0 - bf / 255.0 - kf) / denom
    let yi = _cmyk_clamp100(_fround_pos(yf * 100.0))

    // k as integer percent
    let ki = _cmyk_clamp100(_fround_pos(kf * 100.0))

    [ci, mi, yi, ki]

// _cmyk_clamp255: clamp an int to [0, 255].
fn _cmyk_clamp255(v: int) -> int
    if v > 255
        return 255
    if v < 0
        return 0
    v

// cmyk_to_rgb: convert CMYK percentages (0..100) to [r, g, b] (0..255 each).
fn cmyk_to_rgb(c: int, m: int, y: int, k: int) -> list
    let cf = c * 1.0 / 100.0
    let mf = m * 1.0 / 100.0
    let yf = y * 1.0 / 100.0
    let kf = k * 1.0 / 100.0

    let one_minus_k = 1.0 - kf

    let rf = 255.0 * (1.0 - cf) * one_minus_k
    let gf = 255.0 * (1.0 - mf) * one_minus_k
    let bf = 255.0 * (1.0 - yf) * one_minus_k

    let ri = _cmyk_clamp255(_fround_pos(rf))
    let gi = _cmyk_clamp255(_fround_pos(gf))
    let bi = _cmyk_clamp255(_fround_pos(bf))

    [ri, gi, bi]
