// std/color/palette.nova — Color scheme / palette generation.
//
// Generates harmonious color schemes by rotating hue around the HSL color
// wheel. All input/output colors are [r, g, b] int lists (channels 0..255).
//
// FLOAT HAZARDS obeyed throughout (see hsl.nova header for full list):
//   * intermediate float results bound to named lets before return.
//   * abs(float) -> use if/else (not abs()).
//   * '/' on two ints is integer division; floats used for real division.
//   * NO multi-line list literals; use push.
//
// API:
//   pal_complementary(c)          -> list of 2 RGB  [c, c+180]
//   pal_triadic(c)                -> list of 3 RGB  [c, c+120, c+240]
//   pal_analogous(c)              -> list of 3 RGB  [c-30, c, c+30]
//   pal_tetradic(c)               -> list of 4 RGB  [c, c+90, c+180, c+270]
//   pal_monochromatic(c, count)   -> list of count RGB (varying lightness)

import std/color/hsl

// ── internal helpers ──────────────────────────────────────────────────────────

// Normalise hue (int) to [0, 360)
fn _pal_norm_hue(h: int) -> int
    let r = h
    if r >= 360
        let s = r - 360
        r = s
    if r < 0
        let s = r + 360
        r = s
    // handle values beyond ±360 by repeated reduction
    if r >= 360
        let s = r - 360
        r = s
    if r < 0
        let s = r + 360
        r = s
    r

// Rotate hue of [r,g,b] by delta degrees and return new [r,g,b].
fn _pal_rotate(c: list, delta: int) -> list
    let hsl = hsl_from_rgb(c)
    let h = hsl[0]
    let s = hsl[1]
    let l = hsl[2]
    let raw = h + delta
    let nh = _pal_norm_hue(raw)
    let out = hsl_to_rgb(nh, s, l)
    out

// ── pal_complementary ────────────────────────────────────────────────────────
// Returns [c, complement] where complement = hue + 180.
fn pal_complementary(c: list) -> list
    let comp = _pal_rotate(c, 180)
    let out = []
    out.push(c)
    out.push(comp)
    out

// ── pal_triadic ───────────────────────────────────────────────────────────────
// Returns 3 colors at hue offsets 0, +120, +240.
fn pal_triadic(c: list) -> list
    let c1 = _pal_rotate(c, 120)
    let c2 = _pal_rotate(c, 240)
    let out = []
    out.push(c)
    out.push(c1)
    out.push(c2)
    out

// ── pal_analogous ────────────────────────────────────────────────────────────
// Returns 3 colors at hue offsets -30, 0, +30.
fn pal_analogous(c: list) -> list
    let cm = _pal_rotate(c, -30)
    let cp = _pal_rotate(c, 30)
    let out = []
    out.push(cm)
    out.push(c)
    out.push(cp)
    out

// ── pal_tetradic ─────────────────────────────────────────────────────────────
// Returns 4 colors at hue offsets 0, +90, +180, +270.
fn pal_tetradic(c: list) -> list
    let c1 = _pal_rotate(c, 90)
    let c2 = _pal_rotate(c, 180)
    let c3 = _pal_rotate(c, 270)
    let out = []
    out.push(c)
    out.push(c1)
    out.push(c2)
    out.push(c3)
    out

// ── pal_monochromatic ────────────────────────────────────────────────────────
// Returns `count` colors with the same hue and saturation but varying
// lightness spread evenly across [5, 95] (avoids pure black/white at edges).
fn pal_monochromatic(c: list, count: int) -> list
    let hsl = hsl_from_rgb(c)
    let h = hsl[0]
    let s = hsl[1]
    let out = []
    let i = 0
    while i < count
        let step = 0
        // Spread lightness evenly in [5..95] over count steps.
        // lightness = 5 + (90 * i) / (count - 1)   when count > 1
        // lightness = 50                              when count == 1
        if count == 1
            step = 50
        if count > 1
            let num = 90 * i
            let denom = count - 1
            let ratio = num / denom
            let v = 5 + ratio
            step = v
        let col = hsl_to_rgb(h, s, step)
        out.push(col)
        i = i + 1
    out
