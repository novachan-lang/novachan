// ============================================================================
// NOVA Standard Library — std/color/hsv
// ============================================================================
// RGB <-> HSV (a.k.a. HSB) conversions.
//
// All RGB components are integers in 0..255.
// HSV uses: h in 0..360 (int degrees), s and v in 0..100 (int percent).
//
// Public API:
//   hsv_from_rgb(c)         -> list   [h, s, v] ints (h 0..360, s/v 0..100)
//   hsv_to_rgb(h, s, v)     -> list   [r, g, b] ints 0..255

// ── internal helpers ─────────────────────────────────────────────────────────

// Round a non-negative float to the nearest integer.
fn _hsv_round(x: float) -> int
    float_to_int(x + 0.5)

// Clamp an int to [lo, hi].
fn _hsv_clamp_int(v: int, lo: int, hi: int) -> int
    let r = v
    if r < lo
        r = lo
    if r > hi
        r = hi
    r

// Scale a float channel 0..1 to an int 0..255 with rounding.
fn _hsv_chan_to_byte(v: float) -> int
    let scaled = v * 255.0
    let rounded = _hsv_round(scaled)
    _hsv_clamp_int(rounded, 0, 255)

// ── hsv_from_rgb ─────────────────────────────────────────────────────────────
// Convert an [r, g, b] list (ints 0..255) to [h, s, v] (ints; h 0..360,
// s/v 0..100).  Achromatic colours produce h=0, s=0.
fn hsv_from_rgb(c: list) -> list
    let r = c[0]
    let g = c[1]
    let b = c[2]

    // Normalise to 0..1.
    let rf = r * 1.0 / 255.0
    let gf = g * 1.0 / 255.0
    let bf = b * 1.0 / 255.0

    // Find max and min.
    let cmax = rf
    if gf > cmax
        cmax = gf
    if bf > cmax
        cmax = bf

    let cmin = rf
    if gf < cmin
        cmin = gf
    if bf < cmin
        cmin = bf

    let delta = cmax - cmin

    // Value: simply cmax scaled to 0..100.
    let v_int = _hsv_round(cmax * 100.0)

    // Saturation: 0 when value is 0 (black).
    let s_int = 0
    if cmax > 0.0
        let s_frac = delta / cmax * 100.0
        s_int = _hsv_round(s_frac)

    // Hue: 0 when achromatic.
    let h_int = 0
    if delta > 0.0
        let h_raw = 0.0
        if cmax == rf
            // Sector 0: between yellow and magenta.
            let seg = (gf - bf) / delta
            h_raw = seg * 60.0
            if h_raw < 0.0
                h_raw = h_raw + 360.0
        else
            if cmax == gf
                // Sector 1/2: between cyan and yellow.
                let seg = (bf - rf) / delta + 2.0
                h_raw = seg * 60.0
            else
                // Sector 3/4/5: between magenta and cyan.
                let seg = (rf - gf) / delta + 4.0
                h_raw = seg * 60.0
        // Wrap into [0, 360).
        if h_raw < 0.0
            h_raw = h_raw + 360.0
        if h_raw >= 360.0
            h_raw = h_raw - 360.0
        h_int = _hsv_round(h_raw)
        // Rounding to 360 wraps back to 0.
        if h_int >= 360
            h_int = 0

    let result = [h_int, s_int, v_int]
    result

// ── hsv_to_rgb ───────────────────────────────────────────────────────────────
// Convert h (0..360 int), s (0..100 int), v (0..100 int) to [r, g, b] ints
// 0..255.  Achromatic (s==0) produces a neutral grey.
fn hsv_to_rgb(h: int, s: int, v: int) -> list
    let vf = v * 1.0 / 100.0
    let sf = s * 1.0 / 100.0

    // Achromatic: saturation is zero.
    if s == 0
        let grey = _hsv_chan_to_byte(vf)
        return [grey, grey, grey]

    // Sector calculation.
    let hf = h * 1.0 / 60.0
    // i = floor(hf) — use integer division of h by 60.
    let i = h / 60
    let f = hf - i * 1.0

    let p = vf * (1.0 - sf)
    let q = vf * (1.0 - f * sf)
    let t = vf * (1.0 - (1.0 - f) * sf)

    // Select RGB tuple from sector.
    let ri = 0
    let gi = 0
    let bi = 0
    let sector = i - (i / 6) * 6
    if sector == 0
        ri = _hsv_chan_to_byte(vf)
        gi = _hsv_chan_to_byte(t)
        bi = _hsv_chan_to_byte(p)
    else
        if sector == 1
            ri = _hsv_chan_to_byte(q)
            gi = _hsv_chan_to_byte(vf)
            bi = _hsv_chan_to_byte(p)
        else
            if sector == 2
                ri = _hsv_chan_to_byte(p)
                gi = _hsv_chan_to_byte(vf)
                bi = _hsv_chan_to_byte(t)
            else
                if sector == 3
                    ri = _hsv_chan_to_byte(p)
                    gi = _hsv_chan_to_byte(q)
                    bi = _hsv_chan_to_byte(vf)
                else
                    if sector == 4
                        ri = _hsv_chan_to_byte(t)
                        gi = _hsv_chan_to_byte(p)
                        bi = _hsv_chan_to_byte(vf)
                    else
                        ri = _hsv_chan_to_byte(vf)
                        gi = _hsv_chan_to_byte(p)
                        bi = _hsv_chan_to_byte(q)

    [ri, gi, bi]
