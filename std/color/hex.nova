// ============================================================================
// NOVA Standard Library — std/color/hex
// ============================================================================
// RGB <-> hex-string colour codec.
//
// Colours are represented as [r, g, b] integer lists (channels 0..255).
// This module is hex-string focused: parsing, formatting, validation, and
// the CSS shorthand form.  It does NOT duplicate the component-by-component
// API of std/util/color — it provides the list-oriented interface that most
// colour pipelines prefer.
//
// PUBLIC API
//   chex_from_rgb(c: list) -> str
//     [r, g, b] -> "#rrggbb"  (always 7 chars, lowercase).
//
//   chex_to_rgb(hexstr: str) -> list
//     Accepts "#rrggbb", "rrggbb", or "#rgb" (3-nibble CSS shorthand).
//     Returns [r, g, b] integers.  Returns [0, 0, 0] on malformed input.
//
//   chex_is_valid(hexstr: str) -> bool
//     True iff hexstr is a valid 3- or 6-digit hex colour string
//     (optional leading '#').  Only [0-9a-fA-F] digits accepted.
//
//   chex_shorthand(c: list) -> str
//     Returns "#rgb" if every channel satisfies (ch & 0x0f) == (ch >> 4),
//     i.e. the low and high nibbles are the same (e.g. 0xff, 0x00, 0xaa).
//     Otherwise returns the full "#rrggbb" form.
//
// DESIGN NOTES
//   - All internal helpers are prefixed _chex_ to guarantee no symbol
//     collision when multiple colour modules are imported together.
//   - Integer division for nibble extraction: NOVA '/' on two ints is
//     integer (floor) division — safe here because b is in 0..255.
//   - String indexing s[i] returns a 1-char string in NOVA, not an int.
//   - 'abs(float)' in NOVA returns int — never used here; channels are int.

// ── private helpers ──────────────────────────────────────────────────────────

// Lowercase hex alphabet.
fn _chex_alpha() -> str
    "0123456789abcdef"

// Render an integer 0..255 as exactly two lowercase hex characters.
fn _chex_byte_to_hex(b: int) -> str
    let alpha = _chex_alpha()
    let hi = b / 16
    let lo = b - hi * 16
    alpha[hi] + alpha[lo]

// Parse a single hex character (upper or lower case) to nibble 0..15.
// Returns -1 on invalid input.
fn _chex_nibble(c: str) -> int
    // Normalise to lowercase so both 'A'-'F' and 'a'-'f' are accepted.
    let lc = lower(c)
    let alpha = _chex_alpha()
    for i in 0..16
        if alpha[i] == lc
            return i
    0 - 1

// Parse two consecutive hex characters from string s at position pos.
// Returns -1 if either character is invalid.
fn _chex_parse_byte(s: str, pos: int) -> int
    let hi = _chex_nibble(s[pos])
    let lo = _chex_nibble(s[pos + 1])
    if hi < 0
        return 0 - 1
    if lo < 0
        return 0 - 1
    hi * 16 + lo

// Parse one hex character from s at position pos, expand to a full byte
// by repeating the nibble (CSS #rgb expansion: 'a' -> 0xaa = 170).
// Returns -1 on invalid character.
fn _chex_parse_nibble_expanded(s: str, pos: int) -> int
    let n = _chex_nibble(s[pos])
    if n < 0
        return 0 - 1
    n * 16 + n

// ── chex_from_rgb ────────────────────────────────────────────────────────────

// Convert [r, g, b] (0..255 integers) to lowercase "#rrggbb".
fn chex_from_rgb(c: list) -> str
    let r = c[0]
    let g = c[1]
    let b = c[2]
    "#" + _chex_byte_to_hex(r) + _chex_byte_to_hex(g) + _chex_byte_to_hex(b)

// ── chex_to_rgb ──────────────────────────────────────────────────────────────

// Parse a hex colour string to [r, g, b].
// Accepts: "#rrggbb", "rrggbb", "#rgb".
// Returns [0, 0, 0] on malformed input (invalid characters or wrong length).
fn chex_to_rgb(hexstr: str) -> list
    let start = 0
    if len(hexstr) > 0
        if hexstr[0] == "#"
            start = 1
    let digits = len(hexstr) - start
    // 3-digit shorthand: expand each nibble.
    if digits == 3
        let rv = _chex_parse_nibble_expanded(hexstr, start)
        let gv = _chex_parse_nibble_expanded(hexstr, start + 1)
        let bv = _chex_parse_nibble_expanded(hexstr, start + 2)
        if rv < 0
            return [0, 0, 0]
        if gv < 0
            return [0, 0, 0]
        if bv < 0
            return [0, 0, 0]
        return [rv, gv, bv]
    // 6-digit full form.
    if digits == 6
        let rv = _chex_parse_byte(hexstr, start)
        let gv = _chex_parse_byte(hexstr, start + 2)
        let bv = _chex_parse_byte(hexstr, start + 4)
        if rv < 0
            return [0, 0, 0]
        if gv < 0
            return [0, 0, 0]
        if bv < 0
            return [0, 0, 0]
        return [rv, gv, bv]
    [0, 0, 0]

// ── chex_is_valid ────────────────────────────────────────────────────────────

// Return true iff hexstr is a valid 3- or 6-digit hex colour string.
// Optional leading '#' is accepted.  Only [0-9a-fA-F] digits are valid.
fn chex_is_valid(hexstr: str) -> bool
    let start = 0
    if len(hexstr) > 0
        if hexstr[0] == "#"
            start = 1
    let digits = len(hexstr) - start
    if digits != 3
        if digits != 6
            return false
    // Every character in the digit section must be a valid hex nibble.
    let i = start
    while i < len(hexstr)
        let n = _chex_nibble(hexstr[i])
        if n < 0
            return false
        i = i + 1
    true

// ── chex_shorthand ───────────────────────────────────────────────────────────

// Return "#rgb" if every channel's high nibble equals its low nibble
// (i.e., the channel value is a pair of identical nibbles: 0x00, 0x11 .. 0xff).
// Otherwise return the full "#rrggbb" string.
//
// A channel ch satisfies the condition when:  ch / 16 == ch - (ch / 16) * 16
// (high nibble == low nibble).
fn chex_shorthand(c: list) -> str
    let r = c[0]
    let g = c[1]
    let b = c[2]
    let rhi = r / 16
    let rlo = r - rhi * 16
    let ghi = g / 16
    let glo = g - ghi * 16
    let bhi = b / 16
    let blo = b - bhi * 16
    if rhi == rlo
        if ghi == glo
            if bhi == blo
                let alpha = _chex_alpha()
                let rs = alpha[rhi]
                let gs = alpha[ghi]
                let bs = alpha[bhi]
                return "#" + rs + gs + bs
    chex_from_rgb(c)
