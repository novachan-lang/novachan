// std/color/rgb.nova — RGB color model (channels 0..255).
//
// FLOAT HAZARDS obeyed throughout:
//   * bare multi-term float return -> bind every intermediate to a named let.
//   * abs(float) returns int -> use if/else for float abs.
//   * '/' two ints = INTEGER division -> use floats for real division.
//   * float-vs-int compare unsound -> coerce *1.0 where needed.
//   * Single-exit pattern on every fn to avoid float-slot Heisenbug.
//
// All colors are represented as int lists [r, g, b] (channels 0..255).
//
// API:
//   rgb_new(r, g, b)      -> list [r,g,b] clamped to [0..255]
//   rgb_clamp(c)          -> list each channel clamped to [0..255]
//   rgb_r(c)              -> int  red channel
//   rgb_g(c)              -> int  green channel
//   rgb_b(c)              -> int  blue channel
//   rgb_lighten(c, amt)   -> list lighten by amt (0..1) toward white
//   rgb_darken(c, amt)    -> list darken by amt (0..1) toward black
//   rgb_invert(c)         -> list 255-each channel
//   rgb_grayscale(c)      -> int  luminance-weighted grayscale (0.299r+0.587g+0.114b)
//   rgb_equal(a, b)       -> bool true if all channels equal

// Clamp an int to [0, 255]
fn _rgb_clamp_int(v: int) -> int
    if v < 0
        return 0
    if v > 255
        return 255
    v

// Construct a new RGB color with channels clamped to [0..255]
fn rgb_new(r: int, g: int, b: int) -> list
    let rc = _rgb_clamp_int(r)
    let gc = _rgb_clamp_int(g)
    let bc = _rgb_clamp_int(b)
    [rc, gc, bc]

// Clamp all channels of an existing color list to [0..255]
fn rgb_clamp(c: list) -> list
    let r = c[0]
    let g = c[1]
    let b = c[2]
    let rc = _rgb_clamp_int(r)
    let gc = _rgb_clamp_int(g)
    let bc = _rgb_clamp_int(b)
    [rc, gc, bc]

// Red channel accessor
fn rgb_r(c: list) -> int
    c[0]

// Green channel accessor
fn rgb_g(c: list) -> int
    c[1]

// Blue channel accessor
fn rgb_b(c: list) -> int
    c[2]

// Lighten color toward white by amt (0.0..1.0).
// Formula: channel + amt * (255 - channel), clamped.
fn rgb_lighten(c: list, amt: float) -> list
    let r = c[0]
    let g = c[1]
    let b = c[2]
    let rf = r * 1.0
    let gf = g * 1.0
    let bf = b * 1.0
    let white = 255.0
    let dr = white - rf
    let dg = white - gf
    let db = white - bf
    let nr = rf + amt * dr
    let ng = gf + amt * dg
    let nb = bf + amt * db
    let ri = float_to_int(nr)
    let gi = float_to_int(ng)
    let bi = float_to_int(nb)
    let rci = _rgb_clamp_int(ri)
    let gci = _rgb_clamp_int(gi)
    let bci = _rgb_clamp_int(bi)
    [rci, gci, bci]

// Darken color toward black by amt (0.0..1.0).
// Formula: channel * (1 - amt), clamped.
fn rgb_darken(c: list, amt: float) -> list
    let r = c[0]
    let g = c[1]
    let b = c[2]
    let rf = r * 1.0
    let gf = g * 1.0
    let bf = b * 1.0
    let factor = 1.0 - amt
    let nr = rf * factor
    let ng = gf * factor
    let nb = bf * factor
    let ri = float_to_int(nr)
    let gi = float_to_int(ng)
    let bi = float_to_int(nb)
    let rci = _rgb_clamp_int(ri)
    let gci = _rgb_clamp_int(gi)
    let bci = _rgb_clamp_int(bi)
    [rci, gci, bci]

// Invert color: 255 - each channel
fn rgb_invert(c: list) -> list
    let r = c[0]
    let g = c[1]
    let b = c[2]
    let ri = 255 - r
    let gi = 255 - g
    let bi = 255 - b
    [ri, gi, bi]

// Luminance-weighted grayscale: 0.299*r + 0.587*g + 0.114*b, rounded to int.
fn rgb_grayscale(c: list) -> int
    let r = c[0]
    let g = c[1]
    let b = c[2]
    let rf = r * 1.0
    let gf = g * 1.0
    let bf = b * 1.0
    let wr = 0.299
    let wg = 0.587
    let wb = 0.114
    let lr = rf * wr
    let lg = gf * wg
    let lb = bf * wb
    let lum = lr + lg
    let lum2 = lum + lb
    let result = float_to_int(lum2 + 0.5)
    result

// Equality: true if all three channels match
fn rgb_equal(a: list, b: list) -> bool
    let ra = a[0]
    let ga = a[1]
    let ba = a[2]
    let rb = b[0]
    let gb = b[1]
    let bb = b[2]
    ra == rb and ga == gb and ba == bb
