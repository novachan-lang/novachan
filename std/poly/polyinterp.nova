// ============================================================================
// NOVA Standard Library — std/poly/polyinterp
// ============================================================================
// Polynomial interpolation — Lagrange and Newton divided differences.
// Polynomials in ascending coefficient order: p[i] = coeff of x^i.
// All public functions prefix pi_.
// ============================================================================

// pi_fabs — float absolute value
fn pi_fabs(v) -> float
    if v < 0.0
        return 0.0 - v
    return v

// pi_eval_poly — evaluate polynomial coefficients at x using Horner's method
fn pi_eval_poly(coeffs, x) -> float
    let n = len(coeffs)
    if n == 0
        return 0.0
    let result = coeffs[n - 1] * 1.0
    let i = n - 2
    while i >= 0
        result = result * x * 1.0 + coeffs[i] * 1.0
        i -= 1
    return result

// pi_eval_lagrange — evaluate the Lagrange interpolant at x without forming coefficients
fn pi_eval_lagrange(xs, ys, x) -> float
    let n = len(xs)
    let total = 0.0
    for i in 0..n
        // Compute L_i(x)
        let li = 1.0
        let j = 0
        while j < n
            if j != i
                let xi = xs[i] * 1.0
                let xj = xs[j] * 1.0
                let xv = x * 1.0
                let num = xv - xj
                let den = xi - xj
                li = li * (num / den)
            j += 1
        total += li * ys[i] * 1.0
    return total

// pi_poly_add — add two polynomial coefficient lists (ascending order)
fn pi_poly_add(a, b) -> any
    let na = len(a)
    let nb = len(b)
    let nc = na
    if nb > nc
        nc = nb
    let c = []
    for i in 0..nc
        let va = 0.0
        if i < na
            va = a[i] * 1.0
        let vb = 0.0
        if i < nb
            vb = b[i] * 1.0
        push(c, va + vb)
    return c

// pi_poly_scale — multiply polynomial by scalar
fn pi_poly_scale(a, s) -> any
    let n = len(a)
    let c = []
    for i in 0..n
        push(c, a[i] * 1.0 * s * 1.0)
    return c

// pi_poly_mul — multiply two polynomials (ascending order)
fn pi_poly_mul(a, b) -> any
    let na = len(a)
    let nb = len(b)
    if na == 0 or nb == 0
        return []
    let nc = na + nb - 1
    let c = [0.0 for k in 0..nc]
    for i in 0..na
        let j = 0
        while j < nb
            c[i + j] = c[i + j] * 1.0 + a[i] * 1.0 * b[j] * 1.0
            j += 1
    return c

// pi_lagrange — compute Lagrange interpolating polynomial coefficients
// xs, ys: sample points and values (equal length)
// Returns coefficients in ascending order.
fn pi_lagrange(xs, ys) -> any
    let n = len(xs)
    // Result polynomial, start at zero
    let result = []
    push(result, 0.0)
    for i in 0..n
        // Build the basis polynomial L_i(x) = product_{j!=i} (x - xs[j]) / (xs[i] - xs[j])
        // Start with scalar [1.0]
        let basis = []
        push(basis, 1.0)
        let denom = 1.0
        let j = 0
        while j < n
            if j != i
                // Multiply basis by (x - xs[j]) — the linear factor [-xs[j], 1.0]
                let factor = []
                push(factor, 0.0 - xs[j] * 1.0)
                push(factor, 1.0)
                basis = pi_poly_mul(basis, factor)
                denom = denom * (xs[i] * 1.0 - xs[j] * 1.0)
            j += 1
        // Scale by ys[i] / denom
        let scale_v = ys[i] * 1.0 / denom
        let term = pi_poly_scale(basis, scale_v)
        result = pi_poly_add(result, term)
    // Strip trailing near-zeros to normalize
    let last = len(result) - 1
    while last > 0 and pi_fabs(result[last] * 1.0) < 0.0000000001
        last -= 1
    let out = []
    let k = 0
    while k <= last
        push(out, result[k] * 1.0)
        k += 1
    return out

// pi_divided_differences — compute divided difference table's leading column
// Returns list of length n: [f[x0], f[x0,x1], ..., f[x0,...,xn-1]]
fn pi_divided_differences(xs, ys) -> any
    let n = len(xs)
    // Copy ys into working list
    let d = [ys[i] * 1.0 for i in 0..n]
    // In-place divided differences (upper triangular)
    for level in 1..n
        let j = n - 1
        while j >= level
            let xi_back = xs[j - level] * 1.0
            let xi_now = xs[j] * 1.0
            let den = xi_now - xi_back
            if pi_fabs(den) < 0.000000001
                d[j] = 0.0
            else
                d[j] = (d[j] * 1.0 - d[j - 1] * 1.0) / den
            j -= 1
    return d

// pi_newton_to_standard — convert Newton form (divided diff coefficients + nodes) to standard form
// dd: divided differences (leading column), xs: nodes
fn pi_newton_to_standard(dd, xs) -> any
    let n = len(dd)
    if n == 0
        return []
    // Build from right: start with [dd[n-1]]
    let result = []
    push(result, dd[n - 1] * 1.0)
    let i = n - 2
    while i >= 0
        // result = result * (x - xs[i]) + dd[i]
        // Multiply result by (x - xs[i])
        let xi = xs[i] * 1.0
        let factor = []
        push(factor, 0.0 - xi)
        push(factor, 1.0)
        result = pi_poly_mul(result, factor)
        // Add dd[i] to constant term
        result[0] = result[0] * 1.0 + dd[i] * 1.0
        i -= 1
    return result

// pi_newton_divided — compute interpolating polynomial via Newton divided differences
// Returns standard coefficient form (ascending order).
fn pi_newton_divided(xs, ys) -> any
    let dd = pi_divided_differences(xs, ys)
    return pi_newton_to_standard(dd, xs)

// pi_fit_degree — return n-1 for n sample points (degree of interpolating polynomial)
fn pi_fit_degree(xs, ys) -> int
    return len(xs) - 1

// pi_verify — verify interpolant passes through all sample points within tolerance
fn pi_verify(xs, ys, tol) -> bool
    let coeffs = pi_lagrange(xs, ys)
    let n = len(xs)
    for i in 0..n
        let xi = xs[i] * 1.0
        let yi = ys[i] * 1.0
        let got = pi_eval_poly(coeffs, xi)
        let diff = got - yi
        if diff < 0.0
            diff = 0.0 - diff
        if diff > tol
            return false
    return true

fn main()
    print("polyinterp module OK")
