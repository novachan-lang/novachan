// std/poly/chebyshev.nova — Chebyshev polynomials of the first (T) and second (U) kinds.
// Representation: ascending coefficient list; coeffs[i] = coefficient of x^i.
// SELF-CONTAINED — imports NOTHING.
// NO trigonometry used anywhere.  cheb_roots_t uses Newton refinement on T_n.
//
// PUBLIC API (prefix cheb_):
//   cheb_t(n)->any            T_n coefficient list via recurrence T_0=[1], T_1=[0,1],
//                              T_n = 2x*T_{n-1} - T_{n-2}
//   cheb_u(n)->any            U_n coefficient list via recurrence U_0=[1], U_1=[0,2],
//                              U_n = 2x*U_{n-1} - U_{n-2}
//   cheb_eval_t(n, x)->float  T_n(x) via scalar recurrence (no poly construction)
//   cheb_eval_u(n, x)->float  U_n(x) via scalar recurrence
//   cheb_roots_t(n)->any      n roots of T_n via Newton refinement (no trig)
//   cheb_clenshaw(coeffs, x)->float  evaluate a Chebyshev series sum c_k T_k(x)
//   cheb_degree(n)->int       == n

// --- internal polynomial helpers ---

// Internal: multiply polynomial p by 2x  (i.e. shift up one degree, scale by 2)
fn cheb_mul2x(p: list) -> list
    let n = len(p)
    let out = []
    // constant term is 0
    let z = 0.0
    push(out, z)
    let i = 0
    while i < n
        let ci = p[i] * 2.0
        push(out, ci)
        i = i + 1
    out

// Internal: subtract polynomial b from polynomial a, coefficient-wise.
fn cheb_polysub(a: list, b: list) -> list
    let la = len(a)
    let lb = len(b)
    let lmax = la
    if lb > la
        lmax = lb
    let out = []
    let i = 0
    while i < lmax
        let va = 0.0
        let vb = 0.0
        if i < la
            va = a[i] * 1.0
        if i < lb
            vb = b[i] * 1.0
        let s = va - vb
        push(out, s)
        i = i + 1
    out

// Internal: strip trailing zeros from a coefficient list (normalize).
fn cheb_norm(p: list) -> list
    let n = len(p)
    if n == 0
        let emp = []
        return emp
    let last = n - 1
    while last > 0
        let cv = p[last] * 1.0
        let acv = cv
        if acv < 0.0
            acv = 0.0 - acv
        if acv > 0.0000000001
            // found non-zero trailing coeff — copy up to and including last
            let out = []
            let i = 0
            while i <= last
                let v = p[i] * 1.0
                push(out, v)
                i = i + 1
            return out
        last = last - 1
    // only the constant term remains
    let out2 = []
    let v0 = p[0] * 1.0
    push(out2, v0)
    out2

// --- Chebyshev T (first kind) ---

// cheb_t — coefficient list of T_n(x) via the three-term recurrence
//   T_0(x) = 1,  T_1(x) = x,
//   T_n(x) = 2x * T_{n-1}(x) - T_{n-2}(x).
fn cheb_t(n: int) -> list
    if n == 0
        let r = [1.0]
        return r
    let t0 = [1.0]
    if n == 1
        let r1 = [0.0, 1.0]
        return r1
    let t1 = [0.0, 1.0]
    let k = 2
    while k <= n
        let tx2 = cheb_mul2x(t1)
        let tn = cheb_polysub(tx2, t0)
        t0 = t1
        t1 = tn
        k = k + 1
    cheb_norm(t1)

// --- Chebyshev U (second kind) ---

// cheb_u — coefficient list of U_n(x) via the three-term recurrence
//   U_0(x) = 1,  U_1(x) = 2x,
//   U_n(x) = 2x * U_{n-1}(x) - U_{n-2}(x).
fn cheb_u(n: int) -> list
    if n == 0
        let r = [1.0]
        return r
    let u0 = [1.0]
    if n == 1
        let r1 = [0.0, 2.0]
        return r1
    let u1 = [0.0, 2.0]
    let k = 2
    while k <= n
        let ux2 = cheb_mul2x(u1)
        let un = cheb_polysub(ux2, u0)
        u0 = u1
        u1 = un
        k = k + 1
    cheb_norm(u1)

// --- Scalar evaluation via recurrence (no polynomial) ---

// cheb_eval_t — evaluate T_n(x) via scalar three-term recurrence.
// T_0=1, T_1=x, T_k = 2x*T_{k-1} - T_{k-2}.
// Returns float.
fn cheb_eval_t(n: int, x: float) -> float
    if n == 0
        let v = 1.0
        return v
    if n == 1
        let v1 = x * 1.0
        return v1
    let t0 = 1.0
    let t1 = x * 1.0
    let k = 2
    while k <= n
        let two_x_t1 = 2.0 * x * t1
        let tn = two_x_t1 - t0
        t0 = t1 * 1.0
        t1 = tn * 1.0
        k = k + 1
    let result = t1 * 1.0
    result

// cheb_eval_u — evaluate U_n(x) via scalar three-term recurrence.
// U_0=1, U_1=2x, U_k = 2x*U_{k-1} - U_{k-2}.
fn cheb_eval_u(n: int, x: float) -> float
    if n == 0
        let v = 1.0
        return v
    if n == 1
        let v2 = 2.0 * x
        return v2
    let u0 = 1.0
    let u1 = 2.0 * x
    let k = 2
    while k <= n
        let two_x_u1 = 2.0 * x * u1
        let un = two_x_u1 - u0
        u0 = u1 * 1.0
        u1 = un * 1.0
        k = k + 1
    let result = u1 * 1.0
    result

// --- Bisection-based roots of T_n (no trigonometry) ---

// cheb_roots_t — compute the n roots of T_n via sign-change bracketing + bisection.
// Strategy: scan 100*n+1 evenly-spaced points in (-1, 1) to find all n sign-change
// intervals, then bisect each interval to convergence (60 iterations).
// This approach requires no trigonometric functions.
// T_n has exactly n simple roots in (-1, 1).
// Returns list of n floats in ascending order.
fn cheb_roots_t(n: int) -> list
    if n <= 0
        let emp = []
        return emp
    if n == 1
        // T_1(x) = x; single root at 0
        let r = [0.0]
        return r
    // Scan m+1 points: x_i = -1 + i*(2/m), i=0..m
    // Use m = 100*n to ensure every sign change is captured.
    let m = 100 * n
    let mf = m * 1.0
    let roots = []
    let prev_x = -1.0
    let prev_f = cheb_eval_t(n, -1.0)
    let found = 0
    let idx = 1
    while idx <= m
        let cur_x = -1.0 + idx * 1.0 * 2.0 / mf
        let cur_f = cheb_eval_t(n, cur_x)
        // check if prev_f and cur_f have opposite signs (sign change between them)
        let do_bisect = 0
        let pf_neg = 0
        let cf_neg = 0
        if prev_f < 0.0
            pf_neg = 1
        if cur_f < 0.0
            cf_neg = 1
        if pf_neg != cf_neg
            do_bisect = 1
        if do_bisect == 1 and found < n
            // bisect [prev_x, cur_x] to find the root
            let lo = prev_x
            let hi = cur_x
            let fl = prev_f
            let biter = 0
            while biter < 60
                let mid = (lo + hi) * 0.5
                let fm = cheb_eval_t(n, mid)
                let afm = fm
                if afm < 0.0
                    afm = 0.0 - afm
                if afm < 0.0000000000001
                    lo = mid
                    hi = mid
                    biter = 60
                else
                    let fm_neg = 0
                    if fm < 0.0
                        fm_neg = 1
                    let fl_neg = 0
                    if fl < 0.0
                        fl_neg = 1
                    if fl_neg != fm_neg
                        hi = mid
                    else
                        lo = mid
                        fl = fm
                    biter = biter + 1
            let root = (lo + hi) * 0.5
            push(roots, root)
            found = found + 1
        prev_x = cur_x
        prev_f = cur_f
        idx = idx + 1
    roots

// --- Clenshaw evaluation of a Chebyshev series ---

// cheb_clenshaw — evaluate the Chebyshev series sum_{k=0}^{N} c_k * T_k(x)
// using the Clenshaw recurrence (numerically stable):
//   b_{N+1} = b_{N+2} = 0
//   b_k = c_k + 2x*b_{k+1} - b_{k+2}   for k = N..1
//   result = c_0 + x*b_1 - b_2
// coeffs[k] is the coefficient of T_k(x).
fn cheb_clenshaw(coeffs: list, x: float) -> float
    let n = len(coeffs)
    if n == 0
        let z = 0.0
        return z
    if n == 1
        let v = coeffs[0] * 1.0
        return v
    // b[N+1]=0, b[N+2]=0; we only need b_k, b_{k+1}, b_{k+2}
    let bkp2 = 0.0
    let bkp1 = 0.0
    let k = n - 1
    while k >= 1
        let ck = coeffs[k] * 1.0
        let bk = ck + 2.0 * x * bkp1 - bkp2
        bkp2 = bkp1
        bkp1 = bk
        k = k - 1
    // final step: result = c0 + x*b1 - b2
    let c0 = coeffs[0] * 1.0
    let res = c0 + x * bkp1 - bkp2
    res

// cheb_degree — degree of the n-th Chebyshev polynomial is n.
fn cheb_degree(n: int) -> int
    n
