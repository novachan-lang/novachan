// std/poly/polydiv.nova — polynomial long division over integer coefficients.
// Representation: list of coefficients in ASCENDING degree order.
//   coeffs[i] = coefficient of x^i.
// pd_divmod(a, b) -> dict {q, r} such that a == q*b + r and deg(r) < deg(b).
// Integer division is exact when b_lead divides all produced quotient numerators.
// LEAF — imports nothing.

// pd_normalize — strip trailing zero coefficients; [] represents the zero polynomial.
fn pd_normalize(p: list) -> any
    let n = len(p)
    let last = n - 1
    while last >= 0
        let v = p[last]
        if v != 0
            let out = []
            for i in 0..last + 1
                push(out, p[i])
            return out
        last -= 1
    let zero = []
    zero

// pd_degree — highest-index with nonzero coefficient; -1 for zero polynomial.
fn pd_degree(p: list) -> int
    let n = len(p)
    let d = n - 1
    while d >= 0
        if p[d] != 0
            return d
        d -= 1
    -1

// pd_is_zero — true iff p represents the zero polynomial.
fn pd_is_zero(p: list) -> bool
    pd_degree(p) == -1

// pd_copy — deep copy a list to avoid aliasing issues during mutation.
fn pd_copy(p: list) -> any
    let n = len(p)
    let out = []
    for i in 0..n
        push(out, p[i])
    out

// pd_mul_add_vec — helper: compute convolution product of q_coeff and b, add to rem at offset.
// Subtracts c*b[j] from rem at position (offset + j) for j in 0..lb-1.
fn pd_sub_scaled(rem: list, c: int, b: list, offset: int)
    let lb = len(b)
    for j in 0..lb
        let cur = rem[offset + j]
        rem[offset + j] = cur - c * b[j]

// pd_divmod — polynomial long division: returns dict with keys "q" and "r".
// a = q*b + r, deg(r) < deg(b).
// Panics (exits 1) if b is the zero polynomial.
fn pd_divmod(a: list, b: list) -> any
    let db = pd_degree(b)
    if db == -1
        print("pd_divmod: division by zero polynomial")
        exit(1)
    let da = pd_degree(a)
    let result = {}
    if da < db
        let zq = []
        result["q"] = zq
        let ar = pd_normalize(a)
        result["r"] = ar
        return result
    let na = da + 1
    // working copy of a (length = da+1, with enough room)
    let rem = [a[i] for i in 0..na]
    // quotient has degree da - db
    let qlen = da - db + 1
    let q = [0 for qi in 0..qlen]
    let b_lead = b[db]
    // iterate from highest degree down
    let step = da - db
    while step >= 0
        let cur_deg = step + db
        let cur_coef = rem[cur_deg]
        if cur_coef != 0
            let coef = cur_coef / b_lead
            q[step] = coef
            // subtract coef * b shifted by step from rem
            pd_sub_scaled(rem, coef, b, step)
        step -= 1
    let qn = pd_normalize(q)
    let rn = pd_normalize(rem)
    result["q"] = qn
    result["r"] = rn
    result

// pd_quotient — quotient of polynomial long division a / b.
fn pd_quotient(a: list, b: list) -> any
    let dm = pd_divmod(a, b)
    dm["q"]

// pd_remainder — remainder of polynomial long division a / b.
fn pd_remainder(a: list, b: list) -> any
    let dm = pd_divmod(a, b)
    dm["r"]

// pd_mod — remainder of polynomial long division; alias for pd_remainder.
fn pd_mod(a: list, b: list) -> any
    pd_remainder(a, b)

// pd_divides — true iff b divides a exactly (remainder is the zero polynomial).
fn pd_divides(a: list, b: list) -> bool
    let r = pd_remainder(a, b)
    pd_is_zero(r)

// pd_poly_eval_int — evaluate polynomial at integer x for pd_verify cross-check.
fn pd_poly_eval_int(p: list, x: int) -> int
    let n = len(p)
    if n == 0
        return 0
    let result = p[n - 1]
    let i = n - 2
    while i >= 0
        result = result * x + p[i]
        i -= 1
    result

// pd_poly_add_int — add two integer polynomials (no normalization needed here).
fn pd_poly_add_int(a: list, b: list) -> any
    let la = len(a)
    let lb = len(b)
    let lmax = la
    if lb > la
        lmax = lb
    let out = []
    for i in 0..lmax
        let va = 0
        let vb = 0
        if i < la
            va = a[i]
        if i < lb
            vb = b[i]
        push(out, va + vb)
    pd_normalize(out)

// pd_poly_mul_int — multiply two integer polynomials for verification.
fn pd_poly_mul_int(a: list, b: list) -> any
    let la = len(a)
    let lb = len(b)
    if la == 0
        let z = []
        return z
    if lb == 0
        let z = []
        return z
    let lout = la + lb - 1
    let out = []
    for k in 0..lout
        push(out, 0)
    for i in 0..la
        let ai = a[i]
        if ai != 0
            for j in 0..lb
                let cur = out[i + j]
                out[i + j] = cur + ai * b[j]
    pd_normalize(out)

// pd_poly_equal_int — check if two integer polynomials are equal.
fn pd_poly_equal_int(a: list, b: list) -> bool
    let na = pd_normalize(a)
    let nb = pd_normalize(b)
    let la = len(na)
    let lb = len(nb)
    if la != lb
        return false
    for i in 0..la
        if na[i] != nb[i]
            return false
    true

// pd_verify — verify that pd_divmod(a, b) satisfies a == q*b + r.
// tol is ignored for integer polys (kept in signature for API consistency).
fn pd_verify(a: list, b: list, tol: float) -> bool
    let dm = pd_divmod(a, b)
    let q = dm["q"]
    let r = dm["r"]
    let qb = pd_poly_mul_int(q, b)
    let reconstructed = pd_poly_add_int(qb, r)
    pd_poly_equal_int(reconstructed, a)

// pd_synthetic — synthetic division of p by (x - root).
// Returns the quotient polynomial (degree = deg(p) - 1).
// Uses the synthetic (Horner-based) division algorithm.
fn pd_synthetic(p: list, root: int) -> any
    let n = len(p)
    if n <= 1
        let z = []
        return z
    // work from high degree to low; result has n-1 coefficients in high-to-low order
    // then reverse to ascending
    let hi = n - 1
    let acc = p[hi]
    let q_hi = []
    // collect quotient coefficients from degree hi-1 down to 0
    let i = hi - 1
    while i >= 0
        push(q_hi, acc)
        acc = acc * root + p[i]
        i -= 1
    // q_hi is in descending order; reverse to ascending
    let qlen = len(q_hi)
    let out = []
    let j = qlen - 1
    while j >= 0
        push(out, q_hi[j])
        j -= 1
    pd_normalize(out)
