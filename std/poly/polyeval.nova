// std/poly/polyeval.nova — polynomial evaluation (Horner's method and variants).
// Polynomial representation: list of coefficients in ASCENDING order.
// coeffs[i] = coefficient of x^i.  E.g. [6,-5,1] = 6 - 5x + x^2.
// LEAF — imports nothing.
//
// FLOAT HAZARDS:
//   Bind every sub-expression to a named let before passing to another call.
//   Float vs int compare UNSOUND — coerce via *1.0.
//   abs(float): use (if v < 0.0 then 0.0 - v else v).

// Evaluate polynomial at x (float) using Horner's method; returns float.
fn pe_eval(p, x) -> float
    let n = len(p)
    if n == 0
        let z = 0.0
        return z
    let result = p[n - 1] * 1.0
    let i = n - 2
    while i >= 0
        let ci = p[i] * 1.0
        result = result * x + ci
        i = i - 1
    result

// Evaluate polynomial at integer x using exact integer arithmetic; returns int.
fn pe_eval_int(p, x) -> int
    let n = len(p)
    if n == 0
        return 0
    let result = p[n - 1]
    let i = n - 2
    while i >= 0
        let ci = p[i]
        result = result * x + ci
        i = i - 1
    result

// Evaluate polynomial at each point in xs; returns list of float results.
fn pe_eval_all(p, xs) -> any
    let m = len(xs)
    let out = []
    for i in 0..m
        let xi = xs[i] * 1.0
        let v = pe_eval(p, xi)
        push(out, v)
    out

// Evaluate the formal derivative p'(x) at x using Horner; returns float.
// p'(x) = c1 + 2*c2*x + 3*c3*x^2 + ...  evaluated via a second Horner pass.
fn pe_eval_deriv(p, x) -> float
    let n = len(p)
    if n <= 1
        let z = 0.0
        return z
    // build derivative coefficient list
    let d = []
    for i in 1..n
        let ci = p[i] * 1.0
        let di = i * 1.0
        let v = ci * di
        push(d, v)
    let dn = len(d)
    let result = d[dn - 1] * 1.0
    let j = dn - 2
    while j >= 0
        let cj = d[j] * 1.0
        result = result * x + cj
        j = j - 1
    result

// Evaluate polynomial at x (float) using Horner's method (alias for pe_eval).
fn pe_horner(p, x) -> float
    let r = pe_eval(p, x)
    r

// Return list of each monomial term's value: [c0, c1*x, c2*x^2, ...].
fn pe_eval_monomials(p, x) -> any
    let n = len(p)
    let out = []
    let xpow = 1.0
    for i in 0..n
        let ci = p[i] * 1.0
        let term = ci * xpow
        push(out, term)
        xpow = xpow * x
    out

// Sum of all coefficients: equals p(1).
fn pe_sum_coeffs(p) -> int
    let n = len(p)
    let s = 0
    for i in 0..n
        let ci = p[i]
        s = s + ci
    s

// Alternating sum of coefficients: equals p(-1).
// pe_alt_sum([c0,c1,c2,...]) = c0 - c1 + c2 - ...
fn pe_alt_sum(p) -> int
    let n = len(p)
    let s = 0
    let sign = 1
    for i in 0..n
        let ci = p[i]
        s = s + sign * ci
        sign = 0 - sign
    s
