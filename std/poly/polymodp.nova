// ============================================================================
// NOVA Standard Library — std/poly/polymodp
// ============================================================================
// Polynomial arithmetic over GF(p) — all coefficients reduced mod p in [0, p).
// Polynomials in ascending coefficient order: p[i] = coefficient of x^i.
// All public functions prefix pmp_.
// ============================================================================

// pmp_pos_mod — reduce integer n mod p to [0, p) (handles negatives)
fn pmp_pos_mod(n, p) -> int
    let r = n - (n / p) * p
    if r < 0
        r += p
    return r

// pmp_mod_coeffs — reduce each coefficient mod p into [0, p), strip trailing zeros
fn pmp_mod_coeffs(poly, p) -> any
    let n = len(poly)
    let out = []
    for i in 0..n
        push(out, pmp_pos_mod(poly[i], p))
    // Strip trailing zeros
    let last = len(out) - 1
    while last > 0 and out[last] == 0
        last -= 1
    let result = []
    let k = 0
    while k <= last
        push(result, out[k])
        k += 1
    return result

// pmp_is_zero — check if polynomial is the zero polynomial over GF(p)
fn pmp_is_zero(poly, p) -> bool
    let reduced = pmp_mod_coeffs(poly, p)
    if len(reduced) == 0
        return true
    if len(reduced) == 1 and reduced[0] == 0
        return true
    return false

// pmp_add — coefficient-wise addition mod p
fn pmp_add(a, b, p) -> any
    let na = len(a)
    let nb = len(b)
    let nc = na
    if nb > nc
        nc = nb
    let out = []
    for i in 0..nc
        let va = 0
        if i < na
            va = a[i]
        let vb = 0
        if i < nb
            vb = b[i]
        push(out, pmp_pos_mod(va + vb, p))
    return pmp_mod_coeffs(out, p)

// pmp_sub — coefficient-wise subtraction mod p
fn pmp_sub(a, b, p) -> any
    let na = len(a)
    let nb = len(b)
    let nc = na
    if nb > nc
        nc = nb
    let out = []
    for i in 0..nc
        let va = 0
        if i < na
            va = a[i]
        let vb = 0
        if i < nb
            vb = b[i]
        push(out, pmp_pos_mod(va - vb, p))
    return pmp_mod_coeffs(out, p)

// pmp_mul — polynomial multiplication mod p
fn pmp_mul(a, b, p) -> any
    let na = len(a)
    let nb = len(b)
    if na == 0 or nb == 0
        return [0]
    let nc = na + nb - 1
    let out = []
    let k = 0
    while k < nc
        push(out, 0)
        k += 1
    for i in 0..na
        let j = 0
        while j < nb
            out[i + j] = pmp_pos_mod(out[i + j] + a[i] * b[j], p)
            j += 1
    return pmp_mod_coeffs(out, p)

// pmp_scale — multiply polynomial by scalar s mod p
fn pmp_scale(poly, s, p) -> any
    let n = len(poly)
    let out = [pmp_pos_mod(poly[i] * s, p) for i in 0..n]
    return pmp_mod_coeffs(out, p)

// pmp_eval — evaluate polynomial at x mod p using Horner's method
fn pmp_eval(poly, x, p) -> int
    let n = len(poly)
    if n == 0
        return 0
    let result = pmp_pos_mod(poly[n - 1], p)
    let i = n - 2
    while i >= 0
        result = pmp_pos_mod(result * x + poly[i], p)
        i -= 1
    return result

// pmp_inverse_coeff — modular inverse of scalar a mod p via extended Euclidean
// Returns 0 if a and p are not coprime (no inverse).
fn pmp_inverse_coeff(a, p) -> int
    let a0 = pmp_pos_mod(a, p)
    if a0 == 0
        return 0
    // Extended Euclidean algorithm
    let old_r = p
    let r = a0
    let old_s = 0
    let s = 1
    while r != 0
        let q = old_r / r
        let temp_r = r
        r = old_r - q * r
        old_r = temp_r
        let temp_s = s
        s = old_s - q * s
        old_s = temp_s
    // old_r is gcd; old_s is the Bezout coefficient for a0
    if old_r != 1
        return 0
    return pmp_pos_mod(old_s, p)

// pmp_divmod — polynomial long division over GF(p): returns [quotient, remainder]
// Divides a by b mod p. Returns [[q coeffs], [r coeffs]].
fn pmp_divmod(a, b, p) -> any
    let ra = pmp_mod_coeffs(a, p)
    let rb = pmp_mod_coeffs(b, p)
    let nb = len(rb)
    if nb == 0 or (nb == 1 and rb[0] == 0)
        // Division by zero: return empty quotient and remainder = a
        let err = []
        push(err, [])
        push(err, ra)
        return err
    // Copy ra into working remainder
    let rem = [ra[i] for i in 0..len(ra)]
    let na = len(rem)
    let deg_b = nb - 1
    let deg_a = na - 1
    // Inverse of leading coefficient of b
    let lead_b_inv = pmp_inverse_coeff(rb[deg_b], p)
    // Quotient has degree deg_a - deg_b if deg_a >= deg_b
    let quot_len = deg_a - deg_b + 1
    if quot_len <= 0
        quot_len = 0
    let quot = [0 for qi in 0..quot_len]
    let step = deg_a
    while step >= deg_b
        let lead_rem = rem[step]
        if lead_rem != 0
            let coeff = pmp_pos_mod(lead_rem * lead_b_inv, p)
            quot[step - deg_b] = coeff
            // Subtract coeff * b * x^(step-deg_b) from rem
            for j in 0..nb
                rem[step - deg_b + j] = pmp_pos_mod(rem[step - deg_b + j] - coeff * rb[j], p)
        step -= 1
    let quot_norm = pmp_mod_coeffs(quot, p)
    let rem_norm = pmp_mod_coeffs(rem, p)
    let result = []
    push(result, quot_norm)
    push(result, rem_norm)
    return result

// pmp_pow — compute poly^k modulo mod_poly over GF(p) via repeated squaring
fn pmp_pow(poly, k, mod_poly, p) -> any
    // Start with 1 (constant polynomial [1])
    let result = []
    push(result, 1)
    let base = pmp_mod_coeffs(poly, p)
    let exp = k
    while exp > 0
        if exp - (exp / 2) * 2 == 1
            // exp is odd
            let tmp = pmp_mul(result, base, p)
            let dm = pmp_divmod(tmp, mod_poly, p)
            result = dm[1]
        let tmp2 = pmp_mul(base, base, p)
        let dm2 = pmp_divmod(tmp2, mod_poly, p)
        base = dm2[1]
        exp = exp / 2
    return result

fn main()
    print("polymodp module OK")
