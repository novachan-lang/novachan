// ============================================================================
// NOVA Standard Library — std/itertools/it_take_drop
// Slicing, stepping, and sub-list helpers for int lists.
// Self-contained — imports nothing.
// All public functions are prefixed itt_.
// ============================================================================

// itt_take(xs, n) — first n elements; clamped to [0, len(xs)].
fn itt_take(xs, n)
    let out = []
    let lim = n
    if lim > len(xs)
        lim = len(xs)
    if lim < 0
        lim = 0
    let i = 0
    while i < lim
        out = out + [xs[i]]
        i = i + 1
    return out

// itt_drop(xs, n) — all elements after the first n; n < 0 treated as 0.
fn itt_drop(xs, n)
    let out = []
    let i = n
    if i < 0
        i = 0
    while i < len(xs)
        out = out + [xs[i]]
        i = i + 1
    return out

// itt_take_last(xs, n) — last n elements; clamped to [0, len(xs)].
fn itt_take_last(xs, n)
    let out = []
    let total = len(xs)
    let lim = n
    if lim > total
        lim = total
    if lim < 0
        lim = 0
    let start = total - lim
    let i = start
    while i < total
        out = out + [xs[i]]
        i = i + 1
    return out

// itt_drop_last(xs, n) — all elements except the last n; n < 0 treated as 0.
fn itt_drop_last(xs, n)
    let out = []
    let total = len(xs)
    let stop = total - n
    if stop < 0
        stop = 0
    let i = 0
    while i < stop
        out = out + [xs[i]]
        i = i + 1
    return out

// itt_slice(xs, start, stop) — elements at indices [start, stop); clamps to valid range.
fn itt_slice(xs, start, stop)
    let out = []
    let n = len(xs)
    let s = start
    let e = stop
    if s < 0
        s = 0
    if e > n
        e = n
    let i = s
    while i < e
        out = out + [xs[i]]
        i = i + 1
    return out

// itt_step(xs, step) — every step-th element starting at index 0; step <= 0 returns [].
fn itt_step(xs, step)
    let out = []
    if step <= 0
        return out
    let n = len(xs)
    let i = 0
    while i < n
        out = out + [xs[i]]
        i = i + step
    return out
