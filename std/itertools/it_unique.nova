// ============================================================================
// NOVA Standard Library — std/itertools/it_unique.nova
// Deduplication and uniqueness helpers. Operates on lists of ints.
// ============================================================================
// RAISED 2026-08-05. Two bugs, not one. (1) The classic `out = out + [x]`
// quadratic append. (2) Every function ALSO kept "seen" as a plain list and
// scanned it linearly per element (`while k < len(seen)`) — that is its own
// O(n^2), independent of the append bug, since a duplicate check against an
// n-element list costs O(n). Both are fixed by using the runtime hash set
// (set_create/set_has/set_add, O(1) amortized per op) — the same fix
// std/core/collect.unique already made. itu_unique now delegates to it
// directly (contract match verified below); the other three keep their own
// early-exit / first-extra-occurrence logic but on a set instead of a list.
import std/core/collect

// itu_unique(xs) — return xs with duplicates removed, preserving first-occurrence order.
// [] -> []. [1,2,1,3,2] -> [1,2,3].
fn itu_unique(xs)
    unique(xs)

// itu_count_distinct(xs) — number of distinct values in xs.
// [1,2,1,3,2] -> 3.
fn itu_count_distinct(xs)
    len(unique(xs))

// itu_duplicates(xs) — values that appear more than once, in first-extra-occurrence order,
// each duplicate value listed once. [1,2,1,3,2,2] -> [1,2].
fn itu_duplicates(xs)
    let seen = set_create()
    let reported = set_create()
    let dups = []
    for v in xs
        if set_has(seen, v)
            if not set_has(reported, v)
                set_add(reported, v)
                push(dups, v)
        else
            set_add(seen, v)
    return dups

// itu_is_unique(xs) — 1 (true) if no value appears more than once, 0 (false) otherwise.
// [1,2,3] -> 1. [1,1] -> 0.
fn itu_is_unique(xs)
    let seen = set_create()
    for v in xs
        if set_has(seen, v)
            return 0
        set_add(seen, v)
    return 1
