// ============================================================================
// NOVA Standard Library — std/itertools/it_unique.nova
// Deduplication and uniqueness helpers. Operates on lists of ints.
// Pure NOVA — no imports, no builtins beyond len/str/exit/print.
// ============================================================================

// itu_unique(xs) — return xs with duplicates removed, preserving first-occurrence order.
// [] -> []. [1,2,1,3,2] -> [1,2,3].
fn itu_unique(xs)
    let out = []
    let seen = []
    let i = 0
    while i < len(xs)
        let v = xs[i]
        let found = 0
        let k = 0
        while k < len(seen)
            if seen[k] == v
                found = 1
            k = k + 1
        if found == 0
            seen = seen + [v]
            out = out + [v]
        i = i + 1
    return out

// itu_count_distinct(xs) — number of distinct values in xs.
// [1,2,1,3,2] -> 3.
fn itu_count_distinct(xs)
    let seen = []
    let i = 0
    while i < len(xs)
        let v = xs[i]
        let found = 0
        let k = 0
        while k < len(seen)
            if seen[k] == v
                found = 1
            k = k + 1
        if found == 0
            seen = seen + [v]
        i = i + 1
    return len(seen)

// itu_duplicates(xs) — values that appear more than once, in first-extra-occurrence order,
// each duplicate value listed once. [1,2,1,3,2,2] -> [1,2].
fn itu_duplicates(xs)
    let seen = []
    let dups = []
    let reported = []
    let i = 0
    while i < len(xs)
        let v = xs[i]
        let in_seen = 0
        let k = 0
        while k < len(seen)
            if seen[k] == v
                in_seen = 1
            k = k + 1
        if in_seen == 0
            seen = seen + [v]
        if in_seen == 1
            let already = 0
            let m = 0
            while m < len(reported)
                if reported[m] == v
                    already = 1
                m = m + 1
            if already == 0
                reported = reported + [v]
                dups = dups + [v]
        i = i + 1
    return dups

// itu_is_unique(xs) — 1 (true) if no value appears more than once, 0 (false) otherwise.
// [1,2,3] -> 1. [1,1] -> 0.
fn itu_is_unique(xs)
    let seen = []
    let i = 0
    while i < len(xs)
        let v = xs[i]
        let found = 0
        let k = 0
        while k < len(seen)
            if seen[k] == v
                found = 1
            k = k + 1
        if found == 1
            return 0
        seen = seen + [v]
        i = i + 1
    return 1
