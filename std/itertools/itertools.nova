// ============================================================================
// NOVA Standard Library — std/itertools/itertools.nova
// Iterator combinators over lists (return lists).
// ============================================================================
// RAISED 2026-08-05. This module was written under a self-imposed constraint the
// header used to state as "All functions are pure NOVA — no new builtins required."
// That constraint had a severe cost: every one of the ten functions built its
// result with `out = out + [x]` inside a `while`.
//
// `out + [x]` ALLOCATES A NEW LIST AND COPIES ALL OF `out`. Doing that once per
// element makes every function here QUADRATIC — 1 + 2 + ... + n = n(n+1)/2 element
// copies. it_range(0, 10000) performed ~50 million copies to produce 10,000 ints.
// A comprehension appends in place: O(n), one allocation.
//
// So this is not a style pass. The output of every function is UNCHANGED — same
// elements, same order, same edge-case behaviour — and the cost went from O(n^2)
// to O(n). The two-level functions (it_windowed, it_chunked, it_flatten) were
// quadratic in BOTH loops, so they improve more than that.
//
// The second change is REUSE. it_windowed and it_chunked were re-implementations
// of `windows` and `chunk` in std/core/collect, and it_flatten of `flatten` there.
// Each was checked line by line against its counterpart before delegating — the
// edge cases (k <= 0, k > len, empty input, short final chunk) agree exactly.
// This module is now the thin naming façade it was always meant to be.
import std/core/collect

// it_range(a, b) — integers from a (inclusive) to b (exclusive).
// Empty when a >= b, because that is what the range itself is.
fn it_range(a: int, b: int) -> list
    [i for i in a..b]

// it_chain(xs, ys) — concatenate two lists.
// Spread says "both, in order" directly; the old version walked each with its own
// index loop and paid the copy cost twice.
fn it_chain(xs: list, ys: list) -> list
    [...xs, ...ys]

// it_zip(xs, ys) — pair elements: [[xs[0],ys[0]], [xs[1],ys[1]], ...].
// Truncates to the shorter input.
fn it_zip(xs: list, ys: list) -> list
    let m = min(len(xs), len(ys))
    [[xs[i], ys[i]] for i in 0..m]

// it_take(xs, n) — first n elements, clamped: n > len yields the whole list,
// n <= 0 yields [].
fn it_take(xs: list, n: int) -> list
    let lim = min(n, len(xs))
    if lim <= 0
        return []
    [xs[i] for i in 0..lim]

// it_drop(xs, n) — all but the first n elements. A negative n drops nothing.
fn it_drop(xs: list, n: int) -> list
    let start = max(n, 0)
    if start >= len(xs)
        return []
    [xs[i] for i in start..len(xs)]

// it_windowed(xs, k) — sliding windows of size k, step 1; a short tail window is
// omitted. Delegates to std/core/collect.windows, which has the identical
// contract: k <= 0 or k > len(xs) gives [], otherwise len(xs) - k + 1 windows.
fn it_windowed(xs: list, k: int) -> list
    windows(xs, k)

// it_chunked(xs, k) — non-overlapping chunks of size k; the last may be short;
// k <= 0 gives []. Delegates to std/core/collect.chunk, same contract.
fn it_chunked(xs: list, k: int) -> list
    chunk(xs, k)

// it_enumerate(xs) — [[0, xs[0]], [1, xs[1]], ...].
// Indexed rather than `for i, v in xs` so the pair is built explicitly: this
// function's whole job is to MATERIALISE the index/value pair as data.
fn it_enumerate(xs: list) -> list
    [[i, xs[i]] for i in 0..len(xs)]

// it_flatten(xss) — concatenate a list of lists into one flat list.
// Delegates to std/core/collect.flatten, which additionally passes a non-list
// element through unchanged instead of relying on len() of a non-list.
fn it_flatten(xss: list) -> list
    flatten(xss)

// it_repeat(x, n) — n copies of x. n <= 0 gives [].
fn it_repeat(x: any, n: int) -> list
    if n <= 0
        return []
    [x for _ in 0..n]
