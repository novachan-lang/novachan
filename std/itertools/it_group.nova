// ============================================================================
// NOVA Standard Library — std/itertools/it_group.nova
// Run-length grouping and encoding helpers. Operates on lists of ints.
// Pure NOVA — no imports, no builtins beyond len/str/exit/print.
// ============================================================================

// itg_group_consecutive(xs) — split xs into sublists of equal adjacent values.
// [] -> []. [1,1,2] -> [[1,1],[2]].
fn itg_group_consecutive(xs)
    let out = []
    let n = len(xs)
    if n == 0
        return out
    let i = 0
    while i < n
        let run = []
        let v = xs[i]
        run = run + [v]
        let j = i + 1
        while j < n and xs[j] == v
            run = run + [xs[j]]
            j = j + 1
        out = out + [run]
        i = j
    return out

// itg_rle(xs) — run-length encode xs as list of [value, count] pairs.
// [] -> []. [1,1,2,3,3,3] -> [[1,2],[2,1],[3,3]].
fn itg_rle(xs)
    let out = []
    let n = len(xs)
    if n == 0
        return out
    let i = 0
    while i < n
        let v = xs[i]
        let cnt = 1
        let j = i + 1
        while j < n and xs[j] == v
            cnt = cnt + 1
            j = j + 1
        let pair = [v, cnt]
        out = out + [pair]
        i = j
    return out

// itg_rle_decode(pairs) — decode run-length pairs [[value,count],...] back to flat list.
// [[1,2],[2,1],[3,3]] -> [1,1,2,3,3,3].
fn itg_rle_decode(pairs)
    let out = []
    let i = 0
    while i < len(pairs)
        let pair = pairs[i]
        let v = pair[0]
        let cnt = pair[1]
        let k = 0
        while k < cnt
            out = out + [v]
            k = k + 1
        i = i + 1
    return out

// itg_run_lengths(xs) — return just the consecutive run counts (not values).
// [1,1,2,3,3,3] -> [2,1,3]. [] -> [].
fn itg_run_lengths(xs)
    let out = []
    let n = len(xs)
    if n == 0
        return out
    let i = 0
    while i < n
        let v = xs[i]
        let cnt = 1
        let j = i + 1
        while j < n and xs[j] == v
            cnt = cnt + 1
            j = j + 1
        out = out + [cnt]
        i = j
    return out
