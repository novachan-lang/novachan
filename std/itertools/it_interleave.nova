// ============================================================================
// NOVA Standard Library — std/itertools/it_interleave.nova
// Interleaving and interspersing helpers. Operates on lists of ints.
// ============================================================================
// RAISED 2026-08-05. Every function built its result with `out = out + [x]`
// inside a `while` — O(n^2) copies. iti_interleave and iti_weave are now
// delegated to std/core/collect (interleave / zip_with+flatten) — contracts
// checked element-by-element below and confirmed byte-identical by
// _hldiff.sh. iti_intersperse became a single chained (flat-map)
// comprehension. iti_roundrobin keeps its two nested loops (the "skip
// exhausted lists" logic is irregular — it is not a fixed-size product) but
// switched from index `while` to `for`-in and from `+` to `push`.
import std/core/collect

// iti_interleave(a, b) — alternate elements a[0],b[0],a[1],b[1],...
// then append the remainder of the longer list.
// iti_interleave([1,2,3],[4,5,6]) -> [1,4,2,5,3,6].
// iti_interleave([1,2,3],[4]) -> [1,4,2,3].
// Delegates to collect.interleave: it woven-zips the common prefix then
// spreads whichever tail is non-empty — the identical alternate-then-append
// contract, verified by _hldiff.sh.
fn iti_interleave(a, b)
    interleave(a, b)

// iti_intersperse(xs, sep) — insert sep between each adjacent pair of elements.
// [1,2,3], 0 -> [1,0,2,0,3]. Single element -> [xs[0]]. [] -> [].
// One flat-map comprehension: element 0 contributes just itself, every later
// element contributes [sep, xs[i]] — chained `for` flattens that automatically.
fn iti_intersperse(xs, sep)
    let n = len(xs)
    [y for i in 0..n for y in ([sep, xs[i]] if i > 0 else [xs[i]])]

// iti_roundrobin(lists) — take index 0 from each list, then index 1, etc.,
// skipping lists that have been exhausted.
// [[1,2],[3,4],[5,6]] -> [1,3,5,2,4,6].
fn iti_roundrobin(lists)
    if len(lists) == 0
        return []
    let maxlen = list_max([len(l) for l in lists])
    let out = []
    for round in 0..maxlen
        for l in lists
            if round < len(l)
                push(out, l[round])
    return out

// iti_weave(a, b) — strict alternation, stop at the shorter list.
// [1,2,3],[4,5] -> [1,4,2,5]. Both same length -> full interleave without remainder.
// Delegates: zip corresponding elements into pairs, then flatten — exactly
// what the manual "while i < min" loop did, without the remainder append.
fn iti_weave(a, b)
    flatten(zip_with(a, b, fn(x, y) [x, y]))
