// ============================================================================
// NOVA Standard Library — std/itertools/it_product.nova
// Cartesian-product helpers for int lists.
// Prefix: itpr_
// ============================================================================
// RAISED 2026-08-05. Every function built its result with `out = out + [x]`
// (and the pair/triple rows too) inside nested `while` loops — quadratic on
// top of the already-combinatorial output size. Rewritten as chained
// (flat-map) comprehensions: `for i in .. for j in ..` walks the SAME
// row-major order the nested while loops did, one allocation per row instead
// of a copy-the-whole-list-so-far append.
fn itpr_cartesian(a, b)
    [[a[i], b[j]] for i in 0..len(a) for j in 0..len(b)]

// itpr_cartesian3(a, b, c) — all [a[i], b[j], c[k]] triples in row-major order.
fn itpr_cartesian3(a, b, c)
    [[a[i], b[j], c[k]] for i in 0..len(a) for j in 0..len(b) for k in 0..len(c)]

// itpr_count(a, b) — number of pairs in cartesian product = len(a) * len(b).
fn itpr_count(a, b)
    return len(a) * len(b)

// itpr_pairs_upper(xs) — all [xs[i], xs[j]] with i < j (upper-triangular pairs).
fn itpr_pairs_upper(xs)
    let n = len(xs)
    [[xs[i], xs[j]] for i in 0..n for j in (i + 1)..n]
