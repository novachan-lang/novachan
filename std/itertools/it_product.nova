// ============================================================================
// NOVA Standard Library — std/itertools/it_product.nova
// Cartesian-product helpers for int lists.
// Prefix: itpr_
// ============================================================================

// itpr_cartesian(a, b) — all [a[i], b[j]] pairs in row-major order; either empty => [].
fn itpr_cartesian(a, b)
    let out = []
    let la = len(a)
    let lb = len(b)
    let i = 0
    while i < la
        let j = 0
        while j < lb
            let pair = []
            pair = pair + [a[i]]
            pair = pair + [b[j]]
            out = out + [pair]
            j = j + 1
        i = i + 1
    return out

// itpr_cartesian3(a, b, c) — all [a[i], b[j], c[k]] triples in row-major order.
fn itpr_cartesian3(a, b, c)
    let out = []
    let la = len(a)
    let lb = len(b)
    let lc = len(c)
    let i = 0
    while i < la
        let j = 0
        while j < lb
            let k = 0
            while k < lc
                let triple = []
                triple = triple + [a[i]]
                triple = triple + [b[j]]
                triple = triple + [c[k]]
                out = out + [triple]
                k = k + 1
            j = j + 1
        i = i + 1
    return out

// itpr_count(a, b) — number of pairs in cartesian product = len(a) * len(b).
fn itpr_count(a, b)
    return len(a) * len(b)

// itpr_pairs_upper(xs) — all [xs[i], xs[j]] with i < j (upper-triangular pairs).
fn itpr_pairs_upper(xs)
    let out = []
    let n = len(xs)
    let i = 0
    while i < n
        let j = i + 1
        while j < n
            let pair = []
            pair = pair + [xs[i]]
            pair = pair + [xs[j]]
            out = out + [pair]
            j = j + 1
        i = i + 1
    return out
