// std/itertools/it_accumulate.nova — Prefix-scan / running-aggregate helpers.
// LEAF — imports NOTHING.
//
// Public API (prefix ita_):
//   ita_sums(xs)     -> list  prefix sums     (same length as xs; [] for empty)
//   ita_products(xs) -> list  prefix products (same length as xs; [] for empty)
//   ita_maxima(xs)   -> list  running maximum (same length as xs; [] for empty)
//   ita_minima(xs)   -> list  running minimum (same length as xs; [] for empty)
//   ita_diffs(xs)    -> list  adjacent differences (length len(xs)-1; [] for 0 or 1 elem)

// ita_sums — prefix sums: out[i] = xs[0]+xs[1]+...+xs[i].
fn ita_sums(xs) -> any
    let out = []
    let n = len(xs)
    if n == 0
        return out
    let acc = xs[0]
    push(out, acc)
    let i = 1
    while i < n
        acc = acc + xs[i]
        push(out, acc)
        i = i + 1
    return out

// ita_products — prefix products: out[i] = xs[0]*xs[1]*...*xs[i].
fn ita_products(xs) -> any
    let out = []
    let n = len(xs)
    if n == 0
        return out
    let acc = xs[0]
    push(out, acc)
    let i = 1
    while i < n
        acc = acc * xs[i]
        push(out, acc)
        i = i + 1
    return out

// ita_maxima — running maximum: out[i] = max(xs[0..i]).
fn ita_maxima(xs) -> any
    let out = []
    let n = len(xs)
    if n == 0
        return out
    let cur = xs[0]
    push(out, cur)
    let i = 1
    while i < n
        if xs[i] > cur
            cur = xs[i]
        push(out, cur)
        i = i + 1
    return out

// ita_minima — running minimum: out[i] = min(xs[0..i]).
fn ita_minima(xs) -> any
    let out = []
    let n = len(xs)
    if n == 0
        return out
    let cur = xs[0]
    push(out, cur)
    let i = 1
    while i < n
        if xs[i] < cur
            cur = xs[i]
        push(out, cur)
        i = i + 1
    return out

// ita_diffs — adjacent differences: out[i] = xs[i+1]-xs[i]; length = len(xs)-1.
fn ita_diffs(xs) -> any
    let out = []
    let n = len(xs)
    if n <= 1
        return out
    let i = 0
    while i < n - 1
        push(out, xs[i + 1] - xs[i])
        i = i + 1
    return out
