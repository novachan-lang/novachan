// ============================================================================
// NOVA Standard Library — std/itertools/it_partition.nova
// Partition helpers: split, halve, parity-split, chunked-runs.
// All functions are pure NOVA — int lists in, list-of-lists out.
// Prefix: itp_
// ============================================================================
// RAISED 2026-08-05. Every function here built its result with `out = out +
// [x]` inside a `while` — O(n^2) copies for an O(n) job. Rewritten as
// comprehensions (regular index ranges) or delegated to std/core/collect
// (identical contract, verified below). Same elements, same order.
import std/core/collect

// itp_split_at(xs, i) — split xs into [xs[0..i), xs[i..n)]; i clamped to [0,n].
fn itp_split_at(xs, i)
    let n = len(xs)
    let cut = i
    if cut < 0
        cut = 0
    if cut > n
        cut = n
    return [[xs[j] for j in 0..cut], [xs[k] for k in cut..n]]

// itp_partition_parity(xs) — [evens_by_value, odds_by_value] preserving order.
// Delegates to collect.partition(xs, pred): pred = "is even", yes/no built via
// two `.filter` passes — same order-preserving semantics as the manual scan.
fn itp_partition_parity(xs)
    partition(xs, fn(v) v % 2 == 0)

// itp_halve(xs) — [first floor(n/2) elements, rest]; empty stays [[], []].
fn itp_halve(xs)
    let n = len(xs)
    let half = n / 2
    return [[xs[i] for i in 0..half], [xs[j] for j in half..n]]

// itp_split_runs(xs, n) — chunk xs into consecutive runs of length n (last may be shorter); n<=0 returns [].
// Identical contract to collect.chunk (and to itc_chunk in it_chunk.nova):
// n<=0 -> [], otherwise ceil(len/n) chunks, last one short. Delegates.
fn itp_split_runs(xs, n)
    chunk(xs, n)
