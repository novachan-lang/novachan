// ============================================================================
// NOVA Standard Library — std/itertools/it_rotate.nova
// Rotation and cyclic helpers for int lists.
// Prefix: itr_
// ============================================================================

// itr_rotate_left(xs, k) — rotate left by k mod len(xs); empty or k==0 returns copy.
fn itr_rotate_left(xs, k)
    let n = len(xs)
    let out = []
    if n == 0
        return out
    let shift = k % n
    if shift < 0
        shift = shift + n
    let i = shift
    while i < n
        out = out + [xs[i]]
        i = i + 1
    let j = 0
    while j < shift
        out = out + [xs[j]]
        j = j + 1
    return out

// itr_rotate_right(xs, k) — rotate right by k mod len(xs).
fn itr_rotate_right(xs, k)
    let n = len(xs)
    let out = []
    if n == 0
        return out
    let shift = k % n
    if shift < 0
        shift = shift + n
    let start = n - shift
    let i = start
    while i < n
        out = out + [xs[i]]
        i = i + 1
    let j = 0
    while j < start
        out = out + [xs[j]]
        j = j + 1
    return out

// itr_cycle_take(xs, n) — repeat xs cyclically to produce exactly n elements; xs empty or n<=0 returns [].
fn itr_cycle_take(xs, n)
    let out = []
    let m = len(xs)
    if m == 0
        return out
    if n <= 0
        return out
    let i = 0
    while i < n
        out = out + [xs[i % m]]
        i = i + 1
    return out

// itr_reverse(xs) — reverse the list.
fn itr_reverse(xs)
    let n = len(xs)
    let out = []
    let i = n - 1
    while i >= 0
        out = out + [xs[i]]
        i = i - 1
    return out
