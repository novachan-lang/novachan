// ============================================================================
// NOVA Standard Library — std/itertools/it_chunk
// Chunking and even-split helpers for int lists.
// Self-contained — imports nothing.
// All public functions are prefixed itc_.
// ============================================================================

// itc_chunk(xs, size) — split xs into consecutive chunks of `size`; last chunk may be shorter.
fn itc_chunk(xs, size)
    let out = []
    if size <= 0
        return out
    let i = 0
    while i < len(xs)
        let row = []
        let j = 0
        while j < size and i + j < len(xs)
            row = row + [xs[i + j]]
            j = j + 1
        out = out + [row]
        i = i + size
    return out

// itc_chunk_pad(xs, size, pad) — same as itc_chunk but pads the last chunk to exactly `size` with `pad`.
fn itc_chunk_pad(xs, size, pad)
    let out = []
    if size <= 0
        return out
    let i = 0
    while i < len(xs)
        let row = []
        let j = 0
        while j < size
            if i + j < len(xs)
                row = row + [xs[i + j]]
            else
                row = row + [pad]
            j = j + 1
        out = out + [row]
        i = i + size
    return out

// itc_chunk_count(xs, size) — number of chunks that itc_chunk would produce (ceiling division).
fn itc_chunk_count(xs, size)
    if size <= 0
        return 0
    let n = len(xs)
    if n == 0
        return 0
    return (n + size - 1) / size

// itc_evenly(xs, n) — split xs into n roughly-equal contiguous chunks;
// earlier chunks get one extra element when len(xs) does not divide evenly.
// Returns [] if n <= 0 or xs is empty.
fn itc_evenly(xs, n)
    let out = []
    if n <= 0
        return out
    let total = len(xs)
    if total == 0
        return out
    let base = total / n
    let extra = total - base * n
    let i = 0
    let c = 0
    while c < n
        let sz = base
        if c < extra
            sz = base + 1
        let row = []
        let j = 0
        while j < sz
            row = row + [xs[i + j]]
            j = j + 1
        out = out + [row]
        i = i + sz
        c = c + 1
    return out
