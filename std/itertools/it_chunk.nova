// ============================================================================
// NOVA Standard Library — std/itertools/it_chunk
// Chunking and even-split helpers for int lists.
// All public functions are prefixed itc_.
// ============================================================================
// RAISED 2026-08-05. Every function built rows AND the outer `out` with
// `out = out + [x]` inside nested `while` loops — quadratic in both loops.
// itc_chunk has the exact contract of std/core/collect.chunk (n<=0 -> [],
// otherwise ceil(len/n) chunks, last one short) and now delegates to it.
// itc_chunk_pad and itc_evenly have their own contracts (padding; remainder
// distributed across the first chunks) so they stay here, rewritten as
// nested comprehensions — one allocation per row, one per chunk list.
import std/core/collect

// itc_chunk(xs, size) — split xs into consecutive chunks of `size`; last chunk may be shorter.
fn itc_chunk(xs, size)
    chunk(xs, size)

// itc_chunk_pad(xs, size, pad) — same as itc_chunk but pads the last chunk to exactly `size` with `pad`.
fn itc_chunk_pad(xs, size, pad)
    if size <= 0
        return []
    let n = len(xs)
    let nchunks = (n + size - 1) / size
    [[xs[i * size + j] if i * size + j < n else pad for j in 0..size] for i in 0..nchunks]

// itc_chunk_count(xs, size) — number of chunks that itc_chunk would produce (ceiling division).
fn itc_chunk_count(xs, size)
    if size <= 0
        return 0
    let n = len(xs)
    if n == 0
        return 0
    return (n + size - 1) / size

// itc_evenly(xs, n) — split xs into n roughly-equal contiguous chunks;
// earlier chunks get one extra element when len(xs) does not divide evenly.
// Returns [] if n <= 0 or xs is empty.
// Row c starts at c*base + min(c, extra) (the c extra-sized chunks before it
// each contributed one more element) and has size base+1 for the first
// `extra` rows, base after — a closed form for what the old i/c bookkeeping
// walked step by step.
fn itc_evenly(xs, n)
    if n <= 0
        return []
    let total = len(xs)
    if total == 0
        return []
    let base = total / n
    let extra = total - base * n
    [[xs[c * base + min(c, extra) + j] for j in 0..(base + 1 if c < extra else base)] for c in 0..n]
