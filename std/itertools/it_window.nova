// ============================================================================
// NOVA Standard Library — std/itertools/it_window
// Sliding-window helpers for int lists.
// All public functions are prefixed itw_.
// ============================================================================
// RAISED 2026-08-05. Every function built rows AND the outer `out` with
// `out = out + [x]` inside nested `while` loops. All three window functions
// have the EXACT contract of std/core/collect.windows (k<=0 or k>len(xs) ->
// [], otherwise len(xs)-k+1 overlapping windows of width k) — pairwise and
// triples are just windows(xs,2) and windows(xs,3) by definition. Verified
// byte-identical below; all three now delegate.
import std/core/collect

// itw_window(xs, k) — all length-k sliding windows with step 1; returns [] if k > len(xs) or k <= 0.
fn itw_window(xs, k)
    windows(xs, k)

// itw_pairwise(xs) — adjacent pairs [[xs[0],xs[1]], [xs[1],xs[2]], ...]; [] if len < 2.
fn itw_pairwise(xs)
    windows(xs, 2)

// itw_windows_count(xs, k) — number of windows itw_window(xs,k) would produce.
fn itw_windows_count(xs, k)
    if k <= 0
        return 0
    let n = len(xs)
    if n < k
        return 0
    return n - k + 1

// itw_triples(xs) — all consecutive triples [[xs[0],xs[1],xs[2]], ...]; [] if len < 3.
fn itw_triples(xs)
    windows(xs, 3)
