// ============================================================================
// NOVA Standard Library — std/media/png
// ============================================================================
// PNG chunk-level codec (no pixel decompression).
//
// FORMAT OVERVIEW
//   A PNG file consists of:
//
//   1. SIGNATURE (8 bytes)
//        137, 80, 78, 71, 13, 10, 26, 10
//        (hex: 89 50 4E 47 0D 0A 1A 0A)
//
//   2. Zero or more CHUNKS, each:
//        u32 BE   — length of data field (NOT including type or CRC)
//        4 bytes  — chunk type (ASCII letters, e.g. "IHDR", "IDAT", "IEND")
//        N bytes  — chunk data (N == length)
//        u32 BE   — CRC32 computed over type ++ data bytes (NOT length field)
//
//   3. IHDR CHUNK DATA (13 bytes, always first chunk after signature)
//        u32 BE   — image width
//        u32 BE   — image height
//        u8       — bit depth (1, 2, 4, 8, or 16 depending on color type)
//        u8       — color type (0=greyscale, 2=RGB, 3=indexed, 4=grey+alpha, 6=RGBA)
//        u8       — compression method (always 0 = deflate/inflate)
//        u8       — filter method (always 0 = adaptive filtering)
//        u8       — interlace method (0=none, 1=Adam7)
//
// CRC32 ALGORITHM (ISO-HDLC polynomial, same as PNG spec)
//   init crc = 0xFFFFFFFF
//   for each byte b:
//     crc = crc XOR b
//     repeat 8 times:
//       if (crc & 1) then crc = (crc >> 1) XOR 0xEDB88320
//       else              crc = crc >> 1
//     mask crc with & 0xFFFFFFFF after each bit step
//   final result = (crc XOR 0xFFFFFFFF) & 0xFFFFFFFF
//
// PUBLIC API
//   crc32(b) -> int
//     Compute CRC32 (ISO-HDLC) over a bytes value. Returns an unsigned 32-bit
//     integer. Standard vector: crc32(str_to_bytes("123456789")) == 0xCBF43926.
//
//   png_signature() -> bytes
//     Return the 8-byte PNG file signature.
//
//   png_ihdr(w, h, bitdepth, colortype) -> bytes
//     Return the 13-byte IHDR data block for an image of the given dimensions,
//     bit depth, and color type. Compression, filter, and interlace are all 0.
//
//   png_write_chunk(type_str, data_bytes) -> bytes
//     Build a complete PNG chunk: u32BE(len(data)) ++ type(4 bytes) ++ data ++ u32BE(crc).
//     type_str must be exactly 4 ASCII characters. Returns the full chunk bytes.
//
//   png_read_chunks(b) -> list
//     Parse a PNG bytes value. Skips the 8-byte signature, then reads chunks
//     until the data is exhausted. Returns a list of dicts, each:
//       {"type": str, "data": bytes}
//     Returns an empty list on any error (bad signature, truncation, etc.).
//
//   png_encode_rgb(width, height, rgb_bytes) -> bytes
//     Encode a raw truecolor (RGB, 8-bit) image into a full PNG file.
//     rgb_bytes must be exactly width*height*3 bytes (row-major, no padding).
//     Emits: signature, IHDR (bitdepth=8, colortype=2), IDAT (zlib-wrapped
//     DEFLATE of the filtered scanlines — filter byte 0x00 "None" prefixed
//     to every row), IEND. No deflate/zlib helper exists in std/compress yet
//     that operates on raw 'bytes', so this uses RFC 1951 §3.2.4 STORED
//     (uncompressed) deflate blocks — valid, spec-compliant DEFLATE data,
//     just without compression. Returns bytes(0) if rgb_bytes is the wrong
//     length.
//
// PRIVATE HELPERS
//   All helpers prefixed _png_ to avoid link collisions.
//
//   png_decode(b) -> Result
//     Decode an 8-bit, non-interlaced PNG (color types 0 greyscale, 2 RGB,
//     6 RGBA) into its raw pixels. Verifies the signature, walks the chunks,
//     concatenates every IDAT, zlib-inflates it (via std/compress deflatex —
//     inflate is NOT reimplemented here), then reverses the five PNG scanline
//     filters (None/Sub/Up/Average/Paeth). On success returns
//       ok({"width", "height", "channels", "pixels"})
//     where pixels is a flat row-major `bytes` value (channels bytes per pixel,
//     no filter bytes). On ANY malformed / unsupported input returns err(msg) —
//     it never crashes and never exits.
//
// DEPENDS ON: deflatex (RFC 1951 inflate). Imported for the decoder only; the
//   encoder path is self-contained. deflatex works on integer LISTS, so the
//   decoder converts the IDAT `bytes` to a list across that one boundary.
// ============================================================================
import deflatex

// ── Private: append a big-endian u32 (4 bytes) to bytes out ─────────────────
fn _png_put_u32be(out, v) -> bytes
    out = bytes_append(out, (v >> 24) & 0xFF)
    out = bytes_append(out, (v >> 16) & 0xFF)
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// ── Private: read a big-endian u32 from bytes b at offset i ──────────────────
// Bounds-checked; returns 0 if out of range.
fn _png_get_u32be(b, i) -> int
    let blen = bytes_len(b)
    let result = 0
    if i + 3 < blen
        let b0 = bytes_get(b, i)
        let b1 = bytes_get(b, i + 1)
        let b2 = bytes_get(b, i + 2)
        let b3 = bytes_get(b, i + 3)
        result = (b0 * 16777216) + (b1 * 65536) + (b2 * 256) + b3
    result

// ── crc32 ────────────────────────────────────────────────────────────────────
// CRC32 (ISO-HDLC, PNG polynomial 0xEDB88320) over a bytes value.
// Standard vector: crc32(str_to_bytes("123456789")) == 0xCBF43926.
fn crc32(b) -> int
    let crc = 0xFFFFFFFF
    let blen = bytes_len(b)
    for i in 0..blen
        let bv = bytes_get(b, i)
        crc = (crc & 0xFFFFFFFF) ^ bv
        let bit = 0
        while bit < 8
            let lsb = crc & 1
            crc = (crc >> 1) & 0x7FFFFFFF
            if lsb == 1
                crc = (crc ^ 0xEDB88320) & 0xFFFFFFFF
            bit += 1
    (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF

// ── png_signature ─────────────────────────────────────────────────────────────
// Return the 8-byte PNG file signature: 137,80,78,71,13,10,26,10.
fn png_signature() -> bytes
    let out = bytes(0)
    out = bytes_append(out, 137)
    out = bytes_append(out, 80)
    out = bytes_append(out, 78)
    out = bytes_append(out, 71)
    out = bytes_append(out, 13)
    out = bytes_append(out, 10)
    out = bytes_append(out, 26)
    out = bytes_append(out, 10)
    out

// ── png_ihdr ──────────────────────────────────────────────────────────────────
// Build the 13-byte IHDR data block.
//   w, h      — image dimensions (u32 BE each)
//   bitdepth  — bit depth per channel (u8)
//   colortype — PNG color type (u8)
//   compression, filter, interlace — all fixed at 0.
fn png_ihdr(w, h, bitdepth, colortype) -> bytes
    let out = bytes(0)
    out = _png_put_u32be(out, w)
    out = _png_put_u32be(out, h)
    out = bytes_append(out, bitdepth & 0xFF)
    out = bytes_append(out, colortype & 0xFF)
    out = bytes_append(out, 0)
    out = bytes_append(out, 0)
    out = bytes_append(out, 0)
    out

// ── png_write_chunk ───────────────────────────────────────────────────────────
// Build a complete PNG chunk from a 4-character type string and data bytes.
// Layout: u32BE(data_len) ++ type_bytes(4) ++ data ++ u32BE(crc_over_type_data).
// type_str must be exactly 4 ASCII characters; extra chars are ignored, short
// strings are padded with spaces (0x20) to 4 bytes.
fn png_write_chunk(type_str, data_bytes) -> bytes
    // Build the 4-byte type field from the type string.
    let tlen = len(type_str)
    let t0 = 32
    let t1 = 32
    let t2 = 32
    let t3 = 32
    if tlen > 0
        t0 = _png_char_at(type_str, 0)
    if tlen > 1
        t1 = _png_char_at(type_str, 1)
    if tlen > 2
        t2 = _png_char_at(type_str, 2)
    if tlen > 3
        t3 = _png_char_at(type_str, 3)
    // Compute data length.
    let dlen = bytes_len(data_bytes)
    // Build type ++ data for CRC computation.
    let crc_input = bytes(0)
    crc_input = bytes_append(crc_input, t0)
    crc_input = bytes_append(crc_input, t1)
    crc_input = bytes_append(crc_input, t2)
    crc_input = bytes_append(crc_input, t3)
    crc_input = bytes_concat(crc_input, data_bytes)
    let crc_val = crc32(crc_input)
    // Build the full chunk.
    let out = bytes(0)
    out = _png_put_u32be(out, dlen)
    out = bytes_append(out, t0)
    out = bytes_append(out, t1)
    out = bytes_append(out, t2)
    out = bytes_append(out, t3)
    out = bytes_concat(out, data_bytes)
    out = _png_put_u32be(out, crc_val)
    out

// ── Private: get ASCII code of character at position pos in string s ─────────
// Returns 32 (space) if pos is out of range. Uses ord()/char-index (not the
// str_to_bytes builtin) so the module is robust to importing deflatex, whose
// public str_to_bytes shadows the builtin with a list-returning variant.
fn _png_char_at(s, pos) -> int
    let result = 32
    if pos < len(s)
        result = ord(s[pos])
    result

// ── png_read_chunks ───────────────────────────────────────────────────────────
// Parse all chunks from a PNG bytes value.
// Validates the 8-byte signature, then reads chunks in sequence.
// Returns a list of dicts {"type": str, "data": bytes}.
// Returns [] on any error (bad sig, truncation, malformed length).
fn png_read_chunks(b) -> list
    let empty = []
    let blen = bytes_len(b)
    // Need at least 8 bytes for the signature.
    let ok = 1
    if blen < 8
        ok = 0
    if ok == 1
        // Verify signature bytes: 137,80,78,71,13,10,26,10
        if bytes_get(b, 0) != 137
            ok = 0
        if bytes_get(b, 1) != 80
            ok = 0
        if bytes_get(b, 2) != 78
            ok = 0
        if bytes_get(b, 3) != 71
            ok = 0
        if bytes_get(b, 4) != 13
            ok = 0
        if bytes_get(b, 5) != 10
            ok = 0
        if bytes_get(b, 6) != 26
            ok = 0
        if bytes_get(b, 7) != 10
            ok = 0
    let result = empty
    if ok == 1
        let chunks = []
        let pos = 8
        let running = 1
        while running == 1
            // Need at least 12 bytes: 4 (length) + 4 (type) + 0 (data) + 4 (crc)
            if pos + 12 > blen
                running = 0
            if running == 1
                // Read data length (u32 BE).
                let dlen = _png_get_u32be(b, pos)
                pos += 4
                // Read type (4 bytes -> string).
                if pos + 4 > blen
                    running = 0
                if running == 1
                    let c0 = bytes_get(b, pos)
                    let c1 = bytes_get(b, pos + 1)
                    let c2 = bytes_get(b, pos + 2)
                    let c3 = bytes_get(b, pos + 3)
                    pos += 4
                    // Read data bytes (dlen bytes).
                    if pos + dlen > blen
                        running = 0
                    if running == 1
                        let chunk_data = bytes_slice(b, pos, pos + dlen)
                        pos += dlen
                        // Skip CRC (4 bytes).
                        if pos + 4 > blen
                            running = 0
                        if running == 1
                            pos += 4
                            // Build type string from 4 bytes. chr()/concat (not
                            // the bytes_to_str builtin) keeps this robust to the
                            // deflatex import (see _png_char_at). Chunk types are
                            // always 4 ASCII letters, so chr is exact here.
                            let type_str = chr(c0) + chr(c1) + chr(c2) + chr(c3)
                            let chunk = {"type": type_str, "data": chunk_data}
                            chunks.push(chunk)
                            // Stop after IEND.
                            if type_str == "IEND"
                                running = 0
                            // Stop if no more data.
                            if pos >= blen
                                running = 0
        result = chunks
    result

// ── Private: Adler-32 (RFC 1950 §8.2) over a bytes value ─────────────────────
// h_adler32 in std/hash/adler32.nova only takes a NUL-terminated str, which
// truncates on 0x00 — unsafe for raw pixel/scanline data. This variant reads
// the bytes value directly.
fn _png_adler32_bytes(b) -> int
    let mod_adler = 65521
    let a = 1
    let s = 0
    let blen = bytes_len(b)
    for i in 0..blen
        let v = bytes_get(b, i)
        a = (a + v) % mod_adler
        s = (s + a) % mod_adler
    ((s << 16) | a) & 0xFFFFFFFF

// ── Private: append a big-endian u16 (2 bytes) to bytes out ──────────────────
fn _png_put_u16be(out, v) -> bytes
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// ── Private: append a little-endian u16 (2 bytes) to bytes out ───────────────
fn _png_put_u16le(out, v) -> bytes
    out = bytes_append(out, v & 0xFF)
    out = bytes_append(out, (v >> 8) & 0xFF)
    out

// ── Private: wrap one RFC 1951 §3.2.4 STORED deflate block ───────────────────
// header byte: BFINAL (bit0) | BTYPE=00 (bits1-2) | zero padding to byte
// boundary (bits3-7) — since stored blocks always start byte-aligned, this
// collapses to a single byte: 1 if final, 0 otherwise.
// Followed by LEN (u16 LE), NLEN = one's complement of LEN (u16 LE), then the
// raw chunk bytes verbatim. chunk must be <= 65535 bytes.
fn _png_deflate_stored_block(out, chunk, is_final) -> bytes
    let header = 0
    if is_final == 1
        header = 1
    out = bytes_append(out, header)
    let clen = bytes_len(chunk)
    out = _png_put_u16le(out, clen)
    let nlen = (~clen) & 0xFFFF
    out = _png_put_u16le(out, nlen)
    out = bytes_concat(out, chunk)
    out

// ── Private: RFC 1950 zlib-wrap raw data using STORED deflate blocks ─────────
// CMF=0x78 (CM=8 deflate, CINFO=7 -> 32K window), FLG=0x01 (FCHECK makes
// (CMF*256+FLG) % 31 == 0, FLEVEL=0 fastest, FDICT=0) — the standard header
// pair for "no compression" zlib streams. Body = one or more STORED deflate
// blocks (max 65535 bytes of payload each, split as needed), trailer =
// Adler-32 of the raw uncompressed data (u32 BE), per RFC 1950 §2.2.
fn _png_zlib_wrap_stored(data) -> bytes
    let out = bytes(0)
    out = bytes_append(out, 0x78)
    out = bytes_append(out, 0x01)
    let dlen = bytes_len(data)
    let max_block = 65535
    let pos = 0
    // Emit at least one block even for empty input, so the stream is valid.
    let running = 1
    while running == 1
        let remaining = dlen - pos
        let take = remaining
        if take > max_block
            take = max_block
        let is_final = 0
        if remaining <= max_block
            is_final = 1
        let chunk = bytes_slice(data, pos, pos + take)
        out = _png_deflate_stored_block(out, chunk, is_final)
        pos += take
        if is_final == 1
            running = 0
    let adler = _png_adler32_bytes(data)
    out = _png_put_u32be(out, adler)
    out

// ── Private: encode an 8-bit image (any channel count) into a full PNG ────────
// Shared engine for png_encode_rgb / png_encode_rgba / png_encode_gray.
//   channels  — bytes per pixel (1 grey, 3 RGB, 4 RGBA)
//   colortype — matching PNG color type (0 grey, 2 RGB, 6 RGBA)
// pix must be exactly width*height*channels bytes. Every scanline is filter
// type 0 ("None"): a 0x00 byte then the row's raw bytes, zlib-wrapped as one or
// more STORED deflate blocks. Returns bytes(0) on a wrong-length pixel buffer.
fn _png_encode(width, height, pix, channels, colortype) -> bytes
    // Defense-in-depth: bound dimensions so width*height*channels cannot wrap i64 and
    // spuriously match bytes_len(pix). Caller-controlled here (not untrusted), but cheap.
    if width <= 0 or height <= 0 or width > 1000000000 or height > 1000000000
        return bytes(0)
    let expected_len = width * height * channels
    let result = bytes(0)
    if bytes_len(pix) == expected_len
        let row_stride = width * channels
        let raw = bytes(0)
        for y in 0..height
            raw = bytes_append(raw, 0)
            let row_start = y * row_stride
            let row = bytes_slice(pix, row_start, row_start + row_stride)
            raw = bytes_concat(raw, row)
        let idat_data = _png_zlib_wrap_stored(raw)
        let out = png_signature()
        out = bytes_concat(out, png_write_chunk("IHDR", png_ihdr(width, height, 8, colortype)))
        out = bytes_concat(out, png_write_chunk("IDAT", idat_data))
        out = bytes_concat(out, png_write_chunk("IEND", bytes(0)))
        result = out
    result

// ── png_encode_rgb ────────────────────────────────────────────────────────────
// Encode a raw 8-bit truecolor (RGB) image into a complete PNG file.
//   width, height — image dimensions in pixels
//   rgb_bytes     — row-major RGB pixel data, exactly width*height*3 bytes
// Returns the full PNG file bytes: signature ++ IHDR ++ IDAT ++ IEND.
// Returns bytes(0) if rgb_bytes is not exactly width*height*3 bytes long.
fn png_encode_rgb(width, height, rgb_bytes) -> bytes
    _png_encode(width, height, rgb_bytes, 3, 2)

// ── png_encode_rgba ───────────────────────────────────────────────────────────
// Encode a raw 8-bit RGBA image (color type 6). rgba_bytes must be exactly
// width*height*4 bytes, row-major. Returns bytes(0) on a length mismatch.
fn png_encode_rgba(width, height, rgba_bytes) -> bytes
    _png_encode(width, height, rgba_bytes, 4, 6)

// ── png_encode_gray ───────────────────────────────────────────────────────────
// Encode a raw 8-bit greyscale image (color type 0). gray_bytes must be exactly
// width*height bytes, row-major. Returns bytes(0) on a length mismatch.
fn png_encode_gray(width, height, gray_bytes) -> bytes
    _png_encode(width, height, gray_bytes, 1, 0)

// ============================================================================
// DECODER — 8-bit non-interlaced PNG, color types 0 / 2 / 6.
// ============================================================================

// ── Private: verify the 8-byte PNG signature 137,80,78,71,13,10,26,10 ────────
// Returns 1 if b starts with the exact signature, else 0. Bounds-safe.
fn _png_check_sig(b) -> int
    if bytes_len(b) < 8
        return 0
    let sig = [137, 80, 78, 71, 13, 10, 26, 10]
    let ok = 1
    for i in 0..8
        if bytes_get(b, i) != sig[i]
            ok = 0
    ok

// ── Private: copy bytes[start..end) into a fresh int LIST ─────────────────────
// deflatex.inflate consumes/produces integer lists, not `bytes` values, so the
// decoder bridges the two representations here. end is clamped to bytes_len so
// the copy is always in-bounds.
fn _png_bytes_to_intlist(b, start, end) -> list
    let out = []
    let blen = bytes_len(b)
    let e = end
    if e > blen
        e = blen
    let i = start
    while i < e
        push(out, bytes_get(b, i))
        i += 1
    out

// ── Private: Paeth predictor (PNG spec 9.4) ──────────────────────────────────
// a = left, b = above, c = upper-left. p = a+b-c; return whichever of a,b,c is
// nearest to p, ties broken in the order a, then b, then c.
fn _png_paeth(a, b, c) -> int
    let p = a + b - c
    let pa = p - a
    if pa < 0
        pa = 0 - pa
    let pb = p - b
    if pb < 0
        pb = 0 - pb
    let pc = p - c
    if pc < 0
        pc = 0 - pc
    let out = c
    if pa <= pb and pa <= pc
        out = a
    else if pb <= pc
        out = b
    out

// ── Private: reverse the PNG scanline filters (spec 9.2) ─────────────────────
// raw = the decompressed stream: `height` rows, each a 1-byte filter type
// followed by `stride` (= width*channels) data bytes. Reconstructs the flat
// row-major pixel bytes. bpp == channels (bit depth is 8). Neighbours off the
// image edge read as 0. Filter-type validity is guaranteed by the caller.
fn _png_unfilter(raw, width, height, channels) -> bytes
    let stride = width * channels
    let bpp = channels
    let out = bytes_create(height * stride)
    for y in 0..height
        let rowbase = y * (stride + 1)
        let ft = raw[rowbase]
        let outrow = y * stride
        let x = 0
        while x < stride
            let filt = raw[rowbase + 1 + x]
            let a = 0
            if x >= bpp
                a = bytes_get(out, outrow + x - bpp)
            let up = 0
            if y > 0
                up = bytes_get(out, outrow - stride + x)
            let c = 0
            if x >= bpp
                if y > 0
                    c = bytes_get(out, outrow - stride + x - bpp)
            let pred = 0
            if ft == 1
                pred = a
            else if ft == 2
                pred = up
            else if ft == 3
                pred = (a + up) / 2
            else if ft == 4
                pred = _png_paeth(a, up, c)
            bytes_set(out, outrow + x, (filt + pred) & 0xFF)
            x += 1
    out

// ── png_decode ───────────────────────────────────────────────────────────────
// Decode an 8-bit, non-interlaced PNG (color types 0 grey, 2 RGB, 6 RGBA).
// Returns ok({"width","height","channels","pixels"}) on success (pixels is a
// flat row-major `bytes` value, channels bytes/pixel, filter bytes removed), or
// err(msg) on any malformed / unsupported input. Never crashes, never exits.
fn png_decode(b) -> Result
    if not _png_check_sig(b)
        return err("png_decode: bad or missing 8-byte signature")
    let chunks = png_read_chunks(b)
    if len(chunks) == 0
        return err("png_decode: no chunks (malformed or truncated)")
    let first = chunks[0]
    if first["type"] != "IHDR"
        return err("png_decode: first chunk is not IHDR")
    let ihdr = first["data"]
    if bytes_len(ihdr) < 13
        return err("png_decode: IHDR chunk too short")
    let width = _png_get_u32be(ihdr, 0)
    let height = _png_get_u32be(ihdr, 4)
    let bit_depth = bytes_get(ihdr, 8)
    let color_type = bytes_get(ihdr, 9)
    let comp = bytes_get(ihdr, 10)
    let filt_method = bytes_get(ihdr, 11)
    let interlace = bytes_get(ihdr, 12)
    if width == 0 or height == 0
        return err("png_decode: zero width or height")
    // SECURITY: bound dimensions BEFORE any size multiply. width/height come from the
    // untrusted IHDR; a crafted 0xFFFFFFFF x 0xFFFFFFFF would make `height * (stride + 1)`
    // wrap NEGATIVE in i64, bypassing the `len(raw) < expected` guard below and driving the
    // filter loop ~4.29e9 iterations (unbounded DoS hang). Cap at 1e9/side: astronomically
    // larger than any real image, yet keeps height*(width*4+1) < i64 max (no wrap).
    if width > 1000000000 or height > 1000000000
        return err("png_decode: image dimensions exceed limit")
    if bit_depth != 8
        return err("png_decode: only bit depth 8 is supported")
    if comp != 0
        return err("png_decode: unsupported compression method")
    if filt_method != 0
        return err("png_decode: unsupported filter method")
    if interlace != 0
        return err("png_decode: interlaced PNG is not supported")
    let channels = 0
    if color_type == 0
        channels = 1
    else if color_type == 2
        channels = 3
    else if color_type == 6
        channels = 4
    else
        return err("png_decode: unsupported color type (only 0, 2, 6)")
    // Concatenate every IDAT chunk's data (they may be split); require IEND.
    let idat = bytes(0)
    let saw_idat = 0
    let saw_iend = 0
    for ci in 0..len(chunks)
        let ch = chunks[ci]
        let ct = ch["type"]
        if ct == "IDAT"
            idat = bytes_concat(idat, ch["data"])
            saw_idat = 1
        if ct == "IEND"
            saw_iend = 1
    if saw_idat == 0
        return err("png_decode: no IDAT data")
    if saw_iend == 0
        return err("png_decode: missing IEND")
    // zlib stream (RFC 1950): CM must be 8 (deflate), FDICT must be 0.
    let idatlen = bytes_len(idat)
    if idatlen < 2
        return err("png_decode: IDAT too short for zlib header")
    let cmf = bytes_get(idat, 0)
    let flg = bytes_get(idat, 1)
    if (cmf & 0x0F) != 8
        return err("png_decode: unsupported zlib compression method")
    if (flg & 0x20) != 0
        return err("png_decode: zlib preset dictionary not supported")
    // Raw DEFLATE body starts after the 2-byte zlib header. deflatex.inflate
    // stops at the final block, ignoring the trailing 4-byte Adler-32.
    let deflated = _png_bytes_to_intlist(idat, 2, idatlen)
    let raw = deflatex.inflate(deflated)
    let stride = width * channels
    let expected = height * (stride + 1)
    if len(raw) < expected
        return err("png_decode: decompressed data shorter than expected")
    // Validate every scanline's filter-type byte before reconstructing.
    let bad = 0
    for y in 0..height
        let ft = raw[y * (stride + 1)]
        if ft < 0 or ft > 4
            bad = 1
    if bad == 1
        return err("png_decode: invalid scanline filter type")
    let pixels = _png_unfilter(raw, width, height, channels)
    return ok({"width": width, "height": height, "channels": channels, "pixels": pixels})
