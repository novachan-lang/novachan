// ============================================================================
// NOVA Standard Library — std/media/tga
// ============================================================================
// Targa TrueColor (type 2, uncompressed) image encoder and decoder.
//
// TGA (Truevision Graphics Adapter) is a raster image format. This module
// implements the most common variant: Type 2 (uncompressed true-color),
// 24 bits per pixel, BGR pixel order, top-down orientation (descriptor=0x20).
//
// HEADER LAYOUT (18 bytes):
//   byte  0  : ID length   = 0 (no image ID)
//   byte  1  : color map type = 0 (no color map)
//   byte  2  : image type  = 2 (uncompressed true-color)
//   bytes 3-7: color map spec = 0,0,0,0,0 (5 zero bytes, not used)
//   bytes 8-9: X origin (LE u16) = 0
//   bytes 10-11: Y origin (LE u16) = 0
//   bytes 12-13: width  (LE u16)
//   bytes 14-15: height (LE u16)
//   byte 16 : bits per pixel = 24
//   byte 17 : image descriptor = 0x20 (bit5=1: top-down; bits 0-3: alpha depth=0)
//
// PIXEL DATA:
//   Immediately follows the 18-byte header. Each pixel is 3 bytes: Blue, Green, Red
//   (BGR order, not RGB). Pixels are stored row-major, top-to-bottom.
//   Total pixel data = width * height * 3 bytes.
//
// PUBLIC API:
//   tga_encode(w, h, px_rgb) -> bytes
//     Encodes a w×h image to TGA format. px_rgb is a flat list of RGB triples:
//     [R0,G0,B0, R1,G1,B1, ...] (length = w*h*3). Returns the full TGA file
//     as a bytes value. Channel values are clamped to 0..255 via & 0xFF.
//
//   tga_decode(b) -> dict
//     Decodes a TGA bytes value. Returns {"w": int, "h": int, "px": list}
//     where px is a flat RGB list [R,G,B, ...] (length = w*h*3). On invalid
//     input (wrong magic, bad header, truncated data) returns {"w":0,"h":0,"px":[]}.
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _tga_ to avoid link collisions.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Read a little-endian u16 from bytes b at offset i.
// Bounds-checks before reading; returns 0 if out of range.
fn _tga_u16le(b, i) -> int
    let blen = bytes_len(b)
    if i + 1 >= blen
        return 0
    let lo = bytes_get(b, i)
    let hi = bytes_get(b, i + 1)
    lo | (hi << 8)

// Append a little-endian u16 to bytes buffer out. Returns new buffer.
fn _tga_append_u16le(out, v) -> bytes
    out = bytes_append(out, v & 0xFF)
    out = bytes_append(out, (v >> 8) & 0xFF)
    out

// ── Public API ────────────────────────────────────────────────────────────────

// tga_encode: produce an 18-header + BGR pixel-data TGA file.
//
// Parameters:
//   w      — image width  in pixels (u16 range: 1..65535)
//   h      — image height in pixels (u16 range: 1..65535)
//   px_rgb — flat list of integers [R0,G0,B0, R1,G1,B1, ...], length must be w*h*3.
//            Each channel is masked to 0..255. Extra entries are ignored; if the
//            list is too short the missing pixel bytes are written as 0.
//
// Returns:
//   bytes value: 18-byte TGA header followed by h*w*3 bytes of BGR pixel data.
//   Total length = 18 + w*h*3.
//
// Example (1×1 pixel, RGB=10,20,30):
//   tga_encode(1, 1, [10, 20, 30])
//   -> 21 bytes; header[2]=2; header[12..13]=1,0; header[14..15]=1,0;
//      header[16]=24; header[17]=0x20; pixel bytes = 30,20,10 (BGR).
fn tga_encode(w, h, px_rgb) -> bytes
    let out = bytes(0)
    // ── Header ──────────────────────────────────────────────────────────────
    // byte 0: ID length = 0
    out = bytes_append(out, 0)
    // byte 1: color map type = 0 (none)
    out = bytes_append(out, 0)
    // byte 2: image type = 2 (uncompressed true-color)
    out = bytes_append(out, 2)
    // bytes 3-7: color map spec (5 zero bytes)
    out = bytes_append(out, 0)
    out = bytes_append(out, 0)
    out = bytes_append(out, 0)
    out = bytes_append(out, 0)
    out = bytes_append(out, 0)
    // bytes 8-9: X origin LE u16 = 0
    out = _tga_append_u16le(out, 0)
    // bytes 10-11: Y origin LE u16 = 0
    out = _tga_append_u16le(out, 0)
    // bytes 12-13: width LE u16
    out = _tga_append_u16le(out, w)
    // bytes 14-15: height LE u16
    out = _tga_append_u16le(out, h)
    // byte 16: bits per pixel = 24
    out = bytes_append(out, 24)
    // byte 17: descriptor = 0x20 (top-down, no alpha)
    out = bytes_append(out, 0x20)
    // ── Pixel data (BGR order) ──────────────────────────────────────────────
    let npix = w * h
    let src_len = len(px_rgb)
    let pi = 0
    while pi < npix
        let ri = pi * 3
        let r_val = 0
        let g_val = 0
        let b_val = 0
        if ri < src_len
            r_val = px_rgb[ri] & 0xFF
        if ri + 1 < src_len
            g_val = px_rgb[ri + 1] & 0xFF
        if ri + 2 < src_len
            b_val = px_rgb[ri + 2] & 0xFF
        // TGA stores BGR
        out = bytes_append(out, b_val)
        out = bytes_append(out, g_val)
        out = bytes_append(out, r_val)
        pi = pi + 1
    out

// tga_decode: parse a TGA bytes value into width, height, and flat RGB pixel list.
//
// Validates:
//   - Total length >= 18 (minimum header size)
//   - Image type == 2 (uncompressed true-color)
//   - Bits per pixel == 24
//   - Total data length >= 18 + w*h*3
//
// Handles top-down (descriptor bit5=1) correctly. Note: this module only
// writes top-down (descriptor=0x20). If bit5=0 (bottom-up), the pixels
// would need to be flipped — this decoder accepts only top-down TGAs
// (descriptor bit5 must be set) for safety; mismatched descriptors return empty.
//
// Returns dict {"w": int, "h": int, "px": list} where px is flat RGB.
// On any error returns {"w": 0, "h": 0, "px": []}.
fn tga_decode(b) -> dict
    let empty_px = []
    let fail = {"w": 0, "h": 0, "px": empty_px}
    let blen = bytes_len(b)
    // Must have at least the 18-byte header
    if blen < 18
        return fail
    // byte 2: image type must be 2 (uncompressed true-color)
    let imgtype = bytes_get(b, 2)
    if imgtype != 2
        return fail
    // byte 16: bits per pixel must be 24
    let bpp = bytes_get(b, 16)
    if bpp != 24
        return fail
    // byte 17: descriptor — bit5 must be 1 (top-down)
    let descriptor = bytes_get(b, 17)
    let topdown = (descriptor >> 5) & 1
    if topdown != 1
        return fail
    // bytes 12-13: width (LE u16)
    let w = _tga_u16le(b, 12)
    // bytes 14-15: height (LE u16)
    let h = _tga_u16le(b, 14)
    // Sanity: zero-dimension image
    if w == 0 or h == 0
        return fail
    // Pixel data starts at byte 18 (ID length = 0 assumed; no color map)
    // For full correctness, actual offset = 18 + ID_length + colormap_size.
    // Since we only write idlen=0 and cmaptype=0, offset is always 18.
    // For decode, read idlen from byte 0.
    let idlen = bytes_get(b, 0)
    let pixel_start = 18 + idlen
    let npix = w * h
    let needed = pixel_start + npix * 3
    if blen < needed
        return fail
    // Read BGR pixels, emit as RGB
    let px = []
    let pi = 0
    while pi < npix
        let off = pixel_start + pi * 3
        let bv = bytes_get(b, off)
        let gv = bytes_get(b, off + 1)
        let rv = bytes_get(b, off + 2)
        // Convert BGR -> RGB
        px.push(rv)
        px.push(gv)
        px.push(bv)
        pi = pi + 1
    let result = {"w": w, "h": h, "px": px}
    result
