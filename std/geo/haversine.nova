// std/geo/haversine.nova — Great-circle distance between two lat/lon points.
//
// FLOAT HAZARDS obeyed:
//   • All float sub-expressions bound to named lets.
//   • No multi-term float return — always return a named let.
//   • No asin/acos builtins — _asin inlined via atan2+sqrt.
//   • Float literals always carry a decimal point.
//   • Earth radius is a function (no module-level const).
//
// API:
//   haversine(lat1, lon1, lat2, lon2) -> float   distance in meters

fn _hav_pi()
    let p = 3.14159265358979
    p

fn _hav_R()
    let r = 6371000.0
    r

fn _hav_deg2rad(d)
    let PI = _hav_pi()
    let t = d * PI
    let r = t / 180.0
    r

// Inline _asin: asin(x) = atan2(x, sqrt(1 - x*x))
// All sub-expressions bound to lets per float-codegen rules.
fn _asin_impl(x)
    let x2 = x * x
    let sub = 1.0 - x2
    let s = sqrt(sub)
    let r = atan2(x, s)
    r

// haversine: Great-circle distance in meters between two lat/lon points (degrees).
// Formula:
//   a = sin²(Δlat/2) + cos(lat1)*cos(lat2)*sin²(Δlon/2)
//   c = 2*asin(sqrt(a))
//   d = R * c
fn haversine(lat1, lon1, lat2, lon2)
    let R = _hav_R()
    let rlat1 = _hav_deg2rad(lat1)
    let rlat2 = _hav_deg2rad(lat2)
    let rlon1 = _hav_deg2rad(lon1)
    let rlon2 = _hav_deg2rad(lon2)
    let dlat = rlat2 - rlat1
    let dlon = rlon2 - rlon1
    let sdlat = dlat / 2.0
    let sdlon = dlon / 2.0
    let sinsdlat = sin(sdlat)
    let sinsdlon = sin(sdlon)
    let a1 = sinsdlat * sinsdlat
    let coslat1 = cos(rlat1)
    let coslat2 = cos(rlat2)
    let a2 = sinsdlon * sinsdlon
    let a3 = coslat1 * coslat2
    let a4 = a3 * a2
    let a = a1 + a4
    let sqrta = sqrt(a)
    let c = 2.0 * _asin_impl(sqrta)
    let d = R * c
    d
