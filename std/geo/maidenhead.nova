// std/geo/maidenhead.nova — Maidenhead Locator System (ham radio grid squares).
//
// The Maidenhead system divides the Earth into a hierarchy of grid squares:
//   Field    (2 chars): 20° lon / 10° lat, labeled A-R (letters).
//   Square   (2 chars): 2° lon  / 1° lat,  labeled 0-9 (digits).
//   Subsquare(2 chars): 5' lon  / 2.5' lat, labeled a-x (24 letters).
//
// precision: 2 = field only, 4 = field+square, 6 = field+square+subsquare.
//
// Encoding:
//   Start from lon+180 in [0,360) and lat+90 in [0,180).
//   Field:     lon_f = floor((lon+180)/20),     lat_f = floor((lat+90)/10)   → A-R
//   Square:    lon_s = floor(lon_rem/2),         lat_s = floor(lat_rem/1)     → 0-9
//   Subsquare: lon_ss = floor(lon_rem2/(2/24)),  lat_ss = floor(lat_rem2/(1/24)) → a-x
//   where lon_rem = lon+180 - lon_f*20, lat_rem = lat+90 - lat_f*10, etc.
//
// Symbol prefix: mh_ (public), _mh_ (private).

// _mh_upper: uppercase field letter for index 0-17 (A-R).
fn _mh_upper(i) -> string
    let letters = "ABCDEFGHIJKLMNOPQR"
    if i >= 0 and i <= 17
        return letters[i]
    "?"

// _mh_lower: lowercase subsquare letter for index 0-23 (a-x).
fn _mh_lower(i) -> string
    let letters = "abcdefghijklmnopqrstuvwx"
    if i >= 0 and i <= 23
        return letters[i]
    "?"

// _mh_field_idx: map uppercase letter A-R to index 0-17; returns -1 if out of range.
fn _mh_field_idx(ch) -> int
    let b = ord(ch)
    // 'A'=65, 'R'=82
    if b >= 65 and b <= 82
        return b - 65
    0 - 1

// _mh_sub_idx: map lowercase letter a-x to index 0-23; returns -1 if out of range.
fn _mh_sub_idx(ch) -> int
    let b = ord(ch)
    // 'a'=97, 'x'=120
    if b >= 97 and b <= 120
        return b - 97
    0 - 1

// _mh_digit_idx: map digit char '0'-'9' to 0-9; returns -1 if not a digit.
fn _mh_digit_idx(ch) -> int
    let b = ord(ch)
    if b >= 48 and b <= 57
        return b - 48
    0 - 1

// mh_encode: encode (lat, lon) as a Maidenhead grid locator.
// precision must be 2, 4, or 6.
// lat in [-90, 90], lon in [-180, 180].
fn mh_encode(lat, lon, precision) -> string
    let lat_f = lat * 1.0
    let lon_f = lon * 1.0
    // normalize
    let lat_n = lat_f + 90.0
    let lon_n = lon_f + 180.0
    // clamp to valid range (avoid exact boundary issues)
    if lat_n < 0.0
        lat_n = 0.0
    if lat_n >= 180.0
        lat_n = 179.9999
    if lon_n < 0.0
        lon_n = 0.0
    if lon_n >= 360.0
        lon_n = 359.9999
    // Field (A-R)
    let lon_fi = int(lon_n / 20.0)
    let lat_fi = int(lat_n / 10.0)
    let result = _mh_upper(lon_fi) + _mh_upper(lat_fi)
    if precision <= 2
        return result
    // Square (0-9)
    let lon_rem1 = lon_n - lon_fi * 20.0
    let lat_rem1 = lat_n - lat_fi * 10.0
    let lon_si = int(lon_rem1 / 2.0)
    let lat_si = int(lat_rem1 / 1.0)
    result += str(lon_si) + str(lat_si)
    if precision <= 4
        return result
    // Subsquare (a-x)
    let lon_rem2 = lon_rem1 - lon_si * 2.0
    let lat_rem2 = lat_rem1 - lat_si * 1.0
    // Each subsquare is 2/24 degrees lon = 1/12 deg, 1/24 deg lat
    let lon_ssi = int(lon_rem2 * 12.0)
    let lat_ssi = int(lat_rem2 * 24.0)
    result += _mh_lower(lon_ssi) + _mh_lower(lat_ssi)
    result

// mh_decode: decode a Maidenhead grid locator to a bounds dict.
// Returns {lat_lo, lat_hi, lon_lo, lon_hi, lat_center, lon_center}.
fn mh_decode(grid) -> any
    let n = len(grid)
    let result = {}
    if n < 2
        result["lat_lo"] = 0.0
        result["lat_hi"] = 0.0
        result["lon_lo"] = 0.0
        result["lon_hi"] = 0.0
        result["lat_center"] = 0.0
        result["lon_center"] = 0.0
        return result
    // Field
    let lon_fi = _mh_field_idx(grid[0])
    let lat_fi = _mh_field_idx(grid[1])
    let lon_lo = lon_fi * 20.0 - 180.0
    let lon_hi = lon_lo + 20.0
    let lat_lo = lat_fi * 10.0 - 90.0
    let lat_hi = lat_lo + 10.0
    if n >= 4
        // Square
        let lon_si = _mh_digit_idx(grid[2])
        let lat_si = _mh_digit_idx(grid[3])
        lon_lo += lon_si * 2.0
        lon_hi = lon_lo + 2.0
        lat_lo += lat_si * 1.0
        lat_hi = lat_lo + 1.0
    if n >= 6
        // Subsquare
        let lon_ssi = _mh_sub_idx(grid[4])
        let lat_ssi = _mh_sub_idx(grid[5])
        let lon_step = 2.0 / 24.0
        let lat_step = 1.0 / 24.0
        lon_lo += lon_ssi * lon_step
        lon_hi = lon_lo + lon_step
        lat_lo += lat_ssi * lat_step
        lat_hi = lat_lo + lat_step
    let lon_sum = lon_lo + lon_hi
    let lat_sum = lat_lo + lat_hi
    let lon_c = lon_sum / 2.0
    let lat_c = lat_sum / 2.0
    result["lat_lo"] = lat_lo
    result["lat_hi"] = lat_hi
    result["lon_lo"] = lon_lo
    result["lon_hi"] = lon_hi
    result["lat_center"] = lat_c
    result["lon_center"] = lon_c
    result

// mh_is_valid: return true if the grid string is a syntactically valid locator.
// Valid formats: 2, 4, or 6 characters in the pattern [A-R][A-R] + [0-9][0-9] + [a-x][a-x].
fn mh_is_valid(grid) -> bool
    let n = len(grid)
    if n != 2 and n != 4 and n != 6
        return false
    // First two: field letters A-R
    if _mh_field_idx(grid[0]) < 0
        return false
    if _mh_field_idx(grid[1]) < 0
        return false
    if n >= 4
        // Square digits 0-9
        if _mh_digit_idx(grid[2]) < 0
            return false
        if _mh_digit_idx(grid[3]) < 0
            return false
    if n >= 6
        // Subsquare letters a-x
        if _mh_sub_idx(grid[4]) < 0
            return false
        if _mh_sub_idx(grid[5]) < 0
            return false
    true

// mh_center: return [lat, lon] of the center of the grid square.
fn mh_center(grid) -> list
    let d = mh_decode(grid)
    let c = []
    c.push(d["lat_center"])
    c.push(d["lon_center"])
    c

// mh_field: return the 2-character field for (lat, lon).
fn mh_field(lat, lon) -> string
    mh_encode(lat, lon, 2)

// mh_precision: return the precision level (2, 4, or 6) of a grid string.
fn mh_precision(grid) -> int
    let n = len(grid)
    if n >= 6
        return 6
    if n >= 4
        return 4
    2
