// std/geo/utm_zone.nova — UTM zone + latitude band (integer rules only).
//
// UTM divides the world into 60 6°-wide longitudinal zones (1..60) and
// latitude bands C..X (skipping I and O), each 8° tall (X spans 12°: 72..84).
// The Norway/Svalbard special cases alter zone boundaries in zones 31-37.
//
// All public functions prefixed uz_ to avoid global symbol collisions.
//
// FLOAT RULES obeyed throughout.
// No trig; no map-projection math.  Integer/string arithmetic only.
// ─────────────────────────────────────────────────────────────────────────────

// _uz_floor: integer floor for a float (correct for negatives).
fn _uz_floor(x) -> int
    let xi = int(x)
    if x < 0.0
        let xif = xi * 1.0
        if xif > x
            return xi - 1
    xi

// uz_zone: UTM zone number for a longitude in [-180, 180].
// zone = floor((lon + 180) / 6) + 1, clamped to [1, 60].
fn uz_zone(lon) -> int
    let lon_f = lon * 1.0
    let shifted = lon_f + 180.0
    let div = shifted / 6.0
    let z = _uz_floor(div) + 1
    1 if z < 1 else (60 if z > 60 else z)

// _uz_band_letters: the 20 UTM latitude band letters (no I, no O).
fn _uz_band_letters() -> string
    "CDEFGHJKLMNPQRSTUVWX"

// uz_band: UTM latitude band letter for lat in [-80, 84].
// Each band is 8°; X is 12° (72..84).  C starts at -80.
// Returns empty string for out-of-range.
fn uz_band(lat) -> string
    let lat_f = lat * 1.0
    if lat_f < -80.0 or lat_f > 84.0
        return ""
    let letters = _uz_band_letters()
    // Special: X band spans 72..84 (12 degrees)
    if lat_f >= 72.0
        return letters[19]
    // For -80 up through <72: band index = floor((lat + 80) / 8)
    let shifted = lat_f + 80.0
    let div = shifted / 8.0
    let idx = _uz_floor(div)
    if idx < 0
        return letters[0]
    if idx > 19
        return letters[19]
    letters[idx]

// uz_zone_lon_center: the central meridian longitude for a given zone (1..60).
// Formula: (zone - 1) * 6 - 180 + 3
fn uz_zone_lon_center(zone) -> float
    let z = zone * 1
    let cm = (z - 1) * 6 - 180 + 3
    cm * 1.0

// uz_zone_bounds: [west_lon, east_lon] for a given zone (1..60).
fn uz_zone_bounds(zone) -> any
    let z = zone * 1
    let west = (z - 1) * 6 - 180
    let east = west + 6
    let result = []
    push(result, west)
    push(result, east)
    result

// uz_designator: "ZoneNumber + BandLetter" string e.g. '32U' for Munich.
fn uz_designator(lat, lon) -> string
    let z = uz_zone(lon)
    let b = uz_band(lat)
    "{z}{b}"

// uz_is_northern: true if the latitude is in the northern hemisphere (>= 0).
fn uz_is_northern(lat) -> bool
    let lat_f = lat * 1.0
    lat_f >= 0.0

// uz_hemisphere: 'N' if northern hemisphere, 'S' if southern.
fn uz_hemisphere(lat) -> string
    let lat_f = lat * 1.0
    "N" if lat_f >= 0.0 else "S"

// uz_norway_exception: zone number with Svalbard/Norway special cases applied.
//
// Standard UTM zone rule is modified in the North Sea:
//   Zone 32 is widened to cover 56°N..64°N  3°..12°E (Norway's coast).
//   Zone 31 is correspondingly narrowed.
//   In 72°N..84°N, zones 31..37 have irregular widths:
//     31: 0..9°E  32: skipped  33: 9..21°E
//     34: skipped  35: 21..33°E  36: skipped  37: 33..42°E
//
// Returns the adjusted zone number.
fn uz_norway_exception(lat, lon) -> int
    let lat_f = lat * 1.0
    let lon_f = lon * 1.0
    // Svalbard special case: 72N..84N
    if lat_f >= 72.0 and lat_f <= 84.0
        if lon_f >= 0.0 and lon_f < 9.0
            return 31
        if lon_f >= 9.0 and lon_f < 21.0
            return 33
        if lon_f >= 21.0 and lon_f < 33.0
            return 35
        if lon_f >= 33.0 and lon_f < 42.0
            return 37
    // Norway special case: 56N..64N, zones 31/32 boundary at 3° instead of 6°
    if lat_f >= 56.0 and lat_f < 64.0
        if lon_f >= 3.0 and lon_f < 12.0
            return 32
    // Default
    uz_zone(lon)

// uz_valid_zone: true if zone is in the valid range [1, 60].
fn uz_valid_zone(zone) -> bool
    let z = zone * 1
    z >= 1 and z <= 60
