// std/geo/latlon_bbox.nova — Lat/lon bounding box arithmetic.
//
// A bounding box is a list [min_lat, min_lon, max_lat, max_lon] (all floats).
// Convention: min_lat <= max_lat, min_lon <= max_lon (no antimeridian wrapping here).
//
// FLOAT RULES obeyed:
//   - Float literals have a decimal point.
//   - Float results from list reads multiplied by 1.0 before arithmetic.
//   - No multi-term float expression returned bare.
//   - abs via if/else (not abs() which returns i64).
//
// Symbol collision guard: all private helpers prefixed _bb_.
// ─────────────────────────────────────────────────────────────────────────────

// _bb_fmin: float minimum.
fn _bb_fmin(a, b) -> float
    let r = a * 1.0
    let bv = b * 1.0
    if bv < r
        r = bv
    r

// _bb_fmax: float maximum.
fn _bb_fmax(a, b) -> float
    let r = a * 1.0
    let bv = b * 1.0
    if bv > r
        r = bv
    r

// bb_make: construct a bounding box list [min_lat, min_lon, max_lat, max_lon].
fn bb_make(min_lat, min_lon, max_lat, max_lon) -> any
    let out = []
    out.push(min_lat * 1.0)
    out.push(min_lon * 1.0)
    out.push(max_lat * 1.0)
    out.push(max_lon * 1.0)
    out

// bb_contains: true if point (lat, lon) lies inside or on the boundary of bbox.
fn bb_contains(bbox, lat, lon) -> bool
    let mn_lat = bbox[0] * 1.0
    let mn_lon = bbox[1] * 1.0
    let mx_lat = bbox[2] * 1.0
    let mx_lon = bbox[3] * 1.0
    let lv = lat * 1.0
    let lo = lon * 1.0
    if lv < mn_lat
        return false
    if lv > mx_lat
        return false
    if lo < mn_lon
        return false
    if lo > mx_lon
        return false
    true

// bb_center: return [center_lat, center_lon] of a bounding box.
fn bb_center(bbox) -> any
    let mn_lat = bbox[0] * 1.0
    let mn_lon = bbox[1] * 1.0
    let mx_lat = bbox[2] * 1.0
    let mx_lon = bbox[3] * 1.0
    let lat_sum = mn_lat + mx_lat
    let clat = lat_sum / 2.0
    let lon_sum = mn_lon + mx_lon
    let clon = lon_sum / 2.0
    let out = []
    out.push(clat)
    out.push(clon)
    out

// bb_expand: expand a bbox outward by dlat on each lat side, dlon on each lon side.
// Returns [min_lat-dlat, min_lon-dlon, max_lat+dlat, max_lon+dlon].
fn bb_expand(bbox, dlat, dlon) -> any
    let mn_lat = bbox[0] * 1.0
    let mn_lon = bbox[1] * 1.0
    let mx_lat = bbox[2] * 1.0
    let mx_lon = bbox[3] * 1.0
    let dl = dlat * 1.0
    let dlo = dlon * 1.0
    let out = []
    out.push(mn_lat - dl)
    out.push(mn_lon - dlo)
    out.push(mx_lat + dl)
    out.push(mx_lon + dlo)
    out

// bb_union: smallest bbox containing both a and b.
fn bb_union(a, b) -> any
    let amn_lat = a[0] * 1.0
    let amn_lon = a[1] * 1.0
    let amx_lat = a[2] * 1.0
    let amx_lon = a[3] * 1.0
    let bmn_lat = b[0] * 1.0
    let bmn_lon = b[1] * 1.0
    let bmx_lat = b[2] * 1.0
    let bmx_lon = b[3] * 1.0
    let out = []
    out.push(_bb_fmin(amn_lat, bmn_lat))
    out.push(_bb_fmin(amn_lon, bmn_lon))
    out.push(_bb_fmax(amx_lat, bmx_lat))
    out.push(_bb_fmax(amx_lon, bmx_lon))
    out

// bb_intersect: intersection of two bboxes, or [] if they don't overlap.
fn bb_intersect(a, b) -> any
    let amn_lat = a[0] * 1.0
    let amn_lon = a[1] * 1.0
    let amx_lat = a[2] * 1.0
    let amx_lon = a[3] * 1.0
    let bmn_lat = b[0] * 1.0
    let bmn_lon = b[1] * 1.0
    let bmx_lat = b[2] * 1.0
    let bmx_lon = b[3] * 1.0
    let mn_lat = _bb_fmax(amn_lat, bmn_lat)
    let mn_lon = _bb_fmax(amn_lon, bmn_lon)
    let mx_lat = _bb_fmin(amx_lat, bmx_lat)
    let mx_lon = _bb_fmin(amx_lon, bmx_lon)
    if mn_lat > mx_lat
        return []
    if mn_lon > mx_lon
        return []
    let out = []
    out.push(mn_lat)
    out.push(mn_lon)
    out.push(mx_lat)
    out.push(mx_lon)
    out

// bb_intersects: true if the two bboxes overlap (share any interior or boundary).
fn bb_intersects(a, b) -> bool
    let amn_lat = a[0] * 1.0
    let amn_lon = a[1] * 1.0
    let amx_lat = a[2] * 1.0
    let amx_lon = a[3] * 1.0
    let bmn_lat = b[0] * 1.0
    let bmn_lon = b[1] * 1.0
    let bmx_lat = b[2] * 1.0
    let bmx_lon = b[3] * 1.0
    if amx_lat < bmn_lat
        return false
    if amn_lat > bmx_lat
        return false
    if amx_lon < bmn_lon
        return false
    if amn_lon > bmx_lon
        return false
    true

// bb_from_points: compute the bounding box of a list of [lat, lon] pairs.
// Requires at least one point. Returns [min_lat, min_lon, max_lat, max_lon].
fn bb_from_points(points) -> any
    let p0 = points[0]
    let init_lat = p0[0] * 1.0
    let init_lon = p0[1] * 1.0
    let mn_lat = init_lat
    let mn_lon = init_lon
    let mx_lat = init_lat
    let mx_lon = init_lon
    let n = len(points)
    let i = 1
    while i < n
        let pt = points[i]
        let plat = pt[0] * 1.0
        let plon = pt[1] * 1.0
        mn_lat = _bb_fmin(mn_lat, plat)
        mn_lon = _bb_fmin(mn_lon, plon)
        mx_lat = _bb_fmax(mx_lat, plat)
        mx_lon = _bb_fmax(mx_lon, plon)
        i = i + 1
    let out = []
    out.push(mn_lat)
    out.push(mn_lon)
    out.push(mx_lat)
    out.push(mx_lon)
    out

// bb_width: longitude span of the bbox (max_lon - min_lon).
fn bb_width(bbox) -> float
    let mn_lon = bbox[1] * 1.0
    let mx_lon = bbox[3] * 1.0
    let w = mx_lon - mn_lon
    w

// bb_height: latitude span of the bbox (max_lat - min_lat).
fn bb_height(bbox) -> float
    let mn_lat = bbox[0] * 1.0
    let mx_lat = bbox[2] * 1.0
    let h = mx_lat - mn_lat
    h

// bb_corners: return the four corner points of a bbox as a list of [lat, lon].
// Order: SW, SE, NE, NW (counterclockwise from bottom-left).
fn bb_corners(bbox) -> any
    let mn_lat = bbox[0] * 1.0
    let mn_lon = bbox[1] * 1.0
    let mx_lat = bbox[2] * 1.0
    let mx_lon = bbox[3] * 1.0
    let sw = []
    sw.push(mn_lat)
    sw.push(mn_lon)
    let se = []
    se.push(mn_lat)
    se.push(mx_lon)
    let ne = []
    ne.push(mx_lat)
    ne.push(mx_lon)
    let nw = []
    nw.push(mx_lat)
    nw.push(mn_lon)
    let out = []
    out.push(sw)
    out.push(se)
    out.push(ne)
    out.push(nw)
    out

// bb_contains_bbox: true if bbox b is entirely contained within bbox a.
fn bb_contains_bbox(a, b) -> bool
    let amn_lat = a[0] * 1.0
    let amn_lon = a[1] * 1.0
    let amx_lat = a[2] * 1.0
    let amx_lon = a[3] * 1.0
    let bmn_lat = b[0] * 1.0
    let bmn_lon = b[1] * 1.0
    let bmx_lat = b[2] * 1.0
    let bmx_lon = b[3] * 1.0
    if bmn_lat < amn_lat
        return false
    if bmx_lat > amx_lat
        return false
    if bmn_lon < amn_lon
        return false
    if bmx_lon > amx_lon
        return false
    true
