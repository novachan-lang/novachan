// std/geo/mgrs_grid.nova — MGRS grid-string parsing, formatting and validation.
//
// MGRS format: <zone><band><square><digits>
//   zone   = 1 or 2 decimal digits (1..60)
//   band   = one letter C-X excluding I and O (latitude band)
//   square = two uppercase letters identifying the 100km square
//   digits = 0, 2, 4, 6, 8, or 10 digits — easting+northing each half
//
// This module handles string/integer operations only — no projection math.
// All functions self-contained; no imports.
// Prefix: mg_
// ─────────────────────────────────────────────────────────────────────────────

// _mg_valid_bands: the 20 valid MGRS latitude band letters (C-X, no I or O).
fn _mg_valid_bands() -> string
    "CDEFGHJKLMNPQRSTUVWX"

// _mg_is_upper_alpha: true if character c is A-Z.
fn _mg_is_upper_alpha(c) -> bool
    let b = ord(c)
    if b < 65
        return false
    if b > 90
        return false
    true

// _mg_is_digit_char: true if character c is 0-9.
fn _mg_is_digit_char(c) -> bool
    let b = ord(c)
    if b < 48
        return false
    if b > 57
        return false
    true

// _mg_to_upper: convert a single ASCII character to uppercase.
fn _mg_to_upper(c) -> string
    let b = ord(c)
    if b >= 97 and b <= 122
        return chr(b - 32)
    chr(b)

// _mg_str_to_upper: convert a string to uppercase.
fn _mg_str_to_upper(s) -> string
    let n = len(s)
    let out = ""
    let i = 0
    while i < n
        out = out + _mg_to_upper(s[i])
        i = i + 1
    out

// _mg_is_valid_band: true if the given letter is a valid MGRS latitude band.
fn _mg_is_valid_band(c) -> bool
    let bands = _mg_valid_bands()
    let n = len(bands)
    let uc = _mg_to_upper(c)
    let i = 0
    let found = false
    while i < n
        if bands[i] == uc
            found = true
        i = i + 1
    found

// _mg_str_to_int: parse a decimal integer string; returns -1 on empty.
fn _mg_str_to_int(s) -> int
    let n = len(s)
    if n == 0
        return 0
    let result = 0
    let i = 0
    while i < n
        let b = ord(s[i])
        result = result * 10 + (b - 48)
        i = i + 1
    result

// _mg_int_to_str_padded: convert integer to string padded to `width` digits with leading zeros.
fn _mg_int_to_str_padded(val, width) -> string
    let s = str(val)
    let n = len(s)
    let pad = ""
    let needed = width - n
    let i = 0
    while i < needed
        pad = pad + "0"
        i = i + 1
    pad + s

// _mg_parse_raw: parse an MGRS string (no spaces, uppercase) into components.
// Returns a dict with keys: zone_str, band, square, digits_str, ok.
fn _mg_parse_raw(mgrs) -> any
    let out = {}
    out["ok"] = 0
    let n = len(mgrs)
    if n < 3
        return out
    // Parse zone: 1 or 2 leading digits.
    let i = 0
    let zone_str = ""
    if _mg_is_digit_char(mgrs[0])
        zone_str = zone_str + mgrs[0]
        i = 1
    if i < n and _mg_is_digit_char(mgrs[i])
        zone_str = zone_str + mgrs[i]
        i = i + 1
    if len(zone_str) == 0
        return out
    // Next: band letter.
    if i >= n
        return out
    let band = mgrs[i]
    if not _mg_is_upper_alpha(band)
        return out
    if not _mg_is_valid_band(band)
        return out
    i = i + 1
    // Next: two-letter 100km square.
    if i + 1 >= n
        return out
    let sq1 = mgrs[i]
    let sq2 = mgrs[i + 1]
    if not _mg_is_upper_alpha(sq1)
        return out
    if not _mg_is_upper_alpha(sq2)
        return out
    let square = sq1 + sq2
    i = i + 2
    // Remainder: numeric easting+northing digits (must be even count: 0,2,4,6,8,10).
    let digits_str = ""
    while i < n
        if not _mg_is_digit_char(mgrs[i])
            return out
        digits_str = digits_str + mgrs[i]
        i = i + 1
    let dlen = len(digits_str)
    // Allow 0,2,4,6,8,10 digits only.
    if dlen > 10
        return out
    let odd_check = dlen & 1
    if odd_check != 0
        return out
    out["zone_str"] = zone_str
    out["band"] = band
    out["square"] = square
    out["digits_str"] = digits_str
    out["ok"] = 1
    out

// mg_normalize: uppercase and strip spaces from an MGRS string.
fn mg_normalize(mgrs) -> string
    let n = len(mgrs)
    let out = ""
    let i = 0
    while i < n
        let c = mgrs[i]
        if c != " "
            out = out + _mg_to_upper(c)
        i = i + 1
    out

// mg_is_valid: true iff the MGRS string is well-formed.
fn mg_is_valid(mgrs) -> bool
    let norm = mg_normalize(mgrs)
    let parsed = _mg_parse_raw(norm)
    let ok = parsed["ok"]
    ok == 1

// mg_parse: parse an MGRS string into a dict with keys:
//   zone, band, square, easting, northing, precision.
//   easting/northing are the raw digit-group values (not scaled to metres).
//   precision is the number of digits per coordinate (0..5).
fn mg_parse(mgrs) -> any
    let norm = mg_normalize(mgrs)
    let raw = _mg_parse_raw(norm)
    let result = {}
    let ok = raw["ok"]
    if ok != 1
        result["valid"] = 0
        return result
    let zone_str = raw["zone_str"]
    let band = raw["band"]
    let square = raw["square"]
    let digits_str = raw["digits_str"]
    let dlen = len(digits_str)
    let half = dlen / 2
    let e_str = slice(digits_str, 0, half)
    let n_str = slice(digits_str, half, dlen)
    let easting = _mg_str_to_int(e_str)
    let northing = _mg_str_to_int(n_str)
    result["zone"] = _mg_str_to_int(zone_str)
    result["band"] = band
    result["square"] = square
    result["easting"] = easting
    result["northing"] = northing
    result["precision"] = half
    result["valid"] = 1
    result

// mg_precision: return the precision in metres for an MGRS string.
//   precision = number of easting (or northing) digits; each digit = one order of magnitude.
//   0 digits = 100km, 1 = 10km, 2 = 1km, 3 = 100m, 4 = 10m, 5 = 1m.
fn mg_precision(mgrs) -> int
    let parsed = mg_parse(mgrs)
    let valid = parsed["valid"]
    if valid != 1
        return 0
    let pr = parsed["precision"]
    // Convert digit count to metres: 10^(5 - digits).
    let e = 5 - pr
    let m = 1
    let i = 0
    while i < e
        m = m * 10
        i = i + 1
    m

// mg_zone: return the UTM zone number from an MGRS string.
fn mg_zone(mgrs) -> int
    let parsed = mg_parse(mgrs)
    let valid = parsed["valid"]
    if valid != 1
        return 0
    parsed["zone"]

// mg_band: return the latitude band letter from an MGRS string.
fn mg_band(mgrs) -> string
    let parsed = mg_parse(mgrs)
    let valid = parsed["valid"]
    if valid != 1
        return ""
    parsed["band"]

// mg_square: return the 2-letter 100km square designator from an MGRS string.
fn mg_square(mgrs) -> string
    let parsed = mg_parse(mgrs)
    let valid = parsed["valid"]
    if valid != 1
        return ""
    parsed["square"]

// mg_easting_northing: return [easting, northing] raw integer values.
fn mg_easting_northing(mgrs) -> any
    let parsed = mg_parse(mgrs)
    let out = []
    let valid = parsed["valid"]
    if valid != 1
        push(out, 0)
        push(out, 0)
        return out
    push(out, parsed["easting"])
    push(out, parsed["northing"])
    out

// mg_format: build an MGRS string from components.
//   digits = number of digits per coordinate (0..5); easting/northing padded to that width.
fn mg_format(zone, band, square, easting, northing, digits) -> string
    let zone_s = str(zone)
    let band_s = _mg_to_upper(band)
    let square_s = _mg_str_to_upper(square)
    if digits == 0
        return zone_s + band_s + square_s
    let e_s = _mg_int_to_str_padded(easting, digits)
    let n_s = _mg_int_to_str_padded(northing, digits)
    zone_s + band_s + square_s + e_s + n_s
