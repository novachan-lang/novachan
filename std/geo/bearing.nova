// std/geo/bearing.nova — Initial great-circle bearing between two lat/lon points.
//
// FLOAT HAZARDS obeyed:
//   • All float sub-expressions bound to named lets.
//   • atan2 result bound to let BEFORE any further arithmetic (critical gotcha).
//   • No multi-term float return — always return the final named let.
//   • Float literals always carry a decimal point.
//   • Result normalized to [0, 360) by adding 360 and taking fmod.
//
// API:
//   bearing(lat1, lon1, lat2, lon2) -> float   initial bearing in degrees [0, 360)

fn _brg_pi()
    let p = 3.14159265358979
    p

fn _brg_deg2rad(d)
    let PI = _brg_pi()
    let t = d * PI
    let r = t / 180.0
    r

fn _brg_rad2deg(r)
    let PI = _brg_pi()
    let t = r * 180.0
    let d = t / PI
    d

// bearing: Initial bearing from (lat1,lon1) to (lat2,lon2) in degrees [0,360).
// Formula:
//   y = sin(dlon)*cos(lat2)
//   x = cos(lat1)*sin(lat2) - sin(lat1)*cos(lat2)*cos(dlon)
//   theta = atan2(y, x)
//   bearing = (theta_deg + 360) mod 360
fn bearing(lat1, lon1, lat2, lon2)
    let PI = _brg_pi()
    let rlat1 = _brg_deg2rad(lat1)
    let rlat2 = _brg_deg2rad(lat2)
    let dlon = _brg_deg2rad(lon2 - lon1)
    let sindlon = sin(dlon)
    let cosdlon = cos(dlon)
    let coslat1 = cos(rlat1)
    let sinlat1 = sin(rlat1)
    let coslat2 = cos(rlat2)
    let sinlat2 = sin(rlat2)
    let y = sindlon * coslat2
    let x1 = coslat1 * sinlat2
    let x2 = sinlat1 * coslat2
    let x3 = x2 * cosdlon
    let x = x1 - x3
    // CRITICAL: bind atan2 result to a let before any further math
    let b = atan2(y, x)
    let bdeg = _brg_rad2deg(b)
    // Normalize to [0, 360): (bdeg + 360) mod 360
    let bpos = bdeg + 360.0
    let TWO_SIXTY = 360.0
    let n = bpos / TWO_SIXTY
    let nint = float_to_int(n)
    let nf = nint * 1.0
    let sub = nf * TWO_SIXTY
    let result = bpos - sub
    result
