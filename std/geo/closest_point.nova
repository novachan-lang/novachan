// std/geo/closest_point.nova — Interpolate a point at a given fraction (0..1)
// along the great circle between two lat/lon coordinates.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float constants defined inside fn bodies.
//   * Every sqrt/sin/cos/atan2 result bound to a named let.
//   * Never return a bare multi-term float expression.
//   * NOVA has no asin/acos — inline via atan2.
//   * All atan2 usage INLINED into a single function body.
//
// API:
//   intermediate_point(lat1, lon1, lat2, lon2, fraction) -> list [lat, lon]
//     Returns the point at 'fraction' of the way from (lat1,lon1) to (lat2,lon2)
//     along the great circle. fraction=0.0 → start, fraction=1.0 → end.
//     Result is [lat, lon] in degrees.
//
//     Formula (spherical linear interpolation on unit sphere):
//       A = sin((1-f)*d) / sin(d)
//       B = sin(f*d) / sin(d)
//       x = A*cos(lat1)*cos(lon1) + B*cos(lat2)*cos(lon2)
//       y = A*cos(lat1)*sin(lon1) + B*cos(lat2)*sin(lon2)
//       z = A*sin(lat1)           + B*sin(lat2)
//       lat = atan2(z, sqrt(x^2+y^2))
//       lon = atan2(y, x)

fn intermediate_point(lat1: float, lon1: float, lat2: float, lon2: float, fraction: float) -> list
    let PI = 3.14159265358979
    // Convert to radians
    let rlat1 = lat1 * PI / 180.0
    let rlon1 = lon1 * PI / 180.0
    let rlat2 = lat2 * PI / 180.0
    let rlon2 = lon2 * PI / 180.0
    // ── haversine angular distance d between the two endpoints ───────────────
    let dlat = rlat2 - rlat1
    let dlon = rlon2 - rlon1
    let sdlat = dlat / 2.0
    let sdlon = dlon / 2.0
    let sin_sdlat = sin(sdlat)
    let sin_sdlon = sin(sdlon)
    let sin_sdlat_sq = sin_sdlat * sin_sdlat
    let sin_sdlon_sq = sin_sdlon * sin_sdlon
    let cosLat1 = cos(rlat1)
    let cosLat2 = cos(rlat2)
    let a_hav = sin_sdlat_sq + cosLat1 * cosLat2 * sin_sdlon_sq
    let b_hav = 1.0 - a_hav
    let sqA_hav = sqrt(a_hav)
    let sqB_hav = sqrt(b_hav)
    let c_hav = atan2(sqA_hav, sqB_hav)
    let d = c_hav * 2.0
    // ── SLERP weights ─────────────────────────────────────────────────────────
    // A = sin((1-f)*d) / sin(d),  B = sin(f*d) / sin(d)
    // Guard d≈0 (same point): use linear blend (A=1-f, B=f)
    let sinD = sin(d)
    let one = 1.0
    let f1 = one - fraction
    let sinD_abs = sinD
    if sinD < 0.0
        sinD_abs = 0.0 - sinD
    let A = f1
    let B = fraction
    if sinD_abs > 0.0000001
        let angle_A = f1 * d
        let angle_B = fraction * d
        let sinA = sin(angle_A)
        let sinB = sin(angle_B)
        A = sinA / sinD
        B = sinB / sinD
    // ── Cartesian coordinates on unit sphere ──────────────────────────────────
    let sinLat1 = sin(rlat1)
    let sinLat2 = sin(rlat2)
    let cosLon1 = cos(rlon1)
    let cosLon2 = cos(rlon2)
    let sinLon1 = sin(rlon1)
    let sinLon2 = sin(rlon2)
    let x = A * cosLat1 * cosLon1 + B * cosLat2 * cosLon2
    let y = A * cosLat1 * sinLon1 + B * cosLat2 * sinLon2
    let z = A * sinLat1 + B * sinLat2
    // ── Convert back to lat/lon ───────────────────────────────────────────────
    let x2 = x * x
    let y2 = y * y
    let hyp = sqrt(x2 + y2)
    let rlat_out = atan2(z, hyp)
    let rlon_out = atan2(y, x)
    let lat_out = rlat_out * 180.0 / PI
    let lon_out = rlon_out * 180.0 / PI
    [lat_out, lon_out]
