// std/geo/midpoint.nova — Great-circle midpoint between two (lat,lon) points.
//
// FLOAT HAZARDS obeyed throughout:
//   • All constants defined inside fn bodies (module-level floats truncate to int).
//   • Every math builtin result bound to a named let before use.
//   • atan2/_asin results always bound to a let; never returned bare.
//   • No multi-term float expression returned directly.
//
// NOVA has no asin — inline it:
//   _asin(x) = atan2(x, sqrt(1 - x*x))
//
// Algorithm: Cartesian-vector midpoint on unit sphere.
//   Convert each (lat,lon) to (x,y,z) on unit sphere.
//   Average the vectors; project back to (lat,lon).
//
// API:
//   midpoint(lat1, lon1, lat2, lon2) -> list [midlat, midlon]  (degrees)

// _mp_asin — inline asin via atan2 identity: asin(x) = atan2(x, sqrt(1-x*x))
fn _mp_asin(x: float) -> float
    let x2 = x * x
    let inner = 1.0 - x2
    let sq = sqrt(inner)
    let r = atan2(x, sq)
    r

// midpoint — half-way point along the great circle between (lat1,lon1) and (lat2,lon2).
// Both inputs and outputs in degrees.
// Returns [midlat, midlon].
fn midpoint(lat1: float, lon1: float, lat2: float, lon2: float) -> list
    let PI = 3.14159265358979
    // Convert to radians
    let rlat1 = lat1 * PI / 180.0
    let rlon1 = lon1 * PI / 180.0
    let rlat2 = lat2 * PI / 180.0
    let rlon2 = lon2 * PI / 180.0
    // Cartesian coords on unit sphere
    let cosLat1 = cos(rlat1)
    let sinLat1 = sin(rlat1)
    let cosLon1 = cos(rlon1)
    let sinLon1 = sin(rlon1)
    let cosLat2 = cos(rlat2)
    let sinLat2 = sin(rlat2)
    let cosLon2 = cos(rlon2)
    let sinLon2 = sin(rlon2)
    let x1 = cosLat1 * cosLon1
    let y1 = cosLat1 * sinLon1
    let z1 = sinLat1
    let x2 = cosLat2 * cosLon2
    let y2 = cosLat2 * sinLon2
    let z2 = sinLat2
    // Average vectors
    let mx = x1 + x2
    let my = y1 + y2
    let mz = z1 + z2
    // Project back: midlat = asin(mz / |m|), midlon = atan2(my, mx)
    let mx2 = mx * mx
    let my2 = my * my
    let mz2 = mz * mz
    let mag = sqrt(mx2 + my2 + mz2)
    let mz_norm = mz / mag
    let midlat_r = _mp_asin(mz_norm)
    let midlon_r = atan2(my, mx)
    let midlat = midlat_r * 180.0 / PI
    let midlon = midlon_r * 180.0 / PI
    let result = [midlat, midlon]
    result
