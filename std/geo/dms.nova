// std/geo/dms.nova — Degrees-minutes-seconds (DMS) conversions.
//
// All coordinates are decimal degrees (lat in [-90,90], lon in [-180,180]).
// DMS: deg >= 0 integer, min in [0,60) integer, sec in [0.0,60.0) float,
//      hemi = 'N'/'S' for latitude, 'E'/'W' for longitude.
//
// FLOAT RULES obeyed:
//   - Float literals have a decimal point.
//   - No multi-term float expression returned bare.
//   - Float results from list reads multiplied by 1.0 before arithmetic.
//   - abs via if/else (not abs() which returns i64).
//
// Symbol collision guard: all private helpers prefixed _dms_.
// ─────────────────────────────────────────────────────────────────────────────

// _dms_fabs: absolute value of a float.
fn _dms_fabs(x) -> float
    let r = x
    if x < 0.0
        r = 0.0 - x
    r

// _dms_floor: floor toward negative infinity for non-negative values.
// For a non-negative float, this is just int(x).
// For negative float, int() truncates toward zero — subtract 1 if fractional.
fn _dms_floor(x) -> int
    let t = int(x)
    let diff = x - t * 1.0
    if diff < 0.0
        t = t - 1
    t

// dms_to_decimal: convert degrees/minutes/seconds + hemisphere to decimal degrees.
// hemi: 'N' or 'E' = positive result; 'S' or 'W' = negative result.
// Formula: deg + min/60 + sec/3600, then negated for S/W.
fn dms_to_decimal(deg, min, sec, hemi) -> float
    let d = deg * 1.0
    let m = min * 1.0
    let s = sec * 1.0
    let minutes_part = m / 60.0
    let seconds_part = s / 3600.0
    let raw = d + minutes_part + seconds_part
    if hemi == "S"
        return 0.0 - raw
    if hemi == "W"
        return 0.0 - raw
    raw

// dms_from_decimal: convert decimal degrees to a dict {deg, min, sec, hemi}.
// is_lat: true (or 1) for latitude (hemi N/S), false (or 0) for longitude (hemi E/W).
// The returned dict has integer keys "deg"/"min" (int) and "sec" (float), "hemi" (str).
fn dms_from_decimal(dec, is_lat) -> any
    let hemi = "N"
    let work = dec * 1.0
    if work < 0.0
        work = 0.0 - work
        if is_lat
            hemi = "S"
        else
            hemi = "W"
    else
        if is_lat
            hemi = "N"
        else
            hemi = "E"
    let total_sec = work * 3600.0
    let ts_int = int(total_sec)
    let d = ts_int / 3600
    let rem = ts_int - d * 3600
    let m = rem / 60
    let sec_frac = total_sec - (d * 3600) * 1.0 - (m * 60) * 1.0
    // Clamp sec_frac to [0, 60)
    if sec_frac < 0.0
        sec_frac = 0.0
    let res = {}
    res["deg"] = d
    res["min"] = m
    res["sec"] = sec_frac
    res["hemi"] = hemi
    res

// dms_format: format decimal degrees as a DMS string like '40 26 46 N'.
// Seconds are rounded to the nearest integer in the output string.
fn dms_format(dec, is_lat) -> string
    let parts = dms_from_decimal(dec, is_lat)
    let d = parts["deg"]
    let m = parts["min"]
    let sf = parts["sec"] * 1.0
    let si = int(sf)
    // Round: if frac >= 0.5 round up
    let frac = sf - si * 1.0
    if frac >= 0.5
        si = si + 1
    let h = parts["hemi"]
    str(d) + " " + str(m) + " " + str(si) + " " + h

// dms_to_dm: convert degrees/minutes/seconds to degrees + decimal minutes dict.
// Returns dict {deg (int), dec_min (float)}.
fn dms_to_dm(deg, min, sec) -> any
    let s = sec * 1.0
    let dec_min = min * 1.0 + s / 60.0
    let res = {}
    res["deg"] = deg
    res["dec_min"] = dec_min
    res

// dms_decimal_minutes: convert decimal degrees to [deg (int), decimal_min (float)].
// Returns a list [deg, decimal_min] where dec_min in [0, 60).
fn dms_decimal_minutes(dec) -> any
    let work = dec * 1.0
    let sign = 1
    if work < 0.0
        work = 0.0 - work
        sign = 0 - 1
    let d = int(work)
    let rem = work - d * 1.0
    let dm = rem * 60.0
    let out = []
    let di = d * sign
    let dmf = dm
    if sign < 0
        di = 0 - d
    out.push(di)
    out.push(dmf)
    out

// dms_parse: parse a DMS string like '40 26 46 N' to decimal degrees.
// Expected format: "deg min sec hemi" with single spaces, all tokens present.
// Returns the decimal degree value.
fn dms_parse(s) -> float
    // Tokenize by scanning for spaces
    let n = len(s)
    let tok0 = ""
    let tok1 = ""
    let tok2 = ""
    let tok3 = ""
    let tok = 0
    let i = 0
    while i < n
        let c = s[i]
        if c == " "
            tok = tok + 1
        else
            if tok == 0
                tok0 = tok0 + c
            if tok == 1
                tok1 = tok1 + c
            if tok == 2
                tok2 = tok2 + c
            if tok == 3
                tok3 = tok3 + c
        i = i + 1
    // Convert tokens to numbers
    let d = int(tok0)
    let m = int(tok1)
    let s_val = int(tok2) * 1.0
    dms_to_decimal(d, m, s_val, tok3)

// dms_seconds_total: total arc-seconds from degrees, minutes, seconds.
// Returns deg*3600 + min*60 + sec as a float.
fn dms_seconds_total(deg, min, sec) -> float
    let d = deg * 1.0
    let m = min * 1.0
    let sv = sec * 1.0
    let result = d * 3600.0 + m * 60.0 + sv
    result
