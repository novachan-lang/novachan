// std/geo/geo_bbox.nova — Lat/lon bounding boxes.
//
// A bounding box is a list [min_lat, min_lon, max_lat, max_lon] (all floats).
//
// API:
//   bbox(points) -> list [min_lat, min_lon, max_lat, max_lon]
//     points = list of [lat, lon] pairs.  Requires >= 1 point.
//   bbox_contains(box, lat, lon) -> bool
//     true if the point is inside or on the boundary of the box.
//   bbox_center(box) -> list [lat, lon]
//     centroid of the box.
//
// FLOAT RULES obeyed:
//   - All literals that must be float have decimal points.
//   - Float results from builtins are always bound to a let before use.
//   - Never compare float to int literal.
//   - No multi-term float expression in return — single-exit named result.
// ─────────────────────────────────────────────────────────────────────────────

// _gb_fmin: float minimum of two values.
fn _gb_fmin(a: float, b: float) -> float
    let result = a
    if b < a
        result = b
    result

// _gb_fmax: float maximum of two values.
fn _gb_fmax(a: float, b: float) -> float
    let result = a
    if b > a
        result = b
    result

// bbox: compute the bounding box of a list of [lat, lon] points.
// Returns [min_lat, min_lon, max_lat, max_lon].
// Requires at least one point.
fn bbox(points: list) -> list
    let p0 = points[0]
    let p0lat = p0[0] * 1.0
    let p0lon = p0[1] * 1.0
    let min_lat = p0lat
    let min_lon = p0lon
    let max_lat = p0lat
    let max_lon = p0lon
    let n = len(points)
    let i = 1
    while i < n
        let pt = points[i]
        let plat = pt[0] * 1.0
        let plon = pt[1] * 1.0
        min_lat = _gb_fmin(min_lat, plat)
        min_lon = _gb_fmin(min_lon, plon)
        max_lat = _gb_fmax(max_lat, plat)
        max_lon = _gb_fmax(max_lon, plon)
        i = i + 1
    let out = []
    out.push(min_lat)
    out.push(min_lon)
    out.push(max_lat)
    out.push(max_lon)
    out

// bbox_contains: true if (lat, lon) is inside or on the boundary of box.
// box = [min_lat, min_lon, max_lat, max_lon].
fn bbox_contains(box: list, lat: float, lon: float) -> bool
    let bmin_lat = box[0] * 1.0
    let bmin_lon = box[1] * 1.0
    let bmax_lat = box[2] * 1.0
    let bmax_lon = box[3] * 1.0
    if lat < bmin_lat
        return false
    if lat > bmax_lat
        return false
    if lon < bmin_lon
        return false
    if lon > bmax_lon
        return false
    true

// bbox_center: centroid of a bounding box.
// Returns [center_lat, center_lon].
fn bbox_center(box: list) -> list
    let bmin_lat = box[0] * 1.0
    let bmin_lon = box[1] * 1.0
    let bmax_lat = box[2] * 1.0
    let bmax_lon = box[3] * 1.0
    let lat_sum = bmin_lat + bmax_lat
    let clat = lat_sum / 2.0
    let lon_sum = bmin_lon + bmax_lon
    let clon = lon_sum / 2.0
    let out = []
    out.push(clat)
    out.push(clon)
    out
