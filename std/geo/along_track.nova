// std/geo/along_track.nova — Along-track distance (meters) from the path start
// to the closest point on the great-circle path to a given point.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float constants defined inside fn bodies.
//   * Every sqrt/sin/cos/atan2 result bound to a named let.
//   * Never return a bare multi-term float expression.
//   * NOVA has no asin/acos — inline via atan2.
//   * All atan2 usage INLINED into a single function body (avoids float-slot
//     aliasing that corrupts results when combining multiple atan2-using helpers).
//
// API:
//   along_track(lat, lon, lat1, lon1, lat2, lon2) -> float
//     Distance in meters from the path start (lat1,lon1) to the closest point
//     on the great-circle path (lat1,lon1)->(lat2,lon2) to the point (lat,lon).
//     Formula: d_at = acos( cos(d13) / cos(d_xt) ) * R
//     where d13 is angular distance start→point,
//           d_xt is the cross-track angular distance.
//     Returns a non-negative value (distance along the path from start).

fn along_track(lat: float, lon: float, lat1: float, lon1: float, lat2: float, lon2: float) -> float
    let PI = 3.14159265358979
    let R = 6371000.0
    // Convert all coords to radians
    let rlat = lat * PI / 180.0
    let rlon = lon * PI / 180.0
    let rlat1 = lat1 * PI / 180.0
    let rlon1 = lon1 * PI / 180.0
    let rlat2 = lat2 * PI / 180.0
    let rlon2 = lon2 * PI / 180.0
    // ── d13: haversine angular distance from start to point (radians) ────────
    let dlat13 = rlat - rlat1
    let dlon13 = rlon - rlon1
    let sdlat13 = dlat13 / 2.0
    let sdlon13 = dlon13 / 2.0
    let sin_sdlat13 = sin(sdlat13)
    let sin_sdlon13 = sin(sdlon13)
    let sin_sdlat13_sq = sin_sdlat13 * sin_sdlat13
    let sin_sdlon13_sq = sin_sdlon13 * sin_sdlon13
    let cosLat1 = cos(rlat1)
    let cosLat = cos(rlat)
    let a13 = sin_sdlat13_sq + cosLat1 * cosLat * sin_sdlon13_sq
    let b13 = 1.0 - a13
    let sqA13 = sqrt(a13)
    let sqB13 = sqrt(b13)
    let c13 = atan2(sqA13, sqB13)
    let d13 = c13 * 2.0
    // ── θ13: bearing from start to point ─────────────────────────────────────
    let sinDlon13 = sin(dlon13)
    let cosDlon13 = cos(dlon13)
    let sinLat1 = sin(rlat1)
    let sinLat = sin(rlat)
    let x13 = sinDlon13 * cosLat
    let y13 = cosLat1 * sinLat - sinLat1 * cosLat * cosDlon13
    let theta13 = atan2(x13, y13)
    // ── θ12: bearing from start to end ───────────────────────────────────────
    let dlon12 = rlon2 - rlon1
    let sinDlon12 = sin(dlon12)
    let cosDlon12 = cos(dlon12)
    let cosLat2 = cos(rlat2)
    let sinLat2 = sin(rlat2)
    let x12 = sinDlon12 * cosLat2
    let y12 = cosLat1 * sinLat2 - sinLat1 * cosLat2 * cosDlon12
    let theta12 = atan2(x12, y12)
    // ── cross-track angular distance d_xt (radians) ──────────────────────────
    let diff = theta13 - theta12
    let sinD13 = sin(d13)
    let sinDiff = sin(diff)
    let arg_xt = sinD13 * sinDiff
    let arg_xt2 = arg_xt * arg_xt
    let one_minus_xt2 = 1.0 - arg_xt2
    let sqXt = sqrt(one_minus_xt2)
    let d_xt = atan2(arg_xt, sqXt)
    // ── along-track formula: d_at = acos( cos(d13) / cos(d_xt) ) ─────────────
    // acos(v) = atan2(sqrt(1-v^2), v)   [inline since NOVA has no acos]
    let cosD13 = cos(d13)
    let cosDxt = cos(d_xt)
    // guard against division by near-zero (point already ON path → d_xt≈0 → cosDxt≈1)
    let v = cosD13 / cosDxt
    // clamp v to [-1,1] to keep acos domain valid
    let v_clamped = v
    if v > 1.0
        v_clamped = 1.0
    if v < -1.0
        v_clamped = -1.0
    let v2 = v_clamped * v_clamped
    let one_minus_v2 = 1.0 - v2
    let sqV = sqrt(one_minus_v2)
    let d_at = atan2(sqV, v_clamped)
    let result = d_at * R
    result
