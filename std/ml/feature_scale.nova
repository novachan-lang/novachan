// ============================================================================
// NOVA Standard Library — std/ml/feature_scale
// ============================================================================
// Feature scaling / normalization over a flat list of numbers (a single
// feature column). Pure math, no dependencies — LEAF module.
//
// PUBLIC API
//   fs_min_max(data, min, max)   -> list   rescale into [min, max]
//   fs_standard(data, mean, stddev) -> list   z-score: (x - mean) / stddev
//   fs_robust(data, median, iqr) -> list   (x - median) / iqr
//   fs_normalize(data)           -> list   unit-vector (L2) normalization
//
// All four take/return a list of int-or-float, coerced to float on read.
// Empty input -> empty output. Degenerate scale (max==min, stddev==0,
// iqr==0, or zero L2 norm) -> every output element is 0.0 rather than
// dividing by zero (NEVER crash on malformed/degenerate statistics).
//
// float codegen safety: every returned float is bound to a `let` before
// being used, and float absolute value never uses abs() (abs() returns an
// int in the NOVA runtime) — this module has no need for abs, so that
// pitfall does not apply here, but comparisons against 0.0 are done with
// coerced (`* 1.0`) operands throughout to avoid int/float compare bugs.
//
// SYMBOL COLLISION GUARD: all private helpers and this module's fields (none
// — no structs are used) are prefixed _fs_ / fs_.
// ============================================================================

// fs_min_max: rescale every element of `data` linearly so that the input
// range [min, max] maps to [0.0, 1.0]. Values outside [min, max] extrapolate
// (are not clamped) — callers that want clamping should clamp afterward.
fn fs_min_max(data: list, min: float, max: float) -> list
    let out = []
    let span = max - min
    for i in 0..len(data)
        let v = data[i] * 1.0
        let scaled = 0.0
        if span == 0.0
            scaled = 0.0
        else
            scaled = (v - min) / span
        push(out, scaled)
    out

// fs_standard: z-score normalization — (x - mean) / stddev.
fn fs_standard(data: list, mean: float, stddev: float) -> list
    let out = []
    for i in 0..len(data)
        let v = data[i] * 1.0
        let scaled = 0.0
        if stddev == 0.0
            scaled = 0.0
        else
            scaled = (v - mean) / stddev
        push(out, scaled)
    out

// fs_robust: median/IQR scaling — (x - median) / iqr. Less sensitive to
// outliers than fs_standard since neither statistic is skewed by extremes.
fn fs_robust(data: list, median: float, iqr: float) -> list
    let out = []
    for i in 0..len(data)
        let v = data[i] * 1.0
        let scaled = 0.0
        if iqr == 0.0
            scaled = 0.0
        else
            scaled = (v - median) / iqr
        push(out, scaled)
    out

// _fs_sum_sq: sum of squares of a float list (the sqrt-of-this is the L2
// norm) — kept separate from the sqrt call itself so fs_normalize can
// recompute it fresh each iteration (see NOTE below).
fn _fs_sum_sq(data: list) -> float
    let acc = 0.0
    for i in 0..len(data)
        let v = data[i] * 1.0
        acc += v * v
    acc

// fs_normalize: unit-vector (L2) normalization — every element divided by
// the list's Euclidean norm, so the resulting list has L2 norm 1.0 (unless
// the input is the zero vector, which maps to all-zeros).
//
// NOTE: sqrt() is called INLINE at the point of division rather than
// computed once and stored in a `let` for reuse across the loop — a
// documented NOVA codegen hazard (a stored/reused sqrt-of-accumulator
// value has produced garbage in other modules, layout-dependently; the
// confirmed-reliable workaround is to keep sqrt() inline in the consuming
// expression). _fs_sum_sq itself is cheap to recompute per element for the
// list sizes this module targets.
fn fs_normalize(data: list) -> list
    let out = []
    let sum_sq = _fs_sum_sq(data)
    for i in 0..len(data)
        let v = data[i] * 1.0
        let scaled = 0.0
        if sum_sq != 0.0
            scaled = v / sqrt(sum_sq)
        push(out, scaled)
    out
