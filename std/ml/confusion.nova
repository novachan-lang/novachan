// ============================================================================
// NOVA Standard Library — std/ml/confusion
// ============================================================================
// Confusion-matrix construction and the standard per-class metrics derived
// from it (accuracy, precision, recall, F1). Pure math, no dependencies —
// LEAF module.
//
// LABEL CONVENTION: `actual` and `predicted` are lists of int class labels;
// `classes` is the list of int label VALUES that defines row/column order
// (labels need not be contiguous, e.g. [-1, 1] or [0, 2, 5] both work).
// Use std/ml/label_encode first if your labels are strings.
//
// PUBLIC API
//   cm_build(actual, predicted, classes) -> list   n x n int matrix,
//                                                    cm[i][j] = count of
//                                                    (actual==classes[i] AND
//                                                     predicted==classes[j])
//   cm_accuracy(cm)         -> float   overall correct / total
//   cm_precision(cm, cls)   -> float   TP / (TP + FP) for row/col index cls
//   cm_recall(cm, cls)      -> float   TP / (TP + FN) for row/col index cls
//   cm_f1(cm, cls)          -> float   harmonic mean of precision & recall
//
// `cls` in cm_precision/cm_recall/cm_f1 is a 0-based INDEX into the same
// `classes` list used to build the matrix (NOT the label value itself) —
// the matrix itself carries no label metadata, only counts.
//
// Degenerate rows/columns (a class that never appears as actual or
// predicted) yield 0.0 for precision/recall/F1 rather than dividing by
// zero. Out-of-range `cls` returns 0.0 (bounds-checked, never crashes).
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _cm_.
// ============================================================================

// _cm_index_of: return the index of `val` in `classes`, or -1 if absent.
fn _cm_index_of(classes: list, val: int) -> int
    for i in 0..len(classes)
        if classes[i] == val
            return i
    -1

// cm_build: tally (actual, predicted) pairs into an n x n matrix, where n =
// len(classes). Rows are indexed by the actual class's position in
// `classes`, columns by the predicted class's position. Pairs whose actual
// or predicted value is not present in `classes` are skipped (ignored)
// rather than crashing or silently corrupting an unrelated cell.
fn cm_build(actual: list, predicted: list, classes: list) -> list
    let n = len(classes)
    let cm = []
    for r in 0..n
        let row = []
        let c = 0
        while c < n
            push(row, 0)
            c = c + 1
        push(cm, row)
    let m = len(actual)
    if len(predicted) < m
        m = len(predicted)
    for i in 0..m
        let ai = _cm_index_of(classes, actual[i])
        let pi = _cm_index_of(classes, predicted[i])
        if ai >= 0 and pi >= 0
            let row = cm[ai]
            row[pi] = row[pi] + 1
    cm

// _cm_total: sum of every cell in the matrix.
fn _cm_total(cm: list) -> int
    let total = 0
    for r in 0..len(cm)
        let row = cm[r]
        let c = 0
        while c < len(row)
            total = total + row[c]
            c = c + 1
    total

// cm_accuracy: (sum of diagonal) / (sum of all cells).
fn cm_accuracy(cm: list) -> float
    let total = _cm_total(cm)
    if total == 0
        return 0.0
    let correct = 0
    for i in 0..len(cm)
        let row = cm[i]
        if i < len(row)
            correct = correct + row[i]
    let result = correct * 1.0 / (total * 1.0)
    result

// _cm_col_sum: sum of column `cls` across all rows (predicted == cls).
fn _cm_col_sum(cm: list, cls: int) -> int
    let s = 0
    for r in 0..len(cm)
        let row = cm[r]
        if cls >= 0 and cls < len(row)
            s = s + row[cls]
    s

// cm_precision: TP / (TP + FP) = cm[cls][cls] / column-sum(cls).
fn cm_precision(cm: list, cls: int) -> float
    if cls < 0 or cls >= len(cm)
        return 0.0
    let row = cm[cls]
    if cls >= len(row)
        return 0.0
    let tp = row[cls]
    let col_total = _cm_col_sum(cm, cls)
    if col_total == 0
        return 0.0
    let result = tp * 1.0 / (col_total * 1.0)
    result

// cm_recall: TP / (TP + FN) = cm[cls][cls] / row-sum(cls).
fn cm_recall(cm: list, cls: int) -> float
    if cls < 0 or cls >= len(cm)
        return 0.0
    let row = cm[cls]
    if cls >= len(row)
        return 0.0
    let tp = row[cls]
    let row_total = 0
    for c in 0..len(row)
        row_total = row_total + row[c]
    if row_total == 0
        return 0.0
    let result = tp * 1.0 / (row_total * 1.0)
    result

// cm_f1: harmonic mean of precision and recall — 2*P*R / (P+R).
fn cm_f1(cm: list, cls: int) -> float
    let p = cm_precision(cm, cls)
    let r = cm_recall(cm, cls)
    if p + r == 0.0
        return 0.0
    let result = 2.0 * p * r / (p + r)
    result
