// ============================================================================
// NOVA Standard Library — std/ml/one_hot
// ============================================================================
// One-hot encoding/decoding for int class labels. Pure math, no
// dependencies — LEAF module.
//
// LABEL CONVENTION: `labels` is a list of int class labels; `classes` is
// the list of int label VALUES that defines column order (need not be
// contiguous). Use std/ml/label_encode first if your labels are strings.
//
// PUBLIC API
//   oh_encode(labels, classes)   -> list   n x len(classes) binary matrix;
//                                            row i has a 1 in the column
//                                            matching labels[i], 0 elsewhere
//   oh_decode(encoded, classes)  -> list   inverse of oh_encode: for each
//                                            row, returns classes[argmax]
//
// A label not present in `classes` encodes to an all-zero row (no crash,
// no silently-wrong column). A row in `encoded` that is all zero, or whose
// column count doesn't match len(classes), decodes as classes[0] if
// classes is non-empty (defined fallback), matching "no active class ->
// default to the first class" rather than crashing; if classes is empty,
// decodes to -1 (sentinel: no valid class exists at all).
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _oh_.
// ============================================================================

// _oh_index_of: return the index of `val` in `classes`, or -1 if absent.
fn _oh_index_of(classes: list, val: int) -> int
    let i = 0
    while i < len(classes)
        if classes[i] == val
            return i
        i = i + 1
    -1

// oh_encode: build the n x len(classes) binary indicator matrix.
fn oh_encode(labels: list, classes: list) -> list
    let width = len(classes)
    let out = []
    let i = 0
    while i < len(labels)
        let row = []
        let c = 0
        while c < width
            push(row, 0)
            c = c + 1
        let idx = _oh_index_of(classes, labels[i])
        if idx >= 0 and idx < width
            row[idx] = 1
        push(out, row)
        i = i + 1
    out

// _oh_argmax_row: index of the largest value in a row (first occurrence on
// ties). Returns -1 for an empty row.
fn _oh_argmax_row(row: list) -> int
    let n = len(row)
    if n == 0
        return -1
    let best_i = 0
    let best_v = row[0]
    let i = 1
    while i < n
        if row[i] > best_v
            best_v = row[i]
            best_i = i
        i = i + 1
    best_i

// oh_decode: inverse of oh_encode — for each row, pick the argmax column
// and map it back through `classes` to the original label value.
fn oh_decode(encoded: list, classes: list) -> list
    let out = []
    let n_classes = len(classes)
    let r = 0
    while r < len(encoded)
        let row = encoded[r]
        let idx = _oh_argmax_row(row)
        if idx >= 0 and idx < n_classes
            push(out, classes[idx])
        else
            if n_classes > 0
                push(out, classes[0])
            else
                push(out, -1)
        r = r + 1
    out
