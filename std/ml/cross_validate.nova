// ============================================================================
// NOVA Standard Library — std/ml/cross_validate
// ============================================================================
// Generic k-fold cross-validation harness: repeatedly train a model on
// k-1 folds and evaluate it on the held-out fold, using DETERMINISTIC
// (non-random) fold assignment from std/ml/train_split's ts_kfold_indices.
// Depends on: std/ml/train_split.
//
// PUBLIC API
//   cv_score(data, labels, k, model_fn, eval_fn) -> list   k float scores,
//                                                            one per fold
//
// `data` is a list of feature rows (any per-row shape the caller's
// model_fn understands — this module never inspects a row's contents,
// only gathers/scatters whole rows by index); `labels` is the aligned
// list of targets. `model_fn` and `eval_fn` are ordinary NOVA function
// VALUES (named functions or closures) with the contracts:
//   model_fn(train_x: list, train_y: list, test_x: list) -> list
//     trains on (train_x, train_y) and returns predictions for test_x,
//     aligned 1:1 with test_x's rows.
//   eval_fn(actual: list, predicted: list) -> float
//     scores one fold's held-out labels against model_fn's predictions
//     (e.g. std/ml/metrics' mt_mse/mt_rmse/mt_mae/mt_r2, or
//     std/ml/confusion-based accuracy for a classifier).
//
// k is passed through to ts_kfold_indices, which clamps it to [1,
// len(data)] and returns [] for n==0 — cv_score mirrors that: an empty
// `data` yields an empty score list rather than crashing or calling
// model_fn/eval_fn on nothing.
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _cv_.
// ============================================================================

import std/ml/train_split

// _cv_gather: build a new list containing src[indices[0]], src[indices[1]],
// ... (bounds-checked — an out-of-range index is skipped rather than
// crashing, though ts_kfold_indices never produces one for a matching n).
fn _cv_gather(src: list, indices: list) -> list
    let out = []
    let i = 0
    while i < len(indices)
        let idx = indices[i]
        if idx >= 0 and idx < len(src)
            push(out, src[idx])
        i = i + 1
    out

// cv_score: run k-fold cross-validation, returning one score per fold (in
// fold order, matching ts_kfold_indices' order).
fn cv_score(data: list, labels: list, k: int, model_fn, eval_fn) -> list
    let n = len(data)
    if n == 0
        return []
    let folds = ts_kfold_indices(n, k)
    let scores = []
    let i = 0
    while i < len(folds)
        let pair = folds[i]
        let train_idx = pair[0]
        let test_idx = pair[1]
        let train_x = _cv_gather(data, train_idx)
        let train_y = _cv_gather(labels, train_idx)
        let test_x = _cv_gather(data, test_idx)
        let test_y = _cv_gather(labels, test_idx)
        let predicted = model_fn(train_x, train_y, test_x)
        let score = eval_fn(test_y, predicted)
        push(scores, score)
        i = i + 1
    scores
