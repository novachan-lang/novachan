// ============================================================================
// NOVA Standard Library — std/ml/kmeans
// ============================================================================
// K-means clustering (Lloyd's algorithm) over a dense 2D float dataset.
// Initialization is DETERMINISTIC (the first k data points, in input
// order) rather than random, matching this library's project-wide
// convention of reproducible, seed-free ML utilities (see
// std/ml/train_split's ts_split for the same choice) — callers who want
// randomized init (e.g. k-means++) should shuffle/select `data` themselves
// before calling km_fit. Pure math, no dependencies — LEAF module.
//
// PUBLIC API
//   km_fit(data_2d, k, max_iter) -> dict   { "centroids": list(list(float)),
//                                             "assignments": list(int) }
//   km_predict(centroids, point) -> int    index of the nearest centroid
//
// ALGORITHM (km_fit, standard Lloyd's algorithm):
//   1. centroids = the first k rows of data_2d (deterministic init)
//   2. repeat up to max_iter times:
//      a. assign every point to its nearest centroid (Euclidean distance)
//      b. recompute each centroid as the mean of its assigned points
//         (a centroid with NO assigned points keeps its PREVIOUS position
//         — "empty cluster" is a well-known degenerate case; re-seeding it
//         randomly is the usual fix, but this module has no PRNG and no
//         randomness by design, so it holds still instead, which is a
//         defined, deterministic, never-crashes behavior)
//      c. if no point's assignment changed since step (a), stop early
//         (converged)
//
// k is clamped to [1, len(data_2d)] (k > n would create empty clusters,
// which km_fit's "hold still" rule handles safely, but clamping keeps the
// output meaningfully sized). n==0 -> {"centroids": [], "assignments": []}.
//
// float codegen safety: kn_euclidean-style squared-distance comparisons
// avoid sqrt entirely (comparing squared distances is equivalent to
// comparing distances for nearest-centroid selection, and skips a sqrt
// call per comparison — both a performance win and a hazard-avoidance
// win, since this module never needs to store the distance itself, only
// compare it).
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _km_.
// ============================================================================

// _km_sq_dist: squared Euclidean distance between two equal-length float
// vectors (no sqrt — callers only need to COMPARE distances, and squared
// distance preserves ordering for all-non-negative values).
fn _km_sq_dist(a: list, b: list) -> float
    let n = len(a)
    if len(b) < n
        n = len(b)
    let acc = 0.0
    for i in 0..n
        let d = a[i] * 1.0 - b[i] * 1.0
        acc = acc + d * d
    acc

// km_predict: index of the centroid nearest to `point` (ties broken toward
// the smaller index). Returns -1 if `centroids` is empty.
fn km_predict(centroids: list, point: list) -> int
    let n = len(centroids)
    if n == 0
        return -1
    let best_i = 0
    let best_d = _km_sq_dist(centroids[0], point)
    for i in 1..n
        let d = _km_sq_dist(centroids[i], point)
        if d < best_d
            best_d = d
            best_i = i
    best_i

// _km_row_copy: shallow copy of a float row (new list, same values) — used
// to seed initial centroids without aliasing data_2d's rows (see the
// "let t = c aliases a list" codegen gotcha: mutating a centroid must
// never mutate the original data row it was seeded from).
fn _km_row_copy(row: list) -> list
    let out = [row[i] * 1.0 for i in 0..len(row)]
    out

// km_fit: cluster data_2d into k clusters via Lloyd's algorithm.
fn km_fit(data_2d: list, k: int, max_iter: int) -> dict
    let result = {}
    let n = len(data_2d)
    if n == 0
        result["centroids"] = []
        result["assignments"] = []
        return result
    let kk = k
    if kk < 1
        kk = 1
    if kk > n
        kk = n
    let centroids = [_km_row_copy(data_2d[ci]) for ci in 0..kk]
    let d = len(centroids[0])
    let assignments = [-1 for ai in 0..n]
    let iters = max_iter
    if iters < 1
        iters = 1
    let iter = 0
    let converged = 0
    while iter < iters and converged == 0
        // Step (a): assign every point to its nearest centroid.
        let changed = 0
        for p in 0..n
            let new_a = km_predict(centroids, data_2d[p])
            if new_a != assignments[p]
                changed = 1
            assignments[p] = new_a
        // Step (b): recompute each centroid as the mean of its assigned
        // points (holds still — see module doc — if a cluster is empty).
        let sums = []
        let counts = []
        for cj in 0..kk
            let zero_row = []
            let z = 0
            while z < d
                push(zero_row, 0.0)
                z = z + 1
            push(sums, zero_row)
            push(counts, 0)
        for q in 0..n
            let cluster = assignments[q]
            if cluster >= 0 and cluster < kk
                let row = data_2d[q]
                let sum_row = sums[cluster]
                let f = 0
                while f < d
                    let v = 0.0
                    if f < len(row)
                        v = row[f] * 1.0
                    sum_row[f] = sum_row[f] + v
                    f = f + 1
                counts[cluster] = counts[cluster] + 1
        for ck in 0..kk
            let cnt = counts[ck]
            if cnt > 0
                let sum_row2 = sums[ck]
                let new_centroid = []
                let g = 0
                while g < d
                    let mean_val = sum_row2[g] / (cnt * 1.0)
                    push(new_centroid, mean_val)
                    g = g + 1
                centroids[ck] = new_centroid
        if changed == 0
            converged = 1
        iter = iter + 1
    result["centroids"] = centroids
    result["assignments"] = assignments
    result
