// ============================================================================
// NOVA Standard Library — std/ml/metrics
// ============================================================================
// Regression evaluation metrics over two aligned float lists (actual vs.
// predicted). Pure math, no dependencies — LEAF module.
//
// PUBLIC API
//   mt_mse(actual, predicted)  -> float   mean squared error
//   mt_rmse(actual, predicted) -> float   root mean squared error
//   mt_mae(actual, predicted)  -> float   mean absolute error
//   mt_r2(actual, predicted)   -> float   coefficient of determination
//   mt_mape(actual, predicted) -> float   mean absolute percentage error (%)
//
// All five walk min(len(actual), len(predicted)) pairs (mismatched lengths
// never read out of bounds). Empty input -> 0.0 for every metric.
//
// float codegen safety: |x| is computed via if/else (abs() returns an int
// in the NOVA runtime, never usable for floats); every returned float is
// bound to a `let` before the return statement (large inline multi-term
// float expressions in a `return` have triggered uninitialized-slot bugs
// elsewhere in this codebase — see reference_nova_float_codegen_geo_bearing).
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _mt_.
// ============================================================================

// _mt_fabs: float absolute value via if/else (NEVER abs() — it returns int).
fn _mt_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// _mt_pair_count: number of (actual, predicted) pairs safe to walk.
fn _mt_pair_count(actual: list, predicted: list) -> int
    let n = len(actual)
    if len(predicted) < n
        n = len(predicted)
    n

// mt_mse: mean squared error — mean((a - p)^2).
fn mt_mse(actual: list, predicted: list) -> float
    let n = _mt_pair_count(actual, predicted)
    if n == 0
        return 0.0
    let acc = 0.0
    for i in 0..n
        let d = actual[i] * 1.0 - predicted[i] * 1.0
        acc += d * d
    let result = acc / (n * 1.0)
    result

// mt_rmse: root mean squared error — sqrt(mse).
fn mt_rmse(actual: list, predicted: list) -> float
    let mse = mt_mse(actual, predicted)
    let result = sqrt(mse)
    result

// mt_mae: mean absolute error — mean(|a - p|).
fn mt_mae(actual: list, predicted: list) -> float
    let n = _mt_pair_count(actual, predicted)
    if n == 0
        return 0.0
    let acc = 0.0
    for i in 0..n
        let d = actual[i] * 1.0 - predicted[i] * 1.0
        acc += _mt_fabs(d)
    let result = acc / (n * 1.0)
    result

// mt_r2: coefficient of determination — 1 - SS_res / SS_tot.
// Degenerate (SS_tot == 0, i.e. every actual value identical): 1.0 if the
// fit is exact (SS_res == 0 too), else 0.0.
fn mt_r2(actual: list, predicted: list) -> float
    let n = _mt_pair_count(actual, predicted)
    if n == 0
        return 0.0
    let sum_a = 0.0
    for i in 0..n
        sum_a += actual[i] * 1.0
    let mean_a = sum_a / (n * 1.0)
    let ss_res = 0.0
    let ss_tot = 0.0
    for j in 0..n
        let a = actual[j] * 1.0
        let p = predicted[j] * 1.0
        let dr = a - p
        let dt = a - mean_a
        ss_res += dr * dr
        ss_tot += dt * dt
    if ss_tot == 0.0
        if ss_res == 0.0
            return 1.0
        return 0.0
    let result = 1.0 - ss_res / ss_tot
    result

// mt_mape: mean absolute percentage error, as a PERCENT (0..100+ typical
// range, unbounded above). Pairs where actual == 0.0 are skipped (undefined
// percentage error, cannot divide by zero) rather than crashing; if every
// pair is skipped, returns 0.0.
fn mt_mape(actual: list, predicted: list) -> float
    let n = _mt_pair_count(actual, predicted)
    if n == 0
        return 0.0
    let acc = 0.0
    let counted = 0
    for i in 0..n
        let a = actual[i] * 1.0
        let p = predicted[i] * 1.0
        if a != 0.0
            let ratio = _mt_fabs(a - p) / _mt_fabs(a)
            acc += ratio
            counted += 1
    if counted == 0
        return 0.0
    let result = acc / (counted * 1.0) * 100.0
    result
