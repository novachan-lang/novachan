// std/matrix/matlu.nova — LU decomposition with partial pivoting.
// Representation: matrix = dict {r, c, d} where d is a flat row-major list of floats.
// Element (i,j) = d[i*c + j].  All helpers prefixed mlu_ to avoid global collisions.
// LEAF — imports NOTHING.
//
// Public API:
//   mlu_decompose(m)       -> dict {L, U, P, sign}  partial-pivot LU: P*A = L*U
//   mlu_solve(lu, b)       -> list   solve A*x=b via forward+back substitution
//   mlu_det(lu)            -> float  sign * product of U diagonal
//   mlu_l(lu)              -> dict   extract L matrix
//   mlu_u(lu)              -> dict   extract U matrix
//   mlu_p(lu)              -> dict   extract P matrix
//   mlu_verify(m, tol)     -> bool   check P*A == L*U within tolerance
//   mlu_reconstruct(lu)    -> dict   compute L*U (should equal P*A)

// ── flat-matrix helpers ────────────────────────────────────────────────────────

// mlu_make: build a matrix dict from dimensions and a flat float list.
fn mlu_make(r: int, c: int, data: list) -> dict
    let m = {}
    m["r"] = r
    m["c"] = c
    m["d"] = data
    m

// mlu_get: read element (i,j) from flat matrix.
fn mlu_get(m: dict, i: int, j: int) -> float
    let cols = m["c"]
    let d = m["d"]
    let idx = i * cols + j
    d[idx] * 1.0

// mlu_set: write element (i,j) = v into the flat data list.
fn mlu_set(m: dict, i: int, j: int, v: float)
    let cols = m["c"]
    let d = m["d"]
    let idx = i * cols + j
    d[idx] = v

// mlu_zeros: make an r x c zero matrix.
fn mlu_zeros(r: int, c: int) -> dict
    let data = []
    let total = r * c
    let k = 0
    while k < total
        push(data, 0.0)
        k = k + 1
    mlu_make(r, c, data)

// mlu_identity: make an n x n identity matrix.
fn mlu_identity(n: int) -> dict
    let data = []
    let total = n * n
    let k = 0
    while k < total
        push(data, 0.0)
        k = k + 1
    let m = mlu_make(n, n, data)
    let i = 0
    while i < n
        mlu_set(m, i, i, 1.0)
        i = i + 1
    m

// mlu_copy: deep copy a matrix.
fn mlu_copy(m: dict) -> dict
    let r = m["r"]
    let c = m["c"]
    let d = m["d"]
    let data = []
    let total = r * c
    let k = 0
    while k < total
        let v = d[k] * 1.0
        push(data, v)
        k = k + 1
    mlu_make(r, c, data)

// mlu_matmul: multiply two flat matrices (r1 x k) * (k x c2) -> (r1 x c2).
fn mlu_matmul(a: dict, b: dict) -> dict
    let r1 = a["r"]
    let k = a["c"]
    let c2 = b["c"]
    let out = mlu_zeros(r1, c2)
    let i = 0
    while i < r1
        let j = 0
        while j < c2
            let s = 0.0
            let p = 0
            while p < k
                let av = mlu_get(a, i, p)
                let bv = mlu_get(b, p, j)
                s = s + av * bv
                p = p + 1
            mlu_set(out, i, j, s)
            j = j + 1
        i = i + 1
    out

// ── LU decomposition ──────────────────────────────────────────────────────────

// mlu_decompose: Doolittle's LU decomposition with partial pivoting.
// Returns dict {L, U, P, sign} where P*A = L*U.
// L is unit-lower-triangular, U is upper-triangular.
// sign is +1.0 or -1.0 (number of row swaps).
fn mlu_decompose(m: dict) -> dict
    let n = m["r"]
    let L = mlu_identity(n)
    let U = mlu_copy(m)
    let P = mlu_identity(n)
    let sign = 1.0
    let col = 0
    while col < n
        // Find pivot: largest absolute value in column col at or below row col.
        let pivot_row = col
        let pivot_val = 0.0
        if mlu_get(U, col, col) < 0.0
            pivot_val = 0.0 - mlu_get(U, col, col)
        else
            pivot_val = mlu_get(U, col, col)
        let r = col + 1
        while r < n
            let v = mlu_get(U, r, col)
            let av = 0.0
            if v < 0.0
                av = 0.0 - v
            else
                av = v
            if av > pivot_val
                pivot_val = av
                pivot_row = r
            r = r + 1
        // Swap rows in U and P; adjust L.
        if pivot_row != col
            sign = 0.0 - sign
            // Swap full rows in U.
            let j = 0
            while j < n
                let tmp_u = mlu_get(U, col, j)
                let swap_u = mlu_get(U, pivot_row, j)
                mlu_set(U, col, j, swap_u)
                mlu_set(U, pivot_row, j, tmp_u)
                j = j + 1
            // Swap full rows in P.
            let jp = 0
            while jp < n
                let tmp_p = mlu_get(P, col, jp)
                let swap_p = mlu_get(P, pivot_row, jp)
                mlu_set(P, col, jp, swap_p)
                mlu_set(P, pivot_row, jp, tmp_p)
                jp = jp + 1
            // Swap already-filled L entries (columns 0..col-1).
            let jl = 0
            while jl < col
                let tmp_l = mlu_get(L, col, jl)
                let swap_l = mlu_get(L, pivot_row, jl)
                mlu_set(L, col, jl, swap_l)
                mlu_set(L, pivot_row, jl, tmp_l)
                jl = jl + 1
        // Eliminate.
        let diag = mlu_get(U, col, col)
        if diag == 0.0
            col = col + 1
        else
            let row2 = col + 1
            while row2 < n
                let factor = mlu_get(U, row2, col) / diag
                mlu_set(L, row2, col, factor)
                let j2 = col
                while j2 < n
                    let new_u = mlu_get(U, row2, j2) - factor * mlu_get(U, col, j2)
                    mlu_set(U, row2, j2, new_u)
                    j2 = j2 + 1
                row2 = row2 + 1
            col = col + 1
    let result = {}
    result["L"] = L
    result["U"] = U
    result["P"] = P
    result["sign"] = sign
    result

// mlu_l: extract L from a decompose result.
fn mlu_l(lu: dict) -> dict
    lu["L"]

// mlu_u: extract U from a decompose result.
fn mlu_u(lu: dict) -> dict
    lu["U"]

// mlu_p: extract P from a decompose result.
fn mlu_p(lu: dict) -> dict
    lu["P"]

// mlu_det: determinant = sign * product of diagonal of U.
fn mlu_det(lu: dict) -> float
    let U = lu["U"]
    let n = U["r"]
    let sign = lu["sign"] * 1.0
    let prod = 1.0
    let i = 0
    while i < n
        let d = mlu_get(U, i, i)
        prod = prod * d
        i = i + 1
    let result = sign * prod
    result

// mlu_solve: solve A*x = b using forward then back substitution.
// lu must be the result of mlu_decompose(A).
// b is a plain list of floats of length n.
// Returns a list of floats.
fn mlu_solve(lu: dict, b: list) -> list
    let L = lu["L"]
    let U = lu["U"]
    let P = lu["P"]
    let n = L["r"]
    // Apply permutation P to b: pb = P * b.
    let pb = []
    let i = 0
    while i < n
        let s = 0.0
        let j = 0
        while j < n
            let pv = mlu_get(P, i, j)
            let bv = b[j] * 1.0
            s = s + pv * bv
            j = j + 1
        push(pb, s)
        i = i + 1
    // Forward substitution: L * y = pb.
    let y = []
    let fi = 0
    while fi < n
        push(y, 0.0)
        fi = fi + 1
    let fwd = 0
    while fwd < n
        let s2 = pb[fwd] * 1.0
        let j2 = 0
        while j2 < fwd
            let lv = mlu_get(L, fwd, j2)
            let yv = y[j2] * 1.0
            s2 = s2 - lv * yv
            j2 = j2 + 1
        y[fwd] = s2
        fwd = fwd + 1
    // Back substitution: U * x = y.
    let x = []
    let xi = 0
    while xi < n
        push(x, 0.0)
        xi = xi + 1
    let bk = n - 1
    while bk >= 0
        let s3 = y[bk] * 1.0
        let j3 = bk + 1
        while j3 < n
            let uv = mlu_get(U, bk, j3)
            let xv = x[j3] * 1.0
            s3 = s3 - uv * xv
            j3 = j3 + 1
        let diag2 = mlu_get(U, bk, bk)
        let ad2 = diag2
        if ad2 < 0.0
            ad2 = 0.0 - ad2
        if ad2 < 0.000000000001
            return []
        x[bk] = s3 / diag2
        bk = bk - 1
    x

// mlu_reconstruct: compute L*U (should equal P*A).
fn mlu_reconstruct(lu: dict) -> dict
    let L = lu["L"]
    let U = lu["U"]
    mlu_matmul(L, U)

// mlu_verify: check that P*A == L*U within tolerance tol.
fn mlu_verify(m: dict, tol: float) -> bool
    let lu = mlu_decompose(m)
    let P = lu["P"]
    let pa = mlu_matmul(P, m)
    let lu2 = mlu_reconstruct(lu)
    let n = m["r"]
    let ok = true
    let i = 0
    while i < n
        let j = 0
        while j < n
            let a = mlu_get(pa, i, j)
            let b2 = mlu_get(lu2, i, j)
            let diff = a - b2
            if diff < 0.0
                diff = 0.0 - diff
            if diff > tol
                ok = false
            j = j + 1
        i = i + 1
    ok
