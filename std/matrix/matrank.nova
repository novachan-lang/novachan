// std/matrix/matrank.nova — Matrix rank, row echelon form, pivot analysis.
//
// Matrix representation: a dict with keys 'r' (rows), 'c' (cols), 'd' (flat
// row-major list of floats, length r*c). Element (i,j) = d[i*c + j].
//
// All public functions are prefixed mr_ to avoid global symbol collisions.
// SELF-CONTAINED: imports nothing; defines its own mat helpers (prefixed mr_).
//
// Public API:
//   mr_make(r, c, data)            -> any    build matrix from flat float list
//   mr_get(m, i, j)                -> float  element access
//   mr_set(m, i, j, v)                       mutate element (i,j)
//   mr_zeros(r, c)                 -> any    r*c zero matrix
//   mr_row_echelon(m, tol)         -> any    reduced row echelon via Gaussian elim
//   mr_rank(m, tol)                -> int    number of non-zero rows after row reduction
//   mr_is_full_rank(m, tol)        -> bool   rank == min(r, c)
//   mr_nullity(m, tol)             -> int    cols - rank
//   mr_is_invertible(m, tol)       -> bool   square AND full rank
//   mr_pivot_columns(m, tol)       -> any    list of pivot column indices
//   mr_count_nonzero_rows(m, tol)  -> int    rows with at least one element > tol

// mr_make — build a matrix dict from r, c and a flat float list.
fn mr_make(r: int, c: int, data: list) -> any
    let m = {}
    m["r"] = r
    m["c"] = c
    m["d"] = data
    m

// mr_get — return element (i, j) as a float.
fn mr_get(m: any, i: int, j: int) -> float
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    let v = d[idx]
    v * 1.0

// mr_set — set element (i, j) to value v in place.
fn mr_set(m: any, i: int, j: int, v: float)
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    d[idx] = v

// mr_zeros — build an r*c zero matrix.
fn mr_zeros(r: int, c: int) -> any
    let d = []
    let total = r * c
    let k = 0
    while k < total
        push(d, 0.0)
        k = k + 1
    mr_make(r, c, d)

// _mr_fabs — absolute value of a float.
fn _mr_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// _mr_copy_flat — duplicate a flat float list.
fn _mr_copy_flat(d: list, n: int) -> list
    let out = []
    let i = 0
    while i < n
        let v = d[i] * 1.0
        push(out, v)
        i = i + 1
    out

// mr_row_echelon — return a row-echelon form of m via Gaussian elimination
// with partial pivoting. Rows with all-zero elements after reduction appear
// at the bottom. The input matrix is NOT mutated.
fn mr_row_echelon(m: any, tol: float) -> any
    let nr = m["r"]
    let nc = m["c"]
    let total = nr * nc
    let d_orig = m["d"]
    let d = _mr_copy_flat(d_orig, total)
    let wm = mr_make(nr, nc, d)
    // Gaussian elimination.
    let pivot_row = 0
    let col = 0
    while col < nc
        if pivot_row >= nr
            col = nc
        else
            // Find the row with the largest absolute value in this column
            // at or below pivot_row.
            let best_row = pivot_row
            let best_val = _mr_fabs(mr_get(wm, pivot_row, col))
            let r = pivot_row + 1
            while r < nr
                let v = _mr_fabs(mr_get(wm, r, col))
                if v > best_val
                    best_val = v
                    best_row = r
                r = r + 1
            if best_val < tol
                // Entire column below pivot_row is zero: skip this column.
                col = col + 1
            else
                // Swap best_row into pivot_row.
                if best_row != pivot_row
                    let k = 0
                    while k < nc
                        let tmp = mr_get(wm, pivot_row, k)
                        let bv = mr_get(wm, best_row, k)
                        mr_set(wm, pivot_row, k, bv)
                        mr_set(wm, best_row, k, tmp)
                        k = k + 1
                // Eliminate below pivot_row.
                let pv = mr_get(wm, pivot_row, col)
                let below = pivot_row + 1
                while below < nr
                    let factor = mr_get(wm, below, col) / pv
                    let k2 = col
                    while k2 < nc
                        let old_v = mr_get(wm, below, k2)
                        let sub_v = mr_get(wm, pivot_row, k2)
                        mr_set(wm, below, k2, old_v - factor * sub_v)
                        k2 = k2 + 1
                    below = below + 1
                pivot_row = pivot_row + 1
                col = col + 1
    wm

// mr_count_nonzero_rows — count rows where at least one element has |v| > tol.
fn mr_count_nonzero_rows(m: any, tol: float) -> int
    let nr = m["r"]
    let nc = m["c"]
    let count = 0
    let i = 0
    while i < nr
        let j = 0
        let row_nonzero = false
        while j < nc
            let v = mr_get(m, i, j)
            if _mr_fabs(v) > tol
                row_nonzero = true
            j = j + 1
        if row_nonzero
            count = count + 1
        i = i + 1
    count

// mr_rank — number of non-zero rows in the row echelon form (= rank of m).
fn mr_rank(m: any, tol: float) -> int
    let ref = mr_row_echelon(m, tol)
    let r = mr_count_nonzero_rows(ref, tol)
    r

// mr_is_full_rank — true if rank == min(rows, cols).
fn mr_is_full_rank(m: any, tol: float) -> bool
    let nr = m["r"]
    let nc = m["c"]
    let mn = nr
    if nc < mn
        mn = nc
    let rk = mr_rank(m, tol)
    rk == mn

// mr_nullity — dimension of null space = cols - rank.
fn mr_nullity(m: any, tol: float) -> int
    let nc = m["c"]
    let rk = mr_rank(m, tol)
    nc - rk

// mr_is_invertible — true if m is square and full rank.
fn mr_is_invertible(m: any, tol: float) -> bool
    let nr = m["r"]
    let nc = m["c"]
    if nr != nc
        return false
    mr_is_full_rank(m, tol)

// mr_pivot_columns — list of column indices where the pivot (leading nonzero)
// in each non-zero row of the row echelon form lives.
fn mr_pivot_columns(m: any, tol: float) -> any
    let ref = mr_row_echelon(m, tol)
    let nr = ref["r"]
    let nc = ref["c"]
    let pivots = []
    let i = 0
    while i < nr
        // Find the first column in row i with |v| > tol.
        let j = 0
        let found = false
        let pivot_col = -1
        while j < nc
            if not found
                let v = mr_get(ref, i, j)
                if _mr_fabs(v) > tol
                    pivot_col = j
                    found = true
            j = j + 1
        if found
            push(pivots, pivot_col)
        i = i + 1
    pivots
