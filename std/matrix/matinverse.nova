// std/matrix/matinverse.nova — Matrix inverse via Gauss-Jordan elimination.
// LEAF — imports NOTHING.
// Matrix representation: dict{r:int, c:int, d:list[float]} row-major flat.
// Public prefix: mi_
//
// API:
//   mi_inverse(m)              -> any   invert m via Gauss-Jordan on [A|I]; empty list if singular
//   mi_inverse_2x2(m)          -> any   direct formula inverse of 2×2 matrix; empty list if singular
//   mi_inverse_3x3(m)          -> any   inverse of 3×3 matrix via Gauss-Jordan; empty list if singular
//   mi_is_invertible(m, tol)   -> bool  true if m has a nonzero determinant
//   mi_verify(m, tol)          -> bool  true if A * inv(A) == I within tol
//   mi_solve_via_inverse(m, b) -> any   solve A x = b using the inverse; empty if singular

// --- Private matrix helpers (self-contained) ---

fn _mi_mat_make(r, c, data)
    let m = {}
    m["r"] = r
    m["c"] = c
    m["d"] = data
    m

// mi_make: public constructor — build a matrix dict from rows, cols, flat row-major data.
fn mi_make(r, c, data)
    return _mi_mat_make(r, c, data)

fn _mi_mat_get(m, i, j)
    let cols = m["c"]
    let d = m["d"]
    let idx = i * cols + j
    d[idx] * 1.0

fn _mi_mat_set(m, i, j, v)
    let cols = m["c"]
    let d = m["d"]
    let idx = i * cols + j
    d[idx] = v

fn _mi_mat_zeros(r, c)
    let data = []
    let total = r * c
    let k = 0
    while k < total
        push(data, 0.0)
        k = k + 1
    _mi_mat_make(r, c, data)

fn _mi_mat_identity(n)
    let m = _mi_mat_zeros(n, n)
    let i = 0
    while i < n
        _mi_mat_set(m, i, i, 1.0)
        i = i + 1
    m

fn _mi_mat_copy(m)
    let r = m["r"]
    let c = m["c"]
    let d = m["d"]
    let nd = []
    let k = 0
    let total = r * c
    while k < total
        push(nd, d[k] * 1.0)
        k = k + 1
    _mi_mat_make(r, c, nd)

fn _mi_pivot_row(m, col, from_row)
    let r = m["r"]
    let best = from_row
    let bv = _mi_mat_get(m, from_row, col)
    if bv < 0.0
        bv = 0.0 - bv
    let i = from_row + 1
    while i < r
        let v = _mi_mat_get(m, i, col)
        if v < 0.0
            v = 0.0 - v
        if v > bv
            bv = v
            best = i
        i = i + 1
    best

fn _mi_swap_rows(m, i, j)
    let mc = _mi_mat_copy(m)
    let c = mc["c"]
    let k = 0
    while k < c
        let vi = _mi_mat_get(mc, i, k)
        let vj = _mi_mat_get(mc, j, k)
        _mi_mat_set(mc, i, k, vj)
        _mi_mat_set(mc, j, k, vi)
        k = k + 1
    mc

fn _mi_scale_row(m, i, s)
    let mc = _mi_mat_copy(m)
    let c = mc["c"]
    let k = 0
    while k < c
        let v = _mi_mat_get(mc, i, k)
        _mi_mat_set(mc, i, k, v * s)
        k = k + 1
    mc

fn _mi_add_scaled_row(m, dst, src, factor)
    let mc = _mi_mat_copy(m)
    let c = mc["c"]
    let k = 0
    while k < c
        let vdst = _mi_mat_get(mc, dst, k)
        let vsrc = _mi_mat_get(mc, src, k)
        _mi_mat_set(mc, dst, k, vdst + factor * vsrc)
        k = k + 1
    mc

// _mi_mat_mul — multiply two n×n matrices A and B, return A*B.
fn _mi_mat_mul(a, b)
    let n = a["r"]
    let result = _mi_mat_zeros(n, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            let sum = 0.0
            let k = 0
            while k < n
                let aik = _mi_mat_get(a, i, k)
                let bkj = _mi_mat_get(b, k, j)
                sum = sum + aik * bkj
                k = k + 1
            _mi_mat_set(result, i, j, sum)
            j = j + 1
        i = i + 1
    result

// --- Public API ---

// mi_inverse — compute inverse of an n×n matrix using Gauss-Jordan on [A|I].
// Returns the inverse matrix dict, or an empty list if singular.
fn mi_inverse(m)
    let n = m["r"]
    let tol = 0.000001
    let aug_data = []
    let i = 0
    while i < n
        let j = 0
        while j < n
            push(aug_data, _mi_mat_get(m, i, j))
            j = j + 1
        let j2 = 0
        while j2 < n
            if j2 == i
                push(aug_data, 1.0)
            else
                push(aug_data, 0.0)
            j2 = j2 + 1
        i = i + 1
    let aug = _mi_mat_make(n, n + n, aug_data)
    let pivot_row = 0
    let col = 0
    while col < n
        if pivot_row >= n
            col = n
        else
            let pr = _mi_pivot_row(aug, col, pivot_row)
            let pv = _mi_mat_get(aug, pr, col)
            if pv < 0.0
                pv = 0.0 - pv
            if pv < tol
                return []
            if pr != pivot_row
                aug = _mi_swap_rows(aug, pivot_row, pr)
            let diag = _mi_mat_get(aug, pivot_row, col)
            aug = _mi_scale_row(aug, pivot_row, 1.0 / diag)
            let row = 0
            while row < n
                if row != pivot_row
                    let v = _mi_mat_get(aug, row, col)
                    let factor = 0.0 - v
                    aug = _mi_add_scaled_row(aug, row, pivot_row, factor)
                row = row + 1
            pivot_row = pivot_row + 1
            col = col + 1
    let inv_data = []
    let bi = 0
    while bi < n
        let j = 0
        while j < n
            push(inv_data, _mi_mat_get(aug, bi, n + j))
            j = j + 1
        bi = bi + 1
    _mi_mat_make(n, n, inv_data)

// mi_inverse_2x2 — direct formula for 2×2 inverse: 1/det * [[d,-b],[-c,a]].
// Returns inverse matrix dict, or empty list if singular.
fn mi_inverse_2x2(m)
    let a = _mi_mat_get(m, 0, 0)
    let b = _mi_mat_get(m, 0, 1)
    let c = _mi_mat_get(m, 1, 0)
    let d = _mi_mat_get(m, 1, 1)
    let det = a * d - b * c
    let det_abs = det
    if det_abs < 0.0
        det_abs = 0.0 - det_abs
    if det_abs < 0.000001
        return []
    let inv_det = 1.0 / det
    let inv_data = [d * inv_det, (0.0 - b) * inv_det, (0.0 - c) * inv_det, a * inv_det]
    _mi_mat_make(2, 2, inv_data)

// mi_inverse_3x3 — inverse of a 3×3 matrix via Gauss-Jordan (delegates to mi_inverse).
fn mi_inverse_3x3(m)
    mi_inverse(m)

// mi_is_invertible — true if the matrix is nonsingular (all pivots exceed tol).
fn mi_is_invertible(m, tol)
    let inv = mi_inverse(m)
    len(inv) > 0

// mi_verify — true if A * inv(A) == I within tol (round-trip identity check).
fn mi_verify(m, tol)
    let inv = mi_inverse(m)
    if len(inv) == 0
        return false
    let n = m["r"]
    let prod = _mi_mat_mul(m, inv)
    let i = 0
    while i < n
        let j = 0
        while j < n
            let v = _mi_mat_get(prod, i, j)
            let want = 0.0
            if i == j
                want = 1.0
            let diff = v - want
            if diff < 0.0
                diff = 0.0 - diff
            if diff > tol
                return false
            j = j + 1
        i = i + 1
    true

// mi_solve_via_inverse — solve A x = b using the precomputed inverse: x = A^-1 b.
// Returns solution vector or empty list if singular.
fn mi_solve_via_inverse(m, b)
    let inv = mi_inverse(m)
    if len(inv) == 0
        return []
    let n = m["r"]
    let x = []
    let i = 0
    while i < n
        let sum = 0.0
        let j = 0
        while j < n
            let inv_ij = _mi_mat_get(inv, i, j)
            let bj = b[j] * 1.0
            sum = sum + inv_ij * bj
            j = j + 1
        push(x, sum)
        i = i + 1
    x
