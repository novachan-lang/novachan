// std/matrix/matdet.nova — Determinant and related functions for square matrices.
//
// Matrix representation: a dict with keys 'r' (rows), 'c' (cols), 'd' (flat
// row-major list of floats, length r*c). Element (i,j) = d[i*c + j].
//
// All public functions are prefixed md_ to avoid global symbol collisions.
//
// Public API:
//   md_make(r, c, data)          -> any    build a matrix from a flat float list
//   md_get(m, i, j)              -> float  element access
//   md_set(m, i, j, v)                     mutate element (i,j)
//   md_zeros(r, c)               -> any    r*c zero matrix
//   md_identity(n)               -> any    n*n identity
//   md_det(m)                    -> float  determinant (LU with partial pivoting)
//   md_det_2x2(m)                -> float  direct 2x2 determinant formula
//   md_det_3x3(m)                -> float  direct 3x3 determinant formula
//   md_det_upper_triangular(m)   -> float  product of diagonal
//   md_minor(m, i, j)            -> float  det of submatrix deleting row i col j
//   md_cofactor(m, i, j)         -> float  (-1)^(i+j) * minor(m, i, j)
//   md_is_singular(m, tol)       -> bool   |det(m)| < tol
//   md_laplace(m)                -> float  cofactor expansion (recursive, small n)

// md_make — build a matrix dict from r, c and a flat float list.
fn md_make(r: int, c: int, data: list) -> any
    let m = {}
    m["r"] = r
    m["c"] = c
    m["d"] = data
    m

// md_get — return element (i, j) as a float.
fn md_get(m: any, i: int, j: int) -> float
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    let v = d[idx]
    v * 1.0

// md_set — set element (i, j) to value v in place.
fn md_set(m: any, i: int, j: int, v: float)
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    d[idx] = v

// md_zeros — build an r*c zero matrix.
fn md_zeros(r: int, c: int) -> any
    let total = r * c
    let d = [0.0 for k in 0..total]
    md_make(r, c, d)

// md_identity — build an n*n identity matrix.
fn md_identity(n: int) -> any
    let m = md_zeros(n, n)
    for i in 0..n
        md_set(m, i, i, 1.0)
    m

// _md_fabs — absolute value of a float.
fn _md_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// _md_copy_flat — duplicate a flat list of floats.
fn _md_copy_flat(d: list, n: int) -> list
    let out = []
    for i in 0..n
        let v = d[i] * 1.0
        push(out, v)
    out

// md_det_2x2 — direct formula for 2*2 determinant: ad - bc.
fn md_det_2x2(m: any) -> float
    let a = md_get(m, 0, 0)
    let b = md_get(m, 0, 1)
    let c = md_get(m, 1, 0)
    let d = md_get(m, 1, 1)
    let r = a * d - b * c
    r

// md_det_3x3 — direct formula for 3*3 determinant via cofactor expansion.
fn md_det_3x3(m: any) -> float
    let a00 = md_get(m, 0, 0)
    let a01 = md_get(m, 0, 1)
    let a02 = md_get(m, 0, 2)
    let a10 = md_get(m, 1, 0)
    let a11 = md_get(m, 1, 1)
    let a12 = md_get(m, 1, 2)
    let a20 = md_get(m, 2, 0)
    let a21 = md_get(m, 2, 1)
    let a22 = md_get(m, 2, 2)
    let t0 = a00 * (a11 * a22 - a12 * a21)
    let t1 = a01 * (a10 * a22 - a12 * a20)
    let t2 = a02 * (a10 * a21 - a11 * a20)
    let r = t0 - t1 + t2
    r

// md_det_upper_triangular — product of diagonal elements (valid for triangular m).
fn md_det_upper_triangular(m: any) -> float
    let n = m["r"]
    let prod = 1.0
    let i = 0
    while i < n
        let v = md_get(m, i, i)
        prod = prod * v
        i += 1
    prod

// _md_submatrix — build (n-1)*(n-1) submatrix deleting row ri and col ci.
fn _md_submatrix(m: any, ri: int, ci: int) -> any
    let n = m["r"]
    let nm1 = n - 1
    let sub = md_zeros(nm1, nm1)
    let si = 0
    for src_i in 0..n
        if src_i != ri
            let sj = 0
            let src_j = 0
            while src_j < n
                if src_j != ci
                    let v = md_get(m, src_i, src_j)
                    md_set(sub, si, sj, v)
                    sj += 1
                src_j += 1
            si += 1
    sub

// md_minor — determinant of submatrix deleting row i and column j.
fn md_minor(m: any, i: int, j: int) -> float
    let sub = _md_submatrix(m, i, j)
    let d = md_det(sub)
    d

// md_cofactor — (-1)^(i+j) * minor(m, i, j).
fn md_cofactor(m: any, i: int, j: int) -> float
    let mn = md_minor(m, i, j)
    let sign_neg = (i + j) - 2 * ((i + j) / 2)
    if sign_neg != 0
        return 0.0 - mn
    mn

// md_laplace — determinant via cofactor expansion along row 0 (recursive, good for small n).
fn md_laplace(m: any) -> float
    let n = m["r"]
    if n == 1
        return md_get(m, 0, 0)
    if n == 2
        return md_det_2x2(m)
    let sum = 0.0
    for j in 0..n
        let cof = md_cofactor(m, 0, j)
        let aij = md_get(m, 0, j)
        sum += aij * cof
    sum

// md_det — determinant using Gaussian elimination with partial pivoting (numerically stable).
// Falls through to direct formulas for n=1, n=2, n=3.
fn md_det(m: any) -> float
    let n = m["r"]
    if n == 1
        return md_get(m, 0, 0)
    if n == 2
        return md_det_2x2(m)
    if n == 3
        return md_det_3x3(m)
    // General case: LU decomposition with partial pivoting.
    // Work on a mutable copy of the flat data.
    let d_orig = m["d"]
    let total = n * n
    let d = _md_copy_flat(d_orig, total)
    let wm = md_make(n, n, d)
    // sign tracks row-swap parity: starts at 1.0, flips on each swap.
    let sign = 1.0
    for col in 0..n
        // Find pivot row: max |element| in column col, rows [col..n-1].
        let pivot_row = col
        let pivot_abs = _md_fabs(md_get(wm, col, col))
        let r = col + 1
        while r < n
            let v = _md_fabs(md_get(wm, r, col))
            if v > pivot_abs
                pivot_abs = v
                pivot_row = r
            r += 1
        // Swap rows col and pivot_row.
        if pivot_row != col
            sign = 0.0 - sign
            let k = 0
            while k < n
                let tmp = md_get(wm, col, k)
                let pv = md_get(wm, pivot_row, k)
                md_set(wm, col, k, pv)
                md_set(wm, pivot_row, k, tmp)
                k += 1
        // Check for singular column (pivot ~ 0).
        let pv = md_get(wm, col, col)
        if _md_fabs(pv) < 0.0000000001
            return 0.0
        // Eliminate below.
        let row = col + 1
        while row < n
            let factor = md_get(wm, row, col) / pv
            let k2 = col
            while k2 < n
                let old_val = md_get(wm, row, k2)
                let sub_val = md_get(wm, col, k2)
                let new_val = old_val - factor * sub_val
                md_set(wm, row, k2, new_val)
                k2 += 1
            row += 1
    // Product of diagonal * sign.
    let prod = sign
    for i in 0..n
        let vi = md_get(wm, i, i)
        prod = prod * vi
    prod

// md_is_singular — true if |det(m)| < tol.
fn md_is_singular(m: any, tol: float) -> bool
    let d = md_det(m)
    let ad = _md_fabs(d)
    ad < tol
