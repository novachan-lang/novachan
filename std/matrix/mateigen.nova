// std/matrix/mateigen.nova — eigenvalues via QR algorithm and power iteration.
// Representation: matrix = dict {r, c, d} where d is a flat row-major list of floats.
// Element (i,j) = d[i*c + j].  All helpers prefixed meig_ to avoid global collisions.
// LEAF — imports NOTHING.
//
// Public API:
//   meig_eigenvalues_symmetric(m, iters, tol) -> list  QR-iteration eigenvalues for symmetric m
//   meig_power(m, iters)                      -> dict  {value, vector} dominant eigenpair
//   meig_dominant_value(m, iters)             -> float dominant eigenvalue
//   meig_trace(m)                             -> float sum of diagonal (== sum of eigenvalues)
//   meig_det_from_eigs(eigs)                  -> float product of eigenvalues (== determinant)
//   meig_char_poly_2x2(m)                     -> list  [1, -trace, det]
//   meig_eig_2x2(m)                           -> list  [λ1, λ2] sorted descending
//   meig_is_symmetric(m, tol)                 -> bool  A == A^T within tol

// ── flat-matrix helpers ────────────────────────────────────────────────────────

// meig_make: build a matrix dict.
fn meig_make(r: int, c: int, data: list) -> dict
    let m = {}
    m["r"] = r
    m["c"] = c
    m["d"] = data
    m

// meig_get: read element (i,j).
fn meig_get(m: dict, i: int, j: int) -> float
    let cols = m["c"]
    let d = m["d"]
    let idx = i * cols + j
    d[idx] * 1.0

// meig_set: write element (i,j) = v.
fn meig_set(m: dict, i: int, j: int, v: float)
    let cols = m["c"]
    let d = m["d"]
    let idx = i * cols + j
    d[idx] = v

// meig_zeros: make an r x c zero matrix.
fn meig_zeros(r: int, c: int) -> dict
    let total = r * c
    let data = [0.0 for _ in 0..total]
    meig_make(r, c, data)

// meig_identity: make an n x n identity matrix.
fn meig_identity(n: int) -> dict
    let m = meig_zeros(n, n)
    for i in 0..n
        meig_set(m, i, i, 1.0)
    m

// meig_copy: deep copy a matrix.
fn meig_copy(m: dict) -> dict
    let r = m["r"]
    let c = m["c"]
    let d = m["d"]
    let total = r * c
    let data = [d[k] * 1.0 for k in 0..total]
    meig_make(r, c, data)

// meig_matmul: multiply (r1 x k) * (k x c2).
// Inner accumulation kept as an explicit index loop (hot path: called once per QR
// iteration) — no reordering of the floating-point sum, no extra allocation per cell.
fn meig_matmul(a: dict, b: dict) -> dict
    let r1 = a["r"]
    let k = a["c"]
    let c2 = b["c"]
    let out = meig_zeros(r1, c2)
    for i in 0..r1
        for j in 0..c2
            let s = 0.0
            for p in 0..k
                let av = meig_get(a, i, p)
                let bv = meig_get(b, p, j)
                s += av * bv
            meig_set(out, i, j, s)
    out

// meig_transpose: transpose a flat matrix.
fn meig_transpose(m: dict) -> dict
    let r = m["r"]
    let c = m["c"]
    let out = meig_zeros(c, r)
    for i in 0..r
        for j in 0..c
            let v = meig_get(m, i, j)
            meig_set(out, j, i, v)
    out

// ── QR step for meig (Householder reflections for diagonal extraction) ──────────

// Internal: dot product of a column vector (list). Kept as an explicit index loop —
// this is the innermost hot path (called from _meig_norm inside every QR iteration);
// the summation order must not change and no extra list should be allocated per call.
fn _meig_dot(a: list, b: list) -> float
    let n = len(a)
    let s = 0.0
    for i in 0..n
        let ai = a[i] * 1.0
        let bi = b[i] * 1.0
        s += ai * bi
    s

// Internal: norm of a list.
fn _meig_norm(v: list) -> float
    let d = _meig_dot(v, v)
    let r = sqrt(d)
    r

// Internal: scale a list.
fn _meig_scale(v: list, k: float) -> list
    let n = len(v)
    [v[i] * 1.0 * k for i in 0..n]

// Internal: subtract two lists.
fn _meig_vsub(a: list, b: list) -> list
    let n = len(a)
    [a[i] * 1.0 - b[i] * 1.0 for i in 0..n]

// Internal: extract column j of matrix m as a list.
fn _meig_get_col(m: dict, j: int) -> list
    let r = m["r"]
    [meig_get(m, i, j) for i in 0..r]

// Internal: one QR step using modified Gram-Schmidt (returns Q, R pair as dict).
fn _meig_qr_step(m: dict) -> dict
    let rows = m["r"]
    let cols = m["c"]
    let vecs = [_meig_get_col(m, j) for j in 0..cols]
    let Q = meig_zeros(rows, cols)
    let R = meig_zeros(cols, cols)
    for k in 0..cols
        let vk = vecs[k]
        let nk = _meig_norm(vk)
        meig_set(R, k, k, nk)
        let qk = []
        if nk < 0.0000001
            qk = [0.0 for _ in 0..rows]
        else
            let inv_nk = 1.0 / nk
            qk = _meig_scale(vk, inv_nk)
        for qi2 in 0..rows
            let val = qk[qi2] * 1.0
            meig_set(Q, qi2, k, val)
        for j2 in (k + 1)..cols
            let vj = vecs[j2]
            let proj = _meig_dot(qk, vj)
            meig_set(R, k, j2, proj)
            let scaled = _meig_scale(qk, proj)
            let new_vj = _meig_vsub(vj, scaled)
            vecs[j2] = new_vj
    let res = {}
    res["Q"] = Q
    res["R"] = R
    res

// ── Public functions ──────────────────────────────────────────────────────────

// meig_trace: sum of diagonal elements (equals sum of eigenvalues).
// NOTE: not delegated to sum() — sum([]) on an empty list returns int 0, not
// float 0.0, which breaks this function's -> float contract for a 0x0 matrix.
// Kept as a plain index loop so the accumulator is always a float.
fn meig_trace(m: dict) -> float
    let n = m["r"]
    let s = 0.0
    for i in 0..n
        s += meig_get(m, i, i)
    s

// meig_is_symmetric: check if A == A^T within tol.
fn meig_is_symmetric(m: dict, tol: float) -> bool
    let n = m["r"]
    let c = m["c"]
    if n != c
        return false
    let ok = true
    for i in 0..n
        for j in 0..n
            let aij = meig_get(m, i, j)
            let aji = meig_get(m, j, i)
            let diff = abs(aij - aji)
            if diff > tol
                ok = false
    ok

// meig_char_poly_2x2: characteristic polynomial coefficients [1, -trace, det] for a 2x2.
fn meig_char_poly_2x2(m: dict) -> list
    let a = meig_get(m, 0, 0)
    let b = meig_get(m, 0, 1)
    let c = meig_get(m, 1, 0)
    let d = meig_get(m, 1, 1)
    let tr = a + d
    let det = a * d - b * c
    let result = []
    push(result, 1.0)
    push(result, 0.0 - tr)
    push(result, det)
    result

// meig_eig_2x2: closed-form eigenvalues of a 2x2 matrix, sorted descending.
// λ = (trace ± sqrt(trace^2 - 4*det)) / 2
fn meig_eig_2x2(m: dict) -> list
    let a = meig_get(m, 0, 0)
    let b = meig_get(m, 0, 1)
    let c = meig_get(m, 1, 0)
    let d = meig_get(m, 1, 1)
    let tr = a + d
    let det = a * d - b * c
    let disc = tr * tr - 4.0 * det
    let sq = 0.0
    if disc > 0.0
        sq = sqrt(disc)
    else
        if disc < 0.0 - 0.0000001
            // Complex eigenvalues — return real parts only.
            sq = 0.0
        else
            sq = 0.0
    let lam1 = (tr + sq) / 2.0
    let lam2 = (tr - sq) / 2.0
    // Sort descending: lam1 >= lam2.
    let result = []
    if lam1 >= lam2
        push(result, lam1)
        push(result, lam2)
    else
        push(result, lam2)
        push(result, lam1)
    result

// meig_det_from_eigs: product of eigenvalues (equals determinant).
// NOTE: not delegated to reduce() — reduce's closure argument hits a known
// compiler gap where raw floats get corrupted crossing the any-boxed HOF
// boundary (see project memory: dogfood float-widen-boxing). Kept as a plain
// index loop; product order preserved exactly.
fn meig_det_from_eigs(eigs: list) -> float
    let n = len(eigs)
    let prod = 1.0
    for i in 0..n
        let v = eigs[i] * 1.0
        prod = prod * v
    prod

// meig_eigenvalues_symmetric: eigenvalues of a symmetric matrix via QR iteration.
// Iterates: A_{k+1} = R_k * Q_k (from A_k = Q_k * R_k).
// Diagonal of the converged matrix contains eigenvalues, sorted descending.
// Cap iterations at iters (200 recommended), convergence tol.
fn meig_eigenvalues_symmetric(m: dict, iters: int, tol: float) -> list
    let n = m["r"]
    let A = meig_copy(m)
    let iter = 0
    while iter < iters
        // Check for convergence: off-diagonal elements near zero.
        // Kept as an explicit index loop (hot path, up to `iters` passes) — no
        // reordering of the summation, no per-iteration O(n^2) list allocation.
        let off = 0.0
        for i in 0..n
            for j in 0..n
                if i != j
                    off += abs(meig_get(A, i, j))
        if off < tol
            iter = iters
        else
            // One QR step: A = R * Q.
            let qr = _meig_qr_step(A)
            let Q = qr["Q"]
            let R = qr["R"]
            A = meig_matmul(R, Q)
            iter += 1
    // Extract diagonal.
    let eigs = [meig_get(A, k, k) for k in 0..n]
    // Sort eigenvalues descending (stable ascending sort + reverse — same values,
    // same set of results as the original hand-rolled insertion sort).
    eigs.sort_by(fn(x) x).reverse()

// meig_power: dominant eigenpair via power iteration.
// Returns dict {value, vector}.
fn meig_power(m: dict, iters: int) -> dict
    let n = m["r"]
    // Start with [1, 1, ..., 1] normalized.
    let v = [1.0 for _ in 0..n]
    // Normalize initial vector.
    let nrm = _meig_norm(v)
    if nrm > 0.0000001
        let inv = 1.0 / nrm
        v = _meig_scale(v, inv)
    let lam = 0.0
    let it = 0
    while it < iters
        // Compute w = A * v. Kept as explicit index loops (hot path, up to `iters`
        // passes) — no reordering of the summation, no extra per-row allocation.
        let w = []
        for i2 in 0..n
            let s = 0.0
            for j in 0..n
                let av = meig_get(m, i2, j)
                let vv = v[j] * 1.0
                s += av * vv
            push(w, s)
        // Rayleigh quotient: lam = v^T * w.
        lam = _meig_dot(v, w)
        // Normalize w.
        let wn = _meig_norm(w)
        if wn < 0.0000001
            it = iters
        else
            let inv2 = 1.0 / wn
            v = _meig_scale(w, inv2)
            it += 1
    let result = {}
    result["value"] = lam
    result["vector"] = v
    result

// meig_dominant_value: just the dominant eigenvalue.
fn meig_dominant_value(m: dict, iters: int) -> float
    let pair = meig_power(m, iters)
    let v = pair["value"] * 1.0
    v
