// std/matrix/matadjugate.nova — Adjugate (classical adjoint) and cofactor matrix.
//
// Matrix representation: a dict with keys 'r' (rows), 'c' (cols), 'd' (flat
// row-major list of floats, length r*c). Element (i,j) = d[i*c + j].
//
// All public functions are prefixed madj_ to avoid global symbol collisions.
// SELF-CONTAINED: imports nothing; defines its own mat helpers (prefixed madj_).
//
// Public API:
//   madj_make(r, c, data)          -> any    build matrix from flat float list
//   madj_get(m, i, j)              -> float  element access
//   madj_set(m, i, j, v)                     mutate element (i,j)
//   madj_zeros(r, c)               -> any    r*c zero matrix
//   madj_identity(n)               -> any    n*n identity
//   madj_minor(m, i, j)            -> float  det of submatrix deleting row i col j
//   madj_cofactor(m, i, j)         -> float  (-1)^(i+j) * minor(m, i, j)
//   madj_det(m)                    -> float  determinant via cofactor expansion
//   madj_cofactor_matrix(m)        -> any    matrix of all cofactors C[i][j]
//   madj_adjugate(m)               -> any    transpose of cofactor matrix
//   madj_inverse_via_adj(m)        -> any    inv = adj(m)/det(m) for non-singular m
//   madj_verify(m, tol)            -> bool   A*adj(A) == det(A)*I (round-trip check)

// madj_make — build a matrix dict from r, c and a flat float list.
fn madj_make(r: int, c: int, data: list) -> any
    let m = {}
    m["r"] = r
    m["c"] = c
    m["d"] = data
    m

// madj_get — return element (i, j) as a float.
fn madj_get(m: any, i: int, j: int) -> float
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    let v = d[idx]
    v * 1.0

// madj_set — set element (i, j) to value v in place.
fn madj_set(m: any, i: int, j: int, v: float)
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    d[idx] = v

// madj_zeros — build an r*c zero matrix.
fn madj_zeros(r: int, c: int) -> any
    let d = []
    let total = r * c
    let k = 0
    while k < total
        push(d, 0.0)
        k = k + 1
    madj_make(r, c, d)

// madj_identity — build an n*n identity matrix.
fn madj_identity(n: int) -> any
    let m = madj_zeros(n, n)
    let i = 0
    while i < n
        madj_set(m, i, i, 1.0)
        i = i + 1
    m

// _madj_fabs — absolute value for floats.
fn _madj_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// _madj_copy_flat — duplicate a flat list of floats.
fn _madj_copy_flat(d: list, n: int) -> list
    let out = []
    let i = 0
    while i < n
        let v = d[i] * 1.0
        push(out, v)
        i = i + 1
    out

// _madj_submatrix — (n-1)*(n-1) submatrix deleting row ri and col ci.
fn _madj_submatrix(m: any, ri: int, ci: int) -> any
    let n = m["r"]
    let nm1 = n - 1
    let sub = madj_zeros(nm1, nm1)
    let si = 0
    let src_i = 0
    while src_i < n
        if src_i != ri
            let sj = 0
            let src_j = 0
            while src_j < n
                if src_j != ci
                    let v = madj_get(m, src_i, src_j)
                    madj_set(sub, si, sj, v)
                    sj = sj + 1
                src_j = src_j + 1
            si = si + 1
        src_i = src_i + 1
    sub

// _madj_det2 — direct 2x2 determinant.
fn _madj_det2(m: any) -> float
    let a = madj_get(m, 0, 0)
    let b = madj_get(m, 0, 1)
    let c = madj_get(m, 1, 0)
    let e = madj_get(m, 1, 1)
    let r = a * e - b * c
    r

// madj_det — determinant via cofactor expansion (recursive). Works for any n.
fn madj_det(m: any) -> float
    let n = m["r"]
    if n == 1
        return madj_get(m, 0, 0)
    if n == 2
        return _madj_det2(m)
    // General: expand along row 0.
    let sum = 0.0
    let j = 0
    while j < n
        let sub = _madj_submatrix(m, 0, j)
        let sub_det = madj_det(sub)
        let aij = madj_get(m, 0, j)
        let sign_neg = j - 2 * (j / 2)
        if sign_neg != 0
            sum = sum - aij * sub_det
        else
            sum = sum + aij * sub_det
        j = j + 1
    sum

// madj_minor — determinant of submatrix deleting row i and column j.
fn madj_minor(m: any, i: int, j: int) -> float
    let sub = _madj_submatrix(m, i, j)
    let d = madj_det(sub)
    d

// madj_cofactor — (-1)^(i+j) * minor(m, i, j).
fn madj_cofactor(m: any, i: int, j: int) -> float
    let mn = madj_minor(m, i, j)
    let sign_neg = (i + j) - 2 * ((i + j) / 2)
    if sign_neg != 0
        return 0.0 - mn
    mn

// madj_cofactor_matrix — n*n matrix where C[i][j] = cofactor(m, i, j).
fn madj_cofactor_matrix(m: any) -> any
    let n = m["r"]
    let result = madj_zeros(n, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            let cof = madj_cofactor(m, i, j)
            madj_set(result, i, j, cof)
            j = j + 1
        i = i + 1
    result

// madj_adjugate — transpose of the cofactor matrix.
// adj(A)[i][j] = cofactor(A, j, i)
fn madj_adjugate(m: any) -> any
    let n = m["r"]
    let result = madj_zeros(n, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            // adj[i][j] = cofactor(m, j, i)
            let cof = madj_cofactor(m, j, i)
            madj_set(result, i, j, cof)
            j = j + 1
        i = i + 1
    result

// _madj_matmul — matrix multiply a (n*n) * b (n*n) -> c (n*n).
fn _madj_matmul(a: any, b: any) -> any
    let n = a["r"]
    let result = madj_zeros(n, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            let s = 0.0
            let k = 0
            while k < n
                let av = madj_get(a, i, k)
                let bv = madj_get(b, k, j)
                s = s + av * bv
                k = k + 1
            madj_set(result, i, j, s)
            j = j + 1
        i = i + 1
    result

// madj_inverse_via_adj — compute inv(A) = adj(A) / det(A).
// Returns the zero matrix if A is singular (|det| < 1e-12).
fn madj_inverse_via_adj(m: any) -> any
    let n = m["r"]
    let det = madj_det(m)
    let adet = _madj_fabs(det)
    if adet < 0.000000000001
        return madj_zeros(n, n)
    let adj = madj_adjugate(m)
    let inv_det = 1.0 / det
    let result = madj_zeros(n, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            let av = madj_get(adj, i, j)
            madj_set(result, i, j, av * inv_det)
            j = j + 1
        i = i + 1
    result

// madj_verify — check that A * adj(A) == det(A) * I (all elements within tol).
fn madj_verify(m: any, tol: float) -> bool
    let n = m["r"]
    let det = madj_det(m)
    let adj = madj_adjugate(m)
    let prod = _madj_matmul(m, adj)
    // Expected: det * Identity
    let ok = true
    let i = 0
    while i < n
        let j = 0
        while j < n
            let got = madj_get(prod, i, j)
            let want = 0.0
            if i == j
                want = det
            let diff = got - want
            if diff < 0.0
                diff = 0.0 - diff
            if diff > tol
                ok = false
            j = j + 1
        i = i + 1
    ok
