// std/collections/xor_linked_list.nova — XOR linked list: the classic
// memory-frugal doubly-linked list technique where each node stores a
// SINGLE combined link field (prev XOR next) instead of two separate
// prev/next pointers, halving the per-node link overhead of a normal
// doubly-linked list (see std/collections/linkedlist.nova, which stores
// prev and next as two separate fields — this module is the XOR-combined
// variant of the same idea).
//
// NOVA does not expose raw memory addresses to user code (that would
// violate process/value memory safety), so this module simulates the
// technique with ARRAY-OFFSET "pseudo-pointers": each node lives at a
// fixed index in a backing array, and its link field is the XOR of
// (index+1) of its predecessor and (index+1) of its successor (using +1
// so that 0 is free to mean "no neighbor" — index 0 is a valid node, so
// the raw 0-based index cannot double as the null sentinel). This
// preserves the actual point of the data structure — ONE integer field per
// node, and O(1) traversal-direction-aware neighbor recovery via XOR —
// while staying fully bounds-checked and memory-safe.
// LEAF — imports NOTHING.
//
// The list itself is a dict: {"vals": list, "links": list, "head": int,
// "tail": int, "n": int}, where head/tail are 1-based node offsets (0 means
// empty list) and links[i] = xor(prev_offset_of_node_i, next_offset_of_node_i).
//
// PUBLIC API:
//   xll_new()                -> xor-linked-list dict (empty)
//   xll_push_back(xl, v)     -> unit   append v as the new tail
//   xll_push_front(xl, v)    -> unit   prepend v as the new head
//   xll_to_list_forward(xl)  -> list   values head -> tail
//   xll_to_list_backward(xl) -> list   values tail -> head
//   xll_size(xl)             -> int    number of nodes
//   xll_is_empty(xl)         -> bool
//   xll_get_link(xl, i)      -> int    raw link field of node i (0-based), for inspection
//
// TRAVERSAL ALGORITHM (forward): keep prev_off (the offset we just came
// from; 0 for "before the head") and cur_off (the node offset we're at).
// At each node, next_off = links[cur_off-1] XOR prev_off (because
// links[cur_off-1] == prev_off XOR next_off, and XOR is its own inverse).
// Then prev_off, cur_off = cur_off, next_off. Backward traversal is the
// exact mirror, starting from the tail with next_off = 0.
//
// KNOWN ANSWERS (hand-traced against this exact algorithm — see inline
// derivation in the module's design notes):
//   after push_back(10), push_back(20), push_back(30):
//     links = [2, 2, 2]   (0-based per node)
//     xll_to_list_forward  = [10, 20, 30]
//     xll_to_list_backward = [30, 20, 10]
//   after additionally push_front(5):
//     links = [6, 2, 2, 1]
//     xll_to_list_forward  = [5, 10, 20, 30]
//   xll_size(...)  after the 4 pushes above == 4
//   xll_is_empty(xll_new()) == true

// xll_new — an empty XOR linked list.
fn xll_new()
    return {"vals": [], "links": [], "head": 0, "tail": 0, "n": 0}

// xll_push_back — append v as the new tail node.
fn xll_push_back(xl, v)
    let vals = xl["vals"]
    let links = xl["links"]
    push(vals, v)
    push(links, 0)
    let new_idx = len(vals) - 1
    let new_off = new_idx + 1
    let old_tail = xl["tail"]
    if old_tail == 0
        xl["head"] = new_off
        xl["tail"] = new_off
    else
        let old_idx = old_tail - 1
        links[old_idx] = links[old_idx] ^ new_off
        links[new_idx] = old_tail
        xl["tail"] = new_off
    xl["n"] = xl["n"] + 1

// xll_push_front — prepend v as the new head node.
fn xll_push_front(xl, v)
    let vals = xl["vals"]
    let links = xl["links"]
    push(vals, v)
    push(links, 0)
    let new_idx = len(vals) - 1
    let new_off = new_idx + 1
    let old_head = xl["head"]
    if old_head == 0
        xl["head"] = new_off
        xl["tail"] = new_off
    else
        let old_idx = old_head - 1
        links[old_idx] = links[old_idx] ^ new_off
        links[new_idx] = old_head
        xl["head"] = new_off
    xl["n"] = xl["n"] + 1

// xll_to_list_forward — values from head to tail.
fn xll_to_list_forward(xl)
    let vals = xl["vals"]
    let links = xl["links"]
    let out = []
    let prev_off = 0
    let cur_off = xl["head"]
    while cur_off != 0
        let cur_idx = cur_off - 1
        push(out, vals[cur_idx])
        let link = links[cur_idx]
        let next_off = link ^ prev_off
        prev_off = cur_off
        cur_off = next_off
    return out

// xll_to_list_backward — values from tail to head.
fn xll_to_list_backward(xl)
    let vals = xl["vals"]
    let links = xl["links"]
    let out = []
    let next_off = 0
    let cur_off = xl["tail"]
    while cur_off != 0
        let cur_idx = cur_off - 1
        push(out, vals[cur_idx])
        let link = links[cur_idx]
        let prev_off = link ^ next_off
        next_off = cur_off
        cur_off = prev_off
    return out

// xll_size — number of nodes.
fn xll_size(xl)
    return xl["n"]

// xll_is_empty — true iff the list has no nodes.
fn xll_is_empty(xl)
    return xl["n"] == 0

// xll_get_link — raw link field of node i (0-based backing-array index).
fn xll_get_link(xl, i)
    let links = xl["links"]
    return links[i]
