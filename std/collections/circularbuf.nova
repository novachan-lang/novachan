// circularbuf — fixed-capacity circular (ring) buffer of ints.
//
// Backed by a pre-sized list of `cap` slots addressed via head/count index
// arithmetic (mod cap) so push/pop/peek are all O(1) with no shifting.
//
// Representation (dict b):
//   "buf"   -> list of int, length == cap (pre-filled with 0 placeholders)
//   "cap"   -> int capacity (>= 1)
//   "head"  -> int index of the oldest element (valid only when count > 0)
//   "count" -> int number of currently valid elements, 0 <= count <= cap
//
// Public API:
//   cb_new(capacity) -> dict
//   cb_push(b, val)  -> dict (append; overwrites the oldest element when full; returns b)
//   cb_pop(b)        -> list ([value, b] removing the oldest; [-1, b] if empty)
//   cb_peek(b)       -> int  (oldest value without removing; -1 if empty)
//   cb_size(b)       -> int
//   cb_is_full(b)    -> int  (1 if count == cap, else 0)
//   cb_to_list(b)    -> list (all elements, oldest-first)

// cb_new: create a new empty circular buffer with room for `capacity` ints.
// Capacity is clamped to at least 1 (a 0-capacity ring buffer has no valid
// slot arithmetic — mod-by-zero would be undefined).
fn cb_new(capacity)
    let cap = capacity
    if cap < 1
        cap = 1
    let buf = []
    for i in 0..cap
        buf.push(0)
    let b = {}
    b["buf"] = buf
    b["cap"] = cap
    b["head"] = 0
    b["count"] = 0
    return b

// cb_push: append val. When the buffer is full this overwrites the oldest
// element (and advances head), matching standard ring-buffer semantics.
fn cb_push(b, val)
    let cap = b["cap"]
    let buf = b["buf"]
    let head = b["head"]
    let count = b["count"]
    if count < cap
        let tail = (head + count) % cap
        buf[tail] = val
        b["count"] = count + 1
    else
        buf[head] = val
        b["head"] = (head + 1) % cap
    return b

// cb_pop: remove and return the oldest element as [value, b]. Returns [-1, b]
// if the buffer is empty (no value can be a valid sentinel-free -1 mix-up
// concern here since this buffer only stores caller-supplied ints — callers
// that need -1 as a real value should check cb_size first).
fn cb_pop(b)
    let count = b["count"]
    let r = []
    if count == 0
        r.push(-1)
        r.push(b)
        return r
    let head = b["head"]
    let buf = b["buf"]
    let v = buf[head]
    b["head"] = (head + 1) % b["cap"]
    b["count"] = count - 1
    r.push(v)
    r.push(b)
    return r

// cb_peek: return the oldest value without removing it. -1 if empty.
fn cb_peek(b)
    if b["count"] == 0
        return -1
    return b["buf"][b["head"]]

// cb_size: number of currently valid elements.
fn cb_size(b)
    return b["count"]

// cb_is_full: 1 if the buffer is at capacity, 0 otherwise.
fn cb_is_full(b)
    if b["count"] == b["cap"]
        return 1
    return 0

// cb_to_list: return all elements oldest-first, as a fresh list.
fn cb_to_list(b)
    let out = []
    let cap = b["cap"]
    let buf = b["buf"]
    let head = b["head"]
    let count = b["count"]
    for i in 0..count
        let idx = (head + i) % cap
        out.push(buf[idx])
    return out
