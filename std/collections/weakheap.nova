// weakheap — array-backed weak-heap (min-heap with reverse bits).
//
// A weak heap is an array-based heap that uses one extra "reverse bit" per
// element to track child orientation.  Building uses ~n-1 comparisons
// (versus 2*n for a standard binary heap).
//
// Representation (dict for reference semantics):
//   "items" -> list   items[0] is always the minimum
//   "rbits" -> list   rbits[i] in {0,1}; initially all 0
//
// Weak-heap property: for every i > 0, items[i] >= items[da(i)]
//   where da(i) (distinguished ancestor) is found by:
//   j = i; while j>0 and (j%2)==rbits[j/2]: j=j/2; return j/2
//
// Tree navigation:
//   Left child of j:  lc(j) = 2*j + rbits[j]
//   Right child of j: rc(j) = 2*j + 1 - rbits[j]
//
// Public API:
//   wh_new()          -> h            (empty weak heap)
//   wh_push(h, v)     -> (mutates h)  (insert v; O(log n))
//   wh_pop(h)         -> int|null     (remove+return minimum; null if empty)
//   wh_peek(h)        -> int|null     (return minimum without removing; null if empty)
//   wh_from(lst)      -> h            (build from list; O(n))
//   wh_sort(lst)      -> list         (ascending sort; non-destructive; O(n log n))

// _wh_da: return the distinguished ancestor index of i.
fn _wh_da(rbits, i)
    let j = i
    while j > 0 and (j % 2) == rbits[j / 2]
        j = j / 2
    return j / 2

// _wh_join: enforce the weak-heap property between ancestor a and descendant d.
// If items[d] < items[a], swap values and flip rbits[d].
fn _wh_join(items, rbits, a, d)
    if items[d] < items[a]
        let tmp = items[a]
        items[a] = items[d]
        items[d] = tmp
        if rbits[d] == 0
            rbits[d] = 1
        else
            rbits[d] = 0

// _wh_sift_up: after appending at position i, restore weak-heap property
// by joining with distinguished ancestors until root is reached.
fn _wh_sift_up(items, rbits, i)
    let j = i
    while j > 0
        let a = _wh_da(rbits, j)
        _wh_join(items, rbits, a, j)
        j = a

// _wh_sift_down: after placing a new element at root (position 0), restore
// the weak-heap property.
//
// The nodes whose distinguished ancestor is 0 are exactly those reachable
// by: starting at the right child of 0 (rc(0)=2*0+1-rbits[0]), then
// descending along left children (lc(j)=2*j+rbits[j]) until out of bounds.
//
// Collect this left-spine-of-right-child into a list, then join from
// deepest to shallowest (i.e. process the list in reverse).
fn _wh_sift_down(items, rbits, n)
    if n <= 1
        return null
    let spine = []
    let j = 2 * 0 + 1 - rbits[0]
    while j < n
        spine.push(j)
        j = 2 * j + rbits[j]
    let sz = len(spine)
    let k = sz - 1
    while k >= 0
        _wh_join(items, rbits, 0, spine[k])
        k = k - 1

// wh_new: create and return an empty weak heap.
fn wh_new()
    let h = {}
    h["items"] = []
    h["rbits"] = []
    return h

// wh_push: insert value v into the heap. O(log n).
fn wh_push(h, v)
    let items = h["items"]
    let rbits = h["rbits"]
    items.push(v)
    rbits.push(0)
    let i = len(items) - 1
    if i > 0
        _wh_sift_up(items, rbits, i)

// wh_pop: remove and return the minimum element.
// Returns null if the heap is empty.
fn wh_pop(h)
    let items = h["items"]
    let rbits = h["rbits"]
    let n = len(items)
    if n == 0
        return null
    let min_val = items[0]
    if n == 1
        items.pop()
        rbits.pop()
        return min_val
    // Move last element to root without resetting rbits[0].
    let last = items.pop()
    rbits.pop()
    items[0] = last
    _wh_sift_down(items, rbits, len(items))
    return min_val

// wh_peek: return the minimum element without removing it.
// Returns null if the heap is empty.
fn wh_peek(h)
    let items = h["items"]
    if len(items) == 0
        return null
    return items[0]

// _wh_copy_list: copy a list into a fresh list.
fn _wh_copy_list(lst)
    let n = len(lst)
    let out = []
    for i in 0..n
        out.push(lst[i])
    return out

// _wh_zero_list: build a list of n zeros.
fn _wh_zero_list(n)
    let out = []
    for i in 0..n
        out.push(0)
    return out

// _wh_build: build a weak heap in-place on items/rbits via n-1 join passes.
// Process from right to left: each element joins its distinguished ancestor.
fn _wh_build(items, rbits, n)
    let i = n - 1
    while i >= 1
        let a = _wh_da(rbits, i)
        _wh_join(items, rbits, a, i)
        i = i - 1

// wh_from: build a min weak-heap from an arbitrary list. O(n).
// lst is not modified; a fresh heap dict is returned.
fn wh_from(lst)
    let n = len(lst)
    let items = _wh_copy_list(lst)
    let rbits = _wh_zero_list(n)
    if n > 1
        _wh_build(items, rbits, n)
    let h = {}
    h["items"] = items
    h["rbits"] = rbits
    return h

// wh_sort: return a new list with elements of lst sorted ascending.
// Non-destructive on lst. Uses weak-heapsort: build + n pops.
fn wh_sort(lst)
    let n = len(lst)
    if n == 0
        return []
    let h = wh_from(lst)
    let out = []
    for i in 0..n
        let v = wh_pop(h)
        out.push(v)
    return out
