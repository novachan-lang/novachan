// ============================================================================
// NOVA Standard Library — std/collections/rope
// ============================================================================
// Rope: balanced binary tree of string chunks for O(log n) concat + index.
//
// Node layouts (both are dicts):
//   Leaf:  {"leaf": 1, "s": string}
//   Node:  {"leaf": 0, "l": rope, "r": rope, "w": int}
//          where "w" = total character length of the LEFT subtree.
//
// PUBLIC API
//   rp_from_str(s)         -> rope  (leaf from a string)
//   rp_concat(a, b)        -> rope  (internal node joining two ropes)
//   rp_length(r)           -> int   (total character count)
//   rp_char_at(r, i)       -> string (single character at 0-based index i)
//   rp_to_str(r)           -> string (flatten to a plain string)
//   rp_substring(r, lo, hi)-> string (chars [lo, hi), end-EXCLUSIVE)
//   rp_index_of(r, ch)     -> int   (first index of single-char string ch, or -1)
// ============================================================================

// rp_from_str: create a leaf rope from string s.
fn rp_from_str(s)
    let node = {}
    node["leaf"] = 1
    node["s"] = s
    return node

// rp_concat: join two ropes into an internal node.
// The weight "w" stores the length of the entire left subtree.
fn rp_concat(a, b)
    let node = {}
    node["leaf"] = 0
    node["l"] = a
    node["r"] = b
    node["w"] = rp_length(a)
    return node

// rp_length: total number of characters in the rope.
fn rp_length(r)
    if r["leaf"] == 1
        return len(r["s"])
    return r["w"] + rp_length(r["r"])

// rp_char_at: return the single character at 0-based position i as a string.
// Navigates the tree using the weight field to route left/right.
fn rp_char_at(r, i)
    if r["leaf"] == 1
        return char_at(r["s"], i)
    let w = r["w"]
    if i < w
        return rp_char_at(r["l"], i)
    return rp_char_at(r["r"], i - w)

// _rp_collect: internal helper — appends all characters of rope r to list acc.
fn _rp_collect(r, acc)
    if r["leaf"] == 1
        let s = r["s"]
        let n = len(s)
        for i in 0..n
            acc.push(char_at(s, i))
    else
        _rp_collect(r["l"], acc)
        _rp_collect(r["r"], acc)

// rp_to_str: flatten the entire rope into a single string.
fn rp_to_str(r)
    let acc = []
    _rp_collect(r, acc)
    return join(acc, "")

// rp_substring: return the substring r[lo..hi) (end-EXCLUSIVE).
// Clips lo/hi to valid range, returns "" for empty intervals.
fn rp_substring(r, lo, hi)
    let total = rp_length(r)
    if lo < 0
        lo = 0
    if hi > total
        hi = total
    if lo >= hi
        return ""
    // Collect only the chars in [lo, hi).
    let acc = []
    _rp_substr_collect(r, lo, hi, 0, acc)
    return join(acc, "")

// _rp_substr_collect: DFS collect chars in the global index range [lo, hi).
// `base` is the character offset of the leftmost character in rope r.
fn _rp_substr_collect(r, lo, hi, base, acc)
    if r["leaf"] == 1
        let s = r["s"]
        let n = len(s)
        // This leaf covers global indices [base, base+n).
        let start = lo - base
        let end = hi - base
        if start < 0
            start = 0
        if end > n
            end = n
        let i = start
        while i < end
            acc.push(char_at(s, i))
            i += 1
    else
        let w = r["w"]
        // Left child covers [base, base+w), right child covers [base+w, ...).
        // Visit left child only if the query range overlaps [base, base+w).
        if lo < base + w
            _rp_substr_collect(r["l"], lo, hi, base, acc)
        // Visit right child only if the query range overlaps [base+w, ...).
        if hi > base + w
            _rp_substr_collect(r["r"], lo, hi, base + w, acc)

// rp_index_of: return the first index of single-char string ch in the rope,
// or -1 if not found. Performs an in-order traversal tracking offset.
fn rp_index_of(r, ch)
    return _rp_index_of_helper(r, ch, 0)

// _rp_index_of_helper: recursive search; base is the offset of rope r.
// Returns global index of first match, or -1.
fn _rp_index_of_helper(r, ch, base)
    if r["leaf"] == 1
        let s = r["s"]
        let n = len(s)
        for i in 0..n
            if char_at(s, i) == ch
                return base + i
        return -1
    // Search left first; if found return its result.
    let left_result = _rp_index_of_helper(r["l"], ch, base)
    if left_result != -1
        return left_result
    // Not found in left; search right.
    let w = r["w"]
    return _rp_index_of_helper(r["r"], ch, base + w)
