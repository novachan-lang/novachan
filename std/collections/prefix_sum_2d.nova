// prefix_sum_2d — 2D prefix sums for O(1) inclusive submatrix queries.
//
// Representation (dict):
//   "p"    -> flat list of ints, length (rows+1)*(cols+1); row-major, 1-indexed
//   "rows" -> int
//   "cols" -> int
//   "c1"   -> int (= cols+1, stride per row in the flat array)
//
// p[r][c] (via flat index r*c1+c) stores the sum of the rectangle from
// original (0,0) to (r-1, c-1) in 1-indexed BIT-style coordinates.
// Submatrix query uses inclusion-exclusion: O(1) with 4 table lookups.
//
// Build: O(rows * cols).  Query: O(1).

// _ps2_idx — private: flat index for 1-indexed position (r, c).
fn _ps2_idx(r, c, c1)
    return r * c1 + c

// ps2_build(matrix) -> prefix-sum structure for 0-indexed 2D list matrix.
// matrix must be a non-empty list of rows; all rows must have equal length.
fn ps2_build(matrix)
    let rows = len(matrix)
    let cols = len(matrix[0])
    let c1 = cols + 1
    let total = (rows + 1) * c1
    let p = []
    for i in 0..total
        p.push(0)
    // Fill 1-indexed prefix table.
    // p[r][c] = matrix[r-1][c-1] + p[r-1][c] + p[r][c-1] - p[r-1][c-1]
    let r = 1
    while r <= rows
        let c = 1
        while c <= cols
            let val = matrix[r - 1][c - 1]
            let above = p[_ps2_idx(r - 1, c, c1)]
            let left = p[_ps2_idx(r, c - 1, c1)]
            let diag = p[_ps2_idx(r - 1, c - 1, c1)]
            let idx = _ps2_idx(r, c, c1)
            p[idx] = val + above + left - diag
            c = c + 1
        r = r + 1
    let s = {}
    s["p"] = p
    s["rows"] = rows
    s["cols"] = cols
    s["c1"] = c1
    return s

// ps2_submatrix_sum(s, r1, c1, r2, c2) -> int: sum of the inclusive rectangle (r1,c1)..(r2,c2) (0-indexed).
// Uses 4-point inclusion-exclusion on the 1-indexed prefix table.
fn ps2_submatrix_sum(s, r1, c1, r2, c2)
    let p = s["p"]
    let stride = s["c1"]
    // Convert to 1-indexed: r1->r1, c1->c1, r2->r2+1, c2->c2+1
    let R1 = r1
    let C1 = c1
    let R2 = r2 + 1
    let C2 = c2 + 1
    let a = p[_ps2_idx(R2, C2, stride)]
    let b = p[_ps2_idx(R1, C2, stride)]
    let c_val = p[_ps2_idx(R2, C1, stride)]
    let d = p[_ps2_idx(R1, C1, stride)]
    return a - b - c_val + d

// ps2_total(s) -> int: sum of all elements in the original matrix.
fn ps2_total(s)
    let rows = s["rows"]
    let cols = s["cols"]
    let c1 = s["c1"]
    let p = s["p"]
    return p[_ps2_idx(rows, cols, c1)]
