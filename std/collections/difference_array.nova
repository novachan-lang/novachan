// difference_array — Efficient range-update structure using a difference array.
//
// Representation (dict):
//   "d"  -> list of ints (difference array, length n+1)
//   "n"  -> int (logical length of the original array)
//
// After any sequence of dfa_range_add calls, dfa_finalize recomputes the full
// array in O(n) by prefix-summing d[].  dfa_point_query returns element i
// without materialising the full array.
//
// Time complexity:
//   dfa_range_add : O(1)   (two writes to d[])
//   dfa_finalize  : O(n)   (one prefix-sum pass)
//   dfa_point_query: O(n)  (prefix-sum up to i)

// dfa_from(arr) -> a new difference-array structure initialised from arr.
// d[i] = arr[i] - arr[i-1], with d[0] = arr[0]; d[n] = 0 (sentinel).
fn dfa_from(arr)
    let n = len(arr)
    let d = []
    let i = 0
    while i <= n
        d.push(0)
        i = i + 1
    if n == 0
        let s = {}
        s["d"] = d
        s["n"] = n
        return s
    d[0] = arr[0]
    let j = 1
    while j < n
        d[j] = arr[j] - arr[j - 1]
        j = j + 1
    let s = {}
    s["d"] = d
    s["n"] = n
    return s

// dfa_range_add(s, l, r, val) — add val to every element in the inclusive range [l, r].
// O(1): d[l] += val; d[r+1] -= val.
fn dfa_range_add(s, l, r, val)
    let d = s["d"]
    let n = s["n"]
    d[l] = d[l] + val
    if r + 1 <= n
        d[r + 1] = d[r + 1] - val

// dfa_finalize(s) -> list: the resulting array after all range updates.
// Computes prefix sums of d[] in O(n).
fn dfa_finalize(s)
    let d = s["d"]
    let n = s["n"]
    let out = []
    let cur = 0
    let i = 0
    while i < n
        cur = cur + d[i]
        out.push(cur)
        i = i + 1
    return out

// dfa_point_query(s, i) -> int: value at index i after all updates, without materialising the full array.
// O(i): prefix-sum of d[0..i].
fn dfa_point_query(s, i)
    let d = s["d"]
    let cur = 0
    let j = 0
    while j <= i
        cur = cur + d[j]
        j = j + 1
    return cur
