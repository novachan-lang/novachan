// ============================================================================
// NOVA Standard Library — set algebra over lists
// ============================================================================
// A list is treated as a SET: duplicates are ignored and first-seen order is
// preserved in every result. Works on lists of ints OR strings.
//
// RAISED 2026-08-05. Every operation here was QUADRATIC TWICE OVER:
//   1. `_contains` was a linear scan, and it was called once per element      -> O(n*m)
//   2. `out = out + [x]` reallocates and copies all of `out` per append       -> O(n^2)
// set_union on two 1000-element lists did ~2,000,000 comparisons and ~500,000 element
// copies to produce 1000 elements.
//
// Both are now gone. Membership uses the runtime HASH SET (set_create/set_add/set_has) —
// the same structure std/core/collect.unique uses, giving O(1) lookup — and results are
// built by comprehension, which appends in place. Every operation is now O(n + m).
// (The identical fix on std/itertools measured 23,760 ms -> 92 ms at n=20000.)
//
// The old header said "Pure NOVA (no new builtins)". That self-imposed constraint is what
// forced the linear scan; it is dropped, and `_contains` is gone with it.
//
// Contracts are UNCHANGED, including the 1/0 int returns of is_subset / set_equal — those
// would read better as `bool`, but flipping them would change what callers print.
import std/core/collect

// Build a membership set from a list. Private helper shared by every operation below.
fn _as_set(xs: list)
    let s = set_create()
    for x in xs
        set_add(s, x)
    s

// union: a's uniques first (in order), then b's elements not already present.
// That is exactly "dedupe the concatenation, keeping first-seen order", which is what
// `unique` does — so the whole two-loop version collapses to one line.
fn set_union(a: list, b: list) -> list
    unique([...a, ...b])

// intersection: elements of a that also appear in b, deduped, in a's order.
fn set_intersection(a: list, b: list) -> list
    let inb = _as_set(b)
    unique([x for x in a if set_has(inb, x)])

// difference: elements in a but NOT in b, deduped, in a's order.
fn set_difference(a: list, b: list) -> list
    let inb = _as_set(b)
    unique([x for x in a if not set_has(inb, x)])

// symmetric difference: elements in exactly one of a or b.
// The two halves are disjoint by construction (the first is a subset of a\b, the second of
// b\a), so concatenating them cannot introduce a duplicate — the original's second-pass
// "is it already in out" test could never fire, and dropping it changes nothing.
fn set_symdiff(a: list, b: list) -> list
    [...set_difference(a, b), ...set_difference(b, a)]

// subset test: 1 if every element of a appears in b, else 0.
// The empty set is a subset of everything.
// The loop STAYS because it SHORT-CIRCUITS: the first missing element answers the question,
// and a comprehension would visit all of `a` to build a list nobody wants.
fn is_subset(a: list, b: list) -> int
    let inb = _as_set(b)
    for x in a
        if not set_has(inb, x)
            return 0
    1

// set equality: 1 if a and b contain the same elements, ignoring order and duplicates.
// True exactly when each is a subset of the other.
fn set_equal(a: list, b: list) -> int
    1 if is_subset(a, b) == 1 and is_subset(b, a) == 1 else 0

// ============================================================================
fn main()
    // ── set_union ──
    assert_eq(set_union([1, 2, 3], [3, 4, 5]), [1, 2, 3, 4, 5])
    assert_eq(set_union([1, 1, 2], [2, 2, 3]), [1, 2, 3])      // dedup both sides
    assert_eq(set_union([], []), [])
    assert_eq(set_union([], [7, 8]), [7, 8])
    assert_eq(set_union([7, 8], []), [7, 8])
    assert_eq(set_union([1, 2], [1, 2]), [1, 2])                // identical
    assert_eq(set_union(["a", "b"], ["b", "c"]), ["a", "b", "c"])

    // ── set_intersection ──
    assert_eq(set_intersection([1, 2, 3, 4], [2, 4, 6]), [2, 4])
    assert_eq(set_intersection([1, 2, 3], [4, 5, 6]), [])       // disjoint
    assert_eq(set_intersection([1, 1, 2, 2], [2, 1]), [1, 2])   // dedup result
    assert_eq(set_intersection([], [1, 2]), [])
    assert_eq(set_intersection([1, 2], []), [])
    assert_eq(set_intersection(["x", "y", "z"], ["y", "w", "x"]), ["x", "y"])

    // ── set_difference ──
    assert_eq(set_difference([1, 2, 3, 4], [2, 4]), [1, 3])
    assert_eq(set_difference([1, 2, 3], [1, 2, 3]), [])         // identical
    assert_eq(set_difference([1, 2, 3], [4, 5]), [1, 2, 3])     // disjoint
    assert_eq(set_difference([1, 1, 2, 3], [3]), [1, 2])        // dedup result
    assert_eq(set_difference([], [1]), [])
    assert_eq(set_difference([1, 2], []), [1, 2])
    assert_eq(set_difference(["a", "b", "c"], ["b"]), ["a", "c"])

    // ── set_symdiff ──
    assert_eq(set_symdiff([1, 2, 3], [3, 4, 5]), [1, 2, 4, 5])
    assert_eq(set_symdiff([1, 2, 3], [1, 2, 3]), [])            // identical -> empty
    assert_eq(set_symdiff([1, 2], [3, 4]), [1, 2, 3, 4])        // disjoint -> union
    assert_eq(set_symdiff([], []), [])
    assert_eq(set_symdiff([], [9, 9]), [9])                     // dedup b side
    assert_eq(set_symdiff([1, 1, 2], [2, 3, 3]), [1, 3])
    assert_eq(set_symdiff(["a", "b"], ["b", "c"]), ["a", "c"])

    // ── is_subset ── (returns 1/0)
    assert_eq(is_subset([1, 2], [1, 2, 3]), 1)                  // proper subset
    assert_eq(is_subset([1, 2, 3], [1, 2, 3]), 1)              // equal -> subset
    assert_eq(is_subset([1, 4], [1, 2, 3]), 0)                  // 4 missing
    assert_eq(is_subset([], [1, 2, 3]), 1)                     // empty subset of any
    assert_eq(is_subset([], []), 1)                            // empty subset of empty
    assert_eq(is_subset([1], []), 0)                           // nonempty not subset of empty
    assert_eq(is_subset([1, 1, 2], [2, 1]), 1)                 // dups in a, still subset
    assert_eq(is_subset(["a", "b"], ["a", "b", "c"]), 1)
    assert_eq(is_subset(["a", "z"], ["a", "b"]), 0)

    // ── set_equal ── (returns 1/0, ignores order and dups)
    assert_eq(set_equal([1, 2, 3], [3, 2, 1]), 1)              // reordered
    assert_eq(set_equal([1, 2, 2, 3], [3, 1, 2]), 1)          // dups ignored
    assert_eq(set_equal([1, 2, 3], [1, 2]), 0)                // size mismatch
    assert_eq(set_equal([1, 2], [1, 2, 3]), 0)                // other direction
    assert_eq(set_equal([], []), 1)                           // both empty
    assert_eq(set_equal([], [1]), 0)
    assert_eq(set_equal(["a", "b"], ["b", "a"]), 1)
    assert_eq(set_equal(["a", "b"], ["a", "c"]), 0)            // same size, diff elem

    // ── cross-function invariants ──
    // union(a,b) == union(b,a) as sets
    assert_eq(set_equal(set_union([1, 2], [2, 3]), set_union([2, 3], [1, 2])), 1)
    // symdiff == union minus intersection (as sets)
    let u = set_union([1, 2, 3], [3, 4, 5])
    let x = set_intersection([1, 2, 3], [3, 4, 5])
    assert_eq(set_equal(set_symdiff([1, 2, 3], [3, 4, 5]), set_difference(u, x)), 1)
    // intersection is a subset of both inputs
    assert_eq(is_subset(set_intersection([1, 2, 3, 4], [2, 3, 5]), [1, 2, 3, 4]), 1)
    assert_eq(is_subset(set_intersection([1, 2, 3, 4], [2, 3, 5]), [2, 3, 5]), 1)

    print("setops_test passed")
