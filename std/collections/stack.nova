// stack — LIFO stack backed by a list, wrapped in a dict for reference semantics.
//
// Representation:
//   {"items": []}   — items[0] is the bottom, items[len-1] is the top
//
// Public API
//   st_new()          -> stack (empty)
//   st_push(s, v)     -> (mutates s, pushes v onto top)
//   st_pop(s)         -> value  (removes+returns top; returns null if empty)
//   st_peek(s)        -> value  (returns top without removing; returns null if empty)
//   st_size(s)        -> int
//   st_is_empty(s)    -> bool (1 if empty, 0 otherwise)
//   st_clear(s)       -> (removes all elements from s)
//   st_to_list(s)     -> list  (copy, bottom..top order)

// st_new: create and return an empty stack.
fn st_new()
    let s = {}
    s["items"] = []
    return s

// st_push: push value v onto the top of stack s.
fn st_push(s, v)
    let items = s["items"]
    items.push(v)

// st_pop: remove and return the top element.
// Returns null if the stack is empty.
fn st_pop(s)
    let items = s["items"]
    let n = len(items)
    if n == 0
        return null
    return items.pop()

// st_peek: return the top element without removing it.
// Returns null if the stack is empty.
fn st_peek(s)
    let items = s["items"]
    let n = len(items)
    if n == 0
        return null
    return items[n - 1]

// st_size: number of elements in the stack.
fn st_size(s)
    return len(s["items"])

// st_is_empty: true (1) if the stack has no elements.
fn st_is_empty(s)
    if len(s["items"]) == 0
        return 1
    return 0

// st_clear: remove all elements from the stack.
fn st_clear(s)
    s["items"] = []

// st_to_list: return a fresh copy of the backing list (bottom..top).
fn st_to_list(s)
    let items = s["items"]
    let out = []
    let i = 0
    while i < len(items)
        out.push(items[i])
        i += 1
    return out
