// ============================================================================
// NOVA Standard Library — std/collections/binary_trie
// ============================================================================
// Binary (bitwise) trie over non-negative 31-bit integers (0 .. 2^31-1).
// Classic structure for maximum-XOR-pair queries: each inserted integer is
// stored as a root-to-leaf path of its bits, most-significant bit first.
//
// NOTE: this is a DIFFERENT structure from std/collections/trie.nova (which
// is a STRING prefix tree). This module indexes integers by BIT, not
// characters by string position.
//
// Representation: each node is a dict with:
//   "c"   -> int   number of inserted values whose path passes through
//                  (or ends at) this node — the subtree occupancy count.
//   "0"   -> child node dict reached by taking bit value 0 (optional key)
//   "1"   -> child node dict reached by taking bit value 1 (optional key)
//
// BITS = 31 levels are walked for every value (bit 30 down to bit 0), so
// every stored value occupies exactly 31 nodes below the root — duplicates
// simply increment "c" counts along the shared path.
//
// Public API
//   bxt_new()             -> trie root (dict)
//   bxt_insert(t, x)      -> unit   (insert x, duplicates allowed)
//   bxt_remove(t, x)      -> unit   (remove one occurrence of x; no-op if absent)
//   bxt_contains(t, x)    -> bool
//   bxt_size(t)           -> int    (total live values, counting duplicates)
//   bxt_max_xor(t, x)     -> int    (max over stored y of x^y; -1 if trie empty)
// ============================================================================

let BXT_BITS = 31

// _bxt_c: subtree occupancy of a node, treating an absent "c" key as 0.
fn _bxt_c(node) -> int
    if contains(node, "c")
        return node["c"]
    return 0

// _bxt_bit: extract bit `b` of x (0 or 1).
fn _bxt_bit(x, b) -> int
    return (x >> b) & 1

// bxt_new: an empty trie is just an empty root node.
fn bxt_new() -> dict
    let t = {}
    return t

// bxt_insert: add x to the trie, creating nodes along its bit path as needed.
fn bxt_insert(t, x)
    let node = t
    node["c"] = _bxt_c(node) + 1
    let b = BXT_BITS - 1
    while b >= 0
        let bit = _bxt_bit(x, b)
        let key = str(bit)
        if not contains(node, key)
            let child = {}
            node[key] = child
        node = node[key]
        node["c"] = _bxt_c(node) + 1
        b = b - 1

// bxt_contains: true if x has at least one live occurrence in the trie.
fn bxt_contains(t, x) -> bool
    let node = t
    let b = BXT_BITS - 1
    while b >= 0
        let bit = _bxt_bit(x, b)
        let key = str(bit)
        if not contains(node, key)
            return false
        node = node[key]
        if _bxt_c(node) <= 0
            return false
        b = b - 1
    return true

// bxt_remove: decrement the occupancy count along x's bit path by one
// occurrence. No-op if x is not currently present.
fn bxt_remove(t, x)
    if not bxt_contains(t, x)
        return
    let node = t
    node["c"] = _bxt_c(node) - 1
    let b = BXT_BITS - 1
    while b >= 0
        let bit = _bxt_bit(x, b)
        let key = str(bit)
        node = node[key]
        node["c"] = _bxt_c(node) - 1
        b = b - 1

// bxt_size: total number of live values stored (duplicates counted).
fn bxt_size(t) -> int
    return _bxt_c(t)

// bxt_max_xor: return max_{y in trie} (x ^ y). Returns -1 if the trie is
// empty (all valid XOR results are >= 0, so -1 is a safe "empty" sentinel).
// Greedy bit-by-bit: at each level, prefer the child whose bit is the
// OPPOSITE of x's bit (that maximizes this bit of the XOR), falling back to
// the same-bit child when the opposite subtree is empty or absent.
fn bxt_max_xor(t, x) -> int
    if _bxt_c(t) <= 0
        return -1
    let node = t
    let result = 0
    let b = BXT_BITS - 1
    while b >= 0
        let bit = _bxt_bit(x, b)
        let want = 1 - bit
        let wantKey = str(want)
        if contains(node, wantKey) and _bxt_c(node[wantKey]) > 0
            result = result | (1 << b)
            node = node[wantKey]
        else
            let sameKey = str(bit)
            node = node[sameKey]
        b = b - 1
    return result
