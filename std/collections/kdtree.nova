// kdtree — 2-D k-d tree for integer [x,y] points.
//
// Each internal node is a NOVA dict with keys:
//   "kx", "ky"   -> int   the point stored at this node
//   "axis"       -> int   split axis (0=x, 1=y)
//   "left"       -> dict  left subtree node  (or the sentinel _kd_nil)
//   "right"      -> dict  right subtree node (or the sentinel _kd_nil)
//   "sz"         -> int   subtree point count (for kd_size)
//
// The "empty tree" is represented by a dict {"nil":1,"sz":0}.
// Callers receive a root dict that is either the nil sentinel or a real node.
//
// Public API:
//   kd_build(points)       -> dict  build a balanced tree from a list of [x,y]
//   kd_size(t)             -> int   number of stored points
//   kd_nearest(t, x, y)   -> list  the stored [x,y] with minimum squared distance
//   kd_range(t, x, y, r)  -> list  all stored [x,y] with squared dist <= r*r, sorted

// ---- private: nil sentinel --------------------------------------------------

// _kd_nil_node: returns the canonical nil sentinel dict.
// We create one per-call; equality is tested via contains("nil").
fn _kd_nil_node()
    let n = {}
    n["nil"] = 1
    n["sz"] = 0
    return n

// _kd_is_nil: 1 if node is the nil sentinel.
fn _kd_is_nil(nd)
    return contains(nd, "nil")

// ---- private: sort helpers --------------------------------------------------

// _kd_sort_by_x: insertion-sort a list of [x,y] ascending by x (then y).
fn _kd_sort_by_x(pts, lo, hi)
    let i = lo + 1
    while i <= hi
        let kp = pts[i]
        let kx = kp[0]
        let ky = kp[1]
        let j = i - 1
        let pos = i
        let going = 1
        while going == 1
            if j >= lo
                let cp = pts[j]
                let cx = cp[0]
                let cy = cp[1]
                let before = 0
                if cx > kx
                    before = 1
                if cx == kx
                    if cy > ky
                        before = 1
                if before == 1
                    pts[j + 1] = cp
                    j -= 1
                    pos = j + 1
                else
                    pos = j + 1
                    going = 0
            else
                pos = lo
                going = 0
        pts[pos] = kp
        i += 1

// _kd_sort_by_y: insertion-sort a list of [x,y] ascending by y (then x).
fn _kd_sort_by_y(pts, lo, hi)
    let i = lo + 1
    while i <= hi
        let kp = pts[i]
        let kx = kp[0]
        let ky = kp[1]
        let j = i - 1
        let pos = i
        let going = 1
        while going == 1
            if j >= lo
                let cp = pts[j]
                let cx = cp[0]
                let cy = cp[1]
                let before = 0
                if cy > ky
                    before = 1
                if cy == ky
                    if cx > kx
                        before = 1
                if before == 1
                    pts[j + 1] = cp
                    j -= 1
                    pos = j + 1
                else
                    pos = j + 1
                    going = 0
            else
                pos = lo
                going = 0
        pts[pos] = kp
        i += 1

// ---- private: build ---------------------------------------------------------

// _kd_build_range: recursively build a balanced k-d tree from pts[lo..hi]
// (both inclusive) splitting on `axis`.
fn _kd_build_range(pts, lo, hi, axis)
    if lo > hi
        return _kd_nil_node()
    if axis == 0
        _kd_sort_by_x(pts, lo, hi)
    else
        _kd_sort_by_y(pts, lo, hi)
    let mid = lo + (hi - lo) / 2
    let mp = pts[mid]
    let nd = {}
    nd["kx"] = mp[0]
    nd["ky"] = mp[1]
    nd["axis"] = axis
    nd["sz"] = hi - lo + 1
    let next_axis = 0
    if axis == 0
        next_axis = 1
    nd["left"] = _kd_build_range(pts, lo, mid - 1, next_axis)
    nd["right"] = _kd_build_range(pts, mid + 1, hi, next_axis)
    return nd

// ---- private: nearest neighbour --------------------------------------------
//
// best[0] = best squared distance so far (starts at a large sentinel)
// best[1] = best point x
// best[2] = best point y
//
// We pass `best` as a list so the recursion can mutate it.

fn _kd_nearest_rec(nd, qx, qy, best)
    if _kd_is_nil(nd) == 1
        return 0
    // compute squared distance from query to this node's point
    let dx = nd["kx"] - qx
    let dy = nd["ky"] - qy
    let dsq = dx * dx + dy * dy
    let cur_best = best[0]
    if dsq < cur_best
        best[0] = dsq
        best[1] = nd["kx"]
        best[2] = nd["ky"]
    // decide which subtree to visit first (the side the query point is on)
    let axis = nd["axis"]
    let diff = 0
    if axis == 0
        diff = qx - nd["kx"]
    else
        diff = qy - nd["ky"]
    // first = the "near" child, second = the "far" child
    if diff <= 0
        // query is on the left side
        _kd_nearest_rec(nd["left"], qx, qy, best)
        // prune the right subtree if the splitting plane is farther than best
        let plane_dist = diff * diff
        let updated_best = best[0]
        if plane_dist <= updated_best
            _kd_nearest_rec(nd["right"], qx, qy, best)
    else
        // query is on the right side
        _kd_nearest_rec(nd["right"], qx, qy, best)
        let plane_dist = diff * diff
        let updated_best = best[0]
        if plane_dist <= updated_best
            _kd_nearest_rec(nd["left"], qx, qy, best)
    return 0

// ---- private: range search --------------------------------------------------

// _kd_range_rec: collect all points within radius^2 of (qx,qy) into `out`.
fn _kd_range_rec(nd, qx, qy, r2, out)
    if _kd_is_nil(nd) == 1
        return 0
    let px = nd["kx"]
    let py = nd["ky"]
    let dx = px - qx
    let dy = py - qy
    let dsq = dx * dx + dy * dy
    if dsq <= r2
        let pt = [px, py]
        out.push(pt)
    // prune: if splitting plane is farther than r, skip that subtree
    let axis = nd["axis"]
    let diff = 0
    if axis == 0
        diff = qx - nd["kx"]
    else
        diff = qy - nd["ky"]
    let plane_dist = diff * diff
    if diff <= 0
        _kd_range_rec(nd["left"], qx, qy, r2, out)
        if plane_dist <= r2
            _kd_range_rec(nd["right"], qx, qy, r2, out)
    else
        _kd_range_rec(nd["right"], qx, qy, r2, out)
        if plane_dist <= r2
            _kd_range_rec(nd["left"], qx, qy, r2, out)
    return 0

// ---- private: sort result points lexicographically -------------------------

fn _kd_sort_pts(pts)
    let n = len(pts)
    for i in 1..n
        let kp = pts[i]
        let kx = kp[0]
        let ky = kp[1]
        let j = i - 1
        let pos = i
        let going = 1
        while going == 1
            if j >= 0
                let cp = pts[j]
                let cx = cp[0]
                let cy = cp[1]
                let before = 0
                if cx > kx
                    before = 1
                if cx == kx
                    if cy > ky
                        before = 1
                if before == 1
                    pts[j + 1] = cp
                    j -= 1
                    pos = j + 1
                else
                    pos = j + 1
                    going = 0
            else
                pos = 0
                going = 0
        pts[pos] = kp

// ---- public API -------------------------------------------------------------

// kd_build: build a balanced 2-D k-d tree from a list of [x,y] integer points.
// Returns the root node dict (or nil sentinel for empty input).
fn kd_build(points)
    let n = len(points)
    if n == 0
        return _kd_nil_node()
    // make a mutable copy so we don't alter the caller's list
    let pts = []
    for i in 0..n
        let p = points[i]
        let cp = [p[0], p[1]]
        pts.push(cp)
    return _kd_build_range(pts, 0, n - 1, 0)

// kd_size: number of points stored in the tree.
fn kd_size(t)
    return t["sz"]

// kd_nearest: return the stored [x,y] closest to (qx,qy) by squared Euclidean
// distance.  Branch-and-bound pruning avoids visiting unnecessary subtrees.
// Behaviour is undefined on an empty tree (use kd_size > 0 before calling).
fn kd_nearest(t, qx, qy)
    // best = [best_dsq, best_x, best_y]
    // Initialise best_dsq to a very large value (no point can be this far).
    let best = [2000000000, 0, 0]
    _kd_nearest_rec(t, qx, qy, best)
    let result = [best[1], best[2]]
    return result

// kd_range: return all stored [x,y] with squared Euclidean distance <= r*r
// from (qx,qy).  Result is sorted lexicographically by (x,y).
fn kd_range(t, qx, qy, r)
    let out = []
    let r2 = r * r
    _kd_range_rec(t, qx, qy, r2, out)
    _kd_sort_pts(out)
    return out
