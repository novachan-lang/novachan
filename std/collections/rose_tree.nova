// ============================================================================
// NOVA Standard Library — std/collections/rose_tree
// ============================================================================
// Rose tree — a general-purpose N-ary tree ADT (arbitrary branching factor,
// no ordering invariant). This fills the gap left by std/tree/* (which are
// ALGORITHMS over externally-supplied trees — diameter, centroid, rerooting,
// etc.) and std/graph/directed.nova (a general directed graph): NOVA had no
// plain "build a tree, add children, walk it" data structure of its own.
//
// Representation: each node is a dict:
//   {"v": value, "kids": list of child node dicts}
//
// Public API
//   rst_new(v)              -> node          (new node holding value v, no children)
//   rst_add_child(node, v)  -> node          (create+append a new child; returns it)
//   rst_val(node)           -> value
//   rst_children(node)      -> list          (list of child node dicts)
//   rst_child_count(node)   -> int
//   rst_is_leaf(node)       -> bool
//   rst_dfs(root)           -> list          (preorder DFS, values only)
//   rst_bfs(root)           -> list          (level-order BFS, values only)
//   rst_height(root)        -> int           (0 for a single leaf node)
//   rst_count(root)         -> int           (total node count, root included)
//   rst_find(root, v)       -> node          (first DFS match, or {} if absent)
//   rst_found(node)         -> bool          (true unless node is the {} not-found sentinel)
// ============================================================================

fn rst_new(v) -> dict
    let n = {}
    n["v"] = v
    n["kids"] = []
    return n

fn rst_add_child(node, v) -> dict
    let child = rst_new(v)
    push(node["kids"], child)
    return child

fn rst_val(node)
    return node["v"]

fn rst_children(node) -> list
    return node["kids"]

fn rst_child_count(node) -> int
    return len(node["kids"])

fn rst_is_leaf(node) -> bool
    return len(node["kids"]) == 0

fn _rst_dfs(node, acc)
    push(acc, node["v"])
    let kids = node["kids"]
    let i = 0
    while i < len(kids)
        _rst_dfs(kids[i], acc)
        i = i + 1

fn rst_dfs(root) -> list
    let acc = []
    _rst_dfs(root, acc)
    return acc

fn rst_bfs(root) -> list
    let acc = []
    let queue = [root]
    let qi = 0
    while qi < len(queue)
        let node = queue[qi]
        push(acc, node["v"])
        let kids = node["kids"]
        let k = 0
        while k < len(kids)
            push(queue, kids[k])
            k = k + 1
        qi = qi + 1
    return acc

fn rst_height(node) -> int
    let kids = node["kids"]
    if len(kids) == 0
        return 0
    let best = -1
    let i = 0
    while i < len(kids)
        let h = rst_height(kids[i])
        if h > best
            best = h
        i = i + 1
    return best + 1

fn rst_count(root) -> int
    let total = 1
    let kids = root["kids"]
    let i = 0
    while i < len(kids)
        total = total + rst_count(kids[i])
        i = i + 1
    return total

fn rst_find(root, v)
    if root["v"] == v
        return root
    let kids = root["kids"]
    let i = 0
    while i < len(kids)
        let r = rst_find(kids[i], v)
        if len(keys(r)) > 0
            return r
        i = i + 1
    let empty = {}
    return empty

fn rst_found(node) -> bool
    return len(keys(node)) > 0
