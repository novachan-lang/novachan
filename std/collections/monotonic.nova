// monotonic — Monotonic stack/queue algorithms on integer lists.
//
// All algorithms run in O(n) amortised time: each index is pushed and
// popped at most once.
//
// Monotonic deque (sliding-window min/max) uses the native deque builtin
// to store indices.  The deque invariant is maintained on the VALUES at
// those indices, not on the indices themselves.
//
// Public API:
//   mono_max_sliding(xs, k) -> list   maximum of every window of size k
//   mono_min_sliding(xs, k) -> list   minimum of every window of size k
//   mono_next_greater(xs)   -> list   next strictly-greater value, or -1
//   mono_prev_smaller(xs)   -> list   previous strictly-smaller value, or -1

// mono_max_sliding(xs, k) -> list
// Returns a list of length max(0, len(xs)-k+1) where result[i] is the
// maximum of xs[i..i+k-1].  Uses a monotonic deque of indices whose
// corresponding values are non-increasing (front = current window max).
fn mono_max_sliding(xs, k)
    let n = len(xs)
    let out = []
    if k <= 0
        return out
    if n < k
        return out
    let dq = deque_create()
    let i = 0
    while i < n
        // Remove from front indices that have fallen outside the window
        let done_front = 0
        while done_front == 0
            if deque_is_empty(dq)
                done_front = 1
            else
                let front_idx = deque_front(dq)
                if front_idx <= i - k
                    deque_pop_front(dq)
                else
                    done_front = 1
        // Remove from back indices whose values are <= xs[i]
        // (they can never be the window max while i is still in range)
        let done_back = 0
        while done_back == 0
            if deque_is_empty(dq)
                done_back = 1
            else
                let back_idx = deque_back(dq)
                if xs[back_idx] <= xs[i]
                    deque_pop_back(dq)
                else
                    done_back = 1
        deque_push_back(dq, i)
        // Once the first full window is seen, record the maximum
        if i >= k - 1
            out.push(xs[deque_front(dq)])
        i = i + 1
    return out

// mono_min_sliding(xs, k) -> list
// Returns a list of length max(0, len(xs)-k+1) where result[i] is the
// minimum of xs[i..i+k-1].  Uses a monotonic deque of indices whose
// corresponding values are non-decreasing (front = current window min).
fn mono_min_sliding(xs, k)
    let n = len(xs)
    let out = []
    if k <= 0
        return out
    if n < k
        return out
    let dq = deque_create()
    let i = 0
    while i < n
        // Evict front indices outside the window
        let done_front = 0
        while done_front == 0
            if deque_is_empty(dq)
                done_front = 1
            else
                let front_idx = deque_front(dq)
                if front_idx <= i - k
                    deque_pop_front(dq)
                else
                    done_front = 1
        // Evict back indices whose values are >= xs[i]
        let done_back = 0
        while done_back == 0
            if deque_is_empty(dq)
                done_back = 1
            else
                let back_idx = deque_back(dq)
                if xs[back_idx] >= xs[i]
                    deque_pop_back(dq)
                else
                    done_back = 1
        deque_push_back(dq, i)
        if i >= k - 1
            out.push(xs[deque_front(dq)])
        i = i + 1
    return out

// mono_next_greater(xs) -> list
// For each position i, result[i] is the first value xs[j] with j > i
// and xs[j] > xs[i].  If no such j exists, result[i] = -1.
// Uses a monotonic stack of pending indices (values non-increasing top-to-bottom).
fn mono_next_greater(xs)
    let n = len(xs)
    // Initialise result list with -1 for every position
    let result = []
    for fi in 0..n
        result.push(0 - 1)
    // Stack holds indices whose "next greater" is not yet resolved
    let stk = []
    let i = 0
    while i < n
        // While stack non-empty and current element > element at stack top
        let done = 0
        while done == 0
            let sn = len(stk)
            if sn == 0
                done = 1
            else
                let top_idx = stk[sn - 1]
                if xs[top_idx] < xs[i]
                    result[top_idx] = xs[i]
                    stk.pop()
                else
                    done = 1
        stk.push(i)
        i = i + 1
    // Remaining indices on stack have no next-greater element; already -1
    return result

// mono_prev_smaller(xs) -> list
// For each position i, result[i] is the nearest value xs[j] with j < i
// and xs[j] < xs[i].  If no such j exists, result[i] = -1.
// Uses a monotonic stack (non-decreasing: stack top is the nearest candidate).
fn mono_prev_smaller(xs)
    let n = len(xs)
    let result = []
    for fi in 0..n
        result.push(0 - 1)
    // Stack of indices with non-decreasing xs values
    let stk = []
    for i in 0..n
        // Pop indices whose values are >= xs[i]; they cannot be the answer for i
        let done = 0
        while done == 0
            let sn = len(stk)
            if sn == 0
                done = 1
            else
                let top_idx = stk[sn - 1]
                if xs[top_idx] >= xs[i]
                    stk.pop()
                else
                    done = 1
        // Now the stack top (if any) holds the nearest smaller element
        let sn2 = len(stk)
        if sn2 > 0
            result[i] = xs[stk[sn2 - 1]]
        stk.push(i)
    return result
