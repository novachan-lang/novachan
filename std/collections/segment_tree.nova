// segment_tree — SUM segment tree with point update and range sum query.
//
// Representation dict keys:
//   "n"  -> int           (logical element count)
//   "pw" -> int           (next power-of-two >= n; tree leaf offset)
//   "t"  -> list of ints  (1-indexed tree, length 2*pw; index 0 unused)
//
// Leaf i (0-based) sits at tree index pw+i.
// Internal node k has children 2k and 2k+1.
// All operations are O(log n).

// _seg_pow2(n) -> smallest power-of-two >= n.
fn _seg_pow2(n)
    let p = 1
    while p < n
        p = p * 2
    return p

// seg_build(arr) -> new segment tree loaded with arr (0-indexed list of ints).
fn seg_build(arr)
    let n = len(arr)
    let pw = _seg_pow2(n)
    let sz = pw * 2
    let t = []
    let k = 0
    while k < sz
        t.push(0)
        k = k + 1
    let i = 0
    while i < n
        t[pw + i] = arr[i]
        i = i + 1
    let j = pw - 1
    while j >= 1
        t[j] = t[j * 2] + t[j * 2 + 1]
        if j == 1
            j = 0
        else
            j = j - 1
    let tree = {}
    tree["n"] = n
    tree["pw"] = pw
    tree["t"] = t
    return tree

// seg_query(tree, l, r) -> sum over inclusive 0-based range [l, r].
fn seg_query(tree, l, r)
    let pw = tree["pw"]
    let t = tree["t"]
    let lo = l + pw
    let hi = r + pw + 1
    let acc = 0
    while lo < hi
        if (lo & 1) == 1
            acc = acc + t[lo]
            lo = lo + 1
        if (hi & 1) == 1
            hi = hi - 1
            acc = acc + t[hi]
        lo = lo / 2
        hi = hi / 2
    return acc

// seg_update(tree, i, val) -> set element at 0-based index i to val.
fn seg_update(tree, i, val)
    let pw = tree["pw"]
    let t = tree["t"]
    let pos = i + pw
    t[pos] = val
    pos = pos / 2
    while pos >= 1
        t[pos] = t[pos * 2] + t[pos * 2 + 1]
        if pos == 1
            pos = 0
        else
            pos = pos / 2

// seg_query_all(tree) -> sum of all elements.
fn seg_query_all(tree)
    let t = tree["t"]
    return t[1]
