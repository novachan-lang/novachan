// sparsetable — Sparse table for O(1) idempotent range queries over a fixed int array.
//
// Supports: range-minimum (sp_build_min / sp_query_min),
//           range-maximum (sp_build_max / sp_query_max),
//           range-GCD     (sp_build_gcd / sp_query_gcd).
//
// Representation: a dict with keys:
//   "n"      -> int   (number of elements)
//   "k"      -> int   (number of levels = floor(log2(n)) + 1)
//   "log"    -> list  (log[i] = floor(log2(i)) for i in 0..n; log[0]=0 sentinel)
//   "sparse" -> list  (list of k lists; sparse[k][i] = op over xs[i .. i+2^k-1])
//   "op"     -> str   ("min", "max", or "gcd")
//
// Build: O(n log n) time and space.
// Query: O(1) — overlapping power-of-two ranges cover [lo,hi] for idempotent ops.

// _spt_log2(n) — compute floor(log2(n)) for n >= 1 via iteration.
fn _spt_log2(n)
    let r = 0
    let v = n
    while v > 1
        v = v / 2
        r = r + 1
    return r

// _spt_min(a, b) — integer minimum.
fn _spt_min(a, b)
    if a < b
        return a
    return b

// _spt_max(a, b) — integer maximum.
fn _spt_max(a, b)
    if a > b
        return a
    return b

// _spt_gcd(a, b) — greatest common divisor via Euclidean algorithm.
fn _spt_gcd(a, b)
    // handle negatives: work with absolute values
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    while b != 0
        let tmp = b
        b = a % b
        a = tmp
    return a

// _spt_op(op, a, b) — apply named idempotent operation to two ints.
fn _spt_op(op, a, b)
    if op == "min"
        return _spt_min(a, b)
    if op == "max"
        return _spt_max(a, b)
    // "gcd"
    return _spt_gcd(a, b)

// _spt_build(xs, op) — internal builder shared by all three public build functions.
fn _spt_build(xs, op)
    let n = len(xs)
    // Build log table: log[0]=0 (sentinel), log[i]=floor(log2(i)) for i>=1.
    let log = []
    let li = 0
    while li <= n
        log.push(_spt_log2(li))
        li = li + 1
    // k = number of levels = floor(log2(n)) + 1  (at least 1 for n>=1)
    let k = 0
    if n > 0
        k = _spt_log2(n) + 1
    // Build sparse table level by level.
    // sparse is a list of k lists.
    let sparse = []
    // Level 0: sparse[0][i] = xs[i]
    let level0 = []
    for ci in 0..n
        level0.push(xs[ci])
    sparse.push(level0)
    // Levels 1..k-1
    for ck in 1..k
        // width of this level's window = 2^ck; half = 2^(ck-1)
        let half = 1
        let hh = 0
        while hh < ck - 1
            half = half * 2
            hh = hh + 1
        let prev = sparse[ck - 1]
        let cur = []
        let maxStart = n - half * 2
        let si = 0
        while si <= maxStart
            cur.push(_spt_op(op, prev[si], prev[si + half]))
            si = si + 1
        sparse.push(cur)
    let t = {}
    t["n"] = n
    t["k"] = k
    t["log"] = log
    t["sparse"] = sparse
    t["op"] = op
    return t

// _spt_query(t, lo, hi) — O(1) range query [lo,hi] inclusive (0-based).
// Works for any idempotent operation (min, max, gcd) stored in t["op"].
fn _spt_query(t, lo, hi)
    let log = t["log"]
    let sparse = t["sparse"]
    let op = t["op"]
    let length = hi - lo + 1
    let k = log[length]
    // 2^k
    let pw = 1
    for pi in 0..k
        pw = pw * 2
    let right = hi - pw + 1
    return _spt_op(op, sparse[k][lo], sparse[k][right])

// sp_build_min(xs) -> dict
// Build a sparse table for range-minimum queries over the int list xs.
fn sp_build_min(xs)
    return _spt_build(xs, "min")

// sp_query_min(t, lo, hi) -> int
// Return the minimum of xs[lo..hi] inclusive (0-based indices). O(1).
fn sp_query_min(t, lo, hi)
    return _spt_query(t, lo, hi)

// sp_build_max(xs) -> dict
// Build a sparse table for range-maximum queries over the int list xs.
fn sp_build_max(xs)
    return _spt_build(xs, "max")

// sp_query_max(t, lo, hi) -> int
// Return the maximum of xs[lo..hi] inclusive (0-based indices). O(1).
fn sp_query_max(t, lo, hi)
    return _spt_query(t, lo, hi)

// sp_build_gcd(xs) -> dict
// Build a sparse table for range-GCD queries over the int list xs.
fn sp_build_gcd(xs)
    return _spt_build(xs, "gcd")

// sp_query_gcd(t, lo, hi) -> int
// Return the GCD of xs[lo..hi] inclusive (0-based indices). O(1).
fn sp_query_gcd(t, lo, hi)
    return _spt_query(t, lo, hi)
