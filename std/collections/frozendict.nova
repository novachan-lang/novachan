// frozendict — immutable dict wrapper.
//
// Representation (a plain NOVA dict):
//   "data" -> dict  (a private copy of the original dict; never mutated)
//
// Public API
//   fz_of(d)          -> frozendict  (copies d; original mutations don't affect the frozen copy)
//   fz_get(fz, k)     -> value for key k (key must exist)
//   fz_has(fz, k)     -> bool (1 if k present, 0 otherwise)
//   fz_keys(fz)       -> list of string keys
//   fz_len(fz)        -> int (number of entries)
//   fz_to_dict(fz)    -> a fresh mutable copy of the backing dict
//   fz_with(fz, k, v) -> NEW frozendict with k=v added/updated; original unchanged
//   fz_without(fz, k) -> NEW frozendict without key k; original unchanged

// _fz_copy_dict: return a fresh independent copy of a dict.
fn _fz_copy_dict(src)
    let out = {}
    let ks = keys(src)
    for i in 0..len(ks)
        let k = ks[i]
        out[k] = src[k]
    return out

// fz_of: wrap a dict as a frozendict. Takes a defensive copy so the caller
// cannot mutate the frozendict's backing store.
fn fz_of(d)
    let fz = {}
    fz["data"] = _fz_copy_dict(d)
    return fz

// fz_get: return the value for key k. Key must exist.
fn fz_get(fz, k)
    let data = fz["data"]
    return data[k]

// fz_has: return 1 if k is present, 0 otherwise.
fn fz_has(fz, k)
    let data = fz["data"]
    if k in data
        return 1
    return 0

// fz_keys: return a list of all string keys.
fn fz_keys(fz)
    let data = fz["data"]
    return keys(data)

// fz_len: number of key-value pairs.
fn fz_len(fz)
    let data = fz["data"]
    return len(data)

// fz_to_dict: return a fresh mutable copy of the backing dict.
fn fz_to_dict(fz)
    return _fz_copy_dict(fz["data"])

// fz_with: return a NEW frozendict with k set to v. The original is unchanged.
fn fz_with(fz, k, v)
    let copy = _fz_copy_dict(fz["data"])
    copy[k] = v
    let result = {}
    result["data"] = copy
    return result

// fz_without: return a NEW frozendict with key k removed. The original is unchanged.
fn fz_without(fz, k)
    let src = fz["data"]
    let ks = keys(src)
    let out = {}
    for i in 0..len(ks)
        let key = ks[i]
        if key != k
            out[key] = src[key]
    let result = {}
    result["data"] = out
    return result
