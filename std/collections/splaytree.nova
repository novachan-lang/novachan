// splaytree — Splay tree as an ordered int set.
//
// Each node is a dict: {"k": int, "l": node|null, "r": node|null}
//   k = key, l = left child, r = right child
//
// The splay tree dict itself: {"root": node|null, "size": int}
//
// A splay tree is a self-adjusting BST. After every access (search, insert,
// delete) the accessed node is rotated to the root via a sequence of splay
// steps. This gives O(log n) amortised performance without storing balance
// info in nodes.
//
// Splay steps (bottom-up, on the path from accessed node to root):
//   Zig       — single rotation (node is child of root)
//   Zig-Zig   — two same-direction rotations (node and parent same side)
//   Zig-Zag   — two opposite-direction rotations (node and parent opposite)
//
// This implementation uses top-down splaying (Sleator & Tarjan 1985 style):
// the tree is split into Left, Middle, Right assemblies as we descend, then
// reassembled.  This avoids needing parent pointers.
//
// Public API:
//   spl_new()           -> dict        (empty splay tree)
//   spl_insert(t, k)    -> unit        (no-op if already present)
//   spl_contains(t, k)  -> bool (1/0)
//   spl_delete(t, k)    -> unit        (no-op if absent)
//   spl_inorder(t)      -> list        (ascending sorted ints)
//   spl_size(t)         -> int
//   spl_min(t)          -> int         (undefined on empty tree)
//   spl_max(t)          -> int         (undefined on empty tree)

// _spl_node: create a new leaf node.
fn _spl_node(k)
    return {"k": k, "l": null, "r": null}

// _spl_rot_right: single right rotation around nd.
//   Before:    nd             After:   lc
//             /  \                    /  \
//            lc   R                 LL   nd
//           /  \                        /  \
//          LL   LR                     LR   R
// Returns new subtree root.
fn _spl_rot_right(nd)
    let lc = nd["l"]
    nd["l"] = lc["r"]
    lc["r"] = nd
    return lc

// _spl_rot_left: single left rotation around nd.
//   Before:   nd              After:   rc
//            /  \                     /  \
//           L   rc                  nd   RR
//              /  \                /  \
//             RL   RR              L   RL
// Returns new subtree root.
fn _spl_rot_left(nd)
    let rc = nd["r"]
    nd["r"] = rc["l"]
    rc["l"] = nd
    return rc

// _spl_splay: top-down splay of key k to the root of subtree nd.
// Returns the new root.  After this call:
//   - If k is in the tree, root["k"] == k.
//   - If k is not in the tree, the root is the largest key < k
//     (or smallest key > k if k is less than all keys).
fn _spl_splay(nd, k)
    if nd == null
        return null
    // Use a sentinel header node: header["l"] = left assembly, header["r"] = right assembly
    let header = {"l": null, "r": null}
    // left_max: rightmost node of the left assembly (we append to its right child)
    // right_min: leftmost node of the right assembly (we append to its left child)
    // We track these via a "path" dict updated in place.
    let state = {"left_max": null, "right_min": null}
    let cur = nd
    let done = 0
    while done == 0
        let ck = cur["k"]
        if k < ck
            // Go left
            let cl = cur["l"]
            if cl == null
                done = 1
            else
                let clk = cl["k"]
                if k < clk
                    // Zig-Zig left: rotate right at cur before descending
                    cur = _spl_rot_right(cur)
                    let cur2l = cur["l"]
                    if cur2l == null
                        done = 1
                    else
                        // Link cur into right assembly
                        let rm = state["right_min"]
                        if rm == null
                            header["l"] = cur
                        else
                            rm["l"] = cur
                        state["right_min"] = cur
                        cur = cur2l
                else
                    // Zig-Zag or plain Zig: just link cur into right assembly
                    let rm2 = state["right_min"]
                    if rm2 == null
                        header["l"] = cur
                    else
                        rm2["l"] = cur
                    state["right_min"] = cur
                    cur = cl
        else
            if k > ck
                // Go right
                let cr = cur["r"]
                if cr == null
                    done = 1
                else
                    let crk = cr["k"]
                    if k > crk
                        // Zig-Zig right: rotate left at cur before descending
                        cur = _spl_rot_left(cur)
                        let cur2r = cur["r"]
                        if cur2r == null
                            done = 1
                        else
                            // Link cur into left assembly
                            let lm = state["left_max"]
                            if lm == null
                                header["r"] = cur
                            else
                                lm["r"] = cur
                            state["left_max"] = cur
                            cur = cur2r
                    else
                        // Zig-Zag or plain Zig: just link cur into left assembly
                        let lm2 = state["left_max"]
                        if lm2 == null
                            header["r"] = cur
                        else
                            lm2["r"] = cur
                        state["left_max"] = cur
                        cur = cr
            else
                // k == ck: found it
                done = 1
    // Reassemble: connect left/right assemblies to cur
    let lm3 = state["left_max"]
    let rm3 = state["right_min"]
    if lm3 == null
        header["r"] = cur["l"]
    else
        lm3["r"] = cur["l"]
    if rm3 == null
        header["l"] = cur["r"]
    else
        rm3["l"] = cur["r"]
    cur["l"] = header["r"]
    cur["r"] = header["l"]
    return cur

// _spl_inorder: append keys from subtree to acc in ascending order.
fn _spl_inorder(nd, acc)
    if nd == null
        return 0
    _spl_inorder(nd["l"], acc)
    acc.push(nd["k"])
    _spl_inorder(nd["r"], acc)
    return 0

// spl_new: create a new empty splay tree.
fn spl_new()
    return {"root": null, "size": 0}

// spl_insert: insert key k into the splay tree.  No-op if already present.
fn spl_insert(t, k)
    let root = t["root"]
    if root == null
        t["root"] = _spl_node(k)
        t["size"] += 1
        return 0
    root = _spl_splay(root, k)
    if root["k"] == k
        // Already present
        t["root"] = root
        return 0
    // k not present: split tree at root and create new root with key k
    let nd = _spl_node(k)
    if k < root["k"]
        nd["l"] = root["l"]
        nd["r"] = root
        root["l"] = null
    else
        nd["r"] = root["r"]
        nd["l"] = root
        root["r"] = null
    t["root"] = nd
    t["size"] += 1
    return 0

// spl_contains: return 1 if k is in the tree, 0 otherwise.
// Side effect: splays k (or nearest key) to root.
fn spl_contains(t, k)
    let root = t["root"]
    if root == null
        return 0
    root = _spl_splay(root, k)
    t["root"] = root
    root["k"] == k

// spl_delete: remove key k from the splay tree.  No-op if absent.
fn spl_delete(t, k)
    let root = t["root"]
    if root == null
        return 0
    root = _spl_splay(root, k)
    if root["k"] != k
        // Not present
        t["root"] = root
        return 0
    // k is now at root: join left and right subtrees
    let lsub = root["l"]
    let rsub = root["r"]
    if lsub == null
        t["root"] = rsub
    else if rsub == null
        t["root"] = lsub
    else
        // Splay the maximum of the left subtree to its root, then attach rsub
        lsub = _spl_splay(lsub, k)
        // After splaying k in lsub, the root of lsub has no right child
        // (since k was deleted and lsub contains only keys < k)
        lsub["r"] = rsub
        t["root"] = lsub
    t["size"] -= 1
    return 0

// spl_inorder: return a list of all keys in ascending order.
fn spl_inorder(t)
    let acc = []
    _spl_inorder(t["root"], acc)
    return acc

// spl_size: return the number of keys currently stored.
fn spl_size(t)
    return t["size"]

// spl_min: return the minimum key in the tree.
// Precondition: tree is non-empty.
fn spl_min(t)
    let cur = t["root"]
    while cur["l"] != null
        cur = cur["l"]
    return cur["k"]

// spl_max: return the maximum key in the tree.
// Precondition: tree is non-empty.
fn spl_max(t)
    let cur = t["root"]
    while cur["r"] != null
        cur = cur["r"]
    return cur["k"]
