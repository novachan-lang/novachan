// ============================================================================
// NOVA Standard Library — std/collections/dsu_rollback
// ============================================================================
// Disjoint-Set-Union (Union-Find) WITH ROLLBACK — supports undoing unions
// back to any earlier checkpoint. This is a DIFFERENT structure from
// std/collections/unionfind.nova / dsu_weighted.nova / weightedunion.nova:
// those use path compression, which makes individual unions impossible to
// cleanly undo (compression silently repoints ancestors of NODES NEVER
// PASSED to union()). dsu_rollback deliberately omits path compression —
// find() stays O(log n) via union-by-size alone — in exchange for exact,
// O(1)-per-undone-union rollback. This is the standard structure used for
// offline dynamic connectivity / "undo the last k unions" problems
// (e.g. Kruskal-with-undo, small-to-large merging with backtracking).
//
// Representation (dict d):
//   "parent"     -> list of int, length n; parent[i] == i means i is a root
//   "size"       -> list of int, length n; size[r] valid only when r is a root
//   "components" -> int number of disjoint sets currently
//   "history"    -> list of [child_root, new_parent_root, new_parent_old_size],
//                    one entry per successful (non-no-op) union, in order
//
// Public API (prefix dsur_):
//   dsur_new(n)                 -> dict
//   dsur_find(d, x)              -> int   (root of x; no path compression)
//   dsur_union(d, x, y)          -> bool  (true if x,y were merged; false if already same set)
//   dsur_connected(d, x, y)      -> bool
//   dsur_component_size(d, x)    -> int   (size of x's component)
//   dsur_count(d)                -> int   (number of components)
//   dsur_snapshot(d)             -> int   (checkpoint token — pass to dsur_rollback)
//   dsur_rollback(d, checkpoint) -> dict  (undo every union since `checkpoint`)
// ============================================================================

// dsur_new: n singleton elements 0..n-1.
fn dsur_new(n) -> dict
    let parent = []
    let sz = []
    let i = 0
    while i < n
        parent.push(i)
        sz.push(1)
        i = i + 1
    let d = {}
    d["parent"] = parent
    d["size"] = sz
    d["components"] = n
    d["history"] = []
    d

// dsur_find: walk parent pointers to the root. No path compression (by
// design — compression would make rollback incorrect).
fn dsur_find(d, x) -> int
    let parent = d["parent"]
    let cur = x
    while parent[cur] != cur
        cur = parent[cur]
    cur

// dsur_connected: true iff x and y are in the same component.
fn dsur_connected(d, x, y) -> bool
    dsur_find(d, x) == dsur_find(d, y)

// dsur_component_size: size of the component containing x.
fn dsur_component_size(d, x) -> int
    let sz = d["size"]
    sz[dsur_find(d, x)]

// dsur_count: number of disjoint components.
fn dsur_count(d) -> int
    d["components"]

// dsur_union: merge the components of x and y (union by size, smaller root
// attached under larger). Records enough history to undo this exact merge.
// Returns false (no-op, no history pushed) if x and y are already connected.
fn dsur_union(d, x, y) -> bool
    let rx = dsur_find(d, x)
    let ry = dsur_find(d, y)
    if rx == ry
        return false
    let sz = d["size"]
    let parent = d["parent"]
    let a = rx
    let b = ry
    if sz[a] < sz[b]
        let tmp = a
        a = b
        b = tmp
    let old_a_size = sz[a]
    let history = d["history"]
    history.push([b, a, old_a_size])
    parent[b] = a
    sz[a] = old_a_size + sz[b]
    d["components"] = d["components"] - 1
    true

// dsur_snapshot: a checkpoint token representing "right now" — pass this to
// dsur_rollback later to undo every union performed since this call.
fn dsur_snapshot(d) -> int
    len(d["history"])

// dsur_rollback: undo unions, most recent first, until the history is back
// down to length `checkpoint` (as returned by dsur_snapshot).
fn dsur_rollback(d, checkpoint) -> dict
    let history = d["history"]
    while len(history) > checkpoint
        let entry = pop(history)
        let child = entry[0]
        let par = entry[1]
        let oldsize = entry[2]
        let parent = d["parent"]
        let sz = d["size"]
        parent[child] = child
        sz[par] = oldsize
        d["components"] = d["components"] + 1
    d

// ============================================================================
fn main()
    print("std/collections/dsu_rollback loaded")
