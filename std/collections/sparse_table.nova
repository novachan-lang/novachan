// sparse_table — O(n log n) build, O(1) range-min and range-max queries.
//
// spt_build(arr) builds a single structure supporting both min and max.
// The table stores two sparse arrays (one for min, one for max) plus a
// shared floor-log2 lookup so queries never recompute powers-of-two.
//
// Representation (dict):
//   "n"    -> int   number of elements
//   "k"    -> int   number of levels = floor(log2(n)) + 1
//   "log"  -> list  log[i] = floor(log2(i)) for i = 0..n (log[0] = 0 sentinel)
//   "smin" -> list  smin[k][i] = min of xs[i .. i+2^k-1]
//   "smax" -> list  smax[k][i] = max of xs[i .. i+2^k-1]
//
// Build: O(n log n) time and space.
// Query: O(1) — two overlapping power-of-two windows cover [l,r] for
//        idempotent ops (min and max both satisfy op(op(a,b),b) = op(a,b)).

// _spt_log2(n) — floor(log2(n)) for n >= 1 via repeated halving.
fn _spt_log2(n)
    let r = 0
    let v = n
    while v > 1
        v = v / 2
        r = r + 1
    return r

// spt_build(arr) -> dict
// Build a sparse table for O(1) range-min and range-max over int list arr.
fn spt_build(arr)
    let n = len(arr)
    let log = []
    let li = 0
    while li <= n
        if li == 0
            log.push(0)
        else
            log.push(_spt_log2(li))
        li = li + 1
    let k = 1
    if n > 1
        k = _spt_log2(n) + 1
    let smin = []
    let smax = []
    let level0_min = []
    let level0_max = []
    for ci in 0..n
        level0_min.push(arr[ci])
        level0_max.push(arr[ci])
    smin.push(level0_min)
    smax.push(level0_max)
    for ck in 1..k
        let half = 1
        let hh = 0
        while hh < ck - 1
            half = half * 2
            hh = hh + 1
        let prev_min = smin[ck - 1]
        let prev_max = smax[ck - 1]
        let cur_min = []
        let cur_max = []
        let maxStart = n - half * 2
        let si = 0
        while si <= maxStart
            let a_min = prev_min[si]
            let b_min = prev_min[si + half]
            if a_min < b_min
                cur_min.push(a_min)
            else
                cur_min.push(b_min)
            let a_max = prev_max[si]
            let b_max = prev_max[si + half]
            if a_max > b_max
                cur_max.push(a_max)
            else
                cur_max.push(b_max)
            si = si + 1
        smin.push(cur_min)
        smax.push(cur_max)
    let t = {}
    t["n"] = n
    t["k"] = k
    t["log"] = log
    t["smin"] = smin
    t["smax"] = smax
    return t

// spt_query_min(st, l, r) -> int
// Return the minimum of arr[l..r] inclusive (0-based). O(1).
fn spt_query_min(st, l, r)
    let log = st["log"]
    let smin = st["smin"]
    let length = r - l + 1
    let kk = log[length]
    let pw = 1
    for pi in 0..kk
        pw = pw * 2
    let right = r - pw + 1
    let a = smin[kk][l]
    let b = smin[kk][right]
    if a < b
        return a
    return b

// spt_query_max(st, l, r) -> int
// Return the maximum of arr[l..r] inclusive (0-based). O(1).
fn spt_query_max(st, l, r)
    let log = st["log"]
    let smax = st["smax"]
    let length = r - l + 1
    let kk = log[length]
    let pw = 1
    for pi in 0..kk
        pw = pw * 2
    let right = r - pw + 1
    let a = smax[kk][l]
    let b = smax[kk][right]
    if a > b
        return a
    return b
