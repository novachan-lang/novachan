// bitset — a fixed-size bitset backed by a list of 64-bit int words.
//
// Representation: a list `bs` where
//   bs[0]      = nbits (the logical number of bits)
//   bs[1..]    = the backing words, ceil(nbits/64) of them, each holding bits 0..63
//
// Bit i lives in word index (i/64)+1 of the list, at bit position (i%64).
// Any mutator (bs_set / bs_clear) RETURNS a brand-new bitset rather than editing in
// place. That is the CONTRACT the tests below assert, and it is preserved exactly.
// (The old header justified it as "lists are immutable"; that is no longer true of
// NOVA lists, so the value-semantics story is now a deliberate choice, not a limitation.)
//
// RAISED 2026-08-05. All five `out = out + [x]` rebuild loops are gone. Each of them
// reallocated and copied the whole accumulating list per word; every one is now a single
// comprehension that states the rule directly. The word count is small (ceil(nbits/64)),
// so this is a readability and correctness win more than a throughput one -- but
// bs_with_word is called on EVERY set/clear, so it is on the hot path of any real use.

// Number of backing words needed for nbits bits: ceil(nbits/64).
fn bs_nwords(nbits: int) -> int
    return (nbits + 63) / 64

// Logical bit capacity of a bitset.
fn bs_nbits(bs) -> int
    return bs[0]

// Create a fresh bitset of nbits bits, all clear.
// Element 0 is nbits; elements 1.. are ceil(nbits/64) zero words.
fn bitset_new(nbits)
    [nbits, ...[0 for _ in 0..bs_nwords(nbits)]]

// Rebuild a bitset replacing the word at list-index `wi` (1-based into words)
// with `val`, keeping every other word identical. This is the immutable-list
// "store" primitive that bs_set / bs_clear are built on.
//
// One comprehension states the whole rule: "every slot as it was, except wi".
// Index 0 (the nbits header) is preserved automatically because wi is always >= 1.
fn bs_with_word(bs, wi, val)
    [val if k == wi else bs[k] for k in 0..len(bs)]

// Return a NEW bitset with bit i set (word = i/64, bit = i%64, OR in (1<<bit)).
fn bs_set(bs, i)
    let wi = (i / 64) + 1
    let bit = i % 64
    let cur = bs[wi]
    let updated = cur | (1 << bit)
    return bs_with_word(bs, wi, updated)

// Return a NEW bitset with bit i cleared.
// Clear mask = NOT(1<<bit); NOT is emulated via xor with -1.
fn bs_clear(bs, i)
    let wi = (i / 64) + 1
    let bit = i % 64
    let cur = bs[wi]
    let mask = (1 << bit) ^ -1
    let updated = cur & mask
    return bs_with_word(bs, wi, updated)

// Test bit i -> 1 if set, 0 if clear.
fn bs_test(bs, i) -> int
    let wi = (i / 64) + 1
    let bit = i % 64
    let cur = bs[wi]
    if (cur >> bit) & 1 == 1
        return 1
    return 0

// Total number of set bits across all words (sum of popcount over words).
// Word 1 onwards: index 0 is the nbits header, not a word.
fn bs_count(bs) -> int
    sum([popcount(bs[k]) for k in 1..len(bs)])

// Elementwise OR of two equal-nbits bitsets. The nbits header is carried through unchanged.
fn bs_union(a, b)
    [a[0], ...[a[k] | b[k] for k in 1..len(a)]]

// Elementwise AND of two equal-nbits bitsets.
fn bs_intersect(a, b)
    [a[0], ...[a[k] & b[k] for k in 1..len(a)]]

fn main()
    // ---- bs_nwords: ceil(nbits/64) boundaries ----
    assert_eq(bs_nwords(0), 0)
    assert_eq(bs_nwords(1), 1)
    assert_eq(bs_nwords(64), 1)
    assert_eq(bs_nwords(65), 2)
    assert_eq(bs_nwords(100), 2)
    assert_eq(bs_nwords(128), 2)
    assert_eq(bs_nwords(129), 3)

    // ---- bitset_new(100): nbits stored, 2 words, count 0 ----
    let a = bitset_new(100)
    assert_eq(bs_nbits(a), 100)
    assert_eq(len(a), 3)           // [nbits, word0, word1]
    assert_eq(bs_count(a), 0)
    // every bit reads 0 initially
    for i in 0..100
        assert_eq(bs_test(a, i), 0)

    // ---- bs_set(.,5) and bs_set(.,70): cross-word, immutability ----
    let b = bs_set(a, 5)
    let c = bs_set(b, 70)
    // original untouched (immutable return)
    assert_eq(bs_count(a), 0)
    assert_eq(bs_test(a, 5), 0)
    // bit 5 lives in word 0, bit 70 in word 1
    assert_eq(bs_test(c, 5), 1)
    assert_eq(bs_test(c, 70), 1)
    assert_eq(bs_count(c), 2)
    // every OTHER bit is 0
    for j in 0..100
        if j == 5 or j == 70
            assert_eq(bs_test(c, j), 1)
        else
            assert_eq(bs_test(c, j), 0)

    // setting an already-set bit is idempotent (count unchanged)
    let c2 = bs_set(c, 5)
    assert_eq(bs_count(c2), 2)
    assert_eq(bs_test(c2, 5), 1)

    // ---- bs_clear removes a bit ----
    let d = bs_clear(c, 5)
    assert_eq(bs_test(d, 5), 0)
    assert_eq(bs_test(d, 70), 1)
    assert_eq(bs_count(d), 1)
    // clearing an already-clear bit is a no-op
    let d2 = bs_clear(d, 5)
    assert_eq(bs_count(d2), 1)
    // clearing the last bit empties it
    let d3 = bs_clear(d, 70)
    assert_eq(bs_count(d3), 0)

    // ---- boundary bits: 0, 63 (top of word 0), 64 (bottom of word 1), 99 ----
    let e = bs_set(bitset_new(100), 0)
    assert_eq(bs_test(e, 0), 1)
    assert_eq(bs_count(e), 1)
    let f = bs_set(bitset_new(100), 63)
    assert_eq(bs_test(f, 63), 1)
    assert_eq(bs_test(f, 64), 0)
    assert_eq(bs_count(f), 1)
    let g = bs_set(bitset_new(100), 64)
    assert_eq(bs_test(g, 64), 1)
    assert_eq(bs_test(g, 63), 0)
    assert_eq(bs_count(g), 1)
    let h = bs_set(bitset_new(100), 99)
    assert_eq(bs_test(h, 99), 1)
    assert_eq(bs_count(h), 1)

    // ---- single-bit bitset (nbits=1) ----
    let one = bitset_new(1)
    assert_eq(len(one), 2)         // [1, word0]
    assert_eq(bs_count(one), 0)
    let one1 = bs_set(one, 0)
    assert_eq(bs_test(one1, 0), 1)
    assert_eq(bs_count(one1), 1)

    // ---- bs_union / bs_intersect: membership + counts ----
    // setX = {1, 5, 70}, setY = {5, 70, 99}
    let setX = bs_set(bs_set(bs_set(bitset_new(100), 1), 5), 70)
    let setY = bs_set(bs_set(bs_set(bitset_new(100), 5), 70), 99)
    assert_eq(bs_count(setX), 3)
    assert_eq(bs_count(setY), 3)

    // union = {1, 5, 70, 99} -> count 4
    let u = bs_union(setX, setY)
    assert_eq(bs_count(u), 4)
    assert_eq(bs_test(u, 1), 1)
    assert_eq(bs_test(u, 5), 1)
    assert_eq(bs_test(u, 70), 1)
    assert_eq(bs_test(u, 99), 1)
    assert_eq(bs_test(u, 2), 0)
    // union preserves nbits
    assert_eq(bs_nbits(u), 100)

    // intersection = {5, 70} -> count 2
    let x = bs_intersect(setX, setY)
    assert_eq(bs_count(x), 2)
    assert_eq(bs_test(x, 5), 1)
    assert_eq(bs_test(x, 70), 1)
    assert_eq(bs_test(x, 1), 0)    // only in X
    assert_eq(bs_test(x, 99), 0)   // only in Y
    assert_eq(bs_nbits(x), 100)

    // union of a set with the empty set = the set itself
    let empty = bitset_new(100)
    let uEmpty = bs_union(setX, empty)
    assert_eq(bs_count(uEmpty), 3)
    // intersect with empty = empty
    let xEmpty = bs_intersect(setX, empty)
    assert_eq(bs_count(xEmpty), 0)

    // ---- popcount-based count matches a manual bit-by-bit scan ----
    let big = bs_set(bs_set(bs_set(bs_set(bitset_new(100), 0), 31), 64), 99)
    let manual = sum([bs_test(big, p) for p in 0..100])
    assert_eq(bs_count(big), manual)
    assert_eq(bs_count(big), 4)

    print("bitset_test passed")

main()
