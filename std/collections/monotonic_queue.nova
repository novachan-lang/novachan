// monotonic_queue — Sliding-window minimum and maximum in O(n) total time.
//
// Each element is enqueued and dequeued at most once, giving O(1) amortised
// cost per window step.  A monotonic deque of indices maintains the invariant:
//   - max variant: values at stored indices are non-increasing (front = max)
//   - min variant: values at stored indices are non-decreasing (front = min)
//
// Output length for an input of n elements and window size k:
//   max(0, n - k + 1)
//
// Public API:
//   mdq_sliding_max(arr, k) -> list   maximum of each k-element window
//   mdq_sliding_min(arr, k) -> list   minimum of each k-element window

// mdq_sliding_max(arr, k) -> list
// Returns a list where result[i] is the maximum of arr[i .. i+k-1].
// Uses a non-increasing deque (front holds the index of the current window max).
fn mdq_sliding_max(arr, k)
    let n = len(arr)
    let out = []
    if k <= 0
        return out
    if n < k
        return out
    let dq = deque_create()
    let i = 0
    while i < n
        let done_front = 0
        while done_front == 0
            if deque_is_empty(dq)
                done_front = 1
            else
                let fi = deque_front(dq)
                if fi <= i - k
                    deque_pop_front(dq)
                else
                    done_front = 1
        let done_back = 0
        while done_back == 0
            if deque_is_empty(dq)
                done_back = 1
            else
                let bi = deque_back(dq)
                if arr[bi] <= arr[i]
                    deque_pop_back(dq)
                else
                    done_back = 1
        deque_push_back(dq, i)
        if i >= k - 1
            out.push(arr[deque_front(dq)])
        i = i + 1
    return out

// mdq_sliding_min(arr, k) -> list
// Returns a list where result[i] is the minimum of arr[i .. i+k-1].
// Uses a non-decreasing deque (front holds the index of the current window min).
fn mdq_sliding_min(arr, k)
    let n = len(arr)
    let out = []
    if k <= 0
        return out
    if n < k
        return out
    let dq = deque_create()
    for i in 0..n
        let done_front = 0
        while done_front == 0
            if deque_is_empty(dq)
                done_front = 1
            else
                let fi = deque_front(dq)
                if fi <= i - k
                    deque_pop_front(dq)
                else
                    done_front = 1
        let done_back = 0
        while done_back == 0
            if deque_is_empty(dq)
                done_back = 1
            else
                let bi = deque_back(dq)
                if arr[bi] >= arr[i]
                    deque_pop_back(dq)
                else
                    done_back = 1
        deque_push_back(dq, i)
        if i >= k - 1
            out.push(arr[deque_front(dq)])
    return out
