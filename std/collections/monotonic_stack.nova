// monotonic_stack — Monotonic-stack algorithms returning index-based answers.
//
// All algorithms run in O(n) amortised time: each index is pushed and
// popped at most once.
//
// Public API:
//   mst_next_greater(arr)         -> list of ints (index of next strictly-greater, or -1)
//   mst_prev_smaller(arr)         -> list of ints (index of previous strictly-smaller, or -1)
//   mst_largest_rectangle(heights) -> int (largest rectangle area in histogram)

// mst_next_greater(arr) -> list
// For each index i, result[i] is the index j > i such that arr[j] > arr[i]
// and j is as small as possible.  Returns -1 when no such j exists.
// Maintains a stack of indices whose "next greater" is unresolved.
// Values on the stack are non-increasing so that when arr[i] exceeds the
// top value we have found the answer for all such indices in one sweep.
fn mst_next_greater(arr)
    let n = len(arr)
    let result = []
    for fi in 0..n
        result.push(0 - 1)
    let stk = []
    let i = 0
    while i < n
        let done = 0
        while done == 0
            let sn = len(stk)
            if sn == 0
                done = 1
            else
                let top = stk[sn - 1]
                if arr[top] < arr[i]
                    result[top] = i
                    stk.pop()
                else
                    done = 1
        stk.push(i)
        i += 1
    return result

// mst_prev_smaller(arr) -> list
// For each index i, result[i] is the index j < i such that arr[j] < arr[i]
// and j is as large as possible.  Returns -1 when no such j exists.
// Stack is maintained in non-decreasing value order so the top is always
// the nearest candidate; we discard any element >= arr[i] before recording.
fn mst_prev_smaller(arr)
    let n = len(arr)
    let result = []
    for fi in 0..n
        result.push(0 - 1)
    let stk = []
    for i in 0..n
        let done = 0
        while done == 0
            let sn = len(stk)
            if sn == 0
                done = 1
            else
                let top = stk[sn - 1]
                if arr[top] >= arr[i]
                    stk.pop()
                else
                    done = 1
        let sn2 = len(stk)
        if sn2 > 0
            result[i] = stk[sn2 - 1]
        stk.push(i)
    return result

// mst_largest_rectangle(heights) -> int
// Returns the area of the largest axis-aligned rectangle fitting entirely
// within the histogram defined by heights.  Uses the classic O(n) monotonic
// stack: the stack holds indices of bars in non-decreasing height order.
// When a shorter bar is encountered, all taller bars are popped and their
// maximum rectangle computed with the current bar as the right boundary.
fn mst_largest_rectangle(heights)
    let n = len(heights)
    let stk = []
    let best = 0
    let i = 0
    while i <= n
        let h = 0
        if i < n
            h = heights[i]
        let done = 0
        while done == 0
            let sn = len(stk)
            if sn == 0
                done = 1
            else
                let top = stk[sn - 1]
                if heights[top] > h
                    stk.pop()
                    let sn2 = len(stk)
                    let width = 0
                    if sn2 == 0
                        width = i
                    else
                        width = i - stk[sn2 - 1] - 1
                    let area = heights[top] * width
                    if area > best
                        best = area
                else
                    done = 1
        stk.push(i)
        i += 1
    return best
