// frozenlist — immutable list wrapper.
//
// Representation (a plain NOVA dict):
//   "data" -> list  (a private copy of the original list; never mutated)
//
// Public API
//   fl_of(list)          -> frozenlist  (copies the list)
//   fl_get(fl, i)        -> element at index i
//   fl_len(fl)           -> int
//   fl_contains(fl, x)   -> bool
//   fl_index_of(fl, x)   -> int (-1 if absent)
//   fl_to_list(fl)       -> a fresh copy of the data list
//   fl_map(fl, fn)       -> new frozenlist with fn applied to each element
//   fl_filter(fl, pred)  -> new frozenlist of elements where pred(x) is truthy
//   fl_concat(a, b)      -> new frozenlist with all elements of a then b

// _fl_copy_list: return a fresh independent copy of a list.
fn _fl_copy_list(src)
    let out = []
    let i = 0
    while i < len(src)
        out.push(src[i])
        i += 1
    return out

// fl_of: wrap a list as a frozenlist. Takes a defensive copy so the caller
// cannot mutate the frozenlist's backing store.
fn fl_of(lst)
    let fl = {}
    fl["data"] = _fl_copy_list(lst)
    return fl

// fl_get: element at index i (0-based).
fn fl_get(fl, i)
    let data = fl["data"]
    return data[i]

// fl_len: number of elements.
fn fl_len(fl)
    let data = fl["data"]
    return len(data)

// fl_contains: true (1) if x is present, false (0) otherwise.
fn fl_contains(fl, x)
    let data = fl["data"]
    for i in 0..len(data)
        if data[i] == x
            return 1
    return 0

// fl_index_of: first index of x, or -1 if absent.
fn fl_index_of(fl, x)
    let data = fl["data"]
    for i in 0..len(data)
        if data[i] == x
            return i
    return -1

// fl_to_list: return a fresh mutable copy of the backing list.
fn fl_to_list(fl)
    return _fl_copy_list(fl["data"])

// fl_map: apply fn to every element; return a new frozenlist.
fn fl_map(fl, f)
    let data = fl["data"]
    let out = []
    for i in 0..len(data)
        out.push(f(data[i]))
    let result = {}
    result["data"] = out
    return result

// fl_filter: keep elements where pred(x) is truthy; return a new frozenlist.
fn fl_filter(fl, pred)
    let data = fl["data"]
    let out = []
    let i = 0
    while i < len(data)
        if pred(data[i])
            out.push(data[i])
        i += 1
    let result = {}
    result["data"] = out
    return result

// fl_concat: concatenate two frozenlists; return a new frozenlist.
fn fl_concat(a, b)
    let da = a["data"]
    let db = b["data"]
    let out = []
    let i = 0
    while i < len(da)
        out.push(da[i])
        i += 1
    let j = 0
    while j < len(db)
        out.push(db[j])
        j += 1
    let result = {}
    result["data"] = out
    return result
