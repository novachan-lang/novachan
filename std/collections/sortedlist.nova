// sortedlist — sorted list of ints with binary search.
//
// Representation (a plain NOVA dict):
//   "data" -> list  (sorted ascending list of ints)
//
// Public API
//   sl_new()              -> sorted-list
//   sl_bisect_left(sl, x) -> int  leftmost index where x may be inserted keeping order
//   sl_bisect_right(sl, x)-> int  rightmost index where x may be inserted keeping order
//   sl_insort(sl, x)      -> unit (binary-search insert; maintains sorted order)
//   sl_contains(sl, x)    -> bool (1 if x is in the list, 0 otherwise)
//   sl_index(sl, x)       -> int  (-1 if absent)
//   sl_len(sl)            -> int
//   sl_to_list(sl)        -> the underlying sorted list (direct reference)

fn sl_new()
    let sl = {}
    sl["data"] = []
    return sl

// sl_bisect_left: leftmost index i such that data[i] >= x.
// All elements to the left are strictly less than x.
// If all elements < x, returns len(data).
fn sl_bisect_left(sl, x)
    let data = sl["data"]
    let lo = 0
    let hi = len(data)
    while lo < hi
        let mid = (lo + hi) / 2
        if data[mid] < x
            lo = mid + 1
        else
            hi = mid
    return lo

// sl_bisect_right: rightmost index i such that data[i] <= x.
// All elements to the left are <= x.
// If all elements <= x, returns len(data).
fn sl_bisect_right(sl, x)
    let data = sl["data"]
    let lo = 0
    let hi = len(data)
    while lo < hi
        let mid = (lo + hi) / 2
        if data[mid] <= x
            lo = mid + 1
        else
            hi = mid
    return lo

// sl_insort: insert x into sl maintaining sorted order.
// Uses bisect_left so duplicates are placed to the left of existing equals.
fn sl_insort(sl, x)
    let data = sl["data"]
    let idx = sl_bisect_left(sl, x)
    insert(data, idx, x)

// sl_contains: 1 if x is present, 0 otherwise.
fn sl_contains(sl, x)
    let data = sl["data"]
    let idx = sl_bisect_left(sl, x)
    let n = len(data)
    if idx < n
        if data[idx] == x
            return 1
    return 0

// sl_index: index of x, or -1 if absent.
fn sl_index(sl, x)
    let data = sl["data"]
    let idx = sl_bisect_left(sl, x)
    let n = len(data)
    if idx < n
        if data[idx] == x
            return idx
    return -1

// sl_len: number of elements.
fn sl_len(sl)
    return len(sl["data"])

// sl_to_list: return the underlying sorted list.
fn sl_to_list(sl)
    return sl["data"]

// ============================================================================
// Extensions: generic insert/remove/min/max/range on top of the original
// int-oriented bisect API above. Kept in this file (rather than a new
// std/collections/sorted_list.nova) to avoid a duplicate `sl_`-prefixed
// module defining the same sl_new/sl_contains/sl_index/sl_len/sl_to_list
// names — see std/collections/multimap.nova for the same reasoning applied
// there. The `<`/`<=` comparisons in sl_bisect_left/right already work for
// any orderable value (int, float, or string), so these extensions are not
// actually int-only despite the header comment above predating them.
// ============================================================================

// sl_insert: insert x maintaining sorted order. Alias for sl_insort under a
// name that matches the verb used elsewhere in std/collections (dq_/mm_).
fn sl_insert(sl, x)
    sl_insort(sl, x)

// sl_remove: remove the first occurrence of x. No-op if x is absent.
// Returns 1 if a value was removed, 0 otherwise.
fn sl_remove(sl, x)
    let data = sl["data"]
    let idx = sl_bisect_left(sl, x)
    let n = len(data)
    if idx < n
        if data[idx] == x
            let out = []
            let i = 0
            while i < n
                if i != idx
                    out.push(data[i])
                i = i + 1
            sl["data"] = out
            return 1
    return 0

// sl_min: the smallest element. null if sl is empty.
fn sl_min(sl)
    let data = sl["data"]
    if len(data) == 0
        return null
    return data[0]

// sl_max: the largest element. null if sl is empty.
fn sl_max(sl)
    let data = sl["data"]
    let n = len(data)
    if n == 0
        return null
    return data[n - 1]

// sl_range: every element v with lo <= v <= hi, as a fresh list, in order.
fn sl_range(sl, lo, hi)
    let data = sl["data"]
    let lo_idx = sl_bisect_left(sl, lo)
    let hi_idx = sl_bisect_right(sl, hi)
    let out = []
    let i = lo_idx
    while i < hi_idx
        out.push(data[i])
        i = i + 1
    return out
