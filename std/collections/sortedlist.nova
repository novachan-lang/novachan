// sortedlist — sorted list of ints with binary search.
//
// Representation (a plain NOVA dict):
//   "data" -> list  (sorted ascending list of ints)
//
// Public API
//   sl_new()              -> sorted-list
//   sl_bisect_left(sl, x) -> int  leftmost index where x may be inserted keeping order
//   sl_bisect_right(sl, x)-> int  rightmost index where x may be inserted keeping order
//   sl_insort(sl, x)      -> unit (binary-search insert; maintains sorted order)
//   sl_contains(sl, x)    -> bool (1 if x is in the list, 0 otherwise)
//   sl_index(sl, x)       -> int  (-1 if absent)
//   sl_len(sl)            -> int
//   sl_to_list(sl)        -> the underlying sorted list (direct reference)

fn sl_new()
    let sl = {}
    sl["data"] = []
    return sl

// sl_bisect_left: leftmost index i such that data[i] >= x.
// All elements to the left are strictly less than x.
// If all elements < x, returns len(data).
fn sl_bisect_left(sl, x)
    let data = sl["data"]
    let lo = 0
    let hi = len(data)
    while lo < hi
        let mid = (lo + hi) / 2
        if data[mid] < x
            lo = mid + 1
        else
            hi = mid
    return lo

// sl_bisect_right: rightmost index i such that data[i] <= x.
// All elements to the left are <= x.
// If all elements <= x, returns len(data).
fn sl_bisect_right(sl, x)
    let data = sl["data"]
    let lo = 0
    let hi = len(data)
    while lo < hi
        let mid = (lo + hi) / 2
        if data[mid] <= x
            lo = mid + 1
        else
            hi = mid
    return lo

// sl_insort: insert x into sl maintaining sorted order.
// Uses bisect_left so duplicates are placed to the left of existing equals.
fn sl_insort(sl, x)
    let data = sl["data"]
    let idx = sl_bisect_left(sl, x)
    insert(data, idx, x)

// sl_contains: 1 if x is present, 0 otherwise.
fn sl_contains(sl, x)
    let data = sl["data"]
    let idx = sl_bisect_left(sl, x)
    let n = len(data)
    if idx < n
        if data[idx] == x
            return 1
    return 0

// sl_index: index of x, or -1 if absent.
fn sl_index(sl, x)
    let data = sl["data"]
    let idx = sl_bisect_left(sl, x)
    let n = len(data)
    if idx < n
        if data[idx] == x
            return idx
    return -1

// sl_len: number of elements.
fn sl_len(sl)
    return len(sl["data"])

// sl_to_list: return the underlying sorted list.
fn sl_to_list(sl)
    return sl["data"]
