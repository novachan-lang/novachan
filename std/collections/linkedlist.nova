// ============================================================================
// NOVA Standard Library — std/collections/linkedlist
// ============================================================================
// Doubly-linked list backed by node dicts.
//
// Each node is a dict:
//   {"v": value, "prev": node|null, "next": node|null}
//
// The list itself is a dict:
//   {"head": node|null, "tail": node|null, "size": int}
//
// PUBLIC API
//   ll_new()            -> linkedlist dict
//   ll_push_back(l, v)  -> unit  (append to tail)
//   ll_push_front(l, v) -> unit  (prepend to head)
//   ll_pop_back(l)      -> value (remove + return tail value; null if empty)
//   ll_pop_front(l)     -> value (remove + return head value; null if empty)
//   ll_size(l)          -> int
//   ll_to_list(l)       -> list  (head..tail order)
//   ll_from_list(xs)    -> linkedlist
//   ll_get(l, i)        -> value (0-based index; null if out-of-range)
//   ll_reverse(l)       -> unit  (reverses in-place by swapping head/tail links)
// ============================================================================

// _ll_node: allocate a fresh node dict.
fn _ll_node(v)
    let n = {}
    n["v"] = v
    n["prev"] = null
    n["next"] = null
    return n

// ll_new: return an empty linked list.
fn ll_new()
    let l = {}
    l["head"] = null
    l["tail"] = null
    l["size"] = 0
    return l

// ll_size: number of elements.
fn ll_size(l)
    return l["size"]

// ll_push_back: append value to the tail.
fn ll_push_back(l, v)
    let n = _ll_node(v)
    let t = l["tail"]
    if t == null
        l["head"] = n
        l["tail"] = n
    else
        t["next"] = n
        n["prev"] = t
        l["tail"] = n
    l["size"] = l["size"] + 1

// ll_push_front: prepend value at the head.
fn ll_push_front(l, v)
    let n = _ll_node(v)
    let h = l["head"]
    if h == null
        l["head"] = n
        l["tail"] = n
    else
        h["prev"] = n
        n["next"] = h
        l["head"] = n
    l["size"] = l["size"] + 1

// ll_pop_front: remove and return the head value; null if empty.
fn ll_pop_front(l)
    let h = l["head"]
    if h == null
        return null
    let val = h["v"]
    let nx = h["next"]
    if nx == null
        l["head"] = null
        l["tail"] = null
    else
        nx["prev"] = null
        l["head"] = nx
    l["size"] = l["size"] - 1
    return val

// ll_pop_back: remove and return the tail value; null if empty.
fn ll_pop_back(l)
    let t = l["tail"]
    if t == null
        return null
    let val = t["v"]
    let pv = t["prev"]
    if pv == null
        l["head"] = null
        l["tail"] = null
    else
        pv["next"] = null
        l["tail"] = pv
    l["size"] = l["size"] - 1
    return val

// ll_to_list: walk head..tail and collect values into a list.
fn ll_to_list(l)
    let result = []
    let cur = l["head"]
    while cur != null
        result.push(cur["v"])
        cur = cur["next"]
    return result

// ll_from_list: build a linkedlist from a NOVA list (index 0 becomes head).
fn ll_from_list(xs)
    let l = ll_new()
    let i = 0
    while i < len(xs)
        ll_push_back(l, xs[i])
        i = i + 1
    return l

// ll_get: 0-based index access; returns null if i is out of range.
fn ll_get(l, i)
    let sz = l["size"]
    if i < 0
        return null
    if i >= sz
        return null
    let cur = l["head"]
    for j in 0..i
        cur = cur["next"]
    return cur["v"]

// ll_reverse: reverse the list in-place by swapping each node's prev/next
// pointers, then swapping head and tail.
fn ll_reverse(l)
    let cur = l["head"]
    let last = null
    while cur != null
        let nx = cur["next"]
        cur["next"] = cur["prev"]
        cur["prev"] = nx
        last = cur
        cur = nx
    // swap head <-> tail
    let old_head = l["head"]
    l["head"] = l["tail"]
    l["tail"] = old_head
