// rangeset — integer interval set (inclusive ranges).
//
// Representation (a plain NOVA dict):
//   rs["iv"] -> flat list [lo0, hi0, lo1, hi1, ...]
//               intervals kept sorted by lo, disjoint, non-adjacent.
//
// Public API
//   rs_new()                -> rangeset dict
//   rs_add(rs, lo, hi)      -> unit  (insert [lo,hi], merge overlaps/adjacent)
//   rs_contains(rs, x)      -> 1 if x is in any interval, 0 otherwise
//   rs_size(rs)             -> int   (total integers covered = sum of hi-lo+1)
//   rs_intervals(rs)        -> list of [lo, hi] pairs (sorted, disjoint)
//   rs_remove(rs, lo, hi)   -> unit  (remove [lo,hi], splitting intervals as needed)

// ---- helpers ----------------------------------------------------------------

// _iv_len: number of intervals stored (flat list length / 2)
fn _iv_len(iv)
    return len(iv) / 2

// _iv_lo(iv, i): lo of interval i
fn _iv_lo(iv, i)
    return iv[i * 2]

// _iv_hi(iv, i): hi of interval i
fn _iv_hi(iv, i)
    return iv[i * 2 + 1]

// _iv_build: construct a fresh flat list from parallel lo[] and hi[] arrays
fn _iv_build(los, his)
    let n = len(los)
    let out = []
    for k in 0..n
        out.push(los[k])
        out.push(his[k])
    return out

// ---- public API -------------------------------------------------------------

fn rs_new()
    let rs = {}
    rs["iv"] = []
    return rs

// rs_add: insert interval [lo, hi], merging with any overlapping or adjacent
// existing intervals.  Adjacent means touching: existing_hi+1 == lo or
// hi+1 == existing_lo — those must also be merged to keep intervals disjoint
// and maximally merged.
fn rs_add(rs, lo, hi)
    let iv = rs["iv"]
    let n = _iv_len(iv)
    // new merged bounds start at [lo, hi]
    let mlo = lo
    let mhi = hi
    // collect intervals that do NOT overlap/touch [lo,hi]; copy merged ones into mlo/mhi
    let keep_lo = []
    let keep_hi = []
    for k in 0..n
        let elo = _iv_lo(iv, k)
        let ehi = _iv_hi(iv, k)
        // overlap check: intervals [mlo,mhi] and [elo,ehi] merge
        // when they share at least one endpoint: elo <= mhi and ehi >= mlo
        if elo <= mhi and ehi >= mlo
            // absorb into merged interval
            if elo < mlo
                mlo = elo
            if ehi > mhi
                mhi = ehi
        else
            keep_lo.push(elo)
            keep_hi.push(ehi)
    // insert merged interval in sorted position
    let out_lo = []
    let out_hi = []
    let inserted = 0
    let j = 0
    let kn = len(keep_lo)
    while j < kn
        if inserted == 0 and keep_lo[j] > mlo
            out_lo.push(mlo)
            out_hi.push(mhi)
            inserted = 1
        out_lo.push(keep_lo[j])
        out_hi.push(keep_hi[j])
        j += 1
    if inserted == 0
        out_lo.push(mlo)
        out_hi.push(mhi)
    rs["iv"] = _iv_build(out_lo, out_hi)

// rs_contains: 1 if x is in any interval, 0 otherwise (binary search on lo values)
fn rs_contains(rs, x)
    let iv = rs["iv"]
    let n = _iv_len(iv)
    // linear scan; intervals are sorted so we can short-circuit
    for k in 0..n
        let elo = _iv_lo(iv, k)
        let ehi = _iv_hi(iv, k)
        if elo > x
            return 0
        if x <= ehi
            return 1
    return 0

// rs_size: total integer count = sum of (hi-lo+1) across all intervals
fn rs_size(rs)
    let iv = rs["iv"]
    let n = _iv_len(iv)
    let total = 0
    for k in 0..n
        total += (_iv_hi(iv, k) - _iv_lo(iv, k) + 1)
    return total

// rs_intervals: return a list of [lo, hi] pairs, sorted ascending
fn rs_intervals(rs)
    let iv = rs["iv"]
    let n = _iv_len(iv)
    let out = []
    for k in 0..n
        let pair = [_iv_lo(iv, k), _iv_hi(iv, k)]
        out.push(pair)
    return out

// rs_remove: remove all integers in [lo, hi] from the set.
// Intervals that partially overlap are trimmed; intervals fully inside are dropped;
// an interval that straddles [lo,hi] is split into two.
fn rs_remove(rs, lo, hi)
    let iv = rs["iv"]
    let n = _iv_len(iv)
    let out_lo = []
    let out_hi = []
    for k in 0..n
        let elo = _iv_lo(iv, k)
        let ehi = _iv_hi(iv, k)
        // no overlap — keep entirely
        if ehi < lo or elo > hi
            out_lo.push(elo)
            out_hi.push(ehi)
        else
            // left remnant: [elo, lo-1] if elo < lo
            if elo < lo
                out_lo.push(elo)
                out_hi.push(lo - 1)
            // right remnant: [hi+1, ehi] if ehi > hi
            if ehi > hi
                out_lo.push(hi + 1)
                out_hi.push(ehi)
    rs["iv"] = _iv_build(out_lo, out_hi)
