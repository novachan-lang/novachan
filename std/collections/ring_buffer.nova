// ============================================================================
// NOVA Standard Library — std/collections/ring_buffer
// ============================================================================
// Fixed-capacity circular buffer (FIFO with overwrite-on-full semantics).
// Same head/tail/size index arithmetic as std/collections/circularbuf.nova
// but with the rb2_ prefix and an explicit "tail" field (this module's own
// public contract — see field shape below).
//
// Representation (dict buf):
//   "data" -> list, length == cap, pre-filled with 0 placeholders
//   "head" -> int index of the oldest element (valid only when size > 0)
//   "tail" -> int index where the NEXT push writes
//   "size" -> int number of currently valid elements, 0 <= size <= cap
//   "cap"  -> int capacity (>= 1; capacity < 1 is clamped up to 1)
//
// Public API:
//   rb2_new(capacity)  -> dict
//   rb2_push(buf, val) -> dict (overwrites oldest when full; returns buf)
//   rb2_pop(buf)       -> oldest value (removes it), or 0 if empty
//   rb2_peek(buf)      -> oldest value without removing, or 0 if empty
//   rb2_size(buf)      -> int
//   rb2_is_full(buf)   -> bool
//   rb2_is_empty(buf)  -> bool
//   rb2_to_list(buf)   -> list, oldest to newest
//   rb2_clear(buf)     -> dict (resets to empty, returns buf)
// ============================================================================

// rb2_new: capacity is clamped to at least 1 (a 0-capacity ring has no valid
// slot arithmetic — mod-by-zero would be undefined).
fn rb2_new(capacity) -> dict
    let cap = capacity
    if cap < 1
        cap = 1
    let data = []
    let i = 0
    while i < cap
        data.push(0)
        i = i + 1
    let b = {}
    b["data"] = data
    b["head"] = 0
    b["tail"] = 0
    b["size"] = 0
    b["cap"] = cap
    b

// rb2_push: write val at tail and advance tail. When full, this also
// advances head (the oldest slot gets overwritten — standard ring-buffer
// overwrite semantics), so size stays capped at cap.
fn rb2_push(buf, val) -> dict
    let cap = buf["cap"]
    let data = buf["data"]
    data[buf["tail"]] = val
    buf["tail"] = (buf["tail"] + 1) % cap
    if buf["size"] < cap
        buf["size"] = buf["size"] + 1
    else
        buf["head"] = (buf["head"] + 1) % cap
    buf

// rb2_pop: remove and return the oldest element. 0 if empty.
fn rb2_pop(buf)
    if buf["size"] == 0
        return 0
    let data = buf["data"]
    let v = data[buf["head"]]
    buf["head"] = (buf["head"] + 1) % buf["cap"]
    buf["size"] = buf["size"] - 1
    v

// rb2_peek: return the oldest element without removing it. 0 if empty.
fn rb2_peek(buf)
    if buf["size"] == 0
        return 0
    buf["data"][buf["head"]]

// rb2_size: number of currently valid elements.
fn rb2_size(buf) -> int
    buf["size"]

// rb2_is_full: true when size == cap.
fn rb2_is_full(buf) -> bool
    buf["size"] == buf["cap"]

// rb2_is_empty: true when size == 0.
fn rb2_is_empty(buf) -> bool
    buf["size"] == 0

// rb2_to_list: snapshot of all valid elements, oldest first.
fn rb2_to_list(buf) -> list
    let out = []
    let cap = buf["cap"]
    let data = buf["data"]
    let head = buf["head"]
    let size = buf["size"]
    let i = 0
    while i < size
        let idx = (head + i) % cap
        out.push(data[idx])
        i = i + 1
    out

// rb2_clear: logically empties the buffer (contents are left in place but
// no longer reachable through head/tail/size — the next pushes overwrite
// them naturally).
fn rb2_clear(buf) -> dict
    buf["head"] = 0
    buf["tail"] = 0
    buf["size"] = 0
    buf

// ============================================================================
fn main()
    print("std/collections/ring_buffer loaded")
