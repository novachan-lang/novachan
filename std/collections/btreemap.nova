// btreemap — sorted string-keyed map with floor/ceiling queries.
//
// Representation (a plain NOVA dict):
//   "keys" -> list  (sorted ascending list of string keys)
//   "data" -> dict  (key -> value storage)
//
// Public API
//   bt_new()              -> btreemap
//   bt_set(bt, k, v)      -> unit  (insert or update; keys list stays sorted)
//   bt_get(bt, k)         -> value (or null if absent)
//   bt_has(bt, k)         -> int   (1 if present, 0 otherwise)
//   bt_keys(bt)           -> list  (sorted key list, direct reference)
//   bt_len(bt)            -> int
//   bt_floor(bt, k)       -> string  (largest key <= k, or "" if none)
//   bt_ceiling(bt, k)     -> string  (smallest key >= k, or "" if none)

// _bt_bisect_left: leftmost index i such that keys[i] >= k.
// If all keys < k, returns len(keys).
fn _bt_bisect_left(ks, k)
    let lo = 0
    let hi = len(ks)
    while lo < hi
        let mid = (lo + hi) / 2
        if ks[mid] < k
            lo = mid + 1
        else
            hi = mid
    return lo

fn bt_new()
    let bt = {}
    bt["keys"] = []
    bt["data"] = {}
    return bt

fn bt_set(bt, k, v)
    let data = bt["data"]
    let ks = bt["keys"]
    if contains(data, k)
        data[k] = v
    else
        let idx = _bt_bisect_left(ks, k)
        insert(ks, idx, k)
        data[k] = v

fn bt_get(bt, k)
    let data = bt["data"]
    if contains(data, k)
        return data[k]
    return null

fn bt_has(bt, k)
    let data = bt["data"]
    if contains(data, k)
        return 1
    return 0

fn bt_keys(bt)
    return bt["keys"]

fn bt_len(bt)
    return len(bt["keys"])

// bt_floor: largest key <= k, or "" if none.
fn bt_floor(bt, k)
    let ks = bt["keys"]
    let n = len(ks)
    if n == 0
        return ""
    // bisect_right for k: first index where ks[i] > k
    let lo = 0
    let hi = n
    while lo < hi
        let mid = (lo + hi) / 2
        if ks[mid] <= k
            lo = mid + 1
        else
            hi = mid
    // lo = number of keys <= k
    if lo == 0
        return ""
    return ks[lo - 1]

// bt_ceiling: smallest key >= k, or "" if none.
fn bt_ceiling(bt, k)
    let ks = bt["keys"]
    let n = len(ks)
    if n == 0
        return ""
    let idx = _bt_bisect_left(ks, k)
    if idx >= n
        return ""
    return ks[idx]
