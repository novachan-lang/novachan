// minmaxheap — double-ended min-max heap (Atkinson et al. 1986).
//
// Array-backed heap where levels alternate between min-levels and max-levels.
// Level of index i = floor(log2(i+1)). Levels 0,2,4,... are min-levels;
// levels 1,3,5,... are max-levels.
//
// Key properties (all guaranteed by the heap invariant):
//   - Every element on a min-level is <= all its descendants.
//   - Every element on a max-level is >= all its descendants.
//   - items[0] is always the global minimum.
//   - The global maximum is items[1] or items[2] (the first max-level nodes).
//
// Complexities: find-min O(1), find-max O(1), push O(log n),
//               pop-min O(log n), pop-max O(log n).
//
// Representation (dict for reference semantics):
//   "items" -> list
//
// Public API
//   mmh_new()         -> heap dict (empty)
//   mmh_push(h, v)    -> unit  (insert v; O(log n))
//   mmh_min(h)        -> int   (find minimum without removing; null if empty)
//   mmh_max(h)        -> int   (find maximum without removing; null if empty)
//   mmh_pop_min(h)    -> int   (remove+return minimum; null if empty)
//   mmh_pop_max(h)    -> int   (remove+return maximum; null if empty)
//   mmh_size(h)       -> int

// _mmh_level: floor(log2(i+1)) — the level in the heap tree of index i.
// Level 0 = root (min-level). Computed by right-shifting until zero.
fn _mmh_level(i)
    let v = i + 1
    let lvl = 0
    v = v / 2
    while v > 0
        lvl = lvl + 1
        v = v / 2
    return lvl

// _mmh_is_min_level: 1 if index i sits on an even (min) level, 0 otherwise.
fn _mmh_is_min_level(i)
    let lv = _mmh_level(i)
    let half = lv / 2
    if lv == half * 2
        return 1
    return 0

// _mmh_swap: swap items[a] and items[b] in-place.
fn _mmh_swap(items, a, b)
    let tmp = items[a]
    items[a] = items[b]
    items[b] = tmp

// _mmh_gp: return grandparent index of i.
// Requires i >= 3 (otherwise undefined). Caller must guard with _mmh_has_gp.
fn _mmh_gp(i)
    let par = (i - 1) / 2
    return (par - 1) / 2

// _mmh_has_gp: 1 if index i has a grandparent (i >= 3), 0 otherwise.
fn _mmh_has_gp(i)
    if i >= 3
        return 1
    return 0

// _mmh_sift_up_min: sift element at min-level index i upward along min-levels.
// Repeatedly compare with grandparent (also on a min-level); swap if smaller.
fn _mmh_sift_up_min(items, i)
    let done = 0
    while done == 0
        if _mmh_has_gp(i) == 0
            done = 1
        else
            let gp = _mmh_gp(i)
            if items[i] < items[gp]
                _mmh_swap(items, i, gp)
                i = gp
            else
                done = 1
    return null

// _mmh_sift_up_max: sift element at max-level index i upward along max-levels.
// Repeatedly compare with grandparent (also on a max-level); swap if larger.
fn _mmh_sift_up_max(items, i)
    let done = 0
    while done == 0
        if _mmh_has_gp(i) == 0
            done = 1
        else
            let gp = _mmh_gp(i)
            if items[i] > items[gp]
                _mmh_swap(items, i, gp)
                i = gp
            else
                done = 1
    return null

// _mmh_sift_up: sift element at index i up from its current position.
// First determine if it violates its parent (cross-level), then sift along
// same-level grandparents.
fn _mmh_sift_up(items, i)
    if i == 0
        return null
    let par = (i - 1) / 2
    let on_min = _mmh_is_min_level(i)
    if on_min == 1
        // Min-level node should be <= its parent (which is on a max-level).
        if items[i] > items[par]
            _mmh_swap(items, i, par)
            _mmh_sift_up_max(items, par)
        else
            _mmh_sift_up_min(items, i)
    else
        // Max-level node should be >= its parent (which is on a min-level).
        if items[i] < items[par]
            _mmh_swap(items, i, par)
            _mmh_sift_up_min(items, par)
        else
            _mmh_sift_up_max(items, i)
    return null

// _mmh_min_desc: return index of smallest child or grandchild of m in [0,n),
// or -1 if m is a leaf.
fn _mmh_min_desc(items, m, n)
    let best = -1
    let lc = 2 * m + 1
    let rc = 2 * m + 2
    if lc < n
        best = lc
    if rc < n
        if best == -1
            best = rc
        else
            if items[rc] < items[best]
                best = rc
    // Grandchildren: children of lc and rc.
    if lc < n
        let gc1 = 2 * lc + 1
        let gc2 = 2 * lc + 2
        if gc1 < n
            if best == -1
                best = gc1
            else
                if items[gc1] < items[best]
                    best = gc1
        if gc2 < n
            if best == -1
                best = gc2
            else
                if items[gc2] < items[best]
                    best = gc2
    if rc < n
        let gc3 = 2 * rc + 1
        let gc4 = 2 * rc + 2
        if gc3 < n
            if best == -1
                best = gc3
            else
                if items[gc3] < items[best]
                    best = gc3
        if gc4 < n
            if best == -1
                best = gc4
            else
                if items[gc4] < items[best]
                    best = gc4
    return best

// _mmh_max_desc: return index of largest child or grandchild of m in [0,n),
// or -1 if m is a leaf.
fn _mmh_max_desc(items, m, n)
    let best = -1
    let lc = 2 * m + 1
    let rc = 2 * m + 2
    if lc < n
        best = lc
    if rc < n
        if best == -1
            best = rc
        else
            if items[rc] > items[best]
                best = rc
    // Grandchildren.
    if lc < n
        let gc1 = 2 * lc + 1
        let gc2 = 2 * lc + 2
        if gc1 < n
            if best == -1
                best = gc1
            else
                if items[gc1] > items[best]
                    best = gc1
        if gc2 < n
            if best == -1
                best = gc2
            else
                if items[gc2] > items[best]
                    best = gc2
    if rc < n
        let gc3 = 2 * rc + 1
        let gc4 = 2 * rc + 2
        if gc3 < n
            if best == -1
                best = gc3
            else
                if items[gc3] > items[best]
                    best = gc3
        if gc4 < n
            if best == -1
                best = gc4
            else
                if items[gc4] > items[best]
                    best = gc4
    return best

// _mmh_sift_down_min: sift the element at min-level index m downward.
// Finds smallest descendant; if smaller than m, swap; if it's a grandchild,
// also check against its parent (a max-level node).
fn _mmh_sift_down_min(items, m, n)
    let done = 0
    while done == 0
        let i = _mmh_min_desc(items, m, n)
        if i == -1
            done = 1
        else
            if items[i] < items[m]
                _mmh_swap(items, i, m)
                // Determine if i is a grandchild of m.
                let lc = 2 * m + 1
                let rc = 2 * m + 2
                let is_gc = 0
                if i != lc and i != rc
                    is_gc = 1
                if is_gc == 1
                    // i is a grandchild: it may now violate its parent (max-level).
                    let par_i = (i - 1) / 2
                    if items[i] > items[par_i]
                        _mmh_swap(items, i, par_i)
                    m = i
                else
                    done = 1
            else
                done = 1
    return null

// _mmh_sift_down_max: sift the element at max-level index m downward.
// Finds largest descendant; if larger than m, swap; if grandchild, check parent.
fn _mmh_sift_down_max(items, m, n)
    let done = 0
    while done == 0
        let i = _mmh_max_desc(items, m, n)
        if i == -1
            done = 1
        else
            if items[i] > items[m]
                _mmh_swap(items, i, m)
                let lc = 2 * m + 1
                let rc = 2 * m + 2
                let is_gc = 0
                if i != lc and i != rc
                    is_gc = 1
                if is_gc == 1
                    let par_i = (i - 1) / 2
                    if items[i] < items[par_i]
                        _mmh_swap(items, i, par_i)
                    m = i
                else
                    done = 1
            else
                done = 1
    return null

// _mmh_max_idx: return index of the maximum element.
// Max is at index 1 or 2 (whichever is larger); or 0 if only one element.
fn _mmh_max_idx(items, n)
    if n == 1
        return 0
    if n == 2
        return 1
    if items[1] >= items[2]
        return 1
    return 2

// mmh_new: create and return an empty min-max heap.
fn mmh_new()
    let h = {}
    h["items"] = []
    return h

// mmh_push: insert value v into the min-max heap in O(log n).
fn mmh_push(h, v)
    let items = h["items"]
    items.push(v)
    let i = len(items) - 1
    _mmh_sift_up(items, i)

// mmh_min: return the minimum element without removing it. O(1).
// Returns null if the heap is empty.
fn mmh_min(h)
    let items = h["items"]
    if len(items) == 0
        return null
    return items[0]

// mmh_max: return the maximum element without removing it. O(1).
// Returns null if the heap is empty.
fn mmh_max(h)
    let items = h["items"]
    let n = len(items)
    if n == 0
        return null
    let mi = _mmh_max_idx(items, n)
    return items[mi]

// mmh_pop_min: remove and return the minimum element in O(log n).
// Returns null if the heap is empty.
fn mmh_pop_min(h)
    let items = h["items"]
    let n = len(items)
    if n == 0
        return null
    let min_val = items[0]
    if n == 1
        items.pop()
        return min_val
    // Replace root with last element, shrink, then sift down on min-level.
    let last = items.pop()
    items[0] = last
    _mmh_sift_down_min(items, 0, len(items))
    return min_val

// mmh_pop_max: remove and return the maximum element in O(log n).
// Returns null if the heap is empty.
fn mmh_pop_max(h)
    let items = h["items"]
    let n = len(items)
    if n == 0
        return null
    let mi = _mmh_max_idx(items, n)
    let max_val = items[mi]
    if n == 1
        items.pop()
        return max_val
    // Replace max position with last element, shrink, then sift down on max-level.
    let last = items.pop()
    let n2 = len(items)
    if mi >= n2
        // The max happened to be the last element already removed by pop.
        return max_val
    items[mi] = last
    _mmh_sift_down_max(items, mi, n2)
    return max_val

// mmh_size: return the number of elements in the heap.
fn mmh_size(h)
    return len(h["items"])
