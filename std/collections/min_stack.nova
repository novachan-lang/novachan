// min_stack — Stack with O(1) minimum and maximum tracking.
//
// Representation (dict):
//   "vals" -> list: the main stack of values (bottom=index 0, top=last)
//   "mins" -> list: parallel min-tracking stack; mins[i] = min of vals[0..i]
//   "maxs" -> list: parallel max-tracking stack; maxs[i] = max of vals[0..i]
//
// All three lists are kept in sync: push/pop touch all three atomically.
// mns_min / mns_max are O(1) reads of the top of mins/maxs.

// mns_make() -> a new empty min-stack.
fn mns_make()
    return {"vals": [], "mins": [], "maxs": []}

// mns_push(s, x) — push x onto the stack; update min and max tracking.
fn mns_push(s, x)
    let vals = s["vals"]
    let mins = s["mins"]
    let maxs = s["maxs"]
    vals.push(x)
    let n = len(mins)
    if n == 0
        mins.push(x)
        maxs.push(x)
    else
        let cur_min = mins[n - 1]
        let cur_max = maxs[n - 1]
        mins.push(x if x < cur_min else cur_min)
        maxs.push(x if x > cur_max else cur_max)

// mns_pop(s) -> int: remove and return the top element; returns null if empty.
fn mns_pop(s)
    let vals = s["vals"]
    let mins = s["mins"]
    let maxs = s["maxs"]
    let n = len(vals)
    if n == 0
        return null
    let v = vals.pop()
    mins.pop()
    maxs.pop()
    return v

// mns_top(s) -> int: return the top element without removing it; null if empty.
fn mns_top(s)
    let vals = s["vals"]
    let n = len(vals)
    if n == 0
        return null
    return vals[n - 1]

// mns_min(s) -> int: the minimum value currently on the stack; null if empty.
fn mns_min(s)
    let mins = s["mins"]
    let n = len(mins)
    if n == 0
        return null
    return mins[n - 1]

// mns_max(s) -> int: the maximum value currently on the stack; null if empty.
fn mns_max(s)
    let maxs = s["maxs"]
    let n = len(maxs)
    if n == 0
        return null
    return maxs[n - 1]

// mns_size(s) -> int: number of elements currently on the stack.
fn mns_size(s)
    return len(s["vals"])

// mns_is_empty(s) -> bool (1 if empty, 0 otherwise).
fn mns_is_empty(s)
    len(s["vals"]) == 0
