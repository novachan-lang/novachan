// fenwick2d — 2D Binary Indexed Tree (Fenwick Tree) for 1-indexed 2D prefix sums.
//
// Representation: a dict with keys:
//   "a"    -> flat list of ints, length (rows+1)*(cols+1); 1-indexed in both dims
//   "rows" -> int (logical row count)
//   "cols" -> int (logical col count)
//   "c1"   -> int (cols+1, stride for flat index)
//
// Flat index of BIT cell (r, c): (r * c1) + c  where c1 = cols+1
// All row and column indices are 1-based (standard BIT convention).
//
// Time complexity: O(log(rows) * log(cols)) for update and query.

// f2d_idx — private helper: flat array index for BIT cell (r, c).
fn f2d_idx(r, c, c1)
    return r * c1 + c

// f2_new(rows, cols) -> a new 2D Fenwick tree over rows x cols cells, all zero.
fn f2_new(rows, cols)
    let c1 = cols + 1
    let total = (rows + 1) * c1
    let a = []
    let i = 0
    while i < total
        a.push(0)
        i = i + 1
    let t = {}
    t["a"] = a
    t["rows"] = rows
    t["cols"] = cols
    t["c1"] = c1
    return t

// f2_update(t, r, c, delta) — add delta to cell (r, c); 1-indexed.
// Propagates through all ancestor BIT nodes in both dimensions.
fn f2_update(t, r, c, delta)
    let a = t["a"]
    let rows = t["rows"]
    let cols = t["cols"]
    let c1 = t["c1"]
    let yr = r
    while yr <= rows
        let yc = c
        while yc <= cols
            let idx = f2d_idx(yr, yc, c1)
            a[idx] = a[idx] + delta
            let lsbc = yc & (0 - yc)
            yc = yc + lsbc
        let lsbr = yr & (0 - yr)
        yr = yr + lsbr

// f2_query(t, r, c) -> int: prefix sum over rectangle rows 1..r, cols 1..c.
fn f2_query(t, r, c)
    let a = t["a"]
    let c1 = t["c1"]
    let s = 0
    let yr = r
    while yr > 0
        let yc = c
        while yc > 0
            let idx = f2d_idx(yr, yc, c1)
            s = s + a[idx]
            let lsbc = yc & (0 - yc)
            yc = yc - lsbc
        let lsbr = yr & (0 - yr)
        yr = yr - lsbr
    return s

// f2_range(t, r1, c1, r2, c2) -> int: sum over rectangle rows r1..r2, cols c1..c2.
// Uses standard 2D inclusion-exclusion on prefix queries.
fn f2_range(t, r1, c1, r2, c2)
    let a1 = f2_query(t, r2, c2)
    let a2 = f2_query(t, r1 - 1, c2)
    let a3 = f2_query(t, r2, c1 - 1)
    let a4 = f2_query(t, r1 - 1, c1 - 1)
    return a1 - a2 - a3 + a4
