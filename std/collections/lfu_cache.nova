// lfu_cache — Least Frequently Used cache with LRU tie-breaking (the standard
// O(1) LFU design: a frequency->bucket map of doubly-linked-list-style lists,
// here plain NOVA lists since capacities are small enough that the O(n)
// remove-by-value inside a single bucket is not the bottleneck).
//
// Every resident key has an access frequency (starts at 1 on insert, +1 on
// every subsequent get or re-put). On overflow the key with the SMALLEST
// frequency is evicted; ties are broken by recency — the least-recently-used
// key within that frequency bucket goes first.
//
// Representation (dict c):
//   "cap"     -> int capacity
//   "size"    -> int current resident count
//   "minfreq" -> int smallest frequency currently in use (0 when empty)
//   "data"    -> dict str(key) -> stored value
//   "freq"    -> dict str(key) -> current frequency (int >= 1)
//   "buckets" -> dict str(frequency) -> list of str(key), LRU-first, holding
//                every key currently at that exact frequency
//
// Public API:
//   lfu_new(capacity)    -> dict
//   lfu_get(c, key)      -> any (cached value, or 0 on miss; bumps frequency)
//   lfu_put(c, key, val) -> dict (insert/update; evicts on overflow)
//   lfu_size(c)          -> int

// lfu_new: create a new empty LFU cache with the given capacity.
fn lfu_new(capacity)
    let c = {}
    c["cap"] = capacity
    c["size"] = 0
    c["minfreq"] = 0
    c["data"] = {}
    c["freq"] = {}
    c["buckets"] = {}
    return c

// _lfu_bump: move key k (already resident, k = str(original key)) from its
// current frequency bucket to the next one up, incrementing its frequency
// and keeping minfreq correct.
fn _lfu_bump(c, k)
    let freq = c["freq"]
    let buckets = c["buckets"]
    let f = freq[k]
    let old_bucket = buckets[str(f)]
    remove(old_bucket, k)
    if len(old_bucket) == 0
        if c["minfreq"] == f
            c["minfreq"] = f + 1
    let nf = f + 1
    freq[k] = nf
    let nk = str(nf)
    if not contains(buckets, nk)
        buckets[nk] = []
    buckets[nk].push(k)

// lfu_get: return the cached value for key, or 0 on a miss. Bumps frequency
// on a hit.
fn lfu_get(c, key)
    let k = str(key)
    let data = c["data"]
    if not contains(data, k)
        return 0
    _lfu_bump(c, k)
    return data[k]

// lfu_put: insert or update key -> val. On a miss when the cache is already
// at capacity, evicts the minimum-frequency, least-recently-used entry first.
fn lfu_put(c, key, val)
    let cap = c["cap"]
    if cap <= 0
        return c
    let k = str(key)
    let data = c["data"]
    if contains(data, k)
        data[k] = val
        _lfu_bump(c, k)
        return c
    if c["size"] >= cap
        let buckets = c["buckets"]
        let mf = c["minfreq"]
        let bucket = buckets[str(mf)]
        let evict = bucket[0]
        remove(bucket, evict)
        del(data, evict)
        del(c["freq"], evict)
        c["size"] = c["size"] - 1
    data[k] = val
    c["freq"][k] = 1
    let buckets2 = c["buckets"]
    if not contains(buckets2, "1")
        buckets2["1"] = []
    buckets2["1"].push(k)
    c["minfreq"] = 1
    c["size"] = c["size"] + 1
    return c

// lfu_size: number of resident items.
fn lfu_size(c)
    return c["size"]
