// pairingheap — Pairing heap (min-heap of ints).
//
// A pairing heap is a simple, efficient heap that achieves amortised
// O(log n) delete-min and O(1) insert via a "meld" primitive.
//
// Node representation:
//   {"k": int, "children": [list of child nodes]}
// Heap wrapper:
//   {"root": node|null, "size": int}
//
// Meld rule: compare root keys; attach the larger-rooted heap as the
// first child of the smaller-rooted heap.
//
// delete_min two-pass strategy:
//   1. Remove root; collect its children list C.
//   2. Left-to-right: pair adjacent children (meld C[0]+C[1], C[2]+C[3], …).
//   3. Right-to-left: fold the resulting pairs via meld.
//
// Public API:
//   ph_new()          -> heap dict
//   ph_insert(h, key) -> unit
//   ph_find_min(h)    -> int   (undefined on empty heap)
//   ph_delete_min(h)  -> int   (remove+return min; undefined on empty)
//   ph_size(h)        -> int
//   ph_is_empty(h)    -> bool

// _ph_node: create a new single-element node.
fn _ph_node(key)
    let nd = {}
    nd["k"] = key
    nd["children"] = []
    return nd

// _ph_meld: meld two non-null heap nodes; returns the new root node.
// The smaller root wins; the loser becomes its new first child.
fn _ph_meld(a, b)
    let ak = a["k"]
    let bk = b["k"]
    if ak <= bk
        // a wins: prepend b to a's children
        let ch = a["children"]
        let new_ch = []
        new_ch.push(b)
        let i = 0
        let n = len(ch)
        while i < n
            let ci = ch[i]
            new_ch.push(ci)
            i = i + 1
        a["children"] = new_ch
        return a
    else
        // b wins: prepend a to b's children
        let ch = b["children"]
        let new_ch = []
        new_ch.push(a)
        let i = 0
        let n = len(ch)
        while i < n
            let ci = ch[i]
            new_ch.push(ci)
            i = i + 1
        b["children"] = new_ch
        return b

// _ph_two_pass: perform the two-pass pairing merge on a list of nodes.
// Returns the resulting single node (the new min), or null if list is empty.
fn _ph_two_pass(nodes)
    let n = len(nodes)
    if n == 0
        return null
    if n == 1
        return nodes[0]
    // Pass 1: pair adjacent nodes left-to-right into a pairs list.
    let pairs = []
    let i = 0
    while i < n
        let left_done = 0
        if i + 1 < n
            let a = nodes[i]
            let b = nodes[i + 1]
            let m = _ph_meld(a, b)
            pairs.push(m)
            i = i + 2
            left_done = 1
        if left_done == 0
            // Odd element out: carry it forward unpaired.
            pairs.push(nodes[i])
            i = i + 1
    // Pass 2: fold pairs right-to-left.
    let np = len(pairs)
    let acc = pairs[np - 1]
    let j = np - 2
    while j >= 0
        let pj = pairs[j]
        acc = _ph_meld(pj, acc)
        j = j - 1
    return acc

// ph_new: create an empty pairing heap.
fn ph_new()
    let h = {}
    h["root"] = null
    h["size"] = 0
    return h

// ph_insert: insert key into heap h.
fn ph_insert(h, key)
    let nd = _ph_node(key)
    let r = h["root"]
    if r == null
        h["root"] = nd
    else
        h["root"] = _ph_meld(r, nd)
    h["size"] = h["size"] + 1
    return 0

// ph_find_min: return the minimum key without removing it.
// Precondition: heap is non-empty.
fn ph_find_min(h)
    let r = h["root"]
    return r["k"]

// ph_delete_min: remove and return the minimum key.
// Precondition: heap is non-empty.
fn ph_delete_min(h)
    let r = h["root"]
    let min_k = r["k"]
    let ch = r["children"]
    h["root"] = _ph_two_pass(ch)
    h["size"] = h["size"] - 1
    return min_k

// ph_size: return the number of elements in the heap.
fn ph_size(h)
    return h["size"]

// ph_is_empty: return true (1) if heap is empty, false (0) otherwise.
fn ph_is_empty(h)
    let sz = h["size"]
    if sz == 0
        return 1
    return 0
