// bloomfilter — probabilistic set membership (Bloom filter).
//
// Representation: a dict with three fields:
//   "bits"  — flat list of nbits integers, each 0 or 1 (the bit array)
//   "nbits" — total number of bit slots
//   "k"     — number of hash probes per item
//
// Double-hashing scheme:
//   h1 = FNV-1a variant over ord(char_at(s,i)) & 0xFFFFFFFF
//   h2 = djb2   variant over ord(char_at(s,i)) & 0xFFFFFFFF
//   probe j (0..k-1): bit_index = (h1 + j * h2) mod nbits
//
// Bloom filters NEVER produce false negatives: if a string was added,
// bf_maybe always returns true. They may produce false positives (a string
// that was never added can appear present), but at large nbits the FP rate
// is negligible (< 0.01% at nbits=2048, k=4, n<=50 items).

// FNV-1a variant: initialise at FNV_OFFSET_BASIS, accumulate via
// h = (h * FNV_PRIME + byte) & 0xFFFFFFFF  for each character.
fn _bf_h1(s: string) -> int
    let h = 2166136261
    let i = 0
    let n = len(s)
    while i < n
        h = (h * 16777619 + ord(char_at(s, i))) & 0xFFFFFFFF
        i = i + 1
    return h

// djb2 variant: initialise at 5381, accumulate via
// h = (h * 33 + byte) & 0xFFFFFFFF  for each character.
fn _bf_h2(s: string) -> int
    let h = 5381
    let i = 0
    let n = len(s)
    while i < n
        h = (h * 33 + ord(char_at(s, i))) & 0xFFFFFFFF
        i = i + 1
    return h

// Create a new Bloom filter with `nbits` bit slots and `k` hash probes.
// All bits start at 0.
fn bf_new(nbits: int, k: int) -> dict
    let bits = []
    let i = 0
    while i < nbits
        push(bits, 0)
        i = i + 1
    let bf = {}
    bf["bits"] = bits
    bf["nbits"] = nbits
    bf["k"] = k
    return bf

// Add string `s` to the Bloom filter. Sets k bit positions derived from s.
// Mutates `bf` in place (the bits list is a reference type).
fn bf_add(bf: dict, s: string)
    let h1 = _bf_h1(s)
    let h2 = _bf_h2(s)
    let nbits = bf["nbits"]
    let k = bf["k"]
    let bits = bf["bits"]
    let j = 0
    while j < k
        let idx = (h1 + j * h2) % nbits
        bits[idx] = 1
        j = j + 1

// Query whether `s` might be in the filter. Returns true if ALL k probed
// bits are 1 (possible member or false positive). Returns false if ANY bit
// is 0 (definite non-member — no false negatives possible).
fn bf_maybe(bf: dict, s: string) -> bool
    let h1 = _bf_h1(s)
    let h2 = _bf_h2(s)
    let nbits = bf["nbits"]
    let k = bf["k"]
    let bits = bf["bits"]
    let j = 0
    while j < k
        let idx = (h1 + j * h2) % nbits
        if bits[idx] == 0
            return false
        j = j + 1
    return true
