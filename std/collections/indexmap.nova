// indexmap — insertion-ordered map with O(1) key lookup and O(n) positional access.
//
// Representation (a plain NOVA dict):
//   "keys" -> list  (insertion-ordered list of string keys; no duplicates)
//   "data" -> dict  (k -> v, the actual key/value store)
//
// Public API
//   im_new()              -> indexmap
//   im_set(im, k, v)      -> unit  (append k on first insert; keep position on re-set)
//   im_get(im, k)         -> value or null if absent
//   im_has(im, k)         -> 1 if present, 0 otherwise
//   im_len(im)            -> number of entries
//   im_keys(im)           -> list of keys in insertion order
//   im_key_at(im, i)      -> the i-th inserted key (0-based)
//   im_value_at(im, i)    -> the value of the i-th inserted key
//   im_index_of(im, k)    -> insertion-order index of k, or -1 if absent

fn im_new()
    let im = {}
    im["keys"] = []
    im["data"] = {}
    return im

// im_set: insert k->v preserving insertion order; re-set updates value, keeps position.
fn im_set(im, k, v)
    let data = im["data"]
    let keys = im["keys"]
    if contains(data, k)
        data[k] = v
    else
        data[k] = v
        keys.push(k)

// im_get: return value for k, or null if absent.
fn im_get(im, k)
    let data = im["data"]
    if contains(data, k)
        return data[k]
    return null

// im_has: 1 if k is present, 0 otherwise.
fn im_has(im, k)
    let data = im["data"]
    if contains(data, k)
        return 1
    return 0

// im_len: number of entries.
fn im_len(im)
    return len(im["keys"])

// im_keys: list of keys in insertion order.
fn im_keys(im)
    return im["keys"]

// im_key_at: return the i-th inserted key (0-based).
fn im_key_at(im, i)
    let keys = im["keys"]
    return keys[i]

// im_value_at: return the value of the i-th inserted key.
fn im_value_at(im, i)
    let keys = im["keys"]
    let data = im["data"]
    return data[keys[i]]

// im_index_of: return the insertion-order index of k, or -1 if absent.
fn im_index_of(im, k)
    let keys = im["keys"]
    let n = len(keys)
    let i = 0
    while i < n
        if keys[i] == k
            return i
        i = i + 1
    return -1
