// maxheap — array-based binary MAX-heap (complement of binaryheap.nova's MIN-heap).
//
// Represented directly as a plain NOVA list (not wrapped in a dict): items[0]
// is always the largest element. This matches the specified API where the
// heap value itself is threaded through every call and returned again.
//
// Heap invariant: items[i] >= items[2*i+1] and items[i] >= items[2*i+2]
// (every parent is >= both its children).
//
// Public API
//   mxh_new()      -> list (empty heap)
//   mxh_push(h, v) -> list (insert v; returns h)
//   mxh_pop(h)     -> list ([max_val, updated_heap]; [-1, h] on empty)
//   mxh_peek(h)    -> int  (max value without removing; -1 if empty)
//   mxh_size(h)    -> int

// _mxh_swap: swap h[a] and h[b] in-place.
fn _mxh_swap(h, a, b)
    let tmp = h[a]
    h[a] = h[b]
    h[b] = tmp

// _mxh_sift_up: move element at index i toward the root until heap property holds.
fn _mxh_sift_up(h, i)
    let done = 0
    while i > 0 and done == 0
        let parent = (i - 1) / 2
        if h[i] > h[parent]
            _mxh_swap(h, i, parent)
            i = parent
        else
            done = 1

// _mxh_sift_down: move element at index i toward leaves until heap property holds.
fn _mxh_sift_down(h, i, n)
    let done = 0
    while done == 0
        let largest = i
        let left = 2 * i + 1
        let right = 2 * i + 2
        if left < n
            if h[left] > h[largest]
                largest = left
        if right < n
            if h[right] > h[largest]
                largest = right
        if largest == i
            done = 1
        else
            _mxh_swap(h, i, largest)
            i = largest

// mxh_new: create and return an empty max-heap.
fn mxh_new()
    return []

// mxh_push: insert value v into the heap in O(log n). Returns h.
fn mxh_push(h, v)
    h.push(v)
    _mxh_sift_up(h, len(h) - 1)
    return h

// mxh_pop: remove and return [max_val, h] in O(log n). Returns [-1, h] if empty.
fn mxh_pop(h)
    let n = len(h)
    let r = []
    if n == 0
        r.push(-1)
        r.push(h)
        return r
    let max_val = h[0]
    if n == 1
        h.pop()
        r.push(max_val)
        r.push(h)
        return r
    let last = h.pop()
    h[0] = last
    _mxh_sift_down(h, 0, len(h))
    r.push(max_val)
    r.push(h)
    return r

// mxh_peek: return the max value without removing it. -1 if empty.
fn mxh_peek(h)
    if len(h) == 0
        return -1
    return h[0]

// mxh_size: number of elements in the heap.
fn mxh_size(h)
    return len(h)
