// binomialheap — Binomial min-heap (mergeable heap; forest of binomial trees).
//
// A binomial heap is a forest of binomial trees ordered by degree.
// Tree B_k has degree k, contains 2^k nodes, and its root has k children
// (B_0, B_1, ..., B_{k-1}). Heap invariant: each node key <= all descendants.
//
// Representation:
//   heap  = list of root nodes, in STRICTLY INCREASING order of degree.
//           At most one tree of each degree (binary number representation).
//   node  = dict {"key": int, "degree": int, "children": [list of child nodes]}
//           children ordered by DECREASING degree so linking appends correctly.
//
// Operations:
//   Merge:      O(log n)  — like adding two binary numbers with carry
//   Insert:     amortised O(1)
//   Find-min:   O(log n)  — scan roots
//   Delete-min: O(log n)
//
// Public API:
//   bnh_new()             -> heap (empty list)
//   bnh_insert(h, v)      -> heap (new heap with v inserted)
//   bnh_find_min(h)       -> int | null
//   bnh_delete_min(h)     -> heap
//   bnh_merge(a, b)       -> heap
//   bnh_to_sorted(h)      -> list (ascending; non-destructive)

// _bnh_node: create a single B_0 node (degree 0, no children).
fn _bnh_node(key)
    let nd = {}
    nd["key"] = key
    nd["degree"] = 0
    nd["children"] = []
    return nd

// _bnh_link: link two binomial trees of equal degree k; returns B_{k+1} root.
// The larger-key root becomes a child of the smaller-key root.
fn _bnh_link(t1, t2)
    let k1 = t1["key"]
    let k2 = t2["key"]
    if k1 <= k2
        let ch = t1["children"]
        ch.push(t2)
        t1["degree"] = t1["degree"] + 1
        return t1
    else
        let ch = t2["children"]
        ch.push(t1)
        t2["degree"] = t2["degree"] + 1
        return t2

// _bnh_interleave: merge two degree-sorted root lists into one sorted list
// (may contain duplicates in degree — carry resolution done separately).
fn _bnh_interleave(a, b)
    let out = []
    let ia = 0
    let ib = 0
    let na = len(a)
    let nb = len(b)
    while ia < na and ib < nb
        let da = a[ia]["degree"]
        let db = b[ib]["degree"]
        if da <= db
            out.push(a[ia])
            ia = ia + 1
        else
            out.push(b[ib])
            ib = ib + 1
    while ia < na
        out.push(a[ia])
        ia = ia + 1
    while ib < nb
        out.push(b[ib])
        ib = ib + 1
    return out

// _bnh_consolidate: given a sorted (possibly dup-degree) list of nodes,
// link equal-degree trees (carry propagation) and return a clean heap forest.
// Uses a queue-index approach: we scan left-to-right; whenever two adjacent
// nodes have equal degree we link them and place the result back to be
// reconsidered against the node that follows.
fn _bnh_consolidate(raw)
    let n = len(raw)
    if n == 0
        return []
    // Copy raw into a working queue.
    let q = []
    let i = 0
    while i < n
        q.push(raw[i])
        i = i + 1
    // Walk the queue; use an output list.
    let out = []
    let qi = 0
    while qi < len(q)
        let cur = q[qi]
        qi = qi + 1
        // Peek at next in queue.
        if qi < len(q)
            let nxt = q[qi]
            if cur["degree"] == nxt["degree"]
                // Link them; push result back into queue for re-examination.
                qi = qi + 1
                let linked = _bnh_link(cur, nxt)
                // Insert linked back at the current position in a mini-buffer.
                // We push to out only when we know there's no equal-degree successor.
                // Simplest: recurse once by building a new smaller queue.
                // Instead: emit everything processed so far, then consolidate remaining.
                // Actually: just push linked to out and let a second pass handle carries.
                // Binomial merge has at most 2 equal-degree trees at any step,
                // so we need at most one extra pass. We'll do a two-pass approach.
                out.push(linked)
            else
                out.push(cur)
        else
            out.push(cur)
    // Check if any adjacent pair in out still has equal degree (can happen with 3 equal).
    // Do a second consolidation pass.
    let changed = 1
    while changed == 1
        changed = 0
        let out2 = []
        let j = 0
        while j < len(out)
            if j + 1 < len(out)
                let a2 = out[j]
                let b2 = out[j + 1]
                if a2["degree"] == b2["degree"]
                    out2.push(_bnh_link(a2, b2))
                    j = j + 2
                    changed = 1
                else
                    out2.push(a2)
                    j = j + 1
            else
                out2.push(out[j])
                j = j + 1
        out = out2
    return out

// _bnh_merge_forests: merge two sorted root lists; returns a clean heap forest.
fn _bnh_merge_forests(a, b)
    let interleaved = _bnh_interleave(a, b)
    return _bnh_consolidate(interleaved)

// bnh_new: return an empty binomial heap (empty list of roots).
fn bnh_new()
    return []

// bnh_merge: merge two binomial heaps a and b; returns a new heap.
fn bnh_merge(a, b)
    return _bnh_merge_forests(a, b)

// bnh_insert: insert integer v into heap h; returns the new heap.
fn bnh_insert(h, v)
    let nd = _bnh_node(v)
    let singleton = []
    singleton.push(nd)
    return _bnh_merge_forests(h, singleton)

// bnh_find_min: return the minimum key across all roots; null if empty.
fn bnh_find_min(h)
    let n = len(h)
    if n == 0
        return null
    let min_val = h[0]["key"]
    let i = 1
    while i < n
        let k = h[i]["key"]
        if k < min_val
            min_val = k
        i = i + 1
    return min_val

// bnh_delete_min: remove the minimum element and return the new heap.
fn bnh_delete_min(h)
    let n = len(h)
    if n == 0
        return []
    // Find the root index with the minimum key.
    let min_idx = 0
    let min_key = h[0]["key"]
    let i = 1
    while i < n
        let k = h[i]["key"]
        if k < min_key
            min_key = k
            min_idx = i
        i = i + 1
    // Build remaining root list without the min-root tree.
    let remaining = []
    let j = 0
    while j < n
        if j == min_idx
            j = j + 1
        else
            remaining.push(h[j])
            j = j + 1
    // The children of the deleted root form a valid binomial heap.
    // Children are stored in DECREASING degree order (B_{k-1},...,B_0);
    // reverse to get increasing degree order for merge.
    let min_tree = h[min_idx]
    let ch = min_tree["children"]
    let nc = len(ch)
    let children_heap = []
    let k2 = nc - 1
    while k2 >= 0
        children_heap.push(ch[k2])
        k2 = k2 - 1
    return _bnh_merge_forests(remaining, children_heap)

// bnh_to_sorted: drain a heap into an ascending sorted list (non-destructive).
fn bnh_to_sorted(h)
    let out = []
    let cur = h
    let running = 1
    if len(cur) == 0
        running = 0
    while running == 1
        let m = bnh_find_min(cur)
        out.push(m)
        cur = bnh_delete_min(cur)
        if len(cur) == 0
            running = 0
    return out
