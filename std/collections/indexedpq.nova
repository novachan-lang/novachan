// indexedpq — Indexed Priority Queue (min), supporting O(log n) decrease-key by external index.
//
// Representation (all inside a single dict `pq`):
//   pq["size"]    int             — number of elements currently in the heap
//   pq["heap"]    list of int     — heap array; heap[0] holds the idx with minimum priority
//   pq["prio"]    dict str->int   — prio[str(idx)] = current priority of external index idx
//   pq["pos"]     dict str->int   — pos[str(idx)]  = current heap position; -1 = removed
//
// Heap invariant: prio[heap[i]] <= prio[heap[2*i+1]] and prio[heap[i]] <= prio[heap[2*i+2]]
//
// Membership: ipq_contains(pq,idx) checks pos key exists AND value >= 0.
// After ipq_pop_min, the popped idx has pos[str(idx)] set to -1 (sentinel).
//
// Public API:
//   ipq_new()                               -> pq dict (empty queue)
//   ipq_insert(pq, idx, priority)           -> inserts external idx with given int priority
//   ipq_contains(pq, idx)                   -> 1 if present, 0 otherwise
//   ipq_decrease_key(pq, idx, new_priority) -> reduces priority of idx; sifts up
//   ipq_pop_min(pq)                         -> external idx of min-priority element; null if empty
//   ipq_min_priority(pq)                    -> priority of min element; -1 if empty

// _ipq_swap: swap heap positions i and j and update pos reverse-map.
fn _ipq_swap(pq, i, j)
    let heap = pq["heap"]
    let pos = pq["pos"]
    let ai = heap[i]
    let aj = heap[j]
    heap[i] = aj
    heap[j] = ai
    pos[str(ai)] = j
    pos[str(aj)] = i

// _ipq_prio_at: priority of the element sitting at heap position i.
fn _ipq_prio_at(pq, i)
    let heap = pq["heap"]
    let prio = pq["prio"]
    return prio[str(heap[i])]

// _ipq_sift_up: restore heap property by moving position i toward the root.
fn _ipq_sift_up(pq, i)
    let done = 0
    while i > 0 and done == 0
        let parent = (i - 1) / 2
        if _ipq_prio_at(pq, i) < _ipq_prio_at(pq, parent)
            _ipq_swap(pq, i, parent)
            i = parent
        else
            done = 1

// _ipq_sift_down: restore heap property by moving position i toward the leaves.
fn _ipq_sift_down(pq, i)
    let sz = pq["size"]
    let done = 0
    while done == 0
        let smallest = i
        let left = 2 * i + 1
        let right = 2 * i + 2
        if left < sz
            if _ipq_prio_at(pq, left) < _ipq_prio_at(pq, smallest)
                smallest = left
        if right < sz
            if _ipq_prio_at(pq, right) < _ipq_prio_at(pq, smallest)
                smallest = right
        if smallest == i
            done = 1
        else
            _ipq_swap(pq, i, smallest)
            i = smallest

// ipq_new: create and return an empty indexed priority queue.
fn ipq_new()
    let pq = {}
    pq["size"] = 0
    pq["heap"] = []
    pq["prio"] = {}
    pq["pos"] = {}
    return pq

// ipq_insert: insert external index idx with given int priority.
// idx must not already be present.
fn ipq_insert(pq, idx, priority)
    let sz = pq["size"]
    let heap = pq["heap"]
    let prio = pq["prio"]
    let pos = pq["pos"]
    let k = str(idx)
    heap.push(idx)
    prio[k] = priority
    pos[k] = sz
    pq["size"] = sz + 1
    _ipq_sift_up(pq, sz)

// ipq_contains: 1 if idx is currently in the queue, 0 otherwise.
fn ipq_contains(pq, idx)
    let pos = pq["pos"]
    let k = str(idx)
    if contains(pos, k) == false
        return 0
    if pos[k] < 0
        return 0
    return 1

// ipq_decrease_key: reduce priority of idx to new_priority and restore heap property.
// Precondition: ipq_contains(pq, idx) and new_priority <= current priority.
fn ipq_decrease_key(pq, idx, new_priority)
    let prio = pq["prio"]
    let pos = pq["pos"]
    let k = str(idx)
    prio[k] = new_priority
    let i = pos[k]
    _ipq_sift_up(pq, i)

// ipq_pop_min: remove and return the external idx with the smallest priority.
// Returns null if the queue is empty.
fn ipq_pop_min(pq)
    let sz = pq["size"]
    if sz == 0
        return null
    let heap = pq["heap"]
    let pos = pq["pos"]
    let min_idx = heap[0]
    let mk = str(min_idx)
    pos[mk] = -1
    if sz == 1
        heap.pop()
        pq["size"] = 0
        return min_idx
    let last_idx = heap[sz - 1]
    let lk = str(last_idx)
    heap[0] = last_idx
    pos[lk] = 0
    heap.pop()
    pq["size"] = sz - 1
    _ipq_sift_down(pq, 0)
    return min_idx

// ipq_min_priority: priority of the minimum element; -1 if empty.
fn ipq_min_priority(pq)
    let sz = pq["size"]
    if sz == 0
        return -1
    let heap = pq["heap"]
    let prio = pq["prio"]
    let min_idx = heap[0]
    return prio[str(min_idx)]
