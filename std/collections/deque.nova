// deque — double-ended queue backed by a list, wrapped in a dict for
// reference semantics (mirrors std/collections/stack.nova's convention).
//
// Representation:
//   {"dq_items": []}   — dq_items[0] is the front, dq_items[len-1] is the back
//
// front-side operations (push_front/pop_front) rebuild the backing list via
// insert(...,0,...)/slice(...) — O(n) per call, same tradeoff CPython's
// list-based deque had before `collections.deque` existed. back-side
// operations (push_back/pop_back) are O(1) via the list's own push/pop.
// Callers on the hot path for front-heavy workloads should prefer a
// ring-buffer-style structure (std/collections/circularbuf.nova) instead.
//
// Public API
//   dq_new()             -> deque (empty)
//   dq_push_front(d, v)  -> (mutates d, inserts v at the front)
//   dq_push_back(d, v)   -> (mutates d, appends v at the back)
//   dq_pop_front(d)      -> value (removes+returns front; null if empty)
//   dq_pop_back(d)       -> value (removes+returns back; null if empty)
//   dq_peek_front(d)     -> value (front without removing; null if empty)
//   dq_peek_back(d)      -> value (back without removing; null if empty)
//   dq_len(d)             -> int
//   dq_is_empty(d)         -> int (1/0)
//   dq_to_list(d)           -> list (copy, front..back order)

// dq_new: create and return an empty deque.
fn dq_new()
    let d = {}
    d["dq_items"] = []
    return d

// dq_push_front: insert v at the front of d.
fn dq_push_front(d, v)
    let items = d["dq_items"]
    insert(items, 0, v)

// dq_push_back: append v at the back of d.
fn dq_push_back(d, v)
    let items = d["dq_items"]
    items.push(v)

// dq_pop_front: remove and return the front element. null if d is empty.
fn dq_pop_front(d)
    let items = d["dq_items"]
    let n = len(items)
    if n == 0
        return null
    let v = items[0]
    d["dq_items"] = list_slice(items, 1, n)
    return v

// dq_pop_back: remove and return the back element. null if d is empty.
fn dq_pop_back(d)
    let items = d["dq_items"]
    let n = len(items)
    if n == 0
        return null
    return items.pop()

// dq_peek_front: the front element without removing it. null if empty.
fn dq_peek_front(d)
    let items = d["dq_items"]
    if len(items) == 0
        return null
    return items[0]

// dq_peek_back: the back element without removing it. null if empty.
fn dq_peek_back(d)
    let items = d["dq_items"]
    let n = len(items)
    if n == 0
        return null
    return items[n - 1]

// dq_len: number of elements currently in the deque.
fn dq_len(d)
    return len(d["dq_items"])

// dq_is_empty: 1 if the deque has no elements, 0 otherwise.
fn dq_is_empty(d)
    if len(d["dq_items"]) == 0
        return 1
    return 0

// dq_to_list: a fresh copy of the backing list, front..back order.
fn dq_to_list(d)
    let items = d["dq_items"]
    let out = []
    let i = 0
    while i < len(items)
        out.push(items[i])
        i += 1
    return out
