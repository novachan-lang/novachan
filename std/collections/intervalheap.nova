// intervalheap — Double-ended priority queue backed by an interval heap.
//
// Each logical node i owns a pair of slots: items[2*i] (lo) and items[2*i+1] (hi).
// Invariant:  items[2*i] <= items[2*i+1]          (lo <= hi within node)
//             items[2*i] <= items[2*child]          (min-heap on lo side)
//             items[2*i+1] >= items[2*child+1]      (max-heap on hi side)
//
// A heap with n elements uses ceil(n/2) nodes.  If n is odd, the last node
// is a "half-node": only the lo slot is occupied (its hi slot does not exist).
//
// Public API
//   ivh_new()         -> heap dict (empty)
//   ivh_push(h, v)    -> (mutates h; inserts v)
//   ivh_min(h)        -> int  (peek minimum; null if empty)
//   ivh_max(h)        -> int  (peek maximum; null if empty)
//   ivh_pop_min(h)    -> int  (remove+return minimum; null if empty)
//   ivh_pop_max(h)    -> int  (remove+return maximum; null if empty)
//   ivh_size(h)       -> int

// _ivh_swap: swap items[a] and items[b] in-place.
fn _ivh_swap(items, a, b)
    let tmp = items[a]
    items[a] = items[b]
    items[b] = tmp

// _ivh_sift_up_min: sift up the lo side starting from node ni.
// Walks toward root comparing lo values.
fn _ivh_sift_up_min(items, ni)
    let i = ni
    let done = 0
    while i > 0 and done == 0
        let par = (i - 1) / 2
        if items[2 * i] < items[2 * par]
            _ivh_swap(items, 2 * i, 2 * par)
            // After swapping lo values, the hi side of parent might now be < its lo side.
            // Re-ensure lo <= hi within parent node.
            let par_lo = 2 * par
            let par_hi = 2 * par + 1
            if par_hi < len(items)
                if items[par_lo] > items[par_hi]
                    _ivh_swap(items, par_lo, par_hi)
            i = par
        else
            done = 1

// _ivh_sift_up_max: sift up the hi side starting from node ni.
// Walks toward root comparing hi values.
fn _ivh_sift_up_max(items, ni)
    let i = ni
    let done = 0
    while i > 0 and done == 0
        let par = (i - 1) / 2
        let par_hi = 2 * par + 1
        if par_hi >= len(items)
            done = 1
        else
            if items[2 * i + 1] > items[par_hi]
                _ivh_swap(items, 2 * i + 1, par_hi)
                // Re-ensure lo <= hi within parent node.
                let par_lo = 2 * par
                if items[par_lo] > items[par_hi]
                    _ivh_swap(items, par_lo, par_hi)
                i = par
            else
                done = 1

// _ivh_sift_down_min: sift down the lo side from node ni over n total items.
fn _ivh_sift_down_min(items, ni, n)
    let i = ni
    let done = 0
    while done == 0
        let left = 2 * i + 1
        let right = 2 * i + 2
        let smallest = i
        if 2 * left < n
            if items[2 * left] < items[2 * smallest]
                smallest = left
        if 2 * right < n
            if items[2 * right] < items[2 * smallest]
                smallest = right
        if smallest == i
            done = 1
        else
            _ivh_swap(items, 2 * i, 2 * smallest)
            // Re-ensure lo <= hi within child node after swap.
            let s_hi = 2 * smallest + 1
            if s_hi < n
                if items[2 * smallest] > items[s_hi]
                    _ivh_swap(items, 2 * smallest, s_hi)
            i = smallest

// _ivh_sift_down_max: sift down the hi side from node ni over n total items.
fn _ivh_sift_down_max(items, ni, n)
    let i = ni
    let done = 0
    while done == 0
        let left = 2 * i + 1
        let right = 2 * i + 2
        let largest = i
        if 2 * left + 1 < n
            if items[2 * left + 1] > items[2 * largest + 1]
                largest = left
        if 2 * right + 1 < n
            if items[2 * right + 1] > items[2 * largest + 1]
                largest = right
        if largest == i
            done = 1
        else
            _ivh_swap(items, 2 * i + 1, 2 * largest + 1)
            // Re-ensure lo <= hi within child node after swap.
            let l_lo = 2 * largest
            if items[l_lo] > items[2 * largest + 1]
                _ivh_swap(items, l_lo, 2 * largest + 1)
            i = largest

// ivh_new: create and return an empty interval heap.
fn ivh_new()
    let h = {}
    h["items"] = []
    h["size"] = 0
    return h

// ivh_size: number of elements currently in the heap.
fn ivh_size(h)
    return h["size"]

// ivh_push: insert value v into the heap.
fn ivh_push(h, v)
    let items = h["items"]
    let n = h["size"]
    if n == 0
        // First element: lo slot only; no hi slot yet.
        items.push(v)
        h["size"] = 1
        return 0
    // Check if the last node is a half-node (odd number of elements = odd n).
    let last_node = (n - 1) / 2
    let half = 0
    if n == 2 * last_node + 1
        half = 1
    if half == 1
        // Last node is a half-node: fill its hi slot.
        let hi_idx = 2 * last_node + 1
        items.push(v)
        // Ensure lo <= hi in this node.
        let lo_idx = 2 * last_node
        if items[lo_idx] > items[hi_idx]
            _ivh_swap(items, lo_idx, hi_idx)
        // Now sift up both sides from this node.
        _ivh_sift_up_min(items, last_node)
        _ivh_sift_up_max(items, last_node)
    else
        // Start a new node; insert as its lo slot.
        items.push(v)
        let new_node = n / 2
        // Compare with parent and place on the correct side.
        if new_node > 0
            let par = (new_node - 1) / 2
            if items[2 * new_node] < items[2 * par]
                // New value is less than parent lo: sift up min side.
                _ivh_sift_up_min(items, new_node)
            else
                let par_hi = 2 * par + 1
                if par_hi < len(items)
                    if items[2 * new_node] > items[par_hi]
                        // New value greater than parent hi: place on hi side of new node.
                        // But new node only has lo slot so far — nothing to swap yet.
                        // Will be handled when hi slot fills.
                        let done_ph = 0
                        done_ph = 1
    h["size"] = n + 1
    return 0

// ivh_min: peek at the minimum element without removing it.
// Returns null if the heap is empty.
fn ivh_min(h)
    let items = h["items"]
    if h["size"] == 0
        return null
    return items[0]

// ivh_max: peek at the maximum element without removing it.
// Returns null if the heap is empty.
fn ivh_max(h)
    let items = h["items"]
    let n = h["size"]
    if n == 0
        return null
    if n == 1
        return items[0]
    return items[1]

// ivh_pop_min: remove and return the minimum element.
// Returns null if the heap is empty.
fn ivh_pop_min(h)
    let items = h["items"]
    let n = h["size"]
    if n == 0
        return null
    let mn = items[0]
    if n == 1
        items.pop()
        h["size"] = 0
        return mn
    if n == 2
        // Only the root node with two elements.
        let lo = items[0]
        let hi = items[1]
        // Remove lo slot: overwrite with hi, then pop last.
        items[0] = hi
        items.pop()
        h["size"] = 1
        return lo
    // General case: replace root lo with the lo of the last node.
    let last_node = (n - 1) / 2
    let last_lo = 2 * last_node
    let is_half = 0
    if n == 2 * last_node + 1
        is_half = 1
    if is_half == 1
        // Last node is a half-node: its only slot is lo.
        items[0] = items[last_lo]
        items.pop()
    else
        // Last node has both slots: take its lo, leave its hi in place.
        items[0] = items[last_lo]
        // Compact: the last node now only has hi; move hi to lo, pop.
        items[last_lo] = items[last_lo + 1]
        items.pop()
    h["size"] = n - 1
    // Sift the new root lo down.
    let new_n = h["size"]
    if new_n > 1
        // Ensure root lo <= root hi.
        if items[0] > items[1]
            _ivh_swap(items, 0, 1)
            // Root is now correct; sift down max side from root.
            _ivh_sift_down_max(items, 0, new_n)
        else
            _ivh_sift_down_min(items, 0, new_n)
    return mn

// ivh_pop_max: remove and return the maximum element.
// Returns null if the heap is empty.
fn ivh_pop_max(h)
    let items = h["items"]
    let n = h["size"]
    if n == 0
        return null
    if n == 1
        let v = items[0]
        items.pop()
        h["size"] = 0
        return v
    let mx = items[1]
    if n == 2
        items.pop()
        h["size"] = 1
        return mx
    // General case: replace root hi with the hi of the last node.
    let last_node = (n - 1) / 2
    let last_lo = 2 * last_node
    let is_half = 0
    if n == 2 * last_node + 1
        is_half = 1
    if is_half == 1
        // Last node is a half-node: take its lo value (no hi), replace root hi.
        items[1] = items[last_lo]
        items.pop()
    else
        // Last node has both slots: take its hi, leave lo.
        items[1] = items[last_lo + 1]
        items.pop()
    h["size"] = n - 1
    let new_n = h["size"]
    if new_n > 1
        // Ensure root lo <= root hi.
        if items[0] > items[1]
            _ivh_swap(items, 0, 1)
            // Root lo is now the previous max; sift down min side.
            _ivh_sift_down_min(items, 0, new_n)
        else
            _ivh_sift_down_max(items, 0, new_n)
    return mx
