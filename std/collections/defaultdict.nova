// defaultdict — dict with a per-kind default factory for NOVA.
//
// A defaultdict wraps a plain dict and a "kind" tag so that missing keys
// always return a sensible zero value instead of null.
//
// Supported kinds:
//   "int"  — missing key returns 0
//   "list" — missing key returns []
//   "str"  — missing key returns ""
//   "dict" — missing key returns {}
//
// NOTE: dd_get / dd_has do NOT insert on miss (read-only probe).
//       Only dd_set / dd_incr / dd_append write into the backing dict.
//
// Public API
//   dd_new(kind)           -> defaultdict
//   dd_get(dd, k)          -> value  (default if absent; does NOT insert)
//   dd_set(dd, k, v)       -> unit
//   dd_incr(dd, k, n)      -> unit   (kind=int: data[k] += n, absent treated as 0)
//   dd_append(dd, k, v)    -> unit   (kind=list: push v to data[k], creating [] if absent)
//   dd_has(dd, k)          -> int    (1 if key was explicitly set, 0 otherwise)
//   dd_keys(dd)            -> list   (all explicitly-set keys)

fn dd_new(kind)
    let dd = {}
    dd["data"] = {}
    dd["kind"] = kind
    return dd

fn _dd_default(kind)
    if kind == "int"
        return 0
    if kind == "list"
        return []
    if kind == "str"
        return ""
    if kind == "dict"
        return {}
    return 0

fn dd_get(dd, k)
    let data = dd["data"]
    if contains(data, k)
        return data[k]
    return _dd_default(dd["kind"])

fn dd_set(dd, k, v)
    let data = dd["data"]
    data[k] = v

fn dd_incr(dd, k, n)
    let data = dd["data"]
    if contains(data, k)
        let cur = data[k]
        data[k] = cur + n
    else
        data[k] = n

fn dd_append(dd, k, v)
    let data = dd["data"]
    if contains(data, k)
        let lst = data[k]
        lst.push(v)
    else
        let lst = []
        lst.push(v)
        data[k] = lst

fn dd_has(dd, k)
    let data = dd["data"]
    if contains(data, k)
        return 1
    return 0

fn dd_keys(dd)
    let data = dd["data"]
    return keys(data)
