// multiset — counting bag keyed by string for NOVA.
//
// A multiset (bag) maps each string item to its count (>= 1).
// Internally it is a plain NOVA dict: string -> int.
//
// Public API
//   ms_new()                     -> dict  (empty multiset)
//   ms_add(ms, x)                -> unit  (increment count of x by 1)
//   ms_add_n(ms, x, n)           -> unit  (increment count of x by n)
//   ms_remove(ms, x)             -> unit  (decrement count; remove key when count reaches 0; no-op if absent)
//   ms_count(ms, x)              -> int   (count of x; 0 if absent)
//   ms_total(ms)                 -> int   (sum of all counts)
//   ms_distinct(ms)              -> list  (sorted list of distinct items)
//   ms_contains(ms, x)           -> bool  (1 if x has count >= 1, 0 otherwise)
//   ms_most_common(ms, k)        -> list  (top-k [item, count] pairs sorted by count desc then item asc)

fn ms_new()
    return {}

fn ms_add(ms, x)
    if x in ms
        ms[x] = ms[x] + 1
    else
        ms[x] = 1

fn ms_add_n(ms, x, n)
    if x in ms
        ms[x] = ms[x] + n
    else
        ms[x] = n

fn ms_remove(ms, x)
    if x in ms
        let c = ms[x]
        if c <= 1
            del(ms, x)
        else
            ms[x] = c - 1

fn ms_count(ms, x)
    if x in ms
        return ms[x]
    return 0

fn ms_total(ms)
    let ks = keys(ms)
    let total = 0
    for i in 0..len(ks)
        total += ms[ks[i]]
    return total

fn ms_distinct(ms)
    return sort(keys(ms))

fn ms_contains(ms, x)
    if x in ms
        return 1
    return 0

// ms_most_common: return top-k [item, count] pairs sorted by count desc, item asc.
// Uses insertion sort on a list of pairs for simplicity (counts are small in practice).
fn ms_most_common(ms, k)
    let ks = keys(ms)
    // Build a list of [item, count] pairs
    let pairs = []
    for i in 0..len(ks)
        let item = ks[i]
        let pair = []
        pair.push(item)
        pair.push(ms[item])
        pairs.push(pair)
    // Insertion sort: primary = count desc, secondary = item asc
    let n = len(pairs)
    for j in 1..n
        let cur = pairs[j]
        let cur_cnt = cur[1]
        let cur_item = cur[0]
        let pos = j
        let do_swap = 1
        while pos > 0 and do_swap == 1
            let prev = pairs[pos - 1]
            let prev_cnt = prev[1]
            let prev_item = prev[0]
            // cur should come before prev if cur_cnt > prev_cnt, or same cnt and cur_item < prev_item
            let should_swap = 0
            if cur_cnt > prev_cnt
                should_swap = 1
            if cur_cnt == prev_cnt
                if cur_item < prev_item
                    should_swap = 1
            if should_swap == 1
                pairs[pos] = prev
                pos -= 1
            else
                do_swap = 0
        pairs[pos] = cur
    // Return top k
    let result = []
    let take = k
    if len(pairs) < take
        take = len(pairs)
    for m in 0..take
        result.push(pairs[m])
    return result
