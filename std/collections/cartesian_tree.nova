// cartesian_tree — min-Cartesian tree and range-minimum queries (RMQ).
//
// A min-Cartesian tree over an array xs satisfies:
//   1. It is a binary tree whose in-order traversal yields xs.
//   2. Each node's value is <= the values of its children (heap property).
//   3. Ties broken by choosing the EARLIER index as the ancestor.
//
// crt_build returns a parent array: parent[i] = index of i's parent (-1 for root).
// The root is the global minimum (earliest index on ties).
//
// RMQ in O(1): range [i,j] minimum index found via crt_rmq_index.
//
// All algorithms are purely stack/array based — O(n) build, O(n) RMQ preprocessing,
// O(1) RMQ query.

// _crt_min_idx(arr, i, j) — index of the minimum in arr[i..j] inclusive (linear scan).
// Used internally for small ranges and as the foundation of the O(n) RMQ prep.
fn _crt_min_idx(arr, i, j)
    let best = i
    let k = i + 1
    while k <= j
        if arr[k] < arr[best]
            best = k
        k = k + 1
    return best

// crt_build(arr) — build min-Cartesian tree over arr.
// Returns parent array where parent[i] = index of parent node (-1 for root).
// Uses an O(n) monotone stack algorithm.
fn crt_build(arr)
    let n = len(arr)
    let parent = []
    let i = 0
    while i < n
        parent.push(-1)
        i = i + 1
    if n == 0
        return parent
    // Monotone stack stored as a fixed-size list (pre-filled) with logical size si.
    // stk[0..si-1] are valid; stk[si..n-1] are unused slots.
    // Pre-fill with -1 so all slots exist for index-assign.
    let stk = []
    let fi = 0
    while fi < n
        stk.push(-1)
        fi = fi + 1
    let si = 0   // logical stack size
    // For each new element idx:
    //   Pop all stack elements with arr[stk_top] > arr[idx] (strictly greater;
    //   equal stays — earlier index is ancestor for ties).
    //   The last popped node becomes the LEFT child of idx.
    //   idx becomes the RIGHT child of the current stack top (if any).
    let idx = 0
    while idx < n
        let last_popped = -1
        while si > 0 and arr[stk[si - 1]] > arr[idx]
            last_popped = stk[si - 1]
            si = si - 1
        // last_popped becomes left child of idx.
        if last_popped != -1
            parent[last_popped] = idx
        // idx becomes right child of new stack top.
        if si > 0
            parent[idx] = stk[si - 1]
        // Push idx: write into the pre-allocated slot at position si.
        stk[si] = idx
        si = si + 1
        idx = idx + 1
    return parent

// crt_root(arr) — index of the root of the min-Cartesian tree (= global minimum index).
// Ties resolved by returning the earliest (smallest) index.
fn crt_root(arr)
    let n = len(arr)
    if n == 0
        return -1
    let best = 0
    let k = 1
    while k < n
        if arr[k] < arr[best]
            best = k
        k = k + 1
    return best

// _crt_rmq_prep(arr) — O(n) sparse-table style preprocessing for O(1) RMQ.
// Returns a dict with:
//   "n"      -> int
//   "log"    -> list[int]   log[i] = floor(log2(i)) for i >= 1; log[0] = 0
//   "sparse" -> list[list]  sparse[k][i] = index of minimum in arr[i..i+2^k-1]
fn _crt_rmq_prep(arr)
    let n = len(arr)
    // Build log table.
    let log = []
    log.push(0)
    let li = 1
    while li <= n
        let prev = log[li - 1]
        let pw = 1
        let bi = 0
        while bi < prev + 1
            pw = pw * 2
            bi = bi + 1
        if pw <= li
            log.push(prev + 1)
        else
            log.push(prev)
        li = li + 1
    // k = floor(log2(n)) + 1 levels.
    let levels = 1
    if n > 0
        levels = log[n] + 1
    // Build sparse table.
    let sparse = []
    // Level 0: sparse[0][i] = i (single element, min index is itself).
    let l0 = []
    let si = 0
    while si < n
        l0.push(si)
        si = si + 1
    sparse.push(l0)
    // Levels 1..(levels-1).
    let lk = 1
    while lk < levels
        let half = 1
        let hi = 0
        while hi < lk - 1
            half = half * 2
            hi = hi + 1
        let prev_row = sparse[lk - 1]
        let cur_row = []
        let maxStart = n - half * 2
        let ri = 0
        while ri <= maxStart
            let ia = prev_row[ri]
            let ib = prev_row[ri + half]
            if arr[ia] <= arr[ib]
                cur_row.push(ia)
            else
                cur_row.push(ib)
            ri = ri + 1
        sparse.push(cur_row)
        lk = lk + 1
    let t = {}
    t["n"] = n
    t["log"] = log
    t["sparse"] = sparse
    return t

// crt_rmq_index(arr, i, j) — index of the minimum element in arr[i..j] inclusive.
// Ties resolved by returning the EARLIEST (smallest) index.
// Uses a built sparse table for O(1) queries; preprocessing is hidden inside.
fn crt_rmq_index(arr, i, j)
    let n = len(arr)
    if i == j
        return i
    // Build sparse table inline (for self-contained O(1) query).
    let t = _crt_rmq_prep(arr)
    let log = t["log"]
    let sparse = t["sparse"]
    let length = j - i + 1
    let k = log[length]
    let pw = 1
    let pi = 0
    while pi < k
        pw = pw * 2
        pi = pi + 1
    let right = j - pw + 1
    let ia = sparse[k][i]
    let ib = sparse[k][right]
    if arr[ia] <= arr[ib]
        return ia
    return ib
