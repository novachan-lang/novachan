// ordereddict — insertion-ordered map for NOVA.
//
// NOVA's built-in dict does not guarantee iteration order.  This module
// wraps a dict + a key-order list so that od_keys() / od_values() always
// return entries in the order they were first inserted.
//
// Representation (a plain NOVA dict):
//   "data" -> dict  (k -> v, the actual key/value store)
//   "keys" -> list  (insertion-ordered list of string keys; no duplicates)
//
// Public API
//   od_new()           -> ordered-dict
//   od_set(od, k, v)   -> unit  (insert on first appearance; update value on re-set)
//   od_get(od, k)      -> value (or null if absent)
//   od_has(od, k)      -> 1 if present, 0 otherwise
//   od_del(od, k)      -> unit  (no-op if absent)
//   od_keys(od)        -> list of keys in insertion order
//   od_values(od)      -> list of values in insertion order
//   od_len(od)         -> number of keys

fn od_new()
    let od = {}
    od["data"] = {}
    od["keys"] = []
    return od

// od_set: insert k->v if k is new; update value and keep position if k exists.
fn od_set(od, k, v)
    let data = od["data"]
    let keys = od["keys"]
    if contains(data, k)
        data[k] = v
    else
        data[k] = v
        keys.push(k)

// od_get: return the value for k, or null if absent.
fn od_get(od, k)
    let data = od["data"]
    if contains(data, k)
        return data[k]
    return null

// od_has: 1 if k is present, 0 otherwise.
fn od_has(od, k)
    let data = od["data"]
    if contains(data, k)
        return 1
    return 0

// od_del: remove k from both the data dict and the order list.
fn od_del(od, k)
    let data = od["data"]
    if contains(data, k)
        del(data, k)
        let keys = od["keys"]
        let new_keys = []
        let i = 0
        while i < len(keys)
            if keys[i] != k
                new_keys.push(keys[i])
            i = i + 1
        od["keys"] = new_keys

// od_keys: return keys in insertion order.
fn od_keys(od)
    return od["keys"]

// od_values: return values in insertion order.
fn od_values(od)
    let keys = od["keys"]
    let data = od["data"]
    let vals = []
    let i = 0
    while i < len(keys)
        vals.push(data[keys[i]])
        i = i + 1
    return vals

// od_len: number of entries.
fn od_len(od)
    return len(od["keys"])
