// std/collections/bitmatrix.nova — dense 2-D bit matrix (rows x cols of 0/1).
// KAT: test_programs/_kat_fleet7.nova
// LEAF — imports NOTHING.
//
// Representation: a list of `rows` row-lists, each row-list holding `cols`
// ints (0 or 1). This is a genuinely different structure from
// std/collections/bitset.nova (a flat, word-packed 1-D bit vector): a
// bitmatrix is 2-D, element-per-slot (no word packing), and adds transpose
// and full elementwise boolean-matrix ops.
//
// Every mutator RETURNS A NEW MATRIX (lists are treated as immutable here,
// same convention as std/collections/bitset.nova) rather than mutating the
// argument in place.
//
// Public API:
//   bmx_new(rows, cols)     -> list   fresh rows x cols matrix, all zero
//   bmx_rows(m)             -> int    number of rows
//   bmx_cols(m)             -> int    number of columns (0 for a 0-row matrix)
//   bmx_get(m, r, c)        -> int    0 or 1 at (r, c)
//   bmx_set_bit(m, r, c)    -> list   NEW matrix with (r,c) forced to 1
//   bmx_clear_bit(m, r, c)  -> list   NEW matrix with (r,c) forced to 0
//   bmx_row_popcount(m, r)  -> int    number of 1-bits in row r
//   bmx_total_popcount(m)   -> int    number of 1-bits in the whole matrix
//   bmx_transpose(m)        -> list   NEW cols x rows matrix, m[r][c] -> t[c][r]
//   bmx_and(a, b)           -> list   elementwise AND (a, b must be same shape)
//   bmx_or(a, b)            -> list   elementwise OR  (a, b must be same shape)
//   bmx_xor(a, b)           -> list   elementwise XOR (a, b must be same shape)
//
// Complexity: bmx_get/set_bit/clear_bit are O(rows*cols) (full rebuild, same
// tradeoff as bitset.nova's immutable-rebuild convention); transpose/and/or/xor
// are O(rows*cols).

fn bmx_new(rows: int, cols: int) -> list
    return [[0 for c in 0..cols] for r in 0..rows]

fn bmx_rows(m: list) -> int
    return len(m)

fn bmx_cols(m: list) -> int
    if len(m) == 0
        return 0
    return len(m[0])

fn bmx_get(m: list, r: int, c: int) -> int
    let row = m[r]
    return row[c]

// _bmx_rebuild_bit — shared helper for bmx_set_bit / bmx_clear_bit: returns a
// new matrix identical to m except position (tr, tc), which is forced to val.
fn _bmx_rebuild_bit(m: list, tr: int, tc: int, val: int) -> list
    let nr = bmx_rows(m)
    let nc = bmx_cols(m)
    return [[val if (r == tr and c == tc) else m[r][c] for c in 0..nc] for r in 0..nr]

fn bmx_set_bit(m: list, r: int, c: int) -> list
    return _bmx_rebuild_bit(m, r, c, 1)

fn bmx_clear_bit(m: list, r: int, c: int) -> list
    return _bmx_rebuild_bit(m, r, c, 0)

fn bmx_row_popcount(m: list, r: int) -> int
    let row = m[r]
    return sum(row)

fn bmx_total_popcount(m: list) -> int
    let nr = bmx_rows(m)
    let total = 0
    for r in 0..nr
        total = total + bmx_row_popcount(m, r)
    return total

fn bmx_transpose(m: list) -> list
    let nr = bmx_rows(m)
    let nc = bmx_cols(m)
    return [[m[r][c] for r in 0..nr] for c in 0..nc]

fn bmx_and(a: list, b: list) -> list
    let nr = bmx_rows(a)
    let nc = bmx_cols(a)
    return [[1 if (a[r][c] == 1 and b[r][c] == 1) else 0 for c in 0..nc] for r in 0..nr]

fn bmx_or(a: list, b: list) -> list
    let nr = bmx_rows(a)
    let nc = bmx_cols(a)
    return [[1 if (a[r][c] == 1 or b[r][c] == 1) else 0 for c in 0..nc] for r in 0..nr]

fn bmx_xor(a: list, b: list) -> list
    let nr = bmx_rows(a)
    let nc = bmx_cols(a)
    return [[1 if (a[r][c] != b[r][c]) else 0 for c in 0..nc] for r in 0..nr]
