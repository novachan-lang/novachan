// dsu_weighted — weighted union-find (potential / relative-weight DSU).
//
// Each element i has a potential phi(i). Edges encode differences:
//   wds_union(d, a, b, w) asserts phi(b) - phi(a) = w.
//
// Representation (dict d):
//   "parent" -> list[int]   parent[i] = parent of i (root when parent[i]==i)
//   "rank"   -> list[int]   union-by-rank upper bound on depth
//   "weight" -> list[int]   weight[i] = phi(i) - phi(parent[i])
//                           (0 for roots; accumulated on path compression)
//
// All operations are amortised near-O(1) via path compression + union-by-rank.

// _wds_find(parent, weight, x) — iterative root-find.
// Returns a 2-element list [root, total_weight] where
//   total_weight = phi(x) - phi(root)   (sum of edge weights root->x).
// Performs iterative path compression so every node on the path points
// directly to the root with the correct accumulated weight.
fn _wds_find(parent, weight, x)
    // Phase 1: walk to root, accumulate phi(x) - phi(root).
    let cur = x
    let acc = 0
    while parent[cur] != cur
        acc += weight[cur]
        cur = parent[cur]
    let root = cur
    let total = acc
    // Phase 2: path compression — make every ancestor point directly to root.
    cur = x
    acc = 0
    while parent[cur] != cur
        let nxt = parent[cur]
        let w = weight[cur]
        // After compression weight[cur] must equal phi(cur) - phi(root) = total - acc_so_far
        // But we need the sum from cur to root in the ORIGINAL chain.
        // Recompute: we already know total = phi(x)-phi(root).
        // phi(cur) - phi(root) = total - (phi(x) - phi(cur)) = total - acc
        weight[cur] = total - acc
        parent[cur] = root
        acc += w
        cur = nxt
    let res = []
    res.push(root)
    res.push(total)
    return res

// wds_make(n) — create a weighted union-find over elements 0..n-1.
// All elements start as singletons with potential 0.
fn wds_make(n)
    let parent = []
    let rank = []
    let weight = []
    for i in 0..n
        parent.push(i)
        rank.push(0)
        weight.push(0)
    let d = {}
    d["parent"] = parent
    d["rank"] = rank
    d["weight"] = weight
    return d

// wds_union(d, a, b, w) — assert phi(b) - phi(a) = w.
// Returns true if the union succeeded (a and b were in different components
// or the constraint is consistent with existing constraints).
// Returns false if a and b are already connected AND the constraint contradicts
// the existing potential difference.
fn wds_union(d, a, b, w)
    let parent = d["parent"]
    let rank = d["rank"]
    let weight = d["weight"]
    // Find roots and potentials relative to roots.
    let fa = _wds_find(parent, weight, a)
    let ra = fa[0]
    let wa = fa[1]
    let fb = _wds_find(parent, weight, b)
    let rb = fb[0]
    let wb = fb[1]
    // wa = phi(a) - phi(ra);  wb = phi(b) - phi(rb)
    // We want phi(b) - phi(a) = w.
    if ra == rb
        // Already connected: check consistency.
        // phi(b) - phi(a) = (phi(b) - phi(rb)) - (phi(a) - phi(ra))
        //                 = wb - wa   (since ra == rb)
        if wb - wa == w
            return true
        return false
    // Different components: merge.
    // After merge we want: phi(b) - phi(a) = w
    // If we make ra a child of rb, we need weight[ra] = phi(ra) - phi(rb).
    // phi(a) = phi(ra) + wa  (since wa = phi(a)-phi(ra))
    // phi(b) = phi(rb) + wb
    // phi(b) - phi(a) = w  =>  phi(rb) + wb - phi(ra) - wa = w
    //                   =>  phi(ra) - phi(rb) = wb - wa - w
    //                   =>  weight[ra] (pointing to rb) = wb - wa - w
    if rank[ra] < rank[rb]
        // ra becomes child of rb
        parent[ra] = rb
        weight[ra] = wb - wa - w
    else
        if rank[ra] > rank[rb]
            // rb becomes child of ra
            // weight[rb] = phi(rb) - phi(ra) = -(phi(ra)-phi(rb)) = -(wb-wa-w) = wa-wb+w
            parent[rb] = ra
            weight[rb] = wa - wb + w
        else
            // Equal rank: make rb child of ra, increment rank of ra.
            parent[rb] = ra
            weight[rb] = wa - wb + w
            rank[ra] = rank[ra] + 1
    return true

// wds_connected(d, a, b) — true (1) if a and b are in the same component.
fn wds_connected(d, a, b)
    let parent = d["parent"]
    let weight = d["weight"]
    let fa = _wds_find(parent, weight, a)
    let fb = _wds_find(parent, weight, b)
    return fa[0] == fb[0]

// wds_diff(d, a, b) — potential difference phi(b) - phi(a).
// Returns the difference if a and b are connected, else 1000000000 (sentinel).
fn wds_diff(d, a, b)
    let parent = d["parent"]
    let weight = d["weight"]
    let fa = _wds_find(parent, weight, a)
    let fb = _wds_find(parent, weight, b)
    if fa[0] != fb[0]
        return 1000000000
    // wa = phi(a)-phi(root); wb = phi(b)-phi(root)
    // phi(b)-phi(a) = wb - wa
    return fb[1] - fa[1]
