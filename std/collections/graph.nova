// ============================================================================
// NOVA Standard Library — std/collections/graph
// ============================================================================
// Directed graph with adjacency-list representation.
//
// Representation (a plain NOVA dict):
//   "adj" -> dict  (node_string -> list of neighbor strings, insertion order)
//
// Public API
//   g_new()              -> graph dict
//   g_add_node(g, u)     -> unit  (idempotent; adds u if not present)
//   g_add_edge(g, u, v)  -> unit  (adds both nodes then appends v to adj[u])
//   g_neighbors(g, u)    -> list of neighbor strings in insertion order ([] if unknown)
//   g_bfs(g, start)      -> list of nodes in BFS visit order from start
//   g_dfs(g, start)      -> list of nodes in DFS preorder from start
//   g_has_path(g, u, v)  -> 1 (true) if v is reachable from u, 0 otherwise
//   g_topo_sort(g)       -> list in topological order (Kahn's); [] if cycle detected
//
// Nodes are strings. Self-loops are allowed. Multi-edges are not deduplicated.
// ============================================================================

// ---- Internal stack helpers ------------------------------------------------
// A stack is a dict: {"data": list, "sp": int}
// sp is the logical top (number of live elements; data may be larger).

fn _stk_new()
    let s = {}
    s["data"] = []
    s["sp"] = 0
    return s

fn _stk_push(s, v)
    let data = s["data"]
    let sp = s["sp"]
    if sp < len(data)
        data[sp] = v
    else
        data.push(v)
    s["sp"] = sp + 1

fn _stk_pop(s)
    let sp = s["sp"]
    if sp <= 0
        return null
    let new_sp = sp - 1
    s["sp"] = new_sp
    let data = s["data"]
    return data[new_sp]

fn _stk_len(s)
    return s["sp"]

// ---------------------------------------------------------------------------

// g_new: create an empty directed graph.
fn g_new()
    let g = {}
    g["adj"] = {}
    return g

// g_add_node: add node u if not already present. Idempotent.
fn g_add_node(g, u)
    let adj = g["adj"]
    if contains(adj, u)
        return null
    adj[u] = []
    return null

// g_add_edge: add directed edge u -> v (adding both endpoints if absent).
fn g_add_edge(g, u, v)
    g_add_node(g, u)
    g_add_node(g, v)
    let adj = g["adj"]
    let nbrs = adj[u]
    nbrs.push(v)
    return null

// g_neighbors: return the neighbor list of u (insertion order). [] if u unknown.
fn g_neighbors(g, u)
    let adj = g["adj"]
    if contains(adj, u)
        return adj[u]
    return []

// g_bfs: breadth-first traversal from start. Returns visit-order list.
// Unvisited neighbors are explored in insertion order.
fn g_bfs(g, start)
    let adj = g["adj"]
    if contains(adj, start) == 0
        return []
    // visited: dict node -> 1
    let visited = {}
    let order = []
    // queue simulated as list + head pointer
    let queue = []
    queue.push(start)
    let head = 0
    visited[start] = 1
    while head < len(queue)
        let node = queue[head]
        head = head + 1
        order.push(node)
        let nbrs = adj[node]
        let i = 0
        while i < len(nbrs)
            let nb = nbrs[i]
            if contains(visited, nb) == 0
                visited[nb] = 1
                queue.push(nb)
            i = i + 1
    return order

// g_dfs: depth-first traversal (preorder) from start. Returns visit-order list.
// Uses an explicit stack; neighbors pushed in reverse insertion order so that
// the first neighbor (insertion order) is visited first — matches recursive
// preorder DFS.
fn g_dfs(g, start)
    let adj = g["adj"]
    if contains(adj, start) == 0
        return []
    let visited = {}
    let order = []
    let stk = _stk_new()
    _stk_push(stk, start)
    while _stk_len(stk) > 0
        let top = _stk_pop(stk)
        if contains(visited, top) == 0
            visited[top] = 1
            order.push(top)
            // Push neighbors in reverse so leftmost is processed first
            let nbrs = adj[top]
            let i = len(nbrs) - 1
            while i >= 0
                let nb = nbrs[i]
                if contains(visited, nb) == 0
                    _stk_push(stk, nb)
                i = i - 1
    return order

// g_has_path: true (1) if v is reachable from u via directed edges.
fn g_has_path(g, u, v)
    let adj = g["adj"]
    if contains(adj, u) == 0
        return 0
    if u == v
        return 1
    let visited = {}
    let queue = []
    queue.push(u)
    let head = 0
    visited[u] = 1
    while head < len(queue)
        let node = queue[head]
        head = head + 1
        let nbrs = adj[node]
        let i = 0
        while i < len(nbrs)
            let nb = nbrs[i]
            if nb == v
                return 1
            if contains(visited, nb) == 0
                visited[nb] = 1
                queue.push(nb)
            i = i + 1
    return 0

// g_topo_sort: Kahn's algorithm. Returns a valid topological order, or []
// if the graph contains a cycle (len(result) < number of nodes).
fn g_topo_sort(g)
    let adj = g["adj"]
    let all_nodes = keys(adj)
    let n = len(all_nodes)
    if n == 0
        return []
    // Build in-degree map (initialise all to 0)
    let indeg = {}
    let i = 0
    while i < n
        indeg[all_nodes[i]] = 0
        i = i + 1
    // Count in-edges from every node's adjacency list
    i = 0
    while i < n
        let node = all_nodes[i]
        let nbrs = adj[node]
        let j = 0
        while j < len(nbrs)
            let nb = nbrs[j]
            indeg[nb] = indeg[nb] + 1
            j = j + 1
        i = i + 1
    // Seed queue with all zero-indegree nodes (deterministic: insertion key order)
    let queue = []
    i = 0
    while i < n
        if indeg[all_nodes[i]] == 0
            queue.push(all_nodes[i])
        i = i + 1
    let head = 0
    let result = []
    while head < len(queue)
        let node = queue[head]
        head = head + 1
        result.push(node)
        let nbrs = adj[node]
        let j = 0
        while j < len(nbrs)
            let nb = nbrs[j]
            indeg[nb] = indeg[nb] - 1
            if indeg[nb] == 0
                queue.push(nb)
            j = j + 1
    // Cycle detected: not all nodes were processed
    if len(result) != n
        return []
    return result
