// ============================================================================
// NOVA Standard Library — std/testing/assert
// ============================================================================
// Assertion primitives that RETURN result dicts rather than calling exit().
// Every function returns {"ok": bool, "msg": string} so callers can inspect,
// accumulate, or report failures without coupling to process exit.
//
// Public API (prefix assrt_):
//   assrt_eq(a, b)            -> dict  ok iff a == b
//   assrt_ne(a, b)            -> dict  ok iff a != b
//   assrt_true(x)             -> dict  ok iff x is truthy
//   assrt_false(x)            -> dict  ok iff x is falsy
//   assrt_null(x)             -> dict  ok iff x == null
//   assrt_gt(a, b)            -> dict  ok iff a > b
//   assrt_lt(a, b)            -> dict  ok iff a < b
//   assrt_near(a, b, eps)     -> dict  ok iff |a - b| <= eps  (floats)
//   assrt_contains(hay, ndl)  -> dict  ok iff hay contains ndl
//                                       (string substring OR list membership)
//   assrt_all(results)        -> dict  ok iff every result["ok"] is truthy
// ============================================================================

// ── private helper: float absolute value ─────────────────────────────────────
// We cannot use abs() for floats reliably (it coerces through i64 in some
// contexts). Use a plain if/else which is always safe.
fn _assrt_fabs(v) -> float
    let r = v
    if v < 0.0
        r = 0.0 - v
    return r

// ── private helper: linear list-membership scan ───────────────────────────────
// Returns 1 if needle == any element of list xs (by == comparison), else 0.
fn _assrt_list_has(xs, needle) -> int
    let n = len(xs)
    let i = 0
    let found = 0
    while i < n and found == 0
        let elem = xs[i]
        if elem == needle
            found = 1
        i = i + 1
    return found

// ── assrt_eq ─────────────────────────────────────────────────────────────────
fn assrt_eq(a, b) -> dict
    let ok = 0
    if a == b
        ok = 1
    let r = {}
    r["ok"] = ok
    if ok == 1
        r["msg"] = ""
    else
        r["msg"] = "expected equal: " + str(a) + " != " + str(b)
    return r

// ── assrt_ne ─────────────────────────────────────────────────────────────────
fn assrt_ne(a, b) -> dict
    let ok = 0
    if a != b
        ok = 1
    let r = {}
    r["ok"] = ok
    if ok == 1
        r["msg"] = ""
    else
        r["msg"] = "expected not-equal: " + str(a) + " == " + str(b)
    return r

// ── assrt_true ───────────────────────────────────────────────────────────────
fn assrt_true(x) -> dict
    let ok = 0
    if x
        ok = 1
    let r = {}
    r["ok"] = ok
    if ok == 1
        r["msg"] = ""
    else
        r["msg"] = "expected truthy, got: " + str(x)
    return r

// ── assrt_false ──────────────────────────────────────────────────────────────
fn assrt_false(x) -> dict
    let ok = 0
    if not x
        ok = 1
    let r = {}
    r["ok"] = ok
    if ok == 1
        r["msg"] = ""
    else
        r["msg"] = "expected falsy, got: " + str(x)
    return r

// ── assrt_null ───────────────────────────────────────────────────────────────
fn assrt_null(x) -> dict
    let ok = 0
    if x == null
        ok = 1
    let r = {}
    r["ok"] = ok
    if ok == 1
        r["msg"] = ""
    else
        r["msg"] = "expected null, got: " + str(x)
    return r

// ── assrt_gt ─────────────────────────────────────────────────────────────────
fn assrt_gt(a, b) -> dict
    let ok = 0
    if a > b
        ok = 1
    let r = {}
    r["ok"] = ok
    if ok == 1
        r["msg"] = ""
    else
        r["msg"] = "expected " + str(a) + " > " + str(b)
    return r

// ── assrt_lt ─────────────────────────────────────────────────────────────────
fn assrt_lt(a, b) -> dict
    let ok = 0
    if a < b
        ok = 1
    let r = {}
    r["ok"] = ok
    if ok == 1
        r["msg"] = ""
    else
        r["msg"] = "expected " + str(a) + " < " + str(b)
    return r

// ── assrt_near ───────────────────────────────────────────────────────────────
// ok iff |a - b| <= eps.  Uses local float subtraction to avoid abs() int-cast.
fn assrt_near(a, b, eps) -> dict
    let diff = a - b
    let adiff = _assrt_fabs(diff)
    let ok = 0
    if adiff <= eps
        ok = 1
    let r = {}
    r["ok"] = ok
    if ok == 1
        r["msg"] = ""
    else
        r["msg"] = "expected near: |" + str(a) + " - " + str(b) + "| = " + str(adiff) + " > eps=" + str(eps)
    return r

// ── assrt_contains ───────────────────────────────────────────────────────────
// Dispatches on the runtime type of haystack:
//   string -> substring test via builtin contains()
//   list   -> linear scan for needle via ==
// Any other haystack type yields ok=false with a diagnostic message.
fn assrt_contains(haystack, needle) -> dict
    let ok = 0
    let msg = ""
    let htype = type_of(haystack)
    if htype == "string"
        if contains(haystack, needle)
            ok = 1
        if ok == 0
            msg = "expected string to contain substring: " + str(needle)
    else
        if htype == "list"
            if _assrt_list_has(haystack, needle) == 1
                ok = 1
            if ok == 0
                msg = "expected list to contain: " + str(needle)
        else
            msg = "assrt_contains: haystack must be string or list, got " + htype
    let r = {}
    r["ok"] = ok
    r["msg"] = msg
    return r

// ── assrt_all ────────────────────────────────────────────────────────────────
// ok iff every dict in the results list has ["ok"] truthy.
// Short-circuits on the first failure, capturing its message.
fn assrt_all(results) -> dict
    let n = len(results)
    let i = 0
    let all_ok = 1
    let fail_msg = ""
    while i < n and all_ok == 1
        let entry = results[i]
        if not entry["ok"]
            all_ok = 0
            fail_msg = "assrt_all: item " + str(i) + " failed: " + entry["msg"]
        i = i + 1
    let r = {}
    r["ok"] = all_ok
    if all_ok == 1
        r["msg"] = ""
    else
        r["msg"] = fail_msg
    return r
