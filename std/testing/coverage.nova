// ============================================================================
// NOVA Standard Library — std/testing/coverage
// ============================================================================
// Manual line/branch coverage recorder.  Pure NOVA, no builtins required.
// Tracks which labelled points (lines, branches, cases) were executed and
// how many times, then reports hit%, missed set, and total counts.
//
// Public API (prefix cov_):
//   cov_new()                          -> dict   empty coverage tracker
//   cov_hit(c, label)                            record label as executed once
//   cov_count(c, label)                -> int    hit count for label (0 if never)
//   cov_hit_labels(c)                  -> list   sorted list of labels hit >= 1
//   cov_percent(c, allLabels)          -> int    % of allLabels hit >= 1 (0..100)
//   cov_report(c, allLabels)           -> dict   {hit,total,percent,missed}
// ============================================================================

// cov_new() -> dict
// Returns a fresh, empty coverage tracker (internally a plain dict).
fn cov_new() -> dict
    let c = {}
    return c

// cov_hit(c, label)
// Increment the hit count for label by 1.  Creates the entry if absent.
fn cov_hit(c, label)
    if label in c
        let prev = c[label]
        c[label] = prev + 1
    else
        c[label] = 1

// cov_count(c, label) -> int
// Return the number of times label has been hit (0 if never recorded).
fn cov_count(c, label) -> int
    if label in c
        return c[label]
    return 0

// cov_hit_labels(c) -> list
// Return a sorted list of all labels that have been hit at least once.
fn cov_hit_labels(c) -> list
    let result = []
    let ks = keys(c)
    for i in 0..len(ks)
        let k = ks[i]
        let v = c[k]
        if v > 0
            result.push(k)
    return sort(result)

// cov_percent(c, allLabels) -> int
// Return the integer percentage (0..100) of allLabels that were hit >= 1.
// Returns 0 when allLabels is empty (avoid divide-by-zero).
fn cov_percent(c, allLabels) -> int
    let total = len(allLabels)
    if total == 0
        return 0
    let hit = 0
    for i in 0..total
        let lbl = allLabels[i]
        if lbl in c
            let cnt = c[lbl]
            if cnt > 0
                hit += 1
    return (hit * 100) / total

// cov_report(c, allLabels) -> dict
// Return a summary dict:
//   "hit"     : int   — number of allLabels hit at least once
//   "total"   : int   — len(allLabels)
//   "percent" : int   — integer % hit
//   "missed"  : list  — sorted list of allLabels NOT hit
fn cov_report(c, allLabels) -> dict
    let total = len(allLabels)
    let hit = 0
    let missed = []
    for i in 0..total
        let lbl = allLabels[i]
        let was_hit = 0
        if lbl in c
            let cnt = c[lbl]
            if cnt > 0
                was_hit = 1
        if was_hit == 1
            hit += 1
        else
            missed.push(lbl)
    let pct = 0
    if total > 0
        pct = (hit * 100) / total
    let r = {}
    r["hit"] = hit
    r["total"] = total
    r["percent"] = pct
    r["missed"] = sort(missed)
    return r
