// ============================================================================
// NOVA Standard Library — std/testing/mock
// ============================================================================
// Call-recording mock / stub (data-driven, no function values needed).
// A mock is represented as a plain dict — callers create one with tmock_new()
// and pass it to every operation.  This keeps the API pure-data and avoids
// any closure or function-value requirements.
//
// Internal dict layout:
//   m["calls"]   : list of recorded arg-lists  (each element is a list)
//   m["ret"]     : the configured return value  (any)
//   m["has_ret"] : int  1 = a return value has been configured, 0 = not yet
//
// Public API (prefix tmock_):
//   tmock_new()                  -> dict   create a fresh mock
//   tmock_record(m, args_list)           record one call with its args
//   tmock_call_count(m)          -> int   total number of recorded calls
//   tmock_called_with(m, args)   -> int   1 iff any call matches args exactly
//   tmock_nth_call(m, i)         -> list  args of the i-th call (0-indexed)
//   tmock_set_return(m, value)           configure the mock's return value
//   tmock_return(m)              -> any   the configured return value
//   tmock_reset(m)                       clear all recorded calls and return
//
// This file also provides a second, independent API — a multi-function spy
// tracker (prefix mk_) for recording per-function-name call counts. See the
// "Multi-function spy tracker" section below for its full documentation.
// ============================================================================

// ── private: element-wise list equality ──────────────────────────────────────
// Returns 1 iff lists a and b have the same length and a[i]==b[i] for all i.
// We cannot rely on list==list performing deep equality across all contexts,
// so we implement it explicitly.
fn _tmock_lists_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    let eq = 0
    if na == nb
        let i = 0
        let all = 1
        while i < na and all == 1
            let av = a[i]
            let bv = b[i]
            if av != bv
                all = 0
            i = i + 1
        eq = all
    return eq

// ── tmock_new ─────────────────────────────────────────────────────────────────
// Returns a freshly initialised mock dict.
fn tmock_new() -> dict
    let m = {}
    m["calls"] = []
    m["ret"] = null
    m["has_ret"] = 0
    return m

// ── tmock_record ─────────────────────────────────────────────────────────────
// Append args_list as one recorded call.  args_list should be a list of the
// arguments passed to the mock (e.g. [1, 2]).
fn tmock_record(m, args_list)
    let calls = m["calls"]
    calls.push(args_list)

// ── tmock_call_count ─────────────────────────────────────────────────────────
// Returns the number of calls recorded so far.
fn tmock_call_count(m) -> int
    let calls = m["calls"]
    return len(calls)

// ── tmock_called_with ────────────────────────────────────────────────────────
// Returns 1 if the mock was called at least once with exactly these args
// (element-wise equality), 0 otherwise.
fn tmock_called_with(m, args_list) -> int
    let calls = m["calls"]
    let n = len(calls)
    let i = 0
    let found = 0
    while i < n and found == 0
        let call = calls[i]
        if _tmock_lists_eq(call, args_list) == 1
            found = 1
        i = i + 1
    return found

// ── tmock_nth_call ───────────────────────────────────────────────────────────
// Returns the arg-list of the i-th recorded call (0-indexed).
// Returns an empty list if i is out of range.
fn tmock_nth_call(m, i) -> list
    let calls = m["calls"]
    let n = len(calls)
    let result = []
    if i >= 0 and i < n
        result = calls[i]
    return result

// ── tmock_set_return ─────────────────────────────────────────────────────────
// Configure the value that tmock_return will produce.
fn tmock_set_return(m, value)
    m["ret"] = value
    m["has_ret"] = 1

// ── tmock_return ─────────────────────────────────────────────────────────────
// Returns the configured return value (set via tmock_set_return).
// Returns null if no return value has been configured.
fn tmock_return(m)
    return m["ret"]

// ── tmock_reset ──────────────────────────────────────────────────────────────
// Clears all recorded calls and resets the configured return value.
// After reset the mock is in the same state as a freshly created one.
fn tmock_reset(m)
    m["calls"] = []
    m["ret"] = null
    m["has_ret"] = 0

// ============================================================================
// Multi-function spy tracker (prefix mk_)
// ============================================================================
// A SEPARATE, complementary API from tmock_ above. tmock_ models one mock
// with one call log (arg-lists) and one configured return value — the right
// shape for stubbing a single function. mk_ models a NAMED-FUNCTION spy
// registry: one tracker records call COUNTS for many distinct function
// names, which is the right shape for verifying "did my code call
// on_success, on_error, and on_complete, and how many times each" across a
// unit under test with several collaborator callbacks. The two APIs are
// independent and may be used together or separately.
//
// Internal dict layout:
//   m["name"] : string        the tracker's own label (informational only)
//   m["fns"]  : dict          fn_name (string) -> call count (int)
//
// Public API (prefix mk_):
//   mk_new(name)                 -> dict   create a fresh tracker
//   mk_called(m, fn_name)                 record one call to fn_name
//   mk_call_count(m, fn_name)    -> int    calls recorded for fn_name (0 if none)
//   mk_was_called(m, fn_name)    -> int    1 iff fn_name was called >=1 time
//   mk_reset(m)                           clear all recorded call counts
//   mk_verify_all(m, expected)   -> int    1 iff every name in expected (a
//                                           list of strings) was called >=1 time
// ============================================================================

// ── mk_new ────────────────────────────────────────────────────────────────────
// Returns a freshly initialised named-function spy tracker.
fn mk_new(name) -> dict
    let m = {}
    m["name"] = name
    m["fns"] = {}
    return m

// ── mk_called ────────────────────────────────────────────────────────────────
// Records one call to fn_name, incrementing its count (starting from 0).
fn mk_called(m, fn_name)
    let fns = m["fns"]
    let count = 0
    if contains(fns, fn_name)
        count = fns[fn_name]
    fns[fn_name] = count + 1

// ── mk_call_count ────────────────────────────────────────────────────────────
// Returns how many times fn_name has been recorded via mk_called.
// Returns 0 for a name that was never called.
fn mk_call_count(m, fn_name) -> int
    let fns = m["fns"]
    if contains(fns, fn_name)
        return fns[fn_name]
    return 0

// ── mk_was_called ────────────────────────────────────────────────────────────
// Returns 1 if fn_name was called at least once, 0 otherwise.
fn mk_was_called(m, fn_name) -> int
    if mk_call_count(m, fn_name) > 0
        return 1
    return 0

// ── mk_reset ─────────────────────────────────────────────────────────────────
// Clears all recorded call counts. The tracker's name is preserved.
fn mk_reset(m)
    m["fns"] = {}

// ── mk_verify_all ────────────────────────────────────────────────────────────
// Returns 1 iff every function name in `expected` (a list of strings) was
// called at least once. Returns 1 for an empty expected list (vacuously
// true). Returns 0 as soon as any expected name has a zero call count.
fn mk_verify_all(m, expected) -> int
    let n = len(expected)
    let i = 0
    let all_called = 1
    while i < n and all_called == 1
        let fn_name = expected[i]
        if mk_was_called(m, fn_name) == 0
            all_called = 0
        i = i + 1
    return all_called
