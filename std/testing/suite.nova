// ============================================================================
// NOVA Standard Library — std/testing/suite.nova
// Test suite runner: register named test functions, run them all, collect
// pass/fail results.  Pure NOVA, no new builtins.  Prefix: tsuite_
// ============================================================================
//
// Public API:
//
//   tsuite_new(name) -> dict
//     Creates a new, empty test suite with the given display name.
//     Returns a suite dict: { "name": string, "test_names": list, "test_fns": list }
//
//   tsuite_add(s, testName, testFn)
//     Registers a test in suite s.
//     testFn must be a NAMED fn taking no arguments that returns 1 (pass) or 0 (fail).
//     Mutates s in place (dict is a reference type).
//
//   tsuite_run(s) -> dict
//     Runs all registered tests in registration order.
//     Calls each testFn() with no arguments and treats the return value as
//     1=pass / 0=fail.
//     Returns:
//       {
//         "total"   : int,   // total number of tests
//         "passed"  : int,   // number that returned 1
//         "failed"  : int,   // number that returned 0
//         "results" : list   // list of [name, ok] pairs (ok = 1 or 0)
//       }
//
//   tsuite_all_pass(result) -> bool (int 1 or 0)
//     Returns 1 iff result["failed"] == 0.
// ============================================================================

// tsuite_new: allocate an empty suite dict.
fn tsuite_new(name) -> dict
    let s = {}
    s["name"] = name
    s["test_names"] = []
    s["test_fns"] = []
    return s

// tsuite_add: append a named test function to the suite.
// testFn is a named fn() -> int (1=pass, 0=fail).
fn tsuite_add(s, testName, testFn)
    let names = s["test_names"]
    let fns = s["test_fns"]
    names.push(testName)
    fns.push(testFn)

// tsuite_run: execute every registered test and collect results.
fn tsuite_run(s) -> dict
    let names = s["test_names"]
    let fns = s["test_fns"]
    let n = len(names)
    let total = n
    let passed = 0
    let failed = 0
    let results = []
    let i = 0
    while i < n
        let tname = names[i]
        let tfn = fns[i]
        let ok = tfn()
        let pair = [tname, ok]
        results.push(pair)
        if ok == 1
            passed = passed + 1
        else
            failed = failed + 1
        i = i + 1
    let r = {}
    r["total"] = total
    r["passed"] = passed
    r["failed"] = failed
    r["results"] = results
    return r

// tsuite_all_pass: true iff all tests passed.
fn tsuite_all_pass(result) -> int
    if result["failed"] == 0
        return 1
    return 0
