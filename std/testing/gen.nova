// std/testing/gen -- Deterministic test-data generators (seeded LCG).
//
// All functions are PURE and STATELESS: seed IN, next-seed/value OUT.
// No mutable state; no global; fully reproducible across platforms.
//
// Algorithm: 64-bit LCG (Knuth / MMIX constants)
//   raw  = seed * 6364136223846793005 + 1442695040888963407   (mod 2^64, wraps ok)
//   next = raw & 9223372036854775807                          (clear sign bit → >=0)
//
// NOVA ARITHMETIC NOTES:
//   * Integer multiplication wraps silently (no nsw) — that is CORRECT for LCG.
//   * >> is arithmetic (sign-extending); masking to 63 bits before any shift
//     keeps the value non-negative so arithmetic >> behaves like logical >>.
//   * Integer division '/' truncates toward zero.
//   * '%' on two non-negative operands is always non-negative.
//   * No && / || in NOVA — use 'and' / 'or' or nested if.
//   * No module-level constants — embed values inline.
//
// Public API (prefix tgen_):
//   tgen_seed_next(seed) -> int           advance the seed by one LCG step
//   tgen_int(lo, hi, seed) -> int         uniform int in [lo, hi] inclusive
//   tgen_bool(seed) -> bool               0 or 1
//   tgen_string(length, seed) -> string   lowercase ASCII letters (a-z)
//   tgen_list(n, lo, hi, seed) -> list    list of n ints in [lo, hi]
//   tgen_choice(items, seed) -> any       one element chosen from items

// ── tgen_seed_next ───────────────────────────────────────────────────────────
// Advance the seed by exactly one LCG step and return the new seed.
// This is the core RNG primitive; all other functions call it.
//
// Constants: multiplier = 6364136223846793005 (Knuth MMIX)
//            increment  = 1442695040888963407 (ditto)
//            mask63     = 9223372036854775807  (2^63 - 1; clears sign bit)
//
// The multiplication overflows i64 intentionally — NOVA wraps, which is
// exactly what a modular LCG requires.
fn tgen_seed_next(seed: int) -> int
    let m = 6364136223846793005
    let a = 1442695040888963407
    let mask = 9223372036854775807
    let raw = seed * m + a
    raw & mask

// ── tgen_int ─────────────────────────────────────────────────────────────────
// Return a deterministic int in [lo, hi] inclusive.
// Requires lo <= hi.  When lo == hi the result is always lo.
fn tgen_int(lo: int, hi: int, seed: int) -> int
    let s = tgen_seed_next(seed)
    let span = hi - lo + 1
    let r = s % span
    lo + r

// ── tgen_bool ────────────────────────────────────────────────────────────────
// Return 0 or 1 deterministically from seed.
// (Booleans in NOVA are ints; 0 = false, 1 = true.)
fn tgen_bool(seed: int) -> int
    let s = tgen_seed_next(seed)
    s % 2

// ── tgen_string ──────────────────────────────────────────────────────────────
// Return a string of exactly 'length' lowercase ASCII letters (a-z).
// Each character is derived by advancing the seed once per character.
// The seed is threaded through the loop; the caller's original seed is
// consumed only once (one advance per character position).
fn tgen_string(length: int, seed: int) -> string
    let result_parts = []
    let s = seed
    for i in 0..length
        let ns = tgen_seed_next(s)
        let idx = ns % 26
        let ch = chr(97 + idx)
        push(result_parts, ch)
        s = ns
    let result = join(result_parts, "")
    result

// ── tgen_list ────────────────────────────────────────────────────────────────
// Return a list of n ints, each in [lo, hi] inclusive.
// The seed is advanced once per element; same-seed same-result everywhere.
fn tgen_list(n: int, lo: int, hi: int, seed: int) -> list
    let result = []
    let s = seed
    let span = hi - lo + 1
    for i in 0..n
        let ns = tgen_seed_next(s)
        let r = ns % span
        result.push(lo + r)
        s = ns
    result

// ── tgen_choice ──────────────────────────────────────────────────────────────
// Return one element from items chosen deterministically by seed.
// Requires len(items) >= 1.
fn tgen_choice(items: list, seed: int) -> any
    let s = tgen_seed_next(seed)
    let n = len(items)
    let idx = s % n
    items[idx]
