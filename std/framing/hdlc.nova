// ============================================================================
// NOVA Standard Library — std/framing/hdlc
// ============================================================================
// HDLC-style async byte-framing with 0x7E flags and 0x7D byte-stuffing.
//
// HDLC (High-Level Data Link Control) uses FLAG=0x7E as a frame delimiter and
// ESC=0x7D as an escape byte. Any byte that is FLAG or ESC in the payload is
// replaced by the two-byte sequence  ESC  (byte XOR 0x20):
//
//   0x7E -> 0x7D 0x5E   (0x7E XOR 0x20 = 0x5E)
//   0x7D -> 0x7D 0x5D   (0x7D XOR 0x20 = 0x5D)
//
// The frame format is:  FLAG | stuffed-body | FLAG
//
// This is the byte-stuffing variant of HDLC framing used in PPP (RFC 1662) and
// many serial-line protocols. CRC checking is NOT included here — this module
// handles only the framing layer (stuff/unstuff, frame/deframe).
//
// PUBLIC API:
//   hdlc_stuff(data)     -> list   byte-stuff the payload (no surrounding FLAGs)
//   hdlc_unstuff(data)   -> list   remove byte stuffing
//   hdlc_frame(data)     -> list   FLAG + stuffed body + FLAG
//   hdlc_deframe(frame)  -> list   strip FLAGs, unstuff
//   hdlc_encode(data)    -> list   alias for hdlc_frame
//   hdlc_decode(frame)   -> list   alias for hdlc_deframe
//   hdlc_is_flag(b)      -> bool   true if b == 0x7E
//
// BUFFER CONVENTION: all buffers are list-of-int, each element 0..255.
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _hdlc_.
// LEAF — imports NOTHING.

// ── Constants ─────────────────────────────────────────────────────────────────

fn _hdlc_FLAG() -> int
    126

fn _hdlc_ESC() -> int
    125

fn _hdlc_XOR() -> int
    32

// ── Private helpers ───────────────────────────────────────────────────────────

// Compare two lists of ints element-by-element; returns 1 if equal, 0 if not.
fn _hdlc_list_eq(a, b) -> int
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    for i in 0..la
        if a[i] != b[i]
            return 0
    1

// ── Public API ────────────────────────────────────────────────────────────────

// hdlc_stuff: apply HDLC byte-stuffing to payload (no surrounding FLAG bytes).
//
// 0x7E (FLAG) -> 0x7D 0x5E
// 0x7D (ESC)  -> 0x7D 0x5D
// All other bytes pass through unchanged.
fn hdlc_stuff(data) -> list
    let out = []
    let n = len(data)
    let FLAG = _hdlc_FLAG()
    let ESC = _hdlc_ESC()
    let XOR = _hdlc_XOR()
    for i in 0..n
        let b = data[i] & 0xFF
        if b == FLAG or b == ESC
            push(out, ESC)
            push(out, b ^ XOR)
        else
            push(out, b)
    out

// hdlc_unstuff: remove HDLC byte stuffing; inverse of hdlc_stuff.
//
// 0x7D followed by x -> x XOR 0x20
// Malformed trailing ESC (no following byte) is silently dropped.
fn hdlc_unstuff(data) -> list
    let out = []
    let n = len(data)
    let ESC = _hdlc_ESC()
    let XOR = _hdlc_XOR()
    let i = 0
    while i < n
        let b = data[i] & 0xFF
        if b == ESC
            if i + 1 < n
                let nb = data[i + 1] & 0xFF
                push(out, (nb ^ XOR) & 0xFF)
                i += 2
            else
                // Trailing ESC without following byte: drop it.
                i += 1
        else
            push(out, b)
            i += 1
    out

// hdlc_frame: build a complete HDLC frame: FLAG + stuffed body + FLAG.
//
// Output always starts and ends with FLAG (0x7E = 126).
fn hdlc_frame(data) -> list
    let FLAG = _hdlc_FLAG()
    let body = hdlc_stuff(data)
    let out = [FLAG]
    for i in 0..len(body)
        push(out, body[i])
    push(out, FLAG)
    out

// hdlc_deframe: strip leading/trailing FLAG bytes and unstuff.
//
// Tolerates multiple leading/trailing FLAG bytes. Returns [] on empty or
// all-FLAG input.
fn hdlc_deframe(frame) -> list
    let n = len(frame)
    let FLAG = _hdlc_FLAG()
    // Strip leading FLAGs.
    let start = 0
    while start < n and (frame[start] & 0xFF) == FLAG
        start += 1
    // Strip trailing FLAGs.
    let stop = n
    while stop > start and (frame[stop - 1] & 0xFF) == FLAG
        stop -= 1
    // Extract body [start..stop).
    let body = [frame[i] & 0xFF for i in start..stop]
    hdlc_unstuff(body)

// hdlc_encode: alias for hdlc_frame (complete HDLC frame with FLAG delimiters).
fn hdlc_encode(data) -> list
    hdlc_frame(data)

// hdlc_decode: alias for hdlc_deframe (strip FLAGs and unstuff).
fn hdlc_decode(frame) -> list
    hdlc_deframe(frame)

// hdlc_is_flag: return true (1) if byte b equals the HDLC FLAG byte 0x7E.
fn hdlc_is_flag(b) -> int
    1 if (b & 0xFF) == _hdlc_FLAG() else 0
