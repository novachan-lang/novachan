// std/interval/interval_bound.nova — containment, clamp, measure on closed intervals [lo, hi].
// Intervals are 2-element lists [lo, hi].
// PREFIX: ib_   LEAF — imports nothing.
//
// FLOAT HAZARDS:
//   Always bind sub-expressions to named lets before returning float values.
//   Float vs int compare is UNSOUND — coerce with *1.0 when mixing.

// ib_width(a) -> float  Width of the interval (hi - lo).
fn ib_width(a) -> float
    let lo = a[0] * 1.0
    let hi = a[1] * 1.0
    let w = hi - lo
    w

// ib_midpoint(a) -> float  Midpoint (lo + hi) / 2.
fn ib_midpoint(a) -> float
    let lo = a[0] * 1.0
    let hi = a[1] * 1.0
    let sum = lo + hi
    let m = sum / 2.0
    m

// ib_contains_point(a, x) -> bool  True if lo <= x <= hi.
fn ib_contains_point(a, x) -> bool
    x >= a[0] and x <= a[1]

// ib_contains_interval(a, b) -> bool  True if a completely contains b (a[0]<=b[0] and b[1]<=a[1]).
fn ib_contains_interval(a, b) -> bool
    a[0] <= b[0] and b[1] <= a[1]

// ib_clamp(x, a) -> float  Clamp x to interval a.
fn ib_clamp(x, a) -> float
    let lo = a[0] * 1.0
    let hi = a[1] * 1.0
    let xf = x * 1.0
    lo if xf < lo else (hi if xf > hi else xf)

// ib_clamp_interval(a, b) -> any  Clamp interval a into interval b.
fn ib_clamp_interval(a, b) -> any
    let lo = a[0]
    let hi = a[1]
    let blo = b[0]
    let bhi = b[1]
    if lo < blo
        lo = blo
    if hi > bhi
        hi = bhi
    if lo > hi
        lo = blo
        hi = bhi
    let r = [lo, hi]
    r

// ib_is_empty(a) -> bool  True if lo > hi (degenerate/empty interval).
fn ib_is_empty(a) -> bool
    a[0] > a[1]

// ib_is_point(a) -> bool  True if lo == hi (degenerate point interval).
fn ib_is_point(a) -> bool
    a[0] == a[1]

// ib_expand(a, d) -> [lo-d, hi+d]  Grow interval by d on each side.
fn ib_expand(a, d) -> any
    let lo = a[0] - d
    let hi = a[1] + d
    let r = [lo, hi]
    r

// ib_shrink(a, d) -> [lo+d, hi-d]  Shrink interval by d on each side.
fn ib_shrink(a, d) -> any
    let lo = a[0] + d
    let hi = a[1] - d
    // Over-shrink guard: collapse to the midpoint (a point interval) if lo would
    // cross hi, rather than returning an invalid inverted interval.
    if lo > hi
        let mid = (a[0] + a[1]) / 2.0
        let rp = [mid, mid]
        return rp
    let r = [lo, hi]
    r

// ib_hull(a, b) -> any  Smallest interval containing both a and b.
fn ib_hull(a, b) -> any
    let lo = a[0]
    let hi = a[1]
    if b[0] < lo
        lo = b[0]
    if b[1] > hi
        hi = b[1]
    let r = [lo, hi]
    r

// ib_shift(a, d) -> [lo+d, hi+d]  Translate interval by d.
fn ib_shift(a, d) -> any
    let lo = a[0] + d
    let hi = a[1] + d
    let r = [lo, hi]
    r
