// std/interval/interval_merge.nova — merge overlapping/touching intervals.
// Representation: list of [lo, hi] 2-element lists (closed intervals).
// Adjacent touching intervals (e.g. [1,2] and [2,3]) ARE merged.
// PREFIX: im_  LEAF — imports nothing.
//
// Implementation note: internal operations use parallel scalar arrays
// (lo_arr, hi_arr) to avoid list-reference aliasing under NOVA's ownership model.
// Caller-facing API accepts and returns standard [[lo,hi],...] lists.

// _im_to_parallel: decompose list of [lo,hi] pairs into two scalar arrays.
fn _im_to_parallel(intervals)
    let n = len(intervals)
    let los = []
    let his = []
    for i in 0..n
        let iv = intervals[i]
        push(los, iv[0])
        push(his, iv[1])
    let r = {}
    r["los"] = los
    r["his"] = his
    return r

// _im_from_parallel: build list of [lo,hi] pairs from two scalar arrays.
fn _im_from_parallel(los, his)
    let n = len(los)
    let out = []
    for i in 0..n
        let iv = [los[i], his[i]]
        push(out, iv)
    return out

// _im_sort_parallel: insertion-sort parallel (los, his) arrays by lo endpoint.
// Uses done-flag pattern; no negative-index sentinel.
fn _im_sort_parallel(los, his)
    let n = len(los)
    for i in 1..n
        let key_lo = los[i]
        let key_hi = his[i]
        let pos = i
        let k = i - 1
        let done = false
        while k >= 0 and done == false
            if los[k] > key_lo
                los[k + 1] = los[k]
                his[k + 1] = his[k]
                pos = k
                k = k - 1
            else
                done = true
        los[pos] = key_lo
        his[pos] = key_hi

// _im_merge_parallel: merge sorted parallel arrays in place, return new count.
// Writes merged result back into los/his starting from index 0.
// Returns the number of merged intervals.
fn _im_merge_parallel(los, his)
    let n = len(los)
    if n == 0
        return 0
    let out_los = []
    let out_his = []
    let cur_lo = los[0]
    let cur_hi = his[0]
    for i in 1..n
        let iv_lo = los[i]
        let iv_hi = his[i]
        if iv_lo <= cur_hi
            if iv_hi > cur_hi
                cur_hi = iv_hi
        else
            push(out_los, cur_lo)
            push(out_his, cur_hi)
            cur_lo = iv_lo
            cur_hi = iv_hi
    push(out_los, cur_lo)
    push(out_his, cur_hi)
    // copy back into los/his
    let m = len(out_los)
    for j in 0..m
        los[j] = out_los[j]
        his[j] = out_his[j]
    return m

// _im_do_merge: full merge pipeline on a list of intervals; returns [[lo,hi],...].
fn _im_do_merge(intervals)
    let n = len(intervals)
    if n == 0
        return []
    let p = _im_to_parallel(intervals)
    let los = p["los"]
    let his = p["his"]
    _im_sort_parallel(los, his)
    let m = _im_merge_parallel(los, his)
    // build output from first m entries
    let out = []
    for i in 0..m
        let iv = [los[i], his[i]]
        push(out, iv)
    return out

// im_sort_by_lo: return a new list sorted by lo endpoint (does not mutate input).
fn im_sort_by_lo(intervals) -> any
    let n = len(intervals)
    if n == 0
        return []
    let p = _im_to_parallel(intervals)
    let los = p["los"]
    let his = p["his"]
    _im_sort_parallel(los, his)
    return _im_from_parallel(los, his)

// im_merge: merge all overlapping/touching intervals; returns sorted disjoint list.
fn im_merge(intervals) -> any
    return _im_do_merge(intervals)

// im_insert: insert interval iv into an already-merged sorted set, merging as needed.
fn im_insert(sorted_set, iv) -> any
    let n = len(sorted_set)
    let los = []
    let his = []
    for i in 0..n
        let existing = sorted_set[i]
        push(los, existing[0])
        push(his, existing[1])
    push(los, iv[0])
    push(his, iv[1])
    _im_sort_parallel(los, his)
    let m = _im_merge_parallel(los, his)
    let out = []
    for j in 0..m
        let seg = [los[j], his[j]]
        push(out, seg)
    return out

// im_total_length: sum of widths of merged intervals (float result).
fn im_total_length(intervals) -> float
    let merged = _im_do_merge(intervals)
    let n = len(merged)
    let total = 0.0
    for i in 0..n
        let iv = merged[i]
        let w = (iv[1] - iv[0]) * 1.0
        total = total + w
    return total

// im_count_merged: count of disjoint intervals after merging.
fn im_count_merged(intervals) -> int
    let merged = _im_do_merge(intervals)
    return len(merged)

// im_is_merged: true if intervals are already sorted, disjoint, and non-touching.
fn im_is_merged(intervals) -> bool
    let n = len(intervals)
    if n == 0
        return true
    if n == 1
        let iv = intervals[0]
        return iv[0] <= iv[1]
    for i in 1..n
        let prev = intervals[i - 1]
        let cur = intervals[i]
        let prev_lo = prev[0]
        let prev_hi = prev[1]
        let cur_lo = cur[0]
        let cur_hi = cur[1]
        if cur_lo < prev_lo
            return false
        if cur_lo <= prev_hi
            return false
    return true

// im_add_point: add a single-point interval [x,x] to a merged set.
fn im_add_point(intervals, x) -> any
    let pt = [x, x]
    return im_insert(intervals, pt)

// im_gaps: return the gaps within [lo, hi] not covered by the (unmerged) intervals.
fn im_gaps(intervals, lo, hi) -> any
    let merged = _im_do_merge(intervals)
    let n = len(merged)
    let out = []
    let cur = lo
    let i = 0
    while i < n
        let iv = merged[i]
        let iv_lo = iv[0]
        let iv_hi = iv[1]
        if iv_hi < cur
            i = i + 1
        else
            if iv_lo > cur and cur <= hi
                let gap_hi = iv_lo
                if gap_hi > hi
                    gap_hi = hi
                let g = [cur, gap_hi]
                push(out, g)
            if iv_hi > cur
                cur = iv_hi
            i = i + 1
    if cur < hi
        let g = [cur, hi]
        push(out, g)
    return out
