// std/interval/interval_scheduling.nova
// Activity selection / interval scheduling.
//
// Representation: interval = [lo, hi]; interval-set = list of [lo, hi].
//
// Touching-endpoint rule for scheduling: [1,3] and [3,5] are COMPATIBLE
// (a_hi <= b_lo), so both can be selected.  This differs from partition
// which treats [a,b]+[b,c] as overlapping.
//
// Public API (prefix isch_):
//   isch_sort_by_finish(intervals)     -> sorted copy (by finish time asc)
//   isch_is_compatible(a, b)           -> bool (a_hi <= b_lo)
//   isch_max_nonoverlap(intervals)     -> list (maximum non-overlapping subset)
//   isch_count(intervals)              -> int (size of max non-overlapping set)
//   isch_weighted(intervals, weights)  -> int (max weight non-overlapping — DP)
//   isch_min_rooms(intervals)          -> int (min rooms = max concurrent overlap)

// _isch_copy: shallow-copy a list of intervals
fn _isch_copy(ivs: list) -> list
    let result = []
    let n = len(ivs)
    for i in 0..n
        push(result, ivs[i])
    return result

// _isch_sort_by_finish: insertion-sort intervals by finish (hi) asc, tie-break by lo asc.
fn _isch_sort_by_finish(arr: list)
    let n = len(arr)
    let j = 1
    while j < n
        let key = arr[j]
        let khi = key[1]
        let klo = key[0]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let other = arr[k]
            let ohi = other[1]
            let olo = other[0]
            let shift = false
            if ohi > khi
                shift = true
            if ohi == khi and olo > klo
                shift = true
            if shift
                arr[k + 1] = arr[k]
                pos = k
                k = k - 1
            else
                done = true
        arr[pos] = key
        j = j + 1

// isch_sort_by_finish: return a new list sorted by finish time ascending.
fn isch_sort_by_finish(intervals: list) -> list
    let s = _isch_copy(intervals)
    _isch_sort_by_finish(s)
    return s

// isch_is_compatible: true if interval a finishes at or before b starts (a_hi <= b_lo).
fn isch_is_compatible(a: list, b: list) -> bool
    if a[1] <= b[0]
        return true
    return false

// isch_max_nonoverlap: maximum set of mutually non-overlapping intervals.
// Greedy by earliest finish time.  Touching endpoints are ALLOWED (compatible).
fn isch_max_nonoverlap(intervals: list) -> list
    let n = len(intervals)
    if n == 0
        return []
    let sorted = _isch_copy(intervals)
    _isch_sort_by_finish(sorted)
    let result = []
    push(result, sorted[0])
    let last_hi = sorted[0][1]
    for i in 1..n
        let iv = sorted[i]
        if iv[0] >= last_hi
            push(result, iv)
            last_hi = iv[1]
    return result

// isch_count: size of the maximum non-overlapping subset.
fn isch_count(intervals: list) -> int
    let sel = isch_max_nonoverlap(intervals)
    return len(sel)

// _isch_last_compat: given sorted-by-finish intervals and index j,
// find largest index p < j such that intervals[p] is compatible with intervals[j].
// Compatible = intervals[p][1] <= intervals[j][0].
// Returns -1 if none.
fn _isch_last_compat(sorted: list, j: int) -> int
    let lo = sorted[j][0]
    let best = 0 - 1
    let i = 0
    while i < j
        if sorted[i][1] <= lo
            best = i
        i = i + 1
    return best

// isch_weighted: maximum total weight of a non-overlapping subset.
// DP after sorting by finish time; find the last compatible interval for each.
// weights[i] is the weight of intervals[i] (same indexing as input).
// Returns 0 for empty input.
fn isch_weighted(intervals: list, weights: list) -> int
    let n = len(intervals)
    if n == 0
        return 0
    // Build sorted copy; carry original indices to look up weights
    // Pack as [lo, hi, original_index]
    let tagged = []
    let i = 0
    while i < n
        let iv = intervals[i]
        let triple = []
        push(triple, iv[0])
        push(triple, iv[1])
        push(triple, i)
        push(tagged, triple)
        i = i + 1
    // insertion sort tagged by finish (hi = index 1) asc
    let m = len(tagged)
    for j in 1..m
        let key = tagged[j]
        let khi = key[1]
        let klo = key[0]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let other = tagged[k]
            let ohi = other[1]
            let olo = other[0]
            let shift = false
            if ohi > khi
                shift = true
            if ohi == khi and olo > klo
                shift = true
            if shift
                tagged[k + 1] = tagged[k]
                pos = k
                k = k - 1
            else
                done = true
        tagged[pos] = key
    // dp[i] = max weight using intervals 0..i (sorted order)
    let dp = [0 for zi in 0..n]
    let orig0 = tagged[0][2]
    dp[0] = weights[orig0]
    i = 1
    while i < n
        let t = tagged[i]
        let tlo = t[0]
        let thi = t[1]
        let orig_i = t[2]
        let w_i = weights[orig_i]
        // find last compatible index p where tagged[p][1] <= tlo
        let p = 0 - 1
        for s in 0..i
            if tagged[s][1] <= tlo
                p = s
        let take_val = w_i
        if p >= 0
            take_val = take_val + dp[p]
        let skip_val = dp[i - 1]
        if take_val > skip_val
            dp[i] = take_val
        else
            dp[i] = skip_val
        i = i + 1
    return dp[n - 1]

// isch_min_rooms: minimum number of meeting rooms required so no two overlapping
// intervals share a room.  Equals maximum number of concurrently active intervals.
// Two intervals [a,b] and [b,c] touching at b do NOT share a room for scheduling
// (one ends before the other starts), but for room allocation they OVERLAP if
// b is strictly between: use strict overlap lo < other_hi and hi > other_lo
// (open-interval overlap test: lo < hi2 and lo2 < hi).
// Standard room-allocation semantics: [a,b] and [b,c] need 2 rooms iff they
// are both active at time b.  For CLOSED intervals, both are active at b.
// We use the event-sweep: sort starts and ends, increment on start, decrement
// at the end (ends are processed before starts at the same time to avoid double-counting).
fn isch_min_rooms(intervals: list) -> int
    let n = len(intervals)
    if n == 0
        return 0
    // Collect events: [time, type] where type=0 means end, type=1 means start
    // Processing end before start at same time means finishing frees room first
    let events = []
    let i = 0
    while i < n
        let iv = intervals[i]
        let ev_start = []
        push(ev_start, iv[0])
        push(ev_start, 1)
        push(events, ev_start)
        let ev_end = []
        push(ev_end, iv[1])
        push(ev_end, 0)
        push(events, ev_end)
        i = i + 1
    // insertion sort events by time asc, tie-break: end (0) before start (1)
    let ne = len(events)
    for j in 1..ne
        let key = events[j]
        let kt = key[0]
        let ktype = key[1]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let other = events[k]
            let ot = other[0]
            let otype = other[1]
            let shift = false
            if ot > kt
                shift = true
            if ot == kt and otype > ktype
                shift = true
            if shift
                events[k + 1] = events[k]
                pos = k
                k = k - 1
            else
                done = true
        events[pos] = key
    // sweep
    let cur = 0
    let best = 0
    i = 0
    while i < ne
        let ev = events[i]
        let etype = ev[1]
        if etype == 1
            cur = cur + 1
            if cur > best
                best = cur
        else
            cur = cur - 1
        i = i + 1
    return best
