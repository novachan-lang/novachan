// std/interval/interval_overlap.nova — overlap, intersection, gap for closed intervals [lo, hi].
// Intervals are 2-element lists [lo, hi].
// Closed interval semantics: touching at a single endpoint COUNTS as overlap.
// PREFIX: io_   LEAF — imports nothing.
//
// FLOAT HAZARDS:
//   Always bind sub-expressions to named lets before returning float values.
//   Float vs int compare is UNSOUND — coerce with *1.0 when mixing.

// io_overlaps(a, b) -> bool  True if closed intervals a and b share any point.
// Closed: a[0]<=b[1] and b[0]<=a[1] (touching at a point counts).
fn io_overlaps(a, b) -> bool
    a[0] <= b[1] and b[0] <= a[1]

// io_intersection(a, b) -> any  The overlapping sub-interval, or [] if disjoint.
fn io_intersection(a, b) -> any
    let lo = a[0]
    if b[0] > lo
        lo = b[0]
    let hi = a[1]
    if b[1] < hi
        hi = b[1]
    if lo > hi
        let empty = []
        return empty
    let r = [lo, hi]
    r

// io_overlap_length(a, b) -> float  Length of the overlapping region; 0.0 if disjoint.
fn io_overlap_length(a, b) -> float
    let lo = a[0]
    if b[0] > lo
        lo = b[0]
    let hi = a[1]
    if b[1] < hi
        hi = b[1]
    if lo > hi
        return 0.0
    let lof = lo * 1.0
    let hif = hi * 1.0
    let w = hif - lof
    w

// io_is_disjoint(a, b) -> bool  True if a and b do not share any point.
fn io_is_disjoint(a, b) -> bool
    a[0] > b[1] or b[0] > a[1]

// io_touches(a, b) -> bool  True if a and b share exactly one endpoint (but do not overlap in interior).
fn io_touches(a, b) -> bool
    a[1] == b[0] or b[1] == a[0]

// io_union_if_overlap(a, b) -> any  Merged interval if they overlap, else [].
fn io_union_if_overlap(a, b) -> any
    if a[0] > b[1]
        let empty = []
        return empty
    if b[0] > a[1]
        let empty = []
        return empty
    let lo = a[0]
    if b[0] < lo
        lo = b[0]
    let hi = a[1]
    if b[1] > hi
        hi = b[1]
    let r = [lo, hi]
    r

// io_contains(a, b) -> bool  True if a completely contains b (a[0]<=b[0] and b[1]<=a[1]).
fn io_contains(a, b) -> bool
    a[0] <= b[0] and b[1] <= a[1]

// io_gap(a, b) -> any  The gap between two disjoint intervals, or [] if they overlap.
// Returns the interval strictly between them (exclusive endpoints become gap's endpoints).
fn io_gap(a, b) -> any
    let a_hi = a[1]
    let b_lo = b[0]
    let b_hi = b[1]
    let a_lo = a[0]
    if a_hi >= b_lo and b_hi >= a_lo
        let empty = []
        return empty
    if a_hi < b_lo
        let r = [a_hi, b_lo]
        return r
    let r = [b_hi, a_lo]
    r

// io_symmetric_diff(a, b) -> any  List of intervals in exactly one of a or b.
// Returns a list of 0, 1, or 2 intervals.
fn io_symmetric_diff(a, b) -> any
    let result = []
    let a0 = a[0]
    let a1 = a[1]
    let b0 = b[0]
    let b1 = b[1]
    if a1 < b0 or b1 < a0
        push(result, a)
        push(result, b)
        return result
    let int_lo = a0
    if b0 > int_lo
        int_lo = b0
    let int_hi = a1
    if b1 < int_hi
        int_hi = b1
    if a0 < int_lo
        let seg = [a0, int_lo]
        push(result, seg)
    if b0 < int_lo
        let seg = [b0, int_lo]
        push(result, seg)
    if a1 > int_hi
        let seg = [int_hi, a1]
        push(result, seg)
    if b1 > int_hi
        let seg = [int_hi, b1]
        push(result, seg)
    result
