// std/algo/floyd_cycle.nova — Floyd's cycle-detection (tortoise and hare).
// KAT: test_programs/_kat_fleet7.nova
// LEAF — imports NOTHING.
//
// Operates on a FUNCTIONAL GRAPH: a list `nxt` where nxt[i] is the index of
// the single successor of node i, or -1 if node i has no successor (a
// terminal/dangling node — e.g. a plain linked list's tail). This is the
// classical setting for Floyd's algorithm (cycle detection in a linked list,
// or in the sequence x0, f(x0), f(f(x0)), ... generated by any function f).
//
// This is a distinct algorithm/topic from std/graph/floydwarshall.nova
// (Floyd-Warshall all-pairs shortest path) — same inventor, unrelated method.
//
// Public API:
//   fcy_has_cycle(nxt, start)    -> bool  true iff following nxt from start
//                                         loops forever instead of hitting -1
//   fcy_cycle_start(nxt, start)  -> int   index of the first node ON the
//                                         cycle reachable from start; -1 if
//                                         there is no cycle
//   fcy_cycle_length(nxt, start) -> int   number of nodes in the cycle; 0 if
//                                         there is no cycle
//   fcy_tail_length(nxt, start)  -> int   steps from start to the cycle entry
//                                         (mu, the "tail"/"rho-stem" length);
//                                         0 if start is itself on the cycle;
//                                         -1 if there is no cycle
//
// Algorithm: classic tortoise/hare with a fast pointer moving 2x. If the
// chain is finite (terminates at -1) with no cycle, the fast pointer reaches
// -1 and we report "no cycle". Otherwise slow and fast are guaranteed to
// meet inside the cycle. The cycle start is then found by resetting one
// pointer to `start` and advancing both one step at a time until they meet
// again (the standard 2-phase Floyd derivation). Complexity: O(mu + lambda)
// time, O(1) space.

// _fcy_step — one hop through nxt, treating any out-of-range index as -1
// (no successor), so malformed input degrades to "no cycle" rather than
// crashing.
fn _fcy_step(nxt: list, i: int) -> int
    if i < 0 or i >= len(nxt)
        return -1
    return nxt[i]

// _fcy_meet — runs tortoise/hare from start; returns the index where they
// first meet inside a cycle, or -1 if the chain terminates (no cycle).
fn _fcy_meet(nxt: list, start: int) -> int
    let slow = start
    let fast = start
    while true
        slow = _fcy_step(nxt, slow)
        if slow == -1
            return -1
        fast = _fcy_step(nxt, fast)
        if fast == -1
            return -1
        fast = _fcy_step(nxt, fast)
        if fast == -1
            return -1
        if slow == fast
            return slow
    return -1

fn fcy_has_cycle(nxt: list, start: int) -> bool
    return _fcy_meet(nxt, start) != -1

fn fcy_cycle_start(nxt: list, start: int) -> int
    let meet = _fcy_meet(nxt, start)
    if meet == -1
        return -1
    let p1 = start
    let p2 = meet
    while p1 != p2
        p1 = _fcy_step(nxt, p1)
        p2 = _fcy_step(nxt, p2)
    return p1

fn fcy_cycle_length(nxt: list, start: int) -> int
    let meet = _fcy_meet(nxt, start)
    if meet == -1
        return 0
    let count = 1
    let cur = _fcy_step(nxt, meet)
    while cur != meet
        count += 1
        cur = _fcy_step(nxt, cur)
    return count

fn fcy_tail_length(nxt: list, start: int) -> int
    let cs = fcy_cycle_start(nxt, start)
    if cs == -1
        return -1
    let count = 0
    let cur = start
    while cur != cs
        cur = _fcy_step(nxt, cur)
        count += 1
    return count
