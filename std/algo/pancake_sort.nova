// std/algo/pancake_sort.nova — Pancake sort: sort a list using only prefix
// reversals ("flips"), the classic "pancake stack" sorting problem.
// LEAF — imports nothing.
//
// Public API (prefix pcs_):
//   pcs_flip(arr, k)        -> list  reverse arr[0..k] in place, returns arr
//   pcs_max_idx(arr, n)     -> int   index of the max element within arr[0..n-1]
//   pcs_min_idx(arr, n)     -> int   index of the min element within arr[0..n-1]
//   pcs_sort(arr)           -> list  new list, sorted ascending via pancake sort
//   pcs_sort_desc(arr)      -> list  new list, sorted descending via pancake sort
//   pcs_flip_count(arr)     -> int   number of flips the ascending sort performs
//   pcs_is_sorted(arr)      -> bool  true iff arr is sorted ascending
//
// ALGORITHM (ascending): for size = n down to 2: find the index of the
// largest element within arr[0..size-1]; if it isn't already at index
// size-1, flip the prefix ending at that index (bringing the max to the
// front), then flip the prefix ending at size-1 (sending the max to its
// final resting place). At most 2*(n-1) flips total.
//
// KNOWN ANSWERS (hand-verified):
//   pcs_flip([1,2,3,4], 2)      = [3,2,1,4]
//   pcs_max_idx([3,1,4,1,5,9,2,6], 8) = 5
//   pcs_sort([5,3,4,1,2])       = [1,2,3,4,5]
//   pcs_flip_count([5,3,4,1,2]) = 4   (traced by hand against this exact algorithm)
//   pcs_flip_count([1,2,3])     = 0   (already sorted — zero flips needed)
//   pcs_flip_count([2,1])       = 1

// _pcs_copy — shallow copy of a list.
fn _pcs_copy(lst)
    let out = []
    let i = 0
    let n = len(lst)
    while i < n
        push(out, lst[i])
        i += 1
    return out

// pcs_flip — reverse the prefix arr[0..k] (inclusive) in place. Returns arr.
fn pcs_flip(arr, k)
    let lo = 0
    let hi = k
    while lo < hi
        let tmp = arr[lo]
        arr[lo] = arr[hi]
        arr[hi] = tmp
        lo += 1
        hi -= 1
    return arr

// pcs_max_idx — index of the largest element within arr[0..n-1].
fn pcs_max_idx(arr, n)
    let best = 0
    for i in 1..n
        if arr[i] > arr[best]
            best = i
    return best

// pcs_min_idx — index of the smallest element within arr[0..n-1].
fn pcs_min_idx(arr, n)
    let best = 0
    for i in 1..n
        if arr[i] < arr[best]
            best = i
    return best

// pcs_sort — pancake-sort a copy of arr into ascending order.
fn pcs_sort(arr)
    let a = _pcs_copy(arr)
    let size = len(a)
    while size > 1
        let idx = pcs_max_idx(a, size)
        if idx != size - 1
            if idx != 0
                pcs_flip(a, idx)
            pcs_flip(a, size - 1)
        size -= 1
    return a

// pcs_sort_desc — pancake-sort a copy of arr into descending order.
fn pcs_sort_desc(arr)
    let a = _pcs_copy(arr)
    let size = len(a)
    while size > 1
        let idx = pcs_min_idx(a, size)
        if idx != size - 1
            if idx != 0
                pcs_flip(a, idx)
            pcs_flip(a, size - 1)
        size -= 1
    return a

// pcs_flip_count — number of flips the ascending pancake sort performs on arr.
fn pcs_flip_count(arr)
    let a = _pcs_copy(arr)
    let size = len(a)
    let flips = 0
    while size > 1
        let idx = pcs_max_idx(a, size)
        if idx != size - 1
            if idx != 0
                pcs_flip(a, idx)
                flips += 1
            pcs_flip(a, size - 1)
            flips += 1
        size -= 1
    return flips

// pcs_is_sorted — true iff arr is sorted ascending.
fn pcs_is_sorted(arr)
    let n = len(arr)
    for i in 1..n
        if arr[i] < arr[i - 1]
            return false
    return true
