// std/algo/cycle_sort.nova — Cycle sort: an in-place comparison sort that
// minimizes the number of writes to the array (each element is written at
// most once, straight to its final sorted position), at the cost of O(n^2)
// comparisons. Useful when writes are far more expensive than reads (e.g.
// flash memory).
// LEAF — imports nothing.
//
// Public API (prefix cys_):
//   cys_sort(arr)          -> list  new list, sorted ascending
//   cys_sort_desc(arr)     -> list  new list, sorted descending
//   cys_is_sorted(arr)     -> bool  true iff arr is sorted ascending
//   cys_write_count(arr)   -> int   number of array writes cys_sort would perform
//
// ALGORITHM (ascending): for each cycle_start from 0 to n-2: take
// item = arr[cycle_start] and find pos, the position item belongs at
// (count of elements after cycle_start strictly less than item). If
// pos == cycle_start the element is already correctly placed (zero writes
// for this cycle). Otherwise, skip past duplicates of item at pos, write
// item into pos (swapping out the old occupant), and repeat the placement
// process with the displaced value until the cycle closes back at
// cycle_start, at which point the final displaced value is written into
// arr[cycle_start].
//
// KNOWN ANSWERS (hand-verified):
//   cys_sort([4,3,2,1])           = [1,2,3,4]
//   cys_sort([5,1,4,2,8,0,2])     = [0,1,2,2,4,5,8]
//   cys_sort([])                  = []
//   cys_sort_desc([1,3,2])        = [3,2,1]
//   cys_write_count([1,2,3,4,5])  = 0   (already sorted — the defining property
//                                        of cycle sort: no writes if no element
//                                        is out of place)
//   cys_write_count([1,3,2])      = 2   (hand-traced against this exact algorithm)

// _cys_copy — shallow copy of a list.
fn _cys_copy(lst)
    let n = len(lst)
    return [lst[i] for i in 0..n]

// _cys_place — count elements in a[cycle_start+1 .. n-1] strictly less than item.
fn _cys_place(a, cycle_start, item, n)
    let pos = cycle_start
    let i = cycle_start + 1
    while i < n
        if a[i] < item
            pos += 1
        i += 1
    return pos

// cys_sort — cycle-sort a copy of arr into ascending order.
fn cys_sort(arr)
    let a = _cys_copy(arr)
    let n = len(a)
    for cycle_start in 0..(n - 1)
        let item = a[cycle_start]
        let pos = _cys_place(a, cycle_start, item, n)
        if pos != cycle_start
            while item == a[pos]
                pos += 1
            let tmp = a[pos]
            a[pos] = item
            item = tmp
            while pos != cycle_start
                pos = _cys_place(a, cycle_start, item, n)
                while item == a[pos]
                    pos += 1
                let tmp2 = a[pos]
                a[pos] = item
                item = tmp2
    return a

// cys_sort_desc — cycle-sort a copy of arr into descending order by sorting
// ascending then reversing.
fn cys_sort_desc(arr)
    let a = cys_sort(arr)
    let lo = 0
    let hi = len(a) - 1
    while lo < hi
        let tmp = a[lo]
        a[lo] = a[hi]
        a[hi] = tmp
        lo += 1
        hi -= 1
    return a

// cys_is_sorted — true iff arr is sorted ascending.
fn cys_is_sorted(arr)
    let n = len(arr)
    for i in 1..n
        if arr[i] < arr[i - 1]
            return false
    return true

// cys_write_count — number of array writes cys_sort would perform on arr.
fn cys_write_count(arr)
    let a = _cys_copy(arr)
    let n = len(a)
    let cycle_start = 0
    let writes = 0
    while cycle_start < n - 1
        let item = a[cycle_start]
        let pos = _cys_place(a, cycle_start, item, n)
        if pos != cycle_start
            while item == a[pos]
                pos += 1
            let tmp = a[pos]
            a[pos] = item
            item = tmp
            writes += 1
            while pos != cycle_start
                pos = _cys_place(a, cycle_start, item, n)
                while item == a[pos]
                    pos += 1
                let tmp2 = a[pos]
                a[pos] = item
                item = tmp2
                writes += 1
        cycle_start += 1
    return writes
