// std/algo/dutch_flag.nova — Dutch National Flag 3-way partitioning.
// KAT: test_programs/_kat_fleet7.nova
// LEAF — imports NOTHING.
//
// Dijkstra's Dutch National Flag problem: partition an array into three
// contiguous regions (< pivot, == pivot, > pivot) in a SINGLE pass using
// three pointers (low, mid, high), swapping in place. This is the standard
// building block behind 3-way quicksort partitioning and duplicate-safe
// quickselect — distinct from std/collections/orderstat.nova (a balanced
// BST) and from every existing sort/search module in this tree.
//
// Public API:
//   dfg_sort_012(arr)         -> list  in-place-style sort of a list containing
//                                       ONLY the values 0, 1, 2 (returns arr)
//   dfg_partition3(arr, pivot)-> list  in-place-style 3-way partition of arr
//                                       around pivot (returns arr); the relative
//                                       order WITHIN each region is not preserved
//                                       (this is the classic unstable partition)
//   dfg_is_partitioned(arr, pivot) -> bool  true iff arr is already arranged as
//                                       [ <pivot elements ][ ==pivot elements ][ >pivot elements ]
//   dfg_quickselect(arr, k)   -> int   the k-th smallest element (0-indexed) of
//                                       arr, via repeated 3-way partitioning
//                                       (correct and efficient even when arr has
//                                       many duplicate values, unlike a plain
//                                       2-way Hoare/Lomuto quickselect)
//
// NOTE: dfg_sort_012 / dfg_partition3 / dfg_quickselect mutate the list they
// are given (NOVA list arguments are passed by reference) AND return it, so
// callers should treat the argument as consumed. Complexity: all three are
// O(n) single-pass (quickselect O(n) expected, O(n^2) worst case, same as
// any quickselect variant).

fn dfg_sort_012(arr: list) -> list
    let a = arr
    let n = len(a)
    let low = 0
    let mid = 0
    let high = n - 1
    while mid <= high
        let v = a[mid]
        if v == 0
            let t = a[low]
            a[low] = a[mid]
            a[mid] = t
            low = low + 1
            mid = mid + 1
        else if v == 1
            mid = mid + 1
        else
            let t = a[mid]
            a[mid] = a[high]
            a[high] = t
            high = high - 1
    return a

fn dfg_partition3(arr: list, pivot: int) -> list
    let a = arr
    let n = len(a)
    let low = 0
    let mid = 0
    let high = n - 1
    while mid <= high
        let v = a[mid]
        if v < pivot
            let t = a[low]
            a[low] = a[mid]
            a[mid] = t
            low = low + 1
            mid = mid + 1
        else if v > pivot
            let t = a[mid]
            a[mid] = a[high]
            a[high] = t
            high = high - 1
        else
            mid = mid + 1
    return a

fn dfg_is_partitioned(arr: list, pivot: int) -> bool
    let n = len(arr)
    let seen_eq = false
    let seen_gt = false
    for i in 0..n
        let v = arr[i]
        if v < pivot
            if seen_eq or seen_gt
                return false
        else if v == pivot
            seen_eq = true
            if seen_gt
                return false
        else
            seen_gt = true
    return true

fn dfg_quickselect(arr: list, k: int) -> int
    let a = arr
    let lo = 0
    let hi = len(a) - 1
    let answer = 0
    let done = false
    while not done
        if lo >= hi
            answer = a[lo]
            done = true
        else
            let pivot = a[lo + (hi - lo) / 2]
            let low = lo
            let mid = lo
            let high = hi
            while mid <= high
                let v = a[mid]
                if v < pivot
                    let t = a[low]
                    a[low] = a[mid]
                    a[mid] = t
                    low = low + 1
                    mid = mid + 1
                else if v > pivot
                    let t = a[mid]
                    a[mid] = a[high]
                    a[high] = t
                    high = high - 1
                else
                    mid = mid + 1
            if k < low
                hi = low - 1
            else if k > high
                lo = high + 1
            else
                answer = pivot
                done = true
    return answer
