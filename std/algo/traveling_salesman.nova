// ============================================================================
// NOVA Standard Library — std/algo/traveling_salesman
// ============================================================================
// Traveling Salesman Problem: exact solution via Held-Karp bitmask DP, plus
// a fast nearest-neighbor heuristic for comparison. Tour starts and ends at
// city 0 and visits every other city exactly once.
//
// dist: an n x n list-of-lists cost matrix (dist[i][j] = cost of i -> j).
// Not assumed symmetric. Exact solve is O(n^2 * 2^n) time / O(n * 2^n) space
// — intended for small n (roughly n <= ~16).
//
// Public API
//   tsp_solve(dist) -> dict   { "tsp_cost": int, "tsp_path": list }
//                              exact optimum via Held-Karp DP; tsp_path is a
//                              closed tour [0, ..., 0].
//   tsp_nn(dist)    -> dict   { "tsp_cost": int, "tsp_path": list }
//                              greedy nearest-neighbor heuristic tour from
//                              city 0 (fast, not guaranteed optimal).
// ============================================================================

let TSP_INF = 999999999

fn tsp_solve(dist) -> dict
    let n = len(dist)
    if n <= 1
        let res0 = {}
        res0["tsp_cost"] = 0
        res0["tsp_path"] = [0]
        return res0

    let SZ = 1 << n
    let FULL = SZ - 1

    let dp = []
    let parent = []
    let m = 0
    while m < SZ
        let row = []
        let prow = []
        let i = 0
        while i < n
            push(row, TSP_INF)
            push(prow, -1)
            i = i + 1
        push(dp, row)
        push(parent, prow)
        m = m + 1

    let dpStart = dp[1]
    dpStart[0] = 0

    let mask = 1
    while mask < SZ
        if (mask & 1) == 1
            let curRow = dp[mask]
            let i = 0
            while i < n
                if (mask & (1 << i)) != 0 and curRow[i] < TSP_INF
                    let base = curRow[i]
                    let j = 0
                    while j < n
                        if (mask & (1 << j)) == 0
                            let nmask = mask | (1 << j)
                            let cand = base + dist[i][j]
                            let nRow = dp[nmask]
                            if cand < nRow[j]
                                nRow[j] = cand
                                let nParentRow = parent[nmask]
                                nParentRow[j] = i
                        j = j + 1
                i = i + 1
        mask = mask + 1

    let fullRow = dp[FULL]
    let best = TSP_INF
    let bestEnd = -1
    let e = 1
    while e < n
        if fullRow[e] < TSP_INF
            let total = fullRow[e] + dist[e][0]
            if total < best
                best = total
                bestEnd = e
        e = e + 1

    let path = []
    let curMask = FULL
    let curNode = bestEnd
    while curNode != -1
        push(path, curNode)
        let pRow = parent[curMask]
        let pnode = pRow[curNode]
        let pmask = curMask ^ (1 << curNode)
        curMask = pmask
        curNode = pnode

    let rev = []
    let pi = len(path) - 1
    while pi >= 0
        push(rev, path[pi])
        pi = pi - 1
    push(rev, 0)

    let res = {}
    res["tsp_cost"] = best
    res["tsp_path"] = rev
    return res

fn tsp_nn(dist) -> dict
    let n = len(dist)
    if n <= 1
        let res0 = {}
        res0["tsp_cost"] = 0
        res0["tsp_path"] = [0]
        return res0

    let visited = []
    let i = 0
    while i < n
        push(visited, 0)
        i = i + 1

    let path = [0]
    visited[0] = 1
    let cost = 0
    let cur = 0
    let count = 1
    while count < n
        let bestNext = -1
        let bestD = TSP_INF
        let j = 0
        while j < n
            if visited[j] == 0 and dist[cur][j] < bestD
                bestD = dist[cur][j]
                bestNext = j
            j = j + 1
        push(path, bestNext)
        visited[bestNext] = 1
        cost = cost + bestD
        cur = bestNext
        count = count + 1
    cost = cost + dist[cur][0]
    push(path, 0)

    let res = {}
    res["tsp_cost"] = cost
    res["tsp_path"] = path
    return res
