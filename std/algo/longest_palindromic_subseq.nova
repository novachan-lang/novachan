// std/algo/longest_palindromic_subseq.nova — Longest Palindromic Subsequence (LPS)
// via O(n^2) DP, with reconstruction.
//
// DUPLICATE-SURVEY NOTE: the originally-assigned name for this slot was
// "longest_common_subseq" (LCS length / reconstruction / diff-style output).
// That is already covered extensively: std/text/lcs.nova (lcs_length/
// lcs_string/lcs_similarity), std/text/diff_lcs.nova (lcs/lcs_len/lcs_str —
// generic-list LCS, explicitly the shared foundation for the diff/patch
// modules), and std/text/lcsubstring.nova (longest common SUBSTRING).
// Rebuilding LCS would be pure duplication. This module instead solves a
// related but distinct DP problem — the Longest Palindromic Subsequence of
// a SINGLE string — which is not implemented anywhere in std/ (the "lps"
// hit in std/text/kmp.nova is KMP's unrelated "longest proper prefix which
// is also a suffix" failure-function array, not this problem; confirmed by
// its exported prefix being km_, not lps_).
//
// LPS(s) is the length of the longest subsequence of s that reads the same
// forwards and backwards. Classic reduction: LPS(s) == LCS(s, reverse(s))
// in length, but this module computes it directly with its own O(n^2)
// interval DP (dp[i][j] = LPS length of s[i..j]), which also enables direct
// backtracking to reconstruct one actual palindromic subsequence.
//
// Public API (prefix lps_):
//   lps_length(s)                    -> int     length of the LPS of s
//   lps_string(s)                    -> string  one actual LPS of s
//   lps_is_palindrome(s)             -> bool    true iff s reads the same reversed
//   lps_min_insertions_to_palindrome(s) -> int  len(s) - lps_length(s)
//
// LEAF — imports NOTHING.

// _lps_table: full (n x n) interval-DP table where table[i][j] = LPS length
// of s[i..j] inclusive (only entries with i <= j are meaningful; i > j
// entries are left at 0 and never read).
fn _lps_table(s)
    let n = len(s)
    let table = []
    for i in 0..n
        let row = []
        let j = 0
        while j < n
            push(row, 0)
            j += 1
        push(table, row)
    // Base case: single characters are palindromes of length 1.
    for k in 0..n
        table[k][k] = 1
    // Fill by increasing substring length (length 2 .. n).
    let clen = 2
    while clen <= n
        let start = 0
        while start <= n - clen
            let e = start + clen - 1
            if s[start] == s[e]
                if clen == 2
                    table[start][e] = 2
                else
                    table[start][e] = table[start + 1][e - 1] + 2
            else
                let a = table[start + 1][e]
                let b = table[start][e - 1]
                if a > b
                    table[start][e] = a
                else
                    table[start][e] = b
            start += 1
        clen += 1
    return table

// lps_length: length of the longest palindromic subsequence of s.
fn lps_length(s)
    let n = len(s)
    if n == 0
        return 0
    let table = _lps_table(s)
    return table[0][n - 1]

// lps_string: reconstruct one actual longest palindromic subsequence of s
// by backtracking the DP table from [0, n-1] inward.
fn lps_string(s)
    let n = len(s)
    if n == 0
        return ""
    if n == 1
        return s
    let table = _lps_table(s)
    let left_chars = []
    let right_chars = []
    let lo = 0
    let hi = n - 1
    while lo < hi
        if s[lo] == s[hi]
            push(left_chars, s[lo])
            push(right_chars, s[hi])
            lo += 1
            hi -= 1
        else if table[lo + 1][hi] >= table[lo][hi - 1]
            lo += 1
        else
            hi -= 1
    let mid = ""
    if lo == hi
        mid = s[lo]
    let out = ""
    let i = 0
    let nl = len(left_chars)
    while i < nl
        out += left_chars[i]
        i += 1
    out += mid
    let j = nl - 1
    while j >= 0
        out += right_chars[j]
        j -= 1
    return out

// lps_is_palindrome: true iff s reads the same forwards and backwards.
// Direct two-pointer check (O(n)), independent of the DP table.
fn lps_is_palindrome(s)
    let n = len(s)
    let lo = 0
    let hi = n - 1
    while lo < hi
        if s[lo] != s[hi]
            return false
        lo += 1
        hi -= 1
    return true

// lps_min_insertions_to_palindrome: minimum number of character insertions
// needed to turn s into a palindrome. Classic corollary: len(s) - LPS(s).
fn lps_min_insertions_to_palindrome(s)
    let n = len(s)
    if n == 0
        return 0
    return n - lps_length(s)
