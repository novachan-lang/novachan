// ============================================================================
// NOVA Standard Library — std/algo/wordladder
// ============================================================================
// Word Ladder: shortest transformation sequence between two equal-length
// words, changing exactly one letter at a time, where every intermediate
// word must appear in a supplied word list (the "dictionary"). Classic BFS
// on an implicit graph whose edges connect words that differ in exactly one
// position — this module builds that graph lazily (no upfront adjacency
// list) by scanning the dictionary for one-letter neighbors of the current
// frontier word on each BFS step.
//
// This is a DIFFERENT algorithm family from std/graph/dijkstra.nova and
// std/graph/astar.nova (weighted shortest-path / heuristic grid search):
// word-ladder edges are unweighted and derived from string edit-distance
// (Hamming distance == 1), not from an explicit weighted graph or 2D grid.
//
// Public API (prefix wl_):
//   wl_is_neighbor(a, b)          -> bool  (same length, differ in exactly 1 char)
//   wl_neighbors(word, words)     -> list  (subset of `words` that are neighbors of word)
//   wl_shortest(start, end, words) -> list (shortest word-by-word path start..end,
//                                            or [] if unreachable; [start] if start==end)
//   wl_length(start, end, words)  -> int   (word count of the shortest path, 0 if none)
//
// `words` need not contain `start`; it SHOULD contain `end` for a path to
// exist (matching the classic Leetcode-style word-ladder contract).
// ============================================================================

// _wl_diff_count: number of character positions where a and b differ.
// Returns -1 if the strings have unequal length (never neighbors).
fn _wl_diff_count(a, b) -> int
    let n = len(a)
    if n != len(b)
        return -1
    let count = 0
    for i in 0..n
        if char_at(a, i) != char_at(b, i)
            count += 1
    count

// wl_is_neighbor: true iff a and b are the same length and differ in
// exactly one character position.
fn wl_is_neighbor(a, b) -> bool
    _wl_diff_count(a, b) == 1

// wl_neighbors: every word in `words` that is a one-letter neighbor of `word`.
fn wl_neighbors(word, words) -> list
    let out = []
    let i = 0
    let n = len(words)
    while i < n
        if wl_is_neighbor(word, words[i])
            out.push(words[i])
        i += 1
    out

// _wl_copy_list: shallow copy of a list of strings.
fn _wl_copy_list(lst) -> list
    let out = []
    let i = 0
    let n = len(lst)
    while i < n
        out.push(lst[i])
        i += 1
    out

// wl_shortest: BFS shortest transformation path from `start` to `end` using
// only intermediate words present in `words`. Uses an index-pointer queue
// (no pop-from-front) so each step is O(1) amortized. Returns [] if no path
// exists; returns [start] if start == end.
fn wl_shortest(start, end, words) -> list
    if start == end
        return [start]
    let visited = {}
    visited[start] = 1
    let queue = []
    queue.push([start])
    let qi = 0
    while qi < len(queue)
        let path = queue[qi]
        qi += 1
        let last = path[len(path) - 1]
        let nbrs = wl_neighbors(last, words)
        let i = 0
        let ncount = len(nbrs)
        while i < ncount
            let cand = nbrs[i]
            if cand not in visited
                visited[cand] = 1
                let newpath = _wl_copy_list(path)
                newpath.push(cand)
                if cand == end
                    return newpath
                queue.push(newpath)
            i += 1
    []

// wl_length: number of words in the shortest transformation path (including
// both endpoints), or 0 if no path exists.
fn wl_length(start, end, words) -> int
    let p = wl_shortest(start, end, words)
    len(p)

// ============================================================================
fn main()
    print("std/algo/wordladder loaded")
