// std/algo/skyline.nova — The Skyline Problem (building silhouette), divide & conquer.
//
// DUPLICATE-SURVEY NOTE: the originally-assigned name for this slot was
// "interval_merge" (merge overlapping intervals / insert / point query / gaps).
// That exact functionality already exists, comprehensively, at
// std/interval/interval_merge.nova (prefix im_) plus ten sibling modules
// (interval_overlap, interval_stab, interval_set, interval_map, interval_bound,
// interval_partition, interval_scheduling, interval_arith, interval_tree2,
// interval_cover — overlap/intersection/gap, point-stabbing, set algebra,
// range->value maps, containment/width, atomic partitioning, activity
// selection, interval arithmetic, an interval tree with insert+point-query,
// and covering/min-stabbing-set). Rebuilding "interval_merge" would be a
// pure duplicate. This module instead solves the classically related but
// algorithmically distinct SKYLINE problem: buildings are intervals WITH a
// height, and the output is a step-function silhouette, not a merged range
// set. It reuses the "merge" spirit (the classic D&C skyline algorithm's
// merge step) while covering new ground.
//
// Representation:
//   building = [left, right, height]   (left < right, height > 0)
//   skyline  = list of [x, height] key points, strictly increasing x,
//              consecutive heights always different, terminated by a
//              synthetic [x_last, 0] point that closes the silhouette.
//
// Public API (prefix sky_):
//   sky_compute(buildings)      -> list   skyline key points via divide & conquer
//   sky_merge(left, right)      -> list   merge two skylines (the D&C merge step)
//   sky_max_height(buildings)   -> int    tallest building height (0 if empty)
//   sky_area(skyline)           -> int    silhouette area (integral of height dx)
//   sky_at(skyline, x)          -> int    height of the silhouette at x
//
// LEAF — imports NOTHING.

// _sky_sublist: build a new list from buildings[start..end) (list has no
// native slice — slice() is string-only).
fn _sky_sublist(buildings, start, end)
    return [buildings[i] for i in start..end]

// _sky_max2: max of two ints.
fn _sky_max2(a, b)
    return a if a > b else b

// sky_merge: merge two already-computed skylines (each a list of [x,h] key
// points, x ascending) into the skyline of their union. This is the classic
// merge step of the divide-and-conquer skyline algorithm: walk both point
// lists in lockstep by x, track the "current height contributed by each
// side" (h1, h2), and emit a new key point whenever max(h1,h2) changes.
fn sky_merge(left, right)
    let result = []
    let i = 0
    let j = 0
    let n1 = len(left)
    let n2 = len(right)
    let h1 = 0
    let h2 = 0
    while i < n1 and j < n2
        let x1 = left[i][0]
        let x2 = right[j][0]
        let cur_x = x1
        if x1 < x2
            cur_x = x1
            h1 = left[i][1]
            i += 1
        else if x2 < x1
            cur_x = x2
            h2 = right[j][1]
            j += 1
        else
            cur_x = x1
            h1 = left[i][1]
            h2 = right[j][1]
            i += 1
            j += 1
        let mh = _sky_max2(h1, h2)
        let m = len(result)
        if m == 0
            push(result, [cur_x, mh])
        else if result[m - 1][1] != mh
            push(result, [cur_x, mh])
    while i < n1
        let x1b = left[i][0]
        h1 = left[i][1]
        let mh1 = _sky_max2(h1, h2)
        let m1 = len(result)
        if m1 == 0
            push(result, [x1b, mh1])
        else if result[m1 - 1][1] != mh1
            push(result, [x1b, mh1])
        i += 1
    while j < n2
        let x2b = right[j][0]
        h2 = right[j][1]
        let mh2 = _sky_max2(h1, h2)
        let m2 = len(result)
        if m2 == 0
            push(result, [x2b, mh2])
        else if result[m2 - 1][1] != mh2
            push(result, [x2b, mh2])
        j += 1
    return result

// sky_compute: skyline of a set of buildings, via divide & conquer.
// Base cases: 0 buildings -> []; 1 building [l,r,h] -> [[l,h],[r,0]].
// Otherwise split in half (positional split — order-independent because
// sky_merge combines purely by x), recurse, and merge.
fn sky_compute(buildings)
    let n = len(buildings)
    if n == 0
        return []
    if n == 1
        let b = buildings[0]
        return [[b[0], b[2]], [b[1], 0]]
    let mid = n / 2
    let left_b = _sky_sublist(buildings, 0, mid)
    let right_b = _sky_sublist(buildings, mid, n)
    let left_sky = sky_compute(left_b)
    let right_sky = sky_compute(right_b)
    return sky_merge(left_sky, right_sky)

// sky_max_height: tallest building height (0 if buildings is empty).
fn sky_max_height(buildings)
    let n = len(buildings)
    let mh = 0
    for i in 0..n
        let h = buildings[i][2]
        if h > mh
            mh = h
    return mh

// sky_area: total silhouette area under a computed skyline (integral of
// height over x). Assumes the skyline's last point has height 0 (as
// produced by sky_compute) so there is no unbounded trailing strip.
fn sky_area(skyline)
    let n = len(skyline)
    let area = 0
    for i in 0..(n - 1)
        let x0 = skyline[i][0]
        let h0 = skyline[i][1]
        let x1 = skyline[i + 1][0]
        area += h0 * (x1 - x0)
    return area

// sky_at: height of the silhouette at coordinate x (0 if x is before the
// first key point or at/after the last, since the last point's height is
// always 0 by construction).
fn sky_at(skyline, x)
    let n = len(skyline)
    if n == 0
        return 0
    if x < skyline[0][0]
        return 0
    let h = 0
    for i in 0..n
        if skyline[i][0] > x
            return h
        h = skyline[i][1]
    return h
