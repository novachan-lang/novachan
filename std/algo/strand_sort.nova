// std/algo/strand_sort.nova — Strand sort: repeatedly pulls a maximal
// ascending "strand" out of the unsorted remainder (scan left to right,
// greedily taking every element that continues the run; everything else is
// pushed to a leftover list), then merges that strand into the accumulated
// sorted result. Repeats until the remainder is empty. Performs well when
// the input is already mostly composed of long ascending runs (adaptive:
// O(n) on an already-sorted list — a single strand — degrading to O(n^2)
// on a reverse-sorted list, where every element is its own strand).
// LEAF — imports NOTHING.
//
// Public API (prefix strn_):
//   strn_sort(arr)          -> list  new list, sorted ascending
//   strn_sort_desc(arr)     -> list  new list, sorted descending
//   strn_is_sorted(arr)     -> bool  true iff arr is sorted ascending
//   strn_strand_count(arr)  -> int   number of strands strn_sort would pull
//
// ALGORITHM: remaining = copy(arr); result = [].
//   while remaining is not empty:
//     last = remaining[0]; strand = [last]; leftover = []
//     for x in remaining[1:]:
//       if x >= last: strand.append(x); last = x
//       else: leftover.append(x)
//     result = merge(result, strand)   // both sides ascending, O(n) merge
//     remaining = leftover
//
// KNOWN ANSWERS (hand-traced against this exact algorithm):
//   strn_sort([5,3,4,1,2])         = [1,2,3,4,5]
//     (pass1 strand=[5] leftover=[3,4,1,2]; pass2 strand=[3,4] leftover=[1,2];
//      pass3 strand=[1,2] leftover=[]; 3 strands total)
//   strn_strand_count([5,3,4,1,2]) = 3
//   strn_strand_count([1,2,3])     = 1   (already ascending — one strand)
//   strn_strand_count([3,2,1])     = 3   (strictly descending — every
//                                          element is its own strand)
//   strn_sort([])                  = []
//   strn_sort_desc([1,4,2])        = [4,2,1]

// _strn_copy — shallow copy of a list.
fn _strn_copy(lst)
    let out = []
    let n = len(lst)
    let i = 0
    while i < n
        push(out, lst[i])
        i = i + 1
    return out

// _strn_merge — merge two ascending-sorted lists a, b into one ascending list.
fn _strn_merge(a, b)
    let out = []
    let na = len(a)
    let nb = len(b)
    let i = 0
    let j = 0
    while i < na and j < nb
        if a[i] <= b[j]
            push(out, a[i])
            i = i + 1
        else
            push(out, b[j])
            j = j + 1
    while i < na
        push(out, a[i])
        i = i + 1
    while j < nb
        push(out, b[j])
        j = j + 1
    return out

// strn_sort — strand-sort a copy of arr into ascending order.
fn strn_sort(arr)
    let remaining = _strn_copy(arr)
    let result = []
    while len(remaining) > 0
        let n = len(remaining)
        let last = remaining[0]
        let strand = []
        push(strand, last)
        let leftover = []
        let i = 1
        while i < n
            if remaining[i] >= last
                push(strand, remaining[i])
                last = remaining[i]
            else
                push(leftover, remaining[i])
            i = i + 1
        result = _strn_merge(result, strand)
        remaining = leftover
    return result

// strn_sort_desc — strand-sort a copy of arr into descending order (sort
// ascending, then reverse).
fn strn_sort_desc(arr)
    let a = strn_sort(arr)
    let lo = 0
    let hi = len(a) - 1
    while lo < hi
        let tmp = a[lo]
        a[lo] = a[hi]
        a[hi] = tmp
        lo = lo + 1
        hi = hi - 1
    return a

// strn_is_sorted — true iff arr is sorted ascending.
fn strn_is_sorted(arr)
    let n = len(arr)
    let i = 1
    while i < n
        if arr[i] < arr[i - 1]
            return false
        i = i + 1
    return true

// strn_strand_count — number of strands strn_sort would pull out of arr.
fn strn_strand_count(arr)
    let remaining = _strn_copy(arr)
    let count = 0
    while len(remaining) > 0
        let n = len(remaining)
        let last = remaining[0]
        let leftover = []
        let i = 1
        while i < n
            if remaining[i] >= last
                last = remaining[i]
            else
                push(leftover, remaining[i])
            i = i + 1
        remaining = leftover
        count = count + 1
    return count
