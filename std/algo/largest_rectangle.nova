// std/algo/largest_rectangle.nova — largest rectangle in a histogram, and its
// 2D extension (maximal all-ones rectangle in a binary matrix).
// KAT: test_programs/_kat_fleet6.nova
//
// lrh_max_area uses the classic monotonic-stack sweep: the stack holds
// histogram bar indices with STRICTLY increasing heights. When a shorter bar
// (or the sentinel at i==n) is seen, every taller bar on top of the stack is
// popped and "closed off" — its rectangle spans from the new stack top
// (exclusive) to the current index (exclusive), giving O(n) total work since
// each index is pushed and popped at most once.
//
// lrh_maximal_rectangle reduces a 0/1 matrix to a running per-column
// histogram (height[c] = consecutive 1s ending at the current row, reset to
// 0 on a 0) and reuses lrh_max_area per row — the standard O(rows*cols)
// reduction of "maximal rectangle" to "largest rectangle in histogram".
//
// Public API:
//   lrh_max_area(heights)      -> int   largest rectangle area, heights: list of int >= 0
//   lrh_maximal_rectangle(grid) -> int  grid: list of list of int (0/1 cells)
//
// LEAF — imports nothing.

// lrh_max_area: largest rectangle area under the histogram `heights`.
fn lrh_max_area(heights: list) -> int
    let n = len(heights)
    if n == 0
        return 0
    let stack = []
    let max_area = 0
    for i in 0..(n + 1)
        let h = heights[i] if i < n else 0
        while len(stack) > 0 and h < heights[stack[len(stack) - 1]]
            let top = stack[len(stack) - 1]
            pop(stack)
            let height = heights[top]
            let width = i if len(stack) == 0 else i - stack[len(stack) - 1] - 1
            let area = height * width
            if area > max_area
                max_area = area
        push(stack, i)
    return max_area

// lrh_maximal_rectangle: largest all-1s rectangle area in a 0/1 grid.
// grid must be rectangular (every row the same length as grid[0]).
fn lrh_maximal_rectangle(grid: list) -> int
    let rows = len(grid)
    if rows == 0
        return 0
    let cols = len(grid[0])
    if cols == 0
        return 0
    let heights = [0 for c0 in 0..cols]
    let best = 0
    for r in 0..rows
        let row = grid[r]
        for c in 0..cols
            heights[c] = heights[c] + 1 if row[c] == 1 else 0
        let area = lrh_max_area(heights)
        if area > best
            best = area
    return best
