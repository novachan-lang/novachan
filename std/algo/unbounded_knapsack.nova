// std/algo/unbounded_knapsack — Unbounded Knapsack DP.
//
// DUPLICATE-SURVEY NOTE: 0/1 knapsack (each item usable at most once) already
// exists as std/dp/dp_knapsack.nova (kp_max_value/kp_selected/kp_fits_count).
// This module solves the UNBOUNDED variant — each item may be selected any
// number of times — which is a genuinely different DP recurrence (ascending
// capacity loop that revisits the same row, allowing reuse) rather than a
// thin rename of the 0/1 solver (which iterates capacity DESCENDING per item
// specifically to prevent reuse). No existing std module covers this.
//
// weights/values are parallel lists of item weight/value. An item whose
// weight is <= 0 would be "free to repeat infinitely" (unbounded value) —
// such items are SKIPPED rather than exploited, so results stay finite and
// meaningful for any input instead of silently returning a nonsense answer.
//
// PUBLIC API (prefix ukn_):
//   ukn_solve(weights, values, capacity)  -> int   max total value reachable
//   ukn_table(weights, values, capacity)  -> list  dp[0..capacity], dp[w] =
//                                                    best value for capacity w
//   ukn_counts(weights, values, capacity) -> list  how many times each item
//                                                    (by index) is used in
//                                                    ONE optimal solution
//                                                    (len == len(weights))
//
// LEAF — imports NOTHING.

// _ukn_build: core DP pass. Returns [dp, choice] where dp[w] is the best
// value for capacity w and choice[w] is the index of the item whose use
// achieved that best value (-1 if capacity w is best left as "nothing
// added at this step" / unreachable improvement).
fn _ukn_build(weights: list, values: list, capacity: int) -> list
    let n = len(weights)
    let dp = [0 for w in 0..(capacity + 1)]
    let choice = [-1 for w in 0..(capacity + 1)]
    for cw in 1..(capacity + 1)
        let best = dp[cw]
        let best_item = -1
        for i in 0..n
            let wt = weights[i]
            if wt > 0 and wt <= cw
                let cand = dp[cw - wt] + values[i]
                if cand > best
                    best = cand
                    best_item = i
        dp[cw] = best
        choice[cw] = best_item
    return [dp, choice]

// ukn_solve: maximum total value achievable filling capacity with unlimited
// reuse of each item, weight <= capacity.
fn ukn_solve(weights: list, values: list, capacity: int) -> int
    if capacity <= 0
        return 0
    let n = len(weights)
    if n == 0
        return 0
    let built = _ukn_build(weights, values, capacity)
    let dp = built[0]
    return dp[capacity]

// ukn_table: the full dp array, length capacity+1, dp[w] = best value for
// capacity exactly w (i.e. using AT MOST w of the capacity).
fn ukn_table(weights: list, values: list, capacity: int) -> list
    if capacity < 0
        return []
    let n = len(weights)
    if n == 0
        return [0 for w in 0..(capacity + 1)]
    let built = _ukn_build(weights, values, capacity)
    return built[0]

// ukn_counts: for one optimal solution, how many times item i is used.
// Backtracks the choice[] pointers from `capacity` down to 0.
fn ukn_counts(weights: list, values: list, capacity: int) -> list
    let n = len(weights)
    let counts = [0 for ci in 0..n]
    if capacity <= 0 or n == 0
        return counts
    let built = _ukn_build(weights, values, capacity)
    let choice = built[1]
    let rem = capacity
    while rem > 0
        let item = choice[rem]
        if item == -1
            rem = 0
        else
            counts[item] += 1
            rem -= weights[item]
    return counts

fn main()
    print("std/algo/unbounded_knapsack loaded")
