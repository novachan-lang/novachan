// std/bits/bittricks.nova — branchless integer bit-trick utilities.
// All inputs are i64 (NOVA int). Operations use two's-complement identities.
// LEAF — imports NOTHING.
//
// SHIFT SAFETY: >> in NOVA is arithmetic (sign-extending).
// Branchless patterns used here work on signed i64 without masking because:
//   tk_abs/tk_sign use the sign bit directly (bit 63).
//   tk_average, tk_min, tk_max operate on NON-NEGATIVE inputs per contract.
// PRECEDENCE: all bit-ops are fully parenthesized to avoid NOVA's looser
// binding of & | ^ relative to == and comparison operators.

// tk_abs — branchless absolute value via sign-mask trick.
// s = x >> 63 produces -1 (all ones) for negative x, 0 for non-negative.
// abs(x) = (x ^ s) - s.
fn tk_abs(x: int) -> int
    let s = x >> 63
    (x ^ s) - s

// tk_sign — returns -1 for negative x, 0 for zero, +1 for positive x.
// Two-term branchless form:
//   (x >> 63)          = -1 for x < 0, else 0.
//   (((0-x) >> 63) & 1) = 1  for x > 0, else 0.
// OR-ing these gives -1 / 0 / 1 correctly.
fn tk_sign(x: int) -> int
    let neg_mask = x >> 63
    let pos_bit = ((0 - x) >> 63) & 1
    neg_mask | pos_bit

// tk_is_opposite_sign — true iff a and b have strictly opposite signs.
// (a XOR b) is negative (bit 63 set) exactly when a and b differ in sign bit.
fn tk_is_opposite_sign(a: int, b: int) -> bool
    ((a ^ b) >> 63) == (-1)

// tk_average — overflow-safe floor mean of two NON-NEGATIVE integers.
// Formula: (a & b) + ((a ^ b) >> 1).
// This avoids the overflow of (a + b) / 2.
// >> 1 on a non-negative value is a logical right shift (no sign extension).
fn tk_average(a: int, b: int) -> int
    (a & b) + ((a ^ b) >> 1)

// tk_min — branchless minimum of two integers.
// Uses the identity: min(a,b) = b + ((a - b) & ((a - b) >> 63)).
// (a - b) >> 63 = -1 when a < b, 0 when a >= b.
// So: b + (a-b) = a when a < b; b + 0 = b when a >= b.
fn tk_min(a: int, b: int) -> int
    let diff = a - b
    let mask = diff >> 63
    b + (diff & mask)

// tk_max — branchless maximum of two integers.
// Uses: max(a,b) = a - ((a - b) & ((a - b) >> 63)).
// When a < b: (a - b) & mask = (a - b) & -1 = a - b; result = a - (a - b) = b.
// When a >= b: mask = 0; result = a - 0 = a.
fn tk_max(a: int, b: int) -> int
    let diff = a - b
    let mask = diff >> 63
    a - (diff & mask)

// tk_conditional_negate — negate x iff neg == 1, branchless.
// When neg == 1: mask = all-ones (-1); result = (x ^ -1) - (-1) = -x - 1 + 1 = -x.
// When neg == 0: mask = 0; result = (x ^ 0) - 0 = x.
fn tk_conditional_negate(x: int, neg: int) -> int
    // mask: neg=1 → -1=all-ones; neg=0 → 0.
    let mask = -neg
    (x ^ mask) - mask
