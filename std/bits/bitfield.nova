// std/bits/bitfield.nova — bit-field extraction, deposit, and single-bit ops.
// All operations on i64 integers; no width restriction (bit positions 0-based).
// LEAF — imports NOTHING.
//
// SHIFT SAFETY: >> in NOVA is arithmetic. Right-shifts here are preceded by
// masking with bf_mask(len) so operands are non-negative (logical == arithmetic).
// All bit-ops parenthesised explicitly to defeat NOVA's looser precedence rules.
//
// Public API:
//   bf_mask(len)              -> int   the len-bit all-ones low mask
//   bf_get(x, i)              -> int   bit i of x as 0 or 1
//   bf_set(x, i)              -> int   return x with bit i set
//   bf_clear(x, i)            -> int   return x with bit i cleared
//   bf_toggle(x, i)           -> int   return x with bit i flipped
//   bf_test(x, i)             -> bool  true iff bit i of x is set
//   bf_extract(x, pos, len)   -> int   the len-bit field starting at bit pos
//   bf_deposit(x, val, pos, len) -> int  replace the len-bit field at pos with val

// bf_mask — a low mask of exactly `len` set bits.
// len must be in 0..62 (NOVA: 1<<64 is broken; (1<<63) is the max safe shift).
// For len=0 returns 0; for len=1 returns 1; for len=8 returns 255; etc.
fn bf_mask(len: int) -> int
    if len <= 0
        return 0
    (1 << len) - 1

// bf_get — return bit i of x as an integer: 0 or 1.
fn bf_get(x: int, i: int) -> int
    (x >> i) & 1

// bf_set — return x with bit i set to 1.
fn bf_set(x: int, i: int) -> int
    x | (1 << i)

// bf_clear — return x with bit i cleared to 0.
// Invert the single-bit mask using XOR with all-ones, then AND.
fn bf_clear(x: int, i: int) -> int
    let bit_mask = 1 << i
    let inv_mask = bit_mask ^ (-1)
    x & inv_mask

// bf_toggle — return x with bit i flipped.
fn bf_toggle(x: int, i: int) -> int
    x ^ (1 << i)

// bf_test — true iff bit i of x is set.
fn bf_test(x: int, i: int) -> bool
    ((x >> i) & 1) == 1

// bf_extract — return the len-bit field of x starting at bit position pos.
// Shifts x right by pos, then masks to len bits.
// len must be in 0..62.
fn bf_extract(x: int, pos: int, len: int) -> int
    let shifted = x >> pos
    shifted & bf_mask(len)

// bf_deposit — replace the len-bit field of x at bit position pos with val.
// Clears the field in x, masks val to len bits, shifts it to pos, then ORs in.
fn bf_deposit(x: int, val: int, pos: int, len: int) -> int
    let m = bf_mask(len)
    let clear_mask = (m << pos) ^ (-1)
    let cleared = x & clear_mask
    let field = (val & m) << pos
    cleared | field
