// std/bits/zigzag.nova — ZigZag encoding and sign-extension utilities.
//
// ZigZag maps signed integers to non-negative integers so that small absolute
// values map to small unsigned values. Used in Protocol Buffers varint encoding.
//
//   encode: Z → N   n ↦ (n << 1) ^ (n >> 63)
//   decode: N → Z   u ↦ if (u & 1) then -(u/2)-1 else u/2
//
// The decode formula avoids the need for a logical right-shift (which NOVA does
// not have directly — >> is arithmetic) by using integer division on non-negative
// encoded values; u is always >= 0 by construction.
//
// Public API
//   zz_encode(n)          -> int   map signed i64 n to unsigned ZigZag code
//   zz_decode(u)          -> int   map ZigZag code u back to signed i64
//   zz_sign_extend(x, b)  -> int   sign-extend the low b bits of x as a signed value
//   zz_twos_complement(x, b) -> int  interpret low b bits of x as b-bit two's complement

// Map a signed integer to its ZigZag unsigned encoding.
fn zz_encode(n: int) -> int
    (n << 1) ^ (n >> 63)

// Map a ZigZag unsigned code back to a signed integer.
// u must be >= 0 (the output of zz_encode is always non-negative).
// Uses integer division (not right-shift) to avoid arithmetic-shift sign issues.
fn zz_decode(u: int) -> int
    let q = u / 2
    if (u & 1) == 1
        return (0 - q) - 1
    q

// Sign-extend the low `bits` bits of x, treating them as a signed two's-complement value.
// For bits in 1..62; behaviour is undefined for bits <= 0 or bits >= 64.
// Algorithm: mask to low bits, then if the sign bit of the field is set, subtract 2^bits.
fn zz_sign_extend(x: int, bits: int) -> int
    let mask = (1 << bits) - 1
    let val = x & mask
    let sign_bit = 1 << (bits - 1)
    if (val & sign_bit) != 0
        return val - (1 << bits)
    val

// Interpret the low `bits` bits of x as a signed two's-complement value.
// Equivalent to zz_sign_extend but named for the two's-complement framing.
fn zz_twos_complement(x: int, bits: int) -> int
    let mask = (1 << bits) - 1
    let val = x & mask
    let sign_bit = 1 << (bits - 1)
    if (val & sign_bit) != 0
        return val - (1 << bits)
    val
