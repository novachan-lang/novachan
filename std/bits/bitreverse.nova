// std/bits/bitreverse.nova — bit-order and byte-order reversal.
// Operates on values masked to the given width (8, 16, 32 bits as appropriate).
// LEAF — imports NOTHING.
//
// SHIFT SAFETY: >> in NOVA is arithmetic (sign-extending).
// All right-shifts here operate on values that have been masked to their stated
// width first, so the top bits of the i64 are 0, making >> behave logically.
// Parenthesisation of all bit-ops is explicit to defeat NOVA's looser bit-op
// precedence vs comparison operators.
//
// Public API:
//   rev_reverse_bits(x, width) -> int   reverse the low `width` bits of x
//   rev_byteswap16(x)          -> int   reverse byte order of a 16-bit value
//   rev_byteswap32(x)          -> int   reverse byte order of a 32-bit value
//   rev_nibbleswap8(x)         -> int   swap the two nibbles of a byte
//   rev_reverse_byte(x)        -> int   reverse all 8 bits of a byte

// rev_reverse_bits — reverse the low `width` bits of x (width in 1..32).
// Uses a loop to extract each bit from x and deposit it at the mirror position.
// Works for any width from 1 to 32; keeps values non-negative by masking.
fn rev_reverse_bits(x: int, width: int) -> int
    let mask = (1 << width) - 1
    let v = x & mask
    let result = 0
    let i = 0
    while i < width
        let bit = (v >> i) & 1
        result = result | (bit << (width - 1 - i))
        i = i + 1
    result & mask

// rev_byteswap16 — reverse the byte order of a 16-bit value.
// 0xABCD -> 0xCDAB. Input is masked to 16 bits; result is non-negative.
fn rev_byteswap16(x: int) -> int
    let v = x & 0xFFFF
    let lo = v & 0xFF
    let hi = (v >> 8) & 0xFF
    (lo << 8) | hi

// rev_byteswap32 — reverse the byte order of a 32-bit value.
// 0x12345678 -> 0x78563412. Input is masked to 32 bits; result is non-negative.
fn rev_byteswap32(x: int) -> int
    let v = x & 0xFFFFFFFF
    let b0 = v & 0xFF
    let b1 = (v >> 8) & 0xFF
    let b2 = (v >> 16) & 0xFF
    let b3 = (v >> 24) & 0xFF
    (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

// rev_nibbleswap8 — swap the two 4-bit nibbles of a byte.
// 0x12 -> 0x21. Input is masked to 8 bits.
fn rev_nibbleswap8(x: int) -> int
    let v = x & 0xFF
    let lo = v & 0x0F
    let hi = (v >> 4) & 0x0F
    (lo << 4) | hi

// rev_reverse_byte — reverse all 8 bits of a byte.
// Bit 7 becomes bit 0, bit 6 becomes bit 1, etc.
// Uses the parallel bit-reversal technique for efficiency.
fn rev_reverse_byte(x: int) -> int
    let v = x & 0xFF
    // Swap odd/even bits: bits 7,5,3,1 <-> bits 6,4,2,0
    let m1 = 0xAA
    let m2 = 0x55
    let v2 = (((v & m1) >> 1) | ((v & m2) << 1)) & 0xFF
    // Swap adjacent pairs: bits 7:6,3:2 <-> bits 5:4,1:0
    let m3 = 0xCC
    let m4 = 0x33
    let v3 = (((v2 & m3) >> 2) | ((v2 & m4) << 2)) & 0xFF
    // Swap nibbles: bits 7:4 <-> bits 3:0
    let m5 = 0xF0
    let m6 = 0x0F
    (((v3 & m5) >> 4) | ((v3 & m6) << 4)) & 0xFF
