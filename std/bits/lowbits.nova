// std/bits/lowbits.nova — Low-bit manipulation primitives on i64 values.
//
// All operations work on the raw i64 bit-pattern. Correct for both positive
// and negative (two's-complement) inputs. NOVA >> is arithmetic, so any
// unsigned-shift logic is handled by masking before shifting where needed.
//
// Public API
//   lb_isolate_lowest(x)    -> int   isolate lowest set bit (x & (0-x)); 0 if x==0
//   lb_clear_lowest(x)      -> int   clear lowest set bit (x & (x-1))
//   lb_lowest_index(x)      -> int   0-based index of lowest set bit; -1 if x==0
//   lb_set_lowest_clear(x)  -> int   set lowest 0 bit (x | (x+1))
//   lb_trailing_ones(x)     -> int   count of trailing 1 bits
//   lb_mask_to_lowest(x)    -> int   mask from bit 0 up through lowest set bit (x ^ (x-1))

// Isolate the lowest set bit; returns 0 when x == 0.
fn lb_isolate_lowest(x: int) -> int
    if x == 0
        return 0
    x & (0 - x)

// Clear the lowest set bit; x & (x-1). Returns 0 when x==0 or x has one bit.
fn lb_clear_lowest(x: int) -> int
    x & (x - 1)

// Return the 0-based index of the lowest set bit, or -1 if x == 0.
// Computed by isolating the lowest bit and counting how many times we right-shift by 1 to reach 1.
fn lb_lowest_index(x: int) -> int
    if x == 0
        return -1
    let bit = x & (0 - x)
    let idx = 0
    let cur = bit
    while (cur & 1) == 0
        cur = cur >> 1
        idx += 1
    idx

// Set the lowest clear (0) bit: x | (x+1).
fn lb_set_lowest_clear(x: int) -> int
    x | (x + 1)

// Count trailing 1 bits.
// We clear trailing ones by complementing (all-0 run at end) then count trailing 0s of that.
// Simpler direct approach: count how many consecutive low bits are 1.
fn lb_trailing_ones(x: int) -> int
    let count = 0
    let cur = x
    while (cur & 1) == 1
        count += 1
        cur = cur >> 1
    count

// Mask covering bit 0 through the lowest set bit (inclusive): x ^ (x-1).
// For x==0 returns all-ones (-1 in two's complement, i.e. 0xFFFFFFFFFFFFFFFF).
fn lb_mask_to_lowest(x: int) -> int
    x ^ (x - 1)
