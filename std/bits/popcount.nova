// std/bits/popcount.nova — Population count (Hamming weight) over 64-bit integers.
// All functions are pure, deterministic, and import nothing.
// SHIFT SAFETY: >> is arithmetic in NOVA. We isolate each bit via (x >> i) & 1,
// which is correct even for negative x because &1 discards the sign extension.

// pc_popcount — count the number of set bits across all 64 positions of x.
// Iterates i=0..63 and accumulates ((x >> i) & 1).
fn pc_popcount(x: int) -> int
    let count = 0
    for i in 0..64
        count = count + ((x >> i) & 1)
    count

// pc_parity — 1 if the number of set bits in x is odd, 0 if even.
fn pc_parity(x: int) -> int
    pc_popcount(x) & 1

// pc_hamming_weight — alias for pc_popcount (count of set bits = Hamming weight).
fn pc_hamming_weight(x: int) -> int
    pc_popcount(x)

// pc_hamming_distance — number of bit positions where a and b differ.
// Equals the popcount of (a XOR b).
fn pc_hamming_distance(a: int, b: int) -> int
    pc_popcount(a ^ b)

// pc_popcount_byte — count set bits in the low 8 bits of x only.
// Masks x to [0..255] before counting, so bits above position 7 are ignored.
fn pc_popcount_byte(x: int) -> int
    let v = x & 255
    let count = 0
    for i in 0..8
        count = count + ((v >> i) & 1)
    count
