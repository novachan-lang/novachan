// std/bits/bitpack.nova — Bit-field packing and unpacking utilities.
//
// Fields are packed LSB-first: field[0] occupies bits [0, w0-1], field[1]
// occupies bits [w0, w0+w1-1], and so on. Field values must fit in their
// declared widths; overflow bits are silently masked out.
//
// RGB-565 layout (standard 16-bit colour): R occupies bits [15:11] (5 bits),
// G occupies bits [10:5] (6 bits), B occupies bits [4:0] (5 bits).
//
// Public API
//   pk_pack(fields)         -> int        pack list of [value,width] pairs, LSB-first
//   pk_unpack(packed, widths) -> list     unpack an int into list of signed i64 fields
//   pk_rgb565(r, g, b)      -> int        encode r[0..31], g[0..63], b[0..31] to RGB-565
//   pk_unrgb565(v)          -> list       decode RGB-565 int to [r, g, b]

// Pack a list of [value, width] pairs into a single integer, LSB-first.
// fields[0] occupies the lowest bits, fields[1] the next group, etc.
// Each value is masked to its declared width before placement.
fn pk_pack(fields: list) -> int
    let result = 0
    let shift = 0
    for i in 0..len(fields)
        let pair = fields[i]
        let val = pair[0]
        let w = pair[1]
        let mask = (1 << w) - 1
        result = result | ((val & mask) << shift)
        shift = shift + w
    result

// Unpack a packed integer into a list of field values given a list of widths.
// widths[0] is the number of bits for the lowest field, etc.
// Each extracted value is non-negative (masked to its width; no sign extension).
fn pk_unpack(packed: int, widths: list) -> list
    let result = []
    let shift = 0
    for i in 0..len(widths)
        let w = widths[i]
        let mask = (1 << w) - 1
        let val = (packed >> shift) & mask
        push(result, val)
        shift = shift + w
    result

// Encode 5-bit R, 6-bit G, 5-bit B components into a 16-bit RGB-565 value.
// R occupies bits [15:11], G occupies bits [10:5], B occupies bits [4:0].
fn pk_rgb565(r: int, g: int, b: int) -> int
    let rm = r & 31
    let gm = g & 63
    let bm = b & 31
    (rm << 11) | (gm << 5) | bm

// Decode a 16-bit RGB-565 value into a list [r, g, b].
// R = bits [15:11], G = bits [10:5], B = bits [4:0].
fn pk_unrgb565(v: int) -> list
    let r = (v >> 11) & 31
    let g = (v >> 5) & 63
    let b = v & 31
    let out = []
    push(out, r)
    push(out, g)
    push(out, b)
    out
