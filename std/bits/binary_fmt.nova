// std/bits/binary_fmt.nova — convert non-negative integers to/from binary strings.
// All numeric inputs must satisfy n >= 0. String inputs must be '0'/'1' digit sequences.
// LEAF — imports NOTHING.
//
// SHIFT SAFETY: >> is arithmetic in NOVA. All bit-extraction uses (n >> i) & 1
// where n >= 0 (contract), so arithmetic >> equals logical >> for i in 0..62.
// PRECEDENCE: all bit-ops are fully parenthesized to avoid NOVA's looser
// binding of & | ^ relative to == and comparison operators.

// bfm_to_binary — binary string of n (n >= 0), zero-padded to exactly `width` chars.
// Emits the low `width` bits from MSB to LSB.
fn bfm_to_binary(n: int, width: int) -> string
    let result = ""
    let i = width - 1
    while i >= 0
        let bit = (n >> i) & 1
        result = result + str(bit)
        i = i - 1
    result

// bfm_to_binary_min — binary string with no leading zeros; returns "0" for n == 0.
fn bfm_to_binary_min(n: int) -> string
    if n == 0
        return "0"
    // Find position of highest set bit (width of the value).
    let width = 1
    let tmp = n >> 1
    while tmp > 0
        width = width + 1
        tmp = tmp >> 1
    bfm_to_binary(n, width)

// bfm_from_binary — parse a binary string of '0' and '1' digits to an int.
// Processes left-to-right (MSB first). Non '0'/'1' characters are skipped.
fn bfm_from_binary(s: string) -> int
    let result = 0
    let i = 0
    let n = len(s)
    while i < n
        let ch = slice(s, i, i + 1)
        if ch == "1"
            result = (result << 1) | 1
        if ch == "0"
            result = result << 1
        i = i + 1
    result

// bfm_group — insert sep every `size` chars from the RIGHT into string s.
// Example: bfm_group("11110000", 4, " ") -> "1111 0000".
// The leftmost group may be shorter than `size` if len(s) is not a multiple.
fn bfm_group(s: string, size: int, sep: string) -> string
    let n = len(s)
    if size <= 0 or n == 0
        return s
    // Collect groups right-to-left into a list, then reverse-join.
    let groups = []
    let right = n
    while right > 0
        let left = right - size
        if left < 0
            left = 0
        push(groups, slice(s, left, right))
        right = left
    // groups[0] = rightmost group; reconstruct left-to-right with sep.
    let out = ""
    let i = len(groups) - 1
    while i >= 0
        if len(out) > 0
            out = out + sep
        out = out + groups[i]
        i = i - 1
    out

// bfm_count_ones_str — count the number of '1' characters in string s.
fn bfm_count_ones_str(s: string) -> int
    let count = 0
    let i = 0
    let n = len(s)
    while i < n
        if slice(s, i, i + 1) == "1"
            count = count + 1
        i = i + 1
    count
