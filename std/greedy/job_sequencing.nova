// std/greedy/job_sequencing.nova — Greedy job sequencing with deadlines to maximize profit.
// Each job takes 1 time unit. Jobs are scheduled into slots 1..max_deadline.
// Greedy: sort by profit descending; assign each job to the latest free slot <= its deadline.
// LEAF — imports NOTHING.

// _js_sort_by_profit_desc: return index array sorted by profits[i] descending (selection sort).
fn _js_sort_by_profit_desc(profits: list) -> list
    let n = len(profits)
    let order = []
    let i = 0
    while i < n
        push(order, i)
        i = i + 1
    let pos = 0
    while pos < n
        let best = pos
        let j = pos + 1
        while j < n
            if profits[order[j]] > profits[order[best]]
                best = j
            j = j + 1
        let tmp = order[pos]
        order[pos] = order[best]
        order[best] = tmp
        pos = pos + 1
    return order

// _js_max_deadline: find the maximum value in deadlines.
fn _js_max_deadline(deadlines: list) -> int
    let n = len(deadlines)
    if n == 0
        return 0
    let m = deadlines[0]
    let i = 1
    while i < n
        if deadlines[i] > m
            m = deadlines[i]
        i = i + 1
    return m

// _js_schedule: core — returns slots array (slot[i]=-1 means free, else holds job index).
// Slots are 0-indexed internally (slot 0 = deadline slot 1).
fn _js_schedule(deadlines: list, profits: list) -> list
    let n = len(deadlines)
    let maxd = _js_max_deadline(deadlines)
    let slots = []
    let k = 0
    while k < maxd
        push(slots, -1)
        k = k + 1
    let order = _js_sort_by_profit_desc(profits)
    let oi = 0
    while oi < n
        let job = order[oi]
        let d = deadlines[job]
        // find the latest free slot at position d-1 down to 0
        let s = d - 1
        let placed = false
        while s >= 0 and not placed
            if slots[s] == -1
                slots[s] = job
                placed = true
            s = s - 1
        oi = oi + 1
    return slots

// js_max_profit: total profit of the optimal job schedule respecting deadlines.
fn js_max_profit(deadlines: list, profits: list) -> int
    let n = len(deadlines)
    if n == 0
        return 0
    let slots = _js_schedule(deadlines, profits)
    let total = 0
    let i = 0
    while i < len(slots)
        if slots[i] != -1
            total = total + profits[slots[i]]
        i = i + 1
    return total

// js_count_scheduled: number of jobs successfully scheduled.
fn js_count_scheduled(deadlines: list, profits: list) -> int
    let n = len(deadlines)
    if n == 0
        return 0
    let slots = _js_schedule(deadlines, profits)
    let count = 0
    let i = 0
    while i < len(slots)
        if slots[i] != -1
            count = count + 1
        i = i + 1
    return count
