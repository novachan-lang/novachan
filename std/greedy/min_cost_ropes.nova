// std/greedy/min_cost_ropes.nova — minimum cost to connect ropes by repeatedly merging shortest pair. LEAF — imports NOTHING.

// _mcr_find_min_idx: return index of minimum element in arr, ignoring index skip.
//   skip=-1 means no index to skip.
fn _mcr_find_min_idx(arr: list, skip: int) -> int
    let n = len(arr)
    let best_idx = -1
    for i in 0..n
        if i != skip
            if best_idx == -1
                best_idx = i
            else
                if arr[i] < arr[best_idx]
                    best_idx = i
    return best_idx

// mcr_min_cost: minimum total cost to connect all ropes into one rope.
//   Cost of connecting two ropes = sum of their lengths. Always connect the two shortest.
//   Returns 0 for 0 or 1 rope (no merges needed).
fn mcr_min_cost(lengths: list) -> int
    let n = len(lengths)
    if n <= 1
        return 0
    // copy into a working list so we can mutate
    let arr = [lengths[i] for i in 0..n]
    let total_cost = 0
    // we need exactly n-1 merges; after each merge the list shrinks by 1
    // simulate by shrinking the arr each iteration
    let remaining = n
    while remaining > 1
        // find index of the smallest element
        let idx1 = _mcr_find_min_idx(arr, -1)
        // find index of second smallest (skip idx1)
        let idx2 = _mcr_find_min_idx(arr, idx1)
        let merged = arr[idx1] + arr[idx2]
        total_cost += merged
        // replace the element at idx1 with merged, remove idx2 by overwriting with last
        arr[idx1] = merged
        // remove idx2: swap with last, shrink
        let last = remaining - 1
        if idx2 != last
            arr[idx2] = arr[last]
        // shrink by removing last position — rebuild arr without last element
        let new_arr = [arr[k] for k in 0..last]
        arr = new_arr
        remaining -= 1
    return total_cost
