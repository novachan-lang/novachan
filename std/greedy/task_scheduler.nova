// std/greedy/task_scheduler.nova — CPU task scheduling with cooldown constraint.
// counts[] = frequency of each distinct task type; identical tasks must be >= n
// intervals apart; CPU idles when no valid task is available.
// Uses the greedy formula: result = max(sum(counts), (max_count-1)*(n+1)+tasks_with_max_count).
// LEAF — imports NOTHING.

// ts_min_intervals: minimum total time units (including idles) to complete all tasks.
fn ts_min_intervals(counts: list, n: int) -> int
    let k = len(counts)
    if k == 0
        return 0
    // compute sum and max_count and count of tasks achieving max_count
    let total = 0
    let max_count = 0
    let i = 0
    while i < k
        total = total + counts[i]
        if counts[i] > max_count
            max_count = counts[i]
        i = i + 1
    // count how many task types have the maximum frequency
    let tasks_with_max = 0
    let j = 0
    while j < k
        if counts[j] == max_count
            tasks_with_max = tasks_with_max + 1
        j = j + 1
    // formula: the "frame" approach
    let frame_result = (max_count - 1) * (n + 1) + tasks_with_max
    if total > frame_result
        return total
    return frame_result

// ts_idle_slots: number of idle time slots inserted to satisfy the cooldown constraint.
fn ts_idle_slots(counts: list, n: int) -> int
    let total = 0
    let i = 0
    while i < len(counts)
        total = total + counts[i]
        i = i + 1
    let result = ts_min_intervals(counts, n)
    return result - total
