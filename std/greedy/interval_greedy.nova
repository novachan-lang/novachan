// std/greedy/interval_scheduling.nova — Greedy interval scheduling algorithms. LEAF — imports NOTHING.
// Intervals are [start, end] pairs (end >= start, integer endpoints).
// Prefix: ig_

// _ig_sort_by_end: in-place insertion sort of list-of-[start,end] by end asc,
// tie-break by start asc.  Uses done-flag to avoid negative-sentinel footgun.
fn _ig_sort_by_end(arr: list)
    let n = len(arr)
    let j = 1
    while j < n
        let key = arr[j]
        let kend = key[1]
        let kst = key[0]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let other = arr[k]
            let oend = other[1]
            let ost = other[0]
            let shift = false
            if oend > kend
                shift = true
            if oend == kend and ost > kst
                shift = true
            if shift
                arr[k + 1] = arr[k]
                pos = k
                k = k - 1
            else
                done = true
        arr[pos] = key
        j = j + 1

// _ig_copy_intervals: shallow copy of a list of intervals.
fn _ig_copy_intervals(ivs: list) -> list
    let result = []
    let n = len(ivs)
    let i = 0
    while i < n
        push(result, ivs[i])
        i = i + 1
    return result

// ig_max_nonoverlap: count of the maximum non-overlapping subset of intervals.
// Greedy by earliest finish: an interval [s,e] is compatible with the last chosen
// interval [_,last_end] iff s >= last_end (touching is allowed).
fn ig_max_nonoverlap(intervals: list) -> int
    let n = len(intervals)
    if n == 0
        return 0
    let sorted = _ig_copy_intervals(intervals)
    _ig_sort_by_end(sorted)
    let count = 1
    let last_end = sorted[0][1]
    let i = 1
    while i < n
        let iv = sorted[i]
        if iv[0] >= last_end
            count = count + 1
            last_end = iv[1]
        i = i + 1
    return count

// ig_min_removals: fewest intervals to remove so the remaining are non-overlapping.
// Equals n minus the maximum non-overlapping count.
fn ig_min_removals(intervals: list) -> int
    let n = len(intervals)
    if n == 0
        return 0
    let keep = ig_max_nonoverlap(intervals)
    return n - keep

// ig_min_arrows: minimum number of arrows (points) to pierce all intervals.
// Each arrow at position x pierces every interval [s,e] with s <= x <= e.
// Greedy: sort by end, shoot at the end of the current interval, skip intervals
// already pierced (start <= last_arrow_pos).
fn ig_min_arrows(intervals: list) -> int
    let n = len(intervals)
    if n == 0
        return 0
    let sorted = _ig_copy_intervals(intervals)
    _ig_sort_by_end(sorted)
    let arrows = 1
    let arrow_pos = sorted[0][1]
    let i = 1
    while i < n
        let iv = sorted[i]
        if iv[0] > arrow_pos
            arrows = arrows + 1
            arrow_pos = iv[1]
        i = i + 1
    return arrows
