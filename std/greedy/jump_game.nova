// std/greedy/jump_game.nova — Jump Game greedy algorithms. LEAF — imports NOTHING.
// nums[i] is the maximum jump length from position i (non-negative integers).
// Prefix: jg_

// jg_can_reach: true if you can reach the last index from index 0.
// Greedy: track the maximum reachable index; if current position exceeds it, stuck.
fn jg_can_reach(nums: list) -> bool
    let n = len(nums)
    if n == 0
        return true
    if n == 1
        return true
    let max_reach = 0
    for i in 0..n
        if i > max_reach
            return false
        let candidate = i + nums[i]
        if candidate > max_reach
            max_reach = candidate
        if max_reach >= n - 1
            return true
    return max_reach >= n - 1

// jg_min_jumps: minimum number of jumps to reach the last index.
// Assumes the last index is reachable.  Greedy BFS: expand each level by
// the farthest reachable position within the current window.
fn jg_min_jumps(nums: list) -> int
    let n = len(nums)
    if n <= 1
        return 0
    let jumps = 0
    let cur_end = 0
    let far = 0
    for i in 0..(n - 1)
        let candidate = i + nums[i]
        if candidate > far
            far = candidate
        if i == cur_end
            jumps = jumps + 1
            cur_end = far
            if cur_end >= n - 1
                return jumps
    return jumps
