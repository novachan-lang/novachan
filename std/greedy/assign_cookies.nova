// std/greedy/assign_cookies.nova — greedy cookie assignment to maximize content children. LEAF — imports NOTHING.

// _ac_sort_asc: in-place selection sort ascending on a list of integers.
fn _ac_sort_asc(arr: list)
    let n = len(arr)
    let i = 0
    while i < n
        let min_idx = i
        let j = i + 1
        while j < n
            if arr[j] < arr[min_idx]
                min_idx = j
            j = j + 1
        if min_idx != i
            let tmp = arr[i]
            arr[i] = arr[min_idx]
            arr[min_idx] = tmp
        i = i + 1

// ac_max_content: maximum number of children that can be made content.
//   A child with greed factor g[i] is content only if assigned a cookie of size >= g[i].
//   Each cookie can be given to at most one child. Greedy: sort both; match smallest
//   sufficient cookie to each child in increasing greed order.
fn ac_max_content(greed: list, sizes: list) -> int
    let ng = len(greed)
    let ns = len(sizes)
    if ng == 0
        return 0
    if ns == 0
        return 0
    // copy greed and sizes so we don't mutate caller's lists
    let g = [greed[gi] for gi in 0..ng]
    let s = [sizes[si] for si in 0..ns]
    _ac_sort_asc(g)
    _ac_sort_asc(s)
    // two-pointer: ci = child index, ki = cookie index
    let ci = 0
    let ki = 0
    let count = 0
    while ci < ng and ki < ns
        if s[ki] >= g[ci]
            // this cookie satisfies this child
            count = count + 1
            ci = ci + 1
            ki = ki + 1
        else
            // cookie too small; try next cookie
            ki = ki + 1
    return count
