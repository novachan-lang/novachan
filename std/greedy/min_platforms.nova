// std/greedy/min_platforms.nova — Railway platform scheduling via sweep-line.
// A train occupies a platform from arrivals[i] to departures[i] inclusive;
// a train arriving at exactly the same time as another departs needs its own platform.
// LEAF — imports NOTHING.

// _mp_sort_indices: selection sort on xs[], returns index permutation (ascending).
fn _mp_sort_indices(xs: list) -> list
    let n = len(xs)
    let idx = []
    let i = 0
    while i < n
        push(idx, i)
        i = i + 1
    let pos = 0
    while pos < n
        let best = pos
        let j = pos + 1
        while j < n
            if xs[idx[j]] < xs[idx[best]]
                best = j
            j = j + 1
        // swap idx[pos] and idx[best]
        let tmp = idx[pos]
        idx[pos] = idx[best]
        idx[best] = tmp
        pos = pos + 1
    return idx

// mp_count: minimum number of platforms needed so no two overlapping trains share one.
// Arrival at the same time as a departure counts as overlap (trains need separate platforms).
fn mp_count(arrivals: list, departures: list) -> int
    let n = len(arrivals)
    if n == 0
        return 0
    let ai = _mp_sort_indices(arrivals)
    let di = _mp_sort_indices(departures)
    let platforms = 0
    let max_platforms = 0
    let a = 0
    let d = 0
    while a < n
        // if next arrival is strictly less than next departure, trains overlap; need a new platform.
        // if arrival == departure, the departing train frees its platform first (can share).
        if arrivals[ai[a]] < departures[di[d]]
            platforms = platforms + 1
            if platforms > max_platforms
                max_platforms = platforms
            a = a + 1
        else
            platforms = platforms - 1
            d = d + 1
    return max_platforms

// mp_max_overlap: alias for mp_count — returns the maximum simultaneous overlap count.
fn mp_max_overlap(arrivals: list, departures: list) -> int
    return mp_count(arrivals, departures)
