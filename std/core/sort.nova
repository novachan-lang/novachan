// ============================================================================
// std/core/sort — sorting utilities
// ============================================================================
// Non-mutating (returns a new list). Insertion sort — stable, simple, fine for
// the small/medium lists typical of high-level code.

// ascending sort of an int list.
fn sort_ints(xs: list<int>) -> list<int>
    let out = []
    for x in xs
        push(out, x)
    let i = 1
    while i < len(out)
        let key = out[i]
        let j = i - 1
        while j >= 0 and out[j] > key
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = key
        i = i + 1
    return out

// descending sort of an int list.
fn sort_ints_desc(xs: list<int>) -> list<int>
    let asc = sort_ints(xs)
    let out = []
    let i = len(asc) - 1
    while i >= 0
        push(out, asc[i])
        i = i - 1
    return out

// ascending lexicographic sort of a string list.
fn sort_strings(xs: list) -> list
    let out = []
    for x in xs
        push(out, x)
    let i = 1
    while i < len(out)
        let key = out[i]
        let j = i - 1
        while j >= 0 and out[j] > key
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = key
        i = i + 1
    return out

// generic sort by a `less(a, b) -> bool` comparison closure (ascending when
// `less` is `a < b`). Stable.
fn sort_by(xs: list, less) -> list
    let out = []
    for x in xs
        push(out, x)
    let i = 1
    while i < len(out)
        let key = out[i]
        let j = i - 1
        while j >= 0 and less(key, out[j])
            out[j + 1] = out[j]
            j = j - 1
        out[j + 1] = key
        i = i + 1
    return out
