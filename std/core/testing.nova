// ============================================================================
// std/core/testing — lightweight test-assertion helpers
// ============================================================================
// Go's `testing` / Python's `unittest.assertX` style, but each assertion
// returns 1 (pass) or 0 (fail) instead of raising — callers accumulate the
// results (e.g. into a list) and hand them to test_suite() for a summary.
// A failing assertion prints a "FAIL: label: got X, want Y" line so the
// developer sees exactly what mismatched without a debugger.

// compares actual == expected; prints a FAIL line and returns 0 on mismatch.
fn assert_eq(actual: any, expected: any, label: string) -> int
    if actual == expected
        return 1
    print("FAIL: {label}: got {actual}, want {expected}")
    return 0

// compares actual != expected; prints a FAIL line and returns 0 when equal.
fn assert_neq(actual: any, expected: any, label: string) -> int
    if actual != expected
        return 1
    print("FAIL: {label}: got {actual}, want not {expected}")
    return 0

// asserts cond is truthy (== 1).
fn assert_true(cond: int, label: string) -> int
    if cond == 1
        return 1
    print("FAIL: {label}: got {cond}, want true")
    return 0

// asserts cond is falsy (== 0).
fn assert_false(cond: int, label: string) -> int
    if cond == 0
        return 1
    print("FAIL: {label}: got {cond}, want false")
    return 0

// asserts haystack contains needle as a substring.
fn assert_contains(haystack: string, needle: string, label: string) -> int
    if haystack.contains(needle)
        return 1
    print("FAIL: {label}: {haystack} does not contain {needle}")
    return 0

// asserts a > b.
fn assert_gt(a: any, b: any, label: string) -> int
    if a > b
        return 1
    print("FAIL: {label}: got {a}, want > {b}")
    return 0

// asserts a < b.
fn assert_lt(a: any, b: any, label: string) -> int
    if a < b
        return 1
    print("FAIL: {label}: got {a}, want < {b}")
    return 0

// asserts a Result is Ok.
fn assert_ok(result: Result, label: string) -> int
    if is_ok(result) == 1
        return 1
    print("FAIL: {label}: got Err, want Ok")
    return 0

// asserts a Result is Err.
fn assert_err(result: Result, label: string) -> int
    if is_err(result) == 1
        return 1
    print("FAIL: {label}: got Ok, want Err")
    return 0

// prints a "SUITE name: X/Y passed" summary line for a list of 0/1 results;
// returns 1 iff every result passed.
fn test_suite(name: string, results: list) -> int
    let total = len(results)
    let passed = results.reduce(fn(acc, r) acc + r, 0)
    print("SUITE {name}: {passed}/{total} passed")
    return 1 if passed == total else 0
