// ============================================================================
// std/core/tree — generic n-ary tree with high-level recursive ops
// ============================================================================
// A tree node is a struct { value: any, children: list } — `children` holds
// zero or more nested `Tree` nodes (self-referential via a bare `list`, the
// same pattern the compiler's own AST uses for `Expr.children`). A leaf is
// simply a node with an empty `children` list; there is no separate leaf type.
//
// PUBLIC API
//   tnode(value, children: list) -> Tree   build an internal node
//   tleaf(value)                 -> Tree   build a leaf (no children)
//   t_map(t, f)                  -> Tree   map f over every value, same shape
//   t_fold(t, f, init)            -> any    pre-order fold: acc = f(acc, value)
//   t_values(t)                  -> list   pre-order flat list of every value
//   t_leaves(t)                  -> list   values of childless nodes, left-to-right
//   t_depth(t)                   -> int    longest root-to-leaf path (leaf = 1)
//   t_count(t)                   -> int    total node count (self + all descendants)
//   t_find(t, pred)               -> Option pre-order first value where pred(v), else None
//
// EXAMPLES
//   let t = tnode(1, [tnode(2, [tleaf(4), tleaf(5)]), tleaf(3)])
//   t_values(t)             -> [1, 2, 4, 5, 3]
//   t_leaves(t)              -> [4, 5, 3]
//   t_depth(t)                -> 3
//   t_count(t)                -> 5
//   t_values(t_map(t, fn(v) v * 2)) -> [2, 4, 8, 10, 6]
//   t_find(t, fn(v) v == 4)   -> Some(4)
//   t_find(t, fn(v) v == 99)  -> None
//
// IMPLEMENTATION NOTES
//   • Recursive by construction: every op is "handle this node, then recurse
//     into children" — no manual index stacks. `t_map` recurses through
//     `.map` over children; `t_fold` recurses through `.reduce` over children;
//     `t_values`/`t_leaves` recurse through a nested for-in comprehension
//     (`[v for c in t.tree_children for v in t_op(c)]`), which is NOVA's flat-map.
//   • WORKAROUND (known compiler gap, see NOVA_DESIGN docs on the deferred
//     "map/HOF float-widen-boxing" issue): piping a `.map(...)`'d list of ints
//     straight into the builtins `sum()` / `list_max()` silently promotes the
//     result to a boxed float (verified: `[1,2,3].map(f).sum()` prints "9.0",
//     `list_max([1,2,3].map(f))` prints "4.0"), and a subsequent int op on
//     that boxed float can read raw bits instead of the numeric value. `t_depth`
//     and `t_count` therefore accumulate with a plain `for` loop instead of
//     `list_max(t.tree_children.map(t_depth))` / `t.tree_children.map(t_count).sum()` —
//     this is NOT a stylistic index-loop regression, it is dodging a proven
//     silent-corruption trap. `t_map` (via `.map`, no numeric aggregate after
//     it) and `t_fold` (via `.reduce`) are unaffected and use the HOF form.
//   • `t_find` reuses `t_values` (pre-order) and returns on the first match —
//     the canonical Option-returning search pattern (see `first_even` in
//     NOVA_LANGUAGE_FEATURES.md), not a hand-rolled traversal.
// ============================================================================

// Fields are PREFIXED, and that is load-bearing rather than stylistic. NOVA's field-name -> slot
// index table is GLOBAL and last-registration-wins, so a bare `children` here shares that name with
// every other struct in any program that imports this module. `PrismNode` declares `children` at a
// DIFFERENT slot index, so a program importing both would have had one of them silently read the
// wrong field -- and a wrong-slot read on a struct-typed field is a wild pointer read, i.e. a crash
// rather than a wrong answer. That exact failure took down Prism's HTML renderer on 2026-08-16 via
// a different pair of structs. No live conflict existed here yet; prefixed before one could.
type Tree
    tree_value: any
    tree_children: list

// tnode: build an internal node from a value and an explicit list of children.
fn tnode(value: any, children: list) -> Tree
    return Tree(value, children)

// tleaf: build a childless node.
fn tleaf(value: any) -> Tree
    return Tree(value, [])

// t_map: apply f to every value, preserving the exact shape (child count and
// order at every level). Recurses through `.map` over the children list.
fn t_map(t: Tree, f) -> Tree
    return Tree(f(t.tree_value), t.tree_children.map(fn(c) t_map(c, f)))

// t_fold: pre-order fold — visit this node's value, then fold left-to-right
// through each child's subtree, threading the accumulator throughout.
// acc0 = f(init, t.tree_value); acc(i+1) = t_fold(child(i), f, acc(i))
fn t_fold(t: Tree, f, init: any) -> any
    let acc = f(init, t.tree_value)
    return t.tree_children.reduce(fn(a, c) t_fold(c, f, a), acc)

// t_values: pre-order flat list of every value in the tree (this node first,
// then each child's values left-to-right).
fn t_values(t: Tree) -> list
    return [t.tree_value, ...[v for c in t.tree_children for v in t_values(c)]]

// t_leaves: values of every childless node, left-to-right.
fn t_leaves(t: Tree) -> list
    if len(t.tree_children) == 0
        return [t.tree_value]
    return [v for c in t.tree_children for v in t_leaves(c)]

// t_depth: length of the longest root-to-leaf path; a lone leaf has depth 1.
fn t_depth(t: Tree) -> int
    let best = 0
    for c in t.tree_children
        best = max(best, t_depth(c))
    return 1 + best

// t_count: total number of nodes (this node plus every descendant).
fn t_count(t: Tree) -> int
    let acc = 1
    for c in t.tree_children
        acc += t_count(c)
    return acc

// t_find: pre-order search for the first value where pred(v) holds.
// Some(v) on a hit, None if no value in the tree satisfies pred.
fn t_find(t: Tree, pred) -> Option
    for v in t_values(t)
        if pred(v)
            return some(v)
    return none()
