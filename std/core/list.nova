// ============================================================================
// std/core/list — high-level list utilities (complements std/core/seq)
// ============================================================================
// Uses only proven-working patterns (generic-param + closure + concrete return,
// value equality). Non-mutating.

fn list_contains(xs: list, target: any) -> bool
    for x in xs
        if x == target
            return true
    return false

// first index of target, or -1 if absent.
fn list_index_of(xs: list, target: any) -> int
    let i = 0
    while i < len(xs)
        if xs[i] == target
            return i
        i = i + 1
    return 0 - 1

// de-duplicate, preserving first-seen order.
fn list_unique(xs: list) -> list
    let out = []
    for x in xs
        if not list_contains(out, x)
            push(out, x)
    return out

// concatenate two lists into a new one.
fn list_concat(a: list, b: list) -> list
    let out = []
    for x in a
        push(out, x)
    for x in b
        push(out, x)
    return out

// flatten one level: a list of lists -> a single list.
fn list_flatten(xss: list) -> list
    let out = []
    for xs in xss
        for x in xs
            push(out, x)
    return out

// sum of an int list.
fn list_sum(xs: list<int>) -> int
    let s = 0
    for x in xs
        s = s + x
    return s

// split into consecutive chunks of size n (last chunk may be shorter).
fn list_chunk(xs: list, n: int) -> list
    let out = []
    let cur = []
    for x in xs
        push(cur, x)
        if len(cur) >= n
            push(out, cur)
            cur = []
    if len(cur) > 0
        push(out, cur)
    return out

// first n elements (or all if n >= len).
fn list_take(xs: list, n: int) -> list
    let out = []
    let i = 0
    while i < n and i < len(xs)
        push(out, xs[i])
        i = i + 1
    return out

// skip first n elements.
fn list_drop(xs: list, n: int) -> list
    let out = []
    let i = n
    if i < 0
        i = 0
    while i < len(xs)
        push(out, xs[i])
        i = i + 1
    return out

// insert separator between every pair of elements.
fn list_intersperse(xs: list, sep: any) -> list
    let out = []
    let i = 0
    while i < len(xs)
        if i > 0
            push(out, sep)
        push(out, xs[i])
        i = i + 1
    return out

// sliding windows of size n.
fn list_windows(xs: list, n: int) -> list
    let out = []
    let i = 0
    while i + n <= len(xs)
        let win = []
        let j = 0
        while j < n
            push(win, xs[i + j])
            j = j + 1
        push(out, win)
        i = i + 1
    return out

// group elements by a key function. Returns a dict mapping keys to lists.
fn list_group_by(xs: list, key_fn) -> dict
    let groups = {}
    for x in xs
        let k = key_fn(x)
        if contains(groups, k)
            push(groups[k], x)
        else
            groups[k] = [x]
    return groups

// zip two lists into a list of [a, b] pairs (shortest length).
fn list_zip(a: list, b: list) -> list
    let out = []
    let n = len(a)
    if len(b) < n
        n = len(b)
    let i = 0
    while i < n
        push(out, [a[i], b[i]])
        i = i + 1
    return out

// repeat a value n times.
fn list_repeat(val: any, n: int) -> list
    let out = []
    let i = 0
    while i < n
        push(out, val)
        i = i + 1
    return out
