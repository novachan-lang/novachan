// ============================================================================
// std/core/str — high-level string utilities
// ============================================================================
// Slicing-based (s[i:j]), non-mutating. Additive to the string builtins.
//
// RAISED 2026-08-05. Four of the five loops here grew a string with `out = out + piece`.
// That is QUADRATIC: NOVA strings are immutable, so `a + b` allocates a new buffer and
// copies BOTH sides every iteration — n appends copy n(n+1)/2 bytes. The fix throughout is
// to collect the pieces in a list and `join` them ONCE, which is O(n) with one allocation.
// (Measured on the same pattern in std/itertools: 23,760 ms -> 92 ms at n=20000.)
//
// The two padding functions go further: "how many copies of `pad` do I need" is ARITHMETIC,
// not iteration. Computing the count directly removes the loop entirely while preserving the
// original's exact overshoot semantics — see the note on str_pad_left.
//
// BYTES, NOT CHARACTERS: `len(s)` and `s[i:j]` are byte-indexed. str_reverse therefore
// reverses BYTES, which corrupts multi-byte UTF-8. That was true before this raise and is
// preserved deliberately — changing it is a semantic decision, not a refactor.

// reverse a string, byte-wise.
// Built as a list of 1-byte slices, reversed with the builtin, joined once.
fn str_reverse(s: string) -> string
    join(reverse([s[i:i+1] for i in 0..len(s)]), "")

// s repeated n times; n <= 0 yields "".
fn str_repeat(s: string, n: int) -> string
    if n <= 0
        return ""
    join([s for _ in 0..n], "")

// left-pad with `pad` until length >= width.
//
// NOTE ON OVERSHOOT — this is the contract, and it is preserved exactly. The original appended
// WHOLE copies of `pad` while `len(out) < width`, so with a multi-byte pad the result can end up
// LONGER than width: str_pad_left("x", 4, "ab") gives "ababx" (length 5), not a 4-byte result.
// So the count is ceil(deficit / len(pad)) — the smallest k with len(s) + k*len(pad) >= width —
// which is what the loop computed one step at a time.
fn str_pad_left(s: string, width: int, pad: string) -> string
    if len(pad) == 0
        return s
    let deficit = width - len(s)
    if deficit <= 0
        return s
    let k = (deficit + len(pad) - 1) / len(pad)
    join([pad for _ in 0..k], "") + s

// right-pad with `pad` until length >= width. Same overshoot contract as str_pad_left.
fn str_pad_right(s: string, width: int, pad: string) -> string
    if len(pad) == 0
        return s
    let deficit = width - len(s)
    if deficit <= 0
        return s
    let k = (deficit + len(pad) - 1) / len(pad)
    s + join([pad for _ in 0..k], "")

// count non-overlapping occurrences of sub in s.
//
// The `while` STAYS, and it is the right construct: the index advances by len(sub) on a match
// and by 1 otherwise, so the step is data-dependent. That is precisely the case a `for i in 0..n`
// cannot express, and rewriting it as one would change the answer from non-overlapping to
// overlapping. It is already O(n*m); there is nothing quadratic to remove.
fn str_count(s: string, sub: string) -> int
    if len(sub) == 0
        return 0
    let n = 0
    let i = 0
    while i <= len(s) - len(sub)
        if s[i:i+len(sub)] == sub
            n += 1
            i += len(sub)
        else
            i += 1
    return n

// character (1-byte string) at index i, or "" if out of range.
fn str_char_at(s: string, i: int) -> string
    if i < 0 or i >= len(s)
        return ""
    s[i:i+1]
