// ============================================================================
// NOVA Standard Library — core extras: ordered search + integer numerics
// ============================================================================
// Pure NOVA (no new builtins). Closes audit-flagged gaps:
//   binary_search / lower_bound / upper_bound / contains_sorted   (Collections, cat10)
//   sign / clamp_int / isqrt / ilog2 / next_pow2                  (Numerics, cat11)
// Integer division truncates toward zero in NOVA (7/2 == 3), and the Batch-D
// bit builtins (clz) are ordinary integer functions, so ilog2/next_pow2 are exact.

// ── ordered search over a sorted (ascending) int list ───────────────────────

// Index of `target`, or -1 if absent. O(log n). Overflow-safe midpoint.
fn binary_search(xs, target) -> int
    let lo = 0
    let hi = len(xs) - 1
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        let v = xs[mid]
        if v == target
            return mid
        else if v < target
            lo = mid + 1
        else
            hi = mid - 1
    return -1

// First index i with xs[i] >= target (the insertion point). Range 0..len(xs).
fn lower_bound(xs, target) -> int
    let lo = 0
    let hi = len(xs)
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if xs[mid] < target
            lo = mid + 1
        else
            hi = mid
    return lo

// First index i with xs[i] > target. Range 0..len(xs).
fn upper_bound(xs, target) -> int
    let lo = 0
    let hi = len(xs)
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if xs[mid] <= target
            lo = mid + 1
        else
            hi = mid
    return lo

// Membership in a sorted list (1/0). Count of a value = upper-lower.
fn contains_sorted(xs, target) -> int
    if binary_search(xs, target) >= 0
        return 1
    return 0

fn count_sorted(xs, target) -> int
    return upper_bound(xs, target) - lower_bound(xs, target)

// ── integer numerics ────────────────────────────────────────────────────────

fn sign(x) -> int
    if x > 0
        return 1
    if x < 0
        return -1
    return 0

fn clamp_int(x, lo, hi) -> int
    if x < lo
        return lo
    if x > hi
        return hi
    return x

// floor(sqrt(n)) for n >= 0, EXACT (integer Newton — no float rounding).
// isqrt(n) for n < 0 returns -1.
fn isqrt(n) -> int
    if n < 0
        return -1
    if n < 2
        return n
    let x = n
    let y = (x + n / x) / 2
    while y < x
        x = y
        y = (x + n / x) / 2
    return x

// floor(log2(n)) for n >= 1, else -1. clz is the Batch-D bit builtin.
fn ilog2(n) -> int
    if n < 1
        return -1
    return 63 - clz(n)

// Smallest power of two >= n (>= 1). next_pow2(n<=1) == 1.
fn next_pow2(n) -> int
    if n < 2
        return 1
    return 1 << (64 - clz(n - 1))

// ============================================================================
fn main()
    // ── binary_search ──
    let a = [2, 5, 8, 12, 16, 23, 38, 56, 72, 91]   // sorted, 10 elements
    assert_eq(binary_search(a, 2), 0)               // first
    assert_eq(binary_search(a, 91), 9)              // last
    assert_eq(binary_search(a, 23), 5)              // middle
    assert_eq(binary_search(a, 16), 4)
    assert_eq(binary_search(a, 1), -1)              // below all
    assert_eq(binary_search(a, 100), -1)            // above all
    assert_eq(binary_search(a, 13), -1)             // gap
    assert_eq(binary_search([], 5), -1)             // empty
    assert_eq(binary_search([42], 42), 0)           // single hit
    assert_eq(binary_search([42], 7), -1)           // single miss

    // ── lower/upper bound + counts (with duplicates) ──
    let d = [1, 2, 2, 2, 3, 5, 5, 8]
    assert_eq(lower_bound(d, 2), 1)
    assert_eq(upper_bound(d, 2), 4)
    assert_eq(count_sorted(d, 2), 3)
    assert_eq(count_sorted(d, 5), 2)
    assert_eq(count_sorted(d, 4), 0)                // absent → 0
    assert_eq(lower_bound(d, 0), 0)                 // before all
    assert_eq(lower_bound(d, 9), 8)                 // after all (== len)
    assert_eq(contains_sorted(d, 3), 1)
    assert_eq(contains_sorted(d, 7), 0)

    // ── sign / clamp ──
    assert_eq(sign(42), 1)
    assert_eq(sign(-9), -1)
    assert_eq(sign(0), 0)
    assert_eq(clamp_int(5, 0, 10), 5)
    assert_eq(clamp_int(-3, 0, 10), 0)
    assert_eq(clamp_int(99, 0, 10), 10)

    // ── isqrt (exact) ──
    assert_eq(isqrt(0), 0)
    assert_eq(isqrt(1), 1)
    assert_eq(isqrt(2), 1)
    assert_eq(isqrt(3), 1)
    assert_eq(isqrt(4), 2)
    assert_eq(isqrt(15), 3)
    assert_eq(isqrt(16), 4)
    assert_eq(isqrt(24), 4)
    assert_eq(isqrt(25), 5)
    assert_eq(isqrt(1000000), 1000)
    assert_eq(isqrt(1000000000000), 1000000)        // 10^12 → 10^6
    assert_eq(isqrt(-5), -1)

    // ── ilog2 ──
    assert_eq(ilog2(1), 0)
    assert_eq(ilog2(2), 1)
    assert_eq(ilog2(3), 1)
    assert_eq(ilog2(4), 2)
    assert_eq(ilog2(7), 2)
    assert_eq(ilog2(8), 3)
    assert_eq(ilog2(1023), 9)
    assert_eq(ilog2(1024), 10)
    assert_eq(ilog2(0), -1)

    // ── next_pow2 ──
    assert_eq(next_pow2(0), 1)
    assert_eq(next_pow2(1), 1)
    assert_eq(next_pow2(2), 2)
    assert_eq(next_pow2(3), 4)
    assert_eq(next_pow2(5), 8)
    assert_eq(next_pow2(8), 8)
    assert_eq(next_pow2(9), 16)
    assert_eq(next_pow2(1000), 1024)

    print("corex_test passed")
