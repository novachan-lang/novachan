// ============================================================================
// std/core/opt — high-level Option combinators
// ============================================================================
// Ergonomic helpers over `Option` (Some(v) | None). Works both locally and
// imported (the any-typed module-fn match on Some/None now maps to the correct
// sum tag — the companion fix to the bare-Option-as-sum inference fix).

fn opt_is_some(o: Option) -> bool
    match o
        Some(v) =>
            return true
        None =>
            return false

fn opt_is_none(o: Option) -> bool
    match o
        Some(v) =>
            return false
        None =>
            return true

// unwrap the Some value, or a default when None.
fn opt_unwrap_or(o: Option, default: any) -> any
    match o
        Some(v) =>
            return v
        None =>
            return default

// apply f to the Some value (None passes through).
fn opt_map(o: Option, f) -> Option
    match o
        Some(v) =>
            return some(f(v))
        None =>
            return none()

// keep the Some value only if pred(v); otherwise None.
fn opt_filter(o: Option, pred) -> Option
    match o
        Some(v) =>
            if pred(v)
                return some(v)
            return none()
        None =>
            return none()
