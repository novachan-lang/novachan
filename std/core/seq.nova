// ============================================================================
// std/core/seq — generic, high-level sequence utilities
// ============================================================================
// Written in NOVA's HIGH-LEVEL style: generic functions (`fn <T> ...`), closures
// passed as first-class values, and `Result`/`match` for fallible ops — NOT the
// `any`+type_of+manual-loop style. This is the standard for new code, and it
// fills a real gap (the stdlib had 0 generic functions).

// fold left: collapse xs into an accumulator via f(acc, x). The accumulator type
// is dynamic (it flows through the caller's closure, which the inferencer cannot
// see into), so the result is `any` — the caller knows what it folded into. This
// is the honest type: NOVA cannot infer a generic return through an untyped
// closure, so it is not annotated as generic (a real, documented inference edge).
fn <T> seq_fold(xs: list<T>, init: any, f) -> any
    let acc = init
    for x in xs
        acc = f(acc, x)
    return acc

// reduce: fold with the first element as the seed. Result (Ok(acc) | Err) — Err on empty.
fn <T> seq_reduce(xs: list<T>, f) -> Result
    if len(xs) == 0
        return err("seq_reduce: empty sequence")
    let acc = xs[0]
    let i = 1
    while i < len(xs)
        acc = f(acc, xs[i])
        i = i + 1
    return ok(acc)

// find: first element satisfying pred, as Result<T,string> (Err if none).
fn <T> seq_find(xs: list<T>, pred) -> Result
    for x in xs
        if pred(x)
            return ok(x)
    return err("seq_find: no element matched")

// any / all: existential / universal quantifiers over a predicate.
fn <T> seq_any(xs: list<T>, pred) -> bool
    for x in xs
        if pred(x)
            return true
    return false

fn <T> seq_all(xs: list<T>, pred) -> bool
    for x in xs
        if not pred(x)
            return false
    return true

// count elements satisfying pred.
fn <T> seq_count(xs: list<T>, pred) -> int
    let n = 0
    for x in xs
        if pred(x)
            n = n + 1
    return n

// take / drop first k (bounds-clamped, defensive).
fn <T> seq_take(xs: list<T>, k: int) -> list<T>
    let stop = k if k < len(xs) else len(xs)
    if stop <= 0
        return []
    [xs[i] for i in 0..stop]

fn <T> seq_drop(xs: list<T>, k: int) -> list<T>
    // the original guarded `if i >= 0` inside the loop because a NEGATIVE k started the index
    // below zero; clamping the start expresses the same intent up front.
    let start = k if k > 0 else 0
    if start >= len(xs)
        return []
    [xs[i] for i in start..len(xs)]

// zip two sequences into a list of 2-element [a,b] pairs (length = min).
fn <A, B> seq_zip(xs: list<A>, ys: list<B>) -> list
    let n = len(xs) if len(xs) < len(ys) else len(ys)
    [[xs[i], ys[i]] for i in 0..n]

// reverse (generic, non-mutating).
fn <T> seq_reverse(xs: list<T>) -> list<T>
    [xs[len(xs) - 1 - i] for i in 0..len(xs)]

// map: apply f to every element, returning a new list.
fn <T> seq_map(xs: list<T>, f) -> list
    let out = []
    for x in xs
        push(out, f(x))
    return out

// filter: keep only elements satisfying pred.
fn <T> seq_filter(xs: list<T>, pred) -> list<T>
    let out = []
    for x in xs
        if pred(x)
            push(out, x)
    return out

// flat_map: map each element to a list, then concatenate (one level).
fn <T> seq_flat_map(xs: list<T>, f) -> list
    flatten([f(x) for x in xs])

// zip_with: combine corresponding elements via f.
fn <A, B> seq_zip_with(xs: list<A>, ys: list<B>, f) -> list
    let n = len(xs) if len(xs) < len(ys) else len(ys)
    [f(xs[i], ys[i]) for i in 0..n]

// enumerate: pair each element with its index ([i, x]).
fn <T> seq_enumerate(xs: list<T>) -> list
    [[i, xs[i]] for i in 0..len(xs)]

// group elements by a key function. Returns dict of key -> list.
fn <T> seq_group_by(xs: list<T>, key_fn) -> dict
    let groups = {}
    for x in xs
        let k = str(key_fn(x))
        if contains(groups, k)
            push(groups[k], x)
        else
            groups[k] = [x]
    return groups

// partition: split into [matching, non-matching].
fn <T> seq_partition(xs: list<T>, pred) -> list
    let yes = []
    let no = []
    for x in xs
        if pred(x)
            push(yes, x)
        else
            push(no, x)
    return [yes, no]

// min_by / max_by: element with smallest/largest key_fn(x).
fn <T> seq_min_by(xs: list<T>, key_fn) -> Result
    if len(xs) == 0
        return err("seq_min_by: empty sequence")
    let best = xs[0]
    let best_k = key_fn(xs[0])
    let i = 1
    while i < len(xs)
        let k = key_fn(xs[i])
        if k < best_k
            best = xs[i]
            best_k = k
        i = i + 1
    return ok(best)

fn <T> seq_max_by(xs: list<T>, key_fn) -> Result
    if len(xs) == 0
        return err("seq_max_by: empty sequence")
    let best = xs[0]
    let best_k = key_fn(xs[0])
    let i = 1
    while i < len(xs)
        let k = key_fn(xs[i])
        if k > best_k
            best = xs[i]
            best_k = k
        i = i + 1
    return ok(best)

// sliding windows of size n.
fn <T> seq_windows(xs: list<T>, n: int) -> list
    let out = []
    let i = 0
    while i + n <= len(xs)
        let win = []
        let j = 0
        while j < n
            push(win, xs[i + j])
            j = j + 1
        push(out, win)
        i = i + 1
    return out

// chunk into sub-lists of size n (last chunk may be smaller).
fn <T> seq_chunk(xs: list<T>, n: int) -> list
    let out = []
    let cur = []
    for x in xs
        push(cur, x)
        if len(cur) >= n
            push(out, cur)
            cur = []
    if len(cur) > 0
        push(out, cur)
    return out

// sum numeric list (dynamic — works for int, defers to the builtin sum for safety).
fn <T> seq_sum(xs: list<T>) -> any
    return sum(xs)

// de-duplicate, preserving first-seen order.
fn <T> seq_distinct(xs: list<T>) -> list<T>
    let seen = {}
    let out = []
    for x in xs
        let k = str(x)
        if not contains(seen, k)
            seen[k] = 1
            push(out, x)
    return out
