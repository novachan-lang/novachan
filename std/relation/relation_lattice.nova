// ============================================================================
// NOVA Standard Library — std/relation/relation_lattice
// ============================================================================
// Lattice theory over partial-order relations represented as n×n boolean
// matrices (M[i][j]==1 iff i <= j in the partial order).
//
// ASSUMES: M is a valid partial order (reflexive, antisymmetric, transitive).
// All computations are exact, by direct enumeration over {0..n-1}.
//
// Public API:
//   rlat_lub(M, n, a, b) -> int   least upper bound (join) of a and b, or -1
//   rlat_glb(M, n, a, b) -> int   greatest lower bound (meet) of a and b, or -1
//   rlat_is_lattice(M, n) -> int  1 if every pair has a unique lub and glb
//   rlat_top(M, n)        -> int  greatest element, or -1
//   rlat_bottom(M, n)     -> int  least element, or -1
//   rlat_is_chain(M, n)   -> int  1 if M is a total order
//   rlat_is_antichain(pairs) -> int  1 if no pair in 'pairs' is comparable
//
// LEAF — imports nothing; all helpers prefixed rlat_.
// ============================================================================

// rlat_zero_matrix: build an n×n matrix of zeros.
fn rlat_zero_matrix(n)
    let M = []
    for i in 0..n
        let row = []
        let j = 0
        while j < n
            push(row, 0)
            j = j + 1
        push(M, row)
    M

// rlat_lub: compute the least upper bound of a and b in the partial order M.
// Upper bounds of (a,b) are elements x with a<=x and b<=x (M[a][x]==1 and M[b][x]==1).
// The LUB is the upper bound x such that x<=y for all other upper bounds y.
// Returns -1 if no unique LUB exists.
fn rlat_lub(M, n, a, b)
    let ubs = []
    let x = 0
    while x < n
        if M[a][x] == 1 and M[b][x] == 1
            push(ubs, x)
        x = x + 1
    let num_ubs = len(ubs)
    if num_ubs == 0
        return -1
    // find minimum element in ubs: the one that is <= all others
    let result = -1
    for i in 0..num_ubs
        let cand = ubs[i]
        let is_min = 1
        let j = 0
        while j < num_ubs
            let other = ubs[j]
            if M[cand][other] == 0
                is_min = 0
            j = j + 1
        if is_min == 1
            if result == -1
                result = cand
            else
                // two minimal upper bounds => no unique LUB
                return -1
    result

// rlat_glb: compute the greatest lower bound of a and b in the partial order M.
// Lower bounds of (a,b) are elements x with x<=a and x<=b (M[x][a]==1 and M[x][b]==1).
// The GLB is the lower bound x such that y<=x for all other lower bounds y.
// Returns -1 if no unique GLB exists.
fn rlat_glb(M, n, a, b)
    let lbs = [x for x in 0..n if M[x][a] == 1 and M[x][b] == 1]
    let num_lbs = len(lbs)
    if num_lbs == 0
        return -1
    // find maximum element in lbs: the one that all others are <= it
    let result = -1
    for i in 0..num_lbs
        let cand = lbs[i]
        let is_max = 1
        let j = 0
        while j < num_lbs
            let other = lbs[j]
            if M[other][cand] == 0
                is_max = 0
            j = j + 1
        if is_max == 1
            if result == -1
                result = cand
            else
                // two maximal lower bounds => no unique GLB
                return -1
    result

// rlat_is_lattice: return 1 iff every pair (a,b) has a unique LUB and a unique GLB.
fn rlat_is_lattice(M, n)
    if n == 0
        return 1
    let a = 0
    while a < n
        for b in 0..n
            let u = rlat_lub(M, n, a, b)
            if u == -1
                return 0
            let g = rlat_glb(M, n, a, b)
            if g == -1
                return 0
        a = a + 1
    1

// rlat_top: return the greatest element (one that is >= every other), or -1.
fn rlat_top(M, n)
    if n == 0
        return -1
    let result = -1
    for x in 0..n
        let is_top = 1
        let y = 0
        while y < n
            if M[y][x] == 0
                is_top = 0
            y = y + 1
        if is_top == 1
            result = x
    result

// rlat_bottom: return the least element (one that is <= every other), or -1.
fn rlat_bottom(M, n)
    if n == 0
        return -1
    let result = -1
    for x in 0..n
        let is_bot = 1
        let y = 0
        while y < n
            if M[x][y] == 0
                is_bot = 0
            y = y + 1
        if is_bot == 1
            result = x
    result

// rlat_is_chain: return 1 iff M is a total order (every pair is comparable).
fn rlat_is_chain(M, n)
    if n == 0
        return 1
    for i in 0..n
        let j = 0
        while j < n
            if M[i][j] == 0 and M[j][i] == 0
                return 0
            j = j + 1
    1

// rlat_is_antichain: given a list of pairs [[a0,b0],[a1,b1],...], return 1 iff
// the set of DISTINCT elements appearing in the pairs forms an antichain under M.
// An antichain is a set where no two distinct elements are comparable.
fn rlat_is_antichain(M, n, pairs)
    // collect distinct elements from pairs
    let elems = []
    for p in 0..len(pairs)
        let pair = pairs[p]
        let a = pair[0]
        let b = pair[1]
        // insert a if not present
        let found_a = 0
        let k = 0
        while k < len(elems)
            if elems[k] == a
                found_a = 1
            k = k + 1
        if found_a == 0
            push(elems, a)
        // insert b if not present
        let found_b = 0
        let k2 = 0
        while k2 < len(elems)
            if elems[k2] == b
                found_b = 1
            k2 = k2 + 1
        if found_b == 0
            push(elems, b)
    // check no two distinct elements are comparable
    let ne = len(elems)
    for i in 0..ne
        let j = 0
        while j < ne
            if i != j
                let ei = elems[i]
                let ej = elems[j]
                if M[ei][ej] == 1
                    return 0
            j = j + 1
    1
