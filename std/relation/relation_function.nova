// ============================================================================
// NOVA Standard Library — std/relation/relation_function
// ============================================================================
// Treat an n×n boolean matrix as a (partial) function / map on {0..n-1}.
// M[i][j]==1 means i maps to j.
//
// A partial function: each domain element has AT MOST one image.
// A total function: each domain element has EXACTLY one image.
//
// Public API:
//   rfn_is_function(M, n)        -> int  1 if partial function (at most one image per i)
//   rfn_is_total_function(M, n)  -> int  1 if total function (exactly one image per i)
//   rfn_is_injective(M, n)       -> int  1 if injective (one-to-one)
//   rfn_is_surjective(M, n)      -> int  1 if surjective (onto)
//   rfn_is_bijective(M, n)       -> int  1 if bijective (injective + surjective)
//   rfn_apply(M, i)              -> int  unique image of i, or -1 if none/multi
//   rfn_inverse(M, n)            -> M    converse relation (swap i,j)
//   rfn_compose(A, B, n)         -> M    composition B∘A: i->(B(A(i)))
//
// LEAF — imports nothing; all helpers prefixed rfn_.
// ============================================================================

// rfn_zero_matrix: build an n×n matrix of zeros.
fn rfn_zero_matrix(n)
    let M = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            push(row, 0)
            j = j + 1
        push(M, row)
        i = i + 1
    M

// rfn_is_function: return 1 iff each row has at most one 1 (partial function).
fn rfn_is_function(M, n)
    let i = 0
    while i < n
        let count = 0
        let j = 0
        while j < n
            if M[i][j] == 1
                count = count + 1
            j = j + 1
        if count > 1
            return 0
        i = i + 1
    1

// rfn_is_total_function: return 1 iff each row has exactly one 1.
fn rfn_is_total_function(M, n)
    if n == 0
        return 1
    let i = 0
    while i < n
        let count = 0
        let j = 0
        while j < n
            if M[i][j] == 1
                count = count + 1
            j = j + 1
        if count != 1
            return 0
        i = i + 1
    1

// rfn_is_injective: return 1 iff at most one i maps to each j (no two rows share a 1 in same col).
fn rfn_is_injective(M, n)
    let j = 0
    while j < n
        let count = 0
        let i = 0
        while i < n
            if M[i][j] == 1
                count = count + 1
            i = i + 1
        if count > 1
            return 0
        j = j + 1
    1

// rfn_is_surjective: return 1 iff every j has at least one i mapping to it.
fn rfn_is_surjective(M, n)
    if n == 0
        return 1
    let j = 0
    while j < n
        let found = 0
        let i = 0
        while i < n
            if M[i][j] == 1
                found = 1
            i = i + 1
        if found == 0
            return 0
        j = j + 1
    1

// rfn_is_bijective: return 1 iff injective and surjective (and total).
fn rfn_is_bijective(M, n)
    if rfn_is_total_function(M, n) == 0
        return 0
    if rfn_is_injective(M, n) == 0
        return 0
    if rfn_is_surjective(M, n) == 0
        return 0
    1

// rfn_apply: return the unique j such that M[i][j]==1, or -1 if none or multiple.
fn rfn_apply(M, i)
    let n = len(M)
    let result = -1
    let j = 0
    while j < n
        if M[i][j] == 1
            if result != -1
                return -1
            result = j
        j = j + 1
    result

// rfn_inverse: return the converse relation M^T (M[i][j] becomes M[j][i]).
fn rfn_inverse(M, n)
    let R = rfn_zero_matrix(n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if M[i][j] == 1
                R[j][i] = 1
            j = j + 1
        i = i + 1
    R

// rfn_compose: compute the composition B∘A (apply A first, then B).
// Result[i][k] == 1 iff there exists j with A[i][j]==1 and B[j][k]==1.
fn rfn_compose(A, B, n)
    let R = rfn_zero_matrix(n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if A[i][j] == 1
                let k = 0
                while k < n
                    if B[j][k] == 1
                        R[i][k] = 1
                    k = k + 1
            j = j + 1
        i = i + 1
    R
