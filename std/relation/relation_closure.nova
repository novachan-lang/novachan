// std/relation/relation_closure.nova — Relation closures on boolean n×n matrices.
// LEAF — imports NOTHING.
//
// Representation: M is a list of n rows, each a list of n ints 0/1.
// M[i][j]==1 iff (i,j) is in the relation.  n is passed explicitly.
//
// Public API (prefix rcl_):
//   rcl_reflexive_closure(M, n)             -> matrix  add identity pairs
//   rcl_symmetric_closure(M)                -> matrix  add (j,i) for each (i,j)
//   rcl_transitive_closure(M, n)            -> matrix  Warshall's algorithm
//   rcl_reflexive_transitive_closure(M, n)  -> matrix  reflexive then transitive
//   rcl_is_closed_transitive(M, n)          -> int     1 if already transitive, 0 otherwise

// _rcl_zero_matrix — build an n×n matrix of all zeros.
fn _rcl_zero_matrix(n)
    let M = []
    for i in 0..n
        let row = []
        let j = 0
        while j < n
            row.push(0)
            j += 1
        M.push(row)
    return M

// _rcl_copy_matrix — return a deep copy of an n×n 0/1 matrix.
fn _rcl_copy_matrix(M, n)
    let C = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            row.push(M[i][j])
            j += 1
        C.push(row)
        i += 1
    return C

// rcl_reflexive_closure — add (i,i) for all i in {0..n-1}; other pairs unchanged.
fn rcl_reflexive_closure(M, n)
    let R = _rcl_copy_matrix(M, n)
    let i = 0
    while i < n
        R[i][i] = 1
        i += 1
    return R

// rcl_symmetric_closure — add (j,i) whenever (i,j) is in M; n inferred from len(M).
fn rcl_symmetric_closure(M)
    let n = len(M)
    let R = _rcl_copy_matrix(M, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if M[i][j] == 1
                R[j][i] = 1
            j += 1
        i += 1
    return R

// rcl_transitive_closure — Warshall's algorithm O(n^3); returns smallest transitive
// superset of M (does NOT add reflexive pairs unless already present).
fn rcl_transitive_closure(M, n)
    let R = _rcl_copy_matrix(M, n)
    // For each intermediate vertex k, relax all pairs (i,j) through k.
    let k = 0
    while k < n
        let i = 0
        while i < n
            if R[i][k] == 1
                let j = 0
                while j < n
                    if R[k][j] == 1
                        R[i][j] = 1
                    j += 1
            i += 1
        k += 1
    return R

// rcl_reflexive_transitive_closure — reflexive closure then transitive closure.
// Equivalent to the smallest preorder containing M.
fn rcl_reflexive_transitive_closure(M, n)
    let R = rcl_reflexive_closure(M, n)
    return rcl_transitive_closure(R, n)

// rcl_is_closed_transitive — return 1 if M is already transitively closed, 0 otherwise.
// Checks: for all i,j,k, if M[i][k]=1 and M[k][j]=1 then M[i][j] must be 1.
fn rcl_is_closed_transitive(M, n)
    for i in 0..n
        let k = 0
        while k < n
            if M[i][k] == 1
                let j = 0
                while j < n
                    if M[k][j] == 1
                        if M[i][j] != 1
                            return 0
                    j += 1
            k += 1
    return 1
