// std/relation/relation_equiv.nova — Equivalence relations on boolean n×n matrices.
// LEAF — imports NOTHING.
//
// Representation: M is a list of n rows, each a list of n ints 0/1.
// M[i][j]==1 iff (i,j) is in the relation.  n is passed explicitly.
// A partition is a sorted list of equivalence classes; each class is a sorted list
// of ints in {0..n-1}.  Classes are sorted by their minimum (first) element.
//
// Public API (prefix req_):
//   req_is_equivalence(M, n)               -> int   1 if reflexive+symmetric+transitive
//   req_classes(M, n)                      -> list  list-of-sorted-lists (the classes)
//   req_partition_from_relation(M, n)      -> list  same as req_classes (alias)
//   req_relation_from_partition(parts, n)  -> matrix  M[i][j]=1 iff i,j in same part
//   req_are_equivalent(M, a, b)            -> int   1 iff M[a][b]==1

// _req_is_reflexive — return 1 if M[i][i]==1 for all i in {0..n-1}.
fn _req_is_reflexive(M, n)
    let i = 0
    while i < n
        if M[i][i] != 1
            return 0
        i = i + 1
    return 1

// _req_is_symmetric — return 1 if M[i][j]==M[j][i] for all i,j.
fn _req_is_symmetric(M, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if M[i][j] != M[j][i]
                return 0
            j = j + 1
        i = i + 1
    return 1

// _req_is_transitive — return 1 if (M[i][k]=1 and M[k][j]=1) => M[i][j]=1 for all i,j,k.
fn _req_is_transitive(M, n)
    let i = 0
    while i < n
        let k = 0
        while k < n
            if M[i][k] == 1
                let j = 0
                while j < n
                    if M[k][j] == 1
                        if M[i][j] != 1
                            return 0
                    j = j + 1
            k = k + 1
        i = i + 1
    return 1

// _req_sort_ints — insertion sort a list of ints in ascending order (in-place).
fn _req_sort_ints(lst)
    let n = len(lst)
    let i = 1
    while i < n
        let key = lst[i]
        let j = i - 1
        while j >= 0 and lst[j] > key
            lst[j + 1] = lst[j]
            j = j - 1
        lst[j + 1] = key
        i = i + 1

// req_is_equivalence — return 1 if M is reflexive, symmetric, and transitive on {0..n-1}.
fn req_is_equivalence(M, n)
    if _req_is_reflexive(M, n) != 1
        return 0
    if _req_is_symmetric(M, n) != 1
        return 0
    if _req_is_transitive(M, n) != 1
        return 0
    return 1

// req_classes — return the equivalence classes of M as a sorted list of sorted lists.
// Each class is the set {j : M[0_representative][j]=1} for one representative.
// Classes are ordered by their smallest element.
// Precondition: M should be an equivalence relation; result is well-defined for any
// symmetric reflexive relation (transitive closure is assumed already done by caller
// if needed, but the function groups by the row M[i] — classes form for reflexive+sym).
fn req_classes(M, n)
    // Track which elements have been assigned to a class.
    let assigned = []
    let ai = 0
    while ai < n
        assigned.push(0)
        ai = ai + 1
    let classes = []
    let i = 0
    while i < n
        if assigned[i] == 0
            // Collect all j where M[i][j]==1 into a new class.
            let cls = []
            let j = 0
            while j < n
                if M[i][j] == 1
                    cls.push(j)
                    assigned[j] = 1
                j = j + 1
            _req_sort_ints(cls)
            classes.push(cls)
        i = i + 1
    // Sort classes by their minimum element (first element after internal sort).
    // Insertion sort on the outer list by cls[0].
    let nc = len(classes)
    let ci = 1
    while ci < nc
        let key_cls = classes[ci]
        let key_val = key_cls[0]
        let cj = ci - 1
        while cj >= 0 and classes[cj][0] > key_val
            classes[cj + 1] = classes[cj]
            cj = cj - 1
        classes[cj + 1] = key_cls
        ci = ci + 1
    return classes

// req_partition_from_relation — alias for req_classes; returns the partition induced by M.
fn req_partition_from_relation(M, n)
    return req_classes(M, n)

// req_relation_from_partition — build the boolean matrix where M[i][j]=1 iff i and j
// belong to the same part in parts.  parts is a list of sorted int lists covering {0..n-1}.
fn req_relation_from_partition(parts, n)
    // Build an assignment array: assign[i] = index of the part containing i.
    let assign = []
    let ai = 0
    while ai < n
        assign.push(-1)
        ai = ai + 1
    let pi = 0
    while pi < len(parts)
        let part = parts[pi]
        let pj = 0
        while pj < len(part)
            assign[part[pj]] = pi
            pj = pj + 1
        pi = pi + 1
    // Build the matrix.
    let M = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            if assign[i] == assign[j]
                row.push(1)
            else
                row.push(0)
            j = j + 1
        M.push(row)
        i = i + 1
    return M

// req_are_equivalent — return 1 if a and b are related by M (i.e. M[a][b]==1).
fn req_are_equivalent(M, a, b)
    if M[a][b] == 1
        return 1
    return 0
