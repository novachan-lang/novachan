// std/relation/relation_core.nova — Core representation and utilities for binary relations.
// LEAF — imports NOTHING.
//
// A relation R on the set {0,1,...,n-1} is an n x n boolean matrix M
// (a list of n rows, each a list of n ints 0/1) where M[i][j]==1 iff (i,j) in R.
//
// Public API (prefix rn_):
//   rn_zeros(n)              -> n x n zero matrix
//   rn_from_pairs(pairs, n)  -> matrix from list of [i,j] pairs
//   rn_to_pairs(M)           -> sorted list of [i,j] pairs where M[i][j]==1
//   rn_identity(n)           -> n x n identity matrix (diagonal ones)
//   rn_universal(n)          -> n x n all-ones matrix
//   rn_contains(M, a, b)     -> 1 if M[a][b]==1 else 0
//   rn_size(M)               -> count of 1-entries in M
//   rn_domain(M)             -> sorted list of row indices i with some M[i][j]==1
//   rn_range(M)              -> sorted list of col indices j with some M[i][j]==1

// rn_zeros — build an n x n matrix of all zeros.
fn rn_zeros(n)
    let M = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            row.push(0)
            j += 1
        M.push(row)
        i += 1
    return M

// rn_from_pairs — build an n x n boolean matrix from a list of [a,b] pairs.
fn rn_from_pairs(pairs, n)
    let M = rn_zeros(n)
    for k in 0..len(pairs)
        let p = pairs[k]
        let a = p[0]
        let b = p[1]
        M[a][b] = 1
    return M

// _rn_sort_pairs — insertion-sort a list of [i,j] pairs by i then j (in-place).
fn _rn_sort_pairs(lst)
    let n = len(lst)
    let i = 1
    while i < n
        let key = lst[i]
        let ki = key[0]
        let kj = key[1]
        let pos = i - 1
        let done = 0
        while done == 0
            if pos < 0
                done = 1
            else
                let e = lst[pos]
                let ei = e[0]
                let ej = e[1]
                let before = 0
                if ei > ki
                    before = 1
                else
                    if ei == ki and ej > kj
                        before = 1
                if before == 1
                    lst[pos + 1] = lst[pos]
                    pos -= 1
                else
                    done = 1
        lst[pos + 1] = key
        i += 1

// rn_to_pairs — return sorted list of [i,j] pairs where M[i][j]==1.
fn rn_to_pairs(M)
    let pairs = []
    let n = len(M)
    let i = 0
    while i < n
        let row = M[i]
        for j in 0..n
            if row[j] == 1
                let p = []
                p.push(i)
                p.push(j)
                pairs.push(p)
        i += 1
    _rn_sort_pairs(pairs)
    return pairs

// rn_identity — build the n x n identity relation (M[i][i]=1, all else 0).
fn rn_identity(n)
    let M = rn_zeros(n)
    for i in 0..n
        M[i][i] = 1
    return M

// rn_universal — build the n x n all-ones relation.
fn rn_universal(n)
    let M = []
    for i in 0..n
        let row = []
        let j = 0
        while j < n
            row.push(1)
            j += 1
        M.push(row)
    return M

// rn_contains — return 1 if (a,b) is in relation M, else 0.
fn rn_contains(M, a, b)
    return M[a][b]

// rn_size — count the number of 1-entries in M.
fn rn_size(M)
    let count = 0
    let n = len(M)
    for i in 0..n
        let row = M[i]
        let j = 0
        while j < n
            if row[j] == 1
                count += 1
            j += 1
    return count

// _rn_sort_ints — insertion-sort a list of ints ascending (in-place).
fn _rn_sort_ints(lst)
    let n = len(lst)
    let i = 1
    while i < n
        let key = lst[i]
        let pos = i - 1
        let done = 0
        while done == 0
            if pos < 0
                done = 1
            else
                if lst[pos] > key
                    lst[pos + 1] = lst[pos]
                    pos -= 1
                else
                    done = 1
        lst[pos + 1] = key
        i += 1

// rn_domain — return sorted list of row indices i with at least one M[i][j]==1.
fn rn_domain(M)
    let n = len(M)
    let seen = []
    let i = 0
    while i < n
        let row = M[i]
        let found = 0
        let j = 0
        while j < n
            if row[j] == 1
                found = 1
            j += 1
        if found == 1
            seen.push(i)
        i += 1
    _rn_sort_ints(seen)
    return seen

// rn_range — return sorted list of col indices j with at least one M[i][j]==1.
fn rn_range(M)
    let n = len(M)
    let result = []
    for j in 0..n
        let found = 0
        let i = 0
        while i < n
            if M[i][j] == 1
                found = 1
            i += 1
        if found == 1
            result.push(j)
    _rn_sort_ints(result)
    return result
