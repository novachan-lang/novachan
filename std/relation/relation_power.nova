// ============================================================================
// NOVA Standard Library — std/relation/relation_power
// ============================================================================
// Relational powers, reachability, and transitive reduction for n×n boolean
// matrices (M[i][j]==1 iff (i,j) is in R).
//
// Public API:
//   rpow_compose(A, B, n)              -> M   relational composition A;B
//   rpow_power(M, n, k)                -> M   M composed k times (power 0 = identity)
//   rpow_reachable(M, n, i)            -> list  sorted set of j reachable from i via 1+ steps
//   rpow_transitive_reduction(M, n)    -> M   smallest relation with same transitive closure (DAG)
//   rpow_is_reachable(M, n, i, j)      -> int  1 if j is reachable from i in 1+ steps
//
// LEAF — imports nothing; all helpers prefixed rpow_.
// ============================================================================

// rpow_zero_matrix: build an n×n matrix of zeros.
fn rpow_zero_matrix(n)
    let M = []
    for i in 0..n
        let row = []
        let j = 0
        while j < n
            push(row, 0)
            j += 1
        push(M, row)
    M

// rpow_identity: build the n×n identity relation (reflexive closure base).
fn rpow_identity(n)
    let M = rpow_zero_matrix(n)
    let i = 0
    while i < n
        M[i][i] = 1
        i += 1
    M

// rpow_compose: relational composition A;B.
// Result[i][k] == 1 iff exists j: A[i][j]==1 and B[j][k]==1.
fn rpow_compose(A, B, n)
    let R = rpow_zero_matrix(n)
    for i in 0..n
        let j = 0
        while j < n
            if A[i][j] == 1
                let k = 0
                while k < n
                    if B[j][k] == 1
                        R[i][k] = 1
                    k += 1
            j += 1
    R

// rpow_copy_matrix: deep copy an n×n matrix.
fn rpow_copy_matrix(M, n)
    let R = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            push(row, M[i][j])
            j += 1
        push(R, row)
        i += 1
    R

// rpow_power: compute M^k (M composed with itself k times).
// M^0 = identity, M^1 = M, M^k = M;M^(k-1).
fn rpow_power(M, n, k)
    if k == 0
        return rpow_identity(n)
    let result = rpow_copy_matrix(M, n)
    let step = 1
    while step < k
        result = rpow_compose(result, M, n)
        step += 1
    result

// rpow_transitive_closure_mat: compute the transitive closure by iterated composition.
// Uses the standard n-step Warshall/BFS approach: TC[i][j]==1 iff j reachable from i in 1+ steps.
fn rpow_transitive_closure_mat(M, n)
    // Start with M itself (1-step reachability)
    let tc = rpow_copy_matrix(M, n)
    // Floyd-Warshall: for each intermediate k, close paths through k. Both legs must use
    // the EVOLVING closure tc (tc[i][k] and tc[k][j]) — using the original M for the second
    // leg misses multi-hop paths whose intermediate edges are discovered at later pivots.
    let k = 0
    while k < n
        let i = 0
        while i < n
            let j = 0
            while j < n
                if tc[i][k] == 1 and tc[k][j] == 1
                    tc[i][j] = 1
                j += 1
            i += 1
        k += 1
    tc

// rpow_reachable: return sorted list of j reachable from i via 1+ steps.
fn rpow_reachable(M, n, i)
    let tc = rpow_transitive_closure_mat(M, n)
    let result = []
    let j = 0
    while j < n
        if tc[i][j] == 1
            push(result, j)
        j += 1
    // result is already in sorted order since j increments 0..n-1
    result

// rpow_is_reachable: return 1 if j is reachable from i via 1+ steps in M.
fn rpow_is_reachable(M, n, i, j)
    let tc = rpow_transitive_closure_mat(M, n)
    tc[i][j]

// rpow_transitive_reduction: compute the transitive reduction of a DAG.
// Edge (i,j) is in the reduction iff M[i][j]==1 and there is NO path of length >=2
// from i to j through the existing edges.
// Correct for DAGs (acyclic relations); behaviour on cyclic relations is undefined.
fn rpow_transitive_reduction(M, n)
    // For a DAG: edge (i,j) stays iff there is no other path i->...->j of length >= 2.
    // Compute M^2+M^3+...+M^n (reachability in 2+ steps) via TC of M minus direct edges.
    // A simpler characterisation: remove (i,j) if there exists k != j with M[i][k]==1 and M[k][j] is reachable.
    // We use: build TC of M. Then (i,j) is in reduction iff M[i][j]==1 and
    //   there is no intermediate k with M[i][k]==1 and TC[k][j]==1 and k != j.
    let tc = rpow_transitive_closure_mat(M, n)
    let R = rpow_zero_matrix(n)
    for i in 0..n
        let j = 0
        while j < n
            if M[i][j] == 1
                // check if there is an alternative path i->k->...->j
                let redundant = 0
                let k = 0
                while k < n
                    if k != j and M[i][k] == 1 and tc[k][j] == 1
                        redundant = 1
                    k += 1
                if redundant == 0
                    R[i][j] = 1
            j += 1
    R
