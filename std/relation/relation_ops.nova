// std/relation/relation_ops.nova — Relational algebra operations on boolean matrices.
// LEAF — imports NOTHING.
//
// A relation R on the set {0,1,...,n-1} is an n x n boolean matrix M
// (a list of n rows, each a list of n ints 0/1) where M[i][j]==1 iff (i,j) in R.
//
// Public API (prefix rop_):
//   rop_union(A, B)       -> pointwise OR of two same-size matrices
//   rop_intersect(A, B)   -> pointwise AND of two same-size matrices
//   rop_difference(A, B)  -> A AND NOT B (set difference)
//   rop_complement(A)     -> flip all bits (NOT A)
//   rop_converse(A)       -> transpose: result[i][j] = A[j][i]
//   rop_compose(A, B)     -> relational composition: (i,k) in A;B iff exists j: A[i][j] and B[j][k]

// _rop_zeros — build an n x n zero matrix.
fn _rop_zeros(n)
    let M = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            row.push(0)
            j += 1
        M.push(row)
        i += 1
    return M

// rop_union — pointwise OR: result[i][j] = A[i][j] OR B[i][j].
fn rop_union(A, B)
    let n = len(A)
    let R = _rop_zeros(n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            let v = 0
            if A[i][j] == 1
                v = 1
            if B[i][j] == 1
                v = 1
            R[i][j] = v
            j += 1
        i += 1
    return R

// rop_intersect — pointwise AND: result[i][j] = A[i][j] AND B[i][j].
fn rop_intersect(A, B)
    let n = len(A)
    let R = _rop_zeros(n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            let v = 0
            if A[i][j] == 1 and B[i][j] == 1
                v = 1
            R[i][j] = v
            j += 1
        i += 1
    return R

// rop_difference — set difference: result[i][j] = A[i][j] AND NOT B[i][j].
fn rop_difference(A, B)
    let n = len(A)
    let R = _rop_zeros(n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            let v = 0
            if A[i][j] == 1 and B[i][j] == 0
                v = 1
            R[i][j] = v
            j += 1
        i += 1
    return R

// rop_complement — flip all bits: result[i][j] = 1 - A[i][j].
fn rop_complement(A)
    let n = len(A)
    let R = _rop_zeros(n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if A[i][j] == 1
                R[i][j] = 0
            else
                R[i][j] = 1
            j += 1
        i += 1
    return R

// rop_converse — transpose: result[i][j] = A[j][i] (converse/inverse relation).
fn rop_converse(A)
    let n = len(A)
    let R = _rop_zeros(n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            R[i][j] = A[j][i]
            j += 1
        i += 1
    return R

// rop_compose — relational composition A;B: (i,k) in result iff exists j with A[i][j] and B[j][k].
fn rop_compose(A, B)
    let n = len(A)
    let R = _rop_zeros(n)
    for i in 0..n
        let k = 0
        while k < n
            let found = 0
            let j = 0
            while j < n
                if A[i][j] == 1 and B[j][k] == 1
                    found = 1
                j += 1
            R[i][k] = found
            k += 1
    return R
