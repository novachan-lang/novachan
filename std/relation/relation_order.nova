// std/relation/relation_order.nova — Partial/total/strict orders on boolean n×n matrices.
// LEAF — imports NOTHING.
//
// Representation: M is a list of n rows, each a list of n ints 0/1.
// M[i][j]==1 iff (i,j) is in the relation.  n is passed explicitly.
//
// A PARTIAL ORDER is reflexive, antisymmetric, and transitive.
// A TOTAL ORDER (chain) is a partial order where every pair is comparable (connex).
// A STRICT ORDER is irreflexive and transitive (implies asymmetric).
// The COVERING relation (Hasse): (i,j) covers if i!=j, M[i][j]=1, and there is no
//   intermediate k (k!=i, k!=j) with M[i][k]=1 and M[k][j]=1.
// MINIMAL elements: i such that no j (j!=i) has M[j][i]=1.
// MAXIMAL elements: i such that no j (j!=i) has M[i][j]=1.
//
// Public API (prefix rord_):
//   rord_is_partial_order(M, n)  -> int   1 if reflexive+antisymmetric+transitive
//   rord_is_total_order(M, n)    -> int   1 if partial order + connex
//   rord_is_strict_order(M, n)   -> int   1 if irreflexive+transitive
//   rord_covers(M, n)            -> matrix  the covering/Hasse relation
//   rord_minimal(M, n)           -> list   sorted list of minimal elements
//   rord_maximal(M, n)           -> list   sorted list of maximal elements

// _rord_is_reflexive — return 1 if M[i][i]==1 for all i in {0..n-1}.
fn _rord_is_reflexive(M, n)
    let i = 0
    while i < n
        if M[i][i] != 1
            return 0
        i += 1
    return 1

// _rord_is_antisymmetric — return 1 if (M[i][j]=1 and M[j][i]=1) => i==j for all i,j.
fn _rord_is_antisymmetric(M, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if i != j
                if M[i][j] == 1 and M[j][i] == 1
                    return 0
            j += 1
        i += 1
    return 1

// _rord_is_transitive — return 1 if (M[i][k]=1 and M[k][j]=1) => M[i][j]=1.
fn _rord_is_transitive(M, n)
    let i = 0
    while i < n
        let k = 0
        while k < n
            if M[i][k] == 1
                let j = 0
                while j < n
                    if M[k][j] == 1
                        if M[i][j] != 1
                            return 0
                    j += 1
            k += 1
        i += 1
    return 1

// _rord_is_connex — return 1 if for all i!=j, M[i][j]=1 or M[j][i]=1.
fn _rord_is_connex(M, n)
    let i = 0
    while i < n
        for j in 0..n
            if i != j
                if M[i][j] != 1 and M[j][i] != 1
                    return 0
        i += 1
    return 1

// _rord_is_irreflexive — return 1 if M[i][i]==0 for all i.
fn _rord_is_irreflexive(M, n)
    for i in 0..n
        if M[i][i] != 0
            return 0
    return 1

// _rord_sort_ints — insertion sort a list of ints in ascending order (in-place).
fn _rord_sort_ints(lst)
    let n = len(lst)
    let i = 1
    while i < n
        let key = lst[i]
        let j = i - 1
        while j >= 0 and lst[j] > key
            lst[j + 1] = lst[j]
            j -= 1
        lst[j + 1] = key
        i += 1

// rord_is_partial_order — return 1 if M is reflexive, antisymmetric, and transitive.
fn rord_is_partial_order(M, n)
    if _rord_is_reflexive(M, n) != 1
        return 0
    if _rord_is_antisymmetric(M, n) != 1
        return 0
    if _rord_is_transitive(M, n) != 1
        return 0
    return 1

// rord_is_total_order — return 1 if M is a partial order AND every distinct pair is
// comparable (M[i][j]=1 or M[j][i]=1 for all i!=j).
fn rord_is_total_order(M, n)
    if rord_is_partial_order(M, n) != 1
        return 0
    if _rord_is_connex(M, n) != 1
        return 0
    return 1

// rord_is_strict_order — return 1 if M is irreflexive and transitive.
// (Irreflexive+transitive implies asymmetric: if M[i][j]=1 then M[j][i]=0.)
fn rord_is_strict_order(M, n)
    if _rord_is_irreflexive(M, n) != 1
        return 0
    if _rord_is_transitive(M, n) != 1
        return 0
    return 1

// rord_covers — return the covering (Hasse) relation as a boolean n×n matrix.
// (i,j) is in the covering iff i!=j, M[i][j]=1, and there is no intermediate
// k (k!=i, k!=j) with M[i][k]=1 and M[k][j]=1.
fn rord_covers(M, n)
    // Build a zero output matrix.
    let C = []
    for ci in 0..n
        let row = []
        let cj = 0
        while cj < n
            row.push(0)
            cj += 1
        C.push(row)
    // For each pair (i,j) with i!=j and M[i][j]=1, check for intermediates.
    let i = 0
    while i < n
        let j = 0
        while j < n
            if i != j and M[i][j] == 1
                // Check if any k intermediates the pair.
                let covered = 1
                for k in 0..n
                    if k != i and k != j
                        if M[i][k] == 1 and M[k][j] == 1
                            covered = 0
                if covered == 1
                    C[i][j] = 1
            j += 1
        i += 1
    return C

// rord_minimal — return sorted list of minimal elements of M.
// i is minimal if no j!=i satisfies M[j][i]=1 (nothing strictly below i).
// For a partial order with reflexive self-loops, i is minimal iff
// there is no j!=i with M[j][i]=1.
fn rord_minimal(M, n)
    let result = []
    let i = 0
    while i < n
        let has_below = 0
        let j = 0
        while j < n
            if j != i and M[j][i] == 1
                has_below = 1
            j += 1
        if has_below == 0
            result.push(i)
        i += 1
    _rord_sort_ints(result)
    return result

// rord_maximal — return sorted list of maximal elements of M.
// i is maximal if no j!=i satisfies M[i][j]=1 (nothing strictly above i).
fn rord_maximal(M, n)
    let result = []
    for i in 0..n
        let has_above = 0
        let j = 0
        while j < n
            if j != i and M[i][j] == 1
                has_above = 1
            j += 1
        if has_above == 0
            result.push(i)
    _rord_sort_ints(result)
    return result
