// std/lambda/lambda_term — Lambda calculus term ADT (de Bruijn indices)
//
// TERM REPRESENTATION (tagged lists):
//   VARIABLE:    ["var", k]        k = de Bruijn index (0 = innermost binder)
//   ABSTRACTION: ["lam", body]     body is a term
//   APPLICATION: ["app", f, a]     f and a are terms
//
// All public functions are prefixed lmt_.

// Construct a variable term with de Bruijn index k.
fn lmt_var(k) -> list
    let t = []
    push(t, "var")
    push(t, k)
    return t

// Construct a lambda abstraction with the given body term.
fn lmt_lam(body) -> list
    let t = []
    push(t, "lam")
    push(t, body)
    return t

// Construct an application of f to a.
fn lmt_app(f, a) -> list
    let t = []
    push(t, "app")
    push(t, f)
    push(t, a)
    return t

// Return true (1) if t is a variable term.
fn lmt_is_var(t) -> int
    if type_of(t) == "list"
        if len(t) >= 1
            if t[0] == "var"
                return 1
    return 0

// Return true (1) if t is a lambda abstraction.
fn lmt_is_lam(t) -> int
    if type_of(t) == "list"
        if len(t) >= 1
            if t[0] == "lam"
                return 1
    return 0

// Return true (1) if t is an application.
fn lmt_is_app(t) -> int
    if type_of(t) == "list"
        if len(t) >= 1
            if t[0] == "lam"
                return 0
            if t[0] == "var"
                return 0
            if t[0] == "app"
                return 1
    return 0

// _lmt_val_equal: compare two leaf values (int or string) for equality.
fn _lmt_val_equal(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "int"
        if a == b
            return 1
        return 0
    if ta == "string"
        if a == b
            return 1
        return 0
    return 0

// lmt_equal: structural (deep) equality of two terms.
// Recursively compares the tagged list structure.
fn lmt_equal(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "list"
        let na = len(a)
        let nb = len(b)
        if na != nb
            return 0
        // Compare element by element
        let i = 0
        let ok = 1
        while i < na
            let ai = a[i]
            let bi = b[i]
            let tia = type_of(ai)
            if tia == "list"
                let sub = lmt_equal(ai, bi)
                if sub == 0
                    ok = 0
            else
                let veq = _lmt_val_equal(ai, bi)
                if veq == 0
                    ok = 0
            i = i + 1
        return ok
    // Scalar comparison
    return _lmt_val_equal(a, b)

// lmt_size: count the total number of nodes in the term tree.
// Each var, lam, app counts as 1 node; their children add further nodes.
fn lmt_size(t) -> int
    if type_of(t) != "list"
        return 0
    if len(t) < 1
        return 0
    let tag = t[0]
    if tag == "var"
        return 1
    if tag == "lam"
        return 1 + lmt_size(t[1])
    if tag == "app"
        return 1 + lmt_size(t[1]) + lmt_size(t[2])
    return 0

// _lmt_is_closed_aux: check no free variable at binder-depth d.
// A var with index k is free iff k >= d.
fn _lmt_is_closed_aux(t, d) -> int
    if type_of(t) != "list"
        return 1
    if len(t) < 1
        return 1
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        if k >= d
            return 0
        return 1
    if tag == "lam"
        return _lmt_is_closed_aux(t[1], d + 1)
    if tag == "app"
        let lc = _lmt_is_closed_aux(t[1], d)
        if lc == 0
            return 0
        return _lmt_is_closed_aux(t[2], d)
    return 1

// lmt_is_closed: return true (1) if the term has no free variables.
fn lmt_is_closed(t) -> int
    return _lmt_is_closed_aux(t, 0)
