// std/lambda/lambda_beta — Beta reduction for lambda calculus (de Bruijn indices).
//
// TERM REPRESENTATION (tagged lists, all immutable):
//   VARIABLE:    ["var", k]      k = de Bruijn index (int), 0 = innermost binder.
//   ABSTRACTION: ["lam", body]   anonymous lambda; body is a term.
//   APPLICATION: ["app", f, a]   f and a are terms.
//
// SHIFT:  shift(d, c, t) adds d to every FREE variable (index >= c) in t.
// SUBST:  subst(j, s, t) substitutes s for variable j in t (capture-avoiding).
// BETA:   beta-contract (["app",["lam",b],s]) = shift(-1,0,subst(0,shift(1,0,s),b)).
// NORMAL ORDER: leftmost-outermost reduction to normal form (bounded by max_steps).
//
// All public functions are prefixed lbt_.

// lbt_mk_var builds a variable term ["var", k].
fn lbt_mk_var(k) -> list
    return ["var", k]

// lbt_mk_lam builds an abstraction term ["lam", body].
fn lbt_mk_lam(body) -> list
    return ["lam", body]

// lbt_mk_app builds an application term ["app", f, a].
fn lbt_mk_app(f, a) -> list
    return ["app", f, a]

// lbt_shift adds d to every free variable (index >= c) in term t.
fn lbt_shift(d, c, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = int(t[1])
        return lbt_mk_var(k + d if k >= c else k)
    if tag == "lam"
        return lbt_mk_lam(lbt_shift(d, c + 1, t[1]))
    return lbt_mk_app(lbt_shift(d, c, t[1]), lbt_shift(d, c, t[2]))

// lbt_subst substitutes term s for variable index j in term t (capture-avoiding).
fn lbt_subst(j, s, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = int(t[1])
        return s if k == j else lbt_mk_var(k)
    if tag == "lam"
        return lbt_mk_lam(lbt_subst(j + 1, lbt_shift(1, 0, s), t[1]))
    return lbt_mk_app(lbt_subst(j, s, t[1]), lbt_subst(j, s, t[2]))

// lbt_is_redex returns 1 iff t is a beta-redex: ["app",["lam",_],_].
fn lbt_is_redex(t) -> int
    if t[0] != "app"
        return 0
    if t[1][0] != "lam"
        return 0
    return 1

// lbt_contract beta-contracts the top-level redex of t (must be a redex).
fn lbt_contract(t) -> list
    let lam = t[1]
    let arg = t[2]
    let body = lam[1]
    return lbt_shift(-1, 0, lbt_subst(0, lbt_shift(1, 0, arg), body))

// lbt_step performs ONE leftmost-outermost (normal-order) beta step.
// Returns a 2-element list: [changed, t2].
// changed=1 if a step was taken; changed=0 if already in normal form.
fn lbt_step(t) -> list
    let tag = t[0]
    if tag == "var"
        return [0, t]
    if tag == "lam"
        let inner = lbt_step(t[1])
        return [int(inner[0]), lbt_mk_lam(inner[1])]
    // tag == "app"
    // Check outermost redex first (leftmost-outermost).
    if lbt_is_redex(t) == 1
        return [1, lbt_contract(t)]
    // Try left (function position) first.
    let f = t[1]
    let a = t[2]
    let lres = lbt_step(f)
    if int(lres[0]) == 1
        return [1, lbt_mk_app(lres[1], a)]
    // Try right (argument position).
    let rres = lbt_step(a)
    return [int(rres[0]), lbt_mk_app(f, rres[1])]

// lbt_normalize reduces t to normal form using normal order, bounded by max_steps.
// Returns the (possibly partially reduced) term.
fn lbt_normalize(t, max_steps) -> list
    let cur = t
    let steps = 0
    while steps < max_steps
        let r = lbt_step(cur)
        if int(r[0]) == 0
            break
        cur = r[1]
        steps += 1
    return cur

// lbt_is_normal_form returns 1 iff t contains no beta-redex anywhere.
fn lbt_is_normal_form(t) -> int
    let tag = t[0]
    if tag == "var"
        return 1
    if tag == "lam"
        return lbt_is_normal_form(t[1])
    // tag == "app"
    if lbt_is_redex(t) == 1
        return 0
    if lbt_is_normal_form(t[1]) == 0
        return 0
    return lbt_is_normal_form(t[2])
