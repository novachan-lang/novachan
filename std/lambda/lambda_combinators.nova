// std/lambda/lambda_combinators — Standard combinators as de Bruijn lambda terms.
//
// Term representation (de Bruijn):
//   ["var", k]    — variable with de Bruijn index k (0 = innermost binder)
//   ["lam", body] — lambda abstraction
//   ["app", f, a] — application
//
// All public functions are prefixed lcb_.

// Build a ["var",k] term.
fn lcb_var(k) -> list
    let t = []
    push(t, "var")
    push(t, k)
    return t

// Build a ["lam",body] term.
fn lcb_lam(body) -> list
    let t = []
    push(t, "lam")
    push(t, body)
    return t

// Build a ["app",f,a] term.
fn lcb_app(f, a) -> list
    let t = []
    push(t, "app")
    push(t, f)
    push(t, a)
    return t

// Shift: add d to every free variable index >= c in t.
fn lcb_shift(d, c, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        if k >= c
            return lcb_var(k + d)
        return lcb_var(k)
    if tag == "lam"
        return lcb_lam(lcb_shift(d, c + 1, t[1]))
    // app
    return lcb_app(lcb_shift(d, c, t[1]), lcb_shift(d, c, t[2]))

// Subst: substitute term s for variable index j in t.
fn lcb_subst(j, s, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        if k == j
            return s
        return lcb_var(k)
    if tag == "lam"
        return lcb_lam(lcb_subst(j + 1, lcb_shift(1, 0, s), t[1]))
    // app
    return lcb_app(lcb_subst(j, s, t[1]), lcb_subst(j, s, t[2]))

// Beta-contract a redex app(lam(body), arg).
fn lcb_beta(body, arg) -> list
    return lcb_shift(-1, 0, lcb_subst(0, lcb_shift(1, 0, arg), body))

// Single normal-order (leftmost-outermost) beta step.
// Returns [new_term, did_step]: did_step=1 if a redex was contracted, 0 if normal.
fn lcb_step1(t) -> list
    let tag = t[0]
    if tag == "var"
        let r = []
        push(r, t)
        push(r, 0)
        return r
    if tag == "lam"
        let inner = lcb_step1(t[1])
        let nbody = inner[0]
        let ds = inner[1]
        let r = []
        push(r, lcb_lam(nbody))
        push(r, ds)
        return r
    // app: check for beta redex at the outermost position first
    let f = t[1]
    let a = t[2]
    if f[0] == "lam"
        let contracted = lcb_beta(f[1], a)
        let r = []
        push(r, contracted)
        push(r, 1)
        return r
    // step in f
    let fr = lcb_step1(f)
    let nf = fr[0]
    let dsf = fr[1]
    if dsf == 1
        let r = []
        push(r, lcb_app(nf, a))
        push(r, 1)
        return r
    // step in a
    let ar = lcb_step1(a)
    let na = ar[0]
    let dsa = ar[1]
    let r2 = []
    push(r2, lcb_app(f, na))
    push(r2, dsa)
    return r2

// Normalize t using normal-order reduction, bounded by max steps.
fn lcb_normalize(t, max) -> list
    let steps = 0
    let cur = t
    let going = 1
    while going == 1 and steps < max
        let res = lcb_step1(cur)
        let nt = res[0]
        let ds = res[1]
        if ds == 0
            going = 0
        else
            cur = nt
            steps = steps + 1
    return cur

// --- Standard combinators as de Bruijn lambda terms ---

// I = lambda x. x  =  lam var(0)
fn lcb_I() -> list
    return lcb_lam(lcb_var(0))

// K = lambda x y. x  =  lam lam var(1)
fn lcb_K() -> list
    return lcb_lam(lcb_lam(lcb_var(1)))

// S = lambda x y z. x z (y z)
// de Bruijn: lam lam lam app(app(var2,var0),app(var1,var0))
fn lcb_S() -> list
    let xz = lcb_app(lcb_var(2), lcb_var(0))
    let yz = lcb_app(lcb_var(1), lcb_var(0))
    return lcb_lam(lcb_lam(lcb_lam(lcb_app(xz, yz))))

// B = lambda f g x. f (g x)  (composition combinator)
// de Bruijn: lam lam lam app(var2, app(var1, var0))
fn lcb_B() -> list
    let gx = lcb_app(lcb_var(1), lcb_var(0))
    return lcb_lam(lcb_lam(lcb_lam(lcb_app(lcb_var(2), gx))))

// C = lambda f x y. f y x  (flip combinator)
// de Bruijn: lam lam lam app(app(var2,var0),var1)
fn lcb_C() -> list
    let fy = lcb_app(lcb_var(2), lcb_var(0))
    return lcb_lam(lcb_lam(lcb_lam(lcb_app(fy, lcb_var(1)))))

// W = lambda f x. f x x  (duplication combinator)
// de Bruijn: lam lam app(app(var1,var0),var0)
fn lcb_W() -> list
    let fx = lcb_app(lcb_var(1), lcb_var(0))
    return lcb_lam(lcb_lam(lcb_app(fx, lcb_var(0))))

// omega = lambda x. x x
// de Bruijn: lam app(var0, var0)
fn lcb_omega() -> list
    return lcb_lam(lcb_app(lcb_var(0), lcb_var(0)))

// Y = lambda f. (lambda x. f (x x)) (lambda x. f (x x))
// de Bruijn: lam app(lam app(var1, app(var0,var0)), lam app(var1, app(var0,var0)))
fn lcb_Y() -> list
    let xx = lcb_app(lcb_var(0), lcb_var(0))
    let fxx = lcb_app(lcb_var(1), xx)
    let inner = lcb_lam(fxx)
    return lcb_lam(lcb_app(inner, inner))

// Structural equality of two terms.
fn lcb_term_eq(a, b) -> int
    let ta = a[0]
    let tb = b[0]
    if ta != tb
        return 0
    if ta == "var"
        if a[1] == b[1]
            return 1
        return 0
    if ta == "lam"
        return lcb_term_eq(a[1], b[1])
    // app
    if lcb_term_eq(a[1], b[1]) == 0
        return 0
    return lcb_term_eq(a[2], b[2])
