// std/lambda/lambda_encode — Church-encoded data structures and arithmetic extensions.
// Provides Church lists of Church numerals, predecessor, iszero, subtraction.
// Term representation (de Bruijn indices):
//   ["var", k]    — variable with index k (0 = innermost binder)
//   ["lam", body] — abstraction
//   ["app", f, a] — application
// Self-contained: imports nothing.  All public names prefixed lnc_.

// ── Term constructors ────────────────────────────────────────────────────────

// lnc_var: build a variable term with de Bruijn index k.
fn lnc_var(k) -> list
    let t = ["var", k]
    return t

// lnc_lam: build an abstraction term with the given body.
fn lnc_lam(body) -> list
    let t = ["lam", body]
    return t

// lnc_app: build an application term.
fn lnc_app(f, a) -> list
    let t = ["app", f, a]
    return t

// ── de Bruijn shift ──────────────────────────────────────────────────────────

// _lnc_shift: add d to every free variable (index >= c) in term t.
fn _lnc_shift(d, c, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        if k >= c
            return lnc_var(k + d)
        return lnc_var(k)
    if tag == "lam"
        return lnc_lam(_lnc_shift(d, c + 1, t[1]))
    let sf = _lnc_shift(d, c, t[1])
    let sa = _lnc_shift(d, c, t[2])
    return lnc_app(sf, sa)

// ── de Bruijn substitution ───────────────────────────────────────────────────

// _lnc_subst: substitute term s for variable index j in term t.
fn _lnc_subst(j, s, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        if k == j
            return s
        return lnc_var(k)
    if tag == "lam"
        let ns = _lnc_shift(1, 0, s)
        return lnc_lam(_lnc_subst(j + 1, ns, t[1]))
    let sf = _lnc_subst(j, s, t[1])
    let sa = _lnc_subst(j, s, t[2])
    return lnc_app(sf, sa)

// ── Beta reduction ───────────────────────────────────────────────────────────

// _lnc_beta: contract a redex ["app", ["lam", b], s] -> result term.
fn _lnc_beta(b, s) -> list
    let shifted_s = _lnc_shift(1, 0, s)
    let substituted = _lnc_subst(0, shifted_s, b)
    return _lnc_shift(-1, 0, substituted)

// ── Normal-order (leftmost-outermost) reduction ───────────────────────────────

// _lnc_step: attempt ONE normal-order reduction step; returns [changed, term].
fn _lnc_step(t) -> list
    let tag = t[0]
    if tag == "var"
        let r = [0, t]
        return r
    if tag == "lam"
        let inner = _lnc_step(t[1])
        if inner[0] == 1
            let r = [1, lnc_lam(inner[1])]
            return r
        let r = [0, t]
        return r
    // app
    let f = t[1]
    let a = t[2]
    if f[0] == "lam"
        let r = [1, _lnc_beta(f[1], a)]
        return r
    let sf = _lnc_step(f)
    if sf[0] == 1
        let r = [1, lnc_app(sf[1], a)]
        return r
    let sa = _lnc_step(a)
    if sa[0] == 1
        let r = [1, lnc_app(f, sa[1])]
        return r
    let r = [0, t]
    return r

// lnc_normalize: reduce t to normal form (up to 200000 steps).
fn lnc_normalize(t) -> list
    let cur = t
    let steps = 0
    while steps < 200000
        let res = _lnc_step(cur)
        if res[0] == 0
            return cur
        cur = res[1]
        steps = steps + 1
    return cur

// ── Church numerals (local copies) ───────────────────────────────────────────

// _lnc_build_apps: build f^n(x) where f=var(1), x=var(0).
fn _lnc_build_apps(n) -> list
    if n == 0
        return lnc_var(0)
    return lnc_app(lnc_var(1), _lnc_build_apps(n - 1))

// lnc_num: build the Church numeral term for non-negative integer n.
fn lnc_num(n) -> list
    return lnc_lam(lnc_lam(_lnc_build_apps(n)))

// _lnc_count_apps: count applications of var(1) in the body body of church(n).
fn _lnc_count_apps(t) -> int
    if t[0] == "var"
        return 0
    if t[0] == "app"
        return 1 + _lnc_count_apps(t[2])
    return 0

// lnc_decode_num: decode a Church numeral in normal form to a NOVA int.
fn lnc_decode_num(t) -> int
    if t[0] != "lam"
        return -1
    let inner1 = t[1]
    if inner1[0] != "lam"
        return -1
    return _lnc_count_apps(inner1[1])

// ── Church boolean helpers ────────────────────────────────────────────────────

// _lnc_true: TRUE = λ(λ(var 1))
fn _lnc_true() -> list
    return lnc_lam(lnc_lam(lnc_var(1)))

// _lnc_false: FALSE = λ(λ(var 0))
fn _lnc_false() -> list
    return lnc_lam(lnc_lam(lnc_var(0)))

// ── Church predecessor ────────────────────────────────────────────────────────

// lnc_church_pred: PRED combinator term.
// PRED = λn.λf.λx. n (λg.λh. h (g f)) (λu. x) (λu. u)
// Under λn.λf.λx (bindings n=2,f=1,x=0):
//   inner body λg.λh: g=var(1), f is now at index 3 (shifted by 2 more lambdas): app(var(1),var(3))
//   h (g f): h=var(0), so app(var(0), app(var(1),var(3)))
//   whole = lam(lam(app(var(0), app(var(1), var(3)))))
//   second arg: λu.x — x is now at index 1 (shifted by 1 lambda): lam(var(1))
//   third arg:  λu.u — identity: lam(var(0))
//   n = var(2): app(app(app(var(2), arg1), arg2), arg3)
fn lnc_church_pred() -> list
    let gf = lnc_app(lnc_var(1), lnc_var(3))
    let hgf = lnc_app(lnc_var(0), gf)
    let arg1 = lnc_lam(lnc_lam(hgf))
    let arg2 = lnc_lam(lnc_var(1))
    let arg3 = lnc_lam(lnc_var(0))
    let n_arg1 = lnc_app(lnc_var(2), arg1)
    let n_arg1_arg2 = lnc_app(n_arg1, arg2)
    let body = lnc_app(n_arg1_arg2, arg3)
    return lnc_lam(lnc_lam(lnc_lam(body)))

// ── Church iszero ─────────────────────────────────────────────────────────────

// lnc_church_iszero: ISZERO = λn. n (λx. FALSE) TRUE
// Under λn (n=var(0)):
//   λx.FALSE: x unused, FALSE = lam(lam(var(0))) shifted 1 = lam(lam(var(0))) (closed)
//   Under one extra lambda: FALSE closed = lam(lam(var(0)))
//   So arg = lam(lam(lam(var(0))))  [outer lam for x, inner 2 for FALSE itself]
//   TRUE = lam(lam(var(1))) — closed
//   body = app(app(var(0), lam(lam(lam(var(0))))), lam(lam(var(1))))
fn lnc_church_iszero() -> list
    let const_false = lnc_lam(lnc_lam(lnc_lam(lnc_var(0))))
    let tr = lnc_lam(lnc_lam(lnc_var(1)))
    let body = lnc_app(lnc_app(lnc_var(0), const_false), tr)
    return lnc_lam(body)

// ── Church subtraction ────────────────────────────────────────────────────────

// lnc_church_sub: SUB = λm.λn. n PRED m
// Under λm.λn (m=var(1), n=var(0)):
//   app(app(var(0), pred), var(1)) where pred is the closed PRED term
fn lnc_church_sub() -> list
    let pred = lnc_church_pred()
    let body = lnc_app(lnc_app(lnc_var(0), pred), lnc_var(1))
    return lnc_lam(lnc_lam(body))

// ── Church lists ──────────────────────────────────────────────────────────────

// lnc_nil: NIL = λc.λn. n = FALSE = λ(λ(var 0))
fn lnc_nil() -> list
    return lnc_lam(lnc_lam(lnc_var(0)))

// lnc_cons: CONS = λh.λt.λc.λn. c h (t c n)
// Under λh.λt.λc.λn (h=3, t=2, c=1, n=0):
//   t c n = app(app(var(2),var(1)),var(0))
//   c h (t c n) = app(app(var(1),var(3)), app(app(var(2),var(1)),var(0)))
fn lnc_cons() -> list
    let tcn = lnc_app(lnc_app(lnc_var(2), lnc_var(1)), lnc_var(0))
    let body = lnc_app(lnc_app(lnc_var(1), lnc_var(3)), tcn)
    return lnc_lam(lnc_lam(lnc_lam(lnc_lam(body))))

// lnc_isnil: ISNIL = λl. l (λh.λt. FALSE) TRUE
// Under λl (l=var(0)):
//   λh.λt.FALSE: h=var(1),t=var(0) unused; FALSE closed = lam(lam(var(0)))
//   Under 2 extra lambdas (h,t): FALSE stays lam(lam(var(0))) (closed)
//   const_false2 = lam(lam(lam(lam(var(0)))))
//   TRUE = lam(lam(var(1)))
fn lnc_isnil() -> list
    let const_false2 = lnc_lam(lnc_lam(lnc_lam(lnc_lam(lnc_var(0)))))
    let tr = lnc_lam(lnc_lam(lnc_var(1)))
    let body = lnc_app(lnc_app(lnc_var(0), const_false2), tr)
    return lnc_lam(body)

// lnc_head: HEAD = λl. l (λh.λt. h) DUMMY
// Under λl: l (λh.λt.h) anything; h is var(1) inside two lambdas
// dummy = lam(var(0)) (identity, doesn't matter for non-nil list)
fn lnc_head() -> list
    let pick_h = lnc_lam(lnc_lam(lnc_var(1)))
    let dummy = lnc_lam(lnc_var(0))
    let body = lnc_app(lnc_app(lnc_var(0), pick_h), dummy)
    return lnc_lam(body)

// lnc_tail: TAIL = λl. l (λh.λt. t) DUMMY
// Under λl: l (λh.λt.t) anything; t is var(0) inside two lambdas
fn lnc_tail() -> list
    let pick_t = lnc_lam(lnc_lam(lnc_var(0)))
    let dummy = lnc_lam(lnc_var(0))
    let body = lnc_app(lnc_app(lnc_var(0), pick_t), dummy)
    return lnc_lam(body)

// ── Practical list builder ────────────────────────────────────────────────────

// _lnc_cons_apply: apply CONS to head numeral h and tail list term t.
fn _lnc_cons_apply(h_term, t_term) -> list
    return lnc_app(lnc_app(lnc_cons(), h_term), t_term)

// lnc_from_list: build a Church list of Church numerals from a NOVA int list.
// Returns the Church list term (not normalized — apply lnc_normalize to reduce).
fn lnc_from_list(int_list) -> list
    let n = len(int_list)
    let acc = lnc_nil()
    let i = n - 1
    while i >= 0
        let h = lnc_num(int_list[i])
        acc = _lnc_cons_apply(h, acc)
        i = i - 1
    return acc

// ── Church list length ────────────────────────────────────────────────────────

// lnc_succ_closed: SUCC = λn.λf.λx. f (n f x) (closed term for embedding).
fn _lnc_succ_closed() -> list
    let nfx = lnc_app(lnc_app(lnc_var(2), lnc_var(1)), lnc_var(0))
    let body = lnc_app(lnc_var(1), nfx)
    return lnc_lam(lnc_lam(lnc_lam(body)))

// lnc_length: LENGTH combinator term.
// LENGTH = λl. l (λh.λacc. SUCC acc) ZERO
// Church list fold: l c n = c h1 (c h2 (... (c hn n)...))
// So c = λh.λacc. SUCC acc counts elements regardless of values.
// Under λl (l=var(0)):
//   c = λh.λacc. SUCC acc: h=var(1) ignored, acc=var(0)
//   SUCC acc = app(succ_closed, var(0)); succ_closed is closed so no free vars.
//   c = lam(lam(app(succ_closed, var(0))))
//   zero = lam(lam(var(0))) (closed)
//   body = app(app(var(0), c), zero)
fn lnc_length() -> list
    let succ = _lnc_succ_closed()
    let succ_acc = lnc_app(succ, lnc_var(0))
    let c_fn = lnc_lam(lnc_lam(succ_acc))
    let zero = lnc_lam(lnc_lam(lnc_var(0)))
    let body = lnc_app(lnc_app(lnc_var(0), c_fn), zero)
    return lnc_lam(body)
