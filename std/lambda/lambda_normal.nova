// std/lambda/lambda_normal — Reduction strategies and Church-Rosser demonstration.
//
// TERM REPRESENTATION (tagged lists, all immutable):
//   VARIABLE:    ["var", k]      k = de Bruijn index (int), 0 = innermost binder.
//   ABSTRACTION: ["lam", body]   anonymous lambda; body is a term.
//   APPLICATION: ["app", f, a]   f and a are terms.
//
// STRATEGIES implemented:
//   lnr_normal_order(t, max)    — leftmost-outermost; reaches NF if one exists.
//   lnr_applicative_order(t, max) — leftmost-innermost; may diverge on non-SN terms.
//   lnr_whnf(t, max)            — weak head normal form; reduces only the head redex.
//   lnr_count_steps(t, max)     — count normal-order beta steps to NF.
//   lnr_confluent(t, max)       — true iff normal_order and applicative_order reach
//                                  the same normal form (Church-Rosser witness).
//
// Implements own shift/subst/beta (self-contained, no imports).
// All public functions are prefixed lnr_.

// lnr_mk_var builds a variable term ["var", k].
fn lnr_mk_var(k) -> list
    let t = []
    push(t, "var")
    push(t, k)
    return t

// lnr_mk_lam builds an abstraction term ["lam", body].
fn lnr_mk_lam(body) -> list
    let t = []
    push(t, "lam")
    push(t, body)
    return t

// lnr_mk_app builds an application term ["app", f, a].
fn lnr_mk_app(f, a) -> list
    let t = []
    push(t, "app")
    push(t, f)
    push(t, a)
    return t

// lnr_shift adds d to every free variable (index >= c) in term t.
fn lnr_shift(d, c, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = int(t[1])
        if k >= c
            return lnr_mk_var(k + d)
        return lnr_mk_var(k)
    if tag == "lam"
        return lnr_mk_lam(lnr_shift(d, c + 1, t[1]))
    return lnr_mk_app(lnr_shift(d, c, t[1]), lnr_shift(d, c, t[2]))

// lnr_subst substitutes term s for variable index j in term t (capture-avoiding).
fn lnr_subst(j, s, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = int(t[1])
        if k == j
            return s
        return lnr_mk_var(k)
    if tag == "lam"
        return lnr_mk_lam(lnr_subst(j + 1, lnr_shift(1, 0, s), t[1]))
    return lnr_mk_app(lnr_subst(j, s, t[1]), lnr_subst(j, s, t[2]))

// lnr_contract beta-contracts the top-level redex (must be ["app",["lam",b],s]).
fn lnr_contract(t) -> list
    let lam = t[1]
    let arg = t[2]
    return lnr_shift(-1, 0, lnr_subst(0, lnr_shift(1, 0, arg), lam[1]))

// lnr_is_redex returns 1 iff t is a top-level beta-redex.
fn lnr_is_redex(t) -> int
    if t[0] != "app"
        return 0
    if t[1][0] != "lam"
        return 0
    return 1

// lnr_term_eq tests structural equality of two terms.
fn lnr_term_eq(a, b) -> int
    if len(a) != len(b)
        return 0
    if a[0] != b[0]
        return 0
    let tag = a[0]
    if tag == "var"
        if int(a[1]) != int(b[1])
            return 0
        return 1
    if tag == "lam"
        return lnr_term_eq(a[1], b[1])
    if lnr_term_eq(a[1], b[1]) == 0
        return 0
    return lnr_term_eq(a[2], b[2])

// lnr_no_step performs ONE normal-order (leftmost-outermost) beta step.
// Returns [changed, t2]: changed=1 if a step was taken, 0 if already normal.
fn lnr_no_step(t) -> list
    let tag = t[0]
    if tag == "var"
        let res = []
        push(res, 0)
        push(res, t)
        return res
    if tag == "lam"
        let r = lnr_no_step(t[1])
        let res = []
        push(res, int(r[0]))
        push(res, lnr_mk_lam(r[1]))
        return res
    // "app": outermost first (normal order).
    if lnr_is_redex(t) == 1
        let res = []
        push(res, 1)
        push(res, lnr_contract(t))
        return res
    let rl = lnr_no_step(t[1])
    if int(rl[0]) == 1
        let res = []
        push(res, 1)
        push(res, lnr_mk_app(rl[1], t[2]))
        return res
    let rr = lnr_no_step(t[2])
    let res = []
    push(res, int(rr[0]))
    push(res, lnr_mk_app(t[1], rr[1]))
    return res

// lnr_ao_step performs ONE applicative-order (leftmost-innermost) beta step.
// Reduces arguments BEFORE the function; only contracts when both sides are NF.
fn lnr_ao_step(t) -> list
    let tag = t[0]
    if tag == "var"
        let res = []
        push(res, 0)
        push(res, t)
        return res
    if tag == "lam"
        let r = lnr_ao_step(t[1])
        let res = []
        push(res, int(r[0]))
        push(res, lnr_mk_lam(r[1]))
        return res
    // "app": reduce function first (to find innermost), then argument, then contract.
    let rl = lnr_ao_step(t[1])
    if int(rl[0]) == 1
        let res = []
        push(res, 1)
        push(res, lnr_mk_app(rl[1], t[2]))
        return res
    // Function side is in NF; try argument.
    let rr = lnr_ao_step(t[2])
    if int(rr[0]) == 1
        let res = []
        push(res, 1)
        push(res, lnr_mk_app(t[1], rr[1]))
        return res
    // Both sides NF; contract if it's a redex.
    if lnr_is_redex(t) == 1
        let res = []
        push(res, 1)
        push(res, lnr_contract(t))
        return res
    let res = []
    push(res, 0)
    push(res, t)
    return res

// lnr_whnf_step performs ONE weak-head step (only at the head; no reduction under lam).
// Returns [changed, t2].
fn lnr_whnf_step(t) -> list
    let tag = t[0]
    if tag == "var"
        let res = []
        push(res, 0)
        push(res, t)
        return res
    if tag == "lam"
        // Do NOT reduce under a lambda in WHNF.
        let res = []
        push(res, 0)
        push(res, t)
        return res
    // "app": try to reach WHNF by reducing the function to a lambda, then contract.
    if lnr_is_redex(t) == 1
        let res = []
        push(res, 1)
        push(res, lnr_contract(t))
        return res
    // Reduce the function part towards its WHNF.
    let rl = lnr_whnf_step(t[1])
    let res = []
    push(res, int(rl[0]))
    push(res, lnr_mk_app(rl[1], t[2]))
    return res

// lnr_normal_order reduces t to normal form using leftmost-outermost strategy.
// Bounded by max_steps; returns the (possibly partially reduced) term.
fn lnr_normal_order(t, max_steps) -> list
    let cur = t
    let steps = 0
    let running = 1
    while running == 1 and steps < max_steps
        let r = lnr_no_step(cur)
        if int(r[0]) == 0
            running = 0
        if running == 1
            cur = r[1]
            steps += 1
    return cur

// lnr_applicative_order reduces t using leftmost-innermost strategy.
// Bounded by max_steps; returns the (possibly partially reduced) term.
fn lnr_applicative_order(t, max_steps) -> list
    let cur = t
    let steps = 0
    let running = 1
    while running == 1 and steps < max_steps
        let r = lnr_ao_step(cur)
        if int(r[0]) == 0
            running = 0
        if running == 1
            cur = r[1]
            steps += 1
    return cur

// lnr_whnf reduces t to weak head normal form.
// Bounded by max_steps; returns the (possibly partially reduced) term.
fn lnr_whnf(t, max_steps) -> list
    let cur = t
    let steps = 0
    let running = 1
    while running == 1 and steps < max_steps
        let r = lnr_whnf_step(cur)
        if int(r[0]) == 0
            running = 0
        if running == 1
            cur = r[1]
            steps += 1
    return cur

// lnr_count_steps counts the number of normal-order steps to reach normal form.
// Returns the count (0 if already in NF); stops at max_steps and returns max_steps.
fn lnr_count_steps(t, max_steps) -> int
    let cur = t
    let steps = 0
    let running = 1
    while running == 1 and steps < max_steps
        let r = lnr_no_step(cur)
        if int(r[0]) == 0
            running = 0
        if running == 1
            cur = r[1]
            steps += 1
    return steps

// lnr_confluent returns 1 iff normal_order and applicative_order reach the same NF.
// Uses structural equality on the resulting terms (Church-Rosser witness for SN terms).
fn lnr_confluent(t, max_steps) -> int
    let nf_no = lnr_normal_order(t, max_steps)
    let nf_ao = lnr_applicative_order(t, max_steps)
    return lnr_term_eq(nf_no, nf_ao)
