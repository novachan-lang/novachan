// std/lambda/lambda_named — Named lambda terms, alpha-conversion, and de Bruijn conversion.
//
// Named term representation:
//   ["nvar", name]        — named variable (name is a string)
//   ["nlam", name, body]  — lambda abstraction binding 'name'
//   ["napp", f, a]        — application
//
// de Bruijn term representation (used internally for conversion):
//   ["var", k]    — variable, de Bruijn index k (0 = innermost binder)
//   ["lam", body] — abstraction
//   ["app", f, a] — application
//
// All public functions are prefixed lnm_.

// --- de Bruijn builders ---

fn lnm_dvar(k) -> list
    return ["var", k]

fn lnm_dlam(body) -> list
    return ["lam", body]

fn lnm_dapp(f, a) -> list
    return ["app", f, a]

// --- Named term builders ---

// Build a named variable term.
fn lnm_nvar(name) -> list
    return ["nvar", name]

// Build a named abstraction term.
fn lnm_nlam(name, body) -> list
    return ["nlam", name, body]

// Build a named application term.
fn lnm_napp(f, a) -> list
    return ["napp", f, a]

// --- Stack helpers for binder lookup ---

// Find the de Bruijn index of 'name' in the binder stack (list of names).
// Stack is innermost-last (push appends to end); index 0 = last element.
// Returns -1 if not found (free variable).
fn lnm_find_index(stack, name) -> int
    let n = len(stack)
    for idx in 0..n
        if stack[n - 1 - idx] == name
            return idx
    return -1

// --- lnm_to_debruijn: convert named term to de Bruijn using a binder-name stack ---

fn lnm_to_db_rec(t, stack) -> list
    let tag = t[0]
    if tag == "nvar"
        let name = t[1]
        let k = lnm_find_index(stack, name)
        if k == -1
            // free variable: encode as ["fvar", name] — for the purpose of
            // alpha-equality, free vars are matched by NAME.
            return ["fvar", name]
        return lnm_dvar(k)
    if tag == "nlam"
        let nstack = [...stack, t[1]]
        return lnm_dlam(lnm_to_db_rec(t[2], nstack))
    // napp
    return lnm_dapp(lnm_to_db_rec(t[1], stack), lnm_to_db_rec(t[2], stack))

// Convert a named lambda term to de Bruijn. Free variables become ["fvar",name].
fn lnm_to_debruijn(named) -> list
    return lnm_to_db_rec(named, [])

// --- lnm_from_debruijn: convert de Bruijn to named term, generating fresh names ---

// Generate name for binder level n: x0, x1, x2, ...
fn lnm_gen_name(n) -> string
    return "x{n}"

fn lnm_from_db_rec(t, depth, names) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        // index k from innermost: depth - 1 - k gives the binder depth
        let binder_depth = depth - 1 - k
        if binder_depth < 0
            // Free variable (index beyond all binders): generate placeholder
            return lnm_nvar("_free{k}")
        return lnm_nvar(names[binder_depth])
    if tag == "fvar"
        return lnm_nvar(t[1])
    if tag == "lam"
        let name = lnm_gen_name(depth)
        let nnames = [...names, name]
        return lnm_nlam(name, lnm_from_db_rec(t[1], depth + 1, nnames))
    // app
    return lnm_napp(lnm_from_db_rec(t[1], depth, names), lnm_from_db_rec(t[2], depth, names))

// Convert a de Bruijn term to a named term, generating fresh names x0, x1, ...
fn lnm_from_debruijn(t) -> list
    return lnm_from_db_rec(t, 0, [])

// --- Structural equality on de Bruijn terms (used for alpha-equality) ---

fn lnm_db_eq(a, b) -> int
    let ta = a[0]
    if ta != b[0]
        return 0
    if ta == "var" or ta == "fvar"
        return 1 if a[1] == b[1] else 0
    if ta == "lam"
        return lnm_db_eq(a[1], b[1])
    // app
    if lnm_db_eq(a[1], b[1]) == 0
        return 0
    return lnm_db_eq(a[2], b[2])

// Alpha-equality: two named terms are alpha-equal iff their de Bruijn forms are identical.
fn lnm_alpha_equal(a, b) -> int
    let da = lnm_to_debruijn(a)
    let db = lnm_to_debruijn(b)
    return lnm_db_eq(da, db)

// --- Free variable names in a named term ---

// Check if name is already in list (linear scan).
fn lnm_list_has(lst, name) -> int
    1 if name in lst else 0

// Collect free variable names in named term, given a set of bound names.
fn lnm_free_rec(t, bound, result)
    let tag = t[0]
    if tag == "nvar"
        let name = t[1]
        if lnm_list_has(bound, name) == 0 and lnm_list_has(result, name) == 0
            push(result, name)
        return 0
    if tag == "nlam"
        let nbound = [...bound, t[1]]
        lnm_free_rec(t[2], nbound, result)
        return 0
    // napp
    lnm_free_rec(t[1], bound, result)
    lnm_free_rec(t[2], bound, result)
    return 0

// Return a list of free variable names in a named term (no duplicates, order of first occurrence).
fn lnm_free_names(named) -> list
    let result = []
    lnm_free_rec(named, [], result)
    return result
