// ============================================================================
// NOVA Standard Library — std/game/handcompare
// Compare two 5-card poker hands (standard ranking, no wild cards).
// ============================================================================
// Card convention: [rank, suit]
//   rank 2..14  (11=J, 12=Q, 13=K, 14=A)
//   suit 0..3   (0=clubs, 1=diamonds, 2=hearts, 3=spades)
//
// Hand ranks (returned by _hand_rank):
//   0 = high card    1 = one pair      2 = two pair
//   3 = three of a kind  4 = straight  5 = flush
//   6 = full house   7 = four of a kind  8 = straight flush
//
// Tiebreaker is encoded in a list returned by _hand_value; each element is
// compared lexicographically. The list is: [hand_rank, tb1, tb2, tb3, tb4, tb5]
// where tb1..tb5 carry progressively less-important ranks (always 5 slots).
//
// Public API:
//   compare_poker(a, b) -> int   1 = a wins, -1 = b wins, 0 = tie
//   beats(a, b)         -> bool  true if a strictly beats b
//   best_hand(hands)    -> int   index of the strongest hand in the list

// ── private helpers ────────────────────────────────────────────────────────

// Extract ranks from a 5-card hand (unsorted list of ints).
fn _ranks(hand)
    return [card[0] for card in hand]

// Extract suits from a 5-card hand.
fn _suits(hand)
    return [card[1] for card in hand]

// Simple insertion sort of a 5-element int list, descending (largest first).
fn _sort_desc(xs)
    let a = xs[0]
    let b = xs[1]
    let c = xs[2]
    let d = xs[3]
    let e = xs[4]
    // bubble-sort 5 elements (10 compares, stable, correct)
    let tmp = 0
    if a < b
        tmp = a
        a = b
        b = tmp
    if b < c
        tmp = b
        b = c
        c = tmp
    if c < d
        tmp = c
        c = d
        d = tmp
    if d < e
        tmp = d
        d = e
        e = tmp
    if a < b
        tmp = a
        a = b
        b = tmp
    if b < c
        tmp = b
        b = c
        c = tmp
    if c < d
        tmp = c
        c = d
        d = tmp
    if a < b
        tmp = a
        a = b
        b = tmp
    if b < c
        tmp = b
        b = c
        c = tmp
    if a < b
        tmp = a
        a = b
        b = tmp
    let out = [a, b, c, d, e]
    return out

// Count occurrences of `v` in a 5-element int list.
fn _count_val(xs, v) -> int
    let n = 0
    for i in 0..5
        if xs[i] == v
            n += 1
    return n

// Build a frequency list for ranks: list of [count, rank] pairs, sorted so that
// higher count comes first; within same count, higher rank comes first.
// Result always has exactly 5 entries (one per distinct rank, padded with [0,0]).
fn _rank_freq(sorted_ranks)
    // sorted_ranks is descending; walk and count runs
    let pairs = []
    for i in 0..5
        let r = sorted_ranks[i]
        let cnt = _count_val(sorted_ranks, r)
        // only emit once per distinct rank
        let already = 0
        for j in 0..len(pairs)
            let p = pairs[j]
            if p[1] == r
                already = 1
        if already == 0
            push(pairs, [cnt, r])
    // sort pairs: primary = count desc, secondary = rank desc
    // insertion sort over (up to 5) pairs
    let n = len(pairs)
    for k in 1..n
        let key = pairs[k]
        let m = k - 1
        while m >= 0
            let cur = pairs[m]
            let swap_needed = 0
            if cur[0] < key[0]
                swap_needed = 1
            else if cur[0] == key[0] and cur[1] < key[1]
                swap_needed = 1
            if swap_needed == 1
                pairs[m + 1] = cur
                m -= 1
            else
                m = 0 - 100
        pairs[m + 1] = key
    // pad to 5 pairs with [0, 0]
    while len(pairs) < 5
        push(pairs, [0, 0])
    return pairs

// Is the 5-element sorted-desc int list a straight?
// Handles the wheel: A-2-3-4-5 where A=14 -> treat as 1.
fn _is_straight(sr) -> int
    // normal straight: each card exactly 1 less than previous
    if sr[0] - sr[1] == 1 and sr[1] - sr[2] == 1 and sr[2] - sr[3] == 1 and sr[3] - sr[4] == 1
        return 1
    // wheel: A-5-4-3-2  => sorted desc [14,5,4,3,2]
    if sr[0] == 14 and sr[1] == 5 and sr[2] == 4 and sr[3] == 3 and sr[4] == 2
        return 1
    return 0

// High card of a straight (handles wheel where A plays low => returns 5).
fn _straight_high(sr) -> int
    if sr[0] == 14 and sr[1] == 5
        return 5
    return sr[0]

// Are all 5 suits the same?
fn _is_flush(suits) -> int
    let s = suits[0]
    if suits[1] != s
        return 0
    if suits[2] != s
        return 0
    if suits[3] != s
        return 0
    if suits[4] != s
        return 0
    return 1

// Compute a 6-element tiebreaker list: [hand_rank, tb1, tb2, tb3, tb4, tb5].
// tb slots are filled with meaningful values and padded with 0 to always have 5.
fn _hand_value(hand)
    let rs = _ranks(hand)
    let ss = _suits(hand)
    let sr = _sort_desc(rs)
    let is_f = _is_flush(ss)
    let is_s = _is_straight(sr)
    // straight flush
    if is_f == 1 and is_s == 1
        let sh = _straight_high(sr)
        return [8, sh, 0, 0, 0, 0]
    // four of a kind
    let freq = _rank_freq(sr)
    let p0 = freq[0]
    let p1 = freq[1]
    if p0[0] == 4
        return [7, p0[1], p1[1], 0, 0, 0]
    // full house
    if p0[0] == 3 and p1[0] == 2
        return [6, p0[1], p1[1], 0, 0, 0]
    // flush
    if is_f == 1
        return [5, sr[0], sr[1], sr[2], sr[3], sr[4]]
    // straight
    if is_s == 1
        let sh2 = _straight_high(sr)
        return [4, sh2, 0, 0, 0, 0]
    // three of a kind
    if p0[0] == 3
        let p2 = freq[2]
        return [3, p0[1], p1[1], p2[1], 0, 0]
    // two pair
    let p2b = freq[2]
    if p0[0] == 2 and p1[0] == 2
        return [2, p0[1], p1[1], p2b[1], 0, 0]
    // one pair
    if p0[0] == 2
        let p3 = freq[3]
        return [1, p0[1], p1[1], p2b[1], p3[1], 0]
    // high card
    let p3b = freq[3]
    let p4 = freq[4]
    return [0, p0[1], p1[1], p2b[1], p3b[1], p4[1]]

// Lexicographic compare of two 6-element value lists.
// Returns 1 if va > vb, -1 if va < vb, 0 if equal.
fn _cmp_value(va, vb) -> int
    for i in 0..6
        let a = va[i]
        let b = vb[i]
        if a > b
            return 1
        if a < b
            return 0 - 1
    return 0

// ── Public API ─────────────────────────────────────────────────────────────

// compare_poker(a, b) -> 1 if hand a wins, -1 if hand b wins, 0 if tie.
// Each hand is a 5-element list of [rank, suit] cards.
fn compare_poker(a, b) -> int
    let va = _hand_value(a)
    let vb = _hand_value(b)
    return _cmp_value(va, vb)

// beats(a, b) -> 1 (true) if hand a strictly beats hand b, else 0 (false).
fn beats(a, b) -> int
    return compare_poker(a, b) == 1

// best_hand(hands) -> index of the winning hand in the list.
// If `hands` is empty returns -1. Ties broken by first occurrence.
fn best_hand(hands) -> int
    let n = len(hands)
    if n == 0
        return 0 - 1
    let best_i = 0
    let best_v = _hand_value(hands[0])
    for i in 1..n
        let v = _hand_value(hands[i])
        if _cmp_value(v, best_v) == 1
            best_i = i
            best_v = v
    return best_i
