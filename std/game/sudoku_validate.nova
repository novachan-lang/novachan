// std/game/sudoku_validate.nova — Validate a 9x9 Sudoku board.
//
// Board layout: a flat list of 81 ints, row-major order.
//   board[r*9 + c] = digit at row r, col c (0 = empty).
//
// Public API:
//   is_valid_sudoku(board) -> bool
//       Returns true if the board has no duplicate non-zero digit in any row,
//       column, or 3x3 box. Empty cells (0) are ignored.
//   is_complete(board) -> bool
//       Returns true if every cell is filled (no 0) AND is_valid_sudoku passes.

// Check a single group of 9 cell indices for duplicate digits.
// Returns 1 if the group is valid (no duplicates in 1-9), 0 otherwise.
fn _check_group(board, idx0, idx1, idx2, idx3, idx4, idx5, idx6, idx7, idx8)
    let seen = [0 for i in 0..10]
    let ok = 1
    let v0 = board[idx0]
    if v0 > 0
        if seen[v0] == 1
            ok = 0
        if seen[v0] == 0
            seen[v0] = 1
    let v1 = board[idx1]
    if v1 > 0 and ok == 1
        if seen[v1] == 1
            ok = 0
        if seen[v1] == 0
            seen[v1] = 1
    let v2 = board[idx2]
    if v2 > 0 and ok == 1
        if seen[v2] == 1
            ok = 0
        if seen[v2] == 0
            seen[v2] = 1
    let v3 = board[idx3]
    if v3 > 0 and ok == 1
        if seen[v3] == 1
            ok = 0
        if seen[v3] == 0
            seen[v3] = 1
    let v4 = board[idx4]
    if v4 > 0 and ok == 1
        if seen[v4] == 1
            ok = 0
        if seen[v4] == 0
            seen[v4] = 1
    let v5 = board[idx5]
    if v5 > 0 and ok == 1
        if seen[v5] == 1
            ok = 0
        if seen[v5] == 0
            seen[v5] = 1
    let v6 = board[idx6]
    if v6 > 0 and ok == 1
        if seen[v6] == 1
            ok = 0
        if seen[v6] == 0
            seen[v6] = 1
    let v7 = board[idx7]
    if v7 > 0 and ok == 1
        if seen[v7] == 1
            ok = 0
        if seen[v7] == 0
            seen[v7] = 1
    let v8 = board[idx8]
    if v8 > 0 and ok == 1
        if seen[v8] == 1
            ok = 0
        if seen[v8] == 0
            seen[v8] = 1
    ok

// Returns true if the board has no duplicate non-zero digit in any row, col, or 3x3 box.
fn is_valid_sudoku(board)
    let ok = 1
    // Check 9 rows
    let r = 0
    while r < 9 and ok == 1
        let base = r * 9
        let g = _check_group(board, base+0, base+1, base+2, base+3, base+4, base+5, base+6, base+7, base+8)
        if g == 0
            ok = 0
        r = r + 1
    // Check 9 cols
    let c = 0
    while c < 9 and ok == 1
        let g = _check_group(board, c+0, c+9, c+18, c+27, c+36, c+45, c+54, c+63, c+72)
        if g == 0
            ok = 0
        c = c + 1
    // Check 9 boxes (3x3)
    let br = 0
    while br < 3 and ok == 1
        let bc = 0
        while bc < 3 and ok == 1
            let b0 = br*27 + bc*3
            let g = _check_group(board, b0+0, b0+1, b0+2, b0+9, b0+10, b0+11, b0+18, b0+19, b0+20)
            if g == 0
                ok = 0
            bc = bc + 1
        br = br + 1
    ok == 1

// Returns true if every cell is non-zero and the board is valid.
fn is_complete(board)
    for i in 0..81
        if board[i] == 0
            return false
    is_valid_sudoku(board)
