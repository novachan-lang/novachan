// std/game/card.nova — Card representation for card game modules.
//
// A card is a 2-element list [rank, suit].
//   rank : 2..14  (2-9, 10=T, 11=J, 12=Q, 13=K, 14=A)
//   suit : 0..3   (0=C clubs, 1=D diamonds, 2=H hearts, 3=S spades)
//
// API:
//   card(rank, suit)   -> list [rank, suit]
//   card_rank(c)       -> int
//   card_suit(c)       -> int
//   card_eq(a, b)      -> bool
//   rank_name(rank)    -> string   ("2".."9","T","J","Q","K","A")
//   suit_name(suit)    -> string   ("C","D","H","S")
//   card_name(c)       -> string   e.g. [14,3]->"AS"
//   card_parse(name)   -> list     e.g. "AS"->[14,3]

// Construct a card from rank and suit.
fn card(rank: int, suit: int) -> list
    let c = []
    push(c, rank)
    push(c, suit)
    c

// Extract rank from a card.
fn card_rank(c: list) -> int
    c[0]

// Extract suit from a card.
fn card_suit(c: list) -> int
    c[1]

// Test two cards for equality.
fn card_eq(a: list, b: list) -> bool
    let ra = a[0]
    let sa = a[1]
    let rb = b[0]
    let sb = b[1]
    ra == rb and sa == sb

// Convert a rank integer to its single-char string name.
// 2-9 -> "2"-"9", 10->"T", 11->"J", 12->"Q", 13->"K", 14->"A"
fn rank_name(rank: int) -> string
    let result = "?"
    if rank == 2
        result = "2"
    if rank == 3
        result = "3"
    if rank == 4
        result = "4"
    if rank == 5
        result = "5"
    if rank == 6
        result = "6"
    if rank == 7
        result = "7"
    if rank == 8
        result = "8"
    if rank == 9
        result = "9"
    if rank == 10
        result = "T"
    if rank == 11
        result = "J"
    if rank == 12
        result = "Q"
    if rank == 13
        result = "K"
    if rank == 14
        result = "A"
    result

// Convert a suit integer to its single-char string name.
// 0->"C", 1->"D", 2->"H", 3->"S"
fn suit_name(suit: int) -> string
    let result = "?"
    if suit == 0
        result = "C"
    if suit == 1
        result = "D"
    if suit == 2
        result = "H"
    if suit == 3
        result = "S"
    result

// Return the two-character name of a card, e.g. [14,3]->"AS".
fn card_name(c: list) -> string
    let r = c[0]
    let s = c[1]
    let rn = rank_name(r)
    let sn = suit_name(s)
    rn + sn

// Parse a rank character to its integer value.
// "2"-"9"->2-9, "T"->10, "J"->11, "Q"->12, "K"->13, "A"->14
fn _parse_rank(ch: string) -> int
    let result = 0
    if ch == "2"
        result = 2
    if ch == "3"
        result = 3
    if ch == "4"
        result = 4
    if ch == "5"
        result = 5
    if ch == "6"
        result = 6
    if ch == "7"
        result = 7
    if ch == "8"
        result = 8
    if ch == "9"
        result = 9
    if ch == "T"
        result = 10
    if ch == "J"
        result = 11
    if ch == "Q"
        result = 12
    if ch == "K"
        result = 13
    if ch == "A"
        result = 14
    result

// Parse a suit character to its integer value.
// "C"->0, "D"->1, "H"->2, "S"->3
fn _parse_suit(ch: string) -> int
    let result = 0
    if ch == "D"
        result = 1
    if ch == "H"
        result = 2
    if ch == "S"
        result = 3
    result

// Parse a 2-character card name to [rank, suit].
// e.g. "AS"->[14,3], "TH"->[10,2], "KD"->[13,1]
fn card_parse(name: string) -> list
    let rch = slice(name, 0, 1)
    let sch = slice(name, 1, 2)
    let r = _parse_rank(rch)
    let s = _parse_suit(sch)
    let c = []
    push(c, r)
    push(c, s)
    c
