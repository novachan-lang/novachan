// std/game/deck.nova — Standard 52-card deck utilities.
// LEAF — imports NOTHING.
//
// Card convention: a card is a 2-element list [rank, suit].
//   rank: 2..14  (11=J, 12=Q, 13=K, 14=A high)
//   suit: 0..3   (0=clubs, 1=diamonds, 2=hearts, 3=spades)
//
// Standard deck order: suit 0..3 outer, rank 2..14 inner.
//   card 0  = [2,0]  (2 of clubs)
//   card 51 = [14,3] (Ace of spades)
//
// Public API:
//   deck()                   -> list   52 cards in standard order
//   deck_size()              -> int    always 52
//   deck_contains(cards, c)  -> bool   true iff c is in cards
//   deck_index(c)            -> int    0..51 position in standard deck order
//   euchre_deck()            -> list   24 cards (ranks 9..14, suits 0..3)
//   pinochle_deck()          -> list   48 cards (ranks 9..14, suits 0..3, doubled)

// deck — build the standard 52-card deck.
// Order: suit 0..3 (outer), rank 2..14 (inner).
fn deck()
    let cards = []
    let suit = 0
    while suit <= 3
        let rank = 2
        while rank <= 14
            let card = [rank, suit]
            push(cards, card)
            rank = rank + 1
        suit = suit + 1
    cards

// deck_size — always returns 52.
fn deck_size()
    52

// _deck_card_eq — compare two cards for equality.
fn _deck_card_eq(a, b)
    a[0] == b[0] and a[1] == b[1]

// deck_contains — true iff card c appears in the list cards.
fn deck_contains(cards, c)
    let n = len(cards)
    let i = 0
    let found = false
    while i < n
        if _deck_card_eq(cards[i], c)
            found = true
        i = i + 1
    found

// deck_index — return 0..51 position of card c in standard deck order.
// Formula: suit * 13 + (rank - 2).
// Returns -1 for invalid inputs (rank outside 2..14 or suit outside 0..3).
fn deck_index(c)
    let rank = c[0]
    let suit = c[1]
    if suit < 0 or suit > 3
        return -1
    if rank < 2 or rank > 14
        return -1
    suit * 13 + (rank - 2)

// euchre_deck — 24-card euchre deck: ranks 9..14, suits 0..3.
// Order: suit 0..3 (outer), rank 9..14 (inner).
fn euchre_deck()
    let cards = []
    let suit = 0
    while suit <= 3
        let rank = 9
        while rank <= 14
            let card = [rank, suit]
            push(cards, card)
            rank = rank + 1
        suit = suit + 1
    cards

// pinochle_deck — 48-card pinochle deck: ranks 9..14, suits 0..3, two copies each.
// Order: suit 0..3 (outer), rank 9..14 (inner), copy 0..1 (innermost).
fn pinochle_deck()
    let cards = []
    let suit = 0
    while suit <= 3
        let rank = 9
        while rank <= 14
            let card1 = [rank, suit]
            push(cards, card1)
            let card2 = [rank, suit]
            push(cards, card2)
            rank = rank + 1
        suit = suit + 1
    cards
