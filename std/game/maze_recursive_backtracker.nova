// std/game/maze_recursive_backtracker.nova
//
// Randomized depth-first-search (recursive backtracker) maze generator.
//
// A maze is an ADJACENCY LIST:
//   links = list of w*h lists; links[c] = list of cells connected to c.
// Passages are BIDIRECTIONAL. A perfect maze has exactly w*h-1 edges.
//
// API:
//   gen(w, h, seed) -> list   (the links adjacency list)
//
// Inline grid helpers, seeded LCG RNG.

// ---- seeded LCG RNG ----

fn _mz_rng(state: int) -> int
    let ns = (state * 1103515245 + 12345) & 0x7FFFFFFF
    ns

fn _mz_randint(state: int, n: int) -> list
    let ns = _mz_rng(state)
    let v = ns % n
    let r = []
    push(r, ns)
    push(r, v)
    r

// ---- build list of unvisited neighbors of cell c in w x h grid ----

fn _unvisited_neighbors(c: int, w: int, h: int, visited: list) -> list
    let nbrs = []
    let row = c / w
    let col = c % w
    // up
    if row > 0
        let up = c - w
        if visited[up] == 0
            push(nbrs, up)
    // down
    if row < h - 1
        let dn = c + w
        if visited[dn] == 0
            push(nbrs, dn)
    // left
    if col > 0
        let lf = c - 1
        if visited[lf] == 0
            push(nbrs, lf)
    // right
    if col < w - 1
        let rt = c + 1
        if visited[rt] == 0
            push(nbrs, rt)
    nbrs

// ---- stack push: reuse slot or extend ----
// stk is the backing list; stk_top is the logical size (in a 1-element list).
// Call: _stk_push(stk, stk_top, val) -> mutates stk and stk_top[0].

fn _stk_push(stk: list, stk_top: list, val: int)
    let t = stk_top[0]
    let sz = len(stk)
    if t < sz
        stk[t] = val
    else
        push(stk, val)
    stk_top[0] = t + 1

// ---- peek top ----
fn _stk_top(stk: list, stk_top: list) -> int
    stk[stk_top[0] - 1]

// ---- pop (decrement logical top) ----
fn _stk_pop(stk_top: list)
    stk_top[0] = stk_top[0] - 1

// ---- generate maze via iterative randomized DFS ----
// Returns the links adjacency list.

fn gen(w: int, h: int, seed: int) -> list
    let total = w * h

    // Build links: list of 'total' empty lists
    let links = []
    let bi = 0
    while bi < total
        let empty = []
        push(links, empty)
        bi = bi + 1

    // visited array: 0=unvisited, 1=visited
    let visited = []
    let vi = 0
    while vi < total
        push(visited, 0)
        vi = vi + 1

    // stack: backing list + 1-element list holding logical top
    let stk = []
    let stk_top = []
    push(stk_top, 0)

    // push initial cell 0
    visited[0] = 1
    _stk_push(stk, stk_top, 0)

    let rng = seed
    // max iterations: each cell is pushed once and popped once = 2*total
    let max_iters = total * 2 + 4
    let iters = 0

    while stk_top[0] > 0 and iters < max_iters
        iters = iters + 1

        let current = _stk_top(stk, stk_top)
        let nbrs = _unvisited_neighbors(current, w, h, visited)
        let nc = len(nbrs)

        if nc == 0
            // backtrack: pop current cell
            _stk_pop(stk_top)
        else
            // pick a random unvisited neighbor
            let rr = _mz_randint(rng, nc)
            rng = rr[0]
            let pick = rr[1]
            let next = nbrs[pick]

            // carve passage: bidirectional
            push(links[current], next)
            push(links[next], current)

            // mark visited and push onto stack
            visited[next] = 1
            _stk_push(stk, stk_top, next)

    links

