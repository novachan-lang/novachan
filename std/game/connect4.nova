// std/game/connect4.nova — Connect-4 game logic.
//
// Board: flat list of rows*cols ints (row-major, 0=empty, 1=player1, 2=player2).
// Cell (r, c) -> index r*cols + c.  Row 0 = top, row (rows-1) = bottom.
//
// Public API:
//   c4_drop(board, cols, rows, col, player) -> list
//       Returns a NEW board with the piece dropped in the lowest empty slot
//       of the given column.  If the column is full, returns the board unchanged.
//   c4_winner(board, cols, rows) -> int
//       Returns 0 (no winner yet), 1, or 2.  Checks all 4-in-a-row directions.
// LEAF — imports nothing.

// c4_drop — drop a piece for `player` in column `col`.
// Scans from the bottom row upward to find the first empty cell.
// Returns a new list (shallow copy with one cell replaced).
fn c4_drop(board, cols, rows, col, player)
    // find lowest empty row in this column (scan from bottom)
    let drop_row = -1
    let r = rows - 1
    while r >= 0
        let idx = r * cols + col
        if board[idx] == 0
            drop_row = r
            r = -1
        r = r - 1
    // build a copy of the board
    let total = rows * cols
    let nb = [board[i] for i in 0..total]
    // place piece if a slot was found
    if drop_row >= 0
        let place = drop_row * cols + col
        nb[place] = player
    nb

// Private: check if cell (r,c) is in bounds.
fn _c4_inbounds(r, c, rows, cols)
    if r < 0
        return 0
    if r >= rows
        return 0
    if c < 0
        return 0
    if c >= cols
        return 0
    return 1

// Private: check 4-in-a-row starting at (r,c) going (dr,dc).
// Returns player (1 or 2) if there are 4 in a row, else 0.
fn _c4_run4(board, cols, rows, r, c, dr, dc)
    let p = board[r * cols + c]
    if p == 0
        return 0
    let count = 1
    let rr = r + dr
    let cc = c + dc
    while count < 4
        if _c4_inbounds(rr, cc, rows, cols) == 0
            return 0
        if board[rr * cols + cc] != p
            return 0
        count = count + 1
        rr = rr + dr
        cc = cc + dc
    p

// c4_winner — scan the whole board for 4-in-a-row in all 4 directions.
// Returns 1, 2, or 0.
fn c4_winner(board, cols, rows)
    let winner = 0
    let r = 0
    while r < rows and winner == 0
        let c = 0
        while c < cols and winner == 0
            // horizontal
            let w = _c4_run4(board, cols, rows, r, c, 0, 1)
            if w != 0
                winner = w
            // vertical
            if winner == 0
                w = _c4_run4(board, cols, rows, r, c, 1, 0)
                if w != 0
                    winner = w
            // diagonal down-right
            if winner == 0
                w = _c4_run4(board, cols, rows, r, c, 1, 1)
                if w != 0
                    winner = w
            // diagonal down-left
            if winner == 0
                w = _c4_run4(board, cols, rows, r, c, 1, -1)
                if w != 0
                    winner = w
            c = c + 1
        r = r + 1
    winner
