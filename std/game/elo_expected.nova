// std/game/elo_expected.nova — ELO expected score calculation.
// elo_expected(ra, rb) = 1 / (1 + 10^((rb-ra)/400))
// Returns the probability that player A (rating ra) beats player B (rating rb).
// Result is in [0.0, 1.0]. LEAF — imports nothing.

// elo_expected — probability that player A beats player B.
//   ra: rating of player A (float)
//   rb: rating of player B (float)
// Returns float in [0.0, 1.0].
fn elo_expected(ra: float, rb: float) -> float
    let diff = rb - ra
    let scaled = diff / 400.0
    let p = pow(10.0, scaled)
    let denom = 1.0 + p
    let result = 1.0 / denom
    result
