// std/game/bridge.nova — Bridge hand evaluation (13 cards).
// LEAF — imports nothing.
//
// Card convention (shared across std/game/):
//   A card is a 2-element list [rank, suit].
//   rank 2..14 (11=J, 12=Q, 13=K, 14=A). suit 0..3 (0=C,1=D,2=H,3=S).
//
// Public API:
//   bridge_hcp(hand)         -> int   High-card points: A=4 K=3 Q=2 J=1.
//   bridge_suit_lengths(hand)-> list  [clubs, diamonds, hearts, spades] lengths.
//   bridge_dist_points(hand) -> int   Distribution (short-suit): void=3 singleton=2 doubleton=1.
//   bridge_total(hand)       -> int   hcp + dist_points.
//   bridge_is_balanced(hand) -> bool  4-3-3-3, 4-4-3-2, or 5-3-3-2 distributions.

// _br_hcp_for_rank(rank) -> int  HCP value for a single rank.
fn _br_hcp_for_rank(rank: int) -> int
    let pts = 0
    if rank == 14
        pts = 4
    if rank == 13
        pts = 3
    if rank == 12
        pts = 2
    if rank == 11
        pts = 1
    pts

// bridge_hcp(hand) -> int
// Sum of high-card points across all 13 cards.
// A=4, K=3, Q=2, J=1, all others 0.
fn bridge_hcp(hand: list) -> int
    let total = 0
    for i in 0..len(hand)
        let card = hand[i]
        let rank = card[0]
        total = total + _br_hcp_for_rank(rank)
    total

// bridge_suit_lengths(hand) -> list [clubs, diamonds, hearts, spades]
// Counts how many cards of each suit are in the hand.
fn bridge_suit_lengths(hand: list) -> list
    let clubs = 0
    let diamonds = 0
    let hearts = 0
    let spades = 0
    for i in 0..len(hand)
        let card = hand[i]
        let suit = card[1]
        if suit == 0
            clubs = clubs + 1
        if suit == 1
            diamonds = diamonds + 1
        if suit == 2
            hearts = hearts + 1
        if suit == 3
            spades = spades + 1
    let result = []
    push(result, clubs)
    push(result, diamonds)
    push(result, hearts)
    push(result, spades)
    result

// _br_dist_for_len(length) -> int
// Short-suit distribution points: void (0 cards)=3, singleton (1)=2, doubleton (2)=1.
fn _br_dist_for_len(length: int) -> int
    let pts = 0
    if length == 0
        pts = 3
    if length == 1
        pts = 2
    if length == 2
        pts = 1
    pts

// bridge_dist_points(hand) -> int
// Total distribution (short-suit) points across all four suits.
fn bridge_dist_points(hand: list) -> int
    let lengths = bridge_suit_lengths(hand)
    let pts = 0
    pts = pts + _br_dist_for_len(lengths[0])
    pts = pts + _br_dist_for_len(lengths[1])
    pts = pts + _br_dist_for_len(lengths[2])
    pts = pts + _br_dist_for_len(lengths[3])
    pts

// bridge_total(hand) -> int
// Combined evaluation: HCP + distribution points.
fn bridge_total(hand: list) -> int
    let h = bridge_hcp(hand)
    let d = bridge_dist_points(hand)
    h + d

// _br_sort4_desc(a, b, c, d) -> list of 4 ints sorted descending.
// Insertion sort on 4 elements.
fn _br_sort4_desc(a: int, b: int, c: int, d: int) -> list
    let s = []
    push(s, a)
    push(s, b)
    push(s, c)
    push(s, d)
    for i in 1..4
        let key = s[i]
        let j = i - 1
        while j >= 0 and s[j] < key
            s[j + 1] = s[j]
            j = j - 1
        s[j + 1] = key
    s

// bridge_is_balanced(hand) -> bool
// A hand is balanced if its suit-length pattern (sorted desc) is:
//   4-3-3-3, 4-4-3-2, or 5-3-3-2.
// These are the only three balanced distributions in bridge.
fn bridge_is_balanced(hand: list) -> bool
    let lengths = bridge_suit_lengths(hand)
    let s = _br_sort4_desc(lengths[0], lengths[1], lengths[2], lengths[3])
    let v0 = s[0]
    let v1 = s[1]
    let v2 = s[2]
    let v3 = s[3]
    // 4-3-3-3
    if v0 == 4 and v1 == 3 and v2 == 3 and v3 == 3
        return true
    // 4-4-3-2
    if v0 == 4 and v1 == 4 and v2 == 3 and v3 == 2
        return true
    // 5-3-3-2
    if v0 == 5 and v1 == 3 and v2 == 3 and v3 == 2
        return true
    false
