// std/game/round_robin.nova — Round-robin tournament scheduling.
// Uses the circle/polygon method.
// For n players (even): n-1 rounds, each round has n/2 pairs.
// For n players (odd): n rounds, each round has (n-1)/2 real pairs + 1 bye pair [id,-1].
//   A bye is represented as player id 0 (internal phantom).
//
// Public API:
//   total_rounds(n) -> int
//   round_robin_schedule(n) -> list of rounds; each round = list of [a,b] pairs
// LEAF — imports nothing.

fn total_rounds(n: int) -> int
    let r = n - 1
    if n - (n / 2) * 2 != 0
        r = n
    r

// Build one round from the fixed/rotating arrangement.
// slots[0] is fixed (or bye), slots[1..n-1] rotate.
// We pair slot[0] with slot[n-1], slot[1] with slot[n-2], etc.
fn _build_round(slots: list) -> list
    let pairs = []
    let n = len(slots)
    let half = n / 2
    let i = 0
    while i < half
        let a = slots[i]
        let b = slots[n - 1 - i]
        // skip bye-vs-bye (only if both are 0, defensive)
        let pair = []
        if a == 0
            // a is the bye slot; b gets a bye
            push(pair, b)
            push(pair, -1)
        else if b == 0
            push(pair, a)
            push(pair, -1)
        else
            push(pair, a)
            push(pair, b)
        push(pairs, pair)
        i = i + 1
    pairs

// Rotate slots[1..] one position to the right.
fn _rotate(slots: list) -> list
    let n = len(slots)
    let out = []
    push(out, slots[0])
    // last element of slots goes to position 1
    push(out, slots[n - 1])
    let i = 1
    while i < n - 1
        push(out, slots[i])
        i = i + 1
    out

fn round_robin_schedule(n: int) -> list
    // If n is odd, add a phantom player 0 (bye seat) to make it even.
    let is_odd = 0
    if n - (n / 2) * 2 != 0
        is_odd = 1
    let effective = n
    if is_odd == 1
        effective = n + 1
    // Build initial slot array: [1, 2, 3, ..., effective]
    // Player 0 is the phantom bye (only used when n is odd).
    let slots = []
    let k = 1
    while k <= effective
        if is_odd == 1 and k == effective
            push(slots, 0)
        else
            push(slots, k)
        k = k + 1
    let rounds = []
    let r = total_rounds(n)
    let round_idx = 0
    while round_idx < r
        let round = _build_round(slots)
        push(rounds, round)
        slots = _rotate(slots)
        round_idx = round_idx + 1
    rounds
