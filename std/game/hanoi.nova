// std/game/hanoi.nova — Tower of Hanoi solver.
//
// Public API:
//   hanoi_count(n)                        -> int   number of moves = 2^n - 1
//   hanoi_moves(n, from_peg, to_peg, via_peg) -> list  list of [from,to] moves in order
//
// Algorithm: classic recursive Hanoi.
//   To move n disks from F to T using V:
//     1. Move n-1 disks from F to V using T
//     2. Move disk n from F to T
//     3. Move n-1 disks from V to T using F
//
// hanoi_count uses fast exponentiation (2^n - 1); no recursion needed for the count.

// hanoi_count — return the number of moves required for n disks (= 2^n - 1).
fn hanoi_count(n: int) -> int
    // compute 2^n by doubling
    let p = 1
    for i in 0..n
        p = p * 2
    p - 1

// _hanoi_rec — internal recursive helper; appends [from,to] pairs to moves list.
// Bounded by n (recursion depth = n; n disks implies 2^n - 1 total calls).
fn _hanoi_rec(n: int, from_peg: int, to_peg: int, via_peg: int, moves: list)
    if n <= 0
        return null
    // move n-1 disks out of the way
    _hanoi_rec(n - 1, from_peg, via_peg, to_peg, moves)
    // move disk n
    push(moves, [from_peg, to_peg])
    // move n-1 disks onto destination
    _hanoi_rec(n - 1, via_peg, to_peg, from_peg, moves)

// hanoi_moves — return the ordered list of [from,to] moves for n disks.
fn hanoi_moves(n: int, from_peg: int, to_peg: int, via_peg: int) -> list
    let moves = []
    _hanoi_rec(n, from_peg, to_peg, via_peg, moves)
    moves
