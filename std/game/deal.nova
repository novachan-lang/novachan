// std/game/deal -- Card dealing utilities. LEAF -- imports NOTHING.
//
// Card convention: a card is a 2-element list [rank, suit].
//   rank 2..14 (11=J, 12=Q, 13=K, 14=A high). suit 0..3 (0=C, 1=D, 2=H, 3=S).
//
// Public API:
//   deal(cards: list, players: int, per_hand: int) -> list
//     Deal cards round-robin to `players` players, `per_hand` cards each.
//     Returns a list of `players` hands (each a list of cards).
//     Cards are consumed left-to-right, round-robin by player index.
//     If cards runs out before per_hand*players cards are dealt, remaining hands are shorter.
//
//   deal_all(cards: list, players: int) -> list
//     Deal every card round-robin. Same as deal(cards, players, len(cards)).
//     Returns a list of `players` hands.
//
//   cut(cards: list, at: int) -> list
//     Split deck at position `at`. Returns [top, bottom] where top=cards[0..at],
//     bottom=cards[at..end]. 0<=at<=len(cards).
//
//   draw(cards: list, n: int) -> list
//     Draw n cards from the front. Returns [drawn, remaining].
//     drawn=cards[0..n], remaining=cards[n..end]. Clamped: n>len(cards) draws all.

// PRIVATE: build an empty list of `n` empty lists (one per player).
fn _deal_make_hands(n: int) -> list
    let hands = []
    for i in 0..n
        let h = []
        push(hands, h)
    hands

// PRIVATE: return cards[start..end] as a new list.
fn _deal_slice_cards(cards: list, start: int, stop: int) -> list
    let out = []
    let i = start
    while i < stop
        push(out, cards[i])
        i = i + 1
    out

// deal(cards, players, per_hand) -> list of hands (round-robin).
// hand[p] gets card at indices p, p+players, p+2*players, ... up to per_hand cards each.
fn deal(cards: list, players: int, per_hand: int) -> list
    let hands = _deal_make_hands(players)
    let total = len(cards)
    // We deal at most per_hand cards per player, consuming cards in round-robin order.
    // The i-th card dealt goes to player (i % players).
    let max_cards = players * per_hand
    let dealt = 0
    let card_idx = 0
    while card_idx < total and dealt < max_cards
        let player = card_idx - (card_idx / players) * players
        // player = card_idx % players (NOVA has no % operator, compute via division)
        let h = hands[player]
        push(h, cards[card_idx])
        dealt = dealt + 1
        card_idx = card_idx + 1
    hands

// deal_all(cards, players) -> list of hands (deal every card round-robin).
fn deal_all(cards: list, players: int) -> list
    let hands = _deal_make_hands(players)
    let total = len(cards)
    for card_idx in 0..total
        let player = card_idx - (card_idx / players) * players
        let h = hands[player]
        push(h, cards[card_idx])
    hands

// cut(cards, at) -> [top, bottom]. top=first `at` cards, bottom=rest.
fn cut(cards: list, at: int) -> list
    let total = len(cards)
    let clamp = at
    if clamp < 0
        clamp = 0
    if clamp > total
        clamp = total
    let top = _deal_slice_cards(cards, 0, clamp)
    let bottom = _deal_slice_cards(cards, clamp, total)
    let result = []
    push(result, top)
    push(result, bottom)
    result

// draw(cards, n) -> [drawn, remaining]. drawn=first n cards, remaining=rest.
fn draw(cards: list, n: int) -> list
    let total = len(cards)
    let clamp = n
    if clamp < 0
        clamp = 0
    if clamp > total
        clamp = total
    let drawn = _deal_slice_cards(cards, 0, clamp)
    let remaining = _deal_slice_cards(cards, clamp, total)
    let result = []
    push(result, drawn)
    push(result, remaining)
    result
