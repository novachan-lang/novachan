// std/game/blackjack.nova — Blackjack hand value calculation.
// A card is a 2-element list [rank, suit].
//   rank 2..14 (11=J, 12=Q, 13=K, 14=A). suit 0..3.
// Face cards (J/Q/K) = 10. Ace = 11 or 1 (best total <=21). Pip = face value.
//
// Public API:
//   bj_value(cards)       -> int   best total <=21, or bust total if all options bust
//   bj_is_bust(cards)     -> bool  total > 21
//   bj_is_blackjack(cards)-> bool  exactly 2 cards totaling 21
//   bj_is_soft(cards)     -> bool  an ace is counted as 11 in the best total
// LEAF — imports nothing.

// Private: pip value of a single card rank for blackjack.
// Ace (14) counted as 11 here; adjustment done in bj_value.
fn _bj_pip(rank: int) -> int
    let v = rank
    if rank == 11
        v = 10
    if rank == 12
        v = 10
    if rank == 13
        v = 10
    if rank == 14
        v = 11
    v

// bj_value — best blackjack total for a hand of any size.
// Each ace may count as 11 or 1. The algorithm: sum all cards treating
// aces as 11, then for each ace reduce by 10 (11->1) while total > 21.
fn bj_value(cards: list) -> int
    let total = 0
    let aces = 0
    let i = 0
    while i < len(cards)
        let card = cards[i]
        let rank = card[0]
        let pip = _bj_pip(rank)
        total = total + pip
        if rank == 14
            aces = aces + 1
        i = i + 1
    // Reduce aces from 11 to 1 while busting
    for j in 0..aces
        if total > 21
            total = total - 10
    total

// bj_is_bust — true if the best total exceeds 21.
fn bj_is_bust(cards: list) -> bool
    let v = bj_value(cards)
    v > 21

// bj_is_blackjack — true if exactly 2 cards and total == 21.
fn bj_is_blackjack(cards: list) -> bool
    if len(cards) != 2
        return false
    let v = bj_value(cards)
    v == 21

// bj_is_soft — true if at least one ace is counted as 11 in the best total.
// An ace is soft (counted as 11) when: there is at least one ace AND
// the best total (with that ace as 11) does not exceed 21 — i.e.,
// the total without reducing any ace is still <=21.
fn bj_is_soft(cards: list) -> bool
    let aces = 0
    let total = 0
    for i in 0..len(cards)
        let card = cards[i]
        let rank = card[0]
        let pip = _bj_pip(rank)
        total = total + pip
        if rank == 14
            aces = aces + 1
    // Count how many aces we need to reduce to reach <=21
    let reduced = 0
    for j in 0..aces
        if total > 21
            total = total - 10
            reduced = reduced + 1
    // Soft if there's at least one ace still counted as 11
    let soft_aces = aces - reduced
    soft_aces > 0
