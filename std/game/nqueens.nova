// std/game/nqueens.nova — N-Queens backtracking solver.
//
// Public API:
//   nqueens_count(n) -> int
//       Returns the number of distinct solutions to the N-queens problem.
//   nqueens_first(n) -> list
//       Returns one solution as a list of n column positions (cols[row]=col),
//       or [] if n < 1 or no solution exists.

// Check whether placing a queen at (row, col) is safe given the queens list
// cols[0..row-1].
fn _is_safe(cols, row, col)
    let ok = 1
    let r = 0
    while r < row and ok == 1
        let c = cols[r]
        if c == col
            ok = 0
        let diff = row - r
        if c == col + diff
            ok = 0
        if c == col - diff
            ok = 0
        r = r + 1
    ok

// Count solutions via backtracking.
// cols is the current placement list (len == current row).
// n is the board size.
fn _count_bt(cols, n)
    let row = len(cols)
    if row == n
        return 1
    let total = 0
    for col in 0..n
        if _is_safe(cols, row, col) == 1
            push(cols, col)
            total = total + _count_bt(cols, n)
            // pop by rebuilding cols up to row elements
            let tmp = []
            let k = 0
            while k < row
                push(tmp, cols[k])
                k = k + 1
            let kk = 0
            while kk < len(cols)
                cols[kk] = 0
                kk = kk + 1
            // We can't truly pop from a list in NOVA, so use a helper approach:
            // Instead, track length separately by using a fixed-size array.
            // Rebuild: copy tmp back into cols (but len(cols) is now row+1)
            // This approach does not shrink cols. Use index-based tracking instead.
            total = total
    total

// We need a different approach that avoids push/implicit-pop.
// Use an index-based fixed-size array of length n.

// Count all N-queens solutions for board size n.
// Uses a pre-allocated array and an explicit depth counter.
fn _count_rec(cols, n, row)
    if row == n
        return 1
    let total = 0
    for col in 0..n
        // Check safety against all already-placed rows
        let ok = 1
        let r = 0
        while r < row and ok == 1
            let c = cols[r]
            if c == col
                ok = 0
            let diff = row - r
            if c == col + diff
                ok = 0
            if c == col - diff
                ok = 0
            r = r + 1
        if ok == 1
            cols[row] = col
            total = total + _count_rec(cols, n, row + 1)
            cols[row] = -1
    total

// Build the initial cols array of n elements all set to -1.
fn _make_cols(n)
    let cols = [-1 for i in 0..n]
    cols

// Returns the number of distinct N-queens solutions.
fn nqueens_count(n)
    if n < 1
        return 0
    let cols = _make_cols(n)
    _count_rec(cols, n, 0)

// Find the first solution; returns [] if none.
fn _first_rec(cols, n, row)
    if row == n
        return 1
    let col = 0
    let found = 0
    while col < n and found == 0
        let ok = 1
        let r = 0
        while r < row and ok == 1
            let c = cols[r]
            if c == col
                ok = 0
            let diff = row - r
            if c == col + diff
                ok = 0
            if c == col - diff
                ok = 0
            r = r + 1
        if ok == 1
            cols[row] = col
            let sub = _first_rec(cols, n, row + 1)
            if sub == 1
                found = 1
            if sub == 0
                cols[row] = -1
        col = col + 1
    found

// Returns the first solution as a list of column indices, or [] if none.
fn nqueens_first(n)
    if n < 1
        return []
    let cols = _make_cols(n)
    let ok = _first_rec(cols, n, 0)
    if ok == 1
        return cols
    let empty = []
    empty
