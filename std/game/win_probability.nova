// std/game/win_probability.nova — Win probability and expected score calculations.
//
// Elo-based win probability formulas.
//
// API:
//   win_prob(ra, rb)                        -> float  probability player A beats player B
//   match_expected_score(ra, rb, n_games)   -> float  expected score for A over n_games
//   upset_chance(favorite, underdog)        -> float  probability underdog beats favorite
//
// Formulas:
//   win_prob(ra, rb) = 1 / (1 + 10^((rb - ra) / 400))
//   match_expected_score(ra, rb, n) = n * win_prob(ra, rb)
//   upset_chance(fav, und) = win_prob(und, fav)
//
// LEAF module — imports nothing.

// win_prob: probability that player with rating ra beats player with rating rb.
// Returns value in [0, 1].
fn win_prob(ra: float, rb: float) -> float
    let diff = rb - ra
    let exponent = diff / 400.0
    let p = pow(10.0, exponent)
    let denom = 1.0 + p
    let result = 1.0 / denom
    result

// match_expected_score: expected total score for player A across n_games vs player B.
// Each game score: 1=win, 0=loss, 0.5=draw; expected value = n * win_prob(ra, rb).
fn match_expected_score(ra: float, rb: float, n_games: float) -> float
    let wp = win_prob(ra, rb)
    let result = n_games * wp
    result

// upset_chance: probability that the underdog beats the favorite.
// Equivalent to win_prob(underdog, favorite).
fn upset_chance(favorite: float, underdog: float) -> float
    let result = win_prob(underdog, favorite)
    result
