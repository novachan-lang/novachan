// std/game/maze_kruskals.nova -- Randomized Kruskal's maze generator.
//
// Generates a PERFECT maze (spanning tree) on a w x h grid using
// randomized Kruskal's algorithm:
//   1. Enumerate all internal wall-edges between adjacent cells.
//   2. Fisher-Yates shuffle them with a seeded LCG.
//   3. Process in shuffled order: carve the edge if the two cells
//      belong to different sets (union-find). Stop when w*h-1 edges carved.
//
// Grid convention (shared across std/game/maze_* modules):
//   cell index c = row*w + col, for c in 0..w*h-1
//   row = c/w,  col = c%w
//   neighbors: up=c-w, down=c+w, left=c-1, right=c+1 (with bounds checks)
//
// Adjacency list (links):
//   links = list of w*h lists; links[c] = cells connected to c by open passages.
//   Passages are bidirectional: carving a<->b pushes b onto links[a] and
//   a onto links[b].
//
// Public API:
//   gen(w, h, seed) -> list   complete adjacency-list for a perfect maze
//
// NOVA GOTCHAS obeyed:
//   * push(list, x) MUTATES and returns unit -- never assign its return value
//   * Boolean ops: and/or/not (not &&/||/!)
//   * No multi-line list/dict literals
//   * >> is arithmetic -- mask before using as unsigned
//   * Reserved words not used as variable names
//   * Every let must be READ (no dead bindings)
//   * push(out, x) to append a single element to a list -- NEVER out = out + [x]
//     (that reallocates and copies the whole list every call: O(n) per append,
//     O(n^2) over a full build).

// ── Seeded LCG (Knuth/Park-Miller, 31-bit output) ───────────────────────────

// _mz_rng: advance LCG state, return new state.
// state' = (state * 1103515245 + 12345) & 0x7FFFFFFF
fn _mz_rng(state: int) -> int
    (state * 1103515245 + 12345) & 0x7FFFFFFF

// _mz_randint: return [new_state, value_in_0..n-1].
// n must be >= 1.
fn _mz_randint(state: int, n: int) -> list
    let ns = _mz_rng(state)
    let v = ns % n
    let res = [ns, v]
    res

// ── Union-Find (path-compression, iterative) ─────────────────────────────────

// _uf_make: create a union-find structure for sz elements.
// Returns a list of sz ints where parent[i] = i (each node is its own root).
fn _uf_make(sz: int) -> list
    [i for i in 0..sz]

// _uf_find: iterative find with path compression (two-pass).
// First pass: walk up to root. Second pass: flatten all nodes to root.
// Returns root of c in the union-find structure par.
fn _uf_find(par: list, c: int) -> int
    // Walk to root
    let root = c
    while par[root] != root
        root = par[root]
    // Path compression: point every node on the path directly to root
    let node = c
    while node != root
        let nxt = par[node]
        par[node] = root
        node = nxt
    root

// _uf_union: merge the sets containing a and b.
// Returns 1 if they were in different sets (merge happened), 0 if already same set.
fn _uf_union(par: list, a: int, b: int) -> int
    let ra = _uf_find(par, a)
    let rb = _uf_find(par, b)
    if ra == rb
        return 0
    par[ra] = rb
    1

// ── Edge enumeration ─────────────────────────────────────────────────────────

// _mz_edges: enumerate all internal wall-edges for a w x h grid.
// Horizontal edges (left-right): for each row r, col 0..w-2: edge (r*w+col, r*w+col+1)
// Vertical edges (up-down): for each row r 0..h-2, col 0..w-1: edge (r*w+col, (r+1)*w+col)
// Returns a flat list of [a, b] pairs (each pair is a 2-element list).
fn _mz_edges(w: int, h: int) -> list
    let edges = []
    // Horizontal edges
    for r in 0..h
        for col in 0..(w - 1)
            let a = r * w + col
            let b = a + 1
            let e = [a, b]
            push(edges, e)
    // Vertical edges
    for rr in 0..(h - 1)
        for cc in 0..w
            let a2 = rr * w + cc
            let b2 = a2 + w
            let e2 = [a2, b2]
            push(edges, e2)
    edges

// ── Fisher-Yates shuffle of edges list (in-place) ───────────────────────────

// _mz_shuffle_edges: Fisher-Yates shuffle using seeded LCG.
// Mutates the edges list in place. Returns the final LCG state (unused by caller).
fn _mz_shuffle_edges(edges: list, seed: int) -> int
    let n = len(edges)
    let st = seed
    let i = n - 1
    while i > 0
        let rr = _mz_randint(st, i + 1)
        st = rr[0]
        let j = rr[1]
        let tmp = edges[i]
        edges[i] = edges[j]
        edges[j] = tmp
        i -= 1
    st

// ── gen: main public entry point ─────────────────────────────────────────────

// gen: generate a perfect maze on a w x h grid using randomized Kruskal's.
// Returns links: a list of w*h lists where links[c] = list of neighbor cells
// connected to c by open passages.
// seed: any integer; same seed -> same maze (deterministic).
fn gen(w: int, h: int, seed: int) -> list
    let total = w * h
    // Build adjacency list: total empty lists
    let links = []
    for ci in 0..total
        let nb = []
        push(links, nb)
    // Union-find for connectivity tracking
    let par = _uf_make(total)
    // Enumerate and shuffle all wall edges
    let edges = _mz_edges(w, h)
    _mz_shuffle_edges(edges, seed)
    // Process edges in shuffled order; carve if endpoints in different sets
    let nedges = len(edges)
    let carved = 0
    let need = total - 1
    let ei = 0
    while ei < nedges and carved < need
        let e = edges[ei]
        let ca = e[0]
        let cb = e[1]
        let merged = _uf_union(par, ca, cb)
        if merged == 1
            push(links[ca], cb)
            push(links[cb], ca)
            carved += 1
        ei += 1
    links
