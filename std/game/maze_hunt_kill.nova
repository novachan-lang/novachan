// std/game/maze_hunt_kill.nova — Hunt-and-kill maze generation.
//
// Random-walk carving to unvisited neighbors; when stuck, 'hunt' scans for
// the first unvisited cell adjacent to a visited cell, carves into it, and
// continues the walk.  Produces a perfect maze (spanning tree).
//
// Grid convention:
//   w x h grid; cell index c = row*w + col.
//   Neighbors: up=c-w, down=c+w, left=c-1, right=c+1 (bounds-checked).
//   links[c] = list of cells c has an open passage to (bidirectional).
//
// Public API:
//   gen(w, h, seed) -> list   (list of w*h lists; the adjacency structure)

// --- Seeded LCG RNG (deterministic) ---

fn _mz_rng(state)
    return (state * 1103515245 + 12345) & 0x7FFFFFFF

fn _mz_randint(state, n)
    let ns = _mz_rng(state)
    return [ns, ns % n]

// --- Neighbor enumeration (all 4 directions, bounds-checked) ---

fn _mz_neighbors(c, w, h)
    let nb = []
    let total = w * h
    if c >= w
        push(nb, c - w)
    if c < total - w
        push(nb, c + w)
    if c % w > 0
        push(nb, c - 1)
    if c % w < w - 1
        push(nb, c + 1)
    return nb

// --- Collect unvisited neighbors of c ---

fn _mz_unvisited_nb(c, w, h, visited)
    let all = _mz_neighbors(c, w, h)
    let out = []
    let i = 0
    let n = len(all)
    while i < n
        if visited[all[i]] == 0
            push(out, all[i])
        i = i + 1
    return out

// --- Collect visited neighbors of c ---

fn _mz_visited_nb(c, w, h, visited)
    let all = _mz_neighbors(c, w, h)
    let out = []
    let i = 0
    let n = len(all)
    while i < n
        if visited[all[i]] == 1
            push(out, all[i])
        i = i + 1
    return out

// --- Hunt: scan for first unvisited cell adjacent to a visited cell.
//     Returns [found, cell, visited_neighbor].
//     found=1 means success; found=0 means all cells are visited.

fn _mz_hunt(total, w, h, visited)
    let c = 0
    while c < total
        if visited[c] == 0
            let vnb = _mz_visited_nb(c, w, h, visited)
            if len(vnb) > 0
                let result = [1, c, vnb[0]]
                return result
        c = c + 1
    return [0, 0, 0]

// --- Main generator using Hunt-and-Kill algorithm ---
// Returns links: a list of w*h lists.  links[c] = passage targets from c.

fn gen(w, h, seed)
    let total = w * h

    // Initialize links: w*h empty lists.
    let links = []
    let i = 0
    while i < total
        let empty = []
        push(links, empty)
        i = i + 1

    // Visited array: 0=unvisited, 1=in-tree.
    let visited = []
    let j = 0
    while j < total
        push(visited, 0)
        j = j + 1

    // Start at cell 0.
    visited[0] = 1
    let current = 0
    let state = seed

    // bound: at most total*total steps to guarantee termination.
    let max_iter = total * total + total
    let iter = 0

    // walking=1 means we are in walk mode; walking=0 means we need to hunt.
    let walking = 1
    let done = 0

    while done == 0 and iter < max_iter
        iter = iter + 1

        if walking == 1
            // Random walk: pick a random unvisited neighbor.
            let unv = _mz_unvisited_nb(current, w, h, visited)
            let nc = len(unv)
            if nc > 0
                // Choose a random unvisited neighbor.
                let rv = _mz_randint(state, nc)
                state = rv[0]
                let pick = rv[1]
                let next = unv[pick]
                // Carve bidirectional passage.
                push(links[current], next)
                push(links[next], current)
                visited[next] = 1
                current = next
            else
                // Stuck — switch to hunt mode.
                walking = 0

        if walking == 0 and done == 0
            // Hunt: find first unvisited cell adjacent to a visited cell.
            let hr = _mz_hunt(total, w, h, visited)
            let found = hr[0]
            if found == 0
                // All cells visited — maze complete.
                done = 1
            if found == 1
                let hcell = hr[1]
                let hvnb = hr[2]
                // Carve from the visited neighbor into hcell.
                push(links[hcell], hvnb)
                push(links[hvnb], hcell)
                visited[hcell] = 1
                current = hcell
                // Resume walk mode.
                walking = 1

    return links
