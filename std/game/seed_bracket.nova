// std/game/seed_bracket.nova — standard single-elimination seeding utilities.
//
// Seeding places the best seeds on opposite halves of the bracket so that
// #1 seed meets the lowest possible seed in the final if everyone wins their
// expected match. Each first-round pair sums to n+1 (1 vs n, 2 vs n-1, etc.)
// but arranged so that halves stay balanced all the way through.
//
// Public API:
//   seed_order(n)    -> list  seeding positions (length n) for a bracket of
//                             size n (n must be a power of 2).
//                             seed_order(2) = [1,2]
//                             seed_order(4) = [1,4,2,3]
//                             seed_order(8) = [1,8,4,5,2,7,3,6]
//
//   seed_matchups(n) -> list  first-round pairings as [[seedA,seedB], ...].
//                             Consecutive pairs from seed_order are matched.
//                             seed_matchups(4) = [[1,4],[2,3]]
//
// LEAF — imports nothing.

// seed_order: build the bracket seeding order for n players (n = power of 2).
// Algorithm: start with [1], then repeatedly expand by mapping each seed s
// to [s, n+1-s] where n is the current bracket size being built.
// After the expansion for bracket size b we have b seeds arranged so that
// every consecutive pair is a first-round match.
fn seed_order(n)
    if n <= 1
        let out = []
        push(out, 1)
        return out
    // Build iteratively: start with bracket of size 2 = [1,2]
    let order = []
    push(order, 1)
    push(order, 2)
    let sz = 2
    while sz < n
        // Next bracket size
        let next_sz = sz * 2
        let complement = next_sz + 1
        // For each existing seed s, append complement-s immediately after s
        let next_order = []
        let i = 0
        while i < sz
            let s = order[i]
            push(next_order, s)
            push(next_order, complement - s)
            i = i + 1
        order = next_order
        sz = next_sz
    return order

// seed_matchups: return first-round matchup pairs for n-player bracket.
// Pairs consecutive entries from seed_order: positions 0,1 → match 1; 2,3 → match 2; etc.
fn seed_matchups(n)
    let order = seed_order(n)
    let total = len(order)
    let out = []
    let i = 0
    while i + 1 < total
        let pair = []
        push(pair, order[i])
        push(pair, order[i + 1])
        push(out, pair)
        i = i + 2
    return out
