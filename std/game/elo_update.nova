// std/game/elo_update.nova — ELO rating update after a game result.
// elo_update(rating, expected, actual, k) = rating + k * (actual - expected)
// elo_pair_update(ra, rb, score_a, k) -> list [new_ra, new_rb]
//   score_a: 1.0 = A wins, 0.5 = draw, 0.0 = A loses.
// Uses elo_expected internally. LEAF — imports nothing.

// elo_expected — probability that player A beats player B (local copy to stay leaf).
fn _eu_expected(ra: float, rb: float) -> float
    let diff = rb - ra
    let scaled = diff / 400.0
    let p = pow(10.0, scaled)
    let denom = 1.0 + p
    let result = 1.0 / denom
    result

// elo_update — new rating for a single player after one game.
//   rating:   current rating (float)
//   expected: expected score for this player (float, from elo_expected)
//   actual:   actual score (1.0 win, 0.5 draw, 0.0 loss)
//   k:        K-factor (float)
// Returns updated rating.
fn elo_update(rating: float, expected: float, actual: float, k: float) -> float
    let delta = actual - expected
    let change = k * delta
    let new_rating = rating + change
    new_rating

// elo_pair_update — update both players after one game.
//   ra, rb:    ratings of player A and B (float)
//   score_a:   score for player A (1.0 win, 0.5 draw, 0.0 loss)
//   k:         K-factor applied to BOTH players (float)
// Returns list [new_ra, new_rb].
// Note: score_b = 1.0 - score_a (zero-sum).
// Total rating is conserved when K is symmetric.
fn elo_pair_update(ra: float, rb: float, score_a: float, k: float) -> list
    let ea = _eu_expected(ra, rb)
    let eb = _eu_expected(rb, ra)
    let score_b = 1.0 - score_a
    let new_ra = elo_update(ra, ea, score_a, k)
    let new_rb = elo_update(rb, eb, score_b, k)
    [new_ra, new_rb]
