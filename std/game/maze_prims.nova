// std/game/maze_prims.nova — Randomized Prim's maze generation.
//
// Grows a spanning tree from a start cell by repeatedly picking a random
// frontier cell and carving a passage to one of its already-visited neighbors.
//
// Grid convention:
//   w x h grid; cell index c = row*w + col.
//   Neighbors: up=c-w, down=c+w, left=c-1, right=c+1 (bounds-checked).
//   links[c] = list of cells c has an open passage to (bidirectional).
//
// Public API:
//   gen(w, h, seed) -> list   (list of w*h lists; the adjacency structure)

// Seeded LCG RNG — returns new state.
fn _mz_rng(state)
    return (state * 1103515245 + 12345) & 0x7FFFFFFF

// Returns [new_state, value in 0..n-1].
fn _mz_randint(state, n)
    let ns = _mz_rng(state)
    return [ns, ns % n]

// Returns list of valid neighbor cell indices for cell c in w x h grid.
fn _mz_neighbors(c, w, h)
    let nb = []
    let total = w * h
    if c >= w
        push(nb, c - w)
    if c < total - w
        push(nb, c + w)
    if c % w > 0
        push(nb, c - 1)
    if c % w < w - 1
        push(nb, c + 1)
    return nb

// Push a value into a logically-sized frontier buffer.
// frontier is the backing list; fsize is the live count.
// Returns new fsize.
fn _mz_fpush(frontier, fsize, val)
    let cap = len(frontier)
    if fsize < cap
        frontier[fsize] = val
    if fsize >= cap
        push(frontier, val)
    return fsize + 1

// Remove element at index idx from frontier[0..fsize-1] via swap-with-last.
// Returns new fsize.
fn _mz_fremove(frontier, fsize, idx)
    let last = fsize - 1
    if idx < last
        frontier[idx] = frontier[last]
    return last

// Randomized Prim's maze generator.
// Returns links: list of w*h lists; links[c] = open passage targets from c.
fn gen(w, h, seed)
    let total = w * h

    // links[c]: list of cells reachable from c by an open passage.
    let links = []
    for li in 0..total
        let cell_links = []
        push(links, cell_links)

    // visited[c]: 1 if c is in the spanning tree, 0 otherwise.
    let visited = [0 for vi in 0..total]
    // Frontier: backing list + logical size fsize.
    let frontier = []
    let fsize = 0

    // Seed the tree at cell 0.
    visited[0] = 1
    let seed_nb = _mz_neighbors(0, w, h)
    let si = 0
    let snb_len = len(seed_nb)
    while si < snb_len
        fsize = _mz_fpush(frontier, fsize, seed_nb[si])
        si += 1

    let state = seed
    let remaining = total - 1
    let guard = 0
    let max_guard = total * total

    while remaining > 0 and guard < max_guard
        guard += 1

        if fsize == 0
            remaining = 0

        if fsize > 0
            // Pick a random cell from frontier[0..fsize-1].
            let r1 = _mz_randint(state, fsize)
            state = r1[0]
            let pick = r1[1]
            let cell = frontier[pick]
            fsize = _mz_fremove(frontier, fsize, pick)

            // Only process if not yet in tree.
            if visited[cell] == 0
                // Collect in-tree neighbors.
                let nb = _mz_neighbors(cell, w, h)
                let nlen = len(nb)
                let vn = []
                for ki in 0..nlen
                    let nbc = nb[ki]
                    if visited[nbc] == 1
                        push(vn, nbc)

                let vnlen = len(vn)
                if vnlen > 0
                    // Connect cell to a random in-tree neighbor.
                    let r2 = _mz_randint(state, vnlen)
                    state = r2[0]
                    let vni = r2[1]
                    let neighbor = vn[vni]
                    push(links[cell], neighbor)
                    push(links[neighbor], cell)
                    visited[cell] = 1
                    remaining -= 1

                    // Enqueue unvisited neighbors of the newly added cell.
                    for mi in 0..nlen
                        let nc = nb[mi]
                        if visited[nc] == 0
                            fsize = _mz_fpush(frontier, fsize, nc)

    return links
