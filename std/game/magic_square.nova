// std/game/magic_square.nova — Magic square construction and verification.
//
// Public API:
//   magic_constant(n)      -> int   the magic sum = n*(n*n+1)/2
//   magic_square(n)        -> list  flat n*n magic square (Siamese / de la Loubere method for odd n)
//   is_magic(square, n)    -> bool  all rows, cols, and both diagonals sum to magic_constant(n)
//
// Siamese method (odd n only):
//   Start at (0, n/2). Place 1..n*n in sequence.
//   Each step move diagonally up-right (row-1 mod n, col+1 mod n).
//   If the destination is already occupied, move down instead (row+1 mod n, same col).
//
// The flat list index convention: idx = row*n + col.

// magic_constant — the target sum for every row/col/diagonal of an n x n magic square.
fn magic_constant(n: int) -> int
    n * (n * n + 1) / 2

// magic_square — build an n x n magic square using the Siamese method.
// n must be odd and >= 1. Returns a flat list of n*n integers.
fn magic_square(n: int) -> list
    let size = n * n
    // initialise flat grid to 0
    let sq = [0 for i in 0..size]
    // starting position: row=0, col=n/2
    let row = 0
    let col = n / 2
    for num in 1..(size + 1)
        let idx = row * n + col
        sq[idx] = num
        // next candidate: up-right diagonal
        let nr = row - 1
        if nr < 0
            nr = n - 1
        let nc = col + 1
        if nc >= n
            nc = 0
        let nidx = nr * n + nc
        // if occupied, move down instead
        if sq[nidx] != 0
            nr = row + 1
            if nr >= n
                nr = 0
            nc = col
        row = nr
        col = nc
    sq

// is_magic — verify all rows, columns, and both diagonals sum to magic_constant(n).
fn is_magic(square: list, n: int) -> bool
    let mc = magic_constant(n)
    // check rows
    for r in 0..n
        if sum([square[r * n + c] for c in 0..n]) != mc
            return false
    // check cols
    for c2 in 0..n
        if sum([square[r2 * n + c2] for r2 in 0..n]) != mc
            return false
    // check main diagonal (top-left to bottom-right)
    if sum([square[d * n + d] for d in 0..n]) != mc
        return false
    // check anti-diagonal (top-right to bottom-left)
    if sum([square[d2 * n + (n - 1 - d2)] for d2 in 0..n]) != mc
        return false
    true
