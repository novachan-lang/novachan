// std/game/maze_solve_bfs.nova — BFS shortest-path maze solver.
//
// Finds a shortest path between two cells in a maze given as an adjacency list.
// Grid convention: links[c] = list of cells reachable from c by an open passage.
//
// Public API:
//   solve_bfs(links, start, end) -> list
//       Returns the shortest path as a list of cell indices [start, ..., end].
//       Returns [] if end is unreachable from start.
//   path_length(links, start, end) -> int
//       Returns the number of steps (edges) in the shortest path, or -1 if unreachable.
//   is_valid_path(links, path) -> bool (1/0)
//       Returns 1 if every consecutive pair in path shares a passage in links, 0 otherwise.

// BFS from start to end in the maze given by links.
// Returns the path [start, ..., end], or [] if unreachable.
fn solve_bfs(links, start, end)
    let n = len(links)
    if n == 0
        return []

    // Base case: start == end
    if start == end
        let res = []
        push(res, start)
        return res

    // parent[i] = cell we came from when visiting i (-1 = not visited).
    // We use n as a sentinel for "unvisited" since cell indices are 0..n-1.
    let parent = [n for i in 0..n]
    // BFS queue with head pointer (avoids O(n^2) front-removal).
    let queue = []
    push(queue, start)
    parent[start] = start

    let head = 0
    let found = 0
    // Each cell enqueued at most once -> at most n iterations.
    let guard = 0
    while head < len(queue) and found == 0 and guard < n
        let cell = queue[head]
        head = head + 1
        guard = guard + 1
        let nbrs = links[cell]
        let j = 0
        let nblen = len(nbrs)
        while j < nblen
            let nb = nbrs[j]
            if parent[nb] == n
                parent[nb] = cell
                if nb == end
                    found = 1
                    j = nblen
                if found == 0
                    push(queue, nb)
            j = j + 1

    if found == 0
        return []

    // Reconstruct path by walking parent pointers from end back to start.
    // Path length <= n, so bound the walk.
    let rev = []
    let cur = end
    let steps = 0
    while steps < n
        push(rev, cur)
        if cur == start
            steps = n
        if cur != start
            cur = parent[cur]
            steps = steps + 1

    // Reverse rev into result.
    let rlen = len(rev)
    let result = []
    let k = rlen - 1
    while k >= 0
        push(result, rev[k])
        k = k - 1

    return result

// Returns the number of steps (edges) in the shortest path, or -1 if unreachable.
fn path_length(links, start, end)
    let p = solve_bfs(links, start, end)
    let plen = len(p)
    if plen == 0
        return -1
    return plen - 1

// Returns 1 if path is non-empty and every consecutive pair shares a passage.
// Returns 0 if path is empty or any consecutive pair is not linked.
fn is_valid_path(links, path)
    let plen = len(path)
    if plen == 0
        return 0
    for i in 0..(plen - 1)
        let a = path[i]
        let b = path[i + 1]
        // Check that b is in links[a].
        let nbrs = links[a]
        let nlen = len(nbrs)
        let found = 0
        let j = 0
        while j < nlen
            if nbrs[j] == b
                found = 1
                j = nlen
            j = j + 1
        if found == 0
            return 0
    return 1
