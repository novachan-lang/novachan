// std/game/swiss_pair.nova — Swiss tournament pairing.
// swiss_pair(players) -> list of [idA, idB] pairs.
// Input: list of [id, score] sorted by score descending (highest first).
// Pairing: adjacent players by score are paired.
// Odd number of players: the last (lowest) player gets a bye [id, -1].
// LEAF — imports nothing.

fn swiss_pair(players: list) -> list
    let pairs = []
    let n = len(players)
    let i = 0
    while i + 1 < n
        let a = players[i]
        let b = players[i + 1]
        let pair = []
        push(pair, a[0])
        push(pair, b[0])
        push(pairs, pair)
        i = i + 2
    if i < n
        let last = players[i]
        let bye = []
        push(bye, last[0])
        push(bye, -1)
        push(pairs, bye)
    pairs
