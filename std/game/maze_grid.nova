// std/game/maze_grid.nova — Shared grid/maze utilities.
// Canonical helpers for NOVA maze modules; other modules INLINE their own copies.
//
// Grid convention: w x h cells. Cell index c = row*w + col.
//   row = c/w, col = c%w.
// Adjacency list: links = list of w*h lists; links[c] = neighbor cells
//   connected to c by an open passage. Passages are bidirectional.
//
// Public API:
//   make_links(w, h)        -> list   w*h empty lists (the adjacency structure)
//   neighbors(c, w, h)      -> list   up to 4 valid neighbor cells (up/down/left/right)
//   carve(links, a, b)              add bidirectional passage between a and b
//   linked(links, a, b)     -> bool  true if b is in links[a]
//   edge_count(links)       -> int   total passages (sum of all adj-list lengths / 2)
//   is_connected(links, w, h)-> bool BFS from cell 0 visits all w*h cells
//   is_perfect_maze(links, w, h)->bool  edge_count==w*h-1 AND connected
//   cell_rc(c, w)           -> list  [row, col] for cell index c
//   rc_cell(r, col, w)      -> int   cell index for (row, col)

// make_links — initialise an empty adjacency-list for a w x h grid.
fn make_links(w: int, h: int) -> list
    let links = []
    let total = w * h
    for i in 0..total
        let adj = []
        push(links, adj)
    links

// neighbors — the (up to 4) valid grid neighbors of cell c in a w x h grid.
// Order: up, down, left, right.
fn neighbors(c: int, w: int, h: int) -> list
    let result = []
    // up
    if c >= w
        push(result, c - w)
    // down
    if c < w * (h - 1)
        push(result, c + w)
    // left
    if c % w > 0
        push(result, c - 1)
    // right
    if c % w < w - 1
        push(result, c + 1)
    result

// carve — open a bidirectional passage between cells a and b.
fn carve(links: list, a: int, b: int)
    push(links[a], b)
    push(links[b], a)

// linked — true if cell b appears in the adjacency list of cell a.
fn linked(links: list, a: int, b: int) -> bool
    let adj = links[a]
    let n = len(adj)
    let i = 0
    let found = false
    while i < n
        if adj[i] == b
            found = true
        i += 1
    found

// edge_count — number of passages (each passage stored twice; divide sum by 2).
fn edge_count(links: list) -> int
    let total = len(links)
    let sum = 0
    for i in 0..total
        sum += len(links[i])
    sum / 2

// is_connected — BFS from cell 0; returns true iff all w*h cells are reachable.
fn is_connected(links: list, w: int, h: int) -> bool
    let total = w * h
    // visited array (0 = unvisited, 1 = visited)
    let visited = [0 for i in 0..total]
    // BFS queue implemented as a list; head pointer advances
    let queue = []
    push(queue, 0)
    visited[0] = 1
    let head = 0
    let count = 1
    // bound: at most total iterations (spanning-tree property)
    let steps = 0
    let max_steps = total * total
    while head < len(queue) and steps < max_steps
        let c = queue[head]
        head += 1
        let adj = links[c]
        let alen = len(adj)
        for j in 0..alen
            let nb = adj[j]
            if visited[nb] == 0
                visited[nb] = 1
                push(queue, nb)
                count += 1
        steps += 1
    count == total

// is_perfect_maze — true iff the maze is a spanning tree (w*h-1 edges, fully connected).
fn is_perfect_maze(links: list, w: int, h: int) -> bool
    let ec = edge_count(links)
    let want = w * h - 1
    if ec != want
        return false
    is_connected(links, w, h)

// cell_rc — convert cell index to [row, col].
fn cell_rc(c: int, w: int) -> list
    let rc = []
    push(rc, c / w)
    push(rc, c % w)
    rc

// rc_cell — convert (row, col) to cell index.
fn rc_cell(r: int, col: int, w: int) -> int
    r * w + col
