// std/game/tictactoe.nova — Tic-tac-toe game logic (3x3 board).
//
// Board: list of 9 ints, indices 0..8 (row-major, 0=empty, 1=X, 2=O).
//   0 | 1 | 2
//   ---------
//   3 | 4 | 5
//   ---------
//   6 | 7 | 8
//
// Public API:
//   ttt_winner(board) -> int    0=none/draw, 1=X wins, 2=O wins
//   ttt_is_draw(board) -> bool  true if board full and no winner
//   ttt_best_move(board, player) -> int  best cell index via minimax (-1 if full)
// LEAF — imports nothing.

// Check the 8 winning lines and return the winner (1 or 2), or 0.
fn ttt_winner(board)
    // rows
    let winner = 0
    // row 0
    let a = board[0]
    if a != 0 and a == board[1] and a == board[2]
        winner = a
    // row 1
    if winner == 0
        let b = board[3]
        if b != 0 and b == board[4] and b == board[5]
            winner = b
    // row 2
    if winner == 0
        let c = board[6]
        if c != 0 and c == board[7] and c == board[8]
            winner = c
    // col 0
    if winner == 0
        let d = board[0]
        if d != 0 and d == board[3] and d == board[6]
            winner = d
    // col 1
    if winner == 0
        let e = board[1]
        if e != 0 and e == board[4] and e == board[7]
            winner = e
    // col 2
    if winner == 0
        let f = board[2]
        if f != 0 and f == board[5] and f == board[8]
            winner = f
    // diag top-left to bottom-right
    if winner == 0
        let g = board[0]
        if g != 0 and g == board[4] and g == board[8]
            winner = g
    // diag top-right to bottom-left
    if winner == 0
        let h = board[2]
        if h != 0 and h == board[4] and h == board[6]
            winner = h
    winner

// ttt_is_draw — true if board is full and there is no winner.
fn ttt_is_draw(board)
    let w = ttt_winner(board)
    if w != 0
        return false
    // check all cells are filled
    let full = 1
    let i = 0
    while i < 9
        if board[i] == 0
            full = 0
            i = 9
        i = i + 1
    full == 1

// Private: opponent player.
fn _ttt_opp(player)
    if player == 1
        return 2
    return 1

// Private: minimax score from the current board state for `player` (maximiser).
// Returns +10 if player wins, -10 if opponent wins, 0 for draw, scaled by depth.
fn _ttt_score(board, player, depth)
    let w = ttt_winner(board)
    if w != 0
        if w == player
            return 10 - depth
        return depth - 10
    // check full
    let full = 1
    let i = 0
    while i < 9
        if board[i] == 0
            full = 0
            i = 9
        i = i + 1
    if full == 1
        return 0
    return 0

// Private: minimax — returns best score for `mover` assuming `player` is the maximiser.
// mover = whose turn it currently is.
fn _ttt_minimax(board, player, mover, depth)
    let w = ttt_winner(board)
    if w != 0
        if w == player
            return 10 - depth
        return depth - 10
    // check draw
    let full = 1
    let k = 0
    while k < 9
        if board[k] == 0
            full = 0
            k = 9
        k = k + 1
    if full == 1
        return 0
    let opp = _ttt_opp(mover)
    let best = 0
    if mover == player
        best = -100
    if mover != player
        best = 100
    for i in 0..9
        if board[i] == 0
            board[i] = mover
            let s = _ttt_minimax(board, player, opp, depth + 1)
            board[i] = 0
            if mover == player
                if s > best
                    best = s
            if mover != player
                if s < best
                    best = s
    best

// ttt_best_move — returns the cell index of the best move for `player` using minimax.
// Returns -1 if no moves are available.
fn ttt_best_move(board, player)
    let opp = _ttt_opp(player)
    let best_score = -100
    let best_idx = -1
    for i in 0..9
        if board[i] == 0
            board[i] = player
            let s = _ttt_minimax(board, player, opp, 1)
            board[i] = 0
            if s > best_score
                best_score = s
                best_idx = i
    best_idx
