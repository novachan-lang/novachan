// std/game/maze_aldous_broder.nova — Aldous-Broder perfect maze generator.
//
// Uses a random walk: start at cell 0, step to a random neighbor;
// whenever the neighbor is unvisited, carve the passage and mark it visited.
// Continue until all cells are visited (or step cap 200000 is hit).
//
// Shared maze convention:
//   Grid w x h; cell index c = row*w + col, for c in 0..w*h-1.
//   links = list of w*h lists; links[c] = neighbor cells with open passages.
//   Passages are bidirectional.
//
// RNG: Xorshift32 — avoids LCG low-bit periodicity that traps small grids.
//
// Public API:
//   gen(w, h, seed) -> list   (links; a perfect maze spanning tree)

// ---- Xorshift32 RNG (deterministic, good small-modulus distribution) ----

fn _mz_rng(state)
    let s = state ^ (state << 13)
    s = s ^ (s >> 17)
    s = s ^ (s << 5)
    return s & 0x7FFFFFFF

fn _mz_randint(state, n)
    let ns = _mz_rng(state)
    return [ns, ns % n]

// ---- neighbor enumeration ----
// Returns a list of valid neighbor cell indices for cell c in a w x h grid.

fn _mz_neighbors(c, w, h)
    let nb = []
    let total = w * h
    // up: c - w, valid if c >= w
    if c >= w
        push(nb, c - w)
    // down: c + w, valid if c + w < total
    if c + w < total
        push(nb, c + w)
    // left: c - 1, valid if c % w > 0
    if c % w > 0
        push(nb, c - 1)
    // right: c + 1, valid if c % w < w - 1
    if c % w < w - 1
        push(nb, c + 1)
    return nb

// ---- Aldous-Broder generator ----
// Returns an adjacency list (list of w*h lists) representing a perfect maze.
// gen(w, h, seed) -> list

fn gen(w, h, seed)
    let total = w * h
    // Build links: list of total empty lists
    let links = []
    for i in 0..total
        let cell_links = []
        push(links, cell_links)
    // visited: 0=unvisited, 1=visited
    let visited = [0 for j in 0..total]
    // Start at cell 0
    let cur = 0
    visited[0] = 1
    let visit_count = 1
    let rng = seed
    let steps = 0
    let cap = 200000
    while visit_count < total and steps < cap
        // Get neighbors of cur
        let nb = _mz_neighbors(cur, w, h)
        let nb_len = len(nb)
        // Pick a random neighbor
        let rr = _mz_randint(rng, nb_len)
        rng = rr[0]
        let idx = rr[1]
        let next = nb[idx]
        // If next is unvisited, carve passage
        if visited[next] == 0
            visited[next] = 1
            visit_count += 1
            push(links[cur], next)
            push(links[next], cur)
        cur = next
        steps += 1
    return links
