// std/game/war.nova — War card game single-card battle logic.
// LEAF — imports NOTHING.
//
// Card convention: a card is a 2-element list [rank, suit].
//   rank: 2..14  (11=J, 12=Q, 13=K, 14=A high)
//   suit: 0..3   (0=clubs, 1=diamonds, 2=hearts, 3=spades)
//
// In War, only rank matters. Suit is irrelevant; ties (equal rank) are "war".
//
// Public API:
//   war_battle(a, b) -> int    1 if a wins, -1 if b wins, 0 if tie (war)
//   war_higher(a, b) -> list   the winning card, or a on tie
//   war_round(hand_a, hand_b) -> int   compare top cards of two hands

// war_battle — compare two cards by rank only.
// Returns 1 if a wins (a rank > b rank), -1 if b wins, 0 on tie.
fn war_battle(a: list, b: list) -> int
    let ra = a[0]
    let rb = b[0]
    let result = 0
    if ra > rb
        result = 1
    else if ra < rb
        result = -1
    result

// war_higher — return the higher-ranked card, or a on tie.
fn war_higher(a: list, b: list) -> list
    let ra = a[0]
    let rb = b[0]
    let winner = b if rb > ra else a
    winner

// war_round — compare the top (first) card of each hand.
// Returns 1 if hand_a's top card wins, -1 if hand_b's, 0 on tie.
fn war_round(hand_a: list, hand_b: list) -> int
    let top_a = hand_a[0]
    let top_b = hand_b[0]
    war_battle(top_a, top_b)
