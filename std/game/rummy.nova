// std/game/rummy.nova — Rummy meld detection utilities.
// LEAF — imports nothing.
//
// Card convention: a card is a 2-element list [rank, suit].
//   rank: 2..14  (11=J, 12=Q, 13=K, 14=A)
//   suit: 0..3   (0=clubs, 1=diamonds, 2=hearts, 3=spades)
//
// A SET  = 3 or more cards of the same rank (different suits).
// A RUN  = 3 or more consecutive ranks, all same suit.
//          Ace is high (Q-K-A) or low (A-2-3 where ace acts as rank 1).
//
// Point values for deadwood: A=1, 2-10=face value, J/Q/K=10.
//
// Public API:
//   is_set(cards)        -> bool   — true iff cards form a valid set
//   is_run(cards)        -> bool   — true iff cards form a valid run
//   find_sets(hand)      -> list   — all sub-groups of 3+ cards with same rank
//   find_runs(hand)      -> list   — all maximal same-suit consecutive runs of length>=3
//   deadwood(hand)       -> int    — point sum of optimally-unmelded cards

// ── internal helpers ──────────────────────────────────────────────────────────

// _ru_rank — extract rank from card.
fn _ru_rank(c: list) -> int
    c[0]

// _ru_suit — extract suit from card.
fn _ru_suit(c: list) -> int
    c[1]

// _ru_card_value — point value of a card for deadwood scoring.
// Ace=1, 2-10=rank, J/Q/K=10.
fn _ru_card_value(c: list) -> int
    let r = c[0]
    let v = r
    if r == 14
        v = 1
    if r == 11
        v = 10
    if r == 12
        v = 10
    if r == 13
        v = 10
    v

// _ru_sort_ranks — insertion-sort a list of integers ascending (arbitrary length).
// Returns a NEW sorted list (does not mutate input).
fn _ru_sort_ranks(xs: list) -> list
    let n = len(xs)
    let a = []
    let k = 0
    while k < n
        push(a, xs[k])
        k += 1
    // insertion sort
    for i in 1..n
        let key = a[i]
        let j = i - 1
        while j >= 0 and a[j] > key
            a[j+1] = a[j]
            j -= 1
        a[j+1] = key
    a

// _ru_all_same_rank — true iff every card in list has the same rank as the first.
fn _ru_all_same_rank(cards: list) -> bool
    let n = len(cards)
    if n == 0
        return true
    let r0 = cards[0]
    let rank = r0[0]
    let ok = true
    for i in 1..n
        let c = cards[i]
        if c[0] != rank
            ok = false
    ok

// _ru_all_same_suit — true iff every card has the same suit as the first.
fn _ru_all_same_suit(cards: list) -> bool
    let n = len(cards)
    if n == 0
        return true
    let c0 = cards[0]
    let suit = c0[1]
    let ok = true
    for i in 1..n
        let c = cards[i]
        if c[1] != suit
            ok = false
    ok

// _ru_ranks_consecutive — true iff the given list of ranks (already sorted ascending)
// forms a consecutive sequence (no gaps, no duplicates).
fn _ru_ranks_consecutive(sorted: list) -> bool
    let n = len(sorted)
    if n < 2
        return true
    let ok = true
    let i = 1
    while i < n
        if sorted[i] != sorted[i-1] + 1
            ok = false
        i += 1
    ok

// ── Public API ────────────────────────────────────────────────────────────────

// is_set — true iff cards is a valid set: 3+ cards, all same rank.
fn is_set(cards: list) -> bool
    let n = len(cards)
    if n < 3
        return false
    _ru_all_same_rank(cards)

// is_run — true iff cards is a valid run: 3+ cards, same suit, consecutive ranks.
// Ace can be high (ranks Q-K-A, i.e. 12-13-14) or low (A-2-3, ace treated as rank 1).
fn is_run(cards: list) -> bool
    let n = len(cards)
    if n < 3
        return false
    if not _ru_all_same_suit(cards)
        return false
    // Collect ranks
    let ranks = []
    for i in 0..n
        let c = cards[i]
        push(ranks, c[0])
    let sorted = _ru_sort_ranks(ranks)
    // Check normal consecutive (handles A high: K=13, A=14)
    if _ru_ranks_consecutive(sorted)
        return true
    // Check ace-low: ace (14) acts as 1.
    // This is valid iff the sorted list is [2,3,...,k,14] where 2..k are consecutive
    // starting from 2 and k = n (since ace counts as 1 below 2).
    // e.g. n=3: sorted=[2,3,14] -> low-ace run A-2-3
    // e.g. n=4: sorted=[2,3,4,14] -> A-2-3-4
    let last = sorted[n-1]
    if last == 14
        // Check that sorted[0..n-2] = [2,3,...,n]
        let low_ok = true
        for j in 0..(n - 1)
            if sorted[j] != j + 2
                low_ok = false
        if low_ok
            return true
    false

// find_sets — scan the hand and collect every group of 3+ cards sharing a rank.
// Returns a list of groups (each group is a list of cards).
// Each distinct rank that appears 3+ times contributes ONE group containing all cards of that rank.
fn find_sets(hand: list) -> list
    let n = len(hand)
    // Group cards by rank using a dict: rank_str -> list-of-cards
    // NOVA dict keys must be strings.
    let groups = {}
    for i in 0..n
        let c = hand[i]
        let r = c[0]
        let k = str(r)
        if k not in groups
            let empty = []
            groups[k] = empty
        push(groups[k], c)
    // Collect all groups with 3+ cards
    let result = []
    let ks = keys(groups)
    for j in 0..len(ks)
        let grp = groups[ks[j]]
        if len(grp) >= 3
            push(result, grp)
    result

// _ru_suit_cards — collect all cards from hand with the given suit, sorted by rank ascending.
fn _ru_suit_cards(hand: list, suit: int) -> list
    let n = len(hand)
    let same = []
    for i in 0..n
        let c = hand[i]
        if c[1] == suit
            push(same, c)
    // Sort by rank (insertion sort on the card list)
    let m = len(same)
    for ii in 1..m
        let key_card = same[ii]
        let key_rank = key_card[0]
        let jj = ii - 1
        while jj >= 0 and same[jj][0] > key_rank
            same[jj+1] = same[jj]
            jj -= 1
        same[jj+1] = key_card
    same

// _ru_extract_run — given sorted same-suit cards starting at index start,
// extend as far as ranks are consecutive (no duplicates). Returns ending index (exclusive).
fn _ru_extract_run(sorted_cards: list, start: int) -> int
    let n = len(sorted_cards)
    let i = start + 1
    while i < n
        let prev = sorted_cards[i-1]
        let curr = sorted_cards[i]
        if curr[0] != prev[0] + 1
            return i
        i += 1
    n

// find_runs — find all maximal same-suit consecutive runs of length >= 3.
// Returns a list of runs (each run is a list of cards).
// Ace is handled as both high (K-A at ranks 13-14) and low (A-2-3 where ace wraps).
// Within each suit we sort by rank, then scan for maximal consecutive sequences.
// Low-ace: after normal scan, if the suit has an Ace (rank 14) AND the run starting
// at rank 2 has length >= 2, we also yield the ace-low run [A,2,...,k] if k-2+2 >= 3.
fn find_runs(hand: list) -> list
    let result = []
    // Process each suit 0..3
    let suit = 0
    while suit <= 3
        let sc = _ru_suit_cards(hand, suit)
        let m = len(sc)
        // Normal consecutive-rank scan (ace=14 is high here)
        let i = 0
        while i < m
            let end_idx = _ru_extract_run(sc, i)
            let run_len = end_idx - i
            if run_len >= 3
                // Build the run sublist
                let run = []
                let k = i
                while k < end_idx
                    push(run, sc[k])
                    k += 1
                push(result, run)
            i = end_idx
        // Low-ace: if suit has an Ace AND rank 2 is present, build A-2-... run
        // Find ace and find how many consecutive ranks start from 2
        let has_ace = false
        let ace_card_idx = -1
        for jj in 0..m
            if sc[jj][0] == 14
                has_ace = true
                ace_card_idx = jj
        if has_ace
            // Find the run starting at rank 2 among the sorted cards
            let low_start = -1
            for kk in 0..m
                if sc[kk][0] == 2
                    low_start = kk
            if low_start >= 0
                // Extend from rank 2 upward as far as consecutive
                let low_end = _ru_extract_run(sc, low_start)
                let low_len = low_end - low_start
                // The ace-low run would be: [ace, 2, 3, ..., (2+low_len-1)]
                // Length = low_len + 1 (ace + the consecutive run from 2)
                let total_len = low_len + 1
                if total_len >= 3
                    let run_low = []
                    // Put ace first
                    push(run_low, sc[ace_card_idx])
                    // Then rank-2-and-up cards
                    let ll = low_start
                    while ll < low_end
                        push(run_low, sc[ll])
                        ll += 1
                    push(result, run_low)
        suit += 1
    result

// ── deadwood ──────────────────────────────────────────────────────────────────
// deadwood — compute the minimum point total for cards NOT covered by any meld.
// Strategy: greedily assign cards to melds (sets first, then runs), minimizing unmelded sum.
// Cards used in a meld are tracked by position in hand. Any card not in any meld contributes
// its point value.
// Point values: A=1, 2-10=rank, J/Q/K=10.
//
// Greedy algorithm:
//   1. Find all valid sets (rank groups >= 3).
//   2. Find all valid runs (maximal same-suit consecutive sequences >= 3).
//   3. Mark cards used by melds (by index in hand).
//   4. Sum point values of unmarked cards.

// _ru_find_card_idx — find the index of card c in hand starting from offset.
// Returns -1 if not found. Matches by rank AND suit.
fn _ru_find_card_idx(hand: list, c: list, offset: int) -> int
    let n = len(hand)
    let i = offset
    let found = -1
    while i < n
        let h = hand[i]
        if h[0] == c[0] and h[1] == c[1] and found == -1
            found = i
        i += 1
    found

// deadwood — sum of optimally-unmelded card values.
fn deadwood(hand: list) -> int
    let n = len(hand)
    if n == 0
        return 0
    // used[i] = 1 if card i is in a meld, 0 otherwise
    let used = [0 for ii in 0..n]
    // Find sets
    let sets = find_sets(hand)
    for si in 0..len(sets)
        let grp = sets[si]
        let gi = 0
        while gi < len(grp)
            let c = grp[gi]
            // Find this card in hand and mark it used
            let idx = _ru_find_card_idx(hand, c, 0)
            if idx >= 0
                used[idx] = 1
            gi += 1
    // Find runs
    let runs = find_runs(hand)
    for ri in 0..len(runs)
        let run = runs[ri]
        let rci = 0
        while rci < len(run)
            let c = run[rci]
            let idx = _ru_find_card_idx(hand, c, 0)
            if idx >= 0
                used[idx] = 1
            rci += 1
    // Sum point values of unused cards
    let total = 0
    for i in 0..n
        if used[i] == 0
            let c = hand[i]
            total += _ru_card_value(c)
    total
