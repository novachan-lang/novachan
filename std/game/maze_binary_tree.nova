// std/game/maze_binary_tree.nova — Binary-tree perfect maze generator.
//
// For each cell in row-major order, randomly carve either north (up) or east
// (right), choosing only among the directions that actually exist.
// Cells on the north row can only carve east; cells on the east column can
// only carve north; the top-right corner cell (0, w-1) has no neighbors to
// carve and is left alone.  The result is a spanning tree (perfect maze).
//
// Shared maze convention:
//   Grid w x h; cell index c = row*w + col, for c in 0..w*h-1.
//   links = list of w*h lists; links[c] = neighbor cells with open passages.
//   Passages are bidirectional.
//
// Public API:
//   gen(w, h, seed) -> list   (links; a perfect maze spanning tree)

// ---- seeded LCG RNG (deterministic) ----

fn _mz_rng(state)
    return (state * 1103515245 + 12345) & 0x7FFFFFFF

fn _mz_randint(state, n)
    let ns = _mz_rng(state)
    return [ns, ns % n]

// ---- Binary-tree maze generator ----
// Returns links: a list of w*h lists.  links[c] = open passage targets from c.
//
// Algorithm: iterate every cell c in row-major order.
//   - Candidate directions: north (c-w) if c >= w; east (c+1) if c%w < w-1.
//   - If both exist, pick one at random (RNG).
//   - If only one exists, pick it.
//   - If neither exists (top-right corner), skip.
//   Carve bidirectional passage for the chosen direction.

fn gen(w, h, seed)
    let total = w * h

    // Initialize links as total empty lists.
    let links = []
    let i = 0
    while i < total
        let cell_links = []
        push(links, cell_links)
        i = i + 1

    let state = seed
    let c = 0
    while c < total
        // Determine available candidates: north and/or east.
        let has_north = 0
        let has_east = 0
        if c >= w
            has_north = 1
        if c % w < w - 1
            has_east = 1

        if has_north == 1 and has_east == 1
            // Both available — pick randomly.
            let rr = _mz_randint(state, 2)
            state = rr[0]
            let choice = rr[1]
            if choice == 0
                // Carve north
                let nb = c - w
                push(links[c], nb)
                push(links[nb], c)
            if choice == 1
                // Carve east
                let nb = c + 1
                push(links[c], nb)
                push(links[nb], c)
        if has_north == 1 and has_east == 0
            // Only north available.
            let nb = c - w
            push(links[c], nb)
            push(links[nb], c)
        if has_north == 0 and has_east == 1
            // Only east available.
            let nb = c + 1
            push(links[c], nb)
            push(links[nb], c)
        // has_north==0 and has_east==0: top-right corner; nothing to carve.

        c = c + 1

    return links
