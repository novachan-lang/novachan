// std/hash/fnv64.nova — FNV-1 and FNV-1a 64-bit hashes (Fowler-Noll-Vo).
//
// The 32-bit variants (fnv1a32) live in std/hash/noncrypto; this module
// provides the 64-bit family which has different constants and a much
// larger output range (2^64 values vs 2^32).
//
// Specification: https://datatracker.ietf.org/doc/html/draft-eastlake-fnv
//
// Constants:
//   offset_basis = 0xCBF29CE484222325  (built as two 32-bit halves)
//   prime        = 0x100000001B3        (= 1099511628211, fits positive i64)
//
// Algorithms (per byte c):
//   FNV-1:   h = h * prime;  h = h XOR c
//   FNV-1a:  h = h XOR c;    h = h * prime
// The multiplication wraps mod 2^64 — NOVA i64 * does exactly this.
//
// Return type: i64 (signed 64-bit).  The output is the same bit pattern as the
// corresponding unsigned u64 value.  For hex display use the supplied _fnv64_hex
// helper; str() on a negative i64 prints a negative decimal.
//
// Public API:
//   h_fnv1a64(s: str) -> int    FNV-1a 64-bit hash of string s
//   h_fnv1_64(s: str) -> int    FNV-1  64-bit hash of string s
//
// KAT vectors (verified against the FNV reference implementation):
//   h_fnv1a64("")       = 0xCBF29CE484222325  (= -3750763034362895579 as i64)
//   h_fnv1a64("a")      = 0xAF63DC4C8601EC8C  (= -5808556873153909620 as i64)
//   h_fnv1a64("foobar") = 0x85944171F73967E8  (= -8821353812377114648 as i64)
//   h_fnv1_64("a")      != h_fnv1a64("a")     (different byte-order of xor vs multiply)
//
// NOVA 64-bit arithmetic notes:
//   * >> is ARITHMETIC (sign-extending). Use _shr64() for logical right-shift.
//   * i64 * wraps mod 2^64 — no masking needed after multiply.
//   * Hex literals >= 2^63 are rejected by the compiler; build as (hi<<32)|lo.
//   * XOR ^ and | on large negative i64 work correctly at the bit level.

// ---------------------------------------------------------------------------
// Internal: logical right-shift for 64-bit values.
// NOVA >> is arithmetic (sign-extends). For a value that may have bit 63 set
// we must mask out the sign-extension bits.
// ---------------------------------------------------------------------------
fn _shr64(x, n)
    let mask = (1 << (64 - n)) - 1
    return (x >> n) & mask

// ---------------------------------------------------------------------------
// Internal: return the FNV-1a 64-bit offset basis constant.
// 0xCBF29CE484222325 — bit 63 is set so we can't write it as a literal.
// ---------------------------------------------------------------------------
fn _fnv64_basis()
    return (0xCBF29CE4 << 32) | 0x84222325

// ---------------------------------------------------------------------------
// Internal: return the FNV-64 prime.
// 0x100000001B3 = 1099511628211 — fits in a positive i64.
// ---------------------------------------------------------------------------
fn _fnv64_prime()
    return (0x100 << 32) | 0x1B3

// ---------------------------------------------------------------------------
// FNV-1a 64-bit hash of string s.
// Algorithm: h = offset_basis; for each byte c: h = (h XOR c) * prime
// The multiplication wraps mod 2^64 naturally in NOVA i64 arithmetic.
// ---------------------------------------------------------------------------
fn h_fnv1a64(s)
    let h = _fnv64_basis()
    let prime = _fnv64_prime()
    let b = str_to_bytes(s)
    let n = bytes_len(b)
    for i in 0..n
        let c = bytes_get(b, i)
        h = (h ^ c) * prime
    return h

// ---------------------------------------------------------------------------
// FNV-1 64-bit hash of string s.
// Algorithm: h = offset_basis; for each byte c: h = h * prime; h = h XOR c
// Note the byte ordering: multiply FIRST, then XOR (contrast with FNV-1a).
// ---------------------------------------------------------------------------
fn h_fnv1_64(s)
    let h = _fnv64_basis()
    let prime = _fnv64_prime()
    let b = str_to_bytes(s)
    let n = bytes_len(b)
    for i in 0..n
        let c = bytes_get(b, i)
        h = h * prime
        h = h ^ c
    return h

// ---------------------------------------------------------------------------
// Utility: convert a 64-bit hash (signed i64) to a 16-character uppercase
// hex string for display.  Use this when str() would show a negative decimal.
// ---------------------------------------------------------------------------
fn fnv64_hex(h)
    let digits = "0123456789ABCDEF"
    let result_parts = []
    let shift = 60
    while shift >= 0
        let nibble = _shr64(h, shift) & 0xF
        push(result_parts, char_at(digits, nibble))
        shift = shift - 4
    let result = join(result_parts, "")
    return result
