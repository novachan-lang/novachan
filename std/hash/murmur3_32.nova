// std/hash/murmur3_32.nova — MurmurHash3 x86 32-bit (Austin Appleby, SMHasher).
//
// Spec: https://github.com/aappleby/smhasher/blob/master/src/MurmurHash3.cpp
//       MurmurHash3_x86_32
//
// Algorithm overview:
//   c1 = 0xCC9E2D51, c2 = 0x1B873593
//   1. Process 4-byte blocks (little-endian):
//        k = block; k *= c1; k = rotl32(k,15); k *= c2
//        h ^= k; h = rotl32(h,13); h = h*5 + 0xE6546B64
//   2. Tail (remaining 1-3 bytes, little-endian partial word):
//        k = tail bytes; k *= c1; k = rotl32(k,15); k *= c2; h ^= k
//   3. Finalize:
//        h ^= length; fmix32(h)
//   fmix32: h^=h>>16; h*=0x85EBCA6B; h^=h>>13; h*=0xC2B2AE35; h^=h>>16
//
// All intermediate values are kept masked to 32 bits (&0xFFFFFFFF) so that
// plain >> is a safe logical right-shift (top 32 bits are always zero).
//
// Public API:
//   h_murmur3_32(b: bytes, seed: int) -> int
//
// KAT vectors (SMHasher canonical):
//   h_murmur3_32(bytes(0), 0)                     == 0x00000000
//   h_murmur3_32(bytes(0), 1)                     == 0x514E28B7
//   h_murmur3_32(str_to_bytes("test"), 0)          == 0xBA6BD213
//   h_murmur3_32(str_to_bytes("Hello, world!"), 0) == 0xC0363E43

// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------

// Mask value to the low 32 bits.
fn _m32(x)
    return x & 0xFFFFFFFF

// Rotate x left by r bits (32-bit).
// x must already be masked to 32 bits.
fn _rotl32(x, r)
    let rr = r & 31
    return ((x << rr) | (x >> (32 - rr))) & 0xFFFFFFFF

// fmix32: the finalization mix from MurmurHash3.
// Ensures every bit of h affects every other bit (avalanche).
fn _fmix32(h)
    h = (h ^ (h >> 16)) & 0xFFFFFFFF
    h = (h * 0x85EBCA6B) & 0xFFFFFFFF
    h = (h ^ (h >> 13)) & 0xFFFFFFFF
    h = (h * 0xC2B2AE35) & 0xFFFFFFFF
    h = (h ^ (h >> 16)) & 0xFFFFFFFF
    return h

// ---------------------------------------------------------------------------
// h_murmur3_32 — MurmurHash3 x86 32-bit hash of bytes b with given seed.
// Returns a 32-bit unsigned integer in [0, 2^32).
// ---------------------------------------------------------------------------
fn h_murmur3_32(b, seed)
    let c1 = 0xCC9E2D51
    let c2 = 0x1B873593
    let n = bytes_len(b)
    let h = _m32(seed)

    // Number of complete 4-byte blocks
    let nblocks = n / 4

    // --- Body: process 4-byte blocks ---
    let bi = 0
    while bi < nblocks
        let off = bi * 4
        // Read 4 bytes little-endian (byte 0 = least significant)
        let b0 = bytes_get(b, off)
        let b1 = bytes_get(b, off + 1)
        let b2 = bytes_get(b, off + 2)
        let b3 = bytes_get(b, off + 3)
        let k = _m32(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))

        k = (k * c1) & 0xFFFFFFFF
        k = _rotl32(k, 15)
        k = (k * c2) & 0xFFFFFFFF

        h = h ^ k
        h = _rotl32(h, 13)
        h = ((h * 5) + 0xE6546B64) & 0xFFFFFFFF

        bi = bi + 1

    // --- Tail: remaining 1-3 bytes ---
    let tail_start = nblocks * 4
    let tail_len = n - tail_start
    let k2 = 0

    if tail_len == 3
        k2 = k2 ^ (bytes_get(b, tail_start + 2) << 16)
    if tail_len >= 2
        k2 = k2 ^ (bytes_get(b, tail_start + 1) << 8)
    if tail_len >= 1
        k2 = k2 ^ bytes_get(b, tail_start)
        k2 = (k2 * c1) & 0xFFFFFFFF
        k2 = _rotl32(k2, 15)
        k2 = (k2 * c2) & 0xFFFFFFFF
        h = h ^ k2

    // --- Finalization ---
    h = (h ^ n) & 0xFFFFFFFF
    h = _fmix32(h)
    return h
