// std/hash/fletcher.nova — Fletcher checksums (non-cryptographic, error-detection).
//
// Fletcher-16 processes individual bytes mod 255 and returns a 16-bit result.
// Fletcher-32 processes byte pairs (16-bit words) mod 65535 and returns a 32-bit result.
//
// NOVA GOTCHAS embedded here:
//   • >> is ARITHMETIC; since accumulators are always < 65535 / < 255 the top bits are
//     already zero, but we still mask shifts for safety.
//   • No 'then' keyword; all if-bodies in their own block.
//   • Integer division: '/' between two ints is INTEGER division ('%' is modulo).
//   • Unused local var = compile error — every let is used.
//   • {} in string literals interpolates — not used here.
//
// Provided functions:
//   h_fletcher16(s) -> int   Fletcher-16 (two 8-bit accumulators mod 255)
//   h_fletcher32(s) -> int   Fletcher-32 (two 16-bit accumulators mod 65535, byte-pair words)
//
// KAT vectors (PUBLISHED / hand-verified):
//   h_fletcher16("")         = 0       (0x0000)
//   h_fletcher16("abcde")   = 51440   (0xC8F0)
//   h_fletcher16("abcdef")  = 8279    (0x2057)
//   h_fletcher16("abcdefgh")= 1575    (0x0627)
//
//   h_fletcher32("")         = 0
//   h_fletcher32("ab")       = 1650549345   (0x62616261)
//   h_fletcher32("abcde")   = 4031760169   (0xF04FC729)
//   h_fletcher32("abcdef")  = 1448095018   (0x56502D2A)
//   h_fletcher32("abcdefgh")= 3957429649   (0xEBE19591)
//
// Hand-trace for "abc" (Fletcher-16):
//   start: s1=0  s2=0
//   byte 97 ('a'): s1=(0+97)%255=97    s2=(0+97)%255=97
//   byte 98 ('b'): s1=(97+98)%255=195  s2=(97+195)%255=37
//   byte 99 ('c'): s1=(195+99)%255=39  s2=(37+39)%255=76
//   result = (76<<8)|39 = 19495 (0x4C27)
//
// Hand-trace for "ab" (Fletcher-32):
//   one word: b0=97('a'), b1=98('b'), word=97+98*256=25185
//   s1=(0+25185)%65535=25185  s2=(0+25185)%65535=25185
//   result = (25185<<16)|25185 = 1650549345 (0x62616261)

// ---------------------------------------------------------------------------
// Fletcher-16
// ---------------------------------------------------------------------------

// Fletcher-16 checksum of string s.
// Two 8-bit running sums s1, s2 both kept mod 255.
// For each byte b: s1 = (s1 + b) % 255; s2 = (s2 + s1) % 255.
// Result: (s2 << 8) | s1  — a 16-bit value in range 0..65534.
// Note: mod 255 (not 256) is the defining property of Fletcher-16.
fn h_fletcher16(s) -> int
    let s1 = 0
    let s2 = 0
    let n = len(s)
    let i = 0
    while i < n
        let b = ord(char_at(s, i))
        s1 = (s1 + b) % 255
        s2 = (s2 + s1) % 255
        i = i + 1
    (s2 << 8) | s1

// ---------------------------------------------------------------------------
// Fletcher-32
// ---------------------------------------------------------------------------

// Fletcher-32 checksum of string s.
// Bytes are processed in pairs as little-endian 16-bit words (word = b0 + b1*256).
// If s has an odd number of bytes the last byte is padded with a zero high byte.
// Two 16-bit running sums s1, s2 both kept mod 65535.
// For each word w: s1 = (s1 + w) % 65535; s2 = (s2 + s1) % 65535.
// Result: (s2 << 16) | s1  — a 32-bit value in range 0..4294836224.
// Note: mod 65535 (not 65536) is the defining property of Fletcher-32.
fn h_fletcher32(s) -> int
    let s1 = 0
    let s2 = 0
    let n = len(s)
    let i = 0
    while i < n
        let b0 = ord(char_at(s, i))
        let b1 = 0
        if (i + 1) < n
            b1 = ord(char_at(s, i + 1))
        let word = b0 + b1 * 256
        s1 = (s1 + word) % 65535
        s2 = (s2 + s1) % 65535
        i = i + 2
    (s2 << 16) | s1
