// std/hash/crc8.nova — CRC-8 variants (8-bit, byte-at-a-time).
//
// Three public functions:
//   h_crc8_smbus(b)           — CRC-8/SMBUS  (poly 0x07, init 0x00, non-reflected)
//   h_crc8_maxim(b)           — CRC-8/MAXIM  (Dallas/1-Wire; poly 0x31 reflected,
//                                              init 0x00; reflected poly = 0x8C)
//   h_crc8_generic(b, poly, init) — generic non-reflected CRC-8 with caller-supplied
//                                   polynomial and initial value
//
// All functions accept a NOVA bytes value and return an int in [0, 255].
//
// NOVA GOTCHAS in this file:
//   • '>>' is ARITHMETIC (sign-extending). All CRC values here are in [0,255]
//     and the masks keep everything non-negative, so >> 1 is a logical shift.
//   • No multi-line list literals. Tables built with push().
//   • 'and' / 'or' — not '&&' / '||'.
//   • No single-line 'if'; body always on the next line.
//   • Unused local variables are a compile error.
//   • Private helpers carry the '_crc8_' prefix to avoid link collisions.
//
// Algorithm — non-reflected CRC-8 (SMBus):
//   crc = init
//   for each byte b:
//       crc ^= b
//       for 8 iterations:
//           if bit 7 set: crc = ((crc << 1) ^ poly) & 0xFF
//           else:         crc = (crc << 1) & 0xFF
//   return crc
//
// Algorithm — reflected CRC-8 (Maxim/1-Wire):
//   Use the bit-reversed polynomial so we can process LSB-first without
//   explicitly reversing each byte.  Reflected poly of 0x31 = 0x8C.
//   crc = 0x00
//   for each byte b:
//       crc ^= b
//       for 8 iterations:
//           if bit 0 set: crc = ((crc >> 1) ^ 0x8C) & 0xFF
//           else:         crc = (crc >> 1) & 0xFF
//   return crc
//
// Published KAT vectors:
//   h_crc8_smbus(str_to_bytes("123456789")) == 0xF4 (244)
//   h_crc8_maxim(str_to_bytes("123456789")) == 0xA1 (161)
//   h_crc8_smbus(bytes(0))                  == 0x00
//   h_crc8_maxim(bytes(0))                  == 0x00

// _crc8_make_table_smbus — build the 256-entry lookup table for non-reflected
// CRC-8 with the given polynomial (MSB-first Galois LFSR).
fn _crc8_make_table_smbus(poly: int) -> list
    let t = []
    for i in 0..256
        let c = i
        for j in 0..8
            let msb = (c >> 7) & 1
            c = (c << 1) & 0xFF
            if msb == 1
                c = c ^ poly
        t.push(c)
    t

// _crc8_make_table_reflected — build the 256-entry lookup table for a
// reflected (LSB-first) CRC-8 with the given reflected polynomial.
fn _crc8_make_table_reflected(rpoly: int) -> list
    let t = []
    for i in 0..256
        let c = i
        for j in 0..8
            let lsb = c & 1
            c = (c >> 1) & 0x7F
            if lsb == 1
                c = c ^ rpoly
        t.push(c)
    t

// h_crc8_smbus — CRC-8/SMBUS checksum of bytes value b.
// Polynomial: 0x07 (non-reflected / MSB-first). Init: 0x00. No final XOR.
// Returns int in [0, 255].
fn h_crc8_smbus(b: any) -> int
    let t = _crc8_make_table_smbus(0x07)
    let crc = 0x00
    let n = bytes_len(b)
    for i in 0..n
        let byte = bytes_get(b, i)
        let idx = (crc ^ byte) & 0xFF
        crc = t[idx]
    crc & 0xFF

// h_crc8_maxim — CRC-8/MAXIM (Dallas/1-Wire) checksum of bytes value b.
// Polynomial: 0x31 (reflected form 0x8C). Init: 0x00. No final XOR.
// Returns int in [0, 255].
fn h_crc8_maxim(b: any) -> int
    let t = _crc8_make_table_reflected(0x8C)
    let crc = 0x00
    let n = bytes_len(b)
    for i in 0..n
        let byte = bytes_get(b, i)
        let idx = (crc ^ byte) & 0xFF
        crc = t[idx]
    crc & 0xFF

// h_crc8_generic — non-reflected CRC-8 with caller-supplied polynomial and
// initial value.  Useful for CRC-8/ITU (poly=0x07, init=0x00, finalXOR=0x55),
// CRC-8/ROHC (poly=0x07, init=0xFF), etc.
// poly and init must be in [0, 255].  Returns int in [0, 255].
fn h_crc8_generic(b: any, poly: int, init: int) -> int
    let t = _crc8_make_table_smbus(poly & 0xFF)
    let crc = init & 0xFF
    let n = bytes_len(b)
    for i in 0..n
        let byte = bytes_get(b, i)
        let idx = (crc ^ byte) & 0xFF
        crc = t[idx]
    crc & 0xFF
