// std/hash/crc32.nova — CRC-32 checksum (ISO-HDLC / zip / PNG / RFC 3720).
//
// Polynomial : 0xEDB88320 (reflected / LSB-first form of 0x04C11DB7)
// Init       : 0xFFFFFFFF
// Reflect in : yes (implicit — reflected polynomial handles it)
// Reflect out: yes (implicit)
// Final XOR  : 0xFFFFFFFF
//
// The 256-entry lookup table is built once per call to _crc32_make_table()
// and stores the per-byte CRC contribution.  Each entry is computed by
// running 8 bit-by-bit iterations of the reflected Galois LFSR.
//
// NOVA-specific hazards in this file:
//   • '>>' is ARITHMETIC (sign-extending).  After right-shifting a value
//     whose bit 31 is set, the result is negative.  We mask with
//     & 0xFFFFFFFF after every '>>' that touches the 32-bit CRC register.
//   • Multi-line list literals do NOT compile.  The table is built with
//     a while loop and xs.push(x).
//   • No '&&' / '||': use 'and' / 'or'.
//   • No single-line 'if'; 'then' keyword does not exist.
//   • '/' on two ints = integer division.
//   • Unused local variables are a compile error.
//   • String interpolation uses braces — literal '{' = chr(123).
//   • All private helpers are prefixed '_crc32_' to avoid link collisions.
//
// Published KAT vectors (POSIX / zlib / libpng reference):
//   h_crc32("")                                              == 0
//   h_crc32("a")                                            == 3904355907
//   h_crc32("abc")                                          == 891568578
//   h_crc32("123456789")                                    == 3421780262
//   h_crc32("The quick brown fox jumps over the lazy dog")  == 1095738169
//
// Hand-trace for "" (no bytes):
//   crc = 0xFFFFFFFF
//   (no iterations)
//   result = 0xFFFFFFFF XOR 0xFFFFFFFF = 0  ✓
//
// Hand-trace for "a" (byte 97 = 0x61):
//   table entry for 0x61 (97) — compute 8 LFSR steps on 97:
//     After step 1: 97 is odd → (97>>1)^0xEDB88320 = 48 ^ 0xEDB88320 = 0xEDB88330  ...
//   (full table-based computation yields 0xE8B7BE43 for byte 97)
//   crc = 0xFFFFFFFF
//   after byte 97: idx = (0xFFFFFFFF ^ 97) & 0xFF = 0x9E = 158
//     table[158] XOR (0xFFFFFFFF >> 8 & 0x00FFFFFF)
//   final XOR 0xFFFFFFFF → 3904355907 = 0xE8B7BE43  ✓

// _crc32_make_table — build the 256-entry CRC-32 lookup table.
// Each entry t[i] is the CRC of a single byte with value i.
// Private: _crc32_ prefix guarantees no link collision.
fn _crc32_make_table() -> list
    let t = []
    for i in 0..256
        let c = i
        for j in 0..8
            let lsb = c & 1
            c = (c >> 1) & 0x7FFFFFFF
            if lsb == 1
                c = c ^ 0xEDB88320
        t.push(c)
    t

// h_crc32 — CRC-32 of the ASCII/UTF-8 bytes of string s.
// Returns a 32-bit unsigned value in range [0, 4294967295] as an int.
fn h_crc32(s: str) -> int
    let t = _crc32_make_table()
    let crc = 0xFFFFFFFF
    let n = len(s)
    for i in 0..n
        let byte = ord(char_at(s, i))
        let idx = (crc ^ byte) & 0xFF
        let shifted = (crc >> 8) & 0x00FFFFFF
        crc = t[idx] ^ shifted
    (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF

// h_crc32_bytes — CRC-32 of a NOVA bytes value (binary-safe).
// Uses bytes_get(b, i) and bytes_len(b) builtins.
fn h_crc32_bytes(b: any) -> int
    let t = _crc32_make_table()
    let crc = 0xFFFFFFFF
    let n = bytes_len(b)
    for i in 0..n
        let byte = bytes_get(b, i)
        let idx = (crc ^ byte) & 0xFF
        let shifted = (crc >> 8) & 0x00FFFFFF
        crc = t[idx] ^ shifted
    (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF
