// std/hash/adler32.nova — Adler-32 checksum (RFC 1950 / zlib).
//
// Algorithm (from RFC 1950 section 8.2):
//   MOD_ADLER = 65521  (largest prime smaller than 2^16)
//   a = 1, b = 0
//   for each byte v in input:
//       a = (a + v) % MOD_ADLER
//       b = (b + a) % MOD_ADLER
//   result = (b << 16) | a
//
// The result is a 32-bit unsigned value stored as a 64-bit NOVA int.
// We mask with & 0xFFFFFFFF at the end for consistency.
//
// NOVA GOTCHAS in this file:
//   • ord(char_at(s, i)) returns byte value 0..255.
//   • >> is ARITHMETIC in NOVA (sign-extending). Because a and b are always in
//     0..65520 (well below 2^15), the << 16 shift stays positive and >> is safe.
//   • Integer division '/' is integer division in NOVA — % for modulo is correct.
//   • No 'then' keyword; braces on separate lines for if/while.
//   • Unused locals = compile error; don't declare variables you don't use.
//
// Published KAT vectors (RFC 1950 + Wikipedia):
//   h_adler32("")          = 1             (0x00000001) — RFC 1950 initial state
//   h_adler32("a")         = 6422626       (0x00620062) — a=98, b=98
//   h_adler32("abc")       = 38600999      (0x024d0127) — a=295 mod 65521=295, b=590+295=885... see test
//   h_adler32("Wikipedia") = 300286872     (0x11E60398) — Wikipedia article KAT
//
// Hand-trace for "a" (byte 97):
//   a = (1 + 97) % 65521 = 98
//   b = (0 + 98) % 65521 = 98
//   result = (98 << 16) | 98 = 6422626 = 0x00620062  ✓
//
// Hand-trace for "abc" (bytes 97, 98, 99):
//   Step 1 (97): a=(1+97)%65521=98,   b=(0+98)%65521=98
//   Step 2 (98): a=(98+98)%65521=196, b=(98+196)%65521=294
//   Step 3 (99): a=(196+99)%65521=295,b=(294+295)%65521=589
//   result = (589 << 16) | 295 = 38600999 = 0x024d0127  ✓

// Adler-32 checksum of string s.
// Returns a 32-bit unsigned value (as int) per RFC 1950.
fn h_adler32(s: str) -> int
    let mod_adler = 65521
    let a = 1
    let b = 0
    let n = len(s)
    for i in 0..n
        let v = ord(char_at(s, i))
        a = (a + v) % mod_adler
        b = (b + a) % mod_adler
    ((b << 16) | a) & 0xFFFFFFFF
