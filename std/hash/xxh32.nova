// std/hash/xxh32.nova — xxHash32: fast 32-bit non-cryptographic hash (seedable).
//
// Specification: https://github.com/Cyan4973/xxHash/blob/dev/doc/xxhash_spec.md
//
// Primes (32-bit):
//   P1 = 0x9E3779B1  (= 2654435761)
//   P2 = 0x85EBCA77  (= 2246822519)
//   P3 = 0xC2B2AE3D  (= 3266489917)
//   P4 = 0x27D4EB2F  (= 668265263)
//   P5 = 0x165667B1  (= 374761393)
//
// All accumulator state is kept masked to 32 bits (& 0xFFFFFFFF).
// Rotations use _rotl32; right-shifts on 32-bit-masked values are logical.
//
// Public API:
//   h_xxh32(b: bytes, seed: int) -> int   xxHash32 of bytes b with given seed
//
// KAT vectors (official xxHash reference):
//   h_xxh32(bytes(0), 0)              == 0x02CC5D05
//   h_xxh32(str_to_bytes("abc"), 0)   == 0x32D153FF
//   h_xxh32(bytes(0), 0x2A)           == 0xF7982F9F

// ---------------------------------------------------------------------------
// 32-bit helpers
// ---------------------------------------------------------------------------

fn _m32(x)
    return x & 0xFFFFFFFF

fn _rotl32(x, r)
    let rr = r & 31
    return ((x << rr) | (x >> (32 - rr))) & 0xFFFFFFFF

// ---------------------------------------------------------------------------
// xxHash32 prime constants
// ---------------------------------------------------------------------------

fn _p1()
    return 0x9E3779B1

fn _p2()
    return 0x85EBCA77

fn _p3()
    return 0xC2B2AE3D

fn _p4()
    return 0x27D4EB2F

fn _p5()
    return 0x165667B1

// ---------------------------------------------------------------------------
// Internal: read a little-endian 32-bit word from bytes b at offset off.
// Bounds check: caller must ensure off+3 < bytes_len(b).
// ---------------------------------------------------------------------------

fn _xxh32_read32(b, off)
    let b0 = bytes_get(b, off)
    let b1 = bytes_get(b, off + 1)
    let b2 = bytes_get(b, off + 2)
    let b3 = bytes_get(b, off + 3)
    return _m32(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))

// ---------------------------------------------------------------------------
// Internal: process one 32-bit lane word through the accumulator round.
// acc = rotl32(acc + m32 * P2, 13) * P1
// ---------------------------------------------------------------------------

fn _xxh32_round(acc, input)
    let v = _m32(acc + _m32(input * _p2()))
    return _m32(_rotl32(v, 13) * _p1())

// ---------------------------------------------------------------------------
// Public: xxHash32 of bytes b with seed.
// ---------------------------------------------------------------------------

fn h_xxh32(b, seed)
    let n = bytes_len(b)
    let p1 = _p1()
    let p2 = _p2()
    let p3 = _p3()
    let p4 = _p4()
    let p5 = _p5()
    let h32 = 0
    let pos = 0

    // --- Step 1: initialise accumulators -----------------------------------
    // If input >= 16 bytes, use the 4-lane stripe loop.
    if n >= 16
        let v1 = _m32(seed + p1 + p2)
        let v2 = _m32(seed + p2)
        let v3 = _m32(seed)
        let v4 = _m32(seed - p1)

        while pos <= n - 16
            v1 = _xxh32_round(v1, _xxh32_read32(b, pos))
            v2 = _xxh32_round(v2, _xxh32_read32(b, pos + 4))
            v3 = _xxh32_round(v3, _xxh32_read32(b, pos + 8))
            v4 = _xxh32_round(v4, _xxh32_read32(b, pos + 12))
            pos += 16

        // Merge accumulators
        h32 = _m32(_rotl32(v1, 1) + _rotl32(v2, 7) + _rotl32(v3, 12) + _rotl32(v4, 18))
    else
        // Short path: no full 16-byte blocks
        h32 = _m32(seed + p5)

    // --- Step 2: add total length -------------------------------------------
    h32 = _m32(h32 + n)

    // --- Step 3: consume remaining bytes (< 16) in 4-byte chunks -----------
    while pos <= n - 4
        let lane = _xxh32_read32(b, pos)
        h32 = _m32(_rotl32(_m32(h32 + _m32(lane * p3)), 17) * p4)
        pos += 4

    // --- Step 4: consume remaining bytes one at a time ---------------------
    while pos < n
        let byt = bytes_get(b, pos)
        h32 = _m32(_rotl32(_m32(h32 + _m32(byt * p5)), 11) * p1)
        pos += 1

    // --- Step 5: final avalanche (mix) -------------------------------------
    h32 = _m32((h32 ^ (h32 >> 15)) * p2)
    h32 = _m32((h32 ^ (h32 >> 13)) * p3)
    h32 = h32 ^ (h32 >> 16)

    return h32
