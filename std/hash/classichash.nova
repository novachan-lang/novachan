// std/hash/classichash.nova — Classic string hash functions.
//
// Six well-known algorithms NOT already covered by std/hash (djb2/sdbm/fnv/jenkins
// are in separate modules).  All functions accept a str, iterate over its bytes,
// and return a 32-bit unsigned integer stored as a non-negative i64
// (0 .. 4294967295).  Every arithmetic step is masked with & 0xFFFFFFFF so that
// values never drift into negative i64 territory; plain >> is therefore a safe
// logical right-shift for all intermediate values in this module.
//
// Public API:
//   h_pjw(s)  -> int   PJW / ELF hash (Peter J. Weinberger, used in Unix ELF)
//   h_bkdr(s) -> int   BKDR hash (Brian Kernighan & Dennis Ritchie, seed 131)
//   h_ap(s)   -> int   AP hash (Arash Partow)
//   h_rs(s)   -> int   RS hash (Robert Sedgwick)
//   h_dek(s)  -> int   DEK hash (Donald E. Knuth, TAOCP vol 3)
//   h_js(s)   -> int   JS hash (Justin Sobel)
//
// KAT anchors (verified against Python reference implementations):
//   h_pjw("")      = 0          h_pjw("hello")  = 7258927
//   h_bkdr("")     = 0          h_bkdr("hello") = 792145550
//   h_bkdr("a")    = 97         h_bkdr("ab")    = 12805
//   h_ap("")       = 2863311530 h_ap("hello")   = 2446240143
//   h_rs("")       = 0          h_rs("hello")   = 987012754
//   h_dek("")      = 0          h_dek("hello")  = 213073391
//   h_js("")       = 1315423911 h_js("hello")   = 1729687499
//   All: h(x) != h(reverse(x))  for "ab"/"ba"  (order-sensitive)

// ---------------------------------------------------------------------------
// PJW hash / ELF hash  (Peter J. Weinberger, 1988)
// Used in the original Unix ELF object format symbol table.
//
// Algorithm:
//   h = 0
//   for each byte c:
//     h = (h << 4) + c
//     high = h & 0xF0000000
//     if high != 0:
//       h ^= high >> 24
//     h &= 0xFFFFFFFF ^ high     (clears the four high-nibble bits)
// ---------------------------------------------------------------------------
fn h_pjw(s) -> int
    let h = 0
    let b = str_to_bytes(s)
    let n = bytes_len(b)
    for i in 0..n
        let c = bytes_get(b, i)
        h = ((h << 4) + c) & 0xFFFFFFFF
        let hi = h & 0xF0000000
        if hi != 0
            h = (h ^ (hi >> 24)) & (0xFFFFFFFF ^ hi)
    return h

// ---------------------------------------------------------------------------
// BKDR hash  (Kernighan & Ritchie, "The C Programming Language", seed 131)
//
// Algorithm:
//   h = 0; seed = 131
//   for each byte c:  h = h * seed + c
//
// The seed 131 = 0x83 gives good distribution for ASCII strings.
// Anchors: h_bkdr("a") = 97,  h_bkdr("ab") = 97*131+98 = 12805.
// ---------------------------------------------------------------------------
fn h_bkdr(s) -> int
    let h = 0
    let b = str_to_bytes(s)
    let n = bytes_len(b)
    let i = 0
    while i < n
        let c = bytes_get(b, i)
        h = (h * 131 + c) & 0xFFFFFFFF
        i += 1
    return h

// ---------------------------------------------------------------------------
// AP hash  (Arash Partow, http://www.partow.net/programming/hashfunctions/)
//
// Uses two alternating mixing formulas based on even/odd byte position.
// Initial value: 0xAAAAAAAA = 2863311530.
//
// Algorithm:
//   h = 0xAAAAAAAA
//   for each byte c at index i:
//     if i is even: h ^= (h<<7) ^ c ^ (h>>2)
//     if i is odd:  h ^= ~((h<<11) ^ c ^ (h>>5))
//                        where ~ is 32-bit NOT = value ^ 0xFFFFFFFF
// ---------------------------------------------------------------------------
fn h_ap(s) -> int
    let h = 0xAAAAAAAA
    let b = str_to_bytes(s)
    let n = bytes_len(b)
    for i in 0..n
        let c = bytes_get(b, i)
        let even = (i & 1) == 0
        if even
            h = (h ^ (((h << 7) ^ c ^ (h >> 2)) & 0xFFFFFFFF)) & 0xFFFFFFFF
        else
            let inner = ((h << 11) ^ c ^ (h >> 5)) & 0xFFFFFFFF
            h = (h ^ (inner ^ 0xFFFFFFFF)) & 0xFFFFFFFF
    return h

// ---------------------------------------------------------------------------
// RS hash  (Robert Sedgwick)
// Uses two multiplied accumulators: `a` changes each step (a *= b where b=378551).
//
// Algorithm:
//   b = 378551; a = 63689; h = 0
//   for each byte c:
//     h = h * a + c
//     a = a * b
// ---------------------------------------------------------------------------
fn h_rs(s) -> int
    let magic_b = 378551
    let a = 63689
    let h = 0
    let b_bytes = str_to_bytes(s)
    let n = bytes_len(b_bytes)
    for i in 0..n
        let c = bytes_get(b_bytes, i)
        h = (h * a + c) & 0xFFFFFFFF
        a = (a * magic_b) & 0xFFFFFFFF
    return h

// ---------------------------------------------------------------------------
// DEK hash  (Donald E. Knuth, TAOCP vol 3, section 6.4)
//
// Algorithm:
//   h = len(s)
//   for each byte c:  h = (h << 5) ^ (h >> 27) ^ c
//
// The initial value is the string length, so h_dek("") = 0.
// h >> 27: since h is always masked to 32 bits (non-negative i64),
// arithmetic >> 27 equals logical >> 27 here.
// ---------------------------------------------------------------------------
fn h_dek(s) -> int
    let b = str_to_bytes(s)
    let n = bytes_len(b)
    let h = n & 0xFFFFFFFF
    for i in 0..n
        let c = bytes_get(b, i)
        h = (((h << 5) ^ (h >> 27)) ^ c) & 0xFFFFFFFF
    return h

// ---------------------------------------------------------------------------
// JS hash  (Justin Sobel)
// Initial value: 1315423911 = 0x4E67C6A7.
//
// Algorithm:
//   h = 1315423911
//   for each byte c:  h ^= (h<<5) + c + (h>>2)
// ---------------------------------------------------------------------------
fn h_js(s) -> int
    let h = 1315423911
    let b = str_to_bytes(s)
    let n = bytes_len(b)
    for i in 0..n
        let c = bytes_get(b, i)
        h = (h ^ (((h << 5) + c + (h >> 2)) & 0xFFFFFFFF)) & 0xFFFFFFFF
    return h
