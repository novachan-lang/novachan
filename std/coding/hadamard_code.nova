// std/coding/hadamard_code.nova — Hadamard code via Sylvester construction.
//
// A Hadamard code of order k has:
//   - block length n = 2^k
//   - 2^k codewords (one per row of the Hadamard matrix)
//   - minimum Hamming distance d = 2^(k-1)
//   - error-correction capability t = 2^(k-2) - 1 bit errors (for k >= 2)
//
// The {0,1} Hadamard matrix is defined by:
//   H[i][j] = parity( popcount(i AND j) )
// This is equivalent to Sylvester's recursive construction using XOR arithmetic
// on binary vectors instead of the {+1,-1} sign form.
//
// Decoding uses the fast Walsh-Hadamard Transform (WHT) to find the codeword
// with the maximum correlation to the received vector.  The WHT runs in
// O(k * 2^k) time rather than the O(4^k) brute-force approach.
//
// SELF-CONTAINED — imports NOTHING.
// All private helpers are prefixed _hc_ to avoid global symbol collisions.

// _hc_popcount — count set bits in a 64-bit integer using the built-in.
fn _hc_popcount(x) -> int
    popcount(x)

// _hc_parity — bit parity of x: 0 if popcount(x) is even, 1 if odd.
fn _hc_parity(x) -> int
    popcount(x) & 1

// _hc_pow2 — compute 2^k for k in 0..30.
fn _hc_pow2(k) -> int
    1 << k

// _hc_list_eq — element-wise equality of two int lists.
fn _hc_list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    let i = 0
    while i < na
        if a[i] != b[i]
            return false
        i = i + 1
    true

// hc_bit — single entry H[i][j] of the Hadamard matrix.
// Defined as the parity (mod-2 sum) of the bits in i AND j.
// This is the {0,1}-form where 0 = even parity, 1 = odd parity.
fn hc_bit(i, j) -> int
    _hc_parity(i & j)

// hc_length — block length of a Hadamard code of order k.
// Returns 2^k.
fn hc_length(k) -> int
    _hc_pow2(k)

// hc_min_distance — minimum Hamming distance of a Hadamard code of order k.
// Returns 2^(k-1).  The all-zero codeword (row 0) and any other row differ
// in exactly half the positions when k >= 1.
fn hc_min_distance(k) -> int
    _hc_pow2(k - 1)

// hc_matrix — build the full 2^k x 2^k Hadamard matrix in {0,1} form.
// Returns a list of 2^k rows, each a list of 2^k bits (0 or 1).
// Entry [i][j] = parity(popcount(i AND j)).
fn hc_matrix(k) -> any
    let n = _hc_pow2(k)
    let rows = []
    for i in 0..n
        let row = []
        let j = 0
        while j < n
            row.push(hc_bit(i, j))
            j = j + 1
        rows.push(row)
    rows

// hc_encode — encode a message index as the corresponding Hadamard codeword.
// msg_index must be in [0, 2^k).  Returns a list of 2^k bits (0 or 1).
// Codeword = row msg_index of the 2^k Hadamard matrix.
fn hc_encode(msg_index, k) -> any
    let n = _hc_pow2(k)
    let code = []
    for j in 0..n
        code.push(hc_bit(msg_index, j))
    code

// _hc_wht — in-place Walsh-Hadamard Transform (WHT) over a list of integers.
// The WHT maps a vector v to H*v where H is the (un-normalized) Hadamard matrix.
// Used for maximum-likelihood decoding: after the transform, the index with the
// largest absolute value corresponds to the nearest codeword.
// Algorithm: radix-2 Cooley-Tukey butterfly with three nested loops.
//   Outer: step = 1, 2, 4, ..., n/2
//   Middle: block starts at 0, 2*step, 4*step, ... (stride = 2*step)
//   Inner: k = 0..step-1 (index within left half of each block)
// The pair to butterfly is (block_start+k, block_start+k+step).
// Length must be a power of 2.
fn _hc_wht(v) -> any
    let n = len(v)
    let step = 1
    while step < n
        let two_step = step + step
        let block = 0
        while block < n
            let k = 0
            while k < step
                let ia = block + k
                let ib = ia + step
                let a = v[ia]
                let b = v[ib]
                v[ia] = a + b
                v[ib] = a - b
                k = k + 1
            block = block + two_step
        step = step + step
    v

// hc_decode — decode a received Hadamard codeword of length 2^k.
// Uses the fast Walsh-Hadamard Transform to find the message index with the
// highest correlation.  Corrects up to t = 2^(k-2) - 1 bit errors (for k>=2).
// Returns the most-likely message index in [0, 2^k).
fn hc_decode(code, k) -> int
    let n = _hc_pow2(k)
    // Convert {0,1} bits to {+1,-1} correlation values: 0 -> +1, 1 -> -1
    let corr = []
    for i in 0..n
        let bit = code[i]
        if bit == 0
            corr.push(1)
        else
            corr.push(-1)
    // Apply WHT: corr[idx] now holds the correlation with codeword idx
    _hc_wht(corr)
    // Find index of maximum absolute value (maximum-likelihood codeword)
    let best_idx = 0
    let best_val = corr[0]
    if best_val < 0
        best_val = 0 - best_val
    for j in 1..n
        let cv = corr[j]
        if cv < 0
            cv = 0 - cv
        if cv > best_val
            best_val = cv
            best_idx = j
    best_idx
