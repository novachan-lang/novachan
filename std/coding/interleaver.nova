// ============================================================================
// NOVA Standard Library — std/coding/interleaver
// ============================================================================
// Block and convolutional interleaving for burst-error protection.
//
// Interleaving breaks up consecutive error bursts so that after de-interleaving,
// a burst of length B is spread over B widely-separated positions.  This converts
// burst-error channels into effectively random-error channels, allowing standard
// FEC codes (like convolutional codes) to operate within their correction range.
//
// Included schemes:
//   Block interleaving     — write row-major, read column-major (rows x cols matrix)
//   Matrix (convolutional) — same as block; `depth` is the number of rows
//   Spread / gather        — permute symbols by a fixed stride (step)
//
// Spread permutation: output[i] = input[(i * step) mod N].
// This is invertible when gcd(step, N) == 1.  The inverse uses the modular inverse
// of step mod N for the gather (de-interleave) operation.
//
// Code parameters: none (pure permutation, not a coding-gain operation by itself).
//
// PUBLIC API (prefix il_):
//   il_block_interleave(data, rows, cols)     -> any   Write row-major, read col-major
//   il_block_deinterleave(data, rows, cols)   -> any   Inverse of block_interleave
//   il_pad(data, blocksize)                   -> any   Zero-pad to multiple of blocksize
//   il_matrix_interleave(data, depth)         -> any   Block interleave; cols=len/depth
//   il_matrix_deinterleave(data, depth)       -> any   Inverse matrix interleave
//   il_spread(data, step)                     -> any   Stride permutation
//   il_gather(data, step)                     -> any   Inverse stride permutation
//
// KNOWN TEST VECTORS:
//   il_block_interleave([1,2,3,4,5,6], 2, 3) == [1,4,2,5,3,6]
//   il_block_deinterleave([1,4,2,5,3,6], 2, 3) == [1,2,3,4,5,6]
//   il_block_interleave([1,2,3,4], 2, 2) == [1,3,2,4]
//   il_block_deinterleave(il_block_interleave(x,2,3), 2, 3) == x  for x=[1,2,3,4,5,6]
//   il_spread([0,1,2,3,4], 2) round-trips with il_gather([..], 2)
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// _il_mod: non-negative modulo (handles NOVA's truncation-toward-zero division).
fn _il_mod(x, m) -> int
    let r = x - (x / m) * m
    if r < 0
        r = r + m
    r

// _il_gcd: Euclidean GCD for two non-negative integers.
fn _il_gcd(a, b) -> int
    let aa = a
    let bb = b
    while bb != 0
        let tmp = bb
        bb = _il_mod(aa, bb)
        aa = tmp
    aa

// _il_modinv: modular inverse of a mod m using the extended Euclidean algorithm.
// Returns -1 if gcd(a, m) != 1 (no inverse exists).
fn _il_modinv(a, m) -> int
    let old_r = a
    let cur_r = m
    let old_s = 1
    let cur_s = 0
    while cur_r != 0
        let q = old_r / cur_r
        let tmp_r = cur_r
        cur_r = old_r - q * cur_r
        old_r = tmp_r
        let tmp_s = cur_s
        cur_s = old_s - q * cur_s
        old_s = tmp_s
    if old_r != 1
        return -1
    _il_mod(old_s, m)

// ── Public API ────────────────────────────────────────────────────────────────

// il_pad: zero-pad `data` so its length is a multiple of `blocksize`.
// If len(data) is already a multiple of blocksize, returns a copy unchanged.
// Padding elements are 0.
//
// Example: il_pad([1,2,3], 4) == [1, 2, 3, 0]
fn il_pad(data, blocksize) -> any
    let n = len(data)
    let out = []
    let i = 0
    while i < n
        push(out, data[i])
        i = i + 1
    let rem = _il_mod(n, blocksize)
    if rem != 0
        let pad = blocksize - rem
        let j = 0
        while j < pad
            push(out, 0)
            j = j + 1
    out

// il_block_interleave: write data into a (rows x cols) matrix row-major,
// then read out column-major.
//
// The input length must equal rows * cols; call il_pad first if needed.
// This spreads consecutive symbols (row) to be cols positions apart in the output,
// so a burst of length <= cols will appear as single isolated errors after
// de-interleaving.
//
// Read order: output[r + c*rows] = input[r*cols + c]
// Equivalently: out[j] = in[j/rows + (j mod rows)*cols]   (column r=j%rows, col c=j/rows)
//
// Example: il_block_interleave([1,2,3,4,5,6], 2, 3) == [1,4,2,5,3,6]
//   Matrix: row0=[1,2,3], row1=[4,5,6]
//   Read col0=[1,4], col1=[2,5], col2=[3,6]  => [1,4,2,5,3,6]
fn il_block_interleave(data, rows, cols) -> any
    let n = rows * cols
    let out = []
    let c = 0
    while c < cols
        let r = 0
        while r < rows
            push(out, data[r * cols + c])
            r = r + 1
        c = c + 1
    out

// il_block_deinterleave: inverse of il_block_interleave.
// Input was written column-major into (rows x cols); recover the row-major original.
//
// The column-major stream has: out[r + c*rows] = original[r*cols + c]
// So: original[r*cols + c] = interleaved[r + c*rows]
//
// We read the interleaved stream (column-by-column = groups of `rows` elements)
// and write back into row-major positions.
//
// Example: il_block_deinterleave([1,4,2,5,3,6], 2, 3) == [1,2,3,4,5,6]
fn il_block_deinterleave(data, rows, cols) -> any
    let n = rows * cols
    let out = []
    for k in 0..n
        push(out, 0)
    for c in 0..cols
        let r = 0
        while r < rows
            // interleaved index: r + c*rows
            let src = r + c * rows
            // original row-major index: r*cols + c
            let dst = r * cols + c
            out[dst] = data[src]
            r = r + 1
    out

// il_matrix_interleave: block interleave where `depth` is the number of rows
// and cols = len(data) / depth.  Pads if necessary.
// This is the standard "convolutional interleaver" matrix form.
//
// Example: il_matrix_interleave([1,2,3,4,5,6], 2) == [1,4,2,5,3,6]  (2 rows, 3 cols)
fn il_matrix_interleave(data, depth) -> any
    let n = len(data)
    let padded = il_pad(data, depth)
    let np = len(padded)
    let cols = np / depth
    il_block_interleave(padded, depth, cols)

// il_matrix_deinterleave: inverse of il_matrix_interleave.
// depth must match the depth used during interleaving.
//
// Example: il_matrix_deinterleave([1,4,2,5,3,6], 2) == [1,2,3,4,5,6]
fn il_matrix_deinterleave(data, depth) -> any
    let n = len(data)
    let cols = n / depth
    il_block_deinterleave(data, depth, cols)

// il_spread: stride permutation — output[i] = input[(i * step) mod N].
// Adjacent output symbols are `step` positions apart in the input, breaking
// burst correlations when gcd(step, N) == 1.
//
// If gcd(step, N) != 1 the permutation is not a bijection and il_gather will
// not perfectly invert it; use a step coprime with N for guaranteed round-trips.
//
// Example: il_spread([0,1,2,3,4], 2) == [0, 2, 4, 1, 3]
//   i=0: 0*2 mod 5=0 -> 0
//   i=1: 1*2 mod 5=2 -> 2
//   i=2: 2*2 mod 5=4 -> 4
//   i=3: 3*2 mod 5=1 -> 1
//   i=4: 4*2 mod 5=3 -> 3
fn il_spread(data, step) -> any
    let n = len(data)
    let out = []
    let i = 0
    while i < n
        let src = _il_mod(i * step, n)
        push(out, data[src])
        i = i + 1
    out

// il_gather: inverse of il_spread — recovers original from spread output.
// Uses modular inverse of step mod N; if gcd(step,N) != 1 returns best-effort.
//
// output[i] = input[(i * step) mod N]
// To invert: input[j] = output[i] where i*step ≡ j (mod N)
//            => i ≡ j * step_inv (mod N)
//            => recovered[j] = spread_data[(j * step_inv) mod N]   ... NO
// Simpler: spread maps src=i*step%N -> out[i]=data[src].
// So out[i] = data[i*step%N]; to get data[j], find i s.t. i*step%N==j => i=j*inv%N
// Then data[j] = out[j * step_inv % N].
// => gathered[j] = spread_data[(j * step_inv) mod N]
//
// Example: il_gather(il_spread([0,1,2,3,4], 2), 2) == [0,1,2,3,4]
fn il_gather(data, step) -> any
    let n = len(data)
    let step_inv = _il_modinv(_il_mod(step, n), n)
    // If no inverse (gcd != 1), fall back to step itself (partial inverse)
    if step_inv == -1
        step_inv = step
    let out = []
    for j in 0..n
        let src = _il_mod(j * step_inv, n)
        push(out, data[src])
    out
