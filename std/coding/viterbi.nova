// ============================================================================
// NOVA Standard Library — std/coding/viterbi
// ============================================================================
// Hard-decision Viterbi decoder for the rate-1/2, K=3 convolutional code
// with generator polynomials G1=7 (111) and G2=5 (101).
//
// The Viterbi algorithm finds the minimum-Hamming-distance path through the
// trellis diagram.  This implementation uses hard decisions (received bits
// are 0 or 1, not soft LLR values).
//
// Algorithm overview:
//   - States: 0..3 (2-bit shift register: state = s1*2 + s2)
//     s1 = (state >> 1) & 1 (most recently shifted in)
//     s2 = state & 1
//   - Encoder: g1 = u^s1^s2, g2 = u^s2; next_state = u*2 + s1
//   - At each step, ACS (Add-Compare-Select) updates 4 path metrics
//   - Survivor history: for each (step, next_state) store [prev_state, input_bit]
//   - After all steps, trace back from state 0 (code is terminated)
//   - Strip K-1=2 tail steps to recover only the message bits
//
// PUBLIC API (prefix vt_):
//   vt_decode(received_bits)              -> any   Decode a terminated codeword
//   vt_decode_terminated(received_bits)   -> any   Alias for vt_decode
//   vt_branch_metric(expected2, received2)-> int   Hamming dist of 2-bit symbol pair
//   vt_expected_output(state, inbit)      -> any   [g1, g2] encoder model output
//   vt_hamming(a, b)                      -> int   Hamming distance of two bit lists
//   vt_g1()                               -> int   7
//   vt_g2()                               -> int   5
//
// KNOWN TEST VECTORS:
//   vt_hamming([1,1], [1,0]) == 1
//   vt_decode(cv_encode([1,0,1,1])) == [1, 0, 1, 1]        (no errors)
//   vt_decode(cv_encode([1])) == [1]                         (no errors)
//   Flip one bit of cv_encode([1,0,1,1]): vt_decode recovers [1,0,1,1]
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Re-implemented encoder (self-contained) ───────────────────────────────────

// _vt_s1: extract s1 from packed 2-bit state (s1 = bit 1 = most-recent input).
fn _vt_s1(state) -> int
    let v = (state >> 1) & 1
    v

// _vt_s2: extract s2 from packed 2-bit state (s2 = bit 0 = older input).
fn _vt_s2(state) -> int
    let v = state & 1
    v

// _vt_enc_out: encoder outputs [g1, g2] for a given state and input bit u.
// g1 = u ^ s1 ^ s2,  g2 = u ^ s2
fn _vt_enc_out(state, u) -> any
    let s1 = _vt_s1(state)
    let s2 = _vt_s2(state)
    let g1 = u ^ s1 ^ s2
    let g2 = u ^ s2
    let out = []
    push(out, g1)
    push(out, g2)
    out

// _vt_next_state: advance encoder state by one input bit.
// next_state = u*2 + s1
fn _vt_next_state(state, u) -> int
    let s1 = _vt_s1(state)
    let ns = u * 2 + s1
    ns

// _vt_encode: encode bits with K-1=2 flush zeros (identical to cv_encode logic).
fn _vt_encode(bits) -> any
    let n = len(bits)
    let state = 0
    let out = []
    let i = 0
    while i < n
        let u = bits[i]
        let pair = _vt_enc_out(state, u)
        push(out, pair[0])
        push(out, pair[1])
        state = _vt_next_state(state, u)
        i = i + 1
    let f = 0
    while f < 2
        let pair = _vt_enc_out(state, 0)
        push(out, pair[0])
        push(out, pair[1])
        state = _vt_next_state(state, 0)
        f = f + 1
    out

// ── Private helpers ───────────────────────────────────────────────────────────

// _vt_inf: large sentinel value for unreachable state path metrics.
fn _vt_inf() -> int
    999999

// _vt_pm_get: retrieve path metric for state s from [pm0, pm1, pm2, pm3].
fn _vt_pm_get(pm, s) -> int
    pm[s]

// _vt_pm_set: set path metric for state s in [pm0, pm1, pm2, pm3].
fn _vt_pm_set(pm, s, v)
    pm[s] = v

// ── Public API ────────────────────────────────────────────────────────────────

// vt_g1: return generator polynomial G1 = 7.
fn vt_g1() -> int
    7

// vt_g2: return generator polynomial G2 = 5.
fn vt_g2() -> int
    5

// vt_hamming: Hamming distance between two equal-length bit lists.
// Counts positions i where a[i] != b[i].
//
// Example: vt_hamming([1,1], [1,0]) == 1
fn vt_hamming(a, b) -> int
    let n = len(a)
    let d = 0
    let i = 0
    while i < n
        let x = a[i] ^ b[i]
        if x != 0
            d = d + 1
        i = i + 1
    d

// vt_expected_output: return the 2-bit encoder output [g1, g2] for (state, inbit).
// Uses generator polynomials G1=7, G2=5.
//
// Example: vt_expected_output(0, 1) == [1, 1]
fn vt_expected_output(state, inbit) -> any
    _vt_enc_out(state, inbit)

// vt_branch_metric: Hamming distance between two 2-bit symbol lists.
// expected2 and received2 are each [b0, b1].
//
// Example: vt_branch_metric([1,1], [1,0]) == 1
fn vt_branch_metric(expected2, received2) -> int
    let d = 0
    let x0 = expected2[0] ^ received2[0]
    let x1 = expected2[1] ^ received2[1]
    if x0 != 0
        d = d + 1
    if x1 != 0
        d = d + 1
    d

// vt_decode: hard-decision Viterbi decode a terminated rate-1/2 K=3 codeword.
//
// Input: received_bits — list of 0/1 values; length must be even.
// Assumes the encoder was flushed with K-1=2 zero bits; decoded output strips
// those 2 tail steps, returning only the original message bits.
//
// Survivor storage: for each trellis step, store a flat list of 8 values:
//   [prev_state_for_ns0, input_for_ns0, prev_state_for_ns1, input_for_ns1,
//    prev_state_for_ns2, input_for_ns2, prev_state_for_ns3, input_for_ns3]
//
// Traceback: start from state 0 at the last step, walk backwards using
// prev_state entries to recover the sequence of input bits.
//
// Example: vt_decode(vt_encode([1,0,1,1])) == [1, 0, 1, 1]
fn vt_decode(received_bits) -> any
    let total_bits = len(received_bits)
    let num_steps = total_bits / 2
    // Path metrics: flat list of 4 values, indexed by state (0..3)
    let pm = []
    push(pm, 0)
    push(pm, _vt_inf())
    push(pm, _vt_inf())
    push(pm, _vt_inf())
    // Survivor history: list of num_steps entries; each entry is a flat list of 8:
    //   [prev_state_0, input_0, prev_state_1, input_1, prev_state_2, input_2, prev_state_3, input_3]
    let survivors = []
    let step = 0
    while step < num_steps
        let r0 = received_bits[step * 2]
        let r1 = received_bits[step * 2 + 1]
        // New path metrics for next step, all initialized to INF
        let npm = []
        push(npm, _vt_inf())
        push(npm, _vt_inf())
        push(npm, _vt_inf())
        push(npm, _vt_inf())
        // Survivor entry: [prev0, in0, prev1, in1, prev2, in2, prev3, in3]
        // Initialize to 0s; will be overwritten by ACS winners
        let surv = []
        push(surv, 0)
        push(surv, 0)
        push(surv, 0)
        push(surv, 0)
        push(surv, 0)
        push(surv, 0)
        push(surv, 0)
        push(surv, 0)
        let inf_th = _vt_inf() - 1
        // ACS: enumerate all (prev_state ps, input bit u) transitions
        let ps = 0
        while ps < 4
            let prev_pm = pm[ps]
            if prev_pm < inf_th
                let u = 0
                while u < 2
                    let ns = _vt_next_state(ps, u)
                    let enc = _vt_enc_out(ps, u)
                    let bm = 0
                    if enc[0] != r0
                        bm = bm + 1
                    if enc[1] != r1
                        bm = bm + 1
                    let cand = prev_pm + bm
                    if cand < npm[ns]
                        npm[ns] = cand
                        // store survivor: surv[ns*2] = ps, surv[ns*2+1] = u
                        surv[ns * 2] = ps
                        surv[ns * 2 + 1] = u
                    u = u + 1
            ps = ps + 1
        pm[0] = npm[0]
        pm[1] = npm[1]
        pm[2] = npm[2]
        pm[3] = npm[3]
        push(survivors, surv)
        step = step + 1
    // Traceback from state 0 (terminated code ends at state 0)
    // path[t] = input bit chosen at trellis step t
    let path = []
    let k = 0
    while k < num_steps
        push(path, 0)
        k = k + 1
    let cur_state = 0
    let tb = num_steps - 1
    while tb >= 0
        let surv_entry = survivors[tb]
        let prev_s = surv_entry[cur_state * 2]
        let input_b = surv_entry[cur_state * 2 + 1]
        path[tb] = input_b
        cur_state = prev_s
        tb = tb - 1
    // Strip the 2 tail (flush) steps
    let msg_len = num_steps - 2
    let out = []
    let j = 0
    while j < msg_len
        push(out, path[j])
        j = j + 1
    out

// vt_decode_terminated: alias for vt_decode.
// Named to make explicit that the code is terminated (flushed with K-1 zeros).
//
// Example: vt_decode_terminated(cv_encode([1,0,1,1])) == [1, 0, 1, 1]
fn vt_decode_terminated(received) -> any
    vt_decode(received)
