// std/logic/logic_gates.nova — single-bit digital gate primitives and small arithmetic circuits.
// All gate inputs/outputs are 0 or 1 (single bits) except lgt_mux which passes through any int.
// LEAF — imports NOTHING.

// lgt_and — AND gate: 1 iff both a and b are 1.
fn lgt_and(a: int, b: int) -> int
    a & b

// lgt_or — OR gate: 1 iff at least one of a, b is 1.
fn lgt_or(a: int, b: int) -> int
    a | b

// lgt_not — NOT gate (inverter): flips a single bit (input must be 0 or 1).
fn lgt_not(a: int) -> int
    1 - a

// lgt_nand — NAND gate: NOT(AND).
fn lgt_nand(a: int, b: int) -> int
    1 - (a & b)

// lgt_nor — NOR gate: NOT(OR).
fn lgt_nor(a: int, b: int) -> int
    1 - (a | b)

// lgt_xor — XOR gate: 1 iff exactly one of a, b is 1.
fn lgt_xor(a: int, b: int) -> int
    a ^ b

// lgt_xnor — XNOR gate: 1 iff a == b (complement of XOR).
fn lgt_xnor(a: int, b: int) -> int
    1 - (a ^ b)

// lgt_mux — 2-to-1 multiplexer: sel=0 selects a, sel=1 selects b. a and b may be any int.
fn lgt_mux(sel: int, a: int, b: int) -> int
    if sel == 0
        return a
    b

// lgt_half_adder — 1-bit half adder: returns [sum, carry] where sum = a XOR b, carry = a AND b.
fn lgt_half_adder(a: int, b: int) -> list
    let s = a ^ b
    let c = a & b
    let out = []
    push(out, s)
    push(out, c)
    out

// lgt_full_adder — 1-bit full adder with carry-in: returns [sum, carry_out].
// sum = a XOR b XOR cin; carry_out = (a AND b) OR (cin AND (a XOR b)).
fn lgt_full_adder(a: int, b: int, cin: int) -> list
    let ab = a ^ b
    let s = ab ^ cin
    let co = (a & b) | (cin & ab)
    let out = []
    push(out, s)
    push(out, co)
    out

// lgt_majority — majority gate: returns 1 iff at least 2 of {a,b,c} are 1.
fn lgt_majority(a: int, b: int, c: int) -> int
    (a & b) | (b & c) | (a & c)
