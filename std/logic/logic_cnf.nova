// std/logic/logic_cnf.nova — Propositional CNF/DNF utilities.
// LEAF — imports NOTHING.
// Convention (B): variables 1-indexed; literal +v = var v true, -v = var v false.
// Convention (A) truth-table-int T: bit i of T = f(assignment i), where bit b of i = var (b+1).
//
// Public API:
//   lcnf_eval_clause(clause, asgn) -> int   1 if any literal satisfied else 0 (empty clause -> 0)
//   lcnf_eval_cnf(cnf, asgn)       -> int   1 if all clauses satisfied else 0 (empty cnf -> 1)
//   lcnf_eval_dnf(dnf, asgn)       -> int   1 if any term (AND of lits) satisfied else 0 (empty dnf -> 0)
//   lcnf_tt_to_dnf(T, n)           -> list  canonical minterm DNF: one n-literal term per assignment where T has 1
//   lcnf_tt_to_cnf(T, n)           -> list  canonical maxterm CNF: one n-literal clause per assignment where T has 0
//   lcnf_is_horn(cnf)              -> bool  true iff every clause has at most one positive literal

// lcnf_eval_clause — evaluate a clause (disjunction of literals) on assignment asgn (0/1 list, 1-indexed vars).
// Returns 1 if any literal is satisfied, 0 otherwise. Empty clause returns 0 (false).
fn lcnf_eval_clause(clause, asgn) -> int
    let n = len(clause)
    for i in 0..n
        let lit = clause[i]
        if lit > 0
            if asgn[lit - 1] == 1
                return 1
        if lit < 0
            let v = 0 - lit
            if asgn[v - 1] == 0
                return 1
    0

// lcnf_eval_cnf — evaluate a CNF (AND of clauses) on assignment asgn. Empty CNF returns 1 (true).
fn lcnf_eval_cnf(cnf, asgn) -> int
    let nc = len(cnf)
    for i in 0..nc
        if lcnf_eval_clause(cnf[i], asgn) == 0
            return 0
    1

// _lcnf_eval_term — evaluate a term (AND of literals) on assignment asgn. Empty term returns 1 (true).
fn _lcnf_eval_term(term, asgn) -> int
    let n = len(term)
    for i in 0..n
        let lit = term[i]
        if lit > 0
            if asgn[lit - 1] != 1
                return 0
        if lit < 0
            let v = 0 - lit
            if asgn[v - 1] != 0
                return 0
    1

// lcnf_eval_dnf — evaluate a DNF (OR of terms) on assignment asgn. Empty DNF returns 0 (false).
fn lcnf_eval_dnf(dnf, asgn) -> int
    let nt = len(dnf)
    let i = 0
    while i < nt
        if _lcnf_eval_term(dnf[i], asgn) == 1
            return 1
        i += 1
    0

// _lcnf_int_to_asgn — convert integer assignment index i to a 0/1 list of length n (bit b -> asgn[b]).
fn _lcnf_int_to_asgn(i, n) -> list
    let asgn = []
    let b = 0
    while b < n
        let bit = (i >> b) & 1
        push(asgn, bit)
        b += 1
    asgn

// lcnf_tt_to_dnf — canonical minterm DNF from truth-table-int T with n variables.
// For each assignment i where bit i of T is 1, build an n-literal term:
//   literal (b+1) if bit b of i is 1, else -(b+1), for b in 0..n-1.
// Returns a list of terms (each term is a list of n literals).
fn lcnf_tt_to_dnf(T, n) -> list
    let dnf = []
    let total = 1 << n
    let i = 0
    while i < total
        let bit = (T >> i) & 1
        if bit == 1
            let term = []
            let b = 0
            while b < n
                let bbit = (i >> b) & 1
                let lit = b + 1
                if bbit == 0
                    lit = 0 - (b + 1)
                push(term, lit)
                b += 1
            push(dnf, term)
        i += 1
    dnf

// lcnf_tt_to_cnf — canonical maxterm CNF from truth-table-int T with n variables.
// For each assignment i where bit i of T is 0, build an n-literal clause (maxterm):
//   literal (b+1) if bit b of i is 0 (var must be true to avoid falsifying), else -(b+1).
// Returns a list of clauses (each clause is a list of n literals).
fn lcnf_tt_to_cnf(T, n) -> list
    let cnf = []
    let total = 1 << n
    for i in 0..total
        let bit = (T >> i) & 1
        if bit == 0
            let clause = []
            let b = 0
            while b < n
                let bbit = (i >> b) & 1
                let lit = b + 1
                if bbit == 1
                    lit = 0 - (b + 1)
                push(clause, lit)
                b += 1
            push(cnf, clause)
    cnf

// lcnf_is_horn — true iff every clause in the CNF has at most one positive literal.
fn lcnf_is_horn(cnf) -> bool
    let nc = len(cnf)
    for ci in 0..nc
        let clause = cnf[ci]
        let pos = 0
        let li = 0
        while li < len(clause)
            if clause[li] > 0
                pos += 1
            li += 1
        if pos > 1
            return false
    true
