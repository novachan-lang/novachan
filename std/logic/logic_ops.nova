// std/logic/logic_ops.nova — boolean algebra operations on truth-table-int representations.
// Convention (A): T encodes a boolean function of n variables as a 2^n-bit integer.
// All operations are bitwise on the truth-table integers; the mask for n variables is (1<<(2^n))-1.
// LEAF — imports NOTHING.

// lop_and — conjunction: (a AND b) truth table = bitwise AND.
fn lop_and(a: int, b: int) -> int
    a & b

// lop_or — disjunction: (a OR b) truth table = bitwise OR.
fn lop_or(a: int, b: int) -> int
    a | b

// lop_xor — exclusive OR: (a XOR b) truth table = bitwise XOR.
fn lop_xor(a: int, b: int) -> int
    a ^ b

// lop_not — complement: NOT a masked to 2^n bits.
fn lop_not(a: int, n: int) -> int
    let mask = (1 << (1 << n)) - 1
    (a ^ mask) & mask

// lop_nand — NAND: NOT(a AND b), masked to 2^n bits.
fn lop_nand(a: int, b: int, n: int) -> int
    let mask = (1 << (1 << n)) - 1
    ((a & b) ^ mask) & mask

// lop_nor — NOR: NOT(a OR b), masked to 2^n bits.
fn lop_nor(a: int, b: int, n: int) -> int
    let mask = (1 << (1 << n)) - 1
    ((a | b) ^ mask) & mask

// lop_implies — material implication: a->b = (NOT a) OR b.
fn lop_implies(a: int, b: int, n: int) -> int
    let mask = (1 << (1 << n)) - 1
    let not_a = (a ^ mask) & mask
    not_a | b

// lop_iff — biconditional: a<->b = NOT(a XOR b), masked to 2^n bits.
fn lop_iff(a: int, b: int, n: int) -> int
    let mask = (1 << (1 << n)) - 1
    ((a ^ b) ^ mask) & mask
