// std/logic/logic_properties.nova — Post-class boolean function properties over truth-table-ints.
// Convention (A): TRUTH-TABLE-INT over n<=4 variables.
// Assignment i = bit i of T; n vars => 2^n table entries.
// LEAF — imports NOTHING.

// lpr_preserves_zero(T, n) -> bool
// True iff f(0) = 0, i.e. bit 0 of T is 0 (assignment all-zeros maps to 0).
fn lpr_preserves_zero(T, n)
    (T & 1) == 0

// lpr_preserves_one(T, n) -> bool
// True iff f(all-ones) = 1, i.e. the highest assignment (2^n - 1) maps to 1.
fn lpr_preserves_one(T, n)
    let top = (1 << n) - 1
    ((T >> top) & 1) == 1

// lpr_is_monotone(T, n) -> bool
// True iff for all pairs i, j with i subset j (bitwise: i & j == i), f(i) <= f(j).
// Equivalently: there is no pair where i < j (bitwise) yet f(i)=1 and f(j)=0.
fn lpr_is_monotone(T, n)
    let total = 1 << n
    for i in 0..total
        let fi = (T >> i) & 1
        if fi == 1
            let j = i + 1
            while j < total
                if (i & j) == i
                    let fj = (T >> j) & 1
                    if fj == 0
                        return false
                j = j + 1
    true

// _lpr_popcount(x) -> int
// Count set bits in non-negative integer x.
fn _lpr_popcount(x)
    let v = x
    let cnt = 0
    while v > 0
        cnt = cnt + (v & 1)
        v = v >> 1
    cnt

// lpr_is_linear(T, n) -> bool
// True iff f is affine over GF(2): its Algebraic Normal Form (ANF) has no term of degree >= 2.
// Uses the Möbius (Reed-Muller) transform to compute ANF coefficients, then checks
// all coefficients at minterms with popcount >= 2 are zero.
fn lpr_is_linear(T, n)
    let total = 1 << n
    // Extract truth-table values into a mutable array (list of 0/1).
    let anf = []
    let i = 0
    while i < total
        push(anf, (T >> i) & 1)
        i = i + 1
    // Möbius transform in-place: for each variable bit b, XOR anf[m] into anf[m | (1<<b)] for all m.
    for b in 0..n
        let step = 1 << b
        let m = 0
        while m < total
            if (m >> b) & 1 == 1
                anf[m] = anf[m] ^ anf[m ^ step]
            m = m + 1
    // Check: all ANF coefficients at minterms with popcount >= 2 must be 0.
    let k = 0
    while k < total
        if _lpr_popcount(k) >= 2
            if anf[k] != 0
                return false
        k = k + 1
    true

// lpr_is_selfdual(T, n) -> bool
// True iff f(i) = 1 - f(complement(i)) for all assignments i, where complement flips all n bits.
fn lpr_is_selfdual(T, n)
    let total = 1 << n
    let all_bits = total - 1
    for i in 0..total
        let fi = (T >> i) & 1
        let ci = i ^ all_bits
        let fci = (T >> ci) & 1
        if fi == fci
            return false
    true

// lpr_is_symmetric(T, n) -> bool
// True iff f depends only on the popcount (Hamming weight) of the input.
// Equivalently: all assignments with the same number of 1-bits have the same f value.
fn lpr_is_symmetric(T, n)
    let total = 1 << n
    // For each popcount value k, verify all assignments with popcount k agree on f.
    let pc = 0
    while pc <= n
        // Find first assignment with this popcount, record its f value.
        let first_f = -1
        let i = 0
        while i < total
            if _lpr_popcount(i) == pc
                let fi = (T >> i) & 1
                if first_f == -1
                    first_f = fi
                else if fi != first_f
                    return false
            i = i + 1
        pc = pc + 1
    true

// lpr_dual(T, n) -> int
// Returns the dual function's truth-table-int.
// The dual of f is: dual(f)(i) = 1 - f(complement(i)), where complement flips all n bits.
// Equivalently: bit i of dual_T = 1 - bit (complement(i)) of T.
fn lpr_dual(T, n)
    let total = 1 << n
    let all_bits = total - 1
    let dual_T = 0
    for i in 0..total
        let ci = i ^ all_bits
        let fci = (T >> ci) & 1
        if fci == 0
            dual_T = dual_T | (1 << i)
    dual_T
