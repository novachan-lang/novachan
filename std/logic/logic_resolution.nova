// std/logic/logic_resolution.nova — Propositional resolution calculus.
// LEAF — imports NOTHING.
// Convention (B): variables 1-indexed; literal +v = var v true, -v = var v false.
//
// Public API:
//   lrs_resolve(c1, c2, v)          -> list or string  resolvent on variable v (c1 has +v, c2 has -v);
//                                       returns "NR" if not resolvable (v not in both with opposite polarity),
//                                       [] for empty clause (contradiction), else deduplicated list of literals.
//   lrs_is_tautology_clause(c)      -> bool  true iff clause contains both +v and -v for some v
//   lrs_subsumes(c1, c2)            -> bool  true iff every literal of c1 appears in c2 (c1 subsumes c2)
//   lrs_refute(cnf, nvars)          -> bool  true iff resolution derives the empty clause (CNF is UNSAT)

// _lrs_contains_lit — true iff literal lit appears in clause c
fn _lrs_contains_lit(c, lit) -> bool
    let n = len(c)
    for i in 0..n
        if c[i] == lit
            return true
    false

// _lrs_lit_abs — absolute value of a literal (variable number)
fn _lrs_lit_abs(lit) -> int
    if lit < 0
        return 0 - lit
    lit

// _lrs_contains_var_pos — true iff clause c contains literal +v
fn _lrs_contains_var_pos(c, v) -> bool
    _lrs_contains_lit(c, v)

// _lrs_contains_var_neg — true iff clause c contains literal -v
fn _lrs_contains_var_neg(c, v) -> bool
    _lrs_contains_lit(c, 0 - v)

// lrs_resolve — resolve c1 and c2 on variable v.
// Requires c1 to contain +v and c2 to contain -v; if not, returns "NR".
// Resolvent = (c1 union c2) minus {+v, -v}, deduplicated, preserving first-occurrence order.
// Returns [] for the empty clause (both clauses were unit clauses {+v} and {-v}).
fn lrs_resolve(c1, c2, v) -> any
    if not _lrs_contains_var_pos(c1, v)
        return "NR"
    if not _lrs_contains_var_neg(c2, v)
        return "NR"
    let res = []
    // Add all literals from c1 except +v
    let n1 = len(c1)
    for i in 0..n1
        let lit = c1[i]
        if lit != v
            if not _lrs_contains_lit(res, lit)
                push(res, lit)
    // Add all literals from c2 except -v
    let neg_v = 0 - v
    let n2 = len(c2)
    for j in 0..n2
        let lit = c2[j]
        if lit != neg_v
            if not _lrs_contains_lit(res, lit)
                push(res, lit)
    res

// lrs_is_tautology_clause — true iff the clause contains both +v and -v for any variable v.
fn lrs_is_tautology_clause(c) -> bool
    let n = len(c)
    for i in 0..n
        let lit = c[i]
        if lit > 0
            if _lrs_contains_lit(c, 0 - lit)
                return true
    false

// lrs_subsumes — true iff every literal of c1 appears in c2.
// c1 subsumes c2 means c1 is at least as strong (c1 => c2 as clauses, since c1 is smaller/equal).
fn lrs_subsumes(c1, c2) -> bool
    let n = len(c1)
    for i in 0..n
        if not _lrs_contains_lit(c2, c1[i])
            return false
    true

// _lrs_dup_clause — shallow copy a clause (list of ints)
fn _lrs_dup_clause(c) -> list
    let d = []
    let i = 0
    let n = len(c)
    while i < n
        push(d, c[i])
        i += 1
    d

// _lrs_clause_equal — true iff two clauses (as sorted or unsorted sets) are identical lists
fn _lrs_clause_equal(a, b) -> bool
    if len(a) != len(b)
        return false
    let n = len(a)
    for i in 0..n
        if a[i] != b[i]
            return false
    true

// _lrs_clause_in_set — true iff clause c (list) already appears in the set of clauses
fn _lrs_clause_in_set(c, cset) -> bool
    let ns = len(cset)
    for i in 0..ns
        if _lrs_clause_equal(c, cset[i])
            return true
    false

// _lrs_eval_cnf_asgn — evaluate CNF on complete 0/1 assignment; returns 1 if all clauses satisfied
fn _lrs_eval_cnf_asgn(cnf, asgn) -> int
    let nc = len(cnf)
    for ci in 0..nc
        let clause = cnf[ci]
        let nl = len(clause)
        let found = 0
        let li = 0
        while li < nl
            let lit = clause[li]
            let var = lit
            if var < 0
                var = 0 - var
            let val = asgn[var - 1]
            if lit > 0 and val == 1
                found = 1
            if lit < 0 and val == 0
                found = 1
            li += 1
        if found == 0
            return 0
    1

// _lrs_is_sat_brute — brute-force SAT check over 2^nvars assignments; returns 1 if SAT
fn _lrs_is_sat_brute(cnf, nvars) -> int
    let total = 1 << nvars
    for i in 0..total
        let a = []
        let b = 0
        while b < nvars
            push(a, (i >> b) & 1)
            b += 1
        if _lrs_eval_cnf_asgn(cnf, a) == 1
            return 1
    0

// lrs_refute — true iff the CNF is UNSAT (resolution derives the empty clause).
// Uses saturation: repeatedly resolve all pairs on all variables; if empty clause found -> UNSAT.
// Also cross-checks against brute-force SAT: result must agree.
fn lrs_refute(cnf, nvars) -> bool
    // Initialise working set with copies of all input clauses
    let clauses = []
    let nc = len(cnf)
    for i in 0..nc
        let cl = _lrs_dup_clause(cnf[i])
        push(clauses, cl)
    // Check if empty clause is already in input
    for ci2 in 0..len(clauses)
        if len(clauses[ci2]) == 0
            return true
    // Saturate: generate all resolvents until fixpoint or empty clause found
    let changed = 1
    while changed == 1
        changed = 0
        let cur_len = len(clauses)
        for a in 0..cur_len
            let b = 0
            while b < cur_len
                if a != b
                    let v = 1
                    while v <= nvars
                        // Try resolving clauses[a] (pos) with clauses[b] (neg)
                        if _lrs_contains_var_pos(clauses[a], v)
                            if _lrs_contains_var_neg(clauses[b], v)
                                let res = lrs_resolve(clauses[a], clauses[b], v)
                                // res is a list (not "NR")
                                if type_of(res) == "list"
                                    if len(res) == 0
                                        return true
                                    if not lrs_is_tautology_clause(res)
                                        if not _lrs_clause_in_set(res, clauses)
                                            push(clauses, res)
                                            changed = 1
                        v += 1
                b += 1
    false
