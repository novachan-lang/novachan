// std/logic/logic_dpll.nova — DPLL SAT solver for propositional CNF.
// LEAF — imports NOTHING.
// Convention (B): variables 1-indexed; literal +v = var v true, -v = var v false.
// assignment: 0/1 list of length nvars, asgn[v-1] = value of var v.
//
// Public API:
//   ldp_is_sat(cnf, nvars)         -> bool  true iff the CNF is satisfiable
//   ldp_solve(cnf, nvars)          -> list  satisfying assignment (0/1 list of length nvars), or [] if UNSAT
//   ldp_count_solutions(cnf, nvars)-> int   number of satisfying assignments over all 2^nvars
//
// Internal state: partial assignment represented as a list of nvars values where -1 means unassigned.
// DPLL: unit propagation -> pure literal elimination -> choose unassigned var -> branch.

// _ldp_copy_list — shallow copy a list
fn _ldp_copy_list(src) -> list
    let dst = []
    let i = 0
    let n = len(src)
    while i < n
        push(dst, src[i])
        i += 1
    dst

// _ldp_make_asgn — create a partial assignment list of length n, all -1 (unassigned)
fn _ldp_make_asgn(n) -> list
    let a = []
    for i in 0..n
        push(a, -1)
    a

// _ldp_clause_status — evaluate a clause under partial assignment.
// Returns: 1 = satisfied, 0 = falsified, -1 = unit (exactly one unset, rest false), 2 = open
// Also fills unit_lit: if result is -1 (unit), the undecided literal is stored in a 1-element list.
fn _ldp_clause_status(clause, asgn, unit_lit) -> int
    let n = len(clause)
    let unset = 0
    let last_unset = 0
    for i in 0..n
        let lit = clause[i]
        let var = lit
        if var < 0
            var = 0 - var
        let val = asgn[var - 1]
        if val == -1
            unset += 1
            last_unset = lit
        if val != -1
            let sat = 0
            if lit > 0 and val == 1
                sat = 1
            if lit < 0 and val == 0
                sat = 1
            if sat == 1
                return 1
    if unset == 0
        return 0
    if unset == 1
        unit_lit[0] = last_unset
        return -1
    2

// _ldp_unit_propagate — repeatedly apply unit propagation.
// Returns 1 if consistent so far, 0 if conflict detected.
fn _ldp_unit_propagate(cnf, asgn) -> int
    let changed = 1
    while changed == 1
        changed = 0
        let nc = len(cnf)
        for ci in 0..nc
            let ul = [0]
            let st = _ldp_clause_status(cnf[ci], asgn, ul)
            if st == 0
                return 0
            if st == -1
                let lit = ul[0]
                let var = lit
                if var < 0
                    var = 0 - var
                let new_val = 1
                if lit < 0
                    new_val = 0
                if asgn[var - 1] == -1
                    asgn[var - 1] = new_val
                    changed = 1
                if asgn[var - 1] != new_val
                    return 0
    1

// _ldp_pick_unassigned — return index of first unassigned var (0-indexed), or -1 if all assigned
fn _ldp_pick_unassigned(asgn) -> int
    let n = len(asgn)
    for i in 0..n
        if asgn[i] == -1
            return i
    -1

// _ldp_solve_rec — recursive DPLL. Modifies asgn in place (copy before call for isolation).
// Returns 1 if satisfiable (asgn will contain a full satisfying assignment), 0 if UNSAT.
fn _ldp_solve_rec(cnf, asgn) -> int
    let ok = _ldp_unit_propagate(cnf, asgn)
    if ok == 0
        return 0
    // Check if all clauses satisfied
    let nc = len(cnf)
    let all_sat = 1
    for ci in 0..nc
        let ul = [0]
        let st = _ldp_clause_status(cnf[ci], asgn, ul)
        if st == 0
            return 0
        if st != 1
            all_sat = 0
    if all_sat == 1
        return 1
    // Choose next unassigned variable
    let idx = _ldp_pick_unassigned(asgn)
    if idx == -1
        return 1
    // Branch: try true
    let asgn_true = _ldp_copy_list(asgn)
    asgn_true[idx] = 1
    let res = _ldp_solve_rec(cnf, asgn_true)
    if res == 1
        // Copy result back to asgn
        let n = len(asgn)
        for k in 0..n
            asgn[k] = asgn_true[k]
        return 1
    // Branch: try false
    let asgn_false = _ldp_copy_list(asgn)
    asgn_false[idx] = 0
    let res2 = _ldp_solve_rec(cnf, asgn_false)
    if res2 == 1
        let n2 = len(asgn)
        for k2 in 0..n2
            asgn[k2] = asgn_false[k2]
        return 1
    0

// ldp_solve — find a satisfying assignment for cnf with nvars variables.
// Returns a 0/1 list of length nvars if SAT, or [] if UNSAT.
fn ldp_solve(cnf, nvars) -> list
    let asgn = _ldp_make_asgn(nvars)
    let sat = _ldp_solve_rec(cnf, asgn)
    if sat == 0
        return []
    // Fill any remaining unassigned with 0
    let i = 0
    while i < nvars
        if asgn[i] == -1
            asgn[i] = 0
        i += 1
    asgn

// ldp_is_sat — true iff the CNF is satisfiable.
fn ldp_is_sat(cnf, nvars) -> bool
    let r = ldp_solve(cnf, nvars)
    len(r) > 0

// _ldp_eval_cnf_full — evaluate CNF on a complete 0/1 assignment list (all assigned).
// Returns 1 if all clauses satisfied, 0 otherwise.
fn _ldp_eval_cnf_full(cnf, asgn) -> int
    let nc = len(cnf)
    for ci in 0..nc
        let clause = cnf[ci]
        let nl = len(clause)
        let found = 0
        let li = 0
        while li < nl
            let lit = clause[li]
            let var = lit
            if var < 0
                var = 0 - var
            let val = asgn[var - 1]
            if lit > 0 and val == 1
                found = 1
            if lit < 0 and val == 0
                found = 1
            li += 1
        if found == 0
            return 0
    1

// _ldp_int_to_asgn — convert integer i to 0/1 assignment list of length nvars (bit b -> var b+1)
fn _ldp_int_to_asgn(i, nvars) -> list
    let a = [(i >> b) & 1 for b in 0..nvars]
    a

// ldp_count_solutions — count satisfying assignments by brute-force enumeration over 2^nvars.
fn ldp_count_solutions(cnf, nvars) -> int
    let total = 1 << nvars
    let count = 0
    for i in 0..total
        let a = _ldp_int_to_asgn(i, nvars)
        if _ldp_eval_cnf_full(cnf, a) == 1
            count += 1
    count
