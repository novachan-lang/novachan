// std/logic/logic_quine.nova — Quine-McCluskey minimization over n<=4 variables.
// Convention (A): TRUTH-TABLE-INT. Assignment i = bit i of T; n vars => 2^n entries.
// Cube encoding: list of length n over {0,1,2}; index b = variable b;
//   0 => var b must be 0, 1 => must be 1, 2 => don't-care.
// LEAF — imports NOTHING.

// lqm_cube_covers(cube, i) -> bool
// True iff assignment integer i satisfies every non-don't-care position in cube.
fn lqm_cube_covers(cube, i)
    let n = len(cube)
    let b = 0
    while b < n
        let cv = cube[b]
        if cv != 2
            let bit = (i >> b) & 1
            if bit != cv
                return false
        b = b + 1
    true

// lqm_sop_to_tt(sop, n) -> int
// Converts a sum-of-products (list of cubes) to a truth-table-int over n variables.
// Result bit i = 1 iff some cube in sop covers assignment i.
fn lqm_sop_to_tt(sop, n)
    let total = 1 << n
    let T = 0
    for i in 0..total
        let ci = 0
        let nc = len(sop)
        while ci < nc
            if lqm_cube_covers(sop[ci], i)
                T = T | (1 << i)
                ci = nc
            ci = ci + 1
    T

// _lqm_cube_eq(a, b, n) -> bool
// True iff two cubes of length n are identical.
fn _lqm_cube_eq(a, b, n)
    for i in 0..n
        if a[i] != b[i]
            return false
    true

// _lqm_cube_copy(src, n) -> list
// Returns a copy of cube src of length n.
fn _lqm_cube_copy(src, n)
    let dst = [src[i] for i in 0..n]
    dst

// _lqm_can_merge(a, b, n) -> int
// If cubes a and b differ in exactly one position (both non-don't-care there, identical elsewhere),
// returns that position index. Returns -1 if they cannot be merged.
fn _lqm_can_merge(a, b, n)
    let diff = -1
    for i in 0..n
        let ai = a[i]
        let bi = b[i]
        if ai != bi
            if diff != -1
                return -1
            if ai == 2
                return -1
            if bi == 2
                return -1
            diff = i
    diff

// _lqm_merge(a, pos, n) -> list
// Merge two cubes by setting position pos to don't-care (2) in cube a.
fn _lqm_merge(a, pos, n)
    let c = _lqm_cube_copy(a, n)
    c[pos] = 2
    c

// _lqm_cube_in_list(cube, lst, n) -> bool
// True iff cube already appears in lst (exact match).
fn _lqm_cube_in_list(cube, lst, n)
    let m = len(lst)
    for i in 0..m
        if _lqm_cube_eq(cube, lst[i], n)
            return true
    false

// lqm_prime_implicants(T, n) -> list of cubes
// Computes all prime implicant cubes for the boolean function with truth-table-int T over n vars.
// Empty function T=0 => returns []. Iterative merging until fixpoint.
fn lqm_prime_implicants(T, n)
    let total = 1 << n
    // Collect ON-set minterms as n-literal cubes (each bit position = 0 or 1).
    let cur = []
    for i in 0..total
        if (T >> i) & 1 == 1
            let cube = []
            let b = 0
            while b < n
                push(cube, (i >> b) & 1)
                b = b + 1
            push(cur, cube)
    if len(cur) == 0
        return []
    // Repeatedly merge pairs until no new merges are possible.
    // Cubes never merged in a round are prime implicants.
    let primes = []
    let going = 1
    while going == 1
        let next = []
        let nc = len(cur)
        // used[k] = 1 if cur[k] was merged with some other cube.
        let used = [0 for ui in 0..nc]
        for ai in 0..nc
            let bi = ai + 1
            while bi < nc
                let pos = _lqm_can_merge(cur[ai], cur[bi], n)
                if pos != -1
                    let merged = _lqm_merge(cur[ai], pos, n)
                    if not _lqm_cube_in_list(merged, next, n)
                        push(next, merged)
                    used[ai] = 1
                    used[bi] = 1
                bi = bi + 1
        // Cubes not used in any merge are prime implicants.
        for pi in 0..nc
            if used[pi] == 0
                if not _lqm_cube_in_list(cur[pi], primes, n)
                    push(primes, cur[pi])
        if len(next) == 0
            going = 0
        cur = next
    primes

// lqm_minimize(T, n) -> list of cubes
// Returns a minimal SOP cover for truth-table-int T over n variables using Petrick's method.
// T=0 (constant false) => [] (empty cover). T=all-ones (tautology) => [[2,...,2]].
// For n<=4, brute-force Petrick over the small PI table is exact and deterministic.
fn lqm_minimize(T, n)
    let total = 1 << n
    // Collect ON-set minterm indices.
    let minterms = [i for i in 0..total if (T >> i) & 1 == 1]
    let nm = len(minterms)
    if nm == 0
        return []
    let pis = lqm_prime_implicants(T, n)
    let np = len(pis)
    if np == 0
        return []
    // For each PI, compute which ON-set minterms it covers (as a bitmask over nm minterms).
    let pi_covers = []
    for pi in 0..np
        let mask = 0
        let mi = 0
        while mi < nm
            if lqm_cube_covers(pis[pi], minterms[mi])
                mask = mask | (1 << mi)
            mi = mi + 1
        push(pi_covers, mask)
    let all_covered = (1 << nm) - 1
    // Petrick's method via subset enumeration: find minimum-size subset of PIs
    // whose coverage union = all_covered.
    // For n<=4: np<=8 (in practice fewer), so 2^np <= 256. Enumerate all subsets.
    let best_cover = []
    let best_size = np + 1
    let total_subsets = 1 << np
    for s in 1..total_subsets
        // Compute coverage of this subset of PIs.
        let cov = 0
        let k = 0
        while k < np
            if (s >> k) & 1 == 1
                cov = cov | pi_covers[k]
            k = k + 1
        if cov == all_covered
            // Count bits in s.
            let cnt = 0
            let k2 = 0
            while k2 < np
                cnt = cnt + ((s >> k2) & 1)
                k2 = k2 + 1
            if cnt < best_size
                best_size = cnt
                best_cover = []
                let k3 = 0
                while k3 < np
                    if (s >> k3) & 1 == 1
                        push(best_cover, pis[k3])
                    k3 = k3 + 1
    best_cover
