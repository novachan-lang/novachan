// std/logic/logic_truthtable.nova — truth-table-int representation for boolean functions of n<=4 variables.
// Convention (A): assignment i (0..2^n-1) encodes variable k as bit k of i (bit 0 = LSB).
// The truth table T is an integer where bit i of T = f(assignment i). So T has 2^n bits.
// LEAF — imports NOTHING.

// ltt_var — truth-table-int for variable x_k in an n-variable function (k is 0-based).
// x_k is true exactly at assignments where bit k is 1, i.e. every other block of 2^k assignments.
fn ltt_var(n: int, k: int) -> int
    let size = 1 << n
    let T = 0
    let i = 0
    while i < size
        if ((i >> k) & 1) == 1
            T = T | (1 << i)
        i = i + 1
    T

// ltt_const — truth-table-int for a constant function: v=0 gives all-false, v!=0 gives all-true.
fn ltt_const(n: int, v: int) -> int
    if v == 0
        return 0
    (1 << (1 << n)) - 1

// ltt_eval — evaluate the function at assignment i: returns the i-th bit of T.
fn ltt_eval(T: int, i: int) -> int
    (T >> i) & 1

// ltt_from_values — build truth-table-int from a list vals[i] in {0,1} (length must be 2^n).
fn ltt_from_values(vals: list) -> int
    let T = 0
    let i = 0
    let sz = len(vals)
    while i < sz
        if vals[i] != 0
            T = T | (1 << i)
        i = i + 1
    T

// ltt_to_values — expand truth-table-int T to a list of 2^n bits (index i = value at assignment i).
fn ltt_to_values(T: int, n: int) -> list
    let size = 1 << n
    let vals = []
    let i = 0
    while i < size
        push(vals, (T >> i) & 1)
        i = i + 1
    vals

// ltt_is_tautology — true iff T is all-ones for an n-variable function (true on every assignment).
fn ltt_is_tautology(T: int, n: int) -> bool
    let all = (1 << (1 << n)) - 1
    T == all

// ltt_is_contradiction — true iff T is all-zeros (false on every assignment).
fn ltt_is_contradiction(T: int, n: int) -> bool
    T == 0

// ltt_is_satisfiable — true iff T has at least one satisfying assignment.
fn ltt_is_satisfiable(T: int, n: int) -> bool
    T != 0

// ltt_count_true — count the number of satisfying assignments (popcount over 2^n bits).
fn ltt_count_true(T: int, n: int) -> int
    let size = 1 << n
    let count = 0
    let i = 0
    while i < size
        count = count + ((T >> i) & 1)
        i = i + 1
    count
