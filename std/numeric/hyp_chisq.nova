// ============================================================================
// NOVA Standard Library — std/numeric/hyp_chisq
// ============================================================================
// Chi-squared hypothesis testing statistics.
//
// Public API:
//   chisq_statistic(observed, expected) -> float
//     Pearson chi-squared statistic: sum((o - e)^2 / e) over all categories.
//     observed and expected are lists of floats of equal length.
//     Returns 0.0 if the list is empty.
//
//   chisq_gof(observed) -> float
//     Chi-squared goodness-of-fit test against a uniform distribution.
//     Expected frequency for each category = total / n_categories.
//     Returns 0.0 if observed is empty.
//
// Properties:
//   - Result is always >= 0.0.
//   - Result is 0.0 iff observed == expected exactly (perfect fit).
//   - Larger values indicate greater departure from the null hypothesis.
//
// Implementation notes:
//   Intermediate float results are stored in a dict and read back before
//   arithmetic to ensure proper float unboxing through the any-parameter ABI.
//
// All private helpers are prefixed _cq_ to avoid namespace collisions.

// _cq_sum: sum of all elements in a float list.
fn _cq_sum(data) -> float
    let st = {}
    st["n"] = len(data)
    st["s"] = 0.0
    st["i"] = 0
    while st["i"] < st["n"]
        let _cq_i = st["i"]
        let _cq_v = data[_cq_i] * 1.0
        st["s"] = st["s"] + _cq_v
        st["i"] = _cq_i + 1
    let result = st["s"]
    return result

// chisq_statistic: Pearson chi-squared statistic.
// Chi2 = sum((o_i - e_i)^2 / e_i)
// observed and expected must be lists of equal non-zero length.
// Returns 0.0 for empty input.
fn chisq_statistic(observed, expected) -> float
    let st = {}
    st["n"] = len(observed)
    if st["n"] == 0
        return 0.0
    st["total"] = 0.0
    st["i"] = 0
    while st["i"] < st["n"]
        let _cq_i = st["i"]
        let _cq_o = observed[_cq_i] * 1.0
        let _cq_e = expected[_cq_i] * 1.0
        // (o - e)^2 / e
        let _cq_diff = _cq_o - _cq_e
        let _cq_sq = _cq_diff * _cq_diff
        let _cq_term = _cq_sq / _cq_e
        st["total"] = st["total"] + _cq_term
        st["i"] = _cq_i + 1
    let result = st["total"]
    return result

// chisq_gof: chi-squared goodness-of-fit against uniform expected distribution.
// Expected count for each category = total_observed / n_categories.
// Returns 0.0 for empty input.
fn chisq_gof(observed) -> float
    let st = {}
    st["n"] = len(observed)
    if st["n"] == 0
        return 0.0
    // Compute total observed.
    let _cq_tot0 = _cq_sum(observed)
    st["tot"] = _cq_tot0 * 1.0
    // Expected per category (uniform).
    let _cq_n0 = st["n"]
    let _cq_tot1 = st["tot"]
    st["exp"] = _cq_tot1 / (_cq_n0 * 1.0)
    // Accumulate chi-squared.
    st["total"] = 0.0
    st["i"] = 0
    while st["i"] < st["n"]
        let _cq_i = st["i"]
        let _cq_o = observed[_cq_i] * 1.0
        let _cq_e = st["exp"]
        let _cq_diff = _cq_o - _cq_e
        let _cq_sq = _cq_diff * _cq_diff
        let _cq_term = _cq_sq / _cq_e
        st["total"] = st["total"] + _cq_term
        st["i"] = _cq_i + 1
    let result = st["total"]
    return result
