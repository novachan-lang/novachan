// ============================================================================
// NOVA Standard Library — unit conversion (physical quantities)
// ============================================================================
// Supports LENGTH, MASS, TIME with a single base-unit factor table.
// Temperature (C/F/K) is special-cased with affine formulas.
// All private helpers use the _un_ prefix to avoid collision.
//
// Public API:
//   un_convert(value, from, to) -> float   -- convert value from->to
//   un_factor(unit) -> float               -- base-unit factor (non-temp)
//   un_same_category(a, b) -> bool         -- true iff a and b share a category

// ---------------------------------------------------------------------------
// Internal factor table: returns conversion factor TO the base unit.
// LENGTH base = metre, MASS base = kg, TIME base = second.
// Returns -1.0 for unknown or temperature units (handled separately).
// ---------------------------------------------------------------------------
fn _un_factor_raw(unit)
    // LENGTH (base: m)
    if unit == "m"
        return 1.0
    if unit == "km"
        return 1000.0
    if unit == "cm"
        return 0.01
    if unit == "mm"
        return 0.001
    if unit == "mi"
        return 1609.344
    if unit == "ft"
        return 0.3048
    if unit == "in"
        return 0.0254
    if unit == "yd"
        return 0.9144
    // MASS (base: kg)
    if unit == "kg"
        return 1.0
    if unit == "g"
        return 0.001
    if unit == "mg"
        return 0.000001
    if unit == "lb"
        return 0.45359237
    if unit == "oz"
        return 0.0283495231
    // TIME (base: s)
    if unit == "s"
        return 1.0
    if unit == "min"
        return 60.0
    if unit == "hr"
        return 3600.0
    if unit == "day"
        return 86400.0
    return -1.0

// Internal: return category string for a unit ("length","mass","time","temp","unknown")
fn _un_category(unit)
    if unit == "m"
        return "length"
    if unit == "km"
        return "length"
    if unit == "cm"
        return "length"
    if unit == "mm"
        return "length"
    if unit == "mi"
        return "length"
    if unit == "ft"
        return "length"
    if unit == "in"
        return "length"
    if unit == "yd"
        return "length"
    if unit == "kg"
        return "mass"
    if unit == "g"
        return "mass"
    if unit == "mg"
        return "mass"
    if unit == "lb"
        return "mass"
    if unit == "oz"
        return "mass"
    if unit == "s"
        return "time"
    if unit == "min"
        return "time"
    if unit == "hr"
        return "time"
    if unit == "day"
        return "time"
    if unit == "C"
        return "temp"
    if unit == "F"
        return "temp"
    if unit == "K"
        return "temp"
    return "unknown"

// Internal: convert a Celsius value to the target temperature unit.
fn _un_from_celsius(celsius, to)
    if to == "C"
        return celsius
    if to == "F"
        let f = celsius * 1.8 + 32.0
        return f
    if to == "K"
        let k = celsius + 273.15
        return k
    return celsius

// Internal: convert a temperature from its unit to Celsius.
fn _un_to_celsius(value, from)
    if from == "C"
        return value
    if from == "F"
        let c = (value - 32.0) / 1.8
        return c
    if from == "K"
        let c = value - 273.15
        return c
    return value

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

// un_factor: returns the factor to convert one unit to its base unit.
// Temperature units are not supported (returns -1.0).
fn un_factor(unit)
    let f = _un_factor_raw(unit)
    return f

// un_same_category: true iff both units belong to the same physical category.
fn un_same_category(a, b)
    let ca = _un_category(a)
    let cb = _un_category(b)
    if ca == "unknown"
        return 0
    if cb == "unknown"
        return 0
    if ca == cb
        return 1
    return 0

// un_convert: convert value from unit `from` to unit `to`.
// Returns the converted float. If units are incompatible or unknown, returns 0.0.
fn un_convert(value, from, to)
    let cat = _un_category(from)
    let cat2 = _un_category(to)
    if cat != cat2
        return 0.0
    if cat == "temp"
        let celsius = _un_to_celsius(value, from)
        let result = _un_from_celsius(celsius, to)
        return result
    let ff = _un_factor_raw(from)
    let ft = _un_factor_raw(to)
    if ff < 0.0
        return 0.0
    if ft < 0.0
        return 0.0
    let base = value * ff
    let out = base / ft
    return out
