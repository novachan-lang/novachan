// std/numeric/modint.nova — Modular integer arithmetic.
// All results are in [0, m-1] unless m is 0 or inverse does not exist.
// LEAF — imports NOTHING.
//
// Public API:
//   mi_norm(a, m)       -> int   ((a % m) + m) % m  (canonical representative in [0,m-1])
//   mi_add(a, b, m)     -> int   (a + b) mod m
//   mi_sub(a, b, m)     -> int   (a - b) mod m, result in [0, m-1]
//   mi_mul(a, b, m)     -> int   (a * b) mod m, overflow-safe via binary doubling
//   mi_pow(a, e, m)     -> int   fast modular exponentiation (square-and-multiply); e >= 0
//   mi_inv(a, m)        -> int   modular multiplicative inverse of a mod m via extended Euclid;
//                                returns -1 if gcd(a, m) != 1 (no inverse exists)
//   mi_div(a, b, m)     -> int   a * inv(b) mod m; returns -1 if inv(b) does not exist
//
// OVERFLOW SAFETY: mi_mul uses binary-doubling so no intermediate product exceeds 2*m.
// This is correct for any modulus up to ~2^62. mi_pow builds on mi_mul.
// mi_add / mi_sub operate on inputs already reduced mod m so no overflow.
//
// PRIVATE helper prefix: _mi_

// _mi_norm_raw — bring x into [0, m-1] by one conditional add.
// Assumes x is in [-(m-1), 2*(m-1)] which is the range produced by the
// arithmetic helpers below.
fn _mi_norm_raw(x: int, m: int) -> int
    let r = x % m
    if r < 0
        r = r + m
    r

// mi_norm — canonical representative: ((a % m) + m) % m.
// Works for any signed integer a.
fn mi_norm(a: int, m: int) -> int
    _mi_norm_raw(a, m)

// mi_add — (a + b) mod m.  a and b may be any integers; result in [0, m-1].
fn mi_add(a: int, b: int, m: int) -> int
    let na = _mi_norm_raw(a, m)
    let nb = _mi_norm_raw(b, m)
    let s = na + nb
    if s >= m
        s = s - m
    s

// mi_sub — (a - b) mod m, result in [0, m-1].
fn mi_sub(a: int, b: int, m: int) -> int
    let na = _mi_norm_raw(a, m)
    let nb = _mi_norm_raw(b, m)
    let d = na - nb
    if d < 0
        d = d + m
    d

// _mi_mulmod — (a * b) mod m via binary doubling.  Safe for m up to ~2^62.
// Both a and b must already be in [0, m-1].
fn _mi_mulmod(a: int, b: int, m: int) -> int
    let result = 0
    let x = a
    let y = b
    while y > 0
        if (y & 1) == 1
            result = (result + x) % m
        x = (x + x) % m
        y = y / 2
    result

// mi_mul — (a * b) mod m.  a and b may be any integers; result in [0, m-1].
fn mi_mul(a: int, b: int, m: int) -> int
    let na = _mi_norm_raw(a, m)
    let nb = _mi_norm_raw(b, m)
    _mi_mulmod(na, nb, m)

// mi_pow — a^e mod m via square-and-multiply.  e must be >= 0.
// Returns 1 when e == 0 (including 0^0 = 1 by convention). m=1 returns 0.
fn mi_pow(a: int, e: int, m: int) -> int
    if m == 1
        return 0
    let base = _mi_norm_raw(a, m)
    let exp = e
    let result = 1
    while exp > 0
        if (exp & 1) == 1
            result = _mi_mulmod(result, base, m)
        base = _mi_mulmod(base, base, m)
        exp = exp / 2
    result

// _mi_egcd — extended Euclidean algorithm.
// Returns list [g, x, y] such that a*x + b*y == g == gcd(a, b).
// Uses iterative form (no recursion) to avoid stack depth issues.
fn _mi_egcd(a: int, b: int) -> list
    let old_r = a
    let r = b
    let old_s = 1
    let s = 0
    let old_t = 0
    let t = 1
    while r != 0
        let q = old_r / r
        let tmp_r = old_r - q * r
        let tmp_s = old_s - q * s
        let tmp_t = old_t - q * t
        old_r = r
        r = tmp_r
        old_s = s
        s = tmp_s
        old_t = t
        t = tmp_t
    let res = []
    res.push(old_r)
    res.push(old_s)
    res.push(old_t)
    res

// mi_inv — modular multiplicative inverse of a mod m via extended Euclid.
// Returns -1 if gcd(a, m) != 1 (inverse does not exist).
fn mi_inv(a: int, m: int) -> int
    let na = _mi_norm_raw(a, m)
    let eg = _mi_egcd(na, m)
    let g = eg[0]
    if g != 1
        return -1
    let x = eg[1]
    _mi_norm_raw(x, m)

// mi_div — a * inv(b) mod m.
// Returns -1 if the inverse of b mod m does not exist (gcd(b, m) != 1).
fn mi_div(a: int, b: int, m: int) -> int
    let inv_b = mi_inv(b, m)
    if inv_b == -1
        return -1
    mi_mul(a, inv_b, m)
