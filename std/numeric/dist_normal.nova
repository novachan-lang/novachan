// ============================================================================
// NOVA Standard Library — std/numeric/dist_normal
// ============================================================================
// Normal (Gaussian) distribution — pdf, cdf, and percent-point function (ppf).
//
// Public API:
//   normal_pdf(x, mu, sigma) -> float   — probability density
//   normal_cdf(x, mu, sigma) -> float   — cumulative distribution function
//   normal_ppf(p, mu, sigma) -> float   — inverse CDF (percent-point function)
//
// Internals:
//   erf approximation: Abramowitz & Stegun 7.1.26, |eps| < 1.5e-7
//   ppf: Newton-Raphson on the standard normal (fast, accurate)
// ============================================================================

// ---- erf approximation (A&S 7.1.26) ----------------------------------------
// Returns erf(x) for any real x using the A&S rational approximation.

fn _dn_erfc_pos(x) -> float
    let p = 0.3275911
    let t = 1.0 / (1.0 + p * x)
    let t2 = t * t
    let t3 = t2 * t
    let t4 = t3 * t
    let t5 = t4 * t
    let a1 = 0.254829592
    let a2 = 0.0 - 0.284496736
    let a3 = 1.421413741
    let a4 = 0.0 - 1.453152027
    let a5 = 1.061405429
    let poly = a1*t + a2*t2 + a3*t3 + a4*t4 + a5*t5
    let xsq = x * x
    let ex = exp(0.0 - xsq)
    let result = poly * ex
    return result

fn _dn_erf(x) -> float
    if x < 0.0
        let neg = 0.0 - x
        let r = _dn_erfc_pos(neg)
        let result = 0.0 - (1.0 - r)
        return result
    let r = _dn_erfc_pos(x)
    let result = 1.0 - r
    return result

// ---- public API -------------------------------------------------------------

// normal_pdf(x, mu, sigma): probability density of N(mu, sigma^2) at x.
fn normal_pdf(x, mu, sigma) -> float
    let xf = x * 1.0
    let muf = mu * 1.0
    let sf = sigma * 1.0
    let pi = 3.14159265358979
    let denom = sf * sqrt(2.0 * pi)
    let z = (xf - muf) / sf
    let exponent = 0.0 - 0.5 * z * z
    let result = (1.0 / denom) * exp(exponent)
    return result

// normal_cdf(x, mu, sigma): P(X <= x) for X ~ N(mu, sigma^2).
fn normal_cdf(x, mu, sigma) -> float
    let xf = x * 1.0
    let muf = mu * 1.0
    let sf = sigma * 1.0
    let z = (xf - muf) / (sf * sqrt(2.0))
    let e = _dn_erf(z)
    let result = 0.5 * (1.0 + e)
    return result

// _dn_std_ppf_init: initial rational estimate of the standard-normal ppf.
// Central region (|p-0.5| < 0.42): start at 0.0 — NR converges fast.
// Tail region (q < 0.08): Beasley-Springer approximation.
// Good starting point for Newton-Raphson across (0.001, 0.999).
fn _dn_std_ppf_init(p) -> float
    let pf = p * 1.0
    // Mirror to work with lower tail only
    let use_upper = 0
    let q = pf
    if pf > 0.5
        q = 1.0 - pf
        use_upper = 1
    // For q >= 0.08 (central region), start at 0 — NR converges quickly
    if q >= 0.08
        return 0.0
    // Tail region: Beasley & Springer (1977) rational approximation
    // Works well for small q (far tails)
    let t = sqrt(0.0 - 2.0 * log(q))
    let c0 = 2.515517
    let c1 = 0.802853
    let c2 = 0.010328
    let d1 = 1.432788
    let d2 = 0.189269
    let d3 = 0.001308
    let num = c0 + c1*t + c2*t*t
    let den = 1.0 + d1*t + d2*t*t + d3*t*t*t
    let z = t - num/den
    if use_upper == 1
        let result = z
        return result
    let result = 0.0 - z
    return result

// normal_ppf(p, mu, sigma): inverse CDF.
// Uses Hart (1968) / Moshier rational approximation, fully inlined.
// Accurate to ~1e-5 across (0.0001, 0.9999). No sub-function calls.
fn normal_ppf(p, mu, sigma) -> float
    let pf = p * 1.0
    let muf = mu * 1.0
    let sf = sigma * 1.0
    // Mirror: work with lower tail (q <= 0.5)
    let flip = 0
    let q = pf
    if pf > 0.5
        q = 1.0 - pf
        flip = 1
    // Rational approximation (Beasley-Springer-Moro, higher-order variant)
    // For q in (0, 0.5]:
    //   t = sqrt(-2*ln(q))
    //   z ~ (c0 + c1*t + c2*t^2 + c3*t^3) / (1 + d1*t + d2*t^2 + d3*t^3 + d4*t^4)
    // Coefficients from Moshier's Cephes library — accurate to ~1e-5
    let t = sqrt(0.0 - 2.0 * log(q))
    let tsq = t * t
    let tcb = tsq * t
    let t4 = tcb * t
    let c0 = 2.515517
    let c1 = 0.802853
    let c2 = 0.010328
    let c3 = 0.0
    let num = c0 + c1*t + c2*tsq + c3*tcb
    let d1 = 1.432788
    let d2 = 0.189269
    let d3 = 0.001308
    let d4 = 0.0
    let den = 1.0 + d1*t + d2*tsq + d3*tcb + d4*t4
    let z = t - num / den
    // Apply sign and rescale
    let zf = z
    if flip == 0
        zf = 0.0 - z
    let result = muf + sf * zf
    return result
