// ============================================================================
// NOVA Standard Library — std/numeric/integrate
// ============================================================================
// Numerical integration of sampled data (uniformly spaced).
//
// Public API:
//   trapezoid(y_values, dx)  -> float  composite trapezoidal rule on sampled values
//   simpson(y_values, dx)    -> float  composite Simpson's 1/3 rule on sampled values
//
// Both functions take a list of y-values sampled at uniformly spaced x-points
// with spacing dx, and return the approximate integral.
//
// trapezoid:
//   Approximates the integral using the trapezoidal rule between adjacent samples.
//   Error is O(h^2) per interval.
//   Formula: dx * (y[0]/2 + y[1] + y[2] + ... + y[n-2] + y[n-1]/2)
//
// simpson:
//   Composite Simpson's 1/3 rule; requires an ODD number of sample points
//   (i.e. an EVEN number of subintervals).  If the list has an even number of
//   points (odd number of intervals), the last interval is handled with the
//   trapezoid rule (extended Simpson).  Error is O(h^4) per interval.
//   Formula for n+1 points (n even):
//     (dx/3) * [y[0] + 4y[1] + 2y[2] + 4y[3] + ... + 4y[n-1] + y[n]]
//
// All private helpers prefixed _ig_ to avoid namespace collisions.
// ============================================================================

// _ig_fabs — float absolute value
fn _ig_fabs(v) -> float
    let r = v * 1.0
    if v < 0.0
        r = 0.0 - v
    return r

// trapezoid — composite trapezoidal rule on uniformly spaced sampled values.
// y_values: list of n floats; dx: spacing between adjacent samples (float).
// Returns integral approximation.
fn trapezoid(y_values, dx) -> float
    let n = len(y_values)
    if n < 2
        return 0.0
    let dxf = dx * 1.0
    // Sum interior points (weight 1 each), endpoints weight 1/2
    let sum = y_values[0] * 1.0 / 2.0 + y_values[n - 1] * 1.0 / 2.0
    for i in 1..(n - 1)
        sum += y_values[i] * 1.0
    let result = dxf * sum
    return result

// simpson — composite Simpson's 1/3 rule on uniformly spaced sampled values.
// y_values: list of floats; dx: uniform spacing.
// Number of points should be odd (even number of subintervals).
// If even number of points, the last interval falls back to trapezoid rule.
fn simpson(y_values, dx) -> float
    let n = len(y_values)
    if n < 2
        return 0.0
    if n == 2
        // Only two points — fall back to trapezoid
        let dxf2 = dx * 1.0
        let sum2 = (y_values[0] * 1.0 + y_values[1] * 1.0) / 2.0
        return dxf2 * sum2
    let dxf = dx * 1.0
    // Determine how many COMPLETE pairs of subintervals (2 intervals at a time).
    // We process pairs [0,1,2], [2,3,4], etc.
    // Each pair covers 2 subintervals and uses Simpson's rule.
    let num_intervals = n - 1
    // Number of pairs: floor((n-1)/2)
    let num_pairs = num_intervals / 2
    let sum = 0.0
    for pair in 0..num_pairs
        let base = pair * 2
        let y0 = y_values[base] * 1.0
        let y1 = y_values[base + 1] * 1.0
        let y2 = y_values[base + 2] * 1.0
        sum += (dxf / 3.0) * (y0 + 4.0 * y1 + y2)
    // If n is even (odd number of intervals), there's a leftover last interval.
    // Handle it with the trapezoid rule.
    let remainder = num_intervals - num_pairs * 2
    if remainder != 0
        let last = n - 1
        let y_last0 = y_values[last - 1] * 1.0
        let y_last1 = y_values[last] * 1.0
        sum += dxf * (y_last0 + y_last1) / 2.0
    return sum

fn main()
    print("integrate module OK")
