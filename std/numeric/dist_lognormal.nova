// ============================================================================
// NOVA Standard Library — std/numeric/dist_lognormal
// ============================================================================
// Log-normal distribution: if ln(X) ~ Normal(mu, sigma^2) then X ~ Lognormal.
// X > 0; parameterized by location mu (log-space mean) and scale sigma > 0.
//
// PDF: lognorm_pdf(x, mu, sigma) =
//        (1/(x*sigma*sqrt(2*pi))) * exp(-0.5*((ln(x)-mu)/sigma)^2)   x > 0
//        0.0                                                            x <= 0
//
// CDF: lognorm_cdf(x, mu, sigma) = normal_cdf((ln(x)-mu)/sigma)      x > 0
//      where normal_cdf is the standard normal CDF (inline erf via A&S 7.1.26)
//
// Mean: lognorm_mean(mu, sigma) = exp(mu + sigma^2/2)
//
// Public API:
//   lognorm_pdf(x, mu, sigma)    -> float
//   lognorm_cdf(x, mu, sigma)    -> float
//   lognorm_mean(mu, sigma)      -> float
//
// Private helpers prefixed _ln_.
// ============================================================================

// ---- Inlined erf via Abramowitz & Stegun 7.1.26 ---- //
// |eps| < 1.5e-7 for all x

fn _ln_erf_p() -> float
    return 0.3275911

fn _ln_erf_a1() -> float
    return 0.254829592

fn _ln_erf_a2() -> float
    return 0.0 - 0.284496736

fn _ln_erf_a3() -> float
    return 1.421413741

fn _ln_erf_a4() -> float
    return 0.0 - 1.453152027

fn _ln_erf_a5() -> float
    return 1.061405429

// erfc(x) for x >= 0 via A&S 7.1.26
fn _ln_erfc_pos(x) -> float
    let xf = x * 1.0
    let t = 1.0 / (1.0 + _ln_erf_p() * xf)
    let t2 = t * t
    let t3 = t2 * t
    let t4 = t3 * t
    let t5 = t4 * t
    let poly = _ln_erf_a1()*t + _ln_erf_a2()*t2 + _ln_erf_a3()*t3 + _ln_erf_a4()*t4 + _ln_erf_a5()*t5
    let xsq = xf * xf
    let ex_raw = exp(0.0 - xsq)
    let ex = pow(ex_raw, 1.0)
    let result = poly * ex
    return result

// erf(x) for all real x
fn _ln_erf(x) -> float
    let xf = x * 1.0
    if xf < 0.0
        let neg = 0.0 - xf
        let r = _ln_erfc_pos(neg)
        // erfc(-x) = 2 - erfc(x), erf(-x) = 1 - erfc(-x) = 1 - (2-erfc(x)) = erfc(x)-1
        let result = r - 1.0
        return result
    let ec = _ln_erfc_pos(xf)
    let result = 1.0 - ec
    return result

// normal_cdf(z) = 0.5*(1+erf(z/sqrt(2)))
fn _ln_normal_cdf(z) -> float
    let zf = z * 1.0
    let sq2_raw = sqrt(2.0)
    let sq2 = pow(sq2_raw, 1.0)
    let arg = zf / sq2
    let ef = _ln_erf(arg)
    let result = 0.5 * (1.0 + ef)
    return result

// ---- Log-normal distribution ---- //

// lognorm_pdf(x, mu, sigma): PDF of Lognormal(mu, sigma) at x.
// Returns 0.0 for x <= 0.
fn lognorm_pdf(x, mu, sigma) -> float
    let xf = x * 1.0
    let muf = mu * 1.0
    let sf = sigma * 1.0
    if xf <= 0.0
        return 0.0
    let pi = 3.14159265358979
    // Compute (ln(x) - mu) / sigma
    let lx_raw = log(xf)
    let lx = pow(lx_raw, 1.0)
    let diff = lx - muf
    let z = diff / sf
    // Exponent: -0.5 * z^2
    let zsq = z * z
    let neg_half_zsq = 0.0 - 0.5 * zsq
    let exp_raw = exp(neg_half_zsq)
    let expv = pow(exp_raw, 1.0)
    // Denominator: x * sigma * sqrt(2*pi)
    let twopi = 2.0 * pi
    let sq2pi_raw = sqrt(twopi)
    let sq2pi = pow(sq2pi_raw, 1.0)
    let denom = xf * sf * sq2pi
    let result = expv / denom
    return result

// lognorm_cdf(x, mu, sigma): CDF of Lognormal(mu, sigma) at x.
// CDF = normal_cdf((ln(x)-mu)/sigma). Returns 0.0 for x <= 0.
fn lognorm_cdf(x, mu, sigma) -> float
    let xf = x * 1.0
    let muf = mu * 1.0
    let sf = sigma * 1.0
    if xf <= 0.0
        return 0.0
    let lx_raw = log(xf)
    let lx = pow(lx_raw, 1.0)
    let diff = lx - muf
    let z = diff / sf
    let result = _ln_normal_cdf(z)
    return result

// lognorm_mean(mu, sigma): mean of Lognormal(mu, sigma) = exp(mu + sigma^2/2).
fn lognorm_mean(mu, sigma) -> float
    let muf = mu * 1.0
    let sf = sigma * 1.0
    let ssq = sf * sf
    let arg = muf + ssq / 2.0
    let result_raw = exp(arg)
    let result = pow(result_raw, 1.0)
    return result
