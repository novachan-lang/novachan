// ============================================================================
// NOVA Standard Library — std/numeric/hyp_anova
// ============================================================================
// One-way Analysis of Variance (ANOVA) F-statistic.
//
// Public API:
//   anova_f(groups) -> float
//     Compute the one-way ANOVA F-statistic for k groups.
//     groups is a list of lists, each inner list containing float observations.
//     F = MSB / MSW  where:
//       MSB = SSB / (k - 1)       (between-group mean square)
//       MSW = SSW / (N - k)       (within-group mean square)
//       SSB = sum_g(n_g * (mean_g - grand_mean)^2)
//       SSW = sum_g(sum_i((x_gi - mean_g)^2))
//       N   = total number of observations across all groups
//       k   = number of groups
//     Returns 0.0 when:
//       - fewer than 2 groups
//       - MSW == 0.0 (all values within groups identical — single-value groups
//         have zero within-group variance; guard against divide-by-zero)
//       - fewer than k+1 total observations (denom df = N-k <= 0)
//
// Implementation notes:
//   Intermediate float results stored in dict before use (any-ABI float fix).
//   Group means are computed and stored in a parallel list via index.
//   Loops kept in dict to avoid NOVA LLVM-label variable-reassignment bug.
//
// All private helpers are prefixed _av_ to avoid namespace collisions.

// _av_group_mean: compute mean of a single float list (a group).
fn _av_group_mean(grp) -> float
    let st = {}
    st["n"] = len(grp)
    if st["n"] == 0
        return 0.0
    st["s"] = 0.0
    st["i"] = 0
    while st["i"] < st["n"]
        let _av_i = st["i"]
        let _av_v = grp[_av_i] * 1.0
        st["s"] = st["s"] + _av_v
        st["i"] = _av_i + 1
    let _av_n = st["n"]
    let _av_s = st["s"]
    let result = _av_s / (_av_n * 1.0)
    return result

// anova_f: one-way ANOVA F-statistic.
fn anova_f(groups) -> float
    let st = {}
    st["k"] = len(groups)
    if st["k"] < 2
        return 0.0
    let _av_k = st["k"]
    // --- Pass 1: compute per-group means and sizes, accumulate grand total ---
    // Store group means in a list (indexed by group id).
    // Store group sizes in a list.
    let means = []
    let sizes = []
    st["N"] = 0
    st["grand_sum"] = 0.0
    st["gi"] = 0
    while st["gi"] < st["k"]
        let _av_gi = st["gi"]
        let _av_grp = groups[_av_gi]
        let _av_ng = len(_av_grp)
        push(sizes, _av_ng)
        st["N"] = st["N"] + _av_ng
        let _av_mg0 = _av_group_mean(_av_grp)
        // Store mean via dict round-trip to ensure float unboxing.
        st["tmp_mg"] = _av_mg0 * 1.0
        let _av_mg1 = st["tmp_mg"]
        push(means, _av_mg1)
        // Accumulate grand total for grand mean.
        let _av_ng_f = _av_ng * 1.0
        st["grand_sum"] = st["grand_sum"] + _av_mg1 * _av_ng_f
        st["gi"] = _av_gi + 1
    // Check enough total observations.
    let _av_N = st["N"]
    let _av_dfw = _av_N - _av_k
    if _av_dfw <= 0
        return 0.0
    // Grand mean = grand_sum / N
    let _av_gs = st["grand_sum"]
    st["grand_mean"] = _av_gs / (_av_N * 1.0)
    // --- Pass 2: compute SSB (between-group sum of squares) ---
    // SSB = sum_g( n_g * (mean_g - grand_mean)^2 )
    st["SSB"] = 0.0
    st["gi"] = 0
    while st["gi"] < st["k"]
        let _av_gi = st["gi"]
        let _av_ng = sizes[_av_gi]
        let _av_mg = means[_av_gi] * 1.0
        let _av_gm = st["grand_mean"]
        let _av_d = _av_mg - _av_gm
        let _av_ng_f = _av_ng * 1.0
        st["SSB"] = st["SSB"] + _av_ng_f * (_av_d * _av_d)
        st["gi"] = _av_gi + 1
    // --- Pass 3: compute SSW (within-group sum of squares) ---
    // SSW = sum_g( sum_i( (x_gi - mean_g)^2 ) )
    st["SSW"] = 0.0
    st["gi"] = 0
    while st["gi"] < st["k"]
        let _av_gi = st["gi"]
        let _av_grp = groups[_av_gi]
        let _av_mg = means[_av_gi] * 1.0
        let _av_ng = len(_av_grp)
        st["ii"] = 0
        while st["ii"] < _av_ng
            let _av_ii = st["ii"]
            let _av_x = _av_grp[_av_ii] * 1.0
            let _av_d2 = _av_x - _av_mg
            st["SSW"] = st["SSW"] + _av_d2 * _av_d2
            st["ii"] = _av_ii + 1
        st["gi"] = _av_gi + 1
    // --- Compute F = MSB / MSW ---
    let _av_dfb = (_av_k - 1) * 1.0
    let _av_dfw_f = _av_dfw * 1.0
    let _av_SSB = st["SSB"]
    let _av_SSW = st["SSW"]
    let _av_MSB = _av_SSB / _av_dfb
    let _av_MSW = _av_SSW / _av_dfw_f
    // Guard: if MSW == 0.0 (e.g. single-element groups with identical values),
    // return 0.0 to avoid divide-by-zero.
    if _av_MSW == 0.0
        return 0.0
    let result = _av_MSB / _av_MSW
    return result
