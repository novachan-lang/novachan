// ============================================================================
// NOVA Standard Library — matrixx module
// ============================================================================
// Dense integer linear algebra. Closes gap cat-11/Collections: matrices.
//
// Representation:
//   A matrix is a list of row-lists of ints, stored row-major:
//     [[a00, a01, a02],
//      [a10, a11, a12]]
//   is a 2 x 3 matrix. Element (i, j) is m[i][j]. We assume well-formed,
//   rectangular input (every row has the same length).
//
// Construction style:
//   NOVA has no verified in-place list-element assignment (xs[i] = v is NOT
//   supported for lists). Every matrix is therefore built by REBUILD:
//     row = row + [val]        // grow a row one element at a time
//     out = out + [row]        // append a finished row
//   This is the only verified-safe way to assemble nested lists and is what
//   every function below uses.
//
// Public API:
//   mat_zeros(r, c)   -> r x c matrix of 0
//   mat_identity(n)   -> n x n identity (1 on the diagonal, 0 elsewhere)
//   mat_rows(m)       -> number of rows (int)
//   mat_cols(m)       -> number of columns (int)
//   mat_get(m, i, j)  -> element at (i, j) (int)
//   mat_transpose(m)  -> m^T
//   mat_add(a, b)     -> element-wise sum (a and b same shape)
//   mat_mul(a, b)     -> matrix product (a is r x k, b is k x c -> r x c)

// ── shape accessors ─────────────────────────────────────────────────────────

// Number of rows is simply the outer list length.
fn mat_rows(m) -> int
    len(m)

// Number of columns is the length of the first row. For a zero-row matrix
// there are no rows to measure, so the column count is 0 by convention.
fn mat_cols(m) -> int
    if len(m) == 0
        return 0
    len(m[0])

// Element read. Assumes 0 <= i < rows and 0 <= j < cols (well-formed input).
fn mat_get(m, i, j) -> int
    m[i][j]

// ── constructors ────────────────────────────────────────────────────────────

// r x c matrix filled with 0. Built row by row via rebuild.
fn mat_zeros(r, c)
    let out = []
    let i = 0
    while i < r
        let row = []
        let j = 0
        while j < c
            row = row + [0]
            j = j + 1
        out = out + [row]
        i = i + 1
    out

// n x n identity matrix: 1 on the diagonal (i == j), 0 elsewhere.
fn mat_identity(n)
    let out = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            if i == j
                row = row + [1]
            else
                row = row + [0]
            j = j + 1
        out = out + [row]
        i = i + 1
    out

// ── transforms ──────────────────────────────────────────────────────────────

// Transpose: result[j][i] = m[i][j]. An r x c matrix becomes c x r.
// We iterate the OUTPUT in row-major order (j outer, i inner) so each output
// row is built contiguously by rebuild.
fn mat_transpose(m)
    let r = mat_rows(m)
    let c = mat_cols(m)
    let out = []
    let j = 0
    while j < c
        let row = []
        let i = 0
        while i < r
            row = row + [m[i][j]]
            i = i + 1
        out = out + [row]
        j = j + 1
    out

// Element-wise sum. a and b must share the same shape (r x c).
fn mat_add(a, b)
    let r = mat_rows(a)
    let c = mat_cols(a)
    let out = []
    let i = 0
    while i < r
        let row = []
        let j = 0
        while j < c
            row = row + [a[i][j] + b[i][j]]
            j = j + 1
        out = out + [row]
        i = i + 1
    out

// Matrix product C = A * B where A is r x k and B is k x c, giving r x c.
//   C[i][j] = sum over p of A[i][p] * B[p][j]
fn mat_mul(a, b)
    let r = mat_rows(a)
    let k = mat_cols(a)
    let c = mat_cols(b)
    let out = []
    let i = 0
    while i < r
        let row = []
        let j = 0
        while j < c
            let sum = 0
            let p = 0
            while p < k
                sum = sum + a[i][p] * b[p][j]
                p = p + 1
            row = row + [sum]
            j = j + 1
        out = out + [row]
        i = i + 1
    out

// ── tests ────────────────────────────────────────────────────────────────────

fn main()
    // ---- mat_zeros: shape and all-zero contents ----
    let z = mat_zeros(2, 3)
    assert_eq(mat_rows(z), 2)
    assert_eq(mat_cols(z), 3)
    let zi = 0
    while zi < 2
        let zj = 0
        while zj < 3
            assert_eq(mat_get(z, zi, zj), 0)
            zj = zj + 1
        zi = zi + 1
    // a single-element zero matrix
    let z1 = mat_zeros(1, 1)
    assert_eq(mat_rows(z1), 1)
    assert_eq(mat_cols(z1), 1)
    assert_eq(mat_get(z1, 0, 0), 0)
    // a degenerate 0 x 0 matrix: no rows, zero columns by convention
    let z0 = mat_zeros(0, 0)
    assert_eq(mat_rows(z0), 0)
    assert_eq(mat_cols(z0), 0)

    // ---- mat_identity: 1s on the diagonal, 0s off the diagonal ----
    let id = mat_identity(3)
    assert_eq(mat_rows(id), 3)
    assert_eq(mat_cols(id), 3)
    let di = 0
    while di < 3
        let dj = 0
        while dj < 3
            if di == dj
                assert_eq(mat_get(id, di, dj), 1)
            else
                assert_eq(mat_get(id, di, dj), 0)
            dj = dj + 1
        di = di + 1
    // identity edge cases
    let id1 = mat_identity(1)
    assert_eq(mat_rows(id1), 1)
    assert_eq(mat_cols(id1), 1)
    assert_eq(mat_get(id1, 0, 0), 1)

    // ---- mat_rows / mat_cols on a literal ----
    let m23 = [[1, 2, 3], [4, 5, 6]]
    assert_eq(mat_rows(m23), 2)
    assert_eq(mat_cols(m23), 3)
    assert_eq(mat_get(m23, 0, 0), 1)
    assert_eq(mat_get(m23, 1, 2), 6)
    assert_eq(mat_get(m23, 0, 2), 3)
    assert_eq(mat_get(m23, 1, 0), 4)

    // ---- mat_transpose: [[1,2,3],[4,5,6]] -> [[1,4],[2,5],[3,6]] ----
    let t = mat_transpose(m23)
    assert_eq(mat_rows(t), 3)
    assert_eq(mat_cols(t), 2)
    assert_eq(mat_get(t, 0, 0), 1)
    assert_eq(mat_get(t, 0, 1), 4)
    assert_eq(mat_get(t, 1, 0), 2)
    assert_eq(mat_get(t, 1, 1), 5)
    assert_eq(mat_get(t, 2, 0), 3)
    assert_eq(mat_get(t, 2, 1), 6)
    // transpose of the transpose is the original
    let tt = mat_transpose(t)
    assert_eq(mat_rows(tt), 2)
    assert_eq(mat_cols(tt), 3)
    let ti = 0
    while ti < 2
        let tj = 0
        while tj < 3
            assert_eq(mat_get(tt, ti, tj), mat_get(m23, ti, tj))
            tj = tj + 1
        ti = ti + 1
    // transpose with negatives
    let tn = mat_transpose([[-1, 2], [3, -4]])
    assert_eq(mat_get(tn, 0, 0), -1)
    assert_eq(mat_get(tn, 0, 1), 3)
    assert_eq(mat_get(tn, 1, 0), 2)
    assert_eq(mat_get(tn, 1, 1), -4)

    // ---- mat_add: [[1,2],[3,4]] + [[5,6],[7,8]] = [[6,8],[10,12]] ----
    let s = mat_add([[1, 2], [3, 4]], [[5, 6], [7, 8]])
    assert_eq(mat_get(s, 0, 0), 6)
    assert_eq(mat_get(s, 0, 1), 8)
    assert_eq(mat_get(s, 1, 0), 10)
    assert_eq(mat_get(s, 1, 1), 12)
    // adding the zero matrix is the identity for addition
    let sz = mat_add(m23, mat_zeros(2, 3))
    let si = 0
    while si < 2
        let sj = 0
        while sj < 3
            assert_eq(mat_get(sz, si, sj), mat_get(m23, si, sj))
            sj = sj + 1
        si = si + 1
    // addition with negatives cancels to zero
    let sneg = mat_add([[5, -3], [0, 7]], [[-5, 3], [0, -7]])
    assert_eq(mat_get(sneg, 0, 0), 0)
    assert_eq(mat_get(sneg, 0, 1), 0)
    assert_eq(mat_get(sneg, 1, 0), 0)
    assert_eq(mat_get(sneg, 1, 1), 0)

    // ---- mat_mul: [[1,2],[3,4]] * [[5,6],[7,8]] = [[19,22],[43,50]] ----
    let p = mat_mul([[1, 2], [3, 4]], [[5, 6], [7, 8]])
    assert_eq(mat_rows(p), 2)
    assert_eq(mat_cols(p), 2)
    assert_eq(mat_get(p, 0, 0), 19)
    assert_eq(mat_get(p, 0, 1), 22)
    assert_eq(mat_get(p, 1, 0), 43)
    assert_eq(mat_get(p, 1, 1), 50)

    // ---- mat_mul: right-multiplying by identity returns the original ----
    let m = [[1, 2], [3, 4]]
    let mi = mat_mul(m, mat_identity(2))
    assert_eq(mat_rows(mi), 2)
    assert_eq(mat_cols(mi), 2)
    let mri = 0
    while mri < 2
        let mci = 0
        while mci < 2
            assert_eq(mat_get(mi, mri, mci), mat_get(m, mri, mci))
            mci = mci + 1
        mri = mri + 1
    // left-multiplying by identity also returns the original
    let im = mat_mul(mat_identity(2), m)
    let li = 0
    while li < 2
        let lj = 0
        while lj < 2
            assert_eq(mat_get(im, li, lj), mat_get(m, li, lj))
            lj = lj + 1
        li = li + 1

    // ---- mat_mul: non-square product (2x3 * 3x2 -> 2x2) ----
    // A = [[1,2,3],[4,5,6]], B = [[7,8],[9,10],[11,12]]
    // AB = [[58,64],[139,154]]
    let nsa = [[1, 2, 3], [4, 5, 6]]
    let nsb = [[7, 8], [9, 10], [11, 12]]
    let ns = mat_mul(nsa, nsb)
    assert_eq(mat_rows(ns), 2)
    assert_eq(mat_cols(ns), 2)
    assert_eq(mat_get(ns, 0, 0), 58)
    assert_eq(mat_get(ns, 0, 1), 64)
    assert_eq(mat_get(ns, 1, 0), 139)
    assert_eq(mat_get(ns, 1, 1), 154)

    // ---- mat_mul: 1x1 scalar-like product ----
    let one = mat_mul([[3]], [[4]])
    assert_eq(mat_rows(one), 1)
    assert_eq(mat_cols(one), 1)
    assert_eq(mat_get(one, 0, 0), 12)

    // ---- mat_mul with negatives ----
    let neg = mat_mul([[-1, 2], [3, -4]], [[1, 1], [1, 1]])
    assert_eq(mat_get(neg, 0, 0), 1)
    assert_eq(mat_get(neg, 0, 1), 1)
    assert_eq(mat_get(neg, 1, 0), -1)
    assert_eq(mat_get(neg, 1, 1), -1)

    print("matrixx_test passed")
