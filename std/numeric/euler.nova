// ============================================================================
// NOVA Standard Library — std/numeric/euler
// ============================================================================
// Euler's method for solving first-order ODEs of the form dy/dt = f(t, y).
//
// Given an initial condition y(t0) = y0, a step size h, and a number of steps,
// Euler's method approximates the solution by the recurrence:
//   t_{n+1} = t_n + h
//   y_{n+1} = y_n + h * f(t_n, y_n)
//
// This is a first-order method: global error is O(h). Use with small h for
// accuracy, or use a higher-order method (e.g. Runge-Kutta) when accuracy
// is critical.
//
// Public API (prefix eu_):
//
//   eu_solve(f, t0, y0, h, steps) -> list
//     Solve dy/dt = f(t, y) with y(t0) = y0 using `steps` Euler steps of
//     size h. Returns a list of (steps+1) pairs, where each pair is a
//     two-element list [t, y]. The first pair is [t0, y0].
//     f must be a named fn(t: float, y: float) -> float.
//
//   eu_final(f, t0, y0, h, steps) -> float
//     Like eu_solve but returns only the final y value, without allocating
//     the full trajectory. Cheaper when only the endpoint is needed.
//     f must be a named fn(t: float, y: float) -> float.
//
// NOVA HOF calling-convention note:
//   When a function is passed as a first-class value and called inside a loop,
//   its float return arrives as a raw i64 bit-pattern (IEEE 754 reinterpret).
//   Similarly, floats read back from an 'any'-typed dict are boxed pointers.
//   The correct fix (from trapezoid.nova) is to pass values through
//   pow(x, 1.0) which invokes nova_float_arg (i2f bit-reinterpret) internally,
//   converting both boxed floats and raw bit-patterns to proper doubles.
//   Applied to: dict reads before passing to f, and f's return value.
//
// All private helpers are prefixed _eu_ to avoid namespace collisions.
// ============================================================================

// _eu_unbox: normalize a float value that may be a boxed dict-read or HOF return.
// pow(x, 1.0) uses nova_float_arg which performs an i2f bit-reinterpret, correctly
// handling both direct float values and raw i64 bit-patterns.
fn _eu_unbox(x) -> float
    let r = pow(x, 1.0)
    return r

// eu_final: Euler's method returning only the final y value.
// Avoids building the trajectory list — O(1) memory, O(steps) time.
// State is stored in a dict; all values are unboxed with _eu_unbox before use.
fn eu_final(f, t0, y0, h, steps) -> float
    let hf = t0 * 0.0 + h * 1.0
    let st = {}
    st["t"] = t0 * 1.0
    st["y"] = y0 * 1.0
    for i in 0..steps
        let tc = _eu_unbox(st["t"])
        let yc = _eu_unbox(st["y"])
        let raw = f(tc, yc)
        let slope = _eu_unbox(raw)
        let dy = hf * slope
        st["y"] = yc + dy
        st["t"] = tc + hf
    let rawres = st["y"]
    let result = _eu_unbox(rawres)
    return result

// eu_solve: Euler's method returning the full trajectory as a list of [t, y] pairs.
// Returns steps+1 entries (including the initial condition at index 0).
// State is stored in a dict; all values are unboxed with _eu_unbox before use.
fn eu_solve(f, t0, y0, h, steps) -> list
    let hf = t0 * 0.0 + h * 1.0
    let st = {}
    st["t"] = t0 * 1.0
    st["y"] = y0 * 1.0
    // Collect trajectory: each element is a [t, y] pair (steps+1 total)
    let traj = []
    let t0f = t0 * 1.0
    let y0f = y0 * 1.0
    let pair0 = [t0f, y0f]
    push(traj, pair0)
    for i in 0..steps
        let tc = _eu_unbox(st["t"])
        let yc = _eu_unbox(st["y"])
        let raw = f(tc, yc)
        let slope = _eu_unbox(raw)
        let dy = hf * slope
        let yn = yc + dy
        let tn = tc + hf
        st["y"] = yn
        st["t"] = tn
        let pair = [tn, yn]
        push(traj, pair)
    return traj
