// ============================================================================
// NOVA Standard Library — Natural cubic spline: second-derivative solve
// ============================================================================
// A natural cubic spline satisfies S''(x0) = S''(xn) = 0 (natural boundary).
// Given n+1 data points (xs[i], ys[i]), the second derivatives M[i] are the
// solution to a symmetric tridiagonal system.
//
// The system (Thomas algorithm / tridiagonal elimination):
//   For i=1..n-1:
//     h[i-1]*M[i-1] + 2*(h[i-1]+h[i])*M[i] + h[i]*M[i+1] = 6*d[i]
//   where h[i] = xs[i+1]-xs[i]  and  d[i] = (ys[i+1]-ys[i])/h[i] - (ys[i]-ys[i-1])/h[i-1]
//   Natural BC: M[0] = M[n] = 0.
//
// spline_coeffs(xs, ys) -> list
//   Returns the M array (second derivatives at each knot) of length n+1.
//   M[0] = M[n] = 0.0 (natural boundary conditions).
//
// For n=2 (three points), this degrades to a single-equation system and
// still produces valid results.
// ============================================================================

// spline_coeffs: solve for the natural cubic spline second derivatives M[]
fn spline_coeffs(xs, ys) -> list
    let n = len(xs) - 1
    // Degenerate: only 2 points -> linear, all M = 0
    if n < 2
        let m = []
        let i = 0
        while i <= n
            push(m, 0.0)
            i = i + 1
        return m

    // Build h[] and rhs[] for the interior equations (indices 1..n-1)
    // h[i] = xs[i+1] - xs[i]
    let h = []
    for k in 0..n
        let hk = xs[k + 1] - xs[k]
        push(h, hk)

    // Number of interior unknowns = n-1
    let m_size = n - 1

    // Build the tridiagonal system: lower (a), main (b), upper (c), rhs (r)
    // Interior index j in 0..m_size-1 corresponds to knot i = j+1
    let a = []
    let b = []
    let c = []
    let r = []
    for j in 0..m_size
        let i = j + 1
        let hi1 = h[i - 1]
        let hi = h[i]
        let bj = 2.0 * (hi1 + hi)
        push(b, bj)
        // sub-diagonal (left neighbour)
        if j > 0
            push(a, h[i - 1])
        else
            push(a, 0.0)
        // super-diagonal (right neighbour)
        if j < m_size - 1
            push(c, h[i])
        else
            push(c, 0.0)
        // right-hand side
        let slope_right = (ys[i + 1] - ys[i]) / hi
        let slope_left = (ys[i] - ys[i - 1]) / hi1
        let rj = 6.0 * (slope_right - slope_left)
        push(r, rj)

    // Thomas algorithm: forward sweep
    // Modify b and r in-place
    for fwd in 1..m_size
        let factor = a[fwd] / b[fwd - 1]
        b[fwd] = b[fwd] - factor * c[fwd - 1]
        r[fwd] = r[fwd] - factor * r[fwd - 1]

    // Back substitution to get interior M values
    // Pre-fill with 0.0
    let interior = [0.0 for pre in 0..m_size]
    // Last interior
    let last_j = m_size - 1
    interior[last_j] = r[last_j] / b[last_j]
    // Back substitute
    let bk = m_size - 2
    while bk >= 0
        interior[bk] = (r[bk] - c[bk] * interior[bk + 1]) / b[bk]
        bk = bk - 1

    // Assemble full M array: M[0]=0, M[1..n-1]=interior, M[n]=0
    let M = []
    push(M, 0.0)
    for ii in 0..m_size
        push(M, interior[ii])
    push(M, 0.0)
    return M
