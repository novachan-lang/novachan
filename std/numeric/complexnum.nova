// ============================================================================
// NOVA Standard Library — complex numbers
// ============================================================================
// Pure NOVA (no new builtins). A complex number is a [re, im] float pair.
// Closes cat-11 "Complex numbers" (the math-constants half π/e was already done).
// int OR float inputs are coerced to float with _f (x*1.0 — the sound coercion).

fn _f(x) -> float
    return x * 1.0

fn complex(re, im)
    return [_f(re), _f(im)]

fn c_re(z) -> float
    return z[0]
fn c_im(z) -> float
    return z[1]

fn c_add(a, b)
    return [a[0] + b[0], a[1] + b[1]]

fn c_sub(a, b)
    return [a[0] - b[0], a[1] - b[1]]

fn c_mul(a, b)
    return [a[0] * b[0] - a[1] * b[1], a[0] * b[1] + a[1] * b[0]]

fn c_conj(z)
    return [z[0], 0.0 - z[1]]

fn c_abs(z) -> float
    return sqrt(z[0] * z[0] + z[1] * z[1])

// (a/b) = a * conj(b) / |b|^2
fn c_div(a, b)
    let den = b[0] * b[0] + b[1] * b[1]
    return [(a[0] * b[0] + a[1] * b[1]) / den, (a[1] * b[0] - a[0] * b[1]) / den]

// scale by a real
fn c_scale(z, s)
    let sf = _f(s)
    return [z[0] * sf, z[1] * sf]

// ============================================================================
fn main()
    let tol = 0.000001

    // ── add / sub ──
    let s = c_add(complex(1, 2), complex(3, 4))
    assert_near(c_re(s), 4.0, tol)
    assert_near(c_im(s), 6.0, tol)
    let d = c_sub(complex(5, 7), complex(2, 3))
    assert_near(c_re(d), 3.0, tol)
    assert_near(c_im(d), 4.0, tol)

    // ── mul: (1+2i)(3+4i) = -5 + 10i ──
    let m = c_mul(complex(1, 2), complex(3, 4))
    assert_near(c_re(m), -5.0, tol)
    assert_near(c_im(m), 10.0, tol)

    // ── i*i = -1 ──
    let ii = c_mul(complex(0, 1), complex(0, 1))
    assert_near(c_re(ii), -1.0, tol)
    assert_near(c_im(ii), 0.0, tol)

    // ── abs: |3+4i| = 5 ──
    assert_near(c_abs(complex(3, 4)), 5.0, tol)
    assert_near(c_abs(complex(0, 0)), 0.0, tol)

    // ── conj ──
    let cj = c_conj(complex(3, 4))
    assert_near(c_re(cj), 3.0, tol)
    assert_near(c_im(cj), -4.0, tol)

    // ── div: 1/i = -i ──
    let q = c_div(complex(1, 0), complex(0, 1))
    assert_near(c_re(q), 0.0, tol)
    assert_near(c_im(q), -1.0, tol)

    // ── div: (5+0i)/(2+0i) = 2.5 ──
    let q2 = c_div(complex(5, 0), complex(2, 0))
    assert_near(c_re(q2), 2.5, tol)
    assert_near(c_im(q2), 0.0, tol)

    // ── (a/b)*b == a  round-trip ──
    let a = complex(7, -3)
    let b = complex(2, 5)
    let rt = c_mul(c_div(a, b), b)
    assert_near(c_re(rt), 7.0, tol)
    assert_near(c_im(rt), -3.0, tol)

    // ── z * conj(z) = |z|^2 (real) ──
    let z = complex(3, 4)
    let zz = c_mul(z, c_conj(z))
    assert_near(c_re(zz), 25.0, tol)
    assert_near(c_im(zz), 0.0, tol)

    // ── scale ──
    let sc = c_scale(complex(2, -1), 3)
    assert_near(c_re(sc), 6.0, tol)
    assert_near(c_im(sc), -3.0, tol)

    print("complexnum_test passed")
