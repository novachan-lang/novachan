// ============================================================================
// NOVA Standard Library — std/numeric/dist_exponential
// ============================================================================
// Exponential distribution: models time between events in a Poisson process.
//
// Parameter: rate (lambda > 0) — the rate of events per unit time.
//
// Public API (prefix exp_):
//   exp_pdf(x, rate) -> float   — probability density at x
//   exp_cdf(x, rate) -> float   — cumulative probability P(X <= x)
//   exp_mean(rate)   -> float   — mean = 1/rate
//   exp_ppf(p, rate) -> float   — percent-point function (inverse CDF)
//
// Formulas:
//   pdf(x; lambda) = lambda * exp(-lambda * x)  for x >= 0, else 0
//   cdf(x; lambda) = 1 - exp(-lambda * x)       for x >= 0, else 0
//   mean           = 1 / lambda
//   ppf(p; lambda) = -ln(1 - p) / lambda
// ============================================================================

fn exp_pdf(x, rate) -> float
    let xf = x * 1.0
    let rf = rate * 1.0
    if xf < 0.0
        return 0.0
    let neg_rx = -(rf * xf)
    let e = exp(neg_rx)
    let result = rf * e
    return result

fn exp_cdf(x, rate) -> float
    let xf = x * 1.0
    let rf = rate * 1.0
    if xf < 0.0
        return 0.0
    let neg_rx = -(rf * xf)
    let e = exp(neg_rx)
    let result = 1.0 - e
    return result

fn exp_mean(rate) -> float
    let rf = rate * 1.0
    let result = 1.0 / rf
    return result

fn exp_ppf(p, rate) -> float
    let pf = p * 1.0
    let rf = rate * 1.0
    let one_minus_p = 1.0 - pf
    let ln_val = log(one_minus_p)
    let neg_ln = -ln_val
    let result = neg_ln / rf
    return result
