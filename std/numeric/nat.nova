// ============================================================================
// NOVA Standard Library — arbitrary-precision natural numbers (bignum)
// ============================================================================
// Pure NOVA (no new builtins, no list mutation): a non-negative big integer is a
// decimal-digit STRING, MSB-first. Closes cat-11 "Arbitrary-precision integers"
// (was MISSING). add / mul / cmp via schoolbook string arithmetic — exact for
// any size (factorials, Fibonacci) far beyond i64's ~9.2e18.

// strip leading zeros, keeping at least one digit
fn bn_norm(s) -> string
    let i = 0
    let n = len(s)
    while i < n - 1 and ord(s[i]) == 48      // '0'
        i = i + 1
    return slice(s, i, n)

// reverse a digit string (helper: results are built LSB-first then flipped)
fn _bn_rev(s) -> string
    let out = ""
    let k = len(s) - 1
    while k >= 0
        out = out + s[k]
        k = k - 1
    return out

// compare two non-negative decimal strings: -1 (a<b) / 0 / 1 (a>b)
fn bn_cmp(a, b) -> int
    let na = bn_norm(a)
    let nb = bn_norm(b)
    if len(na) < len(nb)
        return -1
    if len(na) > len(nb)
        return 1
    let i = 0
    while i < len(na)
        let ca = ord(na[i])
        let cb = ord(nb[i])
        if ca < cb
            return -1
        if ca > cb
            return 1
        i = i + 1
    return 0

// add two non-negative decimal strings
fn bn_add(a, b) -> string
    let na = bn_norm(a)
    let nb = bn_norm(b)
    let i = len(na) - 1
    let j = len(nb) - 1
    let carry = 0
    let rev = ""                              // LSB-first
    while i >= 0 or j >= 0 or carry > 0
        let da = 0
        if i >= 0
            da = ord(na[i]) - 48
            i = i - 1
        let db = 0
        if j >= 0
            db = ord(nb[j]) - 48
            j = j - 1
        let sum = da + db + carry
        carry = sum / 10
        rev = rev + chr(sum % 10 + 48)
    return bn_norm(_bn_rev(rev))

// multiply a non-negative decimal string by a single digit d (0..9)
fn _bn_mul_small(a, d) -> string
    if d == 0
        return "0"
    let na = bn_norm(a)
    let i = len(na) - 1
    let carry = 0
    let rev = ""
    while i >= 0 or carry > 0
        let da = 0
        if i >= 0
            da = ord(na[i]) - 48
            i = i - 1
        let prod = da * d + carry
        carry = prod / 10
        rev = rev + chr(prod % 10 + 48)
    return bn_norm(_bn_rev(rev))

// a * 10^z  (append z zeros), with 0 staying 0
fn _bn_shift(a, z) -> string
    let na = bn_norm(a)
    if bn_cmp(na, "0") == 0
        return "0"
    let out = na
    let i = 0
    while i < z
        out = out + "0"
        i = i + 1
    return out

// multiply two non-negative decimal strings (sum of shifted single-digit partials)
fn bn_mul(a, b) -> string
    let na = bn_norm(a)
    let nb = bn_norm(b)
    let acc = "0"
    let j = len(nb) - 1
    let shift = 0
    while j >= 0
        let d = ord(nb[j]) - 48
        let partial = _bn_shift(_bn_mul_small(na, d), shift)
        acc = bn_add(acc, partial)
        shift = shift + 1
        j = j - 1
    return bn_norm(acc)

// int -> bignum string
fn bn_from_int(n) -> string
    return bn_norm(str(n))

// subtract: a - b, REQUIRES a >= b (caller checks with bn_cmp). Schoolbook borrow.
fn bn_sub(a, b) -> string
    let na = bn_norm(a)
    let nb = bn_norm(b)
    let i = len(na) - 1
    let j = len(nb) - 1
    let borrow = 0
    let rev = ""
    while i >= 0
        let da = ord(na[i]) - 48
        let db = 0
        if j >= 0
            db = ord(nb[j]) - 48
            j = j - 1
        let diff = da - db - borrow
        if diff < 0
            diff = diff + 10
            borrow = 1
        else
            borrow = 0
        rev = rev + chr(diff + 48)
        i = i - 1
    return bn_norm(_bn_rev(rev))

// divide: returns [quotient, remainder]. b must be non-zero. Schoolbook long
// division — bring down one digit at a time; the quotient digit is the largest
// d in 0..9 with b*d <= running remainder (string concat = *10 + digit).
fn bn_divmod(a, b)
    let na = bn_norm(a)
    let nb = bn_norm(b)
    let q = ""
    let rem = "0"
    let i = 0
    while i < len(na)
        rem = bn_norm(rem + na[i])          // rem = rem*10 + next digit
        let qd = 0
        let t = 9
        while t >= 0
            if bn_cmp(_bn_mul_small(nb, t), rem) <= 0
                qd = t
                t = -1                       // found the largest fit; stop
            else
                t = t - 1
        q = q + chr(qd + 48)
        rem = bn_sub(rem, _bn_mul_small(nb, qd))
        i = i + 1
    return [bn_norm(q), bn_norm(rem)]

// quotient / remainder convenience
fn bn_div(a, b) -> string
    return bn_divmod(a, b)[0]
fn bn_mod(a, b) -> string
    return bn_divmod(a, b)[1]

// greatest common divisor (Euclid over bignums)
fn bn_gcd(a, b) -> string
    let x = bn_norm(a)
    let y = bn_norm(b)
    while bn_cmp(y, "0") != 0
        let r = bn_mod(x, y)
        x = y
        y = r
    return x

// ============================================================================
fn main()
    // ── add ──
    assert_eq(bn_add("0", "0"), "0")
    assert_eq(bn_add("999", "1"), "1000")
    assert_eq(bn_add("1", "999"), "1000")
    assert_eq(bn_add("00012", "8"), "20")          // leading zeros normalized
    assert_eq(bn_add("99999999999999999999", "1"), "100000000000000000000")  // past i64

    // ── cmp ──
    assert_eq(bn_cmp("100", "99"), 1)
    assert_eq(bn_cmp("99", "100"), -1)
    assert_eq(bn_cmp("0123", "123"), 0)            // normalized equal
    assert_eq(bn_cmp("555", "555"), 0)

    // ── mul ──
    assert_eq(bn_mul("12", "12"), "144")
    assert_eq(bn_mul("999", "999"), "998001")
    assert_eq(bn_mul("0", "123456"), "0")
    assert_eq(bn_mul("123456", "0"), "0")
    assert_eq(bn_mul("123456789", "987654321"), "121932631112635269")  // overflows i64

    // ── factorial(25) with bignum (overflows i64 at 21!) ──
    let fact = "1"
    let k = 2
    while k <= 25
        fact = bn_mul(fact, bn_from_int(k))
        k = k + 1
    assert_eq(fact, "15511210043330985984000000")

    // ── fibonacci(100) with bignum ──
    let fa = "0"
    let fb = "1"
    let m = 0
    while m < 100
        let nx = bn_add(fa, fb)
        fa = fb
        fb = nx
        m = m + 1
    assert_eq(fa, "354224848179261915075")         // fib(100), 21 digits

    // ── distributivity sanity: 2^64 computed two ways ──
    let p32 = "4294967296"                          // 2^32
    assert_eq(bn_mul(p32, p32), "18446744073709551616")  // 2^64, > i64 max

    // ── sub ──
    assert_eq(bn_sub("1000", "1"), "999")
    assert_eq(bn_sub("100000000000000000000", "1"), "99999999999999999999")  // past i64
    assert_eq(bn_sub("555", "555"), "0")
    assert_eq(bn_sub("20", "00012"), "8")           // leading zeros normalized
    // add/sub inverse
    assert_eq(bn_sub(bn_add("123456789", "987654321"), "987654321"), "123456789")

    // ── divmod ──
    let dm = bn_divmod("1234", "56")
    assert_eq(dm[0], "22")                           // 22*56 = 1232
    assert_eq(dm[1], "2")                            // remainder 2
    assert_eq(bn_div("1000000", "7"), "142857")
    assert_eq(bn_mod("1000000", "7"), "1")           // 142857*7 = 999999, +1
    assert_eq(bn_div("18446744073709551616", "1000"), "18446744073709551")  // 2^64 / 1000
    assert_eq(bn_mod("18446744073709551616", "1000"), "616")
    assert_eq(bn_div("5", "8"), "0")                 // a < b
    assert_eq(bn_mod("5", "8"), "5")
    // div is the inverse of mul (exact): (a*b)/b == a
    assert_eq(bn_div(bn_mul("123456789", "98765"), "98765"), "123456789")
    // q*b + r == a  (reconstruct 25! / 999 )
    let f25 = "15511210043330985984000000"
    let dq = bn_divmod(f25, "999")
    assert_eq(bn_add(bn_mul(dq[0], "999"), dq[1]), f25)

    // ── gcd ──
    assert_eq(bn_gcd("12", "18"), "6")
    assert_eq(bn_gcd("100", "75"), "25")
    assert_eq(bn_gcd("1000000007", "1000000009"), "1")     // two primes -> coprime
    assert_eq(bn_gcd("0", "5"), "5")
    // gcd(a*g, b*g) == g  for coprime a,b  (g = 123456789)
    let g = "123456789"
    assert_eq(bn_gcd(bn_mul("7", g), bn_mul("13", g)), g)

    print("bignum_test passed")
