// ============================================================================
// NOVA Standard Library — std/numeric/percentage.nova
// Percentage arithmetic on floats.
// All private helpers prefixed _pct_.
// ============================================================================
//
// Public API:
//   pc_of(percent, whole) -> float          -- percent% of whole
//   pc_what_percent(part, whole) -> float   -- part as a % of whole
//   pc_change(old, newv) -> float           -- % change from old to newv
//   pc_apply(value, percent) -> float       -- value increased by percent%
//   pc_discount(price, percent) -> float    -- price reduced by percent%
//   pc_ratio_to_pct(part, whole) -> float   -- alias: (part/whole)*100

// pc_of(percent, whole) -> float
// Returns (percent / 100) * whole.
fn pc_of(percent, whole)
    let result = (percent / 100.0) * whole
    return result

// pc_what_percent(part, whole) -> float
// Returns (part / whole) * 100.  Returns 0 when whole == 0.
fn pc_what_percent(part, whole)
    if whole == 0.0
        return 0.0
    let result = (part / whole) * 100.0
    return result

// pc_change(old, newv) -> float
// Returns percent change from old to newv: ((newv - old) / old) * 100.
// Returns 0 when old == 0.
fn pc_change(old, newv)
    if old == 0.0
        return 0.0
    let diff = newv - old
    let result = (diff / old) * 100.0
    return result

// pc_apply(value, percent) -> float
// Returns value increased by percent%: value * (1 + percent/100).
fn pc_apply(value, percent)
    let factor = 1.0 + (percent / 100.0)
    let result = value * factor
    return result

// pc_discount(price, percent) -> float
// Returns price reduced by percent%: price * (1 - percent/100).
fn pc_discount(price, percent)
    let factor = 1.0 - (percent / 100.0)
    let result = price * factor
    return result

// pc_ratio_to_pct(part, whole) -> float
// Returns (part / whole) * 100.  Returns 0 when whole == 0.
fn pc_ratio_to_pct(part, whole)
    if whole == 0.0
        return 0.0
    let result = (part / whole) * 100.0
    return result
