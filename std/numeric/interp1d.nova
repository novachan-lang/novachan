// ============================================================================
// NOVA Standard Library — 1-D linear interpolation
// ============================================================================
// linear_interp(x, x0, y0, x1, y1) -> float
//   Simple two-point linear interpolation (no array needed).
//   Returns y0 + (y1-y0)*(x-x0)/(x1-x0).
//
// interp_array(xs, ys, x) -> float
//   Linearly interpolate within a sorted xs array.
//   Clamps to ys[0] when x <= xs[0] and to ys[n-1] when x >= xs[n-1].
//   Uses binary-search style scan to locate the bracketing interval.
//
// nearest(xs, ys, x) -> float
//   Nearest-neighbour lookup: returns the y value whose corresponding x
//   is closest to the query point.  Ties broken toward the higher index.
// ============================================================================

// linear_interp: straight two-point formula
fn linear_interp(x: float, x0: float, y0: float, x1: float, y1: float) -> float
    let dx = x1 - x0
    let dy = y1 - y0
    let t = (x - x0) / dx
    let result = y0 + dy * t
    return result

// interp_array: sorted xs / ys array version with clamping
fn interp_array(xs, ys, x: float) -> float
    let n = len(xs)
    // Clamp left
    let x0 = xs[0]
    if x <= x0
        let y0 = ys[0]
        return y0
    // Clamp right
    let xlast = xs[n - 1]
    if x >= xlast
        let ylast = ys[n - 1]
        return ylast
    // Find bracketing interval i such that xs[i] <= x < xs[i+1]
    for i in 0..(n - 1)
        let xa = xs[i]
        let xb = xs[i + 1]
        if x >= xa and x <= xb
            let ya = ys[i]
            let yb = ys[i + 1]
            let result = linear_interp(x, xa, ya, xb, yb)
            return result
    // Fallback: return last y (should not be reached given clamping above)
    let yfallback = ys[n - 1]
    return yfallback

// nearest: nearest-neighbour lookup
fn nearest(xs, ys, x: float) -> float
    let n = len(xs)
    let best_i = 0
    let best_d = xs[0] - x
    if best_d < 0.0
        best_d = 0.0 - best_d
    for i in 1..n
        let xi = xs[i]
        let d = xi - x
        if d < 0.0
            d = 0.0 - d
        if d <= best_d
            best_d = d
            best_i = i
    let result = ys[best_i]
    return result
