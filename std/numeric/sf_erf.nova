// ============================================================================
// NOVA Standard Library — std/numeric/sf_erf
// ============================================================================
// Error function (erf) and complementary error function (erfc) via the
// Abramowitz-Stegun approximation (formula 7.1.26), accurate to |eps| < 1.5e-7.
//
// A&S 7.1.26: for x >= 0,
//   erfc(x) ~= (a1*t + a2*t^2 + a3*t^3 + a4*t^4 + a5*t^5) * exp(-x^2)
//   where t = 1 / (1 + p*x), p = 0.3275911
//   a1 =  0.254829592
//   a2 = -0.284496736
//   a3 =  1.421413741
//   a4 = -1.453152027
//   a5 =  1.061405429
//
// Symmetry: erf(-x) = -erf(x)
//
// Public API (prefix ef_):
//   erf(x)        -> float — error function erf(x) in [-1, 1]
//   erfc(x)       -> float — complementary: erfc(x) = 1 - erf(x)
//   normal_cdf(x) -> float — standard normal CDF: 0.5*(1+erf(x/sqrt(2)))
//
// All private helpers are prefixed _ef_.
// ============================================================================

// A&S 7.1.26 polynomial coefficients
fn _ef_p() -> float
    return 0.3275911

fn _ef_a1() -> float
    return 0.254829592

fn _ef_a2() -> float
    return 0.0 - 0.284496736

fn _ef_a3() -> float
    return 1.421413741

fn _ef_a4() -> float
    return 0.0 - 1.453152027

fn _ef_a5() -> float
    return 1.061405429

// _ef_erfc_pos(x): erfc for x >= 0 using A&S 7.1.26.
// Returns a value in [0, 1] for x >= 0.
fn _ef_erfc_pos(x) -> float
    let xf = x * 1.0
    let t = 1.0 / (1.0 + _ef_p() * xf)
    let t2 = t * t
    let t3 = t2 * t
    let t4 = t3 * t
    let t5 = t4 * t
    let poly = _ef_a1()*t + _ef_a2()*t2 + _ef_a3()*t3 + _ef_a4()*t4 + _ef_a5()*t5
    let xsq = xf * xf
    let ex = exp(0.0 - xsq)
    let result = poly * ex
    return result

// erfc(x): complementary error function for any real x.
// erfc(x) = 1 - erf(x). Uses symmetry erfc(-x) = 2 - erfc(x).
fn erfc(x) -> float
    let xf = x * 1.0
    if xf < 0.0
        let neg = 0.0 - xf
        let r = _ef_erfc_pos(neg)
        let result = 2.0 - r
        return result
    let result = _ef_erfc_pos(xf)
    return result

// erf(x): error function for any real x.
// erf(x) = 1 - erfc(x). Range: [-1, 1].
fn erf(x) -> float
    let xf = x * 1.0
    let ec = erfc(xf)
    let result = 1.0 - ec
    return result

// normal_cdf(x): standard normal cumulative distribution function.
// normal_cdf(x) = 0.5 * (1 + erf(x / sqrt(2)))
fn normal_cdf(x) -> float
    let xf = x * 1.0
    let sq2 = sqrt(2.0)
    let arg = xf / sq2
    let ef = erf(arg)
    let result = 0.5 * (1.0 + ef)
    return result
