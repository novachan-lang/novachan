// ============================================================================
// NOVA Standard Library — std/numeric/dist_binomial
// ============================================================================
// Binomial distribution — PMF, CDF, and mean.
//
// Public API:
//   binomial_pmf(k, n, p) -> float   — P(X = k) for X ~ Binomial(n, p)
//   binomial_cdf(k, n, p) -> float   — P(X <= k) for X ~ Binomial(n, p)
//   binomial_mean(n, p)   -> float   — E[X] = n*p
//
// Internals:
//   Log-space computation for numerical stability.
//   log(C(n,k)) = log(n!) - log(k!) - log((n-k)!) via iterative log-factorial.
//   CDF: sum of PMF values 0..k using dict-based while loop.
// ============================================================================

// _bn_log_factorial(m): log(m!) computed iteratively.
// Returns 0.0 for m <= 0 (log(0!) = log(1) = 0).
fn _bn_log_factorial(m) -> float
    if m <= 0
        return 0.0
    let st = {}
    st["acc"] = 0.0
    st["j"] = 1
    while st["j"] <= m
        let j = st["j"]
        let jf = j * 1.0
        let ljf = log(jf)
        st["acc"] = st["acc"] + ljf
        st["j"] = j + 1
    let result = st["acc"]
    let resultf = result * 1.0
    return resultf

// binomial_pmf(k, n, p): P(X = k) for X ~ Binomial(n, p).
// Computed in log-space: exp(log_C(n,k) + k*log(p) + (n-k)*log(1-p)).
// k must be in [0, n]; p must be in [0, 1].
fn binomial_pmf(k, n, p) -> float
    let kf = k * 1.0
    let nf = n * 1.0
    let pf = p * 1.0
    if k < 0
        return 0.0
    if k > n
        return 0.0
    if pf < 0.0
        return 0.0
    if pf > 1.0
        return 0.0
    // Edge cases: p=0 or p=1
    if pf == 0.0
        if k == 0
            return 1.0
        return 0.0
    if pf == 1.0
        if k == n
            return 1.0
        return 0.0
    // log(C(n,k)) = log(n!) - log(k!) - log((n-k)!)
    let log_n_fact = _bn_log_factorial(n)
    let log_n_factf = log_n_fact * 1.0
    let log_k_fact = _bn_log_factorial(k)
    let log_k_factf = log_k_fact * 1.0
    let nmk = n - k
    let log_nmk_fact = _bn_log_factorial(nmk)
    let log_nmk_factf = log_nmk_fact * 1.0
    let log_binom_coeff = log_n_factf - log_k_factf - log_nmk_factf
    // log(pmf) = log_C(n,k) + k*log(p) + (n-k)*log(1-p)
    let log_p = log(pf)
    let one_minus_p = 1.0 - pf
    let log_1mp = log(one_minus_p)
    let nmkf = nmk * 1.0
    let log_pmf = log_binom_coeff + kf * log_p + nmkf * log_1mp
    let result = exp(log_pmf)
    return result

// binomial_cdf(k, n, p): P(X <= k) for X ~ Binomial(n, p).
// Computed as sum of binomial_pmf(i, n, p) for i = 0, 1, ..., k.
fn binomial_cdf(k, n, p) -> float
    let pf = p * 1.0
    if k < 0
        return 0.0
    if k >= n
        return 1.0
    let st = {}
    st["acc"] = 0.0
    st["i"] = 0
    while st["i"] <= k
        let i = st["i"]
        let v = binomial_pmf(i, n, pf)
        let vf = v * 1.0
        st["acc"] = st["acc"] + vf
        st["i"] = i + 1
    let total = st["acc"]
    let result = total * 1.0
    return result

// binomial_mean(n, p): expected value E[X] = n*p.
fn binomial_mean(n, p) -> float
    let nf = n * 1.0
    let pf = p * 1.0
    let result = nf * pf
    return result
