// ============================================================================
// NOVA Standard Library — std/numeric/simpson
// ============================================================================
// Composite Simpson's 1/3 rule numerical integration.
//
// Public API:
//   sp_integrate(f, a, b, n) -> float
//     Integrate f over [a, b] using composite Simpson's 1/3 rule with n panels.
//     n must be even; if n is odd, it is silently bumped to n+1.
//     f is a named fn(x: float) -> float. The body must mix the float argument
//     with a float literal (e.g. x*x or x+0.0) to guarantee a properly-typed
//     return through the any-parameter ABI.
//
// Algorithm:
//   Divide [a, b] into n equal subintervals (h = (b-a)/n).
//   Simpson's 1/3 rule:
//     (h/3) * [f(x0) + 4f(x1) + 2f(x2) + 4f(x3) + ... + 4f(xn-1) + f(xn)]
//   Interior coefficients alternate 4, 2, 4, 2, ...
//   Error is O(h^4) per interval; 4th-order method.
//
// Implementation notes:
//   All mutable float state is kept in a dict (st). Dict field reads
//   (nova_rt_dict_get -> nova_rt_unbox_elem) correctly expose float values
//   for subsequent fmul/fadd operations. HOF params (a, b) are stored via
//   `param * 1.0` to ensure the fmul path fires; loop index is stored via
//   dict to avoid the NOVA LLVM-label variable-reassignment bug in nested
//   while+if bodies.
//
// All private helpers are prefixed _sp_ to avoid namespace collisions.

// sp_integrate: composite Simpson's 1/3 rule integration.
// Parameters:
//   f       — integrand; named fn taking one float-like value, returning float
//   a, b    — integration bounds (numeric; a < b)
//   n       — number of subintervals (positive even int; odd n bumped to n+1)
// Returns: float approximation of the definite integral of f over [a, b].
fn sp_integrate(f, a, b, n) -> float
    // Store all mutable state in a dict.
    // a and b are widened to `any` through the HOF ABI; `param * 1.0` fires the
    // fmul path, which correctly unboxes the boxed float via nova_rt_unbox
    // before multiplying. The result is a raw-double SSA value stored in the dict.
    let st = {}
    st["a"] = a * 1.0
    st["b"] = b * 1.0
    // Ensure n is even: keep as int arithmetic, then store.
    let _sp_p = n
    let _sp_rem = _sp_p - (_sp_p / 2) * 2
    if _sp_rem != 0
        _sp_p += 1
    st["panels"] = _sp_p
    // Compute step size h = (b-a)/panels.
    let _sp_fa = st["a"]
    let _sp_fb = st["b"]
    let _sp_np = st["panels"]
    let _sp_h = (_sp_fb - _sp_fa) / (_sp_np * 1.0)
    st["h"] = _sp_h
    // Accumulate: endpoints get weight 1, interior nodes alternate weights 4 and 2.
    st["total"] = f(_sp_fa) + f(_sp_fb)
    // Loop: i from 1 to panels-1.
    // Kept in dict to avoid NOVA LLVM-label bug with reassignment inside nested if.
    st["i"] = 1
    while st["i"] < st["panels"]
        let _sp_i = st["i"]
        let _sp_h2 = st["h"]
        let _sp_a2 = st["a"]
        let _sp_xi = _sp_a2 + (_sp_i * 1.0) * _sp_h2
        let _sp_fi = f(_sp_xi)
        // Coefficient: 4 for odd i, 2 for even i.
        let _sp_odd = _sp_i - (_sp_i / 2) * 2
        if _sp_odd != 0
            st["total"] += _sp_fi * 4.0
        else
            st["total"] += _sp_fi * 2.0
        st["i"] = _sp_i + 1
    // Final result: (h/3) * total.
    let _sp_hf = st["h"]
    let _sp_tot = st["total"]
    let result = (_sp_hf / 3.0) * _sp_tot
    return result
