// ============================================================================
// NOVA Standard Library — std/numeric/polyfit
// ============================================================================
// Least-squares polynomial fitting via normal equations + Gaussian elimination.
//
// Public API:
//   polyfit(xs, ys, degree) -> list   coefficients LOWEST-order first (len=degree+1)
//   pf_linear(xs, ys)       -> list   [intercept, slope]  (convenience; degree=1)
//   pf_correlation(xs, ys)  -> float  Pearson r
//   pf_predict(coeffs, x)   -> float  evaluate at x (Horner's method)
//
// Algorithm:
//   Build the (degree+1) x (degree+1) normal equations  A^T A c = A^T y,
//   then solve the square system by Gaussian elimination with partial pivoting.
//   The resulting coefficients are ordered lowest power first:
//     p(x) = coeffs[0] + coeffs[1]*x + coeffs[2]*x^2 + ...
//
// All private helpers prefixed _pf_ to avoid namespace collisions.
// ============================================================================

// _pf_tof — coerce any numeric value to float
fn _pf_tof(x) -> float
    return x * 1.0

// _pf_fabs — float absolute value
fn _pf_fabs(v) -> float
    let r = v * 1.0
    if v < 0.0
        r = 0.0 - v
    return r

// _pf_pow_int — x raised to non-negative integer power p
fn _pf_pow_int(x, p) -> float
    let result = 1.0
    let i = 0
    let xf = x * 1.0
    while i < p
        result *= xf
        i += 1
    return result

// _pf_mat_get / _pf_mat_set — row-major access to a flat list of size (sz x sz)
fn _pf_mat_get(mat, row, col, sz) -> float
    let idx = row * sz + col
    return mat[idx] * 1.0

fn _pf_mat_set(mat, row, col, sz, val)
    let idx = row * sz + col
    mat[idx] = val

// _pf_gauss — solve A x = b in place (A is flat row-major list, b is list).
// Returns solution list of length n, or all-zeros on singular.
fn _pf_gauss(A, b, n) -> list
    // Forward elimination with partial pivoting
    for pivot_row in 0..n
        // Find max in column pivot_row at or below pivot_row
        let max_val = _pf_fabs(_pf_mat_get(A, pivot_row, pivot_row, n))
        let max_row = pivot_row
        for scan in pivot_row + 1..n
            let cand = _pf_fabs(_pf_mat_get(A, scan, pivot_row, n))
            if cand > max_val
                max_val = cand
                max_row = scan
        // Swap rows max_row <-> pivot_row in A and b
        if max_row != pivot_row
            for col in 0..n
                let tmp_a = _pf_mat_get(A, pivot_row, col, n)
                _pf_mat_set(A, pivot_row, col, n, _pf_mat_get(A, max_row, col, n))
                _pf_mat_set(A, max_row, col, n, tmp_a)
            let tmp_b = b[pivot_row] * 1.0
            b[pivot_row] = b[max_row] * 1.0
            b[max_row] = tmp_b
        // Eliminate column
        let piv_val = _pf_mat_get(A, pivot_row, pivot_row, n)
        if _pf_fabs(piv_val) > 0.0000000001
            for elim in pivot_row + 1..n
                let factor = _pf_mat_get(A, elim, pivot_row, n) / piv_val
                for col2 in pivot_row..n
                    let new_val = _pf_mat_get(A, elim, col2, n) - factor * _pf_mat_get(A, pivot_row, col2, n)
                    _pf_mat_set(A, elim, col2, n, new_val)
                b[elim] *= 1.0 - factor * b[pivot_row] * 1.0
    // Back substitution
    let x = [0.0 for xi in 0..n]
    let row = n - 1
    while row >= 0
        let rhs = b[row] * 1.0
        for col3 in row + 1..n
            rhs -= _pf_mat_get(A, row, col3, n) * x[col3] * 1.0
        let diag = _pf_mat_get(A, row, row, n)
        if _pf_fabs(diag) > 0.0000000001
            x[row] = rhs / diag
        else
            x[row] = 0.0
        row -= 1
    return x

// polyfit — least-squares polynomial fit of given degree.
// xs, ys: equal-length float lists of data points.
// degree: non-negative integer (0 = constant fit, 1 = linear, 2 = quadratic, ...).
// Returns list of coefficients, lowest power first, length = degree+1.
fn polyfit(xs, ys, degree) -> list
    let np = len(xs)
    let nc = degree + 1
    // Build normal equations: AtA (nc x nc flat) and Atb (nc)
    let Atb = []
    let AtA = [0.0 for fill in 0..(nc * nc)]
    for fillb in 0..nc
        push(Atb, 0.0)
    // Accumulate
    for i in 0..np
        let xi = xs[i] * 1.0
        let yi = ys[i] * 1.0
        for row in 0..nc
            let xr = _pf_pow_int(xi, row)
            let b_old = Atb[row] * 1.0
            Atb[row] = b_old + xr * yi
            for col in 0..nc
                let xc = _pf_pow_int(xi, col)
                let old_val = _pf_mat_get(AtA, row, col, nc)
                _pf_mat_set(AtA, row, col, nc, old_val + xr * xc)
    return _pf_gauss(AtA, Atb, nc)

// pf_linear — convenience wrapper for degree-1 polyfit.
// Returns [intercept, slope] to match OLS convention.
fn pf_linear(xs, ys) -> list
    return polyfit(xs, ys, 1)

// pf_predict — Horner evaluation of polynomial at x.
// coeffs: lowest-power first (same layout as polyfit output).
fn pf_predict(coeffs, x) -> float
    let n = len(coeffs)
    let xf = x * 1.0
    let result = coeffs[n - 1] * 1.0
    let i = n - 2
    while i >= 0
        result *= xf + coeffs[i] * 1.0
        i -= 1
    return result

// pf_correlation — Pearson r between xs and ys.
fn pf_correlation(xs, ys) -> float
    let n = len(xs)
    let sx = 0.0
    let sy = 0.0
    let sxx = 0.0
    let sxy = 0.0
    let syy = 0.0
    for i in 0..n
        let xi = xs[i] * 1.0
        let yi = ys[i] * 1.0
        sx += xi
        sy += yi
        sxx += xi * xi
        sxy += xi * yi
        syy += yi * yi
    let nf = n * 1.0
    let num = nf * sxy - sx * sy
    let varx = nf * sxx - sx * sx
    let vary = nf * syy - sy * sy
    let prod = varx * vary
    if prod < 0.0000000001
        return 0.0
    let denom = sqrt(prod)
    let r = num / denom
    return r

fn main()
    print("polyfit module OK")
