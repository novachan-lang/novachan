// ============================================================================
// NOVA Standard Library — Linear System Solver
// std/numeric/linsolve.nova
// ============================================================================
// Gaussian elimination with partial pivoting for dense linear systems.
//
// Given an n×n matrix A (list of row-lists of floats) and right-hand-side
// vector b (list of floats), solves Ax = b.
//
// Public API (prefix ls_):
//   ls_solve(A, b)          -> list   solution vector x (floats)
//   ls_determinant(A)       -> float  determinant of A
//   ls_is_singular(A)       -> bool   true if A is (numerically) singular
//
// All private helpers are prefixed _lsv_ to avoid namespace collisions.
//
// Algorithm: Gaussian elimination with partial pivoting.
//   1. Build augmented matrix [A|b] stored in a dict keyed by "row_col".
//   2. Forward elimination: for each pivot column k, find the row with the
//      largest absolute value in column k (partial pivoting), swap rows,
//      then eliminate below.
//   3. Back substitution: from the last row upward, solve for each unknown.
//
// The dict representation avoids NOVA's list-element-immutability constraint
// (A[i][j] = v is unsupported) by using O(1) dict key writes.
//
// NOVA LLVM-label-bug avoidance: never reassign a variable inside a nested
// if-body during a loop — always use a dict or a top-level variable updated
// via done-flag patterns.
// ============================================================================

// _lsv_fabs — float absolute value (native abs() returns int, not usable)
fn _lsv_fabs(v) -> float
    let r = v
    if v < 0.0
        r = 0.0 - v
    return r

// _lsv_key — encode (row, col) as a dict key string "r_c"
fn _lsv_key(r, c) -> str
    let k = str(r) + "_" + str(c)
    return k

// _lsv_build_aug — copy A and b into an augmented dict [A|b].
// Columns 0..n-1 hold A; column n holds b.
// "n" -> n (int), "det_sign" -> 1 or -1 (flips on each row swap).
fn _lsv_build_aug(A, b) -> dict
    let aug = {}
    let n = len(A)
    aug["n"] = n
    aug["det_sign"] = 1
    for i in 0..n
        let row = A[i]
        let j = 0
        while j < n
            let k = _lsv_key(i, j)
            aug[k] = row[j] * 1.0
            j += 1
        let kb = _lsv_key(i, n)
        aug[kb] = b[i] * 1.0
    return aug

// _lsv_get — read element (r, c) from augmented dict
fn _lsv_get(aug, r, c) -> float
    let k = _lsv_key(r, c)
    let v = aug[k]
    return v * 1.0

// _lsv_set — write element (r, c) into augmented dict
fn _lsv_set(aug, r, c, v)
    let k = _lsv_key(r, c)
    aug[k] = v

// _lsv_swap_rows — swap rows r1 and r2 in augmented matrix (columns 0..ncols-1)
// Also flips det_sign.
fn _lsv_swap_rows(aug, r1, r2, ncols)
    for j in 0..ncols
        let v1 = _lsv_get(aug, r1, j)
        let v2 = _lsv_get(aug, r2, j)
        _lsv_set(aug, r1, j, v2)
        _lsv_set(aug, r2, j, v1)
    let s = aug["det_sign"]
    aug["det_sign"] = 0 - s

// _lsv_find_pivot — find the row index r >= k with the largest |aug[r][k]|.
// Returns result in a dict: "row" -> int, "val" -> float.
// Uses a state dict internally to avoid LLVM-label reassignment bug.
fn _lsv_find_pivot(aug, k, n) -> dict
    let st = {}
    st["row"] = k
    st["val"] = _lsv_fabs(_lsv_get(aug, k, k))
    let r = k + 1
    while r < n
        let cand = _lsv_fabs(_lsv_get(aug, r, k))
        let cur = st["val"] * 1.0
        if cand > cur
            st["row"] = r
            st["val"] = cand
        r += 1
    return st

// _lsv_eliminate — perform Gaussian elimination with partial pivoting in-place.
// After this call, aug holds the upper-triangular form.
// Stores result in aug["ok"]: 1 = success, 0 = singular.
// We keep "ok" in the aug dict (not a local var) to avoid NOVA's LLVM-label
// reassignment bug (reassigning a local inside nested if inside a while).
fn _lsv_eliminate(aug)
    let n = aug["n"]
    let ncols = n + 1
    aug["ok"] = 1
    for k in 0..n
        let cur_ok = aug["ok"]
        if cur_ok == 1
            let pst = _lsv_find_pivot(aug, k, n)
            let pval = pst["val"] * 1.0
            if pval < 0.000000000001
                aug["ok"] = 0
            let still_ok = aug["ok"]
            if still_ok == 1
                let prow = pst["row"]
                if prow != k
                    _lsv_swap_rows(aug, k, prow, ncols)
                let pivot = _lsv_get(aug, k, k)
                let i = k + 1
                while i < n
                    let factor = _lsv_get(aug, i, k) / pivot
                    let j = k
                    while j < ncols
                        let cur_ij = _lsv_get(aug, i, j)
                        let cur_kj = _lsv_get(aug, k, j)
                        let new_val = cur_ij - factor * cur_kj
                        _lsv_set(aug, i, j, new_val)
                        j += 1
                    i += 1

// _lsv_back_sub — back substitution after elimination.
// Returns solution vector as a list of floats.
fn _lsv_back_sub(aug) -> list
    let n = aug["n"]
    let xd = {}
    let i = n - 1
    while i >= 0
        let rhs = _lsv_get(aug, i, n)
        let j = i + 1
        while j < n
            let kj = "x_" + str(j)
            let xj = xd[kj] * 1.0
            rhs -= _lsv_get(aug, i, j) * xj
            j += 1
        let diag = _lsv_get(aug, i, i)
        let xi = rhs / diag
        let ki = "x_" + str(i)
        xd[ki] = xi
        i -= 1
    return [xd["x_" + str(idx)] * 1.0 for idx in 0..n]

// ls_solve — solve Ax = b via Gaussian elimination with partial pivoting.
// A: list of n row-lists of floats (n×n).
// b: list of n floats.
// Returns list of n floats x such that Ax ≈ b.
// If A is singular, returns a list of zeros.
fn ls_solve(A, b) -> list
    let aug = _lsv_build_aug(A, b)
    _lsv_eliminate(aug)
    let ok = aug["ok"]
    if ok == 0
        let n = len(b)
        return [0.0 for _ in 0..n]
    let x = _lsv_back_sub(aug)
    return x

// ls_determinant — compute determinant of A via Gaussian elimination.
// The determinant equals the product of diagonal entries of the upper-
// triangular form, times the sign accumulated from row swaps.
fn ls_determinant(A) -> float
    let n = len(A)
    let bz = [0.0 for _ in 0..n]
    let aug = _lsv_build_aug(A, bz)
    _lsv_eliminate(aug)
    let ok = aug["ok"]
    if ok == 0
        return 0.0
    let det = 1.0
    for i in 0..n
        let d = _lsv_get(aug, i, i)
        det = det * d
    let s = aug["det_sign"]
    let si = s * 1
    let sf = si * 1.0
    let sdet = det * sf
    return sdet

// ls_is_singular — returns true (1) if A is numerically singular.
fn ls_is_singular(A) -> bool
    let n = len(A)
    let bz = [0.0 for _ in 0..n]
    let aug = _lsv_build_aug(A, bz)
    _lsv_eliminate(aug)
    let ok = aug["ok"]
    if ok == 0
        return 1
    return 0

fn main()
    print("linsolve module OK")
