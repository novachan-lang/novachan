// std/probability/prob_coin.nova — Exact fair-coin (Bernoulli p=1/2) probabilities.
// LEAF — imports NOTHING.
//
// All probabilities are exact reduced fractions [num, den] with den > 0
// and gcd(|num|, den) == 1.  Zero probability = [0, 1].
//
// Public API:
//   pc_ways_exactly(n, k)    -> int    C(n, k): ways to get exactly k heads in n flips
//   pc_total(n)              -> int    2^n: total outcomes for n flips
//   pc_prob_exactly(n, k)    -> list   [num, den] = C(n,k) / 2^n in lowest terms
//   pc_prob_at_least(n, k)   -> list   [num, den] = sum_{j=k}^{n} C(n,j) / 2^n

// _gcd — Euclidean GCD on non-negative integers.
fn _gcd(a: int, b: int) -> int
    let u = a
    if u < 0
        u = 0 - u
    let v = b
    if v < 0
        v = 0 - v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// _make — reduce p/q to lowest terms with den > 0.
fn _make(p: int, q: int) -> list
    let out = []
    if p == 0
        out.push(0)
        out.push(1)
        return out
    let ap = p
    if ap < 0
        ap = 0 - ap
    let aq = q
    if aq < 0
        aq = 0 - aq
    let g = _gcd(ap, aq)
    let rp = p / g
    let rq = q / g
    if rq < 0
        rp = 0 - rp
        rq = 0 - rq
    out.push(rp)
    out.push(rq)
    out

// _comb — C(n, k) via multiplicative formula with running integer division.
// result = 1; for i in 0..k-1: result = result*(n-i)/(i+1)
// Each division is exact because partial products of binomial are always integers.
fn _comb(n: int, k: int) -> int
    if k < 0
        return 0
    if k > n
        return 0
    // C(n,k) == C(n,n-k); use smaller k
    let kk = k
    if n - k < kk
        kk = n - k
    let val = 1
    for i in 0..kk
        val = val * (n - i) / (i + 1)
    val

// pc_ways_exactly — C(n, k): number of ways to get exactly k heads in n coin flips.
fn pc_ways_exactly(n: int, k: int) -> int
    _comb(n, k)

// pc_total — 2^n: total number of outcomes for n coin flips.
fn pc_total(n: int) -> int
    let acc = 1
    for i in 0..n
        acc = acc * 2
    acc

// pc_prob_exactly — P(X = k) for X ~ Binomial(n, 1/2); returns [num, den] reduced.
fn pc_prob_exactly(n: int, k: int) -> list
    let ways = _comb(n, k)
    let total = pc_total(n)
    _make(ways, total)

// pc_prob_at_least — P(X >= k) = sum_{j=k}^{n} C(n,j) / 2^n; returns [num, den] reduced.
fn pc_prob_at_least(n: int, k: int) -> list
    if k > n
        return _make(0, 1)
    if k <= 0
        return _make(1, 1)
    let total = pc_total(n)
    let sum_ways = 0
    let j = k
    while j <= n
        sum_ways += _comb(n, j)
        j += 1
    _make(sum_ways, total)
