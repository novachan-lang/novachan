// std/probability/prob_dice.nova — Exact discrete probability for sums of dice.
// LEAF — imports NOTHING.
//
// All probabilities are exact reduced fractions [num, den] with den > 0
// and gcd(|num|, den) == 1.  Zero probability = [0, 1].
//
// Public API:
//   pd_sum_ways(dice, sides, target)   -> int       number of ways N dice of S sides sum to target
//   pd_total_outcomes(dice, sides)     -> int       sides^dice
//   pd_sum_prob(dice, sides, target)   -> list      [num, den] = ways/total in lowest terms
//   pd_expected_sum_x2(dice, sides)    -> int       2 * E[sum] = dice * (sides + 1)  (avoids /2)

// _gcd — Euclidean GCD; works on non-negative integers.
fn _gcd(a: int, b: int) -> int
    let u = a
    if u < 0
        u = 0 - u
    let v = b
    if v < 0
        v = 0 - v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// _make — build fraction [p, q] in lowest terms with den > 0.
fn _make(p: int, q: int) -> list
    let out = []
    if p == 0
        out.push(0)
        out.push(1)
        return out
    let ap = p
    if ap < 0
        ap = 0 - ap
    let aq = q
    if aq < 0
        aq = 0 - aq
    let g = _gcd(ap, aq)
    let rp = p / g
    let rq = q / g
    // ensure denominator positive
    if rq < 0
        rp = 0 - rp
        rq = 0 - rq
    out.push(rp)
    out.push(rq)
    out

// pd_total_outcomes — sides^dice; exact integer.
fn pd_total_outcomes(dice: int, sides: int) -> int
    let acc = 1
    for i in 0..dice
        acc = acc * sides
    acc

// pd_sum_ways — number of ordered sequences of `dice` dice (each 1..sides) that sum to `target`.
// DP: dp[s] = ways to achieve sum s with the dice processed so far.
// Edge cases: dice<=0 or sides<=0 or target<dice or target>dice*sides => 0.
fn pd_sum_ways(dice: int, sides: int, target: int) -> int
    if dice <= 0
        return 0
    if sides <= 0
        return 0
    if target < dice
        return 0
    if target > dice * sides
        return 0
    // dp array indexed 0..dice*sides  (we only care up to dice*sides)
    let max_sum = dice * sides
    // initialise dp with zeros; indices 0..max_sum
    let dp = []
    let fill = 0
    while fill <= max_sum
        dp.push(0)
        fill += 1
    // after 0 dice: only sum=0 has 1 way
    dp[0] = 1
    // add each die
    for d in 0..dice
        // new_dp: ways after d+1 dice
        let new_dp = []
        let idx = 0
        while idx <= max_sum
            new_dp.push(0)
            idx += 1
        let s = 0
        while s <= max_sum
            if dp[s] != 0
                let face = 1
                while face <= sides
                    if s + face <= max_sum
                        new_dp[s + face] = new_dp[s + face] + dp[s]
                    face += 1
            s += 1
        dp = new_dp
    dp[target]

// pd_sum_prob — probability that `dice` dice (each 1..sides) sum to `target`, as [num, den].
fn pd_sum_prob(dice: int, sides: int, target: int) -> list
    let ways = pd_sum_ways(dice, sides, target)
    let total = pd_total_outcomes(dice, sides)
    if total == 0
        return _make(0, 1)
    _make(ways, total)

// pd_expected_sum_x2 — returns 2 * E[sum of dice] = dice * (sides + 1).
// Avoids integer division; caller divides by 2 if needed.
fn pd_expected_sum_x2(dice: int, sides: int) -> int
    dice * (sides + 1)
