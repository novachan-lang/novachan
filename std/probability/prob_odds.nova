// std/probability/prob_odds.nova — odds / probability conversion utilities.
// LEAF — imports NOTHING. All probabilities are exact reduced fractions [num,den].

// _gcd — greatest common divisor via Euclidean algorithm.
fn _gcd(a: int, b: int) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    return a

// _make — build reduced fraction [num, den] with den>0.
fn _make(n: int, d: int) -> any
    if d < 0
        n = 0 - n
        d = 0 - d
    if n == 0
        let r = []
        push(r, 0)
        push(r, 1)
        return r
    let g = _gcd(n, d)
    let r = []
    push(r, n / g)
    push(r, d / g)
    return r

// po_prob_to_odds — convert probability p=pnum/pden to odds a:b in favor (p:(1-p) reduced).
// Returns [a, b] such that a/b = pnum/(pden-pnum), fully reduced.
fn po_prob_to_odds(pnum: int, pden: int) -> any
    // odds favor = pnum : (pden - pnum)
    let a = pnum
    let b = pden - pnum
    if b == 0
        // p=1 → odds are infinity; return [1,0] convention
        let r = []
        push(r, 1)
        push(r, 0)
        return r
    if a == 0
        let r = []
        push(r, 0)
        push(r, 1)
        return r
    let g = _gcd(a, b)
    let r = []
    push(r, a / g)
    push(r, b / g)
    return r

// po_odds_to_prob — convert odds a:b in favor to probability a/(a+b).
fn po_odds_to_prob(a: int, b: int) -> any
    return _make(a, a + b)

// po_complement — 1 - p = (pden - pnum) / pden, reduced.
fn po_complement(pnum: int, pden: int) -> any
    return _make(pden - pnum, pden)

// po_and_independent — P(A and B) = p1 * p2 for independent events.
fn po_and_independent(p1n: int, p1d: int, p2n: int, p2d: int) -> any
    return _make(p1n * p2n, p1d * p2d)

// po_or_independent — P(A or B) = p1 + p2 - p1*p2 for independent events.
fn po_or_independent(p1n: int, p1d: int, p2n: int, p2d: int) -> any
    // = (p1n*p2d + p2n*p1d - p1n*p2n) / (p1d*p2d)
    let num = p1n * p2d + p2n * p1d - p1n * p2n
    let den = p1d * p2d
    return _make(num, den)
