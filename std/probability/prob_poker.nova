// std/probability/prob_poker.nova — exact 5-card poker hand counts over C(52,5)=2598960.
// LEAF — imports NOTHING. All counts are ints; probabilities are exact reduced fractions [num,den].

// _gcd — greatest common divisor via Euclidean algorithm.
fn _gcd(a: int, b: int) -> int
    if a < 0
        a = -a
    if b < 0
        b = -b
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    return a

// _make — build reduced fraction [num, den] with den>0.
fn _make(n: int, d: int) -> any
    if d < 0
        n = -n
        d = -d
    if n == 0
        let r = []
        push(r, 0)
        push(r, 1)
        return r
    let g = _gcd(n, d)
    let r = []
    push(r, n / g)
    push(r, d / g)
    return r

// _comb — C(n,k) via multiplicative formula with running integer division.
fn _comb(n: int, k: int) -> int
    if k < 0
        return 0
    if k > n
        return 0
    if k == 0
        return 1
    // Use smaller of k and n-k
    let kk = k
    if n - k < kk
        kk = n - k
    let result = 1
    for i in 0..kk
        result *= (n - i)
        result /= (i + 1)
    return result

// ppk_total — total 5-card hands from a 52-card deck: C(52,5).
fn ppk_total() -> int
    return _comb(52, 5)

// ppk_ways_four_kind — four of a kind: choose rank (13) * choose kicker (48 remaining cards).
fn ppk_ways_four_kind() -> int
    // 13 ranks * 48 kickers
    return 13 * 48

// ppk_ways_full_house — full house: choose rank for triple (13) * C(4,3) * choose rank for pair (12) * C(4,2).
fn ppk_ways_full_house() -> int
    return 13 * _comb(4, 3) * 12 * _comb(4, 2)

// ppk_ways_flush — plain flush (not straight flush, not royal flush): 4 suits * C(13,5) - 40 straight flushes.
fn ppk_ways_flush() -> int
    // Total flush hands = 4 * C(13,5)
    let total_flush = 4 * _comb(13, 5)
    // Straight flushes (including royal) = 4 suits * 10 straights
    let straight_flush = 4 * 10
    return total_flush - straight_flush

// ppk_ways_straight — plain straight (not straight flush): 10 * 4^5 total straights - 40 straight flushes.
fn ppk_ways_straight() -> int
    // Total straights (any suits) = 10 * 4^5 = 10240
    let total_straight = 10 * 4 * 4 * 4 * 4 * 4
    // Straight flushes = 40
    let straight_flush = 40
    return total_straight - straight_flush

// ppk_ways_two_pair — two pair: C(13,2) ways to pick 2 ranks * C(4,2)^2 suit choices * 44 kickers.
// The kicker must not match either pair rank: 52 - 4 - 4 = 44 cards.
fn ppk_ways_two_pair() -> int
    return _comb(13, 2) * _comb(4, 2) * _comb(4, 2) * 44

// ppk_prob — exact probability of any hand given its count; ways/C(52,5) reduced.
fn ppk_prob(ways: int) -> any
    return _make(ways, ppk_total())
