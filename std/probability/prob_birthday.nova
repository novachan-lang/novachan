// std/probability/prob_birthday.nova — birthday problem (exact fractions, without replacement).
// SELF-CONTAINED — imports NOTHING.
//
// Models placing `people` birthdays uniformly over `days` days WITHOUT replacement.
// Fractions are [num, den] lists reduced to lowest terms; den > 0 always.
//
// Public API:
//   pbd_no_collision(days, people)  -> [num,den]  P(all distinct) = days!/(days-people)! / days^people
//   pbd_collision(days, people)     -> [num,den]  P(at least one shared birthday) = 1 - no_collision
//   pbd_distinct_ways(days, people) -> int        falling factorial days*(days-1)*...*(days-people+1)

// _gcd — Euclidean GCD; always non-negative.
fn _gcd(a: int, b: int) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    return a

// _make — build a reduced fraction [num, den] with den > 0.
fn _make(n: int, d: int) -> any
    if d < 0
        n = 0 - n
        d = 0 - d
    if n == 0
        let r = [0, 1]
        return r
    let g = _gcd(n, d)
    if g < 0
        g = 0 - g
    if g == 0
        g = 1
    let r = [n / g, d / g]
    return r

// pbd_distinct_ways — falling factorial days*(days-1)*...*(days-people+1).
// Returns 0 if people > days or people < 0; returns 1 if people == 0.
fn pbd_distinct_ways(days: int, people: int) -> int
    if people < 0
        return 0
    if people == 0
        return 1
    if people > days
        return 0
    let acc = 1
    let i = 0
    while i < people
        acc = acc * (days - i)
        i = i + 1
    return acc

// _int_pow — raise base to power exp (non-negative).
fn _int_pow(base: int, exp: int) -> int
    if exp == 0
        return 1
    let acc = 1
    let i = 0
    while i < exp
        acc = acc * base
        i = i + 1
    return acc

// pbd_no_collision — P(all `people` birthdays are distinct over `days` days).
// Formula: (days * (days-1) * ... * (days-people+1)) / days^people.
// Returns [1,1] if people<=0, [0,1] if people>days.
fn pbd_no_collision(days: int, people: int) -> any
    if people <= 0
        return _make(1, 1)
    if people > days
        return _make(0, 1)
    if days <= 0
        return _make(0, 1)
    let num = pbd_distinct_ways(days, people)
    let den = _int_pow(days, people)
    return _make(num, den)

// pbd_collision — P(at least two of `people` share a birthday over `days` days).
// = 1 - pbd_no_collision(days, people).
fn pbd_collision(days: int, people: int) -> any
    if people <= 0
        return _make(0, 1)
    if people > days
        return _make(1, 1)
    if days <= 0
        return _make(1, 1)
    let nc = pbd_no_collision(days, people)
    // 1 - nc[0]/nc[1] = (nc[1] - nc[0]) / nc[1]
    return _make(nc[1] - nc[0], nc[1])
