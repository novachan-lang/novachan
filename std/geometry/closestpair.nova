// std/geometry/closestpair.nova — Closest pair of points (2-D, integer coords).
//
// Points are represented as 2-element lists [x, y] with integer coordinates.
// All private helpers are prefixed _cp_ to avoid collisions with other modules.
//
// API:
//   cp_closest_sq(points) -> int    Squared Euclidean distance of the closest pair
//   cp_closest(points)    -> float  Euclidean distance of the closest pair
//   cp_pair(points)       -> list   [[x1,y1],[x2,y2]] — one closest pair
//
// Algorithm: O(n^2) brute-force — correct for all n>=2.
//
// FLOAT HAZARDS obeyed:
//   sqrt() result ALWAYS bound to a named let before return.
//   Float abs via if/else (abs() on float returns int in NOVA).
//   No bare multi-term float expression as the final statement.

// _cp_sq_dist: squared Euclidean distance between points p and q (integer, exact).
fn _cp_sq_dist(p: list, q: list) -> int
    let dx = p[0] - q[0]
    let dy = p[1] - q[1]
    let r = dx * dx + dy * dy
    r

// cp_closest_sq: returns the squared distance of the closest pair.
// Requires at least 2 points.
fn cp_closest_sq(points: list) -> int
    let n = len(points)
    let best = -1
    for i in 0..n
        let j = i + 1
        while j < n
            let d = _cp_sq_dist(points[i], points[j])
            if best < 0
                best = d
            else
                if d < best
                    best = d
            j += 1
    best

// cp_closest: returns the Euclidean distance of the closest pair (float).
// Requires at least 2 points.
fn cp_closest(points: list) -> float
    let sq = cp_closest_sq(points)
    let fsq = sq * 1.0
    let r = sqrt(fsq)
    r

// cp_pair: returns a list [[x1,y1],[x2,y2]] — a closest pair of points.
// Requires at least 2 points.
fn cp_pair(points: list) -> list
    let n = len(points)
    let best = -1
    let bi = 0
    let bj = 1
    for i in 0..n
        let j = i + 1
        while j < n
            let d = _cp_sq_dist(points[i], points[j])
            if best < 0
                best = d
                bi = i
                bj = j
            else
                if d < best
                    best = d
                    bi = i
                    bj = j
            j += 1
    let pi = points[bi]
    let pj = points[bj]
    let result = [[pi[0], pi[1]], [pj[0], pj[1]]]
    result
