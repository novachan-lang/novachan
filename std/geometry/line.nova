// std/geometry/line.nova — Infinite lines in the form ax+by+c=0.
//
// A line is represented as a dict with string keys "a", "b", "c" (all int).
// Convention: given two points P1=(x1,y1) and P2=(x2,y2),
//   a = y1-y2,  b = x2-x1,  c = -(a*x1 + b*y1)
// so that a*x + b*y + c == 0 for all points on the line.
//
// FLOAT HAZARDS obeyed:
//   • Bind every sqrt/division float sub-expression to a named let.
//   • Float-vs-int compare is unsound; coerce ints with *1.0.
//   • Use abs(int) for integer absolute value.
//   • Single-exit pattern on every fn.
//
// Private helpers use the _ln_ prefix (unique to this module).
//
// Public API:
//   ln_from_points(p1, p2)          -> dict  {a,b,c} from two [x,y] points
//   ln_intersect(l1, l2)            -> list  [x,y] float, or [] if parallel
//   ln_dist_point(l, px, py)        -> float perpendicular distance (float)
//   ln_parallel(l1, l2)             -> bool  true iff lines are parallel
//   ln_side(l, px, py)              -> int   sign of a*px+b*py+c: -1, 0, or 1

// _ln_sign — sign of an integer: -1, 0, or 1.
fn _ln_sign(v: int) -> int
    let r = 0
    if v > 0
        r = 1
    else
        if v < 0
            r = -1
    r

// ln_from_points — build a line dict from two distinct [x,y] points.
// Uses the convention a=y1-y2, b=x2-x1, c=-(a*x1+b*y1).
// Result: {"a": int, "b": int, "c": int}.
fn ln_from_points(p1: list, p2: list) -> dict
    let x1 = p1[0]
    let y1 = p1[1]
    let x2 = p2[0]
    let y2 = p2[1]
    let a = y1 - y2
    let b = x2 - x1
    let ax1 = a * x1
    let by1 = b * y1
    let c = 0 - ax1 - by1
    let d = {}
    d["a"] = a
    d["b"] = b
    d["c"] = c
    d

// ln_parallel — true iff l1 and l2 are parallel (including identical).
// Two lines ax+by+c=0 and a'x+b'y+c'=0 are parallel iff a*b' - a'*b == 0.
fn ln_parallel(l1: dict, l2: dict) -> bool
    let a1 = l1["a"]
    let b1 = l1["b"]
    let a2 = l2["a"]
    let b2 = l2["b"]
    let det = a1 * b2 - a2 * b1
    let result = false
    if det == 0
        result = true
    result

// ln_intersect — intersection point of two lines as [x,y] floats.
// Returns [] if the lines are parallel (det == 0).
// Solves:  a1*x + b1*y = -c1
//          a2*x + b2*y = -c2
// via Cramer's rule:
//   det = a1*b2 - a2*b1
//   x   = (-c1*b2 + b1*c2)  / det  (but note sign: -c1 rhs)
//         = (-c1*b2 - b1*(-c2)) / det -- rearranged for clarity below
//   y   = (-a1*c2 + c1*a2)  / det
// Derivation check (det≠0):
//   num_x = (-c1)*b2 - b1*(-c2) = -c1*b2 + b1*c2
//   num_y = a1*(-c2) - (-c1)*a2 = -a1*c2 + c1*a2
fn ln_intersect(l1: dict, l2: dict) -> list
    let a1 = l1["a"]
    let b1 = l1["b"]
    let c1 = l1["c"]
    let a2 = l2["a"]
    let b2 = l2["b"]
    let c2 = l2["c"]
    let det = a1 * b2 - a2 * b1
    let result = []
    if det != 0
        let detf = det * 1.0
        let num_x = 0 - c1 * b2 + b1 * c2
        let num_y = 0 - a1 * c2 + c1 * a2
        let num_xf = num_x * 1.0
        let num_yf = num_y * 1.0
        let xi = num_xf / detf
        let yi = num_yf / detf
        push(result, xi)
        push(result, yi)
    result

// ln_dist_point — perpendicular distance from point (px,py) to line l.
// Formula: |a*px + b*py + c| / sqrt(a*a + b*b).
// Binds sqrt to a named let to avoid the uninit-float-slot bug.
fn ln_dist_point(l: dict, px: int, py: int) -> float
    let a = l["a"]
    let b = l["b"]
    let c = l["c"]
    let num = a * px + b * py + c
    let num_abs = abs(num)
    let num_f = num_abs * 1.0
    let aa = a * a
    let bb = b * b
    let denom_sq = aa + bb
    let denom_sqf = denom_sq * 1.0
    let denom = sqrt(denom_sqf)
    let dist = num_f / denom
    dist

// ln_side — which side of line l is point (px,py) on?
// Returns the sign of a*px + b*py + c: -1, 0, or 1.
fn ln_side(l: dict, px: int, py: int) -> int
    let a = l["a"]
    let b = l["b"]
    let c = l["c"]
    let val = a * px + b * py + c
    let r = _ln_sign(val)
    r
