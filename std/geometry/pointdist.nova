// std/geometry/pointdist.nova — Point distance metrics.
//
// Provides five distance functions between 2-D points and between a
// point and a line segment.  Integer coordinates; exact arithmetic used
// wherever possible so results are fragility-free.
//
// PRIVATE HELPER PREFIX: pd_  (unique per-module tag; public names share it)
//
// API:
//   pd_euclidean_sq(x1,y1,x2,y2) -> int   squared Euclidean distance (exact)
//   pd_euclidean(x1,y1,x2,y2)   -> float  Euclidean distance
//   pd_manhattan(x1,y1,x2,y2)   -> int    Manhattan / L1 distance
//   pd_chebyshev(x1,y1,x2,y2)   -> int    Chebyshev / L∞ distance
//   pd_point_to_segment(px,py,ax,ay,bx,by) -> float
//       Shortest distance from point P to segment A-B.

// pd_int_abs — private: absolute value of an integer.
fn pd_int_abs(v: int) -> int
    -v if v < 0 else v

// pd_int_max — private: maximum of two integers.
fn pd_int_max(a: int, b: int) -> int
    b if b > a else a

// pd_euclidean_sq — squared Euclidean distance between (x1,y1) and (x2,y2).
// Returns an exact integer: (x2-x1)^2 + (y2-y1)^2.
fn pd_euclidean_sq(x1: int, y1: int, x2: int, y2: int) -> int
    let dx = x2 - x1
    let dy = y2 - y1
    dx * dx + dy * dy

// pd_euclidean — Euclidean distance between (x1,y1) and (x2,y2).
// Binds sqrt to a let to avoid the uninit-float-slot compiler bug.
fn pd_euclidean(x1: int, y1: int, x2: int, y2: int) -> float
    let dx = x2 - x1
    let dy = y2 - y1
    let sq = dx * dx + dy * dy
    let fsq = sq * 1.0
    let d = sqrt(fsq)
    d

// pd_manhattan — Manhattan (L1) distance between (x1,y1) and (x2,y2).
// Returns |x2-x1| + |y2-y1| as an exact integer.
fn pd_manhattan(x1: int, y1: int, x2: int, y2: int) -> int
    let dx = pd_int_abs(x2 - x1)
    let dy = pd_int_abs(y2 - y1)
    dx + dy

// pd_chebyshev — Chebyshev (L∞) distance between (x1,y1) and (x2,y2).
// Returns max(|x2-x1|, |y2-y1|) as an exact integer.
fn pd_chebyshev(x1: int, y1: int, x2: int, y2: int) -> int
    let dx = pd_int_abs(x2 - x1)
    let dy = pd_int_abs(y2 - y1)
    pd_int_max(dx, dy)

// pd_point_to_segment — shortest distance from point P=(px,py) to segment A-B.
//
// Algorithm:
//   Let AB = B - A, AP = P - A.
//   t = dot(AP,AB) / dot(AB,AB), clamped to [0,1].
//   Closest point Q = A + t*(B-A).
//   Return |PQ|.
//
// Degenerate case (A==B): returns Euclidean distance from P to A.
//
// All intermediate values are floats; sqrt is bound to a let to avoid
// the uninit-float-slot compiler bug.
fn pd_point_to_segment(px: int, py: int, ax: int, ay: int, bx: int, by: int) -> float
    let abx = (bx - ax) * 1.0
    let aby = (by - ay) * 1.0
    let apx = (px - ax) * 1.0
    let apy = (py - ay) * 1.0
    let ab2 = abx * abx + aby * aby
    let result = 0.0
    if ab2 == 0.0
        // Degenerate segment: A == B; return distance to A.
        let ddx = (px - ax) * 1.0
        let ddy = (py - ay) * 1.0
        let dsq = ddx * ddx + ddy * ddy
        let dd = sqrt(dsq)
        result = dd
    else
        // t = dot(AP, AB) / |AB|^2, clamped to [0,1].
        let t = (apx * abx + apy * aby) / ab2
        let tc = 0.0 if t < 0.0 else (1.0 if t > 1.0 else t)
        // Closest point Q on segment.
        let qx = (ax * 1.0) + tc * abx
        let qy = (ay * 1.0) + tc * aby
        let fpx = px * 1.0
        let fpy = py * 1.0
        let diffx = fpx - qx
        let diffy = fpy - qy
        let dsq = diffx * diffx + diffy * diffy
        let dd = sqrt(dsq)
        result = dd
    result
