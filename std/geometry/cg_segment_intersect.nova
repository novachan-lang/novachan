// std/geometry/cg_segment_intersect.nova — Segment intersection tests (exact integer).
//
// A point is a 2-element integer list [x, y].
// All arithmetic is EXACT INTEGER — no floats, no rounding, no sqrt.
// Three predicates are provided:
//   cgs_on_segment   — collinear point lies within a segment's bounding box
//   cgs_intersects   — two segments share ANY point (including endpoints, overlap)
//   cgs_proper       — two segments cross at a single INTERIOR point (no endpoint/overlap)
//
// Algorithm: classical orientation-test based segment intersection.
// See Cormen et al., "Introduction to Algorithms", Section 33.1.
// LEAF — imports NOTHING.

// _cgs_cross: integer cross product of vectors OA and OB (from origin O).
// Returns (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0]).
fn _cgs_cross(o: list, a: list, b: list) -> int
    let ax = a[0] - o[0]
    let ay = a[1] - o[1]
    let bx = b[0] - o[0]
    let by = b[1] - o[1]
    let r = ax * by - ay * bx
    r

// _cgs_sign: sign of integer n: 1 if positive, -1 if negative, 0 if zero.
fn _cgs_sign(n: int) -> int
    if n > 0
        return 1
    if n < 0
        return -1
    0

// _cgs_between: true iff v is in the closed interval [lo, hi] (lo <= hi guaranteed).
fn _cgs_between(v: int, lo: int, hi: int) -> bool
    v >= lo and v <= hi

// cgs_on_segment: true iff point p lies on segment ab.
// Requires p, a, b to be collinear; also checks axis-aligned bounding box.
// Works correctly for degenerate segments (a == b).
fn cgs_on_segment(p: list, a: list, b: list) -> bool
    // First, p must be collinear with a and b.
    let cross = _cgs_cross(a, b, p)
    if cross != 0
        return false
    // Then p must lie within the bounding box of ab.
    let px = p[0]
    let py = p[1]
    let ax = a[0]
    let ay = a[1]
    let bx = b[0]
    let by = b[1]
    let xlo = ax
    let xhi = bx
    if bx < ax
        xlo = bx
        xhi = ax
    let ylo = ay
    let yhi = by
    if by < ay
        ylo = by
        yhi = ay
    _cgs_between(px, xlo, xhi) and _cgs_between(py, ylo, yhi)

// cgs_intersects: true iff segments p1p2 and p3p4 share ANY point.
// Handles: proper crossing, endpoint touching, collinear overlap.
fn cgs_intersects(p1: list, p2: list, p3: list, p4: list) -> bool
    let d1 = _cgs_cross(p3, p4, p1)
    let d2 = _cgs_cross(p3, p4, p2)
    let d3 = _cgs_cross(p1, p2, p3)
    let d4 = _cgs_cross(p1, p2, p4)
    let s1 = _cgs_sign(d1)
    let s2 = _cgs_sign(d2)
    let s3 = _cgs_sign(d3)
    let s4 = _cgs_sign(d4)
    // Proper crossing: each segment straddles the other's supporting line.
    if s1 != s2 and s3 != s4
        return true
    // Collinear / endpoint cases: check if any endpoint lies on the other segment.
    if d1 == 0 and cgs_on_segment(p1, p3, p4)
        return true
    if d2 == 0 and cgs_on_segment(p2, p3, p4)
        return true
    if d3 == 0 and cgs_on_segment(p3, p1, p2)
        return true
    if d4 == 0 and cgs_on_segment(p4, p1, p2)
        return true
    false

// cgs_proper: true iff segments p1p2 and p3p4 cross at a single INTERIOR point.
// Endpoints touching and collinear overlap are NOT counted as proper intersection.
fn cgs_proper(p1: list, p2: list, p3: list, p4: list) -> bool
    let d1 = _cgs_cross(p3, p4, p1)
    let d2 = _cgs_cross(p3, p4, p2)
    let d3 = _cgs_cross(p1, p2, p3)
    let d4 = _cgs_cross(p1, p2, p4)
    let s1 = _cgs_sign(d1)
    let s2 = _cgs_sign(d2)
    let s3 = _cgs_sign(d3)
    let s4 = _cgs_sign(d4)
    // Strictly opposite sides on both lines, and none of the four orientations is zero.
    s1 != s2 and s3 != s4 and s1 != 0 and s2 != 0 and s3 != 0 and s4 != 0
