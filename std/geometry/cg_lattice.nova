// std/geometry/cg_lattice.nova — Integer-lattice geometry (Pick's theorem and boundary count).
//
// Points are 2-element integer lists [x, y].  ALL arithmetic is EXACT INTEGER.
// Uses Pick's theorem: A = I + B/2 - 1  =>  I = (2A - B + 2) / 2
// where A = polygon area, B = boundary lattice points, I = interior lattice points.
//
// Public API:
//   cgll_gcd(a, b)              -> int   GCD of two non-negative integers.
//   cgll_boundary_points(poly)  -> int   Lattice points on the boundary (sum of gcd(|dx|,|dy|) per edge).
//   cgll_area_2x(poly)          -> int   2 * signed shoelace area (positive for CCW winding).
//   cgll_interior_points(poly)  -> int   Interior lattice points via Pick's theorem.
//
// Degenerate: 0, 1, or 2 vertices -> area_2x=0, boundary_points sums the edges present,
//             interior_points returns 0 (Pick's formula is undefined for degenerate polys;
//             we clamp to max(0, result) for safety).
//
// Private helpers prefixed _cgll_ to avoid collisions.
// LEAF — imports NOTHING.

// cgll_gcd: Euclidean GCD of two non-negative integers.
// cgll_gcd(0,0) = 0 by convention.
fn cgll_gcd(a: int, b: int) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    a

// cgll_boundary_points: number of integer lattice points ON the boundary of poly.
// For each edge from vertex i to vertex j: gcd(|dx|, |dy|) lattice segments, each
// contributing 1 lattice point (the starting vertex), so total = sum gcd(|dx|,|dy|).
fn cgll_boundary_points(poly: list) -> int
    let n = len(poly)
    let total = 0
    for i in 0..n
        let j = i + 1
        if j >= n
            j = 0
        let dx = poly[j][0] - poly[i][0]
        let dy = poly[j][1] - poly[i][1]
        if dx < 0
            dx = 0 - dx
        if dy < 0
            dy = 0 - dy
        let g = cgll_gcd(dx, dy)
        total = total + g
    total

// cgll_area_2x: twice the signed shoelace area of a polygon (exact integer).
// Returns positive for CCW winding, negative for CW winding.
fn cgll_area_2x(poly: list) -> int
    let n = len(poly)
    let s = 0
    for i in 0..n
        let j = i + 1
        if j >= n
            j = 0
        let xi = poly[i][0]
        let yi = poly[i][1]
        let xj = poly[j][0]
        let yj = poly[j][1]
        s = s + (xi * yj - xj * yi)
    s

// cgll_interior_points: number of interior integer lattice points via Pick's theorem.
// Pick's theorem: A = I + B/2 - 1  =>  I = (2A - B + 2) / 2
// 2A = |cgll_area_2x(poly)|, B = cgll_boundary_points(poly).
// Returns 0 for degenerate cases where Pick's formula yields a negative or zero result.
fn cgll_interior_points(poly: list) -> int
    let n = len(poly)
    if n < 3
        return 0
    let a2 = cgll_area_2x(poly)
    if a2 < 0
        a2 = 0 - a2
    let b = cgll_boundary_points(poly)
    // I = (2A - B + 2) / 2 — integer division (exact since 2A-B+2 is always even)
    let numerator = a2 - b + 2
    if numerator < 0
        return 0
    let result = numerator / 2
    result
