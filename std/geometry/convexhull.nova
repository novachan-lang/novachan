// std/geometry/convexhull.nova — 2D convex hull via Andrew's monotone chain.
//
// Points are 2-element integer lists [x, y].  All arithmetic is EXACT INTEGER:
// cross products, shoelace 2*area — no floats, no rounding error.
//
// Public API:
//   ch_hull(points)  -> list   Hull vertices in CCW order, starting from the
//                              lexicographically smallest point.  Collinear
//                              interior points are excluded (strict turns only).
//   ch_size(points)  -> int    Number of hull vertices.
//   ch_area2(points) -> int    2 * the hull area via the integer shoelace formula.
//
// Algorithm: O(n log n) via insertion sort + O(n) chain traversal.
// Private helpers are prefixed _cch_ (convex-chain-hull) to avoid collisions.
// LEAF — imports NOTHING.

// _cch_cross: integer cross product of vectors (O->A) and (O->B).
//   positive  -> CCW turn   (B is to the left of O->A)
//   zero      -> collinear
//   negative  -> CW turn    (B is to the right of O->A)
// Arguments are individual ints (extracted from lists by caller).
// UNANNOTATED ON PURPOSE, so this works for int AND float coordinates. It used to declare
// every parameter `int`, which made float input silently WRONG rather than rejected: raw
// double bits arrived at int-typed params and were compared as integers, so the hull of
// [[0.0,0.0],[2.0,0.0],[2.0,2.0],[0.0,2.0],[1.0,1.0]] came back with 2 vertices instead of 4.
// Leaving the types off keeps NOVA's dynamic arithmetic, which is the right call here: int
// operands stay EXACT (i64 multiply, no 53-bit mantissa rounding) while float operands work,
// whereas forcing everything to float would quietly lose precision on large integer coords.
fn _cch_cross(ox, oy, ax, ay, bx, by)
    let r = (ax - ox) * (by - oy) - (ay - oy) * (bx - ox)
    r

// _cch_pt_lt: true iff point p < point q lexicographically (x first, then y).
fn _cch_pt_lt(p: list, q: list) -> bool
    let px = p[0]
    let qx = q[0]
    if px < qx
        return true
    if px > qx
        return false
    let py = p[1]
    let qy = q[1]
    py < qy

// _cch_sort: in-place insertion sort of a list of [x,y] points by (x,y).
// Returns the list (same reference, mutated).
fn _cch_sort(pts: list) -> list
    let n = len(pts)
    let i = 1
    while i < n
        let key = pts[i]
        let j = i - 1
        while j >= 0 and _cch_pt_lt(key, pts[j])
            pts[j + 1] = pts[j]
            j -= 1
        pts[j + 1] = key
        i += 1
    pts

// _cch_build: core monotone chain builder.
// Returns the hull as a CCW list of [x,y] points.
// Collinear points are excluded (cross == 0 causes pop, keeping only endpoints).
fn _cch_build(sorted: list) -> list
    let n = len(sorted)
    // lower hull: sweep left-to-right.
    // Keep only strict left turns (cross > 0); pop on collinear or right turn.
    let lower = []
    for li in 0..n
        let done_l = false
        while len(lower) >= 2 and done_l == false
            let last = lower[len(lower) - 1]
            let prev = lower[len(lower) - 2]
            let ox = prev[0]
            let oy = prev[1]
            let ax = last[0]
            let ay = last[1]
            let bx = sorted[li][0]
            let by = sorted[li][1]
            let c = _cch_cross(ox, oy, ax, ay, bx, by)
            if c <= 0
                pop(lower)
            else
                done_l = true
        push(lower, sorted[li])
    // upper hull: sweep right-to-left.
    let upper = []
    let ui = n - 1
    while ui >= 0
        let done_u = false
        while len(upper) >= 2 and done_u == false
            let last = upper[len(upper) - 1]
            let prev = upper[len(upper) - 2]
            let ox = prev[0]
            let oy = prev[1]
            let ax = last[0]
            let ay = last[1]
            let bx = sorted[ui][0]
            let by = sorted[ui][1]
            let c = _cch_cross(ox, oy, ax, ay, bx, by)
            if c <= 0
                pop(upper)
            else
                done_u = true
        push(upper, sorted[ui])
        ui -= 1
    // Concatenate lower[0..len-2] + upper[0..len-2].
    // The last element of lower == first of upper (rightmost point);
    // the last element of upper == first of lower (leftmost point).
    let hull = []
    let hi = 0
    let ln = len(lower)
    while hi < ln - 1
        push(hull, lower[hi])
        hi += 1
    let hj = 0
    let un = len(upper)
    while hj < un - 1
        push(hull, upper[hj])
        hj += 1
    hull

// ch_hull: compute the convex hull of a set of 2D integer points.
// Returns hull vertices in CCW order starting from the lex-smallest point.
// Collinear interior points are NOT included (strict turns only).
// Degenerate inputs:
//   0 points -> []
//   1 point  -> [[x,y]]  (single vertex)
//   2 points -> [[x_min,y_min],[x_max,y_max]] after dedup
//   all collinear -> the two extreme endpoints
fn ch_hull(points: list) -> list
    let n = len(points)
    if n == 0
        return []
    if n == 1
        let p0 = points[0]
        return [[p0[0], p0[1]]]
    // Copy to avoid mutating the caller's list.
    let work = []
    for ci in 0..n
        let p = points[ci]
        push(work, [p[0], p[1]])
    _cch_sort(work)
    _cch_build(work)

// ch_size: number of vertices on the convex hull.
fn ch_size(points: list) -> int
    let h = ch_hull(points)
    len(h)

// ch_area2: twice the hull area via the integer shoelace formula.
// Result is always a non-negative integer.
// 2*area = |sum_i( x_i*y_{i+1} - x_{i+1}*y_i )|
fn ch_area2(points: list) -> int
    let h = ch_hull(points)
    let m = len(h)
    if m < 3
        return 0
    let s = 0
    for i in 0..m
        let j = i + 1
        if j >= m
            j = 0
        let xi = h[i][0]
        let yi = h[i][1]
        let xj = h[j][0]
        let yj = h[j][1]
        let term = xi * yj - xj * yi
        s += term
    if s < 0
        s = 0 - s
    s
