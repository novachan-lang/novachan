// std/geometry/cg_point_line.nova — Point-to-line/segment relations (exact integer arithmetic).
//
// Points are 2-element int lists [x,y]. Lines and segments are defined by two points.
// All results are exact: side is {-1,0,1}; distances are [num,den] rationals (GCD-reduced).
//
// Private helpers use prefix _cgpl_ to avoid symbol collisions.
//
// Public API (prefix cgpl_):
//   cgpl_side(pt, a, b)         -> int       1=left, -1=right, 0=on the line a→b
//   cgpl_dist_line_sq(pt, a, b) -> list      [num,den] squared dist to INFINITE line ab (GCD-reduced)
//   cgpl_dist_seg_sq(pt, a, b)  -> list      [num,den] squared dist to SEGMENT ab (GCD-reduced)
//
// LEAF — imports nothing.

// _cgpl_iabs: absolute value of an integer.
fn _cgpl_iabs(x: int) -> int
    -x if x < 0 else x

// _cgpl_gcd: greatest common divisor of two non-negative integers (Euclidean).
fn _cgpl_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = y
        y = x - (x / y) * y
        x = t
    x

// _cgpl_cross_ap_ab: cross product of vectors AP and AB.
// = (bx-ax)*(py-ay) - (by-ay)*(px-ax)
// This is the signed 2x area of the triangle A-B-P (positive = P is left of A→B).
fn _cgpl_cross_ap_ab(px: int, py: int, ax: int, ay: int, bx: int, by: int) -> int
    let dbx = bx - ax
    let dby = by - ay
    let dpx = px - ax
    let dpy = py - ay
    dbx * dpy - dby * dpx

// _cgpl_dot_ap_ab: dot product of vectors AP and AB.
// = (px-ax)*(bx-ax) + (py-ay)*(by-ay)
fn _cgpl_dot_ap_ab(px: int, py: int, ax: int, ay: int, bx: int, by: int) -> int
    let dpx = px - ax
    let dpy = py - ay
    let dbx = bx - ax
    let dby = by - ay
    dpx * dbx + dpy * dby

// _cgpl_ab_sq: squared length of segment AB.
// = (bx-ax)^2 + (by-ay)^2
fn _cgpl_ab_sq(ax: int, ay: int, bx: int, by: int) -> int
    let dx = bx - ax
    let dy = by - ay
    dx * dx + dy * dy

// _cgpl_dist_sq_pts: squared Euclidean distance between [x,y] points P and Q.
fn _cgpl_dist_sq_pts(p: list, q: list) -> int
    let dx = q[0] - p[0]
    let dy = q[1] - p[1]
    dx * dx + dy * dy

// _cgpl_reduce: reduce rational [num,den] by GCD to canonical form.
// den is always positive (we store dist², so num >= 0, den > 0).
fn _cgpl_reduce(num: int, den: int) -> list
    let g = _cgpl_gcd(num, den)
    [num / g, den / g]

// cgpl_side: which side of the directed line a→b is point pt on?
// Returns: 1 if pt is to the LEFT of a→b (cross product > 0),
//         -1 if pt is to the RIGHT (cross product < 0),
//          0 if pt is ON the line (cross product = 0).
// Cross product = (b-a) × (pt-a) = (bx-ax)*(pty-ay) - (by-ay)*(ptx-ax).
fn cgpl_side(pt: list, a: list, b: list) -> int
    let px = pt[0]
    let py = pt[1]
    let ax = a[0]
    let ay = a[1]
    let bx = b[0]
    let by = b[1]
    let cross = _cgpl_cross_ap_ab(px, py, ax, ay, bx, by)
    if cross > 0
        return 1
    if cross < 0
        return -1
    return 0

// cgpl_dist_line_sq: squared distance from pt to the INFINITE line through a and b.
// Formula: dist² = cross² / |ab|²  where cross = (b-a)×(pt-a).
// Returns [num,den] reduced by GCD. If a==b (degenerate line), returns dist² to the point a.
// The result is always a non-negative rational.
fn cgpl_dist_line_sq(pt: list, a: list, b: list) -> list
    let px = pt[0]
    let py = pt[1]
    let ax = a[0]
    let ay = a[1]
    let bx = b[0]
    let by = b[1]
    let absq = _cgpl_ab_sq(ax, ay, bx, by)
    if absq == 0
        // Degenerate: a == b; return squared distance to a.
        let dx = px - ax
        let dy = py - ay
        return [dx * dx + dy * dy, 1]
    let cross = _cgpl_cross_ap_ab(px, py, ax, ay, bx, by)
    let num = cross * cross
    // num >= 0 always (squared).
    if num == 0
        return [0, 1]
    return _cgpl_reduce(num, absq)

// cgpl_dist_seg_sq: squared distance from pt to the SEGMENT ab.
// Clamps to the nearest endpoint when the projection falls outside [0,1].
//
//   Let t = dot(AP, AB) / |AB|².
//   If t <= 0: nearest point is A  → dist² = |PA|²  as [|PA|², 1].
//   If t >= 1: nearest point is B  → dist² = |PB|²  as [|PB|², 1].
//   Otherwise: same as line formula → [cross², |AB|²] reduced.
//
// Degenerate case (a == b): returns squared distance to a.
fn cgpl_dist_seg_sq(pt: list, a: list, b: list) -> list
    let px = pt[0]
    let py = pt[1]
    let ax = a[0]
    let ay = a[1]
    let bx = b[0]
    let by = b[1]
    let absq = _cgpl_ab_sq(ax, ay, bx, by)
    if absq == 0
        // Degenerate: a == b.
        let dx = px - ax
        let dy = py - ay
        return [dx * dx + dy * dy, 1]
    let dot = _cgpl_dot_ap_ab(px, py, ax, ay, bx, by)
    if dot <= 0
        // Nearest point is A.
        let dx = px - ax
        let dy = py - ay
        return [dx * dx + dy * dy, 1]
    if dot >= absq
        // Nearest point is B.
        let dx = px - bx
        let dy = py - by
        return [dx * dx + dy * dy, 1]
    // Interior projection: cross² / |AB|².
    let cross = _cgpl_cross_ap_ab(px, py, ax, ay, bx, by)
    let num = cross * cross
    if num == 0
        return [0, 1]
    return _cgpl_reduce(num, absq)
