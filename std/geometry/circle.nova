// std/geometry/circle.nova
// Circle geometry operations.
// Exact integer arithmetic used for containment (squared distance vs r*r).
// Floats used for area, circumference, circumcircle radius.
// All float sub-expressions bound to named lets to avoid uninit-float-slot bug.
// Private helpers use the _crx_ prefix (unique to this module).
//
// Public API:
//   cr_area(r)                     -> float  pi*r*r
//   cr_circumference(r)            -> float  2*pi*r
//   cr_contains(cx,cy,r,px,py)    -> bool   point inside or on circle (integer squared-dist)
//   cr_intersect(c1,c2)            -> bool   two circles [cx,cy,r] intersect or touch
//   cr_from_3points(p1,p2,p3)     -> list   [cx,cy,r] float circumcircle

// cr_area: Area of a circle with radius r.
// Uses pi() builtin. Binds every float sub-expression to avoid uninit-slot bug.
fn cr_area(r)
    let p = pi()
    let rsq = r * r
    let a = p * rsq
    a

// cr_circumference: Circumference (perimeter) of a circle with radius r.
// 2 * pi * r, all bound to lets.
fn cr_circumference(r)
    let p = pi()
    let pr = p * r
    let c = 2.0 * pr
    c

// cr_contains: True if the point (px, py) lies inside or on the circle
// centred at (cx, cy) with radius r.
// Uses squared-distance vs r*r to stay in exact integers.
fn cr_contains(cx, cy, r, px, py)
    let dx = px - cx
    let dy = py - cy
    let dsq = dx * dx + dy * dy
    let rsq = r * r
    let result = dsq <= rsq
    result

// cr_intersect: True if two circles c1=[cx1,cy1,r1] and c2=[cx2,cy2,r2]
// intersect or touch.
// Circles intersect iff d <= r1+r2 AND d >= |r1-r2|.
// Compare squared values to stay integer-exact.
// Uses nested if to avoid boolean operator in expression position.
fn cr_intersect(c1, c2)
    let cx1 = c1[0]
    let cy1 = c1[1]
    let r1 = c1[2]
    let cx2 = c2[0]
    let cy2 = c2[1]
    let r2 = c2[2]
    let dx = cx2 - cx1
    let dy = cy2 - cy1
    let dsq = dx * dx + dy * dy
    let rsum = r1 + r2
    let rsumsq = rsum * rsum
    let rdiff = r1 - r2
    let rdiffsq = rdiff * rdiff
    let result = false
    if dsq <= rsumsq
        if dsq >= rdiffsq
            result = true
    result

// cr_from_3points: Circumcircle of three 2D points p1, p2, p3.
// Returns [cx, cy, r] as floats.
// Formula (Cartesian determinant form):
//   D  = 2*(x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2))
//   cx = [(x1^2+y1^2)*(y2-y3) + (x2^2+y2^2)*(y3-y1) + (x3^2+y3^2)*(y1-y2)] / D
//   cy = [(x1^2+y1^2)*(x3-x2) + (x2^2+y2^2)*(x1-x3) + (x3^2+y3^2)*(x2-x1)] / D
//   r  = distance from circumcenter to p1
// All intermediates bound to lets; sqrt bound to a let before return.
fn cr_from_3points(p1, p2, p3)
    let x1 = p1[0]
    let y1 = p1[1]
    let x2 = p2[0]
    let y2 = p2[1]
    let x3 = p3[0]
    let y3 = p3[1]
    let d_raw = 2 * (x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2))
    let d = d_raw * 1.0
    let m1 = (x1 * x1 + y1 * y1) * 1.0
    let m2 = (x2 * x2 + y2 * y2) * 1.0
    let m3 = (x3 * x3 + y3 * y3) * 1.0
    let y23 = (y2 - y3) * 1.0
    let y31 = (y3 - y1) * 1.0
    let y12 = (y1 - y2) * 1.0
    let x32 = (x3 - x2) * 1.0
    let x13 = (x1 - x3) * 1.0
    let x21 = (x2 - x1) * 1.0
    let cxn = m1 * y23 + m2 * y31 + m3 * y12
    let outcx = cxn / d
    let cyn = m1 * x32 + m2 * x13 + m3 * x21
    let outcy = cyn / d
    let ex = outcx - x1 * 1.0
    let ey = outcy - y1 * 1.0
    let rsq = ex * ex + ey * ey
    let outr = sqrt(rsq)
    let result = []
    push(result, outcx)
    push(result, outcy)
    push(result, outr)
    result
