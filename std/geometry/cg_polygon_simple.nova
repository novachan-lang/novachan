// std/geometry/cg_polygon_simple.nova — Simple-polygon predicate (no self-intersections).
//
// A polygon is SIMPLE if no two non-adjacent edges intersect and adjacent
// edges only meet at their shared vertex.
//
// Points are 2-element int lists [x,y]. The polygon is a list of points
// (no repeated closing vertex). All arithmetic is exact integer — no floats.
//
// Private helpers use prefix _cgms_ to avoid any symbol collisions.
//
// Public API (prefix cgm_):
//   cgm_edge_count(poly)            -> int    number of edges (= number of vertices)
//   cgm_is_simple(poly)             -> bool   true iff the polygon has no self-intersections
//   cgm_has_self_intersection(poly) -> bool   true iff NOT simple (n>=4 meaningful)
//
// LEAF — imports nothing.

// _cgms_imax2: integer maximum of two values.
fn _cgms_imax2(a: int, b: int) -> int
    let r = a
    if b > a
        r = b
    r

// _cgms_imin2: integer minimum of two values.
fn _cgms_imin2(a: int, b: int) -> int
    let r = a
    if b < a
        r = b
    r

// _cgms_orient: signed orientation of the ordered triple (ax,ay)->(bx,by)->(cx,cy).
// Returns the cross product (bx-ax)*(cy-ay) - (by-ay)*(cx-ax).
// Positive = CCW, negative = CW, zero = collinear.
fn _cgms_orient(ax: int, ay: int, bx: int, by: int, cx: int, cy: int) -> int
    let dbx = bx - ax
    let dby = by - ay
    let dcx = cx - ax
    let dcy = cy - ay
    let cross = dbx * dcy - dby * dcx
    cross

// _cgms_on_seg: true iff q=(qx,qy) lies on segment p=(px,py) to r=(rx,ry).
// Assumes p, q, r are collinear.
fn _cgms_on_seg(px: int, py: int, qx: int, qy: int, rx: int, ry: int) -> bool
    let minx = _cgms_imin2(px, rx)
    let maxx = _cgms_imax2(px, rx)
    let miny = _cgms_imin2(py, ry)
    let maxy = _cgms_imax2(py, ry)
    let xok = false
    if qx >= minx
        if qx <= maxx
            xok = true
    let yok = false
    if qy >= miny
        if qy <= maxy
            yok = true
    let result = false
    if xok
        if yok
            result = true
    result

// _cgms_segs_intersect: do segment A=(ax,ay)-(bx,by) and B=(cx,cy)-(dx,dy) intersect?
// Uses the standard 4-orientation algorithm (proper crossing + collinear cases).
fn _cgms_segs_intersect(ax: int, ay: int, bx: int, by: int, cx: int, cy: int, dx: int, dy: int) -> bool
    let o1 = _cgms_orient(ax, ay, bx, by, cx, cy)
    let o2 = _cgms_orient(ax, ay, bx, by, dx, dy)
    let o3 = _cgms_orient(cx, cy, dx, dy, ax, ay)
    let o4 = _cgms_orient(cx, cy, dx, dy, bx, by)
    // Proper crossing: each pair straddles the other segment.
    let result = false
    let cross_ab = false
    if o1 > 0 and o2 < 0
        cross_ab = true
    if o1 < 0 and o2 > 0
        cross_ab = true
    let cross_cd = false
    if o3 > 0 and o4 < 0
        cross_cd = true
    if o3 < 0 and o4 > 0
        cross_cd = true
    if cross_ab and cross_cd
        result = true
    // Collinear endpoint cases.
    if o1 == 0
        if _cgms_on_seg(ax, ay, cx, cy, bx, by)
            result = true
    if o2 == 0
        if _cgms_on_seg(ax, ay, dx, dy, bx, by)
            result = true
    if o3 == 0
        if _cgms_on_seg(cx, cy, ax, ay, dx, dy)
            result = true
    if o4 == 0
        if _cgms_on_seg(cx, cy, bx, by, dx, dy)
            result = true
    result

// _cgms_adj: true if indices i and j are adjacent in a polygon of n vertices
// (i.e., the two edges share exactly one vertex and that is expected contact).
// Adjacent means |i-j| == 1 (mod n) — handles wrap-around.
fn _cgms_adj(i: int, j: int, n: int) -> bool
    let diff = i - j
    if diff < 0
        diff = 0 - diff
    let wrap = n - diff
    let r = false
    if diff == 1
        r = true
    if wrap == 1
        r = true
    r

// cgm_edge_count: number of edges (and vertices) in a polygon.
// A polygon with n vertices has n edges (the last edge connects vertex n-1 back to 0).
fn cgm_edge_count(poly: list) -> int
    let n = len(poly)
    n

// cgm_is_simple: true iff the polygon has no self-intersections.
// For n < 3 the polygon is degenerate; return true (no crossings possible).
// For each pair of non-adjacent edges (i,i+1) and (j,j+1), check if they intersect
// (properly or via collinear overlap). Adjacent edges share a vertex, which is not
// a self-intersection, but for the intersection test we still exclude shared-vertex
// contact by checking adjacency: edges i and j are adjacent if i and j differ by 1
// (mod n), meaning they share a vertex.
fn cgm_is_simple(poly: list) -> bool
    let n = len(poly)
    let simple = true
    if n < 3
        simple = true
    else
        let i = 0
        while i < n and simple
            let i1 = i + 1
            if i1 >= n
                i1 = 0
            let ax = poly[i][0]
            let ay = poly[i][1]
            let bx = poly[i1][0]
            let by = poly[i1][1]
            // Check edge i against all non-adjacent edges j.
            let j = i + 2
            while j < n and simple
                // Edge j connects poly[j] and poly[j+1 mod n].
                let j1 = j + 1
                if j1 >= n
                    j1 = 0
                // Skip if edges i and j are adjacent (i=0 and j=n-1 share poly[0]).
                let skip = false
                if i == 0 and j == n - 1
                    skip = true
                if not skip
                    let cx = poly[j][0]
                    let cy = poly[j][1]
                    let dx = poly[j1][0]
                    let dy = poly[j1][1]
                    // For non-adjacent edges, any intersection (including shared endpoint)
                    // makes the polygon non-simple. But since we skip adjacent pairs
                    // (which would share exactly one endpoint), we use the full
                    // intersection test. A proper crossing OR collinear overlap = not simple.
                    // However, for the last-vs-first edge adjacency (i=0, j=n-1 would be
                    // adjacent), we also need to handle the case where the SHARED vertex
                    // check catches only the touching. For truly non-adjacent edges that
                    // happen to touch at a shared endpoint, it IS a self-intersection.
                    // Use the intersection test that detects proper crossings only for
                    // non-adjacent edges (endpoint-touch between non-adj = self-intersect).
                    let hits = _cgms_segs_intersect(ax, ay, bx, by, cx, cy, dx, dy)
                    if hits
                        simple = false
                j += 1
            i += 1
    simple

// cgm_has_self_intersection: true iff the polygon is not simple.
// Meaningful for n >= 4; for n < 4 returns false (no non-adjacent edge pairs exist).
fn cgm_has_self_intersection(poly: list) -> bool
    let s = cgm_is_simple(poly)
    let r = false
    if not s
        r = true
    r
