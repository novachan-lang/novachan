// ============================================================================
// std/adt/validated — error-accumulating "Validated" applicative
// ============================================================================
// NOVA already has a native `Result` (Ok/Err, fail-fast: `result_and_then`
// short-circuits on the FIRST error — see std/core/result.nova) and a native
// `Option` (Some/None — see std/core/opt.nova). Neither covers the classic
// "validate a form and report every broken field at once" case: Result's
// and_then chain stops at the first Err, so a caller only ever sees ONE
// error even when five fields are invalid. Validated fills that gap — it is
// a Result-shaped value that, when two or more failures are combined,
// ACCUMULATES every error message instead of discarding all but the first.
// This is the standard `Validation`/`Validated` pattern from Haskell's
// `Validation` package and Scala/Cats' `Validated` — deliberately NOT a
// monad (no `and_then`/bind — bind can only ever see one failure at a time
// by construction) but an applicative: combine independent checks with
// vda_map2 / vda_combine and every failure surfaces together.
//
// Representation (a plain NOVA dict, prefix `vda_` to stay collision-free —
// `vd_` is already taken by std/vector/vec_dot.nova):
//   ok:  {"vda_tag": "ok",  "vda_val": v,   "vda_errs": []}
//   err: {"vda_tag": "err", "vda_val": 0,   "vda_errs": [msg, ...]}
//
// Public API:
//   vda_ok(v)                 -> Validated        success wrapping v
//   vda_err(msg)               -> Validated        failure with a single message
//   vda_err_list(msgs)         -> Validated        failure with a list of messages
//   vda_is_ok(v)                -> int (1/0)
//   vda_is_err(v)                -> int (1/0)
//   vda_errors(v)                 -> list           all error messages (empty if ok)
//   vda_unwrap_or(v, default_val) -> value           the ok value, or default_val
//   vda_map(v, f)                  -> Validated       apply f to the ok value; err passes through
//   vda_map2(a, b, f)               -> Validated      combine two: ok iff BOTH ok, else the
//                                                      UNION of both sides' errors (even if
//                                                      only one side failed, or both did)
//   vda_combine(items)              -> Validated      fold a list<Validated> into
//                                                      Validated<list> — ok(list of every
//                                                      value) iff ALL are ok, else every
//                                                      error message from every failing
//                                                      element, in order
//
// LEAF module — imports nothing.
// ============================================================================

// vda_ok: wrap a successful value.
fn vda_ok(v)
    let r = {}
    r["vda_tag"] = "ok"
    r["vda_val"] = v
    r["vda_errs"] = []
    return r

// vda_err: a failure carrying a single error message.
fn vda_err(msg)
    let r = {}
    r["vda_tag"] = "err"
    r["vda_val"] = 0
    let errs = []
    errs.push(msg)
    r["vda_errs"] = errs
    return r

// vda_err_list: a failure carrying an already-built list of messages.
fn vda_err_list(msgs)
    let r = {}
    r["vda_tag"] = "err"
    r["vda_val"] = 0
    r["vda_errs"] = msgs
    return r

fn vda_is_ok(v)
    if v["vda_tag"] == "ok"
        return 1
    return 0

fn vda_is_err(v)
    if v["vda_tag"] == "err"
        return 1
    return 0

// vda_errors: every accumulated error message (empty list when ok).
fn vda_errors(v)
    return v["vda_errs"]

// vda_unwrap_or: the ok value, or default_val when err.
fn vda_unwrap_or(v, default_val)
    if v["vda_tag"] == "ok"
        return v["vda_val"]
    return default_val

// vda_map: apply f to the ok value; an err value passes through unchanged
// (its error list is untouched — mapping never clears failures).
fn vda_map(v, f)
    if v["vda_tag"] == "ok"
        return vda_ok(f(v["vda_val"]))
    return v

// vda_map2: combine two Validated values with a 2-arg function f.
// - both ok      -> ok(f(a_val, b_val))
// - either/both err -> err with EVERY message from BOTH sides concatenated
//   in order (a's errors first, then b's) — this is the accumulation step
//   that makes Validated useful: a caller combining N independent field
//   checks via repeated vda_map2 sees every broken field, not just the
//   first one encountered.
fn vda_map2(a, b, f)
    let a_ok = a["vda_tag"] == "ok"
    let b_ok = b["vda_tag"] == "ok"
    if a_ok and b_ok
        return vda_ok(f(a["vda_val"], b["vda_val"]))
    let merged = []
    if not a_ok
        let ae = a["vda_errs"]
        let i = 0
        while i < len(ae)
            merged.push(ae[i])
            i = i + 1
    if not b_ok
        let be = b["vda_errs"]
        let j = 0
        while j < len(be)
            merged.push(be[j])
            j = j + 1
    return vda_err_list(merged)

// vda_combine: fold a list of Validated values into one Validated<list>.
// ok(list-of-values) iff every element is ok (values in original order);
// otherwise err with every error message from every failing element
// concatenated in order — no short-circuiting, unlike Result's and_then
// chain, so a caller always sees the FULL set of problems in one pass.
fn vda_combine(items)
    let vals = []
    let errs = []
    let i = 0
    while i < len(items)
        let it = items[i]
        if it["vda_tag"] == "ok"
            vals.push(it["vda_val"])
        else
            let e = it["vda_errs"]
            let j = 0
            while j < len(e)
                errs.push(e[j])
                j = j + 1
        i = i + 1
    if len(errs) == 0
        return vda_ok(vals)
    return vda_err_list(errs)
