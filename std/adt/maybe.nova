// ============================================================================
// std/adt/maybe — Option/Maybe: a value that might be absent
// ============================================================================
// Where std/adt/either.nova models "one of two equally valid alternatives"
// and NOVA's native Result models "success or failure", Maybe models the
// simplest and most common case: a value that may or may not be present at
// all (a lookup that might miss, a field that might not have been set, an
// optional configuration knob). Using Maybe instead of a sentinel (0, "",
// -1) makes "absent" a distinct, checkable state instead of an ambiguous
// overload of a real value.
//
// Representation (a plain NOVA dict, prefix `may_`):
//   {"may_tag": "some", "may_val": v}
//   {"may_tag": "none", "may_val": 0}
//
// Public API:
//   may_some(v)                -> Maybe    wrap a present value
//   may_none()                 -> Maybe    the absent value
//   may_is_some(m)              -> bool
//   may_is_none(m)              -> bool
//   may_get(m, default_val)      -> value   unwrap, or default_val if none
//   may_unwrap(m)                -> value   unwrap (fatal: prints + exit(1) if none)
//   may_map(m, f)                -> Maybe   apply f to the value if some; none passes through
//   may_and_then(m, f)            -> Maybe   f: value -> Maybe; chain a fallible lookup
//   may_or_else(m, alt)            -> Maybe   m if some, else alt (another Maybe)
//   may_filter(m, pred)             -> Maybe   keep some only if pred(v) is true; else none
//   may_to_str(m)                  -> string  "Some(v)" or "None"
//
// LEAF module — imports nothing.
// ============================================================================

fn may_some(v)
    let m = {}
    m["may_tag"] = "some"
    m["may_val"] = v
    return m

fn may_none()
    let m = {}
    m["may_tag"] = "none"
    m["may_val"] = 0
    return m

fn may_is_some(m)
    if m["may_tag"] == "some"
        return true
    return false

fn may_is_none(m)
    if m["may_tag"] == "none"
        return true
    return false

// may_get: unwrap the value, or return default_val if this Maybe is none.
fn may_get(m, default_val)
    if m["may_tag"] == "some"
        return m["may_val"]
    return default_val

// may_unwrap: unwrap the value. Calling this on a none is a programmer
// error — it prints a diagnostic and terminates (exit code 1) rather than
// returning a silently-wrong value, matching the "fail loud" convention
// used across NOVA's other ADT helpers (see std/adt/either.nova).
fn may_unwrap(m)
    if m["may_tag"] == "some"
        return m["may_val"]
    print("may_unwrap: called on None")
    exit(1)

// may_map: apply f to the wrapped value if present; a none passes through.
fn may_map(m, f)
    if m["may_tag"] == "some"
        return may_some(f(m["may_val"]))
    return m

// may_and_then: chain a fallible lookup. f takes the wrapped value and
// returns a Maybe itself; a none passes through without calling f.
fn may_and_then(m, f)
    if m["may_tag"] == "some"
        return f(m["may_val"])
    return m

// may_or_else: m if it is some, otherwise the alternative Maybe alt.
fn may_or_else(m, alt)
    if m["may_tag"] == "some"
        return m
    return alt

// may_filter: keep a some only if pred(value) is true; otherwise (or if m
// was already none) return none.
fn may_filter(m, pred)
    if m["may_tag"] == "some"
        if pred(m["may_val"])
            return m
    return may_none()

// may_to_str: human-readable representation — "Some(v)" or "None".
fn may_to_str(m)
    if m["may_tag"] == "some"
        return "Some(" + str(m["may_val"]) + ")"
    return "None"
