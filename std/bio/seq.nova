// ============================================================================
// NOVA Standard Library — std/bio/seq
// ============================================================================
// DNA/RNA sequence basics: validation, complement, reverse complement,
// transcription, GC/AT content, base counting, Hamming distance, and
// Shannon entropy over base frequencies.
//
// SEQUENCES: strings of uppercase letters (DNA: A,C,G,T; RNA: A,C,G,U).
// All functions handle empty strings gracefully.
//
// PUBLIC API:
//   seq_validate(s)          -> bool   only ACGT (DNA)
//   seq_validate_rna(s)      -> bool   only ACGU (RNA)
//   seq_complement(s)        -> string A<->T, C<->G (DNA)
//   seq_reverse(s)           -> string reverse of string
//   seq_reverse_complement(s)-> string reverse of complement
//   seq_transcribe(s)        -> string DNA->RNA (T->U)
//   seq_back_transcribe(s)   -> string RNA->DNA (U->T)
//   seq_gc_content(s)        -> float  fraction G+C, 0.0 if empty
//   seq_at_content(s)        -> float  fraction A+T, 0.0 if empty
//   seq_base_count(s,base)   -> int    count of base in s
//   seq_base_freq(s)         -> any    dict base->count
//   seq_hamming(a,b)         -> int    mismatches; -1 if lengths differ
//   seq_shannon_entropy(s)   -> float  Shannon entropy over base freqs, bits
//
// PREFIX: seq_ (private helpers _seq_)
// ============================================================================

// _seq_complement_base: return complement of a single DNA base character.
// A<->T, C<->G; any other character returned as-is.
fn _seq_complement_base(c) -> string
    if c == "A"
        return "T"
    if c == "T"
        return "A"
    if c == "C"
        return "G"
    if c == "G"
        return "C"
    return c

// seq_validate: true iff every character in s is one of A, C, G, T.
// Empty string returns true (vacuously valid).
fn seq_validate(s) -> bool
    let n = len(s)
    let ok = true
    let i = 0
    while i < n and ok
        let c = char_at(s, i)
        if c != "A" and c != "C" and c != "G" and c != "T"
            ok = false
        i += 1
    return ok

// seq_validate_rna: true iff every character in s is one of A, C, G, U.
// Empty string returns true.
fn seq_validate_rna(s) -> bool
    let n = len(s)
    let ok = true
    let i = 0
    while i < n and ok
        let c = char_at(s, i)
        if c != "A" and c != "C" and c != "G" and c != "U"
            ok = false
        i += 1
    return ok

// seq_complement: return the DNA complement of s (A<->T, C<->G).
// Non-ACGT characters are preserved.
fn seq_complement(s) -> string
    let n = len(s)
    let result = ""
    for i in 0..n
        let c = char_at(s, i)
        result += _seq_complement_base(c)
    return result

// seq_reverse: return s reversed.
fn seq_reverse(s) -> string
    let n = len(s)
    let result = ""
    let i = n - 1
    while i >= 0
        result += char_at(s, i)
        i -= 1
    return result

// seq_reverse_complement: return the reverse complement of DNA string s.
// Equivalent to reverse(complement(s)).
fn seq_reverse_complement(s) -> string
    let comp = seq_complement(s)
    return seq_reverse(comp)

// seq_transcribe: transcribe DNA to RNA by replacing T with U.
fn seq_transcribe(s) -> string
    let n = len(s)
    let result = ""
    for i in 0..n
        let c = char_at(s, i)
        if c == "T"
            result += "U"
        else
            result += c
    return result

// seq_back_transcribe: reverse-transcribe RNA to DNA by replacing U with T.
fn seq_back_transcribe(s) -> string
    let n = len(s)
    let result_parts = []
    for i in 0..n
        let c = char_at(s, i)
        if c == "U"
            push(result_parts, "T")
        else
            push(result_parts, c)
    let result = join(result_parts, "")
    return result

// seq_gc_content: fraction of bases that are G or C. Returns 0.0 for empty.
fn seq_gc_content(s) -> float
    let n = len(s)
    if n == 0
        return 0.0
    let gc = 0
    for i in 0..n
        let c = char_at(s, i)
        if c == "G" or c == "C"
            gc += 1
    let gc_f = gc * 1.0
    let n_f = n * 1.0
    return gc_f / n_f

// seq_at_content: fraction of bases that are A or T. Returns 0.0 for empty.
fn seq_at_content(s) -> float
    let n = len(s)
    if n == 0
        return 0.0
    let at = 0
    for i in 0..n
        let c = char_at(s, i)
        if c == "A" or c == "T"
            at += 1
    let at_f = at * 1.0
    let n_f = n * 1.0
    return at_f / n_f

// seq_base_count: count occurrences of a single base character in s.
fn seq_base_count(s, base) -> int
    let n = len(s)
    let cnt = 0
    for i in 0..n
        if char_at(s, i) == base
            cnt += 1
    return cnt

// seq_base_freq: return a dict mapping each observed base to its count.
// Only bases present in s are included as keys.
fn seq_base_freq(s) -> any
    let d = {}
    let n = len(s)
    for i in 0..n
        let c = char_at(s, i)
        if c in d
            d[c] = d[c] + 1
        else
            d[c] = 1
    return d

// seq_hamming: count positions where a and b differ.
// Returns -1 if len(a) != len(b).
fn seq_hamming(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return -1
    let dist = 0
    for i in 0..na
        if char_at(a, i) != char_at(b, i)
            dist += 1
    return dist

// seq_shannon_entropy: Shannon entropy over base frequencies, in bits.
// H = -sum_b p(b)*log2(p(b)) over observed bases.
// Returns 0.0 for empty string or single-base string.
fn seq_shannon_entropy(s) -> float
    let n = len(s)
    if n == 0
        return 0.0
    let freqs = seq_base_freq(s)
    let ks = keys(freqs)
    let nk = len(ks)
    if nk <= 1
        return 0.0
    let ln2 = log(2.0)
    let h = 0.0
    let total = n * 1.0
    for i in 0..nk
        let base = ks[i]
        let cnt = freqs[base]
        let p = cnt * 1.0 / total
        let lp = log(p)
        let contrib = p * lp / ln2
        h -= contrib
    return h
