// std/physics/fluid_statics.nova — Fluid statics / hydrostatics formulas.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float literals have decimal points.
//   * Every multi-term float expression bound to named lets.
//   * abs(float) done via if x < 0.0 { 0.0 - x } else { x }.
//   * Single-exit pattern on every fn.
//
// Public API:
//   pressure(rho, g, h)       -> float  P = rho * g * h
//   hydrostatic(rho, h)       -> float  P = rho * 9.81 * h
//   buoyant_force(rho, vol)   -> float  F_b = rho * vol * 9.81
//   pascal_force(f1, a1, a2)  -> float  F_2 = f1 * a2 / a1  (Pascal's law)

// pressure: General pressure in a fluid column.
// P = rho * g * h  where g is provided by caller.
fn pressure(rho, g, h)
    let rg = rho * g
    let p = rg * h
    p

// hydrostatic: Pressure at depth h in water (g = 9.81 m/s^2).
// P = rho * 9.81 * h
fn hydrostatic(rho, h)
    let g = 9.81
    let rg = rho * g
    let p = rg * h
    p

// buoyant_force: Buoyant force on a submerged object (Archimedes' principle).
// F_b = rho * volume * g   (g = 9.81 m/s^2)
fn buoyant_force(rho, volume)
    let g = 9.81
    let rv = rho * volume
    let f = rv * g
    f

// pascal_force: Output force from a hydraulic system (Pascal's law).
// F_2 = F_1 * A_2 / A_1
fn pascal_force(f1, a1, a2)
    let num = f1 * a2
    let f2 = num / a1
    f2
