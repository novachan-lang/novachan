// std/physics/optics_geo.nova — Geometric optics formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   image_distance(obj_dist, focal)          -> float   1/(1/f - 1/do)
//   magnification(img_dist, obj_dist)        -> float   -di/do
//   snell_refraction_ratio(n1, theta1_sin, n2) -> float n1*sin(t1)/n2
//   mirror_focal(radius)                     -> float   R/2
//
// All distances in metres, angles as sine values (dimensionless).

// image_distance — thin-lens / mirror equation: 1/f = 1/do + 1/di  => di = 1/(1/f - 1/do).
fn image_distance(obj_dist, focal)
    let inv_f = 1.0 / focal
    let inv_o = 1.0 / obj_dist
    let inv_i = inv_f - inv_o
    let di = 1.0 / inv_i
    return di

// magnification — lateral magnification m = -di/do.
fn magnification(img_dist, obj_dist)
    let ratio = img_dist / obj_dist
    let m = -ratio
    return m

// snell_refraction_ratio — Snell's law: n1*sin(t1) = n2*sin(t2)  => sin(t2) = n1*sin(t1)/n2.
// Accepts sin(theta1) directly so callers avoid needing asin.
fn snell_refraction_ratio(n1, theta1_sin, n2)
    let num = n1 * theta1_sin
    let st2 = num / n2
    return st2

// mirror_focal — focal length of a spherical mirror: f = R/2.
fn mirror_focal(radius)
    let f = radius / 2.0
    return f
