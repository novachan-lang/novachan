// std/physics/thermodynamics.nova — thermodynamic formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   carnot_efficiency(t_cold, t_hot)          -> float   1 - t_cold/t_hot
//   heat_engine_efficiency(q_hot, q_cold)     -> float   1 - q_cold/q_hot
//   entropy_change(heat, temp)                -> float   heat/temp
//   work_isothermal(n, t, v2, v1)             -> float   n*R*T*ln(v2/v1)
//
// All temperatures in Kelvin, energies in Joules, volumes in m^3.

// carnot_efficiency — maximum theoretical efficiency = 1 - t_cold/t_hot.
fn carnot_efficiency(t_cold, t_hot)
    let ratio = t_cold / t_hot
    let eff = 1.0 - ratio
    return eff

// heat_engine_efficiency — actual efficiency = 1 - q_cold/q_hot.
fn heat_engine_efficiency(q_hot, q_cold)
    let ratio = q_cold / q_hot
    let eff = 1.0 - ratio
    return eff

// entropy_change — dS = Q/T.
fn entropy_change(heat, temp)
    let ds = heat / temp
    return ds

// work_isothermal — W = n*R*T*ln(v2/v1), R=8.314 J/(mol*K).
fn work_isothermal(n, t, v2, v1)
    let r = 8.314
    let nrt = n * r * t
    let lnv = log(v2 / v1)
    let w = nrt * lnv
    return w
