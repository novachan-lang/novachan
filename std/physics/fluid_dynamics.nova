// std/physics/fluid_dynamics.nova — Fluid dynamics formulas.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float literals have decimal points.
//   * Every multi-term float expression bound to named lets.
//   * abs(float) done via if x < 0.0 { 0.0 - x } else { x }.
//   * Single-exit pattern on every fn.
//
// Public API:
//   continuity_v2(a1, v1, a2) -> float  v2 = a1*v1 / a2  (continuity equation)
//   flow_rate(a, v)            -> float  Q = a * v
//   reynolds(rho, v, d, mu)   -> float  Re = rho*v*d / mu
//   dynamic_pressure(rho, v)  -> float  q = 0.5 * rho * v^2

// continuity_v2: Velocity at section 2 from continuity equation.
// A1*v1 = A2*v2  =>  v2 = A1*v1 / A2
fn continuity_v2(a1, v1, a2)
    let num = a1 * v1
    let v2 = num / a2
    v2

// flow_rate: Volumetric flow rate.
// Q = A * v
fn flow_rate(a, v)
    let q = a * v
    q

// reynolds: Reynolds number (dimensionless).
// Re = rho * v * d / mu
fn reynolds(rho, v, d, mu)
    let rvd = rho * v
    let rvd2 = rvd * d
    let re = rvd2 / mu
    re

// dynamic_pressure: Dynamic pressure in a moving fluid.
// q = 0.5 * rho * v^2
fn dynamic_pressure(rho, v)
    let vsq = v * v
    let half = 0.5
    let rhoh = rho * half
    let q = rhoh * vsq
    q
