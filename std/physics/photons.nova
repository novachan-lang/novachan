// std/physics/photons.nova — photon / quantum optics formulas (SI units).
// LEAF — imports NOTHING.
//
// Public API:
//   h()                  -> float   Planck's constant ~6.626e-34 J*s
//   c()                  -> float   speed of light    ~2.998e8  m/s
//   photon_energy(freq)  -> float   E = h * f
//   photon_wavelength(e) -> float   lambda = h*c / E
//   ev_to_joules(ev)     -> float   J = ev * 1.602e-19

// h — Planck's constant in J*s.
fn h()
    let val = 6.626 * pow(10.0, -34.0)
    return val

// c — speed of light in m/s.
fn c()
    let val = 2.998 * pow(10.0, 8.0)
    return val

// photon_energy — E = h * f.
fn photon_energy(freq)
    let hval = h()
    let e = hval * freq
    return e

// photon_wavelength — lambda = h*c / E.
fn photon_wavelength(energy)
    let hval = h()
    let cval = c()
    let hc = hval * cval
    let lam = hc / energy
    return lam

// ev_to_joules — convert electron-volts to joules.
// 1 eV = 1.602e-19 J
fn ev_to_joules(ev)
    let factor = 1.602 * pow(10.0, -19.0)
    let joules = ev * factor
    return joules
