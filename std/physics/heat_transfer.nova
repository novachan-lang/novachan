// std/physics/heat_transfer.nova — heat transfer formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   conduction(k, area, delta_t, thickness)   -> float   Fourier: Q/t = k*A*dT/L
//   radiation_power(emissivity, area, temp)   -> float   Stefan-Boltzmann: P = e*sigma*A*T^4
//   newton_cooling_rate(h, area, delta_t)     -> float   Newton: Q/t = h*A*dT
//   thermal_resistance(thickness, k, area)    -> float   R = L/(k*A)
//
// SI units: W/(m*K), m^2, K, m, W/m^2/K.

// conduction — Fourier's law: heat flow rate = k*area*delta_T/thickness.
fn conduction(k, area, delta_t, thickness)
    let numerator = k * area * delta_t
    let rate = numerator / thickness
    return rate

// radiation_power — Stefan-Boltzmann: P = emissivity * sigma * area * T^4.
// sigma = 5.67e-8 W/(m^2*K^4)
fn radiation_power(emissivity, area, temp)
    let sigma = 5.67 * pow(10.0, -8.0)
    let t4 = pow(temp, 4.0)
    let p = emissivity * sigma * area * t4
    return p

// newton_cooling_rate — Newton's law of cooling: Q/t = h*area*delta_T.
fn newton_cooling_rate(h, area, delta_t)
    let rate = h * area * delta_t
    return rate

// thermal_resistance — R = thickness / (k * area).
fn thermal_resistance(thickness, k, area)
    let denom = k * area
    let r = thickness / denom
    return r
