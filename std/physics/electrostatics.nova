// std/physics/electrostatics.nova — Electrostatic formulas (Coulomb's law).
// LEAF — imports NOTHING.
//
// Public API:
//   k()                           -> float   Coulomb's constant (N*m^2/C^2)
//   coulomb_force(q1, q2, r)      -> float   F = k * q1 * q2 / r^2
//   electric_field(q, r)          -> float   E = k * q / r^2
//   electric_potential(q, r)      -> float   V = k * q / r
//   capacitance(charge, voltage)  -> float   C = Q / V
//
// Units: SI (Coulombs, Newtons, Volts, Farads, metres).

// k — Coulomb's electrostatic constant (approx 8.99 * 10^9 N*m^2/C^2).
fn k()
    let k10 = pow(10.0, 9.0)
    let kval = 8.99 * k10
    return kval

// coulomb_force — F = k * q1 * q2 / r^2.
// Positive result = repulsive; negative = attractive.
fn coulomb_force(q1, q2, r)
    let kval = k()
    let r2 = r * r
    let num = kval * q1 * q2
    let f = num / r2
    return f

// electric_field — E = k * q / r^2 (magnitude).
fn electric_field(q, r)
    let kval = k()
    let r2 = r * r
    let num = kval * q
    let e = num / r2
    return e

// electric_potential — V = k * q / r.
fn electric_potential(q, r)
    let kval = k()
    let num = kval * q
    let v = num / r
    return v

// capacitance — C = Q / V.
// Caller must ensure voltage != 0.0.
fn capacitance(charge, voltage)
    let c = charge / voltage
    return c
