// std/physics/friction.nova
// Friction and inclined-plane formulas.
// g = 9.81 m/s^2 inlined where needed.
// All float sub-expressions bound to named lets to avoid uninit-float-slot bug.
//
// Public API:
//   friction_force(mu, normal)              -> float  f = mu * N
//   kinetic_friction(mu_k, n)               -> float  f_k = mu_k * n  (alias)
//   incline_normal(m, angle_deg)            -> float  N = m*g*cos(theta)
//   incline_gravity_component(m, angle_deg) -> float  F_g = m*g*sin(theta)

// friction_force: Static or kinetic friction force.
// f = mu * N where mu is the friction coefficient and N is the normal force.
fn friction_force(mu, normal)
    let f = mu * normal
    f

// kinetic_friction: Kinetic friction force (alias for friction_force).
fn kinetic_friction(mu_k, n)
    let f = mu_k * n
    f

// incline_normal: Normal force on mass m on an incline of angle_deg degrees.
// N = m * g * cos(theta)
// deg_to_rad inlined: theta = d * pi / 180.0
fn incline_normal(m, angle_deg)
    let g = 9.81
    let pi = 3.14159265358979
    let ratio = pi / 180.0
    let theta = angle_deg * ratio
    let ct = cos(theta)
    let mg = m * g
    let n = mg * ct
    n

// incline_gravity_component: Component of gravity along the incline surface.
// F_g = m * g * sin(theta)
// deg_to_rad inlined.
fn incline_gravity_component(m, angle_deg)
    let g = 9.81
    let pi = 3.14159265358979
    let ratio = pi / 180.0
    let theta = angle_deg * ratio
    let st = sin(theta)
    let mg = m * g
    let fg = mg * st
    fg
