// std/physics/optics_wave.nova — Wave optics formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   double_slit_fringe(wavelength, dist_screen, slit_sep) -> float  y = lambda*L/d
//   critical_angle_sin(n1, n2)                            -> float  sin(tc) = n2/n1
//   grating_angle_sin(order, wavelength, spacing)         -> float  sin(t) = m*lambda/d
//
// SI units throughout (metres, dimensionless ratios).

// double_slit_fringe — fringe spacing on screen: y = lambda * L / d.
// wavelength in m, dist_screen in m, slit_sep in m -> fringe spacing in m.
fn double_slit_fringe(wavelength, dist_screen, slit_sep)
    let num = wavelength * dist_screen
    let y = num / slit_sep
    return y

// critical_angle_sin — sine of total-internal-reflection critical angle: sin(tc) = n2/n1.
// n1 must be the denser medium (n1 > n2).
fn critical_angle_sin(n1, n2)
    let s = n2 / n1
    return s

// grating_angle_sin — diffraction grating condition: d*sin(t) = m*lambda => sin(t) = m*lambda/d.
// order is diffraction order (integer as float), wavelength in m, spacing in m.
fn grating_angle_sin(order, wavelength, spacing)
    let num = order * wavelength
    let s = num / spacing
    return s
