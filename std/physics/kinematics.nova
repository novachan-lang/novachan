// std/physics/kinematics.nova — 1-D kinematic equations (SUVAT).
// LEAF — imports NOTHING.
//
// Public API:
//   final_velocity(u, a, t)  -> float   v = u + a*t
//   displacement(u, a, t)    -> float   s = u*t + 0.5*a*t^2
//   v_squared(u, a, s)       -> float   v^2 = u^2 + 2*a*s
//   time_to_reach(u, v, a)   -> float   t = (v - u) / a
//
// All angles/units are SI (m/s, m/s^2, s, m).

// final_velocity — v = u + a*t.
fn final_velocity(u, a, t)
    let at = a * t
    let v = u + at
    return v

// displacement — s = u*t + 0.5*a*t^2.
fn displacement(u, a, t)
    let ut = u * t
    let half_at2 = 0.5 * a * t * t
    let s = ut + half_at2
    return s

// v_squared — v^2 = u^2 + 2*a*s.
fn v_squared(u, a, s)
    let u2 = u * u
    let two_as = 2.0 * a * s
    let v2 = u2 + two_as
    return v2

// time_to_reach — t = (v - u) / a.
// Caller must ensure a != 0.0.
fn time_to_reach(u, v, a)
    let dv = v - u
    let t = dv / a
    return t
