// std/physics/relativity.nova — Special relativity formulas.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float literals have decimal points.
//   * Every multi-term float expression bound to named lets.
//   * abs(float) done via if x < 0.0 { 0.0 - x } else { x }.
//   * Single-exit pattern on every fn.
//   * Scientific literals written as base / pow(10.0, exp) where needed.
//
// Public API:
//   C()                    -> float  Speed of light in m/s (299792458.0)
//   lorentz_factor(v)      -> float  gamma = 1 / sqrt(1 - v^2/c^2)
//   time_dilation(t, v)    -> float  t' = t * gamma
//   length_contraction(l, v) -> float  l' = l / gamma
//   mass_energy(m)         -> float  E = m * c^2

// C: Speed of light in m/s.
fn C()
    let c = 299792458.0
    c

// lorentz_factor: Lorentz factor gamma = 1 / sqrt(1 - v^2/c^2).
// For v=0 this returns exactly 1.0; for v>0 returns >1.0.
fn lorentz_factor(v)
    let c = C()
    let vsq = v * v
    let csq = c * c
    let ratio = vsq / csq
    let inner = 1.0 - ratio
    let sq = sqrt(inner)
    let gamma = 1.0 / sq
    gamma

// time_dilation: Dilated time t' = t * gamma.
fn time_dilation(t, v)
    let gamma = lorentz_factor(v)
    let tp = t * gamma
    tp

// length_contraction: Contracted length l' = l / gamma.
fn length_contraction(l, v)
    let gamma = lorentz_factor(v)
    let lp = l / gamma
    lp

// mass_energy: Rest energy E = m * c^2.
fn mass_energy(m)
    let c = C()
    let csq = c * c
    let e = m * csq
    e
