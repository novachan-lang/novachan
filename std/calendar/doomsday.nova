// ============================================================================
// NOVA Standard Library — std/calendar/doomsday
// Day-of-week via JDN arithmetic and Conway's Doomsday rule.
// Pure integer arithmetic, no libc calls.
//
// ENCODING: 0=Sunday, 1=Monday, 2=Tuesday, 3=Wednesday,
//           4=Thursday, 5=Friday, 6=Saturday
//
// PUBLIC API:
//   day_of_week(y, m, d)   -> int    (0=Sunday .. 6=Saturday)
//   day_name(dow)          -> string  (0->"Sunday" .. 6->"Saturday")
//   doomsday_of_year(y)    -> int    (0=Sunday .. 6=Saturday)
//
// IMPLEMENTATION:
//   day_of_week uses Julian Day Number arithmetic (exact, handles all dates).
//   doomsday_of_year computes the Doomsday anchor day for year y — the
//   day-of-week shared by 4/4, 6/6, 8/8, 10/10, 12/12, last-day-of-Feb,
//   and the 5th of May(9), Sep(5), Jul(11), Nov(7).
// ============================================================================

// _greg_to_jdn: proleptic Gregorian date to Julian Day Number.
fn _greg_to_jdn(y, m, d) -> int
    let a = (14 - m) / 12
    let yy = y + 4800 - a
    let mm = m + 12 * a - 3
    d + (153 * mm + 2) / 5 + 365 * yy + yy / 4 - yy / 100 + yy / 400 - 32045

// day_of_week: returns 0=Sunday .. 6=Saturday for Gregorian date (y, m, d).
//
// JDN arithmetic: JDN % 7 gives 0=Mon .. 6=Sun.
// Convert to Sun=0 encoding: (jdn % 7 + 1) % 7
//
// This is equivalent to Conway's Doomsday algorithm but uses the exact JDN
// formula, which handles all dates including proleptic and historical dates.
fn day_of_week(y, m, d) -> int
    let jdn = _greg_to_jdn(y, m, d)
    let r = jdn % 7
    // r: 0=Mon,1=Tue,2=Wed,3=Thu,4=Fri,5=Sat,6=Sun
    // target: 0=Sun,1=Mon,...,6=Sat
    (r + 1) % 7

// day_name: English name for day-of-week integer (0=Sunday .. 6=Saturday).
fn day_name(dow) -> string
    let table = {"0": "Sunday", "1": "Monday", "2": "Tuesday", "3": "Wednesday", "4": "Thursday", "5": "Friday"}
    let k = str(dow)
    table[k] if k in table else "Saturday"

// doomsday_of_year: the Doomsday anchor day for year y.
//
// The "Doomsday" is the day-of-week shared by a set of easily-remembered
// dates within any given year (Conway's Doomsday rule mnemonic anchor).
// Anchor dates: 4/4, 6/6, 8/8, 10/10, 12/12, last day of February,
// and 5/9, 9/5, 7/11, 11/7 ("I work 9-to-5 at the 7-11").
//
// We compute it as day_of_week of April 4 (4/4), which is always a Doomsday.
fn doomsday_of_year(y) -> int
    day_of_week(y, 4, 4)
