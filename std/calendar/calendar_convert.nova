// std/calendar/calendar_convert.nova — Calendar conversion utilities via JDN.
// Imports: std/calendar/julian_day (greg_to_jdn, jdn_to_greg).
//
// Public API:
//   via_jdn_greg_to_greg(y, m, d) -> list  Identity round-trip through JDN (returns [y,m,d])
//   days_between(y1,m1,d1,y2,m2,d2) -> int Signed difference in days (d2-d1); pos if d2>d1
//   add_days(y, m, d, n)           -> list [y,m,d] after adding n days (n may be negative)
//
// All calendar arithmetic is performed through the Julian Day Number as the
// universal integer pivot, guaranteeing consistency across all calendar systems.
//
// PRIVATE prefix: _cc_

// _cc_fdiv — floor division toward -infinity (needed for negative JDN correction).
fn _cc_fdiv(a, b)
    let q = a / b
    if (a < 0) != (b < 0)
        if a - q * b != 0
            return q - 1
    q

// _cc_greg_to_jdn — inline copy of greg_to_jdn (avoids cross-import dependency).
// Proleptic Gregorian (y, m, d) -> Julian Day Number.
fn _cc_greg_to_jdn(y, m, d)
    let a = (14 - m) / 12
    let yy = y + 4800 - a
    let mm = m + 12*a - 3
    return d + (153*mm + 2)/5 + 365*yy + yy/4 - yy/100 + yy/400 - 32045

// _cc_jdn_to_greg — inline copy of jdn_to_greg (Richards algorithm).
// Returns [year, month, day].
fn _cc_jdn_to_greg(jdn)
    let f = jdn + 1401 + (_cc_fdiv(_cc_fdiv(4*jdn + 274277, 146097) * 3, 4)) - 38
    let e = 4*f + 3
    let g = (e - (e/1461)*1461) / 4
    let h = 5*g + 2
    let hdiv = h / 153
    let day = (h - hdiv*153) / 5 + 1
    let month = (hdiv + 2) - ((hdiv + 2) / 12) * 12 + 1
    let year = _cc_fdiv(e, 1461) - 4716 + (14 - month) / 12
    let result = []
    push(result, year)
    push(result, month)
    push(result, day)
    return result

// via_jdn_greg_to_greg — Identity round-trip: Greg -> JDN -> Greg.
// Useful as a correctness probe and as the canonical conversion dispatcher.
fn via_jdn_greg_to_greg(y, m, d)
    let jdn = _cc_greg_to_jdn(y, m, d)
    _cc_jdn_to_greg(jdn)

// days_between — Signed number of days from (y1,m1,d1) to (y2,m2,d2).
// Positive when the second date is strictly later.
fn days_between(y1, m1, d1, y2, m2, d2)
    let j1 = _cc_greg_to_jdn(y1, m1, d1)
    let j2 = _cc_greg_to_jdn(y2, m2, d2)
    j2 - j1

// add_days — Add n days to (y, m, d); n may be negative.
// Returns [year, month, day].
fn add_days(y, m, d, n)
    let jdn = _cc_greg_to_jdn(y, m, d) + n
    _cc_jdn_to_greg(jdn)
