// ============================================================================
// NOVA Standard Library — std/calendar/hebrew
// Hebrew (Jewish) calendar conversions via Julian Day Number.
//
// The Hebrew calendar is a lunisolar calendar based on the 19-year Metonic cycle
// (7 leap years per 19 years) and the molad (mean conjunction).
//
// Key constants:
//   - Epoch: 1 Tishri 1 AM = JDN 347997 (Julian proleptic)
//     (or equivalently: anno mundi 1 = 7 Oct 3761 BCE proleptic Julian)
//   - Molad of epoch (Tohu): 2d 5h 204p  (day=Mon, hour=5, parts=204)
//   - Molad period: 29d 12h 793p  (mean lunar month = 765433 parts)
//   - 1 hour = 1080 parts (chalakim); 1 day = 25920 parts
//
// Months (non-leap year, 12 months):
//   1=Nisan, 2=Iyyar, 3=Sivan, 4=Tammuz, 5=Av, 6=Elul,
//   7=Tishri, 8=Cheshvan, 9=Kislev, 10=Tevet, 11=Shevat, 12=Adar
// Leap year (13 months): month 13 = Adar II inserted after Adar I (month 12).
//
// Year starts at Tishri (month 7 in biblical order, month 1 in the civil year).
// To simplify, this module uses the civil year start: Tishri = month 1.
// So month numbering is: 1=Tishri, 2=Cheshvan, 3=Kislev, 4=Tevet, 5=Shevat,
//   6=Adar I, 7=Adar II (leap only), 8=Nisan, 9=Iyyar, 10=Sivan, 11=Tammuz,
//   12=Av, 13=Elul (non-leap: month 7=Adar→12 months total)
//
// Actually the STANDARD convention used in most calendrical libraries is:
//   Month 1=Nisan (biblical) ... but the Hebrew year starts at Tishri.
// We follow the ASTRONOMICAL convention (used in Calendrical Calculations):
//   Months numbered from Tishri=1 (civil new year order).
//
// PUBLIC API:
//   hebrew_to_jdn(y, m, d) -> int   convert Hebrew date to JDN
//   jdn_to_hebrew(jdn)     -> list  [y, m, d]
//   hebrew_is_leap(y)      -> bool  true if y has 13 months
// ============================================================================

// hebrew_is_leap: true if Hebrew year y is a leap year.
// Leap years in the 19-year Metonic cycle: 3,6,8,11,14,17,19.
// Equivalent to: (7*y + 1) mod 19 < 7
fn hebrew_is_leap(y) -> bool
    (7 * y + 1) % 19 < 7

// ── Molad / elapsed days calculations ─────────────────────────────────────
// Parts per hour = 1080; parts per day = 25920
// Molad period = 765433 parts (29d 12h 793p)
// Molad of epoch (Tohu) = 2*25920 + 5*1080 + 204 = 51840+5400+204 = 57444 parts from Sat midnight

// _elapsed_months: number of months elapsed from epoch to start of Hebrew year y.
// In 19 years there are 235 months (12*19 + 7 leap months).
// floor((235*(y-1) + 1) / 19) ... actually the standard formula is:
//   months_in_cycle = 235*19 / 19 = 235 per 19 years
//   elapsed months before year y = floor(235*(y-1)/19) + floor((7*(y-1)+1)/19) ... no
// Standard: elapsed months = 12*(y-1) + floor((7*(y-1)+1)/19)
// Because each year has 12 months, plus 1 for each leap year before y.
fn _elapsed_months(y) -> int
    12 * (y - 1) + (7 * (y - 1) + 1) / 19

// _molad_parts: molad (new moon) of year y in parts from epoch (Saturday midnight before epoch).
// Molad of Tishri 1 AM (epoch): 2d 5h 204p = 2*25920 + 5*1080 + 204 = 57444 parts
// Each month = 765433 parts
fn _molad_parts(y) -> int
    let m = _elapsed_months(y)
    57444 + m * 765433

// _molad_day: the weekday (1=Sun..7=Sat in traditional; we'll use 0=Sun..6=Sat)
// and time of the molad for year y.
// The molad falls on day (parts / 25920) mod 7 from the epoch day.
// Epoch reference: molad of year 1 is on day 2 (Monday) in traditional counting.
fn _molad_day_parts(y) -> int
    _molad_parts(y) % 25920

// Day of the week (0-based from epoch anchor) of the molad:
fn _molad_weekday(y) -> int
    (_molad_parts(y) / 25920) % 7

// ── Year length computations ────────────────────────────────────────────────
// The Hebrew calendar uses postponement rules (dechiyot) to ensure:
//   - Rosh Hashana doesn't fall on Sun, Wed, Fri (for religious reasons)
//   - Year length fits one of 6 types: deficient/regular/complete × non-leap/leap
//
// Standard year lengths:
//   Non-leap: deficient=353, regular=354, complete=355
//   Leap:     deficient=383, regular=384, complete=385

// _rosh_hashana_jdn: Julian Day Number of Rosh Hashana (1 Tishri) of year y.
// This implements the dechiyot (postponement rules).
fn _rosh_hashana_jdn(y) -> int
    let parts = _molad_parts(y)
    let day = parts / 25920
    let frac = parts % 25920
    // Weekday: epoch JDN for day 0 = JDN 347996 (Saturday before epoch)
    // molad day 0 = Saturday (Shabbat), 1 = Sunday, 2 = Monday, 3 = Tuesday
    // 4 = Wednesday, 5 = Thursday, 6 = Friday, 7 = Saturday again
    // We use 0-based where 0 = Sunday
    let wday = day % 7
    // Tentative Rosh Hashana = epoch JDN + day offset
    // Epoch: 1 Tishri 1 AM = JDN 347998 (Monday, 7 Oct 3761 BCE proleptic Julian).
    // The molad of epoch is traditional day 2 (Monday). day=2 gives JDN 2+347996=347998.
    // Base = 347996 (the Shabbat anchor: JDN of molad day 0).
    let jdn0 = day + 347996
    let rh = jdn0
    // Postponement rule 1 (Lo ADU Rosh): Rosh Hashana cannot fall on Sun(1), Wed(4), Fri(6)
    // If molad weekday is 1, 4, or 6, postpone by 1.
    if wday == 1 or wday == 4 or wday == 6
        rh = jdn0 + 1
    // Postponement rule 2 (Molad Zaken): if molad is at or after noon (>= 18 hours = 19440 parts),
    // postpone to next day (and apply rule 1 again if needed).
    if frac >= 19440
        rh = jdn0 + 1
        let wday2 = (day + 1) % 7
        if wday2 == 1 or wday2 == 4 or wday2 == 6
            rh = jdn0 + 2
    // Postponement rule 3 (GaTaRad): in a non-leap year, if molad falls on Tuesday
    // (wday=3) at or after 9h 204p (9*1080+204=9924 parts past midnight), postpone by 2.
    if not hebrew_is_leap(y) and wday == 3 and frac >= 9924
        rh = jdn0 + 2
    // Postponement rule 4 (BeeTU TeKaPoT): if year following a leap year, and molad falls
    // on Monday (wday=2) at or after 15h 589p (15*1080+589=16789 parts), postpone by 1.
    if hebrew_is_leap(y - 1) and wday == 2 and frac >= 16789
        rh = jdn0 + 1
    rh

// _hebrew_year_days: total days in Hebrew year y.
fn _hebrew_year_days(y) -> int
    _rosh_hashana_jdn(y + 1) - _rosh_hashana_jdn(y)

// ── Month day lengths in a given year ──────────────────────────────────────
// Month ordering (1-based, Tishri=1):
//   1=Tishri(30), 2=Cheshvan(29 or 30), 3=Kislev(30 or 29),
//   4=Tevet(29), 5=Shevat(30), 6=Adar I(30), [7=Adar II(29) leap only]
//   non-leap: 6=Adar(29), 7=Nisan(30), 8=Iyyar(29), 9=Sivan(30),
//              10=Tammuz(29), 11=Av(30), 12=Elul(29)
//   leap:     7=Adar II(29), 8=Nisan(30), 9=Iyyar(29), 10=Sivan(30),
//              11=Tammuz(29), 12=Av(30), 13=Elul(29)
// Cheshvan(2) gets 30 days if year is complete (355 or 385 days).
// Kislev(3) gets 29 days if year is deficient (353 or 383 days).

fn _hebrew_month_days(y, m) -> int
    let ydays = _hebrew_year_days(y)
    let leap = hebrew_is_leap(y)
    // Determine year type: deficient, regular, or complete
    // Non-leap: deficient=353, regular=354, complete=355
    // Leap:     deficient=383, regular=384, complete=385
    let is_complete = 0
    let is_deficient = 0
    if not leap
        if ydays == 355
            is_complete = 1
        if ydays == 353
            is_deficient = 1
    if leap
        if ydays == 385
            is_complete = 1
        if ydays == 383
            is_deficient = 1
    if m == 1
        return 30
    if m == 2
        if is_complete == 1
            return 30
        return 29
    if m == 3
        if is_deficient == 1
            return 29
        return 30
    if m == 4
        return 29
    if m == 5
        return 30
    // Month 6
    if m == 6
        if leap
            return 30
        return 29
    // Month 7: Adar II (leap only) = 29; or Nisan (non-leap) = 30
    if m == 7
        if leap
            return 29
        return 30
    // Month 8: Nisan (leap) = 30; Iyyar (non-leap) = 29
    if m == 8
        if leap
            return 30
        return 29
    // Month 9: Iyyar (leap) = 29; Sivan (non-leap) = 30
    if m == 9
        if leap
            return 29
        return 30
    // Month 10: Sivan (leap) = 30; Tammuz (non-leap) = 29
    if m == 10
        if leap
            return 30
        return 29
    // Month 11: Tammuz (leap) = 29; Av (non-leap) = 30
    if m == 11
        if leap
            return 29
        return 30
    // Month 12: Av (leap) = 30; Elul (non-leap) = 29
    if m == 12
        if leap
            return 30
        return 29
    // Month 13 (leap only): Elul = 29
    29

// _hebrew_months_in_year: total months in year y (12 or 13)
fn _hebrew_months_in_year(y) -> int
    if hebrew_is_leap(y)
        return 13
    12

// hebrew_to_jdn: convert Hebrew date (y, m, d) to JDN.
fn hebrew_to_jdn(y, m, d) -> int
    let rh = _rosh_hashana_jdn(y)
    // Sum days of months 1..m-1
    let off = 0
    for i in 1..m
        off += _hebrew_month_days(y, i)
    rh + off + d - 1

// jdn_to_hebrew: convert JDN to Hebrew date [y, m, d].
fn jdn_to_hebrew(jdn) -> list
    // Estimate year: Hebrew year ~365.25 days, epoch = JDN 347997
    // Rough guess: y ~ (jdn - 347997) / 365 + 1
    let y = (jdn - 347997) / 365 + 1
    if y < 1
        y = 1
    // Adjust forward until Rosh Hashana of y+1 is after jdn
    while _rosh_hashana_jdn(y + 1) <= jdn
        y += 1
    // Adjust backward if Rosh Hashana of y is after jdn
    while _rosh_hashana_jdn(y) > jdn
        y -= 1
    // Now we have the correct year; find month and day
    let rh = _rosh_hashana_jdn(y)
    let diy = jdn - rh
    let m = 1
    let mdays = _hebrew_month_days(y, m)
    let months = _hebrew_months_in_year(y)
    while diy >= mdays and m < months
        diy -= mdays
        m += 1
        mdays = _hebrew_month_days(y, m)
    let d = diy + 1
    let result = []
    push(result, y)
    push(result, m)
    push(result, d)
    result
