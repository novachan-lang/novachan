// ============================================================================
// NOVA Standard Library — std/calendar/iso_week
// ISO-8601 week date calendar.  All integer arithmetic, no libc calls.
//
// ISO 8601 week rules:
//   - Week 1 is the week containing the first Thursday of the year
//   - Weeks start on Monday (Mon=1 .. Sun=7)
//   - ISO year may differ from calendar year at year boundaries
//   - A year has 53 weeks iff Dec 28 falls in week 53
//
// JDN pivot: JDN % 7 == 0 => Monday (verified: JDN 2451545 = 2000-01-01 Sat,
// 2451545 % 7 = 5, consistent with 0=Mon..6=Sun encoding)
//
// PUBLIC API:
//   iso_week_of(y, m, d)              -> list [iso_year, week]
//   iso_week_to_greg(iso_year, week, weekday) -> list [y, m, d]
//                                         weekday: 1=Mon .. 7=Sun
//   iso_weeks_in_year(y)              -> int   (52 or 53)
// ============================================================================

// _greg_to_jdn: proleptic Gregorian date to Julian Day Number.
// (private; mirrors the canonical formula from the task spec)
fn _greg_to_jdn(y, m, d) -> int
    let a = (14 - m) / 12
    let yy = y + 4800 - a
    let mm = m + 12 * a - 3
    d + (153 * mm + 2) / 5 + 365 * yy + yy / 4 - yy / 100 + yy / 400 - 32045

// _jdn_to_greg: Julian Day Number to proleptic Gregorian date [y, m, d].
// Uses Richards 2013 algorithm variant.
fn _jdn_to_greg(jdn) -> list
    let a = jdn + 32044
    let b = (4 * a + 3) / 146097
    let c = a - (146097 * b) / 4
    let d0 = (4 * c + 3) / 1461
    let e = c - (1461 * d0) / 4
    let m0 = (5 * e + 2) / 153
    let day = e - (153 * m0 + 2) / 5 + 1
    let month = m0 + 3 - 12 * (m0 / 10)
    let year = 100 * b + d0 - 4800 + m0 / 10
    let result = []
    push(result, year)
    push(result, month)
    push(result, day)
    result

// _jdn_dow: ISO day-of-week from JDN.
// Returns 0=Mon, 1=Tue, 2=Wed, 3=Thu, 4=Fri, 5=Sat, 6=Sun.
// (JDN % 7 is this encoding; JDN 2451545 = 2000-01-01 Sat = 5 ✓)
fn _jdn_dow(jdn) -> int
    jdn % 7

// _week1_mon_jdn: JDN of the Monday of ISO week 1 of the given ISO year.
// Jan 4 is always in week 1, so Monday of week 1 = Jan4_jdn - dow(Jan4).
fn _week1_mon_jdn(iso_year) -> int
    let jan4_jdn = _greg_to_jdn(iso_year, 1, 4)
    let jan4_dow = _jdn_dow(jan4_jdn)
    jan4_jdn - jan4_dow

// _jdn_iso_year: the ISO year for a given JDN.
// The ISO year is the Gregorian year of the Thursday of the same week.
fn _jdn_iso_year(jdn) -> int
    let dow = _jdn_dow(jdn)
    // Thursday of the same week (dow 3 = Thu in 0=Mon scheme)
    let thu_jdn = jdn + 3 - dow
    let g = _jdn_to_greg(thu_jdn)
    g[0]

// iso_week_of: ISO week date [iso_year, week_number] for Gregorian date (y,m,d).
// Week number is 1-based.  iso_year may differ from y at year boundaries.
fn iso_week_of(y, m, d) -> list
    let jdn = _greg_to_jdn(y, m, d)
    let dow = _jdn_dow(jdn)
    let iso_year = _jdn_iso_year(jdn)
    let w1_mon = _week1_mon_jdn(iso_year)
    let week = (jdn - w1_mon) / 7 + 1
    let result = []
    push(result, iso_year)
    push(result, week)
    result

// iso_weeks_in_year: number of ISO weeks in year y (always 52 or 53).
// Dec 28 is always in the last week of year y (by definition of ISO weeks).
fn iso_weeks_in_year(y) -> int
    let jdn = _greg_to_jdn(y, 12, 28)
    let w1_mon = _week1_mon_jdn(y)
    (jdn - w1_mon) / 7 + 1

// iso_week_to_greg: convert ISO week date (iso_year, week, weekday) to
// Gregorian calendar date [y, m, d].
// weekday: 1=Monday .. 7=Sunday (ISO 8601 encoding).
// Algorithm: JDN = Monday_of_week1 + (week-1)*7 + (weekday-1)
fn iso_week_to_greg(iso_year, week, weekday) -> list
    let w1_mon = _week1_mon_jdn(iso_year)
    let target_jdn = w1_mon + (week - 1) * 7 + (weekday - 1)
    _jdn_to_greg(target_jdn)
