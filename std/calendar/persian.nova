// ============================================================================
// NOVA Standard Library — std/calendar/persian
// Persian (Solar Hijri / Jalali) calendar conversions via Julian Day Number.
//
// The Persian calendar is a solar calendar starting at the vernal equinox.
// Epoch: 1 Farvardin 1 AP = JDN 1948321 (ca. March 22, 622 CE proleptic Gregorian).
//
// Year structure:
//   Months 1-6: 31 days each
//   Months 7-11: 30 days each
//   Month 12: 29 days (normal) or 30 days (leap)
//
// Leap year rule (33-year cycle approximation):
//   In each 33-year cycle, years 1,5,9,13,17,22,26,30 are leap (1-indexed).
//   Equivalent to: (year % 33 * 8 + 29) % 33 < 8  [with year 1-indexed]
//   But a cleaner form: given yr_in_cycle = ((y-1) % 33) + 1,
//   leap if (yr_in_cycle * 8 + 29) % 33 < 8.
//   This gives leap at positions 1,5,9,13,17,22,26,30 in the cycle.
//
// Note: The 33-year cycle is an approximation; the precise calendar uses
// astronomical observation of the vernal equinox. For algorithmic purposes
// the 33-year cycle gives correct dates for 474 CE + 2820-year grand cycle.
//
// PUBLIC API:
//   persian_to_jdn(y, m, d) -> int   convert Persian date to JDN
//   jdn_to_persian(jdn)     -> list  [y, m, d]
//   persian_is_leap(y)      -> bool  true if y is a leap year
// ============================================================================

// Persian epoch: 1 Farvardin 1 AP = JDN 1948320.
// This is the algorithmic epoch used by the 33-year cycle algorithm to correctly
// predict Nowruz dates through the modern era (e.g. 1403/1/1 = 2024-03-20 = JDN 2460390).
// Note: different sources cite 1948319..1948321 depending on Julian/Gregorian/proleptic
// treatment of the 622 CE epoch. The value 1948320 gives the best agreement with
// observed Nowruz for years 1300-1450 AP.
fn _persian_epoch() -> int
    1948320

// persian_is_leap: true if Persian year y is a 33-year-cycle leap year.
// Leap year positions in cycle (1-indexed): 1, 5, 9, 13, 17, 22, 26, 30.
// Formula: ((y - 474) % 33 + 474 adjustment) ... use the direct cycle test.
// We use: yr_in_cycle = ((y - 1) % 33) + 1 (value in 1..33)
// Leap if (yr_in_cycle * 8 + 29) % 33 < 8.
//
// Verification:
//   yr=1: (8+29)%33=37%33=4 < 8 → leap ✓
//   yr=5: (40+29)%33=69%33=3 < 8 → leap ✓
//   yr=9: (72+29)%33=101%33=2 < 8 → leap ✓
//   yr=13: (104+29)%33=133%33=1 < 8 → leap ✓
//   yr=17: (136+29)%33=165%33=0 < 8 → leap ✓
//   yr=22: (176+29)%33=205%33=7 < 8 → leap ✓
//   yr=26: (208+29)%33=237%33=6 < 8 → leap ✓
//   yr=30: (240+29)%33=269%33=5 < 8 → leap ✓
//   yr=2: (16+29)%33=45%33=12 >= 8 → not leap ✓
fn persian_is_leap(y) -> bool
    let yr = (y - 1) % 33 + 1
    (yr * 8 + 29) % 33 < 8

// _persian_month_days: days in month m of year y.
fn _persian_month_days(y, m) -> int
    if m <= 6
        return 31
    if m <= 11
        return 30
    // month 12
    if persian_is_leap(y)
        return 30
    29

// _days_before_year: count of days from epoch start to 1 Farvardin y (0-based from epoch).
// Uses the 33-year cycle: each cycle = 12053 days (33*365 + 8 leap days).
// Days in years 1..(y-1):
//   complete_cycles = (y-1)/33
//   yr_in_partial = (y-1)%33
//   partial_days = yr_in_partial*365 + leap_count(yr_in_partial)
//   where leap_count(n) = number of leap years with position 1..n in the cycle.
//   leap_count(n) = floor((n*8 + 29) / 33) -- counts positions where (k*8+29)%33 < 8
fn _leap_count_in_cycle(n) -> int
    (n * 8 + 29) / 33

fn _days_before_year(y) -> int
    let yy = y - 1
    let cyc = yy / 33
    let rem = yy % 33
    cyc * 12053 + rem * 365 + _leap_count_in_cycle(rem)

// persian_to_jdn: convert Persian date (y, m, d) to Julian Day Number.
fn persian_to_jdn(y, m, d) -> int
    let epoch = _persian_epoch()
    let ydays = _days_before_year(y)
    // Days in months 1..m-1 within year y
    let mdays = 0
    for i in 1..m
        mdays = mdays + _persian_month_days(y, i)
    epoch + ydays + mdays + d - 1

// jdn_to_persian: convert Julian Day Number to Persian date [y, m, d].
fn jdn_to_persian(jdn) -> list
    let epoch = _persian_epoch()
    // 0-based day offset from Persian epoch
    let n = jdn - epoch
    // Estimate year: each cycle = 12053 days for 33 years
    // Rough: y ~ n * 33 / 12053 + 1
    let cyc = n / 12053
    let rem = n % 12053
    if rem < 0
        cyc = cyc - 1
        rem = rem + 12053
    // Year within cycle (0-based in 0..32)
    // Each normal year = 365 days; each leap year = 366.
    // Approximate: yr_in_cyc ~ rem / 365
    let yr_in_cyc = rem / 365
    if yr_in_cyc > 32
        yr_in_cyc = 32
    // Compute actual day offset for yr_in_cyc (years 0..yr_in_cyc-1 complete).
    // days_in_est = cumulative days of years 0..(yr_in_cyc-1) = days before year yr_in_cyc.
    let days_in_est = yr_in_cyc * 365 + _leap_count_in_cycle(yr_in_cyc)
    // Step backward if estimate overshot (days_in_est > rem)
    while days_in_est > rem and yr_in_cyc > 0
        yr_in_cyc = yr_in_cyc - 1
        days_in_est = yr_in_cyc * 365 + _leap_count_in_cycle(yr_in_cyc)
    // Step forward if we undershot (rem >= days_in_est + year_length)
    let next_days = (yr_in_cyc + 1) * 365 + _leap_count_in_cycle(yr_in_cyc + 1)
    while rem >= next_days and yr_in_cyc < 32
        yr_in_cyc = yr_in_cyc + 1
        days_in_est = next_days
        next_days = (yr_in_cyc + 1) * 365 + _leap_count_in_cycle(yr_in_cyc + 1)
    let y = cyc * 33 + yr_in_cyc + 1
    let diy = rem - days_in_est
    // Find month
    let m = 1
    let mlen = _persian_month_days(y, m)
    while diy >= mlen
        diy = diy - mlen
        m = m + 1
        mlen = _persian_month_days(y, m)
    let d = diy + 1
    let result = []
    push(result, y)
    push(result, m)
    push(result, d)
    result
