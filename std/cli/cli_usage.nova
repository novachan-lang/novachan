// ============================================================================
// NOVA Standard Library — std/cli/cli_usage
// Help/usage string formatting utilities. Deterministic, no side effects.
// SELF-CONTAINED (no imports).
// ============================================================================

// clu_pad_right: pad s with spaces on the right to reach width; no truncation.
fn clu_pad_right(s, width) -> string
    let result = s
    while len(result) < width
        result = result + " "
    return result

// clu_usage_line: produce 'Usage: <prog> [tok1] [tok2] ...' from a list of tokens.
// If tokens list is empty, emits 'Usage: <prog>' with no trailing space.
fn clu_usage_line(prog, tokens) -> string
    let line = "Usage: " + prog
    for i in 0..len(tokens)
        line = line + " [" + tokens[i] + "]"
    return line

// clu_option_line: format one option row as '  <short>, <long>  <desc>'.
fn clu_option_line(short, long, desc) -> string
    return "  " + short + ", " + long + "  " + desc
