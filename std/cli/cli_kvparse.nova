// ============================================================================
// NOVA Standard Library — std/cli/cli_kvparse
// Key=value pair parsing for env-style argument lists.
// All fns accept a list of "key=value" strings; SELF-CONTAINED (no imports).
// ============================================================================

// Internal: find index of first '=' in s, or -1 if absent.
fn _clk_eq_idx(s) -> int
    for i in 0..len(s)
        if slice(s, i, i+1) == "="
            return i
    return -1

// clk_parse: convert a list of 'k=v' strings to a list of [key, value] 2-element lists.
// A token with no '=' becomes [token, ''].
fn clk_parse(pairs) -> list
    let result = []
    for i in 0..len(pairs)
        let tok = pairs[i]
        let eq = _clk_eq_idx(tok)
        let pair = []
        if eq == -1
            push(pair, tok)
            push(pair, "")
        else
            push(pair, slice(tok, 0, eq))
            push(pair, slice(tok, eq+1, len(tok)))
        push(result, pair)
    return result

// clk_get: return the value for the first matching key, or '' if not found.
fn clk_get(pairs, key) -> string
    let parsed = clk_parse(pairs)
    for i in 0..len(parsed)
        let kv = parsed[i]
        if kv[0] == key
            return kv[1]
    return ""

// clk_has: return true if key is present in at least one pair.
fn clk_has(pairs, key) -> bool
    let parsed = clk_parse(pairs)
    for i in 0..len(parsed)
        let kv = parsed[i]
        if kv[0] == key
            return true
    return false

// clk_keys: return a list of all keys (preserving order, including duplicates).
fn clk_keys(pairs) -> list
    let parsed = clk_parse(pairs)
    let result = []
    for i in 0..len(parsed)
        let kv = parsed[i]
        push(result, kv[0])
    return result
