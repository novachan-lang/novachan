// ============================================================================
// NOVA Standard Library — std/cli/cli_subcommand
// Subcommand detection: find the first non-option token in an argv list.
// Pure string/list processing; no side effects, no environment access.
// ============================================================================
//
// cls_subcommand(argv)  — first token NOT starting with '-', or '' if none.
// cls_rest(argv)        — all tokens AFTER the subcommand token.
// cls_is(argv, name)    — bool: subcommand equals name.
// ============================================================================

// Internal: return 1 if string s starts with prefix p.
fn _cls_starts_with(s, p) -> int
    let pl = len(p)
    if pl == 0
        return 1
    if len(s) < pl
        return 0
    if slice(s, 0, pl) == p
        return 1
    return 0

// cls_subcommand — first token in argv not starting with '-', or '' if none.
fn cls_subcommand(argv) -> string
    for i in 0..len(argv)
        let tok = argv[i]
        if _cls_starts_with(tok, "-") == 0
            return tok
    return ""

// cls_rest — all tokens in argv that appear AFTER the subcommand token.
fn cls_rest(argv) -> list
    let result = []
    let i = 0
    let found = 0
    while i < len(argv)
        let tok = argv[i]
        if found == 1
            push(result, tok)
        else if _cls_starts_with(tok, "-") == 0
            found = 1
        i += 1
    return result

// cls_is — true if cls_subcommand(argv) equals name.
fn cls_is(argv, name) -> bool
    return cls_subcommand(argv) == name
