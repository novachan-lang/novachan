// ============================================================================
// NOVA Standard Library — std/cli/cli_envargs
// Priority-ordered value resolution: argv option > env value > fallback.
// NO real environment access — the env value is always passed in by the caller.
// Self-contained: no imports.
// ============================================================================

// Internal: return the value after option `name` in argv, or "" if absent.
// Supports --name value  and  --name=value  forms.
fn _cle_argv_val(argv, name) -> string
    let n = len(argv)
    let nlen = len(name)
    for i in 0..n
        let tok = argv[i]
        // --name value form
        if tok == name
            if i + 1 < n
                let nv = argv[i+1]
                return nv
            return ""
        // --name=value form: tok starts with name + "="
        if len(tok) > nlen
            if slice(tok, 0, nlen) == name
                if slice(tok, nlen, nlen+1) == "="
                    return slice(tok, nlen+1, len(tok))
    return ""

// Internal: return 1 if name appears as an option key in argv, 0 otherwise.
fn _cle_argv_present(argv, name) -> int
    let n = len(argv)
    let nlen = len(name)
    for i in 0..n
        let tok = argv[i]
        if tok == name
            return 1
        if len(tok) > nlen
            if slice(tok, 0, nlen) == name
                if slice(tok, nlen, nlen+1) == "="
                    return 1
    return 0

// Public API ─────────────────────────────────────────────────────────────────

// cle_resolve: return the value for `name` from the highest-priority source
// that is non-empty: argv option value, then env_val, then fallback.
fn cle_resolve(argv, name, env_val, fallback) -> string
    let av = _cle_argv_val(argv, name)
    if av != ""
        return av
    if env_val != ""
        return env_val
    return fallback

// cle_present: true if `name` is set (non-empty) in either argv or env_val.
fn cle_present(argv, name, env_val) -> bool
    if _cle_argv_present(argv, name) == 1
        return true
    if env_val != ""
        return true
    return false
