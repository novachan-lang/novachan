// ============================================================================
// NOVA Standard Library — std/cli/cli_validate
// Validation utilities for parsed CLI arguments.
// SELF-CONTAINED (no imports).
// ============================================================================

// Internal: check if a string value appears in a list.
fn _clv_in_list(xs, val) -> bool
    for i in 0..len(xs)
        if xs[i] == val
            return true
    return false

// clv_missing_required: return the subset of required flag names NOT found in argv.
fn clv_missing_required(argv, required) -> list
    let missing = []
    for i in 0..len(required)
        let flag = required[i]
        if not _clv_in_list(argv, flag)
            push(missing, flag)
    return missing

// clv_in_choices: return true if value appears in the choices list.
fn clv_in_choices(value, choices) -> bool
    return _clv_in_list(choices, value)

// clv_is_int_str: return true if s represents a valid integer (all digits, optional leading '-').
fn clv_is_int_str(s) -> bool
    let n = len(s)
    if n == 0
        return false
    let start = 0
    if slice(s, 0, 1) == "-"
        start = 1
    if start >= n
        return false
    let i = start
    while i < n
        let ch = slice(s, i, i+1)
        if ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9"
            i = i + 1
        else
            return false
    return true

// clv_all_present: return true if every flag in required appears in argv.
fn clv_all_present(argv, required) -> bool
    for i in 0..len(required)
        if not _clv_in_list(argv, required[i])
            return false
    return true
