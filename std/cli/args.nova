// ============================================================================
// NOVA Standard Library — std/cli/args
// Minimal argparse-style parser over a caller-supplied list of strings.
// Does NOT read os.argv — accepts a plain list so tests are hermetic.
// ============================================================================
//
// ap_parse(argv, flagnames, optnames) -> dict
//
//   argv      — list of raw arg strings, e.g. args() from the runtime
//   flagnames — list of long-option names (WITHOUT leading dashes) that are
//               boolean flags: presence sets their value to "1"
//   optnames  — list of long-option names (WITHOUT leading dashes) that take
//               a value (via --name=val or --name val)
//
// Returns a dict with string keys:
//   "_pos"          — list of positional arguments (not associated with any option)
//   "<flagname>"    — "1"  if flag was present, absent key if not
//   "<optname>"     — the string value supplied by the user
//
// Parsing rules (left-to-right, first-wins for repeated options):
//   --flag            sets flag to "1" (if in flagnames)
//   --opt=val         sets opt to "val" (if in optnames)
//   --opt val         sets opt to the NEXT token (if in optnames)
//   --                stops option parsing; all remaining tokens are positionals
//   anything else     treated as a positional
//
// Unknown --words are treated as positionals (lenient, like many real CLIs).
// ============================================================================

// Internal: check if a name is in a list (returns 1 or 0).
fn _ap_in_list(xs, name) -> int
    for i in 0..len(xs)
        if xs[i] == name
            return 1
    return 0

// Internal: parse "--name=value" and return just the "value" part.
// Caller guarantees '=' is present; we scan for the first '='.
fn _ap_after_eq(s) -> string
    for i in 0..len(s)
        if slice(s, i, i+1) == "="
            return slice(s, i+1, len(s))
    return ""

// Internal: parse "--name=value" and return just the "name" part (no dashes).
fn _ap_before_eq(s) -> string
    for i in 0..len(s)
        if slice(s, i, i+1) == "="
            return slice(s, 2, i)
    return slice(s, 2, len(s))

// Public API ─────────────────────────────────────────────────────────────────

fn ap_parse(argv, flagnames, optnames) -> dict
    let result = {}
    let positionals = []
    let i = 0
    let n = len(argv)
    let after_dashdash = 0

    while i < n
        let tok = argv[i]

        if after_dashdash == 1
            positionals.push(tok)
            i = i + 1
        else if tok == "--"
            after_dashdash = 1
            i = i + 1
        else if slice(tok, 0, 2) == "--"
            // Long option: either --name=val or --name
            let has_eq = 0
            let j = 2
            while j < len(tok)
                if slice(tok, j, j+1) == "="
                    has_eq = 1
                    j = len(tok)
                else
                    j = j + 1
            if has_eq == 1
                // --opt=val form
                let nm = _ap_before_eq(tok)
                let vl = _ap_after_eq(tok)
                if _ap_in_list(optnames, nm) == 1
                    result[nm] = vl
                else if _ap_in_list(flagnames, nm) == 1
                    // --flag=something: treat as flag set (ignore value)
                    result[nm] = "1"
                else
                    positionals.push(tok)
                i = i + 1
            else
                // --name form (no '=')
                let nm = slice(tok, 2, len(tok))
                if _ap_in_list(flagnames, nm) == 1
                    result[nm] = "1"
                    i = i + 1
                else if _ap_in_list(optnames, nm) == 1
                    // consume next token as value
                    if i + 1 < n
                        result[nm] = argv[i+1]
                        i = i + 2
                    else
                        // option with no value — store empty string
                        result[nm] = ""
                        i = i + 1
                else
                    // unknown long option — positional
                    positionals.push(tok)
                    i = i + 1
        else
            positionals.push(tok)
            i = i + 1

    result["_pos"] = positionals
    return result
