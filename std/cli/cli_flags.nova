// std/cli/cli_flags -- Boolean flag detection and counting. LEAF -- imports NOTHING.
//
// Public API:
//   clf_has_flag(argv, name) -> bool
//     Return true if any token in argv exactly equals name (e.g. '-v' or '--verbose').
//   clf_count_flag(argv, letter) -> int
//     Count total occurrences of a single-character letter across clustered short-flag
//     tokens. '-vvv' contributes 3, '-v' contributes 1, '-vav' contributes 2 (for 'v').
//     Only tokens starting with '-' but NOT '--' are scanned for clustering.
//     A token that is exactly '-<letter>' also counts as 1.
//   clf_has_any(argv, names) -> bool
//     Return true if any token in argv exactly matches any element of names.

// Internal: return 1 if string s starts with prefix p, else 0.
fn _clf_starts_with(s, p) -> int
    if len(p) > len(s)
        return 0
    if slice(s, 0, len(p)) == p
        return 1
    return 0

// Internal: return 1 if list xs contains element v, else 0.
fn _clf_in_list(xs, v) -> int
    let i = 0
    while i < len(xs)
        if xs[i] == v
            return 1
        i = i + 1
    return 0

// Internal: count occurrences of single-char string c in string s, scanning from
// offset start (inclusive) to end of string.
fn _clf_count_char(s, c, start) -> int
    let count = 0
    let i = start
    while i < len(s)
        if slice(s, i, i+1) == c
            count = count + 1
        i = i + 1
    return count

// clf_has_flag: return true if argv contains a token that exactly equals name.
fn clf_has_flag(argv, name) -> bool
    let i = 0
    while i < len(argv)
        if argv[i] == name
            return true
        i = i + 1
    return false

// clf_count_flag: count total occurrences of letter across all short-flag clusters.
// Short-flag tokens start with '-' but not '--'. Each such token is scanned for
// occurrences of letter (a single-char string like 'v') starting at position 1.
// Tokens starting with '--' are skipped entirely.
fn clf_count_flag(argv, letter) -> int
    let total = 0
    let i = 0
    while i < len(argv)
        let tok = argv[i]
        if _clf_starts_with(tok, "-") == 1
            if _clf_starts_with(tok, "--") == 0
                // Short flag cluster: scan from position 1 for the letter.
                total = total + _clf_count_char(tok, letter, 1)
        i = i + 1
    return total

// clf_has_any: return true if any token in argv exactly matches any element of names.
fn clf_has_any(argv, names) -> bool
    let i = 0
    while i < len(argv)
        if _clf_in_list(names, argv[i]) == 1
            return true
        i = i + 1
    return false
