// ============================================================================
// NOVA Standard Library — std/cli/cli_longopt
// GNU long-option helpers: --key=value splitting and unambiguous prefix match.
// Pure string/list processing; no side effects, no environment access.
// ============================================================================
//
// cll_split_eq(tok)              — split '--key=value' into ['--key','value'];
//                                  returns ['--key'] if no '=' present.
// cll_normalize(argv)            — rewrite every '--k=v' token into two tokens
//                                  '--k' and 'v' in place; other tokens pass through.
// cll_match_abbrev(name, cands)  — unambiguous-prefix match: return the unique
//                                  candidate that name is a prefix of, or '' if
//                                  none match or more than one match.
// ============================================================================

// Internal: return 1 if string s starts with prefix p.
fn _cll_starts_with(s, p) -> int
    let pl = len(p)
    if pl == 0
        return 1
    if len(s) < pl
        return 0
    if slice(s, 0, pl) == p
        return 1
    return 0

// Internal: return index of first occurrence of character c in s, or -1.
fn _cll_index_of_char(s, c) -> int
    for i in 0..len(s)
        if slice(s, i, i+1) == c
            return i
    return -1

// cll_split_eq — split '--key=value' into ['--key','value']. If no '=' is
// present, returns a one-element list ['--key']. Non-long-option tokens are
// returned as-is in a one-element list.
fn cll_split_eq(tok) -> list
    let result = []
    let eq = _cll_index_of_char(tok, "=")
    if eq == -1
        push(result, tok)
        return result
    push(result, slice(tok, 0, eq))
    push(result, slice(tok, eq+1, len(tok)))
    return result

// cll_normalize — rewrite every '--k=v' token in argv into two tokens '--k'
// and 'v'; all other tokens pass through unchanged.
fn cll_normalize(argv) -> list
    let result = []
    for i in 0..len(argv)
        let tok = argv[i]
        if _cll_starts_with(tok, "--") == 1
            let eq = _cll_index_of_char(tok, "=")
            if eq == -1
                push(result, tok)
            else
                push(result, slice(tok, 0, eq))
                push(result, slice(tok, eq+1, len(tok)))
        else
            push(result, tok)
    return result

// cll_match_abbrev — return the unique candidate in cands that name is a prefix
// of, or '' if no candidate matches or more than one candidate matches (ambiguous).
// Exact match on a single candidate always wins even if another has the same prefix.
fn cll_match_abbrev(name, cands) -> string
    let matched = ""
    let count = 0
    for i in 0..len(cands)
        let c = cands[i]
        if _cll_starts_with(c, name) == 1
            // exact match: return immediately — unambiguous by definition.
            if c == name
                return c
            matched = c
            count = count + 1
    if count == 1
        return matched
    return ""
