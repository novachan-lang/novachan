// ============================================================================
// NOVA Standard Library — std/money/exchange.nova
//
// Currency conversion mechanics using exact integer arithmetic.
// Amounts are ALWAYS minor units (e.g. cents for USD/EUR).
// Rates are expressed as integer ratios or basis points (ten-thousandths).
//
// "half_up" rounding: round(x/d) = (x + d/2) / d using integer arithmetic.
// All math is i64-safe for typical monetary magnitudes.
//
// Public API (prefix fx_):
//   fx_convert(minor, rate_num, rate_den, mode)  -> int
//   fx_convert_bps(minor, rate_bps)              -> int
//   fx_rate_bps(from_units, to_units)            -> int
//   fx_invert_bps(rate_bps)                      -> int
//   fx_spread(mid_bps, spread_bps)               -> list
//   fx_apply_fee(minor, fee_bps)                 -> int
//   fx_cross_bps(a_to_usd_bps, b_to_usd_bps)    -> int
// ============================================================================

// _fx_half_up — integer division n/d rounded half away from zero.
// For negative n, round the absolute value then re-apply the sign,
// so ties always go away from zero (e.g. -3/2 = -2, not -1).
fn _fx_half_up(n: int, d: int) -> int
    if d == 0
        return 0
    if n < 0
        let a = -n
        let q = (a + d / 2) / d
        return -q
    let result = (n + d / 2) / d
    result

// _fx_abs — absolute value of an integer.
fn _fx_abs(x: int) -> int
    if x < 0
        return -x
    x

// fx_convert — convert an amount by multiplying by rate_num/rate_den.
// mode must be "half_up"; all other strings fall back to truncation.
fn fx_convert(minor: int, rate_num: int, rate_den: int, mode: string) -> int
    if rate_den == 0
        return 0
    let product = minor * rate_num
    if mode == "half_up"
        return _fx_half_up(product, rate_den)
    let result = product / rate_den
    result

// fx_convert_bps — convert using a basis-point rate (10000 bps = 1.0x).
fn fx_convert_bps(minor: int, rate_bps: int) -> int
    let product = minor * rate_bps
    let result = _fx_half_up(product, 10000)
    result

// fx_rate_bps — compute the basis-point rate from raw unit counts.
// e.g. fx_rate_bps(10, 15) = 15000 (1 unit from = 1.5 units to).
fn fx_rate_bps(from_units: int, to_units: int) -> int
    if from_units == 0
        return 0
    let result = to_units * 10000 / from_units
    result

// fx_invert_bps — invert a basis-point rate (1/rate).
// e.g. fx_invert_bps(20000) = 5000 (1/2.0 = 0.5).
fn fx_invert_bps(rate_bps: int) -> int
    if rate_bps == 0
        return 0
    let result = 10000 * 10000 / rate_bps
    result

// fx_spread — given a mid-rate in bps and a spread in bps, return [bid, ask].
// bid = mid - spread/2, ask = mid + spread/2 (half-spread each side).
fn fx_spread(mid_bps: int, spread_bps: int) -> list
    let half = spread_bps / 2
    let bid = mid_bps - half
    let ask = mid_bps + half
    let result = []
    push(result, bid)
    push(result, ask)
    result

// fx_apply_fee — deduct a basis-point fee from an amount and return what remains.
// e.g. fx_apply_fee(10000, 250) = 9750 (2.5% fee on 100.00).
fn fx_apply_fee(minor: int, fee_bps: int) -> int
    let fee = _fx_half_up(minor * fee_bps, 10000)
    let result = minor - fee
    result

// fx_cross_bps — cross rate: A-to-B via USD.
// Given A->USD in bps and B->USD in bps, compute A->B in bps.
// A->B = (A->USD) / (B->USD) expressed in bps.
// cross = a_to_usd_bps * 10000 / b_to_usd_bps.
fn fx_cross_bps(a_to_usd_bps: int, b_to_usd_bps: int) -> int
    if b_to_usd_bps == 0
        return 0
    let result = a_to_usd_bps * 10000 / b_to_usd_bps
    result
