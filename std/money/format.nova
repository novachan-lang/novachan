// std/money/format.nova — Money display formatting (integer-only, no floats).
// LEAF — imports NOTHING.
//
// All public names prefixed with 'mfmt_' to avoid cross-module symbol collisions.
//
// Core design: amounts are integers (minor units). We do all formatting
// via integer division + string concatenation — no float arithmetic anywhere.

// _mfmt_pow10 — private: 10^n for small n.
fn _mfmt_pow10(n)
    let r = 1
    for i in 0..n
        r = r * 10
    r

// _mfmt_int_to_str — private: non-negative integer to decimal string.
fn _mfmt_int_to_str(n)
    if n == 0
        return "0"
    let digits = ""
    let v = n
    while v > 0
        let d = v % 10
        digits = str(d) + digits
        v = v / 10
    digits

// _mfmt_pad_left — private: left-pad string s with '0' chars to width.
fn _mfmt_pad_left(s, width)
    let out = s
    while len(out) < width
        out = "0" + out
    out

// mfmt_group — insert ',' thousands separators into a digit string (handles leading '-').
// mfmt_group("1234567") == "1,234,567"
// mfmt_group("999")     == "999"
// mfmt_group("-1234")   == "-1,234"
fn mfmt_group(intstr)
    if len(intstr) == 0
        return intstr
    let neg = 0
    let digits = intstr
    if char_at(intstr, 0) == "-"
        neg = 1
        digits = slice(intstr, 1, len(intstr))
    // Insert commas from the right, every 3 digits.
    let result_parts = []
    let dlen = len(digits)
    for i in 0..dlen
        // position from right: dlen-1-i .. 0
        let pos_from_right = dlen - 1 - i
        push(result_parts, char_at(digits, i))
        if pos_from_right > 0 and pos_from_right % 3 == 0
            push(result_parts, ",")
    let result = join(result_parts, "")
    if neg == 1
        result = "-" + result
    result

// mfmt_amount — format a minor-unit integer with grouping and a decimal point.
// mfmt_amount(123456, 2) == "1,234.56"
// mfmt_amount(1000,   0) == "1,000"
// mfmt_amount(1234567, 3) == "1,234.567"
// mfmt_amount(5,      2) == "0.05"
fn mfmt_amount(minor, decimals)
    let neg = 0
    let abs_m = minor
    if minor < 0
        neg = 1
        abs_m = -minor
    let scale = _mfmt_pow10(decimals)
    let major = abs_m / scale
    let frac  = abs_m % scale
    let major_s = mfmt_group(_mfmt_int_to_str(major))
    let result = ""
    if decimals == 0
        result = major_s
    else
        let frac_s = _mfmt_pad_left(_mfmt_int_to_str(frac), decimals)
        result = major_s + "." + frac_s
    if neg == 1
        result = "-" + result
    result

// _mfmt_decimals_for — private: built-in decimals table for common currency codes.
// Returns 2 for unknown codes (most world currencies use 2 decimals).
fn _mfmt_decimals_for(code)
    if code == "JPY"
        return 0
    if code == "KRW"
        return 0
    if code == "IDR"
        return 0
    if code == "BHD"
        return 3
    if code == "KWD"
        return 3
    if code == "OMR"
        return 3
    2

// _mfmt_symbol_for — private: built-in symbol table for common currency codes.
// Returns code itself for unknown currencies.
fn _mfmt_symbol_for(code)
    if code == "USD"
        return "$"
    if code == "EUR"
        return "€"
    if code == "GBP"
        return "£"
    if code == "JPY"
        return "¥"
    if code == "CNY"
        return "¥"
    if code == "INR"
        return "₹"
    if code == "KRW"
        return "₩"
    if code == "AUD"
        return "A$"
    if code == "CAD"
        return "CA$"
    if code == "HKD"
        return "HK$"
    if code == "SGD"
        return "S$"
    if code == "BRL"
        return "R$"
    if code == "RUB"
        return "₽"
    if code == "PHP"
        return "₱"
    if code == "THB"
        return "฿"
    ""

// mfmt_money — format with currency-specific decimals and symbol prefix.
// USD -> "$1,234.56";  JPY -> "¥1,000";  BHD -> "BHD 1.500";  XYZ -> "XYZ 1.00"
// Negative: sign comes BEFORE the symbol -> "-$1,234.56".
fn mfmt_money(minor, code)
    let decimals = _mfmt_decimals_for(code)
    let sym = _mfmt_symbol_for(code)
    if minor < 0
        let abs_s = mfmt_amount(0 - minor, decimals)
        if len(sym) > 0
            return "-" + sym + abs_s
        return "-" + code + " " + abs_s
    let amount_s = mfmt_amount(minor, decimals)
    if len(sym) > 0
        return sym + amount_s
    code + " " + amount_s

// mfmt_with_symbol — format with an explicit symbol prefix and explicit decimal count.
// mfmt_with_symbol(123456, 2, "$") == "$1,234.56"
// Negative: sign comes BEFORE the symbol -> "-$1,234.56".
fn mfmt_with_symbol(minor, decimals, symbol)
    if minor < 0
        return "-" + symbol + mfmt_amount(0 - minor, decimals)
    symbol + mfmt_amount(minor, decimals)

// mfmt_negative_paren — format negative amounts in parentheses (accounting style).
// Positive amounts formatted normally (no parentheses).
// mfmt_negative_paren(-123456, 2) == "(1,234.56)"
// mfmt_negative_paren( 123456, 2) == "1,234.56"
fn mfmt_negative_paren(minor, decimals)
    if minor < 0
        let abs_str = mfmt_amount(-minor, decimals)
        return "(" + abs_str + ")"
    mfmt_amount(minor, decimals)

// mfmt_plain — format without grouping separators (digits only, with decimal point).
// mfmt_plain(123456, 2) == "1234.56"
// mfmt_plain(5,      2) == "0.05"
// mfmt_plain(1000,   0) == "1000"
fn mfmt_plain(minor, decimals)
    let neg = 0
    let abs_m = minor
    if minor < 0
        neg = 1
        abs_m = -minor
    let scale = _mfmt_pow10(decimals)
    let major = abs_m / scale
    let frac  = abs_m % scale
    let major_s = _mfmt_int_to_str(major)
    let result = ""
    if decimals == 0
        result = major_s
    else
        let frac_s = _mfmt_pad_left(_mfmt_int_to_str(frac), decimals)
        result = major_s + "." + frac_s
    if neg == 1
        result = "-" + result
    result
