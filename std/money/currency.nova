// std/money/currency.nova — ISO 4217 currency metadata table (~30 major currencies).
// LEAF — imports NOTHING.
//
// All public names prefixed with 'cur_' to avoid cross-module symbol collisions.
//
// Covered codes (upper-case ISO 4217):
//   USD EUR GBP JPY AUD CAD CHF CNY HKD INR
//   KRW MXN NOK NZD SEK SGD ZAR BRL RUB TRY
//   AED SAR THB MYR PHP IDR DKK PLN CZK BHD KWD OMR
//
// decimals: number of minor-unit decimal places (0, 2, or 3).
// symbol  : UTF-8 literal where practical, otherwise ISO code.

// _cur_idx — private: return the 0-based index of code in the currency table, or -1.
fn _cur_idx(code)
    let codes = ["USD","EUR","GBP","JPY","AUD","CAD","CHF","CNY","HKD","INR","KRW","MXN","NOK","NZD","SEK","SGD","ZAR","BRL","RUB","TRY","AED","SAR","THB","MYR","PHP","IDR","DKK","PLN","CZK","BHD","KWD","OMR"]
    for i in 0..len(codes)
        if codes[i] == code
            return i
    -1

// _cur_decimals_list — private: parallel array of decimal counts indexed with _cur_idx.
fn _cur_decimals_list()
    let d = [2,2,2,0,2,2,2,2,2,2,0,2,2,2,2,2,2,2,2,2,2,2,2,2,2,0,2,2,2,3,3,3]
    d

// _cur_symbols_list — private: parallel array of display symbols.
fn _cur_symbols_list()
    let s = ["$","€","£","¥","A$","CA$","CHF","¥","HK$","₹","₩","MX$","kr","NZ$","kr","S$","R","R$","₽","TRY","AED","SAR","฿","RM","₱","Rp","kr","zl","Kc","BD","KD","OMR"]
    s

// _cur_names_list — private: parallel array of currency full names.
fn _cur_names_list()
    let n = ["US Dollar","Euro","British Pound","Japanese Yen","Australian Dollar","Canadian Dollar","Swiss Franc","Chinese Yuan","Hong Kong Dollar","Indian Rupee","South Korean Won","Mexican Peso","Norwegian Krone","New Zealand Dollar","Swedish Krona","Singapore Dollar","South African Rand","Brazilian Real","Russian Ruble","Turkish Lira","UAE Dirham","Saudi Riyal","Thai Baht","Malaysian Ringgit","Philippine Peso","Indonesian Rupiah","Danish Krone","Polish Zloty","Czech Koruna","Bahraini Dinar","Kuwaiti Dinar","Omani Rial"]
    n

// cur_decimals — number of decimal places for currency code; -1 if unknown.
// cur_decimals("USD")==2, cur_decimals("JPY")==0, cur_decimals("BHD")==3.
fn cur_decimals(code)
    let i = _cur_idx(code)
    if i < 0
        return -1
    let d = _cur_decimals_list()
    d[i]

// cur_symbol — display symbol for currency code; falls back to code if unknown.
// cur_symbol("USD")=="$", cur_symbol("EUR")=="€".
fn cur_symbol(code)
    let i = _cur_idx(code)
    if i < 0
        return code
    let s = _cur_symbols_list()
    s[i]

// cur_name — full English name of the currency; empty string if unknown.
fn cur_name(code)
    let i = _cur_idx(code)
    if i < 0
        return ""
    let n = _cur_names_list()
    n[i]

// cur_is_valid — true iff the code is in our table.
fn cur_is_valid(code)
    _cur_idx(code) >= 0

// cur_minor_per_major — number of minor units per major unit (10^decimals).
// cur_minor_per_major("USD")==100, cur_minor_per_major("JPY")==1, cur_minor_per_major("BHD")==1000.
fn cur_minor_per_major(code)
    let dec = cur_decimals(code)
    if dec < 0
        return -1
    let r = 1
    for i in 0..dec
        r *= 10
    r

// cur_codes — list of all known ISO 4217 currency codes in this table.
fn cur_codes()
    let codes = ["USD","EUR","GBP","JPY","AUD","CAD","CHF","CNY","HKD","INR","KRW","MXN","NOK","NZD","SEK","SGD","ZAR","BRL","RUB","TRY","AED","SAR","THB","MYR","PHP","IDR","DKK","PLN","CZK","BHD","KWD","OMR"]
    codes

// cur_symbol_or_code — return symbol if we have one, otherwise return the code itself.
// Identical to cur_symbol since cur_symbol already falls back to code.
fn cur_symbol_or_code(code)
    cur_symbol(code)
