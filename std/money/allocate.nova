// ============================================================================
// NOVA Standard Library — std/money/allocate.nova
//
// Cent-safe money allocation: split a minor-unit amount into parts that sum
// EXACTLY to the original — no rounding errors, no lost or gained cents.
//
// PRINCIPLE: money is ALWAYS an integer count of minor units.
//   Uses the "largest remainder method" to distribute any remainder cents
//   one at a time, ensuring sum(parts) == minor exactly.
//
// Public API (prefix alloc_):
//   alloc_equal(minor, n)          -> list  split into n equal-ish parts
//   alloc_weighted(minor, weights) -> list  split proportionally by weights
//   alloc_ratios(minor, ratios)    -> list  alias for alloc_weighted
//   alloc_percentages(minor, pcts) -> list  split by basis-point percentages
//   alloc_sum(parts)               -> int   sum a list of parts
//   alloc_check(minor, parts)      -> bool  verify parts sum to minor
//   alloc_first_remainder(minor,n) -> int   value of first (larger) part
//
// LEAF — imports NOTHING. All helpers private with _al_ prefix.
// ============================================================================

// _al_abs — absolute value of an integer.
fn _al_abs(x: int) -> int
    if x < 0
        return 0 - x
    x

// alloc_sum — sum all integers in a list of parts.
// alloc_sum([34, 33, 33]) == 100.
fn alloc_sum(parts: list) -> int
    let s = 0
    for i in 0..len(parts)
        s += parts[i]
    s

// alloc_check — true (1) iff parts sum exactly to minor.
// alloc_check(100, [34, 33, 33]) == 1
fn alloc_check(minor: int, parts: list) -> int
    if alloc_sum(parts) == minor
        return 1
    0

// alloc_first_remainder — size of the first (larger) part when minor is split
// equally into n parts.  Equals (minor / n) + 1 if minor % n > 0, else minor / n.
// alloc_first_remainder(100, 3) == 34
// alloc_first_remainder(9, 3)   == 3
fn alloc_first_remainder(minor: int, n: int) -> int
    if n <= 0
        return 0
    let base = minor / n
    let rem = minor % n
    if rem > 0
        return base + 1
    base

// alloc_equal — split minor into exactly n integer parts that sum to minor.
// The first (minor % n) parts are (minor/n + 1); the rest are (minor/n).
// Handles negative minor correctly (negative base, distribute negative remainder).
//
// alloc_equal(100, 3) == [34, 33, 33]   (sum=100)
// alloc_equal(10, 3)  == [4, 3, 3]      (sum=10)
// alloc_equal(9, 3)   == [3, 3, 3]      (sum=9)
fn alloc_equal(minor: int, n: int) -> list
    let result = []
    if n <= 0
        return result
    let base = minor / n
    let rem = minor % n
    // rem may be negative if minor is negative; use abs for count comparison
    let abs_rem = _al_abs(rem)
    // For negative minor: base is negative (truncation toward zero),
    // rem is negative. First abs_rem parts get base + sign(rem), rest get base.
    // Simpler: first abs_rem parts get (minor - base*(n-abs_rem)) / abs_rem
    // Actually for both positive and negative, the pattern holds:
    // - rem >= 0: first rem parts get base+1, rest get base
    // - rem < 0:  first -rem parts get base-1, rest get base
    // (because base*n + rem == minor in both cases)
    for i in 0..n
        if i < abs_rem
            if rem >= 0
                push(result, base + 1)
            else
                push(result, base - 1)
        else
            push(result, base)
    result

// _al_sum_weights — sum all integers in a list.
fn _al_sum_weights(ws: list) -> int
    let s = 0
    let i = 0
    while i < len(ws)
        s += ws[i]
        i += 1
    s

// alloc_weighted — split minor proportionally to a list of positive integer weights.
// Uses the largest-remainder method to ensure exact sum.
// alloc_weighted(100, [1,1,2]) == [25, 25, 50]
// alloc_weighted(100, [1,1,1]) == [34, 33, 33]
fn alloc_weighted(minor: int, weights: list) -> list
    let nw = len(weights)
    let result = []
    if nw == 0
        return result
    let total = _al_sum_weights(weights)
    if total == 0
        // All weights zero: equal split
        return alloc_equal(minor, nw)
    // Step 1: compute base allocations (truncate toward zero) and remainders.
    // remainder[i] = (minor * weights[i]) % total  (the fractional "numerator")
    let bases = []
    let remainders = []
    let base_sum = 0
    for i in 0..nw
        let w = weights[i]
        let num = minor * w
        let b = num / total
        let r = _al_abs(num % total)
        push(bases, b)
        push(remainders, r)
        base_sum += b
    // Step 2: distribute the leftover (minor - base_sum) units.
    // Give one extra unit to the slots with the largest remainders.
    let leftover = minor - base_sum
    // leftover may be 0..nw-1 (or negative for negative minor, handled below)
    let abs_left = _al_abs(leftover)
    // We distribute abs_left extra units (+1 or -1 depending on sign of leftover)
    let extra = 1
    if leftover < 0
        extra = -1
    for distributed in 0..abs_left
        // Find the index with the largest remainder (not yet given extra)
        // We mark given slots by setting remainder to -1
        let best_idx = -1
        let best_rem = -1
        let j = 0
        while j < nw
            let rv = remainders[j]
            if rv >= 0 and rv > best_rem
                best_rem = rv
                best_idx = j
            j += 1
        if best_idx < 0
            // No more eligible slots (tie-break: take first non-negative)
            let k = 0
            while k < nw
                if remainders[k] >= 0
                    best_idx = k
                    k = nw
                k += 1
        if best_idx < 0
            // Safety: give remaining to slot 0
            best_idx = 0
        bases[best_idx] = bases[best_idx] + extra
        remainders[best_idx] = -1
    // Build result list from bases
    for i2 in 0..nw
        push(result, bases[i2])
    result

// alloc_ratios — alias for alloc_weighted (same semantics, semantic alias name).
fn alloc_ratios(minor: int, ratios: list) -> list
    alloc_weighted(minor, ratios)

// alloc_percentages — split minor by basis-point percentages (each pct in 0..10000).
// The pcts list should sum to 10000 (= 100%). Uses alloc_weighted internally so
// that the sum is always exactly minor regardless of rounding.
//
// alloc_percentages(10000, [5000, 5000]) == [5000, 5000]
// alloc_percentages(100, [3333, 3333, 3334]) == exact split summing to 100
fn alloc_percentages(minor: int, pcts_bps: list) -> list
    alloc_weighted(minor, pcts_bps)
