// ============================================================================
// NOVA Standard Library — std/money/parse.nova
//
// Parse human-readable money strings into integer minor units.
// PRINCIPLE: money is ALWAYS an integer count of minor units.
//   "1,234.56" with decimals=2 -> 123456 (cents)
//   No floats anywhere. The entire pipeline is exact integer arithmetic.
//
// Public API (prefix mparse_):
//   mparse_minor(s, decimals) -> int
//   mparse_strip_symbols(s) -> string
//   mparse_sign(s) -> int
//   mparse_int_part(s) -> string
//   mparse_frac_part(s) -> string
//   mparse_is_valid(s) -> bool
//   mparse_detect_decimals(s) -> int
//
// LEAF — imports NOTHING. All helpers private with _mp_ prefix.
// ============================================================================

// _mp_is_digit — true iff character c is '0'..'9'.
fn _mp_is_digit(c: string) -> int
    let b = ord(c)
    if b >= 48 and b <= 57
        return 1
    0

// _mp_is_alpha — true iff c is A-Z or a-z (currency code letters).
fn _mp_is_alpha(c: string) -> int
    let b = ord(c)
    if b >= 65 and b <= 90
        return 1
    if b >= 97 and b <= 122
        return 1
    0

// _mp_str_to_int — parse a non-empty decimal digit string to int.
// Assumes input is all digits; returns 0 for empty string.
fn _mp_str_to_int(s: string) -> int
    let n = len(s)
    if n == 0
        return 0
    let v = 0
    for i in 0..n
        let d = ord(char_at(s, i)) - 48
        v = v * 10 + d
    v

// _mp_pow10 — compute 10^n for small n (0..9).
fn _mp_pow10(n: int) -> int
    let r = 1
    for i in 0..n
        r *= 10
    r

// mparse_strip_symbols — remove currency symbols ($), letter codes, spaces, and
// grouping commas from s; keep digits ('0'..'9'), decimal point ('.'), and '-'.
// mparse_strip_symbols("$1,234.56") -> "1234.56"
// mparse_strip_symbols("USD 12.00") -> "12.00"
// mparse_strip_symbols("-12.34")    -> "-12.34"
fn mparse_strip_symbols(s: string) -> string
    let out_parts = []
    let n = len(s)
    for i in 0..n
        let c = char_at(s, i)
        let b = ord(c)
        // keep digit
        if b >= 48 and b <= 57
            push(out_parts, c)
        else
            // keep '.' (46)
            if b == 46
                push(out_parts, c)
            else
                // keep '-' (45)
                if b == 45
                    push(out_parts, c)
                // drop everything else: $, letters, spaces, commas
    let out = join(out_parts, "")
    out

// mparse_sign — return -1 if the raw string (before stripping) has a leading '-',
// or 1 otherwise. Scans past any non-digit/non-minus prefix first.
fn mparse_sign(s: string) -> int
    let stripped = mparse_strip_symbols(s)
    if len(stripped) > 0
        if char_at(stripped, 0) == "-"
            return -1
    1

// mparse_int_part — extract the integer (whole-unit) part as a digit string from
// a stripped string.  If no '.' is present the entire stripped value is the int part.
// mparse_int_part("1234.56") -> "1234"
// mparse_int_part("1234")    -> "1234"
// mparse_int_part("-12.34")  -> "12"   (sign dropped; caller uses mparse_sign)
fn mparse_int_part(s: string) -> string
    let stripped = mparse_strip_symbols(s)
    // Drop leading '-'
    let n = len(stripped)
    let start = 0
    if n > 0 and char_at(stripped, 0) == "-"
        start = 1
    // Find '.'
    let dot_pos = -1
    for i in start..n
        if char_at(stripped, i) == "."
            dot_pos = i
    if dot_pos < 0
        return slice(stripped, start, n)
    slice(stripped, start, dot_pos)

// mparse_frac_part — extract the fractional digit string after the '.'.
// Returns "" if no decimal point.
// mparse_frac_part("1234.56") -> "56"
// mparse_frac_part("1234")    -> ""
// mparse_frac_part("1234.5")  -> "5"
fn mparse_frac_part(s: string) -> string
    let stripped = mparse_strip_symbols(s)
    let n = len(stripped)
    let dot_pos = -1
    for i in 0..n
        if char_at(stripped, i) == "."
            dot_pos = i
    if dot_pos < 0
        return ""
    slice(stripped, dot_pos + 1, n)

// mparse_detect_decimals — count the number of digit characters after the '.'
// in the raw input (after stripping).
// mparse_detect_decimals("12.34") -> 2
// mparse_detect_decimals("12")    -> 0
// mparse_detect_decimals("1.5")   -> 1
fn mparse_detect_decimals(s: string) -> int
    let fp = mparse_frac_part(s)
    len(fp)

// _mp_frac_to_minor — convert a fractional digit string to the correct integer
// contribution for `decimals` decimal places.
// Pads with trailing zeros if shorter than decimals.
// Truncates (keeps first `decimals` chars) if longer.
// _mp_frac_to_minor("5",  2) -> 50   (pad: "5" -> "50")
// _mp_frac_to_minor("56", 2) -> 56
// _mp_frac_to_minor("567",2) -> 56   (truncate)
// _mp_frac_to_minor("",   2) -> 0
fn _mp_frac_to_minor(frac: string, decimals: int) -> int
    if decimals == 0
        return 0
    if len(frac) == 0
        return 0
    // Truncate to `decimals` digits if needed
    let f = frac
    if len(f) > decimals
        f = slice(f, 0, decimals)
    // Parse the (possibly truncated) string
    let base_val = _mp_str_to_int(f)
    // Pad: if frac_digits < decimals, multiply by 10^(decimals - frac_digits)
    let frac_digits = len(f)
    let pad = decimals - frac_digits
    if pad > 0
        base_val *= _mp_pow10(pad)
    base_val

// mparse_minor — parse a money string to an integer count of minor units.
// Strips currency symbols and grouping commas, handles leading '-', decimal point.
// The fractional part is padded with trailing zeros if shorter than `decimals`,
// or truncated to `decimals` digits if longer.
// A missing decimal point means zero fractional units.
//
// Examples (decimals=2):
//   mparse_minor("1,234.56",  2) == 123456
//   mparse_minor("$1,234.56", 2) == 123456
//   mparse_minor("1234.5",    2) == 123450  (pad: "5" -> "50")
//   mparse_minor("-12.34",    2) == -1234
//   mparse_minor("1000",      2) == 100000  (no decimal -> .00)
//   mparse_minor("12.345",    2) == 1234    (truncate frac to 2)
fn mparse_minor(s: string, decimals: int) -> int
    let sign = mparse_sign(s)
    let int_str = mparse_int_part(s)
    let frac_str = mparse_frac_part(s)
    let scale = _mp_pow10(decimals)
    let major_val = _mp_str_to_int(int_str)
    let frac_val = _mp_frac_to_minor(frac_str, decimals)
    let result = major_val * scale + frac_val
    if sign < 0
        result = -result
    result

// mparse_is_valid — heuristic validity check: the stripped string must contain
// at least one digit and at most one '.'; '-' only at start; no other chars.
// Returns 1 (true) or 0 (false).
fn mparse_is_valid(s: string) -> int
    let stripped = mparse_strip_symbols(s)
    let n = len(stripped)
    if n == 0
        return 0
    let has_digit = 0
    let dot_count = 0
    for i in 0..n
        let c = char_at(stripped, i)
        if _mp_is_digit(c) == 1
            has_digit = 1
        else
            if c == "."
                dot_count += 1
            else
                if c == "-"
                    if i != 0
                        return 0
                else
                    return 0
    if has_digit == 0
        return 0
    if dot_count > 1
        return 0
    1
