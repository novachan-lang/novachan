// std/money/minor.nova — Core integer minor-unit money arithmetic.
// LEAF — imports NOTHING.
//
// PRINCIPLE: money is ALWAYS an integer count of minor units.
//   $12.34 with decimals=2  -->  the integer 1234.
//   No floats anywhere. Percentages/rates use basis points.
//
// "decimals" = number of decimal places in the currency (USD=2, JPY=0, BHD=3).
// minor_per_major = 10^decimals  (USD=100, JPY=1, BHD=1000).
//
// All public names are prefixed with 'minor_' to avoid cross-module collisions.

// _minor_pow10 — private: compute 10^n for small n (0..9).
fn _minor_pow10(n)
    let r = 1
    for i in 0..n
        r *= 10
    r

// minor_from_major — compose a minor-unit amount from whole-major and minor parts.
// minor_from_major(12, 34, 2) == 1234  (100 cents per dollar, so 12*100+34).
// minor_from_major(5, 0, 2)   == 500.
// Signs: major carries the sign; minor_part must be non-negative (0..99 for dec=2).
fn minor_from_major(major, cents, decimals)
    let scale = _minor_pow10(decimals)
    major * scale + cents

// minor_major_part — extract the whole-major part from a minor-unit amount.
// minor_major_part(1234, 2) == 12.  Negative: minor_major_part(-1234,2) == -12.
fn minor_major_part(m, decimals)
    let scale = _minor_pow10(decimals)
    m / scale

// minor_minor_part — extract the fractional (sub-major) part as a non-negative integer.
// minor_minor_part(1234, 2) == 34.  minor_minor_part(-1234,2) == 34.
fn minor_minor_part(m, decimals)
    let scale = _minor_pow10(decimals)
    let r = m % scale
    if r < 0
        r = -r
    r

// minor_add — add two minor-unit amounts (same currency assumed by caller).
fn minor_add(a, b)
    a + b

// minor_sub — subtract b from a in minor units.
fn minor_sub(a, b)
    a - b

// minor_mul_int — multiply a minor-unit amount by an integer scalar.
// minor_mul_int(150, 3) == 450.
fn minor_mul_int(m, n)
    m * n

// minor_neg — negate a minor-unit amount.
fn minor_neg(m)
    -m

// minor_abs — absolute value of a minor-unit amount.
fn minor_abs(m)
    if m < 0
        return -m
    m

// minor_is_zero — true iff the amount is exactly zero.
fn minor_is_zero(m)
    m == 0

// minor_sign — sign of amount: -1, 0, or 1.
fn minor_sign(m)
    if m < 0
        return -1
    if m > 0
        return 1
    0

// _minor_int_to_str — private: convert a non-negative integer to its decimal string.
fn _minor_int_to_str(n)
    if n == 0
        return "0"
    let digits = ""
    let v = n
    while v > 0
        let d = v % 10
        digits = str(d) + digits
        v /= 10
    digits

// _minor_pad_left — private: left-pad string s with '0' to reach exactly width chars.
fn _minor_pad_left(s, width)
    let out = s
    while len(out) < width
        out = "0" + out
    out

// minor_to_major_str — format a minor-unit integer as a human-readable decimal string.
// Uses no float arithmetic; inserts the decimal point by string manipulation.
// minor_to_major_str(1234, 2) == "12.34"
// minor_to_major_str(5,    2) == "0.05"
// minor_to_major_str(-1234,2) == "-12.34"
// minor_to_major_str(1000, 0) == "1000"  (JPY: no decimal point)
fn minor_to_major_str(m, decimals)
    let neg = 0
    if m < 0
        neg = 1
    let abs_m = m
    if neg == 1
        abs_m = -m
    let scale = _minor_pow10(decimals)
    let major = abs_m / scale
    let frac  = abs_m % scale
    let major_s = _minor_int_to_str(major)
    let result = ""
    if decimals == 0
        result = major_s
    else
        let frac_s = _minor_pad_left(_minor_int_to_str(frac), decimals)
        result = major_s + "." + frac_s
    if neg == 1
        result = "-" + result
    result

// minor_scale — rescale a minor-unit amount between two decimal precision levels.
// minor_scale(1234, 2, 3) == 12340  (multiply by 10^(to-from)).
// minor_scale(12340, 3, 2) == 1234  (divide; truncates toward zero).
fn minor_scale(m, from_dec, to_dec)
    let diff = to_dec - from_dec
    if diff == 0
        return m
    if diff > 0
        return m * _minor_pow10(diff)
    m / _minor_pow10(-diff)
