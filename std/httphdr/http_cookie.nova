// ============================================================================
// NOVA Standard Library — std/httphdr/http_cookie
// ============================================================================
// HTTP Cookie header value parser (RFC 6265).
//
// Covers both the request Cookie header and the response Set-Cookie header.
//
// PUBLIC API:
//   hck_parse_cookie(s)          -> list of [name, value] pairs from a Cookie header
//   hck_get(s, name)             -> cookie value string, or "" if absent
//   hck_setcookie_name(s)        -> the cookie name from a Set-Cookie header value
//   hck_setcookie_value(s)       -> the cookie value from a Set-Cookie header value
//   hck_setcookie_attr(s, attr)  -> attribute value (case-insensitive attr name);
//                                   boolean attrs (Secure, HttpOnly) return "true" if present
//
// LEAF — imports NOTHING.
// ============================================================================

// _hck_trim: strip leading and trailing ASCII spaces from a string.
fn _hck_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and char_at(s, start) == " "
        start = start + 1
    let stop = n - 1
    while stop >= start and char_at(s, stop) == " "
        stop = stop - 1
    if start > stop
        return ""
    slice(s, start, stop + 1)

// _hck_to_lower: convert ASCII uppercase letters to lowercase.
fn _hck_to_lower(s: string) -> string
    let n = len(s)
    let result_parts = []
    for i in 0..n
        let c = char_at(s, i)
        let o = ord(c)
        if o >= 65 and o <= 90
            push(result_parts, chr(o + 32))
        else
            push(result_parts, c)
    let result = join(result_parts, "")
    result

// _hck_split_first_eq: split s on the first '=' character.
// Returns a 2-element list [left, right]. If no '=' found returns [s, ""].
fn _hck_split_first_eq(s: string) -> list
    let n = len(s)
    let i = 0
    let found = -1
    while i < n
        if char_at(s, i) == "="
            found = i
            i = n
        else
            i = i + 1
    let res = []
    if found < 0
        push(res, s)
        push(res, "")
    else
        push(res, slice(s, 0, found))
        push(res, slice(s, found + 1, n))
    res

// hck_parse_cookie: parse a request Cookie header value into a list of [name, value] pairs.
// Splits on ';', trims each pair, then splits on first '=' for name and value.
// Example: hck_parse_cookie("a=1; b=2") -> [["a","1"],["b","2"]]
fn hck_parse_cookie(s: string) -> list
    let result = []
    if len(s) == 0
        return result
    let parts = split(s, ";")
    for i in 0..len(parts)
        let raw = _hck_trim(parts[i])
        if len(raw) > 0
            let pair = _hck_split_first_eq(raw)
            let name = _hck_trim(pair[0])
            let value = _hck_trim(pair[1])
            if len(name) > 0
                let entry = []
                push(entry, name)
                push(entry, value)
                push(result, entry)
    result

// hck_get: return the value of a named cookie from a request Cookie header string.
// Returns "" if the name is not present.
// Example: hck_get("sid=abc; theme=dark", "theme") -> "dark"
fn hck_get(s: string, name: string) -> string
    let pairs = hck_parse_cookie(s)
    for i in 0..len(pairs)
        let pair = pairs[i]
        if pair[0] == name
            return pair[1]
    ""

// hck_setcookie_name: extract the cookie name from a Set-Cookie header value.
// The Set-Cookie value is "name=value; attr1; attr2=val; ...".
// Returns "" for empty or malformed input.
// Example: hck_setcookie_name("sid=abc; Path=/; HttpOnly") -> "sid"
fn hck_setcookie_name(s: string) -> string
    if len(s) == 0
        return ""
    let parts = split(s, ";")
    let first = _hck_trim(parts[0])
    let pair = _hck_split_first_eq(first)
    _hck_trim(pair[0])

// hck_setcookie_value: extract the cookie value from a Set-Cookie header value.
// Returns "" for empty or malformed input.
// Example: hck_setcookie_value("sid=abc; Path=/") -> "abc"
fn hck_setcookie_value(s: string) -> string
    if len(s) == 0
        return ""
    let parts = split(s, ";")
    let first = _hck_trim(parts[0])
    let pair = _hck_split_first_eq(first)
    _hck_trim(pair[1])

// hck_setcookie_attr: return the value of a named attribute from a Set-Cookie header value.
// Attribute name comparison is case-insensitive.
// For boolean/flag attributes (no '=' value), returns "true" when present.
// Returns "" if the attribute is not present.
// Example: hck_setcookie_attr("sid=abc; Path=/; Max-Age=3600", "Max-Age") -> "3600"
//          hck_setcookie_attr("sid=abc; Secure", "Secure") -> "true"
fn hck_setcookie_attr(s: string, attr: string) -> string
    if len(s) == 0
        return ""
    let want = _hck_to_lower(attr)
    let parts = split(s, ";")
    // Skip the first part (name=value)
    for i in 1..len(parts)
        let raw = _hck_trim(parts[i])
        if len(raw) > 0
            let pair = _hck_split_first_eq(raw)
            let aname = _hck_to_lower(_hck_trim(pair[0]))
            if aname == want
                let aval = _hck_trim(pair[1])
                if len(aval) == 0
                    return "true"
                return aval
    ""
