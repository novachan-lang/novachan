// ============================================================================
// NOVA Standard Library — std/httphdr/http_qvalue
// ============================================================================
// Generic q-value list parser for Accept-Encoding and Accept-Language headers
// per RFC 7231 §5.3.1 (quality values).
//
// PUBLIC API:
//   hqv_parse(s: string) -> list
//     Parse a q-value list header value into [value, q_x1000] pairs sorted by
//     q descending (ties preserve input order).  Default q is 1000.
//     Example: "gzip;q=0.5, br;q=1.0" -> [["br",1000],["gzip",500]]
//
//   hqv_best(s: string, offered: list) -> string
//     Return the offered value the client most prefers, or '' if none match
//     or all matching entries have q=0.
//
//   hqv_acceptable(s: string, value: string) -> bool
//     Return true if the value is present with q > 0 in the header.
//
// DESIGN:
//   * Case-insensitive value comparison.
//   * Values are returned lowercased.
//   * q=0 means explicitly unacceptable (RFC 7231 §5.3.1).
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _hqv_trim: strip leading and trailing ASCII spaces from a string.
fn _hqv_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and char_at(s, start) == " "
        start = start + 1
    let stop = n - 1
    while stop >= start and char_at(s, stop) == " "
        stop = stop - 1
    if start > stop
        return ""
    slice(s, start, stop + 1)

// _hqv_lower: convert ASCII uppercase letters to lowercase.
fn _hqv_lower(s: string) -> string
    let n = len(s)
    let result = ""
    let i = 0
    while i < n
        let c = char_at(s, i)
        let o = ord(c)
        if o >= 65 and o <= 90
            result = result + chr(o + 32)
        else
            result = result + c
        i = i + 1
    result

// _hqv_starts_with: return 1 if s starts with prefix.
fn _hqv_starts_with(s: string, prefix: string) -> int
    let sn = len(s)
    let pn = len(prefix)
    if pn > sn
        return 0
    if slice(s, 0, pn) == prefix
        return 1
    0

// _hqv_parse_q: parse q_x1000 from a single param string like "q=0.9".
// Returns -1 if not a q param; otherwise returns q*1000.
fn _hqv_parse_q(param: string) -> int
    let p = _hqv_trim(param)
    let pl = _hqv_lower(p)
    if not _hqv_starts_with(pl, "q=") == 1
        return -1
    let vs = _hqv_trim(slice(p, 2, len(p)))
    let vn = len(vs)
    if vn == 0
        return -1
    let int_part = 0
    let frac_part = 0
    let frac_digits = 0
    let i = 0
    let in_frac = 0
    while i < vn
        let c = char_at(vs, i)
        if c == "."
            in_frac = 1
        else
            let d = ord(c) - 48
            if d >= 0 and d <= 9
                if in_frac == 0
                    int_part = int_part * 10 + d
                else
                    if frac_digits < 3
                        frac_part = frac_part * 10 + d
                        frac_digits = frac_digits + 1
        i = i + 1
    while frac_digits < 3
        frac_part = frac_part * 10
        frac_digits = frac_digits + 1
    int_part * 1000 + frac_part

// _hqv_parse_entry: parse one "value[;q=...]" token into [lowercased_value, q_x1000].
fn _hqv_parse_entry(token: string) -> list
    let parts = split(token, ";")
    let val = _hqv_lower(_hqv_trim(parts[0]))
    let q = 1000
    let i = 1
    while i < len(parts)
        let qv = _hqv_parse_q(parts[i])
        if qv >= 0
            q = qv
        i = i + 1
    let pair = []
    push(pair, val)
    push(pair, q)
    pair

// ── Public API ────────────────────────────────────────────────────────────────

// hqv_parse: parse q-value list header into [value, q_x1000] pairs sorted by q descending.
fn hqv_parse(s: string) -> list
    if len(s) == 0
        return []
    let tokens = split(s, ",")
    let entries = []
    let i = 0
    while i < len(tokens)
        let entry = _hqv_parse_entry(tokens[i])
        push(entries, entry)
        i = i + 1
    // Insertion sort descending by q (stable).
    let n = len(entries)
    let j = 1
    while j < n
        let key = entries[j]
        let kq = key[1]
        let k = j - 1
        while k >= 0 and entries[k][1] < kq
            entries[k + 1] = entries[k]
            k = k - 1
        entries[k + 1] = key
        j = j + 1
    entries

// hqv_best: return the best offered value matching the header, or '' if none.
fn hqv_best(s: string, offered: list) -> string
    let parsed = hqv_parse(s)
    let pn = len(parsed)
    let on = len(offered)
    let i = 0
    while i < pn
        let entry = parsed[i]
        let val = entry[0]
        let q = entry[1]
        if q > 0
            let j = 0
            while j < on
                let ov = _hqv_lower(offered[j])
                if ov == val
                    return offered[j]
                j = j + 1
        i = i + 1
    ""

// hqv_acceptable: return true if value is present with q > 0 in the header.
fn hqv_acceptable(s: string, value: string) -> bool
    if len(s) == 0
        return false
    let parsed = hqv_parse(s)
    let vl = _hqv_lower(value)
    let i = 0
    while i < len(parsed)
        let entry = parsed[i]
        let val = entry[0]
        let q = entry[1]
        if val == vl
            if q > 0
                return true
            else
                return false
        i = i + 1
    false
