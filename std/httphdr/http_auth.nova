// ============================================================================
// NOVA Standard Library — std/httphdr/http_auth
// ============================================================================
// Parse the VALUE of an HTTP Authorization (or WWW-Authenticate) header.
// RFC 7235: the value is "<scheme> <credentials>".
//
// Public API (prefix hau_):
//   hau_scheme(s)         -> string  — the auth scheme token (case-preserved)
//   hau_credentials(s)    -> string  — the credentials/token after the scheme
//   hau_bearer_token(s)   -> string  — the token for a Bearer header, or ""
//   hau_parse_basic(s)    -> list    — [username, password] decoded from Basic
//
// Self-contained: no imports. All helpers are private (_prefix).

// ── private helpers ──────────────────────────────────────────────────────────

// Return 1 if c (byte value) is an ASCII space or tab.
fn _hau_is_ws(c) -> int
    if c == 32 or c == 9
        return 1
    return 0

// Trim leading and trailing ASCII whitespace from s.
fn _hau_trim(s) -> string
    let n = len(s)
    let lo = 0
    while lo < n and _hau_is_ws(ord(s[lo])) == 1
        lo = lo + 1
    let hi = n
    while hi > lo and _hau_is_ws(ord(s[hi - 1])) == 1
        hi = hi - 1
    slice(s, lo, hi)

// Find the first space in s; return its index or -1.
fn _hau_find_space(s) -> int
    let n = len(s)
    for i in 0..n
        if ord(s[i]) == 32
            return i
    return -1

// Lowercase a single ASCII byte value.
fn _hau_lower_byte(c) -> int
    if c >= 65 and c <= 90
        return c + 32
    return c

// Case-insensitive string equality for ASCII.
fn _hau_streq_ci(a, b) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    let n = len(a)
    while i < n
        if _hau_lower_byte(ord(a[i])) != _hau_lower_byte(ord(b[i]))
            return 0
        i = i + 1
    return 1

// ── base64 decoding ──────────────────────────────────────────────────────────
// Standard alphabet: A-Z=0..25, a-z=26..51, 0-9=52..61, +=62, /=63.
// Returns -1 for padding '=' or invalid chars.
fn _hau_b64val(c) -> int
    if c >= 65 and c <= 90
        return c - 65
    if c >= 97 and c <= 122
        return c - 71
    if c >= 48 and c <= 57
        return c + 4
    if c == 43
        return 62
    if c == 47
        return 63
    return -1

// Decode a standard-alphabet base64 string to a raw byte string.
// Ignores padding characters ('=') and invalid chars gracefully.
fn _hau_b64decode(s) -> string
    let out_parts = []
    let n = len(s)
    let i = 0
    while i < n
        // collect up to 4 valid base64 chars
        let buf = []
        let j = i
        while j < n and len(buf) < 4
            let v = _hau_b64val(ord(s[j]))
            if v >= 0
                push(buf, v)
            j = j + 1
        i = j
        // decode 4 chars -> up to 3 bytes
        if len(buf) >= 2
            let b0 = (buf[0] << 2) | (buf[1] >> 4)
            push(out_parts, chr(b0))
        if len(buf) >= 3
            let b1 = ((buf[1] & 15) << 4) | (buf[2] >> 2)
            push(out_parts, chr(b1))
        if len(buf) >= 4
            let b2 = ((buf[2] & 3) << 6) | buf[3]
            push(out_parts, chr(b2))
    let out = join(out_parts, "")
    out

// ── public API ───────────────────────────────────────────────────────────────

// The auth scheme token (e.g. 'Basic', 'Bearer'), case-preserved. "" if absent.
fn hau_scheme(s) -> string
    let t = _hau_trim(s)
    if len(t) == 0
        return ""
    let sp = _hau_find_space(t)
    if sp < 0
        return t
    slice(t, 0, sp)

// The credentials string after the scheme (everything after the first space).
fn hau_credentials(s) -> string
    let t = _hau_trim(s)
    let sp = _hau_find_space(t)
    if sp < 0
        return ""
    _hau_trim(slice(t, sp + 1, len(t)))

// The token from a 'Bearer <token>' header, or "" if scheme is not Bearer.
fn hau_bearer_token(s) -> string
    let scheme = hau_scheme(s)
    if _hau_streq_ci(scheme, "Bearer") == 0
        return ""
    hau_credentials(s)

// Decode a 'Basic <base64>' header into [username, password].
// base64 decodes to 'user:pass'; splits on the first colon.
// Returns ["",""] on any malformed input.
fn hau_parse_basic(s) -> list
    let scheme = hau_scheme(s)
    if _hau_streq_ci(scheme, "Basic") == 0
        return ["", ""]
    let creds = hau_credentials(s)
    if len(creds) == 0
        return ["", ""]
    let decoded = _hau_b64decode(creds)
    let colon = find(decoded, ":")
    if colon < 0
        return [decoded, ""]
    let user = slice(decoded, 0, colon)
    let pass = slice(decoded, colon + 1, len(decoded))
    [user, pass]
