// ============================================================================
// NOVA Standard Library — std/httphdr/http_header_util
// ============================================================================
// Generic HTTP header value parsing utilities (RFC 7230-style).
// Handles comma-list splitting (respecting quoted strings), parameter parsing,
// token extraction, and quote-stripping.
//
// Public API (prefix hhu_):
//   hhu_split_list(s)     -> list  — comma-split ignoring commas in ""...""
//   hhu_parse_params(s)   -> list  — parse '; k=v' -> [[k,v], ...] (keys lower)
//   hhu_unquote(s)        -> str   — strip surrounding double-quotes
//   hhu_token_value(s)    -> str   — token before first ';'
//
// Self-contained: no imports. All helpers are private (_prefix).

// ── private helpers ──────────────────────────────────────────────────────────

// Return 1 if c (byte value) is ASCII space or tab.
fn _hhu_is_ws(c) -> int
    if c == 32 or c == 9
        return 1
    return 0

// Trim leading and trailing ASCII whitespace.
fn _hhu_trim(s) -> string
    let n = len(s)
    let lo = 0
    while lo < n and _hhu_is_ws(ord(s[lo])) == 1
        lo = lo + 1
    let hi = n
    while hi > lo and _hhu_is_ws(ord(s[hi - 1])) == 1
        hi = hi - 1
    slice(s, lo, hi)

// Lowercase an entire ASCII string.
fn _hhu_lower(s) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = ord(s[i])
        if c >= 65 and c <= 90
            out = out + chr(c + 32)
        else
            out = out + chr(c)
        i = i + 1
    out

// Find first occurrence of char (byte value ch) in s; return index or -1.
fn _hhu_find_char(s, ch) -> int
    let n = len(s)
    let i = 0
    while i < n
        if ord(s[i]) == ch
            return i
        i = i + 1
    return -1

// Strip surrounding double-quotes from a value string, unescaping \" inside.
fn _hhu_strip_quotes(s) -> string
    let n = len(s)
    if n < 2
        return s
    if ord(s[0]) != 34 or ord(s[n - 1]) != 34
        return s
    // extract inner, handle backslash-quote escapes
    let inner = slice(s, 1, n - 1)
    let out = ""
    let i = 0
    let m = len(inner)
    while i < m
        let c = ord(inner[i])
        if c == 92 and i + 1 < m
            // backslash: take the next char literally
            out = out + inner[i + 1]
            i = i + 2
        else
            out = out + chr(c)
            i = i + 1
    out

// ── public API ───────────────────────────────────────────────────────────────

// Split a comma-separated header value, trimming each item.
// Commas inside double-quoted strings are NOT treated as separators.
// e.g. '"x,y", z' -> ['"x,y"', 'z']  (quotes preserved in output)
fn hhu_split_list(s) -> list
    let result = []
    let n = len(s)
    let i = 0
    let item = ""
    let in_quote = 0
    while i < n
        let c = ord(s[i])
        if c == 34
            // toggle quoted mode; accumulate the quote char
            in_quote = 1 - in_quote
            item = item + chr(c)
            i = i + 1
        else if c == 92 and in_quote == 1 and i + 1 < n
            // backslash escape inside quotes: take both chars
            item = item + chr(c) + s[i + 1]
            i = i + 2
        else if c == 44 and in_quote == 0
            // comma outside quotes: flush current item
            let t = _hhu_trim(item)
            if len(t) > 0
                push(result, t)
            item = ""
            i = i + 1
        else
            item = item + chr(c)
            i = i + 1
    // flush last item
    let last = _hhu_trim(item)
    if len(last) > 0
        push(result, last)
    result

// Parse a '; key=value; key2="val2"' parameter string.
// Returns a list of [key, value] pairs; keys are lowercased, values unquoted.
// Leading ';' or leading token+';' is handled: parsing begins at the first ';'.
fn hhu_parse_params(s) -> list
    let result = []
    // find the start of the parameter section: skip to first ';'
    let semi = _hhu_find_char(s, 59)
    if semi < 0
        return result
    let rest = slice(s, semi + 1, len(s))
    // split by ';'
    let parts = split(rest, ";")
    let i = 0
    while i < len(parts)
        let part = _hhu_trim(parts[i])
        if len(part) > 0
            let eq = _hhu_find_char(part, 61)
            if eq > 0
                let k = _hhu_lower(_hhu_trim(slice(part, 0, eq)))
                let v = _hhu_strip_quotes(_hhu_trim(slice(part, eq + 1, len(part))))
                let pair = [k, v]
                push(result, pair)
        i = i + 1
    result

// Strip surrounding double-quotes from s; return inner content (with \" unescaped).
fn hhu_unquote(s) -> string
    _hhu_strip_quotes(_hhu_trim(s))

// Return the token before the first ';', trimmed.
// e.g. "text/html; charset=utf-8" -> "text/html"
fn hhu_token_value(s) -> string
    let semi = _hhu_find_char(s, 59)
    if semi < 0
        return _hhu_trim(s)
    _hhu_trim(slice(s, 0, semi))
