// ============================================================================
// NOVA Standard Library — std/httphdr/http_content_disposition
// ============================================================================
// HTTP Content-Disposition header value parser (RFC 6266).
//
// PUBLIC API:
//   hcd_type(s)     -> string
//     Return the disposition type (e.g. "attachment", "inline"), lowercased.
//     Returns "" on empty input.
//
//   hcd_filename(s) -> string
//     Return the filename= parameter value, with quotes stripped.
//     Returns "" if the parameter is absent.
//
//   hcd_name(s)     -> string
//     Return the name= parameter value (for form-data), with quotes stripped.
//     Returns "" if absent.
//
// DESIGN:
//   The header value is of the form:
//     disposition-type *( ";" SP param )
//   where param = token "=" ( token / quoted-string )
//   We split on ";" and process each token, lowercasing parameter names for
//   case-insensitive matching per RFC 6266 §4.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _hcd_trim: strip leading and trailing ASCII spaces.
fn _hcd_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and char_at(s, start) == " "
        start += 1
    let stop = n - 1
    while stop >= start and char_at(s, stop) == " "
        stop -= 1
    if start > stop
        return ""
    slice(s, start, stop + 1)

// _hcd_to_lower: ASCII-lowercase a string.
fn _hcd_to_lower(s: string) -> string
    let n = len(s)
    let result_parts = []
    for i in 0..n
        let c = char_at(s, i)
        let o = ord(c)
        if o >= 65 and o <= 90
            push(result_parts, chr(o + 32))
        else
            push(result_parts, c)
    let result = join(result_parts, "")
    result

// _hcd_unquote: remove surrounding double-quotes (if present).
fn _hcd_unquote(s: string) -> string
    let n = len(s)
    if n >= 2 and char_at(s, 0) == "\"" and char_at(s, n - 1) == "\""
        return slice(s, 1, n - 1)
    s

// _hcd_find_char: find first occurrence of character c in s at or after pos.
// Returns -1 if not found.
fn _hcd_find_char(s: string, c: string, pos: int) -> int
    let n = len(s)
    let i = pos
    let found = -1
    while i < n and found < 0
        if char_at(s, i) == c
            found = i
        else
            i += 1
    found

// _hcd_param: extract a named parameter value from the parsed token list.
// tokens[0] is the disposition type; tokens[1..] are param tokens.
// Returns the value (unquoted) for the first matching param name, or "".
fn _hcd_param(tokens: list, pname: string) -> string
    let target = _hcd_to_lower(_hcd_trim(pname))
    let n = len(tokens)
    let i = 1
    let result = ""
    while i < n
        let tok = _hcd_trim(tokens[i])
        let eq = _hcd_find_char(tok, "=", 0)
        if eq >= 0
            let kraw = _hcd_to_lower(_hcd_trim(slice(tok, 0, eq)))
            if kraw == target
                let vraw = _hcd_unquote(_hcd_trim(slice(tok, eq + 1, len(tok))))
                result = vraw
                i = n
            else
                i += 1
        else
            i += 1
    result

// ── Public API ────────────────────────────────────────────────────────────────

// hcd_type: return the disposition type (lowercased) from the header value.
fn hcd_type(s: string) -> string
    if len(s) == 0
        return ""
    let tokens = split(s, ";")
    _hcd_to_lower(_hcd_trim(tokens[0]))

// hcd_filename: return the filename= parameter value (unquoted), or "".
fn hcd_filename(s: string) -> string
    if len(s) == 0
        return ""
    let tokens = split(s, ";")
    _hcd_param(tokens, "filename")

// hcd_name: return the name= parameter value (for form-data), or "".
fn hcd_name(s: string) -> string
    if len(s) == 0
        return ""
    let tokens = split(s, ";")
    _hcd_param(tokens, "name")
