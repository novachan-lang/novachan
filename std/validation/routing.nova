// std/validation/routing -- ABA bank routing number validation. LEAF -- imports NOTHING.
//
// Public API:
//   vrt_is_valid(s: string) -> int
//     Returns 1 if s is a valid 9-digit ABA routing number, 0 otherwise.
//     Rules: exactly 9 characters, all digits, and the ABA checksum passes:
//       3*(d0+d3+d6) + 7*(d1+d4+d7) + (d2+d5+d8) mod 10 == 0
//
//   vrt_check(s: string) -> int
//     Returns the raw checksum value: 3*(d0+d3+d6) + 7*(d1+d4+d7) + (d2+d5+d8)
//     (mod 10 of this should be 0 for a valid routing number).
//     Returns -1 if s is not exactly 9 digits.
//
//   vrt_federal_district(s: string) -> int
//     Returns the federal reserve district number (first two digits as integer).
//     Returns -1 if s is not exactly 9 digits.

// PRIVATE: returns 1 if character c is an ASCII digit, 0 otherwise.
fn _vrt_is_digit(c: string) -> int
    let o = ord(c)
    if o >= 48 and o <= 57
        return 1
    0

// PRIVATE: returns 1 if s is exactly 9 digits, 0 otherwise.
fn _vrt_is_nine_digits(s: string) -> int
    if len(s) != 9
        return 0
    let i = 0
    let valid = 1
    while i < 9 and valid == 1
        let c = char_at(s, i)
        if _vrt_is_digit(c) == 0
            valid = 0
        i = i + 1
    valid

// PRIVATE: return the digit value at position i in string s.
fn _vrt_digit_at(s: string, i: int) -> int
    let o = ord(char_at(s, i))
    o - 48

// vrt_check("021000021") -> 0  (mod 10 == 0 => valid)
// vrt_check("notdigits") -> -1
fn vrt_check(s: string) -> int
    if _vrt_is_nine_digits(s) == 0
        return -1
    let d0 = _vrt_digit_at(s, 0)
    let d1 = _vrt_digit_at(s, 1)
    let d2 = _vrt_digit_at(s, 2)
    let d3 = _vrt_digit_at(s, 3)
    let d4 = _vrt_digit_at(s, 4)
    let d5 = _vrt_digit_at(s, 5)
    let d6 = _vrt_digit_at(s, 6)
    let d7 = _vrt_digit_at(s, 7)
    let d8 = _vrt_digit_at(s, 8)
    let sum = 3 * (d0 + d3 + d6) + 7 * (d1 + d4 + d7) + (d2 + d5 + d8)
    sum % 10

// vrt_is_valid("021000021") -> 1
// vrt_is_valid("021000020") -> 0
// vrt_is_valid("12345678")  -> 0 (only 8 digits)
// vrt_is_valid("abcdefghi") -> 0
fn vrt_is_valid(s: string) -> int
    if _vrt_is_nine_digits(s) == 0
        return 0
    let chk = vrt_check(s)
    if chk == 0
        return 1
    0

// vrt_federal_district("021000021") -> 2
// vrt_federal_district("notdigits") -> -1
fn vrt_federal_district(s: string) -> int
    if _vrt_is_nine_digits(s) == 0
        return -1
    let d0 = _vrt_digit_at(s, 0)
    let d1 = _vrt_digit_at(s, 1)
    d0 * 10 + d1
