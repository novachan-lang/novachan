// std/validation/iban.nova — IBAN validation (ISO 13616).
// LEAF — imports NOTHING.
//
// Public API:
//   viban_is_valid(s) -> bool    strip spaces, uppercase; len 15..34;
//                                move first 4 chars to end; expand letters
//                                A=10..Z=35; big-number mod-97 == 1.
//   viban_country(s)  -> string  first 2 letters of the raw IBAN (uppercased,
//                                spaces stripped).
//   viban_check_digits(s) -> string  chars 3-4 of the normalised IBAN.
//   viban_format(s)   -> string  normalised IBAN grouped in blocks of 4
//                                separated by spaces.

// ---------- internal helpers ----------

// _viban_strip — remove all spaces and uppercase every character.
fn _viban_strip(s: string) -> string
    let out = ""
    let n = len(s)
    for i in 0..n
        let c = char_at(s, i)
        if c != " "
            out = out + upper(c)
    out

// _viban_mod97 — compute mod-97 of the big integer represented by the
// rearranged IBAN character sequence.
// Characters are either digits (0-9) or letters (A-Z, representing 10-35).
// We process one character at a time, keeping accumulator < 97 throughout:
//   digit ch  -> acc = (acc * 10  + digit_value)      % 97
//   letter ch -> acc = (acc * 100 + (ord-65 + 10))    % 97
// Letters contribute two decimal digits so the multiplier is 100.
fn _viban_mod97(rearranged: string) -> int
    let acc = 0
    let n = len(rearranged)
    for i in 0..n
        let c = char_at(rearranged, i)
        let o = ord(c)
        if o >= 65
            // Letter A-Z (ord 65-90): value = (o - 65) + 10 = o - 55
            let lv = o - 55
            acc = (acc * 100 + lv) % 97
        else
            // Digit 0-9 (ord 48-57): value = o - 48
            let dv = o - 48
            acc = (acc * 10 + dv) % 97
    acc

// ---------- public API ----------

// viban_is_valid — true iff s is a valid IBAN.
// Normalisation: strip spaces, uppercase.
// Algorithm: rearrange (chars[4..] + chars[0..4]), expand letters to
// two-digit numbers, compute resulting integer mod 97; valid iff == 1.
fn viban_is_valid(s: string) -> bool
    let norm = _viban_strip(s)
    let n = len(norm)
    if n < 15
        return false
    if n > 34
        return false
    // rearrange: bban (chars 4..n) followed by country+check (chars 0..4)
    let rearranged = slice(norm, 4, n) + slice(norm, 0, 4)
    let rem = _viban_mod97(rearranged)
    rem == 1

// viban_country — return the 2-letter country code (characters 0-1 of
// the normalised IBAN).  Returns "" if the input is too short.
fn viban_country(s: string) -> string
    let norm = _viban_strip(s)
    if len(norm) < 2
        return ""
    slice(norm, 0, 2)

// viban_check_digits — return the 2-character check-digit string (characters
// 2-3 of the normalised IBAN).  Returns "" if the input is too short.
fn viban_check_digits(s: string) -> string
    let norm = _viban_strip(s)
    if len(norm) < 4
        return ""
    slice(norm, 2, 4)

// viban_format — return the normalised IBAN grouped in blocks of 4
// characters separated by spaces.  The last block may be fewer than 4.
// Example: "GB82WEST12345698765432" -> "GB82 WEST 1234 5698 7654 32"
fn viban_format(s: string) -> string
    let norm = _viban_strip(s)
    let n = len(norm)
    let out_parts = []
    for i in 0..n
        if i > 0
            if i % 4 == 0
                push(out_parts, " ")
        push(out_parts, char_at(norm, i))
    let out = join(out_parts, "")
    out
