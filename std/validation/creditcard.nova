// std/validation/creditcard.nova — Credit-card validation, brand detection, masking.
// Imports std/math/checkdigit for Luhn (mod-10) validation.
//
// Public API:
//   vcc_is_valid(s: string) -> bool
//     Strip spaces and dashes; require 13..19 digits; pass Luhn check.
//
//   vcc_brand(s: string) -> string
//     Return brand name based on prefix/length rules (spaces/dashes stripped):
//       "visa"       — starts with 4; length 13, 16, or 19
//       "mastercard" — starts with 51-55 OR 2221-2720; length 16
//       "amex"       — starts with 34 or 37; length 15
//       "discover"   — starts with 6011 or 65; length 16
//       "unknown"    — anything else
//
//   vcc_mask(s: string) -> string
//     Return a string where all digits except the last 4 are replaced with '*'.
//     Non-digit characters (spaces, dashes) in the input are removed first.

import std/math/checkdigit

// ---------- internal helpers ----------

// _vcc_strip — remove spaces and dashes; return only digit characters.
fn _vcc_strip(s: string) -> string
    let out = ""
    let n = len(s)
    for i in 0..n
        let c = char_at(s, i)
        if c != " "
            if c != "-"
                out += c
    out

// _vcc_all_digits — return 1 iff every character in s is a digit 0-9.
fn _vcc_all_digits(s: string) -> int
    let n = len(s)
    if n == 0
        return 0
    let ok = 1
    let i = 0
    while i < n and ok == 1
        let o = ord(char_at(s, i))
        if o < 48
            ok = 0
        if o > 57
            ok = 0
        i += 1
    ok

// _vcc_prefix2 — return the 2-digit prefix as an integer, or -1 if s is too short.
fn _vcc_prefix2(s: string) -> int
    if len(s) < 2
        return -1
    let d0 = ord(char_at(s, 0)) - 48
    let d1 = ord(char_at(s, 1)) - 48
    d0 * 10 + d1

// _vcc_prefix4 — return the 4-digit prefix as an integer, or -1 if s is too short.
fn _vcc_prefix4(s: string) -> int
    if len(s) < 4
        return -1
    let d0 = ord(char_at(s, 0)) - 48
    let d1 = ord(char_at(s, 1)) - 48
    let d2 = ord(char_at(s, 2)) - 48
    let d3 = ord(char_at(s, 3)) - 48
    d0 * 1000 + d1 * 100 + d2 * 10 + d3

// ---------- public API ----------

// vcc_is_valid — true iff s represents a valid credit-card number.
// Strips spaces and dashes; checks 13..19 digits; verifies Luhn check.
fn vcc_is_valid(s: string) -> bool
    let digits = _vcc_strip(s)
    let n = len(digits)
    if n < 13
        return false
    if n > 19
        return false
    if _vcc_all_digits(digits) == 0
        return false
    cd_luhn_valid(digits)

// vcc_brand — detect the card network from stripped digit string.
// Rules applied in order (most specific first):
//   amex:       starts 34 or 37, len 15
//   discover:   starts 6011, len 16  OR  starts 65, len 16
//   mastercard: starts 51-55, len 16  OR  starts 2221-2720, len 16
//   visa:       starts 4, len 13/16/19
//   unknown:    anything else
fn vcc_brand(s: string) -> string
    let digits = _vcc_strip(s)
    let n = len(digits)
    // amex: starts 34 or 37, length 15
    if n == 15
        let p2 = _vcc_prefix2(digits)
        if p2 == 34
            return "amex"
        if p2 == 37
            return "amex"
    // discover: starts 6011 or 65, length 16
    if n == 16
        let p4 = _vcc_prefix4(digits)
        if p4 == 6011
            return "discover"
        let p2d = _vcc_prefix2(digits)
        if p2d == 65
            return "discover"
    // mastercard: starts 51-55 or 2221-2720, length 16
    if n == 16
        let p2m = _vcc_prefix2(digits)
        if p2m >= 51
            if p2m <= 55
                return "mastercard"
        let p4m = _vcc_prefix4(digits)
        if p4m >= 2221
            if p4m <= 2720
                return "mastercard"
    // visa: starts 4, length 13, 16, or 19
    if len(digits) >= 1
        let first = ord(char_at(digits, 0)) - 48
        if first == 4
            if n == 13
                return "visa"
            if n == 16
                return "visa"
            if n == 19
                return "visa"
    "unknown"

// vcc_mask — replace all digits except the last 4 with '*'.
// Strips spaces and dashes first; the returned string is compact (no separators).
fn vcc_mask(s: string) -> string
    let digits = _vcc_strip(s)
    let n = len(digits)
    let out_parts = []
    for i in 0..n
        if i < n - 4
            push(out_parts, "*")
        else
            push(out_parts, char_at(digits, i))
    let out = join(out_parts, "")
    out
