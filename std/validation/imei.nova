// std/validation/imei.nova — IMEI validation (ITU-T E.212 + Luhn check).
// LEAF — imports NOTHING.
//
// Public API:
//   vim_is_valid(s)       -> bool   strip spaces/dashes; exactly 15 digits;
//                                   passes Luhn check.
//   vim_tac(s)            -> string first 8 digits = Type Allocation Code.
//   vim_check_digit(s)    -> string last digit of the (normalised) IMEI.
//   vim_compute_check(s14) -> int   correct Luhn check digit for 14-digit prefix.

// ---------- internal helpers ----------

// _vim_strip — remove spaces and dashes, return remaining chars.
fn _vim_strip(s: string) -> string
    let out_parts = []
    let n = len(s)
    for i in 0..n
        let c = char_at(s, i)
        if c != " "
            if c != "-"
                push(out_parts, c)
    let out = join(out_parts, "")
    out

// _vim_all_digits — true iff every character in s is '0'..'9'.
fn _vim_all_digits(s: string) -> bool
    let n = len(s)
    let i = 0
    let ok = true
    while i < n
        let o = ord(char_at(s, i))
        if o < 48
            ok = false
        if o > 57
            ok = false
        i += 1
    ok

// _vim_luhn_sum — compute Luhn sum over a digit string of any length.
// Double every digit at an ODD index (0-based: positions 1,3,5,...).
// If doubled value > 9, subtract 9.  Return total sum.
fn _vim_luhn_sum(digits: string) -> int
    let n = len(digits)
    let total = 0
    for i in 0..n
        let d = ord(char_at(digits, i)) - 48
        if i % 2 == 1
            let d2 = d * 2
            if d2 > 9
                d2 -= 9
            total += d2
        else
            total += d
    total

// ---------- public API ----------

// vim_is_valid — true iff s (after stripping spaces and dashes) is exactly
// 15 digits and its Luhn checksum is divisible by 10.
fn vim_is_valid(s: string) -> bool
    let norm = _vim_strip(s)
    if len(norm) != 15
        return false
    if _vim_all_digits(norm) == false
        return false
    let total = _vim_luhn_sum(norm)
    total % 10 == 0

// vim_tac — return the Type Allocation Code (first 8 digits) of an IMEI.
// Does NOT validate the full IMEI; strips separators first.
// Returns "" if the stripped string has fewer than 8 characters.
fn vim_tac(s: string) -> string
    let norm = _vim_strip(s)
    if len(norm) < 8
        return ""
    slice(norm, 0, 8)

// vim_check_digit — return the check digit (last character) of the IMEI
// as a one-character string.
// Returns "" if the stripped string is empty.
fn vim_check_digit(s: string) -> string
    let norm = _vim_strip(s)
    let n = len(norm)
    if n == 0
        return ""
    slice(norm, n - 1, n)

// vim_compute_check — given the first 14 digits (as a string), return the
// correct Luhn check digit (0-9) that makes the full 15-digit IMEI valid.
// The check digit d satisfies: (_vim_luhn_sum(s14 + str(d))) % 10 == 0.
// Because appending digit d at index 14 (even index) adds d directly to
// the Luhn sum of the prefix (index 14 is even, no doubling), the answer is
//   d = (10 - (_vim_luhn_sum(s14) % 10)) % 10
fn vim_compute_check(s14: string) -> int
    let partial = _vim_luhn_sum(s14)
    (10 - partial % 10) % 10
