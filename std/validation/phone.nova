// std/validation/phone.nova — Phone number validation (E.164-ish).
// LEAF — imports NOTHING.
//
// Public API:
//   vph_is_valid_e164(s) -> bool   optional leading '+', then 8..15 digits, first digit 1..9
//   vph_normalize(s)     -> string strip spaces/dashes/parens, keep leading '+'
//   vph_country_code(s)  -> string leading '+' then 1..3 digits for known codes, else ""
//   vph_digits_only(s)   -> string only the digit characters from s

// vph_digits_only — return only the ASCII digit characters from s.
fn vph_digits_only(s: string) -> string
    let result = ""
    let n = len(s)
    let i = 0
    while i < n
        let c = char_at(s, i)
        let v = ord(c) - 48
        if v >= 0
            if v <= 9
                result = result + c
        i = i + 1
    result

// vph_normalize — strip spaces, dashes, and parentheses; preserve a leading '+'.
fn vph_normalize(s: string) -> string
    let has_plus = 0
    let n = len(s)
    if n > 0
        let first = char_at(s, 0)
        if first == "+"
            has_plus = 1
    let digits = ""
    let i = 0
    while i < n
        let c = char_at(s, i)
        let v = ord(c) - 48
        if v >= 0
            if v <= 9
                digits = digits + c
        i = i + 1
    if has_plus == 1
        return "+" + digits
    digits

// vph_is_valid_e164 — true iff s is a valid E.164-ish number:
//   optional leading '+', then 8..15 digit characters, first digit 1..9.
fn vph_is_valid_e164(s: string) -> bool
    let n = len(s)
    if n == 0
        return false
    // determine where digits start
    let start = 0
    let first_c = char_at(s, 0)
    if first_c == "+"
        start = 1
    // collect digits from start onward; reject any non-digit
    let dig_count = 0
    let first_digit_val = 0
    let all_digits = 1
    let i = start
    while i < n
        let c = char_at(s, i)
        let v = ord(c) - 48
        if v >= 0
            if v <= 9
                if dig_count == 0
                    first_digit_val = v
                dig_count = dig_count + 1
            else
                all_digits = 0
        else
            all_digits = 0
        i = i + 1
    if all_digits == 0
        return false
    if dig_count < 8
        return false
    if dig_count > 15
        return false
    if first_digit_val < 1
        return false
    true

// vph_country_code — if s starts with '+' followed by a known country code prefix
// (1..3 digits), return that prefix (without '+'); else return "".
// Small known set: "1" (NANP), "7" (Russia/Kazakhstan), "20" (Egypt),
// "27" (South Africa), "30" (Greece), "31" (Netherlands), "32" (Belgium),
// "33" (France), "34" (Spain), "36" (Hungary), "39" (Italy), "40" (Romania),
// "41" (Switzerland), "43" (Austria), "44" (UK), "45" (Denmark), "46" (Sweden),
// "47" (Norway), "48" (Poland), "49" (Germany), "51" (Peru), "52" (Mexico),
// "53" (Cuba), "54" (Argentina), "55" (Brazil), "56" (Chile), "57" (Colombia),
// "58" (Venezuela), "60" (Malaysia), "61" (Australia), "62" (Indonesia),
