// "94" (Sri Lanka), "95" (Myanmar), "98" (Iran),
// "212" (Morocco), "213" (Algeria), "216" (Tunisia), "218" (Libya),
// "220" (Gambia), "221" (Senegal), "222" (Mauritania), "223" (Mali),
// "224" (Guinea), "225" (Ivory Coast), "226" (Burkina Faso), "227" (Niger),
// "228" (Togo), "229" (Benin), "230" (Mauritius), "231" (Liberia),
// "232" (Sierra Leone), "233" (Ghana), "234" (Nigeria), "235" (Chad),
// "236" (Central African Rep.), "237" (Cameroon), "238" (Cape Verde),
// "239" (Sao Tome), "240" (Equatorial Guinea), "241" (Gabon),
// "242" (Republic of Congo), "243" (DR Congo), "244" (Angola),
// "245" (Guinea-Bissau), "246" (British Indian Ocean), "247" (Ascension Is.),
// "248" (Seychelles), "249" (Sudan), "250" (Rwanda), "251" (Ethiopia),
// "252" (Somalia), "253" (Djibouti), "254" (Kenya), "255" (Tanzania),
// "256" (Uganda), "257" (Burundi), "258" (Mozambique), "260" (Zambia),
// "261" (Madagascar), "262" (Reunion), "263" (Zimbabwe), "264" (Namibia),
// "265" (Malawi), "266" (Lesotho), "267" (Botswana), "268" (Swaziland),
// "269" (Comoros), "290" (St Helena), "291" (Eritrea), "297" (Aruba),
// "298" (Faroe Islands), "299" (Greenland),
// "350" (Gibraltar), "351" (Portugal), "352" (Luxembourg), "353" (Ireland),
// "354" (Iceland), "355" (Albania), "356" (Malta), "357" (Cyprus),
// "358" (Finland), "359" (Bulgaria), "370" (Lithuania), "371" (Latvia),
// "372" (Estonia), "373" (Moldova), "374" (Armenia), "375" (Belarus),
// "376" (Andorra), "377" (Monaco), "378" (San Marino), "380" (Ukraine),
// "381" (Serbia), "382" (Montenegro), "385" (Croatia), "386" (Slovenia),
// "387" (Bosnia), "389" (North Macedonia), "420" (Czech Republic),
// "421" (Slovakia), "423" (Liechtenstein), "500" (Falkland Islands),
// "501" (Belize), "502" (Guatemala), "503" (El Salvador), "504" (Honduras),
// "505" (Nicaragua), "506" (Costa Rica), "507" (Panama), "508" (St Pierre),
// "509" (Haiti), "590" (Guadeloupe), "591" (Bolivia), "592" (Guyana),
// "593" (Ecuador), "594" (French Guiana), "595" (Paraguay), "596" (Martinique),
// "597" (Suriname), "598" (Uruguay), "599" (Curacao), "670" (East Timor),
// "672" (Norfolk Island), "673" (Brunei), "674" (Nauru), "675" (Papua New Guinea),
// "676" (Tonga), "677" (Solomon Islands), "678" (Vanuatu), "679" (Fiji),
// "680" (Palau), "681" (Wallis and Futuna), "682" (Cook Islands), "683" (Niue),
// "685" (Samoa), "686" (Kiribati), "687" (New Caledonia), "688" (Tuvalu),
// "689" (French Polynesia), "690" (Tokelau), "691" (Micronesia), "692" (Marshall Islands),
// "850" (North Korea), "852" (Hong Kong), "853" (Macau), "855" (Cambodia),
// "856" (Laos), "880" (Bangladesh), "886" (Taiwan), "960" (Maldives),
// "961" (Lebanon), "962" (Jordan), "963" (Syria), "964" (Iraq), "965" (Kuwait),
// "966" (Saudi Arabia), "967" (Yemen), "968" (Oman), "970" (Palestinian Territory),
// "971" (UAE), "972" (Israel), "973" (Bahrain), "974" (Qatar), "975" (Bhutan),
// "976" (Mongolia), "977" (Nepal), "992" (Tajikistan), "993" (Turkmenistan),
// "994" (Azerbaijan), "995" (Georgia), "996" (Kyrgyzstan), "998" (Uzbekistan).
fn vph_country_code(s: string) -> string
    let n = len(s)
    if n < 2
        return ""
    let first = char_at(s, 0)
    if first != "+"
        return ""
    // extract up to 4 chars after '+' (enough for 1..3 digit prefix + boundary check)
    // try 3-digit prefix first (positions 1,2,3)
    if n >= 4
        let d1 = char_at(s, 1)
        let d2 = char_at(s, 2)
        let d3 = char_at(s, 3)
        let v1 = ord(d1) - 48
        let v2 = ord(d2) - 48
        let v3 = ord(d3) - 48
        if v1 >= 0
            if v1 <= 9
                if v2 >= 0
                    if v2 <= 9
                        if v3 >= 0
                            if v3 <= 9
                                let code3 = d1 + d2 + d3
                                let found3 = 0
                                if code3 == "212" or code3 == "213" or code3 == "216" or code3 == "218"
                                    found3 = 1
                                if code3 == "220" or code3 == "221" or code3 == "222" or code3 == "223"
                                    found3 = 1
                                if code3 == "224" or code3 == "225" or code3 == "226" or code3 == "227"
                                    found3 = 1
                                if code3 == "228" or code3 == "229" or code3 == "230" or code3 == "231"
                                    found3 = 1
                                if code3 == "232" or code3 == "233" or code3 == "234" or code3 == "235"
                                    found3 = 1
                                if code3 == "236" or code3 == "237" or code3 == "238" or code3 == "239"
                                    found3 = 1
                                if code3 == "240" or code3 == "241" or code3 == "242" or code3 == "243"
                                    found3 = 1
                                if code3 == "244" or code3 == "245" or code3 == "246" or code3 == "247"
                                    found3 = 1
                                if code3 == "248" or code3 == "249" or code3 == "250" or code3 == "251"
                                    found3 = 1
                                if code3 == "252" or code3 == "253" or code3 == "254" or code3 == "255"
                                    found3 = 1
                                if code3 == "256" or code3 == "257" or code3 == "258" or code3 == "260"
                                    found3 = 1
                                if code3 == "261" or code3 == "262" or code3 == "263" or code3 == "264"
                                    found3 = 1
                                if code3 == "265" or code3 == "266" or code3 == "267" or code3 == "268"
                                    found3 = 1
                                if code3 == "269" or code3 == "290" or code3 == "291" or code3 == "297"
                                    found3 = 1
                                if code3 == "298" or code3 == "299"
                                    found3 = 1
                                if code3 == "350" or code3 == "351" or code3 == "352" or code3 == "353"
                                    found3 = 1
                                if code3 == "354" or code3 == "355" or code3 == "356" or code3 == "357"
                                    found3 = 1
                                if code3 == "358" or code3 == "359" or code3 == "370" or code3 == "371"
                                    found3 = 1
                                if code3 == "372" or code3 == "373" or code3 == "374" or code3 == "375"
                                    found3 = 1
                                if code3 == "376" or code3 == "377" or code3 == "378" or code3 == "380"
                                    found3 = 1
                                if code3 == "381" or code3 == "382" or code3 == "385" or code3 == "386"
                                    found3 = 1
                                if code3 == "387" or code3 == "389" or code3 == "420" or code3 == "421"
                                    found3 = 1
                                if code3 == "423" or code3 == "500" or code3 == "501" or code3 == "502"
                                    found3 = 1
                                if code3 == "503" or code3 == "504" or code3 == "505" or code3 == "506"
                                    found3 = 1
                                if code3 == "507" or code3 == "508" or code3 == "509" or code3 == "590"
                                    found3 = 1
                                if code3 == "591" or code3 == "592" or code3 == "593" or code3 == "594"
                                    found3 = 1
                                if code3 == "595" or code3 == "596" or code3 == "597" or code3 == "598"
                                    found3 = 1
                                if code3 == "599" or code3 == "670" or code3 == "672" or code3 == "673"
                                    found3 = 1
                                if code3 == "674" or code3 == "675" or code3 == "676" or code3 == "677"
                                    found3 = 1
                                if code3 == "678" or code3 == "679" or code3 == "680" or code3 == "681"
                                    found3 = 1
                                if code3 == "682" or code3 == "683" or code3 == "685" or code3 == "686"
                                    found3 = 1
                                if code3 == "687" or code3 == "688" or code3 == "689" or code3 == "690"
                                    found3 = 1
                                if code3 == "691" or code3 == "692" or code3 == "850" or code3 == "852"
                                    found3 = 1
                                if code3 == "853" or code3 == "855" or code3 == "856" or code3 == "880"
                                    found3 = 1
                                if code3 == "886" or code3 == "960" or code3 == "961" or code3 == "962"
                                    found3 = 1
                                if code3 == "963" or code3 == "964" or code3 == "965" or code3 == "966"
                                    found3 = 1
                                if code3 == "967" or code3 == "968" or code3 == "970" or code3 == "971"
                                    found3 = 1
                                if code3 == "972" or code3 == "973" or code3 == "974" or code3 == "975"
                                    found3 = 1
                                if code3 == "976" or code3 == "977" or code3 == "992" or code3 == "993"
                                    found3 = 1
                                if code3 == "994" or code3 == "995" or code3 == "996" or code3 == "998"
                                    found3 = 1
                                if found3 == 1
                                    return code3
    // try 2-digit prefix (positions 1,2)
    if n >= 3
        let d1 = char_at(s, 1)
        let d2 = char_at(s, 2)
        let v1 = ord(d1) - 48
        let v2 = ord(d2) - 48
        if v1 >= 0
            if v1 <= 9
                if v2 >= 0
                    if v2 <= 9
                        let code2 = d1 + d2
                        let found2 = 0
                        if code2 == "20" or code2 == "27" or code2 == "30" or code2 == "31"
                            found2 = 1
                        if code2 == "32" or code2 == "33" or code2 == "34" or code2 == "36"
                            found2 = 1
                        if code2 == "39" or code2 == "40" or code2 == "41" or code2 == "43"
                            found2 = 1
                        if code2 == "44" or code2 == "45" or code2 == "46" or code2 == "47"
                            found2 = 1
                        if code2 == "48" or code2 == "49" or code2 == "51" or code2 == "52"
                            found2 = 1
                        if code2 == "53" or code2 == "54" or code2 == "55" or code2 == "56"
                            found2 = 1
                        if code2 == "57" or code2 == "58" or code2 == "60" or code2 == "61"
                            found2 = 1
                        if code2 == "62" or code2 == "63" or code2 == "64" or code2 == "65"
                            found2 = 1
                        if code2 == "66" or code2 == "81" or code2 == "82" or code2 == "84"
                            found2 = 1
                        if code2 == "86" or code2 == "90" or code2 == "91" or code2 == "92"
                            found2 = 1
                        if code2 == "93" or code2 == "94" or code2 == "95" or code2 == "98"
                            found2 = 1
                        if found2 == 1
                            return code2
    // try 1-digit prefix (position 1)
    if n >= 2
        let d1 = char_at(s, 1)
        let v1 = ord(d1) - 48
        if v1 >= 1
            if v1 <= 9
                // "1" = NANP, "7" = Russia/Kazakhstan
                if d1 == "1" or d1 == "7"
                    return d1
    ""
