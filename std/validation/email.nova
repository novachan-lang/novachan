// std/validation/email -- pragmatic RFC-lite email validation. LEAF -- imports NOTHING.
//
// Public API:
//   vem_is_valid(s: string) -> int
//     Returns 1 if s is a syntactically valid email address, 0 otherwise.
//     Rules: exactly one '@'; non-empty local part with allowed chars
//     [a-zA-Z0-9._%-+]; no leading/trailing/double dots in local;
//     domain with at least one '.', labels non-empty, no leading/trailing/
//     double dots, TLD >= 2 letters (a-z/A-Z only).
//
//   vem_local(s: string) -> string
//     Returns the part of s before the first '@', or "" if no '@' exists.
//
//   vem_domain(s: string) -> string
//     Returns the part of s after the first '@', or "" if no '@' exists.

// PRIVATE: count occurrences of character c in string s.
fn _vem_count_char(s: string, c: string) -> int
    let n = len(s)
    let count = 0
    let i = 0
    while i < n
        let ch = char_at(s, i)
        if ch == c
            count = count + 1
        i = i + 1
    count

// PRIVATE: find index of first occurrence of character c in s, or -1.
fn _vem_index_of(s: string, c: string) -> int
    let n = len(s)
    let found = -1
    let i = 0
    let done = 0
    while i < n and done == 0
        let ch = char_at(s, i)
        if ch == c
            found = i
            done = 1
        i = i + 1
    found

// PRIVATE: returns 1 if character c is an allowed local-part char.
// Allowed: a-z A-Z 0-9 . _ % + -
fn _vem_is_local_char(c: string) -> int
    let o = ord(c)
    // a-z
    if o >= 97 and o <= 122
        return 1
    // A-Z
    if o >= 65 and o <= 90
        return 1
    // 0-9
    if o >= 48 and o <= 57
        return 1
    // . _ % + -
    if c == "."
        return 1
    if c == "_"
        return 1
    if c == "%"
        return 1
    if c == "+"
        return 1
    if c == "-"
        return 1
    0

// PRIVATE: returns 1 if character c is an ASCII letter (a-z or A-Z).
fn _vem_is_alpha(c: string) -> int
    let o = ord(c)
    if o >= 97 and o <= 122
        return 1
    if o >= 65 and o <= 90
        return 1
    0

// PRIVATE: returns 1 if character c is an ASCII letter or digit or hyphen.
// Used for domain label characters.
fn _vem_is_label_char(c: string) -> int
    let o = ord(c)
    if o >= 97 and o <= 122
        return 1
    if o >= 65 and o <= 90
        return 1
    if o >= 48 and o <= 57
        return 1
    if c == "-"
        return 1
    0

// PRIVATE: validate the local part (before @).
// Rules: non-empty, all chars allowed, no leading dot, no trailing dot,
// no consecutive dots.
fn _vem_valid_local(local: string) -> int
    let n = len(local)
    if n == 0
        return 0
    // leading dot
    if char_at(local, 0) == "."
        return 0
    // trailing dot
    if char_at(local, n - 1) == "."
        return 0
    let i = 0
    let valid = 1
    while i < n and valid == 1
        let c = char_at(local, i)
        if _vem_is_local_char(c) == 0
            valid = 0
        if valid == 1 and c == "." and i + 1 < n
            // consecutive dots
            if char_at(local, i + 1) == "."
                valid = 0
        i = i + 1
    valid

// PRIVATE: validate a single domain label.
// Rules: non-empty, chars are letter/digit/hyphen, must not start or end with hyphen.
fn _vem_valid_label(label: string) -> int
    let n = len(label)
    if n == 0
        return 0
    if char_at(label, 0) == "-"
        return 0
    if char_at(label, n - 1) == "-"
        return 0
    let i = 0
    let valid = 1
    while i < n and valid == 1
        let c = char_at(label, i)
        if _vem_is_label_char(c) == 0
            valid = 0
        i = i + 1
    valid

// PRIVATE: validate a TLD string.
// Rules: >= 2 chars, all ASCII letters only.
fn _vem_valid_tld(tld: string) -> int
    let n = len(tld)
    if n < 2
        return 0
    let i = 0
    let valid = 1
    while i < n and valid == 1
        let c = char_at(tld, i)
        if _vem_is_alpha(c) == 0
            valid = 0
        i = i + 1
    valid

// PRIVATE: validate the domain part (after @).
// Rules: non-empty, at least one '.', no leading/trailing/double dot,
// all labels valid, TLD (last label) >= 2 alpha chars.
fn _vem_valid_domain(domain: string) -> int
    let n = len(domain)
    if n == 0
        return 0
    // leading dot
    if char_at(domain, 0) == "."
        return 0
    // trailing dot
    if char_at(domain, n - 1) == "."
        return 0
    // must contain at least one dot
    if _vem_count_char(domain, ".") == 0
        return 0
    // split on '.' and validate each label; track last label for TLD check
    // We walk manually to find each label.
    let label_start = 0
    let valid = 1
    let last_label = ""
    let dot_count = 0
    let i = 0
    while i <= n and valid == 1
        let at_end = 0
        if i == n
            at_end = 1
        else
            if char_at(domain, i) == "."
                at_end = 1
        if at_end == 1
            // label is domain[label_start..i]
            let label = slice(domain, label_start, i)
            // check consecutive dots (empty label between dots)
            if len(label) == 0
                valid = 0
            if valid == 1
                if _vem_valid_label(label) == 0
                    valid = 0
            if valid == 1
                last_label = label
            label_start = i + 1
            dot_count = dot_count + 1
        i = i + 1
    if valid == 1
        if _vem_valid_tld(last_label) == 0
            valid = 0
    valid

// vem_local("john@example.com") -> "john"
// vem_local("noemail") -> ""
fn vem_local(s: string) -> string
    let idx = _vem_index_of(s, "@")
    if idx < 0
        return ""
    slice(s, 0, idx)

// vem_domain("john@example.com") -> "example.com"
// vem_domain("noemail") -> ""
fn vem_domain(s: string) -> string
    let idx = _vem_index_of(s, "@")
    if idx < 0
        return ""
    slice(s, idx + 1, len(s))

// vem_is_valid("a@b.com") -> 1
// vem_is_valid("bad") -> 0
// vem_is_valid("a@@b.com") -> 0
fn vem_is_valid(s: string) -> int
    // must have exactly one '@'
    if _vem_count_char(s, "@") != 1
        return 0
    let local = vem_local(s)
    let domain = vem_domain(s)
    if _vem_valid_local(local) == 0
        return 0
    if _vem_valid_domain(domain) == 0
        return 0
    1
