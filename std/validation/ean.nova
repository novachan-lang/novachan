// std/validation/ean.nova — EAN-13 and UPC-A barcode validation.
//
// Public API (prefix vean_):
//
//   vean_is_valid_ean13(s: string) -> bool
//     Return true iff s is exactly 13 ASCII digits and the EAN-13 check digit
//     is correct. Weights 1,3 alternating from the left over the first 12
//     digits; check = (10 - sum%10)%10 must equal the 13th digit.
//
//   vean_is_valid_upca(s: string) -> bool
//     Return true iff s is exactly 12 ASCII digits and the UPC-A check digit
//     is correct. Weights 3,1 alternating from the left over the first 11
//     digits; check = (10 - sum%10)%10 must equal the 12th digit.
//
//   vean_check_ean13(s12: string) -> int
//     Return the EAN-13 check digit for a 12-digit prefix string.
//     Returns -1 if the input is not exactly 12 ASCII digits.
//
//   vean_upca_to_ean13(s: string) -> string
//     Prepend '0' to convert a UPC-A barcode string to EAN-13 form.
//     No validation is performed; the caller must ensure s is a valid UPC-A.

// _vean_all_digits — return 1 iff every character in s is a digit 0-9.
fn _vean_all_digits(s: string) -> int
    let n = len(s)
    if n == 0
        return 0
    let ok = 1
    let i = 0
    while i < n and ok == 1
        let o = ord(char_at(s, i))
        if o < 48
            ok = 0
        if o > 57
            ok = 0
        i += 1
    ok

// _vean_digit — return the numeric value of the character at position pos in s.
// Assumes the character is a valid ASCII digit.
fn _vean_digit(s: string, pos: int) -> int
    ord(char_at(s, pos)) - 48

// _vean_ean13_sum — compute the weighted sum of the first 12 digits of s
// using EAN-13 weights (1,3 alternating from left, starting with weight 1).
fn _vean_ean13_sum(s: string) -> int
    let total = 0
    for i in 0..12
        let d = _vean_digit(s, i)
        if i % 2 == 0
            total += d * 1
        else
            total += d * 3
    total

// _vean_upca_sum — compute the weighted sum of the first 11 digits of s
// using UPC-A weights (3,1 alternating from left, starting with weight 3).
fn _vean_upca_sum(s: string) -> int
    let total = 0
    for i in 0..11
        let d = _vean_digit(s, i)
        if i % 2 == 0
            total += d * 3
        else
            total += d * 1
    total

// vean_is_valid_ean13 — return true iff s is a valid 13-digit EAN-13 barcode.
fn vean_is_valid_ean13(s: string) -> bool
    if len(s) != 13
        return false
    if _vean_all_digits(s) == 0
        return false
    let weighted_sum = _vean_ean13_sum(s)
    let check = (10 - weighted_sum % 10) % 10
    let last = _vean_digit(s, 12)
    check == last

// vean_is_valid_upca — return true iff s is a valid 12-digit UPC-A barcode.
fn vean_is_valid_upca(s: string) -> bool
    if len(s) != 12
        return false
    if _vean_all_digits(s) == 0
        return false
    let weighted_sum = _vean_upca_sum(s)
    let check = (10 - weighted_sum % 10) % 10
    let last = _vean_digit(s, 11)
    check == last

// vean_check_ean13 — return the EAN-13 check digit for a 12-digit prefix.
// Returns -1 if s is not exactly 12 ASCII digits.
fn vean_check_ean13(s12: string) -> int
    if len(s12) != 12
        return -1
    if _vean_all_digits(s12) == 0
        return -1
    let weighted_sum = _vean_ean13_sum(s12)
    (10 - weighted_sum % 10) % 10

// vean_upca_to_ean13 — prepend '0' to convert a UPC-A string to EAN-13 form.
fn vean_upca_to_ean13(s: string) -> string
    "0" + s
