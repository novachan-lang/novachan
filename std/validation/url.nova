// ============================================================================
// NOVA Standard Library — std/validation/url.nova
// URL validation utilities.
// LEAF — imports nothing.
//
// Public API (prefix: vurl_)
//   vurl_is_valid(s)  -> bool    true iff s is a well-formed URL
//                                (http/https/ftp scheme + "://" + non-empty host
//                                 with a dot or "localhost" + optional :digits +
//                                 optional /path)
//   vurl_scheme(s)    -> string  the scheme part ("http","https","ftp") or ""
//   vurl_host(s)      -> string  the host part (no port) or ""
//   vurl_is_https(s)  -> bool    true iff scheme is "https"
// ============================================================================

// ── internal helpers ─────────────────────────────────────────────────────────

// True iff every character in s[start..end) is an ASCII digit (and range is non-empty).
fn _vurl_all_digits(s: string, start: int, end_pos: int) -> bool
    if start >= end_pos
        return false
    let i = start
    while i < end_pos
        let b = ord(char_at(s, i))
        if b < 48
            return false
        if b > 57
            return false
        i = i + 1
    true

// True iff s equals "localhost".
fn _vurl_is_localhost(s: string) -> bool
    if len(s) != 9
        return false
    s == "localhost"

// True iff s contains a '.' (ASCII 46).
fn _vurl_has_dot(s: string) -> bool
    let n = len(s)
    let i = 0
    while i < n
        let b = ord(char_at(s, i))
        if b == 46
            return true
        i = i + 1
    false

// True iff scheme string is one of: http, https, ftp.
fn _vurl_valid_scheme(scheme: string) -> bool
    if scheme == "http"
        return true
    if scheme == "https"
        return true
    if scheme == "ftp"
        return true
    false

// ── core parse ───────────────────────────────────────────────────────────────

// Parse a URL and fill scheme/host/valid fields.
// Returns a dict with keys: "scheme" (string), "host" (string), "valid" (int 0/1).
fn _vurl_parse(s: string) -> dict
    let out = {}
    out["scheme"] = ""
    out["host"] = ""
    out["valid"] = 0

    // locate "://"
    let sep = find(s, "://")
    if sep < 0
        return out

    // extract and validate scheme
    let scheme = slice(s, 0, sep)
    if not _vurl_valid_scheme(scheme)
        return out
    out["scheme"] = scheme

    // rest is everything after "://"
    let after = slice(s, sep + 3, len(s))

    // rest must be non-empty
    if len(after) == 0
        return out

    // find where the authority ends (at first '/')
    let slash_pos = find(after, "/")
    let authority = ""
    if slash_pos >= 0
        authority = slice(after, 0, slash_pos)
    else
        authority = after

    // split authority into host and optional port at ':'
    let colon_pos = find(authority, ":")
    let host = ""
    if colon_pos >= 0
        host = slice(authority, 0, colon_pos)
        // port portion must be all digits (and non-empty)
        let port_str = slice(authority, colon_pos + 1, len(authority))
        if not _vurl_all_digits(port_str, 0, len(port_str))
            return out
    else
        host = authority

    // host must be non-empty
    if len(host) == 0
        return out

    // host must contain a dot OR be "localhost"
    if not _vurl_has_dot(host)
        if not _vurl_is_localhost(host)
            return out

    out["host"] = host
    out["valid"] = 1
    out

// ── public API ───────────────────────────────────────────────────────────────

// vurl_is_valid — true iff s is a well-formed URL (http/https/ftp scheme,
// host with dot or "localhost", optional :port digits, optional /path).
fn vurl_is_valid(s: string) -> bool
    let p = _vurl_parse(s)
    p["valid"] == 1

// vurl_scheme — return the scheme portion of s ("http", "https", "ftp")
// or "" if the URL is invalid.
fn vurl_scheme(s: string) -> string
    let p = _vurl_parse(s)
    if p["valid"] == 0
        return ""
    p["scheme"]

// vurl_host — return the host portion of s (no port, no path) or "" if invalid.
fn vurl_host(s: string) -> string
    let p = _vurl_parse(s)
    if p["valid"] == 0
        return ""
    p["host"]

// vurl_is_https — true iff the URL has scheme "https".
fn vurl_is_https(s: string) -> bool
    let p = _vurl_parse(s)
    if p["valid"] == 0
        return false
    p["scheme"] == "https"
