// std/scheduling/page_fifo.nova
// FIFO (First-In-First-Out) page replacement algorithm.
// Tracks which page arrived first and evicts it on a fault when frames are full.
// Demonstrates Belady's anomaly: more frames can cause MORE faults with FIFO.
// LEAF — imports nothing.

// _pf_in_frames: true if page appears in frames_arr[0..size-1]
fn _pf_in_frames(frames_arr: list, size: int, page: int) -> bool
    let i = 0
    while i < size
        if frames_arr[i] == page
            return true
        i = i + 1
    return false

// pf_faults: number of page faults using FIFO replacement with given frame count.
// Circular buffer: head points to the oldest slot to evict on next fault.
fn pf_faults(refs: list, frames: int) -> int
    if frames <= 0
        return len(refs)
    let n = len(refs)
    if n == 0
        return 0
    // Pre-allocate frames_arr; -1 = empty
    let frames_arr = []
    let fi = 0
    while fi < frames
        push(frames_arr, 0 - 1)
        fi = fi + 1
    let size = 0
    let head = 0
    let faults = 0
    let i = 0
    while i < n
        let page = refs[i]
        if not _pf_in_frames(frames_arr, size, page)
            faults = faults + 1
            if size < frames
                frames_arr[size] = page
                size = size + 1
            else
                // evict oldest (at head), overwrite with new page, advance head
                frames_arr[head] = page
                head = (head + 1) % frames
        i = i + 1
    return faults

// pf_hits: number of page hits (page already in frames) using FIFO replacement.
fn pf_hits(refs: list, frames: int) -> int
    let n = len(refs)
    if n == 0
        return 0
    return n - pf_faults(refs, frames)
