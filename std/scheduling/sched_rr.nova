// std/scheduling/sched_rr.nova — Round Robin CPU scheduler with time quantum q.
//
// Processes: list of [arrival, burst] 2-element lists. PID = index in procs.
// Convention: new arrivals at the same tick a preempted process is re-queued
// enter the ready queue BEFORE the preempted process (standard Linux-style RR).
//
// Public API:
//   rr_completion_times(procs, q) -> list  per-pid completion times (input order)
//   rr_waiting_times(procs, q)    -> list  per-pid waiting times (completion - arrival - burst)
//   rr_context_switches(procs, q) -> int   number of CPU switches between distinct processes

// _rr_build_queue: append all pids whose arrival <= t and not yet enqueued.
// enqueued is a list of booleans (0/1) indexed by pid.
fn _rr_enqueue_arrivals(ready, enqueued, procs, t, skip_pid)
    let n = len(procs)
    let i = 0
    while i < n
        if i != skip_pid
            let eq = enqueued[i]
            if eq == 0
                let p = procs[i]
                let arr = p[0]
                if arr <= t
                    push(ready, i)
                    enqueued[i] = 1
        i = i + 1

// rr_completion_times: simulate RR and return per-pid completion time.
fn rr_completion_times(procs, q) -> list
    let n = len(procs)
    let result = []
    let remaining = []
    let enqueued = []
    let i = 0
    while i < n
        let p = procs[i]
        push(remaining, p[1])
        push(result, 0)
        push(enqueued, 0)
        i = i + 1

    // Find first arrival time to handle idle CPU correctly
    let t = 1000000000
    let j = 0
    while j < n
        let p = procs[j]
        let arr = p[0]
        if arr < t
            t = arr
        j = j + 1

    let ready = []
    // Enqueue all processes that have arrived at the start time
    _rr_enqueue_arrivals(ready, enqueued, procs, t, -1)

    let done_count = 0
    let prev_pid = -1
    while done_count < n
        if len(ready) == 0
            // CPU idle: advance to next arrival
            let next_t = 1000000000
            let k = 0
            while k < n
                let eq = enqueued[k]
                if eq == 0
                    let p = procs[k]
                    let arr = p[0]
                    if arr < next_t
                        next_t = arr
                k = k + 1
            t = next_t
            _rr_enqueue_arrivals(ready, enqueued, procs, t, -1)
        if len(ready) > 0
            let pid = ready[0]
            // Remove front of queue
            let new_ready = []
            let ri = 1
            while ri < len(ready)
                push(new_ready, ready[ri])
                ri = ri + 1
            ready = new_ready

            let rem = remaining[pid]
            let run = rem
            if q < run
                run = q
            let end_t = t + run
            remaining[pid] = rem - run

            // Enqueue newly arrived processes before re-queueing the preempted one
            _rr_enqueue_arrivals(ready, enqueued, procs, end_t, pid)

            if remaining[pid] == 0
                result[pid] = end_t
                done_count = done_count + 1
            else
                // Re-queue preempted process after new arrivals
                push(ready, pid)

            t = end_t
    return result

// rr_waiting_times: waiting = completion - arrival - burst.
fn rr_waiting_times(procs, q) -> list
    let completions = rr_completion_times(procs, q)
    let result = []
    let i = 0
    while i < len(procs)
        let p = procs[i]
        let arr = p[0]
        let burst = p[1]
        let comp = completions[i]
        push(result, comp - arr - burst)
        i = i + 1
    return result

// rr_context_switches: count switches between distinct process PIDs.
fn rr_context_switches(procs, q) -> int
    let n = len(procs)
    let remaining = []
    let enqueued = []
    let i = 0
    while i < n
        let p = procs[i]
        push(remaining, p[1])
        push(enqueued, 0)
        i = i + 1

    let t = 1000000000
    let j = 0
    while j < n
        let p = procs[j]
        let arr = p[0]
        if arr < t
            t = arr
        j = j + 1

    let ready = []
    _rr_enqueue_arrivals(ready, enqueued, procs, t, -1)

    let done_count = 0
    let switches = 0
    let prev_pid = -1
    while done_count < n
        if len(ready) == 0
            let next_t = 1000000000
            let k = 0
            while k < n
                let eq = enqueued[k]
                if eq == 0
                    let p = procs[k]
                    let arr = p[0]
                    if arr < next_t
                        next_t = arr
                k = k + 1
            t = next_t
            _rr_enqueue_arrivals(ready, enqueued, procs, t, -1)
        if len(ready) > 0
            let pid = ready[0]
            let new_ready = []
            let ri = 1
            while ri < len(ready)
                push(new_ready, ready[ri])
                ri = ri + 1
            ready = new_ready

            if pid != prev_pid
                if prev_pid != -1
                    switches = switches + 1
                prev_pid = pid

            let rem = remaining[pid]
            let run = rem
            if q < run
                run = q
            let end_t = t + run
            remaining[pid] = rem - run

            _rr_enqueue_arrivals(ready, enqueued, procs, end_t, pid)

            if remaining[pid] == 0
                done_count = done_count + 1
            else
                push(ready, pid)

            t = end_t
    return switches
