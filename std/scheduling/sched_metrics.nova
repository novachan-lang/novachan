// std/scheduling/sched_metrics.nova — Scheduling performance metrics.
//
// All functions take procs (list of process lists) and completions (list of ints).
// Process format: at minimum [arrival, burst, ...]. PID = index.
//
// Public API:
//   sm_waiting_times(procs, completions)       -> list  per-pid (completion - arrival - burst)
//   sm_turnaround_times(procs, completions)    -> list  per-pid (completion - arrival)
//   sm_avg_waiting_x100(procs, completions)    -> int   average waiting * 100 (integer, no floats)
//   sm_makespan(procs, completions)            -> int   max(completion) - min(arrival)
//   sm_throughput_x1000(procs, completions)    -> int   n*1000 / makespan

// sm_waiting_times: per-process waiting time = completion - arrival - burst.
fn sm_waiting_times(procs, completions) -> list
    return [completions[i] - procs[i][0] - procs[i][1] for i in 0..len(procs)]

// sm_turnaround_times: per-process turnaround = completion - arrival.
fn sm_turnaround_times(procs, completions) -> list
    return [completions[i] - procs[i][0] for i in 0..len(procs)]

// sm_avg_waiting_x100: average waiting time * 100 as integer (avoids floats).
// Formula: sum(waiting_times) * 100 / n
fn sm_avg_waiting_x100(procs, completions) -> int
    let n = len(procs)
    if n == 0
        return 0
    let waits = sm_waiting_times(procs, completions)
    return waits.sum() * 100 / n

// sm_makespan: max completion time minus min arrival time.
fn sm_makespan(procs, completions) -> int
    let n = len(procs)
    if n == 0
        return 0
    let max_comp = max(completions[0..n])
    let min_arr = min([procs[i][0] for i in 0..n])
    return max_comp - min_arr

// sm_throughput_x1000: processes per unit time * 1000 as integer.
// Formula: n * 1000 / makespan
fn sm_throughput_x1000(procs, completions) -> int
    let n = len(procs)
    if n == 0
        return 0
    let ms = sm_makespan(procs, completions)
    if ms == 0
        return 0
    return n * 1000 / ms
