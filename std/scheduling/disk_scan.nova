// disk_scan — SCAN, LOOK, and C-SCAN disk arm scheduling algorithms.
// Computes total head movement (sum of absolute seek distances).
// direction: 1 = toward larger cylinder numbers, 0 = toward smaller.
//
// Public API:
//   ds_scan(requests, head, disk_max, direction) -> int
//       SCAN: sweep to the boundary (0 or disk_max), then reverse and serve remaining.
//   ds_look(requests, head, direction) -> int
//       LOOK: reverse at the last request in current direction (not the boundary).
//   ds_cscan(requests, head, disk_max) -> int
//       C-SCAN: sweep up to disk_max, jump to 0 (counting jump as disk_max distance),
//               then continue serving remaining requests going up.

// _ds_abs: absolute value of integer.
fn _ds_abs(x) -> int
    if x < 0
        return 0 - x
    return x

// _ds_sort_asc: insertion sort, ascending.
fn _ds_sort_asc(xs) -> list
    let n = len(xs)
    let out = []
    let i = 0
    while i < n
        push(out, xs[i])
        i = i + 1
    let j = 1
    while j < n
        let key = out[j]
        let k = j - 1
        while k >= 0 and out[k] > key
            out[k + 1] = out[k]
            k = k - 1
        out[k + 1] = key
        j = j + 1
    return out

// ds_scan: SCAN (elevator) algorithm.
// Sweeps in current direction to the boundary, then reverses.
// Returns total head movement.
fn ds_scan(requests, head, disk_max, direction) -> int
    let n = len(requests)
    if n == 0
        return 0
    let sorted = _ds_sort_asc(requests)
    let total = 0
    if direction == 1
        // going up: serve all requests >= head in ascending order, go to disk_max, then serve < head descending
        // movement to disk_max
        total = disk_max - head
        // then from disk_max to the smallest request
        let min_req = sorted[0]
        total = total + (disk_max - min_req)
    if direction == 0
        // going down: go to 0, then serve all requests > head ascending
        total = head - 0
        let max_req = sorted[n - 1]
        total = total + max_req
    return total

// ds_look: LOOK algorithm.
// Reverses at the last request in the current direction (not the boundary).
// Returns total head movement.
fn ds_look(requests, head, direction) -> int
    let n = len(requests)
    if n == 0
        return 0
    let sorted = _ds_sort_asc(requests)
    if direction == 1
        // find farthest request >= head
        let farthest = head
        let i = 0
        while i < n
            if sorted[i] >= head
                farthest = sorted[i]
            i = i + 1
        // find nearest request < head (min of all < head)
        let nearest_below = -1
        let j = 0
        while j < n
            if sorted[j] < head
                if nearest_below < 0 or sorted[j] < nearest_below
                    nearest_below = sorted[j]
            j = j + 1
        let total = farthest - head
        if nearest_below >= 0
            total = total + (farthest - nearest_below)
        return total
    // direction == 0: going down
    // find the minimum (lowest) request <= head (farthest in the downward sweep)
    let lowest = head
    let lowest_found = 0
    let i = 0
    while i < n
        if sorted[i] <= head
            if lowest_found == 0 or sorted[i] < lowest
                lowest = sorted[i]
                lowest_found = 1
        i = i + 1
    // find highest request > head
    let highest_above = -1
    let j = 0
    while j < n
        if sorted[j] > head
            if highest_above < 0 or sorted[j] > highest_above
                highest_above = sorted[j]
        j = j + 1
    let total = head - lowest
    if highest_above >= 0
        total = total + (highest_above - lowest)
    return total

// ds_cscan: C-SCAN (Circular SCAN) algorithm.
// Sweeps up to disk_max, then jumps to 0 (the jump counts as disk_max movement),
// then continues serving remaining requests going upward.
// Returns total head movement.
fn ds_cscan(requests, head, disk_max) -> int
    let n = len(requests)
    if n == 0
        return 0
    let sorted = _ds_sort_asc(requests)
    // split into above (>= head) and below (< head)
    let has_above = 0
    let max_above = head
    let i = 0
    while i < n
        if sorted[i] >= head
            has_above = 1
            max_above = sorted[i]
        i = i + 1
    let has_below = 0
    let max_below = 0
    let j = 0
    while j < n
        if sorted[j] < head
            has_below = 1
            max_below = sorted[j]
        j = j + 1
    // always go to disk_max first
    let total = disk_max - head
    // jump to 0 costs disk_max
    if has_below == 1
        total = total + disk_max
        total = total + max_below
    return total
