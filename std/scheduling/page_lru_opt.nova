// std/scheduling/page_lru_opt.nova
// LRU (Least-Recently-Used) and Optimal (Belady) page replacement algorithms.
// LRU evicts the page not used for the longest time.
// Optimal evicts the page whose next use is farthest in the future (theoretical lower bound).
// LEAF — imports nothing.

// _pl_in_frames: true if page appears in frames_arr[0..size-1]
fn _pl_in_frames(frames_arr: list, size: int, page: int) -> bool
    let i = 0
    while i < size
        if frames_arr[i] == page
            return true
        i = i + 1
    return false

// _pl_find_frame: index of page in frames_arr[0..size-1], or -1 if absent
fn _pl_find_frame(frames_arr: list, size: int, page: int) -> int
    let i = 0
    while i < size
        if frames_arr[i] == page
            return i
        i = i + 1
    return 0 - 1

// _pl_next_use: next index >= start_from in refs where refs[j]==page; len(refs) if never again
fn _pl_next_use(refs: list, n: int, page: int, start_from: int) -> int
    let j = start_from
    while j < n
        if refs[j] == page
            return j
        j = j + 1
    return n

// pl_lru_faults: number of page faults using LRU replacement with given frame count.
// Tracks last-use time per frame slot; evicts the slot with the smallest last-use time.
fn pl_lru_faults(refs: list, frames: int) -> int
    if frames <= 0
        return len(refs)
    let n = len(refs)
    if n == 0
        return 0
    // frames_arr: pages in frames; last_use: time each was last accessed
    let frames_arr = []
    let last_use = []
    let fi = 0
    while fi < frames
        push(frames_arr, 0 - 1)
        push(last_use, 0 - 1)
        fi = fi + 1
    let size = 0
    let faults = 0
    let i = 0
    while i < n
        let page = refs[i]
        let idx = _pl_find_frame(frames_arr, size, page)
        if idx >= 0
            // hit: update last-use time
            last_use[idx] = i
        else
            // fault
            faults = faults + 1
            if size < frames
                frames_arr[size] = page
                last_use[size] = i
                size = size + 1
            else
                // evict the frame with minimum last_use (least recently used)
                let lru_idx = 0
                let lru_time = last_use[0]
                let k = 1
                while k < frames
                    if last_use[k] < lru_time
                        lru_time = last_use[k]
                        lru_idx = k
                    k = k + 1
                frames_arr[lru_idx] = page
                last_use[lru_idx] = i
        i = i + 1
    return faults

// pl_optimal_faults: number of page faults using Optimal (Belady) replacement.
// On each fault, evicts the page whose next reference is farthest in the future.
// Ties (multiple pages never used again) broken by lowest frame-array index.
fn pl_optimal_faults(refs: list, frames: int) -> int
    if frames <= 0
        return len(refs)
    let n = len(refs)
    if n == 0
        return 0
    let frames_arr = []
    let fi = 0
    while fi < frames
        push(frames_arr, 0 - 1)
        fi = fi + 1
    let size = 0
    let faults = 0
    let i = 0
    while i < n
        let page = refs[i]
        if _pl_in_frames(frames_arr, size, page)
            // hit
            i = i + 1
        else
            faults = faults + 1
            if size < frames
                frames_arr[size] = page
                size = size + 1
            else
                // find which frame to evict: the one whose next use is farthest
                // next use is looked up starting at i+1 (the reference AFTER current)
                let evict_idx = 0
                let evict_next = _pl_next_use(refs, n, frames_arr[0], i + 1)
                let k = 1
                while k < frames
                    let next_k = _pl_next_use(refs, n, frames_arr[k], i + 1)
                    if next_k > evict_next
                        evict_next = next_k
                        evict_idx = k
                    k = k + 1
                frames_arr[evict_idx] = page
            i = i + 1
    return faults
