// sched_fcfs — First-Come-First-Served CPU scheduling (non-preemptive).
//
// Processes arrive at given times; CPU runs them in arrival order (ties by PID).
// CPU idles when no process has arrived yet.
//
// Each process is [arrival, burst].
//
// Public API:
//   fc_completion_times(procs) -> list   completion time per PID
//   fc_waiting_times(procs)    -> list   waiting time per PID (= completion - arrival - burst)
//   fc_turnaround_times(procs) -> list   turnaround time per PID (= completion - arrival)
//   fc_order(procs)            -> list   PIDs in execution order

// _fc_sort_order: return a list of indices sorted by (arrival, PID) ascending.
// Uses selection sort (avoids the tricky insertion-sort break issue in NOVA).
fn _fc_sort_order(procs)
    let n = len(procs)
    let order = [i for i in 0..n]
    // selection sort: for each position, find the minimum (by arrival then PID) from [pos..n-1]
    for pos in 0..n
        let best = pos
        let j = pos + 1
        while j < n
            let ba = procs[order[best]][0]
            let ja = procs[order[j]][0]
            let pick = false
            if ja < ba
                pick = true
            if ja == ba and order[j] < order[best]
                pick = true
            if pick
                best = j
            j += 1
        // swap order[pos] and order[best]
        let tmp = order[pos]
        order[pos] = order[best]
        order[best] = tmp
    return order

// fc_order: return list of PIDs in the order they are scheduled (FCFS).
fn fc_order(procs)
    return _fc_sort_order(procs)

// _fc_compute: compute completion time for each PID; returns list indexed by PID.
fn _fc_compute(procs)
    let n = len(procs)
    let completion = [0 for i in 0..n]
    if n == 0
        return completion
    let order = _fc_sort_order(procs)
    let time = 0
    for s in 0..n
        let pid = order[s]
        let arrival = procs[pid][0]
        let burst = procs[pid][1]
        // idle gap: if CPU is free before this process arrives
        if time < arrival
            time = arrival
        time += burst
        completion[pid] = time
    return completion

// fc_completion_times: completion time per PID in input order.
fn fc_completion_times(procs)
    return _fc_compute(procs)

// fc_waiting_times: waiting time per PID = completion - arrival - burst.
fn fc_waiting_times(procs)
    let n = len(procs)
    let comp = _fc_compute(procs)
    let result = []
    for i in 0..n
        let w = comp[i] - procs[i][0] - procs[i][1]
        push(result, w)
    return result

// fc_turnaround_times: turnaround time per PID = completion - arrival.
fn fc_turnaround_times(procs)
    let n = len(procs)
    let comp = _fc_compute(procs)
    let result = []
    for i in 0..n
        let ta = comp[i] - procs[i][0]
        push(result, ta)
    return result
