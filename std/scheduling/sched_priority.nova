// std/scheduling/sched_priority.nova — Priority CPU scheduler.
//
// Processes: list of [arrival, burst, priority] 3-element lists. PID = index.
// Lower priority number = higher priority. Ties broken by lowest PID.
//
// Public API:
//   pr_completion_times_np(procs) -> list  non-preemptive priority scheduling
//   pr_completion_times_p(procs)  -> list  preemptive priority scheduling
//   pr_waiting_times_np(procs)    -> list  waiting times under non-preemptive

// _pr_pick_np: pick the highest-priority arrived+unfinished process at time t.
// Returns -1 if none available.
fn _pr_pick_np(procs, done, t) -> int
    let n = len(procs)
    let best = -1
    let best_pri = 1000000001
    let best_pid = 1000000001
    for i in 0..n
        let d = done[i]
        if d == 0
            let p = procs[i]
            let arr = p[0]
            if arr <= t
                let pri = p[2]
                if pri < best_pri
                    best_pri = pri
                    best_pid = i
                    best = i
                else
                    if pri == best_pri
                        if i < best_pid
                            best_pid = i
                            best = i
    return best

// pr_completion_times_np: non-preemptive priority scheduling.
// Once a process starts, it runs to completion before the scheduler picks again.
fn pr_completion_times_np(procs) -> list
    let n = len(procs)
    let result = []
    let done = []
    for i in 0..n
        push(result, 0)
        push(done, 0)

    // Find earliest arrival to handle idle
    let t = 1000000000
    for j in 0..n
        let p = procs[j]
        let arr = p[0]
        if arr < t
            t = arr

    let done_count = 0
    while done_count < n
        let pid = _pr_pick_np(procs, done, t)
        if pid == -1
            // CPU idle: advance to next arrival of an undone process
            let next_t = 1000000000
            for k in 0..n
                let d = done[k]
                if d == 0
                    let p = procs[k]
                    let arr = p[0]
                    if arr < next_t
                        next_t = arr
            t = next_t
        else
            let p = procs[pid]
            let burst = p[1]
            t += burst
            result[pid] = t
            done[pid] = 1
            done_count += 1
    return result

// _pr_pick_p: pick highest-priority arrived+unfinished process at time t (preemptive).
fn _pr_pick_p(procs, remaining, t) -> int
    let n = len(procs)
    let best = -1
    let best_pri = 1000000001
    let best_pid = 1000000001
    for i in 0..n
        let rem = remaining[i]
        if rem > 0
            let p = procs[i]
            let arr = p[0]
            if arr <= t
                let pri = p[2]
                if pri < best_pri
                    best_pri = pri
                    best_pid = i
                    best = i
                else
                    if pri == best_pri
                        if i < best_pid
                            best_pid = i
                            best = i
    return best

// _pr_next_event: earliest future arrival OR next remaining=1 finish for current.
fn _pr_next_event(procs, remaining, t, cur_pid) -> int
    let next = 1000000000
    let n = len(procs)
    // Next arrival after t
    for i in 0..n
        let p = procs[i]
        let arr = p[0]
        if arr > t
            if arr < next
                next = arr
    // Current process completes at t + remaining[cur_pid] if running
    if cur_pid >= 0
        let rem = remaining[cur_pid]
        let fin = t + rem
        if fin < next
            next = fin
    return next

// pr_completion_times_p: preemptive priority scheduling.
// At each arrival (or completion), re-evaluate who runs.
fn pr_completion_times_p(procs) -> list
    let n = len(procs)
    let result = []
    let remaining = []
    for i in 0..n
        push(result, 0)
        let p = procs[i]
        push(remaining, p[1])

    let t = 1000000000
    for j in 0..n
        let p = procs[j]
        let arr = p[0]
        if arr < t
            t = arr

    let done_count = 0
    while done_count < n
        let pid = _pr_pick_p(procs, remaining, t)
        if pid == -1
            // CPU idle: advance to next arrival
            let next_t = 1000000000
            for k in 0..n
                let rem = remaining[k]
                if rem > 0
                    let p = procs[k]
                    let arr = p[0]
                    if arr < next_t
                        next_t = arr
            t = next_t
        else
            // Run until next event: a new arrival or this process finishes
            let next_t = _pr_next_event(procs, remaining, t, pid)
            let run = next_t - t
            remaining[pid] = remaining[pid] - run
            t = next_t
            if remaining[pid] == 0
                result[pid] = t
                done_count += 1
    return result

// pr_waiting_times_np: waiting = completion - arrival - burst (non-preemptive).
fn pr_waiting_times_np(procs) -> list
    let completions = pr_completion_times_np(procs)
    let result = []
    for i in 0..len(procs)
        let p = procs[i]
        let arr = p[0]
        let burst = p[1]
        let comp = completions[i]
        push(result, comp - arr - burst)
    return result
