// std/dp/dp_partition_equal.nova — Equal-subset-sum partition problems.
//
// Given a list of non-negative integers, determine whether it can be split
// into two subsets with equal sum, find the minimum achievable difference
// between the two subset sums, and reconstruct one such subset.
//
// All use a 0/1 knapsack DP on a flat reachability bitset (list of ints,
// one per sum value, 1 = reachable, 0 = not).
//
// Public API (prefix pe_):
//   pe_can_partition(nums) -> bool   true iff two equal-sum subsets exist
//   pe_min_diff(nums)      -> int    minimum |sum_A - sum_B| over all splits
//   pe_subset_for_half(nums) -> list one subset summing to total/2, or [] if impossible

// _pe_build_reach — build the reachability table for sums 0..target.
// Returns a list of (target+1) ints: reach[s]=1 iff sum s is achievable.
fn _pe_build_reach(nums, target) -> list
    let reach = []
    let k = 0
    while k <= target
        push(reach, 0)
        k += 1
    reach[0] = 1
    let n = len(nums)
    for i in 0..n
        let v = nums[i]
        // iterate sums backwards to avoid using item twice
        let s = target
        while s >= v
            if reach[s - v] == 1
                reach[s] = 1
            s -= 1
    return reach

// _pe_total — sum all elements of nums.
fn _pe_total(nums) -> int
    let s = 0
    let i = 0
    let n = len(nums)
    while i < n
        s += nums[i]
        i += 1
    return s

// pe_can_partition — true iff nums can be split into two equal-sum subsets.
fn pe_can_partition(nums) -> bool
    let n = len(nums)
    if n == 0
        return true
    let total = _pe_total(nums)
    if total % 2 != 0
        return false
    let half = total / 2
    let reach = _pe_build_reach(nums, half)
    return reach[half] == 1

// pe_min_diff — minimum |sum_A - sum_B| over all ways to split nums into two subsets.
fn pe_min_diff(nums) -> int
    let n = len(nums)
    if n == 0
        return 0
    let total = _pe_total(nums)
    let reach = _pe_build_reach(nums, total / 2)
    // find minimum diff: for each reachable sum t, diff = |total - 2*t|
    // t ranges 0..total/2; minimize total - 2*t (since t <= total/2, total-2*t >= 0)
    let best = total
    let t = 0
    let half = total / 2
    while t <= half
        if reach[t] == 1
            let diff = total - 2 * t
            if diff < 0
                diff = 0 - diff
            if diff < best
                best = diff
        t += 1
    return best

// pe_subset_for_half — reconstruct one subset that sums to total/2, or [] if impossible.
// Uses the forward-pass reachability table and backtracks item by item.
fn pe_subset_for_half(nums) -> list
    let n = len(nums)
    let empty = []
    if n == 0
        return empty
    let total = _pe_total(nums)
    if total % 2 != 0
        return empty
    let half = total / 2
    // Build full DP table: dp[i][s] = 1 if sum s is reachable using nums[0..i-1].
    // To allow backtracking we store a 2D table (n+1) x (half+1).
    let dp = []
    let i = 0
    while i <= n
        let row = []
        let s = 0
        while s <= half
            push(row, 0)
            s += 1
        push(dp, row)
        i += 1
    // base: 0 items, sum 0 is reachable
    let dp0 = dp[0]
    dp0[0] = 1
    dp[0] = dp0
    i = 1
    while i <= n
        let v = nums[i - 1]
        let prev = dp[i - 1]
        let cur = dp[i]
        let s = 0
        while s <= half
            if prev[s] == 1
                cur[s] = 1
            if s >= v
                if prev[s - v] == 1
                    cur[s] = 1
            s += 1
        dp[i] = cur
        i += 1
    // check if half is reachable
    let last = dp[n]
    if last[half] != 1
        return empty
    // backtrack to find the subset
    let result = []
    let rem = half
    let row = n
    while row > 0
        let v = nums[row - 1]
        let prev2 = dp[row - 1]
        // did we include nums[row-1]?
        if rem >= v and prev2[rem - v] == 1
            // include this item
            push(result, v)
            rem -= v
        // else skip (prev2[rem] == 1 by invariant)
        row -= 1
    return result
