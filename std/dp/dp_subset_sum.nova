// std/dp/dp_subset_sum.nova — Subset-Sum DP: existence, count, and one witness subset.
// All inputs are non-negative integers. O(n * target) time and space. LEAF — imports NOTHING.

// ss_exists: true iff some subset of nums sums to exactly target (empty subset hits target 0).
fn ss_exists(nums: list, target: int) -> bool
    if target == 0
        return true
    if target < 0
        return false
    let n = len(nums)
    if n == 0
        return false
    let dp = []
    let z = 0
    while z <= target
        push(dp, 0)
        z = z + 1
    dp[0] = 1
    let i = 0
    while i < n
        let x = nums[i]
        let s = target
        while s >= x
            if dp[s - x] == 1
                dp[s] = 1
            s = s - 1
        i = i + 1
    if dp[target] == 1
        return true
    return false

// ss_count: number of distinct subsets of nums that sum to exactly target
//   (the empty subset counts for target==0).
fn ss_count(nums: list, target: int) -> int
    if target < 0
        return 0
    let dp = []
    let z = 0
    while z <= target
        push(dp, 0)
        z = z + 1
    dp[0] = 1
    let i = 0
    let n = len(nums)
    while i < n
        let x = nums[i]
        let s = target
        while s >= x
            dp[s] = dp[s] + dp[s - x]
            s = s - 1
        i = i + 1
    return dp[target]

// _ss_build_table: internal — build a 2D boolean DP table for witness reconstruction.
// table[i][s] = 1 means the first i items can sum to s.
fn _ss_build_table(nums: list, target: int) -> list
    let n = len(nums)
    let table = []
    let i = 0
    while i <= n
        let row = []
        let s = 0
        while s <= target
            push(row, 0)
            s = s + 1
        push(table, row)
        i = i + 1
    // base: with 0 items, only sum=0 is reachable
    table[0][0] = 1
    let item = 1
    while item <= n
        let x = nums[item - 1]
        let s = 0
        while s <= target
            // carry forward the "don't take" case
            if table[item - 1][s] == 1
                table[item][s] = 1
            // take this item if it fits and predecessor is reachable
            if s >= x
                if table[item - 1][s - x] == 1
                    table[item][s] = 1
            s = s + 1
        item = item + 1
    return table

// ss_one: returns one subset of nums that sums to target, or [] if none exists.
//   The empty list [] is returned for target==0 (empty subset is a valid witness).
fn ss_one(nums: list, target: int) -> list
    if target == 0
        return []
    if target < 0
        return []
    let n = len(nums)
    if n == 0
        return []
    let table = _ss_build_table(nums, target)
    if table[n][target] == 0
        return []
    // backtrack from table[n][target] to recover the chosen subset
    let result = []
    let rem = target
    let i = n
    while i >= 1
        // if we could NOT reach rem without item i, we must have taken it
        if table[i - 1][rem] == 0
            push(result, nums[i - 1])
            rem = rem - nums[i - 1]
        i = i - 1
    return result
