// dp_max_subarray — Kadane's algorithm for maximum subarray.
//
// ms_max_sum(nums)          — maximum contiguous subarray sum (all-negative: max element).
// ms_range(nums)            — [start, end] inclusive indices of a max subarray.
// ms_max_sum_circular(nums) — max subarray sum in a circular (wrap-around) arrangement.

// ms_max_sum(nums) — maximum contiguous subarray sum using Kadane's algorithm.
fn ms_max_sum(nums)
    let n = len(nums)
    if n == 0
        return 0
    let best = nums[0]
    let cur = nums[0]
    for i in 1..n
        let prev_plus = cur + nums[i]
        if nums[i] > prev_plus
            cur = nums[i]
        else
            cur = prev_plus
        if cur > best
            best = cur
    return best

// ms_range(nums) — [start, end] inclusive 0-based indices of a maximum subarray.
// Ties broken by the leftmost, earliest-ending maximum subarray.
fn ms_range(nums)
    let n = len(nums)
    if n == 0
        let r = []
        push(r, 0)
        push(r, 0)
        return r
    let best = nums[0]
    let cur = nums[0]
    let best_start = 0
    let best_end = 0
    let cur_start = 0
    for i in 1..n
        let prev_plus = cur + nums[i]
        if nums[i] > prev_plus
            cur = nums[i]
            cur_start = i
        else
            cur = prev_plus
        if cur > best
            best = cur
            best_start = cur_start
            best_end = i
    let result = []
    push(result, best_start)
    push(result, best_end)
    return result

// ms_max_sum_circular(nums) — max subarray sum treating nums as circular.
// Uses the identity: circular_max = max(linear_max, total_sum - linear_min).
// If all elements are negative, returns the maximum element (circular reduces to linear case).
fn ms_max_sum_circular(nums)
    let n = len(nums)
    if n == 0
        return 0
    let total = 0
    for i in 0..n
        total = total + nums[i]
    // linear max (standard Kadane)
    let lin_max = nums[0]
    let cur_max = nums[0]
    for j in 1..n
        let prev_plus = cur_max + nums[j]
        if nums[j] > prev_plus
            cur_max = nums[j]
        else
            cur_max = prev_plus
        if cur_max > lin_max
            lin_max = cur_max
    // linear min (Kadane for minimum)
    let lin_min = nums[0]
    let cur_min = nums[0]
    for k in 1..n
        let prev_plus_min = cur_min + nums[k]
        if nums[k] < prev_plus_min
            cur_min = nums[k]
        else
            cur_min = prev_plus_min
        if cur_min < lin_min
            lin_min = cur_min
    let circular = total - lin_min
    // if all elements negative, lin_min == total and circular == 0 which is wrong
    // detect all-negative: lin_max < 0 means no non-negative element
    if lin_max < 0
        return lin_max
    if circular > lin_max
        return circular
    return lin_max
