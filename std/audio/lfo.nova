// std/audio/lfo.nova — Low-Frequency Oscillator for modulation.
// Prefix: lfo_
// Provides: lfo_value
// LEAF — imports NOTHING.
//
// lfo_value(shape, phase01, depth, center) -> float
//   shape: "sine" | "triangle" | "square"
//   phase01: oscillator phase in [0.0, 1.0)
//   depth: amplitude of modulation (half-peak from center)
//   center: output center / offset
//   output = center + depth * osc(phase01)
//   osc output in [-1.0, 1.0]
//
// FLOAT RULES:
//   - All numeric inputs/outputs are floats.
//   - Bind sub-expressions to named lets before returning.
//   - PI via zero-arg fn (no module-level const).
//   - Never return a big float expr directly.

fn _lfo_pi() -> float
    let v = 3.14159265358979
    v

// _lfo_sine: sine wave oscillator, output in [-1.0, 1.0]
fn _lfo_sine(phase01: float) -> float
    let two_pi = 2.0 * _lfo_pi()
    let angle = two_pi * phase01
    let s = sin(angle)
    s

// _lfo_triangle: triangle wave, output in [-1.0, 1.0]
// Rises from -1 to +1 over first half, falls from +1 to -1 over second half.
fn _lfo_triangle(phase01: float) -> float
    let v = 0.0
    if phase01 < 0.5
        // rises: -1.0 at 0.0, +1.0 at 0.5
        let t = phase01 * 4.0 - 1.0
        v = t
    else
        // falls: +1.0 at 0.5, -1.0 at 1.0
        let t = (1.0 - phase01) * 4.0 - 1.0
        v = t
    v

// _lfo_square: square wave, output center+depth or center-depth
// Returns +1.0 for phase01 < 0.5, -1.0 otherwise
fn _lfo_square(phase01: float) -> float
    let v = 0.0
    if phase01 < 0.5
        v = 1.0
    else
        v = -1.0
    v

// lfo_value(shape, phase01, depth, center) -> float
// Computes: center + depth * osc(phase01)
// shape: "sine" | "triangle" | "square"
fn lfo_value(shape: string, phase01: float, depth: float, center: float) -> float
    let osc = 0.0
    if shape == "sine"
        osc = _lfo_sine(phase01)
    else if shape == "triangle"
        osc = _lfo_triangle(phase01)
    else if shape == "square"
        osc = _lfo_square(phase01)
    let scaled = depth * osc
    let result = center + scaled
    result
