// std/audio/osc_saw.nova — Sawtooth wave oscillator.
// Prefix: osc_saw_
// Provides: osc_saw
// LEAF — imports NOTHING.
//
// osc_saw(phase01) -> float
//   Rising ramp waveform. phase01 in [0.0, 1.0).
//   Output = 2.0*phase01 - 1.0, mapping:
//     phase01=0.0 -> -1.0
//     phase01=0.5 ->  0.0
//     phase01=1.0 ->  1.0 (wraps back to -1.0 at reset)
//
// FLOAT RULES:
//   - All inputs/outputs are floats.
//   - Bind sub-expressions to named lets before returning.

// osc_saw(phase01) -> float
// Rising sawtooth: output = 2.0*phase01 - 1.0.
// phase01 in [0.0, 1.0), output in [-1.0, 1.0).
fn osc_saw(phase01: float) -> float
    let scaled = 2.0 * phase01
    let result = scaled - 1.0
    result
