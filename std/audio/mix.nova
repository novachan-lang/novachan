// std/audio/mix.nova -- Audio mixing utilities. LEAF -- imports NOTHING.
//
// Public API (prefix mix_ / audio mixing)
//   mix_two(a, b, ratio)    -> float  Linear blend: a*(1-ratio) + b*ratio.
//   sum_gain(samples, gain) -> list   Scale every element of samples by gain.
//   average(samples)        -> float  Arithmetic mean of a float list.
//
// FLOAT RULES obeyed:
//   - List element reads are 'any'; multiply by 1.0 to force float.
//   - abs(float) returns int in NOVA; use if/else for float abs.
//   - Never return a bare multi-term float expr (uninit-slot bug); bind to let.
//   - float vs int compare is UNSOUND; use float literals (0.0) not ints.
//   - No scientific-notation literals.

// mix_two -- Linear interpolation between two float values.
// ratio=0.0 returns a exactly; ratio=1.0 returns b exactly.
// ratio in [0.0, 1.0] gives a convex blend; extrapolation is allowed but
// the caller is responsible for clamping if needed.
fn mix_two(a: float, b: float, ratio: float) -> float
    let one_minus = 1.0 - ratio
    let left  = a * one_minus
    let right = b * ratio
    let result = left + right
    result

// sum_gain -- Scale a list of float samples by a gain factor.
// Returns a NEW list; never mutates the input.
// Each output[i] = samples[i] * gain.
fn sum_gain(samples: list, gain: float) -> list
    let result = []
    let n = len(samples)
    for i in 0..n
        let v = samples[i] * 1.0
        let scaled = v * gain
        push(result, scaled)
    result

// average -- Arithmetic mean of a float list.
// Returns 0.0 for an empty list.
fn average(samples: list) -> float
    let n = len(samples)
    if n == 0
        let zero = 0.0
        return zero
    let s = 0.0
    for i in 0..n
        let v = samples[i] * 1.0
        s = s + v
    let nf = n * 1.0
    let mean = s / nf
    mean
