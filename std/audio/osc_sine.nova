// std/audio/osc_sine.nova — Sine wave oscillator.
// Prefix: osc_sine_
// Provides: osc_sine, freq_to_phase_inc
// LEAF — imports NOTHING.
//
// osc_sine(phase01) -> float
//   Computes sin(2*PI*phase01) where phase01 is in [0.0, 1.0).
//   Output is in [-1.0, 1.0].
//
// freq_to_phase_inc(freq, sample_rate) -> float
//   Returns the per-sample phase increment for a given frequency.
//   Add this to phase01 each sample; wrap to [0.0, 1.0) when >= 1.0.
//
// FLOAT RULES:
//   - All inputs/outputs are floats.
//   - Bind sub-expressions to named lets before returning.
//   - PI is provided as a zero-arg fn (no module-level const possible).

fn PI()
    let pi = 3.14159265358979
    pi

// osc_sine(phase01) -> float
// Returns sin(2*PI*phase01). phase01 in [0.0, 1.0).
fn osc_sine(phase01: float) -> float
    let two_pi = 2.0 * PI()
    let angle = two_pi * phase01
    let result = sin(angle)
    result

// freq_to_phase_inc(freq, sample_rate) -> float
// Returns the per-sample phase increment: freq / sample_rate.
// Caller adds this to phase01 each sample and wraps at 1.0.
fn freq_to_phase_inc(freq: float, sample_rate: float) -> float
    let inc = freq / sample_rate
    inc
