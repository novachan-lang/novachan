// std/tensor/tsr_concat.nova — concatenation and stacking of integer tensors.
// Tensor representation: t = [flat, shape] where flat is a flat list of ints
// in row-major (C) order and shape is a list of ints (dimension sizes).
// All arithmetic is exact integer arithmetic. LEAF — imports NOTHING.
//
// Supported: 1-D concat (axis 0), 2-D concat (axis 0 or 1), stack of 1-D or 2-D
// tensors into a higher-dimensional result, vstack and hstack for 2-D.
//
// API:
//   tx_concat(ta, tb, axis) -> tensor  join along an existing axis
//   tx_stack(ta, tb, axis)  -> tensor  stack along a NEW axis (inserts new dim)
//   tx_vstack(ta, tb)       -> tensor  vertical stack (concat axis 0) for 2-D
//   tx_hstack(ta, tb)       -> tensor  horizontal stack (concat axis 1) for 2-D

// Concatenate ta and tb along axis for 1-D (axis 0) or 2-D (axis 0 or 1).
// All other dims must match. Returns empty tensor on shape mismatch.
fn tx_concat(ta: list, tb: list, axis: int) -> list
    let fa = ta[0]
    let sha = ta[1]
    let fb = tb[0]
    let shb = tb[1]
    let nda = len(sha)
    let ndb = len(shb)
    if nda != ndb
        let ef = []
        let es = []
        let er = []
        push(er, ef)
        push(er, es)
        return er
    // 1-D case: only axis 0 makes sense — simple flat concat
    if nda == 1
        let out = []
        for i in 0..len(fa)
            push(out, fa[i])
        for j in 0..len(fb)
            push(out, fb[j])
        let rshape = []
        push(rshape, len(fa) + len(fb))
        let res = []
        push(res, out)
        push(res, rshape)
        return res
    // 2-D case
    let ra = sha[0]
    let ca = sha[1]
    let rb = shb[0]
    let cb = shb[1]
    if axis == 0
        // rows must have same number of columns
        if ca != cb
            let ef = []
            let es = []
            let er = []
            push(er, ef)
            push(er, es)
            return er
        let out = []
        for i in 0..len(fa)
            push(out, fa[i])
        for j in 0..len(fb)
            push(out, fb[j])
        let rshape = []
        push(rshape, ra + rb)
        push(rshape, ca)
        let res = []
        push(res, out)
        push(res, rshape)
        return res
    // axis == 1: same number of rows required
    if ra != rb
        let ef = []
        let es = []
        let er = []
        push(er, ef)
        push(er, es)
        return er
    let out = []
    for i in 0..ra
        let j = 0
        while j < ca
            push(out, fa[i * ca + j])
            j += 1
        let k = 0
        while k < cb
            push(out, fb[i * cb + k])
            k += 1
    let rshape = []
    push(rshape, ra)
    push(rshape, ca + cb)
    let res = []
    push(res, out)
    push(res, rshape)
    res

// Stack ta and tb along a NEW axis, inserting that dimension.
// axis=0: new shape = [2, ...ta.shape]; axis=-1 or last: new shape = [...ta.shape, 2].
// For 1-D tensors of shape [n]: axis=0 -> [2,n] (row-stack), axis=1 -> [n,2] (col-stack).
// Both tensors must have identical shapes.
fn tx_stack(ta: list, tb: list, axis: int) -> list
    let fa = ta[0]
    let sha = ta[1]
    let fb = tb[0]
    let shb = tb[1]
    let nda = len(sha)
    // Check shapes match
    if len(sha) != len(shb)
        let ef = []
        let es = []
        let er = []
        push(er, ef)
        push(er, es)
        return er
    let ok = 1
    for ci in 0..nda
        if sha[ci] != shb[ci]
            ok = 0
    if ok == 0
        let ef = []
        let es = []
        let er = []
        push(er, ef)
        push(er, es)
        return er
    // For 1-D tensors of shape [n]:
    if nda == 1
        let n = sha[0]
        if axis == 0
            // axis=0: result shape [2, n]; flat = [fa..., fb...]
            let out = []
            for i in 0..n
                push(out, fa[i])
            for j in 0..n
                push(out, fb[j])
            let rshape = []
            push(rshape, 2)
            push(rshape, n)
            let res = []
            push(res, out)
            push(res, rshape)
            return res
        // axis=1: result shape [n, 2]; interleave pairs
        let out = []
        for i in 0..n
            push(out, fa[i])
            push(out, fb[i])
        let rshape = []
        push(rshape, n)
        push(rshape, 2)
        let res = []
        push(res, out)
        push(res, rshape)
        return res
    // For 2-D tensors of shape [r, c]:
    if nda == 2
        let r = sha[0]
        let c = sha[1]
        if axis == 0
            // axis=0: result shape [2, r, c]; flat = [fa..., fb...]
            let out = []
            for i in 0..len(fa)
                push(out, fa[i])
            for j in 0..len(fb)
                push(out, fb[j])
            let rshape = []
            push(rshape, 2)
            push(rshape, r)
            push(rshape, c)
            let res = []
            push(res, out)
            push(res, rshape)
            return res
        if axis == 1
            // axis=1: result shape [r, 2, c]; interleave rows
            let out = []
            for i in 0..r
                let j = 0
                while j < c
                    push(out, fa[i * c + j])
                    j += 1
                let k = 0
                while k < c
                    push(out, fb[i * c + k])
                    k += 1
            let rshape = []
            push(rshape, r)
            push(rshape, 2)
            push(rshape, c)
            let res = []
            push(res, out)
            push(res, rshape)
            return res
        // axis=2: result shape [r, c, 2]; interleave elements
        let out = []
        let total = r * c
        for i in 0..total
            push(out, fa[i])
            push(out, fb[i])
        let rshape = []
        push(rshape, r)
        push(rshape, c)
        push(rshape, 2)
        let res = []
        push(res, out)
        push(res, rshape)
        return res
    // Fallback for unsupported ndim: concat flat and merge shapes
    let out = []
    for i in 0..len(fa)
        push(out, fa[i])
    for j in 0..len(fb)
        push(out, fb[j])
    let res = []
    push(res, out)
    push(res, sha)
    res

// Vertical stack: concat two 2-D tensors along axis 0 (rows).
// Column count must match.
fn tx_vstack(ta: list, tb: list) -> list
    tx_concat(ta, tb, 0)

// Horizontal stack: concat two 2-D tensors along axis 1 (columns).
// Row count must match.
fn tx_hstack(ta: list, tb: list) -> list
    tx_concat(ta, tb, 1)
