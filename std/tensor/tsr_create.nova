// ============================================================================
// NOVA Standard Library — std/tensor/tsr_create
// ============================================================================
// N-dimensional integer tensor construction and inspection.
//
// Tensor representation: [flat, shape]  where
//   flat  = flat list of ints in row-major (C) order
//   shape = list of dimension sizes  (empty list = scalar, one element = 1-D)
//
// All arithmetic is integer-exact. No floats anywhere.
//
// Public API (prefix tc_):
//   tc_zeros(shape)           -> tensor  all-zero tensor with given shape
//   tc_full(shape, v)         -> tensor  tensor filled with value v
//   tc_arange(n)              -> tensor  [0..n-1], shape [n]
//   tc_eye(n)                 -> tensor  n×n identity matrix
//   tc_from_nested(nested)    -> tensor  nested int lists -> tensor
//   tc_to_nested(t)           -> any     tensor -> nested int lists
//   tc_shape(t)               -> list    shape list of tensor t
//   tc_size(t)                -> int     product of shape (1 for scalar)
//   tc_ndim(t)                -> int     number of dimensions
//
// LEAF — imports nothing.
// ============================================================================

// _tc_shape_product returns the product of a shape list (1 if empty).
fn _tc_shape_product(shape) -> int
    let n = len(shape)
    let p = 1
    for i in 0..n
        p *= shape[i]
    p

// tc_zeros builds an all-zero tensor with the given shape.
fn tc_zeros(shape) -> any
    let sz = _tc_shape_product(shape)
    [[0 for i in 0..sz], shape]

// tc_full builds a tensor filled with value v with the given shape.
fn tc_full(shape, v) -> any
    let sz = _tc_shape_product(shape)
    [[v for i in 0..sz], shape]

// tc_arange builds a 1-D tensor with values 0..n-1, shape [n].
fn tc_arange(n) -> any
    [[i for i in 0..n], [n]]

// tc_eye builds an n×n identity tensor (1 on diagonal, 0 elsewhere).
fn tc_eye(n) -> any
    let sz = n * n
    let flat = [0 for i in 0..sz]
    for row in 0..n
        let idx = row * n + row
        flat[idx] = 1
    [flat, [n, n]]

// _tc_nested_depth returns the nesting depth of a list-of-lists.
// depth 1 = plain int list; depth 2 = list of int lists; etc.
fn _tc_nested_depth(nested) -> int
    if len(nested) == 0
        return 1
    let first = nested[0]
    if type_of(first) == "list"
        return 1 + _tc_nested_depth(first)
    1

// _tc_infer_shape returns the shape list inferred from the outermost dimensions.
fn _tc_infer_shape(nested) -> any
    let shape = []
    let cur = nested
    while type_of(cur) == "list"
        push(shape, len(cur))
        if len(cur) == 0
            return shape
        cur = cur[0]
    shape

// _tc_flatten_into appends all leaf integers from nested into flat.
fn _tc_flatten_into(nested, flat)
    if type_of(nested) == "list"
        let n = len(nested)
        for i in 0..n
            _tc_flatten_into(nested[i], flat)
    else
        push(flat, nested)

// tc_from_nested converts nested int lists to a tensor [flat, shape].
// Shape is inferred from the first elements at each level (rectangular only).
fn tc_from_nested(nested) -> any
    let shape = _tc_infer_shape(nested)
    let flat = []
    _tc_flatten_into(nested, flat)
    let result = []
    push(result, flat)
    push(result, shape)
    result

// _tc_rebuild rebuilds a nested list from flat data at a given shape level.
// offs = current offset into flat; returns [built_value, new_offset].
fn _tc_rebuild(flat, shape, depth, offs) -> any
    let ndim = len(shape)
    if depth == ndim
        // leaf: return the single element at offset
        return [flat[offs], offs + 1]
    // build a list of shape[depth] sub-structures
    let dim = shape[depth]
    let out = []
    let cur_offs = offs
    for i in 0..dim
        let sub = _tc_rebuild(flat, shape, depth + 1, cur_offs)
        push(out, sub[0])
        cur_offs = sub[1]
    [out, cur_offs]

// tc_to_nested converts a tensor back to nested int lists.
// A scalar (empty shape) returns the single integer value.
fn tc_to_nested(t) -> any
    let flat = t[0]
    let shape = t[1]
    let ndim = len(shape)
    if ndim == 0
        return flat[0]
    let res = _tc_rebuild(flat, shape, 0, 0)
    res[0]

// tc_shape returns the shape list of tensor t.
fn tc_shape(t) -> any
    t[1]

// tc_size returns the total number of elements (product of shape; 1 for scalar).
fn tc_size(t) -> int
    let shape = t[1]
    _tc_shape_product(shape)

// tc_ndim returns the number of dimensions (0 for scalar).
fn tc_ndim(t) -> int
    let shape = t[1]
    len(shape)

fn main()
    print("std/tensor/tsr_create loaded")
