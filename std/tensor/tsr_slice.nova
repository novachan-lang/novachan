// std/tensor/tsr_slice.nova — sub-tensor extraction for integer tensors.
// Tensor representation: [flat, shape] where flat is a flat int list in
// row-major (C) order and shape is a list of ints (dimension sizes).
// Examples: 2x3 matrix [[1,2,3],[4,5,6]] -> [[1,2,3,4,5,6],[2,3]].
//           scalar 7 -> [[7],[]]   1-D [1,2,3] -> [[1,2,3],[3]].
// LEAF — imports NOTHING. All arithmetic is exact integer.
//
// Public API (PREFIX ts_):
//   ts_slice(t, starts, stops) -> sub-tensor with per-axis half-open [start,stop)
//   ts_row(t, i)               -> 2-D: row i as a 1-D tensor
//   ts_col(t, j)               -> 2-D: column j as a 1-D tensor
//   ts_diagonal(t)             -> 2-D: main diagonal as 1-D tensor
//   ts_take(t, indices, axis)  -> gather rows along axis 0

// Private: compute row-major strides for a given shape list.
fn _ts_strides(shape: list) -> list
    let nd = len(shape)
    let strides = [1 for i in 0..nd]
    let k = nd - 2
    while k >= 0
        strides[k] = strides[k + 1] * shape[k + 1]
        k = k - 1
    strides

// Private: convert flat index to multi-dimensional index list for given shape.
fn _ts_unravel(flat_idx: int, shape: list) -> list
    let nd = len(shape)
    let idx = [0 for i in 0..nd]
    let rem = flat_idx
    let k = nd - 1
    while k >= 0
        idx[k] = rem % shape[k]
        rem = rem / shape[k]
        k = k - 1
    idx

// Private: convert multi-dimensional index list to flat index using strides.
fn _ts_ravel(idx: list, strides: list) -> int
    let nd = len(idx)
    let pos = 0
    let k = 0
    while k < nd
        pos = pos + idx[k] * strides[k]
        k = k + 1
    pos

// Private: compute product of a shape list (total element count).
fn _ts_size(shape: list) -> int
    let n = len(shape)
    if n == 0
        return 1
    let p = 1
    for i in 0..n
        p = p * shape[i]
    p

// ts_slice: extract a sub-tensor using per-axis half-open ranges [starts[k], stops[k]).
// starts and stops are plain int lists, one entry per dimension.
// For a 0-D tensor (scalar), returns the tensor unchanged.
// Clamps ranges to valid bounds. Returns a new [flat, shape] tensor.
fn ts_slice(t: list, starts: list, stops: list) -> list
    let flat = t[0]
    let shape = t[1]
    let nd = len(shape)
    if nd == 0
        let out_flat = []
        let out_shape = []
        push(out_flat, flat[0])
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    // Compute clamped output shape.
    let out_shape = []
    let k = 0
    while k < nd
        let s = starts[k]
        let e = stops[k]
        if s < 0
            s = 0
        if e > shape[k]
            e = shape[k]
        let dim = e - s
        if dim < 0
            dim = 0
        push(out_shape, dim)
        k = k + 1
    let strides = _ts_strides(shape)
    let out_size = _ts_size(out_shape)
    let out_flat = []
    let i = 0
    while i < out_size
        // Convert i to an index in the output, then offset by starts.
        let out_idx = _ts_unravel(i, out_shape)
        let in_pos = 0
        for j in 0..nd
            in_pos = in_pos + (starts[j] + out_idx[j]) * strides[j]
        push(out_flat, flat[in_pos])
        i = i + 1
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res

// ts_row: extract row i from a 2-D tensor as a 1-D tensor [flat, [cols]].
// If t has fewer than 2 dimensions or i is out of range, returns an empty 1-D tensor.
fn ts_row(t: list, i: int) -> list
    let flat = t[0]
    let shape = t[1]
    let nd = len(shape)
    let out_flat = []
    let out_shape = []
    if nd < 2
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    let rows = shape[0]
    let cols = shape[1]
    if i < 0 or i >= rows
        push(out_shape, 0)
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    let base = i * cols
    let j = 0
    while j < cols
        push(out_flat, flat[base + j])
        j = j + 1
    push(out_shape, cols)
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res

// ts_col: extract column j from a 2-D tensor as a 1-D tensor [flat, [rows]].
// If t has fewer than 2 dimensions or j is out of range, returns an empty 1-D tensor.
fn ts_col(t: list, j: int) -> list
    let flat = t[0]
    let shape = t[1]
    let nd = len(shape)
    let out_flat = []
    let out_shape = []
    if nd < 2
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    let rows = shape[0]
    let cols = shape[1]
    if j < 0 or j >= cols
        push(out_shape, 0)
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    for i in 0..rows
        push(out_flat, flat[i * cols + j])
    push(out_shape, rows)
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res

// ts_diagonal: extract the main diagonal of a 2-D tensor as a 1-D tensor.
// The diagonal length is min(rows, cols). Returns empty 1-D for non-2D input.
fn ts_diagonal(t: list) -> list
    let flat = t[0]
    let shape = t[1]
    let nd = len(shape)
    let out_flat = []
    let out_shape = []
    if nd < 2
        push(out_shape, 0)
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    let rows = shape[0]
    let cols = shape[1]
    let diag_len = rows
    if cols < diag_len
        diag_len = cols
    for i in 0..diag_len
        push(out_flat, flat[i * cols + i])
    push(out_shape, diag_len)
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res

// ts_take: gather rows along axis 0 by an index tensor [flat_indices, shape_of_indices].
// For a 2-D input of shape [R, C] and k indices, result shape is [k, C].
// axis parameter is accepted for API symmetry but only axis=0 is supported.
fn ts_take(t: list, indices: list, axis: int) -> list
    let flat = t[0]
    let shape = t[1]
    let idx_flat = indices[0]
    let idx_shape = indices[1]
    let nd = len(shape)
    let out_flat = []
    let out_shape = []
    if nd < 2
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    let rows = shape[0]
    let cols = shape[1]
    let k = len(idx_flat)
    for i in 0..k
        let row_idx = idx_flat[i]
        if row_idx < 0
            row_idx = 0
        if row_idx >= rows
            row_idx = rows - 1
        let base = row_idx * cols
        let j = 0
        while j < cols
            push(out_flat, flat[base + j])
            j = j + 1
    push(out_shape, k)
    push(out_shape, cols)
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res
