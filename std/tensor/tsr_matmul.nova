// std/tensor/tsr_matmul.nova — integer matrix multiplication operations.
// Tensor representation: t = [flat, shape] where flat is a flat list of ints
// in row-major (C) order and shape is a list of ints (dimension sizes).
// All arithmetic is exact integer arithmetic — no floats used.
// LEAF — imports NOTHING.
//
// API:
//   tm_matmul(a, b)  -> tensor  2-D x 2-D integer matmul; inner dims must match
//   tm_matvec(a, v)  -> tensor  matrix (2-D) times 1-D vector; result is 1-D tensor
//   tm_dot(u, v)     -> int     1-D dot product
//   tm_outer(u, v)   -> tensor  outer product of two 1-D tensors -> 2-D tensor
//   tm_trace(a)      -> int     sum of the main diagonal of a 2-D tensor

// 2-D x 2-D integer matrix multiplication.
// a has shape [m, k], b has shape [k, n]; result has shape [m, n].
// If inner dimensions mismatch, returns an empty tensor with shape [0, 0].
fn tm_matmul(a: list, b: list) -> list
    let af = a[0]
    let ashape = a[1]
    let bf = b[0]
    let bshape = b[1]
    let m = ashape[0]
    let k = ashape[1]
    let k2 = bshape[0]
    let n = bshape[1]
    if k != k2
        let ef = []
        let es = []
        push(es, 0)
        push(es, 0)
        let er = []
        push(er, ef)
        push(er, es)
        return er
    let out = []
    for i in 0..m
        let j = 0
        while j < n
            let s = 0
            let p = 0
            while p < k
                s = s + af[i * k + p] * bf[p * n + j]
                p = p + 1
            push(out, s)
            j = j + 1
    let rshape = []
    push(rshape, m)
    push(rshape, n)
    let res = []
    push(res, out)
    push(res, rshape)
    res

// Matrix (2-D, shape [m,k]) times 1-D vector (shape [k]).
// Returns a 1-D tensor of shape [m].
// If dimensions mismatch, returns empty tensor with shape [0].
fn tm_matvec(a: list, v: list) -> list
    let af = a[0]
    let ashape = a[1]
    let vf = v[0]
    let m = ashape[0]
    let k = ashape[1]
    let kv = len(vf)
    if k != kv
        let ef = []
        let es = []
        push(es, 0)
        let er = []
        push(er, ef)
        push(er, es)
        return er
    let out = []
    for i in 0..m
        let s = 0
        let p = 0
        while p < k
            s = s + af[i * k + p] * vf[p]
            p = p + 1
        push(out, s)
    let rshape = []
    push(rshape, m)
    let res = []
    push(res, out)
    push(res, rshape)
    res

// Dot product of two 1-D tensors; returns an int.
// Mismatched lengths: sums over min(len(u),len(v)).
fn tm_dot(u: list, v: list) -> int
    let uf = u[0]
    let vf = v[0]
    let n = len(uf)
    let nv = len(vf)
    if nv < n
        n = nv
    let s = 0
    let i = 0
    while i < n
        s = s + uf[i] * vf[i]
        i = i + 1
    s

// Outer product of two 1-D tensors u (shape [m]) and v (shape [n]).
// Returns a 2-D tensor of shape [m, n] where result[i][j] = u[i]*v[j].
fn tm_outer(u: list, v: list) -> list
    let uf = u[0]
    let vf = v[0]
    let m = len(uf)
    let n = len(vf)
    let out = []
    for i in 0..m
        let j = 0
        while j < n
            push(out, uf[i] * vf[j])
            j = j + 1
    let rshape = []
    push(rshape, m)
    push(rshape, n)
    let res = []
    push(res, out)
    push(res, rshape)
    res

// Sum of the main diagonal of a 2-D tensor (shape [n,n]).
// For non-square, sums min(nrows, ncols) diagonal elements.
fn tm_trace(a: list) -> int
    let af = a[0]
    let ashape = a[1]
    let nrows = ashape[0]
    let ncols = ashape[1]
    let d = nrows
    if ncols < d
        d = ncols
    let s = 0
    for i in 0..d
        s = s + af[i * ncols + i]
    s
