// std/tensor/tsr_convolve.nova — 1-D/2-D convolution and cumulative operations.
// Tensor representation: [flat, shape] where flat is a flat int list in
// row-major (C) order and shape is a list of ints (dimension sizes).
// All operations use VALID padding (no output beyond input boundary).
// All arithmetic is exact integer — no floats.
// LEAF — imports NOTHING.
//
// Public API (PREFIX tv_):
//   tv_correlate1d(sig, ker)   -> VALID cross-correlation (no kernel flip)
//   tv_convolve1d(sig, ker)    -> VALID convolution (kernel reversed)
//   tv_cumsum(t)               -> 1-D running prefix sum
//   tv_diff(t)                 -> 1-D consecutive differences (length n-1)
//   tv_conv2d_valid(img, ker)  -> 2-D VALID cross-correlation

// tv_correlate1d: VALID cross-correlation of 1-D signal with 1-D kernel (no flip).
// Output length = len(sig) - len(ker) + 1. Returns empty tensor if kernel > signal.
// out[i] = sum_{k=0}^{K-1} sig[i+k] * ker[k]
fn tv_correlate1d(sig: list, ker: list) -> list
    let sig_flat = sig[0]
    let ker_flat = ker[0]
    let n = len(sig_flat)
    let m = len(ker_flat)
    let out_flat = []
    let out_shape = []
    if m > n
        push(out_shape, 0)
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    let out_len = n - m + 1
    let i = 0
    while i < out_len
        let acc = 0
        let k = 0
        while k < m
            acc += sig_flat[i + k] * ker_flat[k]
            k += 1
        push(out_flat, acc)
        i += 1
    push(out_shape, out_len)
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res

// tv_convolve1d: VALID convolution of 1-D signal with 1-D kernel (kernel reversed).
// out[i] = sum_{k=0}^{K-1} sig[i+k] * ker[K-1-k]
fn tv_convolve1d(sig: list, ker: list) -> list
    let sig_flat = sig[0]
    let ker_flat = ker[0]
    let n = len(sig_flat)
    let m = len(ker_flat)
    let out_flat = []
    let out_shape = []
    if m > n
        push(out_shape, 0)
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    let out_len = n - m + 1
    let i = 0
    while i < out_len
        let acc = 0
        let k = 0
        while k < m
            acc += sig_flat[i + k] * ker_flat[m - 1 - k]
            k += 1
        push(out_flat, acc)
        i += 1
    push(out_shape, out_len)
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res

// tv_cumsum: compute the prefix (running) sum of a 1-D tensor.
// out[i] = sum_{k=0}^{i} t[k]. Output has the same length as input.
// For non-1D tensors, operates on the flat data as if 1-D.
fn tv_cumsum(t: list) -> list
    let flat = t[0]
    let shape = t[1]
    let n = len(flat)
    let out_flat = []
    let acc = 0
    let i = 0
    while i < n
        acc += flat[i]
        push(out_flat, acc)
        i += 1
    let out_shape = []
    for k in 0..len(shape)
        push(out_shape, shape[k])
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res

// tv_diff: compute consecutive differences of a 1-D tensor.
// out[i] = t[i+1] - t[i]. Output length is len(t) - 1.
// Returns empty 1-D tensor if input has 0 or 1 elements.
fn tv_diff(t: list) -> list
    let flat = t[0]
    let n = len(flat)
    let out_flat = []
    let out_shape = []
    if n <= 1
        push(out_shape, 0)
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    for i in 0..(n - 1)
        push(out_flat, flat[i + 1] - flat[i])
    push(out_shape, n - 1)
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res

// tv_conv2d_valid: VALID 2-D cross-correlation of img with ker (no kernel flip).
// img shape [H, W], ker shape [KH, KW].
// Output shape [(H - KH + 1), (W - KW + 1)].
// out[r,c] = sum_{kr,kc} img[r+kr, c+kc] * ker[kr, kc]
// Returns empty tensor if kernel is larger than image in any dimension.
fn tv_conv2d_valid(img: list, ker: list) -> list
    let img_flat = img[0]
    let img_shape = img[1]
    let ker_flat = ker[0]
    let ker_shape = ker[1]
    let out_flat = []
    let out_shape = []
    if len(img_shape) < 2 or len(ker_shape) < 2
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    let H = img_shape[0]
    let W = img_shape[1]
    let KH = ker_shape[0]
    let KW = ker_shape[1]
    let OH = H - KH + 1
    let OW = W - KW + 1
    if OH <= 0 or OW <= 0
        push(out_shape, 0)
        push(out_shape, 0)
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    for r in 0..OH
        let c = 0
        while c < OW
            let acc = 0
            let kr = 0
            while kr < KH
                let kc = 0
                while kc < KW
                    let img_val = img_flat[(r + kr) * W + (c + kc)]
                    let ker_val = ker_flat[kr * KW + kc]
                    acc += img_val * ker_val
                    kc += 1
                kr += 1
            push(out_flat, acc)
            c += 1
    push(out_shape, OH)
    push(out_shape, OW)
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res
