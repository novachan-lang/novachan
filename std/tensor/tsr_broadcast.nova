// std/tensor/tsr_broadcast.nova — Numpy-style right-aligned broadcasting for integer tensors.
//
// Tensor representation: [flat, shape] where flat is a row-major flat int list and
// shape is a list of ints (dimension sizes).
//
// Broadcasting rules (numpy / right-aligned):
//   1. Align shapes on the right, padding missing leading dims with 1.
//   2. For each dim pair: equal -> keep; one is 1 -> use the other; else incompatible.
//   3. Incompatible is signalled by returning [] (empty list) as the result shape.
//
// All public functions prefixed tb_.
//
// Public API:
//   tb_broadcast_shapes(sa, sb) -> shape  result shape, or [] on incompatibility
//   tb_broadcastable(sa, sb)    -> bool   true iff shapes are broadcast-compatible
//   tb_broadcast_to(t, shape)   -> tensor replicate t to the target shape
//   tb_add_bc(a, b)             -> tensor elementwise add with broadcasting

// _tb_prod — product of all ints in a list; 1 for empty.
fn _tb_prod(s: any) -> int
    let n = len(s)
    let p = 1
    for i in 0..n
        p = p * s[i]
    p

// _tb_strides — row-major strides for a shape; stride[k] = product(shape[k+1..]).
fn _tb_strides(shape: any) -> any
    let nd = len(shape)
    let st = [0 for i in 0..nd]
    let acc = 1
    let k = nd - 1
    while k >= 0
        st[k] = acc
        acc = acc * shape[k]
        k -= 1
    st

// _tb_max — max of two ints.
fn _tb_max(a: int, b: int) -> int
    if a > b
        return a
    b

// tb_broadcast_shapes — compute the broadcast result shape using numpy right-align rules.
// Returns [] (empty list) when the shapes are incompatible.
fn tb_broadcast_shapes(sa: any, sb: any) -> any
    let na = len(sa)
    let nb = len(sb)
    let nr = na
    if nb > nr
        nr = nb
    let result = [0 for i in 0..nr]
    for k in 0..nr
        let ia = nr - 1 - k
        let pa = na - 1 - k
        let pb = nb - 1 - k
        let da = 1
        if pa >= 0
            da = sa[pa]
        let db = 1
        if pb >= 0
            db = sb[pb]
        if da == db
            result[ia] = da
        else
            if da == 1
                result[ia] = db
            else
                if db == 1
                    result[ia] = da
                else
                    return []
    result

// tb_broadcastable — true iff sa and sb are broadcast-compatible.
fn tb_broadcastable(sa: any, sb: any) -> bool
    let r = tb_broadcast_shapes(sa, sb)
    len(r) > 0

// _tb_bc_strides — compute the "virtual" broadcasting strides for a source shape
// expanded to ndims dimensions (right-aligned, missing leading dims treated as size-1,
// size-1 dims have stride 0 in the output — they repeat along that axis).
fn _tb_bc_strides(src_shape: any, ndims: int) -> any
    let ns = len(src_shape)
    let src_strides = _tb_strides(src_shape)
    let bc_st = [0 for i in 0..ndims]
    for k in 0..ndims
        let pos_in_dst = ndims - 1 - k
        let pos_in_src = ns - 1 - k
        if pos_in_src >= 0
            if src_shape[pos_in_src] == 1
                bc_st[pos_in_dst] = 0
            else
                bc_st[pos_in_dst] = src_strides[pos_in_src]
        else
            bc_st[pos_in_dst] = 0
    bc_st

// _tb_unravel — convert flat offset to multi-index for a given shape.
fn _tb_unravel(off: int, shape: any) -> any
    let nd = len(shape)
    let idx = [0 for i in 0..nd]
    let rem = off
    let k = nd - 1
    while k >= 0
        idx[k] = rem - (rem / shape[k]) * shape[k]
        rem = rem / shape[k]
        k -= 1
    idx

// tb_broadcast_to — replicate tensor t to a larger compatible shape.
// Returns t unchanged if the target shape is not compatible with t's shape.
fn tb_broadcast_to(t: any, shape: any) -> any
    let flat = t[0]
    let src_shape = t[1]
    let nd = len(shape)
    let size = _tb_prod(shape)
    let bc_st = _tb_bc_strides(src_shape, nd)
    let out = []
    for i in 0..size
        push(out, 0)
    let dst_strides = _tb_strides(shape)
    for dst_off in 0..size
        let idx = _tb_unravel(dst_off, shape)
        let src_off = 0
        for k in 0..nd
            src_off += idx[k] * bc_st[k]
        out[dst_off] = flat[src_off]
    [out, shape]

// tb_add_bc — elementwise addition with numpy-style broadcasting.
// Returns a zero tensor with the broadcast shape on incompatibility.
fn tb_add_bc(a: any, b: any) -> any
    let fa = a[0]
    let sa = a[1]
    let fb = b[0]
    let sb = b[1]
    let rshape = tb_broadcast_shapes(sa, sb)
    if len(rshape) == 0
        return [[], []]
    let ta2 = tb_broadcast_to(a, rshape)
    let tb2 = tb_broadcast_to(b, rshape)
    let ofa = ta2[0]
    let ofb = tb2[0]
    let size = len(ofa)
    let out = [ofa[i] + ofb[i] for i in 0..size]
    [out, rshape]
