// std/tensor/tsr_transpose.nova — Axis permutation and transposition for integer tensors.
//
// Tensor representation: [flat, shape] where flat is a row-major flat int list and
// shape is a list of ints (dimension sizes). size = product(shape). ndim = len(shape).
// Row-major strides: stride[k] = product of shape[k+1..].
//
// All public functions prefixed tt_.
//
// Public API:
//   tt_transpose(t)           -> tensor  reverse all axes (2-D: matrix transpose)
//   tt_permute(t, axes)       -> tensor  general axis permutation
//   tt_swapaxes(t, a, b)      -> tensor  swap two axes
//   tt_is_symmetric(t)        -> bool    2-D square: t == its transpose

// _tt_prod — product of all elements of a list; returns 1 for empty list.
fn _tt_prod(s: any) -> int
    let n = len(s)
    let p = 1
    for i in 0..n
        p = p * s[i]
    p

// _tt_strides — compute row-major strides for a shape list.
fn _tt_strides(shape: any) -> any
    let nd = len(shape)
    let st = [0 for i in 0..nd]
    let k = nd - 1
    let acc = 1
    while k >= 0
        st[k] = acc
        acc = acc * shape[k]
        k -= 1
    st

// _tt_ravel — convert a multi-index list to a flat offset using given strides.
fn _tt_ravel(idx: any, strides: any) -> int
    let nd = len(idx)
    let off = 0
    for i in 0..nd
        off += idx[i] * strides[i]
    off

// _tt_unravel — convert a flat offset to a multi-index given shape.
fn _tt_unravel(off: int, shape: any) -> any
    let nd = len(shape)
    let idx = [0 for i in 0..nd]
    let rem = off
    let k = nd - 1
    while k >= 0
        idx[k] = rem - (rem / shape[k]) * shape[k]
        rem = rem / shape[k]
        k -= 1
    idx

// _tt_reversed — return a new list with elements in reverse order.
fn _tt_reversed(s: any) -> any
    let n = len(s)
    let r = []
    let i = n - 1
    while i >= 0
        push(r, s[i])
        i -= 1
    r

// tt_transpose — reverse all axes; for 2-D this is the matrix transpose.
// 1-D and scalar tensors are returned unchanged.
fn tt_transpose(t: any) -> any
    let flat = t[0]
    let shape = t[1]
    let nd = len(shape)
    if nd < 2
        let out_flat = []
        for i in 0..len(flat)
            push(out_flat, flat[i])
        return [out_flat, shape]
    let new_shape = _tt_reversed(shape)
    let size = _tt_prod(shape)
    let src_strides = _tt_strides(shape)
    let dst_strides = _tt_strides(new_shape)
    let out_flat = []
    for i in 0..size
        push(out_flat, 0)
    for src_off in 0..size
        let idx = _tt_unravel(src_off, shape)
        let rev_idx = _tt_reversed(idx)
        let dst_off = _tt_ravel(rev_idx, dst_strides)
        out_flat[dst_off] = flat[src_off]
    [out_flat, new_shape]

// tt_permute — permute axes according to the given permutation list.
// axes must be a permutation of 0..ndim-1; returns t unchanged on mismatch.
fn tt_permute(t: any, axes: any) -> any
    let flat = t[0]
    let shape = t[1]
    let nd = len(shape)
    if nd != len(axes)
        return t
    let new_shape = [shape[axes[i]] for i in 0..nd]
    let size = _tt_prod(shape)
    let src_strides = _tt_strides(shape)
    let dst_strides = _tt_strides(new_shape)
    let out_flat = [0 for k in 0..size]
    for src_off in 0..size
        let idx = _tt_unravel(src_off, shape)
        let new_idx = []
        for j in 0..nd
            push(new_idx, idx[axes[j]])
        let dst_off = _tt_ravel(new_idx, dst_strides)
        out_flat[dst_off] = flat[src_off]
    [out_flat, new_shape]

// tt_swapaxes — swap axes a and b, leaving all other axes unchanged.
fn tt_swapaxes(t: any, a: int, b: int) -> any
    let shape = t[1]
    let nd = len(shape)
    if a < 0 or a >= nd or b < 0 or b >= nd
        return t
    let axes = []
    for i in 0..nd
        if i == a
            push(axes, b)
        else
            if i == b
                push(axes, a)
            else
                push(axes, i)
    tt_permute(t, axes)

// tt_is_symmetric — true iff t is a 2-D square tensor equal to its own transpose.
fn tt_is_symmetric(t: any) -> bool
    let flat = t[0]
    let shape = t[1]
    let nd = len(shape)
    if nd != 2
        return false
    let r = shape[0]
    let c = shape[1]
    if r != c
        return false
    for i in 0..r
        for j in 0..c
            let aij = flat[i * c + j]
            let aji = flat[j * c + i]
            if aij != aji
                return false
    true
