// std/concurrency/barrier — data-only synchronization barrier for N parties
//
// WHAT:
//   A barrier lets a caller-supplied count of parties rendezvous: each party
//   calls br_arrive when it reaches the sync point; once `count` arrivals
//   have been recorded the barrier is complete. Unlike std/sync/barrier
//   (bar_wait), this module is a PLAIN DATA tracker — it does not block or
//   park the caller and has no dependency on the concurrency runtime
//   (mutex/spawn). Callers who need actual blocking rendezvous should use
//   std/sync/barrier; this module is for cases where the caller drives its
//   own polling/scheduling loop (e.g. a single-threaded coordinator that
//   tracks N async callbacks) and just needs correct arrival bookkeeping.
//
// NOVA WAY:
//   A dict is used (not a struct) purely for reference semantics — the same
//   handle mutates across every call, matching the pattern used throughout
//   std/queue and std/config (see std/queue/priority.nova, std/config/layered.nova).
//   No struct field collision risk applies since dict keys are resolved by
//   string key, not by the struct-field-by-name compiler defect.
//
// Representation: {"br_total": int, "br_arrived": int, "br_done": int(bool)}
//
// Public API:
//   br_new(count)      -> dict   New barrier for `count` parties (count < 1
//                                is clamped to 1 — a 1-party barrier trivially
//                                completes on its first arrival).
//   br_arrive(barrier) -> int    Record one arrival (capped at total — extra
//                                arrivals past total are no-ops); returns the
//                                arrived count AFTER this call.
//   br_is_complete(b)  -> int    1 if all parties have arrived, else 0.
//   br_reset(barrier)            Clear arrived count back to 0 (cyclic reuse).
//   br_count(barrier)  -> int    The total party count this barrier waits for.
//   br_arrived(barrier)-> int    The current arrived count.
//
// LEAF — imports nothing.
// ============================================================================

// br_new: create a barrier that completes once `count` parties have arrived.
fn br_new(count) -> dict
    let b = {}
    let total = count
    if total < 1
        total = 1
    b["br_total"] = total
    b["br_arrived"] = 0
    b["br_done"] = 0
    return b

// br_arrive: record one party's arrival. Arrivals beyond the total are
// ignored (the count never exceeds br_total). Returns the arrived count
// after this call.
fn br_arrive(barrier) -> int
    let total = barrier["br_total"]
    let arrived = barrier["br_arrived"]
    if arrived < total
        arrived = arrived + 1
        barrier["br_arrived"] = arrived
    if arrived >= total
        barrier["br_done"] = 1
    return arrived

// br_is_complete: 1 if every party has arrived, else 0.
fn br_is_complete(barrier) -> int
    return barrier["br_done"]

// br_reset: reuse the same barrier for another round — arrived count and
// completion flag both go back to 0. The total party count is unchanged.
fn br_reset(barrier)
    barrier["br_arrived"] = 0
    barrier["br_done"] = 0

// br_count: the total number of parties this barrier waits for.
fn br_count(barrier) -> int
    return barrier["br_total"]

// br_arrived: the number of parties that have arrived so far.
fn br_arrived(barrier) -> int
    return barrier["br_arrived"]

fn main()
    print("concurrency barrier module loaded")
