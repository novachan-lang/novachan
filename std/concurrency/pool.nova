// std/concurrency/pool — bounded FIFO task/work queue (data-only)
//
// WHAT:
//   A simple task pool: producers submit arbitrary task payloads, a single
//   consumer loop pulls them off in FIFO order via tp_next. This is the
//   non-blocking sibling of std/sync/work_queue (wq_take there BLOCKS,
//   parking the calling green task/carrier via a mutex + poll loop). This
//   module never blocks and has no runtime dependency — tp_next returns
//   immediately, with 0 as the empty-queue sentinel (same convention as
//   std/queue/priority.nova's pq_pop). Use this when the caller already
//   drives its own scheduling loop and just needs bookkeeping + a capacity
//   cap; use std/sync/work_queue when you need a worker to actually block
//   until work appears.
//
// NOVA WAY:
//   Backed by a plain NOVA `list` inside a dict handle (reference semantics).
//   tp_next takes index 0 then re-slices the remainder via the RC-safe
//   `list_slice` builtin (never the raw `deque_*` primitive — deque stores
//   opaque machine words with no reference-counting integration, which is
//   unsound for arbitrary NOVA values; see std/sync/work_queue's header for
//   the full argument). The O(n) re-slice per take is the accepted cost for
//   RC safety across any task_data type.
//
// Representation: {"tp_queue": list, "tp_max": int}
//   tp_max <= 0 means UNBOUNDED (tp_is_full always returns 0, tp_submit
//   never rejects for capacity reasons). This mirrors channel-buffer-size-0
//   idioms elsewhere in NOVA's concurrency vocabulary meaning "no cap".
//
// Public API:
//   tp_new(max_size)          -> dict   New pool. max_size <= 0 = unbounded.
//   tp_submit(pool, task_data)-> int    1 if accepted, 0 if rejected (full).
//   tp_next(pool)              -> any    Pop the head task, FIFO. Returns 0
//                                        if the pool is empty (sentinel —
//                                        callers should check tp_size/
//                                        tp_is_full first if 0 is a valid
//                                        real payload for their use case).
//   tp_size(pool)              -> int    Number of tasks currently queued.
//   tp_is_full(pool)           -> int    1 if at capacity, else 0 (always 0
//                                        for an unbounded pool).
//   tp_clear(pool)                       Discard all queued tasks.
//
// LEAF — imports nothing.
// ============================================================================

// tp_new: create an empty task pool. max_size <= 0 means unbounded capacity.
fn tp_new(max_size) -> dict
    let p = {}
    p["tp_queue"] = []
    p["tp_max"] = max_size
    return p

// tp_is_full: 1 if the pool has reached its capacity, else 0. An unbounded
// pool (tp_max <= 0) is never full.
fn tp_is_full(pool) -> int
    let cap = pool["tp_max"]
    if cap <= 0
        return 0
    let q = pool["tp_queue"]
    if len(q) >= cap
        return 1
    return 0

// tp_submit: append task_data to the tail of the queue if there is room.
// Returns 1 if accepted, 0 if the pool is full (task_data is dropped).
fn tp_submit(pool, task_data) -> int
    if tp_is_full(pool) == 1
        return 0
    let q = pool["tp_queue"]
    q.push(task_data)
    return 1

// tp_next: remove and return the head task (FIFO). Returns 0 (sentinel) if
// the pool is currently empty — NOVA has no null, so callers that submit a
// literal 0 as a real task payload must check tp_size(pool) > 0 first.
fn tp_next(pool)
    let q = pool["tp_queue"]
    let n = len(q)
    if n == 0
        return 0
    let item = q[0]
    pool["tp_queue"] = list_slice(q, 1, n)
    return item

// tp_size: number of tasks currently queued.
fn tp_size(pool) -> int
    return len(pool["tp_queue"])

// tp_clear: discard every queued task, leaving the pool empty.
fn tp_clear(pool)
    pool["tp_queue"] = []

fn main()
    print("concurrency pool module loaded")
