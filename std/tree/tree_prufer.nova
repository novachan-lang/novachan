// std/tree/tree_prufer.nova — Prufer sequence encode/decode for labeled trees.
//
// Tree representation: adj[i] = list of integer neighbors of node i (undirected, 0..n-1).
// n = number of nodes. No imports required.
//
// Prufer encoding: repeatedly remove the smallest-id leaf and record its unique neighbor.
//   Repeat n-2 times. The resulting sequence has length n-2.
//   n=2 yields the empty sequence [].
//
// Prufer decoding: from a sequence of length n-2, reconstruct the adjacency list.
//   degree[i] = occurrences in sequence + 1.
//   For each element s in sequence: find smallest j with degree[j]=1; add edge (j,s);
//   decrement degree[j] and degree[s].  After the loop, connect the last two nodes with degree>0.
//
// Public API:
//   tp_encode(adj, n)      -> list   Prufer sequence (length n-2; [] for n<=2)
//   tp_decode(prufer, n)   -> list   adjacency list reconstructed from the Prufer sequence
//
// Private prefix: _tp_

// _tp_fill: build a list of n integers all set to val.
fn _tp_fill(n, val) -> list
    let lst = []
    let i = 0
    while i < n
        push(lst, val)
        i = i + 1
    return lst

// _tp_build_degree: compute degree[i] = number of neighbors of i.
fn _tp_build_degree(adj, n) -> list
    let deg = _tp_fill(n, 0)
    let i = 0
    while i < n
        deg[i] = len(adj[i])
        i = i + 1
    return deg

// tp_encode: returns the Prufer sequence of the tree given as adjacency list adj with n nodes.
// For n <= 2 the sequence is empty.
fn tp_encode(adj, n) -> list
    let seq = []
    if n <= 2
        return seq
    // Copy degree array (we will decrement it as we remove leaves)
    let deg = _tp_build_degree(adj, n)
    // removed[i] = 1 if node i has been removed from the tree
    let removed = _tp_fill(n, 0)
    // We iterate n-2 times
    let steps = n - 2
    let s = 0
    while s < steps
        // Find the smallest-id leaf (degree == 1 and not removed)
        let leaf = -1
        let k = 0
        while k < n
            if removed[k] == 0 and deg[k] == 1 and leaf == -1
                leaf = k
            k = k + 1
        // Find the unique neighbor of leaf (not removed)
        let nbrs = adj[leaf]
        let nb = -1
        let j = 0
        while j < len(nbrs)
            let v = nbrs[j]
            if removed[v] == 0 and nb == -1
                nb = v
            j = j + 1
        push(seq, nb)
        // Remove leaf
        removed[leaf] = 1
        deg[nb] = deg[nb] - 1
        s = s + 1
    return seq

// _tp_add_edge: add an undirected edge (u, v) to adjacency list adj.
fn _tp_add_edge(adj, u, v)
    push(adj[u], v)
    push(adj[v], u)

// tp_decode: reconstructs the undirected adjacency list from a Prufer sequence and node count n.
// Returns adj where adj[i] = list of neighbors of node i.
fn tp_decode(prufer, n) -> list
    // Build adjacency list as list of n empty lists
    let adj = []
    let i = 0
    while i < n
        let row = []
        push(adj, row)
        i = i + 1
    if n == 1
        return adj
    if n == 2
        _tp_add_edge(adj, 0, 1)
        return adj
    // degree[i] = occurrences in prufer + 1
    let deg = _tp_fill(n, 1)
    let si = 0
    while si < len(prufer)
        let v = prufer[si]
        deg[v] = deg[v] + 1
        si = si + 1
    // Process each element in the prufer sequence
    let pi = 0
    while pi < len(prufer)
        let s = prufer[pi]
        // Find the smallest j with degree 1
        let leaf = -1
        let k = 0
        while k < n
            if deg[k] == 1 and leaf == -1
                leaf = k
            k = k + 1
        _tp_add_edge(adj, leaf, s)
        deg[leaf] = deg[leaf] - 1
        deg[s] = deg[s] - 1
        pi = pi + 1
    // Connect the last two nodes with degree > 0
    let last_a = -1
    let last_b = -1
    let m = 0
    while m < n
        if deg[m] > 0
            if last_a == -1
                last_a = m
            else
                if last_b == -1
                    last_b = m
        m = m + 1
    _tp_add_edge(adj, last_a, last_b)
    return adj
