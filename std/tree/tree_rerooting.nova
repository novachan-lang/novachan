// std/tree/tree_rerooting.nova — Rerooting DP on unrooted trees.
//
// Tree representation: adj is a list of lists (undirected adjacency list).
//   adj[i] = list of neighbor node ids for node i.
//   n = number of nodes (ids 0..n-1). Tree has exactly n-1 edges and is connected.
//
// Public API:
//   tr_sum_distances(adj, n) -> list   for each node, sum of distances to all other nodes
//   tr_max_distance(adj, n)  -> list   for each node, distance to the farthest node (eccentricity)

// _tr_bfs_order(adj, n) -- BFS from node 0; returns [order, parent] for rerooting passes.
fn _tr_bfs_order(adj, n)
    let order = []
    let parent = [-1 for i in 0..n]
    let visited = [0 for j in 0..n]
    push(order, 0)
    visited[0] = 1
    let head = 0
    while head < len(order)
        let u = order[head]
        head += 1
        let nbrs = adj[u]
        for k in 0..len(nbrs)
            let v = nbrs[k]
            if visited[v] == 0
                visited[v] = 1
                parent[v] = u
                push(order, v)
    return [order, parent]

// tr_sum_distances(adj, n) -- sum of distances from each node to every other node.
// Uses rerooting DP in O(n): one bottom-up pass (subtree sizes + down-sums),
// one top-down pass (reroot from parent to child: f[v] = f[u] - sz[v] + (n - sz[v])).
fn tr_sum_distances(adj, n)
    if n == 1
        let res = []
        push(res, 0)
        return res
    let bp = _tr_bfs_order(adj, n)
    let order = bp[0]
    let parent = bp[1]
    // sz[v] = number of nodes in subtree rooted at v (with 0 as root)
    let sz = []
    // down[v] = sum of distances from v to all nodes in its subtree
    let down = []
    for i in 0..n
        push(sz, 1)
        push(down, 0)
    // bottom-up: process order in reverse
    let oi = n - 1
    while oi >= 1
        let v = order[oi]
        let p = parent[v]
        sz[p] = sz[p] + sz[v]
        down[p] = down[p] + down[v] + sz[v]
        oi -= 1
    // ans[v] = sum of distances from v to all other nodes
    let ans = []
    for j in 0..n
        push(ans, 0)
    ans[0] = down[0]
    // top-down: reroot from parent to child
    for oi2 in 1..n
        let v = order[oi2]
        let p = parent[v]
        // When rerooting from p to v:
        //   nodes in v's subtree get 1 closer, (n - sz[v]) nodes outside get 1 farther
        ans[v] = ans[p] - sz[v] + (n - sz[v])
    return ans

// _tr_max_bfs(adj, n, src) -- BFS from src; returns distance array.
fn _tr_max_bfs(adj, n, src)
    let dist = [-1 for i in 0..n]
    dist[src] = 0
    let queue = []
    push(queue, src)
    let head = 0
    while head < len(queue)
        let u = queue[head]
        head += 1
        let nbrs = adj[u]
        for k in 0..len(nbrs)
            let v = nbrs[k]
            if dist[v] == -1
                dist[v] = dist[u] + 1
                push(queue, v)
    return dist

// tr_max_distance(adj, n) -- eccentricity of each node: distance to the farthest node.
// Uses rerooting DP with top-2 tracking in O(n).
// For each node we track the two longest downward branches (by depth from that node),
// so when rerooting from parent to child we can correctly pick the farthest node
// even if it lives in the child's own subtree.
fn tr_max_distance(adj, n)
    if n == 1
        let res = []
        push(res, 0)
        return res
    let bp = _tr_bfs_order(adj, n)
    let order = bp[0]
    let parent = bp[1]
    // mx1[v] = longest path going DOWN from v (into v's subtree); 0 if leaf.
    // mx2[v] = second-longest path going DOWN from v (different child).
    // mx1ch[v] = the child of v that achieves mx1[v] (-1 if none).
    let mx1 = []
    let mx2 = []
    let mx1ch = []
    for i in 0..n
        push(mx1, 0)
        push(mx2, 0)
        push(mx1ch, -1)
    // bottom-up: for each node, collect the top-2 downward depths from children.
    let oi = n - 1
    while oi >= 1
        let v = order[oi]
        let p = parent[v]
        let cand = mx1[v] + 1
        if cand > mx1[p]
            mx2[p] = mx1[p]
            mx1[p] = cand
            mx1ch[p] = v
        if cand <= mx1[p] and cand > mx2[p]
            if v != mx1ch[p]
                mx2[p] = cand
        oi -= 1
    // up[v] = the farthest distance reachable going UP through v's parent.
    let up = [0 for j in 0..n]
    // top-down: propagate upward distances from parent to child.
    for oi2 in 1..n
        let v = order[oi2]
        let p = parent[v]
        // The farthest from p going upward or through a sibling of v:
        //   up[p] + 1 (going further up from p)
        //   or (sibling branch from p): if v is the best child of p, use mx2[p]+1, else mx1[p]+1
        let from_up = up[p] + 1
        let from_sib = 0
        if mx1ch[p] == v
            from_sib = mx2[p] + 1
        if mx1ch[p] != v
            from_sib = mx1[p] + 1
        if from_up > from_sib
            up[v] = from_up
        if from_sib >= from_up
            up[v] = from_sib
    // eccentricity[v] = max(mx1[v], up[v])
    let ans = []
    for k in 0..n
        let e = mx1[k]
        if up[k] > e
            e = up[k]
        push(ans, e)
    return ans
