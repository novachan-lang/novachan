// std/tree/tree_traversal.nova — Rooted-tree traversal orders (DFS pre/post, BFS, Euler tour).
//
// Tree representation: adj[i] = list of neighbor integers (undirected, symmetric).
// n = node count (0..n-1). root = the designated root node id.
// Neighbors are processed in ASCENDING index order for deterministic output.
//
// Public API:
//   tt_preorder(adj, n, root)   -> list  node ids in preorder (root, then subtrees left-to-right)
//   tt_postorder(adj, n, root)  -> list  node ids in postorder (subtrees then root)
//   tt_bfs_order(adj, n, root)  -> list  node ids in BFS / level order
//   tt_euler_tour(adj, n, root) -> list  Euler tour: enter node, recurse into each child
//                                        (re-entering node after each child returns),
//                                        length = 2n-1 for n>=1. Single node -> [root].
//
// Euler tour convention: visit(u): emit u; for each child c (ascending): recurse(c), emit u again.
// Length = 2n-1.  Example T5 root=0: [0,1,3,1,4,1,0,2,0].
//
// All traversals use an explicit stack (no recursion) for deep-tree safety.
// Module-private prefix: _tt_

// _tt_isort_asc: insertion-sort a list of integers ascending (in-place).
fn _tt_isort_asc(xs)
    let sz = len(xs)
    for i in 1..sz
        let key = xs[i]
        let j = i - 1
        let done = 0
        while done == 0
            if j < 0
                done = 1
            else
                if xs[j] > key
                    xs[j + 1] = xs[j]
                    j -= 1
                else
                    done = 1
        xs[j + 1] = key

// _tt_children: return sorted (ascending) list of node u's children given parent p.
fn _tt_children(adj, u, parent) -> list
    let nbrs = adj[u]
    let ch = []
    for i in 0..len(nbrs)
        let v = nbrs[i]
        if v != parent
            push(ch, v)
    _tt_isort_asc(ch)
    return ch

// tt_preorder: returns node ids in preorder (root first, then each subtree left-to-right).
// Uses an explicit stack; each stack entry is [node, parent].
fn tt_preorder(adj, n, root) -> list
    if n == 0
        return []
    let result = []
    let stack = []
    let entry = []
    push(entry, root)
    push(entry, -1)
    push(stack, entry)
    while len(stack) > 0
        let top = stack[len(stack) - 1]
        stack = stack[0:len(stack) - 1]
        let u = top[0]
        let par = top[1]
        push(result, u)
        let ch = _tt_children(adj, u, par)
        // push children in REVERSE order so leftmost (smallest) is processed first
        let ci = len(ch) - 1
        while ci >= 0
            let frame = []
            push(frame, ch[ci])
            push(frame, u)
            push(stack, frame)
            ci -= 1
    return result

// tt_postorder: returns node ids in postorder (children before parent).
// Two-pass: first build preorder with children-right-to-left, then reverse.
// Stack entry: [node, parent].
fn tt_postorder(adj, n, root) -> list
    if n == 0
        return []
    // Build a reverse-postorder list (= preorder with children reversed), then flip.
    let tmp = []
    let stack = []
    let entry = []
    push(entry, root)
    push(entry, -1)
    push(stack, entry)
    while len(stack) > 0
        let top = stack[len(stack) - 1]
        stack = stack[0:len(stack) - 1]
        let u = top[0]
        let par = top[1]
        push(tmp, u)
        let ch = _tt_children(adj, u, par)
        // push in ASCENDING order so that right-most child is at top of stack
        // and gets appended to tmp first — giving correct reverse-postorder
        for ci in 0..len(ch)
            let frame = []
            push(frame, ch[ci])
            push(frame, u)
            push(stack, frame)
    // reverse tmp to get postorder
    let result = []
    let ri = len(tmp) - 1
    while ri >= 0
        push(result, tmp[ri])
        ri -= 1
    return result

// tt_bfs_order: returns node ids in BFS (level) order starting from root.
fn tt_bfs_order(adj, n, root) -> list
    if n == 0
        return []
    let result = []
    let queue = []
    let parent = [-2 for i in 0..n]
    push(queue, root)
    parent[root] = -1
    let head = 0
    while head < len(queue)
        let u = queue[head]
        head += 1
        push(result, u)
        let ch = _tt_children(adj, u, parent[u])
        let ci = 0
        while ci < len(ch)
            let v = ch[ci]
            if parent[v] == -2
                parent[v] = u
                push(queue, v)
            ci += 1
    return result

// _tt_euler_step: process one Euler-tour stack frame.
// Stack stores [node, parent, child_index] where child_index = next child to visit.
// Emits node on first visit (child_index==0) and after each child returns.
fn _tt_euler_tour_build(adj, n, root) -> list
    if n == 0
        return []
    let result = []
    // each frame: [node, parent, next_child_idx, children_list_len, ...children]
    // We encode frames as flat lists: [u, par, ci, c0, c1, c2, ...]
    // But NOVA has no nested mutable structs easily, so encode as a stack of lists.
    let stack = []
    // Build initial frame for root
    let rch = _tt_children(adj, root, -1)
    let rf = []
    push(rf, root)
    push(rf, -1)
    push(rf, 0)
    for rci in 0..len(rch)
        push(rf, rch[rci])
    push(result, root)
    push(stack, rf)
    while len(stack) > 0
        let top = stack[len(stack) - 1]
        let u = top[0]
        let par = top[1]
        let ci = top[2]
        let num_ch = len(top) - 3
        if ci >= num_ch
            // all children visited; pop this frame
            stack = stack[0:len(stack) - 1]
            // after popping, emit parent (u re-entered by parent) if stack non-empty
            if len(stack) > 0
                let ptop = stack[len(stack) - 1]
                push(result, ptop[0])
                // increment parent's child_index
                ptop[2] = ptop[2] + 1
        else
            // visit next child
            let cv = top[3 + ci]
            // DO NOT increment ci here; we do it when child pops (above)
            let cch = _tt_children(adj, cv, u)
            let cf = []
            push(cf, cv)
            push(cf, u)
            push(cf, 0)
            for cci in 0..len(cch)
                push(cf, cch[cci])
            push(result, cv)
            push(stack, cf)
    return result

// tt_euler_tour: Euler tour of the tree rooted at root.
// Convention: emit root, then for each child c (ascending id order):
//   recurse into c's subtour, then emit root again.
// Result length = 2n-1 for n>=1.
fn tt_euler_tour(adj, n, root) -> list
    return _tt_euler_tour_build(adj, n, root)
