// std/tree/tree_path.nova — Path queries on an unrooted tree.
//
// Tree representation: adj is a list of lists (undirected adjacency list).
//   adj[i] = list of neighbor node ids for node i (each edge appears at both endpoints).
//   n = number of nodes (ids 0..n-1). Tree has exactly n-1 edges and is connected.
//
// All BFS iterations over neighbor lists process neighbors in ASCENDING id order
// (adj[i] is assumed sorted ascending by the caller, or behavior is deterministic
// based on the order given).
//
// Public API:
//   tpath_distance(adj, n, u, v) -> int   number of edges on the u-to-v path
//   tpath_between(adj, n, u, v) -> list   node ids on the path u..v inclusive
//   tpath_lca(adj, n, root, u, v) -> int  lowest common ancestor of u and v

// _tpath_bfs_parent(adj, n, src) -- BFS from src; returns parent array (-1 for root/unvisited).
fn _tpath_bfs_parent(adj, n, src)
    let parent = []
    for i in 0..n
        push(parent, -1)
    let visited = [0 for j in 0..n]
    let queue = []
    push(queue, src)
    visited[src] = 1
    let head = 0
    while head < len(queue)
        let u = queue[head]
        head = head + 1
        let nbrs = adj[u]
        for k in 0..len(nbrs)
            let v = nbrs[k]
            if visited[v] == 0
                visited[v] = 1
                parent[v] = u
                push(queue, v)
    return parent

// tpath_distance(adj, n, u, v) -- number of edges on the unique u-to-v path.
fn tpath_distance(adj, n, u, v)
    if u == v
        return 0
    let parent = _tpath_bfs_parent(adj, n, u)
    let dist = 0
    let cur = v
    while cur != u
        cur = parent[cur]
        dist = dist + 1
    return dist

// tpath_between(adj, n, u, v) -- ordered list of nodes from u to v inclusive.
fn tpath_between(adj, n, u, v)
    if u == v
        let r = []
        push(r, u)
        return r
    let parent = _tpath_bfs_parent(adj, n, u)
    let rev = []
    let cur = v
    while cur != u
        push(rev, cur)
        cur = parent[cur]
    push(rev, u)
    let path = []
    let i = len(rev) - 1
    while i >= 0
        push(path, rev[i])
        i = i - 1
    return path

// _tpath_depth_and_anc(adj, n, root) -- BFS; returns [depth_list, parent_list].
fn _tpath_depth_and_anc(adj, n, root)
    let depth = []
    let parent = []
    for i in 0..n
        push(depth, -1)
        push(parent, -1)
    depth[root] = 0
    let queue = []
    push(queue, root)
    let head = 0
    while head < len(queue)
        let u = queue[head]
        head = head + 1
        let nbrs = adj[u]
        for k in 0..len(nbrs)
            let v = nbrs[k]
            if depth[v] == -1
                depth[v] = depth[u] + 1
                parent[v] = u
                push(queue, v)
    return [depth, parent]

// tpath_lca(adj, n, root, u, v) -- lowest common ancestor of u and v in the tree rooted at root.
fn tpath_lca(adj, n, root, u, v)
    let dp = _tpath_depth_and_anc(adj, n, root)
    let depth = dp[0]
    let parent = dp[1]
    let a = u
    let b = v
    while depth[a] > depth[b]
        a = parent[a]
    while depth[b] > depth[a]
        b = parent[b]
    while a != b
        a = parent[a]
        b = parent[b]
    return a
