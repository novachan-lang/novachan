// std/tree/tree_ancestors.nova — Rooted-tree ancestor queries.
//
// Tree representation: adj[i] = list of integer neighbors of node i (undirected, 0..n-1).
// n = number of nodes.  root = designated root node id.  No imports required.
//
// BFS from root is used to compute parent and depth arrays in O(n).
//
// Public API:
//   ta_parent(adj, n, root)              -> list  parent[i]; parent[root] = -1
//   ta_depth(adj, n, root)               -> list  depth[i]; depth[root] = 0
//   ta_kth_ancestor(adj,n,root,node,k)   -> int   k-th ancestor of node; -1 if above root
//   ta_is_ancestor(adj,n,root,u,v)       -> bool  true iff u is an ancestor of v
//
// Private prefix: _ta_

// _ta_fill: build a list of n integers all set to val.
fn _ta_fill(n, val) -> list
    let lst = []
    let i = 0
    while i < n
        push(lst, val)
        i += 1
    return lst

// _ta_bfs: BFS from root to compute parent and depth arrays.
// Returns [parent, depth].
fn _ta_bfs(adj, n, root) -> list
    let par = _ta_fill(n, -1)
    let dep = _ta_fill(n, -1)
    let vis = _ta_fill(n, 0)
    let queue = []
    push(queue, root)
    vis[root] = 1
    dep[root] = 0
    let head = 0
    while head < len(queue)
        let u = queue[head]
        head += 1
        let nbrs = adj[u]
        for j in 0..len(nbrs)
            let v = nbrs[j]
            if vis[v] == 0
                vis[v] = 1
                par[v] = u
                dep[v] = dep[u] + 1
                push(queue, v)
    let res = []
    push(res, par)
    push(res, dep)
    return res

// ta_parent: returns the parent array for the tree rooted at root.
// parent[root] = -1.  parent[v] = the parent of v on the path to root.
fn ta_parent(adj, n, root) -> list
    if n == 0
        return []
    let info = _ta_bfs(adj, n, root)
    return info[0]

// ta_depth: returns the depth array for the tree rooted at root.
// depth[root] = 0.  depth[v] = number of edges on the path from root to v.
fn ta_depth(adj, n, root) -> list
    if n == 0
        return []
    let info = _ta_bfs(adj, n, root)
    return info[1]

// ta_kth_ancestor: returns the k-th ancestor of node in the tree rooted at root.
// The 0-th ancestor of node is node itself.
// Returns -1 if the k-th ancestor does not exist (i.e., k > depth[node]).
fn ta_kth_ancestor(adj, n, root, node, k) -> int
    if n == 0
        return -1
    if k < 0
        return -1
    let info = _ta_bfs(adj, n, root)
    let par = info[0]
    let cur = node
    for i in 0..k
        if cur == -1
            return -1
        cur = par[cur]
    return cur

// ta_is_ancestor: returns true iff u is an ancestor of v in the tree rooted at root.
// A node is considered an ancestor of itself.
fn ta_is_ancestor(adj, n, root, u, v) -> bool
    if n == 0
        return false
    let info = _ta_bfs(adj, n, root)
    let par = info[0]
    let cur = v
    while cur != -1
        if cur == u
            return true
        cur = par[cur]
    return false
