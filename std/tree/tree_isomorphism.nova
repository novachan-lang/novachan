// std/tree/tree_isomorphism.nova — Unrooted tree isomorphism via AHU canonical form.
//
// Two unlabeled trees are isomorphic iff there is a bijection on nodes that
// preserves all edges. This implementation roots each tree at its center(s)
// (1 or 2 centroid nodes), then builds a canonical parenthesis string bottom-up
// (children sorted lexicographically for determinism).
//
// Tree representation: adj[i] = list of integer neighbors (undirected).
// n = node count (0..n-1). No imports required.
//
// Public API:
//   ti_canonical(adj, n)                     -> string canonical form
//   ti_are_isomorphic(adj1,n1, adj2,n2)      -> bool
//
// Private prefix: _ti_

// _ti_fill: build a list of n integers all set to val.
fn _ti_fill(n, val)
    let lst = []
    for i in 0..n
        lst.push(val)
    return lst

// _ti_subtree_sizes: iterative DFS from root, returns [sz, par, order].
fn _ti_subtree_sizes(adj, n, root)
    let sz    = _ti_fill(n, 1)
    let par   = _ti_fill(n, -1)
    let order = []
    let vis   = _ti_fill(n, 0)
    let stk   = []
    stk.push(root)
    vis[root] = 1
    let sdone = 0
    while sdone == 0
        if len(stk) == 0
            sdone = 1
        else
            let top = len(stk) - 1
            let u = stk[top]
            stk = stk[0:top]
            order.push(u)
            let nbrs = adj[u]
            for j in 0..len(nbrs)
                let v = nbrs[j]
                if vis[v] == 0
                    vis[v] = 1
                    par[v] = u
                    stk.push(v)
    // accumulate sizes in reverse (post-order)
    let oi = len(order) - 1
    while oi >= 0
        let v = order[oi]
        let p = par[v]
        if p >= 0
            sz[p] = sz[p] + sz[v]
        oi -= 1
    let res = []
    res.push(sz)
    res.push(par)
    res.push(order)
    return res

// _ti_max_comp: max component after removing v.
fn _ti_max_comp(adj, n, sz, par, v)
    let nbrs = adj[v]
    let best = n - sz[v]
    for j in 0..len(nbrs)
        let c = nbrs[j]
        if c != par[v]
            let cs = sz[c]
            if cs > best
                best = cs
    return best

// _ti_centroids: return list of centroid node ids (1 or 2).
fn _ti_centroids(adj, n)
    if n == 1
        let r = []
        r.push(0)
        return r
    let info = _ti_subtree_sizes(adj, n, 0)
    let sz  = info[0]
    let par = info[1]
    let half = n / 2
    let result = []
    for v in 0..n
        let mc = _ti_max_comp(adj, n, sz, par, v)
        if mc <= half
            result.push(v)
    return result

// _ti_isort_strings: insertion-sort a list of strings ascending (in-place).
fn _ti_isort_strings(xs)
    let n = len(xs)
    for i in 1..n
        let key = xs[i]
        let j = i - 1
        let done = 0
        while done == 0
            if j < 0
                done = 1
            else
                if xs[j] > key
                    xs[j + 1] = xs[j]
                    j -= 1
                else
                    done = 1
        xs[j + 1] = key

// _ti_canonical_rooted: AHU canonical string for tree rooted at root.
// Uses iterative post-order: process order reversed, children sorted.
fn _ti_canonical_rooted(adj, n, root)
    if n == 1
        return "()"
    let info = _ti_subtree_sizes(adj, n, root)
    let par  = info[1]
    let order = info[2]
    // label[v] = canonical string of subtree at v
    let label = []
    for i in 0..n
        label.push("")
    // process in post-order (reverse of BFS order)
    let oi = len(order) - 1
    while oi >= 0
        let v = order[oi]
        let nbrs = adj[v]
        let child_labels = []
        for j in 0..len(nbrs)
            let c = nbrs[j]
            if c != par[v]
                child_labels.push(label[c])
        _ti_isort_strings(child_labels)
        let s = "("
        for k in 0..len(child_labels)
            s += child_labels[k]
        s += ")"
        label[v] = s
        oi -= 1
    return label[root]

// ti_canonical: returns the canonical string for an unrooted tree.
// If the tree has two centers, we take the minimum of the two rooted forms.
fn ti_canonical(adj, n)
    if n == 1
        return "(())"
    let cs = _ti_centroids(adj, n)
    let s0 = _ti_canonical_rooted(adj, n, cs[0])
    if len(cs) == 1
        return s0
    let s1 = _ti_canonical_rooted(adj, n, cs[1])
    if s0 < s1
        return s0
    return s1

// ti_are_isomorphic: true iff the two trees are isomorphic (same canonical form).
fn ti_are_isomorphic(adj1, n1, adj2, n2)
    if n1 != n2
        return false
    let c1 = ti_canonical(adj1, n1)
    let c2 = ti_canonical(adj2, n2)
    return c1 == c2
