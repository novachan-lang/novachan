// std/tree/tree_diameter.nova — Tree diameter, endpoints, and center via two-BFS.
//
// Tree representation: adj[i] = list of neighbor integers (undirected, symmetric).
// n = node count (0..n-1). A tree has exactly n-1 edges and is connected.
//
// Public API:
//   td_diameter(adj, n)  -> int   number of edges on the longest path (0 for n<=1)
//   td_endpoints(adj, n) -> list  [u, v] a pair of nodes achieving the diameter
//                                 (for n==1 returns [0,0]; ties broken by smallest u then v)
//   td_center(adj, n)    -> list  list of 1 or 2 center nodes (sorted ascending)
//                                 the center is the node(s) minimizing eccentricity;
//                                 equivalently, the middle node(s) of any diameter path.
//
// Algorithm: two BFS passes.
//   Pass 1: BFS from node 0; furthest node = u.
//   Pass 2: BFS from u; furthest node = v; distance u->v = diameter.
//   Center: reconstruct path u->v via BFS parent array; pick middle node(s).
//
// Module-private prefix: _td_

// _td_bfs: BFS from src; returns [dist_list, parent_list].
// dist[i] = distance from src (-1 not reached). parent[i] = BFS parent (-1 for src).
fn _td_bfs(adj, n, src) -> list
    let dist = []
    let par = []
    let i = 0
    while i < n
        push(dist, -1)
        push(par, -1)
        i = i + 1
    dist[src] = 0
    let queue = []
    push(queue, src)
    let head = 0
    while head < len(queue)
        let u = queue[head]
        head = head + 1
        let du = dist[u]
        let nbrs = adj[u]
        let ni = 0
        while ni < len(nbrs)
            let v = nbrs[ni]
            if dist[v] == -1
                dist[v] = du + 1
                par[v] = u
                push(queue, v)
            ni = ni + 1
    let result = []
    push(result, dist)
    push(result, par)
    return result

// _td_furthest: return the node with maximum BFS distance from src (ties: smallest id).
fn _td_furthest(adj, n, src) -> list
    let dp = _td_bfs(adj, n, src)
    let dist = dp[0]
    let par = dp[1]
    let best_node = src
    let best_d = 0
    let i = 0
    while i < n
        let d = dist[i]
        if d > best_d
            best_d = d
            best_node = i
        i = i + 1
    let r = []
    push(r, best_node)
    push(r, best_d)
    push(r, dist)
    push(r, par)
    return r

// td_diameter: returns the number of edges on the longest path in the tree.
fn td_diameter(adj, n) -> int
    if n <= 1
        return 0
    let r1 = _td_furthest(adj, n, 0)
    let u = r1[0]
    let r2 = _td_furthest(adj, n, u)
    return r2[1]

// td_endpoints: returns [u, v] where u<v, a pair of nodes achieving the diameter.
// For n==1 returns [0,0].
fn td_endpoints(adj, n) -> list
    if n <= 1
        let r = []
        push(r, 0)
        push(r, 0)
        return r
    let r1 = _td_furthest(adj, n, 0)
    let u = r1[0]
    let r2 = _td_furthest(adj, n, u)
    let v = r2[0]
    // normalise so u <= v
    let a = u
    let b = v
    if u > v
        a = v
        b = u
    let res = []
    push(res, a)
    push(res, b)
    return res

// _td_path_from_par: reconstruct path from src to dst using parent array from BFS rooted at src.
// Returns list of node ids from src to dst.
fn _td_path_from_par(par, src, dst) -> list
    let path = []
    let cur = dst
    while cur != src
        push(path, cur)
        cur = par[cur]
    push(path, src)
    // reverse
    let rev = []
    let ri = len(path) - 1
    while ri >= 0
        push(rev, path[ri])
        ri = ri - 1
    return rev

// td_center: returns the list of 1 or 2 center nodes of the tree, sorted ascending.
// The center is the middle node(s) of any diameter path.
// Even-length diameter (odd number of nodes on path) -> 1 center.
// Odd-length diameter (even number of nodes) -> 2 centers (adjacent, both returned sorted).
fn td_center(adj, n) -> list
    if n == 1
        let r = []
        push(r, 0)
        return r
    // two BFS passes to find a diameter path
    let r1 = _td_furthest(adj, n, 0)
    let u = r1[0]
    let r2 = _td_furthest(adj, n, u)
    let v = r2[0]
    let par2 = r2[3]
    // reconstruct path from u to v
    let path = _td_path_from_par(par2, u, v)
    let plen = len(path)
    let mid = plen / 2
    let result = []
    if plen % 2 == 1
        // odd path length -> single center
        push(result, path[mid])
    else
        // even path length -> two centers at plen/2-1 and plen/2
        let c1 = path[mid - 1]
        let c2 = path[mid]
        if c1 < c2
            push(result, c1)
            push(result, c2)
        else
            push(result, c2)
            push(result, c1)
    return result
