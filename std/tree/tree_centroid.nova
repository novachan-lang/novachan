// std/tree/tree_centroid.nova — Centroid(s) of an unrooted tree.
//
// A centroid is a node whose removal leaves all components of size <= n/2.
// Every tree has 1 or 2 centroids; if 2, they are adjacent.
//
// Tree representation: adj[i] = list of integer neighbors of node i (undirected).
// n = node count (0..n-1). No imports required.
//
// Public API:
//   tc_centroid(adj, n)  -> int   smallest-id centroid
//   tc_centroids(adj, n) -> list  [c] or [c1, c2] ascending
//
// Algorithm: compute subtree sizes via iterative post-order DFS (explicit stack).
// A node v is a centroid iff max(sz[v]-sz[v]-..., n-sz[v]) <= n/2, i.e.
// the largest component after removing v is <= n/2.
// Private prefix: _tc_

// _tc_fill: build a list of n integers all set to val.
fn _tc_fill(n, val)
    let lst = []
    for i in 0..n
        lst.push(val)
    return lst

// _tc_subtree_sizes: compute subtree sizes rooted at node 0 via iterative DFS.
// Returns sz list where sz[v] = size of subtree rooted at v (parent = par[v]).
fn _tc_subtree_sizes(adj, n)
    let sz  = _tc_fill(n, 1)
    let par = _tc_fill(n, -1)
    let order = []
    // iterative DFS to build post-order
    let stk = []
    let vis = _tc_fill(n, 0)
    stk.push(0)
    vis[0] = 1
    let sdone = 0
    while sdone == 0
        if len(stk) == 0
            sdone = 1
        else
            let top = len(stk) - 1
            let u = stk[top]
            stk = stk[0:top]
            order.push(u)
            let nbrs = adj[u]
            for j in 0..len(nbrs)
                let v = nbrs[j]
                if vis[v] == 0
                    vis[v] = 1
                    par[v] = u
                    stk.push(v)
    // process in reverse order (post-order)
    let oi = len(order) - 1
    while oi >= 0
        let v = order[oi]
        let p = par[v]
        if p >= 0
            sz[p] = sz[p] + sz[v]
        oi = oi - 1
    let res = []
    res.push(sz)
    res.push(par)
    return res

// _tc_max_comp: max component size when removing node v (given subtree sizes rooted at 0).
fn _tc_max_comp(adj, n, sz, par, v)
    let nbrs = adj[v]
    let best = n - sz[v]
    for j in 0..len(nbrs)
        let c = nbrs[j]
        if c != par[v]
            let cs = sz[c]
            if cs > best
                best = cs
    return best

// tc_centroids: returns list of all centroids (1 or 2) in ascending order.
fn tc_centroids(adj, n)
    if n == 1
        let r = []
        r.push(0)
        return r
    let info = _tc_subtree_sizes(adj, n)
    let sz  = info[0]
    let par = info[1]
    let half = n / 2
    let result = []
    for v in 0..n
        let mc = _tc_max_comp(adj, n, sz, par, v)
        if mc <= half
            result.push(v)
    return result

// tc_centroid: returns the smallest-id centroid.
fn tc_centroid(adj, n)
    let cs = tc_centroids(adj, n)
    return cs[0]
