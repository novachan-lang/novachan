// std/dsp/normalize.nova -- Signal normalization and scaling utilities.
//
// All functions operate on float lists (signals). Returns a new list; never
// mutates the input. Signals are represented as float lists.
//
// Public API (prefix nrm_)
//   nrm_peak(xs)             -> list   Scale so max |value| == 1.0
//   nrm_minmax(xs, lo, hi)   -> list   Rescale values to the range [lo, hi]
//   nrm_zscore(xs)           -> list   Standardize to mean=0, std=1
//   nrm_dc_remove(xs)        -> list   Subtract the mean (DC offset removal)
//   nrm_rms(xs)              -> float  Root-mean-square level of the signal
//
// FLOAT HAZARDS obeyed throughout:
//   - List element reads are 'any'; multiply by 1.0 to force float.
//   - abs(float) returns int in NOVA — use if/else for float absolute value.
//   - '/' on two ints is integer division — always use float denominators.
//   - float vs int compare is UNSOUND — coerce with *1.0 before comparisons.
//   - Never return a bare multi-term float expression (uninit-slot bug).
//   - Bind all composite float sub-expressions to named lets before use.
//   - NO single-line if; always use block body.

// nrm_peak -- Peak normalization.
// Scales the signal so that the maximum absolute value equals 1.0.
// Each output[i] = xs[i] / max_abs(xs).
// Returns an empty list if xs is empty, and xs unchanged if max_abs == 0.
fn nrm_peak(xs: list) -> list
    let result = []
    let n = len(xs)
    if n == 0
        return result
    let peak = 0.0
    let i = 0
    while i < n
        let v = xs[i] * 1.0
        let av = v
        if v < 0.0
            av = 0.0 - v
        if av > peak
            peak = av
        i = i + 1
    if peak < 0.0000001
        let j = 0
        while j < n
            let vv = xs[j] * 1.0
            result.push(vv)
            j = j + 1
        return result
    let j = 0
    while j < n
        let v = xs[j] * 1.0
        let sv = v / peak
        result.push(sv)
        j = j + 1
    result

// nrm_minmax -- Min-max rescaling.
// Rescales the signal linearly so that the minimum maps to lo and the maximum
// maps to hi.  output[i] = lo + (xs[i] - min) * (hi - lo) / (max - min).
// If all values are equal (range == 0), every output element is set to lo.
fn nrm_minmax(xs: list, lo: float, hi: float) -> list
    let result = []
    let n = len(xs)
    if n == 0
        return result
    let vmin = xs[0] * 1.0
    let vmax = xs[0] * 1.0
    let i = 1
    while i < n
        let v = xs[i] * 1.0
        if v < vmin
            vmin = v
        if v > vmax
            vmax = v
        i = i + 1
    let range = vmax - vmin
    let span = hi - lo
    if range < 0.0000001
        let j = 0
        while j < n
            result.push(lo)
            j = j + 1
        return result
    let j = 0
    while j < n
        let v = xs[j] * 1.0
        let scaled = lo + (v - vmin) * span / range
        result.push(scaled)
        j = j + 1
    result

// nrm_dc_remove -- DC offset removal (mean subtraction).
// output[i] = xs[i] - mean(xs).
// Returns an empty list if xs is empty.
fn nrm_dc_remove(xs: list) -> list
    let result = []
    let n = len(xs)
    if n == 0
        return result
    let s = 0.0
    let i = 0
    while i < n
        let v = xs[i] * 1.0
        s = s + v
        i = i + 1
    let nf = n * 1.0
    let mean = s / nf
    let j = 0
    while j < n
        let v = xs[j] * 1.0
        let out = v - mean
        result.push(out)
        j = j + 1
    result

// nrm_zscore -- Z-score standardization.
// output[i] = (xs[i] - mean) / std_dev.
// If std_dev == 0 (constant signal), output is all zeros.
// Uses population standard deviation (divide by N, not N-1).
fn nrm_zscore(xs: list) -> list
    let result = []
    let n = len(xs)
    if n == 0
        return result
    let s = 0.0
    let i = 0
    while i < n
        let v = xs[i] * 1.0
        s = s + v
        i = i + 1
    let nf = n * 1.0
    let mean = s / nf
    let vsum = 0.0
    let k = 0
    while k < n
        let v = xs[k] * 1.0
        let diff = v - mean
        vsum = vsum + diff * diff
        k = k + 1
    let variance = vsum / nf
    let stddev = sqrt(variance)
    if stddev < 0.0000001
        let j = 0
        while j < n
            result.push(0.0)
            j = j + 1
        return result
    let j = 0
    while j < n
        let v = xs[j] * 1.0
        let z = (v - mean) / stddev
        result.push(z)
        j = j + 1
    result

// nrm_rms -- Root-mean-square level.
// rms = sqrt(sum(xs[i]^2) / n).
// Returns 0.0 for an empty list.
fn nrm_rms(xs: list) -> float
    let n = len(xs)
    if n == 0
        let zero = 0.0
        return zero
    let s = 0.0
    let i = 0
    while i < n
        let v = xs[i] * 1.0
        s = s + v * v
        i = i + 1
    let nf = n * 1.0
    let mean_sq = s / nf
    let result = sqrt(mean_sq)
    result
