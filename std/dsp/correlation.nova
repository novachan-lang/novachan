// std/dsp/correlation.nova — cross/auto-correlation and Pearson coefficient.
// Signals are float lists. LEAF — imports NOTHING.
//
// FLOAT HAZARDS (see NOVA memory):
//   • Bind sqrt() result to a named `let` before use.
//   • Float vs int compare UNSOUND — coerce with *1.0.
//   • Never return a bare multi-term float expression (uninit-slot bug).
//   • abs(float) returns int — use if/else for float absolute value.
//
// API:
//   cor_cross(a, b) -> list   Full cross-correlation, length len(a)+len(b)-1.
//                             out[k] = sum_i a[i]*b[j] where j = i-(k-(len(b)-1)),
//                             for valid indices.  Lag tau = k - (len(b)-1).
//   cor_auto(a)     -> list   Autocorrelation: cor_cross(a, a).
//   cor_pearson(a, b) -> float Pearson r coefficient (equal-length lists).
//                             Returns 0.0 when either signal has zero variance.
//   cor_lag_of_max(a, b) -> int  Signed lag (in samples) with peak cross-correlation.

// Private: mean of a list (returns 0.0 for empty).
fn _cor_mean(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = 0.0
    for i in 0..n
        let v = xs[i] * 1.0
        s = s + v
    let r = s / (n * 1.0)
    r

// Private: population standard deviation (denominator n).
fn _cor_std(xs: list, mu: float) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let acc = 0.0
    let i = 0
    while i < n
        let d = xs[i] * 1.0 - mu
        acc = acc + d * d
        i = i + 1
    let v = acc / (n * 1.0)
    let sd = sqrt(v)
    sd

// Full cross-correlation of a (length M) with b (length N).
// Output length = M + N - 1.
// out[k] = sum_{i} a[i] * b[i - (k - (N-1))]
//   for indices where 0 <= i < M  AND  0 <= i-(k-(N-1)) < N.
// Lag at output index k is:  tau = k - (N-1).
fn cor_cross(a: list, b: list) -> list
    let m = len(a)
    let n = len(b)
    let out_len = m + n - 1
    let out = []
    for k in 0..out_len
        let s = 0.0
        let offset = k - (n - 1)
        let i = 0
        while i < m
            let j = i - offset
            if j >= 0 and j < n
                let ai = a[i] * 1.0
                let bj = b[j] * 1.0
                s = s + ai * bj
            i = i + 1
        push(out, s)
    out

// Autocorrelation: cross-correlation of a with itself.
fn cor_auto(a: list) -> list
    let result = cor_cross(a, a)
    result

// Pearson correlation coefficient between equal-length lists a and b.
// Returns 0.0 when either signal has zero variance (constant signal).
fn cor_pearson(a: list, b: list) -> float
    let n = len(a)
    if n == 0
        return 0.0
    let mu_a = _cor_mean(a)
    let mu_b = _cor_mean(b)
    let std_a = _cor_std(a, mu_a)
    let std_b = _cor_std(b, mu_b)
    let tiny = 0.000000001
    if std_a < tiny
        return 0.0
    if std_b < tiny
        return 0.0
    let cov = 0.0
    for i in 0..n
        let da = a[i] * 1.0 - mu_a
        let db = b[i] * 1.0 - mu_b
        cov = cov + da * db
    let denom = std_a * std_b * (n * 1.0)
    let r = cov / denom
    r

// Signed lag (samples) at which cross-correlation is maximised.
// Positive lag means b lags a (b trails a).
// Returns 0 for empty/single-element inputs.
fn cor_lag_of_max(a: list, b: list) -> int
    let cc = cor_cross(a, b)
    let out_len = len(cc)
    if out_len == 0
        return 0
    let best_idx = 0
    let best_val = cc[0] * 1.0
    for k in 1..out_len
        let v = cc[k] * 1.0
        if v > best_val
            best_val = v
            best_idx = k
    let n = len(b)
    let lag = best_idx - (n - 1)
    lag
