// std/dsp/dft.nova — Naive O(N²) DFT and IDFT over real signals.
//
// Complex output is represented as a pair of parallel float lists:
//   index 0 = real parts, index 1 = imaginary parts.
//
// API:
//   dft_forward(signal)           -> list [reList, imList]   N-point DFT
//   dft_inverse(reList, imList)   -> list (real signal)      N-point IDFT
//   dft_magnitude(signal)         -> list   magnitude spectrum |X[k]|
//   dft_power(signal)             -> list   power spectrum    |X[k]|²
//
// FLOAT HAZARDS obeyed:
//   • sin/cos/sqrt always bound to a named let before use.
//   • Float abs via (if x < 0.0 …) — never abs().
//   • Integer division guarded: denominators are float literals.
//   • No multi-term float return — single named result variable.

// ── private: two-argument float abs ──────────────────────────────────────────

fn _dft_fabs(x: float) -> float
    let r = x
    if x < 0.0
        r = 0.0 - x
    r

// ── private: compute one DFT output bin (re,im) and push to out lists ────────
// signal   : input real list
// k        : output bin index
// re_out   : accumulator list for real parts (mutated)
// im_out   : accumulator list for imaginary parts (mutated)
fn _dft_bin(signal: list, k: int, re_out: list, im_out: list)
    let N = len(signal)
    let TWO_PI = 2.0 * pi()
    let re_sum = 0.0
    let im_sum = 0.0
    for n in 0..N
        let xn = signal[n] * 1.0
        let angle = TWO_PI * (k * 1.0) * (n * 1.0) / (N * 1.0)
        let c = cos(angle)
        let s = sin(angle)
        re_sum += xn * c
        im_sum -= xn * s
    re_out.push(re_sum)
    im_out.push(im_sum)

// ── dft_forward ──────────────────────────────────────────────────────────────
// X[k] = Σ_{n=0}^{N-1}  x[n] * (cos(2π k n / N) - i·sin(2π k n / N))
// Returns [reList, imList] where each list has N elements.

fn dft_forward(signal: list) -> list
    let N = len(signal)
    let re_out = []
    let im_out = []
    for k in 0..N
        _dft_bin(signal, k, re_out, im_out)
    let result = []
    result.push(re_out)
    result.push(im_out)
    result

// ── dft_inverse ──────────────────────────────────────────────────────────────
// x[n] = (1/N) * Σ_{k=0}^{N-1}  X[k] * exp(+2πi k n / N)
// Only the real part is returned (imaginary cancels for a real signal).

fn dft_inverse(re_in: list, im_in: list) -> list
    let N = len(re_in)
    let out = []
    let TWO_PI = 2.0 * pi()
    for n in 0..N
        let re_sum = 0.0
        for k in 0..N
            let re_k = re_in[k] * 1.0
            let im_k = im_in[k] * 1.0
            let angle = TWO_PI * (k * 1.0) * (n * 1.0) / (N * 1.0)
            let c = cos(angle)
            let s = sin(angle)
            re_sum += re_k * c - im_k * s
        let val = re_sum / (N * 1.0)
        out.push(val)
    out

// ── dft_magnitude ────────────────────────────────────────────────────────────
// |X[k]| = sqrt(Re[k]² + Im[k]²)
// Inlines the DFT to avoid nested-list indexing through an any-typed slot.

fn dft_magnitude(signal: list) -> list
    let N = len(signal)
    let out = []
    let TWO_PI = 2.0 * pi()
    for k in 0..N
        let re_sum = 0.0
        let im_sum = 0.0
        for n in 0..N
            let xn = signal[n] * 1.0
            let angle = TWO_PI * (k * 1.0) * (n * 1.0) / (N * 1.0)
            let c = cos(angle)
            let s = sin(angle)
            re_sum += xn * c
            im_sum -= xn * s
        let sq = re_sum * re_sum + im_sum * im_sum
        let mag = sqrt(sq)
        out.push(mag)
    out

// ── dft_power ────────────────────────────────────────────────────────────────
// |X[k]|² = Re[k]² + Im[k]²
// Inlines the DFT to avoid nested-list indexing through an any-typed slot.

fn dft_power(signal: list) -> list
    let N = len(signal)
    let out = []
    let TWO_PI = 2.0 * pi()
    for k in 0..N
        let re_sum = 0.0
        let im_sum = 0.0
        for n in 0..N
            let xn = signal[n] * 1.0
            let angle = TWO_PI * (k * 1.0) * (n * 1.0) / (N * 1.0)
            let c = cos(angle)
            let s = sin(angle)
            re_sum += xn * c
            im_sum -= xn * s
        let pw = re_sum * re_sum + im_sum * im_sum
        out.push(pw)
    out
