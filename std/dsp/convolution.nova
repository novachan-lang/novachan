// std/dsp/convolution.nova — discrete linear convolution of float lists.
// Prefix: cnv_
// Provides: cnv_full, cnv_same, cnv_valid
// LEAF — imports NOTHING.
//
// All signals are float lists.  The three standard convolution modes:
//   cnv_full(a, b)  — full output, length = len(a)+len(b)-1
//   cnv_same(a, b)  — same length as a, centered in the full result
//   cnv_valid(a, b) — only samples where b fits entirely inside a,
//                     length = max(0, len(a)-len(b)+1)
//
// FLOAT HAZARDS (see NOVA memory):
//   • Bind sub-expressions to named lets before returning.
//   • Integer / produces integer division — always coerce with *1.0.
//   • abs(float) returns int — use if/else for float absolute value.

// cnv_full(a, b) -> list
// Full linear convolution.  Output length = len(a)+len(b)-1.
// For each output index n in [0, len(a)+len(b)-2]:
//   out[n] = sum over k where 0<=k<len(b) and 0<=n-k<len(a) of a[n-k]*b[k]
fn cnv_full(a: list, b: list) -> list
    let na = len(a)
    let nb = len(b)
    let out = []
    if na == 0 or nb == 0
        return out
    let out_len = na + nb - 1
    let n = 0
    while n < out_len
        let acc = 0.0
        let k = 0
        while k < nb
            let ak = n - k
            if ak >= 0 and ak < na
                let av = a[ak] * 1.0
                let bv = b[k] * 1.0
                acc += av * bv
            k += 1
        push(out, acc)
        n += 1
    out

// cnv_same(a, b) -> list
// Centered convolution, same length as a.
// Extracts len(a) samples from cnv_full(a,b) starting at offset floor((len(b)-1)/2).
fn cnv_same(a: list, b: list) -> list
    let na = len(a)
    let nb = len(b)
    let out = []
    if na == 0 or nb == 0
        return out
    let full = cnv_full(a, b)
    let start = (nb - 1) / 2
    for i in 0..na
        let idx = start + i
        let v = full[idx] * 1.0
        push(out, v)
    out

// cnv_valid(a, b) -> list
// Only samples where b fits entirely inside a.
// Output length = max(0, len(a)-len(b)+1).
// For each output index n in [0, len(a)-len(b)]:
//   out[n] = sum over k in [0, len(b)-1] of a[n+k]*b[k]
fn cnv_valid(a: list, b: list) -> list
    let na = len(a)
    let nb = len(b)
    let out = []
    if na == 0 or nb == 0 or nb > na
        return out
    let out_len = na - nb + 1
    for n in 0..out_len
        let acc = 0.0
        let k = 0
        while k < nb
            let av = a[n + k] * 1.0
            let bv = b[k] * 1.0
            acc += av * bv
            k += 1
        push(out, acc)
    out
