// std/dsp/resample.nova -- Signal resampling over float lists.
//
// All signals are float lists.  Resampling changes the effective sample rate
// without altering the underlying information (within limits).
//
// Public API (prefix rsm_)
//   rsm_upsample(xs, factor) -> list  Insert (factor-1) zeros between each sample.
//   rsm_downsample(xs, factor) -> list  Keep every factor-th sample (starting at 0).
//   rsm_decimate(xs, factor) -> list  Average each non-overlapping block of factor samples.
//   rsm_linear(xs, newLen) -> list  Linear interpolation to exactly newLen samples.
//
// Float arithmetic notes (NOVA gotchas)
//   - List element reads are 'any'; multiply by 1.0 to force float before math.
//   - Integer / produces integer division; always use float denominators.
//   - abs(float) returns int in NOVA; use if/else for float absolute value.
//   - Bind composite float expressions to a 'let' before returning (uninit-slot bug).

// rsm_upsample(xs, factor) -> list
// Inserts (factor-1) zeros between each sample.
// Output length = len(xs) * factor.
// rsm_upsample([1.0, 2.0], 2) == [1.0, 0.0, 2.0, 0.0]
fn rsm_upsample(xs: list, factor: int) -> list
    let result = []
    let n = len(xs)
    if factor <= 0
        return result
    if n == 0
        return result
    for i in 0..n
        let v = xs[i] * 1.0
        push(result, v)
        for z in 1..factor
            push(result, 0.0)
    result

// rsm_downsample(xs, factor) -> list
// Keeps every factor-th sample, starting at index 0.
// Output length = ceil(len(xs) / factor).
// rsm_downsample([1.0, 2.0, 3.0, 4.0], 2) == [1.0, 3.0]
fn rsm_downsample(xs: list, factor: int) -> list
    let result = []
    let n = len(xs)
    if factor <= 0
        return result
    if n == 0
        return result
    let i = 0
    while i < n
        let v = xs[i] * 1.0
        push(result, v)
        i += factor
    result

// rsm_decimate(xs, factor) -> list
// Averages each non-overlapping block of factor samples.
// Trailing samples that don't fill a full block are discarded.
// Output length = floor(len(xs) / factor).
// rsm_decimate([1.0, 3.0, 2.0, 4.0], 2) == [2.0, 3.0]
fn rsm_decimate(xs: list, factor: int) -> list
    let result = []
    let n = len(xs)
    if factor <= 0
        return result
    if n == 0
        return result
    let ff = factor * 1.0
    let num_blocks = n / factor
    for b in 0..num_blocks
        let s = 0.0
        for j in 0..factor
            let v = xs[b * factor + j] * 1.0
            s += v
        let avg = s / ff
        push(result, avg)
    result

// rsm_linear(xs, newLen) -> list
// Linear interpolation to exactly newLen samples.
// Maps output index i to a fractional position in xs:
//   pos = i * (len(xs)-1) / (newLen-1)
// The boundary cases: newLen==1 returns [xs[0]]; newLen==0 returns [].
// rsm_linear([0.0, 10.0], 3) == [0.0, 5.0, 10.0]
// rsm_linear([0.0, 10.0], 5) == [0.0, 2.5, 5.0, 7.5, 10.0]
fn rsm_linear(xs: list, newLen: int) -> list
    let result = []
    let n = len(xs)
    if n == 0
        return result
    if newLen <= 0
        return result
    if newLen == 1
        let v0 = xs[0] * 1.0
        push(result, v0)
        return result
    let last_in = n - 1
    let last_out = newLen - 1
    let last_inf = last_in * 1.0
    let last_outf = last_out * 1.0
    for i in 0..newLen
        let pos = i * 1.0 * last_inf / last_outf
        let lo = 0
        // integer floor of pos
        let pos_int = i * last_in / last_out
        lo = pos_int
        if lo >= last_in
            lo = last_in - 1
        let hi = lo + 1
        let lo_f = lo * 1.0
        let frac = pos - lo_f
        let vlo = xs[lo] * 1.0
        let vhi = xs[hi] * 1.0
        let interp = vlo + frac * (vhi - vlo)
        push(result, interp)
    result
