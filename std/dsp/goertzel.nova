// std/dsp/goertzel.nova — Goertzel algorithm: single-frequency power detection.
//
// The Goertzel algorithm efficiently computes the DFT at a single frequency
// using an O(N) second-order IIR recurrence.  It is used in DTMF detection,
// tone presence testing, and narrowband energy measurement.
//
// Public API (prefix goe_):
//   goe_power(signal, targetFreq, sampleRate)            -> float
//     Power (|X[k]|²) at targetFreq via the Goertzel recurrence.
//   goe_magnitude(signal, targetFreq, sampleRate)        -> float
//     Magnitude (|X[k]|) at targetFreq = sqrt(goe_power(...)).
//   goe_detect(signal, targetFreq, sampleRate, threshold) -> bool
//     True when goe_power >= threshold (tone-present test).
//
// Algorithm:
//   N   = len(signal)
//   k   = round(N * targetFreq / sampleRate)     [nearest frequency bin]
//   omega = 2π * k / N
//   coeff = 2 * cos(omega)                        [bound to a let — float hazard]
//   recurrence (n = 0 .. N-1):
//     s[n] = x[n] + coeff * s[n-1] - s[n-2]
//   power = s[N-1]² + s[N-2]² - coeff * s[N-1] * s[N-2]
//
// FLOAT HAZARDS obeyed throughout:
//   - List element reads are 'any'; multiply by 1.0 to force float.
//   - abs(float) returns int in NOVA; use if/else for float absolute value.
//   - '/' on two ints is integer division; use float denominator explicitly.
//   - float vs int compare is UNSOUND; coerce with *1.0.
//   - Never return a bare multi-term float expression (uninit-slot bug).
//   - Bind all composite float sub-expressions to named lets.
//   - cos result MUST be bound to a let before use (uninit-slot bug).
//   - NO single-line if; always use block body.
//   - NO 'and'/'or' short-circuit on complex booleans; use nested if.

// ── private: frequency bin ────────────────────────────────────────────────────
// Computes k = round(N * targetFreq / sampleRate) as an integer.
// round() is emulated as floor(x + 0.5) since NOVA has floor/ceil via
// integer cast of (x + 0.5).  We use int(x + 0.5) directly.

fn _goe_bin(n: int, targetFreq: float, sampleRate: float) -> int
    let nf = n * 1.0
    let ratio = nf * targetFreq / sampleRate
    let shifted = ratio + 0.5
    let k = int(shifted)
    k

// ── private: core Goertzel recurrence ────────────────────────────────────────
// Returns the raw power at bin k for the given signal.
// Caller is responsible for ensuring N >= 1 and sampleRate > 0.

fn _goe_run(signal: list, targetFreq: float, sampleRate: float) -> float
    let N = len(signal)
    let nf = N * 1.0
    let k = _goe_bin(N, targetFreq, sampleRate)
    let TWO_PI = 2.0 * pi()
    let kf = k * 1.0
    let omega = TWO_PI * kf / nf
    let c = cos(omega)
    let coeff = 2.0 * c
    let s_prev2 = 0.0
    let s_prev1 = 0.0
    let i = 0
    while i < N
        let xn = signal[i] * 1.0
        let s_cur = xn + coeff * s_prev1 - s_prev2
        s_prev2 = s_prev1
        s_prev1 = s_cur
        i = i + 1
    let sp1sq = s_prev1 * s_prev1
    let sp2sq = s_prev2 * s_prev2
    let cross = coeff * s_prev1 * s_prev2
    let power = sp1sq + sp2sq - cross
    power

// ── goe_power ─────────────────────────────────────────────────────────────────
// Returns |X[k]|² at targetFreq Hz using the Goertzel algorithm.
// Returns 0.0 for an empty signal.

fn goe_power(signal: list, targetFreq: float, sampleRate: float) -> float
    let N = len(signal)
    if N == 0
        let z = 0.0
        return z
    let p = _goe_run(signal, targetFreq, sampleRate)
    p

// ── goe_magnitude ─────────────────────────────────────────────────────────────
// Returns |X[k]| = sqrt(goe_power(...)) at targetFreq Hz.
// Inlines the Goertzel recurrence directly to avoid float-return stale-slot
// issues when chaining function calls through sqrt().
// Returns 0.0 for an empty signal.

fn goe_magnitude(signal: list, targetFreq: float, sampleRate: float) -> float
    let N = len(signal)
    if N == 0
        let z = 0.0
        return z
    let nf = N * 1.0
    let k = _goe_bin(N, targetFreq, sampleRate)
    let TWO_PI = 2.0 * pi()
    let kf = k * 1.0
    let omega = TWO_PI * kf / nf
    let c = cos(omega)
    let coeff = 2.0 * c
    let s_prev2 = 0.0
    let s_prev1 = 0.0
    let i = 0
    while i < N
        let xn = signal[i] * 1.0
        let s_cur = xn + coeff * s_prev1 - s_prev2
        s_prev2 = s_prev1
        s_prev1 = s_cur
        i = i + 1
    let sp1sq = s_prev1 * s_prev1
    let sp2sq = s_prev2 * s_prev2
    let cross = coeff * s_prev1 * s_prev2
    let power = sp1sq + sp2sq - cross
    let mag = sqrt(power)
    mag

// ── goe_detect ────────────────────────────────────────────────────────────────
// Returns true when goe_power(signal, targetFreq, sampleRate) >= threshold.
// Useful for simple tone-present / tone-absent detection.

fn goe_detect(signal: list, targetFreq: float, sampleRate: float, threshold: float) -> bool
    let p = goe_power(signal, targetFreq, sampleRate)
    let result = false
    if p >= threshold
        result = true
    result
