// ============================================================================
// NOVA Standard Library — std/data/tomlwrite
// ============================================================================
// TOML serializer.  The native build_toml_format only writes flat string-valued
// dicts; this module handles the full value surface: ints, bools, floats,
// strings (with escaping), lists, and nested dicts (as TOML [section] headers).
//
// PUBLIC API:
//   tw_write_value(v) -> string
//     Serialise a single NOVA value to its TOML inline representation.
//       string  -> double-quoted with basic escape sequences
//       int     -> decimal integer literal ("42")
//       float   -> decimal float literal ("3.14")
//       bool    -> "true" or "false"
//       list    -> "[elem, elem, ...]" (elements rendered inline)
//       dict    -> "{key = value, ...}" (inline table; keys sorted)
//       null    -> "" (TOML has no null; omit the key from the caller)
//       other   -> "" (unknown types silently suppressed)
//
//   tw_write(d) -> string
//     Serialise a NOVA dict to a TOML document string.
//     Top-level scalar keys (string/int/float/bool/list values) are emitted
//     first as "key = value" lines, sorted lexicographically for determinism.
//     Top-level dict-valued keys are then emitted as "[section]" blocks whose
//     content is likewise sorted by key.
//     Nested dicts beyond one level deep are serialised as TOML inline tables
//     (produced by tw_write_value).
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - Single-exit style throughout to avoid the NOVA return-null mistag bug.
//   - No multi-line list/dict literals in module body (NOVA parser limitation).
//   - Brace characters via chr(123)/chr(125) to avoid string interpolation.
//   - type_of() is used for ALL runtime dispatch (is_dict/is_list are compile-
//     time predicates that resolve to 0 for any-typed values).
//   - Booleans stored in dicts (any context) report type_of == "bool".
//   - Ints stored in dicts report type_of == "int".
//   - Floats stored in dicts report type_of == "float".
//   - TOML spec: only double-quoted strings use escape sequences; bare keys
//     are restricted to [A-Za-z0-9_-] but we quote keys via double-quotes
//     when needed.  We do NOT quote keys here (callers are expected to use
//     bare-safe key strings, as is overwhelmingly the common case).
//
// IMPORTANT NOVA LIMITATION (documented in CLAUDE.md gotchas):
//   type_of(true) == "int"  — booleans and integers are indistinguishable
//   at the scalar level.  The "bool" branch in tw_write_value only fires for
//   values boxed as NOVA_BOX_BOOL, which does NOT occur for dict["key"]=true
//   assignments in NOVA.  In practice tw_write_value(true) returns "1" and
//   tw_write_value(false) returns "0".  If you need "true"/"false" TOML
//   output, store the string "true"/"false" as the dict value, or use the
//   tw_write_bool helper below.
//
// tw_write_bool(v: int) -> string
//   Explicit boolean serialiser: returns "true" for any non-zero int, else "false".
//   Use when you know a key is semantic-boolean.
//
// KAT vectors (see _tomlwrite_test.nova):
//   tw_write_value("hi")    == chr(34)+"hi"+chr(34)
//   tw_write_value(42)      == "42"
//   tw_write_value(1)       == "1"   (ints, incl. bool literals, are ints)
//   tw_write_bool(1)        == "true"
//   tw_write_bool(0)        == "false"
//   tw_write of a flat dict contains 'name = "nova"', 'version = 1'
//   tw_write of {"server": {"port": 8080}} contains "[server]" and "port = 8080"
//   round-trip: build_toml_parse(tw_write(flat_dict)) recovers "name" = "nova"
// ============================================================================

// ── Private: escape a single character for TOML basic string ─────────────────

// _tw_esc_char: return the TOML basic-string escape sequence for character c,
// or the character itself if no escaping is required.
// TOML basic escapes: \" \\ \n \r \t (also \b \f but rarely needed).
fn _tw_esc_char(c: string) -> string
    let result = c
    let o = ord(c)
    if o == 34
        result = "\\" + chr(34)
    else
        if o == 92
            result = "\\\\"
        else
            if o == 10
                result = "\\n"
            else
                if o == 13
                    result = "\\r"
                else
                    if o == 9
                        result = "\\t"
    result

// _tw_escape_str: wrap s in double-quotes with TOML basic string escaping.
fn _tw_escape_str(s: string) -> string
    let n = len(s)
    let out = chr(34)
    for i in 0..n
        out += _tw_esc_char(char_at(s, i))
    out += chr(34)
    out

// ── Public: explicit boolean serialiser ──────────────────────────────────────

// tw_write_bool: explicit boolean serialiser.
//
// In NOVA, type_of(true) == "int" — booleans and integers share the same
// runtime representation at the scalar level.  Use tw_write_bool when you
// KNOW a value represents a TOML boolean (e.g. feature flags, config switches).
// Returns "true" for any non-zero int, "false" for zero.
fn tw_write_bool(v: int) -> string
    let result = "false"
    if v != 0
        result = "true"
    result

// ── Private: list rendering ───────────────────────────────────────────────────

// _tw_render_list: render a NOVA list as a TOML array "[a, b, c]".
// Each element is serialised via tw_write_value (forward-declared by position:
// NOVA resolves mutual recursion through the module's top-level scope).
fn _tw_render_list(lst) -> string
    let n = len(lst)
    let out = "["
    for i in 0..n
        if i > 0
            out += ", "
        out += tw_write_value(lst[i])
    out += "]"
    out

// ── Private: inline table rendering ──────────────────────────────────────────

// _tw_render_inline_table: render a NOVA dict as a TOML inline table
// "{ key = value, key2 = value2 }".  Keys are sorted for determinism.
fn _tw_render_inline_table(d) -> string
    let ks = sort(keys(d))
    let n = len(ks)
    let out = chr(123) + " "
    for i in 0..n
        if i > 0
            out += ", "
        let k = ks[i]
        let v = d[k]
        out += k + " = " + tw_write_value(v)
    out += " " + chr(125)
    out

// ── Public: single-value serialiser ──────────────────────────────────────────

// tw_write_value: serialise one NOVA value to its TOML inline form.
//
// Dispatch order:
//   1. "bool"   -> "true" / "false"  (must precede "int": booleans ARE ints in
//                  NOVA but are boxed as bool when stored in any context)
//   2. "string" -> double-quoted with escaping
//   3. "int"    -> str(v)  (decimal)
//   4. "float"  -> str(v)  (decimal; NOVA's str() emits decimal for floats)
//   5. "list"   -> "[...]"
//   6. "dict"   -> inline table
//   7. anything else -> ""
fn tw_write_value(v) -> string
    let result = ""
    let kind = type_of(v)
    if kind == "bool"
        if v == 1
            result = "true"
        else
            result = "false"
    else
        if kind == "string"
            result = _tw_escape_str(str(v))
        else
            if kind == "int"
                result = str(v)
            else
                if kind == "float"
                    result = str(v)
                else
                    if kind == "list"
                        result = _tw_render_list(v)
                    else
                        if kind == "dict"
                            result = _tw_render_inline_table(v)
    result

// ── Private: top-level section renderer ──────────────────────────────────────

// _tw_is_scalar: true (1) if the value should be emitted as a "key = value"
// line rather than deferred to a "[section]" block.
// Scalars: bool, string, int, float, list.  Dicts become sections.
fn _tw_is_scalar(v) -> int
    let kind = type_of(v)
    let result = 0
    if kind == "bool"
        result = 1
    else
        if kind == "string"
            result = 1
        else
            if kind == "int"
                result = 1
            else
                if kind == "float"
                    result = 1
                else
                    if kind == "list"
                        result = 1
    result

// ── Public: top-level TOML document serialiser ───────────────────────────────

// tw_write: serialise a NOVA dict to a TOML document string.
//
// Algorithm:
//   Pass 1 — emit all scalar key/value pairs (sorted keys).
//   Pass 2 — emit all dict-valued key/value pairs as "[section]\n..." blocks
//             (sorted keys).  Values inside each section are limited to
//             scalars (one level of section nesting); deeper dicts are emitted
//             as TOML inline tables via tw_write_value.
//
// Each "key = value" line is followed by a newline.  Sections are preceded
// by a blank line (except the first one when no scalars were emitted, handled
// by tracking whether any output has been written).
fn tw_write(d) -> string
    let ks = sort(keys(d))
    let n = len(ks)
    let out = ""
    // Pass 1: scalar keys
    for i in 0..n
        let k = ks[i]
        let v = d[k]
        if _tw_is_scalar(v) == 1
            out += k + " = " + tw_write_value(v) + chr(10)
    // Pass 2: section (dict) keys
    for j in 0..n
        let k2 = ks[j]
        let v2 = d[k2]
        if type_of(v2) == "dict"
            // blank line separator before each section
            if len(out) > 0
                out += chr(10)
            out += "[" + k2 + "]" + chr(10)
            let sks = sort(keys(v2))
            let sn = len(sks)
            let si = 0
            while si < sn
                let sk = sks[si]
                let sv = v2[sk]
                out += sk + " = " + tw_write_value(sv) + chr(10)
                si += 1
    out
