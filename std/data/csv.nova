// ============================================================================
// NOVA Standard Library — std/data/csv
// ============================================================================
// RFC 4180 CSV parse + write: the base row-list<->text codec that the other
// std/data/csv* modules (csvdict, csvsniff, csvschema, csvpivot) build on top
// of at a higher level (header-keyed dicts, dialect sniffing, schema
// validation, pivoting). This module stays at the raw list-of-list-of-fields
// level — no header handling, no dialect guessing.
//
// PUBLIC API:
//   csv_parse(text) -> list
//     Parse a whole CSV document into a list of rows; each row is a list of
//     string fields. Handles: double-quoted fields, commas embedded inside a
//     quoted field, newlines (LF or CRLF) embedded inside a quoted field, an
//     escaped quote "" -> a literal " inside a quoted field, both CRLF and
//     lone-LF row terminators, and a trailing newline at end-of-document
//     (does NOT produce a spurious empty trailing row). A field is quoted
//     only when its first character is a double-quote; a stray quote
//     elsewhere in an unquoted field is kept literally. An empty document
//     ("") parses to [].
//
//   csv_write(rows) -> string
//     Serialize a list of rows (each a list of string fields) to CSV text.
//     Any field containing a comma, a double-quote, a CR, or an LF is
//     wrapped in double-quotes with internal double-quotes doubled. Rows are
//     joined with LF; no trailing newline is appended.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - Parser is a single char-by-char state machine over the whole document
//     (not split-by-line first) — that is what lets a quoted field legally
//     contain the row-terminator characters without ending the row early.
//   - Writer output uses LF row separators (not CRLF); csv_parse accepts
//     both, so csv_parse(csv_write(csv_parse(t))) round-trips regardless of
//     which terminator the original text used.
// ============================================================================

// Parse a whole CSV document into a list of rows; each row is a list of
// string fields. See module doc for the exact quoting/newline rules handled.
//
// Scans the document as BYTES (str_to_bytes + bytes_get), not by indexing
// the string with char_at() in the scan loop: char_at(text, i) is a UTF-8
// codepoint lookup that rescans from byte 0 on every call (there is no O(1)
// random access into a UTF-8 string by codepoint index), so calling it for
// i = 0..n in a loop is O(n) per call = O(n^2) total over the whole
// document — independent of and in addition to the O(n^2) risk from naive
// string-concatenation. bytes_get is a direct O(1) array index. This is
// safe: every CSV structural byte (comma/quote/CR/LF) is single-byte ASCII
// (<0x80), and UTF-8 continuation/lead bytes are always >=0x80, so a
// byte-level scan can never mistake part of a multi-byte character for a
// delimiter, and a field's accumulated bytes reassemble as the exact
// original (possibly multi-byte) UTF-8 text — this also fixes a latent
// correctness bug where the old char_at-based loop bounded the scan by
// len(text) (BYTE length) while indexing by CODEPOINT, over-running past
// the last real codepoint for any non-ASCII input and injecting a stray
// NUL byte (char_at OOB -> "" -> ord("") == 0) into the field.
//
// Field text is accumulated in a NovaBuffer (O(1)-amortized append) rather
// than by repeated string concatenation (`field = field + c`), which would
// be O(field-length^2) per field — a real hang/DoS on a single large field
// (e.g. an embedded text blob), not just on adversarial input.
fn csv_parse(text: string) -> list
    let quote = 34
    let comma_ch = 44
    let lf = 10
    let cr = 13
    let bts = str_to_bytes(text)
    let buf = buffer()
    let row = []
    let rows = []
    let in_quotes = false
    // Tracks "has any character of the row/field currently being built been
    // consumed since the last completed row" — reset on every LF-terminated
    // row. len(field)>0 / len(row)>0 alone under-report this: a fully closed
    // EMPTY quoted field (e.g. the 2-char document `""`) leaves buf empty and
    // row empty too, so without this flag the trailing flush below would
    // silently drop that (perfectly valid) row instead of emitting [[""]].
    let saw_char = false
    let i = 0
    let n = bytes_len(bts)
    while i < n
        let c = bytes_get(bts, i)
        saw_char = true
        if in_quotes
            if c == quote
                if i + 1 < n and bytes_get(bts, i + 1) == quote
                    // Escaped quote "" inside a quoted field -> literal ".
                    buf_append_char(buf, quote)
                    i += 2
                else
                    // Closing quote.
                    in_quotes = false
                    i += 1
            else
                // Any other byte (including embedded , CR, LF) is kept literally.
                buf_append_char(buf, c)
                i += 1
        else
            if c == quote and buf_len(buf) == 0
                // A field is quoted only when the quote is its very first character.
                in_quotes = true
                i += 1
            else
                if c == comma_ch
                    push(row, buf_to_str(buf))
                    buf = buffer()
                    i += 1
                else
                    if c == cr
                        // Drop a bare CR; if it is part of CRLF the following LF ends the row.
                        i += 1
                    else
                        if c == lf
                            push(row, buf_to_str(buf))
                            buf = buffer()
                            push(rows, row)
                            row = []
                            saw_char = false
                            i += 1
                        else
                            buf_append_char(buf, c)
                            i += 1
    // Flush a trailing field/row that was not terminated by a final newline.
    if buf_len(buf) > 0 or len(row) > 0 or saw_char
        push(row, buf_to_str(buf))
        push(rows, row)
    rows

// Quote one field for CSV output if it needs it (contains a comma, a
// double-quote, a CR, or an LF); internal double-quotes are doubled.
// Scans via str_to_bytes/bytes_get (O(1) random access) rather than
// char_at (O(index) UTF-8 rescan-from-0 per call — see csv_parse's doc
// comment for why that is O(n^2) on its own), and builds the escaped
// output in a NovaBuffer instead of by repeated string concatenation
// (`inner = inner + ch`), which is O(field-length^2) and triggers on any
// field that merely contains a comma — common in real data (e.g. free-text
// cells).
fn _csv_escape_field(val: string) -> string
    let bts = str_to_bytes(val)
    let n = bytes_len(bts)
    let needs_quote = false
    for i in 0..n
        let code = bytes_get(bts, i)
        if code == 44 or code == 34 or code == 13 or code == 10
            needs_quote = true
    let result = val
    if needs_quote
        let buf = buffer()
        buf_append_char(buf, 34)
        for j in 0..n
            let code2 = bytes_get(bts, j)
            if code2 == 34
                buf_append_char(buf, 34)
                buf_append_char(buf, 34)
            else
                buf_append_char(buf, code2)
        buf_append_char(buf, 34)
        result = buf_to_str(buf)
    result

// Serialize a list of rows (each a list of string fields) to CSV text.
// Rows are LF-joined; no trailing newline.
// Uses a NovaBuffer for the whole document instead of repeated string
// concatenation (`result = result + ...`), which is O(row-count^2) — a
// document with many rows (a very ordinary shape for CSV) would otherwise
// re-copy the entire output built so far on every single row.
fn csv_write(rows: list) -> string
    let buf = buffer()
    let nr = len(rows)
    for r in 0..nr
        if r > 0
            buf_append_char(buf, 10)
        let row = rows[r]
        let nf = len(row)
        for j in 0..nf
            if j > 0
                buf_append_char(buf, 44)
            buf_append(buf, _csv_escape_field(row[j]))
    buf_to_str(buf)
