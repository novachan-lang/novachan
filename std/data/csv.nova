// ============================================================================
// NOVA Standard Library — std/data/csv
// ============================================================================
// RFC 4180 CSV parse + write: the base row-list<->text codec that the other
// std/data/csv* modules (csvdict, csvsniff, csvschema, csvpivot) build on top
// of at a higher level (header-keyed dicts, dialect sniffing, schema
// validation, pivoting). This module stays at the raw list-of-list-of-fields
// level — no header handling, no dialect guessing.
//
// PUBLIC API:
//   csv_parse(text) -> list
//     Parse a whole CSV document into a list of rows; each row is a list of
//     string fields. Handles: double-quoted fields, commas embedded inside a
//     quoted field, newlines (LF or CRLF) embedded inside a quoted field, an
//     escaped quote "" -> a literal " inside a quoted field, both CRLF and
//     lone-LF row terminators, and a trailing newline at end-of-document
//     (does NOT produce a spurious empty trailing row). A field is quoted
//     only when its first character is a double-quote; a stray quote
//     elsewhere in an unquoted field is kept literally. An empty document
//     ("") parses to [].
//
//   csv_write(rows) -> string
//     Serialize a list of rows (each a list of string fields) to CSV text.
//     Any field containing a comma, a double-quote, a CR, or an LF is
//     wrapped in double-quotes with internal double-quotes doubled. Rows are
//     joined with LF; no trailing newline is appended.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - Parser is a single char-by-char state machine over the whole document
//     (not split-by-line first) — that is what lets a quoted field legally
//     contain the row-terminator characters without ending the row early.
//   - Writer output uses LF row separators (not CRLF); csv_parse accepts
//     both, so csv_parse(csv_write(csv_parse(t))) round-trips regardless of
//     which terminator the original text used.
// ============================================================================

// Parse a whole CSV document into a list of rows; each row is a list of
// string fields. See module doc for the exact quoting/newline rules handled.
fn csv_parse(text: string) -> list
    let quote = chr(34)
    let comma_ch = chr(44)
    let lf = chr(10)
    let cr = chr(13)
    let field = ""
    let row = []
    let rows = []
    let in_quotes = false
    let i = 0
    let n = len(text)
    while i < n
        let c = char_at(text, i)
        if in_quotes
            if c == quote
                if i + 1 < n and char_at(text, i + 1) == quote
                    // Escaped quote "" inside a quoted field -> literal ".
                    field = field + quote
                    i = i + 2
                else
                    // Closing quote.
                    in_quotes = false
                    i = i + 1
            else
                // Any other character (including embedded , CR, LF) is kept literally.
                field = field + c
                i = i + 1
        else
            if c == quote and field == ""
                // A field is quoted only when the quote is its very first character.
                in_quotes = true
                i = i + 1
            else
                if c == comma_ch
                    push(row, field)
                    field = ""
                    i = i + 1
                else
                    if c == cr
                        // Drop a bare CR; if it is part of CRLF the following LF ends the row.
                        i = i + 1
                    else
                        if c == lf
                            push(row, field)
                            push(rows, row)
                            field = ""
                            row = []
                            i = i + 1
                        else
                            field = field + c
                            i = i + 1
    // Flush a trailing field/row that was not terminated by a final newline.
    if len(field) > 0 or len(row) > 0
        push(row, field)
        push(rows, row)
    rows

// Quote one field for CSV output if it needs it (contains a comma, a
// double-quote, a CR, or an LF); internal double-quotes are doubled.
fn _csv_escape_field(val: string) -> string
    let needs_quote = false
    let n = len(val)
    let i = 0
    while i < n
        let code = ord(char_at(val, i))
        if code == 44 or code == 34 or code == 13 or code == 10
            needs_quote = true
        i = i + 1
    let result = val
    if needs_quote
        let inner = ""
        let j = 0
        while j < n
            let ch = char_at(val, j)
            if ord(ch) == 34
                inner = inner + chr(34) + chr(34)
            else
                inner = inner + ch
            j = j + 1
        result = chr(34) + inner + chr(34)
    result

// Serialize a list of rows (each a list of string fields) to CSV text.
// Rows are LF-joined; no trailing newline.
fn csv_write(rows: list) -> string
    let result = ""
    let nr = len(rows)
    let r = 0
    while r < nr
        let row = rows[r]
        let nf = len(row)
        let line = ""
        let j = 0
        while j < nf
            let f = _csv_escape_field(row[j])
            if j == 0
                line = f
            else
                line = line + chr(44) + f
            j = j + 1
        if r == 0
            result = line
        else
            result = result + chr(10) + line
        r = r + 1
    result
