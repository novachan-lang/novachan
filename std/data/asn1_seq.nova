// ============================================================================
// NOVA Standard Library — std/data/asn1_seq
// ============================================================================
// ASN.1 DER SEQUENCE (tag 0x30) and SET (tag 0x31) encoder/decoder.
//
// SEQUENCE and SET are CONSTRUCTED types: their content is the concatenation
// of zero or more already-encoded child TLVs.  DER requires:
//   - SEQUENCE preserves the order of children.
//   - SET children are in canonical order (DER); this module accepts any order
//     for encoding (caller responsibility for canonical SET order).
//   - Both use the standard DER length encoding (minimal form).
//
// PUBLIC API:
//   asn1_seq_encode(children: list) -> bytes
//     Wrap a list of already-encoded child TLV bytes values in a SEQUENCE.
//     Tag = 0x30, content = concatenation of all children.
//     Length uses minimal DER form (short if <=127, long 0x81/0x82 otherwise).
//
//   asn1_set_encode(children: list) -> bytes
//     Same as asn1_seq_encode but tag = 0x31 (SET).
//
//   asn1_seq_decode(b: bytes, pos: int) -> list
//     Decode one SEQUENCE TLV beginning at byte offset pos in b.
//     Returns [child_list, next_pos] where:
//       child_list  = list of bytes values, each a complete child TLV slice.
//       next_pos    = first byte after this SEQUENCE's content.
//     On any error (wrong tag, truncated length, truncated content, truncated
//     child) returns [[], -1].
//     Accepts tag 0x30 only; does NOT accept 0x31 (use asn1_set_decode if needed).
//
//   asn1_set_decode(b: bytes, pos: int) -> list
//     Same as asn1_seq_decode but accepts tag 0x31 (SET).
//
// PRIVATE helpers:
//   _asn1s_tlv(tag, content)        — prepend tag + DER length to content
//   _asn1s_concat(children)         — concatenate a list of bytes values
//   _asn1s_read_length(b, pos)      — [length, next_pos] or [-1,-1] on error
//   _asn1s_child_len(b, cpos, end)  — byte-length of one child TLV at cpos
//   _asn1s_split_children(b, cpos, end) — split content into child TLV slices
//
// DESIGN NOTES:
//   - Leaf module — imports nothing.
//   - Every byte read is bounds-checked; malformed input returns safe sentinels.
//   - Single-exit style throughout to avoid return-null mistag.
//   - bytes_append returns a NEW bytes value — always reassigned.
//   - push(list, x) mutates in place — called as a statement only.
//   - bytes_slice(b, s, e) returns bytes from index s up to (not including) e.
//
// KAT vectors (X.690 / RFC 5280 verified):
//   i1 = bytes [0x02,0x01,0x01], i2 = bytes [0x02,0x01,0x02]
//   asn1_seq_encode([i1, i2]) == [0x30,0x06,0x02,0x01,0x01,0x02,0x01,0x02]
//   asn1_set_encode([i1])     == [0x31,0x03,0x02,0x01,0x01]
//   Nested: asn1_seq_encode([asn1_seq_encode([i1])]) == [0x30,0x05,0x30,0x03,0x02,0x01,0x01]
//   asn1_seq_decode(asn1_seq_encode([i1,i2]), 0) == [[i1_bytes, i2_bytes], 8]
//   Long-length: SEQUENCE with 200-byte content -> [0x30, 0x81, 0xC8, ...200 bytes...]
// ============================================================================

// _asn1s_concat: concatenate a list of bytes values into one bytes value.
// Returns empty bytes if children is empty.
fn _asn1s_concat(children: list) -> any
    let out = bytes(0)
    let n = len(children)
    let i = 0
    while i < n
        out = bytes_concat(out, children[i])
        i = i + 1
    out

// _asn1s_tlv: build a TLV by prepending tag + DER length to content.
//
// DER length encoding (X.690 §8.1.3, minimal):
//   0..127   — short form: one byte = len
//   128..255 — long form: 0x81 then one byte
//   256..65535 — long form: 0x82 then two bytes (hi, lo)
// Values >65535 would need 0x83+ but are unreachable for in-memory structures.
fn _asn1s_tlv(tag: int, content: any) -> any
    let clen = bytes_len(content)
    let out = bytes(0)
    out = bytes_append(out, tag)
    if clen < 128
        out = bytes_append(out, clen)
    else
        if clen < 256
            out = bytes_append(out, 129)
            out = bytes_append(out, clen)
        else
            let hi = clen / 256
            let lo = clen % 256
            out = bytes_append(out, 130)
            out = bytes_append(out, hi)
            out = bytes_append(out, lo)
    out = bytes_concat(out, content)
    out

// asn1_seq_encode: DER-encode a list of child TLV bytes as a SEQUENCE (0x30).
fn asn1_seq_encode(children: list) -> any
    let body = _asn1s_concat(children)
    _asn1s_tlv(48, body)

// asn1_set_encode: DER-encode a list of child TLV bytes as a SET (0x31).
fn asn1_set_encode(children: list) -> any
    let body = _asn1s_concat(children)
    _asn1s_tlv(49, body)

// _asn1s_read_length: decode DER length field from b starting at pos.
// Returns [decoded_length, next_pos_after_length] or [-1,-1] on error.
// Handles short form and long form (k=1..4 sub-bytes; k=0 = indefinite = reject).
fn _asn1s_read_length(b: any, pos: int) -> any
    let blen = bytes_len(b)
    let result = [-1, -1]
    if pos >= 0
        if pos < blen
            let first = bytes_get(b, pos)
            if first < 128
                result = [first, pos + 1]
            else
                let k = first & 0x7F
                if k == 0
                    // indefinite form — reject in DER
                    result = [-1, -1]
                else
                    if k > 4
                        // unreasonably large — reject
                        result = [-1, -1]
                    else
                        // need pos + k bytes after pos
                        if pos + k < blen
                            let acc = 0
                            let j = 0
                            while j < k
                                let bv = bytes_get(b, pos + 1 + j)
                                acc = acc * 256 + bv
                                j = j + 1
                            result = [acc, pos + 1 + k]
    result

// _asn1s_child_len: compute the total byte-length of ONE child TLV at cpos.
// Returns the number of bytes the child occupies (tag + length-field + content),
// or -1 if the child is malformed or truncated before cpos+end.
// cpos must be < end, and end must be <= bytes_len(b).
fn _asn1s_child_len(b: any, cpos: int, end: int) -> int
    let result = -1
    // need at least 2 bytes: tag + first-length-byte
    if cpos + 1 < end
        let lr = _asn1s_read_length(b, cpos + 1)
        let clen = lr[0]
        let vpos = lr[1]
        if clen >= 0 and vpos >= 0
            let child_end = vpos + clen
            if child_end <= end
                result = child_end - cpos
    result

// _asn1s_split_children: walk the content bytes b[cpos..end) and return
// a list of bytes slices, one per child TLV.  Returns [] on any error.
fn _asn1s_split_children(b: any, cpos: int, end: int) -> any
    let kids = []
    let cursor = cpos
    let ok = 1
    while cursor < end and ok == 1
        let clen = _asn1s_child_len(b, cursor, end)
        if clen < 0
            ok = 0
        else
            let slice = bytes_slice(b, cursor, cursor + clen)
            push(kids, slice)
            cursor = cursor + clen
    if ok == 0
        kids = []
    kids

// asn1_seq_decode: decode one SEQUENCE TLV beginning at byte offset pos in b.
// Returns [child_list, next_pos] or [[], -1] on any error.
// Only accepts tag 0x30 (SEQUENCE); rejects 0x31 and all others.
fn asn1_seq_decode(b: any, pos: int) -> any
    let blen = bytes_len(b)
    let result = [[], -1]
    // need at least tag + 1 length byte
    if pos >= 0
        if pos + 1 < blen
            let tag = bytes_get(b, pos)
            if tag == 48
                let lr = _asn1s_read_length(b, pos + 1)
                let clen = lr[0]
                let cpos = lr[1]
                if clen >= 0 and cpos >= 0
                    let content_end = cpos + clen
                    if content_end <= blen
                        let kids = _asn1s_split_children(b, cpos, content_end)
                        result = [kids, content_end]
    result

// asn1_set_decode: decode one SET TLV beginning at byte offset pos in b.
// Returns [child_list, next_pos] or [[], -1] on any error.
// Only accepts tag 0x31 (SET).
fn asn1_set_decode(b: any, pos: int) -> any
    let blen = bytes_len(b)
    let result = [[], -1]
    if pos >= 0
        if pos + 1 < blen
            let tag = bytes_get(b, pos)
            if tag == 49
                let lr = _asn1s_read_length(b, pos + 1)
                let clen = lr[0]
                let cpos = lr[1]
                if clen >= 0 and cpos >= 0
                    let content_end = cpos + clen
                    if content_end <= blen
                        let kids = _asn1s_split_children(b, cpos, content_end)
                        result = [kids, content_end]
    result
