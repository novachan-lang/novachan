// ============================================================================
// NOVA Standard Library — std/data/edn
// ============================================================================
// EDN (Extensible Data Notation, used by Clojure) subset parser and writer.
//
// Supported EDN types and their NOVA mapping:
//   nil             -> null
//   integer         -> int   (decimal, optional leading -)
//   double-quoted   -> string
//   keyword  :kw   -> string (the name without the colon, e.g. "kw")
//   vector  [a b]  -> list
//   map     {k v}  -> dict  (keys coerced to string via ed_write)
//   symbol          -> string (bare word, e.g. "true"/"false" are strings here)
//
// Whitespace AND commas act as separators (EDN spec §3.1).
//
// PUBLIC API
//   ed_parse(s)   -> any     parse an EDN string to a NOVA value
//   ed_write(v)   -> string  serialise a NOVA value to EDN string
//
// EXAMPLES
//   ed_parse("42")              -> 42
//   ed_parse("nil")             -> null
//   ed_parse("\"hi\"")         -> "hi"
//   ed_parse(":name")           -> "name"
//   ed_parse("[1 2 3]")         -> [1, 2, 3]
//   ed_parse("[1 [2 3]]")       -> [1, [2, 3]]
//   ed_parse("[]")              -> []
//   ed_parse("{:a 1 :b 2}")     -> {"a": 1, "b": 2}
//   ed_write([1, 2, 3])        -> "[1 2 3]"
//   ed_write(42)               -> "42"
//   ed_write(null)             -> "nil"
//   ed_write("hello")          -> "\"hello\""
//   ed_write({"a": 1})         -> "{\"a\" 1}"
//
// IMPLEMENTATION NOTES
//   • All private helpers prefixed _edn_ to avoid symbol collisions.
//   • Mutable cursor threaded as dict {"pos": int} — idiomatic NOVA pattern.
//   • Single-exit style throughout to avoid the NOVA early-return mistag bug.
//   • No multi-line list/dict literals (NOVA parser limitation).
//   • chr(34)='"', chr(123)='{', chr(125)='}', chr(91)='[', chr(93)=']'.
//   • LEAF module — imports nothing.
// ============================================================================

// ── Character utilities ──────────────────────────────────────────────────────

// _edn_is_sep: 1 if code-point o is an EDN separator (whitespace or comma).
fn _edn_is_sep(o)
    1 if o in [32, 9, 10, 13, 44] else 0

// _edn_is_digit: 1 if code-point o is 0-9.
fn _edn_is_digit(o)
    1 if o >= 48 and o <= 57 else 0

// _edn_skip_sep: advance st["pos"] past separators.
fn _edn_skip_sep(s, n, st)
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = ord(char_at(s, p))
            if _edn_is_sep(o) == 1
                st["pos"] = p + 1
            else
                go = 0

// ── Number parsing ───────────────────────────────────────────────────────────

// _edn_parse_int: parse a decimal integer (with optional leading '-') starting
// at st["pos"]. Returns the integer value and advances pos.
fn _edn_parse_int(s, n, st)
    let neg = 0
    let p = st["pos"]
    if p < n
        let fc = ord(char_at(s, p))
        if fc == 45
            neg = 1
            st["pos"] = p + 1
    let acc = 0
    let go = 1
    while go == 1
        let q = st["pos"]
        if q >= n
            go = 0
        else
            let o = ord(char_at(s, q))
            if _edn_is_digit(o) == 1
                acc = acc * 10 + (o - 48)
                st["pos"] = q + 1
            else
                go = 0
    let result = acc
    if neg == 1
        result = -acc
    return result

// ── String parsing ───────────────────────────────────────────────────────────

// _edn_parse_string: parse a double-quoted EDN string starting AFTER the
// opening '"'. Handles \" and \\ escapes. Returns the string value.
fn _edn_parse_string(s, n, st)
    let buf = ""
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let ch = char_at(s, p)
            let o = ord(ch)
            if o == 34
                // closing '"'
                st["pos"] = p + 1
                go = 0
            else if o == 92
                // backslash escape
                st["pos"] = p + 1
                let q = st["pos"]
                if q < n
                    let ec = char_at(s, q)
                    let eo = ord(ec)
                    st["pos"] = q + 1
                    if eo == 110
                        buf += chr(10)
                    else if eo == 116
                        buf += chr(9)
                    else if eo == 114
                        buf += chr(13)
                    else
                        buf += ec
            else
                buf += ch
                st["pos"] = p + 1
    return buf

// ── Symbol / atom reading ────────────────────────────────────────────────────

// _edn_is_atom_end: 1 if the code point ends a bare atom (sep, bracket, brace).
fn _edn_is_atom_end(o)
    // '[' 91, ']' 93, '{' 123, '}' 125
    1 if (_edn_is_sep(o) == 1 or o in [91, 93, 123, 125]) else 0

// _edn_read_atom: read a bare atom token (symbol/keyword body).
fn _edn_read_atom(s, n, st)
    let buf_parts = []
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let ch = char_at(s, p)
            let o = ord(ch)
            if _edn_is_atom_end(o) == 1
                go = 0
            else
                push(buf_parts, ch)
                st["pos"] = p + 1
    let buf = join(buf_parts, "")
    return buf

// ── Vector parsing ───────────────────────────────────────────────────────────

// _edn_parse_vector: parse elements until ']'. Returns a list.
// Forward declaration handled by mutual recursion via _edn_parse_value.
fn _edn_parse_vector(s, n, st)
    let result = []
    let go = 1
    while go == 1
        _edn_skip_sep(s, n, st)
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = ord(char_at(s, p))
            if o == 93
                // ']'
                st["pos"] = p + 1
                go = 0
            else
                let elem = _edn_parse_value(s, n, st)
                result.push(elem)
    return result

// ── Map parsing ──────────────────────────────────────────────────────────────

// _edn_parse_map: parse key-value pairs until '}'. Returns a dict.
fn _edn_parse_map(s, n, st)
    let result = {}
    let go = 1
    while go == 1
        _edn_skip_sep(s, n, st)
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = ord(char_at(s, p))
            if o == 125
                // '}'
                st["pos"] = p + 1
                go = 0
            else
                let k = _edn_parse_value(s, n, st)
                let ks = ed_write(k)
                _edn_skip_sep(s, n, st)
                let v = _edn_parse_value(s, n, st)
                result[ks] = v
    return result

// ── Core value parser ────────────────────────────────────────────────────────

// _edn_parse_value: parse a single EDN value at the current position.
// Dispatches on the first character.
fn _edn_parse_value(s, n, st)
    _edn_skip_sep(s, n, st)
    let result = null
    let p = st["pos"]
    if p < n
        let ch = char_at(s, p)
        let o = ord(ch)
        if o == 91
            // '[' -> vector
            st["pos"] = p + 1
            result = _edn_parse_vector(s, n, st)
        else
            if o == 123
                // '{' -> map
                st["pos"] = p + 1
                result = _edn_parse_map(s, n, st)
            else
                if o == 34
                    // '"' -> string
                    st["pos"] = p + 1
                    result = _edn_parse_string(s, n, st)
                else
                    if o == 58
                        // ':' -> keyword; skip colon, read atom body as string
                        st["pos"] = p + 1
                        result = _edn_read_atom(s, n, st)
                    else
                        if o == 45
                            // '-' could be negative integer
                            let q = p + 1
                            let is_neg_int = 0
                            if q < n
                                let no = ord(char_at(s, q))
                                if _edn_is_digit(no) == 1
                                    is_neg_int = 1
                            if is_neg_int == 1
                                result = _edn_parse_int(s, n, st)
                            else
                                result = _edn_read_atom(s, n, st)
                        else
                            if _edn_is_digit(o) == 1
                                // integer
                                result = _edn_parse_int(s, n, st)
                            else
                                // symbol: read bare atom, check for nil/true/false
                                let atom = _edn_read_atom(s, n, st)
                                if atom == "nil"
                                    result = null
                                else
                                    result = atom
    return result

// ── Public API ───────────────────────────────────────────────────────────────

// ed_parse: parse an EDN string into a NOVA value.
//
// Examples:
//   ed_parse("42")         -> 42
//   ed_parse("nil")        -> null
//   ed_parse("\"hi\"")    -> "hi"
//   ed_parse(":name")      -> "name"
//   ed_parse("[1 2 3]")    -> [1, 2, 3]
//   ed_parse("{:a 1}")     -> {"a": 1}
fn ed_parse(s) -> any
    let n = len(s)
    let st = {}
    st["pos"] = 0
    let result = _edn_parse_value(s, n, st)
    return result

// ed_write: serialise a NOVA value to an EDN string.
//
// Mapping:
//   null   -> "nil"
//   int    -> decimal digits
//   string -> double-quoted with \" and \\ escapes
//   list   -> "[e1 e2 ... eN]"
//   dict   -> "{k1 v1 k2 v2 ...}"  (keys written as strings)
//
// Examples:
//   ed_write(null)          -> "nil"
//   ed_write(42)            -> "42"
//   ed_write("hello")       -> "\"hello\""
//   ed_write([1, 2, 3])     -> "[1 2 3]"
//   ed_write({"a": 1})      -> "{\"a\" 1}"
fn ed_write(v) -> string
    let result = ""
    let t = type_of(v)
    if v == null
        result = "nil"
    else if t == "int"
        result = str(v)
    else if t == "float"
        result = str(v)
    else if t == "string"
        // Escape backslash and double-quote; wrap in quotes.
        let sq = chr(34)
        let bs = chr(92)
        let inner = ""
        let n = len(v)
        for i in 0..n
            let ch = char_at(v, i)
            let o = ord(ch)
            if o == 92
                inner += bs + bs
            else if o == 34
                inner += bs + sq
            else if o == 10
                inner += bs + "n"
            else if o == 9
                inner += bs + "t"
            else
                inner += ch
        result = sq + inner + sq
    else if t == "list"
        let parts = [ed_write(x) for x in v]
        result = "[" + join(parts, " ") + "]"
    else if t == "dict"
        let ks = keys(v)
        let parts = [ed_write(k) + " " + ed_write(v[k]) for k in ks]
        let ob = chr(123)
        let cb = chr(125)
        result = ob + join(parts, " ") + cb
    else
        result = str(v)
    return result
