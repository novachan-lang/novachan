// ============================================================================
// NOVA Standard Library — std/data/sub_merge
// ============================================================================
// Subtitle cue merge / concat / dedup operations.
//
// CUE SHAPE: dict {"index":int, "start":ms, "end":ms, "text":string}
//   ms values are integers (milliseconds from start of media).
//
// PUBLIC API:
//   sub_concat(a, b) -> list
//     Concatenate two cue lists into a single new list.
//     Cues from a come first, then cues from b.  No sorting or dedup.
//
//   sub_merge_overlaps(cues) -> list
//     Merge overlapping or touching cues.  Two cues overlap/touch when
//     the earlier cue's end >= the later cue's start.
//     The merged cue spans min(start)..max(end); its text is the texts of
//     all constituent cues joined by chr(10).  Index is reassigned
//     sequentially (0, 1, 2, …).
//     Input is assumed pre-sorted by start ms (stable, per SRT/VTT spec).
//
//   sub_merge_sorted(a, b) -> list
//     Merge two cue lists, EACH ALREADY SORTED by "start" ascending, into
//     one chronologically-ordered list (classic sorted merge, like the
//     merge step of mergesort). On a tie (equal start), the cue from `a`
//     is placed first. Overlapping cues are NOT combined — this is a pure
//     interleave-by-time; pipe the result through sub_merge_overlaps if
//     combining overlaps is also wanted. Index is reassigned sequentially
//     (0, 1, 2, …) in the merged output. Neither input list is mutated.
//
//   sub_dedup(cues) -> list
//     Remove consecutive duplicate cues.  Two adjacent cues are
//     duplicates when start, end, AND text are all equal.
//     Non-consecutive duplicates are kept.  Index is reassigned
//     sequentially after removal.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - All helpers are _prefix (private).
//   - Single-exit style throughout.
//   - No multi-line list/dict literals.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// Build a cue dict from raw fields (avoids repeated literal construction).
fn _sm_cue(idx, s, e, txt) -> dict
    let d = {}
    d["index"] = idx
    d["start"] = s
    d["end"] = e
    d["text"] = txt
    d

// max of two ints
fn _sm_max(a, b) -> int
    let r = a
    if b > a
        r = b
    r

// ── Public API ───────────────────────────────────────────────────────────────

// sub_concat: join two cue lists end-to-end.
fn sub_concat(a, b) -> list
    let result = []
    let na = len(a)
    for i in 0..na
        result.push(a[i])
    let nb = len(b)
    for j in 0..nb
        result.push(b[j])
    result

// sub_merge_sorted: two-pointer merge of two start-sorted cue lists into one
// chronological list. O(len(a)+len(b)); a real while-loop merge (not a
// concat-then-sort), matching the mergesort merge step. Ties keep `a`
// before `b`.
fn sub_merge_sorted(a, b) -> list
    let result = []
    let na = len(a)
    let nb = len(b)
    let i = 0
    let j = 0
    let out_idx = 0
    while i < na and j < nb
        let ca = a[i]
        let cb = b[j]
        if ca["start"] <= cb["start"]
            result.push(_sm_cue(out_idx, ca["start"], ca["end"], ca["text"]))
            i = i + 1
        else
            result.push(_sm_cue(out_idx, cb["start"], cb["end"], cb["text"]))
            j = j + 1
        out_idx = out_idx + 1
    while i < na
        let ca = a[i]
        result.push(_sm_cue(out_idx, ca["start"], ca["end"], ca["text"]))
        i = i + 1
        out_idx = out_idx + 1
    while j < nb
        let cb = b[j]
        result.push(_sm_cue(out_idx, cb["start"], cb["end"], cb["text"]))
        j = j + 1
        out_idx = out_idx + 1
    result

// sub_merge_overlaps: merge touching/overlapping cues (input sorted by start).
//
// Algorithm:
//   Maintain a running "current merge window" (cur_s, cur_e, cur_txt).
//   For each subsequent cue:
//     - If cue.start <= cur_e  → overlap/touch → extend window and append text.
//     - Else → flush window as a new output cue, start fresh window.
//   After the loop, flush the last window.
fn sub_merge_overlaps(cues) -> list
    let result = []
    let n = len(cues)
    if n == 0
        result
    else
        let first = cues[0]
        let cur_s = first["start"]
        let cur_e = first["end"]
        let cur_txt = first["text"]
        let out_idx = 0
        for i in 1..n
            let cue = cues[i]
            let cs = cue["start"]
            let ce = cue["end"]
            let ct = cue["text"]
            if cs <= cur_e
                // Overlap or touch: extend.
                cur_e = _sm_max(cur_e, ce)
                cur_txt = cur_txt + chr(10) + ct
            else
                // Gap: flush current window.
                let merged = _sm_cue(out_idx, cur_s, cur_e, cur_txt)
                result.push(merged)
                out_idx = out_idx + 1
                cur_s = cs
                cur_e = ce
                cur_txt = ct
        // Flush final window.
        let last_merged = _sm_cue(out_idx, cur_s, cur_e, cur_txt)
        result.push(last_merged)
        result

// sub_dedup: remove consecutive duplicate cues (same start, end, text).
//
// Algorithm:
//   Walk the list keeping a pointer to the last emitted cue.
//   Emit a cue only when it differs from the previous emitted cue.
//   Reassign index sequentially.
fn sub_dedup(cues) -> list
    let result = []
    let n = len(cues)
    if n == 0
        result
    else
        let first = cues[0]
        let out_idx = 0
        let prev = _sm_cue(out_idx, first["start"], first["end"], first["text"])
        result.push(prev)
        out_idx = out_idx + 1
        for i in 1..n
            let cue = cues[i]
            let cs = cue["start"]
            let ce = cue["end"]
            let ct = cue["text"]
            let ps = prev["start"]
            let pe = prev["end"]
            let pt = prev["text"]
            let is_dup = 0
            if cs == ps and ce == pe and ct == pt
                is_dup = 1
            if is_dup == 0
                let nc = _sm_cue(out_idx, cs, ce, ct)
                result.push(nc)
                prev = nc
                out_idx = out_idx + 1
        result
