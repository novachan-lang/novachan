// ============================================================================
// NOVA Standard Library — std/data/asn1_length
// ============================================================================
// DER length field codec (X.690 §8.1.3).
//
// PUBLIC API:
//   asn1_len_encode(n) -> bytes
//     Encode a non-negative integer n as a DER length field.
//     Short form (n <= 127): one byte equal to n.
//     Long form (n >= 128): first byte = 0x80 | k, where k is the number of
//     subsequent bytes; those bytes hold n in big-endian minimal form (no
//     leading zero bytes).  k is minimal — the smallest k such that n fits.
//     Examples:
//       asn1_len_encode(0)     -> [0x00]
//       asn1_len_encode(127)   -> [0x7F]
//       asn1_len_encode(128)   -> [0x81, 0x80]
//       asn1_len_encode(200)   -> [0x81, 0xC8]
//       asn1_len_encode(255)   -> [0x81, 0xFF]
//       asn1_len_encode(256)   -> [0x82, 0x01, 0x00]
//       asn1_len_encode(65535) -> [0x82, 0xFF, 0xFF]
//
//   asn1_len_decode(b, pos) -> list
//     Decode a DER length field from bytes b starting at offset pos.
//     Returns [length_int, next_pos] where next_pos is the first byte after
//     the length field (i.e. the start of the value content).
//     Short form: byte at pos < 0x80 → [byte, pos+1].
//     Long form:  byte at pos = 0x80|k → read k subsequent bytes as big-endian
//                 integer → [n, pos+1+k].
//     Indefinite form (byte == 0x80, k == 0): returns [-1, pos+1] (reject).
//     Bounds errors: returns [-1, pos] (malformed / truncated input).
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - Bounds-checked on EVERY byte read.
//   - Long-form k is restricted to 1..4 (lengths up to 2^32-1); k > 4 is
//     rejected as -1 (astronomically large; no legitimate DER structure needs
//     it and we avoid integer overflow in the accumulator).
//   - Single-exit style throughout to avoid return-null mistag.
// ============================================================================

// _asn1_len_be_bytes: encode positive integer n as minimal big-endian bytes.
// Returns a list of byte values (ints), MSB first, no leading zeros.
// Precondition: n > 0.
fn _asn1_len_be_bytes(n: int) -> any
    let limbs = []
    let remaining = n
    let done = 0
    while done == 0
        let b = remaining & 0xFF
        push(limbs, b)
        remaining = remaining / 256
        if remaining == 0
            done = 1
    // limbs is LSB-first; reverse into big-endian order
    let count = len(limbs)
    let out = bytes(0)
    let i = count - 1
    while i >= 0
        out = bytes_append(out, limbs[i])
        i = i - 1
    out

// asn1_len_encode: DER-encode a length value n >= 0.
fn asn1_len_encode(n: int) -> any
    let out = bytes(0)
    if n < 128
        out = bytes_append(out, n)
    else
        let be = _asn1_len_be_bytes(n)
        let k = bytes_len(be)
        out = bytes_append(out, 128 + k)
        out = bytes_concat(out, be)
    out

// asn1_len_decode: decode a DER length field from b at offset pos.
// Returns [length_int, next_pos].  On error returns [-1, pos].
fn asn1_len_decode(b: any, pos: int) -> any
    let total = bytes_len(b)
    let result = [-1, pos]
    if pos >= 0
        if pos < total
            let first = bytes_get(b, pos)
            if first < 128
                result = [first, pos + 1]
            else
                let k = first & 0x7F
                if k == 0
                    // indefinite form — reject
                    result = [-1, pos + 1]
                else
                    if k > 4
                        // unreasonably large; reject
                        result = [-1, pos]
                    else
                        if pos + k >= total
                            // truncated
                            result = [-1, pos]
                        else
                            let acc = 0
                            let j = 0
                            while j < k
                                let bv = bytes_get(b, pos + 1 + j)
                                acc = acc * 256 + bv
                                j = j + 1
                            result = [acc, pos + 1 + k]
    result
