// schema — validate a value against a simple type schema.
//
// A schema is a dict mapping field-name -> type-string.
// Supported type strings: "int" "float" "string" "bool" "list" "dict"
//
// Public API
//   sc_type_ok(v, typestr)      -> bool  (1 if type_of(v) matches typestr)
//   sc_validate(value, schema)  -> bool  (1 if all schema fields present and typed correctly)
//   sc_errors(value, schema)    -> list  (list of error strings describing failures)
//
// LEAF — imports NOTHING.

// _sc_type_name: normalise the NOVA runtime type_of string to our schema type string.
// type_of returns: "int", "float", "string", "bool", "list", "dict", "null", "struct", "any"
// We map "string" -> "string" (but "str" also accepted as alias for the typestr arg).
fn _sc_type_name(v)
    return type_of(v)

// sc_type_ok: return 1 if the runtime type of v matches typestr, 0 otherwise.
// Recognised typestr values: "int" "float" "string" "str" "bool" "list" "dict"
// "str" is accepted as an alias for "string" in the schema.
fn sc_type_ok(v, typestr)
    let actual = type_of(v)
    // normalise schema alias "str" -> "string"
    let want = typestr
    if want == "str"
        want = "string"
    if actual == want
        return 1
    return 0

// sc_validate: return 1 if value is a dict and every field in schema is present
// with a matching type.  Extra keys in value are allowed.
fn sc_validate(value, schema)
    // value must itself be a dict
    if type_of(value) != "dict"
        return 0
    let field_names = keys(schema)
    let n = len(field_names)
    let ok = 1
    let i = 0
    while i < n
        let field = field_names[i]
        if ok == 1
            // check presence
            if contains(value, field) == 0
                ok = 0
            else
                // check type
                let expected = schema[field]
                let actual_val = value[field]
                if sc_type_ok(actual_val, expected) == 0
                    ok = 0
        i = i + 1
    return ok

// sc_errors: return a list of human-readable error strings.
// Each missing field produces one error; each type mismatch produces one error.
// Returns [] when value passes schema validation.
fn sc_errors(value, schema)
    let errs = []
    // value must be a dict — if not, report that first and short-circuit
    if type_of(value) != "dict"
        errs.push("value is not a dict")
        return errs
    let field_names = keys(schema)
    let n = len(field_names)
    let i = 0
    while i < n
        let field = field_names[i]
        if contains(value, field) == 0
            errs.push("missing field: " + field)
        else
            let expected = schema[field]
            let actual_val = value[field]
            if sc_type_ok(actual_val, expected) == 0
                let actual_type = type_of(actual_val)
                errs.push("field " + field + ": expected " + expected + ", got " + actual_type)
        i = i + 1
    return errs
