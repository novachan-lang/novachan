// ============================================================================
// NOVA Standard Library — std/data/ndjson
// ============================================================================
// Newline-Delimited JSON (NDJSON / JSON Lines).
//
// Each non-empty line in an NDJSON document is a self-contained JSON value.
// Empty lines (and lines containing only whitespace) are silently skipped —
// this matches the NDJSON spec and is essential for files with trailing
// newlines.
//
// PUBLIC API:
//   nd_parse(text) -> list
//     Parse an NDJSON document.  Each non-empty line is passed to
//     json_parse; the resulting values are collected into a list.
//     Returns [] on empty input.
//
//   nd_stringify(values) -> string
//     Serialise a list of values to an NDJSON document.
//     Each value is converted with json_stringify and joined by chr(10).
//     Returns "" for an empty list.
//
//   nd_count(text) -> int
//     Count the number of non-empty lines in `text` without allocating
//     all parsed values.  Useful for quick cardinality checks on large
//     streams.
//
// DESIGN NOTES:
//   • Uses native json_parse / json_stringify — no hand-rolled JSON.
//   • Line splitting: split(text, chr(10)).  CRLF-terminated files will
//     leave a trailing chr(13) on each line.  We strip that by checking
//     whether the last character is chr(13) and slicing it off.
//   • The "non-empty" test is len(line) > 0 AFTER optional CR strip.
//   • Single-exit style throughout to avoid the NOVA return-null mistag.
//   • Module-level float constants would silently truncate to 0 — there
//     are none here (integer / string only).
//   • Brace interpolation hazard: chr(123)/chr(125) used where needed.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// Strip a trailing CR (chr(13)) from a line, if present.
// This lets nd_parse handle both LF-only and CRLF line endings.
fn _nd_strip_cr(line) -> string
    let result = line
    let n = len(line)
    if n > 0
        if ord(line[n - 1]) == 13
            result = slice(line, 0, n - 1)
    result

// Return 1 if `line` (after CR-stripping) is non-empty, else 0.
fn _nd_nonempty(line) -> int
    let trimmed = _nd_strip_cr(line)
    let result = 0
    if len(trimmed) > 0
        result = 1
    result

// ── Public API ───────────────────────────────────────────────────────────────

// nd_parse: parse an NDJSON text into a list of values.
//
// Algorithm:
//   1. Split on chr(10) (newline) to get candidate lines.
//   2. Strip a trailing chr(13) from each line (CRLF tolerance).
//   3. Skip empty lines.
//   4. Pass each non-empty line to json_parse and push the result.
//
// Returns an empty list for empty or all-blank input.
fn nd_parse(text) -> list
    let results = []
    let lines = split(text, chr(10))
    let i = 0
    let n = len(lines)
    while i < n
        let raw = lines[i]
        let line = _nd_strip_cr(raw)
        if len(line) > 0
            let val = json_parse(line)
            results.push(val)
        i += 1
    results

// nd_stringify: serialise a list of values to NDJSON text.
//
// Each element is json_stringified and joined with chr(10).
// An empty list produces an empty string (no trailing newline).
fn nd_stringify(values) -> string
    let n = len(values)
    let result = ""
    for i in 0..n
        let line = json_stringify(values[i])
        if i == 0
            result = line
        else
            result += chr(10) + line
    result

// nd_count: count non-empty lines in an NDJSON text.
//
// Equivalent to len(nd_parse(text)) but avoids allocating parsed values —
// useful for large streams where only the record count is needed.
fn nd_count(text) -> int
    let lines = split(text, chr(10))
    let count = 0
    let i = 0
    let n = len(lines)
    while i < n
        if _nd_nonempty(lines[i]) == 1
            count += 1
        i += 1
    count
