// ============================================================================
// NOVA Standard Library — std/data/m3u_parse
// ============================================================================
// Parse M3U / M3U8 playlists (extended format).
//
// PUBLIC API
//   m3u_parse(text) -> list of dict {"duration","title","url"}
//
// Format:
//   First line may be "#EXTM3U" (header — skipped).
//   "#EXTINF:<duration>,<title>" followed by a URL line = one entry
//     with the given duration (int) and title (string).
//   A bare URL line (not starting with '#') with no preceding EXTINF
//     produces an entry with duration=-1, title="".
//
// LEAF module — imports nothing.
// ============================================================================

// _m3u_ltrim: strip leading LF/CR/space from s
fn _m3u_ltrim(s)
    let i = 0
    let n = len(s)
    let result = s
    let done = 0
    while i < n and done == 0
        let c = slice(s, i, i+1)
        if c == " " or c == "\r" or c == chr(10)
            i += 1
        else
            done = 1
    if i > 0
        result = slice(s, i, n)
    return result

// _m3u_rtrim: strip trailing LF/CR/space from s
fn _m3u_rtrim(s)
    let n = len(s)
    let i = n
    let result = s
    let done = 0
    while i > 0 and done == 0
        let c = slice(s, i-1, i)
        if c == " " or c == "\r" or c == chr(10)
            i -= 1
        else
            done = 1
    if i < n
        result = slice(s, 0, i)
    return result

// _m3u_trim: strip leading and trailing whitespace
fn _m3u_trim(s)
    return _m3u_rtrim(_m3u_ltrim(s))

// _m3u_starts_with: 1 if s starts with prefix, else 0
fn _m3u_starts_with(s, prefix)
    let result = 0
    let plen = len(prefix)
    let slen = len(s)
    if slen >= plen
        if slice(s, 0, plen) == prefix
            result = 1
    return result

// _m3u_find: index of first occurrence of needle in haystack starting at pos;
//            returns -1 if not found.
fn _m3u_find(haystack, needle, pos)
    let hlen = len(haystack)
    let nlen = len(needle)
    let result = -1
    let i = pos
    let found = 0
    while i <= hlen - nlen and found == 0
        if slice(haystack, i, i+nlen) == needle
            result = i
            found = 1
        else
            i += 1
    return result

// _m3u_split_lines: split text on LF into a list of lines
fn _m3u_split_lines(text)
    let lines = []
    let n = len(text)
    let start = 0
    for i in 0..n
        let c = slice(text, i, i+1)
        if c == chr(10)
            push(lines, slice(text, start, i))
            start = i + 1
    if start < n
        push(lines, slice(text, start, n))
    return lines

// _m3u_parse_extinf: parse "#EXTINF:<dur>,<title>" line.
//   Returns list [duration_int, title_string].
fn _m3u_parse_extinf(line)
    // line looks like: #EXTINF:123,Song Title
    let result = [-1, ""]
    // Find the ':' after #EXTINF
    let colon = _m3u_find(line, ":", 0)
    if colon >= 0
        // Find the ',' separating duration from title
        let comma = _m3u_find(line, ",", colon+1)
        if comma >= 0
            let dur_str = _m3u_trim(slice(line, colon+1, comma))
            let title = _m3u_trim(slice(line, comma+1, len(line)))
            // Parse duration as int (may be negative, e.g. "-1")
            let neg = 0
            let dstart = 0
            if len(dur_str) > 0
                if slice(dur_str, 0, 1) == "-"
                    neg = 1
                    dstart = 1
            let dur = 0
            let di = dstart
            while di < len(dur_str)
                let co = ord(slice(dur_str, di, di+1))
                if co >= 48 and co <= 57
                    dur = dur * 10 + (co - 48)
                di += 1
            if neg == 1
                dur = -dur
            result = [dur, title]
    return result

// m3u_parse: main entry point.
fn m3u_parse(text)
    let lines = _m3u_split_lines(text)
    let entries = []
    let pending_dur = -2     // -2 = no pending EXTINF
    let pending_title = ""
    let i = 0
    while i < len(lines)
        let raw = lines[i]
        let line = _m3u_trim(raw)
        if line == "#EXTM3U"
            // header — skip
            i += 1
        else if _m3u_starts_with(line, "#EXTINF:")
            let parsed = _m3u_parse_extinf(line)
            pending_dur = parsed[0]
            pending_title = parsed[1]
            i += 1
        else if _m3u_starts_with(line, "#")
            // other comment/tag — skip
            i += 1
        else if len(line) > 0
            // URL line
            let dur = -1 if pending_dur == -2 else pending_dur
            let title = "" if pending_dur == -2 else pending_title
            push(entries, {"duration": dur, "title": title, "url": line})
            pending_dur = -2
            pending_title = ""
            i += 1
        else
            i += 1
    return entries
