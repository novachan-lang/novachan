// ============================================================================
// NOVA Standard Library — std/data/kml_build
// ============================================================================
// Build KML documents from coordinate data.
//
// PUBLIC API:
//   kml_build(points) -> string
//     Produce a minimal KML document containing a LineString with the given
//     coordinate pairs.  points is a list of [lon, lat] pairs (each a 2-element
//     list of floats), matching the GeoJSON / KML convention [lon, lat].
//     Emits: <kml ...><Document><Placemark><LineString><coordinates>
//            lon,lat lon,lat ...</coordinates></LineString></Placemark>
//            </Document></kml>
//
//   kml_approx(a, b, tol) -> int
//     Float comparison within tolerance.  Returns 1 if |a-b| <= tol, else 0.
//     Re-exported here so tests can use a single import.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - Floats emitted via str(f), which uses %.15g — full precision, no
//     trailing zeros beyond what IEEE-754 requires.  This is correct for
//     round-trip accuracy.  KML consumers (Google Earth, Leaflet etc.) accept
//     any decimal float notation in <coordinates>.
//   - Single-exit style throughout (avoids NOVA return-null mistag).
//   - No multi-line list/dict literals (NOVA parser limitation).
//   - chr(34)='"', chr(60)='<', chr(62)='>'
//   - The KML namespace attribute uses chr(34) for double-quote delimiters.
//
// KAT vectors (hand-computed):
//   kml_build([[1.0, 2.0], [3.0, 4.0]]):
//     contains "<kml"
//     contains "<coordinates>"
//     contains "1" (for the lon of first point)
//     contains "3" (for the lon of second point)
//   Round-trip: kml_parse(kml_build(pts)) approx== pts within 1e-9
// ============================================================================

// ── Private: float-to-string helper ──────────────────────────────────────────

// _kb_fstr: convert a float to its string representation.
// Binds to a let first to avoid the float-return codegen hazard.
fn _kb_fstr(f: float) -> string
    let s = str(f)
    s

// ── Private: build the coordinate string from a list of [lon,lat] pairs ──────

// _kb_coords_str: build the space-separated "lon,lat" sequence for <coordinates>.
// Altitude is omitted (KML allows 2D coordinates).
fn _kb_coords_str(points: list) -> string
    let n = len(points)
    let out = ""
    for i in 0..n
        let pair = points[i]
        let lon_f = pair[0]
        let lat_f = pair[1]
        let lon_s = _kb_fstr(lon_f)
        let lat_s = _kb_fstr(lat_f)
        let token = lon_s + "," + lat_s
        if i == 0
            out = token
        else
            out = out + " " + token
    out

// ── Public API ───────────────────────────────────────────────────────────────

// kml_build: produce a minimal KML document for a list of [lon, lat] pairs.
//
// The output structure is:
//   <kml xmlns="http://www.opengis.net/kml/2.2">
//     <Document>
//       <Placemark>
//         <LineString>
//           <coordinates>lon,lat lon,lat ...</coordinates>
//         </LineString>
//       </Placemark>
//     </Document>
//   </kml>
//
// Empty point list produces the same structure with empty <coordinates/>.
fn kml_build(points: list) -> string
    let dq = chr(34)
    let lt = chr(60)
    let gt = chr(62)
    let sl = chr(47)
    let ns = "http://www.opengis.net/kml/2.2"
    let coords = _kb_coords_str(points)
    // Build from inside out.
    let coords_elem = lt + "coordinates" + gt + coords + lt + sl + "coordinates" + gt
    let ls_elem = lt + "LineString" + gt + coords_elem + lt + sl + "LineString" + gt
    let pm_elem = lt + "Placemark" + gt + ls_elem + lt + sl + "Placemark" + gt
    let doc_elem = lt + "Document" + gt + pm_elem + lt + sl + "Document" + gt
    let kml_open = lt + "kml xmlns=" + dq + ns + dq + gt
    let kml_close = lt + sl + "kml" + gt
    kml_open + doc_elem + kml_close
