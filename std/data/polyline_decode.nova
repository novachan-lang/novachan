// ============================================================================
// NOVA Standard Library — std/data/polyline_decode
// ============================================================================
// Google Encoded Polyline Algorithm — decoder.
//
// The algorithm (inverse of polyline_encode):
//   1. Read characters until a byte with value < 63+32 (i.e., value-63 < 32).
//   2. Accumulate 5-bit groups (LSB first), stripping the continuation bit.
//   3. Zigzag-decode: if LSB==1, value = -(value>>1)-1; else value = value>>1.
//   4. Add to the running lat/lng accumulator.
//   5. Scale back to float by dividing by 1e5.
//
// PUBLIC API:
//   polyline_decode(encoded) -> list
//     Decode a Google Encoded Polyline string back to a list of [lat, lon]
//     float pairs.
//     encoded: ASCII string produced by polyline_encode.
//     Returns list of 2-element float lists.  Empty string -> [].
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - char_at(s, i) returns a 1-char string; ord() converts to code point.
//   - Zigzag decode: raw = accumulated value BEFORE unzigzag.
//       if (raw & 1) == 1: delta = -(raw >> 1) - 1
//       else:              delta = raw >> 1
//   - Division by 100000.0 (float) converts the integer coordinate to float.
//   - Single-exit style; no early returns.
//
// KAT vectors:
//   polyline_decode("_p~iF~ps|U_ulLnnqC_mqNvxq`@")
//     -> [[38.5,-120.2],[40.7,-120.95],[43.252,-126.453]] within 0.0001
//   polyline_decode("") -> []
//   polyline_decode(polyline_encode(pts)) approx== pts within 0.00001
// ============================================================================

// ── Private: decode one integer value starting at pos; return [value, next_pos] ──

// _pd_dec: reads one zigzag-encoded integer from s starting at idx.
// Returns a 2-element list [decoded_int, next_idx].
fn _pd_dec(s: string, idx: int) -> list
    let shift = 0
    let result = 0
    let i = idx
    let done = 0
    while done == 0
        let b = ord(char_at(s, i)) - 63
        i = i + 1
        result = result + ((b & 31) << shift)
        shift = shift + 5
        if b < 32
            done = 1
    // Zigzag decode: if LSB==1 -> negative
    let d = result / 2
    if (result & 1) == 1
        d = 0 - d - 1
    [d, i]

// ── Public API ───────────────────────────────────────────────────────────────

// polyline_decode: decode an encoded polyline string to [[lat, lon], ...].
fn polyline_decode(encoded: string) -> list
    let pts = []
    let n = len(encoded)
    let idx = 0
    let lat = 0
    let lng = 0
    while idx < n
        let rlat = _pd_dec(encoded, idx)
        lat = lat + rlat[0]
        idx = rlat[1]
        let rlng = _pd_dec(encoded, idx)
        lng = lng + rlng[0]
        idx = rlng[1]
        let lat_f = (lat * 1.0) / 100000.0
        let lng_f = (lng * 1.0) / 100000.0
        let pair = [lat_f, lng_f]
        push(pts, pair)
    pts
