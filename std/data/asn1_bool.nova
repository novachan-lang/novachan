// ============================================================================
// NOVA Standard Library — std/data/asn1_bool
// ============================================================================
// ASN.1 DER BOOLEAN (tag 0x01) encoder and decoder.
//
// DER BOOLEAN encoding (X.690 §8.2):
//   Tag  = 0x01  (universal primitive)
//   Len  = 0x01  (always one content byte)
//   Value: false -> 0x00 ; true -> 0xFF  (DER requires exactly 0xFF for TRUE)
//
// Decoding is BER-lenient: any non-zero content byte decodes as true.
// This matches real-world X.509 certificates which sometimes contain 0x01.
//
// PUBLIC API:
//   asn1_bool_encode(v) -> bytes
//     DER-encode a boolean value v.
//     true  -> [0x01, 0x01, 0xFF]   (3 bytes)
//     false -> [0x01, 0x01, 0x00]   (3 bytes)
//
//   asn1_bool_decode(b, pos) -> list
//     Decode a DER BOOLEAN TLV starting at byte position pos in bytes b.
//     Returns a 2-element list: [bool_value: int, next_pos: int]
//       bool_value = 1 (true) if content byte != 0, else 0 (false).
//       next_pos   = pos + 3  (tag + len + 1 content byte).
//     Bounds-checked: returns [0, pos] if the input is too short or malformed.
//
// PRIVATE helpers:
//   _asn1_bool_tag_ok(b, pos) -> int    1 if tag byte == 0x01, else 0
//   _asn1_bool_len_ok(b, pos) -> int    1 if length byte == 0x01, else 0
//
// LEAF module — imports nothing.
//
// KAT vectors (X.690 verified):
//   asn1_bool_encode(true)       == [0x01, 0x01, 0xFF]
//   asn1_bool_encode(false)      == [0x01, 0x01, 0x00]
//   asn1_bool_decode(b_true, 0)  == [1, 3]
//   asn1_bool_decode(b_false, 0) == [0, 3]
//   BER-lenient: content byte 0x01 -> true (non-zero)
// ============================================================================

// _asn1_bool_tag_ok: return 1 if byte at pos is the BOOLEAN tag (0x01).
// Bounds-checks that pos is within the buffer.
fn _asn1_bool_tag_ok(b: any, pos: int) -> int
    let result = 0
    if bytes_len(b) > pos
        if bytes_get(b, pos) == 1
            result = 1
    result

// _asn1_bool_len_ok: return 1 if the length byte at pos+1 equals 0x01.
// BOOLEAN content is always exactly 1 byte in DER/BER.
fn _asn1_bool_len_ok(b: any, pos: int) -> int
    let result = 0
    if bytes_len(b) > pos + 1
        if bytes_get(b, pos + 1) == 1
            result = 1
    result

// asn1_bool_encode: DER-encode a boolean value.
// Accepts any int: 0 = false, anything else = true.
// Returns a 3-byte bytes value: tag=0x01, length=0x01, value=0xFF or 0x00.
fn asn1_bool_encode(v: int) -> any
    let out = bytes(0)
    out = bytes_append(out, 1)
    out = bytes_append(out, 1)
    if v == 0
        out = bytes_append(out, 0)
    else
        out = bytes_append(out, 255)
    out

// asn1_bool_decode: BER-lenient BOOLEAN decoder.
// b   - bytes buffer containing the TLV
// pos - byte offset of the tag byte
//
// Validates:
//   - tag byte == 0x01
//   - length byte == 0x01
//   - content byte exists (pos+2 < bytes_len(b))
//
// Returns [bool_val, next_pos] where:
//   bool_val = 1 if content byte != 0 (BER-lenient), else 0
//   next_pos = pos + 3
//
// On any malformed input returns [0, pos] (safe, caller can detect stall).
fn asn1_bool_decode(b: any, pos: int) -> list
    let result = []
    let ok = 1
    if _asn1_bool_tag_ok(b, pos) == 0
        ok = 0
    if _asn1_bool_len_ok(b, pos) == 0
        ok = 0
    if bytes_len(b) <= pos + 2
        ok = 0
    if ok == 0
        push(result, 0)
        push(result, pos)
    else
        let content = bytes_get(b, pos + 2)
        let bval = 0
        if content != 0
            bval = 1
        push(result, bval)
        push(result, pos + 3)
    result
