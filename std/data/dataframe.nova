// ============================================================================
// NOVA Standard Library — std/data/dataframe.nova
// Columnar DataFrame. Showcases the L8 structural `index` operator: a
// DataFrame struct defines `index(self, col)` so `df[col]` (plain [] syntax)
// dispatches to it and returns that column's values -- zero trait-impl
// ceremony, the same convention as Python's `__getitem__` but statically
// dispatched from the receiver's declared type (see FLEET_CODE_RULES: the
// receiver type must be known statically, so every function below that uses
// `df[col]` takes `df: DataFrame` as an annotated parameter).
//
// Storage: colnames (list of string) + coldata (list of columns, each
// column itself a list of `any` values, same order as colnames) + nrows.
// Row-major views are only materialized on demand (_df_row_at) for filter.
// Pure NOVA, no imports. Leaf module — imports nothing.
// ============================================================================

type DataFrame
    colnames: list
    coldata: list
    nrows: int

// df[col] -- L8 index operator. Returns a defensive COPY of the named
// column's value list, or an empty list if the column does not exist
// (loud-fail-free: callers that need existence should check df_has_col
// first). Returning a copy (not the live self.coldata[idx] list) matters:
// without it, a caller doing `let c = df[col]; push(c, x)` would silently
// mutate the DataFrame's internal storage through an aliased reference.
fn DataFrame.index(self, col) -> list
    let idx = _df_col_index(self, col)
    let out = []
    if idx >= 0
        out = _df_copy_list(self.coldata[idx])
    out

// _df_copy_list(xs) — shallow copy so callers of df[col] cannot mutate the
// DataFrame's internal column storage through the returned list.
fn _df_copy_list(xs: list) -> list
    [...xs]

// _df_col_index(df, col) — linear scan for the column's position, or -1.
// NOTE: does not short-circuit on the first match — if colnames somehow
// contains a duplicate, the LAST matching index wins, not the first. This
// quirk is preserved exactly (not "fixed") to keep behaviour unchanged.
fn _df_col_index(df: DataFrame, col) -> int
    let found = -1
    for i in 0..len(df.colnames)
        if df.colnames[i] == col
            found = i
    found

// df_has_col(df, col) — 1 if the column exists, else 0.
fn df_has_col(df: DataFrame, col) -> int
    let has = 0
    if _df_col_index(df, col) >= 0
        has = 1
    has

// df_new(colnames, rows) — build a DataFrame from row-major input: `rows`
// is a list of rows, each row a list of values in `colnames` order.
fn df_new(colnames: list, rows: list) -> DataFrame
    let ncols = len(colnames)
    let coldata = [[] for _ in 0..ncols]
    for row in rows
        for c2 in 0..ncols
            push(coldata[c2], row[c2])
    DataFrame(colnames, coldata, len(rows))

// _df_row_at(df, r) — materialize row r as a list of values, colnames order.
fn _df_row_at(df: DataFrame, r: int) -> list
    [df.coldata[c][r] for c in 0..len(df.coldata)]

// df_select(df, cols) — narrow to the given columns (order = cols), reusing
// the L8 index operator (df[cname]) to pull each column's data.
// NOTE: df[cname] is called from an explicit loop, not from inside a
// comprehension body — the L8 struct-index dispatch only resolves
// statically at the top level of a function whose receiver parameter is
// annotated; inside a comprehension's per-element expression the same call
// fails with "index [] on a struct whose type is not statically known"
// (a real compiler scoping gap, confirmed by testing). df[col] as a
// comprehension's SOURCE iterable (evaluated once, outside the per-element
// body) is unaffected — see col_min/col_max below.
fn df_select(df: DataFrame, cols: list) -> DataFrame
    let colnames = [...cols]
    let coldata = [df[cname] for cname in cols]
    DataFrame(colnames, coldata, df.nrows)

// df_filter(df, pred) — keep rows where pred(row) is truthy; `row` is a
// list of values in colnames order (see _df_row_at).
fn df_filter(df: DataFrame, pred) -> DataFrame
    let colnames = df.colnames
    let ncols = len(colnames)
    let new_coldata = [[] for _ in 0..ncols]
    let kept = 0
    for r in 0..df.nrows
        let row = _df_row_at(df, r)
        if pred(row)
            for c2 in 0..ncols
                push(new_coldata[c2], row[c2])
            kept += 1
    DataFrame(colnames, new_coldata, kept)

// df_head(df, n) — first n rows (all rows if n >= nrows, 0 rows if n <= 0).
// n is clamped to [0, nrows] so the result is always internally consistent
// (a negative n must never produce a negative .nrows on a DataFrame that
// actually holds 0 elements per column).
fn df_head(df: DataFrame, n: int) -> DataFrame
    let take = n
    if take > df.nrows
        take = df.nrows
    if take < 0
        take = 0
    let coldata = [[col[i] for i in 0..take] for col in df.coldata]
    DataFrame(df.colnames, coldata, take)

// col_sum(df, col) — sum of a numeric column (int or float values coerced
// via float()).
fn col_sum(df: DataFrame, col) -> float
    let vals = df[col]
    let total = 0.0
    for i in 0..len(vals)
        total += float(vals[i])
    total

// col_mean(df, col) — arithmetic mean of a numeric column (0.0 on empty).
fn col_mean(df: DataFrame, col) -> float
    let vals = df[col]
    let m = 0.0
    if len(vals) > 0
        m = col_sum(df, col) / float(len(vals))
    m

// col_min(df, col) — minimum of a numeric column (0.0 on empty).
// NOTE: not delegated to list_min() — on an empty list (e.g. an unknown
// column, which df[col] returns as []) list_min() returns int 0, not float
// 0.0, breaking this function's -> float contract (confirmed by testing;
// same class of gap as sum([]) — see col_sum's history). Kept as a plain
// index loop so the accumulator is always a float.
fn col_min(df: DataFrame, col) -> float
    let vals = df[col]
    let m = 0.0
    for i in 0..len(vals)
        let v = float(vals[i])
        if i == 0
            m = v
        else if v < m
            m = v
    m

// col_max(df, col) — maximum of a numeric column (0.0 on empty). See
// col_min for why this stays a plain index loop rather than list_max().
fn col_max(df: DataFrame, col) -> float
    let vals = df[col]
    let m = 0.0
    for i in 0..len(vals)
        let v = float(vals[i])
        if i == 0
            m = v
        else if v > m
            m = v
    m

// ============================================================================
// Extended API: group-by, join, pivot, apply, column edit, unique/counts,
// fillna, shape. Same conventions as above: string keys for dicts (values
// stringified via str() for grouping/counting), defensive copies on every
// column carried into a new DataFrame (no aliasing of the source df's
// storage — matches the df[col] index-operator contract), leaf module.
// ============================================================================

// df_group_by(df, col_name) -> list of {"key": groupValue, "rows": DataFrame}
// dicts, one per distinct value of col_name, in first-seen order. Each
// "rows" sub-DataFrame carries ALL of df's columns (not just col_name) for
// every row whose col_name matched that group's key — the usual "split" half
// of split-apply-combine. Unknown column -> [] (loud-fail-free, matches
// df_has_col's philosophy elsewhere in this module).
fn df_group_by(df: DataFrame, col_name) -> list
    let idx = _df_col_index(df, col_name)
    let out = []
    if idx >= 0
        let key_order = []
        let key_to_rows = {}
        let key_to_val = {}
        for r in 0..df.nrows
            let row = _df_row_at(df, r)
            let kv = row[idx]
            let ks = str(kv)
            if ks not in key_to_rows
                key_to_rows[ks] = []
                key_to_val[ks] = kv
                push(key_order, ks)
            key_to_rows[ks].push(row)
        out = [{"key": key_to_val[ks2], "rows": df_new(df.colnames, key_to_rows[ks2])} for ks2 in key_order]
    out

// df_merge(df1, df2, on_col) -> DataFrame — inner join on a shared column.
// Output columns = df1's columns, then df2's columns EXCEPT on_col (avoids a
// duplicate column name in the join result — the standard pandas
// `merge(..., on=col)` convention). Every (row1, row2) pair whose on_col
// values match (compared via str(), same coercion as df_group_by/
// df_value_counts) produces one output row — a true relational inner join,
// including the N×M fan-out when a key repeats on both sides. If on_col is
// missing from either input, the result is an empty DataFrame with the
// still-computed output column names (never a crash on the missing lookup).
fn df_merge(df1: DataFrame, df2: DataFrame, on_col) -> DataFrame
    let idx1 = _df_col_index(df1, on_col)
    let idx2 = _df_col_index(df2, on_col)
    let df2_extra_idx = [c for c in 0..len(df2.colnames) if df2.colnames[c] != on_col]
    let out_colnames = [...df1.colnames, ...[df2.colnames[c] for c in df2_extra_idx]]
    let out_rows = []
    if idx1 >= 0 and idx2 >= 0
        let df2_index = {}
        for r2 in 0..df2.nrows
            let row2 = _df_row_at(df2, r2)
            let ks = str(row2[idx2])
            if ks not in df2_index
                df2_index[ks] = []
            df2_index[ks].push(r2)
        for r1 in 0..df1.nrows
            let row1 = _df_row_at(df1, r1)
            let ks1 = str(row1[idx1])
            if ks1 in df2_index
                let matches = df2_index[ks1]
                for r2_idx in matches
                    let row2b = _df_row_at(df2, r2_idx)
                    let joined = [...row1, ...[row2b[i] for i in df2_extra_idx]]
                    push(out_rows, joined)
    df_new(out_colnames, out_rows)

// df_pivot(df, index_col, pivot_col, value_col) -> dict — pivot table as a
// nested dict: {str(index_val): {str(pivot_val): value_col_value, ...}, ...}.
// Unlike the other reshaping ops this deliberately does NOT return a
// DataFrame: the set of pivot_col values (which become "columns") is only
// known at run time from the data, and DataFrame column names are decided
// at construction — a dict-of-dicts is the honest representation (same
// reasoning as df_value_counts returning a dict rather than a 2-column
// DataFrame). On a duplicate (index_val, pivot_val) pair the later row wins
// (last-write-wins), matching pandas' behavior without an explicit
// aggregation function. Missing column -> {}.
fn df_pivot(df: DataFrame, index_col, pivot_col, value_col) -> dict
    let idx_i = _df_col_index(df, index_col)
    let idx_p = _df_col_index(df, pivot_col)
    let idx_v = _df_col_index(df, value_col)
    let result = {}
    if idx_i >= 0 and idx_p >= 0 and idx_v >= 0
        for r in 0..df.nrows
            let row = _df_row_at(df, r)
            let ik = str(row[idx_i])
            let pk = str(row[idx_p])
            if ik not in result
                result[ik] = {}
            result[ik][pk] = row[idx_v]
    result

// df_apply(df, col_name, func) -> DataFrame — new DataFrame with func(v)
// applied to every value of col_name; every other column is carried over
// unchanged (defensively copied, per this module's no-aliasing contract).
// Unknown col_name -> an unchanged copy of df (func never called — same
// loud-fail-free philosophy as df[col] on a missing column).
fn df_apply(df: DataFrame, col_name, func) -> DataFrame
    let idx = _df_col_index(df, col_name)
    let coldata = [([func(v) for v in df.coldata[c]] if c == idx else _df_copy_list(df.coldata[c])) for c in 0..len(df.coldata)]
    DataFrame(df.colnames, coldata, df.nrows)

// df_rename(df, old_name, new_name) -> DataFrame — rename one column;
// column DATA and row count are untouched. old_name not found -> colnames
// unchanged (no error; consistent with this module's has-col-first style).
fn df_rename(df: DataFrame, old_name, new_name) -> DataFrame
    let colnames = [(new_name if df.colnames[c] == old_name else df.colnames[c]) for c in 0..len(df.colnames)]
    let coldata = [_df_copy_list(col) for col in df.coldata]
    DataFrame(colnames, coldata, df.nrows)

// df_drop(df, col_name) -> DataFrame — new DataFrame with col_name removed.
// col_name not found -> a full (copied) DataFrame equal to df.
fn df_drop(df: DataFrame, col_name) -> DataFrame
    let colnames = [df.colnames[c] for c in 0..len(df.colnames) if df.colnames[c] != col_name]
    let coldata = [_df_copy_list(df.coldata[c]) for c in 0..len(df.colnames) if df.colnames[c] != col_name]
    DataFrame(colnames, coldata, df.nrows)

// df_unique(df, col_name) -> list — distinct values of col_name, first-seen
// order (values compared via str(), same coercion the rest of this module
// uses for grouping/counting). Unknown col_name -> [].
fn df_unique(df: DataFrame, col_name) -> list
    let idx = _df_col_index(df, col_name)
    let out = []
    if idx >= 0
        let seen = {}
        let col = df.coldata[idx]
        for v in col
            let ks = str(v)
            if ks not in seen
                seen[ks] = 1
                push(out, v)
    out

// df_value_counts(df, col_name) -> dict — frequency table: str(value) ->
// count, for every value in col_name. Unknown col_name -> {}.
fn df_value_counts(df: DataFrame, col_name) -> dict
    let idx = _df_col_index(df, col_name)
    let result = {}
    if idx >= 0
        let col = df.coldata[idx]
        for v in col
            let ks = str(v)
            if ks not in result
                result[ks] = 0
            result[ks] += 1
    result

// _df_is_na(v) — true for NOVA's "missing" convention: null, or numeric
// zero (int 0 or float 0.0 — NOVA has no separate NaN/NA sentinel, so
// "missing" in a numeric column is conventionally 0, same convention
// std/data/groupby's callers rely on). type_of(v) is only computed once v
// is known non-null, matching the original branch structure exactly.
fn _df_is_na(v) -> bool
    if v == null
        return true
    let t = type_of(v)
    if t == "int" and v == 0
        return true
    if t == "float" and v == 0.0
        return true
    false

// df_fillna(df, col_name, fill_value) -> DataFrame — in col_name, replace
// every `null` value and every numeric zero with fill_value (see
// _df_is_na). Every other column is carried over unchanged. Unknown
// col_name -> an unchanged copy of df.
fn df_fillna(df: DataFrame, col_name, fill_value) -> DataFrame
    let idx = _df_col_index(df, col_name)
    let coldata = [([(fill_value if _df_is_na(v) else v) for v in df.coldata[c]] if c == idx else _df_copy_list(df.coldata[c])) for c in 0..len(df.coldata)]
    DataFrame(df.colnames, coldata, df.nrows)

// df_shape(df) -> [num_rows, num_cols] — pandas-style `.shape` as a 2-list.
fn df_shape(df: DataFrame) -> list
    [df.nrows, len(df.colnames)]
