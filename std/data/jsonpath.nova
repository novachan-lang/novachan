// ============================================================================
// NOVA Standard Library — std/data/jsonpath
// ============================================================================
// JSONPath query evaluator over already-parsed NOVA values (dict/list/scalar,
// e.g. the output of json_decode). This is a thin, DRY public-API wrapper over
// the canonical JSONPath engine in std/parsing/jsonpath (lexer/evaluator) —
// see that module for the token stream and traversal internals. This module
// exists so `std/data/*` callers get a data-domain entry point named to match
// common JSONPath API conventions (`jsonpath_query`) without duplicating the
// engine.
//
// SUPPORTED SYNTAX (see std/parsing/jsonpath for the authoritative list):
//   $              — root selector
//   .key / *       — child key / wildcard child
//   ["key"]/['key']— bracket child key (double- or single-quoted)
//   [n]            — index (negative = from end)
//   [*]            — all children wildcard
//   [start:end]    — array slice (half-open, either side omittable, negative
//                    indices from end, out-of-range clamped to [0,len])
//   ..             — recursive descent (..key or ..* or bare ..)
//
// SEMANTICS:
//   - Returns a LIST of all matching values, in document order.
//   - A path that matches nothing (missing key, out-of-range index, wrong
//     shape, malformed/empty path) returns [] — never crashes.
//   - Values returned are the SAME references held in the source structure
//     (dict/list are reference types in NOVA); scalars are copied by value
//     as usual. Callers who need to mutate a match without affecting the
//     source should copy defensively before mutating.
//
// PUBLIC API:
//   jsonpath_query(root, path) -> list   all matches, document order, [] if none
//   jsonpath_first(root, path) -> any    first match, or null if none
//
// NOVA CONSTRAINTS:
//   - No multi-line list/dict literals; single-exit; no reserved words as vars.
//   - Depends ONLY on std/parsing/jsonpath (leaf engine).
// ============================================================================

import std/parsing/jsonpath

// jsonpath_query: evaluate `path` against `root` (a dict/list/scalar value
// tree, typically the result of json_decode). Returns a list of every
// matching value in document order. Returns [] on no match, an empty path,
// or a malformed path segment — this never throws/crashes.
fn jsonpath_query(root, path)
    return jp_query(root, path)

// jsonpath_first: like jsonpath_query but returns only the first match, or
// null if there are no matches.
fn jsonpath_first(root, path)
    return jp_first(root, path)
