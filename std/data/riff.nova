// std/data/riff -- RIFF container parser (Resource Interchange File Format).
//
// RIFF is the container format used by WAV audio, AVI video, WebP images, and
// many other Windows multimedia formats. The layout is:
//
//   Offset  Size  Field
//   ------  ----  -----
//    0       4    "RIFF"   (magic)
//    4       4    LE-u32   size of the rest of the file (excludes first 8 bytes)
//    8       4    Form type (e.g. "WAVE", "AVI ", "WEBP")
//   12+           Chunks, each:
//                   4 bytes  chunk id  (e.g. "fmt ", "data", "LIST")
//                   4 bytes  LE-u32    chunk data size (excludes this 8-byte header)
//                   N bytes  chunk data
//                   pad byte if N is odd (alignment to 16-bit boundary)
//
// PUBLIC API (prefix rff_):
//   rff_form_type(b)         -> string   4-char form type field (e.g. "WAVE")
//   rff_riff_size(b)         -> int      declared LE-u32 size at offset 4
//   rff_chunk_ids(b)         -> list     4-char ids of every top-level chunk
//   rff_find_chunk(b, id)    -> list     [dataStart, dataLen] or [-1, -1] if absent
//
// REQUIREMENTS:
//   b must be a `bytes` value containing a valid RIFF file.  No validation of
//   the "RIFF" magic is performed — callers should verify if needed.
//
// IMPLEMENTATION NOTES:
//   • All sizes are little-endian 32-bit unsigned integers.
//   • _rff_le32: reads 4 bytes at offset as LE u32.
//   • _rff_4cc: reads 4 bytes at offset as a 4-char ASCII string (FourCC).
//   • Chunk traversal starts at offset 12 (after the 12-byte RIFF header).
//   • Odd-sized chunks are padded to even: next chunk starts at data_start + size + (size % 2).
//   • LEAF module — imports nothing.

// _rff_le32: decode a little-endian 32-bit unsigned integer at byte offset pos
// in bytes value b.  Returns the integer value (fits in NOVA i64).
fn _rff_le32(b, pos: int) -> int
    let b0 = bytes_get(b, pos)
    let b1 = bytes_get(b, pos + 1)
    let b2 = bytes_get(b, pos + 2)
    let b3 = bytes_get(b, pos + 3)
    b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

// _rff_4cc: read 4 bytes at byte offset pos as a FourCC string.
// Each byte is turned into a single character via chr(); concatenated in order.
fn _rff_4cc(b, pos: int) -> string
    let c0 = chr(bytes_get(b, pos))
    let c1 = chr(bytes_get(b, pos + 1))
    let c2 = chr(bytes_get(b, pos + 2))
    let c3 = chr(bytes_get(b, pos + 3))
    c0 + c1 + c2 + c3

// rff_form_type: return the 4-char RIFF form type at offset 8.
// For a WAV file this is "WAVE"; for AVI it is "AVI "; for WebP it is "WEBP".
fn rff_form_type(b) -> string
    _rff_4cc(b, 8)

// rff_riff_size: return the LE-u32 size field at offset 4.
// This is the number of bytes in the file after the first 8 bytes (magic + size).
// For a file of total length L, this value is L - 8.
fn rff_riff_size(b) -> int
    _rff_le32(b, 4)

// rff_chunk_ids: return a list of all top-level chunk IDs (FourCC strings)
// found in the RIFF file, in order of appearance.
// Traversal starts at offset 12 (after the 12-byte RIFF header: "RIFF"+size+formtype).
// Each chunk occupies 4 (id) + 4 (size) + size bytes; if size is odd, one pad byte follows.
fn rff_chunk_ids(b) -> list
    let total = bytes_len(b)
    let ids = []
    let pos = 12
    let go = 1
    while go == 1
        if pos + 8 > total
            go = 0
        else
            let id = _rff_4cc(b, pos)
            let chunk_size = _rff_le32(b, pos + 4)
            ids.push(id)
            let pad = chunk_size % 2
            pos = pos + 8 + chunk_size + pad
    ids

// rff_find_chunk: find the first chunk with the given 4-char id.
// Returns a two-element list [dataStart, dataLen] where:
//   dataStart is the byte offset of the first data byte (after the 8-byte chunk header),
//   dataLen   is the chunk data size (the LE-u32 from the chunk header).
// Returns [-1, -1] if no chunk with that id is present.
fn rff_find_chunk(b, id) -> list
    let total = bytes_len(b)
    let result = []
    result.push(-1)
    result.push(-1)
    let pos = 12
    let go = 1
    while go == 1
        if pos + 8 > total
            go = 0
        else
            let cur_id = _rff_4cc(b, pos)
            let chunk_size = _rff_le32(b, pos + 4)
            if cur_id == id
                result[0] = pos + 8
                result[1] = chunk_size
                go = 0
            else
                let pad = chunk_size % 2
                pos = pos + 8 + chunk_size + pad
    result
