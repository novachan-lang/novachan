// ============================================================================
// NOVA Standard Library — std/data/sub_split
// ============================================================================
// Subtitle cue splitting operations.
//
// CUE SHAPE: dict {"index":int, "start":ms, "end":ms, "text":string}
//   ms values are integers (milliseconds from start of media).
//
// PUBLIC API:
//   sub_split_at(cues, time_ms) -> list
//     Split the cue that spans time_ms into two cues: [start, time_ms) and
//     [time_ms, end).  The text is duplicated to both halves.  Cues that do
//     not contain time_ms are passed through unchanged.  Indices are
//     reassigned sequentially (0, 1, 2, …) in output order.
//     A cue "contains" time_ms when cue.start < time_ms < cue.end.
//     (Boundary-only hits — cue.start == time_ms or cue.end == time_ms —
//     produce a zero-length cue and are skipped.)
//
//   sub_split_long(cues, max_ms) -> list
//     Split any cue longer than max_ms into N equal parts, where N is the
//     smallest integer such that each part <= max_ms.  Duration is divided
//     evenly; integer rounding is absorbed into the last part.  The text is
//     duplicated to every part.  Indices are reassigned sequentially.
//
//   sub_partition_at(cues, time_ms) -> list
//     Partition an ENTIRE cue list into two chronologically-ordered lists at
//     time_ms: [before_list, after_list] (a 2-element list of lists). Any
//     cue that SPANS time_ms (cue.start < time_ms < cue.end) is first split
//     into two half-cues via sub_split_at's rule, so no cue in the output
//     straddles the boundary; the left half goes to before_list, the right
//     half to after_list. A cue landing exactly at the boundary
//     (cue.start == time_ms) is placed in after_list; a cue ending exactly
//     at the boundary (cue.end == time_ms) is placed in before_list. Both
//     output lists are independently reindexed from 1. Input is assumed
//     sorted by start (SRT/VTT documents always are); the input list is not
//     mutated.
//
//   sub_split_lines(cue) -> list
//     Split a single cue on chr(10) newlines.  Each line of text becomes a
//     separate cue with the same start/end timing as the original.
//     Empty lines are included as cues with "" text.
//     Indices are assigned sequentially from 0.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - All helpers are _prefix (private).
//   - Single-exit style throughout.
//   - No multi-line list/dict literals.
//   - Integer division via NOVA '/' (truncating).
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// Build a cue dict.
fn _ssp_cue(idx, s, e, txt) -> dict
    {"index": idx, "start": s, "end": e, "text": txt}

// Count how many times chr(10) appears in txt, returns line-count = newlines+1.
fn _ssp_line_count(txt) -> int
    let n = len(txt)
    let count = 1
    for i in 0..n
        if ord(char_at(txt, i)) == 10
            count += 1
    count

// Extract the k-th newline-delimited line from txt (0-based).
fn _ssp_get_line(txt, k) -> string
    let n = len(txt)
    let line_idx = 0
    let start_pos = 0
    let result = ""
    let done = 0
    let i = 0
    while i <= n and done == 0
        let is_end = 0
        if i == n
            is_end = 1
        else
            if ord(char_at(txt, i)) == 10
                is_end = 1
        if is_end == 1
            if line_idx == k
                result = slice(txt, start_pos, i)
                done = 1
            line_idx += 1
            start_pos = i + 1
        i += 1
    result

// ── Public API ───────────────────────────────────────────────────────────────

// sub_split_at: split the cue that spans time_ms into two cues.
//
// For each cue in input:
//   If cue.start < time_ms < cue.end → emit two cues [start,time_ms) and
//   [time_ms,end) with the same text.
//   Otherwise → emit cue unchanged (copy).
// Indices are reassigned sequentially across the whole output list.
fn sub_split_at(cues, time_ms) -> list
    let result = []
    let n = len(cues)
    let out_idx = 0
    for i in 0..n
        let cue = cues[i]
        let cs = cue["start"]
        let ce = cue["end"]
        let ct = cue["text"]
        if cs < time_ms and time_ms < ce
            // Split into two.
            let left = _ssp_cue(out_idx, cs, time_ms, ct)
            result.push(left)
            out_idx += 1
            let right = _ssp_cue(out_idx, time_ms, ce, ct)
            result.push(right)
            out_idx += 1
        else
            let copy = _ssp_cue(out_idx, cs, ce, ct)
            result.push(copy)
            out_idx += 1
    result

// sub_partition_at: partition the whole cue list into [before_list, after_list]
// at time_ms. A cue spanning time_ms is split first (same rule as
// sub_split_at) so its two halves land on the correct side of the boundary.
// Each output list is independently reindexed from 1.
fn sub_partition_at(cues, time_ms) -> list
    let before = []
    let after = []
    let n = len(cues)
    let bi = 1
    let ai = 1
    for i in 0..n
        let cue = cues[i]
        let cs = cue["start"]
        let ce = cue["end"]
        let ct = cue["text"]
        if cs < time_ms and time_ms < ce
            // Spans the boundary: split, left half before, right half after.
            let left = _ssp_cue(bi, cs, time_ms, ct)
            before.push(left)
            bi += 1
            let right = _ssp_cue(ai, time_ms, ce, ct)
            after.push(right)
            ai += 1
        else
            if ce <= time_ms
                let copy = _ssp_cue(bi, cs, ce, ct)
                before.push(copy)
                bi += 1
            else
                let copy2 = _ssp_cue(ai, cs, ce, ct)
                after.push(copy2)
                ai += 1
    let result = [before, after]
    result

// sub_split_long: split cues longer than max_ms into equal parts.
//
// For each cue:
//   dur = cue.end - cue.start
//   If dur <= max_ms → emit unchanged.
//   Else → compute N = ceil(dur / max_ms) parts.
//     part_dur = dur / N  (integer division; last part absorbs remainder).
//     Emit N cues: [start + k*part_dur, start + (k+1)*part_dur) for k<N-1,
//     and [start + (N-1)*part_dur, end) for the last part.
//   All parts get the same text.
// Indices are reassigned sequentially.
fn sub_split_long(cues, max_ms) -> list
    let result = []
    let n = len(cues)
    let out_idx = 0
    for i in 0..n
        let cue = cues[i]
        let cs = cue["start"]
        let ce = cue["end"]
        let ct = cue["text"]
        let dur = ce - cs
        if dur <= max_ms
            let copy = _ssp_cue(out_idx, cs, ce, ct)
            result.push(copy)
            out_idx += 1
        else
            // Compute number of parts: ceil(dur / max_ms).
            let parts = dur / max_ms
            if parts * max_ms < dur
                parts += 1
            // Part duration (integer division).
            let part_dur = dur / parts
            for k in 0..parts
                let ps = cs + k * part_dur
                let pe = cs + (k + 1) * part_dur
                if k == parts - 1
                    pe = ce
                let part_cue = _ssp_cue(out_idx, ps, pe, ct)
                result.push(part_cue)
                out_idx += 1
    result

// sub_split_lines: split one cue into one cue per text line.
//
// Splits cue["text"] on chr(10).  Each line becomes a separate cue with
// the same start/end timing.  Indices start at 0.
fn sub_split_lines(cue) -> list
    let result = []
    let txt = cue["text"]
    let cs = cue["start"]
    let ce = cue["end"]
    let nlines = _ssp_line_count(txt)
    for k in 0..nlines
        let line = _ssp_get_line(txt, k)
        let lc = _ssp_cue(k, cs, ce, line)
        result.push(lc)
    result
