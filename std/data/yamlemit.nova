// ============================================================================
// NOVA Standard Library — std/data/yamlemit
// ============================================================================
// YAML emitter (block style + flow style) for a NOVA value subset.
//
// PUBLIC API:
//   ye_emit(value) -> string
//     Emit value as a YAML block-style document.
//       dict  -> "key: value\n" lines, keys sorted lexicographically.
//               Nested dicts/lists are indented 2 spaces per level.
//       list  -> "- item\n" lines; nested values indented after "- ".
//       string -> bare scalar, double-quoted only when the value contains
//               characters that would confuse a YAML parser (see _ye_needs_quote).
//       int / float -> str() representation.
//       null  -> "null"
//     The returned string always ends with chr(10) for non-scalar root values.
//     Scalars at the root do NOT carry a trailing newline (consistent with
//     how YAML scalars embed into parent documents via the helper path).
//
//   ye_emit_flow(value) -> string
//     Emit value as a YAML flow-style scalar.
//       dict  -> {key: value, key2: value2}  (keys sorted)
//       list  -> [item1, item2, item3]
//       scalar -> same quoting rules as ye_emit
//
// LEAF MODULE — imports nothing.
//
// DESIGN NOTES:
//   - chr(10)  = LF newline
//   - chr(123) = {   chr(125) = }   (avoid interpolation)
//   - chr(34)  = "   (double-quote)
//   - chr(58)  = :   chr(35) = #   chr(91) = [   chr(93) = ]
//   - Private helpers prefixed _ye_ to avoid collisions.
//   - Single-exit style throughout (avoids NOVA return-null mistag).
//   - type_of() used for dispatch; is_dict/is_list unsafe on any-typed values.
//   - Keys sorted via sort(keys(d)) for deterministic output.
//
// KAT vectors (hand-computed against YAML 1.2 spec):
//   ye_emit({"name":"nova","version":1}) == "name: nova\nversion: 1\n"
//   ye_emit(["a","b"])                  == "- a\n- b\n"
//   ye_emit({"a":{"b":1}})             == "a:\n  b: 1\n"
//   ye_emit_flow({"a":1})              == "{a: 1}"
//   ye_emit_flow([1,2,3])              == "[1, 2, 3]"
// ============================================================================

// ── Private: build an indent string of (level * 2) spaces ────────────────────

fn _ye_indent(level: int) -> string
    let out = ""
    for i in 0..level
        out += "  "
    out

// ── Private: check whether a string scalar needs double-quoting ──────────────
//
// A YAML bare scalar is safe when:
//   - non-empty
//   - does not start with a special indicator char
//   - contains no : # [ ] { } , " newline characters
//   - does not look like a YAML special value (true/false/null/~)
//   - does not look like a number (would be mis-typed)
//
// Returns 1 if quoting is required, 0 otherwise.
fn _ye_needs_quote(s: string) -> int
    let n = len(s)
    let need = 0
    // Empty string must be quoted.
    if n == 0
        need = 1
    else
        // Check first character for indicator chars.
        let fc = ord(s[0])
        // indicators: - ? | > ! & * @ ` { [ " ' % space
        // ASCII values: 45(-) 63(?) 124(|) 62(>) 33(!) 38(&) 42(*) 64(@) 96(`) 123({) 91([) 34(") 39(') 37(%) 32(space)
        if fc == 45
            need = 1
        else
            if fc == 63
                need = 1
            else
                if fc == 124
                    need = 1
                else
                    if fc == 62
                        need = 1
                    else
                        if fc == 33
                            need = 1
                        else
                            if fc == 38
                                need = 1
                            else
                                if fc == 42
                                    need = 1
                                else
                                    if fc == 64
                                        need = 1
                                    else
                                        if fc == 96
                                            need = 1
                                        else
                                            if fc == 123
                                                need = 1
                                            else
                                                if fc == 91
                                                    need = 1
                                                else
                                                    if fc == 34
                                                        need = 1
                                                    else
                                                        if fc == 39
                                                            need = 1
                                                        else
                                                            if fc == 37
                                                                need = 1
                                                            else
                                                                if fc == 32
                                                                    need = 1
        // Scan all chars for unsafe interior chars.
        if need == 0
            for i in 0..n
                let co = ord(s[i])
                // : 58  # 35  [ 91  ] 93  { 123  } 125  , 44  " 34  LF 10  CR 13
                if co == 58
                    need = 1
                else
                    if co == 35
                        need = 1
                    else
                        if co == 91
                            need = 1
                        else
                            if co == 93
                                need = 1
                            else
                                if co == 123
                                    need = 1
                                else
                                    if co == 125
                                        need = 1
                                    else
                                        if co == 44
                                            need = 1
                                        else
                                            if co == 34
                                                need = 1
                                            else
                                                if co == 10
                                                    need = 1
                                                else
                                                    if co == 13
                                                        need = 1
        // Check for YAML special values that must be quoted to remain strings.
        if need == 0
            if s == "true"
                need = 1
            else
                if s == "false"
                    need = 1
                else
                    if s == "null"
                        need = 1
                    else
                        if s == "~"
                            need = 1
                        else
                            if s == "yes"
                                need = 1
                            else
                                if s == "no"
                                    need = 1
    need

// ── Private: emit a scalar (no trailing newline) ─────────────────────────────

fn _ye_scalar(s: string) -> string
    let dq = chr(34)
    let out = s
    if _ye_needs_quote(s) == 1
        // Double-quote the string; escape existing double-quotes as \"
        // and backslashes as \\ first.
        let n = len(s)
        let inner_parts = []
        for i in 0..n
            let co = ord(s[i])
            if co == 92
                push(inner_parts, "\\" + "\\")
            else
                if co == 34
                    push(inner_parts, "\\" + dq)
                else
                    if co == 10
                        push(inner_parts, "\\n")
                    else
                        if co == 13
                            push(inner_parts, "\\r")
                        else
                            push(inner_parts, s[i])
        let inner = join(inner_parts, "")
        out = dq + inner + dq
    out

// ── Private: recursive block-style emitter ────────────────────────────────────
//
// level = current indentation level (root = 0).
// Returns the YAML text fragment (including trailing newline for collections).

fn _ye_block(value, level: int) -> string
    let nl = chr(10)
    let t = type_of(value)
    let out = ""
    if t == "dict"
        let ks = sort(keys(value))
        let nk = len(ks)
        let i = 0
        let pfx = _ye_indent(level)
        while i < nk
            let k = ks[i]
            let v = value[k]
            let vt = type_of(v)
            if vt == "dict"
                // Nested dict: emit key with bare colon, then recurse indented.
                out += pfx + k + ":" + nl
                out += _ye_block(v, level + 1)
            else
                if vt == "list"
                    // Nested list under a key.
                    out += pfx + k + ":" + nl
                    out += _ye_block(v, level + 1)
                else
                    // Scalar value inline.
                    let sv = _ye_value_scalar(v)
                    out += pfx + k + ": " + sv + nl
            i += 1
    else
        if t == "list"
            let n = len(value)
            let j = 0
            let pfx = _ye_indent(level)
            while j < n
                let item = value[j]
                let it = type_of(item)
                if it == "dict"
                    // dict under list item: first key on same line as "- "
                    // Emit "- " then the dict block with (level+1) indent,
                    // but the first line of the dict block drops its own indent.
                    let ks2 = sort(keys(item))
                    let nk2 = len(ks2)
                    let ki = 0
                    let inner_pfx = pfx + "  "
                    let first = 1
                    while ki < nk2
                        let k2 = ks2[ki]
                        let v2 = item[k2]
                        let v2t = type_of(v2)
                        if first == 1
                            if v2t == "dict"
                                out += pfx + "- " + k2 + ":" + nl
                                out += _ye_block(v2, level + 2)
                            else
                                if v2t == "list"
                                    out += pfx + "- " + k2 + ":" + nl
                                    out += _ye_block(v2, level + 2)
                                else
                                    let sv2 = _ye_value_scalar(v2)
                                    out += pfx + "- " + k2 + ": " + sv2 + nl
                            first = 0
                        else
                            if v2t == "dict"
                                out += inner_pfx + k2 + ":" + nl
                                out += _ye_block(v2, level + 2)
                            else
                                if v2t == "list"
                                    out += inner_pfx + k2 + ":" + nl
                                    out += _ye_block(v2, level + 2)
                                else
                                    let sv2b = _ye_value_scalar(v2)
                                    out += inner_pfx + k2 + ": " + sv2b + nl
                        ki += 1
                else
                    if it == "list"
                        // Nested list under list item.
                        out += pfx + "-" + nl
                        out += _ye_block(item, level + 1)
                    else
                        // Scalar list item.
                        let sv3 = _ye_value_scalar(item)
                        out += pfx + "- " + sv3 + nl
                j += 1
        else
            // Scalar root (unusual but legal).
            out = _ye_value_scalar(value)
    out

// ── Private: render a scalar value to its YAML string representation ──────────
//
// int / float -> str(value)
// string      -> _ye_scalar (handles quoting)
// null        -> "null"
// other       -> str(value) (fallback)

fn _ye_value_scalar(value) -> string
    let t = type_of(value)
    let out = ""
    if t == "string"
        out = _ye_scalar(value)
    else
        if t == "int"
            out = str(value)
        else
            if t == "float"
                out = str(value)
            else
                if value == null
                    out = "null"
                else
                    out = str(value)
    out

// ── Public: block-style emit ──────────────────────────────────────────────────

fn ye_emit(value) -> string
    _ye_block(value, 0)

// ── Private: flow-style helpers ───────────────────────────────────────────────

fn _ye_flow(value) -> string
    let t = type_of(value)
    let out = ""
    if t == "dict"
        let lb = chr(123)
        let rb = chr(125)
        let ks = sort(keys(value))
        let nk = len(ks)
        let body = ""
        for i in 0..nk
            let k = ks[i]
            let v = value[k]
            let part = k + ": " + _ye_flow(v)
            if i == 0
                body = part
            else
                body += ", " + part
        out = lb + body + rb
    else
        if t == "list"
            let n = len(value)
            let body2 = ""
            for j in 0..n
                let part2 = _ye_flow(value[j])
                if j == 0
                    body2 = part2
                else
                    body2 += ", " + part2
            out = "[" + body2 + "]"
        else
            out = _ye_value_scalar(value)
    out

// ── Public: flow-style emit ───────────────────────────────────────────────────

fn ye_emit_flow(value) -> string
    _ye_flow(value)
