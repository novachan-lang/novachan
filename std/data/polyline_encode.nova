// ============================================================================
// NOVA Standard Library — std/data/polyline_encode
// ============================================================================
// Google Encoded Polyline Algorithm — encoder.
//
// The algorithm:
//   1. Scale each lat/lon by 1e5 and round to the nearest integer.
//   2. Delta-encode: each value is the signed difference from the previous.
//   3. Zigzag encode: map signed int -> non-negative (n<<1 if n>=0, else ~(n<<1)).
//   4. Chunk into 5-bit groups (LSB first), set the continuation bit (0x20) on
//      all but the last chunk, then add 63 to each chunk to get a printable
//      ASCII character.
//
// PUBLIC API:
//   polyline_encode(points) -> string
//     Encode a list of [lat, lon] float pairs (GPS coordinates) into the
//     Google Encoded Polyline format.
//     points: list of 2-element lists [[lat, lon], ...]
//     Returns an ASCII string.  Empty list -> "".
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - round() builtin returns i64 — used for the scaled coordinate.
//   - Single-exit style throughout.
//   - The zigzag formula: if v >= 0, sv = v<<1; else sv = -v*2 - 1.
//     (Equivalent to the classic ~(v<<1) in two's complement, but expressed
//     without bitwise NOT which NOVA compiles correctly as -v-1.)
//   - Division is integer floor-towards-zero in NOVA (like C), so sv/32
//     right-shifts by 5 bits for positive sv.
//
// KAT vectors:
//   polyline_encode([[38.5,-120.2],[40.7,-120.95],[43.252,-126.453]])
//     == "_p~iF~ps|U_ulLnnqC_mqNvxq`@"   (Google canonical example)
//   polyline_encode([]) == ""
//   Single point round-trips within 0.00001
// ============================================================================

// ── Private: encode one signed integer delta to polyline ASCII chunks ─────────

// _pe_enc: zigzag + 5-bit chunk encode one signed integer.
// Returns the ASCII string for this one value.
fn _pe_enc(v: int) -> string
    // Zigzag: non-negative -> v<<1; negative -> -(v<<1)-1 = (-v-1)*2+1
    let sv = v << 1
    if v < 0
        sv = -sv - 1
    let s = ""
    let done = 0
    while done == 0
        if sv >= 32
            // More chunks remain; set continuation bit (bit 5 = 0x20 = 32).
            s += chr((sv & 31) + 32 + 63)
            sv = sv / 32
        else
            // Last chunk — no continuation bit.
            s += chr(sv + 63)
            done = 1
    s

// ── Public API ───────────────────────────────────────────────────────────────

// polyline_encode: encode a list of [lat, lon] pairs to a polyline string.
fn polyline_encode(points: list) -> string
    let n = len(points)
    let s_parts = []
    let plat = 0
    let plng = 0
    for i in 0..n
        let pair = points[i]
        let lat_f = pair[0]
        let lng_f = pair[1]
        let lat = round(lat_f * 100000.0)
        let lng = round(lng_f * 100000.0)
        push(s_parts, _pe_enc(lat - plat))
        push(s_parts, _pe_enc(lng - plng))
        plat = lat
        plng = lng
    let s = join(s_parts, "")
    s
