// ============================================================================
// NOVA Standard Library — std/data/opml_build
// ============================================================================
// OPML builder — emit OPML XML from a {title, outlines} document dict.
//
// PUBLIC API
//   opml_build(doc) -> string
//     Build an OPML 2.0 XML string from a document dict.
//     doc must be: {"title": string, "outlines": list}
//     Each outline: {"text": string, "xmlUrl": string, "children": list}
//     Nested outlines are emitted recursively.
//     Outlines with non-empty xmlUrl get a xmlUrl attribute.
//     Outlines with no children are self-closing (<outline ... />).
//     Outlines with children get paired open/close tags.
//
// EXAMPLES
//   let doc = {}
//   doc["title"] = "My Feeds"
//   let outlines = []
//   let o = {}
//   o["text"] = "NOVA"
//   o["xmlUrl"] = "http://x/f"
//   o["children"] = []
//   push(outlines, o)
//   doc["outlines"] = outlines
//   let xml = opml_build(doc)
//   // xml contains <opml>, <title>My Feeds</title>, text="NOVA" xmlUrl="http://x/f"
//
// IMPLEMENTATION NOTES
//   • Leaf module — imports nothing.
//   • All private helpers prefixed _obuild_ to avoid link collisions.
//   • chr(34)='"' (double quote for attribute values).
//   • XML attribute values are NOT escaped (OPML text/URLs normally ASCII-safe).
//     Full escaping would require an additional import; per spec these fields
//     do not typically contain XML-special characters in OPML feeds.
//   • Uses a string-based recursive builder: renders each outline to a string,
//     then concatenates into the body section.
//   • Single-exit style throughout.
//   • LF = chr(10) for newlines.
// ============================================================================

// ── Private: build outline element string recursively ────────────────────────
// Renders an outline dict (and its children) to an XML string.
// Children are indented with `indent` leading spaces.

fn _obuild_outline(o, depth)
    let dq = chr(34)
    let lf = chr(10)
    // build indent: 4 spaces per depth level (min 4)
    let indent = ""
    let spaces = (depth + 1) * 4
    let si = 0
    while si < spaces
        indent = indent + " "
        si = si + 1
    let txt = o["text"]
    let xu = o["xmlUrl"]
    let kids = o["children"]
    let n_kids = len(kids)
    // build the attribute string
    let attrs = " text=" + dq + txt + dq
    if len(xu) > 0
        attrs = attrs + " xmlUrl=" + dq + xu + dq
    // check if self-closing or has children
    let result = ""
    if n_kids == 0
        // self-closing
        result = indent + "<outline" + attrs + "/>" + lf
    else
        // open tag
        let inner = ""
        let ki = 0
        while ki < n_kids
            inner = inner + _obuild_outline(kids[ki], depth + 1)
            ki = ki + 1
        result = indent + "<outline" + attrs + ">" + lf + inner + indent + "</outline>" + lf
    return result

// ── Public: opml_build ───────────────────────────────────────────────────────

// opml_build: build an OPML 2.0 XML string from a document dict.
//
// doc = {"title": string, "outlines": list}
// Each outline = {"text": string, "xmlUrl": string, "children": list}
//
// Returns a complete OPML XML string with <?xml ...?> header, <opml> root,
// <head><title>...</title></head>, and <body> with nested <outline> elements.
fn opml_build(doc)
    let dq = chr(34)
    let lf = chr(10)
    let title = doc["title"]
    let outlines = doc["outlines"]
    let n = len(outlines)
    // build body content
    let body_inner = ""
    let i = 0
    while i < n
        body_inner = body_inner + _obuild_outline(outlines[i], 0)
        i = i + 1
    // assemble document
    let xml = "<?xml version=" + dq + "1.0" + dq + " encoding=" + dq + "UTF-8" + dq + "?>" + lf
    xml = xml + "<opml version=" + dq + "2.0" + dq + ">" + lf
    xml = xml + "<head>" + lf
    xml = xml + "    <title>" + title + "</title>" + lf
    xml = xml + "</head>" + lf
    xml = xml + "<body>" + lf
    xml = xml + body_inner
    xml = xml + "</body>" + lf
    xml = xml + "</opml>" + lf
    return xml
