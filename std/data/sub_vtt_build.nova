// ============================================================================
// NOVA Standard Library — std/data/sub_vtt_build
// ============================================================================
// WebVTT subtitle builder.
//
// PUBLIC API:
//   vtt_build_cue(cue) -> string
//     Render a single cue dict to WebVTT text (no trailing blank line).
//     cue: {"index":int, "start":ms_int, "end":ms_int, "text":string}
//     Produces:  "<index>\r\n00:00:01.000 --> 00:00:04.000\r\ntext"
//     (uses LF only, no CRLF)
//
//   vtt_build(cues) -> string
//     Render a list of cue dicts to a full WebVTT document.
//     Starts with "WEBVTT\n\n"; cues are separated by blank lines.
//
// TIMECODE FORMAT: "HH:MM:SS.mmm"  (dot separator)
//
// DESIGN NOTES:
//   - LEAF module — imports nothing (inline timecode helpers).
//   - Single-exit style.
//   - No module-level constants.
//   - No multi-line list/dict literals.
// ============================================================================

// ── Private: zero-pad an int to a minimum width ──────────────────────────────

fn _vb_pad2(n) -> string
    let s = str(n)
    let result = s
    if len(s) < 2
        result = "0" + s
    result

fn _vb_pad3(n) -> string
    let s = str(n)
    let result = s
    if len(s) < 3
        result = "00" + s
    if len(s) == 1
        result = "00" + s
    if len(s) == 2
        result = "0" + s
    result

// ── Private: milliseconds -> "HH:MM:SS.mmm" ─────────────────────────────────

fn _vb_ms_to_tc(ms) -> string
    let h = ms / 3600000
    let rem1 = ms - h * 3600000
    let m = rem1 / 60000
    let rem2 = rem1 - m * 60000
    let s = rem2 / 1000
    let mspart = rem2 - s * 1000
    _vb_pad2(h) + ":" + _vb_pad2(m) + ":" + _vb_pad2(s) + "." + _vb_pad3(mspart)

// ── Public: vtt_build_cue ─────────────────────────────────────────────────────

fn vtt_build_cue(cue) -> string
    let nl = chr(10)
    let idx = cue["index"]
    let start_ms = cue["start"]
    let end_ms = cue["end"]
    let txt = cue["text"]
    let timing = _vb_ms_to_tc(start_ms) + " --> " + _vb_ms_to_tc(end_ms)
    str(idx) + nl + timing + nl + txt

// ── Public: vtt_build ────────────────────────────────────────────────────────

fn vtt_build(cues) -> string
    let nl = chr(10)
    let result = "WEBVTT" + nl + nl
    let n = len(cues)
    let i = 0
    while i < n
        let cue = cues[i]
        let cue_str = vtt_build_cue(cue)
        result = result + cue_str + nl
        if i < n - 1
            result = result + nl
        i = i + 1
    result
