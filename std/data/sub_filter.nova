// ============================================================================
// NOVA Standard Library — std/data/sub_filter
// ============================================================================
// Subtitle cue filtering: spatial/temporal range queries, substring search,
// and point-in-time lookup.
//
// CUE SHAPE: dict {"index":int,"start":ms,"end":ms,"text":string}
//   where ms = milliseconds from epoch (integer).
//
// PUBLIC API
//   sub_in_range(cues, from_ms, to_ms) -> list
//       Cues that OVERLAP the window [from_ms, to_ms].
//       Overlap condition: cue.start < to_ms AND cue.end > from_ms.
//
//   sub_search(cues, needle) -> list
//       Cues whose "text" field contains `needle` as a substring.
//
//   sub_at(cues, time_ms) -> dict
//       The first cue active at time_ms (start <= time_ms < end).
//       Returns an empty dict {} if no cue is active.
//
//   sub_remove_range(cues, from_ms, to_ms) -> list
//       Cues that do NOT overlap [from_ms, to_ms] — inverse of sub_in_range.
//
//   sub_remove_empty(cues) -> list
//       Cues whose "text" field is non-empty after trimming leading/
//       trailing spaces and tabs (a cue that is purely whitespace is
//       treated as empty). Order is preserved; indices are NOT reassigned
//       (pipe through sub_reindex from std/data/sub_reindex if sequential
//       1..N numbering is also required).
//       Related: sub_dedup (std/data/sub_merge) removes consecutive
//       duplicate cues — a distinct concern from removing blank cues.
//
// LEAF — imports NOTHING.
// ============================================================================

// _sf_contains_substr: returns 1 if `haystack` contains `needle`, else 0.
// Uses split-based detection: if splitting on needle yields >1 part it's present.
fn _sf_contains_substr(haystack, needle)
    if len(needle) == 0
        return 1
    let parts = split(haystack, needle)
    let result = 0
    if len(parts) > 1
        result = 1
    return result

// _sf_is_blank: true (1) if s is empty or contains only spaces/tabs/CR/LF.
// Byte-indexed (str_to_bytes/bytes_get, O(1) random access), single
// top-level loop — O(n), consistent with this module's other scans.
fn _sf_is_blank(s)
    let bts = str_to_bytes(s)
    let n = bytes_len(bts)
    let i = 0
    let blank = 1
    while i < n and blank == 1
        let b = bytes_get(bts, i)
        if b != 32 and b != 9 and b != 13 and b != 10
            blank = 0
        i = i + 1
    return blank

// sub_remove_empty: return cues whose "text" is non-blank. Order preserved;
// indices are left as-is (see sub_reindex to renumber sequentially).
//
// Examples:
//   sub_remove_empty([{text:"Hi"},{text:""},{text:"  "}]) -> [{text:"Hi"}]
fn sub_remove_empty(cues)
    let result = []
    let n = len(cues)
    for i in 0..n
        let c = cues[i]
        if _sf_is_blank(c["text"]) == 0
            push(result, c)
    return result

// sub_in_range: return cues whose time interval overlaps [from_ms, to_ms].
//
// A cue overlaps the window iff cue.start < to_ms AND cue.end > from_ms.
// Cues that merely touch the boundary (start==to_ms or end==from_ms) are
// excluded (half-open interval semantics).
//
// Examples:
//   cue [1000,4000] vs window [0,3000]    -> overlap (1000<3000, 4000>0)
//   cue [5000,8000] vs window [8000,9000] -> no overlap (5000<9000, 8000>8000 FALSE)
fn sub_in_range(cues, from_ms, to_ms)
    let result = []
    let n = len(cues)
    for i in 0..n
        let c = cues[i]
        let cstart = c["start"]
        let cend = c["end"]
        if cstart < to_ms and cend > from_ms
            push(result, c)
    return result

// sub_search: return cues whose "text" field contains `needle` as a substring.
//
// The search is case-sensitive. An empty needle matches every cue.
//
// Examples:
//   sub_search(cues, "Hello")  -> cues where text contains "Hello"
//   sub_search(cues, "")       -> all cues
fn sub_search(cues, needle)
    let result = []
    let n = len(cues)
    for i in 0..n
        let c = cues[i]
        let txt = c["text"]
        if _sf_contains_substr(txt, needle) == 1
            push(result, c)
    return result

// sub_at: return the first cue active at the given time_ms.
//
// A cue is active when start <= time_ms AND time_ms < end.
// Returns an empty dict {} if no cue is active at that moment.
//
// Scans in index order; returns the first match (lowest index).
//
// Examples:
//   sub_at(cues, 6000) -> cue with start=5000,end=8000
//   sub_at(cues, 4500) -> {} (gap between cues)
fn sub_at(cues, time_ms)
    let result = {}
    let n = len(cues)
    let i = 0
    let found = 0
    while i < n and found == 0
        let c = cues[i]
        let cstart = c["start"]
        let cend = c["end"]
        if cstart <= time_ms and time_ms < cend
            result = c
            found = 1
        i = i + 1
    return result

// sub_remove_range: return cues that do NOT overlap [from_ms, to_ms].
//
// This is the complement of sub_in_range: cues are kept when they do NOT
// satisfy (start < to_ms AND end > from_ms).
//
// Examples:
//   sub_remove_range(cues, 4000, 6000) -> cues completely outside [4000,6000]
fn sub_remove_range(cues, from_ms, to_ms)
    let result = []
    let n = len(cues)
    for i in 0..n
        let c = cues[i]
        let cstart = c["start"]
        let cend = c["end"]
        let overlaps = 0
        if cstart < to_ms and cend > from_ms
            overlaps = 1
        if overlaps == 0
            push(result, c)
    return result
