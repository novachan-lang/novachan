// ============================================================================
// NOVA Standard Library — std/data/asn1_null
// ============================================================================
// ASN.1 DER NULL (tag 0x05) encoder/decoder + generic TLV builder.
//
// PUBLIC API:
//   asn1_null_encode() -> bytes
//     Returns the 2-byte DER encoding of NULL: [0x05, 0x00].
//
//   asn1_null_decode(b, pos) -> int
//     If b[pos] == 0x05 and b[pos+1] == 0x00 (valid DER NULL), returns pos+2
//     (the position of the next TLV in the buffer).  Returns -1 on any error:
//     wrong tag, non-zero length byte, or truncated input.
//
//   asn1_tlv(tag, content) -> bytes
//     Generic TLV builder.  Prepends tag byte and DER-encoded length to
//     content and returns the complete TLV.
//     Length encoding (X.690 §8.1.3, DER minimal form):
//       0..127        — short form: 1 byte equal to the length.
//       128..255      — long form: 0x81 then 1 length byte.
//       256..65535    — long form: 0x82 then 2 length bytes (big-endian).
//
// DESIGN NOTES:
//   - LEAF module — no imports.
//   - All bounds-checked: asn1_null_decode inspects bytes_len before each read.
//   - Single-exit style throughout (avoids NOVA return-null mistag bug).
//   - Only bytes API used for binary data; never string+chr.
//
// KAT VECTORS (X.690 / RFC 5280 verified):
//   asn1_null_encode()              == [0x05, 0x00]          (2 bytes)
//   asn1_null_decode([0x05,0x00],0) == 2                     (next pos)
//   asn1_null_decode([0x02,0x01,0x00],0) == -1               (wrong tag)
//   asn1_tlv(0x04, bytes{0x01,0x02,0x03}) == [0x04,0x03,0x01,0x02,0x03]
//   asn1_tlv(0x04, 200-byte content) starts with [0x04,0x81,0xC8]
// ============================================================================

// asn1_tlv: build a DER TLV from tag byte and pre-built content bytes.
//
// DER requires the minimal length encoding:
//   short form  for 0..127   -> 1 byte
//   0x81 + byte for 128..255 -> 2 bytes
//   0x82 + hi + lo for 256.. -> 3 bytes
fn asn1_tlv(tag, content) -> any
    let clen = bytes_len(content)
    let out = bytes(0)
    out = bytes_append(out, tag)
    if clen < 128
        out = bytes_append(out, clen)
    else
        if clen < 256
            out = bytes_append(out, 129)
            out = bytes_append(out, clen)
        else
            let hi = clen / 256
            let lo = clen % 256
            out = bytes_append(out, 130)
            out = bytes_append(out, hi)
            out = bytes_append(out, lo)
    out = bytes_concat(out, content)
    out

// asn1_null_encode: return the 2-byte DER encoding of the NULL value.
//
// NULL TLV = tag(0x05) || length(0x00).  There is no value body.
fn asn1_null_encode() -> any
    let out = bytes(0)
    out = bytes_append(out, 5)
    out = bytes_append(out, 0)
    out

// asn1_null_decode: validate and consume a DER NULL TLV at position pos in b.
//
// Returns pos+2 (next position) on success.
// Returns -1 if:
//   - buffer too short to hold 2 bytes at pos
//   - b[pos]   != 0x05 (not a NULL tag)
//   - b[pos+1] != 0x00 (non-zero length — malformed DER NULL)
fn asn1_null_decode(b, pos) -> int
    let blen = bytes_len(b)
    let result = -1
    if blen >= pos + 2
        let tag = bytes_get(b, pos)
        let lenb = bytes_get(b, pos + 1)
        if tag == 5
            if lenb == 0
                result = pos + 2
    result
