// ============================================================================
// NOVA Standard Library — std/data/wkt_build
// ============================================================================
// Build WKT (Well-Known Text) geometry strings from structured dicts.
//
// PUBLIC API:
//   wkt_build(geom) -> string
//     Serialize a geometry dict to WKT.  geom must be a dict with:
//       "type"   -> string: "POINT", "LINESTRING", or "POLYGON"
//       "coords" -> list of [x, y] float pairs
//     Supported types:
//       POINT   — emits "POINT(x y)"
//       LINESTRING — emits "LINESTRING(x y, x y, ...)"
//       POLYGON — emits "POLYGON((x y, x y, ...))"  (single outer ring)
//     Returns "" for an unrecognised type or empty coords for non-POINT types.
//
// NUMBER FORMAT:
//   Coordinates are formatted as integers when the value has no fractional
//   part (i.e., value == floor(value)), and as decimals otherwise.
//   Examples: 1.0 -> "1", 1.5 -> "1.5", -2.0 -> "-2", -2.5 -> "-2.5".
//   This matches the common WKT convention seen in PostGIS, GDAL, etc.
//   wkt_parse(wkt_build(g)) round-trips type and coords within tolerance.
//
// DESIGN NOTES:
//   - Imports std/data/wkt_parse for round-trip testing support.
//   - Numbers with zero fractional part are emitted as integers (no ".0").
//   - Uses parse_float / str builtin; integer check via modulo 1 == 0.
//   - No multi-line list/dict literals in module body.
//   - "coords" list MUST contain [x, y] pairs; no Z coordinate emitted.
// ============================================================================

import std/data/wkt_parse

// ── Private: number formatting ────────────────────────────────────────────────

// Format a float for WKT output.  If the value is a whole number (no
// fractional part), emit it as an integer string; otherwise as a decimal.
// Examples: 1.0 -> "1", 1.5 -> "1.5", -2.0 -> "-2", -2.75 -> "-2.75".
fn _wktb_fmt_num(f) -> string
    // We detect "whole number" by: f - floor(f) == 0.
    // In NOVA we have no floor() builtin, so we check via str(f) for ".0" suffix.
    // Strategy: convert to string and check whether it ends in ".0" or has no ".".
    let s = str(f)
    let n = len(s)
    // Check if s ends with ".0" exactly (str(1.0) = "1.0" in NOVA).
    let is_whole = n >= 2 and char_at(s, n - 2) == "." and char_at(s, n - 1) == "0"
    // Emit without ".0" (strip last 2 chars) when whole, else as-is.
    slice(s, 0, n - 2) if is_whole else s

// ── Private: coordinate pair formatting ──────────────────────────────────────

// Format a [x, y] pair as "x y" string.
fn _wktb_fmt_pair(pair) -> string
    let xf = pair[0]
    let yf = pair[1]
    let xs = _wktb_fmt_num(xf)
    let ys = _wktb_fmt_num(yf)
    xs + " " + ys

// Format a list of [x,y] pairs as comma-separated "x y" strings.
fn _wktb_fmt_pairs(coords) -> string
    join([_wktb_fmt_pair(p) for p in coords], ", ")

// ── Public API ───────────────────────────────────────────────────────────────

// wkt_build: serialize a {type, coords} dict to a WKT string.
fn wkt_build(geom) -> string
    let result = ""
    let geom_type = geom["type"]
    let coords = geom["coords"]
    let nc = len(coords)
    if geom_type == "POINT"
        if nc > 0
            result = "POINT(" + _wktb_fmt_pair(coords[0]) + ")"
    else if geom_type == "LINESTRING"
        if nc > 0
            result = "LINESTRING(" + _wktb_fmt_pairs(coords) + ")"
    else if geom_type == "POLYGON"
        if nc > 0
            result = "POLYGON((" + _wktb_fmt_pairs(coords) + "))"
    result

// wkt_build_approx: float comparison within tolerance (re-exported for tests).
fn wkt_build_approx(a, b, tol) -> int
    wkt_approx(a, b, tol)
