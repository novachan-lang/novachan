// ============================================================================
// NOVA Standard Library — std/data/geo_convert
// ============================================================================
// Convert geometry type names between GeoJSON and WKT representations,
// and parse WKT point strings into coordinate lists.
//
// PUBLIC API
//   wkt_to_geojson_type(wkt_type) -> string
//     Convert a WKT geometry type name to its GeoJSON equivalent.
//     "POINT"      -> "Point"
//     "LINESTRING" -> "LineString"
//     "POLYGON"    -> "Polygon"
//     Unknown input -> returned as-is (no crash).
//
//   geojson_to_wkt_type(geojson_type) -> string
//     Convert a GeoJSON geometry type name to its WKT equivalent.
//     "Point"      -> "POINT"
//     "LineString" -> "LINESTRING"
//     "Polygon"    -> "POLYGON"
//     Unknown input -> returned as-is.
//
//   point_wkt_to_coords(wkt) -> list
//     Parse a WKT POINT string of the form "POINT(lon lat)" or
//     "POINT (lon lat)" and return [lon, lat] as a list of floats.
//     Returns [] on parse failure.
//
// DESIGN NOTES
//   - LEAF module — imports nothing.
//   - String-search for WKT point parsing.
//   - Floats parsed with parse_float builtin.
//   - Single-exit style throughout.
// ============================================================================

// ── Private: index_of ────────────────────────────────────────────────────────

fn _gc_index_of(s, needle, pos) -> int
    let sn = len(s)
    let nn = len(needle)
    let result = -1
    let i = pos
    let done = 0
    while i <= sn - nn and done == 0
        let matched = 1
        let j = 0
        while j < nn and matched == 1
            if char_at(s, i + j) != char_at(needle, j)
                matched = 0
            j += 1
        if matched == 1
            result = i
            done = 1
        i += 1
    result

// ── Private: skip whitespace starting at pos ─────────────────────────────────

fn _gc_skip_ws(s, pos) -> int
    let n = len(s)
    let i = pos
    let done = 0
    while i < n and done == 0
        let c = char_at(s, i)
        if c == " " or c == "\t" or c == "\n" or c == "\r"
            i += 1
        else
            done = 1
    i

// ── Private: read a number token starting at pos ──────────────────────────────
// Returns [token_string, next_pos].

fn _gc_read_number(s, pos) -> list
    let n = len(s)
    let i = pos
    let done = 0
    while i < n and done == 0
        let c = char_at(s, i)
        if c == "-" or c == "+" or c == "." or c == "e" or c == "E"
            i += 1
        else if c >= "0" and c <= "9"
            i += 1
        else
            done = 1
    let tok = slice(s, pos, i)
    let out = []
    push(out, tok)
    push(out, i)
    out

// ── Public: wkt_to_geojson_type ──────────────────────────────────────────────

fn wkt_to_geojson_type(wkt_type) -> string
    let result = wkt_type
    if wkt_type == "POINT"
        result = "Point"
    else if wkt_type == "LINESTRING"
        result = "LineString"
    else if wkt_type == "POLYGON"
        result = "Polygon"
    else if wkt_type == "MULTIPOINT"
        result = "MultiPoint"
    else if wkt_type == "MULTILINESTRING"
        result = "MultiLineString"
    else if wkt_type == "MULTIPOLYGON"
        result = "MultiPolygon"
    else if wkt_type == "GEOMETRYCOLLECTION"
        result = "GeometryCollection"
    result

// ── Public: geojson_to_wkt_type ──────────────────────────────────────────────

fn geojson_to_wkt_type(geojson_type) -> string
    let result = geojson_type
    if geojson_type == "Point"
        result = "POINT"
    else if geojson_type == "LineString"
        result = "LINESTRING"
    else if geojson_type == "Polygon"
        result = "POLYGON"
    else if geojson_type == "MultiPoint"
        result = "MULTIPOINT"
    else if geojson_type == "MultiLineString"
        result = "MULTILINESTRING"
    else if geojson_type == "MultiPolygon"
        result = "MULTIPOLYGON"
    else if geojson_type == "GeometryCollection"
        result = "GEOMETRYCOLLECTION"
    result

// ── Public: point_wkt_to_coords ──────────────────────────────────────────────
// Parse "POINT(lon lat)" or "POINT (lon lat)" -> [lon_float, lat_float].
// Returns [] on failure.

fn point_wkt_to_coords(wkt) -> list
    let result = []
    // Find the opening parenthesis
    let paren_pos = _gc_index_of(wkt, "(", 0)
    if paren_pos >= 0
        // Find the closing parenthesis
        let close_pos = _gc_index_of(wkt, ")", paren_pos)
        if close_pos > paren_pos
            // Extract the content between parens
            let inner = slice(wkt, paren_pos + 1, close_pos)
            // Skip leading whitespace
            let i = _gc_skip_ws(inner, 0)
            let n = len(inner)
            // Read first number (longitude)
            if i < n
                let pair1 = _gc_read_number(inner, i)
                let tok1 = pair1[0]
                let next1 = pair1[1]
                if len(tok1) > 0
                    // Skip whitespace between numbers
                    let i2 = _gc_skip_ws(inner, next1)
                    if i2 < n
                        // Read second number (latitude)
                        let pair2 = _gc_read_number(inner, i2)
                        let tok2 = pair2[0]
                        if len(tok2) > 0
                            let flon = parse_float(tok1)
                            let flat = parse_float(tok2)
                            push(result, flon)
                            push(result, flat)
    result
