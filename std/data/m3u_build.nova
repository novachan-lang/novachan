// ============================================================================
// NOVA Standard Library — std/data/m3u_build
// ============================================================================
// Build M3U / M3U8 playlist text from a list of entry dicts.
//
// PUBLIC API
//   m3u_build(entries) -> string
//
// Each entry is a dict with keys "duration" (int), "title" (string), "url" (string).
// Output format:
//   First line: "#EXTM3U"
//   Per entry with duration >= 0 OR non-empty title:
//     "#EXTINF:<duration>,<title>"  then the URL.
//   Per entry with duration < 0 AND empty title:
//     Just the URL (no EXTINF line).
//
// LEAF module — imports nothing.
// ============================================================================

// _m3u_build_itostr: convert int to decimal string (handles negatives)
fn _m3u_build_itostr(n)
    let result = ""
    if n == 0
        result = "0"
    else
        let neg = 0
        let v = n
        if n < 0
            neg = 1
            v = -n
        let s = ""
        while v > 0
            let d = v - (v / 10) * 10
            s = char_at("0123456789", d) + s
            v = v / 10
        if neg == 1
            s = "-" + s
        result = s
    return result

// m3u_build: generate M3U playlist text.
fn m3u_build(entries)
    let lf = chr(10)
    let out = "#EXTM3U" + lf
    for i in 0..len(entries)
        let entry = entries[i]
        let dur = entry["duration"] if "duration" in entry else -1
        let title = entry["title"] if "title" in entry else ""
        let url = entry["url"] if "url" in entry else ""
        // Emit EXTINF if duration >= 0 OR title non-empty
        if dur >= 0 or len(title) > 0
            out += "#EXTINF:" + _m3u_build_itostr(dur) + "," + title + lf
        out += url + lf
    return out
