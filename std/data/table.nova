// ============================================================================
// std/data/table — a schema-enforced, incrementally-built in-memory table
// ============================================================================
// std/data/tabular.nova already provides pure query functions (tb_select,
// tb_filter, tb_sort_by, tb_group_count, ...) over an EXISTING, freeform
// list of row-dicts that the caller assembles however they like — it never
// enforces that every row shares the same shape. This module is the
// complementary piece: a stateful table OBJECT with a fixed column schema,
// built up one row at a time via tbl_insert (like a lightweight, in-memory
// DataFrame you populate incrementally — e.g. while streaming rows out of
// a parser or a query result), plus a self-contained CSV exporter. Every
// row inserted is normalized to exactly the table's declared columns
// (missing fields become "", extra fields are dropped) — so, unlike
// tabular.nova's rows, every row in a `table` is guaranteed uniform.
//
// Representation:
//   {"tbl_cols": list<string>, "tbl_rows": list<dict>}
//   Each row dict has exactly the keys in tbl_cols.
//
// Public API:
//   tbl_new(columns)            -> table   columns: list of column-name strings
//   tbl_insert(t, row)                     append row (dict), normalized to t's schema
//   tbl_select(t, column_list)  -> table   project to a subset of columns (new table)
//   tbl_where(t, column, value) -> table   filter rows where str(row[column]) == str(value)
//   tbl_count(t)                -> int     number of rows
//   tbl_column_values(t, col)   -> list    every value in column col, row order
//   tbl_to_csv(t)                -> string  header row + data rows, RFC-4180-style quoting
//
// LEAF module — imports nothing.
// ============================================================================

// tbl_new: an empty table with the given column schema.
fn tbl_new(columns) -> dict
    let t = {}
    let cols = []
    for c in columns
        push(cols, c)
    t["tbl_cols"] = cols
    t["tbl_rows"] = []
    return t

// tbl_insert: append row (a dict) to the table, normalized to exactly the
// table's declared columns — a column missing from row becomes "" in the
// stored row; keys in row that aren't part of the schema are dropped.
fn tbl_insert(t, row)
    let cols = t["tbl_cols"]
    let rows = t["tbl_rows"]
    let new_row = {}
    for c in cols
        if contains(row, c)
            new_row[c] = row[c]
        else
            new_row[c] = ""
    push(rows, new_row)
    t["tbl_rows"] = rows

// tbl_select: a new table containing only the given columns (in the given
// order) from every row of t.
fn tbl_select(t, column_list) -> dict
    let out = tbl_new(column_list)
    let out_rows = out["tbl_rows"]
    for row in t["tbl_rows"]
        let new_row = {}
        for c in column_list
            if contains(row, c)
                new_row[c] = row[c]
            else
                new_row[c] = ""
        push(out_rows, new_row)
    out["tbl_rows"] = out_rows
    return out

// tbl_where: a new table (same schema as t) containing only the rows where
// str(row[column]) == str(value). Rows missing the column are excluded.
fn tbl_where(t, column, value) -> dict
    let out = tbl_new(t["tbl_cols"])
    let out_rows = out["tbl_rows"]
    for row in t["tbl_rows"]
        if contains(row, column)
            if str(row[column]) == str(value)
                push(out_rows, row)
    out["tbl_rows"] = out_rows
    return out

// tbl_count: number of rows currently in the table.
fn tbl_count(t) -> int
    return len(t["tbl_rows"])

// tbl_column_values: the value of column col from every row, in row order
// ("" for any row somehow missing it — should not happen for a table built
// exclusively through tbl_insert/tbl_select/tbl_where).
fn tbl_column_values(t, col) -> list
    let out = []
    for row in t["tbl_rows"]
        if contains(row, col)
            push(out, row[col])
        else
            push(out, "")
    return out

// _tbl_csv_escape: quote a field for CSV output if it contains a comma, a
// double-quote, or a newline — doubling any internal double-quotes.
fn _tbl_csv_escape(field) -> string
    let s = str(field)
    let needs_quote = false
    if find(s, ",") >= 0
        needs_quote = true
    if find(s, "\"") >= 0
        needs_quote = true
    if find(s, "\n") >= 0
        needs_quote = true
    if not needs_quote
        return s
    let escaped = replace(s, "\"", "\"\"")
    return "\"" + escaped + "\""

// tbl_to_csv: render the table as CSV text — a header row of column names
// followed by one row per data row, LF-separated, no trailing newline.
fn tbl_to_csv(t) -> string
    let cols = t["tbl_cols"]
    let header_parts = []
    for c in cols
        push(header_parts, _tbl_csv_escape(c))
    let lines = []
    push(lines, join(header_parts, ","))
    for row in t["tbl_rows"]
        let parts = []
        for c in cols
            let v = ""
            if contains(row, c)
                v = row[c]
            push(parts, _tbl_csv_escape(v))
        push(lines, join(parts, ","))
    return join(lines, "\n")
