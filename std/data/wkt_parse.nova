// ============================================================================
// NOVA Standard Library — std/data/wkt_parse
// ============================================================================
// Parse WKT (Well-Known Text) geometry into a dict.
//
// PUBLIC API:
//   wkt_parse(wkt) -> dict
//     Parse a WKT string and return {"type": <string>, "coords": <list>}.
//     Supported types:
//       POINT(x y)
//       LINESTRING(x y, x y, ...)
//       POLYGON((x y, x y, x y, ...))   — only outer ring; holes ignored
//     "coords" is a list of [x, y] pairs (each a 2-element float list).
//     Returns {"type": "UNKNOWN", "coords": []} for unrecognised input.
//
//   wkt_approx(a, b, tol) -> int
//     Float comparison within tolerance.  Exported for tests.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - Type keyword detected case-insensitively by uppercasing via ord/chr.
//   - Coordinate parsing: strip outer parentheses then split on "," for
//     multi-point types.  Each "x y" pair is split on the first run of
//     whitespace to extract x and y tokens.
//   - Uses parse_float for correct float boxing.
//   - No multi-line list/dict literals in module body.
//   - State-machine loops (no nested breaks) for all string scanning.
// ============================================================================

// ── Private: string utilities ─────────────────────────────────────────────────

// Trim leading and trailing ASCII whitespace (space, tab, LF, CR).
fn _wkt_trim(s) -> string
    let n = len(s)
    let lft = 0
    let rgt = n
    // Advance left past whitespace.
    let i = 0
    let done = 0
    while i < n
        if done == 0
            let c = ord(char_at(s, i))
            if _wkt_is_ws(c) == 1
                lft = i + 1
            else
                done = 1
        i += 1
    // Advance right past whitespace.
    let j = n - 1
    let done2 = 0
    while j >= lft
        if done2 == 0
            let c2 = ord(char_at(s, j))
            if _wkt_is_ws(c2) == 1
                rgt = j
            else
                done2 = 1
        j -= 1
    let result = ""
    if rgt > lft
        result = slice(s, lft, rgt)
    result

// Uppercase a single ASCII character.
fn _wkt_upper_char(ch) -> string
    let code = ord(ch)
    let result = ch
    if code >= 97
        if code <= 122
            result = chr(code - 32)
    result

// Return uppercase version of s (ASCII only).
fn _wkt_upper(s) -> string
    let n = len(s)
    let result_parts = []
    for i in 0..n
        push(result_parts, _wkt_upper_char(char_at(s, i)))
    let result = join(result_parts, "")
    result

// Return 1 if s starts with prefix (case-sensitive).
fn _wkt_starts_with(s, prefix) -> int
    let ns = len(s)
    let np = len(prefix)
    let ok = 1
    if np > ns
        ok = 0
    else
        for i in 0..np
            if char_at(s, i) != char_at(prefix, i)
                ok = 0
    ok

// ── Private: coordinate text extraction ──────────────────────────────────────

// Find the position of character ch in s at or after start.
// Returns -1 if not found.
fn _wkt_find_char(s, ch, start) -> int
    let n = len(s)
    let result = -1
    let i = start
    while i < n
        if result < 0
            if char_at(s, i) == ch
                result = i
        i += 1
    result

// Extract text inside the first balanced parentheses pair starting at or after
// `offset`.  Uses a depth counter so that nested parens are handled correctly.
// Returns the content between the matching '(' and ')'.
// If no '(' is found, returns "".
fn _wkt_inner_balanced(s, offset) -> string
    let n = len(s)
    let result = ""
    // Find the opening paren.
    let open_pos = _wkt_find_char(s, "(", offset)
    if open_pos >= 0
        let depth = 1
        let k = open_pos + 1
        let close_pos = -1
        while k < n
            if close_pos < 0
                if char_at(s, k) == "("
                    depth += 1
                else
                    if char_at(s, k) == ")"
                        depth -= 1
                        if depth == 0
                            close_pos = k
            k += 1
        if close_pos > open_pos
            result = slice(s, open_pos + 1, close_pos)
    result

// ── Private: token splitting ──────────────────────────────────────────────────

// Return 1 if ord value is whitespace (space/tab/LF/CR).
fn _wkt_is_ws(code) -> int
    let result = 0
    if code == 32
        result = 1
    if code == 9
        result = 1
    if code == 10
        result = 1
    if code == 13
        result = 1
    result

// Split s on the first run of whitespace.  Returns a 2-element list [a, b].
// If no whitespace found, returns [s, ""].
fn _wkt_split2(s) -> list
    let n = len(s)
    let split_at = -1
    let i = 0
    while i < n
        if split_at < 0
            if _wkt_is_ws(ord(char_at(s, i))) == 1
                split_at = i
        i += 1
    let result = []
    if split_at < 0
        result.push(s)
        result.push("")
    else
        let a = slice(s, 0, split_at)
        // Skip whitespace run using state machine: find first non-ws after split_at.
        let rest_start = n
        let j = split_at
        let found_nonws = 0
        while j < n
            if found_nonws == 0
                if _wkt_is_ws(ord(char_at(s, j))) == 0
                    rest_start = j
                    found_nonws = 1
            j += 1
        let b = slice(s, rest_start, n)
        result.push(a)
        result.push(b)
    result

// Split s on top-level commas (i.e., commas not inside parentheses).
// For WKT, we only need top-level commas (LINESTRING / POLYGON ring).
// Uses a paren-depth counter; for POINT there are no commas so returns [s].
fn _wkt_split_coords(s) -> list
    let tokens = []
    let n = len(s)
    let depth = 0
    let tstart = 0
    for i in 0..n
        let ch = char_at(s, i)
        if ch == "("
            depth += 1
        else
            if ch == ")"
                depth -= 1
            else
                if ch == ","
                    if depth == 0
                        tokens.push(slice(s, tstart, i))
                        tstart = i + 1
    // Final token.
    if tstart <= n
        let last = slice(s, tstart, n)
        let trimmed = _wkt_trim(last)
        if len(trimmed) > 0
            tokens.push(last)
    tokens

// ── Private: parse one "x y" pair ────────────────────────────────────────────

// Parse a trimmed "x y" string into a [x, y] float pair.
// Returns [] on failure.
fn _wkt_parse_xy(xy_str) -> list
    let result = []
    let trimmed = _wkt_trim(xy_str)
    let parts = _wkt_split2(trimmed)
    if len(parts) >= 2
        let xs = _wkt_trim(parts[0])
        let ys = _wkt_trim(parts[1])
        if len(xs) > 0
            if len(ys) > 0
                let xf = parse_float(xs)
                let yf = parse_float(ys)
                let pair = []
                pair.push(xf)
                pair.push(yf)
                result = pair
    result

// Parse a comma-split coordinate-list body (already inside its balanced
// parens) into a list of [x, y] float pairs.  Skips any pair that fails
// to parse (len != 2).
fn _wkt_parse_pairs(inner) -> list
    let coords = []
    let parts = _wkt_split_coords(inner)
    let np = len(parts)
    for i in 0..np
        let pair = _wkt_parse_xy(parts[i])
        if len(pair) == 2
            coords.push(pair)
    coords

// ── Public API ───────────────────────────────────────────────────────────────

// wkt_approx: float comparison within tolerance.
fn wkt_approx(a, b, tol) -> int
    let diff = a - b
    let result = 0
    if diff < 0.0
        diff = 0.0 - diff
    if diff <= tol
        result = 1
    result

// wkt_parse: parse a WKT string into {type, coords}.
//
// Supported:  POINT(x y)
//             LINESTRING(x y, x y, ...)
//             POLYGON((x y, x y, x y, ...))  — outer ring only
//
// "coords" = list of [x, y] float pairs.
// Unknown/malformed input returns {type:"UNKNOWN", coords:[]}.
fn wkt_parse(wkt) -> dict
    let result = {}
    result["type"] = "UNKNOWN"
    result["coords"] = []
    let s = _wkt_trim(wkt)
    let su = _wkt_upper(s)
    // Detect geometry type.
    let geom_type = "UNKNOWN"
    if _wkt_starts_with(su, "POINT") == 1
        geom_type = "POINT"
    if _wkt_starts_with(su, "LINESTRING") == 1
        geom_type = "LINESTRING"
    if _wkt_starts_with(su, "POLYGON") == 1
        geom_type = "POLYGON"
    result["type"] = geom_type
    if geom_type != "UNKNOWN"
        // Extract coordinate content.
        let coords = []
        if geom_type == "POINT"
            // POINT(x y) — single pair inside balanced parens.
            let inner = _wkt_inner_balanced(s, 0)
            let pair = _wkt_parse_xy(inner)
            if len(pair) == 2
                coords.push(pair)
        else
            if geom_type == "LINESTRING"
                // LINESTRING(x y, x y, ...) — all pairs inside balanced parens.
                let inner = _wkt_inner_balanced(s, 0)
                coords = _wkt_parse_pairs(inner)
            else
                // POLYGON((x y, x y, ...)) — outer content is ((ring)); peel twice.
                // First peel: content of POLYGON(...) = (ring).
                let outer = _wkt_inner_balanced(s, 0)
                // Second peel: content of (ring) = ring points.
                let ring = _wkt_inner_balanced(outer, 0)
                coords = _wkt_parse_pairs(ring)
        result["coords"] = coords
    result
