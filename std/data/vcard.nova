// ============================================================================
// NOVA Standard Library — std/data/vcard
// ============================================================================
// Minimal vCard 3.0 (RFC 2426-style) parser/builder. Handles the common
// single-line properties BEGIN/VERSION/END/FN/N/TEL/EMAIL/ORG. Property
// parameters (e.g. "TEL;TYPE=CELL:...") are recognized and stripped down to
// the base property name; the parameter itself is discarded. Line folding
// (RFC continuation lines starting with a space) and multi-valued repeated
// properties are out of scope for this minimal module — a repeated property
// simply overwrites the previous value, matching "last write wins".
//
// A contact is represented as a plain dict keyed by the base property name
// in upper case, e.g. {"FN": "John Doe", "TEL": "+1-555-1234", ...}.
//
// Public API
//   vcd_parse(text)       -> list   list of contact dicts, one per
//                                    BEGIN:VCARD..END:VCARD block found.
//   vcd_get(contact, key) -> str    safe field lookup ("" if absent).
//   vcd_build(contact)    -> str    serialize one contact back to vCard text
//                                    (FN, N, TEL, EMAIL, ORG fields emitted,
//                                    in that fixed order, skipping any that
//                                    are absent/empty).
//   vcd_count(contacts)   -> int    number of parsed contacts.
// ============================================================================

// _vcd_find: index of the first occurrence of byte `code` in s, or -1.
fn _vcd_find(s, code) -> int
    let n = len(s)
    for i in 0..n
        if ord(s[i]) == code
            return i
    return -1

fn vcd_parse(text) -> list
    let lines = split(text, "\n")
    let contacts = []
    let cur = {}
    let inCard = false
    let i = 0
    let n = len(lines)
    while i < n
        let line = trim(lines[i])
        if len(line) > 0
            if line == "BEGIN:VCARD"
                cur = {}
                inCard = true
            else
                if line == "END:VCARD"
                    if inCard
                        push(contacts, cur)
                    inCard = false
                else
                    if inCard
                        let colon = _vcd_find(line, 58)     // ':'
                        if colon > 0
                            let keyPart = trim(slice(line, 0, colon))
                            let val = trim(slice(line, colon + 1, len(line)))
                            let semi = _vcd_find(keyPart, 59)   // ';'
                            let propName = keyPart
                            if semi >= 0
                                propName = slice(keyPart, 0, semi)
                            if propName != "VERSION" and propName != "BEGIN" and propName != "END"
                                cur[propName] = val
        i = i + 1
    return contacts

fn vcd_get(contact, key) -> str
    if contains(contact, key)
        return contact[key]
    return ""

fn vcd_build(contact) -> str
    let lines = []
    push(lines, "BEGIN:VCARD")
    push(lines, "VERSION:3.0")
    let fnVal = vcd_get(contact, "FN")
    if len(fnVal) > 0
        push(lines, "FN:" + fnVal)
    let nVal = vcd_get(contact, "N")
    if len(nVal) > 0
        push(lines, "N:" + nVal)
    let telVal = vcd_get(contact, "TEL")
    if len(telVal) > 0
        push(lines, "TEL:" + telVal)
    let emailVal = vcd_get(contact, "EMAIL")
    if len(emailVal) > 0
        push(lines, "EMAIL:" + emailVal)
    let orgVal = vcd_get(contact, "ORG")
    if len(orgVal) > 0
        push(lines, "ORG:" + orgVal)
    push(lines, "END:VCARD")
    return join(lines, "\n")

fn vcd_count(contacts) -> int
    return len(contacts)
