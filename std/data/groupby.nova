// ============================================================================
// NOVA Standard Library — std/data/groupby
// ============================================================================
// Group a list of row-dicts (or scalar values) by a key field, with helpers
// for counting and numeric aggregation.
//
// PUBLIC API
//   gb_by_key(rows, key) -> dict
//       Group rows by the string value of row[key].
//       Returns a dict mapping each distinct key-value -> list of matching rows.
//       Rows missing the key are skipped.
//
//   gb_count(rows, key) -> dict
//       Count how many rows share each value of row[key].
//       Returns a dict mapping key-value -> int count.
//       Rows missing the key are skipped.
//
//   gb_aggregate(rows, group_key, value_key) -> dict
//       Sum int(row[value_key]) for all rows sharing the same row[group_key].
//       Returns a dict mapping group-value -> int sum.
//       Rows missing either key are skipped.
//
//   gb_keys(grouped) -> list
//       Return the sorted list of keys present in a grouped dict.
//       Sorted lexicographically (ascending).
//
// IMPLEMENTATION NOTES
//   • Private helpers prefixed _gb_.
//   • All key lookups guarded with contains().
//   • Single-exit pattern used to avoid return-null mistag bug.
//   • int() via * 1 on a string that holds a number uses int_of / str approach;
//     NOVA's int() cast handles string-to-int.
//   • No '&&'/'||' — uses 'and'/'or'.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _gb_str_val: safely coerce a dict field to a string key for grouping.
// Uses str() which gives a deterministic string for int/float/string.
fn _gb_str_val(v) -> string
    return str(v)

// _gb_to_int: convert a value (string digits or int) to int for aggregation.
fn _gb_to_int(v) -> int
    let result = 0
    let t = type_of(v)
    if t == "int"
        result = v
    else
        if t == "float"
            let iv = float_to_int(v)
            result = iv
        else
            // string: parse via int cast
            result = int(v)
    return result

// ── Public API ───────────────────────────────────────────────────────────────

// gb_by_key: group rows by the string representation of row[key].
// Returns dict: group-value-string -> list of row dicts belonging to that group.
// Rows missing key are silently skipped.
//
// Example:
//   gb_by_key([{"cat":"x","n":3},{"cat":"y","n":1},{"cat":"x","n":4}], "cat")
//   -> {"x": [row0, row2], "y": [row1]}
fn gb_by_key(rows, key)
    let result = {}
    let n = len(rows)
    let i = 0
    while i < n
        let row = rows[i]
        if contains(row, key) == 1
            let gv = _gb_str_val(row[key])
            if contains(result, gv) == 0
                result[gv] = []
            result[gv].push(row)
        i = i + 1
    return result

// gb_count: count rows per distinct value of row[key].
// Returns dict: group-value-string -> int count.
// Rows missing key are silently skipped.
//
// Example:
//   gb_count(rows, "cat") -> {"x": 2, "y": 1}
fn gb_count(rows, key)
    let result = {}
    let n = len(rows)
    let i = 0
    while i < n
        let row = rows[i]
        if contains(row, key) == 1
            let gv = _gb_str_val(row[key])
            if contains(result, gv) == 0
                result[gv] = 0
            result[gv] = result[gv] + 1
        i = i + 1
    return result

// gb_aggregate: sum row[value_key] (as int) grouped by row[group_key].
// Returns dict: group-value-string -> int sum.
// Rows missing group_key or value_key are silently skipped.
//
// Example:
//   gb_aggregate(rows, "cat", "n") -> {"x": 7, "y": 1}
fn gb_aggregate(rows, group_key, value_key)
    let result = {}
    let n = len(rows)
    let i = 0
    while i < n
        let row = rows[i]
        if contains(row, group_key) == 1
            if contains(row, value_key) == 1
                let gv = _gb_str_val(row[group_key])
                let vv = _gb_to_int(row[value_key])
                if contains(result, gv) == 0
                    result[gv] = 0
                result[gv] = result[gv] + vv
        i = i + 1
    return result

// gb_keys: return sorted list of keys from a grouped dict.
// Keys are sorted lexicographically (ascending).
//
// Example:
//   gb_keys({"x": [...], "y": [...]}) -> ["x", "y"]
fn gb_keys(grouped)
    let ks = keys(grouped)
    let sorted = sort(ks)
    return sorted
