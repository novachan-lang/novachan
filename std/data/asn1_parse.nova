// ============================================================================
// NOVA Standard Library — std/data/asn1_parse
// ============================================================================
// Generic recursive DER/BER parser.  Parses any ASN.1 byte stream into a
// tree of nodes WITHOUT knowing the specific schema.
//
// PUBLIC API:
//   asn1_read_tlv(b, pos) -> list
//     Read ONE TLV header at byte offset pos in bytes b.
//     Returns [info_dict, next_pos] where info_dict has keys:
//       "tag"           -> int  (raw tag byte)
//       "class"         -> int  (0=Universal, 1=App, 2=Context, 3=Private)
//       "constructed"   -> int  (0=primitive, 1=constructed)
//       "length"        -> int  (content length in bytes)
//       "content_start" -> int  (byte offset of first content byte)
//       "content_len"   -> int  (same as "length"; included per spec)
//     next_pos = content_start + content_len  (byte past the end of this TLV)
//     On malformed/truncated input: returns [{}, -1].
//     Caller MUST check next_pos != -1 before using info_dict.
//
//   asn1_parse(b) -> dict
//     Parse bytes b from the beginning into a recursive tree.
//     Primitive node:   {"tag": t, "constructed": 0, "value": <bytes>}
//     Constructed node: {"tag": t, "constructed": 1, "children": [...]}
//     Error/empty:      {"tag": 0, "constructed": 0, "value": <empty>, "error": 1}
//     Recursion is bounded to 32 levels deep to reject pathological inputs.
//
//   asn1_hexdump(b) -> string
//     Return a hex string of bytes b (lowercase hex, space-separated).
//     Useful for debugging.  Empty input -> "".
//
// PRIVATE helpers:
//   _asn1_parse_at(b, pos, end_pos, depth) -> list  [node_dict, next_pos]
//   _asn1_parse_children(b, pos, end_pos, depth) -> list  [child_list, next_pos]
//   _asn1_hex_byte(v) -> string
//
// DESIGN NOTES:
//   - LEAF module — imports nothing (inlines tag + length decoding for speed).
//   - Bounds-checked on EVERY byte read.  Malformed input never crashes.
//   - Recursion depth capped at 32 to prevent stack overflow on crafted input.
//   - High-tag-number form (tag byte low bits == 0x1F) is supported in decode.
//   - Returns a single unified error sentinel rather than crashing on bad input.
//   - Single-exit style in helper functions to avoid return-null mistag.
//
// KAT vectors (X.690 verified):
//   asn1_read_tlv([0x30,0x06,0x02,0x01,0x01,0x02,0x01,0x02], 0)
//     -> tag=0x30, class=0, constructed=1, length=6, content_start=2
//        next_pos=8
//   asn1_parse([0x30,0x06,0x02,0x01,0x01,0x02,0x01,0x02])
//     -> constructed node, tag=0x30, 2 children each tag=0x02 with value [0x01]/[0x02]
//   asn1_parse([0x05,0x00]) -> primitive NULL, tag=0x05, value=empty bytes
//   asn1_parse([0x02]) -> error node (truncated input)
// ============================================================================

// _asn1_nibble_hex: encode a single nibble value n (0..15) as one hex char.
fn _asn1_nibble_hex(n: int) -> string
    char_at("0123456789abcdef", n)

// _asn1_hex_byte: encode a single byte value v (0..255) as two hex chars.
fn _asn1_hex_byte(v: int) -> string
    let hi = (v >> 4) & 0xF
    let lo = v & 0xF
    let hi_c = _asn1_nibble_hex(hi)
    let lo_c = _asn1_nibble_hex(lo)
    hi_c + lo_c

// asn1_hexdump: produce a space-separated lowercase hex string of bytes b.
// Empty input returns "".
fn asn1_hexdump(b: any) -> string
    let n = bytes_len(b)
    let out_parts = [_asn1_hex_byte(bytes_get(b, i)) for i in 0..n]
    join(out_parts, " ")

// _asn1_decode_tag_at: decode the tag at position pos in b.
// Returns [tag_byte, class, constructed, number, next_pos].
// On error returns [0, 0, 0, 0, -1].
fn _asn1_decode_tag_at(b: any, pos: int) -> list
    let blen = bytes_len(b)
    let err = [0, 0, 0, 0, -1]
    let result = err
    if pos >= 0 and pos < blen
        let first = bytes_get(b, pos)
            let cls = (first >> 6) & 3
            let cons = (first >> 5) & 1
            let low5 = first & 31
            if low5 < 31
                result = [first, cls, cons, low5, pos + 1]
            else
                // High-tag-number form
                let number = 0
                let cur = pos + 1
                let done = 0
                while done == 0
                    if cur >= blen
                        done = 2
                    else
                        let bv = bytes_get(b, cur)
                        let payload = bv & 0x7F
                        number = number * 128 + payload
                        cur += 1
                        if bv < 128
                            done = 1
                if done == 1
                    result = [first, cls, cons, number, cur]
    result

// _asn1_decode_len_at: decode the DER length field at pos in b.
// Returns [length, next_pos].  On error returns [-1, pos].
fn _asn1_decode_len_at(b: any, pos: int) -> list
    let total = bytes_len(b)
    let err_r = [-1, pos]
    let result = err_r
    if pos >= 0 and pos < total
        let first = bytes_get(b, pos)
        if first < 128
            result = [first, pos + 1]
        else
            let k = first & 0x7F
            if k == 0
                // indefinite form — reject in DER
                result = [-1, pos + 1]
            else if k > 4
                result = [-1, pos]
            else if pos + 1 + k > total
                result = [-1, pos]
            else
                let acc = 0
                for j in 0..k
                    let bv = bytes_get(b, pos + 1 + j)
                    acc = acc * 256 + bv
                result = [acc, pos + 1 + k]
    result

// asn1_read_tlv: read ONE TLV header at offset pos; no recursion.
//
// Returns [info_dict, next_pos] where next_pos = content_start + content_len.
// On any error: [{}, -1].
fn asn1_read_tlv(b: any, pos: int) -> list
    let blen = bytes_len(b)
    let err_dict = {}
    let err_result = [err_dict, -1]
    let final_result = err_result

    let tag_info = _asn1_decode_tag_at(b, pos)
    let tag_next = tag_info[4]
    if tag_next != -1
        let len_info = _asn1_decode_len_at(b, tag_next)
        let content_len = len_info[0]
        let content_start = len_info[1]
        if content_len >= 0
            let end_pos = content_start + content_len
            if end_pos <= blen
                let tag_byte = tag_info[0]
                let cls = tag_info[1]
                let cons = tag_info[2]
                let info = {"tag": tag_byte, "class": cls, "constructed": cons, "length": content_len, "content_start": content_start, "content_len": content_len}
                final_result = [info, end_pos]
    final_result

// _asn1_make_error: build an error sentinel node.
fn _asn1_make_error() -> dict
    let v = bytes(0)
    {"tag": 0, "constructed": 0, "value": v, "error": 1}

// _asn1_parse_children: parse all TLV children in bytes b from pos to end_pos.
// Returns [children_list, final_pos].  depth controls max recursion.
fn _asn1_parse_children(b: any, pos: int, end_pos: int, depth: int) -> list
    let children = []
    let cur = pos
    let ok = 1
    while ok == 1
        if cur >= end_pos
            ok = 0
        else
            let child_r = _asn1_parse_at(b, cur, depth)
            let child_node = child_r[0]
            let child_next = child_r[1]
            if child_next < 0
                ok = 0
                cur = end_pos
            else
                push(children, child_node)
                cur = child_next
    [children, cur]

// _asn1_parse_at: parse one TLV node at position pos in b, recursing if constructed.
// Returns [node_dict, next_pos].  On error returns [error_node, -1].
// depth: remaining recursion budget (starts at 32).
fn _asn1_parse_at(b: any, pos: int, depth: int) -> list
    let err_node = _asn1_make_error()
    let err_result = [err_node, -1]
    let final_result = err_result

    if depth > 0
        let blen = bytes_len(b)
        if pos >= 0
            if pos < blen
                let tag_info = _asn1_decode_tag_at(b, pos)
                let tag_next = tag_info[4]
                if tag_next != -1
                    let len_info = _asn1_decode_len_at(b, tag_next)
                    let content_len = len_info[0]
                    let content_start = len_info[1]
                    if content_len >= 0
                        let end_pos = content_start + content_len
                        if end_pos <= blen
                            let tag_byte = tag_info[0]
                            let cons = tag_info[2]
                            if cons == 1
                                // Constructed: recurse into children
                                let children_r = _asn1_parse_children(b, content_start, end_pos, depth - 1)
                                let children = children_r[0]
                                let node = {"tag": tag_byte, "constructed": 1, "children": children}
                                final_result = [node, end_pos]
                            else
                                // Primitive: extract content bytes
                                let val = bytes_slice(b, content_start, end_pos)
                                let node2 = {"tag": tag_byte, "constructed": 0, "value": val}
                                final_result = [node2, end_pos]
    final_result

// asn1_parse: parse bytes b from the start into a recursive tree.
//
// Returns a node dict:
//   Primitive:   {"tag": t, "constructed": 0, "value": <content bytes>}
//   Constructed: {"tag": t, "constructed": 1, "children": [<child nodes>...]}
//   Error:       {"tag": 0, "constructed": 0, "value": <empty bytes>, "error": 1}
fn asn1_parse(b: any) -> dict
    let r = _asn1_parse_at(b, 0, 32)
    r[0]
