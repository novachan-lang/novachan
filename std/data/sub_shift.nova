// ============================================================================
// NOVA Standard Library — std/data/sub_shift
// ============================================================================
// Subtitle cue time-shift operations.
//
// CUE SHAPE: dict {"index":int, "start":ms, "end":ms, "text":string}
//   ms values are integers (milliseconds from start of media).
//
// PUBLIC API:
//   sub_shift(cues, offset_ms) -> list
//     Return a NEW list of cues with start and end shifted by offset_ms.
//     Values are clamped at 0 (no negative timestamps).
//     The input list and its cue dicts are NOT mutated.
//
//   sub_shift_range(cues, offset_ms, from_ms, to_ms) -> list
//     Like sub_shift, but only shifts cues whose start falls in
//     [from_ms, to_ms).  Cues outside that window are copied unchanged.
//     Clamping at 0 still applies to shifted cues.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - All helpers are _prefix (private).
//   - Uses single-exit style to avoid return-null mistag.
//   - No multi-line list/dict literals.
//   - Dict access for missing key returns 0; we always write all keys.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// Clamp v to >= 0.
fn _ss_clamp0(v) -> int
    0 if v < 0 else v

// Copy a single cue dict, applying delta to start and end, clamped at 0.
fn _ss_shift_cue(cue, delta) -> dict
    let s2 = _ss_clamp0(cue["start"] + delta)
    let e2 = _ss_clamp0(cue["end"] + delta)
    {"index": cue["index"], "start": s2, "end": e2, "text": cue["text"]}

// Copy a cue dict without modification (for sub_shift_range pass-through).
fn _ss_copy_cue(cue) -> dict
    {"index": cue["index"], "start": cue["start"], "end": cue["end"], "text": cue["text"]}

// ── Public API ───────────────────────────────────────────────────────────────

// sub_shift: shift ALL cues by offset_ms, clamp at 0, return new list.
fn sub_shift(cues, offset_ms) -> list
    let result = []
    let n = len(cues)
    for i in 0..n
        let shifted = _ss_shift_cue(cues[i], offset_ms)
        result.push(shifted)
    result

// sub_shift_range: shift only cues with start in [from_ms, to_ms).
fn sub_shift_range(cues, offset_ms, from_ms, to_ms) -> list
    let result = []
    let n = len(cues)
    for i in 0..n
        let cue = cues[i]
        let s = cue["start"]
        let out = _ss_shift_cue(cue, offset_ms) if (s >= from_ms and s < to_ms) else _ss_copy_cue(cue)
        result.push(out)
    result
