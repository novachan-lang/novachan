// ============================================================================
// NOVA Standard Library — std/data/asn1_oid
// ============================================================================
// ASN.1 DER OBJECT IDENTIFIER (tag 0x06) encoder/decoder.
//
// OID encoding rules (X.690 §8.19):
//   • The first two arcs are combined into a single byte: 40*arc0 + arc1.
//     (arc0 must be 0, 1, or 2; arc1 must satisfy 40*arc0+arc1 < 256 for
//      arc0<2, or arc1<175 for arc0=2 — the standard permits larger values
//      but they require multi-byte encoding, handled naturally here.)
//   • Each subsequent arc (and the combined first arc) is base-128 encoded,
//     big-endian, with the high bit (0x80) SET on every byte EXCEPT the
//     LAST byte of that arc's encoding.
//   • Value 0..127 encodes as a single byte with high bit clear.
//   • The OID TLV is: 0x06 || DER_length || content_bytes.
//
// PUBLIC API:
//   asn1_oid_encode(arcs) -> bytes
//     Encode a list of integer arcs as an OID TLV.  arcs must have at least
//     two elements.  Returns complete TLV (tag + length + value).
//
//   asn1_oid_decode(b, pos) -> list
//     Decode an OID TLV starting at byte position pos in bytes b.
//     Returns [arcs_list, next_pos].  arcs_list is the decoded integer arcs.
//     If bounds-check fails at any point, returns [[], pos] (safe empty).
//
// PRIVATE helpers:
//   _oid_arc_encode(v) -> bytes   base-128 big-endian encoding of one arc value
//   _oid_tlv(content) -> bytes    wrap content with tag 0x06 + DER length
//   _oid_arc_decode(b, pos, total) -> list  decode one base-128 arc at pos
//
// LEAF — imports nothing.
//
// KAT VECTORS (X.690 / RFC 5280 verified):
//   asn1_oid_encode([1,2,840,113549]) == [0x06,0x06,0x2A,0x86,0x48,0x86,0xF7,0x0D]
//   asn1_oid_encode([2,5,4,3])        == [0x06,0x03,0x55,0x04,0x03]
//   asn1_oid_encode([1,2,3])          == [0x06,0x02,0x2A,0x03]
//   asn1_oid_encode([2,100,3])        == [0x06,0x03,0x81,0x34,0x03]
//   Round-trip: asn1_oid_decode(asn1_oid_encode(arcs), 0)[0] == arcs
// ============================================================================

// _oid_arc_encode: base-128 big-endian encoding of a non-negative integer arc.
//
// Algorithm:
//   Extract 7-bit groups from LSB to MSB.  The first extracted group becomes
//   the LAST byte (high-bit clear); all preceding groups get high bit set.
//   Minimum one byte (value 0 encodes as 0x00).
fn _oid_arc_encode(v: int) -> any
    let limbs = []
    let remaining = v
    let done = 0
    while done == 0
        let b = remaining & 127
        push(limbs, b)
        remaining = remaining / 128
        if remaining == 0
            done = 1
    // limbs[0] = LSB group (last byte, high-bit clear)
    // limbs[n-1] = MSB group (first byte, high-bit set if n>1)
    let count = len(limbs)
    let out = bytes(0)
    let i = count - 1
    while i >= 0
        let bval = limbs[i]
        if i > 0
            bval = bval | 128
        out = bytes_append(out, bval)
        i -= 1
    out

// _oid_tlv: wrap OID content bytes with tag 0x06 and DER-minimal length.
//
// DER length encoding:
//   0..127   -> single byte equal to length (short form)
//   128..255 -> 0x81 followed by one-byte length
//   256..    -> 0x82 followed by two-byte big-endian length
fn _oid_tlv(content: any) -> any
    let clen = bytes_len(content)
    let out = bytes(0)
    out = bytes_append(out, 6)
    if clen < 128
        out = bytes_append(out, clen)
    else if clen < 256
        out = bytes_append(out, 129)
        out = bytes_append(out, clen)
    else
        let hi = clen / 256
        let lo = clen % 256
        out = bytes_append(out, 130)
        out = bytes_append(out, hi)
        out = bytes_append(out, lo)
    out = bytes_concat(out, content)
    out

// asn1_oid_encode: encode a list of arc integers as an OID TLV.
//
// arcs[0] and arcs[1] are combined into the first content byte via 40*a0+a1.
// Each remaining arc is independently base-128 encoded and appended.
// Requires at least 2 arcs; returns empty bytes on invalid input.
fn asn1_oid_encode(arcs: list) -> any
    let n = len(arcs)
    let result = bytes(0)
    if n < 2
        result
    else
        let first_val = 40 * arcs[0] + arcs[1]
        let content = _oid_arc_encode(first_val)
        for i in 2..n
            let arc_bytes = _oid_arc_encode(arcs[i])
            content = bytes_concat(content, arc_bytes)
        result = _oid_tlv(content)
        result

// _oid_arc_decode: decode one base-128 arc at position pos within bytes b.
//
// Returns [arc_value, next_pos].  If pos >= total or a multi-byte arc
// runs past total, returns [0, pos] as a safe error sentinel.
//
// Base-128 decoding: accumulate 7-bit groups from each byte; stop when a
// byte has the high bit CLEAR (last byte of this arc).
fn _oid_arc_decode(b: any, pos: int, total: int) -> list
    let val = 0
    let cur = pos
    let done = 0
    let safe = 1
    while done == 0
        if cur >= total
            safe = 0
            done = 1
        else
            let bval = bytes_get(b, cur)
            val = (val * 128) + (bval & 127)
            cur += 1
            if (bval & 128) == 0
                done = 1
    let res = []
    if safe == 0
        push(res, 0)
        push(res, pos)
    else
        push(res, val)
        push(res, cur)
    res

// asn1_oid_decode: decode an OID TLV at position pos within bytes b.
//
// Reads: tag byte (must be 0x06), DER length, then content bytes.
// Splits content into arcs: the first content byte = 40*a0+a1 (a0=0 if
// first<40, a0=1 if first<80, a0=2 otherwise).  Remaining bytes are
// decoded as independent base-128 arcs.
//
// Returns [arcs_list, next_pos].  On any bounds violation or wrong tag,
// returns [[], pos].
fn asn1_oid_decode(b: any, pos: int) -> list
    let total = bytes_len(b)
    let fail_res = []
    push(fail_res, [])
    push(fail_res, pos)
    // Need at least 2 bytes for tag + length
    if pos + 1 >= total
        fail_res
    else
        let tag = bytes_get(b, pos)
        if tag != 6
            fail_res
        else
            // Decode DER length
            let len_pos = pos + 1
            let clen = 0
            let content_start = 0
            let len_byte = bytes_get(b, len_pos)
            if len_byte < 128
                clen = len_byte
                content_start = len_pos + 1
            else if len_byte == 129
                if len_pos + 1 >= total
                    clen = -1
                    content_start = len_pos + 2
                else
                    clen = bytes_get(b, len_pos + 1)
                    content_start = len_pos + 2
            else if len_byte == 130
                if len_pos + 2 >= total
                    clen = -1
                    content_start = len_pos + 3
                else
                    let hi = bytes_get(b, len_pos + 1)
                    let lo = bytes_get(b, len_pos + 2)
                    clen = hi * 256 + lo
                    content_start = len_pos + 3
            else
                clen = -1
                content_start = len_pos + 1
            if clen < 0
                fail_res
            else
                let content_end = content_start + clen
                if content_end > total
                    fail_res
                else
                    if clen == 0
                        let empty_arcs = []
                        let r = []
                        push(r, empty_arcs)
                        push(r, content_end)
                        r
                    else
                        // Decode first combined arc value (base-128 encoded) -> a0, a1
                        // The first content value is base-128 encoded like all others;
                        // after decoding its integer value, split via 40*a0+a1.
                        let first_arc_res = _oid_arc_decode(b, content_start, content_end)
                        let first_val = first_arc_res[0]
                        let cur = first_arc_res[1]
                        let a0 = 0
                        let a1 = first_val
                        if first_val >= 80
                            a0 = 2
                            a1 = first_val - 80
                        else if first_val >= 40
                            a0 = 1
                            a1 = first_val - 40
                        let arcs = []
                        push(arcs, a0)
                        push(arcs, a1)
                        // Decode remaining arcs from cur .. content_end
                        while cur < content_end
                            let arc_res = _oid_arc_decode(b, cur, content_end)
                            let arc_val = arc_res[0]
                            let next_p = arc_res[1]
                            if next_p <= cur
                                cur = content_end
                            else
                                push(arcs, arc_val)
                                cur = next_p
                        let out = []
                        push(out, arcs)
                        push(out, content_end)
                        out
