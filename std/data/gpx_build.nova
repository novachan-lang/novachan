// ============================================================================
// NOVA Standard Library — std/data/gpx_build
// ============================================================================
// Build a GPX XML string from a list of [lat, lon] float pairs.
//
// PUBLIC API
//   gpx_build(points) -> string
//     Emit a well-formed GPX 1.1 document wrapping the given track points.
//     points: list of [lat, lon] pairs (each pair is a 2-element list of floats).
//     Returns a string containing the complete GPX XML document.
//
// OUTPUT FORMAT
//   <?xml version="1.0" encoding="UTF-8"?>
//   <gpx version="1.1" creator="NOVA">
//     <trk>
//       <trkseg>
//         <trkpt lat="1.5" lon="2.5"></trkpt>
//         ...
//       </trkseg>
//     </trk>
//   </gpx>
//
// IMPLEMENTATION NOTES
//   - LEAF module — imports nothing.
//   - All private helpers prefixed _gpxb_ to avoid link collisions.
//   - Float-to-string via str() builtin.
//   - chr(34)='"', chr(10)=LF newline.
//   - Single-exit style throughout (avoids NOVA return-null mistag bug).
//   - Reserved words NOT used as variable names: match/loop/type/in.
// ============================================================================

// ── Private: build a single <trkpt lat="..." lon="..."></trkpt> line ─────────

fn _gpxb_trkpt_line(lat, lon, indent)
    let dq = chr(34)
    let lat_s = str(lat)
    let lon_s = str(lon)
    let line = indent + "<trkpt lat=" + dq + lat_s + dq + " lon=" + dq + lon_s + dq + "></trkpt>"
    return line

// ── Public: gpx_build ────────────────────────────────────────────────────────

// gpx_build: build a GPX 1.1 XML string from a list of [lat, lon] pairs.
fn gpx_build(points)
    let lf = chr(10)
    let dq = chr(34)
    let header = "<?xml version=" + dq + "1.0" + dq + " encoding=" + dq + "UTF-8" + dq + "?>" + lf
    let gpx_open = "<gpx version=" + dq + "1.1" + dq + " creator=" + dq + "NOVA" + dq + ">" + lf
    let gpx_close = "</gpx>" + lf
    let trk_open = "  <trk>" + lf
    let trk_close = "  </trk>" + lf
    let seg_open = "    <trkseg>" + lf
    let seg_close = "    </trkseg>" + lf
    let body_parts = [_gpxb_trkpt_line(pair[0], pair[1], "      ") + lf for pair in points]
    let body = join(body_parts, "")
    let result = header + gpx_open + trk_open + seg_open + body + seg_close + trk_close + gpx_close
    return result
