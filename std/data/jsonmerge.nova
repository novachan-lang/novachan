// ============================================================================
// NOVA Standard Library — std/data/jsonmerge
// ============================================================================
// Deep-merge two parsed JSON-ish values (dicts / lists / scalars).
//
// PUBLIC API:
//   jm_merge(a, b) -> any
//     If both a and b are dicts (type_of == "dict"), produce a new dict that
//     contains every key from a, then overlays every key from b:
//       - If a key appears only in a → kept as-is.
//       - If a key appears only in b → added from b.
//       - If a key appears in both AND both values are dicts → recurse.
//       - Otherwise (scalar-vs-scalar, list-vs-anything, etc.) → b wins.
//     If a or b is not a dict, b wins unconditionally (b replaces a).
//
//   jm_get_path(obj, path_list) -> any
//     Walk a nested dict using a list of string keys.
//     Returns the value at the end of the path, or null if any key is
//     absent along the way.
//
// RUNTIME DISPATCH:
//   type_of(x) == "dict" is used throughout — is_dict() is a compile-time
//   predicate that returns 0 for any-typed values (e.g. from json_parse).
//
// SINGLE-EXIT RULE:
//   Functions with mixed return types use `let result = null` + reassign to
//   avoid the NOVA `return null` + `return <value>` mistag bug.
//
// NOTE: the native builtin `dict_merge` is SHALLOW (b keys overwrite a keys
//   without recursion). jm_merge is DEEP — it recurses into nested dicts.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Public API ───────────────────────────────────────────────────────────────

// jm_merge: deep-merge b into a.
//
// When both a and b are dicts, the result dict is built as:
//   1. Copy all keys from a into result.
//   2. For each key k in b:
//        - If k exists in result AND result[k] is a dict AND b[k] is a dict
//          -> replace result[k] with jm_merge(result[k], b[k])   (recurse)
//        - Otherwise -> result[k] = b[k]   (b wins)
//
// When a or b is not a dict, return b (b replaces a).
//
// Examples:
//   d1 = {"a":1, "b":{"x":1,"y":2}}
//   d2 = {"b":{"y":9,"z":3}, "c":4}
//   jm_merge(d1, d2) = {"a":1, "b":{"x":1,"y":9,"z":3}, "c":4}
//   jm_merge(1, 2)   = 2          (scalar-vs-scalar: b wins)
//   jm_merge(d1, 5)  = 5          (dict-vs-scalar:   b wins)
fn jm_merge(a, b) -> any
    let result = b
    if type_of(a) == "dict"
        if type_of(b) == "dict"
            // Both dicts — deep merge.
            let merged = {}
            // Step 1: copy all keys from a.
            let ka = keys(a)
            for i in 0..len(ka)
                let k = ka[i]
                merged[k] = a[k]
            // Step 2: overlay / recurse from b.
            let kb = keys(b)
            for j in 0..len(kb)
                let k2 = kb[j]
                if contains(merged, k2) == 1
                    // Key exists in a — check if both sides are dicts.
                    if type_of(merged[k2]) == "dict"
                        if type_of(b[k2]) == "dict"
                            merged[k2] = jm_merge(merged[k2], b[k2])
                        else
                            merged[k2] = b[k2]
                    else
                        merged[k2] = b[k2]
                else
                    // Key only in b — add it.
                    merged[k2] = b[k2]
            result = merged
    result

// jm_get_path: resolve a list of string keys against a nested dict.
//
// path_list = []          -> returns obj unchanged (root access).
// path_list = ["a","b"]   -> returns obj["a"]["b"], or null on missing key.
//
// Each step uses type_of == "dict" + contains() guard to avoid crashes on
// missing keys or non-dict intermediate nodes.
//
// Examples:
//   obj = {"b":{"x":1,"y":9,"z":3},"a":1,"c":4}
//   jm_get_path(obj, ["b","y"])  -> 9
//   jm_get_path(obj, ["b","z"])  -> 3
//   jm_get_path(obj, ["a"])      -> 1
//   jm_get_path(obj, [])         -> obj
//   jm_get_path(obj, ["b","w"])  -> null   (absent key)
//   jm_get_path(obj, ["x","y"])  -> null   (absent key at first step)
fn jm_get_path(obj, path_list) -> any
    let result = obj
    let i = 0
    let ok = 1
    while i < len(path_list) and ok == 1
        let k = path_list[i]
        if type_of(result) == "dict"
            if contains(result, k) == 1
                result = result[k]
            else
                result = null
                ok = 0
        else
            result = null
            ok = 0
        i = i + 1
    result
