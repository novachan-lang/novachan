// ============================================================================
// NOVA Standard Library — std/data/coord_util
// ============================================================================
// Coordinate conversion and validation utilities.
//
// PUBLIC API
//   dms_to_dd(deg, min, sec)  -> float  DMS -> decimal degrees
//   dd_to_dms(dd)             -> list   [deg, min, sec] as floats
//   normalize_lon(lon)        -> float  wrap longitude to -180..180
//   valid_coord(lat, lon)     -> bool   true if lat in [-90,90] and lon in [-180,180]
//
// FORMULA
//   dms_to_dd: dd = deg + min/60.0 + sec/3600.0
//   dd_to_dms: deg_i = floor(abs(dd)); remainder drives min and sec; sign preserved
//   normalize_lon: lon = ((lon + 180) mod 360) - 180
//   valid_coord: -90 <= lat <= 90 and -180 <= lon <= 180
//
// IMPLEMENTATION NOTES
//   - LEAF module — imports nothing.
//   - All private helpers prefixed _cu_ to avoid link collisions.
//   - Float arithmetic only; no external trig required.
//   - Single-exit style throughout (avoids NOVA return-null mistag bug).
//   - No multi-line list/dict literals in module body (NOVA parser limitation).
//   - Reserved words NOT used as variable names: match/loop/type/in.
// ============================================================================

// ── Private: floor of a float (returns float) ────────────────────────────────
// float_to_int truncates toward zero; for negative non-integers subtract 1.

fn _cu_floor(x)
    let xi = float_to_int(x)
    let r = xi * 1.0
    let result = r
    // if x is negative and r > x (i.e. x was not an exact integer), go one lower
    if x < 0.0
        if r > x
            result = r - 1.0
    return result

// ── Private: absolute value of a float ───────────────────────────────────────

fn _cu_fabs(x)
    let result = x
    if x < 0.0
        result = 0.0 - x
    return result

// ── Private: float modulo (always non-negative result) ───────────────────────
// fmod_pos(a, b): result in [0, b)

fn _cu_fmod_pos(a, b)
    let q = _cu_floor(a / b)
    let r = a - q * b
    // ensure non-negative due to float rounding
    let result = r
    if result < 0.0
        result = result + b
    return result

// ── Public: dms_to_dd ────────────────────────────────────────────────────────

// dms_to_dd: convert degrees, minutes, seconds to decimal degrees.
// All inputs are floats (deg may be negative for S/W; min and sec are always positive).
fn dms_to_dd(deg, min, sec)
    let sign = 1.0
    if deg < 0.0
        sign = 0.0 - 1.0
    let abs_deg = _cu_fabs(deg)
    let dd = abs_deg + min / 60.0 + sec / 3600.0
    let result = sign * dd
    return result

// ── Public: dd_to_dms ────────────────────────────────────────────────────────

// dd_to_dms: convert decimal degrees to [degrees, minutes, seconds].
// Returns a list of three floats: [deg, min, sec].
// degrees is an integer-valued float with the original sign;
// minutes and seconds are always non-negative.
fn dd_to_dms(dd)
    let sign = 1.0
    if dd < 0.0
        sign = 0.0 - 1.0
    let abs_dd = _cu_fabs(dd)
    let deg_f = _cu_floor(abs_dd)
    let rem_min = (abs_dd - deg_f) * 60.0
    let min_f = _cu_floor(rem_min)
    let sec_f = (rem_min - min_f) * 60.0
    let signed_deg = sign * deg_f
    let result = []
    push(result, signed_deg)
    push(result, min_f)
    push(result, sec_f)
    return result

// ── Public: normalize_lon ────────────────────────────────────────────────────

// normalize_lon: wrap a longitude value into the range [-180, 180).
fn normalize_lon(lon)
    // shift to [0, 360), then shift back
    let shifted = lon + 180.0
    let modded = _cu_fmod_pos(shifted, 360.0)
    let result = modded - 180.0
    return result

// ── Public: valid_coord ──────────────────────────────────────────────────────

// valid_coord: returns true (1) if lat is in [-90, 90] and lon is in [-180, 180].
fn valid_coord(lat, lon)
    let result = 0
    if lat >= 0.0 - 90.0 and lat <= 90.0
        if lon >= 0.0 - 180.0 and lon <= 180.0
            result = 1
    return result
