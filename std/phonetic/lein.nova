// ============================================================================
// NOVA Standard Library — std/phonetic/lein
// ============================================================================
// LEIN name-coding system (Eastman / police name-search coding).
//
// Algorithm:
//   1. Uppercase the name; strip non-letters.
//   2. Keep the first letter as-is.
//   3. From the remaining letters remove all vowels (A E I O U) and H, W, Y.
//   4. Encode each remaining consonant using the LEIN digit table:
//        D, T     -> 1
//        M, N     -> 2
//        L, R     -> 3
//        B, F, P, V -> 4
//        C, G, J, K, Q, S, X, Z -> 5
//   5. Collapse consecutive identical digits.
//   6. The result is the first letter followed by up to 4 digits.
//      Zero-pad to exactly 4 digits; truncate if more than 4 digits.
//
// Output format: always a letter + exactly 4 digits (5 characters total).
// Empty input returns "" (no letter, no digits possible).
//
// Public API:
//   le_normalize(name)  -> string  uppercase, letters only
//   le_digit(ch)        -> int     LEIN digit for one uppercase consonant (0 if none)
//   le_encode(name)     -> string  full LEIN code (letter + 4 digits)
//
// KAT reference vectors (hand-traced):
//   le_encode("Smith")  = "S2100"  (M->2, T->1, pad 00)
//   le_encode("Robert") = "R4310"  (B->4, R->3, T->1, pad 0)
//   le_encode("Rupert") = "R4310"  (P->4, R->3, T->1, pad 0)  same as Robert
//
// LEAF — imports nothing.
// ============================================================================

// le_upper_char converts one ASCII character to uppercase.
fn le_upper_char(c) -> string
    let o = ord(c)
    let r = c
    if o >= 97 and o <= 122
        r = chr(o - 32)
    r

// le_is_letter returns 1 if c is an ASCII letter.
fn le_is_letter(c) -> int
    let o = ord(c)
    let r = 0
    if (o >= 65 and o <= 90) or (o >= 97 and o <= 122)
        r = 1
    r

// le_normalize strips non-letters and uppercases the result.
fn le_normalize(name) -> string
    let n = len(name)
    let out = ""
    let i = 0
    while i < n
        let c = char_at(name, i)
        if le_is_letter(c) == 1
            out = out + le_upper_char(c)
        i = i + 1
    out

// le_digit returns the LEIN digit for one uppercase consonant character.
// Returns 0 if the character is a vowel, H, W, Y, or otherwise unrecognized.
fn le_digit(ch) -> int
    let r = 0
    if ch == "D" or ch == "T"
        r = 1
    else if ch == "M" or ch == "N"
        r = 2
    else if ch == "L" or ch == "R"
        r = 3
    else if ch == "B" or ch == "F" or ch == "P" or ch == "V"
        r = 4
    else if ch == "C" or ch == "G" or ch == "J" or ch == "K" or ch == "Q" or ch == "S" or ch == "X" or ch == "Z"
        r = 5
    r

// le_is_skip returns 1 if the character should be removed from the suffix
// (i.e., vowels A E I O U, and H, W, Y).
fn le_is_skip(ch) -> int
    let r = 0
    if ch == "A" or ch == "E" or ch == "I" or ch == "O" or ch == "U"
        r = 1
    else if ch == "H" or ch == "W" or ch == "Y"
        r = 1
    r

// le_encode computes the LEIN code for a name.
// Returns a letter + exactly 4 digits (5 chars total).
// Returns "" for an empty/all-non-letter input.
fn le_encode(name) -> string
    let s = le_normalize(name)
    let n = len(s)
    if n == 0
        return ""

    // First letter is kept unchanged.
    let first = char_at(s, 0)

    // Process the rest: skip vowels/H/W/Y, encode remaining consonants.
    let digits = ""
    let i = 1
    while i < n
        let c = char_at(s, i)
        if le_is_skip(c) == 0
            let d = le_digit(c)
            if d > 0
                // Collapse consecutive duplicate digits.
                let dlen = len(digits)
                let skip_dup = 0
                if dlen > 0
                    let last_ch = char_at(digits, dlen - 1)
                    if last_ch == str(d)
                        skip_dup = 1
                if skip_dup == 0
                    digits = digits + str(d)
        i = i + 1

    // Zero-pad to exactly 4 digits; truncate if longer.
    let dlen = len(digits)
    if dlen < 4
        let pad = 4 - dlen
        if pad == 4
            digits = digits + "0000"
        else if pad == 3
            digits = digits + "000"
        else if pad == 2
            digits = digits + "00"
        else
            digits = digits + "0"
    first + slice(digits, 0, 4)

fn main()
    print("std/phonetic/lein loaded")
