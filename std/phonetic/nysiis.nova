// std/phonetic/nysiis -- New York State Identification and Intelligence System (NYSIIS) phonetic encoding.
// LEAF -- imports NOTHING.
//
// Public API:
//   ny_encode(name: string) -> string
//     Returns the NYSIIS phonetic code for the name.  Empty -> "".
//   ny_encode_len(name: string, maxlen: int) -> string
//     Returns the NYSIIS code truncated to maxlen characters.
//   ny_first_char(name: string) -> string
//     Returns the first character of the NYSIIS code (the key letter).
//   ny_translate_char(prev: string, cur: string, next: string) -> string
//     Returns the NYSIIS translation of one character given context.
//
// Algorithm (modern NYSIIS):
//   1. Uppercase, strip non-alpha.
//   2. Translate first-letter prefix: MAC->MCC, KN->NN, K->C, PH->FF, PF->FF, SCH->SSS.
//   3. Map initial vowel to A.
//   4. Translate last-letter suffix: EE/IE->Y; DT/RT/RD/NT/ND->D.
//   5. First char = key[0]; encode remaining: EV->AF, vowels->A, Q->G, Z->S, M->N,
//      KN->N, K->C, SCH->SSS, PH->FF, H adjacent-to-vowel->previous char,
//      W after-vowel->previous char.
//   6. Collapse consecutive duplicate letters.
//   7. Strip trailing S, then AY, then A, then H.

// Uppercase a single ASCII letter; non-alpha returned as "".
fn _ny_up(c: string) -> string
    let o = ord(c)
    let r = ""
    if o >= 65 and o <= 90
        r = c
    else if o >= 97 and o <= 122
        r = chr(o - 32)
    r

// Strip non-alpha, uppercase.
fn _ny_clean(s: string) -> string
    let n = len(s)
    let out = ""
    let i = 0
    while i < n
        let uc = _ny_up(char_at(s, i))
        if len(uc) > 0
            out = out + uc
        i = i + 1
    out

// Return 1 if uppercase char c is a vowel (AEIOU).
fn _ny_is_vowel(c: string) -> int
    let r = 0
    if c == "A" or c == "E" or c == "I" or c == "O" or c == "U"
        r = 1
    r

// Safe char access: returns "" if out of bounds.
fn _ny_at(s: string, i: int) -> string
    let r = ""
    if i >= 0 and i < len(s)
        r = char_at(s, i)
    r

// Apply prefix transforms to the cleaned uppercase name.
fn _ny_prefix(s: string) -> string
    let n = len(s)
    let r = s
    if n >= 3 and slice(s, 0, 3) == "MAC"
        r = "MCC" + slice(s, 3, n)
    else if n >= 3 and slice(s, 0, 3) == "SCH"
        r = "SSS" + slice(s, 3, n)
    else if n >= 2 and slice(s, 0, 2) == "KN"
        r = "NN" + slice(s, 2, n)
    else if n >= 2 and slice(s, 0, 2) == "PH"
        r = "FF" + slice(s, 2, n)
    else if n >= 2 and slice(s, 0, 2) == "PF"
        r = "FF" + slice(s, 2, n)
    else if n >= 1 and _ny_at(s, 0) == "K"
        r = "C" + slice(s, 1, n)
    r

// Map initial vowel to A.
fn _ny_initial_vowel(s: string) -> string
    let r = s
    if len(s) > 0 and _ny_is_vowel(_ny_at(s, 0)) == 1
        r = "A" + slice(s, 1, len(s))
    r

// Apply suffix transforms to the cleaned uppercase name.
fn _ny_suffix(s: string) -> string
    let n = len(s)
    let r = s
    if n >= 2
        let last2 = slice(s, n - 2, n)
        if last2 == "EE" or last2 == "IE"
            r = slice(s, 0, n - 2) + "Y"
        else if last2 == "DT" or last2 == "RT" or last2 == "RD" or last2 == "NT" or last2 == "ND"
            r = slice(s, 0, n - 2) + "D"
    r

// Encode the tail characters (everything after key[0]) by NYSIIS rules.
// key_first is the first character of the key (needed for H/W replacement fallback).
fn _ny_encode_tail(tail: string, key_first: string) -> string
    let n = len(tail)
    let result = ""
    let i = 0
    while i < n
        let c = _ny_at(tail, i)
        let nx = _ny_at(tail, i + 1)
        let nx2 = _ny_at(tail, i + 2)
        let prev_orig = _ny_at(tail, i - 1)
        let prev_code = result
        let prev_ch = key_first
        if len(result) > 0
            prev_ch = slice(result, len(result) - 1, len(result))

        // EV -> AF
        if c == "E" and nx == "V"
            result = result + "AF"
            i = i + 2
        // Vowels -> A
        else if _ny_is_vowel(c) == 1
            result = result + "A"
            i = i + 1
        // Q -> G
        else if c == "Q"
            result = result + "G"
            i = i + 1
        // Z -> S
        else if c == "Z"
            result = result + "S"
            i = i + 1
        // M -> N
        else if c == "M"
            result = result + "N"
            i = i + 1
        // KN -> N
        else if c == "K" and nx == "N"
            result = result + "N"
            i = i + 2
        // K -> C
        else if c == "K"
            result = result + "C"
            i = i + 1
        // SCH -> SSS
        else if c == "S" and nx == "C" and nx2 == "H"
            result = result + "SSS"
            i = i + 3
        // PH -> FF
        else if c == "P" and nx == "H"
            result = result + "FF"
            i = i + 2
        // H adjacent to a vowel -> replace with previous char
        else if c == "H"
            let after_v = 0
            if i > 0 and _ny_is_vowel(prev_orig) == 1
                after_v = 1
            let before_v = 0
            if len(nx) > 0 and _ny_is_vowel(nx) == 1
                before_v = 1
            if after_v == 1 or before_v == 1
                result = result + prev_ch
            else
                result = result + "H"
            i = i + 1
        // W after vowel -> replace with previous char
        else if c == "W"
            if i > 0 and _ny_is_vowel(prev_orig) == 1
                result = result + prev_ch
            else
                result = result + "W"
            i = i + 1
        else
            result = result + c
            i = i + 1
    result

// Collapse runs of consecutive identical characters in s.
fn _ny_collapse(s: string) -> string
    let n = len(s)
    let out = ""
    let i = 0
    while i < n
        let c = char_at(s, i)
        if len(out) == 0
            out = out + c
        else
            let prev = slice(out, len(out) - 1, len(out))
            if c != prev
                out = out + c
        i = i + 1
    out

// Strip trailing suffix: S, then AY, then A, then H (each once, in order).
fn _ny_strip_trailing(s: string) -> string
    let n = len(s)
    let r = s
    // Strip trailing S
    if n > 1 and slice(r, len(r) - 1, len(r)) == "S"
        r = slice(r, 0, len(r) - 1)
    // Strip trailing AY
    if len(r) > 2 and slice(r, len(r) - 2, len(r)) == "AY"
        r = slice(r, 0, len(r) - 2)
    // Strip trailing A
    if len(r) > 1 and slice(r, len(r) - 1, len(r)) == "A"
        r = slice(r, 0, len(r) - 1)
    // Strip trailing H
    if len(r) > 1 and slice(r, len(r) - 1, len(r)) == "H"
        r = slice(r, 0, len(r) - 1)
    r

// Returns the NYSIIS phonetic code for name.
fn ny_encode(name: string) -> string
    let cleaned = _ny_clean(name)
    let r = ""
    if len(cleaned) == 0
        r = ""
    else
        let s = _ny_prefix(cleaned)
        s = _ny_initial_vowel(s)
        s = _ny_suffix(s)
        let kf = slice(s, 0, 1)
        let tail = ""
        if len(s) > 1
            tail = slice(s, 1, len(s))
        let encoded_tail = _ny_encode_tail(tail, kf)
        let key = kf + encoded_tail
        let collapsed = _ny_collapse(key)
        r = _ny_strip_trailing(collapsed)
    r

// Returns the NYSIIS code truncated to maxlen characters.
fn ny_encode_len(name: string, maxlen: int) -> string
    let full = ny_encode(name)
    let r = full
    if len(full) > maxlen
        r = slice(full, 0, maxlen)
    r

// Returns the first character of the NYSIIS code (the key letter).
fn ny_first_char(name: string) -> string
    let code = ny_encode(name)
    let r = ""
    if len(code) > 0
        r = slice(code, 0, 1)
    r

// Returns the NYSIIS translation of one character given its context.
// prev, cur, next are single uppercase chars (or "" at boundaries).
// Handles every NYSIIS tail rule expressible with a single-char lookahead:
// EV->AF, vowel->A, Q->G, Z->S, M->N, KN->N, K->C, PH->FF, H/W adjacent-to-vowel
// -> previous char. (SCH->SSS needs two-char lookahead and is applied only by
//  ny_encode's full-string pass, not by this single-position helper.)
fn ny_translate_char(prev: string, cur: string, next: string) -> string
    let result = cur
    if cur == "E" and next == "V"
        result = "AF"
    else if _ny_is_vowel(cur) == 1
        result = "A"
    else if cur == "Q"
        result = "G"
    else if cur == "Z"
        result = "S"
    else if cur == "M"
        result = "N"
    else if cur == "K" and next == "N"
        result = "N"
    else if cur == "K"
        result = "C"
    else if cur == "P" and next == "H"
        result = "FF"
    else if cur == "H"
        let adj_v = 0
        if _ny_is_vowel(prev) == 1
            adj_v = 1
        if _ny_is_vowel(next) == 1
            adj_v = 1
        if adj_v == 1
            result = prev
        else
            result = "H"
    else if cur == "W"
        if _ny_is_vowel(prev) == 1
            result = prev
        else
            result = "W"
    result
