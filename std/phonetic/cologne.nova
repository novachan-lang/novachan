// std/phonetic/cologne -- Koelner Phonetik (Cologne Phonetics) for German names.
// LEAF -- imports NOTHING.
//
// Public API:
//   co_encode(name: string) -> string
//     Returns the Cologne phonetic code: a digit string where each consonant cluster
//     maps to one digit (0-8), consecutive duplicate digits collapsed, interior
//     zeros removed (leading zero kept if the name starts with a vowel).
//   co_char_code(prev: string, cur: string, next: string) -> int
//     Returns the Cologne digit (0-8) for character cur given its context.
//     Returns -1 for H (silent) and other ignored characters. SPECIAL CASE: X
//     returns the two-digit sentinel 48 (meaning "emit 4 then 8"); co_encode
//     expands this, so external callers must handle 48 as a compound code.
//   co_normalize(name: string) -> string
//     Returns the name uppercased (ASCII) with every non-alpha byte removed.
//     Written-out umlauts (ue/oe/ae) are NOT collapsed and Unicode umlaut code
//     points are dropped, not transliterated -- harmless because U/E/O/A each
//     map to code 0 independently.
//
// Digit mapping:
//   0: A, E, I, O, U, J, Y (vowels + J, Y)
//   1: B, P (except P before H -> 3)
//   2: D, T (except before C or Z -> 8)
//   3: F, V, W (and P before H = PH sound)
//   4: G, K, Q (and C before A/H/K/L/O/Q/R/U/X)
//   5: L
//   6: M, N
//   7: R
//   8: S, Z (and C before E/I/Y/AE/OE/UE/S; and after S/Z; SCH tri-gram)
//
// H is silent (no code, -1).
// X -> two codes: 4 then 8.
// SCH -> single code: 8.

// Uppercase a single ASCII char; returns "" for non-alpha.
fn _co_up(c: string) -> string
    let o = ord(c)
    let r = ""
    if o >= 65 and o <= 90
        r = c
    else if o >= 97 and o <= 122
        r = chr(o - 32)
    r

// Uppercase all ASCII letters and strip every non-ASCII / non-alpha byte.
// Input is the raw name; output is uppercase ASCII. No umlaut transliteration is
// performed (ue/oe/ae are left as-is; Unicode umlauts are dropped) -- this is
// harmless for the digit code since U, E, O, A each map to code 0 independently.
fn co_normalize(name: string) -> string
    let n = len(name)
    let out_parts = []
    let i = 0
    while i < n
        let c = char_at(name, i)
        let o = ord(c)
        // Uppercase ASCII letter
        if o >= 65 and o <= 90
            push(out_parts, c)
            i += 1
        // Lowercase ASCII letter
        else if o >= 97 and o <= 122
            push(out_parts, chr(o - 32))
            i += 1
        // Non-ASCII: skip (umlauts in Unicode such as U+00FC are not alpha A-Z)
        else
            i += 1
    let out = join(out_parts, "")
    out

// Return 1 if single uppercase char c is a vowel (AEIOU).
fn _co_is_vowel(c: string) -> int
    let r = 0
    if c == "A" or c == "E" or c == "I" or c == "O" or c == "U"
        r = 1
    r

// Safe char access returning "" if out of range.
fn _co_at(s: string, i: int) -> string
    let r = ""
    if i >= 0 and i < len(s)
        r = char_at(s, i)
    r

// Returns the Cologne digit (0-8) for character cur given context.
// prev: previous character (or "" at start); next: next character (or "" at end).
// Returns -1 for H (silent) and unknown characters.
fn co_char_code(prev: string, cur: string, next: string) -> int
    let r = -1
    // Vowels + J, Y -> 0
    if cur == "A" or cur == "E" or cur == "I" or cur == "O" or cur == "U"
        r = 0
    else if cur == "J" or cur == "Y"
        r = 0
    // H: silent
    else if cur == "H"
        r = -1
    // B -> 1
    else if cur == "B"
        r = 1
    // P: before H -> 3 (PH = F sound), else -> 1
    else if cur == "P"
        if next == "H"
            r = 3
        else
            r = 1
    // D, T: before C or Z -> 8, else -> 2
    else if cur == "D" or cur == "T"
        if next == "C" or next == "Z"
            r = 8
        else
            r = 2
    // F, V, W -> 3
    else if cur == "F" or cur == "V" or cur == "W"
        r = 3
    // G, K, Q -> 4
    else if cur == "G" or cur == "K" or cur == "Q"
        r = 4
    // C: context-dependent
    else if cur == "C"
        // C after S or Z -> 8
        if prev == "S" or prev == "Z"
            r = 8
        // C before A/H/K/L/O/Q/R/U/X -> 4
        else if next == "A" or next == "H" or next == "K" or next == "L" or next == "O" or next == "Q" or next == "R" or next == "U" or next == "X"
            r = 4
        // C before E/I/Y -> 8
        else
            r = 8
    // X -> special: emits two codes (4 then 8); caller handles this as code 48
    else if cur == "X"
        r = 48
    // L -> 5
    else if cur == "L"
        r = 5
    // M, N -> 6
    else if cur == "M" or cur == "N"
        r = 6
    // R -> 7
    else if cur == "R"
        r = 7
    // S, Z -> 8
    else if cur == "S" or cur == "Z"
        r = 8
    r

// Returns the Cologne phonetic code for name as a digit string.
fn co_encode(name: string) -> string
    let cleaned = co_normalize(name)
    let n = len(cleaned)
    if n == 0
        return ""

    // Build raw digit list as a string of single digits (use '*' for pending X-split)
    let raw_parts = []
    let i = 0
    while i < n
        let c = _co_at(cleaned, i)
        let prev = _co_at(cleaned, i - 1)
        let nx = _co_at(cleaned, i + 1)
        let nx2 = _co_at(cleaned, i + 2)

        // SCH tri-gram -> single code 8
        if c == "S" and nx == "C" and nx2 == "H"
            push(raw_parts, "8")
            i += 3
        else
            let code = co_char_code(prev, c, nx)
            if code == 48
                // X: emits 4 then 8
                push(raw_parts, "4")
                push(raw_parts, "8")
                i += 1
            else if code == -1
                // H or unknown: silent, no digit
                i += 1
            else
                push(raw_parts, str(code))
                i += 1

    let raw = join(raw_parts, "")
    // Remove consecutive duplicate digits
    let deduped = ""
    let j = 0
    let rn = len(raw)
    while j < rn
        let d = char_at(raw, j)
        if len(deduped) == 0
            deduped += d
        else
            let prev_d = slice(deduped, len(deduped) - 1, len(deduped))
            if d != prev_d
                deduped += d
        j += 1

    // Remove all '0' digits except a leading one
    let result_parts = []
    let k = 0
    let dn = len(deduped)
    while k < dn
        let d = char_at(deduped, k)
        if d == "0"
            // Keep only if it is the very first character of deduped
            if k == 0
                push(result_parts, "0")
            // else: drop interior/trailing zeros
        else
            push(result_parts, d)
        k += 1

    let result = join(result_parts, "")
    result
