// std/event/emitter — event emitter (pub/sub), Node.js EventEmitter-style.
//
// Representation (dict e):
//   "listeners" -> dict event_name -> list of handler-entry dicts:
//                    {"fn": handler_closure, "once": 0 or 1}
//
// Handlers registered for the same event fire in registration order.
// ev_once handlers are removed automatically right after they fire once
// (they still count toward ev_listeners/ev_count until then).
//
// Public API:
//   ev_new()                         -> emitter dict (empty)
//   ev_on(emitter, name, handler)    -> (mutates; handler: data -> ())
//   ev_once(emitter, name, handler)  -> (mutates; fires at most once)
//   ev_emit(emitter, name, data)     -> int (number of handlers invoked)
//   ev_off(emitter, name)            -> (mutates; removes ALL handlers for name)
//   ev_listeners(emitter, name)      -> list of handler closures, in registration order
//   ev_count(emitter, name)          -> int
//
// LEAF — imports nothing.

// ev_new: create a new emitter with no registered events.
fn ev_new() -> dict
    let e = {}
    e["listeners"] = {}
    return e

// _ev_get_list: return the (mutable, shared-by-reference) handler-entry list
// for name, creating an empty one if this is the first registration.
fn _ev_get_list(emitter, name) -> list
    let listeners = emitter["listeners"]
    if name in listeners
        return listeners[name]
    let lst = []
    listeners[name] = lst
    return lst

// ev_on: register a handler that fires on every ev_emit(emitter, name, ...).
fn ev_on(emitter, name, handler)
    let lst = _ev_get_list(emitter, name)
    let entry = {}
    entry["fn"] = handler
    entry["once"] = 0
    push(lst, entry)

// ev_once: register a handler that fires at most once, then auto-removes.
fn ev_once(emitter, name, handler)
    let lst = _ev_get_list(emitter, name)
    let entry = {}
    entry["fn"] = handler
    entry["once"] = 1
    push(lst, entry)

// ev_emit: invoke every handler registered for name, in registration order,
// passing data. once-handlers are dropped after this call. Returns the
// number of handlers that were invoked (0 if the event has no listeners).
fn ev_emit(emitter, name, data) -> int
    let listeners = emitter["listeners"]
    if name not in listeners
        return 0
    let lst = listeners[name]
    let n = len(lst)
    let keep = []
    for i in 0..n
        let entry = lst[i]
        let handler = entry["fn"]
        handler(data)
        if entry["once"] == 0
            push(keep, entry)
    listeners[name] = keep
    return n

// ev_off: remove ALL handlers registered for name (a no-op if none exist).
fn ev_off(emitter, name)
    let listeners = emitter["listeners"]
    if name in listeners
        del(listeners, name)

// ev_listeners: handler closures currently registered for name, in
// registration order (empty list if none).
fn ev_listeners(emitter, name) -> list
    let listeners = emitter["listeners"]
    if name not in listeners
        return []
    let out = [entry["fn"] for entry in listeners[name]]
    return out

// ev_count: number of handlers currently registered for name.
fn ev_count(emitter, name) -> int
    let listeners = emitter["listeners"]
    if name not in listeners
        return 0
    return len(listeners[name])
