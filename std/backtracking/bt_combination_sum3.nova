// std/backtracking/bt_combination_sum3.nova — choose exactly k distinct numbers from 1..9 summing to n.
// LEAF — imports NOTHING. INTEGER parameters only.
//
// Public API:
//   cs3_solve(k, n) -> list  all combinations of exactly k distinct digits 1..9 summing to n
//   cs3_count(k, n) -> int   count of such combinations

// _cs3_dup_n — copy first sz elements of src into a new list
fn _cs3_dup_n(src, sz)
    let dst = []
    let i = 0
    while i < sz
        push(dst, src[i])
        i = i + 1
    dst

// _cs3_bt — backtracking core.
// start = next digit to try (1..9); depth = count chosen so far; rem = remaining sum.
// slot is a pre-allocated array of size k for the working combination.
fn _cs3_bt(k, start, rem, slot, depth, results)
    if depth == k
        if rem == 0
            push(results, _cs3_dup_n(slot, k))
        return null
    // digits remaining to place = k - depth; must fit in 1..9 range from start
    let need = k - depth
    // pruning: if not enough digits remain in 1..9, stop
    if start + need - 1 > 9
        return null
    // pruning: max possible sum from start..(start+need-1) must be >= rem;
    // min possible sum from start..(start+need-1) must be <= rem
    let d = start
    while d <= 9
        if d <= rem
            slot[depth] = d
            _cs3_bt(k, d + 1, rem - d, slot, depth + 1, results)
        d = d + 1

// cs3_solve — all combinations of exactly k distinct digits from 1..9 summing to n.
// Returns [] when impossible (k < 1, k > 9, n < 1, n > 45, or no valid combo exists).
fn cs3_solve(k: int, n: int) -> any
    let results = []
    if k < 1 or k > 9 or n < 1 or n > 45
        return results
    let slot = []
    let si = 0
    while si < k
        push(slot, 0)
        si = si + 1
    _cs3_bt(k, 1, n, slot, 0, results)
    results

// cs3_count — number of combinations of exactly k distinct digits 1..9 summing to n.
fn cs3_count(k: int, n: int) -> int
    len(cs3_solve(k, n))
