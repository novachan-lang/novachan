// std/backtracking/bt_palindrome_partition.nova — all palindromic partitions of a string.
// LEAF — imports NOTHING. Pure string/integer operations.
//
// Public API:
//   pp_solve(s)     -> list  all ways to split s into palindromic substrings (each partition = list of strings)
//   pp_count(s)     -> int   number of such partitions
//   pp_min_cuts(s)  -> int   minimum number of cuts so every piece is a palindrome
//
// Algorithm for pp_solve: backtracking from left to right.
// At each position start, try every end >= start; if s[start..end] is a palindrome,
// add it to the current partition and recurse from end+1.
// Depth-first: shorter substrings tried before longer at each start position.
// Backtracking uses pop(cur) to undo each push — lists are reference types.
//
// Algorithm for pp_min_cuts: classic O(n^2) DP.
// dp[i] = minimum number of palindromic pieces to partition s[0..i-1].
// dp[0]=0. For each pos 1..n, try all starts j; if s[j..pos-1] is palindrome,
// dp[pos] = min(dp[j]+1). Answer = dp[n]-1.

// _pp_is_palindrome — true iff s[lo..hi] (inclusive, 0-indexed) is a palindrome.
// s[i] in NOVA returns a single-character string; comparison via == is correct.
fn _pp_is_palindrome(s: string, lo: int, hi: int) -> bool
    let l = lo
    let h = hi
    while l < h
        if s[l] != s[h]
            return false
        l = l + 1
        h = h - 1
    true

// _pp_substr — extract s[lo..hi] (inclusive) as a string.
fn _pp_substr(s: string, lo: int, hi: int) -> string
    let piece = ""
    let k = lo
    while k <= hi
        piece = piece + s[k]
        k = k + 1
    piece

// _pp_dup_list — shallow copy of a list of strings (snapshot current partition).
fn _pp_dup_list(src: list) -> list
    let dst = []
    let i = 0
    let n = len(src)
    while i < n
        push(dst, src[i])
        i = i + 1
    dst

// _pp_bt — recursive backtracking for palindrome partitions.
// start = current position in s; cur = mutable working list (pop-based undo); out = collected results.
// IMPORTANT: push(cur, ...) mutates cur in place; pop(cur) undoes it. Lists are reference types.
fn _pp_bt(s: string, start: int, cur: list, out: list)
    let n = len(s)
    if start == n
        push(out, _pp_dup_list(cur))
        return null
    let end = start
    while end < n
        if _pp_is_palindrome(s, start, end)
            let piece = _pp_substr(s, start, end)
            push(cur, piece)
            _pp_bt(s, end + 1, cur, out)
            pop(cur)
        end = end + 1
    return null

// pp_solve — all palindromic partitions of s (each partition is a list of strings).
// Depth-first: at each start position, shorter substrings tried before longer.
// pp_solve("") = [[]] (one partition: the empty partition).
// pp_solve("a") = [["a"]].
fn pp_solve(s: string) -> list
    let out = []
    let cur = []
    _pp_bt(s, 0, cur, out)
    out

// pp_count — number of ways to split s into palindromic substrings.
// pp_count("") = 1, pp_count("a") = 1, pp_count("aab") = 2, pp_count("aaa") = 4.
fn pp_count(s: string) -> int
    let out = []
    let cur = []
    _pp_bt(s, 0, cur, out)
    len(out)

// pp_min_cuts — minimum cuts so every resulting piece is a palindrome.
// A string that is already a palindrome needs 0 cuts.
// Uses O(n^2) DP: precompute is_palindrome table, then compute min-pieces DP.
// pp_min_cuts("") = 0, pp_min_cuts("a") = 0, pp_min_cuts("aab") = 1,
// pp_min_cuts("aba") = 0, pp_min_cuts("abccba") = 0.
fn pp_min_cuts(s: string) -> int
    let n = len(s)
    if n <= 1
        return 0
    // Build flat is_pal table: is_pal[i*n+j] = 1 iff s[i..j] palindrome.
    // Use expand-around-center for O(n^2) time.
    let is_pal = []
    let fill = 0
    while fill < n * n
        push(is_pal, 0)
        fill = fill + 1
    // Single characters are palindromes.
    let i = 0
    while i < n
        is_pal[i * n + i] = 1
        i = i + 1
    // Odd-length palindromes (center ci, radius r).
    let ci = 0
    while ci < n
        let r = 1
        while ci - r >= 0 and ci + r < n and s[ci - r] == s[ci + r]
            is_pal[(ci - r) * n + (ci + r)] = 1
            r = r + 1
        ci = ci + 1
    // Even-length palindromes (center between ce and ce+1).
    let ce = 0
    while ce < n - 1
        if s[ce] == s[ce + 1]
            is_pal[ce * n + (ce + 1)] = 1
            let r = 1
            while ce - r >= 0 and ce + 1 + r < n and s[ce - r] == s[ce + 1 + r]
                is_pal[(ce - r) * n + (ce + 1 + r)] = 1
                r = r + 1
        ce = ce + 1
    // If whole string is already palindrome, 0 cuts.
    if is_pal[0 * n + (n - 1)] == 1
        return 0
    // DP: dp[i] = min number of pieces to partition s[0..i-1].
    // dp[0] = 0 (empty prefix needs 0 pieces).
    // dp[i] = min(dp[j] + 1) for all 0 <= j < i where s[j..i-1] is palindrome.
    let dp = []
    let di = 0
    while di <= n
        push(dp, n + 1)
        di = di + 1
    dp[0] = 0
    let pos = 1
    while pos <= n
        let j = 0
        while j < pos
            if is_pal[j * n + (pos - 1)] == 1
                if dp[j] + 1 < dp[pos]
                    dp[pos] = dp[j] + 1
            j = j + 1
        pos = pos + 1
    // dp[n] = min number of palindromic pieces; cuts = pieces - 1.
    dp[n] - 1
