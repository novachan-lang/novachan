// std/backtracking/bt_subsets_dup.nova — all unique subsets of a list with duplicates.
// LEAF — imports NOTHING.
//
// Public API:
//   sd_solve(nums)  -> list  all unique subsets (nums may contain duplicates; sort first,
//                            skip duplicate choices at the same recursion depth)
//   sd_count(nums)  -> int   number of unique subsets

// _sd_dup — shallow copy of a list (avoids aliasing when storing a solution)
fn _sd_dup(src) -> any
    let dst = []
    let i = 0
    let n = len(src)
    while i < n
        push(dst, src[i])
        i = i + 1
    dst

// _sd_sort — sort a list via insertion sort, returns a fresh sorted copy
fn _sd_sort(a) -> any
    let b = _sd_dup(a)
    let n = len(b)
    for i in 1..n
        let key = b[i]
        let j = i - 1
        while j >= 0 and b[j] > key
            b[j + 1] = b[j]
            j = j - 1
        b[j + 1] = key
    b

// _sd_snap — copy the first `depth` elements of slot into a fresh list
fn _sd_snap(slot, depth) -> any
    let out = []
    let i = 0
    while i < depth
        push(out, slot[i])
        i = i + 1
    out

// _sd_gen — recursive backtracking using a pre-allocated slot array.
// slot[0..depth-1] are the currently chosen elements (live portion of the working subset).
// At each call we record the current subset, then try each position i >= start in sorted
// nums, skipping i > start when nums[i] == nums[i-1] (duplicate element at same depth).
fn _sd_gen(nums, slot, depth, start, result)
    let n = len(nums)
    push(result, _sd_snap(slot, depth))
    let i = start
    while i < n
        let skip = 0
        if i > start and nums[i] == nums[i - 1]
            skip = 1
        if skip == 0
            slot[depth] = nums[i]
            _sd_gen(nums, slot, depth + 1, i + 1, result)
        i = i + 1

// sd_solve — all unique subsets of nums (which may contain duplicates).
// Sorts nums first then uses backtracking with duplicate-skip at each level.
fn sd_solve(nums) -> any
    let sorted = _sd_sort(nums)
    let n = len(sorted)
    let result = []
    let slot = [0 for i in 0..n]
    _sd_gen(sorted, slot, 0, 0, result)
    result

// sd_count — number of unique subsets (= len(sd_solve(nums))).
fn sd_count(nums) -> int
    let r = sd_solve(nums)
    len(r)
