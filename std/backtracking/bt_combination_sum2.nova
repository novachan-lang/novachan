// std/backtracking/bt_combination_sum2.nova — combinations with each candidate used at most once.
// LEAF — imports NOTHING. INTEGER candidates and target only.
// Input may contain duplicates; no duplicate combinations are returned.
//
// Public API:
//   cs2_solve(candidates, target) -> list  all unique non-decreasing combinations summing to target
//   cs2_count(candidates, target) -> int   count of such combinations

// _cs2_dup_n — copy first n elements of src into a new list
fn _cs2_dup_n(src, n)
    let dst = [src[i] for i in 0..n]
    dst

// _cs2_dup — shallow copy of a whole list
fn _cs2_dup(src)
    _cs2_dup_n(src, len(src))

// _cs2_sort — insertion sort in ascending order in-place
fn _cs2_sort(arr)
    let n = len(arr)
    for i in 1..n
        let key = arr[i]
        let j = i - 1
        while j >= 0 and arr[j] > key
            arr[j + 1] = arr[j]
            j = j - 1
        arr[j + 1] = key

// _cs2_bt — backtracking core for at-most-once use.
// slot is a pre-allocated working array; depth = current combo length; rem = remaining sum.
// At each level, skip candidates equal to previous at the SAME level to avoid duplicates.
fn _cs2_bt(candidates, start, rem, slot, depth, results)
    if rem == 0
        push(results, _cs2_dup_n(slot, depth))
        return null
    let n = len(candidates)
    let i = start
    while i < n
        let c = candidates[i]
        // skip duplicate at this recursion level (same position, not parent)
        if i > start and candidates[i] == candidates[i - 1]
            i = i + 1
        else
            if c <= rem
                slot[depth] = c
                _cs2_bt(candidates, i + 1, rem - c, slot, depth + 1, results)
            i = i + 1

// cs2_solve — all unique non-decreasing combinations where each candidate is used at most once.
// Input duplicates are allowed (e.g. [1,1,2] can form the combo [1,1]).
// Returns [] if no combination exists or target < 0.
fn cs2_solve(candidates, target) -> any
    let results = []
    if target < 0
        return results
    if target == 0
        push(results, [])
        return results
    let sorted = _cs2_dup(candidates)
    _cs2_sort(sorted)
    let n = len(sorted)
    // max combo length bounded by n (each element used once)
    let slot = [0 for si in 0..n]
    _cs2_bt(sorted, 0, target, slot, 0, results)
    results

// cs2_count — number of unique combinations where each candidate is used at most once.
fn cs2_count(candidates, target) -> int
    len(cs2_solve(candidates, target))
