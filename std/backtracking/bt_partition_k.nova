// std/backtracking/bt_partition_k.nova — multiset partition into k equal-sum subsets.
// LEAF — imports NOTHING.
//
// Public API:
//   pk_can_partition(nums, k)     -> bool  true if nums splits into k equal-sum subsets
//   pk_subset_sum_target(nums, k) -> int   required per-subset sum, or -1 if not divisible

// _pk_sum — sum all elements of nums.
fn _pk_sum(nums) -> int
    let s = 0
    let i = 0
    while i < len(nums)
        s = s + nums[i]
        i = i + 1
    s

// _pk_max — maximum element (0 for empty list).
fn _pk_max(nums) -> int
    let n = len(nums)
    if n == 0
        return 0
    let m = nums[0]
    let i = 1
    while i < n
        if nums[i] > m
            m = nums[i]
        i = i + 1
    m

// _pk_sort_desc — in-place insertion sort descending.
fn _pk_sort_desc(arr)
    let n = len(arr)
    let i = 1
    while i < n
        let key = arr[i]
        let j = i - 1
        while j >= 0 and arr[j] < key
            arr[j + 1] = arr[j]
            j = j - 1
        arr[j + 1] = key
        i = i + 1

// _pk_dup — shallow copy of a list.
fn _pk_dup(src)
    let dst = []
    let i = 0
    while i < len(src)
        push(dst, src[i])
        i = i + 1
    dst

// _pk_bt — backtracking: place nums[idx] into a bucket and recurse to idx+1.
// buckets[0..k-1] hold the current sum for each bucket.
// Returns 1 if a valid k-partition is possible, 0 otherwise.
// Invariant: items 0..idx-1 are already placed; place nums[idx] next.
fn _pk_bt(nums, buckets, k: int, target: int, idx: int) -> int
    let n = len(nums)
    if idx == n
        // All items placed; check all buckets hit target
        let ok = 1
        let b = 0
        while b < k
            if buckets[b] != target
                ok = 0
            b = b + 1
        return ok
    let val = nums[idx]
    let prev = -1
    let i = 0
    while i < k
        // Symmetry pruning: skip bucket if same sum as a previously tried bucket this call.
        if buckets[i] != prev
            if buckets[i] + val <= target
                prev = buckets[i]
                buckets[i] = buckets[i] + val
                let sub = _pk_bt(nums, buckets, k, target, idx + 1)
                buckets[i] = buckets[i] - val
                if sub == 1
                    return 1
        i = i + 1
    0

// pk_subset_sum_target — per-subset sum if total divisible by k, else -1.
fn pk_subset_sum_target(nums, k: int) -> int
    if k <= 0
        return -1
    let total = _pk_sum(nums)
    if total - (total / k) * k != 0
        return -1
    total / k

// pk_can_partition — true if nums can be partitioned into k equal-sum subsets.
fn pk_can_partition(nums, k: int) -> bool
    let n = len(nums)
    if k <= 0
        return false
    if k == 1
        return true
    if n < k
        return false
    let total = _pk_sum(nums)
    if total - (total / k) * k != 0
        return false
    let target = total / k
    if _pk_max(nums) > target
        return false
    let work = _pk_dup(nums)
    _pk_sort_desc(work)
    let buckets = []
    let bi = 0
    while bi < k
        push(buckets, 0)
        bi = bi + 1
    let r = _pk_bt(work, buckets, k, target, 0)
    r == 1
