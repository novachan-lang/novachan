// std/backtracking/bt_word_break.nova — segment a string into dictionary word sequences.
// LEAF — imports NOTHING.
//
// Public API:
//   wb_can_break(s, dict)   -> bool   true if s can be fully segmented using words in dict
//   wb_all_breaks(s, dict)  -> list   all space-joined sentence strings (each segmentation)
//   wb_count(s, dict)       -> int    number of distinct segmentations

// _wb_substr — extract s[start..start+length-1] as a new string using char_at.
fn _wb_substr(s: string, start: int, length: int) -> string
    let result = ""
    let i = 0
    while i < length
        result = result + char_at(s, start + i)
        i = i + 1
    result

// _wb_contains — true if the string w is present in the list dict.
fn _wb_contains(dict, w: string) -> bool
    let i = 0
    let n = len(dict)
    while i < n
        if dict[i] == w
            return true
        i = i + 1
    false

// _wb_can_rec — recursive helper: can s[start..] be fully segmented?
fn _wb_can_rec(s: string, dict, start: int) -> bool
    let slen = len(s)
    if start == slen
        return true
    let end = start + 1
    while end <= slen
        let word = _wb_substr(s, start, end - start)
        if _wb_contains(dict, word)
            if _wb_can_rec(s, dict, end)
                return true
        end = end + 1
    false

// wb_can_break — true if s can be fully segmented using words in dict.
// Empty string is always breakable (zero words needed).
fn wb_can_break(s: string, dict) -> bool
    _wb_can_rec(s, dict, 0)

// _wb_all_rec — backtracking: collect all segmentations of s[start..] into result.
// current is the space-joined prefix built so far.
fn _wb_all_rec(s: string, dict, start: int, current: string, result)
    let slen = len(s)
    if start == slen
        push(result, current)
        return null
    let end = start + 1
    while end <= slen
        let word = _wb_substr(s, start, end - start)
        if _wb_contains(dict, word)
            let next = ""
            if len(current) == 0
                next = word
            else
                next = current + " " + word
            _wb_all_rec(s, dict, end, next, result)
        end = end + 1

// wb_all_breaks — list of all space-joined sentence strings for every valid segmentation.
// Returns [] if no segmentation exists. Returns [""] if s is empty.
fn wb_all_breaks(s: string, dict) -> any
    let result = []
    if len(s) == 0
        push(result, "")
        return result
    _wb_all_rec(s, dict, 0, "", result)
    result

// wb_count — number of distinct segmentations of s using words from dict.
// wb_count("", dict) = 1 (the empty segmentation).
fn wb_count(s: string, dict) -> int
    let all = wb_all_breaks(s, dict)
    len(all)
