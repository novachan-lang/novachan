// std/backtracking/bt_permutations_dup.nova — all unique permutations of a list with duplicates.
// LEAF — imports NOTHING.
//
// Public API:
//   pd_solve(nums)  -> list  all unique permutations in lexicographic order
//   pd_count(nums)  -> int   number of unique permutations

// _pd_dup — shallow copy of a list
fn _pd_dup(src) -> any
    let dst = []
    let i = 0
    let n = len(src)
    while i < n
        push(dst, src[i])
        i += 1
    dst

// _pd_sort — insertion sort, returns fresh sorted copy
fn _pd_sort(a) -> any
    let b = _pd_dup(a)
    let n = len(b)
    for i in 1..n
        let key = b[i]
        let j = i - 1
        while j >= 0 and b[j] > key
            b[j + 1] = b[j]
            j -= 1
        b[j + 1] = key
    b

// _pd_snap — copy the first `depth` elements of slot into a fresh list
fn _pd_snap(slot, depth) -> any
    let out = []
    let i = 0
    while i < depth
        push(out, slot[i])
        i += 1
    out

// _pd_gen — recursive backtracking for unique permutations.
// sorted = sorted source list (fixed), slot = working array (pre-allocated n slots),
// used = 0/1 flags (size n), depth = how many elements placed so far, out = results.
// Duplicate skip: if items[i] == items[i-1] AND items[i-1] was NOT used, then
// choosing items[i] here would produce a duplicate subtree — skip it.
fn _pd_gen(sorted, slot, used, depth, out)
    let n = len(sorted)
    if depth == n
        push(out, _pd_snap(slot, depth))
        return null
    let last_val = -2147483648
    for i in 0..n
        if used[i] == 0
            if sorted[i] != last_val
                last_val = sorted[i]
                used[i] = 1
                slot[depth] = sorted[i]
                _pd_gen(sorted, slot, used, depth + 1, out)
                used[i] = 0

// pd_solve — all unique permutations of nums (which may contain duplicates).
// Returns permutations in lexicographic order (sort nums first, then backtrack).
fn pd_solve(nums) -> any
    let n = len(nums)
    let out = []
    if n == 0
        push(out, [])
        return out
    let sorted = _pd_sort(nums)
    let used = []
    let slot = []
    for i in 0..n
        push(used, 0)
        push(slot, 0)
    _pd_gen(sorted, slot, used, 0, out)
    out

// pd_count — number of unique permutations (= len(pd_solve(nums))).
fn pd_count(nums) -> int
    let r = pd_solve(nums)
    len(r)
