// std/sketch/streamstats.nova — Online/streaming statistics (Welford's algorithm).
//
// Welford (1962) one-pass numerically stable mean and variance.
// No list storage required — O(1) space per stream.
//
// State dict keys (Welford):
//   "n"    -> count (int)
//   "mean" -> running mean (float, stored as string "f:<bits>")
//   "m2"   -> sum of squared deviations (float)
//   "mn"   -> minimum seen (float)
//   "mx"   -> maximum seen (float)
//   "sum"  -> running sum (float)
//
// EMA state dict keys:
//   "alpha" -> smoothing factor (float)
//   "val"   -> current EMA value (float)
//   "init"  -> 0 or 1 (int), whether first value has been seen
//
// NOVA float gotcha: bind every float sub-expression to a let before passing to
// another call.  Never return a large compound float expression directly.
//
// LEAF — imports nothing.  All helpers prefixed ss_.

// ss_new: create a new Welford streaming statistics state.
fn ss_new() -> any
    let state = {}
    state["n"] = 0
    state["mean"] = 0.0
    state["m2"] = 0.0
    state["mn"] = 0.0
    state["mx"] = 0.0
    state["sum"] = 0.0
    state

// ss_push: update state with a new observation x (Welford online update).
fn ss_push(state, x) -> any
    let fx = x * 1.0
    let n_old = state["n"]
    let n_new = n_old + 1
    let mean_old = state["mean"]
    let delta = fx - mean_old
    let fn_new = n_new * 1.0
    let mean_new = mean_old + delta / fn_new
    let delta2 = fx - mean_new
    let m2_old = state["m2"]
    let m2_new = m2_old + delta * delta2
    let sum_old = state["sum"]
    let sum_new = sum_old + fx
    let mn_old = state["mn"]
    let mx_old = state["mx"]
    let mn_new = mn_old
    let mx_new = mx_old
    if n_old == 0
        mn_new = fx
        mx_new = fx
    else
        if fx < mn_old
            mn_new = fx
        if fx > mx_old
            mx_new = fx
    state["n"] = n_new
    state["mean"] = mean_new
    state["m2"] = m2_new
    state["sum"] = sum_new
    state["mn"] = mn_new
    state["mx"] = mx_new
    state

// ss_count: number of observations pushed.
fn ss_count(state) -> int
    state["n"]

// ss_mean: arithmetic mean of all pushed values; 0.0 if empty.
fn ss_mean(state) -> float
    let n = state["n"]
    if n == 0
        return 0.0
    let m = state["mean"]
    m

// ss_variance: population variance = m2 / n; 0.0 if empty.
fn ss_variance(state) -> float
    let n = state["n"]
    if n == 0
        return 0.0
    let m2 = state["m2"]
    let fn_val = n * 1.0
    let v = m2 / fn_val
    v

// ss_sample_variance: sample variance = m2 / (n-1); 0.0 if n < 2.
fn ss_sample_variance(state) -> float
    let n = state["n"]
    if n < 2
        return 0.0
    let m2 = state["m2"]
    let fn_val = (n - 1) * 1.0
    let v = m2 / fn_val
    v

// ss_stddev: population standard deviation = sqrt(population variance); 0.0 if empty.
fn ss_stddev(state) -> float
    let v = ss_variance(state)
    let fv = v * 1.0
    let sd = sqrt(fv)
    sd

// ss_min: minimum observed value; 0.0 if empty.
fn ss_min(state) -> float
    let n = state["n"]
    if n == 0
        return 0.0
    let m = state["mn"]
    m

// ss_max: maximum observed value; 0.0 if empty.
fn ss_max(state) -> float
    let n = state["n"]
    if n == 0
        return 0.0
    let m = state["mx"]
    m

// ss_sum: sum of all pushed values; 0.0 if empty.
fn ss_sum(state) -> float
    let n = state["n"]
    if n == 0
        return 0.0
    let s = state["sum"]
    s

// ss_range: max - min; 0.0 if empty or single element.
fn ss_range(state) -> float
    let n = state["n"]
    if n == 0
        return 0.0
    let mx = state["mx"]
    let mn = state["mn"]
    let r = mx - mn
    r

// ss_ema_new: create an Exponential Moving Average state with smoothing factor alpha.
// alpha in (0.0, 1.0): larger = more weight on recent values.
fn ss_ema_new(alpha) -> any
    let state = {}
    state["alpha"] = alpha * 1.0
    state["val"] = 0.0
    state["init"] = 0
    state

// ss_ema_push: update EMA with new value x; returns the new EMA value.
// First value initializes the EMA to x (no prior history).
// Formula: ema = alpha * x + (1 - alpha) * ema_prev
fn ss_ema_push(state, x) -> float
    let fx = x * 1.0
    let init = state["init"]
    if init == 0
        state["val"] = fx
        state["init"] = 1
        return fx
    let alpha = state["alpha"]
    let prev = state["val"]
    let one_minus = 1.0 - alpha
    let new_val = alpha * fx + one_minus * prev
    state["val"] = new_val
    new_val
