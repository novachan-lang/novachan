// countmin — Count-Min Sketch for frequency estimation.
//
// Representation (dict):
//   "w"      — width (number of counters per row)
//   "d"      — depth (number of hash rows)
//   "counts" — flat list of d*w int counters (row r, col c => r*w + c)
//   "total"  — total increments added
//
// Two independent 63-bit hashes are derived per row using different seeds.
// For row r the column index is: (_cm_h63a(item) + r * _cm_h63b(item)) % width
// This gives `d` independent hash projections cheaply without storing d seeds.
//
// Count-Min NEVER UNDERESTIMATES: estimate(x) >= true_count(x).

// Primary 63-bit hash: seed=1125899906842597, multiplier=131.
fn _cm_h63a(s: string) -> int
    let h = 1125899906842597
    let i = 0
    let n = len(s)
    while i < n
        h = (h * 131 + ord(char_at(s, i))) & 0x7FFFFFFFFFFFFFFF
        i = i + 1
    return h

// Secondary 63-bit hash: seed=6364136223846793005, multiplier=137.
fn _cm_h63b(s: string) -> int
    let h = 6364136223846793005 & 0x7FFFFFFFFFFFFFFF
    let i = 0
    let n = len(s)
    while i < n
        h = (h * 137 + ord(char_at(s, i))) & 0x7FFFFFFFFFFFFFFF
        i = i + 1
    return h

// Create a new Count-Min Sketch with the given width and depth.
fn cm_new(width: int, depth: int) -> any
    let counts = []
    let total = width * depth
    let i = 0
    while i < total
        push(counts, 0)
        i = i + 1
    let state = {}
    state["w"] = width
    state["d"] = depth
    state["counts"] = counts
    state["total"] = 0
    return state

// Increment the count for item by 1.
fn cm_add(state: any, item: string) -> any
    return cm_add_n(state, item, 1)

// Increment the count for item by n.
fn cm_add_n(state: any, item: string, n: int) -> any
    let w = state["w"]
    let d = state["d"]
    let counts = state["counts"]
    let ha = _cm_h63a(item)
    let hb = _cm_h63b(item)
    let r = 0
    while r < d
        let col = ((ha + (r * hb) & 0x7FFFFFFFFFFFFFFF) & 0x7FFFFFFFFFFFFFFF) % w
        let idx = r * w + col
        counts[idx] = counts[idx] + n
        r = r + 1
    state["total"] = state["total"] + n
    return state

// Return the Count-Min estimate for item (minimum over all rows — never underestimates).
fn cm_estimate(state: any, item: string) -> int
    let w = state["w"]
    let d = state["d"]
    let counts = state["counts"]
    let ha = _cm_h63a(item)
    let hb = _cm_h63b(item)
    let r = 0
    let min_val = -1
    while r < d
        let col = ((ha + (r * hb) & 0x7FFFFFFFFFFFFFFF) & 0x7FFFFFFFFFFFFFFF) % w
        let idx = r * w + col
        let v = counts[idx]
        if min_val < 0
            min_val = v
        if v < min_val
            min_val = v
        r = r + 1
    if min_val < 0
        return 0
    return min_val

// Return the total number of increments added to the sketch.
fn cm_total(state: any) -> int
    return state["total"]

// Return the width of the sketch.
fn cm_width(state: any) -> int
    return state["w"]

// Return the depth (number of hash rows) of the sketch.
fn cm_depth(state: any) -> int
    return state["d"]

// Merge sketch b into sketch a (must have same width and depth). Returns a.
fn cm_merge(a: any, b: any) -> any
    let w = a["w"]
    let d = a["d"]
    let ca = a["counts"]
    let cb = b["counts"]
    let total = w * d
    let i = 0
    while i < total
        ca[i] = ca[i] + cb[i]
        i = i + 1
    a["total"] = a["total"] + b["total"]
    return a
