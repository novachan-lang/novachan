// bloomscalable — scalable Bloom filter (Almeida et al. 2007).
//
// Grows automatically by appending new sub-filters when the current one fills.
// Each sub-filter uses double-hashing: h1 (63-bit, seed A) and h2 (63-bit, seed B).
// GUARANTEE: NO FALSE NEGATIVES across growth — if an item was added to any
// sub-filter, sbf_contains returns true.
// State: a dict with "filters" (list of sub-filter dicts), "k" (hash probes),
// "init_size" (first filter size), "count_added" (total items inserted).
// Each sub-filter dict: "bits" (list), "nbits" (int), "k" (int), "count" (int).

// 63-bit hash seed A — primary hash.
fn _sbf_h1(s) -> int
    let h = 1125899906842597
    let i = 0
    let n = len(s)
    while i < n
        h = (h * 131 + ord(char_at(s, i))) & 0x7FFFFFFFFFFFFFFF
        i += 1
    return h

// 63-bit hash seed B — secondary hash (different multiplier and seed).
fn _sbf_h2(s) -> int
    let h = 6364136223846793005
    let i = 0
    let n = len(s)
    while i < n
        h = (h * 1099511628211 + ord(char_at(s, i))) & 0x7FFFFFFFFFFFFFFF
        i += 1
    return h

// Build a fresh sub-filter with nbits bit slots and k probes.
fn _sbf_make_filter(nbits, k) -> any
    let bits = [0 for i in 0..nbits]
    return {"bits": bits, "nbits": nbits, "k": k, "count": 0}

// Test whether sub-filter f contains item (all k probed bits must be 1).
fn _sbf_filter_contains(f, item) -> bool
    let h1 = _sbf_h1(item)
    let h2 = _sbf_h2(item)
    let nbits = f["nbits"]
    let k = f["k"]
    let bits = f["bits"]
    for j in 0..k
        let idx = (h1 + j * h2) % nbits
        if bits[idx] == 0
            return false
    return true

// Set k bits in sub-filter f for item.
fn _sbf_filter_add(f, item)
    let h1 = _sbf_h1(item)
    let h2 = _sbf_h2(item)
    let nbits = f["nbits"]
    let k = f["k"]
    let bits = f["bits"]
    for j in 0..k
        let idx = (h1 + j * h2) % nbits
        bits[idx] = 1
    f["count"] += 1

// Create a new scalable Bloom filter.
// initial_size = bit slots in the first sub-filter; k = hash probes per item.
fn sbf_new(initial_size, k) -> any
    return {"init_size": initial_size, "k": k, "count_added": 0, "filters": [_sbf_make_filter(initial_size, k)]}

// Add an item to the scalable filter. Grows by doubling when fill > 50%.
fn sbf_add(st, item) -> any
    let filters = st["filters"]
    let n = len(filters)
    let cur = filters[n - 1]
    let nbits = cur["nbits"]
    let cnt = cur["count"]
    // Fill ratio threshold ~0.5: if more than half the slots are used, grow.
    // We track items added to this sub-filter; each item sets k bits, so
    // fill proxy = count (items) * k / nbits > 0.5 => count > nbits / (2*k).
    let k = st["k"]
    let threshold = nbits / (2 * k)
    if cnt >= threshold
        let new_size = nbits * 2
        let new_f = _sbf_make_filter(new_size, k)
        push(filters, new_f)
        _sbf_filter_add(new_f, item)
    else
        _sbf_filter_add(cur, item)
    st["count_added"] += 1
    return st

// Return true if the item is present in ANY sub-filter (no false negatives).
fn sbf_contains(st, item) -> bool
    let filters = st["filters"]
    let n = len(filters)
    for i in 0..n
        if _sbf_filter_contains(filters[i], item)
            return true
    return false

// Return the number of sub-filters currently allocated.
fn sbf_num_filters(st) -> int
    return len(st["filters"])

// Return the total number of items that have been added.
fn sbf_count_added(st) -> int
    return st["count_added"]

// Return the fill ratio of the current (last) sub-filter (items*k / nbits).
fn sbf_fill_ratio(st) -> float
    let filters = st["filters"]
    let n = len(filters)
    let cur = filters[n - 1]
    let nbits = cur["nbits"]
    let cnt = cur["count"]
    let k = st["k"]
    if nbits == 0
        return 0.0
    let used = cnt * k
    return used * 1.0 / nbits

// Clear all sub-filters and reset to a single empty filter.
fn sbf_clear(st) -> any
    let init_size = st["init_size"]
    let k = st["k"]
    st["count_added"] = 0
    st["filters"] = [_sbf_make_filter(init_size, k)]
    return st

// Return the total bit capacity across all sub-filters.
fn sbf_capacity(st) -> int
    let filters = st["filters"]
    let n = len(filters)
    let total = 0
    for i in 0..n
        total += filters[i]["nbits"]
    return total
