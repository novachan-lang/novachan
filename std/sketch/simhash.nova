// std/sketch/simhash.nova — SimHash (Charikar 2002) for near-duplicate detection.
//
// SimHash maps a token set to a single 64-bit fingerprint such that similar
// sets produce fingerprints with low Hamming distance. This makes it ideal
// for near-duplicate detection in documents.
//
// Algorithm (Charikar):
//   1. For each of 64 bit positions, maintain a running integer accumulator.
//   2. For each token, compute its 63-bit hash h63 (deterministic).
//   3. For each bit position i: if bit i of h63(token) is 1, add +1; else -1.
//   4. Final fingerprint: if accumulator[i] > 0, bit i = 1; else bit i = 0.
//
// The result is a 64-bit integer (signed i64). Hamming distance counts
// differing bits between two fingerprints.
//
// Hash function: _h63 — seed 1125899906842597, multiplier 131.

// ---------------------------------------------------------------------------
// Private: 63-bit hash. Seed=1125899906842597, mult=131.
// Always non-negative (bit 63 masked to 0).
// ---------------------------------------------------------------------------
fn _sh_h63(s)
    let h = 1125899906842597
    let n = len(s)
    let i = 0
    let mask = 0x7FFFFFFFFFFFFFFF
    while i < n
        let c = ord(char_at(s, i))
        h = (h * 131 + c) & mask
        i += 1
    return h

// ---------------------------------------------------------------------------
// Private: logical right-shift by n bits (NOVA >> is arithmetic).
// ---------------------------------------------------------------------------
fn _sh_shr(x, n)
    let mask = (1 << (63 - n)) - 1
    return (x >> n) & mask

// ---------------------------------------------------------------------------
// Return bit i (0-indexed from LSB) of a 64-bit value h.
// ---------------------------------------------------------------------------
fn sh_bit(h, i)
    let shifted = _sh_shr(h, i)
    return shifted & 1

// ---------------------------------------------------------------------------
// Return the weighted bit contribution of token at bit position i.
// Returns +1 if that bit of _h63(token) is set, else -1.
// ---------------------------------------------------------------------------
fn sh_weight_bit(token, i)
    let h = _sh_h63(token)
    let b = sh_bit(h, i)
    if b == 1
        return 1
    return 0 - 1

// ---------------------------------------------------------------------------
// Compute the SimHash fingerprint of a list of tokens.
// Returns a 64-bit integer (signed i64). The fingerprint is deterministic.
// Empty token list returns 0.
// ---------------------------------------------------------------------------
fn sh_hash(tokens)
    // 64 accumulators, one per bit position. Stored as a list of 64 ints.
    let acc = [0 for bi in 0..64]
    // Process each token.
    let t = 0
    let nt = len(tokens)
    while t < nt
        let tok = tokens[t]
        let h = _sh_h63(tok)
        // Update each accumulator based on this token's hash bit.
        for i in 0..63
            let b = sh_bit(h, i)
            if b == 1
                acc[i] = acc[i] + 1
            else
                acc[i] = acc[i] - 1
        t += 1
    // Build the final fingerprint: bit i = 1 if acc[i] > 0 else 0.
    let fingerprint = 0
    for i in 0..63
        if acc[i] > 0
            let bit_val = 1 << i
            fingerprint = fingerprint | bit_val
    return fingerprint

// ---------------------------------------------------------------------------
// Count the number of differing bits between two SimHash fingerprints.
// Uses the standard XOR + popcount approach.
// ---------------------------------------------------------------------------
fn sh_hamming(a, b)
    let xor_val = a ^ b
    // Popcount: count set bits in xor_val (63 bits; bit 63 = sign bit stays 0).
    let count = 0
    let v = xor_val
    for i in 0..63
        let bit_v = v & 1
        count += bit_v
        v = _sh_shr(v, 1)
    return count

// ---------------------------------------------------------------------------
// Return true if the Hamming distance between a and b is <= threshold.
// ---------------------------------------------------------------------------
fn sh_similar(a, b, threshold)
    let d = sh_hamming(a, b)
    if d <= threshold
        return true
    return false

// ---------------------------------------------------------------------------
// Compute the SimHash Hamming distance between two token lists directly.
// Convenience wrapper: sh_hash both sets then sh_hamming.
// ---------------------------------------------------------------------------
fn sh_distance_tokens(tokens_a, tokens_b)
    let ha = sh_hash(tokens_a)
    let hb = sh_hash(tokens_b)
    return sh_hamming(ha, hb)

// ---------------------------------------------------------------------------
// Tokenize text on spaces and compute its SimHash fingerprint.
// Splits by scanning for space characters; each non-space run is one token.
// ---------------------------------------------------------------------------
fn sh_of_text(text)
    let tokens = []
    let n = len(text)
    let start = 0 - 1
    for i in 0..n
        let c = char_at(text, i)
        if c == " "
            if start >= 0
                let tok = slice(text, start, i)
                push(tokens, tok)
                start = 0 - 1
        else
            if start < 0
                start = i
    // Capture trailing token if text doesn't end with space.
    if start >= 0
        let tok = slice(text, start, n)
        push(tokens, tok)
    let h = sh_hash(tokens)
    return h
