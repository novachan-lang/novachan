// countingbloom — Counting Bloom filter: deletable probabilistic membership.
//
// Representation (dict):
//   "size"   — number of integer counter slots
//   "k"      — number of hash probes per item
//   "counts" — flat list of `size` int counters (non-negative)
//   "added"  — total number of cf_add calls
//
// Double-hashing scheme (Kirsch-Mitzenmacher):
//   h1 = _cbf_h1(item)  (63-bit primary hash)
//   h2 = _cbf_h2(item)  (63-bit secondary hash)
//   probe j (0..k-1): index = (h1 + j * h2) mod size
//
// Counting Bloom NEVER produces false negatives: if cbf_add(x) was called
// without a matching cbf_delete, cbf_contains(x) is always true.
// cbf_delete decrements counters, floored at 0 to prevent underflow.

// Primary 63-bit hash: seed=1125899906842597, multiplier=131.
fn _cbf_h1(s: string) -> int
    let h = 1125899906842597
    let i = 0
    let n = len(s)
    while i < n
        h = (h * 131 + ord(char_at(s, i))) & 0x7FFFFFFFFFFFFFFF
        i = i + 1
    return h

// Secondary 63-bit hash: seed=6364136223846793005 (masked), multiplier=137.
fn _cbf_h2(s: string) -> int
    let h = 6364136223846793005 & 0x7FFFFFFFFFFFFFFF
    let i = 0
    let n = len(s)
    while i < n
        h = (h * 137 + ord(char_at(s, i))) & 0x7FFFFFFFFFFFFFFF
        i = i + 1
    return h

// Return the k probe indices for item in a filter of given size.
// Returns a list of k indices (all in [0, size)).
fn cbf_hashes(item: string, k: int, size: int) -> any
    let h1 = _cbf_h1(item)
    let h2 = _cbf_h2(item)
    let indices = []
    for j in 0..k
        let combined = (h1 + (j * h2) & 0x7FFFFFFFFFFFFFFF) & 0x7FFFFFFFFFFFFFFF
        let idx = combined % size
        push(indices, idx)
    return indices

// Create a new Counting Bloom filter with `size` counter slots and `k` hash probes.
fn cbf_new(size: int, k: int) -> any
    let counts = [0 for i in 0..size]
    let state = {}
    state["size"] = size
    state["k"] = k
    state["counts"] = counts
    state["added"] = 0
    return state

// Add item to the filter (increment all k counters).
fn cbf_add(state: any, item: string) -> any
    let size = state["size"]
    let k = state["k"]
    let counts = state["counts"]
    let h1 = _cbf_h1(item)
    let h2 = _cbf_h2(item)
    for j in 0..k
        let combined = (h1 + (j * h2) & 0x7FFFFFFFFFFFFFFF) & 0x7FFFFFFFFFFFFFFF
        let idx = combined % size
        counts[idx] = counts[idx] + 1
    state["added"] = state["added"] + 1
    return state

// Return true if item is possibly in the filter (all k counters > 0).
// Returns false if ANY counter is 0 (definite non-member — no false negatives).
fn cbf_contains(state: any, item: string) -> bool
    let size = state["size"]
    let k = state["k"]
    let counts = state["counts"]
    let h1 = _cbf_h1(item)
    let h2 = _cbf_h2(item)
    for j in 0..k
        let combined = (h1 + (j * h2) & 0x7FFFFFFFFFFFFFFF) & 0x7FFFFFFFFFFFFFFF
        let idx = combined % size
        if counts[idx] == 0
            return false
    return true

// Delete item from the filter (decrement all k counters, floored at 0).
fn cbf_delete(state: any, item: string) -> any
    let size = state["size"]
    let k = state["k"]
    let counts = state["counts"]
    let h1 = _cbf_h1(item)
    let h2 = _cbf_h2(item)
    for j in 0..k
        let combined = (h1 + (j * h2) & 0x7FFFFFFFFFFFFFFF) & 0x7FFFFFFFFFFFFFFF
        let idx = combined % size
        let v = counts[idx]
        if v > 0
            counts[idx] = v - 1
    return state

// Return the minimum counter value across all k probes for item.
// This is the Count-Min-style lower bound on insert count for item.
fn cbf_count_estimate(state: any, item: string) -> int
    let size = state["size"]
    let k = state["k"]
    let counts = state["counts"]
    let h1 = _cbf_h1(item)
    let h2 = _cbf_h2(item)
    let j = 0
    let min_val = -1
    while j < k
        let combined = (h1 + (j * h2) & 0x7FFFFFFFFFFFFFFF) & 0x7FFFFFFFFFFFFFFF
        let idx = combined % size
        let v = counts[idx]
        if min_val < 0
            min_val = v
        if v < min_val
            min_val = v
        j = j + 1
    if min_val < 0
        return 0
    return min_val

// Reset all counters to zero (clear the filter).
fn cbf_clear(state: any) -> any
    let counts = state["counts"]
    let size = state["size"]
    for i in 0..size
        counts[i] = 0
    state["added"] = 0
    return state

// Return the fill ratio: fraction of counters that are > 0.
fn cbf_fill_ratio(state: any) -> float
    let counts = state["counts"]
    let size = state["size"]
    if size == 0
        return 0.0
    let nonzero = 0
    for i in 0..size
        if counts[i] > 0
            nonzero = nonzero + 1
    let ratio = nonzero * 1.0 / size
    return ratio
