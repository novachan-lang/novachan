// std/combinatorics/nextperm.nova — in-place lexicographic successor/predecessor
// for permutations, combinations, and bitmask subsets.
// LEAF — imports NOTHING.
//
// Public API:
//   np_next_permutation(arr)       -> list  next lex permutation; unchanged if last
//   np_prev_permutation(arr)       -> list  previous lex permutation; unchanged if first
//   np_next_combination(combo, n)  -> list  next k-combination of [0..n-1]; unchanged if last
//   np_next_subset_mask(mask, n)   -> int   next subset bitmask (mask+1 clamped to 2^n-1)
//   np_kth_permutation(n, k)       -> list  k-th (0-indexed) permutation of [0..n-1]
//   np_permutation_index(arr)      -> int   0-indexed rank of arr in lex order over [0..n-1]
//   np_has_next_perm(arr)          -> bool  true iff arr is not the last (descending) permutation
//   np_next_multiset_perm(arr)     -> list  next lex permutation allowing duplicate elements

// _np_dup — shallow copy of list xs.
fn _np_dup(xs)
    let out = []
    let i = 0
    let n = len(xs)
    while i < n
        push(out, xs[i])
        i += 1
    out

// _np_fact — factorial (used in kth-permutation and rank).
fn _np_fact(n)
    let r = 1
    let i = 2
    while i <= n
        r = r * i
        i += 1
    r

// _np_is_desc — true if arr is in non-increasing order (last permutation).
fn _np_is_desc(arr)
    let n = len(arr)
    if n <= 1
        return 1
    for i in 0..(n - 1)
        if arr[i] < arr[i + 1]
            return 0
    1

// _np_is_asc — true if arr is in non-decreasing order (first permutation).
fn _np_is_asc(arr)
    let n = len(arr)
    if n <= 1
        return 1
    let i = 0
    while i < n - 1
        if arr[i] > arr[i + 1]
            return 0
        i += 1
    1

// _np_reverse_range — reverse arr[lo..hi] in-place (both inclusive).
fn _np_reverse_range(arr, lo, hi)
    let l = lo
    let h = hi
    while l < h
        let tmp = arr[l]
        arr[l] = arr[h]
        arr[h] = tmp
        l += 1
        h -= 1

// np_next_permutation(arr) -> list
// Returns the next lexicographic permutation of the integer list arr.
// If arr is already the last permutation (descending), returns arr unchanged.
// Algorithm (Narayana Pandita):
//   1. Find largest i such that arr[i] < arr[i+1].
//   2. Find largest j such that arr[j] > arr[i].
//   3. Swap arr[i] and arr[j].
//   4. Reverse the suffix arr[i+1..].
fn np_next_permutation(arr)
    let a = _np_dup(arr)
    let n = len(a)
    if n <= 1
        return a
    // step 1: find pivot
    let i = n - 2
    while i >= 0
        if a[i] < a[i + 1]
            // step 2: find rightmost element greater than a[i]
            let j = n - 1
            while a[j] <= a[i]
                j -= 1
            // step 3: swap
            let tmp = a[i]
            a[i] = a[j]
            a[j] = tmp
            // step 4: reverse suffix
            _np_reverse_range(a, i + 1, n - 1)
            return a
        i -= 1
    // no pivot found -> already last permutation; return unchanged
    a

// np_prev_permutation(arr) -> list
// Returns the previous lexicographic permutation of the integer list arr.
// If arr is already the first permutation (ascending), returns arr unchanged.
// Dual of np_next_permutation: find leftmost descent from right.
fn np_prev_permutation(arr)
    let a = _np_dup(arr)
    let n = len(a)
    if n <= 1
        return a
    // step 1: find rightmost i such that a[i] > a[i+1]
    let i = n - 2
    while i >= 0
        if a[i] > a[i + 1]
            // step 2: find rightmost j such that a[j] < a[i]
            let j = n - 1
            while a[j] >= a[i]
                j -= 1
            // step 3: swap
            let tmp = a[i]
            a[i] = a[j]
            a[j] = tmp
            // step 4: reverse suffix
            _np_reverse_range(a, i + 1, n - 1)
            return a
        i -= 1
    // already first permutation; return unchanged
    a

// np_next_combination(combo, n) -> list
// Given a sorted k-combination of integers from [0..n-1], returns the next
// combination in lexicographic order.  If combo is the last combination
// ([n-k, n-k+1, ..., n-1]), returns combo unchanged.
// Standard algorithm: find rightmost element that can be incremented.
fn np_next_combination(combo, n)
    let k = len(combo)
    if k == 0
        return _np_dup(combo)
    let a = _np_dup(combo)
    // find rightmost index i where a[i] < n - k + i
    let i = k - 1
    while i >= 0
        if a[i] < n - k + i
            // increment a[i] and fill a[i+1..] consecutively
            a[i] = a[i] + 1
            let j = i + 1
            while j < k
                a[j] = a[j - 1] + 1
                j += 1
            return a
        i -= 1
    // last combination; return unchanged
    a

// np_next_subset_mask(mask, n) -> int
// Returns the next subset bitmask: mask+1, clamped to 2^n - 1.
// When mask == 2^n - 1 (full set), returns 2^n - 1 unchanged (last subset).
fn np_next_subset_mask(mask, n)
    let full = (1 << n) - 1
    if mask >= full
        return full
    mask + 1

// _np_build_range — build list [0, 1, ..., n-1].
fn _np_build_range(n)
    let out = []
    let i = 0
    while i < n
        push(out, i)
        i += 1
    out

// np_kth_permutation(n, k) -> list
// Returns the k-th (0-indexed) permutation of [0, 1, ..., n-1] in lex order.
// Uses factorial number system (factoriadic) decomposition.
// np_kth_permutation(3, 0) == [0,1,2], np_kth_permutation(3, 5) == [2,1,0].
fn np_kth_permutation(n, k)
    let elems = _np_build_range(n)
    let result = []
    let rem = k
    let d = n - 1
    while d >= 0
        let f = _np_fact(d)
        let idx = rem / f
        rem -= idx * f
        push(result, elems[idx])
        // remove elems[idx] by rebuilding elems without that element
        let new_elems = []
        let j = 0
        while j < len(elems)
            if j != idx
                push(new_elems, elems[j])
            j += 1
        elems = new_elems
        d -= 1
    result

// np_permutation_index(arr) -> int
// Returns the 0-indexed rank of arr in the lexicographic ordering of all
// permutations of [0..n-1] where n = len(arr).
// Uses factoriadic: for each position i, count how many unused elements
// are less than arr[i], multiply by (n-1-i)!, accumulate.
fn np_permutation_index(arr)
    let n = len(arr)
    if n == 0
        return 0
    // build set of "remaining" elements as a sorted list
    let remaining = _np_dup(arr)
    // sort remaining ascending using insertion sort
    for si in 1..n
        let key = remaining[si]
        let ins = si
        let sj = si - 1
        let done = false
        while sj >= 0 and done == false
            if remaining[sj] > key
                remaining[sj + 1] = remaining[sj]
                ins = sj
                sj -= 1
            else
                done = true
        remaining[ins] = key
    // now remaining = sorted [0..n-1]; compute rank
    let rank = 0
    let used = [0 for ii in 0..n]
    for pos in 0..n
        let v = arr[pos]
        // count how many elements < v are not yet used
        let cnt = 0
        let qi = 0
        while qi < n
            if used[qi] == 0 and remaining[qi] < v
                cnt += 1
            qi += 1
        rank += cnt * _np_fact(n - 1 - pos)
        // mark v as used (find its position in sorted remaining)
        let ri = 0
        while ri < n
            if remaining[ri] == v and used[ri] == 0
                used[ri] = 1
                ri = n
            ri += 1
    rank

// np_has_next_perm(arr) -> bool (returned as int 1/0)
// Returns 1 if arr is NOT the last permutation in lex order, 0 if it is.
// Equivalently: returns 0 iff arr is non-increasing (descending).
fn np_has_next_perm(arr)
    let n = len(arr)
    if n <= 1
        return 0
    let i = n - 2
    while i >= 0
        if arr[i] < arr[i + 1]
            return 1
        i -= 1
    0

// np_next_multiset_perm(arr) -> list
// Returns the next lexicographic permutation of arr where elements may repeat.
// Uses the same Narayana Pandita algorithm as np_next_permutation; comparison
// is value-based so duplicates are handled correctly.
// If arr is the last permutation (elements non-increasing), returns arr unchanged.
fn np_next_multiset_perm(arr)
    let a = _np_dup(arr)
    let n = len(a)
    if n <= 1
        return a
    // find rightmost i where a[i] < a[i+1]
    let i = n - 2
    while i >= 0
        if a[i] < a[i + 1]
            // find rightmost j where a[j] > a[i]
            let j = n - 1
            while a[j] <= a[i]
                j -= 1
            let tmp = a[i]
            a[i] = a[j]
            a[j] = tmp
            _np_reverse_range(a, i + 1, n - 1)
            return a
        i -= 1
    // last permutation; return unchanged
    a
