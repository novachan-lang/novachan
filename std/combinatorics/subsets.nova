// std/combinatorics/subsets.nova — subsets, k-subsets, rank/unrank operations.
// LEAF — imports NOTHING. Elements may be any NOVA value (ints used in KAT).
//
// Public API:
//   sub_all(items)           -> list  all 2^n subsets (bitmask order: [], [a], [b], [a,b], ...)
//   sub_count(n)             -> int   2^n
//   sub_k(items, k)          -> list  all k-element subsets in lexicographic index order
//   sub_k_count(n, k)        -> int   C(n, k) — binomial coefficient
//   sub_rank(subset, n)      -> int   bitmask-based rank of a subset given the universe size n
//   sub_unrank(mask, items)  -> list  subset corresponding to bitmask mask over items
//   sub_nonempty(items)      -> list  all non-empty subsets (2^n - 1 results)
//   sub_complement(sub, items) -> list elements of items not in sub
//   sub_contains(sub, x)    -> bool  true if x appears in sub

// _sub_dup — shallow copy of a list to avoid aliasing
fn _sub_dup(src)
    let dst = []
    let i = 0
    let n = len(src)
    while i < n
        push(dst, src[i])
        i += 1
    dst

// _sub_pow2 — 2^n via iterative doubling (avoids shift issues for large n)
fn _sub_pow2(n: int) -> int
    let v = 1
    for i in 0..n
        v = v * 2
    v

// _sub_nCr — C(n, k) using the multiplicative formula. Returns 0 if k > n or k < 0.
fn _sub_nCr(n: int, k: int) -> int
    if k < 0
        return 0
    if k > n
        return 0
    let r = k
    if n - k < r
        r = n - k
    let result = 1
    let i = 0
    while i < r
        result = result * (n - i)
        result = result / (i + 1)
        i += 1
    result

// sub_count — 2^n (total number of subsets of an n-element set).
fn sub_count(n: int) -> int
    _sub_pow2(n)

// sub_k_count — C(n, k): number of k-element subsets of an n-element set.
fn sub_k_count(n: int, k: int) -> int
    _sub_nCr(n, k)

// sub_all — all 2^n subsets of items, listed in bitmask order.
// Mask 0 = [], mask 1 = [items[0]], mask 2 = [items[1]], mask 3 = [items[0],items[1]], ...
// For n elements, returns exactly 2^n subsets.
fn sub_all(items) -> any
    let n = len(items)
    let total = _sub_pow2(n)
    let result = []
    let mask = 0
    while mask < total
        let sub = []
        let j = 0
        while j < n
            let bit = (mask >> j) & 1
            if bit == 1
                push(sub, items[j])
            j += 1
        push(result, sub)
        mask += 1
    result

// _sub_k_gen — recursive backtracking to collect all k-element subsets.
// Uses a pre-allocated slot array of size k; slot[0..depth-1] are live.
// At each level, writes items[i] into slot[depth] then recurses.
fn _sub_k_gen(result, items, k, depth, slot, start)
    let n = len(items)
    if depth == k
        let snap = [slot[m] for m in 0..k]
        push(result, snap)
        return null
    let need = k - depth
    let i = start
    while i <= n - need
        slot[depth] = items[i]
        _sub_k_gen(result, items, k, depth + 1, slot, i + 1)
        i += 1

// sub_k — all k-element subsets of items in lexicographic index order.
// sub_k(items, 0) = [[]] (one empty subset).
// sub_k(items, k) = [] if k > len(items).
fn sub_k(items, k: int) -> any
    let result = []
    let n = len(items)
    if k < 0
        return result
    if k > n
        return result
    if k == 0
        push(result, [])
        return result
    // Pre-allocate slot array of size k
    let slot = [0 for si in 0..k]
    _sub_k_gen(result, items, k, 0, slot, 0)
    result

// sub_rank — bitmask rank of a subset of a universe of size n.
// The subset is identified by which 0-indexed positions (within a size-n universe)
// are occupied. This function takes the actual element values and assumes items are
// 0-indexed integers in 0..n-1.
// For general use: pass the index positions rather than values.
// Here we compute the bitmask by checking which positions contain the element.
// sub_rank([1,2], 3) means: which mask over a 3-element set {0,1,2} gives [1,2]?
// We treat the subset values directly as bit positions.
fn sub_rank(subset, n: int) -> int
    let mask = 0
    for i in 0..len(subset)
        let bit = subset[i]
        if bit >= 0 and bit < n
            mask += _sub_pow2(bit)
    mask

// sub_unrank — subset corresponding to bitmask mask over items list.
// Bit j set means items[j] is included.
fn sub_unrank(mask: int, items) -> any
    let n = len(items)
    let sub = []
    for j in 0..n
        let bit = (mask >> j) & 1
        if bit == 1
            push(sub, items[j])
    sub

// sub_nonempty — all non-empty subsets of items (2^n - 1 results).
fn sub_nonempty(items) -> any
    let n = len(items)
    let total = _sub_pow2(n)
    let result = []
    for mask in 1..total
        let sub = []
        let j = 0
        while j < n
            let bit = (mask >> j) & 1
            if bit == 1
                push(sub, items[j])
            j += 1
        push(result, sub)
    result

// sub_complement — elements of items NOT present in sub.
// Uses linear search (O(n*k)). Suitable for small sets as used in KAT.
fn sub_complement(sub, items) -> any
    let result = []
    for i in 0..len(items)
        let x = items[i]
        let found = false
        let j = 0
        while j < len(sub)
            if sub[j] == x
                found = true
                j = len(sub)
            else
                j += 1
        if not found
            push(result, x)
    result

// sub_contains — true if x appears in sub (linear search).
fn sub_contains(sub, x) -> bool
    for i in 0..len(sub)
        if sub[i] == x
            return true
    false
