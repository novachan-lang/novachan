// std/combinatorics/cartesian.nova — Cartesian product of lists.
// LEAF — imports NOTHING.
//
// Public API:
//   cart_count(lists)        -> int   product of the lengths (0-factor => 0; empty lists-of-lists => 1)
//   cart_power_count(n, k)   -> int   n^k
//   cart_nth(lists, idx)     -> any   idx-th tuple in mixed-radix (row-major) order
//   cart_index(tuple, lists) -> int   inverse of cart_nth
//   cart_pair(a, b)          -> any   Cartesian product of two lists
//   cart_power(items, k)     -> any   k-fold Cartesian power of a single list
//   cart_product(lists)      -> any   Cartesian product of any number of lists

// _cart_dup — deep-copy a list.
fn _cart_dup(a) -> any
    let out = []
    let i = 0
    let n = len(a)
    while i < n
        push(out, a[i])
        i = i + 1
    return out

// cart_count — product of the lengths of each constituent list.
// Empty list-of-lists => 1 (empty product). Any constituent with 0 elements => 0.
fn cart_count(lists) -> int
    let nl = len(lists)
    if nl == 0
        return 1
    let prod = 1
    let i = 0
    while i < nl
        prod = prod * len(lists[i])
        i = i + 1
    return prod

// cart_power_count — n^k.
fn cart_power_count(n: int, k: int) -> int
    if k == 0
        return 1
    let result = 1
    let i = 0
    while i < k
        result = result * n
        i = i + 1
    return result

// cart_nth — decode idx into a tuple via mixed-radix (right-to-left) decomposition.
// The rightmost dimension cycles fastest (row-major order, standard lex order).
// Returns [] if lists is empty or idx out of range.
fn cart_nth(lists, idx: int) -> any
    let nl = len(lists)
    if nl == 0
        return []
    let total = cart_count(lists)
    if idx < 0
        return []
    if idx >= total
        return []
    // Build tuple right-to-left
    let tuple = []
    let i = 0
    while i < nl
        push(tuple, 0)
        i = i + 1
    let rem = idx
    let d = nl - 1
    while d >= 0
        let sz = len(lists[d])
        let digit = rem % sz
        tuple[d] = lists[d][digit]
        rem = rem / sz
        d = d - 1
    return tuple

// cart_index — encode tuple back to its 0-based index.
// Inverse of cart_nth; returns -1 if tuple length != lists length.
fn cart_index(tuple, lists) -> int
    let nl = len(lists)
    if len(tuple) != nl
        return -1
    let idx = 0
    let i = 0
    while i < nl
        let sz = len(lists[i])
        let v = tuple[i]
        // find position of v in lists[i]
        let pos = -1
        let j = 0
        while j < sz
            if lists[i][j] == v
                if pos == -1
                    pos = j
            j = j + 1
        if pos == -1
            return -1
        idx = idx * sz + pos
        i = i + 1
    return idx

// _cart_product_two — product of exactly two lists.
fn _cart_product_two(a, b) -> any
    let out = []
    let na = len(a)
    let nb = len(b)
    let i = 0
    while i < na
        let j = 0
        while j < nb
            let pair = [a[i], b[j]]
            push(out, pair)
            j = j + 1
        i = i + 1
    return out

// cart_pair — Cartesian product of two lists; each result is a 2-element list.
fn cart_pair(a, b) -> any
    return _cart_product_two(a, b)

// _cart_extend — extend each existing tuple in `acc` with element `v`.
fn _cart_extend(acc, v) -> any
    let out = []
    let n = len(acc)
    let i = 0
    while i < n
        let t = _cart_dup(acc[i])
        push(t, v)
        push(out, t)
        i = i + 1
    return out

// _cart_cross — cross `acc` (list of partial tuples) with next_list.
fn _cart_cross(acc, next_list) -> any
    let out = []
    let na = len(acc)
    let nb = len(next_list)
    let i = 0
    while i < na
        let j = 0
        while j < nb
            let t = _cart_dup(acc[i])
            push(t, next_list[j])
            push(out, t)
            j = j + 1
        i = i + 1
    return out

// cart_product — Cartesian product of a list of lists.
// Tuples are in lexicographic order (leftmost dimension cycles slowest).
fn cart_product(lists) -> any
    let nl = len(lists)
    if nl == 0
        // empty product = one empty tuple
        let out = []
        push(out, [])
        return out
    // Start with single-element tuples from first list
    let acc = []
    let n0 = len(lists[0])
    let k = 0
    while k < n0
        let t = [lists[0][k]]
        push(acc, t)
        k = k + 1
    // Cross with each subsequent list
    let d = 1
    while d < nl
        acc = _cart_cross(acc, lists[d])
        d = d + 1
    return acc

// cart_power — k-fold Cartesian power of items (all k-tuples with elements from items).
fn cart_power(items, k: int) -> any
    if k == 0
        let out = []
        push(out, [])
        return out
    if k < 0
        return []
    // Build list of k copies of items
    let lists = []
    let i = 0
    while i < k
        push(lists, _cart_dup(items))
        i = i + 1
    return cart_product(lists)
