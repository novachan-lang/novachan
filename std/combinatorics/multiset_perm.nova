// std/combinatorics/multiset_perm.nova — permutations of a multiset (with repetitions).
// LEAF — imports NOTHING.
//
// Public API:
//   mp_factorial(n)            -> int   n!
//   mp_multinomial(counts)     -> int   total! / product(count_i!)
//   mp_count(counts)           -> int   alias for mp_multinomial
//   mp_distinct_count(items)   -> int   count distinct permutations of items
//   mp_all(items)              -> any   all distinct permutations, lexicographic
//   mp_next(perm)              -> any   next distinct permutation (or [] if last)

// mp_factorial — n! iterative; mp_factorial(0)=1.
fn mp_factorial(n: int) -> int
    let acc = 1
    let i = 2
    while i <= n
        acc = acc * i
        i = i + 1
    return acc

// mp_multinomial — multinomial coefficient: (sum of counts)! / product(count_i!).
// counts is a list of repetition counts.
fn mp_multinomial(counts: any) -> int
    let total = 0
    let i = 0
    let nc = len(counts)
    while i < nc
        total = total + counts[i]
        i = i + 1
    let num = mp_factorial(total)
    let den = 1
    let j = 0
    while j < nc
        den = den * mp_factorial(counts[j])
        j = j + 1
    return num / den

// mp_count — alias for mp_multinomial.
fn mp_count(counts: any) -> int
    return mp_multinomial(counts)

// _mp_dup — deep-copy a list.
fn _mp_dup(a) -> any
    let out = []
    let i = 0
    let n = len(a)
    while i < n
        push(out, a[i])
        i = i + 1
    return out

// _mp_sort — sort a list via bubble sort, returns sorted copy.
fn _mp_sort(a) -> any
    let b = _mp_dup(a)
    let n = len(b)
    let i = 0
    while i < n - 1
        let j = 0
        while j < n - i - 1
            if b[j] > b[j + 1]
                let tmp = b[j]
                b[j] = b[j + 1]
                b[j + 1] = tmp
            j = j + 1
        i = i + 1
    return b

// _mp_freq — given sorted items, build frequency list [count, count, ...] for each distinct value run.
fn _mp_freq(sorted) -> any
    let n = len(sorted)
    let counts = []
    let i = 0
    while i < n
        let v = sorted[i]
        let c = 0
        let j = i
        while j < n
            if sorted[j] == v
                c = c + 1
                j = j + 1
            else
                j = n
        push(counts, c)
        i = i + c
    return counts

// mp_distinct_count — count distinct permutations of items = total! / product(freq_i!).
fn mp_distinct_count(items) -> int
    let n = len(items)
    if n == 0
        return 1
    let sorted = _mp_sort(items)
    let counts = _mp_freq(sorted)
    return mp_multinomial(counts)

// _mp_gen — recursive generator for distinct permutations.
// items = sorted source list, cur = current partial perm (pre-allocated),
// used = used-flags list, pos = current fill position, out = result accumulator.
// Skips duplicate siblings: if items[i] == last_used at this level, skip.
fn _mp_gen(items, cur, used, pos: int, out)
    let n = len(items)
    if pos == n
        push(out, _mp_dup(cur))
        return
    let last_used = -2147483648
    let i = 0
    while i < n
        if used[i] == 0
            if items[i] != last_used
                last_used = items[i]
                used[i] = 1
                cur[pos] = items[i]
                _mp_gen(items, cur, used, pos + 1, out)
                used[i] = 0
        i = i + 1

// mp_all — all distinct permutations of items in lexicographic order.
fn mp_all(items) -> any
    let n = len(items)
    let out = []
    if n == 0
        push(out, [])
        return out
    let sorted = _mp_sort(items)
    let used = []
    let cur = []
    let i = 0
    while i < n
        push(used, 0)
        push(cur, 0)
        i = i + 1
    _mp_gen(sorted, cur, used, 0, out)
    return out

// mp_next — next distinct permutation after perm in lexicographic order.
// Returns empty list if perm is the last (descending) permutation.
// Algorithm: Narayana Pandita.
fn mp_next(perm) -> any
    let p = _mp_dup(perm)
    let n = len(p)
    if n <= 1
        return []
    // Step 1: find largest i such that p[i] < p[i+1]
    let pivot = -1
    let i = n - 2
    while i >= 0
        if p[i] < p[i + 1]
            if pivot == -1
                pivot = i
        i = i - 1
    // Find the LAST (rightmost) such i by scanning right to left and taking first found
    // Actually Narayana needs LARGEST i (rightmost), so re-scan correctly:
    pivot = -1
    let ii = n - 2
    while ii >= 0
        if p[ii] < p[ii + 1]
            pivot = ii
            ii = -1
        else
            ii = ii - 1
    if pivot == -1
        return []
    // Step 2: find largest j such that p[pivot] < p[j]
    let j = n - 1
    while p[j] <= p[pivot]
        j = j - 1
    // Step 3: swap p[pivot] and p[j]
    let tmp = p[pivot]
    p[pivot] = p[j]
    p[j] = tmp
    // Step 4: reverse suffix p[pivot+1..]
    let lo = pivot + 1
    let hi = n - 1
    while lo < hi
        let tmp2 = p[lo]
        p[lo] = p[hi]
        p[hi] = tmp2
        lo = lo + 1
        hi = hi - 1
    return p
