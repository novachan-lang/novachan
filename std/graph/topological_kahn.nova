// std/graph/topological_kahn.nova — Kahn's topological sort for directed graphs.
//
// Graph representation: adj is a list of lists; adj[i] is the list of integer
// neighbor ids of node i.  n is the number of nodes (0..n-1).
//
// Public API:
//   tk_order(adj, n)           -> list  topological order (smallest-id tie-breaking); [] if cycle
//   tk_is_dag(adj, n)          -> bool  true iff the graph is acyclic
//   tk_count_orderings(adj, n) -> int   number of valid topological orderings (0 if cycle)
//
// Algorithm: Kahn's BFS-based algorithm; ties broken by smallest node id.
// tk_count_orderings uses recursive backtracking with the Kahn invariant.
// Module-private prefix: _tk_

// _tk_build_indegree: compute in-degree of each node; returns list of length n.
fn _tk_build_indegree(adj, n)
    let indeg = []
    for i in 0..n
        indeg.push(0)
    for u in 0..n
        let nbrs = adj[u]
        let k = 0
        while k < len(nbrs)
            let v = nbrs[k]
            indeg[v] += 1
            k += 1
    return indeg

// _tk_min_ready: find the smallest node id with indegree 0 in indeg (among 0..n-1).
// Returns -1 if none found.
fn _tk_min_ready(indeg, n)
    for i in 0..n
        if indeg[i] == 0
            return i
    return -1

// _tk_collect_ready: collect all node ids with indegree 0 into a sorted list.
fn _tk_collect_ready(indeg, n)
    let ready = []
    for i in 0..n
        if indeg[i] == 0
            ready.push(i)
    return ready

// _tk_kahn_core: run Kahn's algorithm picking smallest-id node each step.
// Returns the topological order; length < n means there is a cycle.
fn _tk_kahn_core(adj, n)
    let indeg = _tk_build_indegree(adj, n)
    let order = []
    let processed = 0
    while processed < n
        // find smallest zero-indegree node
        let u = _tk_min_ready(indeg, n)
        if u == -1
            return order
        // "remove" u by setting indeg to -1 (sentinel meaning processed)
        indeg[u] = -1
        order.push(u)
        processed += 1
        // decrement neighbors
        let nbrs = adj[u]
        for k in 0..len(nbrs)
            let v = nbrs[k]
            indeg[v] -= 1
    return order

// _tk_count_rec: count topological orderings by backtracking.
// indeg: mutable in-degree array; done: number of nodes already placed.
fn _tk_count_rec(adj, n, indeg, done)
    if done == n
        return 1
    // collect all zero-indegree nodes that haven't been processed (indeg == 0)
    let ready = _tk_collect_ready(indeg, n)
    if len(ready) == 0
        return 0
    let total = 0
    for i in 0..len(ready)
        let u = ready[i]
        // "choose" u: mark as processed (indeg=-1), decrement neighbors
        indeg[u] = -1
        let nbrs = adj[u]
        let k = 0
        while k < len(nbrs)
            let v = nbrs[k]
            indeg[v] -= 1
            k += 1
        // recurse
        total += _tk_count_rec(adj, n, indeg, done + 1)
        // undo: restore neighbors' indegree, restore u
        let k2 = 0
        while k2 < len(nbrs)
            let v = nbrs[k2]
            indeg[v] += 1
            k2 += 1
        indeg[u] = 0
    return total

// tk_order: returns a valid topological ordering using Kahn's algorithm,
// breaking ties by smallest node id first. Returns [] if the graph has a cycle.
fn tk_order(adj, n)
    if n == 0
        return []
    let order = _tk_kahn_core(adj, n)
    if len(order) < n
        return []
    return order

// tk_is_dag: returns true iff the directed graph is acyclic.
fn tk_is_dag(adj, n)
    if n == 0
        return true
    let order = _tk_kahn_core(adj, n)
    if len(order) == n
        return true
    return false

// tk_count_orderings: returns the number of valid topological orderings.
// Returns 0 if the graph has a cycle.
fn tk_count_orderings(adj, n)
    if n == 0
        return 1
    // first check if it's a DAG via Kahn (uses its own internal indeg copy)
    let order = _tk_kahn_core(adj, n)
    if len(order) < n
        return 0
    // count via backtracking on a fresh indeg
    let indeg = _tk_build_indegree(adj, n)
    return _tk_count_rec(adj, n, indeg, 0)
