// std/graph/transitive_closure.nova — Transitive closure for directed graphs.
//
// Graph representation: adj is a list of lists; adj[i] is the list of integer
// neighbor ids of node i.  n is the number of nodes (0..n-1).
//
// Public API:
//   tc_is_reachable(adj, n, u, v)   -> bool  true iff v is reachable from u (u != v)
//   tc_count_reachable(adj, n, u)   -> int   count of nodes reachable from u (not u)
//   tc_closure_matrix(adj, n)       -> list  n×n 0/1 matrix; cell [i][j]=1 iff j reachable from i (i != j)
//
// Algorithm: BFS from each source node; O(n*(n+e)) time.
// Module-private prefix: _tc_

// _tc_bfs_reach: BFS from src; return list of length n where result[v]=1 iff v reachable from src (not counting src itself).
fn _tc_bfs_reach(adj, n, src)
    let reach = []
    let i = 0
    while i < n
        reach.push(0)
        i = i + 1
    if n == 0
        return reach
    let visited = []
    let j = 0
    while j < n
        visited.push(0)
        j = j + 1
    // BFS queue via list with head pointer
    let queue = []
    let head = 0
    queue.push(src)
    visited[src] = 1
    while head < len(queue)
        let u = queue[head]
        head = head + 1
        let nbrs = adj[u]
        let k = 0
        while k < len(nbrs)
            let v = nbrs[k]
            if visited[v] == 0
                visited[v] = 1
                queue.push(v)
            k = k + 1
    // mark reachable: all visited except src itself
    let m = 0
    while m < n
        if visited[m] == 1 and m != src
            reach[m] = 1
        m = m + 1
    return reach

// tc_is_reachable: returns true iff v is reachable from u via directed edges (u != v).
fn tc_is_reachable(adj, n, u, v)
    if n == 0
        return false
    let reach = _tc_bfs_reach(adj, n, u)
    if reach[v] == 1
        return true
    return false

// tc_count_reachable: returns the number of nodes reachable from u (not counting u itself).
fn tc_count_reachable(adj, n, u)
    if n == 0
        return 0
    let reach = _tc_bfs_reach(adj, n, u)
    let count = 0
    let i = 0
    while i < n
        if reach[i] == 1
            count = count + 1
        i = i + 1
    return count

// tc_closure_matrix: returns n×n 0/1 reachability matrix; cell [i][j]=1 iff j reachable from i (i != j).
fn tc_closure_matrix(adj, n)
    let mat = []
    let i = 0
    while i < n
        let row = _tc_bfs_reach(adj, n, i)
        mat.push(row)
        i = i + 1
    return mat
