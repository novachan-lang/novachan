// std/graph/maxflow.nova — Maximum flow via Edmonds-Karp (BFS-augmenting Ford-Fulkerson).
//
// Graph representation: cap = dict mapping node-name string -> list of edges,
// where each edge is a 2-element list [neighborNameString, capacityInt].
// A separate `nodes` list gives ALL node names (needed for isolated nodes).
//
// Public API:
//   mf_max_flow(cap, nodes, source, sink) -> int   (total max-flow value)
//
// Algorithm: Edmonds-Karp is Ford-Fulkerson with BFS used to find the shortest
// (fewest-hops) augmenting path each iteration. This guarantees O(V * E^2) time
// regardless of capacity values, avoiding the pseudopolynomial behaviour of
// naive DFS-Ford-Fulkerson on large integer capacities.
//
// Internal residual graph: for every original edge (u,v,c) we track
//   res[u][v] += c   (forward residual)
//   res[v][u] += 0   (backward residual — slot created for reverse flow)
// After augmenting f units along (u,v): res[u][v] -= f; res[v][u] += f.
//
// Private helpers are prefixed _mf_ to avoid name collisions.

// _mf_res_get(res, u, v) -> int: return residual capacity on edge (u,v), 0 if absent.
fn _mf_res_get(res, u, v) -> int
    if not contains(res, u)
        return 0
    let row = res[u]
    if not contains(row, v)
        return 0
    return row[v]

// _mf_res_add(res, u, v, delta): add delta to residual capacity res[u][v],
// creating the nested dict entry if needed.
fn _mf_res_add(res, u, v, delta)
    if not contains(res, u)
        res[u] = {}
    let row = res[u]
    let old = 0
    if contains(row, v)
        old = row[v]
    row[v] = old + delta
    res[u] = row

// _mf_build_residual(cap, nodes) -> dict-of-dicts residual graph.
// Initialises res[u][v] = capacity for every edge, and ensures the reverse
// slot res[v][u] exists (adding 0 if no reverse edge already present).
fn _mf_build_residual(cap, nodes) -> dict
    let res = {}
    // Ensure every node has a row so BFS can iterate over all neighbours.
    for ni in 0..len(nodes)
        let nd = nodes[ni]
        if not contains(res, nd)
            res[nd] = {}
    // Add forward capacities and ensure reverse slots.
    for i in 0..len(nodes)
        let u = nodes[i]
        if contains(cap, u)
            let edges = cap[u]
            let j = 0
            while j < len(edges)
                let edge = edges[j]
                let v = edge[0]
                let c = edge[1]
                // forward: res[u][v] += c
                _mf_res_add(res, u, v, c)
                // ensure reverse slot exists (adds 0 if absent)
                if not contains(res, v)
                    res[v] = {}
                let vrow = res[v]
                if not contains(vrow, u)
                    vrow[u] = 0
                    res[v] = vrow
                j = j + 1
    return res

// _mf_bfs(res, nodes, source, sink) -> dict: parent map node->node for the
// shortest augmenting path from source to sink in the RESIDUAL graph.
// Returns an empty dict if no augmenting path exists (sink unreachable).
// Uses a list+head-index as a FIFO queue (no pop_front needed).
fn _mf_bfs(res, nodes, source, sink) -> dict
    let parent = {}
    let visited = {}
    visited[source] = 1
    // queue: list of node names; qi = head index.
    let queue = []
    push(queue, source)
    let qi = 0
    let found = 0
    while qi < len(queue)
        let u = queue[qi]
        qi = qi + 1
        if u == sink
            found = 1
            qi = len(queue)
        if found == 0
            // iterate over residual neighbours of u
            if contains(res, u)
                let row = res[u]
                let nbrs = keys(row)
                for ki in 0..len(nbrs)
                    let v = nbrs[ki]
                    let vis_v = 0
                    if contains(visited, v)
                        vis_v = visited[v]
                    let rc = 0
                    if contains(row, v)
                        rc = row[v]
                    if vis_v == 0 and rc > 0
                        visited[v] = 1
                        parent[v] = u
                        push(queue, v)
    if not contains(parent, sink)
        if sink != source
            let empty = {}
            return empty
    return parent

// _mf_path_flow(res, parent, source, sink) -> int: find the bottleneck capacity
// along the path from source to sink encoded by parent[].
fn _mf_path_flow(res, parent, source, sink) -> int
    let flow = 1000000000
    let cur = sink
    let safety = 0
    while cur != source and safety < 100000
        let prev = parent[cur]
        let rc = _mf_res_get(res, prev, cur)
        if rc < flow
            flow = rc
        cur = prev
        safety = safety + 1
    return flow

// _mf_augment(res, parent, source, sink, flow): update the residual graph by
// pushing `flow` units along the path encoded by parent[].
fn _mf_augment(res, parent, source, sink, flow)
    let cur = sink
    let safety = 0
    while cur != source and safety < 100000
        let prev = parent[cur]
        _mf_res_add(res, prev, cur, 0 - flow)
        _mf_res_add(res, cur, prev, flow)
        cur = prev
        safety = safety + 1

// mf_max_flow(cap, nodes, source, sink) -> int: compute maximum flow from
// source to sink using Edmonds-Karp (BFS-augmenting Ford-Fulkerson).
// Returns 0 if source == sink or no augmenting path exists.
fn mf_max_flow(cap, nodes, source, sink) -> int
    if source == sink
        return 0
    let res = _mf_build_residual(cap, nodes)
    let total = 0
    let running = 1
    while running == 1
        let parent = _mf_bfs(res, nodes, source, sink)
        if not contains(parent, sink)
            running = 0
        if running == 1
            let f = _mf_path_flow(res, parent, source, sink)
            if f <= 0
                running = 0
            if f > 0
                _mf_augment(res, parent, source, sink, f)
                total = total + f
    return total
