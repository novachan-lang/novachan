// ============================================================================
// NOVA Standard Library — std/graph/prim
// ============================================================================
// Prim's minimum spanning tree for undirected weighted graphs.
//
// Graph representation: adj = dict mapping node string -> list of edges,
// where each edge is a 2-element list [neighborString, weightInt].
// Both directions must be present for undirected edges (symmetric adjacency).
//
// PUBLIC API (pr_ prefix):
//   pr_mst_weight(adj, start) -> int   total MST weight of component containing start
//   pr_mst(adj, start)        -> list  chosen edges as [u, v, w] lists
//
// Complexity: O(V^2) time, O(V) space (simple linear-scan Prim, no binary heap).
// ============================================================================

let _PR_INF = 1000000000

// _pr_collect_nodes: return a list of all node keys in adj.
fn _pr_collect_nodes(adj)
    let nodes = []
    let ks = keys(adj)
    for i in 0..len(ks)
        let k = ks[i]
        nodes.push(k)
    return nodes

// _pr_min_node: among unvisited nodes, find the one with minimum key value.
// Returns "" if none found (all visited or no reachable unvisited node with key < INF).
fn _pr_min_node(node_list, key_map, visited_map)
    let best = ""
    let best_k = _PR_INF + 1
    for i in 0..len(node_list)
        let nd = node_list[i]
        let is_vis = 0
        if nd in visited_map
            is_vis = visited_map[nd]
        if is_vis == 0
            let nk = _PR_INF
            if nd in key_map
                nk = key_map[nd]
            if nk < best_k
                best_k = nk
                best = nd
    return best

// pr_mst_weight: returns the total weight of the MST for the connected component
// that contains 'start'. Returns 0 for a graph with a single node or empty adj.
fn pr_mst_weight(adj, start)
    if start not in adj
        return 0
    let node_list = _pr_collect_nodes(adj)
    let n = len(node_list)
    if n == 0
        return 0

    // key_map: minimum edge weight to connect each node to the growing MST
    let key_map = {}
    let visited_map = {}
    // Initialize all keys to INF; start node key = 0
    for i in 0..n
        let nd = node_list[i]
        key_map[nd] = _PR_INF
    key_map[start] = 0

    let total = 0
    // Repeat V times: pick the unvisited node with minimum key, add to MST
    let step = 0
    while step < n
        let u = _pr_min_node(node_list, key_map, visited_map)
        if u == ""
            step = n
        else
            let uk = key_map[u]
            if uk >= _PR_INF
                step = n
            else
                visited_map[u] = 1
                total += uk
                // Relax neighbors
                if u in adj
                    let edges = adj[u]
                    for j in 0..len(edges)
                        let edge = edges[j]
                        let v = edge[0]
                        let w = edge[1]
                        let v_vis = 0
                        if v in visited_map
                            v_vis = visited_map[v]
                        if v_vis == 0
                            let vk = _PR_INF
                            if v in key_map
                                vk = key_map[v]
                            if w < vk
                                key_map[v] = w
                step += 1
    return total

// pr_mst: returns the list of MST edges as [u, v, w] lists.
// Only edges within the connected component containing 'start' are returned.
// For a single isolated node the list is empty.
fn pr_mst(adj, start)
    if start not in adj
        return []
    let node_list = _pr_collect_nodes(adj)
    let n = len(node_list)
    if n == 0
        return []

    let key_map = {}
    let parent_map = {}
    let parent_w_map = {}
    let visited_map = {}
    for i in 0..n
        let nd = node_list[i]
        key_map[nd] = _PR_INF
        parent_map[nd] = ""
        parent_w_map[nd] = 0
    key_map[start] = 0

    let result = []
    let step = 0
    while step < n
        let u = _pr_min_node(node_list, key_map, visited_map)
        if u == ""
            step = n
        else
            let uk = key_map[u]
            if uk >= _PR_INF
                step = n
            else
                visited_map[u] = 1
                // Record the edge that brought u into the MST (skip start node: key=0, parent="")
                let par = parent_map[u]
                if par != ""
                    let ew = parent_w_map[u]
                    let mst_edge = [par, u, ew]
                    result.push(mst_edge)
                // Relax neighbors
                if u in adj
                    let edges = adj[u]
                    for j in 0..len(edges)
                        let edge = edges[j]
                        let v = edge[0]
                        let w = edge[1]
                        let v_vis = 0
                        if v in visited_map
                            v_vis = visited_map[v]
                        if v_vis == 0
                            let vk = _PR_INF
                            if v in key_map
                                vk = key_map[v]
                            if w < vk
                                key_map[v] = w
                                parent_map[v] = u
                                parent_w_map[v] = w
                step += 1
    return result
