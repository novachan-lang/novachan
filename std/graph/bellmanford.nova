// bellmanford -- Bellman-Ford shortest paths over a WEIGHTED directed graph.
//
// Unlike Dijkstra, Bellman-Ford handles NEGATIVE edge weights and DETECTS
// negative-weight cycles that would otherwise make "shortest path" undefined.
//
// Graph representation: adj = dict mapping node-name string -> list of edges,
// where each edge is a 2-element list [neighborNameString, weightInt].
// A separate `nodes` list gives ALL node names (needed for isolated nodes).
//
// Algorithm: relax every edge |V|-1 times (guarantees shortest-path distances
// if no negative cycle is reachable from source). A final relaxation pass that
// still finds an improvement proves a negative cycle exists.
//
// Time complexity: O(V * E). Space: O(V).
//
// Public API:
//   bf_shortest(adj, nodes, source) -> dict  node -> int distance (INF if unreachable)
//   bf_distance(adj, nodes, source, target) -> int  (-1 if unreachable)
//   bf_has_negative_cycle(adj, nodes, source) -> bool

// _bf_inf() -- sentinel for "unreachable / infinity"
fn _bf_inf() -> int
    return 1000000000

// _bf_init_dist(nodes, source) -> dict mapping every node to INF except source=0.
fn _bf_init_dist(nodes, source)
    let dist = {}
    for i in 0..len(nodes)
        let nd = nodes[i]
        dist[nd] = _bf_inf()
    dist[source] = 0
    return dist

// _bf_relax_once(adj, nodes, dist) -- perform one full edge-relaxation pass.
// Returns 1 if any distance improved, 0 otherwise.
fn _bf_relax_once(adj, nodes, dist)
    let improved = 0
    for i in 0..len(nodes)
        let u = nodes[i]
        if contains(dist, u)
            let du = dist[u]
            if du < _bf_inf()
                if contains(adj, u)
                    let edges = adj[u]
                    let j = 0
                    while j < len(edges)
                        let edge = edges[j]
                        let v = edge[0]
                        let w = edge[1]
                        let alt = du + w
                        if contains(dist, v)
                            if alt < dist[v]
                                dist[v] = alt
                                improved = 1
                        j = j + 1
    return improved

// bf_shortest(adj, nodes, source) -> dict node->int.
// Runs |nodes|-1 relaxation passes. Returns distance dict (INF = unreachable).
// Does NOT detect negative cycles -- call bf_has_negative_cycle separately.
fn bf_shortest(adj, nodes, source)
    let dist = _bf_init_dist(nodes, source)
    let n = len(nodes)
    for pass in 0..(n - 1)
        _bf_relax_once(adj, nodes, dist)
    return dist

// bf_distance(adj, nodes, source, target) -> int distance, or -1 if unreachable.
fn bf_distance(adj, nodes, source, target)
    let dist = bf_shortest(adj, nodes, source)
    if contains(dist, target) == false
        return -1
    let d = dist[target]
    if d >= _bf_inf()
        return -1
    return d

// bf_has_negative_cycle(adj, nodes, source) -> bool (1 if a negative cycle is
// reachable from source, 0 otherwise).
// After |nodes|-1 passes the distances are optimal (if no negative cycle). A
// further relaxation that still improves a distance proves a negative cycle.
fn bf_has_negative_cycle(adj, nodes, source)
    let dist = _bf_init_dist(nodes, source)
    let n = len(nodes)
    let pass = 0
    while pass < n - 1
        _bf_relax_once(adj, nodes, dist)
        pass = pass + 1
    // One extra pass: if anything still improves, a negative cycle exists.
    let found = _bf_relax_once(adj, nodes, dist)
    return found
