// std/graph/topological.nova — Topological sort for NOVA (Kahn's algorithm).
//
// Graph representation: adj is a dict mapping node-name STRING to a list of
// neighbor-name STRINGs (directed, unweighted).  nodes is a list of all node
// name strings (needed to discover isolated nodes with no adjacency entries).
//
// Determinism: when multiple nodes have in-degree 0 at the same step the
// SMALLEST name (lexicographic) is chosen first — this gives a unique,
// reproducible ordering for any given graph.
//
// Public API:
//   tp_sort(adj, nodes)            -> list  valid topological order, or [] if cycle
//   tp_is_dag(adj, nodes)          -> int   1 if acyclic, 0 if the graph has a cycle
//   tp_longest_path_len(adj, nodes) -> int  number of edges on the longest path (0 if DAG is empty)
//
// Module-private prefix: _tp_

// ─── private helpers ──────────────────────────────────────────────────────────

// Build in-degree dict: node -> int count of incoming edges.
fn _tp_build_indegree(adj, nodes)
    let indeg = {}
    for i in 0..len(nodes)
        let nd = nodes[i]
        indeg[nd] = 0
    for j in 0..len(nodes)
        let u = nodes[j]
        if contains(adj, u)
            let nbrs = adj[u]
            let k = 0
            while k < len(nbrs)
                let v = nbrs[k]
                if contains(indeg, v)
                    indeg[v] = indeg[v] + 1
                k = k + 1
    return indeg

// Find the lexicographically smallest string in list xs.
// Returns "" if xs is empty (caller guards this).
fn _tp_min_str(xs)
    let best = xs[0]
    for i in 1..len(xs)
        let cur = xs[i]
        if cur < best
            best = cur
    return best

// Remove the first occurrence of target from list xs; returns a new list.
fn _tp_remove_one(xs, target)
    let out = []
    let found = 0
    for i in 0..len(xs)
        let cur = xs[i]
        if cur == target and found == 0
            found = 1
        else
            out.push(cur)
    return out

// Core Kahn loop.  Returns the ordered list; if len < len(nodes) a cycle exists.
fn _tp_kahn(adj, nodes)
    let indeg = _tp_build_indegree(adj, nodes)
    // Collect all nodes with in-degree 0 as the initial ready set.
    let ready = []
    for i in 0..len(nodes)
        let nd = nodes[i]
        let deg = indeg[nd]
        if deg == 0
            ready.push(nd)
    let order = []
    while len(ready) > 0
        // Pick the lexicographically smallest node for determinism.
        let u = _tp_min_str(ready)
        ready = _tp_remove_one(ready, u)
        order.push(u)
        // Reduce in-degree of all neighbours of u.
        if contains(adj, u)
            let nbrs = adj[u]
            for j in 0..len(nbrs)
                let v = nbrs[j]
                if contains(indeg, v)
                    indeg[v] = indeg[v] - 1
                    if indeg[v] == 0
                        ready.push(v)
    return order

// ─── public API ───────────────────────────────────────────────────────────────

// tp_sort(adj, nodes) -> list of node names in a valid topological order.
// Returns [] if the graph contains a cycle (not a DAG).
// Ties (multiple zero-in-degree nodes) are broken by smallest name first.
fn tp_sort(adj, nodes)
    let order = _tp_kahn(adj, nodes)
    if len(order) < len(nodes)
        return []
    return order

// tp_is_dag(adj, nodes) -> 1 if the graph is a DAG, 0 if it contains a cycle.
fn tp_is_dag(adj, nodes)
    let order = _tp_kahn(adj, nodes)
    if len(order) == len(nodes)
        return 1
    return 0

// tp_longest_path_len(adj, nodes) -> int.
// Returns the number of edges on the longest path in the DAG.
// Returns 0 if the graph is empty or every node is isolated.
// Returns 0 (safe fallback) if the graph has a cycle (undefined for cyclic).
fn tp_longest_path_len(adj, nodes)
    let order = _tp_kahn(adj, nodes)
    if len(order) < len(nodes)
        return 0
    // DP: dist[v] = length of longest path ending at v (in edges).
    let dist = {}
    for i in 0..len(order)
        let u = order[i]
        dist[u] = 0
    for j in 0..len(order)
        let u = order[j]
        let du = dist[u]
        if contains(adj, u)
            let nbrs = adj[u]
            let k = 0
            while k < len(nbrs)
                let v = nbrs[k]
                if contains(dist, v)
                    let cand = du + 1
                    if cand > dist[v]
                        dist[v] = cand
                k = k + 1
    // Find maximum value in dist.
    let best = 0
    let m = 0
    let ks = keys(dist)
    while m < len(ks)
        let nd = ks[m]
        let dv = dist[nd]
        if dv > best
            best = dv
        m = m + 1
    return best
