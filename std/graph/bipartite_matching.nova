// std/graph/bipartite_matching.nova — Maximum bipartite matching via augmenting paths.
//
// Graph: left_n left nodes (0..left_n-1), right_n right nodes (0..right_n-1),
// edges = list of [l, r] pairs where l is a left node and r is a right node.
//
// Public API:
//   bpm_max_matching(left_n, right_n, edges) -> int  size of maximum matching
//   bpm_is_perfect(left_n, right_n, edges)   -> bool true iff matching size == left_n == right_n
//
// Algorithm: Hopcroft-Karp style augmenting paths — for each unmatched left node,
// run a DFS that tries to find an augmenting path. When a right node is matched to
// another left node, recursively attempt to re-augment that left node's matching.
// This is the standard O(V*E) bipartite matching algorithm.
//
// Module-private prefix: _bpm_

// _bpm_build_adj: build adjacency list for left nodes from edge list.
// Returns list of length left_n; each entry is a list of right neighbor indices.
fn _bpm_build_adj(left_n, edges) -> list
    let adj = []
    let i = 0
    while i < left_n
        let row = []
        push(adj, row)
        i = i + 1
    let ei = 0
    while ei < len(edges)
        let e = edges[ei]
        let l = e[0]
        let r = e[1]
        push(adj[l], r)
        ei = ei + 1
    return adj

// _bpm_try_augment: DFS from left node u trying to find an augmenting path.
// match_r: list of length right_n; match_r[r] = matched left node or -1.
// seen: list of length right_n; seen[r] = 1 if visited in this DFS pass.
// adj: adjacency list (left->list of right neighbors).
// Returns 1 if augmenting path found, 0 otherwise.
fn _bpm_try_augment(u, adj, match_r, seen, right_n) -> int
    let nbrs = adj[u]
    let ni = 0
    let result = 0
    while ni < len(nbrs)
        let r = nbrs[ni]
        let already_seen = seen[r]
        if already_seen == 0
            seen[r] = 1
            let cur_match = match_r[r]
            let can_take = 0
            if cur_match == -1
                can_take = 1
            if can_take == 0
                let sub = _bpm_try_augment(cur_match, adj, match_r, seen, right_n)
                if sub == 1
                    can_take = 1
            if can_take == 1
                match_r[r] = u
                result = 1
                ni = len(nbrs)
        ni = ni + 1
    return result

// bpm_max_matching: returns the size of the maximum bipartite matching.
// left_n left nodes (0..left_n-1), right_n right nodes (0..right_n-1),
// edges = list of [l, r] pairs.
fn bpm_max_matching(left_n, right_n, edges) -> int
    if left_n == 0
        return 0
    if right_n == 0
        return 0
    let adj = _bpm_build_adj(left_n, edges)
    // match_r[r] = matched left node index, or -1
    let match_r = []
    let ri = 0
    while ri < right_n
        push(match_r, -1)
        ri = ri + 1
    let matching = 0
    let u = 0
    while u < left_n
        // Fresh 'seen' array for each augmenting path attempt
        let seen = []
        let si = 0
        while si < right_n
            push(seen, 0)
            si = si + 1
        let found = _bpm_try_augment(u, adj, match_r, seen, right_n)
        if found == 1
            matching = matching + 1
        u = u + 1
    return matching

// bpm_is_perfect: returns true iff matching size equals left_n and left_n equals right_n.
// A perfect matching requires every left node and every right node to be matched.
fn bpm_is_perfect(left_n, right_n, edges) -> bool
    if left_n != right_n
        return false
    if left_n == 0
        return true
    let sz = bpm_max_matching(left_n, right_n, edges)
    if sz == left_n
        return true
    return false
