// std/graph/astar.nova — A* search on a weighted directed graph with a heuristic.
//
// Graph representation:
//   adj = dict mapping node-name string -> list of edges
//   where each edge is a 2-element list [neighborNameString, weightInt]
//   (non-negative weights required for correctness)
//
// Heuristic:
//   h = dict mapping node-name string -> int estimate of distance to goal.
//   Must be ADMISSIBLE (never overestimates the true cost) for A* to return
//   the optimal path. An all-zero heuristic reduces A* to Dijkstra's algorithm.
//
// Public API:
//   as_path(adj, h, start, goal) -> list   (node sequence start..goal, [] if none)
//   as_distance(adj, h, start, goal) -> int (total path cost, -1 if unreachable)
//
// Implementation: O(V²) open-set scan (no binary heap). Correct and optimal
// when h is admissible.  Private helpers prefixed _as_ to avoid name collisions.

let _AS_INF = 1000000000

// _as_hval: safely look up heuristic value for node nd, default 0 if missing.
fn _as_hval(h, nd) -> int
    if nd in h
        return h[nd]
    return 0

// _as_gval: safely look up g-score (cost from start) for nd, default INF.
fn _as_gval(g, nd) -> int
    if nd in g
        return g[nd]
    return _AS_INF

// _as_pick_open: find the open node with the smallest f-score (g + h).
// open is a dict node -> 1; g is a dict node -> g-score.
// Returns "" when the open set is empty.
fn _as_pick_open(open, g, h) -> str
    let best = ""
    let best_f = _AS_INF + 1
    let nds = keys(open)
    for i in 0..len(nds)
        let nd = nds[i]
        if nd in open
            let in_open = open[nd]
            if in_open == 1
                let gv = _as_gval(g, nd)
                let hv = _as_hval(h, nd)
                let fv = gv + hv
                if fv < best_f
                    best_f = fv
                    best = nd
    return best

// _as_core: run A* from start toward goal.
// Returns a 2-element list: [g_dict, came_from_dict]
//   g_dict:       node -> best known cost from start (_AS_INF = unreachable)
//   came_from:    node -> predecessor on the best path found so far
// The search terminates early once goal is settled (popped from open set).
fn _as_core(adj, h, start, goal) -> list
    let g = {}
    let came_from = {}
    let open = {}
    let closed = {}
    g[start] = 0
    open[start] = 1
    let found = 0
    let safety = 0
    while found == 0 and safety < 1000000
        let u = _as_pick_open(open, g, h)
        if u == ""
            found = 2
        if u != "" and found == 0
            if u == goal
                found = 1
            if found == 0
                open[u] = 0
                closed[u] = 1
                let gu = g[u]
                if u in adj
                    let edges = adj[u]
                    for ei in 0..len(edges)
                        let edge = edges[ei]
                        let v = edge[0]
                        let w = edge[1]
                        let in_closed = 0
                        if v in closed
                            in_closed = closed[v]
                        if in_closed == 0
                            let tent_g = gu + w
                            let old_g = _as_gval(g, v)
                            if tent_g < old_g
                                g[v] = tent_g
                                came_from[v] = u
                                open[v] = 1
            if found == 1
                // goal was popped: mark it closed so we know it is settled
                open[u] = 0
                closed[u] = 1
        safety += 1
    return [g, came_from]

// as_distance: return the optimal path cost from start to goal.
// Returns -1 if no path exists.
fn as_distance(adj, h, start, goal) -> int
    if start == goal
        return 0
    let result = _as_core(adj, h, start, goal)
    let g = result[0]
    let d = _AS_INF
    if goal in g
        d = g[goal]
    if d >= _AS_INF
        return -1
    return d

// _as_build_path: reconstruct path from start to target by following came_from.
// Returns list [start, ..., target], or [] if reconstruction fails.
fn _as_build_path(came_from, start, target) -> list
    let rev = []
    let cur = target
    let ok = 1
    let safety = 0
    while cur != start and ok == 1 and safety < 1000000
        push(rev, cur)
        if cur in came_from
            cur = came_from[cur]
        if cur != start
            if cur not in came_from
                ok = 0
        safety += 1
    if ok == 0
        return []
    push(rev, start)
    let path = []
    let ri = len(rev) - 1
    while ri >= 0
        push(path, rev[ri])
        ri -= 1
    return path

// as_path: return the optimal node sequence [start, ..., goal].
// Returns [] if no path exists.
fn as_path(adj, h, start, goal) -> list
    if start == goal
        return [start]
    let result = _as_core(adj, h, start, goal)
    let g = result[0]
    let came_from = result[1]
    let d = _AS_INF
    if goal in g
        d = g[goal]
    if d >= _AS_INF
        return []
    return _as_build_path(came_from, start, goal)
