// std/graph/scc_kosaraju.nova — Kosaraju's strongly-connected components for directed graphs.
//
// Graph representation: adj is a list of lists; adj[i] is the list of integer
// neighbor ids of node i.  n is the number of nodes (0..n-1).
//
// Public API:
//   sk_count(adj, n)          -> int   number of strongly-connected components
//   sk_components(adj, n)     -> list  list of SCCs; each SCC is a sorted list of node ids
//   sk_same(adj, n, u, v)     -> bool  true iff u and v are in the same SCC
//
// Algorithm: Kosaraju's two-pass DFS (both passes iterative to avoid stack overflow).
//   Pass 1: iterative DFS on original graph; push nodes to finish-list on completion.
//   Pass 2: iterative DFS on transposed graph in reverse finish order.
// Module-private prefix: _sk_

// _sk_build_transpose: build the transposed graph (all edges reversed).
fn _sk_build_transpose(adj, n)
    let trans = []
    for i in 0..n
        trans.push([])
    for u in 0..n
        let nbrs = adj[u]
        let k = 0
        while k < len(nbrs)
            let v = nbrs[k]
            trans[v].push(u)
            k += 1
    return trans

// _sk_dfs1: iterative post-order DFS on adj from node src.
// visited: mutable list of length n (0/1).
// finish: mutable list; nodes appended in finish order (post-order).
fn _sk_dfs1(adj, src, visited, finish)
    // Stack: two parallel lists stk_n (node) stk_i (next-neighbor-index) + stk_top pointer.
    let stk_n = []
    let stk_i = []
    let stk_top = 0
    visited[src] = 1
    stk_n.push(src)
    stk_i.push(0)
    stk_top = 1
    while stk_top > 0
        let top = stk_top - 1
        let u = stk_n[top]
        let idx = stk_i[top]
        let nbrs = adj[u]
        // scan for the next unvisited neighbor starting from idx
        let advanced = 0
        let ci = idx
        let scan_done = 0
        while scan_done == 0
            if ci >= len(nbrs)
                scan_done = 1
            else
                let v = nbrs[ci]
                ci += 1
                if visited[v] == 0
                    visited[v] = 1
                    stk_i[top] = ci
                    if stk_top < len(stk_n)
                        stk_n[stk_top] = v
                        stk_i[stk_top] = 0
                    else
                        stk_n.push(v)
                        stk_i.push(0)
                    stk_top += 1
                    advanced = 1
                    scan_done = 1
        if advanced == 0
            // no unvisited neighbor — node u is finished
            finish.push(u)
            stk_top -= 1

// _sk_dfs2: iterative DFS on trans from node src; collects all reachable unvisited nodes into comp.
fn _sk_dfs2(trans, src, visited, comp)
    let stk_n = []
    let stk_i = []
    let stk_top = 0
    visited[src] = 1
    comp.push(src)
    stk_n.push(src)
    stk_i.push(0)
    stk_top = 1
    while stk_top > 0
        let top = stk_top - 1
        let u = stk_n[top]
        let idx = stk_i[top]
        let nbrs = trans[u]
        let advanced = 0
        let ci = idx
        let scan_done = 0
        while scan_done == 0
            if ci >= len(nbrs)
                scan_done = 1
            else
                let v = nbrs[ci]
                ci += 1
                if visited[v] == 0
                    visited[v] = 1
                    comp.push(v)
                    stk_i[top] = ci
                    if stk_top < len(stk_n)
                        stk_n[stk_top] = v
                        stk_i[stk_top] = 0
                    else
                        stk_n.push(v)
                        stk_i.push(0)
                    stk_top += 1
                    advanced = 1
                    scan_done = 1
        if advanced == 0
            stk_top -= 1

// _sk_sort_ints: insertion sort a list of ints ascending (in-place).
fn _sk_sort_ints(xs)
    let sz = len(xs)
    for i in 1..sz
        let key = xs[i]
        let j = i - 1
        let jdone = 0
        while jdone == 0
            if j < 0
                jdone = 1
            else
                if xs[j] > key
                    xs[j + 1] = xs[j]
                    j -= 1
                else
                    jdone = 1
        xs[j + 1] = key

// _sk_sort_comps: sort a list of SCC lists by their minimum element (ascending).
fn _sk_sort_comps(comps)
    let nc = len(comps)
    for i in 1..nc
        let key_comp = comps[i]
        let key_val = key_comp[0]
        let j = i - 1
        let jdone = 0
        while jdone == 0
            if j < 0
                jdone = 1
            else
                let pivot_val = comps[j][0]
                if pivot_val > key_val
                    comps[j + 1] = comps[j]
                    j -= 1
                else
                    jdone = 1
        comps[j + 1] = key_comp

// _sk_run: core Kosaraju; returns list of SCCs (each sorted, outer sorted by min element).
fn _sk_run(adj, n)
    if n == 0
        return []
    let trans = _sk_build_transpose(adj, n)
    // Pass 1: DFS on adj, build finish order
    let visited1 = []
    for fi in 0..n
        visited1.push(0)
    let finish = []
    let u = 0
    while u < n
        if visited1[u] == 0
            _sk_dfs1(adj, u, visited1, finish)
        u += 1
    // Pass 2: DFS on transpose in reverse finish order
    let visited2 = []
    for vi in 0..n
        visited2.push(0)
    let comps = []
    let fi2 = len(finish) - 1
    while fi2 >= 0
        let src = finish[fi2]
        if visited2[src] == 0
            let comp = []
            _sk_dfs2(trans, src, visited2, comp)
            _sk_sort_ints(comp)
            comps.push(comp)
        fi2 -= 1
    _sk_sort_comps(comps)
    return comps

// sk_count: returns the number of strongly-connected components.
fn sk_count(adj, n)
    let comps = _sk_run(adj, n)
    return len(comps)

// sk_components: returns list of SCCs; each SCC is a sorted list of node ids;
// the outer list is sorted by each SCC's minimum node id.
fn sk_components(adj, n)
    return _sk_run(adj, n)

// sk_same: returns true iff nodes u and v belong to the same strongly-connected component.
fn sk_same(adj, n, u, v)
    let comps = _sk_run(adj, n)
    for i in 0..len(comps)
        let comp = comps[i]
        let fu = 0
        let fv = 0
        let j = 0
        while j < len(comp)
            if comp[j] == u
                fu = 1
            if comp[j] == v
                fv = 1
            j += 1
        if fu == 1 and fv == 1
            return true
    return false
