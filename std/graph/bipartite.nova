// std/graph/bipartite.nova — Bipartite testing + 2-coloring for NOVA.
//
// Graph representation: adj is a dict mapping node-name STRING to a list of
// neighbor-name STRINGs (undirected, unweighted; must be symmetric).
// nodes is a list of all node-name strings (needed to cover isolated nodes).
//
// Public API:
//   bp_is_bipartite(adj, nodes)  -> bool  true iff the graph is 2-colorable
//   bp_coloring(adj, nodes)      -> dict  node -> 0 or 1 (empty dict if not bipartite)
//   bp_odd_cycle_free(adj, nodes)-> bool  alias for bp_is_bipartite (odd-cycle-free == bipartite)
//
// Algorithm: BFS 2-coloring over every connected component.
//   Assign color 0 to the first unvisited node in a component.
//   For each neighbor, if uncolored assign the opposite color;
//   if already colored and matches current node's color, graph is not bipartite.
//   Handles disconnected graphs by iterating over all nodes in nodes list.
//
// Module-private prefix: _bp_

// ─── private helpers ──────────────────────────────────────────────────────────

// _bp_opposite: returns 1 if c==0, 0 if c==1.
fn _bp_opposite(c) -> int
    if c == 0
        return 1
    return 0

// _bp_bfs_component: BFS-color all nodes reachable from start.
// color: dict node->int (mutated in-place; start not yet present when called).
// adj: the adjacency dict.
// Returns 1 if bipartite so far, 0 if an odd cycle was detected.
fn _bp_bfs_component(adj, start, color, start_color) -> int
    // queue implemented as a list with a head index
    let queue = []
    let head = 0
    color[start] = start_color
    queue.push(start)
    let ok = 1
    while head < len(queue) and ok == 1
        let u = queue[head]
        head = head + 1
        let cu = color[u]
        if contains(adj, u)
            let nbrs = adj[u]
            let i = 0
            while i < len(nbrs)
                let v = nbrs[i]
                if contains(color, v)
                    // already colored — same color as u means odd cycle
                    let cv = color[v]
                    if cv == cu
                        ok = 0
                else
                    // uncolored — assign opposite color and enqueue
                    let opp = _bp_opposite(cu)
                    color[v] = opp
                    queue.push(v)
                i = i + 1
    return ok

// _bp_run: core algorithm. Returns a 2-element list [is_bip_int, color_dict].
// is_bip_int: 1 if bipartite, 0 otherwise.
// color_dict: node->int coloring (valid only if is_bip_int==1).
fn _bp_run(adj, nodes) -> list
    let color = {}
    let ok = 1
    let i = 0
    while i < len(nodes)
        let v = nodes[i]
        if contains(color, v) == 0
            // start each unvisited component with color 0
            let res = _bp_bfs_component(adj, v, color, 0)
            if res == 0
                ok = 0
        i = i + 1
    return [ok, color]

// ─── public API ───────────────────────────────────────────────────────────────

// bp_is_bipartite: returns true if the graph is bipartite (2-colorable).
// Works correctly across disconnected components.
fn bp_is_bipartite(adj, nodes) -> bool
    let result = _bp_run(adj, nodes)
    let ok = result[0]
    if ok == 1
        return true
    return false

// bp_coloring: returns a dict mapping each node to 0 or 1 such that no edge
// connects two same-colored nodes. Returns an empty dict {} if not bipartite.
fn bp_coloring(adj, nodes) -> dict
    let result = _bp_run(adj, nodes)
    let ok = result[0]
    if ok == 0
        return {}
    return result[1]

// bp_odd_cycle_free: true iff the graph contains no odd-length cycle.
// Mathematically equivalent to bp_is_bipartite.
fn bp_odd_cycle_free(adj, nodes) -> bool
    let result = _bp_run(adj, nodes)
    let ok = result[0]
    if ok == 1
        return true
    return false
