// std/graph/articulation_bridges.nova — Articulation points and bridges for NOVA.
//
// Graph representation: adj is a list where adj[i] is the list of integer
// neighbors of node i (undirected, unweighted). n is the node count (0..n-1).
//
// Public API:
//   ab_articulation_points(adj, n) -> sorted list of cut vertices (ints)
//   ab_bridges(adj, n)             -> list of bridge edges as [u,v] with u<v, sorted
//   ab_count_bridges(adj, n)       -> int count of bridges
//
// Algorithm: standard iterative DFS low-link method (Tarjan 1974).
//   disc[v]  — DFS discovery time of v
//   low[v]   — lowest disc reachable from v's subtree via back edges
//   parent[v] — DFS parent of v (-1 for root)
//   An articulation point is:
//     - the DFS root with >= 2 tree children, OR
//     - any non-root v where low[child] >= disc[v] for some tree child.
//   A bridge is an edge (u,v) where low[v] > disc[u] (v is child).
//
// Implementation: iterative DFS using parallel int-lists for the stack
//   (stk_u/stk_par/stk_ni) with a logical size counter stk_sz.
//   Pop = decrement stk_sz (avoids slice-on-non-scalar-list issues).
// NOTE: NOVA does not permit `while A and B` in nested loops — done-flag pattern used.
// Module-private prefix: _ab_

// _ab_make_int_list: build a list of n integers all set to val.
fn _ab_make_int_list(n, val)
    let lst = []
    let i = 0
    while i < n
        lst.push(val)
        i = i + 1
    return lst

// _ab_isort_ints: insertion-sort a list of ints ascending (in-place).
fn _ab_isort_ints(xs)
    let n = len(xs)
    let i = 1
    while i < n
        let key = xs[i]
        let j = i - 1
        let done = 0
        while done == 0
            if j < 0
                done = 1
            else
                if xs[j] > key
                    xs[j + 1] = xs[j]
                    j = j - 1
                else
                    done = 1
        xs[j + 1] = key
        i = i + 1

// _ab_isort_edges: insertion-sort a list of [u,v] edges by u then v (in-place).
fn _ab_isort_edges(edges)
    let n = len(edges)
    let i = 1
    while i < n
        let key = edges[i]
        let ku = key[0]
        let kv = key[1]
        let j = i - 1
        let done = 0
        while done == 0
            if j < 0
                done = 1
            else
                let oe = edges[j]
                let ou = oe[0]
                let ov = oe[1]
                let shift = 0
                if ou > ku
                    shift = 1
                else
                    if ou == ku and ov > kv
                        shift = 1
                if shift == 1
                    edges[j + 1] = edges[j]
                    j = j - 1
                else
                    done = 1
        edges[j + 1] = key
        i = i + 1

// _ab_run: core DFS low-link traversal.
// Returns [ap_flags, bridge_list]:
//   ap_flags  — list of n ints; ap_flags[v]=1 if v is an articulation point
//   bridge_list — list of [u,v] edges (u < v) that are bridges
//
// Stack representation: three parallel int lists (stk_u, stk_par, stk_ni) plus
// a logical size counter stk_sz.  Pop = stk_sz -= 1 (no slice).
fn _ab_run(adj, n)
    let ap_flags = _ab_make_int_list(n, 0)
    let disc     = _ab_make_int_list(n, -1)
    let low      = _ab_make_int_list(n, -1)
    let parent   = _ab_make_int_list(n, -1)
    // child_count[v] = number of DFS tree children (used for root check)
    let child_count = _ab_make_int_list(n, 0)
    let bridges  = []
    let timer    = []
    timer.push(0)
    let src = 0
    while src < n
        if disc[src] == -1
            // iterative DFS from src using parallel int stacks
            let stk_u   = []
            let stk_par = []
            let stk_ni  = []
            stk_u.push(src)
            stk_par.push(-1)
            stk_ni.push(0)
            let stk_sz = 1
            disc[src] = timer[0]
            low[src]  = timer[0]
            timer[0]  = timer[0] + 1
            let sdone = 0
            while sdone == 0
                if stk_sz == 0
                    sdone = 1
                else
                    let top = stk_sz - 1
                    let u   = stk_u[top]
                    let par = stk_par[top]
                    let ni  = stk_ni[top]
                    let nbrs = adj[u]
                    if ni >= len(nbrs)
                        // done with u — pop and propagate low upward
                        stk_sz = stk_sz - 1
                        if par >= 0
                            // propagate: low[par] = min(low[par], low[u])
                            if low[u] < low[par]
                                low[par] = low[u]
                            // articulation point check for non-root parent
                            let parIsRoot = 0
                            if parent[par] == -1
                                parIsRoot = 1
                            if parIsRoot == 0
                                if low[u] >= disc[par]
                                    ap_flags[par] = 1
                            // bridge check
                            if low[u] > disc[par]
                                let eu = par
                                let ev = u
                                if ev < eu
                                    eu = u
                                    ev = par
                                let br = []
                                br.push(eu)
                                br.push(ev)
                                bridges.push(br)
                    else
                        // advance neighbor index in-place
                        stk_ni[top] = ni + 1
                        let v = nbrs[ni]
                        if disc[v] == -1
                            // tree edge: push child
                            parent[v] = u
                            child_count[u] = child_count[u] + 1
                            disc[v] = timer[0]
                            low[v]  = timer[0]
                            timer[0] = timer[0] + 1
                            stk_u.push(v)
                            stk_par.push(u)
                            stk_ni.push(0)
                            stk_sz = stk_sz + 1
                        else
                            // back edge: ignore parent edge, update low otherwise
                            if v != par
                                if disc[v] < low[u]
                                    low[u] = disc[v]
            // root articulation-point check (root of this DFS tree)
            if child_count[src] >= 2
                ap_flags[src] = 1
        src = src + 1
    let result = []
    result.push(ap_flags)
    result.push(bridges)
    return result

// ab_articulation_points: returns sorted list of cut vertices.
// Returns [] if n==0 or no articulation points exist.
fn ab_articulation_points(adj, n)
    if n == 0
        return []
    let res = _ab_run(adj, n)
    let ap_flags = res[0]
    let pts = []
    let i = 0
    while i < n
        if ap_flags[i] == 1
            pts.push(i)
        i = i + 1
    _ab_isort_ints(pts)
    return pts

// ab_bridges: returns list of bridge edges [u,v] with u<v, sorted by u then v.
// Returns [] if n==0 or no bridges exist.
fn ab_bridges(adj, n)
    if n == 0
        return []
    let res = _ab_run(adj, n)
    let bridges = res[1]
    _ab_isort_edges(bridges)
    return bridges

// ab_count_bridges: returns the number of bridges in the graph.
fn ab_count_bridges(adj, n)
    if n == 0
        return 0
    let res = _ab_run(adj, n)
    let bridges = res[1]
    return len(bridges)
