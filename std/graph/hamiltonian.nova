// std/graph/hamiltonian.nova — Hamiltonian path/cycle detection via backtracking.
// LEAF — imports NOTHING.
//
// Graph representation:
//   adj = list of lists: adj[i] = list of integer neighbor ids for node i
//   n   = number of nodes (0..n-1)
//
// Public API:
//   ham_has_path(adj, n)      -> bool  a Hamiltonian path exists (visits all nodes once)
//   ham_has_cycle(adj, n)     -> bool  a Hamiltonian cycle exists
//   ham_count_cycles(adj, n)  -> int   number of distinct Hamiltonian cycles (undirected,
//                                       counted canonically: fix start=0, count each cycle once)
//
// Algorithm: backtracking DFS with a visited boolean array.
// For ham_count_cycles the start is fixed at node 0 (since every undirected cycle
// passes through node 0 exactly once in any canonical enumeration) to avoid
// counting rotations; reflections are counted once by not reversing.
//
// Private helpers prefixed _ham_

// _ham_has_edge: return 1 if there is an edge from u to v in adj, else 0.
fn _ham_has_edge(adj, u, v) -> int
    let nbrs = adj[u]
    let i = 0
    while i < len(nbrs)
        if nbrs[i] == v
            return 1
        i = i + 1
    return 0

// _ham_make_vis: create a visited list of n zeros.
fn _ham_make_vis(n) -> list
    let vis = []
    let i = 0
    while i < n
        push(vis, 0)
        i = i + 1
    return vis

// _ham_path_dfs: backtracking DFS for Hamiltonian path.
// path_len = number of nodes placed so far; cur = last placed node.
// Returns 1 if a complete path is found, 0 otherwise.
fn _ham_path_dfs(adj, n, vis, cur, path_len) -> int
    if path_len == n
        return 1
    let nbrs = adj[cur]
    let i = 0
    while i < len(nbrs)
        let v = nbrs[i]
        if vis[v] == 0
            vis[v] = 1
            let found = _ham_path_dfs(adj, n, vis, v, path_len + 1)
            if found == 1
                vis[v] = 0
                return 1
            vis[v] = 0
        i = i + 1
    return 0

// _ham_cycle_dfs: backtracking DFS for Hamiltonian cycle starting from node 0.
// path_len = nodes placed; cur = last placed node; start = fixed origin (0).
// Returns 1 if a complete cycle is found.
fn _ham_cycle_dfs(adj, n, vis, cur, path_len, start) -> int
    if path_len == n
        // check edge back to start
        return _ham_has_edge(adj, cur, start)
    let nbrs = adj[cur]
    let i = 0
    while i < len(nbrs)
        let v = nbrs[i]
        if vis[v] == 0
            vis[v] = 1
            let found = _ham_cycle_dfs(adj, n, vis, v, path_len + 1, start)
            if found == 1
                vis[v] = 0
                return 1
            vis[v] = 0
        i = i + 1
    return 0

// _ham_count_dfs: count all Hamiltonian cycles starting from node 0.
// Each unique cycle is counted once (start fixed = 0 avoids rotations).
fn _ham_count_dfs(adj, n, vis, cur, path_len, start) -> int
    if path_len == n
        if _ham_has_edge(adj, cur, start) == 1
            return 1
        return 0
    let total = 0
    let nbrs = adj[cur]
    let i = 0
    while i < len(nbrs)
        let v = nbrs[i]
        if vis[v] == 0
            vis[v] = 1
            total = total + _ham_count_dfs(adj, n, vis, v, path_len + 1, start)
            vis[v] = 0
        i = i + 1
    return total

// ham_has_path: return true iff a Hamiltonian path exists in adj.
// Tries every starting vertex (paths need not start at 0).
fn ham_has_path(adj, n) -> bool
    if n == 0
        return false
    if n == 1
        return true
    let i = 0
    while i < n
        let vis = _ham_make_vis(n)
        vis[i] = 1
        let found = _ham_path_dfs(adj, n, vis, i, 1)
        if found == 1
            return true
        i = i + 1
    return false

// ham_has_cycle: return true iff a Hamiltonian cycle exists in adj.
// Fixes start=0 to avoid redundant symmetric searches.
fn ham_has_cycle(adj, n) -> bool
    if n < 3
        return false
    let vis = _ham_make_vis(n)
    vis[0] = 1
    let found = _ham_cycle_dfs(adj, n, vis, 0, 1, 0)
    if found == 1
        return true
    return false

// ham_count_cycles: count the number of distinct Hamiltonian cycles.
// Fixes start=0 and divides by 2 for undirected graphs (each cycle counted twice:
// once in each direction).
fn ham_count_cycles(adj, n) -> int
    if n < 3
        return 0
    let vis = _ham_make_vis(n)
    vis[0] = 1
    let raw = _ham_count_dfs(adj, n, vis, 0, 1, 0)
    return raw / 2
