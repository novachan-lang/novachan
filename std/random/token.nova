// std/random/token -- Deterministic random token/ID generation via a 64-bit LCG.
//
// All functions accept a seed (int) and are PURELY FUNCTIONAL — no global state.
// Same seed -> same output always (deterministic / reproducible).
//
// Embedded LCG (Knuth multiplicative congruential):
//   state = (state * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFFFFFFFFFF
// The sign bit is cleared after each step so state stays non-negative on NOVA's i64.
//
// Public API:
//   tk_hex(nbytes, seed)    -> string   -- nbytes random bytes as lowercase hex; length = 2*nbytes
//   tk_alnum(length, seed)  -> string   -- 0-9 A-Z a-z characters; length chars
//   tk_numeric(length, seed)-> string   -- digits 0-9 only; length chars
//   tk_urlsafe(nbytes, seed)-> string   -- base64url charset A-Za-z0-9-_; nbytes chars
//
// NOVA GOTCHAS obeyed:
//   * >> is arithmetic — mask with 0x7FFFFFFFFFFFFFFF to stay non-negative
//   * No multi-line list/dict literals
//   * '{'/'}' in strings interpolate — use chr(123)/chr(125) if needed
//   * Bare complex float expr as return -> bind to let first
//   * Unused local = compile error; don't bind values you never read
//   * No '&&'/'||' — use 'and'/'or'
//   * Integer division is truncating

// ── Private LCG ─────────────────────────────────────────────────────────────

// _tk_step: one LCG step; returns non-negative 63-bit int.
fn _tk_step(state: int) -> int
    let a = 6364136223846793005
    let c = 1442695040888963407
    let raw = state * a + c
    raw & 0x7FFFFFFFFFFFFFFF

// ── Private charset helpers ──────────────────────────────────────────────────

// _tk_hex_char: nibble 0..15 -> hex char as single-char string
fn _tk_hex_char(nibble: int) -> string
    if nibble == 0
        return "0"
    if nibble == 1
        return "1"
    if nibble == 2
        return "2"
    if nibble == 3
        return "3"
    if nibble == 4
        return "4"
    if nibble == 5
        return "5"
    if nibble == 6
        return "6"
    if nibble == 7
        return "7"
    if nibble == 8
        return "8"
    if nibble == 9
        return "9"
    if nibble == 10
        return "a"
    if nibble == 11
        return "b"
    if nibble == 12
        return "c"
    if nibble == 13
        return "d"
    if nibble == 14
        return "e"
    "f"

// _tk_alnum_char: index 0..61 -> char from "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
fn _tk_alnum_char(idx: int) -> string
    // digits 0-9 at positions 0-9
    if idx < 10
        return str(idx)
    // uppercase A-Z at positions 10-35
    if idx < 36
        return chr(65 + idx - 10)
    // lowercase a-z at positions 36-61
    chr(97 + idx - 36)

// _tk_urlsafe_char: index 0..63 -> char from "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
fn _tk_urlsafe_char(idx: int) -> string
    // A-Z at 0-25
    if idx < 26
        return chr(65 + idx)
    // a-z at 26-51
    if idx < 52
        return chr(97 + idx - 26)
    // 0-9 at 52-61
    if idx < 62
        return str(idx - 52)
    // '-' at 62, '_' at 63
    if idx == 62
        return "-"
    "_"

// ── tk_hex ───────────────────────────────────────────────────────────────────
// Produce nbytes random bytes represented as lowercase hex (length = 2*nbytes).
// Each LCG step provides one byte (low 8 bits), encoded as two hex digits.
fn tk_hex(nbytes: int, seed: int) -> string
    let out = ""
    let state = seed
    for i in 0..nbytes
        state = _tk_step(state)
        let byte_val = state % 256
        let hi = (byte_val / 16) % 16
        let lo = byte_val % 16
        out += _tk_hex_char(hi) + _tk_hex_char(lo)
    out

// ── tk_alnum ─────────────────────────────────────────────────────────────────
// Produce a random alphanumeric string of exactly `length` characters.
// Charset: 0-9 A-Z a-z (62 characters).
fn tk_alnum(length: int, seed: int) -> string
    let out = ""
    let state = seed
    for i in 0..length
        state = _tk_step(state)
        let idx = state % 62
        out += _tk_alnum_char(idx)
    out

// ── tk_numeric ───────────────────────────────────────────────────────────────
// Produce a random string of exactly `length` decimal digits (0-9).
fn tk_numeric(length: int, seed: int) -> string
    let out = ""
    let state = seed
    for i in 0..length
        state = _tk_step(state)
        let d = state % 10
        out += str(d)
    out

// ── tk_urlsafe ───────────────────────────────────────────────────────────────
// Produce a random URL-safe string of exactly `nbytes` characters.
// Charset: A-Za-z0-9-_ (64 characters; same alphabet as base64url without padding).
fn tk_urlsafe(nbytes: int, seed: int) -> string
    let out_parts = []
    let state = seed
    for i in 0..nbytes
        state = _tk_step(state)
        let idx = state % 64
        push(out_parts, _tk_urlsafe_char(idx))
    join(out_parts, "")
