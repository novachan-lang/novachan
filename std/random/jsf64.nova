// std/random/jsf64 -- Jenkins Small Fast PRNG, 64-bit (jsf64 / Bob Jenkins).
//
// Four 64-bit words of state: a, b, c, d.
// Output and state update on each call:
//   e = a - rotl64(b, 7)
//   a = b ^ rotl64(c, 13)
//   b = c + rotl64(d, 37)
//   c = d + e
//   d = e + a
//   return d
//
// Seeding: a=0xf1ea5eed, b=c=d=seed; then 20 warm-up calls to mix state.
//
// NOVA arithmetic notes:
//   * i64 + and * wrap mod 2^64 -- correct for PRNG arithmetic.
//   * >> is arithmetic (sign-extending); _jsf_shr64 applies logical mask.
//   * Constants > 2^63 are built from 32-bit halves to stay in i64 literals.
//   * jsf_next returns the full 64-bit word (may be negative as signed i64).
//   * jsf_next_range masks to 63 bits before modulo to guarantee non-negative.
//
// Public API:
//   jsf_seed(seed)          -> dict  create a new JSF64 state dict
//   jsf_next(rng)           -> int   advance state, return raw 64-bit output word
//   jsf_next_range(rng, n)  -> int   uniform in [0, n)

// ── private helpers ──────────────────────────────────────────────────────────

// _jsf_shr64: logical (unsigned) right shift for i64.
// NOVA >> is arithmetic; mask clears any sign-extended bits.
fn _jsf_shr64(x, n)
    let mask = (1 << (64 - n)) - 1
    return (x >> n) & mask

// _jsf_rotl64: rotate x left by r bits (64-bit).
fn _jsf_rotl64(x, r)
    let rr = r & 63
    if rr == 0
        return x
    return (x << rr) | _jsf_shr64(x, 64 - rr)

// _jsf_a0: seed constant 0xf1ea5eed for the 'a' word.
// Built from two 32-bit halves to avoid literal overflow.
fn _jsf_a0()
    return (0xf1ea5eed)

// _jsf_m63: 2^63 - 1 mask for stripping the sign bit.
fn _jsf_m63()
    return 9223372036854775807

// _jsf_step: single JSF64 iteration; mutates state dict, returns output word.
fn _jsf_step(rng)
    let a = rng["a"]
    let b = rng["b"]
    let c = rng["c"]
    let d = rng["d"]
    let e = a - _jsf_rotl64(b, 7)
    let na = b ^ _jsf_rotl64(c, 13)
    let nb = c + _jsf_rotl64(d, 37)
    let nc = d + e
    let nd = e + na
    rng["a"] = na
    rng["b"] = nb
    rng["c"] = nc
    rng["d"] = nd
    return nd

// ── jsf_seed ─────────────────────────────────────────────────────────────────
// Create a new JSF64 state dict seeded with `seed`.
// Initial state: a=0xf1ea5eed, b=c=d=seed.
// 20 warm-up iterations mix the seed through all four state words.
fn jsf_seed(seed)
    let st = {}
    st["a"] = _jsf_a0()
    st["b"] = seed
    st["c"] = seed
    st["d"] = seed
    for i in 0..20
        let _w = _jsf_step(st)
    return st

// ── jsf_next ─────────────────────────────────────────────────────────────────
// Advance the PRNG state in-place; return the next raw 64-bit output word.
// The returned value may be negative (bit 63 set in signed i64).
// Use jsf_next_range for bounded non-negative integers.
fn jsf_next(rng)
    return _jsf_step(rng)

// ── jsf_next_range ────────────────────────────────────────────────────────────
// Return a uniformly distributed int in [0, n).
// The raw 64-bit output is masked to 63 bits (clearing sign) before modulo
// so the result is always non-negative regardless of the raw word's sign.
fn jsf_next_range(rng, n)
    let raw = _jsf_step(rng)
    let m63 = _jsf_m63()
    let pos = raw & m63
    return pos % n
