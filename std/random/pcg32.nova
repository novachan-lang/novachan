// std/random/pcg32 -- PCG32 (pcg_setseq_64_xsh_rr_32) PRNG.
//
// A 64-bit LCG state produces 32-bit output via an XSH-RR (xor-shift high,
// random rotation) output permutation.  This gives PCG its excellent statistical
// quality and passes BigCrush at a fraction of Mersenne Twister's cost.
//
// Algorithm (O'Neill 2014, https://www.pcg-random.org/):
//   state = state * PCG_MULT + inc     (inc must be odd; sets the "stream")
//   output = rotr32( ((state XOR (state>>18)) >> 27) , state>>59 )
//
// NOVA arithmetic notes:
//   * i64 + and * wrap mod 2^64 exactly like uint64 -- correct for the LCG.
//   * >> is ARITHMETIC (sign-extending).  state has bit-63 set ~50% of the time,
//     so ALL right-shifts on state use _pcg_shr64 (logical shift).
//   * 0xFFFFFFFF = 4294967295 (fits i64 positive; safe as a mask literal).
//   * PCG_MULT = 6364136223846793005 < 2^63, safe as a positive i64 literal.
//
// State dict keys:
//   "s"  -- 64-bit LCG state (may be any i64 value including negative)
//   "i"  -- stream increment (always odd; never changes after seeding)
//
// Public API:
//   pcg_seed(seed, seq) -> dict   create seeded generator (seq selects stream)
//   pcg_next(rng)       -> int    advance state, return 32-bit output (0..2^32-1)
//   pcg_next_range(rng, n) -> int  uniform int in [0, n-1]

let _pcg_MULT = 6364136223846793005
let _pcg_MASK32 = 4294967295

// _pcg_shr64: logical right shift on a potentially-negative i64.
// Clears the sign bit before shifting so no sign-extension occurs.
fn _pcg_shr64(x: int, n: int) -> int
    let mask = (1 << (64 - n)) - 1
    let r = (x >> n) & mask
    r

// _pcg_rotr32: rotate right a 32-bit value by r positions.
fn _pcg_rotr32(x: int, r: int) -> int
    let xm = x & _pcg_MASK32
    let rr = r & 31
    let hi = xm >> rr
    let lo = (xm << (32 - rr)) & _pcg_MASK32
    let result = hi | lo
    result

// _pcg_advance: advance the LCG one step and return the new state.
// Multiplication and addition wrap mod 2^64 automatically in NOVA.
fn _pcg_advance(s: int, inc: int) -> int
    let ns = s * _pcg_MULT + inc
    ns

// _pcg_output: XSH-RR output permutation.
// Produces a high-quality 32-bit word from a 64-bit state.
fn _pcg_output(s: int) -> int
    let sh18 = _pcg_shr64(s, 18)
    let xored = sh18 ^ s
    let xsh = _pcg_shr64(xored, 27) & _pcg_MASK32
    let rot = _pcg_shr64(s, 59)
    let out = _pcg_rotr32(xsh, rot)
    out

// ── pcg_seed ─────────────────────────────────────────────────────────────────
// Create a new PCG32 generator.
//   seed -- initial state (any int)
//   seq  -- stream selector (any int; two generators with different seq values
//           produce independent, non-overlapping sequences)
// Implements the reference initialisation sequence from the PCG paper:
//   inc  = (seq << 1) | 1   (force odd)
//   state = 0 * MULT + inc  (step once from 0)
//   state = state + seed
//   state = state * MULT + inc  (step again)
fn pcg_seed(seed: int, seq: int) -> dict
    let inc = (seq << 1) | 1
    let s0 = _pcg_advance(0, inc)
    let s1 = s0 + seed
    let s2 = _pcg_advance(s1, inc)
    let rng = {}
    rng["s"] = s2
    rng["i"] = inc
    rng

// ── pcg_next ─────────────────────────────────────────────────────────────────
// Advance the generator and return the next 32-bit output word (0..2^32-1).
// The output is computed from the state BEFORE advancing (pre-advance output),
// which matches the reference pcg_setseq_64_xsh_rr_32 specification.
fn pcg_next(rng: dict) -> int
    let s = rng["s"]
    let inc = rng["i"]
    let out = _pcg_output(s)
    let ns = _pcg_advance(s, inc)
    rng["s"] = ns
    out

// ── pcg_next_range ───────────────────────────────────────────────────────────
// Return a uniform integer in [0, n-1].
// Uses simple modulo reduction.  For n << 2^32 the bias is negligible;
// a debiased rejection-sampling path would need float or multi-word ops.
fn pcg_next_range(rng: dict, n: int) -> int
    let v = pcg_next(rng)
    let r = v % n
    r
