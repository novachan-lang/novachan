// std/random/sample -- Deterministic seeded sampling via a self-contained 64-bit LCG.
//
// The LCG is embedded privately (no external PRNG dependency):
//   state = (state * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF
//
// All functions accept a seed (any int) and return a result directly.
// The seed is the initial LCG input; each function advances the state
// internally as many times as needed.
//
// Public API:
//   rs_uniform_int(lo, hi, seed) -> int
//       Uniformly random integer in [lo, hi] inclusive.
//       If lo == hi returns lo.  If lo > hi behaviour is undefined.
//
//   rs_weighted(items, weights, seed) -> value
//       Choose one item with probability proportional to its integer weight.
//       Items with weight 0 are never chosen.  weights must sum > 0.
//       items and weights must be same length.
//
//   rs_reservoir(items, k, seed) -> list
//       Reservoir sampling (Vitter Algorithm R): k items chosen without
//       replacement from items.  Result length = min(k, len(items)).
//       Order within the reservoir is deterministic but unspecified.
//
//   rs_with_replacement(items, k, seed) -> list
//       k picks with replacement (repeats allowed).  Length always = k.
//
// GOTCHAS (NOVA):
//   * >> is ARITHMETIC; use & mask for unsigned right-shift semantics.
//   * Large int literals are fine; the LCG multiplier fits in i64 signed.
//   * 0xFFFFFFFFFFFFFFFF = -1 as signed i64; we use & to stay in range.
//   * '/' on two ints is INTEGER division.
//   * No multi-line list/dict literals.
//   * Float-vs-int compare is unsound; we use only int arithmetic here.

// ── private: LCG constants ───────────────────────────────────────────────────
// Knuth's 64-bit LCG (same multiplier as PCG family).
// INC is odd (required for full period).
let _rs_MULT = 6364136223846793005
let _rs_INC  = 1442695040888963407
let _rs_MASK = 9223372036854775807   // 0x7FFFFFFFFFFFFFFF — keeps result non-negative

// ── private: one LCG step ────────────────────────────────────────────────────
// Returns a non-negative 63-bit integer.
fn _rs_step(state: int) -> int
    // NOVA wraps 64-bit multiply naturally (i64 signed overflow wraps in LLVM
    // codegen with NOVA's no-nsw policy).  The & MASK strips the sign bit.
    let s = state * _rs_MULT + _rs_INC
    s & _rs_MASK

// ── rs_uniform_int ────────────────────────────────────────────────────────────
// Uniform int in [lo, hi] inclusive.  Single LCG step.
fn rs_uniform_int(lo: int, hi: int, seed: int) -> int
    if lo == hi
        return lo
    let s = _rs_step(seed)
    let span = hi - lo + 1
    let r = s % span
    lo + r

// ── rs_weighted ───────────────────────────────────────────────────────────────
// Choose one item proportional to its integer weight.
// Items with weight 0 are never chosen.
fn rs_weighted(items: list, weights: list, seed: int)
    let total = 0
    let wi = 0
    while wi < len(weights)
        total = total + weights[wi]
        wi = wi + 1
    // Single LCG step; pick a value in [0, total)
    let s = _rs_step(seed)
    let pick = s % total
    let cumulative = 0
    let i = 0
    while i < len(items)
        cumulative = cumulative + weights[i]
        if pick < cumulative
            return items[i]
        i = i + 1
    // Fallback (unreachable if weights sum > 0).
    items[len(items) - 1]

// ── rs_reservoir ─────────────────────────────────────────────────────────────
// Reservoir sampling (Vitter Algorithm R) — k items without replacement.
// Advances LCG once per element processed after the initial k.
fn rs_reservoir(items: list, k: int, seed: int) -> list
    let n = len(items)
    let take = k
    if take > n
        take = n
    // Fill reservoir with first `take` items.
    let reservoir = []
    let i = 0
    while i < take
        reservoir.push(items[i])
        i = i + 1
    // Process remaining items: item i has probability k/(i+1) of entering.
    let state = seed
    while i < n
        state = _rs_step(state)
        let j = state % (i + 1)
        if j < take
            reservoir[j] = items[i]
        i = i + 1
    reservoir

// ── rs_with_replacement ───────────────────────────────────────────────────────
// k picks with replacement.  Advances LCG once per pick.
fn rs_with_replacement(items: list, k: int, seed: int) -> list
    let n = len(items)
    let out = []
    let state = seed
    let i = 0
    while i < k
        state = _rs_step(state)
        let idx = state % n
        out.push(items[idx])
        i = i + 1
    out
