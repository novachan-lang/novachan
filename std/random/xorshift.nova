// std/random/xorshift -- xorshift64 PRNG with dict-embedded state.
//
// All state lives in a dict with a single key "s" (int, always non-negative).
// The generator is fully deterministic: same seed -> same sequence everywhere.
//
// Algorithm: xorshift64 (Marsaglia 2003)
//   s ^= s << 13
//   s ^= s >> 7          // arithmetic shift -- safe because s is always >=0
//   s ^= s << 17
//   result masked to 63 bits (0x7FFFFFFFFFFFFFFF) to stay non-negative in i64
//
// NOVA ARITHMETIC NOTES:
//   * >> is arithmetic (sign-extending).  We mask to 63 bits after every step
//     so s is ALWAYS non-negative; arithmetic >> then behaves like logical >>.
//   * 0xFFFFFFFFFFFFFFFF in NOVA i64 == -1; AND with it is identity.
//     We therefore mask to 0x7FFFFFFFFFFFFFFF (clear sign bit) instead.
//   * Integer division is truncating.  xs_float multiplies by 1.0 first.
//   * No && / || in NOVA -- use 'and' / 'or' or nested if.
//
// Public API:
//   xs_new(seed)        -> dict   create a new PRNG state dict  {"s": <int>}
//   xs_next(x)          -> int    advance state, return next int in [0, 2^63)
//   xs_range(x, lo, hi) -> int    next int in [lo, hi] inclusive
//   xs_float(x)         -> float  next float in [0.0, 1.0)
//   xs_bool(x)          -> int    0 or 1 (uniform fair coin)

// Private tag: _xs_
// All private helpers prefixed _xs_ to avoid cross-module link collisions.

// _xs_M63: 2^63 - 1 used as the non-negative mask.
// We cannot write 0x7FFFFFFFFFFFFFFF as a literal constant easily, but
// we can compute it once inside each function (NOVA has no module-level const).

fn _xs_step(s: int) -> int
    let m63 = 9223372036854775807
    let a = s ^ (s << 13)
    let b = a & m63
    let c = b ^ (b >> 7)
    let d = c & m63
    let e = d ^ (d << 17)
    e & m63

// ── xs_new ───────────────────────────────────────────────────────────────────
// Create a new xorshift64 state dict.
// seed=0 is forbidden by xorshift (would stay 0 forever); we substitute 1.
fn xs_new(seed: int) -> dict
    let s = 1 if seed == 0 else seed
    {"s": s}

// ── xs_next ──────────────────────────────────────────────────────────────────
// Advance the PRNG state in-place and return the next non-negative int.
// The state dict x["s"] is updated.
fn xs_next(x: dict) -> int
    let s = x["s"]
    let ns = _xs_step(s)
    x["s"] = ns
    ns

// ── xs_range ─────────────────────────────────────────────────────────────────
// Return a uniformly distributed int in [lo, hi] inclusive.
// Requires lo <= hi; behaviour undefined if hi < lo.
fn xs_range(x: dict, lo: int, hi: int) -> int
    let v = xs_next(x)
    let span = hi - lo + 1
    let r = v % span
    lo + r

// ── xs_float ─────────────────────────────────────────────────────────────────
// Return a float in [0.0, 1.0).
// Divides the raw int (in [0, 2^63)) by 2^63 using floating-point arithmetic.
// We must NOT do integer division; multiply by 1.0 first.
fn xs_float(x: dict) -> float
    let v = xs_next(x)
    let divisor = 9223372036854775808.0
    let fv = v * 1.0
    fv / divisor

// ── xs_bool ──────────────────────────────────────────────────────────────────
// Return 0 or 1 with equal probability.
fn xs_bool(x: dict) -> int
    let v = xs_next(x)
    v % 2
