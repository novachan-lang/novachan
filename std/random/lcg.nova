// std/random/lcg -- Linear Congruential Generator: MINSTD and glibc variants.
//
// MINSTD (Park-Miller, 1988):
//   state = (state * 16807) mod 2147483647   (Mersenne prime M31)
//   Output: state, always in [1, 2147483646]
//   Period: 2^31 - 2 (full period minus the zero state)
//
// glibc rand():
//   state = _m32(state * 1103515245 + 12345)
//   Output: the full 32-bit state word, in [0, 4294967295]
//   Period: 2^32
//
// API:
//   minstd_seed(seed)        -> dict   new MINSTD generator seeded at seed
//   minstd_next(rng)         -> int    advance + return next value (1..2147483646)
//   glibc_seed(seed)         -> dict   new glibc-rand generator
//   glibc_next(rng)          -> int    advance + return next 32-bit state word
//   lcg_next_range(rng, n)   -> int    uniform in [0, n-1]; works for both rngs
//
// State dict layout:
//   rng["s"]   = current state (int)
//   rng["t"]   = generator kind: 1 = MINSTD, 2 = glibc
//
// Both generators mutate state in place inside _next functions.
//
// NOVA ARITHMETIC NOTES:
//   NOVA i64 wraps mod 2^64 on + and * -- exactly what glibc LCG needs.
//   _m32 masks to 0xFFFFFFFF to keep the state in 32-bit unsigned range.
//   MINSTD uses modular reduction mod 2147483647 (a Mersenne prime);
//   the multiply is safe: 16807 * 2147483646 < 2^63 so no overflow before mod.

// ── _m32 ─────────────────────────────────────────────────────────────────────
// Mask a value to the low 32 bits (0..4294967295).
fn _m32(x: int) -> int
    return x & 0xFFFFFFFF

// ── MINSTD (Park-Miller) ──────────────────────────────────────────────────────

// minstd_seed: create a new MINSTD generator.
// seed is clamped into [1, 2147483646]; zero and M31 itself are invalid for
// Park-Miller (zero stays zero; M31 mod M31 = 0).  We substitute 1 for both.
fn minstd_seed(seed: int) -> dict
    let s = seed % 2147483647
    if s <= 0
        s = 1
    let rng = {"s": s, "t": 1}
    return rng

// minstd_next: advance MINSTD state in-place, return next value in [1, 2147483646].
fn minstd_next(rng: dict) -> int
    let s = rng["s"]
    let ns = (s * 16807) % 2147483647
    rng["s"] = ns
    return ns

// ── glibc rand ────────────────────────────────────────────────────────────────

// glibc_seed: create a new glibc-rand generator.
// Any 32-bit seed value is valid (including 0).
fn glibc_seed(seed: int) -> dict
    let rng = {"s": _m32(seed), "t": 2}
    return rng

// glibc_next: advance glibc state in-place, return next 32-bit state word [0..4294967295].
// Formula: state = (state * 1103515245 + 12345) & 0xFFFFFFFF
// The traditional rand() output is (state >> 16) & 0x7FFF but we return the
// raw state word so callers have the full 32 bits of entropy available.
fn glibc_next(rng: dict) -> int
    let s = rng["s"]
    let ns = _m32(s * 1103515245 + 12345)
    rng["s"] = ns
    return ns

// ── lcg_next_range ────────────────────────────────────────────────────────────
// Uniform integer in [0, n-1].  Works for both MINSTD and glibc state dicts.
// Dispatches on rng["t"] to call the correct _next function for the generator
// type, so state evolution is always correct regardless of which rng is passed.
// Simple modulo reduction: acceptable for LCGs (non-cryptographic use).
// n must be >= 1.
fn lcg_next_range(rng: dict, n: int) -> int
    let kind = rng["t"]
    let raw = 0
    if kind == 1
        raw = minstd_next(rng)
    else
        raw = glibc_next(rng)
    if raw < 0
        raw = -raw
    return raw % n
