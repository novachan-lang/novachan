// std/grammar/grammar_first — FIRST set computation via fixpoint iteration.
//
// FIRST(alpha) = set of terminals that can begin a string derived from alpha,
// plus "" (epsilon) if alpha =>* epsilon.
//
// TERMINAL rule: FIRST(a) = {a}  for any terminal a.
// NONTERMINAL rule: FIRST(N) = union of FIRST(rhs) for each production N->rhs.
// SEQUENCE rule: FIRST(X1 X2 ... Xk):
//   Include FIRST(Xi)\{""} for each i until Xi is not nullable; include "" iff all nullable.
//
// Epsilon marker: the string "".
// Nonterminal: exactly one uppercase letter A-Z.
//
// All public functions are prefixed grf_.

// Return 1 if sym is a nonterminal (single uppercase A-Z), else 0.
fn grf_is_nonterminal(sym) -> int
    if len(sym) != 1
        return 0
    let c = sym[0]
    if c >= "A" and c <= "Z"
        return 1
    return 0

// Helper: sort a list of strings in-place (insertion sort, ascending).
fn grf_sort_strings(lst)
    let n = len(lst)
    for i in 1..n
        let key = lst[i]
        let j = i - 1
        while j >= 0 and lst[j] > key
            lst[j + 1] = lst[j]
            j -= 1
        lst[j + 1] = key

// Helper: insert s into a sorted+deduped list in-place.
fn grf_insert_sorted(lst, s)
    let n = len(lst)
    let lo = 0
    let hi = n
    while lo < hi
        let mid = (lo + hi) / 2
        if lst[mid] < s
            lo = mid + 1
        else
            hi = mid
    if lo < n and lst[lo] == s
        return 0
    push(lst, s)
    let i = n
    while i > lo
        lst[i] = lst[i - 1]
        i -= 1
    lst[lo] = s
    return 0

// Helper: return 1 if sorted list lst contains s, else 0.
fn grf_list_contains(lst, s) -> int
    let lo = 0
    let hi = len(lst) - 1
    while lo <= hi
        let mid = (lo + hi) / 2
        if lst[mid] == s
            return 1
        if lst[mid] < s
            lo = mid + 1
        else
            hi = mid - 1
    return 0

// Compute nullable set: dict NT->1 for all nullable NTs (fixpoint).
fn grf_nullable_dict(prods) -> dict
    let nset = {}
    let changed = 1
    while changed == 1
        changed = 0
        for i in 0..len(prods)
            let prod = prods[i]
            let lhs = prod[0]
            let rhs = prod[1]
            if lhs in nset == 0
                let all_null = 1
                let j = 0
                while j < len(rhs)
                    if rhs[j] in nset == 0
                        all_null = 0
                    j += 1
                if all_null == 1
                    nset[lhs] = 1
                    changed = 1
    return nset

// Compute FIRST sets: returns a dict NT -> sorted list of strings (including "" for epsilon).
// Uses fixpoint iteration over all productions.
fn grf_compute_first_dict(prods) -> dict
    let nset = grf_nullable_dict(prods)
    // Initialize FIRST dict: one entry per NT lhs, starting with empty list.
    let fsets = {}
    for i in 0..len(prods)
        let lhs = prods[i][0]
        if lhs in fsets == 0
            fsets[lhs] = []
    // Fixpoint: iterate until no FIRST set grows.
    let changed = 1
    while changed == 1
        changed = 0
        for pi in 0..len(prods)
            let prod = prods[pi]
            let lhs = prod[0]
            let rhs = prod[1]
            let fset = fsets[lhs]
            // Process RHS: thread through nullable prefixes.
            let all_nullable = 1
            let k = 0
            while k < len(rhs)
                let sym = rhs[k]
                if grf_is_nonterminal(sym) == 1
                    // Add FIRST(sym) \ {""} to fset.
                    if sym in fsets == 1
                        let sf = fsets[sym]
                        let si = 0
                        while si < len(sf)
                            if sf[si] != ""
                                if grf_list_contains(fset, sf[si]) == 0
                                    grf_insert_sorted(fset, sf[si])
                                    changed = 1
                            si += 1
                    // If sym is not nullable, stop threading.
                    if sym in nset == 0
                        all_nullable = 0
                        k = len(rhs)
                    else
                        k += 1
                else
                    // Terminal: add it and stop threading.
                    if grf_list_contains(fset, sym) == 0
                        grf_insert_sorted(fset, sym)
                        changed = 1
                    all_nullable = 0
                    k = len(rhs)
            // If entire RHS is nullable (or empty), add "" to FIRST(lhs).
            if all_nullable == 1
                if grf_list_contains(fset, "") == 0
                    grf_insert_sorted(fset, "")
                    changed = 1
            fsets[lhs] = fset
    return fsets

// Return FIRST set of a single symbol sym as a sorted list.
// For a terminal: returns [sym].
// For a nonterminal: looks up in the computed first dict.
// For epsilon "": returns [""].
fn grf_first_symbol(prods, sym) -> list
    if sym == ""
        let r = []
        push(r, "")
        return r
    if grf_is_nonterminal(sym) == 0
        // Terminal: FIRST is just itself.
        let r = []
        push(r, sym)
        return r
    let fsets = grf_compute_first_dict(prods)
    if sym in fsets == 1
        return fsets[sym]
    return []

// Return FIRST set of a sequence syms as a sorted list.
// Includes "" iff the entire sequence is nullable.
fn grf_first_seq(prods, syms) -> list
    let nset = grf_nullable_dict(prods)
    let fsets = grf_compute_first_dict(prods)
    let result = []
    let all_nullable = 1
    let i = 0
    while i < len(syms)
        let sym = syms[i]
        if sym == ""
            // Epsilon symbol in sequence — contributes "" and is nullable.
            i += 1
        else
            if grf_is_nonterminal(sym) == 1
                // Add FIRST(sym) \ {""} to result.
                if sym in fsets == 1
                    let sf = fsets[sym]
                    for j in 0..len(sf)
                        if sf[j] != ""
                            grf_insert_sorted(result, sf[j])
                if sym in nset == 0
                    all_nullable = 0
                    i = len(syms)
                else
                    i += 1
            else
                // Terminal: add it and stop.
                grf_insert_sorted(result, sym)
                all_nullable = 0
                i = len(syms)
    if all_nullable == 1
        grf_insert_sorted(result, "")
    return result

// Return list of [nt, firstset] pairs for every nonterminal in prods.
// firstset is a sorted list of strings (terminals + "" for epsilon).
fn grf_first_sets(prods) -> list
    let fsets = grf_compute_first_dict(prods)
    let ks = keys(fsets)
    grf_sort_strings(ks)
    let result = []
    for i in 0..len(ks)
        let pair = []
        push(pair, ks[i])
        push(pair, fsets[ks[i]])
        push(result, pair)
    return result
