// std/grammar/grammar_regular.nova — Regular grammar utilities.
//
// A SYMBOL is a string.  NONTERMINAL iff it is a single uppercase letter A..Z.
// A PRODUCTION is [lhs, rhs] where rhs is a list of symbols.
// A GRAMMAR is a list of productions.
//
// Public API (prefix grr_):
//   grr_is_right_linear(prods)         -> bool  every rhs = terminals* then opt-NT at END
//   grr_is_left_linear(prods)          -> bool  every rhs = opt-NT at START then terminals*
//   grr_to_nfa(prods, start)           -> list  [states, start_state, accept_states, transitions]
//                                                where transition = [from, symbol, to]
//   grr_nfa_accepts(nfa, tokens)       -> bool  simulate NFA (no epsilon) on token list
//
// Internal helpers: prefix _grr_

// _grr_is_nt: true iff sym is a single uppercase letter A..Z.
fn _grr_is_nt(sym) -> bool
    if len(sym) != 1
        return false
    let c = sym[0]
    if c >= "A" and c <= "Z"
        return true
    return false

// _grr_str_in: true iff val is in the list.
fn _grr_str_in(lst, val) -> bool
    for i in 0..len(lst)
        if lst[i] == val
            return true
    return false

// grr_is_right_linear: every production rhs must be a (possibly empty) sequence of
// terminals followed by AT MOST ONE nonterminal at the END.
// Formally: rhs = t1 t2 ... tk [NT]  where all ti are terminals.
fn grr_is_right_linear(prods) -> bool
    for i in 0..len(prods)
        let rhs = prods[i][1]
        // Scan: all symbols must be terminals except the last which may be an NT.
        let n = len(rhs)
        let j = 0
        while j < n
            let sym = rhs[j]
            if _grr_is_nt(sym)
                // NT is OK only if it is the last symbol.
                if j != n - 1
                    return false
            j += 1
    return true

// grr_is_left_linear: every production rhs must be a (possibly empty) sequence starting
// with AT MOST ONE nonterminal at the START, followed only by terminals.
// Formally: rhs = [NT] t1 t2 ... tk  where all ti are terminals.
fn grr_is_left_linear(prods) -> bool
    for i in 0..len(prods)
        let rhs = prods[i][1]
        let n = len(rhs)
        let j = 0
        while j < n
            let sym = rhs[j]
            if _grr_is_nt(sym)
                // NT is OK only if it is the first symbol.
                if j != 0
                    return false
            j += 1
    return true

// grr_to_nfa: convert a right-linear grammar to an NFA.
// Returns [states_list, start_state, accept_states_list, transitions_list]
// where each transition is [from_state, symbol, to_state].
//
// Construction (textbook):
//   - Each NT becomes a state.
//   - An accept state "ACCEPT" is introduced.
//   - For production A -> t1 t2 ... tk B:
//       chain: A -t1-> q1 -t2-> q2 ... -tk-> B  (fresh intermediate states)
//   - For production A -> t1 t2 ... tk (no trailing NT):
//       chain: A -t1-> q1 ... -tk-> ACCEPT
//   - For epsilon production A -> []:
//       A is itself accepting (add A to accept_states).
fn grr_to_nfa(prods, start) -> list
    let states = []
    let accept_states = []
    let transitions = []
    let accept_name = "ACCEPT"
    // Collect all NT states from grammar LHS.
    for i in 0..len(prods)
        let lhs = prods[i][0]
        if not _grr_str_in(states, lhs)
            states.push(lhs)
    // Add the special accept state.
    if not _grr_str_in(states, accept_name)
        states.push(accept_name)
    accept_states.push(accept_name)
    // Fresh state counter for intermediate chain states.
    let fresh_ctr = 0
    // Process each production.
    for pi in 0..len(prods)
        let prod = prods[pi]
        let lhs = prod[0]
        let rhs = prod[1]
        let n = len(rhs)
        if n == 0
            // A -> epsilon: A is also an accepting state.
            if not _grr_str_in(accept_states, lhs)
                accept_states.push(lhs)
        else
            // Check if last symbol is NT.
            let last_is_nt = false
            let term_count = n
            if _grr_is_nt(rhs[n - 1])
                last_is_nt = true
                term_count = n - 1
            // Build chain: lhs -> q1 -> q2 -> ... -> target
            // where target = trailing NT if present, else accept_name.
            let cur_state = lhs
            let ti = 0
            while ti < term_count
                let sym = rhs[ti]
                // Determine next state.
                let next_state = ""
                if ti == term_count - 1
                    // Last terminal: next is trailing NT or ACCEPT.
                    if last_is_nt
                        next_state = rhs[n - 1]
                    else
                        next_state = accept_name
                else
                    // Intermediate: create fresh state.
                    let fresh_name = "_q" + str(fresh_ctr)
                    fresh_ctr += 1
                    if not _grr_str_in(states, fresh_name)
                        states.push(fresh_name)
                    next_state = fresh_name
                let tr = [cur_state, sym, next_state]
                transitions.push(tr)
                cur_state = next_state
                ti += 1
            // If rhs was ALL NT (term_count == 0) and last is NT: A -> B.
            // This is a UNIT production (A -> B), valid in right-linear grammars
            // (rhs = terminals* then opt-NT, with zero terminals).  Emit an EPSILON
            // transition A --""--> B; grr_nfa_accepts takes the epsilon-closure so it
            // is traversed correctly (also handles unit chains A->B->C and A->B where
            // B is accepting).  Epsilon is the empty-string symbol "" (real terminals
            // are always non-empty tokens, so there is no collision).
            if term_count == 0 and last_is_nt
                let eps_tr = [lhs, "", rhs[n - 1]]
                transitions.push(eps_tr)
    let result = [states, start, accept_states, transitions]
    return result

// _grr_eps_closure: epsilon-closure of a state set over the ""-labelled transitions.
// Fixpoint: repeatedly add every B reachable from some state in the set via A --""--> B.
fn _grr_eps_closure(transitions, stateset) -> list
    let out = []
    let i = 0
    while i < len(stateset)
        if not _grr_str_in(out, stateset[i])
            out.push(stateset[i])
        i += 1
    let changed = true
    while changed
        changed = false
        let oi = 0
        while oi < len(out)
            let st = out[oi]
            for tri in 0..len(transitions)
                let tr = transitions[tri]
                if tr[0] == st and tr[1] == ""
                    if not _grr_str_in(out, tr[2])
                        out.push(tr[2])
                        changed = true
            oi += 1
    return out

// grr_nfa_accepts: simulate the NFA on a list of tokens.  Uses on-the-fly subset
// construction (NFA may be nondeterministic) with epsilon-closure at each step so
// unit-production epsilon edges are followed.  Returns true iff some path reaches an
// accept state after consuming all tokens.
fn grr_nfa_accepts(nfa, tokens) -> bool
    let states_all = nfa[0]
    let start_state = nfa[1]
    let accept_states = nfa[2]
    let transitions = nfa[3]
    // Current state set: epsilon-closure of the start state.
    let cur = _grr_eps_closure(transitions, [start_state])
    // Process each token.
    for ti in 0..len(tokens)
        let tok = tokens[ti]
        let next = []
        let seen = {}
        // For each current state, find transitions on tok.
        let ci = 0
        while ci < len(cur)
            let st = cur[ci]
            // Scan transitions for (st, tok, ?).
            let tri = 0
            while tri < len(transitions)
                let tr = transitions[tri]
                if tr[0] == st
                    if tr[1] == tok
                        let to = tr[2]
                        if to not in seen
                            seen[to] = 1
                            next.push(to)
                tri += 1
            ci += 1
        // Epsilon-closure so unit-production edges are followed after each token.
        cur = _grr_eps_closure(transitions, next)
    // Accept if any current state is in accept_states.
    for ai in 0..len(accept_states)
        let ac = accept_states[ai]
        let ci2 = 0
        while ci2 < len(cur)
            if cur[ci2] == ac
                return true
            ci2 += 1
    return false
