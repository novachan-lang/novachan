// ============================================================================
// NOVA Standard Library — std/grammar/grammar_cyk
// ============================================================================
// CYK (Cocke-Younger-Kasami) recognition for grammars in Chomsky Normal Form.
//
// CNF constraint:
//   Every production is either  A -> B C  (two nonterminals)
//                            or  A -> a   (one terminal).
//   A nonterminal is a string whose first char is uppercase A-Z (and length >= 1).
//   A terminal is anything else (e.g., "a", "b", "id", "+").
//
// Productions are encoded as [lhs, rhs] where rhs is a list of strings.
// The DP table cell (i,j) holds a list of nonterminals that can derive
// tokens[i..j] (0-indexed, inclusive).  Lengths run from 1 to n.
//
// Public functions (prefix grcyk_):
//   grcyk_is_nonterminal(sym) -> bool(int)
//   grcyk_is_cnf(prods)       -> bool(int)  validate CNF shape
//   grcyk_table(cnf_prods, tokens) -> 2D list (table[i][j] = nonterminal list)
//   grcyk_recognize(cnf_prods, start, tokens) -> bool(int)
//
// Self-contained: imports nothing.
// ============================================================================

// grcyk_is_nonterminal: true iff sym is a nonempty string starting with A-Z.
fn grcyk_is_nonterminal(sym) -> int
    if len(sym) == 0
        return 0
    let c = slice(sym, 0, 1)
    if c >= "A" and c <= "Z"
        return 1
    return 0

// _grcyk_contains: true iff list lst contains string s.
fn _grcyk_contains(lst, s) -> int
    1 if s in lst else 0

// _grcyk_add: add s to lst if not already present (maintains deduplication).
fn _grcyk_add(lst, s)
    if s not in lst
        push(lst, s)

// grcyk_is_cnf: validate that every production is in CNF (A->BC or A->a).
// Returns 1 if valid CNF, 0 otherwise.
fn grcyk_is_cnf(prods) -> int
    let valid = 1
    for i in 0..len(prods)
        let prod = prods[i]
        let lhs = prod[0]
        let rhs = prod[1]
        // LHS must be a nonterminal
        if grcyk_is_nonterminal(lhs) == 0
            valid = 0
        // RHS must be exactly 1 terminal OR exactly 2 nonterminals
        let rlen = len(rhs)
        if rlen == 1
            // Must be a terminal
            if grcyk_is_nonterminal(rhs[0]) == 1
                valid = 0
        else if rlen == 2
            // Both must be nonterminals
            if grcyk_is_nonterminal(rhs[0]) == 0
                valid = 0
            if grcyk_is_nonterminal(rhs[1]) == 0
                valid = 0
        else
            // length 0 or >2 is not CNF
            valid = 0
    return valid

// grcyk_table: build the full CYK DP table.
// Returns table as a list of n rows, each row a list of n cells,
// each cell a list of nonterminal strings.
// table[i][j] (0-based, i=start, j=end inclusive, i<=j) is valid.
// Cells where i>j are empty lists (unused by algorithm).
fn grcyk_table(cnf_prods, tokens) -> list
    let n = len(tokens)
    // Build an n×n table of empty lists
    let table = [[[] for c in 0..n] for r in 0..n]
    if n == 0
        return table
    // Fill length-1 cells: token at position i
    for i in 0..n
        let tok = tokens[i]
        let cell = table[i][i]
        // Find all A -> tok productions
        for pi in 0..len(cnf_prods)
            let prod = cnf_prods[pi]
            let lhs = prod[0]
            let rhs = prod[1]
            if len(rhs) == 1 and rhs[0] == tok
                _grcyk_add(cell, lhs)
    // Fill larger lengths
    for length in 2..(n + 1)
        for si in 0..(n - length + 1)
            let ej = si + length - 1
            let cell = table[si][ej]
            // Split at k: si..k and k+1..ej
            for k in si..ej
                let left = table[si][k]
                let right = table[k + 1][ej]
                // Try every binary production A -> B C
                for pi in 0..len(cnf_prods)
                    let prod = cnf_prods[pi]
                    let lhs = prod[0]
                    let rhs = prod[1]
                    if len(rhs) == 2
                        let B = rhs[0]
                        let C = rhs[1]
                        if B in left and C in right
                            _grcyk_add(cell, lhs)
    return table

// grcyk_recognize: return 1 iff tokens is in the language generated by
// cnf_prods starting from nonterminal start.
fn grcyk_recognize(cnf_prods, start, tokens) -> int
    let n = len(tokens)
    if n == 0
        return 0
    let tbl = grcyk_table(cnf_prods, tokens)
    let top = tbl[0][n - 1]
    return 1 if start in top else 0
