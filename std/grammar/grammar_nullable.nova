// std/grammar/grammar_nullable — Nullable nonterminal computation via fixpoint.
//
// A nonterminal N is NULLABLE if N =>* epsilon (derives the empty string).
// Algorithm: fixpoint iteration. Start with empty set; add any NT whose
// some RHS is entirely composed of nullable symbols (or is epsilon []).
// Repeat until the set stops growing.
//
// Uses the same symbol convention as grammar_core:
//   Nonterminal = exactly one uppercase letter A-Z.
//   Epsilon = empty rhs list [].
//
// All public functions are prefixed grn_.

// Return 1 if sym is a nonterminal (single uppercase A-Z), else 0.
fn grn_is_nonterminal(sym) -> int
    if len(sym) != 1
        return 0
    let c = sym[0]
    if c >= "A" and c <= "Z"
        return 1
    return 0

// Return 1 if the nullable-dict nset contains symbol sym (nset maps NT->1).
fn grn_in_set(nset, sym) -> int
    if sym in nset
        return 1
    return 0

// Return 1 if every symbol in rhs list is in the nullable set nset.
// An empty rhs (epsilon) always returns 1.
fn grn_rhs_all_nullable(nset, rhs) -> int
    for j in 0..len(rhs)
        if grn_in_set(nset, rhs[j]) == 0
            return 0
    return 1

// Compute the set of nullable nonterminals for grammar prods via fixpoint.
// Returns a DICT mapping each nullable NT string -> 1.
fn grn_nullable_dict(prods) -> dict
    let nset = {}
    let changed = 1
    while changed == 1
        changed = 0
        for i in 0..len(prods)
            let prod = prods[i]
            let lhs = prod[0]
            let rhs = prod[1]
            if grn_in_set(nset, lhs) == 0
                if grn_rhs_all_nullable(nset, rhs) == 1
                    nset[lhs] = 1
                    changed = 1
    return nset

// Helper: sort a list of strings in-place (insertion sort).
fn grn_sort_strings(lst)
    let n = len(lst)
    for i in 1..n
        let key = lst[i]
        let j = i - 1
        while j >= 0 and lst[j] > key
            lst[j + 1] = lst[j]
            j -= 1
        lst[j + 1] = key

// Compute the nullable set for grammar prods.
// Returns a SORTED list of nullable nonterminal strings.
fn grn_nullable_set(prods) -> list
    let nset = grn_nullable_dict(prods)
    let ks = keys(nset)
    grn_sort_strings(ks)
    return ks

// Return 1 if a single symbol sym is nullable (terminal is never nullable).
// sym is nullable iff it is a nonterminal present in the nullable set.
fn grn_is_nullable(prods, sym) -> int
    if grn_is_nonterminal(sym) == 0
        return 0
    let nset = grn_nullable_dict(prods)
    return grn_in_set(nset, sym)

// Return 1 if the entire sequence syms derives epsilon.
// This holds iff every symbol in syms is individually nullable (or syms is empty).
fn grn_is_nullable_seq(prods, syms) -> int
    let nset = grn_nullable_dict(prods)
    return grn_rhs_all_nullable(nset, syms)
