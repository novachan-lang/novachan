// std/complex/complex_geometry.nova
// Exact integer 2D geometry via Gaussian integers [re, im].
// LEAF — imports nothing.
//
// Public API (prefix cxgeo_):
//   cxgeo_distance_sq(z1, z2)     -> int   |z1-z2|^2, exact
//   cxgeo_reflect_origin(z)        -> list  negate both components
//   cxgeo_collinear(z1, z2, z3)   -> bool  three points collinear (cross-product test)
//   cxgeo_midpoint(z1, z2)        -> list  (z1+z2) as integers (midpoint scaled by 2)

// cxgeo_distance_sq: squared Euclidean distance between z1 and z2, exact.
fn cxgeo_distance_sq(z1: list, z2: list) -> int
    let dx = z1[0] - z2[0]
    let dy = z1[1] - z2[1]
    return dx * dx + dy * dy

// cxgeo_reflect_origin: reflect z through the origin (negate both components).
fn cxgeo_reflect_origin(z: list) -> list
    return [0 - z[0], 0 - z[1]]

// cxgeo_collinear: true if z1, z2, z3 lie on a common line.
// Uses the 2D cross product of the difference vectors:
//   (z2-z1) x (z3-z1) = dx1*dy2 - dy1*dx2 == 0
fn cxgeo_collinear(z1: list, z2: list, z3: list) -> bool
    let dx1 = z2[0] - z1[0]
    let dy1 = z2[1] - z1[1]
    let dx2 = z3[0] - z1[0]
    let dy2 = z3[1] - z1[1]
    let cross = dx1 * dy2 - dy1 * dx2
    return cross == 0

// cxgeo_midpoint: returns z1+z2 (the midpoint scaled by 2), staying exact integer.
// The true midpoint is this result divided by 2; caller divides if needed.
fn cxgeo_midpoint(z1: list, z2: list) -> list
    return [z1[0] + z2[0], z1[1] + z2[1]]
