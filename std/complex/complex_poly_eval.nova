// std/complex/complex_poly_eval.nova
// Polynomial evaluation over the Gaussian integers (integer complex numbers).
// A complex number is a 2-element integer list [re, im].
// All arithmetic is exact (no floats).
// LEAF — imports nothing.
//
// Public API (prefix cxpe_):
//   cxpe_eval(coeffs, z)  -> [re, im]   evaluate sum(coeffs[k]*z^k) via Horner's method
//   cxpe_eval_at_i(coeffs) -> [re, im]  shorthand: cxpe_eval(coeffs, [0, 1])

// _cxpe_mul: exact integer complex multiplication
fn _cxpe_mul(a: list, b: list) -> list
    let re = a[0] * b[0] - a[1] * b[1]
    let im = a[0] * b[1] + a[1] * b[0]
    return [re, im]

// _cxpe_add_real: add a real integer coefficient to a complex [re, im]
fn _cxpe_add_real(z: list, c: int) -> list
    return [z[0] + c, z[1]]

// cxpe_eval: evaluate coeffs[0] + coeffs[1]*z + ... + coeffs[n-1]*z^(n-1) at z
// Uses Horner's method from the highest-degree term downward.
// coeffs must be non-empty; z is a complex [re, im].
fn cxpe_eval(coeffs: list, z: list) -> list
    let n = len(coeffs)
    let i = n - 1
    let acc = [coeffs[i], 0]
    i = i - 1
    while i >= 0
        acc = _cxpe_mul(acc, z)
        acc = _cxpe_add_real(acc, coeffs[i])
        i = i - 1
    return acc

// cxpe_eval_at_i: evaluate polynomial at the imaginary unit i = [0, 1]
fn cxpe_eval_at_i(coeffs: list) -> list
    return cxpe_eval(coeffs, [0, 1])
