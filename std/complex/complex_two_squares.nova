// std/complex/complex_two_squares.nova — Two-squares decomposition: n = a^2 + b^2.
// LEAF — imports NOTHING.
//
// A non-negative integer n is a sum of two integer squares iff in the prime factorisation
// of n, every prime p ≡ 3 (mod 4) occurs to an even power.
// We use trial iteration over a from 0 up to floor(sqrt(n/2)) to find representations.
//
// Public API (prefix cx2_):
//   cx2_can(n)                   -> bool   n >= 0 can be written as a^2 + b^2
//   cx2_represent(n)             -> list   [a, b] with a<=b, a^2+b^2=n, smallest a; [-1,-1] if impossible
//   cx2_count_representations(n) -> int    number of pairs [a,b] with 0<=a<=b, a^2+b^2=n

// _cx2_isqrt — integer square root: largest k with k*k <= n.
fn _cx2_isqrt(n: int) -> int
    if n <= 0
        return 0
    let k = n
    let k2 = (k + 1) / 2
    while k2 < k
        k = k2
        k2 = (k + n / k) / 2
    k

// cx2_can — true iff n >= 0 can be expressed as a sum of two integer squares.
// Uses the characterisation theorem: factor out every prime p≡3 mod 4; each must appear
// with even exponent. Implemented by trial from a=0..isqrt(n/2) for efficiency.
fn cx2_can(n: int) -> bool
    if n < 0
        return false
    if n == 0
        return true
    let a = 0
    let lim = _cx2_isqrt(n / 2)
    while a <= lim
        let b2 = n - a * a
        let b = _cx2_isqrt(b2)
        if b * b == b2
            return true
        a = a + 1
    false

// cx2_represent — find [a, b] with 0<=a<=b and a^2+b^2=n with smallest a.
// Returns [-1,-1] if n is not a sum of two squares.
fn cx2_represent(n: int) -> list
    if n < 0
        let bad = []
        push(bad, 0 - 1)
        push(bad, 0 - 1)
        return bad
    if n == 0
        let z = []
        push(z, 0)
        push(z, 0)
        return z
    let a = 0
    let lim = _cx2_isqrt(n / 2)
    while a <= lim
        let b2 = n - a * a
        let b = _cx2_isqrt(b2)
        if b * b == b2
            let out = []
            push(out, a)
            push(out, b)
            return out
        a = a + 1
    // also try a == b case (a = b = sqrt(n/2) when n is even and n/2 is a perfect square)
    // already covered since lim = isqrt(n/2) and we iterate a <= lim
    let bad2 = []
    push(bad2, 0 - 1)
    push(bad2, 0 - 1)
    bad2

// cx2_count_representations — count pairs [a,b] with 0<=a<=b and a^2+b^2=n.
fn cx2_count_representations(n: int) -> int
    if n < 0
        return 0
    if n == 0
        return 1
    let count = 0
    let a = 0
    let lim = _cx2_isqrt(n / 2)
    while a <= lim
        let b2 = n - a * a
        let b = _cx2_isqrt(b2)
        if b * b == b2
            count = count + 1
        a = a + 1
    // special case: if a = b = sqrt(n/2) we haven't double-counted since a <= lim = b
    // but we must handle a=b exactly once — the while loop already does (a runs up to lim=b)
    count
