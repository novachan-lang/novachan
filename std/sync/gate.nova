// std/sync/gate — open/close flow-control valve
//
// WHAT:
//   A level-triggered valve: while closed, any number of callers block in
//   gate_wait; gate_open releases all of them (current and future, until
//   gate_close again). This is event_flag under flow-control naming with the
//   polarity flipped (starts CLOSED, "open" is the pass-through state) —
//   kept as its own module because "gate" is the idiomatic vocabulary for
//   pipeline/flow-control code (pause/resume a producer, admission control)
//   where "event flag" reads oddly.
//
// NOVA WAY:
//   A struct field guarded by a mutex (std/sync/mutex) for open/close;
//   gate_wait is a cooperative poll (`sleep(0)` yields the green task/
//   carrier) on the open flag — level-triggered, so a caller arriving after
//   the gate is already open returns immediately, no missed-wakeup window.
//
// CAUTION:
//   • gate_wait on a gate that is never opened blocks forever.
//   • Toggling open/close rapidly can race a waiter that hasn't polled yet
//     (same level-triggered caveat as event_flag — a gate reports "was this
//     open when you last checked", not a queued edge transition).
//
// FIELD NAMING: fields are prefixed `gate_` and kept globally unique across
// ALL std/sync struct types — see std/sync/barrier.nova's header for why
// (a real compiler defect resolves struct field writes by name, not by
// (type, name), so two co-declared struct types sharing a field name can
// miscompile). Do not de-prefix until that upstream bug is fixed+reverified.
import std/sync/mutex

type Gate
    gate_is_open: int
    gate_m: any

// gate_new() -> Gate
//   Creates a new gate, starting CLOSED.
fn gate_new()
    return Gate(0, mutex_new())

// gate_open(g)
//   Opens the gate. Releases every current and future gate_wait caller.
fn gate_open(g)
    lock(g.gate_m)
    g.gate_is_open = 1
    unlock(g.gate_m)

// gate_close(g)
//   Closes the gate. Future gate_wait callers block again.
fn gate_close(g)
    lock(g.gate_m)
    g.gate_is_open = 0
    unlock(g.gate_m)

// gate_wait(g)
//   Blocks while the gate is closed. Returns immediately if already open.
fn gate_wait(g)
    while g.gate_is_open == 0
        sleep(0)

// gate_is_open(g) -> bool
//   Non-blocking check of the current gate state.
fn gate_is_open(g)
    return g.gate_is_open
