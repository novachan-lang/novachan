// std/sync/event_flag — level-triggered, re-armable signal
//
// WHAT:
//   A boolean flag that any number of waiters can block on until it becomes
//   set (POSIX condition-variable-style "broadcast", .NET ManualResetEvent).
//   Unlike promise (single-assignment), an event flag can be set, cleared,
//   and set again any number of times.
//
// NOVA WAY:
//   The flag is a struct field guarded by a mutex (std/sync/mutex) for
//   set/clear; ef_wait is a cooperative poll (`sleep(0)` yields the green
//   task/carrier) on the flag. Level-triggered semantics fall out for free:
//   a waiter that calls ef_wait AFTER the flag is already set observes it on
//   its very first check and returns immediately — there is no "missed
//   wakeup" window the way there is with an edge-triggered channel send.
//
// CAUTION:
//   • ef_wait on a flag that is never set blocks forever.
//   • ef_clear immediately after ef_set can race a waiter that hasn't polled
//     yet — event_flag guarantees "the flag WAS set at some point you polled
//     it", not "you will observe every set/clear transition" (it is level-
//     triggered, not edge-triggered / queued).
//
// FIELD NAMING: fields are prefixed `ef_` and kept globally unique across
// ALL std/sync struct types — see std/sync/barrier.nova's header for why
// (a real compiler defect resolves struct field writes by name, not by
// (type, name), so two co-declared struct types sharing a field name can
// miscompile). Do not de-prefix until that upstream bug is fixed+reverified.
import std/sync/mutex

type EventFlag
    ef_is_set: int
    ef_m: any

// ef_new() -> EventFlag
//   Creates a new, initially-unset event flag.
fn ef_new()
    return EventFlag(0, mutex_new())

// ef_set(e)
//   Sets the flag. All current and future ef_wait callers observe it until
//   the next ef_clear.
fn ef_set(e)
    lock(e.ef_m)
    e.ef_is_set = 1
    unlock(e.ef_m)

// ef_clear(e)
//   Clears the flag (one-shot signals typically clear right after observing).
fn ef_clear(e)
    lock(e.ef_m)
    e.ef_is_set = 0
    unlock(e.ef_m)

// ef_is_set(e) -> bool
//   Non-blocking check of the current flag state.
fn ef_is_set(e)
    return e.ef_is_set

// ef_wait(e)
//   Blocks until the flag is set. Returns immediately if already set.
fn ef_wait(e)
    while e.ef_is_set == 0
        sleep(0)
