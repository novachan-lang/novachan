// ============================================================================
// NOVA Standard Library — std/time/weeknum
// Week numbering variants.  Pure integer arithmetic, no libc calls.
// All algorithms use Howard Hinnant's proleptic-Gregorian day serial.
// ============================================================================
//
// PUBLIC API:
//   day_of_year(y,m,d)       -> int  (1..366, ordinal day within year)
//   week_of_year_us(y,m,d)   -> int  (1..54, US convention: weeks start Sunday,
//                                      week containing Jan 1 = week 1)
//   week_of_year_iso(y,m,d)  -> int  (1..53, ISO 8601 week number;
//                                      week year may differ from y at boundaries)
//   week_of_month(y,m,d)     -> int  (1..6, 1-based week within month,
//                                      weeks start Monday)
//
// NOTES:
//   US week numbering: week 1 always contains Jan 1.  Every calendar day
//   belongs to exactly one week number 1..54 within the year.
//   ISO 8601: week 1 is the week containing the year's first Thursday.
//   The ISO week year (used internally) may differ from the calendar year for
//   dates in late December or early January.
//   Valid for years 1..9999 (keep KAT dates in 1970..2100 for full coverage).

// ── Private: Howard Hinnant proleptic-Gregorian day serial ───────────────────
// days = days since 1970-01-01 (may be negative for dates before 1970).

fn _days_from_civil(y, m, d)
    let yy = y
    if m <= 2
        yy = yy - 1
    let era = yy / 400
    let yoe = yy - era * 400
    let mp = m + 9
    if m > 2
        mp = m - 3
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

fn _civil_from_days(z0)
    let z = z0 + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if mp >= 10
        m = mp - 9
    if m <= 2
        y = y + 1
    return [y, m, d]

// _dow: civil day-of-week.  0=Sunday, 1=Monday, ..., 6=Saturday.
fn _dow(y, m, d)
    let n = _days_from_civil(y, m, d)
    return ((n % 7) + 11) % 7

fn _is_leap(y)
    if y % 400 == 0
        return true
    if y % 100 == 0
        return false
    return y % 4 == 0

// ── Private: days in month (needed for day_of_year) ──────────────────────────

fn _dim(y, m)
    if m == 2 and _is_leap(y)
        return 29
    if m == 2
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    return 31

// ── Private: ISO helpers ──────────────────────────────────────────────────────
// Convert civil dow (0=Sun..6=Sat) to ISO dow (1=Mon..7=Sun).
fn _to_iso_dow(cd)
    if cd == 0
        return 7
    return cd

// Day serial of Monday of ISO week 1 of year wy.
// Jan 4 of wy is always in ISO week 1.
fn _iso_w1_monday(wy)
    let dj = _days_from_civil(wy, 1, 4)
    let cd = _dow(wy, 1, 4)
    let id = _to_iso_dow(cd)
    return dj - (id - 1)

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// day_of_year: 1-based ordinal position of (y,m,d) within its year.
// Returns 1 for Jan 1 and 365 or 366 for Dec 31.
fn day_of_year(y, m, d) -> int
    let total = 0
    for i in 1..m
        total = total + _dim(y, i)
    return total + d

// week_of_year_us: US/simple week number, 1-based.
// Weeks start on Sunday.  Week 1 always contains January 1.
// Formula: week = (doy - 1 + dow_jan1) / 7 + 1
// where dow_jan1 is the Sunday-based day-of-week (0=Sun) of Jan 1.
// This gives a value in 1..54 (54 only reachable for Dec 31 when Jan 1 is Sat
// in a non-leap year — in practice the range is 1..53 for common dates).
fn week_of_year_us(y, m, d) -> int
    let doy = day_of_year(y, m, d)
    let dow_jan1 = _dow(y, 1, 1)
    return (doy - 1 + dow_jan1) / 7 + 1

// week_of_year_iso: ISO 8601 week number (1..53).
// Week 1 is the week containing the first Thursday of the year.
// The ISO week year (tracked internally) may differ from y for boundary dates
// (e.g. 2021-01-01 → ISO week 53 of 2020).
// This function returns ONLY the week number, not the week year.
fn week_of_year_iso(y, m, d) -> int
    let dn = _days_from_civil(y, m, d)
    let cd = _dow(y, m, d)
    let id = _to_iso_dow(cd)
    // Thursday of this ISO week determines the ISO week year.
    let thu_serial = dn + (4 - id)
    let thu_parts = _civil_from_days(thu_serial)
    let wy = thu_parts[0]
    // Monday of ISO week 1 of wy.
    let mon1 = _iso_w1_monday(wy)
    // Week number = full 7-day spans from mon1 to dn, plus 1.
    return (dn - mon1) / 7 + 1

// week_of_month: 1-based week number within the month, weeks start Monday.
// Week 1 is the partial week containing the 1st of the month.
// Formula: shift d by the Monday-based offset of the 1st of the month,
// then divide by 7, add 1.
// mon_offset: how many days from Monday the 1st of the month falls
//   (Mon=0, Tue=1, Wed=2, Thu=3, Fri=4, Sat=5, Sun=6).
fn week_of_month(y, m, d) -> int
    let dow1 = _dow(y, m, 1)
    let mon_offset = (dow1 + 6) % 7
    return (d - 1 + mon_offset) / 7 + 1
