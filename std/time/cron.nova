// ============================================================================
// NOVA Standard Library — std/time/cron
// Minimal cron expression matcher (5-field POSIX cron: minute hour dom month dow).
// ============================================================================
//
// PUBLIC API:
//   cron_parse(expr)                        -> dict  keys: "min","hour","dom","month","dow"
//   cron_field_matches(field, value) -> bool  field grammar: * | n | a,b,c | a-b | */n
//   cron_matches(expr, minute, hour, dom, month, dow) -> bool
//
// FIELD GRAMMAR:
//   *        always matches
//   */n      matches when value % n == 0
//   a-b      matches when a <= value <= b
//   a,b,...  matches when value equals any listed number
//   n        matches when value == n
//
// EXAMPLES:
//   cron_field_matches("*", 5)        -> true
//   cron_field_matches("*/15", 30)    -> true
//   cron_field_matches("10-20", 15)   -> true
//   cron_field_matches("1,3,5", 3)    -> true
//   cron_matches("0 12 * * *", 0, 12, 1, 1, 1) -> true
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _cron_trim: strip a single leading/trailing space (fields from split won't
// have extra whitespace if the input is well-formed, but guards anyway).
fn _cron_trim(s) -> string
    let n = len(s)
    if n == 0
        return s
    let start = 0
    let end_pos = n
    if s[0:1] == " "
        start = 1
    if end_pos > start and s[end_pos - 1:end_pos] == " "
        end_pos = end_pos - 1
    s[start:end_pos]

// _cron_str_to_int: parse decimal integer string to int.
// Delegates to native parse_int; returns -9999 for empty string (sentinel).
fn _cron_str_to_int(s) -> int
    let t = _cron_trim(s)
    if len(t) == 0
        return -9999
    parse_int(t)

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// cron_parse: split a 5-field cron expression into a dict.
// Fields: minute hour dom month dow (space-separated).
// Returns dict with keys "min","hour","dom","month","dow".
// Extra/missing fields are silently handled (missing fields default to "*").
fn cron_parse(expr) -> dict
    let parts = split(expr, " ")
    let result = {}
    let fmin = "*"
    let fhour = "*"
    let fdom = "*"
    let fmonth = "*"
    let fdow = "*"
    if len(parts) > 0
        fmin = _cron_trim(parts[0])
    if len(parts) > 1
        fhour = _cron_trim(parts[1])
    if len(parts) > 2
        fdom = _cron_trim(parts[2])
    if len(parts) > 3
        fmonth = _cron_trim(parts[3])
    if len(parts) > 4
        fdow = _cron_trim(parts[4])
    result["min"] = fmin
    result["hour"] = fhour
    result["dom"] = fdom
    result["month"] = fmonth
    result["dow"] = fdow
    result

// cron_field_matches: evaluate one cron field string against a concrete integer value.
// Supports: * | */n | a-b | a,b,c | n
fn cron_field_matches(field, value) -> bool
    // Wildcard — always matches.
    if field == "*"
        return true

    // Step syntax */n — matches when value % n == 0.
    if starts_with(field, "*/")
        let step_s = slice(field, 2, len(field))
        let step = _cron_str_to_int(step_s)
        if step <= 0
            return false
        return value % step == 0

    // List syntax a,b,c — matches when value equals any element.
    if contains(field, ",")
        let elems = split(field, ",")
        let i = 0
        let matched = false
        while i < len(elems) and not matched
            let elem_v = _cron_str_to_int(elems[i])
            if elem_v == value
                matched = true
            i = i + 1
        return matched

    // Range syntax a-b — matches when a <= value <= b.
    if contains(field, "-")
        let parts = split(field, "-")
        if len(parts) < 2
            return false
        let lo = _cron_str_to_int(parts[0])
        let hi = _cron_str_to_int(parts[1])
        return value >= lo and value <= hi

    // Plain integer — exact match.
    let exact = _cron_str_to_int(field)
    exact == value

// cron_matches: evaluate a full 5-field cron expression against concrete time components.
// Parameters:
//   expr   — cron expression string e.g. "0 12 * * *"
//   minute — 0-59
//   hour   — 0-23
//   dom    — 1-31 (day of month)
//   month  — 1-12
//   dow    — 0-6 (day of week, 0=Sunday)
fn cron_matches(expr, minute, hour, dom, month, dow) -> bool
    let fields = cron_parse(expr)
    let ok_min = cron_field_matches(fields["min"], minute)
    let ok_hour = cron_field_matches(fields["hour"], hour)
    let ok_dom = cron_field_matches(fields["dom"], dom)
    let ok_month = cron_field_matches(fields["month"], month)
    let ok_dow = cron_field_matches(fields["dow"], dow)
    ok_min and ok_hour and ok_dom and ok_month and ok_dow
