// ============================================================================
// NOVA Standard Library — std/time/isoweek
// ISO 8601 week-date arithmetic.  Pure integer arithmetic, no libc calls.
// All algorithms use Howard Hinnant's proleptic-Gregorian day serial.
// ============================================================================
//
// PUBLIC API:
//   iso_week_of(y,m,d)         -> list [week_year, week_num]
//   iso_week_num(y,m,d)        -> int   (1..53)
//   iso_week_year(y,m,d)       -> int   (may differ from y on boundary dates)
//   iso_weeks_in_year(y)       -> int   (52 or 53)
//   iso_week_to_date(wy,wn,id) -> list [y,m,d]  id = ISO dow (1=Mon..7=Sun)
//   iso_dow(y,m,d)             -> int   (1=Mon .. 7=Sun)
//
// NOTES:
//   ISO 8601 week 1 = the week containing the first Thursday of the year
//   (equivalently, the week containing January 4th).
//   Week starts on Monday; ends on Sunday.
//   Valid for years 1..9999 (keep KAT dates in 1970..2100 for full coverage).

// ── Private: Howard Hinnant day serial ───────────────────────────────────────
// days = days since 1970-01-01 (may be negative for dates before 1970).

fn _days_from_civil(y, m, d)
    let yy = y
    if m <= 2
        yy = yy - 1
    let era = yy / 400
    let yoe = yy - era * 400
    let mp = m + 9
    if m > 2
        mp = m - 3
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

fn _civil_from_days(z0)
    let z = z0 + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if mp >= 10
        m = mp - 9
    if m <= 2
        y = y + 1
    return [y, m, d]

fn _dow(y, m, d)
    let n = _days_from_civil(y, m, d)
    return ((n % 7) + 11) % 7

fn _is_leap(y)
    if y % 400 == 0
        return true
    if y % 100 == 0
        return false
    return y % 4 == 0

// ── Private: convert civil dow (0=Sun..6=Sat) → ISO dow (1=Mon..7=Sun) ──────

fn _to_iso_dow(civil_dow)
    if civil_dow == 0
        return 7
    return civil_dow

// ── Private: day serial of Monday of ISO week 1 in year wy ──────────────────
// Jan 4 of wy is always in ISO week 1. Monday of that week = Jan4 minus (iso_dow(Jan4)-1).

fn _w1_monday(wy)
    let dj = _days_from_civil(wy, 1, 4)
    let cd = _dow(wy, 1, 4)
    let id = _to_iso_dow(cd)
    return dj - (id - 1)

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// iso_dow: ISO day-of-week for (y, m, d).  1=Monday, 2=Tuesday, ..., 7=Sunday.
fn iso_dow(y, m, d) -> int
    let cd = _dow(y, m, d)
    return _to_iso_dow(cd)

// iso_week_of: returns [week_year, week_num] for the given date.
// The week year may differ from y for dates in late December or early January.
fn iso_week_of(y, m, d) -> list
    let dn = _days_from_civil(y, m, d)
    let id = iso_dow(y, m, d)
    // Thursday of the same ISO week — its civil year IS the ISO week year.
    let thu_serial = dn + (4 - id)
    let thu_parts = _civil_from_days(thu_serial)
    let wy = thu_parts[0]
    // Monday of ISO week 1 of wy
    let mon1 = _w1_monday(wy)
    // Week number = how many full 7-day spans from mon1 to dn, plus 1.
    let wn = (dn - mon1) / 7 + 1
    return [wy, wn]

// iso_week_year: the ISO week year (may differ from calendar year).
fn iso_week_year(y, m, d) -> int
    let parts = iso_week_of(y, m, d)
    return parts[0]

// iso_week_num: the ISO week number within the ISO week year.
fn iso_week_num(y, m, d) -> int
    let parts = iso_week_of(y, m, d)
    return parts[1]

// iso_weeks_in_year: 52 or 53.
// A year has 53 ISO weeks iff its last day (Dec 31) is in ISO week 53,
// i.e. Dec 28 of that year has iso_week_num == 53 (Dec 28 is always in
// the last ISO week of its calendar year).
fn iso_weeks_in_year(y) -> int
    // Dec 28 is always in the last week of year y (never crosses into y+1).
    let wn = iso_week_num(y, 12, 28)
    return wn

// iso_week_to_date: given ISO week year (wy), week number (wn), and ISO dow
// (id, 1=Mon..7=Sun), return [y, m, d] of that day.
// Clamps wn to valid range 1..iso_weeks_in_year(wy) for safety.
fn iso_week_to_date(wy, wn, id) -> list
    // Validate and clamp inputs
    let max_wn = iso_weeks_in_year(wy)
    let safe_wn = wn
    if safe_wn < 1
        safe_wn = 1
    if safe_wn > max_wn
        safe_wn = max_wn
    let safe_id = id
    if safe_id < 1
        safe_id = 1
    if safe_id > 7
        safe_id = 7
    // Monday of week 1 + (wn-1)*7 days + (id-1) days
    let mon1 = _w1_monday(wy)
    let target = mon1 + (safe_wn - 1) * 7 + (safe_id - 1)
    return _civil_from_days(target)
