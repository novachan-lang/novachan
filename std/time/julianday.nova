// ============================================================================
// NOVA Standard Library — std/time/julianday
// Julian Day Number (JDN) conversions, proleptic Gregorian calendar.
// Pure integer arithmetic.  Correct for all epochs including antiquity.
// ============================================================================
//
// PUBLIC API:
//   jd_from_date(y, m, d)                       -> int  (Julian Day Number)
//   jd_to_date(jdn)                             -> list [y, m, d]
//   jd_weekday(y, m, d)                         -> int  (0=Mon ... 6=Sun)
//   jd_days_between(y1,m1,d1, y2,m2,d2)        -> int  (signed, y2m2d2 - y1m1d1)
//
// ALGORITHMS:
//   jd_from_date: Meeus, "Astronomical Algorithms" 2nd ed., ch. 7 (integer).
//   jd_to_date:   Richards (2013) as given on Wikipedia "Julian day number"
//                 (proleptic Gregorian variant).
//
// REFERENCE VALUES (published):
//   jd_from_date(2000,  1,  1) = 2451545   (J2000.0 epoch)
//   jd_from_date(1970,  1,  1) = 2440588   (Unix epoch)
//   jd_from_date(-4713,11, 24) = 0         (Julian Period epoch)
//   jd_weekday(2000, 1, 1)     = 5         (Saturday)
//
// PRIVATE prefix: _jd_
// ============================================================================

// ── Floor-division helper ────────────────────────────────────────────────────
// NOVA '/' truncates toward zero.  For floor division (round toward -inf):
//   floor_div(a, b) = trunc_div(a, b) - 1  when remainder != 0 and signs differ

fn _jd_fdiv(a, b) -> int
    let q = a / b
    if (a < 0) != (b < 0)
        if a - q * b != 0
            return q - 1
    q

// ── jd_from_date ─────────────────────────────────────────────────────────────
// Converts a proleptic Gregorian (y, m, d) triple to a Julian Day Number.
// Formula: Meeus p. 61 (fully integer, no floating point).
//
//   a  = floor((14 - m) / 12)   [= 1 for Jan/Feb, 0 otherwise]
//   y' = y + 4800 - a
//   m' = m + 12*a - 3
//   JDN = d + floor((153*m'+2)/5) + 365*y' + floor(y'/4)
//           - floor(y'/100) + floor(y'/400) - 32045

fn jd_from_date(y, m, d) -> int
    let a = _jd_fdiv(14 - m, 12)
    let yp = y + 4800 - a
    let mp = m + 12 * a - 3
    let t1 = _jd_fdiv(153 * mp + 2, 5)
    let t2 = _jd_fdiv(yp, 4)
    let t3 = _jd_fdiv(yp, 100)
    let t4 = _jd_fdiv(yp, 400)
    d + t1 + 365 * yp + t2 - t3 + t4 - 32045

// ── jd_to_date ───────────────────────────────────────────────────────────────
// Inverse: given a JDN, returns [year, month, day] (proleptic Gregorian).
// Richards (2013) algorithm, proleptic Gregorian variant:
//
//   f = JDN + 1401 + floor(floor((4*JDN+274277)/146097)*3/4) - 38
//   e = 4*f + 3
//   g = mod(e, 1461) / 4          (NOVA int div = trunc, but e mod 1461 >= 0)
//   h = 5 * g + 2
//   D = mod(h, 153) / 5 + 1
//   M = mod(h/153 + 2, 12) + 1
//   Y = e/1461 - 4716 + (14-M)/12

fn jd_to_date(jdn) -> list
    let f = jdn + 1401 + _jd_fdiv(_jd_fdiv(4 * jdn + 274277, 146097) * 3, 4) - 38
    let e = 4 * f + 3
    // g: day of era within 4-year cycle; e mod 1461 is always >= 0 here
    let g = (e - _jd_fdiv(e, 1461) * 1461) / 4
    let h = 5 * g + 2
    let hdiv = h / 153
    let day = (h - hdiv * 153) / 5 + 1
    // month: (hdiv + 2) mod 12 + 1  (Richards formula, maps internal 0-11 to 1-12)
    let month = (hdiv + 2) - ((hdiv + 2) / 12) * 12 + 1
    // year: e/1461 - 4716 + (14-month)/12  (all integer floor)
    let year = _jd_fdiv(e, 1461) - 4716 + (14 - month) / 12
    [year, month, day]

// ── jd_weekday ───────────────────────────────────────────────────────────────
// Returns the day-of-week for (y, m, d): 0=Monday ... 6=Sunday.
// Derivation: JDN 0 is Monday (-4713-11-24).
// jdn % 7 maps directly: 0=Mon, 1=Tue, ..., 5=Sat, 6=Sun.
// Verified: 2451545 % 7 = 5 = Saturday (2000-01-01). ✓
// Uses _jd_fdiv to handle negative JDNs correctly.

fn jd_weekday(y, m, d) -> int
    let jdn = jd_from_date(y, m, d)
    jdn - _jd_fdiv(jdn, 7) * 7

// ── jd_days_between ──────────────────────────────────────────────────────────
// Returns the signed number of days from (y1,m1,d1) to (y2,m2,d2).
// Positive when the second date is later.

fn jd_days_between(y1, m1, d1, y2, m2, d2) -> int
    jd_from_date(y2, m2, d2) - jd_from_date(y1, m1, d1)
