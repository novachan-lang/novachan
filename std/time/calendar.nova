// ============================================================================
// NOVA Standard Library — std/time/calendar
// Calendar helpers: leap years, days in month, day of year, name lookups,
// and Sakamoto's weekday algorithm.  Pure integer arithmetic, no libc calls.
// ============================================================================
//
// PUBLIC API:
//   cal_is_leap(y)          -> bool  (true if y is a Gregorian leap year)
//   cal_days_in_month(y, m) -> int   (1..31, aware of leap years)
//   cal_day_of_year(y, m, d)-> int   (1-based, 1..366)
//   cal_month_name(m)       -> string (1=January .. 12=December)
//   cal_weekday_name(wd)    -> string (0=Sunday .. 6=Saturday)
//   cal_weekday(y, m, d)    -> int   (0=Sunday .. 6=Saturday, Sakamoto's alg)
//
// NOTES:
//   All functions assume proleptic Gregorian calendar.
//   Years must be positive integers (CE).
//   Month m and day d are 1-based.
//   Weekday encoding matches ISO + NOVA datetime: Sun=0, Mon=1, .., Sat=6.

// ── Month name lookup ─────────────────────────────────────────────────────
// Return the English month name for m in 1..12 directly via if-chain.
// (Avoids multi-line list literals which are a NOVA parser gotcha.)

fn cal_month_name(m) -> string
    if m == 1
        return "January"
    if m == 2
        return "February"
    if m == 3
        return "March"
    if m == 4
        return "April"
    if m == 5
        return "May"
    if m == 6
        return "June"
    if m == 7
        return "July"
    if m == 8
        return "August"
    if m == 9
        return "September"
    if m == 10
        return "October"
    if m == 11
        return "November"
    "December"

// ── Weekday name lookup ───────────────────────────────────────────────────
// Return the English weekday name for wd in 0..6 (Sun=0).

fn cal_weekday_name(wd) -> string
    if wd == 0
        return "Sunday"
    if wd == 1
        return "Monday"
    if wd == 2
        return "Tuesday"
    if wd == 3
        return "Wednesday"
    if wd == 4
        return "Thursday"
    if wd == 5
        return "Friday"
    "Saturday"

// ── Sakamoto offset helper ────────────────────────────────────────────────
// Returns the per-month offset used by Sakamoto's weekday formula.
// t = [0,3,2,5,0,3,5,1,4,6,2,4] for months 1..12.

fn _sak_offset(m) -> int
    if m == 1
        return 0
    if m == 2
        return 3
    if m == 3
        return 2
    if m == 4
        return 5
    if m == 5
        return 0
    if m == 6
        return 3
    if m == 7
        return 5
    if m == 8
        return 1
    if m == 9
        return 4
    if m == 10
        return 6
    if m == 11
        return 2
    4

// ── Days-per-month (non-leap) ─────────────────────────────────────────────
// Returns the standard (non-leap) day count for month m (1..12).

fn _std_days(m) -> int
    if m == 2
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    31

// ── PUBLIC API ────────────────────────────────────────────────────────────

// cal_is_leap: true iff y is a leap year in the proleptic Gregorian calendar.
// Rule: divisible by 4 AND (not divisible by 100 OR divisible by 400).
fn cal_is_leap(y) -> bool
    if y % 400 == 0
        return true
    if y % 100 == 0
        return false
    if y % 4 == 0
        return true
    false

// cal_days_in_month: number of days in month m of year y (1-based month).
fn cal_days_in_month(y, m) -> int
    if m == 2 and cal_is_leap(y)
        return 29
    _std_days(m)

// cal_day_of_year: 1-based ordinal day within year y for date (y, m, d).
// Accumulates full months before m, then adds d.
fn cal_day_of_year(y, m, d) -> int
    let total = 0
    for i in 1..m
        total = total + cal_days_in_month(y, i)
    total + d

// cal_weekday: day-of-week for calendar date (y, m, d) using Sakamoto's
// algorithm.  Returns 0=Sunday, 1=Monday, ..., 6=Saturday.
//
// Sakamoto (1993): w = (y + y/4 - y/100 + y/400 + t[m-1] + d) mod 7
// where t = [0,3,2,5,0,3,5,1,4,6,2,4] and y is decremented by 1 for Jan/Feb.
fn cal_weekday(y, m, d) -> int
    let yr = y
    if m < 3
        yr = y - 1
    let raw = yr + yr / 4 - yr / 100 + yr / 400 + _sak_offset(m) + d
    let w = raw % 7
    if w < 0
        w = w + 7
    w
