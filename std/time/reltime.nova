// ============================================================================
// NOVA Standard Library — std/time/reltime
// Human-readable relative time.  Deterministic: caller passes both epochs.
// No wall-clock access, no floats, no bytes.
// ============================================================================
//
// PUBLIC API:
//
//   rel_humanize(from_epoch, now_epoch) -> string
//       Returns a human phrase describing how long ago (or until) from_epoch
//       is relative to now_epoch, using Unix epoch integers (seconds).
//       delta = now_epoch - from_epoch
//         delta > 0  →  from_epoch is in the past   → "N unit(s) ago"
//         delta < 0  →  from_epoch is in the future → "in N unit(s)"
//         |delta| < 10 → "just now"
//       Buckets (|delta|):
//         < 10            → "just now"
//         < 60            → "N second(s) ago" / "in N second(s)"
//         < 3600          → "N minute(s) ago" / "in N minute(s)"
//         < 86400         → "N hour(s) ago"   / "in N hour(s)"
//         < 2592000       → "N day(s) ago"    / "in N day(s)"
//         < 31536000      → "N month(s) ago"  / "in N month(s)"   (1 month = 30 days = 2592000 s)
//         else            → "N year(s) ago"   / "in N year(s)"    (1 year  = 365 days = 31536000 s)
//       Singular/plural: 1 → "second", 2+ → "seconds".
//
//   rel_round(seconds) -> list [count, unit_string]
//       Returns [count, unit] for the LARGEST fitting unit.
//       Input: absolute number of seconds (non-negative; caller passes abs value).
//       Units (ascending thresholds, largest wins):
//         < 60          → [n, "second"]
//         < 3600        → [n, "minute"]
//         < 86400       → [n, "hour"]
//         < 604800      → [n, "day"]
//         < 2592000     → [n, "week"]   (1 week = 604800 s = 7 days)
//         < 31536000    → [n, "month"]  (1 month = 2592000 s = 30 days)
//         else          → [n, "year"]   (1 year  = 31536000 s = 365 days)
//       Always returns base (singular) unit name; plural is caller's concern.
//
//   rel_compact(seconds) -> string
//       Returns a compact duration string using the largest unit.
//       E.g.: "5s", "2m", "3h", "4d", "2w", "6mo", "1y".
//       Input: absolute seconds (non-negative).
//
// EXAMPLES:
//   rel_humanize(1000, 1000)                              → "just now"
//   rel_humanize(910, 1000)                               → "1 minute ago"
//   rel_humanize(1000-7200, 1000)                         → "2 hours ago"
//   rel_humanize(1000000 - 3*86400, 1000000)              → "3 days ago"
//   rel_humanize(1000000 + 2*86400, 1000000)              → "in 2 days"
//   rel_round(3661)                                       → [1, "hour"]
//   rel_round(90)                                         → [1, "minute"]
//   rel_compact(7200)                                     → "2h"
//   rel_compact(3*86400)                                  → "3d"
// ============================================================================

// ── Constants (integer seconds) ──────────────────────────────────────────────
// 1 minute   = 60 s
// 1 hour     = 3600 s
// 1 day      = 86400 s
// 1 week     = 604800 s   (7 * 86400)
// 1 month    = 2592000 s  (30 * 86400)
// 1 year     = 31536000 s (365 * 86400)

// ── Private helpers ───────────────────────────────────────────────────────────

// _rt_plural: "N unit" or "N units" (adds 's' when n != 1).
fn _rt_plural(n, unit) -> string
    if n == 1
        return str(n) + " " + unit
    return str(n) + " " + unit + "s"

// _rt_past: build "N unit(s) ago" or "just now" for positive delta.
fn _rt_past(abs_delta) -> string
    if abs_delta < 10
        return "just now"
    if abs_delta < 60
        return _rt_plural(abs_delta, "second") + " ago"
    if abs_delta < 3600
        let mins = abs_delta / 60
        return _rt_plural(mins, "minute") + " ago"
    if abs_delta < 86400
        let hrs = abs_delta / 3600
        return _rt_plural(hrs, "hour") + " ago"
    if abs_delta < 2592000
        let days = abs_delta / 86400
        return _rt_plural(days, "day") + " ago"
    if abs_delta < 31536000
        let months = abs_delta / 2592000
        return _rt_plural(months, "month") + " ago"
    let years = abs_delta / 31536000
    return _rt_plural(years, "year") + " ago"

// _rt_future: build "in N unit(s)" or "just now" for negative delta.
fn _rt_future(abs_delta) -> string
    if abs_delta < 10
        return "just now"
    if abs_delta < 60
        return "in " + _rt_plural(abs_delta, "second")
    if abs_delta < 3600
        let mins = abs_delta / 60
        return "in " + _rt_plural(mins, "minute")
    if abs_delta < 86400
        let hrs = abs_delta / 3600
        return "in " + _rt_plural(hrs, "hour")
    if abs_delta < 2592000
        let days = abs_delta / 86400
        return "in " + _rt_plural(days, "day")
    if abs_delta < 31536000
        let months = abs_delta / 2592000
        return "in " + _rt_plural(months, "month")
    let years = abs_delta / 31536000
    return "in " + _rt_plural(years, "year")

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// rel_humanize: human phrase for how long ago/until from_epoch is vs now_epoch.
// delta = now_epoch - from_epoch
//   positive delta → from_epoch is in the past   → "N unit(s) ago"
//   negative delta → from_epoch is in the future → "in N unit(s)"
//   |delta| < 10   → "just now"
fn rel_humanize(from_epoch, now_epoch) -> string
    let delta = now_epoch - from_epoch
    if delta >= 0
        return _rt_past(delta)
    let abs_delta = 0 - delta
    return _rt_future(abs_delta)

// rel_round: [count, unit_string] using the largest fitting unit.
// Input: abs seconds (caller ensures non-negative).
// Returns base (singular) unit name.
fn rel_round(seconds) -> list
    if seconds < 60
        return [seconds, "second"]
    if seconds < 3600
        let n = seconds / 60
        return [n, "minute"]
    if seconds < 86400
        let n = seconds / 3600
        return [n, "hour"]
    if seconds < 604800
        let n = seconds / 86400
        return [n, "day"]
    if seconds < 2592000
        let n = seconds / 604800
        return [n, "week"]
    if seconds < 31536000
        let n = seconds / 2592000
        return [n, "month"]
    let n = seconds / 31536000
    return [n, "year"]

// rel_compact: compact string for abs seconds.
// Format: Ns, Nm, Nh, Nd, Nw, Nmo, Ny.
fn rel_compact(seconds) -> string
    if seconds < 60
        return str(seconds) + "s"
    if seconds < 3600
        let n = seconds / 60
        return str(n) + "m"
    if seconds < 86400
        let n = seconds / 3600
        return str(n) + "h"
    if seconds < 604800
        let n = seconds / 86400
        return str(n) + "d"
    if seconds < 2592000
        let n = seconds / 604800
        return str(n) + "w"
    if seconds < 31536000
        let n = seconds / 2592000
        return str(n) + "mo"
    let n = seconds / 31536000
    return str(n) + "y"
