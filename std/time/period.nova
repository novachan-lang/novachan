// ============================================================================
// NOVA Standard Library — std/time/period
// Calendar period arithmetic with end-of-month clamping.
// Pure integer arithmetic — no floats, no libc date calls.
// ============================================================================
//
// PUBLIC API:
//   period_add_months(y, m, d, months) -> list [y, m, d]
//       Add a (possibly negative) number of months, clamping the day to the
//       last day of the resulting month when necessary.
//
//   period_add_years(y, m, d, years) -> list [y, m, d]
//       Add a (possibly negative) number of years, clamping Feb 29 in a
//       non-leap result year to Feb 28.
//
//   period_diff_months(y1, m1, d1, y2, m2, d2) -> int
//       Whole months elapsed from date1 to date2 (negative if date2 < date1).
//       A month is only counted if the day component has been fully reached
//       (i.e. the same semantics as Java's Period.between).
//
//   period_add_days(y, m, d, days) -> list [y, m, d]
//       Add a (possibly negative) number of days via Howard Hinnant's
//       proleptic-Gregorian civil ↔ days epoch arithmetic.
//
// NOTES:
//   All inputs assumed proleptic Gregorian, year >= 1.
//   Months are 1-based (1=January .. 12=December).
//   Days are 1-based.
//   "Days epoch" = days since 1970-01-01 (may be negative for earlier dates).

// ── Private: days-per-month ──────────────────────────────────────────────────

fn _is_leap(y) -> bool
    if y % 400 == 0
        return true
    if y % 100 == 0
        return false
    y % 4 == 0

fn _days_in_month(y, m) -> int
    if m == 2
        if _is_leap(y)
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    31

// ── Private: Howard Hinnant civil ↔ days epoch ──────────────────────────────

fn _days_from_civil(y, m, d) -> int
    let yy = y
    if m <= 2
        yy = yy - 1
    let era = yy / 400
    let yoe = yy - era * 400
    let mp = m + 9
    if m > 2
        mp = m - 3
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

fn _civil_from_days(z0) -> list
    let z = z0 + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if mp >= 10
        m = mp - 9
    if m <= 2
        y = y + 1
    [y, m, d]

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// period_add_months: add months to a calendar date with end-of-month clamping.
// Algorithm:
//   1. Compute target_month = m + months (may be < 1 or > 12).
//   2. Normalize into a year delta + month in 1..12 using floored division:
//      month 0 must map to December of the previous year, month 13 → January
//      of the next year.  We achieve this by working 0-based (0..11) then
//      converting back.
//   3. Add the year delta to y.
//   4. Clamp d to days-in-month(new_y, new_m).
fn period_add_months(y, m, d, months) -> list
    // Convert to 0-based month index, accumulate.
    let m0 = m - 1 + months
    // Floor-divide to handle negative months correctly.
    // NOVA integer division truncates toward zero; for negative m0 we need
    // to adjust so that month 0 (base-0) still belongs to year y, and
    // month -1 belongs to year y-1.
    let yr_delta = m0 / 12
    // For negative m0 that is not exactly divisible, truncation is wrong:
    // e.g. m0 = -1 → yr_delta = 0, but we want -1.
    // Check: if m0 < 0 and remainder != 0, subtract 1 from yr_delta.
    if m0 < 0
        let rem12 = m0 - yr_delta * 12
        if rem12 != 0
            yr_delta = yr_delta - 1
    let new_y = y + yr_delta
    // Compute 0-based new month.
    let new_m0 = m0 - yr_delta * 12
    let new_m = new_m0 + 1
    // Clamp day.
    let max_d = _days_in_month(new_y, new_m)
    let new_d = d
    if new_d > max_d
        new_d = max_d
    [new_y, new_m, new_d]

// period_add_years: add years to a calendar date, clamping Feb 29 when the
// result year is not a leap year.
fn period_add_years(y, m, d, years) -> list
    let new_y = y + years
    let max_d = _days_in_month(new_y, m)
    let new_d = d
    if new_d > max_d
        new_d = max_d
    [new_y, m, new_d]

// period_diff_months: whole months from (y1,m1,d1) to (y2,m2,d2).
// A month is credited only when the day component of date2 >= day component
// of date1 (i.e. the month boundary has been fully crossed).
// Negative result when date2 is before date1.
fn period_diff_months(y1, m1, d1, y2, m2, d2) -> int
    let total = (y2 - y1) * 12 + (m2 - m1)
    // If we haven't yet reached the same day-of-month, back off one month.
    if d2 < d1
        total = total - 1
    total

// period_add_days: add days (positive or negative) to a calendar date.
// Delegates to Howard Hinnant's civil ↔ epoch-days algorithm for exactness.
fn period_add_days(y, m, d, days) -> list
    let epoch = _days_from_civil(y, m, d)
    _civil_from_days(epoch + days)
