// ============================================================================
// NOVA Standard Library — std/time/rfc2822
// RFC 2822 / email-header date parsing and formatting.
// ============================================================================
//
// PUBLIC API:
//   r2_parse(s)          -> dict {weekday,day,month,year,hour,minute,second,tzoff}
//   r2_month_num(name)   -> int    (1-12; "Jan"->1 … "Dec"->12; 0 on unknown)
//   r2_month_name(n)     -> string (1->"Jan" … 12->"Dec"; "" on out-of-range)
//   r2_format(d)         -> string ("Mon, 13 Jul 2026 15:30:00 +0000")
//
// PARSING RULES:
//   Input:  "Mon, 13 Jul 2026 15:30:00 +0000"
//           Weekday prefix ("Mon, ") is optional per RFC 2822 §3.3.
//   tzoff:  Minutes offset from UTC.  "+0530" -> 330; "-0500" -> -300.
//           Special tokens: "UTC","GMT","Z","UT" -> 0.
//   On any parse error the returned dict has day==0 (caller may check).
//
// EXAMPLES:
//   r2_parse("Mon, 13 Jul 2026 15:30:00 +0000")
//       -> {weekday:"Mon",day:13,month:7,year:2026,hour:15,minute:30,second:0,tzoff:0}
//   r2_parse("Tue, 01 Jan 2030 00:00:00 +0530")
//       -> {weekday:"Tue",day:1,month:1,year:2030,hour:0,minute:0,second:0,tzoff:330}
//   r2_month_num("Jul") -> 7
//   r2_month_name(3)    -> "Mar"
//   r2_format(d)        -> "Mon, 13 Jul 2026 15:30:00 +0000"
// ============================================================================

// ── Private: month name tables ───────────────────────────────────────────────

// _r2_months_fwd: ordered list (index 0 = January = 1)
fn _r2_months_fwd() -> list
    let m = []
    m.push("Jan")
    m.push("Feb")
    m.push("Mar")
    m.push("Apr")
    m.push("May")
    m.push("Jun")
    m.push("Jul")
    m.push("Aug")
    m.push("Sep")
    m.push("Oct")
    m.push("Nov")
    m.push("Dec")
    m

// ── PUBLIC: r2_month_num ─────────────────────────────────────────────────────

// r2_month_num: "Jan"->1, "Feb"->2, ..., "Dec"->12; 0 on unknown.
fn r2_month_num(name) -> int
    let months = _r2_months_fwd()
    let i = 0
    let result = 0
    while i < 12
        let cur = months[i]
        if cur == name
            result = i + 1
        i = i + 1
    result

// ── PUBLIC: r2_month_name ────────────────────────────────────────────────────

// r2_month_name: 1->"Jan", 2->"Feb", ..., 12->"Dec"; "" on out-of-range.
fn r2_month_name(n) -> string
    if n < 1
        return ""
    if n > 12
        return ""
    let months = _r2_months_fwd()
    months[n - 1]

// ── Private: zero-pad an integer to 2 digits ─────────────────────────────────

fn _r2_pad2(n) -> string
    if n < 10
        return "0" + str(n)
    str(n)

// ── Private: zero-pad an integer to 4 digits ─────────────────────────────────

fn _r2_pad4(n) -> string
    if n < 10
        return "000" + str(n)
    if n < 100
        return "00" + str(n)
    if n < 1000
        return "0" + str(n)
    str(n)

// ── Private: parse a timezone offset token ───────────────────────────────────
//
// Handles: "+0530" -> 330, "-0500" -> -300, "+0000" -> 0,
//          "UTC","GMT","Z","UT" -> 0.
// Returns 0 on unrecognised input (safe default).

fn _r2_parse_tz(tok) -> int
    if tok == "UTC"
        return 0
    if tok == "GMT"
        return 0
    if tok == "Z"
        return 0
    if tok == "UT"
        return 0
    let tlen = len(tok)
    if tlen < 5
        return 0
    // First char must be '+' or '-'
    let sign_ch = char_at(tok, 0)
    let sign = 0
    if sign_ch == "+"
        sign = 1
    if sign_ch == "-"
        sign = -1
    if sign == 0
        return 0
    // Next 4 chars: HHMM
    let hh_s = slice(tok, 1, 3)
    let mm_s = slice(tok, 3, 5)
    let hh = int(hh_s)
    let mm = int(mm_s)
    sign * (hh * 60 + mm)

// ── Private: strip trailing comma from a token ───────────────────────────────

fn _r2_strip_comma(tok) -> string
    let n = len(tok)
    if n == 0
        return tok
    let last = char_at(tok, n - 1)
    if last == ","
        return slice(tok, 0, n - 1)
    tok

// ── PUBLIC: r2_parse ─────────────────────────────────────────────────────────
//
// Parse an RFC 2822 date string into a dict.
// Returns dict with day==0 on parse failure.

fn r2_parse(s) -> dict
    let result = {}
    result["weekday"] = ""
    result["day"] = 0
    result["month"] = 0
    result["year"] = 0
    result["hour"] = 0
    result["minute"] = 0
    result["second"] = 0
    result["tzoff"] = 0

    let parts = split(s, " ")
    let nparts = len(parts)

    // Need at least 5 tokens: day month year time tz
    // With optional weekday prefix it is 6 tokens.
    if nparts < 5
        return result

    // Detect whether weekday is present: first token ends with ","
    let idx = 0
    let first = parts[0]
    let flen = len(first)
    if flen > 0
        let fend = char_at(first, flen - 1)
        if fend == ","
            result["weekday"] = _r2_strip_comma(first)
            idx = 1

    // Need idx + 4 more tokens minimum
    if nparts < idx + 5
        return result

    // day
    let day_tok = parts[idx]
    result["day"] = int(day_tok)
    idx = idx + 1

    // month name
    let mon_tok = parts[idx]
    result["month"] = r2_month_num(mon_tok)
    idx = idx + 1

    // year
    let yr_tok = parts[idx]
    result["year"] = int(yr_tok)
    idx = idx + 1

    // time "HH:MM:SS"
    let time_tok = parts[idx]
    let tparts = split(time_tok, ":")
    if len(tparts) >= 3
        result["hour"] = int(tparts[0])
        result["minute"] = int(tparts[1])
        result["second"] = int(tparts[2])
    idx = idx + 1

    // timezone
    let tz_tok = parts[idx]
    result["tzoff"] = _r2_parse_tz(tz_tok)

    result

// ── Private: weekday name lookup ─────────────────────────────────────────────
//
// Returns the weekday abbreviation for an ISO weekday number (1=Mon…7=Sun).
// Used by r2_format when the input dict carries a weekday field.

fn _r2_weekday_name(n) -> string
    if n == 1
        return "Mon"
    if n == 2
        return "Tue"
    if n == 3
        return "Wed"
    if n == 4
        return "Thu"
    if n == 5
        return "Fri"
    if n == 6
        return "Sat"
    "Sun"

// ── PUBLIC: r2_format ────────────────────────────────────────────────────────
//
// Format a date dict back into an RFC 2822 date string.
// Uses the "weekday" field if present and non-empty; otherwise omits it.
// tzoff is minutes from UTC: 330 -> "+0530", -300 -> "-0500", 0 -> "+0000".

fn r2_format(d) -> string
    // Build timezone string from offset minutes
    let off = d["tzoff"]
    let tz_str = ""
    if off < 0
        let abs_off = 0 - off
        let tz_h = abs_off / 60
        let tz_m = abs_off - tz_h * 60
        tz_str = "-" + _r2_pad2(tz_h) + _r2_pad2(tz_m)
    if off >= 0
        let tz_h = off / 60
        let tz_m = off - tz_h * 60
        tz_str = "+" + _r2_pad2(tz_h) + _r2_pad2(tz_m)

    let mon_name = r2_month_name(d["month"])
    let yr_str = _r2_pad4(d["year"])
    let day_str = _r2_pad2(d["day"])
    let hr_str = _r2_pad2(d["hour"])
    let mi_str = _r2_pad2(d["minute"])
    let sc_str = _r2_pad2(d["second"])
    let time_str = hr_str + ":" + mi_str + ":" + sc_str

    let wd = d["weekday"]
    if wd == ""
        return day_str + " " + mon_name + " " + yr_str + " " + time_str + " " + tz_str
    wd + ", " + day_str + " " + mon_name + " " + yr_str + " " + time_str + " " + tz_str
