// ============================================================================
// NOVA Standard Library — std/time/businessday
// Business-day (Mon–Fri) arithmetic with optional holiday skip.
// Pure integer arithmetic — no floats, no libc date calls.
// ============================================================================
//
// PUBLIC API:
//   bd_is_business(y, m, d)              -> bool  Mon-Fri = true, Sat/Sun = false
//   bd_add(y, m, d, n)                   -> list  [y,m,d] + n business days (n<0 = backward)
//   bd_count(y1,m1,d1, y2,m2,d2)        -> int   # business days in [d1, d2)
//   bd_next(y, m, d)                     -> list  next business day (advances at least 1 day)
//
// NOTES:
//   Weekday encoding: 0=Sunday, 1=Monday, ..., 6=Saturday (Howard Hinnant proleptic Gregorian).
//   "Business day" = Monday..Friday.  No holiday list in this base module (holiday filtering
//   can be layered on top by the caller; see bd_add_holidays in a future extension).
//   All input years must be >= 1 (proleptic Gregorian). Valid range tested: 1970..2100.
//   bd_count returns 0 when d1 >= d2.

// ── Howard Hinnant proleptic Gregorian helpers ────────────────────────────
// days_from_civil: days since 1970-01-01 for date (y, m, d).  Exact integer.

fn _days_from_civil(y, m, d)
    let yy = y
    if m <= 2
        yy = yy - 1
    let era = yy / 400
    let yoe = yy - era * 400
    let mp = m + 9
    if m > 2
        mp = m - 3
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

fn _civil_from_days(z0)
    let z = z0 + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if mp >= 10
        m = mp - 9
    if m <= 2
        y = y + 1
    return [y, m, d]

// _dow: day-of-week for (y,m,d). Returns 0=Sunday .. 6=Saturday.
fn _dow(y, m, d)
    let n = _days_from_civil(y, m, d)
    return ((n % 7) + 11) % 7

// ── Internal: is a day number a business day? ─────────────────────────────
// dow 1..5 = Mon..Fri.  Returns 1 if business day, 0 otherwise.
fn _daynum_is_biz(n)
    let w = ((n % 7) + 11) % 7
    if w >= 1 and w <= 5
        return 1
    return 0

// ── PUBLIC API ────────────────────────────────────────────────────────────

// bd_is_business: true iff (y, m, d) falls on Monday..Friday.
fn bd_is_business(y, m, d) -> bool
    let w = _dow(y, m, d)
    if w >= 1 and w <= 5
        return true
    return false

// bd_add: add n business days to (y, m, d). n may be negative.
// Uses week-fast arithmetic: full weeks of 7 calendar days = 5 business days,
// then a remainder loop of at most 4 steps, never overshooting.
// Handles weekends in the starting date: if start is Sat/Sun, first advance
// to Monday (for n>=0) or retreat to Friday (for n<0) before counting.
fn bd_add(y, m, d, n)
    let cur = _days_from_civil(y, m, d)
    if n == 0
        return _civil_from_days(cur)
    if n > 0
        // If on a weekend, advance to next Monday first
        let w = ((cur % 7) + 11) % 7
        if w == 0
            cur = cur + 1
        if w == 6
            cur = cur + 2
        // Add full weeks
        let full_weeks = n / 5
        cur = cur + full_weeks * 7
        // Add remaining days one at a time, skipping weekends
        let rem = n - full_weeks * 5
        for i in 0..rem
            cur = cur + 1
            let ww = ((cur % 7) + 11) % 7
            if ww == 0
                cur = cur + 1
            if ww == 6
                cur = cur + 2
        return _civil_from_days(cur)
    // n < 0: step backward
    let nn = 0 - n
    let wb = ((cur % 7) + 11) % 7
    if wb == 0
        cur = cur - 2
    if wb == 6
        cur = cur - 1
    let full_weeks = nn / 5
    cur = cur - full_weeks * 7
    let rem = nn - full_weeks * 5
    for i in 0..rem
        cur = cur - 1
        let ww = ((cur % 7) + 11) % 7
        if ww == 0
            cur = cur - 2
        if ww == 6
            cur = cur - 1
    return _civil_from_days(cur)

// bd_count: number of business days in the half-open interval [d1, d2).
// Returns 0 when d1 >= d2.
// Uses week math: whole weeks contribute 5 business days each, partial
// week is counted day by day (at most 6 extra checks).
fn bd_count(y1, m1, d1, y2, m2, d2)
    let a = _days_from_civil(y1, m1, d1)
    let b = _days_from_civil(y2, m2, d2)
    if a >= b
        return 0
    let diff = b - a
    let full_weeks = diff / 7
    let rem = diff - full_weeks * 7
    let count = full_weeks * 5
    // Count business days in the partial week starting from day a
    for i in 0..rem
        if _daynum_is_biz(a + i) == 1
            count = count + 1
    return count

// bd_next: the next business day after (y, m, d) — always advances at least 1 day.
// If the next day is a weekend, skips to Monday.
fn bd_next(y, m, d)
    let cur = _days_from_civil(y, m, d)
    cur = cur + 1
    let w = ((cur % 7) + 11) % 7
    if w == 0
        cur = cur + 1
    if w == 6
        cur = cur + 2
    return _civil_from_days(cur)
