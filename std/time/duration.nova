// ============================================================================
// NOVA Standard Library — std/time/duration
// Parse and format human-readable duration strings.
// All durations are in WHOLE SECONDS (int).
// ============================================================================
//
// PUBLIC API:
//   dur_parse(s)      -> int   seconds; -1 on malformed input
//   dur_format(secs)  -> string  compact "1d2h3m4s"; "0s" for zero; negative -> "-" + format(abs)
//
// PARSE UNITS: d=86400s  h=3600s  m=60s  s=1s
// FORMAT:  largest→smallest, zero units omitted; secs==0 → "0s"
//
// EXAMPLES:
//   dur_parse("1h30m")      -> 5400
//   dur_parse("1d2h3m4s")   -> 93784
//   dur_parse("45s")        -> 45
//   dur_parse("2h")         -> 7200
//   dur_parse("garbage")    -> -1
//   dur_format(5400)        -> "1h30m"
//   dur_format(93784)       -> "1d2h3m4s"
//   dur_format(90)          -> "1m30s"
//   dur_format(3600)        -> "1h"
//   dur_format(0)           -> "0s"
//
// DRAWBACKS AVOIDED:
//   Go   — time.ParseDuration returns error + panics; only supports h/m/s/ms/us/ns
//           NOVA: returns -1 sentinel; no panic path.
//   Java — Duration.parse("PT1H30M") requires ISO 8601 PT-prefix verbosity
//           NOVA: "1h30m" — natural human notation.
//   Python — no stdlib parse for compact durations; every project rolls its own
//            NOVA: zero-annotation, stdlib-included.

// ── Private helpers ──────────────────────────────────────────────────────────

// _is_digit(c): true when single-char string is ASCII 0-9.
fn _is_digit(c) -> int
    let v = ord(c)
    if v >= 48 and v <= 57
        return 1
    0

// _char_at(s, i): returns single-char string at position i (safe slice).
fn _char_at(s, i) -> string
    s[i:i + 1]

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// dur_parse: parse a compact human duration string to SECONDS.
// Accepts any subset of units d/h/m/s in any order, optional whitespace between
// tokens (but not inside a number or unit letter).  Returns -1 on malformed input.
// "Malformed" means: no recognized unit-tokens found at all, or a digit run with
// no following unit letter, or a unit letter with no preceding digits.
fn dur_parse(s) -> int
    let total = 0
    let num = 0
    let i = 0
    let n = len(s)
    let has_num = 0
    let found_any = 0
    // Track whether we saw at least one valid unit-token (digit-run + unit).
    let bad = 0
    while i < n
        let c = _char_at(s, i)
        // Skip whitespace.
        if c == " " or c == "\t" or c == "\n" or c == "\r"
            // If we are mid-number when we hit whitespace that is malformed
            // (digit run must be immediately followed by a unit letter).
            if has_num == 1
                bad = 1
            i = i + 1
        else
            if _is_digit(c) == 1
                num = num * 10 + (ord(c) - 48)
                has_num = 1
                i = i + 1
            else
                // Must be a unit letter and we must have accumulated digits.
                if has_num == 0
                    bad = 1
                    i = i + 1
                else
                    let mult = 0
                    if c == "d"
                        mult = 86400
                    if c == "h"
                        mult = 3600
                    if c == "m"
                        mult = 60
                    if c == "s"
                        mult = 1
                    if mult == 0
                        // Unknown unit letter.
                        bad = 1
                        num = 0
                        has_num = 0
                        i = i + 1
                    else
                        total = total + num * mult
                        num = 0
                        has_num = 0
                        found_any = 1
                        i = i + 1
    // Trailing digit run with no unit = malformed.
    if has_num == 1
        bad = 1
    if bad == 1
        return -1
    if found_any == 0
        return -1
    total

// dur_format: format whole seconds as compact duration string.
// Zero units are omitted; secs==0 -> "0s"; negative -> "-" + format(abs).
fn dur_format(secs) -> string
    if secs < 0
        return "-" + dur_format(0 - secs)
    if secs == 0
        return "0s"
    let out = ""
    let rem = secs
    let d = rem / 86400
    rem = rem - d * 86400
    let h = rem / 3600
    rem = rem - h * 3600
    let m = rem / 60
    let sc = rem - m * 60
    if d > 0
        out = out + str(d) + "d"
    if h > 0
        out = out + str(h) + "h"
    if m > 0
        out = out + str(m) + "m"
    if sc > 0
        out = out + str(sc) + "s"
    out
