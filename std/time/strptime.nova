// ============================================================================
// NOVA Standard Library — std/time/strptime
// Pattern-based date/time string parsing (strptime) and epoch decomposition.
// Pure integer arithmetic; no floats, no I/O.
// ============================================================================
//
// PUBLIC API:
//   dt_strptime(s, pattern) -> int   epoch (UTC seconds), or -1 on mismatch
//   dt_to_ymdhms(epoch)     -> list  [year, month, day, hour, min, sec]
//   dt_strftime(epoch, pattern) -> string  (inverse of dt_strptime)
//
// SUPPORTED DIRECTIVES (pattern):
//   %Y  4-digit year          %m  2-digit month (01-12)
//   %d  2-digit day (01-31)   %H  2-digit hour (00-23)
//   %M  2-digit minute        %S  2-digit second
//   %%  literal %
//   All other pattern characters must match literally.
//
// ALGORITHM: Howard Hinnant's civil_from_days / days_from_civil.
// All helpers are prefixed _sp_ to avoid collisions with other std/time modules.
// ============================================================================

// ── Private: integer floor-division helpers ──────────────────────────────────
// NOVA integer division truncates toward zero (C semantics).
// For negative operands the floor (mathematical) quotient may differ by 1.

fn _sp_fdiv(a, b) -> int
    let q = a / b
    if (a < 0) != (b < 0)
        if a - q * b != 0
            return q - 1
    q

fn _sp_fmod(a, b) -> int
    a - b * _sp_fdiv(a, b)

// ── Private: Howard Hinnant calendar helpers ─────────────────────────────────

// _sp_days_from_civil: (y, m, d) -> days since 1970-01-01.
fn _sp_days_from_civil(y0, m, d) -> int
    let y = y0
    if m <= 2
        y = y - 1
    let era = _sp_fdiv(y, 400)
    let yoe = y - era * 400
    let mp = m - 3
    if m <= 2
        mp = m + 9
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

// _sp_civil_from_days: days since 1970-01-01 -> [year, month, day].
fn _sp_civil_from_days(z0) -> list
    let z = z0 + 719468
    let era = _sp_fdiv(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if mp >= 10
        m = mp - 9
    if m <= 2
        y = y + 1
    [y, m, d]

// ── Private: string helpers ──────────────────────────────────────────────────

// _sp_pad2: zero-pad an integer to exactly 2 digits.
fn _sp_pad2(n) -> string
    if n < 10
        return "0" + str(n)
    str(n)

// _sp_pad4: zero-pad an integer to exactly 4 digits.
fn _sp_pad4(n) -> string
    if n < 10
        return "000" + str(n)
    if n < 100
        return "00" + str(n)
    if n < 1000
        return "0" + str(n)
    str(n)

// _sp_parse_n: parse exactly `width` decimal digits from s[pos..pos+width].
// Returns [value, new_pos] on success, or [-1, pos] on failure (non-digit or
// not enough characters).
fn _sp_parse_n(s, pos, width) -> list
    let slen = len(s)
    let end = pos + width
    if end > slen
        return [-1, pos]
    let val = 0
    let i = pos
    while i < end
        let c = ord(s[i:i+1])
        if c < 48 or c > 57
            return [-1, pos]
        val = val * 10 + (c - 48)
        i = i + 1
    [val, end]

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// dt_to_ymdhms: decompose a UTC epoch into [year, month, day, hour, min, sec].
// Epoch is UTC seconds (int, may be negative for pre-1970 dates).
fn dt_to_ymdhms(epoch) -> list
    let days = _sp_fdiv(epoch, 86400)
    let rem = _sp_fmod(epoch, 86400)
    let ymd = _sp_civil_from_days(days)
    let h = rem / 3600
    let mi = (rem % 3600) / 60
    let sc = rem % 60
    [ymd[0], ymd[1], ymd[2], h, mi, sc]

// dt_strptime: parse string s according to pattern, return UTC epoch (int).
// Returns -1 on any parse failure or out-of-range field.
// Supported directives: %Y %m %d %H %M %S %% (all other chars match literally).
fn dt_strptime(s, pattern) -> int
    let slen = len(s)
    let plen = len(pattern)
    let si = 0
    let pi = 0
    let yr = 0
    let mo = 0
    let dy = 0
    let hh = 0
    let mi = 0
    let sc = 0
    // Track which fields were seen so we can default missing time fields to 0.
    let got_y = false
    let got_mo = false
    let got_d = false
    while pi < plen
        let pc = pattern[pi:pi+1]
        if pc == "%"
            pi = pi + 1
            if pi >= plen
                return -1
            let dir = pattern[pi:pi+1]
            pi = pi + 1
            if dir == "Y"
                let res = _sp_parse_n(s, si, 4)
                if res[0] < 0
                    return -1
                yr = res[0]
                si = res[1]
                got_y = true
            else
                if dir == "m"
                    let res = _sp_parse_n(s, si, 2)
                    if res[0] < 0
                        return -1
                    mo = res[0]
                    si = res[1]
                    got_mo = true
                else
                    if dir == "d"
                        let res = _sp_parse_n(s, si, 2)
                        if res[0] < 0
                            return -1
                        dy = res[0]
                        si = res[1]
                        got_d = true
                    else
                        if dir == "H"
                            let res = _sp_parse_n(s, si, 2)
                            if res[0] < 0
                                return -1
                            hh = res[0]
                            si = res[1]
                        else
                            if dir == "M"
                                let res = _sp_parse_n(s, si, 2)
                                if res[0] < 0
                                    return -1
                                mi = res[0]
                                si = res[1]
                            else
                                if dir == "S"
                                    let res = _sp_parse_n(s, si, 2)
                                    if res[0] < 0
                                        return -1
                                    sc = res[0]
                                    si = res[1]
                                else
                                    if dir == "%"
                                        if si >= slen
                                            return -1
                                        let lc = s[si:si+1]
                                        if lc != "%"
                                            return -1
                                        si = si + 1
                                    else
                                        return -1
        else
            // Literal character: must match exactly.
            if si >= slen
                return -1
            let sc2 = s[si:si+1]
            if sc2 != pc
                return -1
            si = si + 1
            pi = pi + 1
    // After consuming the full pattern, the entire input must be consumed.
    if si != slen
        return -1
    // Field range validation.
    if not got_y or not got_mo or not got_d
        return -1
    if yr < 1 or yr > 9999
        return -1
    if mo < 1 or mo > 12
        return -1
    if dy < 1 or dy > 31
        return -1
    if hh < 0 or hh > 23
        return -1
    if mi < 0 or mi > 59
        return -1
    if sc < 0 or sc > 59
        return -1
    _sp_days_from_civil(yr, mo, dy) * 86400 + hh * 3600 + mi * 60 + sc

// dt_strftime: format a UTC epoch as a string using pattern directives.
// Supports: %Y %m %d %H %M %S %% (same set as dt_strptime).
// Other pattern characters are copied literally.
fn dt_strftime(epoch, pattern) -> string
    let parts = dt_to_ymdhms(epoch)
    let y = parts[0]
    let mo = parts[1]
    let d = parts[2]
    let h = parts[3]
    let mi = parts[4]
    let sc = parts[5]
    let plen = len(pattern)
    let pi = 0
    let out = ""
    while pi < plen
        let pc = pattern[pi:pi+1]
        if pc == "%"
            pi = pi + 1
            if pi >= plen
                out = out + "%"
            else
                let dir = pattern[pi:pi+1]
                pi = pi + 1
                if dir == "Y"
                    out = out + _sp_pad4(y)
                else
                    if dir == "m"
                        out = out + _sp_pad2(mo)
                    else
                        if dir == "d"
                            out = out + _sp_pad2(d)
                        else
                            if dir == "H"
                                out = out + _sp_pad2(h)
                            else
                                if dir == "M"
                                    out = out + _sp_pad2(mi)
                                else
                                    if dir == "S"
                                        out = out + _sp_pad2(sc)
                                    else
                                        if dir == "%"
                                            out = out + "%"
                                        else
                                            out = out + "%" + dir
        else
            out = out + pc
            pi = pi + 1
    out
