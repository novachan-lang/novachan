// ============================================================================
// NOVA Standard Library — std/time/pduration
// ISO 8601 duration (P-notation) parse, format, and total-seconds.
// Pure integer arithmetic — no floats, no bytes.
// ============================================================================
//
// PUBLIC API:
//   pd_parse(s)            -> dict  {"years","months","days","hours","mins","secs"}
//                             All fields always present; missing components = 0.
//                             Returns all-zero dict on malformed input.
//
//   pd_format(d)           -> string  canonical ISO 8601 e.g. "P1Y2M3DT4H5M6S"
//                             Zero components omitted; "PT0S" for an all-zero dict.
//
//   pd_total_seconds(d)    -> int
//                             years*365*86400 + months*30*86400 + days*86400
//                             + hours*3600 + mins*60 + secs
//
// KAT VECTORS (from spec):
//   pd_parse("P1Y2M3DT4H5M6S")  -> {years:1, months:2, days:3, hours:4, mins:5, secs:6}
//   pd_parse("PT30M")            -> {mins:30, rest 0}
//   pd_format({"days":3,"hours":4})    -> "P3DT4H"
//   pd_format({"secs":90})             -> "PT90S"
//   pd_total_seconds({"hours":1,"mins":30}) -> 5400
//   pd_total_seconds({"days":1})            -> 86400
//   round-trip pd_format(pd_parse("P1Y2M3DT4H5M6S")) == "P1Y2M3DT4H5M6S"
//
// DESIGN NOTES:
//   - ISO 8601 §4.4.3.2: P[nY][nM][nD][T[nH][nM][nS]]; all components integer.
//   - "months" are calendar (no fixed second count). pd_total_seconds uses
//     month=30d, year=365d as specified — purely for arithmetic convenience.
//   - Malformed input (not starting with 'P', stray letters, no designators)
//     returns an all-zero dict; callers can test pd_total_seconds == 0 or check
//     specific fields.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _pd_char(s, i): single-char string at position i (safe).
fn _pd_char(s, i) -> string
    s[i:i + 1]

// _pd_is_digit(c): 1 if c is ASCII 0-9, else 0.
fn _pd_is_digit(c) -> int
    let v = ord(c)
    if v >= 48 and v <= 57
        return 1
    0

// _pd_zero(): canonical zero-duration dict with all six keys.
fn _pd_zero() -> dict
    let d = {}
    d["years"] = 0
    d["months"] = 0
    d["days"] = 0
    d["hours"] = 0
    d["mins"] = 0
    d["secs"] = 0
    d

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// pd_parse: parse an ISO 8601 duration string into a component dict.
// Grammar: P[nY][nM][nD][T[nH][nM][nS]]
// 'M' before the 'T' separator = months; 'M' after = minutes.
// Returns all-zero dict for any malformed input.
fn pd_parse(s) -> dict
    let result = _pd_zero()
    let n = len(s)
    // Must start with 'P'.
    if n < 2
        return result
    if _pd_char(s, 0) != "P"
        return result
    let i = 1
    // in_time: 0 = date portion, 1 = time portion (after 'T')
    let in_time = 0
    // num: accumulated integer value of current digit run; has_num: whether we
    // are currently accumulating a number.
    let num = 0
    let has_num = 0
    while i < n
        let c = _pd_char(s, i)
        if _pd_is_digit(c) == 1
            num = num * 10 + (ord(c) - 48)
            has_num = 1
            i = i + 1
        else
            if c == "T"
                // Transition from date to time portion.
                // A bare 'T' with a pending number is malformed — reset cleanly.
                num = 0
                has_num = 0
                in_time = 1
                i = i + 1
            else
                // Must have a preceding number; otherwise ignore/malformed.
                if has_num == 1
                    if in_time == 0
                        // Date designators: Y M D
                        if c == "Y"
                            result["years"] = num
                        if c == "M"
                            result["months"] = num
                        if c == "D"
                            result["days"] = num
                    else
                        // Time designators: H M S
                        if c == "H"
                            result["hours"] = num
                        if c == "M"
                            result["mins"] = num
                        if c == "S"
                            result["secs"] = num
                num = 0
                has_num = 0
                i = i + 1
    result

// pd_format: format a component dict as a canonical ISO 8601 P-string.
// Zero components are omitted.  All-zero dict -> "PT0S" (zero duration).
fn pd_format(d) -> string
    // Read each field; missing dict key returns 0 in NOVA.
    let yr = 0
    let mo = 0
    let dy = 0
    let hr = 0
    let mi = 0
    let sc = 0
    if contains(d, "years")
        yr = d["years"]
    if contains(d, "months")
        mo = d["months"]
    if contains(d, "days")
        dy = d["days"]
    if contains(d, "hours")
        hr = d["hours"]
    if contains(d, "mins")
        mi = d["mins"]
    if contains(d, "secs")
        sc = d["secs"]
    // Build date portion.
    let date_part = ""
    if yr != 0
        date_part = date_part + str(yr) + "Y"
    if mo != 0
        date_part = date_part + str(mo) + "M"
    if dy != 0
        date_part = date_part + str(dy) + "D"
    // Build time portion.
    let time_part = ""
    if hr != 0
        time_part = time_part + str(hr) + "H"
    if mi != 0
        time_part = time_part + str(mi) + "M"
    if sc != 0
        time_part = time_part + str(sc) + "S"
    // Assemble: P + date_part [+ T + time_part].
    // All-zero case: "PT0S" (canonical zero per ISO 8601 §4.4.3.2 note).
    if date_part == "" and time_part == ""
        return "PT0S"
    if time_part == ""
        return "P" + date_part
    "P" + date_part + "T" + time_part

// pd_total_seconds: convert duration dict to total seconds.
//   1 year  = 365 days = 31 536 000 seconds
//   1 month = 30  days =  2 592 000 seconds
//   1 day   =           86 400 seconds
fn pd_total_seconds(d) -> int
    let yr = 0
    let mo = 0
    let dy = 0
    let hr = 0
    let mi = 0
    let sc = 0
    if contains(d, "years")
        yr = d["years"]
    if contains(d, "months")
        mo = d["months"]
    if contains(d, "days")
        dy = d["days"]
    if contains(d, "hours")
        hr = d["hours"]
    if contains(d, "mins")
        mi = d["mins"]
    if contains(d, "secs")
        sc = d["secs"]
    let total = yr * 31536000
    total = total + mo * 2592000
    total = total + dy * 86400
    total = total + hr * 3600
    total = total + mi * 60
    total = total + sc
    total
