// ============================================================================
// NOVA Standard Library — std/time/holiday
// Holiday computations: Easter (Western Gregorian computus), US federal
// holidays (fixed + rule-based), and a generic nth-weekday helper.
// Pure integer arithmetic — no floats, no libc date calls.
// ============================================================================
//
// PUBLIC API:
//   easter(y)                      -> list [y, m, d]  Western/Gregorian Easter
//   holiday_nth_weekday(y,m,wd,n)  -> list [y, m, d]  n-th wd of month (n<0=from end)
//   holiday_us_thanksgiving(y)     -> list [y, m, d]  4th Thursday of November
//   holiday_is_us(y, m, d)         -> bool  true if date is a US federal holiday
//
// NOTES:
//   Weekday encoding: 0=Sunday 1=Monday 2=Tuesday 3=Wednesday
//                     4=Thursday 5=Friday 6=Saturday
//   n in holiday_nth_weekday: 1=first, 2=second, 3=third … -1=last, -2=penultimate
//   easter() uses the Anonymous Gregorian algorithm (verified against RFC 2445).
//   holiday_is_us() covers: New Year (Jan 1), MLK (3rd Mon Jan),
//     Memorial Day (last Mon May), Independence Day (Jul 4),
//     Labor Day (1st Mon Sep), Thanksgiving (4th Thu Nov), Christmas (Dec 25).
//   All return lists are [year, month, day] (1-based month + day).
//   Invalid inputs return empty list [] or false.

// ── Private helpers ───────────────────────────────────────────────────────

// Howard Hinnant's algorithm: days since 1970-01-01 (proleptic Gregorian).
fn _days_from_civil(y, m, d)
    let yy = y
    if m <= 2
        yy = yy - 1
    let era = yy / 400
    let yoe = yy - era * 400
    let mp = m + 9
    if m > 2
        mp = m - 3
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

// Day of week for (y, m, d): 0=Sunday … 6=Saturday.
fn _dow(y, m, d)
    let n = _days_from_civil(y, m, d)
    return ((n % 7) + 11) % 7

// True iff y is a proleptic Gregorian leap year.
fn _is_leap(y)
    if y % 400 == 0
        return true
    if y % 100 == 0
        return false
    return y % 4 == 0

// Days in month m of year y (1-based month).
fn _dim(y, m)
    if m == 2
        if _is_leap(y)
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    return 31

// ── Public API ────────────────────────────────────────────────────────────

// easter(y): Western/Gregorian Easter date for year y.
// Uses the Anonymous Gregorian algorithm (valid for y >= 1583).
// Returns [y, m, d] on success, [] on invalid input.
fn easter(y)
    if y <= 0
        return []
    let a = y % 19
    let b = y / 100
    let c = y % 100
    let dd = b / 4
    let e = b % 4
    let f = (b + 8) / 25
    let g = (b - f + 1) / 3
    let h = (19 * a + b - dd - g + 15) % 30
    let ii = c / 4
    let k = c % 4
    let l = (32 + 2 * e + 2 * ii - h - k) % 7
    let mn = (a + 11 * h + 22 * l) / 451
    let month = (h + l - 7 * mn + 114) / 31
    let day = (h + l - 7 * mn + 114) % 31 + 1
    return [y, month, day]

// holiday_nth_weekday(y, m, wd, n): date of the n-th occurrence of weekday wd
// in month m of year y.
// wd: 0=Sunday .. 6=Saturday.
// n >= 1 counts from start of month; n <= -1 counts from end (-1 = last).
// Returns [y, m, d] on success, [] on invalid input or out-of-range result.
fn holiday_nth_weekday(y, m, wd, n)
    if y <= 0 or m < 1 or m > 12 or wd < 0 or wd > 6 or n == 0
        return []
    let days_in_m = _dim(y, m)
    let first_wd = _dow(y, m, 1)
    // Day-1 offset to the first wd in this month (0..6).
    let offset = (wd - first_wd + 7) % 7
    let first_day = 1 + offset
    if n >= 1
        let day = first_day + (n - 1) * 7
        if day > days_in_m
            return []
        return [y, m, day]
    // n <= -1: count from end.  Find last occurrence of wd in month.
    let last_day = first_day
    let nxt = first_day + 7
    while nxt <= days_in_m
        last_day = nxt
        nxt = nxt + 7
    // n=-1 → last_day, n=-2 → last_day-7, etc.
    let back = (0 - n) - 1
    let day = last_day - back * 7
    if day < 1
        return []
    return [y, m, day]

// holiday_us_thanksgiving(y): 4th Thursday of November in year y.
// Returns [y, 11, d].
fn holiday_us_thanksgiving(y)
    return holiday_nth_weekday(y, 11, 4, 4)

// _date_matches: true iff (m, d) matches element [1] and [2] of a [y,m,d] list.
fn _date_matches(lst, m, d)
    if len(lst) != 3
        return false
    if lst[1] == m and lst[2] == d
        return true
    return false

// holiday_is_us(y, m, d): true iff (y, m, d) is a US federal holiday.
// Covers: New Year Day (Jan 1), MLK Day (3rd Mon Jan),
//         Memorial Day (last Mon May), Independence Day (Jul 4),
//         Labor Day (1st Mon Sep), Thanksgiving (4th Thu Nov), Christmas (Dec 25).
fn holiday_is_us(y, m, d)
    if y <= 0 or m < 1 or m > 12 or d < 1 or d > _dim(y, m)
        return false
    // Fixed-date holidays.
    if m == 1 and d == 1
        return true
    if m == 7 and d == 4
        return true
    if m == 12 and d == 25
        return true
    // MLK Day: 3rd Monday of January.
    if _date_matches(holiday_nth_weekday(y, 1, 1, 3), m, d)
        return true
    // Memorial Day: last Monday of May.
    if _date_matches(holiday_nth_weekday(y, 5, 1, -1), m, d)
        return true
    // Labor Day: 1st Monday of September.
    if _date_matches(holiday_nth_weekday(y, 9, 1, 1), m, d)
        return true
    // Thanksgiving: 4th Thursday of November.
    if _date_matches(holiday_us_thanksgiving(y), m, d)
        return true
    return false
