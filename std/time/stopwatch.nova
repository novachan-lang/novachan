// ============================================================================
// NOVA Standard Library — std/time/stopwatch
// Monotonic stopwatch using the native clock_ns() builtin.
// All times are in nanoseconds (int) internally.
// ============================================================================
//
// PUBLIC API:
//   sw_new()           -> dict   {"start": <ns>}  — fresh stopwatch, running now
//   sw_reset(sw)       -> dict   resets start to now (returns same dict updated)
//   sw_elapsed_ns(sw)  -> int    nanoseconds since sw_new()/sw_reset()
//   sw_elapsed_ms(sw)  -> int    milliseconds (integer division, truncated)
//   sw_format(ns)      -> string human-readable: "1.500s" / "2ms" / "500us" / "750ns"
//
// FORMAT RULES (all via integer math, no floats):
//   ns >= 1_000_000_000  -> "<whole>.<frac3>s"  (frac3 = (ns%1e9)/1e6, zero-padded to 3 digits)
//   ns >= 1_000_000      -> "<ms>ms"
//   ns >= 1_000          -> "<us>us"
//   else                 -> "<ns>ns"
//
// KNOWN-ANSWER EXAMPLES:
//   sw_format(1500000000) = "1.500s"
//   sw_format(2000000)    = "2ms"
//   sw_format(500000)     = "500us"
//   sw_format(750)        = "750ns"
//   sw_format(1000000000) = "1.000s"
//
// DESIGN NOTES:
//   clock_ns() is a native NOVA builtin (monotonic, nanosecond resolution).
//   Dicts use string keys; the single key is "start".
//   No floating-point arithmetic anywhere — all formatting via integer division/modulo.
//   Go's time.Since requires a time.Time struct; Java's System.nanoTime() is raw i64;
//   NOVA's stopwatch wraps the raw counter in an ergonomic dict API.

// ── Private helpers ──────────────────────────────────────────────────────────

// _pad3(n): format int 0..999 as exactly 3 decimal digits (zero-pad on left).
fn _pad3(n) -> string
    if n < 10
        return "00" + str(n)
    if n < 100
        return "0" + str(n)
    str(n)

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// sw_new: create a new stopwatch dict, capturing the current monotonic time.
fn sw_new() -> dict
    let sw = {"start": clock_ns()}
    sw

// sw_reset: reset the stopwatch start time to now.
// Modifies and returns the same dict so the caller can chain or discard.
fn sw_reset(sw) -> dict
    sw["start"] = clock_ns()
    sw

// sw_elapsed_ns: nanoseconds elapsed since sw_new() or sw_reset().
fn sw_elapsed_ns(sw) -> int
    let now = clock_ns()
    now - sw["start"]

// sw_elapsed_ms: milliseconds elapsed (integer division, truncated toward zero).
fn sw_elapsed_ms(sw) -> int
    sw_elapsed_ns(sw) / 1000000

// sw_format: format a raw nanosecond count as a human-readable string.
// Uses only integer arithmetic; see FORMAT RULES above.
fn sw_format(ns) -> string
    if ns >= 1000000000
        let whole = ns / 1000000000
        let frac = (ns - whole * 1000000000) / 1000000
        return str(whole) + "." + _pad3(frac) + "s"
    if ns >= 1000000
        let ms = ns / 1000000
        return str(ms) + "ms"
    if ns >= 1000
        let us = ns / 1000
        return str(us) + "us"
    str(ns) + "ns"
