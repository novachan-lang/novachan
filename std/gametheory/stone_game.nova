// std/gametheory/stone_game.nova — Stone game: two players alternately take from
// either end of a row; each plays optimally to maximise their own total.
//
// DP recurrence: f(i,j) = first-player's margin (score above second-player's score)
//   for subarray a[i..j] with optimal play.
//   f(i,i) = a[i]   (only one element; take it)
//   f(i,j) = max(a[i] - f(i+1,j), a[j] - f(i,j-1))
//
// Public API:
//   stg_margin(values)             -> int   first - second score with optimal play
//   stg_first_player_score(values) -> int   first player's absolute score
//   stg_first_wins(values)         -> bool  true if first player's margin > 0
// LEAF — imports nothing.

// stg_dp_key — encode (i,j) as a single integer key for the memo dict.
fn stg_dp_key(i: int, j: int, n: int) -> int
    i * n + j

// stg_dp — memoised DP; returns first-player margin for a[i..j].
fn stg_dp(a: list, i: int, j: int, n: int, memo: dict) -> int
    let k = stg_dp_key(i, j, n)
    if contains(memo, k)
        return memo[k]
    let v = 0
    if i == j
        v = a[i]
    else
        let take_left  = a[i] - stg_dp(a, i + 1, j, n, memo)
        let take_right = a[j] - stg_dp(a, i, j - 1, n, memo)
        if take_left > take_right
            v = take_left
        else
            v = take_right
    memo[k] = v
    v

// stg_margin — first-player score minus second-player score under optimal play.
fn stg_margin(values: list) -> int
    let n = len(values)
    if n == 0
        return 0
    let memo = {}
    stg_dp(values, 0, n - 1, n, memo)

// stg_first_player_score — absolute score of the first player under optimal play.
fn stg_first_player_score(values: list) -> int
    let n = len(values)
    if n == 0
        return 0
    let total = 0
    for i in 0..n
        total = total + values[i]
    let margin = stg_margin(values)
    (total + margin) / 2

// stg_first_wins — true if the first player's margin is strictly positive.
fn stg_first_wins(values: list) -> bool
    stg_margin(values) > 0
