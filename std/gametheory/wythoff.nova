// std/gametheory/wythoff.nova — Wythoff's game P-position generator.
//
// Wythoff's game: two players alternate removing either any number of coins
// from ONE heap, or an equal number of coins from BOTH heaps.  Last to move wins.
//
// P-positions (losing for the player to move) are complementary pairs (a_k, b_k):
//   a_k = mex over {0..k-1} of all previously generated a and b values
//   b_k = a_k + k
// with a_0=0, b_0=0 (the terminal position).
//
// Public API:
//   wy_nth_p_position(k)      -> [a_k, b_k]
//   wy_is_losing(x, y)        -> bool  (true iff {x,y} is a P-position)
//   wy_p_positions(count)     -> list  of [a,b] pairs, first `count` P-positions
//
// LEAF — imports nothing.

// _wy_mex — minimum excludant of a set represented as a dict with string keys.
fn _wy_mex(used)
    let m = 0
    while contains(used, str(m))
        m = m + 1
    m

// wy_nth_p_position — return the k-th Wythoff P-position as [a_k, b_k].
fn wy_nth_p_position(k)
    let used = {}
    let i = 0
    let a = 0
    let b = 0
    while i <= k
        a = _wy_mex(used)
        b = a + i
        used[str(a)] = 1
        used[str(b)] = 1
        i = i + 1
    let result = []
    push(result, a)
    push(result, b)
    result

// wy_p_positions — return list of first `count` Wythoff P-positions.
fn wy_p_positions(count)
    let result = []
    let used = {}
    let i = 0
    while i < count
        let a = _wy_mex(used)
        let b = a + i
        used[str(a)] = 1
        used[str(b)] = 1
        let pair = []
        push(pair, a)
        push(pair, b)
        push(result, pair)
        i = i + 1
    result

// wy_is_losing — true iff the unordered pair {x,y} is a Wythoff P-position.
fn wy_is_losing(x, y)
    // Search P-positions up to max(x,y)+1 to handle all cases.
    let hi = x
    if y > hi
        hi = y
    let limit = hi + 2
    let used = {}
    let i = 0
    let found = false
    while i < limit
        let a = _wy_mex(used)
        let b = a + i
        used[str(a)] = 1
        used[str(b)] = 1
        if (a == x and b == y) or (a == y and b == x)
            found = true
        i = i + 1
    found
