// std/gametheory/negamax.nova — negamax / minimax value for zero-sum game trees.
//
// Tree representation: an int leaf holds a terminal score; a list node holds
// child sub-trees.  The root is treated as a MAX node; its children are MIN
// nodes; their children are MAX nodes again — standard alternating minimax.
//
// Public API:
//   ng_value(tree) -> int   minimax value from the MAX root's perspective.

// _ng_max — evaluate a MAX node: return the max over children evaluated as MIN nodes.
// If tree is a leaf (int) return it directly.
fn _ng_max(tree) -> int
    if type_of(tree) == "int"
        return tree
    let n = len(tree)
    if n == 0
        return 0
    let best = _ng_min(tree[0])
    let i = 1
    while i < n
        let v = _ng_min(tree[i])
        if v > best
            best = v
        i = i + 1
    best

// _ng_min — evaluate a MIN node: return the min over children evaluated as MAX nodes.
// If tree is a leaf (int) return it directly.
fn _ng_min(tree) -> int
    if type_of(tree) == "int"
        return tree
    let n = len(tree)
    if n == 0
        return 0
    let best = _ng_max(tree[0])
    let i = 1
    while i < n
        let v = _ng_max(tree[i])
        if v < best
            best = v
        i = i + 1
    best

// ng_value — return the minimax value of tree from the MAX root's perspective.
fn ng_value(tree) -> int
    _ng_max(tree)
