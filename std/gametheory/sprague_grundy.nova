// std/gametheory/sprague_grundy.nova — Sprague-Grundy theorem core primitives.
// Provides mex, nim-sum (XOR fold), and Grundy-value computation for DAG games.
//
// Public API:
//   spg_mex(xs)               -> int   minimum excludant of a list of non-negative ints
//   spg_nim_sum(xs)           -> int   XOR fold of a list of non-negative ints
//   spg_grundy_dag(adj, node) -> int   Grundy value of `node` in the DAG described by adj
//       adj is a list where adj[i] is the list of positions reachable from position i.
//       The DAG must be acyclic. Computes via iterative topological DFS with memoization.
//
// LEAF — imports NOTHING.

// spg_mex — minimum excludant: smallest non-negative integer NOT present in xs.
// xs may contain duplicates and need not be sorted.
fn spg_mex(xs) -> int
    let present = {}
    let i = 0
    let n = len(xs)
    while i < n
        present[str(xs[i])] = 1
        i += 1
    let cand = 0
    while contains(present, str(cand))
        cand += 1
    cand

// spg_nim_sum — XOR of all values in xs. Empty list -> 0.
fn spg_nim_sum(xs) -> int
    let acc = 0
    let i = 0
    let n = len(xs)
    while i < n
        acc = (acc ^ xs[i])
        i += 1
    acc

// _spg_dfs — recursive Grundy computation with memoization.
// memo is a dict (string node-index key -> int Grundy value).
// Works correctly for acyclic DAGs (no cycle detection needed per spec).
fn _spg_dfs(adj, node: int, memo) -> int
    if contains(memo, str(node))
        return memo[str(node)]
    let children = adj[node]
    let nc = len(children)
    let child_vals = []
    for ci in 0..nc
        let child = children[ci]
        let cg = _spg_dfs(adj, child, memo)
        push(child_vals, cg)
    let g = spg_mex(child_vals)
    memo[str(node)] = g
    g

// spg_grundy_dag — Grundy value of position `node` in the DAG described by adj.
// adj[i] = list of positions directly reachable from i (adjacency list, 0-indexed).
// Acyclic graph; memoized DFS ensures O(V+E) time.
fn spg_grundy_dag(adj, node) -> int
    let memo = {}
    _spg_dfs(adj, node, memo)
