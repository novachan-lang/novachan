// std/gametheory/kayles.nova — Kayles combinatorial game.
//
// Kayles is played on a row of n pins. A move either removes 1 pin at any
// position (splitting the row into two smaller rows) or removes 2 adjacent pins
// (also potentially splitting the row). The resulting independent rows have
// Grundy values combined via XOR (Sprague-Grundy theorem).
//
// ky_grundy(n) — Grundy value of a single row of n pins (memoised).
// ky_is_winning(n) — true if Grundy(n) != 0 (first player wins).
// ky_grundy_row(rows) — nim-sum (XOR) of Grundy values for multiple rows.
// LEAF — imports nothing.

// ky_mex — minimum excludant of values in a list of reachable Grundy values.
fn ky_mex(reachable: list) -> int
    let m = 0
    let found = 1
    while found
        found = 0
        let i = 0
        let sz = len(reachable)
        while i < sz
            if reachable[i] == m
                found = 1
            i = i + 1
        if found
            m = m + 1
    m

// ky_grundy_memo — compute Grundy(n) with a shared memo dict.
fn ky_grundy_memo(n: int, memo: dict) -> int
    if contains(memo, n)
        return memo[n]
    let reach = []
    // moves: remove 1 pin at position p in row of n
    //   splits into rows of size p and n-1-p; XOR of their Grundy values
    let p = 0
    while p < n
        let left  = ky_grundy_memo(p, memo)
        let right = ky_grundy_memo(n - 1 - p, memo)
        push(reach, (left ^ right))
        p = p + 1
    // moves: remove 2 adjacent pins at positions p,p+1
    //   splits into rows of size p and n-2-p
    for q in 0..(n - 1)
        let left2  = ky_grundy_memo(q, memo)
        let right2 = ky_grundy_memo(n - 2 - q, memo)
        push(reach, (left2 ^ right2))
    let g = ky_mex(reach)
    memo[n] = g
    g

// ky_grundy — Grundy value of a single Kayles row of n pins.
fn ky_grundy(n: int) -> int
    let memo = {}
    ky_grundy_memo(n, memo)

// ky_is_winning — true if Grundy(n) != 0 (first player has a winning strategy).
fn ky_is_winning(n: int) -> bool
    ky_grundy(n) != 0

// ky_grundy_row — nim-sum (XOR) of Grundy values for a list of row sizes.
fn ky_grundy_row(rows: list) -> int
    let memo = {}
    let xsum = 0
    let i = 0
    let sz = len(rows)
    while i < sz
        xsum = (xsum ^ ky_grundy_memo(rows[i], memo))
        i = i + 1
    xsum
