// std/gametheory/bulls_cows.nova — Bulls-and-Cows (Mastermind) scoring.
//
// secret and guess are equal-length integer lists.
// BULLS = exact position matches.
// COWS  = value matches at wrong positions, counted by per-value min of
//         remaining (non-bull) counts — handles repeated digits correctly.
//
// Public API:
//   bc_bulls(secret, guess) -> int
//   bc_cows(secret, guess)  -> int
//   bc_score(secret, guess) -> [bulls, cows]
//
// LEAF — imports nothing.

// bc_bulls — count exact position matches between secret and guess.
fn bc_bulls(secret, guess)
    let n = len(secret)
    let bulls = 0
    for i in 0..n
        if secret[i] == guess[i]
            bulls = bulls + 1
    bulls

// bc_cows — count value matches at wrong positions (repeats handled via frequency counts).
fn bc_cows(secret, guess)
    let n = len(secret)
    let freq_s = {}
    let freq_g = {}
    for i in 0..n
        if secret[i] != guess[i]
            let ks = str(secret[i])
            if contains(freq_s, ks)
                freq_s[ks] = freq_s[ks] + 1
            else
                freq_s[ks] = 1
            let kg = str(guess[i])
            if contains(freq_g, kg)
                freq_g[kg] = freq_g[kg] + 1
            else
                freq_g[kg] = 1
    let cows = 0
    let ks = keys(freq_s)
    for j in 0..len(ks)
        let k = ks[j]
        if contains(freq_g, k)
            let ms = freq_s[k]
            let mg = freq_g[k]
            if ms < mg
                cows = cows + ms
            else
                cows = cows + mg
    cows

// bc_score — return [bulls, cows] for secret vs guess.
fn bc_score(secret, guess)
    let result = []
    push(result, bc_bulls(secret, guess))
    push(result, bc_cows(secret, guess))
    result
