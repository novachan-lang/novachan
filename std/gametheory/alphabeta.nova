// std/gametheory/alphabeta.nova — alpha-beta pruned minimax for zero-sum game trees.
//
// Tree representation: an int leaf holds a terminal score; a list node holds
// child sub-trees.  Root is a MAX node; children alternate MIN/MAX.
//
// Alpha-beta pruning never changes the value — it only skips branches that
// cannot affect the outcome.  alpha = best guaranteed score for MAX so far;
// beta = best guaranteed score for MIN so far.
//
// Public API:
//   ab_value(tree) -> int   minimax value (identical to unpruned minimax).

// _ab_max — MAX node evaluation with alpha-beta window [alpha, beta].
// Returns the true minimax value for this subtree (pruning only skips work).
fn _ab_max(tree, alpha: int, beta: int) -> int
    if type_of(tree) == "int"
        return tree
    let n = len(tree)
    if n == 0
        return 0
    let a = alpha
    for i in 0..n
        let v = _ab_min(tree[i], a, beta)
        if v > a
            a = v
        // beta cut-off: MIN already has a better option elsewhere
        if a >= beta
            return a
    a

// _ab_min — MIN node evaluation with alpha-beta window [alpha, beta].
fn _ab_min(tree, alpha: int, beta: int) -> int
    if type_of(tree) == "int"
        return tree
    let n = len(tree)
    if n == 0
        return 0
    let b = beta
    for i in 0..n
        let v = _ab_max(tree[i], alpha, b)
        if v < b
            b = v
        // alpha cut-off: MAX already has a better option elsewhere
        if b <= alpha
            return b
    b

// ab_value — return the minimax value of tree (alpha-beta pruned, same result as minimax).
fn ab_value(tree) -> int
    // Use a wide initial window: large negative / positive bounds.
    // 1000000 is sufficient for hand-crafted integer game trees.
    _ab_max(tree, -1000000, 1000000)
