// std/gametheory/euclid_game.nova — Euclid game analysis.
//
// Position (a,b) with a,b > 0. A move subtracts a positive multiple of the
// smaller value from the larger, keeping the result >= 0.
// The player who makes one coordinate 0 WINS.
//
// Recursive rule (hi=max(a,b), lo=min(a,b)):
//   if hi % lo == 0  -> current player wins (take exactly hi/lo copies, leaving 0)
//   else if hi >= 2*lo -> current player wins (can choose which parity to leave)
//   else              -> only valid move is (hi-lo, lo); outcome = NOT eg_is_winning(hi-lo, lo)
//
// eg_is_winning(a,b)       -> bool  true if the current player has a winning strategy
// eg_loser_is_current(a,b) -> bool  true if the current player is the loser (= NOT eg_is_winning)
// LEAF — imports nothing.

// eg_is_winning — true if the current player wins at position (a,b).
fn eg_is_winning(a: int, b: int) -> bool
    let hi = a
    let lo = b
    if b > a
        hi = b
        lo = a
    if lo == 0
        return false
    if (hi - (hi / lo) * lo) == 0
        return true
    if hi >= 2 * lo
        return true
    not eg_is_winning(hi - lo, lo)

// eg_loser_is_current — true if the current player is the loser.
fn eg_loser_is_current(a: int, b: int) -> bool
    not eg_is_winning(a, b)
