// std/gametheory/matrix_game.nova — two-player zero-sum matrix game analysis.
//
// Payoff matrix m (list of rows) gives player-1's gain for each (row, col) choice.
// Player 1 (row chooser) maximises; Player 2 (col chooser) minimises.
//
// Public API:
//   mg_row_mins(m)      -> list   min of each row
//   mg_col_maxs(m)      -> list   max of each column
//   mg_maximin(m)       -> int    max of row-mins (player-1's guaranteed floor)
//   mg_minimax(m)       -> int    min of col-maxs (player-2's guaranteed ceiling)
//   mg_has_saddle(m)    -> bool   true iff maximin == minimax (pure strategy saddle)
//   mg_saddle_value(m)  -> int    saddle value if saddle exists, else maximin

// _mg_row_min — return the minimum element in a single row (list of ints).
fn _mg_row_min(row: list) -> int
    let n = len(row)
    let best = row[0]
    let i = 1
    while i < n
        if row[i] < best
            best = row[i]
        i = i + 1
    best

// mg_row_mins — return list of per-row minimums.
fn mg_row_mins(m: list) -> list
    let nrows = len(m)
    let result = []
    let i = 0
    while i < nrows
        push(result, _mg_row_min(m[i]))
        i = i + 1
    result

// mg_col_maxs — return list of per-column maximums.
fn mg_col_maxs(m: list) -> list
    let nrows = len(m)
    let ncols = len(m[0])
    let result = []
    let j = 0
    while j < ncols
        let best = m[0][j]
        let i = 1
        while i < nrows
            if m[i][j] > best
                best = m[i][j]
            i = i + 1
        push(result, best)
        j = j + 1
    result

// _mg_list_max — return the maximum element of a list of ints.
fn _mg_list_max(xs: list) -> int
    let n = len(xs)
    let best = xs[0]
    let i = 1
    while i < n
        if xs[i] > best
            best = xs[i]
        i = i + 1
    best

// _mg_list_min — return the minimum element of a list of ints.
fn _mg_list_min(xs: list) -> int
    let n = len(xs)
    let best = xs[0]
    let i = 1
    while i < n
        if xs[i] < best
            best = xs[i]
        i = i + 1
    best

// mg_maximin — max of row-mins: the best floor player 1 can guarantee.
fn mg_maximin(m: list) -> int
    _mg_list_max(mg_row_mins(m))

// mg_minimax — min of col-maxs: the best ceiling player 2 can enforce.
fn mg_minimax(m: list) -> int
    _mg_list_min(mg_col_maxs(m))

// mg_has_saddle — true iff a pure-strategy Nash equilibrium (saddle point) exists.
fn mg_has_saddle(m: list) -> bool
    mg_maximin(m) == mg_minimax(m)

// mg_saddle_value — the game value: saddle value if one exists, else the maximin lower bound.
fn mg_saddle_value(m: list) -> int
    mg_maximin(m)
