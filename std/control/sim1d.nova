// std/control/sim1d.nova -- 1-D dynamic system simulation and step-response metrics.
// LEAF -- imports NOTHING.
//
// Euler-integration of common 1-D systems (mass-spring-damper, nonlinear pendulum,
// first-order lag, pure integrator) plus standard step-response characterisation metrics.
//
// State representation: systems use a flat list for mutable state (like forge_pid).
//
// Public API:
//   sim_mass_spring_damper(m,k,c,x0,v0,force,dt,steps) -> list  Euler; returns positions
//   sim_msd_step(state,force,dt)                        -> list  one Euler step; mutates state
//   sim_pendulum(length,theta0,dt,steps)                -> list  nonlinear pendulum angles
//   sim_first_order(K,tau,u,dt,steps)                   -> list  first-order lag response
//   sim_integrator(x0,rate,dt,steps)                    -> list  ramp from x0 at rate
//   sim_step_metrics(response,setpoint)                 -> dict  overshoot/settling/rise
//   sim_overshoot(response,setpoint)                    -> float peak overshoot as fraction (0..1+)
//   sim_settling_time_index(response,setpoint,tol,dt)   -> int   index where settled
//   sim_steady_state(response)                          -> float last value of response list
//   sim_peak(response)                                  -> float maximum value in response list
//   sim_rise_time_index(response,setpoint)              -> int   first index >= setpoint
//   sim_energy_msd(state)                               -> float 0.5*m*v^2 + 0.5*k*x^2

// _s1_fabs -- float absolute value (abs() builtin returns int in NOVA).
fn _s1_fabs(x)
    if x < 0.0
        let r = 0.0 - x
        return r
    let v = x * 1.0
    return v

// _s1_sin -- sine via builtin.
fn _s1_sin(x)
    let v = sin(x)
    return v

// sim_mass_spring_damper -- Euler-integrate a mass-spring-damper system.
// m: mass (kg), k: spring constant (N/m), c: damping coefficient (N.s/m).
// x0: initial position, v0: initial velocity, force: constant external force.
// Returns a list of position values at each step (length = steps+1, includes x0).
fn sim_mass_spring_damper(m, k, c, x0, v0, force, dt, steps)
    let positions = []
    let mf = m * 1.0
    let kf = k * 1.0
    let cf = c * 1.0
    let ff = force * 1.0
    let dtf = dt * 1.0
    let x = x0 * 1.0
    let v = v0 * 1.0
    push(positions, x)
    for i in 0..steps
        let spring = kf * x
        let damping = cf * v
        let acc = (ff - spring - damping) / mf
        let new_v = v + acc * dtf
        let new_x = x + v * dtf
        v = new_v
        x = new_x
        push(positions, x)
    return positions

// sim_msd_new -- create a mass-spring-damper state list: [m, k, c, x, v].
// Used with sim_msd_step for incremental stepping.
fn sim_msd_new(m, k, c, x0, v0)
    let s = [m * 1.0, k * 1.0, c * 1.0, x0 * 1.0, v0 * 1.0]
    return s

// sim_msd_step -- advance MSD state one Euler step under given force.
// Mutates state in place and returns state.
fn sim_msd_step(state, force, dt)
    let mf = state[0] * 1.0
    let kf = state[1] * 1.0
    let cf = state[2] * 1.0
    let x = state[3] * 1.0
    let v = state[4] * 1.0
    let dtf = dt * 1.0
    let ff = force * 1.0
    let spring = kf * x
    let damping = cf * v
    let acc = (ff - spring - damping) / mf
    let new_v = v + acc * dtf
    let new_x = x + v * dtf
    state[3] = new_x
    state[4] = new_v
    return state

// sim_pendulum -- Euler-integrate the nonlinear pendulum ODE.
// d2theta/dt2 = -(g/L)*sin(theta); g = 9.81 m/s^2.
// theta0: initial angle (radians), dt: timestep, steps: number of steps.
// Returns list of angle values (length = steps+1, includes theta0).
fn sim_pendulum(length, theta0, dt, steps)
    let angles = []
    let g = 9.81
    let Lf = length * 1.0
    let dtf = dt * 1.0
    let theta = theta0 * 1.0
    let omega = 0.0
    push(angles, theta)
    let coeff = 0.0 - g / Lf
    for i in 0..steps
        let sin_theta = sin(theta)
        let alpha = coeff * sin_theta
        let new_omega = omega + alpha * dtf
        let new_theta = theta + omega * dtf
        omega = new_omega
        theta = new_theta
        push(angles, theta)
    return angles

// sim_first_order -- Euler-integrate a first-order lag: tau*dy/dt + y = K*u.
// K: gain, tau: time constant, u: step input, dt: timestep, steps: number of steps.
// y starts at 0. Returns list of output values (length = steps+1).
fn sim_first_order(K, tau, u, dt, steps)
    let output = []
    let Kf = K * 1.0
    let tauf = tau * 1.0
    let uf = u * 1.0
    let dtf = dt * 1.0
    let y = 0.0
    push(output, y)
    let ss = Kf * uf
    for i in 0..steps
        let dy = (ss - y) / tauf
        let new_y = y + dy * dtf
        y = new_y
        push(output, y)
    return output

// sim_integrator -- pure integrator: x(t) = x0 + rate*t.
// x0: initial value, rate: constant rate of change, dt: timestep, steps: number of steps.
// Returns list of state values (length = steps+1, includes x0).
fn sim_integrator(x0, rate, dt, steps)
    let output = []
    let xf = x0 * 1.0
    let rf = rate * 1.0
    let dtf = dt * 1.0
    push(output, xf)
    for i in 0..steps
        let new_x = xf + rf * dtf
        xf = new_x
        push(output, xf)
    return output

// sim_steady_state -- return the last value of the response list.
// Represents the steady-state value after the system has settled.
fn sim_steady_state(response)
    let n = len(response)
    if n == 0
        return 0.0
    let last = response[n - 1] * 1.0
    return last

// sim_peak -- return the maximum value in the response list.
fn sim_peak(response)
    let n = len(response)
    if n == 0
        return 0.0
    let peak = response[0] * 1.0
    for i in 1..n
        let v = response[i] * 1.0
        if v > peak
            peak = v
    return peak

// sim_overshoot -- compute peak overshoot as a fraction of setpoint.
// Returns (peak - setpoint) / setpoint if peak > setpoint, else 0.0.
// Returns 0.0 if setpoint == 0.0 to avoid division by zero.
fn sim_overshoot(response, setpoint)
    let sp = setpoint * 1.0
    let pk = sim_peak(response)
    if pk <= sp
        return 0.0
    let tiny = 0.000001
    if sp < tiny and sp > (0.0 - tiny)
        return 0.0
    let excess = pk - sp
    let over = excess / sp
    return over

// sim_rise_time_index -- index of first element that reaches or exceeds setpoint.
// Returns -1 if setpoint is never reached.
fn sim_rise_time_index(response, setpoint)
    let sp = setpoint * 1.0
    let n = len(response)
    let i = 0
    while i < n
        let v = response[i] * 1.0
        if v >= sp
            return i
        i = i + 1
    return -1

// sim_settling_time_index -- index after which the response stays within tol of setpoint.
// Returns the last index where it leaves the band (i.e. the settling index is n-1 if
// the whole tail is settled). Returns -1 if never settled.
fn sim_settling_time_index(response, setpoint, tol, dt)
    let sp = setpoint * 1.0
    let tolf = tol * 1.0
    let n = len(response)
    let last_outside = -1
    for i in 0..n
        let v = response[i] * 1.0
        let err = v - sp
        let aerr = _s1_fabs(err)
        if aerr > tolf
            last_outside = i
    if last_outside < 0
        return 0
    let settled = last_outside + 1
    return settled

// sim_step_metrics -- compute standard step-response metrics dict.
// Returns dict with keys: overshoot (float), settling_index (int),
// steady_state (float), peak (float), rise_index (int).
fn sim_step_metrics(response, setpoint)
    let m = {}
    let sp = setpoint * 1.0
    let over = sim_overshoot(response, sp)
    let ss = sim_steady_state(response)
    let pk = sim_peak(response)
    let tol = 0.02
    let si = sim_settling_time_index(response, sp, sp * tol, 0.01)
    let ri = sim_rise_time_index(response, sp)
    m["overshoot"] = over
    m["settling_index"] = si
    m["steady_state"] = ss
    m["peak"] = pk
    m["rise_index"] = ri
    return m

// sim_energy_msd -- compute mechanical energy of a mass-spring-damper state.
// state must be created by sim_msd_new: [m, k, c, x, v].
// E = 0.5*m*v^2 + 0.5*k*x^2 (kinetic + potential).
fn sim_energy_msd(state)
    let mf = state[0] * 1.0
    let kf = state[1] * 1.0
    let x = state[3] * 1.0
    let v = state[4] * 1.0
    let ke = 0.5 * mf * v * v
    let pe = 0.5 * kf * x * x
    let energy = ke + pe
    return energy
