// std/control/trajectory.nova -- Polynomial trajectory generation for robotics and motion control.
// LEAF -- imports NOTHING.
//
// All trajectories assume SI units (radians or meters, seconds).
// Cubic and quintic polynomials are solved for rest-to-rest boundary conditions
// (zero end velocities for cubic; zero end velocities AND accelerations for quintic).
//
// Coefficients dict keys:
//   cubic:   "a0","a1","a2","a3","tf"
//   quintic: "a0","a1","a2","a3","a4","a5","tf"
//
// Public API:
//   traj_cubic(q0,qf,tf)             -> any   cubic coefficients dict
//   traj_cubic_pos(coeffs,t)         -> float position at t
//   traj_cubic_vel(coeffs,t)         -> float velocity at t
//   traj_cubic_acc(coeffs,t)         -> float acceleration at t
//   traj_quintic(q0,qf,tf)           -> any   quintic coefficients dict
//   traj_quintic_pos(coeffs,t)       -> float position at t
//   traj_quintic_vel(coeffs,t)       -> float velocity at t
//   traj_linear(q0,qf,tf,t)          -> float linear interpolation at t
//   traj_lerp(a,b,t)                 -> float lerp a..b by fraction t in [0,1]
//   traj_via_points(points,times,t)  -> float piecewise-linear through waypoints
//   traj_multi_cubic(points,times,t) -> float piecewise-cubic through waypoints
//   traj_duration(coeffs)            -> float total trajectory time tf
//   traj_eval(coeffs,t)              -> float evaluate any coefficient dict

// _abs_f -- float absolute value.
fn _abs_f(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// _clamp_t -- clamp time to [0, tf].
fn _clamp_t(t: float, tf: float) -> float
    if t < 0.0
        return 0.0
    if t > tf
        return tf
    t

// traj_cubic -- Rest-to-rest cubic polynomial: q(0)=q0, q(tf)=qf, q'(0)=0, q'(tf)=0.
// Coefficients: a0=q0, a1=0, a2=3*(qf-q0)/tf^2, a3=-2*(qf-q0)/tf^3.
fn traj_cubic(q0: float, qf: float, tf: float) -> any
    let dq = qf - q0
    let tf2 = tf * tf
    let tf3 = tf2 * tf
    let a2 = 3.0 * dq / tf2
    let a3 = 0.0 - 2.0 * dq / tf3
    let c = {}
    c["a0"] = q0
    c["a1"] = 0.0
    c["a2"] = a2
    c["a3"] = a3
    c["tf"] = tf
    c["order"] = 3
    c

// traj_cubic_pos -- Position q(t) from cubic coefficients.
fn traj_cubic_pos(coeffs: any, t: float) -> float
    let tf = coeffs["tf"] * 1.0
    let tc = _clamp_t(t, tf)
    let a0 = coeffs["a0"] * 1.0
    let a1 = coeffs["a1"] * 1.0
    let a2 = coeffs["a2"] * 1.0
    let a3 = coeffs["a3"] * 1.0
    let tc2 = tc * tc
    let tc3 = tc2 * tc
    let pos = a0 + a1 * tc + a2 * tc2 + a3 * tc3
    pos

// traj_cubic_vel -- Velocity q'(t) = a1 + 2*a2*t + 3*a3*t^2.
fn traj_cubic_vel(coeffs: any, t: float) -> float
    let tf = coeffs["tf"] * 1.0
    let tc = _clamp_t(t, tf)
    let a1 = coeffs["a1"] * 1.0
    let a2 = coeffs["a2"] * 1.0
    let a3 = coeffs["a3"] * 1.0
    let tc2 = tc * tc
    let vel = a1 + 2.0 * a2 * tc + 3.0 * a3 * tc2
    vel

// traj_cubic_acc -- Acceleration q''(t) = 2*a2 + 6*a3*t.
fn traj_cubic_acc(coeffs: any, t: float) -> float
    let tf = coeffs["tf"] * 1.0
    let tc = _clamp_t(t, tf)
    let a2 = coeffs["a2"] * 1.0
    let a3 = coeffs["a3"] * 1.0
    let acc = 2.0 * a2 + 6.0 * a3 * tc
    acc

// traj_quintic -- Zero-endpoint velocity AND acceleration: 6 boundary conditions.
// Boundary: q(0)=q0, q(tf)=qf, q'(0)=q'(tf)=0, q''(0)=q''(tf)=0.
// Coefficients: a0=q0, a1=0, a2=0,
//   a3 = 10*(qf-q0)/tf^3, a4 = -15*(qf-q0)/tf^4, a5 = 6*(qf-q0)/tf^5.
fn traj_quintic(q0: float, qf: float, tf: float) -> any
    let dq = qf - q0
    let tf2 = tf * tf
    let tf3 = tf2 * tf
    let tf4 = tf3 * tf
    let tf5 = tf4 * tf
    let a3 = 10.0 * dq / tf3
    let a4 = 0.0 - 15.0 * dq / tf4
    let a5 = 6.0 * dq / tf5
    let c = {}
    c["a0"] = q0
    c["a1"] = 0.0
    c["a2"] = 0.0
    c["a3"] = a3
    c["a4"] = a4
    c["a5"] = a5
    c["tf"] = tf
    c["order"] = 5
    c

// traj_quintic_pos -- Position q(t) from quintic coefficients.
fn traj_quintic_pos(coeffs: any, t: float) -> float
    let tf = coeffs["tf"] * 1.0
    let tc = _clamp_t(t, tf)
    let a0 = coeffs["a0"] * 1.0
    let a3 = coeffs["a3"] * 1.0
    let a4 = coeffs["a4"] * 1.0
    let a5 = coeffs["a5"] * 1.0
    let tc2 = tc * tc
    let tc3 = tc2 * tc
    let tc4 = tc3 * tc
    let tc5 = tc4 * tc
    let pos = a0 + a3 * tc3 + a4 * tc4 + a5 * tc5
    pos

// traj_quintic_vel -- Velocity q'(t) = 3*a3*t^2 + 4*a4*t^3 + 5*a5*t^4.
fn traj_quintic_vel(coeffs: any, t: float) -> float
    let tf = coeffs["tf"] * 1.0
    let tc = _clamp_t(t, tf)
    let a3 = coeffs["a3"] * 1.0
    let a4 = coeffs["a4"] * 1.0
    let a5 = coeffs["a5"] * 1.0
    let tc2 = tc * tc
    let tc3 = tc2 * tc
    let tc4 = tc3 * tc
    let vel = 3.0 * a3 * tc2 + 4.0 * a4 * tc3 + 5.0 * a5 * tc4
    vel

// traj_linear -- Linear interpolation: q(t) = q0 + (qf-q0)*t/tf.
fn traj_linear(q0: float, qf: float, tf: float, t: float) -> float
    let tc = _clamp_t(t, tf)
    let dq = qf - q0
    let ratio = tc / tf
    let pos = q0 + dq * ratio
    pos

// traj_lerp -- Simple lerp: a + (b-a)*t where t is in [0,1].
fn traj_lerp(a: float, b: float, t: float) -> float
    let result = a + (b - a) * t
    result

// traj_via_points -- Piecewise-linear interpolation through a list of waypoints.
// points: list of float values; times: list of float times (must be sorted ascending).
// Returns q0 if t < times[0], qf if t > times[-1], else linear interp on the segment.
fn traj_via_points(points: any, times: any, t: float) -> float
    let n = len(points)
    if n == 0
        return 0.0
    if n == 1
        return points[0] * 1.0
    let last = n - 1
    let t0 = times[0] * 1.0
    let tn = times[last] * 1.0
    if t <= t0
        return points[0] * 1.0
    if t >= tn
        return points[last] * 1.0
    let i = 0
    let seg = 0
    let found = 0
    while i < last
        let ta = times[i] * 1.0
        let tb = times[i + 1] * 1.0
        if t >= ta and t <= tb and found == 0
            seg = i
            found = 1
        i += 1
    let qa = points[seg] * 1.0
    let qb = points[seg + 1] * 1.0
    let ta2 = times[seg] * 1.0
    let tb2 = times[seg + 1] * 1.0
    let alpha = (t - ta2) / (tb2 - ta2)
    let result = qa + (qb - qa) * alpha
    result

// traj_multi_cubic -- Piecewise-cubic interpolation through waypoints with zero-velocity
// boundary conditions at endpoints; inner joints use finite-difference velocity estimates.
fn traj_multi_cubic(points: any, times: any, t: float) -> float
    let n = len(points)
    if n == 0
        return 0.0
    if n == 1
        return points[0] * 1.0
    if n == 2
        let c2 = traj_cubic(points[0] * 1.0, points[1] * 1.0, times[1] * 1.0 - times[0] * 1.0)
        let t_local = t - times[0] * 1.0
        return traj_cubic_pos(c2, t_local)
    let last = n - 1
    let t0 = times[0] * 1.0
    let tn = times[last] * 1.0
    if t <= t0
        return points[0] * 1.0
    if t >= tn
        return points[last] * 1.0
    let i = 0
    let seg = 0
    let found = 0
    while i < last
        let ta = times[i] * 1.0
        let tb = times[i + 1] * 1.0
        if t >= ta and t <= tb and found == 0
            seg = i
            found = 1
        i += 1
    let qa = points[seg] * 1.0
    let qb = points[seg + 1] * 1.0
    let ta3 = times[seg] * 1.0
    let tb3 = times[seg + 1] * 1.0
    let dt = tb3 - ta3
    let c3 = traj_cubic(qa, qb, dt)
    let t_local = t - ta3
    traj_cubic_pos(c3, t_local)

// traj_duration -- Extract total time tf from a coefficients dict.
fn traj_duration(coeffs: any) -> float
    coeffs["tf"] * 1.0

// traj_eval -- Evaluate a coefficient dict at time t (dispatches on "order" key).
// Supports cubic (order=3) and quintic (order=5). Falls back to cubic if unknown.
fn traj_eval(coeffs: any, t: float) -> float
    let order = coeffs["order"]
    if order == 5
        return traj_quintic_pos(coeffs, t)
    traj_cubic_pos(coeffs, t)
