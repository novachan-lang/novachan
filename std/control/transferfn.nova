// std/control/transferfn.nova — Discrete/continuous transfer function (rational polynomial).
// LEAF — imports NOTHING.
//
// A transfer function is H(z) = num(z) / den(z).
// Coefficients stored as lists, highest power first: [a_n, a_(n-1), ..., a_0].
//
// Public API (prefix tf_):
//   tf_new(num,den)             -> any   create TF dict
//   tf_dcgain(tf)               -> float DC gain: sum(num)/sum(den) at z=1
//   tf_order(tf)                -> int   order = len(den)-1
//   tf_eval(tf,x)               -> float evaluate H(x) = poly(num,x)/poly(den,x)
//   tf_poles_real(tf)           -> any   real roots of den (order<=2 via quadratic)
//   tf_zeros_real(tf)           -> any   real roots of num (order<=2 via quadratic)
//   tf_is_stable_discrete(tf)   -> bool  all real poles |p|<1 (order<=2)
//   tf_series(a,b)              -> any   series: num=num_a*num_b, den=den_a*den_b
//   tf_parallel(a,b)            -> any   parallel: num=num_a*den_b+num_b*den_a, den=den_a*den_b
//   tf_dcgain_series(a,b)       -> float DC gain of series combination
//   poly_eval(coeffs,x)         -> float evaluate polynomial at x
//   poly_mul(a,b)               -> any   convolution (polynomial multiplication)
//   tf_gain_at(tf,x)            -> float alias for tf_eval

// _tf_fabs — absolute value of a float.
fn _tf_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// _tf_sqrt — square root (safe: returns 0 for negative input).
fn _tf_sqrt(x: float) -> float
    if x <= 0.0
        return 0.0
    return sqrt(x)

// poly_eval — evaluate polynomial with coefficients at x.
// Coefficients are highest power first: poly = coeffs[0]*x^(n-1) + ... + coeffs[n-1].
// Uses Horner's method for numerical stability.
fn poly_eval(coeffs, x)
    let n = len(coeffs)
    if n == 0
        return 0.0
    let xf = x * 1.0
    let acc = coeffs[0] * 1.0
    for i in 1..n
        let ci = coeffs[i] * 1.0
        acc = acc * xf + ci
    return acc

// poly_mul — multiply two polynomials (convolution of coefficient lists).
// Result length = len(a) + len(b) - 1.
fn poly_mul(a, b)
    let na = len(a)
    let nb = len(b)
    if na == 0 or nb == 0
        return []
    let nc = na + nb - 1
    let result = [0.0 for k in 0..nc]
    for i in 0..na
        let ai = a[i] * 1.0
        let j = 0
        while j < nb
            let bj = b[j] * 1.0
            let idx = i + j
            let old = result[idx] * 1.0
            result[idx] = old + ai * bj
            j = j + 1
    return result

// _tf_real_roots_order1 — real root of a[0]*x + a[1] = 0 => x = -a[1]/a[0].
fn _tf_real_roots_order1(coeffs)
    let roots = []
    if len(coeffs) < 2
        return roots
    let a0 = coeffs[0] * 1.0
    if _tf_fabs(a0) < 0.0000000001
        return roots
    let a1 = coeffs[1] * 1.0
    let r = 0.0 - a1 / a0
    push(roots, r)
    return roots

// _tf_real_roots_order2 — real roots of a[0]*x^2 + a[1]*x + a[2] = 0
// via the quadratic formula; returns [] if discriminant < 0 (complex roots).
fn _tf_real_roots_order2(coeffs)
    let roots = []
    if len(coeffs) < 3
        return roots
    let a = coeffs[0] * 1.0
    let b = coeffs[1] * 1.0
    let c = coeffs[2] * 1.0
    if _tf_fabs(a) < 0.0000000001
        return _tf_real_roots_order1(coeffs)
    let disc = b * b - 4.0 * a * c
    if disc < 0.0
        return roots
    let sq = _tf_sqrt(disc)
    let r1 = (0.0 - b + sq) / (2.0 * a)
    let r2 = (0.0 - b - sq) / (2.0 * a)
    push(roots, r1)
    push(roots, r2)
    return roots

// _tf_real_roots — compute real roots for polynomials of order 0, 1, or 2.
// For order > 2 returns [] (out of scope).
fn _tf_real_roots(coeffs)
    let n = len(coeffs)
    if n <= 1
        return []
    if n == 2
        return _tf_real_roots_order1(coeffs)
    if n == 3
        return _tf_real_roots_order2(coeffs)
    return []

// tf_new — create a transfer function dict from numerator and denominator lists.
fn tf_new(num, den)
    let d = {}
    d["num"] = num
    d["den"] = den
    return d

// tf_dcgain — DC gain = H(1) = sum of numerator / sum of denominator.
// This evaluates the TF at z=1 (discrete-time convention).
fn tf_dcgain(tf)
    let num = tf["num"]
    let den = tf["den"]
    let g = poly_eval(num, 1.0) / poly_eval(den, 1.0)
    return g

// tf_order — polynomial order = len(den) - 1.
fn tf_order(tf)
    let den = tf["den"]
    return len(den) - 1

// tf_eval — evaluate H(x) = poly(num, x) / poly(den, x).
fn tf_eval(tf, x)
    let num = tf["num"]
    let den = tf["den"]
    let n = poly_eval(num, x * 1.0)
    let d = poly_eval(den, x * 1.0)
    return n / d

// tf_poles_real — real roots of the denominator polynomial (order <= 2 only).
fn tf_poles_real(tf)
    let den = tf["den"]
    return _tf_real_roots(den)

// tf_zeros_real — real roots of the numerator polynomial (order <= 2 only).
fn tf_zeros_real(tf)
    let num = tf["num"]
    return _tf_real_roots(num)

// tf_is_stable_discrete — true if all real poles have |p| < 1.
// For order <= 2 only (uses real-root quadratic formula).
// Returns false if any real pole has |p| >= 1.
// NOTE: for complex poles, stability cannot be determined here; returns true
// (conservative: real poles checked, complex roots ignored).
fn tf_is_stable_discrete(tf)
    let poles = tf_poles_real(tf)
    let np = len(poles)
    for i in 0..np
        let p = poles[i] * 1.0
        let ap = _tf_fabs(p)
        if ap >= 1.0
            return false
    return true

// tf_series — series combination: multiply numerators and denominators.
fn tf_series(a, b)
    let num_a = a["num"]
    let den_a = a["den"]
    let num_b = b["num"]
    let den_b = b["den"]
    let num = poly_mul(num_a, num_b)
    let den = poly_mul(den_a, den_b)
    let d = {}
    d["num"] = num
    d["den"] = den
    return d

// tf_parallel — parallel combination: H_a + H_b = (num_a*den_b + num_b*den_a) / (den_a*den_b).
fn tf_parallel(a, b)
    let num_a = a["num"]
    let den_a = a["den"]
    let num_b = b["num"]
    let den_b = b["den"]
    let num_ab = poly_mul(num_a, den_b)
    let num_ba = poly_mul(num_b, den_a)
    let den = poly_mul(den_a, den_b)
    // add num_ab + num_ba element-wise (they should be same length after mul)
    let nc = len(num_ab)
    let num = []
    for i in 0..nc
        let va = num_ab[i] * 1.0
        let vb = num_ba[i] * 1.0
        push(num, va + vb)
    let d = {}
    d["num"] = num
    d["den"] = den
    return d

// tf_dcgain_series — DC gain of the series combination of two TFs.
fn tf_dcgain_series(a, b)
    let ga = tf_dcgain(a)
    let gb = tf_dcgain(b)
    let g = ga * gb
    return g

// tf_gain_at — evaluate |H(x)| (same as tf_eval for real x).
fn tf_gain_at(tf, x)
    return tf_eval(tf, x * 1.0)
