// std/control/so3.nova — SO(3) rotation matrix library (3-D orientation).
// A rotation matrix is a FLAT 9-element list, row-major: index = row*3+col.
// All inputs are floats; outputs are NEW lists; inputs never mutated.
// LEAF — imports NOTHING.
//
// FLOAT HAZARDS obeyed:
//   • Every element extracted via *1.0 to defeat int/float compare unsoundness.
//   • Float-return footgun: big expressions split into named lets before return.
//   • acos computed inline via atan2(sqrt(1-x*x), x) — never calls a helper
//     that returns float and is then fed into another expression.
//   • sqrt() always bound to a named let before arithmetic use.
//
// API:
//   so3_identity()                  -> any  [1,0,0,0,1,0,0,0,1]
//   so3_rot_x(a)                    -> any  rotation by angle a about X
//   so3_rot_y(a)                    -> any  rotation by angle a about Y
//   so3_rot_z(a)                    -> any  rotation by angle a about Z
//   so3_mul(A, B)                   -> any  3x3 matrix multiply
//   so3_transpose(M)                -> any  3x3 transpose
//   so3_apply(M, v)                 -> any  M * v (v is 3-list)
//   so3_from_axis_angle(ax,ay,az,a) -> any  Rodrigues formula
//   so3_from_euler(roll,pitch,yaw)  -> any  Rz*Ry*Rx convention
//   so3_to_euler(M)                 -> any  extract [roll,pitch,yaw] via atan2
//   so3_det(M)                      -> float determinant
//   so3_trace(M)                    -> float trace (sum of diagonal)
//   so3_is_valid(M)                 -> bool det~1 and M*M^T~I
//   so3_angle(M)                    -> float rotation angle = acos((trace-1)/2)

// so3_identity — return the 3x3 identity matrix as a flat 9-list.
fn so3_identity() -> any
    let m = []
    push(m, 1.0)
    push(m, 0.0)
    push(m, 0.0)
    push(m, 0.0)
    push(m, 1.0)
    push(m, 0.0)
    push(m, 0.0)
    push(m, 0.0)
    push(m, 1.0)
    m

// so3_rot_x — elementary rotation about the X axis by angle a (radians).
fn so3_rot_x(a: float) -> any
    let c = cos(a)
    let s = sin(a)
    let ns = 0.0 - s
    let m = []
    push(m, 1.0)
    push(m, 0.0)
    push(m, 0.0)
    push(m, 0.0)
    push(m, c)
    push(m, ns)
    push(m, 0.0)
    push(m, s)
    push(m, c)
    m

// so3_rot_y — elementary rotation about the Y axis by angle a (radians).
fn so3_rot_y(a: float) -> any
    let c = cos(a)
    let s = sin(a)
    let ns = 0.0 - s
    let m = []
    push(m, c)
    push(m, 0.0)
    push(m, s)
    push(m, 0.0)
    push(m, 1.0)
    push(m, 0.0)
    push(m, ns)
    push(m, 0.0)
    push(m, c)
    m

// so3_rot_z — elementary rotation about the Z axis by angle a (radians).
fn so3_rot_z(a: float) -> any
    let c = cos(a)
    let s = sin(a)
    let ns = 0.0 - s
    let m = []
    push(m, c)
    push(m, ns)
    push(m, 0.0)
    push(m, s)
    push(m, c)
    push(m, 0.0)
    push(m, 0.0)
    push(m, 0.0)
    push(m, 1.0)
    m

// so3_mul — 3x3 matrix multiply C = A*B (both flat 9-lists).
fn so3_mul(A: any, B: any) -> any
    let a00 = A[0] * 1.0
    let a01 = A[1] * 1.0
    let a02 = A[2] * 1.0
    let a10 = A[3] * 1.0
    let a11 = A[4] * 1.0
    let a12 = A[5] * 1.0
    let a20 = A[6] * 1.0
    let a21 = A[7] * 1.0
    let a22 = A[8] * 1.0
    let b00 = B[0] * 1.0
    let b01 = B[1] * 1.0
    let b02 = B[2] * 1.0
    let b10 = B[3] * 1.0
    let b11 = B[4] * 1.0
    let b12 = B[5] * 1.0
    let b20 = B[6] * 1.0
    let b21 = B[7] * 1.0
    let b22 = B[8] * 1.0
    let c00 = a00 * b00 + a01 * b10 + a02 * b20
    let c01 = a00 * b01 + a01 * b11 + a02 * b21
    let c02 = a00 * b02 + a01 * b12 + a02 * b22
    let c10 = a10 * b00 + a11 * b10 + a12 * b20
    let c11 = a10 * b01 + a11 * b11 + a12 * b21
    let c12 = a10 * b02 + a11 * b12 + a12 * b22
    let c20 = a20 * b00 + a21 * b10 + a22 * b20
    let c21 = a20 * b01 + a21 * b11 + a22 * b21
    let c22 = a20 * b02 + a21 * b12 + a22 * b22
    let m = []
    push(m, c00)
    push(m, c01)
    push(m, c02)
    push(m, c10)
    push(m, c11)
    push(m, c12)
    push(m, c20)
    push(m, c21)
    push(m, c22)
    m

// so3_transpose — transpose a flat 3x3 matrix.
fn so3_transpose(M: any) -> any
    let m00 = M[0] * 1.0
    let m01 = M[1] * 1.0
    let m02 = M[2] * 1.0
    let m10 = M[3] * 1.0
    let m11 = M[4] * 1.0
    let m12 = M[5] * 1.0
    let m20 = M[6] * 1.0
    let m21 = M[7] * 1.0
    let m22 = M[8] * 1.0
    let t = []
    push(t, m00)
    push(t, m10)
    push(t, m20)
    push(t, m01)
    push(t, m11)
    push(t, m21)
    push(t, m02)
    push(t, m12)
    push(t, m22)
    t

// so3_apply — multiply 3x3 matrix M by column vector v (3-list), return 3-list.
fn so3_apply(M: any, v: any) -> any
    let m00 = M[0] * 1.0
    let m01 = M[1] * 1.0
    let m02 = M[2] * 1.0
    let m10 = M[3] * 1.0
    let m11 = M[4] * 1.0
    let m12 = M[5] * 1.0
    let m20 = M[6] * 1.0
    let m21 = M[7] * 1.0
    let m22 = M[8] * 1.0
    let v0 = v[0] * 1.0
    let v1 = v[1] * 1.0
    let v2 = v[2] * 1.0
    let r0 = m00 * v0 + m01 * v1 + m02 * v2
    let r1 = m10 * v0 + m11 * v1 + m12 * v2
    let r2 = m20 * v0 + m21 * v1 + m22 * v2
    let out = []
    push(out, r0)
    push(out, r1)
    push(out, r2)
    out

// so3_from_axis_angle — Rodrigues rotation formula.
// Axis (ax,ay,az) is normalized internally; angle in radians.
fn so3_from_axis_angle(ax: float, ay: float, az: float, angle: float) -> any
    let mag2 = ax * ax + ay * ay + az * az
    let mag = sqrt(mag2)
    let safe = mag
    if safe < 0.0000001
        safe = 1.0
    let inv = 1.0 / safe
    let ux = ax * inv
    let uy = ay * inv
    let uz = az * inv
    let c = cos(angle)
    let s = sin(angle)
    let t = 1.0 - c
    let m00 = t * ux * ux + c
    let m01 = t * ux * uy - s * uz
    let m02 = t * ux * uz + s * uy
    let m10 = t * ux * uy + s * uz
    let m11 = t * uy * uy + c
    let m12 = t * uy * uz - s * ux
    let m20 = t * ux * uz - s * uy
    let m21 = t * uy * uz + s * ux
    let m22 = t * uz * uz + c
    let m = []
    push(m, m00)
    push(m, m01)
    push(m, m02)
    push(m, m10)
    push(m, m11)
    push(m, m12)
    push(m, m20)
    push(m, m21)
    push(m, m22)
    m

// so3_from_euler — build rotation matrix from roll/pitch/yaw (Rz * Ry * Rx order).
// roll=rotation about X, pitch=about Y, yaw=about Z.
fn so3_from_euler(roll: float, pitch: float, yaw: float) -> any
    let cr = cos(roll)
    let sr = sin(roll)
    let cp = cos(pitch)
    let sp = sin(pitch)
    let cy = cos(yaw)
    let sy = sin(yaw)
    // Rz * Ry * Rx expanded elementwise
    let m00 = cy * cp
    let m01 = cy * sp * sr - sy * cr
    let m02 = cy * sp * cr + sy * sr
    let m10 = sy * cp
    let m11 = sy * sp * sr + cy * cr
    let m12 = sy * sp * cr - cy * sr
    let m20 = 0.0 - sp
    let m21 = cp * sr
    let m22 = cp * cr
    let m = []
    push(m, m00)
    push(m, m01)
    push(m, m02)
    push(m, m10)
    push(m, m11)
    push(m, m12)
    push(m, m20)
    push(m, m21)
    push(m, m22)
    m

// so3_to_euler — extract [roll, pitch, yaw] from a Rz*Ry*Rx rotation matrix.
// All trig kept inline to avoid float-return aliasing bug.
fn so3_to_euler(M: any) -> any
    let m00 = M[0] * 1.0
    let m10 = M[3] * 1.0
    let m20 = M[6] * 1.0
    let m21 = M[7] * 1.0
    let m22 = M[8] * 1.0
    // pitch = asin(-m20) = atan2(-m20, sqrt(m00^2+m10^2))
    let sqt2 = m00 * m00 + m10 * m10
    let sq2 = sqrt(sqt2)
    let pitch = atan2(0.0 - m20, sq2)
    // roll = atan2(m21, m22)
    let roll = atan2(m21, m22)
    // yaw = atan2(m10, m00)
    let yaw = atan2(m10, m00)
    let out = []
    push(out, roll)
    push(out, pitch)
    push(out, yaw)
    out

// so3_det — determinant of a 3x3 matrix (should be ~1 for valid rotation).
fn so3_det(M: any) -> float
    let m00 = M[0] * 1.0
    let m01 = M[1] * 1.0
    let m02 = M[2] * 1.0
    let m10 = M[3] * 1.0
    let m11 = M[4] * 1.0
    let m12 = M[5] * 1.0
    let m20 = M[6] * 1.0
    let m21 = M[7] * 1.0
    let m22 = M[8] * 1.0
    let t0 = m00 * (m11 * m22 - m12 * m21)
    let t1 = m01 * (m10 * m22 - m12 * m20)
    let t2 = m02 * (m10 * m21 - m11 * m20)
    let d = t0 - t1 + t2
    d

// so3_trace — sum of diagonal elements.
fn so3_trace(M: any) -> float
    let m00 = M[0] * 1.0
    let m11 = M[4] * 1.0
    let m22 = M[8] * 1.0
    let tr = m00 + m11 + m22
    tr

// so3_is_valid — true if det~1 and M*M^T~identity (within 0.001).
fn so3_is_valid(M: any) -> bool
    let d = so3_det(M)
    let dd = d - 1.0
    if dd < 0.0
        dd = 0.0 - dd
    if dd > 0.001
        return false
    let T = so3_transpose(M)
    let R = so3_mul(M, T)
    // check diagonal ~1 and off-diagonal ~0
    let i = 0
    while i < 9
        let row = i / 3
        let col = i - row * 3
        let v = R[i] * 1.0
        let want = 0.0
        if row == col
            want = 1.0
        let dv = v - want
        if dv < 0.0
            dv = 0.0 - dv
        if dv > 0.001
            return false
        i = i + 1
    true

// so3_angle — rotation angle = acos((trace - 1) / 2), via atan2-based acos.
// acos(x) = atan2(sqrt(1 - x*x), x)
fn so3_angle(M: any) -> float
    let tr = so3_trace(M)
    let x = (tr - 1.0) * 0.5
    // clamp to [-1, 1] to guard numerical noise
    let cx = x
    if cx > 1.0
        cx = 1.0
    if cx < 0.0 - 1.0
        cx = 0.0 - 1.0
    let one_minus_cx2 = 1.0 - cx * cx
    let sq = sqrt(one_minus_cx2)
    let angle = atan2(sq, cx)
    angle
