// std/control/quatext.nova — quaternion orientation extensions (qe_ prefix).
// A quaternion is a 4-element list [w, x, y, z].
// All inputs are floats; outputs are NEW lists; inputs never mutated.
// LEAF — imports NOTHING.
//
// FLOAT HAZARDS obeyed:
//   • All elements extracted via *1.0 for int/float soundness.
//   • Float-return footgun: big expressions split into named lets before return.
//   • asin/atan2 trig kept INLINE inside each function body.
//   • sqrt() always bound to a named let before arithmetic.
//   • abs via (if x<0.0 then 0.0-x else x) — builtin abs() returns int.
//
// API:
//   qe_identity()                       -> any  [1,0,0,0]
//   qe_norm(q)                          -> any  normalize to unit quaternion
//   qe_dot(a,b)                         -> float dot product
//   qe_conjugate(q)                     -> any  [w,-x,-y,-z]
//   qe_mul(a,b)                         -> any  Hamilton product
//   qe_from_axis_angle(ax,ay,az,angle)  -> any  axis-angle to quaternion
//   qe_from_euler(roll,pitch,yaw)       -> any  Euler ZYX -> quaternion
//   qe_to_euler(q)                      -> any  [roll,pitch,yaw] via atan2 inline
//   qe_slerp(a,b,t)                     -> any  spherical linear interpolation
//   qe_nlerp(a,b,t)                     -> any  normalized lerp
//   qe_angle_between(a,b)               -> float angle between two orientations
//   qe_rotate_vec(q,vx,vy,vz)          -> any  rotate vector by quaternion
//   qe_inverse(q)                       -> any  unit: conjugate; general: conj/norm^2

// qe_identity — return the identity quaternion [1,0,0,0].
fn qe_identity() -> any
    [1.0, 0.0, 0.0, 0.0]

// qe_dot — dot product of two quaternions (treated as 4-vectors).
fn qe_dot(a: any, b: any) -> float
    let aw = a[0] * 1.0
    let ax = a[1] * 1.0
    let ay = a[2] * 1.0
    let az = a[3] * 1.0
    let bw = b[0] * 1.0
    let bx = b[1] * 1.0
    let by = b[2] * 1.0
    let bz = b[3] * 1.0
    let d = aw * bw + ax * bx + ay * by + az * bz
    d

// qe_norm — normalize quaternion to unit length; returns identity if near-zero.
fn qe_norm(q: any) -> any
    let qw = q[0] * 1.0
    let qx = q[1] * 1.0
    let qy = q[2] * 1.0
    let qz = q[3] * 1.0
    let mag2 = qw * qw + qx * qx + qy * qy + qz * qz
    let mag = sqrt(mag2)
    let safe = 1.0 if mag < 0.0000001 else mag
    let inv = 1.0 / safe
    let nw = qw * inv
    let nx = qx * inv
    let ny = qy * inv
    let nz = qz * inv
    [nw, nx, ny, nz]

// qe_conjugate — return [w, -x, -y, -z].
fn qe_conjugate(q: any) -> any
    let qw = q[0] * 1.0
    let qx = q[1] * 1.0
    let qy = q[2] * 1.0
    let qz = q[3] * 1.0
    // NOTE: kept as 0.0 - x (not unary -x): a NOVA float unary minus lowers to
    // `fsub -0.0, x` while `0.0 - x` lowers to `fsub 0.0, x` — these differ in the
    // sign of zero when x is exactly 0.0 (a real, frequent case for quaternion axes).
    [qw, 0.0 - qx, 0.0 - qy, 0.0 - qz]

// qe_mul — Hamilton product of two quaternions.
fn qe_mul(a: any, b: any) -> any
    let aw = a[0] * 1.0
    let ax = a[1] * 1.0
    let ay = a[2] * 1.0
    let az = a[3] * 1.0
    let bw = b[0] * 1.0
    let bx = b[1] * 1.0
    let by = b[2] * 1.0
    let bz = b[3] * 1.0
    let rw = aw * bw - ax * bx - ay * by - az * bz
    let rx = aw * bx + ax * bw + ay * bz - az * by
    let ry = aw * by - ax * bz + ay * bw + az * bx
    let rz = aw * bz + ax * by - ay * bx + az * bw
    [rw, rx, ry, rz]

// qe_from_axis_angle — build unit quaternion from axis (ax,ay,az) and angle.
fn qe_from_axis_angle(ax: float, ay: float, az: float, angle: float) -> any
    let mag2 = ax * ax + ay * ay + az * az
    let mag = sqrt(mag2)
    let safe = 1.0 if mag < 0.0000001 else mag
    let inv = 1.0 / safe
    let nx = ax * inv
    let ny = ay * inv
    let nz = az * inv
    let half = angle * 0.5
    let qw = cos(half)
    let s = sin(half)
    let qx = nx * s
    let qy = ny * s
    let qz = nz * s
    [qw, qx, qy, qz]

// qe_from_euler — build quaternion from roll/pitch/yaw (ZYX / Tait-Bryan order).
fn qe_from_euler(roll: float, pitch: float, yaw: float) -> any
    let cr = cos(roll * 0.5)
    let sr = sin(roll * 0.5)
    let cp = cos(pitch * 0.5)
    let sp = sin(pitch * 0.5)
    let cy = cos(yaw * 0.5)
    let sy = sin(yaw * 0.5)
    let qw = cr * cp * cy + sr * sp * sy
    let qx = sr * cp * cy - cr * sp * sy
    let qy = cr * sp * cy + sr * cp * sy
    let qz = cr * cp * sy - sr * sp * cy
    [qw, qx, qy, qz]

// qe_to_euler — extract [roll, pitch, yaw] from a unit quaternion (ZYX order).
// All trig kept INLINE to avoid float-return aliasing footgun.
fn qe_to_euler(q: any) -> any
    let qw = q[0] * 1.0
    let qx = q[1] * 1.0
    let qy = q[2] * 1.0
    let qz = q[3] * 1.0
    // roll (x-axis rotation): atan2(2*(qw*qx+qy*qz), 1-2*(qx^2+qy^2))
    let sinr_cosp = 2.0 * (qw * qx + qy * qz)
    let cosr_cosp = 1.0 - 2.0 * (qx * qx + qy * qy)
    let roll = atan2(sinr_cosp, cosr_cosp)
    // pitch (y-axis rotation): asin(2*(qw*qy - qz*qx)) via atan2
    let sinp_raw = 2.0 * (qw * qy - qz * qx)
    let sinp = 1.0 if sinp_raw > 1.0 else (-1.0 if sinp_raw < -1.0 else sinp_raw)
    let cosp_term = 1.0 - sinp * sinp
    let cosp = sqrt(cosp_term)
    let pitch = atan2(sinp, cosp)
    // yaw (z-axis rotation): atan2(2*(qw*qz+qx*qy), 1-2*(qy^2+qz^2))
    let siny_cosp = 2.0 * (qw * qz + qx * qy)
    let cosy_cosp = 1.0 - 2.0 * (qy * qy + qz * qz)
    let yaw = atan2(siny_cosp, cosy_cosp)
    [roll, pitch, yaw]

// qe_nlerp — normalized linear interpolation between two quaternions.
fn qe_nlerp(a: any, b: any, t: float) -> any
    let aw = a[0] * 1.0
    let ax = a[1] * 1.0
    let ay = a[2] * 1.0
    let az = a[3] * 1.0
    let bw = b[0] * 1.0
    let bx = b[1] * 1.0
    let by = b[2] * 1.0
    let bz = b[3] * 1.0
    let s = 1.0 - t
    let lw = aw * s + bw * t
    let lx = ax * s + bx * t
    let ly = ay * s + by * t
    let lz = az * s + bz * t
    let mag2 = lw * lw + lx * lx + ly * ly + lz * lz
    let mag = sqrt(mag2)
    let safe = 1.0 if mag < 0.0000001 else mag
    let inv = 1.0 / safe
    [lw * inv, lx * inv, ly * inv, lz * inv]

// qe_slerp — spherical linear interpolation. Falls back to nlerp when dot ~ 1.
fn qe_slerp(a: any, b: any, t: float) -> any
    let aw = a[0] * 1.0
    let ax = a[1] * 1.0
    let ay = a[2] * 1.0
    let az = a[3] * 1.0
    let bw = b[0] * 1.0
    let bx = b[1] * 1.0
    let by = b[2] * 1.0
    let bz = b[3] * 1.0
    let dot = aw * bw + ax * bx + ay * by + az * bz
    // ensure shortest path (0.0 - x, not -x: preserves sign of zero, see qe_conjugate note)
    let flip = dot < 0.0
    let rbw = 0.0 - bw if flip else bw
    let rbx = 0.0 - bx if flip else bx
    let rby = 0.0 - by if flip else by
    let rbz = 0.0 - bz if flip else bz
    let rdot = 0.0 - dot if flip else dot
    // if nearly parallel, fall back to nlerp
    if rdot > 0.9995
        let s = 1.0 - t
        let lw = aw * s + rbw * t
        let lx = ax * s + rbx * t
        let ly = ay * s + rby * t
        let lz = az * s + rbz * t
        let mag2 = lw * lw + lx * lx + ly * ly + lz * lz
        let mag = sqrt(mag2)
        let safe = 1.0 if mag < 0.0000001 else mag
        let inv = 1.0 / safe
        return [lw * inv, lx * inv, ly * inv, lz * inv]
    // full slerp: theta = acos(dot) inline via atan2
    let clamp = 1.0 if rdot > 1.0 else (-1.0 if rdot < -1.0 else rdot)
    let one_m_c2 = 1.0 - clamp * clamp
    let sq = sqrt(one_m_c2)
    let theta = atan2(sq, clamp)
    let sin_theta = sq
    let safe_st = 0.0000001 if sin_theta < 0.0000001 else sin_theta
    let inv_st = 1.0 / safe_st
    let fa = sin((1.0 - t) * theta) * inv_st
    let fb = sin(t * theta) * inv_st
    let rw = aw * fa + rbw * fb
    let rx = ax * fa + rbx * fb
    let ry = ay * fa + rby * fb
    let rz = az * fa + rbz * fb
    [rw, rx, ry, rz]

// qe_angle_between — angle (radians) between two unit quaternions.
fn qe_angle_between(a: any, b: any) -> float
    let d = qe_dot(a, b)
    let ad0 = -d if d < 0.0 else d
    let ad = 1.0 if ad0 > 1.0 else ad0
    let one_m_d2 = 1.0 - ad * ad
    let sq = sqrt(one_m_d2)
    let theta = atan2(sq, ad)
    let ang = theta * 2.0
    ang

// qe_rotate_vec — rotate vector (vx,vy,vz) by unit quaternion q.
// Uses the optimized formula: t = 2*cross(qxyz, v); v' = v + qw*t + cross(qxyz, t).
fn qe_rotate_vec(q: any, vx: float, vy: float, vz: float) -> any
    let qw = q[0] * 1.0
    let qx = q[1] * 1.0
    let qy = q[2] * 1.0
    let qz = q[3] * 1.0
    let tx = 2.0 * (qy * vz - qz * vy)
    let ty = 2.0 * (qz * vx - qx * vz)
    let tz = 2.0 * (qx * vy - qy * vx)
    let rx = vx + qw * tx + (qy * tz - qz * ty)
    let ry = vy + qw * ty + (qz * tx - qx * tz)
    let rz = vz + qw * tz + (qx * ty - qy * tx)
    [rx, ry, rz]

// qe_inverse — inverse of a quaternion (conjugate / norm^2).
// For unit quaternions this equals conjugate; handles non-unit safely.
fn qe_inverse(q: any) -> any
    let qw = q[0] * 1.0
    let qx = q[1] * 1.0
    let qy = q[2] * 1.0
    let qz = q[3] * 1.0
    let n2 = qw * qw + qx * qx + qy * qy + qz * qz
    let safe = 1.0 if n2 < 0.0000001 else n2
    let inv = 1.0 / safe
    // 0.0 - x, not -x: preserves sign of zero, see qe_conjugate note above.
    let nx = 0.0 - qx
    let ny = 0.0 - qy
    let nz = 0.0 - qz
    [qw * inv, nx * inv, ny * inv, nz * inv]
