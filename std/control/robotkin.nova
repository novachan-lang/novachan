// std/control/robotkin.nova — 2-link planar robot arm kinematics (rk_ prefix).
// All angles in radians; lengths in consistent SI units.
// LEAF — imports NOTHING.
//
// FLOAT HAZARDS obeyed:
//   • Elements extracted via *1.0; abs via (if x<0.0 then 0.0-x else x).
//   • sqrt() always bound to a named let.
//   • Float-return: big expressions split into named lets before return.
//   • IK inline: law of cosines + atan2 never split across helper fns.
//
// API:
//   rk_fk(l1,l2,t1,t2)        -> any    [x,y] end-effector position
//   rk_ik(l1,l2,x,y)          -> any    [t1,t2] elbow-down, or [] if unreachable
//   rk_reachable(l1,l2,x,y)   -> bool   distance in [|l1-l2|, l1+l2]
//   rk_workspace_max(l1,l2)   -> float  l1+l2
//   rk_workspace_min(l1,l2)   -> float  |l1-l2|
//   rk_jacobian(l1,l2,t1,t2)  -> any    2x2 flat Jacobian
//   rk_jacobian_det(l1,l2,t1,t2)-> float determinant of Jacobian
//   rk_is_singular(l1,l2,t1,t2)-> bool  |det| < eps (arm straight/folded)
//   rk_elbow_up(l1,l2,x,y)    -> any    [t1,t2] elbow-up IK solution
//   rk_elbow_down(l1,l2,x,y)  -> any    [t1,t2] elbow-down IK solution
//   rk_reach_distance(x,y)    -> float  sqrt(x^2+y^2)
//   rk_end_x(l1,l2,t1,t2)     -> float  x coordinate of end-effector

fn _fabs_rk(x: float) -> float
    0.0 - x if x < 0.0 else x

// rk_fk — forward kinematics: end-effector [x,y] for 2-link planar arm.
// x = l1*cos(t1) + l2*cos(t1+t2)
// y = l1*sin(t1) + l2*sin(t1+t2)
fn rk_fk(l1: float, l2: float, t1: float, t2: float) -> any
    // Coerce t1 to a boxed float (a1) so cos/sin go through the runtime path; a raw
    // float param can be miscompiled to llvm.cos.f64 with a bad bitcast in this module
    // context (layout-dependent float-ABI codegen bug). t12 is an expression so it is safe.
    let a1 = t1 * 1.0
    let t12 = t1 + t2
    let ex = l1 * cos(a1) + l2 * cos(t12)
    let ey = l1 * sin(a1) + l2 * sin(t12)
    [ex, ey]

// rk_reach_distance — Euclidean distance from origin to point (x,y).
fn rk_reach_distance(x: float, y: float) -> float
    let d2 = x * x + y * y
    let d = sqrt(d2)
    d

// rk_workspace_max — maximum reach = l1+l2.
fn rk_workspace_max(l1: float, l2: float) -> float
    let r = l1 + l2
    r

// rk_workspace_min — minimum reach = |l1-l2|.
fn rk_workspace_min(l1: float, l2: float) -> float
    _fabs_rk(l1 - l2)

// rk_reachable — true if (x,y) is within the reachable workspace.
fn rk_reachable(l1: float, l2: float, x: float, y: float) -> bool
    let d2 = x * x + y * y
    let d = sqrt(d2)
    let dmax = l1 + l2
    let dmin = _fabs_rk(l1 - l2)
    if d > dmax + 0.0000001
        return false
    if d < dmin - 0.0000001
        return false
    true

// _ik_core — shared IK computation: law of cosines, returns [t1,t2] or [] if unreachable.
// sign=1.0 elbow-down, -1.0 elbow-up.
// Boxing trick: store params in a list so list-reads give BOXED floats.
fn _ik_core(l1: float, l2: float, x: float, y: float, sign: float) -> any
    // Box all float params by pushing into a list (list elements are boxed floats).
    let params = []
    push(params, l1)
    push(params, l2)
    push(params, x)
    push(params, y)
    push(params, sign)
    // Read back as boxed floats via * 1.0.
    let bl1 = params[0] * 1.0
    let bl2 = params[1] * 1.0
    let bx = params[2] * 1.0
    let by = params[3] * 1.0
    let bsign = params[4] * 1.0
    // Guard: reachability check.
    let reach = rk_reachable(bl1, bl2, bx, by)
    let out = []
    if not reach
        return out
    // law of cosines: cos(t2) = (d^2 - l1^2 - l2^2) / (2*l1*l2)
    let d2 = bx * bx + by * by
    let l1sq = bl1 * bl1
    let l2sq = bl2 * bl2
    let numer = d2 - l1sq - l2sq
    let denom = bl1 * bl2 * 2.0
    let safe_denom = denom
    if safe_denom < 0.0000001
        safe_denom = 0.0000001
    let ct2_raw = numer / safe_denom
    let ct2 = 1.0 if ct2_raw > 1.0 else (-1.0 if ct2_raw < -1.0 else ct2_raw)
    let sin2_term = 1.0 - ct2 * ct2
    let st2_abs = sqrt(sin2_term)
    let st2 = bsign * st2_abs
    let t2 = atan2(st2, ct2)
    let k1 = bl1 + bl2 * ct2
    let k2 = bl2 * st2
    let t1 = atan2(by, bx) - atan2(k2, k1)
    push(out, t1)
    push(out, t2)
    out

// rk_ik — inverse kinematics: elbow-down solution [t1,t2] or [] if unreachable.
fn rk_ik(l1: float, l2: float, x: float, y: float) -> any
    _ik_core(l1, l2, x, y, 1.0)

// rk_elbow_down — elbow-down IK solution (t2 >= 0).
fn rk_elbow_down(l1: float, l2: float, x: float, y: float) -> any
    _ik_core(l1, l2, x, y, 1.0)

// rk_elbow_up — elbow-up IK solution (t2 <= 0).
fn rk_elbow_up(l1: float, l2: float, x: float, y: float) -> any
    _ik_core(l1, l2, x, y, -1.0)

// rk_jacobian — 2x2 Jacobian of end-effector position w.r.t. joint angles [t1,t2].
// Flat row-major: [J00, J01, J10, J11]
// J = [[-l1*s1 - l2*s12, -l2*s12],
//      [ l1*c1 + l2*c12,  l2*c12]]
fn rk_jacobian(l1: float, l2: float, t1: float, t2: float) -> any
    let al1 = l1 * 1.0
    let al2 = l2 * 1.0
    let at1 = t1 * 1.0
    let at2 = t2 * 1.0
    let t12 = at1 + at2
    let s1 = sin(at1)
    let c1 = cos(at1)
    let s12 = sin(t12)
    let c12 = cos(t12)
    let j00 = 0.0 - al1 * s1 - al2 * s12
    let j01 = 0.0 - al2 * s12
    let j10 = al1 * c1 + al2 * c12
    let j11 = al2 * c12
    [j00, j01, j10, j11]

// rk_jacobian_det — determinant of the 2x2 Jacobian (inlined for float safety).
fn rk_jacobian_det(l1: float, l2: float, t1: float, t2: float) -> float
    // Coerce params via *1.0 to ensure boxed-float unboxing before trig.
    let al1 = l1 * 1.0
    let al2 = l2 * 1.0
    let at1 = t1 * 1.0
    let at2 = t2 * 1.0
    let t12 = at1 + at2
    let s1 = sin(at1)
    let c1 = cos(at1)
    let s12 = sin(t12)
    let c12 = cos(t12)
    let j00 = 0.0 - al1 * s1 - al2 * s12
    let j01 = 0.0 - al2 * s12
    let j10 = al1 * c1 + al2 * c12
    let j11 = al2 * c12
    let p0 = j00 * j11
    let p1 = j01 * j10
    let d = p0 - p1
    d

// rk_is_singular — true if Jacobian det is near zero (straight or folded config).
fn rk_is_singular(l1: float, l2: float, t1: float, t2: float) -> bool
    let d = rk_jacobian_det(l1, l2, t1, t2)
    return _fabs_rk(d) < 0.001

// rk_end_x — x coordinate of end-effector.
fn rk_end_x(l1: float, l2: float, t1: float, t2: float) -> float
    let a1 = t1 * 1.0
    let t12 = t1 + t2
    let ex = l1 * cos(a1) + l2 * cos(t12)
    ex
