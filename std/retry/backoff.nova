// ============================================================================
// NOVA Standard Library — std/retry/backoff
// ============================================================================
// Exponential backoff retry policy + a stateful attempt tracker built on top
// of it. Pure/deterministic core (rb_delay/rb_should_retry take no clock),
// with an explicit tracker dict for callers that want mutable attempt state
// without hand-rolling the counter.
//
// Public API:
//   rb_new(max_retries, base_delay_ms)  -> dict policy
//   rb_delay(policy, attempt)           -> int   (ms; base * 2^attempt, capped at 30000)
//   rb_should_retry(policy, attempt)    -> bool
//   rb_with_jitter(delay, jitter_pct)   -> int   (delay + random[0, delay*jitter_pct/100])
//   rb_tracker_new(policy)              -> dict  {"policy": policy, "attempt": 0}
//   rb_tracker_attempt(tracker)         -> int   (delay for this attempt, then advances;
//                                                  -1 once max_retries is exhausted)
//   rb_tracker_reset(tracker)           -> dict  (attempt counter back to 0)
// ============================================================================

let RB_MAX_DELAY_MS = 30000

// rb_new: retry policy — up to max_retries attempts, base_delay_ms is the
// attempt-0 delay before exponential growth kicks in.
fn rb_new(max_retries, base_delay_ms) -> dict
    let p = {}
    p["max_retries"] = max_retries
    p["base_delay_ms"] = base_delay_ms
    p

// rb_delay: base * 2^attempt, capped at 30000ms. The loop bails out the
// instant the running delay reaches the cap so this is safe even for very
// large `attempt` values (no integer overflow from repeated doubling).
fn rb_delay(policy, attempt) -> int
    let base = policy["base_delay_ms"]
    let cap = RB_MAX_DELAY_MS
    let delay = base
    for i in 0..attempt
        if delay >= cap
            return cap
        delay = delay * 2
    if delay > cap
        delay = cap
    delay

// rb_should_retry: true while attempt is still within the policy's budget.
fn rb_should_retry(policy, attempt) -> bool
    attempt < policy["max_retries"]

// rb_with_jitter: add a random amount in [0, delay * jitter_pct / 100] to
// delay ("full jitter"-adjacent — spreads out retries to avoid thundering
// herd). jitter_pct <= 0 (or a delay of 0) is a no-op.
fn rb_with_jitter(delay, jitter_pct) -> int
    let max_add = delay * jitter_pct / 100
    if max_add <= 0
        return delay
    let extra = random_int(0, max_add)
    delay + extra

// rb_tracker_new: wraps a policy with a mutable attempt counter.
fn rb_tracker_new(policy) -> dict
    let t = {}
    t["policy"] = policy
    t["attempt"] = 0
    t

// rb_tracker_attempt: returns the delay to wait before this attempt and
// advances the counter, or -1 if the policy's retry budget is exhausted
// (counter is left unchanged in that case).
fn rb_tracker_attempt(tracker) -> int
    let policy = tracker["policy"]
    let attempt = tracker["attempt"]
    if not rb_should_retry(policy, attempt)
        return -1
    let delay = rb_delay(policy, attempt)
    tracker["attempt"] = attempt + 1
    delay

// rb_tracker_reset: back to attempt 0 (e.g. after a successful call).
fn rb_tracker_reset(tracker) -> dict
    tracker["attempt"] = 0
    tracker

// ============================================================================
fn main()
    print("std/retry/backoff loaded")
