// ============================================================================
// NOVA Standard Library — std/util/tuple
// ============================================================================
// Fixed-size tuples (pair/triple) backed by a dict with string index keys.
// Keys are "0", "1", "2" — matching Python/Rust positional tuple conventions.
// Mixed-type values are fully supported (any).
//
// Public API:
//   tp_pair(a, b)         -> dict   create a 2-element tuple
//   tp_triple(a, b, c)    -> dict   create a 3-element tuple
//   tp_first(t)           -> any    element at index 0
//   tp_second(t)          -> any    element at index 1
//   tp_third(t)           -> any    element at index 2
//   tp_swap(pair)         -> dict   new pair with first/second swapped
//   tp_to_list(t)         -> list   ordered list of elements
//   tp_size(t)            -> int    number of elements (2 or 3)

// ── tp_pair ──────────────────────────────────────────────────────────────────
// Build a 2-element tuple dict with keys "0" and "1".
fn tp_pair(a, b) -> dict
    let t = {}
    t["0"] = a
    t["1"] = b
    t

// ── tp_triple ─────────────────────────────────────────────────────────────────
// Build a 3-element tuple dict with keys "0", "1", and "2".
fn tp_triple(a, b, c) -> dict
    let t = {}
    t["0"] = a
    t["1"] = b
    t["2"] = c
    t

// ── tp_first ─────────────────────────────────────────────────────────────────
// Return element at position 0.
fn tp_first(t: dict)
    t["0"]

// ── tp_second ────────────────────────────────────────────────────────────────
// Return element at position 1.
fn tp_second(t: dict)
    t["1"]

// ── tp_third ─────────────────────────────────────────────────────────────────
// Return element at position 2.
fn tp_third(t: dict)
    t["2"]

// ── tp_swap ──────────────────────────────────────────────────────────────────
// Return a new pair with first and second swapped.
fn tp_swap(pair: dict) -> dict
    let a = pair["0"]
    let b = pair["1"]
    tp_pair(b, a)

// ── tp_to_list ───────────────────────────────────────────────────────────────
// Return an ordered list of all elements in the tuple.
// Works for both pair (size 2) and triple (size 3).
fn tp_to_list(t: dict) -> list
    let result = []
    let sz = tp_size(t)
    result.push(t["0"])
    result.push(t["1"])
    if sz > 2
        result.push(t["2"])
    result

// ── tp_size ───────────────────────────────────────────────────────────────────
// Return the number of elements: 3 if key "2" exists, else 2.
fn tp_size(t: dict) -> int
    if contains(t, "2")
        3
    else
        2
