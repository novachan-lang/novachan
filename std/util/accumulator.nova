// std/util/accumulator.nova — Running statistics via Welford's online algorithm.
//
// Welford's method computes mean and population variance in a single pass with
// full numerical stability. Each call to ac_add updates M2 (the running sum of
// squared deviations from the current mean) using the recurrence:
//
//   delta  = x - mean
//   mean  += delta / count
//   delta2 = x - mean          // uses the UPDATED mean
//   M2    += delta * delta2
//
// At any point: population variance = M2 / count.
// This avoids the catastrophic cancellation that plagues the naive two-pass
// (sum_sq - n*mean^2) approach for large or nearly-equal values.
//
// Public API
//   ac_new()              -> dict   fresh accumulator
//   ac_add(a, x)                   add one float observation
//   ac_count(a)           -> int    number of values added
//   ac_sum(a)             -> float  running sum
//   ac_mean(a)            -> float  arithmetic mean (0.0 if empty)
//   ac_variance(a)        -> float  population variance (0.0 if empty)
//   ac_std(a)             -> float  population std-dev (0.0 if empty)
//   ac_min(a)             -> float  minimum seen (0.0 if empty)
//   ac_max(a)             -> float  maximum seen (0.0 if empty)
//
// Keys stored in the dict use the prefix "ac_" to avoid collisions with any
// other dict-based module that might live alongside this one in user code.

// Create a fresh, empty accumulator.
fn ac_new() -> dict
    let d = {"ac_n": 0, "ac_sum": 0.0, "ac_m": 0.0, "ac_m2": 0.0, "ac_min": 0.0, "ac_max": 0.0}
    d

// Incorporate one new observation x into the accumulator a.
// Updates count, sum, Welford's M2, min, and max.
fn ac_add(a: dict, x: float)
    let n_old = a["ac_n"]
    let n_new = n_old + 1
    a["ac_n"] = n_new
    a["ac_sum"] += x
    let mean_old = a["ac_m"]
    let delta = x - mean_old
    let mean_new = mean_old + delta / (n_new * 1.0)
    a["ac_m"] = mean_new
    let delta2 = x - mean_new
    a["ac_m2"] += delta * delta2
    if n_old == 0
        a["ac_min"] = x
        a["ac_max"] = x
    else
        let cur_min = a["ac_min"]
        let cur_max = a["ac_max"]
        if x < cur_min
            a["ac_min"] = x
        if x > cur_max
            a["ac_max"] = x

// Number of observations added so far.
fn ac_count(a: dict) -> int
    a["ac_n"]

// Running sum of all observations.
fn ac_sum(a: dict) -> float
    a["ac_sum"]

// Arithmetic mean. Returns 0.0 if no observations have been added.
fn ac_mean(a: dict) -> float
    let n = a["ac_n"]
    if n == 0
        return 0.0
    a["ac_m"]

// Population variance (M2 / n). Returns 0.0 if fewer than 1 observation.
fn ac_variance(a: dict) -> float
    let n = a["ac_n"]
    if n == 0
        return 0.0
    let m2 = a["ac_m2"]
    m2 / (n * 1.0)

// Population standard deviation (sqrt of variance).
// Binds to a let before returning to avoid the bare-big-float-return codegen bug.
fn ac_std(a: dict) -> float
    let v = ac_variance(a)
    let sd = sqrt(v)
    sd

// Minimum value seen. Returns 0.0 if the accumulator is empty.
fn ac_min(a: dict) -> float
    let n = a["ac_n"]
    if n == 0
        return 0.0
    a["ac_min"]

// Maximum value seen. Returns 0.0 if the accumulator is empty.
fn ac_max(a: dict) -> float
    let n = a["ac_n"]
    if n == 0
        return 0.0
    a["ac_max"]
