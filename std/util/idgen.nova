// std/util/idgen — Sequential / prefixed ID generator (pure counter state, testable).
//
// The generator is a plain dict — no hidden mutable globals — so it is trivially
// testable and safe to use independently in multiple places without interference.
//
// Public API
// ----------
//   ig_new(prefix)            -> dict   {"prefix": prefix, "n": 0}
//   ig_next(ig)               -> string  increment n, return prefix + str(n)
//   ig_next_padded(ig, width) -> string  increment n, return prefix + zero-padded str(n)
//   ig_current(ig)            -> int     current counter value (does NOT advance)
//   ig_reset(ig)                         reset n to 0 (mutates dict in place)

// ── internal helper: zero-pad an integer to `width` digits ────────────────────
// Example: _ig_pad(7, 4) -> "0007", _ig_pad(123, 2) -> "123" (no truncation)

fn _ig_pad(n, width)
    let s = str(n)
    let result = s
    let need = width - len(s)
    if need > 0
        let pad_parts = []
        for i in 0..need
            push(pad_parts, "0")
        let pad = join(pad_parts, "")
        result = pad + s
    result

// ── Constructor ───────────────────────────────────────────────────────────────

fn ig_new(prefix)
    let ig = {}
    ig["prefix"] = prefix
    ig["n"] = 0
    ig

// ── Counter operations ────────────────────────────────────────────────────────

fn ig_next(ig)
    let n = ig["n"] + 1
    ig["n"] = n
    ig["prefix"] + str(n)

fn ig_next_padded(ig, width)
    let n = ig["n"] + 1
    ig["n"] = n
    ig["prefix"] + _ig_pad(n, width)

fn ig_current(ig)
    ig["n"]

fn ig_reset(ig)
    ig["n"] = 0
