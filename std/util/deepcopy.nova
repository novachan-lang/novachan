// ============================================================================
// NOVA Standard Library — std/util/deepcopy
// ============================================================================
// Deep copy and structural equality for nested dict/list/scalar values.
//
// dc_copy(v) -> any
//   Returns a fully independent deep copy of v.
//   - dict  -> new dict with dc_copy of each value (keys are strings, copied by value)
//   - list  -> new list with dc_copy of each element
//   - scalar (int, float, bool, str, null) -> returned as-is (scalars are value types)
//   Delegates to the native runtime deep-copy primitive which handles cycles and
//   RC bookkeeping correctly.
//
// dc_equal(a, b) -> bool
//   Structural (deep) equality.
//   - Both dict  -> same key-set AND dc_equal for each corresponding value
//   - Both list  -> same length AND dc_equal for each corresponding element
//   - Otherwise  -> a == b  (scalar / mixed-type comparison)
//
// Public API:
//   dc_copy(v: any)        -> any
//   dc_equal(a: any, b: any) -> bool

// ── dc_copy ──────────────────────────────────────────────────────────────────
// Delegates to the built-in `copy` builtin which maps to nova_rt_deep_copy in
// the runtime — a fully recursive, RC-correct deep copy with cycle handling.
fn dc_copy(v: any) -> any
    copy(v)

// ── dc_equal helpers ─────────────────────────────────────────────────────────

// Check whether every key in dict `a` exists in dict `b` with an equal value,
// and that both dicts have the same number of keys.
fn _dce_dicts_equal(a: any, b: any) -> bool
    let ks = keys(a)
    let n = len(ks)
    // Fast-reject: different number of keys.
    if n != len(keys(b))
        return false
    let i = 0
    let ok = true
    while i < n and ok
        let k = ks[i]
        if not contains(b, k)
            ok = false
        else
            if not dc_equal(a[k], b[k])
                ok = false
        i = i + 1
    ok

// Check whether two lists are element-wise equal.
fn _dce_lists_equal(a: any, b: any) -> bool
    let n = len(a)
    if n != len(b)
        return false
    let i = 0
    let ok = true
    while i < n and ok
        if not dc_equal(a[i], b[i])
            ok = false
        i = i + 1
    ok

// ── dc_equal ─────────────────────────────────────────────────────────────────
fn dc_equal(a: any, b: any) -> bool
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return false
    if ta == "dict"
        return _dce_dicts_equal(a, b)
    if ta == "list"
        return _dce_lists_equal(a, b)
    // Scalars: int, float, bool (stored as int), str, null — direct equality.
    a == b
