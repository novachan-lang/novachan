// ============================================================================
// NOVA Standard Library — validate module (std/util/validate)
// ============================================================================
// Common string-format validators. Every function returns a bool (true/false).
//
// Public API:
//   v_is_email(s)  -> bool  Exactly one '@', non-empty local part, domain
//                           contains at least one '.', no whitespace anywhere.
//   v_is_ipv4(s)   -> bool  Exactly four dot-separated parts, each a decimal
//                           integer in [0..255], no leading zeros on multi-char
//                           parts, no extra characters.
//   v_luhn(s)      -> bool  Luhn mod-10 check over a digit string (spaces
//                           stripped). Valid credit-card-style numbers pass.
//   v_is_uuid(s)   -> bool  Canonical UUID format: 8-4-4-4-12 hex digits
//                           (any case) separated by dashes, total length 36.
//   v_is_hex(s)    -> bool  Non-empty string whose every character is a valid
//                           hexadecimal digit (0-9, a-f, A-F).

// ── internal helpers ──────────────────────────────────────────────────────────

// Return true if ch is an ASCII whitespace character (space, tab, CR, LF).
fn _v_is_space(ch: str) -> bool
    ch == " " or ch == "\t" or ch == "\r" or ch == "\n"

// Return true if ch is a decimal digit '0'..'9'.
fn _v_is_digit(ch: str) -> bool
    let o = ord(ch)
    o >= 48 and o <= 57

// Return true if ch is a valid hexadecimal digit (0-9, a-f, A-F).
fn _v_is_hex_char(ch: str) -> bool
    let o = ord(ch)
    // '0'..'9' = 48..57; 'a'..'f' = 97..102; 'A'..'F' = 65..70
    if o >= 48 and o <= 57
        return true
    if o >= 97 and o <= 102
        return true
    if o >= 65 and o <= 70
        return true
    false

// Parse a non-empty decimal string into an integer.
// Returns -1 on any non-digit character (invalid).
// Caller is responsible for checking empty input before calling.
fn _v_parse_int(s: str) -> int
    let result = 0
    for i in 0..len(s)
        let ch = s[i]
        if not _v_is_digit(ch)
            return -1
        let d = ord(ch) - 48
        result = result * 10 + d
    result

// Count how many times a single-character needle appears in haystack.
fn _v_count_char(s: str, needle: str) -> int
    let count = 0
    for i in 0..len(s)
        if s[i] == needle
            count += 1
    count

// Return the substring of s from index start up to (not including) end.
// Thin wrapper around the built-in slice() to keep call-sites readable.
fn _v_substr(s: str, start: int, end: int) -> str
    slice(s, start, end)

// ── v_is_email ────────────────────────────────────────────────────────────────
// Rules applied in order (fast rejections first):
//   1. Exactly one '@' character.
//   2. No whitespace anywhere (spaces, tabs, CR, LF).
//   3. Local part (before '@') is non-empty.
//   4. Domain part (after '@') contains at least one '.'.
// We do NOT attempt full RFC 5321/5322 compliance — this is the pragmatic
// "looks like an email" check sufficient for form validation.
fn v_is_email(s: str) -> bool
    let n = len(s)
    if n == 0
        return false

    // Rule 1: exactly one '@'.
    if _v_count_char(s, "@") != 1
        return false

    // Rule 2: no whitespace anywhere.
    for i in 0..n
        if _v_is_space(s[i])
            return false

    // Find the position of '@' to split local / domain.
    let at_pos = 0
    for j in 0..n
        if s[j] == "@"
            at_pos = j

    // Rule 3: non-empty local part (at_pos > 0).
    if at_pos == 0
        return false

    // Rule 4: domain part (indices at_pos+1 .. n-1) contains a '.'.
    let domain_start = at_pos + 1
    let domain_len = n - domain_start
    if domain_len == 0
        return false
    let has_dot = false
    let k = domain_start
    while k < n
        if s[k] == "."
            has_dot = true
        k += 1
    has_dot

// ── v_is_ipv4 ─────────────────────────────────────────────────────────────────
// Accepts exactly four dot-separated decimal parts where each part:
//   - Is non-empty.
//   - Contains only digits.
//   - Has no leading zeros when its length > 1 (e.g. "01" is rejected).
//   - Has numeric value in [0..255].
// The string must consist of exactly those four parts and three dots — no
// trailing dots, no extra characters.
//
// Strategy: require exactly 3 dots first (fast reject), then validate each of
// the 4 segments. The 3-dot gate also rejects 5+ parts immediately.
fn v_is_ipv4(s: str) -> bool
    let n = len(s)
    if n == 0
        return false

    // Fast gate: must contain exactly 3 dots.
    if _v_count_char(s, ".") != 3
        return false

    // Validate each of the 4 dot-separated segments.
    // We walk once, emitting a segment each time we hit a '.' or end-of-string.
    let seg_count = 0
    let seg_start = 0
    let i = 0
    while i <= n
        if i == n or s[i] == "."
            let seg = _v_substr(s, seg_start, i)
            let slen = len(seg)
            // Segment must be non-empty.
            if slen == 0
                return false
            // No leading zeros on multi-char segments ("01", "001", etc.).
            if slen > 1 and seg[0] == "0"
                return false
            // Parse and range-check [0..255].
            let val = _v_parse_int(seg)
            if val < 0 or val > 255
                return false
            seg_count += 1
            seg_start = i + 1
        i += 1

    // The 3-dot gate already ensures exactly 4 segments if no empty ones sneak
    // through (trailing dot would create an empty 4th segment, caught above).
    seg_count == 4

// ── v_luhn ────────────────────────────────────────────────────────────────────
// Standard Luhn mod-10 algorithm:
//   1. Strip all space characters from the input.
//   2. The remaining characters must all be digits.
//   3. Starting from the rightmost digit (index 0 from right) and moving left,
//      double every digit at an odd distance from the right (i.e. positions
//      1, 3, 5, ... from the right — every second digit starting from second-
//      to-last). If doubling produces a value >= 10, subtract 9.
//   4. Sum all digits (original and doubled).
//   5. The number is valid if sum % 10 == 0.
// An empty string (after stripping spaces) is invalid.
fn v_luhn(s: str) -> bool
    // Strip spaces.
    let digits_parts = []
    for i in 0..len(s)
        let ch = s[i]
        if ch != " "
            push(digits_parts, ch)

    let digits = join(digits_parts, "")
    let n = len(digits)
    if n == 0
        return false

    // Validate all chars are digits.
    for j in 0..n
        if not _v_is_digit(digits[j])
            return false

    // Luhn sum: traverse right-to-left.
    let total = 0
    let k = n - 1
    // pos_from_right counts from 0 at the rightmost digit.
    let pos_from_right = 0
    while k >= 0
        let d = ord(digits[k]) - 48
        if pos_from_right % 2 == 1
            // Double this digit.
            d = d * 2
            if d >= 10
                d -= 9
        total += d
        pos_from_right += 1
        k -= 1

    total % 10 == 0

// ── v_is_uuid ────────────────────────────────────────────────────────────────
// Validates the canonical UUID wire format: 8-4-4-4-12 hexadecimal digits
// separated by dashes, case-insensitive. Total length must be exactly 36.
// We do NOT enforce a specific version or variant nibble — this covers all
// UUID versions (v1 through v8) and nil/max UUIDs.
//
// Expected dash positions (0-indexed): 8, 13, 18, 23.
// All other 32 positions must be hexadecimal digits (0-9, a-f, A-F).
fn v_is_uuid(s: str) -> bool
    if len(s) != 36
        return false
    for i in 0..36
        let ch = s[i]
        if i == 8 or i == 13 or i == 18 or i == 23
            if ch != "-"
                return false
        else
            if not _v_is_hex_char(ch)
                return false
    true

// ── v_is_hex ──────────────────────────────────────────────────────────────────
// Returns true if s is non-empty and every character is a hexadecimal digit
// (0-9, a-f, A-F). An empty string returns false (there are no digits to be
// hex, and callers typically want to distinguish "empty" from "valid hex").
fn v_is_hex(s: str) -> bool
    let n = len(s)
    if n == 0
        return false
    for i in 0..n
        if not _v_is_hex_char(s[i])
            return false
    true
