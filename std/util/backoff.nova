// NOVA std/util/backoff — Exponential backoff delay CALCULATOR.
//
// Pure math — no sleeping. Callers receive delay values (milliseconds) and
// choose how to sleep, so the policy is fully testable, portable, and
// composable with any async/sync runtime.
//
// Algorithm:
//   bo_delay(attempt, base_ms, max_ms) = min(base_ms * 2^attempt, max_ms)
//
// Jitter (full-jitter variant): given the uncapped delay d, return a
// uniformly distributed value in [0, d] via a 32-bit LCG so the result is
// deterministic per seed. LCG: s = (1664525 * s + 1013904223) & 0xFFFFFFFF
// (Numerical Recipes coefficients; full 2^32 period, no division required).
//
// Public API:
//   bo_delay(attempt, base_ms, max_ms)           -> int
//   bo_delay_jittered(attempt, base_ms, max_ms, seed) -> int
//   bo_sequence(n, base_ms, max_ms)              -> list   (attempts 0..n-1)
//   bo_total(n, base_ms, max_ms)                 -> int    (sum of sequence)

// ── private: one 32-bit LCG step ────────────────────────────────────────────
// All intermediate values are masked to stay in [0, 2^32-1].
// '>>' in NOVA is arithmetic; the mask converts to unsigned 32-bit range.
fn _bo_lcg(state: int) -> int
    let s = (1664525 * state + 1013904223) & 0xFFFFFFFF
    s

// ── private: raise 2 to the power of attempt, capped at max_ms ──────────────
// We compute base * 2^attempt iteratively to avoid floating-point and to
// allow early exit as soon as the value hits the cap.  Overflow is absorbed
// by the cap: once delay > max_ms or goes negative (64-bit wrap) we clamp.
fn _bo_raw(attempt: int, base_ms: int, max_ms: int) -> int
    if base_ms <= 0
        return 0
    if max_ms <= 0
        return 0
    if base_ms >= max_ms
        return max_ms
    let d = base_ms
    let k = 0
    let a = attempt
    if a < 0
        a = 0
    for k in 0..a
        if d >= max_ms
            return max_ms
        d = d * 2
        if d > max_ms
            d = max_ms
        if d < 0
            d = max_ms
    if d > max_ms
        d = max_ms
    d

// ── bo_delay: canonical exponential-backoff delay ───────────────────────────
// Returns base_ms * 2^attempt, capped at max_ms.
// bo_delay(0,100,10000) == 100
// bo_delay(1,100,10000) == 200
// bo_delay(3,100,10000) == 800
// bo_delay(10,100,10000) == 10000   (cap)
fn bo_delay(attempt: int, base_ms: int, max_ms: int) -> int
    _bo_raw(attempt, base_ms, max_ms)

// ── bo_delay_jittered: full-jitter variant ───────────────────────────────────
// Computes d = bo_delay(attempt, base_ms, max_ms), then returns a
// deterministic value in [0, d] using one LCG step seeded by `seed`.
// "Full jitter" (AWS recommendation) spreads load across the entire window
// [0, d] rather than clustering near d.
fn bo_delay_jittered(attempt: int, base_ms: int, max_ms: int, seed: int) -> int
    let d = _bo_raw(attempt, base_ms, max_ms)
    if d <= 0
        return 0
    let s = _bo_lcg(seed)
    let j = s % (d + 1)
    j

// ── bo_sequence: list of delays for attempts 0 .. n-1 ───────────────────────
// bo_sequence(4,100,10000) == [100, 200, 400, 800]
fn bo_sequence(n: int, base_ms: int, max_ms: int) -> list
    [_bo_raw(i, base_ms, max_ms) for i in 0..n]

// ── bo_total: sum of all delays for attempts 0 .. n-1 ───────────────────────
fn bo_total(n: int, base_ms: int, max_ms: int) -> int
    sum(bo_sequence(n, base_ms, max_ms))
