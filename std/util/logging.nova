// ============================================================================
// NOVA Standard Library — std/util/logging
// Leveled logging helpers: level numbering, filtering, and formatting.
//
// NOTE: the native builtin 'log' is the mathematical natural-log function.
// This module provides STRING-level helpers with the prefix 'lg_'.
//
// PUBLIC API:
//   lg_level_num(name)               -> int   DEBUG=0 INFO=1 WARN=2 ERROR=3 else -1
//   lg_should_log(configured, msg)   -> bool  true when msg_level >= configured_level
//   lg_format(level, msg)            -> string "[LEVEL] msg"
//   lg_format_ts(level, msg, epoch)  -> string "[LEVEL] <iso-ts> msg"
//
// DESIGN:
//   Pure string/int helpers — zero I/O, zero global state.
//   Callers compose: if lg_should_log(cfg, lvl) then print(lg_format(lvl, msg))
//   lg_format_ts delegates ISO formatting to std/time/datetime.
// ============================================================================

import std/time/datetime

// lg_level_num: map a level name to its severity integer.
// Unrecognised names return -1 (never matches any configured level).
fn lg_level_num(name) -> int
    if name == "DEBUG"
        return 0
    if name == "INFO"
        return 1
    if name == "WARN"
        return 2
    if name == "ERROR"
        return 3
    -1

// lg_should_log: decide whether a message at msg_level should be emitted
// given the currently configured minimum level (configured).
// Returns true when level_num(msg_level) >= level_num(configured).
// Unknown levels (num = -1) never pass the filter.
fn lg_should_log(configured, msg_level) -> bool
    let cn = lg_level_num(configured)
    let mn = lg_level_num(msg_level)
    if cn < 0
        return false
    if mn < 0
        return false
    mn >= cn

// lg_format: produce "[LEVEL] msg".
fn lg_format(level, msg) -> string
    "[" + level + "] " + msg

// lg_format_ts: produce "[LEVEL] <iso-ts> msg" where iso-ts is
// the UTC epoch formatted as "YYYY-MM-DDTHH:MM:SSZ" via std/time/datetime.
fn lg_format_ts(level, msg, epoch) -> string
    let ts = dt_format_iso(epoch)
    "[" + level + "] " + ts + " " + msg
