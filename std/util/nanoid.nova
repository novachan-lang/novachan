// ============================================================================
// NOVA Standard Library — nanoid module
// ============================================================================
// URL-safe unique identifier generator, inspired by the Nano ID spec.
//
// Produces compact, random, URL-safe strings using the 64-character alphabet
// "A-Za-z0-9_-". The alphabet fits exactly 6 bits (2^6 = 64), so each PRNG
// draw is masked with &63 to pick a character — no bias, no rejection loop.
//
// IMPORTANT: uses std/util/prng (xorshift64), which is NOT cryptographically
// secure. These IDs are suitable for correlation tokens, cache keys, session
// handles, etc. For security-sensitive secrets use a CSPRNG.
//
// Public API:
//   nano_gen(state, size)     -> [id_string, newstate]
//   nano_gen_default(state)   -> [id_string, newstate]  (size = 21)
//
// State threading: every function accepts the current PRNG state (an int
// returned by prng_seed or a previous nano_gen call) and returns a pair
// [id_string, newstate] so the caller can chain calls without re-seeding.
//
// Determinism: same state + same size -> byte-identical result, every time.

import std/util/prng

// The 64-character URL-safe alphabet.  Index i (0..63) is the character at
// position i.  Laid out as:
//   [0..25]  A-Z
//   [26..51] a-z
//   [52..61] 0-9
//   [62]     _
//   [63]     -
// The ordering is arbitrary; what matters is that all 64 slots are distinct
// URL-safe characters.
fn _nano_alphabet() -> str
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-"

// Generate a nanoid of `size` characters using the supplied PRNG state.
// Returns [id_string, newstate].
//
// Each character is produced by:
//   1. Advancing the PRNG via prng_next  -> [value, newstate]
//   2. Masking value & 63               -> 0..63  (exactly 6 bits, no bias)
//   3. Indexing the 64-char alphabet    -> one URL-safe character
//
// The string is built by accumulation; NOVA strings are immutable values so
// each concatenation produces a new value — this is idiomatic and correct.
fn nano_gen(state: int, size: int)
    let alpha = _nano_alphabet()
    let out = ""
    let st = state
    let i = 0
    while i < size
        let step = prng_next(st)
        let value = step[0]
        st = step[1]
        let idx = value & 63
        out = out + alpha[idx]
        i = i + 1
    [out, st]

// Convenience wrapper: generate a 21-character nanoid (the canonical default
// length from the Nano ID specification — 21 chars × 6 bits = 126 bits of
// entropy, comparable to UUID v4's 122 bits).
fn nano_gen_default(state: int)
    nano_gen(state, 21)
