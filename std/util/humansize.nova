// ============================================================================
// NOVA Standard Library — std/util/humansize
// ============================================================================
// Human-readable byte sizes (base-1024, 1 decimal digit, units B/KB/MB/GB/TB).
//
// hs_format(nbytes) -> str
//   Formats an integer byte count as a human-readable string.
//   - nbytes < 1024  ->  "<n> B"          (whole number, no decimal)
//   - nbytes >= 1024 ->  "<w>.<d> <unit>"  (one decimal digit via integer math)
//   The divisor for the chosen unit is the largest power of 1024 whose quotient
//   is >= 1. The decimal digit is computed as:
//     whole  = nbytes / divisor
//     tenths = (nbytes * 10 / divisor) % 10
//   Both divisions are integer divisions, so there is no floating-point involved
//   and the result is exact for all values in the spec.
//
// hs_parse(s) -> int
//   Parses a string produced by hs_format (or hand-written in the same style)
//   back to an integer byte count.
//   "512 B"  -> 512
//   "1 KB"   -> 1024
//   "1.5 KB" -> 1536
//   "2 MB"   -> 2097152
//   The parser is permissive about the space before the unit; it uses the FIRST
//   space as the separator between the numeric part and the unit. A missing
//   decimal part is treated as zero tenths. An unrecognised unit returns 0.
//
// Public API:
//   hs_format(nbytes: int) -> str
//   hs_parse(s: str)       -> int

// ── unit table ───────────────────────────────────────────────────────────────
// Parallel lists: _HS_DIVS[i] is the divisor for _HS_UNITS[i].
// Listed LARGEST-first so the first entry whose divisor is <= nbytes wins.
// TB = 2^40 = 1099511627776
// GB = 2^30 = 1073741824
// MB = 2^20 = 1048576
// KB = 2^10 = 1024
fn _hs_divs() -> list
    [1099511627776, 1073741824, 1048576, 1024]

fn _hs_units() -> list
    ["TB", "GB", "MB", "KB"]

// ── hs_format ────────────────────────────────────────────────────────────────
fn hs_format(nbytes: int) -> str
    // Special case: less than 1 KB -> plain integer with " B", no decimal.
    if nbytes < 1024
        return str(nbytes) + " B"

    // Walk the unit table (largest first) to find the right divisor.
    let divs = _hs_divs()
    let units = _hs_units()
    let chosen_div = 1024
    let chosen_unit = "KB"
    let i = 0
    while i < len(divs)
        if nbytes >= divs[i]
            chosen_div = divs[i]
            chosen_unit = units[i]
            i = len(divs)
        i = i + 1

    // Compute whole part and single tenths digit via pure integer math.
    let whole = nbytes / chosen_div
    let tenths = (nbytes * 10 / chosen_div) % 10
    str(whole) + "." + str(tenths) + " " + chosen_unit

// ── hs_parse helpers ─────────────────────────────────────────────────────────

// Return the index of the first space in s, or len(s) if no space found.
fn _hs_space_idx(s: str) -> int
    let i = 0
    while i < len(s)
        if s[i] == " "
            return i
        i = i + 1
    len(s)

// Parse a run of ASCII digit characters starting at index `start` in `s`.
// Returns the integer value; stops at a non-digit character or end-of-string.
fn _hs_parse_int(s: str, start: int) -> int
    let v = 0
    let i = start
    while i < len(s)
        let c = s[i]
        if c == "0" or c == "1" or c == "2" or c == "3" or c == "4" or c == "5" or c == "6" or c == "7" or c == "8" or c == "9"
            let digit = ord(c) - 48
            v = v * 10 + digit
            i = i + 1
        else
            i = len(s)
    v

// ── hs_parse ─────────────────────────────────────────────────────────────────
fn hs_parse(s: str) -> int
    // Split at the first space: left=numeric part, right=unit.
    let sp = _hs_space_idx(s)
    if sp >= len(s)
        return 0
    let num_part = slice(s, 0, sp)
    // Unit is everything after the space.
    let unit = slice(s, sp + 1, len(s))

    // Parse numeric part: look for an optional '.' with one trailing digit.
    let dot_idx = len(num_part)
    let j = 0
    while j < len(num_part)
        if num_part[j] == "."
            dot_idx = j
            j = len(num_part)
        j = j + 1

    let whole = 0
    let tenths = 0
    if dot_idx < len(num_part)
        // Has a decimal part.
        whole = _hs_parse_int(num_part, 0)
        let frac_str = slice(num_part, dot_idx + 1, len(num_part))
        if len(frac_str) > 0
            tenths = _hs_parse_int(frac_str, 0)
    else
        whole = _hs_parse_int(num_part, 0)

    // Resolve unit to a byte divisor.
    let divisor = 0
    if unit == "B"
        divisor = 1
    if unit == "KB"
        divisor = 1024
    if unit == "MB"
        divisor = 1048576
    if unit == "GB"
        divisor = 1073741824
    if unit == "TB"
        divisor = 1099511627776
    if divisor == 0
        return 0

    // bytes = whole * divisor + tenths * divisor / 10
    // Note: for B, tenths * 1 / 10 = 0 (integer), which is correct.
    let result = whole * divisor + tenths * divisor / 10
    result
