// std/util/snowflake.nova
// Twitter Snowflake 64-bit ID generator
// Layout: [63..22] = timestamp_ms (41 bits), [21..12] = machine (10 bits), [11..0] = sequence (12 bits)
//
// Bit shift constants (powers of 2, since NOVA lacks << on large numbers):
//   2^22 = 4194304   (timestamp shift)
//   2^12 = 4096      (machine shift)
//   (id >> 22) done as integer division by 4194304
//   (id >> 12) & 1023 done as (id / 4096) % 1024
//   id & 4095 done as id % 4096
//
// Private helpers use _sf_ prefix to avoid link collisions.

// sf_make: build a Snowflake ID from its three components.
//   timestamp_ms : milliseconds epoch (41 bits, 0..2^41-1)
//   machine      : machine/datacenter id (10 bits, 0..1023)
//   sequence     : per-machine sequence counter (12 bits, 0..4095)
fn sf_make(timestamp_ms: int, machine: int, sequence: int) -> int
    let _sf_ts_part = timestamp_ms * 4194304
    let _sf_mc_part = machine * 4096
    _sf_ts_part + _sf_mc_part + sequence

// sf_timestamp: extract timestamp_ms field (top 41 bits) from a Snowflake ID.
fn sf_timestamp(id: int) -> int
    id / 4194304

// sf_machine: extract machine id (bits 21..12) from a Snowflake ID.
fn sf_machine(id: int) -> int
    let _sf_shifted = id / 4096
    _sf_shifted % 1024

// sf_sequence: extract sequence (bits 11..0) from a Snowflake ID.
fn sf_sequence(id: int) -> int
    id % 4096

// sf_decode: decompose a Snowflake ID into a dict with keys
//   "timestamp" -> int, "machine" -> int, "sequence" -> int
fn sf_decode(id: int) -> dict
    let _sf_dt = sf_timestamp(id)
    let _sf_dm = sf_machine(id)
    let _sf_ds = sf_sequence(id)
    let _sf_result = {"timestamp": _sf_dt, "machine": _sf_dm, "sequence": _sf_ds}
    _sf_result
