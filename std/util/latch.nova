// NOVA std/util/latch — Countdown latch (single-threaded counter-based).
//
// A countdown latch starts at a positive count and opens (count reaches 0)
// as callers decrement it.  Once open it stays open unless explicitly reset.
// There are no threads or blocking — this is a pure counter abstraction
// useful for dependency tracking, event sequencing, and test synchronisation.
//
// Public API
// ----------
//   lt_new(count)  -> dict          Create a new latch with the given count.
//   lt_count_down(l)                Decrement count by 1 (floor 0).
//   lt_count_down_n(l, n)           Decrement count by n (floor 0).
//   lt_count(l)    -> int           Return current count.
//   lt_is_open(l)  -> bool          Return true when count == 0.
//   lt_reset(l, count)              Reset count to a new value.
//
// Implementation note: state is stored in a dict under private keys
// prefixed with "lt$" so they cannot collide with caller-owned keys if
// a latch dict is used as a general property bag.

// ── Constructor ───────────────────────────────────────────────────────────────

fn lt_new(count) -> dict
    let l = {}
    let c = count
    if c < 0
        c = 0
    l["lt$c"] = c
    l

// ── Mutations ─────────────────────────────────────────────────────────────────

fn lt_count_down(l)
    let cur = l["lt$c"]
    if cur > 0
        l["lt$c"] = cur - 1

fn lt_count_down_n(l, n)
    let cur = l["lt$c"]
    let steps = n
    if steps < 0
        steps = 0
    let next = cur - steps
    if next < 0
        next = 0
    l["lt$c"] = next

fn lt_reset(l, count)
    let c = count
    if c < 0
        c = 0
    l["lt$c"] = c

// ── Queries ───────────────────────────────────────────────────────────────────

fn lt_count(l) -> int
    l["lt$c"]

fn lt_is_open(l) -> bool
    l["lt$c"] == 0
