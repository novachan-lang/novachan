// ============================================================================
// NOVA Standard Library — std/util/humanize_number
// ============================================================================
// Human-readable large numbers using SI-ish suffixes at base-1000.
//
// hn_format(n: int) -> str
//   Formats an integer as a compact, human-readable string.
//   - |n| < 1000  -> str(n)                  (plain integer, no suffix)
//   - |n| >= 1000 -> "<sign><w>.<d><unit>"    (one decimal digit, no space)
//   Units (largest first): T=10^12, B=10^9, M=10^6, K=10^3
//   The decimal digit is computed via pure integer math:
//     whole  = abs_n / div
//     tenths = (abs_n * 10 / div) % 10
//   Negative sign is prepended when n < 0.
//
// hn_parse(s: str) -> int
//   Parses a string produced by hn_format (or hand-written in the same style)
//   back to an integer.
//   "999"   -> 999
//   "1.5K"  -> 1500
//   "2M"    -> 2000000
//   "1.0B"  -> 1000000000
//   A missing decimal part is treated as zero tenths.
//   An unrecognised or absent suffix is treated as multiplier=1 (plain integer).
//   Negative values (leading '-') are supported in both directions.
//
// Public API:
//   hn_format(n: int) -> str
//   hn_parse(s: str)  -> int

// ── divisor table ────────────────────────────────────────────────────────────
// Parallel lists: _HN_DIVS[i] is the multiplier for _HN_SUFFIXES[i].
// Listed LARGEST-first so the first entry whose divisor is <= abs(n) wins.
// T = 10^12 = 1000000000000
// B = 10^9  = 1000000000
// M = 10^6  = 1000000
// K = 10^3  = 1000
fn _hn_divs() -> list
    [1000000000000, 1000000000, 1000000, 1000]

fn _hn_suffixes() -> list
    ["T", "B", "M", "K"]

// ── hn_format ────────────────────────────────────────────────────────────────
fn hn_format(n: int) -> str
    // Determine sign and work with absolute value.
    let neg = 0
    let abs_n = n
    if n < 0
        neg = 1
        abs_n = 0 - n

    // Values below 1000 have no suffix.
    if abs_n < 1000
        return str(n)

    // Walk the divisor table (largest first) to find the right suffix.
    let divs = _hn_divs()
    let suffs = _hn_suffixes()
    let chosen_div = 1000
    let chosen_suff = "K"
    let i = 0
    while i < len(divs)
        if abs_n >= divs[i]
            chosen_div = divs[i]
            chosen_suff = suffs[i]
            i = len(divs)
        i = i + 1

    // Compute whole part and single tenths digit via pure integer math.
    let whole = abs_n / chosen_div
    let tenths = (abs_n * 10 / chosen_div) % 10

    let sign_str = ""
    if neg == 1
        sign_str = "-"

    sign_str + str(whole) + "." + str(tenths) + chosen_suff

// ── hn_parse helpers ─────────────────────────────────────────────────────────

// Parse a run of ASCII digit characters starting at index `start` in `s`.
// Returns the integer value; stops at any non-digit character or end of string.
fn _hn_parse_digits(s: str, start: int) -> int
    let v = 0
    let i = start
    while i < len(s)
        let c = s[i]
        if c == "0" or c == "1" or c == "2" or c == "3" or c == "4" or c == "5" or c == "6" or c == "7" or c == "8" or c == "9"
            let digit = ord(c) - 48
            v = v * 10 + digit
            i = i + 1
        else
            i = len(s)
    v

// ── hn_parse ─────────────────────────────────────────────────────────────────
fn hn_parse(s: str) -> int
    let slen = len(s)
    if slen == 0
        return 0

    // Handle optional leading '-'.
    let neg = 0
    let pos = 0
    if s[0] == "-"
        neg = 1
        pos = 1

    // Find the suffix character: the last character if it is a letter.
    // Supported suffixes: K, M, B, T (case-sensitive, no trailing space).
    let last_c = s[slen - 1]
    let multiplier = 1
    let num_end = slen
    if last_c == "K"
        multiplier = 1000
        num_end = slen - 1
    if last_c == "M"
        multiplier = 1000000
        num_end = slen - 1
    if last_c == "B"
        multiplier = 1000000000
        num_end = slen - 1
    if last_c == "T"
        multiplier = 1000000000000
        num_end = slen - 1

    // Parse the numeric part (between pos and num_end).
    // Look for an optional '.' that introduces a single tenths digit.
    let dot_idx = num_end
    let j = pos
    while j < num_end
        if s[j] == "."
            dot_idx = j
            j = num_end
        j = j + 1

    let whole = 0
    let tenths = 0
    if dot_idx < num_end
        // Has a decimal part.
        whole = _hn_parse_digits(s, pos)
        let frac_start = dot_idx + 1
        if frac_start < num_end
            tenths = _hn_parse_digits(s, frac_start)
    else
        whole = _hn_parse_digits(s, pos)

    // result = whole * multiplier + tenths * multiplier / 10
    // For multiplier=1 (no suffix), tenths * 1 / 10 = 0 (integer), correct.
    let result = whole * multiplier + tenths * multiplier / 10

    if neg == 1
        return 0 - result
    result
