// NOVA std/util/statemachine — Deterministic finite state machine (dict-based).
//
// A lightweight FSM where transitions are stored as a flat dict keyed by
// "fromState|event" -> toState.  No function values: pure data, pure NOVA.
//
// Public API:
//   stm_new(initial_state)            -> dict   create a new FSM
//   stm_add_transition(m, from, ev, to)         register a transition
//   stm_fire(m, event)                -> bool   fire event (true if transition found)
//   stm_state(m)                      -> string query current state
//   stm_can_fire(m, event)            -> bool   test without changing state
//   stm_reset(m)                                return to the initial state
//
// Internal dict layout:
//   m["_state"]   : string  — current state
//   m["_initial"] : string  — initial state (for reset)
//   m["_trans"]   : dict    — transitions keyed "fromState|event" -> toState

// Construct a new FSM starting in initial_state.
fn stm_new(initial_state: string) -> dict
    let t = {}
    let m = {}
    m["_state"] = initial_state
    m["_initial"] = initial_state
    m["_trans"] = t
    m

// Register a deterministic transition: when in fromState and event fires,
// move to toState.  Overwrites any existing transition for this pair.
fn stm_add_transition(m: dict, fromState: string, event: string, toState: string)
    let key = fromState + "|" + event
    let trans = m["_trans"]
    trans[key] = toState
    m["_trans"] = trans

// Fire event against the current state.
// If a transition is defined for (currentState, event), update current state
// and return true.  Otherwise leave state unchanged and return false.
fn stm_fire(m: dict, event: string) -> bool
    let cur = m["_state"]
    let key = cur + "|" + event
    let trans = m["_trans"]
    if key in trans
        let next = trans[key]
        m["_state"] = next
        return true
    false

// Return the current state string.
fn stm_state(m: dict) -> string
    m["_state"]

// Test whether event can fire in the current state without changing anything.
fn stm_can_fire(m: dict, event: string) -> bool
    let cur = m["_state"]
    let key = cur + "|" + event
    let trans = m["_trans"]
    if key in trans
        return true
    false

// Reset the FSM to its initial state.
fn stm_reset(m: dict)
    let init = m["_initial"]
    m["_state"] = init
