// NOVA std/util/ratelimiter — Token-bucket rate limiter (pure, testable).
//
// The classic token-bucket algorithm:
//   * A bucket holds up to `capacity` tokens.
//   * Tokens refill at `rate` tokens/second.
//   * A request of `cost` tokens is allowed only if enough tokens are available.
//   * The caller passes the current timestamp (float or int seconds) so there is
//     NO hidden dependency on a real clock — the module is fully deterministic and
//     trivially unit-testable.
//
// Public API
// ----------
//   rl_new(capacity, refill_per_sec) -> dict
//       Create a new rate-limiter state dict.
//       Initial tokens = capacity (bucket starts full).
//       Fields: "cap" (float), "rate" (float), "tokens" (float), "last" (float).
//
//   rl_try(rl, now_sec, cost) -> bool
//       Attempt to consume `cost` tokens at time `now_sec`.
//       1. Refill: tokens = min(cap, tokens + (now_sec - last) * rate)
//       2. Update last = now_sec.
//       3. If tokens >= cost: deduct and return true; else return false.
//       Mutates `rl` in place (dict is a reference type).
//
//   rl_available(rl) -> float
//       Current token count (does NOT advance time — snapshot of stored state).

// ── Constructor ───────────────────────────────────────────────────────────────

fn rl_new(capacity, refill_per_sec) -> dict
    let cap = capacity * 1.0
    let rate = refill_per_sec * 1.0
    {"cap": cap, "rate": rate, "tokens": cap, "last": 0.0}

// ── Core operation ────────────────────────────────────────────────────────────

fn rl_try(rl, now_sec, cost) -> bool
    // 1. Compute elapsed time since last call.
    let t_now = now_sec * 1.0
    let t_last = rl["last"] * 1.0
    let elapsed = t_now - t_last

    // 2. Refill tokens (clamp to cap).
    let rate = rl["rate"] * 1.0
    let cap = rl["cap"] * 1.0
    let old_tokens = rl["tokens"] * 1.0
    let added = elapsed * rate
    let refilled = old_tokens + added
    let new_tokens = cap if refilled > cap else refilled

    // 3. Update last timestamp.
    rl["last"] = t_now

    // 4. Check if we can satisfy the request.
    let c = cost * 1.0
    if new_tokens >= c
        rl["tokens"] = new_tokens - c
        return true
    rl["tokens"] = new_tokens
    false

// ── Query ─────────────────────────────────────────────────────────────────────

fn rl_available(rl) -> float
    rl["tokens"] * 1.0
