// std/util/typename — runtime type introspection on top of type_of

fn tn_kind(v)
    return type_of(v)

fn tn_is_container(v)
    let k = type_of(v)
    if k == "list"
        return true
    if k == "dict"
        return true
    return false

fn tn_is_scalar(v)
    let k = type_of(v)
    if k == "int"
        return true
    if k == "float"
        return true
    if k == "string"
        return true
    if k == "bool"
        return true
    return false

fn tn_describe(v)
    let k = type_of(v)
    if k == "list"
        return "list[" + str(len(v)) + "]"
    if k == "dict"
        let nk = len(keys(v))
        return "dict" + chr(123) + str(nk) + chr(125)
    return k
