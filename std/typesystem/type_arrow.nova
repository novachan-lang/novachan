// std/typesystem/type_arrow — Arrow type utilities for NOVA's type system.
//
// TYPE REPRESENTATION (tagged lists):
//   ["tvar", k]          — type variable (k = int id)
//   ["arr", a, b]        — function type a -> b
//   ["con", name, args]  — type constructor (name = string, args = list of types)
//     Base types: ["con","int",[]]  ["con","bool",[]]
//     pair a b = ["con","pair",[a,b]]   list a = ["con","list",[a]]
//
// All public functions are prefixed tarr_.

// --- Type constructors (local, no imports) ---

// Build the int base type.
fn tyc_int() -> list
    let t = []
    push(t, "con")
    push(t, "int")
    let args = []
    push(t, args)
    return t

// Build the bool base type.
fn tyc_bool() -> list
    let t = []
    push(t, "con")
    push(t, "bool")
    let args = []
    push(t, args)
    return t

// Build a function type a -> b.
fn tyc_arr(a, b) -> list
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    return t

// Build a tvar type.
fn tyc_tvar(k) -> list
    let t = []
    push(t, "tvar")
    push(t, k)
    return t

// Build a pair constructor type.
fn tyc_pair(a, b) -> list
    let t = []
    push(t, "con")
    push(t, "pair")
    let args = []
    push(args, a)
    push(args, b)
    push(t, args)
    return t

// Build a list constructor type.
fn tyc_list(a) -> list
    let t = []
    push(t, "con")
    push(t, "list")
    let args = []
    push(args, a)
    push(t, args)
    return t

// --- Structural equality (needed for KAT comparison) ---

fn _tarr_scalar_eq(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "int"
        if a == b
            return 1
        return 0
    if ta == "string"
        if a == b
            return 1
        return 0
    return 0

// Structural (deep) equality of two types.
fn tarr_type_eq(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "list"
        let na = len(a)
        let nb = len(b)
        if na != nb
            return 0
        let i = 0
        let ok = 1
        while i < na
            let ai = a[i]
            let bi = b[i]
            if type_of(ai) == "list"
                let sub = tarr_type_eq(ai, bi)
                if sub == 0
                    ok = 0
            else
                let veq = _tarr_scalar_eq(ai, bi)
                if veq == 0
                    ok = 0
            i = i + 1
        return ok
    return _tarr_scalar_eq(a, b)

// --- Arrow utilities ---

// tarr_arity: count the number of leading arrow constructors in a curried type.
// e.g. a->b->c has arity 2; a->b has arity 1; int has arity 0.
fn tarr_arity(t) -> int
    if type_of(t) != "list"
        return 0
    if len(t) < 1
        return 0
    if t[0] != "arr"
        return 0
    return 1 + tarr_arity(t[2])

// tarr_arg_types: return the list of domain types of a curried arrow.
// e.g. a->b->c returns [a, b]; int returns [].
fn tarr_arg_types(t) -> list
    let result = []
    let cur = t
    while type_of(cur) == "list"
        if len(cur) < 1
            let done = 1
            cur = 0
        else
            if cur[0] == "arr"
                push(result, cur[1])
                cur = cur[2]
            else
                cur = 0
    return result

// tarr_result_type: return the final codomain of a (possibly curried) arrow type.
// e.g. a->b->c returns c; int returns int itself.
fn tarr_result_type(t) -> any
    let cur = t
    let going = 1
    while going == 1
        if type_of(cur) != "list"
            going = 0
        else
            if len(cur) < 1
                going = 0
            else
                if cur[0] == "arr"
                    cur = cur[2]
                else
                    going = 0
    return cur

// tarr_build: build a curried arrow type from a list of argument types and a result type.
// tarr_build([a, b], c) = a -> (b -> c).
fn tarr_build(args, result) -> any
    let n = len(args)
    let cur = result
    let i = n - 1
    while i >= 0
        cur = tyc_arr(args[i], cur)
        i = i - 1
    return cur

// tarr_curry: convert a pair-function type pair(a,b)->c to the curried form a->b->c.
// Input must be ["arr", ["con","pair",[a,b]], c].
fn tarr_curry(t) -> any
    if type_of(t) != "list"
        return "FAIL"
    if len(t) < 3
        return "FAIL"
    if t[0] != "arr"
        return "FAIL"
    let dom = t[1]
    let cod = t[2]
    if type_of(dom) != "list"
        return "FAIL"
    if len(dom) < 3
        return "FAIL"
    if dom[0] != "con"
        return "FAIL"
    if dom[1] != "pair"
        return "FAIL"
    let pargs = dom[2]
    if len(pargs) != 2
        return "FAIL"
    let a = pargs[0]
    let b = pargs[1]
    return tyc_arr(a, tyc_arr(b, cod))

// tarr_uncurry: convert a curried type a->b->c to pair(a,b)->c.
// Input must be ["arr", a, ["arr", b, c]].
fn tarr_uncurry(t) -> any
    if type_of(t) != "list"
        return "FAIL"
    if len(t) < 3
        return "FAIL"
    if t[0] != "arr"
        return "FAIL"
    let a = t[1]
    let inner = t[2]
    if type_of(inner) != "list"
        return "FAIL"
    if len(inner) < 3
        return "FAIL"
    if inner[0] != "arr"
        return "FAIL"
    let b = inner[1]
    let c = inner[2]
    return tyc_arr(tyc_pair(a, b), c)
