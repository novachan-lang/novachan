// ============================================================================
// NOVA Standard Library — std/typesystem/type_scheme.nova
// Type schemes for Hindley-Milner: forall quantification, FTV, generalize,
// instantiate. Types as tagged lists; scheme = ["forall", var_id_list, type].
// Leaf module — imports NOTHING.
// All public functions prefixed tsch_.
// ============================================================================

// ---------------------------------------------------------------------------
// Type constructors (helper builders — used internally and by callers)
// ---------------------------------------------------------------------------

// tyc_tvar(k) — build a type variable node.
fn tyc_tvar(k)
    let t = []
    push(t, "tvar")
    push(t, k)
    t

// tyc_arr(a, b) — build a function type a -> b.
fn tyc_arr(a, b)
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    t

// tyc_con(name, args) — build a type constructor node.
fn tyc_con(name, args)
    let t = []
    push(t, "con")
    push(t, name)
    push(t, args)
    t

// ---------------------------------------------------------------------------
// Private: type FTV collection
// ---------------------------------------------------------------------------

// _tsch_ftv_type(t, seen, out) — collect free type-variable ids from type t.
// seen is a dict (int-as-string -> 1) to avoid duplicates; out is the result list.
fn _tsch_ftv_type(t, seen, out)
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let ks = str(k)
        if not contains(seen, ks)
            seen[ks] = 1
            push(out, k)
    if tag == "arr"
        _tsch_ftv_type(t[1], seen, out)
        _tsch_ftv_type(t[2], seen, out)
    if tag == "con"
        let args = t[2]
        for i in 0..len(args)
            _tsch_ftv_type(args[i], seen, out)

// _tsch_type_ftv(t) — return list of free type-variable ids in type t.
fn _tsch_type_ftv(t)
    let seen = {}
    let out = []
    _tsch_ftv_type(t, seen, out)
    out

// _tsch_env_ftv(env) — collect all free type-variable ids free in environment.
// env is a list of [name, scheme_or_type] pairs.
fn _tsch_env_ftv(env)
    let seen = {}
    let out = []
    for i in 0..len(env)
        let binding = env[i]
        let sc = binding[1]
        // If it's a scheme ["forall", qs, body], only body-vars not in qs are free.
        // If it's a plain type (no "forall"), all its tvars are free.
        let btag = sc[0]
        if btag == "forall"
            let qs = sc[1]
            let body = sc[2]
            // build set of quantified ids
            let qset = {}
            let qi = 0
            while qi < len(qs)
                qset[str(qs[qi])] = 1
                qi = qi + 1
            // collect tvars from body not in qset
            let bvars = _tsch_type_ftv(body)
            let bi = 0
            while bi < len(bvars)
                let k = bvars[bi]
                let ks = str(k)
                if not contains(qset, ks)
                    if not contains(seen, ks)
                        seen[ks] = 1
                        push(out, k)
                bi = bi + 1
        else
            // plain type
            _tsch_ftv_type(sc, seen, out)
    out

// ---------------------------------------------------------------------------
// tsch_mono(t) — lift a plain type into a monomorphic scheme (no quantifiers).
fn tsch_mono(t)
    let sc = []
    push(sc, "forall")
    let qs = []
    push(sc, qs)
    push(sc, t)
    sc

// ---------------------------------------------------------------------------
// tsch_ftv(scheme) — return list of free type-variable ids in a scheme.
fn tsch_ftv(scheme)
    let qs = scheme[1]
    let body = scheme[2]
    // quantified ids form an exclusion set
    let qset = {}
    for qi in 0..len(qs)
        qset[str(qs[qi])] = 1
    let bvars = _tsch_type_ftv(body)
    let out = []
    let seen = {}
    for bi in 0..len(bvars)
        let k = bvars[bi]
        let ks = str(k)
        if not contains(qset, ks)
            if not contains(seen, ks)
                seen[ks] = 1
                push(out, k)
    out

// ---------------------------------------------------------------------------
// tsch_generalize(env, t) — generalize t over tvars free in t but not in env.
// Returns a scheme ["forall", quantified_ids, t].
fn tsch_generalize(env, t)
    let tfvs = _tsch_type_ftv(t)
    let efvs = _tsch_env_ftv(env)
    // build set of env free vars
    let eset = {}
    for ei in 0..len(efvs)
        eset[str(efvs[ei])] = 1
    // quantify tvars in t not free in env
    let qs = []
    for ti in 0..len(tfvs)
        let k = tfvs[ti]
        if not contains(eset, str(k))
            push(qs, k)
    let sc = []
    push(sc, "forall")
    push(sc, qs)
    push(sc, t)
    sc

// ---------------------------------------------------------------------------
// tsch_instantiate(scheme, ctr) — replace each quantified var with a fresh one.
// ctr is a 1-element mutable list used as a counter: ctr[0] is the next id.
fn tsch_instantiate(scheme, ctr)
    let qs = scheme[1]
    let body = scheme[2]
    // build substitution: old_id -> fresh tvar
    let sub = []
    for qi in 0..len(qs)
        let old_id = qs[qi]
        let new_id = ctr[0]
        ctr[0] = ctr[0] + 1
        let pair = []
        push(pair, old_id)
        push(pair, tyc_tvar(new_id))
        push(sub, pair)
    _tsch_apply_sub(sub, body)

// ---------------------------------------------------------------------------
// Private: apply substitution to a type (needed for instantiate).
// sub is a list of [k, replacement_type] pairs.
fn _tsch_apply_sub(sub, t)
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let i = 0
        let result = t
        while i < len(sub)
            let pair = sub[i]
            if pair[0] == k
                result = pair[1]
            i = i + 1
        result
    else
        if tag == "arr"
            let a2 = _tsch_apply_sub(sub, t[1])
            let b2 = _tsch_apply_sub(sub, t[2])
            tyc_arr(a2, b2)
        else
            if tag == "con"
                let nm = t[1]
                let args = t[2]
                let new_args = [_tsch_apply_sub(sub, args[i]) for i in 0..len(args)]
                tyc_con(nm, new_args)
            else
                t
