// std/typesystem/type_alpha — Alpha-equivalence and canonical renaming of type variables.
//
// TYPE REPRESENTATION (tagged lists):
//   ["tvar", k]          — type variable (k = int id)
//   ["arr", a, b]        — function type a -> b
//   ["con", name, args]  — type constructor (name = string, args = list of types)
//     Base types: ["con","int",[]]  ["con","bool",[]]
//
// All public functions are prefixed talp_.

// --- Type constructors (local, no imports) ---

// Build the int base type.
fn tyc_int() -> list
    let t = []
    push(t, "con")
    push(t, "int")
    let args = []
    push(t, args)
    return t

// Build the bool base type.
fn tyc_bool() -> list
    let t = []
    push(t, "con")
    push(t, "bool")
    let args = []
    push(t, args)
    return t

// Build a function type a -> b.
fn tyc_arr(a, b) -> list
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    return t

// Build a tvar type.
fn tyc_tvar(k) -> list
    let t = []
    push(t, "tvar")
    push(t, k)
    return t

// Build a pair constructor type.
fn tyc_pair(a, b) -> list
    let t = []
    push(t, "con")
    push(t, "pair")
    let args = []
    push(args, a)
    push(args, b)
    push(t, args)
    return t

// Build a list constructor type.
fn tyc_list(a) -> list
    let t = []
    push(t, "con")
    push(t, "list")
    let args = []
    push(args, a)
    push(t, args)
    return t

// --- Structural equality (needed for alpha_equal comparison) ---

fn _talp_scalar_eq(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "int"
        if a == b
            return 1
        return 0
    if ta == "string"
        if a == b
            return 1
        return 0
    return 0

// Structural (deep) equality of two types.
fn _talp_type_eq(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "list"
        let na = len(a)
        let nb = len(b)
        if na != nb
            return 0
        let i = 0
        let ok = 1
        while i < na
            let ai = a[i]
            let bi = b[i]
            if type_of(ai) == "list"
                let sub = _talp_type_eq(ai, bi)
                if sub == 0
                    ok = 0
            else
                let veq = _talp_scalar_eq(ai, bi)
                if veq == 0
                    ok = 0
            i += 1
        return ok
    return _talp_scalar_eq(a, b)

// --- Mapping helpers ---

// Look up key k in a mapping (list of [k, v] pairs). Returns -1 if not found.
fn _talp_map_get(mapping, k) -> int
    for i in 0..len(mapping)
        let pair = mapping[i]
        if pair[0] == k
            return pair[1]
    return -1

// --- talp_rename: apply a mapping (list of [old_id, new_id] pairs) to rename tvars. ---
fn talp_rename(t, mapping) -> any
    if type_of(t) != "list"
        return t
    if len(t) < 1
        return t
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let newk = _talp_map_get(mapping, k)
        if newk == -1
            return t
        return tyc_tvar(newk)
    if tag == "arr"
        let a2 = talp_rename(t[1], mapping)
        let b2 = talp_rename(t[2], mapping)
        return tyc_arr(a2, b2)
    if tag == "con"
        let name = t[1]
        let args = t[2]
        let newargs = [talp_rename(args[i], mapping) for i in 0..len(args)]
        let res = []
        push(res, "con")
        push(res, name)
        push(res, newargs)
        return res
    return t

// --- Canonical renaming (collect tvars left-to-right, assign 0,1,2,...) ---

// _talp_collect: walk type t in left-to-right order, adding tvar ids to 'seen'
// (as a list of int ids in first-appearance order) if not already present.
fn _talp_collect(t, seen)
    if type_of(t) != "list"
        return 0
    if len(t) < 1
        return 0
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let found = 0
        for i in 0..len(seen)
            if seen[i] == k
                found = 1
        if found == 0
            push(seen, k)
        return 0
    if tag == "arr"
        _talp_collect(t[1], seen)
        _talp_collect(t[2], seen)
        return 0
    if tag == "con"
        let args = t[2]
        for i in 0..len(args)
            _talp_collect(args[i], seen)
        return 0
    return 0

// talp_canonical: renumber type variables 0,1,2,... in order of first appearance
// (left-to-right traversal). Type variables with no occurrence are unchanged.
fn talp_canonical(t) -> any
    let seen = []
    _talp_collect(t, seen)
    let mapping = []
    for i in 0..len(seen)
        let pair = []
        push(pair, seen[i])
        push(pair, i)
        push(mapping, pair)
    return talp_rename(t, mapping)

// talp_type_eq: structural (deep) equality of two types. Returns 1 if equal, 0 otherwise.
fn talp_type_eq(a, b) -> int
    return _talp_type_eq(a, b)

// talp_alpha_equal: return 1 if a and b are alpha-equivalent (canonical forms are equal).
fn talp_alpha_equal(a, b) -> int
    let ca = talp_canonical(a)
    let cb = talp_canonical(b)
    return _talp_type_eq(ca, cb)
