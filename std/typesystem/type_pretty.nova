// std/typesystem/type_pretty — Type expression pretty-printer and parser.
// LEAF module — imports NOTHING.
//
// Type representation (shared across all typesystem modules):
//   ["tvar", k]         — type variable with integer id k
//   ["arr",  a, b]      — function type a -> b
//   ["con", name, args] — type constructor: name string, args list of types
//     Base: ["con","int",[]], ["con","bool",[]]
//     list a  = ["con","list",[a]]
//     pair a b = ["con","pair",[a,b]]
//
// Public type builders (tyc_ prefix, used in KAT tests):
//   tyc_tvar(k)          -> ["tvar", k]
//   tyc_arr(a, b)        -> ["arr", a, b]
//   tyc_con(name, args)  -> ["con", name, args]
//   tyc_int()            -> ["con","int",[]]
//   tyc_bool()           -> ["con","bool",[]]
//   tyc_list(a)          -> ["con","list",[a]]
//   tyc_pair(a, b)       -> ["con","pair",[a,b]]
//
// Public API (tpp_ prefix):
//   tpp_print(t)     -> string  (type variables lettered a,b,c,... by id; arrows right-assoc)
//   tpp_parse(s)     -> list    (inverse for arrow/var/int/bool fragment)
//
// Print rules:
//   tvar k       -> letter for k (a=0, b=1, ..., z=25, a0=26, ...)
//   arr(a,b)     -> if a is arr: "(" + print(a) + ") -> " + print(b)
//                   else: print(a) + " -> " + print(b)
//   con"int"[]   -> "int"
//   con"bool"[]  -> "bool"
//   con"list"[a] -> "list " + print_arg(a)
//   con"pair"[a,b] -> "pair " + print_arg(a) + " " + print_arg(b)
//   (print_arg adds parens around arr and multi-arg con)
//
// Parse grammar (tpp_parse):
//   type  ::= atype ("->" type)?        (right-associative)
//   atype ::= "(" type ")"
//           | letter                    (type variable, letter a-z)
//           | "int" | "bool"
//           | "list" atype
//           | "pair" atype atype

// ── Type builders ──────────────────────────────────────────────────────────────

// tyc_tvar — build a type variable node.
fn tyc_tvar(k: int) -> list
    let t = []
    push(t, "tvar")
    push(t, k)
    return t

// tyc_arr — build a function type node.
fn tyc_arr(a: list, b: list) -> list
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    return t

// tyc_con — build a type constructor node.
fn tyc_con(name: string, args: list) -> list
    let t = []
    push(t, "con")
    push(t, name)
    push(t, args)
    return t

// tyc_int — build the Int base type.
fn tyc_int() -> list
    let args = []
    return tyc_con("int", args)

// tyc_bool — build the Bool base type.
fn tyc_bool() -> list
    let args = []
    return tyc_con("bool", args)

// tyc_list — build a list type constructor applied to a.
fn tyc_list(a: list) -> list
    let args = []
    push(args, a)
    return tyc_con("list", args)

// tyc_pair — build a pair type constructor applied to a and b.
fn tyc_pair(a: list, b: list) -> list
    let args = []
    push(args, a)
    push(args, b)
    return tyc_con("pair", args)

// ── Pretty printer ─────────────────────────────────────────────────────────────

// _tpp_var_letter — convert a tvar id to a letter string.
// 0->'a', 1->'b', ..., 25->'z', 26->'a0', 27->'b0', ...
fn _tpp_var_letter(k: int) -> string
    let base = k % 26
    let rep = k / 26
    let letter = ""
    if base == 0
        letter = "a"
    if base == 1
        letter = "b"
    if base == 2
        letter = "c"
    if base == 3
        letter = "d"
    if base == 4
        letter = "e"
    if base == 5
        letter = "f"
    if base == 6
        letter = "g"
    if base == 7
        letter = "h"
    if base == 8
        letter = "i"
    if base == 9
        letter = "j"
    if base == 10
        letter = "k"
    if base == 11
        letter = "l"
    if base == 12
        letter = "m"
    if base == 13
        letter = "n"
    if base == 14
        letter = "o"
    if base == 15
        letter = "p"
    if base == 16
        letter = "q"
    if base == 17
        letter = "r"
    if base == 18
        letter = "s"
    if base == 19
        letter = "t"
    if base == 20
        letter = "u"
    if base == 21
        letter = "v"
    if base == 22
        letter = "w"
    if base == 23
        letter = "x"
    if base == 24
        letter = "y"
    if base == 25
        letter = "z"
    if rep == 0
        return letter
    return letter + str(rep - 1)

// _tpp_is_arr — return 1 if this type is an arrow type.
fn _tpp_is_arr(t: list) -> int
    if t[0] == "arr"
        return 1
    return 0

// _tpp_is_multi_con — return 1 if con with at least one arg (needs parens in arg position).
fn _tpp_is_multi_con(t: list) -> int
    if t[0] == "con"
        let args = t[2]
        if len(args) > 0
            return 1
    return 0

// tpp_print — pretty-print a type to a string.
// Arrows are right-associative; left side of -> is parenthesized if it is itself an arrow.
fn tpp_print(t: list) -> string
    let tag = t[0]
    if tag == "tvar"
        return _tpp_var_letter(t[1])
    if tag == "arr"
        let a = t[1]
        let b = t[2]
        let left = ""
        if _tpp_is_arr(a) == 1
            left = "(" + tpp_print(a) + ")"
        else
            left = tpp_print(a)
        return left + " -> " + tpp_print(b)
    if tag == "con"
        let name = t[1]
        let args = t[2]
        if name == "int"
            return "int"
        if name == "bool"
            return "bool"
        if name == "list"
            let a = args[0]
            return "list " + _tpp_print_arg(a)
        if name == "pair"
            let a = args[0]
            let b = args[1]
            return "pair " + _tpp_print_arg(a) + " " + _tpp_print_arg(b)
        // fallback: name only (unknown constructor)
        return name
    return "?"

// _tpp_print_arg — print a type in argument position (add parens if needed).
// Parens needed around: arr types, and multi-arg con types (list/pair applied).
fn _tpp_print_arg(t: list) -> string
    if _tpp_is_arr(t) == 1
        return "(" + tpp_print(t) + ")"
    if _tpp_is_multi_con(t) == 1
        return "(" + tpp_print(t) + ")"
    return tpp_print(t)

// ── Parser ─────────────────────────────────────────────────────────────────────
// Parses the fragment: tvar (single letters a-z), int, bool, arrow (->), parens,
// list <atype>, pair <atype> <atype>.
// Returns the parsed type as a list, or ["con","FAIL",[]] on error.
//
// State: a 1-element list [pos] threaded through recursive descent.
//
// Grammar:
//   type  ::= atype ("->" type)?
//   atype ::= "(" type ")"  | letter | "int" | "bool" | "list" atype | "pair" atype atype

// _tpp_ws — skip whitespace, advance state pos.
fn _tpp_ws(src: string, st: list)
    let n = len(src)
    let going = 1
    while going == 1
        if st[0] >= n
            going = 0
        else
            let c = slice(src, st[0], st[0] + 1)
            if c == " "
                st[0] = st[0] + 1
            else
                if c == "\t"
                    st[0] = st[0] + 1
                else
                    going = 0
    return 0

// _tpp_is_letter — 1 if c is a-z single char (type variable).
fn _tpp_is_letter(c: string) -> int
    let o = ord(c)
    if o >= 97
        if o <= 122
            return 1
    return 0

// _tpp_is_alpha — 1 if c is a-zA-Z (for word scanning).
fn _tpp_is_alpha(c: string) -> int
    let o = ord(c)
    if o >= 65
        if o <= 90
            return 1
    if o >= 97
        if o <= 122
            return 1
    return 0

// _tpp_scan_word — scan a word (alpha chars) starting at pos, return word string.
fn _tpp_scan_word(src: string, st: list) -> string
    let n = len(src)
    let start = st[0]
    let end = start
    let going = 1
    while going == 1
        if end >= n
            going = 0
        else
            let c = slice(src, end, end + 1)
            if _tpp_is_alpha(c) == 1
                end = end + 1
            else
                going = 0
    st[0] = end
    return slice(src, start, end)

// _tpp_fail — return a fail sentinel type.
fn _tpp_fail() -> list
    let args = []
    return tyc_con("FAIL", args)

// Forward-declared (NOVA allows mutual recursion in same file): _tpp_parse_type, _tpp_parse_atype.

// _tpp_parse_atype — parse an atomic type (no leading arrow).
fn _tpp_parse_atype(src: string, st: list) -> list
    let n = len(src)
    _tpp_ws(src, st)
    if st[0] >= n
        return _tpp_fail()
    let c = slice(src, st[0], st[0] + 1)
    if c == "("
        st[0] = st[0] + 1
        let inner = _tpp_parse_type(src, st)
        _tpp_ws(src, st)
        if st[0] < n
            let cc = slice(src, st[0], st[0] + 1)
            if cc == ")"
                st[0] = st[0] + 1
        return inner
    // Try a word (ident or type variable)
    if _tpp_is_alpha(c) == 1
        let word = _tpp_scan_word(src, st)
        if word == "int"
            return tyc_int()
        if word == "bool"
            return tyc_bool()
        if word == "list"
            let a = _tpp_parse_atype(src, st)
            return tyc_list(a)
        if word == "pair"
            let a = _tpp_parse_atype(src, st)
            let b = _tpp_parse_atype(src, st)
            return tyc_pair(a, b)
        // single letter: type variable (use first char's offset from 'a')
        if len(word) == 1
            let vid = ord(word) - 97
            return tyc_tvar(vid)
        // multi-letter unknown: treat as named tvar with id 0 (best effort)
        return _tpp_fail()
    return _tpp_fail()

// _tpp_peek_arrow — return 1 if next non-ws chars are "->".
fn _tpp_peek_arrow(src: string, st: list) -> int
    let n = len(src)
    let p = st[0]
    // skip whitespace locally (don't mutate st)
    let going = 1
    while going == 1
        if p >= n
            going = 0
        else
            let c = slice(src, p, p + 1)
            if c == " "
                p = p + 1
            else
                if c == "\t"
                    p = p + 1
                else
                    going = 0
    if p + 1 >= n
        return 0
    let c1 = slice(src, p, p + 1)
    let c2 = slice(src, p + 1, p + 2)
    if c1 == "-"
        if c2 == ">"
            return 1
    return 0

// _tpp_consume_arrow — skip whitespace then consume "->", advance st.
fn _tpp_consume_arrow(src: string, st: list)
    _tpp_ws(src, st)
    st[0] = st[0] + 2
    return 0

// _tpp_parse_type — parse a full type (possibly with ->).
fn _tpp_parse_type(src: string, st: list) -> list
    let a = _tpp_parse_atype(src, st)
    if _tpp_peek_arrow(src, st) == 1
        _tpp_consume_arrow(src, st)
        let b = _tpp_parse_type(src, st)
        return tyc_arr(a, b)
    return a

// tpp_parse — parse a type expression string into a type list.
// Returns ["con","FAIL",[]] on parse error.
fn tpp_parse(s: string) -> list
    let st = []
    push(st, 0)
    let result = _tpp_parse_type(s, st)
    return result
