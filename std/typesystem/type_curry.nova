// std/typesystem/type_curry — Curry-Howard: propositions as types, proofs as inhabitants.
// LEAF module — imports NOTHING.
//
// A proposition is an implicational type built from:
//   ["tvar", k]    — propositional variable (atom), k is an int
//   ["arr",  a, b] — implication a => b (function type)
//
// Proof terms (lambda terms):
//   ["var", name]        — variable reference (name is a string)
//   ["lam", name, body]  — abstraction
//   ["app", f, a]        — application
//
// Context: list of [name, prop] pairs.
//
// Public type builders (tyc_ prefix, self-contained copy):
//   tyc_tvar(k), tyc_arr(a,b), tyc_con(name,args), tyc_int(), tyc_bool()
//   tyc_list(a), tyc_pair(a,b)
//
// Public API (tcur_ prefix):
//   tcur_check_proof(ctx, proofterm, prop) -> bool
//   tcur_is_tautology_simple(prop) -> bool

// ── Type builders ─────────────────────────────────────────────────────────────

fn tyc_tvar(k: int) -> list
    let t = []
    push(t, "tvar")
    push(t, k)
    return t

fn tyc_arr(a: list, b: list) -> list
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    return t

fn tyc_con(name: string, args: list) -> list
    let t = []
    push(t, "con")
    push(t, name)
    push(t, args)
    return t

fn tyc_int() -> list
    let args = []
    return tyc_con("int", args)

fn tyc_bool() -> list
    let args = []
    return tyc_con("bool", args)

fn tyc_list(a: list) -> list
    let args = []
    push(args, a)
    return tyc_con("list", args)

fn tyc_pair(a: list, b: list) -> list
    let args = []
    push(args, a)
    push(args, b)
    return tyc_con("pair", args)

// ── Structural type equality ─────────────────────────────────────────────────

// _tcur_type_eq — exact structural equality (no alpha-renaming).
fn _tcur_type_eq(a: list, b: list) -> int
    if len(a) == 0
        if len(b) == 0
            return 1
        return 0
    if len(b) == 0
        return 0
    let ta = a[0]
    let tb = b[0]
    if ta != tb
        return 0
    if ta == "tvar"
        if a[1] == b[1]
            return 1
        return 0
    if ta == "arr"
        if _tcur_type_eq(a[1], b[1]) == 0
            return 0
        return _tcur_type_eq(a[2], b[2])
    if ta == "con"
        if a[1] != b[1]
            return 0
        let aa = a[2]
        let ba = b[2]
        if len(aa) != len(ba)
            return 0
        for i in 0..len(aa)
            if _tcur_type_eq(aa[i], ba[i]) == 0
                return 0
        return 1
    return 0

// ── Alpha-equivalence ────────────────────────────────────────────────────────
// Compare two types up to consistent renaming of tvar ids.
// Strategy: walk both trees simultaneously, maintaining two lists (orderA, orderB)
// that record tvar ids in first-appearance order. Two tvars are alpha-equivalent
// iff they appear at the same position in their respective first-appearance lists.

// _tcur_list_index — find first index of val in lst; return -1 if absent.
fn _tcur_list_index(lst: list, val: int) -> int
    for i in 0..len(lst)
        if lst[i] == val
            return i
    return -1

// _tcur_alpha_walk — walk types a and b simultaneously.
// orderA, orderB = first-appearance lists of tvar ids (mutated).
// Returns 1 if alpha-equivalent, 0 otherwise.
fn _tcur_alpha_walk(a: list, b: list, orderA: list, orderB: list) -> int
    let ta = a[0]
    let tb = b[0]
    if ta != tb
        return 0
    if ta == "tvar"
        let ka = a[1]
        let kb = b[1]
        let ia = _tcur_list_index(orderA, ka)
        let ib = _tcur_list_index(orderB, kb)
        // Both unseen: assign same fresh position.
        if ia == -1
            if ib == -1
                push(orderA, ka)
                push(orderB, kb)
                return 1
            // a is new but b was seen before — mismatch in structure.
            return 0
        // a was seen before but b is new — mismatch.
        if ib == -1
            return 0
        // Both seen: positions must match.
        if ia == ib
            return 1
        return 0
    if ta == "arr"
        if _tcur_alpha_walk(a[1], b[1], orderA, orderB) == 0
            return 0
        return _tcur_alpha_walk(a[2], b[2], orderA, orderB)
    if ta == "con"
        if a[1] != b[1]
            return 0
        let aa = a[2]
        let ba = b[2]
        if len(aa) != len(ba)
            return 0
        for i in 0..len(aa)
            if _tcur_alpha_walk(aa[i], ba[i], orderA, orderB) == 0
                return 0
        return 1
    return 0

// _tcur_types_alpha_equal — alpha-equivalence of two types.
fn _tcur_types_alpha_equal(a: list, b: list) -> int
    let oa = []
    let ob = []
    return _tcur_alpha_walk(a, b, oa, ob)

// ── Context operations ───────────────────────────────────────────────────────

// _tcur_ctx_lookup — look up name in ctx (newest binding wins).
// Returns the type list or null if absent.
fn _tcur_ctx_lookup(ctx: list, name: string) -> list
    let i = len(ctx) - 1
    while i >= 0
        let entry = ctx[i]
        if entry[0] == name
            return entry[1]
        i = i - 1
    return null

// _tcur_ctx_extend — append a new binding.
fn _tcur_ctx_extend(ctx: list, name: string, tp: list) -> list
    let newctx = []
    for i in 0..len(ctx)
        push(newctx, ctx[i])
    let entry = []
    push(entry, name)
    push(entry, tp)
    push(newctx, entry)
    return newctx

// ── Simply-typed lambda calculus type inference / checking ────────────────────
//
// _tcur_infer — infer type of term under ctx; return type list or null on failure.
// _tcur_check — check that term has type tp under ctx; return 1 or 0.
//
// Rules:
//   var x:    find x in ctx; return its type.
//   lam x.e:  cannot infer without annotation; return null.
//   app f e:  infer f -> must be arr(dom, rng); check e:dom; result = rng.
//
// For tcur_check_proof, we use bidirectional typing:
//   lam x.e : A -> B   check body e:B under ctx+x:A.
//   otherwise: infer and compare.

fn _tcur_infer(ctx: list, term: list) -> list
    let tag = term[0]
    if tag == "var"
        return _tcur_ctx_lookup(ctx, term[1])
    if tag == "lam"
        // Cannot infer lambda without domain type.
        return null
    if tag == "app"
        let fn_ty = _tcur_infer(ctx, term[1])
        if fn_ty == null
            return null
        if fn_ty[0] != "arr"
            return null
        let dom = fn_ty[1]
        let rng = fn_ty[2]
        if _tcur_check(ctx, term[2], dom) == 0
            return null
        return rng
    return null

fn _tcur_check(ctx: list, term: list, tp: list) -> int
    let tag = term[0]
    if tag == "lam"
        if tp[0] != "arr"
            return 0
        let dom = tp[1]
        let rng = tp[2]
        let newctx = _tcur_ctx_extend(ctx, term[1], dom)
        return _tcur_check(newctx, term[2], rng)
    // Non-lambda: infer and compare structurally.
    let inferred = _tcur_infer(ctx, term)
    if inferred == null
        return 0
    return _tcur_type_eq(inferred, tp)

// tcur_check_proof — check that proofterm inhabits prop under ctx.
fn tcur_check_proof(ctx: list, proofterm: list, prop: list) -> bool
    if _tcur_check(ctx, proofterm, prop) == 1
        return true
    return false

// ── Combinator constructors ──────────────────────────────────────────────────

// _tcur_var — build a variable term.
fn _tcur_var(name: string) -> list
    let t = []
    push(t, "var")
    push(t, name)
    return t

// _tcur_lam — build a lambda term.
fn _tcur_lam(name: string, body: list) -> list
    let t = []
    push(t, "lam")
    push(t, name)
    push(t, body)
    return t

// _tcur_app — build an application term.
fn _tcur_app(f: list, a: list) -> list
    let t = []
    push(t, "app")
    push(t, f)
    push(t, a)
    return t

// _tcur_I_term — I combinator: lam x. x
fn _tcur_I_term() -> list
    return _tcur_lam("x", _tcur_var("x"))

// _tcur_I_prop — I type: a -> a (tvar 0 -> tvar 0)
fn _tcur_I_prop() -> list
    return tyc_arr(tyc_tvar(0), tyc_tvar(0))

// _tcur_K_term — K combinator: lam x. lam y. x
fn _tcur_K_term() -> list
    return _tcur_lam("x", _tcur_lam("y", _tcur_var("x")))

// _tcur_K_prop — K type: a -> b -> a (tvar 0 -> tvar 1 -> tvar 0)
fn _tcur_K_prop() -> list
    return tyc_arr(tyc_tvar(0), tyc_arr(tyc_tvar(1), tyc_tvar(0)))

// _tcur_S_term — S combinator: lam f. lam g. lam x. (f x)(g x)
fn _tcur_S_term() -> list
    let fx = _tcur_app(_tcur_var("f"), _tcur_var("x"))
    let gx = _tcur_app(_tcur_var("g"), _tcur_var("x"))
    let fxgx = _tcur_app(fx, gx)
    let lx = _tcur_lam("x", fxgx)
    let lg = _tcur_lam("g", lx)
    return _tcur_lam("f", lg)

// _tcur_S_prop — S type: (a->b->c)->(a->b)->a->c
// a=tvar(0), b=tvar(1), c=tvar(2)
fn _tcur_S_prop() -> list
    let a = tyc_tvar(0)
    let b = tyc_tvar(1)
    let c = tyc_tvar(2)
    let abc = tyc_arr(a, tyc_arr(b, c))
    let ab = tyc_arr(a, b)
    return tyc_arr(abc, tyc_arr(ab, tyc_arr(a, c)))

// tcur_is_tautology_simple — test if prop is inhabited by I, K, or S.
// Check: prop is alpha-equivalent to one of {I_prop, K_prop, S_prop}
// and the corresponding standard proof term checks against that canonical prop.
fn tcur_is_tautology_simple(prop: list) -> bool
    let ctx = []
    // I: a -> a
    if _tcur_types_alpha_equal(prop, _tcur_I_prop()) == 1
        if _tcur_check(ctx, _tcur_I_term(), _tcur_I_prop()) == 1
            return true
    // K: a -> b -> a
    if _tcur_types_alpha_equal(prop, _tcur_K_prop()) == 1
        if _tcur_check(ctx, _tcur_K_term(), _tcur_K_prop()) == 1
            return true
    // S: (a->b->c)->(a->b)->a->c
    if _tcur_types_alpha_equal(prop, _tcur_S_prop()) == 1
        if _tcur_check(ctx, _tcur_S_term(), _tcur_S_prop()) == 1
            return true
    return false
