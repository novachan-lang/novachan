// std/typesystem/type_subst — Type substitutions for Hindley-Milner inference.
//
// A SUBSTITUTION is a list of [k, type] pairs mapping type-variable id k to a type.
// TYPE REPRESENTATION (identical to type_core, reproduced here for self-containment):
//   ["tvar", k]          — type variable
//   ["arr", a, b]        — function type
//   ["con", name, args]  — type constructor
//
// All public functions are prefixed tsub_.

// ── internal type constructors (self-contained; no import of type_core) ────────

fn _tsub_tvar(k) -> list
    let t = []
    push(t, "tvar")
    push(t, k)
    return t

fn _tsub_arr(a, b) -> list
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    return t

fn _tsub_con(name, args) -> list
    let t = []
    push(t, "con")
    push(t, name)
    push(t, args)
    return t

// ── substitution constructors ───────────────────────────────────────────────

// Return an empty substitution.
fn tsub_empty() -> list
    return []

// Return a substitution mapping type-variable k to type t.
fn tsub_single(k, t) -> list
    let pair = []
    push(pair, k)
    push(pair, t)
    let sub = []
    push(sub, pair)
    return sub

// ── substitution lookup ─────────────────────────────────────────────────────

// Look up key k in sub; return the bound type, or "NOTFOUND" (string sentinel).
fn tsub_lookup(sub, k) -> any
    for i in 0..len(sub)
        let pair = sub[i]
        if pair[0] == k
            return pair[1]
    return "NOTFOUND"

// ── apply substitution to a type ────────────────────────────────────────────

// Walk type t, replacing each ["tvar", k] whose k is bound in sub.
fn tsub_apply(sub, t) -> any
    if type_of(t) != "list"
        return t
    if len(t) < 1
        return t
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let found = tsub_lookup(sub, k)
        if type_of(found) == "string"
            if found == "NOTFOUND"
                return t
        return tsub_apply(sub, found)
    if tag == "arr"
        let a2 = tsub_apply(sub, t[1])
        let b2 = tsub_apply(sub, t[2])
        return _tsub_arr(a2, b2)
    if tag == "con"
        let name = t[1]
        let args = t[2]
        let new_args = []
        for i in 0..len(args)
            let a2 = tsub_apply(sub, args[i])
            push(new_args, a2)
        return _tsub_con(name, new_args)
    return t

// ── compose substitutions ───────────────────────────────────────────────────

// compose(s2, s1): the substitution that is s2 after s1.
// Semantically: apply(compose(s2,s1), t) = apply(s2, apply(s1, t)).
// Implementation: apply s2 to every rhs of s1, then append s2's own bindings
// (for keys not already present in s1).
fn tsub_compose(s2, s1) -> list
    let result = []
    // Apply s2 to each binding in s1
    for i in 0..len(s1)
        let pair = s1[i]
        let k = pair[0]
        let v = pair[1]
        let v2 = tsub_apply(s2, v)
        let new_pair = []
        push(new_pair, k)
        push(new_pair, v2)
        push(result, new_pair)
    // Add s2 bindings whose key is not in s1
    for j in 0..len(s2)
        let pair2 = s2[j]
        let k2 = pair2[0]
        let found = 0
        let m = 0
        while m < len(s1)
            if s1[m][0] == k2
                found = 1
            m += 1
        if found == 0
            push(result, pair2)
    return result

// ── apply substitution to an environment ───────────────────────────────────

// Apply sub to every type in an environment (list of [name, type] pairs).
fn tsub_apply_env(sub, env) -> list
    let result = []
    for i in 0..len(env)
        let entry = env[i]
        let name = entry[0]
        let ty = entry[1]
        let ty2 = tsub_apply(sub, ty)
        let new_entry = []
        push(new_entry, name)
        push(new_entry, ty2)
        push(result, new_entry)
    return result
