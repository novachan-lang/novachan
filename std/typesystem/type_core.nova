// std/typesystem/type_core — Core type representation for Hindley-Milner type inference.
//
// A type is a tagged list (one of three forms):
//   ["tvar", k]          — type variable with integer id k
//   ["arr", a, b]        — function type a -> b
//   ["con", name, args]  — type constructor: name is a string, args is a list of types
//
// Base types: tyc_int() = ["con","int",[]]  tyc_bool() = ["con","bool",[]]
// Derived:    tyc_list(a) = ["con","list",[a]]  tyc_pair(a,b) = ["con","pair",[a,b]]
//
// All public functions are prefixed tyc_.

// Construct a type variable with id k.
fn tyc_tvar(k) -> list
    let t = []
    push(t, "tvar")
    push(t, k)
    return t

// Construct a function type a -> b.
fn tyc_arr(a, b) -> list
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    return t

// Construct a type constructor with given name and argument list.
fn tyc_con(name, args) -> list
    let t = []
    push(t, "con")
    push(t, name)
    push(t, args)
    return t

// The base integer type.
fn tyc_int() -> list
    return tyc_con("int", [])

// The base boolean type.
fn tyc_bool() -> list
    return tyc_con("bool", [])

// The list type constructor applied to element type a.
fn tyc_list(a) -> list
    let args = []
    push(args, a)
    return tyc_con("list", args)

// The pair type constructor applied to types a and b.
fn tyc_pair(a, b) -> list
    let args = []
    push(args, a)
    push(args, b)
    return tyc_con("pair", args)

// Return 1 if t is a type variable, 0 otherwise.
fn tyc_is_tvar(t) -> int
    if type_of(t) == "list"
        if len(t) >= 1
            if t[0] == "tvar"
                return 1
    return 0

// Return 1 if t is a function type, 0 otherwise.
fn tyc_is_arr(t) -> int
    if type_of(t) == "list"
        if len(t) >= 1
            if t[0] == "arr"
                return 1
    return 0

// Return 1 if t is a type constructor, 0 otherwise.
fn tyc_is_con(t) -> int
    if type_of(t) == "list"
        if len(t) >= 1
            if t[0] == "con"
                return 1
    return 0

// _tyc_val_eq: compare two scalar (non-list) values for equality.
fn _tyc_val_eq(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "int"
        if a == b
            return 1
        return 0
    if ta == "string"
        if a == b
            return 1
        return 0
    return 0

// tyc_equal: deep structural equality of two types.
fn tyc_equal(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "list"
        let na = len(a)
        let nb = len(b)
        if na != nb
            return 0
        let i = 0
        let ok = 1
        while i < na
            let ai = a[i]
            let bi = b[i]
            if type_of(ai) == "list"
                let sub = tyc_equal(ai, bi)
                if sub == 0
                    ok = 0
            else
                let veq = _tyc_val_eq(ai, bi)
                if veq == 0
                    ok = 0
            i = i + 1
        return ok
    return _tyc_val_eq(a, b)

// _tyc_ftv_aux: collect free type-variable ids into acc (a list), avoiding duplicates.
fn _tyc_ftv_aux(t, acc) -> int
    if type_of(t) != "list"
        return 0
    if len(t) < 1
        return 0
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let found = 0
        for i in 0..len(acc)
            if acc[i] == k
                found = 1
        if found == 0
            push(acc, k)
        return 0
    if tag == "arr"
        _tyc_ftv_aux(t[1], acc)
        _tyc_ftv_aux(t[2], acc)
        return 0
    if tag == "con"
        let args = t[2]
        for j in 0..len(args)
            _tyc_ftv_aux(args[j], acc)
        return 0
    return 0

// _tyc_sort_ints: bubble sort a list of ints in place (ascending).
fn _tyc_sort_ints(xs) -> int
    let n = len(xs)
    for i in 0..n
        let j = 0
        while j < n - i - 1
            if xs[j] > xs[j + 1]
                let tmp = xs[j]
                xs[j] = xs[j + 1]
                xs[j + 1] = tmp
            j = j + 1
    return 0

// tyc_ftv: sorted list of free type-variable ids in t.
fn tyc_ftv(t) -> list
    let acc = []
    _tyc_ftv_aux(t, acc)
    _tyc_sort_ints(acc)
    return acc

// tyc_size: total node count of a type (each tvar/arr/con head counts as 1, plus children).
fn tyc_size(t) -> int
    if type_of(t) != "list"
        return 0
    if len(t) < 1
        return 0
    let tag = t[0]
    if tag == "tvar"
        return 1
    if tag == "arr"
        return 1 + tyc_size(t[1]) + tyc_size(t[2])
    if tag == "con"
        let args = t[2]
        let total = 1
        for i in 0..len(args)
            total = total + tyc_size(args[i])
        return total
    return 0
