// std/numeral/base_between -- Convert a numeral string directly from one base to another (2..36).
// Digits: 0-9 then A-Z (uppercase output). Handles '0' and leading '-'.
//
// Public API:
//   bb_to_int(s, base) -> int        -- parse a base-N string to an integer
//   bb_from_int(n, base) -> string   -- render an integer as a base-N string (uppercase)
//   bb_convert(s, from_base, to_base) -> string  -- convert numeral from one base to another
//
// LEAF -- imports NOTHING.

// Private: map digit value 0..35 to its uppercase character.
fn _bb_digit_char(v: int) -> string
    let result = ""
    if v < 10
        result = chr(48 + v)
    else
        result = chr(65 + (v - 10))
    result

// Private: map a character to its digit value; returns -1 if invalid for the given base.
fn _bb_char_val(ch: string, base: int) -> int
    let code = ord(ch)
    let val = -1
    if code >= 48 and code <= 57
        let dv = code - 48
        if dv < base
            val = dv
    else if code >= 65 and code <= 90
        let dv = (code - 65) + 10
        if dv < base
            val = dv
    else if code >= 97 and code <= 122
        let dv = (code - 97) + 10
        if dv < base
            val = dv
    val

// Parse a base-N string (with optional leading '-') to an integer.
fn bb_to_int(s: string, base: int) -> int
    let slen = len(s)
    if slen == 0
        return 0
    let neg = false
    let start = 0
    if slice(s, 0, 1) == "-"
        neg = true
        start = 1
    let acc = 0
    for i in start..slen
        let ch = slice(s, i, i + 1)
        let v = _bb_char_val(ch, base)
        if v >= 0
            acc = acc * base + v
    if neg
        acc = -acc
    acc

// Render an integer as an uppercase base-N string. Returns '0' for n=0; '-' prefix for negative.
fn bb_from_int(n: int, base: int) -> string
    if n == 0
        return "0"
    let neg = false
    let cur = n
    if cur < 0
        neg = true
        cur = -cur
    let digits = ""
    while cur > 0
        let rem = cur % base
        digits = _bb_digit_char(rem) + digits
        cur /= base
    if neg
        digits = "-" + digits
    digits

// Convert a numeral string from from_base to to_base (both 2..36). Uppercase output.
fn bb_convert(s: string, from_base: int, to_base: int) -> string
    let n = bb_to_int(s, from_base)
    bb_from_int(n, to_base)
