// std/numeral/mixed_radix -- Mixed-radix positional number encoding.
// A mixed-radix number has per-position bases (radices). The leftmost (most-significant)
// field is unbounded; all other fields i have base radices[i-1] (0-indexed from left).
// The result digit list has length len(radices)+1.
//
// Example: radices=[24,60,60] represents days/hours/minutes/seconds where
//   seconds field has base 60, minutes field has base 60, hours field has base 24,
//   and days field is unbounded.
// mr_to_digits(90061,[24,60,60]) => [1,1,1,1] (1 day, 1 hour, 1 min, 1 sec).
//
// Public API:
//   mr_to_digits(n, radices)      -> list  decompose n into mixed-radix digits
//   mr_from_digits(digits, radices) -> int  reconstruct integer from digits via Horner
//
// LEAF -- imports NOTHING.

// Decompose non-negative integer n into mixed-radix digits.
// Digits list has length len(radices)+1. The rightmost field has base radices[last],
// the next has base radices[last-1], etc.; the leftmost digit is unbounded (remainder).
// Fill from the right: digit[i] = n % radices[i]; n = n / radices[i]; leftmost = n.
fn mr_to_digits(n: int, radices: list) -> list
    let rlen = len(radices)
    // Allocate result with rlen+1 slots, fill with 0.
    let result = []
    let fill = 0
    while fill <= rlen
        result.push(0)
        fill = fill + 1
    // Fill from right to left across the bounded fields.
    let cur = n
    let i = rlen - 1
    while i >= 0
        let base = radices[i]
        let digit = cur % base
        result[i + 1] = digit
        cur = cur / base
        i = i - 1
    // Leftmost (unbounded) field.
    result[0] = cur
    result

// Reconstruct an integer from mixed-radix digits using Horner's method.
// digits[0] is most-significant (unbounded); radices govern transitions.
// acc = digits[0]; then for i in 0..rlen-1: acc = acc * radices[i] + digits[i+1].
fn mr_from_digits(digits: list, radices: list) -> int
    let rlen = len(radices)
    let acc = digits[0]
    let i = 0
    while i < rlen
        acc = acc * radices[i] + digits[i + 1]
        i = i + 1
    acc
