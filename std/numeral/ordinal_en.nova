// std/numeral/ordinal_en -- English ordinal suffix and ordinal words.
// ord_suffix: appends st/nd/rd/th to any non-negative integer.
// ord_word: full ordinal in words (first, second, twenty-first, etc.).
//
// Public API:
//   ord_suffix(n: int) -> string  -- e.g. 1->'1st', 11->'11th', 21->'21st'
//   ord_word(n: int) -> string    -- e.g. 1->'first', 21->'twenty-first'
//
// LEAF -- imports NOTHING. Contains private cardinal helpers.

// ---- Private cardinal helpers (self-contained, no import) ----

fn _ord_small(n: int) -> string
    let w = ""
    if n == 1
        w = "one"
    else if n == 2
        w = "two"
    else if n == 3
        w = "three"
    else if n == 4
        w = "four"
    else if n == 5
        w = "five"
    else if n == 6
        w = "six"
    else if n == 7
        w = "seven"
    else if n == 8
        w = "eight"
    else if n == 9
        w = "nine"
    else if n == 10
        w = "ten"
    else if n == 11
        w = "eleven"
    else if n == 12
        w = "twelve"
    else if n == 13
        w = "thirteen"
    else if n == 14
        w = "fourteen"
    else if n == 15
        w = "fifteen"
    else if n == 16
        w = "sixteen"
    else if n == 17
        w = "seventeen"
    else if n == 18
        w = "eighteen"
    else if n == 19
        w = "nineteen"
    w

fn _ord_tens_word(n: int) -> string
    let w = ""
    if n == 20
        w = "twenty"
    else if n == 30
        w = "thirty"
    else if n == 40
        w = "forty"
    else if n == 50
        w = "fifty"
    else if n == 60
        w = "sixty"
    else if n == 70
        w = "seventy"
    else if n == 80
        w = "eighty"
    else if n == 90
        w = "ninety"
    w

fn _ord_cardinal_under_1000(n: int) -> string
    let w = ""
    if n <= 0
        w = ""
    else if n <= 19
        w = _ord_small(n)
    else if n <= 99
        let t = (n / 10) * 10
        let u = n % 10
        if u == 0
            w = _ord_tens_word(t)
        else
            w = _ord_tens_word(t) + "-" + _ord_small(u)
    else
        let h = n / 100
        let rem = n % 100
        w = _ord_small(h) + " hundred"
        if rem > 0
            w = w + " " + _ord_cardinal_under_1000(rem)
    w

fn _ord_cardinal(n: int) -> string
    let result = ""
    if n == 0
        result = "zero"
    else
        let billions = n / 1000000000
        let after_b = n % 1000000000
        let millions = after_b / 1000000
        let after_m = after_b % 1000000
        let thousands = after_m / 1000
        let remainder = after_m % 1000
        let parts = ""
        if billions > 0
            parts = _ord_cardinal_under_1000(billions) + " billion"
        if millions > 0
            if parts != ""
                parts = parts + " "
            parts = parts + _ord_cardinal_under_1000(millions) + " million"
        if thousands > 0
            if parts != ""
                parts = parts + " "
            parts = parts + _ord_cardinal_under_1000(thousands) + " thousand"
        if remainder > 0
            if parts != ""
                parts = parts + " "
            parts = parts + _ord_cardinal_under_1000(remainder)
        result = parts
    result

// ---- Ordinal suffix table for 1..19 last words ----

// Return the ordinal form of a single "last word" in the cardinal string.
// Handles: one->first, two->second, three->third, four->fourth, five->fifth,
// six->sixth, seven->seventh, eight->eighth, nine->ninth, ten->tenth,
// eleven->eleventh, twelve->twelfth, thirteen->thirteenth, etc.
// Tens: twenty->twentieth, thirty->thirtieth, forty->fortieth, etc.
fn _ord_last_word(w: string) -> string
    let r = ""
    if w == "one"
        r = "first"
    else if w == "two"
        r = "second"
    else if w == "three"
        r = "third"
    else if w == "four"
        r = "fourth"
    else if w == "five"
        r = "fifth"
    else if w == "six"
        r = "sixth"
    else if w == "seven"
        r = "seventh"
    else if w == "eight"
        r = "eighth"
    else if w == "nine"
        r = "ninth"
    else if w == "ten"
        r = "tenth"
    else if w == "eleven"
        r = "eleventh"
    else if w == "twelve"
        r = "twelfth"
    else if w == "thirteen"
        r = "thirteenth"
    else if w == "fourteen"
        r = "fourteenth"
    else if w == "fifteen"
        r = "fifteenth"
    else if w == "sixteen"
        r = "sixteenth"
    else if w == "seventeen"
        r = "seventeenth"
    else if w == "eighteen"
        r = "eighteenth"
    else if w == "nineteen"
        r = "nineteenth"
    else if w == "twenty"
        r = "twentieth"
    else if w == "thirty"
        r = "thirtieth"
    else if w == "forty"
        r = "fortieth"
    else if w == "fifty"
        r = "fiftieth"
    else if w == "sixty"
        r = "sixtieth"
    else if w == "seventy"
        r = "seventieth"
    else if w == "eighty"
        r = "eightieth"
    else if w == "ninety"
        r = "ninetieth"
    else if w == "hundred"
        r = "hundredth"
    else if w == "thousand"
        r = "thousandth"
    else if w == "million"
        r = "millionth"
    else if w == "billion"
        r = "billionth"
    else if w == "zero"
        r = "zeroth"
    else
        r = w + "th"
    r

// Private: find last space in a string; return index or -1.
fn _ord_last_space(s: string) -> int
    let i = len(s) - 1
    let found = -1
    while i >= 0
        if slice(s, i, i + 1) == " "
            found = i
            i = -1
        i = i - 1
    found

// Private: find last hyphen in a string; return index or -1.
fn _ord_last_hyphen(s: string) -> int
    let i = len(s) - 1
    let found = -1
    while i >= 0
        if slice(s, i, i + 1) == "-"
            found = i
            i = -1
        i = i - 1
    found

// ---- Public functions ----

// Return n with its ordinal suffix appended (e.g. 1->'1st', 11->'11th', 21->'21st').
// Rule: if (n%100) in 11..13 use 'th'; else last digit 1->'st', 2->'nd', 3->'rd', else 'th'.
fn ord_suffix(n: int) -> string
    let s = ""
    let rem100 = n % 100
    let rem10 = n % 10
    if rem100 >= 11 and rem100 <= 13
        s = str(n) + "th"
    else if rem10 == 1
        s = str(n) + "st"
    else if rem10 == 2
        s = str(n) + "nd"
    else if rem10 == 3
        s = str(n) + "rd"
    else
        s = str(n) + "th"
    s

// Return n as ordinal words (e.g. 1->'first', 21->'twenty-first', 11->'eleventh').
// Strategy: build the cardinal string, then transform only the LAST word token.
fn ord_word(n: int) -> string
    let card = _ord_cardinal(n)
    // Find the last separator: hyphen takes priority over space
    // (e.g. "twenty-one" -> transform "one" to "first" -> "twenty-first")
    let hpos = _ord_last_hyphen(card)
    let spos = _ord_last_space(card)
    let result = ""
    if hpos > spos and hpos >= 0
        // last token is after a hyphen
        let prefix = slice(card, 0, hpos + 1)
        let last = slice(card, hpos + 1, len(card))
        result = prefix + _ord_last_word(last)
    else if spos >= 0
        // last token is after a space
        let prefix = slice(card, 0, spos + 1)
        let last = slice(card, spos + 1, len(card))
        result = prefix + _ord_last_word(last)
    else
        // entire string is the last word (e.g. "seven", "zero")
        result = _ord_last_word(card)
    result
