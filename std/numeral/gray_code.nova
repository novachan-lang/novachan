// std/numeral/gray_code -- Reflected binary Gray code (RBGC) utilities.
// Each successive code differs from the previous by exactly one bit.
// All functions operate on non-negative integers.
//
// Public API:
//   gc_to_gray(n)           -> int    encode binary n to its Gray code
//   gc_from_gray(g)         -> int    decode Gray code g back to binary n
//   gc_to_gray_bits(n, w)   -> string binary string of Gray code, zero-padded to width w
//   gc_gray_sequence(bits)  -> list   Gray codes 0..(2^bits-1) in counting order
//
// LEAF -- imports NOTHING.

// Encode binary integer n to its reflected binary Gray code.
// Formula: n XOR (n >> 1).
fn gc_to_gray(n: int) -> int
    n ^ (n >> 1)

// Decode a Gray code g back to the original binary integer.
// Algorithm: fold XOR cascade; each iteration halves the remaining uncertainty.
fn gc_from_gray(g: int) -> int
    let n = g
    let s = g >> 1
    while s > 0
        n = n ^ s
        s = s >> 1
    n

// Return the binary string of gc_to_gray(n), zero-padded on the left to width w.
// Each character is '0' or '1'. If the natural representation exceeds w digits,
// no truncation occurs (the full representation is returned).
fn gc_to_gray_bits(n: int, w: int) -> string
    let g = gc_to_gray(n)
    let bits = ""
    let cur = g
    if cur == 0
        bits = "0"
    else
        while cur > 0
            let bit = cur % 2
            if bit == 0
                bits = "0" + bits
            else
                bits = "1" + bits
            cur = cur / 2
    // Zero-pad on the left to at least width w.
    let pad = w - len(bits)
    let result = ""
    for p in 0..pad
        result += "0"
    result += bits
    result

// Return a list of the 2^bits Gray codes in counting order (index 0..2^bits-1).
// Consecutive entries differ by exactly one bit (the defining property of RBGC).
fn gc_gray_sequence(bits: int) -> list
    let size = 1 << bits
    let result = []
    for i in 0..size
        result.push(gc_to_gray(i))
    result
