// std/numeral/balanced_ternary -- Balanced ternary encoding/decoding.
// Digits: T (=-1), 0, 1. Representations are most-significant-digit first.
// Every integer (positive, zero, negative) has a unique balanced ternary representation.
//
// Public API:
//   bt_encode(n: int) -> string  -- encode n to balanced ternary string over {T,0,1}
//   bt_decode(s: string) -> int  -- decode balanced ternary string to integer
//
// LEAF -- imports NOTHING.

// Encode integer n to its balanced ternary string representation.
// Uses the standard digit-by-digit algorithm with carry adjustment:
//   remainder r = n % 3 (truncating division); if r==2 set r=-1 and add 1 carry to quotient;
//   if r==-2 set r=1 and subtract 1 carry; map -1->'T', 0->'0', 1->'1'; prepend digit.
fn bt_encode(n: int) -> string
    if n == 0
        return "0"
    let result = ""
    let cur = n
    while cur != 0
        let r = cur % 3
        cur /= 3
        if r == 2
            r = -1
            cur += 1
        else if r == -2
            r = 1
            cur -= 1
        let digit = "0"
        if r == -1
            digit = "T"
        else if r == 1
            digit = "1"
        result = digit + result
    result

// Decode a balanced ternary string (over alphabet {T, 0, 1}) to an integer.
// 'T' represents the digit -1; '0' represents 0; '1' represents 1.
// The string is read most-significant-digit first.
fn bt_decode(s: string) -> int
    let acc = 0
    let i = 0
    let slen = len(s)
    while i < slen
        let ch = slice(s, i, i + 1)
        let d = 0
        if ch == "T"
            d = -1
        else if ch == "1"
            d = 1
        acc = acc * 3 + d
        i += 1
    acc
