// std/numeral/bijective26 -- Bijective base-26 encoding (spreadsheet column names).
// Digits A=1..Z=26 (NO zero digit). Column 1='A', 26='Z', 27='AA', 702='ZZ', 703='AAA'.
//
// Public API:
//   bj_to_col(n: int) -> string  -- encode n>=1 to column string e.g. 1->'A', 27->'AA'
//   bj_from_col(s: string) -> int -- decode column string to integer
//   bj_is_valid(s: string) -> bool -- true iff s is non-empty and all chars A-Z
//
// LEAF -- imports NOTHING.

// Reverse a string helper (private).
fn _bj_reverse(s: string) -> string
    let r_parts = []
    let i = len(s) - 1
    while i >= 0
        push(r_parts, slice(s, i, i + 1))
        i -= 1
    let r = join(r_parts, "")
    r

// Encode n (>=1) to bijective base-26 column string.
// Algorithm: n=n-1; r=n%26; prepend chr(65+r); n=n/26; repeat while n>0.
fn bj_to_col(n: int) -> string
    let result = ""
    let cur = n
    while cur > 0
        cur -= 1
        let r = cur % 26
        result = chr(65 + r) + result
        cur /= 26
    result

// Decode a column string (e.g. 'AA') to its integer value.
// Each char contributes: acc = acc*26 + (ord(ch)-64).
fn bj_from_col(s: string) -> int
    let acc = 0
    let i = 0
    let slen = len(s)
    while i < slen
        let ch = slice(s, i, i + 1)
        acc *= 26 + (ord(ch) - 64)
        i += 1
    acc

// Return true iff s is non-empty and every character is A-Z.
fn bj_is_valid(s: string) -> bool
    let slen = len(s)
    if slen == 0
        return false
    let ok = true
    for i in 0..slen
        let ch = slice(s, i, i + 1)
        let code = ord(ch)
        if code < 65 or code > 90
            ok = false
    ok
