// std/numeral/factoradic -- Factorial number system and Lehmer-code permutation indexing.
// Converts integers to/from their factoradic representation (digit at place i ranges 0..i,
// place value = i!). Also provides O(n^2) rank/unrank for permutations of [0..size-1].
//
// Public API:
//   fac_to_factoradic(n) -> list        -- encode n as factoradic digits high-to-low
//   fac_from_factoradic(digits) -> int  -- decode factoradic digit list to integer
//   fac_to_permutation(index, size) -> list  -- lexicographic index-th perm of [0..size-1]
//   fac_permutation_rank(perm) -> int   -- lexicographic rank of a permutation of [0..n-1]
//
// LEAF -- imports NOTHING.

// Private: compute n! for n >= 0.
fn _fac_fact(n: int) -> int
    let f = 1
    let i = 2
    while i <= n
        f = f * i
        i = i + 1
    f

// Encode a non-negative integer n as its factoradic digit list, most-significant digit first.
// The rightmost digit (place 1!) is always 0. fac_to_factoradic(0) = [0].
// Algorithm: collect remainders by dividing successively by 1, 2, 3, ... until quotient = 0,
// then reverse; this naturally produces the factoradic representation.
fn fac_to_factoradic(n: int) -> list
    if n == 0
        let z = []
        push(z, 0)
        return z
    let digits = []
    let cur = n
    let divisor = 1
    while cur > 0
        push(digits, cur % divisor)
        cur = cur / divisor
        divisor = divisor + 1
    // digits are in low-to-high order; reverse to get high-to-low
    let result = []
    let i = len(digits) - 1
    while i >= 0
        push(result, digits[i])
        i = i - 1
    result

// Decode a factoradic digit list (most-significant first) to an integer.
// fac_from_factoradic([3,4,1,0,1,0]) = 463.
fn fac_from_factoradic(digits: list) -> int
    let length = len(digits)
    let out = 0
    for j in 0..length
        // digit at position j from the left has place value (length-1-j)!
        out = out + digits[j] * _fac_fact(length - 1 - j)
    out

// Return the index-th permutation (0-indexed, lexicographic order) of [0, 1, ..., size-1].
// Uses the Lehmer code: at each step, pick the (rem / (size-1-step)!)-th remaining element.
fn fac_to_permutation(index: int, size: int) -> list
    let elems = [e for e in 0..size]
    let result = []
    let rem = index
    let i = size - 1
    while i >= 0
        let f = _fac_fact(i)
        let idx = rem / f
        rem = rem % f
        push(result, elems[idx])
        // remove elems[idx] by shifting remaining elements left, then pop last
        let s = idx
        while s < len(elems) - 1
            elems[s] = elems[s + 1]
            s = s + 1
        pop(elems)
        i = i - 1
    result

// Compute the lexicographic rank (0-indexed) of a permutation of [0..n-1].
// For each position, count how many elements to the right are smaller (Lehmer code),
// then sum digit * (n-1-position)!.
fn fac_permutation_rank(perm: list) -> int
    let n = len(perm)
    let rank = 0
    for i in 0..n
        let smaller = 0
        let j = i + 1
        while j < n
            if perm[j] < perm[i]
                smaller = smaller + 1
            j = j + 1
        rank = rank + smaller * _fac_fact(n - 1 - i)
    rank
