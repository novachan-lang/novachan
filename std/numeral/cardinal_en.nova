// std/numeral/cardinal_en -- English cardinal word representation of integers.
// Handles 0, negative, and non-negative integers up to 999,999,999,999 (billions).
// No "and" connector; hyphenates compound tens (forty-two).
//
// Public API:
//   car_cardinal(n: int) -> string  -- e.g. 1234 -> 'one thousand two hundred thirty-four'
//
// LEAF -- imports NOTHING.

// Private: word for 1..19.
fn _car_small(n: int) -> string
    let w = ""
    if n == 1
        w = "one"
    else if n == 2
        w = "two"
    else if n == 3
        w = "three"
    else if n == 4
        w = "four"
    else if n == 5
        w = "five"
    else if n == 6
        w = "six"
    else if n == 7
        w = "seven"
    else if n == 8
        w = "eight"
    else if n == 9
        w = "nine"
    else if n == 10
        w = "ten"
    else if n == 11
        w = "eleven"
    else if n == 12
        w = "twelve"
    else if n == 13
        w = "thirteen"
    else if n == 14
        w = "fourteen"
    else if n == 15
        w = "fifteen"
    else if n == 16
        w = "sixteen"
    else if n == 17
        w = "seventeen"
    else if n == 18
        w = "eighteen"
    else if n == 19
        w = "nineteen"
    w

// Private: word for tens 20,30..90.
fn _car_tens(n: int) -> string
    let w = ""
    if n == 20
        w = "twenty"
    else if n == 30
        w = "thirty"
    else if n == 40
        w = "forty"
    else if n == 50
        w = "fifty"
    else if n == 60
        w = "sixty"
    else if n == 70
        w = "seventy"
    else if n == 80
        w = "eighty"
    else if n == 90
        w = "ninety"
    w

// Private: convert 1..999 to words.
fn car_cardinal_under_1000(n: int) -> string
    let w = ""
    if n <= 0
        w = ""
    else if n <= 19
        w = _car_small(n)
    else if n <= 99
        let t = (n / 10) * 10
        let u = n % 10
        if u == 0
            w = _car_tens(t)
        else
            w = _car_tens(t) + "-" + _car_small(u)
    else
        let h = n / 100
        let rem = n % 100
        w = _car_small(h) + " hundred"
        if rem > 0
            w += " " + car_cardinal_under_1000(rem)
    w

// Convert any integer to English cardinal words.
// Supports 0, negative, and values up to 999,999,999,999.
fn car_cardinal(n: int) -> string
    let result = ""
    if n < 0
        result = "negative " + car_cardinal(0 - n)
    else if n == 0
        result = "zero"
    else
        // Split into billions, millions, thousands, remainder
        let billions = n / 1000000000
        let after_b = n % 1000000000
        let millions = after_b / 1000000
        let after_m = after_b % 1000000
        let thousands = after_m / 1000
        let remainder = after_m % 1000

        let parts = ""
        if billions > 0
            parts = car_cardinal_under_1000(billions) + " billion"
        if millions > 0
            if parts != ""
                parts += " "
            parts += car_cardinal_under_1000(millions) + " million"
        if thousands > 0
            if parts != ""
                parts += " "
            parts += car_cardinal_under_1000(thousands) + " thousand"
        if remainder > 0
            if parts != ""
                parts += " "
            parts += car_cardinal_under_1000(remainder)
        result = parts
    result
