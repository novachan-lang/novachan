// std/numeral/tally -- Tally mark encoding (ASCII convention).
// Groups of up to 5 pipe characters '|', separated by a single space.
// Each complete group is '|||||'; the final partial group has 1..4 '|' chars.
// Example: 7 -> '||||| ||'  (one group of 5, one partial group of 2).
// Example: 0 -> '' (empty string).
//
// Public API:
//   tl_to_tally(n)        -> string  encode n >= 0 to tally string
//   tl_from_tally(s)      -> int     count '|' characters in tally string
//   tl_group_count(n)     -> int     number of complete groups of 5 in n
//   tl_remainder(n)       -> int     n mod 5 (partial group size)
//
// LEAF -- imports NOTHING.

// Encode non-negative integer n to its ASCII tally-mark representation.
// 0 encodes to the empty string. Groups are separated by a single space.
fn tl_to_tally(n: int) -> string
    if n == 0
        return ""
    let full = n / 5
    let rem = n % 5
    let result = ""
    for i in 0..full
        if i > 0
            result += " "
        result += "|||||"
    if rem > 0
        if full > 0
            result += " "
        for j in 0..rem
            result += "|"
    result

// Count the number of '|' characters in a tally string s.
// Spaces and any other characters are ignored.
fn tl_from_tally(s: string) -> int
    let count = 0
    let i = 0
    let slen = len(s)
    while i < slen
        let ch = slice(s, i, i + 1)
        if ch == "|"
            count += 1
        i += 1
    count

// Return the number of complete groups of 5 in n (floor(n/5)).
fn tl_group_count(n: int) -> int
    n / 5

// Return the size of the partial (remainder) group: n mod 5.
fn tl_remainder(n: int) -> int
    n % 5
