// std/numeral/negabinary -- Base -2 (negabinary) encoding/decoding.
// Digits are 0 and 1 only. Every integer (positive, zero, negative) has a unique
// negabinary representation. Output string is most-significant-digit first.
//
// Public API:
//   nb_encode(n: int) -> string  -- encode n to negabinary string over {0,1}
//   nb_decode(s: string) -> int  -- decode negabinary string to integer
//
// LEAF -- imports NOTHING.

// Encode integer n to its base -2 (negabinary) string representation.
// Algorithm: at each step compute quotient q = n / (-2) and remainder rem = n - q*(-2);
//   if rem < 0, adjust: rem = rem + 2, q = q + 1. Prepend str(rem). Repeat with n=q.
//   The remainder is always 0 or 1 after adjustment.
fn nb_encode(n: int) -> string
    if n == 0
        return "0"
    let result = ""
    let cur = n
    while cur != 0
        let q = cur / (0 - 2)
        let rem = cur - q * (0 - 2)
        if rem < 0
            rem = rem + 2
            q = q + 1
        result = str(rem) + result
        cur = q
    result

// Decode a negabinary string (digits '0' and '1', most-significant first) to an integer.
// Position i from the right has place value (-2)^i.
// Read left-to-right: accumulate acc = acc * (-2) + digit.
fn nb_decode(s: string) -> int
    let acc = 0
    let i = 0
    let slen = len(s)
    while i < slen
        let ch = slice(s, i, i + 1)
        let d = ord(ch) - 48
        acc = acc * (0 - 2) + d
        i = i + 1
    acc
