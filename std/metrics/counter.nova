// std/metrics/counter.nova — a minimal application metrics registry:
// counters (monotonic-by-convention int accumulators), gauges (last-value
// int/float readings) and histograms (recorded value lists, count only —
// no bucketing).
//
// Representation: a registry is a dict with three entries:
//   "counters"   -> dict name -> int    running total
//   "gauges"     -> dict name -> value  last-set value
//   "histograms" -> dict name -> list   every recorded value, in order
//
// Reading a metric that was never created returns a safe default (0 / 0.0)
// rather than erroring, so callers don't need to pre-check existence.
//
// Public API (prefix mc_):
//   mc_registry_new()                      -> dict
//   mc_counter_new(registry, name)
//   mc_counter_inc(registry, name)
//   mc_counter_add(registry, name, val)
//   mc_counter_get(registry, name)         -> int
//   mc_gauge_new(registry, name, val)
//   mc_gauge_set(registry, name, val)
//   mc_gauge_get(registry, name)           -> float
//   mc_histogram_record(registry, name, val)
//   mc_histogram_count(registry, name)     -> int
//   mc_report(registry)                    -> string
//
// LEAF — imports nothing.

// mc_registry_new: create an empty metrics registry.
fn mc_registry_new() -> dict
    let r = {}
    r["counters"] = {}
    r["gauges"] = {}
    r["histograms"] = {}
    return r

// mc_counter_new: create (or reset) a counter to 0.
fn mc_counter_new(registry, name)
    let c = registry["counters"]
    c[name] = 0
    registry["counters"] = c

// mc_counter_add: add val to a counter. Auto-creates the counter at val if
// it did not exist yet (so mc_counter_new is optional, not required).
fn mc_counter_add(registry, name, val)
    let c = registry["counters"]
    if contains(c, name)
        c[name] = c[name] + val
    else
        c[name] = val
    registry["counters"] = c

// mc_counter_inc: shorthand for mc_counter_add(registry, name, 1).
fn mc_counter_inc(registry, name)
    mc_counter_add(registry, name, 1)

// mc_counter_get: current value, or 0 if the counter does not exist.
fn mc_counter_get(registry, name) -> int
    let c = registry["counters"]
    if contains(c, name)
        return c[name]
    return 0

// mc_gauge_new: create a gauge with an initial value.
fn mc_gauge_new(registry, name, val)
    let g = registry["gauges"]
    g[name] = val
    registry["gauges"] = g

// mc_gauge_set: overwrite a gauge's value (auto-creates if missing).
fn mc_gauge_set(registry, name, val)
    let g = registry["gauges"]
    g[name] = val
    registry["gauges"] = g

// mc_gauge_get: current value as a float, or 0.0 if the gauge does not exist.
fn mc_gauge_get(registry, name) -> float
    let g = registry["gauges"]
    if contains(g, name)
        return g[name] * 1.0
    return 0.0

// mc_histogram_record: append a recorded value (auto-creates the histogram).
fn mc_histogram_record(registry, name, val)
    let h = registry["histograms"]
    if contains(h, name)
        let lst = h[name]
        push(lst, val)
        h[name] = lst
    else
        let fresh = []
        push(fresh, val)
        h[name] = fresh
    registry["histograms"] = h

// mc_histogram_count: number of values recorded, or 0 if the histogram
// does not exist.
fn mc_histogram_count(registry, name) -> int
    let h = registry["histograms"]
    if contains(h, name)
        return len(h[name])
    return 0

// mc_report: a deterministic multi-line summary of every metric currently
// in the registry (counters, then gauges, then histograms; each section in
// dict key order). Counter/gauge/histogram sections are omitted if empty.
fn mc_report(registry) -> string
    let lines = []
    let c = registry["counters"]
    let cks = keys(c)
    let i = 0
    while i < len(cks)
        let k = cks[i]
        push(lines, "counter " + k + "=" + str(c[k]))
        i = i + 1
    let g = registry["gauges"]
    let gks = keys(g)
    i = 0
    while i < len(gks)
        let k = gks[i]
        push(lines, "gauge " + k + "=" + str(g[k]))
        i = i + 1
    let h = registry["histograms"]
    let hks = keys(h)
    i = 0
    while i < len(hks)
        let k = hks[i]
        let cnt = len(h[k])
        push(lines, "histogram " + k + " count=" + str(cnt))
        i = i + 1
    return join(lines, "\n")
