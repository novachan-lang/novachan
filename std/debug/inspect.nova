// ============================================================================
// NOVA Standard Library — std/debug/inspect
// ============================================================================
// Value inspection utilities: type-name lookup, truthiness, nested-size
// estimation, short summaries, and a generic three-way comparator. Pure
// functions of a single `any` value (or two, for di_compare) — no mutable
// state, no I/O.
//
// KNOWN NOVA REPRESENTATION LIMIT (see std/core/validate.nova's v_required
// for the original finding): NOVA's `any` representation gives an int 0, a
// bool false, and a null value the IDENTICAL raw bit pattern with no
// distinguishing runtime tag — type_of(v) reports "int" for all three when
// v arrives through a dynamically-typed `any` slot (a genuinely boxed value
// read back out of a list/dict CAN carry a real "float"/"bool"/"null" tag;
// a raw scalar cannot). di_is_truthy embraces this deliberately: null, 0,
// and false all collapse to "falsy", which is the semantically correct
// answer for a truthiness check. di_type_name and di_summarize do NOT try
// to paper over the ambiguity — they report whatever type_of(v) says,
// honestly, rather than guessing "null" for what might really be int 0.
//
// Public API (prefix di_):
//   di_type_name(v)      -> string   type_of(v), as a named convenience
//   di_is_truthy(v)      -> int      1/0; null/0/false/""/[]/{} are falsy
//   di_deep_size(v)       -> int      1 for a scalar; for list/dict, 1 plus
//                                    the deep_size of every element/value
//                                    (so nesting is counted, not just length)
//   di_summarize(v)       -> string   short human-readable summary
//   di_compare(a, b)      -> int      -1/0/1 three-way comparison
//
// LEAF — imports NOTHING.
// ============================================================================

// ── private: lexicographic string comparison ─────────────────────────────────
// Compares byte-by-byte via ord(char_at(...)) (the codebase's established
// idiom for string ordering — see std/text/naturalsort.nova — since NOVA's
// `<`/`>` operators are not used directly on string values here). A common
// prefix is broken by length: the shorter string sorts first.
fn _di_str_cmp(a: string, b: string) -> int
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n
        n = nb
    let i = 0
    while i < n
        let ca = ord(char_at(a, i))
        let cb = ord(char_at(b, i))
        if ca < cb
            return -1
        if ca > cb
            return 1
        i = i + 1
    if na < nb
        return -1
    if na > nb
        return 1
    return 0

// ── di_type_name ──────────────────────────────────────────────────────────────
// Returns the runtime type name of v, exactly as type_of(v) reports it
// ("int", "float", "string", "list", "dict", "bytes", "struct", ...).
fn di_type_name(v: any) -> string
    return type_of(v)

// ── di_is_truthy ──────────────────────────────────────────────────────────────
// Returns 1 if v is truthy, 0 if falsy. Falsy: null, int 0, bool false,
// float 0.0, "" (empty string), [] (empty list), {} (empty dict), and an
// empty bytes value. Everything else (including any non-zero number and any
// non-empty container) is truthy.
fn di_is_truthy(v: any) -> int
    if v == null
        return 0
    let t = type_of(v)
    if t == "string" or t == "list" or t == "dict"
        if len(v) == 0
            return 0
        return 1
    if t == "float"
        if v == 0.0
            return 0
        return 1
    if t == "bool"
        if v
            return 1
        return 0
    if t == "bytes"
        if bytes_len(v) == 0
            return 0
        return 1
    return 1

// ── di_deep_size ──────────────────────────────────────────────────────────────
// Returns a nested-size estimate: 1 for any scalar; for a list or dict,
// 1 (for the container itself) plus the recursive di_deep_size of every
// element (list) or value (dict). This counts total nested nodes, not just
// top-level length, so [[1,2],[3]] (2 elements, 3 leaves) reports more than
// a flat 3-element list.
fn di_deep_size(v: any) -> int
    let t = type_of(v)
    if t == "list"
        let n = len(v)
        let total = 1
        let i = 0
        while i < n
            total = total + di_deep_size(v[i])
            i = i + 1
        return total
    if t == "dict"
        let vs = values(v)
        let n = len(vs)
        let total = 1
        let i = 0
        while i < n
            total = total + di_deep_size(vs[i])
            i = i + 1
        return total
    return 1

// ── di_summarize ──────────────────────────────────────────────────────────────
// Returns a short, human-readable one-line summary of v:
//   int    -> "int:<value>"
//   float  -> "float:<value>"
//   bool   -> "bool:<value>"
//   string -> "string(<len>):<value>"        (value truncated to 40 chars,
//                                              with a trailing "..." marker,
//                                              when longer than 40)
//   list   -> "list[<len>]"
//   dict   -> "dict{<len>}"
//   bytes  -> "bytes(<len>)"
//   anything else -> "<type>:<str(v)>"
fn di_summarize(v: any) -> string
    let t = type_of(v)
    if t == "int"
        return "int:" + str(v)
    if t == "float"
        return "float:" + str(v)
    if t == "bool"
        return "bool:" + str(v)
    if t == "string"
        let n = len(v)
        if n > 40
            return "string(" + str(n) + "):" + slice(v, 0, 40) + "..."
        return "string(" + str(n) + "):" + v
    if t == "list"
        return "list[" + str(len(v)) + "]"
    if t == "dict"
        // NOTE: '{'/'}' INTERPOLATE inside a NOVA string literal — a literal
        // "dict{" would try to open an interpolation span. Use chr(123)/
        // chr(125) instead (same idiom as std/testing/snapshot.nova).
        let ob = chr(123)
        let cb = chr(125)
        return "dict" + ob + str(len(keys(v))) + cb
    if t == "bytes"
        return "bytes(" + str(bytes_len(v)) + ")"
    return t + ":" + str(v)

// ── di_compare ────────────────────────────────────────────────────────────────
// Three-way comparison: returns -1 if a < b, 0 if a == b, 1 if a > b.
//   - If both a and b are numeric (int or float, in any combination), they
//     are compared numerically. Mixed int/float is coerced to float via
//     `*1.0` before comparing (NOVA's `<`/`>` are unsound on a raw int-vs-
//     float pair — see reference_nova_float_int_compare_unsound).
//   - If both are strings, they are compared lexicographically
//     (via _di_str_cmp).
//   - Otherwise (mismatched or non-numeric/non-string types), falls back to
//     comparing str(a) vs str(b) lexicographically — deterministic and never
//     crashes, though not a "true" ordering for arbitrary types.
fn di_compare(a: any, b: any) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    let a_num = ta == "int" or ta == "float"
    let b_num = tb == "int" or tb == "float"
    if a_num and b_num
        let af = a * 1.0
        let bf = b * 1.0
        if af < bf
            return -1
        if af > bf
            return 1
        return 0
    if ta == "string" and tb == "string"
        return _di_str_cmp(a, b)
    return _di_str_cmp(str(a), str(b))
