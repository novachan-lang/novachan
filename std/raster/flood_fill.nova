// std/raster/flood_fill — flood fill algorithms on an integer SURFACE.
//
// SURFACE = dict with "w" (int width), "h" (int height),
//           "px" (flat list of ints, row-major, length w*h).
// Pixel (x,y) lives at px[y*w + x].
//
// Iterative (stack-based) flood fills to avoid recursion-depth limits.
//
// Public API:
//   ff_new(w, h, fill)             -> dict  fresh surface filled with `fill`
//   ff_get(s, x, y)                -> int   pixel value at (x,y)
//   ff_set(s, x, y, v)                      mutate pixel at (x,y)
//   ff_fill4(s, x, y, newval)      -> any   4-connected flood fill; returns s
//   ff_fill8(s, x, y, newval)      -> any   8-connected flood fill; returns s
//   ff_count_region(s, x, y)       -> int   size (pixels) of connected 4-region
//   ff_boundary_fill(s,x,y,newval,boundary) -> any  fill until boundary value
//   ff_flood_bounded(s,x,y,newval) -> int   fill4 + return count of filled pixels

// ff_new — allocate a w x h surface with every pixel set to `fill`.
fn ff_new(w: int, h: int, fill: int) -> dict
    let px = []
    let total = w * h
    let i = 0
    while i < total
        push(px, fill)
        i = i + 1
    let s = {}
    s["w"] = w
    s["h"] = h
    s["px"] = px
    s

// ff_in_bounds — true iff (x,y) is inside the surface.
fn _ff_in_bounds(s: dict, x: int, y: int) -> bool
    let w = s["w"]
    let h = s["h"]
    let result = false
    if x >= 0 and y >= 0 and x < w and y < h
        result = true
    result

// ff_get — read pixel value at (x,y). Returns 0 if out-of-bounds.
fn ff_get(s: dict, x: int, y: int) -> int
    let result = 0
    if _ff_in_bounds(s, x, y)
        let w = s["w"]
        let px = s["px"]
        let idx = y * w + x
        result = px[idx]
    result

// ff_set — write pixel value v at (x,y). No-op if out-of-bounds.
fn ff_set(s: dict, x: int, y: int, v: int)
    if _ff_in_bounds(s, x, y)
        let w = s["w"]
        let px = s["px"]
        let idx = y * w + x
        px[idx] = v

// _ff_make_key — encode (x,y) as a single int for visited tracking.
fn _ff_make_key(w: int, x: int, y: int) -> int
    y * w + x

// ff_fill4 — iterative 4-connected flood fill replacing seed value with newval.
// Returns the modified surface (same dict, mutated in place).
fn ff_fill4(s: dict, x: int, y: int, newval: int) -> any
    let w = s["w"]
    let h = s["h"]
    let oldval = ff_get(s, x, y)
    if oldval == newval
        return s
    if not _ff_in_bounds(s, x, y)
        return s
    // stack holds interleaved sx,sy pairs as a flat list
    let stack = []
    push(stack, x)
    push(stack, y)
    while len(stack) > 0
        let n = len(stack)
        let cy = stack[n - 1]
        let cx = stack[n - 2]
        // pop
        let newlen = n - 2
        let trimmed = []
        let ti = 0
        while ti < newlen
            push(trimmed, stack[ti])
            ti = ti + 1
        stack = trimmed
        if _ff_in_bounds(s, cx, cy)
            if ff_get(s, cx, cy) == oldval
                ff_set(s, cx, cy, newval)
                push(stack, cx)
                push(stack, cy - 1)
                push(stack, cx)
                push(stack, cy + 1)
                push(stack, cx - 1)
                push(stack, cy)
                push(stack, cx + 1)
                push(stack, cy)
    s

// ff_fill8 — iterative 8-connected flood fill replacing seed value with newval.
// Returns the modified surface.
fn ff_fill8(s: dict, x: int, y: int, newval: int) -> any
    let w = s["w"]
    let h = s["h"]
    let oldval = ff_get(s, x, y)
    if oldval == newval
        return s
    if not _ff_in_bounds(s, x, y)
        return s
    let stack = []
    push(stack, x)
    push(stack, y)
    while len(stack) > 0
        let n = len(stack)
        let cy = stack[n - 1]
        let cx = stack[n - 2]
        let newlen = n - 2
        let trimmed = []
        let ti = 0
        while ti < newlen
            push(trimmed, stack[ti])
            ti = ti + 1
        stack = trimmed
        if _ff_in_bounds(s, cx, cy)
            if ff_get(s, cx, cy) == oldval
                ff_set(s, cx, cy, newval)
                // 8 neighbours
                push(stack, cx - 1)
                push(stack, cy - 1)
                push(stack, cx)
                push(stack, cy - 1)
                push(stack, cx + 1)
                push(stack, cy - 1)
                push(stack, cx - 1)
                push(stack, cy)
                push(stack, cx + 1)
                push(stack, cy)
                push(stack, cx - 1)
                push(stack, cy + 1)
                push(stack, cx)
                push(stack, cy + 1)
                push(stack, cx + 1)
                push(stack, cy + 1)
    s

// ff_count_region — count pixels in the 4-connected same-value region at (x,y).
fn ff_count_region(s: dict, x: int, y: int) -> int
    if not _ff_in_bounds(s, x, y)
        return 0
    let w = s["w"]
    let h = s["h"]
    let seedval = ff_get(s, x, y)
    // visited: dict keyed by encoded index -> 1
    let visited = {}
    let count = 0
    let stack = []
    push(stack, x)
    push(stack, y)
    while len(stack) > 0
        let n = len(stack)
        let cy = stack[n - 1]
        let cx = stack[n - 2]
        let newlen = n - 2
        let trimmed = []
        let ti = 0
        while ti < newlen
            push(trimmed, stack[ti])
            ti = ti + 1
        stack = trimmed
        if _ff_in_bounds(s, cx, cy)
            let key = _ff_make_key(w, cx, cy)
            let keystr = str(key)
            if not contains(visited, keystr)
                if ff_get(s, cx, cy) == seedval
                    visited[keystr] = 1
                    count = count + 1
                    push(stack, cx)
                    push(stack, cy - 1)
                    push(stack, cx)
                    push(stack, cy + 1)
                    push(stack, cx - 1)
                    push(stack, cy)
                    push(stack, cx + 1)
                    push(stack, cy)
    count

// ff_boundary_fill — fill connected region until pixels with value `boundary` are hit.
// Replaces non-boundary pixels with newval. Returns the modified surface.
fn ff_boundary_fill(s: dict, x: int, y: int, newval: int, boundary: int) -> any
    if not _ff_in_bounds(s, x, y)
        return s
    let seedval = ff_get(s, x, y)
    if seedval == boundary
        return s
    if seedval == newval
        return s
    let stack = []
    push(stack, x)
    push(stack, y)
    while len(stack) > 0
        let n = len(stack)
        let cy = stack[n - 1]
        let cx = stack[n - 2]
        let newlen = n - 2
        let trimmed = []
        let ti = 0
        while ti < newlen
            push(trimmed, stack[ti])
            ti = ti + 1
        stack = trimmed
        if _ff_in_bounds(s, cx, cy)
            let pv = ff_get(s, cx, cy)
            if pv != boundary and pv != newval
                ff_set(s, cx, cy, newval)
                push(stack, cx)
                push(stack, cy - 1)
                push(stack, cx)
                push(stack, cy + 1)
                push(stack, cx - 1)
                push(stack, cy)
                push(stack, cx + 1)
                push(stack, cy)
    s

// ff_flood_bounded — 4-connected fill replacing seed value; returns count of filled pixels.
fn ff_flood_bounded(s: dict, x: int, y: int, newval: int) -> int
    if not _ff_in_bounds(s, x, y)
        return 0
    let oldval = ff_get(s, x, y)
    if oldval == newval
        return 0
    let w = s["w"]
    let count = 0
    let stack = []
    push(stack, x)
    push(stack, y)
    while len(stack) > 0
        let n = len(stack)
        let cy = stack[n - 1]
        let cx = stack[n - 2]
        let newlen = n - 2
        let trimmed = []
        let ti = 0
        while ti < newlen
            push(trimmed, stack[ti])
            ti = ti + 1
        stack = trimmed
        if _ff_in_bounds(s, cx, cy)
            if ff_get(s, cx, cy) == oldval
                ff_set(s, cx, cy, newval)
                count = count + 1
                push(stack, cx)
                push(stack, cy - 1)
                push(stack, cx)
                push(stack, cy + 1)
                push(stack, cx - 1)
                push(stack, cy)
                push(stack, cx + 1)
                push(stack, cy)
    count
