// std/raster/bezier_raster.nova
// Bezier curve rasterization via rational integer de Casteljau sampling.
// All arithmetic is integer (multiply by steps, then divide). No floats.
// Point lists: each element is a 2-element [x,y] list.
// Private helpers use _bz_ prefix.

// --- Integer arithmetic helpers ---

// _bz_abs: absolute value of integer.
fn _bz_abs(v)
    let r = v
    if v < 0
        r = 0 - v
    r

// _bz_isqrt: integer square root (floor) via Newton's method.
// Used only for bz_line_length_estimate.
fn _bz_isqrt(n)
    if n <= 0
        return 0
    if n == 1
        return 1
    let x = n / 2 + 1
    let x1 = (x + n / x) / 2
    let done = false
    while not done
        if x1 >= x
            done = true
        else
            x = x1
            x1 = (x + n / x) / 2
    x

// --- Public API ---

// bz_point_quad: evaluate quadratic Bezier at t = t_num/t_den (integer-rounded).
// B(t) = (1-t)^2*P0 + 2t(1-t)*P1 + t^2*P2
// Using integer arithmetic: multiply by t_den^2, then divide.
fn bz_point_quad(x0, y0, x1, y1, x2, y2, t_num, t_den)
    // t = t_num / t_den
    // (1-t) = (t_den - t_num) / t_den
    // B_x * t_den^2 = (t_den-t_num)^2 * x0 + 2*t_num*(t_den-t_num)*x1 + t_num^2*x2
    let a = t_den - t_num
    let densq = t_den * t_den
    let w0 = a * a
    let w1 = 2 * t_num * a
    let w2 = t_num * t_num
    let bx_scaled = w0 * x0 + w1 * x1 + w2 * x2
    let by_scaled = w0 * y0 + w1 * y1 + w2 * y2
    // Round to nearest integer
    let bx = 0
    let by = 0
    if bx_scaled >= 0
        bx = (bx_scaled + densq / 2) / densq
    else
        bx = (0 - ((0 - bx_scaled) + densq / 2) / densq)
    if by_scaled >= 0
        by = (by_scaled + densq / 2) / densq
    else
        by = (0 - ((0 - by_scaled) + densq / 2) / densq)
    let result = []
    push(result, bx)
    push(result, by)
    result

// bz_quadratic: sample a quadratic Bezier at `steps` evenly-spaced t values (0..1 inclusive).
// Uses integer de Casteljau (rational arithmetic). Dedupes consecutive duplicate pixels.
// steps=1 returns just the start point; steps=2 returns [start, end].
fn bz_quadratic(x0, y0, x1, y1, x2, y2, steps)
    let pts = []
    if steps <= 0
        let pt = []
        push(pt, x0)
        push(pt, y0)
        push(pts, pt)
        return pts
    let n = steps
    if n == 1
        n = 1
    let i = 0
    while i <= n
        let pt = bz_point_quad(x0, y0, x1, y1, x2, y2, i, n)
        push(pts, pt)
        i = i + 1
    bz_dedup_consec(pts)

// bz_point_cubic: evaluate cubic Bezier at t = t_num/t_den (integer-rounded).
// B(t) = (1-t)^3*P0 + 3t(1-t)^2*P1 + 3t^2(1-t)*P2 + t^3*P3
fn bz_point_cubic(x0, y0, x1, y1, x2, y2, x3, y3, t_num, t_den)
    let a = t_den - t_num
    let t = t_num
    let d = t_den
    // Scale factor = d^3
    let d3 = d * d * d
    let w0 = a * a * a
    let w1 = 3 * t * a * a
    let w2 = 3 * t * t * a
    let w3 = t * t * t
    let bx_scaled = w0 * x0 + w1 * x1 + w2 * x2 + w3 * x3
    let by_scaled = w0 * y0 + w1 * y1 + w2 * y2 + w3 * y3
    // Round to nearest integer
    let bx = 0
    let by = 0
    let half = d3 / 2
    if bx_scaled >= 0
        bx = (bx_scaled + half) / d3
    else
        bx = (0 - ((0 - bx_scaled) + half) / d3)
    if by_scaled >= 0
        by = (by_scaled + half) / d3
    else
        by = (0 - ((0 - by_scaled) + half) / d3)
    let result = []
    push(result, bx)
    push(result, by)
    result

// bz_cubic: sample a cubic Bezier at `steps` evenly-spaced t values (0..1 inclusive).
// Uses integer de Casteljau (rational arithmetic). Dedupes consecutive duplicate pixels.
fn bz_cubic(x0, y0, x1, y1, x2, y2, x3, y3, steps)
    let pts = []
    if steps <= 0
        let pt = []
        push(pt, x0)
        push(pt, y0)
        push(pts, pt)
        return pts
    let n = steps
    let i = 0
    while i <= n
        let pt = bz_point_cubic(x0, y0, x1, y1, x2, y2, x3, y3, i, n)
        push(pts, pt)
        i = i + 1
    bz_dedup_consec(pts)

// bz_line_length_estimate: estimate total arc length of a polyline (list of [x,y] points).
// Returns integer sum of Euclidean segment lengths (floor).
fn bz_line_length_estimate(points)
    let n = len(points)
    if n < 2
        return 0
    let total = 0
    for i in 0..(n - 1)
        let p0 = points[i]
        let p1 = points[i + 1]
        let dx = p1[0] - p0[0]
        let dy = p1[1] - p0[1]
        let dsq = dx * dx + dy * dy
        let seg = _bz_isqrt(dsq)
        total = total + seg
    total

// bz_flatten_quad: adaptively flatten a quadratic Bezier to a polyline.
// Uses a chord-distance tolerance: subdivides until the control point midpoint
// deviation from the chord midpoint is <= tol pixels.
// Simple recursive subdivision: at each level, if the control-point offset
// |P1 - midpoint(P0,P2)| <= tol (in max-coord), emit straight line, else recurse.
fn bz_flatten_quad(x0, y0, x1, y1, x2, y2, tol)
    let pts = []
    // Bootstrap: push start point, then recursively add the rest.
    let sp = []
    push(sp, x0)
    push(sp, y0)
    push(pts, sp)
    _bz_flatten_rec(pts, x0, y0, x1, y1, x2, y2, tol, 0)
    pts

// _bz_flatten_rec: recursive worker for bz_flatten_quad.
// Appends points (not including the start) to pts.
fn _bz_flatten_rec(pts, x0, y0, x1, y1, x2, y2, tol, depth)
    if depth > 10
        // Max recursion guard: emit endpoint.
        let ep = []
        push(ep, x2)
        push(ep, y2)
        push(pts, ep)
        return 0
    // Chord midpoint
    let mx = (x0 + x2) / 2
    let my = (y0 + y2) / 2
    // Control point deviation from chord midpoint
    let ddx = x1 - mx
    let ddy = y1 - my
    let adx = _bz_abs(ddx)
    let ady = _bz_abs(ddy)
    let dev = adx
    if ady > dev
        dev = ady
    if dev <= tol
        // Flat enough: emit endpoint
        let ep = []
        push(ep, x2)
        push(ep, y2)
        push(pts, ep)
        return 0
    // Subdivide at t=0.5 via de Casteljau
    let m01x = (x0 + x1) / 2
    let m01y = (y0 + y1) / 2
    let m12x = (x1 + x2) / 2
    let m12y = (y1 + y2) / 2
    let midx = (m01x + m12x) / 2
    let midy = (m01y + m12y) / 2
    _bz_flatten_rec(pts, x0, y0, m01x, m01y, midx, midy, tol, depth + 1)
    _bz_flatten_rec(pts, midx, midy, m12x, m12y, x2, y2, tol, depth + 1)
    0

// bz_dedup_consec: remove consecutive duplicate [x,y] points. Public export.
fn bz_dedup_consec(pts)
    let n = len(pts)
    if n == 0
        return pts
    let out = []
    let p0 = pts[0]
    let lx = p0[0]
    let ly = p0[1]
    let fp = []
    push(fp, lx)
    push(fp, ly)
    push(out, fp)
    for i in 1..n
        let p = pts[i]
        let cx = p[0]
        let cy = p[1]
        if cx != lx or cy != ly
            let np = []
            push(np, cx)
            push(np, cy)
            push(out, np)
            lx = cx
            ly = cy
    out

// bz_endpoints: return [start_x, start_y, end_x, end_y] for a sampled point list.
// Assumes pts is non-empty (at least 1 point).
fn bz_endpoints(pts)
    let n = len(pts)
    let result = []
    if n == 0
        return result
    let first = pts[0]
    let last = pts[n - 1]
    push(result, first[0])
    push(result, first[1])
    push(result, last[0])
    push(result, last[1])
    result
