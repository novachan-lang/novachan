// std/raster/blit.nova — Sprite blit operations onto surfaces with clipping.
// LEAF — imports NOTHING.
//
// SURFACE MODEL: dict with keys "w" (int), "h" (int), "px" (flat row-major list).
// Pixel (x,y) = px[y*w + x].  All coordinates are integer pixel math.
//
// Public API:
//   bt_new(w,h,fill)           -> any   create a surface filled with fill
//   bt_get(s,x,y)              -> int   read pixel; 0 if out-of-bounds
//   bt_set(s,x,y,v)                     write pixel; no-op if out-of-bounds
//   bt_blit(dst,src,dx,dy)     -> any   copy src onto dst at (dx,dy), clipped
//   bt_blit_transparent(dst,src,dx,dy,transparent) -> any  skip matching pixels
//   bt_blit_region(dst,src,sx,sy,sw,sh,dx,dy) -> any  copy sub-rectangle
//   bt_copy(src)               -> any   deep-copy a surface
//   bt_fill_region(s,x,y,w,h,val) -> any  fill a rectangle with val, clipped
//   bt_flip_h(s)               -> any   horizontal mirror (new surface)
//   bt_flip_v(s)               -> any   vertical mirror (new surface)

// bt_new: create a surface of width w, height h, all pixels set to fill.
fn bt_new(w, h, fill)
    let s = {}
    s["w"] = w
    s["h"] = h
    let px = []
    let total = w * h
    for i in 0..total
        px.push(fill)
    s["px"] = px
    s

// bt_get: read pixel at (x,y); returns 0 if out-of-bounds.
fn bt_get(s, x, y)
    let w = s["w"]
    let h = s["h"]
    if x < 0
        return 0
    if x >= w
        return 0
    if y < 0
        return 0
    if y >= h
        return 0
    let px = s["px"]
    let idx = y * w + x
    px[idx]

// bt_set: write pixel at (x,y); no-op if out-of-bounds.
fn bt_set(s, x, y, v)
    let w = s["w"]
    let h = s["h"]
    if x < 0
        return 0
    if x >= w
        return 0
    if y < 0
        return 0
    if y >= h
        return 0
    let px = s["px"]
    let idx = y * w + x
    px[idx] = v
    0

// bt_blit: copy src onto dst at destination offset (dx,dy), clipped to dst bounds.
fn bt_blit(dst, src, dx, dy)
    let sw = src["w"]
    let sh = src["h"]
    let dw = dst["w"]
    let dh = dst["h"]
    let spx = src["px"]
    let dpx = dst["px"]
    for sy in 0..sh
        let sx = 0
        while sx < sw
            let tx = dx + sx
            let ty = dy + sy
            if tx >= 0
                if tx < dw
                    if ty >= 0
                        if ty < dh
                            let sidx = sy * sw + sx
                            let didx = ty * dw + tx
                            let v = spx[sidx]
                            dpx[didx] = v
            sx = sx + 1
    0

// bt_blit_transparent: blit src onto dst, skipping pixels equal to transparent.
fn bt_blit_transparent(dst, src, dx, dy, transparent)
    let sw = src["w"]
    let sh = src["h"]
    let dw = dst["w"]
    let dh = dst["h"]
    let spx = src["px"]
    let dpx = dst["px"]
    let sy = 0
    while sy < sh
        let sx = 0
        while sx < sw
            let tx = dx + sx
            let ty = dy + sy
            if tx >= 0
                if tx < dw
                    if ty >= 0
                        if ty < dh
                            let sidx = sy * sw + sx
                            let v = spx[sidx]
                            if v != transparent
                                let didx = ty * dw + tx
                                dpx[didx] = v
            sx = sx + 1
        sy = sy + 1
    0

// bt_blit_region: copy sub-rectangle (sx,sy,sw,sh) from src to dst at (dx,dy), clipped.
fn bt_blit_region(dst, src, sx, sy, sw, sh, dx, dy)
    let srcw = src["w"]
    let srch = src["h"]
    let dw = dst["w"]
    let dh = dst["h"]
    let spx = src["px"]
    let dpx = dst["px"]
    for ry in 0..sh
        let rx = 0
        while rx < sw
            let srcx = sx + rx
            let srcy = sy + ry
            let tx = dx + rx
            let ty = dy + ry
            if srcx >= 0
                if srcx < srcw
                    if srcy >= 0
                        if srcy < srch
                            if tx >= 0
                                if tx < dw
                                    if ty >= 0
                                        if ty < dh
                                            let sidx = srcy * srcw + srcx
                                            let didx = ty * dw + tx
                                            let v = spx[sidx]
                                            dpx[didx] = v
            rx = rx + 1
    0

// bt_copy: deep-copy a surface, returning a new independent surface dict.
fn bt_copy(src)
    let sw = src["w"]
    let sh = src["h"]
    let spx = src["px"]
    let total = sw * sh
    let npx = []
    for i in 0..total
        let v = spx[i]
        npx.push(v)
    let out = {}
    out["w"] = sw
    out["h"] = sh
    out["px"] = npx
    out

// bt_fill_region: fill a rectangle (x,y,w,h) with val, clipped to surface bounds.
fn bt_fill_region(s, x, y, w, h, val)
    let sw = s["w"]
    let sh = s["h"]
    let px = s["px"]
    for ry in 0..h
        let rx = 0
        while rx < w
            let tx = x + rx
            let ty = y + ry
            if tx >= 0
                if tx < sw
                    if ty >= 0
                        if ty < sh
                            let idx = ty * sw + tx
                            px[idx] = val
            rx = rx + 1
    0

// bt_flip_h: return a new surface that is the horizontal mirror of src.
fn bt_flip_h(src)
    let sw = src["w"]
    let sh = src["h"]
    let spx = src["px"]
    let npx = []
    for ry in 0..sh
        let rx = 0
        while rx < sw
            let sidx = ry * sw + (sw - 1 - rx)
            let v = spx[sidx]
            npx.push(v)
            rx = rx + 1
    let out = {}
    out["w"] = sw
    out["h"] = sh
    out["px"] = npx
    out

// bt_flip_v: return a new surface that is the vertical mirror of src.
fn bt_flip_v(src)
    let sw = src["w"]
    let sh = src["h"]
    let spx = src["px"]
    let npx = []
    for ry in 0..sh
        let rx = 0
        while rx < sw
            let sidx = (sh - 1 - ry) * sw + rx
            let v = spx[sidx]
            npx.push(v)
            rx = rx + 1
    let out = {}
    out["w"] = sw
    out["h"] = sh
    out["px"] = npx
    out
