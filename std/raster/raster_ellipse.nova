// std/raster/raster_ellipse.nova
// Midpoint ellipse algorithm — pure integer, 4-way symmetry.
// SURFACE model: dict with 'w'(int), 'h'(int), 'px'(flat row-major list, length w*h).
// Point lists: each element is a 2-element [x,y] list.
// Private helpers use _rel_ prefix.
//
// Midpoint ellipse algorithm reference:
//   Parametric form: (x/a)^2 + (y/b)^2 = 1
//   Decision function: F(x,y) = b^2*x^2 + a^2*y^2 - a^2*b^2
//   Region 1 (top, x dominant): start at (0,b), move right until |2*b^2*x| >= |2*a^2*y|
//   Region 2 (side, y dominant): continue from region-1 exit until y=0.

// --- Surface helpers (self-contained) ---

// _rel_sur_in_bounds: true if (x,y) is within surface bounds.
fn _rel_sur_in_bounds(s, x, y)
    let w = s["w"]
    let h = s["h"]
    x >= 0 and y >= 0 and x < w and y < h

// _rel_sur_set: set pixel (x,y) to value v (mutates px).
fn _rel_sur_set(s, x, y, v)
    let ok = _rel_sur_in_bounds(s, x, y)
    if ok
        let w = s["w"]
        let idx = y * w + x
        let px = s["px"]
        px[idx] = v

// --- Deduplication helper ---
// _rel_pt_in: true if [px,py] already exists in list pts.
fn _rel_pt_in(pts, px, py)
    for p in pts
        if p[0] == px and p[1] == py
            return true
    false

// _rel_add_pt: add [px,py] to pts only if not already present.
fn _rel_add_pt(pts, px, py)
    if not _rel_pt_in(pts, px, py)
        push(pts, [px, py])

// _rel_emit4: emit up to 4 symmetric ellipse points for offset (dx,dy) around center (cx,cy).
fn _rel_emit4(pts, cx, cy, dx, dy)
    _rel_add_pt(pts, cx + dx, cy + dy)
    _rel_add_pt(pts, cx - dx, cy + dy)
    _rel_add_pt(pts, cx + dx, cy - dy)
    _rel_add_pt(pts, cx - dx, cy - dy)

// --- Public API ---

// rel_ellipse: boundary points of axis-aligned ellipse (cx,cy,a,b) via midpoint ellipse algorithm.
// a = semi-major axis (horizontal), b = semi-minor axis (vertical).
// Returns a deduplicated list of [x,y] integer points using 4-way symmetry.
// NOTE: these are the CLOSEST-INTEGER rasterization of the boundary, so some boundary
// pixels legitimately lie just OUTSIDE the exact real ellipse and will NOT satisfy
// rel_contains (which is the exact test b^2 x^2 + a^2 y^2 <= a^2 b^2). This is inherent
// to discrete rasterization, not a bug. Use rel_filled (which uses rel_contains) for the
// exact interior; use rel_ellipse for the drawn outline.
// Degenerate cases: a=0 gives vertical segment (cx,cy-b..cy+b),
//                   b=0 gives horizontal segment (cx-a..cx+a, cy).
fn rel_ellipse(cx, cy, a, b)
    let pts = []
    // Handle degenerate: a=0 (vertical segment)
    if a == 0
        for dy in (-b)..(b + 1)
            _rel_add_pt(pts, cx, cy + dy)
        return pts
    // Handle degenerate: b=0 (horizontal segment)
    if b == 0
        for dx in (-a)..(a + 1)
            _rel_add_pt(pts, cx + dx, cy)
        return pts
    // Standard Bresenham midpoint ellipse (integer, no division needed).
    // Uses decision parameters scaled to avoid /4:
    //   p1 = b^2 - a^2*b + a^2/4   (approximated as:  b^2*(1-2b) + a^2  when shifted)
    // We use the clean incremental form with 4* scaling to keep integers exact.
    let asq = a * a
    let bsq = b * b
    let x = 0
    let y = b
    // Region 1 initial p (using *4 scaling to absorb the 1/4 term):
    //   4*p1 = 4*b^2 - 4*a^2*b + a^2
    let p = 4 * bsq - 4 * asq * b + asq
    // dx = 2*b^2*x (tracks slope magnitude for region boundary)
    // dy = 2*a^2*y
    let ddx = 0
    let ddy = 2 * asq * b
    // Region 1: while the slope magnitude |dy/dx| > 1, i.e., ddx < ddy
    // (ddx = 2*b^2*x, ddy = 2*a^2*y  =>  region 1 while bsq*(x+1)*2 < asq*y*2, approx ddx < ddy)
    // We use ddx <= ddy - 2*asq as the strict region 1 boundary.
    while ddx < ddy
        _rel_emit4(pts, cx, cy, x, y)
        x += 1
        ddx += 2 * bsq
        if p < 0
            p += 4 * bsq * x + 4 * bsq
            // equivalently p += 2*bsq*(2x+1) where x is already incremented: p += ddx + 2*bsq
        else
            y -= 1
            ddy -= 2 * asq
            p += 4 * bsq * x + 4 * bsq - 4 * asq * y + 4 * asq
    // Region 2: from (x,y) to (a,0), moving downward.
    // p2_4x initial: b^2*(2x+1)^2 + 4*a^2*(y-1)^2 - 4*a^2*b^2
    //              = b^2*(2x+1)^2 + 4*a^2*((y-1)^2 - b^2)
    // In practice we recalculate p at the transition:
    let ym1 = y - 1
    let xp1 = 2 * x + 1
    let p2 = bsq * xp1 * xp1 + 4 * asq * ym1 * ym1 - 4 * asq * bsq
    while y >= 0
        _rel_emit4(pts, cx, cy, x, y)
        y -= 1
        if p2 > 0
            p2 -= 8 * asq * y - 4 * asq
        else
            x += 1
            p2 += 8 * bsq * x + 4 * bsq - 8 * asq * y - 4 * asq
    pts

// rel_ellipse_to_surface: draw ellipse boundary onto surface s with pixel value val.
// Clips to surface bounds. Mutates s["px"] in place. Returns s.
fn rel_ellipse_to_surface(s, cx, cy, a, b, val)
    let pts = rel_ellipse(cx, cy, a, b)
    let n = len(pts)
    for i in 0..n
        let p = pts[i]
        _rel_sur_set(s, p[0], p[1], val)
    s

// rel_contains: true if (x,y) is inside or on the ellipse (cx,cy,a,b).
// Condition: b^2*(x-cx)^2 + a^2*(y-cy)^2 <= a^2*b^2.
fn rel_contains(cx, cy, a, b, x, y)
    let dx = x - cx
    let dy = y - cy
    let asq = a * a
    let bsq = b * b
    let lhs = bsq * dx * dx + asq * dy * dy
    let rhs = asq * bsq
    lhs <= rhs

// rel_filled: all integer points (x,y) inside or on the ellipse (cx,cy,a,b).
// Returns a list of [x,y] points in scanline order (y from cy-b to cy+b).
fn rel_filled(cx, cy, a, b)
    let pts = []
    for dy in (-b)..(b + 1)
        for dx in (-a)..(a + 1)
            if rel_contains(cx, cy, a, b, cx + dx, cy + dy)
                push(pts, [cx + dx, cy + dy])
    pts

// rel_point_count: number of distinct boundary points for ellipse with semi-axes (a,b).
fn rel_point_count(a, b)
    let pts = rel_ellipse(0, 0, a, b)
    len(pts)

// rel_bbox: bounding box of ellipse as [xmin, ymin, xmax, ymax].
fn rel_bbox(cx, cy, a, b)
    [cx - a, cy - b, cx + a, cy + b]
