// std/raster/polygon_fill — scanline even-odd polygon fill (integer raster).
//
// Vertices are a list of [x,y] integer point lists.
// The fill uses the standard even-odd (parity) rule.
// Edge pixels: scanlines where both endpoints lie are included;
// edges are sampled left-open, right-closed per Bresenham convention
// (actually: we use the standard "lower-left" rule — a horizontal scanline
// at y intersects an edge from (x1,y1)-(x2,y2) iff min(y1,y2) <= y < max(y1,y2)).
// Filled pixels include the left span boundary but exclude the right, so
// a square [0..3]^2 with vertices (0,0),(3,0),(3,3),(0,3) fills
// y in [0,3), x in [0,3): 9 pixels. (Edges themselves = 3 pixels/side.)
//
// Public API:
//   pf_bbox(vertices)                    -> list [xmin,ymin,xmax,ymax]
//   pf_edges(vertices)                   -> list of edge pairs [[x1,y1,x2,y2],...]
//   pf_scanline_spans(vertices, y)       -> list of x-span [lo,hi] pairs at scanline y
//   pf_contains(vertices, x, y)          -> bool  even-odd point-in-polygon
//   pf_fill(vertices)                    -> list of [x,y] filled interior points
//   pf_fill_to_surface(s, vertices, val) -> any   draw filled polygon onto surface
//   pf_area_pixels(vertices)             -> int   count of filled interior pixels

// _pf_abs — integer absolute value.
fn _pf_abs(v: int) -> int
    -v if v < 0 else v

// _pf_min — minimum of two ints.
fn _pf_min(a: int, b: int) -> int
    b if b < a else a

// _pf_max — maximum of two ints.
fn _pf_max(a: int, b: int) -> int
    b if b > a else a

// pf_bbox — axis-aligned bounding box of vertices as [xmin, ymin, xmax, ymax].
fn pf_bbox(vertices: list) -> list
    let n = len(vertices)
    if n == 0
        return [0, 0, 0, 0]
    let xmin = vertices[0][0]
    let ymin = vertices[0][1]
    let xmax = vertices[0][0]
    let ymax = vertices[0][1]
    for i in 1..n
        let vx = vertices[i][0]
        let vy = vertices[i][1]
        if vx < xmin
            xmin = vx
        if vx > xmax
            xmax = vx
        if vy < ymin
            ymin = vy
        if vy > ymax
            ymax = vy
    [xmin, ymin, xmax, ymax]

// pf_edges — return list of edges as [x1,y1,x2,y2] lists.
fn pf_edges(vertices: list) -> list
    let n = len(vertices)
    if n < 2
        return []
    [[vertices[i][0], vertices[i][1], vertices[(i + 1) % n][0], vertices[(i + 1) % n][1]] for i in 0..n]

// _pf_edge_x_at_y — for edge (x1,y1)-(x2,y2), compute x intersection at scanline y.
// Uses integer round-half-down: x = x1 + (y - y1) * (x2 - x1) / (y2 - y1).
// Caller must ensure y2 != y1 (non-horizontal edge).
fn _pf_edge_x_at_y(x1: int, y1: int, x2: int, y2: int, y: int) -> int
    let dy = y2 - y1
    let dx = x2 - x1
    let num = (y - y1) * dx
    // integer division truncating toward zero; for scan fill we use truncation
    let q = num / dy
    x1 + q

// _pf_sort_xs — insertion sort a list of ints in place.
fn _pf_sort_xs(xs: list)
    let n = len(xs)
    for i in 1..n
        let key = xs[i]
        let j = i - 1
        while j >= 0 and xs[j] > key
            xs[j + 1] = xs[j]
            j -= 1
        xs[j + 1] = key

// pf_scanline_spans — x-spans [lo, hi] for filled pixels at scanline y.
// Uses even-odd intersection: collect x crossings, sort, pair them.
// Edge inclusion rule: min(y1,y2) <= y < max(y1,y2) (excludes top vertex).
fn pf_scanline_spans(vertices: list, y: int) -> list
    let n = len(vertices)
    let xs = []
    for i in 0..n
        let j = (i + 1) % n
        let x1 = vertices[i][0]
        let y1 = vertices[i][1]
        let x2 = vertices[j][0]
        let y2 = vertices[j][1]
        // non-horizontal edge that crosses scanline y (lower-endpoint included, upper excluded)
        let ylo = _pf_min(y1, y2)
        let yhi = _pf_max(y1, y2)
        if y >= ylo and y < yhi
            let xi = _pf_edge_x_at_y(x1, y1, x2, y2, y)
            push(xs, xi)
    _pf_sort_xs(xs)
    // pair crossings into [lo, hi] spans
    let spans = []
    let k = 0
    while k + 1 < len(xs)
        push(spans, [xs[k], xs[k + 1]])
        k += 2
    spans

// pf_contains — even-odd point-in-polygon ray cast test.
// Casts a horizontal ray from (x,y) to the right; counts edge crossings.
fn pf_contains(vertices: list, x: int, y: int) -> bool
    let n = len(vertices)
    let crossings = 0
    for i in 0..n
        let j = (i + 1) % n
        let x1 = vertices[i][0]
        let y1 = vertices[i][1]
        let x2 = vertices[j][0]
        let y2 = vertices[j][1]
        // check if ray from (x,y) rightward crosses this edge
        let ylo = _pf_min(y1, y2)
        let yhi = _pf_max(y1, y2)
        if y >= ylo and y < yhi
            // find x at y on this edge
            let xi = _pf_edge_x_at_y(x1, y1, x2, y2, y)
            if x < xi
                crossings += 1
    crossings % 2 == 1

// pf_fill — scanline even-odd fill; return list of [x,y] interior points.
fn pf_fill(vertices: list) -> list
    let pts = []
    let n = len(vertices)
    if n < 3
        return pts
    let bb = pf_bbox(vertices)
    let ymin = bb[1]
    let ymax = bb[3]
    let y = ymin
    while y <= ymax
        let spans = pf_scanline_spans(vertices, y)
        for si in 0..len(spans)
            let lo = spans[si][0]
            let hi = spans[si][1]
            let x = lo
            while x < hi
                push(pts, [x, y])
                x += 1
        y += 1
    pts

// pf_fill_to_surface — draw filled polygon onto surface s with value val.
fn pf_fill_to_surface(s: dict, vertices: list, val: int) -> any
    let n = len(vertices)
    if n < 3
        return s
    let bb = pf_bbox(vertices)
    let ymin = bb[1]
    let ymax = bb[3]
    let sw = s["w"]
    let sh = s["h"]
    let y = ymin
    while y <= ymax
        if y >= 0 and y < sh
            let spans = pf_scanline_spans(vertices, y)
            for si in 0..len(spans)
                let lo = spans[si][0]
                let hi = spans[si][1]
                let x = lo
                while x < hi
                    if x >= 0 and x < sw
                        let px = s["px"]
                        let idx = y * sw + x
                        px[idx] = val
                    x += 1
        y += 1
    s

// pf_area_pixels — count of filled interior pixels.
fn pf_area_pixels(vertices: list) -> int
    let pts = pf_fill(vertices)
    len(pts)
