// std/math/primesieve.nova — Sieve of Eratosthenes utilities.
// LEAF — imports NOTHING.
//
// Public API:
//   ps_sieve(n)          -> list   primes <= n, ascending integers
//   ps_count(n)          -> int    count of primes <= n  (pi(n))
//   ps_nth_prime(k)      -> int    k-th prime, 1-indexed (ps_nth_prime(1)=2)
//   ps_is_prime_flags(n) -> list   bool list, index 0..n; flags[i]=true iff i is prime
//
// IMPLEMENTATION NOTES:
//   The flag list is built via a fill loop (no multi-line literal).
//   All sieve logic is via the classical Eratosthenes algorithm.
//   Complexity: O(n log log n) time, O(n) space.

// PRIVATE: build the raw sieve flag list of length (n+1) for indices 0..n.
// Returns a list of int (0/1) where 1 means "possibly prime" initially,
// then the sieve crosses off composites.  We use int 1/0 because NOVA
// bool lists and int lists are both homogeneous lists.
fn _ps_build_flags(n: int) -> list
    // Build a list of (n+1) ones via repeated push.
    let flags = []
    for i in 0..n + 1
        push(flags, 1)
    // 0 and 1 are not prime.
    if n >= 0
        flags[0] = 0
    if n >= 1
        flags[1] = 0
    // Classic sieve: for each p starting at 2, cross off multiples.
    let p = 2
    while p * p <= n
        if flags[p] == 1
            let mult = p * p
            while mult <= n
                flags[mult] = 0
                mult += p
        p += 1
    flags

// ps_sieve — return list of all primes <= n, ascending.
// ps_sieve(1) = [], ps_sieve(2) = [2].
fn ps_sieve(n: int) -> list
    let primes = []
    if n < 2
        return primes
    let flags = _ps_build_flags(n)
    for i in 2..n + 1
        if flags[i] == 1
            push(primes, i)
    primes

// ps_count — count of primes <= n (the prime-counting function pi(n)).
// ps_count(0) = 0, ps_count(1) = 0, ps_count(2) = 1.
fn ps_count(n: int) -> int
    if n < 2
        return 0
    let flags = _ps_build_flags(n)
    let cnt = 0
    for i in 2..n + 1
        if flags[i] == 1
            cnt += 1
    cnt

// ps_nth_prime — return the k-th prime (1-indexed).
// ps_nth_prime(1)=2, ps_nth_prime(2)=3, ps_nth_prime(10)=29.
// For k <= 0 returns -1.  Uses an upper-bound estimate to size the sieve,
// then falls back to a linear extension if needed.
fn ps_nth_prime(k: int) -> int
    if k <= 0
        return -1
    // Rosser's theorem: p_k < k*(ln(k) + ln(ln(k))) for k >= 6.
    // We use a conservative over-estimate via integer arithmetic only.
    // Estimate: for small k use a hardcoded cap; for larger k use 15*k as
    // a safe upper bound (p_25=97 < 375; p_1000=7919 < 15000; etc.).
    let cap = 15 * k
    if cap < 50
        cap = 50
    let flags = _ps_build_flags(cap)
    let cnt = 0
    for i in 2..cap + 1
        if flags[i] == 1
            cnt += 1
            if cnt == k
                return i
    // Extremely unlikely fallback: extend by doubling the cap.
    // This handles pathological k values beyond our estimate.
    let cap2 = cap * 2
    let flags2 = _ps_build_flags(cap2)
    let cnt2 = 0
    for j in 2..cap2 + 1
        if flags2[j] == 1
            cnt2 += 1
            if cnt2 == k
                return j
    -1

// ps_is_prime_flags — return a bool list of length (n+1).
// flags[i] is true (int 1) if i is prime, false (int 0) otherwise.
// Index 0..n inclusive. ps_is_prime_flags(0) = [false].
fn ps_is_prime_flags(n: int) -> list
    if n < 0
        return []
    _ps_build_flags(n)
