// std/math/jacobsthal.nova — Jacobsthal and Jacobsthal-Lucas sequences.
// LEAF — imports NOTHING.
//
// Jacobsthal:       J(0)=0, J(1)=1, J(n)=J(n-1)+2*J(n-2)
// Jacobsthal-Lucas: L(0)=2, L(1)=1, L(n)=L(n-1)+2*L(n-2)
//
// Public API:
//   jb_jacobsthal(n) -> int   nth Jacobsthal number (0-indexed)
//   jb_lucas(n)      -> int   nth Jacobsthal-Lucas number (0-indexed)
//   jb_list(n)       -> list  first n Jacobsthal numbers [J(0)..J(n-1)]
//
// Private helpers use the _jb_ prefix to avoid cross-module symbol collisions.

// jb_jacobsthal — nth Jacobsthal number.
// J(0)=0, J(1)=1, J(n)=J(n-1)+2*J(n-2) for n>=2.
// Returns 0 for n <= 0.
fn jb_jacobsthal(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 1
    let a = 0
    let b = 1
    let i = 2
    while i <= n
        let c = b + 2 * a
        a = b
        b = c
        i = i + 1
    b

// jb_lucas — nth Jacobsthal-Lucas number.
// L(0)=2, L(1)=1, L(n)=L(n-1)+2*L(n-2) for n>=2.
// Returns 2 for n <= 0.
fn jb_lucas(n: int) -> int
    if n <= 0
        return 2
    if n == 1
        return 1
    let a = 2
    let b = 1
    let i = 2
    while i <= n
        let c = b + 2 * a
        a = b
        b = c
        i = i + 1
    b

// jb_list — first n Jacobsthal numbers: [J(0), J(1), ..., J(n-1)].
// jb_list(0)=[], jb_list(6)=[0,1,1,3,5,11].
fn jb_list(n: int) -> list
    let out = []
    if n <= 0
        return out
    push(out, 0)
    if n == 1
        return out
    push(out, 1)
    if n == 2
        return out
    let a = 0
    let b = 1
    for i in 2..n
        let c = b + 2 * a
        a = b
        b = c
        push(out, b)
    out
