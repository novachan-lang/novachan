// std/math/mobius.nova — Möbius function and related multiplicative functions.
// All functions operate on positive integers (n >= 1) unless noted.
// LEAF — imports NOTHING.
//
// Public API:
//   mob_mu(n)            -> int   Möbius function: 0 if n has a square prime factor,
//                                 else (-1)^k where k = number of distinct prime factors.
//                                 mob_mu(1) = 1.
//   mob_is_squarefree(n) -> bool  true iff n has no prime factor appearing more than once.
//   mob_mertens(n)       -> int   Mertens function M(n) = sum of mu(1)..mu(n).
//
// ALGORITHM:
//   mob_mu uses trial division to extract prime factors of n up to sqrt(n).
//   For each prime p found: if p^2 divides n, return 0 immediately (not squarefree).
//   Otherwise count the distinct prime factor; divide out p completely.
//   If remainder > 1 after the loop, it is one final prime factor.
//   Then return (-1)^(count of distinct primes).
//
//   mob_mertens sums mob_mu(k) for k = 1..n in a single pass; O(n * sqrt(n)).
//
// KNOWN ANSWERS (hand-verified):
//   mob_mu(1)  =  1   (empty product: 0 distinct primes, (-1)^0 = 1)
//   mob_mu(2)  = -1   (2 is prime: 1 distinct prime, (-1)^1 = -1)
//   mob_mu(4)  =  0   (4 = 2^2: square factor)
//   mob_mu(6)  =  1   (6 = 2×3: 2 distinct primes, (-1)^2 = 1)
//   mob_mu(30) = -1   (30 = 2×3×5: 3 distinct primes, (-1)^3 = -1)
//   mob_is_squarefree(12) = false  (12 = 2^2 × 3)
//   mob_is_squarefree(30) = true   (30 = 2 × 3 × 5)
//   mob_mertens(5) = mu(1)+mu(2)+mu(3)+mu(4)+mu(5) = 1-1-1+0-1 = -2

// mob_mu — Möbius function.
// n must be >= 1. mob_mu(0) is undefined; returns 0 by convention.
// Returns: 0 if n has a squared prime factor; (-1)^k otherwise, k = #distinct primes.
fn mob_mu(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 1
    let m = n
    let count = 0
    // Factor out 2 first.
    if m % 2 == 0
        count += 1
        m /= 2
        // If 2 still divides m, then 4 | n → squarefree fails.
        if m % 2 == 0
            return 0
    // Factor out odd primes starting at 3.
    let p = 3
    while p * p <= m
        if m % p == 0
            count += 1
            m /= p
            // If p still divides m, then p^2 | n → squarefree fails.
            if m % p == 0
                return 0
        p += 2
    // Any remainder > 1 is a prime factor (distinct, appears exactly once).
    if m > 1
        count += 1
    // Return (-1)^count: odd count = -1, even count = 1.
    if count % 2 == 1
        return -1
    return 1

// mob_is_squarefree — true iff n has no prime factor with multiplicity > 1.
// n must be >= 1. mob_is_squarefree(0) = false by convention.
// Equivalent to mob_mu(n) != 0.
fn mob_is_squarefree(n: int) -> bool
    if n <= 0
        return false
    mob_mu(n) != 0

// mob_mertens — Mertens function M(n) = sum_{k=1}^{n} mu(k).
// mob_mertens(0) = 0. Grows slowly; |M(n)| = O(sqrt(n)) in practice.
// O(n * sqrt(n)) time — suitable for n up to ~10^6 in reasonable time.
fn mob_mertens(n: int) -> int
    if n <= 0
        return 0
    let total = 0
    for k in 1..n + 1
        total += mob_mu(k)
    total
