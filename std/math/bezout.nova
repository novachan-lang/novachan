// std/math/bezout.nova — Extended Euclidean Algorithm and Bezout's identity.
// All public functions use the bz_ prefix.
// LEAF — imports NOTHING.
//
// Public API:
//   bz_egcd(a, b)        -> list  [g, x, y] with a*x + b*y == g == gcd(a,b); g >= 0
//   bz_gcd(a, b)         -> int   greatest common divisor (always >= 0)
//   bz_lcm(a, b)         -> int   least common multiple   (always >= 0)
//   bz_mod_inverse(a, m) -> int   modular inverse of a mod m, or -1 if gcd(a,m) != 1
//
// ALGORITHM (bz_egcd):
//   Iterative extended Euclidean algorithm (avoids recursion depth limits).
//   Maintains:  old_r = a*old_s + b*old_t  (Bezout invariant)
//   Terminates when r == 0; at that point old_r == gcd(a,b), old_s and old_t
//   are the Bezout coefficients.  Sign is normalised so g >= 0.
//
// KNOWN ANSWERS (hand-verified):
//   bz_egcd(30, 20)      -> g=10; 30*x+20*y==10  (e.g. x=1, y=-1)
//   bz_gcd(48, 36)       -> 12
//   bz_egcd(35, 15)      -> g=5;  35*x+15*y==5
//   bz_mod_inverse(3,11) -> 4   (3*4=12 ≡ 1 mod 11)
//   bz_mod_inverse(2,4)  -> -1  (gcd(2,4)=2)
//   bz_lcm(4, 6)         -> 12

// bz_egcd — extended GCD.
// Returns [g, x, y] such that a*x + b*y == g == gcd(a, b), g >= 0.
fn bz_egcd(a: int, b: int) -> list
    let old_r = a
    let r = b
    let old_s = 1
    let s = 0
    let old_t = 0
    let t = 1
    let done = 0
    while done == 0
        if r == 0
            done = 1
        if done == 0
            let q = old_r / r
            let tmp_r = r
            r = old_r - q * tmp_r
            old_r = tmp_r
            let tmp_s = s
            s = old_s - q * tmp_s
            old_s = tmp_s
            let tmp_t = t
            t = old_t - q * tmp_t
            old_t = tmp_t
    let g = old_r
    let x = old_s
    let y = old_t
    if g < 0
        g = 0 - g
        x = 0 - x
        y = 0 - y
    [g, x, y]

// bz_gcd — greatest common divisor (always >= 0).
fn bz_gcd(a: int, b: int) -> int
    let e = bz_egcd(a, b)
    e[0]

// bz_lcm — least common multiple (always >= 0, 0 if either arg is 0).
fn bz_lcm(a: int, b: int) -> int
    if a == 0
        return 0
    if b == 0
        return 0
    let g = bz_gcd(a, b)
    let ua = a
    if ua < 0
        ua = 0 - ua
    let ub = b
    if ub < 0
        ub = 0 - ub
    (ua / g) * ub

// bz_mod_inverse — modular inverse of a mod m.
// Returns the unique inverse in [0, m) when gcd(a,m)==1, else -1.
fn bz_mod_inverse(a: int, m: int) -> int
    let e = bz_egcd(a, m)
    let g = e[0]
    if g != 1
        return -1
    let raw = e[1]
    let r = raw % m
    if r < 0
        r = r + m
    r
