// std/math/easing.nova — animation easing functions.
// All functions map t in [0,1] -> [0,1].
// FLOAT HAZARDS:
//   • Always bind sub-expressions to named `let`s before returning.
//   • Float vs int compare UNSOUND — this module uses only float literals.
//   • abs() mistypes to int — use (0.0-x) for negation when needed.
// LEAF — imports NOTHING.

// ease_linear(t) -> float
// No easing; identity mapping.
fn ease_linear(t: float) -> float
    let r = t * 1.0
    r

// ease_in_quad(t) -> float
// Quadratic ease-in: t^2. Starts slow, accelerates.
fn ease_in_quad(t: float) -> float
    let r = t * t
    r

// ease_out_quad(t) -> float
// Quadratic ease-out: t*(2-t). Starts fast, decelerates.
fn ease_out_quad(t: float) -> float
    let inner = 2.0 - t
    let r = t * inner
    r

// ease_in_out_quad(t) -> float
// Quadratic ease-in-out: symmetric blend of in and out.
// t < 0.5  -> 2*t*t
// t >= 0.5 -> -1 + (4-2*t)*t
fn ease_in_out_quad(t: float) -> float
    if t < 0.5
        let r = 2.0 * t * t
        return r
    let a = 4.0 - 2.0 * t
    let r = -1.0 + a * t
    r

// ease_in_cubic(t) -> float
// Cubic ease-in: t^3. Starts very slow, accelerates sharply.
fn ease_in_cubic(t: float) -> float
    let r = t * t * t
    r

// ease_out_cubic(t) -> float
// Cubic ease-out: (t-1)^3 + 1.
fn ease_out_cubic(t: float) -> float
    let s = t - 1.0
    let r = s * s * s + 1.0
    r

// ease_in_out_cubic(t) -> float
// Cubic ease-in-out.
// t < 0.5 -> 4*t^3
// t >= 0.5 -> (t-1)*(2*t-2)^2 + 1
fn ease_in_out_cubic(t: float) -> float
    if t < 0.5
        let r = 4.0 * t * t * t
        return r
    let s = 2.0 * t - 2.0
    let r = (t - 1.0) * s * s + 1.0
    r

// ease_in_sine(t) -> float
// Sinusoidal ease-in: 1 - cos(t * PI/2).
fn ease_in_sine(t: float) -> float
    let angle = t * pi() / 2.0
    let c = cos(angle)
    let r = 1.0 - c
    r

// ease_out_sine(t) -> float
// Sinusoidal ease-out: sin(t * PI/2).
fn ease_out_sine(t: float) -> float
    let angle = t * pi() / 2.0
    let r = sin(angle)
    r
