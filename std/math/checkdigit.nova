// std/math/checkdigit.nova — Check-digit algorithms.
// Covers Luhn (mod-10, credit cards / ISO 7812) and ISBN-10/13.
// LEAF — imports NOTHING.
//
// Public API:
//   cd_luhn_valid(number_str) -> bool   Luhn/mod-10 check; ignores non-digit chars
//   cd_luhn(partial_digits)   -> int    check digit (0..9) that completes partial_digits
//   cd_isbn10_check(first9)   -> string ISBN-10 check char; weight 10->2 mod 11; "X" for 10
//   cd_isbn10_valid(isbn)     -> bool   10-char string, last char may be 'X'
//   cd_isbn13_check(first12)  -> int    ISBN-13 check digit; alternating weights 1,3; mod 10
//   cd_isbn13_valid(isbn)     -> bool   13-char string, all digits

// ---------- Luhn (mod-10) ----------

// cd_luhn_valid — true iff the digit string passes the Luhn check.
// Non-digit characters are silently ignored (e.g. spaces, dashes).
// Algorithm: from the rightmost digit, every second digit is doubled;
// if doubling produces >9 subtract 9; sum all; valid if sum mod 10 == 0.
fn cd_luhn_valid(number_str: string) -> bool
    // collect digit values into a list
    let digits = []
    let n = len(number_str)
    let i = 0
    while i < n
        let c = char_at(number_str, i)
        let v = ord(c) - 48
        if v >= 0
            if v <= 9
                digits.push(v)
        i = i + 1
    // iterate right-to-left: index 0 = rightmost
    let total = 0
    let dlen = len(digits)
    let j = 0
    while j < dlen
        let d = digits[dlen - 1 - j]
        if j % 2 == 1
            d = d * 2
            if d > 9
                d = d - 9
        total = total + d
        j = j + 1
    total % 10 == 0

// cd_luhn — compute the single check digit (0..9) that, appended to
// partial_digits, produces a string that passes cd_luhn_valid.
// Non-digit characters in partial_digits are ignored.
fn cd_luhn(partial_digits: string) -> int
    // collect digits and append a 0 placeholder for the check position
    let digits = []
    let n = len(partial_digits)
    let i = 0
    while i < n
        let c = char_at(partial_digits, i)
        let v = ord(c) - 48
        if v >= 0
            if v <= 9
                digits.push(v)
        i = i + 1
    digits.push(0)
    // sum with doubling from right (position 0 = the placeholder check digit)
    let total = 0
    let dlen = len(digits)
    let j = 0
    while j < dlen
        let d = digits[dlen - 1 - j]
        if j % 2 == 1
            d = d * 2
            if d > 9
                d = d - 9
        total = total + d
        j = j + 1
    // find check digit that makes (total + check) % 10 == 0
    (10 - total % 10) % 10

// ---------- ISBN-10 ----------

// cd_isbn10_check — compute the check character for a 9-digit ISBN-10 prefix.
// Weights: position i (0-based) gets weight (10 - i), i.e. 10, 9, ... 2.
// Sum mod 11: if remainder is 10 return "X", else return digit string.
fn cd_isbn10_check(first9: string) -> string
    let total = 0
    let i = 0
    while i < 9
        let c = char_at(first9, i)
        let d = ord(c) - 48
        let w = 10 - i
        total = total + d * w
        i = i + 1
    let rem = total % 11
    let chk = (11 - rem) % 11
    if chk == 10
        return "X"
    str(chk)

// cd_isbn10_valid — true iff the 10-character string passes the ISBN-10 check.
// The last character may be 'X' (representing 10).
// Validation: sum of (digit_i * (10-i)) for i=0..9 must be 0 mod 11.
fn cd_isbn10_valid(isbn: string) -> bool
    if len(isbn) != 10
        return false
    let total = 0
    let i = 0
    while i < 9
        let c = char_at(isbn, i)
        let d = ord(c) - 48
        total = total + d * (10 - i)
        i = i + 1
    let last = char_at(isbn, 9)
    if last == "X"
        total = total + 10
    else
        total = total + (ord(last) - 48)
    total % 11 == 0

// ---------- ISBN-13 ----------

// cd_isbn13_check — compute the check digit for a 12-digit ISBN-13 prefix.
// Alternating weights 1 and 3 (position 0 = weight 1, position 1 = weight 3, ...).
// Check digit = (10 - (sum mod 10)) mod 10.
fn cd_isbn13_check(first12: string) -> int
    let total = 0
    let i = 0
    while i < 12
        let c = char_at(first12, i)
        let d = ord(c) - 48
        let w = 1
        if i % 2 == 1
            w = 3
        total = total + d * w
        i = i + 1
    (10 - total % 10) % 10

// cd_isbn13_valid — true iff the 13-character digit string passes the ISBN-13 check.
fn cd_isbn13_valid(isbn: string) -> bool
    if len(isbn) != 13
        return false
    let prefix = slice(isbn, 0, 12)
    let chk = cd_isbn13_check(prefix)
    let last = ord(char_at(isbn, 12)) - 48
    chk == last
