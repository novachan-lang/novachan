// std/math/combinations.nova — generate combinations, permutations, and power-set of a list.
// Elements may be ints or strings (anything NOVA lists hold).
// LEAF — imports NOTHING.
//
// Public API:
//   cm_combinations(xs, k)  -> list  all k-element sublists in lexicographic index order
//   cm_permutations(xs)     -> list  all orderings of xs (n! results)
//   cm_power_set(xs)        -> list  all 2^n subsets including [] and full list
//
// NOTES:
//   cm_combinations([1,2,3], 2)  = [[1,2],[1,3],[2,3]]
//   cm_combinations([1,2,3], 0)  = [[]]
//   cm_combinations([1,2,3], 3)  = [[1,2,3]]
//   len(cm_permutations([1,2,3])) = 6
//   cm_permutations([1,2])        = [[1,2],[2,1]]
//   len(cm_power_set([1,2,3]))    = 8
//   cm_power_set([1])             = [[],[1]]

// _cm_list_copy — build a fresh shallow copy of src to avoid aliasing.
fn _cm_list_copy(src)
    let dst = []
    let i = 0
    let n = len(src)
    while i < n
        dst.push(src[i])
        i += 1
    dst

// _cm_list_swap — swap elements at positions a and b in xs in-place.
fn _cm_list_swap(xs, a, b)
    let tmp = xs[a]
    xs[a] = xs[b]
    xs[b] = tmp

// _cm_comb_idx — index-based recursive backtracking for cm_combinations.
// result  : accumulator (list of sublists) — mutated via push
// xs      : source list
// k       : desired sublist length
// depth   : how many indices have been chosen so far
// indices : scratch list of length k storing chosen indices
// start   : first xs index to consider at this depth
fn _cm_comb_idx(result, xs, k, depth, indices, start)
    let n = len(xs)
    if depth == k
        let sub = []
        for d in 0..k
            sub.push(xs[indices[d]])
        result.push(sub)
        return null
    let need = k - depth
    for i in start..(n - need) + 1
        indices[depth] = i
        _cm_comb_idx(result, xs, k, depth + 1, indices, i + 1)

// cm_combinations(xs, k) -> list of k-element sublists in lexicographic index order.
// k==0  -> [[]]   (one empty subset)
// k>n   -> []     (impossible selection)
fn cm_combinations(xs, k)
    let result = []
    let n = len(xs)
    if k < 0
        return result
    if k > n
        return result
    if k == 0
        result.push([])
        return result
    // pre-allocate scratch index array (values are overwritten before being read)
    let indices = []
    for d in 0..k
        indices.push(0)
    _cm_comb_idx(result, xs, k, 0, indices, 0)
    result

// cm_permutations(xs) -> list of all orderings of xs (n! sublists).
// Uses Heap's algorithm: generates all n! permutations with n!-1 swaps.
// xs itself is NOT modified.
fn cm_permutations(xs)
    let result = []
    let n = len(xs)
    if n == 0
        result.push([])
        return result
    let arr = _cm_list_copy(xs)
    // c[i] tracks the loop counter at recursion depth i in Heap's algorithm
    let c = []
    for ci in 0..n
        c.push(0)
    // record the first permutation
    result.push(_cm_list_copy(arr))
    let i = 0
    while i < n
        if c[i] < i
            if i % 2 == 0
                _cm_list_swap(arr, 0, i)
            else
                _cm_list_swap(arr, c[i], i)
            result.push(_cm_list_copy(arr))
            c[i] += 1
            i = 0
        else
            c[i] = 0
            i += 1
    result

// cm_power_set(xs) -> list of all 2^n subsets ([] through full list).
// Subsets are listed in bitmask order: mask 0 = [], mask 1 = [xs[0]], ..., full.
// Result length is always 2^n (n = len(xs)).
fn cm_power_set(xs)
    let result = []
    let n = len(xs)
    let total = 1 << n
    for mask in 0..total
        let sub = []
        for j in 0..n
            let bit = (mask >> j) & 1
            if bit == 1
                sub.push(xs[j])
        result.push(sub)
    result
