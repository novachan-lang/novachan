// std/math/statistics.nova — basic descriptive statistics over int/float lists.
//
// Every function treats its input list as read-only and returns a fresh
// value; nothing is mutated in place. Empty-list behavior is documented per
// function (never crashes: 0 / 0.0 / [] are used as safe defaults).
//
// Public API (prefix stat_):
//   stat_mean(data)            -> float   arithmetic mean
//   stat_median(data)          -> float   middle value (avg of two middles if even count)
//   stat_mode(data)            -> value   most frequent value; smallest wins ties
//   stat_variance(data)        -> float   population variance (divide by n)
//   stat_stddev(data)          -> float   population standard deviation
//   stat_percentile(data, p)   -> float   0..100 percentile, linear interpolation
//   stat_min_max(data)         -> list    [min, max]
//   stat_describe(data)        -> dict    {count, mean, std, min, max}
//
// LEAF — imports nothing.

// stat_mean: arithmetic mean. Empty list -> 0.0.
fn stat_mean(data: list) -> float
    let n = len(data)
    if n == 0
        return 0.0
    let total = 0.0
    for i in 0..n
        total = total + data[i] * 1.0
    return total / (n * 1.0)

// stat_median: middle element of the sorted list (average of the two middle
// elements when n is even). Empty list -> 0.0.
fn stat_median(data: list) -> float
    let n = len(data)
    if n == 0
        return 0.0
    let s = sort(data)
    if n % 2 == 1
        return s[n / 2] * 1.0
    let a = s[n / 2 - 1] * 1.0
    let b = s[n / 2] * 1.0
    return (a + b) / 2.0

// Private: count how many elements of data equal v.
fn _stat_count_eq(data: list, v) -> int
    let c = 0
    let i = 0
    let n = len(data)
    while i < n
        if data[i] == v
            c = c + 1
        i = i + 1
    return c

// stat_mode: most frequent value. Ties broken by smallest value (numeric
// order, via ascending sort). Empty list -> 0.
fn stat_mode(data: list)
    let n = len(data)
    if n == 0
        return 0
    let s = sort(data)
    let best = s[0]
    let best_count = _stat_count_eq(data, best)
    for i in 1..n
        let v = s[i]
        if v != best
            let c = _stat_count_eq(data, v)
            if c > best_count
                best = v
                best_count = c
    return best

// stat_variance: population variance (mean of squared deviations from the
// mean, divided by n — not n-1). Empty list -> 0.0.
fn stat_variance(data: list) -> float
    let n = len(data)
    if n == 0
        return 0.0
    let m = stat_mean(data)
    let total = 0.0
    for i in 0..n
        let d = data[i] * 1.0 - m
        total = total + d * d
    return total / (n * 1.0)

// stat_stddev: population standard deviation = sqrt(stat_variance(data)).
fn stat_stddev(data: list) -> float
    let v = stat_variance(data)
    return sqrt(v)

// stat_percentile: p-th percentile (0..100) using linear interpolation
// between the two nearest ranks (the same convention as numpy's default
// "linear" method). Empty list -> 0.0. p is accepted untyped so both int
// and float literals work at the call site; it is coerced to float inside.
fn stat_percentile(data: list, p) -> float
    let n = len(data)
    if n == 0
        return 0.0
    let s = sort(data)
    if n == 1
        return s[0] * 1.0
    let pf = p * 1.0
    let idx = (pf / 100.0) * ((n - 1) * 1.0)
    let lo = int(idx)
    if lo < 0
        lo = 0
    if lo >= n - 1
        return s[n - 1] * 1.0
    let frac = idx - (lo * 1.0)
    let v_lo = s[lo] * 1.0
    let v_hi = s[lo + 1] * 1.0
    return v_lo + frac * (v_hi - v_lo)

// Private: min over a non-empty list, via direct comparison (NOT the
// list_min builtin — a generically-typed `list` parameter arrives boxed as
// Any at this call boundary, and list_min/list_max read raw list-cell bits
// without unboxing, which silently returns a boxed handle's pointer value
// instead of the numeric minimum. Direct `<`/`>` comparisons go through the
// proper runtime comparison path and unbox correctly).
fn _stat_min(data: list)
    let m = data[0]
    let i = 1
    let n = len(data)
    while i < n
        if data[i] < m
            m = data[i]
        i = i + 1
    return m

// Private: max over a non-empty list (see _stat_min for why this is
// hand-rolled instead of calling the list_max builtin).
fn _stat_max(data: list)
    let m = data[0]
    let i = 1
    let n = len(data)
    while i < n
        if data[i] > m
            m = data[i]
        i = i + 1
    return m

// stat_min_max: [min, max]. Empty list -> [0, 0].
fn stat_min_max(data: list) -> list
    if len(data) == 0
        return [0, 0]
    let mn = _stat_min(data)
    let mx = _stat_max(data)
    return [mn, mx]

// stat_describe: summary dict with count/mean/std/min/max. Empty list ->
// count=0, mean=0.0, std=0.0, min=0, max=0.
fn stat_describe(data: list) -> dict
    let d = {}
    d["count"] = len(data)
    d["mean"] = stat_mean(data)
    d["std"] = stat_stddev(data)
    if len(data) == 0
        d["min"] = 0
        d["max"] = 0
    else
        d["min"] = _stat_min(data)
        d["max"] = _stat_max(data)
    return d
