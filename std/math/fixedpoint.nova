// std/math/fixedpoint.nova — Fixed-point decimals as scaled integers.
// Scale encodes decimal precision: scale=1000 means 3 decimal places
// (value 1500 represents 1.500). The caller supplies the scale to every
// operation; no hidden global state.
//
// NOVA HAZARDS obeyed:
//   • floor() returns a BOXED float — use float_to_int to get an int.
//   • Float-return Heisenbug: all sub-exprs bound to named lets.
//   • '/' on two ints = INTEGER division (truncates toward zero).
//   • Float vs int compare UNSOUND — coerce with *1.0.
//   • '{' / '}' in string literals INTERPOLATE — avoided entirely.

// ── internal helpers ──────────────────────────────────────────────────────────

// _fp_digits(scale) — number of decimal digits encoded by scale.
// e.g. scale=1000 -> 3, scale=100 -> 2, scale=10 -> 1.
// Uses a counting loop so we never call log10 (avoids float precision risk).
fn _fp_digits(scale: int) -> int
    let d = 0
    let s = scale
    while s > 1
        s = s / 10
        d += 1
    d

// _fp_abs(n) — absolute value of an integer.
fn _fp_abs(n: int) -> int
    if n < 0
        return 0 - n
    n

// _fp_pad_left_zeros(s: string, width: int) — zero-pad s on the left to width.
// Avoids importing std/text (LEAF module).
fn _fp_pad_left_zeros(s: string, width: int) -> string
    let result = s
    let cur = len(s)
    while cur < width
        result = "0" + result
        cur += 1
    result

// ── public API ────────────────────────────────────────────────────────────────

// fp_from_float(x, scale) -> int
// Converts a float to a fixed-point integer with round-half-up.
// Positive: float_to_int(x * scale_f + 0.5)
// Negative: -(float_to_int(-x * scale_f + 0.5))
// We use float_to_int which truncates toward zero, so adding 0.5 before
// truncation achieves round-half-up for positive inputs. For negative inputs
// we negate, round the magnitude, then negate back (round-half-away-from-zero
// for midpoints, consistent with "half-up" in magnitude).
fn fp_from_float(x: float, scale: int) -> int
    let sf = scale * 1.0
    if x < 0.0
        let neg = 0.0 - x
        let shifted = neg * sf + 0.5
        let mag = float_to_int(shifted)
        return 0 - mag
    let shifted = x * sf + 0.5
    let result = float_to_int(shifted)
    result

// fp_from_int(n, scale) -> int
// Converts a plain integer to fixed-point representation.
fn fp_from_int(n: int, scale: int) -> int
    let r = n * scale
    r

// fp_to_float(v, scale) -> float
// Converts a fixed-point integer back to a float.
fn fp_to_float(v: float, scale: float) -> float
    let result = v / scale
    result

// fp_add(a, b) -> int
// Fixed-point addition (same scale, result in same scale).
fn fp_add(a: int, b: int) -> int
    let r = a + b
    r

// fp_sub(a, b) -> int
// Fixed-point subtraction (same scale, result in same scale).
fn fp_sub(a: int, b: int) -> int
    let r = a - b
    r

// fp_mul(a, b, scale) -> int
// Fixed-point multiplication: (a * b) / scale, rounded half-up.
// a and b are both in the same scale, so a*b is in scale^2 — we divide
// by scale once to get back to scale. Rounded: add scale/2 before divide.
fn fp_mul(a: int, b: int, scale: int) -> int
    let raw = a * b
    let half = scale / 2
    let r = (raw + half) / scale
    r

// fp_div(a, b, scale) -> int
// Fixed-point division: (a * scale) / b, rounded half-up.
// Multiply numerator by scale first to keep precision, then divide.
// Rounded half-up: add b/2 to the scaled numerator before integer divide.
fn fp_div(a: int, b: int, scale: int) -> int
    let scaled = a * scale
    let half = b / 2
    let r = (scaled + half) / b
    r

// fp_str(v, scale) -> string
// Human-readable decimal string for a fixed-point value.
// v=1500, scale=1000 -> "1.500"
// v=500,  scale=1000 -> "0.500"
// v=-750, scale=1000 -> "-0.750"
// v=-1500,scale=1000 -> "-1.500"
// Algorithm:
//   1. Determine sign; work with magnitude.
//   2. digits = _fp_digits(scale)
//   3. int_part = abs_v / scale
//   4. frac_part = abs_v % scale  (% = remainder, always >= 0 for positive abs_v)
//   5. Zero-pad frac_part string to `digits` width.
//   6. Reassemble with "." separator; prepend "-" if negative.
fn fp_str(v: int, scale: int) -> string
    let digits = _fp_digits(scale)
    let negative = 0
    if v < 0
        negative = 1
    let abs_v = _fp_abs(v)
    let int_part = abs_v / scale
    let frac_part = abs_v - int_part * scale
    let frac_str = _fp_pad_left_zeros(str(frac_part), digits)
    let body = str(int_part) + "." + frac_str
    if negative == 1
        return "-" + body
    body
