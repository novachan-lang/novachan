// std/math/ts_seasonal.nova — seasonal decomposition helpers for time series.
//
// ts_seasonal_naive(data, period) -> list
//   Forecast each point as the value one period ago (naive seasonal forecast).
//   For indices 0..period-1 (no prior cycle), copies the value from data itself
//   (i.e., the first cycle is used as its own "forecast").
//   Returns a list of the same length as data.
//
// ts_seasonal_mean(data, period) -> list
//   For each seasonal index s in 0..period-1, compute the mean of all data values
//   at positions s, s+period, s+2*period, ...
//   Returns a list of length=period.
//   If period <= 0 or data is empty, returns [].
//
// ts_detrend(data) -> list
//   Subtract a simple linear trend (OLS fit: y = a + b*t, t=0..n-1) from the series.
//   Returns residuals (data[i] - (a + b*i)) as a float list.
//   Empty or single-element -> returns data converted to floats unchanged (no trend).
//   Two-element -> a simple linear fit (result will be symmetric around 0).
//
// LEAF — imports NOTHING.

// ── ts_seasonal_naive ─────────────────────────────────────────────────────────
fn ts_seasonal_naive(data: list, period: int) -> list
    let n = len(data)
    let out = []
    if n == 0
        return out
    if period <= 0
        return out
    let i = 0
    while i < n
        if i < period
            // no prior cycle: use data[i] itself as the "forecast"
            push(out, data[i] * 1.0)
        else
            push(out, data[i - period] * 1.0)
        i += 1
    out

// ── ts_seasonal_mean ──────────────────────────────────────────────────────────
fn ts_seasonal_mean(data: list, period: int) -> list
    let out = []
    let n = len(data)
    if n == 0
        return out
    if period <= 0
        return out
    for s in 0..period
        let sum = 0.0
        let cnt = 0
        let idx = s
        while idx < n
            sum += data[idx] * 1.0
            cnt += 1
            idx += period
        let mean = 0.0
        if cnt > 0
            mean = sum / (cnt * 1.0)
        push(out, mean)
    out

// ── ts_detrend ────────────────────────────────────────────────────────────────
// OLS linear trend: minimise sum of (y_i - a - b*i)^2
//   b = (n*sum(i*y_i) - sum(i)*sum(y_i)) / (n*sum(i^2) - (sum(i))^2)
//   a = (sum(y_i) - b*sum(i)) / n
fn ts_detrend(data: list) -> list
    let n = len(data)
    let out = []
    if n == 0
        return out
    if n == 1
        push(out, data[0] * 1.0)
        return out
    let nf = n * 1.0
    // accumulate sums
    let sum_y = 0.0
    let sum_i = 0.0
    let sum_iy = 0.0
    let sum_i2 = 0.0
    for k in 0..n
        let kf = k * 1.0
        let yk = data[k] * 1.0
        sum_y += yk
        sum_i += kf
        sum_iy += kf * yk
        sum_i2 += kf * kf
    let denom = nf * sum_i2 - sum_i * sum_i
    let b = 0.0
    let a = 0.0
    if denom > 0.0000001 or denom < -0.0000001
        b = (nf * sum_iy - sum_i * sum_y) / denom
        a = (sum_y - b * sum_i) / nf
    // subtract trend
    for m in 0..n
        let trend = a + b * (m * 1.0)
        let residual = data[m] * 1.0 - trend
        push(out, residual)
    out
