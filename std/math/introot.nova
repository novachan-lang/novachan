// std/math/introot.nova
// Exact integer roots — pure integer arithmetic, no float hazards.
// All inputs n >= 0; r >= 1 for ir_inth_root.

// _ir_isqrt_inner: binary search for largest k with k*k <= n, hi is upper bound
fn _ir_isqrt_inner(n: int, hi: int) -> int
    let lo = 0
    let result = 0
    let h = hi
    while lo <= h
        let mid = lo + (h - lo) / 2
        let sq = mid * mid
        if sq <= n
            result = mid
            lo = mid + 1
        else
            h = mid - 1
    result

// ir_isqrt: largest k such that k*k <= n  (n >= 0)
fn ir_isqrt(n: int) -> int
    if n <= 0
        return 0
    let hi = n
    if n >= 4
        hi = n / 2
    _ir_isqrt_inner(n, hi)

// _ipow: k^r for r >= 1, integer exponentiation by squaring
fn _ipow(k: int, r: int) -> int
    if r == 0
        return 1
    let acc = 1
    let base = k
    let exp = r
    while exp > 0
        if (exp & 1) == 1
            acc *= base
        base *= base
        exp /= 2
    acc

// ir_icbrt: largest k such that k*k*k <= n  (n >= 0)
fn ir_icbrt(n: int) -> int
    if n <= 0
        return 0
    // cbrt(n) <= isqrt(n) for all n >= 0, so isqrt gives a valid upper bound
    let hi = ir_isqrt(n)
    let lo = 0
    let result = 0
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        let cu = mid * mid * mid
        if cu <= n
            result = mid
            lo = mid + 1
        else
            hi = mid - 1
    result

// ir_inth_root: largest k such that k^r <= n  (n >= 0, r >= 1)
fn ir_inth_root(n: int, r: int) -> int
    if r <= 0
        return 0
    if r == 1
        return n
    if n <= 0
        return 0
    if n == 1
        return 1
    if r == 2
        return ir_isqrt(n)
    if r == 3
        return ir_icbrt(n)
    // For r >= 4: k^r <= n => k^2 <= n, so isqrt(n) is a valid upper bound
    let hi = ir_isqrt(n)
    let lo = 0
    let result = 0
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        let pw = _ipow(mid, r)
        if pw <= n
            result = mid
            lo = mid + 1
        else
            hi = mid - 1
    result

// ir_is_perfect_square: true iff there exists integer k with k*k == n
fn ir_is_perfect_square(n: int) -> bool
    if n < 0
        return false
    let k = ir_isqrt(n)
    k * k == n

// ir_is_perfect_cube: true iff there exists integer k with k*k*k == n
fn ir_is_perfect_cube(n: int) -> bool
    if n < 0
        return false
    let k = ir_icbrt(n)
    k * k * k == n
