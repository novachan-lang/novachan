// std/math/superfactorial.nova — Superfactorial, hyperfactorial, and primorial.
// LEAF — imports NOTHING.
//
// Public API:
//   sf_factorial(n)  -> int  ordinary n!  (sf_factorial(0)=1; n<0 returns 1)
//   sf_super(n)      -> int  superfactorial = 1!*2!*...*n!  (sf_super(0)=1)
//   sf_hyper(n)      -> int  hyperfactorial = 1^1 * 2^2 * ... * n^n  (sf_hyper(0)=1)
//   sf_primorial(n)  -> int  product of all primes <= n  (sf_primorial(1)=1)
//
// Examples:
//   sf_factorial(5)   = 120
//   sf_super(4)       = 288    (1!*2!*3!*4! = 1*2*6*24)
//   sf_hyper(4)       = 27648  (1^1 * 2^2 * 3^3 * 4^4 = 1*4*27*256)
//   sf_primorial(10)  = 210    (2*3*5*7)
//
// Private helpers use the _sf_ prefix to avoid cross-module symbol collisions.

// _sf_pow_int — compute base^exp for non-negative exp (iterative, O(exp)).
// _sf_pow_int(k, 0) = 1 (empty product).
fn _sf_pow_int(base: int, exp: int) -> int
    if exp <= 0
        return 1
    let result = 1
    let e = exp
    while e > 0
        result *= base
        e -= 1
    result

// _sf_is_prime_sf — trial-division primality test (private, self-contained).
// Returns 1 if prime, 0 otherwise.  n < 2 -> 0.
fn _sf_is_prime_sf(n: int) -> int
    if n < 2
        return 0
    if n == 2
        return 1
    // even numbers > 2 are not prime
    if n % 2 == 0
        return 0
    let i = 3
    let result = 1
    while i * i <= n
        if n % i == 0
            result = 0
        i += 2
    result

// sf_factorial — ordinary factorial n!
// sf_factorial(0) = 1  (empty product)
// sf_factorial(n) = 1 for n < 0  (convention)
// sf_factorial(20) = 2432902008176640000  (largest fitting i64)
fn sf_factorial(n: int) -> int
    if n <= 0
        return 1
    let result = 1
    for k in 2..n + 1
        result *= k
    result

// sf_super — superfactorial sf(n) = product of k! for k = 1..n.
// sf_super(0) = 1  (empty product)
// sf_super(1) = 1! = 1
// sf_super(2) = 1!*2! = 2
// sf_super(3) = 1!*2!*3! = 12
// sf_super(4) = 1!*2!*3!*4! = 288
fn sf_super(n: int) -> int
    if n <= 0
        return 1
    let result = 1
    for k in 1..n + 1
        // compute k! inline and accumulate
        let kfac = 1
        for j in 2..k + 1
            kfac *= j
        result *= kfac
    result

// sf_hyper — hyperfactorial H(n) = product of k^k for k = 1..n.
// sf_hyper(0) = 1  (empty product)
// sf_hyper(1) = 1^1 = 1
// sf_hyper(2) = 1^1 * 2^2 = 4
// sf_hyper(3) = 1^1 * 2^2 * 3^3 = 108
// sf_hyper(4) = 1^1 * 2^2 * 3^3 * 4^4 = 27648
fn sf_hyper(n: int) -> int
    if n <= 0
        return 1
    let result = 1
    for k in 1..n + 1
        let kk = _sf_pow_int(k, k)
        result *= kk
    result

// sf_primorial — product of all prime numbers <= n.
// sf_primorial(0) = 1  (no primes <= 0; empty product)
// sf_primorial(1) = 1  (no primes <= 1; empty product)
// sf_primorial(2) = 2
// sf_primorial(5) = 2*3*5 = 30
// sf_primorial(10) = 2*3*5*7 = 210
fn sf_primorial(n: int) -> int
    if n < 2
        return 1
    let result = 1
    for k in 2..n + 1
        let p = _sf_is_prime_sf(k)
        if p == 1
            result *= k
    result
