// std/math/ts_rolling_mean.nova — rolling (sliding-window) mean for time-series.
// ts_rolling_mean(data, window) -> list
//   Returns the arithmetic mean of each full window of length `window`.
//   Output length = len(data) - window + 1.
//   Window 1 returns the original data as floats.
//   Window == len(data) returns a single-element list with the overall mean.
//   Empty output (window > len(data)): returns empty list.
// LEAF — imports NOTHING.

fn ts_rolling_mean(data: list, window: int) -> list
    let n = len(data)
    let out = []
    if window <= 0
        return out
    if window > n
        return out
    // Compute first window sum
    let wsum = 0.0
    for k in 0..window
        wsum += data[k] * 1.0
    let wf = window * 1.0
    let first_mean = wsum / wf
    push(out, first_mean)
    // Slide: add new element, subtract outgoing element
    for i in window..n
        wsum += data[i] * 1.0 - data[i - window] * 1.0
        let m = wsum / wf
        push(out, m)
    out
