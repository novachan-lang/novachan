// std/math/crt.nova — Chinese Remainder Theorem (general, non-coprime moduli).
// All arithmetic is integer (signed 64-bit). Imports std/math/numtheory for egcd/gcd.
//
// Public API:
//   crt_lcm(a, b)                   -> int   least common multiple
//   crt_solve2(r1,m1,r2,m2)         -> list  [x, M] solving x≡r1(m1), x≡r2(m2);
//                                             [-1,-1] if inconsistent
//   crt_solve(remainders, moduli)   -> list  [x, M] solving the full system;
//                                             [-1,-1] if inconsistent or empty input
//
// Algorithm: merge congruences pairwise using the extended Euclidean algorithm.
//   For x≡r1(mod m1) ∩ x≡r2(mod m2):
//     g = gcd(m1,m2); consistent iff g | (r2-r1)
//     x  = r1 + m1 * ( ((r2-r1)/g) * inv(m1/g, m2/g) mod (m2/g) )
//     M  = lcm(m1,m2) = m1/g * m2
//
// PREFIX: crt_  (avoid cr_ which collides with geometry/circle)

import std/math/numtheory

// crt_egcd — extended Euclidean: returns [g, s, t] with a*s + b*t == g == gcd(a,b).
// Private helper wrapping numtheory.  Kept under crt_ prefix to satisfy naming rules.
fn crt_egcd(a: int, b: int) -> list
    nt_egcd(a, b)

// crt_gcd — greatest common divisor (non-negative).
fn crt_gcd(a: int, b: int) -> int
    nt_gcd(a, b)

// crt_lcm — least common multiple.  lcm(0,*) = 0.
fn crt_lcm(a: int, b: int) -> int
    let u = a
    if u < 0
        u = -u
    let v = b
    if v < 0
        v = -v
    let g = crt_gcd(u, v)
    if g == 0
        return 0
    (u / g) * v

// crt_mod_inv — modular inverse of a mod m; -1 if gcd(a,m) != 1.
fn crt_mod_inv(a: int, m: int) -> int
    let triple = crt_egcd(a, m)
    let g = triple[0]
    let x = triple[1]
    if g != 1
        return -1
    let r = x % m
    if r < 0
        r += m
    r

// crt_solve2 — merge two congruences x≡r1(mod m1) and x≡r2(mod m2).
// Returns [x, M] where x is the smallest non-negative solution and M = lcm(m1,m2),
// or [-1, -1] if the system is inconsistent.
fn crt_solve2(r1: int, m1: int, r2: int, m2: int) -> list
    // g = gcd(m1, m2); need g | (r2 - r1).
    let g = crt_gcd(m1, m2)
    let diff = r2 - r1
    // Consistency check: diff % g must be 0.
    let rem = diff % g
    if rem != 0
        let bad = [-1, -1]
        return bad
    // Reduced moduli: a = m1/g, c = m2/g.
    let a = m1 / g
    let c = m2 / g
    // Find modular inverse of a modulo c.
    let inv_a = crt_mod_inv(a, c)
    // Multiplier k = (diff/g * inv_a) mod c, brought to [0, c).
    let scale = (diff / g) * inv_a
    let k = scale % c
    if k < 0
        k += c
    // Solution: x = r1 + m1 * k, mod M.
    let big_m = crt_lcm(m1, m2)
    let x = r1 + m1 * k
    // Normalise x into [0, big_m).
    let xn = x % big_m
    if xn < 0
        xn += big_m
    let out = [xn, big_m]
    out

// crt_solve — solve a system of n congruences.
// remainders[i] and moduli[i] define x ≡ remainders[i]  (mod moduli[i]).
// Returns [x, M] (smallest non-negative x, combined modulus M = lcm of all moduli),
// or [-1,-1] if the system is inconsistent or if the input lists are empty.
fn crt_solve(remainders: list, moduli: list) -> list
    let n = len(remainders)
    if n == 0
        let empty = [-1, -1]
        return empty
    // Start with the first congruence.
    let cur_r = remainders[0]
    let cur_m = moduli[0]
    let i = 1
    let ok = 1
    while i < n and ok == 1
        let ri = remainders[i]
        let mi = moduli[i]
        let pair = crt_solve2(cur_r, cur_m, ri, mi)
        let pr = pair[0]
        if pr == -1
            ok = 0
        else
            cur_r = pair[0]
            cur_m = pair[1]
        i += 1
    if ok == 0
        let fail = [-1, -1]
        return fail
    let res = [cur_r, cur_m]
    res
