// std/math/harmonic.nova — Classical means and simple statistics for numeric lists.
// All functions accept int or float lists; results are always float.
// Empty list: returns 0.0 (never crashes / divide-by-zero).
// LEAF module — imports NOTHING.
//
// Functions:
//   hm_arithmetic_mean(xs)          — sum/n
//   hm_harmonic_mean(xs)            — n / sum(1/x)
//   hm_geometric_mean(xs)           — exp(sum(ln x)/n) via native log/exp
//   hm_quadratic_mean(xs)           — sqrt(sum(x^2)/n)  [RMS]
//   hm_weighted_mean(xs, weights)   — sum(x*w)/sum(w)

fn hm_arithmetic_mean(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = 0.0
    for i in 0..n
        s = s + xs[i] * 1.0
    let result = s / (n * 1.0)
    result

fn hm_harmonic_mean(xs: list) -> float
    // n / sum(1/x_i); any zero element -> return 0.0 (undefined)
    let n = len(xs)
    if n == 0
        return 0.0
    let inv_sum = 0.0
    for i in 0..n
        let v = xs[i] * 1.0
        if v == 0.0
            return 0.0
        inv_sum = inv_sum + 1.0 / v
    let result = (n * 1.0) / inv_sum
    result

fn hm_geometric_mean(xs: list) -> float
    // exp(sum(ln(x_i)) / n); any non-positive element -> return 0.0 (undefined)
    let n = len(xs)
    if n == 0
        return 0.0
    let log_sum = 0.0
    for i in 0..n
        let v = xs[i] * 1.0
        if v <= 0.0
            return 0.0
        log_sum = log_sum + log(v)
    let result = exp(log_sum / (n * 1.0))
    result

fn hm_quadratic_mean(xs: list) -> float
    // RMS = sqrt(sum(x_i^2) / n)
    let n = len(xs)
    if n == 0
        return 0.0
    let sq_sum = 0.0
    for i in 0..n
        let v = xs[i] * 1.0
        sq_sum = sq_sum + v * v
    let result = sqrt(sq_sum / (n * 1.0))
    result

fn hm_weighted_mean(xs: list, weights: list) -> float
    // sum(x_i * w_i) / sum(w_i); mismatched lengths use min(len); zero total weight -> 0.0
    let n = len(xs)
    let nw = len(weights)
    let k = n
    if nw < k
        k = nw
    if k == 0
        return 0.0
    let num = 0.0
    let den = 0.0
    for i in 0..k
        let v = xs[i] * 1.0
        let w = weights[i] * 1.0
        num = num + v * w
        den = den + w
    if den == 0.0
        return 0.0
    let result = num / den
    result
