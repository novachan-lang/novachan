// std/math/factorials.nova — Factorial family functions (exact 64-bit integers).
// LEAF — imports NOTHING.
//
// Public API:
//   fac_factorial(n)    -> int  n! (0!=1, n<0 returns 1)
//   fac_double(n)       -> int  n!! double factorial: n*(n-2)*...; fac_double(0)=1, fac_double(-1)=1
//   fac_subfactorial(n) -> int  derangements !n: !0=1, !1=0, !n=(n-1)*(!(n-1)+!(n-2))
//   fac_rising(x, n)    -> int  rising factorial x*(x+1)*...*(x+n-1); fac_rising(x,0)=1
//   fac_falling(x, n)   -> int  falling factorial x*(x-1)*...*(x-n+1); fac_falling(x,0)=1
//
// Notes:
//   fac_factorial(5)       = 120
//   fac_factorial(0)       = 1
//   fac_double(5)          = 15  (5*3*1)
//   fac_double(6)          = 48  (6*4*2)
//   fac_subfactorial(4)    = 9
//   fac_subfactorial(0)    = 1
//   fac_rising(5, 2)       = 30  (5*6)
//   fac_falling(5, 2)      = 20  (5*4)
// Private helpers use the _fac_ prefix.

// fac_factorial — n! (ordinary factorial).
// fac_factorial(0) = 1  (empty product)
// fac_factorial(n) for n < 0 returns 1 by convention.
// fac_factorial(20) = 2432902008176640000 (largest that fits in i64).
fn fac_factorial(n: int) -> int
    if n <= 0
        return 1
    let result = 1
    for k in 2..n + 1
        result *= k
    result

// fac_double — n!! (double factorial).
// For n > 0: product of n * (n-2) * (n-4) * ... down to 1 (odd n) or 2 (even n).
// fac_double(0) = 1  (empty product convention)
// fac_double(-1) = 1 (empty product convention)
// fac_double(1) = 1, fac_double(2) = 2, fac_double(5) = 15, fac_double(6) = 48.
fn fac_double(n: int) -> int
    if n <= 0
        return 1
    let result = 1
    let k = n
    while k > 0
        result *= k
        k -= 2
    result

// fac_subfactorial — !n (derangements of n elements).
// !0 = 1, !1 = 0, !n = (n-1) * (!(n-1) + !(n-2)) for n >= 2.
// fac_subfactorial(0) = 1
// fac_subfactorial(1) = 0
// fac_subfactorial(4) = 9
fn fac_subfactorial(n: int) -> int
    if n < 0
        return 0
    if n == 0
        return 1
    if n == 1
        return 0
    // iterative using two accumulators: prev2 = !(k-2), prev1 = !(k-1)
    let prev2 = 1
    let prev1 = 0
    let k = 2
    let cur = 0
    while k <= n
        cur = (k - 1) * (prev1 + prev2)
        prev2 = prev1
        prev1 = cur
        k += 1
    cur

// fac_rising — rising factorial (Pochhammer symbol) x^(n) = x*(x+1)*...*(x+n-1).
// fac_rising(x, 0) = 1 (empty product).
// fac_rising(x, n) for n < 0 returns 1 by convention.
// fac_rising(5, 2) = 5*6 = 30
// fac_rising(3, 4) = 3*4*5*6 = 360
fn fac_rising(x: int, n: int) -> int
    if n <= 0
        return 1
    let result = 1
    for k in 0..n
        result *= (x + k)
    result

// fac_falling — falling factorial x*(x-1)*...*(x-n+1).
// fac_falling(x, 0) = 1 (empty product).
// fac_falling(x, n) for n < 0 returns 1 by convention.
// fac_falling(5, 2) = 5*4 = 20
// fac_falling(6, 3) = 6*5*4 = 120
fn fac_falling(x: int, n: int) -> int
    if n <= 0
        return 1
    let result = 1
    for k in 0..n
        result *= (x - k)
    result
