// std/math/binomial.nova — Binomial coefficients, Pascal's triangle, multinomial coefficient.
// LEAF — imports NOTHING.
//
// Public API:
//   bino_coeff(n, k)       -> int   C(n,k) exact via multiplicative formula; 0 if k<0 or k>n
//   bino_pascal_row(n)     -> list  row n of Pascal's triangle (length n+1, 0-indexed)
//   bino_multinomial(counts) -> int multinomial coefficient (sum)! / prod(ci!)
//   bino_central(n)        -> int   central binomial coefficient C(2n, n)
//
// All results are exact integers (no floating-point rounding).
// PREFIX: bino_   (avoids collision with bn_/cm_ used in other std/math modules)

// _bino_factorial — exact factorial for small n (used only by multinomial).
// n <= 20 fits in i64; caller is responsible for not exceeding that.
fn _bino_factorial(n)
    let result = 1
    let i = 2
    while i <= n
        result = result * i
        i = i + 1
    result

// bino_coeff(n, k) — exact binomial coefficient C(n,k).
// Uses the multiplicative formula:  C(n,k) = prod_{i=0}^{k-1}  (n-i) / (i+1)
// Division is always exact because C(n,k) is always an integer.
// Returns 0 for k < 0 or k > n.
fn bino_coeff(n, k)
    if k < 0
        return 0
    if k > n
        return 0
    // Exploit symmetry: C(n,k) == C(n,n-k); pick the smaller k for fewer iterations.
    let kk = k
    if n - k < kk
        kk = n - k
    let result = 1
    for i in 0..kk
        result = result * (n - i)
        result = result / (i + 1)
    result

// bino_pascal_row(n) — row n of Pascal's triangle as a list of length n+1.
// Row 0 = [1], row 1 = [1,1], row 4 = [1,4,6,4,1], etc.
// Built via the recurrence: row[j] = prev[j-1] + prev[j].
fn bino_pascal_row(n)
    // Start with row 0 = [1].
    let row = []
    row.push(1)
    for r in 0..n
        // Build the next row from the current one.
        let next = []
        next.push(1)
        let j = 1
        let rlen = len(row)
        while j < rlen
            next.push(row[j - 1] + row[j])
            j = j + 1
        next.push(1)
        row = next
    row

// bino_multinomial(counts) — multinomial coefficient (sum of counts)! / product of (ci!).
// counts is a list of non-negative integers.
// Example: bino_multinomial([2,1,1]) = 4! / (2!*1!*1!) = 24 / 2 = 12.
fn bino_multinomial(counts)
    let total = 0
    let nc = len(counts)
    for i in 0..nc
        total = total + counts[i]
    let num = _bino_factorial(total)
    let den = 1
    for j in 0..nc
        den = den * _bino_factorial(counts[j])
    num / den

// bino_central(n) — central binomial coefficient C(2n, n).
// This is the largest value in row 2n of Pascal's triangle.
// Example: bino_central(3) = C(6,3) = 20.
fn bino_central(n)
    bino_coeff(n * 2, n)
