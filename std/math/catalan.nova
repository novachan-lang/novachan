// std/math/catalan.nova — Catalan number utilities (iterative, exact 64-bit integers).
// LEAF — imports NOTHING.
//
// Public API:
//   cat_n(n)     -> int   nth Catalan number (0-indexed): cat_n(0)=1, cat_n(1)=1, cat_n(5)=42
//   cat_list(n)  -> list  first n Catalan numbers [cat_n(0)..cat_n(n-1)]
//   cat_is(n)    -> bool  true iff n is a Catalan number
//
// Implementation: uses the recurrence C(n) = C(n-1) * 2*(2n-1) / (n+1).
// This avoids intermediate factorial blowup: multiply first (always even), then divide exactly.
// Private helpers use the _cn_ prefix to avoid cross-module symbol collisions.

// cat_n — nth Catalan number (0-indexed, iterative).
// Uses the recurrence: C(n) = C(n-1) * 2*(2*n-1) / (n+1).
// C(0)=1, C(1)=1, C(2)=2, C(3)=5, C(4)=14, C(5)=42, C(9)=4862.
// Returns 1 for n <= 0 (treats negative as C(0)).
//
// Hand-trace:
//   start val=1 (C(0))
//   k=1: val = 1 * 2*(2*1-1)/(1+1) = 1 * 2*1/2 = 1   -> C(1)=1
//   k=2: val = 1 * 2*(2*2-1)/(2+1) = 1 * 2*3/3 = 2   -> C(2)=2
//   k=3: val = 2 * 2*(2*3-1)/(3+1) = 2 * 2*5/4 = 5   -> C(3)=5
//   k=4: val = 5 * 2*(2*4-1)/(4+1) = 5 * 2*7/5 = 14  -> C(4)=14
//   k=5: val = 14 * 2*(2*5-1)/(5+1) = 14*2*9/6 = 42  -> C(5)=42
fn cat_n(n: int) -> int
    if n <= 0
        return 1
    let val = 1
    let k = 1
    while k <= n
        val = val * 2 * (2 * k - 1) / (k + 1)
        k = k + 1
    val

// cat_list — list of first n Catalan numbers [cat_n(0), ..., cat_n(n-1)].
// cat_list(0)=[], cat_list(5)=[1,1,2,5,14].
// Iterates the same recurrence, collecting each term.
fn cat_list(n: int) -> list
    let out = []
    if n <= 0
        return out
    push(out, 1)
    if n == 1
        return out
    let val = 1
    let k = 1
    while k < n
        val = val * 2 * (2 * k - 1) / (k + 1)
        k = k + 1
        push(out, val)
    out

// cat_is — true iff n is a Catalan number.
// Strategy: iterate Catalan numbers starting at C(0)=1 until we meet or exceed n.
// If any C(k)==n, return true. If C(k)>n without match, return false.
// cat_is(0)=false (0 is not a Catalan number; smallest is C(0)=1).
// cat_is(1)=true, cat_is(42)=true, cat_is(43)=false.
fn cat_is(n: int) -> bool
    if n <= 0
        return false
    let val = 1
    if n == 1
        return true
    let k = 1
    while val < n
        val = val * 2 * (2 * k - 1) / (k + 1)
        k = k + 1
        if val == n
            return true
    false
