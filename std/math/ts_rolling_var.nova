// std/math/ts_rolling_var.nova — rolling (sliding-window) population variance.
// ts_rolling_var(data, window) -> list
//   Returns the population variance (divide by window, not window-1) of each
//   full sliding window of length `window`.
//   Output length = len(data) - window + 1.
//   Variance of a constant window = 0.0.
//   Window > len(data): returns empty list.
// LEAF — imports NOTHING.

// Compute population variance of data[start .. start+window-1].
// Uses two-pass approach: mean then sum of squared deviations.
fn _tsrv_window_var(data: list, start: int, window: int) -> float
    let wf = window * 1.0
    // Pass 1: sum for mean
    let s = 0.0
    for k in 0..window
        s = s + data[start + k] * 1.0
    let mu = s / wf
    // Pass 2: sum of squared deviations
    let acc = 0.0
    for j in 0..window
        let d = data[start + j] * 1.0 - mu
        acc = acc + d * d
    let v = acc / wf
    v

fn ts_rolling_var(data: list, window: int) -> list
    let n = len(data)
    let out = []
    if window <= 0
        return out
    if window > n
        return out
    let count = n - window + 1
    for i in 0..count
        let v = _tsrv_window_var(data, i, window)
        push(out, v)
    out
