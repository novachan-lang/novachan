// std/math/geo.nova — Geographic calculations on latitude/longitude in degrees.
//
// FLOAT HAZARDS obeyed throughout:
//   • Module-level float consts SILENTLY truncate to int — all consts inside fn bodies.
//   • sqrt()/sin()/cos()/atan2() return boxed floats — ALWAYS bind to a named `let`.
//   • Never return a bare multi-term float expression — single-exit, named result.
//   • ABS OF FLOAT: use (if x<0.0 then (0.0-x) else x) — NOT abs().
//   • float vs int compare is UNSOUND — coerce with *1.0 before comparisons.
//   • NO single-line 'if cond then stmt' — always use a block body.
//
// API:
//   geo_to_radians(deg)                      -> float  degrees -> radians
//   geo_haversine(lat1,lng1,lat2,lng2)       -> float  great-circle distance in km
//   geo_bearing(lat1,lng1,lat2,lng2)         -> float  initial bearing degrees [0..360)
//   geo_midpoint(lat1,lng1,lat2,lng2)        -> list   [midlat, midlng] in degrees

// ── internal: positive fmod so modulo result is always in [0, m) ──────────
fn _geo_fmod_pos(x: float, m: float) -> float
    let q = x / m
    let n = float_to_int(q)
    let nf = n * 1.0
    let sub = nf * m
    let rem = x - sub
    let result = rem
    if rem < 0.0
        let adj = rem + m
        result = adj
    result

// ── public API ────────────────────────────────────────────────────────────

// Convert degrees to radians.
fn geo_to_radians(deg: float) -> float
    let PI = pi()
    let t = deg * PI
    let r = t / 180.0
    r

// Haversine great-circle distance between two (lat, lng) points in degrees.
// Returns distance in kilometres using Earth radius = 6371.0 km.
fn geo_haversine(lat1: float, lng1: float, lat2: float, lng2: float) -> float
    let PI = pi()
    let R = 6371.0
    let rlat1 = lat1 * PI / 180.0
    let rlat2 = lat2 * PI / 180.0
    let dlat = (lat2 - lat1) * PI / 180.0
    let dlng = (lng2 - lng1) * PI / 180.0
    let sdlat2 = dlat / 2.0
    let sdlng2 = dlng / 2.0
    let sinDlat = sin(sdlat2)
    let sinDlng = sin(sdlng2)
    let sinDlatSq = sinDlat * sinDlat
    let sinDlngSq = sinDlng * sinDlng
    let cosLat1 = cos(rlat1)
    let cosLat2 = cos(rlat2)
    let a = sinDlatSq + cosLat1 * cosLat2 * sinDlngSq
    let one_minus_a = 1.0 - a
    let sqrtA = sqrt(a)
    let sqrtB = sqrt(one_minus_a)
    let c = atan2(sqrtA, sqrtB)
    let two_c = c * 2.0
    let dist = R * two_c
    dist

// Initial bearing from (lat1,lng1) to (lat2,lng2) in degrees [0, 360).
// Uses the forward azimuth formula:
//   θ = atan2( sin(Δλ)·cos(φ2), cos(φ1)·sin(φ2) − sin(φ1)·cos(φ2)·cos(Δλ) )
fn geo_bearing(lat1: float, lng1: float, lat2: float, lng2: float) -> float
    let PI = pi()
    let rlat1 = lat1 * PI / 180.0
    let rlat2 = lat2 * PI / 180.0
    let dlng = (lng2 - lng1) * PI / 180.0
    let sinDlng = sin(dlng)
    let cosDlng = cos(dlng)
    let cosLat1 = cos(rlat1)
    let cosLat2 = cos(rlat2)
    let sinLat1 = sin(rlat1)
    let sinLat2 = sin(rlat2)
    let x = sinDlng * cosLat2
    let y = cosLat1 * sinLat2 - sinLat1 * cosLat2 * cosDlng
    let theta = atan2(x, y)
    let deg = theta * 180.0 / PI
    let result = _geo_fmod_pos(deg, 360.0)
    result

// Geographic midpoint of two (lat, lng) points in degrees.
// Converts to Cartesian on unit sphere, averages, converts back.
// Returns [midlat, midlng] in degrees.
fn geo_midpoint(lat1: float, lng1: float, lat2: float, lng2: float) -> list
    let PI = pi()
    let rlat1 = lat1 * PI / 180.0
    let rlat2 = lat2 * PI / 180.0
    let rlng1 = lng1 * PI / 180.0
    let rlng2 = lng2 * PI / 180.0
    let cosLat1 = cos(rlat1)
    let cosLat2 = cos(rlat2)
    let sinLat1 = sin(rlat1)
    let sinLat2 = sin(rlat2)
    let cosLng1 = cos(rlng1)
    let cosLng2 = cos(rlng2)
    let sinLng1 = sin(rlng1)
    let sinLng2 = sin(rlng2)
    let bx = cosLat2 * cosLng2
    let by = cosLat2 * sinLng2
    let midx = cosLat1 * cosLng1 + bx
    let midy = cosLat1 * sinLng1 + by
    let midz = sinLat1 + sinLat2
    let midxSq = midx * midx
    let midySq = midy * midy
    let hyp = sqrt(midxSq + midySq)
    let midlat_r = atan2(midz, hyp)
    let midlng_r = atan2(midy, midx)
    let midlat = midlat_r * 180.0 / PI
    let midlng = midlng_r * 180.0 / PI
    [midlat, midlng]
