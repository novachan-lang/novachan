// std/math/stirling.nova — Stirling numbers of the first and second kind.
// LEAF — imports NOTHING.
//
// Public API:
//   st_second(n, k) -> int
//       Stirling number of the 2nd kind: number of ways to partition n
//       labelled items into k non-empty unlabelled subsets.
//       Recurrence: S(n,k) = k*S(n-1,k) + S(n-1,k-1)
//       Boundary:   S(0,0)=1; S(n,0)=0 for n>0; S(0,k)=0 for k>0; S(n,k)=0 for k>n.
//
//   st_first(n, k) -> int
//       UNSIGNED Stirling number of the 1st kind: number of permutations of n
//       elements with exactly k disjoint cycles.
//       Recurrence: c(n,k) = (n-1)*c(n-1,k) + c(n-1,k-1)
//       Boundary:   c(0,0)=1; c(n,0)=0 for n>0; c(0,k)=0 for k>0; c(n,k)=0 for k>n.
//
//   st_second_row(n) -> list
//       Returns the complete n-th row of the Stirling-2nd-kind triangle as a
//       list of (n+1) integers: [S(n,0), S(n,1), ..., S(n,n)].
//       st_second_row(4) = [0, 1, 7, 6, 1].
//
// Private helpers use the _sti_ prefix (safe; does NOT collide with _st_ in
// std/collections/stack.nova).
//
// Known answers (KAT):
//   st_second(0,0)=1   st_second(3,2)=3   st_second(4,2)=7
//   st_second(5,3)=25  st_second(4,4)=1
//   st_first(3,2)=3    st_first(4,2)=11   st_first(4,1)=6
//   st_second_row(4)=[0,1,7,6,1]

// _sti_s2_table — build a (n+1) x (n+1) DP table for Stirling 2nd kind.
// Table is stored as a list of (n+1) rows, each row a list of (n+1) ints.
// Entry [i][j] = S(i,j).
fn _sti_s2_table(n: int) -> list
    let rows = []
    // allocate rows
    let i = 0
    while i <= n
        let row = []
        let j = 0
        while j <= n
            push(row, 0)
            j = j + 1
        push(rows, row)
        i = i + 1
    // base case: S(0,0) = 1
    let r0 = rows[0]
    r0[0] = 1
    // fill row by row starting at i=1
    let ri = 1
    while ri <= n
        let prev = rows[ri - 1]
        let cur = rows[ri]
        let kk = 1
        while kk <= ri
            let from_same = kk * prev[kk]
            let from_prev = prev[kk - 1]
            cur[kk] = from_same + from_prev
            kk = kk + 1
        ri = ri + 1
    rows

// _sti_s1_table — build a (n+1) x (n+1) DP table for unsigned Stirling 1st kind.
// Entry [i][j] = c(i,j).
fn _sti_s1_table(n: int) -> list
    let rows = []
    // allocate rows
    let i = 0
    while i <= n
        let row = []
        let j = 0
        while j <= n
            push(row, 0)
            j = j + 1
        push(rows, row)
        i = i + 1
    // base case: c(0,0) = 1
    let r0 = rows[0]
    r0[0] = 1
    // fill row by row starting at i=1
    let ri = 1
    while ri <= n
        let prev = rows[ri - 1]
        let cur = rows[ri]
        let kk = 1
        while kk <= ri
            let nminus1 = ri - 1
            let from_same = nminus1 * prev[kk]
            let from_prev = prev[kk - 1]
            cur[kk] = from_same + from_prev
            kk = kk + 1
        ri = ri + 1
    rows

// st_second — Stirling number of the 2nd kind S(n, k).
// Returns 0 for any out-of-range input (k > n, negative, etc.).
fn st_second(n: int, k: int) -> int
    if n < 0
        return 0
    if k < 0
        return 0
    if k > n
        return 0
    let tbl = _sti_s2_table(n)
    let row = tbl[n]
    row[k]

// st_first — unsigned Stirling number of the 1st kind c(n, k).
// Returns 0 for any out-of-range input (k > n, negative, etc.).
fn st_first(n: int, k: int) -> int
    if n < 0
        return 0
    if k < 0
        return 0
    if k > n
        return 0
    let tbl = _sti_s1_table(n)
    let row = tbl[n]
    row[k]

// st_second_row — full n-th row of the Stirling-2nd-kind triangle.
// Returns a list of (n+1) integers: [S(n,0), S(n,1), ..., S(n,n)].
// st_second_row(0) = [1]
// st_second_row(4) = [0, 1, 7, 6, 1]
fn st_second_row(n: int) -> list
    if n < 0
        return []
    let tbl = _sti_s2_table(n)
    let src = tbl[n]
    // return only indices 0..n (the meaningful part)
    let out = []
    let j = 0
    while j <= n
        push(out, src[j])
        j = j + 1
    out
