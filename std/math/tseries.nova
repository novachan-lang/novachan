// std/math/tseries.nova — time series analysis over a list of numbers (int or float).
//
// Conventions:
//   * All inputs are read-only; nothing mutates the caller's list.
//   * Rolling functions (`ts_rolling_*`) only emit a value for FULLY covered windows —
//     output length = len(data) - window + 1 (no NaN-padding: NOVA float has no sentinel
//     NaN that survives round-tripping safely, so a partial window is never emitted).
//     Empty/undersized input (window <= 0 or window > len(data)) returns [].
//   * `ts_diff` / `ts_pct_change` / `ts_seasonal_naive` output length = len(data) - periods
//     (or - season_len); periods/season_len <= 0 or >= len(data) returns [].
//   * `ts_anomaly_*` return a list of INT indices into `data` (ascending), not values.
//   * FLOAT CARE: every element is coerced `* 1.0` on read; every returned float sub-expr
//     is bound to a named `let` before being pushed/returned (see project float-codegen
//     gotchas — never return/push a bare multi-term float expression).
//
// Public API:
//   ts_rolling_mean(data, window)      -> list[float]
//   ts_rolling_var(data, window)       -> list[float]   population variance per window
//   ts_rolling_std(data, window)       -> list[float]
//   ts_rolling_min(data, window)       -> list[float]
//   ts_rolling_max(data, window)       -> list[float]
//   ts_diff(data, periods)             -> list[float]   data[i] - data[i-periods]
//   ts_pct_change(data, periods)       -> list[float]   (data[i]-data[i-periods]) / data[i-periods]
//   ts_seasonal_naive(data, season_len)-> list[float]   forecast[i] = data[i] (value one season back)
//   ts_trend_linear(data)              -> dict {"slope","intercept"}  least-squares fit vs index 0..n-1
//   ts_anomaly_zscore(data, threshold) -> list[int]     indices where |z-score| > threshold
//   ts_anomaly_iqr(data, factor)       -> list[int]     indices outside [Q1-factor*IQR, Q3+factor*IQR]
//   ts_ewma(data, alpha)               -> list[float]   exponentially weighted moving average
//
// LEAF module — imports nothing (deliberately: cross-module float codegen has known
// hazards, see reference_cross_module_float_corruption.md — keep float-heavy math self-contained).

// Private: convert a non-negative float to an integer index by counting loop
// (floor(x) in the NOVA runtime returns a boxed float, not usable as a raw index).
fn _ts_float_to_idx(fval: float) -> int
    let k = 0
    let acc = 0.0
    while acc + 1.0 <= fval
        acc = acc + 1.0
        k = k + 1
    k

// Private: mean of a float-coerced list slice [lo, hi).
fn _ts_slice_mean(data: list, lo: int, hi: int) -> float
    let s = 0.0
    let i = lo
    while i < hi
        s = s + data[i] * 1.0
        i = i + 1
    let count = (hi - lo) * 1.0
    s / count

// Private: population variance of a float-coerced list slice [lo, hi), given its mean.
fn _ts_slice_var(data: list, lo: int, hi: int, mu: float) -> float
    let acc = 0.0
    let i = lo
    while i < hi
        let d = data[i] * 1.0 - mu
        acc = acc + d * d
        i = i + 1
    let count = (hi - lo) * 1.0
    acc / count

// Private: sorted (ascending) copy of a float-coerced list; insertion sort O(n^2).
fn _ts_sorted(xs: list) -> list
    let out = []
    let i = 0
    while i < len(xs)
        let v = xs[i] * 1.0
        push(out, v)
        let j = len(out) - 1
        while j > 0 and out[j - 1] > v
            out[j] = out[j - 1]
            j = j - 1
        out[j] = v
        i = i + 1
    out

// Private: p-th percentile (p in 0..100) of an ALREADY-SORTED float list, linear
// interpolation between adjacent ranks. Mirrors std/math/stats.nova's stats_percentile.
fn _ts_percentile_sorted(sorted: list, p: int) -> float
    let n = len(sorted)
    if n == 0
        return 0.0
    if n == 1
        return sorted[0]
    let rank = p * 1.0 / 100.0 * ((n - 1) * 1.0)
    let lo_i = _ts_float_to_idx(rank)
    let hi_i = lo_i + 1
    if hi_i >= n
        return sorted[n - 1]
    let lo_f = lo_i * 1.0
    let frac = rank - lo_f
    let lo_v = sorted[lo_i]
    let hi_v = sorted[hi_i]
    lo_v + frac * (hi_v - lo_v)

// ── rolling window statistics ────────────────────────────────────────────────

fn ts_rolling_mean(data: list, window: int) -> list
    let out = []
    let n = len(data)
    if window <= 0 or window > n
        return out
    let i = 0
    while i + window <= n
        let m = _ts_slice_mean(data, i, i + window)
        push(out, m)
        i = i + 1
    out

fn ts_rolling_var(data: list, window: int) -> list
    let out = []
    let n = len(data)
    if window <= 0 or window > n
        return out
    let i = 0
    while i + window <= n
        let mu = _ts_slice_mean(data, i, i + window)
        let v = _ts_slice_var(data, i, i + window, mu)
        push(out, v)
        i = i + 1
    out

fn ts_rolling_std(data: list, window: int) -> list
    let out = []
    let n = len(data)
    if window <= 0 or window > n
        return out
    let i = 0
    while i + window <= n
        let mu = _ts_slice_mean(data, i, i + window)
        let v = _ts_slice_var(data, i, i + window, mu)
        let sd = sqrt(v)
        push(out, sd)
        i = i + 1
    out

fn ts_rolling_min(data: list, window: int) -> list
    let out = []
    let n = len(data)
    if window <= 0 or window > n
        return out
    let i = 0
    while i + window <= n
        let m = data[i] * 1.0
        let j = i + 1
        while j < i + window
            let v = data[j] * 1.0
            if v < m
                m = v
            j = j + 1
        push(out, m)
        i = i + 1
    out

fn ts_rolling_max(data: list, window: int) -> list
    let out = []
    let n = len(data)
    if window <= 0 or window > n
        return out
    let i = 0
    while i + window <= n
        let m = data[i] * 1.0
        let j = i + 1
        while j < i + window
            let v = data[j] * 1.0
            if v > m
                m = v
            j = j + 1
        push(out, m)
        i = i + 1
    out

// ── differencing / change ────────────────────────────────────────────────────

// ts_diff: out[k] = data[k+periods] - data[k], for k in 0..(n-periods).
// Output length = n - periods (empty if periods <= 0 or periods >= n).
fn ts_diff(data: list, periods: int) -> list
    let out = []
    let n = len(data)
    if periods <= 0 or periods >= n
        return out
    let i = periods
    while i < n
        let cur = data[i] * 1.0
        let prev = data[i - periods] * 1.0
        let d = cur - prev
        push(out, d)
        i = i + 1
    out

// ts_pct_change: out[k] = (data[i]-data[i-periods]) / data[i-periods], i = k+periods.
// A zero-valued baseline (data[i-periods] == 0) is skipped (no divide-by-zero) —
// no entry is emitted for that position.
fn ts_pct_change(data: list, periods: int) -> list
    let out = []
    let n = len(data)
    if periods <= 0 or periods >= n
        return out
    let i = periods
    while i < n
        let cur = data[i] * 1.0
        let prev = data[i - periods] * 1.0
        if prev != 0.0
            let d = cur - prev
            let pct = d / prev
            push(out, pct)
        i = i + 1
    out

// ts_seasonal_naive: naive seasonal forecast — the forecast for index (i+season_len)
// is simply data[i] (this season repeats last season's value at the same phase).
// Output length = n - season_len (empty if season_len <= 0 or >= n).
fn ts_seasonal_naive(data: list, season_len: int) -> list
    let out = []
    let n = len(data)
    if season_len <= 0 or season_len >= n
        return out
    let i = 0
    while i < n - season_len
        let v = data[i] * 1.0
        push(out, v)
        i = i + 1
    out

// ── trend ─────────────────────────────────────────────────────────────────────

// ts_trend_linear: ordinary least-squares fit of data[i] against index i (0..n-1).
// Returns {"slope": float, "intercept": float}. n<2 returns slope=0.0, intercept
// = data[0] (n==1) or 0.0 (n==0) — the degenerate but non-crashing cases.
fn ts_trend_linear(data: list) -> dict
    let n = len(data)
    if n == 0
        return {"slope": 0.0, "intercept": 0.0}
    if n == 1
        let only = data[0] * 1.0
        return {"slope": 0.0, "intercept": only}
    let x_mean = (n - 1) * 1.0 / 2.0
    let y_mean = _ts_slice_mean(data, 0, n)
    let num = 0.0
    let den = 0.0
    let i = 0
    while i < n
        let xi = i * 1.0
        let yi = data[i] * 1.0
        let dx = xi - x_mean
        let dy = yi - y_mean
        num = num + dx * dy
        den = den + dx * dx
        i = i + 1
    let slope = num / den
    let intercept = y_mean - slope * x_mean
    {"slope": slope, "intercept": intercept}

// ── anomaly detection ────────────────────────────────────────────────────────

// ts_anomaly_zscore: indices where |(x - mean) / population_stddev| > threshold.
// A constant series (stddev == 0) reports no anomalies (no divide-by-zero).
fn ts_anomaly_zscore(data: list, threshold: float) -> list
    let out = []
    let n = len(data)
    if n == 0
        return out
    let mu = _ts_slice_mean(data, 0, n)
    let variance = _ts_slice_var(data, 0, n, mu)
    let sd = sqrt(variance)
    if sd == 0.0
        return out
    let i = 0
    while i < n
        let x = data[i] * 1.0
        let z = (x - mu) / sd
        let az = z
        if az < 0.0
            az = 0.0 - az
        if az > threshold
            push(out, i)
        i = i + 1
    out

// ts_anomaly_iqr: indices outside [Q1 - factor*IQR, Q3 + factor*IQR] (Tukey's fences).
fn ts_anomaly_iqr(data: list, factor: float) -> list
    let out = []
    let n = len(data)
    if n == 0
        return out
    let sorted = _ts_sorted(data)
    let q1 = _ts_percentile_sorted(sorted, 25)
    let q3 = _ts_percentile_sorted(sorted, 75)
    let iqr = q3 - q1
    let margin = factor * iqr
    let lower = q1 - margin
    let upper = q3 + margin
    let i = 0
    while i < n
        let x = data[i] * 1.0
        if x < lower or x > upper
            push(out, i)
        i = i + 1
    out

// ── smoothing ─────────────────────────────────────────────────────────────────

// ts_ewma: exponentially weighted moving average. ewma[0] = data[0];
// ewma[i] = alpha*data[i] + (1-alpha)*ewma[i-1]. Output length == len(data).
fn ts_ewma(data: list, alpha: float) -> list
    let out = []
    let n = len(data)
    if n == 0
        return out
    let prev = data[0] * 1.0
    push(out, prev)
    let i = 1
    while i < n
        let x = data[i] * 1.0
        let one_minus = 1.0 - alpha
        let cur = alpha * x + one_minus * prev
        push(out, cur)
        prev = cur
        i = i + 1
    out
