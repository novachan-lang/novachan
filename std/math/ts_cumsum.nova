// std/math/ts_cumsum.nova — running sum and running product for time-series.
// ts_cumsum(data)  -> list (same length): out[i] = sum of data[0..i]
// ts_cumprod(data) -> list (same length): out[i] = product of data[0..i]
// Empty list -> [].
// LEAF — imports NOTHING.

// Running (cumulative) sum.
fn ts_cumsum(data: list) -> list
    let n = len(data)
    let out = []
    if n == 0
        return out
    let acc = 0.0
    for i in 0..n
        acc += data[i] * 1.0
        push(out, acc)
    out

// Running (cumulative) product.
fn ts_cumprod(data: list) -> list
    let n = len(data)
    let out = []
    if n == 0
        return out
    let acc = 1.0
    for i in 0..n
        acc *= (data[i] * 1.0)
        push(out, acc)
    out
