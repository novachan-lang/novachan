// std/math/ts_ewma.nova — exponentially-weighted moving average (EWMA).
// ts_ewma(data, alpha) -> list (same length as data)
//   y[0] = data[0]
//   y[i] = alpha * data[i] + (1 - alpha) * y[i-1]
// alpha=1.0 -> output equals input.
// alpha=0.0 -> constant first value repeated.
// Empty list -> [].
// LEAF — imports NOTHING.

fn ts_ewma(data: list, alpha: float) -> list
    let n = len(data)
    let out = []
    if n == 0
        return out
    let prev = data[0] * 1.0
    push(out, prev)
    let one_minus = 1.0 - alpha
    for i in 1..n
        let xi = data[i] * 1.0
        let yi = alpha * xi + one_minus * prev
        push(out, yi)
        prev = yi
    out
