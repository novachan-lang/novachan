// std/math/digitalroot.nova — Digital root (iterated digit sum).
// LEAF — imports NOTHING.
//
// Public API:
//   dr_root(n)           -> int   digital root of n (base 10); dr_root(0)==0
//   dr_root_base(n,base) -> int   digital root of n in given base
//   dr_is_mult9(n)       -> bool  true iff n>0 and dr_root(n)==9 (divisible by 9)
//
// The digital root of a non-negative integer n is the single digit obtained by
// repeatedly summing the base-10 digits until one digit remains.
// For base 10: dr_root(0)==0; for n>0, dr_root(n) == 1 + (n-1) % 9.
// For arbitrary base b: dr_root_base(0,b)==0; for n>0, == 1 + (n-1) % (b-1).

// dr_root — digital root of n in base 10.
// Uses the closed-form formula: O(1), no digit iteration needed.
fn dr_root(n: int) -> int
    if n == 0
        return 0
    1 + (n - 1) % 9

// dr_root_base — digital root of n in the given base.
// Requires base >= 2.  For base 10 this is identical to dr_root.
// Closed-form: for n>0, result == 1 + (n-1) % (base-1).
fn dr_root_base(n: int, base: int) -> int
    if n == 0
        return 0
    let period = base - 1
    1 + (n - 1) % period

// dr_is_mult9 — true iff n is a positive multiple of 9.
// A positive integer is divisible by 9 exactly when its digital root equals 9.
// Returns false for n==0 (0 is technically divisible by 9 but is excluded per spec).
fn dr_is_mult9(n: int) -> bool
    if n <= 0
        return false
    dr_root(n) == 9
