// std/math/round.nova — numeric rounding and range helpers.
// Provides: round_to, clamp, sign, lerp.
// LEAF — imports NOTHING.
//
// FLOAT HAZARDS (see NOVA memory):
//   • floor() returns a BOXED float (bitcast i64) — NEVER use as int/index.
//   • Float-return Heisenbug: always bind sub-expressions to named `let`s
//     before returning; never return a bare multi-term float expression.
//   • Float vs int compare is UNSOUND — coerce with *1.0 if mixing.

// Private: compute 10^n as a float (n >= 0). Uses a counting loop to avoid
// integer 10^n overflow risk and any int-to-float coercion unsoundness.
fn _round_scale(places: int) -> float
    let s = 1.0
    let i = 0
    while i < places
        s = s * 10.0
        i = i + 1
    s

// round_to(x, places) — round HALF-UP to N decimal places.
// Algorithm: result = floor(x * scale + 0.5) / scale
// floor() returns a boxed float; we keep everything as float throughout.
fn round_to(x: float, places: int) -> float
    let scale = _round_scale(places)
    let shifted = x * scale + 0.5
    let floored = floor(shifted)
    let result = floored / scale
    result

// clamp(x, lo, hi) — return x bounded to [lo, hi].
// Works for both int and float (no type annotation = polymorphic dispatch).
// Returns exactly lo, hi, or x — same type as input.
fn clamp(x, lo, hi)
    if x < lo
        return lo
    if x > hi
        return hi
    x

// sign(x) -> int: -1 if x < 0, 0 if x == 0, 1 if x > 0.
// Works for int and float inputs via untyped parameter.
// Float zero: 0.0 is neither > 0 nor < 0, returns 0 correctly.
fn sign(x) -> int
    if x > 0
        return 1
    if x < 0
        return -1
    0

// lerp(a, b, t) — linear interpolation: a + (b - a) * t.
// t=0.0 -> a, t=1.0 -> b. Not clamped — extrapolates outside [0,1].
fn lerp(a: float, b: float, t: float) -> float
    let diff = b - a
    let result = a + diff * t
    result
