// std/math/motzkin.nova — Motzkin number utilities (iterative, exact 64-bit integers).
// LEAF — imports NOTHING.
//
// Public API:
//   mz_motzkin(n)  -> int   nth Motzkin number (0-indexed): M(0)=1, M(1)=1, M(2)=2, M(3)=4
//   mz_list(n)     -> list  Motzkin numbers M(0)..M(n) as a list (length n+1)
//
// Recurrence (exact integer, no floats):
//   M(0) = 1, M(1) = 1
//   M(n) = ((2*n+2)*M(n-1) + (3*n-3)*M(n-2)) / (n+2)   for n >= 2
//   The division is always exact.
//
// All private helpers use the mz_ prefix to avoid cross-module symbol collisions.

// mz_motzkin — nth Motzkin number (0-indexed, iterative).
// M(0)=1, M(1)=1, M(2)=2, M(3)=4, M(4)=9, M(5)=21, M(6)=51, M(7)=127.
fn mz_motzkin(n: int) -> int
    if n <= 0
        return 1
    if n == 1
        return 1
    let prev2 = 1
    let prev1 = 1
    let i = 2
    let result = 0
    while i <= n
        let num = (2 * i + 1) * prev1 + (3 * i - 3) * prev2
        let den = i + 2
        result = num / den
        prev2 = prev1
        prev1 = result
        i += 1
    result

// mz_list — list of Motzkin numbers M(0)..M(n) (length n+1).
// mz_list(0)=[1], mz_list(1)=[1,1], mz_list(5)=[1,1,2,4,9,21].
fn mz_list(n: int) -> list
    let out = []
    let i = 0
    while i <= n
        let v = mz_motzkin(i)
        push(out, v)
        i += 1
    out
