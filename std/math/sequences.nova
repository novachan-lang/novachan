// std/math/sequences.nova — classic integer sequences.
// LEAF — imports NOTHING.
//
// Public API:
//   seq_fib(n)          -> int   nth Fibonacci number (0-indexed: fib(0)=0, fib(1)=1)
//   seq_fib_list(n)     -> list  first n Fibonacci numbers as a list
//   seq_lucas(n)        -> int   nth Lucas number (L0=2, L1=1)
//   seq_triangular(n)   -> int   nth triangular number: n*(n+1)/2
//   seq_factorial(n)    -> int   n! (0!=1 by convention)
//   seq_is_fibonacci(x) -> bool  true iff x is a perfect Fibonacci number
//
// All functions expect non-negative integer arguments.

// seq_fib — nth Fibonacci number (0-indexed).
// fib(0)=0, fib(1)=1, fib(n)=fib(n-1)+fib(n-2).
fn seq_fib(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 1
    let a = 0
    let b = 1
    let i = 2
    while i <= n
        let c = a + b
        a = b
        b = c
        i += 1
    b

// seq_fib_list — first n Fibonacci numbers as a list.
// seq_fib_list(0) = [], seq_fib_list(1) = [0], seq_fib_list(7) = [0,1,1,2,3,5,8].
fn seq_fib_list(n: int) -> list
    let result = []
    if n <= 0
        return result
    result.push(0)
    if n == 1
        return result
    result.push(1)
    let i = 2
    let a = 0
    let b = 1
    while i < n
        let c = a + b
        a = b
        b = c
        result.push(b)
        i += 1
    result

// seq_lucas — nth Lucas number (L0=2, L1=1, L(n)=L(n-1)+L(n-2)).
fn seq_lucas(n: int) -> int
    if n <= 0
        return 2
    if n == 1
        return 1
    let a = 2
    let b = 1
    let i = 2
    while i <= n
        let c = a + b
        a = b
        b = c
        i += 1
    b

// seq_triangular — nth triangular number: n*(n+1)/2.
// seq_triangular(0)=0, seq_triangular(1)=1, seq_triangular(5)=15.
fn seq_triangular(n: int) -> int
    n * (n + 1) / 2

// seq_factorial — n! iteratively. seq_factorial(0)=1, seq_factorial(5)=120.
fn seq_factorial(n: int) -> int
    if n <= 0
        return 1
    let result = 1
    let i = 2
    while i <= n
        result = result * i
        i += 1
    result

// _is_perfect_square — returns true iff x is a non-negative perfect square.
// Uses integer Newton's method to find floor(sqrt(x)).
fn _seq_is_perfect_square(x: int) -> bool
    if x < 0
        return false
    if x == 0
        return true
    // Initial guess: x itself (will converge quickly downward)
    let g = x
    let g2 = (g + x / g) / 2
    while g2 < g
        g = g2
        g2 = (g + x / g) / 2
    // g is now floor(sqrt(x))
    g * g == x

// seq_is_fibonacci — true iff x is a Fibonacci number.
// A non-negative integer x is Fibonacci iff 5*x^2+4 or 5*x^2-4 is a perfect square.
fn seq_is_fibonacci(x: int) -> bool
    if x < 0
        return false
    let x2 = x * x
    let a = 5 * x2 + 4
    let b = 5 * x2 - 4
    _seq_is_perfect_square(a) or _seq_is_perfect_square(b)
