// std/math/primitiveroot.nova — Primitive roots and multiplicative order.
// Pure integer arithmetic.  LEAF — imports nothing.
//
// Public API:
//   prt_phi(n)                    -> int   Euler totient phi(n)
//   prt_order(a, n)               -> int   smallest k>0 with a^k ≡ 1 (mod n),
//                                           or -1 if gcd(a,n) != 1
//   prt_is_primitive_root(g, n)   -> bool  true iff order(g,n) == phi(n)
//   prt_smallest(n)               -> int   smallest primitive root mod n,
//                                           or -1 if none exists (or n<2)
//
// PREFIX: prt_   (avoids collision with pr_ used in graph/prim modules)
// All private helpers also carry the prt_ prefix.
//
// OVERFLOW NOTE: prt_modpow uses binary-doubling mulmod so it is correct for
// any modulus up to ~2^62.  Plain arithmetic is safe for inputs up to ~2^62.

// PRIVATE: greatest common divisor via Euclidean algorithm.
fn prt_gcd(a: int, b: int) -> int
    let u = a
    let v = b
    if u < 0
        u = 0 - u
    if v < 0
        v = 0 - v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// PRIVATE: (a * b) mod m via binary doubling (overflow-safe for m < 2^62).
fn prt_mulmod(a: int, b: int, m: int) -> int
    let result = 0
    let x = a % m
    let y = b
    while y > 0
        let bit = y & 1
        if bit == 1
            result = (result + x) % m
        x = (x + x) % m
        y = y / 2
    result

// PRIVATE: modular exponentiation (base^exp) mod m — binary exponentiation.
// exp >= 0, m >= 1.
fn prt_modpow(base: int, exp: int, m: int) -> int
    if m == 1
        return 0
    let result = 1
    let b = base % m
    let e = exp
    while e > 0
        let bit = e & 1
        if bit == 1
            result = prt_mulmod(result, b, m)
        b = prt_mulmod(b, b, m)
        e = e / 2
    result

// prt_phi — Euler's totient function phi(n):
// count of integers k in [1,n] with gcd(k,n)=1.
// phi(0)=0, phi(1)=1, phi(prime p)=p-1.
// Uses the standard product formula over distinct prime factors.
fn prt_phi(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 1
    let result = n
    let m = n
    let p = 2
    while p * p <= m
        if (m % p) == 0
            while (m % p) == 0
                m = m / p
            result = result - result / p
        p = p + 1
    if m > 1
        result = result - result / m
    result

// prt_order — multiplicative order of a modulo n.
// Returns the smallest k > 0 such that a^k ≡ 1 (mod n).
// Returns -1 if gcd(a, n) != 1 (order is undefined in that case).
// For a=1, order is always 1 (1^1 = 1).
fn prt_order(a: int, n: int) -> int
    if n <= 1
        return -1
    let g = prt_gcd(a, n)
    if g != 1
        return -1
    // Compute powers iteratively: current = a^k mod n, stop when current == 1.
    let current = a % n
    let k = 1
    // a % n == 1 immediately means order is 1 (covers a=1 case).
    if current == 1
        return 1
    // Upper bound: order divides phi(n) <= n-1, so we never loop more than n-1 times.
    let limit = n - 1
    let done = 0
    let found = -1
    while done == 0
        current = prt_mulmod(current, a % n, n)
        k = k + 1
        if current == 1
            found = k
            done = 1
        if k > limit
            done = 1
    found

// prt_is_primitive_root — true iff g is a primitive root mod n.
// g is a primitive root iff order(g, n) == phi(n).
// Returns false for n <= 1.
fn prt_is_primitive_root(g: int, n: int) -> bool
    if n <= 1
        return false
    let ph = prt_phi(n)
    let ord = prt_order(g, n)
    if ord == ph
        return true
    return false

// prt_smallest — smallest primitive root modulo n, or -1 if none exists.
// Primitive roots exist only for n = 1, 2, 4, p^k, or 2*p^k (odd prime p).
// This function does NOT check the existence condition — it simply searches
// from g=2 upward and returns -1 if no primitive root is found below n.
// For n < 2 returns -1.
fn prt_smallest(n: int) -> int
    if n < 2
        return -1
    let ph = prt_phi(n)
    let g = 2
    let result = -1
    let done = 0
    while done == 0
        if g >= n
            done = 1
        if done == 0
            let ord = prt_order(g, n)
            if ord == ph
                result = g
                done = 1
            if done == 0
                g = g + 1
    result
