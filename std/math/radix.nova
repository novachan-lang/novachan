// std/math/radix.nova
// Arbitrary-base integer <-> string conversion, base 2..36.
// Digits: 0-9 then a-z (lowercase). Case-insensitive parse.
//
// Public API:
//   rx_to_base(n, base)        -> string  non-negative n in given base; "0" for 0
//   rx_from_base(s, base)      -> int     parse case-insensitive string in given base
//   rx_to_base_signed(n, base) -> string  like rx_to_base but handles n<0 with "-"
//   rx_valid_digit(ch, base)   -> bool    true iff ch is a valid digit in the base

// _rx_digits: the digit alphabet 0-9 a-z
let _rx_digits = "0123456789abcdefghijklmnopqrstuvwxyz"

// _rx_char_val(ch) -> int
// Returns the numeric value of a single digit character (case-insensitive).
// Returns -1 if ch is not a recognised digit.
fn _rx_char_val(ch)
    let lo = lower(ch)
    let i = 0
    let found = -1
    while i < 36
        if char_at(_rx_digits, i) == lo
            found = i
            i = 36
        i += 1
    found

// rx_valid_digit(ch, base) -> bool
// Returns true iff ch is a valid digit for the given base (2..36).
fn rx_valid_digit(ch, base)
    let v = _rx_char_val(ch)
    if v < 0
        false
    else
        v < base

// rx_to_base(n, base) -> string
// Converts non-negative integer n to its string representation in the given base.
// Returns "0" when n == 0. Uses lowercase letters for bases > 10.
// base must be in [2..36].
fn rx_to_base(n, base)
    if n == 0
        "0"
    else
        // Build digits least-significant first, then reverse.
        let digits = []
        let rem = n
        while rem > 0
            let d = rem % base
            digits.push(char_at(_rx_digits, d))
            rem = rem / base
        // reverse by building a string from the end
        let result_parts = []
        let len = len(digits)
        let i = len - 1
        while i >= 0
            push(result_parts, digits[i])
            i -= 1
        let result = join(result_parts, "")
        result

// rx_from_base(s, base) -> int
// Parses a string s representing a non-negative integer in the given base.
// Case-insensitive. Assumes s is non-empty and contains only valid digits.
fn rx_from_base(s, base)
    let n = len(s)
    let result = 0
    for i in 0..n
        let ch = char_at(s, i)
        let v = _rx_char_val(ch)
        result = result * base + v
    result

// rx_to_base_signed(n, base) -> string
// Like rx_to_base but handles negative n by prepending "-".
// n == 0 returns "0"; n > 0 behaves exactly as rx_to_base.
fn rx_to_base_signed(n, base)
    if n < 0
        "-" + rx_to_base(0 - n, base)
    else
        rx_to_base(n, base)
