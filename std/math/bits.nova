// std/math/bits.nova — 32-bit bit manipulation.
// All functions operate on 32-bit values (inputs masked to low 32 bits where
// needed; results always fit in a non-negative NOVA int).
// Uses native builtins: popcount, clz, ctz (all 64-bit), rotl, rotr (64-bit).
// LEAF — imports NOTHING.
//
// Public API:
//   b_rotl32(x, n)       -> int   rotate x left  by n bits (n&31)
//   b_rotr32(x, n)       -> int   rotate x right by n bits (n&31)
//   b_reverse_bits32(x)  -> int   bit-reverse of the low 32 bits of x
//   b_next_pow2(x)       -> int   smallest power-of-2 >= x  (x >= 1)
//   b_is_pow2(x)         -> bool  true iff x is a power of two (x >= 1)
//   b_set_bit(x, i)      -> int   set bit i (0-based) of x
//   b_clear_bit(x, i)    -> int   clear bit i of x
//   b_test_bit(x, i)     -> bool  true iff bit i of x is set
//   b_toggle_bit(x, i)   -> int   flip bit i of x
//   b_lowest_set_bit(x)  -> int   isolate lowest set bit of x (x & -x), 0 if x=0
//
// SHIFT SAFETY: >> in NOVA is arithmetic.  All right-shifts here operate on
// values that have been masked to 32 bits first (top 32 bits of i64 = 0), so
// arithmetic right shift == logical right shift.  No masking after >> needed
// as long as the left operand was masked before the shift.

// Internal constant: 32-bit mask = 2^32 - 1 = 4294967295.
// Inlined directly for clarity.

// b_rotl32 — 32-bit rotate left.
// Strategy: use the native 64-bit rotl on the masked value, then re-mask to 32
// bits.  Alternatively, implement directly so the 32-bit semantics are clear.
// We use the direct formula to keep it self-contained and correct.
fn b_rotl32(x: int, n: int) -> int
    let v = x & 0xFFFFFFFF
    let r = n & 31
    if r == 0
        return v
    let hi = (v << r) & 0xFFFFFFFF
    // v has top 32 bits = 0, so arithmetic >> == logical >>
    let lo = v >> (32 - r)
    hi | lo

// b_rotr32 — 32-bit rotate right.
fn b_rotr32(x: int, n: int) -> int
    let v = x & 0xFFFFFFFF
    let r = n & 31
    if r == 0
        return v
    // v is non-negative (top 32 bits zero), arithmetic >> is logical >>
    let lo = v >> r
    let hi = (v << (32 - r)) & 0xFFFFFFFF
    lo | hi

// b_reverse_bits32 — reverse all 32 bits (classic parallel bit-reversal).
// Uses five swap passes: bits, pairs, nibbles, bytes, half-words.
// All right-shifts are on masked (non-negative) values → arithmetic == logical.
fn b_reverse_bits32(x: int) -> int
    let v = x & 0xFFFFFFFF
    // Swap odd/even bits
    let m1 = 0xAAAAAAAA
    let m2 = 0x55555555
    v = ((v & m1) >> 1) | ((v & m2) << 1)
    v = v & 0xFFFFFFFF
    // Swap adjacent pairs
    let m3 = 0xCCCCCCCC
    let m4 = 0x33333333
    v = ((v & m3) >> 2) | ((v & m4) << 2)
    v = v & 0xFFFFFFFF
    // Swap nibbles
    let m5 = 0xF0F0F0F0
    let m6 = 0x0F0F0F0F
    v = ((v & m5) >> 4) | ((v & m6) << 4)
    v = v & 0xFFFFFFFF
    // Swap bytes
    let m7 = 0xFF00FF00
    let m8 = 0x00FF00FF
    v = ((v & m7) >> 8) | ((v & m8) << 8)
    v = v & 0xFFFFFFFF
    // Swap 16-bit halves
    let lo16 = v >> 16
    let hi16 = (v << 16) & 0xFFFFFFFF
    (lo16 | hi16) & 0xFFFFFFFF

// b_is_pow2 — true iff x (x >= 1) is an exact power of two.
// Classic trick: (x & (x-1)) == 0 when x has exactly one bit set.
fn b_is_pow2(x: int) -> bool
    if x <= 0
        return false
    (x & (x - 1)) == 0

// b_next_pow2 — smallest power of 2 that is >= x.  Requires x >= 1.
// For x that is already a power of 2, returns x.
// Algorithm: if b_is_pow2(x) return x; else count leading zeros in the
// 32-bit representation and shift 1 left by the right amount.
// 32-bit clz(v) = native clz(v) - 32  (since native clz works on 64 bits
// and v has all upper 32 bits = 0, so there are always >= 32 leading zeros).
fn b_next_pow2(x: int) -> int
    if x <= 1
        return 1
    let v = x & 0xFFFFFFFF
    if b_is_pow2(v)
        return v
    // clz64(v) gives the number of leading zeros in the 64-bit representation.
    // For a 32-bit value: clz64(v) = clz32(v) + 32.
    // We want the smallest k such that 2^k >= v.
    // k = 32 - clz32(v) = 32 - (clz64(v) - 32) = 64 - clz64(v).
    let clz64v = clz(v)
    let raw_k = 64 - clz64v
    // Guard: k must be <= 32 for 32-bit results.
    let k = 32 if raw_k > 32 else raw_k
    1 << k

// b_set_bit — set bit i (0-based) of x.
fn b_set_bit(x: int, i: int) -> int
    (x | (1 << (i & 31))) & 0xFFFFFFFF

// b_clear_bit — clear bit i of x.
fn b_clear_bit(x: int, i: int) -> int
    let mask = (1 << (i & 31)) & 0xFFFFFFFF
    // ~mask in 64-bit: flip all 64 bits; then AND with 0xFFFFFFFF to stay in range.
    // Equivalent: use XOR with all-ones mask to invert just the 32 low bits.
    let inv = mask ^ 0xFFFFFFFF
    x & inv & 0xFFFFFFFF

// b_test_bit — true iff bit i of x is set.
fn b_test_bit(x: int, i: int) -> bool
    ((x >> (i & 31)) & 1) == 1

// b_toggle_bit — flip bit i of x.
fn b_toggle_bit(x: int, i: int) -> int
    (x ^ (1 << (i & 31))) & 0xFFFFFFFF

// b_lowest_set_bit — isolate the lowest set bit of x (x & -x).
// Returns 0 if x == 0.  Uses ctz via the native builtin for clarity;
// also correct via direct formula x & (-x) masked to 32 bits.
fn b_lowest_set_bit(x: int) -> int
    if x == 0
        return 0
    let v = x & 0xFFFFFFFF
    // x & -x isolates lowest set bit; -v in 64-bit two's-complement is correct
    // because the low 32 bits of -v equal the two's-complement negation of v.
    (v & (0 - v)) & 0xFFFFFFFF
