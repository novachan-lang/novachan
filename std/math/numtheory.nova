// std/math/numtheory.nova — elementary number theory over integers.
// All functions operate on non-negative integers unless noted.
// LEAF — imports NOTHING.
//
// Public API:
//   nt_gcd(a, b)           -> int          greatest common divisor (Euclidean)
//   nt_lcm(a, b)           -> int          least common multiple
//   nt_egcd(a, b)          -> list [g,x,y] extended Euclidean: g = a*x + b*y
//   nt_mod_pow(base,exp,m) -> int          fast modular exponentiation; overflow-safe
//   nt_mod_inv(a, m)       -> int          modular inverse via egcd; -1 if gcd(a,m)!=1
//   nt_is_prime(n)         -> bool         trial division, 6k±1 skip; O(sqrt n)
//   nt_next_prime(n)       -> int          smallest prime > n
//   nt_factorize(n)        -> list         prime factors ascending, with multiplicity
//   nt_euler_phi(n)        -> int          Euler's totient: count of k in [1,n] with gcd(k,n)=1
//
// OVERFLOW NOTE: nt_mod_pow uses a binary-doubling mulmod so it is correct for
// any modulus up to ~2^62 — no 64-bit overflow.  Plain arithmetic (nt_gcd etc.)
// is safe for inputs up to ~2^62 as well; the runtime uses signed 64-bit ints.

// PRIVATE: safe (a * b) mod m via binary doubling. Correct for m up to ~2^62.
// Uses repeated doubling so no intermediate product exceeds 2*m < 2^63.
fn _nt_mulmod(a: int, b: int, m: int) -> int
    let result = 0
    let x = a % m
    let y = b
    while y > 0
        if (y & 1) == 1
            result = (result + x) % m
        x = (x + x) % m
        y /= 2
    result

// nt_gcd — greatest common divisor, Euclidean algorithm.
// gcd(0,0) = 0. Result is always >= 0.
fn nt_gcd(a: int, b: int) -> int
    let u = a
    let v = b
    if u < 0
        u = -u
    if v < 0
        v = -v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// nt_lcm — least common multiple. lcm(0,*) = 0.
fn nt_lcm(a: int, b: int) -> int
    let g = nt_gcd(a, b)
    if g == 0
        return 0
    let u = a
    if u < 0
        u = -u
    let v = b
    if v < 0
        v = -v
    (u / g) * v

// nt_egcd — extended Euclidean algorithm.
// Returns [g, x, y] such that a*x + b*y == g == gcd(a, b).
// Works for a, b >= 0. If gcd != 1 then x, y may be 0.
fn nt_egcd(a: int, b: int) -> list
    // Iterative extended Euclidean (avoids deep recursion).
    // Uses the standard 2x2 matrix form.
    let old_r = a
    let r = b
    let old_s = 1
    let s = 0
    let old_t = 0
    let t = 1
    while r != 0
        let q = old_r / r
        let tmp_r = r
        r = old_r - q * r
        old_r = tmp_r
        let tmp_s = s
        s = old_s - q * s
        old_s = tmp_s
        let tmp_t = t
        t = old_t - q * t
        old_t = tmp_t
    let out = [old_r, old_s, old_t]
    out

// nt_mod_pow — modular exponentiation: (base ^ exp) mod m.
// exp >= 0, m >= 1. Uses binary exponentiation + overflow-safe mulmod.
fn nt_mod_pow(base: int, exp: int, m: int) -> int
    if m == 1
        return 0
    let result = 1
    let b = base % m
    let e = exp
    while e > 0
        if (e & 1) == 1
            result = _nt_mulmod(result, b, m)
        b = _nt_mulmod(b, b, m)
        e /= 2
    result

// nt_mod_inv — modular multiplicative inverse of a mod m.
// Returns x such that (a * x) % m == 1, or -1 if gcd(a, m) != 1.
fn nt_mod_inv(a: int, m: int) -> int
    let triple = nt_egcd(a, m)
    let g = triple[0]
    let x = triple[1]
    if g != 1
        return -1
    // Bring x into [0, m).
    let r = x % m
    if r < 0
        r += m
    r

// nt_is_prime — primality test via trial division with 6k±1 optimisation.
// O(sqrt n). Correct for all n >= 0.
fn nt_is_prime(n: int) -> bool
    if n < 2
        return false
    if n == 2
        return true
    if n == 3
        return true
    if (n % 2) == 0
        return false
    if (n % 3) == 0
        return false
    // Every prime > 3 is of the form 6k±1. Test i = 6k-1 and 6k+1.
    let i = 5
    while i * i <= n
        if (n % i) == 0
            return false
        if (n % (i + 2)) == 0
            return false
        i += 6
    true

// nt_next_prime — smallest prime strictly greater than n.
fn nt_next_prime(n: int) -> int
    let c = n + 1
    if c < 2
        c = 2
    while not nt_is_prime(c)
        c += 1
    c

// nt_factorize — prime factorisation of n, ascending with multiplicity.
// n=1 -> [], n=0 -> []. Always correct (trial division, O(sqrt n)).
fn nt_factorize(n: int) -> list
    let out = []
    if n < 2
        return out
    let m = n
    // Factor out 2.
    while (m % 2) == 0
        push(out, 2)
        m /= 2
    // Factor out odd numbers starting at 3.
    let i = 3
    while i * i <= m
        while (m % i) == 0
            push(out, i)
            m /= i
        i += 2
    // Remaining factor (prime).
    if m > 1
        push(out, m)
    out

// nt_euler_phi — Euler's totient function: count of k in [1,n] with gcd(k,n)=1.
// phi(1) = 1, phi(0) = 0. Uses the product formula over prime factors.
fn nt_euler_phi(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 1
    let result = n
    let m = n
    let p = 2
    while p * p <= m
        if (m % p) == 0
            // Divide out all copies of p.
            while (m % p) == 0
                m /= p
            // Apply phi factor: result *= (1 - 1/p) = result - result/p.
            result -= result / p
        p += 1
    // If m > 1, m is a remaining prime factor.
    if m > 1
        result -= result / m
    result
