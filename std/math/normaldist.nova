// std/math/normaldist.nova — Normal (Gaussian) distribution functions.
//
// Uses the native `erf` builtin and native `sqrt`/`exp`/`pi()`.
// All functions return float.  Bind intermediate float sub-expressions to lets to avoid
// codegen float-return bugs (see reference_nova_float_codegen_geo_bearing.md).
//
// Public API:
//   nd_pdf(x, mean, sd)       -> float   probability density
//   nd_cdf(x, mean, sd)       -> float   cumulative distribution  [0,1]
//   nd_standard_cdf(z)        -> float   CDF of the standard normal N(0,1)
//   nd_pdf_standard(z)        -> float   PDF of the standard normal N(0,1)
//
// LEAF module — imports nothing.

// nd_pdf: probability density of N(mean, sd) at x.
//   formula: (1 / (sd * sqrt(2*pi))) * exp(-0.5 * ((x-mean)/sd)^2)
fn nd_pdf(x: float, mean: float, sd: float) -> float
    let two_pi = 2.0 * pi()
    let sq = sqrt(two_pi)
    let denom = sd * sq
    let z = (x - mean) / sd
    let exponent = -(0.5 * z * z)
    let e_val = exp(exponent)
    let result = e_val / denom
    result

// nd_cdf: cumulative distribution of N(mean, sd) at x.
//   formula: 0.5 * (1 + erf((x - mean) / (sd * sqrt(2))))
fn nd_cdf(x: float, mean: float, sd: float) -> float
    let sqrt2 = sqrt(2.0)
    let arg = (x - mean) / (sd * sqrt2)
    let e = erf(arg)
    let result = 0.5 * (1.0 + e)
    result

// nd_standard_cdf: CDF of the standard normal N(0,1) at z.
//   formula: 0.5 * (1 + erf(z / sqrt(2)))
fn nd_standard_cdf(z: float) -> float
    let sqrt2 = sqrt(2.0)
    let arg = z / sqrt2
    let e = erf(arg)
    let result = 0.5 * (1.0 + e)
    result

// nd_pdf_standard: PDF of the standard normal N(0,1) at z.
//   formula: (1 / sqrt(2*pi)) * exp(-0.5 * z^2)
fn nd_pdf_standard(z: float) -> float
    let two_pi = 2.0 * pi()
    let denom = sqrt(two_pi)
    let exponent = -(0.5 * z * z)
    let e_val = exp(exponent)
    let result = e_val / denom
    result
