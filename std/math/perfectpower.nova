// std/math/perfectpower.nova — Perfect power detection and decomposition.
// Depends on: std/math/introot  (ir_inth_root, ir_isqrt, ir_icbrt, _ipow, ir_is_perfect_square)
//
// Public API:
//   pp_is(n)             -> bool  true iff n = a^b for some integers a>=2, b>=2
//   pp_decompose(n)      -> list  [base, exp] with smallest base>=2 s.t. base^exp==n (b>=2),
//                                 or [n, 1] if n is not a perfect power (or n<4)
//   pp_is_square(n)      -> bool  true iff n = a^2 for some integer a>=2  (n>=4)
//   pp_is_cube(n)        -> bool  true iff n = a^3 for some integer a>=2  (n>=8)
//   pp_is_power_of(n, base) -> bool  true iff n = base^k for some integer k>=1
//
// Convention: pp_is(n) == false for n < 4.
//
// ALGORITHM:
//   For pp_is / pp_decompose: iterate exponent b from floor(log2(n)) down to 2.
//   For each b, compute k = ir_inth_root(n, b).  If k >= 2 and k^b == n, we have a
//   perfect power.  Iterating from largest b to smallest b ensures we find the
//   representation with the SMALLEST base (most-reduced form), because a smaller base
//   implies a larger exponent.  Example: 64 = 2^6 = 4^3 = 8^2; largest-b search
//   reaches b=6 first and returns [2, 6].
//
//   floor(log2(n)) is computed by counting bit-shifts: the max useful exponent is
//   bounded by 2^b <= n, so b <= log2(n).  We cap at 62 for safety with i64.
//
// KNOWN ANSWERS (hand-traced):
//   pp_is(1)=false   pp_is(4)=true(2^2)  pp_is(8)=true(2^3)
//   pp_is(9)=true(3^2)  pp_is(10)=false  pp_is(16)=true(2^4)
//   pp_decompose(8)=[2,3]  pp_decompose(16)=[2,4]  pp_decompose(10)=[10,1]
//   pp_is_square(16)=true  pp_is_cube(27)=true  pp_is_power_of(81,3)=true

import std/math/introot

// _pp_log2floor: floor(log2(n)) for n >= 1.  Returns 0 for n=1.
// Private helper — unique prefix _pp_ guards against name collisions.
fn _pp_log2floor(n: int) -> int
    let v = n
    let bits = 0
    while v > 1
        v /= 2
        bits += 1
    bits

// _pp_ipow: integer exponentiation k^r for k>=0, r>=0.
// Re-exported locally so this module doesn't expose _ipow (which is private to introot).
fn _pp_ipow(k: int, r: int) -> int
    if r == 0
        return 1
    let acc = 1
    let base = k
    let exp = r
    while exp > 0
        if (exp & 1) == 1
            acc *= base
        base *= base
        exp /= 2
    acc

// pp_is: true iff n is a perfect power (n = a^b, a>=2, b>=2).
// false for n < 4.
fn pp_is(n: int) -> bool
    if n < 4
        return false
    let max_b = _pp_log2floor(n)
    if max_b < 2
        return false
    let b = max_b
    let found = false
    while b >= 2
        let k = ir_inth_root(n, b)
        if k >= 2
            let pw = _pp_ipow(k, b)
            if pw == n
                found = true
                b = 1
            else
                b -= 1
        else
            b -= 1
    found

// pp_decompose: returns [base, exp] — the smallest base>=2 with base^exp==n and exp>=2.
// If no such decomposition exists (n not a perfect power, or n<4), returns [n, 1].
fn pp_decompose(n: int) -> list
    if n < 4
        let fallback = []
        push(fallback, n)
        push(fallback, 1)
        return fallback
    let max_b = _pp_log2floor(n)
    if max_b < 2
        let fallback2 = []
        push(fallback2, n)
        push(fallback2, 1)
        return fallback2
    // Try exponents from largest to smallest: largest exponent = smallest base.
    // Stop at the FIRST match (largest b encountered = smallest base).
    let b = max_b
    let res_base = n
    let res_exp = 1
    while b >= 2
        let k = ir_inth_root(n, b)
        let pw = _pp_ipow(k, b)
        if k >= 2
            if pw == n
                res_base = k
                res_exp = b
                b = 1
            else
                b -= 1
        else
            b -= 1
    let result = []
    push(result, res_base)
    push(result, res_exp)
    result

// pp_is_square: true iff n = a^2 for some integer a>=2 (i.e., n>=4 and perfect square).
fn pp_is_square(n: int) -> bool
    if n < 4
        return false
    let k = ir_isqrt(n)
    if k < 2
        return false
    k * k == n

// pp_is_cube: true iff n = a^3 for some integer a>=2 (i.e., n>=8 and perfect cube).
fn pp_is_cube(n: int) -> bool
    if n < 8
        return false
    let k = ir_icbrt(n)
    if k < 2
        return false
    k * k * k == n

// pp_is_power_of: true iff n = base^k for some integer k>=1.
// Works for base>=2; returns false for base<2 or n<1.
// n==base^1 => k=1 is accepted (k>=1 convention).
fn pp_is_power_of(n: int, base: int) -> bool
    if base < 2
        return false
    if n < 1
        return false
    if n == 1
        return false
    // Repeatedly divide n by base; if we reach 1 exactly, it is a power of base.
    let rem = n
    let ok = false
    let running = true
    while running
        if rem == base
            ok = true
            running = false
        else
            if rem % base != 0
                running = false
            else
                rem /= base
    ok
