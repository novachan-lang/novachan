// std/math/perfectnum.nova — Perfect, abundant, and deficient number classification.
// All functions operate on non-negative integers.
// LEAF — imports NOTHING.
//
// Public API:
//   pn_divisor_sum(n)      -> int   sum of proper divisors of n (1..n-1 that divide n)
//   pn_aliquot(n)          -> int   alias for pn_divisor_sum (aliquot sum)
//   pn_is_perfect(n)       -> bool  divisor_sum == n  (6, 28, 496, 8128, ...)
//   pn_is_abundant(n)      -> bool  divisor_sum >  n  (12, 18, 20, ...)
//   pn_is_deficient(n)     -> bool  divisor_sum <  n  (1, 2, 4, 8, ...)
//   pn_perfects_upto(lim)  -> list  all perfect numbers <= lim, ascending
//
// ALGORITHM: pn_divisor_sum uses trial division to sqrt(n), collecting paired
// divisors in one pass — O(sqrt n) per call.  Each divisor d < n of n yields a
// paired divisor n/d; both are accumulated, with care not to double-count when
// d == n/d (a perfect square) or when the paired quotient equals n itself.
//
// KNOWN ANSWERS (hand-traced):
//   pn_divisor_sum(1)  = 0          (no proper divisors)
//   pn_divisor_sum(6)  = 1+2+3 = 6  (1 divides, pair=6 skip; 2 divides, pair=3; sqrt=2)
//   pn_divisor_sum(12) = 1+2+3+4+6 = 16
//   pn_divisor_sum(28) = 1+2+4+7+14 = 28
//   pn_divisor_sum(8)  = 1+2+4 = 7

// pn_divisor_sum — sum of proper divisors of n (i.e., all divisors except n itself).
// pn_divisor_sum(0) = 0, pn_divisor_sum(1) = 0.
// Uses sqrt trial-division, O(sqrt n).
fn pn_divisor_sum(n: int) -> int
    if n <= 1
        return 0
    // 1 is always a proper divisor for n > 1.
    let total = 1
    // Trial division from 2 up to floor(sqrt(n)).
    let i = 2
    while i * i <= n
        if n % i == 0
            total = total + i
            let pair = n / i
            // The pair is also a divisor; add it unless it equals n (not proper)
            // or it equals i (square root case, already counted).
            if pair != n
                if pair != i
                    total = total + pair
        i = i + 1
    total

// pn_aliquot — aliquot sum: identical to pn_divisor_sum.
// Named alias used in number theory literature.
fn pn_aliquot(n: int) -> int
    pn_divisor_sum(n)

// pn_is_perfect — true iff n equals the sum of its proper divisors.
// Perfect numbers: 6, 28, 496, 8128, 33550336, ...
// pn_is_perfect(0)=false, pn_is_perfect(1)=false.
fn pn_is_perfect(n: int) -> bool
    if n <= 1
        return false
    pn_divisor_sum(n) == n

// pn_is_abundant — true iff the divisor sum strictly exceeds n.
// Abundant numbers: 12, 18, 20, 24, 30, ...
// pn_is_abundant(0)=false, pn_is_abundant(1)=false.
fn pn_is_abundant(n: int) -> bool
    if n <= 1
        return false
    pn_divisor_sum(n) > n

// pn_is_deficient — true iff the divisor sum is strictly less than n.
// Deficient numbers: 1, 2, 3, 4, 5, 7, 8, 9, 10, 11, ...
// pn_is_deficient(0)=false (0 has no meaningful classification here).
// pn_is_deficient(1)=true (divisor_sum(1)=0 < 1).
fn pn_is_deficient(n: int) -> bool
    if n <= 0
        return false
    pn_divisor_sum(n) < n

// pn_perfects_upto — list of all perfect numbers <= lim, in ascending order.
// pn_perfects_upto(0)=[], pn_perfects_upto(6)=[6], pn_perfects_upto(30)=[6,28].
fn pn_perfects_upto(lim: int) -> list
    let result = []
    if lim < 6
        return result
    let k = 6
    while k <= lim
        if pn_is_perfect(k)
            push(result, k)
        k = k + 1
    result
