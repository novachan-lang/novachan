// std/math/figurate.nova — Polygonal / figurate number functions.
// LEAF dependency: imports std/math/introot (for ir_isqrt).
//
// Public API:
//   fg_triangular(k)        -> int   kth triangular number: k*(k+1)/2
//   fg_square(k)            -> int   kth square number: k*k
//   fg_pentagonal(k)        -> int   kth pentagonal number: k*(3k-1)/2
//   fg_hexagonal(k)         -> int   kth hexagonal number: k*(2k-1)
//   fg_is_triangular(n)     -> bool  true iff n is a triangular number
//   fg_is_pentagonal(n)     -> bool  true iff n is a (positive) pentagonal number
//   fg_triangular_index(n)  -> int   k such that fg_triangular(k)==n, or -1
//
// KNOWN ANSWERS (hand-traced):
//   fg_triangular(1)=1   fg_triangular(4)=10   fg_triangular(10)=55
//   fg_square(5)=25
//   fg_pentagonal(3)=3*(9-1)/2=12
//   fg_hexagonal(3)=3*(6-1)=15
//   fg_is_triangular(10)=true  (k=4: 4*5/2=10)
//   fg_is_triangular(11)=false (8*11+1=89, sqrt(89)~9.4, not integer)
//   fg_triangular_index(55)=10 (10*11/2=55)
//
// ALGORITHM for fg_is_triangular(n):
//   n is triangular iff 8n+1 is a perfect square.
//   Proof: k(k+1)/2=n => k^2+k-2n=0 => k=(-1+sqrt(1+8n))/2.
//   Integer solution exists iff discriminant 1+8n is a perfect square.
//
// ALGORITHM for fg_is_pentagonal(n):
//   n is pentagonal iff 24n+1 is a perfect square AND (1+sqrt(24n+1)) % 6 == 0.
//   Proof: k(3k-1)/2=n => 3k^2-k-2n=0 => k=(1+sqrt(1+24n))/6.
//   Positive integer k requires 24n+1 to be a perfect square and 6 | (1+sqrt(24n+1)).
//
// ALGORITHM for fg_triangular_index(n):
//   Compute disc = 1+8n. If disc is a perfect square and (sqrt(disc)-1) % 2 == 0,
//   return (sqrt(disc)-1)/2. Otherwise return -1.

import std/math/introot

// fg_triangular — kth triangular number: k*(k+1)/2.
// fg_triangular(0)=0, fg_triangular(1)=1, fg_triangular(4)=10, fg_triangular(10)=55.
// For k < 0, returns 0.
fn fg_triangular(k: int) -> int
    if k <= 0
        return 0
    k * (k + 1) / 2

// fg_square — kth square number: k*k.
// fg_square(0)=0, fg_square(1)=1, fg_square(5)=25.
// For k < 0, returns k*k (even negative indices yield a positive square).
fn fg_square(k: int) -> int
    k * k

// fg_pentagonal — kth pentagonal number: k*(3k-1)/2.
// fg_pentagonal(1)=1, fg_pentagonal(2)=5, fg_pentagonal(3)=12, fg_pentagonal(4)=22.
// For k <= 0, returns 0.
fn fg_pentagonal(k: int) -> int
    if k <= 0
        return 0
    k * (3 * k - 1) / 2

// fg_hexagonal — kth hexagonal number: k*(2k-1).
// fg_hexagonal(1)=1, fg_hexagonal(2)=6, fg_hexagonal(3)=15, fg_hexagonal(4)=28.
// For k <= 0, returns 0.
fn fg_hexagonal(k: int) -> int
    if k <= 0
        return 0
    k * (2 * k - 1)

// fg_is_triangular — true iff n is a triangular number (n >= 0).
// n is triangular iff 8n+1 is a perfect square.
// fg_is_triangular(0)=true (k=0), fg_is_triangular(1)=true (k=1),
// fg_is_triangular(10)=true (k=4), fg_is_triangular(11)=false.
fn fg_is_triangular(n: int) -> bool
    if n < 0
        return false
    if n == 0
        return true
    let disc = 8 * n + 1
    let s = ir_isqrt(disc)
    s * s == disc

// fg_is_pentagonal — true iff n is a positive pentagonal number.
// n is pentagonal iff 24n+1 is a perfect square AND (1+sqrt(24n+1)) % 6 == 0.
// fg_is_pentagonal(1)=true, fg_is_pentagonal(5)=true, fg_is_pentagonal(12)=true,
// fg_is_pentagonal(11)=false, fg_is_pentagonal(0)=false.
fn fg_is_pentagonal(n: int) -> bool
    if n <= 0
        return false
    let disc = 24 * n + 1
    let s = ir_isqrt(disc)
    if s * s != disc
        return false
    (1 + s) % 6 == 0

// fg_triangular_index — returns k >= 1 such that fg_triangular(k) == n, or -1.
// fg_triangular_index(0)=0 (k=0 case), fg_triangular_index(1)=1,
// fg_triangular_index(10)=4, fg_triangular_index(55)=10, fg_triangular_index(11)=-1.
fn fg_triangular_index(n: int) -> int
    if n < 0
        return -1
    if n == 0
        return 0
    let disc = 8 * n + 1
    let s = ir_isqrt(disc)
    if s * s != disc
        return -1
    let num = s - 1
    if num % 2 != 0
        return -1
    num / 2
