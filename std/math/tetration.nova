// std/math/tetration.nova
// Tetration and hyperoperations for small integer values.
// Private helpers are prefixed _te_ to avoid link collisions.
//
// Public API:
//   te_tetration(a, n)        -> int  a^^n; te_tetration(a,0)=1 by convention
//   te_power_tower(base, h)   -> int  alias for te_tetration
//   te_hyperop(rank, a, b)    -> int  rank 0=successor, 1=add, 2=mul, 3=pow, 4=tetr

// _te_ipow: integer exponentiation base^exp using repeated squaring (exp >= 0).
fn _te_ipow(base, exp)
    let result = 1
    let b = base
    let e = exp
    while e > 0
        let rem = e % 2
        if rem == 1
            result = result * b
        b = b * b
        e = e / 2
    return result

// te_tetration: a^^n (a tetrated to n).
//   a^^0 = 1 by convention.
//   a^^1 = a.
//   a^^n = a ^ (a^^(n-1)) for n > 1.
fn te_tetration(a, n)
    if n == 0
        return 1
    let result = a
    let i = 1
    while i < n
        result = _te_ipow(a, result)
        i = i + 1
    return result

// te_power_tower: alias for te_tetration.
fn te_power_tower(base, height)
    return te_tetration(base, height)

// te_hyperop: hyperoperation hierarchy (Ackermann-based).
//   rank 0: successor = b + 1
//   rank 1: addition  = a + b
//   rank 2: multiplication = a * b
//   rank 3: exponentiation = a ^ b
//   rank 4: tetration = a ^^ b
fn te_hyperop(rank, a, b)
    if rank == 0
        return b + 1
    if rank == 1
        return a + b
    if rank == 2
        return a * b
    if rank == 3
        return _te_ipow(a, b)
    return te_tetration(a, b)
