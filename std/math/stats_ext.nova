// std/math/stats_ext.nova — extended descriptive statistics.
// Distinct from std/math/stats (which has mean/median/stddev/percentile).
// All functions accept int or float lists; results are float (where applicable).
// Empty list: mode returns 0, all float-returning functions return 0.0.
// Covariance uses population formula (divide by n).
// Sample variance / stddev use n-1 denominator (Bessel's correction).
// LEAF — imports NOTHING.

// ── private helpers ──────────────────────────────────────────────────────────

// Convert a non-negative float to an integer index (floor toward 0) without
// calling floor() whose return type interacts poorly with list indexing.
fn _se_float_to_idx(fval: float) -> int
    let k = 0
    let acc = 0.0
    while acc + 1.0 <= fval
        acc = acc + 1.0
        k = k + 1
    k

// Return a new float list sorted ascending (insertion sort; stable; O(n²)).
fn _se_sorted(xs: list) -> list
    let out = []
    for i in 0..len(xs)
        let v = xs[i] * 1.0
        push(out, v)
        let j = len(out) - 1
        while j > 0 and out[j - 1] > v
            out[j] = out[j - 1]
            j = j - 1
        out[j] = v
    out

// Compute the p-th percentile (p in 0..100) of a SORTED float list using
// linear interpolation on the 0-indexed rank. Matches stats_percentile logic.
fn _se_percentile_sorted(s: list, n: int, p: int) -> float
    if n == 1
        return s[0] * 1.0
    let rank = p * 1.0 / 100.0 * ((n - 1) * 1.0)
    let lo_i = _se_float_to_idx(rank)
    let hi_i = lo_i + 1
    if hi_i >= n
        return s[n - 1] * 1.0
    let lo_f = lo_i * 1.0
    let frac = rank - lo_f
    let lo_v = s[lo_i] * 1.0
    let hi_v = s[hi_i] * 1.0
    let result = lo_v + frac * (hi_v - lo_v)
    result

// ── public API ───────────────────────────────────────────────────────────────

// Mode: the most frequent value in xs. Returns the first-encountered winner on
// a tie. Uses int comparison for counting (values are compared via ==).
// Returns 0 on empty list.
fn se_mode(xs: list) -> int
    let n = len(xs)
    if n == 0
        return 0
    let best_val = xs[0]
    let best_cnt = 0
    for i in 0..n
        let candidate = xs[i]
        let cnt = 0
        let j = 0
        while j < n
            if xs[j] == candidate
                cnt = cnt + 1
            j = j + 1
        if cnt > best_cnt
            best_cnt = cnt
            best_val = candidate
    best_val

// Range: max − min as float. Returns 0.0 on empty list.
fn se_range(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let mn = xs[0] * 1.0
    let mx = xs[0] * 1.0
    for i in 1..n
        let v = xs[i] * 1.0
        if v < mn
            mn = v
        if v > mx
            mx = v
    let r = mx - mn
    r

// Sample variance: sum of squared deviations divided by (n−1).
// Returns 0.0 when n ≤ 1.
fn se_variance_sample(xs: list) -> float
    let n = len(xs)
    if n <= 1
        return 0.0
    let s = 0.0
    for i in 0..n
        s = s + xs[i] * 1.0
    let mu = s / (n * 1.0)
    let acc = 0.0
    for j in 0..n
        let d = xs[j] * 1.0 - mu
        acc = acc + d * d
    let vr = acc / ((n - 1) * 1.0)
    vr

// Sample standard deviation: sqrt of sample variance.
fn se_stddev_sample(xs: list) -> float
    let v = se_variance_sample(xs)
    let sd = sqrt(v)
    sd

// Population covariance: E[(X−μX)(Y−μY)] — divide by n.
// Returns 0.0 when either list is empty or lengths differ.
fn se_covariance(xs: list, ys: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    if len(ys) != n
        return 0.0
    let sx = 0.0
    let sy = 0.0
    for i in 0..n
        sx = sx + xs[i] * 1.0
        sy = sy + ys[i] * 1.0
    let mux = sx / (n * 1.0)
    let muy = sy / (n * 1.0)
    let acc = 0.0
    for j in 0..n
        let dx = xs[j] * 1.0 - mux
        let dy = ys[j] * 1.0 - muy
        acc = acc + dx * dy
    let cov = acc / (n * 1.0)
    cov

// Pearson correlation coefficient r = cov(X,Y) / (stddev(X) * stddev(Y)).
// Uses population stddev (consistent with se_covariance).
// Returns 0.0 when stddev is zero (constant input) or lists are empty/mismatched.
fn se_correlation(xs: list, ys: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    if len(ys) != n
        return 0.0
    // compute means
    let sx = 0.0
    let sy = 0.0
    for i in 0..n
        sx = sx + xs[i] * 1.0
        sy = sy + ys[i] * 1.0
    let mux = sx / (n * 1.0)
    let muy = sy / (n * 1.0)
    // compute cov, varX, varY in one pass
    let cov_acc = 0.0
    let vx_acc = 0.0
    let vy_acc = 0.0
    for j in 0..n
        let dx = xs[j] * 1.0 - mux
        let dy = ys[j] * 1.0 - muy
        cov_acc = cov_acc + dx * dy
        vx_acc = vx_acc + dx * dx
        vy_acc = vy_acc + dy * dy
    let denom_sq = vx_acc * vy_acc
    if denom_sq <= 0.0
        return 0.0
    let denom = sqrt(denom_sq)
    let r = cov_acc / denom
    r

// Z-score: (x − mean) / stddev. Returns 0.0 when stddev == 0.0.
fn se_zscore(x: float, mean: float, stddev: float) -> float
    if stddev == 0.0
        return 0.0
    let z = (x - mean) / stddev
    z

// IQR (interquartile range): Q3 − Q1 using 0-indexed linear-interpolation
// percentile (same method as stats_percentile from std/math/stats).
// Returns 0.0 on empty list.
fn se_iqr(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = _se_sorted(xs)
    let q1 = _se_percentile_sorted(s, n, 25)
    let q3 = _se_percentile_sorted(s, n, 75)
    let iqr = q3 - q1
    iqr
