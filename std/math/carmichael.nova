// std/math/carmichael.nova — Carmichael numbers and Carmichael function.
// All functions operate on positive integers (n >= 1) unless noted.
// LEAF — imports NOTHING.
//
// Public API:
//   cm_is_carmichael(n) -> bool  true iff n is a Carmichael number:
//                                composite, squarefree, and for every prime factor p
//                                of n, (p-1) divides (n-1). (Korselt's criterion.)
//   cm_lambda(n)        -> int   Carmichael function λ(n): the smallest positive m
//                                such that a^m ≡ 1 (mod n) for all gcd(a,n)=1.
//                                Rules: λ(1)=1; λ(2)=1; λ(4)=2; λ(2^k)=2^(k-2) k>=3;
//                                λ(p^k)=p^(k-1)*(p-1) for odd prime p;
//                                λ(n)=lcm of λ over prime-power factors.
//   cm_list(limit)      -> list  all Carmichael numbers in [1, limit], ascending.
//
// ALGORITHM for cm_is_carmichael:
//   1. n must be composite (not prime, not 1).
//   2. Trial-divide n collecting distinct primes. While dividing, check squarefreeness:
//      if any prime divides n more than once, return false immediately.
//   3. For each distinct prime p found, check (n-1) % (p-1) == 0.
//
// ALGORITHM for cm_lambda:
//   Trial-divide n into prime powers p^k. For each:
//     - p=2, k=1: contributes 1
//     - p=2, k=2: contributes 2
//     - p=2, k>=3: contributes 2^(k-2)  (computed via cm_pow2k)
//     - odd p, any k: contributes p^(k-1) * (p-1)  (Euler's φ(p^k))
//   Take lcm of all contributions. lcm(a,b) = a/gcd(a,b)*b.
//
// KNOWN ANSWERS (hand-verified):
//   cm_is_carmichael(561)  = true   561=3*11*17; (3-1)=2|560, (11-1)=10|560, (17-1)=16|560
//   cm_is_carmichael(1105) = true   1105=5*13*17; 4|1104, 12|1104, 16|1104
//   cm_is_carmichael(1729) = true   1729=7*13*19; 6|1728, 12|1728, 18|1728
//   cm_is_carmichael(560)  = false  560=2^4*5*7, not squarefree
//   cm_is_carmichael(7)    = false  7 is prime, not composite
//   cm_lambda(1)  = 1
//   cm_lambda(8)  = 2    8=2^3; λ(2^3)=2^(3-2)=2
//   cm_lambda(15) = 4    15=3*5; lcm(λ(3),λ(5))=lcm(φ(3),φ(4))=lcm(2,4)=4

// PRIVATE: integer gcd via Euclidean algorithm.
fn cm_gcd(a: int, b: int) -> int
    let u = a
    let v = b
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// PRIVATE: integer lcm. Returns 0 if either input is 0.
fn cm_lcm(a: int, b: int) -> int
    if a == 0
        return 0
    if b == 0
        return 0
    let g = cm_gcd(a, b)
    (a / g) * b

// PRIVATE: integer power p^(k-1) for odd prime p, exponent k>=1.
// Used in Euler phi: phi(p^k) = p^(k-1) * (p-1).
// For k=1, p^0 = 1, so phi(p) = p-1 as expected.
fn cm_pow_km1(p: int, k: int) -> int
    let result = 1
    let e = k - 1
    let base = p
    while e > 0
        if (e % 2) == 1
            result = result * base
        base = base * base
        e = e / 2
    result

// PRIVATE: 2^(k-2) for k >= 2, used for λ(2^k).
fn cm_pow2_km2(k: int) -> int
    let result = 1
    let e = k - 2
    while e > 0
        result = result * 2
        e -= 1
    result

// PRIVATE: check whether n is prime via 6k+/-1 trial division.
fn cm_is_prime(n: int) -> bool
    if n < 2
        return false
    if n == 2
        return true
    if n == 3
        return true
    if (n % 2) == 0
        return false
    if (n % 3) == 0
        return false
    let i = 5
    while i * i <= n
        if (n % i) == 0
            return false
        if (n % (i + 2)) == 0
            return false
        i += 6
    true

// cm_is_carmichael — Korselt's criterion.
// Returns true iff n is composite, squarefree, and (p-1)|(n-1) for every prime factor p.
// cm_is_carmichael(1) = false (1 is not composite).
// cm_is_carmichael(<prime>) = false (primes are not composite).
fn cm_is_carmichael(n: int) -> bool
    if n < 2
        return false
    // Primes are not Carmichael numbers.
    if cm_is_prime(n)
        return false
    // Now check Korselt's criterion via trial factorisation.
    let m = n
    let nm1 = n - 1
    let ok = true
    // Check factor 2.
    if (m % 2) == 0
        m = m / 2
        // If 2 still divides m, then 4 | n — not squarefree.
        if (m % 2) == 0
            ok = false
        // Korselt for p=2: (2-1)=1 always divides nm1, no check needed.
    // Check odd factors starting at 3.
    let p = 3
    while p * p <= m
        if ok
            if (m % p) == 0
                m = m / p
                // Squarefree check: p must not divide m again.
                if (m % p) == 0
                    ok = false
                // Korselt: (p-1) must divide (n-1).
                if ok
                    if (nm1 % (p - 1)) != 0
                        ok = false
        p += 2
    // Remaining m > 1 is a prime factor (necessarily distinct, appears once).
    if ok
        if m > 1
            if (nm1 % (m - 1)) != 0
                ok = false
    ok

// cm_lambda — Carmichael function λ(n).
// λ(1) = 1. For prime powers: see algorithm above. For composites: lcm of prime powers.
fn cm_lambda(n: int) -> int
    if n == 1
        return 1
    let m = n
    let result = 1
    // Handle factor of 2 separately (special cases for 2, 4, 2^k k>=3).
    if (m % 2) == 0
        let k2 = 0
        while (m % 2) == 0
            m = m / 2
            k2 += 1
        // λ(2^1) = 1, λ(2^2) = 2, λ(2^k) = 2^(k-2) for k>=3.
        let contrib2 = 1
        if k2 == 2
            contrib2 = 2
        if k2 >= 3
            contrib2 = cm_pow2_km2(k2)
        result = cm_lcm(result, contrib2)
    // Handle odd prime factors.
    let p = 3
    while p * p <= m
        if (m % p) == 0
            let kp = 0
            while (m % p) == 0
                m = m / p
                kp += 1
            // φ(p^k) = p^(k-1) * (p-1).
            let contrib = cm_pow_km1(p, kp) * (p - 1)
            result = cm_lcm(result, contrib)
        p += 2
    // Remaining m > 1 is a prime (exponent 1): φ(p^1) = p - 1.
    if m > 1
        result = cm_lcm(result, m - 1)
    result

// cm_list — all Carmichael numbers in [1, limit], in ascending order.
// cm_list(560) = [], cm_list(561) = [561], cm_list(1000) = [561].
fn cm_list(limit: int) -> list
    let out = []
    if limit < 561
        return out
    // Carmichael numbers are odd and >= 561. Check from 561 upward, step 2.
    let k = 561
    while k <= limit
        if cm_is_carmichael(k)
            push(out, k)
        k += 2
    out
