// std/math/ts_autocorr.nova — Pearson autocorrelation at a given lag.
// ts_autocorr(data, lag) -> float
//   Uses the standard time-series ACF formula:
//     r(lag) = [sum_{t=0}^{n-lag-1} (x_t - mu)(x_{t+lag} - mu) / n]
//              / [sum_{t=0}^{n-1} (x_t - mu)^2 / n]
//   where mu is the global mean of the full series and n is the full length.
//   lag=0  -> always 1.0 (series correlated with itself at zero shift).
//   lag>=n -> 0.0 (not enough data).
//   constant series -> 0.0 (variance is zero; documented convention).
// LEAF — imports NOTHING.

fn ts_autocorr(data: list, lag: int) -> float
    let n = len(data)
    if lag == 0
        return 1.0
    if lag >= n
        return 0.0
    // compute global mean
    let sum = 0.0
    let i = 0
    while i < n
        sum = sum + data[i] * 1.0
        i = i + 1
    let nf = n * 1.0
    let mu = sum / nf
    // compute global variance (denominator)
    let var_g = 0.0
    let j = 0
    while j < n
        let d = data[j] * 1.0 - mu
        var_g = var_g + d * d
        j = j + 1
    // guard: constant series
    if var_g < 0.0000001
        return 0.0
    // compute lagged covariance numerator (n-lag pairs, divide by n)
    let cov = 0.0
    let k = 0
    while k < n - lag
        let dx = data[k] * 1.0 - mu
        let dy = data[k + lag] * 1.0 - mu
        cov = cov + dx * dy
        k = k + 1
    // r = (cov/n) / (var_g/n) = cov / var_g
    let r = cov / var_g
    r
