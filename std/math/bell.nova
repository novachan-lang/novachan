// std/math/bell.nova — Bell numbers via the Bell triangle.
// LEAF — imports NOTHING.
//
// Public API:
//   bell(n)          -> int   nth Bell number (0-indexed): bell(0)=1, bell(1)=1, bell(5)=52
//   bell_list(n)     -> list  [bell(0), bell(1), ..., bell(n-1)]
//   bell_triangle(n) -> list  list of n rows; row k is a list of k+1 ints
//
// Bell triangle construction (Aitken's array):
//   row 0 = [1]
//   each new row r starts with the LAST element of row r-1,
//   then each next element = (prev in current row) + (element directly above in row r-1,
//   same column index).
//   The first element of row r is bell(r).
//
// Example (rows 0..4):
//   [1]
//   [1, 2]
//   [2, 3, 5]
//   [5, 7, 10, 15]
//   [15, 20, 27, 37, 52]
//   bell(0)=1, bell(1)=1, bell(2)=2, bell(3)=5, bell(4)=15, bell(5)=52, bell(6)=203
//
// Private helpers use the _bl_ prefix.

// _bl_row_next — given prev_row (a list of length L), produce next row (length L+1).
// New row starts with last element of prev_row; each subsequent element (position j, 1-indexed)
// equals (new[j-1] + prev[j-1]).  Total elements = L+1.
//
// Example: prev=[1] (L=1)
//   new[0] = prev[0] = 1
//   j=1: new[1] = new[0] + prev[0] = 1+1 = 2
//   -> [1, 2]
//
// Example: prev=[1,2] (L=2)
//   new[0] = prev[1] = 2
//   j=1: new[1] = new[0] + prev[0] = 2+1 = 3
//   j=2: new[2] = new[1] + prev[1] = 3+2 = 5
//   -> [2, 3, 5]
fn _bl_row_next(prev_row: list) -> list
    let plen = len(prev_row)
    let row = []
    // start with last element of previous row
    let first = prev_row[plen - 1]
    push(row, first)
    // add plen more elements: new[j] = new[j-1] + prev[j-1], for j = 1..plen
    let i = 1
    while i <= plen
        let cur_len = len(row)
        let left = row[cur_len - 1]
        let above = prev_row[i - 1]
        push(row, left + above)
        i += 1
    row

// bell_triangle — build the first n rows of the Bell triangle.
// Returns a list of n lists. Row k has k+1 elements.
// bell_triangle(0) = []
// bell_triangle(1) = [[1]]
// bell_triangle(3) = [[1],[1,2],[2,3,5]]
fn bell_triangle(n: int) -> list
    let tri = []
    if n <= 0
        return tri
    let row0 = []
    push(row0, 1)
    push(tri, row0)
    for k in 1..n
        let prev = tri[k - 1]
        let next = _bl_row_next(prev)
        push(tri, next)
    tri

// bell — nth Bell number (0-indexed).
// bell(0)=1, bell(1)=1, bell(2)=2, bell(3)=5, bell(4)=15, bell(5)=52, bell(6)=203.
// For n<0 returns 1 (same as bell(0)).
fn bell(n: int) -> int
    if n <= 0
        return 1
    // build triangle up to row n; bell(n) = first element of row n
    let tri = bell_triangle(n + 1)
    let row = tri[n]
    row[0]

// bell_list — list of first n Bell numbers [bell(0), ..., bell(n-1)].
// bell_list(0)=[], bell_list(1)=[1], bell_list(5)=[1,1,2,5,15].
fn bell_list(n: int) -> list
    let out = []
    if n <= 0
        return out
    // build the full triangle and collect first elements of each row
    let tri = bell_triangle(n)
    for k in 0..n
        let row = tri[k]
        push(out, row[0])
    out
