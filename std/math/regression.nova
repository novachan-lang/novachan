// std/math/regression.nova — simple least-squares linear regression over float lists.
// reg_linear(xs, ys) -> [slope, intercept]  (list of 2 floats)
// reg_r2(xs, ys)     -> float               (coefficient of determination R²)
// reg_predict(slope, intercept, x) -> float
//
// All inputs are coerced to float via *1.0.
// Empty or single-element lists return [0.0, 0.0] / 0.0 (never crash).
// LEAF — imports NOTHING.
//
// Float-codegen safety: every sub-expression bound to a named let before return.
// ABS OF FLOAT: uses if/else pattern (never abs()).
// Module-level float constants forbidden — all literals are inline.

// Private: compute the mean of a list as float.
fn _reg_mean(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = 0.0
    let i = 0
    while i < n
        s = s + xs[i] * 1.0
        i = i + 1
    let result = s / (n * 1.0)
    result

// reg_linear: ordinary least-squares slope and intercept.
// Returns a list [slope, intercept].
// Formula:
//   slope     = sum((xi - mx)(yi - my)) / sum((xi - mx)^2)
//   intercept = my - slope * mx
// Degenerate (zero variance in x): returns [0.0, mean(y)].
fn reg_linear(xs: list, ys: list) -> list
    let n = len(xs)
    if n == 0
        return [0.0, 0.0]
    if n == 1
        let y0 = ys[0] * 1.0
        return [0.0, y0]
    let mx = _reg_mean(xs)
    let my = _reg_mean(ys)
    let num = 0.0
    let den = 0.0
    let i = 0
    while i < n
        let dx = xs[i] * 1.0 - mx
        let dy = ys[i] * 1.0 - my
        num = num + dx * dy
        den = den + dx * dx
        i = i + 1
    if den == 0.0
        return [0.0, my]
    let slope = num / den
    let intercept = my - slope * mx
    [slope, intercept]

// reg_predict: apply a fitted line to a new x value.
fn reg_predict(slope: float, intercept: float, x: float) -> float
    let xf = x * 1.0
    let result = slope * xf + intercept
    result

// reg_r2: coefficient of determination R².
// R² = 1 - SS_res / SS_tot
// SS_res = sum((yi - y_hat_i)^2)
// SS_tot = sum((yi - my)^2)
// Perfect fit -> 1.0; degenerate (zero SS_tot) -> 1.0 if SS_res also 0, else 0.0.
fn reg_r2(xs: list, ys: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let coeffs = reg_linear(xs, ys)
    let slope = coeffs[0] * 1.0
    let intercept = coeffs[1] * 1.0
    let my = _reg_mean(ys)
    let ss_res = 0.0
    let ss_tot = 0.0
    let i = 0
    while i < n
        let yi = ys[i] * 1.0
        let xi = xs[i] * 1.0
        let y_hat = slope * xi + intercept
        let res = yi - y_hat
        let tot = yi - my
        let res_abs = 0.0
        if res < 0.0
            res_abs = 0.0 - res
        else
            res_abs = res
        let tot_abs = 0.0
        if tot < 0.0
            tot_abs = 0.0 - tot
        else
            tot_abs = tot
        ss_res = ss_res + res * res
        ss_tot = ss_tot + tot * tot
        i = i + 1
    if ss_tot == 0.0
        if ss_res == 0.0
            return 1.0
        return 0.0
    let r2 = 1.0 - ss_res / ss_tot
    r2
