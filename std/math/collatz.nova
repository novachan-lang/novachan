// std/math/collatz.nova — Collatz (3n+1) conjecture utilities.
// LEAF — imports NOTHING.
//
// Public API:
//   col_steps(n)        -> int   number of steps to reach 1; col_steps(1)=0
//   col_seq(n)          -> list  full sequence from n down to 1 inclusive
//   col_max(n)          -> int   peak value reached in the Collatz sequence of n
//   col_steps_upto(lim) -> list  list of col_steps(k) for k in 1..lim inclusive
//
// All functions use pure integer arithmetic.
// Even step: n/2   Odd step: 3*n+1
// Private helpers use the _cz_ prefix to avoid cross-module symbol collisions.

// col_steps — number of steps to reach 1 from n.
// col_steps(1)=0, col_steps(2)=1, col_steps(6)=8, col_steps(27)=111.
// Returns 0 for n <= 1 (degenerate).
fn col_steps(n: int) -> int
    let v = n
    if v <= 1
        return 0
    let steps = 0
    while v != 1
        if v % 2 == 0
            v /= 2
        else
            v = 3 * v + 1
        steps += 1
    steps

// col_seq — full Collatz sequence starting at n, ending at 1 (inclusive).
// col_seq(1)=[1], col_seq(2)=[2,1], col_seq(6)=[6,3,10,5,16,8,4,2,1].
// Returns [1] for n <= 1 (degenerate).
fn col_seq(n: int) -> list
    let out = []
    let v = n
    if v <= 1
        push(out, 1)
        return out
    push(out, v)
    while v != 1
        if v % 2 == 0
            v /= 2
        else
            v = 3 * v + 1
        push(out, v)
    out

// col_max — peak value reached in the Collatz sequence of n.
// col_max(1)=1, col_max(6)=16, col_max(27)=9232.
// Returns n for n <= 1 (degenerate).
fn col_max(n: int) -> int
    let v = n
    if v <= 1
        return 1
    let peak = v
    while v != 1
        if v % 2 == 0
            v /= 2
        else
            v = 3 * v + 1
        if v > peak
            peak = v
    peak

// col_steps_upto — list of col_steps(k) for k = 1, 2, ..., limit (inclusive).
// col_steps_upto(0)=[], col_steps_upto(1)=[0], col_steps_upto(6)=[0,1,7,2,5,8].
// Hand-trace: steps for 1=0, 2=1, 3=7, 4=2, 5=5, 6=8.
fn col_steps_upto(limit: int) -> list
    let out = []
    if limit <= 0
        return out
    for k in 1..limit + 1
        push(out, col_steps(k))
    out
