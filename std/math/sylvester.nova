// std/math/sylvester.nova — Sylvester's sequence utilities.
// LEAF — imports NOTHING.
//
// Sylvester's sequence: a(0)=2, a(n) = a(n-1)*a(n-1) - a(n-1) + 1
//   2, 3, 7, 43, 1807, 3263443, ...
// Each term equals the product of all previous terms plus 1.
// Used in Curtiss's proof that every rational has a finite Egyptian fraction expansion.
//
// WARNING: the sequence grows doubly-exponentially. a(5)=3263443, a(6)~10^13.
// Only n<=5 fits in 63-bit signed int without overflow risk in practice.
//
// Public API:
//   sv_sylvester(n) -> int   nth term (0-indexed); a(0)=2, a(4)=1807
//   sv_list(n)      -> list  first n terms [a(0)..a(n-1)]
//   sv_product(n)   -> int   product of the first n terms
//
// All private helpers use the sv_ prefix to avoid cross-module symbol collisions.

// sv_sylvester — nth term of Sylvester's sequence (0-indexed).
// Recurrence: a(0)=2, a(k) = a(k-1)^2 - a(k-1) + 1.
// Iterative: avoids deep recursion stack and is O(n) multiplications.
//
// Hand-trace:
//   n=0: return 2 immediately
//   n=1: prev=2  -> 2*2-2+1=3
//   n=2: prev=3  -> 3*3-3+1=7
//   n=3: prev=7  -> 7*7-7+1=43
//   n=4: prev=43 -> 43*43-43+1=1807
fn sv_sylvester(n: int) -> int
    if n <= 0
        return 2
    let prev = 2
    let k = 1
    while k <= n
        let next = prev * prev - prev + 1
        prev = next
        k = k + 1
    prev

// sv_list — list of first n terms: [a(0), a(1), ..., a(n-1)].
// sv_list(0) = [], sv_list(1) = [2], sv_list(4) = [2,3,7,43].
fn sv_list(n: int) -> list
    let out = []
    if n <= 0
        return out
    let cur = 2
    push(out, cur)
    for k in 1..n
        let nxt = cur * cur - cur + 1
        cur = nxt
        push(out, cur)
    out

// sv_product — product of the first n terms a(0)*a(1)*...*a(n-1).
// sv_product(0)=1 (empty product), sv_product(1)=2, sv_product(3)=2*3*7=42.
// Note: product of first n terms = a(n) - 1 (a remarkable identity of the sequence),
// but we compute directly to avoid confusion and keep this self-contained.
fn sv_product(n: int) -> int
    if n <= 0
        return 1
    let acc = 1
    let cur = 2
    for k in 0..n
        acc = acc * cur
        if k < n - 1
            let nxt = cur * cur - cur + 1
            cur = nxt
    acc
