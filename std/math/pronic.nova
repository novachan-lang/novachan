// std/math/pronic.nova — Pronic (oblong) numbers: k*(k+1).
// LEAF — imports NOTHING.
//
// A pronic number is the product of two consecutive integers k and k+1.
// Sequence: 0, 2, 6, 12, 20, 30, 42, 56, 72, 90, ...  (OEIS A002378)
//
// Public API:
//   pro_n(k)      -> int    k-th pronic number = k*(k+1)
//   pro_is(n)     -> bool   true iff n is pronic
//   pro_index(n)  -> int    k such that k*(k+1)==n, or -1 if n is not pronic
//   pro_list(n)   -> list   first n pronic numbers (pro_n(0)..pro_n(n-1))
//
// ALGORITHM:
//   pro_n: direct formula k*(k+1), O(1).
//   pro_is / pro_index: solve k^2+k-n=0 => k=floor((-1+sqrt(1+4n))/2).
//     Then verify k*(k+1)==n.  Integer square root via Newton's method avoids
//     float imprecision for large n.  O(log n) for isqrt.
//
// KNOWN ANSWERS (hand-traced):
//   pro_n(0)=0, pro_n(1)=2, pro_n(3)=12, pro_n(5)=30
//   pro_is(0)=true, pro_is(12)=true, pro_is(13)=false
//   pro_index(0)=0, pro_index(12)=3, pro_index(30)=5, pro_index(13)=-1
//   pro_list(4)=[0,2,6,12]

// _pro_isqrt — integer square root via Newton (floor(sqrt(n))).
// Returns largest integer r such that r*r <= n.
// n must be >= 0.
fn _pro_isqrt(n: int) -> int
    if n <= 0
        return 0
    // Starting estimate: n itself is safe (will converge downward).
    // Use bit-length heuristic: shift right by half the bits for a better start.
    let x = n
    let y = (x + 1) / 2
    while y < x
        x = y
        y = (x + n / x) / 2
    x

// pro_n — k-th pronic number: k*(k+1).
// pro_n(0)=0, pro_n(1)=2, pro_n(2)=6, pro_n(3)=12, ...
// k must be >= 0; negative k is treated as 0.
fn pro_n(k: int) -> int
    if k <= 0
        return 0
    k * (k + 1)

// pro_index — return k such that k*(k+1)==n, or -1 if n is not pronic.
// Works for n==0 (returns 0).
fn pro_index(n: int) -> int
    if n < 0
        return -1
    if n == 0
        return 0
    // Solve k = floor((-1 + sqrt(1+4n)) / 2).
    // Use integer sqrt of (1+4n) to stay exact.
    let disc = 1 + 4 * n
    let r = _pro_isqrt(disc)
    // We need (-1 + r) to be even and positive.
    let num = r - 1
    if num < 0
        return -1
    let k = num / 2
    // Verify exact match (integer sqrt may be off by 1).
    if k * (k + 1) == n
        return k
    let k2 = k + 1
    if k2 * (k2 + 1) == n
        return k2
    -1

// pro_is — true iff n is a pronic number (k*(k+1) for some k >= 0).
fn pro_is(n: int) -> bool
    if n < 0
        return false
    pro_index(n) >= 0

// pro_list — first count pronic numbers: [pro_n(0), pro_n(1), ..., pro_n(count-1)].
// pro_list(0)=[], pro_list(4)=[0,2,6,12].
fn pro_list(count: int) -> list
    let result = []
    if count <= 0
        return result
    let k = 0
    while k < count
        push(result, k * (k + 1))
        k = k + 1
    result
