// std/math/stern_brocot.nova — the Stern-Brocot tree: the infinite binary
// tree that contains every positive rational number in lowest terms exactly
// once, built by repeated mediants. Distinct from std/math/continued_fraction
// and std/math/mediant.nova (mediant.nova exposes the raw mediant/Farey
// building block only; this module uses it to navigate and address nodes
// of the full tree via L/R paths — a different, higher-level concept) and
// from std/rational/rfrac_farey.nova (Farey sequences are bounded-denominator
// SLICES of the rationals; the Stern-Brocot tree is the unbounded generative
// structure that produces them).
// LEAF — imports NOTHING.
//
// CONSTRUCTION: start with boundary fractions left = 0/1, right = 1/0
// (0/1 and the "infinity" 1/0 are not themselves tree nodes, only the
// initial bounds). The tree root is their mediant, 1/1. Each node's left
// child is the mediant of that node and its nearest ancestor-or-boundary on
// the left; its right child is the mediant of that node and its nearest
// ancestor-or-boundary on the right. Every positive rational in lowest
// terms appears exactly once, addressed by a unique finite path of L/R
// moves from the root.
//
// PUBLIC API:
//   sb_mediant(n1, d1, n2, d2)  -> [n, d]   mediant (n1+n2)/(d1+d2)
//   sb_path_to_fraction(path)  -> [n, d]   fraction reached by following
//                                          path (a list of "L"/"R" strings)
//                                          from the root
//   sb_fraction_to_path(n, d)  -> list     the unique L/R path from the
//                                          root to reduced fraction n/d
//   sb_parent(n, d)            -> [n, d]   the parent of n/d in the tree
//                                          (n/d itself, by convention, if
//                                          n == d — the root has no parent)
//   sb_depth(n, d)             -> int      length of n/d's path (0 for the
//                                          root 1/1)
//
// KNOWN ANSWERS (hand-traced against this exact algorithm):
//   sb_mediant(0,1,1,0)          = [1, 1]     (the root)
//   sb_path_to_fraction([])      = [1, 1]
//   sb_path_to_fraction(["L"])   = [1, 2]
//   sb_path_to_fraction(["R"])   = [2, 1]
//   sb_path_to_fraction(["L","L"]) = [1, 3]
//   sb_path_to_fraction(["R","R"]) = [3, 1]
//   sb_path_to_fraction(["L","R"]) = [2, 3]
//   sb_path_to_fraction(["R","L"]) = [3, 2]
//   sb_fraction_to_path(2, 3)    = ["L", "R"]
//   sb_fraction_to_path(3, 2)    = ["R", "L"]
//   sb_fraction_to_path(1, 1)    = []
//   sb_parent(2, 3)              = [1, 2]
//   sb_parent(3, 2)              = [2, 1]
//   sb_parent(1, 1)              = [1, 1]     (root sentinel)
//   sb_depth(1, 1)                = 0
//   sb_depth(2, 3)                = 2

// sb_mediant — mediant of n1/d1 and n2/d2.
fn sb_mediant(n1, d1, n2, d2)
    return [n1 + n2, d1 + d2]

// sb_path_to_fraction — walk L/R moves from the root, narrowing the
// [left, right) mediant bounds; the mediant computed at each step IS the
// node reached after that move.
fn sb_path_to_fraction(path)
    let ln = 0
    let ld = 1
    let rn = 1
    let rd = 0
    let nn = ln + rn
    let nd = ld + rd
    for move in path
        if move == "L"
            rn = nn
            rd = nd
        else
            ln = nn
            ld = nd
        nn = ln + rn
        nd = ld + rd
    return [nn, nd]

// sb_fraction_to_path — the unique L/R path from the root to reduced
// fraction n/d, found by comparing the running mediant to the target via
// cross-multiplication (no floating point, no risk of precision loss).
fn sb_fraction_to_path(n, d)
    let path = []
    let ln = 0
    let ld = 1
    let rn = 1
    let rd = 0
    let mn = ln + rn
    let md = ld + rd
    while not (mn == n and md == d)
        if n * md < mn * d
            push(path, "L")
            rn = mn
            rd = md
        else
            push(path, "R")
            ln = mn
            ld = md
        mn = ln + rn
        md = ld + rd
    return path

// sb_parent — parent of n/d in the tree: the fraction reached by the same
// path with its last move dropped. Built on top of the two verified
// path<->fraction functions above rather than a separate ad hoc formula.
fn sb_parent(n, d)
    if n == d
        return [n, d]
    let path = sb_fraction_to_path(n, d)
    let plen = len(path)
    let parent_path = [path[i] for i in 0..(plen - 1)]
    return sb_path_to_fraction(parent_path)

// sb_depth — length of n/d's L/R path from the root (0 for the root 1/1).
fn sb_depth(n, d)
    let path = sb_fraction_to_path(n, d)
    return len(path)
