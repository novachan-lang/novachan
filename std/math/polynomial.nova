// std/math/polynomial.nova — polynomial arithmetic over float coefficient lists.
// A polynomial is represented as a list [c0, c1, c2, ...]
// where index i is the coefficient of x^i  (ascending degree / low-to-high).
// Concretely:  c0 + c1*x + c2*x^2 + ...
// All coefficient reads are coerced to float via *1.0. Inputs are never mutated.
// LEAF — imports nothing.
//
// FLOAT HAZARDS (NOVA memory):
//   • Bind all sub-expressions to named `let`s; never return a bare multi-term
//     float expression — an uninit-float-slot Heisenbug lurks there.
//   • Float vs int compare UNSOUND — coerce with *1.0.
//   • abs(float) UNSOUND — use: if x < 0.0 then (0.0 - x) else x
//
// API:
//   py_eval(coeffs, x: float) -> float   Horner's method evaluation
//   py_add(a, b) -> list                 coefficient-wise addition (len = max)
//   py_mul(a, b) -> list                 polynomial multiplication (convolution)
//   py_scale(coeffs, s: float) -> list   multiply every coefficient by scalar s
//   py_derivative(coeffs) -> list        formal derivative; [] -> []
//   py_degree(coeffs) -> int             highest index with non-zero coeff; -1 for zero poly

// Evaluate polynomial at x using Horner's method.
// Horner iterates from the highest-degree term down:
//   result = cn;  result = result*x + c(n-1); ... ; result = result*x + c0
fn py_eval(coeffs: list, x: float) -> float
    let n = len(coeffs)
    if n == 0
        let z = 0.0
        return z
    let result = coeffs[n - 1] * 1.0
    let i = n - 2
    while i >= 0
        let ci = coeffs[i] * 1.0
        result = result * x + ci
        i -= 1
    result

// Add two polynomials coefficient-wise.
// Result length = max(len(a), len(b)); the shorter one is zero-padded.
fn py_add(a: list, b: list) -> list
    let la = len(a)
    let lb = len(b)
    let lmax = la
    if lb > la
        lmax = lb
    let out = []
    for i in 0..lmax
        let va = 0.0
        let vb = 0.0
        if i < la
            va = a[i] * 1.0
        if i < lb
            vb = b[i] * 1.0
        let s = va + vb
        push(out, s)
    out

// Multiply two polynomials via convolution.
// If p has degree m and q has degree n, result has degree m+n.
// Output length = len(a) + len(b) - 1.
fn py_mul(a: list, b: list) -> list
    let la = len(a)
    let lb = len(b)
    if la == 0
        let empty = []
        return empty
    if lb == 0
        let empty2 = []
        return empty2
    let lout = la + lb - 1
    let out = []
    for k in 0..lout
        let zv = 0.0
        push(out, zv)
    for i in 0..la
        let ai = a[i] * 1.0
        let j = 0
        while j < lb
            let bj = b[j] * 1.0
            let cur = out[i + j] * 1.0
            let prod = ai * bj
            out[i + j] = cur + prod
            j += 1
    out

// Scale every coefficient by a scalar s.
// py_scale([c0,c1,...], s) -> [c0*s, c1*s, ...]
fn py_scale(coeffs: list, s: float) -> list
    let n = len(coeffs)
    let out = []
    for i in 0..n
        let ci = coeffs[i] * 1.0
        let v = ci * s
        push(out, v)
    out

// Formal derivative: d/dx(c0 + c1*x + c2*x^2 + ...) = c1 + 2*c2*x + 3*c3*x^2 + ...
// Derivative of a constant (n<=1) is the zero polynomial — returns [].
// Empty input -> [].
fn py_derivative(coeffs: list) -> list
    let n = len(coeffs)
    let out = []
    if n <= 1
        return out
    for i in 1..n
        let ci = coeffs[i] * 1.0
        let deg = i * 1.0
        let v = ci * deg
        push(out, v)
    out

// Degree of the polynomial: highest index with a non-zero coefficient.
// Returns -1 for the zero polynomial (all coefficients zero, or empty list).
// Uses epsilon 1e-10 for float comparison.
fn py_degree(coeffs: list) -> int
    let n = len(coeffs)
    if n == 0
        return -1
    let d = n - 1
    while d >= 0
        let cv = coeffs[d] * 1.0
        let acv = cv
        if acv < 0.0
            acv = 0.0 - acv
        if acv > 0.0000000001
            return d
        d -= 1
    -1
