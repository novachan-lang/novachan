// std/math/polynomial.nova — polynomial arithmetic over float coefficients.
// A polynomial is represented as a list of coefficients [c0, c1, c2, ...]
// meaning c0 + c1*x + c2*x^2 + ... (ascending degree order).
// All inputs are coerced to float via *1.0. Inputs are never mutated.
// LEAF — imports NOTHING.
//
// FLOAT HAZARDS (see NOVA memory):
//   • bind all sub-expressions to named `let`s; never return bare multi-term
//     float expressions — Heisenbug: uninit float slot if not bound.
//   • Float vs int compare UNSOUND — coerce with *1.0.
//   • abs() on floats UNSOUND — use: if x < 0.0 then (0.0 - x) else x
//
// API:
//   poly_eval(coeffs, x: float) -> float   Horner's method evaluation
//   poly_add(a, b) -> list                 coefficient-wise addition
//   poly_mul(a, b) -> list                 polynomial multiplication
//   poly_derivative(coeffs) -> list        formal derivative
//   poly_degree(coeffs) -> int             highest non-zero index, else 0

// Evaluate polynomial at x using Horner's method.
// Horner: p(x) = c0 + x*(c1 + x*(c2 + ... x*cn))
// We iterate from high degree down to 0.
fn poly_eval(coeffs: list, x: float) -> float
    let n = len(coeffs)
    if n == 0
        let z = 0.0
        return z
    let result = coeffs[n - 1] * 1.0
    let i = n - 2
    while i >= 0
        let ci = coeffs[i] * 1.0
        result = result * x + ci
        i = i - 1
    result

// Add two polynomials coefficient-wise. Result length = max(len(a), len(b)).
fn poly_add(a: list, b: list) -> list
    let la = len(a)
    let lb = len(b)
    let lmax = la
    if lb > la
        lmax = lb
    let out = []
    let i = 0
    while i < lmax
        let va = 0.0
        let vb = 0.0
        if i < la
            va = a[i] * 1.0
        if i < lb
            vb = b[i] * 1.0
        let s = va + vb
        push(out, s)
        i = i + 1
    out

// Multiply two polynomials. Result has degree deg(a)+deg(b).
fn poly_mul(a: list, b: list) -> list
    let la = len(a)
    let lb = len(b)
    if la == 0
        let empty = []
        return empty
    if lb == 0
        let empty2 = []
        return empty2
    let lout = la + lb - 1
    let out = []
    let k = 0
    while k < lout
        let v = 0.0
        push(out, v)
        k = k + 1
    let i = 0
    while i < la
        let ai = a[i] * 1.0
        let j = 0
        while j < lb
            let bj = b[j] * 1.0
            let cur = out[i + j] * 1.0
            let prod = ai * bj
            out[i + j] = cur + prod
            j = j + 1
        i = i + 1
    out

// Formal derivative: d/dx(c0 + c1*x + c2*x^2 + ...) = c1 + 2*c2*x + ...
// Result coefficients: [c1*1, c2*2, c3*3, ...]
fn poly_derivative(coeffs: list) -> list
    let n = len(coeffs)
    let out = []
    if n <= 1
        return out
    let i = 1
    while i < n
        let ci = coeffs[i] * 1.0
        let deg = i * 1.0
        let v = ci * deg
        push(out, v)
        i = i + 1
    out

// Degree of polynomial: highest index with non-zero coefficient.
// Returns 0 if all zero or only one term.
fn poly_degree(coeffs: list) -> int
    let n = len(coeffs)
    if n == 0
        return 0
    let d = n - 1
    while d > 0
        let cv = coeffs[d] * 1.0
        // Check non-zero: compare with a small epsilon for float safety
        if cv > 0.0000000001
            return d
        if cv < 0.0 - 0.0000000001
            return d
        d = d - 1
    0
