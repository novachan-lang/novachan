// std/math/pollard_rho.nova — Pollard's rho integer factorization.
// KAT: test_programs/_kat_fleet7.nova
// LEAF — imports NOTHING.
//
// Pollard's rho finds a nontrivial factor of a composite n by iterating the
// pseudo-random map f(x) = (x^2 + c) mod n and using Floyd's tortoise/hare
// to detect the cycle that this map's orbit eventually enters mod each
// prime factor of n; gcd(|x-y|, n) then reveals a factor with high
// probability once the cycle has started. This is a fundamentally different
// technique from std/math/primesieve.nova (which enumerates ALL primes up
// to a bound by sieving) — rho factors ONE given (possibly large) number
// without ever enumerating primes below it.
//
// Public API:
//   plr_gcd(a, b)              -> int   Euclidean GCD (self-contained, no cross-import)
//   plr_is_prime(n)            -> bool  trial-division primality test, O(sqrt n)
//   plr_pollard(n)             -> int   ONE nontrivial factor of composite n
//                                        (returns n itself if n is prime or n<=3;
//                                        returns 2 if n is even; returns 1 if n<=1)
//   plr_factorize(n)           -> list  full prime factorization with multiplicity,
//                                        ascending (e.g. plr_factorize(360) = [2,2,2,3,3,5])
//   plr_count_factors(n)       -> int   Omega(n): count of prime factors with multiplicity
//   plr_largest_prime_factor(n)-> int   largest prime factor of n; -1 if n < 2
//
// Implementation strategy for plr_factorize: strip small factors (<=1000) by
// trial division first (this alone resolves the vast majority of composites
// and is what shrinks n before rho ever runs); any remaining cofactor > 1 is
// then split via plr_pollard in a worklist loop until every piece is prime.
// c is walked deterministically (1, 2, 3, ...) on retry so results are
// reproducible — no randomness anywhere in this module.

fn plr_gcd(a: int, b: int) -> int
    let u = a
    let v = b
    if u < 0
        u = -u
    if v < 0
        v = -v
    while v != 0
        let t = v
        v = u % v
        u = t
    return u

fn plr_is_prime(n: int) -> bool
    if n < 2
        return false
    if n == 2
        return true
    if n % 2 == 0
        return false
    let i = 3
    while i * i <= n
        if n % i == 0
            return false
        i += 2
    return true

// _plr_f — the pseudo-random map f(x) = (x*x + c) mod n used by Pollard's rho.
fn _plr_f(x: int, c: int, n: int) -> int
    return (x * x + c) % n

// plr_pollard — find ONE nontrivial factor of n via Floyd-cycle Pollard's rho.
fn plr_pollard(n: int) -> int
    if n <= 1
        return 1
    if n == 2 or n == 3
        return n
    if n % 2 == 0
        return 2
    if plr_is_prime(n)
        return n
    for c in 1..50
        let x = 2
        let y = 2
        let d = 1
        while d == 1
            x = _plr_f(x, c, n)
            y = _plr_f(_plr_f(y, c, n), c, n)
            let diff = x - y
            if diff < 0
                diff = -diff
            d = plr_gcd(diff, n)
        if d != n and d != 1
            return d
    return n

// _plr_last / _plr_drop_last — O(n) worklist-stack helpers (list "pop" via
// rebuild, matching this codebase's immutable-list convention).
fn _plr_last(xs: list) -> int
    return xs[len(xs) - 1]

fn _plr_drop_last(xs: list) -> list
    let n = len(xs) - 1
    return xs[0..n]

// _plr_sort — ascending insertion sort (small worklists; O(n^2) is fine).
fn _plr_sort(xs: list) -> list
    let out = xs
    let n = len(out)
    for i in 1..n
        let cur = out[i]
        let j = i - 1
        while j >= 0 and out[j] > cur
            out[j + 1] = out[j]
            j -= 1
        out[j + 1] = cur
    return out

fn plr_factorize(n: int) -> list
    let result = []
    let m = n
    if m >= 2
        while m % 2 == 0
            push(result, 2)
            m /= 2
        let p = 3
        while p <= 1000 and p * p <= m
            while m % p == 0
                push(result, p)
                m /= p
            p += 2
        if m > 1
            if plr_is_prime(m)
                push(result, m)
            else
                let stack = [m]
                while len(stack) > 0
                    let cur = _plr_last(stack)
                    stack = _plr_drop_last(stack)
                    if plr_is_prime(cur)
                        push(result, cur)
                    else
                        let f = plr_pollard(cur)
                        if f == cur or f <= 1
                            push(result, cur)
                        else
                            push(stack, f)
                            push(stack, cur / f)
    return _plr_sort(result)

fn plr_count_factors(n: int) -> int
    return len(plr_factorize(n))

fn plr_largest_prime_factor(n: int) -> int
    let f = plr_factorize(n)
    let m = len(f)
    if m == 0
        return -1
    return f[m - 1]
