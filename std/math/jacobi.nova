// std/math/jacobi.nova — Jacobi and Legendre symbols.
// All functions operate on integers; n must be odd positive (Jacobi) or odd prime (Legendre).
// LEAF — imports NOTHING.
//
// Public API:
//   jc_jacobi(a, n)  -> int   Jacobi symbol (a/n); n must be odd and positive.
//                             Returns -1, 0, or 1.
//   jc_legendre(a, p)-> int   Legendre symbol (a/p); p must be an odd prime.
//                             Returns -1, 0, or 1.
//   jc_is_qr(a, p)   -> bool  True iff a is a quadratic residue mod p;
//                             p must be an odd prime; a must not be divisible by p.
//
// ALGORITHM (jc_jacobi):
//   Classical iterative Jacobi symbol via repeated application of:
//   1. Reduce a mod n (take remainder, normalize to [0,n) to handle negatives).
//   2. Strip trailing powers of 2 from a; multiply sign by (-1)^((n^2-1)/8) per factor.
//      The exponent (n^2-1)/8 is odd iff n ≡ 3 or 5 (mod 8).
//   3. Apply quadratic reciprocity: (a/n)(n/a) = (-1)^((a-1)/2 * (n-1)/2).
//      This flips sign when both a ≡ 3 and n ≡ 3 (mod 4).
//   4. Set n = a, a = old_n mod a. Repeat until a = 0.
//   Returns 0 when gcd(a,n) > 1, else 1 or -1.
//
// KNOWN ANSWERS (hand-verified against textbook):
//   jc_legendre(2, 7)    =  1   (7 ≡ 7 mod 8; factor of 2 contributes +1)
//   jc_legendre(3, 7)    = -1   (3 is not a QR mod 7; QRs mod 7 are 1,2,4)
//   jc_jacobi(1001,9907) = -1
//   jc_jacobi(2, 15)     =  1   (15=3×5; (2/3)=-1, (2/5)=-1; product=+1)
//   jc_jacobi(3, 15)     =  0   (gcd(3,15)=3 > 1)
//   jc_legendre(1, 7)    =  1   (1 is always a QR)
//   jc_is_qr(2, 7)       = true
//   jc_is_qr(3, 7)       = false

// jc_jacobi — Jacobi symbol (a/n).
// n must be odd and positive. Returns -1, 0, or 1.
// jc_jacobi(0, 1) = 1 by convention (empty product). jc_jacobi(0, n>1) = 0.
fn jc_jacobi(a: int, n: int) -> int
    if n == 1
        return 1
    let result = 1
    // Normalize aa to [0, n) to handle negative a.
    let aa = a % n
    if aa < 0
        aa += n
    let nn = n
    let done = 0
    while done == 0
        if aa == 0
            if nn > 1
                result = 0
            done = 1
        if done == 0
            // Strip all factors of 2 from aa.
            // For each factor of 2: sign *= (-1)^((nn^2-1)/8).
            // (nn^2-1)/8 is odd iff nn % 8 == 3 or nn % 8 == 5.
            let strip_done = 0
            while strip_done == 0
                if aa % 2 == 1
                    strip_done = 1
                if strip_done == 0
                    aa = aa / 2
                    let r8 = nn % 8
                    if r8 == 3
                        result = 0 - result
                    if r8 == 5
                        result = 0 - result
            // aa is now odd.
            if aa == 1
                done = 1
            if done == 0
                // Quadratic reciprocity: flip sign if aa ≡ 3 (mod 4) and nn ≡ 3 (mod 4).
                let aa4 = aa % 4
                let nn4 = nn % 4
                if aa4 == 3
                    if nn4 == 3
                        result = 0 - result
                // Swap: replace (aa/nn) with (nn mod aa / aa).
                let tmp = aa
                aa = nn % aa
                nn = tmp
    result

// jc_legendre — Legendre symbol (a/p).
// p must be an odd prime. Identical to the Jacobi symbol for prime denominator.
// Returns -1, 0, or 1.
fn jc_legendre(a: int, p: int) -> int
    jc_jacobi(a, p)

// jc_is_qr — quadratic residue test.
// Returns true iff a is a quadratic residue mod p (Legendre symbol == 1).
// p must be an odd prime; a must not be divisible by p.
fn jc_is_qr(a: int, p: int) -> bool
    jc_legendre(a, p) == 1
