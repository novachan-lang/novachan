// std/math/mediant.nova
// Fraction mediants: Stern-Brocot / Farey sequence utilities.
// All functions operate on integer numerator/denominator pairs.
// Private helpers prefixed _md_ to avoid collision with other modules.

// _md_gcd — greatest common divisor via Euclidean algorithm, always >= 0.
// gcd(0,0) = 1 (safe sentinel to avoid divide-by-zero in callers).
fn _md_gcd(a, b)
    let u = a
    let v = b
    if u < 0
        u = 0 - u
    if v < 0
        v = 0 - v
    while v != 0
        let t = u % v
        u = v
        v = t
    if u == 0
        return 1
    u

// md_reduce(n, d) -> list [num, den]
// Reduces fraction n/d to lowest terms; ensures den > 0.
// md_reduce(4, 10) -> [2, 5]; md_reduce(0, 5) -> [0, 1].
fn md_reduce(n, d)
    let num = n
    let den = d
    if den < 0
        num = 0 - num
        den = 0 - den
    if den == 0
        den = 1
    let g = _md_gcd(num, den)
    let rn = num / g
    let rd = den / g
    let out = []
    out.push(rn)
    out.push(rd)
    out

// md_mediant(a, b, c, d) -> list [num, den]
// Returns the mediant of fractions a/b and c/d: (a+c)/(b+d), reduced.
// md_mediant(1, 2, 1, 3) -> [2, 5] since (1+1)/(2+3)=2/5.
fn md_mediant(a, b, c, d)
    let mn = a + c
    let md = b + d
    md_reduce(mn, md)

// md_between(a, b, c, d) -> int (1 = true, 0 = false)
// Returns 1 if the mediant of a/b and c/d lies strictly between a/b and c/d.
// For positive-denominator fractions with a/b != c/d this is always 1.
// Uses cross-multiplication to stay in integer arithmetic.
fn md_between(a, b, c, d)
    let an = a
    let ab = b
    let cn = c
    let cd = d
    if ab < 0
        an = 0 - an
        ab = 0 - ab
    if cd < 0
        cn = 0 - cn
        cd = 0 - cd
    // mediant m_num/m_den = (an+cn)/(ab+cd)
    let m_num = an + cn
    let m_den = ab + cd
    // Check: a/b < m_num/m_den  i.e.  an * m_den < m_num * ab
    let left_ok = 0
    if an * m_den < m_num * ab
        left_ok = 1
    // Check: m_num/m_den < c/d  i.e.  m_num * cd < cn * m_den
    let right_ok = 0
    if m_num * cd < cn * m_den
        right_ok = 1
    if left_ok == 1
        if right_ok == 1
            return 1
    0

// md_compare(a, b, c, d) -> int
// Compares fractions a/b and c/d via cross-multiplication (no floating-point).
// Returns -1 if a/b < c/d, 0 if equal, 1 if a/b > c/d.
fn md_compare(a, b, c, d)
    let an = a
    let ab = b
    let cn = c
    let cd = d
    // Normalise so denominators are positive for cross-mult direction.
    if ab < 0
        an = 0 - an
        ab = 0 - ab
    if cd < 0
        cn = 0 - cn
        cd = 0 - cd
    let lhs = an * cd
    let rhs = cn * ab
    if lhs < rhs
        return -1
    if lhs > rhs
        return 1
    0
