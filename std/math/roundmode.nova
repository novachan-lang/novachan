// std/math/roundmode.nova — integer rounding modes.
// Provides: rm_toward_zero, rm_floor, rm_ceil, rm_half_up, rm_half_even.
// LEAF — imports NOTHING.
//
// FLOAT HAZARDS obeyed:
//   • floor()/ceil() return INT in NOVA (nova_rt_floor/ceil return int64_t).
//   • float_to_int() truncates toward zero -> used for rm_toward_zero.
//   • Float vs int compare unsound: coerce via *1.0 when mixing.
//   • Never return bare multi-term float expression: bind to named let.
//   • Fractional part computed as x - floor(x)*1.0 (floor returns int so
//     must multiply by 1.0 to promote back to float for subtraction).

// rm_toward_zero(x) -> int
// Truncate toward zero: rm_toward_zero(2.9)=2, rm_toward_zero(-2.9)=-2.
// float_to_int() uses C (int64_t)val which truncates toward zero.
fn rm_toward_zero(x: float) -> int
    float_to_int(x)

// rm_floor(x) -> int
// Round toward negative infinity.
// floor() in NOVA returns int directly.
fn rm_floor(x: float) -> int
    floor(x)

// rm_ceil(x) -> int
// Round toward positive infinity.
// ceil() in NOVA returns int directly.
fn rm_ceil(x: float) -> int
    ceil(x)

// rm_half_up(x) -> int
// Round half away from zero (.5 rounds to the number with larger magnitude).
// Positive: floor(x + 0.5). Negative: ceil(x - 0.5).
fn rm_half_up(x: float) -> int
    if x >= 0.0
        let shifted = x + 0.5
        floor(shifted)
    else
        let shifted = x - 0.5
        ceil(shifted)

// rm_half_even(x) -> int
// Banker's rounding: .5 rounds to the nearest even integer.
// Algorithm:
//   fi   = floor(x)           (int, toward -inf)
//   frac = x - fi*1.0        (fractional part in [0,1))
//   frac < 0.5 -> fi
//   frac > 0.5 -> fi + 1
//   frac == 0.5 -> fi if fi is even, else fi+1
fn rm_half_even(x: float) -> int
    let fi = floor(x)
    let fi_f = fi * 1.0
    let frac = x - fi_f
    if frac * 1.0 < 0.5
        fi
    else if frac * 1.0 > 0.5
        fi + 1
    else
        // exactly 0.5 — round to even
        let rem = fi - (fi / 2) * 2
        if rem == 0
            fi
        else
            fi + 1
