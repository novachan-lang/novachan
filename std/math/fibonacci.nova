// std/math/fibonacci.nova — Fibonacci utilities (iterative, 64-bit ints).
// LEAF — imports NOTHING.
//
// Public API:
//   fib(n)        -> int   nth Fibonacci number, 0-indexed: fib(0)=0, fib(1)=1
//   fib_list(n)   -> list  first n Fibonacci numbers [fib(0)..fib(n-1)]
//   is_fib(n)     -> bool  true iff n is a Fibonacci number
//   fib_index(n)  -> int   index k such that fib(k)==n, or -1 if n not Fibonacci
//   fib_sum(n)    -> int   sum of first n Fibonacci numbers: fib(0)+...+fib(n-1)
//
// Private helpers use the _fb_ prefix to avoid cross-module symbol collisions.
// All functions are purely iterative (no recursion).

// _fb_isqrt — integer square root via Newton's method (private helper).
// Returns floor(sqrt(v)). Returns 0 for v <= 0.
fn _fb_isqrt(v: int) -> int
    if v <= 0
        return 0
    let x = v
    let y = (v + 1) / 2
    while y < x
        x = y
        y = (y + v / y) / 2
    x

// fib — nth Fibonacci number (0-indexed, iterative).
// fib(0)=0, fib(1)=1, fib(n)=fib(n-1)+fib(n-2) for n>=2.
// Returns 0 for n < 0.
fn fib(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 1
    let a = 0
    let b = 1
    for i in 2..n + 1
        let c = a + b
        a = b
        b = c
    b

// fib_list — list of first n Fibonacci numbers: [fib(0), fib(1), ..., fib(n-1)].
// fib_list(0)=[], fib_list(1)=[0], fib_list(7)=[0,1,1,2,3,5,8].
fn fib_list(n: int) -> list
    let out = []
    if n <= 0
        return out
    push(out, 0)
    if n == 1
        return out
    push(out, 1)
    if n == 2
        return out
    let a = 0
    let b = 1
    for i in 2..n
        let c = a + b
        a = b
        b = c
        push(out, b)
    out

// is_fib — true iff n is a Fibonacci number.
// Uses the perfect-square test: n is Fibonacci iff 5n^2+4 or 5n^2-4 is a perfect square.
// Hand-trace: n=21 -> 5*441+4=2209=47^2 -> yes.
//             n=22 -> 5*484+4=2424, isqrt=49, 49^2=2401!=2424;
//                     5*484-4=2416, isqrt=49, 49^2=2401!=2416 -> false.
fn is_fib(n: int) -> bool
    if n < 0
        return false
    let t1 = 5 * n * n + 4
    let r1 = _fb_isqrt(t1)
    if r1 * r1 == t1
        return true
    let t2 = 5 * n * n - 4
    if t2 < 0
        return false
    let r2 = _fb_isqrt(t2)
    r2 * r2 == t2

// fib_index — returns index k such that fib(k)==n, or -1 if n is not a Fibonacci number.
// fib_index(0)=0, fib_index(1)=1, fib_index(55)=10, fib_index(22)=-1.
// Iterates the Fibonacci sequence until the value meets or exceeds n.
fn fib_index(n: int) -> int
    if n < 0
        return -1
    if n == 0
        return 0
    if n == 1
        return 1
    let a = 0
    let b = 1
    let k = 1
    while b < n
        let c = a + b
        a = b
        b = c
        k += 1
    if b == n
        return k
    -1

// fib_sum — sum of first n Fibonacci numbers: fib(0)+fib(1)+...+fib(n-1).
// fib_sum(0)=0, fib_sum(5)=0+1+1+2+3=7.
// Approach: accumulate the sequence term by term with running a,b pair.
// At iteration i: emit fib(i) = previous b (except i=0 emits 0, i=1 emits 1).
fn fib_sum(n: int) -> int
    if n <= 0
        return 0
    // sum = fib(n+1) - 1, computed iteratively.
    // We need fib(n+1): run the recurrence n+1 steps from (0,1).
    let a = 0
    let b = 1
    for i in 0..n
        let c = a + b
        a = b
        b = c
    // Now b = fib(n+1). Sum of fib(0)..fib(n-1) = fib(n+1) - 1.
    b - 1
