// std/math/padovan.nova — Padovan sequence utilities (iterative, 64-bit ints).
// LEAF — imports NOTHING.
//
// Public API:
//   pdv_padovan(n) -> int   nth Padovan number, 0-indexed: P(0)=P(1)=P(2)=1
//   pdv_list(n)    -> list  first n Padovan numbers [P(0)..P(n-1)]
//   pdv_sum(n)     -> int   sum of first n Padovan numbers
//
// Padovan recurrence: P(n) = P(n-2) + P(n-3), with P(0)=P(1)=P(2)=1.
// Sequence: 1, 1, 1, 2, 2, 3, 4, 5, 7, 9, 12, 16, 21, 28, 37, ...
//
// All private helpers use the pdv_ prefix to avoid cross-module symbol collisions.
// All functions are purely iterative (no recursion).

// pdv_padovan — nth Padovan number (0-indexed, iterative).
// P(0)=1, P(1)=1, P(2)=1, P(n)=P(n-2)+P(n-3) for n>=3.
// Returns P(0)=1 for n < 0 (clamp to base case).
fn pdv_padovan(n: int) -> int
    if n <= 0
        return 1
    if n == 1
        return 1
    if n == 2
        return 1
    // a = P(i-3), b = P(i-2), c = P(i-1); iterate until i == n
    let a = 1
    let b = 1
    let c = 1
    let i = 3
    while i <= n
        let next = a + b
        a = b
        b = c
        c = next
        i = i + 1
    c

// pdv_list — list of first n Padovan numbers: [P(0), P(1), ..., P(n-1)].
// pdv_list(0)=[], pdv_list(1)=[1], pdv_list(6)=[1,1,1,2,2,3].
fn pdv_list(n: int) -> list
    let out = []
    if n <= 0
        return out
    push(out, 1)
    if n == 1
        return out
    push(out, 1)
    if n == 2
        return out
    push(out, 1)
    if n == 3
        return out
    let a = 1
    let b = 1
    let c = 1
    for i in 3..n
        let next = a + b
        a = b
        b = c
        c = next
        push(out, c)
    out

// pdv_sum — sum of first n Padovan numbers: P(0)+P(1)+...+P(n-1).
// pdv_sum(0)=0, pdv_sum(1)=1, pdv_sum(6)=1+1+1+2+2+3=10.
fn pdv_sum(n: int) -> int
    let xs = pdv_list(n)
    let total = 0
    for i in 0..len(xs)
        total = total + xs[i]
    total
