// std/math/bernoulli.nova — Bernoulli numbers as exact reduced fractions.
// LEAF — imports NOTHING.
//
// Convention: B_1 = -1/2  (arithmetic / "first" convention).
// Every Bernoulli number is returned as a list [num, den] with den > 0
// and gcd(|num|, den) == 1.  B_n = 0 is encoded as [0, 1].
//
// Public API:
//   be_number(n)  -> list [num, den]  nth Bernoulli number (n >= 0)
//   be_is_zero(n) -> bool             true iff B_n == 0 (i.e. n odd and n > 1)
//
// Private helpers use the _be_ prefix to avoid cross-module symbol collisions.
//
// Algorithm: build B_0..B_n iteratively via the recurrence
//   sum_{k=0}^{n} C(n+1, k) * B_k = 0
// Solved for B_n:
//   B_n = -(1/(n+1)) * sum_{k=0}^{n-1} C(n+1, k) * B_k
// Exact rational arithmetic throughout (no floating point).
//
// KAT reference (OEIS A027641 / A027642):
//   n=0: 1/1   n=1: -1/2   n=2: 1/6    n=3: 0/1
//   n=4: -1/30  n=5: 0/1    n=6: 1/42   n=8: -1/30

// _be_gcd — Euclidean GCD of two non-negative integers.
// gcd(0, 0) = 0  (by convention; callers ensure at least one arg > 0 when used for reduction).
fn _be_gcd(a: int, b: int) -> int
    let u = a
    if u < 0
        u = 0 - u
    let v = b
    if v < 0
        v = 0 - v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// _be_reduce — given numerator p and denominator q (q > 0), return [p', q'] in lowest terms
// with q' > 0.  p may be any sign including zero.
fn _be_reduce(p: int, q: int) -> list
    if p == 0
        let z = []
        z.push(0)
        z.push(1)
        return z
    let ap = p
    if ap < 0
        ap = 0 - ap
    let g = _be_gcd(ap, q)
    let rp = p / g
    let rq = q / g
    // ensure denominator positive (q was already > 0, g > 0, so rq > 0 always)
    let out = []
    out.push(rp)
    out.push(rq)
    out

// _be_frac_add — add two fractions [n1,d1] and [n2,d2], return reduced result.
// Uses: n1/d1 + n2/d2 = (n1*d2 + n2*d1) / (d1*d2), then reduce.
fn _be_frac_add(f1: list, f2: list) -> list
    let n1 = f1[0]
    let d1 = f1[1]
    let n2 = f2[0]
    let d2 = f2[1]
    // reduce intermediate denominators first to keep numbers small
    let g = _be_gcd(d1, d2)
    let d1r = d1 / g
    let d2r = d2 / g
    // new numerator: n1*(d2/g) + n2*(d1/g)
    let top = n1 * d2r + n2 * d1r
    // new denominator: d1 * (d2/g)
    let bot = d1 * d2r
    _be_reduce(top, bot)

// _be_frac_mul_int — multiply fraction [n, d] by integer m, return reduced result.
fn _be_frac_mul_int(f: list, m: int) -> list
    let n = f[0]
    let d = f[1]
    // reduce m with d before multiplying to keep numbers small
    let am = m
    if am < 0
        am = 0 - am
    let g = _be_gcd(am, d)
    let mr = m / g
    let dr = d / g
    _be_reduce(n * mr, dr)

// _be_frac_div_int — divide fraction [n, d] by integer m (m != 0), return reduced result.
// Computes n / (d * m), then reduces.
fn _be_frac_div_int(f: list, m: int) -> list
    let n = f[0]
    let d = f[1]
    // absorb sign into numerator; keep denominator positive
    let sign = 1
    if m < 0
        sign = 0 - 1
        m = 0 - m
    // reduce n with m before multiplying denominator
    let an = n
    if an < 0
        an = 0 - an
    let g = _be_gcd(an, m)
    let nr = (n * sign) / g
    let mr = m / g
    _be_reduce(nr, d * mr)

// _be_binom — C(n, k): binomial coefficient computed iteratively.
// Uses the identity C(n,k) = C(n,k-1) * (n-k+1) / k.
// Guaranteed integer at each step (Pascal triangle row); divide before multiply to avoid overflow.
fn _be_binom(n: int, k: int) -> int
    if k < 0
        return 0
    if k > n
        return 0
    // C(n, k) == C(n, n-k); use smaller k for speed
    let kk = k
    if n - k < kk
        kk = n - k
    let val = 1
    for i in 0..kk
        // multiply by (n - i), divide by (i + 1); division is exact at each step
        val = val * (n - i) / (i + 1)
    val

// be_number — nth Bernoulli number as reduced fraction [num, den].
// B_0 = [1,1]; B_1 = [-1,2]; odd n>1 -> [0,1].
// Builds all B_k for k=0..n iteratively via the recurrence.
fn be_number(n: int) -> list
    if n < 0
        let r = []
        r.push(0)
        r.push(1)
        return r
    // cache array: cache[k] = [num, den] for B_k
    let cache = []
    // B_0 = 1/1
    let b0 = []
    b0.push(1)
    b0.push(1)
    cache.push(b0)
    if n == 0
        return cache[0]
    // build B_1 through B_n
    let idx = 1
    while idx <= n
        // B_idx = -(1/(idx+1)) * sum_{k=0}^{idx-1} C(idx+1, k) * B_k
        // start accumulator at 0/1
        let acc = []
        acc.push(0)
        acc.push(1)
        for k in 0..idx
            let bk = cache[k]
            let c = _be_binom(idx + 1, k)
            // term = C(idx+1, k) * B_k
            let term = _be_frac_mul_int(bk, c)
            acc = _be_frac_add(acc, term)
        // B_idx = -acc / (idx+1)
        // negate: flip sign of numerator
        let acc_n = acc[0]
        let acc_d = acc[1]
        let neg = []
        neg.push(0 - acc_n)
        neg.push(acc_d)
        let result = _be_frac_div_int(neg, idx + 1)
        cache.push(result)
        idx += 1
    cache[n]

// be_is_zero — true iff the nth Bernoulli number is zero.
// By the standard result: B_n = 0 for all odd n > 1.
// Rather than recompute, we detect directly: odd n >= 3 -> true, else check be_number.
fn be_is_zero(n: int) -> bool
    if n > 1
        if n % 2 == 1
            return true
    let frac = be_number(n)
    frac[0] == 0
