// std/math/happy.nova — Happy numbers.
// A positive integer is "happy" if repeatedly replacing it by the sum of the
// squares of its digits eventually reaches 1.  Numbers that never reach 1
// cycle forever and are "unhappy".
// LEAF — imports NOTHING.
//
// Public API:
//   hap_next(n)        -> int   one step: sum of squares of decimal digits of n
//   hap_is(n)          -> bool  true iff n is a happy number
//   hap_upto(limit)    -> list  all happy numbers in [1, limit], ascending
//   hap_sequence(n)    -> list  path from n until 1 or a repeated value (inclusive)
//
// ALGORITHM:
//   hap_next extracts digits via repeated % 10 / / 10 division and accumulates
//   d*d for each digit d.  This is O(log n) per step.
//
//   hap_is iterates hap_next, storing each visited value in a dict keyed by
//   str(value).  If we reach 1 → happy; if we visit a value already in the
//   dict → unhappy cycle.  The cycle for unhappy numbers always passes through
//   4 → 16 → 37 → 58 → 89 → 145 → 42 → 20 → 4.
//
// HAND-TRACED KAT:
//   hap_next(19) = 1^2 + 9^2 = 1 + 81 = 82     ✓
//   hap_next(82) = 8^2 + 2^2 = 64 + 4 = 68
//   hap_next(68) = 6^2 + 8^2 = 36 + 64 = 100
//   hap_next(100)= 1+0+0 = 1  → hap_is(19)=true ✓
//   hap_is(4):  4→16→37→58→89→145→42→20→4 (cycle) → false ✓
//   hap_upto(10): 1,7,10  (2,3,4,5,6,8,9 all unhappy)  ✓

// _hap_sum_digit_squares — internal: compute sum of squares of decimal digits.
// n must be > 0.  For n=0 returns 0 (guard in callers).
fn _hap_sum_digit_squares(n: int) -> int
    let acc = 0
    let rem = n
    while rem > 0
        let d = rem % 10
        acc = acc + d * d
        rem = rem / 10
    acc

// hap_next — one step of the happy-number iteration:
//   replace n by the sum of the squares of its decimal digits.
// hap_next(19) = 1^2 + 9^2 = 82.
// hap_next(1)  = 1.
// n < 1 is treated as 0.
fn hap_next(n: int) -> int
    if n < 1
        return 0
    _hap_sum_digit_squares(n)

// hap_is — return true iff n is a happy number.
// hap_is(1)=true, hap_is(7)=true, hap_is(4)=false.
// n <= 0 returns false.
fn hap_is(n: int) -> bool
    if n <= 0
        return false
    let seen = {}
    let cur = n
    let found = false
    let done = false
    while done == false
        if cur == 1
            found = true
            done = true
        else
            let key = str(cur)
            if contains(seen, key)
                done = true
            else
                seen[key] = 1
                cur = _hap_sum_digit_squares(cur)
    found

// hap_upto — list of all happy numbers in [1, limit], in ascending order.
// hap_upto(10) = [1, 7, 10].
fn hap_upto(limit: int) -> list
    let result = []
    let k = 1
    while k <= limit
        if hap_is(k)
            push(result, k)
        k = k + 1
    result

// hap_sequence — list of values starting from n, applying hap_next repeatedly,
// until we reach 1 (included) or revisit a value (the repeated value is the
// LAST element, so the cycle entry is visible).
// hap_sequence(1) = [1].
// hap_sequence(19) = [19, 82, 68, 100, 1].
fn hap_sequence(n: int) -> list
    let path = []
    if n <= 0
        return path
    let seen = {}
    let cur = n
    let done = false
    while done == false
        push(path, cur)
        if cur == 1
            done = true
        else
            let key = str(cur)
            if contains(seen, key)
                done = true
            else
                seen[key] = 1
                cur = _hap_sum_digit_squares(cur)
    path
