// std/math/interp.nova — interpolation and remapping helpers (float).
// Provides: map_range, clamp01, inv_lerp, smoothstep.
// LEAF — imports NOTHING.
//
// FLOAT HAZARDS (see NOVA memory):
//   • Float-return Heisenbug: always bind sub-expressions to named `let`s
//     before returning; never return a bare multi-term float expression.
//   • Float vs int compare is UNSOUND — coerce with *1.0 if mixing.
//   • lerp is in std/math/round — do not duplicate it here.

// map_range(x, in_lo, in_hi, out_lo, out_hi) -> float
// Maps x from [in_lo, in_hi] onto [out_lo, out_hi].
// Formula: out_lo + (x - in_lo) / (in_hi - in_lo) * (out_hi - out_lo)
// Coerces all inputs *1.0 to guarantee float arithmetic throughout.
fn map_range(x, in_lo, in_hi, out_lo, out_hi) -> float
    let xf      = x      * 1.0
    let in_lo_f = in_lo  * 1.0
    let in_hi_f = in_hi  * 1.0
    let out_lo_f = out_lo * 1.0
    let out_hi_f = out_hi * 1.0
    let span    = in_hi_f - in_lo_f
    let t       = (xf - in_lo_f) / span
    let result  = out_lo_f + t * (out_hi_f - out_lo_f)
    result

// clamp01(x) -> float
// Clamps x to [0.0, 1.0].
fn clamp01(x: float) -> float
    0.0 if x < 0.0 else (1.0 if x > 1.0 else x)

// inv_lerp(a, b, v) -> float
// Inverse linear interpolation: returns t such that lerp(a, b, t) == v.
// Equivalent to (v - a) / (b - a).
fn inv_lerp(a: float, b: float, v: float) -> float
    let diff   = b - a
    let offset = v - a
    let result = offset / diff
    result

// smoothstep(t) -> float
// Clamps t to [0,1] then applies the Hermite smooth curve: t*t*(3 - 2*t).
// Returns 0.0 at t<=0, 1.0 at t>=1, 0.5 at t=0.5.
fn smoothstep(t: float) -> float
    let tc     = clamp01(t)
    let inner  = 3.0 - 2.0 * tc
    let result = tc * tc * inner
    result
