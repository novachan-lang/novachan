// std/math/schroeder.nova — Schroeder number sequences (large and little/small).
// LEAF — imports NOTHING.
//
// Large Schroeder numbers: S(0)=1, S(1)=2, S(2)=6, S(3)=22, S(4)=90, S(5)=394, ...
// Recurrence (n+1)*S(n) = (6*n-3)*S(n-1) - (n-2)*S(n-2) for n>=2. Division exact.
//
// Little (small) Schroeder numbers: s(0)=1, s(1)=1, s(2)=3, s(3)=11, s(4)=45, s(5)=197, ...
// Relationship: S(n) = 2 * s(n) for n >= 1; s(0) = S(0) = 1.
//
// All public and private helpers use the sh_ prefix.

// sh_large — nth large Schroeder number (0-indexed).
// S(0)=1, S(1)=2, S(2)=6, S(3)=22, S(4)=90, S(5)=394, S(6)=1806.
fn sh_large(n: int) -> int
    if n <= 0
        return 1
    if n == 1
        return 2
    let prev2 = 1
    let prev1 = 2
    let i = 2
    let result = 0
    while i <= n
        let num = (6 * i - 3) * prev1 - (i - 2) * prev2
        let den = i + 1
        result = num / den
        prev2 = prev1
        prev1 = result
        i = i + 1
    result

// sh_small — nth little (small) Schroeder number (0-indexed).
// s(0)=1, s(1)=1, s(2)=3, s(3)=11, s(4)=45, s(5)=197.
// Uses: s(0)=1; s(n) = S(n)/2 for n>=1.
fn sh_small(n: int) -> int
    if n <= 0
        return 1
    let big = sh_large(n)
    big / 2

// sh_list — first n large Schroeder numbers [S(0), S(1), ..., S(n-1)].
// sh_list(0)=[], sh_list(5)=[1,2,6,22,90].
fn sh_list(n: int) -> list
    let out = []
    let i = 0
    while i < n
        let v = sh_large(i)
        push(out, v)
        i = i + 1
    out
