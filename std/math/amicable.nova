// std/math/amicable.nova — amicable-number pairs (aliquot-sum reciprocity).
// KAT: test_programs/_kat_fleet7.nova
// LEAF — imports NOTHING.
//
// Two distinct positive integers a, b form an AMICABLE PAIR when the sum of
// the proper divisors of a equals b, and the sum of the proper divisors of
// b equals a. Classic example: 220 and 284.
//   proper divisors of 220: 1,2,4,5,10,11,20,22,44,55,110 -> sum = 284
//   proper divisors of 284: 1,2,4,71,142               -> sum = 220
//
// This is a distinct topic from std/math/perfectnum.nova (which classifies
// a SINGLE number as perfect/abundant/deficient via the same aliquot-sum
// building block but never looks for a reciprocal partner).
//
// Public API:
//   amc_divisor_sum(n)         -> int   sum of proper divisors of n (aliquot sum)
//   amc_is_amicable_pair(a, b) -> bool  true iff (a,b) is a valid amicable pair
//   amc_partner(n)             -> int   n's amicable partner, or -1 if none
//   amc_is_amicable(n)         -> bool  true iff n has an amicable partner
//   amc_pairs_upto(limit)      -> list  all [a,b] pairs (a<b<=limit) found in [2,limit]
//
// Complexity: amc_divisor_sum is O(sqrt n) via paired trial division.
// amc_pairs_upto is O(limit * sqrt(limit)).

// amc_divisor_sum — sum of the proper divisors of n (divisors < n that divide n).
// amc_divisor_sum(0) = amc_divisor_sum(1) = 0.
fn amc_divisor_sum(n: int) -> int
    if n <= 1
        return 0
    let total = 1
    let i = 2
    while i * i <= n
        if n % i == 0
            total = total + i
            let pair = n / i
            if pair != i
                total = total + pair
        i = i + 1
    return total

// amc_is_amicable_pair — true iff a != b, both positive, and each is the
// other's aliquot sum.
fn amc_is_amicable_pair(a: int, b: int) -> bool
    if a == b
        return false
    if a <= 0 or b <= 0
        return false
    if amc_divisor_sum(a) != b
        return false
    return amc_divisor_sum(b) == a

// amc_partner — the amicable partner of n, or -1 if n is not part of an
// amicable pair (this also excludes perfect numbers, where divisor_sum(n)==n,
// since a pair requires two DISTINCT numbers).
fn amc_partner(n: int) -> int
    if n <= 1
        return -1
    let s = amc_divisor_sum(n)
    if s == n
        return -1
    if s <= 1
        return -1
    if amc_divisor_sum(s) == n
        return s
    return -1

// amc_is_amicable — true iff n participates in some amicable pair.
fn amc_is_amicable(n: int) -> bool
    return amc_partner(n) != -1

// amc_pairs_upto — every amicable pair [a,b] with a < b <= limit, ascending by a.
// Each pair is reported exactly once (only when the smaller member is found).
fn amc_pairs_upto(limit: int) -> list
    let result = []
    for n in 2..(limit + 1)
        let p = amc_partner(n)
        if p > n and p <= limit
            push(result, [n, p])
    return result
