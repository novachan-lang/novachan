// ============================================================================
// NOVA Standard Library — std/barcode/code128
// ============================================================================
// Code 128 — high-density alphanumeric linear barcode.
//
// Standard: ISO/IEC 15417:2007, AIM Uniform Symbology Specification for Code 128.
//
// CODE SETS:
//   Code 128 has three code sets:
//   - Code Set A: ASCII 0x00..0x5F (control chars + uppercase + specials)
//   - Code Set B: ASCII 0x20..0x7F (space..DEL, all printable ASCII)
//   - Code Set C: pairs of digits 00..99
//
//   This module implements Code Set B (printable ASCII) as the primary interface.
//
// SYMBOL VALUES (Code Set B):
//   Each Code 128 symbol has a value 0..102 (103 symbols total).
//   For Code Set B, the data characters map as:
//     value = ord(c) - 32   (so space=0, '!'=1, ..., 'A'=33, ..., '~'=94)
//   Start Code B has value 104.
//   Stop has value 106 (not used in checksum calculation; it's always appended).
//
// CHECKSUM ALGORITHM:
//   Given a list of symbol values (start value, then data values):
//     checksum = (start_value + sum(i * data_values[i]) for i=1..n) mod 103
//   Where:
//     - values[0] is the start code value (104 for Code B)
//     - values[1..n] are the data symbol values (1-indexed weights)
//   Total formula: (start + 1*val[1] + 2*val[2] + ... + n*val[n]) mod 103
//
//   In this module:
//     code128_checksum(values) -> int
//   Takes the full list [start_value, data_val_1, ..., data_val_n] and
//   computes: (values[0] + sum(i * values[i]) for i=1..len-1) mod 103
//
// VALID INPUT:
//   Code Set B accepts printable ASCII: ord(c) in 0x20..0x7E (space through '~').
//   DEL (0x7F) is technically value 95 in Code Set B but rare; we exclude it
//   from code128_valid for strictness (printable text only).
//
// PUBLIC API:
//   code128b_value(c)        -> int   Code Set B symbol value = ord(c) - 32 (for printable ASCII)
//   code128_valid(text)      -> int   1 if all chars are printable ASCII (0x20..0x7E), 0 otherwise
//   code128_checksum(values) -> int   Checksum in 0..102 given list [start, val1, val2, ...]
//
// LEAF — imports NOTHING.

// ── Public API ────────────────────────────────────────────────────────────────

// Return the Code 128 Code Set B symbol value for a character.
// For printable ASCII (space=0x20 through '~'=0x7E): value = ord(c) - 32.
// No range validation — caller is responsible.
fn code128b_value(c) -> int
    ord(c) - 32

// Return 1 if all characters in text are valid Code Set B chars (printable ASCII 0x20..0x7E).
// Returns 0 if any character is outside this range or text is empty.
fn code128_valid(text)
    let n = len(text)
    if n == 0
        return 0
    let i = 0
    let ok = 1
    while i < n and ok == 1
        let c = slice(text, i, i+1)
        let b = ord(c)
        if b < 32 or b > 126
            ok = 0
        i = i + 1
    ok

// Compute the Code 128 checksum for a list of symbol values.
// values[0] = start code value (e.g. 104 for Start Code B)
// values[1..n-1] = data symbol values (1-indexed in the weighted sum)
//
// Formula: (values[0] + 1*values[1] + 2*values[2] + ... + (n-1)*values[n-1]) mod 103
//
// Returns the check symbol value in 0..102.
fn code128_checksum(values) -> int
    let n = len(values)
    if n == 0
        return 0
    let total = values[0]
    let i = 1
    while i < n
        total = total + i * values[i]
        i = i + 1
    total % 103
