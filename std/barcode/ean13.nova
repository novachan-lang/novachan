// ============================================================================
// NOVA Standard Library — std/barcode/ean13
// ============================================================================
// EAN-13 (International Article Number, 13-digit form) barcode implementation.
//
// EAN-13 is the global retail barcode standard, encoding 13 digits as a
// 95-module (bar/space) pattern. It is used on nearly all retail products
// worldwide. An EAN-13 barcode consists of:
//   - 3-module left guard  (101)
//   - 6 left data modules, each 7 modules wide
//   - 5-module center guard (01010)
//   - 6 right data modules, each 7 modules wide
//   - 3-module right guard (101)
//   Total: 3 + 42 + 5 + 42 + 3 = 95 modules
//
// The first digit (system digit) is encoded implicitly via the parity
// pattern of the left 6 data digits — it is NOT physically encoded as
// a bar pattern. Digits 2-7 use L-codes (odd parity) or G-codes (even
// parity) per the system digit. Digits 8-13 (including check) use R-codes.
//
// CHECK DIGIT ALGORITHM (GS1 Mod-10):
//   Positions 1..12 from left (1-based). Odd positions (1,3,5,7,9,11) * 1,
//   even positions (2,4,6,8,10,12) * 3. sum all. check = (10 - sum%10) % 10.
//
// PUBLIC API:
//   ean13_check(digits12: string) -> int
//     Compute the check digit for a 12-digit EAN-13 payload.
//     KAT: ean13_check("978030640615") == 7  (ISBN-13 978-0-306-40615-7)
//          ean13_check("400638133393") == 1
//
//   ean13_encode(digits12: string) -> string
//     Encode 12 data digits to a 95-module bar/space pattern string.
//     "1"=bar, "0"=space. Check digit computed automatically.
//     KAT: len(ean13_encode("978030640615")) == 95
//
//   ean13_valid(digits13: string) -> int
//     Validate a 13-digit EAN-13 string. Returns 1 if check digit matches.
//     KAT: ean13_valid("9780306406157") == 1
//
// ENCODING TABLES (GS1 standard):
//   L-codes: odd parity, 7-module patterns for digits 0-9 (left side, L parity)
//   G-codes: even parity, 7-module patterns for digits 0-9 (left side, G parity)
//   R-codes: complement of L, 7-module patterns for digits 0-9 (right side)
//   Parity table: system digit (0-9) -> 6-char string of 'L'/'G' for left 6 digits
//
// PRIVATE HELPERS: prefixed _e13_ to prevent symbol collision.
//
// LEAF — imports NOTHING.

// ── L-code patterns (odd parity) ─────────────────────────────────────────────
// Returns the 7-module pattern for digit d (0..9).
fn _e13_L(d) -> string
    if d == 0
        return "0001101"
    if d == 1
        return "0011001"
    if d == 2
        return "0010011"
    if d == 3
        return "0111101"
    if d == 4
        return "0100011"
    if d == 5
        return "0110001"
    if d == 6
        return "0101111"
    if d == 7
        return "0111011"
    if d == 8
        return "0110111"
    "0001011"

// ── G-code patterns (even parity) ────────────────────────────────────────────
fn _e13_G(d) -> string
    if d == 0
        return "0100111"
    if d == 1
        return "0110011"
    if d == 2
        return "0011011"
    if d == 3
        return "0100001"
    if d == 4
        return "0011101"
    if d == 5
        return "0111001"
    if d == 6
        return "0000101"
    if d == 7
        return "0010001"
    if d == 8
        return "0001001"
    "0010111"

// ── R-code patterns (complement of L, used for all right-side digits) ─────────
fn _e13_R(d) -> string
    if d == 0
        return "1110010"
    if d == 1
        return "1100110"
    if d == 2
        return "1101100"
    if d == 3
        return "1000010"
    if d == 4
        return "1011100"
    if d == 5
        return "1001110"
    if d == 6
        return "1010000"
    if d == 7
        return "1000100"
    if d == 8
        return "1001000"
    "1110100"

// ── Parity selection for left 6 digits, indexed by system digit 0-9 ──────────
// Returns a 6-char string where 'L' = L-code, 'G' = G-code for that position.
fn _e13_parity(sys) -> string
    if sys == 0
        return "LLLLLL"
    if sys == 1
        return "LLGLGG"
    if sys == 2
        return "LLGGLG"
    if sys == 3
        return "LLGGGL"
    if sys == 4
        return "LGLLGG"
    if sys == 5
        return "LGGLLG"
    if sys == 6
        return "LGGGLL"
    if sys == 7
        return "LGLGLG"
    if sys == 8
        return "LGLGGL"
    "LGGLGL"

// ── Public API ────────────────────────────────────────────────────────────────

// ean13_check: compute the GS1 Mod-10 check digit for 12 data digits.
//
// Weights: position 1,3,5,7,9,11 from left get weight 1;
//          position 2,4,6,8,10,12 get weight 3.
// check = (10 - (sum % 10)) % 10
//
// KAT:
//   ean13_check("978030640615") == 7   (ISBN-13 978-0-306-40615-7)
//   ean13_check("400638133393") == 1
fn ean13_check(digits12) -> int
    let total = 0
    for i in 0..12
        let d = ord(digits12[i]) - 48
        let pos = i + 1
        if pos % 2 == 1
            total = total + d
        else
            total = total + d * 3
    (10 - total % 10) % 10

// ean13_encode: encode 12 data digits to a 95-module bar/space pattern.
//
// The check digit is computed and appended to form the full 13-digit
// sequence before encoding. The output is exactly 95 characters.
//
// Structure:
//   "101" (3) + left 6 * 7 (42) + "01010" (5) + right 6 * 7 (42) + "101" (3) = 95
//
// KAT: len(ean13_encode("978030640615")) == 95
fn ean13_encode(digits12) -> string
    let check = ean13_check(digits12)
    let d13 = digits12 + chr(48 + check)
    let sys = ord(d13[0]) - 48
    let par = _e13_parity(sys)
    let out = "101"
    for i in 0..6
        let dval = ord(d13[i + 1]) - 48
        let pk = par[i]
        if pk == "L"
            out = out + _e13_L(dval)
        else
            out = out + _e13_G(dval)
    out = out + "01010"
    for j in 0..6
        let dval2 = ord(d13[j + 7]) - 48
        out = out + _e13_R(dval2)
    out = out + "101"
    out

// ean13_valid: validate a 13-digit EAN-13 string.
//
// Returns 1 (true) if the 13th digit matches the computed check digit
// for the first 12 digits. Returns 0 (false) otherwise.
//
// KAT: ean13_valid("9780306406157") == 1 (true)
fn ean13_valid(digits13) -> int
    let check = ean13_check(slice(digits13, 0, 12))
    let last = ord(digits13[12]) - 48
    if check == last
        return 1
    0
