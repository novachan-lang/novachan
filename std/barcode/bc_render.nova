// ============================================================================
// NOVA Standard Library — std/barcode/bc_render
// ============================================================================
// Render a barcode module pattern (a string of "1"s and "0"s) to visual output.
// A "1" means a bar (dark), a "0" means a space (light).
//
// PUBLIC API:
//   render_ascii(pattern: string) -> string
//     Maps each "1" to chr(9608) (Unicode full-block U+2588) and each "0" to
//     a space character " ". Returns a single-row visual representation.
//     Length of output equals length of pattern.
//
//   render_hash(pattern: string) -> string
//     Like render_ascii but uses "#" for bars and " " for spaces. ASCII-safe
//     for environments that cannot display Unicode block characters.
//
//   render_ascii_tall(pattern: string, height: int) -> string
//     Repeats the single-row render_ascii output `height` times, separated
//     by newline characters "\n". Produces a tall barcode visual.
//     For height=1: identical to render_ascii. For height>1: height rows
//     with (height-1) newlines between them.
//
//   pattern_to_widths(pattern: string) -> list
//     Run-length encoding of a pattern string. Consecutive identical characters
//     are counted; each run's count is appended to the output list.
//     Example: "110011" -> [2, 2, 2]  (2 bars, 2 spaces, 2 bars)
//     Example: "101"    -> [1, 1, 1]
//     Empty pattern -> empty list.
//
// LEAF — imports NOTHING.

// ── Public API ───────────────────────────────────────────────────────────────

// render_ascii: render module pattern using Unicode full-block and space.
//
// Each "1" (bar) becomes chr(9608) = U+2588 FULL BLOCK.
// Each "0" (space) becomes ASCII space " ".
// Any character other than "0" is treated as "1" (bar).
//
// Example: render_ascii("101") -> "█ █" (len=3)
fn render_ascii(pattern) -> string
    let out = ""
    let n = len(pattern)
    for i in 0..n
        let c = pattern[i]
        if c == "0"
            out = out + " "
        else
            out = out + chr(9608)
    out

// render_hash: ASCII-safe render using "#" for bars and " " for spaces.
//
// Equivalent to render_ascii but substitutes "#" for the block character.
// Use when the output terminal may not support Unicode block characters.
//
// Example: render_hash("101") -> "# #" (len=3)
fn render_hash(pattern) -> string
    let out = ""
    let n = len(pattern)
    for i in 0..n
        let c = pattern[i]
        if c == "0"
            out = out + " "
        else
            out = out + "#"
    out

// render_ascii_tall: render a tall barcode with multiple rows.
//
// Repeats the single-row render_ascii result `height` times separated by "\n".
// For height <= 0: returns "".
// For height == 1: same as render_ascii(pattern).
// For height == 2: render_ascii(pattern) + "\n" + render_ascii(pattern)
//
// Example: render_ascii_tall("1", 2) -> "█\n█" (2 rows)
fn render_ascii_tall(pattern, height) -> string
    if height <= 0
        return ""
    let row = render_ascii(pattern)
    let out = row
    for r in 1..height
        out = out + "\n" + row
    out

// pattern_to_widths: run-length encode a module pattern to bar/space widths.
//
// Returns a list of integers where each element is the length of a consecutive
// run of the same character. The list alternates between bar runs and space runs
// (or vice-versa, depending on what character starts the pattern).
//
// Empty input returns an empty list.
//
// Examples:
//   pattern_to_widths("110011") == [2, 2, 2]  (2 bars, 2 spaces, 2 bars)
//   pattern_to_widths("101")    == [1, 1, 1]
//   pattern_to_widths("1")      == [1]
//   pattern_to_widths("")       == []
fn pattern_to_widths(pattern) -> list
    let widths = []
    let n = len(pattern)
    if n == 0
        return widths
    let count = 1
    for i in 1..n
        if pattern[i] == pattern[i-1]
            count = count + 1
        else
            push(widths, count)
            count = 1
    push(widths, count)
    widths
