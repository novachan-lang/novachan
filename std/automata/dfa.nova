// std/automata/dfa — Deterministic Finite Automaton
//
// Representation: a dict with four entries:
//   "start"  -> string: the start state name
//   "accept" -> dict:   accept_state_name -> 1  (membership set)
//   "trans"  -> dict:   "<fromState>:<symbol>" -> toState
//   "states" -> dict:   state_name -> 1  (all known states)
//
// The transition key format concatenates fromState + ":" + symbol.
// Symbol is assumed to be a single character (string of length 1).
// A missing transition causes dfa_accept to return false (reject).
//
// All public functions are prefixed dfa_.

// Create a new DFA with the given start state.
// The start state is automatically added to the states set.
fn dfa_new(start) -> dict
    let st = {}
    st[start] = 1
    return {"start": start, "accept": {}, "trans": {}, "states": st}

// Add a transition: from fromState on symbol go to toState.
// Both states are registered in the states set.
fn dfa_add_transition(m, fromState, symbol, toState)
    let key = fromState + ":" + symbol
    let tr = m["trans"]
    tr[key] = toState
    m["trans"] = tr
    let st = m["states"]
    st[fromState] = 1
    st[toState] = 1
    m["states"] = st

// Mark a state as accepting.
fn dfa_set_accept(m, state)
    let ac = m["accept"]
    ac[state] = 1
    m["accept"] = ac
    let st = m["states"]
    st[state] = 1
    m["states"] = st

// Run the DFA on input string; return the final state name,
// or "" if a missing transition was encountered (stuck / dead).
fn dfa_run(m, input) -> string
    let cur = m["start"]
    let tr = m["trans"]
    let n = len(input)
    for i in 0..n
        let sym = slice(input, i, i + 1)
        let key = cur + ":" + sym
        if key not in tr
            return ""
        cur = tr[key]
    return cur

// Return true (1) if the DFA accepts the input string.
// Acceptance requires: no missing transition AND landing in an accept state.
fn dfa_accept(m, input) -> int
    let final = dfa_run(m, input)
    if final == ""
        return 0
    let ac = m["accept"]
    return 1 if final in ac else 0

// Return the list of all known state names (insertion order preserved).
fn dfa_states(m) -> list
    let st = m["states"]
    return keys(st)
