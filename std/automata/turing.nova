// turing — single-tape Turing machine simulator.
//
// Tape: infinite in both directions, blank character = chr(95) ('_').
// Transitions: (state, readChar) -> (writeChar, move, nextState)
//   move = "L" (left), "R" (right), "S" (stay)
//
// Machine dict:
//   "start"  : string   — start state name
//   "blank"  : string   — blank symbol (one char)
//   "halts"  : dict     — halt state names as keys (value = 1)
//   "trans"  : dict     — key = "<state>:<readChar>", value = list [write, move, next]
//
// Public API:
//   tm_new(start, blank)                          -> machine dict
//   tm_add(m, state, read, write, move, nextState) -> 0  (adds/updates one transition)
//   tm_set_halt(m, state)                          -> 0  (mark state as halting)
//   tm_run(m, input, maxSteps)                    -> list [tapeStr, halted, steps]
//     tapeStr : tape content with leading/trailing blanks trimmed
//     halted  : 1 if a halt state was reached, 0 if maxSteps exhausted
//     steps   : number of steps executed
//   tm_accepts(m, input, maxSteps)                -> bool (1 if halted, 0 otherwise)

// _tm_key: build the lookup key for a transition.
fn _tm_key(state, ch)
    return state + ":" + ch

// tm_new: create a new Turing machine with given start state and blank symbol.
fn tm_new(start, blank)
    let m = {}
    m["start"] = start
    m["blank"] = blank
    m["halts"] = {}
    m["trans"] = {}
    return m

// tm_add: add (or overwrite) a transition rule.
//   state     — machine state in which this rule fires
//   read      — tape symbol that triggers this rule (one char string)
//   write     — symbol to write on the tape
//   mv        — head movement: "L", "R", or "S"
//   nextState — state to transition to after writing
fn tm_add(m, state, read, write, mv, nextState)
    let k = _tm_key(state, read)
    let rule = [write, mv, nextState]
    m["trans"][k] = rule
    return 0

// tm_set_halt: mark a state as a halting (accepting) state.
fn tm_set_halt(m, state)
    m["halts"][state] = 1
    return 0

// _tm_trim: remove leading and trailing blank characters from a string.
fn _tm_trim(s, blank)
    let n = len(s)
    // find first non-blank
    let lo = 0
    let done1 = 0
    while lo < n and done1 == 0
        let ch = slice(s, lo, lo + 1)
        if ch != blank
            done1 = 1
        if done1 == 0
            lo = lo + 1
    // find last non-blank
    let hi = n - 1
    let done2 = 0
    while hi >= lo and done2 == 0
        let ch2 = slice(s, hi, hi + 1)
        if ch2 != blank
            done2 = 1
        if done2 == 0
            hi = hi - 1
    if lo > hi
        return ""
    return slice(s, lo, hi + 1)

// tm_run: execute the Turing machine on input string, up to maxSteps steps.
// Returns a list: [tapeString, halted (0 or 1), stepCount]
//
// Implementation:
//   - Tape is represented as a list of single-char strings.
//   - Head position is an integer index into that list.
//   - We extend the tape with blanks when the head moves past either end.
fn tm_run(m, input, maxSteps)
    let blank = m["blank"]
    let trans = m["trans"]
    let halts = m["halts"]
    let state = m["start"]

    // Build initial tape as a list of chars.
    let tape = []
    let ni = len(input)
    let ii = 0
    while ii < ni
        let c = slice(input, ii, ii + 1)
        tape.push(c)
        ii = ii + 1
    // If input was empty, start with one blank cell so head has somewhere to sit.
    if len(tape) == 0
        tape.push(blank)
    let head = 0

    // Check if start state is itself a halt state (immediate halt, zero steps).
    let halted = 0
    if contains(halts, state)
        halted = 1

    let steps = 0
    let running = 1
    if halted == 1
        running = 0

    while steps < maxSteps and running == 1
        let dummy = 0
        // Extend tape left if head fell off.
        if head < 0
            tape.push(blank)
            // shift all elements right by one (can't shift, so rebuild)
            let oldlen = len(tape) - 1
            let newTape = [blank]
            let ti = 0
            while ti < oldlen
                let elem = tape[ti]
                newTape.push(elem)
                ti = ti + 1
            tape = newTape
            head = 0
        // Extend tape right if head is past end.
        if head >= len(tape)
            tape.push(blank)
        // Read current cell.
        let cur = tape[head]
        // Look up transition.
        let k = _tm_key(state, cur)
        if contains(trans, k)
            let rule = trans[k]
            let wch = rule[0]
            let mv = rule[1]
            let nst = rule[2]
            tape[head] = wch
            if mv == "L"
                head = head - 1
            if mv == "R"
                head = head + 1
            state = nst
            steps = steps + 1
            if contains(halts, state)
                halted = 1
                running = 0
        if running == 1
            if contains(trans, k) == 0
                // No transition for this (state, symbol): implicit halt.
                halted = 1
                running = 0

    // Convert tape list back to a string.
    let tapeStr = join(tape, "")
    let trimmed = _tm_trim(tapeStr, blank)
    let result = [trimmed, halted, steps]
    return result

// tm_accepts: run the machine and return 1 if it reached a halt state, 0 otherwise.
fn tm_accepts(m, input, maxSteps)
    let r = tm_run(m, input, maxSteps)
    return r[1]
