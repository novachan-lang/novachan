// std/automata/markov — Markov chain with weighted transitions
//
// Representation: a dict with one entry:
//   "edges" -> dict:  fromState -> dict of (toState -> weight:int)
//
// Deterministic randomness uses an embedded LCG:
//   next_seed = (seed * 1664525 + 1013904223) % 4294967296
// The LCG output selects a transition by weighted sampling over the
// outgoing edges whose weight > 0.  Weight-0 edges are stored but
// never chosen (they contribute 0 to the total weight).
//
// mkv_prob returns the normalised probability (float) of a specific
// transition, i.e. weight(A->B) / sum_of_all_weights_from_A.
// Returns 0.0 if the edge does not exist or the total weight is 0.
//
// All public functions are prefixed mkv_.

// mkv_new — create an empty Markov chain.
fn mkv_new() -> dict
    let m = {}
    let edges = {}
    m["edges"] = edges
    return m

// mkv_add — add (or accumulate) a weighted directed edge from->to.
// Calling mkv_add multiple times for the same pair REPLACES the weight.
fn mkv_add(m, fromState, toState, weight)
    let edges = m["edges"]
    let from_str = str(fromState)
    let to_str   = str(toState)
    if contains(edges, from_str)
        let row = edges[from_str]
        row[to_str] = weight
        edges[from_str] = row
    else
        let row = {}
        row[to_str] = weight
        edges[from_str] = row
    m["edges"] = edges

// _mkv_total_weight — sum of all weights for edges leaving fromState.
// Weight-0 edges count as 0 (present but never chosen).
fn _mkv_total_weight(m, fromState) -> int
    let edges = m["edges"]
    let from_str = str(fromState)
    if contains(edges, from_str)
        let row  = edges[from_str]
        let ks   = keys(row)
        let n    = len(ks)
        let i    = 0
        let total = 0
        while i < n
            let k = ks[i]
            let w = row[k]
            total = total + w
            i = i + 1
        return total
    return 0

// _mkv_lcg — advance an LCG seed one step, return the new seed.
// Parameters: Numerical Recipes standard (a=1664525, c=1013904223, m=2^32).
// We keep values in [0, 4294967296) via modulo.
fn _mkv_lcg(seed) -> int
    let next = (seed * 1664525 + 1013904223) % 4294967296
    return next

// mkv_next — given current state and a seed, return the weighted-random
// next state.  The LCG is advanced once to produce the sample; the
// caller's seed is not mutated (pure function).
// Returns "" if the state has no outgoing edges or total weight == 0.
fn mkv_next(m, state, seed) -> string
    let edges    = m["edges"]
    let from_str = str(state)
    if contains(edges, from_str)
        let row   = edges[from_str]
        let total = _mkv_total_weight(m, from_str)
        if total > 0
            // Advance the LCG once.
            let s1  = _mkv_lcg(seed)
            // Pick a value in [0, total).
            let pick = s1 % total
            // Walk the edges in key order until we consume 'pick'.
            let ks  = keys(row)
            let n   = len(ks)
            let i   = 0
            let acc = 0
            let chosen = ""
            let done = 0
            while i < n
                let k = ks[i]
                let w = row[k]
                let new_acc = acc + w
                if done == 0
                    if pick < new_acc
                        chosen = k
                        done   = 1
                acc = new_acc
                i = i + 1
            return chosen
    return ""

// mkv_walk — starting from 'start', take 'steps' transitions and return
// the sequence of visited states as a list.  Length = steps + 1
// (the initial state is included as element 0).
// The seed is threaded through the LCG across steps to ensure each step
// uses a different random value.
fn mkv_walk(m, start, steps, seed) -> list
    let path  = []
    let cur   = str(start)
    path.push(cur)
    let s     = seed
    for i in 0..steps
        let nxt = mkv_next(m, cur, s)
        // Advance seed so successive steps use different samples.
        let s2 = _mkv_lcg(s)
        s   = s2
        path.push(nxt)
        cur = nxt
    return path

// mkv_prob — normalised probability (float) of the edge fromState->toState.
// Returns 0.0 if the edge is absent or the total outgoing weight is 0.
fn mkv_prob(m, fromState, toState) -> float
    let edges    = m["edges"]
    let from_str = str(fromState)
    let to_str   = str(toState)
    if contains(edges, from_str)
        let row   = edges[from_str]
        if contains(row, to_str)
            let w     = row[to_str]
            let total = _mkv_total_weight(m, from_str)
            if total > 0
                let wf    = w * 1.0
                let tf    = total * 1.0
                let prob  = wf / tf
                return prob
    let zero = 0.0
    return zero
