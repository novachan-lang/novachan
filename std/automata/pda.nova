// pda — Deterministic Pushdown Automaton (acceptance by final state + empty-ish stack).
//
// A PDA is a dict with:
//   "start"   : string       — initial state name
//   "init"    : string       — initial stack symbol (always on bottom)
//   "accept"  : dict         — set of accepting state names (keys -> 1)
//   "trans"   : dict         — transition table keyed by "state|input|stackTop" -> {push, next}
//
// Stack is stored as a list; last element is the top.
// push string is applied RIGHT-TO-LEFT so the leftmost char ends up on top.
// push "" means pop only (no replacement).
//
// Acceptance: reached end of input in an accept state AND stack contains only
// the initial stack symbol (balanced / "empty-ish").
//
// Public API:
//   pda_new(start, initStackSym) -> dict
//   pda_add(m, state, input, stackTop, push, nextState)
//       input ""   = epsilon transition (consumed before each real input symbol)
//       push  ""   = pop only; push "XY" = pop old top, push Y then X (X on top)
//   pda_set_accept(m, state)
//   pda_accept(m, input) -> bool (1 = accepted, 0 = rejected)

// pda_new: create a new PDA with the given start state and initial stack symbol.
fn pda_new(start, initStackSym)
    let m = {}
    m["start"] = start
    m["init"] = initStackSym
    m["accept"] = {}
    m["trans"] = {}
    return m

// _pda_key: build the transition table key "state|input|stackTop".
fn _pda_key(state, inp, stackTop)
    return state + "|" + inp + "|" + stackTop

// pda_add: register a transition.
//   state     — source state
//   input     — input symbol consumed ("" = epsilon)
//   stackTop  — required top-of-stack symbol
//   push      — string to push after popping stackTop (left char = new top; "" = pop only)
//   nextState — destination state
fn pda_add(m, state, inp, stackTop, push, nextState)
    let k = _pda_key(state, inp, stackTop)
    let t = {}
    t["push"] = push
    t["next"] = nextState
    let tbl = m["trans"]
    tbl[k] = t

// pda_set_accept: mark state as an accepting state.
fn pda_set_accept(m, state)
    let acc = m["accept"]
    acc[state] = 1

// _pda_apply_eps: follow all epsilon transitions from current (state, stack) in place.
// Returns a two-element list [newState, newStack], or null if stuck.
// Epsilon transitions fire at most once per (state, stackTop) pair to avoid infinite loops.
fn _pda_apply_eps(m, state, stack)
    let changed = 1
    while changed == 1
        let changed = 0
        let slen = len(stack)
        if slen == 0
            return [state, stack]
        let top = stack[slen - 1]
        let k = _pda_key(state, "", top)
        let tbl = m["trans"]
        if k in tbl
            let tr = tbl[k]
            let push = tr["push"]
            let next = tr["next"]
            stack.pop()
            let pi = len(push) - 1
            while pi >= 0
                let ch = slice(push, pi, pi + 1)
                stack.push(ch)
                pi -= 1
            state = next
            changed = 1
    return [state, stack]

// pda_accept: simulate the PDA on input string.
// Returns 1 if accepted (final state + stack reduced to just initStackSym), 0 otherwise.
fn pda_accept(m, input)
    let initSym = m["init"]
    let startState = m["start"]
    // Build initial stack: [initSym] (initSym is the bottom, also the only element)
    let stack = []
    stack.push(initSym)
    let state = startState
    // Apply any epsilon transitions at the start
    let pair = _pda_apply_eps(m, state, stack)
    state = pair[0]
    stack = pair[1]
    // Process each input character
    let n = len(input)
    let i = 0
    let stuck = 0
    while i < n and stuck == 0
        let ch = slice(input, i, i + 1)
        let slen = len(stack)
        if slen == 0
            stuck = 1
        if stuck == 0
            let top = stack[slen - 1]
            let k = _pda_key(state, ch, top)
            let tbl = m["trans"]
            if k in tbl
                let tr = tbl[k]
                let push = tr["push"]
                let next = tr["next"]
                // Pop the old top
                stack.pop()
                // Push push string right-to-left so leftmost char is new top
                let pi = len(push) - 1
                while pi >= 0
                    let ch2 = slice(push, pi, pi + 1)
                    stack.push(ch2)
                    pi -= 1
                state = next
                // Apply epsilon transitions after consuming this symbol
                let pair2 = _pda_apply_eps(m, state, stack)
                state = pair2[0]
                stack = pair2[1]
            else
                stuck = 1
        i += 1
    if stuck == 1
        return 0
    // Check acceptance: must be in an accept state AND stack = [initSym]
    let acc = m["accept"]
    if state not in acc
        return 0
    if len(stack) != 1
        return 0
    if stack[0] != initSym
        return 0
    return 1
