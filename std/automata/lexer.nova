// std/automata/lexer -- rule-based tokenizer. LEAF -- imports NOTHING.
//
// Public API:
//
//   lex_tokenize(text: string, rules: list) -> list
//     Tokenize text using an ordered list of rules.
//     Each rule is a list [name, kind, hint] where:
//       name : string -- token name emitted (use "SKIP" to consume+discard)
//       kind : string -- one of:
//                "digits"  -- maximal run of digit characters (is_digit)
//                "letters" -- maximal run of alphabetic characters (is_alpha)
//                "space"   -- maximal run of whitespace characters (is_space)
//                "alnum"   -- maximal run of alphanumeric characters (is_alnum)
//                "punct"   -- single non-whitespace, non-alnum character
//                "exact"   -- match exactly the hint string (literal)
//       hint : string -- used only by "exact" kind (the literal to match)
//     Rules are tried in ORDER at each position; first match wins.
//     A matched run of length 0 is never emitted (prevents infinite loops).
//     Returns a list of [name, lexeme] pairs (SKIP tokens are omitted).
//
//   lex_tokenize_default(text: string) -> list
//     Convenience tokenizer with built-in rules (in order):
//       NUMBER = maximal digit run
//       IDENT  = maximal letter run
//       WS     = maximal whitespace run (SKIP — not emitted)
//       OP     = single punct char
//     Returns list of [name, lexeme] pairs.
//
//   lex_new() -> dict
//     Create an empty rule accumulator dict (helper for building rule lists).
//     Fields: rules (list).
//
//   lex_add_rule(acc: dict, name: string, kind: string, hint: string)
//     Append a rule [name, kind, hint] to the accumulator's rule list.
//
//   lex_rules(acc: dict) -> list
//     Extract the rule list from an accumulator for use with lex_tokenize.

// ---------------------------------------------------------------------------
// PRIVATE: try to match one rule at position pos in text.
// Returns the length of the match (0 = no match).
// ---------------------------------------------------------------------------
fn _lex_match_rule(text: string, n: int, pos: int, kind: string, hint: string) -> int
    if kind == "digits"
        let run = 0
        let i = pos
        while i < n
            let c = char_at(text, i)
            if is_digit(c)
                run += 1
                i += 1
            else
                i = n  // break
        return run
    if kind == "letters"
        let run = 0
        let i = pos
        while i < n
            let c = char_at(text, i)
            if is_alpha(c)
                run += 1
                i += 1
            else
                i = n  // break
        return run
    if kind == "space"
        let run = 0
        let i = pos
        while i < n
            let c = char_at(text, i)
            if is_space(c)
                run += 1
                i += 1
            else
                i = n  // break
        return run
    if kind == "alnum"
        let run = 0
        let i = pos
        while i < n
            let c = char_at(text, i)
            if is_alnum(c)
                run += 1
                i += 1
            else
                i = n  // break
        return run
    if kind == "punct"
        if pos < n
            let c = char_at(text, pos)
            if is_space(c)
                return 0
            if is_alnum(c)
                return 0
            return 1
        return 0
    if kind == "exact"
        let hlen = len(hint)
        if hlen == 0
            return 0
        if pos + hlen > n
            return 0
        let sub = slice(text, pos, pos + hlen)
        if sub == hint
            return hlen
        return 0
    // unknown kind: no match
    0

// ---------------------------------------------------------------------------
// lex_tokenize -- tokenize text using ordered rule list.
// rules: list of [name, kind, hint]
// ---------------------------------------------------------------------------
fn lex_tokenize(text: string, rules: list) -> list
    let tokens = []
    let n = len(text)
    let nr = len(rules)
    let pos = 0
    while pos < n
        // Try each rule in order; pick the FIRST that matches (len > 0).
        let matched = 0
        let ri = 0
        while ri < nr and matched == 0
            let rule = rules[ri]
            let rname = rule[0]
            let rkind = rule[1]
            let rhint = rule[2]
            let mlen = _lex_match_rule(text, n, pos, rkind, rhint)
            if mlen > 0
                let lexeme = slice(text, pos, pos + mlen)
                if rname != "SKIP"
                    let tok = [rname, lexeme]
                    push(tokens, tok)
                pos += mlen
                matched = 1
            else
                ri += 1
        // If no rule matched, skip one character (unknown/unrecognized)
        if matched == 0
            pos += 1
    tokens

// ---------------------------------------------------------------------------
// lex_tokenize_default -- NUMBER / IDENT / WS(skip) / OP
// ---------------------------------------------------------------------------
fn lex_tokenize_default(text: string) -> list
    let rules = []
    push(rules, ["NUMBER", "digits",  ""])
    push(rules, ["IDENT",  "letters", ""])
    push(rules, ["SKIP",   "space",   ""])
    push(rules, ["OP",     "punct",   ""])
    lex_tokenize(text, rules)

// ---------------------------------------------------------------------------
// Rule accumulator helpers
// ---------------------------------------------------------------------------

// lex_new() -> dict with empty rules list
fn lex_new() -> dict
    let acc = {}
    acc["rules"] = []
    acc

// lex_add_rule(acc, name, kind, hint) -- append rule to accumulator
fn lex_add_rule(acc: dict, name: string, kind: string, hint: string)
    let rule = [name, kind, hint]
    push(acc["rules"], rule)

// lex_rules(acc) -> list of rules
fn lex_rules(acc: dict) -> list
    acc["rules"]
