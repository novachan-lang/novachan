// std/automata/cellular — Elementary 1D Cellular Automaton (Wolfram rules)
//
// Implements Wolfram's elementary cellular automata: a 1D binary grid where
// each cell's next state is determined by its own state and its two neighbors.
// The rule number (0-255) encodes all 8 possible 3-cell neighborhood outcomes
// as bits: bit N of rule = output when the 3-cell neighborhood pattern is N.
//
// Wrap-around (toroidal) boundary: leftmost cell's left neighbor is the
// rightmost cell, and vice versa.
//
// All public functions are prefixed ca_.

// ca_from_string converts a string of '#'/'.' or '1'/'0' characters into
// a list of ints (1=alive, 0=dead). Any other character maps to 0.
fn ca_from_string(s) -> list
    let n = len(s)
    let result = []
    for i in 0..n
        let ch = slice(s, i, i + 1)
        let v = 1 if (ch == "#" or ch == "1") else 0
        result.push(v)
    return result

// ca_to_string converts a 0/1 int list to a string ('#' for 1, '.' for 0).
fn ca_to_string(cells) -> string
    let n = len(cells)
    let out_parts = []
    for i in 0..n
        // Use int() to coerce any-boxed list elements to plain integers.
        let v = int(cells[i])
        push(out_parts, "#" if v == 1 else ".")
    let out = join(out_parts, "")
    return out

// ca_rule_bit returns the output bit for the given Wolfram rule number and a
// 3-cell neighborhood encoded as an integer pattern (0..7).
// pattern = left*4 + center*2 + right  (Wolfram convention)
// Implements (rule >> pattern) & 1 via an if-chain (avoids nested-while bugs).
fn ca_rule_bit(rnum, pat8) -> int
    let shifted = rnum
    if pat8 == 1
        shifted = rnum / 2
    else if pat8 == 2
        shifted = rnum / 4
    else if pat8 == 3
        shifted = rnum / 8
    else if pat8 == 4
        shifted = rnum / 16
    else if pat8 == 5
        shifted = rnum / 32
    else if pat8 == 6
        shifted = rnum / 64
    else if pat8 == 7
        shifted = rnum / 128
    return shifted % 2

// ca_step advances the cellular automaton by one generation.
// cells: list of 0/1 ints; rule: Wolfram rule number (0-255).
// Returns a new list of 0/1 ints (same length), with wrap-around edges.
fn ca_step(cells, rule) -> list
    let n = len(cells)
    let next = []
    // Coerce rule to a plain integer once (it may arrive as any-boxed).
    let irule = int(rule)
    for i in 0..n
        // Wrap-around indices via modulo arithmetic.
        let li = (i - 1 + n) % n
        let ri = (i + 1) % n
        // Coerce list elements: list indexing returns any; int() strips boxing.
        let lv = int(cells[li])
        let cv = int(cells[i])
        let rv = int(cells[ri])
        // Wolfram pattern: left is bit 2, center bit 1, right bit 0.
        let pat = int(lv * 4 + cv * 2 + rv)
        let bit = ca_rule_bit(irule, pat)
        next.push(bit)
    return next

// ca_run runs the automaton for the given number of generations.
// Returns a list of `generations` entries; each is a 0/1 int list representing
// one stepped generation (the initial state is NOT included).
fn ca_run(initial, rule, generations) -> list
    let result = []
    let current = initial
    for g in 0..generations
        let next = ca_step(current, rule)
        result.push(next)
        current = next
    return result
