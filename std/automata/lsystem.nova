// std/automata/lsystem — Lindenmayer System (string rewriting)
//
// An L-system rewrites a string (starting from an axiom) by simultaneously
// replacing every symbol according to a table of production rules.
// Symbols with no rule are left unchanged (identity rule).
//
// Representation: a dict with two entries:
//   "axiom" -> string: the initial string
//   "rules" -> dict:   single-char string -> replacement string
//
// All public functions are prefixed ls_.

// Create a new L-system with the given axiom.
fn ls_new(axiom) -> dict
    let sys = {}
    sys["axiom"] = axiom
    sys["rules"] = {}
    return sys

// Add a production rule: symbol (single char) -> replacement string.
fn ls_add_rule(sys, symbol, replacement)
    let r = sys["rules"]
    r[symbol] = replacement
    sys["rules"] = r

// Apply one step of rewriting to string s.
// Each character is looked up in the rules dict; if found it is replaced
// by the production string, otherwise the character passes through unchanged.
fn ls_step(sys, s) -> string
    let r = sys["rules"]
    let n = len(s)
    let i = 0
    let out_parts = []
    while i < n
        let ch = slice(s, i, i + 1)
        if ch in r
            push(out_parts, r[ch])
        if ch not in r
            push(out_parts, ch)
        let i = i + 1
    let out = join(out_parts, "")
    return out

// Generate the string after n steps starting from the axiom.
fn ls_generate(sys, n) -> string
    let s = sys["axiom"]
    let i = 0
    while i < n
        let s = ls_step(sys, s)
        let i = i + 1
    return s

// Return the length of the string after n steps (without materialising intermediate strings beyond what is needed).
// This just calls ls_generate and takes len; for huge n the string can be enormous —
// callers should keep n small.
fn ls_length(sys, n) -> int
    return len(ls_generate(sys, n))
