// std/automata/state_machine.nova — a labeled finite state machine (Mealy-
// style: transitions may carry a named action).
//
// Representation: a dict with four entries:
//   "initial" -> string  the initial state (used by fsm_reset)
//   "current" -> string  the current state
//   "trans"   -> dict    "<fromState>:<event>" -> toState
//   "actions" -> dict    "<fromState>:<event>" -> action_name (only present
//                        for transitions that were given an action)
//
// The transition/action key format concatenates fromState + ":" + event.
// fsm_send on an event with no registered transition from the current state
// is a no-op (the state does not change) and returns "".
//
// Public API (prefix fsm_):
//   fsm_new(initial_state)                      -> dict
//   fsm_add_transition(sm, from, event, to)
//   fsm_add_action(sm, from, event, action_name)
//   fsm_send(sm, event)                         -> string  (action name or "")
//   fsm_state(sm)                               -> string
//   fsm_can_send(sm, event)                     -> bool
//   fsm_valid_events(sm)                        -> list    (events from the current state)
//   fsm_reset(sm)
//
// LEAF — imports nothing.

// fsm_new: create a state machine starting in initial_state.
fn fsm_new(initial_state) -> dict
    let m = {}
    m["initial"] = initial_state
    m["current"] = initial_state
    m["trans"] = {}
    m["actions"] = {}
    return m

// fsm_add_transition: from --event--> to.
// Re-adding the same (from, event) pair overwrites the previous target.
fn fsm_add_transition(sm, from, event, to)
    let key = from + ":" + event
    let tr = sm["trans"]
    tr[key] = to
    sm["trans"] = tr

// fsm_add_action: attach an action name to the (from, event) transition.
// The transition itself must already exist (added via fsm_add_transition);
// this only registers the side-effect label reported by fsm_send.
fn fsm_add_action(sm, from, event, action_name)
    let key = from + ":" + event
    let ac = sm["actions"]
    ac[key] = action_name
    sm["actions"] = ac

// fsm_send: fire event from the current state. If a transition exists,
// moves to its target state and returns the associated action name (or ""
// if none was registered). If no transition exists, the state is
// unchanged and "" is returned.
fn fsm_send(sm, event) -> string
    let cur = sm["current"]
    let key = cur + ":" + event
    let tr = sm["trans"]
    if key in tr
        sm["current"] = tr[key]
        let ac = sm["actions"]
        if key in ac
            return ac[key]
        return ""
    return ""

// fsm_state: the current state name.
fn fsm_state(sm) -> string
    return sm["current"]

// fsm_can_send: true iff event has a registered transition from the
// current state.
fn fsm_can_send(sm, event) -> bool
    let cur = sm["current"]
    let key = cur + ":" + event
    return contains(sm["trans"], key)

// fsm_valid_events: all events with a registered transition from the
// current state (order is not guaranteed to match insertion order, since
// it comes from a dict key scan).
fn fsm_valid_events(sm) -> list
    let cur = sm["current"]
    let prefix = cur + ":"
    let tr = sm["trans"]
    let ks = keys(tr)
    let result = []
    for i in 0..len(ks)
        let k = ks[i]
        if starts_with(k, prefix)
            let ev = slice(k, len(prefix), len(k))
            push(result, ev)
    return result

// fsm_reset: return to the initial state.
fn fsm_reset(sm)
    sm["current"] = sm["initial"]
