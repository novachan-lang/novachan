// std/automata/mealy — Mealy Machine
//
// A Mealy machine produces output on transitions (output depends on
// both current state AND input symbol), in contrast to Moore machines
// where output depends only on the current state.
//
// Representation: a dict with three entries:
//   "start"  -> string: the start state name
//   "trans"  -> dict:   "<state>:<input>" -> list [output, nextState]
//   "states" -> dict:   state_name -> 1  (all known states)
//
// Transition key format: fromState + ":" + inputSymbol.
// Input symbols are single characters (length-1 strings).
// Output per transition can be any string (including multi-char or "").
//
// mly_run concatenates all outputs along the path.
// If a transition is missing the machine is "stuck" and "" is returned.
//
// All public functions are prefixed mly_.

// Create a new Mealy machine with the given start state.
fn mly_new(start) -> dict
    let st = {}
    st[start] = 1
    return {"start": start, "trans": {}, "states": st}

// Add a transition: in fromState on inputSym emit outputStr and go to nextState.
// Both states are registered in the states set.
fn mly_add(m, fromState, inputSym, outputStr, nextState)
    let key = fromState + ":" + inputSym
    let tr = m["trans"]
    tr[key] = [outputStr, nextState]
    m["trans"] = tr
    let st = m["states"]
    st[fromState] = 1
    st[nextState] = 1
    m["states"] = st

// Run the Mealy machine on input string.
// Returns the concatenation of all outputs along the path,
// or "" if any transition is missing (machine stuck).
fn mly_run(m, input) -> string
    let cur = m["start"]
    let tr = m["trans"]
    let n = len(input)
    let out_parts = []
    for i in 0..n
        let sym = slice(input, i, i + 1)
        let key = cur + ":" + sym
        if key not in tr
            return ""
        let entry = tr[key]
        push(out_parts, entry[0])
        cur = entry[1]
    return join(out_parts, "")
