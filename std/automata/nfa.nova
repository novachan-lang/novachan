// std/automata/nfa.nova — Nondeterministic Finite Automaton with epsilon moves.
//
// Represents an NFA over string states and string symbols.
// Epsilon transitions use the empty symbol "".
// Simulation uses epsilon-closure + subset construction (on-the-fly).
//
// Public API:
//   nfa_new(start)              -> dict  create NFA with given start state
//   nfa_add(m, from, sym, to)   -> void  add transition (sym="" = epsilon)
//   nfa_set_accept(m, state)    -> void  mark state as accepting
//   nfa_accept(m, input)        -> bool  true if NFA accepts input string
//
// Transition storage: m["trans"] is a dict.
//   Key = from_state + ":" + symbol  (states must not contain ":")
//   Value = list of target state strings (may have duplicates; simulation dedupes)
//
// All private helpers are prefixed _nfa_ to avoid collisions.

// _nfa_tkey: build the transition dict key for (state, symbol).
fn _nfa_tkey(state, sym) -> str
    return state + ":" + sym

// _nfa_get_targets: retrieve list of direct (non-epsilon) targets from a state on sym.
// Returns [] if no transition defined.
fn _nfa_get_targets(trans, state, sym) -> list
    let k = _nfa_tkey(state, sym)
    if k in trans
        return trans[k]
    return []

// _nfa_set_in: check whether a string value exists in a list acting as a set.
// Uses a parallel dict (seen) for O(1) lookup.
fn _nfa_set_in(seen, val) -> bool
    return val in seen

// _nfa_eclosure: compute epsilon-closure of a list of starting states.
// Returns a list of reachable states (deduplicated) and a seen-dict for fast lookup.
// We return a 2-element list: [state_list, seen_dict]
fn _nfa_eclosure(trans, start_states) -> list
    let seen = {}
    let result = []
    // use a worklist queue: list + head index
    let queue = []
    let qi = 0
    // seed the queue with start_states
    for si in 0..len(start_states)
        let st = start_states[si]
        if st not in seen
            seen[st] = 1
            result.push(st)
            queue.push(st)
    // BFS over epsilon moves
    while qi < len(queue)
        let cur = queue[qi]
        qi += 1
        // fetch all epsilon targets from cur
        let k = _nfa_tkey(cur, "")
        if k in trans
            let eps_list = trans[k]
            for ei in 0..len(eps_list)
                let nxt = eps_list[ei]
                if nxt not in seen
                    seen[nxt] = 1
                    result.push(nxt)
                    queue.push(nxt)
    return [result, seen]

// _nfa_move: given a set of states (list) and a symbol, return all states reachable
// in one step on that symbol (no epsilon — caller does epsilon-closure after).
fn _nfa_move(trans, state_list, sym) -> list
    let result = []
    let seen = {}
    for i in 0..len(state_list)
        let st = state_list[i]
        let targets = _nfa_get_targets(trans, st, sym)
        for j in 0..len(targets)
            let t = targets[j]
            if t not in seen
                seen[t] = 1
                result.push(t)
    return result

// _nfa_any_accept: check if any state in a list is accepting.
fn _nfa_any_accept(accept_dict, state_list) -> bool
    for i in 0..len(state_list)
        let st = state_list[i]
        if st in accept_dict
            if accept_dict[st] == 1
                return true
    return false

// nfa_new: create a new NFA with the given start state.
// Returns a dict with keys: "start", "trans", "accept".
fn nfa_new(start) -> dict
    let m = {}
    m["start"] = start
    m["trans"] = {}
    m["accept"] = {}
    return m

// nfa_add: add a transition from `from_state` to `to_state` on `sym`.
// Use sym="" for an epsilon transition.
// Multiple calls with the same (from, sym) accumulate targets (NFA semantics).
fn nfa_add(m, from_state, sym, to_state)
    let trans = m["trans"]
    let k = _nfa_tkey(from_state, sym)
    if k in trans
        let lst = trans[k]
        lst.push(to_state)
    else
        let lst2 = []
        lst2.push(to_state)
        trans[k] = lst2

// nfa_set_accept: mark `state` as an accepting state.
fn nfa_set_accept(m, state)
    let acc = m["accept"]
    acc[state] = 1

// nfa_accept: simulate the NFA on `input` string using subset construction.
// Returns true if the NFA accepts the input, false otherwise.
fn nfa_accept(m, input) -> bool
    let trans = m["trans"]
    let acc = m["accept"]
    let start = m["start"]
    // compute epsilon-closure of {start}
    let init_seeds = []
    init_seeds.push(start)
    let ec0 = _nfa_eclosure(trans, init_seeds)
    let cur_states = ec0[0]
    // process each character of input
    let n = len(input)
    for i in 0..n
        let ch = slice(input, i, i + 1)
        // move on ch from all current states
        let moved = _nfa_move(trans, cur_states, ch)
        // epsilon-close the result
        let ec = _nfa_eclosure(trans, moved)
        cur_states = ec[0]
    // accept if any current state is accepting
    return _nfa_any_accept(acc, cur_states)
