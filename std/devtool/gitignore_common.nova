// std/devtool/gitignore_common.nova — ready-made .gitignore TEMPLATE strings for the
// ecosystems a solo developer hits constantly (Python, Node, Java, Rust, Go) plus one
// language-agnostic baseline for OS/editor cruft. Every gic_* function returns already-
// rendered text: a "# Header" comment line followed by one pattern per line, newline-joined —
// exactly gib_render's output shape, so the result can be handed straight to write_file, or
// split back into a pattern list and fed into gib_add_section/gic_merge.
//
// Every template is built from ONE shared table-driven renderer (_gic_build) fed a per-
// ecosystem pattern list — not six hand-written string-concat blocks — so adding or fixing an
// entry never means touching matching logic. Self-contained: imports nothing (does not depend
// on gitignore_build, even though its output is shaped to compose with it — see LIMITATIONS).
//
// PREFIX: gic_
//
// Public API:
//   gic_python()          -> string  __pycache__/, *.pyc, .venv/, dist/, *.egg-info/, .mypy_cache/, ...
//   gic_node()             -> string  node_modules/, dist/, .env, *.log, .cache/, ...
//   gic_java()             -> string  *.class, target/, .gradle/, build/, *.jar, *.war, ...
//   gic_rust()             -> string  target/, *.rlib, *.rmeta, *.d, ...
//   gic_go()                -> string  *.exe, *.test, *.out, vendor/, ...
//   gic_general()           -> string  .DS_Store, Thumbs.db, *.swp, *~, .idea/, .vscode/, ...
//   gic_lines(template)     -> list    splits a template's OWN pattern lines back out (header
//                                       comment dropped) — the inverse of _gic_build, so a
//                                       template can be fed into gib_add_section or gic_merge
//                                       as a plain pattern list.
//   gic_merge(templates)    -> string  concatenates templates (blank-line separated), dropping
//                                       every pattern line that already occurred in an earlier
//                                       template (dedup by exact text); comment/header lines are
//                                       always kept so each section stays labeled.
//
// LIMITATIONS: patterns are hand-curated for the common real-world case per ecosystem — this
// is not an exhaustive mirror of github/gitignore's community templates, and there is no
// single canonical ".gitignore" for any language to begin with. Dedup in gic_merge compares
// pattern TEXT exactly; "*.log" and "*.LOG" are treated as different patterns (as real git
// does on a case-sensitive filesystem).

// _gic_build(header, patterns) -> string : "# header" then one pattern per line, newline-joined.
fn _gic_build(header: string, patterns: list) -> string
    let lines = []
    push(lines, "# " + header)
    let i = 0
    let n = len(patterns)
    while i < n
        push(lines, patterns[i])
        i += 1
    return join(lines, "\n")

// gic_python() -> string
fn gic_python() -> string
    return _gic_build("Python", ["__pycache__/", "*.py[cod]", "*.pyo", "*.pyd", ".Python", "*.egg-info/", ".eggs/", "dist/", "build/", ".venv/", "venv/", "env/", ".mypy_cache/", ".pytest_cache/", ".ruff_cache/", ".tox/", ".coverage", "htmlcov/"])

// gic_node() -> string
fn gic_node() -> string
    return _gic_build("Node", ["node_modules/", "dist/", "build/", ".env", ".env.local", "*.log", "npm-debug.log*", "yarn-debug.log*", "yarn-error.log*", ".cache/", ".next/", ".nuxt/", "coverage/"])

// gic_java() -> string
fn gic_java() -> string
    return _gic_build("Java", ["*.class", "target/", "build/", ".gradle/", ".mvn/", "*.jar", "*.war", "*.ear", "*.nar", "hs_err_pid*.log", ".idea/", "*.iml"])

// gic_rust() -> string
fn gic_rust() -> string
    return _gic_build("Rust", ["target/", "*.rlib", "*.rmeta", "*.d", "**/*.rs.bk"])

// gic_go() -> string
fn gic_go() -> string
    return _gic_build("Go", ["*.exe", "*.exe~", "*.dll", "*.so", "*.dylib", "*.test", "*.out", "vendor/", "go.work", "go.work.sum"])

// gic_general() -> string
fn gic_general() -> string
    return _gic_build("General", [".DS_Store", "Thumbs.db", "*.swp", "*.swo", "*~", ".idea/", ".vscode/", "*.log", ".env"])

// gic_lines(template) -> list : splits a rendered template back into just its pattern lines
// (the leading "# Header" comment line is dropped; every other line, including any blank
// separator a caller may have appended, is kept verbatim).
fn gic_lines(template: string) -> list
    let all_lines = split(template, "\n")
    let out = []
    let i = 0
    let n = len(all_lines)
    while i < n
        if i > 0
            push(out, all_lines[i])
        i += 1
    return out

// gic_merge(templates) -> string
// Concatenates `templates` (each a gic_* result), separating them with a blank line, while
// dropping any pattern line whose exact text already appeared earlier in the merge. Comment
// ("# ...") and blank lines are never deduped — they're kept so every section stays labeled.
fn gic_merge(templates: list) -> string
    let out = []
    let seen = {}
    let ti = 0
    let tn = len(templates)
    while ti < tn
        if ti > 0
            push(out, "")
        let lines = split(templates[ti], "\n")
        let li = 0
        let ln = len(lines)
        while li < ln
            let line = lines[li]
            let t = trim(line)
            let is_pattern = 0
            if len(t) > 0
                if slice(t, 0, 1) != "#"
                    is_pattern = 1
            if is_pattern == 1
                if t in seen == 0
                    seen[t] = 1
                    push(out, line)
            else
                push(out, line)
            li += 1
        ti += 1
    return join(out, "\n")
