// std/devtool/gitignore_parse — parse raw .gitignore file text into
// structured pattern records.
//
// WHAT: turns the raw text of a .gitignore file into a list of pattern
// records ready for a matcher (see gitignore_star / gitignore_negate /
// gitignore_layer for the actual wildcard matching). Per gitignore's
// documented line-parsing rules (git-scm.com/docs/gitignore):
//   - blank lines and lines whose first non-space character is "#" are
//     comments/spacers and are skipped entirely (never emitted as records)
//   - trailing whitespace is stripped, UNLESS the space immediately before
//     the trailing run is escaped with a backslash ("\ "), in which case
//     one space is kept
//   - a leading "!" negates the pattern (stripped from the body)
//   - a trailing "/" marks a directory-only pattern (stripped from the body)
//   - a "/" anywhere in the remaining body (leading, or internal) anchors
//     the pattern to the directory containing the .gitignore file; a body
//     with no "/" is unanchored and may match at any depth
//   - a leading "/" left after the checks above is stripped from the body
//     (it only served to mark the pattern as anchored)
//
// LEAF module: imports nothing (self-contained).
//
// PREFIX: gip_
//
// Record shape (a plain list, positional):
//   [body: string, negated: int, dir_only: int, anchored: int, line_num: int]
//
// Public API:
//   gip_is_blank(line)              -> int    1 if the trimmed line is empty
//   gip_is_comment(line)            -> int    1 if the trimmed line starts with "#"
//   gip_strip_trailing_spaces(line) -> string strips trailing UNESCAPED spaces
//   gip_parse_line(line, line_num)  -> list   [] for blank/comment lines,
//                                              else a single-element list
//                                              holding one record
//   gip_parse(text)                 -> list   every record in `text`, in
//                                              file order, 1-based line_num
//
// LIMITATIONS: only the trailing-space backslash-escape is honored; other
// backslash-escapes (e.g. an escaped leading "#" or "!") are not unescaped —
// the body is passed through with the backslash still in place. Leading
// whitespace on a line is never trimmed (real gitignore trims it unless
// escaped; that nuance is not implemented here).

// gip_is_blank(line) -> int
// 1 if the trimmed line has no characters left.
fn gip_is_blank(line) -> int
    let t = trim(line)
    if len(t) == 0
        return 1
    return 0

// gip_is_comment(line) -> int
// 1 if the trimmed line's first character is "#".
fn gip_is_comment(line) -> int
    let t = trim(line)
    if len(t) == 0
        return 0
    if slice(t, 0, 1) == "#"
        return 1
    return 0

// gip_strip_trailing_spaces(line) -> string
// Strips a trailing run of space characters, except that when the character
// immediately before that run is a backslash (chr(92)), one space is kept
// (the backslash itself is left in place — see module LIMITATIONS). A line
// with no trailing spaces is returned unchanged.
fn gip_strip_trailing_spaces(line) -> string
    let n = len(line)
    let end = n
    while end > 0 and slice(line, end - 1, end) == " "
        end -= 1
    if end == n
        return line
    if end > 0 and slice(line, end - 1, end) == chr(92)
        return slice(line, 0, end) + " "
    return slice(line, 0, end)

// _gip_has_slash(s) -> int
// 1 if s contains the character "/" anywhere (private helper).
fn _gip_has_slash(s) -> int
    let n = len(s)
    for i in 0..n
        if slice(s, i, i + 1) == "/"
            return 1
    return 0

// gip_parse_line(line, line_num) -> list
// Parses one raw .gitignore line into [] (blank/comment) or a single-element
// list holding its record — see module header for the field rules.
fn gip_parse_line(line, line_num) -> list
    let out = []
    if gip_is_blank(line) == 1
        return out
    if gip_is_comment(line) == 1
        return out
    let body = gip_strip_trailing_spaces(line)
    let negated = 0
    if len(body) > 0 and slice(body, 0, 1) == "!"
        negated = 1
        body = slice(body, 1, len(body))
    let dir_only = 0
    let bn = len(body)
    if bn > 0 and slice(body, bn - 1, bn) == "/"
        dir_only = 1
        body = slice(body, 0, bn - 1)
    let anchored = 0
    if _gip_has_slash(body) == 1
        anchored = 1
    if len(body) > 0 and slice(body, 0, 1) == "/"
        body = slice(body, 1, len(body))
    let record = [body, negated, dir_only, anchored, line_num]
    push(out, record)
    return out

// gip_parse(text) -> list
// Splits `text` on "\n" and parses every line via gip_parse_line, collecting
// all resulting records in file order (blank/comment lines contribute none).
// Line numbers are 1-based and count every physical line, including blanks
// and comments.
fn gip_parse(text) -> list
    let out = []
    let lines = split(text, "\n")
    let n = len(lines)
    for i in 0..n
        let recs = gip_parse_line(lines[i], i + 1)
        for r in recs
            push(out, r)
    return out
