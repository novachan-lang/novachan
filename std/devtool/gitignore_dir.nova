// std/devtool/gitignore_dir.nova — directory-only pattern handling for .gitignore-style
// pattern lists. Per the gitignore spec, a pattern ending in "/" matches directories only
// and is never applied to plain files. This module classifies and filters patterns on that
// axis; it does not itself perform wildcard matching (see gitignore_layer / gitignore_explain
// for the full matcher). Self-contained: imports nothing.
//
// PUBLIC API:
//   gid_is_dir_only(pattern)          -> int     1 if pattern ends with a single trailing "/"
//   gid_strip_trailing_slash(pattern) -> string  pattern with one trailing "/" removed
//   gid_should_check(pattern, is_dir) -> int     1 if pattern is applicable to a target of
//                                                 this directory-ness
//   gid_classify(patterns)            -> list    [dir_only_patterns, universal_patterns]
//
// LIMITATIONS: does not interpret an escaped trailing slash ("\/") — git itself treats that
// as a rare edge case; here a trailing "/" is always read as the directory-only marker,
// regardless of a preceding backslash.

// gid_is_dir_only(pattern) -> int
// 1 if `pattern` ends with "/". An empty pattern is never directory-only.
fn gid_is_dir_only(pattern: string) -> int
    let n = len(pattern)
    if n == 0
        return 0
    if slice(pattern, n - 1, n) == "/"
        return 1
    return 0

// gid_strip_trailing_slash(pattern) -> string
// Removes exactly one trailing "/" if present; otherwise returns `pattern` unchanged.
fn gid_strip_trailing_slash(pattern: string) -> string
    let n = len(pattern)
    if n == 0
        return pattern
    if slice(pattern, n - 1, n) == "/"
        return slice(pattern, 0, n - 1)
    return pattern

// gid_should_check(pattern, is_dir) -> int
// 1 if `pattern` is eligible to be tested against a target whose directory-ness is `is_dir`
// (1 = directory, 0 = file). Directory-only patterns (trailing "/") apply only when
// is_dir == 1. Every other pattern applies to both files and directories.
fn gid_should_check(pattern: string, is_dir: int) -> int
    if gid_is_dir_only(pattern) == 1
        if is_dir == 1
            return 1
        return 0
    return 1

// gid_classify(patterns) -> list
// Splits `patterns` into [dir_only_patterns, universal_patterns], preserving each bucket's
// relative order. Blank lines and comment lines (first non-space char "#") are skipped
// entirely — they are not real patterns. Patterns are returned UNCHANGED (trailing "/"
// retained, "!" negation prefix retained) so callers can recover the original line.
fn gid_classify(patterns: list) -> list
    let dir_only = []
    let universal = []
    let n = len(patterns)
    for i in 0..n
        let p = patterns[i]
        let t = trim(p)
        if len(t) > 0 and slice(t, 0, 1) != "#"
            if gid_is_dir_only(p) == 1
                push(dir_only, p)
            else
                push(universal, p)
    return [dir_only, universal]
