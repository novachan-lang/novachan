// std/text/acronym -- acronym and initialism helpers. LEAF -- imports NOTHING.
//
// Public API:
//   ac_acronym(phrase: string) -> string
//     First letter of each whitespace-delimited word, uppercased, joined.
//     Empty tokens (multiple spaces) are skipped. Returns "" for empty input.
//
//   ac_initials(name: string, sep: string) -> string
//     Like ac_acronym but joins initials with sep.
//     "John Ronald Reuel" sep="." -> "J.R.R."
//
//   ac_abbreviate(phrase: string, small_words_lowercased: int) -> string
//     Like ac_acronym but skips common small words (a/an/the/of/and/for/to/in/on).
//     small_words_lowercased=1 to enable skipping; pass 0 to skip none (same as ac_acronym).
//     Matching is case-insensitive: "The" and "THE" are both skipped.

// PRIVATE: check if a word (lowercased) is a small word to skip.
fn _ac_is_small(w: string) -> int
    if w == "a"
        return 1
    if w == "an"
        return 1
    if w == "the"
        return 1
    if w == "of"
        return 1
    if w == "and"
        return 1
    if w == "for"
        return 1
    if w == "to"
        return 1
    if w == "in"
        return 1
    if w == "on"
        return 1
    0

// PRIVATE: extract initials from phrase words, optionally skipping small words.
// Returns list of uppercase single-char strings.
fn _ac_collect(phrase: string, skip_small: int) -> list
    let n = len(phrase)
    let result = []
    let i = 0
    // Walk through phrase, extracting the first character of each word.
    // A word starts after whitespace (or at position 0) and is any non-space run.
    let in_word = 0
    let word_start = 0
    while i <= n
        let at_space = 0
        if i == n
            at_space = 1
        else
            let c = char_at(phrase, i)
            if c == " " or c == chr(9) or c == chr(10) or c == chr(13)
                at_space = 1
        if at_space == 1
            if in_word == 1
                // We just ended a word from word_start..i
                let first_ch = char_at(phrase, word_start)
                // Build the full word for small-word check (lowercase it)
                let word_lower = lower(slice(phrase, word_start, i))
                let skip = 0
                if skip_small == 1
                    if _ac_is_small(word_lower) == 1
                        skip = 1
                if skip == 0
                    push(result, upper(slice(phrase, word_start, word_start + 1)))
                in_word = 0
        else
            if in_word == 0
                in_word = 1
                word_start = i
        i = i + 1
    result

// ac_acronym("Portable Network Graphics") -> "PNG"
// ac_acronym("you only live once") -> "YOLO"
// ac_acronym("  multiple   spaces  here ") -> "MSH"
// ac_acronym("") -> ""
// ac_acronym("hello") -> "H"
fn ac_acronym(phrase: string) -> string
    let parts = _ac_collect(phrase, 0)
    let out = ""
    let i = 0
    while i < len(parts)
        out = out + parts[i]
        i = i + 1
    out

// ac_initials("John Ronald Reuel", ".") -> "J.R.R."
// Joins initials with sep; trailing sep IS included (standard initials notation).
fn ac_initials(name: string, sep: string) -> string
    let parts = _ac_collect(name, 0)
    let out = ""
    let i = 0
    while i < len(parts)
        out = out + parts[i] + sep
        i = i + 1
    // strip trailing sep if sep is non-empty and we added at least one initial
    // Actually standard initials "J.R.R." KEEP the trailing dot -- matches KAT.
    out

// ac_abbreviate("The Lord of the Rings") -> "LR"
// Skips a/an/the/of/and/for/to/in/on (case-insensitive) when small_words_lowercased=1.
fn ac_abbreviate(phrase: string, small_words_lowercased: int) -> string
    let parts = _ac_collect(phrase, small_words_lowercased)
    let out = ""
    let i = 0
    while i < len(parts)
        out = out + parts[i]
        i = i + 1
    out
