// ============================================================================
// NOVA Standard Library — std/text/langdetect
// ============================================================================
// Character-trigram-profile language detection for en/es/fr/de.
//
// Public API:
//   ld_char_trigrams(text)    -> any: list of lowercased letter trigrams
//   ld_profile(text)          -> any: dict trigram->relative_frequency
//   ld_reference(lang)        -> any: built-in trigram profile dict for lang
//   ld_score(text,lang)       -> float: overlap score vs reference profile
//   ld_detect(text)           -> string: best-matching lang code
//   ld_detect_top(text,k)     -> any: top-k list of [lang, score] pairs
//   ld_is_english(text)       -> bool: ld_detect(text) == 'en'
//   ld_supported()            -> any: ['en','es','fr','de']
//   ld_confidence(text)       -> float: top_score / total_score (0..1)
//   ld_trigram_count(text)    -> int: len(ld_char_trigrams(text))
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _ld_lower_char: lowercase one ASCII char code
fn _ld_lower_char(o) -> int
    if o >= 65 and o <= 90
        return o + 32
    o

// _ld_lower: lowercase an ASCII string
fn _ld_lower(s) -> string
    let n = len(s)
    let out = ""
    for i in 0..n
        let o = ord(slice(s, i, i + 1))
        let lo = _ld_lower_char(o)
        out = out + chr(lo)
    out

// _ld_is_letter: true if ASCII letter a-z (after lowercasing) or space
fn _ld_is_letter_or_space(o) -> bool
    if o >= 97 and o <= 122
        return true
    if o == 32
        return true
    false

// _ld_normalize_text: lowercase + keep only letters and spaces; collapse spaces
fn _ld_normalize(s) -> string
    let lower = _ld_lower(s)
    let n = len(lower)
    let out_parts = []
    let prev_space = true
    for i in 0..n
        let o = ord(slice(lower, i, i + 1))
        if o >= 97 and o <= 122
            push(out_parts, chr(o))
            prev_space = false
        else
            if not prev_space
                push(out_parts, " ")
                prev_space = true
    let out = join(out_parts, "")
    // trim trailing space
    let nl = len(out)
    if nl > 0
        let last = ord(slice(out, nl - 1, nl))
        if last == 32
            out = slice(out, 0, nl - 1)
    out

// ── public API ───────────────────────────────────────────────────────────────

// ld_char_trigrams: sliding window of 3 over letters+spaces in text.
// Returns a list of 3-char strings.
fn ld_char_trigrams(text) -> any
    let norm = _ld_normalize(text)
    let n = len(norm)
    let result = []
    let i = 0
    while i + 2 < n
        push(result, slice(norm, i, i + 3))
        i = i + 1
    result

// ld_profile: dict trigram -> relative frequency (count/total_count).
// Returns empty dict if no trigrams.
fn ld_profile(text) -> any
    let tris = ld_char_trigrams(text)
    let total = len(tris)
    let d = {}
    for i in 0..total
        let t = tris[i]
        if contains(d, t)
            d[t] = d[t] + 1
        else
            d[t] = 1
    if total == 0
        return d
    // normalize
    let out = {}
    let ks = keys(d)
    for j in 0..len(ks)
        let k = ks[j]
        let freq = (d[k] * 1.0) / (total * 1.0)
        out[k] = freq
    out

// ld_reference: built-in trigram profile for a lang code.
// Hardcoded characteristic trigrams from real frequency analysis.
// Returns empty dict for unknown lang.
fn ld_reference(lang) -> any
    let d = {}
    if lang == "en"
        d["the"] = 0.15
        d["and"] = 0.09
        d["ing"] = 0.08
        d["ion"] = 0.07
        d["tio"] = 0.06
        d["ent"] = 0.06
        d["hat"] = 0.05
        d["tha"] = 0.05
        d["ere"] = 0.05
        d["her"] = 0.05
        d["his"] = 0.04
        d["for"] = 0.04
        d["ter"] = 0.04
        d["nth"] = 0.03
        d["wit"] = 0.03
        return d
    if lang == "es"
        d["que"] = 0.12
        d["los"] = 0.10
        d["ado"] = 0.09
        d["ent"] = 0.08
        d["cio"] = 0.07
        d["las"] = 0.07
        d["des"] = 0.06
        d["est"] = 0.06
        d["par"] = 0.05
        d["con"] = 0.05
        d["del"] = 0.05
        d["una"] = 0.04
        d["ion"] = 0.04
        d["ara"] = 0.04
        d["ero"] = 0.03
        return d
    if lang == "fr"
        d["les"] = 0.12
        d["ent"] = 0.10
        d["ion"] = 0.09
        d["que"] = 0.08
        d["des"] = 0.08
        d["est"] = 0.07
        d["ons"] = 0.06
        d["our"] = 0.05
        d["ant"] = 0.05
        d["par"] = 0.05
        d["sur"] = 0.04
        d["une"] = 0.04
        d["pas"] = 0.04
        d["ait"] = 0.03
        d["its"] = 0.03
        return d
    if lang == "de"
        d["der"] = 0.12
        d["ein"] = 0.10
        d["und"] = 0.10
        d["sch"] = 0.09
        d["cht"] = 0.08
        d["ich"] = 0.08
        d["die"] = 0.07
        d["ung"] = 0.07
        d["eit"] = 0.06
        d["den"] = 0.06
        d["des"] = 0.05
        d["ers"] = 0.05
        d["nen"] = 0.05
        d["gen"] = 0.04
        d["auf"] = 0.04
        return d
    d

// ld_score: dot-product of text trigram profile against reference profile.
// Higher = more similar to that language.
fn ld_score(text, lang) -> float
    let prof = ld_profile(text)
    let ref = ld_reference(lang)
    let score = 0.0
    let ks = keys(prof)
    for i in 0..len(ks)
        let k = ks[i]
        if contains(ref, k)
            let pv = prof[k]
            let rv = ref[k]
            score = score + pv * rv
    score

// ld_detect: return the lang code with the highest ld_score.
// Returns 'en' as default if no trigrams found.
fn ld_detect(text) -> string
    let langs = ld_supported()
    let best_lang = "en"
    let best_score = 0.0 - 1.0
    for i in 0..len(langs)
        let lang = langs[i]
        let s = ld_score(text, lang)
        if s > best_score
            best_score = s
            best_lang = lang
    best_lang

// ld_detect_top: top-k [lang, score] pairs sorted descending by score.
fn ld_detect_top(text, k) -> any
    let langs = ld_supported()
    // collect all scores
    let scores = []
    let score_vals = []
    for i in 0..len(langs)
        let s = ld_score(text, langs[i])
        push(scores, langs[i])
        push(score_vals, s)
    // selection sort descending
    let n = len(scores)
    for j in 0..n
        let max_idx = j
        let m = j + 1
        while m < n
            if score_vals[m] > score_vals[max_idx]
                max_idx = m
            m = m + 1
        // swap j and max_idx
        let tmp_lang = scores[j]
        let tmp_score = score_vals[j]
        scores[j] = scores[max_idx]
        score_vals[j] = score_vals[max_idx]
        scores[max_idx] = tmp_lang
        score_vals[max_idx] = tmp_score
    // build result list of [lang, score] pairs (as 2-elem lists)
    let result = []
    let take = k
    if take > n
        take = n
    for r in 0..take
        let pair = []
        push(pair, scores[r])
        push(pair, score_vals[r])
        push(result, pair)
    result

// ld_is_english: true if ld_detect returns 'en'.
fn ld_is_english(text) -> bool
    let d = ld_detect(text)
    if d == "en"
        return true
    false

// ld_supported: list of supported lang codes.
fn ld_supported() -> any
    let result = []
    push(result, "en")
    push(result, "es")
    push(result, "fr")
    push(result, "de")
    result

// ld_confidence: top_score / sum_of_all_scores. Returns 0.0 if total is 0.
fn ld_confidence(text) -> float
    let langs = ld_supported()
    let total = 0.0
    let top_s = 0.0 - 1.0
    for i in 0..len(langs)
        let s = ld_score(text, langs[i])
        if s > top_s
            top_s = s
        total = total + s
    if total <= 0.0
        return 0.0
    let conf = top_s / total
    conf

// ld_trigram_count: number of trigrams extracted from text.
fn ld_trigram_count(text) -> int
    let tris = ld_char_trigrams(text)
    len(tris)

fn main()
    print("std/text/langdetect loaded")
