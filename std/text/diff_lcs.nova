// ============================================================================
// NOVA Standard Library — std/text/diff_lcs
// ============================================================================
// Longest Common Subsequence (LCS) on arbitrary lists of elements.
//
// Public API:
//   lcs(a_list, b_list) -> list
//       Returns one valid LCS as a list of elements (the common subsequence).
//       Elements are compared with ==; works for lists of strings, ints, etc.
//
//   lcs_len(a_list, b_list) -> int
//       Returns the length of the LCS. Uses two rolling rows — O(n) space.
//
//   lcs_str(a, b) -> string
//       Returns one valid LCS of the characters of strings a and b.
//       lcs_str("ABCBDAB","BDCAB") has length 4 (e.g. "BCAB").
//       lcs_str("abc","abc") == "abc".
//       lcs_str("abc","xyz") == "".
//
// All three use the classic O(m*n) Hirschberg / DP algorithm.
// lcs_len uses two rolling rows (O(n) space).
// lcs and lcs_str store the full (m+1)*(n+1) table for backtracking.
//
// Interoperability:
//   The shared edit-script format [tag, line] uses "=", "-", "+" tags.
//   lcs() + lcs_len() are the foundation for diff_seq and patch modules.
// ============================================================================

// ── Private: full DP table ────────────────────────────────────────────────────

// _dl_dp builds the full (m+1)*(n+1) LCS DP table for two lists.
// Returns a flat int list, row-major: dp[i*(n+1)+j] = LCS of a[0..i-1], b[0..j-1].
// Element comparison uses ==.
fn _dl_dp(a, b)
    let m = len(a)
    let n = len(b)
    let sz = (m + 1) * (n + 1)
    let dp = []
    let fill = 0
    while fill < sz
        dp.push(0)
        fill = fill + 1
    let i = 1
    while i <= m
        let j = 1
        while j <= n
            let idx = i * (n + 1) + j
            if a[i - 1] == b[j - 1]
                let diag = dp[(i - 1) * (n + 1) + (j - 1)] + 1
                dp[idx] = diag
            else
                let from_top  = dp[(i - 1) * (n + 1) + j]
                let from_left = dp[i * (n + 1) + (j - 1)]
                if from_top >= from_left
                    dp[idx] = from_top
                else
                    dp[idx] = from_left
            j = j + 1
        i = i + 1
    dp

// _dl_dp_str builds the full (m+1)*(n+1) LCS DP table for two strings,
// comparing character by character.
fn _dl_dp_str(a, b)
    let m = len(a)
    let n = len(b)
    let sz = (m + 1) * (n + 1)
    let dp = []
    let fill = 0
    while fill < sz
        dp.push(0)
        fill = fill + 1
    let i = 1
    while i <= m
        let j = 1
        while j <= n
            let idx = i * (n + 1) + j
            let ca = ord(a[i - 1])
            let cb = ord(b[j - 1])
            if ca == cb
                let diag = dp[(i - 1) * (n + 1) + (j - 1)] + 1
                dp[idx] = diag
            else
                let from_top  = dp[(i - 1) * (n + 1) + j]
                let from_left = dp[i * (n + 1) + (j - 1)]
                if from_top >= from_left
                    dp[idx] = from_top
                else
                    dp[idx] = from_left
            j = j + 1
        i = i + 1
    dp

// ── Public API ────────────────────────────────────────────────────────────────

// lcs_len returns the length of the LCS of a_list and b_list.
// Uses two rolling rows: O(m*n) time, O(n) space.
// Element comparison uses ==.
fn lcs_len(a_list, b_list) -> int
    let m = len(a_list)
    let n = len(b_list)
    if m == 0 or n == 0
        return 0
    // prev[j] = LCS("", b[0..j-1]) = 0.
    let prev = []
    let j = 0
    while j <= n
        prev.push(0)
        j = j + 1
    let i = 1
    while i <= m
        let curr = []
        curr.push(0)
        let k = 1
        while k <= n
            let v = 0
            if a_list[i - 1] == b_list[k - 1]
                v = prev[k - 1] + 1
            else
                v = prev[k]
                if curr[k - 1] > v
                    v = curr[k - 1]
            curr.push(v)
            k = k + 1
        prev = curr
        i = i + 1
    prev[n]

// lcs returns one valid LCS of a_list and b_list as a list of elements.
// Builds the full (m+1)*(n+1) DP table then backtracks.
// Backtracking: when scores tie (top == left), prefer going UP (consuming from a),
// which produces a left-biased LCS consistent with BCAB for the classic example.
fn lcs(a_list, b_list)
    let m = len(a_list)
    let n = len(b_list)
    if m == 0 or n == 0
        return []

    let dp = _dl_dp(a_list, b_list)

    // Backtrack from (m, n) to (0, 0), collecting matches in reverse.
    let rev = []
    let bi = m
    let bj = n
    while bi > 0 and bj > 0
        if a_list[bi - 1] == b_list[bj - 1]
            rev.push(a_list[bi - 1])
            bi = bi - 1
            bj = bj - 1
        else
            let up_val   = dp[(bi - 1) * (n + 1) + bj]
            let left_val = dp[bi * (n + 1) + (bj - 1)]
            if up_val >= left_val
                bi = bi - 1
            else
                bj = bj - 1

    // Reverse rev to get LCS in forward order.
    let result = []
    let rlen = len(rev)
    let ri = rlen - 1
    while ri >= 0
        result.push(rev[ri])
        ri = ri - 1
    result

// lcs_str returns one valid LCS of the characters of strings a and b.
// Builds the full DP table (character-level) then backtracks.
// lcs_str("ABCBDAB","BDCAB") -> length 4 (e.g. "BCAB").
// lcs_str("abc","abc") -> "abc".
// lcs_str("abc","xyz") -> "".
fn lcs_str(a, b) -> string
    let m = len(a)
    let n = len(b)
    if m == 0 or n == 0
        return ""

    let dp = _dl_dp_str(a, b)

    // Backtrack from (m, n) to (0, 0), collecting matching characters in reverse.
    let rev = []
    let bi = m
    let bj = n
    while bi > 0 and bj > 0
        let ca = ord(a[bi - 1])
        let cb = ord(b[bj - 1])
        if ca == cb
            rev.push(a[bi - 1])
            bi = bi - 1
            bj = bj - 1
        else
            let up_val   = dp[(bi - 1) * (n + 1) + bj]
            let left_val = dp[bi * (n + 1) + (bj - 1)]
            if up_val >= left_val
                bi = bi - 1
            else
                bj = bj - 1

    // Reverse rev to produce forward-order LCS string.
    let result = ""
    let rlen = len(rev)
    let ri = rlen - 1
    while ri >= 0
        result = result + rev[ri]
        ri = ri - 1
    result

// ============================================================================
fn main()
    print("std/text/diff_lcs loaded")
