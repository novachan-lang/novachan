// std/text/truncate -- String truncation utilities.
//
// Public API:
//   tr_truncate(s, maxlen, ell) -> string
//       If len(s) <= maxlen return s unchanged.
//       Else return slice(s, 0, maxlen - len(ell)) + ell.
//
//   tr_truncate_words(s, maxwords, ell) -> string
//       Keep at most the first maxwords whitespace-delimited words.
//       If truncated, append ell.  Words are split on single spaces
//       produced by collapsing runs of whitespace (spaces/tabs).
//
//   tr_middle(s, maxlen) -> string
//       If len(s) <= maxlen return s.
//       Else keep a head and a tail with "..." in the middle so that
//       total length equals maxlen.
//       head = (maxlen - 3 + 1) / 2    (integer, rounds toward +inf for odd)
//       tail = maxlen - 3 - head
//
// LEAF -- imports NOTHING.

// PRIVATE: split string s on whitespace (spaces and tabs), dropping empty tokens.
// Returns a list of word strings.
fn _tr_split_words(s: string) -> list
    let words = []
    let cur = ""
    let i = 0
    let n = len(s)
    while i < n
        let ch = char_at(s, i)
        if ch == " " or ch == "\t"
            if len(cur) > 0
                words.push(cur)
                cur = ""
        else
            cur = cur + ch
        i = i + 1
    if len(cur) > 0
        words.push(cur)
    words

// Truncate s to at most maxlen characters.
// If len(s) <= maxlen, return s unchanged.
// Otherwise return the first (maxlen - len(ell)) characters of s followed by ell.
// ell is the ellipsis suffix (e.g. "...").
fn tr_truncate(s: string, maxlen: int, ell: string) -> string
    let result = s
    if len(s) > maxlen
        let keep = maxlen - len(ell)
        if keep < 0
            keep = 0
        result = slice(s, 0, keep) + ell
    result

// Truncate s to at most maxwords whitespace-delimited words.
// If truncated, ell is appended directly (no space before ell).
// If the number of words is <= maxwords, return s unchanged.
fn tr_truncate_words(s: string, maxwords: int, ell: string) -> string
    let words = _tr_split_words(s)
    let total = len(words)
    let result = s
    if total > maxwords
        let out = ""
        let i = 0
        while i < maxwords
            if i > 0
                out = out + " "
            out = out + words[i]
            i = i + 1
        result = out + ell
    result

// Truncate s to maxlen characters keeping head and tail with "..." in the middle.
// If len(s) <= maxlen, return s unchanged.
// head = (maxlen - 3 + 1) / 2  (integer division)
// tail = maxlen - 3 - head
fn tr_middle(s: string, maxlen: int) -> string
    let result = s
    if len(s) > maxlen
        let head = (maxlen - 3 + 1) / 2
        let tail = maxlen - 3 - head
        let slen = len(s)
        let tail_start = slen - tail
        result = slice(s, 0, head) + "..." + slice(s, tail_start, slen)
    result
