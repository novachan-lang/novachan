// std/text/pigify -- Pig Latin translator (classic rules, ASCII words).
//
// Public API:
//   pig_word(w: string) -> string
//       If w starts with a vowel (a e i o u, case-insensitive), append "way".
//       Otherwise move the leading consonant cluster to the end and append "ay".
//       Output is lowercase.
//   pig_sentence(s: string) -> string
//       Pigify each space-separated word and rejoin with spaces.
//
// KAT vectors (hand-computed):
//   pig_word("pig")      -> "igpay"
//   pig_word("banana")   -> "ananabay"
//   pig_word("smile")    -> "ilesmay"
//   pig_word("eat")      -> "eatway"
//   pig_word("apple")    -> "appleway"
//   pig_word("string")   -> "ingstray"
//   pig_sentence("hello world") -> "ellohay orldway"

// Return 1 if the lowercase character c is a vowel (a e i o u), else 0.
fn _pig_is_vowel(c: string) -> int
    if c == "a"
        return 1
    if c == "e"
        return 1
    if c == "i"
        return 1
    if c == "o"
        return 1
    if c == "u"
        return 1
    0

// Lowercase a single ASCII character (A-Z -> a-z, others unchanged).
fn _pig_lower_char(c: string) -> string
    let b = ord(c)
    if b >= 65 and b <= 90
        return chr(b + 32)
    c

// Lowercase an entire string (ASCII only).
fn _pig_lower(s: string) -> string
    let out = ""
    let n = len(s)
    for i in 0..n
        out += _pig_lower_char(s[i])
    out

// Pigify a single word. Output is lowercase.
// Rules:
//   - If the first letter (lowercased) is a vowel, append "way".
//   - Otherwise find the length of the leading consonant cluster,
//     move it to the end, and append "ay".
//   - Empty string returns empty string.
fn pig_word(w: string) -> string
    let s = _pig_lower(w)
    let n = len(s)
    if n == 0
        return s
    // Find the length of the leading consonant cluster.
    let cluster = 0
    let i = 0
    while i < n
        if _pig_is_vowel(s[i]) == 1
            i = n  // break
        else
            cluster += 1
            i += 1
    // If cluster == 0 the first char is a vowel -> append "way".
    if cluster == 0
        return s + "way"
    // If cluster == n there are no vowels at all; treat entire word as consonant
    // cluster and just append "ay" (standard behaviour for all-consonant strings).
    return slice(s, cluster, n) + slice(s, 0, cluster) + "ay"

// Split s on spaces into a list of tokens (runs of non-space characters).
fn _pig_split_spaces(s: string) -> list
    let toks = []
    let n = len(s)
    let cur = ""
    for i in 0..n
        if s[i] == " "
            if len(cur) > 0
                push(toks, cur)
                cur = ""
        else
            cur += s[i]
    if len(cur) > 0
        push(toks, cur)
    toks

// Pigify each space-separated word in s and rejoin with a single space.
fn pig_sentence(s: string) -> string
    let words = _pig_split_spaces(s)
    let out_parts = []
    for i in 0..len(words)
        if i > 0
            push(out_parts, " ")
        push(out_parts, pig_word(words[i]))
    let out = join(out_parts, "")
    out
