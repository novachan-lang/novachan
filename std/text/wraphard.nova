// ============================================================================
// NOVA Standard Library — std/text/wraphard
// ============================================================================
// Hard text wrapping: breaks long words at exactly `width` characters.
// Unlike std/text/wrap (soft-wrap only), words exceeding `width` are
// chopped into width-sized chunks before being placed on lines.
//
// Public API:
//   wh_break_word(word, width) -> list<string>
//       Split a single word into chunks of exactly `width` chars, with
//       the final chunk holding any remainder. Always returns >= 1 element.
//       Example: wh_break_word("abcdefgh", 3) -> ["abc","def","gh"]
//
//   wh_wrap(text, width) -> list<string>
//       Greedy word-wrap with hard-break. Words are first broken with
//       wh_break_word when they exceed `width`; the resulting chunks are
//       then packed greedily. Returns [] for empty/whitespace-only input.
//
//   wh_fill(text, width) -> string
//       Same as wh_wrap, but joins lines with chr(10).

// ── private helpers ───────────────────────────────────────────────────────────

// Join a list of strings with sep.
fn _wh_join(lines, sep) -> string
    join(lines, sep)

// ── public API ────────────────────────────────────────────────────────────────

// wh_break_word(word, width) -> list<string>
// Break a single word into sequential chunks of at most `width` characters.
// The last chunk may be shorter. Returns [""] for empty word (degenerate).
fn wh_break_word(word, width) -> list
    let chunks = []
    let wlen = len(word)
    if wlen == 0
        push(chunks, "")
        return chunks
    let pos = 0
    while pos < wlen
        let end = pos + width
        if end > wlen
            end = wlen
        push(chunks, slice(word, pos, end))
        pos = end
    chunks

// wh_wrap(text, width) -> list<string>
// Greedy hard-wrap. Words longer than width are broken with wh_break_word
// before packing. Runs of spaces collapse (empty tokens are skipped).
fn wh_wrap(text, width) -> list
    let lines = []
    if len(text) == 0
        return lines
    let tokens = split(text, " ")
    let cur_line = ""
    let cur_len = 0
    for word in tokens
        if len(word) > 0
            // Produce one or more chunks from this word (hard-break if needed).
            let chunks = wh_break_word(word, width)
            for chunk in chunks
                let clen = len(chunk)
                if cur_len == 0
                    // Starting a fresh line.
                    cur_line = chunk
                    cur_len = clen
                else
                    if cur_len + 1 + clen <= width
                        cur_line += " " + chunk
                        cur_len += 1 + clen
                    else
                        // Flush and start new line with this chunk.
                        push(lines, cur_line)
                        cur_line = chunk
                        cur_len = clen
    if cur_len > 0
        push(lines, cur_line)
    lines

// wh_fill(text, width) -> string
// Hard-wrap and join lines with newline.
fn wh_fill(text, width) -> string
    let ls = wh_wrap(text, width)
    _wh_join(ls, chr(10))
