// ============================================================================
// NOVA Standard Library — std/text/strkit
// ============================================================================
// Higher-level string utilities, written from the comprehension/HOF toolkit
// rather than hand-rolled index loops. Every function here either delegates
// straight to an existing builtin (str_count, replace, pad_left/pad_right,
// splitlines, trim, join, split) or composes builtins with .map/.filter/
// .reduce + closures. A `while` loop is used ONLY for the two spots that are
// genuine character-by-character scans with no higher-level primitive
// available (the common-prefix pairwise comparison) — never for the kind of
// "for i in 0..n: bucket[i] ..." work a comprehension/HOF already covers.
//
// Public API:
//   sk_words(s) -> list           whitespace-run split, no empty tokens
//   sk_lines(s) -> list           "\n"-split, trailing newline drops no empty
//                                 tail element (delegates to builtin splitlines)
//   sk_title_case(s) -> string    capitalize every whitespace-delimited word
//   sk_count(hay, needle) -> int  non-overlapping occurrence count
//   sk_replace_all(hay, from, to) -> string   non-overlapping global replace
//   sk_pad_left(s, n, ch) -> string   left-pad with ch to width n
//   sk_pad_right(s, n, ch) -> string  right-pad with ch to width n
//   sk_truncate(s, n, ellipsis) -> string
//       len(s) <= n -> s unchanged. Else: keep = n - len(ellipsis) (clamped
//       to >= 0) leading characters of s, followed by ellipsis. This makes
//       the OUTPUT length exactly n whenever len(ellipsis) <= n.
//   sk_common_prefix(strs) -> string   longest common prefix of a list of str
//   sk_indent(s, n) -> string     prepend n spaces to every non-empty line
//   sk_is_blank(s) -> bool        true iff s is empty or all-whitespace
//
// None of these operations can fail on well-typed input (no malformed-input
// parsing here), so nothing returns Result — every function is total.
//
// LEAF — imports NOTHING (every helper below is a builtin call).
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Capitalize word w: first character upper, the rest lower. "" -> "".
fn _sk_cap_word(w: string) -> string
    (upper(slice(w, 0, 1)) + lower(slice(w, 1, len(w)))) if len(w) > 0 else w

// Longest common prefix of exactly two strings — the one genuine char-scan
// primitive in this module (no builtin computes this). O(min(len(a),len(b))).
fn _sk_prefix_pair(a: string, b: string) -> string
    let limit = len(a)
    if len(b) < limit
        limit = len(b)
    let i = 0
    while i < limit and a[i] == b[i]
        i += 1
    slice(a, 0, i)

// ── public API ───────────────────────────────────────────────────────────────

// Split s on runs of whitespace (space/tab/CR/LF), dropping empty tokens.
// sk_words("  a  b c ") -> ["a", "b", "c"]
// Implementation: normalize every whitespace byte to a plain space via the
// `replace` builtin, split on a single space, then filter out the empty
// tokens a run of separators produces. No index loop.
fn sk_words(s: string) -> list
    let normalized = replace(replace(replace(s, "\t", " "), "\n", " "), "\r", " ")
    split(normalized, " ").filter(fn(w) len(w) > 0)

// Split s into lines. Delegates to the builtin `splitlines` (splits on "\n",
// strips a paired "\r", and a trailing newline does not produce a trailing
// empty element) — no need to reimplement it here.
fn sk_lines(s: string) -> list
    splitlines(s)

// Capitalize every whitespace-delimited word. Word-splitting is via sk_words,
// so runs of whitespace between words collapse to a single space in the
// output (documented; matches the KAT's single-spaced input either way).
// sk_title_case("hello world") -> "Hello World"
fn sk_title_case(s: string) -> string
    join(sk_words(s).map(fn(w) _sk_cap_word(w)), " ")

// Count NON-OVERLAPPING occurrences of needle in hay. Delegates straight to
// the `str_count` builtin (already implements exactly this: after a match,
// the scan resumes past it, so "aaaa" counts 2 occurrences of "aa", not 3).
fn sk_count(hay: string, needle: string) -> int
    str_count(hay, needle)

// Replace every NON-OVERLAPPING occurrence of `from` with `to`. Delegates to
// the `replace` builtin (same non-overlapping, left-to-right semantics as
// sk_count; `from` empty -> hay returned unchanged).
fn sk_replace_all(hay: string, from: string, to: string) -> string
    replace(hay, from, to)

// Left-pad s with the single character ch until it is n chars wide (no-op if
// s is already >= n). Delegates to the `pad_left` builtin; only the first
// byte of ch is used (mirrors the builtin's ord()-of-a-char contract) and an
// empty ch falls back to a plain space, exactly like `ord("") == 0` -> the
// builtin's own space fallback for a zero fill code.
// sk_pad_left("7", 3, "0") -> "007"
fn sk_pad_left(s: string, n: int, ch: string) -> string
    pad_left(s, n, ord(ch))

// Right-pad s with the single character ch until it is n chars wide (no-op
// if s is already >= n). Delegates to the `pad_right` builtin; same
// single-byte-of-ch contract as sk_pad_left.
fn sk_pad_right(s: string, n: int, ch: string) -> string
    pad_right(s, n, ord(ch))

// Truncate s to at most n characters, appending ellipsis when truncated.
// len(s) <= n -> s unchanged.
// Otherwise -> the first (n - len(ellipsis)) characters of s, then ellipsis
// (keep is clamped to >= 0 so an ellipsis longer than n never underflows the
// slice). This makes the result exactly n characters whenever
// len(ellipsis) <= n.
// sk_truncate("hello", 4, "..") -> "he.."
fn sk_truncate(s: string, n: int, ellipsis: string) -> string
    let result = s
    if len(s) > n
        let keep = n - len(ellipsis)
        if keep < 0
            keep = 0
        result = slice(s, 0, keep) + ellipsis
    result

// Longest common prefix shared by every string in strs. "" for an empty list
// or when there is no common prefix. Expressed as a `.reduce` over the pairwise
// helper (folding strs[0] into itself first is a harmless no-op) rather than
// a hand-rolled accumulator loop.
// sk_common_prefix(["flower", "flow", "flight"]) -> "fl"
fn sk_common_prefix(strs: list) -> string
    let result = ""
    if len(strs) > 0
        result = strs.reduce(fn(acc, s) _sk_prefix_pair(acc, s), strs[0])
    result

// Prepend n spaces to every non-empty line of s; blank lines (len == 0) are
// left untouched. Builds the indent string via pad_left("", n, ' ') (n fill
// chars over an empty base) rather than a hand-rolled repeat loop, then maps
// it over the lines and rejoins with the `join` builtin.
// sk_indent("a\nb", 2) -> "  a\n  b"
fn sk_indent(s: string, n: int) -> string
    let result = ""
    let lines = splitlines(s)
    if len(lines) > 0
        let prefix = pad_left("", n, ord(" "))
        let indented = lines.map(fn(line) (prefix + line) if len(line) > 0 else line)
        result = join(indented, "\n")
    result

// True iff s is empty or contains only whitespace. Delegates to `trim`
// (already strips space/tab/CR/LF) — blank iff nothing survives the trim.
fn sk_is_blank(s: string) -> bool
    len(trim(s)) == 0
