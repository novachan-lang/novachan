// std/text/banner -- simple ASCII text banners.
//
// Public API:
//   ban_repeat_line(ch, n) -> string  -- repeat single-char string ch n times
//   ban_border(text) -> string        -- frame text with '=' top/bottom border
//   ban_center(text, width, fill) -> string -- center text in width using fill
//
// ban_border("hi") produces three lines joined by chr(10):
//   "======"   (len("hi")+4 = 6 '=' chars)
//   "= hi ="
//   "======"
//
// LEAF -- imports NOTHING.

// Repeat single-char string ch exactly n times.
// ban_repeat_line("=", 5) == "====="
fn ban_repeat_line(ch: string, n: int) -> string
    let out_parts = []
    for i in 0..n
        push(out_parts, ch)
    let out = join(out_parts, "")
    out

// Frame text with '=' border lines and "= text =" middle line.
// Returns three lines joined by newline (chr(10)).
// ban_border("hi") -> "======\n= hi =\n======"
fn ban_border(text: string) -> string
    let border = ban_repeat_line("=", len(text) + 4)
    let middle = "= " + text + " ="
    border + chr(10) + middle + chr(10) + border

// Center text within width using fill char.
// If padding is odd, extra fill goes on the RIGHT.
// ban_center("hi", 6, " ") == "  hi  "
// ban_center("abc", 5, "*") == "*abc*"
fn ban_center(text: string, width: int, fill: string) -> string
    let tlen = len(text)
    let out = text
    if tlen < width
        let total = width - tlen
        let left = total / 2
        let right = total - left
        out = ban_repeat_line(fill, left) + text + ban_repeat_line(fill, right)
    out
