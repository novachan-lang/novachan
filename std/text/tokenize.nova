// ============================================================================
// NOVA Standard Library — std/text/tokenize
// ============================================================================
// Text tokenizers. All functions take a string and return a list of strings.
//
// Public API:
//   tk_words(s)       -> list  maximal non-whitespace runs; drop empties
//                              whitespace = space(32) tab(9) newline(10) CR(13)
//   tk_lines(s)       -> list  split on LF chr(10); keeps all segments including empties
//   tk_chars(s)       -> list  one single-char string per character
//   tk_sentences(s)   -> list  split after . ! or ? followed by whitespace or end;
//                              trim each; drop empties
//   tk_alnum_words(s) -> list  maximal runs of ASCII letters/digits, lowercased;
//                              other chars are separators
// ============================================================================

// Internal: true if the character c is ASCII whitespace (space/tab/LF/CR).
fn _tk_is_ws(c)
    let o = ord(c)
    if o == 32 then return true
    if o == 9  then return true
    if o == 10 then return true
    if o == 13 then return true
    false

// Internal: true if the character c is an ASCII letter or digit.
fn _tk_is_alnum(c)
    let o = ord(c)
    if o >= 48 and o <= 57 then return true   // 0-9
    if o >= 65 and o <= 90 then return true   // A-Z
    if o >= 97 and o <= 122 then return true  // a-z
    false

// Internal: true if the character c is a sentence-terminal (. ! ?).
fn _tk_is_terminal(c)
    let o = ord(c)
    if o == 46 then return true   // .
    if o == 33 then return true   // !
    if o == 63 then return true   // ?
    false

// tk_words: split s into maximal non-whitespace runs.
// Leading/trailing/internal whitespace is discarded. Returns [] for blank input.
fn tk_words(s)
    let result = []
    let n = len(s)
    let i = 0
    let start = 0
    let in_word = false
    while i < n
        let c = s[i]
        if _tk_is_ws(c)
            if in_word
                result.push(s[start:i])
                in_word = false
        else
            if not in_word
                start = i
                in_word = true
        i = i + 1
    if in_word
        result.push(s[start:n])
    result

// tk_lines: split s on LF (chr(10)). Every segment between LFs is kept,
// including empty strings. A trailing LF produces a trailing empty string.
fn tk_lines(s)
    let result = []
    let n = len(s)
    let i = 0
    let start = 0
    while i < n
        let o = ord(s[i])
        if o == 10
            result.push(s[start:i])
            start = i + 1
        i = i + 1
    result.push(s[start:n])
    result

// tk_chars: return a list of single-character strings in order.
// Returns [] for the empty string.
fn tk_chars(s)
    let result = []
    let n = len(s)
    for i in 0..n
        result.push(s[i:i+1])
    result

// tk_sentences: split s after any . ! ? that is immediately followed by
// whitespace OR is the last character in the string. Each piece is trimmed;
// empty pieces are dropped.
//
// Algorithm: scan for a terminal char. If found and the NEXT char is whitespace
// (or the terminal is at end), that index is a split point. We collect the
// piece up to and including the terminal, trim it, and continue from after the
// whitespace run.
fn tk_sentences(s)
    let result = []
    let n = len(s)
    let i = 0
    let start = 0
    while i < n
        let c = s[i]
        if _tk_is_terminal(c)
            // Check: is this a split point?
            let split_here = false
            if i + 1 >= n
                split_here = true
            else
                if _tk_is_ws(s[i+1])
                    split_here = true
            if split_here
                // Piece = s[start .. i+1], trimmed.
                let piece = trim(s[start:i+1])
                if len(piece) > 0
                    result.push(piece)
                // Skip over following whitespace.
                let j = i + 1
                while j < n and _tk_is_ws(s[j])
                    j = j + 1
                start = j
                i = j
            else
                i = i + 1
        else
            i = i + 1
    // Remainder after last split point (no terminal found or trailing text).
    let tail = trim(s[start:n])
    if len(tail) > 0
        result.push(tail)
    result

// tk_alnum_words: split s into maximal runs of ASCII letters/digits; lowercase
// each run. Punctuation, spaces, and all non-alnum chars are separators.
fn tk_alnum_words(s)
    let result = []
    let n = len(s)
    let i = 0
    let start = 0
    let in_run = false
    while i < n
        let c = s[i]
        if _tk_is_alnum(c)
            if not in_run
                start = i
                in_run = true
        else
            if in_run
                result.push(lower(s[start:i]))
                in_run = false
        i = i + 1
    if in_run
        result.push(lower(s[start:n]))
    result
