// ============================================================================
// NOVA Standard Library — std/text/bbcode_code
// ============================================================================
// BBCode [code] block handling: literal-content extraction, construction,
// and tag-escaping so arbitrary text can be embedded without being parsed
// as BBCode markup.
//
// Public API:
//   bcod_extract_blocks(input)   -> list   content of every [code]...[/code]
//   bcod_build(code)             -> str    wrap code in [code]...[/code]
//   bcod_escape(text)            -> str    escape [ and ] so tags render literally
//   bcod_count_blocks(input)     -> int    number of [code] blocks
//   bcod_strip_outside(input)    -> str    keep only code content, newline-joined
//
// Algorithm: single left-to-right scan for the literal "[code]" marker,
// paired with the next "[/code]" close marker. Unmatched/open blocks are
// treated as literal text so malformed input is never silently dropped.
// ============================================================================

// Internal: find the next occurrence of needle in s starting at position start.
// Returns the index, or -1 if not found.
fn _bcod_find_from(s, needle, start) -> int
    let n = len(s)
    let nl = len(needle)
    let i = start
    let result = -1
    while i + nl <= n and result == -1
        let cand = slice(s, i, i + nl)
        if cand == needle
            result = i
        i = i + 1
    result

// bcod_extract_blocks returns the literal content of every [code]...[/code]
// block, in left-to-right order. Unclosed [code] tags are skipped.
fn bcod_extract_blocks(input) -> any
    let out = []
    let n = len(input)
    let i = 0
    while i < n
        if i + 6 <= n and slice(input, i, i + 6) == "[code]"
            let close = _bcod_find_from(input, "[/code]", i + 6)
            if close >= 0
                let content = slice(input, i + 6, close)
                push(out, content)
                i = close + 7
            else
                i = i + 6
        else
            i = i + 1
    out

// bcod_build wraps code in a [code]...[/code] block.
fn bcod_build(code) -> str
    "[code]" + code + "[/code]"

// bcod_escape replaces BBCode bracket characters with numeric HTML entities
// so the text renders literally instead of being parsed as markup.
fn bcod_escape(text) -> str
    let out_parts = []
    let n = len(text)
    for i in 0..n
        let c = slice(text, i, i + 1)
        if c == "["
            push(out_parts, "&#91;")
        else
            if c == "]"
                push(out_parts, "&#93;")
            else
                push(out_parts, c)
    let out = join(out_parts, "")
    out

// bcod_count_blocks returns the number of [code] opening tags in input.
fn bcod_count_blocks(input) -> int
    let n = len(input)
    let i = 0
    let count = 0
    while i < n
        if i + 6 <= n and slice(input, i, i + 6) == "[code]"
            count = count + 1
            i = i + 6
        else
            i = i + 1
    count

// bcod_strip_outside discards everything outside [code] blocks, returning
// only the code content of each block joined by newlines.
fn bcod_strip_outside(input) -> str
    let blocks = bcod_extract_blocks(input)
    join(blocks, chr(10))
