// ============================================================================
// NOVA Standard Library — std/text/wrap
// ============================================================================
// Greedy word-wrap utilities for plain text.
//
// Public API:
//   wrap(text, width) -> list<string>
//       Split text on whitespace, greedily pack words onto lines such that
//       each line is <= width chars wherever possible. A single word longer
//       than width is placed on its own line unbroken. Returns [] for empty
//       or all-whitespace input.
//
//   fill(text, width) -> string
//       Same as wrap, but joins the resulting lines with "\n".
//
// Semantics:
//   - Whitespace tokenisation: split on " ". Runs of spaces collapse (empty
//     tokens from the split are skipped), so "a  b" == "a b" in effect.
//   - Greedy: each word is appended to the current line if it fits
//     (current_len + 1 + word_len <= width), otherwise a new line is started.
//   - A word that is longer than width stands alone on its own line.
//   - Empty / whitespace-only text returns [].

// ── helpers ──────────────────────────────────────────────────────────────────

// Join a list of strings with sep (pure NOVA — no builtin join needed here).
fn _join_lines(lines, sep) -> string
    let out = ""
    let i = 0
    let n = len(lines)
    while i < n
        if i > 0
            out = out + sep
        out = out + lines[i]
        i = i + 1
    out

// ── public API ───────────────────────────────────────────────────────────────

// wrap(text, width) -> list<string>
// Greedy word-wrap: each output line is <= width chars where possible.
// Words longer than width are placed on their own line, unbroken.
fn wrap(text, width) -> list
    let lines = []
    if len(text) == 0
        return lines
    // Split on single space; filter out empty tokens (collapsed spaces).
    let tokens = split(text, " ")
    let cur_line = ""
    let cur_len = 0
    let i = 0
    let n = len(tokens)
    while i < n
        let word = tokens[i]
        // Skip empty tokens that arise from runs of spaces.
        if len(word) > 0
            let wlen = len(word)
            if cur_len == 0
                // Starting a fresh line — always place the word, even if oversized.
                cur_line = word
                cur_len = wlen
            else
                // Does word fit on the current line with a separating space?
                if cur_len + 1 + wlen <= width
                    cur_line = cur_line + " " + word
                    cur_len = cur_len + 1 + wlen
                else
                    // Flush current line, start a new one with this word.
                    lines = lines + [cur_line]
                    cur_line = word
                    cur_len = wlen
        i = i + 1
    // Flush the last in-progress line (if any content was accumulated).
    if cur_len > 0
        lines = lines + [cur_line]
    lines

// fill(text, width) -> string
// Wrap text and join the resulting lines with newline characters.
fn fill(text, width) -> string
    let lines = wrap(text, width)
    _join_lines(lines, chr(10))
