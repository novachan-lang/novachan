// graphemex.nova — grapheme cluster segmentation (UAX-29 core rules), the NOVA way.
//
// A "character" a user perceives is a grapheme CLUSTER, which may span SEVERAL
// codepoints: e + combining accent (2 cps, 1 char), a flag = 2 regional
// indicators (2 cps, 1 char), an emoji family = base ZWJ base ZWJ base. NOVA
// strings are UTF-8 and already expose codepoints (code_points/char_count);
// this splits a string into user-perceived characters so counting, indexing,
// and reversal are correct (naive byte/codepoint ops detach combining marks).
//
// Covers the practically-important UAX-29 rules without the full Unicode tables:
//   GB3      CR x LF stay together
//   GB9      don't break before Extend (combining marks) or ZWJ
//   GB11     emoji ZWJ sequences (ZWJ joins the next codepoint) stay together
//   GB12/13  regional-indicator PAIRS (flags) stay together
//   + variation selectors and emoji skin-tone modifiers count as Extend.

fn _is_regional(cp)
  if cp >= 127462 and cp <= 127487   // U+1F1E6 .. U+1F1FF
    return 1
  0

fn _is_zwj(cp)
  if cp == 8205                       // U+200D ZERO WIDTH JOINER
    return 1
  0

fn _is_extend(cp)
  if cp >= 768 and cp <= 879          // U+0300..U+036F combining diacriticals
    return 1
  if cp >= 7616 and cp <= 7679        // U+1DC0..U+1DFF combining diacriticals supplement
    return 1
  if cp >= 8400 and cp <= 8447        // U+20D0..U+20FF combining marks for symbols
    return 1
  if cp >= 65024 and cp <= 65039      // U+FE00..U+FE0F variation selectors
    return 1
  if cp >= 65056 and cp <= 65071      // U+FE20..U+FE2F combining half marks
    return 1
  if cp >= 127995 and cp <= 127999    // U+1F3FB..U+1F3FF emoji skin-tone modifiers
    return 1
  0

fn _cps_to_str(cps, start, stop)
  let s = ""
  let j = start
  while j < stop
    s = s + from_codepoint(cps[j])
    j = j + 1
  s

// Split a string into a list of grapheme-cluster strings.
fn graphemes(text)
  let cps = code_points(text)
  let n = len(cps)
  let out = []
  let i = 0
  while i < n
    let start = i
    let cp = cps[i]
    i = i + 1
    if cp == 13 and i < n and cps[i] == 10
      i = i + 1                       // GB3: CR LF is one cluster
    else if _is_regional(cp) and i < n and _is_regional(cps[i])
      i = i + 1                       // GB12/13: a flag is two regional indicators
    else
      let go = 1                      // GB9/GB11: absorb Extend and ZWJ-joined codepoints
      while go == 1 and i < n
        let nxt = cps[i]
        if _is_extend(nxt) == 1
          i = i + 1
        else if _is_zwj(nxt) == 1
          i = i + 1
          if i < n
            i = i + 1                 // the ZWJ joins the following codepoint into this cluster
        else
          go = 0
    push(out, _cps_to_str(cps, start, i))
  out

// Count of user-perceived characters (clusters), not codepoints or bytes.
fn grapheme_count(text)
  len(graphemes(text))

// The idx-th user-perceived character.
fn grapheme_at(text, idx)
  let g = graphemes(text)
  g[idx]

// Reverse by grapheme cluster — keeps combining marks attached to their base
// (a naive byte/codepoint reverse would detach them and corrupt the text).
fn grapheme_reverse(text)
  let g = graphemes(text)
  let r = ""
  let i = len(g) - 1
  while i >= 0
    r = r + g[i]
    i = i - 1
  r

// ── Tests ────────────────────────────────────────────────────────────
// (built via from_codepoint to avoid source-file encoding pitfalls)

// Test 1: plain ASCII — one cluster per char.
let g1 = graphemes("hello")
assert(len(g1) == 5, "ascii: 5 graphemes")
assert(g1[0] == "h", "first is h")
assert(grapheme_count("hello") == 5, "count(hello)==5")
print("PASS: ascii")

// Test 2: base + combining mark = ONE grapheme but TWO codepoints.
let combo = from_codepoint(101) + from_codepoint(769)   // 'e' + combining acute
assert(char_count(combo) == 2, "2 codepoints")
assert(grapheme_count(combo) == 1, "but 1 grapheme")
let gco = graphemes(combo)
assert(len(gco) == 1, "single cluster")
assert(char_count(gco[0]) == 2, "the cluster holds both codepoints")
print("PASS: base + combining mark = 1 grapheme")

// Test 3: a word with a combining mark mid-string.
// "a" + "e+acute" + "c"  -> 3 graphemes, 4 codepoints
let word = "a" + from_codepoint(101) + from_codepoint(769) + "c"
assert(char_count(word) == 4, "4 codepoints")
assert(grapheme_count(word) == 3, "3 user-perceived chars")
assert(grapheme_at(word, 1) == combo, "middle grapheme is the e-with-accent")
print("PASS: combining mark mid-string")

// Test 4: regional-indicator pair = a flag = ONE grapheme.
let flag = from_codepoint(127482) + from_codepoint(127480)  // U+1F1FA U+1F1F8 (US)
assert(char_count(flag) == 2, "2 regional indicators")
assert(grapheme_count(flag) == 1, "1 flag grapheme")
// two flags side by side = 2 graphemes (pairs don't run on)
let twoflags = flag + from_codepoint(127465) + from_codepoint(127466) // + DE
assert(grapheme_count(twoflags) == 2, "two flags = two graphemes")
print("PASS: regional-indicator flags")

// Test 5: CR LF is a single grapheme.
let crlf = from_codepoint(13) + from_codepoint(10)
assert(char_count(crlf) == 2, "CR + LF = 2 codepoints")
assert(grapheme_count(crlf) == 1, "but 1 grapheme")
print("PASS: CRLF")

// Test 6: emoji ZWJ sequence = ONE grapheme.
// man(1F468) ZWJ(200D) woman(1F469) ZWJ(200D) girl(1F467)
let family = from_codepoint(128104) + from_codepoint(8205) + from_codepoint(128105) + from_codepoint(8205) + from_codepoint(128103)
assert(char_count(family) == 5, "5 codepoints")
assert(grapheme_count(family) == 1, "1 family grapheme")
print("PASS: emoji ZWJ sequence")

// Test 7: grapheme-aware reverse keeps marks attached.
// reverse of "a | e+acute | c" should be "c | e+acute | a"
let rev = grapheme_reverse(word)
let expect = "c" + combo + "a"
assert(rev == expect, "grapheme reverse keeps the accent on its base")
assert(grapheme_count(rev) == 3, "still 3 graphemes after reverse")
print("PASS: grapheme-aware reverse")

// Test 8: skin-tone modifier attaches to its emoji.
// thumbs up(1F44D) + skin tone(1F3FF) = 1 grapheme
let thumb = from_codepoint(128077) + from_codepoint(127999)
assert(char_count(thumb) == 2, "2 codepoints")
assert(grapheme_count(thumb) == 1, "emoji+modifier = 1 grapheme")
print("PASS: emoji skin-tone modifier")

print("ALL PASS: graphemex — UAX-29 grapheme cluster segmentation")
