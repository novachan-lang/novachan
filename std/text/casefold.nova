// ============================================================================
// NOVA Standard Library — casefold module
// ============================================================================
// WHAT: Case-INSENSITIVE string comparison done the way it SHOULD be done.
//   The wrong way (byte-wise `a == b` after a naive ASCII lower) says "É" != "é"
//   and quietly breaks auth usernames, search, and dedup the moment a non-ASCII
//   letter shows up. The right way is: fold BOTH sides to one canonical lower
//   form, THEN compare. That is what this module does.
//
// NOVA-way: fold-then-compare over UTF-8.
//   NOVA strings are UTF-8 BYTES — a single accented letter such as 'é' is TWO
//   bytes, Greek/Cyrillic letters are two bytes each. Comparing bytes therefore
//   compares ENCODING, not MEANING. So we bridge to codepoints:
//     decode UTF-8 -> [codepoints]  |>  map fold_cp  |>  encode back to UTF-8
//   and compare the folded strings. Everything composes from small helpers; no
//   single giant byte-poking loop that tangles decode + fold + encode together.
//
// Drawback avoided:
//   - Byte-wise `==` (and naive ASCII lower): says "É" != "é". Silent auth bug.
//   - Java's Collator / String.equalsIgnoreCase locale traps: Collator is a
//     STATEFUL, non-thread-safe object you must clone per thread; getting it
//     wrong is a data race. Here casefold is a PURE function of its input.
//   - Go / Rust: correct Unicode case folding needs an external crate
//     (golang.org/x/text, unicode-case-mapping). NOVA does the common scripts
//     in-language, no dependency, no table blob for the ranges below.
//
// SCOPE (documented honestly):
//   We fold the RANGE-COMPUTABLE common scripts whose upper/lower forms differ
//   by a FIXED offset — ASCII, Latin-1 Supplement, Greek, Cyrillic. These need
//   NO CaseFolding table, just range arithmetic that reads like a table.
//   NOT handled (a later table-driven extension):
//     - Special foldings that change LENGTH, e.g. German ß ("straße") folds to
//       "ss" ("strasse"). We leave ß as-is, so str_eq_ci("straße","STRASSE")
//       is FALSE. This is a deliberate, documented limitation — not a bug.
//     - Greek final sigma (ς U+03C2 vs σ U+03C3) nuance: we fold the UPPERCASE
//       Greek range Α..Ω to α..ω; we do not special-case final-sigma position.
//     - Turkish dotless-i / dotted-I locale rules, titlecase digraphs, etc.
//
// Public API:
//   casefold(s) -> str                    // fold every codepoint, re-encode
//   str_eq_ci(a, b) -> bool               // casefold(a) == casefold(b)
//   str_contains_ci(hay, needle) -> bool  // contains() on the folded forms
//
// Depends only on builtins: len, ord, from_codepoint, contains.
//   - ord(s)            reads the FIRST BYTE of s (0..255), so s[i] + ord gives
//                       us raw bytes for hand-decoding UTF-8.
//   - from_codepoint(c) emits the correct 1..4 UTF-8 bytes for codepoint c.
// ============================================================================

// ── UTF-8 codepoint bridge ───────────────────────────────────────────────────

// Read the raw byte value (0..255) at byte index i of s.
fn _byte_at(s, i) -> int
    ord(s[i])

// Decode UTF-8 string s into a list of int codepoints.
//   A well-formed 1..4 byte sequence -> one codepoint. A lone/invalid byte (bad
//   lead byte, or a truncated/mis-formed continuation) -> that byte's own value,
//   so decoding is TOTAL and never loses data. Continuation bytes are 0x80..0xBF.
fn _utf8_decode(s) -> list
    let cps = []
    let n = len(s)
    let i = 0
    while i < n
        let b0 = _byte_at(s, i)
        if b0 < 0x80
            // 1-byte ASCII: 0xxxxxxx
            cps.push(b0)
            i = i + 1
        else if b0 >= 0xC0 and b0 < 0xE0 and i + 1 < n
            // 2-byte: 110xxxxx 10xxxxxx
            let b1 = _byte_at(s, i + 1)
            if b1 >= 0x80 and b1 < 0xC0
                let cp = ((b0 - 0xC0) * 64) + (b1 - 0x80)
                cps.push(cp)
                i = i + 2
            else
                cps.push(b0)
                i = i + 1
        else if b0 >= 0xE0 and b0 < 0xF0 and i + 2 < n
            // 3-byte: 1110xxxx 10xxxxxx 10xxxxxx
            let b1 = _byte_at(s, i + 1)
            let b2 = _byte_at(s, i + 2)
            if b1 >= 0x80 and b1 < 0xC0 and b2 >= 0x80 and b2 < 0xC0
                let cp = ((b0 - 0xE0) * 4096) + ((b1 - 0x80) * 64) + (b2 - 0x80)
                cps.push(cp)
                i = i + 3
            else
                cps.push(b0)
                i = i + 1
        else if b0 >= 0xF0 and b0 < 0xF8 and i + 3 < n
            // 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
            let b1 = _byte_at(s, i + 1)
            let b2 = _byte_at(s, i + 2)
            let b3 = _byte_at(s, i + 3)
            if b1 >= 0x80 and b1 < 0xC0 and b2 >= 0x80 and b2 < 0xC0 and b3 >= 0x80 and b3 < 0xC0
                let cp = ((b0 - 0xF0) * 262144) + ((b1 - 0x80) * 4096) + ((b2 - 0x80) * 64) + (b3 - 0x80)
                cps.push(cp)
                i = i + 4
            else
                cps.push(b0)
                i = i + 1
        else
            // lone / invalid lead byte: pass through as its own value
            cps.push(b0)
            i = i + 1
    cps

// Re-encode a list of int codepoints back into a UTF-8 string.
//   from_codepoint(cp) already emits the correct 1..4 UTF-8 bytes, so encoding
//   is just concatenation. (A folded codepoint always lands in the same or a
//   shorter byte-length than its source in our ranges, but that is irrelevant
//   here — from_codepoint handles the width.)
fn _utf8_encode(cps) -> str
    let out = ""
    let i = 0
    let n = len(cps)
    while i < n
        out = out + from_codepoint(cps[i])
        i = i + 1
    out

// ── fold one codepoint (the "table") ─────────────────────────────────────────

// Fold a single codepoint to its canonical lower form. Range-dispatched: each
// arm is one script whose upper/lower differ by a FIXED offset, so the whole
// function reads like a case-folding table without shipping one.
fn fold_cp(cp) -> int
    if cp >= 0x41 and cp <= 0x5A
        // ASCII A-Z -> a-z
        cp + 32
    else if cp >= 0xC0 and cp <= 0xDE and cp != 0xD7
        // Latin-1 Supplement À-Þ -> à-þ  (skip × U+00D7, the multiply sign)
        cp + 32
    else if cp >= 0x391 and cp <= 0x3A9
        // Greek Α-Ω -> α-ω  (final-sigma nuance intentionally NOT handled)
        cp + 32
    else if cp >= 0x410 and cp <= 0x42F
        // Cyrillic А-Я -> а-я
        cp + 32
    else if cp >= 0x400 and cp <= 0x40F
        // Cyrillic Ѐ-Џ -> ѐ-џ
        cp + 0x50
    else
        cp

// ── public API ────────────────────────────────────────────────────────────────

// Fold every codepoint of s to canonical lower form and re-encode as UTF-8.
//   decode |> map fold_cp |> encode — composed from the helpers above.
fn casefold(s) -> str
    let cps = _utf8_decode(s)
    let folded = []
    let i = 0
    let n = len(cps)
    while i < n
        folded.push(fold_cp(cps[i]))
        i = i + 1
    _utf8_encode(folded)

// Case-insensitive equality: fold both sides, then compare bytes.
fn str_eq_ci(a, b) -> bool
    casefold(a) == casefold(b)

// Case-insensitive substring test: does the folded needle occur in the
// folded haystack? contains(hay, needle) is substring containment on strings.
fn str_contains_ci(hay, needle) -> bool
    contains(casefold(hay), casefold(needle))
