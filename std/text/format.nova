// std/text/format -- number and string formatting utilities.
//
// Public API:
//   fmt_int_commas(n)         -> string  -- thousands-separated integer ("1,234,567"; negative OK)
//   fmt_fixed(x, dp)          -> string  -- float to exactly dp decimal places, rounded
//   fmt_pad_left(s, w, ch)    -> string  -- right-justify s in field of width w, padded with ch
//   fmt_pad_right(s, w, ch)   -> string  -- left-justify s in field of width w, padded with ch
//   fmt_hex(n)                -> string  -- lowercase hex with "0x" prefix  ("0xff")
//   fmt_bin(n)                -> string  -- binary with "0b" prefix ("0b101")
//
// LEAF -- imports NOTHING.

// ── private helpers ──────────────────────────────────────────────────────────

// Raise 10 to the power exp (non-negative integer exponent).
fn _pow10(exp: int) -> int
    let result = 1
    let i = 0
    while i < exp
        result = result * 10
        i = i + 1
    result

// Zero-pad a non-negative integer string to at least `width` digits.
fn _zpad(s: string, width: int) -> string
    let out = s
    while len(out) < width
        out = "0" + out
    out

// ── public functions ─────────────────────────────────────────────────────────

// Format integer n with thousands commas.
// fmt_int_commas(1234567)  -> "1,234,567"
// fmt_int_commas(-1000)    -> "-1,000"
// fmt_int_commas(999)      -> "999"
fn fmt_int_commas(n: int) -> string
    let neg = n < 0
    let v = n
    if neg
        v = 0 - n
    let digits = str(v)
    let dlen = len(digits)
    let out = ""
    let i = 0
    while i < dlen
        if i > 0 and ((dlen - i) * 1) % 3 == 0
            out = out + ","
        out = out + char_at(digits, i)
        i = i + 1
    if neg
        out = "-" + out
    out

// Format float x to exactly dp decimal places (rounded via integer scaling).
// fmt_fixed(3.14159, 2) -> "3.14"
// fmt_fixed(2.0, 3)     -> "2.000"
// fmt_fixed(0.0, 2)     -> "0.00"
// fmt_fixed(-1.5, 1)    -> "-1.5"
// dp=0 produces no decimal point.
fn fmt_fixed(x: float, dp: int) -> string
    let neg = x < 0.0
    let ax = x
    if neg
        ax = 0.0 - ax
    let scale = _pow10(dp) * 1
    // Multiply, round to nearest integer using floor(v + 0.5)
    let scaled_f = ax * (scale * 1.0)
    let rounded = int(scaled_f + 0.5)
    // Split into integer part and fractional digits
    let int_part = rounded / scale
    let frac_part = rounded - int_part * scale
    let int_str = str(int_part)
    let result = ""
    if neg
        result = "-"
    result = result + int_str
    if dp > 0
        result = result + "." + _zpad(str(frac_part), dp)
    result

// Right-justify s in a field of total width w, padded on the left with char ch.
// fmt_pad_left("7", 3, "0")  -> "007"
// fmt_pad_left("hi", 5, " ") -> "   hi"
fn fmt_pad_left(s: string, w: int, ch: string) -> string
    pad_left(s, w, ord(ch))

// Left-justify s in a field of total width w, padded on the right with char ch.
// fmt_pad_right("hi", 5, " ") -> "hi   "
fn fmt_pad_right(s: string, w: int, ch: string) -> string
    pad_right(s, w, ord(ch))

// Format n as lowercase hexadecimal with "0x" prefix.
// fmt_hex(255) -> "0xff"
// fmt_hex(0)   -> "0x0"
fn fmt_hex(n: int) -> string
    "0x" + hex(n)

// Format n as binary with "0b" prefix.
// fmt_bin(5)   -> "0b101"
// fmt_bin(0)   -> "0b0"
fn fmt_bin(n: int) -> string
    "0b" + bin(n)
