// ============================================================================
// NOVA Standard Library — std/text/zalgorithm
// ============================================================================
// Z-function string algorithm (Gusfield / KMP-variant, O(n) time/space).
//
// Public API:
//   z_array(s)              -> list   Z[i] = length of longest substring
//                                     starting at s[i] that is also a prefix
//                                     of s.  Convention: Z[0] = 0.
//   z_search(text, pat)     -> list   all 0-based indices in text where pat
//                                     occurs (via Z-function on the combined
//                                     string pat + SEP + text).
//   z_count(text, pat)      -> int    number of occurrences (= len(z_search)).
//
// Algorithm — z_array (O(n)):
//   Maintains a "Z-box" [l, r) which is the rightmost interval [l, r) such
//   that s[l..r-1] is a prefix of s.  For each position i:
//     • If i >= r the Z-box has not yet reached i; expand naively from i.
//     • Else k = i - l; Z[k] was computed for the matching prefix segment.
//       - If Z[k] < r - i  we already know the full extent: Z[i] = Z[k].
//       - If Z[k] >= r - i we know at least (r - i) chars match; expand
//         from r outward and update the Z-box.
//   This guarantees each character is compared at most twice → O(n).
//
// Algorithm — z_search:
//   Build the "decorated" string  pat + SEP + text  where SEP = chr(1)
//   (ASCII SOH, cannot appear in normal text and is deliberately not part of
//   pat or text for the search to be correct; the function asserts this
//   contract by construction).
//   Z[i] == len(pat) for any i >= len(pat)+1 means pat starts at
//   text position  i - len(pat) - 1.
//
// Prefix tag for all private helpers: _zal_
// ============================================================================

// _zal_min returns the smaller of two ints.
fn _zal_min(a, b) -> int
    if a < b
        return a
    b

// z_array computes the Z-function for string s.
// Z[0] is defined as 0 by convention (the entire string trivially matches the
// prefix but that value is not useful and would produce false positives in
// z_search).  Z[i] for i >= 1 is the length of the longest substring starting
// at s[i] that equals a prefix of s.
fn z_array(s) -> list
    let n = len(s)
    let z = []
    // Fill list with n zeros.
    for fill in 0..n
        z.push(0)

    // Z[0] = 0 by convention; start computing from index 1.
    let l = 0
    let r = 0
    for i in 1..n
        // Minimum of Z[i-l] and remaining Z-box length, if inside box.
        if i < r
            let k = i - l
            let remaining = r - i
            let zk = z[k]
            z[i] = _zal_min(zk, remaining)

        // Expand from position i + z[i] against prefix position z[i].
        let zi = z[i]
        let left = i + zi
        let right = zi
        let done = 0
        while done == 0
            if left >= n
                done = 1
            if done == 0
                if right >= n
                    done = 1
            if done == 0
                let cl = ord(slice(s, left, left + 1))
                let cr = ord(slice(s, right, right + 1))
                if cl != cr
                    done = 1
                if done == 0
                    left = left + 1
                    right = right + 1
        z[i] = right

        // Update Z-box if we extended past r.
        if i + z[i] > r
            l = i
            r = i + z[i]

    z

// z_search returns a list of all 0-based positions in text where pat occurs.
// Uses the classic Z-function trick: build  combined = pat + SEP + text  and
// compute z_array(combined).  Any index j in the combined string with
// j >= pat_len + 1 and Z[j] == pat_len is an occurrence at text position
// j - pat_len - 1.
// SEP = chr(1) (ASCII SOH).  If pat is empty, returns an empty list.
fn z_search(text, pat) -> list
    let results = []
    let pat_len = len(pat)
    if pat_len == 0
        return results

    // Build combined string: pat + SEP + text
    let sep = chr(1)
    let combined = pat + sep + text
    let zv = z_array(combined)
    let combined_len = len(combined)
    let offset = pat_len + 1

    let j = offset
    while j < combined_len
        let zj = zv[j]
        if zj == pat_len
            results.push(j - offset)
        j = j + 1
    results

// z_count returns the number of (possibly overlapping) occurrences of pat in
// text.  Equivalent to len(z_search(text, pat)) but avoids materialising the
// list when only the count is needed.
fn z_count(text, pat) -> int
    let pat_len = len(pat)
    if pat_len == 0
        return 0

    let sep = chr(1)
    let combined = pat + sep + text
    let zv = z_array(combined)
    let combined_len = len(combined)
    let offset = pat_len + 1
    let count = 0

    let j = offset
    while j < combined_len
        let zj = zv[j]
        if zj == pat_len
            count = count + 1
        j = j + 1
    count

// ============================================================================
fn main()
    print("std/text/zalgorithm loaded")
