// ============================================================================
// NOVA Standard Library — std/text/bbcode_to_text
// ============================================================================
// Convert BBCode markup to plain, human-readable text: pure formatting tags
// are stripped silently, while tags that carry information worth keeping
// (links, quotes, code, lists, images) are rendered with plain-text
// conventions instead of being dropped.
//
// Public API:
//   btxt_convert(input) -> str
//       Convert a BBCode string to plain text.
//
// Tag handling:
//   [b] [i] [u] [s]           stripped silently — inner text kept, re-scanned
//   [color=X] [size=X]        stripped silently — the parameter carries no
//                               meaning in plain text, only the content does
//   [url]text[/url]           -> "text"                (text doubles as URL)
//   [url=X]text[/url]         -> "text (X)"
//   [img]url[/img]            -> "[Image: url]"
//   [quote]text[/quote]       -> "> text"   (EVERY line of the (possibly
//                               multi-line) quoted text gets its own "> ")
//   [code]text[/code]         -> every line indented 4 spaces; content is
//                               copied VERBATIM (no BBCode inside a code
//                               block is interpreted)
//   [list][*]a[*]b[/list]     -> "- a" NEWLINE "- b"
//   [*]                       -> "- "  (bare/top-level fallback outside a
//                               [list] — best effort, no line structure to
//                               anchor to)
//
// Unrecognized tags, and any tag with no matching close, pass through as
// literal text (only the '[' is consumed so the rest re-scans normally —
// matches the sibling std/text/md_link.nova and bbcode_to_html.nova
// convention).
//
// LEAF — imports NOTHING.
// ============================================================================

// ── tag matching (same algorithm as bbcode_to_html._bhtml_find_close) ───────

// Find the absolute index of the '[' that starts the matching "[/name]" for
// an opening tag whose content begins at `pos`. Tracks nesting depth of the
// SAME tag name (bare "[name]" or parameterized "[name=value]" both count
// as opens) so nested same-name tags resolve to the correct outer close.
// Returns -1 if no matching close is found before the end of the string.
fn _btxt_find_close(s, pos, name) -> int
    let n = len(s)
    let i = pos
    let depth = 0
    while i < n
        if slice(s, i, i + 1) == "["
            let rel = find(slice(s, i, n), "]")
            if rel < 0
                i = i + 1
            else
                let close = i + rel
                let tag_text = lower(slice(s, i + 1, close))
                if tag_text == "/" + name
                    if depth == 0
                        return i
                    depth = depth - 1
                    i = close + 1
                else
                    let is_open = 0
                    if tag_text == name
                        is_open = 1
                    else
                        if starts_with(tag_text, name + "=")
                            is_open = 1
                    if is_open == 1
                        depth = depth + 1
                    i = close + 1
        else
            i = i + 1
    -1

// Given the absolute index of the '[' of a "[/name]" close tag, return the
// index of the character right after its closing ']'.
fn _btxt_after_close(s, close_pos) -> int
    let n = len(s)
    let rel = find(slice(s, close_pos, n), "]")
    close_pos + rel + 1

// ── per-line prefixing (quote / code) ────────────────────────────────────────

// Prefix every line of `inner` with "> " (used for [quote]).
fn _btxt_quote_prefix(inner) -> str
    let lines = split(inner, chr(10))
    let out = ""
    let i = 0
    let n = len(lines)
    while i < n
        if i > 0
            out = out + chr(10)
        out = out + "> " + lines[i]
        i = i + 1
    out

// Prefix every line of `inner` with 4 spaces (used for [code]).
fn _btxt_indent_block(inner) -> str
    let lines = split(inner, chr(10))
    let out = ""
    let i = 0
    let n = len(lines)
    while i < n
        if i > 0
            out = out + chr(10)
        out = out + "    " + lines[i]
        i = i + 1
    out

// ── [list] / [*] ─────────────────────────────────────────────────────────────

// Split the raw content of a [list]...[/list] body into its top-level [*]
// items, skipping over nested [list]...[/list] blocks via a depth counter.
// Text before the first top-level [*] is discarded.
fn _btxt_list_items(content) -> list
    let items = []
    let n = len(content)
    let i = 0
    let depth = 0
    let item_start = -1
    while i < n
        if slice(content, i, i + 1) == "["
            let rel = find(slice(content, i, n), "]")
            if rel < 0
                i = i + 1
            else
                let close = i + rel
                let lname = lower(slice(content, i + 1, close))
                if lname == "list"
                    depth = depth + 1
                    i = close + 1
                else
                    if lname == "/list"
                        depth = depth - 1
                        i = close + 1
                    else
                        if lname == "*" and depth == 0
                            if item_start >= 0
                                push(items, slice(content, item_start, i))
                            item_start = close + 1
                            i = close + 1
                        else
                            i = i + 1
        else
            i = i + 1
    if item_start >= 0
        push(items, slice(content, item_start, n))
    items

fn _btxt_render_list(inner) -> str
    let items = _btxt_list_items(inner)
    let out = ""
    let i = 0
    let n = len(items)
    while i < n
        if i > 0
            out = out + chr(10)
        out = out + "- " + _btxt_render(items[i])
        i = i + 1
    out

// ── main recursive scanner ───────────────────────────────────────────────────

fn _btxt_render(s) -> str
    let out_parts = []
    let n = len(s)
    let i = 0
    while i < n
        if slice(s, i, i + 1) == "["
            let rel = find(slice(s, i, n), "]")
            if rel < 0
                push(out_parts, "[")
                i = i + 1
            else
                let close = i + rel
                let raw_tag = slice(s, i + 1, close)
                let lname = lower(raw_tag)
                let content_start = close + 1
                if lname == "*"
                    push(out_parts, "- ")
                    i = content_start
                else
                    if lname == "b" or lname == "i" or lname == "u" or lname == "s"
                        let cp = _btxt_find_close(s, content_start, lname)
                        if cp < 0
                            push(out_parts, "[")
                            i = i + 1
                        else
                            push(out_parts, _btxt_render(slice(s, content_start, cp)))
                            i = _btxt_after_close(s, cp)
                    else
                        if starts_with(lname, "color=")
                            let cp = _btxt_find_close(s, content_start, "color")
                            if cp < 0
                                push(out_parts, "[")
                                i = i + 1
                            else
                                push(out_parts, _btxt_render(slice(s, content_start, cp)))
                                i = _btxt_after_close(s, cp)
                        else
                            if starts_with(lname, "size=")
                                let cp = _btxt_find_close(s, content_start, "size")
                                if cp < 0
                                    push(out_parts, "[")
                                    i = i + 1
                                else
                                    push(out_parts, _btxt_render(slice(s, content_start, cp)))
                                    i = _btxt_after_close(s, cp)
                            else
                                if lname == "url"
                                    let cp = _btxt_find_close(s, content_start, "url")
                                    if cp < 0
                                        push(out_parts, "[")
                                        i = i + 1
                                    else
                                        push(out_parts, _btxt_render(slice(s, content_start, cp)))
                                        i = _btxt_after_close(s, cp)
                                else
                                    if starts_with(lname, "url=")
                                        let target = slice(raw_tag, 4, len(raw_tag))
                                        let cp = _btxt_find_close(s, content_start, "url")
                                        if cp < 0
                                            push(out_parts, "[")
                                            i = i + 1
                                        else
                                            let inner = _btxt_render(slice(s, content_start, cp))
                                            push(out_parts, inner + " (" + target + ")")
                                            i = _btxt_after_close(s, cp)
                                    else
                                        if lname == "img"
                                            let cp = _btxt_find_close(s, content_start, "img")
                                            if cp < 0
                                                push(out_parts, "[")
                                                i = i + 1
                                            else
                                                let inner = slice(s, content_start, cp)
                                                push(out_parts, "[Image: " + inner + "]")
                                                i = _btxt_after_close(s, cp)
                                        else
                                            if lname == "quote"
                                                let cp = _btxt_find_close(s, content_start, "quote")
                                                if cp < 0
                                                    push(out_parts, "[")
                                                    i = i + 1
                                                else
                                                    let inner = _btxt_render(slice(s, content_start, cp))
                                                    push(out_parts, _btxt_quote_prefix(inner))
                                                    i = _btxt_after_close(s, cp)
                                            else
                                                if lname == "code"
                                                    let cp = _btxt_find_close(s, content_start, "code")
                                                    if cp < 0
                                                        push(out_parts, "[")
                                                        i = i + 1
                                                    else
                                                        let inner = slice(s, content_start, cp)
                                                        push(out_parts, _btxt_indent_block(inner))
                                                        i = _btxt_after_close(s, cp)
                                                else
                                                    if lname == "list"
                                                        let cp = _btxt_find_close(s, content_start, "list")
                                                        if cp < 0
                                                            push(out_parts, "[")
                                                            i = i + 1
                                                        else
                                                            let inner = slice(s, content_start, cp)
                                                            push(out_parts, _btxt_render_list(inner))
                                                            i = _btxt_after_close(s, cp)
                                                    else
                                                        push(out_parts, "[")
                                                        i = i + 1
        else
            push(out_parts, slice(s, i, i + 1))
            i = i + 1
    let out = join(out_parts, "")
    out

// ── public API ───────────────────────────────────────────────────────────────

fn btxt_convert(input) -> str
    _btxt_render(input)
