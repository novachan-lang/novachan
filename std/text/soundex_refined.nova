// std/text/soundex_refined.nova -- Refined Soundex phonetic encoding.
// LEAF -- imports NOTHING.
//
// DUPLICATE-SURVEY NOTE: std/text/soundex.nova (sx_) and std/text/phonetics.nova
// (ph_soundex) already implement CLASSIC American Soundex. std/phonetic/
// additionally has daitch_mokotoff.nova (Jewish/Slavic multi-code Soundex),
// phonex.nova (Lait & Randell 1996 preprocessing variant), roman_soundex.nova
// (classic, again), cologne.nova (German), lein.nova, match_rating.nova,
// nysiis.nova, onca.nova, statcan_code.nova. NONE of these implement
// "Refined Soundex" specifically: a distinct, well-known variant (the
// algorithm behind Apache Commons Codec's RefinedSoundex) that uses a
// finer 0-9 digit mapping (vs. classic Soundex's 0-6), does NOT reset the
// same-code run on vowels (only collapses immediately-adjacent duplicate
// digits), and does NOT truncate to a fixed 4 characters -- producing a
// longer, more discriminating code. This is a materially different,
// independently useful algorithm, not a re-skin of classic Soundex.
//
// Mapping (0-9, from Apache Commons Codec's US_ENGLISH refined mapping):
//   A E H I O U W Y -> 0
//   B P             -> 1
//   F V             -> 2
//   C K S           -> 3
//   G J             -> 4
//   Q X Z           -> 5
//   D T             -> 6
//   L               -> 7
//   M N             -> 8
//   R               -> 9
//
// Encoding algorithm:
//   1. Uppercase, strip non-letters. Empty input -> "".
//   2. Output starts with the first LETTER itself (not its digit).
//   3. Then, for EVERY letter of the (cleaned) word in order -- including
//      the first letter again -- append its digit, EXCEPT when it equals
//      the immediately preceding appended digit (adjacent-duplicate
//      collapse only; unlike classic Soundex, vowels do NOT reset the run).
//
// Hand-verified traces (see module docstring in the KAT file for more):
//   rsx_encode("The")     == "T60"
//   rsx_encode("Dog")     == "D604"
//   rsx_encode("Quick")   == "Q503"
//   rsx_encode("Brown")   == "B1908"
//   rsx_encode("Fox")     == "F205"
//   rsx_encode("Lazy")    == "L7050"
//   rsx_encode("Testing") == "T6036084"
//   rsx_encode("Cat")     == "C306"

// rsx_code_of: refined-Soundex digit (0-9) for a single uppercase letter.
// Non-letters return -1 (callers filter those out before calling this).
fn rsx_code_of(c: string) -> int
    if c == "A" or c == "E" or c == "H" or c == "I" or c == "O" or c == "U" or c == "W" or c == "Y"
        return 0
    if c == "B" or c == "P"
        return 1
    if c == "F" or c == "V"
        return 2
    if c == "C" or c == "K" or c == "S"
        return 3
    if c == "G" or c == "J"
        return 4
    if c == "Q" or c == "X" or c == "Z"
        return 5
    if c == "D" or c == "T"
        return 6
    if c == "L"
        return 7
    if c == "M" or c == "N"
        return 8
    if c == "R"
        return 9
    return -1

// _rsx_clean: uppercase and keep only A-Z letters.
fn _rsx_clean(name: string) -> string
    let up = upper(name)
    let n = len(up)
    let out = ""
    let i = 0
    while i < n
        let c = up[i]
        if rsx_code_of(c) >= 0
            out = out + c
        i = i + 1
    return out

// rsx_encode: full Refined Soundex code for name. Empty/all-non-letter
// input returns "".
fn rsx_encode(name: string) -> string
    let clean = _rsx_clean(name)
    let n = len(clean)
    if n == 0
        return ""
    let first = clean[0]
    let out = first
    let last_digit = -1
    let i = 0
    while i < n
        let d = rsx_code_of(clean[i])
        if d != last_digit
            out = out + str(d)
            last_digit = d
        i = i + 1
    return out

// rsx_compare: true iff a and b have the same Refined Soundex code.
fn rsx_compare(a: string, b: string) -> bool
    return rsx_encode(a) == rsx_encode(b)

// rsx_similarity: length of the common prefix of the two Refined Soundex
// codes (0..min length). Higher = more phonetically similar under this
// finer-grained code.
fn rsx_similarity(a: string, b: string) -> int
    let ca = rsx_encode(a)
    let cb = rsx_encode(b)
    let la = len(ca)
    let lb = len(cb)
    let lim = la
    if lb < lim
        lim = lb
    let i = 0
    while i < lim
        if ca[i] != cb[i]
            return i
        i = i + 1
    return lim
