// ============================================================================
// NOVA Standard Library — std/text/md_code_block
// ============================================================================
// Markdown fenced code block rendering.
//
// Public API:
//   md_code_block(text) -> string
//       Convert a fenced Markdown code block to HTML.
//       The block is delimited by lines that are exactly "```" (optionally with
//       a language tag on the opening fence, e.g. "```python" — the tag is
//       ignored). Content between the fences is HTML-escaped and wrapped in
//       <pre><code>...</code></pre>.
//       Inner newlines (chr(10)) in the content are preserved.
//       If no valid fenced block is found, returns text unchanged.
//
//   md_code_escape(s) -> string
//       HTML-escape a string: & -> &amp;  < -> &lt;  > -> &gt;
//       Used internally and exported for composability.
//
// LEAF — imports NOTHING.
// ============================================================================

// md_code_escape(s) -> string
// Replace &, <, > with HTML entities. Order matters: & must go first.
fn md_code_escape(s) -> string
    let n = len(s)
    let out = ""
    for i in 0..n
        let c = slice(s, i, i + 1)
        if c == "&"
            out += "&amp;"
        else
            if c == "<"
                out += "&lt;"
            else
                if c == ">"
                    out += "&gt;"
                else
                    out += c
    out

// _md_cb_split: split s on chr(10); trailing empty element dropped.
fn _md_cb_split(s) -> list
    let nl = chr(10)
    let raw = split(s, nl)
    let rlen = len(raw)
    if rlen > 0 and len(raw[rlen - 1]) == 0
        let out = []
        for i in 0..(rlen - 1)
            out += [raw[i]]
        return out
    raw

// _md_cb_is_fence: return 1 if line starts with "```"
fn _md_cb_is_fence(line) -> int
    if len(line) >= 3 and slice(line, 0, 3) == "```"
        return 1
    0

// md_code_block(text) -> string
fn md_code_block(text) -> string
    let nl = chr(10)
    let lines = _md_cb_split(text)
    let n = len(lines)
    if n == 0
        return text
    // Find opening fence
    let open_idx = -1
    let i = 0
    while i < n
        if _md_cb_is_fence(lines[i]) == 1
            open_idx = i
            i = n  // break
        i += 1
    if open_idx < 0
        return text
    // Find closing fence (must be exactly "```")
    let close_idx = -1
    let j = open_idx + 1
    while j < n
        if lines[j] == "```"
            close_idx = j
            j = n  // break
        j += 1
    if close_idx < 0
        return text
    // Collect content lines between fences
    let content = ""
    let k = open_idx + 1
    while k < close_idx
        if k > open_idx + 1
            content += nl + md_code_escape(lines[k])
        else
            content = md_code_escape(lines[k])
        k += 1
    "<pre><code>" + content + "</code></pre>"
