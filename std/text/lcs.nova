// ============================================================================
// NOVA Standard Library — std/text/lcs
// ============================================================================
// Longest common subsequence (LCS) algorithms.
//
// Public API:
//   lcs_length(a, b)     -> int    length of the LCS of strings a and b
//   lcs_string(a, b)     -> string one valid LCS reconstruction
//   lcs_similarity(a, b) -> float  2*lcs_length/(len a + len b); 0.0 if both empty
//
// All three functions use the classic O(m*n) DP table.
//
// lcs_length uses two rolling rows (O(n) space).
// lcs_string stores the full (m+1)*(n+1) table as a flat list (row-major) so
//   it can backtrack from dp[(m)(n+1)+n] to reconstruct one valid LCS.
//
// Gotchas observed in NOVA:
//   - Lists have no in-place element write; we rebuild rows via concatenation.
//   - Bare big-float return causes uninit-slot bug; bind every float to a let.
//   - '/' on two ints is integer division; cast with *1.0 before dividing.
//   - 'and'/'or' instead of '&&'/'||'.
//   - No multiline function-call args; use intermediate lets.
// ============================================================================

// ── lcs_length ────────────────────────────────────────────────────────────────

// lcs_length returns the length of the longest common subsequence of a and b.
// A subsequence is formed by deleting zero or more characters (not necessarily
// contiguous). Uses two rolling rows: O(m*n) time, O(n) space.
fn lcs_length(a, b) -> int
    let m = len(a)
    let n = len(b)
    if m == 0 or n == 0
        return 0

    // Row 0: LCS("", b[0..j-1]) = 0 for all j.
    let prev = [0 for j in 0..(n + 1)]

    for i in 1..(m + 1)
        let curr = [0]
        let ca = ord(a[i - 1])
        for k in 1..(n + 1)
            let cb = ord(b[k - 1])
            let v = 0
            if ca == cb
                v = prev[k - 1] + 1
            else
                v = prev[k]
                if curr[k - 1] > v
                    v = curr[k - 1]
            push(curr, v)
        prev = curr
    prev[n]

// ── lcs_string ────────────────────────────────────────────────────────────────

// _lcs_row_start returns the index of the first element of row r in a flat
// (m+1)*(n+1) table stored row-major.  row r starts at r*(n+1).
fn _lcs_row_start(r, n) -> int
    r * (n + 1)

// lcs_string reconstructs one valid LCS of a and b.
// It first builds the full (m+1)*(n+1) DP table as a flat list, then
// backtracks from dp[m][n] to collect the LCS characters in reverse, then
// reverses the collected list to produce the final string.
fn lcs_string(a, b) -> string
    let m = len(a)
    let n = len(b)
    if m == 0 or n == 0
        return ""

    // Build the full DP table as a flat list (row-major).
    // dp[i*(n+1)+j] = lcs_length(a[0..i-1], b[0..j-1])
    // Row 0: all zeros.
    let dp = [0 for j in 0..(n + 1)]

    for i in 1..(m + 1)
        // Column 0 of row i: 0.
        push(dp, 0)
        let ca = ord(a[i - 1])
        for k in 1..(n + 1)
            let cb = ord(b[k - 1])
            let prev_row_diag = dp[_lcs_row_start(i - 1, n) + k - 1]
            let prev_row_same = dp[_lcs_row_start(i - 1, n) + k]
            let curr_row_prev = dp[_lcs_row_start(i, n) + k - 1]
            let v = 0
            if ca == cb
                v = prev_row_diag + 1
            else
                v = prev_row_same
                if curr_row_prev > v
                    v = curr_row_prev
            push(dp, v)

    // Backtrack from dp[m][n] to collect LCS characters.
    let chars = []
    let bi = m
    let bj = n
    while bi > 0 and bj > 0
        let ca2 = ord(a[bi - 1])
        let cb2 = ord(b[bj - 1])
        if ca2 == cb2
            chars.push(a[bi - 1])
            bi = bi - 1
            bj = bj - 1
        else
            let up_idx = _lcs_row_start(bi - 1, n) + bj
            let left_idx = _lcs_row_start(bi, n) + bj - 1
            let up_val = dp[up_idx]
            let left_val = dp[left_idx]
            if up_val >= left_val
                bi = bi - 1
            else
                bj = bj - 1

    // Reverse chars to get LCS in forward order.
    join(reverse(chars), "")

// ── lcs_similarity ────────────────────────────────────────────────────────────

// lcs_similarity returns 2 * lcs_length(a,b) / (len(a) + len(b)).
// This is the Sørensen-Dice-style overlap coefficient for sequences.
// Returns 0.0 if both strings are empty (by convention, not division-by-zero).
fn lcs_similarity(a, b) -> float
    let la = len(a)
    let lb = len(b)
    if la == 0 and lb == 0
        return 0.0
    let llen = lcs_length(a, b)
    let num = (2 * llen) * 1.0
    let den = (la + lb) * 1.0
    let result = num / den
    result

// ============================================================================
fn main()
    print("std/text/lcs loaded")
