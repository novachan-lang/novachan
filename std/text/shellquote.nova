// std/text/shellquote.nova
// POSIX shell single-quote quoting (inverse of shell word splitting).
// sq_quote(s)         -> safe shell token (single-quoted if needed)
// sq_quote_list(args) -> space-joined quoted args
// sq_needs_quoting(s) -> bool: true if s contains shell-special chars

fn _is_safe_char(c)
    let o = ord(c)
    if o >= 65
        if o <= 90
            return true
    if o >= 97
        if o <= 122
            return true
    if o >= 48
        if o <= 57
            return true
    if o == 95
        return true
    if o == 46
        return true
    if o == 47
        return true
    if o == 45
        return true
    return false

fn sq_needs_quoting(s)
    let n = len(s)
    if n == 0
        return true
    let i = 0
    while i < n
        let c = char_at(s, i)
        if _is_safe_char(c) == false
            return true
        i = i + 1
    return false

fn sq_quote(s)
    let n = len(s)
    if n == 0
        return "''"
    if sq_needs_quoting(s) == false
        return s
    let sq = chr(39)
    let dq = chr(34)
    let escape_seq = sq + dq + sq + dq + sq
    let result = sq
    let i = 0
    while i < n
        let c = char_at(s, i)
        if ord(c) == 39
            result = result + escape_seq
        else
            result = result + c
        i = i + 1
    result = result + sq
    return result

fn sq_quote_list(args)
    let n = len(args)
    if n == 0
        return ""
    let result = sq_quote(args[0])
    let i = 1
    while i < n
        result = result + " " + sq_quote(args[i])
        i = i + 1
    return result
