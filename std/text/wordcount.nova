// ============================================================================
// NOVA Standard Library — std/text/wordcount
// ============================================================================
// Text statistics: word/char/line/sentence counts, word-frequency dict,
// and top-k by frequency.
//
// Public API:
//   wc_words(s) -> int          whitespace-separated non-empty tokens
//   wc_chars(s) -> int          total character count (byte count)
//   wc_lines(s) -> int          newline-separated lines; empty->0
//   wc_sentences(s) -> int      count of . ! ? terminators
//   wc_frequency(s) -> dict     word (lowercased, alnum only) -> count
//   wc_top(s, k) -> list        [[word, count], ...] top-k by count desc
//
// Design notes:
//   - Whitespace = space (32), tab (9), carriage-return (13), newline (10).
//     Sequences of whitespace collapse: leading/trailing tokens are skipped.
//   - wc_lines: empty string -> 0; otherwise count chr(10) + 1.
//     Trailing newline adds one more line (consistent with POSIX wc -l).
//   - wc_frequency: tokens are extracted by the same whitespace-split as
//     wc_words, then each token is stripped to alnum bytes only and lowercased.
//     Tokens that reduce to empty string after stripping are ignored.
//   - wc_top: sort pairs descending by count via sort_by with negated key,
//     then return the first min(k, len(pairs)) entries.
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Return 1 if byte code b is ASCII whitespace (space, tab, CR, LF), else 0.
fn _wc_is_ws(b) -> int
    if b == 32
        return 1
    if b == 9
        return 1
    if b == 13
        return 1
    if b == 10
        return 1
    0

// Return 1 if byte code b is ASCII alphanumeric (A-Z, a-z, 0-9), else 0.
fn _wc_is_alnum(b) -> int
    if b >= 65 and b <= 90
        return 1
    if b >= 97 and b <= 122
        return 1
    if b >= 48 and b <= 57
        return 1
    0

// Lowercase a single ASCII uppercase byte; leave others unchanged.
fn _wc_lower_byte(b) -> int
    if b >= 65 and b <= 90
        return b + 32
    b

// Split string s on whitespace, returning a list of non-empty tokens.
// Handles runs of whitespace (tab, space, CR, LF) as a single separator.
fn _wc_split_ws(s) -> list
    let toks = []
    let n = len(s)
    let i = 0
    let cur = ""
    while i < n
        let b = ord(s[i])
        if _wc_is_ws(b) == 1
            if len(cur) > 0
                push(toks, cur)
                cur = ""
        else
            cur = cur + chr(b)
        i = i + 1
    if len(cur) > 0
        push(toks, cur)
    toks

// Extract the alnum-only, lowercased form of token t.
// Returns "" if t has no alnum characters.
fn _wc_normalize_token(t) -> str
    let out_parts = []
    let n = len(t)
    for i in 0..n
        let b = ord(t[i])
        if _wc_is_alnum(b) == 1
            push(out_parts, chr(_wc_lower_byte(b)))
    let out = join(out_parts, "")
    out

// ── public API ───────────────────────────────────────────────────────────────

// Count whitespace-separated non-empty tokens in s.
fn wc_words(s) -> int
    let toks = _wc_split_ws(s)
    len(toks)

// Count characters (bytes) in s.
fn wc_chars(s) -> int
    len(s)

// Count newline-separated lines.
// Empty string -> 0. Otherwise: number of chr(10) occurrences + 1.
// "a\nb\nc" has 2 newlines -> 3 lines.
fn wc_lines(s) -> int
    if len(s) == 0
        return 0
    let n = len(s)
    let count = 0
    for i in 0..n
        if ord(s[i]) == 10
            count = count + 1
    count + 1

// Count sentence terminators: '.', '!', '?'.
fn wc_sentences(s) -> int
    let n = len(s)
    let count = 0
    for i in 0..n
        let b = ord(s[i])
        if b == 46 or b == 33 or b == 63
            count = count + 1
    count

// Build a word-frequency dict: lowercased, alnum-only tokens -> occurrence count.
// Tokens that reduce to empty string after alnum-stripping are skipped.
fn wc_frequency(s) -> dict
    let freq = {}
    let toks = _wc_split_ws(s)
    let n = len(toks)
    for i in 0..n
        let word = _wc_normalize_token(toks[i])
        if len(word) > 0
            if contains(freq, word)
                freq[word] = freq[word] + 1
            else
                freq[word] = 1
    freq

// Return top-k words by frequency descending as [[word, count], ...].
// Ties may appear in any stable order (sort_by is stable in NOVA).
fn wc_top(s, k) -> list
    let freq = wc_frequency(s)
    let ks = keys(freq)
    let pairs = []
    for i in 0..len(ks)
        let w = ks[i]
        push(pairs, [w, freq[w]])
    // sort descending by count: negate the count as the key
    let sorted = sort_by(pairs, fn(p) 0 - p[1])
    // return first k entries
    let result = []
    let j = 0
    let lim = k
    if len(sorted) < lim
        lim = len(sorted)
    while j < lim
        push(result, sorted[j])
        j = j + 1
    result
