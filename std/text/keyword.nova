// ============================================================================
// NOVA Standard Library — std/text/keyword
// ============================================================================
// RAKE — Rapid Automatic Keyword Extraction.
// Extracts candidate keyword phrases by splitting text at stopwords and
// punctuation, then ranks them by a word-score (degree / frequency).
//
// Public API:
//   kw_stopwords()                       -> any    list of ~40 stopwords
//   kw_is_stop(word)                     -> bool   is word a stopword?
//   kw_candidate_phrases(text)           -> any    list of (list of content words)
//   kw_word_freq(phrases)                -> any    dict word -> frequency
//   kw_word_degree(phrases)              -> any    dict word -> degree
//   kw_word_score(phrases)               -> any    dict word -> degree/freq
//   kw_phrase_score(phrase, wordscores)  -> float  sum of member word scores
//   kw_rake(text)                        -> any    [{phrase,score}…] desc
//   kw_rake_top(text, n)                 -> any    top-n phrase strings
//   kw_score(text, phrase)               -> float  score for a specific phrase
//   kw_normalize(text)                   -> string lowercase text
//   kw_dedup(phrases)                    -> any    deduplicated phrase lists
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _kw_lower_char: lowercase a single ASCII character (returns lowercased string).
fn _kw_lower_char(c) -> string
    let o = ord(c)
    if o >= 65 and o <= 90
        return chr(o + 32)
    c

// _kw_lower: lowercase an ASCII string.
fn _kw_lower(s) -> string
    let n = len(s)
    let result = ""
    let i = 0
    while i < n
        let c = slice(s, i, i + 1)
        result = result + _kw_lower_char(c)
        i = i + 1
    result

// _kw_is_alpha_code: true if char code is a-z or A-Z.
fn _kw_is_alpha_code(o) -> bool
    if o >= 65 and o <= 90
        return true
    if o >= 97 and o <= 122
        return true
    false

// _kw_is_splitter: true if the character is a stopword/punctuation boundary.
// Splits on: space, tab, newline, CR, comma, period, exclamation, question,
// semicolon, colon, parentheses, slash, pipe, dash (when standalone), quote chars.
fn _kw_is_splitter(o) -> bool
    if o == 32 then return true
    if o == 9  then return true
    if o == 10 then return true
    if o == 13 then return true
    if o == 44 then return true
    if o == 46 then return true
    if o == 33 then return true
    if o == 63 then return true
    if o == 59 then return true
    if o == 58 then return true
    if o == 40 then return true
    if o == 41 then return true
    if o == 47 then return true
    if o == 124 then return true
    if o == 45 then return true
    if o == 39 then return true
    if o == 34 then return true
    false

// _kw_split_words_from: split s into lowercased alpha tokens (words).
fn _kw_split_words_from(s) -> any
    let n = len(s)
    let result = []
    let i = 0
    let start = 0
    let in_word = false
    while i < n
        let o = ord(slice(s, i, i + 1))
        if _kw_is_alpha_code(o)
            if in_word == false
                start = i
                in_word = true
        else
            if in_word
                push(result, _kw_lower(slice(s, start, i)))
                in_word = false
        i = i + 1
    if in_word
        push(result, _kw_lower(slice(s, start, n)))
    result

// _kw_phrase_to_str: join a phrase (list of words) into a space-separated string.
fn _kw_phrase_to_str(phrase) -> string
    let n = len(phrase)
    if n == 0
        return ""
    let result = phrase[0]
    let i = 1
    while i < n
        result = result + " " + phrase[i]
        i = i + 1
    result

// _kw_sort_desc: insertion sort [{phrase,score}] descending by score.
// Uses a 'done' flag to break inner loop without corrupting j.
fn _kw_sort_desc(items) -> any
    let n = len(items)
    let i = 1
    while i < n
        let cur = items[i]
        let cs = cur["score"]
        let j = i - 1
        let pos = i
        let done = false
        while j >= 0 and done == false
            let prev = items[j]
            let ps = prev["score"]
            if ps < cs
                items[j + 1] = prev
                pos = j
                j = j - 1
            else
                done = true
        items[pos] = cur
        i = i + 1
    items

// ── public API ───────────────────────────────────────────────────────────────

// kw_stopwords returns a list of ~40 common English stopwords used by RAKE.
fn kw_stopwords() -> any
    let stops = []
    push(stops, "a")
    push(stops, "an")
    push(stops, "the")
    push(stops, "and")
    push(stops, "or")
    push(stops, "but")
    push(stops, "in")
    push(stops, "on")
    push(stops, "at")
    push(stops, "to")
    push(stops, "for")
    push(stops, "of")
    push(stops, "with")
    push(stops, "by")
    push(stops, "from")
    push(stops, "as")
    push(stops, "is")
    push(stops, "are")
    push(stops, "was")
    push(stops, "were")
    push(stops, "be")
    push(stops, "been")
    push(stops, "being")
    push(stops, "have")
    push(stops, "has")
    push(stops, "had")
    push(stops, "do")
    push(stops, "does")
    push(stops, "did")
    push(stops, "will")
    push(stops, "would")
    push(stops, "could")
    push(stops, "should")
    push(stops, "may")
    push(stops, "might")
    push(stops, "this")
    push(stops, "that")
    push(stops, "it")
    push(stops, "its")
    push(stops, "not")
    stops

// kw_is_stop returns true if word is a common English stopword.
fn kw_is_stop(word) -> bool
    let w = _kw_lower(word)
    let stops = kw_stopwords()
    let n = len(stops)
    let i = 0
    while i < n
        if stops[i] == w
            return true
        i = i + 1
    false

// kw_candidate_phrases splits text into candidate phrases (lists of content words),
// breaking at stopwords and punctuation. Empty phrases are discarded.
fn kw_candidate_phrases(text) -> any
    let words = _kw_split_words_from(text)
    let n = len(words)
    let phrases = []
    let current = []
    let i = 0
    while i < n
        let w = words[i]
        if kw_is_stop(w)
            if len(current) > 0
                push(phrases, current)
                current = []
        else
            push(current, w)
        i = i + 1
    if len(current) > 0
        push(phrases, current)
    phrases

// kw_word_freq builds a dict mapping each word to its total occurrence count
// across all phrases.
fn kw_word_freq(phrases) -> any
    let freq = {}
    let n = len(phrases)
    let i = 0
    while i < n
        let phrase = phrases[i]
        let m = len(phrase)
        let j = 0
        while j < m
            let w = phrase[j]
            if contains(freq, w)
                freq[w] = freq[w] + 1
            else
                freq[w] = 1
            j = j + 1
        i = i + 1
    freq

// kw_word_degree builds a dict mapping each word to its degree:
// for each phrase containing the word, add the phrase length.
fn kw_word_degree(phrases) -> any
    let deg = {}
    let n = len(phrases)
    let i = 0
    while i < n
        let phrase = phrases[i]
        let plen = len(phrase)
        let m = plen
        let j = 0
        while j < m
            let w = phrase[j]
            if contains(deg, w)
                deg[w] = deg[w] + plen
            else
                deg[w] = plen
            j = j + 1
        i = i + 1
    deg

// kw_word_score builds a dict mapping each word to degree/freq.
fn kw_word_score(phrases) -> any
    let freq = kw_word_freq(phrases)
    let deg = kw_word_degree(phrases)
    let scores = {}
    let ks = keys(freq)
    let n = len(ks)
    let i = 0
    while i < n
        let w = ks[i]
        let f = freq[w] * 1.0
        let d = deg[w] * 1.0
        scores[w] = d / f
        i = i + 1
    scores

// kw_phrase_score sums the word scores for each member of phrase.
fn kw_phrase_score(phrase, wordscores) -> float
    let n = len(phrase)
    let total = 0.0
    let i = 0
    while i < n
        let w = phrase[i]
        if contains(wordscores, w)
            let s = wordscores[w]
            total = total + s
        i = i + 1
    total

// kw_rake returns [{phrase:string, score:float}] sorted descending by score.
fn kw_rake(text) -> any
    let phrases = kw_candidate_phrases(text)
    let ws = kw_word_score(phrases)
    let n = len(phrases)
    let items = []
    let i = 0
    while i < n
        let phrase = phrases[i]
        let pstr = _kw_phrase_to_str(phrase)
        let ps = kw_phrase_score(phrase, ws)
        let entry = {}
        entry["phrase"] = pstr
        entry["score"] = ps
        push(items, entry)
        i = i + 1
    let sorted = _kw_sort_desc(items)
    sorted

// kw_rake_top returns the top-n phrase strings from kw_rake.
fn kw_rake_top(text, n) -> any
    let ranked = kw_rake(text)
    let total = len(ranked)
    let limit = n
    if total < limit
        limit = total
    let result = []
    let i = 0
    while i < limit
        let entry = ranked[i]
        push(result, entry["phrase"])
        i = i + 1
    result

// kw_score returns the RAKE score for a specific phrase string in text.
// Returns 0.0 if the phrase is not found among candidates.
fn kw_score(text, phrase) -> float
    let ranked = kw_rake(text)
    let n = len(ranked)
    let i = 0
    while i < n
        let entry = ranked[i]
        if entry["phrase"] == phrase
            let s = entry["score"]
            return s
        i = i + 1
    0.0

// kw_normalize lowercases a text string.
fn kw_normalize(text) -> string
    _kw_lower(text)

// kw_dedup removes duplicate phrase lists from candidate phrases.
// Two phrases are duplicates if their string representations match.
fn kw_dedup(phrases) -> any
    let seen = {}
    let result = []
    let n = len(phrases)
    let i = 0
    while i < n
        let phrase = phrases[i]
        let pstr = _kw_phrase_to_str(phrase)
        if contains(seen, pstr) == 0
            seen[pstr] = 1
            push(result, phrase)
        i = i + 1
    result

fn main()
    print("std/text/keyword loaded")
