// ============================================================================
// NOVA Standard Library — CSV + config (key=value) parsing
// ============================================================================
// Pure NOVA (no new builtins). Closes audit-flagged gaps:
//   parse_csv_line / parse_csv / csv_field      (data formats; RFC-4180-ish)
//   parse_config                                (Serialization cat-18: KV config)
// RFC 4180 rules handled: fields separated by ',', fields may be wrapped in
// double quotes, an embedded quote is written as "" inside a quoted field, and
// quoted fields may contain commas. Byte-level via ord(s[i]) (44=',' 34='"').

// ── CSV parse ───────────────────────────────────────────────────────────────

// Parse ONE record line into a list of field strings.
fn parse_csv_line(line)
    let fields = []
    let cur = ""
    let i = 0
    let n = len(line)
    let inq = 0
    while i < n
        let b = ord(line[i])
        if inq == 1
            if b == 34
                if i + 1 < n and ord(line[i + 1]) == 34
                    cur = cur + chr(34)          // "" -> literal "
                    i = i + 2
                else
                    inq = 0                      // closing quote
                    i = i + 1
            else
                cur = cur + chr(b)
                i = i + 1
        else
            if b == 34
                inq = 1
                i = i + 1
            else if b == 44
                fields = fields + [cur]
                cur = ""
                i = i + 1
            else
                cur = cur + chr(b)
                i = i + 1
    fields = fields + [cur]
    return fields

// Parse a whole CSV document (lines separated by '\n') into a list of records.
// Blank lines are skipped. (Embedded newlines inside quoted fields are out of
// scope for this line-oriented splitter — documented limitation.)
fn parse_csv(text)
    let rows = []
    let lines = split(text, "\n")
    let i = 0
    while i < len(lines)
        let ln = lines[i]
        // strip a trailing \r (CRLF files)
        if len(ln) > 0 and ord(ln[len(ln) - 1]) == 13
            ln = slice(ln, 0, len(ln) - 1)
        if len(ln) > 0
            rows = rows + [parse_csv_line(ln)]
        i = i + 1
    return rows

// Quote a single field for output if it contains ',', '"', or a newline.
fn csv_field(s) -> string
    let needs = 0
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(s[i])
        if b == 44 or b == 34 or b == 10 or b == 13
            needs = 1
        i = i + 1
    if needs == 0
        return s
    // wrap in quotes, doubling any embedded quote
    let out = chr(34)
    let j = 0
    while j < n
        let b = ord(s[j])
        if b == 34
            out = out + chr(34) + chr(34)
        else
            out = out + chr(b)
        j = j + 1
    return out + chr(34)

// ── config (key=value) parse ────────────────────────────────────────────────
// One pair per line. '#' or ';' starting a line (after trim) is a comment.
// Whitespace around key and value is trimmed. A line with no '=' is ignored.
fn parse_config(text)
    let d = {}
    let lines = split(text, "\n")
    let i = 0
    while i < len(lines)
        let raw = lines[i]
        if len(raw) > 0 and ord(raw[len(raw) - 1]) == 13
            raw = slice(raw, 0, len(raw) - 1)
        let ln = trim(raw)
        if len(ln) > 0
            let c0 = ord(ln[0])
            if c0 != 35 and c0 != 59             // not '#' and not ';'
                let eq = find(ln, "=")
                if eq >= 0
                    let k = trim(slice(ln, 0, eq))
                    let v = trim(slice(ln, eq + 1, len(ln)))
                    if len(k) > 0
                        d[k] = v
        i = i + 1
    return d

// ============================================================================
fn main()
    // ── parse_csv_line: basic ──
    let r = parse_csv_line("a,b,c")
    assert_eq(len(r), 3)
    assert_eq(r[0], "a")
    assert_eq(r[1], "b")
    assert_eq(r[2], "c")

    // empty fields
    let r2 = parse_csv_line("a,,c")
    assert_eq(len(r2), 3)
    assert_eq(r2[1], "")
    assert_eq(parse_csv_line("")[0], "")          // one empty field

    // quoted field containing a comma
    let r3 = parse_csv_line("a," + chr(34) + "b,c" + chr(34) + ",d")
    assert_eq(len(r3), 3)
    assert_eq(r3[0], "a")
    assert_eq(r3[1], "b,c")
    assert_eq(r3[2], "d")

    // embedded doubled-quote -> literal quote
    let r4 = parse_csv_line(chr(34) + "she said " + chr(34) + chr(34) + "hi" + chr(34) + chr(34) + chr(34))
    assert_eq(len(r4), 1)
    assert_eq(r4[0], "she said " + chr(34) + "hi" + chr(34))

    // ── parse_csv: document ──
    let doc = parse_csv("name,age\r\nAlice,30\nBob,25\n")
    assert_eq(len(doc), 3)                         // header + 2 rows (blank skipped)
    assert_eq(doc[0][0], "name")
    assert_eq(doc[1][0], "Alice")
    assert_eq(doc[1][1], "30")
    assert_eq(doc[2][1], "25")

    // ── csv_field: quoting on output ──
    assert_eq(csv_field("plain"), "plain")
    assert_eq(csv_field("a,b"), chr(34) + "a,b" + chr(34))
    assert_eq(csv_field("say " + chr(34) + "hi" + chr(34)), chr(34) + "say " + chr(34) + chr(34) + "hi" + chr(34) + chr(34) + chr(34))
    // round-trip: field -> line -> parse
    let f = "x,y" + chr(34) + "z"
    assert_eq(parse_csv_line(csv_field(f))[0], f)

    // ── parse_config ──
    let cfg = parse_config("# comment\nhost = localhost\nport=8080\n; another comment\n\nname =  NOVA  \n")
    assert_eq(cfg["host"], "localhost")
    assert_eq(cfg["port"], "8080")
    assert_eq(cfg["name"], "NOVA")                 // trimmed
    // comment lines and blank lines produced no keys; a no-'=' line is ignored
    let cfg2 = parse_config("a=1\njustkey\nb=2")
    assert_eq(cfg2["a"], "1")
    assert_eq(cfg2["b"], "2")

    print("csvx_test passed")
