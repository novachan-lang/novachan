// ============================================================================
// std/text/fuzzy_match — fzf-style subsequence fuzzy matching with scoring
// ============================================================================
// std/regex/glob.nova, std/parsing/glob.nova and std/parsing/wildcard.nova
// already cover shell-style wildcard matching (`*`, `?`, `[abc]`). This
// module is a different, complementary matching style: the "fuzzy finder"
// algorithm popularized by fzf/Sublime's Goto-Anything/VS Code's Quick
// Open, where the pattern only needs to appear as an ORDERED SUBSEQUENCE of
// the text's characters (not a contiguous substring, and no wildcard
// syntax at all) — typing "gmc" fuzzy-matches "get_module_config". Ranking
// candidates by a match quality score (not just a yes/no) is the whole
// point of the algorithm; a plain subsequence test alone accepts far too
// much to be useful for e.g. a fuzzy file-picker.
//
// Matching is case-insensitive throughout (both pattern and text are
// lower-cased before comparison).
//
// Scoring heuristic (higher is a better match):
//   +1   for every matched character
//   +8   extra when a matched character sits at a "word boundary" in text
//        (index 0, or the previous character is one of  space - _ / .)
//   +5   extra when a matched character immediately follows the previous
//        match (a run of consecutive matched characters, not just an
//        ordered subsequence)
//   -N   for each character skipped between two consecutive matches
//        (N = gap length - 1), so tighter matches score higher than loose,
//        scattered ones
// An empty pattern trivially matches everything with score 0. No match at
// all is reported as score -1 (never a valid non-empty-pattern score, since
// every real match scores >= len(pattern) >= 1).
//
// Public API:
//   fz_match(pattern, text)          -> bool   true iff pattern is a subsequence of text
//   fz_positions(pattern, text)      -> list   matched char indices in text, in order;
//                                                [] if no match (also [] for an empty pattern)
//   fz_score(pattern, text)          -> int    match quality, or -1 if no match
//   fz_best_match(pattern, cands)    -> string highest-scoring candidate, or "" if none match
//   fz_filter(pattern, cands)        -> list   matching candidates, best-score-first
//
// LEAF module — imports nothing.
// ============================================================================

// fz_match: true iff every character of pattern appears in text, in order
// (not necessarily contiguous), case-insensitive. An empty pattern always
// matches.
fn fz_match(pattern, text) -> bool
    let p = lower(pattern)
    let plen = len(p)
    if plen == 0
        return true
    let t = lower(text)
    let tlen = len(t)
    let ti = 0
    let pi = 0
    while pi < plen and ti < tlen
        if slice(p, pi, pi + 1) == slice(t, ti, ti + 1)
            pi += 1
        ti += 1
    return pi == plen

// fz_positions: the index (in text) of each matched pattern character, in
// left-to-right greedy order. Returns [] when pattern does not match, and
// also [] for an empty pattern (there is nothing to position).
fn fz_positions(pattern, text) -> list
    let p = lower(pattern)
    let plen = len(p)
    let out = []
    if plen == 0
        return out
    let t = lower(text)
    let tlen = len(t)
    let ti = 0
    let pi = 0
    while pi < plen and ti < tlen
        if slice(p, pi, pi + 1) == slice(t, ti, ti + 1)
            push(out, ti)
            pi += 1
        ti += 1
    if pi < plen
        let empty = []
        return empty
    return out

// _fz_is_boundary: true if index idx in text starts a "word" — either the
// very first character, or the character immediately before it is a
// separator (space, hyphen, underscore, slash, or dot).
fn _fz_is_boundary(text, idx) -> bool
    if idx == 0
        return true
    let prev = slice(text, idx - 1, idx)
    if prev == " " or prev == "-" or prev == "_" or prev == "/" or prev == "."
        return true
    return false

// fz_score: match-quality score for pattern against text (see module doc
// for the exact heuristic). -1 means no match at all.
fn fz_score(pattern, text) -> int
    if len(pattern) == 0
        return 0
    let positions = fz_positions(pattern, text)
    if len(positions) == 0
        return 0 - 1
    let score = 0
    let i = 0
    let n = len(positions)
    while i < n
        score += 1
        if _fz_is_boundary(text, positions[i])
            score += 8
        if i > 0
            let gap = positions[i] - positions[i - 1]
            if gap == 1
                score += 5
            else
                score -= (gap - 1)
        i += 1
    return score

// fz_best_match: the candidate with the highest fz_score against pattern;
// "" if no candidate matches (or the candidate list is empty). Ties keep
// the first-seen candidate.
fn fz_best_match(pattern, candidates) -> string
    let best = ""
    let best_score = 0 - 1
    let found = false
    for cand in candidates
        let s = fz_score(pattern, cand)
        if s >= 0
            if not found or s > best_score
                best_score = s
                best = cand
                found = true
    return best

// fz_filter: every candidate that matches pattern, ordered best-score-first
// (stable insertion sort — ties keep original relative order).
fn fz_filter(pattern, candidates) -> list
    let matched = []
    let scores = []
    for cand in candidates
        let s = fz_score(pattern, cand)
        if s >= 0
            push(matched, cand)
            push(scores, s)
    let n = len(matched)
    for i in 1..n
        let key_s = scores[i]
        let key_c = matched[i]
        let j = i - 1
        while j >= 0 and scores[j] < key_s
            scores[j + 1] = scores[j]
            matched[j + 1] = matched[j]
            j -= 1
        scores[j + 1] = key_s
        matched[j + 1] = key_c
    return matched
