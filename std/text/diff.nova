// ============================================================================
// NOVA Standard Library — std/text/diff
// ============================================================================
// Line-based diff via Longest Common Subsequence (LCS).
//
// Public API:
//   diff_lines(a_text, b_text) -> list of strings
//       Each element is prefixed:
//         " line"  — line appears in both a and b (common / context)
//         "-line"  — line appears only in a (removed)
//         "+line"  — line appears only in b (added)
//       The elements appear in the order they occur in the merged sequence.
//
// Algorithm:
//   1. Split each text on chr(10) into a list of lines.
//   2. Build the full LCS DP table (size (m+1)*(n+1), stored row-major in a
//      flat list) comparing lines as strings.
//   3. Backtrack from dp[m][n] to emit the edit script.
//
// Empty-text edge cases:
//   diff_lines("", "")  -> []
//   diff_lines("", "x") -> ["+x"]
//   diff_lines("x", "") -> ["-x"]
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _split_lines: split text on chr(10).
// Returns a list of line strings (possibly empty list if text=="").
fn _split_lines(text)
    let result = []
    if len(text) == 0
        return result
    let n = len(text)
    let start = 0
    let i = 0
    while i < n
        if text[i] == chr(10)
            // slice from start to i (exclusive)
            let line = slice(text, start, i)
            result.push(line)
            start = i + 1
        i += 1
    // push the last segment (may be "" if text ends with newline, but we want
    // trailing lines; if text does NOT end with newline push whatever remains)
    if start <= n
        let tail = slice(text, start, n)
        result.push(tail)
    result

// _lcs_dp: compute the full LCS DP table for two lists of strings.
// Returns a flat list of (m+1)*(n+1) ints, row-major (row=a-index, col=b-index).
// dp[i*(n+1)+j] = LCS length of a[0..i-1] and b[0..j-1].
fn _lcs_dp(a, b)
    let m = len(a)
    let n = len(b)
    let sz = (m + 1) * (n + 1)
    // Pre-fill with zeros.
    let dp = []
    for fill in 0..sz
        dp.push(0)
    // Fill DP table row by row.
    let i = 1
    while i <= m
        let j = 1
        while j <= n
            let idx = i * (n + 1) + j
            if a[i - 1] == b[j - 1]
                // extend LCS by 1 from diagonal
                let diag = dp[(i - 1) * (n + 1) + (j - 1)] + 1
                dp[idx] = diag
            else
                let from_top  = dp[(i - 1) * (n + 1) + j]
                let from_left = dp[i * (n + 1) + (j - 1)]
                if from_top >= from_left
                    dp[idx] = from_top
                else
                    dp[idx] = from_left
            j += 1
        i += 1
    dp

// ── Public API ───────────────────────────────────────────────────────────────

// diff_lines compares a_text and b_text line by line and returns an edit script.
// Each element of the returned list is a string prefixed by " " (common),
// "-" (removed from a), or "+" (added in b).
fn diff_lines(a_text, b_text)
    let a = _split_lines(a_text)
    let b = _split_lines(b_text)
    let m = len(a)
    let n = len(b)

    // Edge case: both empty.
    if m == 0 and n == 0
        return []

    // Edge case: a is empty — all lines in b are additions.
    if m == 0
        let out = []
        for j in 0..n
            out.push("+" + b[j])
        return out

    // Edge case: b is empty — all lines in a are deletions.
    if n == 0
        let out = []
        for i in 0..m
            out.push("-" + a[i])
        return out

    // General case: build LCS DP table then backtrack.
    let dp = _lcs_dp(a, b)

    // Backtrack from dp[m][n] to (0,0) collecting edit steps in reverse,
    // then reverse the collected list to get forward order.
    let rev = []
    let ci = m
    let cj = n
    while ci > 0 or cj > 0
        if ci > 0 and cj > 0 and a[ci - 1] == b[cj - 1]
            // Both sides match — common line.
            rev.push(" " + a[ci - 1])
            ci -= 1
            cj -= 1
        else
            // Decide: delete from a or insert from b?
            // Backtracking is in REVERSE order; to produce deletes-before-inserts in
            // the forward edit script we must emit inserts FIRST during backtracking
            // (they will appear AFTER deletes when the list is reversed).
            // Strategy: prefer INSERT (go left / decrement cj) unless going UP gives
            // a strictly better (higher) LCS score, or cj is already 0.
            let score_top  = 0
            let score_left = 0
            if ci > 0
                score_top = dp[(ci - 1) * (n + 1) + cj]
            if cj > 0
                score_left = dp[ci * (n + 1) + (cj - 1)]
            if cj == 0 or (ci > 0 and score_top > score_left)
                // Delete a[ci-1] (going up is strictly better, or no b left).
                rev.push("-" + a[ci - 1])
                ci -= 1
            else
                // Insert b[cj-1] (tie or going left is better).
                rev.push("+" + b[cj - 1])
                cj -= 1

    // Reverse rev to get the edit script in forward order.
    let result = []
    let ri = len(rev) - 1
    while ri >= 0
        result.push(rev[ri])
        ri -= 1
    result

// ── df_ API: pair-shaped edit script + convenience helpers ────────────────────
// Same LCS algorithm as diff_lines above, re-shaped into [op, line] pairs
// (op = "+" added / "-" removed / "=" unchanged) which is easier to consume
// programmatically than diff_lines' single-char-prefixed strings.

// df_lines: like diff_lines but each element is a 2-element list [op, line]
// with op in {"+", "-", "="} instead of a prefixed string.
fn df_lines(a_text, b_text) -> list
    let raw = diff_lines(a_text, b_text)
    let out = []
    for i in 0..len(raw)
        let s = raw[i]
        let op = slice(s, 0, 1)
        if op == " "
            op = "="
        let line = slice(s, 1, len(s))
        let pair = []
        pair.push(op)
        pair.push(line)
        out.push(pair)
    out

// df_summary: "N additions, M deletions" over a df_lines()-shaped list.
fn df_summary(changes) -> string
    let adds = 0
    let dels = 0
    for i in 0..len(changes)
        let op = changes[i][0]
        if op == "+"
            adds += 1
        else if op == "-"
            dels += 1
    str(adds) + " additions, " + str(dels) + " deletions"

// df_added: just the added lines, in order.
fn df_added(changes) -> list
    let out = []
    let i = 0
    while i < len(changes)
        if changes[i][0] == "+"
            out.push(changes[i][1])
        i += 1
    out

// df_removed: just the removed lines, in order.
fn df_removed(changes) -> list
    let out = []
    let i = 0
    while i < len(changes)
        if changes[i][0] == "-"
            out.push(changes[i][1])
        i += 1
    out

// df_patch: reconstruct the "b" text from a df_lines() edit script — keep
// unchanged ("=") and added ("+") lines in order, drop removed ("-") lines.
// `original` is accepted for API symmetry with a patch-application contract
// but the edit script alone is sufficient to reconstruct the target text.
fn df_patch(original, changes) -> string
    let lines = []
    let i = 0
    while i < len(changes)
        let op = changes[i][0]
        if op == "=" or op == "+"
            lines.push(changes[i][1])
        i += 1
    join(lines, chr(10))

// ============================================================================
fn main()
    print("std/text/diff loaded")
