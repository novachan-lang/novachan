// ============================================================================
// NOVA Standard Library — std/text/frequency
// ============================================================================
// Frequency analysis utilities.
//
// Public API:
//   freq_chars(s) -> dict
//       Returns a dict mapping each character (single-char string key)
//       to the number of times it appears in s. Empty string -> empty dict.
//
//   freq_words(text) -> dict
//       Whitespace-split text (space/tab/LF/CR; skip empty tokens).
//       Returns dict mapping each raw word to its occurrence count.
//
//   freq_top_k(text, k) -> list
//       Returns a list of [word, count] pairs for the top-k words by
//       count descending. Ties broken alphabetically ascending by word.
//       If k >= distinct word count, all are returned sorted.
//
//   freq_most_common_char(s) -> string
//       Returns the single-character string that appears most often in s.
//       Ties broken by first occurrence in s. Returns "" for empty string.
//
// Design notes:
//   - Characters are raw code points via char_at().
//   - Words are literal whitespace-split tokens (space/tab/LF/CR).
//   - Sorting uses insertion sort for correctness with NOVA's list semantics.
// ============================================================================

// ── private: whitespace test ─────────────────────────────────────────────────

fn _freq_is_ws(b) -> int
    let r = 0
    if b == 32
        r = 1
    if b == 9
        r = 1
    if b == 10
        r = 1
    if b == 13
        r = 1
    r

// ── private: split on whitespace ─────────────────────────────────────────────

fn _freq_split_ws(text) -> list
    let tokens = []
    let n = len(text)
    let i = 0
    let cur = ""
    while i < n
        let b = ord(char_at(text, i))
        if _freq_is_ws(b) == 1
            if len(cur) > 0
                tokens.push(cur)
                cur = ""
        else
            cur += char_at(text, i)
        i += 1
    if len(cur) > 0
        tokens.push(cur)
    tokens

// ── private: string less-than (lexicographic) ────────────────────────────────

fn _freq_str_lt(a, b) -> int
    let na = len(a)
    let nb = len(b)
    let limit = na
    if nb < limit
        limit = nb
    let i = 0
    let decided = 0
    let result = 0
    while i < limit and decided == 0
        let oa = ord(char_at(a, i))
        let ob = ord(char_at(b, i))
        if oa < ob
            result = 1
            decided = 1
        else if oa > ob
            decided = 1
        i += 1
    if decided == 0
        if na < nb
            result = 1
    result

// ── private: insertion sort [[word, count], ...] ─────────────────────────────
// Primary key: count descending. Secondary key: word ascending.

fn _freq_sort_pairs(pairs) -> list
    let n = len(pairs)
    for i in 1..n
        let cur = pairs[i]
        let cw = cur[0]
        let cc = cur[1]
        let j = i - 1
        let done = 0
        while j >= 0 and done == 0
            let p = pairs[j]
            let pw = p[0]
            let pc = p[1]
            let goes_before = 0
            if cc > pc
                goes_before = 1
            else if cc == pc
                if _freq_str_lt(cw, pw) == 1
                    goes_before = 1
            if goes_before == 1
                pairs[j + 1] = p
                j -= 1
            else
                done = 1
        let placed = [cw, cc]
        pairs[j + 1] = placed
    pairs

// ── public API ───────────────────────────────────────────────────────────────

fn freq_chars(s) -> dict
    let counts = {}
    let n = len(s)
    for i in 0..n
        let ch = char_at(s, i)
        if ch in counts
            counts[ch] = counts[ch] + 1
        else
            counts[ch] = 1
    counts

fn freq_words(text) -> dict
    let counts = {}
    let tokens = _freq_split_ws(text)
    let n = len(tokens)
    for i in 0..n
        let w = tokens[i]
        if w in counts
            counts[w] = counts[w] + 1
        else
            counts[w] = 1
    counts

fn freq_top_k(text, k) -> list
    let counts = freq_words(text)
    let ks = keys(counts)
    let nk = len(ks)
    let pairs = []
    for i in 0..nk
        let w = ks[i]
        let c = counts[w]
        let p = [w, c]
        pairs.push(p)
    let sorted = _freq_sort_pairs(pairs)
    let result = []
    let limit = k
    if len(sorted) < k
        limit = len(sorted)
    for j in 0..limit
        result.push(sorted[j])
    result

fn freq_most_common_char(s) -> string
    let n = len(s)
    if n == 0
        return ""
    let counts = freq_chars(s)
    let best_ch = char_at(s, 0)
    let best_cnt = counts[best_ch]
    for i in 1..n
        let ch = char_at(s, i)
        let cnt = counts[ch]
        if cnt > best_cnt
            best_ch = ch
            best_cnt = cnt
    best_ch
