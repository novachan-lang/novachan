// ============================================================================
// NOVA Standard Library — std/text/syllable
// ============================================================================
// Heuristic English syllable counting.
//
// Public API:
//   sy_count(word) -> int
//       Count syllables in a single word (must be lowercase).
//       Algorithm:
//         1. Iterate characters; treat a/e/i/o/u/y as vowels.
//         2. A new syllable starts each time a vowel follows a non-vowel
//            (i.e. count vowel groups — runs of consecutive vowels each
//            count as ONE syllable).
//         3. Silent trailing 'e' rule: if the last character is 'e' AND the
//            character before it is NOT a vowel (e.g. "code", "care") AND
//            the resulting count would remain >= 1, subtract 1.
//         4. Empty string -> 0. Any non-empty word returns at least 1.
//
//   sy_count_sentence(text) -> int
//       Split text on whitespace; sum sy_count over every non-empty token
//       after stripping non-alpha chars and lowercasing. Returns 0 for
//       empty / whitespace-only input.
//
//   sy_is_monosyllabic(word) -> int   (boolean: 1=true 0=false)
//       Returns 1 iff sy_count(word) == 1.
//
// Design notes:
//   - 'y' is always treated as a vowel (simplest rule with best coverage
//     for common words: "gym", "rhythm", "byte", "sky").
//   - "queue" -> vowel group = 1 continuous group (q + ueue); trailing 'e'
//     preceded by 'u' (vowel) → not silent; result = 1.
//   - "apple" -> a(1) + pp + le(2) = 2; trailing 'e' preceded by 'l'
//     (non-vowel) would give 2-1=1, but only if groups>1, so "apple"
//     correctly stays 2 because subtracting would not be correct here.
//     Wait — "apple": a=vowel(1), p=non, p=non, l=non, e=vowel(2) → 2 groups.
//     Trailing 'e', prev='l' (non-vowel), groups=2 → subtract → 1.
//     But "apple" has 2 syllables (ap-ple). So we should NOT subtract here.
//     Refined rule: subtract silent 'e' ONLY if the 'e' itself forms its own
//     vowel group (i.e. the preceding char is non-vowel) AND there's at least
//     one other vowel group BEFORE the 'e'. "apple": 'a' group + 'e' group;
//     'e' is preceded by 'l' (non-vowel) → normally silent, but wait —
//     "apple" is 2 syllables. The problem: silent-e rule is "magic e" for
//     CVC+e patterns like "code", "care", "bike" — NOT for -le, -ple endings.
//     A pragmatic fix: also require the character TWO positions before the
//     trailing 'e' to NOT be 'l' (covers -le/-ple/-ble/-tle endings, which
//     are their own syllable). However, this adds edge complexity.
//     Simpler pragmatic approach used by CMU-style heuristics: subtract silent
//     'e' only when last 2 chars are NOT "le". This correctly handles:
//       "code"   -> ce / de trailing -> subtract -> 1 ✓
//       "apple"  -> ends "le"        -> no sub   -> 2 ✓
//       "care"   -> re trailing      -> subtract  -> (care: a+e=2, sub=1) ✓
//       "table"  -> ends "le"        -> no sub    -> (ta+ble) -> 2 ✓
//   Final algorithm:
//     1. Count vowel-transition groups.
//     2. If last char == 'e' AND prev char is non-vowel
//        AND last two chars != "le"
//        AND groups > 1:
//          groups -= 1
//     3. If word non-empty, result = max(1, groups); else 0.
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Return 1 if c (a single-char string) is a vowel (a e i o u y), else 0.
fn _sy_is_vowel(c) -> int
    if c == "a"
        return 1
    if c == "e"
        return 1
    if c == "i"
        return 1
    if c == "o"
        return 1
    if c == "u"
        return 1
    if c == "y"
        return 1
    0

// Return 1 if b (an ASCII byte code) is a letter (a-z), else 0.
fn _sy_is_alpha(b) -> int
    if b >= 97 and b <= 122
        return 1
    0

// Lowercase a single ASCII character string.
fn _sy_lower_char(c) -> str
    let b = ord(c)
    if b >= 65 and b <= 90
        return chr(b + 32)
    c

// Lowercase an entire string, stripping non-alpha characters.
fn _sy_clean(s) -> str
    let out = ""
    let n = len(s)
    let i = 0
    while i < n
        let b = ord(s[i])
        if b >= 65 and b <= 90
            out = out + chr(b + 32)
        else
            if _sy_is_alpha(b) == 1
                out = out + s[i]
        i = i + 1
    out

// Split string s on whitespace (space=32, tab=9, CR=13, LF=10),
// returning a list of non-empty tokens.
fn _sy_split_ws(s) -> list
    let toks = []
    let n = len(s)
    let i = 0
    let cur = ""
    while i < n
        let b = ord(s[i])
        let is_ws = 0
        if b == 32
            is_ws = 1
        if b == 9
            is_ws = 1
        if b == 13
            is_ws = 1
        if b == 10
            is_ws = 1
        if is_ws == 1
            if len(cur) > 0
                push(toks, cur)
                cur = ""
        else
            cur = cur + s[i]
        i = i + 1
    if len(cur) > 0
        push(toks, cur)
    toks

// ── public API ───────────────────────────────────────────────────────────────

// Count syllables in a single lowercase word using the vowel-group heuristic.
// See module header for the full algorithm.
fn sy_count(word) -> int
    let n = len(word)
    if n == 0
        return 0
    // Step 1: count vowel-transition groups.
    let groups = 0
    let prev_was_vowel = 0
    let i = 0
    while i < n
        let c = word[i]
        let is_v = _sy_is_vowel(c)
        if is_v == 1
            if prev_was_vowel == 0
                groups = groups + 1
            prev_was_vowel = 1
        else
            prev_was_vowel = 0
        i = i + 1
    // Step 2: silent trailing 'e' rule.
    // Conditions: last char == 'e', char before it is non-vowel,
    // last two chars are NOT "le", and groups > 1.
    if n >= 2
        let last_c = word[n - 1]
        let prev_c = word[n - 2]
        if last_c == "e"
            if _sy_is_vowel(prev_c) == 0
                // Check last two chars not "le"
                let last2_ok = 1
                if prev_c == "l"
                    last2_ok = 0
                if last2_ok == 1
                    if groups > 1
                        groups = groups - 1
    // Step 3: minimum 1 for any non-empty word.
    if groups < 1
        groups = 1
    groups

// Sum syllables across all whitespace-separated words in a sentence.
// Tokens are cleaned (lowercased, non-alpha stripped) before counting.
// Empty / whitespace-only input returns 0.
fn sy_count_sentence(text) -> int
    let toks = _sy_split_ws(text)
    let total = 0
    let i = 0
    while i < len(toks)
        let cleaned = _sy_clean(toks[i])
        if len(cleaned) > 0
            total = total + sy_count(cleaned)
        i = i + 1
    total

// Return 1 (true) iff the word has exactly 1 syllable; 0 (false) otherwise.
// Empty string returns 0 (not monosyllabic).
fn sy_is_monosyllabic(word) -> int
    if len(word) == 0
        return 0
    if sy_count(word) == 1
        return 1
    0
