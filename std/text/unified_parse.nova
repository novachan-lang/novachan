// ============================================================================
// NOVA Standard Library — std/text/unified_parse
// ============================================================================
// Parse unified-diff text into structured hunks.
//
// Public API:
//   unified_parse(diff_text) -> list of hunk dicts
//       Each hunk dict has keys:
//         "a_start"  (int)  1-based start line in a
//         "a_count"  (int)  number of lines from a in this hunk
//         "b_start"  (int)  1-based start line in b
//         "b_count"  (int)  number of lines produced toward b
//         "lines"    (list) list of 2-element lists [tag, text] where
//                    tag is "=" (context), "-" (deleted), "+" (inserted)
//
//   unified_hunks(diff_text) -> int
//       Returns the number of hunks in the diff text.
//       Returns 0 for empty input or malformed input.
//
// Unified diff format (subset understood):
//   Optional file headers beginning with "--- " or "+++ " are ignored.
//   Hunk headers: "@@ -<a_start>[,<a_count>] +<b_start>[,<b_count>] @@"
//     (if count is absent it defaults to 1 per RFC/POSIX convention)
//   Body lines:
//     " <text>"  — context line (tag "=")
//     "-<text>"  — deleted line  (tag "-")
//     "+<text>"  — inserted line (tag "+")
//     "\ No newline at end of file" — ignored (backslash line)
//
// Edge cases:
//   unified_parse("")         -> []
//   unified_parse("garbage")  -> []  (no hunk headers -> empty)
//   unified_hunks("")         -> 0
//   malformed hunk header     -> hunk skipped (robust parse)
// ============================================================================

// ── Private: split text on newlines ──────────────────────────────────────────

fn _up_split_lines(text)
    let result = []
    let n = len(text)
    if n == 0
        return result
    let start = 0
    for i in 0..n
        if slice(text, i, i + 1) == chr(10)
            result.push(slice(text, start, i))
            start = i + 1
    if start < n
        result.push(slice(text, start, n))
    result

// ── Private: parse a non-negative integer from a string, returns -1 on error ─

fn _up_parse_int(s)
    let n = len(s)
    if n == 0
        return -1
    let val = 0
    for i in 0..n
        let ch = slice(s, i, i + 1)
        let digit = -1
        if ch == "0"
            digit = 0
        else
            if ch == "1"
                digit = 1
            else
                if ch == "2"
                    digit = 2
                else
                    if ch == "3"
                        digit = 3
                    else
                        if ch == "4"
                            digit = 4
                        else
                            if ch == "5"
                                digit = 5
                            else
                                if ch == "6"
                                    digit = 6
                                else
                                    if ch == "7"
                                        digit = 7
                                    else
                                        if ch == "8"
                                            digit = 8
                                        else
                                            if ch == "9"
                                                digit = 9
        if digit == -1
            return -1
        val = val * 10 + digit
    val

// ── Private: check if string starts with a given prefix ──────────────────────

fn _up_starts_with(s, prefix)
    let plen = len(prefix)
    if len(s) < plen
        return 0
    if slice(s, 0, plen) == prefix
        return 1
    return 0

// ── Private: find comma position in a string, returns -1 if absent ───────────

fn _up_find_comma(s)
    let n = len(s)
    let i = 0
    while i < n
        if slice(s, i, i + 1) == ","
            return i
        i = i + 1
    return -1

// ── Private: parse "@@ -a_start[,a_count] +b_start[,b_count] @@" ─────────────
// Returns a 4-element list [a_start, a_count, b_start, b_count].
// Returns [] on parse error.
fn _up_parse_hunk_header(line)
    // Must start with "@@ -"
    if _up_starts_with(line, "@@ -") == 0
        return []
    let n = len(line)
    // Find the " +" separator after the a-range (scan from position 4).
    let arange_end = -1
    let si = 4
    while si < n - 1
        if slice(line, si, si + 2) == " +"
            arange_end = si
            si = n
        else
            si = si + 1
    if arange_end == -1
        return []
    // a_range is line[4..arange_end]
    let arange = slice(line, 4, arange_end)
    let a_start = -1
    let a_count = 1
    let acomma = _up_find_comma(arange)
    if acomma == -1
        a_start = _up_parse_int(arange)
    else
        a_start = _up_parse_int(slice(arange, 0, acomma))
        a_count = _up_parse_int(slice(arange, acomma + 1, len(arange)))
    if a_start == -1
        return []
    if a_count == -1
        return []
    // b_range starts at arange_end + 2 (skip " +")
    let brange_start = arange_end + 2
    // Find the closing " @@"
    let brange_end = n
    let bi = brange_start
    while bi < n - 2
        if slice(line, bi, bi + 3) == " @@"
            brange_end = bi
            bi = n
        else
            bi = bi + 1
    let brange = slice(line, brange_start, brange_end)
    let b_start = -1
    let b_count = 1
    let bcomma = _up_find_comma(brange)
    if bcomma == -1
        b_start = _up_parse_int(brange)
    else
        b_start = _up_parse_int(slice(brange, 0, bcomma))
        b_count = _up_parse_int(slice(brange, bcomma + 1, len(brange)))
    if b_start == -1
        return []
    if b_count == -1
        return []
    let out = []
    out.push(a_start)
    out.push(a_count)
    out.push(b_start)
    out.push(b_count)
    out

// ── Private: collect body lines starting at index i until hunk ends ──────────
// Returns a 2-element list: [hunk_lines_list, next_i]
fn _up_collect_body(lines, start_i)
    let hunk_lines = []
    let nlines = len(lines)
    let i = start_i
    let done = 0
    while i < nlines and done == 0
        let bline = lines[i]
        // Stop at next hunk header
        if _up_starts_with(bline, "@@ ")
            done = 1
        else
            if _up_starts_with(bline, "--- ") or _up_starts_with(bline, "+++ ")
                // file header mid-stream -> stop
                done = 1
            else
                let blen = len(bline)
                if blen == 0
                    // blank line ends hunk body
                    i = i + 1
                    done = 1
                else
                    let first = slice(bline, 0, 1)
                    if first == " "
                        let op = []
                        op.push("=")
                        op.push(slice(bline, 1, blen))
                        hunk_lines.push(op)
                        i = i + 1
                    else
                        if first == "-"
                            let op2 = []
                            op2.push("-")
                            op2.push(slice(bline, 1, blen))
                            hunk_lines.push(op2)
                            i = i + 1
                        else
                            if first == "+"
                                let op3 = []
                                op3.push("+")
                                op3.push(slice(bline, 1, blen))
                                hunk_lines.push(op3)
                                i = i + 1
                            else
                                if first == chr(92)
                                    // backslash "no newline" annotation -- skip
                                    i = i + 1
                                else
                                    // unknown prefix -> stop hunk body
                                    done = 1
    let result = []
    result.push(hunk_lines)
    result.push(i)
    result

// ── Public: unified_parse ─────────────────────────────────────────────────────

fn unified_parse(diff_text)
    let hunks = []
    let lines = _up_split_lines(diff_text)
    let nlines = len(lines)
    let i = 0
    while i < nlines
        let line = lines[i]
        if _up_starts_with(line, "@@ ")
            let header = _up_parse_hunk_header(line)
            if len(header) == 4
                let a_start = header[0]
                let a_count = header[1]
                let b_start = header[2]
                let b_count = header[3]
                let body_result = _up_collect_body(lines, i + 1)
                let hunk_lines = body_result[0]
                let next_i = body_result[1]
                let hunk = {}
                hunk["a_start"] = a_start
                hunk["a_count"] = a_count
                hunk["b_start"] = b_start
                hunk["b_count"] = b_count
                hunk["lines"] = hunk_lines
                hunks.push(hunk)
                i = next_i
            else
                i = i + 1
        else
            i = i + 1
    hunks

// ── Public: unified_hunks ─────────────────────────────────────────────────────

fn unified_hunks(diff_text)
    len(unified_parse(diff_text))

// ============================================================================
fn main()
    print("std/text/unified_parse loaded")
