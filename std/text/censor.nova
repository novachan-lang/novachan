// ============================================================================
// NOVA Standard Library — std/text/censor
// ============================================================================
// Word censoring / masking with whole-word boundary matching.
//
// Public API:
//   cn_mask(text, words, maskchar) -> str
//       Replace every whole-word occurrence of any banned word in `text`
//       with `maskchar` repeated to the word's length.
//       Matching is case-insensitive; surrounding text is preserved exactly.
//       Word boundaries: position is a word boundary when the adjacent
//       character is absent (start/end of string) or non-alphanumeric.
//
//   cn_contains_any(text, words) -> bool (int 0/1)
//       Return 1 if `text` contains at least one whole-word occurrence of
//       any word in `words` (case-insensitive), 0 otherwise.
//
//   cn_count(text, words) -> int
//       Return the total number of whole-word occurrences of all banned
//       words found in `text` (case-insensitive).
//
// Design notes:
//   - "Whole-word" means the match must be preceded by a non-alphanumeric
//     character (or start-of-string) AND followed by a non-alphanumeric
//     character (or end-of-string).  A banned word that appears only as
//     a sub-sequence inside a longer alphanumeric token is NOT matched
//     (e.g. "bad" does not match "badness").
//   - maskchar is the FIRST character of the maskchar string (caller
//     should pass a single character like "*" or "#").  The mask is that
//     character repeated len(word) times.
//   - Scanning is left-to-right; after a match the scan resumes
//     immediately after the matched span (no double-counting).
//   - Empty banned-word list is safe; functions return the original text /
//     false / 0 as appropriate.
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Return 1 if byte code b is ASCII alphanumeric, else 0.
fn _cn_is_alnum(b) -> int
    if b >= 65 and b <= 90
        return 1
    if b >= 97 and b <= 122
        return 1
    if b >= 48 and b <= 57
        return 1
    0

// Lowercase an ASCII byte; non-uppercase bytes are returned unchanged.
fn _cn_lower_byte(b) -> int
    if b >= 65 and b <= 90
        return b + 32
    b

// Lowercase an entire string (ASCII only).
fn _cn_lower(s) -> str
    let out = ""
    let n = len(s)
    for i in 0..n
        let b = ord(s[i])
        out += chr(_cn_lower_byte(b))
    out

// Return 1 if the character at position pos in string s (len n)
// is a word boundary — i.e. it is before the start or after the end,
// or the character at that position is non-alphanumeric.
fn _cn_is_boundary(s, n, pos) -> int
    if pos < 0
        return 1
    if pos >= n
        return 1
    let b = ord(s[pos])
    if _cn_is_alnum(b) == 1
        return 0
    1

// Build a mask string of `maskchar`[0] repeated `wlen` times.
fn _cn_make_mask(maskchar, wlen) -> str
    let mc = maskchar[0]
    let out_parts = []
    for i in 0..wlen
        push(out_parts, mc)
    let out = join(out_parts, "")
    out

// Scan lowercased text `tl` (original cased text `t`, length `n`)
// for whole-word occurrences of the single lowercased banned word `wl`
// (length `wlen`).
//
// Mode controls what we do:
//   mode 0 -> collect replaced string (cn_mask)
//   mode 1 -> return 1 on first hit (cn_contains_any)
//   mode 2 -> count all hits (cn_count)
//
// maskchar is used only in mode 0.
// Returns a list: [result_str_or_empty, hit_int, count_int]
fn _cn_scan_word(t, tl, n, wl, wlen, maskchar, mode) -> list
    let result_parts = []
    let hit = 0
    let count = 0
    let i = 0
    while i < n
        // Try to match wl starting at position i.
        // First check left boundary.
        let left_ok = _cn_is_boundary(tl, n, i - 1)
        let matched = 0
        if left_ok == 1 and i + wlen <= n
            // Compare tl[i..i+wlen] with wl character by character.
            let match_ok = 1
            for j in 0..wlen
                if tl[i + j] != wl[j]
                    match_ok = 0
            if match_ok == 1
                // Check right boundary.
                let right_ok = _cn_is_boundary(tl, n, i + wlen)
                if right_ok == 1
                    matched = 1
        if matched == 1
            if mode == 0
                push(result_parts, _cn_make_mask(maskchar, wlen))
            if mode == 1
                hit = 1
            if mode == 2
                count += 1
            i += wlen
        else
            if mode == 0
                push(result_parts, t[i])
            i += 1
    let result = join(result_parts, "")
    [result, hit, count]

// ── public API ───────────────────────────────────────────────────────────────

// Replace every whole-word banned occurrence in text with maskchar repeated
// to match the word's length.  Case-insensitive; original casing of
// non-banned text is preserved.
fn cn_mask(text, words, maskchar) -> str
    let n = len(text)
    if n == 0
        return text
    let nw = len(words)
    if nw == 0
        return text
    // Lower-case the text once; we'll re-lower after each pass but for
    // simplicity we process one banned word at a time, carrying the
    // partially-masked result forward.  After masking, mask chars are
    // non-alpha so they don't create false new boundaries.
    let cur = text
    for wi in 0..nw
        let wl = _cn_lower(words[wi])
        let wlen = len(wl)
        if wlen > 0
            let tl = _cn_lower(cur)
            let ncur = len(cur)
            let res = _cn_scan_word(cur, tl, ncur, wl, wlen, maskchar, 0)
            cur = res[0]
    cur

// Return 1 (true) if text contains at least one whole-word occurrence of
// any word in words (case-insensitive), 0 otherwise.
fn cn_contains_any(text, words) -> int
    let n = len(text)
    if n == 0
        return 0
    let nw = len(words)
    if nw == 0
        return 0
    let tl = _cn_lower(text)
    for wi in 0..nw
        let wl = _cn_lower(words[wi])
        let wlen = len(wl)
        if wlen > 0
            let res = _cn_scan_word(text, tl, n, wl, wlen, "*", 1)
            if res[1] == 1
                return 1
    0

// Count total whole-word occurrences of all banned words in text
// (case-insensitive).
fn cn_count(text, words) -> int
    let n = len(text)
    if n == 0
        return 0
    let nw = len(words)
    if nw == 0
        return 0
    let tl = _cn_lower(text)
    let total = 0
    for wi in 0..nw
        let wl = _cn_lower(words[wi])
        let wlen = len(wl)
        if wlen > 0
            let res = _cn_scan_word(text, tl, n, wl, wlen, "*", 2)
            total += res[2]
    total
