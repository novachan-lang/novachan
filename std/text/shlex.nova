// std/text/shlex -- Shell-style word splitting. LEAF -- imports NOTHING.
//
// Public API:
//   sh_split(s: string) -> list
//     Split a string into tokens using POSIX-sh-like quoting rules:
//       - ASCII whitespace (space=32, tab=9, newline=10, CR=13) separates tokens.
//       - "double quoted" text groups characters; the surrounding quotes are
//         stripped but the content (including spaces) is preserved verbatim.
//       - 'single quoted' text groups characters; single quotes are stripped
//         and backslash inside single quotes is NOT special (POSIX rule).
//       - Outside any quotes, a backslash (byte 92) escapes the NEXT character:
//         the backslash is consumed and the next character is appended literally.
//       - Adjacent quoted/unquoted segments WITHOUT whitespace between them
//         concatenate into a single token: "mixed"plain -> "mixedplain".
//       - Empty input returns an empty list.
//
// Design notes:
//   - Implemented as a single-pass char-by-char state machine over the input
//     string using char_at/ord. No builtin split() is involved.
//   - Four states encoded as integer constants:
//       ST_NORMAL   = 0  -- between tokens or accumulating an unquoted token
//       ST_DQUOTE   = 1  -- inside "double quotes"
//       ST_SQUOTE   = 2  -- inside 'single quotes'
//       ST_ESCAPE   = 3  -- saw backslash outside quotes; next char is literal
//   - `in_token` tracks whether the current character starts a new token or
//     continues an existing one; this is needed so that "a"b is ONE token and
//     a space after a closing quote ends the current token cleanly.
//   - Token accumulator `cur` is a string built by concatenation. When
//     whitespace is encountered in ST_NORMAL and `in_token` is 1, `cur` is
//     appended to the result list and reset.
//   - Byte constants (avoid embedding literal quote chars in NOVA strings):
//       DQUOTE = 34 ("), SQUOTE = 39 ('), BACKSLASH = 92 (\)
//       SP=32 TAB=9 LF=10 CR=13  (ASCII whitespace set)

fn _is_ws(b) -> int
    if b == 32
        return 1
    if b == 9
        return 1
    if b == 10
        return 1
    if b == 13
        return 1
    0

fn sh_split(s: string) -> list
    let n = len(s)
    if n == 0
        return []

    // State constants
    let ST_NORMAL = 0
    let ST_DQUOTE = 1
    let ST_SQUOTE = 2
    let ST_ESCAPE = 3

    // Byte constants
    let DQUOTE    = 34
    let SQUOTE    = 39
    let BACKSLASH = 92

    let result   = []
    let cur      = ""
    let in_token = 0
    let state    = ST_NORMAL
    let i        = 0

    while i < n
        let b = ord(char_at(s, i))

        if state == ST_ESCAPE
            // Previous char was a backslash outside quotes — append this char literally.
            cur      = cur + chr(b)
            in_token = 1
            state    = ST_NORMAL
        else
            if state == ST_DQUOTE
                // Inside double quotes: only DQUOTE ends the state; everything else literal.
                if b == DQUOTE
                    // Closing double quote — return to NORMAL; token continues.
                    state = ST_NORMAL
                    in_token = 1
                else
                    cur      = cur + chr(b)
                    in_token = 1
            else
                if state == ST_SQUOTE
                    // Inside single quotes: only SQUOTE ends the state; backslash is NOT special.
                    if b == SQUOTE
                        state = ST_NORMAL
                        in_token = 1
                    else
                        cur      = cur + chr(b)
                        in_token = 1
                else
                    // ST_NORMAL
                    if _is_ws(b) == 1
                        // Whitespace: flush current token if we have one.
                        if in_token == 1
                            result   = result + [cur]
                            cur      = ""
                            in_token = 0
                    else
                        if b == DQUOTE
                            // Enter double-quote mode; token continues (or starts).
                            state    = ST_DQUOTE
                            in_token = 1
                        else
                            if b == SQUOTE
                                // Enter single-quote mode.
                                state    = ST_SQUOTE
                                in_token = 1
                            else
                                if b == BACKSLASH
                                    // Escape: next character is literal.
                                    state    = ST_ESCAPE
                                    in_token = 1
                                else
                                    // Ordinary character.
                                    cur      = cur + chr(b)
                                    in_token = 1

        i = i + 1

    // Flush any trailing token (handles unterminated quotes gracefully too).
    if in_token == 1
        result = result + [cur]

    result
