// ============================================================================
// NOVA Standard Library — std/text/md_emphasis
// ============================================================================
// Inline emphasis conversion for Markdown-to-HTML.
//
// Public API:
//   md_emphasis(s) -> str   Convert inline Markdown emphasis markers to HTML.
//
// Supported patterns (processed left-to-right in a single scan):
//   `code`    ->  <code>code</code>    (code spans have highest priority)
//   **bold**  ->  <strong>bold</strong>
//   *italic*  ->  <em>italic</em>
//
// Algorithm: single left-to-right scan. At each position we check (in order):
//   1. Is there a backtick? -> find matching backtick, emit <code>...</code>.
//   2. Is there **? -> find matching **, emit <strong>...</strong>.
//   3. Is there *? -> find matching *, emit <em>...</em>.
//   4. Otherwise emit the character literally.
// This single-pass approach ensures code span content is never re-scanned for
// emphasis markers.
// ============================================================================

// Internal: find the next occurrence of needle in s starting at position start.
// Returns the index, or -1 if not found.
fn _find_from(s, needle, start) -> int
    let n = len(s)
    let nl = len(needle)
    let i = start
    let result = -1
    while i + nl <= n and result == -1
        let cand = slice(s, i, i + nl)
        if cand == needle
            result = i
        i += 1
    result

// Convert inline Markdown emphasis markers to HTML via a single left-to-right scan.
fn md_emphasis(s) -> str
    let out_parts = []
    let i = 0
    let n = len(s)
    while i < n
        // Check for backtick (code span)
        if slice(s, i, i + 1) == "`"
            let end = _find_from(s, "`", i + 1)
            if end >= 0
                let content = slice(s, i + 1, end)
                push(out_parts, "<code>" + content + "</code>")
                i = end + 1
            else
                push(out_parts, "`")
                i += 1
        else
            // Check for ** (bold)
            if i + 1 < n and slice(s, i, i + 2) == "**"
                let end = _find_from(s, "**", i + 2)
                if end >= 0
                    let content = slice(s, i + 2, end)
                    push(out_parts, "<strong>" + content + "</strong>")
                    i = end + 2
                else
                    push(out_parts, "*")
                    i += 1
            else
                // Check for * (italic)
                if slice(s, i, i + 1) == "*"
                    let end = _find_from(s, "*", i + 1)
                    if end >= 0
                        let content = slice(s, i + 1, end)
                        push(out_parts, "<em>" + content + "</em>")
                        i = end + 1
                    else
                        push(out_parts, "*")
                        i += 1
                else
                    push(out_parts, slice(s, i, i + 1))
                    i += 1
    let out = join(out_parts, "")
    out
