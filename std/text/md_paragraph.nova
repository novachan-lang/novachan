// ============================================================================
// NOVA Standard Library — std/text/md_paragraph
// ============================================================================
// Paragraph wrapping: splits a text block on blank lines and wraps each
// non-empty block in <p>...</p>.
//
// Public API:
//   md_paragraph(text) -> string
//       Wrap text in <p>...</p>. If the text contains one or more blank lines
//       (lines containing only whitespace), each non-blank block is wrapped
//       in its own <p> tag. The resulting <p> elements are joined with chr(10).
//       A single block with no blank lines yields a single "<p>block</p>".
//       Trailing/leading blank lines are ignored.
//
// Examples:
//   md_paragraph("Hello world")     => "<p>Hello world</p>"
//   md_paragraph("A"+chr(10)+chr(10)+"B") => "<p>A</p>"+chr(10)+"<p>B</p>"
//
// LEAF — imports NOTHING.

// PRIVATE: trim leading and trailing spaces/tabs from a single line.
fn _mdp_trim_line(s: string) -> string
    let n = len(s)
    for start in 0..n
        let ch = slice(s, start, start+1)
        if ch != " " and ch != chr(9)
            return slice(s, start, n)
    ""

// PRIVATE: is s a blank line (empty or only whitespace)?
fn _mdp_is_blank(s: string) -> bool
    _mdp_trim_line(s) == ""

// md_paragraph(text) -> string
// Split on blank lines and wrap each block in <p>...</p>.
fn md_paragraph(text: string) -> string
    let lines = split(text, chr(10))
    let nlines = len(lines)
    // collect non-empty paragraphs (groups of adjacent non-blank lines)
    let paras = []
    let cur = ""
    for i in 0..nlines
        let line = lines[i]
        if _mdp_is_blank(line)
            // end of a paragraph block
            if len(cur) > 0
                push(paras, cur)
                cur = ""
        else
            // append line to current block
            if len(cur) == 0
                cur = line
            else
                cur += chr(10) + line
    // flush last block
    if len(cur) > 0
        push(paras, cur)
    // wrap each block in <p>...</p> and join with chr(10)
    let out_parts = []
    let p = 0
    let np = len(paras)
    while p < np
        if p > 0
            push(out_parts, chr(10))
        push(out_parts, "<p>" + paras[p] + "</p>")
        p += 1
    let out = join(out_parts, "")
    out
