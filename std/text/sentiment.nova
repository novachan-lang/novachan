// ============================================================================
// NOVA Standard Library — std/text/sentiment
// ============================================================================
// Lexicon-based sentiment polarity analysis.
//
// Public API:
//   sen_lexicon()       -> any: dict word->polarity (float, ~60 words)
//   sen_word_score(word) -> float: raw polarity from lexicon (0.0 if absent)
//   sen_intensifiers()  -> any: dict word->multiplier
//   sen_negators()      -> any: list of negation words
//   sen_score(text)     -> float: sum with intensifier + negation handling
//   sen_polarity(text)  -> string: 'positive','negative','neutral'
//   sen_is_positive(text) -> bool
//   sen_is_negative(text) -> bool
//   sen_normalize(text) -> float: score / word_count
//   sen_count_positive(text) -> int: words with positive polarity
//   sen_count_negative(text) -> int: words with negative polarity
//   sen_compound(text)  -> float: score squashed to [-1,1]
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _sen_lower_char: lowercase one ASCII char code
fn _sen_lower_char(o) -> int
    if o >= 65 and o <= 90
        return o + 32
    o

// _sen_lower: lowercase an ASCII string
fn _sen_lower(s) -> string
    let n = len(s)
    let out = ""
    let i = 0
    while i < n
        let o = ord(slice(s, i, i + 1))
        let lo = _sen_lower_char(o)
        out = out + chr(lo)
        i = i + 1
    out

// _sen_is_alpha: true if char code is ASCII letter
fn _sen_is_alpha(o) -> bool
    if o >= 65 and o <= 90
        return true
    if o >= 97 and o <= 122
        return true
    false

// _sen_tokenize: split text into lowercased alpha tokens
fn _sen_tokenize(text) -> any
    let result = []
    let n = len(text)
    let i = 0
    let start = 0
    let in_word = false
    while i < n
        let o = ord(slice(text, i, i + 1))
        if _sen_is_alpha(o)
            if not in_word
                start = i
                in_word = true
        else
            if in_word
                push(result, _sen_lower(slice(text, start, i)))
                in_word = false
        i = i + 1
    if in_word
        push(result, _sen_lower(slice(text, start, n)))
    result

// _sen_abs_float: absolute value for a float
fn _sen_abs_float(x) -> float
    if x < 0.0
        return 0.0 - x
    x

// ── public API ───────────────────────────────────────────────────────────────

// sen_lexicon: built-in ~60-word sentiment lexicon.
// Positive range: +1.0 to +3.0; negative range: -1.0 to -3.0.
fn sen_lexicon() -> any
    let d = {}
    // positive words
    d["good"] = 2.0
    d["great"] = 3.0
    d["love"] = 3.0
    d["excellent"] = 3.0
    d["happy"] = 2.0
    d["wonderful"] = 3.0
    d["best"] = 3.0
    d["amazing"] = 3.0
    d["fantastic"] = 3.0
    d["nice"] = 2.0
    d["awesome"] = 3.0
    d["superb"] = 3.0
    d["perfect"] = 3.0
    d["brilliant"] = 3.0
    d["outstanding"] = 3.0
    d["positive"] = 2.0
    d["beautiful"] = 2.0
    d["delightful"] = 2.0
    d["pleased"] = 2.0
    d["glad"] = 2.0
    d["joy"] = 2.0
    d["joyful"] = 2.0
    d["enjoy"] = 2.0
    d["enjoyable"] = 2.0
    d["like"] = 1.0
    d["helpful"] = 1.5
    d["effective"] = 1.5
    d["recommend"] = 1.5
    d["impressive"] = 2.0
    // negative words
    d["bad"] = 0.0 - 2.0
    d["terrible"] = 0.0 - 3.0
    d["awful"] = 0.0 - 3.0
    d["hate"] = 0.0 - 3.0
    d["worst"] = 0.0 - 3.0
    d["horrible"] = 0.0 - 3.0
    d["sad"] = 0.0 - 2.0
    d["poor"] = 0.0 - 2.0
    d["disappointing"] = 0.0 - 2.0
    d["ugly"] = 0.0 - 2.0
    d["dreadful"] = 0.0 - 3.0
    d["disgusting"] = 0.0 - 3.0
    d["failure"] = 0.0 - 2.0
    d["failed"] = 0.0 - 2.0
    d["broken"] = 0.0 - 2.0
    d["useless"] = 0.0 - 2.0
    d["waste"] = 0.0 - 2.0
    d["mediocre"] = 0.0 - 1.0
    d["boring"] = 0.0 - 1.0
    d["annoying"] = 0.0 - 2.0
    d["frustrating"] = 0.0 - 2.0
    d["unpleasant"] = 0.0 - 2.0
    d["problem"] = 0.0 - 1.0
    d["wrong"] = 0.0 - 1.0
    d["difficult"] = 0.0 - 1.0
    d["negative"] = 0.0 - 1.5
    d["dislike"] = 0.0 - 1.5
    d["regret"] = 0.0 - 1.5
    d["error"] = 0.0 - 1.0
    d

// sen_intensifiers: dict word->multiplier for modifying the next sentiment word.
fn sen_intensifiers() -> any
    let d = {}
    d["very"] = 1.5
    d["extremely"] = 2.0
    d["slightly"] = 0.5
    d["quite"] = 1.2
    d["really"] = 1.5
    d["absolutely"] = 2.0
    d["somewhat"] = 0.7
    d["rather"] = 1.2
    d["incredibly"] = 2.0
    d["terribly"] = 1.8
    d["fairly"] = 0.8
    d["exceptionally"] = 2.0
    d

// sen_negators: list of negation words that flip sign of nearby sentiment.
fn sen_negators() -> any
    let result = []
    push(result, "not")
    push(result, "never")
    push(result, "no")
    push(result, "neither")
    push(result, "nor")
    push(result, "without")
    push(result, "hardly")
    push(result, "barely")
    result

// sen_word_score: raw polarity for a word from the lexicon; 0.0 if absent.
fn sen_word_score(word) -> float
    let lw = _sen_lower(word)
    let lex = sen_lexicon()
    if contains(lex, lw)
        let val = lex[lw]
        return val
    0.0

// sen_score: compute sentiment score for text.
// Algorithm: scan tokens; apply intensifier from previous token (multiplier);
// flip sign if a negator appears within the previous 2 positions.
fn sen_score(text) -> float
    let tokens = _sen_tokenize(text)
    let lex = sen_lexicon()
    let ints = sen_intensifiers()
    let negs = sen_negators()
    let n = len(tokens)
    let total = 0.0
    // build negator set for O(1) lookup
    let neg_set = {}
    let ni = 0
    while ni < len(negs)
        neg_set[negs[ni]] = 1
        ni = ni + 1
    let i = 0
    while i < n
        let tok = tokens[i]
        if contains(lex, tok)
            let base = lex[tok]
            // check for intensifier at position i-1
            let multiplier = 1.0
            if i > 0
                let prev = tokens[i - 1]
                if contains(ints, prev)
                    multiplier = ints[prev]
            // check for negator in positions i-1 and i-2
            let negated = false
            if i > 0
                let p1 = tokens[i - 1]
                if contains(neg_set, p1)
                    negated = true
            if i > 1
                let p2 = tokens[i - 2]
                if contains(neg_set, p2)
                    negated = true
            // apply
            let contrib = base * multiplier
            if negated
                contrib = 0.0 - contrib
            total = total + contrib
        i = i + 1
    total

// sen_polarity: classify score into 'positive', 'negative', or 'neutral'.
fn sen_polarity(text) -> string
    let s = sen_score(text)
    if s > 0.5
        return "positive"
    if s < 0.0 - 0.5
        return "negative"
    "neutral"

// sen_is_positive: true if polarity is 'positive'.
fn sen_is_positive(text) -> bool
    let p = sen_polarity(text)
    if p == "positive"
        return true
    false

// sen_is_negative: true if polarity is 'negative'.
fn sen_is_negative(text) -> bool
    let p = sen_polarity(text)
    if p == "negative"
        return true
    false

// sen_normalize: score divided by word count. Returns 0.0 for empty text.
fn sen_normalize(text) -> float
    let tokens = _sen_tokenize(text)
    let n = len(tokens)
    if n == 0
        return 0.0
    let s = sen_score(text)
    let result = s / (n * 1.0)
    result

// sen_count_positive: count tokens with positive polarity in lexicon.
fn sen_count_positive(text) -> int
    let tokens = _sen_tokenize(text)
    let lex = sen_lexicon()
    let cnt = 0
    let i = 0
    while i < len(tokens)
        let tok = tokens[i]
        if contains(lex, tok)
            let v = lex[tok]
            if v > 0.0
                cnt = cnt + 1
        i = i + 1
    cnt

// sen_count_negative: count tokens with negative polarity in lexicon.
fn sen_count_negative(text) -> int
    let tokens = _sen_tokenize(text)
    let lex = sen_lexicon()
    let cnt = 0
    let i = 0
    while i < len(tokens)
        let tok = tokens[i]
        if contains(lex, tok)
            let v = lex[tok]
            if v < 0.0
                cnt = cnt + 1
        i = i + 1
    cnt

// sen_compound: squash score to [-1,1] via x/sqrt(x*x + 15.0).
fn sen_compound(text) -> float
    let s_raw = sen_score(text)
    let s = s_raw * 1.0
    let s2 = s * s
    let addend = s2 + 15.0
    let denom = sqrt(addend)
    let result = s / denom
    result

fn main()
    print("std/text/sentiment loaded")
