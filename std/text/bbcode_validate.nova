// ============================================================================
// NOVA Standard Library — std/text/bbcode_validate
// ============================================================================
// Validate BBCode tag nesting: every opening "[name]" / "[name=value]" must
// have a matching "[/name]" later in the string, and closes must unwind in
// strict LIFO order (no crossing tags, e.g. "[b][i]x[/b][/i]" is invalid).
//
// Public API:
//   bval_validate(input) -> int     1 if input is well-nested, 0 otherwise.
//   bval_errors(input)   -> list    Human-readable error strings, e.g.
//                                     "unclosed [b] at position 5"
//                                     "unexpected [/i] at position 12"
//                                    Empty list means the input is valid.
//
// Algorithm: single left-to-right scan with an explicit stack of open tags
// (name text as written + the position of its '[').
//   - "[*]" is a self-closing marker (BBCode list item) — it never pushes
//     onto the stack and never needs a "[/*]".
//   - "[name]" / "[name=value]" (anything not starting with '/', and not
//     "[*]") pushes (name text, position) onto the stack.
//   - "[/name]" looks for `name` (case-insensitively, ignoring any "=value"
//     on the SIDE THAT HAS ONE — closers are not expected to carry a value)
//     from the top of the stack down:
//       - not found anywhere on the stack -> "unexpected [/name]" at the
//         close tag's position; the stack is left untouched.
//       - found, but not at the top -> every tag ABOVE it is reported
//         "unclosed" (it is being force-closed out of order) and popped,
//         then the found tag itself is popped as matched (no error for it —
//         it DID get a corresponding close, just with other tags crossing
//         over it).
//       - found at the top -> ordinary matched pop, no error.
//   - A bracket with no closing ']' is not a tag at all (matches the
//     lenient convention of the sibling bbcode_to_html / bbcode_to_text
//     modules) and contributes no error.
//   - Anything still on the stack when the scan ends is reported
//     "unclosed [name] at position P" (bottom of stack -> top of stack,
//     i.e. ascending source position order for the final drain; a
//     mismatch-triggered force-close instead reports top-down, since those
//     are the tags nearest the point of failure).
//
// LEAF — imports NOTHING.
// ============================================================================

// Strip a trailing "=value" from a raw tag's name portion, if present.
// "color=red" -> "color"; "b" -> "b".
fn _bval_base_name(raw) -> str
    let eq = find(raw, "=")
    if eq >= 0
        return slice(raw, 0, eq)
    raw

// Search `names` (a stack, index 0 = bottom / oldest) from the top down for
// an entry whose base name equals `lc_target` (already lower-cased).
// Returns the stack index of the first (topmost) match, or -1.
fn _bval_find_in_stack(names, lc_target) -> int
    let k = len(names) - 1
    let result = -1
    while k >= 0 and result == -1
        if lower(_bval_base_name(names[k])) == lc_target
            result = k
        k -= 1
    result

// bval_errors(input) -> list of human-readable nesting-error strings.
// Empty list means `input` is well-nested.
fn bval_errors(input) -> list
    let errors = []
    let names = []       // stack of raw tag text, e.g. "b", "color=red"
    let positions = []   // matching stack of the '[' index for each entry
    let n = len(input)
    let i = 0
    while i < n
        if slice(input, i, i + 1) == "["
            let rel = find(slice(input, i, n), "]")
            if rel < 0
                // unterminated bracket: not a tag, just a literal '['
                i += 1
            else
                let close = i + rel
                let raw_tag = slice(input, i + 1, close)
                if raw_tag == "*"
                    // self-closing list-item marker: no stack interaction
                    i = close + 1
                else
                    if len(raw_tag) > 0 and slice(raw_tag, 0, 1) == "/"
                        // closing tag
                        let cname = lower(slice(raw_tag, 1, len(raw_tag)))
                        if len(names) == 0
                            push(errors, "unexpected [" + raw_tag + "] at position " + str(i))
                        else
                            let found = _bval_find_in_stack(names, cname)
                            if found < 0
                                push(errors, "unexpected [" + raw_tag + "] at position " + str(i))
                            else
                                // force-close everything ABOVE the match (nearest-to-
                                // failure first), then pop the matched tag itself.
                                while len(names) - 1 > found
                                    let bad_name = pop(names)
                                    let bad_pos = pop(positions)
                                    push(errors, "unclosed [" + bad_name + "] at position " + str(bad_pos))
                                pop(names)
                                pop(positions)
                        i = close + 1
                    else
                        // opening tag
                        push(names, raw_tag)
                        push(positions, i)
                        i = close + 1
        else
            i += 1
    // anything left open at end-of-input is unclosed; report oldest first
    // (ascending source position).
    let k = 0
    let remaining = len(names)
    while k < remaining
        push(errors, "unclosed [" + names[k] + "] at position " + str(positions[k]))
        k += 1
    errors

// bval_validate(input) -> 1 if input is well-nested, 0 otherwise.
fn bval_validate(input) -> int
    let errs = bval_errors(input)
    if len(errs) == 0
        return 1
    0
