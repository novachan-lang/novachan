// ============================================================================
// NOVA Standard Library — std/text/bm25
// ============================================================================
// Okapi BM25 ranking function over a corpus of tokenised documents.
// Each document is a list of string tokens (already lowercased by the caller).
//
// Public API:
//   bm25_doc_count(corpus)               -> int    number of documents
//   bm25_avgdl(corpus)                   -> float  average document length
//   bm25_df(corpus, term)                -> int    # docs containing term
//   bm25_idf(corpus, term)               -> float  log((N-df+0.5)/(df+0.5)+1)
//   bm25_tf(doc, term)                   -> int    raw term count in doc
//   bm25_score(corpus,doc_idx,qterms,k1,b) -> float  BM25 score
//   bm25_score_default(corpus,doc_idx,qterms) -> float  k1=1.5 b=0.75
//   bm25_rank(corpus, query_terms)       -> any    [{doc:i,score:s}…] desc
//   bm25_best(corpus, query_terms)       -> int    index of top doc
//   bm25_search(corpus, query_terms, topk) -> any  top-k doc indices
//   bm25_vocab_size(corpus)              -> int    distinct token count
//   bm25_contains(doc, term)             -> bool   term present in doc?
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _bm25_count_in_doc: count occurrences of term in a token list.
fn _bm25_count_in_doc(doc, term) -> int
    let n = len(doc)
    let i = 0
    let cnt = 0
    while i < n
        if doc[i] == term
            cnt += 1
        i += 1
    cnt

// _bm25_doc_has: 1 if doc contains term, 0 otherwise.
fn _bm25_doc_has(doc, term) -> int
    let n = len(doc)
    for i in 0..n
        if doc[i] == term
            return 1
    0

// _bm25_sum_lengths: total token count across all documents.
fn _bm25_sum_lengths(corpus) -> int
    let n = len(corpus)
    let i = 0
    let total = 0
    while i < n
        total += len(corpus[i])
        i += 1
    total

// _bm25_sort_desc: insertion sort {doc,score} list descending by score.
// Uses a 'done' flag to break inner loop without corrupting j.
fn _bm25_sort_desc(items) -> any
    let n = len(items)
    for i in 1..n
        let cur = items[i]
        let cs = cur["score"]
        let j = i - 1
        let pos = i
        let done = false
        while j >= 0 and done == false
            let prev = items[j]
            let ps = prev["score"]
            if ps < cs
                items[j + 1] = prev
                pos = j
                j -= 1
            else
                done = true
        items[pos] = cur
    items

// ── public API ───────────────────────────────────────────────────────────────

// bm25_doc_count returns the number of documents in the corpus.
fn bm25_doc_count(corpus) -> int
    len(corpus)

// bm25_avgdl returns the average document length (tokens) across the corpus.
fn bm25_avgdl(corpus) -> float
    let n = len(corpus)
    if n == 0
        return 0.0
    let total = _bm25_sum_lengths(corpus)
    let result = (total * 1.0) / (n * 1.0)
    result

// bm25_df returns the number of documents in corpus that contain term.
fn bm25_df(corpus, term) -> int
    let n = len(corpus)
    let i = 0
    let df = 0
    while i < n
        if _bm25_doc_has(corpus[i], term) == 1
            df += 1
        i += 1
    df

// bm25_idf returns the smoothed IDF: log((N - df + 0.5) / (df + 0.5) + 1.0).
// This is the Robertson/Sparck Jones variant used in modern BM25 implementations.
// Always non-negative; returns 0.0 for empty corpus.
fn bm25_idf(corpus, term) -> float
    let big_n = len(corpus)
    if big_n == 0
        return 0.0
    let df = bm25_df(corpus, term)
    let num = (big_n - df) * 1.0 + 0.5
    let den = df * 1.0 + 0.5
    let ratio = num / den
    let inner = ratio + 1.0
    let result = log(inner)
    result

// bm25_tf returns the raw term frequency (count) of term in doc.
fn bm25_tf(doc, term) -> int
    _bm25_count_in_doc(doc, term)

// bm25_score computes the BM25 score for corpus[doc_index] against query_terms
// using the given k1 and b parameters.
// Score = sum over query terms of: idf * tf*(k1+1) / (tf + k1*(1-b+b*dl/avgdl))
fn bm25_score(corpus, doc_index, query_terms, k1, b) -> float
    let doc = corpus[doc_index]
    let dl = len(doc) * 1.0
    let avg = bm25_avgdl(corpus)
    if avg <= 0.0
        return 0.0
    let nq = len(query_terms)
    let i = 0
    let total = 0.0
    while i < nq
        let term = query_terms[i]
        let tf = _bm25_count_in_doc(doc, term)
        if tf > 0
            let idf = bm25_idf(corpus, term)
            let tf_f = tf * 1.0
            let num = tf_f * (k1 + 1.0)
            let norm = 1.0 - b + b * (dl / avg)
            let den = tf_f + k1 * norm
            let contrib = idf * (num / den)
            total += contrib
        i += 1
    total

// bm25_score_default computes BM25 with standard parameters k1=1.5, b=0.75.
fn bm25_score_default(corpus, doc_index, query_terms) -> float
    let s = bm25_score(corpus, doc_index, query_terms, 1.5, 0.75)
    s

// bm25_rank returns a list of {doc: index, score: float} sorted descending.
fn bm25_rank(corpus, query_terms) -> any
    let n = len(corpus)
    let i = 0
    let items = []
    while i < n
        let s = bm25_score_default(corpus, i, query_terms)
        let entry = {}
        entry["doc"] = i
        entry["score"] = s
        push(items, entry)
        i += 1
    let sorted = _bm25_sort_desc(items)
    sorted

// bm25_best returns the index of the document with the highest BM25 score.
// Returns 0 if corpus is empty (safe default).
fn bm25_best(corpus, query_terms) -> int
    let n = len(corpus)
    if n == 0
        return 0
    let best_idx = 0
    let best_score = bm25_score_default(corpus, 0, query_terms)
    for i in 1..n
        let s = bm25_score_default(corpus, i, query_terms)
        if s > best_score
            best_score = s
            best_idx = i
    best_idx

// bm25_search returns a list of the top-k document indices (by BM25 score).
// Returns fewer than k if corpus has fewer documents.
fn bm25_search(corpus, query_terms, topk) -> any
    let ranked = bm25_rank(corpus, query_terms)
    let n = len(ranked)
    let limit = topk
    if n < limit
        limit = n
    let result = []
    for i in 0..limit
        let entry = ranked[i]
        push(result, entry["doc"])
    result

// bm25_vocab_size returns the number of distinct tokens across the entire corpus.
fn bm25_vocab_size(corpus) -> int
    let seen = {}
    let n = len(corpus)
    for i in 0..n
        let doc = corpus[i]
        let m = len(doc)
        for j in 0..m
            let tok = doc[j]
            if tok in seen == 0
                seen[tok] = 1
    len(keys(seen))

// bm25_contains returns true if term appears in doc.
fn bm25_contains(doc, term) -> bool
    _bm25_doc_has(doc, term) == 1

fn main()
    print("std/text/bm25 loaded")
