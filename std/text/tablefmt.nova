// std/text/tablefmt -- ASCII table renderer.
//
// Public API:
//   tbl_render(headers, rows) -> string
//     headers : list of strings (column headers)
//     rows    : list of list-of-strings (each inner list has same arity as headers)
//
// Output format (4 lines for 2 data rows):
//   "H1   | H2  | ..."   -- header; each cell left-padded to column width
//   "-----+----- ..."    -- separator; dashes per column width, joined with "-+-"
//   "r0c0 | r0c1 ..."   -- data rows in order
//   "r1c0 | r1c1 ..."
//
// Column width = max(len(header[c]), max over rows of len(row[c])).
// Cells are LEFT-justified (spaces appended on the right).
// Lines are joined with chr(10); no trailing newline.
//
// LEAF -- imports NOTHING.

// PRIVATE: repeat string ch exactly n times; returns "" when n <= 0.
fn _tbl_rep(ch: string, n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + ch
        i = i + 1
    out

// PRIVATE: left-justify s to exactly width chars (pad spaces on right).
fn _tbl_ljust(s: string, width: int) -> string
    let out = s
    let slen = len(s)
    if slen < width
        out = s + _tbl_rep(" ", width - slen)
    out

// Render an ASCII table from headers (list of strings) and rows (list of
// list-of-strings). Returns a multi-line string joined with chr(10).
fn tbl_render(headers: list, rows: list) -> string
    let ncols = len(headers)

    // ── phase 1: compute per-column widths ───────────────────────────────────
    // Start with header widths.
    let col_widths = []
    let c = 0
    while c < ncols
        col_widths = col_widths + [len(headers[c])]
        c = c + 1

    // Widen by each data row.
    let r = 0
    let nrows = len(rows)
    while r < nrows
        let row = rows[r]
        let c2 = 0
        while c2 < ncols
            let cell_len = len(row[c2])
            if cell_len > col_widths[c2]
                // Rebuild col_widths with updated value at c2.
                let new_widths = []
                let k = 0
                while k < ncols
                    if k == c2
                        new_widths = new_widths + [cell_len]
                    else
                        new_widths = new_widths + [col_widths[k]]
                    k = k + 1
                col_widths = new_widths
            c2 = c2 + 1
        r = r + 1

    // ── phase 2: build header line ───────────────────────────────────────────
    let hdr = ""
    let h = 0
    while h < ncols
        if h > 0
            hdr = hdr + " | "
        hdr = hdr + _tbl_ljust(headers[h], col_widths[h])
        h = h + 1

    // ── phase 3: build separator line ───────────────────────────────────────
    let sep = ""
    let s2 = 0
    while s2 < ncols
        if s2 > 0
            sep = sep + "-+-"
        sep = sep + _tbl_rep("-", col_widths[s2])
        s2 = s2 + 1

    // ── phase 4: build data row lines ────────────────────────────────────────
    let nl = chr(10)
    let out = hdr + nl + sep
    let ri = 0
    while ri < nrows
        let row2 = rows[ri]
        let line = ""
        let ci = 0
        while ci < ncols
            if ci > 0
                line = line + " | "
            line = line + _tbl_ljust(row2[ci], col_widths[ci])
            ci = ci + 1
        out = out + nl + line
        ri = ri + 1

    out
