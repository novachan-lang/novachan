// std/text/md_image -- inline Markdown image -> HTML <img> conversion. LEAF -- imports NOTHING.
//
// Public API:
//   md_image(s: string) -> string
//     Scans s for the FIRST Markdown inline image pattern ![alt](src) and replaces
//     the entire match with an HTML5 <img> tag:
//       <img src="src" alt="alt">
//     Attribute values use real double-quote characters (chr(34)).
//     If no image pattern is found, the input string is returned unchanged.
//
//   md_image_all(s: string) -> string
//     Like md_image but replaces ALL non-overlapping image patterns in the string.

// PRIVATE: find the closing char in s starting at pos, returns -1 if not found.
fn _mdi_find_close(s: string, pos: int, close: string) -> int
    let n = len(s)
    let i = pos
    while i < n
        if slice(s, i, i + 1) == close
            return i
        i += 1
    return -1

// PRIVATE: find start of next ![  pattern at or after pos. Returns -1 if none.
fn _mdi_find_start(s: string, pos: int) -> int
    let n = len(s)
    let i = pos
    while i + 1 < n
        if slice(s, i, i + 1) == "!" and slice(s, i + 1, i + 2) == "["
            return i
        i += 1
    return -1

// PRIVATE: build one <img> tag given alt and src strings.
fn _mdi_build_tag(alt: string, src: string) -> string
    let q = chr(34)
    return "<img src=" + q + src + q + " alt=" + q + alt + q + ">"

// PRIVATE: replace the first image pattern starting at or after start_pos.
// Returns the new string and the position after the replaced section via a
// two-element list: [new_string, end_pos_in_original].
// Returns [] if no image found from start_pos onward.
fn _mdi_replace_one(s: string, start_pos: int) -> list
    let bang = _mdi_find_start(s, start_pos)
    if bang < 0
        return []
    // After "![" comes the alt text until "]"
    let alt_start = bang + 2
    let bracket_close = _mdi_find_close(s, alt_start, "]")
    if bracket_close < 0
        return []
    // Must be immediately followed by "("
    let paren_open = bracket_close + 1
    if paren_open >= len(s) or slice(s, paren_open, paren_open + 1) != "("
        return []
    let src_start = paren_open + 1
    let paren_close = _mdi_find_close(s, src_start, ")")
    if paren_close < 0
        return []
    let alt = slice(s, alt_start, bracket_close)
    let src = slice(s, src_start, paren_close)
    let tag = _mdi_build_tag(alt, src)
    let before = slice(s, 0, bang)
    let after = slice(s, paren_close + 1, len(s))
    let result = before + tag + after
    // The position after the tag in the result string
    let new_pos = bang + len(tag)
    let out = []
    push(out, result)
    push(out, str(new_pos))
    return out

fn md_image(s: string) -> string
    let r = _mdi_replace_one(s, 0)
    if len(r) == 0
        return s
    return r[0]

fn md_image_all(s: string) -> string
    let cur = s
    let pos = 0
    let n = len(cur)
    let changed = 1
    while changed == 1
        changed = 0
        let r = _mdi_replace_one(cur, pos)
        if len(r) > 0
            cur = r[0]
            pos = int(r[1])
            n = len(cur)
            changed = 1
    return cur
