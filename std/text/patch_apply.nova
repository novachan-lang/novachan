// ============================================================================
// NOVA Standard Library — std/text/patch_apply
// ============================================================================
// Apply a unified diff to original lines.
//
// Public API:
//   patch_apply(a_lines, diff_text) -> list
//       Apply the unified diff to a_lines and return the patched lines.
//       If diff_text is "" or contains no hunks, a_lines is returned unchanged.
//       Aborts (returns a_lines unchanged) if any context line does not match.
//
//   patch_apply_str(a_str, diff_text) -> string
//       Convenience: split a_str on newlines, apply patch, join result on
//       newlines and return as a string.
//
//   patch_can_apply(a_lines, diff_text) -> bool (returned as 1 or 0)
//       Returns 1 if the patch can be cleanly applied to a_lines (all context
//       lines match their expected positions), 0 otherwise.
//
// Unified diff format accepted:
//   Lines beginning with "@@" start a hunk.  The hunk header is:
//       @@ -<a_start>,<a_count> +<b_start>,<b_count> @@[ optional text]
//   Then hunk body lines:
//       " line"  — context (present in both old and new)
//       "-line"  — deleted from old
//       "+line"  — inserted into new
//   Lines before the first "@@" (--- / +++ headers) are ignored.
//   Lines starting with "\\" (no newline at end of file marker) are ignored.
//
// Algorithm:
//   1. Parse diff_text into a list of hunks.  Each hunk records:
//        a_start (1-based), a_count, b_start, b_count, and a list of body ops.
//   2. For each hunk, verify context lines match a_lines at the expected offset.
//   3. Build output by replaying: copy unchanged a_lines before each hunk, apply
//      hunk ops (skip "-" lines, emit " " and "+" lines), then copy remaining.
//
// Edge cases:
//   Empty diff_text   -> a_lines unchanged
//   Empty a_lines     -> works if the diff inserts from position 1
//   Mismatched context -> patch_apply returns a_lines; patch_can_apply -> 0
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _pa_lines: split text on chr(10), return list of strings.
fn _pa_lines(text)
    let result = []
    let n = len(text)
    if n == 0
        return result
    let start = 0
    for i in 0..n
        if text[i] == chr(10)
            result.push(slice(text, start, i))
            start = i + 1
    result.push(slice(text, start, n))
    result

// _pa_parse_int: parse a non-negative decimal integer from string s starting
// at index i, stopping at the first non-digit. Returns the integer value.
// Caller must ensure there is at least one digit.
fn _pa_parse_int(s, i)
    let n = len(s)
    let v = 0
    while i < n
        let ch = s[i]
        let dig = -1
        if ch == "0"
            dig = 0
        else
            if ch == "1"
                dig = 1
            else
                if ch == "2"
                    dig = 2
                else
                    if ch == "3"
                        dig = 3
                    else
                        if ch == "4"
                            dig = 4
                        else
                            if ch == "5"
                                dig = 5
                            else
                                if ch == "6"
                                    dig = 6
                                else
                                    if ch == "7"
                                        dig = 7
                                    else
                                        if ch == "8"
                                            dig = 8
                                        else
                                            if ch == "9"
                                                dig = 9
        if dig == -1
            return v
        v = v * 10 + dig
        i += 1
    v

// _pa_find_comma: return the index of the first ',' in s at or after i.
// Returns -1 if not found before a space or end.
fn _pa_find_char(s, i, ch)
    let n = len(s)
    while i < n
        if s[i] == ch
            return i
        i += 1
    return -1

// _pa_parse_hunk_header: parse "@@ -a_start,a_count +b_start,b_count @@" line.
// Returns a 4-element list [a_start, a_count, b_start, b_count].
// On parse failure returns [-1,-1,-1,-1].
fn _pa_parse_hunk_header(line)
    let fail = []
    fail.push(-1)
    fail.push(-1)
    fail.push(-1)
    fail.push(-1)
    let n = len(line)
    // Expect line starts with "@@ -"
    if n < 7
        return fail
    if slice(line, 0, 4) != "@@ -"
        return fail
    // Find a_start at index 4
    let i = 4
    let a_start = _pa_parse_int(line, i)
    // Advance past digits to ','
    let comma1 = _pa_find_char(line, i, ",")
    if comma1 == -1
        return fail
    let a_count = _pa_parse_int(line, comma1 + 1)
    // Find " +" after the comma
    let plus_pos = _pa_find_char(line, comma1, "+")
    if plus_pos == -1
        return fail
    let b_start = _pa_parse_int(line, plus_pos)
    let comma2 = _pa_find_char(line, plus_pos, ",")
    if comma2 == -1
        return fail
    let b_count = _pa_parse_int(line, comma2 + 1)
    let result = []
    result.push(a_start)
    result.push(a_count)
    result.push(b_start)
    result.push(b_count)
    result

// _pa_parse_hunks: parse diff_text into a list of hunk descriptors.
// Each hunk descriptor is a dict with keys:
//   "a_start" : 1-based line number in a (int)
//   "a_count" : number of a-lines consumed (int)
//   "b_start" : 1-based line number in b (int)
//   "b_count" : number of b-lines produced (int)
//   "ops"     : list of [tag, line_content] pairs, tag in " ", "-", "+"
fn _pa_parse_hunks(diff_text)
    let hunks = []
    if len(diff_text) == 0
        return hunks
    let raw = _pa_lines(diff_text)
    let nr = len(raw)
    let cur_hunk = null
    let cur_ops = null
    for i in 0..nr
        let line = raw[i]
        let llen = len(line)
        if llen >= 2 and slice(line, 0, 2) == "@@"
            // Flush previous hunk if any
            if cur_hunk != null
                cur_hunk["ops"] = cur_ops
                hunks.push(cur_hunk)
            // Parse new hunk header
            let hdr = _pa_parse_hunk_header(line)
            cur_hunk = {}
            cur_hunk["a_start"] = hdr[0]
            cur_hunk["a_count"] = hdr[1]
            cur_hunk["b_start"] = hdr[2]
            cur_hunk["b_count"] = hdr[3]
            cur_ops = []
        else
            if cur_hunk != null
                if llen == 0
                    // Empty line in hunk body = context line with empty content
                    let op = []
                    op.push(" ")
                    op.push("")
                    cur_ops.push(op)
                else
                    let tag = slice(line, 0, 1)
                    if tag == " " or tag == "-" or tag == "+"
                        let content = slice(line, 1, llen)
                        let op2 = []
                        op2.push(tag)
                        op2.push(content)
                        cur_ops.push(op2)
                    // else: skip "\\" no-newline markers, "---", "+++" etc.
    // Flush last hunk
    if cur_hunk != null
        cur_hunk["ops"] = cur_ops
        hunks.push(cur_hunk)
    hunks

// _pa_hunk_matches: check that context lines (" ") in hunk ops match a_lines
// at the expected a-positions. a_idx is 0-based index of start in a_lines.
// Returns 1 if all context lines match, 0 otherwise.
fn _pa_hunk_matches(a_lines, a_idx, ops)
    let nops = len(ops)
    let ai = a_idx
    let na = len(a_lines)
    for i in 0..nops
        let tag = ops[i][0]
        let content = ops[i][1]
        if tag == " " or tag == "-"
            // This op consumes one line from a_lines
            if ai >= na
                return 0
            if a_lines[ai] != content
                return 0
            ai += 1
        // "+" does not consume an a-line
    return 1

// ── Public API ────────────────────────────────────────────────────────────────

// patch_can_apply: return 1 if every hunk's context and delete lines match
// a_lines at the expected positions, 0 otherwise.
fn patch_can_apply(a_lines, diff_text)
    let hunks = _pa_parse_hunks(diff_text)
    let nh = len(hunks)
    if nh == 0
        return 1
    for hi in 0..nh
        let hunk = hunks[hi]
        let a_start = hunk["a_start"]
        let ops = hunk["ops"]
        let a_idx = a_start - 1
        if _pa_hunk_matches(a_lines, a_idx, ops) == 0
            return 0
    return 1

// patch_apply: apply diff_text to a_lines and return patched list.
// If any hunk fails to match, returns a_lines unchanged (safe fallback).
fn patch_apply(a_lines, diff_text)
    let hunks = _pa_parse_hunks(diff_text)
    let nh = len(hunks)
    if nh == 0
        return a_lines
    // Verify all hunks match before applying anything.
    for hi in 0..nh
        let hunk = hunks[hi]
        let ops = hunk["ops"]
        let a_idx = hunk["a_start"] - 1
        if _pa_hunk_matches(a_lines, a_idx, ops) == 0
            return a_lines
    // Build output list.
    let out = []
    let na = len(a_lines)
    let a_pos = 0
    for h2 in 0..nh
        let hunk2 = hunks[h2]
        let a_start2 = hunk2["a_start"]
        let ops2 = hunk2["ops"]
        // Copy unchanged a_lines up to this hunk's start (0-based: a_start2-1)
        let hunk_a_begin = a_start2 - 1
        while a_pos < hunk_a_begin
            out.push(a_lines[a_pos])
            a_pos += 1
        // Apply hunk ops
        let nops2 = len(ops2)
        for oi in 0..nops2
            let tag2 = ops2[oi][0]
            let content2 = ops2[oi][1]
            if tag2 == " "
                // Context: emit line (advance a_pos)
                out.push(content2)
                a_pos += 1
            else
                if tag2 == "-"
                    // Delete: skip the a_line (advance a_pos)
                    a_pos += 1
                else
                    // Insert "+": emit line (do NOT advance a_pos)
                    out.push(content2)
    // Copy remaining a_lines after the last hunk
    while a_pos < na
        out.push(a_lines[a_pos])
        a_pos += 1
    out

// patch_apply_str: split a_str on newlines, apply patch, join result on newlines.
fn patch_apply_str(a_str, diff_text)
    let lines = _pa_lines(a_str)
    let patched = patch_apply(lines, diff_text)
    let np = len(patched)
    if np == 0
        return ""
    let result = patched[0]
    for i in 1..np
        result += chr(10) + patched[i]
    result

// ============================================================================
fn main()
    print("std/text/patch_apply loaded")
