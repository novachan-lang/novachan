// ============================================================================
// NOVA Standard Library — std/text/md_list
// ============================================================================
// Markdown list rendering: unordered and ordered lists.
//
// Public API:
//   md_list(text) -> string
//       Convert a block of Markdown list lines to HTML.
//       Lines starting "- " or "* " become <ul>...<li>...</li>...</ul>.
//       Lines starting "1. ", "2. ", etc. become <ol>...<li>...</li>...</ol>.
//       All input lines must be of the same type. The first line determines
//       the list type. Lines are separated from the wrapper tags by chr(10).
//
// LEAF — imports NOTHING.
// ============================================================================

// _md_split_lines: split s on chr(10); trailing empty element dropped.
fn _md_list_split(s) -> list
    let nl = chr(10)
    let raw = split(s, nl)
    let rlen = len(raw)
    if rlen > 0 and len(raw[rlen - 1]) == 0
        let out = []
        let i = 0
        while i < rlen - 1
            out = out + [raw[i]]
            i = i + 1
        return out
    raw

// _md_list_is_digit: return 1 if c (single char) is 0-9
fn _md_list_is_digit(c) -> int
    let o = ord(c)
    if o >= 48 and o <= 57
        return 1
    0

// _md_list_strip_ol: given a line like "1. item" or "12. item" strip "N. " prefix
// Returns the item text, or "" if it does not match an ordered item pattern.
fn _md_list_strip_ol(line) -> string
    let n = len(line)
    if n < 3
        return ""
    // must start with a digit
    if _md_list_is_digit(slice(line, 0, 1)) == 0
        return ""
    // advance through digits
    let i = 1
    while i < n
        if _md_list_is_digit(slice(line, i, i + 1)) == 0
            // done with digits — expect ". " next
            if i + 2 <= n and slice(line, i, i + 2) == ". "
                return slice(line, i + 2, n)
            return ""
        i = i + 1
    ""

// md_list(text) -> string
fn md_list(text) -> string
    let nl = chr(10)
    let lines = _md_list_split(text)
    let n = len(lines)
    if n == 0
        return ""
    // Determine list type from first line
    let first = lines[0]
    let is_ul = 0
    let is_ol = 0
    if len(first) >= 2 and (slice(first, 0, 2) == "- " or slice(first, 0, 2) == "* ")
        is_ul = 1
    if is_ul == 0 and len(first) >= 3 and _md_list_strip_ol(first) != ""
        is_ol = 1
    if is_ul == 0 and is_ol == 0
        return text
    let tag_open = "<ul>"
    let tag_close = "</ul>"
    if is_ol == 1
        tag_open = "<ol>"
        tag_close = "</ol>"
    // Build inner <li> items
    let inner = ""
    let i = 0
    while i < n
        let line = lines[i]
        let item = ""
        if is_ul == 1
            if len(line) >= 2 and (slice(line, 0, 2) == "- " or slice(line, 0, 2) == "* ")
                item = slice(line, 2, len(line))
        if is_ol == 1
            item = _md_list_strip_ol(line)
        if len(item) > 0
            inner = inner + nl + "<li>" + item + "</li>"
        i = i + 1
    tag_open + inner + nl + tag_close
