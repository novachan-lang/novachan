// std/text/ordinal -- English ordinal suffix and string formatting.
//
// Public API:
//   ord_suffix(n: int) -> string   -- returns "st", "nd", "rd", or "th"
//   ord_str(n: int) -> string      -- returns str(n) + ord_suffix(n)
//
// Special cases: 11, 12, 13 (and 111, 112, 113, etc.) always use "th"
// because "11th", "12th", "13th" override the last-digit rule.
//
// LEAF -- imports NOTHING.

// Return the ordinal suffix for integer n.
// Handles negative numbers by using the absolute value for suffix selection.
fn ord_suffix(n: int) -> string
    let a = n
    if a < 0
        a = -a
    let last2 = a - (a / 100) * 100
    let last1 = a - (a / 10) * 10
    let s = "th"
    if last2 == 11 or last2 == 12 or last2 == 13
        s = "th"
    else if last1 == 1
        s = "st"
    else if last1 == 2
        s = "nd"
    else if last1 == 3
        s = "rd"
    s

// Return the full ordinal string, e.g. "1st", "2nd", "42nd", "11th".
fn ord_str(n: int) -> string
    str(n) + ord_suffix(n)
