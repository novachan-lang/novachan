// ============================================================================
// NOVA Standard Library — std/text/distance
// ============================================================================
// Byte-level string distance metrics. All functions are pure: no side effects,
// no I/O, no imports. Operates on raw byte values via ord(s[i]).
//
// Public API:
//   d_hamming(a, b) -> int        Hamming distance (equal-length only; -1 if not)
//   d_levenshtein(a, b) -> int    Classic edit distance (insert/delete/substitute)
//   d_lcs_len(a, b) -> int        Longest common subsequence length
//   d_jaro(a, b) -> float         Jaro similarity score in [0.0, 1.0]
//
// Algorithms:
//   d_hamming    — single pass over bytes, position-wise XOR-nonzero count.
//   d_levenshtein — two-rolling-row DP; O(m*n) time, O(n) space.
//   d_lcs_len    — two-rolling-row DP; O(m*n) time, O(n) space.
//   d_jaro       — match-window + transposition count; O(m*n) worst-case.
//
// Note on strx.nova: std/text/strx exports `levenshtein` under that bare name;
// this module exports `d_levenshtein` (d_ prefix = distance family) so the two
// can coexist in the same source file without shadowing. The implementation is
// equivalent but independently authored here for the canonical distance module.

// ── Hamming distance ─────────────────────────────────────────────────────────

// d_hamming returns the number of byte positions where a and b differ.
// Returns -1 if the strings have unequal lengths (Hamming is only defined for
// equal-length strings).
fn d_hamming(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return -1
    let count = 0
    for i in 0..na
        if ord(a[i]) != ord(b[i])
            count = count + 1
    count

// ── Levenshtein edit distance ─────────────────────────────────────────────────

// d_levenshtein returns the minimum number of single-byte insertions, deletions,
// or substitutions needed to transform a into b.
//
// Uses the classic two-rolling-row DP:
//   prev[j] = cost to turn a[0..i-1] into b[0..j-1]
// Each row is rebuilt by list concatenation (NOVA lists have no safe in-place
// element write; rebuild is the correct idiom here).
fn d_levenshtein(a, b) -> int
    let m = len(a)
    let n = len(b)
    if m == 0
        return n
    if n == 0
        return m

    // Row 0: cost to turn "" into b[0..j-1] = j insertions.
    let prev = [j for j in 0..(n + 1)]

    for i in 1..(m + 1)
        // Column 0: cost to turn a[0..i-1] into "" = i deletions.
        let curr = [i]
        let ca = ord(a[i - 1])
        for k in 1..(n + 1)
            let cb = ord(b[k - 1])
            let sub_cost = 1
            if ca == cb
                sub_cost = 0
            let del_val = prev[k] + 1
            let ins_val = curr[k - 1] + 1
            let rep_val = prev[k - 1] + sub_cost
            let best = del_val
            if ins_val < best
                best = ins_val
            if rep_val < best
                best = rep_val
            push(curr, best)
        prev = curr
    prev[n]

// ── Longest common subsequence length ────────────────────────────────────────

// d_lcs_len returns the length of the longest common subsequence of a and b.
// A subsequence is formed by deleting zero or more characters (not necessarily
// contiguous) from a string. LCS length is related to edit distance by:
//   levenshtein(a,b) >= |a| + |b| - 2 * lcs_len(a,b)
//
// Two-rolling-row DP over the (m+1) x (n+1) LCS table:
//   dp[i][j] = length of LCS of a[0..i-1] and b[0..j-1]
//   dp[i][j] = dp[i-1][j-1] + 1            if a[i-1] == b[j-1]
//            = max(dp[i-1][j], dp[i][j-1]) otherwise
fn d_lcs_len(a, b) -> int
    let m = len(a)
    let n = len(b)
    if m == 0 or n == 0
        return 0

    // Row 0: all zeros (LCS of "" with anything is 0).
    let prev = [0 for j in 0..(n + 1)]

    for i in 1..(m + 1)
        let curr = [0]               // column 0: LCS(a[0..i-1], "") = 0
        let ca = ord(a[i - 1])
        for k in 1..(n + 1)
            let cb = ord(b[k - 1])
            let v = 0
            if ca == cb
                v = prev[k - 1] + 1  // extend the common subsequence
            else
                v = prev[k]          // drop a[i-1]
                if curr[k - 1] > v
                    v = curr[k - 1]  // drop b[k-1]
            push(curr, v)
        prev = curr
    prev[n]

// ── Jaro similarity ──────────────────────────────────────────────────────────

// d_jaro returns the Jaro similarity between a and b in [0.0, 1.0].
// 1.0 means identical; 0.0 means no characters are considered matching.
//
// Algorithm (Jaro 1989):
//   - Matching window: floor(max(|a|,|b|)/2) - 1  (minimum 0).
//   - Two characters at positions i (in a) and j (in b) are "matching" if they
//     are equal AND |i - j| <= window. Each character may be matched at most once.
//   - m  = number of matching pairs (matched greedily, left to right in a).
//   - t  = number of transpositions / 2: matched characters in different orders.
//   - jaro = (m/|a| + m/|b| + (m - t/2)/m) / 3   when m > 0; else 0.
//
// Note: integer division t/2 is intentional: the transposition count we store is
// the RAW count of position-order mismatches among matched pairs; dividing by 2
// gives the classic Jaro "half-transposition" value.
fn d_jaro(a, b) -> float
    let l1 = len(a)
    let l2 = len(b)
    if l1 == 0 and l2 == 0
        return 1.0
    if l1 == 0 or l2 == 0
        return 0.0

    // Matching window: floor(max(l1,l2)/2) - 1, minimum 0.
    let mx = l1
    if l2 > mx
        mx = l2
    let window = mx / 2 - 1
    if window < 0
        window = 0

    // Boolean matched flags for each position in a and b.
    let s1m = [0 for i in 0..l1]
    let s2m = [0 for i in 0..l2]

    // Count matching characters (greedy left-to-right in a).
    let m = 0
    for i in 0..l1
        let lo = i - window
        if lo < 0
            lo = 0
        let hi = i + window + 1
        if hi > l2
            hi = l2
        for jj in lo..hi
            if s2m[jj] == 0 and ord(a[i]) == ord(b[jj])
                s1m[i] = 1
                s2m[jj] = 1
                m = m + 1
                break

    if m == 0
        return 0.0

    // Count transpositions: walk through matched positions in a and b in order;
    // each mismatch contributes 1 to the raw transposition count t.
    let t = 0
    let kk = 0
    for i in 0..l1
        if s1m[i] == 1
            while s2m[kk] == 0
                kk = kk + 1
            if ord(a[i]) != ord(b[kk])
                t = t + 1
            kk = kk + 1

    // Jaro formula. Bind every sub-expression to a let to avoid float-return bug.
    let mf = m * 1.0
    let l1f = l1 * 1.0
    let l2f = l2 * 1.0
    let half_t = (t / 2) * 1.0
    let p1 = mf / l1f
    let p2 = mf / l2f
    let p3 = (mf - half_t) / mf
    let result = (p1 + p2 + p3) / 3.0
    result

// ============================================================================
fn main()
    print("std/text/distance loaded")
