// ============================================================================
// NOVA Standard Library — std/text/summarize
// ============================================================================
// Extractive text summarization using word-frequency scoring.
//
// Public API:
//   sm_sentences(text) -> any           list of sentence strings
//   sm_tokenize(sentence) -> any        lowercased alpha content tokens
//   sm_word_freq(text) -> any           dict word->count (stopwords excluded)
//   sm_sentence_score(sentence,wf)->float  sum(freq)/len(tokens)
//   sm_rank_sentences(text) -> any      list of {index,sentence,score}
//   sm_top_sentences(text, n) -> any    top-n sentences in original order
//   sm_summary(text, n) -> string       joined top-n sentences
//   sm_lead(text, n) -> string          first n sentences joined
//   sm_centroid_score(text) -> any      score by similarity to centroid
//   sm_keywords(text, k) -> any         top-k words by frequency
//   sm_compression_ratio(text,sum)->float
//   sm_sentence_count(text) -> int
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Return 1 if byte code b is ASCII alpha.
fn _sm_is_alpha_b(b) -> int
    if b >= 65 and b <= 90
        return 1
    if b >= 97 and b <= 122
        return 1
    0

// Return 1 if byte code b is a sentence terminator (. ! ?).
fn _sm_is_term(b) -> int
    if b == 46
        return 1
    if b == 33
        return 1
    if b == 63
        return 1
    0

// Return 1 if s is a stopword (small fixed set).
fn _sm_is_stop(s) -> int
    if s == "the"
        return 1
    if s == "a"
        return 1
    if s == "an"
        return 1
    if s == "and"
        return 1
    if s == "or"
        return 1
    if s == "but"
        return 1
    if s == "in"
        return 1
    if s == "on"
        return 1
    if s == "at"
        return 1
    if s == "to"
        return 1
    if s == "for"
        return 1
    if s == "of"
        return 1
    if s == "is"
        return 1
    if s == "are"
        return 1
    if s == "was"
        return 1
    if s == "were"
        return 1
    if s == "be"
        return 1
    if s == "been"
        return 1
    if s == "by"
        return 1
    if s == "with"
        return 1
    if s == "from"
        return 1
    if s == "as"
        return 1
    if s == "it"
        return 1
    if s == "its"
        return 1
    if s == "that"
        return 1
    if s == "this"
        return 1
    if s == "not"
        return 1
    if s == "have"
        return 1
    if s == "has"
        return 1
    if s == "had"
        return 1
    0

// Lowercase single char string.
fn _sm_lower_c(c) -> str
    let b = ord(c)
    if b >= 65 and b <= 90
        return chr(b + 32)
    c

// Lowercase a string, keeping all chars.
fn _sm_lower(s) -> str
    let out = ""
    let n = len(s)
    for i in 0..n
        let b = ord(s[i])
        if b >= 65 and b <= 90
            out += chr(b + 32)
        else
            out += s[i]
    out

// Trim leading/trailing whitespace from a string.
fn _sm_trim(s) -> str
    let n = len(s)
    if n == 0
        return ""
    // Find first non-ws position.
    let start = 0
    let found_start = 0
    let si = 0
    while si < n
        let b = ord(s[si])
        if found_start == 0
            if b == 32 or b == 9 or b == 13 or b == 10
                si += 1
            else
                start = si
                found_start = 1
                si = n
        else
            si += 1
    if found_start == 0
        return ""
    // Find last non-ws position.
    let stop = n - 1
    let found_stop = 0
    let ti = n - 1
    while ti >= 0
        let b = ord(s[ti])
        if found_stop == 0
            if b == 32 or b == 9 or b == 13 or b == 10
                ti -= 1
            else
                stop = ti
                found_stop = 1
                ti = 0 - 1
        else
            ti -= 1
    if found_stop == 0
        return ""
    let result = slice(s, start, stop + 1)
    result

// ── public API ───────────────────────────────────────────────────────────────

// Split text into sentence strings on . ! ? terminators.
fn sm_sentences(text) -> any
    let sents = []
    let n = len(text)
    let cur = ""
    for i in 0..n
        let b = ord(text[i])
        cur += text[i]
        if _sm_is_term(b) == 1
            let t = _sm_trim(cur)
            if len(t) > 0
                push(sents, t)
            cur = ""
    // handle trailing text with no terminator
    let t2 = _sm_trim(cur)
    if len(t2) > 0
        push(sents, t2)
    sents

// Tokenize a sentence into lowercased alpha content tokens (no stopwords).
fn sm_tokenize(sentence) -> any
    let toks = []
    let n = len(sentence)
    let cur = ""
    for i in 0..n
        let b = ord(sentence[i])
        if _sm_is_alpha_b(b) == 1
            if b >= 65 and b <= 90
                cur += chr(b + 32)
            else
                cur += sentence[i]
        else
            if len(cur) > 0
                if _sm_is_stop(cur) == 0
                    push(toks, cur)
                cur = ""
    if len(cur) > 0
        if _sm_is_stop(cur) == 0
            push(toks, cur)
    toks

// Build a word->frequency dict over entire text (stopwords excluded).
fn sm_word_freq(text) -> any
    let sents = sm_sentences(text)
    let freq = {}
    for i in 0..len(sents)
        let toks = sm_tokenize(sents[i])
        let j = 0
        while j < len(toks)
            let w = toks[j]
            if w in freq == 1
                freq[w] = freq[w] + 1
            else
                freq[w] = 1
            j += 1
    freq

// Score a single sentence: sum of member word frequencies / token count.
// Returns 0.0 if sentence has no content tokens.
fn sm_sentence_score(sentence, wordfreq) -> float
    let toks = sm_tokenize(sentence)
    let ntoks = len(toks)
    if ntoks == 0
        return 0.0
    let total = 0.0
    for i in 0..ntoks
        let w = toks[i]
        if w in wordfreq == 1
            let f = wordfreq[w]
            total += f * 1.0
    let result = total / (ntoks * 1.0)
    result

// Return list of dicts {index, sentence, score} ranked by score descending.
fn sm_rank_sentences(text) -> any
    let sents = sm_sentences(text)
    let wf = sm_word_freq(text)
    let scored = []
    for i in 0..len(sents)
        let sc = sm_sentence_score(sents[i], wf)
        let entry = {}
        entry["index"] = i
        entry["sentence"] = sents[i]
        entry["score"] = sc
        push(scored, entry)
    // Insertion-sort descending by score (stable).
    let n = len(scored)
    for j in 1..n
        let key = scored[j]
        let ks = key["score"]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let cur_s = scored[k]["score"]
            if cur_s < ks
                scored[k + 1] = scored[k]
                pos = k
                k -= 1
            else
                done = true
        scored[pos] = key
    scored

// Return top-n sentences in ORIGINAL document order (ascending index).
fn sm_top_sentences(text, n) -> any
    let ranked = sm_rank_sentences(text)
    let sents = sm_sentences(text)
    let total = len(ranked)
    let take = n
    if take > total
        take = total
    // Collect top-n entries and sort by original index.
    let picked = [ranked[i] for i in 0..take]
    // Insertion-sort picked ascending by index.
    let np = len(picked)
    for j in 1..np
        let key = picked[j]
        let ki = key["index"]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let cur_i = picked[k]["index"]
            if cur_i > ki
                picked[k + 1] = picked[k]
                pos = k
                k -= 1
            else
                done = true
        picked[pos] = key
    picked

// Join top-n sentences into a summary string (space-separated).
fn sm_summary(text, n) -> string
    let top = sm_top_sentences(text, n)
    let out = ""
    for i in 0..len(top)
        if i > 0
            out += " "
        out += top[i]["sentence"]
    out

// Return first n sentences of text joined (baseline lead summary).
fn sm_lead(text, n) -> string
    let sents = sm_sentences(text)
    let take = n
    if take > len(sents)
        take = len(sents)
    let out_parts = []
    for i in 0..take
        if i > 0
            push(out_parts, " ")
        push(out_parts, sents[i])
    let out = join(out_parts, "")
    out

// Score sentences by similarity to document centroid (mean word-frequency vector).
// Returns list of {index, sentence, score} sorted descending by centroid similarity.
fn sm_centroid_score(text) -> any
    let sents = sm_sentences(text)
    let wf = sm_word_freq(text)
    // Total word frequency (centroid magnitude proxy).
    let wkeys = keys(wf)
    let total_freq = 0.0
    for wi in 0..len(wkeys)
        let f = wf[wkeys[wi]]
        total_freq += f * 1.0
    let scored = []
    for i in 0..len(sents)
        // Dot product of sentence tf-vector and normalized centroid.
        let toks = sm_tokenize(sents[i])
        let ntoks = len(toks)
        let sim = 0.0
        if ntoks > 0 and total_freq > 0.0
            let j = 0
            while j < ntoks
                let w = toks[j]
                if w in wf == 1
                    let f = wf[w]
                    sim += (f * 1.0) / total_freq
                j += 1
        let entry = {}
        entry["index"] = i
        entry["sentence"] = sents[i]
        entry["score"] = sim
        push(scored, entry)
    // Sort descending by score (insertion sort).
    let n = len(scored)
    for j in 1..n
        let key = scored[j]
        let ks = key["score"]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let cur_s = scored[k]["score"]
            if cur_s < ks
                scored[k + 1] = scored[k]
                pos = k
                k -= 1
            else
                done = true
        scored[pos] = key
    scored

// Return top-k words by frequency as a list of strings.
fn sm_keywords(text, k) -> any
    let wf = sm_word_freq(text)
    let wkeys = keys(wf)
    let n = len(wkeys)
    // Build list of {word, freq} and sort descending by freq.
    let pairs = []
    for i in 0..n
        let w = wkeys[i]
        let entry = {}
        entry["word"] = w
        entry["freq"] = wf[w]
        push(pairs, entry)
    // Insertion sort descending by freq.
    let np = len(pairs)
    for j in 1..np
        let key = pairs[j]
        let kf = key["freq"]
        let pos = j
        let ki = j - 1
        let done = false
        while ki >= 0 and done == false
            let cur_f = pairs[ki]["freq"]
            if cur_f < kf
                pairs[ki + 1] = pairs[ki]
                pos = ki
                ki -= 1
            else
                done = true
        pairs[pos] = key
    // Return top-k word strings.
    let take = k
    if take > np
        take = np
    let result = [pairs[ri]["word"] for ri in 0..take]
    result

// Compression ratio: len(summary) / len(text). Returns 0.0 if text empty.
fn sm_compression_ratio(text, summary) -> float
    let lt = len(text)
    if lt == 0
        return 0.0
    let ls = len(summary)
    let result = (ls * 1.0) / (lt * 1.0)
    result

// Count sentences in text.
fn sm_sentence_count(text) -> int
    let sents = sm_sentences(text)
    len(sents)

fn main()
    print("std/text/summarize loaded")
