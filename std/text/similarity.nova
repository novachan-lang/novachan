// ============================================================================
// NOVA Standard Library — std/text/similarity
// ============================================================================
// Token and n-gram string similarity metrics returning floats in [0.0, 1.0].
//
// Public API:
//   sim_ngrams(s, n)          -> list    n-gram substrings of s
//   sim_dice(a, b)            -> float   Sørensen–Dice coefficient (char bigrams)
//   sim_jaccard_tokens(a, b)  -> float   Jaccard index over whitespace tokens
//   sim_cosine_tokens(a, b)   -> float   Cosine similarity over token frequencies
//
// All float results are bound to named lets before return to avoid the
// bare-float-return codegen bug (see reference_nova_float_codegen_geo_bearing).
// ============================================================================

// ── n-gram extraction ─────────────────────────────────────────────────────────

// sim_ngrams returns the list of all n-gram substrings of s.
// sim_ngrams("abcd", 2) -> ["ab", "bc", "cd"]
// Returns [] if n <= 0 or n > len(s).
fn sim_ngrams(s, n) -> list
    let slen = len(s)
    let result = []
    if n <= 0 or n > slen
        return result
    let i = 0
    while i <= slen - n
        let gram = slice(s, i, i + n)
        result.push(gram)
        i = i + 1
    result

// ── internal helpers ──────────────────────────────────────────────────────────

// _sim_bigrams builds a dict mapping each 2-gram to its count in s.
// Used by sim_dice.
fn _sim_bigrams(s) -> dict
    let slen = len(s)
    let counts = {}
    let i = 0
    while i <= slen - 2
        let bg = slice(s, i, i + 2)
        if contains(counts, bg)
            counts[bg] = counts[bg] + 1
        else
            counts[bg] = 1
        i = i + 1
    counts

// _sim_bigram_count returns the total count of all bigrams in a bigram dict.
fn _sim_bigram_count(bg_dict) -> int
    let total = 0
    let keys = dict_keys(bg_dict)
    for i in 0..len(keys)
        let k = keys[i]
        total = total + bg_dict[k]
    total

// _sim_bigram_intersect returns the size of the multiset intersection of
// two bigram count dicts: sum of min(count_a[bg], count_b[bg]) for shared bgs.
fn _sim_bigram_intersect(da, db) -> int
    let shared = 0
    let keys = dict_keys(da)
    for i in 0..len(keys)
        let k = keys[i]
        if contains(db, k)
            let ca = da[k]
            let cb = db[k]
            let mn = ca
            if cb < mn
                mn = cb
            shared = shared + mn
    shared

// _sim_split_tokens splits a string on runs of ASCII spaces into tokens.
// Returns a list of non-empty token strings.
fn _sim_split_tokens(s) -> list
    let slen = len(s)
    let tokens = []
    let i = 0
    while i < slen
        // skip spaces
        while i < slen and ord(s[i]) == 32
            i = i + 1
        // collect non-space run
        let start = i
        while i < slen and ord(s[i]) != 32
            i = i + 1
        if i > start
            let tok = slice(s, start, i)
            tokens.push(tok)
    tokens

// _sim_token_freqs builds a dict mapping each token to its occurrence count.
fn _sim_token_freqs(tokens) -> dict
    let freqs = {}
    for i in 0..len(tokens)
        let t = tokens[i]
        if contains(freqs, t)
            freqs[t] = freqs[t] + 1
        else
            freqs[t] = 1
    freqs

// _sim_sqrt computes sqrt via Newton-Raphson iteration (pure NOVA, no libc).
fn _sim_sqrt(x) -> float
    if x <= 0.0
        return 0.0
    let guess = x
    if x < 1.0
        guess = 1.0
    let i = 0
    while i < 60
        let next = (guess + x / guess) / 2.0
        let diff = next - guess
        if diff < 0.0
            diff = 0.0 - diff
        if diff < 0.0000000001
            guess = next
            i = 60
        else
            guess = next
            i = i + 1
    guess

// ── Sørensen–Dice coefficient ─────────────────────────────────────────────────

// sim_dice computes the Dice coefficient over character bigrams.
//
//   dice(a, b) = 2 * |bigrams(a) ∩ bigrams(b)| / (|bigrams(a)| + |bigrams(b)|)
//
// where |·| counts the total number of bigrams (with repetition = multiset).
// Returns 1.0 for identical strings, 0.0 if either string has no bigrams.
fn sim_dice(a, b) -> float
    let da = _sim_bigrams(a)
    let db = _sim_bigrams(b)
    let na = _sim_bigram_count(da)
    let nb = _sim_bigram_count(db)
    if na == 0 and nb == 0
        return 1.0
    if na == 0 or nb == 0
        return 0.0
    let shared = _sim_bigram_intersect(da, db)
    let num = (2 * shared) * 1.0
    let den = (na + nb) * 1.0
    let result = num / den
    result

// ── Jaccard index over whitespace tokens ──────────────────────────────────────

// sim_jaccard_tokens computes the Jaccard index over the SET of whitespace tokens.
//
//   jaccard(a, b) = |tokens(a) ∩ tokens(b)| / |tokens(a) ∪ tokens(b)|
//
// Token sets are SETS (duplicate tokens counted once per string).
// Returns 0.0 if both strings are empty (no tokens).
fn sim_jaccard_tokens(a, b) -> float
    let ta = _sim_split_tokens(a)
    let tb = _sim_split_tokens(b)

    // Build set-dicts (key presence = membership)
    let sa = {}
    let i = 0
    while i < len(ta)
        sa[ta[i]] = 1
        i = i + 1

    let sb = {}
    i = 0
    while i < len(tb)
        sb[tb[i]] = 1
        i = i + 1

    // Intersection: tokens in both sets
    let inter = 0
    let keys_a = dict_keys(sa)
    i = 0
    while i < len(keys_a)
        let k = keys_a[i]
        if contains(sb, k)
            inter = inter + 1
        i = i + 1

    // Union: all tokens from both sets (merge sa into sb for union count)
    let union_d = {}
    i = 0
    let ksa = dict_keys(sa)
    while i < len(ksa)
        union_d[ksa[i]] = 1
        i = i + 1
    let ksb = dict_keys(sb)
    i = 0
    while i < len(ksb)
        union_d[ksb[i]] = 1
        i = i + 1
    let uni = len(dict_keys(union_d))

    if uni == 0
        return 0.0
    let num = inter * 1.0
    let den = uni * 1.0
    let result = num / den
    result

// ── Cosine similarity over token frequencies ─────────────────────────────────

// sim_cosine_tokens computes cosine similarity using term-frequency vectors of
// whitespace tokens.
//
//   cosine(a, b) = dot(freq_a, freq_b) / (|freq_a| * |freq_b|)
//
// where dot is the sum of freq_a[t]*freq_b[t] over shared tokens, and
// |freq| = sqrt(sum of squares of all frequencies).
// Returns 0.0 if either string has no tokens.
fn sim_cosine_tokens(a, b) -> float
    let ta = _sim_split_tokens(a)
    let tb = _sim_split_tokens(b)
    if len(ta) == 0 or len(tb) == 0
        return 0.0

    let fa = _sim_token_freqs(ta)
    let fb = _sim_token_freqs(tb)

    // Dot product: sum freq_a[t] * freq_b[t] for tokens in both
    let dot = 0
    let keys_a = dict_keys(fa)
    let i = 0
    while i < len(keys_a)
        let k = keys_a[i]
        if contains(fb, k)
            dot = dot + fa[k] * fb[k]
        i = i + 1

    if dot == 0
        return 0.0

    // Magnitude of freq_a
    let sum_a = 0
    let ksa = dict_keys(fa)
    i = 0
    while i < len(ksa)
        let v = fa[ksa[i]]
        sum_a = sum_a + v * v
        i = i + 1

    // Magnitude of freq_b
    let sum_b = 0
    let ksb = dict_keys(fb)
    i = 0
    while i < len(ksb)
        let v = fb[ksb[i]]
        sum_b = sum_b + v * v
        i = i + 1

    let dot_f = dot * 1.0
    let mag_a = _sim_sqrt(sum_a * 1.0)
    let mag_b = _sim_sqrt(sum_b * 1.0)
    let denom = mag_a * mag_b
    if denom <= 0.0
        return 0.0
    let result = dot_f / denom
    result

// ============================================================================
fn main()
    print("std/text/similarity loaded")
