// ============================================================================
// NOVA Standard Library — std/text/md_table
// ============================================================================
// GitHub Flavored Markdown (GFM) table renderer.
//
// Public API:
//   md_table(text) -> string
//       Parse a GFM table from `text` (rows separated by chr(10)) and return
//       an HTML <table> string. The first row becomes <thead> with <th> cells;
//       the second row is the separator ("|---|---|" style) and is discarded;
//       subsequent rows become <tbody> <tr><td>...</td></tr> rows.
//       All cell content is trimmed of leading/trailing spaces.
//       Pipe characters at the start/end of a row are ignored.
//
// Example:
//   md_table("| A | B |"+chr(10)+"| - | - |"+chr(10)+"| 1 | 2 |")
//   => "<table><thead><tr><th>A</th><th>B</th></tr></thead><tbody><tr><td>1</td><td>2</td></tr></tbody></table>"
//
// LEAF — imports NOTHING.

// PRIVATE: trim leading and trailing spaces from s.
fn _mdt_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and slice(s, start, start+1) == " "
        start = start + 1
    let end = n
    while end > start and slice(s, end-1, end) == " "
        end = end - 1
    slice(s, start, end)

// PRIVATE: split a pipe-delimited row into trimmed cell strings.
// Strips leading/trailing | chars first, then splits on |.
fn _mdt_split_cells(row: string) -> list
    let n = len(row)
    // strip leading pipe
    let start = 0
    if n > 0 and slice(row, 0, 1) == "|"
        start = 1
    // strip trailing pipe
    let end = n
    if end > start and slice(row, end-1, end) == "|"
        end = end - 1
    let inner = slice(row, start, end)
    // split on |
    let parts = split(inner, "|")
    let cells = []
    for i in 0..len(parts)
        let cell = _mdt_trim(parts[i])
        push(cells, cell)
    cells

// PRIVATE: check whether a row is a GFM separator (all cells match /^[-: ]+$/).
fn _mdt_is_separator(row: string) -> bool
    let cells = _mdt_split_cells(row)
    if len(cells) == 0
        return false
    for i in 0..len(cells)
        let cell = cells[i]
        let cn = len(cell)
        if cn == 0
            return false
        let j = 0
        let ok = true
        while j < cn
            let ch = slice(cell, j, j+1)
            if ch != "-" and ch != ":" and ch != " "
                ok = false
            j = j + 1
        if not ok
            return false
    true

// md_table(text) -> string
// Parse a GFM table and return the HTML <table> string.
fn md_table(text: string) -> string
    let rows = split(text, chr(10))
    let nrows = len(rows)
    if nrows < 2
        return ""
    // row 0 = header, row 1 = separator, rows 2+ = body
    let header_cells = _mdt_split_cells(rows[0])
    let ncols = len(header_cells)
    // build <thead>
    let thead = "<thead><tr>"
    for i in 0..ncols
        thead = thead + "<th>" + header_cells[i] + "</th>"
    thead = thead + "</tr></thead>"
    // build <tbody> from rows 2+
    let tbody = "<tbody>"
    for r in 2..nrows
        let row = rows[r]
        if len(row) > 0
            let cells = _mdt_split_cells(row)
            tbody = tbody + "<tr>"
            let c = 0
            while c < ncols
                let cell = ""
                if c < len(cells)
                    cell = cells[c]
                tbody = tbody + "<td>" + cell + "</td>"
                c = c + 1
            tbody = tbody + "</tr>"
    tbody = tbody + "</tbody>"
    "<table>" + thead + tbody + "</table>"
