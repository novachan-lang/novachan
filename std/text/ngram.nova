// ============================================================================
// NOVA Standard Library — std/text/ngram
// ============================================================================
// N-gram extraction utilities for character-level and word-level n-grams,
// plus frequency counting.
//
// Public API:
//   ng_char(s, n)     -> list   contiguous character n-grams as substrings
//   ng_word(s, n)     -> list   word n-grams (split on spaces, join with " ")
//   ng_bigrams(s)     -> list   == ng_word(s, 2)
//   ng_freq(grams)    -> dict   gram -> count (int)
//
// Design:
//   - ng_char: uses substring/slice (end-exclusive). Returns [] when n<1 or n>len(s).
//   - ng_word: splits s on spaces dropping empty tokens, then slides a window
//     of n consecutive tokens joined with " ". Returns [] when n<1 or fewer
//     than n words exist.
//   - ng_freq: iterates the list; uses contains() guard before reading dict
//     (missing key would return int 0 but guard is explicit for clarity).
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Split string s on single space (ASCII 32), dropping empty tokens.
// Returns a list of non-empty word strings.
fn _ng_split_words(s) -> list
    let words = []
    let n = len(s)
    let i = 0
    let cur = ""
    while i < n
        let b = ord(s[i])
        if b == 32
            if len(cur) > 0
                push(words, cur)
                cur = ""
        else
            cur = cur + chr(b)
        i = i + 1
    if len(cur) > 0
        push(words, cur)
    words

// Join a slice of list `ws` from index `start` (inclusive) for `count` items
// with a single space separator.
fn _ng_join_slice(ws, start, count) -> str
    let result = ""
    let i = 0
    while i < count
        if i > 0
            result = result + " "
        result = result + ws[start + i]
        i = i + 1
    result

// ── public API ───────────────────────────────────────────────────────────────

// Extract contiguous character n-grams from string s.
// Each n-gram is a substring of exactly n characters.
// Returns [] when n < 1 or n > len(s).
fn ng_char(s, n) -> list
    let result = []
    if n < 1
        return result
    let slen = len(s)
    if n > slen
        return result
    let i = 0
    while i <= slen - n
        push(result, slice(s, i, i + n))
        i = i + 1
    result

// Extract word-level n-grams from string s.
// Words are separated by spaces; empty tokens (consecutive spaces) are dropped.
// Each n-gram is n consecutive words joined with a single space.
// Returns [] when n < 1 or the word count is less than n.
fn ng_word(s, n) -> list
    let result = []
    if n < 1
        return result
    let words = _ng_split_words(s)
    let wlen = len(words)
    if n > wlen
        return result
    let i = 0
    while i <= wlen - n
        push(result, _ng_join_slice(words, i, n))
        i = i + 1
    result

// Shorthand: word bigrams (n=2).
fn ng_bigrams(s) -> list
    ng_word(s, 2)

// Build a frequency dict from a list of gram strings.
// Returns dict of gram -> occurrence count (int).
fn ng_freq(grams) -> dict
    let freq = {}
    let n = len(grams)
    let i = 0
    while i < n
        let g = grams[i]
        if contains(freq, g)
            freq[g] = freq[g] + 1
        else
            freq[g] = 1
        i = i + 1
    freq
