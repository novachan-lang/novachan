// std/text/pluralize -- Basic English pluralization. LEAF -- imports NOTHING.
//
// Public API:
//   pl_pluralize(word: string) -> string
//     Returns the plural form of the English word.
//     Rules applied in order:
//       1. Irregular words (man/men, woman/women, child/children, foot/feet,
//          tooth/teeth, mouse/mice, person/people).
//       2. Words ending in -y after a consonant -> -ies.
//       3. Words ending in -s, -x, -z, -ch, -sh -> -es.
//       4. Words ending in -f or -fe -> -ves (leaf/leaves, knife/knives).
//       5. Default: append -s.
//
//   pl_singularize(word: string) -> string
//     Reverses the common plural forms back to singular.
//     Rules applied in order:
//       1. Irregular plurals.
//       2. -ies suffix -> -y.
//       3. -ves suffix -> -f (leaves->leaf, knives->knife treated via irregulars).
//       4. -es suffix (from -s/-x/-z/-ch/-sh words) -> strip -es.
//       5. -s suffix -> strip -s.
//       6. Unknown: return as-is.
//
//   pl_plural_n(word: string, n: int) -> string
//     Returns word unchanged when n==1, else pl_pluralize(word).
//
// Design notes:
//   - All comparisons are case-sensitive; words expected in lowercase.
//   - We avoid multi-line list/dict literals (NOVA constraint): irregulars
//     are tested with chained if/else blocks.
//   - _ends_with(s, suffix) walks backwards byte-by-byte since NOVA has
//     no built-in suffix test.
//   - _is_vowel(c) used to distinguish consonant-y from vowel-y (e.g. "day"
//     does NOT become "daies").

// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------

fn _ends_with(s: string, suffix: string) -> int
    let sl = len(s)
    let xl = len(suffix)
    if xl > sl
        return 0
    for i in 0..xl
        let si = sl - xl + i
        if char_at(s, si) != char_at(suffix, i)
            return 0
    1

fn _drop_last(s: string, n: int) -> string
    slice(s, 0, len(s) - n)

fn _is_vowel(c: string) -> int
    if c == "a"
        return 1
    if c == "e"
        return 1
    if c == "i"
        return 1
    if c == "o"
        return 1
    if c == "u"
        return 1
    0

// ---------------------------------------------------------------------------
// pl_pluralize
// ---------------------------------------------------------------------------

fn pl_pluralize(word: string) -> string
    let n = len(word)
    if n == 0
        return ""

    // 1. Irregular words (exact match, case-sensitive lowercase)
    if word == "man"
        return "men"
    if word == "woman"
        return "women"
    if word == "child"
        return "children"
    if word == "foot"
        return "feet"
    if word == "tooth"
        return "teeth"
    if word == "mouse"
        return "mice"
    if word == "person"
        return "people"
    if word == "ox"
        return "oxen"
    if word == "goose"
        return "geese"

    // 2. Words ending in -y after a consonant -> -ies
    //    (but not -ay, -ey, -iy, -oy, -uy -> just +s)
    if _ends_with(word, "y") == 1 and n >= 2
        let prev = char_at(word, n - 2)
        if _is_vowel(prev) == 0
            return _drop_last(word, 1) + "ies"

    // 3. Words ending in -ch, -sh, -s, -x, -z -> -es
    if _ends_with(word, "ch") == 1
        return word + "es"
    if _ends_with(word, "sh") == 1
        return word + "es"
    if _ends_with(word, "s") == 1
        return word + "es"
    if _ends_with(word, "x") == 1
        return word + "es"
    if _ends_with(word, "z") == 1
        return word + "es"

    // 4. Words ending in -fe -> -ves  (knife -> knives)
    if _ends_with(word, "fe") == 1
        return _drop_last(word, 2) + "ves"

    // 4b. Words ending in -f -> -ves  (leaf -> leaves, wolf -> wolves)
    //     Exception: words already handled above or common roof/belief stay +s;
    //     for this basic ruleset we apply the standard rule.
    if _ends_with(word, "f") == 1
        return _drop_last(word, 1) + "ves"

    // 5. Default: append -s
    word + "s"

// ---------------------------------------------------------------------------
// pl_singularize
// ---------------------------------------------------------------------------

fn pl_singularize(word: string) -> string
    let n = len(word)
    if n == 0
        return ""

    // 1. Irregular plurals -> singular
    if word == "men"
        return "man"
    if word == "women"
        return "woman"
    if word == "children"
        return "child"
    if word == "feet"
        return "foot"
    if word == "teeth"
        return "tooth"
    if word == "mice"
        return "mouse"
    if word == "people"
        return "person"
    if word == "oxen"
        return "ox"
    if word == "geese"
        return "goose"
    if word == "leaves"
        return "leaf"
    if word == "knives"
        return "knife"
    if word == "wolves"
        return "wolf"
    if word == "lives"
        return "life"
    if word == "wives"
        return "wife"
    if word == "loaves"
        return "loaf"
    if word == "halves"
        return "half"
    if word == "shelves"
        return "shelf"
    if word == "elves"
        return "elf"
    if word == "calves"
        return "calf"
    if word == "selves"
        return "self"

    // 2. -ies -> -y  (babies -> baby)
    if _ends_with(word, "ies") == 1 and n > 3
        return _drop_last(word, 3) + "y"

    // 3. Remaining -ves -> -f  (general case, not already handled above)
    if _ends_with(word, "ves") == 1 and n > 3
        return _drop_last(word, 3) + "f"

    // 4. -es -> strip to base form for -ch/-sh/-s/-x/-z words
    //    We only strip -es when the result ends in ch/sh/s/x/z (or is ss),
    //    to avoid wrongly stripping "cases" -> "cas".
    if _ends_with(word, "es") == 1 and n > 2
        let base = _drop_last(word, 2)
        let bl = len(base)
        if bl > 0
            let do_strip = 0
            if _ends_with(base, "ch") == 1
                do_strip = 1
            if _ends_with(base, "sh") == 1
                do_strip = 1
            if _ends_with(base, "s") == 1
                do_strip = 1
            if _ends_with(base, "x") == 1
                do_strip = 1
            if _ends_with(base, "z") == 1
                do_strip = 1
            if do_strip == 1
                return base

    // 5. -s -> strip  (cats -> cat)
    if _ends_with(word, "s") == 1 and n > 1
        return _drop_last(word, 1)

    // 6. Unknown: return as-is
    word

// ---------------------------------------------------------------------------
// pl_plural_n
// ---------------------------------------------------------------------------

fn pl_plural_n(word: string, n: int) -> string
    if n == 1
        return word
    pl_pluralize(word)
