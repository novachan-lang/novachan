// ============================================================================
// NOVA Standard Library — std/text/manacher
// ============================================================================
// Manacher's O(n) algorithm for palindrome analysis on UTF-8-safe strings.
// All functions operate on the original string via the transformed string
// T = "#s[0]#s[1]#...#s[n-1]#" (length 2n+1) which unifies odd- and even-
// length palindromes into a single pass.
//
// Public API:
//   mn_longest(s)      -> string  a longest palindromic substring (first if tie)
//   mn_length(s)       -> int     length of a longest palindromic substring
//   mn_count(s)        -> int     total count of non-empty palindromic substrings
//   mn_is_palindrome(s)-> bool    true iff s == reverse(s) (uses mn_ prefix)
//
// Complexity:
//   mn_longest / mn_length / mn_count — O(n) time, O(n) space (Manacher)
//   mn_is_palindrome                  — O(n) two-pointer
//
// Algorithm notes:
//   T[2k]   = '#' (separator)  →  even-length palindromes in original
//   T[2k+1] = s[k] (char)      →  odd-length palindromes in original
//   For center at T[i] with radius p[i]:
//     original palindrome start = (i - p[i]) / 2
//     original palindrome length = p[i]   (the separator count equals length)
// ============================================================================

// ── mn_build_t — build the transformed string ─────────────────────────────

// mn_build_t inserts '#' between every character (and at both ends) so that
// both odd- and even-length palindromes are represented as odd-length
// palindromes in the transformed string.  For n=0 returns "#".
fn mn_build_t(s) -> string
    let n = len(s)
    "#" + join([s[i] + "#" for i in 0..n], "")

// ── mn_p_array — compute Manacher's p[] radius array ─────────────────────

// mn_p_array returns a list of radii p[i] for each position i in T.
// p[i] is the largest r such that T[i-r..i+r] is a palindrome.
// Uses the standard center/mirror optimisation so the total work is O(|T|).
fn mn_p_array(t) -> list
    let tlen = len(t)
    // Initialise p to all zeros.
    let p = [0 for idx in 0..tlen]

    // c = current rightmost-palindrome center; r = its right boundary.
    let c = 0
    let r = 0
    for i in 1..(tlen - 1)
        // Mirror of i around center c.
        let mirror = 2 * c - i
        let pi = 0
        // If i is within the known right boundary, use the mirror radius
        // (capped so we do not exceed the boundary).
        if i < r
            let gap = r - i
            let pmirror = p[mirror]
            if pmirror < gap
                pi = pmirror
            else
                pi = gap
        // Attempt to expand beyond the known radius.
        let done = 0
        while done == 0
            let left = i - pi - 1
            let right = i + pi + 1
            if left < 0
                done = 1
            else
                if right >= tlen
                    done = 1
                else
                    if ord(t[left]) != ord(t[right])
                        done = 1
                    else
                        pi = pi + 1
        p[i] = pi
        // Update center/boundary if this palindrome extends further right.
        if i + pi > r
            c = i
            r = i + pi
    p

// ── mn_length ─────────────────────────────────────────────────────────────

// mn_length returns the length of a longest palindromic substring of s.
// Single-character strings always have length 1.
fn mn_length(s) -> int
    let n = len(s)
    if n == 0
        return 0
    let t = mn_build_t(s)
    let p = mn_p_array(t)
    let pmax = list_max(p)
    pmax if pmax > 1 else 1

// ── mn_longest ────────────────────────────────────────────────────────────

// mn_longest returns one longest palindromic substring (the first one
// encountered in left-to-right order when there are ties).
fn mn_longest(s) -> string
    let n = len(s)
    if n == 0
        return ""
    let t = mn_build_t(s)
    let p = mn_p_array(t)
    let best_len = 1
    let best_center = 1
    let tlen = len(t)
    let i = 1
    while i < tlen - 1
        let pi = p[i]
        if pi > best_len
            best_len = pi
            best_center = i
        i = i + 1
    // Convert back: original start = (best_center - best_len) / 2
    let orig_start = (best_center - best_len) / 2
    slice(s, orig_start, orig_start + best_len)

// ── mn_count ──────────────────────────────────────────────────────────────

// mn_count returns the total number of non-empty palindromic substrings of s,
// counting each occurrence separately (e.g. the two "a"s in "aaa" are counted
// as two distinct occurrences).
// For each center i in T:
//   if T[i] is a char position (i odd in T, i.e. i%2==1): contributes (p[i]+1)/2
//   if T[i] is a separator  (i even in T, i.e. i%2==0): contributes p[i]/2
fn mn_count(s) -> int
    let n = len(s)
    if n == 0
        return 0
    let t = mn_build_t(s)
    let p = mn_p_array(t)
    let total = 0
    let tlen = len(t)
    for i in 0..tlen
        let pi = p[i]
        // Separator positions (even index) contribute even-length palindromes.
        // Char positions (odd index) contribute odd-length palindromes.
        let contrib = 0
        if i % 2 == 1
            contrib = (pi + 1) / 2
        else
            contrib = pi / 2
        total = total + contrib
    total

// ── mn_is_palindrome ──────────────────────────────────────────────────────

// mn_is_palindrome returns 1 (true) if s reads the same forwards and
// backwards, 0 (false) otherwise. Uses a two-pointer O(n) scan rather than
// calling mn_longest to avoid the O(n) transformed-string overhead for this
// simple predicate.
fn mn_is_palindrome(s) -> int
    let n = len(s)
    if n <= 1
        return 1
    let lo = 0
    let hi = n - 1
    let ok = 1
    while lo < hi
        if ord(s[lo]) != ord(s[hi])
            ok = 0
            lo = hi
        else
            lo = lo + 1
            hi = hi - 1
    ok

// ============================================================================
fn main()
    print("std/text/manacher loaded")
