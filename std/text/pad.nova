// std/text/pad -- string padding and justification (Python-compatible names).
// Every function measures length in chars (via len()) and returns s unchanged
// when len(s) >= width (never truncates). fill is a single-char string.
//
// Public API:
//   ljust(s, width, fill) -> string  -- left-justify: pad fill on the RIGHT
//   rjust(s, width, fill) -> string  -- right-justify: pad fill on the LEFT
//   center(s, width, fill) -> string -- center; odd extra pad goes on the RIGHT
//   zfill(s, width) -> string        -- zero-pad on LEFT; sign-aware ("-" or "+")
//
// LEAF -- imports NOTHING.

// PRIVATE: repeat single-char string ch exactly n times ("" if n <= 0).
fn _pad_rep(ch: string, n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + ch
        i = i + 1
    out

// Left-justify s: pad fill chars on the RIGHT until total length == width.
// ljust("hi", 5, " ") == "hi   " ; ljust("hello", 3, " ") == "hello"
fn ljust(s: string, width: int, fill: string) -> string
    let out = s
    if len(s) < width
        out = s + _pad_rep(fill, width - len(s))
    out

// Right-justify s: pad fill chars on the LEFT until total length == width.
// rjust("hi", 5, " ") == "   hi" ; rjust("42", 5, "0") == "00042"
fn rjust(s: string, width: int, fill: string) -> string
    let out = s
    if len(s) < width
        out = _pad_rep(fill, width - len(s)) + s
    out

// Center s within width, padding fill on both sides.
// If the required padding is odd, the extra character goes on the RIGHT.
// center("hi", 6, " ") == "  hi  " ; center("hi", 5, " ") == " hi  "
fn center(s: string, width: int, fill: string) -> string
    let out = s
    if len(s) < width
        let total = width - len(s)
        let left = total / 2
        let right = total - left
        out = _pad_rep(fill, left) + s + _pad_rep(fill, right)
    out

// Zero-pad s on the LEFT to width using "0" chars.
// Sign-aware: a leading "-" or "+" is kept first; zeros go after the sign.
// zfill("42", 5) == "00042" ; zfill("-42", 5) == "-0042" ; zfill("7", 1) == "7"
fn zfill(s: string, width: int) -> string
    let out = s
    if len(s) < width
        let slen = len(s)
        if slen > 0 and (char_at(s, 0) == "-" or char_at(s, 0) == "+")
            let sign = char_at(s, 0)
            let rest = slice(s, 1, slen)
            out = sign + _pad_rep("0", width - slen) + rest
        else
            out = _pad_rep("0", width - slen) + s
    out
