// ============================================================================
// NOVA Standard Library — std/text/patch_stats
// ============================================================================
// Statistics from a diff/patch script or unified diff text.
//
// Public API:
//   script_stats(script)    -> dict {"keep","insert","delete"}
//   patch_stats(diff_text)  -> dict {"additions","deletions","hunks"}
//   diffstat_line(diff_text)-> string e.g. "2 insertions(+), 1 deletion(-)"
//
// Unified diff lines recognised:
//   lines beginning "+" (not "+++") → addition
//   lines beginning "-" (not "---") → deletion
//   lines beginning "@@"             → hunk boundary
//
// Empty / malformed input is safe — counters start at zero.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _ps_starts(s, prefix) — 1 if s starts with prefix, else 0.
fn _ps_starts(s, prefix)
    let pl = len(prefix)
    let sl = len(s)
    if sl < pl
        return 0
    if slice(s, 0, pl) == prefix
        return 1
    return 0

// _ps_split_lines(text) — split on chr(10); empty text → empty list.
fn _ps_split_lines(text)
    let result = []
    let n = len(text)
    if n == 0
        return result
    let start = 0
    for i in 0..n
        if slice(text, i, i + 1) == chr(10)
            result.push(slice(text, start, i))
            start = i + 1
    result.push(slice(text, start, n))
    result

// ── Public API ────────────────────────────────────────────────────────────────

// script_stats: count keep/insert/delete ops in a shared edit-script.
// Each op is a 2-element list [tag, line], tag in "=" / "+" / "-".
fn script_stats(script)
    let keep = 0
    let ins = 0
    let del = 0
    for i in 0..len(script)
        let op = script[i]
        let tag = op[0]
        if tag == "="
            keep = keep + 1
        else
            if tag == "+"
                ins = ins + 1
            else
                if tag == "-"
                    del = del + 1
    let r = {}
    r["keep"] = keep
    r["insert"] = ins
    r["delete"] = del
    r

// patch_stats: parse unified diff text and count additions, deletions, hunks.
fn patch_stats(diff_text)
    let lines = _ps_split_lines(diff_text)
    let adds = 0
    let dels = 0
    let hunks = 0
    for i in 0..len(lines)
        let ln = lines[i]
        if _ps_starts(ln, "@@") == 1
            hunks = hunks + 1
        else
            if _ps_starts(ln, "+++") == 0 and _ps_starts(ln, "+") == 1
                adds = adds + 1
            else
                if _ps_starts(ln, "---") == 0 and _ps_starts(ln, "-") == 1
                    dels = dels + 1
    let r = {}
    r["additions"] = adds
    r["deletions"] = dels
    r["hunks"] = hunks
    r

// diffstat_line: human-readable summary of a unified diff.
// Format: "N insertions(+), M deletions(-)"
// Singular forms: "1 insertion(+)", "1 deletion(-)"
fn diffstat_line(diff_text)
    let st = patch_stats(diff_text)
    let adds = st["additions"]
    let dels = st["deletions"]
    let ins_word = "insertions"
    if adds == 1
        ins_word = "insertion"
    let del_word = "deletions"
    if dels == 1
        del_word = "deletion"
    str(adds) + " " + ins_word + "(+), " + str(dels) + " " + del_word + "(-)"

// ============================================================================
fn main()
    print("std/text/patch_stats loaded")
