// ============================================================================
// NOVA Standard Library — std/text/template
// ============================================================================
// Mustache-style {{key}} placeholder substitution.
//
// Public API:
//   template_render(tmpl: string, vars: dict) -> string
//     Scan `tmpl` for {{ key }} spans; the inner text is trimmed of whitespace
//     to produce a key; replace the whole {{...}} with vars[key].
//     A key NOT in vars is replaced with "" (empty string — never crashes).
//     Text outside placeholders is copied verbatim.
//     A lone "{" not followed by another "{" is emitted as a literal character.
//
// Brace detection uses byte values (123 = '{', 125 = '}') via
// ord(char_at(s,i)) — NEVER string-literal "{" comparisons, which would be
// subject to NOVA's "{" interpolation rules.
//
//   tpl_render(template, vars) -> Result   -- ok(rendered) | err("unknown key: <k>")
//   tpl_render_default(template, vars, default) -> string  -- never errs
//   tpl_keys(template) -> list             -- distinct {key} names, first-seen order
//   tpl_fill(template, rows) -> list       -- render each row (list of dicts)
//
// Imports std/core/list (list_unique) for tpl_keys' dedup step.
// ============================================================================

import std/core/list

// Scan `tmpl` for {{ ... }} placeholders.
// Each placeholder inner text is trimmed; looked up in `vars`; missing = "".
// Everything else passes through verbatim.
fn template_render(tmpl, vars) -> string
    let out = ""
    let i = 0
    let n = len(tmpl)
    while i < n
        // Check for '{{': two consecutive '{' bytes (123)
        if i + 1 < n and ord(char_at(tmpl, i)) == 123 and ord(char_at(tmpl, i + 1)) == 123
            // We are inside a '{{' placeholder. Scan for the closing '}}',
            // collecting the key bytes along the way.
            let j = i + 2
            let key = ""
            let found_close = 0
            let close_end = i + 2   // will be set to position after '}}' when found
            while j < n and found_close == 0
                if j + 1 < n and ord(char_at(tmpl, j)) == 125 and ord(char_at(tmpl, j + 1)) == 125
                    found_close = 1
                    close_end = j + 2
                else
                    key += char_at(tmpl, j)
                    j += 1
            if found_close == 1
                let k = trim(key)
                let val = ""
                if k in vars
                    val = str(vars[k])
                out += val
                i = close_end
            else
                // Unclosed '{{' — emit the literal '{' characters and key bytes
                out += char_at(tmpl, i) + char_at(tmpl, i + 1) + key
                i = n
        else
            // Ordinary character — emit verbatim
            out += char_at(tmpl, i)
            i += 1
    out

// ============================================================================
// tpl_render / tpl_render_default / tpl_keys / tpl_fill
// ============================================================================
// A second, simpler single-brace {key} template style (Python str.format-ish),
// distinct from the double-brace {{key}} Mustache engine above. Fallible by
// default (tpl_render returns a Result — an unknown key is an error, not a
// silent ""), with an explicit non-failing variant (tpl_render_default) for
// callers who want a filled-in placeholder instead of a Result.
//
// Escaping: \{ and \} in the template TEXT emit a literal brace character
// instead of opening/closing a placeholder. An unterminated "{..." (no
// closing "}" before end of string) degrades to literal text rather than
// erroring — bad input never crashes the parser.
//
// Brace/backslash detection: braces are matched via ord(char_at(s,i)) against
// 123/125 (never a bare "{"/"}" string literal — a raw "{expr}" inside a
// NOVA string literal is parsed as INTERPOLATION at compile time, and an
// undefined identifier inside it silently becomes 0 instead of a compile
// error — confirmed live). A literal backslash IS safely written as "\\"
// (the same proven pattern std/automata/regex, std/data/yaml and
// std/parsing/glob already use for backslash detection).
// ============================================================================

// PRIVATE: scan `template` into an ordered token list. Each token is a
// 2-element list [kind, text]: kind "L" = literal text, kind "K" = a {key}
// placeholder name. One left-to-right char scan with a nested while for the
// key body — no unrolling, no duplicated blocks.
fn _tpl_parse(template: string) -> list
    let toks = []
    let lit = ""
    let i = 0
    let n = len(template)
    while i < n
        let c = char_at(template, i)
        if c == "\\" and i + 1 < n and (ord(char_at(template, i + 1)) == 123 or ord(char_at(template, i + 1)) == 125)
            // \{ or \} — literal brace, consume both source chars
            lit += char_at(template, i + 1)
            i += 2
        else if ord(c) == 123
            if len(lit) > 0
                push(toks, ["L", lit])
                lit = ""
            let j = i + 1
            let key_parts = []
            let closed = false
            while j < n and not closed
                if ord(char_at(template, j)) == 125
                    closed = true
                else
                    push(key_parts, char_at(template, j))
                    j += 1
            let key = join(key_parts, "")
            if closed
                push(toks, ["K", key])
                i = j + 1
            else
                // unterminated placeholder — degrade to literal text
                lit += chr(123) + key
                i = j
        else
            lit += c
            i += 1
    if len(lit) > 0
        push(toks, ["L", lit])
    return toks

// tpl_render(template, vars) -> Result
// Substitutes every {key} with str(vars[key]); the FIRST key (in scan order)
// missing from vars short-circuits the whole render with an Err — the
// policy is "fail loud on typos", matching Result's role everywhere else in
// NOVA (no silent wrong output).
fn tpl_render(template: string, vars: dict) -> Result
    let toks = _tpl_parse(template)
    let out = ""
    for tok in toks
        match tok[0]
            "L" =>
                out += tok[1]
            "K" =>
                if tok[1] not in vars
                    return err("unknown key: " + tok[1])
                out += str(vars[tok[1]])
            _ =>
                out += ""
    return ok(out)

// tpl_render_default(template, vars, default) -> string
// Same substitution, but a missing key renders `default_val` instead of
// erroring. Never fails — always returns a string.
fn tpl_render_default(template: string, vars: dict, default_val: string) -> string
    let toks = _tpl_parse(template)
    let out_parts = []
    for tok in toks
        match tok[0]
            "L" =>
                push(out_parts, tok[1])
            "K" =>
                if tok[1] in vars
                    push(out_parts, str(vars[tok[1]]))
                else
                    push(out_parts, default_val)
            _ =>
                push(out_parts, "")
    let out = join(out_parts, "")
    return out

// tpl_keys(template) -> list
// The distinct {key} names referenced in `template`, in first-seen order.
fn tpl_keys(template: string) -> list
    let toks = _tpl_parse(template)
    let raw_keys = [tok[1] for tok in toks if tok[0] == "K"]
    return list_unique(raw_keys)

// tpl_fill(template, rows) -> list
// Renders `template` once per row in `rows` (a list of dicts). Uses the
// tpl_render_default policy per row (a key missing from a given row renders
// as "" for that row) so one malformed row can never abort the whole batch.
fn tpl_fill(template: string, rows: list) -> list
    return rows.map(fn(row) tpl_render_default(template, row, ""))
