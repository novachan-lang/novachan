// std/text/slug -- URL slug generation. LEAF -- imports NOTHING.
//
// Public API:
//   slugify(s: string) -> string
//     Lowercase; keep ASCII [a-z0-9]; every run of any OTHER character
//     (spaces, punctuation, non-ASCII bytes) becomes a SINGLE "-".
//     Strip leading and trailing "-". Empty input returns "".
//
// Design notes:
//   - We walk byte-by-byte via ord(char_at(s,i)).
//   - ASCII 'a'..'z' = 97..122, 'A'..'Z' = 65..90, '0'..'9' = 48..57.
//   - Uppercase letters are lowercased by adding 32 to the byte value.
//   - Every other byte value (including non-ASCII > 127) is a separator.
//   - Consecutive separator bytes collapse to a single "-" via a
//     pending_dash flag; the flag suppresses the dash at position 0 and
//     at the very end (trailing strip is handled by not flushing a pending
//     dash when there are no more kept characters after it).

fn slugify(s: string) -> string
    let n = len(s)
    if n == 0
        return ""
    let out = ""
    let pending_dash = 0
    for i in 0..n
        let b = ord(char_at(s, i))
        let kept = 0
        let emit = 0
        if b >= 97 and b <= 122
            // already lowercase letter
            kept = 1
            emit = b
        else
            if b >= 65 and b <= 90
                // uppercase letter -> lowercase
                kept = 1
                emit = b + 32
            else
                if b >= 48 and b <= 57
                    // digit
                    kept = 1
                    emit = b
        if kept == 1
            if pending_dash == 1 and len(out) > 0
                out += "-"
            pending_dash = 0
            out += chr(emit)
        else
            pending_dash = 1
    out
