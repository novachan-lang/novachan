// ============================================================================
// NOVA Standard Library — std/text/editops
// ============================================================================
// Edit operations: Levenshtein alignment + edit script between two strings.
//
// Public API:
//   eo_distance(a, b) -> int
//       Levenshtein edit distance: minimum insertions + deletions + substitutions
//       needed to transform string a into string b.
//
//   eo_ops(a, b) -> list
//       Returns a list of op dicts describing an optimal edit script from a to b.
//       Each dict has:
//         "op"   -> "match" | "sub" | "insert" | "delete"
//         "from" -> the character consumed from a ("" for "insert")
//         "to"   -> the character produced toward b ("" for "delete" and "match"
//                   from == to for "match"; the target char for "sub"/"insert")
//       Applying the ops in order reconstructs b from a exactly.
//
//   eo_apply(a, ops) -> string
//       Applies the edit script ops (produced by eo_ops) to string a, returning
//       the reconstructed target string b.
//       - "match"  : copy a's current character to output, advance in a.
//       - "sub"    : output ops["to"], advance in a (skip old char).
//       - "insert" : output ops["to"], do NOT advance in a.
//       - "delete" : advance in a, produce nothing.
//
// Algorithms:
//   eo_distance — two rolling-row DP; O(m*n) time, O(n) space.
//   eo_ops      — full (m+1)*(n+1) DP table (flat list, row-major) + backtrack;
//                 O(m*n) time and space.
//   eo_apply    — single pass over ops list; O(|ops|) time.
//
// Private helpers use the prefix _eo_ to avoid name collisions.
// ============================================================================

// ── eo_distance ──────────────────────────────────────────────────────────────

// eo_distance returns the Levenshtein distance between strings a and b.
// Two rolling rows (O(n) space). Identical to the classic DP:
//   dp[i][j] = min edits to turn a[0..i-1] into b[0..j-1]
fn eo_distance(a, b) -> int
    let m = len(a)
    let n = len(b)
    if m == 0
        return n
    if n == 0
        return m

    // prev[j] = cost to turn "" into b[0..j-1] = j insertions.
    let prev = [j for j in 0..(n + 1)]

    for i in 1..(m + 1)
        // Column 0: cost to turn a[0..i-1] into "" = i deletions.
        let curr = [i]
        let ca = ord(a[i - 1])
        for k in 1..(n + 1)
            let cb = ord(b[k - 1])
            let sub_cost = 1
            if ca == cb
                sub_cost = 0
            let del_val = prev[k] + 1
            let ins_val = curr[k - 1] + 1
            let rep_val = prev[k - 1] + sub_cost
            let best = del_val
            if ins_val < best
                best = ins_val
            if rep_val < best
                best = rep_val
            push(curr, best)
        prev = curr
    prev[n]

// ── eo_ops helpers ────────────────────────────────────────────────────────────

// _eo_idx returns the flat index for row r, column c in a table with (n+1) cols.
fn _eo_idx(r, c, ncols) -> int
    r * ncols + c

// _eo_make_op builds one op dict for an edit operation.
//   op_name : "match" | "sub" | "insert" | "delete"
//   from_ch : character from a (empty string for "insert")
//   to_ch   : character toward b (empty string for "delete"; same as from_ch for "match")
fn _eo_make_op(op_name, from_ch, to_ch)
    let d = {}
    d["op"] = op_name
    d["from"] = from_ch
    d["to"] = to_ch
    d

// ── eo_ops ────────────────────────────────────────────────────────────────────

// eo_ops returns a list of edit-operation dicts transforming a into b.
// Strategy:
//   1. Build the full (m+1)*(n+1) DP cost table (flat row-major list).
//   2. Backtrack from dp[m][n] to dp[0][0], collecting ops in reverse.
//   3. Reverse the collected ops list to get forward order.
fn eo_ops(a, b)
    let m = len(a)
    let n = len(b)
    let ncols = n + 1

    // ── Step 1: fill DP table ──────────────────────────────────────────────────
    // dp[i*(n+1)+j] = min edits to turn a[0..i-1] into b[0..j-1].

    // Row 0: dp[0][j] = j (insert j chars from b).
    let dp = [j for j in 0..(n + 1)]

    for i in 1..(m + 1)
        // Column 0: dp[i][0] = i (delete i chars from a).
        push(dp, i)
        let ca = ord(a[i - 1])
        for k in 1..(n + 1)
            let cb = ord(b[k - 1])
            let sub_cost = 1
            if ca == cb
                sub_cost = 0
            let d_del = dp[_eo_idx(i - 1, k, ncols)] + 1
            let d_ins = dp[_eo_idx(i, k - 1, ncols)] + 1
            let d_rep = dp[_eo_idx(i - 1, k - 1, ncols)] + sub_cost
            let best = d_del
            if d_ins < best
                best = d_ins
            if d_rep < best
                best = d_rep
            push(dp, best)

    // ── Step 2: backtrack from (m,n) to (0,0) ─────────────────────────────────
    // At each cell (bi, bj):
    //   - If a[bi-1] == b[bj-1] and we came from diag: "match"
    //   - If we came from diag (cost == dp[bi-1][bj-1] + 1): "sub"
    //   - If we came from above (bi-1, bj): "delete" (consumed a char from a)
    //   - If we came from left  (bi, bj-1): "insert" (produced a char from b)
    // Tie-breaking: prefer diagonal (sub/match) > delete > insert. This
    // produces compact scripts where substitutions are preferred over
    // separate delete+insert pairs.
    let rev_ops = []
    let bi = m
    let bj = n
    let done = 0
    while done == 0
        if bi == 0 and bj == 0
            done = 1
        else
            if bi > 0 and bj > 0
                let ca2 = ord(a[bi - 1])
                let cb2 = ord(b[bj - 1])
                let cost_diag = dp[_eo_idx(bi - 1, bj - 1, ncols)]
                let cost_here = dp[_eo_idx(bi, bj, ncols)]
                if ca2 == cb2 and cost_diag == cost_here
                    // match: no cost paid, came from diagonal
                    let op = _eo_make_op("match", a[bi - 1], b[bj - 1])
                    rev_ops.push(op)
                    bi -= 1
                    bj -= 1
                else
                    // Check diagonal sub: cost_here == cost_diag + 1
                    let came_diag = 0
                    if cost_here == cost_diag + 1
                        came_diag = 1
                    if came_diag == 1
                        let op2 = _eo_make_op("sub", a[bi - 1], b[bj - 1])
                        rev_ops.push(op2)
                        bi -= 1
                        bj -= 1
                    else
                        // Check delete (from above: bi-1, bj)
                        let cost_above = dp[_eo_idx(bi - 1, bj, ncols)]
                        let came_above = 0
                        if cost_here == cost_above + 1
                            came_above = 1
                        if came_above == 1
                            let op3 = _eo_make_op("delete", a[bi - 1], "")
                            rev_ops.push(op3)
                            bi -= 1
                        else
                            // Insert (from left: bi, bj-1)
                            let op4 = _eo_make_op("insert", "", b[bj - 1])
                            rev_ops.push(op4)
                            bj -= 1
            else
                if bi > 0
                    // Only rows remain: delete remaining a chars
                    let op5 = _eo_make_op("delete", a[bi - 1], "")
                    rev_ops.push(op5)
                    bi -= 1
                else
                    // Only columns remain: insert remaining b chars
                    let op6 = _eo_make_op("insert", "", b[bj - 1])
                    rev_ops.push(op6)
                    bj -= 1

    // ── Step 3: reverse rev_ops to get forward order ──────────────────────────
    reverse(rev_ops)

// ── eo_apply ─────────────────────────────────────────────────────────────────

// eo_apply applies the edit script ops (from eo_ops(a, b)) to string a,
// producing the reconstructed string b.
//   "match"  : copy a[ai] to output, advance ai.
//   "sub"    : copy ops[i]["to"] to output, advance ai.
//   "insert" : copy ops[i]["to"] to output, do NOT advance ai.
//   "delete" : advance ai only, produce nothing.
fn eo_apply(a, ops) -> string
    let pieces = []
    let ai = 0
    for oi in 0..len(ops)
        let op = ops[oi]
        let kind = op["op"]
        if kind == "match"
            push(pieces, a[ai])
            ai += 1
        else
            if kind == "sub"
                push(pieces, op["to"])
                ai += 1
            else
                if kind == "insert"
                    push(pieces, op["to"])
                else
                    // "delete": advance source, produce nothing
                    ai += 1
    join(pieces, "")

// ============================================================================
fn main()
    print("std/text/editops loaded")
