// ============================================================================
// NOVA Standard Library — std/text/kmp
// ============================================================================
// Knuth-Morris-Pratt (KMP) substring search. All functions are pure: no
// side effects, no I/O, no imports. Operates on raw byte values via
// ord(s[i]) / char_at or slice.
//
// Public API:
//   km_failure(pat)              -> list  LPS (longest-proper-prefix-suffix)
//                                         failure function; length == len(pat)
//   km_search(text, pat)         -> int   index of first occurrence of pat in
//                                         text; -1 if absent; 0 for empty pat
//   km_search_all(text, pat)     -> list  all start indices (overlapping allowed)
//   km_count(text, pat)          -> int   count of overlapping occurrences
//
// Complexity:
//   km_failure    — O(m)  where m = len(pat)
//   km_search     — O(n + m)  where n = len(text)
//   km_search_all — O(n + m)  (KMP scan; each match restarts at fail[k-1])
//   km_count      — O(n + m)  (same scan, just counts instead of collecting)
//
// Private helpers are prefixed _km_ to avoid collisions with other modules.
// ============================================================================

// ── _km_fail_idx ─────────────────────────────────────────────────────────────
// Safe read from the failure list: returns fail[idx].
// Separated so the inner loops can read without re-indexing ambiguity.
fn _km_fail_idx(fail, idx) -> int
    fail[idx]

// ── km_failure ────────────────────────────────────────────────────────────────
// km_failure builds the LPS (Longest Proper Prefix that is also a Suffix)
// failure function for pat and returns it as a list of ints.
//
// Algorithm:
//   fail[0] = 0  (single character has no proper prefix/suffix)
//   Scan i from 1 to m-1.  Maintain k = length of the current best matching
//   prefix border.  At each step:
//     - while k > 0 and pat[i] != pat[k]: fall back via k = fail[k-1]
//     - if pat[i] == pat[k]: k++
//     - fail[i] = k
//
// Because fail[i] is written exactly once for each i (in ascending order) we
// build the result list by push()ing one value per iteration.
fn km_failure(pat) -> list
    let m = len(pat)
    let fail = [0]
    if m == 0
        return fail
    let k = 0
    let i = 1
    while i < m
        // Fall back through the border chain while pat[i] != pat[k].
        // Use a done flag to avoid '&&' in the while condition.
        let done = 0
        while done == 0
            if k == 0
                done = 1
            else
                let ci = ord(slice(pat, i, i + 1))
                let ck = ord(slice(pat, k, k + 1))
                if ci == ck
                    done = 1
                else
                    k = _km_fail_idx(fail, k - 1)
        // Check whether we can extend the border.
        let ci2 = ord(slice(pat, i, i + 1))
        let ck2 = ord(slice(pat, k, k + 1))
        if ci2 == ck2
            k = k + 1
        fail.push(k)
        i = i + 1
    fail

// ── km_search ─────────────────────────────────────────────────────────────────
// km_search returns the start index of the FIRST occurrence of pat in text,
// or -1 if pat does not appear in text.  Returns 0 for an empty pattern
// (matches at the very beginning by convention, consistent with Python's
// str.find("", ...) == 0).
//
// Algorithm:
//   Build fail = km_failure(pat).
//   Scan text with index i (0..n-1), maintaining k = number of pattern
//   characters matched so far.
//     - while k > 0 and text[i] != pat[k]: k = fail[k-1]
//     - if text[i] == pat[k]: k++
//     - if k == m: match found at i - m + 1; return immediately.
fn km_search(text, pat) -> int
    let m = len(pat)
    if m == 0
        return 0
    let n = len(text)
    if n == 0
        return -1
    let fail = km_failure(pat)
    let k = 0
    let i = 0
    let result = -1
    while i < n and result == -1
        // Fall-back loop: use done flag (no '&&' in while condition).
        let done = 0
        while done == 0
            if k == 0
                done = 1
            else
                let ci = ord(slice(text, i, i + 1))
                let ck = ord(slice(pat,  k, k + 1))
                if ci == ck
                    done = 1
                else
                    k = _km_fail_idx(fail, k - 1)
        // Try to extend the match.
        let ci2 = ord(slice(text, i, i + 1))
        let ck2 = ord(slice(pat,  k, k + 1))
        if ci2 == ck2
            k = k + 1
        if k == m
            result = i - m + 1
        i = i + 1
    result

// ── km_search_all ─────────────────────────────────────────────────────────────
// km_search_all returns a list of ALL start indices where pat appears in text,
// including overlapping occurrences.  Returns [] if pat is absent.
// For an empty pattern returns [0] (single match at the start).
//
// After each match we reset k = fail[k-1] instead of k = 0 so that overlapping
// occurrences are found (e.g. "aa" in "aaaa" yields [0, 1, 2]).
fn km_search_all(text, pat) -> list
    let m = len(pat)
    let result = []
    if m == 0
        result.push(0)
        return result
    let n = len(text)
    if n == 0
        return result
    let fail = km_failure(pat)
    let k = 0
    for i in 0..n
        // Fall-back loop.
        let done = 0
        while done == 0
            if k == 0
                done = 1
            else
                let ci = ord(slice(text, i, i + 1))
                let ck = ord(slice(pat,  k, k + 1))
                if ci == ck
                    done = 1
                else
                    k = _km_fail_idx(fail, k - 1)
        // Try to extend.
        let ci2 = ord(slice(text, i, i + 1))
        let ck2 = ord(slice(pat,  k, k + 1))
        if ci2 == ck2
            k = k + 1
        if k == m
            result.push(i - m + 1)
            // Reset to allow overlapping matches.
            k = _km_fail_idx(fail, k - 1)
    result

// ── km_count ─────────────────────────────────────────────────────────────────
// km_count returns the number of (possibly overlapping) occurrences of pat in
// text.  Equivalent to len(km_search_all(text, pat)) but without building the
// index list.
fn km_count(text, pat) -> int
    let m = len(pat)
    if m == 0
        return 1
    let n = len(text)
    if n == 0
        return 0
    let fail = km_failure(pat)
    let k = 0
    let i = 0
    let count = 0
    while i < n
        // Fall-back loop.
        let done = 0
        while done == 0
            if k == 0
                done = 1
            else
                let ci = ord(slice(text, i, i + 1))
                let ck = ord(slice(pat,  k, k + 1))
                if ci == ck
                    done = 1
                else
                    k = _km_fail_idx(fail, k - 1)
        // Try to extend.
        let ci2 = ord(slice(text, i, i + 1))
        let ck2 = ord(slice(pat,  k, k + 1))
        if ci2 == ck2
            k = k + 1
        if k == m
            count = count + 1
            k = _km_fail_idx(fail, k - 1)
        i = i + 1
    count

// ============================================================================
fn main()
    print("std/text/kmp loaded")
