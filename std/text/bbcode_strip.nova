// ============================================================================
// NOVA Standard Library — std/text/bbcode_strip
// ============================================================================
// Strip BBCode markup down to plain text.
//
// Public API:
//   bstr_strip(input: string) -> string       Strip a raw BBCode string.
//   bstr_strip_ast(nodes: list) -> string      Extract text from an already-
//                                              parsed AST (std/text/bbcode_parse
//                                              node list).
//
// bstr_strip is intentionally implemented as bstr_strip_ast(bpar_parse(...))
// rather than a cheaper "skip every [tag] token" lexer-only pass. The
// difference matters at the edges: bbcode_parse already decides, via its
// mismatch-recovery rules, which brackets are REAL markup (a matched
// [b]..[/b] pair -- its brackets are markup and must vanish) versus which are
// just literal text that merely LOOKS like a tag (an unclosed "[b]" with no
// closing tag, or a stray "[/b]" with no opener -- bbcode_parse turns both
// back into literal text nodes). A naive strip that dropped every "open"/
// "close" token unconditionally would silently eat those literal brackets
// too, which is wrong: what a BBCode renderer actually DISPLAYS for
// unmatched markup is the bracket text itself. Reusing the parser's AST
// means bstr_strip and any future bstr_to_html/bstr_to_text style module
// agree, by construction, on what counts as "real" markup.
//
// IMPORTS: std/text/bbcode_lex, std/text/bbcode_parse
// ============================================================================

import std/text/bbcode_lex
import std/text/bbcode_parse

// PRIVATE: extract the text of one AST node (see bbcode_parse.nova for the
// node shapes ["text", content] / ["tag", name, attr, children]). Defensive
// against anything that is not a well-formed node of those two shapes --
// such input is skipped rather than crashing.
fn _bstr_node_text(node) -> string
    if type_of(node) != "list"
        return ""
    if len(node) < 2
        return ""
    let kind = node[0]
    if kind == "text"
        return node[1]
    if kind == "tag" and len(node) >= 4
        return bstr_strip_ast(node[3])
    ""

// PUBLIC: concatenated plain text of a parsed AST node list, depth-first,
// left to right. Matched tag pairs contribute only their children's text
// (their own brackets vanish); text nodes contribute verbatim.
fn bstr_strip_ast(nodes: list) -> string
    let out = ""
    let n = len(nodes)
    let i = 0
    while i < n
        out = out + _bstr_node_text(nodes[i])
        i = i + 1
    out

// PUBLIC: strip all BBCode markup from `input`, returning plain text.
// Empty input returns "". Plain text with no tags at all is returned
// unchanged. Unmatched/malformed bracket text is preserved verbatim (see
// module header) rather than eaten.
fn bstr_strip(input: string) -> string
    bstr_strip_ast(bpar_parse(blex_tokenize(input)))
