// std/text/md_hr -- Markdown horizontal rule -> HTML <hr> conversion. LEAF -- imports NOTHING.
//
// Public API:
//   is_hr(line: string) -> int
//     Returns 1 (true) if line is a Markdown thematic break, 0 otherwise.
//     Rules: the line must consist entirely of 3 or more of the SAME character
//     from the set {'-', '*', '_'}, optionally separated by spaces.
//     No other characters are permitted. Empty line = false.
//
//   md_hr(line: string) -> string
//     Returns "<hr>" if is_hr(line), else "" (empty string).

// PRIVATE: check if a single character is one of the three HR chars.
fn _mhr_is_hr_char(c: string) -> int
    if c == "-"
        return 1
    if c == "*"
        return 1
    if c == "_"
        return 1
    return 0

fn is_hr(line: string) -> int
    let n = len(line)
    if n == 0
        return 0
    // Determine the marker char: first non-space character
    let marker = ""
    let i = 0
    while i < n
        let c = slice(line, i, i + 1)
        if c != " "
            if _mhr_is_hr_char(c) == 0
                return 0
            marker = c
            i += 1
            // found marker — break out
            i = n + 1
        else
            i += 1
    if marker == ""
        return 0
    // Re-scan: every non-space char must equal marker; count them.
    let count = 0
    let j = 0
    while j < n
        let c = slice(line, j, j + 1)
        if c == " "
            j += 1
        else
            if c != marker
                return 0
            count += 1
            j += 1
    if count >= 3
        return 1
    return 0

fn md_hr(line: string) -> string
    if is_hr(line) == 1
        return "<hr>"
    return ""
