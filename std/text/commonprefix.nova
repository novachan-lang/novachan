// ============================================================================
// NOVA Standard Library — std/text/commonprefix
// ============================================================================
// Common-prefix and common-suffix utilities for lists of strings.
// Pure NOVA: uses only builtin string operations (len, slice, char_at).
// No new builtins required.
//
// Public API:
//   cp_longest(strings_list) -> str
//       Longest common prefix of all strings in the list.
//       Returns "" for empty list or no common prefix.
//
//   cp_longest_pair(a, b) -> str
//       Longest common prefix of exactly two strings.
//       Equivalent to cp_longest([a, b]) but avoids list allocation overhead.
//
//   cp_longest_suffix(strings_list) -> str
//       Longest common suffix of all strings in the list.
//       Returns "" for empty list or no common suffix.
//
// Algorithm:
//   cp_longest_pair: scan character by character until a mismatch or either
//   string is exhausted. O(n) where n = length of the shorter string.
//
//   cp_longest: initialise candidate from the first element, then intersect
//   with each remaining element via cp_longest_pair. A mismatch can only
//   shrink the candidate, so one left-to-right pass suffices. O(m*n) total
//   where m = number of strings, n = min string length — optimal for the
//   general case without a trie.
//
//   cp_longest_suffix: reverse each string, compute cp_longest, reverse the
//   result. Avoids duplicating the core loop.
//
// Private helpers use the prefix tag "_cpfx_" to avoid name collisions.

// Reverse a string character by character.
// Used internally to implement suffix as "reverse-prefix-reverse".
fn _cpfx_reverse(s) -> str
    let n = len(s)
    let out = ""
    let i = n - 1
    while i >= 0
        let ch = slice(s, i, i + 1)
        out = out + ch
        i = i - 1
    out

// Compute the longest common prefix of two strings a and b.
// Core primitive: O(min(len(a), len(b))).
fn cp_longest_pair(a, b) -> str
    let na = len(a)
    let nb = len(b)
    let limit = na
    if nb < na
        limit = nb
    let i = 0
    let done = 0
    while i < limit and done == 0
        let ca = slice(a, i, i + 1)
        let cb = slice(b, i, i + 1)
        if ca == cb
            i = i + 1
        else
            done = 1
    slice(a, 0, i)

// Compute the longest common prefix of all strings in the list.
// Returns "" for an empty list.
fn cp_longest(strings_list) -> str
    let n = len(strings_list)
    if n == 0
        return ""
    let prefix = strings_list[0]
    let i = 1
    while i < n
        let s = strings_list[i]
        prefix = cp_longest_pair(prefix, s)
        if len(prefix) == 0
            return ""
        i = i + 1
    prefix

// Compute the longest common suffix of all strings in the list.
// Returns "" for an empty list.
fn cp_longest_suffix(strings_list) -> str
    let n = len(strings_list)
    if n == 0
        return ""
    let reversed = []
    let i = 0
    while i < n
        let s = strings_list[i]
        reversed.push(_cpfx_reverse(s))
        i = i + 1
    let rev_prefix = cp_longest(reversed)
    _cpfx_reverse(rev_prefix)
