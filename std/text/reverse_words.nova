// ============================================================================
// NOVA Standard Library — reverse_words module
// ============================================================================
// Word-level and character-level reversal utilities. "Words" are sequences of
// non-space bytes separated by one or more ASCII space characters (0x20).
// Leading/trailing spaces and runs of multiple spaces are collapsed: the
// output always uses a single space between words with no leading/trailing
// space.
//
// Public API:
//   rw_reverse_words(s)  -> str   words in reverse order, single-space separated
//   rw_reverse_each(s)   -> str   letters within each word reversed, word order kept
//   rw_reverse_string(s) -> str   every character reversed (full string reversal)

// Split s on spaces, collect non-empty tokens into a list.
// split(s, " ") produces empty tokens for leading/trailing/consecutive spaces;
// we filter those out so the output has no leading/trailing space.
fn _words(s) -> list
    let parts = split(s, " ")
    let out = []
    let i = 0
    let n = len(parts)
    while i < n
        let w = parts[i]
        if len(w) > 0
            out = out + [w]
        i = i + 1
    out

// Join a list of strings with a single space between each element.
fn _join_space(words) -> str
    let out = ""
    let i = 0
    let n = len(words)
    while i < n
        if i > 0
            out = out + " "
        out = out + words[i]
        i = i + 1
    out

// Reverse every character in a single word (string).
fn _rev_chars(w) -> str
    let n = len(w)
    let out = ""
    let i = n - 1
    while i >= 0
        out = out + w[i]
        i = i - 1
    out

// ── Public API ────────────────────────────────────────────────────────────────

// Return the words of s in reverse order, collapsed to a single-space-separated
// string. Leading/trailing/multiple spaces in s are collapsed.
// rw_reverse_words("the quick brown fox") = "fox brown quick the"
// rw_reverse_words("  a  b ")            = "b a"
// rw_reverse_words("single")             = "single"
// rw_reverse_words("")                   = ""
fn rw_reverse_words(s) -> str
    let words = _words(s)
    let rev = list_reverse(words)
    _join_space(rev)

// Return s with the characters within each word reversed, keeping word order.
// Multiple spaces are collapsed (same tokenisation as rw_reverse_words).
// rw_reverse_each("hello world") = "olleh dlrow"
fn rw_reverse_each(s) -> str
    let words = _words(s)
    let out = []
    let i = 0
    let n = len(words)
    while i < n
        out = out + [_rev_chars(words[i])]
        i = i + 1
    _join_space(out)

// Return s with all characters in reverse order.
// rw_reverse_string("abc") = "cba"
// rw_reverse_string("")    = ""
fn rw_reverse_string(s) -> str
    _rev_chars(s)
