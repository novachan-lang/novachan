// ============================================================================
// NOVA Standard Library — std/text/md_escape
// ============================================================================
// HTML character escaping for Markdown-to-HTML conversion.
//
// Public API:
//   md_escape(s) -> str   Escape HTML special characters in s.
//
// Escaping rules (order matters — & must be escaped first):
//   &  ->  &amp;
//   <  ->  &lt;
//   >  ->  &gt;
//   "  ->  &quot;   (chr(34))
//
// The & replacement must happen first to avoid double-escaping already-escaped
// sequences (e.g., if < were replaced first, the resulting &lt; would have its
// & re-escaped to &amp;lt;).
// ============================================================================

// Escape HTML special characters in s.
// Order: & first, then <, >, chr(34).
fn md_escape(s) -> str
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = s[i]
        if c == "&"
            out = out + "&amp;"
        else
            if c == "<"
                out = out + "&lt;"
            else
                if c == ">"
                    out = out + "&gt;"
                else
                    if ord(c) == 34
                        out = out + "&quot;"
                    else
                        out = out + c
        i = i + 1
    out
