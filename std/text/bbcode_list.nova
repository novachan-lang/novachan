// ============================================================================
// NOVA Standard Library — std/text/bbcode_list
// ============================================================================
// Parse and build BBCode [list] blocks: [list][*]A[*]B[/list].
//
// Recognised opening forms: "[list]" (unordered) and "[list=VALUE]"
// (ordered/typed, e.g. "[list=1]" or "[list=a]"). Closing form: "[/list]".
// Items are separated by the "[*]" marker. Tag matching is case-insensitive.
//
// Public API:
//   blst_extract_items(input) -> list
//       Find the first "[list]"/"[list=VALUE]" tag, then the next "[/list]"
//       after it (if no "[/list]" is found, the content runs to the end of
//       input). Split the content between them on "[*]" and return the
//       trimmed item strings (the text before the first "[*]" is discarded
//       preamble, not an item). Returns [] if no "[list...]" tag is found.
//
//   blst_build(items) -> string
//       Build "[list][*]item1[*]item2...[/list]" from a list of strings.
//
//   blst_ordered_build(items) -> string
//       Build "[list=1][*]item1[*]item2...[/list]" from a list of strings.
//
//   blst_count_items(input) -> int
//       Count non-overlapping occurrences of the "[*]" marker anywhere in
//       input.
//
//   blst_is_ordered(input) -> int
//       1 if the first "[list...]" tag in input carries a "=" attribute
//       (e.g. "[list=1]" or "[list=a]"), 0 if it is a bare "[list]" tag or
//       no "[list...]" tag is present.
//
// LEAF — imports NOTHING.
// ============================================================================

// _blst_starts_ci: 1 if s has tag_lower (already lowercase) at position i,
// compared case-insensitively; 0 if out of range or not matching.
fn _blst_starts_ci(s, i, tag_lower) -> int
    let tlen = len(tag_lower)
    if i + tlen > len(s)
        return 0
    if lower(slice(s, i, i + tlen)) == tag_lower
        return 1
    0

// _blst_open_len: if s has an opening "[list]" or "[list=...]" tag at
// position i, return the tag's total length (including brackets);
// otherwise return 0.
fn _blst_open_len(s, i) -> int
    let n = len(s)
    if _blst_starts_ci(s, i, "[list") == 0
        return 0
    let after = i + 5
    if after >= n
        return 0
    let c = slice(s, after, after + 1)
    if c == "]"
        return after + 1 - i
    if c == "="
        let rest = slice(s, after + 1, n)
        let j = find(rest, "]")
        if j < 0
            return 0
        return after + 1 + j + 1 - i
    0

// _blst_find_close: index of the next case-insensitive "[/list]" at or
// after position from, or -1 if none.
fn _blst_find_close(s, from) -> int
    let n = len(s)
    let i = from
    let result = -1
    while i < n and result == -1
        if _blst_starts_ci(s, i, "[/list]")
            result = i
        i = i + 1
    result

// blst_extract_items(input) -> list
fn blst_extract_items(input) -> list
    let out = []
    let n = len(input)
    let i = 0
    let content_start = -1
    while i < n and content_start == -1
        let ol = _blst_open_len(input, i)
        if ol > 0
            content_start = i + ol
        else
            i = i + 1
    if content_start == -1
        return out
    let close_idx = _blst_find_close(input, content_start)
    let content_end = n
    if close_idx >= 0
        content_end = close_idx
    let content = slice(input, content_start, content_end)
    let parts = split(content, "[*]")
    let pn = len(parts)
    for k in 1..pn
        push(out, trim(parts[k]))
    out

// blst_build(items) -> string
fn blst_build(items) -> string
    let out = "[list]"
    let n = len(items)
    for i in 0..n
        out = out + "[*]" + items[i]
    out + "[/list]"

// blst_ordered_build(items) -> string
fn blst_ordered_build(items) -> string
    let out = "[list=1]"
    let n = len(items)
    for i in 0..n
        out = out + "[*]" + items[i]
    out + "[/list]"

// blst_count_items(input) -> int
fn blst_count_items(input) -> int
    let sub = "[*]"
    let sublen = len(sub)
    let count = 0
    let pos = 0
    let n = len(input)
    while pos <= n - sublen
        let rest = slice(input, pos, n)
        let idx = find(rest, sub)
        if idx < 0
            return count
        count = count + 1
        pos = pos + idx + sublen
    count

// blst_is_ordered(input) -> int
fn blst_is_ordered(input) -> int
    let n = len(input)
    for i in 0..n
        let ol = _blst_open_len(input, i)
        if ol > 0
            let after = i + 5
            let c = slice(input, after, after + 1)
            if c == "="
                return 1
            return 0
    0
