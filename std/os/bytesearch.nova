// std/os/bytesearch — Byte-list search utilities. Pure NOVA.
//
// bytes_find(hay, needle) -> int   first index of needle in hay, -1 if absent (KMP)
// bytes_contains(hay, needle) -> bool
// bytes_replace(hay, needle, repl) -> list   replace ALL non-overlapping occurrences
// bytes_split(hay, sep) -> list              split on sep (list of byte-lists)
// bytes_count(hay, needle) -> int            count non-overlapping occurrences

// _bs_kmp_table: build KMP failure function for needle
fn _bs_kmp_table(needle: any) -> any
    let n = len(needle)
    let table = []
    let i = 0
    while i < n
        push(table, 0)
        i = i + 1
    if n == 0
        return table
    // table[0] = 0 always
    let k = 0
    let pos = 1
    while pos < n
        if needle[pos] == needle[k]
            k = k + 1
            table[pos] = k
            pos = pos + 1
        else
            if k != 0
                k = table[k - 1]
            else
                table[pos] = 0
                pos = pos + 1
    return table

// bytes_find: first index of needle in hay via KMP; -1 if absent
fn bytes_find(hay: any, needle: any) -> int
    let hn = len(hay)
    let nn = len(needle)
    if nn == 0
        return 0
    if nn > hn
        return -1
    let table = _bs_kmp_table(needle)
    let i = 0
    let k = 0
    let result = -1
    let done = 0
    while i < hn and done == 0
        if hay[i] == needle[k]
            i = i + 1
            k = k + 1
            if k == nn
                result = i - nn
                done = 1
        else
            if k != 0
                k = table[k - 1]
            else
                i = i + 1
    return result

// bytes_contains: true if needle appears in hay
fn bytes_contains(hay: any, needle: any) -> bool
    let idx = bytes_find(hay, needle)
    if idx >= 0
        return true
    return false

// bytes_replace: replace all non-overlapping occurrences of needle with repl
fn bytes_replace(hay: any, needle: any, repl: any) -> any
    let hn = len(hay)
    let nn = len(needle)
    let rn = len(repl)
    let out = []
    if nn == 0
        // Empty needle: return copy of hay
        let ci = 0
        while ci < hn
            push(out, hay[ci])
            ci = ci + 1
        return out
    let pos = 0
    while pos < hn
        let idx = -1
        // Search for needle starting at pos
        let hi = pos
        let k = 0
        let found = 0
        while hi < hn and found == 0
            if hay[hi] == needle[k]
                hi = hi + 1
                k = k + 1
                if k == nn
                    idx = hi - nn
                    found = 1
            else
                if k != 0
                    let table = _bs_kmp_table(needle)
                    k = table[k - 1]
                else
                    hi = hi + 1
        if idx >= 0 and idx >= pos
            // Copy bytes from pos to idx
            let ci2 = pos
            while ci2 < idx
                push(out, hay[ci2])
                ci2 = ci2 + 1
            // Append replacement
            let ri = 0
            while ri < rn
                push(out, repl[ri])
                ri = ri + 1
            pos = idx + nn
        else
            // No more matches: copy rest
            let ci3 = pos
            while ci3 < hn
                push(out, hay[ci3])
                ci3 = ci3 + 1
            pos = hn
    return out

// bytes_split: split hay on sep, returns list of byte-lists
fn bytes_split(hay: any, sep: any) -> any
    let hn = len(hay)
    let sn = len(sep)
    let parts = []
    if sn == 0
        // Split on every byte
        let i = 0
        while i < hn
            let part = [hay[i]]
            push(parts, part)
            i = i + 1
        return parts
    let pos = 0
    let done = 0
    while done == 0
        let idx = -1
        let hi = pos
        let k = 0
        let found = 0
        while hi < hn and found == 0
            if hay[hi] == sep[k]
                hi = hi + 1
                k = k + 1
                if k == sn
                    idx = hi - sn
                    found = 1
            else
                if k != 0
                    let table = _bs_kmp_table(sep)
                    k = table[k - 1]
                else
                    hi = hi + 1
        if idx >= 0
            // Extract part from pos to idx
            let part = []
            let ci = pos
            while ci < idx
                push(part, hay[ci])
                ci = ci + 1
            push(parts, part)
            pos = idx + sn
        else
            // Last part: pos to end
            let part2 = []
            let ci2 = pos
            while ci2 < hn
                push(part2, hay[ci2])
                ci2 = ci2 + 1
            push(parts, part2)
            done = 1
    return parts

// bytes_count: count non-overlapping occurrences of needle in hay
fn bytes_count(hay: any, needle: any) -> int
    let hn = len(hay)
    let nn = len(needle)
    if nn == 0
        return 0
    let count = 0
    let pos = 0
    while pos <= hn - nn
        // Search from pos
        let hi = pos
        let k = 0
        let found = 0
        let idx = -1
        let table = _bs_kmp_table(needle)
        while hi < hn and found == 0
            if hay[hi] == needle[k]
                hi = hi + 1
                k = k + 1
                if k == nn
                    idx = hi - nn
                    found = 1
            else
                if k != 0
                    k = table[k - 1]
                else
                    hi = hi + 1
        if idx >= 0
            count = count + 1
            pos = idx + nn
        else
            pos = hn
    return count
