// std/os/termctl — Terminal control: size lookup (best-effort) + ANSI escape sequences.
//
// API:
//   tc_width()               -> int      COLUMNS env var if set and numeric, else 80
//   tc_height()               -> int      LINES env var if set and numeric, else 24
//   tc_clear_screen()        -> string   ANSI: clear screen + move cursor to home
//   tc_move_cursor(row, col) -> string   ANSI: move cursor to 1-based (row, col)
//   tc_hide_cursor()         -> string   ANSI: hide cursor
//   tc_show_cursor()         -> string   ANSI: show cursor
//   tc_set_title(title)      -> string   ANSI/OSC: set terminal window title
//
// NOVA has no direct terminal-size ioctl builtin, so width/height are read from the
// conventional COLUMNS/LINES environment variables with sane defaults. All escape builders
// return the raw sequence as a string; callers write it (e.g. via a print/write_file to a
// terminal device) — this module performs no I/O itself.

// tc_width() -> int  COLUMNS env var if present and a valid positive integer, else 80.
fn tc_width() -> int
    let v = env("COLUMNS")
    if len(v) == 0
        return 80
    let n = parse_int(v)
    if n <= 0
        return 80
    return n

// tc_height() -> int  LINES env var if present and a valid positive integer, else 24.
fn tc_height() -> int
    let v = env("LINES")
    if len(v) == 0
        return 24
    let n = parse_int(v)
    if n <= 0
        return 24
    return n

// tc_clear_screen() -> string  ANSI "clear entire screen, move cursor to home (1,1)".
fn tc_clear_screen() -> string
    return chr(27) + "[2J" + chr(27) + "[H"

// tc_move_cursor(row, col) -> string  ANSI "move cursor to 1-based (row, col)".
fn tc_move_cursor(row: int, col: int) -> string
    return chr(27) + "[" + str(row) + ";" + str(col) + "H"

// tc_hide_cursor() -> string  ANSI "hide the text cursor".
fn tc_hide_cursor() -> string
    return chr(27) + "[?25l"

// tc_show_cursor() -> string  ANSI "show the text cursor".
fn tc_show_cursor() -> string
    return chr(27) + "[?25h"

// tc_set_title(title) -> string  OSC 0 sequence to set the terminal window title.
fn tc_set_title(title: string) -> string
    return chr(27) + "]0;" + title + chr(7)
