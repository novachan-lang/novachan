// std/os/treeprint — Render a directory/file tree using box-drawing connectors (├── / └──).
//
// API:
//   tp_tree(entries)       -> string   render a flat list of "/"-delimited path strings
//                                      ("a/b/c.txt") as a nested tree
//   tp_indent(level)       -> string   plain 4-space indentation for `level` levels (a
//                                      standalone utility, independent of tp_tree's connectors)
//   tp_from_dir(path)      -> string   walk the real filesystem under `path` and render it as
//                                      a tree (root line = path, then its contents, recursively,
//                                      entries at each level sorted for determinism)
//
// Tree structure is built explicitly as name/children nodes (not via a dict's iteration order,
// which NOVA does not guarantee to match insertion order) so rendering is always deterministic
// and matches insertion/scan order exactly. Private helpers prefixed _tp_.

// Find an existing child named `name` under `node`; null if none.
fn _tp_find_child(node: any, name: string) -> any
    let children = node["children"]
    for i in 0..len(children)
        if children[i]["name"] == name
            return children[i]
    return null

// Return the child named `name` under `node`, creating it (with no children yet) if absent.
fn _tp_get_or_create_child(node: any, name: string) -> any
    let existing = _tp_find_child(node, name)
    if existing != null
        return existing
    let child = {}
    child["name"] = name
    child["children"] = []
    push(node["children"], child)
    return child

// Build a name/children tree from a flat list of "/"-delimited path strings.
fn _tp_build_tree(entries: any) -> any
    let root = {}
    root["name"] = ""
    root["children"] = []
    for i in 0..len(entries)
        let segs = split(entries[i], "/")
        let cur = root
        let j = 0
        while j < len(segs)
            let seg = segs[j]
            if len(seg) > 0
                cur = _tp_get_or_create_child(cur, seg)
            j += 1
    return root

// Append rendered lines for `node`'s children (not node itself) into `out`, using `prefix`
// as the accumulated indentation/continuation-bar text for this depth.
fn _tp_render(node: any, prefix: string, out: any)
    let children = node["children"]
    let n = len(children)
    for i in 0..n
        let child = children[i]
        let is_last = i == n - 1
        let connector = "├── "
        let child_prefix = prefix + "│   "
        if is_last
            connector = "└── "
            child_prefix = prefix + "    "
        push(out, prefix + connector + child["name"])
        _tp_render(child, child_prefix, out)

// tp_tree(entries) -> string
fn tp_tree(entries: any) -> string
    let root = _tp_build_tree(entries)
    let lines = []
    _tp_render(root, "", lines)
    return join(lines, chr(10))

// tp_indent(level) -> string  plain 4-space indent, independent of the box-drawing connectors.
fn tp_indent(level: int) -> string
    let out_parts = []
    for i in 0..level
        push(out_parts, "    ")
    let out = join(out_parts, "")
    return out

// Join a directory and an entry name with a single "/".
fn _tp_join(dir: string, name: string) -> string
    if len(dir) == 0
        return name
    if char_at(dir, len(dir) - 1) == "/" or char_at(dir, len(dir) - 1) == "\\"
        return dir + name
    return dir + "/" + name

// Build a name/children node from the real filesystem, recursing into subdirectories.
// Entries at each level are sorted so output is deterministic across platforms/filesystems.
fn _tp_dir_node(path: string, name: string) -> any
    let node = {}
    node["name"] = name
    node["children"] = []
    if is_dir(path)
        let names = sort(list_dir(path))
        for i in 0..len(names)
            let child_name = names[i]
            push(node["children"], _tp_dir_node(_tp_join(path, child_name), child_name))
    return node

// tp_from_dir(path) -> string
fn tp_from_dir(path: string) -> string
    let root = _tp_dir_node(path, path)
    let lines = []
    _tp_render(root, "", lines)
    if len(lines) == 0
        return root["name"]
    return root["name"] + chr(10) + join(lines, chr(10))
