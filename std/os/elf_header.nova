// std/os/elf_header — ELF object/executable header parser. Pure NOVA.
//
// Parses the ELF header from a buffer (list of ints 0..255).
// Supports both 32-bit and 64-bit ELF, little-endian and big-endian.

// _u16le: read unsigned 16-bit little-endian int from buffer b at offset p
fn _u16le(b: any, p: int) -> int
    if len(b) < p + 2
        return 0
    return b[p] + b[p+1]*256

// _u16be: read unsigned 16-bit big-endian int from buffer b at offset p
fn _u16be(b: any, p: int) -> int
    if len(b) < p + 2
        return 0
    return b[p]*256 + b[p+1]

// _u32le: read unsigned 32-bit little-endian int from buffer b at offset p
fn _u32le(b: any, p: int) -> int
    if len(b) < p + 4
        return 0
    return b[p] + b[p+1]*256 + b[p+2]*65536 + b[p+3]*16777216

// _u32be: read unsigned 32-bit big-endian int from buffer b at offset p
fn _u32be(b: any, p: int) -> int
    if len(b) < p + 4
        return 0
    return b[p]*16777216 + b[p+1]*65536 + b[p+2]*256 + b[p+3]

// elf_magic_check: return true if buffer starts with ELF magic bytes 0x7F,'E','L','F'
fn elf_magic_check(buf: any) -> bool
    if len(buf) < 4
        return false
    if buf[0] != 127
        return false
    if buf[1] != 69
        return false
    if buf[2] != 76
        return false
    if buf[3] != 70
        return false
    return true

// elf_ei_class: return EI_CLASS byte (offset 4): 1=ELF32, 2=ELF64
fn elf_ei_class(buf: any) -> int
    if len(buf) < 5
        return 0
    return buf[4]

// elf_ei_data: return EI_DATA byte (offset 5): 1=LE, 2=BE
fn elf_ei_data(buf: any) -> int
    if len(buf) < 6
        return 0
    return buf[5]

// elf_is_64bit: return true if EI_CLASS == 2 (ELF64)
fn elf_is_64bit(buf: any) -> bool
    return elf_ei_class(buf) == 2

// elf_is_le: return true if EI_DATA == 1 (little-endian)
fn elf_is_le(buf: any) -> bool
    return elf_ei_data(buf) == 1

// elf_ei_osabi: return EI_OSABI byte (offset 7): 0=SysV, 3=Linux
fn elf_ei_osabi(buf: any) -> int
    if len(buf) < 8
        return 0
    return buf[7]

// elf_e_type: return e_type field (u16 at offset 16), respecting endianness
fn elf_e_type(buf: any) -> int
    if len(buf) < 18
        return 0
    if elf_ei_data(buf) == 2
        return _u16be(buf, 16)
    return _u16le(buf, 16)

// elf_e_machine: return e_machine field (u16 at offset 18), respecting endianness
fn elf_e_machine(buf: any) -> int
    if len(buf) < 20
        return 0
    if elf_ei_data(buf) == 2
        return _u16be(buf, 18)
    return _u16le(buf, 18)

// elf_e_entry_low32: return low 32 bits of e_entry (ELF64: u64 at offset 24, we read low 32 bits LE)
fn elf_e_entry_low32(buf: any) -> int
    if len(buf) < 28
        return 0
    if elf_ei_data(buf) == 2
        return _u32be(buf, 24)
    return _u32le(buf, 24)

// elf_class_name: return human-readable EI_CLASS string
fn elf_class_name(buf: any) -> string
    let c = elf_ei_class(buf)
    if c == 1
        return "ELF32"
    if c == 2
        return "ELF64"
    return "unknown"

// elf_machine_name: return human-readable e_machine string
fn elf_machine_name(buf: any) -> string
    let m = elf_e_machine(buf)
    if m == 62
        return "x86-64"
    if m == 3
        return "x86"
    if m == 40
        return "ARM"
    if m == 183
        return "AArch64"
    if m == 243
        return "RISC-V"
    return "unknown"

// elf_type_name: return human-readable e_type string
fn elf_type_name(buf: any) -> string
    let t = elf_e_type(buf)
    if t == 1
        return "REL"
    if t == 2
        return "EXEC"
    if t == 3
        return "DYN"
    if t == 4
        return "CORE"
    return "unknown"
