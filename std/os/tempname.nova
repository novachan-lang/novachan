// std/os/tempname — Deterministic temp-name generation (no filesystem). Pure NOVA.
//
// WHAT:
//   temp_name(seed, prefix, ext)  -> string   prefix + base36 hash of seed + ext; deterministic
//   temp_name_n(seed, n)          -> list      n distinct names (prefixed "tmp", no ext)
//   is_safe_name(s)               -> bool      no path separators, no "..", non-empty
//
// Hash algorithm: a simple 64-bit mix of the seed (xor-shift / LCG style), encoded as base36
// (digits 0-9, letters a-z).  Same seed always yields the same name.
//
// All helpers are prefixed _tn_ to avoid cross-module collisions.

// _tn_base36: encode a non-negative integer as a base-36 string (at least 8 chars, zero-padded).
fn _tn_base36(v: int) -> string
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    // Work on unsigned-equivalent by masking to 48 bits to stay positive
    let mask48 = 281474976710655
    let x = v
    if x < 0
        // fold negatives via bit-mask trick (keep lower 48 bits)
        x = (x & mask48)
    if x == 0
        return "00000000"
    let out = ""
    let remaining = x
    while remaining > 0
        let rem = remaining - (remaining / 36) * 36
        out = slice(digits, rem, rem + 1) + out
        remaining = remaining / 36
    // Zero-pad to at least 8 characters
    while len(out) < 8
        out = "0" + out
    return out

// _tn_mix: mix a seed integer into a hash value using an xor-shift-like sequence.
// Produces a deterministic 48-bit-range non-negative integer.
fn _tn_mix(seed: int) -> int
    let a = seed * 6364136223846793005
    let b = a + 1442695040888963407
    // XOR-fold to keep value manageable (avoid sign issues)
    let mask = 281474976710655
    let c = (b & mask)
    if c < 0
        c = 0 - c
    return c

// temp_name: return prefix + base36(hash(seed)) + ext.  Deterministic: same seed -> same name.
fn temp_name(seed: int, prefix: string, ext: string) -> string
    let h = _tn_mix(seed)
    return prefix + _tn_base36(h) + ext

// temp_name_n: return n distinct temp names using seeds seed, seed+1, ..., seed+n-1.
// Uses prefix "tmp" and no extension.
fn temp_name_n(seed: int, n: int) -> any
    let names = []
    let i = 0
    while i < n
        let nm = temp_name(seed + i, "tmp", "")
        push(names, nm)
        i = i + 1
    return names

// is_safe_name: true iff s is non-empty and contains no path separators ('/', '\') and no "..".
fn is_safe_name(s: string) -> bool
    let n = len(s)
    if n == 0
        return false
    // Check for ".."
    if find(s, "..") >= 0
        return false
    // Check each character for / or backslash
    let i = 0
    while i < n
        let c = slice(s, i, i + 1)
        if c == "/"
            return false
        if c == "\\"
            return false
        i = i + 1
    return true
