// std/os/cpio -- cpio archive header parser (newc/SVR4 and odc formats).
//
// Two supported magic values:
//   newc (SVR4): "070701"  (bytes 48,55,48,55,48,49)
//   odc:         "070707"  (bytes 48,55,48,55,48,55)
//
// newc header layout at a given offset `pos`:
//   [pos+0  .. pos+5  ]  magic (6 bytes, ASCII)
//   [pos+6  .. pos+109]  13 fields x 8 ASCII hex chars each (104 bytes total)
//                         idx  field
//                          0   ino
//                          1   mode
//                          2   uid
//                          3   gid
//                          4   nlink
//                          5   mtime
//                          6   filesize
//                          7   devmajor
//                          8   devminor
//                          9   rdevmajor
//                         10   rdevminor
//                         11   namesize
//                         12   check
//   [pos+110 .. ]         filename (namesize bytes, last byte is NUL)
//
// The header+name is padded to a multiple of 4 bytes.
// The trailer entry has name "TRAILER!!!".
//
// PUBLIC API (prefix cpio_):
//   cpio_magic_check(buf, pos)      -> bool  (newc OR odc)
//   cpio_is_newc(buf, pos)          -> bool
//   cpio_is_odc(buf, pos)           -> bool
//   cpio_field_hex(buf, pos, idx)   -> int   (parse 8 hex chars; idx 0..12)
//   cpio_ino(buf, pos)              -> int   (field 0)
//   cpio_mode(buf, pos)             -> int   (field 1)
//   cpio_uid(buf, pos)              -> int   (field 2)
//   cpio_gid(buf, pos)              -> int   (field 3, unused alias of uid+1)
//   cpio_nlink(buf, pos)            -> int   (field 4)
//   cpio_mtime(buf, pos)            -> int   (field 5)
//   cpio_filesize(buf, pos)         -> int   (field 6)
//   cpio_namesize(buf, pos)         -> int   (field 11)
//   cpio_name(buf, pos)             -> string (namesize-1 chars at pos+110)
//   cpio_is_trailer(buf, pos)       -> bool  (name == "TRAILER!!!")
//
// LEAF module -- no cross-module imports.

// _cpio_hex_char: convert a single ASCII hex byte to its integer value 0..15.
// Handles 0-9 (48..57), A-F (65..70), a-f (97..102). Returns 0 for unknown.
fn _cpio_hex_char(c: int) -> int
    if c >= 48 and c <= 57
        return c - 48
    if c >= 65 and c <= 70
        return c - 55
    if c >= 97 and c <= 102
        return c - 87
    return 0

// _cpio_check_magic6: verify a 6-byte magic starting at buf[p] matches expected bytes.
fn _cpio_check_magic6(b: any, p: int, b0: int, b1: int, b2: int, b3: int, b4: int, b5: int) -> bool
    if len(b) < p + 6
        return false
    if b[p] != b0
        return false
    if b[p + 1] != b1
        return false
    if b[p + 2] != b2
        return false
    if b[p + 3] != b3
        return false
    if b[p + 4] != b4
        return false
    if b[p + 5] != b5
        return false
    return true

// cpio_is_newc: true if the 6-byte magic at pos is "070701".
fn cpio_is_newc(b: any, pos: int) -> bool
    // '0'=48 '7'=55 '0'=48 '7'=55 '0'=48 '1'=49
    return _cpio_check_magic6(b, pos, 48, 55, 48, 55, 48, 49)

// cpio_is_odc: true if the 6-byte magic at pos is "070707".
fn cpio_is_odc(b: any, pos: int) -> bool
    // '0'=48 '7'=55 '0'=48 '7'=55 '0'=48 '7'=55
    return _cpio_check_magic6(b, pos, 48, 55, 48, 55, 48, 55)

// cpio_magic_check: true if the magic at pos is either newc or odc.
fn cpio_magic_check(b: any, pos: int) -> bool
    if cpio_is_newc(b, pos)
        return true
    if cpio_is_odc(b, pos)
        return true
    return false

// cpio_field_hex: parse 8 ASCII hex chars at pos+6+idx*8 as an unsigned integer.
// idx must be 0..12 (for newc). Returns 0 if buffer is too short.
fn cpio_field_hex(b: any, pos: int, idx: int) -> int
    let off = pos + 6 + idx * 8
    if len(b) < off + 8
        return 0
    let acc = 0
    for i in 0..8
        let c = b[off + i]
        acc = acc * 16 + _cpio_hex_char(c)
    return acc

// cpio_ino: inode number (field idx 0).
fn cpio_ino(b: any, pos: int) -> int
    return cpio_field_hex(b, pos, 0)

// cpio_mode: file mode/permission bits (field idx 1).
fn cpio_mode(b: any, pos: int) -> int
    return cpio_field_hex(b, pos, 1)

// cpio_uid: user ID (field idx 2).
fn cpio_uid(b: any, pos: int) -> int
    return cpio_field_hex(b, pos, 2)

// cpio_gid: group ID (field idx 3).
fn cpio_gid(b: any, pos: int) -> int
    return cpio_field_hex(b, pos, 3)

// cpio_nlink: number of hard links (field idx 4).
fn cpio_nlink(b: any, pos: int) -> int
    return cpio_field_hex(b, pos, 4)

// cpio_mtime: modification time (field idx 5).
fn cpio_mtime(b: any, pos: int) -> int
    return cpio_field_hex(b, pos, 5)

// cpio_filesize: file data size in bytes (field idx 6).
fn cpio_filesize(b: any, pos: int) -> int
    return cpio_field_hex(b, pos, 6)

// cpio_namesize: length of filename including trailing NUL (field idx 11).
fn cpio_namesize(b: any, pos: int) -> int
    return cpio_field_hex(b, pos, 11)

// cpio_name: read the filename (namesize-1 chars) starting at pos+110.
// Stops before the trailing NUL byte.
fn cpio_name(b: any, pos: int) -> string
    let nsz = cpio_namesize(b, pos)
    let n = nsz - 1
    if n < 0
        n = 0
    let off = pos + 110
    let s_parts = []
    let i = 0
    while i < n
        if off + i >= len(b)
            i = n
        else
            let c = b[off + i]
            if c == 0
                i = n
            else
                push(s_parts, chr(c))
                i += 1
    let s = join(s_parts, "")
    return s

// cpio_is_trailer: true if the filename equals "TRAILER!!!".
fn cpio_is_trailer(b: any, pos: int) -> bool
    return cpio_name(b, pos) == "TRAILER!!!"
