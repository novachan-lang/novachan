// std/os/exitcodes.nova
// Standard process exit codes from BSD sysexits.h (EX_* constants).
// All private helpers prefixed _ec_ to avoid cross-module link collisions.

fn ec_ok() -> int
    return 0

fn ec_general() -> int
    return 1

fn ec_usage() -> int
    return 64

fn ec_dataerr() -> int
    return 65

fn ec_noinput() -> int
    return 66

fn ec_nouser() -> int
    return 67

fn ec_nohost() -> int
    return 68

fn ec_unavailable() -> int
    return 69

fn ec_software() -> int
    return 70

fn ec_oserr() -> int
    return 71

fn ec_cantcreat() -> int
    return 73

fn ec_ioerr() -> int
    return 74

fn ec_tempfail() -> int
    return 75

fn ec_protocol() -> int
    return 76

fn ec_noperm() -> int
    return 77

fn ec_config() -> int
    return 78

// ec_name(code) returns the EX_ symbolic name for the given code,
// or "EX_UNKNOWN" for any code not in sysexits.h.
fn ec_name(code: int) -> string
    if code == 0
        return "EX_OK"
    if code == 1
        return "EX_GENERAL"
    if code == 64
        return "EX_USAGE"
    if code == 65
        return "EX_DATAERR"
    if code == 66
        return "EX_NOINPUT"
    if code == 67
        return "EX_NOUSER"
    if code == 68
        return "EX_NOHOST"
    if code == 69
        return "EX_UNAVAILABLE"
    if code == 70
        return "EX_SOFTWARE"
    if code == 71
        return "EX_OSERR"
    if code == 73
        return "EX_CANTCREAT"
    if code == 74
        return "EX_IOERR"
    if code == 75
        return "EX_TEMPFAIL"
    if code == 76
        return "EX_PROTOCOL"
    if code == 77
        return "EX_NOPERM"
    if code == 78
        return "EX_CONFIG"
    return "EX_UNKNOWN"

// ec_is_success(code) returns true (1) iff code == 0.
fn ec_is_success(code: int) -> int
    if code == 0
        return 1
    return 0
