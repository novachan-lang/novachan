// std/os/pathutil — POSIX path ops (pure string; forward slash only; no filesystem access).
//
// API:
//   path_join(parts)        -> string   join a list of segments with "/"
//   path_normalize(p)       -> string   resolve "." and ".." segments, collapse "//"
//   path_basename(p)        -> string   last segment after final "/"
//   path_dirname(p)         -> string   everything before final "/" ("." if none, "/" if root)
//   path_ext(p)             -> string   final ".xxx" extension incl dot; "" if none or dotfile
//   path_is_absolute(p)     -> bool     true if p starts with "/"
//   path_split(p)           -> list     non-empty segments (no "." or "..")
//
// Private helpers prefixed _pu_ to avoid cross-module symbol collisions.

// Index of the last "/" in s; -1 if absent.
fn _pu_last_slash(s: string) -> int
    let idx = -1
    for i in 0..len(s)
        if char_at(s, i) == "/"
            idx = i
    return idx

// Strip trailing slashes; keep the string non-empty (so "/" stays "/").
fn _pu_strip_trail(s: string) -> string
    let p = s
    while len(p) > 1 and char_at(p, len(p) - 1) == "/"
        p = slice(p, 0, len(p) - 1)
    return p

// Join a list of strings with "/" (private helper for normalize).
fn _pu_join_segs(parts: list) -> string
    let out = ""
    for i in 0..len(parts)
        if i > 0
            out += "/"
        out += parts[i]
    return out

// Remove the last element of parts; return new list without it.
fn _pu_pop(parts: list) -> list
    let out = []
    for i in 0..(len(parts) - 1)
        push(out, parts[i])
    return out

// ── Public API ────────────────────────────────────────────────────────────────

// path_join(parts) -> string
// Join a list of path segments with "/" between them. Leading "/" on first element is preserved.
// Strips leading slashes on non-first segments and trailing slashes on accumulated out, so no
// duplicate slashes appear. Returns "" for an empty list.
//   ["a","b","c"]  -> "a/b/c"
//   ["/a","b"]     -> "/a/b"
fn path_join(parts: list) -> string
    if len(parts) == 0
        return ""
    let out = parts[0]
    for i in 1..len(parts)
        let seg = parts[i]
        while len(seg) > 0 and char_at(seg, 0) == "/"
            seg = slice(seg, 1, len(seg))
        while len(out) > 1 and char_at(out, len(out) - 1) == "/"
            out = slice(out, 0, len(out) - 1)
        if len(seg) > 0
            out += "/" + seg
    return out

// path_normalize(p) -> string
// Resolve "." and ".." segments; collapse duplicate slashes. Preserves a leading "/".
//   "a/./b/../c"  -> "a/c"
//   "/a//b/./c"   -> "/a/b/c"
fn path_normalize(p: string) -> string
    let absolute = path_is_absolute(p)
    let raw_parts = split(p, "/")
    let stack = []
    let i = 0
    while i < len(raw_parts)
        let seg = raw_parts[i]
        if seg == "" or seg == "."
            i += 1
        else
            if seg == ".."
                if len(stack) > 0 and stack[len(stack) - 1] != ".."
                    stack = _pu_pop(stack)
                else
                    if not absolute
                        push(stack, "..")
                i += 1
            else
                push(stack, seg)
                i += 1
    let out = _pu_join_segs(stack)
    if absolute
        return "/" + out
    if len(out) == 0
        return "."
    return out

// path_basename(p) -> string
// Last segment after the final "/".
//   "/a/b/c.txt" -> "c.txt"
//   "a"          -> "a"
fn path_basename(p: string) -> string
    let s = _pu_strip_trail(p)
    let idx = _pu_last_slash(s)
    if idx < 0
        return s
    return slice(s, idx + 1, len(s))

// path_dirname(p) -> string
// Everything before the last "/".
//   "/a/b/c.txt" -> "/a/b"
//   "a"          -> "."
//   "/x"         -> "/"
fn path_dirname(p: string) -> string
    let s = _pu_strip_trail(p)
    let idx = _pu_last_slash(s)
    if idx < 0
        return "."
    if idx == 0
        return "/"
    return slice(s, 0, idx)

// path_ext(p) -> string
// Final extension including the dot; "" if none or if dot is at position 0 of basename (dotfiles).
//   "f.tar.gz" -> ".gz"
//   "noext"    -> ""
//   ".hidden"  -> ""
fn path_ext(p: string) -> string
    let base = path_basename(p)
    let dot_idx = -1
    for i in 0..len(base)
        if char_at(base, i) == "."
            dot_idx = i
    if dot_idx <= 0
        return ""
    return slice(base, dot_idx, len(base))

// path_is_absolute(p) -> bool
// True if p starts with "/".
fn path_is_absolute(p: string) -> bool
    return len(p) > 0 and char_at(p, 0) == "/"

// path_split(p) -> list
// Return the non-empty, non-".", non-".." segments of p in order.
//   "a/b/c"   -> ["a","b","c"]
//   "/a/b"    -> ["a","b"]   (leading slash consumed)
//   "a//b"    -> ["a","b"]   (empty segments collapsed)
fn path_split(p: string) -> list
    let raw = split(p, "/")
    let out = []
    for i in 0..len(raw)
        let seg = raw[i]
        if len(seg) > 0 and seg != "." and seg != ".."
            push(out, seg)
    return out
