// std/os/tar_ustar — POSIX ustar tar header parser + checksum verification
//
// Each tar archive block is 512 bytes. Field layout (all offsets from block start):
//   name      (0,100)   NUL-terminated ASCII filename
//   mode      (100,8)   ASCII octal, NUL/space-terminated
//   uid       (108,8)   ASCII octal
//   gid       (116,8)   ASCII octal
//   size      (124,12)  ASCII octal, NUL/space-terminated
//   mtime     (136,12)  ASCII octal
//   chksum    (148,8)   ASCII octal stored checksum
//   typeflag  (156,1)   single byte: 48='0' regular, 53='5' dir, 50='2' symlink
//   linkname  (157,100) NUL-terminated ASCII
//   magic     (257,6)   'ustar\0' or 'ustar '
//   version   (263,2)
//
// Checksum algorithm: sum all 512 bytes treating chksum field bytes (148..155) as 0x20 (space=32).
// The stored checksum is the octal ASCII representation of that sum.

// _tu_read_ascii: read NUL-terminated ASCII string from buf at offset off, up to maxlen chars.
fn _tu_read_ascii(buf: any, off: int, maxlen: int) -> string
    let s_parts = []
    let i = 0
    let n = len(buf)
    while i < maxlen
        let idx = off + i
        if idx >= n
            i = maxlen
        else
            let b = buf[idx]
            if b == 0
                i = maxlen
            else
                push(s_parts, chr(b))
                i += 1
    let s = join(s_parts, "")
    return s

// _tu_parse_octal: parse ASCII octal field from buf at offset off, length flen.
// Stops at NUL(0) or space(32); ignores leading spaces/NULs.
fn _tu_parse_octal(buf: any, off: int, flen: int) -> int
    let acc = 0
    let i = 0
    let n = len(buf)
    let started = 0
    while i < flen
        let idx = off + i
        if idx >= n
            i = flen
        else
            let b = buf[idx]
            if b == 0 or b == 32
                if started == 1
                    i = flen
                else
                    i += 1
            else
                let dv = b - 48
                if dv >= 0 and dv <= 7
                    acc = acc * 8 + dv
                    started = 1
                i += 1
    return acc

// _tu_int_to_octal: convert integer to octal string (minimum 1 digit).
fn _tu_int_to_octal(v: int) -> string
    if v == 0
        return "0"
    let digits = ""
    let n = v
    while n > 0
        let d = n - (n / 8) * 8
        digits = chr(48 + d) + digits
        n = n / 8
    return digits

// tar_name: return NUL-terminated ASCII filename from block at base.
fn tar_name(buf: any, base: int) -> string
    return _tu_read_ascii(buf, base+0, 100)

// tar_mode: return file mode parsed from ASCII octal field at base+100.
fn tar_mode(buf: any, base: int) -> int
    return _tu_parse_octal(buf, base+100, 8)

// tar_uid: return user ID parsed from ASCII octal field at base+108.
fn tar_uid(buf: any, base: int) -> int
    return _tu_parse_octal(buf, base+108, 8)

// tar_gid: return group ID parsed from ASCII octal field at base+116.
fn tar_gid(buf: any, base: int) -> int
    return _tu_parse_octal(buf, base+116, 8)

// tar_size: return file size parsed from ASCII octal field at base+124.
fn tar_size(buf: any, base: int) -> int
    return _tu_parse_octal(buf, base+124, 12)

// tar_mtime: return modification time parsed from ASCII octal field at base+136.
fn tar_mtime(buf: any, base: int) -> int
    return _tu_parse_octal(buf, base+136, 12)

// tar_typeflag: return the typeflag byte value at base+156 (raw byte, not ASCII interpretation).
fn tar_typeflag(buf: any, base: int) -> int
    if base+156 >= len(buf)
        return 0
    return buf[base+156]

// tar_typeflag_name: return human-readable name for the typeflag byte.
fn tar_typeflag_name(buf: any, base: int) -> string
    let tf = tar_typeflag(buf, base)
    if tf == 48
        return "regular"
    if tf == 53
        return "directory"
    if tf == 50
        return "symlink"
    return "other"

// tar_magic_check: return true if bytes at base+257 spell 'ustar' (ASCII 117,115,116,97,114).
fn tar_magic_check(buf: any, base: int) -> bool
    let off = base + 257
    if off + 5 > len(buf)
        return false
    if buf[off] != 117
        return false
    if buf[off+1] != 115
        return false
    if buf[off+2] != 116
        return false
    if buf[off+3] != 97
        return false
    if buf[off+4] != 114
        return false
    return true

// tar_checksum_stored: return the stored checksum value from ASCII octal field at base+148.
fn tar_checksum_stored(buf: any, base: int) -> int
    return _tu_parse_octal(buf, base+148, 8)

// tar_checksum_calc: compute the actual checksum — sum of all 512 bytes in the block,
// treating the 8 bytes of the chksum field (offsets base+148..base+155) as 0x20 (space=32).
fn tar_checksum_calc(buf: any, base: int) -> int
    let total = 0
    let i = 0
    let n = len(buf)
    let blk_end = base + 512
    if blk_end > n
        blk_end = n
    while i < 512
        let idx = base + i
        if idx >= n
            total += 0
        else
            let b = buf[idx]
            if i >= 148 and i < 156
                total += 32
            else
                total += b
        i += 1
    return total

// tar_checksum_valid: return true if the stored checksum matches the computed checksum.
fn tar_checksum_valid(buf: any, base: int) -> bool
    let stored = tar_checksum_stored(buf, base)
    let calc = tar_checksum_calc(buf, base)
    if stored == calc
        return true
    return false
