// std/os/fnmatch — Shell glob pattern matching (fnmatch semantics). Pure NOVA.
//
// WHAT: matches a filename against a shell-style pattern.
//   *       matches any run of characters, including the empty string
//   ?       matches exactly one character
//   [abc]   matches one character that is 'a', 'b', or 'c'
//   [a-z]   matches one character in the range 'a'..'z' (inclusive, by code point)
//   [!abc]  matches one character NOT in the set (^ also accepted as negator)
//   Literal chars match themselves. No path-segment semantics here — use std/os/glob for that.
//
// All functions are private-tagged with _fm_ to avoid cross-module link collisions.

// _fm_match_bracket: parse and match a [...] class starting at pattern position pi.
// Returns [matched:int, next_pi:int] as a two-element list.
//   matched: 1 if the character ch matches the class, 0 otherwise
//   next_pi: position in pattern just AFTER the closing ']'
// On malformed pattern (no closing ']'), returns [0, pi] (class fails, pi unchanged).
fn _fm_bracket(ch: string, p: string, pi: int) -> any
    let pn = len(p)
    // pi currently points to char after '['. Determine negation.
    let negate = 0
    let start = pi
    if start < pn
        let fc = char_at(p, start)
        if fc == "!" or fc == "^"
            negate = 1
            start = start + 1
    // Scan to find closing ']', then match.
    // We do two passes: first find end (closing ']'), then evaluate.
    let end = start
    let found_close = 0
    // ']' right after '[' or '[!' is treated as a literal ']' inside the class (POSIX rule),
    // but we keep it simple: scan forward for ']'.
    let scan = start
    let loop_done = 0
    while scan < pn and loop_done == 0
        let sc = char_at(p, scan)
        if sc == "]"
            end = scan
            found_close = 1
            loop_done = 1
        else
            let scan2 = scan + 1
            scan = scan2
    if found_close == 0
        // Malformed — treat '[' as literal (no match)
        let bad = [0, pi]
        return bad
    // Now evaluate: iterate chars in [start..end) against ch.
    let matched = 0
    let ci = start
    while ci < end and matched == 0
        // Check for range: ci+1=='−' and ci+2 < end
        let is_range = 0
        if ci + 2 < end
            let mid = char_at(p, ci + 1)
            if mid == "-"
                is_range = 1
        if is_range == 1
            let lo = char_at(p, ci)
            let hi = char_at(p, ci + 2)
            let o = ord(ch)
            let olo = ord(lo)
            let ohi = ord(hi)
            if o >= olo and o <= ohi
                matched = 1
            ci = ci + 3
        else
            let cc = char_at(p, ci)
            if cc == ch
                matched = 1
            ci = ci + 1
    // Apply negation
    if negate == 1
        if matched == 1
            matched = 0
        else
            matched = 1
    let result = [matched, end + 1]
    return result

// _fm_core: recursive matcher for (name s, pattern p) both starting at given offsets.
fn _fm_core(s: string, si: int, p: string, pi: int) -> bool
    let sn = len(s)
    let pn = len(p)
    // Both exhausted: success
    if pi == pn and si == sn
        return true
    // Pattern exhausted but string not: fail
    if pi == pn
        return false
    let pc = char_at(p, pi)
    // '*' — try matching zero or more chars
    if pc == "*"
        // Skip consecutive stars
        let npi = pi + 1
        while npi < pn and char_at(p, npi) == "*"
            npi = npi + 1
        // Try: '*' matches empty (advance pattern only)
        if _fm_core(s, si, p, npi)
            return true
        // Try: '*' matches one more char (advance string)
        if si < sn
            return _fm_core(s, si + 1, p, pi)
        return false
    // String exhausted but pattern not (and not '*')
    if si >= sn
        return false
    // '?' — matches exactly one char
    if pc == "?"
        return _fm_core(s, si + 1, p, pi + 1)
    // '[' — character class
    if pc == "["
        let ch = char_at(s, si)
        let br = _fm_bracket(ch, p, pi + 1)
        let ok = br[0]
        let npi2 = br[1]
        if ok == 1
            return _fm_core(s, si + 1, p, npi2)
        return false
    // Literal match
    if pc == char_at(s, si)
        return _fm_core(s, si + 1, p, pi + 1)
    return false

// fn_match(name, pattern) -> bool
// Returns true if 'name' matches the shell glob 'pattern'.
fn fn_match(name: string, pattern: string) -> bool
    return _fm_core(name, 0, pattern, 0)

// fn_match_ci(name, pattern) -> bool
// Case-insensitive variant: folds both name and pattern to lowercase before matching.
fn fn_match_ci(name: string, pattern: string) -> bool
    return _fm_core(lower(name), 0, lower(pattern), 0)

// fn_filter(names, pattern) -> list
// Returns the sublist of names for which fn_match(name, pattern) is true, order preserved.
fn fn_filter(names: any, pattern: string) -> any
    let out = [nm for nm in names if fn_match(nm, pattern)]
    return out
