// std/os/platform — host platform detection, built on the native os_name() primitive.
//
// All detection is case-insensitive substring search on the lowercased os_name() result.
// Known os_name() return values: "windows", "linux", "macos" (or "darwin" on some builds).
// pl_is_posix() = linux OR macos — covers every UNIX-family host NOVA runs on today.

// Return the lowercased OS name string (the canonical identifier for this host).
fn pl_os() -> string
    return lower(os_name())

// True when running on Microsoft Windows.
fn pl_is_windows() -> bool
    let n = pl_os()
    return find(n, "win") >= 0

// True when running on Linux.
fn pl_is_linux() -> bool
    let n = pl_os()
    return find(n, "linux") >= 0

// True when running on macOS / Darwin.
fn pl_is_macos() -> bool
    let n = pl_os()
    if find(n, "mac") >= 0
        return true
    if find(n, "darwin") >= 0
        return true
    return false

// True when running on any POSIX-family OS (Linux or macOS/Darwin).
fn pl_is_posix() -> bool
    if pl_is_linux()
        return true
    if pl_is_macos()
        return true
    return false

// The directory separator character for this platform: "\\" on Windows, "/" elsewhere.
fn pl_path_sep() -> string
    if pl_is_windows()
        return chr(92)
    return "/"

// The line ending sequence for this platform: CRLF on Windows, LF elsewhere.
fn pl_line_sep() -> string
    if pl_is_windows()
        return chr(13) + chr(10)
    return chr(10)
