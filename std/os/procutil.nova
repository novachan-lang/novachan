// std/os/procutil — Process-adjacent utilities available without OS-level process APIs.
//
// API:
//   pu_pid()                 -> int      a pseudo-PID derived from time_ms() (NOT the real OS
//                                        PID — NOVA's runtime exposes no getpid() builtin; this
//                                        is a stable-within-a-tick, process-scoped identifier
//                                        useful for log/lock-file tagging, not for kill(pid))
//   pu_uptime_ms(start_time)  -> int      time_ms() - start_time (caller records start_time at
//                                        process/task start)
//   pu_argv()                 -> list     [] (placeholder — real argv requires a runtime
//                                        builtin NOVA does not currently expose)
//   pu_hostname()             -> string   env("COMPUTERNAME") or env("HOSTNAME"), else "localhost"
//
// Private helpers prefixed _pu_.

// Mix a time_ms() reading into a positive-looking pseudo-identifier.
fn _pu_mix(seed: int) -> int
    let a = (seed * 2654435761) + 1
    if a < 0
        a = 0 - a
    let mask = 2147483647
    return a & mask

// pu_pid() -> int  pseudo-PID derived from the current time; see module header caveat.
fn pu_pid() -> int
    return _pu_mix(time_ms())

// pu_uptime_ms(start_time) -> int  milliseconds elapsed since start_time.
fn pu_uptime_ms(start_time: int) -> int
    let elapsed = time_ms() - start_time
    if elapsed < 0
        return 0
    return elapsed

// pu_argv() -> list  placeholder empty argv; see module header caveat.
fn pu_argv() -> any
    return []

// pu_hostname() -> string
fn pu_hostname() -> string
    let h = env("COMPUTERNAME")
    if len(h) > 0
        return h
    let h2 = env("HOSTNAME")
    if len(h2) > 0
        return h2
    return "localhost"
