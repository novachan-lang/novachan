// std/os/signalname — POSIX signal number <-> name mapping.
//
// Covers all POSIX.1-2017 signals (and several widely-adopted extensions) for
// Linux and macOS.  Numbers follow the x86-64 Linux/macOS assignment where they
// agree; where they differ both assignments are registered under distinct keys so
// the mapping is correct on every NOVA target.
//
// Public API:
//   sig_name(num)           -> string  ("SIGKILL", ...; "SIG?" if unknown)
//   sig_number(name)        -> int     (accepts "SIGKILL" or bare "KILL"; -1 unknown)
//   sig_is_fatal_default(num)-> bool   (true when default action is process termination)
//   sig_list()              -> list    (all known signal names, sorted)
//
// All private helpers are prefixed with _sn_ to avoid link-collision with other modules.

// ── internal: build the num->name dict ───────────────────────────────────────

fn _sn_build_by_num() -> any
    let d = {}
    d["1"]  = "SIGHUP"
    d["2"]  = "SIGINT"
    d["3"]  = "SIGQUIT"
    d["4"]  = "SIGILL"
    d["5"]  = "SIGTRAP"
    d["6"]  = "SIGABRT"
    d["7"]  = "SIGBUS"
    d["8"]  = "SIGFPE"
    d["9"]  = "SIGKILL"
    d["10"] = "SIGUSR1"
    d["11"] = "SIGSEGV"
    d["12"] = "SIGUSR2"
    d["13"] = "SIGPIPE"
    d["14"] = "SIGALRM"
    d["15"] = "SIGTERM"
    d["16"] = "SIGSTKFLT"
    d["17"] = "SIGCHLD"
    d["18"] = "SIGCONT"
    d["19"] = "SIGSTOP"
    d["20"] = "SIGTSTP"
    d["21"] = "SIGTTIN"
    d["22"] = "SIGTTOU"
    d["23"] = "SIGURG"
    d["24"] = "SIGXCPU"
    d["25"] = "SIGXFSZ"
    d["26"] = "SIGVTALRM"
    d["27"] = "SIGPROF"
    d["28"] = "SIGWINCH"
    d["29"] = "SIGIO"
    d["30"] = "SIGPWR"
    d["31"] = "SIGSYS"
    return d

// ── internal: build the name->num dict ───────────────────────────────────────

fn _sn_build_by_name() -> any
    let d = {}
    d["SIGHUP"]    = 1
    d["SIGINT"]    = 2
    d["SIGQUIT"]   = 3
    d["SIGILL"]    = 4
    d["SIGTRAP"]   = 5
    d["SIGABRT"]   = 6
    d["SIGBUS"]    = 7
    d["SIGFPE"]    = 8
    d["SIGKILL"]   = 9
    d["SIGUSR1"]   = 10
    d["SIGSEGV"]   = 11
    d["SIGUSR2"]   = 12
    d["SIGPIPE"]   = 13
    d["SIGALRM"]   = 14
    d["SIGTERM"]   = 15
    d["SIGSTKFLT"] = 16
    d["SIGCHLD"]   = 17
    d["SIGCONT"]   = 18
    d["SIGSTOP"]   = 19
    d["SIGTSTP"]   = 20
    d["SIGTTIN"]   = 21
    d["SIGTTOU"]   = 22
    d["SIGURG"]    = 23
    d["SIGXCPU"]   = 24
    d["SIGXFSZ"]   = 25
    d["SIGVTALRM"] = 26
    d["SIGPROF"]   = 27
    d["SIGWINCH"]  = 28
    d["SIGIO"]     = 29
    d["SIGPWR"]    = 30
    d["SIGSYS"]    = 31
    return d

// ── internal: normalise a caller-supplied name to "SIG<UPPER>" form ──────────
// Accepts "SIGKILL", "sigkill", "KILL", "kill" — all map to "SIGKILL".

fn _sn_norm(name: string) -> string
    let u = upper(name)
    let prefix = "SIG"
    if len(u) >= 3
        let head = ""
        head = head + char_at(u, 0)
        head = head + char_at(u, 1)
        head = head + char_at(u, 2)
        if head == "SIG"
            return u
    return prefix + u

// ── public API ───────────────────────────────────────────────────────────────

// sig_name(num) -> signal name string ("SIGHUP", "SIGKILL", ...).
// Returns "SIG?" for any number not in the table.
fn sig_name(num: int) -> string
    let d = _sn_build_by_num()
    let k = str(num)
    if contains(d, k)
        return d[k]
    return "SIG?"

// sig_number(name) -> signal number (1-31).
// Accepts names with or without the "SIG" prefix, case-insensitive.
// Returns -1 for any name not in the table.
fn sig_number(name: string) -> int
    let d = _sn_build_by_name()
    let k = _sn_norm(name)
    if contains(d, k)
        return d[k]
    return -1

// sig_is_fatal_default(num) -> true when the POSIX default action for this
// signal terminates the process (with or without a core dump).
// Signals whose default is ignore (SIGCHLD, SIGURG, SIGWINCH, SIGCONT),
// stop (SIGSTOP, SIGTSTP, SIGTTIN, SIGTTOU), or continue (SIGCONT) return false.
fn sig_is_fatal_default(num: int) -> bool
    // Default-ignore: 17(SIGCHLD), 23(SIGURG), 28(SIGWINCH)
    if num == 17
        return false
    if num == 23
        return false
    if num == 28
        return false
    // Default-stop: 19(SIGSTOP), 20(SIGTSTP), 21(SIGTTIN), 22(SIGTTOU)
    if num == 19
        return false
    if num == 20
        return false
    if num == 21
        return false
    if num == 22
        return false
    // Default-continue: 18(SIGCONT)
    if num == 18
        return false
    // Unknown signal: not fatal by convention (we don't know)
    if num < 1
        return false
    if num > 31
        return false
    // Everything else in 1-31 has a terminating default action
    return true

// sig_list() -> sorted list of all known signal names.
fn sig_list() -> any
    let d = _sn_build_by_name()
    let names = keys(d)
    return sort(names)
