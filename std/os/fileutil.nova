// std/os/fileutil — General file utilities: copy/move/size/name-splitting/normalize/touch.
//
// API:
//   fu_copy(src, dst)        -> bool    read src, write dst (whole-file copy); false if src missing
//   fu_move(src, dst)        -> bool    rename src to dst (falls back to copy+delete cross-volume)
//   fu_size(path)            -> int     byte length of file content; -1 if missing
//   fu_extension(path)       -> string  final ".xxx" extension incl dot; "" if none/dotfile
//   fu_basename(path)        -> string  last segment after final "/" or "\"
//   fu_dirname(path)         -> string  everything before final separator ("." if none)
//   fu_join(a, b)             -> string  join two path segments with "/"
//   fu_is_absolute(path)     -> bool    true if path starts with "/" or "<drive>:"
//   fu_normalize(path)       -> string  resolve "." and ".." segments, collapse "//"
//   fu_touch(path)           -> bool    create an empty file if it does not already exist
//
// Accepts both "/" and "\" as separators on input (Windows paths included) but always
// emits "/" in results, matching the rest of std/os. Private helpers prefixed _fu_.

// Index of the last path separator ('/' or '\\') in s; -1 if absent.
fn _fu_last_sep(s: string) -> int
    let idx = 0 - 1
    let i = 0
    while i < len(s)
        let c = char_at(s, i)
        if c == "/" or c == "\\"
            idx = i
        i = i + 1
    return idx

// Strip trailing separators, keeping the string non-empty.
fn _fu_strip_trail(s: string) -> string
    let p = s
    while len(p) > 1 and (char_at(p, len(p) - 1) == "/" or char_at(p, len(p) - 1) == "\\")
        p = slice(p, 0, len(p) - 1)
    return p

// Remove the last element of a segment list; return a new list without it.
fn _fu_pop(parts: list) -> list
    let out = []
    let i = 0
    while i < len(parts) - 1
        push(out, parts[i])
        i = i + 1
    return out

// Join segments with "/".
fn _fu_join_segs(parts: list) -> string
    let out = ""
    let i = 0
    while i < len(parts)
        if i > 0
            out = out + "/"
        out = out + parts[i]
        i = i + 1
    return out

// fu_basename(path) -> string
fn fu_basename(path: string) -> string
    let s = _fu_strip_trail(path)
    let idx = _fu_last_sep(s)
    if idx < 0
        return s
    return slice(s, idx + 1, len(s))

// fu_dirname(path) -> string
fn fu_dirname(path: string) -> string
    let s = _fu_strip_trail(path)
    let idx = _fu_last_sep(s)
    if idx < 0
        return "."
    if idx == 0
        return "/"
    return slice(s, 0, idx)

// fu_extension(path) -> string
fn fu_extension(path: string) -> string
    let base = fu_basename(path)
    let dot_idx = 0 - 1
    let i = 0
    while i < len(base)
        if char_at(base, i) == "."
            dot_idx = i
        i = i + 1
    if dot_idx <= 0
        return ""
    return slice(base, dot_idx, len(base))

// fu_join(a, b) -> string  join two path segments with a single "/" between them.
fn fu_join(a: string, b: string) -> string
    let left = _fu_strip_trail(a)
    let right = b
    while len(right) > 0 and (char_at(right, 0) == "/" or char_at(right, 0) == "\\")
        right = slice(right, 1, len(right))
    if len(left) == 0
        return right
    if len(right) == 0
        return left
    return left + "/" + right

// fu_is_absolute(path) -> bool  true for "/..." (POSIX) or "C:..." / "C:/..." (Windows drive).
fn fu_is_absolute(path: string) -> bool
    if len(path) == 0
        return false
    if char_at(path, 0) == "/" or char_at(path, 0) == "\\"
        return true
    if len(path) >= 2 and char_at(path, 1) == ":"
        return true
    return false

// fu_normalize(path) -> string  resolve "." / ".." segments, collapse duplicate separators.
fn fu_normalize(path: string) -> string
    let absolute = fu_is_absolute(path)
    // Preserve a Windows drive prefix like "C:" separately from the rest.
    let drive = ""
    let rest = path
    if len(path) >= 2 and char_at(path, 1) == ":"
        drive = slice(path, 0, 2)
        rest = slice(path, 2, len(path))
    let normalized_slashes = replace(rest, "\\", "/")
    let raw_parts = split(normalized_slashes, "/")
    let stack = []
    let i = 0
    while i < len(raw_parts)
        let seg = raw_parts[i]
        if seg == "" or seg == "."
            i = i + 1
        else
            if seg == ".."
                if len(stack) > 0 and stack[len(stack) - 1] != ".."
                    stack = _fu_pop(stack)
                else
                    if absolute == false
                        push(stack, "..")
                i = i + 1
            else
                push(stack, seg)
                i = i + 1
    let joined = _fu_join_segs(stack)
    if absolute
        if len(drive) > 0
            return drive + "/" + joined
        return "/" + joined
    if len(drive) > 0
        if len(joined) == 0
            return drive
        return drive + joined
    if len(joined) == 0
        return "."
    return joined

// fu_size(path) -> int  byte length of file content; -1 if the file does not exist.
fn fu_size(path: string) -> int
    if file_exists(path) == false
        return 0 - 1
    let content = read_file(path)
    return len(content)

// fu_touch(path) -> bool  create an empty file if it does not exist; true if the file exists after.
fn fu_touch(path: string) -> bool
    if file_exists(path)
        return true
    write_file(path, "")
    return file_exists(path)

// fu_copy(src, dst) -> bool  whole-file copy; returns false if src does not exist.
fn fu_copy(src: string, dst: string) -> bool
    if file_exists(src) == false
        return false
    let content = read_file(src)
    write_file(dst, content)
    return file_exists(dst)

// fu_move(src, dst) -> bool  rename src to dst; falls back to copy+delete on rename failure.
fn fu_move(src: string, dst: string) -> bool
    if file_exists(src) == false
        return false
    let renamed = rename_path(src, dst)
    if renamed == 1
        return true
    // Fallback: copy then remove the source (handles cross-volume moves).
    let copied = fu_copy(src, dst)
    if copied == false
        return false
    remove_file(src)
    return true
