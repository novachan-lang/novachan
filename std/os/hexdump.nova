// std/os/hexdump — Canonical hex dump of byte lists. Pure NOVA.
//
// hexdump(bytes) -> string
//   Format: each line covers 16 bytes.
//   Column 1: 8-digit hex offset (zero-padded), two spaces.
//   Column 2: up to 16 space-separated 2-digit hex bytes, padded to full width.
//   Column 3: two spaces then |ascii| where non-printable chars become '.'.
//   Lines joined by LF (chr(10)). Empty input returns "".

// _hd_hex_nibble: convert int 0..15 to hex char
fn _hd_nibble(n: int) -> string
    if n < 10
        return str(n)
    if n == 10
        return "a"
    if n == 11
        return "b"
    if n == 12
        return "c"
    if n == 13
        return "d"
    if n == 14
        return "e"
    return "f"

// _hd_hex_byte: convert int 0..255 to 2-char lowercase hex string
fn _hd_byte(b: int) -> string
    let hi = (b >> 4) & 15
    let lo = b & 15
    return _hd_nibble(hi) + _hd_nibble(lo)

// _hd_hex_offset: convert offset int to 8-digit zero-padded hex string
fn _hd_offset(off: int) -> string
    let d7 = (off >> 28) & 15
    let d6 = (off >> 24) & 15
    let d5 = (off >> 20) & 15
    let d4 = (off >> 16) & 15
    let d3 = (off >> 12) & 15
    let d2 = (off >> 8) & 15
    let d1 = (off >> 4) & 15
    let d0 = off & 15
    return _hd_nibble(d7) + _hd_nibble(d6) + _hd_nibble(d5) + _hd_nibble(d4) + _hd_nibble(d3) + _hd_nibble(d2) + _hd_nibble(d1) + _hd_nibble(d0)

// _hd_printable: return "." for non-printable, else the char
fn _hd_printable(b: int) -> string
    if b >= 32 and b <= 126
        return chr(b)
    return "."

// hexdump: produce canonical hex dump string from a list of ints 0..255
fn hexdump(bytes: any) -> string
    let n = len(bytes)
    if n == 0
        return ""
    let lines = []
    let off = 0
    while off < n
        // Build hex column: up to 16 bytes
        let count = 16
        if n - off < 16
            count = n - off
        // Offset column
        let line = _hd_offset(off) + "  "
        // Hex bytes column: 16 positions, padded with spaces if < 16 bytes
        let bi = 0
        while bi < count
            if bi > 0
                line = line + " "
            line = line + _hd_byte(bytes[off + bi])
            bi = bi + 1
        // Padding for partial last line: each missing byte = 3 chars ("xx ")
        let missing = 16 - count
        let pi = 0
        while pi < missing
            line = line + "   "
            pi = pi + 1
        // ASCII column
        line = line + "  |"
        let ai = 0
        while ai < count
            line = line + _hd_printable(bytes[off + ai])
            ai = ai + 1
        line = line + "|"
        push(lines, line)
        off = off + 16
    return join(lines, chr(10))
