// std/crypto/timing -- constant-time-style utilities: comparison, branchless select, zero test.
//
// These are SOURCE-LEVEL constant-time constructions (no data-dependent branches or
// data-dependent indexing in the NOVA source). Whether the emitted machine code stays
// constant-time depends on the backend not re-introducing a branch (e.g. via speculative
// optimization) -- the same caveat std/crypto/securetok documents for the runtime's ct_eq
// builtin, which is why that one is implemented `optnone` in the C runtime. ct_compare here
// delegates to that same builtin for exactly that reason. ct_select/ct_is_zero are pure
// bitwise-arithmetic (no `if`), which is the standard technique (see Bernstein's constant-time
// coding notes) for avoiding a compiler-inserted branch in the first place.
//
// LEAF -- imports nothing.

// ct_compare(a_hex, b_hex) -> bool. Constant-time-style equality for hex/text strings (no
// embedded NUL), via the runtime's ct_eq builtin.
fn ct_compare(a_hex: string, b_hex: string) -> bool
    ct_eq(a_hex, b_hex) == 1

// PRIVATE: all-ones (0xFFFF...FFFF) if cond != 0, all-zeros if cond == 0. Branchless: for any
// nonzero two's-complement cond, at least one of (cond, -cond) has the sign bit set, so their
// OR has the sign bit set too; an arithmetic right shift by 63 then replicates that sign bit
// across every bit of the result (same trick std/crypto/timing's ct_is_zero uses).
fn _tim_nz_mask(cond: int) -> int
    let nz = cond | (0 - cond)
    nz >> 63

// ct_select(cond, a, b) -> a if cond is truthy (non-zero), else b. Branchless: builds an
// all-ones or all-zeros mask from cond and combines a/b with bitwise ops instead of `if`.
fn ct_select(cond: int, a: int, b: int) -> int
    let mask = _tim_nz_mask(cond)
    (mask & a) | ((~mask) & b)

// ct_is_zero(x) -> bool. Branchless zero test built on the same _tim_nz_mask trick as
// ct_select: for x == 0 the mask is all-zeros; for any x != 0 (including INT64_MIN, whose
// negation overflows back to itself but is STILL negative, so the sign-bit trick holds even
// there) the mask is all-ones.
fn ct_is_zero(x: int) -> bool
    (_tim_nz_mask(x) & 1) == 0

// ct_not_zero(x) -> bool. Complement of ct_is_zero, spelled out branchlessly rather than as
// `not ct_is_zero(x)` so callers who care can inline the exact same bit trick either way.
fn ct_not_zero(x: int) -> bool
    (_tim_nz_mask(x) & 1) == 1

// ct_select_bytes(cond, a, b) -> a if cond is truthy, else b -- byte-list variant of ct_select,
// applied element-wise (a and b must be equal length; mismatched lengths return b unchanged).
fn ct_select_bytes(cond: int, a: any, b: any) -> any
    let n = len(a)
    if len(b) != n
        return b
    let mask = _tim_nz_mask(cond)
    let out = []
    let i = 0
    while i < n
        push(out, (mask & a[i]) | ((~mask) & b[i]))
        i = i + 1
    out
