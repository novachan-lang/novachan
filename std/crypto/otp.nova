// std/crypto/otp -- One-time pad (Vernam cipher) and XOR crypto utilities.
//
// One-time pad is the ONLY provably information-theoretically secure cipher: when the
// key is truly random, at least as long as the plaintext, and never reused, the
// ciphertext leaks zero information about the plaintext. All operations here work on
// lists of bytes (ints in 0..255) so the boundary between bytes and printable ASCII is
// explicit -- no NUL-termination surprises.
//
// Included: byte XOR, string/byte conversion, hex encode/decode, bit-level Hamming
// distance (used in Cryptopals break-repeating-key-XOR), and a key-reuse detector
// helper. Self-contained -- no std imports.

// otp_xor_bytes: XOR two equal-length byte lists element-wise.
// Returns a new list; inputs are unchanged.
fn otp_xor_bytes(a: any, b: any) -> any
    let n = len(a)
    let out = []
    let i = 0
    while i < n
        push(out, a[i] ^ b[i])
        i = i + 1
    out

// otp_encrypt: XOR plaintext bytes with key bytes. Key must be >= plaintext in length.
// Returns the ciphertext as a byte list (same length as plain_bytes).
fn otp_encrypt(plain_bytes: any, key_bytes: any) -> any
    let n = len(plain_bytes)
    let out = []
    let i = 0
    while i < n
        push(out, plain_bytes[i] ^ key_bytes[i])
        i = i + 1
    out

// otp_decrypt: Decrypt OTP-encrypted bytes. Identical to otp_encrypt (XOR is its own inverse).
fn otp_decrypt(cipher_bytes: any, key_bytes: any) -> any
    let n = len(cipher_bytes)
    let out = []
    let i = 0
    while i < n
        push(out, cipher_bytes[i] ^ key_bytes[i])
        i = i + 1
    out

// otp_str_to_bytes: Convert a string to a byte list via ord() of each character.
fn otp_str_to_bytes(s: string) -> any
    let n = len(s)
    let out = []
    let i = 0
    while i < n
        push(out, ord(slice(s, i, i + 1)))
        i = i + 1
    out

// otp_bytes_to_str: Convert a byte list to a string via chr() of each byte.
fn otp_bytes_to_str(bytes_list: any) -> string
    let n = len(bytes_list)
    let out = ""
    let i = 0
    while i < n
        out = out + chr(bytes_list[i])
        i = i + 1
    out

// otp_str_encrypt: Encrypt a text string using a key string; returns ciphertext as byte list.
// Key must be at least as long as the text.
fn otp_str_encrypt(text: string, key: string) -> any
    let n = len(text)
    let out = []
    let i = 0
    while i < n
        push(out, ord(slice(text, i, i + 1)) ^ ord(slice(key, i, i + 1)))
        i = i + 1
    out

// otp_str_decrypt: Decrypt OTP cipher_bytes (byte list) with a string key.
// Returns the decrypted plaintext as a string.
fn otp_str_decrypt(cipher_bytes: any, key: string) -> string
    let n = len(cipher_bytes)
    let out = ""
    let i = 0
    while i < n
        let b = cipher_bytes[i] ^ ord(slice(key, i, i + 1))
        out = out + chr(b)
        i = i + 1
    out

// _hex_char: Map a nibble (0..15) to lowercase hex digit.
fn _hex_char(v: int) -> string
    if v < 10
        return str(v)
    if v == 10
        return "a"
    if v == 11
        return "b"
    if v == 12
        return "c"
    if v == 13
        return "d"
    if v == 14
        return "e"
    return "f"

// _nibble: Parse a single hex character to 0..15, or -1 on error.
fn _nibble(c: string) -> int
    let o = ord(c)
    if o >= 48 and o <= 57
        return o - 48
    if o >= 97 and o <= 102
        return o - 87
    if o >= 65 and o <= 70
        return o - 55
    return -1

// otp_hex_encode: Encode a byte list to a lowercase hex string (2 chars per byte).
fn otp_hex_encode(byte_list: any) -> string
    let n = len(byte_list)
    let out = ""
    let i = 0
    while i < n
        let b = byte_list[i]
        let hi = (b >> 4) & 15
        let lo = b & 15
        out = out + _hex_char(hi) + _hex_char(lo)
        i = i + 1
    out

// otp_hex_decode: Decode a lowercase (or uppercase) hex string into a byte list.
// Input length must be even; odd-length strings ignore the trailing nibble.
fn otp_hex_decode(hex_str: string) -> any
    let n = len(hex_str)
    let out = []
    let i = 0
    while i + 1 < n
        let hi = _nibble(slice(hex_str, i, i + 1))
        let lo = _nibble(slice(hex_str, i + 1, i + 2))
        push(out, (hi << 4) | lo)
        i = i + 2
    out

// _popcount: Count the number of set bits in a byte (0..255).
fn _popcount(b: int) -> int
    let v = b & 255
    let c = 0
    while v != 0
        let m = v & 1
        if m == 1
            c = c + 1
        v = v >> 1
    c

// otp_hamming_distance: Bit-level Hamming distance between two equal-length byte lists.
// Counts differing bits across all byte positions.
// Famous vector: hamming_distance("this is a test", "wokka wokka!!!") == 37 (Cryptopals set1 ch6).
fn otp_hamming_distance(a: any, b: any) -> int
    let n = len(a)
    let dist = 0
    let i = 0
    while i < n
        let xb = a[i] ^ b[i]
        dist = dist + _popcount(xb)
        i = i + 1
    dist

// otp_key_reuse_xor: XOR two ciphertexts encrypted under the SAME key.
// The result equals xor(p1, p2) -- XOR of the two plaintexts -- leaking plaintext structure.
// This is the basis of the Cryptopals two-time-pad attack.
fn otp_key_reuse_xor(c1: any, c2: any) -> any
    let n = len(c1)
    let out = []
    let i = 0
    while i < n
        push(out, c1[i] ^ c2[i])
        i = i + 1
    out

// otp_verify_key_length: True if key_len >= msg_len (necessary for secure OTP use).
fn otp_verify_key_length(msg_len: int, key_len: int) -> bool
    key_len >= msg_len
