// std/crypto/cryptanalysis -- classical-cipher cryptanalysis toolkit.
// Provides: index-of-coincidence scoring, chi-square English fitness, Caesar/Vigenere breaking.
// All operations work on ASCII text (case-insensitive), ignoring non-letter characters.
// LEAF -- imports nothing.

// PRIVATE: return true if char c is an ASCII letter (a-z or A-Z).
fn _ca_is_alpha(c: string) -> bool
    let o = ord(c)
    return (o >= 65 and o <= 90) or (o >= 97 and o <= 122)

// PRIVATE: return uppercase ASCII letter value 0-25 for a letter, or -1 if not a letter.
fn _ca_letter_val(c: string) -> int
    let o = ord(c)
    return o - 65 if o >= 65 and o <= 90 else (o - 97 if o >= 97 and o <= 122 else -1)

// PRIVATE: build a frequency table (list of 26 ints) counting A-Z in text (case-insensitive).
fn _ca_freq_table(text: string) -> any
    let counts = [0 for i in 0..26]
    for j in 0..len(text)
        let v = _ca_letter_val(char_at(text, j))
        if v >= 0
            counts[v] += 1
    counts

// Index of coincidence of text: sum of n_i*(n_i-1) / (N*(N-1)) where N = total letter count.
// English IC ~ 0.0667; random IC ~ 0.0385. Returns 0.0 for text with <2 letters.
fn ic_score(text: string) -> float
    let counts = _ca_freq_table(text)
    let big_n = 0
    for k in 0..26
        big_n += counts[k]
    let result = 0.0
    if big_n >= 2
        let numer = 0
        for m in 0..26
            let ni = counts[m]
            numer += ni * (ni - 1)
        let denom = big_n * (big_n - 1)
        result = numer * 1.0 / (denom * 1.0)
    result

// Expected IC for English text (monographic, single language).
fn ic_expected_english() -> float
    0.0667

// Expected IC for uniformly random text over 26 letters.
fn ic_expected_random() -> float
    0.0385

// PRIVATE: English letter expected frequencies (%) indexed A=0..Z=25.
fn _ca_english_pct() -> any
    // A    B     C     D     E      F     G     H     I     J     K     L     M
    [8.17, 1.29, 2.78, 4.25, 12.70, 2.23, 2.02, 6.09, 6.97, 0.15, 0.77, 4.03, 2.41,
    // N    O     P     Q     R     S     T     U     V     W     X     Y     Z
    6.75, 7.51, 1.93, 0.10, 5.99, 6.33, 9.06, 2.76, 0.98, 2.36, 0.15, 1.97, 0.07]

// Expected frequency (%) of an uppercase letter (A-Z) in English.
// Pass the letter as a string, e.g. english_freq("E") == 12.70.
fn english_freq(letter: string) -> float
    let v = _ca_letter_val(letter)
    let tbl = _ca_english_pct()
    let result = 0.0
    if v >= 0
        result = tbl[v]
    result

// Chi-square statistic of text vs expected English frequencies. Lower = more English-like.
// Only letters are counted; non-letters are ignored.
fn chi_square_english(text: string) -> float
    let counts = _ca_freq_table(text)
    let big_n = 0
    for k in 0..26
        big_n += counts[k]
    let result = 0.0
    if big_n > 0
        let tbl = _ca_english_pct()
        let chi = 0.0
        for m in 0..26
            let expected = tbl[m] * big_n * 1.0 / 100.0
            if expected > 0.0
                let diff = counts[m] * 1.0 - expected
                let sq = diff * diff
                chi += sq / expected
        result = chi
    result

// Caesar decrypt: shift each letter BACK by `shift` (mod 26), preserving case; non-letters unchanged.
fn caesar_decrypt(text: string, shift: int) -> string
    let sh = ((26 - (shift % 26)) % 26)
    let out_parts = []
    for i in 0..len(text)
        let c = char_at(text, i)
        let o = ord(c)
        if o >= 65 and o <= 90
            push(out_parts, chr(65 + (o - 65 + sh) % 26))
        else if o >= 97 and o <= 122
            push(out_parts, chr(97 + (o - 97 + sh) % 26))
        else
            push(out_parts, c)
    let out = join(out_parts, "")
    out

// Find the Caesar shift (0..25) that minimizes chi_square_english on the decrypted text.
// Returns the shift that was APPLIED to plaintext to produce ciphertext (decrypt with that shift).
fn best_caesar_shift(text: string) -> int
    let best_shift = 0
    let best_chi = -1.0
    for s in 0..26
        let dec = caesar_decrypt(text, s)
        let chi = chi_square_english(dec)
        if best_chi < 0.0 or chi < best_chi
            best_chi = chi
            best_shift = s
    best_shift

// Autocorrelation at lag `shift`: count positions where letter[i] == letter[i+shift].
// Only letter characters are compared (non-letters are stripped before indexing).
fn autocorrelation(text: string, shift: int) -> int
    let letters = [_ca_letter_val(char_at(text, i)) for i in 0..len(text) if _ca_is_alpha(char_at(text, i))]
    let count = 0
    let n = len(letters)
    for j in 0..(n - shift)
        if letters[j] == letters[j + shift]
            count += 1
    count

// PRIVATE: uppercase a single letter (leaves non-lowercase characters unchanged).
fn _ca_upper_letter(c: string) -> string
    let o = ord(c)
    return chr(o - 32) if o >= 97 and o <= 122 else c

// PRIVATE: the letters-only, uppercased version of text (non-letters stripped).
// Shared by kasiski_spacings and _ca_nth_letters so the extraction lives in ONE place.
fn _ca_normalized_letters(text: string) -> string
    join([_ca_upper_letter(char_at(text, i)) for i in 0..len(text) if _ca_is_alpha(char_at(text, i))], "")

// PRIVATE: greatest common divisor (for Kasiski factor analysis).
fn _ca_gcd(a: int, b: int) -> int
    let aa = a
    let bb = b
    let done = false
    while not done
        if bb == 0
            done = true
        else
            let tmp = bb
            bb = aa % bb
            aa = tmp
    aa

// Kasiski spacings: for each repeated substring of length `seqlen` in the letters-only version of text,
// collect the distances between consecutive occurrences. Returns a flat list of spacing ints.
fn kasiski_spacings(text: string, seqlen: int) -> any
    let letters = _ca_normalized_letters(text)
    let n = len(letters)
    let spacings = []
    for s in 0..(n - seqlen)
        let sub = slice(letters, s, s + seqlen)
        for t in (s + 1)..(n - seqlen + 1)
            let cand = slice(letters, t, t + seqlen)
            if cand == sub
                push(spacings, t - s)
    spacings

// Kasiski key-length guess: the most common small factor (2..20) appearing in the spacing list.
// Returns 2 as fallback if no spacings available.
fn kasiski_key_length(text: string) -> int
    let spacings = kasiski_spacings(text, 3)
    let factor_counts = [0 for k in 0..21]
    for sp in spacings
        for f in 2..21
            if sp % f == 0
                factor_counts[f] += 1
    let best_factor = 2
    let best_count = 0
    for j in 2..21
        if factor_counts[j] > best_count
            best_count = factor_counts[j]
            best_factor = j
    best_factor

// PRIVATE: extract every keylen-th letter from letters-only text starting at position col.
fn _ca_nth_letters(text: string, keylen: int, col: int) -> string
    let letters = _ca_normalized_letters(text)
    // Non-unit stride (every keylen-th letter) — a for-in range is always step 1,
    // so this genuinely needs a while loop.
    let result_parts = []
    let j = col
    while j < len(letters)
        push(result_parts, char_at(letters, j))
        j += keylen
    let result = join(result_parts, "")
    result

// Best Caesar shift for the col-th column of a Vigenere ciphertext.
fn vigenere_key_column(text: string, keylen: int, col: int) -> int
    let col_text = _ca_nth_letters(text, keylen, col)
    best_caesar_shift(col_text)

// Crack a Vigenere cipher given a guessed key length. Returns the recovered key as uppercase letters.
fn crack_vigenere(text: string, keylen: int) -> string
    let key_parts = []
    for col in 0..keylen
        let sh = vigenere_key_column(text, keylen, col)
        push(key_parts, chr(65 + sh))
    let key = join(key_parts, "")
    key
