// std/crypto/password -- password strength scoring (0-4), common-password detection against a
// top-100 list, and policy enforcement.
//
// pw_strength buckets the same charset-size * length entropy estimate std/crypto/pwentropy uses
// (with the same common/sequence/repeat penalties) into a 0-4 score, zxcvbn-style, for UIs that
// want a simple "weak..strong" meter rather than a raw bit count. pw_common is a distinct,
// larger (100-entry) list from pwentropy's 20-entry list, meant for a stricter registration-time
// gate. pw_policy is a configurable minimum-requirements check returning a Result so callers get
// a specific rejection reason instead of a bare bool.
//
// LEAF -- imports nothing.

// PRIVATE: character-class flags for pw, packed as a dict {"lower":bool,"upper":bool,"digit":bool,"symbol":bool}.
fn _pwd_classes(pw: string) -> any
    let has_lower = false
    let has_upper = false
    let has_digit = false
    let has_symbol = false
    for i in 0..len(pw)
        let c = ord(char_at(pw, i))
        if c >= 97 and c <= 122
            has_lower = true
        if c >= 65 and c <= 90
            has_upper = true
        if c >= 48 and c <= 57
            has_digit = true
        if c >= 33 and c <= 126 and not (c >= 97 and c <= 122) and not (c >= 65 and c <= 90) and not (c >= 48 and c <= 57)
            has_symbol = true
    {"lower": has_lower, "upper": has_upper, "digit": has_digit, "symbol": has_symbol}

// PRIVATE: entropy bits = len(pw) * log2(charset_size), 0.0 for a 0/1-symbol charset.
fn _pwd_entropy_bits(pw: string) -> float
    let cls = _pwd_classes(pw)
    let cs = 0
    if cls["lower"]
        cs += 26
    if cls["upper"]
        cs += 26
    if cls["digit"]
        cs += 10
    if cls["symbol"]
        cs += 33
    if cs <= 1
        return 0.0
    let log2cs = log(cs * 1.0) / 0.6931471805599453
    len(pw) * 1.0 * log2cs

// PRIVATE: true if pw has 3+ ascending consecutive chars (e.g. "abc", "789").
fn _pwd_has_sequence(pw: string) -> bool
    if len(pw) < 3
        return false
    for i in 0..(len(pw) - 2)
        let a = ord(char_at(pw, i))
        let b = ord(char_at(pw, i + 1))
        let c = ord(char_at(pw, i + 2))
        if b == a + 1 and c == b + 1
            return true
    false

// PRIVATE: true if pw has 3 identical characters in a row.
fn _pwd_has_repeat(pw: string) -> bool
    if len(pw) < 3
        return false
    for i in 0..(len(pw) - 2)
        if char_at(pw, i) == char_at(pw, i + 1) and char_at(pw, i + 1) == char_at(pw, i + 2)
            return true
    false

// pw_strength(password) -> score 0..4 (0 = instant crack, 4 = very strong). Combines charset*length
// entropy with penalties for common/sequential/repeated patterns, then buckets the result.
fn pw_strength(password: string) -> int
    let bits = _pwd_entropy_bits(password)
    if pw_common(password)
        bits -= 15.0
    if _pwd_has_sequence(password)
        bits -= 8.0
    if _pwd_has_repeat(password)
        bits -= 8.0
    if bits < 0.0
        bits = 0.0
    if bits < 28.0
        return 0
    if bits < 36.0
        return 1
    if bits < 60.0
        return 2
    if bits < 128.0
        return 3
    4

// PRIVATE: top-100 most common passwords (lowercase), compiled from widely-published annual
// "worst passwords" lists (SplashData/NordPass-style). Comparison in pw_common is
// case-insensitive over ASCII.
fn _pwd_common_list() -> any
    ["123456","password","12345678","qwerty","123456789","12345","1234","111111","1234567","dragon",
     "123123","baseball","abc123","football","monkey","letmein","696969","shadow","master","666666",
     "qwertyuiop","123321","mustang","1234567890","michael","654321","superman","1qaz2wsx","7777777","121212",
     "000000","qazwsx","123qwe","killer","trustno1","jordan","jennifer","zxcvbnm","asdfgh","hunter",
     "buster","soccer","harley","batman","andrew","tigger","sunshine","iloveyou","charlie","robert",
     "thomas","hockey","ranger","daniel","starwars","george","computer","michelle","jessica","pepper",
     "1111","zxcvbn","555555","11111111","131313","freedom","777777","pass","maggie","aaaaaa",
     "ginger","princess","joshua","cheese","amanda","summer","ashley","6969","nicole","chelsea",
     "matthew","access","yankees","987654321","dallas","austin","thunder","taylor","matrix","welcome",
     "admin","login","solo","whatever","hello","secret","changeme","passw0rd","qwerty123","letmein1"]

// pw_common(password) -> bool. True iff password (case-insensitively) matches an entry in the
// top-100 common-password list above.
fn pw_common(password: string) -> bool
    let common = _pwd_common_list()
    let lowered = _pwd_lower(password)
    lowered in common

// PRIVATE: ASCII-only lowercase (A-Z -> a-z; every other byte passes through unchanged).
fn _pwd_lower(s: string) -> string
    let out_parts = []
    for i in 0..len(s)
        let c = ord(char_at(s, i))
        if c >= 65 and c <= 90
            push(out_parts, chr(c + 32))
        else
            push(out_parts, char_at(s, i))
    join(out_parts, "")

// pw_policy(password, min_len, require_upper, require_digit, require_special) -> Result.
// ok(true) if every configured requirement is met; err("<reason>") naming the FIRST failing
// requirement otherwise (min length checked first, then class requirements in the order given).
fn pw_policy(password: string, min_len: int, require_upper: bool, require_digit: bool, require_special: bool) -> any
    if len(password) < min_len
        return err("password too short: need at least " + str(min_len) + " characters")
    let cls = _pwd_classes(password)
    if require_upper and not cls["upper"]
        return err("password must contain an uppercase letter")
    if require_digit and not cls["digit"]
        return err("password must contain a digit")
    if require_special and not cls["symbol"]
        return err("password must contain a special character")
    ok(true)
