// std/crypto/blockpad -- Block-cipher padding schemes: PKCS#7, PKCS#5, ANSI X.923, ISO 10126, zero-pad.
//
// Block ciphers operate on fixed-size blocks; plaintext that is not a multiple of the block size
// must be padded. This module implements the four most common padding schemes plus zero-pad, all
// operating on lists of ints (bytes 0..255). PKCS#7 is the standard used by AES-CBC in TLS.
//
// PKCS#7 rule: append N bytes each equal to N, where N = blocksize - (len % blocksize).
//   If len is already a multiple of blocksize, append a full block of blocksize bytes.
//   This guarantees the pad byte is ALWAYS present, making unpadding unambiguous.
//
// Self-contained -- no std imports.

// _pseudo_byte: Deterministic pseudo-random byte for ISO 10126 padding. Uses a simple 63-bit
// linear-congruential state derived from seed and position.
fn _pseudo_byte(seed: int, pos: int) -> int
    let s = (seed * 6364136223846793005 + pos * 1442695040888963407) & 0x7FFFFFFFFFFFFFFF
    let s2 = (s ^ (s >> 17)) & 0x7FFFFFFFFFFFFFFF
    s2 & 255

// pad_length: Compute the number of padding bytes needed for PKCS#7.
// Always in 1..blocksize: if datalen is already a multiple of blocksize, returns blocksize.
fn pad_length(datalen: int, blocksize: int) -> int
    let rem = datalen % blocksize
    if rem == 0
        return blocksize
    return blocksize - rem

// pkcs7_pad: Append PKCS#7 padding to data for the given blocksize.
// Returns a new byte list with length = next multiple of blocksize.
fn pkcs7_pad(data: any, blocksize: int) -> any
    let n = len(data)
    let padlen = pad_length(n, blocksize)
    let out = []
    let i = 0
    while i < n
        push(out, data[i])
        i = i + 1
    let j = 0
    while j < padlen
        push(out, padlen)
        j = j + 1
    out

// pkcs7_unpad: Remove PKCS#7 padding from data. Reads the last byte N and strips N bytes.
// Does not validate -- use pkcs7_valid for validation before unpadding untrusted data.
fn pkcs7_unpad(data: any) -> any
    let n = len(data)
    if n == 0
        return []
    let padlen = data[n - 1]
    let out = []
    let i = 0
    let keep = n - padlen
    while i < keep
        push(out, data[i])
        i = i + 1
    out

// pkcs7_valid: True if data is valid PKCS#7 padding for blocksize.
// Conditions: len(data) is a multiple of blocksize, last byte N in 1..blocksize,
// and the last N bytes all equal N.
fn pkcs7_valid(data: any, blocksize: int) -> bool
    let n = len(data)
    if n == 0
        return false
    let rm = n % blocksize
    if rm != 0
        return false
    let padval = data[n - 1]
    if padval < 1
        return false
    if padval > blocksize
        return false
    let i = n - padval
    while i < n
        if data[i] != padval
            return false
        i = i + 1
    true

// pkcs5_pad: PKCS#5 padding -- identical to PKCS#7 with blocksize fixed at 8.
fn pkcs5_pad(data: any) -> any
    pkcs7_pad(data, 8)

// pkcs5_unpad: Remove PKCS#5 padding (same as pkcs7_unpad).
fn pkcs5_unpad(data: any) -> any
    pkcs7_unpad(data)

// ansix923_pad: ANSI X.923 padding -- (N-1) zero bytes then a final byte = N.
// Returns a new byte list padded to the next multiple of blocksize.
fn ansix923_pad(data: any, blocksize: int) -> any
    let n = len(data)
    let padlen = pad_length(n, blocksize)
    let out = []
    let i = 0
    while i < n
        push(out, data[i])
        i = i + 1
    let j = 0
    while j < padlen - 1
        push(out, 0)
        j = j + 1
    push(out, padlen)
    out

// ansix923_unpad: Remove ANSI X.923 padding. Reads the last byte N and strips N bytes.
fn ansix923_unpad(data: any) -> any
    let n = len(data)
    if n == 0
        return []
    let padlen = data[n - 1]
    let out = []
    let i = 0
    let keep = n - padlen
    while i < keep
        push(out, data[i])
        i = i + 1
    out

// ansix923_valid: True if data is valid ANSI X.923 padding for blocksize.
// Last byte N in 1..blocksize, the preceding N-1 bytes are all zero, len is a multiple.
fn ansix923_valid(data: any, blocksize: int) -> bool
    let n = len(data)
    if n == 0
        return false
    let rm = n % blocksize
    if rm != 0
        return false
    let padval = data[n - 1]
    if padval < 1
        return false
    if padval > blocksize
        return false
    let i = n - padval
    while i < n - 1
        if data[i] != 0
            return false
        i = i + 1
    true

// iso10126_pad: ISO 10126 padding -- (N-1) pseudo-random bytes (derived from seed) then N.
// The seed makes this deterministic for testing; in production use a CSPRNG instead.
fn iso10126_pad(data: any, blocksize: int, seed: int) -> any
    let n = len(data)
    let padlen = pad_length(n, blocksize)
    let out = []
    let i = 0
    while i < n
        push(out, data[i])
        i = i + 1
    let j = 0
    while j < padlen - 1
        push(out, _pseudo_byte(seed, j))
        j = j + 1
    push(out, padlen)
    out

// iso10126_unpad: Remove ISO 10126 padding. Only the last byte matters (it holds N).
fn iso10126_unpad(data: any) -> any
    let n = len(data)
    if n == 0
        return []
    let padlen = data[n - 1]
    let out = []
    let i = 0
    let keep = n - padlen
    while i < keep
        push(out, data[i])
        i = i + 1
    out

// zero_pad: Append zero bytes until length is a multiple of blocksize.
// If already aligned, no bytes are appended (unlike PKCS#7, zero-pad may be a no-op).
fn zero_pad(data: any, blocksize: int) -> any
    let n = len(data)
    let rm = n % blocksize
    let out = []
    let i = 0
    while i < n
        push(out, data[i])
        i = i + 1
    if rm != 0
        let pad = blocksize - rm
        let j = 0
        while j < pad
            push(out, 0)
            j = j + 1
    out

// zero_unpad: Strip trailing zero bytes from data.
fn zero_unpad(data: any) -> any
    let n = len(data)
    let end = n
    while end > 0 and data[end - 1] == 0
        end = end - 1
    let out = []
    let i = 0
    while i < end
        push(out, data[i])
        i = i + 1
    out
