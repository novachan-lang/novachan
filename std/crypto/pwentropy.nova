// pwentropy -- password strength and entropy estimation.
// Provides charset-based entropy, Shannon entropy, diversity scoring,
// common-password detection, pattern detection, and a crack-time label.

// Returns the size of the character class alphabet used in pw.
fn pw_charset_size(pw: string) -> int
    let has_lower = false
    let has_upper = false
    let has_digit = false
    let has_symbol = false
    let i = 0
    while i < len(pw)
        let c = ord(slice(pw, i, i+1))
        if c >= 97 and c <= 122
            has_lower = true
        if c >= 65 and c <= 90
            has_upper = true
        if c >= 48 and c <= 57
            has_digit = true
        if c >= 33 and c <= 126 and not (c >= 97 and c <= 122) and not (c >= 65 and c <= 90) and not (c >= 48 and c <= 57)
            has_symbol = true
        i = i + 1
    let sz = 0
    if has_lower
        sz = sz + 26
    if has_upper
        sz = sz + 26
    if has_digit
        sz = sz + 10
    if has_symbol
        sz = sz + 33
    sz

// Returns the number of distinct character classes present (0..4).
fn pw_diversity_score(pw: string) -> int
    let has_lower = false
    let has_upper = false
    let has_digit = false
    let has_symbol = false
    let i = 0
    while i < len(pw)
        let c = ord(slice(pw, i, i+1))
        if c >= 97 and c <= 122
            has_lower = true
        if c >= 65 and c <= 90
            has_upper = true
        if c >= 48 and c <= 57
            has_digit = true
        if c >= 33 and c <= 126 and not (c >= 97 and c <= 122) and not (c >= 65 and c <= 90) and not (c >= 48 and c <= 57)
            has_symbol = true
        i = i + 1
    let score = 0
    if has_lower
        score = score + 1
    if has_upper
        score = score + 1
    if has_digit
        score = score + 1
    if has_symbol
        score = score + 1
    score

// Returns the number of bits of entropy: len(pw) * log2(charset_size).
fn pw_entropy_bits(pw: string) -> float
    let cs = pw_charset_size(pw)
    if cs <= 1
        return 0.0
    let n = len(pw)
    let log2cs = log(cs * 1.0) / 0.6931471805599453
    let bits = n * 1.0 * log2cs
    bits

// Returns the Shannon entropy (in bits) of pw: -sum(p_i * log2(p_i)) * len(pw).
fn pw_shannon_bits(pw: string) -> float
    let n = len(pw)
    if n == 0
        return 0.0
    // count each char
    let counts = {}
    let i = 0
    while i < len(pw)
        let ch = slice(pw, i, i+1)
        if contains(counts, ch)
            counts[ch] = counts[ch] + 1
        else
            counts[ch] = 1
        i = i + 1
    // compute -sum p*log2(p)
    let entropy = 0.0
    let ks = keys(counts)
    let j = 0
    while j < len(ks)
        let k = ks[j]
        let cnt = counts[k]
        let p = cnt * 1.0 / (n * 1.0)
        let logp = log(p) / 0.6931471805599453
        entropy = entropy - p * logp
        j = j + 1
    let sh = entropy * (n * 1.0)
    sh

// Returns true if pw is in the built-in list of ~20 common passwords.
fn pw_is_common(pw: string) -> bool
    let common = ["password","123456","123456789","qwerty","abc123","111111","letmein","admin","welcome","monkey","dragon","master","login","princess","solo","passw0rd","starwars","iloveyou","000000","qwerty123"]
    let i = 0
    while i < len(common)
        if pw == common[i]
            return true
        i = i + 1
    false

// Returns true if pw contains 3 or more ascending consecutive characters (e.g. abc, 123).
fn pw_has_sequence(pw: string) -> bool
    if len(pw) < 3
        return false
    let i = 0
    while i < len(pw) - 2
        let a = ord(slice(pw, i, i+1))
        let b = ord(slice(pw, i+1, i+2))
        let c = ord(slice(pw, i+2, i+3))
        if b == a + 1 and c == b + 1
            return true
        i = i + 1
    false

// Returns true if pw contains 3 identical characters in a row (e.g. aaa).
fn pw_has_repeat(pw: string) -> bool
    if len(pw) < 3
        return false
    let i = 0
    while i < len(pw) - 2
        let a = ord(slice(pw, i, i+1))
        let b = ord(slice(pw, i+1, i+2))
        let c = ord(slice(pw, i+2, i+3))
        if a == b and b == c
            return true
        i = i + 1
    false

// Returns adjusted entropy after applying penalties for common/sequence/repeat patterns, floor at 0.0.
fn pw_adjusted_entropy(pw: string) -> float
    let base = pw_entropy_bits(pw)
    let result = base
    if pw_is_common(pw)
        result = result - 10.0
    if pw_has_sequence(pw)
        result = result - 8.0
    if pw_has_repeat(pw)
        result = result - 8.0
    if result < 0.0
        result = 0.0
    result

// Returns a human-readable crack-difficulty label based on entropy bits.
fn pw_crack_label(bits: float) -> string
    if bits < 28.0
        return "instant"
    if bits < 36.0
        return "weak"
    if bits < 60.0
        return "reasonable"
    if bits < 128.0
        return "strong"
    "very strong"

// Returns the minimum password length needed to achieve target bits of entropy for the given charset_size.
fn pw_min_length_for_bits(target: int, charset_size: int) -> int
    if charset_size <= 1
        return 0
    let log2cs = log(charset_size * 1.0) / 0.6931471805599453
    let raw = target * 1.0 / log2cs
    let n = int(raw)
    if n * 1.0 * log2cs < target * 1.0
        n = n + 1
    n

// Returns a strength score 0..100 derived from adjusted entropy (bits * 1.5, clamped to 100).
fn pw_strength_score(pw: string) -> int
    let adj = pw_adjusted_entropy(pw)
    let score = adj * 1.5
    let iscore = int(score)
    if iscore > 100
        iscore = 100
    if iscore < 0
        iscore = 0
    iscore
