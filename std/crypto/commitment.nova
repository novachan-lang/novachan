// std/crypto/commitment — hash-based commitments using a private 63-bit polynomial hash.
// A commitment scheme allows a party to commit to a value without revealing it, then later
// open (reveal) it, proving the value was fixed at commit time.
// All commitments are 63-bit non-negative ints (well-defined, never negative).

// Private 63-bit hash: h=1125899906842597; for each byte b: h = (h*131 + b) & 0x7FFFFFFFFFFFFFFF.
// Accepts either a byte-list (list of ints 0..255) or a string (hashes ord() of each char).
fn _h63(input: any) -> int
    let h = 1125899906842597
    let n = len(input)
    for i in 0..n
        let b = 0
        if type_of(input) == "string"
            b = ord(char_at(input, i))
        else
            b = input[i]
        h = (h * 131 + b) & 0x7FFFFFFFFFFFFFFF
    h

// Convert a string or byte-list to a list of ints (bytes).
fn _to_bytes(v: any) -> any
    let result = []
    let n = len(v)
    for i in 0..n
        if type_of(v) == "string"
            push(result, ord(char_at(v, i)))
        else
            push(result, v[i])
    result

// Concatenate two byte-lists into one.
fn _cat(a: any, b: any) -> any
    let out = []
    let n = len(a)
    let i = 0
    while i < n
        push(out, a[i])
        i = i + 1
    let m = len(b)
    i = 0
    while i < m
        push(out, b[i])
        i = i + 1
    out

// Encode a 63-bit int as 8 little-endian bytes (for use in hash input).
fn _int_to_bytes8(x: int) -> any
    let out = []
    for i in 0..8
        push(out, x & 0xFF)
        x = (x >> 8) & 0x7FFFFFFFFFFFFFFF
    out

// commit(value, nonce) -> 63-bit int commitment: _h63(nonce_bytes ++ value_bytes).
// Both value and nonce may be strings or byte-lists.
fn commit(value: any, nonce: any) -> int
    let nb = _to_bytes(nonce)
    let vb = _to_bytes(value)
    _h63(_cat(nb, vb))

// commit_open(commitment, value, nonce) -> bool: constant-time-ish recompute and compare.
// Uses == (single integer comparison) — constant time on ints.
fn commit_open(commitment: int, value: any, nonce: any) -> bool
    let recomputed = commit(value, nonce)
    commitment == recomputed

// commit_str(value, nonce) -> 16 lowercase hex chars representing the 63-bit commitment.
fn commit_str(value: any, nonce: any) -> string
    let c = commit(value, nonce)
    let digs = "0123456789abcdef"
    let out_parts = []
    let i = 0
    while i < 16
        let nibble = (c >> (60 - i * 4)) & 0xF
        push(out_parts, char_at(digs, nibble))
        i = i + 1
    let out = join(out_parts, "")
    out

// commit_int(value: int, nonce) -> int: typed variant for integer values.
// Encodes value as 8 little-endian bytes, then commits.
fn commit_int(value: int, nonce: any) -> int
    let vb = _int_to_bytes8(value)
    let nb = _to_bytes(nonce)
    _h63(_cat(nb, vb))

// commit_bytes(bytes, nonce) -> int: typed variant for byte-lists.
fn commit_bytes(bts: any, nonce: any) -> int
    commit(bts, nonce)

// gen_nonce_from_seed(seed: int) -> int: deterministic nonce = _h63 of [seed&0xFF, (seed>>8)&0xFF, ...].
fn gen_nonce_from_seed(seed: int) -> int
    let nb = []
    push(nb, seed & 0xFF)
    push(nb, (seed >> 8) & 0xFF)
    push(nb, (seed >> 16) & 0xFF)
    push(nb, (seed >> 24) & 0xFF)
    _h63(nb)

// batch_commit(values, nonces) -> list of int commitments: values[i] with nonces[i].
fn batch_commit(values: any, nonces: any) -> any
    let n = len(values)
    let out = [commit(values[i], nonces[i]) for i in 0..n]
    out

// batch_verify(commitments, values, nonces) -> bool: true iff all commitments match.
fn batch_verify(commitments: any, values: any, nonces: any) -> bool
    let n = len(commitments)
    if len(values) != n
        return false
    if len(nonces) != n
        return false
    let i = 0
    while i < n
        let expected = commit(values[i], nonces[i])
        if commitments[i] != expected
            return false
        i = i + 1
    true

// commit_chain(values) -> int: hash chain where h_0=_h63(values[0]) and
// h_i = _h63( int_to_bytes8(h_{i-1}) ++ bytes(values[i]) ). Returns the final hash.
fn commit_chain(values: any) -> int
    let n = len(values)
    if n == 0
        return _h63([])
    let h = _h63(_to_bytes(values[0]))
    for i in 1..n
        let hb = _int_to_bytes8(h)
        let vb = _to_bytes(values[i])
        h = _h63(_cat(hb, vb))
    h

// commit_chain_verify(values, final) -> bool: recompute chain and compare to final.
fn commit_chain_verify(values: any, final: int) -> bool
    let recomputed = commit_chain(values)
    recomputed == final

// commit_equal(c1, c2) -> bool: compare two commitments (constant-time int ==).
fn commit_equal(c1: int, c2: int) -> bool
    c1 == c2
