fn fib(n)
    if n <= 1
        return n
    return fib(n - 1) + fib(n - 2)

fn count_primes(limit)
    let count = 0
    let n = 2
    while n <= limit
        let is_p = 1
        let d = 2
        while d * d <= n
            if n % d == 0
                is_p = 0
            d = d + 1
        if is_p == 1
            count = count + 1
        n = n + 1
    count

fn sum_squares(n)
    let sum = 0
    let i = 0
    while i < n
        sum = sum + i * i
        i = i + 1
    sum

fn main()
    let t1 = time_ms()
    let f = fib(40)
    let t2 = time_ms()
    print("fib(40) = " + str(f) + "  [" + str(t2 - t1) + "ms]")

    let t3 = time_ms()
    let p = count_primes(100000)
    let t4 = time_ms()
    print("primes <= 100000: " + str(p) + "  [" + str(t4 - t3) + "ms]")

    let t5 = time_ms()
    let s = sum_squares(10000000)
    let t6 = time_ms()
    print("sum_squares(10M) = " + str(s) + "  [" + str(t6 - t5) + "ms]")
