// NOVA Snake Game — Terminal Edition
// Zero type annotations. Clean, readable, native speed.

type Point
    x: Int
    y: Int

fn Point.eq(other)
    self.x == other.x and self.y == other.y

fn Point.to_string()
    "(" + str(self.x) + "," + str(self.y) + ")"

enum Direction
    Up()
    Down()
    Left()
    Right()

type GameState
    snake: List
    dir: Direction
    food: Point
    score: Int
    width: Int
    height: Int
    alive: Int
    ticks: Int

fn make_state(snake, dir, food, score, w, h, alive, ticks)
    GameState { snake: snake, dir: dir, food: food, score: score, width: w, height: h, alive: alive, ticks: ticks }

fn direction_dx(d)
    match d
        Left(_)  => -1
        Right(_) => 1
        _        => 0

fn direction_dy(d)
    match d
        Up(_)   => -1
        Down(_) => 1
        _       => 0

fn opposite_dir(d1, d2)
    dx1 = direction_dx(d1)
    dy1 = direction_dy(d1)
    dx2 = direction_dx(d2)
    dy2 = direction_dy(d2)
    dx1 + dx2 == 0 and dy1 + dy2 == 0

_rng_state = 42

fn rand_next()
    _rng_state = (_rng_state * 1103515245 + 12345) % 2147483648
    _rng_state

fn rand_range(lo, hi)
    r = rand_next()
    if r < 0
        r = -r
    lo + (r % (hi - lo))

fn list_contains_point(lst, px, py)
    i = 0
    while i < len(lst)
        if lst[i].x == px and lst[i].y == py
            return 1
        i = i + 1
    return 0

fn spawn_food(snake, w, h)
    tries = 0
    while tries < 1000
        fx = rand_range(0, w)
        fy = rand_range(0, h)
        if list_contains_point(snake, fx, fy) == 0
            return Point { x: fx, y: fy }
        tries = tries + 1
    Point { x: 0, y: 0 }

fn new_game(w, h)
    cx = w / 2
    cy = h / 2
    snake = [Point { x: cx, y: cy }, Point { x: cx - 1, y: cy }, Point { x: cx - 2, y: cy }]
    food = spawn_food(snake, w, h)
    make_state(snake, Right(), food, 0, w, h, 1, 0)

fn tick(game, new_dir)
    if game.alive == 0
        return game
    dir = game.dir
    if opposite_dir(dir, new_dir) == 0
        dir = new_dir
    head = game.snake[0]
    nx = head.x + direction_dx(dir)
    ny = head.y + direction_dy(dir)
    if nx < 0 or nx >= game.width or ny < 0 or ny >= game.height
        return make_state(game.snake, dir, game.food, game.score, game.width, game.height, 0, game.ticks + 1)
    if list_contains_point(game.snake, nx, ny)
        return make_state(game.snake, dir, game.food, game.score, game.width, game.height, 0, game.ticks + 1)
    new_head = Point { x: nx, y: ny }
    ate = new_head.x == game.food.x and new_head.y == game.food.y
    new_snake = [new_head]
    limit = len(game.snake)
    if ate == 0
        limit = limit - 1
    i = 0
    while i < limit
        new_snake = new_snake + [game.snake[i]]
        i = i + 1
    new_score = game.score
    new_food = game.food
    if ate
        new_score = new_score + 10
        new_food = spawn_food(new_snake, game.width, game.height)
    make_state(new_snake, dir, new_food, new_score, game.width, game.height, 1, game.ticks + 1)

fn render(game)
    top = "+"
    i = 0
    while i < game.width
        top = top + "--"
        i = i + 1
    top = top + "+"
    print(top)
    y = 0
    while y < game.height
        row = "|"
        x = 0
        while x < game.width
            if x == game.snake[0].x and y == game.snake[0].y
                row = row + "@@"
            else if list_contains_point(game.snake, x, y)
                row = row + "##"
            else if x == game.food.x and y == game.food.y
                row = row + "<>"
            else
                row = row + "  "
            x = x + 1
        row = row + "|"
        print(row)
        y = y + 1
    print(top)
    print("  Score: " + str(game.score) + "  |  Length: " + str(len(game.snake)) + "  |  Tick: " + str(game.ticks))

fn auto_dir(game)
    head = game.snake[0]
    dx = game.food.x - head.x
    dy = game.food.y - head.y
    result = game.dir
    if abs(dx) >= abs(dy)
        if dx > 0
            result = Right()
        else if dx < 0
            result = Left()
    else
        if dy > 0
            result = Down()
        else if dy < 0
            result = Up()
    result

fn main()
    print("========================================")
    print("  NOVA Snake Game -- Auto-Play Demo")
    print("  Zero type annotations. Native speed.")
    print("========================================")
    print("")
    game = new_game(20, 15)
    render(game)
    step = 0
    while step < 60 and game.alive
        d = auto_dir(game)
        game = tick(game, d)
        if step % 10 == 9
            print("")
            print("--- After " + str(step + 1) + " moves ---")
            render(game)
        step = step + 1
    print("")
    if game.alive
        print("Game still running after " + str(game.ticks) + " ticks!")
    else
        print("Game over at tick " + str(game.ticks) + "!")
    print("Final score: " + str(game.score))
    print("Final length: " + str(len(game.snake)))

main()
