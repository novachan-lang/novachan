// NOVA Snake — Smart Auto-Play with ANSI Terminal
// Zero type annotations. Smart AI. Real-time animation. Native speed.

fn clear()
    esc = chr(27)
    print(esc + "[2J" + esc + "[H")

fn color(code, text)
    esc = chr(27)
    esc + "[" + str(code) + "m" + text + esc + "[0m"

// ── Data Types ──────────────────────────

type Point
    x: Int
    y: Int

enum Direction
    Up()
    Down()
    Left()
    Right()

type Game
    snake: List
    dir: Direction
    food: Point
    score: Int
    width: Int
    height: Int
    alive: Int
    ticks: Int

// ── Direction Helpers ───────────────────

fn dir_dx(d)
    match d
        Left(_)  => -1
        Right(_) => 1
        _        => 0

fn dir_dy(d)
    match d
        Up(_)   => -1
        Down(_) => 1
        _       => 0

fn is_opposite(d1, d2)
    dir_dx(d1) + dir_dx(d2) == 0 and dir_dy(d1) + dir_dy(d2) == 0

// ── Grid Helpers ────────────────────────

fn has_point(lst, px, py)
    i = 0
    while i < len(lst)
        if lst[i].x == px and lst[i].y == py
            return 1
        i = i + 1
    return 0

fn is_safe(snake, x, y, w, h)
    if x < 0 or x >= w or y < 0 or y >= h
        return 0
    if has_point(snake, x, y)
        return 0
    return 1

fn open_around(snake, x, y, w, h)
    n = 0
    if is_safe(snake, x - 1, y, w, h)
        n = n + 1
    if is_safe(snake, x + 1, y, w, h)
        n = n + 1
    if is_safe(snake, x, y - 1, w, h)
        n = n + 1
    if is_safe(snake, x, y + 1, w, h)
        n = n + 1
    n

// ── Food Spawning ───────────────────────

fn place_food(snake, w, h)
    t = 0
    while t < 1000
        fx = random_int(0, w - 1)
        fy = random_int(0, h - 1)
        if has_point(snake, fx, fy) == 0
            return Point { x: fx, y: fy }
        t = t + 1
    Point { x: 0, y: 0 }

// ── Game State ──────────────────────────

fn make_game(snake, dir, food, score, w, h, alive, ticks)
    Game { snake: snake, dir: dir, food: food, score: score, width: w, height: h, alive: alive, ticks: ticks }

fn new_game(w, h)
    cx = w / 2
    cy = h / 2
    snake = [Point { x: cx, y: cy }, Point { x: cx - 1, y: cy }, Point { x: cx - 2, y: cy }]
    food = place_food(snake, w, h)
    make_game(snake, Right(), food, 0, w, h, 1, 0)

// ── Game Logic ──────────────────────────

fn tick(g, new_dir)
    if g.alive == 0
        return g

    dir = g.dir
    if is_opposite(dir, new_dir) == 0
        dir = new_dir

    head = g.snake[0]
    nx = head.x + dir_dx(dir)
    ny = head.y + dir_dy(dir)

    if nx < 0 or nx >= g.width or ny < 0 or ny >= g.height
        return make_game(g.snake, dir, g.food, g.score, g.width, g.height, 0, g.ticks + 1)

    if has_point(g.snake, nx, ny)
        return make_game(g.snake, dir, g.food, g.score, g.width, g.height, 0, g.ticks + 1)

    new_head = Point { x: nx, y: ny }
    ate = new_head.x == g.food.x and new_head.y == g.food.y

    new_snake = [new_head]
    limit = len(g.snake)
    if ate == 0
        limit = limit - 1
    i = 0
    while i < limit
        new_snake = new_snake + [g.snake[i]]
        i = i + 1

    new_score = g.score
    new_food = g.food
    if ate
        new_score = new_score + 10
        new_food = place_food(new_snake, g.width, g.height)

    make_game(new_snake, dir, new_food, new_score, g.width, g.height, 1, g.ticks + 1)

// ── Smart AI ────────────────────────────

fn smart_dir(g)
    head = g.snake[0]
    best = g.dir
    best_score = 99999
    found = 0

    dirs = [Up(), Down(), Left(), Right()]
    i = 0
    while i < 4
        d = dirs[i]
        if is_opposite(g.dir, d) == 0
            nx = head.x + dir_dx(d)
            ny = head.y + dir_dy(d)
            if is_safe(g.snake, nx, ny, g.width, g.height)
                dist = abs(nx - g.food.x) + abs(ny - g.food.y)
                open = open_around(g.snake, nx, ny, g.width, g.height)
                s = dist * 10 - open
                if found == 0 or s < best_score
                    best = d
                    best_score = s
                    found = 1
        i = i + 1

    if found
        return best

    i = 0
    while i < 4
        d = dirs[i]
        nx = head.x + dir_dx(d)
        ny = head.y + dir_dy(d)
        if is_safe(g.snake, nx, ny, g.width, g.height)
            return d
        i = i + 1

    g.dir

// ── Speed ───────────────────────────────

fn speed(score)
    ms = 150 - score / 2
    if ms < 50
        ms = 50
    ms

// ── Rendering ───────────────────────────

fn render(g, round, best)
    esc = chr(27)
    print(esc + "[H")

    ms = speed(g.score)
    print(color(36, " NOVA SNAKE ") + color(90, "|") + color(33, " Score: " + str(g.score)) + " " + color(90, "|") + " Len: " + str(len(g.snake)) + " " + color(90, "|") + " Speed: " + str(ms) + "ms " + color(90, "|") + " Round: " + str(round) + "/3 " + color(90, "|") + color(35, " Best: " + str(best)) + "          ")
    print("")

    border = color(90, "+")
    bi = 0
    while bi < g.width
        border = border + color(90, "--")
        bi = bi + 1
    border = border + color(90, "+")
    print(border)

    y = 0
    while y < g.height
        row = color(90, "|")
        x = 0
        while x < g.width
            if x == g.snake[0].x and y == g.snake[0].y
                row = row + color(92, "@@")
            else if has_point(g.snake, x, y)
                row = row + color(32, "##")
            else if x == g.food.x and y == g.food.y
                row = row + color(91, "<>")
            else
                row = row + "  "
            x = x + 1
        row = row + color(90, "|")
        print(row)
        y = y + 1

    print(border)
    if g.alive
        print(color(90, " AI: chase food + avoid walls/body + prefer open space      "))
    else
        print(color(91, " CRASHED!") + " Final score: " + color(33, str(g.score)) + "                                  ")

// ── Main ────────────────────────────────

fn main()
    clear()
    print("")
    print(color(36, "  +======================================+"))
    print(color(36, "  |") + color(92, "        NOVA SNAKE GAME              ") + color(36, "|"))
    print(color(90, "  |  Zero annotations. Native speed.    |"))
    print(color(90, "  |  Smart AI. 3 rounds. ANSI color.    |"))
    print(color(36, "  +======================================+"))
    print("")
    print("  Starting in 2 seconds...")
    sleep(2000)
    clear()

    best = 0
    round = 1
    while round <= 3
        g = new_game(20, 15)

        while g.alive
            render(g, round, best)
            d = smart_dir(g)
            g = tick(g, d)
            sleep(speed(g.score))

        if g.score > best
            best = g.score

        render(g, round, best)

        if round < 3
            print("")
            print(color(90, "  Next round in 3 seconds..."))
            sleep(3000)
            clear()

        round = round + 1

    print("")
    print(color(36, "  +================================+"))
    print(color(33, "  BEST SCORE: " + str(best)) + " across 3 rounds")
    print(color(36, "  +================================+"))
    print("")

main()
