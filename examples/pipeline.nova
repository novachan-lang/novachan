// DEMO 2 — a concurrent work pipeline in under 50 lines.
//
//   nova run pipeline.nova
//
// Shows: spawn, channels, fan-out to N workers, fan-in of results.
// Processes are NOVA's ONE concurrency primitive — the same `spawn` scales from a green task
// here to a distributed node, and values are deep-copied across channels so there is no shared
// mutable state to race on. If a program never spawns, the whole runtime compiles away.

fn is_prime(n: int) -> bool
    if n < 2
        return false
    if n % 2 == 0
        return n == 2
    let d = 3
    while d * d <= n
        if n % d == 0
            return false
        d = d + 2
    true

// One worker: pull a chunk off `jobs`, count primes in it, push the count to `results`.
fn worker(jobs, results)
    let chunk = recv(jobs)
    let lo = chunk[0]
    let hi = chunk[1]
    let found = 0
    for n in lo..hi
        if is_prime(n)
            found = found + 1
    send(results, found)

fn main()
    let workers = 4
    let span = 25000
    let jobs = channel()
    let results = channel()

    // Fan out: one green task per worker.
    for w in 0..workers
        spawn worker(jobs, results)

    // Hand each worker a disjoint slice of the range.
    for w in 0..workers
        send(jobs, [w * span, (w + 1) * span])

    // Fan in: every worker reports exactly once, so we know how many to collect.
    let total = 0
    for w in 0..workers
        total = total + recv(results)

    print("primes below {workers * span}: {total}")
