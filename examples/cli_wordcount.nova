// DEMO 1 — a real CLI tool in 30 lines.
//
//   nova run cli_wordcount.nova <file>
//
// Shows: args(), file IO, Result + `?`, dicts, sorting by a key, string interpolation.
// Note there are no type annotations on locals — the compiler infers all of them.

fn count_words(text: string) -> dict
    // Turn every run of whitespace into a plain space FIRST, so "dog\nthe" splits into two
    // words instead of collapsing into "dogthe". (Stripping the newline after splitting is the
    // tempting version, and it is wrong.)
    let flat = replace(replace(replace(lower(text), "\r", " "), "\n", " "), "\t", " ")
    let counts = {}
    for raw in split(flat, " ")
        let w = trim(raw)
        if len(w) > 0
            if contains(counts, w)
                counts[w] = counts[w] + 1
            else
                counts[w] = 1
    counts

fn top_words(counts: dict, n: int) -> list
    // Sort the (word, count) pairs by count, descending. sort_by takes the key function.
    let pairs = [[w, counts[w]] for w in keys(counts)]
    let ranked = sort_by(pairs, fn(p) 0 - p[1])
    if len(ranked) < n
        return ranked
    ranked[0:n]

fn main()
    let argv = args()
    if len(argv) < 2
        print("usage: cli_wordcount <file>")
        return 0
    let path = argv[1]
    let text = read_file(path)
    if len(text) == 0
        print("error: could not read {path} (missing or empty)")
        return 0
    let counts = count_words(text)
    print("{len(keys(counts))} distinct words in {path}")
    for pair in top_words(counts, 5)
        print("  {pair[0]}: {pair[1]}")
