import prism_ui_spinner
import prism_node
import prism_content

fn _check(label: string, cond: bool) -> bool
    if cond
        print("PASS " + label)
        return true
    print("FAIL " + label)
    false

fn main()
    let mut total = 0
    let mut passed = 0

    let frame_chars = ["|", "/", "-", "\\"]

    // --- prism_sp_spinner: frame cycling (covers wrap at frame=4,5) ---
    let mut f = 0
    while f < 6
        let r = prism_ui_spinner.prism_sp_spinner(f)
        total = total + 1
        if _check("prism_sp_spinner ok frame=" + str(f), is_ok(r))
            passed = passed + 1

        let n = unwrap(r)
        let expected = frame_chars[f % 4]
        total = total + 1
        if _check("prism_sp_spinner char frame=" + str(f) + " == " + expected, prism_node.prism_node_attr_str(n, "text", "??") == expected)
            passed = passed + 1
        f += 1

    let r_sp0 = prism_ui_spinner.prism_sp_spinner(0)
    let n_sp0 = unwrap(r_sp0)
    total = total + 1
    if _check("prism_sp_spinner kind_str == label", prism_node.prism_node_kind_str(n_sp0) == "label")
        passed = passed + 1

    let e_sp = prism_ui_spinner.prism_sp_spinner(-1)
    total = total + 1
    if _check("prism_sp_spinner negative frame is_err", is_err(e_sp))
        passed = passed + 1
    total = total + 1
    if _check("prism_sp_spinner negative frame text", unwrap_err(e_sp) == "prism_sp_spinner: frame must be >= 0")
        passed = passed + 1

    // --- prism_sp_loading ---
    let r_load = prism_ui_spinner.prism_sp_loading("Loading data", 0)
    total = total + 1
    if _check("prism_sp_loading ok", is_ok(r_load))
        passed = passed + 1

    let n_load = unwrap(r_load)
    total = total + 1
    if _check("prism_sp_loading kind_str == band", prism_node.prism_node_kind_str(n_load) == "band")
        passed = passed + 1

    let load_children = prism_node.prism_node_children(n_load)
    total = total + 1
    if _check("prism_sp_loading children count == 3", len(load_children) == 3)
        passed = passed + 1

    total = total + 1
    if _check("prism_sp_loading child0 is label (spinner)", prism_node.prism_node_kind_str(load_children[0]) == "label")
        passed = passed + 1

    total = total + 1
    if _check("prism_sp_loading child1 is gap", prism_node.prism_node_kind_str(load_children[1]) == "gap")
        passed = passed + 1

    total = total + 1
    if _check("prism_sp_loading child2 is label (message)", prism_node.prism_node_kind_str(load_children[2]) == "label")
        passed = passed + 1

    total = total + 1
    if _check("prism_sp_loading message text matches", prism_node.prism_node_attr_str(load_children[2], "text", "??") == "Loading data")
        passed = passed + 1

    let e_load = prism_ui_spinner.prism_sp_loading("", 0)
    total = total + 1
    if _check("prism_sp_loading empty message is_err", is_err(e_load))
        passed = passed + 1
    total = total + 1
    if _check("prism_sp_loading empty message text", unwrap_err(e_load) == "prism_sp_loading: message must not be empty")
        passed = passed + 1

    // --- prism_sp_dots: cycling 1/2/3/wrap dots ---
    let mut d = 0
    while d < 5
        let r = prism_ui_spinner.prism_sp_dots(d)
        total = total + 1
        if _check("prism_sp_dots ok frame=" + str(d), is_ok(r))
            passed = passed + 1

        let n = unwrap(r)
        let expected_count = (d % 3) + 1
        let mut expected_dots = ""
        let mut k = 0
        while k < expected_count
            expected_dots = expected_dots + "."
            k += 1
        total = total + 1
        if _check("prism_sp_dots text frame=" + str(d) + " == " + expected_dots, prism_node.prism_node_attr_str(n, "text", "??") == expected_dots)
            passed = passed + 1
        d += 1

    let r_dots0 = prism_ui_spinner.prism_sp_dots(0)
    let n_dots0 = unwrap(r_dots0)
    total = total + 1
    if _check("prism_sp_dots kind_str == label", prism_node.prism_node_kind_str(n_dots0) == "label")
        passed = passed + 1

    let e_dots = prism_ui_spinner.prism_sp_dots(-1)
    total = total + 1
    if _check("prism_sp_dots negative frame is_err", is_err(e_dots))
        passed = passed + 1
    total = total + 1
    if _check("prism_sp_dots negative frame text", unwrap_err(e_dots) == "prism_sp_dots: frame must be >= 0")
        passed = passed + 1

    // --- prism_sp_progress ---
    let r_p1 = prism_ui_spinner.prism_sp_progress(50, 100, 0)
    total = total + 1
    if _check("prism_sp_progress ok 50/100", is_ok(r_p1))
        passed = passed + 1
    let n_p1 = unwrap(r_p1)
    total = total + 1
    if _check("prism_sp_progress kind_str == band", prism_node.prism_node_kind_str(n_p1) == "band")
        passed = passed + 1
    let p1_children = prism_node.prism_node_children(n_p1)
    total = total + 1
    if _check("prism_sp_progress children count == 3 (spinner, gap, pct)", len(p1_children) == 3)
        passed = passed + 1
    total = total + 1
    if _check("prism_sp_progress 50/100 == 50%", prism_node.prism_node_attr_str(p1_children[2], "text", "??") == "50%")
        passed = passed + 1

    let r_p2 = prism_ui_spinner.prism_sp_progress(0, 100, 0)
    let n_p2 = unwrap(r_p2)
    let p2_children = prism_node.prism_node_children(n_p2)
    total = total + 1
    if _check("prism_sp_progress 0/100 == 0%", prism_node.prism_node_attr_str(p2_children[2], "text", "??") == "0%")
        passed = passed + 1

    let r_p3 = prism_ui_spinner.prism_sp_progress(100, 100, 0)
    let n_p3 = unwrap(r_p3)
    let p3_children = prism_node.prism_node_children(n_p3)
    total = total + 1
    if _check("prism_sp_progress 100/100 == 100%", prism_node.prism_node_attr_str(p3_children[2], "text", "??") == "100%")
        passed = passed + 1

    let r_p4 = prism_ui_spinner.prism_sp_progress(150, 100, 0)
    let n_p4 = unwrap(r_p4)
    let p4_children = prism_node.prism_node_children(n_p4)
    total = total + 1
    if _check("prism_sp_progress clamped 150/100 == 100%", prism_node.prism_node_attr_str(p4_children[2], "text", "??") == "100%")
        passed = passed + 1

    let e_p1 = prism_ui_spinner.prism_sp_progress(1, 0, 0)
    total = total + 1
    if _check("prism_sp_progress total==0 is_err", is_err(e_p1))
        passed = passed + 1
    total = total + 1
    if _check("prism_sp_progress total==0 text", unwrap_err(e_p1) == "prism_sp_progress: total must be > 0")
        passed = passed + 1

    let e_p2 = prism_ui_spinner.prism_sp_progress(1, -5, 0)
    total = total + 1
    if _check("prism_sp_progress total<0 is_err", is_err(e_p2))
        passed = passed + 1
    total = total + 1
    if _check("prism_sp_progress total<0 text", unwrap_err(e_p2) == "prism_sp_progress: total must be > 0")
        passed = passed + 1

    let e_p3 = prism_ui_spinner.prism_sp_progress(-1, 100, 0)
    total = total + 1
    if _check("prism_sp_progress current<0 is_err", is_err(e_p3))
        passed = passed + 1
    total = total + 1
    if _check("prism_sp_progress current<0 text", unwrap_err(e_p3) == "prism_sp_progress: current must be >= 0")
        passed = passed + 1

    // --- prism_sp_overlay ---
    let body_label = unwrap(prism_content.prism_label("Body content"))
    let content_list = [body_label]

    let r_ov1 = prism_ui_spinner.prism_sp_overlay(content_list, true, "Loading", 0)
    total = total + 1
    if _check("prism_sp_overlay loading=true ok", is_ok(r_ov1))
        passed = passed + 1
    let n_ov1 = unwrap(r_ov1)
    total = total + 1
    if _check("prism_sp_overlay loading=true kind_str == layer", prism_node.prism_node_kind_str(n_ov1) == "layer")
        passed = passed + 1
    let ov1_children = prism_node.prism_node_children(n_ov1)
    total = total + 1
    if _check("prism_sp_overlay loading=true children count == 2", len(ov1_children) == 2)
        passed = passed + 1
    total = total + 1
    if _check("prism_sp_overlay loading=true child0 is stack (body)", prism_node.prism_node_kind_str(ov1_children[0]) == "stack")
        passed = passed + 1
    total = total + 1
    if _check("prism_sp_overlay loading=true child1 is band (loader)", prism_node.prism_node_kind_str(ov1_children[1]) == "band")
        passed = passed + 1

    let r_ov2 = prism_ui_spinner.prism_sp_overlay(content_list, false, "Loading", 0)
    total = total + 1
    if _check("prism_sp_overlay loading=false ok", is_ok(r_ov2))
        passed = passed + 1
    let n_ov2 = unwrap(r_ov2)
    total = total + 1
    if _check("prism_sp_overlay loading=false kind_str == stack", prism_node.prism_node_kind_str(n_ov2) == "stack")
        passed = passed + 1
    let ov2_children = prism_node.prism_node_children(n_ov2)
    total = total + 1
    if _check("prism_sp_overlay loading=false children count == 1", len(ov2_children) == 1)
        passed = passed + 1

    let e_ov1 = prism_ui_spinner.prism_sp_overlay([], true, "Loading", 0)
    total = total + 1
    if _check("prism_sp_overlay empty content is_err", is_err(e_ov1))
        passed = passed + 1
    total = total + 1
    if _check("prism_sp_overlay empty content text", unwrap_err(e_ov1) == "prism_sp_overlay: content must not be empty")
        passed = passed + 1

    let e_ov2 = prism_ui_spinner.prism_sp_overlay([42], true, "Loading", 0)
    total = total + 1
    if _check("prism_sp_overlay non-PrismNode child is_err", is_err(e_ov2))
        passed = passed + 1
    total = total + 1
    if _check("prism_sp_overlay non-PrismNode child text mentions type", contains(unwrap_err(e_ov2), "not a PrismNode"))
        passed = passed + 1

    let e_ov3 = prism_ui_spinner.prism_sp_overlay(content_list, true, "", 0)
    total = total + 1
    if _check("prism_sp_overlay empty message when loading is_err", is_err(e_ov3))
        passed = passed + 1
    total = total + 1
    // Propagated through `?`, so the compiler wraps it with call-site context
    // ("in prism_sp_overlay at line N: ...") -- check the underlying message survives, not exact match.
    if _check("prism_sp_overlay empty message text carries underlying error", contains(unwrap_err(e_ov3), "prism_sp_loading: message must not be empty"))
        passed = passed + 1

    print("== " + str(passed) + "/" + str(total) + " assertions passed ==")
    if passed != total
        print("FAIL: KAT summary -- not all assertions passed")
