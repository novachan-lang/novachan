// KAT for prism/widget/prism_notice.nova -- toasts / snackbars / notification centre (#71).
//
// The two properties this exists for:
//   1. ★ AN ERROR NEVER AUTO-DISMISSES. Auto-dismissing an error is how a failure becomes
//      invisible: the user looks away for four seconds and the only report that something went
//      wrong is gone, with no way to get it back. Enforced in the CONSTRUCTOR, so a caller cannot
//      forget -- asserted for all four levels.
//   2. ★ QUEUE OVERFLOW EVICTS THE OLDEST *AUTO-DISMISSING* NOTICE, never the oldest outright.
//      Dropping the oldest unconditionally discards the error the user still needs while keeping
//      a "Saved!" that does not matter. When every slot requires acknowledgement, posting is
//      REFUSED -- the honest answer.

import prism_node
import prism_notice

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_notice ==")

    print("1. ★ dismissal policy is set by LEVEL, in the constructor")
    let info = unwrap(prism_notice.prism_nt_info("Saved"))
    let succ = unwrap(prism_notice.prism_nt_success("Done"))
    let warn = unwrap(prism_notice.prism_nt_warning("Disk almost full"))
    let erro = unwrap(prism_notice.prism_nt_error("Upload failed"))
    check("info auto-dismisses", prism_notice.prism_nt_auto_dismiss(info))
    check("success auto-dismisses", prism_notice.prism_nt_auto_dismiss(succ))
    // The two that must not vanish on their own.
    check("★ WARNING does NOT auto-dismiss", not prism_notice.prism_nt_auto_dismiss(warn))
    check("★ ERROR does NOT auto-dismiss", not prism_notice.prism_nt_auto_dismiss(erro))
    check("auto-dismissing notices carry a TTL", prism_notice.prism_nt_ttl_ms(info) == 4000)
    check("acknowledged notices have NO ttl (0)", prism_notice.prism_nt_ttl_ms(erro) == 0)
    check("levels are named", prism_notice.prism_nt_level_name(prism_notice.prism_nt_level(erro)) == "error")
    check("text is preserved", prism_notice.prism_nt_text(erro) == "Upload failed")
    check("empty text rejected", is_err(prism_notice.prism_nt_error("")))
    check("non-string text rejected", is_err(prism_notice.prism_nt_info(7)))

    print("2. queue basics")
    check("zero capacity rejected", is_err(prism_notice.prism_nt_queue(0)))
    check("non-int capacity rejected", is_err(prism_notice.prism_nt_queue("3")))
    let q0 = unwrap(prism_notice.prism_nt_queue(3))
    check("a fresh queue is empty", prism_notice.prism_nt_count(q0) == 0)
    let q1 = unwrap(prism_notice.prism_nt_post(q0, info))
    let q2 = unwrap(prism_notice.prism_nt_post(q1, succ))
    check("two posted", prism_notice.prism_nt_count(q2) == 2)
    check("order is preserved", prism_notice.prism_nt_text(unwrap(prism_notice.prism_nt_at(q2, 0))) == "Saved")
    // Posting is non-mutating -- these are values.
    check("the ORIGINAL queue is unchanged", prism_notice.prism_nt_count(q0) == 0)
    check("out-of-range index is an err", is_err(prism_notice.prism_nt_at(q2, 5)))

    print("3. ★ overflow evicts the oldest AUTO-DISMISSING notice")
    // Fill to capacity: [info, success, error]. The error must survive; the info must go.
    let q3 = unwrap(prism_notice.prism_nt_post(q2, erro))
    check("queue is full at 3", prism_notice.prism_nt_count(q3) == 3)
    check("one entry requires acknowledgement", prism_notice.prism_nt_pending_ack(q3) == 1)
    let q4 = unwrap(prism_notice.prism_nt_post(q3, unwrap(prism_notice.prism_nt_info("Later"))))
    check("still at capacity after overflow", prism_notice.prism_nt_count(q4) == 3)
    // The oldest AUTO-DISMISSING ("Saved") was evicted -- not the oldest outright.
    check("the oldest auto-dismissing was evicted", prism_notice.prism_nt_text(unwrap(prism_notice.prism_nt_at(q4, 0))) == "Done")
    check("★ the ERROR SURVIVED the overflow", prism_notice.prism_nt_text(unwrap(prism_notice.prism_nt_at(q4, 1))) == "Upload failed")
    check("the new notice is at the end", prism_notice.prism_nt_text(unwrap(prism_notice.prism_nt_at(q4, 2))) == "Later")

    print("4. ★ when every slot needs acknowledgement, posting is REFUSED")
    let e1 = unwrap(prism_notice.prism_nt_queue(2))
    let e2 = unwrap(prism_notice.prism_nt_post(e1, unwrap(prism_notice.prism_nt_error("first"))))
    let e3 = unwrap(prism_notice.prism_nt_post(e2, unwrap(prism_notice.prism_nt_warning("second"))))
    check("both slots require ack", prism_notice.prism_nt_pending_ack(e3) == 2)
    // Refusing is the honest answer: there is nothing droppable that the user has already seen.
    check("posting into an all-ack queue is REFUSED", is_err(prism_notice.prism_nt_post(e3, unwrap(prism_notice.prism_nt_info("third")))))
    check("...and it stays refused for another error too", is_err(prism_notice.prism_nt_post(e3, unwrap(prism_notice.prism_nt_error("fourth")))))
    // After an explicit dismissal there is room again.
    let e4 = unwrap(prism_notice.prism_nt_dismiss(e3, 0))
    check("dismissing frees a slot", prism_notice.prism_nt_count(e4) == 1)
    check("...and posting works again", not is_err(prism_notice.prism_nt_post(e4, unwrap(prism_notice.prism_nt_info("ok now")))))
    check("dismiss with a bad index is an err", is_err(prism_notice.prism_nt_dismiss(e3, 9)))
    check("dismiss is non-mutating", prism_notice.prism_nt_count(e3) == 2)

    print("5. a notice renders from the CLOSED vocabulary (A7)")
    let node = unwrap(prism_notice.prism_nt_node(erro))
    check("a notice is a band", prism_node.prism_node_kind_str(node) == "band")
    check("it holds the level tag and the message", prism_node.prism_node_child_count(node) == 2)
    check("the message text is present", prism_node.prism_node_attr_str(prism_node.prism_node_children(node)[1], "text", "") == "Upload failed")
    check("the level tag is present", prism_node.prism_node_attr_str(prism_node.prism_node_children(node)[0], "text", "") == "error")

    print("")
    if STATS[1] == 0
        print("_kat_prism_notice: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_notice: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
