// KAT for the FULL MA.3 widget layer composed together: prism/core/prism_node.nova +
// prism/widget/{prism_arrange, prism_content, prism_interact, prism_structure}.nova, all four
// in ONE program. Neither _kat_prism_widget_a.nova (arrange+content) nor
// _kat_prism_widget_b.nova (interact+structure) ever linked all four together -- this is the
// missing half of PRISM_ROADMAP.md's MA.3 exit criterion: "Each primitive has a KAT proving its
// node shape; a 3-level page composes."
//
// Proves, against concrete expected values:
//   1. Linking all four widget modules + prism_node into one program compiles and links clean
//      (the real test for the enum/struct-variant-name symbol-collision risk the milestone
//      review flagged -- PrismMeshTrack's Fixed/Fill/Fit, PrismIcon's 12 variants,
//      PrismEntryKind's 6, PrismLinkTarget's 2, PrismNodeKind's 22, plus prism_structure's own
//      reuse of prism_kind_band() for grid rows -- all in the SAME compiled unit at once).
//   2. A realistic 6-level app-screen page composes from primitives out of all four modules
//      (header band+glyph+label, a grid of data rows, a form with entry/pick/flag/range, a
//      sheet, tabs, a link) with EXACT hand-derived depth/count and child order at every level.
//   3. PRISM_SPEC.md §16 ("a typed error... never a crash") holds end-to-end: a hostile,
//      non-PrismNode child fed into a container primitive from EACH of the four modules
//      returns `is_err`, not a crash -- and the process survives to print every subsequent
//      assertion and a final PASSED line.
//   4. The §15.1 injection guarantee (`javascript:` rejected) survives composition: identical
//      helper code path, 4 levels deep (tabs > sheet > hint > link), only the scheme differs
//      between the rejected and the accepted case.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib/, so all five imports below resolve exactly like the other Prism KATs.
//   ./gen3_test.exe _kat_prism_widget_all.nova
//   clang -O2 -o _kat_prism_widget_all.exe _kat_prism_widget_all.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_widget_all.exe

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_structure

fn _fail(msg: string)
    print("FAIL " + msg)
    exit(1)

// Helper for assertion 4: builds "a link, inside a hint, inside a sheet, inside a tab panel" --
// four levels deep -- from a single `link_target` value. Used with BOTH a malicious and a
// legitimate target so the only variable between the rejected and accepted run is the scheme,
// proving the rejection is a property of `prism_link` itself, not an artifact of nesting depth.
fn _try_build_docs_panel(link_target) -> Result<PrismNode>
    let link_r = prism_interact.prism_link("Docs", link_target)
    if is_err(link_r)
        return link_r
    let link_node = unwrap(link_r)
    let hint_r = prism_structure.prism_hint("External documentation", link_node)
    if is_err(hint_r)
        return hint_r
    let hint_node = unwrap(hint_r)
    let sheet_r = prism_structure.prism_sheet(hint_node, false)
    if is_err(sheet_r)
        return sheet_r
    let sheet_node = unwrap(sheet_r)
    prism_structure.prism_tabs([prism_structure.prism_tab_panel("Help", sheet_node)], 0)

fn main()
    // ── 1. All four widget modules + prism_node link into ONE program ──────────────────────
    // Reaching this point at all (the harness compiled and linked this file) is the proof: if
    // PrismMeshTrack/PrismIcon/PrismEntryKind/PrismLinkTarget/PrismNodeKind's variant names, or
    // prism_structure's reuse of prism_node.prism_kind_band(), collided at the LLVM symbol
    // level when all four modules are compiled together, this binary would not exist.
    print("1. all four widget modules (prism_arrange, prism_content, prism_interact, prism_structure) + prism_node link into one program: OK (this binary exists)")

    // ── 2. A realistic 6-level app-screen page, primitives from all four modules ────────────
    //
    // root (Stack)                                                            depth=6 count=23
    //   ├─ header (Band)                                                      depth=2 count=4
    //   │    ├─ glyph(Menu)              [content]
    //   │    ├─ label("My App")          [content]
    //   │    └─ gap(none())              [arrange]      flexible
    //   ├─ body (Stack)                                                       depth=5 count=15
    //   │    └─ tabs (Tabs, selected=0)                                       depth=4 count=14
    //   │         ├─ "Data" -> grid_data (Grid, cols=[name,email])            depth=3 count=7
    //   │         │              ├─ row(key="u1") (Band)                     depth=2 count=3
    //   │         │              │    ├─ entry(prompt="name", "Alice")       [interact]
    //   │         │              │    └─ entry(prompt="email", "alice@example.com")
    //   │         │              └─ row(key="u2") (Band)                     depth=2 count=3
    //   │         │                   ├─ entry(prompt="name", "Bob")
    //   │         │                   └─ entry(prompt="email", "bob@example.com")
    //   │         └─ "Settings" -> sheet_confirm (Sheet, exclusive=true)      depth=3 count=6
    //   │                           └─ form (Band)                           depth=2 count=5
    //   │                                ├─ entry("Search term")   [interact]
    //   │                                ├─ pick(admin/member)      [interact]
    //   │                                ├─ flag("Notify me", true)[interact]
    //   │                                └─ range("Volume", 0,100,5,40) [interact]
    //   └─ footer (Band)                                                     depth=2 count=3
    //        ├─ link("Dashboard", route "/dashboard")     [interact]
    //        └─ gap(some(4))                              [arrange]         fixed 4
    //
    // Modules represented: prism_arrange (stack, band, gap), prism_content (label, glyph),
    // prism_interact (entry, pick, flag, range, link), prism_structure (grid, sheet, tabs).

    let glyph_menu = unwrap(prism_content.prism_glyph(prism_content.prism_icon_menu()))
    let label_title = unwrap(prism_content.prism_label("My App"))
    let gap_header = unwrap(prism_arrange.prism_gap(none()))
    let header_r = prism_arrange.prism_band([glyph_menu, label_title, gap_header])
    if is_err(header_r)
        _fail("header construction: " + unwrap_err(header_r))
    let header = unwrap(header_r)

    let grid_rows_data = [{"id": "u1", "name": "Alice", "email": "alice@example.com"}, {"id": "u2", "name": "Bob", "email": "bob@example.com"}]
    let grid_columns = ["name", "email"]
    let grid_data_r = prism_structure.prism_grid(grid_rows_data, fn(r) r["id"], grid_columns, fn(r, col) prism_interact.prism_entry(col, prism_interact.prism_entry_kind_text(), str(r[col])))
    if is_err(grid_data_r)
        _fail("grid_data construction: " + unwrap_err(grid_data_r))
    let grid_data = unwrap(grid_data_r)

    let entry_ctrl = unwrap(prism_interact.prism_entry("Search term", prism_interact.prism_entry_kind_search(), ""))
    let pick_ctrl = unwrap(prism_interact.prism_pick([prism_interact.prism_pick_option("admin", "Admin"), prism_interact.prism_pick_option("member", "Member")], "member"))
    let flag_ctrl = unwrap(prism_interact.prism_flag("Notify me", true))
    let range_ctrl = unwrap(prism_interact.prism_range("Volume", 0, 100, 5, 40))
    let form_r = prism_arrange.prism_band([entry_ctrl, pick_ctrl, flag_ctrl, range_ctrl])
    if is_err(form_r)
        _fail("form construction: " + unwrap_err(form_r))
    let form = unwrap(form_r)

    let sheet_confirm_r = prism_structure.prism_sheet(form, true)
    if is_err(sheet_confirm_r)
        _fail("sheet_confirm construction: " + unwrap_err(sheet_confirm_r))
    let sheet_confirm = unwrap(sheet_confirm_r)

    let tab_data = prism_structure.prism_tab_panel("Data", grid_data)
    let tab_settings = prism_structure.prism_tab_panel("Settings", sheet_confirm)
    let tabs_r = prism_structure.prism_tabs([tab_data, tab_settings], 0)
    if is_err(tabs_r)
        _fail("tabs construction: " + unwrap_err(tabs_r))
    let tabs_node = unwrap(tabs_r)

    let body_r = prism_arrange.prism_stack([tabs_node])
    if is_err(body_r)
        _fail("body construction: " + unwrap_err(body_r))
    let body = unwrap(body_r)

    let link_dashboard = unwrap(prism_interact.prism_link("Dashboard", prism_interact.prism_link_target_route("/dashboard")))
    let gap_footer = unwrap(prism_arrange.prism_gap(some(4)))
    let footer_r = prism_arrange.prism_band([link_dashboard, gap_footer])
    if is_err(footer_r)
        _fail("footer construction: " + unwrap_err(footer_r))
    let footer = unwrap(footer_r)

    let root_r = prism_arrange.prism_stack([header, body, footer])
    if is_err(root_r)
        _fail("root construction: " + unwrap_err(root_r))
    let root = unwrap(root_r)

    // -- root: kind + order --
    assert_eq(prism_node.prism_node_kind_str(root), "stack")
    assert_eq(prism_node.prism_node_child_count(root), 3)
    let rc = prism_node.prism_node_children(root)
    if prism_node.prism_node_kind_str(rc[0]) != "band"
        _fail("root.children[0] should be Band (header)")
    if prism_node.prism_node_kind_str(rc[1]) != "stack"
        _fail("root.children[1] should be Stack (body)")
    if prism_node.prism_node_kind_str(rc[2]) != "band"
        _fail("root.children[2] should be Band (footer)")

    // -- header: glyph, label, gap in order --
    let hc = prism_node.prism_node_children(rc[0])
    if prism_node.prism_node_kind_str(hc[0]) != "glyph" or prism_node.prism_node_attr_str(hc[0], "icon", "") != "menu"
        _fail("header.children[0] should be Glyph(menu)")
    if prism_node.prism_node_kind_str(hc[1]) != "label" or prism_node.prism_node_attr_str(hc[1], "text", "") != "My App"
        _fail("header.children[1] should be Label(\"My App\")")
    if prism_node.prism_node_kind_str(hc[2]) != "gap" or not prism_arrange.prism_gap_is_flexible(hc[2])
        _fail("header.children[2] should be a flexible Gap")

    // -- body -> tabs --
    assert_eq(prism_node.prism_node_child_count(rc[1]), 1)
    let body_tabs = prism_node.prism_node_children(rc[1])[0]
    assert_eq(prism_node.prism_node_kind_str(body_tabs), "tabs")
    assert_eq(prism_node.prism_node_child_count(body_tabs), 2)
    let tc = prism_node.prism_node_children(body_tabs)
    if prism_node.prism_node_kind_str(tc[0]) != "grid"
        _fail("tabs.children[0] should be Grid (the \"Data\" panel)")
    if prism_node.prism_node_kind_str(tc[1]) != "sheet"
        _fail("tabs.children[1] should be Sheet (the \"Settings\" panel)")
    assert_eq(prism_structure.prism_tabs_panel_label(tc[0]), "Data")
    assert_eq(prism_structure.prism_tabs_panel_label(tc[1]), "Settings")

    // -- Data panel: grid -> 2 keyed rows -> 2 entry cells each, in order --
    let gr = prism_node.prism_node_children(tc[0])
    assert_eq(len(gr), 2)
    match prism_node.prism_node_key(gr[0])
        Some(k) => assert_eq(k, "u1")
        None => _fail("grid row 0 should have key 'u1'")
    match prism_node.prism_node_key(gr[1])
        Some(k) => assert_eq(k, "u2")
        None => _fail("grid row 1 should have key 'u2'")
    let row0_cells = prism_node.prism_node_children(gr[0])
    if prism_node.prism_node_kind_str(row0_cells[0]) != "entry" or prism_node.prism_node_attr_str(row0_cells[0], "prompt", "") != "name" or prism_node.prism_node_attr_str(row0_cells[0], "value", "") != "Alice"
        _fail("grid row 'u1' cell[0] should be Entry(prompt=name, value=Alice)")
    if prism_node.prism_node_kind_str(row0_cells[1]) != "entry" or prism_node.prism_node_attr_str(row0_cells[1], "prompt", "") != "email" or prism_node.prism_node_attr_str(row0_cells[1], "value", "") != "alice@example.com"
        _fail("grid row 'u1' cell[1] should be Entry(prompt=email, value=alice@example.com)")
    let row1_cells = prism_node.prism_node_children(gr[1])
    if prism_node.prism_node_kind_str(row1_cells[0]) != "entry" or prism_node.prism_node_attr_str(row1_cells[0], "value", "") != "Bob"
        _fail("grid row 'u2' cell[0] should be Entry(value=Bob)")
    if prism_node.prism_node_kind_str(row1_cells[1]) != "entry" or prism_node.prism_node_attr_str(row1_cells[1], "value", "") != "bob@example.com"
        _fail("grid row 'u2' cell[1] should be Entry(value=bob@example.com)")

    // -- Settings panel: sheet -> form -> entry/pick/flag/range in order --
    if not prism_node.prism_node_attr_bool(tc[1], "exclusive", false)
        _fail("Settings sheet should have exclusive=true")
    assert_eq(prism_node.prism_node_child_count(tc[1]), 1)
    let form_node = prism_node.prism_node_children(tc[1])[0]
    assert_eq(prism_node.prism_node_kind_str(form_node), "band")
    assert_eq(prism_node.prism_node_child_count(form_node), 4)
    let fc = prism_node.prism_node_children(form_node)
    if prism_node.prism_node_kind_str(fc[0]) != "entry" or prism_node.prism_node_attr_str(fc[0], "prompt", "") != "Search term"
        _fail("form.children[0] should be Entry(\"Search term\")")
    if prism_node.prism_node_kind_str(fc[1]) != "pick" or prism_interact.prism_pick_selected_value(fc[1]) != "member"
        _fail("form.children[1] should be Pick(selected=member)")
    if prism_node.prism_node_kind_str(fc[2]) != "flag" or not prism_node.prism_node_attr_bool(fc[2], "state", false)
        _fail("form.children[2] should be Flag(state=true)")
    if prism_node.prism_node_kind_str(fc[3]) != "range" or prism_node.prism_node_attr_int(fc[3], "value", -1) != 40
        _fail("form.children[3] should be Range(value=40)")

    // -- footer: link, gap in order --
    let ftc = prism_node.prism_node_children(rc[2])
    if prism_node.prism_node_kind_str(ftc[0]) != "link" or prism_interact.prism_link_href(ftc[0]) != "/dashboard" or prism_interact.prism_link_kind_of(ftc[0]) != "route"
        _fail("footer.children[0] should be Link(route \"/dashboard\")")
    if prism_node.prism_node_kind_str(ftc[1]) != "gap" or prism_arrange.prism_gap_is_flexible(ftc[1]) or prism_arrange.prism_gap_size(ftc[1], -1) != 4
        _fail("footer.children[1] should be a fixed Gap(4)")

    print("2. 6-level app-screen page (header+glyph+label, grid of 2 keyed data rows, form with entry/pick/flag/range, sheet, tabs, link) composes with exact child order at every level: OK")

    // -- Whole-tree shape sanity: exact hand-derived depth/count (see the ASCII tree above and
    //    this milestone's report for the full derivation) --
    assert_eq(prism_node.prism_node_depth(header), 2)
    assert_eq(prism_node.prism_node_count(header), 4)
    assert_eq(prism_node.prism_node_depth(grid_data), 3)
    assert_eq(prism_node.prism_node_count(grid_data), 7)
    assert_eq(prism_node.prism_node_depth(form), 2)
    assert_eq(prism_node.prism_node_count(form), 5)
    assert_eq(prism_node.prism_node_depth(sheet_confirm), 3)
    assert_eq(prism_node.prism_node_count(sheet_confirm), 6)
    assert_eq(prism_node.prism_node_depth(tabs_node), 4)
    assert_eq(prism_node.prism_node_count(tabs_node), 14)
    assert_eq(prism_node.prism_node_depth(body), 5)
    assert_eq(prism_node.prism_node_count(body), 15)
    assert_eq(prism_node.prism_node_depth(footer), 2)
    assert_eq(prism_node.prism_node_count(footer), 3)
    assert_eq(prism_node.prism_node_depth(root), 6)
    assert_eq(prism_node.prism_node_count(root), 23)
    print("2b. cached depth/count exact at every composed level (root: depth=6, count=23): OK")

    // ── 3. PRISM_SPEC.md §16 end-to-end: hostile children rejected from EACH of the four
    //       modules, never a crash -- the process must reach the final print below. ─────────

    // arrange: prism_band's children go straight to prism_node_new's guard.
    let hostile_arrange_r = prism_arrange.prism_band([42, "oops"])
    if is_ok(hostile_arrange_r)
        _fail("prism_arrange.prism_band([42, \"oops\"]) should be rejected, not silently accepted")
    print("3a. arrange: prism_band rejects non-PrismNode children [42, \"oops\"]: OK -- " + unwrap_err(hostile_arrange_r))

    // content: content itself has no children-accepting constructor (label/art/glyph/draw are
    // all leaves) -- so its own contribution to this guarantee is the realistic mistake of
    // handing a content VALUE (a raw PrismIcon, not a built prism_glyph() node) directly to
    // another module's container, as if the caller forgot to wrap it.
    let hostile_content_r = prism_arrange.prism_stack([prism_content.prism_icon_close()])
    if is_ok(hostile_content_r)
        _fail("prism_arrange.prism_stack([a raw PrismIcon]) should be rejected (forgot prism_glyph())")
    print("3b. content: a raw PrismIcon value (forgot prism_glyph()) fed as a stack child is rejected: OK -- " + unwrap_err(hostile_content_r))

    // interact: prism_press's children go straight to prism_node_new's guard; fed a raw
    // PrismEntryKind (forgot to build an actual entry node) as the realistic mistake.
    let hostile_interact_r = prism_interact.prism_press("Click", [prism_interact.prism_entry_kind_text()])
    if is_ok(hostile_interact_r)
        _fail("prism_interact.prism_press with a raw PrismEntryKind child should be rejected")
    print("3c. interact: prism_press rejects a raw PrismEntryKind child (forgot to build an entry node): OK -- " + unwrap_err(hostile_interact_r))

    // structure: two distinct paths, both hardened this milestone -- a render_fn that returns a
    // non-PrismNode Ok(...) (prism_each), and a panels list containing a non-PrismTabPanel
    // element (prism_tabs).
    let hostile_each_r = prism_structure.prism_each(["only"], fn(it) it, fn(it) ok(42))
    if is_ok(hostile_each_r)
        _fail("prism_structure.prism_each with a render_fn returning ok(42) should be rejected")
    print("3d. structure: prism_each rejects a render_fn returning a non-PrismNode: OK -- " + unwrap_err(hostile_each_r))

    let hostile_tabs_r = prism_structure.prism_tabs([1, 2, 3], 0)
    if is_ok(hostile_tabs_r)
        _fail("prism_structure.prism_tabs with non-PrismTabPanel panels [1,2,3] should be rejected")
    print("3e. structure: prism_tabs rejects non-PrismTabPanel panels [1,2,3]: OK -- " + unwrap_err(hostile_tabs_r))

    print("3. PRISM_SPEC.md Sec16 holds end-to-end across all four modules -- 5 hostile constructions correctly rejected, process still running: OK")

    // ── 4. Sec15.1 injection guarantee survives composition (4 levels deep) ─────────────────
    let evil_r = _try_build_docs_panel(prism_interact.prism_link_target_url("javascript:alert(1)"))
    if is_ok(evil_r)
        _fail("a javascript: link should be rejected even 4 levels deep (tabs>sheet>hint>link)")
    print("4a. javascript: target rejected 4 levels deep inside tabs>sheet>hint>link: OK -- " + unwrap_err(evil_r))

    let good_r = _try_build_docs_panel(prism_interact.prism_link_target_url("https://example.com/docs"))
    if is_err(good_r)
        _fail("a legitimate https:// link at the SAME nesting depth should succeed: " + unwrap_err(good_r))
    let good_tree = unwrap(good_r)
    assert_eq(prism_node.prism_node_kind_str(good_tree), "tabs")
    print("4b. a legitimate https:// link at the identical nesting depth succeeds -- proves rejection is scheme-based, not depth-based: OK")

    print("KAT prism_widget_all PASSED: all 4 widget modules link with no symbol collision; 6-level app-screen page composes with exact depth=6/count=23 and child order; Sec16 holds end-to-end (5 hostile rejections, no crash); Sec15.1 injection guard survives 4-level composition")
