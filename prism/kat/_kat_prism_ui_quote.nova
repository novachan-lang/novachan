// KAT for prism/ui/prism_ui_quote.nova (PRISM_ROADMAP.md milestone MB.21, the `ui/` composition
// layer's quote/blockquote components: plain quote, attributed quote, pull quote, and callout box).
//
// Every expected shape below is hand-computed from `prism_node.prism_node_new`'s own depth/count
// rule (leaf: depth=1, count=1; branch with N children: depth=max(child depths)+1,
// count=1+sum(child counts)) -- never taken on faith from the implementation. Proves, against
// concrete expected values:
//   1. Quote: band["|", text] -- both leaves, so band depth=max(1,1)+1=2, count=1+(1+1)=3.
//      Rejects an empty text.
//   2. Attributed: stack[quote, "— "+author] -- quote is the band from part 1 (d2,c3), attribution
//      is a leaf (d1,c1). stack depth=max(2,1)+1=3, count=1+(3+1)=5. Rejects empty text and empty
//      author independently.
//   3. Pull quote: stack["\"", text, "\""] -- three leaves. stack depth=max(1,1,1)+1=2,
//      count=1+(1+1+1)=4. Rejects empty text.
//   4. Callout: band[prefix, stack[title, body?]]. With a non-empty body: inner stack[title,body]
//      is d2,c3 (both leaves); outer band[prefix(leaf d1c1), inner(d2,c3)] = depth max(1,2)+1=3,
//      count 1+(1+3)=5. With an EMPTY body: inner stack[title] alone is d2,c2 (branch of 1 leaf);
//      outer band = depth max(1,2)+1=3, count 1+(1+2)=4. Rejects empty prefix and empty title
//      independently; an empty BODY is explicitly legal (optional third line).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_quote` resolve.
//   ./gen3_test.exe _kat_prism_ui_quote.nova
//   clang -O2 -o _kat_prism_ui_quote.exe _kat_prism_ui_quote.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_quote.exe

import prism_node
import prism_content
import prism_arrange
import prism_ui_quote

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    // ── 1. Quote ──────────────────────────────────────────────────────────────────────────────
    print("== 1. quote ==")

    // Both leaves: band depth=max(1,1)+1=2; count=1+(1+1)=3.
    let q1 = unwrap(prism_ui_quote.prism_qt_quote("The only way out is through."))
    _check("quote kind == band", prism_node.prism_node_kind_str(q1), "band")
    _check("quote depth", str(prism_node.prism_node_depth(q1)), "2")
    _check("quote count", str(prism_node.prism_node_count(q1)), "3")
    _check("quote child_count == 2", str(prism_node.prism_node_child_count(q1)), "2")
    let q1_kids = prism_node.prism_node_children(q1)
    _check("quote child0 kind == label (bar)", prism_node.prism_node_kind_str(q1_kids[0]), "label")
    _check("quote child0 text == |", prism_node.prism_node_attr_str(q1_kids[0], "text", ""), "|")
    _check("quote child1 kind == label (body)", prism_node.prism_node_kind_str(q1_kids[1]), "label")
    _check("quote child1 text == source text", prism_node.prism_node_attr_str(q1_kids[1], "text", ""), "The only way out is through.")

    // Rejection.
    let q_empty = prism_ui_quote.prism_qt_quote("")
    _check_true("quote rejects empty text", is_err(q_empty))

    // ── 2. Attributed ─────────────────────────────────────────────────────────────────────────
    print("== 2. attributed ==")

    // quote(text) = band d2,c3 (from part 1). attribution = leaf d1,c1.
    // stack depth = max(2,1)+1 = 3; count = 1 + (3+1) = 5.
    let a1 = unwrap(prism_ui_quote.prism_qt_attributed("Simplicity is the ultimate sophistication.", "Leonardo da Vinci"))
    _check("attributed kind == stack", prism_node.prism_node_kind_str(a1), "stack")
    _check("attributed depth", str(prism_node.prism_node_depth(a1)), "3")
    _check("attributed count", str(prism_node.prism_node_count(a1)), "5")
    _check("attributed child_count == 2", str(prism_node.prism_node_child_count(a1)), "2")
    let a1_kids = prism_node.prism_node_children(a1)
    _check("attributed child0 kind == band (the quote)", prism_node.prism_node_kind_str(a1_kids[0]), "band")
    _check("attributed child0 depth == 2 (matches quote alone)", str(prism_node.prism_node_depth(a1_kids[0])), "2")
    _check("attributed child1 kind == label (attribution)", prism_node.prism_node_kind_str(a1_kids[1]), "label")
    _check("attributed child1 text == em-dash + author", prism_node.prism_node_attr_str(a1_kids[1], "text", ""), "— Leonardo da Vinci")

    // Rejections -- text and author are validated independently.
    let a_empty_text = prism_ui_quote.prism_qt_attributed("", "Someone")
    _check_true("attributed rejects empty text", is_err(a_empty_text))
    let a_empty_author = prism_ui_quote.prism_qt_attributed("Some words.", "")
    _check_true("attributed rejects empty author", is_err(a_empty_author))

    // ── 3. Pull quote ─────────────────────────────────────────────────────────────────────────
    print("== 3. pull quote ==")

    // Three leaves: stack depth=max(1,1,1)+1=2; count=1+(1+1+1)=4.
    let p1 = unwrap(prism_ui_quote.prism_qt_pullquote("Ship it."))
    _check("pullquote kind == stack", prism_node.prism_node_kind_str(p1), "stack")
    _check("pullquote depth", str(prism_node.prism_node_depth(p1)), "2")
    _check("pullquote count", str(prism_node.prism_node_count(p1)), "4")
    _check("pullquote child_count == 3", str(prism_node.prism_node_child_count(p1)), "3")
    let p1_kids = prism_node.prism_node_children(p1)
    _check("pullquote child0 kind == label (open mark)", prism_node.prism_node_kind_str(p1_kids[0]), "label")
    _check("pullquote child0 text == open quote mark", prism_node.prism_node_attr_str(p1_kids[0], "text", ""), "\"")
    _check("pullquote child1 kind == label (body)", prism_node.prism_node_kind_str(p1_kids[1]), "label")
    _check("pullquote child1 text == source text", prism_node.prism_node_attr_str(p1_kids[1], "text", ""), "Ship it.")
    _check("pullquote child2 kind == label (close mark)", prism_node.prism_node_kind_str(p1_kids[2]), "label")
    _check("pullquote child2 text == close quote mark", prism_node.prism_node_attr_str(p1_kids[2], "text", ""), "\"")

    // Rejection.
    let p_empty = prism_ui_quote.prism_qt_pullquote("")
    _check_true("pullquote rejects empty text", is_err(p_empty))

    // ── 4. Callout ────────────────────────────────────────────────────────────────────────────
    print("== 4. callout ==")

    // With a body: inner stack[title,body] both leaves -> d2,c3. outer band[prefix(leaf d1c1),
    // inner(d2,c3)] = depth max(1,2)+1=3; count = 1 + (1+3) = 5.
    let c1 = unwrap(prism_ui_quote.prism_qt_callout("NOTE", "Heads up", "This behavior changed in v2."))
    _check("callout(with body) kind == band", prism_node.prism_node_kind_str(c1), "band")
    _check("callout(with body) depth", str(prism_node.prism_node_depth(c1)), "3")
    _check("callout(with body) count", str(prism_node.prism_node_count(c1)), "5")
    _check("callout(with body) child_count == 2", str(prism_node.prism_node_child_count(c1)), "2")
    let c1_kids = prism_node.prism_node_children(c1)
    _check("callout(with body) child0 kind == label (prefix)", prism_node.prism_node_kind_str(c1_kids[0]), "label")
    _check("callout(with body) child0 text == prefix", prism_node.prism_node_attr_str(c1_kids[0], "text", ""), "NOTE")
    _check("callout(with body) child1 kind == stack (title+body)", prism_node.prism_node_kind_str(c1_kids[1]), "stack")
    _check("callout(with body) child1 child_count == 2", str(prism_node.prism_node_child_count(c1_kids[1])), "2")
    let c1_inner_kids = prism_node.prism_node_children(c1_kids[1])
    _check("callout(with body) title text", prism_node.prism_node_attr_str(c1_inner_kids[0], "text", ""), "Heads up")
    _check("callout(with body) body text", prism_node.prism_node_attr_str(c1_inner_kids[1], "text", ""), "This behavior changed in v2.")

    // Without a body (empty body is legal, just omits the second stack line): inner stack[title]
    // alone is d2,c2 (branch of one leaf: depth=max(1)+1=2, count=1+1=2). outer band =
    // depth max(1,2)+1=3; count = 1 + (1+2) = 4.
    let c2 = unwrap(prism_ui_quote.prism_qt_callout("TIP", "Keep it simple", ""))
    _check("callout(no body) depth", str(prism_node.prism_node_depth(c2)), "3")
    _check("callout(no body) count", str(prism_node.prism_node_count(c2)), "4")
    let c2_kids = prism_node.prism_node_children(c2)
    _check("callout(no body) child1 child_count == 1 (no body line)", str(prism_node.prism_node_child_count(c2_kids[1])), "1")
    let c2_inner_kids = prism_node.prism_node_children(c2_kids[1])
    _check("callout(no body) title text (only child)", prism_node.prism_node_attr_str(c2_inner_kids[0], "text", ""), "Keep it simple")

    // Rejections -- prefix and title are validated independently; body is NOT required.
    let c_empty_prefix = prism_ui_quote.prism_qt_callout("", "Heads up", "Body.")
    _check_true("callout rejects empty prefix", is_err(c_empty_prefix))
    let c_empty_title = prism_ui_quote.prism_qt_callout("NOTE", "", "Body.")
    _check_true("callout rejects empty title", is_err(c_empty_title))

    // ── Summary ───────────────────────────────────────────────────────────────────────────────
    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_quote: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_quote: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
