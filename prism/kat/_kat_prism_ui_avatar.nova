// KAT for prism/ui/prism_ui_avatar.nova (PrismAvatar value + circle/card/group/presence renderers).
//
// Proves, against concrete expected values (every depth/count hand-computed from prism_node.nova's
// own `depth = max(child depths) + 1`, `count = 1 + sum(child counts)` rule, never guessed):
//   1. Constructor + accessors: name/image round-trip, initials derived from name (not a separate
//      caller-supplied value); rejects an empty (and an all-whitespace) name.
//   2. Single-word name -> 1-char initials; two-word name -> 2-char initials; a 3+ word name still
//      caps at 2 chars (drops the extra words, mirroring prism_ui_media's own precedent).
//   3. Circle: image present -> exact "art" leaf (source round-trips); image absent -> exact
//      "label" leaf (initials text round-trips).
//   4. Card: exact band(d=3,c=4)[circle, stack(d=2,c=2)[name]] with an empty subtitle (subtitle
//      label OMITTED, not blank); exact band(d=3,c=5)[circle, stack(d=2,c=3)[name, subtitle]] with
//      a non-empty subtitle.
//   5. Group: under max (2 avatars, max_shown=5) -> band(d=2,c=3), no overflow label; at max
//      (3 avatars, max_shown=3) -> band(d=2,c=4), no overflow label; over max (5 avatars,
//      max_shown=3) -> band(d=2,c=5), last child is a "+2" overflow label; rejects an empty list,
//      a non-PrismAvatar element (index+type named), and a max_shown <= 0.
//   6. Presence: all 4 valid statuses render exact layer(d=2,c=3)[circle, status_label] with the
//      status text round-tripping; rejects an invalid status string.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _prism_kat_gate.ps1 / _proc_util.ps1's Prism sync installs prism/**/*.nova
// into $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_avatar` resolve.
//   ./gen3_test.exe _kat_prism_ui_avatar.nova
//   clang -O2 -o _kat_prism_ui_avatar.exe _kat_prism_ui_avatar.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_avatar.exe

import prism_node
import prism_ui_avatar as av

// A single-element list, not a bare `let mut int` -- a module-level scalar reassigned from
// inside another top-level fn does not persist across the call (proven here: the first version
// of this file used `let mut passed/failed = 0` with `passed += 1` inside `_check`, and the
// counters silently stayed 0 despite every individual line printing "ok"). A list mutates in
// place by reference, which does persist -- the exact workaround `_kat_prism_ui_token.nova`'s own
// `let FAILED = [0]` already established for this identical pitfall.
let PASSED = [0]
let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  ok  " + label)
        PASSED[0] = PASSED[0] + 1
    else
        print("FAIL " + label + ": got '" + got + "' expected '" + want + "'")
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  ok  " + label)
        PASSED[0] = PASSED[0] + 1
    else
        print("FAIL " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    print("== KAT prism_ui_avatar ==")

    // ── 1. Constructor + accessors: round-trip + derived initials, empty-name rejection ────────
    let a1_r = av.prism_av_avatar("Jane Doe", "jane.png")
    _check_true("avatar (two-word name) constructs", is_ok(a1_r))
    let a1 = unwrap(a1_r)
    _check("avatar name round-trips", av.prism_av_avatar_name(a1), "Jane Doe")
    _check("avatar image round-trips", av.prism_av_avatar_image(a1), "jane.png")
    _check("avatar initials derived as JD", av.prism_av_avatar_initials(a1), "JD")

    let empty_name_r = av.prism_av_avatar("", "")
    _check_true("rejects an empty name", is_err(empty_name_r))
    let blank_name_r = av.prism_av_avatar("   ", "")
    _check_true("rejects an all-whitespace name", is_err(blank_name_r))
    print("")

    // ── 2. Initials: single word (1 char), two words (2 chars), 3+ words (still caps at 2) ─────
    let a_single = unwrap(av.prism_av_avatar("Madonna", ""))
    _check("single-word name -> 1-char initials", av.prism_av_avatar_initials(a_single), "M")

    let a_two = unwrap(av.prism_av_avatar("John Smith", ""))
    _check("two-word name -> 2-char initials", av.prism_av_avatar_initials(a_two), "JS")

    let a_three = unwrap(av.prism_av_avatar("John Middle Smith", ""))
    _check("3-word name still caps at 2-char initials", av.prism_av_avatar_initials(a_three), "JM")

    let a_lower = unwrap(av.prism_av_avatar("alice bob", ""))
    _check("lowercase name initials are uppercased", av.prism_av_avatar_initials(a_lower), "AB")
    print("")

    // ── 3. Circle: image present -> "art" leaf; image absent -> "label" leaf ───────────────────
    let circle_img_r = av.prism_av_circle(a1)
    _check_true("circle (with image) constructs", is_ok(circle_img_r))
    let circle_img = unwrap(circle_img_r)
    _check("circle (with image) kind_str", prism_node.prism_node_kind_str(circle_img), "art")
    _check("circle (with image) source round-trips", prism_node.prism_node_attr_str(circle_img, "source", ""), "jane.png")
    _check("circle (with image) depth", str(prism_node.prism_node_depth(circle_img)), "1")
    _check("circle (with image) count", str(prism_node.prism_node_count(circle_img)), "1")

    let circle_init_r = av.prism_av_circle(a_two)
    _check_true("circle (no image) constructs", is_ok(circle_init_r))
    let circle_init = unwrap(circle_init_r)
    _check("circle (no image) kind_str", prism_node.prism_node_kind_str(circle_init), "label")
    _check("circle (no image) text is initials", prism_node.prism_node_attr_str(circle_init, "text", ""), "JS")
    print("")

    // ── 4. Card: empty subtitle omits the subtitle label; non-empty subtitle includes it ────────
    let card_no_sub_r = av.prism_av_card(a1, "")
    _check_true("card (no subtitle) constructs", is_ok(card_no_sub_r))
    let card_no_sub = unwrap(card_no_sub_r)
    _check("card (no subtitle) kind_str", prism_node.prism_node_kind_str(card_no_sub), "band")
    _check("card (no subtitle) depth", str(prism_node.prism_node_depth(card_no_sub)), "3")
    _check("card (no subtitle) count", str(prism_node.prism_node_count(card_no_sub)), "4")
    let card_no_sub_kids = prism_node.prism_node_children(card_no_sub)
    _check("card (no subtitle) child count", str(len(card_no_sub_kids)), "2")
    _check("card (no subtitle) 1st child kind_str (circle)", prism_node.prism_node_kind_str(card_no_sub_kids[0]), "art")
    _check("card (no subtitle) 2nd child kind_str (info stack)", prism_node.prism_node_kind_str(card_no_sub_kids[1]), "stack")
    let card_no_sub_stack_kids = prism_node.prism_node_children(card_no_sub_kids[1])
    _check("card (no subtitle) info stack child count", str(len(card_no_sub_stack_kids)), "1")
    _check("card (no subtitle) name label text", prism_node.prism_node_attr_str(card_no_sub_stack_kids[0], "text", ""), "Jane Doe")

    let card_sub_r = av.prism_av_card(a1, "Product Manager")
    _check_true("card (with subtitle) constructs", is_ok(card_sub_r))
    let card_sub = unwrap(card_sub_r)
    _check("card (with subtitle) kind_str", prism_node.prism_node_kind_str(card_sub), "band")
    _check("card (with subtitle) depth", str(prism_node.prism_node_depth(card_sub)), "3")
    _check("card (with subtitle) count", str(prism_node.prism_node_count(card_sub)), "5")
    let card_sub_kids = prism_node.prism_node_children(card_sub)
    let card_sub_stack_kids = prism_node.prism_node_children(card_sub_kids[1])
    _check("card (with subtitle) info stack child count", str(len(card_sub_stack_kids)), "2")
    _check("card (with subtitle) name label text", prism_node.prism_node_attr_str(card_sub_stack_kids[0], "text", ""), "Jane Doe")
    _check("card (with subtitle) subtitle label text", prism_node.prism_node_attr_str(card_sub_stack_kids[1], "text", ""), "Product Manager")
    print("")

    // ── 5. Group: under max, at max, over max (overflow label), rejections ──────────────────────
    let g_a = unwrap(av.prism_av_avatar("Ann Adams", ""))
    let g_b = unwrap(av.prism_av_avatar("Bob Brown", ""))
    let g_c = unwrap(av.prism_av_avatar("Cara Cole", ""))
    let g_d = unwrap(av.prism_av_avatar("Dan Diaz", ""))
    let g_e = unwrap(av.prism_av_avatar("Eve Ellis", ""))

    let group_under_r = av.prism_av_group([g_a, g_b], 5)
    _check_true("group (under max) constructs", is_ok(group_under_r))
    let group_under = unwrap(group_under_r)
    _check("group (under max) kind_str", prism_node.prism_node_kind_str(group_under), "band")
    _check("group (under max) depth", str(prism_node.prism_node_depth(group_under)), "2")
    _check("group (under max) count", str(prism_node.prism_node_count(group_under)), "3")
    _check("group (under max) child count (no overflow)", str(len(prism_node.prism_node_children(group_under))), "2")

    let group_at_r = av.prism_av_group([g_a, g_b, g_c], 3)
    _check_true("group (at max) constructs", is_ok(group_at_r))
    let group_at = unwrap(group_at_r)
    _check("group (at max) depth", str(prism_node.prism_node_depth(group_at)), "2")
    _check("group (at max) count", str(prism_node.prism_node_count(group_at)), "4")
    _check("group (at max) child count (no overflow)", str(len(prism_node.prism_node_children(group_at))), "3")

    let group_over_r = av.prism_av_group([g_a, g_b, g_c, g_d, g_e], 3)
    _check_true("group (over max) constructs", is_ok(group_over_r))
    let group_over = unwrap(group_over_r)
    _check("group (over max) depth", str(prism_node.prism_node_depth(group_over)), "2")
    _check("group (over max) count", str(prism_node.prism_node_count(group_over)), "5")
    let group_over_kids = prism_node.prism_node_children(group_over)
    _check("group (over max) child count (3 shown + 1 overflow)", str(len(group_over_kids)), "4")
    _check("group (over max) last child kind_str (overflow label)", prism_node.prism_node_kind_str(group_over_kids[3]), "label")
    _check("group (over max) overflow text is +2", prism_node.prism_node_attr_str(group_over_kids[3], "text", ""), "+2")
    _check("group (over max) 1st shown child is circle", prism_node.prism_node_kind_str(group_over_kids[0]), "label")

    let group_empty_r = av.prism_av_group([], 3)
    _check_true("group rejects an empty list", is_err(group_empty_r))
    let group_bad_elem_r = av.prism_av_group([g_a, "not an avatar"], 3)
    _check_true("group rejects a non-PrismAvatar element", is_err(group_bad_elem_r))
    if is_err(group_bad_elem_r)
        _check_true("group rejection names the offending index and type", contains(unwrap_err(group_bad_elem_r), "1") and contains(unwrap_err(group_bad_elem_r), "string"))
    let group_bad_max_r = av.prism_av_group([g_a], 0)
    _check_true("group rejects max_shown == 0", is_err(group_bad_max_r))
    let group_neg_max_r = av.prism_av_group([g_a], -1)
    _check_true("group rejects a negative max_shown", is_err(group_neg_max_r))
    print("")

    // ── 6. Presence: all 4 valid statuses, invalid status rejection ─────────────────────────────
    let statuses = ["online", "offline", "away", "busy"]
    for s in statuses
        let pres_r = av.prism_av_presence(a1, s)
        _check_true("presence (" + s + ") constructs", is_ok(pres_r))
        if is_ok(pres_r)
            let pres = unwrap(pres_r)
            _check("presence (" + s + ") kind_str", prism_node.prism_node_kind_str(pres), "layer")
            _check("presence (" + s + ") depth", str(prism_node.prism_node_depth(pres)), "2")
            _check("presence (" + s + ") count", str(prism_node.prism_node_count(pres)), "3")
            let pres_kids = prism_node.prism_node_children(pres)
            _check("presence (" + s + ") child count", str(len(pres_kids)), "2")
            _check("presence (" + s + ") status label text", prism_node.prism_node_attr_str(pres_kids[1], "text", ""), s)

    let pres_bad_r = av.prism_av_presence(a1, "Online")
    _check_true("presence rejects an invalid status (wrong case)", is_err(pres_bad_r))
    let pres_bad2_r = av.prism_av_presence(a1, "in-a-meeting")
    _check_true("presence rejects an unknown status", is_err(pres_bad2_r))
    let pres_bad3_r = av.prism_av_presence(a1, "")
    _check_true("presence rejects an empty status", is_err(pres_bad3_r))

    print("")
    print("== " + str(PASSED[0]) + " passed, " + str(FAILED[0]) + " failed ==")
    if FAILED[0] > 0
        exit(1)
