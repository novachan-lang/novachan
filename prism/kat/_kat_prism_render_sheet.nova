// KAT for prism/render/prism_render_sheet.nova -- grid -> delimited text (#117).
//
// The properties this exists for:
//   1. ★ RFC 4180 QUOTING. A cell containing a comma, a quote or a newline must not corrupt the
//      row -- this is the classic CSV bug, and it is silent because the file still parses.
//   2. ★ A HEADER-COUNT MISMATCH IS AN ERROR. Exporting 2 headers for a 3-column grid shifts
//      every column, producing a file that looks plausible and is wrong. Same for a ragged row.
//   3. A non-grid node is refused rather than exported as some arbitrary shape.

import prism_node
import prism_content
import prism_structure
import prism_render_sheet

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

// A 2-column grid over N rows. The callbacks are NAMED top-level functions rather than inline
// lambdas: NOVA does not accept a call whose arguments span multiple lines, and a multi-line
// lambda body inside an argument list is exactly that shape (E0001 "unexpected NEWLINE in
// expression"). Named callbacks are also easier to read here.
fn _key_of(r) -> string
    r[0]

fn _cell_of(r, col)
    if col == "name"
        return prism_content.prism_label(r[0])
    prism_content.prism_label(r[1])

fn _make_grid(vals: list) -> PrismNode
    unwrap(prism_structure.prism_grid(vals, _key_of, ["name", "note"], _cell_of))

fn main()
    print("== _kat_prism_render_sheet ==")

    let g = _make_grid([["ada", "first"], ["grace", "second"], ["alan", "third"]])

    print("1. shape")
    check("column count comes from the node", unwrap(prism_render_sheet.prism_sht_col_count(g)) == 2)
    check("row count is the child count", unwrap(prism_render_sheet.prism_sht_row_count(g)) == 3)
    let rows = unwrap(prism_render_sheet.prism_sht_rows(g))
    check("3 rows of cell text", len(rows) == 3)
    check("cell text is extracted", join(rows[0], "|") == "ada|first")
    check("row order is preserved", join(rows[2], "|") == "alan|third")

    print("2. csv/tsv output")
    let csv = unwrap(prism_render_sheet.prism_sht_csv(g, ["Name", "Note"]))
    check("the header row comes first", starts_with(csv, "Name,Note"))
    check("rows follow in order", contains(csv, "ada,first"))
    check("CRLF line endings per RFC 4180", contains(csv, "\r\n"))
    let tsv = unwrap(prism_render_sheet.prism_sht_tsv(g, ["Name", "Note"]))
    check("tsv uses tabs", contains(tsv, "Name\tNote"))
    check("tsv does not use commas as the delimiter", not contains(tsv, "Name,Note"))

    print("3. ★ RFC 4180 quoting -- the classic silent corruption")
    let tricky = _make_grid([
        ["a,b", "plain"],
        ["say \"hi\"", "x"],
        ["line1\nline2", "y"]
    ])
    let tcsv = unwrap(prism_render_sheet.prism_sht_csv(tricky, ["h1", "h2"]))
    check("a value containing the delimiter is QUOTED", contains(tcsv, "\"a,b\""))
    // An embedded quote is escaped by DOUBLING, not by a backslash.
    check("an embedded quote is DOUBLED, not backslashed", contains(tcsv, "\"say \"\"hi\"\"\""))
    check("a value containing a newline is quoted", contains(tcsv, "\"line1\nline2\""))
    // A plain value must NOT be quoted -- over-quoting is not "safe", it changes the value for
    // readers that treat quotes literally.
    check("a plain value is NOT quoted", contains(tcsv, ",plain"))
    // In TSV the comma is NOT the delimiter, so "a,b" needs no quoting there.
    let ttsv = unwrap(prism_render_sheet.prism_sht_tsv(tricky, ["h1", "h2"]))
    check("quoting is delimiter-aware: a comma is plain in TSV", contains(ttsv, "a,b\t"))

    print("4. ★ a header-count mismatch is an ERROR, never a shifted export")
    check("too few headers rejected", is_err(prism_render_sheet.prism_sht_csv(g, ["only"])))
    check("too many headers rejected", is_err(prism_render_sheet.prism_sht_csv(g, ["a", "b", "c"])))
    check("non-list headers rejected", is_err(prism_render_sheet.prism_sht_csv(g, "a,b")))
    check("non-string header rejected", is_err(prism_render_sheet.prism_sht_csv(g, ["a", 7])))
    check("empty delimiter rejected", is_err(prism_render_sheet.prism_sht_delimited(g, ["a", "b"], "")))

    print("5. a non-grid node is refused")
    let lbl = unwrap(prism_content.prism_label("not a grid"))
    check("a label is not exportable as a sheet", is_err(prism_render_sheet.prism_sht_rows(lbl)))
    check("col_count refuses it too", is_err(prism_render_sheet.prism_sht_col_count(lbl)))

    print("6. non-ASCII survives")
    let jg = _make_grid([["日本語", "テスト"]])
    let jcsv = unwrap(prism_render_sheet.prism_sht_csv(jg, ["名前", "備考"]))
    check("non-ASCII headers and cells survive", contains(jcsv, "名前,備考") and contains(jcsv, "日本語,テスト"))

    print("")
    if STATS[1] == 0
        print("_kat_prism_render_sheet: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_render_sheet: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
