// KAT for prism/style/prism_print.nova -- print layout (#115).
//
// The properties this exists for:
//   1. ★ EXACT PAGE GEOMETRY IN INTEGER MICROMETRES. A4 is 210000x297000 um and Letter is
//      215900x279400 um -- both exact integers, which they are NOT as float millimetres. A float
//      page height accumulates error across a hundred pages until the last one is short.
//   2. ★ LINES-PER-PAGE FLOORS. A line that does not fully fit must not go on the page; rounding
//      up is how a printed page loses its last line off the bottom edge, where nobody sees it.
//   3. ★ ZERO LINES IS ONE PAGE. Returning 0 would make a caller skip the header/footer pass for
//      a document that still produces a sheet.

import prism_print

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_print ==")
    let a4 = prism_print.prism_pr_a4()
    let letter = prism_print.prism_pr_letter()

    print("1. ★ exact geometry in integer micrometres")
    check("A4 is 210000 um wide", prism_print.prism_pr_width(a4) == 210000)
    check("A4 is 297000 um tall", prism_print.prism_pr_height(a4) == 297000)
    // 215.9mm is not exact as a float; as micrometres it is exactly 215900.
    check("Letter is EXACTLY 215900 um wide", prism_print.prism_pr_width(letter) == 215900)
    check("Letter is EXACTLY 279400 um tall", prism_print.prism_pr_height(letter) == 279400)
    check("A5 is half of A4's height, exactly", prism_print.prism_pr_height(prism_print.prism_pr_a5()) == 210000)
    check("mm conversion rounds to nearest (215900 -> 216)", prism_print.prism_pr_mm(215900) == 216)
    check("mm round-trips", prism_print.prism_pr_from_mm(210) == 210000)

    print("2. content area is inside the margins")
    check("A4 content width = 210000 - 2*20000", prism_print.prism_pr_content_w(a4) == 170000)
    check("A4 content height = 297000 - 2*20000", prism_print.prism_pr_content_h(a4) == 257000)
    let land = prism_print.prism_pr_landscape(a4)
    check("landscape swaps the axes", prism_print.prism_pr_width(land) == 297000 and prism_print.prism_pr_height(land) == 210000)
    check("landscape keeps the margin", prism_print.prism_pr_margin(land) == 20000)

    print("3. ★ lines per page FLOORS")
    // 257000 um of printable height at 5000 um leading = 51.4 lines -> 51, never 52.
    check("257000 / 5000 floors to 51, not 52", unwrap(prism_print.prism_pr_lines_per_page(a4, 5000)) == 51)
    check("an exact fit is not rounded up", unwrap(prism_print.prism_pr_lines_per_page(a4, 257000)) == 1)
    // Leading larger than the page cannot fit even one line -- an error, not 0, because 0 would
    // divide by zero in every paginator downstream.
    check("leading larger than the page is an ERROR, not 0", is_err(prism_print.prism_pr_lines_per_page(a4, 300000)))
    check("zero leading rejected", is_err(prism_print.prism_pr_lines_per_page(a4, 0)))
    check("non-int leading rejected", is_err(prism_print.prism_pr_lines_per_page(a4, "5000")))

    print("4. ★ page count, and zero lines is ONE page")
    check("51 lines fit on one page", unwrap(prism_print.prism_pr_page_count(a4, 5000, 51)) == 1)
    check("52 lines need two pages", unwrap(prism_print.prism_pr_page_count(a4, 5000, 52)) == 2)
    check("102 lines need exactly two", unwrap(prism_print.prism_pr_page_count(a4, 5000, 102)) == 2)
    check("103 lines need three", unwrap(prism_print.prism_pr_page_count(a4, 5000, 103)) == 3)
    // A document that prints nothing still produces a sheet.
    check("ZERO lines is ONE page, not zero", unwrap(prism_print.prism_pr_page_count(a4, 5000, 0)) == 1)
    check("negative line count rejected", is_err(prism_print.prism_pr_page_count(a4, 5000, -1)))

    print("5. ★ page breaks land on the FIRST line of a page")
    check("line 0 starts a page", unwrap(prism_print.prism_pr_break_at(a4, 5000, 0)))
    check("line 50 does NOT (still on page 1)", not unwrap(prism_print.prism_pr_break_at(a4, 5000, 50)))
    // 51 lines per page, so line 51 (zero-based) is the first of page 2. An off-by-one here puts
    // every break one line late for the whole document.
    check("line 51 starts page 2", unwrap(prism_print.prism_pr_break_at(a4, 5000, 51)))
    check("line 52 does not", not unwrap(prism_print.prism_pr_break_at(a4, 5000, 52)))
    check("line 102 starts page 3", unwrap(prism_print.prism_pr_break_at(a4, 5000, 102)))
    check("negative line index rejected", is_err(prism_print.prism_pr_break_at(a4, 5000, -1)))

    print("6. construction is validated")
    check("a custom page works", prism_print.prism_pr_width(unwrap(prism_print.prism_pr_page(100000, 200000, 5000))) == 100000)
    check("zero width rejected", is_err(prism_print.prism_pr_page(0, 200000, 0)))
    check("negative margin rejected", is_err(prism_print.prism_pr_page(100000, 200000, -1)))
    // Margins that eat the page are an ERROR, not clamped: clamping yields a page with no
    // printable area and every later division breaks.
    check("margins consuming the page are REJECTED, not clamped", is_err(prism_print.prism_pr_page(100000, 200000, 50000)))
    check("non-int dimensions rejected", is_err(prism_print.prism_pr_page("100000", 200000, 0)))
    check("a zero margin is legal", not is_err(prism_print.prism_pr_page(100000, 200000, 0)))

    print("")
    if STATS[1] == 0
        print("_kat_prism_print: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_print: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
