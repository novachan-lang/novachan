// KAT for prism/intl/prism_datetime.nova.
//
// The cases chosen are the ones naive implementations get wrong:
//   1. 1900 is NOT a leap year (divisible by 100, not by 400) while 2000 IS. A month-length table
//      with a `% 4` leap rule gets exactly this pair wrong.
//   2. PRE-1970 instants: NOVA's `/` truncates toward zero, so -1/86400 is 0, and every negative
//      epoch lands a day late without floor division. Asserted directly.
//   3. Midnight and noon in 12-hour rendering: 0 -> "12 AM" and 12 -> "12 PM", the two cases a
//      hand-rolled `hour % 12` turns into "0 AM" and "0 PM".

import prism_datetime

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_datetime ==")

    print("1. the epoch itself, and a known instant")
    let e0 = unwrap(prism_datetime.prism_dt_civil(0, 0))
    check("epoch is 1970-01-01", prism_datetime.prism_dt_iso(e0) == "1970-01-01T00:00:00")
    check("epoch was a THURSDAY", prism_datetime.prism_dt_weekday_name(e0) == "Thursday")
    // 1234567890 is a well-known instant: 2009-02-13T23:31:30 UTC, a Friday.
    let known = unwrap(prism_datetime.prism_dt_civil(1234567890, 0))
    check("1234567890 -> 2009-02-13T23:31:30", prism_datetime.prism_dt_iso(known) == "2009-02-13T23:31:30")
    check("...and it was a Friday", prism_datetime.prism_dt_weekday_name(known) == "Friday")
    check("month name resolves", prism_datetime.prism_dt_month_name(known) == "February")

    print("2. ★ leap years -- 1900 is NOT one, 2000 IS")
    // 2000-02-29 exists: epoch 951782400.
    let leap2000 = unwrap(prism_datetime.prism_dt_civil(951782400, 0))
    check("2000-02-29 exists (divisible by 400)", prism_datetime.prism_dt_iso(leap2000) == "2000-02-29T00:00:00")
    // 1900-03-01 is epoch -2203891200. If 1900 were wrongly treated as a leap year this would
    // come back as 1900-02-29.
    let mar1900 = unwrap(prism_datetime.prism_dt_civil(-2203891200, 0))
    check("1900-03-01, NOT 1900-02-29 (100 but not 400)", prism_datetime.prism_dt_iso(mar1900) == "1900-03-01T00:00:00")
    // 2024-02-29 -- an ordinary leap year.
    let leap2024 = unwrap(prism_datetime.prism_dt_civil(1709164800, 0))
    check("2024-02-29 exists", prism_datetime.prism_dt_iso(leap2024) == "2024-02-29T00:00:00")

    print("3. ★ pre-1970 instants need FLOOR division")
    // -1 second is 1969-12-31T23:59:59. With truncating division this comes back as 1970-01-01.
    let minus1 = unwrap(prism_datetime.prism_dt_civil(-1, 0))
    check("-1s -> 1969-12-31T23:59:59", prism_datetime.prism_dt_iso(minus1) == "1969-12-31T23:59:59")
    check("...and its weekday is Wednesday", prism_datetime.prism_dt_weekday_name(minus1) == "Wednesday")
    let minusday = unwrap(prism_datetime.prism_dt_civil(-86400, 0))
    check("-86400s -> 1969-12-31T00:00:00", prism_datetime.prism_dt_iso(minusday) == "1969-12-31T00:00:00")

    print("4. the UTC offset is explicit, never implied")
    let ist = unwrap(prism_datetime.prism_dt_civil(0, 330))
    check("+05:30 shifts the epoch to 05:30", prism_datetime.prism_dt_iso(ist) == "1970-01-01T05:30:00")
    let west = unwrap(prism_datetime.prism_dt_civil(0, -300))
    check("-05:00 moves it to the previous day", prism_datetime.prism_dt_iso(west) == "1969-12-31T19:00:00")
    check("an absurd offset is rejected", is_err(prism_datetime.prism_dt_civil(0, 2000)))
    check("non-int epoch rejected", is_err(prism_datetime.prism_dt_civil("0", 0)))

    print("5. ★ 12-hour rendering: midnight and noon")
    check("00:00 renders as 12 AM, not 0 AM", prism_datetime.prism_dt_time(e0, true) == "12:00:00 AM")
    let noon = unwrap(prism_datetime.prism_dt_civil(43200, 0))
    check("12:00 renders as 12 PM, not 0 PM", prism_datetime.prism_dt_time(noon, true) == "12:00:00 PM")
    let am1 = unwrap(prism_datetime.prism_dt_civil(3600, 0))
    check("01:00 -> 1 AM", prism_datetime.prism_dt_time(am1, true) == "1:00:00 AM")
    let pm1 = unwrap(prism_datetime.prism_dt_civil(46800, 0))
    check("13:00 -> 1 PM", prism_datetime.prism_dt_time(pm1, true) == "1:00:00 PM")
    check("24-hour rendering is zero-padded", prism_datetime.prism_dt_time(pm1, false) == "13:00:00")

    print("6. locale date order")
    check("ymd", prism_datetime.prism_dt_date(known, prism_datetime.prism_dt_ymd()) == "2009-02-13")
    check("dmy", prism_datetime.prism_dt_date(known, prism_datetime.prism_dt_dmy()) == "13/02/2009")
    check("mdy", prism_datetime.prism_dt_date(known, prism_datetime.prism_dt_mdy()) == "02/13/2009")
    check("an unknown order is REJECTED, never guessed", is_err(prism_datetime.prism_dt_locale("ydm", "-")))
    check("empty separator rejected", is_err(prism_datetime.prism_dt_locale("ymd", "")))
    let dot = unwrap(prism_datetime.prism_dt_locale("dmy", "."))
    check("a custom separator works", prism_datetime.prism_dt_date(known, dot) == "13.02.2009")

    print("")
    if STATS[1] == 0
        print("_kat_prism_datetime: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_datetime: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
