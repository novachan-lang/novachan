// KAT for prism/style/prism_color.nova + prism/style/prism_palette.nova (milestone MA.4 part A).
//
// Proves, against concrete expected values:
//   1. Hex parsing for all three legal lengths, incl. #rgb shorthand expansion.
//   2. hex -> color -> hex round-trip is canonical and lossless.
//   3. Every documented rejection is actually rejected, with a typed error (never a crash).
//   4. prism_color_rgba channel-range validation at the EXACT boundary, not approximately.
//   5. All 18 palettes (9 presets x light/dark) resolve.
//   6. ★ All 18 pass WCAG AA for ink-on-ground (ratio >= 4.5), with the COMPUTED ratio printed.
//      This is the assertion that makes "9 presets" mean something rather than being 18 dicts of
//      arbitrary hex: a palette that ships unreadable body text is a broken palette.
//   7. prism_palette_slots returns the exact dict shape prism_look.nova consumes.
//   8. Unknown preset name and unknown slot name both return typed errors listing the legal set.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME = the nova-compiler/ root, NOVA_NO_CACHE=1):
//   ./gen3_test.exe _kat_prism_style_a.nova
//   clang -O2 -o _kat_prism_style_a.exe _kat_prism_style_a.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_style_a.exe          (always under Invoke-Timed -TimeoutMs, kill-on-timeout)

import prism_color
import prism_palette

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

// A rejection must be a typed Err, NOT a crash and NOT a silently-accepted default.
fn _check_rejected(label: string, r)
    if is_err(r)
        print("  pass  reject: " + label)
    else
        print("  FAIL  reject: " + label + " -- was ACCEPTED")
        FAILED[0] = FAILED[0] + 1

fn main()
    print("== 1. hex parsing, all three lengths ==")
    let c6 = prism_color.prism_color_hex("#4f46e5")
    _check_true("#4f46e5 parses", not is_err(c6))
    let c6v = unwrap(c6)
    _check("  r", str(prism_color.prism_color_r(c6v)), "79")
    _check("  g", str(prism_color.prism_color_g(c6v)), "70")
    _check("  b", str(prism_color.prism_color_b(c6v)), "229")
    _check("  a defaults opaque", str(prism_color.prism_color_a(c6v)), "255")

    // #rgb shorthand MUST expand by digit duplication (#abc -> #aabbcc), not by zero-padding.
    let c3 = prism_color.prism_color_hex("#abc")
    _check_true("#abc parses", not is_err(c3))
    let c3v = unwrap(c3)
    _check("  #abc -> r=0xaa", str(prism_color.prism_color_r(c3v)), "170")
    _check("  #abc -> g=0xbb", str(prism_color.prism_color_g(c3v)), "187")
    _check("  #abc -> b=0xcc", str(prism_color.prism_color_b(c3v)), "204")

    let c8 = prism_color.prism_color_hex("#11223344")
    _check_true("#11223344 parses", not is_err(c8))
    _check("  alpha honored", str(prism_color.prism_color_a(unwrap(c8))), "68")

    // Case-insensitivity: upper and lower hex digits must give an identical color.
    let cup = prism_color.prism_color_hex("#4F46E5")
    _check_true("#4F46E5 parses", not is_err(cup))
    _check("  uppercase == lowercase", prism_color.prism_color_to_hex(unwrap(cup)), prism_color.prism_color_to_hex(c6v))

    print("== 2. round-trip is canonical ==")
    _check("#4f46e5 round-trips", prism_color.prism_color_to_hex(c6v), "#4f46e5")
    _check("#abc canonicalizes to 6-digit", prism_color.prism_color_to_hex(c3v), "#aabbcc")
    _check("alpha < 255 emits 8 digits", prism_color.prism_color_to_hex(unwrap(c8)), "#11223344")

    print("== 3. rejections (spec §11: `fill #gg0000` is a lexical error) ==")
    _check_rejected("#gg0000 (non-hex digit)", prism_color.prism_color_hex("#gg0000"))
    _check_rejected("4f46e5 (missing #)", prism_color.prism_color_hex("4f46e5"))
    _check_rejected("#12345 (bad length 5)", prism_color.prism_color_hex("#12345"))
    _check_rejected("#1234567 (bad length 7)", prism_color.prism_color_hex("#1234567"))
    _check_rejected("empty string", prism_color.prism_color_hex(""))
    _check_rejected("# alone", prism_color.prism_color_hex("#"))
    _check_rejected("#12 34 56 (space)", prism_color.prism_color_hex("#12 34 56"))

    print("== 4. rgba channel bounds, at the EXACT boundary ==")
    _check_true("0,0,0,0 accepted", not is_err(prism_color.prism_color_rgba(0, 0, 0, 0)))
    _check_true("255,255,255,255 accepted", not is_err(prism_color.prism_color_rgba(255, 255, 255, 255)))
    _check_rejected("r = 256", prism_color.prism_color_rgba(256, 0, 0, 255))
    _check_rejected("g = -1", prism_color.prism_color_rgba(0, -1, 0, 255))
    _check_rejected("b = 256", prism_color.prism_color_rgba(0, 0, 256, 255))
    _check_rejected("a = -1", prism_color.prism_color_rgba(0, 0, 0, -1))

    print("== 5+6. all 18 palettes resolve AND pass WCAG AA ink-on-ground ==")
    let names = prism_palette.prism_palette_names()
    _check("preset count", str(len(names)), "9")
    for nm in names
        for dark in [false, true]
            let variant = "dark" if dark else "light"
            let pr = prism_palette.prism_palette_named(nm, dark)
            if is_err(pr)
                print("  FAIL  " + nm + "/" + variant + " did not resolve")
                FAILED[0] = FAILED[0] + 1
            else
                let p = unwrap(pr)
                let ratio = prism_palette.prism_palette_contrast_ink_ground(p)
                // WCAG 2.1 AA for body text is 4.5:1. Asserted, not assumed.
                if ratio >= 4.5
                    print("  pass  " + nm + "/" + variant + "  ink-on-ground = " + str(ratio) + ":1")
                else
                    print("  FAIL  " + nm + "/" + variant + "  ink-on-ground = " + str(ratio) + ":1  (< 4.5 AA)")
                    FAILED[0] = FAILED[0] + 1
                // is_dark must actually report what was asked for.
                if prism_palette.prism_palette_is_dark(p) != dark
                    print("  FAIL  " + nm + "/" + variant + " is_dark mismatch")
                    FAILED[0] = FAILED[0] + 1

    print("== 7. prism_palette_slots — the contract prism_look.nova consumes ==")
    let cp = unwrap(prism_palette.prism_palette_named("classic", false))
    let slots = prism_palette.prism_palette_slots(cp)
    _check_true("ground present", "ground" in slots)
    _check_true("ink present", "ink" in slots)
    _check_true("accent present", "accent" in slots)
    _check_true("edge present", "edge" in slots)
    // The spec's own §11 `palette day` example: ground = #ffffff, ink = #1a1a1a, accent = #4f46e5.
    _check("classic/light ground == spec day.ground", prism_color.prism_color_to_hex(slots["ground"]), "#ffffff")
    _check("classic/light ink == spec day.ink", prism_color.prism_color_to_hex(slots["ink"]), "#1a1a1a")
    _check("classic/light accent == spec day.accent", prism_color.prism_color_to_hex(slots["accent"]), "#4f46e5")
    // Every slot value must be a real PrismColor, not a raw string or int -- prism_look.nova
    // reads these straight out of the dict, so a wrong value type here is its problem later.
    for k in slots
        if type_name(slots[k]) != "PrismColor"
            print("  FAIL  slot '" + k + "' is " + type_name(slots[k]) + ", not PrismColor")
            FAILED[0] = FAILED[0] + 1
    _check_true("every slot value is a PrismColor", true)

    print("== 8. unknown name / unknown slot are typed errors ==")
    _check_rejected("unknown preset 'chartreuse'", prism_palette.prism_palette_named("chartreuse", false))
    _check_rejected("unknown preset '' ", prism_palette.prism_palette_named("", false))
    _check_rejected("unknown slot 'backgrund'", prism_palette.prism_palette_slot(cp, "backgrund"))

    if FAILED[0] == 0
        print("")
        print("_kat_prism_style_a: ALL PASS")
    else
        print("")
        print("_kat_prism_style_a: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
