// KAT for prism/a11y/prism_a11y.nova (milestone MB.9).
//
// Two halves, and the second is the one that matters:
//   1. Every rule fires on a deliberately-broken tree, asserted BY RULE ID AND COUNT -- "some
//      findings were produced" would pass even if the wrong rule fired, so each is checked by name.
//   2. ★ The MB.6 dashboard and docs pages -- real, shipped pages -- audit CLEAN. That is what
//      turns PRISM_SPEC.md §13's "accessibility is derived, not annotated" from a claim about the
//      design into a statement about the actual output. A rule that only ever fires on toy trees
//      proves nothing about whether Prism produces accessible pages.

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_structure
import prism_a11y
import prism_app_dashboard as dash
import prism_app_docs as docs

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

// Count findings carrying a given rule name.
fn _count_rule(findings: list, rule_name: string) -> int
    let n = 0
    for f in findings
        if prism_a11y.prism_a11y_rule_name(prism_a11y.prism_a11y_finding_rule(f)) == rule_name
            n += 1
    n

fn _lbl(s: string) -> PrismNode
    unwrap(prism_content.prism_label(s))

fn main()
    print("== 1. a clean tree produces ZERO findings ==")
    let ok_btn = unwrap(prism_interact.prism_press("Save", []))
    let ok_link = unwrap(prism_interact.prism_link("Docs", prism_interact.prism_link_target_route("/docs")))
    let clean = unwrap(prism_arrange.prism_stack([_lbl("Title"), ok_btn, ok_link]))
    let cf = unwrap(prism_a11y.prism_a11y_audit(clean))
    _check("clean tree finding count", str(len(cf)), "0")
    _check_true("assert_clean succeeds", not is_err(prism_a11y.prism_a11y_assert_clean(clean)))

    print("== 2. nested interactive -- a button inside a button ==")
    // Built through prism_node_* directly: the constructors cannot see composition, which is
    // exactly the class of defect this audit exists to catch.
    let inner = unwrap(prism_interact.prism_press("Inner", []))
    let outer = unwrap(prism_node.prism_node_branch(prism_node.prism_kind_press(), {"text": "Outer"}, [inner]))
    let nf = unwrap(prism_a11y.prism_a11y_audit(outer))
    _check("nested_interactive count", str(_count_rule(nf, "nested_interactive")), "1")
    _check("only that rule fired", str(len(nf)), "1")

    print("== 3. missing accessible name ==")
    let nameless = unwrap(prism_node.prism_node_leaf(prism_node.prism_kind_flag(), {"label": "", "state": false}))
    let nf2 = unwrap(prism_a11y.prism_a11y_audit(nameless))
    _check("no_accessible_name count", str(_count_rule(nf2, "no_accessible_name")), "1")

    print("== 4. art without alt ==")
    let no_alt = unwrap(prism_node.prism_node_leaf(prism_node.prism_kind_art(), {"source": "/a.png"}))
    _check("art_missing_alt count", str(_count_rule(unwrap(prism_a11y.prism_a11y_audit(no_alt)), "art_missing_alt")), "1")
    // An EXPLICIT empty alt is correct for a decorative image and must NOT be flagged.
    let dec = unwrap(prism_node.prism_node_leaf(prism_node.prism_kind_art(), {"source": "/a.png", "alt": ""}))
    _check("explicit decorative alt is clean", str(len(unwrap(prism_a11y.prism_a11y_audit(dec)))), "0")

    print("== 5. link with no visible text ==")
    let bare_link = unwrap(prism_node.prism_node_leaf(prism_node.prism_kind_link(), {"text": "", "href": "/x", "kind": "route"}))
    let lf = unwrap(prism_a11y.prism_a11y_audit(bare_link))
    _check("link_no_text count", str(_count_rule(lf, "link_no_text")), "1")
    // It also has no accessible name -- both are true and both should be reported, not deduped.
    _check("also reports no_accessible_name", str(_count_rule(lf, "no_accessible_name")), "1")

    print("== 6. tabs: empty, and selection out of range ==")
    let empty_tabs = unwrap(prism_node.prism_node_branch(prism_node.prism_kind_tabs(), {"selected": 0}, []))
    _check("tabs_empty count", str(_count_rule(unwrap(prism_a11y.prism_a11y_audit(empty_tabs)), "tabs_empty")), "1")
    let bad_sel = unwrap(prism_node.prism_node_branch(prism_node.prism_kind_tabs(), {"selected": 5}, [_lbl("only panel")]))
    _check("tabs_selection_range count", str(_count_rule(unwrap(prism_a11y.prism_a11y_audit(bad_sel)), "tabs_selection_range")), "1")

    print("== 7. grid: empty row and ragged rows ==")
    let r2 = unwrap(prism_node.prism_node_branch(prism_node.prism_kind_band(), {}, [_lbl("a"), _lbl("b")]))
    let r1 = unwrap(prism_node.prism_node_branch(prism_node.prism_kind_band(), {}, [_lbl("c")]))
    let ragged = unwrap(prism_node.prism_node_branch(prism_node.prism_kind_grid(), {"columns": 2}, [r2, r1]))
    _check("grid_ragged_rows count", str(_count_rule(unwrap(prism_a11y.prism_a11y_audit(ragged)), "grid_ragged_rows")), "1")
    let empty_row = unwrap(prism_node.prism_node_branch(prism_node.prism_kind_band(), {}, []))
    let with_empty = unwrap(prism_node.prism_node_branch(prism_node.prism_kind_grid(), {"columns": 1}, [empty_row]))
    _check("grid_empty_row count", str(_count_rule(unwrap(prism_a11y.prism_a11y_audit(with_empty)), "grid_empty_row")), "1")

    print("== 8. modal with nothing focusable ==")
    let dead_modal = unwrap(prism_structure.prism_sheet(_lbl("You cannot leave"), true))
    _check("modal_not_focusable count", str(_count_rule(unwrap(prism_a11y.prism_a11y_audit(dead_modal)), "modal_not_focusable")), "1")
    // With something focusable it is fine.
    let live_modal = unwrap(prism_structure.prism_sheet(unwrap(prism_arrange.prism_stack([_lbl("Confirm?"), ok_btn])), true))
    _check("modal with an action is clean", str(len(unwrap(prism_a11y.prism_a11y_audit(live_modal)))), "0")
    // A NON-exclusive sheet does not trap focus, so the rule must not fire.
    let open_sheet = unwrap(prism_structure.prism_sheet(_lbl("just a surface"), false))
    _check("non-modal sheet is clean", str(len(unwrap(prism_a11y.prism_a11y_audit(open_sheet)))), "0")

    print("== 9. severity split and rule naming ==")
    _check("errors() filters", str(len(unwrap(prism_a11y.prism_a11y_errors(outer)))), "1")
    _check("rule name", prism_a11y.prism_a11y_rule_name(prism_a11y.prism_a11y_rule_nested_interactive()), "nested_interactive")
    _check("severity name", prism_a11y.prism_a11y_severity_name(prism_a11y.prism_a11y_severity_error()), "error")
    _check_true("assert_clean fails loudly on a broken tree", is_err(prism_a11y.prism_a11y_assert_clean(outer)))

    print("== 10. ★ THE REAL PAGES -- MB.6 dashboard and docs must audit CLEAN ==")
    let dash_tree = dash.prism_app_dashboard(dash.prism_app_demo_state())
    if is_err(dash_tree)
        print("  FAIL  dashboard did not build: " + unwrap_err(dash_tree))
        FAILED[0] = FAILED[0] + 1
    else
        let df = unwrap(prism_a11y.prism_a11y_audit(unwrap(dash_tree)))
        if len(df) == 0
            print("  pass  dashboard audits clean (0 findings)")
        else
            print("  FAIL  dashboard has " + str(len(df)) + " a11y finding(s):")
            for f in df
                print("        " + prism_a11y.prism_a11y_severity_name(prism_a11y.prism_a11y_finding_severity(f)) + "/" + prism_a11y.prism_a11y_rule_name(prism_a11y.prism_a11y_finding_rule(f)) + " on " + prism_a11y.prism_a11y_finding_kind(f) + ": " + prism_a11y.prism_a11y_finding_message(f))
            FAILED[0] = FAILED[0] + 1

    let docs_tree = docs.prism_docs_tree()
    if is_err(docs_tree)
        print("  FAIL  docs page did not build: " + unwrap_err(docs_tree))
        FAILED[0] = FAILED[0] + 1
    else
        let kf = unwrap(prism_a11y.prism_a11y_audit(unwrap(docs_tree)))
        if len(kf) == 0
            print("  pass  docs reference audits clean (0 findings)")
        else
            print("  FAIL  docs reference has " + str(len(kf)) + " a11y finding(s):")
            for f in kf
                print("        " + prism_a11y.prism_a11y_severity_name(prism_a11y.prism_a11y_finding_severity(f)) + "/" + prism_a11y.prism_a11y_rule_name(prism_a11y.prism_a11y_finding_rule(f)) + " on " + prism_a11y.prism_a11y_finding_kind(f) + ": " + prism_a11y.prism_a11y_finding_message(f))
            FAILED[0] = FAILED[0] + 1

    if FAILED[0] == 0
        print("")
        print("_kat_prism_a11y: ALL PASS")
    else
        print("")
        print("_kat_prism_a11y: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
