import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_ui_confirm

// NOTE: module-level `let mut` mutated from a helper function does not propagate back to
// main's view in this compiler (each function's writes to it are local to that function).
// So `check` returns 1 (fail) / 0 (pass) and every accumulation happens inside main() itself,
// which is the scope that actually owns `total` / `failed`.
fn check(name: string, cond: bool) -> int
    if not cond
        print("FAIL " + name)
        return 1
    0

fn kind_of(n: PrismNode) -> string
    prism_node.prism_node_kind_str(n)

fn text_of(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "<missing>")

fn nchildren(n: PrismNode) -> int
    len(prism_node.prism_node_children(n))

fn child(n: PrismNode, i: int) -> PrismNode
    let cs = prism_node.prism_node_children(n)
    cs[i]

fn main() -> Result<int>
    let mut total = 0
    let mut failed = 0

    // ============================================================
    // 1. prism_cf_confirm — visible
    // ============================================================
    let r1 = prism_ui_confirm.prism_cf_confirm("Delete this?", "Yes", "No", true)
    total = total + 1
    failed = failed + check("confirm visible: is_ok", is_ok(r1))
    let n1 = unwrap(r1)
    total = total + 1
    failed = failed + check("confirm visible: root kind=layer", kind_of(n1) == "layer")
    total = total + 1
    failed = failed + check("confirm visible: root nchildren=2", nchildren(n1) == 2)

    let backdrop1 = child(n1, 0)
    total = total + 1
    failed = failed + check("confirm visible: backdrop kind=label", kind_of(backdrop1) == "label")
    total = total + 1
    failed = failed + check("confirm visible: backdrop text empty", text_of(backdrop1) == "")

    let panel1 = child(n1, 1)
    total = total + 1
    failed = failed + check("confirm visible: panel kind=stack", kind_of(panel1) == "stack")
    total = total + 1
    failed = failed + check("confirm visible: panel nchildren=3", nchildren(panel1) == 3)

    let msg1 = child(panel1, 0)
    total = total + 1
    failed = failed + check("confirm visible: msg kind=label", kind_of(msg1) == "label")
    total = total + 1
    failed = failed + check("confirm visible: msg text", text_of(msg1) == "Delete this?")

    let gap1 = child(panel1, 1)
    total = total + 1
    failed = failed + check("confirm visible: msg-gap kind=gap", kind_of(gap1) == "gap")

    let buttons1 = child(panel1, 2)
    total = total + 1
    failed = failed + check("confirm visible: buttons kind=band", kind_of(buttons1) == "band")
    total = total + 1
    failed = failed + check("confirm visible: buttons nchildren=3", nchildren(buttons1) == 3)

    let cancel_btn1 = child(buttons1, 0)
    total = total + 1
    failed = failed + check("confirm visible: cancel_btn kind=press", kind_of(cancel_btn1) == "press")
    total = total + 1
    failed = failed + check("confirm visible: cancel_btn text=No", text_of(cancel_btn1) == "No")

    let btn_gap1 = child(buttons1, 1)
    total = total + 1
    failed = failed + check("confirm visible: btn_gap kind=gap", kind_of(btn_gap1) == "gap")

    let confirm_btn1 = child(buttons1, 2)
    total = total + 1
    failed = failed + check("confirm visible: confirm_btn kind=press", kind_of(confirm_btn1) == "press")
    total = total + 1
    failed = failed + check("confirm visible: confirm_btn text=Yes", text_of(confirm_btn1) == "Yes")

    // ============================================================
    // 2. prism_cf_confirm — not visible
    // ============================================================
    let r1b = prism_ui_confirm.prism_cf_confirm("Delete this?", "Yes", "No", false)
    total = total + 1
    failed = failed + check("confirm not-visible: is_ok", is_ok(r1b))
    let n1b = unwrap(r1b)
    total = total + 1
    failed = failed + check("confirm not-visible: kind=label", kind_of(n1b) == "label")
    total = total + 1
    failed = failed + check("confirm not-visible: text empty", text_of(n1b) == "")

    // ============================================================
    // 3. prism_cf_confirm — error paths
    // ============================================================
    total = total + 1
    failed = failed + check("confirm err: empty message", is_err(prism_ui_confirm.prism_cf_confirm("", "Yes", "No", true)))
    total = total + 1
    failed = failed + check("confirm err: empty confirm_label", is_err(prism_ui_confirm.prism_cf_confirm("m", "", "No", true)))
    total = total + 1
    failed = failed + check("confirm err: empty cancel_label", is_err(prism_ui_confirm.prism_cf_confirm("m", "Yes", "", true)))
    let e_msg = unwrap_err(prism_ui_confirm.prism_cf_confirm("", "Yes", "No", true))
    total = total + 1
    failed = failed + check("confirm err: message text", contains(e_msg, "message must not be empty"))
    let e_conf = unwrap_err(prism_ui_confirm.prism_cf_confirm("m", "", "No", true))
    total = total + 1
    failed = failed + check("confirm err: confirm_label text", contains(e_conf, "confirm_label must not be empty"))
    let e_canc = unwrap_err(prism_ui_confirm.prism_cf_confirm("m", "Yes", "", true))
    total = total + 1
    failed = failed + check("confirm err: cancel_label text", contains(e_canc, "cancel_label must not be empty"))

    // ============================================================
    // 4. prism_cf_delete
    // ============================================================
    let rd = prism_ui_confirm.prism_cf_delete("record #7", true)
    total = total + 1
    failed = failed + check("delete visible: is_ok", is_ok(rd))
    let nd = unwrap(rd)
    total = total + 1
    failed = failed + check("delete visible: kind=layer", kind_of(nd) == "layer")
    let dpanel = child(nd, 1)
    let dmsg = child(dpanel, 0)
    total = total + 1
    failed = failed + check("delete visible: msg contains item name", contains(text_of(dmsg), "record #7"))
    total = total + 1
    failed = failed + check("delete visible: msg is a delete-confirmation", contains(text_of(dmsg), "Are you sure you want to delete"))
    let dbuttons = child(dpanel, 2)
    let dconfirm_btn = child(dbuttons, 2)
    total = total + 1
    failed = failed + check("delete visible: confirm button text=Delete", text_of(dconfirm_btn) == "Delete")

    let rd_nv = prism_ui_confirm.prism_cf_delete("record #7", false)
    let nd_nv = unwrap(rd_nv)
    total = total + 1
    failed = failed + check("delete not-visible: kind=label", kind_of(nd_nv) == "label")

    total = total + 1
    failed = failed + check("delete err: empty item_name", is_err(prism_ui_confirm.prism_cf_delete("", true)))
    let e_item = unwrap_err(prism_ui_confirm.prism_cf_delete("", true))
    total = total + 1
    failed = failed + check("delete err: item_name text", contains(e_item, "item_name must not be empty"))

    // ============================================================
    // 5. prism_cf_popconfirm
    // ============================================================
    let rp = prism_ui_confirm.prism_cf_popconfirm("Open", "Really open?", "Ok", "No", true)
    total = total + 1
    failed = failed + check("popconfirm visible: is_ok", is_ok(rp))
    let np = unwrap(rp)
    total = total + 1
    failed = failed + check("popconfirm visible: kind=layer", kind_of(np) == "layer")
    total = total + 1
    failed = failed + check("popconfirm visible: nchildren=2", nchildren(np) == 2)

    let trigger = child(np, 0)
    total = total + 1
    failed = failed + check("popconfirm visible: trigger kind=press", kind_of(trigger) == "press")
    total = total + 1
    failed = failed + check("popconfirm visible: trigger text=Open", text_of(trigger) == "Open")

    let dialog = child(np, 1)
    total = total + 1
    failed = failed + check("popconfirm visible: dialog kind=layer (nested confirm)", kind_of(dialog) == "layer")
    total = total + 1
    failed = failed + check("popconfirm visible: dialog nchildren=2", nchildren(dialog) == 2)

    let rp0 = prism_ui_confirm.prism_cf_popconfirm("Open", "Really open?", "Ok", "No", false)
    let np0 = unwrap(rp0)
    let trigger0 = child(np0, 0)
    total = total + 1
    failed = failed + check("popconfirm not-visible: trigger still kind=press", kind_of(trigger0) == "press")
    let dialog0 = child(np0, 1)
    total = total + 1
    failed = failed + check("popconfirm not-visible: dialog kind=label", kind_of(dialog0) == "label")
    total = total + 1
    failed = failed + check("popconfirm not-visible: dialog text empty", text_of(dialog0) == "")

    total = total + 1
    failed = failed + check("popconfirm err: empty trigger_label", is_err(prism_ui_confirm.prism_cf_popconfirm("", "m", "Yes", "No", true)))
    let e_trig = unwrap_err(prism_ui_confirm.prism_cf_popconfirm("", "m", "Yes", "No", true))
    total = total + 1
    failed = failed + check("popconfirm err: trigger_label text", contains(e_trig, "trigger_label must not be empty"))

    // ============================================================
    // 6. prism_cf_alert — visible
    // ============================================================
    let ra = prism_ui_confirm.prism_cf_alert("Saved successfully", "OK", true)
    total = total + 1
    failed = failed + check("alert visible: is_ok", is_ok(ra))
    let na = unwrap(ra)
    total = total + 1
    failed = failed + check("alert visible: kind=layer", kind_of(na) == "layer")
    total = total + 1
    failed = failed + check("alert visible: nchildren=2", nchildren(na) == 2)

    let abackdrop = child(na, 0)
    total = total + 1
    failed = failed + check("alert visible: backdrop kind=label", kind_of(abackdrop) == "label")
    total = total + 1
    failed = failed + check("alert visible: backdrop text empty", text_of(abackdrop) == "")

    let apanel = child(na, 1)
    total = total + 1
    failed = failed + check("alert visible: panel kind=stack", kind_of(apanel) == "stack")
    total = total + 1
    failed = failed + check("alert visible: panel nchildren=3", nchildren(apanel) == 3)

    let aheader = child(apanel, 0)
    total = total + 1
    failed = failed + check("alert visible: header kind=band", kind_of(aheader) == "band")
    total = total + 1
    failed = failed + check("alert visible: header nchildren=2", nchildren(aheader) == 2)

    let aicon = child(aheader, 0)
    total = total + 1
    failed = failed + check("alert visible: icon text", text_of(aicon) == "(i) ")

    let amsg = child(aheader, 1)
    total = total + 1
    failed = failed + check("alert visible: msg text", text_of(amsg) == "Saved successfully")

    let agap = child(apanel, 1)
    total = total + 1
    failed = failed + check("alert visible: gap kind=gap", kind_of(agap) == "gap")

    let aok = child(apanel, 2)
    total = total + 1
    failed = failed + check("alert visible: ok_btn kind=press", kind_of(aok) == "press")
    total = total + 1
    failed = failed + check("alert visible: ok_btn text=OK", text_of(aok) == "OK")

    // ============================================================
    // 7. prism_cf_alert — not visible
    // ============================================================
    let ra0 = prism_ui_confirm.prism_cf_alert("Saved successfully", "OK", false)
    total = total + 1
    failed = failed + check("alert not-visible: is_ok", is_ok(ra0))
    let na0 = unwrap(ra0)
    total = total + 1
    failed = failed + check("alert not-visible: kind=label", kind_of(na0) == "label")
    total = total + 1
    failed = failed + check("alert not-visible: text empty", text_of(na0) == "")

    // ============================================================
    // 8. prism_cf_alert — error paths
    // ============================================================
    total = total + 1
    failed = failed + check("alert err: empty message", is_err(prism_ui_confirm.prism_cf_alert("", "OK", true)))
    total = total + 1
    failed = failed + check("alert err: empty ok_label", is_err(prism_ui_confirm.prism_cf_alert("m", "", true)))
    let e_amsg = unwrap_err(prism_ui_confirm.prism_cf_alert("", "OK", true))
    total = total + 1
    failed = failed + check("alert err: message text", contains(e_amsg, "message must not be empty"))
    let e_aok = unwrap_err(prism_ui_confirm.prism_cf_alert("m", "", true))
    total = total + 1
    failed = failed + check("alert err: ok_label text", contains(e_aok, "ok_label must not be empty"))

    // ============================================================
    // Summary
    // ============================================================
    print("== prism_ui_confirm KAT: " + str(total - failed) + "/" + str(total) + " assertions passed ==")
    if failed > 0
        return err(str(failed) + " assertion(s) failed")
    ok(0)
