// KAT for prism/ui/prism_ui_form.nova (PRISM_ROADMAP.md milestone MB.1, first ui/ module).
//
// Proves, against concrete expected values:
//   1. All 7 field constructors (text/email/password/number/range/choice/toggle) produce the
//      right underlying PrismNodeKind through prism_form_render_input.
//   2. A field's label round-trips through the rendered row's first child (a prism_label).
//   3. A rendered 2-field form has EXACT cached depth/count (hand-computed, not "some positive
//      number") -- proves the row/help/error composition builds a correct tree, not just that it
//      builds SOME tree.
//   4. prism_form_validate catches each of the 3 rule types (required/min_length/max_length)
//      plus number's inherent range check plus toggle-required and choice-required, and passes
//      clean input for every one of those 7 dual (fail + pass) cases.
//   5. Duplicate field names are rejected by prism_form(...).
//   6. A field whose generated error message contains "<script>" renders as ESCAPED TEXT through
//      prism_render_html.prism_html_render -- never as live markup (PRISM_SPEC.md axiom A3 /
//      §15.1), proving this component invents no second injection sink.
//   7. 13 individually-asserted rejection cases (well over the required 8), each naming which
//      case broke if it regresses.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova (recursively,
// including prism/ui/) into $NOVA_HOME/lib, so every import below resolves exactly like the
// widget-layer KATs' imports do.
//   ./gen3_test.exe _kat_prism_ui_form.nova
//   clang -O2 -o _kat_prism_ui_form.exe _kat_prism_ui_form.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_form.exe

import prism_node
import prism_interact
import prism_content
import prism_arrange
import prism_ui_form
import prism_render_html

fn _fail(msg: string)
    print("FAIL " + msg)
    exit(1)

fn main()
    // ── 1. All 7 field constructors -> correct underlying PrismNodeKind ─────────────────────
    let text_r = prism_ui_form.prism_form_text("name", "Name", "Ann")
    if is_err(text_r)
        _fail("prism_form_text construction: " + unwrap_err(text_r))
    let text_f = unwrap(text_r)
    let text_input_r = prism_ui_form.prism_form_render_input(text_f)
    if is_err(text_input_r)
        _fail("prism_form_render_input(text): " + unwrap_err(text_input_r))
    assert_eq(prism_node.prism_node_kind_str(unwrap(text_input_r)), "entry")

    let email_r = prism_ui_form.prism_form_email("email", "Email", "ann@example.com")
    if is_err(email_r)
        _fail("prism_form_email construction: " + unwrap_err(email_r))
    let email_f = unwrap(email_r)
    let email_input_r = prism_ui_form.prism_form_render_input(email_f)
    if is_err(email_input_r)
        _fail("prism_form_render_input(email): " + unwrap_err(email_input_r))
    assert_eq(prism_node.prism_node_kind_str(unwrap(email_input_r)), "entry")

    let pw_r = prism_ui_form.prism_form_password("pw", "Password", "s3cr3t")
    if is_err(pw_r)
        _fail("prism_form_password construction: " + unwrap_err(pw_r))
    let pw_f = unwrap(pw_r)
    let pw_input_r = prism_ui_form.prism_form_render_input(pw_f)
    if is_err(pw_input_r)
        _fail("prism_form_render_input(password): " + unwrap_err(pw_input_r))
    assert_eq(prism_node.prism_node_kind_str(unwrap(pw_input_r)), "entry")

    let num_r = prism_ui_form.prism_form_number("age", "Age", 30, 0, 120)
    if is_err(num_r)
        _fail("prism_form_number construction: " + unwrap_err(num_r))
    let num_f = unwrap(num_r)
    let num_input_r = prism_ui_form.prism_form_render_input(num_f)
    if is_err(num_input_r)
        _fail("prism_form_render_input(number): " + unwrap_err(num_input_r))
    assert_eq(prism_node.prism_node_kind_str(unwrap(num_input_r)), "entry")

    let range_r = prism_ui_form.prism_form_range("volume", "Volume", 40, 0, 100, 5)
    if is_err(range_r)
        _fail("prism_form_range construction: " + unwrap_err(range_r))
    let range_f = unwrap(range_r)
    let range_input_r = prism_ui_form.prism_form_render_input(range_f)
    if is_err(range_input_r)
        _fail("prism_form_render_input(range): " + unwrap_err(range_input_r))
    assert_eq(prism_node.prism_node_kind_str(unwrap(range_input_r)), "range")

    let opts = [prism_interact.prism_pick_option("apple", "Apple"), prism_interact.prism_pick_option("pear", "Pear")]
    let choice_r = prism_ui_form.prism_form_choice("fruit", "Fruit", opts, "pear")
    if is_err(choice_r)
        _fail("prism_form_choice construction: " + unwrap_err(choice_r))
    let choice_f = unwrap(choice_r)
    let choice_input_r = prism_ui_form.prism_form_render_input(choice_f)
    if is_err(choice_input_r)
        _fail("prism_form_render_input(choice): " + unwrap_err(choice_input_r))
    assert_eq(prism_node.prism_node_kind_str(unwrap(choice_input_r)), "pick")

    let toggle_r = prism_ui_form.prism_form_toggle("active", "Active", true)
    if is_err(toggle_r)
        _fail("prism_form_toggle construction: " + unwrap_err(toggle_r))
    let toggle_f = unwrap(toggle_r)
    let toggle_input_r = prism_ui_form.prism_form_render_input(toggle_f)
    if is_err(toggle_input_r)
        _fail("prism_form_render_input(toggle): " + unwrap_err(toggle_input_r))
    assert_eq(prism_node.prism_node_kind_str(unwrap(toggle_input_r)), "flag")
    print("1. all 7 field constructors produce the correct underlying PrismNodeKind (entry x4, range, pick, flag): OK")

    // ── 2. Label round-trips through the rendered row's first child ─────────────────────────
    let solo_form_r = prism_ui_form.prism_form([text_f])
    if is_err(solo_form_r)
        _fail("prism_form([text_f]) construction: " + unwrap_err(solo_form_r))
    let solo_rendered_r = prism_ui_form.prism_form_render(unwrap(solo_form_r))
    if is_err(solo_rendered_r)
        _fail("prism_form_render(solo_form): " + unwrap_err(solo_rendered_r))
    let solo_rendered = unwrap(solo_rendered_r)
    let solo_row = prism_node.prism_node_children(solo_rendered)[0]
    let solo_label_node = prism_node.prism_node_children(solo_row)[0]
    assert_eq(prism_node.prism_node_kind_str(solo_label_node), "label")
    assert_eq(prism_node.prism_node_attr_str(solo_label_node, "text", ""), "Name")
    print("2. field label round-trips through the rendered row's first child (a prism_label): OK")

    // ── 3. Exact cached depth/count of a rendered 2-field form ───────────────────────────────
    // fieldA: text, no rules, no help  -> row = stack([label, input])              2 leaves
    // fieldB: email, value="", required rule (violated) + help text set
    //         -> row = stack([label, input, help, error])                          4 leaves
    // Every leaf here has depth=1/count=1 (label/entry/flag/etc. are all leaves in prism_node.nova).
    //   rowA: depth=2, count=1+1+1=3
    //   rowB: depth=2, count=1+1+1+1+1=5
    //   form: depth=max(2,2)+1=3, count=1+3+5=9
    let field_a_r = prism_ui_form.prism_form_text("name2", "Name", "Ann")
    if is_err(field_a_r)
        _fail("field A construction: " + unwrap_err(field_a_r))
    let field_a = unwrap(field_a_r)

    let field_b0_r = prism_ui_form.prism_form_email("email2", "Email", "")
    if is_err(field_b0_r)
        _fail("field B construction: " + unwrap_err(field_b0_r))
    let field_b1_r = prism_ui_form.prism_form_field_with_rules(unwrap(field_b0_r), [prism_ui_form.prism_form_rule_required()])
    if is_err(field_b1_r)
        _fail("field B with_rules: " + unwrap_err(field_b1_r))
    let field_b = prism_ui_form.prism_form_field_with_help(unwrap(field_b1_r), "We will never share this")

    let nest_form_r = prism_ui_form.prism_form([field_a, field_b])
    if is_err(nest_form_r)
        _fail("nested form construction: " + unwrap_err(nest_form_r))
    let nest_rendered_r = prism_ui_form.prism_form_render(unwrap(nest_form_r))
    if is_err(nest_rendered_r)
        _fail("nested form render: " + unwrap_err(nest_rendered_r))
    let nest_rendered = unwrap(nest_rendered_r)
    assert_eq(prism_node.prism_node_depth(nest_rendered), 3)
    assert_eq(prism_node.prism_node_count(nest_rendered), 9)
    print("3. rendered 2-field form (rowA=3 leaves incl label+input, rowB=5 leaves incl label+input+help+error) has exact depth=3/count=9: OK")

    // ── 4. prism_form_validate catches each rule type, and passes clean input ────────────────
    // 4a. required (text): empty fails, non-empty passes.
    let req_bad_field = unwrap(prism_ui_form.prism_form_field_with_rules(unwrap(prism_ui_form.prism_form_text("nick", "Nickname", "")), [prism_ui_form.prism_form_rule_required()]))
    let errs_4a = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([req_bad_field]))))
    assert_eq(len(errs_4a), 1)
    assert_eq(prism_ui_form.prism_form_error_field(errs_4a[0]), "nick")
    let req_ok_field = unwrap(prism_ui_form.prism_form_field_with_rules(unwrap(prism_ui_form.prism_form_text("nick2", "Nickname", "Bob")), [prism_ui_form.prism_form_rule_required()]))
    let errs_4a2 = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([req_ok_field]))))
    assert_eq(len(errs_4a2), 0)

    // 4b. min_length (text): too short fails, long enough passes.
    let minlen_bad = unwrap(prism_ui_form.prism_form_field_with_rules(unwrap(prism_ui_form.prism_form_text("bio", "Bio", "hi")), [prism_ui_form.prism_form_rule_min_length(5)]))
    let errs_4b = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([minlen_bad]))))
    assert_eq(len(errs_4b), 1)
    let minlen_ok = unwrap(prism_ui_form.prism_form_field_with_rules(unwrap(prism_ui_form.prism_form_text("bio2", "Bio", "hello there")), [prism_ui_form.prism_form_rule_min_length(5)]))
    let errs_4b2 = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([minlen_ok]))))
    assert_eq(len(errs_4b2), 0)

    // 4c. max_length (text): too long fails, short enough passes.
    let maxlen_bad = unwrap(prism_ui_form.prism_form_field_with_rules(unwrap(prism_ui_form.prism_form_text("code", "Code", "abcdefghij")), [prism_ui_form.prism_form_rule_max_length(5)]))
    let errs_4c = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([maxlen_bad]))))
    assert_eq(len(errs_4c), 1)
    let maxlen_ok = unwrap(prism_ui_form.prism_form_field_with_rules(unwrap(prism_ui_form.prism_form_text("code2", "Code", "abc")), [prism_ui_form.prism_form_rule_max_length(5)]))
    let errs_4c2 = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([maxlen_ok]))))
    assert_eq(len(errs_4c2), 0)

    // 4d. numeric range (number's OWN inherent min/max, no rule attached): out of bounds fails,
    // in bounds passes.
    let num_bad = unwrap(prism_ui_form.prism_form_number("age3", "Age", 200, 0, 120))
    let errs_4d = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([num_bad]))))
    assert_eq(len(errs_4d), 1)
    let num_ok = unwrap(prism_ui_form.prism_form_number("age4", "Age", 30, 0, 120))
    let errs_4d2 = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([num_ok]))))
    assert_eq(len(errs_4d2), 0)

    // 4e. toggle required ("must accept terms"): false fails, true passes.
    let tgl_bad = unwrap(prism_ui_form.prism_form_field_with_rules(unwrap(prism_ui_form.prism_form_toggle("terms", "Accept terms", false)), [prism_ui_form.prism_form_rule_required()]))
    let errs_4e = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([tgl_bad]))))
    assert_eq(len(errs_4e), 1)
    let tgl_ok = unwrap(prism_ui_form.prism_form_field_with_rules(unwrap(prism_ui_form.prism_form_toggle("terms2", "Accept terms", true)), [prism_ui_form.prism_form_rule_required()]))
    let errs_4e2 = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([tgl_ok]))))
    assert_eq(len(errs_4e2), 0)

    // 4f. choice required (nothing selected fails, a real selection passes).
    let opts2 = [prism_interact.prism_pick_option("a", "A"), prism_interact.prism_pick_option("b", "B")]
    let choice_bad = unwrap(prism_ui_form.prism_form_field_with_rules(unwrap(prism_ui_form.prism_form_choice("pick1", "Pick one", opts2, "")), [prism_ui_form.prism_form_rule_required()]))
    let errs_4f = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([choice_bad]))))
    assert_eq(len(errs_4f), 1)
    let choice_ok = unwrap(prism_ui_form.prism_form_field_with_rules(unwrap(prism_ui_form.prism_form_choice("pick2", "Pick one", opts2, "a")), [prism_ui_form.prism_form_rule_required()]))
    let errs_4f2 = unwrap(prism_ui_form.prism_form_validate(unwrap(prism_ui_form.prism_form([choice_ok]))))
    assert_eq(len(errs_4f2), 0)
    print("4. validate catches required/min_length/max_length/numeric-range/toggle-required/choice-required, and passes clean input for each: OK")

    // ── 5. Duplicate field names rejected ────────────────────────────────────────────────────
    let dup_a = unwrap(prism_ui_form.prism_form_text("dupname", "First", ""))
    let dup_b = unwrap(prism_ui_form.prism_form_text("dupname", "Second", ""))
    let dup_form_r = prism_ui_form.prism_form([dup_a, dup_b])
    if is_ok(dup_form_r)
        _fail("prism_form should reject duplicate field name 'dupname', but construction succeeded")
    print("5. prism_form rejects a duplicate field name: OK -- " + unwrap_err(dup_form_r))

    // ── 6. Error message with "<script>" renders as ESCAPED TEXT, never markup ───────────────
    let evil_field0 = unwrap(prism_ui_form.prism_form_text("x", "<script>alert(1)</script>", ""))
    let evil_field = unwrap(prism_ui_form.prism_form_field_with_rules(evil_field0, [prism_ui_form.prism_form_rule_required()]))
    let evil_form = unwrap(prism_ui_form.prism_form([evil_field]))
    let evil_node_r = prism_ui_form.prism_form_render(evil_form)
    if is_err(evil_node_r)
        _fail("prism_form_render on a form with a dangerous label failed: " + unwrap_err(evil_node_r))
    let html_r = prism_render_html.prism_html_render(unwrap(evil_node_r))
    if is_err(html_r)
        _fail("prism_html_render on the dangerous-label form failed: " + unwrap_err(html_r))
    let html = unwrap(html_r)
    if find(html, "<script>") >= 0
        _fail("rendered HTML contains a LIVE <script> tag -- error/label text leaked as markup instead of being escaped: " + html)
    if find(html, "&lt;script&gt;") < 0
        _fail("rendered HTML does not contain the expected escaped '&lt;script&gt;' -- cannot confirm the text was actually escaped rather than merely absent: " + html)
    print("6. a field/error whose text contains '<script>' renders as escaped TEXT ('&lt;script&gt;'), never as live markup: OK")

    // ── 7. 13 individually-asserted rejection cases (well over the required 8) ──────────────
    if is_ok(prism_ui_form.prism_form_text("", "Label", "v"))
        _fail("7.1: prism_form_text with an empty name must be REJECTED")
    if is_ok(prism_ui_form.prism_form_text("n", "", "v"))
        _fail("7.2: prism_form_text with an empty label must be REJECTED")
    if is_ok(prism_ui_form.prism_form_number("n", "L", 5, 10, 0))
        _fail("7.3: prism_form_number with min (10) > max (0) must be REJECTED")
    if is_ok(prism_ui_form.prism_form_range("n", "L", 5, 0, 10, -1))
        _fail("7.4: prism_form_range with a negative step must be REJECTED (delegated to prism_interact.prism_range)")
    if is_ok(prism_ui_form.prism_form_choice("n", "L", [], "x"))
        _fail("7.5: prism_form_choice with an empty option set must be REJECTED")
    let dup_opts = [prism_interact.prism_pick_option("x", "First"), prism_interact.prism_pick_option("x", "Second")]
    if is_ok(prism_ui_form.prism_form_choice("n", "L", dup_opts, "x"))
        _fail("7.6: prism_form_choice with a duplicate option VALUE must be REJECTED (delegated to prism_interact.prism_pick)")
    let re_a = unwrap(prism_ui_form.prism_form_text("same", "A", ""))
    let re_b = unwrap(prism_ui_form.prism_form_text("same", "B", ""))
    if is_ok(prism_ui_form.prism_form([re_a, re_b]))
        _fail("7.7: prism_form with two fields named 'same' must be REJECTED")
    let re_c = unwrap(prism_ui_form.prism_form_text("only", "Only", ""))
    if is_ok(prism_ui_form.prism_form([re_c, 42]))
        _fail("7.8: prism_form with a non-PrismFormField element (an int) must be REJECTED")
    if is_ok(prism_ui_form.prism_form_field_with_rules(num_ok, [prism_ui_form.prism_form_rule_required()]))
        _fail("7.9: required is not applicable to a number field and must be REJECTED")
    if is_ok(prism_ui_form.prism_form_field_with_rules(tgl_ok, [prism_ui_form.prism_form_rule_min_length(3)]))
        _fail("7.10: min_length is not applicable to a toggle field and must be REJECTED")
    if is_ok(prism_ui_form.prism_form_field_with_rules(text_f, [prism_ui_form.prism_form_rule_min_length(-1)]))
        _fail("7.11: a negative min_length must be REJECTED")
    if is_ok(prism_ui_form.prism_form_field_with_rules(text_f, [prism_ui_form.prism_form_rule_min_length(10), prism_ui_form.prism_form_rule_max_length(3)]))
        _fail("7.12: min_length (10) > max_length (3) on the same field must be REJECTED")
    if is_ok(prism_ui_form.prism_form_field_with_rules(text_f, [prism_ui_form.prism_form_rule_required(), prism_ui_form.prism_form_rule_required()]))
        _fail("7.13: a duplicate rule TYPE (required twice) must be REJECTED")
    print("7. 13 rejection cases (empty name/label, number min>max, range bad step, choice empty/duplicate options, duplicate field name, non-field element, rule/kind incompatibility x2, negative min_length, min>max length, duplicate rule type) all correctly REJECTED: OK")

    print("KAT prism_ui_form PASSED: 7 field kinds, label round-trip, exact nested depth/count, 7 validation rule-type dual checks, duplicate-name rejection, escaped-text-not-markup proof, 13 rejection cases -- all exact")
