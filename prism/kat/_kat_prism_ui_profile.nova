            print("FAIL card_header_is_band: got " + prism_node.prism_node_kind_str(ch18[0]))
            failed += 1
        if prism_node.prism_node_kind_str(ch18[1]) == "gap"
            print("  ok  card_gap1")
            passed += 1
        else
            print("FAIL card_gap1: got " + prism_node.prism_node_kind_str(ch18[1]))
            failed += 1
        if prism_node.prism_node_kind_str(ch18[2]) == "stack"
            print("  ok  card_bio_is_stack")
            passed += 1
        else
            print("FAIL card_bio_is_stack: got " + prism_node.prism_node_kind_str(ch18[2]))
            failed += 1
        if prism_node.prism_node_kind_str(ch18[3]) == "gap"
            print("  ok  card_gap2")
            passed += 1
        else
            print("FAIL card_gap2: got " + prism_node.prism_node_kind_str(ch18[3]))
            failed += 1
        if prism_node.prism_node_kind_str(ch18[4]) == "band"
            print("  ok  card_stats_is_band")
            passed += 1
        else
            print("FAIL card_stats_is_band: got " + prism_node.prism_node_kind_str(ch18[4]))
            failed += 1
    else
        print("FAIL card_ok: " + unwrap_err(r18))
        failed += 7

    // ── 19-21. card propagates sub-component errors ─────────────────────────────────────────
    let r19 = prism_ui_profile.prism_pf_card("", "Designer", "A bio.", ["Posts"], ["1"])
    if is_err(r19)
        print("  ok  card_err_propagates_header")
        passed += 1
    else
        print("FAIL card_err_propagates_header")
        failed += 1

    let r20 = prism_ui_profile.prism_pf_card("Eve", "Designer", "", ["Posts"], ["1"])
    if is_err(r20)
        print("  ok  card_err_propagates_bio")
        passed += 1
