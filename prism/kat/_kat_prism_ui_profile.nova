            print("FAIL bio_2_children: got " + str(len(ch14)))
            failed += 1
        if prism_node.prism_node_attr_str(ch14[0], "text", "") == "Dana"
            print("  ok  bio_name_text")
            passed += 1
        else
            print("FAIL bio_name_text")
            failed += 1
        if prism_node.prism_node_attr_str(ch14[1], "text", "") == "Loves hiking and reading."
            print("  ok  bio_text")
            passed += 1
        else
            print("FAIL bio_text")
            failed += 1
    else
        print("FAIL bio_ok: " + unwrap_err(r14))
