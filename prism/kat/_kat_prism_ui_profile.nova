        if prism_node.prism_node_attr_str(item0[1], "text", "") == "Posts"
            print("  ok  stats_item0_label")
            passed += 1
        else
            print("FAIL stats_item0_label: got " + prism_node.prism_node_attr_str(item0[1], "text", ""))
            failed += 1
        let item2 = prism_node.prism_node_children(ch7[2])
        if prism_node.prism_node_attr_str(item2[1], "text", "") == "Following"
            print("  ok  stats_item2_label")
            passed += 1
        else
            print("FAIL stats_item2_label: got " + prism_node.prism_node_attr_str(item2[1], "text", ""))
