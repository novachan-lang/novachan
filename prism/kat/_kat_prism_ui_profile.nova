            passed += 1
        else
            print("FAIL stats_item2_count: got " + prism_node.prism_node_attr_str(item2[0], "text", ""))
            failed += 1
    else
        print("FAIL stats_ok: " + unwrap_err(r7))
        failed += 9

    // ── 8-13. stats error paths ──────────────────────────────────────────────────────────────
    let r8 = prism_ui_profile.prism_pf_stats([], [])
    if is_err(r8)
        print("  ok  stats_err_empty")
