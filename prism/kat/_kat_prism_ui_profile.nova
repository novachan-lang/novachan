        passed += 1
    else
        print("FAIL stats_err_nonstring_count")
        failed += 1

    // ── 14. bio happy path ───────────────────────────────────────────────────────────────────
    let r14 = prism_ui_profile.prism_pf_bio("Dana", "Loves hiking and reading.")
    if is_ok(r14)
        print("  ok  bio_ok")
        passed += 1
        let n14 = unwrap(r14)
        if prism_node.prism_node_kind_str(n14) == "stack"
