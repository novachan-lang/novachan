            passed += 1
        else
            print("FAIL header_lower_initial_upper: got " + prism_node.prism_node_attr_str(ch2[0], "text", ""))
            failed += 1
    else
        print("FAIL header_lower_ok: " + unwrap_err(r2))
        failed += 2

    // ── 3. header name with leading whitespace -> trimmed initial ──────────────────────────────
    let r3 = prism_ui_profile.prism_pf_header("  Carol Danvers", "Lead")
    if is_ok(r3)
        print("  ok  header_ws_ok")
        passed += 1
