import prism_ui_profile
import prism_node
import prism_arrange
import prism_content

fn main()
    print("== KAT prism_ui_profile ==")
    let mut passed = 0
    let mut failed = 0

    // ── 1. header happy path ─────────────────────────────────────────────────────────────────
    let r1 = prism_ui_profile.prism_pf_header("Alice Smith", "Engineer")
    if is_ok(r1)
        print("  ok  header_ok")
        passed += 1
        let n1 = unwrap(r1)
        if prism_node.prism_node_kind_str(n1) == "band"
            print("  ok  header_is_band")
            passed += 1
        else
            print("FAIL header_is_band: got " + prism_node.prism_node_kind_str(n1))
            failed += 1
        let ch1 = prism_node.prism_node_children(n1)
        if len(ch1) == 3
            print("  ok  header_3_children")
            passed += 1
        else
            print("FAIL header_3_children: got " + str(len(ch1)))
            failed += 1
        if prism_node.prism_node_attr_str(ch1[0], "text", "") == "A"
            print("  ok  header_avatar_initial")
            passed += 1
        else
            print("FAIL header_avatar_initial: got " + prism_node.prism_node_attr_str(ch1[0], "text", ""))
            failed += 1
        if prism_node.prism_node_kind_str(ch1[1]) == "gap"
            print("  ok  header_gap")
            passed += 1
        else
            print("FAIL header_gap: got " + prism_node.prism_node_kind_str(ch1[1]))
            failed += 1
        if prism_node.prism_node_kind_str(ch1[2]) == "stack"
            print("  ok  header_info_is_stack")
            passed += 1
        else
            print("FAIL header_info_is_stack: got " + prism_node.prism_node_kind_str(ch1[2]))
            failed += 1
        let info1 = prism_node.prism_node_children(ch1[2])
        if len(info1) == 2
            print("  ok  header_info_2_children")
            passed += 1
        else
            print("FAIL header_info_2_children: got " + str(len(info1)))
            failed += 1
        if prism_node.prism_node_attr_str(info1[0], "text", "") == "Alice Smith"
            print("  ok  header_name_text")
            passed += 1
        else
            print("FAIL header_name_text")
            failed += 1
        if prism_node.prism_node_attr_str(info1[1], "text", "") == "Engineer"
            print("  ok  header_role_text")
            passed += 1
        else
            print("FAIL header_role_text")
            failed += 1
    else
        print("FAIL header_ok: " + unwrap_err(r1))
        failed += 9

    // ── 2. header lowercase name -> initial uppercased ──────────────────────────────────────────
    let r2 = prism_ui_profile.prism_pf_header("bob jones", "Manager")
    if is_ok(r2)
        print("  ok  header_lower_ok")
        passed += 1
        let n2 = unwrap(r2)
        let ch2 = prism_node.prism_node_children(n2)
        if prism_node.prism_node_attr_str(ch2[0], "text", "") == "B"
