    // ── 22. contact happy path ───────────────────────────────────────────────────────────────
    let r22 = prism_ui_profile.prism_pf_contact(["Email", "Phone"], ["eve@example.com", "555-0100"])
    if is_ok(r22)
        print("  ok  contact_ok")
        passed += 1
