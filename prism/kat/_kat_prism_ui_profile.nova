    // ── 18. card happy path ──────────────────────────────────────────────────────────────────
    let r18 = prism_ui_profile.prism_pf_card("Eve Adams", "Designer", "Creates delightful UI.", ["Posts", "Likes"], ["42", "999"])
    if is_ok(r18)
        print("  ok  card_ok")
