import prism_ui_list
import prism_node
import prism_arrange
import prism_content

fn main()
    print("== KAT prism_ui_list ==")
    let mut passed = 0
    let mut failed = 0

    // ---------- prism_ls_item ----------
    let item_ok = prism_ui_list.prism_ls_item("Buy milk")
    if is_ok(item_ok)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_item ok expected")

    let n1 = unwrap(item_ok)
    if prism_node.prism_node_kind_str(n1) == "band"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_item kind should be band")

    if len(prism_node.prism_node_children(n1)) == 2
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_item should have 2 children")

    let n1_kids = prism_node.prism_node_children(n1)
    let n1_c0 = n1_kids[0]
    let n1_c1 = n1_kids[1]

    if prism_node.prism_node_kind_str(n1_c0) == "label"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_item child0 should be label")

    if prism_node.prism_node_attr_str(n1_c0, "text", "<none>") == "• "
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_item bullet text mismatch")

    if prism_node.prism_node_kind_str(n1_c1) == "label"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_item child1 should be label")

    if prism_node.prism_node_attr_str(n1_c1, "text", "<none>") == "Buy milk"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_item content text mismatch")

    let item_err = prism_ui_list.prism_ls_item("")
    if is_err(item_err)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_item empty text should error")

    if contains(unwrap_err(item_err), "prism_ls_item")
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_item error message missing fn name")

    // ---------- prism_ls_numbered ----------
    let num_ok = prism_ui_list.prism_ls_numbered(0, "First")
    if is_ok(num_ok)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_numbered ok expected")

    let n2 = unwrap(num_ok)
    if prism_node.prism_node_kind_str(n2) == "band"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_numbered kind should be band")

    if len(prism_node.prism_node_children(n2)) == 2
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_numbered should have 2 children")

    let n2_kids = prism_node.prism_node_children(n2)
    let n2_c0 = n2_kids[0]
    let n2_c1 = n2_kids[1]

    if prism_node.prism_node_attr_str(n2_c0, "text", "<none>") == "1. "
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_numbered index 0 should render as '1. '")

    if prism_node.prism_node_attr_str(n2_c1, "text", "<none>") == "First"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_numbered content text mismatch")

    let num_ok2 = prism_ui_list.prism_ls_numbered(4, "Fifth")
    if is_ok(num_ok2)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_numbered(4, ...) ok expected")

    let n2b = unwrap(num_ok2)
    let n2b_kids = prism_node.prism_node_children(n2b)
    let n2b_c0 = n2b_kids[0]
    if prism_node.prism_node_attr_str(n2b_c0, "text", "<none>") == "5. "
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_numbered index 4 should render as '5. '")

    let num_err1 = prism_ui_list.prism_ls_numbered(-1, "x")
    if is_err(num_err1)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_numbered negative index should error")

    if contains(unwrap_err(num_err1), "index")
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_numbered negative index error msg mismatch")

    let num_err2 = prism_ui_list.prism_ls_numbered(0, "")
    if is_err(num_err2)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_numbered empty text should error")

    if contains(unwrap_err(num_err2), "prism_ls_numbered")
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_numbered empty text error msg mismatch")

    // ---------- prism_ls_desc ----------
    let desc_ok = prism_ui_list.prism_ls_desc("Name", "A string field")
    if is_ok(desc_ok)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_desc ok expected")

    let n3 = unwrap(desc_ok)
    if prism_node.prism_node_kind_str(n3) == "stack"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_desc kind should be stack")

    if len(prism_node.prism_node_children(n3)) == 2
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_desc should have 2 children")

    let n3_kids = prism_node.prism_node_children(n3)
    let n3_c0 = n3_kids[0]
    let n3_c1 = n3_kids[1]

    if prism_node.prism_node_kind_str(n3_c0) == "label"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_desc child0 should be label")

    if prism_node.prism_node_attr_str(n3_c0, "text", "<none>") == "Name"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_desc term text mismatch")

    if prism_node.prism_node_attr_str(n3_c1, "text", "<none>") == "  A string field"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_desc description text mismatch (expected indent)")

    let desc_err1 = prism_ui_list.prism_ls_desc("", "d")
    if is_err(desc_err1)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_desc empty term should error")

    if contains(unwrap_err(desc_err1), "term")
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_desc empty term error msg mismatch")

    let desc_err2 = prism_ui_list.prism_ls_desc("t", "")
    if is_err(desc_err2)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_desc empty description should error")

    if contains(unwrap_err(desc_err2), "description")
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_desc empty description error msg mismatch")

    // ---------- prism_ls_list ----------
    let i1 = unwrap(prism_ui_list.prism_ls_item("One"))
    let i2 = unwrap(prism_ui_list.prism_ls_item("Two"))
    let i3 = unwrap(prism_ui_list.prism_ls_item("Three"))

    let list_ok = prism_ui_list.prism_ls_list([i1, i2, i3], 8)
    if is_ok(list_ok)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list 3-item ok expected")

    let n4 = unwrap(list_ok)
    if prism_node.prism_node_kind_str(n4) == "stack"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list kind should be stack")

    if len(prism_node.prism_node_children(n4)) == 5
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list 3 items + 2 gaps should be 5 children")

    let n4_kids = prism_node.prism_node_children(n4)
    let n4_c0 = n4_kids[0]
    let n4_c1 = n4_kids[1]
    let n4_c2 = n4_kids[2]
    let n4_c3 = n4_kids[3]
    let n4_c4 = n4_kids[4]

    if prism_node.prism_node_kind_str(n4_c0) == "band"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list child0 should be band (item)")

    if prism_node.prism_node_kind_str(n4_c1) == "gap"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list child1 should be gap")

    if prism_node.prism_node_kind_str(n4_c2) == "band"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list child2 should be band (item)")

    if prism_node.prism_node_kind_str(n4_c3) == "gap"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list child3 should be gap")

    if prism_node.prism_node_kind_str(n4_c4) == "band"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list child4 should be band (item)")

    let single_ok = prism_ui_list.prism_ls_list([i1], 8)
    if is_ok(single_ok)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list single-item ok expected")

    let n4b = unwrap(single_ok)
    if len(prism_node.prism_node_children(n4b)) == 1
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list single item should have 1 child (no gap)")

    let list_err1 = prism_ui_list.prism_ls_list([], 8)
    if is_err(list_err1)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list empty items should error")

    if contains(unwrap_err(list_err1), "items")
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list empty items error msg mismatch")

    let list_err2 = prism_ui_list.prism_ls_list([i1], 0)
    if is_err(list_err2)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list gap_px=0 should error")

    if contains(unwrap_err(list_err2), "gap_px")
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list gap_px=0 error msg mismatch")

    let list_err3 = prism_ui_list.prism_ls_list([i1], -3)
    if is_err(list_err3)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list gap_px=-3 should error")

    let list_err4 = prism_ui_list.prism_ls_list([i1, 42], 8)
    if is_err(list_err4)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list non-PrismNode item should error")

    if contains(unwrap_err(list_err4), "PrismNode")
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_list non-PrismNode error msg mismatch")

    // ---------- prism_ls_check ----------
    let chk_ok1 = prism_ui_list.prism_ls_check("Task A", true)
    if is_ok(chk_ok1)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_check done=true ok expected")

    let n5 = unwrap(chk_ok1)
    if prism_node.prism_node_kind_str(n5) == "band"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_check kind should be band")

    if len(prism_node.prism_node_children(n5)) == 2
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_check should have 2 children")

    let n5_kids = prism_node.prism_node_children(n5)
    let n5_c0 = n5_kids[0]
    let n5_c1 = n5_kids[1]

    if prism_node.prism_node_attr_str(n5_c0, "text", "<none>") == "[x] "
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_check done=true icon mismatch")

    if prism_node.prism_node_attr_str(n5_c1, "text", "<none>") == "Task A"
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_check done=true content mismatch")

    let chk_ok2 = prism_ui_list.prism_ls_check("Task B", false)
    if is_ok(chk_ok2)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_check done=false ok expected")

    let n5b = unwrap(chk_ok2)
    let n5b_kids = prism_node.prism_node_children(n5b)
    let n5b_c0 = n5b_kids[0]
    if prism_node.prism_node_attr_str(n5b_c0, "text", "<none>") == "[ ] "
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_check done=false icon mismatch")

    let chk_err = prism_ui_list.prism_ls_check("", true)
    if is_err(chk_err)
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_check empty text should error")

    if contains(unwrap_err(chk_err), "prism_ls_check")
        passed += 1
    else
        failed += 1
        print("FAIL: prism_ls_check empty text error msg mismatch")

    print("== " + str(passed) + " passed, " + str(failed) + " failed ==")
    if failed > 0
        exit(1)
