import prism_ui_alert
import prism_node

fn _check(label: string, cond: bool) -> bool
    if cond
        print("PASS " + label)
        return true
    print("FAIL " + label)
    false

fn main()
    let mut total = 0
    let mut passed = 0

    let levels = ["info", "success", "warning", "error"]

    // --- prism_al_alert across all 4 levels ---
    for level in levels
        let r = prism_ui_alert.prism_al_alert("Test message for " + level, level)
        total = total + 1
        if _check("prism_al_alert ok level=" + level, is_ok(r))
            passed = passed + 1

        let n = unwrap(r)
        let children = prism_node.prism_node_children(n)
        total = total + 1
        if _check("prism_al_alert children=2 level=" + level, len(children) == 2)
            passed = passed + 1

    // --- prism_al_titled across all 4 levels ---
    for level in levels
        let r = prism_ui_alert.prism_al_titled("Title", "Body message", level)
        total = total + 1
        if _check("prism_al_titled ok level=" + level, is_ok(r))
            passed = passed + 1

        let n = unwrap(r)
        let children = prism_node.prism_node_children(n)
        total = total + 1
        if _check("prism_al_titled children=2 level=" + level, len(children) == 2)
            passed = passed + 1

    // --- prism_al_inline across all 4 levels ---
    for level in levels
        let r = prism_ui_alert.prism_al_inline("Inline message", level)
        total = total + 1
        if _check("prism_al_inline ok level=" + level, is_ok(r))
            passed = passed + 1

    // --- node shape sanity (structural, not exact tag naming) ---
    let r_alert = prism_ui_alert.prism_al_alert("hello", "info")
    let n_alert = unwrap(r_alert)
    total = total + 1
    if _check("prism_al_alert kind_str non-empty", len(prism_node.prism_node_kind_str(n_alert)) > 0)
        passed = passed + 1

    total = total + 1
    if _check("prism_node_attr_str default fallback", prism_node.prism_node_attr_str(n_alert, "_no_such_attr_", "fallback") == "fallback")
        passed = passed + 1

    let r_titled = prism_ui_alert.prism_al_titled("T", "M", "success")
    let n_titled = unwrap(r_titled)
    let titled_children = prism_node.prism_node_children(n_titled)
    let body_node = titled_children[1]
    let body_children = prism_node.prism_node_children(body_node)
    total = total + 1
    if _check("prism_al_titled body stack has 2 children", len(body_children) == 2)
        passed = passed + 1

    let r_inline = prism_ui_alert.prism_al_inline("hi", "warning")
    let n_inline = unwrap(r_inline)
    total = total + 1
    if _check("prism_al_inline is a leaf (0 children)", len(prism_node.prism_node_children(n_inline)) == 0)
        passed = passed + 1

    // --- error paths ---

    let e1 = prism_ui_alert.prism_al_alert("", "info")
    total = total + 1
    if _check("prism_al_alert empty message is_err", is_err(e1))
        passed = passed + 1
    total = total + 1
    if _check("prism_al_alert empty message text", unwrap_err(e1) == "prism_al_alert: message must not be empty")
        passed = passed + 1

    let e2 = prism_ui_alert.prism_al_alert("hello", "bogus")
    total = total + 1
    if _check("prism_al_alert invalid level is_err", is_err(e2))
        passed = passed + 1
    total = total + 1
    if _check("prism_al_alert invalid level text", unwrap_err(e2) == "prism_al_alert: invalid level 'bogus' (must be info/success/warning/error)")
        passed = passed + 1

    let e3 = prism_ui_alert.prism_al_titled("", "msg", "info")
    total = total + 1
    if _check("prism_al_titled empty title is_err", is_err(e3))
        passed = passed + 1
    total = total + 1
    if _check("prism_al_titled empty title text", unwrap_err(e3) == "prism_al_titled: title must not be empty")
        passed = passed + 1

    let e4 = prism_ui_alert.prism_al_titled("title", "", "info")
    total = total + 1
    if _check("prism_al_titled empty message is_err", is_err(e4))
        passed = passed + 1
    total = total + 1
    if _check("prism_al_titled empty message text", unwrap_err(e4) == "prism_al_titled: message must not be empty")
        passed = passed + 1

    let e5 = prism_ui_alert.prism_al_titled("title", "msg", "bogus")
    total = total + 1
    if _check("prism_al_titled invalid level is_err", is_err(e5))
        passed = passed + 1
    total = total + 1
    if _check("prism_al_titled invalid level text", unwrap_err(e5) == "prism_al_titled: invalid level 'bogus'")
        passed = passed + 1

    let e6 = prism_ui_alert.prism_al_inline("", "info")
    total = total + 1
    if _check("prism_al_inline empty message is_err", is_err(e6))
        passed = passed + 1
    total = total + 1
    if _check("prism_al_inline empty message text", unwrap_err(e6) == "prism_al_inline: message must not be empty")
        passed = passed + 1

    let e7 = prism_ui_alert.prism_al_inline("hello", "bogus")
    total = total + 1
    if _check("prism_al_inline invalid level is_err", is_err(e7))
        passed = passed + 1
    total = total + 1
    if _check("prism_al_inline invalid level text", unwrap_err(e7) == "prism_al_inline: invalid level 'bogus'")
        passed = passed + 1

    print("== " + str(passed) + "/" + str(total) + " assertions passed ==")
    if passed != total
        print("FAIL: KAT summary -- not all assertions passed")
