// KAT for prism/ui/prism_ui_nav.nova (PRISM_ROADMAP.md milestone MB.2, the `ui/` composition
// layer's navigation components: Breadcrumb, Menu, Pagination, Steps).
//
// Proves, against concrete expected values (all depth/count numbers below were obtained by
// actually running the built component and reading them back, not hand-derived and hoped for):
//   1. Breadcrumb: a 3-item trail renders `band` depth=2/count=4; every item but the last is a
//      `link` (with the exact href/kind/text), and the LAST item is a plain `label`, never a
//      `link` (the core requirement of this milestone).
//   2. Breadcrumb rejections: empty trail, a non-PrismBreadcrumbItem element, an empty label, an
//      invalid (`javascript:`) route on a NON-last item, and -- the guarantee surviving
//      composition on the item that is never rendered as a link -- an invalid route on the LAST
//      item too.
//   3. Menu: 3 entries (one with an icon, one active+iconed, one plain) render `stack`
//      depth=3/count=8; an entry with an icon is glyph+content, without is content alone; the
//      active entry's content is a `label` (never a `link` -- same current-location rule as
//      breadcrumb), every inactive entry's content is a `link`.
//   4. Menu rejections: empty entries, a non-PrismMenuEntry element, an empty label, a duplicate
//      route, TWO active entries, ZERO active entries, and a `javascript:` route (composition
//      survives here too).
//   5. Pagination: current=3/total=5 renders `band` depth=4/count=14 with exactly 7 children
//      ([prev, 1..5, next]); prev/next are both `press` (usable), each wrapping a chevron+label
//      `band`; the current page (3) is a `label`, every other page is a `press` named by number.
//   6. Pagination boundaries: current=1/total=5 disables prev (STILL PRESENT as a bare chevron+
//      label `band`, not a `press`, and not absent -- exact depth=4/count=13); current=5/total=5
//      disables next the same way (depth=4/count=13, by symmetry).
//   7. Pagination rejections at the exact boundaries: current=0, current=total+1, total=0.
//   8. Steps: a 4-step sequence with current_idx=1 renders `band` depth=3/count=7; step 0
//      (complete) is glyph(check)+label, step 1 (current) and steps 2-3 (pending) are plain
//      labels distinguished ONLY by the "step_state" accessor, never by shape.
//   9. Steps rejections: zero labels, a negative current_idx, an out-of-range current_idx, an
//      empty label, and a non-string label.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_nav` resolve.
//   ./gen3_test.exe _kat_prism_ui_nav.nova
//   clang -O2 -o _kat_prism_ui_nav.exe _kat_prism_ui_nav.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_nav.exe

import prism_node
import prism_content
import prism_interact
import prism_ui_nav

fn _fail(msg: string)
    print("FAIL " + msg)
    exit(1)

fn main()
    // ── 1. Breadcrumb: exact render structure ───────────────────────────────────────────────
    let home = prism_ui_nav.prism_breadcrumb_item("Home", "/")
    let products = prism_ui_nav.prism_breadcrumb_item("Products", "/products")
    let widget = prism_ui_nav.prism_breadcrumb_item("Widget", "/products/widget")
    let bc_r = prism_ui_nav.prism_nav_breadcrumb([home, products, widget])
    if is_err(bc_r)
        _fail("prism_nav_breadcrumb construction: " + unwrap_err(bc_r))
    let bc = unwrap(bc_r)
    assert_eq(prism_node.prism_node_kind_str(bc), "band")
    assert_eq(prism_node.prism_node_depth(bc), 2)
    assert_eq(prism_node.prism_node_count(bc), 4)
    let bcc = prism_node.prism_node_children(bc)
    assert_eq(len(bcc), 3)
    assert_eq(prism_node.prism_node_kind_str(bcc[0]), "link")
    assert_eq(prism_interact.prism_link_href(bcc[0]), "/")
    assert_eq(prism_interact.prism_link_kind_of(bcc[0]), "route")
    assert_eq(prism_node.prism_node_attr_str(bcc[0], "text", ""), "Home")
    assert_eq(prism_node.prism_node_kind_str(bcc[1]), "link")
    assert_eq(prism_interact.prism_link_href(bcc[1]), "/products")
    // The LAST item is the current page: a plain `label`, never a `link`.
    assert_eq(prism_node.prism_node_kind_str(bcc[2]), "label")
    assert_eq(prism_node.prism_node_attr_str(bcc[2], "text", ""), "Widget")
    print("1. breadcrumb: exact depth=2/count=4, non-last items are `link`, last item is `label` (never linked): OK")

    // ── 2. Breadcrumb rejections ─────────────────────────────────────────────────────────────
    let empty_trail_r = prism_ui_nav.prism_nav_breadcrumb([])
    if is_ok(empty_trail_r)
        _fail("prism_nav_breadcrumb should reject an empty trail, but construction succeeded")
    let bad_elem_r = prism_ui_nav.prism_nav_breadcrumb(["not an item"])
    if is_ok(bad_elem_r)
        _fail("prism_nav_breadcrumb should reject a non-PrismBreadcrumbItem element, but construction succeeded")
    let empty_label_item = prism_ui_nav.prism_breadcrumb_item("", "/x")
    let empty_label_r = prism_ui_nav.prism_nav_breadcrumb([empty_label_item])
    if is_ok(empty_label_r)
        _fail("prism_nav_breadcrumb should reject an empty label, but construction succeeded")
    let evil_first = prism_ui_nav.prism_breadcrumb_item("Evil", "javascript:alert(1)")
    let bad_route_nonlast_r = prism_ui_nav.prism_nav_breadcrumb([evil_first, home])
    if is_ok(bad_route_nonlast_r)
        _fail("prism_nav_breadcrumb should reject a javascript: route on a non-last item, but construction succeeded")
    // The guarantee survives composition even on the item that is NEVER rendered as a link.
    let evil_last = prism_ui_nav.prism_breadcrumb_item("Evil", "javascript:alert(1)")
    let bad_route_last_r = prism_ui_nav.prism_nav_breadcrumb([home, evil_last])
    if is_ok(bad_route_last_r)
        _fail("prism_nav_breadcrumb should reject a javascript: route on the LAST (unlinked) item, but construction succeeded")
    print("2. breadcrumb rejections (empty trail / bad element / empty label / javascript: route non-last / javascript: route last-unlinked): OK -- " + unwrap_err(empty_trail_r) + " / " + unwrap_err(bad_elem_r) + " / " + unwrap_err(empty_label_r) + " / " + unwrap_err(bad_route_nonlast_r) + " / " + unwrap_err(bad_route_last_r))

    // ── 3. Menu: exact render structure ──────────────────────────────────────────────────────
    let dash = prism_ui_nav.prism_menu_entry("Dashboard", some(prism_content.prism_icon_menu()), "/dashboard", false)
    let settings = prism_ui_nav.prism_menu_entry("Settings", some(prism_content.prism_icon_search()), "/settings", true)
    let help = prism_ui_nav.prism_menu_entry("Help", none(), "/help", false)
    let menu_r = prism_ui_nav.prism_nav_menu([dash, settings, help])
    if is_err(menu_r)
        _fail("prism_nav_menu construction: " + unwrap_err(menu_r))
    let menu = unwrap(menu_r)
    assert_eq(prism_node.prism_node_kind_str(menu), "stack")
    assert_eq(prism_node.prism_node_depth(menu), 3)
    assert_eq(prism_node.prism_node_count(menu), 8)
    let mc = prism_node.prism_node_children(menu)
    assert_eq(len(mc), 3)
    // Entry 0: has an icon, inactive -> band(glyph, link).
    assert_eq(prism_node.prism_node_kind_str(mc[0]), "band")
    let m0c = prism_node.prism_node_children(mc[0])
    assert_eq(prism_node.prism_node_kind_str(m0c[0]), "glyph")
    assert_eq(prism_node.prism_node_attr_str(m0c[0], "icon", ""), "menu")
    assert_eq(prism_node.prism_node_kind_str(m0c[1]), "link")
    assert_eq(prism_interact.prism_link_href(m0c[1]), "/dashboard")
    assert_eq(prism_node.prism_node_attr_str(m0c[1], "text", ""), "Dashboard")
    // Entry 1: has an icon, ACTIVE -> band(glyph, label) -- content is a label, never a link.
    assert_eq(prism_node.prism_node_kind_str(mc[1]), "band")
    let m1c = prism_node.prism_node_children(mc[1])
    assert_eq(prism_node.prism_node_kind_str(m1c[0]), "glyph")
    assert_eq(prism_node.prism_node_attr_str(m1c[0], "icon", ""), "search")
    assert_eq(prism_node.prism_node_kind_str(m1c[1]), "label")
    assert_eq(prism_node.prism_node_attr_str(m1c[1], "text", ""), "Settings")
    // Entry 2: no icon, inactive -> link alone (no band wrapper).
    assert_eq(prism_node.prism_node_kind_str(mc[2]), "link")
    assert_eq(prism_interact.prism_link_href(mc[2]), "/help")
    print("3. menu: exact depth=3/count=8, icon entries are band(glyph,content), active entry's content is `label` (never linked), no-icon entry is a bare `link`: OK")

    // ── 4. Menu rejections ────────────────────────────────────────────────────────────────────
    let empty_entries_r = prism_ui_nav.prism_nav_menu([])
    if is_ok(empty_entries_r)
        _fail("prism_nav_menu should reject an empty entry set, but construction succeeded")
    let bad_entry_r = prism_ui_nav.prism_nav_menu([42])
    if is_ok(bad_entry_r)
        _fail("prism_nav_menu should reject a non-PrismMenuEntry element, but construction succeeded")
    let empty_label_entry = prism_ui_nav.prism_menu_entry("", none(), "/x", true)
    let empty_entry_label_r = prism_ui_nav.prism_nav_menu([empty_label_entry])
    if is_ok(empty_entry_label_r)
        _fail("prism_nav_menu should reject an empty label, but construction succeeded")
    let dup_a = prism_ui_nav.prism_menu_entry("A", none(), "/same", true)
    let dup_b = prism_ui_nav.prism_menu_entry("B", none(), "/same", false)
    let dup_route_r = prism_ui_nav.prism_nav_menu([dup_a, dup_b])
    if is_ok(dup_route_r)
        _fail("prism_nav_menu should reject a duplicate route, but construction succeeded")
    let active_a = prism_ui_nav.prism_menu_entry("A", none(), "/a", true)
    let active_b = prism_ui_nav.prism_menu_entry("B", none(), "/b", true)
    let two_active_r = prism_ui_nav.prism_nav_menu([active_a, active_b])
    if is_ok(two_active_r)
        _fail("prism_nav_menu should reject two active entries, but construction succeeded")
    let inactive_a = prism_ui_nav.prism_menu_entry("A", none(), "/a", false)
    let inactive_b = prism_ui_nav.prism_menu_entry("B", none(), "/b", false)
    let zero_active_r = prism_ui_nav.prism_nav_menu([inactive_a, inactive_b])
    if is_ok(zero_active_r)
        _fail("prism_nav_menu should reject zero active entries, but construction succeeded")
    let evil_entry = prism_ui_nav.prism_menu_entry("Evil", none(), "javascript:alert(1)", false)
    let evil_route_r = prism_ui_nav.prism_nav_menu([evil_entry, settings])
    if is_ok(evil_route_r)
        _fail("prism_nav_menu should reject a javascript: route, but construction succeeded")
    print("4. menu rejections (empty entries / bad element / empty label / duplicate route / two active / zero active / javascript: route): OK -- " + unwrap_err(empty_entries_r) + " / " + unwrap_err(bad_entry_r) + " / " + unwrap_err(empty_entry_label_r) + " / " + unwrap_err(dup_route_r) + " / " + unwrap_err(two_active_r) + " / " + unwrap_err(zero_active_r) + " / " + unwrap_err(evil_route_r))

    // ── 5. Pagination: exact render structure ────────────────────────────────────────────────
    let pg_r = prism_ui_nav.prism_nav_pages(3, 5)
    if is_err(pg_r)
        _fail("prism_nav_pages(3, 5) construction: " + unwrap_err(pg_r))
    let pg = unwrap(pg_r)
    assert_eq(prism_node.prism_node_kind_str(pg), "band")
    assert_eq(prism_node.prism_node_depth(pg), 4)
    assert_eq(prism_node.prism_node_count(pg), 14)
    let pgc = prism_node.prism_node_children(pg)
    assert_eq(len(pgc), 7)
    // prev (enabled): a `press` wrapping a chevron+label band, accessible name "Previous".
    assert_eq(prism_node.prism_node_kind_str(pgc[0]), "press")
    assert_eq(prism_node.prism_node_attr_str(pgc[0], "text", ""), "Previous")
    let pg0c = prism_node.prism_node_children(pgc[0])
    assert_eq(len(pg0c), 1)
    assert_eq(prism_node.prism_node_kind_str(pg0c[0]), "band")
    let pg0_0c = prism_node.prism_node_children(pg0c[0])
    assert_eq(prism_node.prism_node_kind_str(pg0_0c[0]), "glyph")
    assert_eq(prism_node.prism_node_attr_str(pg0_0c[0], "icon", ""), "chevron_left")
    assert_eq(prism_node.prism_node_kind_str(pg0_0c[1]), "label")
    assert_eq(prism_node.prism_node_attr_str(pg0_0c[1], "text", ""), "Previous")
    // page 1 (not current): a `press` named "1".
    assert_eq(prism_node.prism_node_kind_str(pgc[1]), "press")
    assert_eq(prism_node.prism_node_attr_str(pgc[1], "text", ""), "1")
    // page 3 (current): a `label` -- never a control.
    assert_eq(prism_node.prism_node_kind_str(pgc[3]), "label")
    assert_eq(prism_node.prism_node_attr_str(pgc[3], "text", ""), "3")
    // next (enabled): a `press` named "Next".
    assert_eq(prism_node.prism_node_kind_str(pgc[6]), "press")
    assert_eq(prism_node.prism_node_attr_str(pgc[6], "text", ""), "Next")
    print("5. pagination(current=3, total=5): exact depth=4/count=14, 7 children [prev,1..5,next], prev/next are `press`, current page is `label`: OK")

    // ── 6. Pagination boundaries: disabled prev/next are PRESENT, never hidden ──────────────
    let pg1_r = prism_ui_nav.prism_nav_pages(1, 5)
    if is_err(pg1_r)
        _fail("prism_nav_pages(1, 5) construction: " + unwrap_err(pg1_r))
    let pg1 = unwrap(pg1_r)
    assert_eq(prism_node.prism_node_depth(pg1), 4)
    assert_eq(prism_node.prism_node_count(pg1), 13)
    let pg1c = prism_node.prism_node_children(pg1)
    assert_eq(len(pg1c), 7)
    // prev DISABLED on page 1: still present, in the same position, but a bare band (not `press`).
    assert_eq(prism_node.prism_node_kind_str(pg1c[0]), "band")
    let pg1_0c = prism_node.prism_node_children(pg1c[0])
    assert_eq(prism_node.prism_node_kind_str(pg1_0c[0]), "glyph")
    assert_eq(prism_node.prism_node_attr_str(pg1_0c[0], "icon", ""), "chevron_left")
    assert_eq(prism_node.prism_node_kind_str(pg1_0c[1]), "label")
    assert_eq(prism_node.prism_node_attr_str(pg1_0c[1], "text", ""), "Previous")
    // next still enabled (page 1 of 5 is not the last page).
    assert_eq(prism_node.prism_node_kind_str(pg1c[6]), "press")

    let pg5_r = prism_ui_nav.prism_nav_pages(5, 5)
    if is_err(pg5_r)
        _fail("prism_nav_pages(5, 5) construction: " + unwrap_err(pg5_r))
    let pg5 = unwrap(pg5_r)
    assert_eq(prism_node.prism_node_depth(pg5), 4)
    assert_eq(prism_node.prism_node_count(pg5), 13)
    let pg5c = prism_node.prism_node_children(pg5)
    assert_eq(len(pg5c), 7)
    // prev still enabled (page 5 of 5 is not the first page).
    assert_eq(prism_node.prism_node_kind_str(pg5c[0]), "press")
    // next DISABLED on the last page: still present, bare band, not `press`.
    assert_eq(prism_node.prism_node_kind_str(pg5c[6]), "band")
    let pg5_6c = prism_node.prism_node_children(pg5c[6])
    assert_eq(prism_node.prism_node_kind_str(pg5_6c[0]), "glyph")
    assert_eq(prism_node.prism_node_attr_str(pg5_6c[0], "icon", ""), "chevron_right")
    print("6. pagination boundaries: current=1 disables prev (present as band, depth=4/count=13), current=total disables next (present as band, depth=4/count=13) -- neither control is ever absent: OK")

    // ── 7. Pagination rejections at the exact boundaries ────────────────────────────────────
    let cur_zero_r = prism_ui_nav.prism_nav_pages(0, 5)
    if is_ok(cur_zero_r)
        _fail("prism_nav_pages should reject current=0, but construction succeeded")
    let cur_over_r = prism_ui_nav.prism_nav_pages(6, 5)
    if is_ok(cur_over_r)
        _fail("prism_nav_pages should reject current=total+1 (6 of 5), but construction succeeded")
    let total_zero_r = prism_ui_nav.prism_nav_pages(1, 0)
    if is_ok(total_zero_r)
        _fail("prism_nav_pages should reject total=0, but construction succeeded")
    print("7. pagination rejections at exact boundaries (current=0 / current=total+1 / total=0): OK -- " + unwrap_err(cur_zero_r) + " / " + unwrap_err(cur_over_r) + " / " + unwrap_err(total_zero_r))

    // ── 8. Steps: exact render structure ─────────────────────────────────────────────────────
    let steps_r = prism_ui_nav.prism_nav_steps(["Cart", "Shipping", "Payment", "Confirm"], 1)
    if is_err(steps_r)
        _fail("prism_nav_steps construction: " + unwrap_err(steps_r))
    let steps = unwrap(steps_r)
    assert_eq(prism_node.prism_node_kind_str(steps), "band")
    assert_eq(prism_node.prism_node_depth(steps), 3)
    assert_eq(prism_node.prism_node_count(steps), 7)
    let stc = prism_node.prism_node_children(steps)
    assert_eq(len(stc), 4)
    // Step 0 (complete, index < current_idx): glyph(check) + label, tagged "complete".
    assert_eq(prism_node.prism_node_kind_str(stc[0]), "band")
    assert_eq(prism_ui_nav.prism_nav_step_state(stc[0]), "complete")
    let st0c = prism_node.prism_node_children(stc[0])
    assert_eq(prism_node.prism_node_kind_str(st0c[0]), "glyph")
    assert_eq(prism_node.prism_node_attr_str(st0c[0], "icon", ""), "check")
    assert_eq(prism_node.prism_node_kind_str(st0c[1]), "label")
    assert_eq(prism_node.prism_node_attr_str(st0c[1], "text", ""), "Cart")
    // Step 1 (current): plain label, tagged "current".
    assert_eq(prism_node.prism_node_kind_str(stc[1]), "label")
    assert_eq(prism_ui_nav.prism_nav_step_state(stc[1]), "current")
    assert_eq(prism_node.prism_node_attr_str(stc[1], "text", ""), "Shipping")
    // Steps 2-3 (pending): plain label, tagged "pending" -- shape-identical to "current",
    // distinguished ONLY by the step_state accessor (see prism_ui_nav.nova's header).
    assert_eq(prism_node.prism_node_kind_str(stc[2]), "label")
    assert_eq(prism_ui_nav.prism_nav_step_state(stc[2]), "pending")
    assert_eq(prism_node.prism_node_attr_str(stc[2], "text", ""), "Payment")
    assert_eq(prism_ui_nav.prism_nav_step_state(stc[3]), "pending")
    assert_eq(prism_node.prism_node_attr_str(stc[3], "text", ""), "Confirm")
    print("8. steps: exact depth=3/count=7, complete=glyph(check)+label, current/pending are shape-identical labels told apart only by step_state: OK")

    // ── 9. Steps rejections ───────────────────────────────────────────────────────────────────
    let empty_steps_r = prism_ui_nav.prism_nav_steps([], 0)
    if is_ok(empty_steps_r)
        _fail("prism_nav_steps should reject zero labels, but construction succeeded")
    let neg_idx_r = prism_ui_nav.prism_nav_steps(["A", "B"], -1)
    if is_ok(neg_idx_r)
        _fail("prism_nav_steps should reject a negative current_idx, but construction succeeded")
    let over_idx_r = prism_ui_nav.prism_nav_steps(["A", "B"], 2)
    if is_ok(over_idx_r)
        _fail("prism_nav_steps should reject an out-of-range current_idx (2 for 2 steps), but construction succeeded")
    let empty_step_label_r = prism_ui_nav.prism_nav_steps(["A", ""], 0)
    if is_ok(empty_step_label_r)
        _fail("prism_nav_steps should reject an empty step label, but construction succeeded")
    let non_string_label_r = prism_ui_nav.prism_nav_steps(["A", 5], 0)
    if is_ok(non_string_label_r)
        _fail("prism_nav_steps should reject a non-string step label, but construction succeeded")
    print("9. steps rejections (zero labels / negative idx / out-of-range idx / empty label / non-string label): OK -- " + unwrap_err(empty_steps_r) + " / " + unwrap_err(neg_idx_r) + " / " + unwrap_err(over_idx_r) + " / " + unwrap_err(empty_step_label_r) + " / " + unwrap_err(non_string_label_r))

    print("KAT prism_ui_nav PASSED: breadcrumb (last item never linked) + menu (active entry never linked, exactly-one-active enforced) + pagination (disabled controls present not hidden, exact boundaries) + steps (state tagging survives shape-identical rendering) -- all exact, 20 rejection cases")
