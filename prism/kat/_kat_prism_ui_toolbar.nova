import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_ui_toolbar

fn assert_true(name: string, cond: bool) -> int
    if cond
        return 1
    print("FAIL: " + name)
    return 0

fn assert_str(name: string, expected: string, actual: string) -> int
    if expected == actual
        return 1
    print("FAIL: " + name + " expected=[" + expected + "] actual=[" + actual + "]")
    return 0

fn mk_action(label: string) -> PrismNode
    unwrap(prism_ui_toolbar.prism_tb_action(label))

fn main()
    let mut pass = 0
    let mut total = 0

    // --- 1. prism_tb_action ---
    let r1 = prism_ui_toolbar.prism_tb_action("Save")
    total += 1
    pass += assert_true("action(Save) is_ok", is_ok(r1))
    let n1 = unwrap(r1)
    let n1_children = prism_node.prism_node_children(n1)
    total += 1
    pass += assert_true("action(Save) has 1 child (the label)", len(n1_children) == 1)

    let r2 = prism_ui_toolbar.prism_tb_action("")
    total += 1
    pass += assert_true("action('') is_err", is_err(r2))
    total += 1
    pass += assert_true("action('') error mentions empty", contains(unwrap_err(r2), "must not be empty"))

    let r3 = prism_ui_toolbar.prism_tb_action("Cancel")
    total += 1
    pass += assert_true("action(Cancel) is_ok", is_ok(r3))
    let n3_children = prism_node.prism_node_children(unwrap(r3))
    total += 1
    pass += assert_true("action(Cancel) has 1 child", len(n3_children) == 1)

    let r4 = prism_ui_toolbar.prism_tb_action(" ")
    total += 1
    pass += assert_true("action(' ') whitespace non-empty is_ok", is_ok(r4))

    // --- 2. prism_tb_separator ---
    let s1 = prism_ui_toolbar.prism_tb_separator()
    total += 1
    pass += assert_true("separator() is_ok", is_ok(s1))
    let s1n = unwrap(s1)
    total += 1
    pass += assert_str("separator() kind is label", "label", prism_node.prism_node_kind_str(s1n))

    let s2 = prism_ui_toolbar.prism_tb_separator()
    total += 1
    pass += assert_true("separator() called twice still is_ok", is_ok(s2))

    // --- 3. prism_tb_toolbar ---
    let a = mk_action("A")
    let b = mk_action("B")
    let c = mk_action("C")

    let t1 = prism_ui_toolbar.prism_tb_toolbar([a, b, c], 8)
    total += 1
    pass += assert_true("toolbar(3 items) is_ok", is_ok(t1))
    let t1n = unwrap(t1)
    let t1_children = prism_node.prism_node_children(t1n)
    total += 1
    pass += assert_true("toolbar(3 items) has 5 children (3 items + 2 gaps)", len(t1_children) == 5)
    total += 1
    pass += assert_str("toolbar(3 items) outer kind is band", "band", prism_node.prism_node_kind_str(t1n))

    let t2 = prism_ui_toolbar.prism_tb_toolbar([a], 4)
    total += 1
    pass += assert_true("toolbar(1 item) is_ok", is_ok(t2))
    let t2_children = prism_node.prism_node_children(unwrap(t2))
    total += 1
    pass += assert_true("toolbar(1 item) has 1 child (no gap needed)", len(t2_children) == 1)

    let t3 = prism_ui_toolbar.prism_tb_toolbar([a, b], 1)
    total += 1
    pass += assert_true("toolbar(2 items) is_ok", is_ok(t3))
    let t3_children = prism_node.prism_node_children(unwrap(t3))
    total += 1
    pass += assert_true("toolbar(2 items) has 3 children (2 items + 1 gap)", len(t3_children) == 3)

    let t4 = prism_ui_toolbar.prism_tb_toolbar([a, b, c, mk_action("D")], 10)
    total += 1
    pass += assert_true("toolbar(4 items) is_ok", is_ok(t4))
    let t4_children = prism_node.prism_node_children(unwrap(t4))
    total += 1
    pass += assert_true("toolbar(4 items) has 7 children (4 items + 3 gaps)", len(t4_children) == 7)

    let t5 = prism_ui_toolbar.prism_tb_toolbar([], 8)
    total += 1
    pass += assert_true("toolbar(empty items) is_err", is_err(t5))
    total += 1
    pass += assert_true("toolbar(empty) error mentions items", contains(unwrap_err(t5), "items must not be empty"))

    let t6 = prism_ui_toolbar.prism_tb_toolbar([a, b], 0)
    total += 1
    pass += assert_true("toolbar(gap_px=0) is_err", is_err(t6))
    total += 1
    pass += assert_true("toolbar(gap_px=0) error mentions gap_px", contains(unwrap_err(t6), "gap_px"))

    let t7 = prism_ui_toolbar.prism_tb_toolbar([a, b], -5)
    total += 1
    pass += assert_true("toolbar(gap_px=-5) is_err", is_err(t7))
    total += 1
    pass += assert_true("toolbar(gap_px=-5) error mentions gap_px", contains(unwrap_err(t7), "gap_px"))

    let t8 = prism_ui_toolbar.prism_tb_toolbar([a, "not_a_node", b], 8)
    total += 1
    pass += assert_true("toolbar(non-PrismNode item) is_err", is_err(t8))
    total += 1
    pass += assert_true("toolbar(non-PrismNode) error mentions PrismNode", contains(unwrap_err(t8), "not a PrismNode"))

    // --- 4. prism_tb_group ---
    let g1 = prism_ui_toolbar.prism_tb_group([a, b])
    total += 1
    pass += assert_true("group(2 actions) is_ok", is_ok(g1))
    let g1n = unwrap(g1)
    let g1_children = prism_node.prism_node_children(g1n)
    total += 1
    pass += assert_true("group(2 actions) has 2 children (no gap)", len(g1_children) == 2)
    total += 1
    pass += assert_str("group(2 actions) outer kind is band", "band", prism_node.prism_node_kind_str(g1n))

    let g2 = prism_ui_toolbar.prism_tb_group([a])
    total += 1
    pass += assert_true("group(1 action) is_ok", is_ok(g2))
    total += 1
    pass += assert_true("group(1 action) has 1 child", len(prism_node.prism_node_children(unwrap(g2))) == 1)

    let g3 = prism_ui_toolbar.prism_tb_group([a, b, c, mk_action("D"), mk_action("E")])
    total += 1
    pass += assert_true("group(5 actions) is_ok", is_ok(g3))
    total += 1
    pass += assert_true("group(5 actions) has 5 children", len(prism_node.prism_node_children(unwrap(g3))) == 5)

    let g4 = prism_ui_toolbar.prism_tb_group([])
    total += 1
    pass += assert_true("group(empty) is_err", is_err(g4))
    total += 1
    pass += assert_true("group(empty) error mentions actions", contains(unwrap_err(g4), "actions must not be empty"))

    let g5 = prism_ui_toolbar.prism_tb_group([a, 42])
    total += 1
    pass += assert_true("group(non-PrismNode) is_err", is_err(g5))
    total += 1
    pass += assert_true("group(non-PrismNode) error mentions PrismNode", contains(unwrap_err(g5), "not a PrismNode"))

    // --- 5. prism_tb_action_bar ---
    let ab1 = prism_ui_toolbar.prism_tb_action_bar([a, b], [c])
    total += 1
    pass += assert_true("action_bar(left,right) is_ok", is_ok(ab1))
    let ab1n = unwrap(ab1)
    let ab1_children = prism_node.prism_node_children(ab1n)
    total += 1
    pass += assert_true("action_bar has 3 children (left,gap,right)", len(ab1_children) == 3)
    total += 1
    pass += assert_str("action_bar outer kind is band", "band", prism_node.prism_node_kind_str(ab1n))
    total += 1
    pass += assert_str("action_bar spacer kind is gap", "gap", prism_node.prism_node_kind_str(ab1_children[1]))
    total += 1
    pass += assert_str("action_bar left child kind is band", "band", prism_node.prism_node_kind_str(ab1_children[0]))
    total += 1
    pass += assert_str("action_bar right child kind is band", "band", prism_node.prism_node_kind_str(ab1_children[2]))

    let ab2 = prism_ui_toolbar.prism_tb_action_bar([a], [])
    total += 1
    pass += assert_true("action_bar(left only) is_ok", is_ok(ab2))

    let ab3 = prism_ui_toolbar.prism_tb_action_bar([], [b])
    total += 1
    pass += assert_true("action_bar(right only) is_ok", is_ok(ab3))

    let ab4 = prism_ui_toolbar.prism_tb_action_bar([], [])
    total += 1
    pass += assert_true("action_bar(both empty) is_err", is_err(ab4))
    total += 1
    pass += assert_true("action_bar(both empty) error mentions at least one side", contains(unwrap_err(ab4), "at least one side"))

    let ab5 = prism_ui_toolbar.prism_tb_action_bar(["bad"], [b])
    total += 1
    pass += assert_true("action_bar(left non-PrismNode) is_err", is_err(ab5))
    total += 1
    pass += assert_true("action_bar(left non-PrismNode) error mentions left item", contains(unwrap_err(ab5), "left item"))

    let ab6 = prism_ui_toolbar.prism_tb_action_bar([a], [99])
    total += 1
    pass += assert_true("action_bar(right non-PrismNode) is_err", is_err(ab6))
    total += 1
    pass += assert_true("action_bar(right non-PrismNode) error mentions right item", contains(unwrap_err(ab6), "right item"))

    let ab7 = prism_ui_toolbar.prism_tb_action_bar([a, b, c], [mk_action("D"), mk_action("E"), mk_action("F")])
    total += 1
    pass += assert_true("action_bar(3,3) is_ok", is_ok(ab7))
    total += 1
    pass += assert_true("action_bar(3,3) has 3 children", len(prism_node.prism_node_children(unwrap(ab7))) == 3)

    // --- composition: nested toolbar node accepted as an item ---
    let nested_inner = unwrap(prism_ui_toolbar.prism_tb_toolbar([a, b], 4))
    let nested_outer = prism_ui_toolbar.prism_tb_toolbar([nested_inner, c], 8)
    total += 1
    pass += assert_true("toolbar accepts a nested toolbar band as an item", is_ok(nested_outer))

    let nested_group = prism_ui_toolbar.prism_tb_group([nested_inner, c])
    total += 1
    pass += assert_true("group accepts a nested toolbar band as an item", is_ok(nested_group))

    print(str(pass) + "/" + str(total) + " assertions passed")
    if pass == total
        print("KAT _kat_prism_ui_toolbar: PASS")
    else
        print("KAT _kat_prism_ui_toolbar: FAIL")
