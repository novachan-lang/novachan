// KAT for prism/dev/prism_test.nova -- the testing API (#47), query by DERIVED role/label.
//
// The properties this proves:
//   1. ROLES ARE DERIVED FROM THE TYPE (§9), so a query-by-role cannot drift from behaviour.
//      Asserted against §9's normative table directly, for all six interaction primitives.
//   2. ★ ZERO matches and MULTIPLE matches are BOTH errors. Returning the first of several is the
//      most damaging convenience a testing API can offer -- the test goes green while asserting
//      against an element the user never sees, and keeps passing after the real one is deleted.
//   3. Results come back in DOCUMENT ORDER, so "the third checkbox" means what the author thinks.

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_test

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_test ==")

    print("1. §9's derived-role table, all six interaction primitives")
    check("press -> button", prism_node.prism_node_role_of(prism_node.prism_kind_press()) == "button")
    check("entry -> textbox", prism_node.prism_node_role_of(prism_node.prism_kind_entry()) == "textbox")
    check("pick -> combobox", prism_node.prism_node_role_of(prism_node.prism_kind_pick()) == "combobox")
    check("flag -> checkbox", prism_node.prism_node_role_of(prism_node.prism_kind_flag()) == "checkbox")
    check("range -> slider", prism_node.prism_node_role_of(prism_node.prism_kind_range()) == "slider")
    check("link -> link", prism_node.prism_node_role_of(prism_node.prism_kind_link()) == "link")
    // A pure-layout node has NO role -- returned as "", never as a magic "generic" string, so a
    // caller can distinguish "no role" from "a role happens to be called generic".
    check("stack has no role", prism_node.prism_node_role_of(prism_node.prism_kind_stack()) == "")
    check("label has no role", prism_node.prism_node_role_of(prism_node.prism_kind_label()) == "")
    // Every kind must be total -- a new primitive added without a role turns this red.
    let roles = prism_node.prism_node_kind_all().map(fn(k) prism_node.prism_node_role_of(k))
    check("role derivation is TOTAL over all 22 kinds", len(roles) == 22)

    print("2. querying a real tree")
    let submit = unwrap(prism_interact.prism_press("Submit", []))
    let cancel = unwrap(prism_interact.prism_press("Cancel", []))
    let agree = unwrap(prism_interact.prism_flag("I agree", false))
    let news = unwrap(prism_interact.prism_flag("Newsletter", true))
    let heading = unwrap(prism_content.prism_label("Checkout"))
    let tree = unwrap(prism_arrange.prism_stack([heading, agree, news, unwrap(prism_arrange.prism_band([submit, cancel]))]))

    check("finds both buttons", prism_test.prism_tst_count(tree, "button", "") == 2)
    check("finds both checkboxes", prism_test.prism_tst_count(tree, "checkbox", "") == 2)
    check("finds the Submit button by role+label", not is_err(prism_test.prism_tst_one(tree, "button", "Submit")))
    check("exists() agrees", prism_test.prism_tst_exists(tree, "button", "Cancel"))
    check("a label-only query works", not is_err(prism_test.prism_tst_one(tree, "", "I agree")))
    check("a role that is not present yields 0", prism_test.prism_tst_count(tree, "slider", "") == 0)
    check("layout nodes are not returned by a role query", prism_test.prism_tst_count(tree, "", "") > prism_test.prism_tst_count(tree, "button", ""))

    print("3. ★ zero and multiple are BOTH errors")
    check("NO match is an err", is_err(prism_test.prism_tst_one(tree, "button", "Nope")))
    // Two buttons, no label filter -> ambiguous. A testing API that returned the first here would
    // silently assert against the wrong control.
    check("MULTIPLE matches is an err, not the first one", is_err(prism_test.prism_tst_one(tree, "button", "")))
    check("assert_one succeeds for a unique match", not is_err(prism_test.prism_tst_assert_one(tree, "button", "Submit")))
    check("assert_one fails for none", is_err(prism_test.prism_tst_assert_one(tree, "button", "Nope")))
    check("assert_one fails for many", is_err(prism_test.prism_tst_assert_one(tree, "button", "")))
    // all() is the sanctioned way to expect N.
    check("all() returns both when N is intended", len(prism_test.prism_tst_all(tree, "button", "")) == 2)

    print("4. document order, and the accessible name")
    check("roles come back in tree order", join(prism_test.prism_tst_roles(tree), ",") == "checkbox,checkbox,button,button")
    check("labels come back in tree order", join(prism_test.prism_tst_labels(tree), ",") == "Checkout,I agree,Newsletter,Submit,Cancel")
    check("a button's accessible name is its text", prism_test.prism_tst_label(submit) == "Submit")
    check("a checkbox's accessible name is its label", prism_test.prism_tst_label(agree) == "I agree")
    check("a press node derives role button", prism_test.prism_tst_role(submit) == "button")

    print("5. non-ASCII labels are matched exactly")
    let jp = unwrap(prism_interact.prism_press("送信", []))
    let jtree = unwrap(prism_arrange.prism_stack([jp]))
    check("a non-ASCII label is findable", not is_err(prism_test.prism_tst_one(jtree, "button", "送信")))
    check("a partial byte-prefix does NOT match", is_err(prism_test.prism_tst_one(jtree, "button", "送")))

    print("6. bad inputs are rejected, not coerced")
    check("non-string role matches nothing", prism_test.prism_tst_count(tree, 7, "") == 0)
    check("non-string label matches nothing", prism_test.prism_tst_count(tree, "", 7) == 0)

    print("")
    if STATS[1] == 0
        print("_kat_prism_test: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_test: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
