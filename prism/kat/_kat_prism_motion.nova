// KAT for prism/style/prism_motion.nova -- animation curves, reduced motion by default (#70 #102).
//
// The properties this exists for:
//   1. ★ REDUCED MOTION IS THE DEFAULT. Every system that made accessible motion an opt-in
//      shipped animations that trigger vestibular symptoms for the people who needed the setting,
//      because the developer who never enabled it never saw the problem. Asserted directly on a
//      freshly constructed value.
//   2. ★ REDUCED COLLAPSES DURATION BUT STILL COMPLETES. A "skip animations" flag that never
//      fires completion leaves a UI stuck mid-transition; here duration is 0 and progress still
//      ramps 0..1000, so code that waits for the end keeps working.
//   3. ★ EVERY CURVE IS EXACT AT BOTH ENDPOINTS. A curve that lands on 999 leaves a control a
//      pixel short of its resting position, forever.

import prism_motion

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_motion ==")
    let reduced = prism_motion.prism_mo_new()
    let full = prism_motion.prism_mo_with_motion()

    print("1. ★ the DEFAULT is reduced motion")
    check("a fresh PrismMotion is REDUCED", prism_motion.prism_mo_reduced(reduced))
    check("motion must be asked for explicitly", not prism_motion.prism_mo_reduced(full))

    print("2. ★ reduced collapses duration but still COMPLETES")
    check("reduced duration is 0", unwrap(prism_motion.prism_mo_duration(reduced, 300)) == 0)
    check("full duration is honoured", unwrap(prism_motion.prism_mo_duration(full, 300)) == 300)
    check("zero duration is legal", unwrap(prism_motion.prism_mo_duration(full, 0)) == 0)
    check("negative duration rejected", is_err(prism_motion.prism_mo_duration(full, -1)))
    check("non-int duration rejected", is_err(prism_motion.prism_mo_duration(full, "300")))
    // The ramp still exists under reduced motion -- it is linear, not frozen -- so interpolation
    // code needs no special case and completion still fires.
    check("reduced progress still ramps (500 -> 500)", unwrap(prism_motion.prism_mo_ease(reduced, prism_motion.prism_mo_curve_in(), 500)) == 500)
    check("reduced still reaches 1000", unwrap(prism_motion.prism_mo_ease(reduced, prism_motion.prism_mo_curve_spring(), 1000)) == 1000)
    check("reduced makes every curve linear", unwrap(prism_motion.prism_mo_ease(reduced, prism_motion.prism_mo_curve_in_out(), 250)) == 250)

    print("3. ★ every curve is EXACT at both endpoints")
    let curves = prism_motion.prism_mo_curve_all()
    check("5 curves", len(curves) == 5)
    let at0 = curves.map(fn(c) unwrap(prism_motion.prism_mo_ease(full, c, 0)))
    let at1000 = curves.map(fn(c) unwrap(prism_motion.prism_mo_ease(full, c, 1000)))
    check("every curve starts at exactly 0", not contains(at0, 1) and join(at0.map(fn(v) "{v}"), ",") == "0,0,0,0,0")
    check("every curve ends at exactly 1000", join(at1000.map(fn(v) "{v}"), ",") == "1000,1000,1000,1000,1000")

    print("4. curve shapes are actually different")
    check("linear is the identity", unwrap(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_linear(), 300)) == 300)
    // ease-in starts slow: at 30% progress it should be well under 30% of the way.
    let ein = unwrap(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_in(), 300))
    check("ease-in starts SLOW (300 -> {ein}, under 300)", ein < 300)
    // ease-out starts fast.
    let eout = unwrap(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_out(), 300))
    check("ease-out starts FAST ({eout} over 300)", eout > 300)
    check("in and out are mirror images at 300/700", ein + unwrap(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_out(), 700)) == 1000)
    // in-out meets exactly at the midpoint.
    check("ease-in-out passes through 500 at 500", unwrap(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_in_out(), 500)) == 500)
    check("ease-in-out is symmetric about the middle", unwrap(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_in_out(), 250)) + unwrap(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_in_out(), 750)) == 1000)

    print("5. ★ spring OVERSHOOTS once and lands exactly")
    let peak = unwrap(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_spring(), 850))
    check("spring exceeds 1000 mid-flight ({peak})", peak > 1000)
    check("spring lands EXACTLY on 1000", unwrap(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_spring(), 1000)) == 1000)
    check("spring starts at 0", unwrap(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_spring(), 0)) == 0)
    // ...and a spring under reduced motion must NOT overshoot -- overshoot is exactly the motion
    // a vestibular-sensitive user needs suppressed.
    check("reduced motion suppresses the overshoot entirely", unwrap(prism_motion.prism_mo_ease(reduced, prism_motion.prism_mo_curve_spring(), 850)) == 850)

    print("6. validation and names")
    check("progress below 0 rejected", is_err(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_linear(), -1)))
    check("progress above 1000 rejected", is_err(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_linear(), 1001)))
    check("non-int progress rejected", is_err(prism_motion.prism_mo_ease(full, prism_motion.prism_mo_curve_linear(), "500")))
    check("curve names", join(curves.map(fn(c) prism_motion.prism_mo_curve_name(c)), ",") == "linear,ease-in,ease-out,ease-in-out,spring")

    print("")
    if STATS[1] == 0
        print("_kat_prism_motion: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_motion: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
