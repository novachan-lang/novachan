// KAT for prism/intl/prism_number.nova -- locale-aware number/percent/currency formatting.
//
// What this proves:
//   1. INDIAN GROUPING (2;3) is correct: 12345678 -> 1,23,45,678. This is the case a naive
//      "every three digits" implementation gets wrong, and the error is invisible to anyone who
//      only tests en-US -- which is why it is asserted first.
//   2. Money is exact because it is INTEGER MINOR UNITS. A fraction of 5 at scale 2 renders
//      ".05", not ".5" -- the zero-padding bug that turns $1.05 into $1.5.
//   3. Negative values keep the sign OUTSIDE the grouping, and rounding never enters: there is
//      no float anywhere in the module.

import prism_number

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_number ==")
    let us = prism_number.prism_num_en_us()
    let de = prism_number.prism_num_de_de()
    let inr = prism_number.prism_num_en_in()

    print("1. grouping, including the case that breaks naive implementations")
    check("en-US 1234567 -> 1,234,567", prism_number.prism_num_int(us, 1234567) == "1,234,567")
    check("en-US 100 is ungrouped", prism_number.prism_num_int(us, 100) == "100")
    check("en-US 1000 -> 1,000", prism_number.prism_num_int(us, 1000) == "1,000")
    check("en-US 0 -> 0", prism_number.prism_num_int(us, 0) == "0")
    check("de-DE uses . as the group separator", prism_number.prism_num_int(de, 1234567) == "1.234.567")
    // ★ Indian grouping: last three, then twos.
    check("en-IN 12345678 -> 1,23,45,678", prism_number.prism_num_int(inr, 12345678) == "1,23,45,678")
    check("en-IN 1234 -> 1,234", prism_number.prism_num_int(inr, 1234) == "1,234")
    check("en-IN 123 is ungrouped", prism_number.prism_num_int(inr, 123) == "123")
    check("en-IN 12345 -> 12,345", prism_number.prism_num_int(inr, 12345) == "12,345")

    print("2. negatives keep the sign outside the grouping")
    check("-1234567 -> -1,234,567", prism_number.prism_num_int(us, -1234567) == "-1,234,567")
    check("-100 -> -100", prism_number.prism_num_int(us, -100) == "-100")
    check("en-IN -12345678 groups Indian-style", prism_number.prism_num_int(inr, -12345678) == "-1,23,45,678")

    print("3. ★ fixed-point from INTEGER minor units -- no float anywhere")
    check("123456 @2 -> 1,234.56", unwrap(prism_number.prism_num_fixed(us, 123456, 2)) == "1,234.56")
    // THE zero-padding case: 5 minor units at scale 2 is 0.05, not 0.5.
    check("5 @2 -> 0.05 (NOT 0.5)", unwrap(prism_number.prism_num_fixed(us, 5, 2)) == "0.05")
    check("50 @2 -> 0.50", unwrap(prism_number.prism_num_fixed(us, 50, 2)) == "0.50")
    check("100 @2 -> 1.00", unwrap(prism_number.prism_num_fixed(us, 100, 2)) == "1.00")
    check("scale 0 has no decimal point", unwrap(prism_number.prism_num_fixed(us, 1234, 0)) == "1,234")
    check("scale 3 pads to three places", unwrap(prism_number.prism_num_fixed(us, 7, 3)) == "0.007")
    check("de-DE uses , as the decimal separator", unwrap(prism_number.prism_num_fixed(de, 123456, 2)) == "1.234,56")
    check("negative fixed keeps the sign", unwrap(prism_number.prism_num_fixed(us, -123456, 2)) == "-1,234.56")
    check("scale > 9 rejected", is_err(prism_number.prism_num_fixed(us, 1, 10)))
    check("negative scale rejected", is_err(prism_number.prism_num_fixed(us, 1, -1)))
    check("non-int minor rejected", is_err(prism_number.prism_num_fixed(us, "1", 2)))

    print("4. percent and money")
    check("percent appends %", unwrap(prism_number.prism_num_percent(us, 1250, 2)) == "12.50%")
    check("money symbol-first", unwrap(prism_number.prism_num_money(us, "$", 123456, 2, true)) == "$1,234.56")
    check("money symbol-last with a space", unwrap(prism_number.prism_num_money(de, "€", 123456, 2, false)) == "1.234,56 €")
    check("empty symbol rejected", is_err(prism_number.prism_num_money(us, "", 100, 2, true)))
    check("non-string symbol rejected", is_err(prism_number.prism_num_money(us, 7, 100, 2, true)))
    // A rupee amount, Indian grouping + symbol first -- the combination that exercises both.
    check("en-IN money groups Indian-style", unwrap(prism_number.prism_num_money(inr, "₹", 1234567890, 2, true)) == "₹1,23,45,678.90")

    print("5. locale construction is validated")
    check("group size 0 rejected (it would group forever)", is_err(prism_number.prism_num_locale(",", ".", 0, 3)))
    check("identical separators rejected", is_err(prism_number.prism_num_locale(",", ",", 3, 3)))
    check("non-string separator rejected", is_err(prism_number.prism_num_locale(7, ".", 3, 3)))
    check("non-int size rejected", is_err(prism_number.prism_num_locale(",", ".", "3", 3)))
    let custom = unwrap(prism_number.prism_num_locale("'", ".", 3, 3))
    check("a custom separator works", prism_number.prism_num_int(custom, 1234567) == "1'234'567")
    check("accessors report the locale back", prism_number.prism_num_group_sep(inr) == "," and prism_number.prism_num_group_size(inr) == 2 and prism_number.prism_num_lead_size(inr) == 3)

    print("")
    if STATS[1] == 0
        print("_kat_prism_number: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_number: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
