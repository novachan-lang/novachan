// KAT for prism/ui/prism_ui_color_pick.nova (PRISM_ROADMAP.md milestone MB.18, the `ui/`
// composition layer's color-selection components: swatch, palette, picker, gradient, display).
//
// Structural expectations below follow prism_node.nova's own counting rule, restated here because
// every assertion depends on it: a leaf has depth=1/count=1; a branch's depth = max(child
// depths) + 1, count = 1 + sum(child counts) (same convention _kat_prism_ui_stat.nova /
// _kat_prism_ui_tree.nova already document for their own structural assertions).
//
// Proves, against concrete expected values:
//   1. Display format: 3 ctors round-trip through the exhaustive name match.
//   2. Swatch: exact stack(d=2,c=3) with the cp_hex attr set; rejects empty hex, empty name, a hex
//      not starting with "#".
//   3. Palette: exact stack(d=4,c=9) wrapping a title label + a flow of the 2 supplied swatches
//      (each swatch's own cp_hex attr survives untouched); rejects empty title, empty swatch list,
//      a non-PrismNode element (named by index and type).
//   4. Picker: exact stack(d=4,c=9); the option matching cp_selected carries cp_selected="true",
//      every other option has no such attr; cp_selected=none() and a cp_selected naming no option
//      both select nothing (not an error); rejects empty label, empty options, a non-string
//      option, an empty option, a non-"#"-prefixed option, a duplicate hex.
//   5. Gradient: exact 3-step black->white gradient including the exact truncated midpoint
//      #7f7f7f; a 2-step gradient recovers BOTH endpoints exactly, including across a case
//      difference (uppercase cp_from, lowercase cp_to, same color) -- the parse-then-format
//      round-trip proof; rejects empty label, an invalid cp_from, an invalid cp_to, cp_steps < 2.
//   6. Display: CpHex shows the hex verbatim; CpRgb matches a hand-computed rgb() triple; CpHsl
//      matches HAND-COMPUTED hsl() values for 5 colors (3 pure primaries, 1 achromatic gray, 1
//      general color cross-checked against the textbook float HSL formula by hand); rejects a hex
//      missing "#", a hex of the wrong length, and a hex with an invalid digit.
//   7. Rejection tally: at least 8 distinct rejections proven above (19, counted explicitly).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_color_pick` resolve.
//   ./gen3_test.exe _kat_prism_ui_color_pick.nova
//   clang -O2 -o _kat_prism_ui_color_pick.exe _kat_prism_ui_color_pick.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_color_pick.exe

import prism_node
import prism_ui_color_pick

fn _fail(msg: string)
    print("FAIL " + msg)
    exit(1)

fn main()
    // ── 1. Display format: 3 ctors, exhaustive name match ───────────────────────────────────
    assert_eq(prism_ui_color_pick.prism_cp_format_name(prism_ui_color_pick.prism_cp_hex()), "hex")
    assert_eq(prism_ui_color_pick.prism_cp_format_name(prism_ui_color_pick.prism_cp_rgb()), "rgb")
    assert_eq(prism_ui_color_pick.prism_cp_format_name(prism_ui_color_pick.prism_cp_hsl()), "hsl")
    print("1. PrismCpFormat: 3 ctors round-trip through the exhaustive name match (hex/rgb/hsl): OK")

    // ── 2. Swatch: exact structure + cp_hex attr; 3 rejections ──────────────────────────────
    let sw_red_r = prism_ui_color_pick.prism_cp_swatch("#ff0000", "Red")
    if is_err(sw_red_r)
        _fail("prism_cp_swatch(#ff0000, Red): " + unwrap_err(sw_red_r))
    let sw_red = unwrap(sw_red_r)
    assert_eq(prism_node.prism_node_kind_str(sw_red), "stack")
    assert_eq(prism_node.prism_node_depth(sw_red), 2)
    assert_eq(prism_node.prism_node_count(sw_red), 3)
    assert_eq(prism_node.prism_node_attr_str(sw_red, "cp_hex", ""), "#ff0000")
    let sw_red_kids = prism_node.prism_node_children(sw_red)
    assert_eq(prism_node.prism_node_kind_str(sw_red_kids[0]), "label")
    assert_eq(prism_node.prism_node_attr_str(sw_red_kids[0], "text", ""), "#ff0000")
    assert_eq(prism_node.prism_node_attr_str(sw_red_kids[1], "text", ""), "Red")

    let sw_green = unwrap(prism_ui_color_pick.prism_cp_swatch("#00ff00", "Green"))
    assert_eq(prism_node.prism_node_attr_str(sw_green, "cp_hex", ""), "#00ff00")

    let sw_empty_hex_r = prism_ui_color_pick.prism_cp_swatch("", "Red")
    if is_ok(sw_empty_hex_r)
        _fail("prism_cp_swatch should reject an empty cp_hex, but construction succeeded")
    let sw_empty_name_r = prism_ui_color_pick.prism_cp_swatch("#ff0000", "")
    if is_ok(sw_empty_name_r)
        _fail("prism_cp_swatch should reject an empty cp_name, but construction succeeded")
    let sw_bad_hex_r = prism_ui_color_pick.prism_cp_swatch("ff0000", "Red")
    if is_ok(sw_bad_hex_r)
        _fail("prism_cp_swatch should reject a cp_hex not starting with '#', but construction succeeded")
    print("2. swatch: exact stack(d=2,c=3) with cp_hex attr, hex/name text round-trip, rejects empty hex + empty name + hex without '#': OK -- " + unwrap_err(sw_empty_hex_r) + " / " + unwrap_err(sw_empty_name_r) + " / " + unwrap_err(sw_bad_hex_r))

    // ── 3. Palette: exact structure over 2 swatches; 3 rejections ───────────────────────────
    let palette_r = prism_ui_color_pick.prism_cp_palette("Brand Colors", [sw_red, sw_green])
    if is_err(palette_r)
        _fail("prism_cp_palette: " + unwrap_err(palette_r))
    let palette = unwrap(palette_r)
    assert_eq(prism_node.prism_node_kind_str(palette), "stack")
    assert_eq(prism_node.prism_node_depth(palette), 4)
    assert_eq(prism_node.prism_node_count(palette), 9)
    let palette_kids = prism_node.prism_node_children(palette)
    assert_eq(prism_node.prism_node_kind_str(palette_kids[0]), "label")
    assert_eq(prism_node.prism_node_attr_str(palette_kids[0], "text", ""), "Brand Colors")
    assert_eq(prism_node.prism_node_kind_str(palette_kids[1]), "flow")
    assert_eq(prism_node.prism_node_child_count(palette_kids[1]), 2)
    let palette_swatches = prism_node.prism_node_children(palette_kids[1])
    assert_eq(prism_node.prism_node_attr_str(palette_swatches[0], "cp_hex", ""), "#ff0000")
    assert_eq(prism_node.prism_node_attr_str(palette_swatches[1], "cp_hex", ""), "#00ff00")

    let palette_empty_title_r = prism_ui_color_pick.prism_cp_palette("", [sw_red])
    if is_ok(palette_empty_title_r)
        _fail("prism_cp_palette should reject an empty title, but construction succeeded")
    let palette_empty_swatches_r = prism_ui_color_pick.prism_cp_palette("Title", [])
    if is_ok(palette_empty_swatches_r)
        _fail("prism_cp_palette should reject an empty swatches list, but construction succeeded")
    let palette_bad_elem_r = prism_ui_color_pick.prism_cp_palette("Title", [sw_red, "not a node"])
    if is_ok(palette_bad_elem_r)
        _fail("prism_cp_palette should reject a non-PrismNode element, but construction succeeded")
    print("3. palette: exact stack(d=4,c=9) = title + flow(2 swatches), each swatch's cp_hex attr intact, rejects empty title + empty list + non-PrismNode element: OK -- " + unwrap_err(palette_empty_title_r) + " / " + unwrap_err(palette_empty_swatches_r) + " / " + unwrap_err(palette_bad_elem_r))

    // ── 4. Picker: exact structure, cp_selected on exactly the matching option, 6 rejections ──
    let opts = ["#ff0000", "#00ff00", "#0000ff"]
    let pick_r = prism_ui_color_pick.prism_cp_picker("Pick a color", opts, some("#00ff00"))
    if is_err(pick_r)
        _fail("prism_cp_picker: " + unwrap_err(pick_r))
    let pick = unwrap(pick_r)
    assert_eq(prism_node.prism_node_kind_str(pick), "stack")
    assert_eq(prism_node.prism_node_depth(pick), 4)
    assert_eq(prism_node.prism_node_count(pick), 9)
    let pick_kids = prism_node.prism_node_children(pick)
    assert_eq(prism_node.prism_node_attr_str(pick_kids[0], "text", ""), "Pick a color")
    assert_eq(prism_node.prism_node_kind_str(pick_kids[1]), "flow")
    let pick_options = prism_node.prism_node_children(pick_kids[1])
    assert_eq(prism_node.prism_node_child_count(pick_kids[1]), 3)
    assert_eq(prism_node.prism_node_kind_str(pick_options[0]), "band")
    assert_eq(prism_node.prism_node_attr_str(pick_options[0], "cp_hex", ""), "#ff0000")
    assert_eq(prism_node.prism_node_attr_str(pick_options[0], "cp_selected", ""), "")
    assert_eq(prism_node.prism_node_attr_str(pick_options[1], "cp_hex", ""), "#00ff00")
    assert_eq(prism_node.prism_node_attr_str(pick_options[1], "cp_selected", ""), "true")
    assert_eq(prism_node.prism_node_attr_str(pick_options[2], "cp_hex", ""), "#0000ff")
    assert_eq(prism_node.prism_node_attr_str(pick_options[2], "cp_selected", ""), "")
    let pick_opt1_kids = prism_node.prism_node_children(pick_options[1])
    assert_eq(prism_node.prism_node_attr_str(pick_opt1_kids[0], "text", ""), "#00ff00")

    // No selection at all -> nothing carries cp_selected.
    let pick_none = unwrap(prism_ui_color_pick.prism_cp_picker("Pick a color", opts, none()))
    let pick_none_opts = prism_node.prism_node_children(prism_node.prism_node_children(pick_none)[1])
    for o in pick_none_opts
        assert_eq(prism_node.prism_node_attr_str(o, "cp_selected", ""), "")

    // A cp_selected naming no real option is NOT an error -- it just selects nothing.
    let pick_nomatch_r = prism_ui_color_pick.prism_cp_picker("Pick a color", opts, some("#ffffff"))
    if is_err(pick_nomatch_r)
        _fail("prism_cp_picker with a non-matching cp_selected should still succeed: " + unwrap_err(pick_nomatch_r))
    let pick_nomatch_opts = prism_node.prism_node_children(prism_node.prism_node_children(unwrap(pick_nomatch_r))[1])
    for o in pick_nomatch_opts
        assert_eq(prism_node.prism_node_attr_str(o, "cp_selected", ""), "")

    let pick_empty_label_r = prism_ui_color_pick.prism_cp_picker("", opts, none())
    if is_ok(pick_empty_label_r)
        _fail("prism_cp_picker should reject an empty cp_label, but construction succeeded")
    let pick_empty_opts_r = prism_ui_color_pick.prism_cp_picker("Label", [], none())
    if is_ok(pick_empty_opts_r)
        _fail("prism_cp_picker should reject an empty cp_options list, but construction succeeded")
    let pick_nonstring_r = prism_ui_color_pick.prism_cp_picker("Label", ["#ff0000", 123], none())
    if is_ok(pick_nonstring_r)
        _fail("prism_cp_picker should reject a non-string option, but construction succeeded")
    let pick_blank_opt_r = prism_ui_color_pick.prism_cp_picker("Label", ["#ff0000", ""], none())
    if is_ok(pick_blank_opt_r)
        _fail("prism_cp_picker should reject an empty option string, but construction succeeded")
    let pick_bad_hex_r = prism_ui_color_pick.prism_cp_picker("Label", ["#ff0000", "00ff00"], none())
    if is_ok(pick_bad_hex_r)
        _fail("prism_cp_picker should reject an option not starting with '#', but construction succeeded")
    let pick_dup_r = prism_ui_color_pick.prism_cp_picker("Label", ["#ff0000", "#ff0000"], none())
    if is_ok(pick_dup_r)
        _fail("prism_cp_picker should reject a duplicate hex, but construction succeeded")
    print("4. picker: exact stack(d=4,c=9), cp_selected='true' on exactly the matching option (none/no-match both select nothing without erroring), rejects empty label + empty options + non-string + empty + non-'#' option + duplicate hex (6 cases): OK")

    // ── 5. Gradient: exact black->white 3-step, exact 2-step endpoint round-trip, 4 rejections ─
    let grad_r = prism_ui_color_pick.prism_cp_gradient("Shade", "#000000", "#ffffff", 3)
    if is_err(grad_r)
        _fail("prism_cp_gradient(black->white, 3): " + unwrap_err(grad_r))
    let grad = unwrap(grad_r)
    assert_eq(prism_node.prism_node_kind_str(grad), "stack")
    assert_eq(prism_node.prism_node_depth(grad), 3)
    assert_eq(prism_node.prism_node_count(grad), 6)
    let grad_kids = prism_node.prism_node_children(grad)
    assert_eq(prism_node.prism_node_attr_str(grad_kids[0], "text", ""), "Shade")
    assert_eq(prism_node.prism_node_kind_str(grad_kids[1]), "band")
    let grad_steps = prism_node.prism_node_children(grad_kids[1])
    assert_eq(len(grad_steps), 3)
    assert_eq(prism_node.prism_node_attr_str(grad_steps[0], "text", ""), "#000000")
    assert_eq(prism_node.prism_node_attr_str(grad_steps[1], "text", ""), "#7f7f7f")
    assert_eq(prism_node.prism_node_attr_str(grad_steps[2], "text", ""), "#ffffff")

    // 2-step endpoint round-trip, deliberately crossing a case difference (cp_from upper, cp_to
    // lower, the SAME color): both steps must format to the identical lowercase hex -- proving
    // case-insensitive parsing AND that parse-then-format recovers the original value exactly.
    let grad_rt = unwrap(prism_ui_color_pick.prism_cp_gradient("RT", "#1A2B3C", "#1a2b3c", 2))
    let grad_rt_steps = prism_node.prism_node_children(prism_node.prism_node_children(grad_rt)[1])
    assert_eq(prism_node.prism_node_attr_str(grad_rt_steps[0], "text", ""), "#1a2b3c")
    assert_eq(prism_node.prism_node_attr_str(grad_rt_steps[1], "text", ""), "#1a2b3c")

    let grad_empty_label_r = prism_ui_color_pick.prism_cp_gradient("", "#000000", "#ffffff", 3)
    if is_ok(grad_empty_label_r)
        _fail("prism_cp_gradient should reject an empty cp_label, but construction succeeded")
    let grad_bad_from_r = prism_ui_color_pick.prism_cp_gradient("G", "000000", "#ffffff", 3)
    if is_ok(grad_bad_from_r)
        _fail("prism_cp_gradient should reject a cp_from missing '#', but construction succeeded")
    let grad_bad_to_r = prism_ui_color_pick.prism_cp_gradient("G", "#000000", "#fff", 3)
    if is_ok(grad_bad_to_r)
        _fail("prism_cp_gradient should reject a wrong-length cp_to, but construction succeeded")
    let grad_bad_steps_r = prism_ui_color_pick.prism_cp_gradient("G", "#000000", "#ffffff", 1)
    if is_ok(grad_bad_steps_r)
        _fail("prism_cp_gradient should reject cp_steps < 2, but construction succeeded")
    print("5. gradient: exact 3-step black->white incl. truncated midpoint #7f7f7f, exact 2-step endpoint round-trip across a case difference, rejects empty label + bad cp_from + bad cp_to + steps<2: OK -- " + unwrap_err(grad_empty_label_r) + " / " + unwrap_err(grad_bad_from_r) + " / " + unwrap_err(grad_bad_to_r) + " / " + unwrap_err(grad_bad_steps_r))

    // ── 6. Display: CpHex verbatim, CpRgb hand-computed, CpHsl hand-computed x5, 3 rejections ──
    let disp_hex = unwrap(prism_ui_color_pick.prism_cp_display("#1a2b3c", prism_ui_color_pick.prism_cp_hex()))
    assert_eq(prism_node.prism_node_kind_str(disp_hex), "band")
    assert_eq(prism_node.prism_node_depth(disp_hex), 2)
    assert_eq(prism_node.prism_node_count(disp_hex), 3)
    let disp_hex_kids = prism_node.prism_node_children(disp_hex)
    assert_eq(prism_node.prism_node_attr_str(disp_hex_kids[0], "text", ""), "#1a2b3c")
    assert_eq(prism_node.prism_node_attr_str(disp_hex_kids[1], "text", ""), "#1a2b3c")

    // rgb(26, 43, 60): 0x1a=26, 0x2b=43, 0x3c=60 -- hand-computed from the hex digits directly.
    let disp_rgb = unwrap(prism_ui_color_pick.prism_cp_display("#1a2b3c", prism_ui_color_pick.prism_cp_rgb()))
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(disp_rgb)[1], "text", ""), "rgb(26, 43, 60)")
    let disp_rgb_red = unwrap(prism_ui_color_pick.prism_cp_display("#ff0000", prism_ui_color_pick.prism_cp_rgb()))
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(disp_rgb_red)[1], "text", ""), "rgb(255, 0, 0)")

    // HSL, hand-computed:
    //   pure red   (255,0,0)   -> max=255 min=0 diff=255 sum=255 -> L=50%, S=100%, H=0
    //   pure green (0,255,0)   -> same shape, max is G -> H=120
    //   pure blue  (0,0,255)   -> same shape, max is B -> H=240
    //   gray       (128,128,128) -> diff=0 -> H=0, S=0%, L = 256*100/510 = 50 (int-trunc)
    //   #1a2b3c = (26,43,60): max=60(b) min=26(r) diff=34 sum=86
    //     L = 86*100/510 = 16 (int-trunc; float check: (60+26)/2/255 = 16.86% -> floor 16, agrees)
    //     S = 34*100/86  = 39 (sum<=255 branch; float check: 0.1333/0.3373=39.53% -> floor 39, agrees)
    //     H = 240 + ((26-43)*60)/34 = 240 + (-1020)/34 = 240 - 30 = 210 (float check: 60*3.5=210, exact)
    let hsl_red = unwrap(prism_ui_color_pick.prism_cp_display("#ff0000", prism_ui_color_pick.prism_cp_hsl()))
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(hsl_red)[1], "text", ""), "hsl(0, 100%, 50%)")
    let hsl_green = unwrap(prism_ui_color_pick.prism_cp_display("#00ff00", prism_ui_color_pick.prism_cp_hsl()))
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(hsl_green)[1], "text", ""), "hsl(120, 100%, 50%)")
    let hsl_blue = unwrap(prism_ui_color_pick.prism_cp_display("#0000ff", prism_ui_color_pick.prism_cp_hsl()))
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(hsl_blue)[1], "text", ""), "hsl(240, 100%, 50%)")
    let hsl_gray = unwrap(prism_ui_color_pick.prism_cp_display("#808080", prism_ui_color_pick.prism_cp_hsl()))
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(hsl_gray)[1], "text", ""), "hsl(0, 0%, 50%)")
    let hsl_general = unwrap(prism_ui_color_pick.prism_cp_display("#1a2b3c", prism_ui_color_pick.prism_cp_hsl()))
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(hsl_general)[1], "text", ""), "hsl(210, 39%, 16%)")

    let disp_no_hash_r = prism_ui_color_pick.prism_cp_display("1a2b3c", prism_ui_color_pick.prism_cp_hex())
    if is_ok(disp_no_hash_r)
        _fail("prism_cp_display should reject a hex missing '#', but construction succeeded")
    let disp_wrong_len_r = prism_ui_color_pick.prism_cp_display("#1a2b3", prism_ui_color_pick.prism_cp_hex())
    if is_ok(disp_wrong_len_r)
        _fail("prism_cp_display should reject a wrong-length hex, but construction succeeded")
    let disp_bad_digit_r = prism_ui_color_pick.prism_cp_display("#1a2b3g", prism_ui_color_pick.prism_cp_hex())
    if is_ok(disp_bad_digit_r)
        _fail("prism_cp_display should reject a hex with an invalid digit ('g'), but construction succeeded")
    print("6. display: CpHex verbatim, CpRgb hand-computed rgb(26,43,60)/rgb(255,0,0), CpHsl hand-computed for red/green/blue/gray/#1a2b3c (cross-checked against the textbook float formula by hand), rejects missing '#' + wrong length + invalid digit: OK -- " + unwrap_err(disp_no_hash_r) + " / " + unwrap_err(disp_wrong_len_r) + " / " + unwrap_err(disp_bad_digit_r))

    // ── 7. Rejection tally: at least 8 distinct rejections proven above (19, counted here) ────
    let rejection_count = 19
    if rejection_count < 8
        _fail("expected at least 8 rejection cases, counted " + str(rejection_count))
    print("7. rejection tally: 19 distinct rejections proven (swatch hex/name/format=3, palette title/list/element=3, picker label/options/nonstring/empty/format/duplicate=6, gradient label/from/to/steps=4, display hash/length/digit=3) -- >= 8 required: OK")

    print("KAT prism_ui_color_pick PASSED: format ctors exhaustive, swatch/palette/picker/gradient/display exact structure and text, hand-computed RGB/HSL cross-checked against the float formula, case-insensitive hex round-trip, 19 rejections at exact boundaries")
