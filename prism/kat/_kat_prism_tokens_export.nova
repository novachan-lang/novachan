// KAT for prism/dev/prism_tokens.nova -- design-token EXPORT (#108).
//
// ★ THE PROPERTY THIS EXISTS FOR: the exporter must not be a second source of truth. Every value
// is asserted to EQUAL what style/prism_tokens reports through its own accessor, so a drift
// between "what the design system says" and "what the export file says" is impossible rather
// than merely unlikely. That drift is the classic way a design system rots: the export says 16px,
// the app renders 14px, and nobody notices because the numbers live in different files.

import prism_tokens
import prism_tokens_dev

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_tokens_export ==")

    print("1. every scale is exported, and the count is total")
    let pairs = prism_tokens_dev.prism_tok_pairs()
    // 7 space + 5 radius + 5 font-size + 5 line-height = 22
    check("22 tokens exported (got {len(pairs)})", len(pairs) == 22)
    check("count() agrees with pairs()", prism_tokens_dev.prism_tok_count() == len(pairs))
    let groups = pairs.map(fn(p) prism_tokens_dev.prism_tok_group(p))
    check("space group present", contains(groups, "space"))
    check("radius group present", contains(groups, "radius"))
    check("font-size group present", contains(groups, "font-size"))
    check("line-height group present", contains(groups, "line-height"))

    print("2. ★ exported values EQUAL the style module's own accessors (no second source of truth)")
    let md = unwrap(prism_tokens_dev.prism_tok_find("prism.space.md"))
    check("space.md matches prism_space_px exactly", prism_tokens_dev.prism_tok_value(md) == prism_tokens.prism_space_px(prism_tokens.prism_space_md()))
    let pill = unwrap(prism_tokens_dev.prism_tok_find("prism.radius.pill"))
    check("radius.pill matches prism_radius_px exactly", prism_tokens_dev.prism_tok_value(pill) == prism_tokens.prism_radius_px(prism_tokens.prism_radius_pill()))
    let body = unwrap(prism_tokens_dev.prism_tok_find("prism.font-size.body"))
    check("font-size.body matches prism_type_size_px exactly", prism_tokens_dev.prism_tok_value(body) == prism_tokens.prism_type_size_px(prism_tokens.prism_type_body()))
    let lead = unwrap(prism_tokens_dev.prism_tok_find("prism.line-height.body"))
    check("line-height.body matches prism_type_leading_px exactly", prism_tokens_dev.prism_tok_value(lead) == prism_tokens.prism_type_leading_px(prism_tokens.prism_type_body()))
    // WCAG 1.4.8: leading is 3/2 of size. Asserted THROUGH the export, so the export cannot
    // quietly break the ratio the style layer guarantees.
    check("leading is 1.5x size, preserved through the export", prism_tokens_dev.prism_tok_value(lead) * 2 == prism_tokens_dev.prism_tok_value(body) * 3)

    print("3. names are prefixed for a global namespace")
    check("css name is --prism-space-md", prism_tokens_dev.prism_tok_css_name(md) == "--prism-space-md")
    check("json name is prism.space.md", prism_tokens_dev.prism_tok_json_name(md) == "prism.space.md")
    // Unprefixed names would collide with the host page's own custom properties.
    let cssnames = pairs.map(fn(p) prism_tokens_dev.prism_tok_css_name(p))
    let unprefixed = cssnames.filter(fn(n) not starts_with(n, "--prism-"))
    check("every css name is --prism- prefixed", len(unprefixed) == 0)
    // Every exported name must be unique, or a consumer silently loses one.
    let jnames = pairs.map(fn(p) prism_tokens_dev.prism_tok_json_name(p))
    let uniq = []
    for n in jnames
        if not contains(uniq, n)
            push(uniq, n)
    check("all 22 names are UNIQUE (a duplicate silently loses a token)", len(uniq) == len(jnames))

    print("4. export formats")
    let css = prism_tokens_dev.prism_tok_export_css()
    check("css is a :root block", starts_with(css, ":root \{") and ends_with(css, "}"))
    check("css carries a token line with unit", contains(css, "--prism-space-md:"))
    check("css values carry px", contains(css, "px;"))
    let js = prism_tokens_dev.prism_tok_export_json()
    check("json is an object", starts_with(js, "\{") and ends_with(js, "}"))
    check("json carries a dotted name", contains(js, "\"prism.space.md\":"))
    check("json values are numeric, not strings", not contains(js, "\"prism.space.md\":\""))

    print("5. lookup")
    check("unknown token name is an err, not a zero", is_err(prism_tokens_dev.prism_tok_find("prism.space.nope")))
    check("non-string name rejected", is_err(prism_tokens_dev.prism_tok_find(7)))
    check("units are reported", prism_tokens_dev.prism_tok_unit(md) == "px")

    print("")
    if STATS[1] == 0
        print("_kat_prism_tokens_export: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_tokens_export: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
