// KAT for prism/app/prism_app_docs.nova (milestone MB.6, the self-documenting component reference
// for ui/, extending prism_dev/prism_catalog.nova's (MA.7) discipline from the 22 closed primitives
// to the 41 composed ui/ components across the 10 component-bearing modules).
//
// Proves:
//   1. The expected-component list's own length/distinctness/non-emptiness, asserted BEFORE any
//      loop over it -- a loop over a wrongly-emptied list would pass vacuously (the MA.4a
//      compiler-bug class: a green loop over nothing proves nothing).
//   2. prism_docs_entries() has EXACTLY one entry per expected name (count asserted before looping
//      too), every entry's node is a real PrismNode, every blurb/module/name is set and distinct.
//   3. ★ COVERAGE is empty -- MB.6's exit criterion, the same way _kat_prism_catalog.nova proves it
//      for MA.7 -- AND the reverse direction (no doc entry names a component absent from the
//      expected list), which prism_docs_coverage() alone cannot see.
//   4. The page renders through BOTH real backends (HTML + ANSI), is deterministic across repeated
//      renders, is substantial, and every one of the 41 component names appears in the HTML output.
//   5. No <script> tag and no on*="..." event-handler attribute appears anywhere in the HTML.
//   6. The page stays within prism_node's resource bounds (PRISM_MAX_TREE_DEPTH=256,
//      PRISM_MAX_NODE_COUNT=100000) -- the real depth/count are printed, not merely asserted.
//   7. prism_docs_route() (prism/app/prism_forge.nova) is a working Forge handler.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into $NOVA_HOME/lib.
//   ./gen3_test.exe _kat_prism_app_docs.nova
//   clang -O2 -o _kat_prism_app_docs.exe _kat_prism_app_docs.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_app_docs.exe

import prism_node
import prism_app_docs as padocs
import prism_forge as pf

let FAILED = [0]

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn _check_eq_int(label: string, got: int, want: int)
    if got == want
        print("  pass  " + label + " (" + str(got) + ")")
    else
        print("  FAIL  " + label + "  got=" + str(got) + "  want=" + str(want))
        FAILED[0] = FAILED[0] + 1

fn main()
    print("== 1. expected-component list: length/distinctness/non-emptiness, BEFORE any loop ==")
    let expected = padocs.prism_docs_expected_components()
    // Hard count assertion FIRST -- see the header's MA.4a note: a loop over a wrongly-emptied
    // list would otherwise pass vacuously.
    _check_eq_int("expected component count", len(expected), 41)
    let seen_expected = {}
    let dup_expected = 0
    let empty_expected = 0
    for nm in expected
        if len(nm) == 0
            empty_expected += 1
        if nm in seen_expected
            dup_expected += 1
        seen_expected[nm] = true
    _check_eq_int("no empty expected names", empty_expected, 0)
    _check_eq_int("no duplicate expected names", dup_expected, 0)
    _check_eq_int("41 distinct expected names", len(seen_expected), 41)

    print("== 2. entries: exact count (before looping), every node real, every field set ==")
    let entries_r = padocs.prism_docs_entries()
    _check_true("prism_docs_entries() succeeds", is_ok(entries_r))
    let entries = unwrap(entries_r)
    _check_eq_int("one entry per expected component", len(entries), 41)
    let bad_node = 0
    let bad_blurb = 0
    let bad_module = 0
    let bad_name = 0
    let seen_names = {}
    let dup_names = 0
    for e in entries
        if type_name(padocs.prism_docs_entry_node(e)) != "PrismNode"
            bad_node += 1
        if len(padocs.prism_docs_entry_blurb(e)) == 0
            bad_blurb += 1
        if len(padocs.prism_docs_entry_module(e)) == 0
            bad_module += 1
        let nm = padocs.prism_docs_entry_name(e)
        if len(nm) == 0
            bad_name += 1
        if nm in seen_names
            dup_names += 1
        seen_names[nm] = true
    _check_eq_int("every example is a real PrismNode", bad_node, 0)
    _check_eq_int("every entry has a blurb", bad_blurb, 0)
    _check_eq_int("every entry has a module", bad_module, 0)
    _check_eq_int("every entry has a non-empty name", bad_name, 0)
    _check_eq_int("no duplicate entry names", dup_names, 0)
    _check_eq_int("41 distinct entry names", len(seen_names), 41)

    print("== 3. ★ COVERAGE -- MB.6's exit criterion, both directions ==")
    let missing_r = padocs.prism_docs_coverage()
    _check_true("prism_docs_coverage() succeeds", is_ok(missing_r))
    let missing = unwrap(missing_r)
    if len(missing) == 0
        print("  pass  every expected ui/ component has a doc entry")
    else
        print("  FAIL  ui/ components with NO doc entry: " + join(missing, ", "))
        FAILED[0] = FAILED[0] + 1

    // Round-trip the OTHER direction: an entry naming a component absent from the expected list is
    // exactly as much a silent drift as a missing one, just the opposite direction --
    // prism_docs_coverage() alone cannot see this side.
    let expected_set = {}
    for nm in expected
        expected_set[nm] = true
    let unexpected = 0
    for e in entries
        if padocs.prism_docs_entry_name(e) not in expected_set
            unexpected += 1
    _check_eq_int("no doc entry names a component absent from the expected list", unexpected, 0)

    print("== 4. the reference page is itself a Prism tree, within resource bounds ==")
    let tree_r = padocs.prism_docs_tree()
    _check_true("prism_docs_tree() succeeds", is_ok(tree_r))
    let tree = unwrap(tree_r)
    _check_true("root is a stack", prism_node.prism_node_kind_str(tree) == "stack")
    let real_depth = prism_node.prism_node_depth(tree)
    let real_count = prism_node.prism_node_count(tree)
    print("  .. real depth=" + str(real_depth) + "  real count=" + str(real_count))
    _check_true("within PRISM_MAX_TREE_DEPTH (256)", real_depth < 256)
    _check_true("within PRISM_MAX_NODE_COUNT (100000)", real_count < 100000)

    print("== 5. renders through BOTH real backends, all 41 names present, substantial ==")
    let html = unwrap(padocs.prism_docs_html())
    let ansi = unwrap(padocs.prism_docs_ansi())
    _check_true("HTML is a full document", find(html, "<!doctype html>") == 0)
    _check_true("HTML has the title", find(html, "Prism ui/ component reference") >= 0)
    _check_true("HTML is substantial", len(html) > 2000)
    _check_true("ANSI is substantial", len(ansi) > 400)
    _check_true("ANSI carries no HTML tags", find(ansi, "<div") < 0)
    let absent_html = []
    for nm in expected
        if find(html, nm) < 0
            absent_html.push(nm)
    if len(absent_html) == 0
        print("  pass  all 41 component names appear in the HTML reference")
    else
        print("  FAIL  missing from HTML reference: " + join(absent_html, ", "))
        FAILED[0] = FAILED[0] + 1

    print("== 6. deterministic, no <script>, no on*=\"...\" handler anywhere ==")
    _check_true("HTML is byte-identical across renders", unwrap(padocs.prism_docs_html()) == html)
    _check_true("ANSI is byte-identical across renders", unwrap(padocs.prism_docs_ansi()) == ansi)
    _check_true("no <script anywhere in the HTML", find(html, "<script") < 0)
    let has_on_handler = html matches " on[a-zA-Z]+=\""
    _check_true("no on*=\"...\" event-handler attribute anywhere in the HTML", not has_on_handler)

    print("== 7. prism_docs_route() (prism_forge.nova) is a working Forge handler ==")
    let route_h = padocs.prism_docs_route()
    let resp = route_h(0)
    _check_true("200 status line", find(resp, "200") >= 0)
    _check_true("serves the reference page", find(resp, "Prism ui/ component reference") >= 0)
    _check_true("serves a real component name", find(resp, "sparkline") >= 0)

    if FAILED[0] == 0
        print("")
        print("_kat_prism_app_docs: ALL PASS")
    else
        print("")
        print("_kat_prism_app_docs: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
