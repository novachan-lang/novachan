// KAT for prism/style/prism_theme.nova (milestone MB.7 -- the theme layer).
//
// Proves, against concrete expected values:
//   1. The role vocabulary (6 names, fixed order) and the palette preset vocabulary (9 names) are
//      what the module claims -- asserted BEFORE any loop runs, so a wrongly-empty list cannot
//      make a later loop "pass" by iterating zero times (the MA.4a compiler-bug precedent).
//   2. All 9 presets x 2 modes = 18 combinations build a COMPLETE theme (every one of the 6 roles
//      present with a non-empty look) -- built-count and role-check-count asserted AFTER the
//      double loop too, so the loop body's own accounting is trustworthy, not just its outcome.
//   3. Every role resolves for every one of the 18 themes, and the resolved look carries NO
//      lingering `palette.` reference -- asserted by scanning every property's rendered value
//      string, not by spot-checking one property name.
//   4. Resolved values are EXACT: `action_primary.fill`/`danger.ink`/etc. are compared against the
//      real hex the palette module itself computes for that slot (prism_color_to_hex), not merely
//      "looks like a color".
//   5. `prism_theme_with` is later-wins on the touched property, keeps every non-conflicting
//      property, and -- checked explicitly, not inferred -- leaves the ORIGINAL theme's role look
//      completely unchanged, for both a single-property role (`muted`) and a multi-property role
//      (`surface`).
//   6. 10 rejection cases: unknown/empty/wrong-case preset name, unknown/empty/substring/wrong-case
//      role name, across `prism_theme_from`, `prism_theme_look`, `prism_theme_resolved` and
//      `prism_theme_with` -- plus 2 checks that the typed errors actually NAME the legal set.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME = the nova-compiler/ root, NOVA_NO_CACHE=1):
//   ./gen3_test.exe _kat_prism_theme.nova
//   clang -O2 -o _kat_prism_theme.exe _kat_prism_theme.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_theme.exe        (always under Invoke-Timed -TimeoutMs, kill-on-timeout)

import prism_theme
import prism_look
import prism_palette
import prism_color

let FAILED = [0]
let BUILT = [0]
let ROLE_CHECKS = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn _check_rejected(label: string, r)
    if is_err(r)
        print("  pass  reject: " + label)
    else
        print("  FAIL  reject: " + label + " -- was ACCEPTED")
        FAILED[0] = FAILED[0] + 1

// True iff no property on `look`'s rendered value string still carries a `palette.` reference --
// scans every property, not just the ones this KAT happens to know about.
fn _look_has_no_palette_ref(look: PrismLook) -> bool
    let props = prism_look.prism_look_props(look)
    for k in props
        let s = prism_look.prism_value_str(props[k])
        if find(s, "palette.") >= 0
            return false
    true

fn main()
    print("== 0. vocabulary sanity, asserted BEFORE any loop ==")
    let roles = prism_theme.prism_theme_roles()
    _check("role count", str(len(roles)), "6")
    _check("role list, fixed order", join(roles, ","), "surface,field,action_primary,action_quiet,danger,muted")
    let presets = prism_palette.prism_palette_names()
    _check("preset count", str(len(presets)), "9")
    _check("expected theme combinations (9 x 2)", str(len(presets) * 2), "18")

    print("== 1. all 18 palette x mode combinations build a complete theme ==")
    for name in presets
        for dark in [false, true]
            let dark_str = "dark" if dark else "light"
            let tr = prism_theme.prism_theme_from(name, dark)
            if is_err(tr)
                print("  FAIL  prism_theme_from(" + name + ", " + dark_str + ") -- " + unwrap_err(tr))
                FAILED[0] = FAILED[0] + 1
            else
                let theme = unwrap(tr)
                BUILT[0] = BUILT[0] + 1
                _check("theme name = " + name + "/" + dark_str, prism_theme.prism_theme_name(theme), name)
                _check_true("theme dark flag correct for " + name + "/" + dark_str, prism_theme.prism_theme_is_dark(theme) == dark)
                for role in roles
                    let rawr = prism_theme.prism_theme_look(theme, role)
                    if is_err(rawr)
                        print("  FAIL  " + name + "/" + dark_str + "/" + role + " look -- " + unwrap_err(rawr))
                        FAILED[0] = FAILED[0] + 1
                    else
                        let raw = unwrap(rawr)
                        _check_true(name + "/" + dark_str + "/" + role + " has properties", prism_look.prism_look_prop_count(raw) > 0)
                        let resr = prism_theme.prism_theme_resolved(theme, role)
                        if is_err(resr)
                            print("  FAIL  " + name + "/" + dark_str + "/" + role + " resolve -- " + unwrap_err(resr))
                            FAILED[0] = FAILED[0] + 1
                        else
                            let resolved = unwrap(resr)
                            _check_true(name + "/" + dark_str + "/" + role + " resolved has no lingering palette. ref", _look_has_no_palette_ref(resolved))
                            ROLE_CHECKS[0] = ROLE_CHECKS[0] + 1

    print("== 2. loop accounting, asserted AFTER the double loop too ==")
    _check("themes built", str(BUILT[0]), "18")
    _check("role x theme resolve checks completed", str(ROLE_CHECKS[0]), "108")

    print("== 3. default looks are exactly what the design says (classic/light) ==")
    let theme = unwrap(prism_theme.prism_theme_from("classic", false))
    let surface = unwrap(prism_theme.prism_theme_look(theme, "surface"))
    _check("surface fill", prism_look.prism_look_value_str(surface, "fill"), "palette.ground")
    _check("surface edge", prism_look.prism_look_value_str(surface, "edge"), "palette.edge")
    _check("surface ink", prism_look.prism_look_value_str(surface, "ink"), "palette.ink")
    _check("surface round", prism_look.prism_look_value_str(surface, "round"), "8")
    _check("surface inset", prism_look.prism_look_value_str(surface, "inset"), "16")
    let field = unwrap(prism_theme.prism_theme_look(theme, "field"))
    _check("field fill", prism_look.prism_look_value_str(field, "fill"), "palette.ground")
    _check("field round", prism_look.prism_look_value_str(field, "round"), "6")
    _check("field inset", prism_look.prism_look_value_str(field, "inset"), "8")
    let ap = unwrap(prism_theme.prism_theme_look(theme, "action_primary"))
    _check("action_primary fill", prism_look.prism_look_value_str(ap, "fill"), "palette.accent")
    _check("action_primary ink (text-on-accent approximation)", prism_look.prism_look_value_str(ap, "ink"), "palette.ground")
    _check("action_primary cursor", prism_look.prism_look_value_str(ap, "cursor"), "hand")
    let aq = unwrap(prism_theme.prism_theme_look(theme, "action_quiet"))
    _check("action_quiet ink", prism_look.prism_look_value_str(aq, "ink"), "palette.accent")
    _check("action_quiet has no fill (transparent)", prism_look.prism_look_value_str(aq, "fill"), "")
    let danger = unwrap(prism_theme.prism_theme_look(theme, "danger"))
    _check("danger ink -> warn slot (no separate danger slot exists)", prism_look.prism_look_value_str(danger, "ink"), "palette.warn")
    _check("danger edge -> warn slot", prism_look.prism_look_value_str(danger, "edge"), "palette.warn")
    let muted = unwrap(prism_theme.prism_theme_look(theme, "muted"))
    _check("muted ink", prism_look.prism_look_value_str(muted, "ink"), "palette.muted")
    _check("muted has no fill", prism_look.prism_look_value_str(muted, "fill"), "")

    print("== 4. resolved values are EXACT -- compared against the real palette hex ==")
    let pal = unwrap(prism_palette.prism_palette_named("classic", false))
    let slots = prism_palette.prism_palette_slots(pal)
    let ground_hex = prism_color.prism_color_to_hex(slots["ground"])
    let accent_hex = prism_color.prism_color_to_hex(slots["accent"])
    let warn_hex = prism_color.prism_color_to_hex(slots["warn"])
    let muted_hex = prism_color.prism_color_to_hex(slots["muted"])
    let r_surface = unwrap(prism_theme.prism_theme_resolved(theme, "surface"))
    _check("resolved surface.fill == real ground hex", prism_look.prism_look_value_str(r_surface, "fill"), ground_hex)
    let r_primary = unwrap(prism_theme.prism_theme_resolved(theme, "action_primary"))
    _check("resolved action_primary.fill == real accent hex", prism_look.prism_look_value_str(r_primary, "fill"), accent_hex)
    _check("resolved action_primary.ink == real ground hex", prism_look.prism_look_value_str(r_primary, "ink"), ground_hex)
    let r_danger = unwrap(prism_theme.prism_theme_resolved(theme, "danger"))
    _check("resolved danger.ink == real warn hex", prism_look.prism_look_value_str(r_danger, "ink"), warn_hex)
    let r_muted = unwrap(prism_theme.prism_theme_resolved(theme, "muted"))
    _check("resolved muted.ink == real muted hex", prism_look.prism_look_value_str(r_muted, "ink"), muted_hex)

    print("== 5. prism_theme_with: later-wins, non-conflicting kept, original NOT mutated ==")
    // Single-property role.
    let red = unwrap(prism_look.prism_paint_hex("#ff0000"))
    let ov_muted = unwrap(prism_look.prism_ink(prism_look.prism_look_new(), red))
    let theme2 = unwrap(prism_theme.prism_theme_with(theme, "muted", ov_muted))
    let muted_after = unwrap(prism_theme.prism_theme_look(theme2, "muted"))
    _check("with(): override wins on muted.ink", prism_look.prism_look_value_str(muted_after, "ink"), "#ff0000")
    let muted_orig_still = unwrap(prism_theme.prism_theme_look(theme, "muted"))
    _check("with(): original theme muted.ink NOT mutated", prism_look.prism_look_value_str(muted_orig_still, "ink"), "palette.muted")

    // Multi-property role -- only `round` is touched; fill/edge/ink/inset must survive untouched.
    let round4 = unwrap(prism_look.prism_len(4))
    let ov_surface = unwrap(prism_look.prism_round(prism_look.prism_look_new(), round4))
    let theme3 = unwrap(prism_theme.prism_theme_with(theme, "surface", ov_surface))
    let surface_after = unwrap(prism_theme.prism_theme_look(theme3, "surface"))
    _check("with(): override wins on surface.round", prism_look.prism_look_value_str(surface_after, "round"), "4")
    _check("with(): non-conflicting fill kept", prism_look.prism_look_value_str(surface_after, "fill"), "palette.ground")
    _check("with(): non-conflicting edge kept", prism_look.prism_look_value_str(surface_after, "edge"), "palette.edge")
    _check("with(): non-conflicting ink kept", prism_look.prism_look_value_str(surface_after, "ink"), "palette.ink")
    _check("with(): non-conflicting inset kept", prism_look.prism_look_value_str(surface_after, "inset"), "16")
    let surface_orig_still = unwrap(prism_theme.prism_theme_look(theme, "surface"))
    _check("with(): original theme surface.round NOT mutated", prism_look.prism_look_value_str(surface_orig_still, "round"), "8")
    // The original theme's OTHER roles must be untouched by an override targeting just one role.
    let field_still = unwrap(prism_theme.prism_theme_look(theme, "field"))
    _check("with(): unrelated role (field) untouched by surface override", prism_look.prism_look_value_str(field_still, "round"), "6")

    print("== 6. rejections (10 cases) ==")
    _check_rejected("unknown preset name", prism_theme.prism_theme_from("nope", false))
    _check_rejected("empty preset name", prism_theme.prism_theme_from("", true))
    _check_rejected("preset name wrong case ('Classic')", prism_theme.prism_theme_from("Classic", false))
    _check_rejected("unknown role (look)", prism_theme.prism_theme_look(theme, "nope"))
    _check_rejected("empty role (look)", prism_theme.prism_theme_look(theme, ""))
    _check_rejected("substring role 'action' must not match action_primary/action_quiet", prism_theme.prism_theme_look(theme, "action"))
    _check_rejected("role wrong case ('Surface')", prism_theme.prism_theme_look(theme, "Surface"))
    _check_rejected("unknown role (resolved)", prism_theme.prism_theme_resolved(theme, "nope"))
    _check_rejected("unknown role (with)", prism_theme.prism_theme_with(theme, "nope", prism_look.prism_look_new()))
    _check_rejected("role wrong case (with, 'ACTION_PRIMARY')", prism_theme.prism_theme_with(theme, "ACTION_PRIMARY", prism_look.prism_look_new()))
    // Error messages must be typed and name the legal set -- never a bare "error".
    let bad_role_err = prism_theme.prism_theme_look(theme, "nope")
    _check_true("unknown-role error message lists legal roles", find(unwrap_err(bad_role_err), "muted") >= 0)
    let bad_preset_err = prism_theme.prism_theme_from("nope", false)
    _check_true("unknown-preset error message lists legal presets", find(unwrap_err(bad_preset_err), "mono") >= 0)

    if FAILED[0] == 0
        print("")
        print("_kat_prism_theme: ALL PASS")
    else
        print("")
        print("_kat_prism_theme: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
