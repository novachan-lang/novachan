// KAT for prism/dev/prism_explain.nova -- why a subtree repaints (§12.7).
//
// The properties this exists for:
//   1. ★ IT REPORTS SCOPE, NOT JUST A FLAG. "This node is unkeyed" is not actionable; "this
//      unkeyed band repaints 5 nodes" is. Hotspots are asserted to carry the DESCENDANT COUNT
//      and to be ranked widest-first, because the developer wants the costliest branch, not the
//      first one encountered.
//   2. ★ read-sets are HONESTLY UNAVAILABLE. prism_exp_readsets_available() must return FALSE
//      and the report must SAY SO, because M3.4 is gated on M1.7 -- the falsifier that decides
//      whether zero-annotation reactivity survives at all. Emitting a plausible read-set would
//      fabricate the number the falsifier exists to measure.
//   3. A keyed subtree is NOT reported as a hotspot, and a childless unkeyed leaf is not either
//      -- otherwise the signal drowns in noise.

import prism_node
import prism_arrange
import prism_content
import prism_explain

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_explain ==")

    print("1. ★ read-sets are honestly unavailable")
    check("readsets_available() is FALSE, not a fabricated number", not prism_explain.prism_exp_readsets_available())

    print("2. counts and depth")
    // stack[ label, band[ label, label ] ]  -- 5 nodes, depth 2, all unkeyed.
    let l1 = unwrap(prism_content.prism_label("a"))
    let l2 = unwrap(prism_content.prism_label("b"))
    let l3 = unwrap(prism_content.prism_label("c"))
    let inner = unwrap(prism_arrange.prism_band([l2, l3]))
    let tree = unwrap(prism_arrange.prism_stack([l1, inner]))
    let e = unwrap(prism_explain.prism_exp_explain(tree))
    check("5 nodes total", prism_explain.prism_exp_total(e) == 5)
    check("depth 2", prism_explain.prism_exp_depth(e) == 2)
    check("keyed + unkeyed == total", prism_explain.prism_exp_keyed(e) + prism_explain.prism_exp_unkeyed(e) == prism_explain.prism_exp_total(e))
    check("widget constructors produce unkeyed nodes", prism_explain.prism_exp_unkeyed(e) == 5)

    print("3. ★ hotspots carry SCOPE and are ranked widest-first")
    let hs = prism_explain.prism_exp_hotspots(e)
    // Two unkeyed BRANCHES (the stack and the band); the three labels are childless leaves and
    // must NOT be reported -- replacing one label costs nothing and would bury the real signal.
    check("only unkeyed BRANCHES are hotspots (2, not 5)", len(hs) == 2)
    check("the widest is first", prism_explain.prism_exp_hot_scope(hs[0]) >= prism_explain.prism_exp_hot_scope(hs[1]))
    check("the root stack owns the whole tree (5)", prism_explain.prism_exp_hot_scope(hs[0]) == 5)
    check("the root is the stack", prism_explain.prism_exp_hot_kind(hs[0]) == "stack")
    check("the band owns 3 (itself + 2 labels)", prism_explain.prism_exp_hot_scope(hs[1]) == 3)
    check("the band is the band", prism_explain.prism_exp_hot_kind(hs[1]) == "band")
    check("depth is reported: root at 0", prism_explain.prism_exp_hot_depth(hs[0]) == 0)
    check("the band is at depth 1", prism_explain.prism_exp_hot_depth(hs[1]) == 1)

    print("4. a KEYED branch is not a hotspot")
    // Same shape, but the inner band carries an identity key, so a diff can match it in place.
    let keyed_inner = unwrap(prism_node.prism_node_keyed(prism_node.prism_kind_band(), {}, [l2, l3], "row-1"))
    let ktree = unwrap(prism_arrange.prism_stack([l1, keyed_inner]))
    let ke = unwrap(prism_explain.prism_exp_explain(ktree))
    check("the keyed band is counted as keyed", prism_explain.prism_exp_keyed(ke) == 1)
    check("only the unkeyed root remains a hotspot", len(prism_explain.prism_exp_hotspots(ke)) == 1)
    check("...and it is the stack", prism_explain.prism_exp_hot_kind(prism_explain.prism_exp_hotspots(ke)[0]) == "stack")

    print("5. a single leaf has no hotspots at all")
    let lone = unwrap(prism_explain.prism_exp_explain(l1))
    check("one node", prism_explain.prism_exp_total(lone) == 1)
    check("depth 0", prism_explain.prism_exp_depth(lone) == 0)
    check("a childless unkeyed leaf is NOT a hotspot", len(prism_explain.prism_exp_hotspots(lone)) == 0)

    print("6. ★ the report states the read-set limitation to the READER")
    let rep = prism_explain.prism_exp_report(e)
    check("the report carries the counts", contains(rep, "nodes 5"))
    check("the report carries the depth", contains(rep, "depth 2"))
    check("the report ranks the hotspots", contains(rep, "repaints 5 node(s)"))
    // The person reading the OUTPUT is the one who needs to know read-sets are missing -- saying
    // it only in a source comment would teach them to trust the rest more than they should.
    check("the report says read-sets are UNAVAILABLE", contains(rep, "read-sets: UNAVAILABLE"))
    check("...and names what gates them", contains(rep, "M3.4") and contains(rep, "M1.7"))
    let krep = prism_explain.prism_exp_report(unwrap(prism_explain.prism_exp_explain(l1)))
    check("a fully matchable tree says so explicitly", contains(krep, "no unkeyed branches"))

    print("")
    if STATS[1] == 0
        print("_kat_prism_explain: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_explain: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
