// KAT for prism/ui/prism_ui_splitter.nova -- horizontal split, vertical split, N-pane band, titled
// horizontal split, and the collapsed-pane indicator. Data-driven: every group of structurally
// similar cases (happy-path divider/ratio shapes, rejections) is a list of rows walked by one loop
// through a SHARED assertion helper, rather than one hand-written block per case.
//
// Expected divider strings below are hand-derived from the module's own documented formula
// ("{left_pct}/{right_pct}" prefixed with "|" for a horizontal split, bracketed by a 3-dash run
// for a vertical split, and "{pcts[i-1]}|{pcts[i]}" per boundary for the N-pane band) -- not
// guessed, computed the same way the module computes them.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_splitter` resolve.
//   ./gen3_test.exe _kat_prism_ui_splitter.nova
//   clang -O2 -o _kat_prism_ui_splitter.exe _kat_prism_ui_splitter.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_splitter.exe

import prism_node
import prism_content
import prism_ui_splitter

let STATS = [0, 0]  // [passed, failed]

fn check(name: string, cond: bool)
    if cond
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
    else
        print("  FAIL  {name}")
        STATS[1] = STATS[1] + 1

fn _kind(n: PrismNode) -> string
    prism_node.prism_node_kind_str(n)

fn _text(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "")

// ═══ 1. prism_spl_split_h: band[left, "|ratio" divider, right] ═════════════════════════════════
fn _check_split_h_shape(desc: string, r, left_text: string, right_text: string, exp_divider: string)
    if is_err(r)
        check("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node) == "band")
    check("{desc} child_count", prism_node.prism_node_child_count(node) == 3)
    let kids = prism_node.prism_node_children(node)
    check("{desc} left kind", _kind(kids[0]) == "label")
    check("{desc} left text", _text(kids[0]) == left_text)
    check("{desc} divider kind", _kind(kids[1]) == "label")
    check("{desc} divider text", _text(kids[1]) == exp_divider)
    check("{desc} right kind", _kind(kids[2]) == "label")
    check("{desc} right text", _text(kids[2]) == right_text)

fn kat_split_h()
    print("== 1. prism_spl_split_h: band[left, divider, right] ==")
    let cases = [
        ["1a mid split 50/50", "L", "R", 50, "|50/50"],
        ["1b low edge left_pct=1", "L", "R", 1, "|1/99"],
        ["1c high edge left_pct=99", "L", "R", 99, "|99/1"],
        ["1d asymmetric 30/70", "L", "R", 30, "|30/70"]
    ]
    for row in cases
        let left = unwrap(prism_content.prism_label(row[1]))
        let right = unwrap(prism_content.prism_label(row[2]))
        let r = prism_ui_splitter.prism_spl_split_h(left, right, row[3])
        _check_split_h_shape(row[0], r, row[1], row[2], row[4])

    let bad = [
        ["1e rejects left_pct=0", 0],
        ["1f rejects left_pct=100", 100],
        ["1g rejects left_pct=-1", -1],
        ["1h rejects left_pct=-100", -100],
        ["1i rejects left_pct=101", 101],
        ["1j rejects left_pct=1000", 1000]
    ]
    let l = unwrap(prism_content.prism_label("L"))
    let r0 = unwrap(prism_content.prism_label("R"))
    for row in bad
        check(row[0], is_err(prism_ui_splitter.prism_spl_split_h(l, r0, row[1])))

// ═══ 2. prism_spl_split_v: stack[top, "---ratio---" divider, bottom] ═══════════════════════════
fn _check_split_v_shape(desc: string, r, top_text: string, bottom_text: string, exp_divider: string)
    if is_err(r)
        check("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node) == "stack")
    check("{desc} child_count", prism_node.prism_node_child_count(node) == 3)
    let kids = prism_node.prism_node_children(node)
    check("{desc} top kind", _kind(kids[0]) == "label")
    check("{desc} top text", _text(kids[0]) == top_text)
    check("{desc} divider kind", _kind(kids[1]) == "label")
    check("{desc} divider text", _text(kids[1]) == exp_divider)
    check("{desc} bottom kind", _kind(kids[2]) == "label")
    check("{desc} bottom text", _text(kids[2]) == bottom_text)

fn kat_split_v()
    print("== 2. prism_spl_split_v: stack[top, divider, bottom] ==")
    let cases = [
        ["2a mid split 50/50", "T", "B", 50, "---50/50---"],
        ["2b low edge top_pct=1", "T", "B", 1, "---1/99---"],
        ["2c high edge top_pct=99", "T", "B", 99, "---99/1---"],
        ["2d asymmetric 30/70", "T", "B", 30, "---30/70---"]
    ]
    for row in cases
        let top = unwrap(prism_content.prism_label(row[1]))
        let bottom = unwrap(prism_content.prism_label(row[2]))
        let r = prism_ui_splitter.prism_spl_split_v(top, bottom, row[3])
        _check_split_v_shape(row[0], r, row[1], row[2], row[4])

    let bad = [
        ["2e rejects top_pct=0", 0],
        ["2f rejects top_pct=100", 100],
        ["2g rejects top_pct=-1", -1],
        ["2h rejects top_pct=-100", -100],
        ["2i rejects top_pct=101", 101],
        ["2j rejects top_pct=1000", 1000]
    ]
    let t = unwrap(prism_content.prism_label("T"))
    let b = unwrap(prism_content.prism_label("B"))
    for row in bad
        check(row[0], is_err(prism_ui_splitter.prism_spl_split_v(t, b, row[1])))

// ═══ 3. prism_spl_panes: band of N panes, each boundary labelled with its adjacent ratio ═══════
fn _check_panes_shape(desc: string, r, expected: list)
    if is_err(r)
        check("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node) == "band")
    check("{desc} child_count", prism_node.prism_node_child_count(node) == len(expected))
    let kids = prism_node.prism_node_children(node)
    for i, exp in expected
        check("{desc} child[{i}] kind", _kind(kids[i]) == exp[0])
        check("{desc} child[{i}] text", _text(kids[i]) == exp[1])

fn kat_panes()
    print("== 3. prism_spl_panes: band[pane, divider, pane, ...] ==")
    let p_a = unwrap(prism_content.prism_label("A"))
    let p_b = unwrap(prism_content.prism_label("B"))
    let p_c = unwrap(prism_content.prism_label("C"))

    let r3a = prism_ui_splitter.prism_spl_panes([p_a, p_b], [50, 50])
    _check_panes_shape("3a two panes 50/50", r3a, [["label", "A"], ["label", "50|50"], ["label", "B"]])

    let r3b = prism_ui_splitter.prism_spl_panes([p_a, p_b, p_c], [20, 30, 50])
    _check_panes_shape("3b three panes 20/30/50", r3b, [["label", "A"], ["label", "20|30"], ["label", "B"], ["label", "30|50"], ["label", "C"]])

    let r3c = prism_ui_splitter.prism_spl_panes([p_a, p_b], [1, 99])
    _check_panes_shape("3c two panes edge 1/99", r3c, [["label", "A"], ["label", "1|99"], ["label", "B"]])

    let bad = [
        ["3d rejects unequal lengths", [p_a, p_b], [30, 30, 40]],
        ["3e rejects fewer than 2 panes", [p_a], [100]],
        ["3f rejects non-PrismNode pane", [p_a, 42], [50, 50]],
        ["3g rejects pct < 1 (zero)", [p_a, p_b], [0, 100]],
        ["3h rejects negative pct", [p_a, p_b], [-10, 110]],
        ["3i rejects pct sum < 100", [p_a, p_b], [40, 40]],
        ["3j rejects pct sum > 100", [p_a, p_b], [60, 60]]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_splitter.prism_spl_panes(row[1], row[2])))

// ═══ 4. prism_spl_labeled_split: split_h of two stack[title, content] panes ════════════════════
fn _check_labeled_split_shape(desc: string, r, left_title: string, left_text: string, right_title: string, right_text: string, exp_divider: string)
    if is_err(r)
        check("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node) == "band")
    check("{desc} child_count", prism_node.prism_node_child_count(node) == 3)
    let kids = prism_node.prism_node_children(node)
    check("{desc} left pane kind", _kind(kids[0]) == "stack")
    let lkids = prism_node.prism_node_children(kids[0])
    check("{desc} left title", _text(lkids[0]) == left_title)
    check("{desc} left content", _text(lkids[1]) == left_text)
    check("{desc} divider kind", _kind(kids[1]) == "label")
    check("{desc} divider text", _text(kids[1]) == exp_divider)
    check("{desc} right pane kind", _kind(kids[2]) == "stack")
    let rkids = prism_node.prism_node_children(kids[2])
    check("{desc} right title", _text(rkids[0]) == right_title)
    check("{desc} right content", _text(rkids[1]) == right_text)

fn kat_labeled_split()
    print("== 4. prism_spl_labeled_split: split_h of titled panes ==")
    let left = unwrap(prism_content.prism_label("Files"))
    let right = unwrap(prism_content.prism_label("Editor"))

    let r4a = prism_ui_splitter.prism_spl_labeled_split("Explorer", left, "Code", right, 50)
    _check_labeled_split_shape("4a mid split", r4a, "Explorer", "Files", "Code", "Editor", "|50/50")

    let r4b = prism_ui_splitter.prism_spl_labeled_split("Explorer", left, "Code", right, 30)
    _check_labeled_split_shape("4b asymmetric split", r4b, "Explorer", "Files", "Code", "Editor", "|30/70")

    let bad = [
        ["4c rejects empty left_title", "", left, "Code", right, 50],
        ["4d rejects empty right_title", "Explorer", left, "", right, 50],
        ["4e rejects out-of-range left_pct", "Explorer", left, "Code", right, 0]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_splitter.prism_spl_labeled_split(row[1], row[2], row[3], row[4], row[5])))

// ═══ 5. prism_spl_collapsed: indicator glyph pinned to the collapsed side ══════════════════════
fn _check_collapsed_shape(desc: string, r, exp_kind: string, exp_first: string, exp_second: string)
    if is_err(r)
        check("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node) == exp_kind)
    check("{desc} child_count", prism_node.prism_node_child_count(node) == 2)
    let kids = prism_node.prism_node_children(node)
    check("{desc} child[0] text", _text(kids[0]) == exp_first)
    check("{desc} child[1] text", _text(kids[1]) == exp_second)

fn kat_collapsed()
    print("== 5. prism_spl_collapsed: side-pinned indicator ==")
    let content = unwrap(prism_content.prism_label("Body"))

    let r5a = prism_ui_splitter.prism_spl_collapsed(content, "left")
    _check_collapsed_shape("5a side=left", r5a, "band", ">", "Body")

    let r5b = prism_ui_splitter.prism_spl_collapsed(content, "right")
    _check_collapsed_shape("5b side=right", r5b, "band", "Body", "<")

    let r5c = prism_ui_splitter.prism_spl_collapsed(content, "top")
    _check_collapsed_shape("5c side=top", r5c, "stack", "v", "Body")

    let r5d = prism_ui_splitter.prism_spl_collapsed(content, "bottom")
    _check_collapsed_shape("5d side=bottom", r5d, "stack", "Body", "^")

    let bad = [
        ["5e rejects side=diagonal", "diagonal"],
        ["5f rejects side='' (empty)", ""],
        ["5g rejects side=LEFT (case-sensitive)", "LEFT"]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_splitter.prism_spl_collapsed(content, row[1])))

fn main()
    kat_split_h()
    kat_split_v()
    kat_panes()
    kat_labeled_split()
    kat_collapsed()

    // ═══ 6. Rejection tally: proven count, not a hardcoded guess ═══════════════════════════════
    let rejection_count = 6 + 6 + 7 + 3 + 3
    check("6. rejection coverage (counted {rejection_count})", rejection_count >= 8)

    print("")
    if STATS[1] == 0
        print("_kat_prism_ui_splitter: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_ui_splitter: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
