// KAT for prism/style/prism_tokens.nova (milestone MB.7 -- design-token scales).
//
// Proves, against concrete expected values:
//   1. Space scale: all 7 steps map to their exact documented px, are pairwise distinct, and feed
//      prism_inset successfully.
//   2. Radius scale: all 5 steps map to their exact documented px (incl. `pill` = 9999), distinct,
//      feed prism_round.
//   3. Type scale: all 5 sizes and their derived leadings match their exact documented values, the
//      1.5x ratio holds EXACTLY at every step (`leading * 2 == size * 3`, no division trusted),
//      sizes and leadings are each pairwise distinct, feed prism_font / prism_leading.
//   4. Elevation scale: all 5 levels match their exact documented value, stay inside prism_elev's
//      legal 0-24 band, are pairwise distinct, feed prism_lift.
//   5. Duration scale: all 4 steps match their exact documented ms, pairwise distinct, feed
//      prism_over and prism_delay.
//   6. Neutral ramp: given base #6b7280, all 9 stops match their exact computed hex, luminance
//      (integer luma, no floats) is STRICTLY monotonic across all 9 and pairwise distinct, stop
//      500 is byte-identical to the base, and a stop feeds prism_fill successfully.
//   7. >= 6 rejection cases: out-of-range neutral-ramp channels (both directions), pure black,
//      pure white, and a token handed to the WRONG property (group mismatch) -- plus the 16/239
//      boundary values are ACCEPTED, proving the validation is not merely over-strict.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME = the nova-compiler/ root, NOVA_NO_CACHE=1):
//   ./gen3_test.exe _kat_prism_tokens.nova
//   clang -O2 -o _kat_prism_tokens.exe _kat_prism_tokens.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_tokens.exe        (always under Invoke-Timed -TimeoutMs, kill-on-timeout)

import prism_tokens
import prism_look
import prism_color

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

// A rejection must be a typed Err, NOT a crash and NOT a silently-accepted default.
fn _check_rejected(label: string, r)
    if is_err(r)
        print("  pass  reject: " + label)
    else
        print("  FAIL  reject: " + label + " -- was ACCEPTED")
        FAILED[0] = FAILED[0] + 1

// Every element of `xs` differs from every other -- "a scale with duplicate values is not a scale".
fn _all_distinct(xs: list) -> bool
    let n = len(xs)
    let mut i = 0
    while i < n
        let mut j = i + 1
        while j < n
            if xs[i] == xs[j]
                return false
            j += 1
        i += 1
    true

// Integer luma (ITU-R BT.601 weights, scaled to avoid floats entirely) -- used ONLY here, to
// verify monotonicity of the neutral ramp; the production module never needs a luminance measure.
fn _luma_of(r: int, g: int, b: int) -> int
    (r * 299 + g * 587 + b * 114) / 1000

fn main()
    print("== 1. space scale ==")
    _check("none px", str(prism_tokens.prism_space_px(prism_tokens.prism_space_none())), "0")
    _check("xs px", str(prism_tokens.prism_space_px(prism_tokens.prism_space_xs())), "4")
    _check("sm px", str(prism_tokens.prism_space_px(prism_tokens.prism_space_sm())), "8")
    _check("md px", str(prism_tokens.prism_space_px(prism_tokens.prism_space_md())), "16")
    _check("lg px", str(prism_tokens.prism_space_px(prism_tokens.prism_space_lg())), "24")
    _check("xl px", str(prism_tokens.prism_space_px(prism_tokens.prism_space_xl())), "32")
    _check("xxl px", str(prism_tokens.prism_space_px(prism_tokens.prism_space_xxl())), "48")
    _check("none name", prism_tokens.prism_space_name(prism_tokens.prism_space_none()), "none")
    _check("xs name", prism_tokens.prism_space_name(prism_tokens.prism_space_xs()), "xs")
    _check("sm name", prism_tokens.prism_space_name(prism_tokens.prism_space_sm()), "sm")
    _check("md name", prism_tokens.prism_space_name(prism_tokens.prism_space_md()), "md")
    _check("lg name", prism_tokens.prism_space_name(prism_tokens.prism_space_lg()), "lg")
    _check("xl name", prism_tokens.prism_space_name(prism_tokens.prism_space_xl()), "xl")
    _check("xxl name", prism_tokens.prism_space_name(prism_tokens.prism_space_xxl()), "xxl")
    let space_pxs = [prism_tokens.prism_space_px(prism_tokens.prism_space_none()), prism_tokens.prism_space_px(prism_tokens.prism_space_xs()), prism_tokens.prism_space_px(prism_tokens.prism_space_sm()), prism_tokens.prism_space_px(prism_tokens.prism_space_md()), prism_tokens.prism_space_px(prism_tokens.prism_space_lg()), prism_tokens.prism_space_px(prism_tokens.prism_space_xl()), prism_tokens.prism_space_px(prism_tokens.prism_space_xxl())]
    _check_true("space: 7 steps pairwise distinct", _all_distinct(space_pxs))
    let sv = prism_tokens.prism_space_value(prism_tokens.prism_space_md())
    _check_true("space token is a valid PrismValue", not is_err(sv))
    let look1 = prism_look.prism_inset(prism_look.prism_look_new(), unwrap(sv))
    _check_true("space token feeds prism_inset", not is_err(look1))
    _check("prism_inset(space_md) renders 16", prism_look.prism_look_value_str(unwrap(look1), "inset"), "16")

    print("== 2. radius scale ==")
    _check("none px", str(prism_tokens.prism_radius_px(prism_tokens.prism_radius_none())), "0")
    _check("sm px", str(prism_tokens.prism_radius_px(prism_tokens.prism_radius_sm())), "4")
    _check("md px", str(prism_tokens.prism_radius_px(prism_tokens.prism_radius_md())), "8")
    _check("lg px", str(prism_tokens.prism_radius_px(prism_tokens.prism_radius_lg())), "16")
    _check("pill px", str(prism_tokens.prism_radius_px(prism_tokens.prism_radius_pill())), "9999")
    _check("pill name", prism_tokens.prism_radius_name(prism_tokens.prism_radius_pill()), "pill")
    let radius_pxs = [prism_tokens.prism_radius_px(prism_tokens.prism_radius_none()), prism_tokens.prism_radius_px(prism_tokens.prism_radius_sm()), prism_tokens.prism_radius_px(prism_tokens.prism_radius_md()), prism_tokens.prism_radius_px(prism_tokens.prism_radius_lg()), prism_tokens.prism_radius_px(prism_tokens.prism_radius_pill())]
    _check_true("radius: 5 steps pairwise distinct", _all_distinct(radius_pxs))
    let look2 = prism_look.prism_round(prism_look.prism_look_new(), unwrap(prism_tokens.prism_radius_value(prism_tokens.prism_radius_lg())))
    _check_true("radius token feeds prism_round", not is_err(look2))
    _check("prism_round(radius_lg) renders 16", prism_look.prism_look_value_str(unwrap(look2), "round"), "16")

    print("== 3. type scale (sizes, leadings, exact 1.5x ratio) ==")
    _check("caption size", str(prism_tokens.prism_type_size_px(prism_tokens.prism_type_caption())), "12")
    _check("body size", str(prism_tokens.prism_type_size_px(prism_tokens.prism_type_body())), "16")
    _check("title size", str(prism_tokens.prism_type_size_px(prism_tokens.prism_type_title())), "20")
    _check("heading size", str(prism_tokens.prism_type_size_px(prism_tokens.prism_type_heading())), "28")
    _check("display size", str(prism_tokens.prism_type_size_px(prism_tokens.prism_type_display())), "40")
    _check("caption leading", str(prism_tokens.prism_type_leading_px(prism_tokens.prism_type_caption())), "18")
    _check("body leading", str(prism_tokens.prism_type_leading_px(prism_tokens.prism_type_body())), "24")
    _check("title leading", str(prism_tokens.prism_type_leading_px(prism_tokens.prism_type_title())), "30")
    _check("heading leading", str(prism_tokens.prism_type_leading_px(prism_tokens.prism_type_heading())), "42")
    _check("display leading", str(prism_tokens.prism_type_leading_px(prism_tokens.prism_type_display())), "60")
    // Ratio proven by cross-multiplication -- never trusts integer-division truncation.
    let tsteps = [prism_tokens.prism_type_caption(), prism_tokens.prism_type_body(), prism_tokens.prism_type_title(), prism_tokens.prism_type_heading(), prism_tokens.prism_type_display()]
    for ts in tsteps
        let sz = prism_tokens.prism_type_size_px(ts)
        let ld = prism_tokens.prism_type_leading_px(ts)
        _check_true("1.5x ratio exact for " + prism_tokens.prism_type_name(ts), ld * 2 == sz * 3)
    let type_sizes = [prism_tokens.prism_type_size_px(prism_tokens.prism_type_caption()), prism_tokens.prism_type_size_px(prism_tokens.prism_type_body()), prism_tokens.prism_type_size_px(prism_tokens.prism_type_title()), prism_tokens.prism_type_size_px(prism_tokens.prism_type_heading()), prism_tokens.prism_type_size_px(prism_tokens.prism_type_display())]
    let type_leadings = [prism_tokens.prism_type_leading_px(prism_tokens.prism_type_caption()), prism_tokens.prism_type_leading_px(prism_tokens.prism_type_body()), prism_tokens.prism_type_leading_px(prism_tokens.prism_type_title()), prism_tokens.prism_type_leading_px(prism_tokens.prism_type_heading()), prism_tokens.prism_type_leading_px(prism_tokens.prism_type_display())]
    _check_true("type: 5 sizes pairwise distinct", _all_distinct(type_sizes))
    _check_true("type: 5 leadings pairwise distinct", _all_distinct(type_leadings))
    let look3a = prism_look.prism_font(prism_look.prism_look_new(), unwrap(prism_tokens.prism_type_size_value(prism_tokens.prism_type_body())))
    _check_true("type size token feeds prism_font", not is_err(look3a))
    let look3b = prism_look.prism_leading(unwrap(look3a), unwrap(prism_tokens.prism_type_leading_value(prism_tokens.prism_type_body())))
    _check_true("type leading token feeds prism_leading", not is_err(look3b))
    _check("prism_font(type_body) renders 16", prism_look.prism_look_value_str(unwrap(look3b), "font"), "16")
    _check("prism_leading(type_body) renders 24", prism_look.prism_look_value_str(unwrap(look3b), "leading"), "24")

    print("== 4. elevation scale ==")
    _check("flat level", str(prism_tokens.prism_elev_step_level(prism_tokens.prism_elev_flat())), "0")
    _check("raised level", str(prism_tokens.prism_elev_step_level(prism_tokens.prism_elev_raised())), "2")
    _check("floating level", str(prism_tokens.prism_elev_step_level(prism_tokens.prism_elev_floating())), "8")
    _check("overlay level", str(prism_tokens.prism_elev_step_level(prism_tokens.prism_elev_overlay())), "16")
    _check("modal level", str(prism_tokens.prism_elev_step_level(prism_tokens.prism_elev_modal())), "24")
    let elev_levels = [prism_tokens.prism_elev_step_level(prism_tokens.prism_elev_flat()), prism_tokens.prism_elev_step_level(prism_tokens.prism_elev_raised()), prism_tokens.prism_elev_step_level(prism_tokens.prism_elev_floating()), prism_tokens.prism_elev_step_level(prism_tokens.prism_elev_overlay()), prism_tokens.prism_elev_step_level(prism_tokens.prism_elev_modal())]
    for lv in elev_levels
        _check_true("elevation level " + str(lv) + " inside legal 0..24", lv >= 0 and lv <= 24)
    _check_true("elevation: 5 levels pairwise distinct", _all_distinct(elev_levels))
    let look4 = prism_look.prism_lift(prism_look.prism_look_new(), unwrap(prism_tokens.prism_elev_step_value(prism_tokens.prism_elev_raised())))
    _check_true("elevation token feeds prism_lift", not is_err(look4))
    _check("prism_lift(elev_raised) renders elev:2", prism_look.prism_look_value_str(unwrap(look4), "lift"), "elev:2")

    print("== 5. duration scale ==")
    _check("instant ms", str(prism_tokens.prism_dur_step_ms(prism_tokens.prism_dur_instant())), "0")
    _check("fast ms", str(prism_tokens.prism_dur_step_ms(prism_tokens.prism_dur_fast())), "150")
    _check("normal ms", str(prism_tokens.prism_dur_step_ms(prism_tokens.prism_dur_normal())), "250")
    _check("slow ms", str(prism_tokens.prism_dur_step_ms(prism_tokens.prism_dur_slow())), "400")
    let dur_ms_list = [prism_tokens.prism_dur_step_ms(prism_tokens.prism_dur_instant()), prism_tokens.prism_dur_step_ms(prism_tokens.prism_dur_fast()), prism_tokens.prism_dur_step_ms(prism_tokens.prism_dur_normal()), prism_tokens.prism_dur_step_ms(prism_tokens.prism_dur_slow())]
    _check_true("duration: 4 steps pairwise distinct", _all_distinct(dur_ms_list))
    let look5a = prism_look.prism_over(prism_look.prism_look_new(), unwrap(prism_tokens.prism_dur_step_value(prism_tokens.prism_dur_fast())))
    _check_true("duration token feeds prism_over", not is_err(look5a))
    let look5b = prism_look.prism_delay(unwrap(look5a), unwrap(prism_tokens.prism_dur_step_value(prism_tokens.prism_dur_slow())))
    _check_true("duration token feeds prism_delay", not is_err(look5b))
    _check("prism_over(dur_fast) renders 150ms", prism_look.prism_look_value_str(unwrap(look5b), "over"), "150ms")
    _check("prism_delay(dur_slow) renders 400ms", prism_look.prism_look_value_str(unwrap(look5b), "delay"), "400ms")

    print("== 6. neutral ramp (base #6b7280 -- a real Tailwind-slate-500-equivalent gray) ==")
    let base = unwrap(prism_color.prism_color_rgba(107, 114, 128, 255))
    _check("base itself round-trips", prism_color.prism_color_to_hex(base), "#6b7280")
    let ramp = unwrap(prism_tokens.prism_neutral_ramp(base))
    _check("ramp has 9 stops", str(len(ramp)), "9")
    // Exact expected hex per stop, computed by the SAME formula independently in Python (see task
    // record) -- not eyeballed.
    _check("100 (lightest)", prism_color.prism_color_to_hex(ramp[0]), "#e1e2e5")
    _check("200", prism_color.prism_color_to_hex(ramp[1]), "#c3c6cc")
    _check("300", prism_color.prism_color_to_hex(ramp[2]), "#a6aab2")
    _check("400", prism_color.prism_color_to_hex(ramp[3]), "#888e99")
    _check("500 == base, unchanged", prism_color.prism_color_to_hex(ramp[4]), "#6b7280")
    _check("600", prism_color.prism_color_to_hex(ramp[5]), "#565c67")
    _check("700", prism_color.prism_color_to_hex(ramp[6]), "#41454d")
    _check("800", prism_color.prism_color_to_hex(ramp[7]), "#2b2e34")
    _check("900 (darkest)", prism_color.prism_color_to_hex(ramp[8]), "#16171a")
    // prism_neutral_stop must agree with prism_neutral_ramp's own element for the same step.
    let stop500 = unwrap(prism_tokens.prism_neutral_stop(base, prism_tokens.prism_neutral_500()))
    _check("prism_neutral_stop(500) agrees with ramp[4]", prism_color.prism_color_to_hex(stop500), prism_color.prism_color_to_hex(ramp[4]))
    // Luminance: strictly monotonic (lightest -> darkest) and pairwise distinct. Computed, not
    // eyeballed -- integer luma, no floats anywhere in this check.
    let mut idx = 0
    let lumas = []
    while idx < 9
        let c = ramp[idx]
        push(lumas, _luma_of(prism_color.prism_color_r(c), prism_color.prism_color_g(c), prism_color.prism_color_b(c)))
        idx = idx + 1
    _check_true("neutral ramp: 9 lumas pairwise distinct", _all_distinct(lumas))
    let mut mono = true
    let mut k = 0
    while k < 8
        if not (lumas[k] > lumas[k + 1])
            mono = false
        k = k + 1
    _check_true("neutral ramp: luma strictly monotonic decreasing 100->900", mono)
    // RGB-tuple distinctness too (stronger than luma alone, though luma distinctness already implies it).
    let mut m = 0
    let rgb_keys = []
    while m < 9
        let c2 = ramp[m]
        push(rgb_keys, prism_color.prism_color_r(c2) * 1000000 + prism_color.prism_color_g(c2) * 1000 + prism_color.prism_color_b(c2))
        m = m + 1
    _check_true("neutral ramp: 9 RGB triples pairwise distinct", _all_distinct(rgb_keys))
    let look6 = prism_look.prism_fill(prism_look.prism_look_new(), unwrap(prism_tokens.prism_neutral_paint(base, prism_tokens.prism_neutral_500())))
    _check_true("neutral token feeds prism_fill", not is_err(look6))
    _check("prism_fill(neutral_500) renders base hex", prism_look.prism_look_value_str(unwrap(look6), "fill"), "#6b7280")

    print("== 7. rejections (>= 6) ==")
    _check_rejected("neutral base channel too low (5)", prism_tokens.prism_neutral_ramp(unwrap(prism_color.prism_color_rgba(5, 100, 100, 255))))
    _check_rejected("neutral base channel too high (250)", prism_tokens.prism_neutral_ramp(unwrap(prism_color.prism_color_rgba(100, 100, 250, 255))))
    _check_rejected("neutral base pure black", prism_tokens.prism_neutral_ramp(unwrap(prism_color.prism_color_rgba(0, 0, 0, 255))))
    _check_rejected("neutral base pure white", prism_tokens.prism_neutral_ramp(unwrap(prism_color.prism_color_rgba(255, 255, 255, 255))))
    _check_rejected("space (len) token into prism_lift (elev expected)", prism_look.prism_lift(prism_look.prism_look_new(), unwrap(prism_tokens.prism_space_value(prism_tokens.prism_space_md()))))
    _check_rejected("elevation token into prism_fade (frac expected)", prism_look.prism_fade(prism_look.prism_look_new(), unwrap(prism_tokens.prism_elev_step_value(prism_tokens.prism_elev_raised()))))
    _check_rejected("duration token into prism_align_of (align expected)", prism_look.prism_align_of(prism_look.prism_look_new(), unwrap(prism_tokens.prism_dur_step_value(prism_tokens.prism_dur_fast()))))
    // Boundaries that must be ACCEPTED, so the 16..239 validation is not merely over-strict.
    _check_true("channel 16 accepted (lower boundary)", not is_err(prism_tokens.prism_neutral_ramp(unwrap(prism_color.prism_color_rgba(16, 16, 16, 255)))))
    _check_true("channel 239 accepted (upper boundary)", not is_err(prism_tokens.prism_neutral_ramp(unwrap(prism_color.prism_color_rgba(239, 239, 239, 255)))))

    if FAILED[0] == 0
        print("")
        print("_kat_prism_tokens: ALL PASS")
    else
        print("")
        print("_kat_prism_tokens: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
