// KAT for prism/widget/prism_media.nova -- video/audio playback (#82).
//
// The two properties this exists for:
//   1. ★ A VIDEO WITHOUT CAPTIONS IS UNREPRESENTABLE through the ordinary constructor. A
//      "captions: optional" API is how every platform ended up with uncaptioned video -- the
//      default won, every time. The escape hatch exists, is named so it cannot hide, and DEMANDS
//      A REASON.
//   2. ★ AUTOPLAY REQUIRES MUTED, enforced in the constructor -- and unmuting CLEARS autoplay, so
//      the forbidden pair cannot be reached from the other direction either. That second half is
//      the one a naive implementation misses.

import prism_node
import prism_media

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_media ==")

    print("1. ★ captions are REQUIRED, not optional")
    check("a video WITH captions constructs", not is_err(prism_media.prism_md_video("clip.mp4", "clip.vtt", 60000)))
    check("★ a video with EMPTY captions is REJECTED", is_err(prism_media.prism_md_video("clip.mp4", "", 60000)))
    check("non-string captions rejected", is_err(prism_media.prism_md_video("clip.mp4", 7, 60000)))
    check("audio REQUIRES a transcript", is_err(prism_media.prism_md_audio("song.mp3", "", 60000)))
    check("audio with a transcript constructs", not is_err(prism_media.prism_md_audio("song.mp3", "song.txt", 60000)))
    // The escape hatch exists, but it must state a reason -- an uncaptioned video with no
    // explanation is indistinguishable from an oversight.
    check("the no-captions hatch REQUIRES a reason", is_err(prism_media.prism_md_video_no_captions("clip.mp4", 60000, "")))
    check("...and works when a reason is given", not is_err(prism_media.prism_md_video_no_captions("clip.mp4", 60000, "silent background loop, no speech")))
    check("empty source rejected", is_err(prism_media.prism_md_video("", "c.vtt", 60000)))
    check("zero duration rejected", is_err(prism_media.prism_md_video("clip.mp4", "c.vtt", 0)))
    check("non-int duration rejected", is_err(prism_media.prism_md_video("clip.mp4", "c.vtt", "60000")))

    let v = unwrap(prism_media.prism_md_video("clip.mp4", "clip.vtt", 60000))

    print("2. initial state")
    check("kind is video", prism_media.prism_md_kind_name(prism_media.prism_md_kind(v)) == "video")
    check("starts idle", prism_media.prism_md_state_name(prism_media.prism_md_state(v)) == "idle")
    check("starts at position 0", prism_media.prism_md_position(v) == 0)
    check("starts unmuted at full volume", not prism_media.prism_md_muted(v) and prism_media.prism_md_volume(v) == 100)
    check("autoplay is OFF by default", not prism_media.prism_md_autoplay_on(v))
    check("captions are retained", prism_media.prism_md_captions(v) == "clip.vtt")

    print("3. transport is non-mutating and total")
    let playing = prism_media.prism_md_play(v)
    check("play sets playing", prism_media.prism_md_state_name(prism_media.prism_md_state(playing)) == "playing")
    check("the ORIGINAL is unchanged (non-mutating)", prism_media.prism_md_state_name(prism_media.prism_md_state(v)) == "idle")
    check("pause sets paused", prism_media.prism_md_state_name(prism_media.prism_md_state(prism_media.prism_md_pause(playing))) == "paused")
    let mid = unwrap(prism_media.prism_md_seek(v, 30000))
    check("seek moves the position", prism_media.prism_md_position(mid) == 30000)
    check("progress is 500/1000 at halfway", prism_media.prism_md_progress(mid) == 500)
    // Seeking past the end lands EXACTLY on duration, never one past -- otherwise every progress
    // calculation exceeds 100%.
    let past = unwrap(prism_media.prism_md_seek(v, 99999))
    check("seeking past the end clamps EXACTLY to duration", prism_media.prism_md_position(past) == 60000)
    check("...and marks it ended", prism_media.prism_md_state_name(prism_media.prism_md_state(past)) == "ended")
    check("progress is exactly 1000 at the end", prism_media.prism_md_progress(past) == 1000)
    // Play from ENDED restarts, or the play button looks dead at the end of a video.
    check("play from ENDED restarts at 0", prism_media.prism_md_position(prism_media.prism_md_play(past)) == 0)
    check("negative seek rejected", is_err(prism_media.prism_md_seek(v, -1)))
    check("non-int seek rejected", is_err(prism_media.prism_md_seek(v, "30000")))

    print("4. ★ autoplay REQUIRES muted -- in both directions")
    check("★ autoplay on UNMUTED media is REFUSED", is_err(prism_media.prism_md_autoplay(v)))
    let muted = prism_media.prism_md_mute(v)
    check("muting works", prism_media.prism_md_muted(muted))
    let auto = unwrap(prism_media.prism_md_autoplay(muted))
    check("autoplay on MUTED media is allowed", prism_media.prism_md_autoplay_on(auto))
    // ★ The half a naive implementation misses: unmuting must CLEAR autoplay, or the forbidden
    // pair is reachable by muting, enabling autoplay, then unmuting.
    let unmuted = prism_media.prism_md_unmute(auto)
    check("★ unmuting CLEARS autoplay (the pair cannot be reached backwards)", not prism_media.prism_md_autoplay_on(unmuted))
    check("...and it is genuinely unmuted", not prism_media.prism_md_muted(unmuted))

    print("5. volume")
    check("volume can be set", prism_media.prism_md_volume(unwrap(prism_media.prism_md_volume_set(v, 40))) == 40)
    check("volume 0 is legal", not is_err(prism_media.prism_md_volume_set(v, 0)))
    check("volume above 100 rejected", is_err(prism_media.prism_md_volume_set(v, 101)))
    check("negative volume rejected", is_err(prism_media.prism_md_volume_set(v, -1)))
    check("non-int volume rejected", is_err(prism_media.prism_md_volume_set(v, "40")))

    print("6. the captions state is VISIBLE in the rendered node")
    let node = unwrap(prism_media.prism_md_node(v))
    check("a media node is a band", prism_node.prism_node_kind_str(node) == "band")
    check("captioned media renders a captions indicator", prism_node.prism_node_attr_str(prism_node.prism_node_children(node)[1], "text", "") == "captions")
    // An uncaptioned video is visible AS SUCH in any backend -- not merely missing metadata.
    let nocap = unwrap(prism_media.prism_md_video_no_captions("clip.mp4", 60000, "silent loop"))
    check("★ an uncaptioned video RENDERS 'NO CAPTIONS'", prism_node.prism_node_attr_str(prism_node.prism_node_children(unwrap(prism_media.prism_md_node(nocap)))[1], "text", "") == "NO CAPTIONS")

    print("")
    if STATS[1] == 0
        print("_kat_prism_media: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_media: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
