import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_ui_error

fn check(cond: bool, label: string) -> bool
    if cond
        print("  PASS: " + label)
    else
        print("  FAIL: " + label)
    cond

fn main()
    let mut passed = 0
    let mut total = 0

    // ---- reference nodes for self-consistent structural comparison ----
    let direct_label = unwrap(prism_content.prism_label("ref_label"))
    let direct_band = unwrap(prism_arrange.prism_band([direct_label]))
    let direct_gap = unwrap(prism_arrange.prism_gap(some(8)))
    let direct_press = unwrap(prism_interact.prism_press("ref_btn", [direct_label]))
    let direct_stack = unwrap(prism_arrange.prism_stack([direct_label]))
    let label_kind = prism_node.prism_node_kind_str(direct_label)
    let band_kind = prism_node.prism_node_kind_str(direct_band)
    let gap_kind = prism_node.prism_node_kind_str(direct_gap)
    let press_kind = prism_node.prism_node_kind_str(direct_press)
    let stack_kind = prism_node.prism_node_kind_str(direct_stack)

    print("=== prism_eb_boundary ===")

    // 1. ok result passes through unchanged
    total = total + 1
    let a1 = prism_ui_error.prism_eb_boundary(prism_content.prism_label("hello"), "fallback")
    if check(is_ok(a1), "boundary: ok input -> is_ok")
        passed = passed + 1

    // 2. ok passthrough preserves node kind (label)
    total = total + 1
    if check(prism_node.prism_node_kind_str(unwrap(a1)) == label_kind, "boundary: ok input -> kind is label")
        passed = passed + 1

    // 3. err result falls back to band
    total = total + 1
    let a2 = prism_ui_error.prism_eb_boundary(err("boom"), "Something broke")
    if check(is_ok(a2), "boundary: err input -> fallback is_ok")
        passed = passed + 1

    // 4. fallback band has 2 children (icon, message)
    total = total + 1
    let a2c = prism_node.prism_node_children(unwrap(a2))
    if check(len(a2c) == 2, "boundary: err input -> fallback has 2 children")
        passed = passed + 1

    // 5. fallback node kind is band
    total = total + 1
    if check(prism_node.prism_node_kind_str(unwrap(a2)) == band_kind, "boundary: err input -> fallback kind is band")
        passed = passed + 1

    // 6. empty fallback_message errors even with err input
    total = total + 1
    let a3 = prism_ui_error.prism_eb_boundary(err("boom"), "")
    if check(is_err(a3), "boundary: empty fallback_message + err input -> err")
        passed = passed + 1

    // 7. empty fallback_message errors even with ok input
    total = total + 1
    let a4 = prism_ui_error.prism_eb_boundary(prism_content.prism_label("hi"), "")
    if check(is_err(a4), "boundary: empty fallback_message + ok input -> err")
        passed = passed + 1

    print("=== prism_eb_detail ===")

    // 8. ok result
    total = total + 1
    let b1 = prism_ui_error.prism_eb_detail("Failed to load", "Network timeout after 30s")
    if check(is_ok(b1), "detail: valid args -> is_ok")
        passed = passed + 1

    let b1n = unwrap(b1)
    let b1c = prism_node.prism_node_children(b1n)

    // 9. stack node kind
    total = total + 1
    if check(prism_node.prism_node_kind_str(b1n) == stack_kind, "detail: result kind is stack")
        passed = passed + 1

    // 10. stack has 3 children
    total = total + 1
    if check(len(b1c) == 3, "detail: stack has 3 children")
        passed = passed + 1

    // 11. first child (header) is a band
    total = total + 1
    if check(prism_node.prism_node_kind_str(b1c[0]) == band_kind, "detail: child[0] is band (header)")
        passed = passed + 1

    // 12. header band has 2 children (icon, message)
    total = total + 1
    let b1hc = prism_node.prism_node_children(b1c[0])
    if check(len(b1hc) == 2, "detail: header band has 2 children")
        passed = passed + 1

    // 13. second child is a gap
    total = total + 1
    if check(prism_node.prism_node_kind_str(b1c[1]) == gap_kind, "detail: child[1] is gap")
        passed = passed + 1

    // 14. third child (detail text) is a label
    total = total + 1
    if check(prism_node.prism_node_kind_str(b1c[2]) == label_kind, "detail: child[2] is label")
        passed = passed + 1

    // 15. empty message errors
    total = total + 1
    if check(is_err(prism_ui_error.prism_eb_detail("", "detail text")), "detail: empty message -> err")
        passed = passed + 1

    // 16. empty detail errors
    total = total + 1
    if check(is_err(prism_ui_error.prism_eb_detail("msg", "")), "detail: empty detail -> err")
        passed = passed + 1

    // 17. both empty errors
    total = total + 1
    if check(is_err(prism_ui_error.prism_eb_detail("", "")), "detail: both empty -> err")
        passed = passed + 1

    print("=== prism_eb_retry ===")

    // 18. ok result
    total = total + 1
    let c1 = prism_ui_error.prism_eb_retry("Upload failed", "Retry")
    if check(is_ok(c1), "retry: valid args -> is_ok")
        passed = passed + 1

    let c1n = unwrap(c1)
    let c1c = prism_node.prism_node_children(c1n)

    // 19. stack kind
    total = total + 1
    if check(prism_node.prism_node_kind_str(c1n) == stack_kind, "retry: result kind is stack")
        passed = passed + 1

    // 20. stack has 3 children
    total = total + 1
    if check(len(c1c) == 3, "retry: stack has 3 children")
        passed = passed + 1

    // 21. header is band
    total = total + 1
    if check(prism_node.prism_node_kind_str(c1c[0]) == band_kind, "retry: child[0] is band (header)")
        passed = passed + 1

    // 22. header band has 2 children
    total = total + 1
    let c1hc = prism_node.prism_node_children(c1c[0])
    if check(len(c1hc) == 2, "retry: header band has 2 children")
        passed = passed + 1

    // 23. second child is gap
    total = total + 1
    if check(prism_node.prism_node_kind_str(c1c[1]) == gap_kind, "retry: child[1] is gap")
        passed = passed + 1

    // 24. third child is press (button)
    total = total + 1
    if check(prism_node.prism_node_kind_str(c1c[2]) == press_kind, "retry: child[2] is press button")
        passed = passed + 1

    // 25. button has 1 child (label)
    total = total + 1
    let c1bc = prism_node.prism_node_children(c1c[2])
    if check(len(c1bc) == 1, "retry: button has 1 child")
        passed = passed + 1

    // 26. empty message errors
    total = total + 1
    if check(is_err(prism_ui_error.prism_eb_retry("", "Retry")), "retry: empty message -> err")
        passed = passed + 1

    // 27. empty retry_label errors
    total = total + 1
    if check(is_err(prism_ui_error.prism_eb_retry("Upload failed", "")), "retry: empty retry_label -> err")
        passed = passed + 1

    // 28. both empty errors
    total = total + 1
    if check(is_err(prism_ui_error.prism_eb_retry("", "")), "retry: both empty -> err")
        passed = passed + 1

    print("=== prism_eb_not_found (with back_label) ===")

    // 29. ok result
    total = total + 1
    let d1 = prism_ui_error.prism_eb_not_found("Page does not exist", "Go back")
    if check(is_ok(d1), "not_found+back: valid args -> is_ok")
        passed = passed + 1

    let d1n = unwrap(d1)
    let d1c = prism_node.prism_node_children(d1n)

    // 30. stack kind
    total = total + 1
    if check(prism_node.prism_node_kind_str(d1n) == stack_kind, "not_found+back: result kind is stack")
        passed = passed + 1

    // 31. 5 children
    total = total + 1
    if check(len(d1c) == 5, "not_found+back: stack has 5 children")
        passed = passed + 1

    // 32. child[0] code is label
    total = total + 1
    if check(prism_node.prism_node_kind_str(d1c[0]) == label_kind, "not_found+back: child[0] is label (404)")
        passed = passed + 1

    // 33. child[1] gap
    total = total + 1
    if check(prism_node.prism_node_kind_str(d1c[1]) == gap_kind, "not_found+back: child[1] is gap")
        passed = passed + 1

    // 34. child[2] message label
    total = total + 1
    if check(prism_node.prism_node_kind_str(d1c[2]) == label_kind, "not_found+back: child[2] is label (message)")
        passed = passed + 1

    // 35. child[3] gap2
    total = total + 1
    if check(prism_node.prism_node_kind_str(d1c[3]) == gap_kind, "not_found+back: child[3] is gap")
        passed = passed + 1

    // 36. child[4] button
    total = total + 1
    if check(prism_node.prism_node_kind_str(d1c[4]) == press_kind, "not_found+back: child[4] is press button")
        passed = passed + 1

    // 37. button has 1 child
    total = total + 1
    let d1bc = prism_node.prism_node_children(d1c[4])
    if check(len(d1bc) == 1, "not_found+back: button has 1 child")
        passed = passed + 1

    // 38. empty message errors even with back_label present
    total = total + 1
    if check(is_err(prism_ui_error.prism_eb_not_found("", "Go back")), "not_found+back: empty message -> err")
        passed = passed + 1

    print("=== prism_eb_not_found (without back_label) ===")

    // 39. ok result
    total = total + 1
    let d2 = prism_ui_error.prism_eb_not_found("Page does not exist", "")
    if check(is_ok(d2), "not_found: valid message, empty back_label -> is_ok")
        passed = passed + 1

    let d2n = unwrap(d2)
    let d2c = prism_node.prism_node_children(d2n)

    // 40. 3 children
    total = total + 1
    if check(len(d2c) == 3, "not_found: stack has 3 children (no button)")
        passed = passed + 1

    // 41. child[0] label
    total = total + 1
    if check(prism_node.prism_node_kind_str(d2c[0]) == label_kind, "not_found: child[0] is label (404)")
        passed = passed + 1

    // 42. child[1] gap
    total = total + 1
    if check(prism_node.prism_node_kind_str(d2c[1]) == gap_kind, "not_found: child[1] is gap")
        passed = passed + 1

    // 43. child[2] label
    total = total + 1
    if check(prism_node.prism_node_kind_str(d2c[2]) == label_kind, "not_found: child[2] is label (message)")
        passed = passed + 1

    // 44. empty message + empty back_label -> err
    total = total + 1
    if check(is_err(prism_ui_error.prism_eb_not_found("", "")), "not_found: empty message + empty back_label -> err")
        passed = passed + 1

    print("=== prism_eb_maintenance ===")

    // 45. ok result
    total = total + 1
    let e1 = prism_ui_error.prism_eb_maintenance("Scheduled Maintenance", "Back online at 3pm UTC")
    if check(is_ok(e1), "maintenance: valid args -> is_ok")
        passed = passed + 1

    let e1n = unwrap(e1)
    let e1c = prism_node.prism_node_children(e1n)

    // 46. stack kind
    total = total + 1
    if check(prism_node.prism_node_kind_str(e1n) == stack_kind, "maintenance: result kind is stack")
        passed = passed + 1

    // 47. 3 children
    total = total + 1
    if check(len(e1c) == 3, "maintenance: stack has 3 children")
        passed = passed + 1

    // 48. child[0] title label
    total = total + 1
    if check(prism_node.prism_node_kind_str(e1c[0]) == label_kind, "maintenance: child[0] is label (title)")
        passed = passed + 1

    // 49. child[1] gap
    total = total + 1
    if check(prism_node.prism_node_kind_str(e1c[1]) == gap_kind, "maintenance: child[1] is gap")
        passed = passed + 1

    // 50. child[2] message label
    total = total + 1
    if check(prism_node.prism_node_kind_str(e1c[2]) == label_kind, "maintenance: child[2] is label (message)")
        passed = passed + 1

    // 51. empty title errors
    total = total + 1
    if check(is_err(prism_ui_error.prism_eb_maintenance("", "Back online at 3pm UTC")), "maintenance: empty title -> err")
        passed = passed + 1

    // 52. empty message errors
    total = total + 1
    if check(is_err(prism_ui_error.prism_eb_maintenance("Scheduled Maintenance", "")), "maintenance: empty message -> err")
        passed = passed + 1

    // 53. both empty errors
    total = total + 1
    if check(is_err(prism_ui_error.prism_eb_maintenance("", "")), "maintenance: both empty -> err")
        passed = passed + 1

    print("")
    print("RESULT: " + str(passed) + "/" + str(total) + " PASSED")
    if passed == total
        print("STATUS: ALL PASS")
    else
        print("STATUS: FAIL")
