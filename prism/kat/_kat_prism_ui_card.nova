// KAT for prism/ui/prism_ui_card.nova -- the `ui/` composition layer's card/panel family: basic
// title+body card, header/body/footer card, image card (with/without description), clickable
// card, card group with separators.
//
// Proves, against concrete expected values (every depth/count is hand-computed from
// prism_node.nova's own `depth = 1 + max(child depths)`, `count = 1 + sum(child counts)` rule for
// a branch node, and `depth = 1, count = 1` for a leaf -- never guessed):
//   1. prism_cd_card: exact stack(d=3,c=6) over a 2-line body, a 1-line body (d=3,c=5), a 3-line
//      body (d=3,c=7), and a body containing a NESTED stack (d=4,c=7, proving "any PrismNode" is
//      accepted as content, not just plain labels); rejects an empty title, empty content, and a
//      non-PrismNode content element named by index and type (3 rejections).
//   2. prism_cd_full: exact stack(d=3,c=7) over header/body/footer labels, a 2-line body variant
//      (d=3,c=8), and a header/footer that are themselves composite nodes (d=3,c=9, same "any
//      PrismNode" proof applied to header/footer); rejects an empty content list and a
//      non-PrismNode content element named by index and type (2 rejections).
//   3. prism_cd_image: exact stack(d=2,c=4) with a description, stack(d=2,c=3) without one; the
//      art child's `alt` attr round-trips through the dict_merge/prism_node_new re-construction
//      this file's header documents as the fix for `prism_art` having no `alt` parameter; rejects
//      an empty image_src, empty image_alt, and empty title (3 rejections).
//   4. prism_cd_clickable: exact press(d=3,c=4) wrapping a stack(d=2,c=3) body, exact accessible
//      `text` attr, exact title/description text inside the wrapped body; rejects an empty title
//      and an empty description (2 rejections).
//   5. prism_cd_group: exact stack(d=2,c=6) over 3 cards + 2 gaps, a single-card group with NO gap
//      inserted (d=2,c=2), a 2-card group with exactly 1 gap (d=2,c=4), and a mixed group with a
//      nested composite card (d=3,c=5, same "any PrismNode" proof); rejects an empty card list, a
//      zero gap_px, a negative gap_px, and a non-PrismNode card named by index and type (4
//      rejections).
//   6. Rejection tally: at least 8 distinct rejections proven above (14, counted explicitly).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_card` resolve.
//   ./gen3_test.exe _kat_prism_ui_card.nova
//   clang -O2 -o _kat_prism_ui_card.exe _kat_prism_ui_card.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_card.exe

import prism_node
import prism_arrange
import prism_content
import prism_ui_card as cd

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    // ── 1. prism_cd_card: stack(d=3,c=6)/(d=3,c=5)/(d=3,c=7)/(d=4,c=7 nested), 3 rejections ─────
    let l1 = unwrap(prism_content.prism_label("Line 1"))
    let l2 = unwrap(prism_content.prism_label("Line 2"))
    let card_r = cd.prism_cd_card("Widget Title", [l1, l2])
    _check_true("card(2 lines) constructs", is_ok(card_r))
    let card_node = unwrap(card_r)
    _check("card(2 lines) kind_str", prism_node.prism_node_kind_str(card_node), "stack")
    _check("card(2 lines) depth", str(prism_node.prism_node_depth(card_node)), "3")
    _check("card(2 lines) count", str(prism_node.prism_node_count(card_node)), "6")
    let c_kids = prism_node.prism_node_children(card_node)
    _check("card(2 lines) child count", str(len(c_kids)), "3")
    _check("card(2 lines) title kind_str", prism_node.prism_node_kind_str(c_kids[0]), "label")
    _check("card(2 lines) title text", prism_node.prism_node_attr_str(c_kids[0], "text", ""), "Widget Title")
    _check("card(2 lines) gap kind_str", prism_node.prism_node_kind_str(c_kids[1]), "gap")
    _check("card(2 lines) gap size is 8 (fixed)", str(prism_node.prism_node_attr_int(c_kids[1], "size", -1)), "8")
    _check_true("card(2 lines) gap is not flexible", not prism_node.prism_node_attr_bool(c_kids[1], "flexible", true))
    _check("card(2 lines) body kind_str", prism_node.prism_node_kind_str(c_kids[2]), "stack")
    _check("card(2 lines) body depth", str(prism_node.prism_node_depth(c_kids[2])), "2")
    _check("card(2 lines) body count", str(prism_node.prism_node_count(c_kids[2])), "3")
    let c_body_kids = prism_node.prism_node_children(c_kids[2])
    _check("card(2 lines) body child count", str(len(c_body_kids)), "2")
    _check("card(2 lines) body line0 text", prism_node.prism_node_attr_str(c_body_kids[0], "text", ""), "Line 1")
    _check("card(2 lines) body line1 text", prism_node.prism_node_attr_str(c_body_kids[1], "text", ""), "Line 2")

    // Single-line body (edge: exactly 1 content item).
    let l_only = unwrap(prism_content.prism_label("Only line"))
    let card1_node = unwrap(cd.prism_cd_card("Solo", [l_only]))
    _check("card(1 line) count", str(prism_node.prism_node_count(card1_node)), "5")
    let c1_kids = prism_node.prism_node_children(card1_node)
    _check("card(1 line) child count", str(len(c1_kids)), "3")
    _check("card(1 line) body depth", str(prism_node.prism_node_depth(c1_kids[2])), "2")
    _check("card(1 line) body count", str(prism_node.prism_node_count(c1_kids[2])), "2")
    _check("card(1 line) body child count", str(len(prism_node.prism_node_children(c1_kids[2]))), "1")

    // Three-line body (edge: more than 2 content items).
    let l3a = unwrap(prism_content.prism_label("A"))
    let l3b = unwrap(prism_content.prism_label("B"))
    let l3c = unwrap(prism_content.prism_label("C"))
    let card3_node = unwrap(cd.prism_cd_card("Triple", [l3a, l3b, l3c]))
    _check("card(3 lines) depth", str(prism_node.prism_node_depth(card3_node)), "3")
    _check("card(3 lines) count", str(prism_node.prism_node_count(card3_node)), "7")
    _check("card(3 lines) body count", str(prism_node.prism_node_count(prism_node.prism_node_children(card3_node)[2])), "4")

    // Nested content (a stack inside the card body) proves "any PrismNode" is accepted, not just
    // plain labels -- same proof style as _kat_prism_ui_rating.nova's mixed review_list.
    let nested_a = unwrap(prism_content.prism_label("Nested A"))
    let nested_b = unwrap(prism_content.prism_label("Nested B"))
    let nested_stack = unwrap(prism_arrange.prism_stack([nested_a, nested_b]))
    let card_nested_node = unwrap(cd.prism_cd_card("Nested Card", [nested_stack]))
    _check("card(nested) kind_str", prism_node.prism_node_kind_str(card_nested_node), "stack")
    _check("card(nested) depth", str(prism_node.prism_node_depth(card_nested_node)), "4")
    _check("card(nested) count", str(prism_node.prism_node_count(card_nested_node)), "7")
    let cn_body = prism_node.prism_node_children(card_nested_node)[2]
    _check("card(nested) body depth", str(prism_node.prism_node_depth(cn_body)), "3")
    _check("card(nested) body count", str(prism_node.prism_node_count(cn_body)), "4")
    let cn_inner = prism_node.prism_node_children(cn_body)[0]
    _check("card(nested) inner kind_str (nested stack, not label)", prism_node.prism_node_kind_str(cn_inner), "stack")
    _check("card(nested) inner depth", str(prism_node.prism_node_depth(cn_inner)), "2")
    _check("card(nested) inner count", str(prism_node.prism_node_count(cn_inner)), "3")

    let card_empty_title_r = cd.prism_cd_card("", [l1])
    _check_true("card rejects an empty title", is_err(card_empty_title_r))
    let card_empty_content_r = cd.prism_cd_card("Title", [])
    _check_true("card rejects empty content", is_err(card_empty_content_r))
    let card_bad_elem_r = cd.prism_cd_card("Title", [l1, 5])
    _check_true("card rejects a non-PrismNode child", is_err(card_bad_elem_r))
    if is_err(card_bad_elem_r)
        _check_true("card rejection names index 1 and type int", contains(unwrap_err(card_bad_elem_r), "1") and contains(unwrap_err(card_bad_elem_r), "int"))
    print("")

    // ── 2. prism_cd_full: stack(d=3,c=7)/(d=3,c=8)/(d=3,c=9 composite header), 2 rejections ─────
    let header = unwrap(prism_content.prism_label("Header"))
    let footer = unwrap(prism_content.prism_label("Footer"))
    let body_line = unwrap(prism_content.prism_label("Body"))
    let full_r = cd.prism_cd_full(header, [body_line], footer)
    _check_true("full constructs", is_ok(full_r))
    let full_node = unwrap(full_r)
    _check("full kind_str", prism_node.prism_node_kind_str(full_node), "stack")
    _check("full depth", str(prism_node.prism_node_depth(full_node)), "3")
    _check("full count", str(prism_node.prism_node_count(full_node)), "7")
    let f_kids = prism_node.prism_node_children(full_node)
    _check("full child count", str(len(f_kids)), "5")
    _check("full header text", prism_node.prism_node_attr_str(f_kids[0], "text", ""), "Header")
    _check("full gap0 kind_str", prism_node.prism_node_kind_str(f_kids[1]), "gap")
    _check("full gap0 size is 8", str(prism_node.prism_node_attr_int(f_kids[1], "size", -1)), "8")
    _check("full body kind_str", prism_node.prism_node_kind_str(f_kids[2]), "stack")
    _check("full body depth", str(prism_node.prism_node_depth(f_kids[2])), "2")
    _check("full body count", str(prism_node.prism_node_count(f_kids[2])), "2")
    _check("full body line text", prism_node.prism_node_attr_str(prism_node.prism_node_children(f_kids[2])[0], "text", ""), "Body")
    _check("full gap1 kind_str", prism_node.prism_node_kind_str(f_kids[3]), "gap")
    _check("full footer text", prism_node.prism_node_attr_str(f_kids[4], "text", ""), "Footer")

    // Two-line body (edge: more than 1 content item).
    let body_line2 = unwrap(prism_content.prism_label("Body2"))
    let full2_node = unwrap(cd.prism_cd_full(header, [body_line, body_line2], footer))
    _check("full(2 lines) depth", str(prism_node.prism_node_depth(full2_node)), "3")
    _check("full(2 lines) count", str(prism_node.prism_node_count(full2_node)), "8")

    // Composite header/footer (not plain labels) proves "any PrismNode" is accepted here too.
    let h1 = unwrap(prism_content.prism_label("H1"))
    let h2 = unwrap(prism_content.prism_label("H2"))
    let composite_header = unwrap(prism_arrange.prism_stack([h1, h2]))
    let full3_node = unwrap(cd.prism_cd_full(composite_header, [body_line], footer))
    _check("full(composite header) kind_str", prism_node.prism_node_kind_str(full3_node), "stack")
    _check("full(composite header) depth", str(prism_node.prism_node_depth(full3_node)), "3")
    _check("full(composite header) count", str(prism_node.prism_node_count(full3_node)), "9")
    let f3_header = prism_node.prism_node_children(full3_node)[0]
    _check("full(composite header) header kind_str (stack, not label)", prism_node.prism_node_kind_str(f3_header), "stack")
    _check("full(composite header) header child count", str(len(prism_node.prism_node_children(f3_header))), "2")

    let full_empty_content_r = cd.prism_cd_full(header, [], footer)
    _check_true("full rejects empty content", is_err(full_empty_content_r))
    let full_bad_elem_r = cd.prism_cd_full(header, [body_line, "bad"], footer)
    _check_true("full rejects a non-PrismNode content element", is_err(full_bad_elem_r))
    if is_err(full_bad_elem_r)
        _check_true("full rejection names index 1 and type string", contains(unwrap_err(full_bad_elem_r), "1") and contains(unwrap_err(full_bad_elem_r), "string"))
    print("")

    // ── 3. prism_cd_image: stack(d=2,c=4) with description, stack(d=2,c=3) without, alt round-
    //      trips through the dict_merge fix, 3 rejections ──────────────────────────────────────
    let image_r = cd.prism_cd_image("/img/a.png", "Alt text for a", "Widget", "A great widget")
    _check_true("image(with description) constructs", is_ok(image_r))
    let image_node = unwrap(image_r)
    _check("image kind_str", prism_node.prism_node_kind_str(image_node), "stack")
    _check("image depth", str(prism_node.prism_node_depth(image_node)), "2")
    _check("image count", str(prism_node.prism_node_count(image_node)), "4")
    let i_kids = prism_node.prism_node_children(image_node)
    _check("image child count", str(len(i_kids)), "3")
    _check("image art kind_str", prism_node.prism_node_kind_str(i_kids[0]), "art")
    _check("image art depth (leaf, unaffected by extra attr)", str(prism_node.prism_node_depth(i_kids[0])), "1")
    _check("image art count (leaf, unaffected by extra attr)", str(prism_node.prism_node_count(i_kids[0])), "1")
    _check("image art source", prism_node.prism_node_attr_str(i_kids[0], "source", ""), "/img/a.png")
    _check("image art alt (round-tripped via dict_merge fix)", prism_node.prism_node_attr_str(i_kids[0], "alt", ""), "Alt text for a")
    _check("image title kind_str", prism_node.prism_node_kind_str(i_kids[1]), "label")
    _check("image title text", prism_node.prism_node_attr_str(i_kids[1], "text", ""), "Widget")
    _check("image description text", prism_node.prism_node_attr_str(i_kids[2], "text", ""), "A great widget")

    let image_nodesc_r = cd.prism_cd_image("/img/b.png", "Alt B", "Card B", "")
    _check_true("image(no description) constructs", is_ok(image_nodesc_r))
    let image_nodesc_node = unwrap(image_nodesc_r)
    _check("image(no description) count", str(prism_node.prism_node_count(image_nodesc_node)), "3")
    let ind_kids = prism_node.prism_node_children(image_nodesc_node)
    _check("image(no description) child count", str(len(ind_kids)), "2")
    _check("image(no description) art source", prism_node.prism_node_attr_str(ind_kids[0], "source", ""), "/img/b.png")
    _check("image(no description) title text", prism_node.prism_node_attr_str(ind_kids[1], "text", ""), "Card B")

    let image_empty_src_r = cd.prism_cd_image("", "Alt", "Title", "Desc")
    _check_true("image rejects an empty image_src", is_err(image_empty_src_r))
    let image_empty_alt_r = cd.prism_cd_image("/img/c.png", "", "Title", "Desc")
    _check_true("image rejects an empty image_alt", is_err(image_empty_alt_r))
    let image_empty_title_r = cd.prism_cd_image("/img/c.png", "Alt", "", "Desc")
    _check_true("image rejects an empty title", is_err(image_empty_title_r))
    print("")

    // ── 4. prism_cd_clickable: press(d=3,c=4) wrapping stack(d=2,c=3), 2 rejections ─────────────
    let click_r = cd.prism_cd_clickable("Click me", "Does a thing")
    _check_true("clickable constructs", is_ok(click_r))
    let click_node = unwrap(click_r)
    _check("clickable kind_str", prism_node.prism_node_kind_str(click_node), "press")
    _check("clickable depth", str(prism_node.prism_node_depth(click_node)), "3")
    _check("clickable count", str(prism_node.prism_node_count(click_node)), "4")
    _check("clickable accessible text attr", prism_node.prism_node_attr_str(click_node, "text", ""), "Click me")
    let ck_kids = prism_node.prism_node_children(click_node)
    _check("clickable child count (wraps exactly 1 body)", str(len(ck_kids)), "1")
    _check("clickable body kind_str", prism_node.prism_node_kind_str(ck_kids[0]), "stack")
    _check("clickable body depth", str(prism_node.prism_node_depth(ck_kids[0])), "2")
    _check("clickable body count", str(prism_node.prism_node_count(ck_kids[0])), "3")
    let ck_body_kids = prism_node.prism_node_children(ck_kids[0])
    _check("clickable body title text", prism_node.prism_node_attr_str(ck_body_kids[0], "text", ""), "Click me")
    _check("clickable body description text", prism_node.prism_node_attr_str(ck_body_kids[1], "text", ""), "Does a thing")

    let click_empty_title_r = cd.prism_cd_clickable("", "Desc")
    _check_true("clickable rejects an empty title", is_err(click_empty_title_r))
    let click_empty_desc_r = cd.prism_cd_clickable("Title", "")
    _check_true("clickable rejects an empty description", is_err(click_empty_desc_r))
    print("")

    // ── 5. prism_cd_group: stack(d=2,c=6)/(d=2,c=2 solo)/(d=2,c=4)/(d=3,c=5 mixed), 4 rejections ─
    let ga = unwrap(prism_content.prism_label("A"))
    let gb = unwrap(prism_content.prism_label("B"))
    let gc = unwrap(prism_content.prism_label("C"))
    let group_r = cd.prism_cd_group([ga, gb, gc], 12)
    _check_true("group(3 cards) constructs", is_ok(group_r))
    let group_node = unwrap(group_r)
    _check("group(3 cards) kind_str", prism_node.prism_node_kind_str(group_node), "stack")
    _check("group(3 cards) depth", str(prism_node.prism_node_depth(group_node)), "2")
    _check("group(3 cards) count", str(prism_node.prism_node_count(group_node)), "6")
    let g_kids = prism_node.prism_node_children(group_node)
    _check("group(3 cards) child count (3 cards + 2 gaps)", str(len(g_kids)), "5")
    _check("group(3 cards) card0 text", prism_node.prism_node_attr_str(g_kids[0], "text", ""), "A")
    _check("group(3 cards) gap0 kind_str", prism_node.prism_node_kind_str(g_kids[1]), "gap")
    _check("group(3 cards) gap0 size is 12", str(prism_node.prism_node_attr_int(g_kids[1], "size", -1)), "12")
    _check("group(3 cards) card1 text", prism_node.prism_node_attr_str(g_kids[2], "text", ""), "B")
    _check("group(3 cards) gap1 kind_str", prism_node.prism_node_kind_str(g_kids[3]), "gap")
    _check("group(3 cards) card2 text", prism_node.prism_node_attr_str(g_kids[4], "text", ""), "C")

    // Single-card group (edge: NO gap inserted at all).
    let solo = unwrap(prism_content.prism_label("Solo"))
    let group_solo_node = unwrap(cd.prism_cd_group([solo], 5))
    _check("group(1 card) depth", str(prism_node.prism_node_depth(group_solo_node)), "2")
    _check("group(1 card) count", str(prism_node.prism_node_count(group_solo_node)), "2")
    let gs_kids = prism_node.prism_node_children(group_solo_node)
    _check("group(1 card) child count (no gap)", str(len(gs_kids)), "1")
    _check("group(1 card) card0 text", prism_node.prism_node_attr_str(gs_kids[0], "text", ""), "Solo")

    // Two-card group (edge: exactly 1 gap).
    let gx = unwrap(prism_content.prism_label("X"))
    let gy = unwrap(prism_content.prism_label("Y"))
    let group2_node = unwrap(cd.prism_cd_group([gx, gy], 20))
    _check("group(2 cards) count", str(prism_node.prism_node_count(group2_node)), "4")
    let g2_kids = prism_node.prism_node_children(group2_node)
    _check("group(2 cards) child count (2 cards + 1 gap)", str(len(g2_kids)), "3")
    _check("group(2 cards) gap size is 20", str(prism_node.prism_node_attr_int(g2_kids[1], "size", -1)), "20")

    // Mixed group (a nested composite card) proves "any PrismNode" is accepted here too.
    let mixed_a = unwrap(prism_content.prism_label("A2"))
    let mixed_n1 = unwrap(prism_content.prism_label("n1"))
    let mixed_nested = unwrap(prism_arrange.prism_stack([mixed_n1]))
    let group_mixed_node = unwrap(cd.prism_cd_group([mixed_a, mixed_nested], 7))
    _check("group(mixed) kind_str", prism_node.prism_node_kind_str(group_mixed_node), "stack")
    _check("group(mixed) depth", str(prism_node.prism_node_depth(group_mixed_node)), "3")
    _check("group(mixed) count", str(prism_node.prism_node_count(group_mixed_node)), "5")
    let gm_kids = prism_node.prism_node_children(group_mixed_node)
    _check("group(mixed) child count (2 cards + 1 gap)", str(len(gm_kids)), "3")
    _check("group(mixed) card1 kind_str (nested stack, not label)", prism_node.prism_node_kind_str(gm_kids[2]), "stack")
    _check("group(mixed) card1 depth", str(prism_node.prism_node_depth(gm_kids[2])), "2")
    _check("group(mixed) card1 count", str(prism_node.prism_node_count(gm_kids[2])), "2")

    let group_empty_r = cd.prism_cd_group([], 8)
    _check_true("group rejects an empty card list", is_err(group_empty_r))
    let group_zero_gap_r = cd.prism_cd_group([ga], 0)
    _check_true("group rejects gap_px == 0", is_err(group_zero_gap_r))
    let group_neg_gap_r = cd.prism_cd_group([ga], -3)
    _check_true("group rejects gap_px < 0", is_err(group_neg_gap_r))
    let group_bad_elem_r = cd.prism_cd_group([ga, 42], 8)
    _check_true("group rejects a non-PrismNode card", is_err(group_bad_elem_r))
    if is_err(group_bad_elem_r)
        _check_true("group rejection names index 1 and type int", contains(unwrap_err(group_bad_elem_r), "1") and contains(unwrap_err(group_bad_elem_r), "int"))
    print("")

    // ── 6. Rejection tally: at least 8 distinct rejections proven above (14, counted here) ──────
    // card: empty title, empty content, non-PrismNode child (3); full: empty content,
    // non-PrismNode element (2); image: empty src, empty alt, empty title (3); clickable: empty
    // title, empty description (2); group: empty list, gap_px==0, gap_px<0, non-PrismNode card (4)
    let rejection_count = 14
    _check_true("expected at least 8 rejection cases, counted " + str(rejection_count), rejection_count >= 8)

    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_card: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_card: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
