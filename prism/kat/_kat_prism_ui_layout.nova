// KAT for prism/ui/prism_ui_layout.nova (PRISM_ROADMAP.md milestone MB.3, the `ui/` composition
// layer's layout components: app shell, split, drawer, grid layout, toolbar).
//
// Proves, against concrete expected values:
//   1. Split: all 4 ratios build a mesh(d=2,c=3) with EXACT, DISTINCT column weight pairs
//      (half=[1,1], third=[1,2], quarter=[1,3], golden=[382,618]); rejects panes.len() of
//      0/1/3, and two structurally-identical-but-separately-built panes.
//   2. Drawer: all 4 edges round-trip through the "drawer_edge" attr on an otherwise-constant
//      sheet(d=2,c=2) shape; exclusive true/false both survive untouched.
//   3. Shell: 4 combinations (neither/sidebar-only/footer-only/both optional slots) each with an
//      EXACT distinct depth/count; header is proven to never become a "pane", content always is.
//   4. Grid: exact mesh(d=2,c=7,cols=3) for a 3-track/6-child grid; rejects zero tracks, a
//      children count that does not divide evenly by the track count, and propagates (unchanged)
//      prism_mesh's own non-positive-fixed-width rejection.
//   5. Toolbar: two distinct group configurations with EXACT distinct depth/count; always
//      exactly 3 children; rejects all three groups empty AND a non-PrismNode group element.
//   6. Nested composition: a shell containing a split containing a toolbar builds with an EXACT
//      depth=6/count=11, proving the whole file composes without drift.
//   7. Rejection tally: >= 8 distinct rejections (9 counted explicitly).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_layout` resolve.
//   ./gen3_test.exe _kat_prism_ui_layout.nova
//   clang -O2 -o _kat_prism_ui_layout.exe _kat_prism_ui_layout.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_layout.exe

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_ui_layout

fn _fail(msg: string)
    print("FAIL " + msg)
    exit(1)

fn main()
    // ── 1. Split: 4 ratios, exact mesh(d=2,c=3), distinct weight pairs; 4 rejections ─────────
    let left = unwrap(prism_content.prism_label("Left"))
    let right = unwrap(prism_content.prism_label("Right"))

    let half_r = prism_ui_layout.prism_split([left, right], prism_ui_layout.prism_split_ratio_half())
    if is_err(half_r)
        _fail("prism_split (half): " + unwrap_err(half_r))
    let half_node = unwrap(half_r)
    assert_eq(prism_node.prism_node_kind_str(half_node), "mesh")
    assert_eq(prism_node.prism_node_depth(half_node), 2)
    assert_eq(prism_node.prism_node_count(half_node), 3)
    assert_eq(prism_arrange.prism_mesh_col_count(half_node), 2)
    let half_cols = prism_arrange.prism_mesh_cols(half_node)
    assert_eq(prism_arrange.prism_mesh_track_size(half_cols[0]), 1)
    assert_eq(prism_arrange.prism_mesh_track_size(half_cols[1]), 1)

    let third_node = unwrap(prism_ui_layout.prism_split([left, right], prism_ui_layout.prism_split_ratio_third()))
    let third_cols = prism_arrange.prism_mesh_cols(third_node)
    assert_eq(prism_arrange.prism_mesh_track_size(third_cols[0]), 1)
    assert_eq(prism_arrange.prism_mesh_track_size(third_cols[1]), 2)

    let quarter_node = unwrap(prism_ui_layout.prism_split([left, right], prism_ui_layout.prism_split_ratio_quarter()))
    let quarter_cols = prism_arrange.prism_mesh_cols(quarter_node)
    assert_eq(prism_arrange.prism_mesh_track_size(quarter_cols[0]), 1)
    assert_eq(prism_arrange.prism_mesh_track_size(quarter_cols[1]), 3)

    let golden_node = unwrap(prism_ui_layout.prism_split([left, right], prism_ui_layout.prism_split_ratio_golden()))
    let golden_cols = prism_arrange.prism_mesh_cols(golden_node)
    assert_eq(prism_arrange.prism_mesh_track_size(golden_cols[0]), 382)
    assert_eq(prism_arrange.prism_mesh_track_size(golden_cols[1]), 618)

    // All 4 ratios share the identical d=2/c=3 tree shape -- distinctness lives ONLY in the
    // column weights, which is exactly what was just proven above for third/quarter/golden.
    assert_eq(prism_node.prism_node_depth(third_node), 2)
    assert_eq(prism_node.prism_node_count(third_node), 3)
    assert_eq(prism_node.prism_node_depth(quarter_node), 2)
    assert_eq(prism_node.prism_node_count(quarter_node), 3)
    assert_eq(prism_node.prism_node_depth(golden_node), 2)
    assert_eq(prism_node.prism_node_count(golden_node), 3)
    print("1a. split: all 4 ratios build mesh(d=2,c=3) with 4 DISTINCT column weight pairs (half=[1,1], third=[1,2], quarter=[1,3], golden=[382,618]): OK")

    let split_empty_r = prism_ui_layout.prism_split([], prism_ui_layout.prism_split_ratio_half())
    if is_ok(split_empty_r)
        _fail("prism_split should reject 0 panes, but construction succeeded")
    let split_one_r = prism_ui_layout.prism_split([left], prism_ui_layout.prism_split_ratio_half())
    if is_ok(split_one_r)
        _fail("prism_split should reject 1 pane, but construction succeeded")
    let split_three_r = prism_ui_layout.prism_split([left, right, left], prism_ui_layout.prism_split_ratio_half())
    if is_ok(split_three_r)
        _fail("prism_split should reject 3 panes, but construction succeeded")
    // Two SEPARATELY built (not the same variable) but structurally identical panes -- proves
    // this is real structural equality, not reference identity.
    let same_a = unwrap(prism_content.prism_label("Same"))
    let same_b = unwrap(prism_content.prism_label("Same"))
    let split_identical_r = prism_ui_layout.prism_split([same_a, same_b], prism_ui_layout.prism_split_ratio_half())
    if is_ok(split_identical_r)
        _fail("prism_split should reject two structurally identical panes, but construction succeeded")
    print("1b. split: rejects panes.len() of 0/1/3 and two structurally-identical (separately built) panes: OK -- " + unwrap_err(split_empty_r) + " / " + unwrap_err(split_one_r) + " / " + unwrap_err(split_three_r) + " / " + unwrap_err(split_identical_r))

    // ── 2. Drawer: 4 edges round-trip on a constant sheet(d=2,c=2); exclusive survives ───────
    let panel = unwrap(prism_content.prism_label("Panel content"))
    let edges = [prism_ui_layout.prism_drawer_edge_left(), prism_ui_layout.prism_drawer_edge_right(), prism_ui_layout.prism_drawer_edge_top(), prism_ui_layout.prism_drawer_edge_bottom()]
    let edge_names = []
    for e in edges
        let d_r = prism_ui_layout.prism_drawer(panel, e, true)
        if is_err(d_r)
            _fail("prism_drawer: " + unwrap_err(d_r))
        let d_node = unwrap(d_r)
        assert_eq(prism_node.prism_node_kind_str(d_node), "sheet")
        assert_eq(prism_node.prism_node_attr_bool(d_node, "exclusive", false), true)
        assert_eq(prism_node.prism_node_depth(d_node), 2)
        assert_eq(prism_node.prism_node_count(d_node), 2)
        edge_names.push(prism_ui_layout.prism_drawer_edge(d_node))
    assert_eq(edge_names[0], "left")
    assert_eq(edge_names[1], "right")
    assert_eq(edge_names[2], "top")
    assert_eq(edge_names[3], "bottom")
    let seen_edges = {}
    for nm in edge_names
        if nm in seen_edges
            _fail("drawer edge '" + nm + "' is reused -- must be distinct")
        seen_edges[nm] = true

    let d_excl_false = unwrap(prism_ui_layout.prism_drawer(panel, prism_ui_layout.prism_drawer_edge_left(), false))
    assert_eq(prism_node.prism_node_attr_bool(d_excl_false, "exclusive", true), false)
    print("2. drawer: all 4 edges round-trip distinctly on a constant sheet(d=2,c=2), exclusive true/false both survive: OK")

    // ── 3. Shell: 4 combinations, exact distinct depth/count; header never paned ─────────────
    let header = unwrap(prism_content.prism_label("Header"))
    let content = unwrap(prism_content.prism_label("Content"))
    let sidebar = unwrap(prism_content.prism_label("Sidebar"))
    let footer = unwrap(prism_content.prism_label("Footer"))

    let shell_a = unwrap(prism_ui_layout.prism_shell(header, none(), content, none()))
    assert_eq(prism_node.prism_node_kind_str(shell_a), "stack")
    assert_eq(prism_node.prism_node_depth(shell_a), 3)
    assert_eq(prism_node.prism_node_count(shell_a), 4)
    let shell_a_kids = prism_node.prism_node_children(shell_a)
    assert_eq(prism_node.prism_node_kind_str(shell_a_kids[0]), "label")
    assert_eq(prism_node.prism_node_attr_str(shell_a_kids[0], "text", ""), "Header")
    assert_eq(prism_node.prism_node_kind_str(shell_a_kids[1]), "pane")
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(shell_a_kids[1])[0], "text", ""), "Content")

    let shell_b = unwrap(prism_ui_layout.prism_shell(header, some(sidebar), content, none()))
    assert_eq(prism_node.prism_node_depth(shell_b), 4)
    assert_eq(prism_node.prism_node_count(shell_b), 6)
    let shell_b_body = prism_node.prism_node_children(shell_b)[1]
    assert_eq(prism_node.prism_node_kind_str(shell_b_body), "band")
    assert_eq(prism_node.prism_node_kind_str(prism_node.prism_node_children(shell_b_body)[1]), "pane")

    let shell_c = unwrap(prism_ui_layout.prism_shell(header, none(), content, some(footer)))
    assert_eq(prism_node.prism_node_depth(shell_c), 3)
    assert_eq(prism_node.prism_node_count(shell_c), 5)
    let shell_c_kids = prism_node.prism_node_children(shell_c)
    assert_eq(prism_node.prism_node_kind_str(shell_c_kids[2]), "label")
    assert_eq(prism_node.prism_node_attr_str(shell_c_kids[2], "text", ""), "Footer")

    let shell_d = unwrap(prism_ui_layout.prism_shell(header, some(sidebar), content, some(footer)))
    assert_eq(prism_node.prism_node_depth(shell_d), 4)
    assert_eq(prism_node.prism_node_count(shell_d), 7)
    print("3. shell: 4 combinations with EXACT distinct depth/count (d3c4/d4c6/d3c5/d4c7), header stays a plain label (never paned), content is always wrapped in pane: OK")

    // ── 4. Grid: exact mesh(d=2,c=7,cols=3); 3 rejections ────────────────────────────────────
    let tracks3 = [prism_arrange.prism_track_fixed(100), prism_arrange.prism_track_fill(), prism_arrange.prism_track_fit()]
    let cells = []
    for i in 0..6
        cells.push(unwrap(prism_content.prism_label("C" + str(i))))
    let grid_r = prism_ui_layout.prism_grid_layout(tracks3, cells)
    if is_err(grid_r)
        _fail("prism_grid_layout: " + unwrap_err(grid_r))
    let grid_node = unwrap(grid_r)
    assert_eq(prism_node.prism_node_kind_str(grid_node), "mesh")
    assert_eq(prism_node.prism_node_depth(grid_node), 2)
    assert_eq(prism_node.prism_node_count(grid_node), 7)
    assert_eq(prism_arrange.prism_mesh_col_count(grid_node), 3)

    let grid_zero_tracks_r = prism_ui_layout.prism_grid_layout([], cells)
    if is_ok(grid_zero_tracks_r)
        _fail("prism_grid_layout should reject zero tracks, but construction succeeded")
    // 4 children over 3 tracks: 4 % 3 == 1 != 0 -- genuinely does not divide evenly.
    let uneven_cells = [cells[0], cells[1], cells[2], cells[3]]
    let grid_uneven_r = prism_ui_layout.prism_grid_layout(tracks3, uneven_cells)
    if is_ok(grid_uneven_r)
        _fail("prism_grid_layout should reject 4 children over 3 tracks (not divisible), but construction succeeded")
    // A non-positive Fixed track width: prism_mesh's OWN validation rejects this, and
    // prism_grid_layout propagates that Result unchanged rather than duplicating the check.
    let bad_tracks = [prism_arrange.prism_track_fixed(0), prism_arrange.prism_track_fill()]
    let bad_cells = [cells[0], cells[1]]
    let grid_bad_track_r = prism_ui_layout.prism_grid_layout(bad_tracks, bad_cells)
    if is_ok(grid_bad_track_r)
        _fail("prism_grid_layout should propagate prism_mesh's rejection of a non-positive Fixed track width, but construction succeeded")
    print("4. grid: exact mesh(d=2,c=7,cols=3) for 3 tracks x 6 children; rejects zero tracks, a non-divisible child count (4 over 3), and propagates prism_mesh's non-positive-fixed-width rejection: OK -- " + unwrap_err(grid_zero_tracks_r) + " / " + unwrap_err(grid_uneven_r) + " / " + unwrap_err(grid_bad_track_r))

    // ── 5. Toolbar: 2 distinct configurations; always 3 children; 2 rejections ──────────────
    let check_glyph = unwrap(prism_content.prism_glyph(prism_content.prism_icon_check()))
    let save_btn = unwrap(prism_interact.prism_press("Save", []))
    let toolbar_a = unwrap(prism_ui_layout.prism_toolbar([check_glyph], [], [save_btn]))
    assert_eq(prism_node.prism_node_kind_str(toolbar_a), "band")
    assert_eq(prism_node.prism_node_depth(toolbar_a), 3)
    assert_eq(prism_node.prism_node_count(toolbar_a), 6)
    let toolbar_a_kids = prism_node.prism_node_children(toolbar_a)
    assert_eq(len(toolbar_a_kids), 3)
    assert_eq(prism_node.prism_node_kind_str(toolbar_a_kids[0]), "band")
    assert_eq(prism_node.prism_node_kind_str(prism_node.prism_node_children(toolbar_a_kids[0])[0]), "glyph")
    assert_eq(prism_node.prism_node_child_count(toolbar_a_kids[1]), 0)
    assert_eq(prism_node.prism_node_kind_str(prism_node.prism_node_children(toolbar_a_kids[2])[0]), "press")

    let title_label = unwrap(prism_content.prism_label("Title"))
    let toolbar_b = unwrap(prism_ui_layout.prism_toolbar([], [title_label], []))
    assert_eq(prism_node.prism_node_depth(toolbar_b), 3)
    assert_eq(prism_node.prism_node_count(toolbar_b), 5)
    print("5a. toolbar: 2 distinct configurations, EXACT depth/count (d3c6 leading+trailing, d3c5 centre-only), always exactly 3 children: OK")

    let toolbar_empty_r = prism_ui_layout.prism_toolbar([], [], [])
    if is_ok(toolbar_empty_r)
        _fail("prism_toolbar should reject all three groups empty, but construction succeeded")
    let toolbar_bad_elem_r = prism_ui_layout.prism_toolbar([42], [], [])
    if is_ok(toolbar_bad_elem_r)
        _fail("prism_toolbar should reject a non-PrismNode group element, but construction succeeded")
    print("5b. toolbar: rejects all-three-empty and a non-PrismNode group element (propagated from prism_node_new): OK -- " + unwrap_err(toolbar_empty_r) + " / " + unwrap_err(toolbar_bad_elem_r))

    // ── 6. Nested composition: shell(split(toolbar, pane)) -- exact d=6/c=11 ─────────────────
    let nested_toolbar = unwrap(prism_ui_layout.prism_toolbar([check_glyph], [], [save_btn]))
    let second_pane_label = unwrap(prism_content.prism_label("SecondPane"))
    let nested_split = unwrap(prism_ui_layout.prism_split([nested_toolbar, second_pane_label], prism_ui_layout.prism_split_ratio_half()))
    let nested_shell = unwrap(prism_ui_layout.prism_shell(header, none(), nested_split, none()))
    assert_eq(prism_node.prism_node_kind_str(nested_shell), "stack")
    assert_eq(prism_node.prism_node_depth(nested_shell), 6)
    assert_eq(prism_node.prism_node_count(nested_shell), 11)
    print("6. nested composition shell(split(toolbar, label)) builds with EXACT depth=6/count=11: OK")

    // ── 7. Rejection tally: >= 8 distinct rejections proven above (9 counted here) ──────────
    let rejection_count = 9
    if rejection_count < 8
        _fail("expected at least 8 rejection cases, counted " + str(rejection_count))
    print("7. rejection tally: 9 distinct rejections proven (split count 0/1/3 + identical panes = 4, grid zero-tracks + non-divisible children + non-positive-fixed = 3, toolbar all-empty + bad-element = 2) -- >= 8 required: OK")

    print("KAT prism_ui_layout PASSED: split (4 distinct ratios + 4 rejections), drawer (4 distinct edges), shell (4 distinct combinations, header/pane boundary proven), grid (exact mesh + 3 rejections), toolbar (2 distinct configs + 2 rejections), nested composition exact depth/count")
