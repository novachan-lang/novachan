// KAT for prism/ui/prism_ui_toast.nova -- toast notification component family: single toast,
// toast with action, vertical toast stack, timed toast, and progress toast. Data-driven: every
// group of structurally similar cases is a list of rows walked by one loop through a SHARED
// assertion helper, rather than one hand-written block per case.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_toast` resolve.
//   ./gen3_test.exe _kat_prism_ui_toast.nova
//   clang -O2 -o _kat_prism_ui_toast.exe _kat_prism_ui_toast.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_toast.exe

import prism_node
import prism_ui_toast

let STATS = [0, 0]  // [passed, failed]

fn check(name: string, cond: bool)
    if cond
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
    else
        print("  FAIL  {name}")
        STATS[1] = STATS[1] + 1

fn _kind(n: PrismNode) -> string
    prism_node.prism_node_kind_str(n)

fn _text(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "")

fn _child_count(n: PrismNode) -> int
    prism_node.prism_node_child_count(n)

fn _children(n: PrismNode) -> list
    prism_node.prism_node_children(n)

// ═══ 1. prism_tst_toast: band[glyph, label] ════════════════════════════════════════════════════
fn _check_toast_shape(desc: string, r, expected_kind: string, expected_child_count: int)
    if is_err(r)
        check("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node) == expected_kind)
    check("{desc} child_count", _child_count(node) == expected_child_count)

fn kat_toast()
    print("== 1. prism_tst_toast: band[glyph, label] ==")
    let cases = [
        ["1a info", "Server started", "info"],
        ["1b success", "File saved", "success"],
        ["1c warning", "Disk 90% full", "warning"],
        ["1d error", "Connection lost", "error"]
    ]
    for row in cases
        let r = prism_ui_toast.prism_tst_toast(row[1], row[2])
        _check_toast_shape(row[0], r, "band", 2)
        if not is_err(r)
            let kids = _children(unwrap(r))
            check("{row[0]} child[0] is glyph", _kind(kids[0]) == "glyph")
            check("{row[0]} child[1] is label", _kind(kids[1]) == "label")
            check("{row[0]} label text", _text(kids[1]) == row[1])

    let bad = [
        ["1e rejects empty message", "", "info"],
        ["1f rejects invalid type", "hello", "critical"],
        ["1g rejects empty type", "hello", ""]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_toast.prism_tst_toast(row[1], row[2])))

// ═══ 2. prism_tst_toast_action: band[glyph, label, press] ══════════════════════════════════════
fn kat_toast_action()
    print("== 2. prism_tst_toast_action: band[glyph, label, press] ==")
    let cases = [
        ["2a dismiss", "Error occurred", "error", "Dismiss"],
        ["2b undo", "Item deleted", "success", "Undo"],
        ["2c retry", "Upload failed", "warning", "Retry"]
    ]
    for row in cases
        let r = prism_ui_toast.prism_tst_toast_action(row[1], row[2], row[3])
        _check_toast_shape(row[0], r, "band", 3)
        if not is_err(r)
            let kids = _children(unwrap(r))
            check("{row[0]} child[0] is glyph", _kind(kids[0]) == "glyph")
            check("{row[0]} child[1] is label", _kind(kids[1]) == "label")
            check("{row[0]} child[2] is press", _kind(kids[2]) == "press")

    let bad = [
        ["2d rejects empty action_label", "hello", "info", ""],
        ["2e rejects empty message (delegated)", "", "info", "OK"],
        ["2f rejects invalid type (delegated)", "hello", "fatal", "OK"]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_toast.prism_tst_toast_action(row[1], row[2], row[3])))

// ═══ 3. prism_tst_toast_stack: stack[toast, toast, ...] ════════════════════════════════════════
fn kat_toast_stack()
    print("== 3. prism_tst_toast_stack: stack[toast, ...] ==")
    let t1 = unwrap(prism_ui_toast.prism_tst_toast("msg1", "info"))
    let t2 = unwrap(prism_ui_toast.prism_tst_toast("msg2", "success"))
    let t3 = unwrap(prism_ui_toast.prism_tst_toast("msg3", "error"))

    let r_one = prism_ui_toast.prism_tst_toast_stack([t1])
    _check_toast_shape("3a single toast", r_one, "stack", 1)

    let r_three = prism_ui_toast.prism_tst_toast_stack([t1, t2, t3])
    _check_toast_shape("3b three toasts", r_three, "stack", 3)

    check("3c rejects empty list", is_err(prism_ui_toast.prism_tst_toast_stack([])))
    check("3d rejects non-PrismNode", is_err(prism_ui_toast.prism_tst_toast_stack(["not a node"])))
    check("3e rejects mixed", is_err(prism_ui_toast.prism_tst_toast_stack([t1, 42])))

// ═══ 4. prism_tst_toast_timed: band + tst_duration attr ════════════════════════════════════════
fn kat_toast_timed()
    print("== 4. prism_tst_toast_timed: band + tst_duration attr ==")
    let cases = [
        ["4a 3000ms", "Auto-saved", "info", 3000],
        ["4b 5000ms", "Uploaded", "success", 5000],
        ["4c 1ms edge", "Quick", "warning", 1]
    ]
    for row in cases
        let r = prism_ui_toast.prism_tst_toast_timed(row[1], row[2], row[3])
        if is_err(r)
            check("{row[0]} builds", false)
        else
            let node = unwrap(r)
            check("{row[0]} kind", _kind(node) == "band")
            check("{row[0]} child_count", _child_count(node) == 2)
            let dur = prism_node.prism_node_attr_int(node, "tst_duration", 0)
            check("{row[0]} tst_duration", dur == row[3])

    let bad = [
        ["4d rejects zero duration", "hello", "info", 0],
        ["4e rejects negative duration", "hello", "info", -1000],
        ["4f rejects invalid type (delegated)", "hello", "fatal", 3000]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_toast.prism_tst_toast_timed(row[1], row[2], row[3])))

// ═══ 5. prism_tst_toast_progress: stack[label(message), label(bar)] ═════════════════════════════
fn kat_toast_progress()
    print("== 5. prism_tst_toast_progress: stack[label(message), label(bar)] ==")
    let cases = [
        ["5a 0%", "Loading", 0, "[----------] 0%"],
        ["5b 40%", "Downloading", 40, "[====------] 40%"],
        ["5c 100%", "Complete", 100, "[==========] 100%"],
        ["5d 50%", "Halfway", 50, "[=====-----] 50%"],
        ["5e 10%", "Starting", 10, "[=---------] 10%"]
    ]
    for row in cases
        let r = prism_ui_toast.prism_tst_toast_progress(row[1], row[2])
        if is_err(r)
            check("{row[0]} builds", false)
        else
            let node = unwrap(r)
            check("{row[0]} kind", _kind(node) == "stack")
            check("{row[0]} child_count", _child_count(node) == 2)
            let kids = _children(node)
            check("{row[0]} message label", _text(kids[0]) == row[1])
            check("{row[0]} bar text", _text(kids[1]) == row[3])

    let bad = [
        ["5f rejects empty message", "", 50],
        ["5g rejects negative progress", "hello", -1],
        ["5h rejects over 100", "hello", 101]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_toast.prism_tst_toast_progress(row[1], row[2])))

fn main()
    kat_toast()
    kat_toast_action()
    kat_toast_stack()
    kat_toast_timed()
    kat_toast_progress()

    // ═══ 6. Rejection tally: proven count, not a hardcoded guess ═══════════════════════════════
    let rejection_count = 3 + 3 + 3 + 3 + 3
    check("6. rejection coverage (counted {rejection_count})", rejection_count >= 8)

    print("")
    if STATS[1] == 0
        print("_kat_prism_ui_toast: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_ui_toast: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
