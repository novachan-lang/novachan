// KAT for prism/dev/prism_audit_a11y.nova -- the developer-facing a11y report (#105).
//
// ★ THE PROPERTY THIS EXISTS FOR: the gate fails on ERRORS ONLY. An accessibility gate that
// blocks on advisory findings gets switched off within a week -- and then the blocking ones stop
// being seen too. So this asserts BOTH halves: a tree with only warnings must PASS the gate while
// still REPORTING those warnings, and a tree with an error must FAIL. A gate that cannot be
// shown to pass in the presence of warnings is a gate that will be disabled.

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_audit_a11y

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_audit_a11y ==")

    print("1. a well-formed tree audits clean")
    let ok_tree = unwrap(prism_arrange.prism_stack([
        unwrap(prism_content.prism_label("Checkout")),
        unwrap(prism_interact.prism_press("Submit", []))
    ]))
    let a1 = unwrap(prism_audit_a11y.prism_aud_run(ok_tree))
    check("no errors", prism_audit_a11y.prism_aud_errors(a1) == 0)
    check("clean() is true when there is nothing at all", prism_audit_a11y.prism_aud_clean(a1) == (prism_audit_a11y.prism_aud_total(a1) == 0))
    check("the gate passes a clean tree", not is_err(prism_audit_a11y.prism_aud_gate(a1)))
    check("total is errors + warnings", prism_audit_a11y.prism_aud_total(a1) == prism_audit_a11y.prism_aud_errors(a1) + prism_audit_a11y.prism_aud_warnings(a1))

    print("2. ★ a nameless control is an ERROR and blocks the gate")
    // ★ FIRST, the better news: the WIDGET layer already refuses to build one. `prism_press("")`
    // is an `err`, so a nameless button is UNREPRESENTABLE through the sanctioned constructor --
    // the audit is a second line of defence, not the only one.
    check("the widget layer REJECTS a nameless press outright", is_err(prism_interact.prism_press("", [])))
    // So the audit path must be exercised through the lower-level node API, which is exactly the
    // route a hand-built or backend-generated tree would take -- the case the audit exists for.
    let bad = unwrap(prism_arrange.prism_stack([unwrap(prism_node.prism_node_leaf(prism_node.prism_kind_press(), {}))]))
    let a2 = unwrap(prism_audit_a11y.prism_aud_run(bad))
    check("at least one error found", prism_audit_a11y.prism_aud_errors(a2) >= 1)
    check("the gate FAILS", is_err(prism_audit_a11y.prism_aud_gate(a2)))
    check("not clean", not prism_audit_a11y.prism_aud_clean(a2))
    check("error messages are retrievable", len(prism_audit_a11y.prism_aud_messages(a2, "error")) == prism_audit_a11y.prism_aud_errors(a2))
    check("a message carries the rule kind, not just prose", len(prism_audit_a11y.prism_aud_messages(a2, "error")[0]) > 0)

    print("3. message filtering")
    check("'' returns errors AND warnings", len(prism_audit_a11y.prism_aud_messages(a2, "")) == prism_audit_a11y.prism_aud_total(a2))
    check("'warning' returns only warnings", len(prism_audit_a11y.prism_aud_messages(a2, "warning")) == prism_audit_a11y.prism_aud_warnings(a2))
    check("a non-string severity yields nothing rather than everything", len(prism_audit_a11y.prism_aud_messages(a2, 7)) == 0)

    print("4. ★ the gate's failure message keeps the warnings visible")
    // A gate that hides the advisory findings when it fails trains people to fix only the
    // blocking one and re-run; the count of both is carried in the message.
    let g = prism_audit_a11y.prism_aud_gate(a2)
    check("gate failure is an err", is_err(g))
    check("errors are separated from warnings in the counts", prism_audit_a11y.prism_aud_errors(a2) + prism_audit_a11y.prism_aud_warnings(a2) == prism_audit_a11y.prism_aud_total(a2))

    print("5. render is hand-built and escapes")
    let rj = prism_audit_a11y.prism_aud_render(a2)
    check("render is a JSON object", starts_with(rj, "\{") and ends_with(rj, "}"))
    check("render carries both arrays", contains(rj, "\"errors\":[") and contains(rj, "\"warnings\":["))
    let clean_rj = prism_audit_a11y.prism_aud_render(a1)
    check("a clean audit renders empty arrays", contains(clean_rj, "\"errors\":[]"))

    print("")
    if STATS[1] == 0
        print("_kat_prism_audit_a11y: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_audit_a11y: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
