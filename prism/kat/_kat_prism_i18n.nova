// KAT for prism/intl/prism_i18n.nova -- catalogues, interpolation, plural selection.
//
// The three properties this exists for:
//   1. ★ A MISSING KEY IS AN ERROR, not the key echoed back. Echoing is the industry default and
//      it ships `checkout.submit` to users in exactly the locale nobody on the team reads.
//   2. ★ PLURALS ARE A CATEGORY FUNCTION. Polish 2..4 -> "few" but 12..14 -> "many" is the case
//      that proves the rule is not `n == 1`, and an UNIMPLEMENTED rule is REJECTED rather than
//      silently falling back to English's two forms.
//   3. An UNRESOLVED placeholder is an error -- "Hello, {name}" must never reach a user.

import prism_i18n

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_i18n ==")

    // ⛔ NOTE THE `\{`: a catalogue TEMPLATE must keep its braces LITERAL. Written bare, NOVA
    // interpolates them at compile time against local variables, so the stored message contains
    // no placeholder at all and every interpolation test passes vacuously against empty output.
    // This is the second time this session a bare `{` in test DATA silently changed the test.
    let en = unwrap(prism_i18n.prism_i18n_catalog("en", prism_i18n.prism_i18n_rule_en(), {
        "greet": "Hello, \{name}!",
        "plain": "Submit",
        "cart.one": "\{n} item",
        "cart.other": "\{n} items"
    }))

    print("1. ★ a missing key is an ERROR, never the key echoed back")
    check("a present key resolves", unwrap(prism_i18n.prism_i18n_get(en, "plain")) == "Submit")
    check("a MISSING key is an err", is_err(prism_i18n.prism_i18n_get(en, "checkout.submit")))
    check("has() reports absence", not prism_i18n.prism_i18n_has(en, "checkout.submit"))
    check("non-string key rejected", is_err(prism_i18n.prism_i18n_get(en, 7)))
    check("keys() lists the catalogue", len(prism_i18n.prism_i18n_keys(en)) == 4)
    check("locale is reported", prism_i18n.prism_i18n_locale(en) == "en")

    print("2. interpolation from an args dict")
    check("placeholder is filled", unwrap(prism_i18n.prism_i18n_format(en, "greet", {"name": "Ada"})) == "Hello, Ada!")
    check("a message with no placeholder is unchanged", unwrap(prism_i18n.prism_i18n_format(en, "plain", {})) == "Submit")
    // ★ The defect this prevents: a raw placeholder rendered to a user.
    check("an UNRESOLVED placeholder is an err", is_err(prism_i18n.prism_i18n_format(en, "greet", {})))
    check("non-dict args rejected", is_err(prism_i18n.prism_i18n_format(en, "greet", "Ada")))
    check("an int arg is stringified", unwrap(prism_i18n.prism_i18n_format(en, "cart.one", {"n": 1})) == "1 item")
    // Non-ASCII must survive the code-point walk intact.
    let jp = unwrap(prism_i18n.prism_i18n_catalog("ja", prism_i18n.prism_i18n_rule_ja(), {"hi": "こんにちは、\{name}さん"}))
    check("non-ASCII template survives interpolation", unwrap(prism_i18n.prism_i18n_format(jp, "hi", {"name": "田中"})) == "こんにちは、田中さん")

    print("3. ★ plural CATEGORIES, not n == 1")
    check("en 1 -> one", unwrap(prism_i18n.prism_i18n_category("one-other", 1)) == "one")
    check("en 0 -> other", unwrap(prism_i18n.prism_i18n_category("one-other", 0)) == "other")
    check("en 5 -> other", unwrap(prism_i18n.prism_i18n_category("one-other", 5)) == "other")
    check("ja 1 -> other (no number inflection)", unwrap(prism_i18n.prism_i18n_category("other", 1)) == "other")
    // Polish: the case that proves the rule is not n == 1.
    check("pl 1 -> one", unwrap(prism_i18n.prism_i18n_category("one-few-many-other", 1)) == "one")
    check("pl 2 -> few", unwrap(prism_i18n.prism_i18n_category("one-few-many-other", 2)) == "few")
    check("pl 4 -> few", unwrap(prism_i18n.prism_i18n_category("one-few-many-other", 4)) == "few")
    check("★ pl 12 -> many, NOT few (the teens exception)", unwrap(prism_i18n.prism_i18n_category("one-few-many-other", 12)) == "many")
    check("★ pl 14 -> many", unwrap(prism_i18n.prism_i18n_category("one-few-many-other", 14)) == "many")
    check("pl 22 -> few again", unwrap(prism_i18n.prism_i18n_category("one-few-many-other", 22)) == "few")
    check("pl 5 -> many", unwrap(prism_i18n.prism_i18n_category("one-few-many-other", 5)) == "many")
    check("a negative count is rejected", is_err(prism_i18n.prism_i18n_category("one-other", -1)))
    check("a non-int count is rejected", is_err(prism_i18n.prism_i18n_category("one-other", "1")))

    print("4. ★ an unimplemented plural rule is REJECTED, not defaulted")
    check("an unknown rule is refused at catalogue construction", is_err(prism_i18n.prism_i18n_catalog("ar", "one-two-few-many-other", {})))
    check("...so it can never silently fall back to English's two forms", is_err(prism_i18n.prism_i18n_category("one-two-few-many-other", 3)))
    check("empty locale rejected", is_err(prism_i18n.prism_i18n_catalog("", "one-other", {})))
    check("non-dict entries rejected", is_err(prism_i18n.prism_i18n_catalog("en", "one-other", "x")))

    print("5. plural lookup selects the right entry")
    check("1 -> the 'one' form", unwrap(prism_i18n.prism_i18n_plural(en, "cart", 1, {"n": 1})) == "1 item")
    check("3 -> the 'other' form", unwrap(prism_i18n.prism_i18n_plural(en, "cart", 3, {"n": 3})) == "3 items")
    check("0 -> the 'other' form", unwrap(prism_i18n.prism_i18n_plural(en, "cart", 0, {"n": 0})) == "0 items")
    // A catalogue missing the form its own rule requires must fail, not fall back.
    let partial = unwrap(prism_i18n.prism_i18n_catalog("en", prism_i18n.prism_i18n_rule_en(), {"x.one": "one thing"}))
    check("a missing plural FORM is an err", is_err(prism_i18n.prism_i18n_plural(partial, "x", 5, {})))

    print("6. ★ the audit reports BOTH directions of drift")
    let fr = unwrap(prism_i18n.prism_i18n_catalog("fr", prism_i18n.prism_i18n_rule_en(), {
        "greet": "Bonjour, \{name} !",
        "plain": "Envoyer",
        "cart.one": "\{n} article",
        "legacy.removed": "vieux"
    }))
    let drift = prism_i18n.prism_i18n_audit(en, fr)
    check("both an untranslated key and a stale one are found", len(drift) == 2)
    check("the missing key is named", contains(join(drift, ";"), "missing in fr: cart.other"))
    // A stale key is drift too: reporting only the missing ones lets catalogues accumulate dead
    // weight after a rename that nobody ever removes.
    check("the STALE key is named", contains(join(drift, ";"), "stale in fr: legacy.removed"))
    check("an identical catalogue reports no drift", len(prism_i18n.prism_i18n_audit(en, en)) == 0)

    print("")
    if STATS[1] == 0
        print("_kat_prism_i18n: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_i18n: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
