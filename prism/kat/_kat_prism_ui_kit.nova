// KAT for prism/ui/prism_ui_kit.nova -- the composition layer every ONE of the 67 ui/
// components is built from (MB.2). It had no dedicated KAT: exercised transitively by 40
// other KATs, but its OWN semantics -- the map-with-error-propagation contract above all --
// were only ever proven incidentally. A defect here is a defect in every component built on it.
//
// The properties this exists for:
//   1. ★ prism_ui_collect is the map-with-error-propagation primitive every other helper here
//      (and by extension every ui/ component) is built from. Verified against its OWN
//      maker-call-count, empirically (a throwaway probe, not guessed):
//        ["a","b","c"] all succeed   -> maker called 3 times, ok
//        ["FAIL","b","c"]            -> maker called 1 time,  err "boom" (never touches b/c)
//        ["a","FAIL","c"]            -> maker called 2 times, err "boom"
//        ["a","b","FAIL"]            -> maker called 3 times, err "boom"
//        []            (empty)       -> maker called 0 times, ok([]) -- NOT an error, no crash
//      The error message propagates UNCHANGED (not wrapped, not reworded) -- asserted exactly.
//      A callback that counts its own invocations cannot be an inline lambda (a NOVA lambda
//      body is a single EXPRESSION; an assignment statement followed by a conditional return
//      is not one), so the maker is a named top-level `mk` mutating a module-level `CALLS`
//      cell -- confirmed directly that a bare top-level `fn` (not `let`-bound) passes as a
//      first-class callback exactly like a lambda does (precedent: std/functional's KATs).
//   2. Every OTHER helper gets the same treatment: input order preserved on success, abort at
//      the right index on failure (proven by REASON where the private row-maker can't be
//      instrumented directly -- 3 different bad shapes at 3 different positions can only
//      surface the reason of the item actually reached), empty input is a SUCCESS -- except
//      prism_ui_actions, which explicitly REJECTS empty (a deliberate, asserted exception to
//      that rule) -- and every propagated error message survives byte-for-byte: prism_ui_labeled's
//      own message even contains a non-ASCII section-sign ("§13"), and prism_ui_spacer's
//      negative-size error is prism_gap's OWN text, unrehearsed by this file (a thin wrapper).
//   3. ★ At least one non-ASCII assertion per text-carrying helper (CJK + accented Latin) --
//      this project has a documented bug class where an ASCII-only test passes against a
//      completely broken string API.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_kit` resolve.
//   ./gen3_test.exe _kat_prism_ui_kit.nova
//   clang -O2 -o _kat_prism_ui_kit.exe _kat_prism_ui_kit.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_kit.exe

import prism_node
import prism_arrange
import prism_content
import prism_ui_kit

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

// The counting maker for prism_ui_collect's own abort-contract tests (section 1). A "FAIL"
// sentinel item makes it return an error; anything else becomes a label node.
let CALLS = [0]

fn mk(x) -> Result<any>
    CALLS[0] = CALLS[0] + 1
    if x == "FAIL"
        return err("boom")
    prism_content.prism_label(x)

fn main()
    print("== _kat_prism_ui_kit ==")

    print("1. ★ prism_ui_collect -- map-with-error-propagation, verified abort contract")
    CALLS[0] = 0
    let c1 = prism_ui_kit.prism_ui_collect(["a", "b", "c"], mk)
    check("★ all-succeed: is ok", is_ok(c1))
    check("★ all-succeed: maker called exactly 3 times", CALLS[0] == 3)
    let c1_list = unwrap(c1)
    check("all-succeed: result has 3 elements", len(c1_list) == 3)
    check("★ all-succeed: order preserved [0]=a", prism_node.prism_node_attr_str(c1_list[0], "text", "") == "a")
    check("★ all-succeed: order preserved [1]=b", prism_node.prism_node_attr_str(c1_list[1], "text", "") == "b")
    check("★ all-succeed: order preserved [2]=c", prism_node.prism_node_attr_str(c1_list[2], "text", "") == "c")

    CALLS[0] = 0
    let c2 = prism_ui_kit.prism_ui_collect(["FAIL", "b", "c"], mk)
    check("★ fail-at-0: is err", is_err(c2))
    check("★ fail-at-0: maker called exactly 1 time (never touches b or c)", CALLS[0] == 1)
    check("★ fail-at-0: message propagates UNCHANGED", unwrap_err(c2) == "boom")

    CALLS[0] = 0
    let c3 = prism_ui_kit.prism_ui_collect(["a", "FAIL", "c"], mk)
    check("★ fail-at-1: is err", is_err(c3))
    check("★ fail-at-1: maker called exactly 2 times", CALLS[0] == 2)
    check("★ fail-at-1: message unchanged", unwrap_err(c3) == "boom")

    CALLS[0] = 0
    let c4 = prism_ui_kit.prism_ui_collect(["a", "b", "FAIL"], mk)
    check("★ fail-at-2: is err", is_err(c4))
    check("★ fail-at-2: maker called exactly 3 times", CALLS[0] == 3)
    check("★ fail-at-2: message unchanged", unwrap_err(c4) == "boom")

    CALLS[0] = 0
    let c5 = prism_ui_kit.prism_ui_collect([], mk)
    check("★ empty input: is OK, not an error", is_ok(c5))
    check("★ empty input: maker never called", CALLS[0] == 0)
    let c5_list = unwrap(c5)
    check("empty input: result is an empty list, not a crash", len(c5_list) == 0)

    CALLS[0] = 0
    let c6 = prism_ui_kit.prism_ui_collect(["a", "請求書-héllo", "c"], mk)
    check("non-ASCII item: is ok", is_ok(c6))
    let c6_list = unwrap(c6)
    check("non-ASCII item: order preserved and text intact", prism_node.prism_node_attr_str(c6_list[1], "text", "") == "請求書-héllo")
    print("")

    print("2. prism_ui_labels -- strings -> label nodes; cannot itself fail (prism_label accepts any string)")
    let l1 = prism_ui_kit.prism_ui_labels(["x", "y", "z"])
    check("labels: is ok", is_ok(l1))
    let l1_list = unwrap(l1)
    check("labels: 3 elements", len(l1_list) == 3)
    check("labels: order preserved [0]", prism_node.prism_node_attr_str(l1_list[0], "text", "") == "x")
    check("labels: order preserved [1]", prism_node.prism_node_attr_str(l1_list[1], "text", "") == "y")
    check("labels: order preserved [2]", prism_node.prism_node_attr_str(l1_list[2], "text", "") == "z")
    check("labels: each is a label node", prism_node.prism_node_kind_str(l1_list[0]) == "label")

    let l2 = prism_ui_kit.prism_ui_labels([])
    check("★ labels: empty input is a success", is_ok(l2))
    let l2_list = unwrap(l2)
    check("labels: empty input yields an empty list", len(l2_list) == 0)

    let l3 = prism_ui_kit.prism_ui_labels(["héllo", "請求書-a"])
    let l3_list = unwrap(l3)
    check("non-ASCII: order+text preserved [0]", prism_node.prism_node_attr_str(l3_list[0], "text", "") == "héllo")
    check("non-ASCII: order+text preserved [1]", prism_node.prism_node_attr_str(l3_list[1], "text", "") == "請求書-a")
    print("")

    print("3. prism_ui_labeled -- label stacked above control, order preserved; rejects an empty label")
    let ctrl_a = unwrap(prism_content.prism_label("Alice"))
    let lab1 = prism_ui_kit.prism_ui_labeled("Name", ctrl_a)
    check("labeled: is ok", is_ok(lab1))
    let lab1_n = unwrap(lab1)
    check("labeled: kind is stack", prism_node.prism_node_kind_str(lab1_n) == "stack")
    let lab1_kids = prism_node.prism_node_children(lab1_n)
    check("labeled: exactly 2 children", len(lab1_kids) == 2)
    check("★ labeled: child[0] is the label, ABOVE the control", prism_node.prism_node_kind_str(lab1_kids[0]) == "label")
    check("labeled: child[0] text is the label text", prism_node.prism_node_attr_str(lab1_kids[0], "text", "") == "Name")
    check("labeled: child[1] is the control, unchanged", prism_node.prism_node_attr_str(lab1_kids[1], "text", "") == "Alice")

    let lab_empty = prism_ui_kit.prism_ui_labeled("", ctrl_a)
    check("★ labeled: rejects an empty label", is_err(lab_empty))
    check("★ labeled: rejection message is exact, including the non-ASCII section-sign", unwrap_err(lab_empty) == "prism_ui_labeled: label must not be empty -- an unlabelled control is invisible to a screen reader (PRISM_SPEC.md §13)")

    let lab_cjk = prism_ui_kit.prism_ui_labeled("請求書", ctrl_a)
    let lab_cjk_n = unwrap(lab_cjk)
    let lab_cjk_kids = prism_node.prism_node_children(lab_cjk_n)
    check("non-ASCII label text preserved", prism_node.prism_node_attr_str(lab_cjk_kids[0], "text", "") == "請求書")
    print("")

    print("4. prism_ui_field_row -- label+control, optional note; None and blank-Some both degrade to the SAME bare 2-child shape as prism_ui_labeled")
    let fr_none = prism_ui_kit.prism_ui_field_row("Email", ctrl_a, none())
    check("field_row (no note): is ok", is_ok(fr_none))
    let fr_none_n = unwrap(fr_none)
    check("field_row (no note): kind is stack", prism_node.prism_node_kind_str(fr_none_n) == "stack")
    let fr_none_kids = prism_node.prism_node_children(fr_none_n)
    check("★ field_row (no note): degrades to exactly 2 children, same as labeled", len(fr_none_kids) == 2)

    let fr_blank = prism_ui_kit.prism_ui_field_row("Email", ctrl_a, some(""))
    check("field_row (blank note, Some empty string): is ok", is_ok(fr_blank))
    let fr_blank_n = unwrap(fr_blank)
    let fr_blank_kids = prism_node.prism_node_children(fr_blank_n)
    check("★ field_row (blank note): ALSO degrades to exactly 2 children -- a blank note is not appended", len(fr_blank_kids) == 2)

    let fr_note = prism_ui_kit.prism_ui_field_row("Email", ctrl_a, some("must be a valid address"))
    check("field_row (with note): is ok", is_ok(fr_note))
    let fr_note_n = unwrap(fr_note)
    let fr_note_kids = prism_node.prism_node_children(fr_note_n)
    check("★ field_row (with note): 2 top-level children -- [labeled-block, note]", len(fr_note_kids) == 2)
    let fr_note_inner = fr_note_kids[0]
    check("field_row (with note): child[0] is the inner labeled block", prism_node.prism_node_kind_str(fr_note_inner) == "stack")
    let fr_note_inner_kids = prism_node.prism_node_children(fr_note_inner)
    check("field_row (with note): inner block still has label first", prism_node.prism_node_attr_str(fr_note_inner_kids[0], "text", "") == "Email")
    check("★ field_row (with note): note comes LAST, order preserved", prism_node.prism_node_attr_str(fr_note_kids[1], "text", "") == "must be a valid address")

    let fr_note_cjk = prism_ui_kit.prism_ui_field_row("Email", ctrl_a, some("請求書メモ"))
    let fr_note_cjk_n = unwrap(fr_note_cjk)
    let fr_note_cjk_kids = prism_node.prism_node_children(fr_note_cjk_n)
    check("non-ASCII note text preserved", prism_node.prism_node_attr_str(fr_note_cjk_kids[1], "text", "") == "請求書メモ")

    let fr_err = prism_ui_kit.prism_ui_field_row("", ctrl_a, none())
    check("★ field_row: propagates prism_ui_labeled's empty-label error", is_err(fr_err))
    check("★ field_row: propagated message is byte-identical to labeled's own", unwrap_err(fr_err) == "prism_ui_labeled: label must not be empty -- an unlabelled control is invisible to a screen reader (PRISM_SPEC.md §13)")
    print("")

    print("5. prism_ui_section -- titled block; rejects an empty title; an empty children list still succeeds")
    let s_c0 = unwrap(prism_content.prism_label("A"))
    let s_c1 = unwrap(prism_content.prism_label("B"))
    let s_c2 = unwrap(prism_content.prism_label("C"))
    let sec1 = prism_ui_kit.prism_ui_section("Settings", [s_c0, s_c1, s_c2])
    check("section: is ok", is_ok(sec1))
    let sec1_n = unwrap(sec1)
    check("section: kind is stack", prism_node.prism_node_kind_str(sec1_n) == "stack")
    let sec1_kids = prism_node.prism_node_children(sec1_n)
    check("section: exactly 2 top-level children [title, body]", len(sec1_kids) == 2)
    check("section: child[0] is the title label", prism_node.prism_node_attr_str(sec1_kids[0], "text", "") == "Settings")
    let sec1_body = sec1_kids[1]
    check("section: child[1] is the body", prism_node.prism_node_kind_str(sec1_body) == "stack")
    let sec1_body_kids = prism_node.prism_node_children(sec1_body)
    check("section: body has all 3 children", len(sec1_body_kids) == 3)
    check("★ section: body preserves input order [0]", prism_node.prism_node_attr_str(sec1_body_kids[0], "text", "") == "A")
    check("★ section: body preserves input order [1]", prism_node.prism_node_attr_str(sec1_body_kids[1], "text", "") == "B")
    check("★ section: body preserves input order [2]", prism_node.prism_node_attr_str(sec1_body_kids[2], "text", "") == "C")

    let sec_empty_title = prism_ui_kit.prism_ui_section("", [s_c0])
    check("★ section: rejects an empty title", is_err(sec_empty_title))
    check("section: rejection message is exact", unwrap_err(sec_empty_title) == "prism_ui_section: title must not be empty")

    let sec_empty_children = prism_ui_kit.prism_ui_section("Empty Section", [])
    check("★ section: an empty children list still SUCCEEDS (no children-emptiness guard)", is_ok(sec_empty_children))
    let sec_ec_n = unwrap(sec_empty_children)
    let sec_ec_kids = prism_node.prism_node_children(sec_ec_n)
    let sec_ec_body = sec_ec_kids[1]
    let sec_ec_body_kids = prism_node.prism_node_children(sec_ec_body)
    check("section: empty children list yields a body with 0 children, not an error", len(sec_ec_body_kids) == 0)

    let sec_cjk = prism_ui_kit.prism_ui_section("設定", [s_c0])
    let sec_cjk_n = unwrap(sec_cjk)
    let sec_cjk_kids = prism_node.prism_node_children(sec_cjk_n)
    check("non-ASCII title preserved", prism_node.prism_node_attr_str(sec_cjk_kids[0], "text", "") == "設定")
    print("")

    print("6. prism_ui_panel -- children wrapped in a scrollable pane (via an inner stack); no failure path")
    let pan1 = prism_ui_kit.prism_ui_panel([s_c0, s_c1])
    check("panel: is ok", is_ok(pan1))
    let pan1_n = unwrap(pan1)
    check("panel: kind is pane", prism_node.prism_node_kind_str(pan1_n) == "pane")
    let pan1_kids = prism_node.prism_node_children(pan1_n)
    check("★ panel: a pane has exactly 1 child (the inner stack), per prism_pane's singular contract", len(pan1_kids) == 1)
    let pan1_inner = pan1_kids[0]
    check("panel: the inner child is a stack", prism_node.prism_node_kind_str(pan1_inner) == "stack")
    let pan1_inner_kids = prism_node.prism_node_children(pan1_inner)
    check("panel: the inner stack holds both original children", len(pan1_inner_kids) == 2)
    check("★ panel: order preserved [0]", prism_node.prism_node_attr_str(pan1_inner_kids[0], "text", "") == "A")
    check("★ panel: order preserved [1]", prism_node.prism_node_attr_str(pan1_inner_kids[1], "text", "") == "B")

    let pan_empty = prism_ui_kit.prism_ui_panel([])
    check("★ panel: an empty children list still succeeds -- no failure path exists in this helper", is_ok(pan_empty))
    let pan_empty_n = unwrap(pan_empty)
    let pan_empty_kids = prism_node.prism_node_children(pan_empty_n)
    let pan_empty_inner = pan_empty_kids[0]
    let pan_empty_inner_kids = prism_node.prism_node_children(pan_empty_inner)
    check("panel: empty children yields an inner stack with 0 children", len(pan_empty_inner_kids) == 0)
    print("")

    print("7. ★ prism_ui_actions -- inline action bar, order preserved; UNLIKE collect, EMPTY IS REJECTED")
    let act_b0 = unwrap(prism_content.prism_label("OK"))
    let act_b1 = unwrap(prism_content.prism_label("Cancel"))
    let act_b2 = unwrap(prism_content.prism_label("Help"))
    let act1 = prism_ui_kit.prism_ui_actions([act_b0, act_b1, act_b2])
    check("actions: is ok", is_ok(act1))
    let act1_n = unwrap(act1)
    check("actions: kind is band", prism_node.prism_node_kind_str(act1_n) == "band")
    let act1_kids = prism_node.prism_node_children(act1_n)
    check("actions: all 3 buttons present", len(act1_kids) == 3)
    check("★ actions: order preserved [0]=OK", prism_node.prism_node_attr_str(act1_kids[0], "text", "") == "OK")
    check("★ actions: order preserved [1]=Cancel", prism_node.prism_node_attr_str(act1_kids[1], "text", "") == "Cancel")
    check("★ actions: order preserved [2]=Help", prism_node.prism_node_attr_str(act1_kids[2], "text", "") == "Help")

    let act_empty = prism_ui_kit.prism_ui_actions([])
    check("★ actions: rejects an EMPTY button list (a deliberate exception to collect's empty-is-ok rule)", is_err(act_empty))
    check("actions: rejection message is exact", unwrap_err(act_empty) == "prism_ui_actions: needs at least one action")
    print("")

    print("8. prism_ui_icon_text -- glyph + label, inline, FIXED order (icon always first); cannot itself fail")
    let it1 = prism_ui_kit.prism_ui_icon_text(prism_content.prism_icon_check(), "Done")
    check("icon_text: is ok", is_ok(it1))
    let it1_n = unwrap(it1)
    check("icon_text: kind is band", prism_node.prism_node_kind_str(it1_n) == "band")
    let it1_kids = prism_node.prism_node_children(it1_n)
    check("icon_text: exactly 2 children", len(it1_kids) == 2)
    check("★ icon_text: child[0] is the glyph", prism_node.prism_node_kind_str(it1_kids[0]) == "glyph")
    check("icon_text: glyph icon is 'check'", prism_node.prism_node_attr_str(it1_kids[0], "icon", "") == "check")
    check("★ icon_text: child[1] is the label, AFTER the glyph", prism_node.prism_node_kind_str(it1_kids[1]) == "label")
    check("icon_text: label text is exact", prism_node.prism_node_attr_str(it1_kids[1], "text", "") == "Done")

    let it2 = prism_ui_kit.prism_ui_icon_text(prism_content.prism_icon_info(), "情報")
    let it2_n = unwrap(it2)
    let it2_kids = prism_node.prism_node_children(it2_n)
    check("non-ASCII icon_text label preserved", prism_node.prism_node_attr_str(it2_kids[1], "text", "") == "情報")
    print("")

    print("9. ★ prism_ui_kv -- pairs -> rows via prism_ui_collect; order preserved; abort proven by REASON")
    let kv1 = prism_ui_kit.prism_ui_kv([["Name", "Alice"], ["Role", "Eng"], ["Team", "Platform"]])
    check("kv: is ok", is_ok(kv1))
    let kv1_n = unwrap(kv1)
    check("kv: kind is stack", prism_node.prism_node_kind_str(kv1_n) == "stack")
    let kv1_kids = prism_node.prism_node_children(kv1_n)
    check("kv: 3 rows", len(kv1_kids) == 3)
    let kv1_row0 = kv1_kids[0]
    check("kv: row is a band", prism_node.prism_node_kind_str(kv1_row0) == "band")
    let kv1_row0_kids = prism_node.prism_node_children(kv1_row0)
    check("★ kv: order preserved, row[0] key", prism_node.prism_node_attr_str(kv1_row0_kids[0], "text", "") == "Name")
    check("★ kv: order preserved, row[0] value", prism_node.prism_node_attr_str(kv1_row0_kids[1], "text", "") == "Alice")
    let kv1_row1 = kv1_kids[1]
    let kv1_row1_kids = prism_node.prism_node_children(kv1_row1)
    check("★ kv: order preserved, row[1] key", prism_node.prism_node_attr_str(kv1_row1_kids[0], "text", "") == "Role")
    let kv1_row2 = kv1_kids[2]
    let kv1_row2_kids = prism_node.prism_node_children(kv1_row2)
    check("★ kv: order preserved, row[2] key", prism_node.prism_node_attr_str(kv1_row2_kids[0], "text", "") == "Team")

    let kv_empty = prism_ui_kit.prism_ui_kv([])
    check("★ kv: an empty pairs list is a SUCCESS (no explicit empty guard, unlike actions)", is_ok(kv_empty))
    let kv_empty_n = unwrap(kv_empty)
    let kv_empty_kids = prism_node.prism_node_children(kv_empty_n)
    check("kv: empty pairs yields 0 rows", len(kv_empty_kids) == 0)

    // Abort proven positionally: bad shapes at 3 different indices, 3 DIFFERENT failure
    // reasons -- the returned message can only match the reason of the item actually reached,
    // proving collect neither stops early nor skips ahead.
    let kv_bad0 = prism_ui_kit.prism_ui_kv([42, ["only-one"]])
    check("★ kv: fails at index 0 -- message names index-0's OWN reason, not index-1's", is_err(kv_bad0))
    check("★ kv: message unchanged from the row-maker, no re-wording", unwrap_err(kv_bad0) == "prism_ui_kv: each pair must be a 2-element list, got int")

    let kv_bad1 = prism_ui_kit.prism_ui_kv([["Name", "Alice"], ["only-one"]])
    check("★ kv: index 0 succeeds silently, fails at index 1 with index-1's own reason", is_err(kv_bad1))
    check("kv: message matches index-1's reason exactly", unwrap_err(kv_bad1) == "prism_ui_kv: each pair must have exactly 2 elements, got 1")

    let kv_bad2 = prism_ui_kit.prism_ui_kv([["Name", "Alice"], ["Role", "Eng"], "oops"])
    check("★ kv: indices 0,1 succeed silently, fails at index 2 with index-2's own reason", is_err(kv_bad2))
    check("kv: message matches index-2's reason exactly", unwrap_err(kv_bad2) == "prism_ui_kv: each pair must be a 2-element list, got string")

    let kv_bad_types = prism_ui_kit.prism_ui_kv([[1, 2]])
    check("kv: rejects non-string elements", is_err(kv_bad_types))
    check("kv: non-string message is exact", unwrap_err(kv_bad_types) == "prism_ui_kv: both elements must be strings")

    let kv_cjk = prism_ui_kit.prism_ui_kv([["名前", "太郎"]])
    let kv_cjk_n = unwrap(kv_cjk)
    let kv_cjk_kids = prism_node.prism_node_children(kv_cjk_n)
    let kv_cjk_row0 = kv_cjk_kids[0]
    let kv_cjk_row0_kids = prism_node.prism_node_children(kv_cjk_row0)
    check("non-ASCII kv key preserved", prism_node.prism_node_attr_str(kv_cjk_row0_kids[0], "text", "") == "名前")
    check("non-ASCII kv value preserved", prism_node.prism_node_attr_str(kv_cjk_row0_kids[1], "text", "") == "太郎")
    print("")

    print("10. prism_ui_empty -- honest empty state (info glyph + message); rejects an empty message")
    let em1 = prism_ui_kit.prism_ui_empty("Nothing here yet")
    check("empty-state: is ok", is_ok(em1))
    let em1_n = unwrap(em1)
    check("empty-state: kind is band", prism_node.prism_node_kind_str(em1_n) == "band")
    let em1_kids = prism_node.prism_node_children(em1_n)
    check("empty-state: exactly 2 children", len(em1_kids) == 2)
    check("★ empty-state: child[0] is the info glyph", prism_node.prism_node_kind_str(em1_kids[0]) == "glyph")
    check("empty-state: glyph icon is 'info'", prism_node.prism_node_attr_str(em1_kids[0], "icon", "") == "info")
    check("empty-state: child[1] is the message label", prism_node.prism_node_attr_str(em1_kids[1], "text", "") == "Nothing here yet")

    let em_err = prism_ui_kit.prism_ui_empty("")
    check("★ empty-state: rejects an empty message", is_err(em_err))
    check("empty-state: rejection message is exact", unwrap_err(em_err) == "prism_ui_empty: message must not be empty -- a blank empty state is indistinguishable from a broken component")

    let em_cjk = prism_ui_kit.prism_ui_empty("データがありません")
    let em_cjk_n = unwrap(em_cjk)
    let em_cjk_kids = prism_node.prism_node_children(em_cjk_n)
    check("non-ASCII empty-state message preserved", prism_node.prism_node_attr_str(em_cjk_kids[1], "text", "") == "データがありません")
    print("")

    print("11. prism_ui_spacer -- thin wrapper over prism_gap; a negative size propagates prism_gap's OWN error")
    let sp1 = prism_ui_kit.prism_ui_spacer(8)
    check("spacer: is ok", is_ok(sp1))
    let sp1_n = unwrap(sp1)
    check("spacer: kind is gap", prism_node.prism_node_kind_str(sp1_n) == "gap")
    check("spacer: not flexible (a concrete size was given)", not prism_arrange.prism_gap_is_flexible(sp1_n))
    check("spacer: size is exactly 8", prism_arrange.prism_gap_size(sp1_n, -1) == 8)

    let sp0 = prism_ui_kit.prism_ui_spacer(0)
    check("spacer: a zero size is valid, not an error", is_ok(sp0))
    let sp0_n = unwrap(sp0)
    check("spacer: zero size round-trips", prism_arrange.prism_gap_size(sp0_n, -1) == 0)

    let sp_neg = prism_ui_kit.prism_ui_spacer(-1)
    check("★ spacer: a negative size is rejected", is_err(sp_neg))
    check("★ spacer: message is prism_gap's OWN text, byte-identical (thin wrapper, no rewording)", unwrap_err(sp_neg) == "prism_gap: size must be >= 0, got -1")
    print("")

    if STATS[1] == 0
        print("_kat_prism_ui_kit: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_ui_kit: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
