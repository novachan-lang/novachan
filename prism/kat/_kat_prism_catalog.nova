// KAT for prism/dev/prism_catalog.nova (milestone MA.7).
//
// MA.7's exit criterion: "every primitive appears in a generated catalogue page with no
// hand-written story files." The coverage assertion below IS that criterion, mechanized -- it is
// what replaces Storybook's per-component story modules. Adding primitive #23 to PrismNodeKind
// without adding a catalog example turns this test red by NAME, instead of producing a catalog
// page that quietly omits it.
//
// Also asserts the catalog renders through BOTH real backends (it has no private rendering path,
// so it cannot drift from what applications get), which makes it an end-to-end exercise of all 22
// primitives through the full stack.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME = the nova-compiler/ root, NOVA_NO_CACHE=1):
//   ./gen3_test.exe _kat_prism_catalog.nova
//   clang -O2 -o _kat_prism_catalog.exe _kat_prism_catalog.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32

import prism_node
import prism_catalog as cat

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    print("== 1. the vocabulary enumerates completely ==")
    let kinds = prism_node.prism_node_kind_all()
    _check("22 kinds enumerated", str(len(kinds)), "22")
    // Every name distinct and non-empty. This is what converts a silent omission from
    // prism_node_kind_all() into a loud failure -- see that function's own honest-limitation note.
    let seen = {}
    let dupes = 0
    let empties = 0
    for k in kinds
        let nm = prism_node.prism_node_kind_name(k)
        if len(nm) == 0
            empties += 1
        if nm in seen
            dupes += 1
        seen[nm] = true
    _check("no empty kind names", str(empties), "0")
    _check("no duplicate kind names", str(dupes), "0")
    _check("22 distinct names", str(len(seen)), "22")

    print("== 2. ★ COVERAGE — MA.7's exit criterion ==")
    let missing = unwrap(cat.prism_catalog_coverage())
    if len(missing) == 0
        print("  pass  every primitive has a catalog example")
    else
        print("  FAIL  primitives with NO catalog example: " + join(missing, ", "))
        FAILED[0] = FAILED[0] + 1

    print("== 3. entries are real, validated nodes ==")
    let entries = unwrap(cat.prism_catalog_entries())
    _check("one entry per primitive", str(len(entries)), "22")
    let bad_kind = 0
    let bad_blurb = 0
    let mismatched = 0
    for e in entries
        if type_name(cat.prism_catalog_entry_node(e)) != "PrismNode"
            bad_kind += 1
        if len(cat.prism_catalog_entry_blurb(e)) == 0
            bad_blurb += 1
        // The example node's ACTUAL kind must match the entry's claimed kind. `each` is the one
        // legitimate exception in spirit -- but MA.3 wraps its rows in an Each node, so it holds.
        if prism_node.prism_node_kind_str(cat.prism_catalog_entry_node(e)) != cat.prism_catalog_entry_kind(e)
            mismatched += 1
            print("        mismatch: entry says '" + cat.prism_catalog_entry_kind(e) + "' but node is '" + prism_node.prism_node_kind_str(cat.prism_catalog_entry_node(e)) + "'")
    _check("every example is a PrismNode", str(bad_kind), "0")
    _check("every entry has a blurb", str(bad_blurb), "0")
    _check("every example's kind matches its label", str(mismatched), "0")

    print("== 4. the catalog is itself a Prism tree ==")
    let tree = unwrap(cat.prism_catalog_tree())
    _check("catalog root is a stack", prism_node.prism_node_kind_str(tree), "stack")
    // 22 sections + the title label.
    _check("22 sections + title", str(prism_node.prism_node_child_count(tree)), "23")
    _check_true("within the depth bound", prism_node.prism_node_depth(tree) < 256)
    _check_true("within the node-count bound", prism_node.prism_node_count(tree) < 100000)

    print("== 5. renders through BOTH real backends ==")
    let html = unwrap(cat.prism_catalog_html())
    let ansi = unwrap(cat.prism_catalog_ansi())
    _check_true("HTML is a full document", find(html, "<!doctype html>") == 0)
    _check_true("HTML has the title", find(html, "Prism component catalog") >= 0)
    _check_true("HTML is substantial", len(html) > 2000)
    _check_true("ANSI is substantial", len(ansi) > 400)
    _check_true("ANSI carries no HTML tags", find(ansi, "<div") < 0)
    // Every primitive's NAME appears in the catalog output -- proves the page really presents all
    // 22 rather than merely constructing them.
    let absent_html = []
    for k in kinds
        let nm = prism_node.prism_node_kind_name(k)
        if find(html, nm) < 0
            absent_html.push(nm)
    if len(absent_html) == 0
        print("  pass  all 22 primitive names appear in the HTML catalog")
    else
        print("  FAIL  missing from HTML catalog: " + join(absent_html, ", "))
        FAILED[0] = FAILED[0] + 1

    print("== 6. still deterministic, and still XSS-safe ==")
    _check_true("catalog HTML is byte-identical across renders", unwrap(cat.prism_catalog_html()) == html)
    _check_true("no script tag anywhere in the catalog", find(html, "<script") < 0)
    _check_true("no on-handler anywhere in the catalog", find(html, "onclick=") < 0)

    if FAILED[0] == 0
        print("")
        print("_kat_prism_catalog: ALL PASS")
    else
        print("")
        print("_kat_prism_catalog: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
