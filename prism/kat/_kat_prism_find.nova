// KAT for prism/text/prism_find.nova -- in-app find over a prism_textmodel document.
//
// The five things this proves, in order of importance:
//   1. Matches are CODE POINT ranges, correct over non-ASCII text and non-ASCII needles.
//   2. Overlapping candidates do NOT produce overlapping matches -- the scan advances past each
//      hit ("ababa" contains "aba" as an overlapping candidate twice but reports it once; "aaaa"
//      finding "aa" reports two ADJACENT, non-overlapping matches, not three).
//   3. An empty needle is REJECTED -- not an infinite loop, not a match at every position.
//   4. A needle longer than the haystack is zero matches, not an error.
//   5. Case-sensitive vs case-insensitive search, and find_next's wrap-around.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to nova-compiler/, NOVA_NO_CACHE=1)

import prism_textmodel
import prism_find

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn _froms(matches: list) -> string
    join(matches.map(fn(m) str(prism_find.prism_fnd_match_from(m))), ",")

fn main()
    print("== _kat_prism_find ==")
    print("")

    print("1. basic case-sensitive / case-insensitive search")
    let doc = unwrap(prism_textmodel.prism_tm_plain("The Cat sat on the cat mat"))
    let cs = unwrap(prism_find.prism_fnd_find_all(doc, "cat", true))
    check("case-sensitive 'cat' finds only the lowercase one (1 match)", len(cs) == 1)
    check("case-sensitive match is at code point 19", prism_find.prism_fnd_match_from(cs[0]) == 19)
    let ci = unwrap(prism_find.prism_fnd_find_all(doc, "cat", false))
    check("case-insensitive 'cat' finds 'Cat' AND 'cat' (2 matches)", len(ci) == 2)
    check("case-insensitive matches at 4 and 19", _froms(ci) == "4,19")
    check("match_text round-trips the ORIGINAL casing, not the lowered form", unwrap(prism_find.prism_fnd_match_text(ci[0], doc)) == "Cat")
    print("")

    print("2. overlapping candidates -- the scan is NON-OVERLAPPING")
    let aaaa = unwrap(prism_textmodel.prism_tm_plain("aaaa"))
    let aa = unwrap(prism_find.prism_fnd_find_all(aaaa, "aa", true))
    check("'aaaa' finding 'aa' -> exactly 2 ADJACENT matches, not 3 overlapping ones", len(aa) == 2)
    check("matches are at 0 and 2 (adjacent, not 0/1/2)", _froms(aa) == "0,2")
    let ababa = unwrap(prism_textmodel.prism_tm_plain("ababa"))
    let aba = unwrap(prism_find.prism_fnd_find_all(ababa, "aba", true))
    check("'ababa' finding 'aba' -> exactly 1 match (the overlapping 2nd candidate at index 2 is NOT reported)", len(aba) == 1)
    check("the one match is at index 0", _froms(aba) == "0")
    print("")

    print("3. empty needle -- REJECTED, not an infinite match")
    check("empty needle is rejected", is_err(prism_find.prism_fnd_find_all(doc, "", true)))
    check("empty needle rejected regardless of case_sensitive", is_err(prism_find.prism_fnd_find_all(doc, "", false)))
    check("non-string needle rejected", is_err(prism_find.prism_fnd_find_all(doc, 7, true)))
    print("")

    print("4. needle longer than the haystack -- zero matches, NOT an error")
    let tiny = unwrap(prism_textmodel.prism_tm_plain("hi"))
    let toolong = prism_find.prism_fnd_find_all(tiny, "hello there", true)
    check("needle-longer-than-haystack does not error", not is_err(toolong))
    check("...and returns zero matches", len(unwrap(toolong)) == 0)
    let exact = unwrap(prism_find.prism_fnd_find_all(tiny, "hi", true))
    check("needle exactly the length of the haystack still matches", len(exact) == 1)
    print("")

    print("5. non-ASCII needles and haystacks -- CODE POINT positions, not bytes")
    let jp = unwrap(prism_textmodel.prism_tm_plain("日本語のテスト日本語"))   // 10 code points
    let jm = unwrap(prism_find.prism_fnd_find_all(jp, "日本語", true))
    check("CJK needle finds 2 non-overlapping occurrences", len(jm) == 2)
    check("first CJK match at code point 0", prism_find.prism_fnd_match_from(jm[0]) == 0)
    check("second CJK match at code point 7 (after 'のテスト')", prism_find.prism_fnd_match_from(jm[1]) == 7)
    check("match_text extracts the exact CJK substring", unwrap(prism_find.prism_fnd_match_text(jm[0], jp)) == "日本語")
    let acc = unwrap(prism_textmodel.prism_tm_plain("café caffé café"))
    let am = unwrap(prism_find.prism_fnd_find_all(acc, "café", true))
    check("accented needle 'café' finds both occurrences by exact code points", len(am) == 2)
    check("positions land on code points, not bytes (2nd match at 11, not a byte offset)", _froms(am) == "0,11")
    print("")

    print("6. count / find_first / find_next (wraps)")
    check("count matches find_all's length", unwrap(prism_find.prism_fnd_count(doc, "cat", false)) == 2)
    let first = unwrap(prism_find.prism_fnd_find_first(doc, "cat", false))
    check("find_first returns the earliest match (at 4)", prism_find.prism_fnd_match_from(first) == 4)
    check("find_first errors when there is no match", is_err(prism_find.prism_fnd_find_first(doc, "zzz", true)))
    let next1 = unwrap(prism_find.prism_fnd_find_next(doc, "cat", false, 5))
    check("find_next(from=5) skips the match at 4, lands on 19", prism_find.prism_fnd_match_from(next1) == 19)
    let next2 = unwrap(prism_find.prism_fnd_find_next(doc, "cat", false, 20))
    check("find_next(from=20) is past the last match's start -> WRAPS to the first (4)", prism_find.prism_fnd_match_from(next2) == 4)
    check("find_next errors when there is no match at all", is_err(prism_find.prism_fnd_find_next(doc, "zzz", true, 0)))
    check("find_next rejects a non-int from_pos", is_err(prism_find.prism_fnd_find_next(doc, "cat", true, "0")))
    print("")

    print("7. accessors")
    let m0 = jm[0]
    check("match_len is to-from", prism_find.prism_fnd_match_len(m0) == 3)
    check("match_to is from+len", prism_find.prism_fnd_match_to(m0) == 3)
    print("")

    if STATS[1] == 0
        print("_kat_prism_find: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_find: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
