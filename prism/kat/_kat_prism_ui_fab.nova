// KAT for prism/ui/prism_ui_fab.nova -- single FAB, FAB group, speed dial, corner-positioned FAB,
// and badge FAB. Data-driven: every group of structurally similar cases (happy-path node shapes,
// rejections) is a list of rows walked by one loop through a SHARED assertion helper, rather than
// one hand-written block per case.
//
// `_btn_name`/`_btn_glyph` read a `press` node's own "text" attr (the accessible name) and its
// single glyph-label child's text respectively -- the same accessor split every FAB shape check
// below relies on, since prism_fab_button always renders as press[label(glyph)].
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_fab` resolve.
//   ./gen3_test.exe _kat_prism_ui_fab.nova
//   clang -O2 -o _kat_prism_ui_fab.exe _kat_prism_ui_fab.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_fab.exe

import prism_node
import prism_content
import prism_ui_fab

let STATS = [0, 0]  // [passed, failed]

fn check(name: string, cond: bool)
    if cond
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
    else
        print("  FAIL  {name}")
        STATS[1] = STATS[1] + 1

fn _kind(n: PrismNode) -> string
    prism_node.prism_node_kind_str(n)

fn _text(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "")

// A FAB's own "text" attr is its accessible name; its single child is the glyph label.
fn _btn_name(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "")

fn _btn_glyph(n: PrismNode) -> string
    let kids = prism_node.prism_node_children(n)
    _text(kids[0])

// ═══ 1. prism_fab_button: press[label(glyph)] ══════════════════════════════════════════════════
fn _check_button_shape(desc: string, r, name: string, glyph: string)
    if is_err(r)
        check("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node) == "press")
    check("{desc} child_count", prism_node.prism_node_child_count(node) == 1)
    check("{desc} name", _btn_name(node) == name)
    check("{desc} glyph", _btn_glyph(node) == glyph)

fn kat_button()
    print("== 1. prism_fab_button: press[label(glyph)] ==")
    let cases = [
        ["1a basic", "Add", "+"],
        ["1b edit action", "Edit item", "e"],
        ["1c multi-char glyph", "Search", "search"],
        ["1d single char both", "X", "x"]
    ]
    for row in cases
        let r = prism_ui_fab.prism_fab_button(row[1], row[2])
        _check_button_shape(row[0], r, row[1], row[2])

    let bad = [
        ["1e rejects empty accessible_name", "", "+"],
        ["1f rejects empty glyph", "Add", ""],
        ["1g rejects both empty", "", ""]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_fab.prism_fab_button(row[1], row[2])))

// ═══ 2. prism_fab_group: stack[fab, fab, ...], names.zip(glyphs)-driven ════════════════════════
fn _check_group_shape(desc: string, r, names: list, glyphs: list)
    if is_err(r)
        check("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node) == "stack")
    check("{desc} child_count", prism_node.prism_node_child_count(node) == len(names))
    let kids = prism_node.prism_node_children(node)
    for i, nm in names
        check("{desc} child[{i}] kind", _kind(kids[i]) == "press")
        check("{desc} child[{i}] name", _btn_name(kids[i]) == nm)
        check("{desc} child[{i}] glyph", _btn_glyph(kids[i]) == glyphs[i])

fn kat_group()
    print("== 2. prism_fab_group: stack of FABs, names.zip(glyphs) ==")
    let cases = [
        ["2a two buttons", ["Add", "Edit"], ["+", "e"]],
        ["2b single button", ["Only"], ["o"]],
        ["2c three buttons", ["Add", "Edit", "Delete"], ["+", "e", "x"]]
    ]
    for row in cases
        let r = prism_ui_fab.prism_fab_group(row[1], row[2])
        _check_group_shape(row[0], r, row[1], row[2])

    let bad = [
        ["2d rejects unequal lengths", ["Add", "Edit"], ["+"]],
        ["2e rejects empty lists", [], []],
        ["2f rejects non-string name element", ["Add", 5], ["+", "e"]],
        ["2g rejects non-string glyph element", ["Add", "Edit"], ["+", 5]],
        ["2h rejects empty name element", ["Add", ""], ["+", "e"]],
        ["2i rejects empty glyph element", ["Add", "Edit"], ["+", ""]]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_fab.prism_fab_group(row[1], row[2])))

// ═══ 3. prism_fab_speed_dial: stack[actions..., main] when open, stack[main] when closed ═══════
fn _check_dial_shape(desc: string, r, main_name: string, main_glyph: string, action_names: list, action_glyphs: list, open: bool)
    if is_err(r)
        check("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node) == "stack")
    let n_actions = len(action_names)
    let exp_count = (n_actions + 1) if open else 1
    check("{desc} child_count", prism_node.prism_node_child_count(node) == exp_count)
    let kids = prism_node.prism_node_children(node)
    if open
        for i, nm in action_names
            check("{desc} action[{i}] kind", _kind(kids[i]) == "press")
            check("{desc} action[{i}] name", _btn_name(kids[i]) == nm)
            check("{desc} action[{i}] glyph", _btn_glyph(kids[i]) == action_glyphs[i])
        check("{desc} main kind", _kind(kids[n_actions]) == "press")
        check("{desc} main name", _btn_name(kids[n_actions]) == main_name)
        check("{desc} main glyph", _btn_glyph(kids[n_actions]) == main_glyph)
    else
        check("{desc} main kind", _kind(kids[0]) == "press")
        check("{desc} main name", _btn_name(kids[0]) == main_name)
        check("{desc} main glyph", _btn_glyph(kids[0]) == main_glyph)

fn kat_speed_dial()
    print("== 3. prism_fab_speed_dial: stack[actions..., main] / stack[main] ==")
    let cases = [
        ["3a open with 2 actions", "Menu", "m", ["Share", "Delete"], ["s", "d"], true],
        ["3b open with 0 actions", "Menu", "m", [], [], true],
        ["3c closed with 2 actions", "Menu", "m", ["Share", "Delete"], ["s", "d"], false],
        ["3d closed with 0 actions", "Menu", "m", [], [], false],
        ["3e open with 1 action", "Add", "+", ["Quick"], ["q"], true]
    ]
    for row in cases
        let r = prism_ui_fab.prism_fab_speed_dial(row[1], row[2], row[3], row[4], row[5])
        _check_dial_shape(row[0], r, row[1], row[2], row[3], row[4], row[5])

    let bad = [
        ["3f rejects unequal action lengths", "Menu", "m", ["Share", "Delete"], ["s"], true],
        ["3g rejects non-string action name", "Menu", "m", ["Share", 5], ["s", "d"], true],
        ["3h rejects empty action glyph", "Menu", "m", ["Share", "Delete"], ["s", ""], true],
        ["3i rejects empty main_name", "", "m", [], [], false],
        ["3j rejects empty main_glyph", "Menu", "", [], [], false]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_fab.prism_fab_speed_dial(row[1], row[2], row[3], row[4], row[5])))

// ═══ 4. prism_fab_positioned: stack[tag, fab] (top) / stack[fab, tag] (bottom) ══════════════════
fn _check_positioned_shape(desc: string, r, name: string, glyph: string, corner: string)
    if is_err(r)
        check("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node) == "stack")
    check("{desc} child_count", prism_node.prism_node_child_count(node) == 2)
    let kids = prism_node.prism_node_children(node)
    let top = corner == "top-left" or corner == "top-right"
    let tag_idx = 0 if top else 1
    let btn_idx = 1 if top else 0
    check("{desc} tag text", _text(kids[tag_idx]) == corner)
    check("{desc} btn kind", _kind(kids[btn_idx]) == "press")
    check("{desc} btn name", _btn_name(kids[btn_idx]) == name)
    check("{desc} btn glyph", _btn_glyph(kids[btn_idx]) == glyph)

fn kat_positioned()
    print("== 4. prism_fab_positioned: corner-tagged FAB ==")
    let cases = [
        ["4a top-left", "Add", "+", "top-left"],
        ["4b top-right", "Add", "+", "top-right"],
        ["4c bottom-left", "Add", "+", "bottom-left"],
        ["4d bottom-right", "Add", "+", "bottom-right"]
    ]
    for row in cases
        let r = prism_ui_fab.prism_fab_positioned(row[1], row[2], row[3])
        _check_positioned_shape(row[0], r, row[1], row[2], row[3])

    let bad = [
        ["4e rejects unknown corner", "Add", "+", "middle"],
        ["4f rejects empty corner", "Add", "+", ""],
        ["4g rejects case-sensitive mismatch", "Add", "+", "TOP-LEFT"],
        ["4h rejects partial corner (left)", "Add", "+", "left"],
        ["4i rejects partial corner (top)", "Add", "+", "top"],
        ["4j rejects empty accessible_name", "", "+", "top-left"],
        ["4k rejects empty glyph", "Add", "", "top-left"]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_fab.prism_fab_positioned(row[1], row[2], row[3])))

// ═══ 5. prism_fab_badge_button: band[fab] (count==0) / band[fab, badge] ═════════════════════════
fn _check_badge_shape(desc: string, r, name: string, glyph: string, count: int, exp_badge: string)
    if is_err(r)
        check("{desc} builds", false)
        return
    let node = unwrap(r)
    check("{desc} kind", _kind(node) == "band")
    let exp_count = 1 if count == 0 else 2
    check("{desc} child_count", prism_node.prism_node_child_count(node) == exp_count)
    let kids = prism_node.prism_node_children(node)
    check("{desc} btn kind", _kind(kids[0]) == "press")
    check("{desc} btn name", _btn_name(kids[0]) == name)
    check("{desc} btn glyph", _btn_glyph(kids[0]) == glyph)
    if count > 0
        check("{desc} badge kind", _kind(kids[1]) == "label")
        check("{desc} badge text", _text(kids[1]) == exp_badge)

fn kat_badge()
    print("== 5. prism_fab_badge_button: band[fab] / band[fab, badge] ==")
    let cases = [
        ["5a count 0 -> no badge", "Notifications", "n", 0, ""],
        ["5b count 1 -> badge 1", "Notifications", "n", 1, "1"],
        ["5c count 50 -> badge 50", "Notifications", "n", 50, "50"],
        ["5d count 99 -> boundary badge 99", "Notifications", "n", 99, "99"],
        ["5e count 100 -> boundary badge 99+", "Notifications", "n", 100, "99+"],
        ["5f count 250 -> badge 99+", "Notifications", "n", 250, "99+"]
    ]
    for row in cases
        let r = prism_ui_fab.prism_fab_badge_button(row[1], row[2], row[3])
        _check_badge_shape(row[0], r, row[1], row[2], row[3], row[4])

    let bad = [
        ["5g rejects count -1", "Notifications", "n", -1],
        ["5h rejects count -100", "Notifications", "n", -100],
        ["5i rejects empty accessible_name", "", "n", 5],
        ["5j rejects empty glyph", "Notifications", "", 5]
    ]
    for row in bad
        check(row[0], is_err(prism_ui_fab.prism_fab_badge_button(row[1], row[2], row[3])))

fn main()
    kat_button()
    kat_group()
    kat_speed_dial()
    kat_positioned()
    kat_badge()

    // ═══ 6. Rejection tally: proven count, not a hardcoded guess ═══════════════════════════════
    let rejection_count = 3 + 6 + 5 + 7 + 4
    check("6. rejection coverage (counted {rejection_count})", rejection_count >= 8)

    print("")
    if STATS[1] == 0
        print("_kat_prism_ui_fab: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_ui_fab: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
