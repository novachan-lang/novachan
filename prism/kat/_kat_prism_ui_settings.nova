// KAT for prism/ui/prism_ui_settings.nova (PRISM_ROADMAP.md milestone MB.27, the `ui/`
// composition layer's settings/preferences components: toggle, choice, group, page).
//
// Every expected shape below is hand-computed from `prism_node.prism_node_new`'s own depth/count
// rule (leaf: depth=1, count=1; branch: depth=max(child depths)+1, count=1+sum(child counts)) --
// never taken on faith from the implementation. Proves, against concrete expected values:
//   1. Toggle: band[stack[label, label?], flag] -- with no description (d3,c4), with a
//      description (d3,c5), and a present-but-empty description degrading to the SAME shape as
//      no description at all (tolerant-degrade, same class prism_nt_item's nt_time uses). flag
//      carries cfg_label as ITS OWN accessible name and cfg_on as its state, both round-tripped.
//      Rejects an empty cfg_label.
//   2. Choice: stack[label, pick] (d2,c3) regardless of option count (pick is a leaf). Selected
//      value and the full value/label-doubled option list round-trip through prism_interact's own
//      accessors. Rejects an empty cfg_label, an empty cfg_options, a non-string element (named by
//      index and actual type), a cfg_selected absent from cfg_options (the stricter-than-prism_pick
//      rule, see file header), and a duplicate option string (delegated to prism_pick's own check).
//   3. Group: stack[label, gap(8), stack(settings)] -- exact depth/count derived from a toggle
//      (d3,c4) + a choice (d2,c3) pair; gap value verified via prism_arrange's own typed
//      accessors. Rejects an empty cfg_title, an empty settings list, and a non-PrismNode element.
//   4. Page: stack[label, gap(16), stack(groups)] -- exact depth/count derived from two groups;
//      gap value verified the same way. Rejects an empty cfg_title, an empty groups list, and a
//      non-PrismNode element.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_settings` resolve.
//   ./gen3_test.exe _kat_prism_ui_settings.nova
//   clang -O2 -o _kat_prism_ui_settings.exe _kat_prism_ui_settings.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_settings.exe

import prism_node
import prism_arrange
import prism_interact
import prism_ui_settings

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    // ── 1. Toggle ─────────────────────────────────────────────────────────────────────────────
    print("== 1. toggle ==")

    // No description: band[stack[label], flag].
    let t1 = unwrap(prism_ui_settings.prism_cfg_toggle("Wi-Fi", none(), true))
    _check("toggle1 kind == band", prism_node.prism_node_kind_str(t1), "band")
    _check("toggle1 depth", str(prism_node.prism_node_depth(t1)), "3")
    _check("toggle1 count", str(prism_node.prism_node_count(t1)), "4")
    let t1_kids = prism_node.prism_node_children(t1)
    _check("toggle1 child 0 kind == stack", prism_node.prism_node_kind_str(t1_kids[0]), "stack")
    _check("toggle1 text_stack child_count == 1 (no description)", str(prism_node.prism_node_child_count(t1_kids[0])), "1")
    let t1_stack_kids = prism_node.prism_node_children(t1_kids[0])
    _check("toggle1 title text", prism_node.prism_node_attr_str(t1_stack_kids[0], "text", ""), "Wi-Fi")
    _check("toggle1 child 1 kind == flag", prism_node.prism_node_kind_str(t1_kids[1]), "flag")
    _check("toggle1 flag label == cfg_label (accessible name reuse, see header)", prism_node.prism_node_attr_str(t1_kids[1], "label", ""), "Wi-Fi")
    _check_true("toggle1 flag state == true", prism_node.prism_node_attr_bool(t1_kids[1], "state", false) == true)

    // With a non-empty description: band[stack[label, label], flag].
    let t2 = unwrap(prism_ui_settings.prism_cfg_toggle("Notifications", some("Get alerts for new messages"), false))
    _check("toggle2 kind == band", prism_node.prism_node_kind_str(t2), "band")
    _check("toggle2 depth", str(prism_node.prism_node_depth(t2)), "3")
    _check("toggle2 count", str(prism_node.prism_node_count(t2)), "5")
    let t2_kids = prism_node.prism_node_children(t2)
    _check("toggle2 text_stack child_count == 2 (title + description)", str(prism_node.prism_node_child_count(t2_kids[0])), "2")
    let t2_stack_kids = prism_node.prism_node_children(t2_kids[0])
    _check("toggle2 title text", prism_node.prism_node_attr_str(t2_stack_kids[0], "text", ""), "Notifications")
    _check("toggle2 description text", prism_node.prism_node_attr_str(t2_stack_kids[1], "text", ""), "Get alerts for new messages")
    _check("toggle2 flag label == cfg_label", prism_node.prism_node_attr_str(t2_kids[1], "label", ""), "Notifications")
    _check_true("toggle2 flag state == false", prism_node.prism_node_attr_bool(t2_kids[1], "state", true) == false)

    // A present-but-empty description degrades to the SAME shape as no description at all.
    let t3 = unwrap(prism_ui_settings.prism_cfg_toggle("Bluetooth", some(""), true))
    _check("toggle3 (blank Some(description)) depth", str(prism_node.prism_node_depth(t3)), "3")
    _check("toggle3 (blank Some(description)) count", str(prism_node.prism_node_count(t3)), "4")
    let t3_kids = prism_node.prism_node_children(t3)
    _check("toggle3 text_stack child_count == 1, degrades like None", str(prism_node.prism_node_child_count(t3_kids[0])), "1")

    // Rejection.
    let t_empty_label = prism_ui_settings.prism_cfg_toggle("", none(), true)
    _check_true("toggle rejects empty cfg_label", is_err(t_empty_label))

    // ── 2. Choice ─────────────────────────────────────────────────────────────────────────────
    print("== 2. choice ==")

    let c1 = unwrap(prism_ui_settings.prism_cfg_choice("Theme", ["Light", "Dark", "System"], "Dark"))
    _check("choice1 kind == stack", prism_node.prism_node_kind_str(c1), "stack")
    _check("choice1 depth", str(prism_node.prism_node_depth(c1)), "2")
    _check("choice1 count", str(prism_node.prism_node_count(c1)), "3")
    let c1_kids = prism_node.prism_node_children(c1)
    _check("choice1 child 0 kind == label", prism_node.prism_node_kind_str(c1_kids[0]), "label")
    _check("choice1 label text", prism_node.prism_node_attr_str(c1_kids[0], "text", ""), "Theme")
    _check("choice1 child 1 kind == pick", prism_node.prism_node_kind_str(c1_kids[1]), "pick")
    _check("choice1 selected_value round-trips", prism_interact.prism_pick_selected_value(c1_kids[1]), "Dark")
    let c1_opts = prism_interact.prism_pick_options(c1_kids[1])
    _check("choice1 option count == 3", str(len(c1_opts)), "3")
    _check("choice1 option 0 value == label == Light", c1_opts[0].pick_value, "Light")
    _check("choice1 option 0 label == Light", c1_opts[0].pick_label, "Light")
    _check("choice1 option 1 value == Dark", c1_opts[1].pick_value, "Dark")
    _check("choice1 option 2 value == System", c1_opts[2].pick_value, "System")

    // Rejections.
    let c_empty_label = prism_ui_settings.prism_cfg_choice("", ["A"], "A")
    _check_true("choice rejects empty cfg_label", is_err(c_empty_label))
    let c_empty_options = prism_ui_settings.prism_cfg_choice("Theme", [], "A")
    _check_true("choice rejects empty cfg_options", is_err(c_empty_options))
    let c_bad_elem = prism_ui_settings.prism_cfg_choice("Theme", ["Light", 42], "Light")
    _check_true("choice rejects a non-string element", is_err(c_bad_elem))
    if is_err(c_bad_elem)
        _check_true("choice's rejection names the offending index and type", find(unwrap_err(c_bad_elem), "1") >= 0 and find(unwrap_err(c_bad_elem), "int") >= 0)
    let c_bad_selected = prism_ui_settings.prism_cfg_choice("Theme", ["Light", "Dark"], "Purple")
    _check_true("choice rejects cfg_selected not among cfg_options", is_err(c_bad_selected))
    let c_empty_selected = prism_ui_settings.prism_cfg_choice("Theme", ["Light", "Dark"], "")
    _check_true("choice rejects an empty cfg_selected (stricter than prism_pick's own '' allowance)", is_err(c_empty_selected))
    let c_dup = prism_ui_settings.prism_cfg_choice("Theme", ["Light", "Light"], "Light")
    _check_true("choice rejects a duplicate option string (via prism_pick's own check)", is_err(c_dup))

    // ── 3. Group ──────────────────────────────────────────────────────────────────────────────
    print("== 3. group ==")

    let g1 = unwrap(prism_ui_settings.prism_cfg_group("General", [t1, c1]))
    _check("group1 kind == stack", prism_node.prism_node_kind_str(g1), "stack")
    _check("group1 depth", str(prism_node.prism_node_depth(g1)), "5")
    _check("group1 count", str(prism_node.prism_node_count(g1)), "11")
    let g1_kids = prism_node.prism_node_children(g1)
    _check("group1 child 0 kind == label", prism_node.prism_node_kind_str(g1_kids[0]), "label")
    _check("group1 title text", prism_node.prism_node_attr_str(g1_kids[0], "text", ""), "General")
    _check("group1 child 1 kind == gap", prism_node.prism_node_kind_str(g1_kids[1]), "gap")
    _check_true("group1 gap is fixed (not flexible)", not prism_arrange.prism_gap_is_flexible(g1_kids[1]))
    _check("group1 gap size == 8", str(prism_arrange.prism_gap_size(g1_kids[1], -1)), "8")
    _check("group1 child 2 kind == stack (settings)", prism_node.prism_node_kind_str(g1_kids[2]), "stack")
    _check("group1 settings stack depth", str(prism_node.prism_node_depth(g1_kids[2])), "4")
    _check("group1 settings stack count", str(prism_node.prism_node_count(g1_kids[2])), "8")
    let g1_settings_kids = prism_node.prism_node_children(g1_kids[2])
    _check_true("group1 settings child 0 is t1 (count 4)", g1_settings_kids[0].count == 4)
    _check_true("group1 settings child 1 is c1 (count 3)", g1_settings_kids[1].count == 3)

    let g2 = unwrap(prism_ui_settings.prism_cfg_group("Notifications", [t2]))
    _check("group2 depth", str(prism_node.prism_node_depth(g2)), "5")
    _check("group2 count", str(prism_node.prism_node_count(g2)), "9")

    // Rejections.
    let g_empty_title = prism_ui_settings.prism_cfg_group("", [t1])
    _check_true("group rejects empty cfg_title", is_err(g_empty_title))
    let g_empty_settings = prism_ui_settings.prism_cfg_group("General", [])
    _check_true("group rejects empty settings", is_err(g_empty_settings))
    let g_bad_elem = prism_ui_settings.prism_cfg_group("General", [t1, "not a node"])
    _check_true("group rejects a non-PrismNode element", is_err(g_bad_elem))
    if is_err(g_bad_elem)
        _check_true("group's rejection names the offending index and type", find(unwrap_err(g_bad_elem), "1") >= 0 and find(unwrap_err(g_bad_elem), "string") >= 0)

    // ── 4. Page ───────────────────────────────────────────────────────────────────────────────
    print("== 4. page ==")

    let p1 = unwrap(prism_ui_settings.prism_cfg_page("Settings", [g1, g2]))
    _check("page1 kind == stack", prism_node.prism_node_kind_str(p1), "stack")
    _check("page1 depth", str(prism_node.prism_node_depth(p1)), "7")
    _check("page1 count", str(prism_node.prism_node_count(p1)), "24")
    let p1_kids = prism_node.prism_node_children(p1)
    _check("page1 child 0 kind == label", prism_node.prism_node_kind_str(p1_kids[0]), "label")
    _check("page1 title text", prism_node.prism_node_attr_str(p1_kids[0], "text", ""), "Settings")
    _check("page1 child 1 kind == gap", prism_node.prism_node_kind_str(p1_kids[1]), "gap")
    _check_true("page1 gap is fixed (not flexible)", not prism_arrange.prism_gap_is_flexible(p1_kids[1]))
    _check("page1 gap size == 16 (double the group-level gap)", str(prism_arrange.prism_gap_size(p1_kids[1], -1)), "16")
    _check("page1 child 2 kind == stack (groups)", prism_node.prism_node_kind_str(p1_kids[2]), "stack")
    _check("page1 groups stack depth", str(prism_node.prism_node_depth(p1_kids[2])), "6")
    _check("page1 groups stack count", str(prism_node.prism_node_count(p1_kids[2])), "21")
    let p1_groups_kids = prism_node.prism_node_children(p1_kids[2])
    _check_true("page1 groups child 0 is g1 (count 11)", p1_groups_kids[0].count == 11)
    _check_true("page1 groups child 1 is g2 (count 9)", p1_groups_kids[1].count == 9)

    // Rejections.
    let p_empty_title = prism_ui_settings.prism_cfg_page("", [g1])
    _check_true("page rejects empty cfg_title", is_err(p_empty_title))
    let p_empty_groups = prism_ui_settings.prism_cfg_page("Settings", [])
    _check_true("page rejects empty groups", is_err(p_empty_groups))
    let p_bad_elem = prism_ui_settings.prism_cfg_page("Settings", [g1, 42])
    _check_true("page rejects a non-PrismNode element", is_err(p_bad_elem))
    if is_err(p_bad_elem)
        _check_true("page's rejection names the offending index and type", find(unwrap_err(p_bad_elem), "1") >= 0 and find(unwrap_err(p_bad_elem), "int") >= 0)

    // ── Summary ───────────────────────────────────────────────────────────────────────────────
    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_settings: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_settings: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
