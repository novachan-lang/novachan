// KAT for prism/text/prism_richedit.nova -- rich-text editing (#62).
//
// The properties this exists for:
//   1. ★ DOC AND SELECTION MOVE TOGETHER. Insert 5 characters and leave the caret behind and it
//      is now 5 positions off -- every later edit lands in the wrong place and the user watches
//      their typing appear somewhere else. Every command below asserts BOTH the resulting text
//      AND the resulting caret.
//   2. ★ NON-ASCII CARET ARITHMETIC. Advancing by BYTE length would put the caret inside a
//      multi-byte character. Asserted with CJK, where byte length is 3x the code-point count.
//   3. ★ has_mark is ALL, not ANY. With a half-bold selection, "any" would report bold, so the
//      toggle would UNBOLD the half that was not bold -- the opposite of the request.

import prism_textmodel
import prism_select
import prism_richedit

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn _ed(s: string) -> PrismEditor
    unwrap(prism_richedit.prism_re_new(unwrap(prism_textmodel.prism_tm_plain(s))))

fn main()
    print("== _kat_prism_richedit ==")

    print("1. a new editor puts the caret at the END")
    let e0 = _ed("hello")
    check("text is preserved", prism_richedit.prism_re_text(e0) == "hello")
    // Position 0 would put the caret before the user's own content.
    check("caret starts at the end (5), not 0", prism_richedit.prism_re_caret(e0) == 5)

    print("2. ★ insert moves the caret WITH the text")
    let e1 = unwrap(prism_richedit.prism_re_insert(e0, "!"))
    check("text grew", prism_richedit.prism_re_text(e1) == "hello!")
    check("caret advanced to 6", prism_richedit.prism_re_caret(e1) == 6)
    let mid = unwrap(prism_richedit.prism_re_insert(unwrap(prism_richedit.prism_re_move_to(e0, 2)), "XY"))
    check("insert in the middle", prism_richedit.prism_re_text(mid) == "heXYllo")
    check("caret advanced by the inserted LENGTH (2 -> 4)", prism_richedit.prism_re_caret(mid) == 4)
    check("non-string insert rejected", is_err(prism_richedit.prism_re_insert(e0, 7)))
    // The original must be untouched -- these are values, not mutations.
    check("the ORIGINAL editor is unchanged", prism_richedit.prism_re_text(e0) == "hello" and prism_richedit.prism_re_caret(e0) == 5)

    print("3. ★ insert over a RANGE replaces, and the caret lands after the NEW text")
    let sel = unwrap(prism_richedit.prism_re_select(e0, 1, 4))
    let repl = unwrap(prism_richedit.prism_re_insert(sel, "i"))
    check("range replaced", prism_richedit.prism_re_text(repl) == "hio")
    // The caret must be at 2 (after "hi"), NOT at the old range end 4 -- which would be past the
    // content now that the replacement is shorter.
    check("caret is after the new text (2), not the old range end (4)", prism_richedit.prism_re_caret(repl) == 2)
    let longer = unwrap(prism_richedit.prism_re_insert(sel, "ABCDE"))
    check("a longer replacement works too", prism_richedit.prism_re_text(longer) == "hABCDEo")
    check("caret after the longer text (6)", prism_richedit.prism_re_caret(longer) == 6)

    print("4. delete, backspace, forward delete")
    check("delete_selection removes the range", prism_richedit.prism_re_text(unwrap(prism_richedit.prism_re_delete_selection(sel))) == "ho")
    // The caret collapses to the range START -- the only position still on existing content.
    check("caret collapses to the range START (1)", prism_richedit.prism_re_caret(unwrap(prism_richedit.prism_re_delete_selection(sel))) == 1)
    check("delete_selection on a collapsed caret is a no-op", prism_richedit.prism_re_text(unwrap(prism_richedit.prism_re_delete_selection(e0))) == "hello")
    let bs = unwrap(prism_richedit.prism_re_backspace(e0))
    check("backspace removes the char BEFORE the caret", prism_richedit.prism_re_text(bs) == "hell")
    check("backspace moves the caret back", prism_richedit.prism_re_caret(bs) == 4)
    // Backspace at 0 is something users do constantly; it is not a mistake to report.
    check("backspace at position 0 is a NO-OP, not an error", prism_richedit.prism_re_text(unwrap(prism_richedit.prism_re_backspace(unwrap(prism_richedit.prism_re_move_to(e0, 0))))) == "hello")
    check("backspace with a selection deletes the selection", prism_richedit.prism_re_text(unwrap(prism_richedit.prism_re_backspace(sel))) == "ho")
    let fd = unwrap(prism_richedit.prism_re_delete_forward(unwrap(prism_richedit.prism_re_move_to(e0, 0))))
    check("forward delete removes the char AFTER the caret", prism_richedit.prism_re_text(fd) == "ello")
    check("forward delete leaves the caret put", prism_richedit.prism_re_caret(fd) == 0)
    check("forward delete at the end is a NO-OP", prism_richedit.prism_re_text(unwrap(prism_richedit.prism_re_delete_forward(e0))) == "hello")

    print("5. ★ non-ASCII caret arithmetic (byte length would corrupt it)")
    let jp = _ed("日本語")
    check("caret at 3 code points, not 9 bytes", prism_richedit.prism_re_caret(jp) == 3)
    let jp2 = unwrap(prism_richedit.prism_re_insert(unwrap(prism_richedit.prism_re_move_to(jp, 1)), "テス"))
    check("insert between CJK chars", prism_richedit.prism_re_text(jp2) == "日テス本語")
    check("caret advanced by 2 CODE POINTS, not 6 bytes", prism_richedit.prism_re_caret(jp2) == 3)
    check("backspace removes one CJK char whole", prism_richedit.prism_re_text(unwrap(prism_richedit.prism_re_backspace(jp))) == "日本")

    print("6. ★ marks: has_mark is ALL, not ANY")
    let doc = unwrap(prism_textmodel.prism_tm_plain("abcd"))
    let ed = unwrap(prism_richedit.prism_re_new(doc))
    let s02 = unwrap(prism_richedit.prism_re_select(ed, 0, 2))
    let bolded = unwrap(prism_richedit.prism_re_toggle_mark(s02, prism_textmodel.prism_tm_mark_bold()))
    check("toggling on a selection applies the mark", unwrap(prism_richedit.prism_re_has_mark(bolded, prism_textmodel.prism_tm_mark_bold())))
    check("the selection is PRESERVED across a toggle", prism_richedit.prism_re_caret(bolded) == prism_richedit.prism_re_caret(s02))
    // Half-bold: 0..2 is bold, 2..4 is not. ALL-semantics must report FALSE here.
    let half = unwrap(prism_richedit.prism_re_select(bolded, 0, 4))
    check("a HALF-bold selection reports NOT bold (ALL, not ANY)", not unwrap(prism_richedit.prism_re_has_mark(half, prism_textmodel.prism_tm_mark_bold())))
    // ...so toggling makes the WHOLE range bold, rather than unbolding the bold half.
    let allbold = unwrap(prism_richedit.prism_re_toggle_mark(half, prism_textmodel.prism_tm_mark_bold()))
    check("toggling a half-bold range BOLDS the whole of it", unwrap(prism_richedit.prism_re_has_mark(allbold, prism_textmodel.prism_tm_mark_bold())))
    check("toggling again UNbolds it", not unwrap(prism_richedit.prism_re_has_mark(unwrap(prism_richedit.prism_re_toggle_mark(allbold, prism_textmodel.prism_tm_mark_bold())), prism_textmodel.prism_tm_mark_bold())))
    check("text is unchanged by marking", prism_richedit.prism_re_text(allbold) == "abcd")

    print("7. ★ a collapsed caret cannot be marked")
    check("toggle with nothing selected is REJECTED", is_err(prism_richedit.prism_re_toggle_mark(ed, prism_textmodel.prism_tm_mark_bold())))
    check("has_mark with nothing selected is REJECTED", is_err(prism_richedit.prism_re_has_mark(ed, prism_textmodel.prism_tm_mark_bold())))

    print("8. selection commands validate")
    check("select beyond the document is rejected", is_err(prism_richedit.prism_re_select(e0, 0, 99)))
    check("move beyond the document is rejected", is_err(prism_richedit.prism_re_move_to(e0, 99)))
    let all = unwrap(prism_richedit.prism_re_select_all(e0))
    check("select_all spans the document", prism_select.prism_sel_lo(prism_richedit.prism_re_sel(all)) == 0 and prism_select.prism_sel_hi(prism_richedit.prism_re_sel(all)) == 5)
    check("select_all then insert replaces everything", prism_richedit.prism_re_text(unwrap(prism_richedit.prism_re_insert(all, "new"))) == "new")

    print("")
    if STATS[1] == 0
        print("_kat_prism_richedit: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_richedit: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
