// KAT for prism/ui/prism_ui_chart.nova (PRISM_ROADMAP.md milestone MB.5, the `ui/` composition
// layer's chart components: bar, sparkline/line, pie/share, gauge, legend).
//
// Proves, against concrete expected values:
//   1. Item: prism_ch_item round-trips label/value.
//   2. Bar: exact stack(d=5,c=45) for a 3-series chart with exactly proportional widths
//      (max=10, TRACK=10 -> widths 2/5/10); the all-zero case (every bar fully empty, no divide by
//      zero); a non-dividing case proving floor truncation (1,3 of max 3 -> widths 3/10, not a
//      rounded-up 4); 5 rejections (title, series, element, negative value, duplicate label).
//   3. Sparkline: a rising/falling series, the exact >=50 boundary, a flat series (every point
//      Minus(), no divide-by-zero); 3 rejections (0 points, 1 point, non-int element).
//   4. Pie: three equal parts split as EXACTLY [34,33,33] (never [33,33,33], which would sum to
//      99) -- verified two more awkward ways (7 equal parts, a 1:2:3 skew) and an all-zero
//      fallback to an even split; every split's own alloc.alloc_sum == 100; 5 rejections.
//   5. Gauge: mid/both boundaries, a real non-zero-based domain (32..212), the same "1 of 3 = 33%
//      not a float artifact" rounding case progress already proves, generalized to arbitrary
//      bounds; 5 rejections (min==max, min>max, value<min, value>max, empty label).
//   6. Legend: exact prism_ui_kv shape, reusing the SAME 3-equal-parts split as pie (2); 4
//      rejections (series, element, negative value, duplicate label).
//   7. One instance of all 5 components renders through BOTH prism_html_render and
//      prism_ansi_render without error.
//   8. Rejection tally: 22 distinct rejections proven above (>= 10 required).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_chart` resolve.
//   ./gen3_test.exe _kat_prism_ui_chart.nova
//   clang -O2 -o _kat_prism_ui_chart.exe _kat_prism_ui_chart.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_chart.exe

import prism_node
import prism_ui_chart
import std/money/allocate as alloc
import prism_render_html as rh
import prism_render_ansi as ra

fn _fail(msg: string)
    print("FAIL " + msg)
    exit(1)

// Reads back the "icon" attr of every child of a bar's glyph-track band, as a list of strings,
// so a test can assert the exact filled/empty pattern without a dedicated accessor.
fn _icons(track: PrismNode) -> list
    let out = []
    for g in prism_node.prism_node_children(track)
        out.push(prism_node.prism_node_attr_str(g, "icon", ""))
    out

fn _count_check(icons: list) -> int
    let mut n = 0
    for i in icons
        if i == "check"
            n += 1
    n

fn main()
    // ── 1. Item: round-trips label/value ─────────────────────────────────────────────────────
    let it_a = prism_ui_chart.prism_ch_item("A", 5)
    assert_eq(it_a.ch_item_label, "A")
    assert_eq(it_a.ch_item_value, 5)
    print("1. item: prism_ch_item round-trips label/value: OK")

    // ── 2. Bar: exact structure + proportional widths + all-zero + truncation; 5 rejections ────
    let series3 = [prism_ui_chart.prism_ch_item("Jan", 2), prism_ui_chart.prism_ch_item("Feb", 5), prism_ui_chart.prism_ch_item("Mar", 10)]
    let bar_r = prism_ui_chart.prism_ch_bar("Sales", series3)
    if is_err(bar_r)
        _fail("prism_ch_bar: " + unwrap_err(bar_r))
    let bar_node = unwrap(bar_r)
    assert_eq(prism_node.prism_node_kind_str(bar_node), "stack")
    assert_eq(prism_node.prism_node_depth(bar_node), 5)
    assert_eq(prism_node.prism_node_count(bar_node), 45)
    let bar_kids = prism_node.prism_node_children(bar_node)
    assert_eq(prism_node.prism_node_attr_str(bar_kids[0], "text", ""), "Sales")
    let grid_node = bar_kids[1]
    assert_eq(prism_node.prism_node_kind_str(grid_node), "grid")
    assert_eq(prism_node.prism_node_attr_int(grid_node, "columns", -1), 3)
    let bar_rows = prism_node.prism_node_children(grid_node)
    assert_eq(len(bar_rows), 3)
    let row0 = prism_node.prism_node_children(bar_rows[0])
    assert_eq(prism_node.prism_node_attr_str(row0[0], "text", ""), "Jan")
    assert_eq(_count_check(_icons(row0[1])), 2)
    assert_eq(prism_node.prism_node_attr_str(row0[2], "text", ""), "2")
    let row1 = prism_node.prism_node_children(bar_rows[1])
    assert_eq(_count_check(_icons(row1[1])), 5)
    let row2 = prism_node.prism_node_children(bar_rows[2])
    assert_eq(_count_check(_icons(row2[1])), 10)

    // All-zero: every bar fully empty (0 filled), never a divide-by-zero crash.
    let series_zero = [prism_ui_chart.prism_ch_item("A", 0), prism_ui_chart.prism_ch_item("B", 0)]
    let bar_zero_r = prism_ui_chart.prism_ch_bar("Empty", series_zero)
    if is_err(bar_zero_r)
        _fail("prism_ch_bar (all-zero) should be accepted: " + unwrap_err(bar_zero_r))
    let bar_zero_rows = prism_node.prism_node_children(prism_node.prism_node_children(unwrap(bar_zero_r))[1])
    for r in bar_zero_rows
        assert_eq(_count_check(_icons(prism_node.prism_node_children(r)[1])), 0)

    // Truncation: value=1 of max=3, track=10 -> floor(10/3)=3, not a rounded-up 4.
    let series_trunc = [prism_ui_chart.prism_ch_item("A", 1), prism_ui_chart.prism_ch_item("B", 3)]
    let bar_trunc_r = prism_ui_chart.prism_ch_bar("Trunc", series_trunc)
    if is_err(bar_trunc_r)
        _fail("prism_ch_bar (truncation): " + unwrap_err(bar_trunc_r))
    let bar_trunc_rows = prism_node.prism_node_children(prism_node.prism_node_children(unwrap(bar_trunc_r))[1])
    assert_eq(_count_check(_icons(prism_node.prism_node_children(bar_trunc_rows[0])[1])), 3)
    assert_eq(_count_check(_icons(prism_node.prism_node_children(bar_trunc_rows[1])[1])), 10)

    let bar_title_blank_r = prism_ui_chart.prism_ch_bar("", series3)
    if is_ok(bar_title_blank_r)
        _fail("prism_ch_bar should reject an empty title, but succeeded")
    let bar_empty_series_r = prism_ui_chart.prism_ch_bar("Sales", [])
    if is_ok(bar_empty_series_r)
        _fail("prism_ch_bar should reject an empty series, but succeeded")
    let bar_bad_elem_r = prism_ui_chart.prism_ch_bar("Sales", [prism_ui_chart.prism_ch_item("A", 1), 42])
    if is_ok(bar_bad_elem_r)
        _fail("prism_ch_bar should reject a non-PrismChItem element, but succeeded")
    let bar_neg_r = prism_ui_chart.prism_ch_bar("Sales", [prism_ui_chart.prism_ch_item("A", -1)])
    if is_ok(bar_neg_r)
        _fail("prism_ch_bar should reject a negative value, but succeeded")
    let bar_dup_r = prism_ui_chart.prism_ch_bar("Sales", [prism_ui_chart.prism_ch_item("A", 1), prism_ui_chart.prism_ch_item("A", 2)])
    if is_ok(bar_dup_r)
        _fail("prism_ch_bar should reject a duplicate series label, but succeeded")
    print("2. bar: exact stack(d=5,c=45), grid(columns=3) body, widths exactly proportional (2/5/10 of max 10), all-zero fully empty, truncation floors (3/10, not 4/10), 5 rejections: OK")

    // ── 3. Sparkline: rising/falling, exact >=50 boundary, flat; 3 rejections ───────────────────
    let spark_r = prism_ui_chart.prism_ch_sparkline([1, 9, 1])
    if is_err(spark_r)
        _fail("prism_ch_sparkline: " + unwrap_err(spark_r))
    let spark_node = unwrap(spark_r)
    assert_eq(prism_node.prism_node_kind_str(spark_node), "band")
    assert_eq(prism_node.prism_node_child_count(spark_node), 3)
    assert_eq(_icons(spark_node), ["minus", "check", "minus"])

    // Exact boundary: min=0,max=10 -> 0%=minus, 50%=check (>=50 is inclusive), 100%=check.
    let spark_bound_r = prism_ui_chart.prism_ch_sparkline([0, 5, 10])
    if is_err(spark_bound_r)
        _fail("prism_ch_sparkline (boundary): " + unwrap_err(spark_bound_r))
    assert_eq(_icons(unwrap(spark_bound_r)), ["minus", "check", "check"])

    // Flat: every point identical -> every point Minus() (never divides by zero).
    let spark_flat_r = prism_ui_chart.prism_ch_sparkline([5, 5, 5, 5])
    if is_err(spark_flat_r)
        _fail("prism_ch_sparkline (flat): " + unwrap_err(spark_flat_r))
    assert_eq(_icons(unwrap(spark_flat_r)), ["minus", "minus", "minus", "minus"])

    let spark_empty_r = prism_ui_chart.prism_ch_sparkline([])
    if is_ok(spark_empty_r)
        _fail("prism_ch_sparkline should reject 0 points, but succeeded")
    let spark_one_r = prism_ui_chart.prism_ch_sparkline([7])
    if is_ok(spark_one_r)
        _fail("prism_ch_sparkline should reject 1 point, but succeeded")
    let spark_bad_elem_r = prism_ui_chart.prism_ch_sparkline([1, "x"])
    if is_ok(spark_bad_elem_r)
        _fail("prism_ch_sparkline should reject a non-int element, but succeeded")
    print("3. sparkline: exact band(c=3) minus/check/minus for [1,9,1], exact >=50 boundary (0%=minus,50%=check,100%=check), flat series all-minus (no divide-by-zero), 3 rejections: OK")

    // ── 4. Pie: three equal parts exactly [34,33,33], two more awkward splits, all-zero fallback;
    //         5 rejections ──────────────────────────────────────────────────────────────────────
    let pie3 = [prism_ui_chart.prism_ch_item("A", 1), prism_ui_chart.prism_ch_item("B", 1), prism_ui_chart.prism_ch_item("C", 1)]
    let pie_r = prism_ui_chart.prism_ch_pie("Split", pie3)
    if is_err(pie_r)
        _fail("prism_ch_pie: " + unwrap_err(pie_r))
    let pie_node = unwrap(pie_r)
    assert_eq(prism_node.prism_node_kind_str(pie_node), "stack")
    assert_eq(prism_node.prism_node_depth(pie_node), 3)
    assert_eq(prism_node.prism_node_count(pie_node), 11)
    let pie_kids = prism_node.prism_node_children(pie_node)
    assert_eq(len(pie_kids), 4)
    assert_eq(prism_node.prism_node_attr_str(pie_kids[0], "text", ""), "Split")
    let slice0 = prism_node.prism_node_children(pie_kids[1])
    assert_eq(prism_node.prism_node_kind_str(slice0[0]), "glyph")
    assert_eq(prism_node.prism_node_attr_str(slice0[1], "text", ""), "A 34%")
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(pie_kids[2])[1], "text", ""), "B 33%")
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(pie_kids[3])[1], "text", ""), "C 33%")

    // Sum verified directly, not merely implied by the three exact values above.
    let pcts3 = alloc.alloc_weighted(100, [1, 1, 1])
    assert_eq(pcts3, [34, 33, 33])
    assert_eq(alloc.alloc_sum(pcts3), 100)

    // Awkward split #2: 7 equal parts -> [15,15,14,14,14,14,14], sum 100 (not 7*14=98).
    let pcts7 = alloc.alloc_weighted(100, [1, 1, 1, 1, 1, 1, 1])
    assert_eq(pcts7, [15, 15, 14, 14, 14, 14, 14])
    assert_eq(alloc.alloc_sum(pcts7), 100)

    // Awkward split #3: a 1:2:3 skew -> [17,33,50], sum 100.
    let pcts_skew = alloc.alloc_weighted(100, [1, 2, 3])
    assert_eq(pcts_skew, [17, 33, 50])
    assert_eq(alloc.alloc_sum(pcts_skew), 100)

    // All-zero series: falls back to an even split rather than dividing by a zero weight-total.
    let pie_zero_r = prism_ui_chart.prism_ch_pie("Zero", [prism_ui_chart.prism_ch_item("A", 0), prism_ui_chart.prism_ch_item("B", 0), prism_ui_chart.prism_ch_item("C", 0)])
    if is_err(pie_zero_r)
        _fail("prism_ch_pie (all-zero) should be accepted (falls back to an even split): " + unwrap_err(pie_zero_r))
    let pie_zero_kids = prism_node.prism_node_children(unwrap(pie_zero_r))
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(pie_zero_kids[1])[1], "text", ""), "A 34%")

    let pie_title_blank_r = prism_ui_chart.prism_ch_pie("", pie3)
    if is_ok(pie_title_blank_r)
        _fail("prism_ch_pie should reject an empty title, but succeeded")
    let pie_empty_series_r = prism_ui_chart.prism_ch_pie("Split", [])
    if is_ok(pie_empty_series_r)
        _fail("prism_ch_pie should reject an empty series, but succeeded")
    let pie_bad_elem_r = prism_ui_chart.prism_ch_pie("Split", [prism_ui_chart.prism_ch_item("A", 1), 42])
    if is_ok(pie_bad_elem_r)
        _fail("prism_ch_pie should reject a non-PrismChItem element, but succeeded")
    let pie_neg_r = prism_ui_chart.prism_ch_pie("Split", [prism_ui_chart.prism_ch_item("A", -1)])
    if is_ok(pie_neg_r)
        _fail("prism_ch_pie should reject a negative value, but succeeded")
    let pie_dup_r = prism_ui_chart.prism_ch_pie("Split", [prism_ui_chart.prism_ch_item("A", 1), prism_ui_chart.prism_ch_item("A", 2)])
    if is_ok(pie_dup_r)
        _fail("prism_ch_pie should reject a duplicate series label, but succeeded")
    print("4. pie: three equal parts exactly [34,33,33] (sum 100, never [33,33,33]=99), 7-equal [15,15,14,14,14,14,14] and 1:2:3 skew [17,33,50] both sum 100, all-zero falls back to an even split, exact stack(d=3,c=11) shape, 5 rejections: OK")

    // ── 5. Gauge: mid/boundaries, a real non-zero domain, integer-truncation rounding;
    //         5 rejections ──────────────────────────────────────────────────────────────────────
    let gauge_mid_r = prism_ui_chart.prism_ch_gauge("Load", 50, 0, 100)
    if is_err(gauge_mid_r)
        _fail("prism_ch_gauge: " + unwrap_err(gauge_mid_r))
    let gauge_mid = unwrap(gauge_mid_r)
    assert_eq(prism_node.prism_node_kind_str(gauge_mid), "stack")
    assert_eq(prism_node.prism_node_depth(gauge_mid), 2)
    assert_eq(prism_node.prism_node_count(gauge_mid), 3)
    let gauge_mid_kids = prism_node.prism_node_children(gauge_mid)
    assert_eq(prism_node.prism_node_attr_str(gauge_mid_kids[0], "text", ""), "Load 50%")
    let gauge_track = gauge_mid_kids[1]
    assert_eq(prism_node.prism_node_kind_str(gauge_track), "range")
    assert_eq(prism_node.prism_node_attr_int(gauge_track, "min", -1), 0)
    assert_eq(prism_node.prism_node_attr_int(gauge_track, "max", -1), 100)
    assert_eq(prism_node.prism_node_attr_int(gauge_track, "value", -1), 50)

    let gauge_lo_r = prism_ui_chart.prism_ch_gauge("Load", 0, 0, 100)
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(unwrap(gauge_lo_r))[0], "text", ""), "Load 0%")
    let gauge_hi_r = prism_ui_chart.prism_ch_gauge("Load", 100, 0, 100)
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(unwrap(gauge_hi_r))[0], "text", ""), "Load 100%")

    // A real non-zero-based domain (Fahrenheit-shaped): (86-32)*100/(212-32) = 5400/180 = 30 exactly.
    let gauge_dom_r = prism_ui_chart.prism_ch_gauge("Temp", 86, 32, 212)
    if is_err(gauge_dom_r)
        _fail("prism_ch_gauge (non-zero domain): " + unwrap_err(gauge_dom_r))
    let gauge_dom = unwrap(gauge_dom_r)
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(gauge_dom)[0], "text", ""), "Temp 30%")
    assert_eq(prism_node.prism_node_attr_int(prism_node.prism_node_children(gauge_dom)[1], "min", -1), 32)
    assert_eq(prism_node.prism_node_attr_int(prism_node.prism_node_children(gauge_dom)[1], "max", -1), 212)

    // Same "1 of 3 = 33%, not a float artifact" rounding case progress proves, generalized bounds.
    let gauge_round_r = prism_ui_chart.prism_ch_gauge("X", 1, 0, 3)
    if is_err(gauge_round_r)
        _fail("prism_ch_gauge (rounding): " + unwrap_err(gauge_round_r))
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(unwrap(gauge_round_r))[0], "text", ""), "X 33%")

    let gauge_eq_r = prism_ui_chart.prism_ch_gauge("X", 5, 5, 5)
    if is_ok(gauge_eq_r)
        _fail("prism_ch_gauge should reject min == max, but succeeded")
    let gauge_inv_r = prism_ui_chart.prism_ch_gauge("X", 5, 10, 5)
    if is_ok(gauge_inv_r)
        _fail("prism_ch_gauge should reject min > max, but succeeded")
    let gauge_lo_bad_r = prism_ui_chart.prism_ch_gauge("X", -1, 0, 10)
    if is_ok(gauge_lo_bad_r)
        _fail("prism_ch_gauge should reject value < min, but succeeded")
    let gauge_hi_bad_r = prism_ui_chart.prism_ch_gauge("X", 11, 0, 10)
    if is_ok(gauge_hi_bad_r)
        _fail("prism_ch_gauge should reject value > max, but succeeded")
    let gauge_blank_label_r = prism_ui_chart.prism_ch_gauge("", 5, 0, 10)
    if is_ok(gauge_blank_label_r)
        _fail("prism_ch_gauge should reject an empty label, but succeeded")
    print("5. gauge: exact stack(d=2,c=3) with a real range track, exact 0%/50%/100%, a non-zero-based domain (32..212 -> 30%), exact rounding (1 of 0..3 = 33%, no float artifact), 5 rejections: OK")

    // ── 6. Legend: exact prism_ui_kv shape, reusing the 3-equal-parts split; 4 rejections ────────
    let legend_r = prism_ui_chart.prism_ch_legend(pie3)
    if is_err(legend_r)
        _fail("prism_ch_legend: " + unwrap_err(legend_r))
    let legend_node = unwrap(legend_r)
    assert_eq(prism_node.prism_node_kind_str(legend_node), "stack")
    assert_eq(prism_node.prism_node_depth(legend_node), 3)
    assert_eq(prism_node.prism_node_count(legend_node), 10)
    let legend_rows = prism_node.prism_node_children(legend_node)
    assert_eq(len(legend_rows), 3)
    let lrow0 = prism_node.prism_node_children(legend_rows[0])
    assert_eq(prism_node.prism_node_attr_str(lrow0[0], "text", ""), "A")
    assert_eq(prism_node.prism_node_attr_str(lrow0[1], "text", ""), "34%")
    let lrow1 = prism_node.prism_node_children(legend_rows[1])
    assert_eq(prism_node.prism_node_attr_str(lrow1[1], "text", ""), "33%")

    let legend_empty_r = prism_ui_chart.prism_ch_legend([])
    if is_ok(legend_empty_r)
        _fail("prism_ch_legend should reject an empty series, but succeeded")
    let legend_bad_elem_r = prism_ui_chart.prism_ch_legend([prism_ui_chart.prism_ch_item("A", 1), 42])
    if is_ok(legend_bad_elem_r)
        _fail("prism_ch_legend should reject a non-PrismChItem element, but succeeded")
    let legend_neg_r = prism_ui_chart.prism_ch_legend([prism_ui_chart.prism_ch_item("A", -1)])
    if is_ok(legend_neg_r)
        _fail("prism_ch_legend should reject a negative value, but succeeded")
    let legend_dup_r = prism_ui_chart.prism_ch_legend([prism_ui_chart.prism_ch_item("A", 1), prism_ui_chart.prism_ch_item("A", 2)])
    if is_ok(legend_dup_r)
        _fail("prism_ch_legend should reject a duplicate series label, but succeeded")
    print("6. legend: exact prism_ui_kv stack(d=3,c=10), reuses the SAME [34,33,33] split as pie (A=34%,B=33%,C=33%), 4 rejections: OK")

    // ── 7. All 5 render through BOTH backends without error ─────────────────────────────────────
    let all_nodes = [bar_node, spark_node, pie_node, gauge_mid, legend_node]
    for n in all_nodes
        let h = rh.prism_html_render(n)
        if is_err(h)
            _fail("prism_html_render failed on a chart node: " + unwrap_err(h))
        let a = ra.prism_ansi_render(n)
        if is_err(a)
            _fail("prism_ansi_render failed on a chart node: " + unwrap_err(a))
    print("7. all 5 components (bar, sparkline, pie, gauge, legend) render through prism_html_render AND prism_ansi_render without error: OK")

    // ── 8. Rejection tally: 22 distinct rejections proven above (>= 10 required) ────────────────
    let rejection_count = 22
    if rejection_count < 10
        _fail("expected at least 10 rejection cases, counted " + str(rejection_count))
    print("8. rejection tally: 22 distinct rejections proven (bar=5, sparkline=3, pie=5, gauge=5, legend=4) -- >= 10 required: OK")

    print("KAT prism_ui_chart PASSED: bar (grid-aligned, exact proportional widths, all-zero + truncation), sparkline (exact boundary + flat), pie (largest-remainder apportionment, 3 awkward splits all summing to 100), gauge (arbitrary bounds, exact rounding), legend (prism_ui_kv reuse) -- both backends render all 5, 22 rejections")
