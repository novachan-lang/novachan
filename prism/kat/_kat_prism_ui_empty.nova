import prism_node
import prism_content
import prism_ui_empty

fn main()
    let mut pass = 0
    let mut fail = 0

    // ---- prism_em_empty: happy path ----
    let r1 = prism_ui_empty.prism_em_empty("Nothing here yet")
    if is_ok(r1)
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_empty happy path should be ok")

    let n1 = unwrap(r1)
    if prism_node.prism_node_kind_str(n1) == "stack"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_empty kind should be stack")

    let n1_children = prism_node.prism_node_children(n1)
    if len(n1_children) == 2
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_empty should have 2 children (icon, message)")

    let n1_icon = n1_children[0]
    if prism_node.prism_node_kind_str(n1_icon) == "glyph"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_empty first child should be glyph")

    let n1_msg = n1_children[1]
    if prism_node.prism_node_kind_str(n1_msg) == "label"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_empty second child should be label")

    if prism_node.prism_node_attr_str(n1_msg, "text", "") == "Nothing here yet"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_empty label text mismatch")

    // ---- prism_em_empty: error path ----
    let r2 = prism_ui_empty.prism_em_empty("")
    if is_err(r2)
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_empty empty message should error")

    if unwrap_err(r2) == "prism_em_empty: message must not be empty"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_empty error message mismatch")

    // ---- prism_em_action: happy path ----
    let r3 = prism_ui_empty.prism_em_action("No items found", "Add Item")
    if is_ok(r3)
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action happy path should be ok")

    let n3 = unwrap(r3)
    if prism_node.prism_node_kind_str(n3) == "stack"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action kind should be stack")

    let n3_children = prism_node.prism_node_children(n3)
    if len(n3_children) == 3
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action should have 3 children (icon, message, button)")

    if prism_node.prism_node_kind_str(n3_children[0]) == "glyph"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action first child should be glyph")

    if prism_node.prism_node_kind_str(n3_children[1]) == "label"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action second child should be label")

    if prism_node.prism_node_attr_str(n3_children[1], "text", "") == "No items found"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action message text mismatch")

    let n3_btn = n3_children[2]
    if prism_node.prism_node_kind_str(n3_btn) == "press"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action third child should be press")

    let n3_btn_children = prism_node.prism_node_children(n3_btn)
    if len(n3_btn_children) == 1
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action button should have 1 child (label)")

    if prism_node.prism_node_attr_str(n3_btn_children[0], "text", "") == "Add Item"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action button label text mismatch")

    // ---- prism_em_action: error paths ----
    let r4 = prism_ui_empty.prism_em_action("", "Add Item")
    if is_err(r4)
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action empty message should error")

    let r5 = prism_ui_empty.prism_em_action("No items found", "")
    if is_err(r5)
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action empty action_label should error")

    if unwrap_err(r5) == "prism_em_action: action_label must not be empty"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_action action_label error message mismatch")

    // ---- prism_em_error: happy path, no detail ----
    let r6 = prism_ui_empty.prism_em_error("Something went wrong", "")
    if is_ok(r6)
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_error no-detail should be ok")

    let n6 = unwrap(r6)
    let n6_children = prism_node.prism_node_children(n6)
    if len(n6_children) == 2
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_error no-detail should have 2 children")

    if prism_node.prism_node_kind_str(n6_children[0]) == "glyph"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_error first child should be glyph (warning)")

    if prism_node.prism_node_attr_str(n6_children[1], "text", "") == "Something went wrong"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_error title text mismatch")

    // ---- prism_em_error: happy path, with detail ----
    let r7 = prism_ui_empty.prism_em_error("Load failed", "Network timeout after 30s")
    if is_ok(r7)
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_error with-detail should be ok")

    let n7 = unwrap(r7)
    let n7_children = prism_node.prism_node_children(n7)
    if len(n7_children) == 3
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_error with-detail should have 3 children")

    if prism_node.prism_node_attr_str(n7_children[1], "text", "") == "Load failed"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_error with-detail title text mismatch")

    if prism_node.prism_node_attr_str(n7_children[2], "text", "") == "Network timeout after 30s"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_error detail text mismatch")

    // ---- prism_em_error: error path ----
    let r8 = prism_ui_empty.prism_em_error("", "some detail")
    if is_err(r8)
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_error empty title should error")

    if unwrap_err(r8) == "prism_em_error: title must not be empty"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_error title error message mismatch")

    // ---- prism_em_custom: happy path ----
    let custom_icon = unwrap(prism_content.prism_glyph(prism_content.prism_icon_info()))
    let custom_a = unwrap(prism_content.prism_label("Line A"))
    let custom_b = unwrap(prism_content.prism_label("Line B"))
    let r9 = prism_ui_empty.prism_em_custom(custom_icon, [custom_a, custom_b])
    if is_ok(r9)
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_custom happy path should be ok")

    let n9 = unwrap(r9)
    let n9_children = prism_node.prism_node_children(n9)
    if len(n9_children) == 3
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_custom should have 3 children (icon + 2 content)")

    if prism_node.prism_node_kind_str(n9_children[0]) == "glyph"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_custom first child should be the icon (glyph)")

    if prism_node.prism_node_attr_str(n9_children[1], "text", "") == "Line A"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_custom second child text mismatch")

    if prism_node.prism_node_attr_str(n9_children[2], "text", "") == "Line B"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_custom third child text mismatch")

    // ---- prism_em_custom: error path - empty content ----
    let r10 = prism_ui_empty.prism_em_custom(custom_icon, [])
    if is_err(r10)
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_custom empty content should error")

    if unwrap_err(r10) == "prism_em_custom: content must not be empty"
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_custom empty content error message mismatch")

    // ---- prism_em_custom: error path - non-PrismNode content ----
    let r11 = prism_ui_empty.prism_em_custom(custom_icon, [custom_a, 42])
    if is_err(r11)
        pass += 1
    else
        fail += 1
        print("FAIL: prism_em_custom non-PrismNode content should error")

    print("")
    print("prism_ui_empty KAT: " + str(pass) + " passed, " + str(fail) + " failed")
    if fail > 0
        panic("KAT FAILURES: " + str(fail))
