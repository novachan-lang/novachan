// KAT for prism/ui/prism_ui_wizard.nova (PRISM_ROADMAP.md milestone MB.26, the `ui/` composition
// layer's wizard/multi-step-form components: step header, page, nav, and the combined wizard).
//
// Every expected shape below is hand-computed from `prism_node.prism_node_new`'s own depth/count
// rule (leaf: depth=1, count=1; branch with N children: depth=max(child depths)+1,
// count=1+sum(child counts); a branch built with ZERO children, e.g. `press(text, [])`, is
// depth=1, count=1, identical to a leaf) -- never taken on faith from the implementation. Proves,
// against concrete expected values:
//   1. Step header: index < current -> band[glyph(check), label] (depth 2, count 3); index ==
//      current -> band[glyph(chevron_right), label] (depth 2, count 3); index > current -> bare
//      label (depth 1, count 1) with NO icon at all. Exercised at the first, a middle, and the
//      last position of a 3-step run, each with a hand-derived band depth/count. Rejects an empty
//      wz_steps, a non-string element (named by index and actual type), current < 0, current >=
//      len(steps).
//   2. Page: exact stack[label(title), content] shape for both a leaf and a multi-node content
//      tree. Rejects an empty wz_title.
//   3. Nav: step 0 -> band[next] only (depth 2, count 2); a middle step -> band[back, next]
//      (depth 2, count 3); the LAST step -> the identical band[back, next] shape as a middle step
//      (proves the header's "no third shape for last step" claim structurally, not just by
//      reading the code). Rejects wz_total < 1, current < 0, current >= total, an empty
//      wz_back_label EVEN AT STEP 0 (unconditional validation, see file header), an empty
//      wz_next_label.
//   4. Wizard: exact stack[header, content, nav] shape, first with a plain label as content, then
//      with a `prism_wz_page`-built page as content (proving the documented "compose page() into
//      wizard() as content" pattern), both depths/counts derived arithmetically from parts 1-3
//      above. Rejects the union of what step_header and nav each reject.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_wizard` resolve.
//   ./gen3_test.exe _kat_prism_ui_wizard.nova
//   clang -O2 -o _kat_prism_ui_wizard.exe _kat_prism_ui_wizard.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_wizard.exe

import prism_node
import prism_content
import prism_arrange
import prism_ui_wizard

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn _lbl(s: string) -> PrismNode
    unwrap(prism_content.prism_label(s))

fn main()
    // ── 1. Step header ───────────────────────────────────────────────────────────────────────
    print("== 1. step header ==")

    let steps3 = ["Account", "Shipping", "Payment"]

    // current == 0 (first step): item0 = chevron band (d2,c3); item1/item2 = bare label (d1,c1).
    // band depth = max(2,1,1)+1 = 3; count = 1 + (3+1+1) = 6.
    let h0 = unwrap(prism_ui_wizard.prism_wz_step_header(steps3, 0))
    _check("header(cur=0) kind == band", prism_node.prism_node_kind_str(h0), "band")
    _check("header(cur=0) depth", str(prism_node.prism_node_depth(h0)), "3")
    _check("header(cur=0) count", str(prism_node.prism_node_count(h0)), "6")
    let h0_kids = prism_node.prism_node_children(h0)
    _check("header(cur=0) child_count", str(prism_node.prism_node_child_count(h0)), "3")
    _check("header(cur=0) item0 kind == band (current, chevron)", prism_node.prism_node_kind_str(h0_kids[0]), "band")
    let h0_item0_kids = prism_node.prism_node_children(h0_kids[0])
    _check("header(cur=0) item0 icon == chevron_right", prism_node.prism_node_attr_str(h0_item0_kids[0], "icon", ""), "chevron_right")
    _check("header(cur=0) item0 label text", prism_node.prism_node_attr_str(h0_item0_kids[1], "text", ""), "Account")
    _check("header(cur=0) item1 kind == label (future, no icon)", prism_node.prism_node_kind_str(h0_kids[1]), "label")
    _check("header(cur=0) item1 text", prism_node.prism_node_attr_str(h0_kids[1], "text", ""), "Shipping")
    _check("header(cur=0) item2 kind == label (future, no icon)", prism_node.prism_node_kind_str(h0_kids[2]), "label")

    // current == 1 (middle step): item0 = check band (d2,c3); item1 = chevron band (d2,c3);
    // item2 = bare label (d1,c1). band depth = max(2,2,1)+1 = 3; count = 1 + (3+3+1) = 8.
    let h1 = unwrap(prism_ui_wizard.prism_wz_step_header(steps3, 1))
    _check("header(cur=1) depth", str(prism_node.prism_node_depth(h1)), "3")
    _check("header(cur=1) count", str(prism_node.prism_node_count(h1)), "8")
    let h1_kids = prism_node.prism_node_children(h1)
    _check("header(cur=1) item0 kind == band (completed, check)", prism_node.prism_node_kind_str(h1_kids[0]), "band")
    let h1_item0_kids = prism_node.prism_node_children(h1_kids[0])
    _check("header(cur=1) item0 icon == check", prism_node.prism_node_attr_str(h1_item0_kids[0], "icon", ""), "check")
    _check("header(cur=1) item1 kind == band (current, chevron)", prism_node.prism_node_kind_str(h1_kids[1]), "band")
    let h1_item1_kids = prism_node.prism_node_children(h1_kids[1])
    _check("header(cur=1) item1 icon == chevron_right", prism_node.prism_node_attr_str(h1_item1_kids[0], "icon", ""), "chevron_right")
    _check("header(cur=1) item2 kind == label (future)", prism_node.prism_node_kind_str(h1_kids[2]), "label")

    // current == 2 (last step): item0/item1 = check band (d2,c3 each); item2 = chevron band
    // (d2,c3). band depth = max(2,2,2)+1 = 3; count = 1 + (3+3+3) = 10.
    let h2 = unwrap(prism_ui_wizard.prism_wz_step_header(steps3, 2))
    _check("header(cur=2, last) depth", str(prism_node.prism_node_depth(h2)), "3")
    _check("header(cur=2, last) count", str(prism_node.prism_node_count(h2)), "10")
    let h2_kids = prism_node.prism_node_children(h2)
    _check("header(cur=2, last) item0 kind == band (completed)", prism_node.prism_node_kind_str(h2_kids[0]), "band")
    _check("header(cur=2, last) item1 kind == band (completed)", prism_node.prism_node_kind_str(h2_kids[1]), "band")
    _check("header(cur=2, last) item2 kind == band (current, chevron -- LAST step still gets an icon)", prism_node.prism_node_kind_str(h2_kids[2]), "band")
    let h2_item2_kids = prism_node.prism_node_children(h2_kids[2])
    _check("header(cur=2, last) item2 icon == chevron_right", prism_node.prism_node_attr_str(h2_item2_kids[0], "icon", ""), "chevron_right")

    // Rejections.
    let h_empty = prism_ui_wizard.prism_wz_step_header([], 0)
    _check_true("header rejects empty wz_steps", is_err(h_empty))
    let h_bad_elem = prism_ui_wizard.prism_wz_step_header(["A", 5, "C"], 1)
    _check_true("header rejects a non-string element", is_err(h_bad_elem))
    if is_err(h_bad_elem)
        _check_true("header's rejection names the offending index and type", find(unwrap_err(h_bad_elem), "1") >= 0 and find(unwrap_err(h_bad_elem), "int") >= 0)
    let h_neg = prism_ui_wizard.prism_wz_step_header(steps3, -1)
    _check_true("header rejects wz_current < 0", is_err(h_neg))
    let h_over = prism_ui_wizard.prism_wz_step_header(steps3, 3)
    _check_true("header rejects wz_current >= len(steps)", is_err(h_over))

    // ── 2. Page ───────────────────────────────────────────────────────────────────────────────
    print("== 2. page ==")

    // Leaf content: stack[label(title), content]. depth = max(1,1)+1 = 2; count = 1+(1+1) = 3.
    let leaf_content = _lbl("Address form")
    let p1 = unwrap(prism_ui_wizard.prism_wz_page("Shipping Address", leaf_content))
    _check("page(leaf content) kind == stack", prism_node.prism_node_kind_str(p1), "stack")
    _check("page(leaf content) depth", str(prism_node.prism_node_depth(p1)), "2")
    _check("page(leaf content) count", str(prism_node.prism_node_count(p1)), "3")
    let p1_kids = prism_node.prism_node_children(p1)
    _check("page(leaf content) title text", prism_node.prism_node_attr_str(p1_kids[0], "text", ""), "Shipping Address")
    _check("page(leaf content) content text (unchanged)", prism_node.prism_node_attr_str(p1_kids[1], "text", ""), "Address form")

    // Multi-node content (a band of two labels, depth 2 count 3): stack depth = max(1,2)+1 = 3;
    // count = 1 + (1+3) = 5.
    let band_content = unwrap(prism_arrange.prism_band([_lbl("First"), _lbl("Last")]))
    let p2 = unwrap(prism_ui_wizard.prism_wz_page("Name", band_content))
    _check("page(band content) depth", str(prism_node.prism_node_depth(p2)), "3")
    _check("page(band content) count", str(prism_node.prism_node_count(p2)), "5")

    // Rejections.
    let p_empty_title = prism_ui_wizard.prism_wz_page("", leaf_content)
    _check_true("page rejects empty wz_title", is_err(p_empty_title))

    // ── 3. Nav ────────────────────────────────────────────────────────────────────────────────
    print("== 3. nav ==")

    // Step 0: next only. band[next]. depth = max(1)+1 = 2; count = 1+1 = 2.
    let n0 = unwrap(prism_ui_wizard.prism_wz_nav(0, 3, "Back", "Next"))
    _check("nav(step 0) kind == band", prism_node.prism_node_kind_str(n0), "band")
    _check("nav(step 0) depth", str(prism_node.prism_node_depth(n0)), "2")
    _check("nav(step 0) count", str(prism_node.prism_node_count(n0)), "2")
    _check("nav(step 0) child_count == 1 (no back button)", str(prism_node.prism_node_child_count(n0)), "1")
    let n0_kids = prism_node.prism_node_children(n0)
    _check("nav(step 0) next kind == press", prism_node.prism_node_kind_str(n0_kids[0]), "press")
    _check("nav(step 0) next text", prism_node.prism_node_attr_str(n0_kids[0], "text", ""), "Next")

    // Middle step: back + next. band[back, next]. depth = max(1,1)+1 = 2; count = 1+(1+1) = 3.
    let n1 = unwrap(prism_ui_wizard.prism_wz_nav(1, 3, "Back", "Next"))
    _check("nav(middle) depth", str(prism_node.prism_node_depth(n1)), "2")
    _check("nav(middle) count", str(prism_node.prism_node_count(n1)), "3")
    _check("nav(middle) child_count == 2", str(prism_node.prism_node_child_count(n1)), "2")
    let n1_kids = prism_node.prism_node_children(n1)
    _check("nav(middle) back kind == press", prism_node.prism_node_kind_str(n1_kids[0]), "press")
    _check("nav(middle) back text", prism_node.prism_node_attr_str(n1_kids[0], "text", ""), "Back")
    _check("nav(middle) next text", prism_node.prism_node_attr_str(n1_kids[1], "text", ""), "Next")

    // LAST step: back + finish, where "finish" is just whatever text the caller passed as
    // wz_next_label -- structurally IDENTICAL band[back, next] shape as the middle step above.
    let n2 = unwrap(prism_ui_wizard.prism_wz_nav(2, 3, "Back", "Finish"))
    _check("nav(last) kind == band (same shape as middle, not a 3rd shape)", prism_node.prism_node_kind_str(n2), "band")
    _check("nav(last) depth", str(prism_node.prism_node_depth(n2)), "2")
    _check("nav(last) count", str(prism_node.prism_node_count(n2)), "3")
    _check("nav(last) child_count == 2 (back present, same as middle)", str(prism_node.prism_node_child_count(n2)), "2")
    let n2_kids = prism_node.prism_node_children(n2)
    _check("nav(last) child0 kind == press (back)", prism_node.prism_node_kind_str(n2_kids[0]), "press")
    _check("nav(last) child1 text == Finish (caller's own label, not a hard-coded word)", prism_node.prism_node_attr_str(n2_kids[1], "text", ""), "Finish")

    // Rejections.
    let n_bad_total = prism_ui_wizard.prism_wz_nav(0, 0, "Back", "Next")
    _check_true("nav rejects wz_total < 1", is_err(n_bad_total))
    let n_neg = prism_ui_wizard.prism_wz_nav(-1, 3, "Back", "Next")
    _check_true("nav rejects wz_current < 0", is_err(n_neg))
    let n_over = prism_ui_wizard.prism_wz_nav(3, 3, "Back", "Next")
    _check_true("nav rejects wz_current >= wz_total", is_err(n_over))
    // Unconditional label validation: an empty wz_back_label is rejected even AT STEP 0, where no
    // back button would ever render (see file header for why).
    let n_bad_back_at_step0 = prism_ui_wizard.prism_wz_nav(0, 3, "", "Next")
    _check_true("nav rejects empty wz_back_label EVEN AT STEP 0 (unconditional validation)", is_err(n_bad_back_at_step0))
    let n_bad_back_mid = prism_ui_wizard.prism_wz_nav(1, 3, "", "Next")
    _check_true("nav rejects empty wz_back_label at a middle step", is_err(n_bad_back_mid))
    let n_bad_next = prism_ui_wizard.prism_wz_nav(0, 3, "Back", "")
    _check_true("nav rejects empty wz_next_label", is_err(n_bad_next))

    // ── 4. Full wizard ────────────────────────────────────────────────────────────────────────
    print("== 4. wizard ==")

    // Plain-label content. header(cur=1 of 3) = d3,c8 (from part 1). content = leaf, d1,c1.
    // nav(cur=1, total=3) = d2,c3 (from part 3). stack depth = max(3,1,2)+1 = 4;
    // count = 1 + (8+1+3) = 13.
    let w_content = _lbl("Form content")
    let w1 = unwrap(prism_ui_wizard.prism_wz_wizard(steps3, 1, w_content, "Back", "Next"))
    _check("wizard kind == stack", prism_node.prism_node_kind_str(w1), "stack")
    _check("wizard depth", str(prism_node.prism_node_depth(w1)), "4")
    _check("wizard count", str(prism_node.prism_node_count(w1)), "13")
    _check("wizard child_count == 3", str(prism_node.prism_node_child_count(w1)), "3")
    let w1_kids = prism_node.prism_node_children(w1)
    _check("wizard child0 kind == band (step header)", prism_node.prism_node_kind_str(w1_kids[0]), "band")
    _check("wizard child0 depth == 3 (matches header(cur=1) alone)", str(prism_node.prism_node_depth(w1_kids[0])), "3")
    _check("wizard child1 kind == label (content, unchanged)", prism_node.prism_node_kind_str(w1_kids[1]), "label")
    _check("wizard child1 text", prism_node.prism_node_attr_str(w1_kids[1], "text", ""), "Form content")
    _check("wizard child2 kind == band (nav)", prism_node.prism_node_kind_str(w1_kids[2]), "band")
    _check("wizard child2 child_count == 2 (back+next, not step 0)", str(prism_node.prism_node_child_count(w1_kids[2])), "2")

    // Composed with `prism_wz_page` as content (the documented "page() feeds into wizard()"
    // pattern from the file header, not a literal internal call). page("Shipping Address", leaf)
    // = d2,c3 (from part 2, p1). header(cur=1 of 3) = d3,c8. nav(cur=1,total=3) = d2,c3.
    // stack depth = max(3,2,2)+1 = 4; count = 1 + (8+3+3) = 15.
    let w_page_content = unwrap(prism_ui_wizard.prism_wz_page("Shipping Address", _lbl("Address form")))
    let w2 = unwrap(prism_ui_wizard.prism_wz_wizard(steps3, 1, w_page_content, "Back", "Next"))
    _check("wizard(page content) depth", str(prism_node.prism_node_depth(w2)), "4")
    _check("wizard(page content) count", str(prism_node.prism_node_count(w2)), "15")
    let w2_kids = prism_node.prism_node_children(w2)
    _check("wizard(page content) child1 kind == stack (the page)", prism_node.prism_node_kind_str(w2_kids[1]), "stack")
    _check("wizard(page content) child1 depth == 2 (matches page() alone)", str(prism_node.prism_node_depth(w2_kids[1])), "2")

    // Step-0 wizard: nav child should have only 1 button.
    let w3 = unwrap(prism_ui_wizard.prism_wz_wizard(steps3, 0, w_content, "Back", "Next"))
    let w3_kids = prism_node.prism_node_children(w3)
    _check("wizard(step 0) nav child_count == 1 (no back)", str(prism_node.prism_node_child_count(w3_kids[2])), "1")

    // Rejections -- the union of step_header's and nav's own.
    let w_empty_steps = prism_ui_wizard.prism_wz_wizard([], 0, w_content, "Back", "Next")
    _check_true("wizard rejects empty wz_steps", is_err(w_empty_steps))
    let w_bad_elem = prism_ui_wizard.prism_wz_wizard(["A", 5], 0, w_content, "Back", "Next")
    _check_true("wizard rejects a non-string step element", is_err(w_bad_elem))
    let w_bad_current = prism_ui_wizard.prism_wz_wizard(steps3, 5, w_content, "Back", "Next")
    _check_true("wizard rejects wz_current out of range", is_err(w_bad_current))
    let w_bad_back = prism_ui_wizard.prism_wz_wizard(steps3, 1, w_content, "", "Next")
    _check_true("wizard rejects empty wz_back_label", is_err(w_bad_back))
    let w_bad_next = prism_ui_wizard.prism_wz_wizard(steps3, 1, w_content, "Back", "")
    _check_true("wizard rejects empty wz_next_label", is_err(w_bad_next))

    // ── Summary ───────────────────────────────────────────────────────────────────────────────
    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_wizard: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_wizard: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
