// KAT for prism/core/prism_key.nova -- keyboard input as a CLOSED, TYPED vocabulary.
//
// The module shipped without a KAT (the agent building it hit its session limit mid-file), so
// this was written afterwards against the module's actual API rather than alongside it. That
// ordering is worth stating: a test written after the fact can only check what the code DOES, so
// it has to work harder to ask what the code SHOULD do. The negative half below is where that
// effort went.
//
// What this proves:
//   1. The vocabulary is CLOSED and complete: all 13 fixed keys round-trip name -> key -> name.
//   2. `from_name` NEVER GUESSES. An unrecognised multi-character name ("F1", "PageUp") is an
//      `err`, not a silently-swallowed no-op key -- guessing here would turn an unhandled key
//      into a wrong action.
//   3. Type-ahead accepts exactly ONE code point, and that is tested with NON-ASCII ("é", "日").
//      An ASCII-only test would pass against a byte-length implementation, which is the exact
//      defect class already found in this codebase (`str_chars` is byte-wise).
//   4. Control characters are rejected -- a lone ESC byte must not become a "character".
//   5. `prism_key_char` errors on all 13 fixed keys, so "the character of Enter" is unreadable
//      rather than a plausible "".

import prism_key

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn _name_of(n: string) -> string
    let k = prism_key.prism_key_from_name(n, false)
    if is_err(k)
        return "ERR"
    prism_key.prism_key_name(unwrap(k))

fn main()
    print("== _kat_prism_key ==")

    print("1. the closed vocabulary round-trips")
    let fixed = prism_key.prism_key_all_fixed()
    check("13 fixed keys (got {len(fixed)})", len(fixed) == 13)
    // Every fixed key's name must parse back to the SAME key. This is the property that keeps the
    // name table and the enum from drifting apart -- add a 14th variant without a name and it
    // fails here by name.
    let round = fixed.map(fn(k) _name_of(prism_key.prism_key_name(k)) == prism_key.prism_key_name(k))
    check("every fixed key round-trips name -> key -> name", not contains(round, false))
    check("names are stable: Enter/Escape/ArrowUp", _name_of("Enter") == "Enter" and _name_of("Escape") == "Escape" and _name_of("ArrowUp") == "ArrowUp")

    print("2. aliases and the shift modifier")
    check("' ' is Space", _name_of(" ") == "Space")
    check("'Space' is Space", _name_of("Space") == "Space")
    check("'Up' aliases ArrowUp", _name_of("Up") == "ArrowUp")
    check("'Down' aliases ArrowDown", _name_of("Down") == "ArrowDown")
    check("'Left' aliases ArrowLeft", _name_of("Left") == "ArrowLeft")
    check("'Right' aliases ArrowRight", _name_of("Right") == "ArrowRight")
    check("Tab without shift is Tab", prism_key.prism_key_name(unwrap(prism_key.prism_key_from_name("Tab", false))) == "Tab")
    // Shift+Tab is its OWN variant, not a flag on Tab: focus-previous is a different action from
    // focus-next, and encoding it as a modifier bit would let both be true at once.
    check("Tab WITH shift is a distinct ShiftTab key", prism_key.prism_key_name(unwrap(prism_key.prism_key_from_name("Tab", true))) == "ShiftTab")
    check("shift does NOT alter a non-Tab key", prism_key.prism_key_name(unwrap(prism_key.prism_key_from_name("Enter", true))) == "Enter")

    print("3. type-ahead is ONE code point -- tested non-ASCII")
    check("ASCII 'a' is a char key", _name_of("a") == "Char:a")
    check("non-ASCII 'é' is ONE code point, accepted", _name_of("é") == "Char:é")
    check("CJK '日' is ONE code point, accepted", _name_of("日") == "Char:日")
    check("digit '7' accepted", _name_of("7") == "Char:7")
    check("the char round-trips out of the key", unwrap(prism_key.prism_key_char(unwrap(prism_key.prism_key_from_name("é", false)))) == "é")

    print("4. from_name NEVER GUESSES")
    // "F1"/"PageUp" are real keys this vocabulary does not model. Rejecting is the honest answer:
    // silently accepting them as two-character text, or mapping them to some nearby key, would
    // turn an unsupported key into a WRONG action rather than no action.
    check("'F1' rejected (unmodelled key, not text)", is_err(prism_key.prism_key_from_name("F1", false)))
    check("'PageUp' rejected", is_err(prism_key.prism_key_from_name("PageUp", false)))
    check("'ab' rejected (two code points is not a key)", is_err(prism_key.prism_key_from_name("ab", false)))
    check("'éé' rejected (two code points, non-ASCII)", is_err(prism_key.prism_key_from_name("éé", false)))
    check("empty name rejected", is_err(prism_key.prism_key_from_name("", false)))
    check("non-string name rejected", is_err(prism_key.prism_key_from_name(7, false)))
    check("ESC control byte rejected, not treated as a character", is_err(prism_key.prism_key_from_name(from_codepoint(27), false)))
    check("DEL (127) rejected", is_err(prism_key.prism_key_from_name(from_codepoint(127), false)))
    check("NUL-ish control (1) rejected", is_err(prism_key.prism_key_from_name(from_codepoint(1), false)))

    print("5. a fixed key carries NO character")
    // All 13, not a sample: "the character of Enter" must be unreadable, not a plausible "".
    let charless = fixed.map(fn(k) is_err(prism_key.prism_key_char(k)))
    check("all 13 fixed keys error on prism_key_char", not contains(charless, false))

    print("6. semantic predicates -- the reason this is typed at all")
    let enter = unwrap(prism_key.prism_key_from_name("Enter", false))
    let space = unwrap(prism_key.prism_key_from_name("Space", false))
    let esc = unwrap(prism_key.prism_key_from_name("Escape", false))
    let down = unwrap(prism_key.prism_key_from_name("ArrowDown", false))
    let right = unwrap(prism_key.prism_key_from_name("ArrowRight", false))
    let up = unwrap(prism_key.prism_key_from_name("ArrowUp", false))
    let home = unwrap(prism_key.prism_key_from_name("Home", false))
    let tab = unwrap(prism_key.prism_key_from_name("Tab", false))
    let shtab = unwrap(prism_key.prism_key_from_name("Tab", true))
    let ch = unwrap(prism_key.prism_key_from_name("a", false))
    check("Enter and Space both activate", prism_key.prism_key_is_activation(enter) and prism_key.prism_key_is_activation(space))
    check("Escape dismisses, Enter does not", prism_key.prism_key_is_dismiss(esc) and not prism_key.prism_key_is_dismiss(enter))
    check("Down and Right are 'next'", prism_key.prism_key_is_next(down) and prism_key.prism_key_is_next(right))
    check("Up is 'prev', not 'next'", prism_key.prism_key_is_prev(up) and not prism_key.prism_key_is_next(up))
    check("Home is step-home", prism_key.prism_key_is_step_home(home))
    check("Tab is focus-next, ShiftTab is focus-prev", prism_key.prism_key_is_focus_next(tab) and prism_key.prism_key_is_focus_prev(shtab))
    check("ShiftTab is NOT focus-next (the two are disjoint)", not prism_key.prism_key_is_focus_next(shtab))
    // A text character must not accidentally satisfy a navigation role -- otherwise typing "a"
    // in a form would also move focus.
    check("a character key satisfies NO navigation predicate", not prism_key.prism_key_is_activation(ch) and not prism_key.prism_key_is_dismiss(ch) and not prism_key.prism_key_is_next(ch) and not prism_key.prism_key_is_focus_next(ch))

    print("7. equality")
    check("same key equal", prism_key.prism_key_eq(enter, unwrap(prism_key.prism_key_from_name("Enter", false))))
    check("different keys not equal", not prism_key.prism_key_eq(enter, esc))
    check("Tab != ShiftTab", not prism_key.prism_key_eq(tab, shtab))

    print("")
    if STATS[1] == 0
        print("_kat_prism_key: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_key: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
