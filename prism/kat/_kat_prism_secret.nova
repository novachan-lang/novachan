// KAT for prism/core/prism_secret.nova -- PrismSecret<T>, PRISM_SPEC.md §15.3.
//
// Proves, against a MARKER plaintext that would be unmistakable if it leaked:
//   1. Constructor validation: label required (empty AND non-string rejected).
//   2. sec_redacted() cannot recover the plaintext -- the SANCTIONED safe display route.
//   3. sec_to_json() cannot recover the plaintext -- the SANCTIONED safe wire route; JSON keys and
//      shape survive so a consumer that only cares about shape is unaffected.
//   4. sec_unwrap IS the sanctioned route to the plaintext, and works exactly as documented.
//   5. field_get also reaches the plaintext -- the SAME LOCK-7 carve-out sec_unwrap uses, recorded
//      here so nobody mistakes it for a bypass this module failed to close.
//   6. sec_eq: equal values compare equal regardless of label; different values compare unequal;
//      proven for T=string (the ct_eq path) AND T=int (the structural-== fallback path).
//   7. ⛔ DOCUMENTED, NOT ASSERTED AS A PASS/FAIL: the bare str()/to_json() builtins are UNSAFE on
//      this type once the file also declares a struct of its own (measured this session -- see
//      prism_secret.nova's header). Printed for visibility, not scored, because it is a compiler
//      defect this module cannot fix, not a property of this module's own (safe) API surface.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set, NOVA_NO_CACHE=1; prism/**/*.nova already
// synced into $NOVA_HOME/lib):
//   ./gen3_test.exe _kat_prism_secret.nova
//   clang -O2 -o _kat_prism_secret.exe _kat_prism_secret.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_secret.exe

import prism_secret

let PASSED = [0]
let FAILED = [0]

fn _ok(label: string)
    print("  ok  " + label)
    PASSED[0] = PASSED[0] + 1

fn _fail(label: string, detail: string)
    print("FAIL " + label + ": " + detail)
    FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool, detail: string)
    if cond
        _ok(label)
    else
        _fail(label, detail)

// A struct that EMBEDS a secret, to demonstrate why an app struct holding one must hand-write its
// own safe display -- see prism_secret.nova's header, "the embedding case inherits the same defect".
type LoginForm
    lf_user: string
    lf_pass: PrismSecret<string>

// The safe way for an app to display a struct that embeds a secret: never let the auto-derived
// show/to_json touch the secret field, call the sanctioned functions for it explicitly instead.
fn login_form_safe_json(f: LoginForm) -> string
    "\{\"lf_user\":" + json_stringify(f.lf_user) + ",\"lf_pass\":" + sec_to_json(f.lf_pass) + "\}"

fn main()
    let MARKER = "hunter2-TOP-SECRET-MARKER-9f3c"

    // (1) constructor validation
    match sec_new("", "x")
        Err(m) => _ok("rejects empty label")
        Ok(s) => _fail("rejects empty label", "constructed with empty label")

    match sec_new(42, "x")
        Err(m) => _ok("rejects non-string label")
        Ok(s) => _fail("rejects non-string label", "constructed with int label")

    let built = sec_new("password", MARKER)
    match built
        Err(m) => _fail("valid construction", "unexpected err: " + m)
        Ok(s) =>
            // (2) sec_redacted -- the sanctioned safe display route
            let disp = sec_redacted(s)
            print("sec_redacted(s) = " + disp)
            _check_true("sec_redacted hides the plaintext", contains(disp, MARKER) == false, "leaked: " + disp)
            _check_true("sec_redacted names the label", contains(disp, "password"), "label missing: " + disp)
            _check_true("sec_redacted shows the mask", contains(disp, "***"), "mask missing: " + disp)

            // (3) sec_to_json -- the sanctioned safe wire route
            let j = sec_to_json(s)
            print("sec_to_json(s) = " + j)
            _check_true("sec_to_json hides the plaintext", contains(j, MARKER) == false, "leaked: " + j)
            _check_true("sec_to_json key sec_value survives", contains(j, "sec_value"), "key missing: " + j)
            _check_true("sec_to_json key sec_label survives", contains(j, "sec_label"), "key missing: " + j)
            _check_true("sec_to_json names the label as a value", contains(j, "password"), "label missing: " + j)

            // nesting via the SAFE hand-written route: an app struct embedding a secret must call
            // sec_to_json() itself for that field rather than rely on auto-derived to_json().
            let form = LoginForm("alice", s)
            let fjson = login_form_safe_json(form)
            print("login_form_safe_json(form) = " + fjson)
            _check_true("hand-written nested json hides the plaintext", contains(fjson, MARKER) == false, "leaked: " + fjson)
            _check_true("hand-written nested json still names the user", contains(fjson, "alice"), "user missing: " + fjson)

            // (4) explicit deliberate unwrap
            let plain = sec_unwrap(s)
            _check_true("sec_unwrap recovers the exact plaintext", plain == MARKER, "got: " + plain)

            // (5) field_get -- documented carve-out, not a bypass
            let via_reflect = field_get(s, "sec_value")
            _check_true("field_get also reaches the plaintext (documented)", via_reflect == MARKER, "got: " + str(via_reflect))

            // (7) DOCUMENTED, NOT SCORED: the bare builtins, shown to be unsafe once a local struct
            // (LoginForm, above) exists in this same file -- exactly the realistic case. This is
            // printed for visibility of the live compiler defect, not asserted pass/fail, because
            // failing HERE would misreport this module's own (safe) API as broken.
            print("[known compiler defect, not scored] str(s) = " + str(s))
            print("[known compiler defect, not scored] to_json(s) = " + to_json(s))

    // (6) sec_eq -- string path (ct_eq) and int path (structural ==)
    match sec_new("a", MARKER)
        Err(m) => _fail("sec_eq setup a", m)
        Ok(sa) =>
            match sec_new("b_different_label", MARKER)
                Err(m) => _fail("sec_eq setup b", m)
                Ok(sb) =>
                    _check_true("sec_eq: same value, different label -> equal", sec_eq(sa, sb), "expected equal")
            match sec_new("a", "not-the-marker")
                Err(m) => _fail("sec_eq setup c", m)
                Ok(sc) =>
                    _check_true("sec_eq: different value -> not equal", sec_eq(sa, sc) == false, "expected unequal")

    match sec_new("pin", 4242)
        Err(m) => _fail("sec_eq int setup", m)
        Ok(pa) =>
            match sec_new("pin2", 4242)
                Err(m) => _fail("sec_eq int setup 2", m)
                Ok(pb) =>
                    _check_true("sec_eq: int T, same value -> equal", sec_eq(pa, pb), "expected equal")
            match sec_new("pin3", 9999)
                Err(m) => _fail("sec_eq int setup 3", m)
                Ok(pc) =>
                    _check_true("sec_eq: int T, different value -> not equal", sec_eq(pa, pc) == false, "expected unequal")

    print("passed=" + str(PASSED[0]) + " failed=" + str(FAILED[0]))
    if FAILED[0] == 0
        print("KAT prism_secret PASS")
    else
        print("KAT prism_secret FAIL")
