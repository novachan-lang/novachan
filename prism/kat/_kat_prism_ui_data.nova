// KAT for prism/ui/prism_ui_data.nova (PRISM_ROADMAP.md milestone MB.3, the `ui/` composition
// layer's data-display components: list, tree, descriptions, stat/metric, timeline).
//
// Proves, against concrete expected values:
//   1. List: exact each/depth=4/count=13 across 4 title/secondary/icon combinations; rejects
//      empty items, an empty title, a non-PrismUiListItem element, and a DUPLICATE KEY --
//      propagated unchanged from prism_each, not re-derived here.
//   2. Tree (happy path): exact stack(d=4,c=11) for a root + 2 leaves; expanded/collapsed state
//      selects the exact chevron icon per node, independent of whether it actually has children.
//   3. Tree (max depth): a 32-level chain succeeds (right at the boundary), a 33-level chain is
//      rejected with the exact "depth exceeds max 32" message (one past the boundary).
//   4. Tree (cycle safety -- THE ONE THAT MATTERS): a self-loop and a 2-node mutual cycle are
//      BOTH rejected immediately via ancestor-path detection, never spinning -- proves the
//      "must not hang" requirement by returning a typed error, not by racing a timeout.
//   5. Descriptions: exact stack(d=3,c=7) over prism_ui_kit.prism_ui_kv; rejects empty pairs.
//   6. Stat: all 3 trends map to a DISTINCT icon (exhaustive match); exact stack shapes with and
//      without delta; a blank Some("") delta degrades to no-delta; rejects empty label/value.
//   7. Timeline: exact stack(d=3,c=6), order preserved exactly, done/active/pending distinguished
//      by the queryable status attr even where active/pending render identically; rejects an
//      empty timeline, an empty event label, a non-PrismUiTimelineEvent element.
//   8. A <script>-bearing list item title renders as escaped TEXT through prism_render_html.
//   9. Rejection tally: 19 distinct rejections proven above (>= 8 required).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_data` resolve.
//   ./gen3_test.exe _kat_prism_ui_data.nova
//   clang -O2 -o _kat_prism_ui_data.exe _kat_prism_ui_data.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_data.exe   (run under Invoke-Timed -- see the cycle-safety section's own note)

import prism_node
import prism_content
import prism_ui_data
import prism_render_html

fn _fail(msg: string)
    print("FAIL " + msg)
    exit(1)

fn main()
    // ── 1. List: exact structure across 4 combinations; 4 rejections ───────────────────────────
    let item_a = prism_ui_data.prism_ui_list_item("Alpha", none(), none())
    let item_b = prism_ui_data.prism_ui_list_item("Beta", some("second line"), none())
    let item_c = prism_ui_data.prism_ui_list_item("Gamma", none(), some(prism_content.prism_icon_check()))
    let item_d = prism_ui_data.prism_ui_list_item("Delta", some("desc"), some(prism_content.prism_icon_info()))
    let key_by_title = fn(it) it.list_title
    let list_r = prism_ui_data.prism_ui_list([item_a, item_b, item_c, item_d], key_by_title)
    if is_err(list_r)
        _fail("prism_ui_list: " + unwrap_err(list_r))
    let list_node = unwrap(list_r)
    assert_eq(prism_node.prism_node_kind_str(list_node), "each")
    assert_eq(prism_node.prism_node_depth(list_node), 4)
    assert_eq(prism_node.prism_node_count(list_node), 13)
    let list_kids = prism_node.prism_node_children(list_node)
    assert_eq(prism_node.prism_node_kind_str(list_kids[0]), "label")
    assert_eq(prism_node.prism_node_attr_str(list_kids[0], "text", ""), "Alpha")
    assert_eq(prism_node.prism_node_kind_str(list_kids[1]), "stack")
    assert_eq(prism_node.prism_node_depth(list_kids[1]), 2)
    assert_eq(prism_node.prism_node_kind_str(list_kids[2]), "band")
    assert_eq(prism_node.prism_node_depth(list_kids[2]), 2)
    assert_eq(prism_node.prism_node_kind_str(list_kids[3]), "band")
    assert_eq(prism_node.prism_node_depth(list_kids[3]), 3)
    assert_eq(prism_node.prism_node_count(list_kids[3]), 5)
    match prism_node.prism_node_key(list_kids[0])
        Some(k) => assert_eq(k, "Alpha")
        None => _fail("list row 0 should carry an identity key")

    let list_empty_r = prism_ui_data.prism_ui_list([], key_by_title)
    if is_ok(list_empty_r)
        _fail("prism_ui_list should reject an empty item list, but construction succeeded")
    let list_blank_title_r = prism_ui_data.prism_ui_list([prism_ui_data.prism_ui_list_item("", none(), none())], key_by_title)
    if is_ok(list_blank_title_r)
        _fail("prism_ui_list should reject an item with an empty title, but construction succeeded")
    let dup_a = prism_ui_data.prism_ui_list_item("X", none(), none())
    let dup_b = prism_ui_data.prism_ui_list_item("Y", none(), none())
    let same_key = fn(it) "dup"
    let list_dup_r = prism_ui_data.prism_ui_list([dup_a, dup_b], same_key)
    if is_ok(list_dup_r)
        _fail("prism_ui_list should reject a duplicate key (propagated from prism_each), but construction succeeded")
    if find(unwrap_err(list_dup_r), "duplicate key") < 0
        _fail("expected prism_each's own 'duplicate key' message to propagate unchanged, got: " + unwrap_err(list_dup_r))
    let list_bad_elem_r = prism_ui_data.prism_ui_list([42], fn(it) "k")
    if is_ok(list_bad_elem_r)
        _fail("prism_ui_list should reject a non-PrismUiListItem element, but construction succeeded")
    print("1. list: exact each(d=4,c=13) across title/secondary/icon combos, identity key carried, rejects empty list/empty title/duplicate key (propagated)/bad element: OK")

    // ── 2. Tree happy path: root + 2 leaves, exact structure, expand state -> exact icon ────────
    let leaf_a = prism_ui_data.prism_ui_tree_node("Child A", [], false)
    let leaf_b = prism_ui_data.prism_ui_tree_node("Child B", [], true)
    let root_n = prism_ui_data.prism_ui_tree_node("Root", [1, 2], true)
    let tree_r = prism_ui_data.prism_ui_tree([root_n, leaf_a, leaf_b], 0)
    if is_err(tree_r)
        _fail("prism_ui_tree (happy path): " + unwrap_err(tree_r))
    let tree_node = unwrap(tree_r)
    assert_eq(prism_node.prism_node_kind_str(tree_node), "stack")
    assert_eq(prism_node.prism_node_depth(tree_node), 4)
    assert_eq(prism_node.prism_node_count(tree_node), 11)
    let tree_kids = prism_node.prism_node_children(tree_node)
    assert_eq(prism_node.prism_node_kind_str(tree_kids[0]), "band")
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(tree_kids[0])[0], "icon", ""), "chevron_down")
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(tree_kids[0])[1], "text", ""), "Root")
    assert_eq(prism_node.prism_node_kind_str(tree_kids[1]), "stack")
    assert_eq(prism_node.prism_node_depth(tree_kids[1]), 3)
    assert_eq(prism_node.prism_node_count(tree_kids[1]), 7)
    let body_kids = prism_node.prism_node_children(tree_kids[1])
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(body_kids[0])[0], "icon", ""), "chevron_right")
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(body_kids[0])[1], "text", ""), "Child A")
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(body_kids[1])[0], "icon", ""), "chevron_down")
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(body_kids[1])[1], "text", ""), "Child B")

    let single_node = prism_ui_data.prism_ui_tree_node("Only", [], false)
    let empty_nodes_r = prism_ui_data.prism_ui_tree([], 0)
    if is_ok(empty_nodes_r)
        _fail("prism_ui_tree should reject an empty nodes list, but construction succeeded")
    let oob_root_r = prism_ui_data.prism_ui_tree([single_node], 5)
    if is_ok(oob_root_r)
        _fail("prism_ui_tree should reject an out-of-bounds root_idx, but construction succeeded")
    let blank_label_r = prism_ui_data.prism_ui_tree([prism_ui_data.prism_ui_tree_node("", [], false)], 0)
    if is_ok(blank_label_r)
        _fail("prism_ui_tree should reject a node with an empty label, but construction succeeded")
    let bad_idx_r = prism_ui_data.prism_ui_tree([prism_ui_data.prism_ui_tree_node("Root", ["oops"], true)], 0)
    if is_ok(bad_idx_r)
        _fail("prism_ui_tree should reject a non-int child index, but construction succeeded")
    if find(unwrap_err(bad_idx_r), "must be an int") < 0
        _fail("expected 'must be an int' in the rejection message, got: " + unwrap_err(bad_idx_r))
    let oob_child_r = prism_ui_data.prism_ui_tree([prism_ui_data.prism_ui_tree_node("Root", [5], true)], 0)
    if is_ok(oob_child_r)
        _fail("prism_ui_tree should reject an out-of-bounds child index, but construction succeeded")
    let bad_elem_r = prism_ui_data.prism_ui_tree([42], 0)
    if is_ok(bad_elem_r)
        _fail("prism_ui_tree should reject a non-PrismUiTreeNode element, but construction succeeded")
    print("2. tree happy path: exact stack(d=4,c=11), expand state selects the exact chevron icon per node (independent of whether it has children); rejects empty nodes/oob root_idx/blank label/non-int child idx/oob child idx/bad element: OK")

    // ── 3. Tree max depth: exact boundary at 32 (succeeds) vs 33 (rejected) ─────────────────────
    let chain32 = []
    let mut i = 0
    while i < 32
        let mut child_list = []
        if i < 31
            child_list = [i + 1]
        chain32.push(prism_ui_data.prism_ui_tree_node("N" + str(i), child_list, true))
        i += 1
    let chain32_r = prism_ui_data.prism_ui_tree(chain32, 0)
    if is_err(chain32_r)
        _fail("a 32-level chain (exactly at PRISM_UI_TREE_MAX_DEPTH) should succeed, but was rejected: " + unwrap_err(chain32_r))
    assert_eq(prism_node.prism_node_kind_str(unwrap(chain32_r)), "stack")

    let chain33 = []
    let mut j = 0
    while j < 33
        let mut child_list2 = []
        if j < 32
            child_list2 = [j + 1]
        chain33.push(prism_ui_data.prism_ui_tree_node("M" + str(j), child_list2, true))
        j += 1
    let chain33_r = prism_ui_data.prism_ui_tree(chain33, 0)
    if is_ok(chain33_r)
        _fail("a 33-level chain (one past PRISM_UI_TREE_MAX_DEPTH) should be rejected, but construction succeeded")
    if find(unwrap_err(chain33_r), "depth exceeds max 32") < 0
        _fail("expected 'depth exceeds max 32' in the rejection message, got: " + unwrap_err(chain33_r))
    print("3. tree max depth: a 32-level chain succeeds (right at the boundary), a 33-level chain is rejected with the exact 'depth exceeds max 32' message (one past it): OK")

    // ── 4. Tree cycle safety -- the requirement that matters most: must not hang ────────────────
    let loop_node = prism_ui_data.prism_ui_tree_node("Loopy", [0], true)
    let loop_r = prism_ui_data.prism_ui_tree([loop_node], 0)
    if is_ok(loop_r)
        _fail("prism_ui_tree should reject a self-referential node (it would otherwise recurse forever), but construction succeeded")
    if find(unwrap_err(loop_r), "cycle detected") < 0
        _fail("expected 'cycle detected' in the rejection message, got: " + unwrap_err(loop_r))
    let cyc_a = prism_ui_data.prism_ui_tree_node("A", [1], true)
    let cyc_b = prism_ui_data.prism_ui_tree_node("B", [0], true)
    let cyc_r = prism_ui_data.prism_ui_tree([cyc_a, cyc_b], 0)
    if is_ok(cyc_r)
        _fail("prism_ui_tree should reject a 2-node mutual cycle (it would otherwise recurse forever), but construction succeeded")
    if find(unwrap_err(cyc_r), "cycle detected") < 0
        _fail("expected 'cycle detected' in the rejection message, got: " + unwrap_err(cyc_r))
    print("4. tree cycle safety: a self-loop AND a 2-node mutual cycle are BOTH rejected immediately (ancestor-path detection) rather than recursing forever -- this KAT reaching this line at all is the proof it did not hang: OK")

    // ── 5. Descriptions: exact structure over prism_ui_kv; 1 rejection ──────────────────────────
    let desc_r = prism_ui_data.prism_ui_descriptions([["Name", "Ada"], ["Role", "Engineer"]])
    if is_err(desc_r)
        _fail("prism_ui_descriptions: " + unwrap_err(desc_r))
    let desc_node = unwrap(desc_r)
    assert_eq(prism_node.prism_node_kind_str(desc_node), "stack")
    assert_eq(prism_node.prism_node_depth(desc_node), 3)
    assert_eq(prism_node.prism_node_count(desc_node), 7)
    let desc_row0 = prism_node.prism_node_children(prism_node.prism_node_children(desc_node)[0])
    assert_eq(prism_node.prism_node_attr_str(desc_row0[0], "text", ""), "Name")
    assert_eq(prism_node.prism_node_attr_str(desc_row0[1], "text", ""), "Ada")
    let desc_empty_r = prism_ui_data.prism_ui_descriptions([])
    if is_ok(desc_empty_r)
        _fail("prism_ui_descriptions should reject an empty pairs list, but construction succeeded")
    print("5. descriptions: exact stack(d=3,c=7) over prism_ui_kv, rejects an empty pairs list: OK")

    // ── 6. Stat: 3 distinct trend icons; exact structure with/without delta; 2 rejections ──────
    let stat_icon_names = []
    stat_icon_names.push(prism_content.prism_icon_name(prism_ui_data.prism_stat_trend_icon(prism_ui_data.prism_stat_trend_up())))
    stat_icon_names.push(prism_content.prism_icon_name(prism_ui_data.prism_stat_trend_icon(prism_ui_data.prism_stat_trend_down())))
    stat_icon_names.push(prism_content.prism_icon_name(prism_ui_data.prism_stat_trend_icon(prism_ui_data.prism_stat_trend_flat())))
    assert_eq(stat_icon_names[0], "chevron_up")
    assert_eq(stat_icon_names[1], "chevron_down")
    assert_eq(stat_icon_names[2], "minus")
    let seen_stat_icons = {}
    for nm in stat_icon_names
        if nm in seen_stat_icons
            _fail("stat trend icon '" + nm + "' is reused by more than one trend -- must be distinct")
        seen_stat_icons[nm] = true
    assert_eq(prism_ui_data.prism_stat_trend_name(prism_ui_data.prism_stat_trend_up()), "up")
    assert_eq(prism_ui_data.prism_stat_trend_name(prism_ui_data.prism_stat_trend_down()), "down")
    assert_eq(prism_ui_data.prism_stat_trend_name(prism_ui_data.prism_stat_trend_flat()), "flat")

    let stat0_r = prism_ui_data.prism_ui_stat("Revenue", "$1.2M", none(), prism_ui_data.prism_stat_trend_flat())
    if is_err(stat0_r)
        _fail("prism_ui_stat (no delta): " + unwrap_err(stat0_r))
    let stat0 = unwrap(stat0_r)
    assert_eq(prism_node.prism_node_kind_str(stat0), "stack")
    assert_eq(prism_node.prism_node_depth(stat0), 2)
    assert_eq(prism_node.prism_node_count(stat0), 3)

    let stat1_r = prism_ui_data.prism_ui_stat("Users", "1,204", some("+12%"), prism_ui_data.prism_stat_trend_up())
    if is_err(stat1_r)
        _fail("prism_ui_stat (with delta): " + unwrap_err(stat1_r))
    let stat1 = unwrap(stat1_r)
    assert_eq(prism_node.prism_node_kind_str(stat1), "stack")
    assert_eq(prism_node.prism_node_depth(stat1), 3)
    assert_eq(prism_node.prism_node_count(stat1), 6)
    let stat1_delta = prism_node.prism_node_children(prism_node.prism_node_children(stat1)[2])
    assert_eq(prism_node.prism_node_attr_str(stat1_delta[0], "icon", ""), "chevron_up")
    assert_eq(prism_node.prism_node_attr_str(stat1_delta[1], "text", ""), "+12%")

    let stat_blank_r = prism_ui_data.prism_ui_stat("L", "V", some(""), prism_ui_data.prism_stat_trend_up())
    if is_err(stat_blank_r)
        _fail("prism_ui_stat (blank Some delta): " + unwrap_err(stat_blank_r))
    assert_eq(prism_node.prism_node_count(unwrap(stat_blank_r)), 3)

    let stat_empty_label_r = prism_ui_data.prism_ui_stat("", "V", none(), prism_ui_data.prism_stat_trend_flat())
    if is_ok(stat_empty_label_r)
        _fail("prism_ui_stat should reject an empty label, but construction succeeded")
    let stat_empty_value_r = prism_ui_data.prism_ui_stat("L", "", none(), prism_ui_data.prism_stat_trend_flat())
    if is_ok(stat_empty_value_r)
        _fail("prism_ui_stat should reject an empty value, but construction succeeded")
    print("6. stat: 3 distinct trend icons (chevron_up/chevron_down/minus), exact stack(d=2,c=3) w/o delta, stack(d=3,c=6) w/ delta, blank Some(delta) degrades to no-delta, rejects empty label/value: OK")

    // ── 7. Timeline: exact structure, order preserved, status queryable; 3 rejections ──────────
    let ev0 = prism_ui_data.prism_ui_timeline_event("Ordered", prism_ui_data.prism_timeline_status_done())
    let ev1 = prism_ui_data.prism_ui_timeline_event("Shipped", prism_ui_data.prism_timeline_status_active())
    let ev2 = prism_ui_data.prism_ui_timeline_event("Out for delivery", prism_ui_data.prism_timeline_status_pending())
    let tl_r = prism_ui_data.prism_ui_timeline([ev0, ev1, ev2])
    if is_err(tl_r)
        _fail("prism_ui_timeline: " + unwrap_err(tl_r))
    let tl_node = unwrap(tl_r)
    assert_eq(prism_node.prism_node_kind_str(tl_node), "stack")
    assert_eq(prism_node.prism_node_depth(tl_node), 3)
    assert_eq(prism_node.prism_node_count(tl_node), 6)
    let tl_kids = prism_node.prism_node_children(tl_node)
    assert_eq(prism_node.prism_node_kind_str(tl_kids[0]), "band")
    assert_eq(prism_ui_data.prism_ui_timeline_status_of(tl_kids[0]), "done")
    assert_eq(prism_node.prism_node_attr_str(prism_node.prism_node_children(tl_kids[0])[1], "text", ""), "Ordered")
    assert_eq(prism_node.prism_node_kind_str(tl_kids[1]), "label")
    assert_eq(prism_node.prism_node_attr_str(tl_kids[1], "text", ""), "Shipped")
    assert_eq(prism_ui_data.prism_ui_timeline_status_of(tl_kids[1]), "active")
    assert_eq(prism_node.prism_node_kind_str(tl_kids[2]), "label")
    assert_eq(prism_node.prism_node_attr_str(tl_kids[2], "text", ""), "Out for delivery")
    assert_eq(prism_ui_data.prism_ui_timeline_status_of(tl_kids[2]), "pending")

    let tl_empty_r = prism_ui_data.prism_ui_timeline([])
    if is_ok(tl_empty_r)
        _fail("prism_ui_timeline should reject an empty timeline, but construction succeeded")
    let tl_blank_label_r = prism_ui_data.prism_ui_timeline([prism_ui_data.prism_ui_timeline_event("", prism_ui_data.prism_timeline_status_done())])
    if is_ok(tl_blank_label_r)
        _fail("prism_ui_timeline should reject an event with an empty label, but construction succeeded")
    let tl_bad_elem_r = prism_ui_data.prism_ui_timeline([42])
    if is_ok(tl_bad_elem_r)
        _fail("prism_ui_timeline should reject a non-PrismUiTimelineEvent element, but construction succeeded")
    print("7. timeline: exact stack(d=3,c=6), order preserved exactly (Ordered/Shipped/Out for delivery), done/active/pending distinguished via the queryable status attr even where active/pending render identically, rejects empty timeline/blank label/bad element: OK")

    // ── 8. XSS-shaped list title survives composition: prism_render_html escapes it to TEXT ─────
    let xss_item = prism_ui_data.prism_ui_list_item("<script>alert(1)</script>", none(), none())
    let xss_r = prism_ui_data.prism_ui_list([xss_item], fn(it) "xss")
    if is_err(xss_r)
        _fail("prism_ui_list (xss-shaped title): " + unwrap_err(xss_r))
    let xss_html_r = prism_render_html.prism_html_render(unwrap(xss_r))
    if is_err(xss_html_r)
        _fail("prism_html_render(list with xss-shaped title): " + unwrap_err(xss_html_r))
    let xss_html = unwrap(xss_html_r)
    if find(xss_html, "<script>") >= 0
        _fail("prism_html_render emitted a raw <script> tag from a list item title -- injection guarantee broken: " + xss_html)
    if find(xss_html, "&lt;script&gt;alert(1)&lt;/script&gt;") < 0
        _fail("prism_html_render did not escape the list item title to the expected entity form: " + xss_html)
    print("8. a <script>-bearing list item title renders as escaped TEXT through prism_render_html (no raw <script>, exact entity-escaped form present): OK")

    // ── 9. Rejection tally: 19 distinct rejections proven above (>= 8 required) ────────────────
    let rejection_count = 19
    if rejection_count < 8
        _fail("expected at least 8 rejection cases, counted " + str(rejection_count))
    print("9. rejection tally: 19 distinct rejections proven (list: empty/blank-title/dup-key/bad-elem=4, tree: empty-nodes/oob-root/blank-label/non-int-idx/oob-idx/excess-depth/self-loop/2-cycle/bad-elem=9, descriptions: empty=1, stat: blank-label/blank-value=2, timeline: empty/blank-label/bad-elem=3) -- >= 8 required: OK")

    print("KAT prism_ui_data PASSED: list/tree/descriptions/stat/timeline exact structure, tree cycle safety proven (self-loop + 2-cycle, no hang), tree depth boundary exact (32 ok / 33 rejected), XSS-shaped list title escapes through prism_render_html, 19 rejections")
