// INTEGRATION KAT for milestone MA.4 — proves the two independently-written halves actually
// compose, and that all of MA.3 + MA.4 links in ONE program.
//
// Why this exists separately from _kat_prism_style_a/_b: those two were written against each
// other's API *contract*, never against each other's code. Specifically, `prism_look_resolve`
// accepts a slot dict whose values may be either a plain hex string OR a `PrismColor` struct, and
// KAT B only ever exercised the STRING path. Production uses `prism_palette_slots()`, which
// returns **PrismColor structs** — the path no test had run. A contract agreed on paper and never
// executed is not a verified contract.
//
// Proves:
//   1. All six modules (node + 4 widget + 3 style) link together — no symbol collision in NOVA's
//      one flat LLVM symbol space.
//   2. prism_look_resolve flattens against a REAL prism_palette (PrismColor values), and the
//      flattened hex exactly equals prism_color_to_hex of the same slot.
//   3. A resolved look survives being carried on a real widget tree.
//   4. Resolution against every one of the 18 palettes produces a valid flat color.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME = the nova-compiler/ root, NOVA_NO_CACHE=1):
//   ./gen3_test.exe _kat_prism_style_all.nova
//   clang -O2 -o _kat_prism_style_all.exe _kat_prism_style_all.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_structure
import prism_color
import prism_palette
import prism_look

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    print("== 1. all six modules linked; MA.3 widgets still build ==")
    let hello = unwrap(prism_content.prism_label("Hello"))
    let icon = unwrap(prism_content.prism_glyph(prism_content.prism_icon_check()))
    let head = unwrap(prism_arrange.prism_band([icon, hello]))
    let go = unwrap(prism_interact.prism_press("Save", []))
    let body = unwrap(prism_arrange.prism_stack([head, go]))
    _check("tree kind", prism_node.prism_node_kind_str(body), "stack")
    _check("tree depth", str(prism_node.prism_node_depth(body)), "3")
    _check("tree count", str(prism_node.prism_node_count(body)), "5")

    print("== 2. resolve against a REAL palette (PrismColor values, not strings) ==")
    let pal = unwrap(prism_palette.prism_palette_named("classic", false))
    let slots = prism_palette.prism_palette_slots(pal)
    // The slot values here are PrismColor STRUCTS -- the path KAT B never exercised.
    _check("slot value is a PrismColor", type_name(slots["ground"]), "PrismColor")

    let l0 = prism_look.prism_look_new()
    let l1 = unwrap(prism_look.prism_fill(l0, unwrap(prism_look.prism_paint_slot("ground"))))
    let l2 = unwrap(prism_look.prism_ink(l1, unwrap(prism_look.prism_paint_slot("ink"))))
    let l3 = unwrap(prism_look.prism_edge(l2, unwrap(prism_look.prism_paint_slot("edge"))))
    let card = unwrap(prism_look.prism_inset(l3, unwrap(prism_look.prism_len(16))))
    let flat = unwrap(prism_look.prism_look_resolve(card, slots))

    // The flattened value must be EXACTLY what prism_color says that slot is -- this is the
    // cross-module agreement the two halves only ever agreed on in prose.
    _check("fill == color_to_hex(ground)", prism_look.prism_look_value_str(flat, "fill"), prism_color.prism_color_to_hex(slots["ground"]))
    _check("ink  == color_to_hex(ink)", prism_look.prism_look_value_str(flat, "ink"), prism_color.prism_color_to_hex(slots["ink"]))
    _check("edge == color_to_hex(edge)", prism_look.prism_look_value_str(flat, "edge"), prism_color.prism_color_to_hex(slots["edge"]))
    // And against the spec's own §11 `palette day` literals.
    _check("fill is spec day.ground", prism_look.prism_look_value_str(flat, "fill"), "#ffffff")
    _check("ink is spec day.ink", prism_look.prism_look_value_str(flat, "ink"), "#1a1a1a")
    _check("non-color property untouched", prism_look.prism_look_value_str(flat, "inset"), "16")
    _check("source look NOT mutated", prism_look.prism_look_value_str(card, "fill"), "palette.ground")

    print("== 3. a resolved look rides on a real widget tree ==")
    // The look is carried as node attrs; MA.5's renderer is what will consume it. Here we only
    // prove the two value systems coexist on one tree without either corrupting the other.
    let styled = unwrap(prism_node.prism_node_branch(prism_node.prism_kind_pane(), {"look_fill": prism_look.prism_look_value_str(flat, "fill")}, [body]))
    _check("styled node kind", prism_node.prism_node_kind_str(styled), "pane")
    _check("look value survives on the node", prism_node.prism_node_attr_str(styled, "look_fill", ""), "#ffffff")
    _check("subtree intact under styling", str(prism_node.prism_node_count(styled)), "6")

    print("== 4. resolve against ALL 18 palettes ==")
    let names = prism_palette.prism_palette_names()
    // Assert the count BEFORE looping: a loop over a wrongly-empty list is a green test that
    // proves nothing. This is exactly how the module-level-`let` compiler bug hid in MA.4a.
    _check("preset count before loop", str(len(names)), "9")
    let resolved_ok = [0]
    for nm in names
        for dark in [false, true]
            let p = unwrap(prism_palette.prism_palette_named(nm, dark))
            let s = prism_palette.prism_palette_slots(p)
            let fr = prism_look.prism_look_resolve(card, s)
            if is_err(fr)
                print("  FAIL  " + nm + " resolve failed")
                FAILED[0] = FAILED[0] + 1
            else
                let hexv = prism_look.prism_look_value_str(unwrap(fr), "fill")
                // Must be a flat 7- or 9-char hex constant, never a lingering "palette." ref.
                if len(hexv) != 7 and len(hexv) != 9
                    print("  FAIL  " + nm + " produced non-flat fill: " + hexv)
                    FAILED[0] = FAILED[0] + 1
                else
                    if hexv[0] != "#"
                        print("  FAIL  " + nm + " fill is not hex: " + hexv)
                        FAILED[0] = FAILED[0] + 1
                    else
                        resolved_ok[0] = resolved_ok[0] + 1
    _check("all 18 palettes flattened", str(resolved_ok[0]), "18")

    if FAILED[0] == 0
        print("")
        print("_kat_prism_style_all: ALL PASS")
    else
        print("")
        print("_kat_prism_style_all: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
