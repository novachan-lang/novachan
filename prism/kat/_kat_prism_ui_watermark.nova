import prism_node
import prism_content
import prism_ui_watermark

// Small local test harness: kat_check returns 1 on pass, 0 on fail, printing a
// line that STARTS with "FAIL" (the gate's failure token) when it fails.
fn kat_check(cond: bool, msg: string) -> int
    if cond
        return 1
    else
        print("FAIL: " + msg)
        return 0

// A label leaf's rendered text lives in its "text" attribute.
fn node_text(n: PrismNode) -> string
    prism_node.prism_node_attr_str(n, "text", "")

fn main()
    let mut pass_count = 0
    let mut total = 0

    print("=== KAT: prism_ui_watermark ===")

    // ============================================================
    // Section A: prism_wm_watermark (16 assertions)
    // ============================================================
    let body_lbl = unwrap(prism_content.prism_label("Body"))
    let a1 = prism_ui_watermark.prism_wm_watermark([body_lbl], "WATERMARK")
    total += 1
    pass_count += kat_check(is_ok(a1), "A1 watermark single child is_ok")
    let a1n = unwrap(a1)
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(a1n) == "layer", "A2 watermark kind == layer")
    let a1c = prism_node.prism_node_children(a1n)
    total += 1
    pass_count += kat_check(len(a1c) == 2, "A3 watermark children count == 2")
    let a1_body = a1c[0]
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(a1_body) == "stack", "A4 watermark body kind == stack")
    let a1_body_children = prism_node.prism_node_children(a1_body)
    total += 1
    pass_count += kat_check(len(a1_body_children) == 1, "A5 watermark body children count == 1")
    total += 1
    pass_count += kat_check(node_text(a1_body_children[0]) == "Body", "A6 watermark body child text == Body")
    let a1_mark = a1c[1]
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(a1_mark) == "label", "A7 watermark mark kind == label")
    total += 1
    pass_count += kat_check(node_text(a1_mark) == "WATERMARK", "A8 watermark mark text == WATERMARK")

    let a2 = prism_ui_watermark.prism_wm_watermark([], "X")
    total += 1
    pass_count += kat_check(is_err(a2), "A9 watermark empty content is_err")
    total += 1
    pass_count += kat_check(unwrap_err(a2) == "prism_wm_watermark: content must not be empty", "A10 watermark empty content error text")

    let a3 = prism_ui_watermark.prism_wm_watermark([body_lbl], "")
    total += 1
    pass_count += kat_check(is_err(a3), "A11 watermark empty text is_err")
    total += 1
    pass_count += kat_check(unwrap_err(a3) == "prism_wm_watermark: text must not be empty", "A12 watermark empty text error text")

    let a4 = prism_ui_watermark.prism_wm_watermark([42], "X")
    total += 1
    pass_count += kat_check(is_err(a4), "A13 watermark non-PrismNode child is_err")
    total += 1
    pass_count += kat_check(unwrap_err(a4) == "prism_wm_watermark: child 0 is not a PrismNode (got int)", "A14 watermark non-PrismNode child error text")

    let body_lbl2 = unwrap(prism_content.prism_label("Second"))
    let a5 = prism_ui_watermark.prism_wm_watermark([body_lbl, body_lbl2], "MULTI")
    total += 1
    pass_count += kat_check(is_ok(a5), "A15 watermark multi-child content is_ok")
    let a5n = unwrap(a5)
    let a5_body = prism_node.prism_node_children(a5n)[0]
    let a5_body_children = prism_node.prism_node_children(a5_body)
    total += 1
    pass_count += kat_check(len(a5_body_children) == 2 and node_text(a5_body_children[0]) == "Body" and node_text(a5_body_children[1]) == "Second", "A16 watermark multi-child content order preserved")

    // ============================================================
    // Section B: prism_wm_stamp (6 assertions)
    // ============================================================
    let b1 = prism_ui_watermark.prism_wm_stamp("NEW")
    total += 1
    pass_count += kat_check(is_ok(b1), "B1 stamp NEW is_ok")
    let b1n = unwrap(b1)
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(b1n) == "band", "B2 stamp kind == band")
    let b1c = prism_node.prism_node_children(b1n)
    total += 1
    pass_count += kat_check(len(b1c) == 1, "B3 stamp children count == 1")
    total += 1
    pass_count += kat_check(node_text(b1c[0]) == "[NEW]", "B4 stamp label text == [NEW]")

    let b2 = prism_ui_watermark.prism_wm_stamp("")
    total += 1
    pass_count += kat_check(is_err(b2), "B5 stamp empty text is_err")
    total += 1
    pass_count += kat_check(unwrap_err(b2) == "prism_wm_stamp: text must not be empty", "B6 stamp empty text error text")

    // ============================================================
    // Section C: prism_wm_confidential (6 assertions)
    // ============================================================
    let c1 = prism_ui_watermark.prism_wm_confidential([body_lbl])
    total += 1
    pass_count += kat_check(is_ok(c1), "C1 confidential is_ok")
    let c1n = unwrap(c1)
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(c1n) == "layer", "C2 confidential kind == layer")
    let c1c = prism_node.prism_node_children(c1n)
    total += 1
    pass_count += kat_check(len(c1c) == 2, "C3 confidential children count == 2")
    total += 1
    pass_count += kat_check(node_text(c1c[1]) == "CONFIDENTIAL", "C4 confidential mark text == CONFIDENTIAL")

    let c2 = prism_ui_watermark.prism_wm_confidential([])
    total += 1
    pass_count += kat_check(is_err(c2), "C5 confidential empty content is_err")
    total += 1
    pass_count += kat_check(unwrap_err(c2) == "prism_wm_watermark: content must not be empty", "C6 confidential empty content error text")

    // ============================================================
    // Section D: prism_wm_draft (6 assertions)
    // ============================================================
    let d1 = prism_ui_watermark.prism_wm_draft([body_lbl])
    total += 1
    pass_count += kat_check(is_ok(d1), "D1 draft is_ok")
    let d1n = unwrap(d1)
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(d1n) == "layer", "D2 draft kind == layer")
    let d1c = prism_node.prism_node_children(d1n)
    total += 1
    pass_count += kat_check(len(d1c) == 2, "D3 draft children count == 2")
    total += 1
    pass_count += kat_check(node_text(d1c[1]) == "DRAFT", "D4 draft mark text == DRAFT")

    let d2 = prism_ui_watermark.prism_wm_draft([])
    total += 1
    pass_count += kat_check(is_err(d2), "D5 draft empty content is_err")
    total += 1
    pass_count += kat_check(unwrap_err(d2) == "prism_wm_watermark: content must not be empty", "D6 draft empty content error text")

    // ============================================================
    // Section E: prism_wm_repeated (21 assertions)
    // ============================================================
    let e1 = prism_ui_watermark.prism_wm_repeated([body_lbl], "REPEAT", 3)
    total += 1
    pass_count += kat_check(is_ok(e1), "E1 repeated count=3 is_ok")
    let e1n = unwrap(e1)
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(e1n) == "layer", "E2 repeated kind == layer")
    let e1c = prism_node.prism_node_children(e1n)
    total += 1
    pass_count += kat_check(len(e1c) == 2, "E3 repeated children count == 2")
    let e1_body = e1c[0]
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(e1_body) == "stack", "E4 repeated body kind == stack")
    total += 1
    pass_count += kat_check(len(prism_node.prism_node_children(e1_body)) == 1, "E5 repeated body children count == 1")
    let e1_overlay = e1c[1]
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(e1_overlay) == "stack", "E6 repeated overlay kind == stack")
    let e1_overlay_children = prism_node.prism_node_children(e1_overlay)
    total += 1
    pass_count += kat_check(len(e1_overlay_children) == 3, "E7 repeated overlay children count == 3")
    total += 1
    pass_count += kat_check(prism_node.prism_node_kind_str(e1_overlay_children[0]) == "label", "E8 repeated overlay child0 kind == label")
    total += 1
    pass_count += kat_check(node_text(e1_overlay_children[0]) == "REPEAT", "E9 repeated overlay child0 text == REPEAT")
    total += 1
    pass_count += kat_check(node_text(e1_overlay_children[1]) == "REPEAT", "E10 repeated overlay child1 text == REPEAT")
    total += 1
    pass_count += kat_check(node_text(e1_overlay_children[2]) == "REPEAT", "E11 repeated overlay child2 text == REPEAT")

    let e2 = prism_ui_watermark.prism_wm_repeated([body_lbl], "ONE", 1)
    total += 1
    pass_count += kat_check(is_ok(e2), "E12 repeated count=1 is_ok")
    let e2_overlay = prism_node.prism_node_children(unwrap(e2))[1]
    total += 1
    pass_count += kat_check(len(prism_node.prism_node_children(e2_overlay)) == 1, "E13 repeated count=1 overlay children count == 1")

    let e3 = prism_ui_watermark.prism_wm_repeated([], "X", 2)
    total += 1
    pass_count += kat_check(is_err(e3), "E14 repeated empty content is_err")
    total += 1
    pass_count += kat_check(unwrap_err(e3) == "prism_wm_repeated: content must not be empty", "E15 repeated empty content error text")

    let e4 = prism_ui_watermark.prism_wm_repeated([body_lbl], "", 2)
    total += 1
    pass_count += kat_check(is_err(e4), "E16 repeated empty text is_err")
    total += 1
    pass_count += kat_check(unwrap_err(e4) == "prism_wm_repeated: text must not be empty", "E17 repeated empty text error text")

    let e5 = prism_ui_watermark.prism_wm_repeated([body_lbl], "X", 0)
    total += 1
    pass_count += kat_check(is_err(e5), "E18 repeated count=0 is_err")
    total += 1
    pass_count += kat_check(unwrap_err(e5) == "prism_wm_repeated: repeat_count must be > 0", "E19 repeated count=0 error text")

    let e6 = prism_ui_watermark.prism_wm_repeated([body_lbl], "X", -1)
    total += 1
    pass_count += kat_check(is_err(e6), "E20 repeated count=-1 is_err")

    let e7 = prism_ui_watermark.prism_wm_repeated(["not_a_node"], "X", 2)
    total += 1
    pass_count += kat_check(is_err(e7), "E21 repeated non-PrismNode child is_err")

    print("TOTAL " + str(pass_count) + "/" + str(total) + " passed")
