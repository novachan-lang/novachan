import prism_ui_steps
import prism_node

// ── Test harness ────────────────────────────────────────────────────────────
// Convention: a failing assertion prints a line starting with the uppercase
// token "FAIL" (checked by _prism_kat_gate.ps1's case-sensitive line-anchored
// scan) and contributes 0 to the running "passed" tally; a passing assertion
// contributes 1. main() prints a final "passed/total" summary.

fn check(name: string, condition: bool) -> int
    if condition
        return 1
    print("FAIL: " + name)
    return 0

fn check_err(name: string, r: Result<PrismNode>) -> int
    if is_err(r)
        return 1
    print("FAIL: " + name + " (expected err, got ok)")
    return 0

fn marker_text(step_node: PrismNode) -> string
    let kids = prism_node.prism_node_children(step_node)
    let marker = kids[0]
    prism_node.prism_node_attr_str(marker, "text", "<missing>")

fn label_text(step_node: PrismNode) -> string
    let kids = prism_node.prism_node_children(step_node)
    let lbl = kids[1]
    prism_node.prism_node_attr_str(lbl, "text", "<missing>")

fn expected_marker(idx: int, current: int) -> string
    if idx < current
        return "[x] "
    if idx == current
        return "[>] "
    "[ ] "

fn main()
    let mut total = 0
    let mut passed = 0

    // ── 1. prism_st_step: happy paths for each status ──────────────────────
    let r_done = prism_ui_steps.prism_st_step("Start", "done")
    total += 1
    passed += check("st_step done: is_ok", is_ok(r_done))
    if is_ok(r_done)
        let n_done = unwrap(r_done)
        total += 1
        passed += check("st_step done: kind == band", prism_node.prism_node_kind_str(n_done) == "band")
        total += 1
        passed += check("st_step done: child count == 2", len(prism_node.prism_node_children(n_done)) == 2)
        total += 1
        passed += check("st_step done: marker == '[x] '", marker_text(n_done) == "[x] ")
        total += 1
        passed += check("st_step done: label == 'Start'", label_text(n_done) == "Start")

    let r_active = prism_ui_steps.prism_st_step("Ship", "active")
    total += 1
    passed += check("st_step active: is_ok", is_ok(r_active))
    if is_ok(r_active)
        let n_active = unwrap(r_active)
        total += 1
        passed += check("st_step active: kind == band", prism_node.prism_node_kind_str(n_active) == "band")
        total += 1
        passed += check("st_step active: child count == 2", len(prism_node.prism_node_children(n_active)) == 2)
        total += 1
        passed += check("st_step active: marker == '[>] '", marker_text(n_active) == "[>] ")
        total += 1
        passed += check("st_step active: label == 'Ship'", label_text(n_active) == "Ship")

    let r_pending = prism_ui_steps.prism_st_step("Review", "pending")
    total += 1
    passed += check("st_step pending: is_ok", is_ok(r_pending))
    if is_ok(r_pending)
        let n_pending = unwrap(r_pending)
        total += 1
        passed += check("st_step pending: kind == band", prism_node.prism_node_kind_str(n_pending) == "band")
        total += 1
        passed += check("st_step pending: child count == 2", len(prism_node.prism_node_children(n_pending)) == 2)
        total += 1
        passed += check("st_step pending: marker == '[ ] '", marker_text(n_pending) == "[ ] ")
        total += 1
        passed += check("st_step pending: label == 'Review'", label_text(n_pending) == "Review")

    // ── 2. prism_st_step: error paths ───────────────────────────────────────
    total += 1
    passed += check_err("st_step: empty label errors", prism_ui_steps.prism_st_step("", "done"))

    let r_bad_status = prism_ui_steps.prism_st_step("X", "finished")
    total += 1
    passed += check_err("st_step: invalid status errors", r_bad_status)
    if is_err(r_bad_status)
        total += 1
        passed += check("st_step: invalid status message names the bad value", contains(unwrap_err(r_bad_status), "finished"))

    // ── 3. prism_st_connector ────────────────────────────────────────────────
    let r_conn = prism_ui_steps.prism_st_connector()
    total += 1
    passed += check("st_connector: is_ok", is_ok(r_conn))
    if is_ok(r_conn)
        let n_conn = unwrap(r_conn)
        total += 1
        passed += check("st_connector: kind == label", prism_node.prism_node_kind_str(n_conn) == "label")
        total += 1
        passed += check("st_connector: text == '---'", prism_node.prism_node_attr_str(n_conn, "text", "<missing>") == "---")

    // ── 4. prism_st_steps: happy path, 3 steps ─────────────────────────────
    let labels3 = ["A", "B", "C"]
    let statuses3 = ["done", "active", "pending"]
    let r_bar = prism_ui_steps.prism_st_steps(labels3, statuses3)
    total += 1
    passed += check("st_steps 3-step: is_ok", is_ok(r_bar))
    if is_ok(r_bar)
        let n_bar = unwrap(r_bar)
        total += 1
        passed += check("st_steps 3-step: kind == band", prism_node.prism_node_kind_str(n_bar) == "band")
        let kids_bar = prism_node.prism_node_children(n_bar)
        total += 1
        passed += check("st_steps 3-step: child count == 5 (3 steps + 2 connectors)", len(kids_bar) == 5)
        if len(kids_bar) == 5
            total += 1
            passed += check("st_steps 3-step: child0 (step A) kind == band", prism_node.prism_node_kind_str(kids_bar[0]) == "band")
            total += 1
            passed += check("st_steps 3-step: child0 marker == '[x] '", marker_text(kids_bar[0]) == "[x] ")
            total += 1
            passed += check("st_steps 3-step: child0 label == 'A'", label_text(kids_bar[0]) == "A")
            total += 1
            passed += check("st_steps 3-step: child1 (connector) kind == label", prism_node.prism_node_kind_str(kids_bar[1]) == "label")
            total += 1
            passed += check("st_steps 3-step: child1 text == '---'", prism_node.prism_node_attr_str(kids_bar[1], "text", "<missing>") == "---")
            total += 1
            passed += check("st_steps 3-step: child2 (step B) marker == '[>] '", marker_text(kids_bar[2]) == "[>] ")
            total += 1
            passed += check("st_steps 3-step: child4 (step C) marker == '[ ] '", marker_text(kids_bar[4]) == "[ ] ")

    // ── prism_st_steps: happy path, single step (no connectors) ────────────
    let r_bar1 = prism_ui_steps.prism_st_steps(["Only"], ["active"])
    total += 1
    passed += check("st_steps 1-step: is_ok", is_ok(r_bar1))
    if is_ok(r_bar1)
        total += 1
        passed += check("st_steps 1-step: child count == 1 (no connectors)", len(prism_node.prism_node_children(unwrap(r_bar1))) == 1)

    // ── prism_st_steps: error paths ──────────────────────────────────────────
    total += 1
    passed += check_err("st_steps: empty labels errors", prism_ui_steps.prism_st_steps([], []))

    let r_mismatch = prism_ui_steps.prism_st_steps(["A", "B"], ["done"])
    total += 1
    passed += check_err("st_steps: mismatched lengths errors", r_mismatch)
    if is_err(r_mismatch)
        total += 1
        passed += check("st_steps: mismatch message mentions length", contains(unwrap_err(r_mismatch), "same length"))

    total += 1
    passed += check_err("st_steps: non-string label errors", prism_ui_steps.prism_st_steps([123, "B"], ["done", "active"]))
    total += 1
    passed += check_err("st_steps: non-string status errors", prism_ui_steps.prism_st_steps(["A", "B"], [123, "active"]))

    // ── 5. prism_st_auto: assignment correctness across all current values ─
    let names3 = ["A", "B", "C"]

    let r_auto0 = prism_ui_steps.prism_st_auto(names3, 0)
    total += 1
    passed += check("st_auto current=0: is_ok", is_ok(r_auto0))
    if is_ok(r_auto0)
        let kids_a0 = prism_node.prism_node_children(unwrap(r_auto0))
        total += 1
        passed += check("st_auto current=0: step0 == active", marker_text(kids_a0[0]) == expected_marker(0, 0))
        total += 1
        passed += check("st_auto current=0: step1 == pending", marker_text(kids_a0[2]) == expected_marker(1, 0))
        total += 1
        passed += check("st_auto current=0: step2 == pending", marker_text(kids_a0[4]) == expected_marker(2, 0))

    let r_auto1 = prism_ui_steps.prism_st_auto(names3, 1)
    total += 1
    passed += check("st_auto current=1: is_ok", is_ok(r_auto1))
    if is_ok(r_auto1)
        let kids_a1 = prism_node.prism_node_children(unwrap(r_auto1))
        total += 1
        passed += check("st_auto current=1: step0 == done", marker_text(kids_a1[0]) == expected_marker(0, 1))
        total += 1
        passed += check("st_auto current=1: step1 == active", marker_text(kids_a1[2]) == expected_marker(1, 1))
        total += 1
        passed += check("st_auto current=1: step2 == pending", marker_text(kids_a1[4]) == expected_marker(2, 1))

    let r_auto2 = prism_ui_steps.prism_st_auto(names3, 2)
    total += 1
    passed += check("st_auto current=2: is_ok", is_ok(r_auto2))
    if is_ok(r_auto2)
        let kids_a2 = prism_node.prism_node_children(unwrap(r_auto2))
        total += 1
        passed += check("st_auto current=2: step0 == done", marker_text(kids_a2[0]) == expected_marker(0, 2))
        total += 1
        passed += check("st_auto current=2: step1 == done", marker_text(kids_a2[2]) == expected_marker(1, 2))
        total += 1
        passed += check("st_auto current=2: step2 == active", marker_text(kids_a2[4]) == expected_marker(2, 2))

    // ── prism_st_auto: error paths ────────────────────────────────────────
    total += 1
    passed += check_err("st_auto: empty step_names errors", prism_ui_steps.prism_st_auto([], 0))
    total += 1
    passed += check_err("st_auto: negative current errors", prism_ui_steps.prism_st_auto(names3, -1))
    total += 1
    passed += check_err("st_auto: current == len(step_names) errors (out of bounds)", prism_ui_steps.prism_st_auto(names3, 3))
    total += 1
    passed += check_err("st_auto: current far out of bounds errors", prism_ui_steps.prism_st_auto(names3, 99))
    total += 1
    passed += check_err("st_auto: non-string step name errors", prism_ui_steps.prism_st_auto(["A", 2], 0))

    // ── 6. prism_st_vertical: happy path ────────────────────────────────────
    let r_vert = prism_ui_steps.prism_st_vertical(labels3, statuses3)
    total += 1
    passed += check("st_vertical: is_ok", is_ok(r_vert))
    if is_ok(r_vert)
        let n_vert = unwrap(r_vert)
        total += 1
        passed += check("st_vertical: kind == stack", prism_node.prism_node_kind_str(n_vert) == "stack")
        let kids_vert = prism_node.prism_node_children(n_vert)
        total += 1
        passed += check("st_vertical: child count == 5 (3 steps + 2 connectors)", len(kids_vert) == 5)
        if len(kids_vert) == 5
            total += 1
            passed += check("st_vertical: child0 (step A) marker == '[x] '", marker_text(kids_vert[0]) == "[x] ")
            total += 1
            passed += check("st_vertical: child1 (connector) kind == label", prism_node.prism_node_kind_str(kids_vert[1]) == "label")
            total += 1
            passed += check("st_vertical: child1 text == '  |'", prism_node.prism_node_attr_str(kids_vert[1], "text", "<missing>") == "  |")
            total += 1
            passed += check("st_vertical: child4 (step C) marker == '[ ] '", marker_text(kids_vert[4]) == "[ ] ")

    // ── prism_st_vertical: happy path, single step (no connectors) ─────────
    let r_vert1 = prism_ui_steps.prism_st_vertical(["Solo"], ["done"])
    total += 1
    passed += check("st_vertical 1-step: is_ok", is_ok(r_vert1))
    if is_ok(r_vert1)
        total += 1
        passed += check("st_vertical 1-step: child count == 1", len(prism_node.prism_node_children(unwrap(r_vert1))) == 1)

    // ── prism_st_vertical: error paths ──────────────────────────────────────
    total += 1
    passed += check_err("st_vertical: empty labels errors", prism_ui_steps.prism_st_vertical([], []))
    total += 1
    passed += check_err("st_vertical: mismatched lengths errors", prism_ui_steps.prism_st_vertical(["A", "B"], ["done"]))
    total += 1
    passed += check_err("st_vertical: non-string label errors", prism_ui_steps.prism_st_vertical([1, "B"], ["done", "active"]))
    total += 1
    passed += check_err("st_vertical: non-string status errors", prism_ui_steps.prism_st_vertical(["A", "B"], ["done", 2]))

    // ── Summary ──────────────────────────────────────────────────────────────
    print(str(passed) + "/" + str(total) + " assertions passed")
    if passed != total
        print("FAIL: _kat_prism_ui_steps -- " + str(total - passed) + " assertion(s) failed")
