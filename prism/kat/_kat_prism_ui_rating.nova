// KAT for prism/ui/prism_ui_rating.nova (PRISM_ROADMAP.md milestone MB.14, the `ui/` composition
// layer's rating and review family: star rating readout, review card, rating-breakdown summary,
// review list, compact score badge).
//
// Proves, against concrete expected values (every depth/count is hand-computed from
// prism_node.nova's own `depth = max(child depths) + 1`, `count = 1 + sum(child counts)` rule,
// never guessed):
//   1. prism_rt_stars: exact band(d=3,c=8) shape at value=3/5, all-minus at value=0, all-check at
//      value=max -- exact filled/empty icon split at each; rejects an empty rt_label, rt_max < 1,
//      rt_value < 0, rt_value > rt_max (4 rejections).
//   2. prism_rt_review: exact stack(d=4,c=10) with no date, stack(d=4,c=11) with a date, blank
//      Some("") date degrades to the no-date shape (c=10); exact author/stars/body/date text and
//      the filled/empty star split; rejects an empty rt_author, an empty rt_body, and an invalid
//      rating below 0 and above max (4 rejections).
//   3. prism_rt_summary: exact stack(d=5,c=33) over a 5-row breakdown with hand-computed bar
//      lengths (5/2/1/1/0) proportional to rt_count, exact "4.2 average from 100 reviews" text
//      (tenths decode), 5-star-first row order; a zero-count edge case (all bars empty, no divide-
//      by-zero); rejects an empty rt_label, rt_average < 0, rt_count < 0, a distribution not of
//      length 5, a negative element, and a non-int element (6 rejections).
//   4. prism_rt_review_list: exact stack(d=5,c=23) over 2 review cards with 1 gap, exact
//      stack(d=5,c=15) over a MIXED list (plain labels + a real review, proving "any PrismNode" is
//      accepted, not just a provenance-checked review shape); rejects an empty list and a non-
//      PrismNode element named by index and type (2 rejections).
//   5. prism_rt_score_badge: exact "4/5" bare label with no rt_label, exact band(d=2,c=3) "85/100"
//      + "Overall" with a label, blank Some("") rt_label degrades to the bare-label shape, exact
//      boundary scores (0 and score==max); rejects rt_max_score < 1, rt_score < 0, rt_score >
//      rt_max_score (3 rejections).
//   6. Rejection tally: at least 8 distinct rejections proven above (19, counted explicitly).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_rating` resolve.
//   ./gen3_test.exe _kat_prism_ui_rating.nova
//   clang -O2 -o _kat_prism_ui_rating.exe _kat_prism_ui_rating.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_rating.exe

import prism_node
import prism_content
import prism_ui_rating as rt

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    // ── 1. prism_rt_stars: exact band(d=3,c=8), filled/empty split at 3/5, 0/5, 5/5, 4 rejections ──
    let stars_r = rt.prism_rt_stars("Quality", 3, 5)
    _check_true("stars(3/5) constructs", is_ok(stars_r))
    let stars_node = unwrap(stars_r)
    _check("stars(3/5) kind_str", prism_node.prism_node_kind_str(stars_node), "band")
    _check("stars(3/5) depth", str(prism_node.prism_node_depth(stars_node)), "3")
    _check("stars(3/5) count", str(prism_node.prism_node_count(stars_node)), "8")
    let s_kids = prism_node.prism_node_children(stars_node)
    _check("stars(3/5) child count", str(len(s_kids)), "2")
    _check("stars(3/5) label kind_str", prism_node.prism_node_kind_str(s_kids[0]), "label")
    _check("stars(3/5) label text", prism_node.prism_node_attr_str(s_kids[0], "text", ""), "Quality")
    _check("stars(3/5) flow kind_str", prism_node.prism_node_kind_str(s_kids[1]), "flow")
    let s_icons = prism_node.prism_node_children(s_kids[1])
    _check("stars(3/5) icon count", str(len(s_icons)), "5")
    _check("stars(3/5) icon 0 = check", prism_node.prism_node_attr_str(s_icons[0], "icon", ""), "check")
    _check("stars(3/5) icon 1 = check", prism_node.prism_node_attr_str(s_icons[1], "icon", ""), "check")
    _check("stars(3/5) icon 2 = check", prism_node.prism_node_attr_str(s_icons[2], "icon", ""), "check")
    _check("stars(3/5) icon 3 = minus", prism_node.prism_node_attr_str(s_icons[3], "icon", ""), "minus")
    _check("stars(3/5) icon 4 = minus", prism_node.prism_node_attr_str(s_icons[4], "icon", ""), "minus")

    let stars_zero = unwrap(rt.prism_rt_stars("Quality", 0, 5))
    let sz_icons = prism_node.prism_node_children(prism_node.prism_node_children(stars_zero)[1])
    _check("stars(0/5) all minus [0]", prism_node.prism_node_attr_str(sz_icons[0], "icon", ""), "minus")
    _check("stars(0/5) all minus [4]", prism_node.prism_node_attr_str(sz_icons[4], "icon", ""), "minus")
    _check("stars(0/5) count (constant shape)", str(prism_node.prism_node_count(stars_zero)), "8")

    let stars_full = unwrap(rt.prism_rt_stars("Quality", 5, 5))
    let sf_icons = prism_node.prism_node_children(prism_node.prism_node_children(stars_full)[1])
    _check("stars(5/5) all check [0]", prism_node.prism_node_attr_str(sf_icons[0], "icon", ""), "check")
    _check("stars(5/5) all check [4]", prism_node.prism_node_attr_str(sf_icons[4], "icon", ""), "check")
    _check("stars(5/5) count (constant shape)", str(prism_node.prism_node_count(stars_full)), "8")

    let stars_empty_label_r = rt.prism_rt_stars("", 3, 5)
    _check_true("stars rejects an empty rt_label", is_err(stars_empty_label_r))
    let stars_bad_max_r = rt.prism_rt_stars("Quality", 3, 0)
    _check_true("stars rejects rt_max < 1", is_err(stars_bad_max_r))
    let stars_neg_value_r = rt.prism_rt_stars("Quality", -1, 5)
    _check_true("stars rejects rt_value < 0", is_err(stars_neg_value_r))
    let stars_over_value_r = rt.prism_rt_stars("Quality", 6, 5)
    _check_true("stars rejects rt_value > rt_max", is_err(stars_over_value_r))
    print("")

    // ── 2. prism_rt_review: exact stack(d=4,c=10)/(d=4,c=11), blank date degrades, 4 rejections ──
    let review_r = rt.prism_rt_review("Jane Doe", 4, 5, "Great product!", none())
    _check_true("review (no date) constructs", is_ok(review_r))
    let review_node = unwrap(review_r)
    _check("review(no date) kind_str", prism_node.prism_node_kind_str(review_node), "stack")
    _check("review(no date) depth", str(prism_node.prism_node_depth(review_node)), "4")
    _check("review(no date) count", str(prism_node.prism_node_count(review_node)), "10")
    let r_kids = prism_node.prism_node_children(review_node)
    _check("review(no date) child count", str(len(r_kids)), "2")
    _check("review(no date) head kind_str", prism_node.prism_node_kind_str(r_kids[0]), "band")
    _check("review(no date) body text", prism_node.prism_node_attr_str(r_kids[1], "text", ""), "Great product!")
    let r_head_kids = prism_node.prism_node_children(r_kids[0])
    _check("review(no date) author text", prism_node.prism_node_attr_str(r_head_kids[0], "text", ""), "Jane Doe")
    _check("review(no date) stars kind_str", prism_node.prism_node_kind_str(r_head_kids[1]), "flow")
    let r_stars = prism_node.prism_node_children(r_head_kids[1])
    _check("review(no date) star count", str(len(r_stars)), "5")
    _check("review(no date) star 0 = check", prism_node.prism_node_attr_str(r_stars[0], "icon", ""), "check")
    _check("review(no date) star 3 = check", prism_node.prism_node_attr_str(r_stars[3], "icon", ""), "check")
    _check("review(no date) star 4 = minus", prism_node.prism_node_attr_str(r_stars[4], "icon", ""), "minus")

    let review2_r = rt.prism_rt_review("Jane Doe", 4, 5, "Great product!", some("2026-01-01"))
    _check_true("review (with date) constructs", is_ok(review2_r))
    let review2_node = unwrap(review2_r)
    _check("review(with date) depth", str(prism_node.prism_node_depth(review2_node)), "4")
    _check("review(with date) count", str(prism_node.prism_node_count(review2_node)), "11")
    let r2_kids = prism_node.prism_node_children(review2_node)
    _check("review(with date) child count", str(len(r2_kids)), "3")
    _check("review(with date) date text", prism_node.prism_node_attr_str(r2_kids[2], "text", ""), "2026-01-01")

    // Present-but-blank date degrades to the no-date shape (c=10, 2 children), never a blank line.
    let review3_r = rt.prism_rt_review("Jane Doe", 4, 5, "Great product!", some(""))
    _check_true("review (blank Some date) constructs", is_ok(review3_r))
    let review3_node = unwrap(review3_r)
    _check("review(blank date) count degrades to 10 (same as no-date)", str(prism_node.prism_node_count(review3_node)), "10")
    _check("review(blank date) child count degrades to 2", str(len(prism_node.prism_node_children(review3_node))), "2")

    let review_empty_author_r = rt.prism_rt_review("", 4, 5, "Body", none())
    _check_true("review rejects an empty rt_author", is_err(review_empty_author_r))
    let review_empty_body_r = rt.prism_rt_review("Jane Doe", 4, 5, "", none())
    _check_true("review rejects an empty rt_body", is_err(review_empty_body_r))
    let review_neg_rating_r = rt.prism_rt_review("Jane Doe", -1, 5, "Body", none())
    _check_true("review rejects rt_rating < 0", is_err(review_neg_rating_r))
    let review_over_rating_r = rt.prism_rt_review("Jane Doe", 6, 5, "Body", none())
    _check_true("review rejects rt_rating > rt_max_rating", is_err(review_over_rating_r))
    print("")

    // ── 3. prism_rt_summary: exact stack(d=5,c=33), bar lengths 5/2/1/1/0, tenths decode, order ──
    let summary_r = rt.prism_rt_summary("Product X", 42, 100, [5, 10, 15, 20, 50])
    _check_true("summary constructs", is_ok(summary_r))
    let summary_node = unwrap(summary_r)
    _check("summary kind_str", prism_node.prism_node_kind_str(summary_node), "stack")
    _check("summary depth", str(prism_node.prism_node_depth(summary_node)), "5")
    _check("summary count", str(prism_node.prism_node_count(summary_node)), "33")
    let sum_kids = prism_node.prism_node_children(summary_node)
    _check("summary child count", str(len(sum_kids)), "3")
    _check("summary title text", prism_node.prism_node_attr_str(sum_kids[0], "text", ""), "Product X")
    _check("summary avg text (tenths decode, 42 -> 4.2)", prism_node.prism_node_attr_str(sum_kids[1], "text", ""), "4.2 average from 100 reviews")
    _check("summary distribution block kind_str", prism_node.prism_node_kind_str(sum_kids[2]), "stack")
    let dist_rows = prism_node.prism_node_children(sum_kids[2])
    _check("summary row count", str(len(dist_rows)), "5")

    // Row order is 5-star first, 1-star last.
    let row0_kids = prism_node.prism_node_children(dist_rows[0])
    _check("summary row0 label (5 stars first)", prism_node.prism_node_attr_str(row0_kids[0], "text", ""), "5 stars")
    _check("summary row0 count text", prism_node.prism_node_attr_str(row0_kids[1], "text", ""), "50")
    _check("summary row0 bar length = 5 (50*10/100)", str(len(prism_node.prism_node_children(row0_kids[2]))), "5")

    let row1_kids = prism_node.prism_node_children(dist_rows[1])
    _check("summary row1 label", prism_node.prism_node_attr_str(row1_kids[0], "text", ""), "4 stars")
    _check("summary row1 count text", prism_node.prism_node_attr_str(row1_kids[1], "text", ""), "20")
    _check("summary row1 bar length = 2 (20*10/100)", str(len(prism_node.prism_node_children(row1_kids[2]))), "2")

    let row2_kids = prism_node.prism_node_children(dist_rows[2])
    _check("summary row2 label", prism_node.prism_node_attr_str(row2_kids[0], "text", ""), "3 stars")
    _check("summary row2 bar length = 1 (15*10/100 truncates)", str(len(prism_node.prism_node_children(row2_kids[2]))), "1")

    let row3_kids = prism_node.prism_node_children(dist_rows[3])
    _check("summary row3 label", prism_node.prism_node_attr_str(row3_kids[0], "text", ""), "2 stars")
    _check("summary row3 bar length = 1 (10*10/100)", str(len(prism_node.prism_node_children(row3_kids[2]))), "1")

    let row4_kids = prism_node.prism_node_children(dist_rows[4])
    _check("summary row4 label (1-star last)", prism_node.prism_node_attr_str(row4_kids[0], "text", ""), "1 stars")
    _check("summary row4 count text", prism_node.prism_node_attr_str(row4_kids[1], "text", ""), "5")
    _check("summary row4 bar length = 0 (5*10/100 truncates to 0)", str(len(prism_node.prism_node_children(row4_kids[2]))), "0")

    // Zero-count edge case: every bar is empty, no divide-by-zero.
    let summary_zero_r = rt.prism_rt_summary("Empty Product", 0, 0, [0, 0, 0, 0, 0])
    _check_true("summary (zero count) constructs without a divide-by-zero", is_ok(summary_zero_r))
    let summary_zero = unwrap(summary_zero_r)
    let summary_zero_kids = prism_node.prism_node_children(summary_zero)
    _check("summary(zero) avg text", prism_node.prism_node_attr_str(summary_zero_kids[1], "text", ""), "0.0 average from 0 reviews")
    _check("summary(zero) depth", str(prism_node.prism_node_depth(summary_zero)), "4")
    _check("summary(zero) count", str(prism_node.prism_node_count(summary_zero)), "24")
    let zero_rows = prism_node.prism_node_children(prism_node.prism_node_children(summary_zero)[2])
    _check("summary(zero) row0 bar length = 0", str(len(prism_node.prism_node_children(prism_node.prism_node_children(zero_rows[0])[2]))), "0")

    let summary_empty_label_r = rt.prism_rt_summary("", 42, 100, [5, 10, 15, 20, 50])
    _check_true("summary rejects an empty rt_label", is_err(summary_empty_label_r))
    let summary_neg_avg_r = rt.prism_rt_summary("X", -1, 100, [5, 10, 15, 20, 50])
    _check_true("summary rejects rt_average < 0", is_err(summary_neg_avg_r))
    let summary_neg_count_r = rt.prism_rt_summary("X", 42, -1, [5, 10, 15, 20, 50])
    _check_true("summary rejects rt_count < 0", is_err(summary_neg_count_r))
    let summary_bad_len_r = rt.prism_rt_summary("X", 42, 100, [5, 10, 15, 20])
    _check_true("summary rejects a distribution not of length 5", is_err(summary_bad_len_r))
    let summary_neg_elem_r = rt.prism_rt_summary("X", 42, 100, [5, 10, 15, 20, -1])
    _check_true("summary rejects a negative distribution element", is_err(summary_neg_elem_r))
    if is_err(summary_neg_elem_r)
        _check_true("summary negative-element rejection names index 4", contains(unwrap_err(summary_neg_elem_r), "4"))
    let summary_bad_type_r = rt.prism_rt_summary("X", 42, 100, ["x", 10, 15, 20, 50])
    _check_true("summary rejects a non-int distribution element", is_err(summary_bad_type_r))
    if is_err(summary_bad_type_r)
        _check_true("summary non-int rejection names index 0 and type string", contains(unwrap_err(summary_bad_type_r), "0") and contains(unwrap_err(summary_bad_type_r), "string"))
    print("")

    // ── 4. prism_rt_review_list: exact stack(d=5,c=23), mixed-content stack(d=5,c=15), rejects ──
    let list_r = rt.prism_rt_review_list([review_node, review2_node])
    _check_true("review_list (2 reviews) constructs", is_ok(list_r))
    let list_node = unwrap(list_r)
    _check("review_list kind_str", prism_node.prism_node_kind_str(list_node), "stack")
    _check("review_list depth", str(prism_node.prism_node_depth(list_node)), "5")
    _check("review_list count", str(prism_node.prism_node_count(list_node)), "23")
    let list_kids = prism_node.prism_node_children(list_node)
    _check("review_list child count (2 reviews + 1 gap)", str(len(list_kids)), "3")
    _check("review_list gap kind_str", prism_node.prism_node_kind_str(list_kids[1]), "gap")
    _check("review_list gap size is 8 (fixed)", str(prism_node.prism_node_attr_int(list_kids[1], "size", -1)), "8")
    _check_true("review_list gap is not flexible", not prism_node.prism_node_attr_bool(list_kids[1], "flexible", true))

    // Mixed content (2 plain labels + 1 real review) proves "any PrismNode" is accepted.
    let label_a = unwrap(prism_content.prism_label("A"))
    let label_b = unwrap(prism_content.prism_label("B"))
    let mixed_r = rt.prism_rt_review_list([label_a, review_node, label_b])
    _check_true("review_list (mixed content) constructs", is_ok(mixed_r))
    let mixed_node = unwrap(mixed_r)
    _check("review_list(mixed) depth", str(prism_node.prism_node_depth(mixed_node)), "5")
    _check("review_list(mixed) count", str(prism_node.prism_node_count(mixed_node)), "15")
    _check("review_list(mixed) child count (3 items + 2 gaps)", str(len(prism_node.prism_node_children(mixed_node))), "5")

    let list_empty_r = rt.prism_rt_review_list([])
    _check_true("review_list rejects an empty list", is_err(list_empty_r))
    let list_bad_elem_r = rt.prism_rt_review_list([review_node, 5])
    _check_true("review_list rejects a non-PrismNode element", is_err(list_bad_elem_r))
    if is_err(list_bad_elem_r)
        _check_true("review_list rejection names index 1 and type int", contains(unwrap_err(list_bad_elem_r), "1") and contains(unwrap_err(list_bad_elem_r), "int"))
    print("")

    // ── 5. prism_rt_score_badge: bare "4/5", band "85/100"+"Overall", blank degrades, 3 rejects ──
    let badge_r = rt.prism_rt_score_badge(4, 5, none())
    _check_true("score_badge (no label) constructs", is_ok(badge_r))
    let badge_node = unwrap(badge_r)
    _check("score_badge(no label) kind_str (bare label, no band wrapper)", prism_node.prism_node_kind_str(badge_node), "label")
    _check("score_badge(no label) text", prism_node.prism_node_attr_str(badge_node, "text", ""), "4/5")
    _check("score_badge(no label) depth", str(prism_node.prism_node_depth(badge_node)), "1")
    _check("score_badge(no label) count", str(prism_node.prism_node_count(badge_node)), "1")

    let badge2_r = rt.prism_rt_score_badge(85, 100, some("Overall"))
    _check_true("score_badge (with label) constructs", is_ok(badge2_r))
    let badge2_node = unwrap(badge2_r)
    _check("score_badge(with label) kind_str", prism_node.prism_node_kind_str(badge2_node), "band")
    _check("score_badge(with label) depth", str(prism_node.prism_node_depth(badge2_node)), "2")
    _check("score_badge(with label) count", str(prism_node.prism_node_count(badge2_node)), "3")
    let b2_kids = prism_node.prism_node_children(badge2_node)
    _check("score_badge(with label) score text", prism_node.prism_node_attr_str(b2_kids[0], "text", ""), "85/100")
    _check("score_badge(with label) label text", prism_node.prism_node_attr_str(b2_kids[1], "text", ""), "Overall")

    // Present-but-blank label degrades to the bare-label shape.
    let badge3_r = rt.prism_rt_score_badge(4, 5, some(""))
    _check_true("score_badge (blank Some label) constructs", is_ok(badge3_r))
    let badge3_node = unwrap(badge3_r)
    _check("score_badge(blank label) kind_str degrades to bare label", prism_node.prism_node_kind_str(badge3_node), "label")
    _check("score_badge(blank label) count degrades to 1", str(prism_node.prism_node_count(badge3_node)), "1")

    // Exact boundaries: score = 0 (min) and score = max_score (max) are both valid.
    let badge_min = unwrap(rt.prism_rt_score_badge(0, 5, none()))
    _check("score_badge(score=0) text", prism_node.prism_node_attr_str(badge_min, "text", ""), "0/5")
    let badge_max = unwrap(rt.prism_rt_score_badge(5, 5, none()))
    _check("score_badge(score=max) text", prism_node.prism_node_attr_str(badge_max, "text", ""), "5/5")

    let badge_bad_max_r = rt.prism_rt_score_badge(4, 0, none())
    _check_true("score_badge rejects rt_max_score < 1", is_err(badge_bad_max_r))
    let badge_neg_score_r = rt.prism_rt_score_badge(-1, 5, none())
    _check_true("score_badge rejects rt_score < 0", is_err(badge_neg_score_r))
    let badge_over_score_r = rt.prism_rt_score_badge(6, 5, none())
    _check_true("score_badge rejects rt_score > rt_max_score", is_err(badge_over_score_r))
    print("")

    // ── 6. Rejection tally: at least 8 distinct rejections proven above (19, counted here) ──────
    // stars: label, max<1, value<0, value>max (4); review: author, body, rating<0, rating>max (4);
    // summary: label, average<0, count<0, bad length, negative elem, non-int elem (6);
    // review_list: empty, bad element (2); score_badge: max<1, score<0, score>max (3)
    let rejection_count = 19
    _check_true("expected at least 8 rejection cases, counted " + str(rejection_count), rejection_count >= 8)

    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_rating: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_rating: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
