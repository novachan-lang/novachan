// KAT for prism/widget/prism_interact.nova + prism/widget/prism_structure.nova
// (PRISM_ROADMAP.md milestone MA.3, part B: the 6 interaction + 5 structure primitives).
//
// Proves, against concrete expected values:
//   1. All 6 interaction primitives (press/entry/pick/flag/range/link) construct the correct
//      PrismNodeKind.
//   2. All 5 structure primitives (each/grid/sheet/hint/tabs) construct the correct
//      PrismNodeKind.
//   3. each/grid attach the right key to each row, and REJECT a duplicate key.
//   4. prism_link REJECTS javascript:/data:/vbscript: destinations and ACCEPTS https:// and an
//      in-app route.
//   5. range REJECTS min>max and step<=0.
//   6. tabs REJECTS an out-of-bounds selected index.
//   7. Attribute values round-trip through prism_node_attr_str/_int/_bool.
//   8. A nested composition (tabs > sheet > each > press) builds with exactly correct cached
//      depth/count.
//   9. ADVERSARIAL ACCEPTED-set audit (2026-08-15): probing what prism_link ADMITS, not just
//      what it rejects -- an allowlist is only as strong as its accepted set. 3 must-accept
//      baselines, 9 script-execution rejections (javascript:/data:/vbscript:/file: in every
//      case-and-whitespace disguise), the 3 holes found and fixed that same day (backslash
//      route bypass, CRLF header/response-splitting injection, userinfo authority spoof), and
//      the one case that looks dangerous but correctly stays ACCEPTED (a route whose OWN query
//      param contains a javascript: string -- not prism_link's concern).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib/, so `import prism_node` / `import prism_interact` / `import prism_structure`
// all resolve, exactly like _kat_prism_node.nova.
//   ./gen3_test.exe _kat_prism_widget_b.nova
//   clang -O2 -o _kat_prism_widget_b.exe _kat_prism_widget_b.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_widget_b.exe

import prism_node
import prism_interact
import prism_structure

fn _fail(msg: string)
    print("FAIL " + msg)
    exit(1)

fn main()
    // ── 1. Interaction primitives: correct PrismNodeKind each ───────────────────────────
    let press_r = prism_interact.prism_press("Save", [])
    if is_err(press_r)
        _fail("prism_press construction: " + unwrap_err(press_r))
    assert_eq(prism_node.prism_node_kind_str(unwrap(press_r)), "press")

    let entry_r = prism_interact.prism_entry("Name", prism_interact.prism_entry_kind_email(), "ann@example.com")
    if is_err(entry_r)
        _fail("prism_entry construction: " + unwrap_err(entry_r))
    let entry_node = unwrap(entry_r)
    assert_eq(prism_node.prism_node_kind_str(entry_node), "entry")

    let opts = [prism_interact.prism_pick_option("apple", "Apple"), prism_interact.prism_pick_option("pear", "Pear")]
    let pick_r = prism_interact.prism_pick(opts, "pear")
    if is_err(pick_r)
        _fail("prism_pick construction: " + unwrap_err(pick_r))
    let pick_node = unwrap(pick_r)
    assert_eq(prism_node.prism_node_kind_str(pick_node), "pick")

    let flag_r = prism_interact.prism_flag("Active", true)
    if is_err(flag_r)
        _fail("prism_flag construction: " + unwrap_err(flag_r))
    let flag_node = unwrap(flag_r)
    assert_eq(prism_node.prism_node_kind_str(flag_node), "flag")

    let range_r = prism_interact.prism_range("Volume", 0, 100, 5, 40)
    if is_err(range_r)
        _fail("prism_range construction: " + unwrap_err(range_r))
    let range_node = unwrap(range_r)
    assert_eq(prism_node.prism_node_kind_str(range_node), "range")

    let link_ok_r = prism_interact.prism_link("Docs", prism_interact.prism_link_target_url("https://example.com/docs"))
    if is_err(link_ok_r)
        _fail("prism_link (https) construction: " + unwrap_err(link_ok_r))
    let link_node = unwrap(link_ok_r)
    assert_eq(prism_node.prism_node_kind_str(link_node), "link")
    print("1. all 6 interaction primitives construct correct PrismNodeKind: OK")

    // ── 2. Structure primitives: correct PrismNodeKind each ─────────────────────────────
    let each_r = prism_structure.prism_each(["a", "b", "c"], fn(it) it, fn(it) prism_interact.prism_press(it, []))
    if is_err(each_r)
        _fail("prism_each construction: " + unwrap_err(each_r))
    let each_node = unwrap(each_r)
    assert_eq(prism_node.prism_node_kind_str(each_node), "each")

    let grid_rows = [{"id": "r1", "name": "Alice"}, {"id": "r2", "name": "Bob"}]
    let grid_r = prism_structure.prism_grid(grid_rows, fn(r) r["id"], ["name"], fn(r, col) prism_interact.prism_entry(col, prism_interact.prism_entry_kind_text(), str(r[col])))
    if is_err(grid_r)
        _fail("prism_grid construction: " + unwrap_err(grid_r))
    let grid_node = unwrap(grid_r)
    assert_eq(prism_node.prism_node_kind_str(grid_node), "grid")

    let sheet_r = prism_structure.prism_sheet(unwrap(prism_interact.prism_press("Inner", [])), true)
    if is_err(sheet_r)
        _fail("prism_sheet construction: " + unwrap_err(sheet_r))
    let sheet_node = unwrap(sheet_r)
    assert_eq(prism_node.prism_node_kind_str(sheet_node), "sheet")

    let hint_r = prism_structure.prism_hint("Click to save", unwrap(prism_interact.prism_press("Save", [])))
    if is_err(hint_r)
        _fail("prism_hint construction: " + unwrap_err(hint_r))
    let hint_node = unwrap(hint_r)
    assert_eq(prism_node.prism_node_kind_str(hint_node), "hint")

    let tab_panels = [prism_structure.prism_tab_panel("General", unwrap(prism_interact.prism_press("A", []))), prism_structure.prism_tab_panel("Advanced", unwrap(prism_interact.prism_press("B", [])))]
    let tabs_r = prism_structure.prism_tabs(tab_panels, 0)
    if is_err(tabs_r)
        _fail("prism_tabs construction: " + unwrap_err(tabs_r))
    let tabs_node = unwrap(tabs_r)
    assert_eq(prism_node.prism_node_kind_str(tabs_node), "tabs")
    print("2. all 5 structure primitives construct correct PrismNodeKind: OK")

    // ── 3. each/grid key assignment + duplicate-key rejection ──────────────────────────
    let each_children = prism_node.prism_node_children(each_node)
    assert_eq(len(each_children), 3)
    match prism_node.prism_node_key(each_children[0])
        Some(k) => assert_eq(k, "a")
        None => _fail("each row 0 should have key 'a'")
    match prism_node.prism_node_key(each_children[1])
        Some(k) => assert_eq(k, "b")
        None => _fail("each row 1 should have key 'b'")
    match prism_node.prism_node_key(each_children[2])
        Some(k) => assert_eq(k, "c")
        None => _fail("each row 2 should have key 'c'")

    let each_dup_r = prism_structure.prism_each(["x", "y", "x"], fn(it) it, fn(it) prism_interact.prism_press(it, []))
    if is_ok(each_dup_r)
        _fail("prism_each should reject a duplicate key 'x', but construction succeeded")
    print("3a. each: correct per-row keys + duplicate-key rejection: OK -- " + unwrap_err(each_dup_r))

    let grid_children = prism_node.prism_node_children(grid_node)
    assert_eq(len(grid_children), 2)
    match prism_node.prism_node_key(grid_children[0])
        Some(k) => assert_eq(k, "r1")
        None => _fail("grid row 0 should have key 'r1'")
    match prism_node.prism_node_key(grid_children[1])
        Some(k) => assert_eq(k, "r2")
        None => _fail("grid row 1 should have key 'r2'")

    let grid_dup_key_r = prism_structure.prism_grid([{"id": "r1", "name": "A"}, {"id": "r1", "name": "B"}], fn(r) r["id"], ["name"], fn(r, col) prism_interact.prism_entry(col, prism_interact.prism_entry_kind_text(), str(r[col])))
    if is_ok(grid_dup_key_r)
        _fail("prism_grid should reject a duplicate row key 'r1', but construction succeeded")
    let grid_dup_col_r = prism_structure.prism_grid(grid_rows, fn(r) r["id"], ["name", "name"], fn(r, col) prism_interact.prism_entry(col, prism_interact.prism_entry_kind_text(), str(r[col])))
    if is_ok(grid_dup_col_r)
        _fail("prism_grid should reject a duplicate column name 'name', but construction succeeded")
    print("3b. grid: correct per-row keys + duplicate-key/duplicate-column rejection: OK -- " + unwrap_err(grid_dup_key_r) + " / " + unwrap_err(grid_dup_col_r))

    // ── 4. prism_link scheme allowlist ──────────────────────────────────────────────────
    let bad_targets = [prism_interact.prism_link_target_url("javascript:alert(1)"), prism_interact.prism_link_target_url("data:text/html,<script>alert(1)</script>"), prism_interact.prism_link_target_url("vbscript:msgbox(1)")]
    for t in bad_targets
        let r = prism_interact.prism_link("Click me", t)
        if is_ok(r)
            _fail("prism_link should reject a dangerous scheme, but construction succeeded")
    let route_r = prism_interact.prism_link("Dashboard", prism_interact.prism_link_target_route("/dashboard"))
    if is_err(route_r)
        _fail("prism_link should accept an in-app route '/dashboard': " + unwrap_err(route_r))
    let bad_route_r = prism_interact.prism_link("Evil", prism_interact.prism_link_target_route("//evil.com"))
    if is_ok(bad_route_r)
        _fail("prism_link should reject a protocol-relative '//evil.com' route, but construction succeeded")
    print("4. prism_link rejects javascript:/data:/vbscript:/protocol-relative, accepts https:// and an in-app route: OK")

    // ── 5. range validation ─────────────────────────────────────────────────────────────
    let range_bad_order_r = prism_interact.prism_range("Bad", 10, 0, 1, 5)
    if is_ok(range_bad_order_r)
        _fail("prism_range should reject min > max, but construction succeeded")
    let range_bad_step_r = prism_interact.prism_range("Bad", 0, 10, 0, 5)
    if is_ok(range_bad_step_r)
        _fail("prism_range should reject step <= 0, but construction succeeded")
    let range_bad_step_neg_r = prism_interact.prism_range("Bad", 0, 10, -1, 5)
    if is_ok(range_bad_step_neg_r)
        _fail("prism_range should reject a negative step, but construction succeeded")
    let range_bad_value_r = prism_interact.prism_range("Bad", 0, 10, 1, 99)
    if is_ok(range_bad_value_r)
        _fail("prism_range should reject an out-of-bounds value, but construction succeeded")
    print("5. range rejects min>max, step<=0, and an out-of-bounds value: OK -- " + unwrap_err(range_bad_order_r) + " / " + unwrap_err(range_bad_step_r))

    // ── 6. tabs selected-index bounds ───────────────────────────────────────────────────
    let tabs_neg_r = prism_structure.prism_tabs(tab_panels, -1)
    if is_ok(tabs_neg_r)
        _fail("prism_tabs should reject a negative selected index, but construction succeeded")
    let tabs_over_r = prism_structure.prism_tabs(tab_panels, 2)
    if is_ok(tabs_over_r)
        _fail("prism_tabs should reject selected index 2 (only 2 panels, 0..1 valid), but construction succeeded")
    print("6. tabs rejects an out-of-bounds selected index: OK -- " + unwrap_err(tabs_over_r))

    // ── 7. attribute round-trip through attr_str / attr_int / attr_bool ────────────────
    assert_eq(prism_node.prism_node_attr_str(entry_node, "prompt", ""), "Name")
    assert_eq(prism_interact.prism_entry_kind_of(entry_node), "email")
    assert_eq(prism_node.prism_node_attr_str(entry_node, "value", ""), "ann@example.com")

    assert_eq(prism_node.prism_node_attr_int(range_node, "min", -1), 0)
    assert_eq(prism_node.prism_node_attr_int(range_node, "max", -1), 100)
    assert_eq(prism_node.prism_node_attr_int(range_node, "step", -1), 5)
    assert_eq(prism_node.prism_node_attr_int(range_node, "value", -1), 40)

    if not prism_node.prism_node_attr_bool(flag_node, "state", false)
        _fail("flag_node attr_bool('state') should round-trip to true")

    assert_eq(prism_interact.prism_pick_selected_value(pick_node), "pear")
    let pick_opts_back = prism_interact.prism_pick_options(pick_node)
    assert_eq(len(pick_opts_back), 2)
    assert_eq(pick_opts_back[1].value, "pear")

    assert_eq(prism_structure.prism_tabs_panel_label(prism_node.prism_node_children(tabs_node)[0]), "General")
    assert_eq(prism_structure.prism_tabs_panel_label(prism_node.prism_node_children(tabs_node)[1]), "Advanced")
    print("7. attribute values round-trip through attr_str/attr_int/attr_bool (+ list-valued pick_options): OK")

    // ── 8. Nested composition: exact cached depth/count ─────────────────────────────────
    // tabs (1 panel) > sheet(exclusive) > each(3 items) > press per item.
    //   press leaf:              depth=1  count=1        (x3, one per each-item)
    //   each branch (3 rows):    depth=2  count=1+3=4
    //   sheet branch (1 child):  depth=3  count=1+4=5
    //   tabs relabels the sheet node in place (same children -> same depth/count), then wraps:
    //   tabs branch (1 child):   depth=4  count=1+5=6
    let nest_each_r = prism_structure.prism_each(["p", "q", "r"], fn(it) it, fn(it) prism_interact.prism_press(it, []))
    if is_err(nest_each_r)
        _fail("nested each construction: " + unwrap_err(nest_each_r))
    let nest_each = unwrap(nest_each_r)
    assert_eq(prism_node.prism_node_depth(nest_each), 2)
    assert_eq(prism_node.prism_node_count(nest_each), 4)

    let nest_sheet_r = prism_structure.prism_sheet(nest_each, true)
    if is_err(nest_sheet_r)
        _fail("nested sheet construction: " + unwrap_err(nest_sheet_r))
    let nest_sheet = unwrap(nest_sheet_r)
    assert_eq(prism_node.prism_node_depth(nest_sheet), 3)
    assert_eq(prism_node.prism_node_count(nest_sheet), 5)

    let nest_tabs_r = prism_structure.prism_tabs([prism_structure.prism_tab_panel("Only", nest_sheet)], 0)
    if is_err(nest_tabs_r)
        _fail("nested tabs construction: " + unwrap_err(nest_tabs_r))
    let nest_tabs = unwrap(nest_tabs_r)
    assert_eq(prism_node.prism_node_depth(nest_tabs), 4)
    assert_eq(prism_node.prism_node_count(nest_tabs), 6)
    print("8. nested composition (tabs > sheet > each x3 > press) has exact cached depth=4/count=6: OK")

    // ── 9. Adversarial ACCEPTED-set audit (2026-08-15) -- PRISM_SPEC.md §15.1 hardening ────
    // Section 4 above already proves the REJECTED set (bad schemes always fail). This section
    // proves the ACCEPTED set is equally sound -- the exact gap an allowlist can silently have if
    // only the reject side is ever tested. Each case is asserted individually (not looped) so a
    // future regression on any ONE of them fails loudly and names which case broke, per the
    // "KAT is what stops it returning" rule -- this exact bug class came back once already.
    let tab9 = chr(9)
    let nl9 = chr(10)
    let cr9 = chr(13)
    let bs9 = chr(92)

    // -- 3 must-ACCEPT baselines (never weaken these) --
    if is_err(prism_interact.prism_link("x", prism_interact.prism_link_target_url("https://example.com/a")))
        _fail("9: plain https 'https://example.com/a' must be ACCEPTED")
    if is_err(prism_interact.prism_link("x", prism_interact.prism_link_target_url("http://example.com")))
        _fail("9: plain http 'http://example.com' must be ACCEPTED")
    if is_err(prism_interact.prism_link("x", prism_interact.prism_link_target_route("/dashboard")))
        _fail("9: plain in-app route '/dashboard' must be ACCEPTED")

    // -- 9 script-execution rejections. All fail via the {http,https} allowlist (see the comment
    //    on prism_link's ExternalUrl arm for why javascript:/vbscript:/etc. are denied even
    //    though their scheme is never literally extracted as "javascript"/"vbscript"). --
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_url("javascript:alert(1)")))
        _fail("9: javascript: (lower case) must be REJECTED")
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_url("JaVaScRiPt:alert(1)")))
        _fail("9: JaVaScRiPt: (mixed case) must be REJECTED")
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_url("javascript://x/alert(1)")))
        _fail("9: javascript://x/alert(1) (with slashes) must be REJECTED")
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_url(" javascript:alert(1)")))
        _fail("9: ' javascript:alert(1)' (leading space) must be REJECTED")
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_url("java" + tab9 + "script:alert(1)")))
        _fail("9: 'java<TAB>script:alert(1)' (embedded tab) must be REJECTED")
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_url("java" + nl9 + "script:alert(1)")))
        _fail("9: 'java<LF>script:alert(1)' (embedded newline) must be REJECTED")
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_url("data:text/html,<script>alert(1)</script>")))
        _fail("9: data:text/html,<script>...</script> must be REJECTED")
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_url("vbscript:msgbox(1)")))
        _fail("9: vbscript:msgbox(1) must be REJECTED")
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_url("file:///C:/Windows/win.ini")))
        _fail("9: file:///C:/Windows/win.ini must be REJECTED")

    // -- 3 now-fixed holes (2026-08-15 adversarial pass on the ACCEPTED set) --
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_route("/" + bs9 + "evil.com")))
        _fail("9 HOLE 1 (backslash route bypass): '/\\evil.com' must now be REJECTED -- browsers normalize a leading backslash to '/' in authority position, the SAME cross-origin bypass '//evil.com' is rejected for")
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_url("https://example.com/" + cr9 + nl9 + "X: 1")))
        _fail("9 HOLE 2 (CRLF injection, ExternalUrl): 'https://example.com/<CR><LF>X: 1' must now be REJECTED -- HTTP response-splitting / header injection")
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_route("/ok" + cr9 + nl9 + "X: 1")))
        _fail("9 HOLE 2 (CRLF injection, AppRoute): '/ok<CR><LF>X: 1' must now be REJECTED -- same response-splitting risk, other constructor (extra coverage: the guard must fire on BOTH prism_link_target_url and prism_link_target_route independently)")
    if is_ok(prism_interact.prism_link("x", prism_interact.prism_link_target_url("https://example.com@evil.com/")))
        _fail("9 HOLE 3 (userinfo spoof): 'https://example.com@evil.com/' must now be REJECTED -- the browser navigates to evil.com; 'example.com' is only a discarded username")

    // -- must-still-ACCEPT: an in-app route whose own QUERY PARAMETER happens to contain a
    //    string that looks dangerous is not prism_link's concern -- rejecting it would break
    //    legitimate return-URL patterns. Do NOT "fix" this case; it is correct as-is.
    if is_err(prism_interact.prism_link("x", prism_interact.prism_link_target_route("/redirect?next=javascript:alert(1)")))
        _fail("9: '/redirect?next=javascript:alert(1)' must still be ACCEPTED -- the query param's content is not prism_link's responsibility")

    // -- extra coverage beyond the specified 16: the HOLE 3 fix scopes its '@' search to the
    //    AUTHORITY only (between "://" and the next '/','?','#') precisely so a legitimate '@' in
    //    the path or query keeps working. Regression-proof that scoping directly, so a future
    //    "simplification" that searches the whole URL for '@' gets caught immediately.
    if is_err(prism_interact.prism_link("x", prism_interact.prism_link_target_url("https://example.com/search?to=a@b.com")))
        _fail("9: 'https://example.com/search?to=a@b.com' must still be ACCEPTED -- '@' is in the QUERY, not the authority")
    if is_err(prism_interact.prism_link("x", prism_interact.prism_link_target_url("https://example.com/users/@handle")))
        _fail("9: 'https://example.com/users/@handle' must still be ACCEPTED -- '@' is in the PATH, not the authority")

    print("9. adversarial ACCEPTED-set audit: 3 must-accept + 9 script-execution-reject + 3 holes fixed (route backslash / CRLF header-injection on both ExternalUrl+AppRoute / userinfo spoof) + 1 must-still-accept + 2 authority-scoping regression guards -- all exact, PRISM_SPEC.md §15.1 hole closed")

    print("KAT prism_widget_b PASSED: 6 interaction + 5 structure primitives, keys, link allowlist, range/tabs bounds, attr round-trip, nested depth/count, adversarial ACCEPTED-set audit -- all exact")
