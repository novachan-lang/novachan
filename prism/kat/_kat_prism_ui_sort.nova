// KAT for prism/ui/prism_ui_sort.nova (PRISM_ROADMAP.md-style milestone MB.21, the `ui/`
// composition layer's sortable/reorderable list family: drag-handle sortable list, pure list-move
// helper, numbered ranking list, checkable list).
//
// Every expected shape below is hand-computed from `prism_node.prism_node_new`'s own depth/count
// rule (leaf: depth=1, count=1; branch: depth=max(child depths)+1, count=1+sum(child counts)) --
// never taken on faith from the implementation. Every `prism_so_move` expected list is hand-traced
// through the documented "remove at from_index, reinsert at to_index in the FINAL list" algorithm.
// Proves, against concrete expected values:
//   1. prism_so_sortable: exact stack(d=4,c=11) wrapping an each(d=3,c=10) over 3 keyed rows, each
//      row an exact band(d=2,c=3) [glyph(menu), label(item)]; key on each row comes from so_key_fn
//      (a "k_"-prefixed key, proven DISTINCT from the item text, not the row's own label attr);
//      a single-item list gives stack(d=4,c=5)/each(d=3,c=4); rejects an empty so_items, a
//      non-string element (named by index and type), and (propagated from prism_each unmodified) a
//      duplicate key (3 rejections).
//   2. prism_so_move: exact moved lists for 4 different (from,to) pairs on a 4-item list, hand-
//      traced through the remove-then-reinsert algorithm; proves the ORIGINAL list is never mutated
//      by any call; rejects so_from<0, so_from>=n, so_to>=n, so_from==so_to, and an out-of-bounds
//      call against an empty list (5 rejections).
//   3. prism_so_ranked: exact stack(d=3,c=10) over 3 rows, each an exact band(d=2,c=3)
//      [label("#N"), label(item)] with 1-based rank in item order; a single-item list gives
//      stack(d=3,c=4); rejects an empty so_items and a non-string element (2 rejections).
//   4. prism_so_checklist: exact stack(d=3,c=13) over 4 rows with the exact check/minus split for a
//      2-of-4 checked set; an all-unchecked (empty so_checked) list gives the all-minus stack
//      (d=3,c=7); rejects an empty so_items, a non-string element in so_items, a non-string element
//      in so_checked, and a so_checked entry absent from so_items (named by value) (4 rejections).
//   5. Rejection tally: 14 distinct rejections proven above, counted explicitly.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_sort` resolve.
//   ./gen3_test.exe _kat_prism_ui_sort.nova
//   clang -O2 -o _kat_prism_ui_sort.exe _kat_prism_ui_sort.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_sort.exe

import prism_node
import prism_content
import prism_ui_sort

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    // ── 1. prism_so_sortable: stack(d=4,c=11)/each(d=3,c=10)/rows, single-item, 3 rejections ──────
    print("== 1. prism_so_sortable ==")

    let sort_key_fn = fn(s) "k_" + s
    let sortable_r = prism_ui_sort.prism_so_sortable(["Buy milk", "Walk dog", "Write report"], sort_key_fn)
    _check_true("sortable constructs", is_ok(sortable_r))
    let sortable_node = unwrap(sortable_r)
    _check("sortable kind_str", prism_node.prism_node_kind_str(sortable_node), "stack")
    _check("sortable depth", str(prism_node.prism_node_depth(sortable_node)), "4")
    _check("sortable count", str(prism_node.prism_node_count(sortable_node)), "11")
    let so_kids = prism_node.prism_node_children(sortable_node)
    _check("sortable child count (the each node)", str(len(so_kids)), "1")
    let each_node = so_kids[0]
    _check("sortable each kind_str", prism_node.prism_node_kind_str(each_node), "each")
    _check("sortable each depth", str(prism_node.prism_node_depth(each_node)), "3")
    _check("sortable each count", str(prism_node.prism_node_count(each_node)), "10")
    let rows = prism_node.prism_node_children(each_node)
    _check("sortable row count", str(len(rows)), "3")

    let row0 = rows[0]
    _check("sortable row0 kind_str", prism_node.prism_node_kind_str(row0), "band")
    _check("sortable row0 depth", str(prism_node.prism_node_depth(row0)), "2")
    _check("sortable row0 count", str(prism_node.prism_node_count(row0)), "3")
    let row0_kids = prism_node.prism_node_children(row0)
    _check("sortable row0 glyph kind_str", prism_node.prism_node_kind_str(row0_kids[0]), "glyph")
    _check("sortable row0 glyph icon (drag handle = menu)", prism_node.prism_node_attr_str(row0_kids[0], "icon", ""), "menu")
    _check("sortable row0 label kind_str", prism_node.prism_node_kind_str(row0_kids[1]), "label")
    _check("sortable row0 label text", prism_node.prism_node_attr_str(row0_kids[1], "text", ""), "Buy milk")
    let row0_key = prism_node.prism_node_key(row0)
    _check_true("sortable row0 has a key", prism_node.prism_node_has_key(row0))
    match row0_key
        Some(v) => _check("sortable row0 key comes from so_key_fn, not item text", v, "k_Buy milk")
        None => _check_true("sortable row0 key must be Some", false)

    let row1_kids = prism_node.prism_node_children(rows[1])
    _check("sortable row1 label text", prism_node.prism_node_attr_str(row1_kids[1], "text", ""), "Walk dog")
    match prism_node.prism_node_key(rows[1])
        Some(v) => _check("sortable row1 key", v, "k_Walk dog")
        None => _check_true("sortable row1 key must be Some", false)

    let row2_kids = prism_node.prism_node_children(rows[2])
    _check("sortable row2 label text", prism_node.prism_node_attr_str(row2_kids[1], "text", ""), "Write report")
    match prism_node.prism_node_key(rows[2])
        Some(v) => _check("sortable row2 key", v, "k_Write report")
        None => _check_true("sortable row2 key must be Some", false)

    // Single-item list: stack(d=4,c=5) wrapping each(d=3,c=4).
    let sortable_one_r = prism_ui_sort.prism_so_sortable(["Solo"], sort_key_fn)
    _check_true("sortable (1 item) constructs", is_ok(sortable_one_r))
    let sortable_one = unwrap(sortable_one_r)
    _check("sortable(1) depth", str(prism_node.prism_node_depth(sortable_one)), "4")
    _check("sortable(1) count", str(prism_node.prism_node_count(sortable_one)), "5")
    let one_each = prism_node.prism_node_children(sortable_one)[0]
    _check("sortable(1) each depth", str(prism_node.prism_node_depth(one_each)), "3")
    _check("sortable(1) each count", str(prism_node.prism_node_count(one_each)), "4")

    let sortable_empty_r = prism_ui_sort.prism_so_sortable([], sort_key_fn)
    _check_true("sortable rejects an empty so_items", is_err(sortable_empty_r))
    let sortable_bad_elem_r = prism_ui_sort.prism_so_sortable(["A", 5, "C"], sort_key_fn)
    _check_true("sortable rejects a non-string element", is_err(sortable_bad_elem_r))
    if is_err(sortable_bad_elem_r)
        _check_true("sortable non-string rejection names index 1 and type int", contains(unwrap_err(sortable_bad_elem_r), "1") and contains(unwrap_err(sortable_bad_elem_r), "int"))
    let dup_key_fn = fn(s) "dup"
    let sortable_dup_r = prism_ui_sort.prism_so_sortable(["X", "Y"], dup_key_fn)
    _check_true("sortable rejects a duplicate key (propagated from prism_each)", is_err(sortable_dup_r))
    if is_err(sortable_dup_r)
        _check_true("sortable duplicate-key rejection names 'duplicate key'", contains(unwrap_err(sortable_dup_r), "duplicate key"))
    print("")

    // ── 2. prism_so_move: 4 exact moves, purity, 5 rejections ───────────────────────────────────
    print("== 2. prism_so_move ==")

    let original = ["A", "B", "C", "D"]

    let move_02_r = prism_ui_sort.prism_so_move(original, 0, 2)
    _check_true("move(0,2) constructs", is_ok(move_02_r))
    let move_02 = unwrap(move_02_r)
    _check("move(0,2) length", str(len(move_02)), "4")
    _check("move(0,2)[0]", move_02[0], "B")
    _check("move(0,2)[1]", move_02[1], "C")
    _check("move(0,2)[2]", move_02[2], "A")
    _check("move(0,2)[3]", move_02[3], "D")

    let move_20 = unwrap(prism_ui_sort.prism_so_move(original, 2, 0))
    _check("move(2,0)[0]", move_20[0], "C")
    _check("move(2,0)[1]", move_20[1], "A")
    _check("move(2,0)[2]", move_20[2], "B")
    _check("move(2,0)[3]", move_20[3], "D")

    let move_30 = unwrap(prism_ui_sort.prism_so_move(original, 3, 0))
    _check("move(3,0)[0] (last to front)", move_30[0], "D")
    _check("move(3,0)[1]", move_30[1], "A")
    _check("move(3,0)[2]", move_30[2], "B")
    _check("move(3,0)[3]", move_30[3], "C")

    let move_03 = unwrap(prism_ui_sort.prism_so_move(original, 0, 3))
    _check("move(0,3)[0] (first to end)", move_03[0], "B")
    _check("move(0,3)[1]", move_03[1], "C")
    _check("move(0,3)[2]", move_03[2], "D")
    _check("move(0,3)[3]", move_03[3], "A")

    // Purity: `original` must be untouched by every call above.
    _check_true("move: original list unchanged [0]", original[0] == "A")
    _check_true("move: original list unchanged [1]", original[1] == "B")
    _check_true("move: original list unchanged [2]", original[2] == "C")
    _check_true("move: original list unchanged [3]", original[3] == "D")

    let move_neg_from_r = prism_ui_sort.prism_so_move(original, -1, 0)
    _check_true("move rejects so_from < 0", is_err(move_neg_from_r))
    let move_over_from_r = prism_ui_sort.prism_so_move(original, 4, 0)
    _check_true("move rejects so_from >= n", is_err(move_over_from_r))
    let move_over_to_r = prism_ui_sort.prism_so_move(original, 0, 4)
    _check_true("move rejects so_to >= n", is_err(move_over_to_r))
    let move_same_r = prism_ui_sort.prism_so_move(original, 1, 1)
    _check_true("move rejects so_from == so_to", is_err(move_same_r))
    let move_empty_r = prism_ui_sort.prism_so_move([], 0, 0)
    _check_true("move rejects an out-of-bounds call against an empty list", is_err(move_empty_r))
    print("")

    // ── 3. prism_so_ranked: exact stack(d=3,c=10), 1-based rank order, single-item, 2 rejections ──
    print("== 3. prism_so_ranked ==")

    let ranked_r = prism_ui_sort.prism_so_ranked(["Gold", "Silver", "Bronze"])
    _check_true("ranked constructs", is_ok(ranked_r))
    let ranked_node = unwrap(ranked_r)
    _check("ranked kind_str", prism_node.prism_node_kind_str(ranked_node), "stack")
    _check("ranked depth", str(prism_node.prism_node_depth(ranked_node)), "3")
    _check("ranked count", str(prism_node.prism_node_count(ranked_node)), "10")
    let ranked_rows = prism_node.prism_node_children(ranked_node)
    _check("ranked row count", str(len(ranked_rows)), "3")

    let rr0 = prism_node.prism_node_children(ranked_rows[0])
    _check("ranked row0 kind_str", prism_node.prism_node_kind_str(ranked_rows[0]), "band")
    _check("ranked row0 depth", str(prism_node.prism_node_depth(ranked_rows[0])), "2")
    _check("ranked row0 count", str(prism_node.prism_node_count(ranked_rows[0])), "3")
    _check("ranked row0 rank text", prism_node.prism_node_attr_str(rr0[0], "text", ""), "#1")
    _check("ranked row0 item text", prism_node.prism_node_attr_str(rr0[1], "text", ""), "Gold")

    let rr1 = prism_node.prism_node_children(ranked_rows[1])
    _check("ranked row1 rank text", prism_node.prism_node_attr_str(rr1[0], "text", ""), "#2")
    _check("ranked row1 item text", prism_node.prism_node_attr_str(rr1[1], "text", ""), "Silver")

    let rr2 = prism_node.prism_node_children(ranked_rows[2])
    _check("ranked row2 rank text", prism_node.prism_node_attr_str(rr2[0], "text", ""), "#3")
    _check("ranked row2 item text", prism_node.prism_node_attr_str(rr2[1], "text", ""), "Bronze")

    let ranked_one_r = prism_ui_sort.prism_so_ranked(["Only"])
    _check_true("ranked (1 item) constructs", is_ok(ranked_one_r))
    let ranked_one = unwrap(ranked_one_r)
    _check("ranked(1) depth", str(prism_node.prism_node_depth(ranked_one)), "3")
    _check("ranked(1) count", str(prism_node.prism_node_count(ranked_one)), "4")

    let ranked_empty_r = prism_ui_sort.prism_so_ranked([])
    _check_true("ranked rejects an empty so_items", is_err(ranked_empty_r))
    let ranked_bad_elem_r = prism_ui_sort.prism_so_ranked(["A", 7])
    _check_true("ranked rejects a non-string element", is_err(ranked_bad_elem_r))
    if is_err(ranked_bad_elem_r)
        _check_true("ranked non-string rejection names index 1 and type int", contains(unwrap_err(ranked_bad_elem_r), "1") and contains(unwrap_err(ranked_bad_elem_r), "int"))
    print("")

    // ── 4. prism_so_checklist: exact stack(d=3,c=13), check/minus split, all-unchecked, 4 rejects ──
    print("== 4. prism_so_checklist ==")

    let check_r = prism_ui_sort.prism_so_checklist(["Milk", "Eggs", "Bread", "Butter"], ["Eggs", "Butter"])
    _check_true("checklist constructs", is_ok(check_r))
    let check_node = unwrap(check_r)
    _check("checklist kind_str", prism_node.prism_node_kind_str(check_node), "stack")
    _check("checklist depth", str(prism_node.prism_node_depth(check_node)), "3")
    _check("checklist count", str(prism_node.prism_node_count(check_node)), "13")
    let check_rows = prism_node.prism_node_children(check_node)
    _check("checklist row count", str(len(check_rows)), "4")

    let cr0 = prism_node.prism_node_children(check_rows[0])
    _check("checklist row0 (Milk, unchecked) icon", prism_node.prism_node_attr_str(cr0[0], "icon", ""), "minus")
    _check("checklist row0 item text", prism_node.prism_node_attr_str(cr0[1], "text", ""), "Milk")

    let cr1 = prism_node.prism_node_children(check_rows[1])
    _check("checklist row1 (Eggs, checked) icon", prism_node.prism_node_attr_str(cr1[0], "icon", ""), "check")
    _check("checklist row1 item text", prism_node.prism_node_attr_str(cr1[1], "text", ""), "Eggs")

    let cr2 = prism_node.prism_node_children(check_rows[2])
    _check("checklist row2 (Bread, unchecked) icon", prism_node.prism_node_attr_str(cr2[0], "icon", ""), "minus")
    _check("checklist row2 item text", prism_node.prism_node_attr_str(cr2[1], "text", ""), "Bread")

    let cr3 = prism_node.prism_node_children(check_rows[3])
    _check("checklist row3 (Butter, checked) icon", prism_node.prism_node_attr_str(cr3[0], "icon", ""), "check")
    _check("checklist row3 item text", prism_node.prism_node_attr_str(cr3[1], "text", ""), "Butter")

    // All-unchecked boundary: an empty so_checked is valid input (not a rejection).
    let check_none_r = prism_ui_sort.prism_so_checklist(["X", "Y"], [])
    _check_true("checklist (empty so_checked) constructs", is_ok(check_none_r))
    let check_none = unwrap(check_none_r)
    _check("checklist(none checked) depth", str(prism_node.prism_node_depth(check_none)), "3")
    _check("checklist(none checked) count", str(prism_node.prism_node_count(check_none)), "7")
    let none_rows = prism_node.prism_node_children(check_none)
    let none_r0 = prism_node.prism_node_children(none_rows[0])
    _check("checklist(none checked) row0 icon", prism_node.prism_node_attr_str(none_r0[0], "icon", ""), "minus")
    let none_r1 = prism_node.prism_node_children(none_rows[1])
    _check("checklist(none checked) row1 icon", prism_node.prism_node_attr_str(none_r1[0], "icon", ""), "minus")

    let check_empty_items_r = prism_ui_sort.prism_so_checklist([], [])
    _check_true("checklist rejects an empty so_items", is_err(check_empty_items_r))
    let check_bad_item_r = prism_ui_sort.prism_so_checklist(["Good", 9], [])
    _check_true("checklist rejects a non-string so_items element", is_err(check_bad_item_r))
    if is_err(check_bad_item_r)
        _check_true("checklist so_items rejection names index 1 and type int", contains(unwrap_err(check_bad_item_r), "1") and contains(unwrap_err(check_bad_item_r), "int"))
    let check_bad_checked_r = prism_ui_sort.prism_so_checklist(["A", "B"], ["A", 3])
    _check_true("checklist rejects a non-string so_checked element", is_err(check_bad_checked_r))
    if is_err(check_bad_checked_r)
        _check_true("checklist so_checked rejection names index 1 and type int", contains(unwrap_err(check_bad_checked_r), "1") and contains(unwrap_err(check_bad_checked_r), "int"))
    let check_unknown_r = prism_ui_sort.prism_so_checklist(["A", "B"], ["Z"])
    _check_true("checklist rejects a so_checked entry not in so_items", is_err(check_unknown_r))
    if is_err(check_unknown_r)
        _check_true("checklist unknown-checked rejection names the value 'Z'", contains(unwrap_err(check_unknown_r), "Z"))
    print("")

    // ── 5. Rejection tally: 14 distinct rejections proven above, counted explicitly ───────────────
    // sortable: empty, non-string, duplicate key (3); move: from<0, from>=n, to>=n, from==to,
    // empty-list bounds (5); ranked: empty, non-string (2); checklist: empty items, non-string
    // item, non-string checked, unknown checked (4). Total = 3+5+2+4 = 14.
    let rejection_count = 14
    _check_true("expected at least 10 rejection cases, counted " + str(rejection_count), rejection_count >= 10)

    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_sort: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_sort: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
