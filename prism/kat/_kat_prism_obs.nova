// KAT for prism/obs/prism_obs.nova (milestone MB.10).
//
// Six parts:
//   1. Stats on a hand-built 6-node tree match numbers computed BY HAND (nodes, depth, per-kind,
//      attr count, text bytes) -- not "some plausible number", the exact figure worked out from the
//      widget constructors' own known attribute shapes.
//   2. All 22 kinds are present in the stats dict, zeros included, and their sum equals the tree's
//      own total node count (a cross-check that no kind was double-counted or skipped).
//   3. Budget: the exact-boundary case (budget == actual) is clean; tightening either bound by one
//      produces exactly the expected violation; >= 8 distinct calls are rejected, spanning
//      non-positive bounds AND bounds above PRISM_SPEC.md §16's own hard ceiling; a budget set
//      EXACTLY AT the ceiling is accepted (not rejected -- the ceiling itself is legal).
//   4. ★ Diff: the headline case -- ONE row inserted at the top of a keyed `each` list produces
//      EXACTLY ONE `added` change, never N -- proven first and called out because it is the entire
//      reason PRISM_SPEC.md §12.6's keyed identity model exists. Every other change kind (removed,
//      reordered, kind-changed, attr-changed, text-changed, and a POSITIONAL add for contrast with
//      the keyed case) is proven the same way: exactly the expected count, exactly the expected
//      kind. Determinism is proven by running the same diff twice and comparing the rendered text
//      byte-for-byte. A tree diffed against a freshly-rebuilt, content-identical twin is empty.
//   5. Report / report_text build without error and contain the numbers stats itself reports.
//   6. ★ The real MB.6 docs page (`prism_app_docs.prism_docs_tree()`) is measured for real -- the
//      actual stats are PRINTED, not just bound-checked, so this KAT also serves as the source of
//      truth the next status update quotes instead of a number typed in by hand.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into $NOVA_HOME/lib.
//   ./gen3_test.exe _kat_prism_obs.nova
//   clang -O2 -o _kat_prism_obs.exe _kat_prism_obs.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_obs.exe

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_structure
import prism_obs
import prism_app_docs as docs

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    print("== 1. stats on a hand-built tree match hand-computed numbers ==")
    // stack( label("Hello"), band( press("Save", []), link("Docs", route "/docs") ), gap(4) )
    //   label: attrs {text:"Hello"}                     1 attr, 5 text bytes, depth 1
    //   press: attrs {text:"Save"}                       1 attr, 4 text bytes, depth 1
    //   link:  attrs {text:"Docs", href:"/docs", kind:"route"}   3 attrs, 4+5+5=14 text bytes, depth 1
    //   band:  attrs {}                                  0 attrs, depth max(1,1)+1 = 2
    //   gap:   attrs {flexible:false, size:4}             2 attrs, 0 text bytes (not strings), depth 1
    //   stack: attrs {}                                   0 attrs, depth max(1,2,1)+1 = 3
    // totals: nodes = 6 (stack, label, band, press, link, gap)
    //         attr_count = 0+1+0+1+3+2 = 7
    //         text_bytes = 5+4+14+0 = 23
    let lbl = unwrap(prism_content.prism_label("Hello"))
    let btn = unwrap(prism_interact.prism_press("Save", []))
    let lnk = unwrap(prism_interact.prism_link("Docs", prism_interact.prism_link_target_route("/docs")))
    let bandn = unwrap(prism_arrange.prism_band([btn, lnk]))
    let gapn = unwrap(prism_arrange.prism_gap(some(4)))
    let tree = unwrap(prism_arrange.prism_stack([lbl, bandn, gapn]))
    let stats = unwrap(prism_obs.prism_obs_stats(tree))
    _check("total_nodes", str(prism_obs.prism_obs_stats_total_nodes(stats)), "6")
    _check("max_depth", str(prism_obs.prism_obs_stats_max_depth(stats)), "3")
    _check("attr_count", str(prism_obs.prism_obs_stats_attr_count(stats)), "7")
    _check("text_bytes", str(prism_obs.prism_obs_stats_text_bytes(stats)), "23")
    _check("kind count: stack", str(prism_obs.prism_obs_stats_kind_count(stats, "stack")), "1")
    _check("kind count: band", str(prism_obs.prism_obs_stats_kind_count(stats, "band")), "1")
    _check("kind count: label", str(prism_obs.prism_obs_stats_kind_count(stats, "label")), "1")
    _check("kind count: press", str(prism_obs.prism_obs_stats_kind_count(stats, "press")), "1")
    _check("kind count: link", str(prism_obs.prism_obs_stats_kind_count(stats, "link")), "1")
    _check("kind count: gap", str(prism_obs.prism_obs_stats_kind_count(stats, "gap")), "1")
    _check("kind count: mesh (absent, must be zero not missing)", str(prism_obs.prism_obs_stats_kind_count(stats, "mesh")), "0")
    _check("kind count: tabs (absent, must be zero not missing)", str(prism_obs.prism_obs_stats_kind_count(stats, "tabs")), "0")
    _check("kind count: grid (absent, must be zero not missing)", str(prism_obs.prism_obs_stats_kind_count(stats, "grid")), "0")
    _check("kind count: entry (absent, must be zero not missing)", str(prism_obs.prism_obs_stats_kind_count(stats, "entry")), "0")

    print("== 2. all 22 kinds present (zeros included), sum == total_nodes ==")
    let kc = prism_obs.prism_obs_stats_kind_counts(stats)
    _check("kind_counts dict has exactly 22 entries", str(len(kc.keys())), "22")
    let ksum = 0
    for k in prism_node.prism_node_kind_all()
        ksum = ksum + prism_obs.prism_obs_stats_kind_count(stats, prism_node.prism_node_kind_name(k))
    _check("sum of all 22 kind counts == total_nodes", str(ksum), "6")

    print("== 3. budget: exact boundary, tightened bounds, and rejection ==")
    let budget_exact = unwrap(prism_obs.prism_obs_budget(6, 3))
    _check("exact-boundary budget: 0 violations", str(len(unwrap(prism_obs.prism_obs_check(stats, budget_exact)))), "0")

    let budget_tight_nodes = unwrap(prism_obs.prism_obs_budget(5, 3))
    let viol_nodes = unwrap(prism_obs.prism_obs_check(stats, budget_tight_nodes))
    _check("max_nodes=5 (< actual 6): 1 violation", str(len(viol_nodes)), "1")
    _check_true("that violation is node_count", len(viol_nodes) > 0 and prism_obs.prism_obs_violation_kind_name(prism_obs.prism_obs_violation_kind(viol_nodes[0])) == "node_count")

    let budget_tight_depth = unwrap(prism_obs.prism_obs_budget(6, 2))
    let viol_depth = unwrap(prism_obs.prism_obs_check(stats, budget_tight_depth))
    _check("max_depth=2 (< actual 3): 1 violation", str(len(viol_depth)), "1")
    _check_true("that violation is depth", len(viol_depth) > 0 and prism_obs.prism_obs_violation_kind_name(prism_obs.prism_obs_violation_kind(viol_depth[0])) == "depth")

    let budget_both_tight = unwrap(prism_obs.prism_obs_budget(5, 2))
    _check("both bounds tight: 2 violations", str(len(unwrap(prism_obs.prism_obs_check(stats, budget_both_tight)))), "2")

    // >= 8 rejection cases: non-positive bounds and bounds above the §16 hard ceiling.
    _check_true("reject max_nodes=0", is_err(prism_obs.prism_obs_budget(0, 10)))
    _check_true("reject max_nodes=-5", is_err(prism_obs.prism_obs_budget(-5, 10)))
    _check_true("reject max_depth=0", is_err(prism_obs.prism_obs_budget(10, 0)))
    _check_true("reject max_depth=-3", is_err(prism_obs.prism_obs_budget(10, -3)))
    _check_true("reject max_nodes=100001 (one above the §16 ceiling)", is_err(prism_obs.prism_obs_budget(100001, 10)))
    _check_true("reject max_nodes=1000000 (far above the §16 ceiling)", is_err(prism_obs.prism_obs_budget(1000000, 10)))
    _check_true("reject max_depth=257 (one above the §16 ceiling)", is_err(prism_obs.prism_obs_budget(10, 257)))
    _check_true("reject max_depth=1000 (far above the §16 ceiling)", is_err(prism_obs.prism_obs_budget(10, 1000)))
    // A budget set EXACTLY at the ceiling is legal -- it is §16's own default.
    _check_true("accept max_nodes AT the ceiling (100000)", not is_err(prism_obs.prism_obs_budget(100000, 10)))
    _check_true("accept max_depth AT the ceiling (256)", not is_err(prism_obs.prism_obs_budget(10, 256)))

    print("== 4. ★ diff: keyed identity, every change kind, determinism ==")
    let ek = fn(x) x
    let er = fn(x) prism_content.prism_label(x)

    // ★★★ THE HEADLINE CASE: one row inserted at the TOP of a 3-row keyed list. A positional diff
    // would report the entire list changed (every row shifts index); the keyed diff must report
    // EXACTLY ONE change: the new row added. Nothing about rows a/b/c may appear at all.
    let before_ins = unwrap(prism_structure.prism_each(["a", "b", "c"], ek, er))
    let after_ins = unwrap(prism_structure.prism_each(["z", "a", "b", "c"], ek, er))
    let d_ins = unwrap(prism_obs.prism_obs_diff(before_ins, after_ins))
    _check("★ HEADLINE: one inserted keyed row -> exactly ONE change", str(len(d_ins)), "1")
    _check_true("★ HEADLINE: that one change is 'added'", len(d_ins) > 0 and prism_obs.prism_obs_change_kind_name(prism_obs.prism_obs_change_kind(d_ins[0])) == "added")
    _check_true("★ HEADLINE: the change names the new row's key", len(d_ins) > 0 and contains(prism_obs.prism_obs_change_path(d_ins[0]), "z"))

    // Removed, from the middle -- the other two rows must not appear as changed.
    let before_rm = unwrap(prism_structure.prism_each(["a", "b", "c"], ek, er))
    let after_rm = unwrap(prism_structure.prism_each(["a", "c"], ek, er))
    let d_rm = unwrap(prism_obs.prism_obs_diff(before_rm, after_rm))
    _check("keyed removal (middle row) -> exactly ONE change", str(len(d_rm)), "1")
    _check_true("removal change kind is 'removed'", len(d_rm) > 0 and prism_obs.prism_obs_change_kind_name(prism_obs.prism_obs_change_kind(d_rm[0])) == "removed")

    // Reordered -- same 3 keys, rotated. No add/remove, no per-row diff (content identical): ONE
    // reordered change for the whole list, not three.
    let before_ro = unwrap(prism_structure.prism_each(["a", "b", "c"], ek, er))
    let after_ro = unwrap(prism_structure.prism_each(["c", "a", "b"], ek, er))
    let d_ro = unwrap(prism_obs.prism_obs_diff(before_ro, after_ro))
    _check("same keys rotated -> exactly ONE 'reordered' change", str(len(d_ro)), "1")
    _check_true("reorder change kind is 'reordered'", len(d_ro) > 0 and prism_obs.prism_obs_change_kind_name(prism_obs.prism_obs_change_kind(d_ro[0])) == "reordered")

    // Kind-changed -- same root, different primitive kind.
    let before_kc = unwrap(prism_content.prism_label("Hello"))
    let after_kc = unwrap(prism_interact.prism_press("Hello", []))
    let d_kc = unwrap(prism_obs.prism_obs_diff(before_kc, after_kc))
    _check("label -> press -> exactly ONE 'kind_changed' change", str(len(d_kc)), "1")
    _check_true("kind-changed change kind is 'kind_changed'", len(d_kc) > 0 and prism_obs.prism_obs_change_kind_name(prism_obs.prism_obs_change_kind(d_kc[0])) == "kind_changed")

    // Attr-changed -- gap's `size`, which is NOT that kind's designated text attribute.
    let before_ac = unwrap(prism_arrange.prism_gap(some(4)))
    let after_ac = unwrap(prism_arrange.prism_gap(some(8)))
    let d_ac = unwrap(prism_obs.prism_obs_diff(before_ac, after_ac))
    _check("gap size 4 -> 8 -> exactly ONE 'attr_changed' change", str(len(d_ac)), "1")
    _check_true("attr-changed change kind is 'attr_changed'", len(d_ac) > 0 and prism_obs.prism_obs_change_kind_name(prism_obs.prism_obs_change_kind(d_ac[0])) == "attr_changed")

    // Text-changed -- label's `text`, which IS that kind's designated text attribute.
    let before_tc = unwrap(prism_content.prism_label("Hello"))
    let after_tc = unwrap(prism_content.prism_label("Hi"))
    let d_tc = unwrap(prism_obs.prism_obs_diff(before_tc, after_tc))
    _check("label text 'Hello' -> 'Hi' -> exactly ONE 'text_changed' change", str(len(d_tc)), "1")
    _check_true("text-changed change kind is 'text_changed'", len(d_tc) > 0 and prism_obs.prism_obs_change_kind_name(prism_obs.prism_obs_change_kind(d_tc[0])) == "text_changed")

    // Positional add -- for contrast with the keyed case: an UNKEYED list reports a trailing add.
    let before_pos = unwrap(prism_arrange.prism_stack([unwrap(prism_content.prism_label("A"))]))
    let after_pos = unwrap(prism_arrange.prism_stack([unwrap(prism_content.prism_label("A")), unwrap(prism_content.prism_label("B"))]))
    let d_pos = unwrap(prism_obs.prism_obs_diff(before_pos, after_pos))
    _check("positional (unkeyed) append -> exactly ONE 'added' change", str(len(d_pos)), "1")
    _check_true("positional add change kind is 'added'", len(d_pos) > 0 and prism_obs.prism_obs_change_kind_name(prism_obs.prism_obs_change_kind(d_pos[0])) == "added")

    // Determinism (§15.9): the SAME diff computed twice renders to byte-identical text.
    let d_ins_again = unwrap(prism_obs.prism_obs_diff(before_ins, after_ins))
    _check("determinism: repeated diff renders byte-identical", prism_obs.prism_obs_diff_text(d_ins_again), prism_obs.prism_obs_diff_text(d_ins))

    // A tree diffed against a freshly-rebuilt, content-identical (but distinct) twin is empty.
    let twin_a = unwrap(prism_arrange.prism_stack([unwrap(prism_content.prism_label("Hello")), unwrap(prism_arrange.prism_band([unwrap(prism_interact.prism_press("Save", []))]))]))
    let twin_b = unwrap(prism_arrange.prism_stack([unwrap(prism_content.prism_label("Hello")), unwrap(prism_arrange.prism_band([unwrap(prism_interact.prism_press("Save", []))]))]))
    let d_self = unwrap(prism_obs.prism_obs_diff(twin_a, twin_b))
    _check("content-identical twin diffs to empty", str(len(d_self)), "0")

    print("== 5. report / report_text build and agree with stats ==")
    let rpt = prism_obs.prism_obs_report(stats)
    _check_true("prism_obs_report builds without error", not is_err(rpt))
    _check_true("report root is a real PrismNode", type_name(unwrap(rpt)) == "PrismNode")
    let txt = prism_obs.prism_obs_report_text(stats)
    _check_true("report_text mentions total_nodes=6", contains(txt, "total_nodes=6"))
    _check_true("report_text mentions max_depth=3", contains(txt, "max_depth=3"))
    _check_true("report_text mentions label=1", contains(txt, "label=1"))
    _check_true("report_text mentions a zero kind (mesh=0)", contains(txt, "mesh=0"))

    print("== 6. ★ the real MB.6 docs page, measured ==")
    let docs_tree_r = docs.prism_docs_tree()
    if is_err(docs_tree_r)
        print("  FAIL  docs page did not build: " + unwrap_err(docs_tree_r))
        FAILED[0] = FAILED[0] + 1
    else
        let docs_tree = unwrap(docs_tree_r)
        let docs_stats_r = prism_obs.prism_obs_stats(docs_tree)
        if is_err(docs_stats_r)
            print("  FAIL  docs page stats failed: " + unwrap_err(docs_stats_r))
            FAILED[0] = FAILED[0] + 1
        else
            let docs_stats = unwrap(docs_stats_r)
            print("  -- MB.6 docs page (prism_app_docs.prism_docs_tree()) measured stats --")
            print(prism_obs.prism_obs_report_text(docs_stats))
            _check_true("docs page total_nodes within PRISM_MAX_NODE_COUNT (100000)", prism_obs.prism_obs_stats_total_nodes(docs_stats) < 100000)
            _check_true("docs page max_depth within PRISM_MAX_TREE_DEPTH (256)", prism_obs.prism_obs_stats_max_depth(docs_stats) < 256)
            let docs_budget = unwrap(prism_obs.prism_obs_budget(100000, 256))
            _check("docs page within a budget set at the §16 ceiling: 0 violations", str(len(unwrap(prism_obs.prism_obs_check(docs_stats, docs_budget)))), "0")
            // The docs page audits are never re-run identically twice in a row inside THIS KAT
            // (that is _kat_prism_a11y.nova's job), but stats over the SAME already-built tree must
            // be idempotent -- proves prism_obs_stats has no hidden mutation of the tree it reads.
            let docs_stats_2 = unwrap(prism_obs.prism_obs_stats(docs_tree))
            _check("docs page stats are idempotent (no mutation of the tree read twice)", str(prism_obs.prism_obs_stats_total_nodes(docs_stats_2)), str(prism_obs.prism_obs_stats_total_nodes(docs_stats)))

    if FAILED[0] == 0
        print("")
        print("_kat_prism_obs: ALL PASS")
    else
        print("")
        print("_kat_prism_obs: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
