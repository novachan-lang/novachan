// KAT for prism/app/prism_app_dashboard.nova (milestone MB.6): a real admin-dashboard screen
// assembled ONLY from prism/ui/'s existing components. Proves: the page builds with an exact
// depth/count within prism_node's resource bounds; it renders through BOTH backends without
// error; two renders are byte-identical (deterministic); a <script> in user-supplied text renders
// escaped in the HTML; several distinct invalid states are rejected (never a broken page); the
// genuinely-reachable empty state (recent activity, when there is none); and the dropdown's
// open/closed content discipline survives composition. Also asserts the ANSI render is
// non-trivial and contains no HTML tags.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME = the nova-compiler/ root, NOVA_NO_CACHE=1):
//   ./gen3_test.exe _kat_prism_app_dashboard.nova
//   clang -O2 -o _kat_prism_app_dashboard.exe _kat_prism_app_dashboard.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_app_dashboard.exe

import prism_node
import prism_ui_data
import prism_ui_chart
import prism_ui_nav
import prism_render_html
import prism_render_ansi
import prism_app_dashboard

fn _kat_fail(msg: string)
    print("FAIL " + msg)
    exit(1)

// ── Shared, realistic demo data (reused across variants; each variant changes ONE field) ────────
fn _base_crumbs()
    [prism_ui_nav.prism_breadcrumb_item("Home", "/"), prism_ui_nav.prism_breadcrumb_item("Overview", "/overview")]

fn _base_stats()
    [prism_app_dashboard.prism_app_stat("Revenue", "$128,430", some("+12% vs last month"), prism_ui_data.prism_stat_trend_up()), prism_app_dashboard.prism_app_stat("Active users", "4,209", some("+3%"), prism_ui_data.prism_stat_trend_up()), prism_app_dashboard.prism_app_stat("Churn", "1.8%", some("-0.4%"), prism_ui_data.prism_stat_trend_down()), prism_app_dashboard.prism_app_stat("Open tickets", "37", none(), prism_ui_data.prism_stat_trend_flat())]

fn _base_series()
    [prism_ui_chart.prism_ch_item("North", 420), prism_ui_chart.prism_ch_item("South", 310), prism_ui_chart.prism_ch_item("East", 260), prism_ui_chart.prism_ch_item("West", 180)]

fn _base_rows()
    [{"id": "u1", "name": "Alice Kim", "email": "alice@example.com", "role": "Admin", "status": "Active"}, {"id": "u2", "name": "Bob Chen", "email": "bob@example.com", "role": "Editor", "status": "Active"}, {"id": "u3", "name": "Carla Diaz", "email": "carla@example.com", "role": "Viewer", "status": "Invited"}, {"id": "u4", "name": "Dev Patel", "email": "dev@example.com", "role": "Editor", "status": "Active"}, {"id": "u5", "name": "Elin Osei", "email": "elin@example.com", "role": "Viewer", "status": "Suspended"}, {"id": "u6", "name": "Farid Novak", "email": "farid@example.com", "role": "Admin", "status": "Active"}]

fn _base_activity()
    [prism_ui_data.prism_ui_timeline_event("Invoice #4821 paid", prism_ui_data.prism_timeline_status_done()), prism_ui_data.prism_ui_timeline_event("Nightly backup running", prism_ui_data.prism_timeline_status_active()), prism_ui_data.prism_ui_timeline_event("Scheduled maintenance", prism_ui_data.prism_timeline_status_pending())]

fn _good_state()
    prism_app_dashboard.prism_app_state("Priya Shah", "/", _base_crumbs(), _base_stats(), _base_series(), _base_rows(), "name", "ascending", "Jordan Lee", "jordan@example.com", "editor", 3, true, _base_activity(), "2 invoices are overdue.", false)

fn main()
    // ── 1. The good state builds ────────────────────────────────────────────────────────────
    let node_r = prism_app_dashboard.prism_app_dashboard(_good_state())
    if is_err(node_r)
        _kat_fail("good state should build, got: " + unwrap_err(node_r))
    let node = unwrap(node_r)
    let depth = prism_node.prism_node_depth(node)
    let count = prism_node.prism_node_count(node)
    // Exact, not a range -- observed once, then pinned (house convention: a drift here means
    // something in ui/ or this composition genuinely changed shape, and should be re-verified,
    // not silently absorbed by a loose bound).
    assert_eq(depth, 11)
    assert_eq(count, 210)
    print("1. good state builds a PrismNode: exact depth=11, count=210: OK")

    // ── 2. Resource bounds (PRISM_SPEC.md Sec16: depth < 256, count < 100000) ───────────────
    if depth >= 256
        _kat_fail("depth " + str(depth) + " must be < 256")
    if count >= 100000
        _kat_fail("count " + str(count) + " must be < 100000")
    print("2. within prism_node's resource bounds (depth < 256, count < 100000): OK")

    // ── 3. Renders through BOTH backends without error ──────────────────────────────────────
    let html_r = prism_app_dashboard.prism_app_dashboard_html(_good_state())
    if is_err(html_r)
        _kat_fail("html render should succeed, got: " + unwrap_err(html_r))
    let html = unwrap(html_r)
    let ansi_r = prism_app_dashboard.prism_app_dashboard_ansi(_good_state())
    if is_err(ansi_r)
        _kat_fail("ansi render should succeed, got: " + unwrap_err(ansi_r))
    let ansi = unwrap(ansi_r)
    print("HTML_LEN=" + str(len(html)))
    print("ANSI_LEN=" + str(len(ansi)))
    print("3. renders through both HTML and ANSI backends without error: OK")

    // ── 4. Deterministic: two renders are byte-identical ────────────────────────────────────
    let html2 = unwrap(prism_app_dashboard.prism_app_dashboard_html(_good_state()))
    let ansi2 = unwrap(prism_app_dashboard.prism_app_dashboard_ansi(_good_state()))
    if html != html2
        _kat_fail("two HTML renders of the same state should be byte-identical")
    if ansi != ansi2
        _kat_fail("two ANSI renders of the same state should be byte-identical")
    print("4. deterministic: two renders of both backends are byte-identical: OK")

    // ── 5. <script> in user-supplied text renders escaped, never raw ────────────────────────
    let evil_state = prism_app_dashboard.prism_app_state("<script>alert(1)</script>", "/", _base_crumbs(), _base_stats(), _base_series(), _base_rows(), "name", "ascending", "Jordan Lee", "jordan@example.com", "editor", 3, true, _base_activity(), "", false)
    let evil_html = unwrap(prism_app_dashboard.prism_app_dashboard_html(evil_state))
    if find(evil_html, "<script>alert(1)</script>") >= 0
        _kat_fail("a <script> in user-supplied text must never reach the HTML output raw")
    if find(evil_html, "&lt;script&gt;alert(1)&lt;/script&gt;") < 0
        _kat_fail("a <script> in user-supplied text must render as escaped text")
    print("5. <script> in state's user-supplied text renders escaped, never raw: OK")

    // ── 6. Invalid states are rejected, never a broken page ─────────────────────────────────
    let bad_sort_dir = prism_app_dashboard.prism_app_state("Priya Shah", "/", _base_crumbs(), _base_stats(), _base_series(), _base_rows(), "name", "sideways", "Jordan Lee", "jordan@example.com", "editor", 3, true, _base_activity(), "", false)
    let r1 = prism_app_dashboard.prism_app_dashboard(bad_sort_dir)
    if is_ok(r1)
        _kat_fail("an unrecognized table_sort_dir ('sideways') should be rejected")
    print("6a. invalid sort_dir string rejected: OK -- " + unwrap_err(r1))

    let bad_route = prism_app_dashboard.prism_app_state("Priya Shah", "/does-not-exist", _base_crumbs(), _base_stats(), _base_series(), _base_rows(), "name", "ascending", "Jordan Lee", "jordan@example.com", "editor", 3, true, _base_activity(), "", false)
    let r2 = prism_app_dashboard.prism_app_dashboard(bad_route)
    if is_ok(r2)
        _kat_fail("an active_route naming no sidebar entry should be rejected")
    print("6b. active_route matching no sidebar entry rejected: OK -- " + unwrap_err(r2))

    let bad_role = prism_app_dashboard.prism_app_state("Priya Shah", "/", _base_crumbs(), _base_stats(), _base_series(), _base_rows(), "name", "ascending", "Jordan Lee", "jordan@example.com", "ceo", 3, true, _base_activity(), "", false)
    let r3 = prism_app_dashboard.prism_app_dashboard(bad_role)
    if is_ok(r3)
        _kat_fail("a form role naming no real option ('ceo') should be rejected")
    print("6c. invalid form role value rejected: OK -- " + unwrap_err(r3))

    let dup_rows = [{"id": "dup", "name": "A", "email": "a@x.com", "role": "Admin", "status": "Active"}, {"id": "dup", "name": "B", "email": "b@x.com", "role": "Editor", "status": "Active"}]
    let bad_dup = prism_app_dashboard.prism_app_state("Priya Shah", "/", _base_crumbs(), _base_stats(), _base_series(), dup_rows, "", "none", "Jordan Lee", "jordan@example.com", "editor", 3, true, _base_activity(), "", false)
    let r4 = prism_app_dashboard.prism_app_dashboard(bad_dup)
    if is_ok(r4)
        _kat_fail("a duplicate table row id should be rejected")
    print("6d. duplicate table row identity rejected: OK -- " + unwrap_err(r4))

    let blank_state = prism_app_dashboard.prism_app_state("", "/", _base_crumbs(), _base_stats(), _base_series(), _base_rows(), "name", "ascending", "Jordan Lee", "jordan@example.com", "editor", 3, true, _base_activity(), "", false)
    let r5 = prism_app_dashboard.prism_app_dashboard(blank_state)
    if is_ok(r5)
        _kat_fail("a blank user_name should be rejected")
    print("6e. blank user_name rejected: OK -- " + unwrap_err(r5))

    // ── 7. The empty state is genuinely reachable (recent activity, on a VALID state) ───────
    let empty_activity_state = prism_app_dashboard.prism_app_state("Priya Shah", "/", _base_crumbs(), _base_stats(), _base_series(), _base_rows(), "name", "ascending", "Jordan Lee", "jordan@example.com", "editor", 3, true, [], "", false)
    let empty_html = unwrap(prism_app_dashboard.prism_app_dashboard_html(empty_activity_state))
    if find(empty_html, "No recent activity yet") < 0
        _kat_fail("an empty activity list should render the honest empty state")
    if find(empty_html, "Nightly backup running") >= 0
        _kat_fail("an empty activity list should not still show timeline events")
    if find(html, "No recent activity yet") >= 0
        _kat_fail("a non-empty activity list should NOT show the empty state")
    if find(html, "Nightly backup running") < 0
        _kat_fail("a non-empty activity list should render its timeline events")
    print("7. empty-activity state is genuinely reachable (valid input, not an error path): OK")

    // ── 8. Dropdown open/closed content discipline survives composition ────────────────────
    let open_state = prism_app_dashboard.prism_app_state("Priya Shah", "/", _base_crumbs(), _base_stats(), _base_series(), _base_rows(), "name", "ascending", "Jordan Lee", "jordan@example.com", "editor", 3, true, _base_activity(), "", true)
    let open_html = unwrap(prism_app_dashboard.prism_app_dashboard_html(open_state))
    if find(open_html, "Sign out") < 0
        _kat_fail("an open user menu should show its items")
    if find(html, "Sign out") >= 0
        _kat_fail("a closed user menu should never build its items into the tree")
    print("8. dropdown open/closed discipline (items absent by construction when closed) survives composition: OK")

    // ── 9. ANSI render is non-trivial and contains no HTML tags ────────────────────────────
    if len(ansi) < 200
        _kat_fail("ansi render should be substantial, got only " + str(len(ansi)) + " bytes")
    if find(ansi, "<div") >= 0 or find(ansi, "<button") >= 0 or find(ansi, "<table") >= 0 or find(ansi, "<span") >= 0 or find(ansi, "<html") >= 0 or find(ansi, "<script") >= 0 or find(ansi, "<input") >= 0 or find(ansi, "<select") >= 0
        _kat_fail("ansi render must contain no HTML tags")
    print("9. ANSI render is non-trivial (" + str(len(ansi)) + " bytes) and contains no HTML tags: OK")

    print("")
    print("KAT prism_app_dashboard PASSED: builds, exact depth/count within bounds, both backends render, deterministic, script-escaping, 5 distinct invalid-state rejections, genuinely-reachable empty state, dropdown discipline, ANSI is substantial and tag-free")
