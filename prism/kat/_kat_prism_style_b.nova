// KAT for prism/style/prism_look.nova (milestone MA.4 part B).
//
// Proves, against concrete expected values:
//   1. PRISM_SPEC.md §11's own `look card` example builds property-for-property.
//   2. All 7 property groups (Space/Size/Paint/Text/Position/Behaviour/Motion) round-trip.
//   3. Merge is LATER-WINS, is ASSOCIATIVE, and MUTATES NEITHER INPUT.
//      The no-mutation property is the one that matters most: a base look is shared by every
//      widget using it, so a mutating merge would let one caller's `.tight` silently restyle
//      every other user of `card` -- exactly the action-at-a-distance a cascade-free design
//      exists to prevent.
//   4. Property ORDER after merge is a pure function of the inputs (spec §15.9 -- what makes
//      MA.5's byte-identical output possible without sorting).
//   5. prism_look_resolve flattens palette slot refs, and a MISSING slot is a typed error, never
//      a silently-dropped property (the CSS failure mode §11 exists to eliminate).
//   6. State variants (`when hover -> lift 4`) round-trip and layer later-wins.
//   7. 12 rejection cases -- every validated range, plus a value handed to the wrong property.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME = the nova-compiler/ root, NOVA_NO_CACHE=1):
//   ./gen3_test.exe _kat_prism_style_b.nova
//   clang -O2 -o _kat_prism_style_b.exe _kat_prism_style_b.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_style_b.exe        (always under Invoke-Timed -TimeoutMs, kill-on-timeout)

import prism_look

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn _check_rejected(label: string, r)
    if is_err(r)
        print("  pass  reject: " + label)
    else
        print("  FAIL  reject: " + label + " -- was ACCEPTED")
        FAILED[0] = FAILED[0] + 1

// Deterministic serialization: captures BOTH the values and their order, so one comparison
// proves value-equality and order-equality together.
fn ser(look) -> string
    let out = ""
    let props = prism_look.prism_look_props(look)
    for k in props
        out = out + k + "=" + prism_look.prism_value_str(props[k]) + ";"
    out

fn main()
    print("== 1. PRISM_SPEC §11's `look card`, property for property ==")
    // look card
    //     inset 16 / round 8 / fill palette.ground / edge palette.edge / lift 2
    //     when hover -> lift 4
    let card0 = prism_look.prism_look_new()
    let card1 = unwrap(prism_look.prism_inset(card0, unwrap(prism_look.prism_len(16))))
    let card2 = unwrap(prism_look.prism_round(card1, unwrap(prism_look.prism_len(8))))
    let card3 = unwrap(prism_look.prism_fill(card2, unwrap(prism_look.prism_paint_slot("ground"))))
    let card4 = unwrap(prism_look.prism_edge(card3, unwrap(prism_look.prism_paint_slot("edge"))))
    let card = unwrap(prism_look.prism_lift(card4, unwrap(prism_look.prism_elev(2))))
    _check("inset", prism_look.prism_look_value_str(card, "inset"), "16")
    _check("round", prism_look.prism_look_value_str(card, "round"), "8")
    _check("fill", prism_look.prism_look_value_str(card, "fill"), "palette.ground")
    _check("edge", prism_look.prism_look_value_str(card, "edge"), "palette.edge")
    _check("lift", prism_look.prism_look_value_str(card, "lift"), "elev:2")
    _check("property count", str(prism_look.prism_look_prop_count(card)), "5")
    _check_true("has(inset)", prism_look.prism_look_has(card, "inset"))
    _check_true("not has(fade)", not prism_look.prism_look_has(card, "fade"))
    _check("absent property renders empty", prism_look.prism_look_value_str(card, "fade"), "")

    print("== 2. all 7 property groups round-trip ==")
    let g0 = prism_look.prism_look_new()
    let g1 = unwrap(prism_look.prism_space(g0, unwrap(prism_look.prism_len(4))))
    let g2 = unwrap(prism_look.prism_wide(g1, unwrap(prism_look.prism_frac(50))))
    let g3 = unwrap(prism_look.prism_fade(g2, unwrap(prism_look.prism_frac(80))))
    let g4 = unwrap(prism_look.prism_weight_of(g3, prism_look.prism_weight_bold()))
    let g5 = unwrap(prism_look.prism_align_of(g4, prism_look.prism_align_center()))
    let g6 = unwrap(prism_look.prism_cursor_of(g5, prism_look.prism_cursor_hand()))
    let g7 = unwrap(prism_look.prism_over(g6, unwrap(prism_look.prism_dur_ms(150))))
    _check("Space: space", prism_look.prism_look_value_str(g7, "space"), "4")
    _check("Size: wide (fraction)", prism_look.prism_look_value_str(g7, "wide"), "50%")
    _check("Paint: fade", prism_look.prism_look_value_str(g7, "fade"), "80%")
    _check("Text: weight", prism_look.prism_look_value_str(g7, "weight"), "bold")
    _check("Position: align", prism_look.prism_look_value_str(g7, "align"), "center")
    _check("Behaviour: cursor", prism_look.prism_look_value_str(g7, "cursor"), "hand")
    _check("Motion: over", prism_look.prism_look_value_str(g7, "over"), "150ms")
    // Size also accepts `fit`, which is neither a length nor a fraction.
    let gfit = unwrap(prism_look.prism_tall(g7, prism_look.prism_fit()))
    _check("Size: tall = fit", prism_look.prism_look_value_str(gfit, "tall"), "fit")

    print("== 3. merge: later wins, no mutation, associative ==")
    let base0 = prism_look.prism_look_new()
    let base1 = unwrap(prism_look.prism_inset(base0, unwrap(prism_look.prism_len(16))))
    let base = unwrap(prism_look.prism_round(base1, unwrap(prism_look.prism_len(8))))
    let tight0 = prism_look.prism_look_new()
    let tight = unwrap(prism_look.prism_inset(tight0, unwrap(prism_look.prism_len(4))))
    let merged = unwrap(prism_look.prism_look_merge(base, tight))
    _check("later wins on conflict (inset)", prism_look.prism_look_value_str(merged, "inset"), "4")
    _check("non-conflicting kept (round)", prism_look.prism_look_value_str(merged, "round"), "8")
    // NO MUTATION -- both inputs must be exactly as they were.
    _check("base NOT mutated", prism_look.prism_look_value_str(base, "inset"), "16")
    _check("base prop count unchanged", str(prism_look.prism_look_prop_count(base)), "2")
    _check("tight NOT mutated", prism_look.prism_look_value_str(tight, "inset"), "4")
    _check("tight prop count unchanged", str(prism_look.prism_look_prop_count(tight)), "1")
    // Order is a pure function of the inputs: a's keys first, a conflicting key keeps a's position.
    _check("merge order deterministic", ser(merged), "inset=4;round=8;")

    // Associativity, with a deliberate 3-way conflict on `inset`.
    let ca = unwrap(prism_look.prism_inset(prism_look.prism_look_new(), unwrap(prism_look.prism_len(1))))
    let cb0 = unwrap(prism_look.prism_inset(prism_look.prism_look_new(), unwrap(prism_look.prism_len(2))))
    let cb = unwrap(prism_look.prism_outset(cb0, unwrap(prism_look.prism_len(9))))
    let cc = unwrap(prism_look.prism_inset(prism_look.prism_look_new(), unwrap(prism_look.prism_len(3))))
    let left = unwrap(prism_look.prism_look_merge(unwrap(prism_look.prism_look_merge(ca, cb)), cc))
    let right = unwrap(prism_look.prism_look_merge(ca, unwrap(prism_look.prism_look_merge(cb, cc))))
    _check("associative: (a+b)+c == a+(b+c)", ser(left), ser(right))
    _check("associative result value", prism_look.prism_look_value_str(left, "inset"), "3")
    _check("associative keeps b's outset", prism_look.prism_look_value_str(left, "outset"), "9")

    print("== 4. state variants (§11 `when hover -> lift 4`) ==")
    let hov = unwrap(prism_look.prism_lift(prism_look.prism_look_new(), unwrap(prism_look.prism_elev(4))))
    let carded = unwrap(prism_look.prism_look_when(card, prism_look.prism_state_hover(), hov))
    _check_true("has hover state", prism_look.prism_look_has_state(carded, "hover"))
    _check_true("no press state", not prism_look.prism_look_has_state(carded, "press"))
    let hstate = unwrap(prism_look.prism_look_state(carded, "hover"))
    _check("hover overrides lift -> 4", prism_look.prism_look_value_str(hstate, "lift"), "elev:4")
    _check("base lift still 2", prism_look.prism_look_value_str(carded, "lift"), "elev:2")
    _check("adding a state does not add a base property", str(prism_look.prism_look_prop_count(carded)), "5")
    // Layering a second override onto the same state is later-wins too.
    let hov2 = unwrap(prism_look.prism_lift(prism_look.prism_look_new(), unwrap(prism_look.prism_elev(6))))
    let carded2 = unwrap(prism_look.prism_look_when(carded, prism_look.prism_state_hover(), hov2))
    _check("state layering later-wins", prism_look.prism_look_value_str(unwrap(prism_look.prism_look_state(carded2, "hover")), "lift"), "elev:6")
    _check("original state NOT mutated", prism_look.prism_look_value_str(unwrap(prism_look.prism_look_state(carded, "hover")), "lift"), "elev:4")

    print("== 5. resolve: palette refs -> flat constants ==")
    // A plain slot dict of hex strings -- the shape prism_palette_slots() returns, but supplied
    // directly here so this KAT stays independent of the palette module.
    let slots = {"ground": "#ffffff", "ink": "#1a1a1a", "edge": "#e5e7eb"}
    let flat = unwrap(prism_look.prism_look_resolve(carded, slots))
    _check("fill flattened", prism_look.prism_look_value_str(flat, "fill"), "#ffffff")
    _check("edge flattened", prism_look.prism_look_value_str(flat, "edge"), "#e5e7eb")
    _check("non-ref untouched", prism_look.prism_look_value_str(flat, "inset"), "16")
    _check("state survives resolve", prism_look.prism_look_value_str(unwrap(prism_look.prism_look_state(flat, "hover")), "lift"), "elev:4")
    _check("source look NOT mutated by resolve", prism_look.prism_look_value_str(carded, "fill"), "palette.ground")
    // A missing slot must be a TYPED ERROR naming the slot -- not a dropped property.
    let short_slots = {"ink": "#1a1a1a"}
    _check_rejected("missing slot 'ground'", prism_look.prism_look_resolve(carded, short_slots))

    print("== 6. rejections ==")
    let L = prism_look.prism_look_new()
    _check_rejected("negative length", prism_look.prism_len(-1))
    _check_rejected("fraction 101", prism_look.prism_frac(101))
    _check_rejected("fraction -1", prism_look.prism_frac(-1))
    _check_rejected("elevation 25", prism_look.prism_elev(25))
    _check_rejected("elevation -1", prism_look.prism_elev(-1))
    _check_rejected("negative duration", prism_look.prism_dur_ms(-5))
    _check_rejected("negative grow factor", prism_look.prism_grow_by(-2))
    _check_rejected("bad hex #gg0000", prism_look.prism_paint_hex("#gg0000"))
    _check_rejected("bad hex, no #", prism_look.prism_paint_hex("ffffff"))
    _check_rejected("bad hex length", prism_look.prism_paint_hex("#12345"))
    _check_rejected("empty palette slot name", prism_look.prism_paint_slot(""))
    _check_rejected("unknown state 'wiggle'", prism_look.prism_look_when(L, "wiggle", L))
    _check_rejected("no such state to read", prism_look.prism_look_state(L, "hover"))
    // A value built for one property handed to another must be rejected by NAME, not stored.
    _check_rejected("cursor value into align", prism_look.prism_align_of(L, prism_look.prism_cursor_grab()))
    _check_rejected("length into fill (paint expected)", prism_look.prism_fill(L, unwrap(prism_look.prism_len(3))))
    _check_rejected("elevation into inset (len expected)", prism_look.prism_inset(L, unwrap(prism_look.prism_elev(2))))
    _check_rejected("duration into round (len expected)", prism_look.prism_round(L, unwrap(prism_look.prism_dur_ms(10))))
    // Boundaries that must be ACCEPTED, so the validation is not merely over-strict.
    _check_true("length 0 accepted", not is_err(prism_look.prism_len(0)))
    _check_true("fraction 0 accepted", not is_err(prism_look.prism_frac(0)))
    _check_true("fraction 100 accepted", not is_err(prism_look.prism_frac(100)))
    _check_true("elevation 0 accepted", not is_err(prism_look.prism_elev(0)))
    _check_true("elevation 24 accepted", not is_err(prism_look.prism_elev(24)))
    _check_true("#abc accepted", not is_err(prism_look.prism_paint_hex("#abc")))
    _check_true("#11223344 accepted", not is_err(prism_look.prism_paint_hex("#11223344")))

    if FAILED[0] == 0
        print("")
        print("_kat_prism_style_b: ALL PASS")
    else
        print("")
        print("_kat_prism_style_b: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
