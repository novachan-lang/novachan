// KAT for prism/text/prism_select.nova -- selection + caret built on prism_textmodel.
//
// The four things this proves, in order of importance:
//   1. ANCHOR/HEAD, NOT (LO,HI): a backwards selection (anchor > head) is constructed, moved, and
//      normalised correctly -- collapsing direction anywhere would break continued extension.
//   2. CLAMP vs REJECT is a real split, not an accident: validated construction (prism_sel_new,
//      prism_sel_select_range) REJECTS an out-of-range position; interactive movement
//      (extend_to/_by, move_to/_by, clamp_to_doc) CLAMPS the same kind of out-of-range position.
//      Both families still REJECT a wrong TYPE.
//   3. Positions are CODE POINTS over prism_textmodel documents -- every case below runs on
//      non-ASCII text ("héllo", "日本語text"), because an ASCII-only test cannot distinguish a
//      correct code-point model from a broken byte-indexed one.
//   4. Structural equality: exact (direction-sensitive) vs range-only (direction-insensitive).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to nova-compiler/, NOVA_NO_CACHE=1)

import prism_textmodel
import prism_select

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        print("  pass  {name}")
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_select ==")
    print("")

    let doc = unwrap(prism_textmodel.prism_tm_plain("héllo"))        // 5 code points
    let cjk = unwrap(prism_textmodel.prism_tm_plain("日本語text"))    // 7 code points

    print("1. construction -- unbound")
    let c1 = unwrap(prism_select.prism_sel_at(2))
    check("at(2) is collapsed", prism_select.prism_sel_is_collapsed(c1))
    check("at(2) anchor==head==2", prism_select.prism_sel_anchor(c1) == 2 and prism_select.prism_sel_head(c1) == 2)
    let r1 = unwrap(prism_select.prism_sel_raw(1, 4))
    check("raw(1,4) anchor=1 head=4", prism_select.prism_sel_anchor(r1) == 1 and prism_select.prism_sel_head(r1) == 4)
    check("raw rejects negative anchor", is_err(prism_select.prism_sel_raw(-1, 2)))
    check("raw rejects negative head", is_err(prism_select.prism_sel_raw(2, -1)))
    check("raw rejects non-int anchor", is_err(prism_select.prism_sel_raw("0", 2)))
    print("")

    print("2. construction bound to a NON-ASCII document -- REJECTS out-of-range")
    let b1 = unwrap(prism_select.prism_sel_new(doc, 1, 4))
    check("new(doc,1,4) ok", prism_select.prism_sel_anchor(b1) == 1 and prism_select.prism_sel_head(b1) == 4)
    check("new rejects head > length (5)", is_err(prism_select.prism_sel_new(doc, 0, 6)))
    check("new rejects negative anchor", is_err(prism_select.prism_sel_new(doc, -1, 3)))
    check("new accepts head == length exactly (boundary)", not is_err(prism_select.prism_sel_new(doc, 0, 5)))
    let sr = unwrap(prism_select.prism_sel_select_range(doc, 1, 3))
    check("select_range(1,3) forward", prism_select.prism_sel_anchor(sr) == 1 and prism_select.prism_sel_head(sr) == 3)
    check("select_range rejects past end", is_err(prism_select.prism_sel_select_range(doc, 0, 99)))
    check("select_range rejects inverted range (reuses textmodel's own rule)", is_err(prism_select.prism_sel_select_range(doc, 3, 1)))
    let all = prism_select.prism_sel_select_all(doc)
    check("select_all spans the whole 5-code-point doc", prism_select.prism_sel_anchor(all) == 0 and prism_select.prism_sel_head(all) == 5)
    let allc = prism_select.prism_sel_select_all(cjk)
    check("select_all over CJK doc spans 7 code points, not bytes", prism_select.prism_sel_head(allc) == 7)
    print("")

    print("3. backwards selections are real -- anchor may be AFTER head")
    let bw = unwrap(prism_select.prism_sel_new(doc, 4, 1))
    check("backwards: anchor=4 head=1 preserved", prism_select.prism_sel_anchor(bw) == 4 and prism_select.prism_sel_head(bw) == 1)
    check("is_backwards true", prism_select.prism_sel_is_backwards(bw))
    check("is_backwards false on a forward selection", not prism_select.prism_sel_is_backwards(b1))
    check("lo/hi are direction-independent: lo=1 hi=4", prism_select.prism_sel_lo(bw) == 1 and prism_select.prism_sel_hi(bw) == 4)
    check("lo/hi agree with the forward selection over the same range", prism_select.prism_sel_lo(bw) == prism_select.prism_sel_lo(b1) and prism_select.prism_sel_hi(bw) == prism_select.prism_sel_hi(b1))
    print("")

    print("4. normalise")
    let nb = prism_select.prism_sel_normalize(bw)
    check("normalize(backwards) is forward: anchor<=head", prism_select.prism_sel_anchor(nb) == 1 and prism_select.prism_sel_head(nb) == 4)
    check("normalize covers the SAME range as the backwards selection", prism_select.prism_sel_same_range(nb, bw))
    let nf = prism_select.prism_sel_normalize(b1)
    check("normalize is idempotent on an already-forward selection", prism_select.prism_sel_same(nf, b1))
    print("")

    print("5. collapse")
    let ca = prism_select.prism_sel_collapse_to_anchor(bw)
    check("collapse_to_anchor(bw) -> caret at anchor=4", prism_select.prism_sel_is_collapsed(ca) and prism_select.prism_sel_anchor(ca) == 4)
    let ch = prism_select.prism_sel_collapse_to_head(bw)
    check("collapse_to_head(bw) -> caret at head=1", prism_select.prism_sel_is_collapsed(ch) and prism_select.prism_sel_head(ch) == 1)
    let cs = prism_select.prism_sel_collapse_to_start(bw)
    check("collapse_to_start(bw) -> caret at lo=1 regardless of direction", prism_select.prism_sel_head(cs) == 1)
    let ce = prism_select.prism_sel_collapse_to_end(bw)
    check("collapse_to_end(bw) -> caret at hi=4 regardless of direction", prism_select.prism_sel_head(ce) == 4)
    let csf = prism_select.prism_sel_collapse_to_start(b1)
    check("collapse_to_start(b1) (already forward) -> caret at anchor=1", prism_select.prism_sel_head(csf) == 1)
    print("")

    print("6. interactive movement -- CLAMPS, never rejects an in-range TYPE that is out of BOUNDS")
    let m1 = unwrap(prism_select.prism_sel_extend_to(b1, doc, 3))
    check("extend_to(3) moves head, keeps anchor", prism_select.prism_sel_anchor(m1) == 1 and prism_select.prism_sel_head(m1) == 3)
    let m2 = unwrap(prism_select.prism_sel_extend_to(b1, doc, 999))
    check("extend_to(999) CLAMPS to doc length 5, does NOT error", prism_select.prism_sel_head(m2) == 5)
    let m3 = unwrap(prism_select.prism_sel_extend_to(b1, doc, -999))
    check("extend_to(-999) CLAMPS to 0", prism_select.prism_sel_head(m3) == 0)
    let m4 = unwrap(prism_select.prism_sel_move_to(b1, doc, 999))
    check("move_to(999) clamps AND collapses: anchor==head==5", prism_select.prism_sel_anchor(m4) == 5 and prism_select.prism_sel_head(m4) == 5)
    let m5 = unwrap(prism_select.prism_sel_extend_by(b1, doc, 100))
    check("extend_by(+100) clamps head to length 5", prism_select.prism_sel_head(m5) == 5)
    let m6 = unwrap(prism_select.prism_sel_move_by(unwrap(prism_select.prism_sel_at(2)), doc, -1))
    check("move_by(-1) from caret at 2 -> collapsed at 1", prism_select.prism_sel_anchor(m6) == 1 and prism_select.prism_sel_head(m6) == 1)
    check("extend_to REJECTS a non-int position (still a type error, never clamped)", is_err(prism_select.prism_sel_extend_to(b1, doc, "x")))
    check("move_by REJECTS a non-int delta", is_err(prism_select.prism_sel_move_by(c1, doc, "x")))
    print("")

    print("7. clamp_to_doc -- total, re-binds a stale selection after the doc shrinks")
    let stale = unwrap(prism_select.prism_sel_raw(2, 99))
    let clamped = prism_select.prism_sel_clamp_to_doc(stale, doc)
    check("clamp_to_doc pulls head 99 down to length 5", prism_select.prism_sel_head(clamped) == 5)
    check("clamp_to_doc leaves an in-range anchor untouched", prism_select.prism_sel_anchor(clamped) == 2)
    print("")

    print("8. selected text over NON-ASCII documents")
    let ht = unwrap(prism_select.prism_sel_text(b1, doc))
    check("text of [1,4) over 'héllo' is 'éll' (code points, not bytes)", ht == "éll")
    let ct = unwrap(prism_select.prism_sel_text(unwrap(prism_select.prism_sel_new(cjk, 0, 3)), cjk))
    check("text of [0,3) over the CJK doc is '日本語'", ct == "日本語")
    let bwt = unwrap(prism_select.prism_sel_text(bw, doc))
    check("text() over a BACKWARDS selection still returns the covered range forward", bwt == "éll")
    print("")

    print("9. equality")
    check("same() is direction-sensitive: bw != b1 even though same range", not prism_select.prism_sel_same(bw, b1))
    check("same_range() ignores direction: bw == b1 by range", prism_select.prism_sel_same_range(bw, b1))
    check("same() true for identical anchor/head", prism_select.prism_sel_same(b1, unwrap(prism_select.prism_sel_raw(1, 4))))
    print("")

    if STATS[1] == 0
        print("_kat_prism_select: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_select: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
