// KAT for prism/ui/prism_ui_token.nova (the `ui/` composition layer's tags/chips component: tag,
// closable tag, tag group, tag input).
//
// Proves, against concrete expected values (every depth/count is hand-computed from
// prism_node.nova's own `depth = max(child depths) + 1`, `count = 1 + sum(child counts)` rule,
// never guessed):
//   1. Tag: all 4 variants construct as an exact band(d=2,c=2) with the label child's text and the
//      band's own "variant" attr both round-tripping; rejects an empty label.
//   2. Variant name: all 4 names are the expected strings AND pairwise distinct.
//   3. Closable tag: exact band(d=3,c=4) containing [label, press(d=2,c=2)[glyph]], the close
//      button's own text is close_label (not the tag's label), its glyph is the Close icon;
//      rejects an empty label and rejects an empty (but present) close_label.
//   4. Tag group: exact flow(d=3,c=6) over a MIXED list (two real tag chips plus one plain label
//      node, proving the group accepts any PrismNode, not just its own chips); rejects an empty
//      list and a non-PrismNode element (with the offending index and actual type named).
//   5. Tag input: exact stack(d=5,c=11) with a tag flow + entry when under capacity, exact
//      stack(d=5,c=10) with the entry OMITTED (not hidden-but-present) at exact capacity, exact
//      stack(d=2,c=2) with only the entry when there are no tags yet; rejects a duplicate tag, an
//      empty tag string, a non-string tag element, an empty label, and a negative max_tags.
//   6. Kind check: the three component families render through prism_node_kind_str as exactly
//      "band" (tag), "flow" (group), "stack" (input) -- the literal PRISM_SPEC.md vocabulary
//      strings this whole layer is built to stay closed over (axiom A7).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_token` resolve.
//   ./gen3_test.exe _kat_prism_ui_token.nova
//   clang -O2 -o _kat_prism_ui_token.exe _kat_prism_ui_token.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_token.exe

import prism_node
import prism_content
import prism_ui_token as tk

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    // ── 1. Tag: all 4 variants, exact band(d=2,c=2), label text + variant attr round-trip ────
    let tag_default_r = tk.prism_tk_tag("Beta", tk.prism_tk_variant_default())
    _check_true("tag (default variant) constructs", is_ok(tag_default_r))
    let tag_default = unwrap(tag_default_r)
    _check("tag kind_str", prism_node.prism_node_kind_str(tag_default), "band")
    _check("tag depth", str(prism_node.prism_node_depth(tag_default)), "2")
    _check("tag count", str(prism_node.prism_node_count(tag_default)), "2")
    _check("tag child count", str(prism_node.prism_node_child_count(tag_default)), "1")
    let tag_default_kids = prism_node.prism_node_children(tag_default)
    _check("tag child kind_str", prism_node.prism_node_kind_str(tag_default_kids[0]), "label")
    _check("tag child text", prism_node.prism_node_attr_str(tag_default_kids[0], "text", ""), "Beta")
    _check("tag variant attr (generic accessor)", prism_node.prism_node_attr_str(tag_default, "variant", ""), "default")
    _check("tag variant attr (dedicated accessor)", tk.prism_tk_tag_variant_of(tag_default), "default")

    let tag_primary = unwrap(tk.prism_tk_tag("Beta", tk.prism_tk_variant_primary()))
    _check("tag primary variant attr", tk.prism_tk_tag_variant_of(tag_primary), "primary")
    let tag_success = unwrap(tk.prism_tk_tag("Beta", tk.prism_tk_variant_success()))
    _check("tag success variant attr", tk.prism_tk_tag_variant_of(tag_success), "success")
    let tag_danger = unwrap(tk.prism_tk_tag("Urgent", tk.prism_tk_variant_danger()))
    _check("tag danger variant attr", tk.prism_tk_tag_variant_of(tag_danger), "danger")
    _check("tag danger child text", prism_node.prism_node_attr_str(prism_node.prism_node_children(tag_danger)[0], "text", ""), "Urgent")

    let tag_empty_label_r = tk.prism_tk_tag("", tk.prism_tk_variant_default())
    _check_true("tag rejects an empty label", is_err(tag_empty_label_r))
    print("")

    // ── 2. Variant name: 4 expected strings, pairwise distinct ──────────────────────────────
    _check("variant name: default", tk.prism_tk_variant_name(tk.prism_tk_variant_default()), "default")
    _check("variant name: primary", tk.prism_tk_variant_name(tk.prism_tk_variant_primary()), "primary")
    _check("variant name: success", tk.prism_tk_variant_name(tk.prism_tk_variant_success()), "success")
    _check("variant name: danger", tk.prism_tk_variant_name(tk.prism_tk_variant_danger()), "danger")
    let variant_names = [tk.prism_tk_variant_name(tk.prism_tk_variant_default()), tk.prism_tk_variant_name(tk.prism_tk_variant_primary()), tk.prism_tk_variant_name(tk.prism_tk_variant_success()), tk.prism_tk_variant_name(tk.prism_tk_variant_danger())]
    let seen_names = {}
    for nm in variant_names
        seen_names[nm] = true
    _check("all 4 variant names are pairwise distinct", str(len(seen_names.keys())), "4")
    print("")

    // ── 3. Closable tag: exact band(d=3,c=4)[label, press(d=2,c=2)[glyph]] ──────────────────
    let closable_r = tk.prism_tk_tag_closable("Urgent", tk.prism_tk_variant_danger(), "Remove tag: Urgent")
    _check_true("closable tag constructs", is_ok(closable_r))
    let closable = unwrap(closable_r)
    _check("closable kind_str", prism_node.prism_node_kind_str(closable), "band")
    _check("closable depth", str(prism_node.prism_node_depth(closable)), "3")
    _check("closable count", str(prism_node.prism_node_count(closable)), "4")
    _check("closable variant attr", tk.prism_tk_tag_variant_of(closable), "danger")
    let closable_kids = prism_node.prism_node_children(closable)
    _check("closable child count", str(len(closable_kids)), "2")
    _check("closable label child kind_str", prism_node.prism_node_kind_str(closable_kids[0]), "label")
    _check("closable label child text", prism_node.prism_node_attr_str(closable_kids[0], "text", ""), "Urgent")
    _check("closable close-press kind_str", prism_node.prism_node_kind_str(closable_kids[1]), "press")
    _check("closable close-press accessible text is close_label, not the tag label", prism_node.prism_node_attr_str(closable_kids[1], "text", ""), "Remove tag: Urgent")
    let close_press_kids = prism_node.prism_node_children(closable_kids[1])
    _check("closable close-press child count", str(len(close_press_kids)), "1")
    _check("closable close-press child kind_str", prism_node.prism_node_kind_str(close_press_kids[0]), "glyph")
    _check("closable close-press icon is Close", prism_node.prism_node_attr_str(close_press_kids[0], "icon", ""), "close")

    let closable_empty_label_r = tk.prism_tk_tag_closable("", tk.prism_tk_variant_default(), "Remove")
    _check_true("closable tag rejects an empty label", is_err(closable_empty_label_r))
    let closable_empty_close_r = tk.prism_tk_tag_closable("Urgent", tk.prism_tk_variant_default(), "")
    _check_true("closable tag rejects an empty (present) close_label", is_err(closable_empty_close_r))
    print("")

    // ── 4. Tag group: exact flow(d=3,c=6) over a MIXED list (2 chips + 1 plain label node) ──
    let g_a = unwrap(tk.prism_tk_tag("A", tk.prism_tk_variant_default()))
    let g_b = unwrap(tk.prism_tk_tag("B", tk.prism_tk_variant_primary()))
    let g_plain = unwrap(prism_content.prism_label("Plain"))
    let group_r = tk.prism_tk_tag_group([g_a, g_b, g_plain])
    _check_true("tag group constructs over a mixed PrismNode list", is_ok(group_r))
    let group = unwrap(group_r)
    _check("group kind_str", prism_node.prism_node_kind_str(group), "flow")
    _check("group depth", str(prism_node.prism_node_depth(group)), "3")
    _check("group count", str(prism_node.prism_node_count(group)), "6")
    let group_kids = prism_node.prism_node_children(group)
    _check("group child count", str(len(group_kids)), "3")
    _check("group 3rd child (plain, non-tag PrismNode) kind_str", prism_node.prism_node_kind_str(group_kids[2]), "label")
    _check("group 3rd child text", prism_node.prism_node_attr_str(group_kids[2], "text", ""), "Plain")

    let group_empty_r = tk.prism_tk_tag_group([])
    _check_true("tag group rejects an empty list", is_err(group_empty_r))
    let group_bad_elem_r = tk.prism_tk_tag_group([g_a, "not a node"])
    _check_true("tag group rejects a non-PrismNode element", is_err(group_bad_elem_r))
    if is_err(group_bad_elem_r)
        _check_true("rejection names the offending index and type", contains(unwrap_err(group_bad_elem_r), "1") and contains(unwrap_err(group_bad_elem_r), "string"))
    print("")

    // ── 5. Tag input: under-capacity, at-capacity (entry OMITTED), no-tags-yet, rejections ──
    let input_r = tk.prism_tk_tag_input("Categories", ["red", "blue"], none())
    _check_true("tag input (under capacity) constructs", is_ok(input_r))
    let input_node = unwrap(input_r)
    _check("input kind_str", prism_node.prism_node_kind_str(input_node), "stack")
    _check("input depth", str(prism_node.prism_node_depth(input_node)), "5")
    _check("input count", str(prism_node.prism_node_count(input_node)), "11")
    let input_kids = prism_node.prism_node_children(input_node)
    _check("input child count (flow + entry)", str(len(input_kids)), "2")
    _check("input 1st child kind_str", prism_node.prism_node_kind_str(input_kids[0]), "flow")
    let input_flow_kids = prism_node.prism_node_children(input_kids[0])
    _check("input flow child count", str(len(input_flow_kids)), "2")
    _check("input 1st chip kind_str", prism_node.prism_node_kind_str(input_flow_kids[0]), "band")
    _check("input 1st chip variant attr (default)", tk.prism_tk_tag_variant_of(input_flow_kids[0]), "default")
    let chip0_kids = prism_node.prism_node_children(input_flow_kids[0])
    _check("input 1st chip label text", prism_node.prism_node_attr_str(chip0_kids[0], "text", ""), "red")
    _check("input 1st chip close-press accessible text names the tag", prism_node.prism_node_attr_str(chip0_kids[1], "text", ""), "Remove tag: red")
    _check("input 2nd child kind_str (entry)", prism_node.prism_node_kind_str(input_kids[1]), "entry")
    _check("input entry prompt", prism_node.prism_node_attr_str(input_kids[1], "prompt", ""), "Categories")
    _check("input entry kind", prism_node.prism_node_attr_str(input_kids[1], "kind", ""), "text")
    _check("input entry starts with an empty value", prism_node.prism_node_attr_str(input_kids[1], "value", "nonempty-default"), "")

    // At exact capacity: the entry field is OMITTED (child count drops from 2 to 1), not merely
    // hidden-but-present -- the same "inert vs actually absent" distinction PRISM_STATUS.md's own
    // MB.4 accordion note draws for a stronger-than-tabs disclosure guarantee.
    let at_cap_r = tk.prism_tk_tag_input("Categories", ["x", "y"], some(2))
    _check_true("tag input (at exact capacity) constructs", is_ok(at_cap_r))
    let at_cap_node = unwrap(at_cap_r)
    _check("at-capacity kind_str", prism_node.prism_node_kind_str(at_cap_node), "stack")
    _check("at-capacity depth", str(prism_node.prism_node_depth(at_cap_node)), "5")
    _check("at-capacity count", str(prism_node.prism_node_count(at_cap_node)), "10")
    let at_cap_kids = prism_node.prism_node_children(at_cap_node)
    _check("at-capacity child count (flow only, entry omitted)", str(len(at_cap_kids)), "1")
    _check("at-capacity only child kind_str", prism_node.prism_node_kind_str(at_cap_kids[0]), "flow")

    // No tags yet: the flow is OMITTED (not an empty flow placeholder), only the entry remains.
    let no_tags_r = tk.prism_tk_tag_input("Empty", [], none())
    _check_true("tag input (no tags yet) constructs", is_ok(no_tags_r))
    let no_tags_node = unwrap(no_tags_r)
    _check("no-tags kind_str", prism_node.prism_node_kind_str(no_tags_node), "stack")
    _check("no-tags depth", str(prism_node.prism_node_depth(no_tags_node)), "2")
    _check("no-tags count", str(prism_node.prism_node_count(no_tags_node)), "2")
    let no_tags_kids = prism_node.prism_node_children(no_tags_node)
    _check("no-tags child count (entry only, flow omitted)", str(len(no_tags_kids)), "1")
    _check("no-tags only child kind_str", prism_node.prism_node_kind_str(no_tags_kids[0]), "entry")
    _check("no-tags entry prompt", prism_node.prism_node_attr_str(no_tags_kids[0], "prompt", ""), "Empty")

    let input_dup_r = tk.prism_tk_tag_input("Categories", ["a", "a"], none())
    _check_true("tag input rejects a duplicate tag string", is_err(input_dup_r))
    let input_empty_label_r = tk.prism_tk_tag_input("", ["a"], none())
    _check_true("tag input rejects an empty label", is_err(input_empty_label_r))
    let input_neg_max_r = tk.prism_tk_tag_input("Categories", ["a"], some(-1))
    _check_true("tag input rejects a negative max_tags", is_err(input_neg_max_r))
    let input_non_string_r = tk.prism_tk_tag_input("Categories", ["a", 5], none())
    _check_true("tag input rejects a non-string tag element", is_err(input_non_string_r))
    let input_empty_tag_r = tk.prism_tk_tag_input("Categories", ["a", ""], none())
    _check_true("tag input rejects an empty tag string", is_err(input_empty_tag_r))
    print("")

    // ── 6. Kind check: band (tag), flow (group), stack (input) -- the closed vocabulary ─────
    _check("kind check: tag -> band", prism_node.prism_node_kind_str(tag_default), "band")
    _check("kind check: closable tag -> band", prism_node.prism_node_kind_str(closable), "band")
    _check("kind check: tag group -> flow", prism_node.prism_node_kind_str(group), "flow")
    _check("kind check: tag input -> stack", prism_node.prism_node_kind_str(input_node), "stack")

    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_token: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_token: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
