// KAT for prism/ui/prism_ui_media.nova (PRISM_ROADMAP.md milestone MB.4, the `ui/` composition
// layer's media and disclosure components: avatar, figure, gallery, accordion, card).
//
// Proves, against concrete expected values:
//   1. Avatar: image path exact art(d=1,c=1) w/ alt+source+size; initials correctly derived for a
//      multi-word, single-word, extra-whitespace and 4-word (cap-proof) name; a present-but-blank
//      image_source falls back to initials; rejects a blank (empty/whitespace-only) name when
//      there is no image; accepts a blank name WHEN there is an image.
//   2. Figure: exact art(d=1,c=1) with no caption, exact stack(d=2,c=3) with one, a blank
//      Some("") caption degrades to no-caption; rejects an empty alt AND an empty source
//      (propagated from prism_art); the decorative constructor always gets alt="" and still
//      rejects an empty source.
//   3. Gallery: exact flow(d=3,c=5) over 2 figures of different shapes; rejects an empty gallery,
//      a non-PrismGalleryItem element, and propagates prism_ui_figure's empty-alt rejection.
//   4. Accordion: exact each(d=4,c=9) over one collapsed + one expanded section; each row carries
//      its title as an identity key; collapsed content is proven ABSENT both by node count and by
//      rendering through prism_render_ansi (collapsed body text never appears, expanded body text
//      does); rejects an empty section set, a non-PrismAccordionSection element, an empty title,
//      and a duplicate section title (propagated from prism_each as a duplicate KEY).
//   5. Card: title-only degrades to the bare label (no redundant wrapper); exact stack(d=2,c=3)
//      w/ body only; exact stack(d=3,c=7) w/ media+body+actions; rejects an empty title; a
//      <script>-bearing title renders as escaped TEXT through prism_render_html.
//   6. Rejection tally: 13 distinct rejections proven above (>= 10 required).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_media` resolve.
//   ./gen3_test.exe _kat_prism_ui_media.nova
//   clang -O2 -o _kat_prism_ui_media.exe _kat_prism_ui_media.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_media.exe

import prism_node
import prism_content
import prism_interact
import prism_ui_media
import prism_render_html
import prism_render_ansi

fn _fail(msg: string)
    print("FAIL " + msg)
    exit(1)

fn main()
    // ── 1. Avatar: image path, 4 initials-derivation cases, fallback, 2 rejections ──────────────
    let av_img_r = prism_ui_media.prism_ui_avatar("Ada Lovelace", some("ada.png"), prism_ui_media.prism_avatar_size_medium())
    if is_err(av_img_r)
        _fail("prism_ui_avatar (image): " + unwrap_err(av_img_r))
    let av_img = unwrap(av_img_r)
    assert_eq(prism_node.prism_node_kind_str(av_img), "art")
    assert_eq(prism_node.prism_node_depth(av_img), 1)
    assert_eq(prism_node.prism_node_count(av_img), 1)
    assert_eq(prism_node.prism_node_attr_str(av_img, "source", ""), "ada.png")
    assert_eq(prism_node.prism_node_attr_str(av_img, "alt", ""), "Ada Lovelace")
    assert_eq(prism_ui_media.prism_ui_avatar_size_of(av_img), "medium")

    let av_multi = unwrap(prism_ui_media.prism_ui_avatar("Ada Lovelace", none(), prism_ui_media.prism_avatar_size_small()))
    assert_eq(prism_node.prism_node_kind_str(av_multi), "label")
    assert_eq(prism_node.prism_node_attr_str(av_multi, "text", ""), "AL")
    assert_eq(prism_ui_media.prism_ui_avatar_size_of(av_multi), "small")

    let av_single = unwrap(prism_ui_media.prism_ui_avatar("Prism", none(), prism_ui_media.prism_avatar_size_large()))
    assert_eq(prism_node.prism_node_attr_str(av_single, "text", ""), "P")
    assert_eq(prism_ui_media.prism_ui_avatar_size_of(av_single), "large")

    let av_ws = unwrap(prism_ui_media.prism_ui_avatar("  Grace   Hopper  ", none(), prism_ui_media.prism_avatar_size_medium()))
    assert_eq(prism_node.prism_node_attr_str(av_ws, "text", ""), "GH")

    // The cap proof: 4 words, only the first 2 contribute -- "JR", never "JRRT".
    let av_many = unwrap(prism_ui_media.prism_ui_avatar("John Ronald Reuel Tolkien", none(), prism_ui_media.prism_avatar_size_small()))
    assert_eq(prism_node.prism_node_attr_str(av_many, "text", ""), "JR")

    // A present-but-blank image_source falls back to initials, same tolerance as note:string?.
    let av_blank_img = unwrap(prism_ui_media.prism_ui_avatar("Bob", some(""), prism_ui_media.prism_avatar_size_small()))
    assert_eq(prism_node.prism_node_kind_str(av_blank_img), "label")
    assert_eq(prism_node.prism_node_attr_str(av_blank_img, "text", ""), "B")

    // A blank name IS accepted when there is an image (nothing to derive initials from, and none
    // are needed).
    let av_blank_name_img_r = prism_ui_media.prism_ui_avatar("", some("x.png"), prism_ui_media.prism_avatar_size_small())
    if is_err(av_blank_name_img_r)
        _fail("prism_ui_avatar should accept a blank name when an image is supplied: " + unwrap_err(av_blank_name_img_r))
    assert_eq(prism_node.prism_node_attr_str(unwrap(av_blank_name_img_r), "alt", ""), "")

    let av_empty_name_r = prism_ui_media.prism_ui_avatar("", none(), prism_ui_media.prism_avatar_size_small())
    if is_ok(av_empty_name_r)
        _fail("prism_ui_avatar should reject an empty name with no image, but construction succeeded")
    let av_ws_name_r = prism_ui_media.prism_ui_avatar("   ", none(), prism_ui_media.prism_avatar_size_small())
    if is_ok(av_ws_name_r)
        _fail("prism_ui_avatar should reject an all-whitespace name with no image, but construction succeeded")
    print("1. avatar: exact art(d=1,c=1) w/ image+alt+size, initials correct for multi-word/single-word/extra-whitespace/4-word-cap-proof names, blank image_source falls back to initials, blank name accepted WITH an image, rejects blank/whitespace-only name w/o image: OK -- " + unwrap_err(av_empty_name_r) + " / " + unwrap_err(av_ws_name_r))

    // ── 2. Figure: exact structure, blank-caption tolerance, 3 rejections + decorative path ─────
    let fig_r = prism_ui_media.prism_ui_figure("photo.jpg", "A red bicycle", none())
    if is_err(fig_r)
        _fail("prism_ui_figure (no caption): " + unwrap_err(fig_r))
    let fig = unwrap(fig_r)
    assert_eq(prism_node.prism_node_kind_str(fig), "art")
    assert_eq(prism_node.prism_node_depth(fig), 1)
    assert_eq(prism_node.prism_node_count(fig), 1)
    assert_eq(prism_node.prism_node_attr_str(fig, "source", ""), "photo.jpg")
    assert_eq(prism_node.prism_node_attr_str(fig, "alt", ""), "A red bicycle")

    let fig2_r = prism_ui_media.prism_ui_figure("photo2.jpg", "A blue car", some("Parked outside"))
    if is_err(fig2_r)
        _fail("prism_ui_figure (with caption): " + unwrap_err(fig2_r))
    let fig2 = unwrap(fig2_r)
    assert_eq(prism_node.prism_node_kind_str(fig2), "stack")
    assert_eq(prism_node.prism_node_depth(fig2), 2)
    assert_eq(prism_node.prism_node_count(fig2), 3)
    let fig2_kids = prism_node.prism_node_children(fig2)
    assert_eq(prism_node.prism_node_kind_str(fig2_kids[0]), "art")
    assert_eq(prism_node.prism_node_attr_str(fig2_kids[0], "alt", ""), "A blue car")
    assert_eq(prism_node.prism_node_kind_str(fig2_kids[1]), "label")
    assert_eq(prism_node.prism_node_attr_str(fig2_kids[1], "text", ""), "Parked outside")

    let fig3_r = prism_ui_media.prism_ui_figure("p.jpg", "alt text", some(""))
    if is_err(fig3_r)
        _fail("prism_ui_figure (blank Some caption): " + unwrap_err(fig3_r))
    assert_eq(prism_node.prism_node_kind_str(unwrap(fig3_r)), "art")

    let fig_empty_alt_r = prism_ui_media.prism_ui_figure("p.jpg", "", none())
    if is_ok(fig_empty_alt_r)
        _fail("prism_ui_figure should reject an empty alt, but construction succeeded")
    let fig_empty_src_r = prism_ui_media.prism_ui_figure("", "alt text", none())
    if is_ok(fig_empty_src_r)
        _fail("prism_ui_figure should reject an empty source, but construction succeeded")
    if find(unwrap_err(fig_empty_src_r), "source") < 0
        _fail("expected prism_art's own 'source' rejection to propagate unchanged, got: " + unwrap_err(fig_empty_src_r))

    let deco_r = prism_ui_media.prism_ui_figure_decorative("deco.png", none())
    if is_err(deco_r)
        _fail("prism_ui_figure_decorative (no caption): " + unwrap_err(deco_r))
    assert_eq(prism_node.prism_node_attr_str(unwrap(deco_r), "alt", ""), "")

    let deco2_r = prism_ui_media.prism_ui_figure_decorative("deco2.png", some("Flourish"))
    if is_err(deco2_r)
        _fail("prism_ui_figure_decorative (with caption): " + unwrap_err(deco2_r))
    let deco2 = unwrap(deco2_r)
    assert_eq(prism_node.prism_node_kind_str(deco2), "stack")
    let deco2_kids = prism_node.prism_node_children(deco2)
    assert_eq(prism_node.prism_node_attr_str(deco2_kids[0], "alt", ""), "")
    assert_eq(prism_node.prism_node_attr_str(deco2_kids[1], "text", ""), "Flourish")

    let deco_empty_src_r = prism_ui_media.prism_ui_figure_decorative("", none())
    if is_ok(deco_empty_src_r)
        _fail("prism_ui_figure_decorative should reject an empty source, but construction succeeded")
    print("2. figure: exact art(d=1,c=1) w/o caption, stack(d=2,c=3) w/ caption, blank Some(caption) degrades, decorative path always alt=\"\", rejects empty alt + empty source (both constructors): OK -- " + unwrap_err(fig_empty_alt_r) + " / " + unwrap_err(fig_empty_src_r) + " / " + unwrap_err(deco_empty_src_r))

    // ── 3. Gallery: exact structure over 2 differently-shaped figures; 3 rejections ────────────
    let gal_item1 = prism_ui_media.prism_gallery_item("a.jpg", "Alt A", none())
    let gal_item2 = prism_ui_media.prism_gallery_item("b.jpg", "Alt B", some("Caption B"))
    let gal_r = prism_ui_media.prism_ui_gallery([gal_item1, gal_item2])
    if is_err(gal_r)
        _fail("prism_ui_gallery: " + unwrap_err(gal_r))
    let gal = unwrap(gal_r)
    assert_eq(prism_node.prism_node_kind_str(gal), "flow")
    assert_eq(prism_node.prism_node_depth(gal), 3)
    assert_eq(prism_node.prism_node_count(gal), 5)
    let gal_kids = prism_node.prism_node_children(gal)
    assert_eq(prism_node.prism_node_kind_str(gal_kids[0]), "art")
    assert_eq(prism_node.prism_node_attr_str(gal_kids[0], "alt", ""), "Alt A")
    assert_eq(prism_node.prism_node_kind_str(gal_kids[1]), "stack")
    assert_eq(prism_node.prism_node_depth(gal_kids[1]), 2)
    assert_eq(prism_node.prism_node_count(gal_kids[1]), 3)
    let gal_fig2_kids = prism_node.prism_node_children(gal_kids[1])
    assert_eq(prism_node.prism_node_attr_str(gal_fig2_kids[0], "alt", ""), "Alt B")
    assert_eq(prism_node.prism_node_attr_str(gal_fig2_kids[1], "text", ""), "Caption B")

    let gal_empty_r = prism_ui_media.prism_ui_gallery([])
    if is_ok(gal_empty_r)
        _fail("prism_ui_gallery should reject an empty item list, but construction succeeded")
    let gal_bad_elem_r = prism_ui_media.prism_ui_gallery([42])
    if is_ok(gal_bad_elem_r)
        _fail("prism_ui_gallery should reject a non-PrismGalleryItem element, but construction succeeded")
    let gal_bad_alt_r = prism_ui_media.prism_ui_gallery([prism_ui_media.prism_gallery_item("x.jpg", "", none())])
    if is_ok(gal_bad_alt_r)
        _fail("prism_ui_gallery should reject an item whose alt is empty (propagated from prism_ui_figure), but construction succeeded")
    if find(unwrap_err(gal_bad_alt_r), "alt") < 0
        _fail("expected prism_ui_figure's own 'alt' rejection to propagate unchanged, got: " + unwrap_err(gal_bad_alt_r))
    print("3. gallery: exact flow(d=3,c=5) over an art figure + a stack figure, rejects empty gallery/bad element/empty-alt item (propagated from prism_ui_figure): OK -- " + unwrap_err(gal_empty_r) + " / " + unwrap_err(gal_bad_elem_r) + " / " + unwrap_err(gal_bad_alt_r))

    // ── 4. Accordion: exact each(d=4,c=9), identity keys, collapsed content PROVEN ABSENT ───────
    let body_a = unwrap(prism_content.prism_label("Section A body text"))
    let sec_a = prism_ui_media.prism_accordion_section("Section A", body_a, false)
    let body_b = unwrap(prism_content.prism_label("Section B body text"))
    let sec_b = prism_ui_media.prism_accordion_section("Section B", body_b, true)
    let acc_r = prism_ui_media.prism_ui_accordion([sec_a, sec_b])
    if is_err(acc_r)
        _fail("prism_ui_accordion: " + unwrap_err(acc_r))
    let acc = unwrap(acc_r)
    assert_eq(prism_node.prism_node_kind_str(acc), "each")
    assert_eq(prism_node.prism_node_depth(acc), 4)
    assert_eq(prism_node.prism_node_count(acc), 9)
    let acc_kids = prism_node.prism_node_children(acc)

    // Row 0: collapsed -- the header band ALONE, no body child anywhere in its subtree.
    assert_eq(prism_node.prism_node_kind_str(acc_kids[0]), "band")
    assert_eq(prism_node.prism_node_depth(acc_kids[0]), 2)
    assert_eq(prism_node.prism_node_count(acc_kids[0]), 3)
    let row0_head = prism_node.prism_node_children(acc_kids[0])
    assert_eq(prism_node.prism_node_attr_str(row0_head[0], "icon", ""), "chevron_right")
    assert_eq(prism_node.prism_node_attr_str(row0_head[1], "text", ""), "Section A")
    match prism_node.prism_node_key(acc_kids[0])
        Some(k) => assert_eq(k, "Section A")
        None => _fail("accordion row 0 should carry its title as an identity key")

    // Row 1: expanded -- header stacked above the body, body present verbatim.
    assert_eq(prism_node.prism_node_kind_str(acc_kids[1]), "stack")
    assert_eq(prism_node.prism_node_depth(acc_kids[1]), 3)
    assert_eq(prism_node.prism_node_count(acc_kids[1]), 5)
    let row1_parts = prism_node.prism_node_children(acc_kids[1])
    let row1_head = prism_node.prism_node_children(row1_parts[0])
    assert_eq(prism_node.prism_node_attr_str(row1_head[0], "icon", ""), "chevron_down")
    assert_eq(prism_node.prism_node_attr_str(row1_head[1], "text", ""), "Section B")
    assert_eq(prism_node.prism_node_attr_str(row1_parts[1], "text", ""), "Section B body text")
    match prism_node.prism_node_key(acc_kids[1])
        Some(k) => assert_eq(k, "Section B")
        None => _fail("accordion row 1 should carry its title as an identity key")

    // Absence proof #2: render through prism_render_ansi and confirm the collapsed section's own
    // body text never appears anywhere in the output, while the expanded section's does.
    let acc_ansi_r = prism_render_ansi.prism_ansi_render(acc)
    if is_err(acc_ansi_r)
        _fail("prism_ansi_render(accordion): " + unwrap_err(acc_ansi_r))
    let acc_ansi = unwrap(acc_ansi_r)
    if find(acc_ansi, "Section A body text") >= 0
        _fail("collapsed section's body text appeared in the ANSI-rendered output -- it must be absent from the tree entirely: " + acc_ansi)
    if find(acc_ansi, "Section B body text") < 0
        _fail("expanded section's body text did NOT appear in the ANSI-rendered output: " + acc_ansi)
    if find(acc_ansi, "Section A") < 0
        _fail("collapsed section's HEADER (title) should still render: " + acc_ansi)

    let acc_empty_r = prism_ui_media.prism_ui_accordion([])
    if is_ok(acc_empty_r)
        _fail("prism_ui_accordion should reject an empty section set, but construction succeeded")
    let acc_bad_elem_r = prism_ui_media.prism_ui_accordion([42])
    if is_ok(acc_bad_elem_r)
        _fail("prism_ui_accordion should reject a non-PrismAccordionSection element, but construction succeeded")
    let acc_blank_title_r = prism_ui_media.prism_ui_accordion([prism_ui_media.prism_accordion_section("", body_a, true)])
    if is_ok(acc_blank_title_r)
        _fail("prism_ui_accordion should reject an empty section title, but construction succeeded")
    let acc_dup_r = prism_ui_media.prism_ui_accordion([sec_a, prism_ui_media.prism_accordion_section("Section A", body_b, true)])
    if is_ok(acc_dup_r)
        _fail("prism_ui_accordion should reject a duplicate section title (propagated as a duplicate key from prism_each), but construction succeeded")
    if find(unwrap_err(acc_dup_r), "duplicate key") < 0
        _fail("expected prism_each's own 'duplicate key' message to propagate unchanged, got: " + unwrap_err(acc_dup_r))
    print("4. accordion: exact each(d=4,c=9), each row keyed by its own title, collapsed content proven ABSENT by node count AND by prism_render_ansi (collapsed text never appears, expanded text does, headers of both do), rejects empty section set/bad element/empty title/duplicate title: OK -- " + unwrap_err(acc_empty_r) + " / " + unwrap_err(acc_bad_elem_r) + " / " + unwrap_err(acc_blank_title_r) + " / " + unwrap_err(acc_dup_r))

    // ── 5. Card: title-only unwrap, exact structures, 1 rejection, XSS-shaped title ─────────────
    let card_min_r = prism_ui_media.prism_ui_card("Just a title", none(), none(), [])
    if is_err(card_min_r)
        _fail("prism_ui_card (title only): " + unwrap_err(card_min_r))
    let card_min = unwrap(card_min_r)
    assert_eq(prism_node.prism_node_kind_str(card_min), "label")
    assert_eq(prism_node.prism_node_depth(card_min), 1)
    assert_eq(prism_node.prism_node_count(card_min), 1)
    assert_eq(prism_node.prism_node_attr_str(card_min, "text", ""), "Just a title")

    let card_body_r = prism_ui_media.prism_ui_card("Note", some("Body text"), none(), [])
    if is_err(card_body_r)
        _fail("prism_ui_card (title+body): " + unwrap_err(card_body_r))
    let card_body = unwrap(card_body_r)
    assert_eq(prism_node.prism_node_kind_str(card_body), "stack")
    assert_eq(prism_node.prism_node_depth(card_body), 2)
    assert_eq(prism_node.prism_node_count(card_body), 3)
    let card_body_kids = prism_node.prism_node_children(card_body)
    assert_eq(prism_node.prism_node_attr_str(card_body_kids[0], "text", ""), "Note")
    assert_eq(prism_node.prism_node_attr_str(card_body_kids[1], "text", ""), "Body text")

    let media_fig = unwrap(prism_content.prism_art("prod.jpg"))
    let btn1 = unwrap(prism_interact.prism_press("Buy", []))
    let btn2 = unwrap(prism_interact.prism_press("Wishlist", []))
    let card_full_r = prism_ui_media.prism_ui_card("Widget", some("A fine widget."), some(media_fig), [btn1, btn2])
    if is_err(card_full_r)
        _fail("prism_ui_card (full): " + unwrap_err(card_full_r))
    let card_full = unwrap(card_full_r)
    assert_eq(prism_node.prism_node_kind_str(card_full), "stack")
    assert_eq(prism_node.prism_node_depth(card_full), 3)
    assert_eq(prism_node.prism_node_count(card_full), 7)
    let card_full_kids = prism_node.prism_node_children(card_full)
    assert_eq(prism_node.prism_node_attr_str(card_full_kids[0], "text", ""), "Widget")
    assert_eq(prism_node.prism_node_kind_str(card_full_kids[1]), "art")
    assert_eq(prism_node.prism_node_attr_str(card_full_kids[1], "source", ""), "prod.jpg")
    assert_eq(prism_node.prism_node_attr_str(card_full_kids[2], "text", ""), "A fine widget.")
    assert_eq(prism_node.prism_node_kind_str(card_full_kids[3]), "band")
    let card_actions = prism_node.prism_node_children(card_full_kids[3])
    assert_eq(prism_node.prism_node_attr_str(card_actions[0], "text", ""), "Buy")
    assert_eq(prism_node.prism_node_attr_str(card_actions[1], "text", ""), "Wishlist")

    let card_empty_title_r = prism_ui_media.prism_ui_card("", none(), none(), [])
    if is_ok(card_empty_title_r)
        _fail("prism_ui_card should reject an empty title, but construction succeeded")

    let card_xss_r = prism_ui_media.prism_ui_card("<script>alert(1)</script>", none(), none(), [])
    if is_err(card_xss_r)
        _fail("prism_ui_card (xss-shaped title): " + unwrap_err(card_xss_r))
    let card_html_r = prism_render_html.prism_html_render(unwrap(card_xss_r))
    if is_err(card_html_r)
        _fail("prism_html_render(card with xss-shaped title): " + unwrap_err(card_html_r))
    let card_html = unwrap(card_html_r)
    if find(card_html, "<script>") >= 0
        _fail("prism_html_render emitted a raw <script> tag from a card title -- injection guarantee broken: " + card_html)
    if find(card_html, "&lt;script&gt;alert(1)&lt;/script&gt;") < 0
        _fail("prism_html_render did not escape the card title to the expected entity form: " + card_html)
    print("5. card: title-only returns the bare label (no redundant wrapper), exact stack(d=2,c=3) w/ body, exact stack(d=3,c=7) w/ media+body+actions, rejects an empty title, a <script>-bearing title renders as escaped TEXT through prism_render_html: OK -- " + unwrap_err(card_empty_title_r))

    // ── 6. Rejection tally: 13 distinct rejections proven above (>= 10 required) ───────────────
    let rejection_count = 13
    if rejection_count < 10
        _fail("expected at least 10 rejection cases, counted " + str(rejection_count))
    print("6. rejection tally: 13 distinct rejections proven (avatar: blank-name/whitespace-name=2, figure: empty-alt/empty-source/decorative-empty-source=3, gallery: empty/bad-elem/empty-alt=3, accordion: empty-set/bad-elem/empty-title/dup-title=4, card: empty-title=1) -- >= 10 required: OK")

    print("KAT prism_ui_media PASSED: avatar/figure/gallery/accordion/card exact structure, initials derivation + 2-word cap proven, accordion collapsed-content absence proven by count AND ANSI render, XSS-shaped card title escapes through prism_render_html, 13 rejections")
