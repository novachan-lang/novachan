// KAT for prism/widget/prism_arrange.nova + prism/widget/prism_content.nova
// (PRISM_ROADMAP.md milestone MA.3 part A -- the 7 arrangement + 4 content primitives).
//
// Proves, against concrete expected values:
//   1. All 11 primitives (stack, band, layer, mesh, flow, pane, gap, label, art, glyph, draw)
//      construct the correct PrismNodeKind, in ONE composed tree that nests arrangement
//      widgets around content widgets (an arrangement containing content, per spec).
//   2. Children order is preserved at every level of that tree (not just membership).
//   3. Attribute values round-trip through prism_node_attr_str / _attr_int / _attr_bool,
//      both directly and through this milestone's own typed accessor wrappers.
//   4. At least 3 (here: 6) invalid-attr-value constructions are REJECTED with is_err, each
//      naming the bad value in its error message -- mesh with 0 columns, mesh with a
//      non-positive fixed track (two variants), gap with a negative size, draw with an
//      obviously-non-callable paint, and art with an empty source.
//   5. The nested tree's cached depth/count are exactly right (hand-computed, not just
//      "some positive number") -- proves prism_node_new's bounds bookkeeping composes
//      correctly through a THIRD-PARTY widget layer, not just prism_node.nova's own KAT.
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova (recursively)
// into $NOVA_HOME/lib, so `import prism_arrange` / `import prism_content` resolve exactly like
// `import prism_node` does for _kat_prism_node.nova.
//   ./gen3_test.exe _kat_prism_widget_a.nova
//   clang -O2 -o _kat_prism_widget_a.exe _kat_prism_widget_a.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_widget_a.exe

import prism_node
import prism_arrange
import prism_content

fn _fail(msg: string)
    print("FAIL " + msg)
    exit(1)

fn main()
    // ── 1+2+5. One composed tree exercising all 11 primitives, order-preserving ────────────
    //
    // root (Stack)
    //   ├─ toolbar (Flow)                     -- arrangement containing content
    //   │    ├─ glyph(Search)
    //   │    ├─ label("Search")
    //   │    └─ gap(none())                    flexible
    //   ├─ row (Band)
    //   │    ├─ label("Left")
    //   │    ├─ gap(some(10))                  fixed 10
    //   │    └─ label("Right")
    //   ├─ grid_area (Mesh, cols=[fixed(100), fill(), fit()])
    //   │    ├─ label("A")
    //   │    ├─ label("B")
    //   │    └─ label("C")
    //   ├─ overlay (Layer)
    //   │    ├─ art("bg.png")
    //   │    └─ label("Overlay Text")
    //   ├─ viewer (Pane)
    //   │    └─ label("Scrollable content")
    //   └─ draw_node (Draw, paint = fn(s) s * 2)
    //
    // All 11 PrismNodeKind values appear: Stack, Flow, Band, Mesh, Layer, Pane, Gap, Label,
    // Art, Glyph, Draw.

    let glyph_search = unwrap(prism_content.prism_glyph(prism_content.prism_icon_search()))
    let label_search = unwrap(prism_content.prism_label("Search"))
    let gap_flex = unwrap(prism_arrange.prism_gap(none()))
    let toolbar = unwrap(prism_arrange.prism_flow([glyph_search, label_search, gap_flex]))

    let label_left = unwrap(prism_content.prism_label("Left"))
    let gap_fixed = unwrap(prism_arrange.prism_gap(some(10)))
    let label_right = unwrap(prism_content.prism_label("Right"))
    let row = unwrap(prism_arrange.prism_band([label_left, gap_fixed, label_right]))

    let label_a = unwrap(prism_content.prism_label("A"))
    let label_b = unwrap(prism_content.prism_label("B"))
    let label_c = unwrap(prism_content.prism_label("C"))
    let cols = [prism_arrange.prism_track_fixed(100), prism_arrange.prism_track_fill(), prism_arrange.prism_track_fit()]
    let grid_area = unwrap(prism_arrange.prism_mesh(cols, [label_a, label_b, label_c]))

    let art_bg = unwrap(prism_content.prism_art("bg.png"))
    let label_overlay_text = unwrap(prism_content.prism_label("Overlay Text"))
    let overlay = unwrap(prism_arrange.prism_layer([art_bg, label_overlay_text]))

    let label_scroll = unwrap(prism_content.prism_label("Scrollable content"))
    let viewer = unwrap(prism_arrange.prism_pane(label_scroll))

    let draw_node = unwrap(prism_content.prism_draw(fn(s) s * 2))

    let root = unwrap(prism_arrange.prism_stack([toolbar, row, grid_area, overlay, viewer, draw_node]))

    // -- Kind + order at the root level (6 children, 6 distinct kinds among them) --
    assert_eq(prism_node.prism_node_kind_str(root), "stack")
    assert_eq(prism_node.prism_node_child_count(root), 6)
    let rc = prism_node.prism_node_children(root)
    let root_expected_kinds = ["flow", "band", "mesh", "layer", "pane", "draw"]
    let mut ri = 0
    while ri < 6
        if prism_node.prism_node_kind_str(rc[ri]) != root_expected_kinds[ri]
            _fail("root.children[" + str(ri) + "] should be " + root_expected_kinds[ri] + ", got " + prism_node.prism_node_kind_str(rc[ri]))
        ri += 1
    print("1. root order (stack -> flow,band,mesh,layer,pane,draw): OK")

    // -- toolbar (Flow): glyph, label, gap in order --
    let tc = prism_node.prism_node_children(rc[0])
    if prism_node.prism_node_kind_str(tc[0]) != "glyph" or prism_node.prism_node_attr_str(tc[0], "icon", "") != "search"
        _fail("toolbar.children[0] should be Glyph(search)")
    if prism_node.prism_node_kind_str(tc[1]) != "label" or prism_node.prism_node_attr_str(tc[1], "text", "") != "Search"
        _fail("toolbar.children[1] should be Label(\"Search\")")
    if prism_node.prism_node_kind_str(tc[2]) != "gap" or not prism_arrange.prism_gap_is_flexible(tc[2])
        _fail("toolbar.children[2] should be a flexible Gap")
    print("2. toolbar (flow containing content) order + attrs: OK")

    // -- row (Band): label, gap(10), label in order --
    let rowc = prism_node.prism_node_children(rc[1])
    if prism_node.prism_node_kind_str(rowc[0]) != "label" or prism_node.prism_node_attr_str(rowc[0], "text", "") != "Left"
        _fail("row.children[0] should be Label(\"Left\")")
    if prism_node.prism_node_kind_str(rowc[1]) != "gap" or prism_arrange.prism_gap_is_flexible(rowc[1]) or prism_arrange.prism_gap_size(rowc[1], -1) != 10
        _fail("row.children[1] should be a fixed Gap(10)")
    if prism_node.prism_node_kind_str(rowc[2]) != "label" or prism_node.prism_node_attr_str(rowc[2], "text", "") != "Right"
        _fail("row.children[2] should be Label(\"Right\")")
    print("3. row (band) order + fixed/flexible gap distinction: OK")

    // -- grid_area (Mesh): 3 labels in order, cols preserved in order with correct kind/size --
    let gac = prism_node.prism_node_children(rc[2])
    let grid_expected_text = ["A", "B", "C"]
    let mut gi = 0
    while gi < 3
        if prism_node.prism_node_kind_str(gac[gi]) != "label" or prism_node.prism_node_attr_str(gac[gi], "text", "") != grid_expected_text[gi]
            _fail("grid_area.children[" + str(gi) + "] should be Label(\"" + grid_expected_text[gi] + "\")")
        gi += 1
    assert_eq(prism_arrange.prism_mesh_col_count(rc[2]), 3)
    assert_eq(prism_node.prism_node_attr_int(rc[2], "col_count", -1), 3)   // same attr, read via the raw prism_node getter directly
    let read_cols = prism_arrange.prism_mesh_cols(rc[2])
    assert_eq(len(read_cols), 3)
    let expected_col_kinds = ["fixed", "fill", "fit"]
    let expected_col_sizes = [100, 0, 0]
    let mut ci = 0
    while ci < 3
        if prism_arrange.prism_mesh_track_kind(read_cols[ci]) != expected_col_kinds[ci]
            _fail("grid_area cols[" + str(ci) + "] kind should be " + expected_col_kinds[ci])
        if prism_arrange.prism_mesh_track_size(read_cols[ci]) != expected_col_sizes[ci]
            _fail("grid_area cols[" + str(ci) + "] size should be " + str(expected_col_sizes[ci]))
        ci += 1
    print("4. grid_area (mesh) child order + cols round-trip (kind+size, in order): OK")

    // -- overlay (Layer): art, label in order --
    let oc = prism_node.prism_node_children(rc[3])
    if prism_node.prism_node_kind_str(oc[0]) != "art" or prism_node.prism_node_attr_str(oc[0], "source", "") != "bg.png"
        _fail("overlay.children[0] should be Art(\"bg.png\")")
    if prism_node.prism_node_kind_str(oc[1]) != "label" or prism_node.prism_node_attr_str(oc[1], "text", "") != "Overlay Text"
        _fail("overlay.children[1] should be Label(\"Overlay Text\")")
    print("5. overlay (layer) order + art source attr: OK")

    // -- viewer (Pane): exactly ONE child (the signature `pane(child)` is singular) --
    assert_eq(prism_node.prism_node_child_count(rc[4]), 1)
    let vc = prism_node.prism_node_children(rc[4])
    if prism_node.prism_node_kind_str(vc[0]) != "label" or prism_node.prism_node_attr_str(vc[0], "text", "") != "Scrollable content"
        _fail("viewer's single child should be Label(\"Scrollable content\")")
    print("6. viewer (pane) exactly-one-child + content attr: OK")

    // -- draw_node: opaque paint callback round-trips and is actually callable --
    assert_eq(prism_node.prism_node_kind_str(rc[5]), "draw")
    let paint_fn = prism_content.prism_draw_paint(rc[5])
    assert_eq(paint_fn(10), 20)
    print("7. draw paint callback round-trip (stored + callable): OK")

    // -- Whole-tree shape sanity via cached depth/count (hand-computed, see header) --
    // toolbar/row/grid_area depth=2 count=4; overlay depth=2 count=3; viewer depth=2 count=2;
    // draw_node depth=1 count=1 -> root depth = 1+max(2,2,2,2,2,1) = 3;
    // root count = 1 + (4+4+4+3+2+1) = 1 + 18 = 19.
    assert_eq(prism_node.prism_node_depth(root), 3)
    assert_eq(prism_node.prism_node_count(root), 19)
    print("8. nested arrangement-containing-content tree: depth=3, count=19 exactly: OK")

    // ── 3(extra). Attribute round-trip via prism_node's typed getters directly ─────────────
    // (Already exercised throughout via the wrappers above; this section hits the three
    // getters -- str/int/bool -- directly on raw PrismNode values, not through a wrapper,
    // to prove the widget layer's attrs dict is genuinely compatible with prism_node.nova's
    // own accessor contract, not just internally self-consistent.)
    assert_eq(prism_node.prism_node_attr_str(label_a, "text", "<missing>"), "A")
    assert_eq(prism_node.prism_node_attr_int(gap_fixed, "size", -1), 10)
    // default_val is deliberately the WRONG answer (true) here -- if this reads back true, that
    // proves the getter is falling through to the default instead of the stored value.
    if prism_node.prism_node_attr_bool(gap_fixed, "flexible", true)
        _fail("gap_fixed's stored 'flexible' attr should read back as false, not the default")
    if prism_node.prism_node_attr_bool(gap_flex, "flexible", false)
        print("3. direct prism_node_attr_str/_int/_bool round-trip (not just via wrappers): OK")
    else
        _fail("gap_flex's stored 'flexible' attr should read back as true")

    // ── 4. Invalid-attr-value rejections (>= 3 required; 6 proven here) ────────────────────
    let bad_mesh_empty = prism_arrange.prism_mesh([], [label_a])
    if is_ok(bad_mesh_empty)
        _fail("mesh with 0 columns should be rejected")
    print("  reject 1/6 -- mesh([]): " + unwrap_err(bad_mesh_empty))

    let bad_mesh_zero = prism_arrange.prism_mesh([prism_arrange.prism_track_fixed(0)], [label_a])
    if is_ok(bad_mesh_zero)
        _fail("mesh with a Fixed(0) column should be rejected")
    print("  reject 2/6 -- mesh([Fixed(0)]): " + unwrap_err(bad_mesh_zero))

    let bad_mesh_neg = prism_arrange.prism_mesh([prism_arrange.prism_track_fixed(-20)], [label_a])
    if is_ok(bad_mesh_neg)
        _fail("mesh with a Fixed(-20) column should be rejected")
    print("  reject 3/6 -- mesh([Fixed(-20)]): " + unwrap_err(bad_mesh_neg))

    let bad_gap = prism_arrange.prism_gap(some(-5))
    if is_ok(bad_gap)
        _fail("gap(some(-5)) should be rejected")
    print("  reject 4/6 -- gap(some(-5)): " + unwrap_err(bad_gap))
    // Boundary check: gap(some(0)) is a LEGITIMATE fixed-zero gap, must succeed (0 >= 0).
    let ok_gap_zero = prism_arrange.prism_gap(some(0))
    if is_err(ok_gap_zero)
        _fail("gap(some(0)) should be accepted (0 is a valid fixed size), got: " + unwrap_err(ok_gap_zero))

    let bad_draw = prism_content.prism_draw("not a function")
    if is_ok(bad_draw)
        _fail("draw(\"not a function\") should be rejected")
    print("  reject 5/6 -- draw(string): " + unwrap_err(bad_draw))

    let bad_art = prism_content.prism_art("")
    if is_ok(bad_art)
        _fail("art(\"\") should be rejected")
    print("  reject 6/6 -- art(\"\"): " + unwrap_err(bad_art))
    print("4. 6 invalid-attr-value constructions correctly rejected (>= 3 required): OK")

    print("KAT prism_widget_a PASSED: all 11 primitives (stack,band,layer,mesh,flow,pane,gap,label,art,glyph,draw) + order + attr round-trip + 6 rejections + depth/count exact")
