// KAT for prism/app/prism_shortcut.nova -- shortcuts + command palette (#67 #99).
//
// The four properties this exists for:
//   1. ★ NORMALISATION MAKES THE DUPLICATE CHECK REAL. Without it, "Shift+Ctrl+K" and
//      "Ctrl+Shift+K" are two chords, so the conflict check is defeated by modifier order --
//      worse than no check, because it looks like it works.
//   2. ★ A CONFLICTING BINDING IS REJECTED AT REGISTRATION, naming the holder. Whichever wins
//      silently leaves the loser dead with nothing in the code looking wrong.
//   3. ★ RESERVED SYSTEM CHORDS ARE REFUSED -- a binding that fights the browser loses
//      unpredictably by platform, so it "works" in testing and fails for a user elsewhere.
//   4. ★ THE PALETTE IS DERIVED, so it cannot disagree with what the keyboard actually does.

import prism_shortcut

let STATS = [0, 0]

fn check(name: string, cond: bool) -> bool
    if cond
        STATS[0] = STATS[0] + 1
        return true
    print("  FAIL  {name}")
    STATS[1] = STATS[1] + 1
    return false

fn main()
    print("== _kat_prism_shortcut ==")

    print("1. ★ chord normalisation")
    check("case is folded", unwrap(prism_shortcut.prism_sc_normalise("Ctrl+K")) == "ctrl+k")
    // THE property: modifier ORDER is canonical, so the duplicate check cannot be defeated.
    check("★ modifier ORDER is canonical", unwrap(prism_shortcut.prism_sc_normalise("Shift+Ctrl+k")) == "ctrl+shift+k")
    check("★ ...and the other spelling agrees", unwrap(prism_shortcut.prism_sc_normalise("ctrl+shift+K")) == unwrap(prism_shortcut.prism_sc_normalise("SHIFT+CTRL+k")))
    check("all four modifiers order ctrl,alt,shift,meta", unwrap(prism_shortcut.prism_sc_normalise("meta+shift+alt+ctrl+p")) == "ctrl+alt+shift+meta+p")
    check("a bare key needs no modifier", unwrap(prism_shortcut.prism_sc_normalise("Escape")) == "escape")
    check("whitespace is trimmed", unwrap(prism_shortcut.prism_sc_normalise(" ctrl + k ")) == "ctrl+k")
    check("empty chord rejected", is_err(prism_shortcut.prism_sc_normalise("")))
    check("non-string chord rejected", is_err(prism_shortcut.prism_sc_normalise(7)))
    check("a doubled '+' is a typo, not a modifier", is_err(prism_shortcut.prism_sc_normalise("ctrl++k")))
    check("modifiers only is rejected", is_err(prism_shortcut.prism_sc_normalise("ctrl+shift")))
    check("two keys in one chord rejected", is_err(prism_shortcut.prism_sc_normalise("ctrl+k+j")))
    check("a repeated modifier rejected", is_err(prism_shortcut.prism_sc_normalise("ctrl+ctrl+k")))

    print("2. binding and validation")
    let r0 = prism_shortcut.prism_sc_registry()
    check("empty registry", prism_shortcut.prism_sc_count(r0) == 0)
    check("empty command id rejected", is_err(prism_shortcut.prism_sc_bind(r0, "ctrl+k", "", "Search")))
    check("empty title rejected -- an unlabelled palette entry is unusable", is_err(prism_shortcut.prism_sc_bind(r0, "ctrl+k", "search", "")))
    check("non-string title rejected", is_err(prism_shortcut.prism_sc_bind(r0, "ctrl+k", "search", 7)))
    let r1 = unwrap(prism_shortcut.prism_sc_bind(r0, "Ctrl+K", "search", "Search everything"))
    check("one bound", prism_shortcut.prism_sc_count(r1) == 1)
    check("the chord is stored NORMALISED", join(prism_shortcut.prism_sc_chords(r1), ",") == "ctrl+k")
    check("the ORIGINAL registry is unchanged (non-mutating)", prism_shortcut.prism_sc_count(r0) == 0)

    print("3. ★ conflicts are rejected, naming the holder")
    // Same chord, different spelling -- must still collide, which is what normalisation buys.
    check("★ a duplicate chord is REFUSED", is_err(prism_shortcut.prism_sc_bind(r1, "ctrl+k", "other", "Other")))
    check("★ ...even spelled differently", is_err(prism_shortcut.prism_sc_bind(r1, "CTRL+K", "other", "Other")))
    check("★ ...and with modifiers reordered", is_err(prism_shortcut.prism_sc_bind(unwrap(prism_shortcut.prism_sc_bind(r0, "ctrl+shift+p", "pal", "Palette")), "shift+ctrl+P", "other", "Other")))
    // One command may not hold two chords, or "what is the shortcut for X" has two answers.
    check("a duplicate COMMAND is refused", is_err(prism_shortcut.prism_sc_bind(r1, "ctrl+j", "search", "Search again")))
    check("a different chord AND command binds fine", prism_shortcut.prism_sc_count(unwrap(prism_shortcut.prism_sc_bind(r1, "ctrl+j", "jump", "Jump to file"))) == 2)

    print("4. ★ reserved system chords are refused")
    check("★ ctrl+w is refused", is_err(prism_shortcut.prism_sc_bind(r0, "ctrl+w", "close", "Close")))
    check("★ ctrl+t is refused", is_err(prism_shortcut.prism_sc_bind(r0, "Ctrl+T", "tab", "New tab")))
    check("★ alt+f4 is refused", is_err(prism_shortcut.prism_sc_bind(r0, "alt+F4", "quit", "Quit")))
    check("★ ...even reordered", is_err(prism_shortcut.prism_sc_bind(r0, "shift+ctrl+w", "x", "X")))
    check("a non-reserved chord is allowed", not is_err(prism_shortcut.prism_sc_bind(r0, "ctrl+k", "search", "Search")))
    check("the reserved list is non-empty and inspectable", len(prism_shortcut.prism_sc_reserved()) >= 8)

    print("5. lookup in both directions")
    let r2 = unwrap(prism_shortcut.prism_sc_bind(r1, "ctrl+j", "jump", "Jump to file"))
    check("chord -> command", unwrap(prism_shortcut.prism_sc_lookup(r2, "ctrl+k")) == "search")
    check("lookup normalises its argument too", unwrap(prism_shortcut.prism_sc_lookup(r2, "CTRL+K")) == "search")
    check("command -> chord", unwrap(prism_shortcut.prism_sc_chord_for(r2, "jump")) == "ctrl+j")
    check("an unbound chord is an err, not an empty string", is_err(prism_shortcut.prism_sc_lookup(r2, "ctrl+z")))
    check("an unbound command is an err", is_err(prism_shortcut.prism_sc_chord_for(r2, "nope")))
    check("unbinding removes it", prism_shortcut.prism_sc_count(unwrap(prism_shortcut.prism_sc_unbind(r2, "ctrl+k"))) == 1)
    check("unbinding something unbound is an err", is_err(prism_shortcut.prism_sc_unbind(r2, "ctrl+z")))
    check("...and the freed chord can be rebound", not is_err(prism_shortcut.prism_sc_bind(unwrap(prism_shortcut.prism_sc_unbind(r2, "ctrl+k")), "ctrl+k", "newthing", "New thing")))

    print("6. ★ the palette is DERIVED from the bindings")
    let pal = prism_shortcut.prism_sc_palette(r2)
    check("the palette has one entry per binding", len(pal) == prism_shortcut.prism_sc_count(r2))
    check("each entry carries its chord", prism_shortcut.prism_sc_cmd_chord(pal[0]) == "ctrl+k")
    check("each entry carries its title", prism_shortcut.prism_sc_cmd_title(pal[0]) == "Search everything")
    check("each entry carries its id", prism_shortcut.prism_sc_cmd_id(pal[0]) == "search")
    // Derived means unbinding removes it from the palette with no separate bookkeeping.
    check("★ unbinding removes it from the palette too", len(prism_shortcut.prism_sc_palette(unwrap(prism_shortcut.prism_sc_unbind(r2, "ctrl+k")))) == 1)

    print("7. search is substring, case-insensitive, stable")
    check("an empty query returns everything", len(prism_shortcut.prism_sc_search(r2, "")) == 2)
    check("matches on TITLE", len(prism_shortcut.prism_sc_search(r2, "everything")) == 1)
    check("matches on COMMAND ID", len(prism_shortcut.prism_sc_search(r2, "jump")) == 1)
    check("case-insensitive", len(prism_shortcut.prism_sc_search(r2, "SEARCH")) == 1)
    check("a substring in the middle matches", len(prism_shortcut.prism_sc_search(r2, "to fil")) == 1)
    check("no match returns empty, not everything", len(prism_shortcut.prism_sc_search(r2, "zzzz")) == 0)
    check("order is stable (first binding first)", prism_shortcut.prism_sc_cmd_id(prism_shortcut.prism_sc_search(r2, "")[0]) == "search")
    check("a non-string query yields nothing rather than everything", len(prism_shortcut.prism_sc_search(r2, 7)) == 0)

    print("8. non-ASCII titles are preserved and findable")
    let rj = unwrap(prism_shortcut.prism_sc_bind(r0, "ctrl+shift+f", "find", "検索する héllo"))
    check("a non-ASCII title round-trips intact", prism_shortcut.prism_sc_cmd_title(prism_shortcut.prism_sc_palette(rj)[0]) == "検索する héllo")
    check("...and is findable by a non-ASCII substring", len(prism_shortcut.prism_sc_search(rj, "検索")) == 1)

    print("")
    if STATS[1] == 0
        print("_kat_prism_shortcut: ALL PASS ({STATS[0]} passed)")
    else
        print("_kat_prism_shortcut: {STATS[1]} FAILURE(S), {STATS[0]} passed")
        exit(1)
