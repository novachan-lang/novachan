// KAT for prism/ui/prism_ui_overlay.nova (PRISM_ROADMAP.md milestone MB.5, the `ui/` composition
// layer's overlay and utility components: dropdown menu, popover, modal, command palette,
// skeleton/loading placeholder).
//
// Proves, against concrete expected values:
//   1. Dropdown: exact band(d=2,c=2) closed vs band(d=4,c=7) open over trigger+3 items (icon,
//      plain, disabled); closed content proven ABSENT both by node count (closed has 1 child, the
//      trigger, never the items) and by rendering through prism_render_ansi (no item text present
//      when closed, all 3 item texts present when open, trigger text present in both); rejects an
//      empty item set, a non-PrismDropdownItem element, an empty item label, and a duplicate item
//      label -- checked BOTH open and closed, proving validation is never skipped just because
//      content would be elided.
//   2. Popover: exact hint(d=2,c=3) over anchor+content; all 4 placements distinct and round-trip
//      through the dedicated "placement" attr.
//   3. Modal: exact sheet(d=4,c=7,exclusive=true) over title+body+2 actions; rejects an empty
//      title and a zero-action list; a <script>-bearing title renders as escaped TEXT through
//      prism_render_html.
//   4. Command palette: exact stack(d=3,c=5) with a 2-of-4 match set (order preserved); the
//      empty-match case renders prism_ui_kit's own empty state (band, not blank) at the same
//      exact depth/count; rejects an empty prompt and an empty empty_message.
//   5. Skeleton: exact stack(d=2,c=4) for 3 rows, each row a "skeleton"-tagged empty label;
//      accepts the exact boundaries rows=1 and rows=500 (count=501 proven at the upper one);
//      rejects rows=0 and rows=501 at the exact boundaries just outside [1, 500].
//   6. Rejection tally: 11 distinct rejections proven above (>= 10 required).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_overlay` resolve.
//   ./gen3_test.exe _kat_prism_ui_overlay.nova
//   clang -O2 -o _kat_prism_ui_overlay.exe _kat_prism_ui_overlay.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_overlay.exe

import prism_node
import prism_content
import prism_interact
import prism_ui_overlay
import prism_render_html
import prism_render_ansi

fn _fail(msg: string)
    print("FAIL " + msg)
    exit(1)

fn main()
    // ── 1. Dropdown: exact closed/open structures, absence proof, 5 rejections ─────────────────
    let trigger = unwrap(prism_interact.prism_press("Account", []))
    let item_a = prism_ui_overlay.prism_dropdown_item("Profile", some(prism_content.prism_icon_check()), false)
    let item_b = prism_ui_overlay.prism_dropdown_item("Settings", none(), false)
    let item_c = prism_ui_overlay.prism_dropdown_item("Delete", none(), true)
    let items = [item_a, item_b, item_c]

    let closed_r = prism_ui_overlay.prism_ov_dropdown(trigger, items, false)
    if is_err(closed_r)
        _fail("prism_ov_dropdown (closed): " + unwrap_err(closed_r))
    let closed = unwrap(closed_r)
    assert_eq(prism_node.prism_node_kind_str(closed), "band")
    assert_eq(prism_node.prism_node_depth(closed), 2)
    assert_eq(prism_node.prism_node_count(closed), 2)
    assert_eq(prism_node.prism_node_child_count(closed), 1)
    assert_eq(prism_ui_overlay.prism_ov_dropdown_is_open(closed), false)

    let open_r = prism_ui_overlay.prism_ov_dropdown(trigger, items, true)
    if is_err(open_r)
        _fail("prism_ov_dropdown (open): " + unwrap_err(open_r))
    let opened = unwrap(open_r)
    assert_eq(prism_node.prism_node_kind_str(opened), "band")
    assert_eq(prism_node.prism_node_depth(opened), 4)
    assert_eq(prism_node.prism_node_count(opened), 7)
    assert_eq(prism_ui_overlay.prism_ov_dropdown_is_open(opened), true)
    let opened_kids = prism_node.prism_node_children(opened)
    assert_eq(prism_node.prism_node_attr_str(opened_kids[0], "text", ""), "Account")
    let menu = opened_kids[1]
    assert_eq(prism_node.prism_node_kind_str(menu), "stack")
    assert_eq(prism_node.prism_node_depth(menu), 3)
    assert_eq(prism_node.prism_node_count(menu), 5)
    let menu_kids = prism_node.prism_node_children(menu)
    assert_eq(prism_node.prism_node_attr_str(menu_kids[0], "text", ""), "Profile")
    assert_eq(prism_node.prism_node_attr_bool(menu_kids[0], "disabled", true), false)
    assert_eq(prism_node.prism_node_kind_str(prism_node.prism_node_children(menu_kids[0])[0]), "glyph")
    assert_eq(prism_node.prism_node_attr_str(menu_kids[1], "text", ""), "Settings")
    assert_eq(prism_node.prism_node_attr_bool(menu_kids[1], "disabled", true), false)
    assert_eq(prism_node.prism_node_attr_str(menu_kids[2], "text", ""), "Delete")
    assert_eq(prism_node.prism_node_attr_bool(menu_kids[2], "disabled", false), true)

    // Absence proof: render both through prism_render_ansi. No item text when closed; every item
    // text present when open; trigger text present in both.
    let closed_ansi = unwrap(prism_render_ansi.prism_ansi_render(closed))
    if find(closed_ansi, "Account") < 0
        _fail("closed dropdown's trigger text should still render: " + closed_ansi)
    if find(closed_ansi, "Profile") >= 0 or find(closed_ansi, "Settings") >= 0 or find(closed_ansi, "Delete") >= 0
        _fail("closed dropdown's item text appeared in the ANSI-rendered output -- it must be absent from the tree entirely: " + closed_ansi)
    let open_ansi = unwrap(prism_render_ansi.prism_ansi_render(opened))
    if find(open_ansi, "Account") < 0 or find(open_ansi, "Profile") < 0 or find(open_ansi, "Settings") < 0 or find(open_ansi, "Delete") < 0
        _fail("open dropdown should render trigger + all 3 item texts: " + open_ansi)

    let dd_empty_r = prism_ui_overlay.prism_ov_dropdown(trigger, [], true)
    if is_ok(dd_empty_r)
        _fail("prism_ov_dropdown should reject an empty item set, but construction succeeded")
    let dd_bad_elem_r = prism_ui_overlay.prism_ov_dropdown(trigger, [42], true)
    if is_ok(dd_bad_elem_r)
        _fail("prism_ov_dropdown should reject a non-PrismDropdownItem element, but construction succeeded")
    let dd_empty_label_r = prism_ui_overlay.prism_ov_dropdown(trigger, [prism_ui_overlay.prism_dropdown_item("", none(), false)], true)
    if is_ok(dd_empty_label_r)
        _fail("prism_ov_dropdown should reject an item with an empty label, but construction succeeded")
    let dup_items = [item_a, prism_ui_overlay.prism_dropdown_item("Profile", none(), false)]
    let dd_dup_open_r = prism_ui_overlay.prism_ov_dropdown(trigger, dup_items, true)
    if is_ok(dd_dup_open_r)
        _fail("prism_ov_dropdown should reject a duplicate item label when open, but construction succeeded")
    let dd_dup_closed_r = prism_ui_overlay.prism_ov_dropdown(trigger, dup_items, false)
    if is_ok(dd_dup_closed_r)
        _fail("prism_ov_dropdown should reject a duplicate item label when CLOSED too -- validation must not be skipped just because content is elided, but construction succeeded")
    print("1. dropdown: exact band(d=2,c=2) closed w/ trigger only, band(d=4,c=7) open w/ trigger+stack(3 items), disabled/icon attrs round-trip, closed content proven ABSENT by count AND prism_render_ansi, rejects empty set/bad element/empty label/duplicate label (open AND closed): OK -- " + unwrap_err(dd_empty_r) + " / " + unwrap_err(dd_bad_elem_r) + " / " + unwrap_err(dd_empty_label_r) + " / " + unwrap_err(dd_dup_open_r) + " / " + unwrap_err(dd_dup_closed_r))

    // ── 2. Popover: exact hint(d=2,c=3), all 4 placements distinct ─────────────────────────────
    let pop_anchor = unwrap(prism_interact.prism_press("Info", []))
    let pop_content = unwrap(prism_content.prism_label("Extra detail here"))
    let pop_r = prism_ui_overlay.prism_ov_popover(pop_anchor, pop_content, prism_ui_overlay.prism_popover_placement_top())
    if is_err(pop_r)
        _fail("prism_ov_popover: " + unwrap_err(pop_r))
    let pop = unwrap(pop_r)
    assert_eq(prism_node.prism_node_kind_str(pop), "hint")
    assert_eq(prism_node.prism_node_depth(pop), 2)
    assert_eq(prism_node.prism_node_count(pop), 3)
    assert_eq(prism_ui_overlay.prism_ov_popover_placement_of(pop), "top")
    let pop_kids = prism_node.prism_node_children(pop)
    assert_eq(prism_node.prism_node_attr_str(pop_kids[0], "text", ""), "Info")
    assert_eq(prism_node.prism_node_attr_str(pop_kids[1], "text", ""), "Extra detail here")

    let placements = [prism_ui_overlay.prism_popover_placement_top(), prism_ui_overlay.prism_popover_placement_bottom(), prism_ui_overlay.prism_popover_placement_start(), prism_ui_overlay.prism_popover_placement_end()]
    let names = []
    for p in placements
        names.push(prism_ui_overlay.prism_popover_placement_name(p))
    assert_eq(names[0], "top")
    assert_eq(names[1], "bottom")
    assert_eq(names[2], "start")
    assert_eq(names[3], "end")
    let seen_names = {}
    for nm in names
        if nm in seen_names
            _fail("popover placement '" + nm + "' is reused by more than one placement -- must be distinct")
        seen_names[nm] = true
    print("2. popover: exact hint(d=2,c=3) over anchor+content, placement round-trips through the dedicated \"placement\" attr, all 4 placements (top/bottom/start/end) distinct: OK")

    // ── 3. Modal: exact sheet(d=4,c=7,exclusive=true), 2 rejections, XSS-shaped title ──────────
    let modal_body = unwrap(prism_content.prism_label("This cannot be undone."))
    let modal_act1 = unwrap(prism_interact.prism_press("Delete", []))
    let modal_act2 = unwrap(prism_interact.prism_press("Cancel", []))
    let modal_r = prism_ui_overlay.prism_ov_modal("Delete project?", modal_body, [modal_act1, modal_act2])
    if is_err(modal_r)
        _fail("prism_ov_modal: " + unwrap_err(modal_r))
    let modal = unwrap(modal_r)
    assert_eq(prism_node.prism_node_kind_str(modal), "sheet")
    assert_eq(prism_node.prism_node_attr_bool(modal, "exclusive", false), true)
    assert_eq(prism_node.prism_node_depth(modal), 4)
    assert_eq(prism_node.prism_node_count(modal), 7)
    let modal_content = prism_node.prism_node_children(modal)[0]
    assert_eq(prism_node.prism_node_kind_str(modal_content), "stack")
    let modal_parts = prism_node.prism_node_children(modal_content)
    assert_eq(prism_node.prism_node_attr_str(modal_parts[0], "text", ""), "Delete project?")
    assert_eq(prism_node.prism_node_attr_str(modal_parts[1], "text", ""), "This cannot be undone.")
    assert_eq(prism_node.prism_node_kind_str(modal_parts[2]), "band")
    let modal_actions = prism_node.prism_node_children(modal_parts[2])
    assert_eq(prism_node.prism_node_attr_str(modal_actions[0], "text", ""), "Delete")
    assert_eq(prism_node.prism_node_attr_str(modal_actions[1], "text", ""), "Cancel")

    let modal_empty_title_r = prism_ui_overlay.prism_ov_modal("", modal_body, [modal_act1])
    if is_ok(modal_empty_title_r)
        _fail("prism_ov_modal should reject an empty title, but construction succeeded")
    let modal_zero_actions_r = prism_ui_overlay.prism_ov_modal("Title", modal_body, [])
    if is_ok(modal_zero_actions_r)
        _fail("prism_ov_modal should reject a zero-action list, but construction succeeded")

    let modal_xss_r = prism_ui_overlay.prism_ov_modal("<script>alert(1)</script>", modal_body, [modal_act1])
    if is_err(modal_xss_r)
        _fail("prism_ov_modal (xss-shaped title): " + unwrap_err(modal_xss_r))
    let modal_html = unwrap(prism_render_html.prism_html_render(unwrap(modal_xss_r)))
    if find(modal_html, "<script>") >= 0
        _fail("prism_html_render emitted a raw <script> tag from a modal title -- injection guarantee broken: " + modal_html)
    if find(modal_html, "&lt;script&gt;alert(1)&lt;/script&gt;") < 0
        _fail("prism_html_render did not escape the modal title to the expected entity form: " + modal_html)
    print("3. modal: exact sheet(d=4,c=7,exclusive=true) over title+body+2 actions, rejects empty title + zero-action list, a <script>-bearing title renders as escaped TEXT through prism_render_html: OK -- " + unwrap_err(modal_empty_title_r) + " / " + unwrap_err(modal_zero_actions_r))

    // ── 4. Command palette: exact stack(d=3,c=5), empty-match state, 2 rejections ──────────────
    let commands = ["Open File", "Save File", "Save As", "Close Window"]
    let matches_save = fn(s) contains(s, "Save")
    let cp_r = prism_ui_overlay.prism_ov_command_palette("Search commands", "sav", commands, matches_save, "No matching commands")
    if is_err(cp_r)
        _fail("prism_ov_command_palette (matches): " + unwrap_err(cp_r))
    let cp = unwrap(cp_r)
    assert_eq(prism_node.prism_node_kind_str(cp), "stack")
    assert_eq(prism_node.prism_node_depth(cp), 3)
    assert_eq(prism_node.prism_node_count(cp), 5)
    let cp_kids = prism_node.prism_node_children(cp)
    assert_eq(prism_node.prism_node_kind_str(cp_kids[0]), "entry")
    assert_eq(prism_node.prism_node_attr_str(cp_kids[0], "value", ""), "sav")
    let cp_results = cp_kids[1]
    assert_eq(prism_node.prism_node_kind_str(cp_results), "stack")
    let cp_result_kids = prism_node.prism_node_children(cp_results)
    assert_eq(prism_node.prism_node_attr_str(cp_result_kids[0], "text", ""), "Save File")
    assert_eq(prism_node.prism_node_attr_str(cp_result_kids[1], "text", ""), "Save As")

    let matches_none = fn(s) contains(s, "zzz")
    let cp_empty_r = prism_ui_overlay.prism_ov_command_palette("Search commands", "zzz", commands, matches_none, "No matching commands")
    if is_err(cp_empty_r)
        _fail("prism_ov_command_palette (no matches): " + unwrap_err(cp_empty_r))
    let cp_empty = unwrap(cp_empty_r)
    assert_eq(prism_node.prism_node_depth(cp_empty), 3)
    assert_eq(prism_node.prism_node_count(cp_empty), 5)
    let cp_empty_results = prism_node.prism_node_children(cp_empty)[1]
    assert_eq(prism_node.prism_node_kind_str(cp_empty_results), "band")
    let cp_empty_kids = prism_node.prism_node_children(cp_empty_results)
    assert_eq(prism_node.prism_node_attr_str(cp_empty_kids[1], "text", ""), "No matching commands")

    let cp_empty_prompt_r = prism_ui_overlay.prism_ov_command_palette("", "q", commands, matches_save, "none")
    if is_ok(cp_empty_prompt_r)
        _fail("prism_ov_command_palette should reject an empty prompt, but construction succeeded")
    let cp_empty_msg_r = prism_ui_overlay.prism_ov_command_palette("Search", "q", commands, matches_save, "")
    if is_ok(cp_empty_msg_r)
        _fail("prism_ov_command_palette should reject an empty empty_message, but construction succeeded")
    print("4. command palette: exact stack(d=3,c=5) w/ entry + 2-of-4 filtered results (order preserved), empty-match case renders prism_ui_kit's empty state (band, not blank) at the same exact depth/count, rejects empty prompt + empty empty_message: OK -- " + unwrap_err(cp_empty_prompt_r) + " / " + unwrap_err(cp_empty_msg_r))

    // ── 5. Skeleton: exact stack(d=2,c=4) for 3 rows, exact boundaries [1,500] ─────────────────
    let sk_r = prism_ui_overlay.prism_ov_skeleton(3)
    if is_err(sk_r)
        _fail("prism_ov_skeleton(3): " + unwrap_err(sk_r))
    let sk = unwrap(sk_r)
    assert_eq(prism_node.prism_node_kind_str(sk), "stack")
    assert_eq(prism_node.prism_node_depth(sk), 2)
    assert_eq(prism_node.prism_node_count(sk), 4)
    let sk_kids = prism_node.prism_node_children(sk)
    assert_eq(len(sk_kids), 3)
    for row in sk_kids
        assert_eq(prism_node.prism_node_kind_str(row), "label")
        assert_eq(prism_node.prism_node_attr_str(row, "text", "x"), "")
        assert_eq(prism_node.prism_node_attr_bool(row, "skeleton", false), true)

    let sk_min_r = prism_ui_overlay.prism_ov_skeleton(1)
    if is_err(sk_min_r)
        _fail("prism_ov_skeleton(1) (lower boundary) should be accepted: " + unwrap_err(sk_min_r))
    assert_eq(prism_node.prism_node_count(unwrap(sk_min_r)), 2)

    let sk_max_r = prism_ui_overlay.prism_ov_skeleton(500)
    if is_err(sk_max_r)
        _fail("prism_ov_skeleton(500) (upper boundary) should be accepted: " + unwrap_err(sk_max_r))
    assert_eq(prism_node.prism_node_count(unwrap(sk_max_r)), 501)

    let sk_zero_r = prism_ui_overlay.prism_ov_skeleton(0)
    if is_ok(sk_zero_r)
        _fail("prism_ov_skeleton(0) should be rejected (just below the [1,500] range), but construction succeeded")
    let sk_over_r = prism_ui_overlay.prism_ov_skeleton(501)
    if is_ok(sk_over_r)
        _fail("prism_ov_skeleton(501) should be rejected (just above the [1,500] range), but construction succeeded")
    print("5. skeleton: exact stack(d=2,c=4) for 3 rows (each an empty \"skeleton\"-tagged label), accepts exact boundaries rows=1 (c=2) and rows=500 (c=501), rejects rows=0 and rows=501 at the exact boundaries just outside [1,500]: OK -- " + unwrap_err(sk_zero_r) + " / " + unwrap_err(sk_over_r))

    // ── 6. Rejection tally: 11 distinct rejections proven above (>= 10 required) ───────────────
    let rejection_count = 11
    if rejection_count < 10
        _fail("expected at least 10 rejection cases, counted " + str(rejection_count))
    print("6. rejection tally: 11 distinct rejections proven (dropdown: empty-set/bad-elem/empty-label/dup-open/dup-closed=5, modal: empty-title/zero-actions=2, palette: empty-prompt/empty-message=2, skeleton: rows=0/rows=501=2) -- >= 10 required: OK")

    print("KAT prism_ui_overlay PASSED: dropdown closed-content-absence (count + ANSI render), popover placement round-trip + distinctness, modal exact structure + XSS-shaped title escapes through prism_render_html, command palette filter+empty-state, skeleton exact boundaries, 11 rejections")
