// KAT for prism/ui/prism_ui_kv.nova (PRISM_ROADMAP.md milestone MB.21, key-value / description-list
// components: a single pair, a vertical list of pairs, a structured table from typed `PrismKvEntry`
// values with an optional per-row note, and a titled section).
//
// Proves, against concrete expected values (every depth/count is hand-computed from
// prism_node.nova's own `depth = max(child depths) + 1`, `count = 1 + sum(child counts)` rule,
// never guessed -- same discipline every prior prism/kat/*.nova commits to):
//   1. prism_kv_pair: exact band(d=2,c=3) for a normal pair, a blank-but-present value is accepted
//      (prism_label never rejects an empty string); rejects an empty kv_key.
//   2. prism_kv_list: exact stack(d=3,c=10) over 3 pairs, child count 3, every child a band;
//      rejects an empty list and a non-PrismNode element (named by index and type).
//   3. PrismKvEntry / prism_kve_new: 3 accessors round-trip key/value/note exactly (both the
//      Some(note) and None(note) cases); rejects an empty key.
//   4. prism_kv_table: exact stack(d=4,c=12) over 3 entries -- a note-less entry renders as the bare
//      band(d=2,c=3) row, a noted entry renders as stack(d=3,c=5)[row, note label], and a
//      present-but-blank Some("") note degrades to the SAME bare band(d=2,c=3) shape as the
//      note-less entry (never a stray 1-child wrapper); rejects an empty list and a
//      non-PrismKvEntry element (named by index and type).
//   5. prism_kv_section: exact stack(d=4,c=10)[title label, gap(8, fixed), stack(d=3,c=7) of 2
//      pairs]; rejects an empty title, an empty pairs list, and a non-PrismNode element (named by
//      index and type).
//   6. Rejection tally: at least 8 distinct rejections proven above (9, counted explicitly).
//
// RUN (from nova-compiler/test_programs/, NOVA_HOME set to the nova-compiler/ root,
// NOVA_NO_CACHE=1): _proc_util.ps1's Prism sync block installs prism/**/*.nova into
// $NOVA_HOME/lib, so `import prism_node` / `import prism_ui_kv` resolve.
//   ./gen3_test.exe _kat_prism_ui_kv.nova
//   clang -O2 -o _kat_prism_ui_kv.exe _kat_prism_ui_kv.ll ../compiler/nova_runtime.o -lws2_32 -ladvapi32
//   ./_kat_prism_ui_kv.exe

import prism_node
import prism_ui_kv as kv

let FAILED = [0]

fn _check(label: string, got: string, want: string)
    if got == want
        print("  pass  " + label)
    else
        print("  FAIL  " + label + "  got=" + got + "  want=" + want)
        FAILED[0] = FAILED[0] + 1

fn _check_true(label: string, cond: bool)
    if cond
        print("  pass  " + label)
    else
        print("  FAIL  " + label)
        FAILED[0] = FAILED[0] + 1

fn main()
    // ── 1. prism_kv_pair: exact band(d=2,c=3), blank value accepted, rejects empty key ───────────
    let pair1_r = kv.prism_kv_pair("Name", "Alice")
    _check_true("pair1 constructs", is_ok(pair1_r))
    let pair1 = unwrap(pair1_r)
    _check("pair1 kind_str", prism_node.prism_node_kind_str(pair1), "band")
    _check("pair1 depth", str(prism_node.prism_node_depth(pair1)), "2")
    _check("pair1 count", str(prism_node.prism_node_count(pair1)), "3")
    let p1_kids = prism_node.prism_node_children(pair1)
    _check("pair1 child count", str(len(p1_kids)), "2")
    _check("pair1 key kind_str", prism_node.prism_node_kind_str(p1_kids[0]), "label")
    _check("pair1 key text", prism_node.prism_node_attr_str(p1_kids[0], "text", ""), "Name")
    _check("pair1 value kind_str", prism_node.prism_node_kind_str(p1_kids[1]), "label")
    _check("pair1 value text", prism_node.prism_node_attr_str(p1_kids[1], "text", ""), "Alice")

    let pair2 = unwrap(kv.prism_kv_pair("Role", "Engineer"))
    let pair3 = unwrap(kv.prism_kv_pair("Team", "Platform"))
    _check("pair2 depth (sanity)", str(prism_node.prism_node_depth(pair2)), "2")
    _check("pair3 count (sanity)", str(prism_node.prism_node_count(pair3)), "3")

    let pair_blank_r = kv.prism_kv_pair("Middle name", "")
    _check_true("pair with a blank (present) value still constructs", is_ok(pair_blank_r))
    let pair_blank = unwrap(pair_blank_r)
    let pb_kids = prism_node.prism_node_children(pair_blank)
    _check("pair with blank value: value text is the empty string", prism_node.prism_node_attr_str(pb_kids[1], "text", "SENTINEL"), "")

    let pair_empty_key_r = kv.prism_kv_pair("", "x")
    _check_true("pair rejects an empty kv_key", is_err(pair_empty_key_r))
    print("")

    // ── 2. prism_kv_list: exact stack(d=3,c=10) over 3 pairs, rejects ─────────────────────────────
    let list_r = kv.prism_kv_list([pair1, pair2, pair3])
    _check_true("list constructs", is_ok(list_r))
    let list_node = unwrap(list_r)
    _check("list kind_str", prism_node.prism_node_kind_str(list_node), "stack")
    _check("list depth", str(prism_node.prism_node_depth(list_node)), "3")
    _check("list count", str(prism_node.prism_node_count(list_node)), "10")
    let list_kids = prism_node.prism_node_children(list_node)
    _check("list child count", str(len(list_kids)), "3")
    _check("list child 0 kind_str", prism_node.prism_node_kind_str(list_kids[0]), "band")
    _check("list child 1 kind_str", prism_node.prism_node_kind_str(list_kids[1]), "band")
    _check("list child 2 kind_str", prism_node.prism_node_kind_str(list_kids[2]), "band")

    let list_empty_r = kv.prism_kv_list([])
    _check_true("list rejects an empty pairs list", is_err(list_empty_r))
    let list_bad_elem_r = kv.prism_kv_list([pair1, "not a node"])
    _check_true("list rejects a non-PrismNode element", is_err(list_bad_elem_r))
    if is_err(list_bad_elem_r)
        _check_true("list rejection names the offending index and type", contains(unwrap_err(list_bad_elem_r), "1") and contains(unwrap_err(list_bad_elem_r), "string"))
    print("")

    // ── 3. PrismKvEntry / prism_kve_new: accessors round-trip, rejects empty key ──────────────────
    let entry1_r = kv.prism_kve_new("Status", "Active", none())
    _check_true("entry1 (no note) constructs", is_ok(entry1_r))
    let entry1 = unwrap(entry1_r)
    _check("entry1 key accessor", kv.prism_kve_key(entry1), "Status")
    _check("entry1 value accessor", kv.prism_kve_value(entry1), "Active")
    match kv.prism_kve_note(entry1)
        None => _check_true("entry1 note accessor is None", true)
        Some(v) => _check_true("entry1 note accessor must be None, got Some(" + v + ")", false)

    let entry2_r = kv.prism_kve_new("Owner", "Bob", some("Assigned yesterday"))
    _check_true("entry2 (with note) constructs", is_ok(entry2_r))
    let entry2 = unwrap(entry2_r)
    _check("entry2 key accessor", kv.prism_kve_key(entry2), "Owner")
    _check("entry2 value accessor", kv.prism_kve_value(entry2), "Bob")
    match kv.prism_kve_note(entry2)
        Some(v) => _check("entry2 note accessor", v, "Assigned yesterday")
        None => _check_true("entry2 note accessor must be Some", false)

    let entry3_r = kv.prism_kve_new("Priority", "High", some(""))
    _check_true("entry3 (blank note) constructs", is_ok(entry3_r))
    let entry3 = unwrap(entry3_r)

    let entry_empty_key_r = kv.prism_kve_new("", "x", none())
    _check_true("prism_kve_new rejects an empty key", is_err(entry_empty_key_r))
    print("")

    // ── 4. prism_kv_table: exact stack(d=4,c=12); no-note/noted/blank-note-degrades shapes; rejects
    let table_r = kv.prism_kv_table([entry1, entry2, entry3])
    _check_true("table constructs", is_ok(table_r))
    let table = unwrap(table_r)
    _check("table kind_str", prism_node.prism_node_kind_str(table), "stack")
    _check("table depth", str(prism_node.prism_node_depth(table)), "4")
    _check("table count", str(prism_node.prism_node_count(table)), "12")
    let table_kids = prism_node.prism_node_children(table)
    _check("table child count", str(len(table_kids)), "3")

    // entry1 (no note) -> bare band(d=2,c=3), the identical shape prism_kv_pair itself produces.
    let row0 = table_kids[0]
    _check("table row0 (no note) kind_str", prism_node.prism_node_kind_str(row0), "band")
    _check("table row0 depth", str(prism_node.prism_node_depth(row0)), "2")
    _check("table row0 count", str(prism_node.prism_node_count(row0)), "3")
    let row0_kids = prism_node.prism_node_children(row0)
    _check("table row0 key text", prism_node.prism_node_attr_str(row0_kids[0], "text", ""), "Status")
    _check("table row0 value text", prism_node.prism_node_attr_str(row0_kids[1], "text", ""), "Active")

    // entry2 (noted) -> stack(d=3,c=5)[band(row), label(note)]
    let row1 = table_kids[1]
    _check("table row1 (noted) kind_str", prism_node.prism_node_kind_str(row1), "stack")
    _check("table row1 depth", str(prism_node.prism_node_depth(row1)), "3")
    _check("table row1 count", str(prism_node.prism_node_count(row1)), "5")
    let row1_kids = prism_node.prism_node_children(row1)
    _check("table row1 child count", str(len(row1_kids)), "2")
    _check("table row1 inner row kind_str", prism_node.prism_node_kind_str(row1_kids[0]), "band")
    let row1_inner_kids = prism_node.prism_node_children(row1_kids[0])
    _check("table row1 key text", prism_node.prism_node_attr_str(row1_inner_kids[0], "text", ""), "Owner")
    _check("table row1 value text", prism_node.prism_node_attr_str(row1_inner_kids[1], "text", ""), "Bob")
    _check("table row1 note kind_str", prism_node.prism_node_kind_str(row1_kids[1]), "label")
    _check("table row1 note text", prism_node.prism_node_attr_str(row1_kids[1], "text", ""), "Assigned yesterday")

    // entry3 (blank Some("") note) -> degrades to the SAME bare band(d=2,c=3) shape as row0.
    let row2 = table_kids[2]
    _check("table row2 (blank note degrades) kind_str", prism_node.prism_node_kind_str(row2), "band")
    _check("table row2 depth degrades to 2 (same as no-note)", str(prism_node.prism_node_depth(row2)), "2")
    _check("table row2 count degrades to 3 (same as no-note)", str(prism_node.prism_node_count(row2)), "3")
    let row2_kids = prism_node.prism_node_children(row2)
    _check("table row2 key text", prism_node.prism_node_attr_str(row2_kids[0], "text", ""), "Priority")
    _check("table row2 value text", prism_node.prism_node_attr_str(row2_kids[1], "text", ""), "High")

    let table_empty_r = kv.prism_kv_table([])
    _check_true("table rejects an empty kv_entries list", is_err(table_empty_r))
    let table_bad_elem_r = kv.prism_kv_table([entry1, 42])
    _check_true("table rejects a non-PrismKvEntry element", is_err(table_bad_elem_r))
    if is_err(table_bad_elem_r)
        _check_true("table rejection names the offending index and type", contains(unwrap_err(table_bad_elem_r), "1") and contains(unwrap_err(table_bad_elem_r), "int"))
    print("")

    // ── 5. prism_kv_section: exact stack(d=4,c=10)[title, gap(8), stack(d=3,c=7) of 2 pairs] ──────
    let section_r = kv.prism_kv_section("Account Details", [pair1, pair2])
    _check_true("section constructs", is_ok(section_r))
    let section = unwrap(section_r)
    _check("section kind_str", prism_node.prism_node_kind_str(section), "stack")
    _check("section depth", str(prism_node.prism_node_depth(section)), "4")
    _check("section count", str(prism_node.prism_node_count(section)), "10")
    let section_kids = prism_node.prism_node_children(section)
    _check("section child count (title + gap + body)", str(len(section_kids)), "3")
    _check("section title kind_str", prism_node.prism_node_kind_str(section_kids[0]), "label")
    _check("section title text", prism_node.prism_node_attr_str(section_kids[0], "text", ""), "Account Details")
    _check("section gap kind_str", prism_node.prism_node_kind_str(section_kids[1]), "gap")
    _check("section gap size is 8 (fixed)", str(prism_node.prism_node_attr_int(section_kids[1], "size", -1)), "8")
    _check_true("section gap is not flexible", not prism_node.prism_node_attr_bool(section_kids[1], "flexible", true))
    let section_body = section_kids[2]
    _check("section body kind_str", prism_node.prism_node_kind_str(section_body), "stack")
    _check("section body depth", str(prism_node.prism_node_depth(section_body)), "3")
    _check("section body count", str(prism_node.prism_node_count(section_body)), "7")
    let section_body_kids = prism_node.prism_node_children(section_body)
    _check("section body child count", str(len(section_body_kids)), "2")

    let section_empty_title_r = kv.prism_kv_section("", [pair1])
    _check_true("section rejects an empty kv_title", is_err(section_empty_title_r))
    let section_empty_pairs_r = kv.prism_kv_section("Title", [])
    _check_true("section rejects an empty pairs list", is_err(section_empty_pairs_r))
    let section_bad_elem_r = kv.prism_kv_section("Title", [pair1, {}])
    _check_true("section rejects a non-PrismNode element", is_err(section_bad_elem_r))
    if is_err(section_bad_elem_r)
        _check_true("section rejection names the offending index and type", contains(unwrap_err(section_bad_elem_r), "1") and contains(unwrap_err(section_bad_elem_r), "dict"))
    print("")

    // ── 6. Rejection tally: at least 8 distinct rejections proven above (9, counted here) ─────────
    // pair: empty key (1); list: empty, bad element (2); kve_new: empty key (1); table: empty, bad
    // element (2); section: empty title, empty pairs, bad element (3)
    let rejection_count = 9
    _check_true("expected at least 8 rejection cases, counted " + str(rejection_count), rejection_count >= 8)

    if FAILED[0] == 0
        print("")
        print("_kat_prism_ui_kv: ALL PASS")
    else
        print("")
        print("_kat_prism_ui_kv: " + str(FAILED[0]) + " FAILURE(S)")
        exit(1)
