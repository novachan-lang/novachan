// NOVA PRISM — ANSI/terminal backend (framework #5 per FRAMEWORK_ECOSYSTEM_STRATEGY.md).
//
// RELOCATED 2026-08-15 (PRISM_ROADMAP.md milestone MA.1) from
// `nova-compiler/test_programs/prism.nova`, where it shipped as v0.1 (140 lines, commit
// bccc2fd). This is a PURE relocation + rename, not a rewrite -- behaviour is unchanged;
// every public function gained a `prism_ansi_` prefix (private helpers too) to eliminate
// collision risk in NOVA's flat, cross-module top-level symbol space (see forge_html.nova's
// header on the `text`/`forge.text` collision, and PRISM_STATUS.md's "folders are for
// humans, prefixes are for the linker").
//
// v0.1 shipped text-mode (ANSI escape) helpers because the target machine had no wgpu/Vulkan
// SDK installed. Per the 2026-08-14 architecture revision (PRISM_STATUS.md), this ANSI
// backend is now understood as a genuinely real FOURTH target (CLI/TUI tools), alongside the
// DOM backend (web) and the GPU backend (native desktop/mobile) -- not a stand-in for either.
// The API shape stays consistent with those: build a frame string, write it to the screen.
//
// ── 2026-09-05: `prism_ansi_table` COLUMN SIZING FIXED TO USE DISPLAY WIDTH ─────────────────────
// `prism_ansi_table` used to size/pad columns with `len()` -- a BYTE count, not a terminal column
// count (see prism_text.nova's header for the proof that `len()` is byte-oriented in this runtime).
// A 3-byte CJK character has `len() == 3` but renders as 2 terminal cells, so any table mixing
// ASCII and CJK content came out misaligned in a real terminal even though the string itself was
// byte-exact. `prism_text.nova` (Milestone MB.10) already exists as the one place in this codebase
// that owns monospace-cell measurement (`prism_text_width`) and cell-aware padding
// (`prism_text_pad_left/right/center`) -- this module now imports it rather than re-deriving a
// second, inevitably-divergent width function. NOT `std/text/wcwidth.nova`'s `ww_string_width`:
// that function is ALSO byte-wise (it walks bytes and charges every byte > 127 as width 1, so a
// 3-byte CJK character reports width 3, not 2) -- using it here would just move the same bug to a
// different file. `prism_text_pad_left/right/center` return `Result<string>` (a negative width is a
// caller error), but every function in this module returns a plain `string` -- there is no `Result`
// anywhere in `prism_ansi`'s public API, and widening `prism_ansi_table`'s signature to `Result`
// would ripple to every caller for no benefit. `_prism_ansi_pad_right` below is the seam: it calls
// `prism_text.prism_text_pad_right` and unwraps it, falling back to the unpadded string on `Err`.
// That path is UNREACHABLE in practice -- `_prism_ansi_pad_right` is only ever called with
// `widths[i] + 2`, and `widths[i]` is built by `_prism_ansi_max_int` starting from a `prism_text_width`
// result, so it is always >= 0 and the padded width is always >= 2 -- but a defensive fallback costs
// nothing and keeps a plain-string API from ever being able to crash on a `Result` it doesn't speak.
//
// Public API:
//   prism_ansi_clear()              -> ANSI "clear screen + home" sequence
//   prism_ansi_move(x, y)           -> ANSI cursor-to-position
//   prism_ansi_color_fg(r, g, b)    -> 24-bit foreground color escape
//   prism_ansi_color_bg(r, g, b)    -> 24-bit background color escape
//   prism_ansi_reset()              -> reset all attributes
//   prism_ansi_box(w, h)            -> ASCII-art box (w x h) as a string
//   prism_ansi_table(headers, rows) -> simple aligned table render
//   prism_ansi_hline(w, ch)         -> horizontal line of width w using ch
//   prism_ansi_vline(h, ch)         -> vertical line of height h using ch
//   prism_ansi_progress_bar(pct, w) -> "[#####-----] 50%"-style progress bar
//   prism_ansi_spinner(i)           -> spinner frame at index i (|, /, -, \)
//   prism_ansi_bold/italic/underline(s) -> ANSI SGR-wrapped text
//   prism_ansi_link(url, label)     -> OSC 8 terminal hyperlink

import prism_text

fn _prism_ansi_esc() -> string
    chr(27) + "["

fn prism_ansi_clear() -> string
    _prism_ansi_esc() + "2J" + _prism_ansi_esc() + "H"

fn prism_ansi_move(x: int, y: int) -> string
    _prism_ansi_esc() + str(y) + ";" + str(x) + "H"

fn prism_ansi_color_fg(r: int, g: int, b: int) -> string
    _prism_ansi_esc() + "38;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m"

fn prism_ansi_color_bg(r: int, g: int, b: int) -> string
    _prism_ansi_esc() + "48;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m"

fn prism_ansi_reset() -> string
    _prism_ansi_esc() + "0m"

fn _prism_ansi_repeat_char(c: string, n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + c
        i = i + 1
    out

fn prism_ansi_box(w: int, h: int) -> string
    let top = "+" + _prism_ansi_repeat_char("-", w - 2) + "+\n"
    let middle = "|" + _prism_ansi_repeat_char(" ", w - 2) + "|\n"
    let out = top
    let i = 1
    while i < h - 1
        out = out + middle
        i = i + 1
    out = out + "+" + _prism_ansi_repeat_char("-", w - 2) + "+\n"
    out

fn _prism_ansi_max_int(a: int, b: int) -> int
    if a > b
        return a
    b

// Pad `s` on the right to `width` DISPLAY CELLS (not bytes) via prism_text's cell-aware padder.
// `prism_ansi`'s whole public API is plain `string`, never `Result` -- this is the seam where that
// meets `prism_text_pad_right`'s `Result<string>`. A negative width is the only `Err` case
// `prism_text_pad_right` defines, and every caller here passes `widths[i] + 2` where `widths[i]`
// comes from `prism_text_width` (always >= 0), so `Err` is unreachable in practice; falling back to
// the unpadded string rather than propagating is the safe, crash-free default for that dead path.
fn _prism_ansi_pad_right(s: string, width: int) -> string
    let padded = prism_text.prism_text_pad_right(s, width)
    if is_err(padded)
        return s
    unwrap(padded)

fn prism_ansi_table(headers: list, rows: list) -> string
    let cols = len(headers)
    let widths = []
    let ci = 0
    while ci < cols
        widths.push(prism_text.prism_text_width(headers[ci]))
        ci = ci + 1
    for row in rows
        let i = 0
        while i < cols and i < len(row)
            widths[i] = _prism_ansi_max_int(widths[i], prism_text.prism_text_width(row[i]))
            i = i + 1
    let out = ""
    let i = 0
    while i < cols
        out = out + _prism_ansi_pad_right(headers[i], widths[i] + 2)
        i = i + 1
    out = out + "\n"
    let separator = ""
    let j = 0
    while j < cols
        separator = separator + _prism_ansi_repeat_char("-", widths[j]) + "  "
        j = j + 1
    out = out + separator + "\n"
    for row in rows
        let k = 0
        while k < cols and k < len(row)
            out = out + _prism_ansi_pad_right(row[k], widths[k] + 2)
            k = k + 1
        out = out + "\n"
    out

// ── v0.2 additions ───────────────────────────────────────────────────────

// Horizontal line of given width using the given character.
fn prism_ansi_hline(w: int, ch: string) -> string
    _prism_ansi_repeat_char(ch, w)

// Vertical line of given height (newline-separated).
fn prism_ansi_vline(h: int, ch: string) -> string
    let out = ""
    let i = 0
    while i < h
        out = out + ch + "\n"
        i = i + 1
    out

// Progress bar: [#####-----] 50%.
fn prism_ansi_progress_bar(pct: int, width: int) -> string
    let filled = (pct * width) / 100
    if filled < 0
        filled = 0
    if filled > width
        filled = width
    let out = "["
    out = out + _prism_ansi_repeat_char("#", filled)
    out = out + _prism_ansi_repeat_char("-", width - filled)
    out = out + "] " + str(pct) + "%"
    out

// Spinner frame at index i (rotates through |, /, -, \).
fn prism_ansi_spinner(i: int) -> string
    let frames = ["|", "/", "-", "\\"]
    frames[i % 4]

// Bold/italic/underline wrappers using ANSI SGR.
fn prism_ansi_bold(s: string) -> string
    _prism_ansi_esc() + "1m" + s + _prism_ansi_esc() + "22m"

fn prism_ansi_italic(s: string) -> string
    _prism_ansi_esc() + "3m" + s + _prism_ansi_esc() + "23m"

fn prism_ansi_underline(s: string) -> string
    _prism_ansi_esc() + "4m" + s + _prism_ansi_esc() + "24m"

// Hyperlink (OSC 8). Terminal-emulator dependent; falls back gracefully.
fn prism_ansi_link(url: string, label: string) -> string
    chr(27) + "]8;;" + url + chr(7) + label + chr(27) + "]8;;" + chr(7)
