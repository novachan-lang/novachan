// prism_media (widget/) -- video and audio playback (feature #82).
//
// ── ⛔ A VIDEO WITHOUT CAPTIONS IS UNREPRESENTABLE ───────────────────────────────────────────
// `prism_md_video` REQUIRES a captions track and rejects an empty one. This is the same move
// §10 makes with `by` on `each`/`grid`: the thing everyone forgets becomes a required argument,
// so forgetting is a compile-time-shaped failure rather than an accessibility bug discovered by
// a user who cannot hear. A "captions: optional" API is how every platform ended up with
// uncaptioned video -- the default won, every time.
// Audio takes a TRANSCRIPT for the same reason. Where a caller genuinely has none,
// `prism_md_video_no_captions` exists and says so IN ITS NAME: it is greppable, it shows up in
// review, and the honest escape hatch beats a silent default.
//
// ── ⛔ AUTOPLAY REQUIRES MUTED, AND THAT IS ENFORCED ─────────────────────────────────────────
// Autoplaying sound is hostile: it interrupts, it can be startling, and for a screen-reader user
// it masks the very output they navigate by. Every browser eventually made this a policy after
// years of it being merely rude. `prism_md_autoplay` therefore REFUSES unless the media is muted
// -- the constructor enforces the pair rather than trusting two independent flags to agree.
//
// ── POSITION ARITHMETIC IS INTEGER MILLISECONDS ─────────────────────────────────────────────
// No floats: a scrub bar that lands on 0.9999 of the duration leaves a video permanently one
// frame from its end, and float formatting is platform-sensitive. Same reasoning as
// prism_number, prism_motion and prism_print.
//
// PUBLIC API
//   prism_md_video(src, captions, duration_ms)      -> Result<PrismMedia>
//   prism_md_video_no_captions(src, duration_ms, why) -> Result<PrismMedia>
//   prism_md_audio(src, transcript, duration_ms)    -> Result<PrismMedia>
//   prism_md_kind(m) / _src(m) / _captions(m) / _duration(m) / _position(m) / _state(m)
//   prism_md_muted(m) / _volume(m) / _autoplay(m)
//   prism_md_play(m) / _pause(m) / _seek(m, ms) / _mute(m) / _unmute(m)
//   prism_md_volume_set(m, pct)                     -> Result<PrismMedia>
//   prism_md_autoplay(m)                            -> Result<PrismMedia>   requires muted
//   prism_md_node(m)                                -> Result<PrismNode>

import prism_node
import prism_arrange
import prism_content

// `Md`-prefixed variants: enum constructors resolve across modules in NOVA's flat symbol space.
enum PrismMediaKind
    MdVideo()
    MdAudio()

enum PrismMediaState
    MdIdle()
    MdPlaying()
    MdPaused()
    MdEnded()

// `mm_` prefix: the struct field->slot map is GLOBAL.
type PrismMedia
    mm_kind: PrismMediaKind
    mm_src: string
    mm_captions: string     // captions track (video) or transcript (audio); "" only via the
                            // explicitly-named escape hatch
    mm_duration: int        // ms
    mm_position: int        // ms
    mm_state: PrismMediaState
    mm_muted: int           // 0/1, never a bool
    mm_volume: int          // 0..100
    mm_autoplay: int        // 0/1

fn prism_md_kind_name(k: PrismMediaKind) -> string
    match k
        MdVideo() => "video"
        MdAudio() => "audio"

fn prism_md_state_name(s: PrismMediaState) -> string
    match s
        MdIdle() => "idle"
        MdPlaying() => "playing"
        MdPaused() => "paused"
        MdEnded() => "ended"

fn _md_make(kind: PrismMediaKind, src, captions, duration_ms) -> Result<PrismMedia>
    if type_of(src) != "string" or len(src) == 0
        return err("prism_media: source is required and must be a string, got {type_of(src)}")
    if type_of(duration_ms) != "int"
        return err("prism_media: duration must be an int in milliseconds, got {type_of(duration_ms)}")
    if duration_ms < 1
        return err("prism_media: duration must be >= 1 ms, got {duration_ms}")
    ok(PrismMedia(kind, src, captions, duration_ms, 0, MdIdle(), 0, 100, 0))

// ⛔ Captions are REQUIRED. See the header.
fn prism_md_video(src, captions, duration_ms) -> Result<PrismMedia>
    if type_of(captions) != "string" or len(captions) == 0
        return err("prism_media: a video REQUIRES a captions track. If you genuinely have none, call prism_md_video_no_captions and say why -- that name is greppable and shows up in review, which a silent default never does")
    _md_make(MdVideo(), src, captions, duration_ms)

// The honest escape hatch: named so it cannot hide, and it demands a REASON, which is the thing
// a reviewer actually needs.
fn prism_md_video_no_captions(src, duration_ms, why) -> Result<PrismMedia>
    if type_of(why) != "string" or len(why) == 0
        return err("prism_media: prism_md_video_no_captions requires a stated REASON -- an uncaptioned video with no explanation is indistinguishable from an oversight")
    _md_make(MdVideo(), src, "", duration_ms)

fn prism_md_audio(src, transcript, duration_ms) -> Result<PrismMedia>
    if type_of(transcript) != "string" or len(transcript) == 0
        return err("prism_media: audio REQUIRES a transcript -- it is the only way the content reaches a deaf user at all")
    _md_make(MdAudio(), src, transcript, duration_ms)

fn prism_md_kind(m: PrismMedia) -> PrismMediaKind
    m.mm_kind

fn prism_md_src(m: PrismMedia) -> string
    m.mm_src

fn prism_md_captions(m: PrismMedia) -> string
    m.mm_captions

fn prism_md_duration(m: PrismMedia) -> int
    m.mm_duration

fn prism_md_position(m: PrismMedia) -> int
    m.mm_position

fn prism_md_state(m: PrismMedia) -> PrismMediaState
    m.mm_state

fn prism_md_muted(m: PrismMedia) -> bool
    m.mm_muted == 1

fn prism_md_volume(m: PrismMedia) -> int
    m.mm_volume

fn prism_md_autoplay_on(m: PrismMedia) -> bool
    m.mm_autoplay == 1

fn _md_with(m: PrismMedia, pos: int, state: PrismMediaState, muted: int, vol: int, auto: int) -> PrismMedia
    PrismMedia(m.mm_kind, m.mm_src, m.mm_captions, m.mm_duration, pos, state, muted, vol, auto)

fn prism_md_play(m: PrismMedia) -> PrismMedia
    // Playing from ENDED restarts, which is what a play button does at the end of a video --
    // leaving the position at the end would make the button appear dead.
    if m.mm_position >= m.mm_duration
        return _md_with(m, 0, MdPlaying(), m.mm_muted, m.mm_volume, m.mm_autoplay)
    _md_with(m, m.mm_position, MdPlaying(), m.mm_muted, m.mm_volume, m.mm_autoplay)

fn prism_md_pause(m: PrismMedia) -> PrismMedia
    _md_with(m, m.mm_position, MdPaused(), m.mm_muted, m.mm_volume, m.mm_autoplay)

// Seeking past the end lands EXACTLY on the duration and marks it ended -- not one past, which
// would leave position > duration and make every progress calculation exceed 100%.
fn prism_md_seek(m: PrismMedia, ms) -> Result<PrismMedia>
    if type_of(ms) != "int"
        return err("prism_media: seek position must be an int in milliseconds, got {type_of(ms)}")
    if ms < 0
        return err("prism_media: cannot seek to {ms} -- a negative position has no meaning")
    if ms >= m.mm_duration
        return ok(_md_with(m, m.mm_duration, MdEnded(), m.mm_muted, m.mm_volume, m.mm_autoplay))
    ok(_md_with(m, ms, m.mm_state, m.mm_muted, m.mm_volume, m.mm_autoplay))

fn prism_md_mute(m: PrismMedia) -> PrismMedia
    _md_with(m, m.mm_position, m.mm_state, 1, m.mm_volume, m.mm_autoplay)

// Unmuting CLEARS autoplay: the pair "autoplay + unmuted" is exactly what the enforcement below
// forbids, and letting it be reached by unmuting afterwards would be a hole in the same rule.
fn prism_md_unmute(m: PrismMedia) -> PrismMedia
    _md_with(m, m.mm_position, m.mm_state, 0, m.mm_volume, 0)

fn prism_md_volume_set(m: PrismMedia, pct) -> Result<PrismMedia>
    if type_of(pct) != "int"
        return err("prism_media: volume must be an int percentage, got {type_of(pct)}")
    if pct < 0 or pct > 100
        return err("prism_media: volume {pct} is outside 0..100")
    ok(_md_with(m, m.mm_position, m.mm_state, m.mm_muted, pct, m.mm_autoplay))

// ⛔ Autoplay REQUIRES muted, enforced here rather than trusting two flags to agree.
fn prism_md_autoplay(m: PrismMedia) -> Result<PrismMedia>
    if m.mm_muted == 0
        return err("prism_media: autoplay requires MUTED. Autoplaying sound interrupts, can startle, and for a screen-reader user it masks the output they navigate by -- mute first, or do not autoplay")
    ok(_md_with(m, m.mm_position, m.mm_state, m.mm_muted, m.mm_volume, 1))

// Progress in tenths of a percent (0..1000), integer -- the same scale prism_motion uses, and for
// the same reason: a float here leaves a scrub bar a fraction short of its end.
fn prism_md_progress(m: PrismMedia) -> int
    (m.mm_position * 1000) / m.mm_duration

// Renders from the closed 22-primitive vocabulary (axiom A7): a band of [source label, captions
// indicator]. The captions indicator is part of the RENDERED output, not just metadata, so an
// uncaptioned video is visible as such in any backend.
fn prism_md_node(m: PrismMedia) -> Result<PrismNode>
    let title = prism_content.prism_label(prism_md_kind_name(m.mm_kind))?
    let cap = if len(m.mm_captions) > 0
        prism_content.prism_label("captions")?
    else
        prism_content.prism_label("NO CAPTIONS")?
    prism_arrange.prism_band([title, cap])
