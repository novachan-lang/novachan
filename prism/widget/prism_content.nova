// prism_content -- the 4 CONTENT primitives (PRISM_SPEC.md §8): label, art, glyph, draw.
// Milestone MA.3 part A (paired with prism_arrange.nova). Same rule as that file: this module
// owns nothing about the node-tree shape (prism_node.nova's job), only what each content
// widget's `attrs` legally contain.
//
// ── THE TWO TYPES §8 NAMES THAT DO NOT EXIST YET, AND WHAT WAS DECIDED ───────────────────────
// PRISM_SPEC.md Part III writes `art(source: Image)` and `draw(paint: fn(Surface))`. Neither
// `Image` nor `Surface` is defined ANYWHERE in PRISM_SPEC.md or the rest of the codebase --
// verified by grep, not assumed. Both belong to milestones that do not exist yet (an asset
// loader for `Image`; a GPU backend for `Surface`). Inventing either type's real shape here
// would be scope creep for an "arrangement + content primitives" milestone, and worse, it would
// risk pre-committing the eventual asset-loader/GPU-backend milestone to a shape decided as a
// guess instead of by the people designing those systems. Each is handled on its own merits
// instead of by one blanket rule:
//   `art`'s `source` -- accepted as a plain `string` (a path/URL/resource-key), matching this
//     codebase's existing convention for external-resource references (forge_html's `href:
//     string` on `link()`, `_safe_url`). Validated non-empty. Tracked limitation: once an
//     Image asset type exists, `source` should widen to accept it directly.
//   `draw`'s `paint` -- CANNOT be given the same treatment `PrismMeshTrack` got in
//     prism_arrange.nova (a small closed enum), because it is not a closed enumerable set --
//     it is a callback closure, and NOVA has no `is_fn`/callable-arity introspection and no
//     function-type annotation syntax (verified absent from NOVA_LANGUAGE_FEATURES.md and by
//     probe: `type_of`/`type_name` both report a closure as bare `"struct"`, IDENTICAL to any
//     ordinary struct value -- there is no runtime signal that distinguishes "this is callable"
//     from "this is some other struct"). Guessing a heuristic here would risk exactly the
//     failure CLAUDE.md warns against: either false-rejecting a legitimate closure or
//     false-accepting a non-callable struct. What IS safe and verified (same probe): a closure
//     reliably reports `false` from is_string/is_int/is_float/is_bool/is_list/is_dict, so
//     `prism_draw` rejects those coarse kinds outright (an obviously wrong argument, e.g. a
//     stray string) while accepting anything struct-shaped, which includes every real closure
//     and cannot be narrowed further with today's introspection. `paint` is stored opaquely in
//     `attrs` and is never invoked here -- invocation with a real `Surface` is the eventual GPU
//     backend's job, not this constructor's.
//
// ── DESIGN DECISION: PrismIcon is a real closed enum, not a string ───────────────────────────
// PRISM_SPEC.md is explicit: "Icon from a TYPED icon set" (§8), which is a stronger and more
// literal instruction than `art`/`draw` get, and it matches axiom A7 ("the vocabulary is closed
// and owned") applied to icons specifically. A free-form string would make an invalid icon name
// a RUNTIME surprise; a closed enum makes it a COMPILE error instead -- strictly better than any
// runtime validation this file could write. This is the v1 minimal starter set (12 common,
// uncontroversial icons); extending it is purely additive, following the exact
// enum-tag-plus-exhaustive-match discipline PrismNodeKind (prism_node.nova) and PrismMeshTrack
// (prism_arrange.nova) already established -- add a 13th icon without updating
// `prism_icon_name`'s match, and the compiler rejects the build.
//
// PUBLIC API
//   Icon vocabulary (closed, 12 icons -- v1 minimal set, extend additively)
//     PrismIcon                                              Check() Close() Search() Menu()
//                                                             Plus() Minus() ChevronUp/Down/
//                                                             Left/Right() Warning() Info()
//     prism_icon_check() / _close() / _search() / _menu() / _plus() / _minus() /
//     prism_icon_chevron_up() / _down() / _left() / _right() / _warning() / _info()  cross-module ctors
//     prism_icon_name(icon) -> string    exhaustive: "check" | "close" | ... | "info"
//   Constructors (all `Result<PrismNode>`, bounds-checked via prism_node.nova underneath)
//     prism_label(text: string)     text content; renders as glyphs, never markup (spec A3)
//     prism_art(source: string)     resource reference; rejects an empty source
//     prism_glyph(icon: PrismIcon)  icon from the closed set above -- invalid icons are a
//                                    COMPILE error (wrong constructor call), not a runtime Err
//     prism_draw(paint)             opaque paint callback; rejects an obviously-non-callable
//                                    scalar/collection argument (see header note)
//   Accessors
//     prism_draw_paint(n)  -> the stored paint value, untyped (opaque by design, see header)

import prism_node

// ── Icon vocabulary (PRISM_SPEC.md §8: "Icon from a typed icon set") ─────────────────────────
enum PrismIcon
    Check()
    Close()
    Search()
    Menu()
    Plus()
    Minus()
    ChevronUp()
    ChevronDown()
    ChevronLeft()
    ChevronRight()
    Warning()
    Info()

fn prism_icon_check() -> PrismIcon
    Check()
fn prism_icon_close() -> PrismIcon
    Close()
fn prism_icon_search() -> PrismIcon
    Search()
fn prism_icon_menu() -> PrismIcon
    Menu()
fn prism_icon_plus() -> PrismIcon
    Plus()
fn prism_icon_minus() -> PrismIcon
    Minus()
fn prism_icon_chevron_up() -> PrismIcon
    ChevronUp()
fn prism_icon_chevron_down() -> PrismIcon
    ChevronDown()
fn prism_icon_chevron_left() -> PrismIcon
    ChevronLeft()
fn prism_icon_chevron_right() -> PrismIcon
    ChevronRight()
fn prism_icon_warning() -> PrismIcon
    Warning()
fn prism_icon_info() -> PrismIcon
    Info()

// Exhaustive, no wildcard arm -- see header note on the closed-vocabulary discipline this
// mirrors from PrismNodeKind / PrismMeshTrack.
fn prism_icon_name(icon: PrismIcon) -> string
    match icon
        Check() => "check"
        Close() => "close"
        Search() => "search"
        Menu() => "menu"
        Plus() => "plus"
        Minus() => "minus"
        ChevronUp() => "chevron_up"
        ChevronDown() => "chevron_down"
        ChevronLeft() => "chevron_left"
        ChevronRight() => "chevron_right"
        Warning() => "warning"
        Info() => "info"

// ── Content constructors ──────────────────────────────────────────────────────────────────

// A leaf: renders as glyphs, never markup (PRISM_SPEC.md axiom A3 -- there is no string->UI
// evaluation path anywhere in the system). Nothing to validate: any string, including "", is a
// legitimate label.
fn prism_label(text: string) -> Result<PrismNode>
    prism_node.prism_node_leaf(prism_node.prism_kind_label(), {"text": text})

// See header note: `source` is a plain string reference (path/URL/resource-key) until an
// Image asset type exists. An empty source can never resolve to a real image, so it is
// rejected here rather than deferred to a confusing failure downstream in a future asset loader.
fn prism_art(source: string) -> Result<PrismNode>
    if len(source) == 0
        return err("prism_art: source must not be empty")
    prism_node.prism_node_leaf(prism_node.prism_kind_art(), {"source": source})

// Cannot fail: PrismIcon is a closed enum, so every value the type system lets through here is
// already a valid icon -- the whole payoff of choosing an enum over a free string (see header).
fn prism_glyph(icon: PrismIcon) -> Result<PrismNode>
    prism_node.prism_node_leaf(prism_node.prism_kind_glyph(), {"icon": prism_icon_name(icon)})

// See header note on why `paint` cannot be validated as "is this callable" -- only the coarse
// kinds NOVA can prove are NOT callable are rejected.
fn prism_draw(paint) -> Result<PrismNode>
    if is_string(paint) or is_int(paint) or is_float(paint) or is_bool(paint) or is_list(paint) or is_dict(paint)
        return err("prism_draw: paint must be a callback fn(Surface), got a " + type_of(paint))
    prism_node.prism_node_leaf(prism_node.prism_kind_draw(), {"paint": paint})

fn prism_draw_paint(n: PrismNode)
    n.attrs["paint"]
