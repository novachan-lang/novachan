// prism_app_dashboard -- milestone MB.6: a real admin-dashboard SCREEN, assembled ONLY from
// prism/ui/'s existing 37 components (11 modules) and the 22-primitive widget/ vocabulary. This
// file invents NO PrismNodeKind and adds NO ui/ component -- its entire job is composition, and
// it is the falsifier for whether prism/ui/ actually composes into something usable (the same
// role MA.6's ANSI backend played for the node tree itself).
//
// ── WHAT THE PAGE IS ──────────────────────────────────────────────────────────────────────────
// A shell (header with a user-menu dropdown, sidebar nav with one active entry, paned content,
// footer) wrapping: a breadcrumb, an optional alert banner, a stat row (4 metrics with trends), a
// bar chart + legend, a sortable customer table, an "invite a teammate" form (5 field kinds +
// validation), a recent-activity timeline that degrades to an honest empty state when there is
// nothing to show, and a delete-confirmation modal. Two overlay families (dropdown, modal) and
// both feedback surfaces this milestone asks for (alert + empty state) are exercised on purpose,
// at zero cost to ui/'s own vocabulary -- every one of them is an EXISTING export.
//
// ── STATE IS A MIX OF PLAIN STRINGS AND ALREADY-TYPED ui/ VALUES, AND THAT SPLIT IS DELIBERATE ──
// Fields that would cross an HTTP boundary in a real app (`app_table_sort_dir`, `app_active_route`)
// are plain strings, because a query parameter genuinely arrives as one -- so this file owns a
// small string->enum mapping step for each (`_prism_app_sort_dir`), and an unrecognized string is
// rejected, not silently defaulted. Fields that a real controller would already have assembled
// from its own domain layer (`app_breadcrumb`, `app_chart_series`, `app_activity`) are lists of
// the ui/ modules' OWN already-exported item types (`PrismBreadcrumbItem`, `PrismChItem`,
// `PrismUiTimelineEvent`), built via THEIR constructors (`prism_breadcrumb_item`, `prism_ch_item`,
// `prism_ui_timeline_event`) -- not re-invented here, and validated by the component that
// consumes them (propagate, don't reimplement -- the same discipline every ui/ module already
// follows for its own inputs). Only `PrismAppStat` is a genuinely new (tiny) type, because no
// existing component takes a LIST of stat records -- `prism_ui_stat` itself takes four scalars.
//
// ── FIELD PREFIX: `app_` / `astat_`, CHECKED PROJECT-WIDE FIRST ──────────────────────────────
// Grepped for `^\s+app_\w+:` and `^\s+astat_\w+:` across every .nova file in the repo before
// naming either struct -- both unclaimed (NOVA's field-name -> slot table is GLOBAL,
// last-registration-wins, MB.2's real collision).
//
// ── CROSS-MODULE CONSTRUCTION (trap 11) ──────────────────────────────────────────────────────
// `PrismAppState`/`PrismAppStat` are declared AND constructed only in this file -- external
// callers (the KAT, `prism_app_dashboard_route`) use `prism_app_state(...)` / `prism_app_stat(...)`,
// full arity (trap 12: no default survives a cross-module call).
//
// ── A GENUINE GAP FOUND WHILE WIRING THIS UP (see also the report handed back with this
//    milestone) ─────────────────────────────────────────────────────────────────────────────────
// `prism_form_render` has no "pristine vs touched" concept -- it shows a field's first violated
// rule's message unconditionally, the instant the field is blank, with no way to say "don't show
// this yet, nothing has been submitted." That is fine for THIS milestone (there is no reactivity
// engine yet to have a "touched" bit in the first place -- PRISM_SPEC.md defers bound-cell state
// on purpose), but it means the demo state below ships the invite form PRE-FILLED with valid
// values rather than blank, specifically to avoid shipping a "real" page that displays validation
// errors before any user has done anything. A production Prism app building a genuinely blank
// form will hit this the first time someone requests the empty page.
//
// PUBLIC API
//   PrismAppStat { astat_label, astat_value, astat_delta: string?, astat_trend: PrismStatTrend } +
//     prism_app_stat(label, value, delta, trend)
//   PrismAppState (16 fields, all `app_`-prefixed) + prism_app_state(...) full-arity ctor
//   prism_app_dashboard(state: PrismAppState) -> Result<PrismNode>
//   prism_app_dashboard_html(state) -> Result<string>    full HTML document
//   prism_app_dashboard_ansi(state) -> Result<string>    terminal text, 80 cols
//   prism_app_dashboard_route() -> a Forge handler serving a fixed demo state on every request

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_ui_kit
import prism_ui_layout
import prism_ui_nav
import prism_ui_data
import prism_ui_chart
import prism_ui_table
import prism_ui_form
import prism_ui_feedback
import prism_ui_overlay
import prism_render_html
import prism_render_ansi
import forge
import prism_forge as pf

// ── State: one small new type (no existing component takes a LIST of these) ────────────────────
type PrismAppStat
    astat_label: string
    astat_value: string
    astat_delta: string?
    astat_trend: PrismStatTrend

fn prism_app_stat(label: string, value: string, delta: string?, trend: PrismStatTrend) -> PrismAppStat
    PrismAppStat(label, value, delta, trend)

// See header for why some fields are plain strings (HTTP-boundary-shaped) and some are lists of
// OTHER ui/ modules' own already-typed item structs (domain-shaped, assembled by a real caller).
type PrismAppState
    app_user_name: string
    app_active_route: string
    app_breadcrumb: list
    app_stats: list
    app_chart_series: list
    app_table_rows: list
    app_table_sort_col: string
    app_table_sort_dir: string
    app_form_name: string
    app_form_email: string
    app_form_role: string
    app_form_seats: int
    app_form_accept_terms: bool
    app_activity: list
    app_alert_message: string
    app_user_menu_open: bool

fn prism_app_state(user_name: string, active_route: string, breadcrumb: list, stats: list, chart_series: list, table_rows: list, table_sort_col: string, table_sort_dir: string, form_name: string, form_email: string, form_role: string, form_seats: int, form_accept_terms: bool, activity: list, alert_message: string, user_menu_open: bool) -> PrismAppState
    PrismAppState(user_name, active_route, breadcrumb, stats, chart_series, table_rows, table_sort_col, table_sort_dir, form_name, form_email, form_role, form_seats, form_accept_terms, activity, alert_message, user_menu_open)

// ── Sidebar nav: fixed 4-entry structure, "active" derived from state ───────────────────────────
// prism_nav_menu itself requires EXACTLY one active entry -- an active_route that names none of
// these four is rejected there, not here (propagate, don't reimplement).
fn _prism_app_nav_entries(active_route: string) -> list
    let e1 = prism_ui_nav.prism_menu_entry("Overview", some(prism_content.prism_icon_menu()), "/", active_route == "/")
    let e2 = prism_ui_nav.prism_menu_entry("Customers", some(prism_content.prism_icon_search()), "/customers", active_route == "/customers")
    let e3 = prism_ui_nav.prism_menu_entry("Reports", some(prism_content.prism_icon_info()), "/reports", active_route == "/reports")
    let e4 = prism_ui_nav.prism_menu_entry("Settings", some(prism_content.prism_icon_plus()), "/settings", active_route == "/settings")
    [e1, e2, e3, e4]

// ── Sort direction: a plain string (HTTP-boundary-shaped, see header) mapped to the table's own
// closed enum. An unrecognized value is rejected -- never silently treated as "none".
fn _prism_app_sort_dir(s: string) -> Result<PrismSortDirection>
    if s == "ascending"
        return ok(prism_ui_table.prism_sort_ascending())
    if s == "descending"
        return ok(prism_ui_table.prism_sort_descending())
    if s == "none"
        return ok(prism_ui_table.prism_sort_unsorted())
    err("prism_app_dashboard: table_sort_dir must be 'ascending', 'descending', or 'none', got '" + s + "'")

// ── Stat row: our one new type, guarded the same way every ui/ module guards an untyped list
// element (type_name check before the first field read) ───────────────────────────────────────
fn _prism_app_stat_node(s) -> Result<PrismNode>
    if type_name(s) != "PrismAppStat"
        return err("prism_app_dashboard: stat is not a PrismAppStat (got " + type_name(s) + ")")
    prism_ui_data.prism_ui_stat(s.astat_label, s.astat_value, s.astat_delta, s.astat_trend)

// ── Customer table: 4 columns over row dicts, matching prism_ui_table's own established
// row-shape convention (extract_fn reads row["field"]) ───────────────────────────────────────────
fn _prism_app_table_columns() -> Result<list>
    let name_col = prism_ui_table.prism_table_column("name", "Name", fn(r) r["name"])?
    let email_col = prism_ui_table.prism_table_column("email", "Email", fn(r) r["email"])?
    let role_col = prism_ui_table.prism_table_column("role", "Role", fn(r) r["role"])?
    let status_col = prism_ui_table.prism_table_column("status", "Status", fn(r) r["status"])?
    ok([name_col, email_col, role_col, status_col])

// Sorting is applied only when a column is named; otherwise the table renders in its own
// construction order. A duplicate row id surfaces here as prism_grid's own mandatory-identity
// rejection (threaded through prism_table_render unmodified).
fn _prism_app_table(state: PrismAppState) -> Result<PrismNode>
    let cols = _prism_app_table_columns()?
    let table = prism_ui_table.prism_table(cols, state.app_table_rows, fn(r) r["id"])?
    if state.app_table_sort_col == ""
        return prism_ui_table.prism_table_render(table)
    let dir = _prism_app_sort_dir(state.app_table_sort_dir)?
    let sorted = prism_ui_table.prism_table_sorted(table, state.app_table_sort_col, dir)?
    prism_ui_table.prism_table_render(sorted)

// ── Invite form: 5 field kinds (text, email, choice, number, toggle) + validation rules ─────────
// Number takes no rule (its own [min,max] bound is inherent, checked at validate time -- see
// prism_ui_form.nova's own compatibility table); the other four all get `required`.
fn _prism_app_form(state: PrismAppState) -> Result<PrismNode>
    let name_base = prism_ui_form.prism_form_text("name", "Full name", state.app_form_name)?
    let name_field = prism_ui_form.prism_form_field_with_rules(name_base, [prism_ui_form.prism_form_rule_required(), prism_ui_form.prism_form_rule_min_length(2)])?
    let email_base = prism_ui_form.prism_form_email("email", "Email", state.app_form_email)?
    let email_field = prism_ui_form.prism_form_field_with_rules(email_base, [prism_ui_form.prism_form_rule_required()])?
    let role_options = [prism_interact.prism_pick_option("admin", "Admin"), prism_interact.prism_pick_option("editor", "Editor"), prism_interact.prism_pick_option("viewer", "Viewer")]
    let role_base = prism_ui_form.prism_form_choice("role", "Role", role_options, state.app_form_role)?
    let role_field = prism_ui_form.prism_form_field_with_rules(role_base, [prism_ui_form.prism_form_rule_required()])?
    let seats_field = prism_ui_form.prism_form_number("seats", "Seats needed", state.app_form_seats, 1, 50)?
    let terms_base = prism_ui_form.prism_form_toggle("accept_terms", "I agree to the terms of service", state.app_form_accept_terms)?
    let terms_field = prism_ui_form.prism_form_field_with_rules(terms_base, [prism_ui_form.prism_form_rule_required()])?
    let form = prism_ui_form.prism_form([name_field, email_field, role_field, seats_field, terms_field])?
    prism_ui_form.prism_form_render(form)

// ── Alert banner: purely conditional on state -- absent entirely when there is nothing to say,
// never an empty/blank banner node ──────────────────────────────────────────────────────────────
fn _prism_app_alert_parts(message: string) -> Result<list>
    if message == ""
        return ok([])
    let node = prism_ui_feedback.prism_fb_alert(prism_ui_feedback.prism_fb_severity_warning(), "Attention needed", some(message))?
    ok([node])

// ── Recent activity: the genuinely reachable empty state. A normal, VALID state with zero
// activity events renders prism_ui_kit's own honest empty state instead of a blank timeline --
// this is not an error path, just the ordinary "nothing happened yet" case every real dashboard
// has to handle on day one.
fn _prism_app_activity_body(events: list) -> Result<PrismNode>
    if len(events) == 0
        return prism_ui_kit.prism_ui_empty("No recent activity yet")
    prism_ui_data.prism_ui_timeline(events)

// ── Delete-confirmation modal: the second overlay family (sheet+exclusive, vs. the header
// dropdown's band+attr approach) ────────────────────────────────────────────────────────────────
fn _prism_app_delete_target_name(rows: list) -> string
    if len(rows) == 0
        return "this item"
    let first = rows[0]
    first["name"]

fn _prism_app_delete_modal(rows: list) -> Result<PrismNode>
    let target = _prism_app_delete_target_name(rows)
    let body = prism_content.prism_label("This action cannot be undone.")?
    let confirm_btn = prism_interact.prism_press("Delete", [])?
    let cancel_btn = prism_interact.prism_press("Cancel", [])?
    prism_ui_overlay.prism_ov_modal("Delete " + target + "?", body, [confirm_btn, cancel_btn])

// ── The page ──────────────────────────────────────────────────────────────────────────────────
fn prism_app_dashboard(state: PrismAppState) -> Result<PrismNode>
    if trim(state.app_user_name) == ""
        return err("prism_app_dashboard: user_name must not be empty (or all whitespace)")
    if len(state.app_breadcrumb) == 0
        return err("prism_app_dashboard: breadcrumb must not be empty")
    if len(state.app_stats) == 0
        return err("prism_app_dashboard: needs at least one stat")

    // Header: brand + a user-menu dropdown. Never paned (prism_shell threads header straight
    // through) -- see prism_ui_layout.nova's own header note on why.
    let brand = prism_ui_kit.prism_ui_icon_text(prism_content.prism_icon_menu(), "NOVA Admin")?
    let greeting = prism_ui_kit.prism_ui_icon_text(prism_content.prism_icon_info(), "Hi, " + state.app_user_name)?
    let user_menu_items = [prism_ui_overlay.prism_dropdown_item("Profile", none(), false), prism_ui_overlay.prism_dropdown_item("Settings", none(), false), prism_ui_overlay.prism_dropdown_item("Sign out", none(), false)]
    let user_menu = prism_ui_overlay.prism_ov_dropdown(greeting, user_menu_items, state.app_user_menu_open)?
    let header = prism_arrange.prism_band([brand, user_menu])?

    // Sidebar
    let nav_entries = _prism_app_nav_entries(state.app_active_route)
    let sidebar = prism_ui_nav.prism_nav_menu(nav_entries)?

    // Breadcrumb (already-typed PrismBreadcrumbItem list, assembled by the caller -- see header)
    let crumbs = prism_ui_nav.prism_nav_breadcrumb(state.app_breadcrumb)?

    // Optional alert banner
    let alert_parts = _prism_app_alert_parts(state.app_alert_message)?

    // Stat row
    let stat_mk = fn(s) _prism_app_stat_node(s)
    let stat_nodes = prism_ui_kit.prism_ui_collect(state.app_stats, stat_mk)?
    let stat_row = prism_arrange.prism_band(stat_nodes)?

    // Chart + legend (bar, since the table below already demonstrates tabular data separately)
    let bar = prism_ui_chart.prism_ch_bar("Revenue by Region", state.app_chart_series)?
    let legend = prism_ui_chart.prism_ch_legend(state.app_chart_series)?
    let chart_section = prism_ui_kit.prism_ui_section("Analytics", [bar, legend])?

    // Table (sorting applied per state, see _prism_app_table)
    let table_node = _prism_app_table(state)?
    let table_section = prism_ui_kit.prism_ui_section("Customers", [table_node])?

    // Form
    let form_node = _prism_app_form(state)?
    let send_btn = prism_interact.prism_press("Send invite", [])?
    let form_actions = prism_ui_kit.prism_ui_actions([send_btn])?
    let form_section = prism_ui_kit.prism_ui_section("Invite a teammate", [form_node, form_actions])?

    // Activity (empty state genuinely reachable -- see header)
    let activity_body = _prism_app_activity_body(state.app_activity)?
    let activity_section = prism_ui_kit.prism_ui_section("Recent activity", [activity_body])?

    // Delete-confirmation modal
    let modal = _prism_app_delete_modal(state.app_table_rows)?

    let content_children = [crumbs, ...alert_parts, stat_row, chart_section, table_section, form_section, activity_section, modal]
    let content = prism_arrange.prism_stack(content_children)?
    let footer = prism_content.prism_label("(c) 2026 NOVA Admin -- v1.0")?

    prism_ui_layout.prism_shell(header, some(sidebar), content, some(footer))

fn prism_app_dashboard_html(state: PrismAppState) -> Result<string>
    let node = prism_app_dashboard(state)?
    prism_render_html.prism_html_render_page(node, "NOVA Admin Dashboard")

fn prism_app_dashboard_ansi(state: PrismAppState) -> Result<string>
    let node = prism_app_dashboard(state)?
    prism_render_ansi.prism_ansi_render(node)

// ── Forge route: serves a fixed, realistic demo state on every request ─────────────────────────
fn _prism_app_demo_state() -> PrismAppState
    let crumbs = [prism_ui_nav.prism_breadcrumb_item("Home", "/"), prism_ui_nav.prism_breadcrumb_item("Overview", "/overview")]
    let s1 = prism_app_stat("Revenue", "$128,430", some("+12% vs last month"), prism_ui_data.prism_stat_trend_up())
    let s2 = prism_app_stat("Active users", "4,209", some("+3%"), prism_ui_data.prism_stat_trend_up())
    let s3 = prism_app_stat("Churn", "1.8%", some("-0.4%"), prism_ui_data.prism_stat_trend_down())
    let s4 = prism_app_stat("Open tickets", "37", none(), prism_ui_data.prism_stat_trend_flat())
    let series = [prism_ui_chart.prism_ch_item("North", 420), prism_ui_chart.prism_ch_item("South", 310), prism_ui_chart.prism_ch_item("East", 260), prism_ui_chart.prism_ch_item("West", 180)]
    let rows = [{"id": "u1", "name": "Alice Kim", "email": "alice@example.com", "role": "Admin", "status": "Active"}, {"id": "u2", "name": "Bob Chen", "email": "bob@example.com", "role": "Editor", "status": "Active"}, {"id": "u3", "name": "Carla Diaz", "email": "carla@example.com", "role": "Viewer", "status": "Invited"}, {"id": "u4", "name": "Dev Patel", "email": "dev@example.com", "role": "Editor", "status": "Active"}, {"id": "u5", "name": "Elin Osei", "email": "elin@example.com", "role": "Viewer", "status": "Suspended"}, {"id": "u6", "name": "Farid Novak", "email": "farid@example.com", "role": "Admin", "status": "Active"}]
    let activity = [prism_ui_data.prism_ui_timeline_event("Invoice #4821 paid", prism_ui_data.prism_timeline_status_done()), prism_ui_data.prism_ui_timeline_event("Nightly backup running", prism_ui_data.prism_timeline_status_active()), prism_ui_data.prism_ui_timeline_event("Scheduled maintenance", prism_ui_data.prism_timeline_status_pending())]
    prism_app_state("Priya Shah", "/", crumbs, [s1, s2, s3, s4], series, rows, "name", "ascending", "Jordan Lee", "jordan@example.com", "editor", 3, true, activity, "2 invoices are overdue.", false)

fn prism_app_dashboard_route()
    let build_fn = fn(req) prism_app_dashboard(_prism_app_demo_state())
    let h = pf.prism_forge_handler(build_fn, "NOVA Admin Dashboard")
    h
