// prism_app_docs -- the generated component reference for prism/ui/. Milestone MB.6.
// Extends prism_dev/prism_catalog.nova's (MA.7) "no hand-written story files" discipline one layer
// up: MA.7 proved it for the 22 CLOSED primitives; this proves the same discipline scales to a
// composed, OPEN-ended layer that keeps growing (37 components across 11 modules as of this
// writing, per PRISM_ROADMAP.md MB.1-MB.5, and counting).
//
// ── WHY prism/ui/ NEEDED THIS, WHEN prism_catalog.nova ALREADY EXISTS ─────────────────────────
// prism_catalog's coverage check works because PrismNodeKind is CLOSED and self-enumerating
// (`prism_node_kind_all()`) -- axiom A7 guarantees there is no 23rd primitive the catalog could
// forget to ask about. prism/ui/ is deliberately the OPPOSITE shape: it is an open, still-growing
// set of COMPOSITIONS over that closed vocabulary, and NOVA has no runtime reflection over a
// module's exported functions (verified absent elsewhere in this codebase -- there is no
// `module_functions(m)` builtin). A new ui/ component can be added, and nothing mechanical forces
// anyone to add it here. That gap is exactly what a hand-written Storybook-style doc always rots
// from, and it is precisely the gap this file closes THE SAME WAY prism_catalog.nova closes it for
// primitives: with a named coverage list and a KAT that turns a missed name into a loud failure.
//
// ── THE ONE HONEST LIMITATION, STATED PLAINLY (do not oversell this) ─────────────────────────────
// `prism_docs_expected_components()` is a HAND-MAINTAINED literal list, not an introspected one --
// unlike `prism_node_kind_all()`, which enumerates a CLOSED enum the compiler itself can check
// exhaustively, nothing forces this list to track prism/ui/'s real exported surface. It CAN DRIFT:
// a new component added to ui/ without a matching line here, or a line here for a component that
// no longer exists, are both real and possible. What this file buys is not "impossible to drift" --
// it is "drift becomes a NAMED, loud KAT failure" instead of a page that silently under- or
// over-reports what exists. Concretely: `prism_docs_coverage()` must be empty (an expected name
// with no doc entry is reported BY NAME), and the KAT separately asserts the expected list's own
// length, distinctness, and non-emptiness BEFORE looping over it -- so a list that was
// wrongly-emptied by a bad edit fails LOUDLY rather than vacuously passing an empty loop (exactly
// the MA.4a compiler-bug class: a loop over a wrongly-empty collection proves nothing).
//
// ── GRANULARITY: ONE DOC ENTRY PER NAMED COMPONENT IN EACH MODULE'S OWN "PUBLIC API" HEADER ──────
// Mirrors prism_catalog's own choice for prism_interact.nova (6 catalog entries -- press/entry/
// pick/flag/range/link -- for one file, not one per entry KIND or per rule variant): a component
// counts once, at the granularity its OWN file's header already declares it a named, independently
// useful thing. `prism_ui_form.nova`'s 7 field KINDS are configuration of ONE component ("form"),
// not 7 separate entries, exactly as `prism_entry`'s 4 entry kinds are one catalog entry, not 4.
// `prism_ui_table.nova`'s empty/loading states are the SAME component in a different data state,
// not additional components. Applying that consistently across all 11 modules yields 41 real,
// independently-named components -- not the 37 estimated when this milestone was scoped; ui/ grew
// between that estimate and this audit, which is itself the exact kind of drift this file exists
// to catch mechanically from now on rather than re-estimate by hand next time.
//
// ── EVERY EXAMPLE IS A REAL NODE, BUILT BY THE REAL CONSTRUCTOR (prism_catalog's rule, reused) ───
// Every entry below calls the component's own real, full-arity public constructor exactly as an
// application would -- never mock data, never hand-written markup. An entry that could not survive
// its own component's validation would not exist here to display.
//
// ── RENDERS THROUGH THE ORDINARY BACKENDS ONLY ────────────────────────────────────────────────────
// `prism_docs_tree()` is a plain `PrismNode` tree handed to `prism_render_html` / `prism_render_ansi`
// like any other Prism page -- no private rendering path, so this reference page cannot show
// anything an application could not also render, and it doubles as a 41-component exercise of both
// backends at once.
//
// PUBLIC API
//   prism_docs_entry_module/_name/_blurb/_node(e)   accessors on PrismDocsEntry
//   prism_docs_entries()             -> Result<list>    one PrismDocsEntry per ui/ component
//   prism_docs_tree()                -> Result<PrismNode>   the whole reference, grouped by module
//   prism_docs_html()                -> Result<string>      reference as a full HTML page
//   prism_docs_ansi()                -> Result<string>      reference as terminal text
//   prism_docs_expected_components() -> list                hand-maintained name list (CAN DRIFT --
//                                                            see header)
//   prism_docs_coverage()            -> Result<list>        expected names with NO doc entry (must
//                                                            be empty)
//   prism_docs_route()               a Forge handler serving this reference

import prism_forge as pforge
import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_ui_form
import prism_ui_table
import prism_ui_feedback
import prism_ui_input
import prism_ui_layout
import prism_ui_media
import prism_ui_nav
import prism_ui_overlay
import prism_ui_data
import prism_ui_chart
import prism_render_html as rh
import prism_render_ansi as ra

// Fields are `pd_`-prefixed (checked project-wide before naming, grep `^\s+pd_\w+:` across the repo
// -- zero hits): NOVA's field-name -> slot table is GLOBAL and last-registration-wins, and a plain
// field read off a receiver whose concrete type is not statically pinned (e.g. an element pulled out
// of a bare `list`, exactly what every loop over `prism_docs_entries()`'s result does) resolves by
// name alone. A bare `module`/`name`/`node` here could collide with an unrelated struct anywhere
// else in the whole linked program.
type PrismDocsEntry
    pd_module: string
    pd_name: string
    pd_blurb: string
    pd_node: PrismNode

// Cross-module constructor wrapper -- a struct's positional constructor is file-local even across
// modules (NOVA_LANGUAGE_FEATURES.md trap 11), the same reason prism_catalog.nova wraps
// PrismCatalogEntry's constructor.
fn prism_docs_entry(module: string, name: string, blurb: string, node: PrismNode) -> PrismDocsEntry
    PrismDocsEntry(module, name, blurb, node)

fn prism_docs_entry_module(e: PrismDocsEntry) -> string
    e.pd_module
fn prism_docs_entry_name(e: PrismDocsEntry) -> string
    e.pd_name
fn prism_docs_entry_blurb(e: PrismDocsEntry) -> string
    e.pd_blurb
fn prism_docs_entry_node(e: PrismDocsEntry) -> PrismNode
    e.pd_node

// ── One live example per named ui/ component, grouped by the module that declares it ─────────────
// Every constructor call below is the component's own real, full-arity public entry point -- the
// exact argument shapes verified against each module's own KAT while researching this file, so
// every example is known to pass its own component's validation, not merely "probably valid".
fn prism_docs_entries() -> Result<list>
    let out = []

    // ── form (prism_ui_form.nova) -- 1 component ─────────────────────────────────────────────
    let form_f1 = unwrap(prism_ui_form.prism_form_text("name", "Name", "Ada Lovelace"))
    let form_f2 = unwrap(prism_ui_form.prism_form_email("email", "Email", "ada@example.com"))
    let form_f3 = unwrap(prism_ui_form.prism_form_toggle("subscribe", "Subscribe to updates", true))
    let form_val = unwrap(prism_ui_form.prism_form([form_f1, form_f2, form_f3]))
    let form_node = unwrap(prism_ui_form.prism_form_render(form_val))
    out.push(prism_docs_entry("form", "form", "typed multi-field form (text/email/toggle here); validated as one unit", form_node))

    // ── table (prism_ui_table.nova) -- 1 component ───────────────────────────────────────────
    let tbl_col1 = unwrap(prism_ui_table.prism_table_column("name", "Name", fn(r) r["name"]))
    let tbl_col2 = unwrap(prism_ui_table.prism_table_column("dept", "Department", fn(r) r["dept"]))
    let tbl_rows = [{"name": "Ada Lovelace", "dept": "Engineering"}, {"name": "Grace Hopper", "dept": "Navy"}]
    let tbl_key_fn = fn(r) r["name"]
    let tbl_val = unwrap(prism_ui_table.prism_table([tbl_col1, tbl_col2], tbl_rows, tbl_key_fn))
    let tbl_node = unwrap(prism_ui_table.prism_table_render(tbl_val))
    out.push(prism_docs_entry("table", "table", "typed columns over a row set, with a sortable header", tbl_node))

    // ── feedback (prism_ui_feedback.nova) -- 5 components ────────────────────────────────────
    let fb_alert_node = unwrap(prism_ui_feedback.prism_fb_alert(prism_ui_feedback.prism_fb_severity_warning(), "Disk space low", some("Only 2 GB remaining on this volume.")))
    out.push(prism_docs_entry("feedback", "alert", "a severity-coded banner: icon + title + optional detail", fb_alert_node))

    let fb_toast_node = unwrap(prism_ui_feedback.prism_fb_toast(prism_ui_feedback.prism_fb_severity_success(), "Changes saved", some("Dismiss")))
    out.push(prism_docs_entry("feedback", "toast", "a transient status message with an optional dismiss action", fb_toast_node))

    let fb_confirm_node = unwrap(prism_ui_feedback.prism_fb_confirm("Delete item?", "This cannot be undone.", "Delete", "Cancel"))
    out.push(prism_docs_entry("feedback", "confirm", "a modal yes/no dialog; both action labels are mandatory", fb_confirm_node))

    let fb_empty_node = unwrap(prism_ui_feedback.prism_fb_empty("No projects yet", "Create your first project to get started.", some("New project")))
    out.push(prism_docs_entry("feedback", "empty", "an honest empty state with an optional call to action", fb_empty_node))

    let fb_progress_node = unwrap(prism_ui_feedback.prism_fb_progress("Uploading", 3, 10))
    out.push(prism_docs_entry("feedback", "progress", "a determinate progress meter: label + prism_range", fb_progress_node))

    // ── input (prism_ui_input.nova) -- 5 components ──────────────────────────────────────────
    let in_date_node = unwrap(prism_ui_input.prism_in_date("Birthday", 2024, 2, 29))
    out.push(prism_docs_entry("input", "date", "a date field; leap years honored both ways, zero-padded", in_date_node))

    let in_ms_r = prism_interact.prism_pick_option("r", "Red")
    let in_ms_g = prism_interact.prism_pick_option("g", "Green")
    let in_ms_b = prism_interact.prism_pick_option("b", "Blue")
    let in_ms_opts = [in_ms_r, in_ms_g, in_ms_b]
    let in_ms_node = unwrap(prism_ui_input.prism_in_multiselect("Favorite colors", in_ms_opts, ["r", "b"], some(2)))
    out.push(prism_docs_entry("input", "multiselect", "one flag per option; selection capped by max_selected", in_ms_node))

    let in_search_node = unwrap(prism_ui_input.prism_in_search("Search users", "ada"))
    out.push(prism_docs_entry("input", "search", "glyph + entry(search) + a Clear action once query is non-empty", in_search_node))

    let in_stepper_node = unwrap(prism_ui_input.prism_in_stepper("Quantity", 3, 0, 10, 1))
    out.push(prism_docs_entry("input", "stepper", "a numeric stepper; inc/dec stay present but inert at the bounds", in_stepper_node))

    let in_rating_node = unwrap(prism_ui_input.prism_in_rating("Quality", 3, 5))
    out.push(prism_docs_entry("input", "rating", "a star rating built from the closed icon set (check/minus)", in_rating_node))

    // ── layout (prism_ui_layout.nova) -- 5 components ────────────────────────────────────────
    let lay_left = unwrap(prism_content.prism_label("Left"))
    let lay_right = unwrap(prism_content.prism_label("Right"))
    let lay_split_node = unwrap(prism_ui_layout.prism_split([lay_left, lay_right], prism_ui_layout.prism_split_ratio_golden()))
    out.push(prism_docs_entry("layout", "split", "two panes at a named ratio; golden = 382/618 permille weights", lay_split_node))

    // The drawer example is EXCLUSIVE (modal), so its content must contain something focusable --
    // an exclusive surface traps focus, and a modal with nothing to act on leaves the user unable
    // to proceed or leave. Caught by prism_a11y's modal_not_focusable rule against this very page
    // (MB.9): the example previously held only a label. Fixed here rather than by relaxing the
    // rule, and it is better documentation for it too -- it now shows the CORRECT shape of a modal
    // surface instead of an inaccessible one.
    let lay_panel_text = unwrap(prism_content.prism_label("Panel content"))
    let lay_panel_close = unwrap(prism_interact.prism_press("Close", []))
    let lay_panel = unwrap(prism_arrange.prism_stack([lay_panel_text, lay_panel_close]))
    let lay_drawer_node = unwrap(prism_ui_layout.prism_drawer(lay_panel, prism_ui_layout.prism_drawer_edge_left(), true))
    out.push(prism_docs_entry("layout", "drawer", "an edge-anchored sheet; the edge is a queryable attr", lay_drawer_node))

    let lay_header = unwrap(prism_content.prism_label("Header"))
    let lay_content = unwrap(prism_content.prism_label("Content"))
    let lay_sidebar = unwrap(prism_content.prism_label("Sidebar"))
    let lay_footer = unwrap(prism_content.prism_label("Footer"))
    let lay_shell_node = unwrap(prism_ui_layout.prism_shell(lay_header, some(lay_sidebar), lay_content, some(lay_footer)))
    out.push(prism_docs_entry("layout", "shell", "header + optional sidebar + paned content + optional footer", lay_shell_node))

    let lay_tracks = [prism_arrange.prism_track_fixed(100), prism_arrange.prism_track_fill()]
    let lay_cell1 = unwrap(prism_content.prism_label("A"))
    let lay_cell2 = unwrap(prism_content.prism_label("B"))
    let lay_cell3 = unwrap(prism_content.prism_label("C"))
    let lay_cell4 = unwrap(prism_content.prism_label("D"))
    let lay_grid_node = unwrap(prism_ui_layout.prism_grid_layout(lay_tracks, [lay_cell1, lay_cell2, lay_cell3, lay_cell4]))
    out.push(prism_docs_entry("layout", "grid_layout", "a responsive-ish column arrangement; children fill whole rows", lay_grid_node))

    let lay_glyph = unwrap(prism_content.prism_glyph(prism_content.prism_icon_check()))
    let lay_save_btn = unwrap(prism_interact.prism_press("Save", []))
    let lay_title = unwrap(prism_content.prism_label("Untitled document"))
    let lay_toolbar_node = unwrap(prism_ui_layout.prism_toolbar([lay_glyph], [lay_title], [lay_save_btn]))
    out.push(prism_docs_entry("layout", "toolbar", "always exactly 3 children: leading/centre/trailing bands", lay_toolbar_node))

    // ── media (prism_ui_media.nova) -- 5 components ──────────────────────────────────────────
    let md_avatar_node = unwrap(prism_ui_media.prism_ui_avatar("Ada Lovelace", none(), prism_ui_media.prism_avatar_size_medium()))
    out.push(prism_docs_entry("media", "avatar", "image when supplied, else initials derived+capped from the name", md_avatar_node))

    let md_figure_node = unwrap(prism_ui_media.prism_ui_figure("/img/bicycle.png", "A red bicycle", some("Parked outside")))
    out.push(prism_docs_entry("media", "figure", "an image with mandatory alt text and an optional caption", md_figure_node))

    let md_gal_item1 = prism_ui_media.prism_gallery_item("a.jpg", "Alt A", none())
    let md_gal_item2 = prism_ui_media.prism_gallery_item("b.jpg", "Alt B", some("Caption B"))
    let md_gallery_node = unwrap(prism_ui_media.prism_ui_gallery([md_gal_item1, md_gal_item2]))
    out.push(prism_docs_entry("media", "gallery", "a flow of figures, each with its own alt text and caption", md_gallery_node))

    let md_body_a = unwrap(prism_content.prism_label("Section A body"))
    let md_body_b = unwrap(prism_content.prism_label("Section B body"))
    let md_sec_a = prism_ui_media.prism_accordion_section("Overview", md_body_a, false)
    let md_sec_b = prism_ui_media.prism_accordion_section("Details", md_body_b, true)
    let md_accordion_node = unwrap(prism_ui_media.prism_ui_accordion([md_sec_a, md_sec_b]))
    out.push(prism_docs_entry("media", "accordion", "collapsed content is absent by construction, not merely hidden", md_accordion_node))

    let md_card_media = unwrap(prism_ui_media.prism_ui_figure("/img/widget.png", "A fine widget", none()))
    let md_card_btn1 = unwrap(prism_interact.prism_press("Buy", []))
    let md_card_btn2 = unwrap(prism_interact.prism_press("Details", []))
    let md_card_node = unwrap(prism_ui_media.prism_ui_card("Widget", some("A fine widget."), some(md_card_media), [md_card_btn1, md_card_btn2]))
    out.push(prism_docs_entry("media", "card", "title + optional media/body/actions, in that fixed order", md_card_node))

    // ── nav (prism_ui_nav.nova) -- 4 components ──────────────────────────────────────────────
    let nav_home = prism_ui_nav.prism_breadcrumb_item("Home", "/")
    let nav_products = prism_ui_nav.prism_breadcrumb_item("Products", "/products")
    let nav_widget = prism_ui_nav.prism_breadcrumb_item("Widget", "/products/widget")
    let nav_bc_node = unwrap(prism_ui_nav.prism_nav_breadcrumb([nav_home, nav_products, nav_widget]))
    out.push(prism_docs_entry("nav", "breadcrumb", "a trail of links; the last item is the current page, never linked", nav_bc_node))

    let nav_dash = prism_ui_nav.prism_menu_entry("Dashboard", some(prism_content.prism_icon_menu()), "/dashboard", false)
    let nav_settings = prism_ui_nav.prism_menu_entry("Settings", none(), "/settings", true)
    let nav_menu_node = unwrap(prism_ui_nav.prism_nav_menu([nav_dash, nav_settings]))
    out.push(prism_docs_entry("nav", "menu", "exactly one active entry; the active one is a label, never a link", nav_menu_node))

    let nav_pages_node = unwrap(prism_ui_nav.prism_nav_pages(3, 10))
    out.push(prism_docs_entry("nav", "pagination", "prev/current/next; prev/next stay present but inert at the ends", nav_pages_node))

    let nav_steps_node = unwrap(prism_ui_nav.prism_nav_steps(["Cart", "Shipping", "Payment", "Confirm"], 1))
    out.push(prism_docs_entry("nav", "steps", "complete/current/pending, told apart by a queryable step_state attr", nav_steps_node))

    // ── overlay (prism_ui_overlay.nova) -- 5 components ──────────────────────────────────────
    let ov_trigger = unwrap(prism_interact.prism_press("Account", []))
    let ov_item_a = prism_ui_overlay.prism_dropdown_item("Profile", some(prism_content.prism_icon_check()), false)
    let ov_item_b = prism_ui_overlay.prism_dropdown_item("Settings", none(), false)
    let ov_item_c = prism_ui_overlay.prism_dropdown_item("Delete account", none(), true)
    let ov_dropdown_node = unwrap(prism_ui_overlay.prism_ov_dropdown(ov_trigger, [ov_item_a, ov_item_b, ov_item_c], true))
    out.push(prism_docs_entry("overlay", "dropdown", "closed content is never built at all, not merely hidden", ov_dropdown_node))

    let ov_anchor = unwrap(prism_interact.prism_press("Info", []))
    let ov_content = unwrap(prism_content.prism_label("Extra detail here"))
    let ov_popover_node = unwrap(prism_ui_overlay.prism_ov_popover(ov_anchor, ov_content, prism_ui_overlay.prism_popover_placement_top()))
    out.push(prism_docs_entry("overlay", "popover", "anchor + a full node of floating content, over hint", ov_popover_node))

    let ov_modal_body = unwrap(prism_content.prism_label("This cannot be undone."))
    let ov_modal_act1 = unwrap(prism_interact.prism_press("Delete", []))
    let ov_modal_act2 = unwrap(prism_interact.prism_press("Cancel", []))
    let ov_modal_node = unwrap(prism_ui_overlay.prism_ov_modal("Delete project?", ov_modal_body, [ov_modal_act1, ov_modal_act2]))
    out.push(prism_docs_entry("overlay", "modal", "N-action surface over sheet(exclusive); zero actions is rejected", ov_modal_node))

    let ov_commands = ["Open File", "Save File", "Save As", "Close Window"]
    let ov_matches = fn(s) contains(s, "Save")
    let ov_cp_node = unwrap(prism_ui_overlay.prism_ov_command_palette("Search commands", "sav", ov_commands, ov_matches, "No matching commands"))
    out.push(prism_docs_entry("overlay", "command_palette", "query entry + predicate-filtered results via the builtin filter()", ov_cp_node))

    let ov_skel_node = unwrap(prism_ui_overlay.prism_ov_skeleton(3))
    out.push(prism_docs_entry("overlay", "skeleton", "N empty rows, each tagged with a skeleton attr for a shimmer paint", ov_skel_node))

    // ── data (prism_ui_data.nova) -- 5 components ────────────────────────────────────────────
    let da_item_a = prism_ui_data.prism_ui_list_item("Alpha", some("first line"), some(prism_content.prism_icon_check()))
    let da_item_b = prism_ui_data.prism_ui_list_item("Beta", none(), none())
    let da_key_fn = fn(it) it.list_title
    let da_list_node = unwrap(prism_ui_data.prism_ui_list([da_item_a, da_item_b], da_key_fn))
    out.push(prism_docs_entry("data", "list", "keyed repetition over prism_each; each row is title+secondary+icon", da_list_node))

    let da_leaf_a = prism_ui_data.prism_ui_tree_node("Child A", [], false)
    let da_leaf_b = prism_ui_data.prism_ui_tree_node("Child B", [], true)
    let da_root = prism_ui_data.prism_ui_tree_node("Root", [1, 2], true)
    let da_tree_node = unwrap(prism_ui_data.prism_ui_tree([da_root, da_leaf_a, da_leaf_b], 0))
    out.push(prism_docs_entry("data", "tree", "flat array + integer child indices; cycle- and depth-checked", da_tree_node))

    let da_desc_node = unwrap(prism_ui_data.prism_ui_descriptions([["Name", "Ada Lovelace"], ["Role", "Engineer"]]))
    out.push(prism_docs_entry("data", "descriptions", "a validated key/value block, built on prism_ui_kv", da_desc_node))

    let da_stat_node = unwrap(prism_ui_data.prism_ui_stat("Revenue", "$1.2M", some("+12%"), prism_ui_data.prism_stat_trend_up()))
    out.push(prism_docs_entry("data", "stat", "label + value + an optional trend-iconed delta", da_stat_node))

    let da_ev0 = prism_ui_data.prism_ui_timeline_event("Ordered", prism_ui_data.prism_timeline_status_done())
    let da_ev1 = prism_ui_data.prism_ui_timeline_event("Shipped", prism_ui_data.prism_timeline_status_active())
    let da_ev2 = prism_ui_data.prism_ui_timeline_event("Out for delivery", prism_ui_data.prism_timeline_status_pending())
    let da_timeline_node = unwrap(prism_ui_data.prism_ui_timeline([da_ev0, da_ev1, da_ev2]))
    out.push(prism_docs_entry("data", "timeline", "done/active/pending events, told apart by a queryable tl_status attr", da_timeline_node))

    // ── chart (prism_ui_chart.nova) -- 5 components ──────────────────────────────────────────
    let ch_a = prism_ui_chart.prism_ch_item("Jan", 2)
    let ch_b = prism_ui_chart.prism_ch_item("Feb", 5)
    let ch_c = prism_ui_chart.prism_ch_item("Mar", 10)
    let ch_bar_node = unwrap(prism_ui_chart.prism_ch_bar("Sales", [ch_a, ch_b, ch_c]))
    out.push(prism_docs_entry("chart", "bar", "a text-mode bar chart built on prism_grid for column alignment", ch_bar_node))

    let ch_spark_node = unwrap(prism_ui_chart.prism_ch_sparkline([3, 5, 2, 8, 6]))
    out.push(prism_docs_entry("chart", "sparkline", "check/minus per point, split at the series' own midpoint", ch_spark_node))

    let ch_pie_a = prism_ui_chart.prism_ch_item("A", 1)
    let ch_pie_b = prism_ui_chart.prism_ch_item("B", 1)
    let ch_pie_c = prism_ui_chart.prism_ch_item("C", 1)
    let ch_pie_series = [ch_pie_a, ch_pie_b, ch_pie_c]
    let ch_pie_node = unwrap(prism_ui_chart.prism_ch_pie("Share", ch_pie_series))
    out.push(prism_docs_entry("chart", "pie", "largest-remainder apportionment; percentages always sum to 100", ch_pie_node))

    let ch_gauge_node = unwrap(prism_ui_chart.prism_ch_gauge("Temperature", 72, 32, 212))
    out.push(prism_docs_entry("chart", "gauge", "a labelled prism_range using the caller's OWN domain, not [0,100]", ch_gauge_node))

    let ch_legend_node = unwrap(prism_ui_chart.prism_ch_legend(ch_pie_series))
    out.push(prism_docs_entry("chart", "legend", "key/value rows built on prism_ui_kv, one per series item", ch_legend_node))

    ok(out)

// ── Coverage: the check that replaces hand-written story files (prism_catalog's rule, reused) ────
// The list below is HAND-MAINTAINED, NOT introspected -- NOVA cannot enumerate a module's exported
// functions at runtime, so this is the same honest tradeoff `prism_node_kind_all()` documents,
// applied to an OPEN vocabulary instead of a closed one: it CAN DRIFT from the real ui/ surface if a
// component is renamed, removed, or added without a matching update here. What converts that risk
// into a loud, named failure rather than a silent gap is the KAT: it asserts THIS list's length,
// distinctness, and non-emptiness, and separately asserts `prism_docs_entries()`'s length, BOTH
// BEFORE looping over either -- a loop over a wrongly-emptied list would otherwise pass vacuously
// (the exact MA.4a compiler-bug class: a green loop over nothing proves nothing).
fn prism_docs_expected_components() -> list
    ["form", "table", "alert", "toast", "confirm", "empty", "progress", "date", "multiselect", "search", "stepper", "rating", "split", "drawer", "shell", "grid_layout", "toolbar", "avatar", "figure", "gallery", "accordion", "card", "breadcrumb", "menu", "pagination", "steps", "dropdown", "popover", "modal", "command_palette", "skeleton", "list", "tree", "descriptions", "stat", "timeline", "bar", "sparkline", "pie", "gauge", "legend"]

// Returns the expected names with NO doc entry. Must be empty. Adding ui/ component #42 without
// adding both a doc entry above AND a name here shows up as a MISSING DOC ENTRY (this function);
// adding a name here without a doc entry shows up the same way -- both directions are covered.
fn prism_docs_coverage() -> Result<list>
    let entries_r = prism_docs_entries()
    if is_err(entries_r)
        return err(unwrap_err(entries_r))
    let have = {}
    for e in unwrap(entries_r)
        have[e.pd_name] = true
    let missing = []
    for nm in prism_docs_expected_components()
        if not (nm in have)
            missing.push(nm)
    ok(missing)

// ── The reference page as a node tree, grouped by module ─────────────────────────────────────────
// Section order matches the brief's own module list (form, table, nav, feedback, layout, data,
// input, media, chart, overlay) -- independent of the construction order above, which follows
// PRISM_ROADMAP.md's milestone order (MB.1-MB.5) instead.
fn _prism_docs_module_order() -> list
    ["form", "table", "nav", "feedback", "layout", "data", "input", "media", "chart", "overlay"]

fn _prism_docs_module_title(m: string) -> string
    match m
        "form" => "Form"
        "table" => "Table"
        "nav" => "Navigation"
        "feedback" => "Feedback"
        "layout" => "Layout"
        "data" => "Data display"
        "input" => "Input"
        "media" => "Media"
        "chart" => "Chart"
        "overlay" => "Overlay"
        _ => m

// Built from the SAME primitives/compositions it documents -- if a component were broken, the page
// presenting it would break too, the same sharpest-possible smoke test prism_catalog_tree() relies
// on. Every entry is: a band naming the component + a `--` + its blurb, stacked above a `pane`
// wrapping the entry's own live node.
fn prism_docs_tree() -> Result<PrismNode>
    let entries_r = prism_docs_entries()
    if is_err(entries_r)
        return err(unwrap_err(entries_r))
    let entries = unwrap(entries_r)
    let sections = []
    sections.push(unwrap(prism_content.prism_label("Prism ui/ component reference")))
    for m in _prism_docs_module_order()
        let mod_children = [unwrap(prism_content.prism_label(_prism_docs_module_title(m)))]
        for e in entries
            if e.pd_module == m
                let name_lbl = unwrap(prism_content.prism_label(e.pd_name))
                let sep_lbl = unwrap(prism_content.prism_label("--"))
                let blurb_lbl = unwrap(prism_content.prism_label(e.pd_blurb))
                let head = unwrap(prism_arrange.prism_band([name_lbl, sep_lbl, blurb_lbl]))
                let body = unwrap(prism_arrange.prism_pane(e.pd_node))
                let entry_sec = unwrap(prism_arrange.prism_stack([head, body]))
                mod_children.push(entry_sec)
        sections.push(unwrap(prism_arrange.prism_stack(mod_children)))
    prism_arrange.prism_stack(sections)

fn prism_docs_html() -> Result<string>
    let t = prism_docs_tree()
    if is_err(t)
        return err(unwrap_err(t))
    rh.prism_html_render_page(unwrap(t), "Prism ui/ component reference")

fn prism_docs_ansi() -> Result<string>
    let t = prism_docs_tree()
    if is_err(t)
        return err(unwrap_err(t))
    ra.prism_ansi_render(unwrap(t))

// ── Forge route ───────────────────────────────────────────────────────────────────────────────
// Defined HERE, not in prism/app/prism_forge.nova, and that placement is deliberate. The bridge is
// the GENERIC adapter every Forge user imports; putting a specific page's route in it would make
// every such user pull in this reference page and everything it transitively imports -- the whole
// ui/ layer -- purely to serve an unrelated route. Dependencies point from the specific page to the
// generic bridge, never back.
fn prism_docs_route()
    let h = fn(req) pforge.prism_forge_page(prism_docs_tree(), "Prism ui/ component reference")
    h
