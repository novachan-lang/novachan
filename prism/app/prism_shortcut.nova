// prism_shortcut (app/, Tier 2) -- keyboard shortcuts + command palette (#67 #99).
//
// ── ⛔ A CONFLICTING BINDING IS REJECTED AT REGISTRATION, NOT RESOLVED BY ORDER ──────────────
// Two commands bound to the same chord is the defining bug of every shortcut system: whichever
// registered last (or first) wins, silently, and the loser is simply dead. The user presses the
// key, the wrong thing happens or nothing does, and nothing in the code looks wrong. So
// `prism_sc_bind` REFUSES a duplicate chord and names the command already holding it -- the same
// rule prism_route applies to ambiguous routes, and for the same reason: registration order must
// never be load-bearing and invisible.
//
// ── ⛔ RESERVED SYSTEM CHORDS ARE REFUSED ────────────────────────────────────────────────────
// An app that binds Ctrl+W, Ctrl+T or Ctrl+N is fighting the browser and the OS, and it loses
// unpredictably by platform -- so the binding "works" in testing and fails for a user on a
// different setup. Better to refuse at registration than to ship a shortcut whose behaviour
// depends on which browser opened it.
//
// ── ⛔ CHORDS ARE NORMALISED, SO "Ctrl+K" AND "ctrl+k" CANNOT BOTH BIND ──────────────────────
// Without normalisation the duplicate check above is trivially defeated by capitalisation or
// modifier order ("Shift+Ctrl+K" vs "Ctrl+Shift+K"), which is worse than having no check: it
// looks like it works. Modifiers are sorted into a canonical order and the key is lower-cased,
// so every spelling of one chord is one chord.
//
// ── THE PALETTE IS DERIVED FROM THE BINDINGS (#99) ───────────────────────────────────────────
// A command palette maintained as a separate list is the classic drift: a command gains a
// shortcut and the palette still shows "no shortcut", or a command is removed and the palette
// keeps offering it. `prism_sc_palette` is computed from the registered bindings, so it cannot
// disagree with what the keyboard actually does.
//
// ── SEARCH IS SUBSTRING, CASE-INSENSITIVE, AND ORDER IS STABLE ───────────────────────────────
// Fuzzy matching is tempting and wrong here: it ranks by a heuristic nobody can predict, so the
// top result moves as the corpus grows and muscle memory breaks. Substring keeps the mapping from
// query to result stable and explainable.
// ⚠ Case-insensitivity is ASCII-only: `str_to_lower` is a byte-wise C `tolower`, which is SAFE on
// UTF-8 (no ASCII byte can occur inside a multi-byte sequence) but does not case-fold non-ASCII.
// Stated rather than hidden -- same limitation prism_find documents.
//
// PUBLIC API
//   prism_sc_normalise(chord)                  -> Result<string>
//   prism_sc_registry()                        -> PrismShortcuts
//   prism_sc_bind(r, chord, command, title)    -> Result<PrismShortcuts>
//   prism_sc_unbind(r, chord)                  -> Result<PrismShortcuts>
//   prism_sc_count(r) / _chords(r) / _commands(r)
//   prism_sc_lookup(r, chord)                  -> Result<string>
//   prism_sc_chord_for(r, command)             -> Result<string>
//   prism_sc_palette(r)                        -> list<PrismCommand>
//   prism_sc_search(r, query)                  -> list<PrismCommand>
//   prism_sc_cmd_id(c) / _cmd_title(c) / _cmd_chord(c)
//   prism_sc_reserved()                        -> list

// `sc_` prefix: the struct field->slot map is GLOBAL, so a bare `id`/`title`/`chord` would share a
// slot with any other module's field of that name.
type PrismCommand
    sc_id: string
    sc_title: string
    sc_chord: string

type PrismShortcuts
    sc_cmds: list

// Chords the browser or OS owns. Binding these produces behaviour that varies by platform, so the
// binding "works" in testing and fails for a user on a different setup.
fn prism_sc_reserved() -> list
    ["ctrl+w", "ctrl+t", "ctrl+n", "ctrl+q", "ctrl+shift+w", "ctrl+shift+t", "ctrl+shift+n", "alt+f4", "ctrl+alt+delete"]

// Canonical modifier order. Sorted so "Shift+Ctrl+K" and "Ctrl+Shift+K" are ONE chord -- without
// this the duplicate check is defeated by modifier order, which is worse than no check because it
// looks like it works.
fn _sc_mod_rank(m: string) -> int
    if m == "ctrl"
        return 0
    if m == "alt"
        return 1
    if m == "shift"
        return 2
    if m == "meta"
        return 3
    99

fn prism_sc_normalise(chord) -> Result<string>
    if type_of(chord) != "string" or len(chord) == 0
        return err("prism_shortcut: a chord is required and must be a string, got {type_of(chord)}")
    let parts = str_to_lower(chord).split("+")
    let mods = []
    let keys = []
    for p in parts
        let t = trim(p)
        if len(t) == 0
            return err("prism_shortcut: chord '{chord}' has an empty component -- a trailing or doubled '+' is a typo, not a modifier")
        if _sc_mod_rank(t) < 99
            if contains(mods, t)
                return err("prism_shortcut: chord '{chord}' repeats the modifier '{t}'")
            push(mods, t)
        else
            push(keys, t)
    if len(keys) == 0
        return err("prism_shortcut: chord '{chord}' is modifiers only -- a shortcut needs a key")
    if len(keys) > 1
        return err("prism_shortcut: chord '{chord}' names {len(keys)} keys (" + join(keys, ", ") + ") -- a chord binds exactly one key plus modifiers")
    // Sort modifiers by canonical rank. An insertion sort over at most four items.
    let ordered = []
    for want in ["ctrl", "alt", "shift", "meta"]
        if contains(mods, want)
            push(ordered, want)
    push(ordered, keys[0])
    ok(join(ordered, "+"))

fn prism_sc_registry() -> PrismShortcuts
    PrismShortcuts([])

fn prism_sc_count(r: PrismShortcuts) -> int
    len(r.sc_cmds)

fn prism_sc_cmd_id(c: PrismCommand) -> string
    c.sc_id

fn prism_sc_cmd_title(c: PrismCommand) -> string
    c.sc_title

fn prism_sc_cmd_chord(c: PrismCommand) -> string
    c.sc_chord

fn prism_sc_chords(r: PrismShortcuts) -> list
    r.sc_cmds.map(fn(c) c.sc_chord)

fn prism_sc_commands(r: PrismShortcuts) -> list
    r.sc_cmds.map(fn(c) c.sc_id)

// ⛔ Refuses a duplicate CHORD and a duplicate COMMAND, each naming the existing holder. Two
// chords for one command is also refused: it doubles the palette entry and makes "what is the
// shortcut for X" ambiguous.
fn prism_sc_bind(r: PrismShortcuts, chord, command, title) -> Result<PrismShortcuts>
    let norm = prism_sc_normalise(chord)?
    if type_of(command) != "string" or len(command) == 0
        return err("prism_shortcut: a command id is required and must be a string, got {type_of(command)}")
    if type_of(title) != "string" or len(title) == 0
        return err("prism_shortcut: a human title is required -- a palette entry with no label is unusable")
    if contains(prism_sc_reserved(), norm)
        return err("prism_shortcut: '{norm}' is reserved by the browser or OS. Binding it produces behaviour that varies by platform, so it would appear to work in testing and fail for a user on a different setup")
    for c in r.sc_cmds
        if c.sc_chord == norm
            return err("prism_shortcut: '{norm}' is already bound to command '{c.sc_id}' -- refusing rather than letting registration order decide silently, which leaves the loser dead with nothing in the code looking wrong")
        if c.sc_id == command
            return err("prism_shortcut: command '{command}' is already bound to '{c.sc_chord}' -- one chord per command, or 'what is the shortcut for this' has two answers")
    let out = []
    for c in r.sc_cmds
        push(out, c)
    push(out, PrismCommand(command, title, norm))
    ok(PrismShortcuts(out))

fn prism_sc_unbind(r: PrismShortcuts, chord) -> Result<PrismShortcuts>
    let norm = prism_sc_normalise(chord)?
    let out = []
    let hit = [0]
    for c in r.sc_cmds
        if c.sc_chord == norm
            hit[0] = 1
        else
            push(out, c)
    if hit[0] == 0
        return err("prism_shortcut: nothing is bound to '{norm}'")
    ok(PrismShortcuts(out))

fn prism_sc_lookup(r: PrismShortcuts, chord) -> Result<string>
    let norm = prism_sc_normalise(chord)?
    let hit = [""]
    for c in r.sc_cmds
        if c.sc_chord == norm
            hit[0] = c.sc_id
    if hit[0] == ""
        return err("prism_shortcut: no command bound to '{norm}'")
    ok(hit[0])

fn prism_sc_chord_for(r: PrismShortcuts, command) -> Result<string>
    if type_of(command) != "string"
        return err("prism_shortcut: command id must be a string, got {type_of(command)}")
    let hit = [""]
    for c in r.sc_cmds
        if c.sc_id == command
            hit[0] = c.sc_chord
    if hit[0] == ""
        return err("prism_shortcut: command '{command}' has no binding")
    ok(hit[0])

// DERIVED from the bindings, so the palette cannot disagree with what the keyboard does.
fn prism_sc_palette(r: PrismShortcuts) -> list
    r.sc_cmds

// Substring, case-insensitive (ASCII), stable order. Matches on title OR command id, because a
// user types what they see while a developer types what they named it.
fn prism_sc_search(r: PrismShortcuts, query) -> list
    if type_of(query) != "string"
        return []
    if len(query) == 0
        return r.sc_cmds
    let q = str_to_lower(query)
    let out = []
    for c in r.sc_cmds
        if contains(str_to_lower(c.sc_title), q) or contains(str_to_lower(c.sc_id), q)
            push(out, c)
    out

fn prism_sc_describe(r: PrismShortcuts) -> string
    "shortcuts: {len(r.sc_cmds)} bound"
