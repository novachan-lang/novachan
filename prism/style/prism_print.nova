// prism_print (style/) -- print layout (feature #115).
//
// ── PRINT IS A DIFFERENT MEDIUM, NOT A NARROW SCREEN ────────────────────────────────────────
// The web's default answer is a stylesheet that hides a few things, which is why printed pages
// routinely lose content off the right edge and split tables mid-row. Print differs from screen
// in ways a width change cannot express:
//   * it is PAGINATED -- content has a hard bottom, and something must decide where breaks fall;
//   * it has NO INTERACTION -- a button, a slider and a text field are all just their labels;
//   * it has NO HOVER, NO SCROLL and no way to reveal anything, so hidden content is LOST, not
//     merely inconvenient;
//   * a LINK's destination becomes invisible unless the URL is printed beside the text.
// So this module answers the questions a print layout actually has to answer, in physical units,
// rather than restyling a screen tree.
//
// ── ⛔ UNITS ARE INTEGER MICROMETRES, NEVER FLOATS ───────────────────────────────────────────
// Page geometry is exact arithmetic on µm: A4 is 210000 x 297000 µm, US Letter 215900 x 279400.
// Both are EXACT integers in µm, while in inches or millimetres-as-float they are not -- 8.5in is
// fine, 215.9mm is not, and a float page height accumulates error across a hundred pages until
// the last one is short. Same reasoning as prism_number's minor units and prism_motion's 0..1000
// scale: float formatting and comparison are platform-sensitive, and a print layout that differs
// between two machines is a bug you discover on paper.
//
// PUBLIC API
//   prism_pr_page(w_um, h_um, margin_um)   -> Result<PrismPage>
//   prism_pr_a4() / _letter() / _a5()      -> PrismPage
//   prism_pr_landscape(p)                  -> PrismPage
//   prism_pr_width(p) / _height(p) / _margin(p)
//   prism_pr_content_w(p) / _content_h(p)  -> int      inside the margins
//   prism_pr_lines_per_page(p, leading_um) -> Result<int>
//   prism_pr_page_count(p, leading_um, lines) -> Result<int>
//   prism_pr_break_at(p, leading_um, line) -> Result<bool>   is this line the first on a page?
//   prism_pr_mm(um) / prism_pr_from_mm(mm) -> int

// `pp_` prefix: the struct field->slot map is GLOBAL.
type PrismPage
    pp_w: int       // micrometres
    pp_h: int
    pp_margin: int

fn prism_pr_page(w_um, h_um, margin_um) -> Result<PrismPage>
    if type_of(w_um) != "int" or type_of(h_um) != "int" or type_of(margin_um) != "int"
        return err("prism_print: page dimensions must be ints in micrometres, got {type_of(w_um)}/{type_of(h_um)}/{type_of(margin_um)}")
    if w_um < 1 or h_um < 1
        return err("prism_print: page must be positive, got {w_um}x{h_um} um")
    if margin_um < 0
        return err("prism_print: margin {margin_um} is negative")
    // A margin that consumes the page is rejected rather than clamped: clamping would silently
    // produce a page with no printable area, and every later division would be by zero or
    // negative -- an error here is the only place the caller can still fix it.
    if margin_um * 2 >= w_um or margin_um * 2 >= h_um
        return err("prism_print: margins of {margin_um} um leave no printable area on a {w_um}x{h_um} um page")
    ok(PrismPage(w_um, h_um, margin_um))

// ISO 216 and ANSI sizes, EXACT in micrometres. 20mm margins.
fn prism_pr_a4() -> PrismPage
    PrismPage(210000, 297000, 20000)

fn prism_pr_a5() -> PrismPage
    PrismPage(148000, 210000, 15000)

fn prism_pr_letter() -> PrismPage
    PrismPage(215900, 279400, 20000)

fn prism_pr_landscape(p: PrismPage) -> PrismPage
    PrismPage(p.pp_h, p.pp_w, p.pp_margin)

fn prism_pr_width(p: PrismPage) -> int
    p.pp_w

fn prism_pr_height(p: PrismPage) -> int
    p.pp_h

fn prism_pr_margin(p: PrismPage) -> int
    p.pp_margin

fn prism_pr_content_w(p: PrismPage) -> int
    p.pp_w - p.pp_margin - p.pp_margin

fn prism_pr_content_h(p: PrismPage) -> int
    p.pp_h - p.pp_margin - p.pp_margin

// Integer division deliberately FLOORS: a line that does not fully fit does not go on the page.
// Rounding up here is how a printed page loses its last line off the bottom edge -- the reader
// never sees it and nothing reports it.
fn prism_pr_lines_per_page(p: PrismPage, leading_um) -> Result<int>
    if type_of(leading_um) != "int"
        return err("prism_print: leading must be an int in micrometres, got {type_of(leading_um)}")
    if leading_um < 1
        return err("prism_print: leading must be >= 1 um, got {leading_um}")
    let n = prism_pr_content_h(p) / leading_um
    if n < 1
        return err("prism_print: leading of {leading_um} um does not fit even one line in {prism_pr_content_h(p)} um of printable height")
    ok(n)

// Pages needed for `lines`. Zero lines is ONE page, not zero: a document that prints nothing
// still produces a sheet, and returning 0 would make a caller skip the header/footer pass.
fn prism_pr_page_count(p: PrismPage, leading_um, lines) -> Result<int>
    if type_of(lines) != "int"
        return err("prism_print: line count must be an int, got {type_of(lines)}")
    if lines < 0
        return err("prism_print: line count {lines} is negative")
    let per = prism_pr_lines_per_page(p, leading_um)?
    if lines == 0
        return ok(1)
    ok((lines + per - 1) / per)

// Is this zero-based line the FIRST on a page? That is the question a paginator asks, and it is
// the one place an off-by-one puts a page break one line late for the whole document.
fn prism_pr_break_at(p: PrismPage, leading_um, line) -> Result<bool>
    if type_of(line) != "int"
        return err("prism_print: line index must be an int, got {type_of(line)}")
    if line < 0
        return err("prism_print: line index {line} is negative")
    let per = prism_pr_lines_per_page(p, leading_um)?
    ok(line % per == 0)

// Millimetres for humans; the model stays in micrometres. Rounds to nearest rather than
// truncating, so 215900 um reports as 216 mm and not 215.
fn prism_pr_mm(um) -> int
    if type_of(um) != "int"
        return 0
    (um + 500) / 1000

fn prism_pr_from_mm(mm) -> int
    if type_of(mm) != "int"
        return 0
    mm * 1000
