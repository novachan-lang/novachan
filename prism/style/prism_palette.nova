// prism_palette -- named sets of Color slots that a `look` resolves against (PRISM_SPEC.md §11).
// Milestone MA.4 part A (paired with prism_color.nova). PRISM_SPEC.md's own example:
//
//   palette day
//       ground = #ffffff
//       ink    = #1a1a1a
//       accent = #4f46e5
//       edge   = #e5e7eb
//   palette night
//       ground = #111827
//       ink    = #f9fafb
//       accent = #818cf8
//       edge   = #374151
//
// -- a `look` later writes `fill palette.ground` / `edge palette.edge`; this file is where those
// dot-references resolve TO, not the `look`/`face` DSL syntax itself (a later milestone -- see
// prism_look.nova, built concurrently). This file owns the palette VALUE and its 9x2 preset
// catalog; nothing here parses `look`/`palette` source syntax.
//
// ── DESIGN DECISION: 7 slots, not 4 -- three additions, each justified from §11 itself ────────
// The spec's own example gives exactly 4 slots (ground/ink/accent/edge) and those are the
// REQUIRED core, reproduced verbatim below as the "classic" preset's light/dark colors. Three
// more are added, each traced to a property §11's own "Complete property set (v1)" table already
// commits Prism to supporting -- not invented wholesale:
//   `muted`   -- the Text group lists `ink` alongside `leading`/`tracking`/`case` as per-text
//                properties; every real UI needs a SECOND text tone (captions, placeholders,
//                disabled labels) distinct from primary `ink`, or every non-primary label is
//                forced to reuse full-strength `ink` and the hierarchy the Text group implies
//                (weight, tracking, case -- all hierarchy-signaling properties) has no color
//                counterpart at all.
//   `warn`/`ok` -- the Paint group's `fill`/`edge` take a `Color` for ANY paint use, and §13
//                (accessibility, referenced from prism_interact.nova's own header) implies
//                interactive controls need state feedback; a validation error or a destructive
//                action needs a color that is NOT `accent` (which already means "the brand/
//                primary interactive color" from the spec's own example) or the design has no way
//                to distinguish "click this" from "this failed." Two slots, not one traffic-light
//                enum, because success and failure are genuinely different colors in every real
//                design system surveyed (Tailwind, Material, Radix) -- collapsing them into one
//                "status" slot would just move the branching into every consumer.
// Explicitly NOT added: a `link`/`focus`/`disabled` slot, a second accent, or per-elevation paint
// tiers -- none of those trace to a §11 property the way the three above do, and CLAUDE.md's own
// instruction here is explicit: do not invent 20 slots.
//
// ── DESIGN DECISION: 9 presets, chosen for genuine design divergence, not hue rotation ────────
// Each preset varies BOTH accent hue and neutral warmth/tint (whether `ground`/`edge` lean warm,
// cool, or fully desaturated) so no two are "the same design with a different accent color":
//   classic -- neutral gray + indigo (PRISM_SPEC.md §11's own literal day/night example)
//   slate   -- cool blue-gray neutrals + blue accent
//   ocean   -- teal-tinted neutrals + cyan accent
//   forest  -- warm-green-tinted neutrals + green accent
//   sunset  -- warm ivory/brown neutrals + orange accent
//   grape   -- violet-tinted neutrals + purple accent
//   rose    -- rose-tinted neutrals + pink accent
//   sand    -- desaturated warm tan/brown neutrals + brown/olive accent (the one deliberately
//              LOW-saturation preset, distinct from the other 8's fully-saturated accents)
//   mono    -- pure grayscale neutrals (zero chroma), a single blue accent -- the "maximum
//              accessibility" preset; `warn`/`ok` stay semantically red/green even here because
//              WCAG's own guidance is that status must not rely on color ALONE (shape/text carry
//              the meaning too, a `look`/`face`-layer concern, not this module's), not that
//              status colors must be removed from a neutral theme.
//
// ── DESIGN DECISION: WCAG AA is enforced ONLY for ink-on-ground, not every slot pair ──────────
// PRISM_SPEC.md's own axiom (§11: "There is no way to write a style that silently does nothing")
// is squarely about body text on its background -- the ink/ground pair is where a failure is
// invisible-until-a-user-reports-it. `edge`/`muted`/`warn`/`ok` are NOT graded here: `edge` is a
// border, never carries text; `warn`/`ok` are typically paired with icon+text combinations a
// later face-layer composes, not asserted as a flat AA pair in isolation. Grading every possible
// slot combination would be exactly the "20 slots for nothing" over-reach CLAUDE.md warns against
// applied to validation instead of vocabulary; the KAT (_kat_prism_style_a.nova) asserts the ONE
// pair the spec's own axiom is actually about, for all 18 palettes.
//
// ── DESIGN DECISION: contrast math delegates to std/color/contrast.nova, not reimplemented ────
// See prism_color.nova's header for why -- that module is already KAT-proven and documents every
// float hazard this exact computation (sRGB linearization, relative luminance) would otherwise
// re-trip. `prism_palette_contrast_ink_ground` below is a thin adapter: PrismColor -> [r,g,b] ->
// `cst_ratio`, nothing more.
//
// PUBLIC API
//   PrismPalette                                          name: string, dark: bool, 7 Color slots
//   prism_palette_names() -> list                          the 9 legal preset names, in a fixed
//                                                            order (also this module's dispatch
//                                                            order and the legend used in error
//                                                            messages)
//   prism_palette_named(name: string, dark: bool) -> Result<PrismPalette>
//                                                          typed error listing legal names on an
//                                                            unknown preset
//   prism_palette_slot(p, slot: string) -> Result<PrismColor>
//                                                          typed error listing legal slots on an
//                                                            unknown slot
//   prism_palette_slots(p) -> dict                         slot-name string -> PrismColor, EXACT
//                                                            shape prism_look.nova consumes
//                                                            without importing this module
//   prism_palette_name(p) -> string / prism_palette_is_dark(p) -> bool     field accessors
//   prism_palette_contrast_ink_ground(p) -> float          WCAG contrast ratio, ink over ground
//                                                            (>= 4.5 required for every preset --
//                                                            proven for all 18 in the KAT)

import prism_color
import std/color/contrast as pcst

// The 7 legal slot names, in the fixed order used for "legal slots" error messages.
//
// ── WHY THESE ARE FUNCTIONS AND NOT `let` CONSTANTS (a verified compiler bug, not a style choice) ──
// A module-level `let` whose initializer is a LIST or DICT literal **is never initialized when the
// module is IMPORTED** -- it is silently an empty collection. Probed directly 2026-08-15: the same
// declaration works in a main file (len 3) and is empty in an imported module (len 0), read even
// from INSIDE the declaring module. Worse, a write through it is silently dropped (`BX[0] = 7`
// leaves len 0 and reads back 0). Module-level `let` SCALARS (int, string) are unaffected.
// This bit here first: prism_palette_names() returned an EMPTY list cross-module, so the KAT's
// 18 WCAG contrast assertions silently iterated zero times and "passed".
// ✅ THE COMPILER BUG IS NOW FIXED (b37f501d) -- an imported module's top-level collection is
// materialized correctly. These stay FUNCTIONS anyway, deliberately: baking is keyed by name in
// NOVA's one flat namespace and takes first-definition-wins, so two modules each declaring e.g.
// `let SLOT_NAMES = [...]` would share one slot. A function returning a fresh literal cannot
// collide, and the cost is one allocation at an error/enumeration site -- neither is hot.
fn _prism_palette_slot_names() -> list
    ["ground", "ink", "accent", "edge", "muted", "warn", "ok"]

// The 9 legal preset names, in the fixed order used for both dispatch (prism_palette_named) and
// "legal names" error messages -- also what prism_palette_names() returns. A function, not a
// `let`, for the compiler-bug reason documented above.
fn _prism_palette_preset_names() -> list
    ["classic", "slate", "ocean", "forest", "sunset", "grape", "rose", "sand", "mono"]

// ── The value type ─────────────────────────────────────────────────────────────────────────

type PrismPalette
    name: string
    dark: bool
    slots: dict

// Assembles the 7 already-validated colors into the dict shape prism_palette_slots hands back
// unchanged. Private -- every preset function below funnels through this one chokepoint so the
// slot-name spelling lives in exactly one place, matching prism_node_new's own single-chokepoint
// discipline.
fn _prism_palette_build(name: string, dark: bool, ground: PrismColor, ink: PrismColor, accent: PrismColor, edge: PrismColor, muted: PrismColor, warn: PrismColor, ok_color: PrismColor) -> PrismPalette
    let slots = {"ground": ground, "ink": ink, "accent": accent, "edge": edge, "muted": muted, "warn": warn, "ok": ok_color}
    PrismPalette(name, dark, slots)

// ── Preset catalog (9 presets x light/dark = 18 palettes) ────────────────────────────────────
// Every RGB triple below is hand-picked and hand-verified against its hex source; the actual
// WCAG contrast ratio for ink-on-ground is COMPUTED (never assumed) by
// prism_palette_contrast_ink_ground and asserted >= 4.5 for all 18 in the KAT -- see that file's
// header, not this one, for the printed numbers.

// classic -- PRISM_SPEC.md §11's own literal day/night example, reproduced verbatim (neutral
// gray neutrals, indigo accent). Every other preset's light variant follows this SAME "near-black
// ink on near-white ground" shape (and dark: near-white ink on near-black ground) specifically
// because that shape is what makes AA contrast easy to guarantee by construction -- see note at
// the bottom of this file.
fn _prism_palette_classic(dark: bool) -> Result<PrismPalette>
    if dark
        let ground = prism_color.prism_color_rgba(17, 24, 39, 255)?
        let ink = prism_color.prism_color_rgba(249, 250, 251, 255)?
        let accent = prism_color.prism_color_rgba(129, 140, 248, 255)?
        let edge = prism_color.prism_color_rgba(55, 65, 81, 255)?
        let muted = prism_color.prism_color_rgba(156, 163, 175, 255)?
        let warn = prism_color.prism_color_rgba(251, 191, 36, 255)?
        let ok_color = prism_color.prism_color_rgba(74, 222, 128, 255)?
        return ok(_prism_palette_build("classic", true, ground, ink, accent, edge, muted, warn, ok_color))
    let ground = prism_color.prism_color_rgba(255, 255, 255, 255)?
    let ink = prism_color.prism_color_rgba(26, 26, 26, 255)?
    let accent = prism_color.prism_color_rgba(79, 70, 229, 255)?
    let edge = prism_color.prism_color_rgba(229, 231, 235, 255)?
    let muted = prism_color.prism_color_rgba(107, 114, 128, 255)?
    let warn = prism_color.prism_color_rgba(180, 83, 9, 255)?
    let ok_color = prism_color.prism_color_rgba(21, 128, 61, 255)?
    ok(_prism_palette_build("classic", false, ground, ink, accent, edge, muted, warn, ok_color))

// slate -- cool blue-gray neutrals, blue accent.
fn _prism_palette_slate(dark: bool) -> Result<PrismPalette>
    if dark
        let ground = prism_color.prism_color_rgba(15, 23, 42, 255)?
        let ink = prism_color.prism_color_rgba(241, 245, 249, 255)?
        let accent = prism_color.prism_color_rgba(96, 165, 250, 255)?
        let edge = prism_color.prism_color_rgba(51, 65, 85, 255)?
        let muted = prism_color.prism_color_rgba(148, 163, 184, 255)?
        let warn = prism_color.prism_color_rgba(248, 113, 113, 255)?
        let ok_color = prism_color.prism_color_rgba(52, 211, 153, 255)?
        return ok(_prism_palette_build("slate", true, ground, ink, accent, edge, muted, warn, ok_color))
    let ground = prism_color.prism_color_rgba(248, 250, 252, 255)?
    let ink = prism_color.prism_color_rgba(15, 23, 42, 255)?
    let accent = prism_color.prism_color_rgba(37, 99, 235, 255)?
    let edge = prism_color.prism_color_rgba(203, 213, 225, 255)?
    let muted = prism_color.prism_color_rgba(100, 116, 139, 255)?
    let warn = prism_color.prism_color_rgba(185, 28, 28, 255)?
    let ok_color = prism_color.prism_color_rgba(4, 120, 87, 255)?
    ok(_prism_palette_build("slate", false, ground, ink, accent, edge, muted, warn, ok_color))

