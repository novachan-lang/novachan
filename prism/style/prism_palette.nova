// sand -- desaturated warm tan/brown neutrals, brown/olive accent. The one deliberately
// LOW-saturation preset (every other preset's accent is a fully-saturated hue).
fn _prism_palette_sand(dark: bool) -> Result<PrismPalette>
    if dark
        let ground = prism_color.prism_color_rgba(28, 23, 16, 255)?
        let ink = prism_color.prism_color_rgba(245, 239, 227, 255)?
        let accent = prism_color.prism_color_rgba(217, 119, 6, 255)?
        let edge = prism_color.prism_color_rgba(74, 64, 50, 255)?
        let muted = prism_color.prism_color_rgba(168, 153, 138, 255)?
        let warn = prism_color.prism_color_rgba(248, 113, 113, 255)?
        let ok_color = prism_color.prism_color_rgba(163, 230, 53, 255)?
        return ok(_prism_palette_build("sand", true, ground, ink, accent, edge, muted, warn, ok_color))
    let ground = prism_color.prism_color_rgba(250, 246, 238, 255)?
    let ink = prism_color.prism_color_rgba(43, 32, 19, 255)?
    let accent = prism_color.prism_color_rgba(146, 64, 14, 255)?
    let edge = prism_color.prism_color_rgba(231, 220, 197, 255)?
    let muted = prism_color.prism_color_rgba(120, 113, 108, 255)?
    let warn = prism_color.prism_color_rgba(185, 28, 28, 255)?
    let ok_color = prism_color.prism_color_rgba(77, 124, 15, 255)?
    ok(_prism_palette_build("sand", false, ground, ink, accent, edge, muted, warn, ok_color))

// mono -- pure grayscale neutrals (zero chroma) + a single blue accent. `warn`/`ok` stay
// semantically red/green (see header note) -- everything else is strictly black/white/gray, the
// maximum-accessibility preset (ink-on-ground here is literal black-on-white or white-on-black,
// the highest contrast ratio possible: 21.0).
fn _prism_palette_mono(dark: bool) -> Result<PrismPalette>
    if dark
        let ground = prism_color.prism_color_rgba(0, 0, 0, 255)?
        let ink = prism_color.prism_color_rgba(255, 255, 255, 255)?
        let accent = prism_color.prism_color_rgba(96, 165, 250, 255)?
        let edge = prism_color.prism_color_rgba(75, 85, 99, 255)?
        let muted = prism_color.prism_color_rgba(156, 163, 175, 255)?
        let warn = prism_color.prism_color_rgba(248, 113, 113, 255)?
        let ok_color = prism_color.prism_color_rgba(74, 222, 128, 255)?
        return ok(_prism_palette_build("mono", true, ground, ink, accent, edge, muted, warn, ok_color))
    let ground = prism_color.prism_color_rgba(255, 255, 255, 255)?
    let ink = prism_color.prism_color_rgba(0, 0, 0, 255)?
    let accent = prism_color.prism_color_rgba(26, 86, 219, 255)?
    let edge = prism_color.prism_color_rgba(209, 213, 219, 255)?
    let muted = prism_color.prism_color_rgba(75, 85, 99, 255)?
    let warn = prism_color.prism_color_rgba(185, 28, 28, 255)?
    let ok_color = prism_color.prism_color_rgba(21, 128, 61, 255)?
    ok(_prism_palette_build("mono", false, ground, ink, accent, edge, muted, warn, ok_color))

// NOTE ON WHY ALL 18 PASS AA BY CONSTRUCTION, NOT BY LUCK: every preset's light variant pairs a
// near-black ink (every channel <= 76) against a near-white ground (every channel >= 236), and
// every dark variant pairs a near-white ink (every channel >= 236) against a near-black ground
// (every channel <= 38). WCAG relative luminance of a near-black color is close to 0 and a
// near-white color close to 1 regardless of which hue it's tinted toward, so (L_light+0.05)/
// (L_dark+0.05) lands close to 1.05/0.05 = 21 for every preset -- comfortably over the 4.5
// threshold with room to spare. This is a real structural guarantee (not a coincidence needing
// per-preset luck), but it is verified, not assumed: prism_palette_contrast_ink_ground computes
// the ACTUAL ratio per palette and the KAT asserts it for all 18 with the number printed.

// ── Public API ─────────────────────────────────────────────────────────────────────────────

// The 9 legal preset names, so callers and the eventual catalog can enumerate them without
// hardcoding a duplicate list.
fn prism_palette_names() -> list
    _prism_palette_preset_names()

// Builds a named preset's light (dark=false) or dark (dark=true) variant. Typed error listing
// every legal name on an unrecognized preset -- never a silent default palette.
fn prism_palette_named(name: string, dark: bool) -> Result<PrismPalette>
    match name
        "classic" => _prism_palette_classic(dark)
        "slate" => _prism_palette_slate(dark)
        "ocean" => _prism_palette_ocean(dark)
        "forest" => _prism_palette_forest(dark)
        "sunset" => _prism_palette_sunset(dark)
        "grape" => _prism_palette_grape(dark)
        "rose" => _prism_palette_rose(dark)
        "sand" => _prism_palette_sand(dark)
        "mono" => _prism_palette_mono(dark)
        _ => err("prism_palette: unknown preset '" + name + "', legal names: " + join(_prism_palette_preset_names(), ", "))

// Looks up one slot by name. Typed error listing every legal slot on an unrecognized one.
fn prism_palette_slot(p: PrismPalette, slot: string) -> Result<PrismColor>
    if slot in p.slots
        return ok(p.slots[slot])
    err("prism_palette: unknown slot '" + slot + "', legal slots: " + join(_prism_palette_slot_names(), ", "))

// REQUIRED shape for prism_look.nova (built concurrently): a plain dict of slot-name string ->
// PrismColor, so that module can resolve `palette.slotname` references without importing this
// one -- it only needs to hold the dict and know PrismColor's shape (via prism_color.nova).
fn prism_palette_slots(p: PrismPalette) -> dict
    p.slots

fn prism_palette_name(p: PrismPalette) -> string
    p.name

fn prism_palette_is_dark(p: PrismPalette) -> bool
    p.dark

// ── ACCENT DARKENING, 2026-08-16 ─────────────────────────────────────────────────────────────
// ocean/forest/sunset/rose LIGHT accents were darkened (by 15/21/16/5%) so that `ground` reaches
// WCAG AA on `accent`. This was not a taste change -- it was measured. The palettes had only ever
// asserted ink-on-GROUND, so when prism_theme's `action_primary` began putting text ON the accent,
// 4 of 18 palettes shipped below 4.5:1 (ocean 3.54, forest 3.09, sunset 3.42, rose 4.28). A design
// system whose stated value is measured contrast cannot leave one of its own pairings unmeasured.
// The dark variants already passed comfortably (5.6-10.3) and were left alone.
// prism_palette_contrast_ink_ground's own assertions are unaffected; the new pairing is asserted
// by prism_palette_contrast_ground_accent below, over all 18.

// ── WCAG contrast (delegates to std/color/contrast.nova -- see header) ───────────────────────

// PrismColor -> [r, g, b] for cst_luminance/cst_ratio, which are list-of-int-shaped (see
// std/color/contrast.nova's own API). Alpha is deliberately dropped -- WCAG relative luminance is
// defined over the OPAQUE rendered color; compositing a translucent ink/ground pair over
// whatever sits behind it is a renderer-layer concern (MA.5+), out of scope for this value type.
fn _prism_palette_rgb_list(c: PrismColor) -> list
    [prism_color.prism_color_r(c), prism_color.prism_color_g(c), prism_color.prism_color_b(c)]

// The WCAG contrast ratio between this palette's `ink` and `ground` slots. Every preset's ink and
// ground are guaranteed present (built by _prism_palette_build, never a partial palette), so this
// never fails and returns a bare float rather than Result<float>.
// Contrast of `ground` on `accent` -- the pairing prism_theme's `action_primary` relies on for
// button text. Added after that pairing was found failing AA on 4 of 18 palettes; asserted for
// every palette in the KAT so it cannot silently regress the way it silently arrived.
fn prism_palette_contrast_ground_accent(p: PrismPalette) -> float
    let g = p.slots["ground"]
    let a = p.slots["accent"]
    pcst.cst_ratio(_prism_palette_rgb_list(g), _prism_palette_rgb_list(a))

fn prism_palette_contrast_ink_ground(p: PrismPalette) -> float
    let ink_c = p.slots["ink"]
    let ground_c = p.slots["ground"]
    let ink_rgb = _prism_palette_rgb_list(ink_c)
    let ground_rgb = _prism_palette_rgb_list(ground_c)
    pcst.cst_ratio(ink_rgb, ground_rgb)
