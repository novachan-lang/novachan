// prism_audit_a11y (dev/) -- feature #105. PRISM_SPEC §13's claim is that a11y is DERIVED, so
// there is nothing to remember: roles come from the widget type, names from the content. This
// module audits the RESIDUE -- the handful of things derivation genuinely cannot know.
//
// ── WHY A SEPARATE MODULE FROM a11y/prism_a11y.nova ──────────────────────────────────────────
// `a11y/prism_a11y` holds the RULES and runs them over a tree. This is the DEVELOPER-FACING
// report: it groups findings, separates the blocking ones from the advisory ones, and answers
// "can I ship this?" with a single Result. Keeping the rule engine and the report apart means a
// new rule is added in exactly one place and this file never needs to know it exists -- the
// audit enumerates whatever the engine returns.
//
// ── ⛔ THE SEVERITY SPLIT IS LOAD-BEARING, NOT COSMETIC ──────────────────────────────────────
// `prism_aud_gate` fails ONLY on errors, never on warnings. An a11y gate that blocks on advisory
// findings gets switched off within a week -- and then the blocking ones stop being seen too.
// A gate that survives is one that only ever fires on something the team agrees is broken.
// Warnings are still REPORTED, in full, and counted; they are just not fatal.
//
// PUBLIC API
//   prism_aud_run(tree)          -> Result<PrismAudit>
//   prism_aud_total(a) / _errors(a) / _warnings(a) / _clean(a)
//   prism_aud_messages(a, sev)   -> list    "" for all
//   prism_aud_gate(a)            -> Result<PrismAudit>   err IFF there is >= 1 error
//   prism_aud_render(a)          -> string  hand-built

import prism_a11y

// `au_` prefix: the struct field->slot map is GLOBAL.
type PrismAudit
    au_errors: list
    au_warnings: list

fn prism_aud_run(tree: PrismNode) -> Result<PrismAudit>
    let findings = prism_a11y.prism_a11y_audit(tree)?
    let errs = []
    let warns = []
    for f in findings
        let sev = prism_a11y.prism_a11y_severity_name(prism_a11y.prism_a11y_finding_severity(f))
        let msg = "{prism_a11y.prism_a11y_finding_kind(f)}: {prism_a11y.prism_a11y_finding_message(f)}"
        if sev == "error"
            push(errs, msg)
        else
            push(warns, msg)
    ok(PrismAudit(errs, warns))

fn prism_aud_errors(a: PrismAudit) -> int
    len(a.au_errors)

fn prism_aud_warnings(a: PrismAudit) -> int
    len(a.au_warnings)

fn prism_aud_total(a: PrismAudit) -> int
    len(a.au_errors) + len(a.au_warnings)

// "Clean" means NO findings at all, errors or warnings -- deliberately stricter than the gate.
// A caller that wants "shippable" asks the gate; a caller that wants "perfect" asks this. Naming
// them the same thing would let a team believe warnings had been dealt with when they had not.
fn prism_aud_clean(a: PrismAudit) -> bool
    prism_aud_total(a) == 0

fn prism_aud_messages(a: PrismAudit, sev) -> list
    if type_of(sev) != "string"
        return []
    if sev == "error"
        return a.au_errors
    if sev == "warning"
        return a.au_warnings
    let all = []
    for e in a.au_errors
        push(all, e)
    for w in a.au_warnings
        push(all, w)
    all

// ⛔ Fails on ERRORS ONLY. See the header: a gate that blocks on advisory findings gets disabled,
// and then the real ones stop being seen. The message carries the count of BOTH so the warnings
// are still visible in the failure output.
fn prism_aud_gate(a: PrismAudit) -> Result<PrismAudit>
    if len(a.au_errors) == 0
        return ok(a)
    err("prism_audit_a11y: {len(a.au_errors)} accessibility ERROR(S) block this tree ({len(a.au_warnings)} warning(s) also present) -- " + join(a.au_errors, "; "))

fn _aud_esc(s: string) -> string
    let out = []
    for cp in code_points(s)
        if cp == 34
            push(out, "\\\"")
        else if cp == 92
            push(out, "\\\\")
        else if cp < 32
            push(out, " ")
        else
            push(out, from_codepoint(cp))
    join(out, "")

fn prism_aud_render(a: PrismAudit) -> string
    let es = a.au_errors.map(fn(m) "\"{_aud_esc(m)}\"")
    let ws = a.au_warnings.map(fn(m) "\"{_aud_esc(m)}\"")
    "\{\"errors\":[" + join(es, ",") + "],\"warnings\":[" + join(ws, ",") + "]}"
