// prism_catalog -- the generated component catalog. Milestone MA.7. Prism's answer to Storybook.
//
// ── WHY THIS IS GENERATED, NOT AUTHORED ───────────────────────────────────────────────────────
// Storybook's actual cost is not the viewer, it is the **story files**: one hand-written module per
// component, which must be kept in sync with the component by discipline alone. In every codebase
// that ships them they rot -- a prop is added, no story covers it, and the catalog quietly
// describes a version of the component that no longer exists.
//
// Prism does not need them, and the reason is structural rather than clever: the vocabulary is
// CLOSED (axiom A7). There are exactly 22 primitives and `prism_node_kind_all()` enumerates them,
// so the catalog can walk the vocabulary itself and build one live example per primitive. There is
// no per-component file to write, and therefore none to rot. Adding primitive #23 does not mean
// "write a 23rd story" -- it means the catalog's coverage assertion fails until #23 has an example
// here, which is the same information delivered as a test failure instead of as a stale page.
//
// ── EVERY EXAMPLE IS A REAL NODE, BUILT BY THE REAL CONSTRUCTOR ───────────────────────────────
// The examples below call `prism_press`, `prism_range`, ... exactly as an application would --
// they are not mock data or hand-written markup. So a catalog entry cannot show something the
// widget layer would refuse to build: every example has already passed that primitive's own
// validation by the time it is rendered. A catalog that could display an impossible component
// would be worse than no catalog.
//
// ── THE CATALOG RENDERS THROUGH THE ORDINARY BACKENDS ─────────────────────────────────────────
// It emits a PrismNode tree and hands it to `prism_render_html` / `prism_render_ansi` like any
// other page. It has no private rendering path, so it cannot drift from what applications get --
// and it doubles as an end-to-end exercise of every primitive through a real backend.
//
// PUBLIC API
//   prism_catalog_entries()          -> Result<list>    one PrismCatalogEntry per primitive
//   prism_catalog_entry_kind(e)      -> string
//   prism_catalog_entry_node(e)      -> PrismNode
//   prism_catalog_entry_blurb(e)     -> string
//   prism_catalog_tree()             -> Result<PrismNode>   the whole catalog as one node tree
//   prism_catalog_html()             -> Result<string>      catalog as a full HTML page
//   prism_catalog_ansi()             -> Result<string>      catalog as terminal text
//   prism_catalog_coverage()         -> Result<list>        kind names with NO example (must be [])

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_structure
import prism_render_html as rh
import prism_render_ansi as ra

type PrismCatalogEntry
    cat_kind: string
    blurb: string
    node: PrismNode

// Cross-module constructor wrapper -- a plain struct's positional constructor is file-local, same
// as an enum variant's (verified 2026-08-15).
fn prism_catalog_entry(kind: string, blurb: string, node: PrismNode) -> PrismCatalogEntry
    PrismCatalogEntry(kind, blurb, node)

fn prism_catalog_entry_kind(e: PrismCatalogEntry) -> string
    e.cat_kind
fn prism_catalog_entry_blurb(e: PrismCatalogEntry) -> string
    e.blurb
fn prism_catalog_entry_node(e: PrismCatalogEntry) -> PrismNode
    e.node

fn _cat_label(s: string) -> PrismNode
    unwrap(prism_content.prism_label(s))

// One live example per primitive, each built by the primitive's own real constructor.
fn prism_catalog_entries() -> Result<list>
    let out = []
    // Arrangement (§7)
    out.push(prism_catalog_entry("stack", "children on the block axis", unwrap(prism_arrange.prism_stack([_cat_label("one"), _cat_label("two")]))))
    out.push(prism_catalog_entry("band", "children on the inline axis", unwrap(prism_arrange.prism_band([_cat_label("left"), _cat_label("right")]))))
    out.push(prism_catalog_entry("layer", "overlay; later children on top", unwrap(prism_arrange.prism_layer([_cat_label("under"), _cat_label("over")]))))
    let tracks = [prism_arrange.prism_track_fixed(120), prism_arrange.prism_track_fill()]
    out.push(prism_catalog_entry("mesh", "2D grid with typed column tracks", unwrap(prism_arrange.prism_mesh(tracks, [_cat_label("a"), _cat_label("b")]))))
    out.push(prism_catalog_entry("flow", "inline children that wrap", unwrap(prism_arrange.prism_flow([_cat_label("w1"), _cat_label("w2")]))))
    out.push(prism_catalog_entry("pane", "scrollable viewport, exactly one child", unwrap(prism_arrange.prism_pane(_cat_label("scrollable")))))
    out.push(prism_catalog_entry("gap", "fixed or flexible space", unwrap(prism_arrange.prism_gap(some(16)))))
    // Content (§8)
    out.push(prism_catalog_entry("label", "text, rendered as glyphs and never as markup", _cat_label("Hello, Prism")))
    out.push(prism_catalog_entry("art", "a resource reference", unwrap(prism_content.prism_art("/img/example.png"))))
    out.push(prism_catalog_entry("glyph", "an icon from the closed 12-icon set", unwrap(prism_content.prism_glyph(prism_content.prism_icon_info()))))
    out.push(prism_catalog_entry("draw", "an opaque paint callback", unwrap(prism_content.prism_draw(fn(s) s))))
    // Interaction (§9)
    out.push(prism_catalog_entry("press", "activatable control; needs an accessible name", unwrap(prism_interact.prism_press("Save", []))))
    out.push(prism_catalog_entry("entry", "text input; kind from a closed vocabulary", unwrap(prism_interact.prism_entry("Email", prism_interact.prism_entry_kind_email(), "you@example.com"))))
    let opts = [prism_interact.prism_pick_option("s", "Small"), prism_interact.prism_pick_option("m", "Medium")]
    out.push(prism_catalog_entry("pick", "choice among options; duplicates rejected", unwrap(prism_interact.prism_pick(opts, "m"))))
    out.push(prism_catalog_entry("flag", "boolean control", unwrap(prism_interact.prism_flag("Enabled", true))))
    out.push(prism_catalog_entry("range", "bounded numeric; min<=max, step>0 enforced", unwrap(prism_interact.prism_range("Volume", 0, 10, 1, 7))))
    out.push(prism_catalog_entry("link", "navigation; scheme allowlisted at construction", unwrap(prism_interact.prism_link("Docs", prism_interact.prism_link_target_url("https://example.com")))))
    // Structure (§10)
    let items = ["alpha", "beta"]
    out.push(prism_catalog_entry("each", "keyed repetition; identity selector mandatory", unwrap(prism_structure.prism_each(items, fn(i) i, fn(i) prism_content.prism_label(i)))))
    out.push(prism_catalog_entry("grid", "tabular data; duplicate row keys rejected", unwrap(prism_structure.prism_grid(items, fn(i) i, ["name"], fn(i, c) prism_content.prism_label(i)))))
    out.push(prism_catalog_entry("sheet", "modal surface", unwrap(prism_structure.prism_sheet(_cat_label("dialog body"), true))))
    out.push(prism_catalog_entry("hint", "transient overlay attached to an anchor", unwrap(prism_structure.prism_hint("More info", _cat_label("anchor")))))
    let panels = [prism_structure.prism_tab_panel("First", _cat_label("first body")), prism_structure.prism_tab_panel("Second", _cat_label("second body"))]
    out.push(prism_catalog_entry("tabs", "mutually exclusive panels", unwrap(prism_structure.prism_tabs(panels, 0))))
    ok(out)

// ── Coverage: the check that replaces hand-written story files ────────────────────────────────
// Returns the kind names that have NO catalog example. Must be empty. Adding primitive #23 to
// PrismNodeKind without adding an example here shows up HERE, as a named gap, rather than as a
// catalog page that quietly omits it.
fn prism_catalog_coverage() -> Result<list>
    let entries = prism_catalog_entries()
    if is_err(entries)
        return err(unwrap_err(entries))
    let have = {}
    for e in unwrap(entries)
        have[e.cat_kind] = true
    let missing = []
    for k in prism_node.prism_node_kind_all()
        let nm = prism_node.prism_node_kind_name(k)
        if not (nm in have)
            missing.push(nm)
    ok(missing)

// ── The catalog as a node tree ────────────────────────────────────────────────────────────────
// Built from the SAME primitives it documents -- the catalog is a Prism application. If a
// primitive were broken, the page presenting it would break too, which is the sharpest possible
// smoke test.
fn prism_catalog_tree() -> Result<PrismNode>
    let entries = prism_catalog_entries()
    if is_err(entries)
        return err(unwrap_err(entries))
    let sections = []
    sections.push(_cat_label("Prism component catalog"))
    for e in unwrap(entries)
        let head = unwrap(prism_arrange.prism_band([_cat_label(e.cat_kind), _cat_label("--"), _cat_label(e.blurb)]))
        let body = unwrap(prism_arrange.prism_pane(e.node))
        let sec = prism_arrange.prism_stack([head, body])
        if is_err(sec)
            return err(unwrap_err(sec))
        sections.push(unwrap(sec))
    prism_arrange.prism_stack(sections)

fn prism_catalog_html() -> Result<string>
    let t = prism_catalog_tree()
    if is_err(t)
        return err(unwrap_err(t))
    rh.prism_html_render_page(unwrap(t), "Prism component catalog")

fn prism_catalog_ansi() -> Result<string>
    let t = prism_catalog_tree()
    if is_err(t)
        return err(unwrap_err(t))
    ra.prism_ansi_render(unwrap(t))
