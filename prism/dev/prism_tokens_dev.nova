// prism_tokens_dev -- design-token EXPORT (feature #108).
//
// ⛔ NAMED `prism_tokens_dev`, NOT `prism_tokens` as dev/README.md suggests: prism/**/*.nova is
// FLATTENED into $NOVA_HOME/lib, so two files named prism_tokens.nova (this one and
// style/prism_tokens.nova) would collide and one would silently win. Module basenames are a
// GLOBAL namespace in this project, not a per-folder one. Turns `style/prism_tokens.nova`'s
// typed scales into the flat formats a design tool or a non-NOVA consumer can read.
//
// ── THIS IS AN EXPORTER, NOT A SECOND SOURCE OF TRUTH ────────────────────────────────────────
// Every value is read back through `style/prism_tokens`' accessors (`prism_space_px`,
// `prism_radius_px`, `prism_type_size_px`, `prism_type_leading_px`). Nothing is re-declared here.
// A design-token exporter that hard-codes its own copy of the scale is the classic way a design
// system drifts: the export says 16px, the app renders 14px, and nobody notices because the two
// numbers live in different files and no test compares them. Reading through the accessors makes
// drift impossible rather than merely unlikely.
//
// ── THE SCALES ARE CLOSED ENUMS, SO EXPORT IS TOTAL ──────────────────────────────────────────
// MB.7 made every scale a closed enum specifically so an off-scale value is unrepresentable. That
// pays off here: `prism_tok_export_*` enumerates the enum, so a token added to the design system
// without being exported is impossible -- there is no "list of tokens to remember to update".
//
// ── FORMATS ─────────────────────────────────────────────────────────────────────────────────
// CSS custom properties and flat JSON. Both are hand-built: `to_json()` on an imported struct was
// measured mis-dispatching and reading OUT OF BOUNDS this session (repro:
// test_programs/_tojson_dispatch_test.nova), and an exporter's whole job is to emit a file
// someone else trusts.
// Names are `--prism-<group>-<step>` / `prism.<group>.<step>`: prefixed because these land in a
// global CSS namespace where an unprefixed `--space-md` would collide with the host page.
//
// PUBLIC API
//   prism_tok_pairs()          -> list<PrismTokPair>   every token, group+name+value+unit
//   prism_tok_count()          -> int
//   prism_tok_name(p) / _group(p) / _value(p) / _unit(p)
//   prism_tok_css_name(p)      -> string   "--prism-space-md"
//   prism_tok_json_name(p)     -> string   "prism.space.md"
//   prism_tok_export_css()     -> string   a `:root { ... }` block
//   prism_tok_export_json()    -> string   flat JSON object
//   prism_tok_find(name)       -> Result<PrismTokPair>   by json name

import prism_tokens

// `tk_` prefix: the struct field->slot map is GLOBAL, so a bare `name`/`value`/`group` would
// share a slot with any other module's field of that name.
type PrismTokPair
    tk_group: string
    tk_name: string
    tk_value: int
    tk_unit: string

fn prism_tok_group(p: PrismTokPair) -> string
    p.tk_group

fn prism_tok_name(p: PrismTokPair) -> string
    p.tk_name

fn prism_tok_value(p: PrismTokPair) -> int
    p.tk_value

fn prism_tok_unit(p: PrismTokPair) -> string
    p.tk_unit

fn prism_tok_css_name(p: PrismTokPair) -> string
    "--prism-{p.tk_group}-{p.tk_name}"

fn prism_tok_json_name(p: PrismTokPair) -> string
    "prism.{p.tk_group}.{p.tk_name}"

// Enumerated from the closed enums, never from a hand-kept list -- see the header.
fn _tok_space() -> list
    [prism_tokens.prism_space_none(), prism_tokens.prism_space_xs(), prism_tokens.prism_space_sm(), prism_tokens.prism_space_md(), prism_tokens.prism_space_lg(), prism_tokens.prism_space_xl(), prism_tokens.prism_space_xxl()]

fn _tok_radius() -> list
    [prism_tokens.prism_radius_none(), prism_tokens.prism_radius_sm(), prism_tokens.prism_radius_md(), prism_tokens.prism_radius_lg(), prism_tokens.prism_radius_pill()]

fn _tok_type() -> list
    [prism_tokens.prism_type_caption(), prism_tokens.prism_type_body(), prism_tokens.prism_type_title(), prism_tokens.prism_type_heading(), prism_tokens.prism_type_display()]

fn prism_tok_pairs() -> list
    let out = []
    for s in _tok_space()
        push(out, PrismTokPair("space", prism_tokens.prism_space_name(s), prism_tokens.prism_space_px(s), "px"))
    for r in _tok_radius()
        push(out, PrismTokPair("radius", prism_tokens.prism_radius_name(r), prism_tokens.prism_radius_px(r), "px"))
    // Type contributes TWO tokens per step: size and leading. They are exported as separate
    // tokens rather than one compound value because a consumer sets font-size and line-height
    // independently, and a "16/24" string would have to be parsed back apart by every consumer.
    for t in _tok_type()
        push(out, PrismTokPair("font-size", prism_tokens.prism_type_name(t), prism_tokens.prism_type_size_px(t), "px"))
    for t2 in _tok_type()
        push(out, PrismTokPair("line-height", prism_tokens.prism_type_name(t2), prism_tokens.prism_type_leading_px(t2), "px"))
    out

fn prism_tok_count() -> int
    len(prism_tok_pairs())

fn prism_tok_export_css() -> string
    let lines = prism_tok_pairs().map(fn(p) "  {prism_tok_css_name(p)}: {p.tk_value}{p.tk_unit};")
    ":root \{\n" + join(lines, "\n") + "\n}"

fn prism_tok_export_json() -> string
    let entries = prism_tok_pairs().map(fn(p) "\"{prism_tok_json_name(p)}\":{p.tk_value}")
    "\{" + join(entries, ",") + "}"

fn prism_tok_find(name) -> Result<PrismTokPair>
    if type_of(name) != "string"
        return err("prism_tokens(dev): token name must be a string, got {type_of(name)}")
    let hit = []
    for p in prism_tok_pairs()
        if prism_tok_json_name(p) == name
            push(hit, p)
    if len(hit) == 0
        return err("prism_tokens(dev): no token named '{name}'")
    ok(hit[0])
