// prism_ui_pager -- pagination components (prism/ui/ composition layer): windowed page nav bar,
// page-size selector, item-range info line, compact prev/label/next, and "load more". Each is a
// composition over the closed 22-primitive vocabulary (widget/), per PRISM_SPEC.md axiom A7.
//
// Differs from prism_ui_nav.prism_nav_pages (bands EVERY page 1..total, O(total) nodes, `press`
// actions): this is WINDOWED -- first page, last page, `pg_window` pages either side of current,
// O(window) nodes regardless of pg_total, real `prism_link` hrefs (deep-linkable). Both stay.
//
// The window walk is ONE code path, no "total fits in window" special case: win_lo/win_hi are
// clamped with max/min; page 1 is emitted before the window only if win_lo > 1 (ellipsis only when
// the gap is > 1 page); pg_total after only if win_hi < pg_total (same rule); win_lo..win_hi fills
// the middle. When the window already reaches both edges, both edge clauses fall away on their own
// and the walk degenerates to the unwindowed list -- no case to recognize up front.
//
// The ellipsis is the int `0` living in the SAME page-number list (never a real page -- every real
// page is drawn from [1, pg_total], validated >= 1 first): one list through
// prism_ui_kit.prism_ui_collect, not a second "is this a gap" list kept in lockstep.
//
// Every href is "/#page-N" / "/#size-N": prism_link's route validator (PRISM_SPEC.md 15.1) requires
// the path to start with "/", so a bare "#page-3" fragment is adapted to a validated route shape.
//
// Current-page / disabled-prev-next render as `label`, never `link`/`press` with a "disabled" flag
// -- neither carries one at this layer, and "go to where you already are" is not a real affordance.
//
// PUBLIC API (all Result<PrismNode>; every one validates, none fails silently)
//   prism_pg_pager(pg_current, pg_total, pg_window) -> band [prev, 1, (...)?, win_lo..win_hi,
//     (...)?, total, next]. rejects pg_total<1, pg_window<0, pg_current<1, pg_current>pg_total.
//   prism_pg_size_select(pg_label, pg_sizes, pg_selected) -> band [label, flow(sizes)]; selected
//     size is a label, every other a link to "/#size-N". rejects empty label/sizes, a non-int /
//     non-positive / duplicate size, or a selected not in pg_sizes.
//   prism_pg_info(pg_start, pg_end, pg_total_items) -> label "Showing {start}-{end} of {total}
//     items". rejects total_items<0, start<0, end<start, end>total_items (which alone also forces
//     total_items=0 => start=end=0 -- no separate check needed).
//   prism_pg_compact(pg_current, pg_total) -> band [prev, label("Page N of M"), next]. same
//     rejects as prism_pg_pager minus pg_window.
//   prism_pg_load_more(pg_label, pg_loaded, pg_total_items) -> loaded<total: stack [press(label),
//     label("{loaded} of {total} loaded")]; loaded>=total: label("All items loaded"). rejects
//     empty label, pg_loaded<0, pg_total_items<1.

import prism_arrange
import prism_content
import prism_interact
import prism_ui_kit

// Shared prev/next control for prism_pg_pager and prism_pg_compact -- always safe (text is always
// non-empty, the route is always "/#page-<positive int>") but `?`-propagated anyway, matching
// prism_fb_*'s own discipline of never assuming a Result is Ok just because a call is provably safe.
fn _prism_pg_control(text: string, target_page: int, enabled: bool) -> Result<PrismNode>
    prism_interact.prism_link(text, prism_interact.prism_link_target_route("/#page-{target_page}")) if enabled else prism_content.prism_label(text)

// One page indicator; `0` is the ellipsis sentinel (see header) -- checked first since it is never
// a real page number.
fn _prism_pg_page_item(n: int, current: int) -> Result<PrismNode>
    if n == 0
        return prism_content.prism_label("...")
    prism_content.prism_label(str(n)) if n == current else prism_interact.prism_link(str(n), prism_interact.prism_link_target_route("/#page-{n}"))

// ── 1. Windowed page nav bar ─────────────────────────────────────────────────────────────────────
fn prism_pg_pager(pg_current: int, pg_total: int, pg_window: int) -> Result<PrismNode>
    if pg_total < 1
        return err("prism_pg_pager: pg_total must be >= 1, got {pg_total}")
    if pg_window < 0
        return err("prism_pg_pager: pg_window must be >= 0, got {pg_window}")
    if pg_current < 1
        return err("prism_pg_pager: pg_current must be >= 1, got {pg_current}")
    if pg_current > pg_total
        return err("prism_pg_pager: pg_current ({pg_current}) must be <= pg_total ({pg_total})")
    let prev_node = _prism_pg_control("Previous", pg_current - 1, pg_current > 1)?
    let next_node = _prism_pg_control("Next", pg_current + 1, pg_current < pg_total)?
    let win_lo = max(1, pg_current - pg_window)
    let win_hi = min(pg_total, pg_current + pg_window)
    let head = ([1, 0] if win_lo > 2 else [1]) if win_lo > 1 else []
    let tail = ([0, pg_total] if win_hi < pg_total - 1 else [pg_total]) if win_hi < pg_total else []
    let nums = [...head, ...list_range_inclusive(win_lo, win_hi), ...tail]
    let items = prism_ui_kit.prism_ui_collect(nums, fn(n) _prism_pg_page_item(n, pg_current))?
    prism_arrange.prism_band([prev_node, ...items, next_node])

// ── 2. Page-size selector ────────────────────────────────────────────────────────────────────────
fn _prism_pg_size_item(size: int, selected: int) -> Result<PrismNode>
    prism_content.prism_label(str(size)) if size == selected else prism_interact.prism_link(str(size), prism_interact.prism_link_target_route("/#size-{size}"))

// Duplicate check keys on str(size), matching every other dict-keyed dup check in this codebase
// (prism_pick, prism_xf_index, prism_nav_menu all key a dict on a string, never a bare int).
fn prism_pg_size_select(pg_label: string, pg_sizes: list, pg_selected: int) -> Result<PrismNode>
    if len(pg_label) == 0
        return err("prism_pg_size_select: pg_label must not be empty")
    if len(pg_sizes) == 0
        return err("prism_pg_size_select: pg_sizes must not be empty")
    let seen = {}
    for idx, s in pg_sizes
        if not is_int(s)
            return err("prism_pg_size_select: pg_sizes[{idx}] must be an int, got {type_name(s)}")
        if s <= 0
            return err("prism_pg_size_select: pg_sizes[{idx}] must be > 0, got {s}")
        let key = str(s)
        if key in seen
            return err("prism_pg_size_select: duplicate size {s}")
        seen[key] = true
    if str(pg_selected) not in seen
        return err("prism_pg_size_select: pg_selected ({pg_selected}) is not one of pg_sizes")
    let label_node = prism_content.prism_label(pg_label)?
    let items = prism_ui_kit.prism_ui_collect(pg_sizes, fn(s) _prism_pg_size_item(s, pg_selected))?
    let flow_node = prism_arrange.prism_flow(items)?
    prism_arrange.prism_band([label_node, flow_node])

// ── 3. Item-range info line ──────────────────────────────────────────────────────────────────────
// The four checks below alone also force "pg_total_items=0 => start=end=0": end<=total forces
// end<=0, and end>=start>=0 then forces both to 0 -- no separate zero-case branch is needed.
fn prism_pg_info(pg_start: int, pg_end: int, pg_total_items: int) -> Result<PrismNode>
    if pg_total_items < 0
        return err("prism_pg_info: pg_total_items must be >= 0, got {pg_total_items}")
    if pg_start < 0
        return err("prism_pg_info: pg_start must be >= 0, got {pg_start}")
    if pg_end < pg_start
        return err("prism_pg_info: pg_end ({pg_end}) must be >= pg_start ({pg_start})")
    if pg_end > pg_total_items
        return err("prism_pg_info: pg_end ({pg_end}) must be <= pg_total_items ({pg_total_items})")
    prism_content.prism_label("Showing {pg_start}-{pg_end} of {pg_total_items} items")

// ── 4. Compact prev/label/next ───────────────────────────────────────────────────────────────────
fn prism_pg_compact(pg_current: int, pg_total: int) -> Result<PrismNode>
    if pg_total < 1
        return err("prism_pg_compact: pg_total must be >= 1, got {pg_total}")
    if pg_current < 1
        return err("prism_pg_compact: pg_current must be >= 1, got {pg_current}")
    if pg_current > pg_total
        return err("prism_pg_compact: pg_current ({pg_current}) must be <= pg_total ({pg_total})")
    let prev_node = _prism_pg_control("Previous", pg_current - 1, pg_current > 1)?
    let next_node = _prism_pg_control("Next", pg_current + 1, pg_current < pg_total)?
    let label_node = prism_content.prism_label("Page {pg_current} of {pg_total}")?
    prism_arrange.prism_band([prev_node, label_node, next_node])

// ── 5. Load more ─────────────────────────────────────────────────────────────────────────────────
// pg_loaded >= pg_total_items (not just ==) renders "done" -- an overshoot from a stale read is
// still nothing left to load, not an error this function polices.
fn prism_pg_load_more(pg_label: string, pg_loaded: int, pg_total_items: int) -> Result<PrismNode>
    if len(pg_label) == 0
        return err("prism_pg_load_more: pg_label must not be empty")
    if pg_loaded < 0
        return err("prism_pg_load_more: pg_loaded must be >= 0, got {pg_loaded}")
    if pg_total_items < 1
        return err("prism_pg_load_more: pg_total_items must be >= 1, got {pg_total_items}")
    if pg_loaded >= pg_total_items
        return prism_content.prism_label("All items loaded")
    let btn = prism_interact.prism_press(pg_label, [])?
    let progress = prism_content.prism_label("{pg_loaded} of {pg_total_items} loaded")?
    prism_arrange.prism_stack([btn, progress])
