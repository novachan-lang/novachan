import prism_node
import prism_arrange
import prism_content
import prism_interact

// PrismAnchor struct — all fields an_ prefixed
type PrismAnchor
    an_label: string
    an_url: string

fn prism_an_anchor(label: string, url: string) -> PrismAnchor
    PrismAnchor(label, url)

fn prism_an_label(a: PrismAnchor) -> string
    a.an_label

fn prism_an_url(a: PrismAnchor) -> string
    a.an_url

// Render a single anchor as a link node
fn prism_an_render(anchor: PrismAnchor) -> Result<PrismNode>
    if len(anchor.an_label) == 0
        return err("prism_an_render: label must not be empty")
    if len(anchor.an_url) == 0
        return err("prism_an_render: url must not be empty")
    let target = prism_interact.prism_link_target_url(anchor.an_url)
    prism_interact.prism_link(anchor.an_label, target)

// Render a vertical list of anchor links
fn prism_an_list(anchors: list) -> Result<PrismNode>
    if len(anchors) == 0
        return err("prism_an_list: anchors list must not be empty")
    let children = []
    let mut idx = 0
    for a in anchors
        if type_name(a) != "PrismAnchor"
            return err("prism_an_list: element " + str(idx) + " is not a PrismAnchor (got " + type_name(a) + ")")
        let link = prism_an_render(a)?
        children.push(link)
        idx += 1
    prism_arrange.prism_stack(children)

// Render an inline (horizontal) row of anchor links
fn prism_an_inline(anchors: list, separator: string) -> Result<PrismNode>
    if len(anchors) == 0
        return err("prism_an_inline: anchors list must not be empty")
    let children = []
    let mut idx = 0
    for a in anchors
        if type_name(a) != "PrismAnchor"
            return err("prism_an_inline: element " + str(idx) + " is not a PrismAnchor (got " + type_name(a) + ")")
        if idx > 0 and len(separator) > 0
            let sep = prism_content.prism_label(separator)?
            children.push(sep)
        let link = prism_an_render(a)?
        children.push(link)
        idx += 1
    prism_arrange.prism_band(children)

// Breadcrumb: inline links separated by " > "
fn prism_an_breadcrumb(anchors: list) -> Result<PrismNode>
    prism_an_inline(anchors, " > ")
