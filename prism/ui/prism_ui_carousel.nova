// prism_ui_carousel -- carousel/slideshow component (MB.29)
import prism_node
import prism_arrange
import prism_content
import prism_interact

type PrismSlide
    csl_title: string
    csl_content: string
    csl_image: string

fn prism_csl_slide(title: string, content: string, image: string) -> PrismSlide
    PrismSlide(title, content, image)

fn prism_csl_slide_title(s: PrismSlide) -> string
    s.csl_title

fn prism_csl_slide_content(s: PrismSlide) -> string
    s.csl_content

fn prism_csl_slide_image(s: PrismSlide) -> string
    s.csl_image

fn prism_csl_prev(current: int, total: int) -> int
    if total <= 0
        return 0
    if current <= 0
        return total - 1
    current - 1

fn prism_csl_next(current: int, total: int) -> int
    if total <= 0
        return 0
    if current >= total - 1
        return 0
    current + 1

fn _prism_csl_render_slide(slide: PrismSlide) -> Result<PrismNode>
    let children = []
    let h = prism_content.prism_label(slide.csl_title)?
    children.push(h)
    let c = prism_content.prism_label(slide.csl_content)?
    children.push(c)
    if len(slide.csl_image) > 0
        let img = prism_content.prism_art(slide.csl_image)?
        children.push(img)
    prism_arrange.prism_stack(children)

fn prism_csl_carousel(slides: list, current_idx: int) -> Result<PrismNode>
    if len(slides) == 0
        return err("prism_csl_carousel: slides list is empty")
    if current_idx < 0 or current_idx >= len(slides)
        return err("prism_csl_carousel: current_idx " + str(current_idx) + " out of bounds (0.." + str(len(slides) - 1) + ")")
    let mut idx = 0
    for s in slides
        if type_name(s) != "PrismSlide"
            return err("prism_csl_carousel: element " + str(idx) + " is not a PrismSlide (got " + type_name(s) + ")")
        idx += 1
    let slide = slides[current_idx]
    let slide_node = _prism_csl_render_slide(slide)?
    let prev_icon = prism_content.prism_icon_chevron_left()
    let prev_glyph = prism_content.prism_glyph(prev_icon)?
    let prev_btn = prism_interact.prism_press("Previous slide", [prev_glyph])?
    let next_icon = prism_content.prism_icon_chevron_right()
    let next_glyph = prism_content.prism_glyph(next_icon)?
    let next_btn = prism_interact.prism_press("Next slide", [next_glyph])?
    let nav_row = prism_arrange.prism_band([prev_btn, slide_node, next_btn])?
    let indicator = prism_content.prism_label(str(current_idx + 1) + " / " + str(len(slides)))?
    prism_arrange.prism_stack([nav_row, indicator])

fn prism_csl_filmstrip(slides: list, current_idx: int) -> Result<PrismNode>
    if len(slides) == 0
        return err("prism_csl_filmstrip: slides list is empty")
    if current_idx < 0 or current_idx >= len(slides)
        return err("prism_csl_filmstrip: current_idx " + str(current_idx) + " out of bounds (0.." + str(len(slides) - 1) + ")")
    let thumbs = []
    let mut idx = 0
    for s in slides
        if type_name(s) != "PrismSlide"
            return err("prism_csl_filmstrip: element " + str(idx) + " is not a PrismSlide (got " + type_name(s) + ")")
        let prefix = ""
        if idx == current_idx
            prefix = "[*] "
        else
            prefix = "[ ] "
        let lbl = prism_content.prism_label(prefix + s.csl_title)?
        thumbs.push(lbl)
        idx += 1
    prism_arrange.prism_band(thumbs)
