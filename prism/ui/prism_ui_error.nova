import prism_node
import prism_arrange
import prism_content
import prism_interact

// 1. Error boundary: if result is ok, show it; if err, show fallback error UI
//    Takes a Result<PrismNode> and returns PrismNode (never fails)
fn prism_eb_boundary(result: Result<PrismNode>, fallback_message: string) -> Result<PrismNode>
    if len(fallback_message) == 0
        return err("prism_eb_boundary: fallback_message must not be empty")
    if is_ok(result)
        return ok(unwrap(result))
    let icon = prism_content.prism_label("(!) ")?
    let msg = prism_content.prism_label(fallback_message)?
    prism_arrange.prism_band([icon, msg])

// 2. Error with detail: stack[error_message, detail_text]
fn prism_eb_detail(message: string, detail: string) -> Result<PrismNode>
    if len(message) == 0
        return err("prism_eb_detail: message must not be empty")
    if len(detail) == 0
        return err("prism_eb_detail: detail must not be empty")
    let icon = prism_content.prism_label("(!) ")?
    let msg = prism_content.prism_label(message)?
    let header = prism_arrange.prism_band([icon, msg])?
    let gap = prism_arrange.prism_gap(some(8))?
    let det = prism_content.prism_label(detail)?
    prism_arrange.prism_stack([header, gap, det])

// 3. Retry panel: stack[error_message, retry_button]
fn prism_eb_retry(message: string, retry_label: string) -> Result<PrismNode>
    if len(message) == 0
        return err("prism_eb_retry: message must not be empty")
    if len(retry_label) == 0
        return err("prism_eb_retry: retry_label must not be empty")
    let icon = prism_content.prism_label("(!) ")?
    let msg = prism_content.prism_label(message)?
    let header = prism_arrange.prism_band([icon, msg])?
    let gap = prism_arrange.prism_gap(some(12))?
    let btn_lbl = prism_content.prism_label(retry_label)?
    let btn = prism_interact.prism_press(retry_label, [btn_lbl])?
    prism_arrange.prism_stack([header, gap, btn])

// 4. Not found: stack["404", message, optional back_button]
fn prism_eb_not_found(message: string, back_label: string) -> Result<PrismNode>
    if len(message) == 0
        return err("prism_eb_not_found: message must not be empty")
    let code = prism_content.prism_label("404")?
    let msg = prism_content.prism_label(message)?
    let gap = prism_arrange.prism_gap(some(8))?
    if len(back_label) == 0
        return prism_arrange.prism_stack([code, gap, msg])
    let btn_lbl = prism_content.prism_label(back_label)?
    let btn = prism_interact.prism_press(back_label, [btn_lbl])?
    let gap2 = prism_arrange.prism_gap(some(12))?
    prism_arrange.prism_stack([code, gap, msg, gap2, btn])

// 5. Maintenance page: stack[title, message]
fn prism_eb_maintenance(title: string, message: string) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_eb_maintenance: title must not be empty")
    if len(message) == 0
        return err("prism_eb_maintenance: message must not be empty")
    let t = prism_content.prism_label(title)?
    let gap = prism_arrange.prism_gap(some(8))?
    let m = prism_content.prism_label(message)?
    prism_arrange.prism_stack([t, gap, m])
