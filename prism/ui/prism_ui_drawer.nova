import prism_node
import prism_arrange
import prism_content
import prism_interact

// 1. Drawer panel: layer[backdrop, drawer_content] when open; empty label when closed
//    drawer_content = stack[header_band(title + close_btn), body_stack]
fn prism_dr_drawer(title: string, content: list, open: bool) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_dr_drawer: title must not be empty")
    if len(content) == 0
        return err("prism_dr_drawer: content must not be empty")
    let mut idx = 0
    for c in content
        if type_name(c) != "PrismNode"
            return err("prism_dr_drawer: child " + str(idx) + " is not a PrismNode (got " + type_name(c) + ")")
        idx += 1
    if not open
        return prism_content.prism_label("")
    let title_label = prism_content.prism_label(title)?
    let close_label = prism_content.prism_label("X")?
    let close_btn = prism_interact.prism_press("Close drawer", [close_label])?
    let header = prism_arrange.prism_band([title_label, close_btn])?
    let body = prism_arrange.prism_stack(content)?
    let gap = prism_arrange.prism_gap(some(8))?
    let panel = prism_arrange.prism_stack([header, gap, body])?
    let backdrop = prism_content.prism_label("")?
    prism_arrange.prism_layer([backdrop, panel])

// 2. Sidebar: permanent panel (always visible), band[sidebar_stack, main_content]
fn prism_dr_sidebar(nav_items: list, main_content: list) -> Result<PrismNode>
    if len(nav_items) == 0
        return err("prism_dr_sidebar: nav_items must not be empty")
    if len(main_content) == 0
        return err("prism_dr_sidebar: main_content must not be empty")
    let mut idx = 0
    for n in nav_items
        if type_name(n) != "PrismNode"
            return err("prism_dr_sidebar: nav_item " + str(idx) + " is not a PrismNode (got " + type_name(n) + ")")
        idx += 1
    idx = 0
    for m in main_content
        if type_name(m) != "PrismNode"
            return err("prism_dr_sidebar: main_content " + str(idx) + " is not a PrismNode (got " + type_name(m) + ")")
        idx += 1
    let sidebar = prism_arrange.prism_stack(nav_items)?
    let main = prism_arrange.prism_stack(main_content)?
    prism_arrange.prism_band([sidebar, main])

// 3. Drawer with trigger button: layer[trigger_button, drawer_when_open]
fn prism_dr_triggered(trigger_label: string, title: string, content: list, open: bool) -> Result<PrismNode>
    if len(trigger_label) == 0
        return err("prism_dr_triggered: trigger_label must not be empty")
    let btn_label = prism_content.prism_label(trigger_label)?
    let trigger = prism_interact.prism_press("Open " + title, [btn_label])?
    let drawer = prism_dr_drawer(title, content, open)?
    prism_arrange.prism_layer([trigger, drawer])

// 4. Navigation drawer: stack of nav labels with active marker
fn prism_dr_nav(items: list, active_index: int) -> Result<PrismNode>
    if len(items) == 0
        return err("prism_dr_nav: items must not be empty")
    if active_index < 0 or active_index >= len(items)
        return err("prism_dr_nav: active_index " + str(active_index) + " out of bounds (0.." + str(len(items) - 1) + ")")
    let children = []
    let mut idx = 0
    for item in items
        if type_name(item) != "string"
            return err("prism_dr_nav: item " + str(idx) + " is not a string (got " + type_name(item) + ")")
        let prefix = "  "
        if idx == active_index
            prefix = "> "
        let lbl = prism_content.prism_label(prefix + item)?
        children.push(lbl)
        idx += 1
    prism_arrange.prism_stack(children)
