import prism_node
import prism_arrange
import prism_content
import prism_interact

// 1. Copyable text: band[text_label, copy_button]
fn prism_cp_copyable(text: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_cp_copyable: text must not be empty")
    let lbl = prism_content.prism_label(text)?
    let btn_lbl = prism_content.prism_label("Copy")?
    let btn = prism_interact.prism_press("Copy to clipboard", [btn_lbl])?
    prism_arrange.prism_band([lbl, btn])

// 2. Code copy: band[code_label, copy_button] — for code snippets
fn prism_cp_code(code: string) -> Result<PrismNode>
    if len(code) == 0
        return err("prism_cp_code: code must not be empty")
    let lbl = prism_content.prism_label(code)?
    let btn_lbl = prism_content.prism_label("Copy")?
    let btn = prism_interact.prism_press("Copy code", [btn_lbl])?
    prism_arrange.prism_band([lbl, btn])

// 3. Copy with feedback: band[text_label, button_showing_state]
//    copied=true shows "Copied!", copied=false shows "Copy"
fn prism_cp_feedback(text: string, copied: bool) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_cp_feedback: text must not be empty")
    let lbl = prism_content.prism_label(text)?
    let btn_text = "Copy"
    if copied
        btn_text = "Copied!"
    let btn_lbl = prism_content.prism_label(btn_text)?
    let btn = prism_interact.prism_press("Copy to clipboard", [btn_lbl])?
    prism_arrange.prism_band([lbl, btn])

// 4. Share link: band[url_label, copy_button, share_button]
fn prism_cp_share(url: string) -> Result<PrismNode>
    if len(url) == 0
        return err("prism_cp_share: url must not be empty")
    let lbl = prism_content.prism_label(url)?
    let copy_lbl = prism_content.prism_label("Copy")?
    let copy_btn = prism_interact.prism_press("Copy link", [copy_lbl])?
    let share_lbl = prism_content.prism_label("Share")?
    let share_btn = prism_interact.prism_press("Share link", [share_lbl])?
    prism_arrange.prism_band([lbl, copy_btn, share_btn])

// 5. Labeled copy: stack[label, band[value, copy_button]]
fn prism_cp_labeled(label: string, value: string) -> Result<PrismNode>
    if len(label) == 0
        return err("prism_cp_labeled: label must not be empty")
    if len(value) == 0
        return err("prism_cp_labeled: value must not be empty")
    let lbl = prism_content.prism_label(label)?
    let val = prism_content.prism_label(value)?
    let btn_lbl = prism_content.prism_label("Copy")?
    let btn = prism_interact.prism_press("Copy " + label, [btn_lbl])?
    let row = prism_arrange.prism_band([val, btn])?
    prism_arrange.prism_stack([lbl, row])
