// prism_ui_splitter -- Splitter / resizable-panes component family (prism/ui/ composition layer):
// a horizontal split, a vertical split, an N-pane band, a titled horizontal split, and a
// collapsed-pane indicator. Composition over the closed 22-primitive vocabulary (widget/), per
// PRISM_SPEC.md axiom A7.
//
// ── WHY THE DIVIDER IS A LABEL, NOT A NEW PRIMITIVE ───────────────────────────────────────────
// prism_node.nova has no "resize handle" or "drag position" attr anywhere in the 22-primitive
// vocabulary, so a splitter's divider is rendered as TEXT (a `label`'s own string) -- the same
// trick prism_ui_slider.nova uses for a thumb position and prism_ui_tabs.nova uses for the active
// tab. The vocabulary stays closed; the divider glyph AND the ratio it represents both live in the
// string content a `label` already legally carries, so `"{left_pct}|{right_pct}"` both draws the
// divider and records the split ratio in one node instead of needing a second attr channel.
//
// ── PANES: THE RATIO IS BUILT FROM panes.zip(pcts), NOT DISCARDED AFTER VALIDATION ───────────
// `prism_spl_panes` validates every pct up front (>=1, sums to 100), but the validated values are
// not thrown away once the check passes -- each divider between pane i-1 and pane i is labelled
// with BOTH adjacent percentages ("{pcts[i-1]}|{pcts[i]}"), so the same zip that drives pane
// placement also drives what every divider says. A bare "|" between panes would satisfy "N panes
// separated by dividers" but would silently drop the one piece of information (the ratio) that
// makes a splitter different from a plain `band`.
//
// ── `panes` IS A BARE `list`, NOT `list<PrismNode>` -- SAME CAUTION AS EVERY PRIOR COMPONENT ──
// Mirroring prism_node.nova's own self-referential-generic caution (and prism_ui_card.nova /
// prism_ui_color_pick.nova's identical choice for the same reason), `panes` is untyped at the
// list level, so each element is guarded with `type_name(p) != "PrismNode"`, naming the offending
// index and actual type on rejection rather than corrupting the tree with a garbage child.
//
// ── LABELED SPLIT COMPOSES split_h, IT DOES NOT DUPLICATE IT ──────────────────────────────────
// `prism_spl_labeled_split` wraps each side as `stack[title, content]` and then calls
// `prism_spl_split_h` on the two wrapped panes -- the pct validation and the ratio-recording
// divider are inherited for free instead of being re-derived at a second call site.
//
// PUBLIC API (all Result<PrismNode>; every one validates, none fails silently)
//   prism_spl_split_h(left, right, left_pct)                    -> band[left, divider("|ratio"), right]
//     rejects left_pct outside [1, 99] -- 0 or 100 collapses a pane entirely, which is not a split.
//   prism_spl_split_v(top, bottom, top_pct)                     -> stack[top, divider("---ratio---"), bottom]
//     same pct rejection as split_h.
//   prism_spl_panes(panes, pcts)                                -> band[pane, divider, pane, divider, ...]
//     rejects unequal lengths, fewer than 2 panes, any non-PrismNode pane, any pct < 1, and a pct
//     sum != 100.
//   prism_spl_labeled_split(left_title, left, right_title, right, left_pct) -> split_h of two
//     stack[title, content] panes. Rejects an empty title on either side (same pct rejection as
//     split_h, inherited).
//   prism_spl_collapsed(content, side)                          -> band/stack[indicator, content]
//     (or content first, for "right"/"bottom") rejects any `side` outside
//     {"left", "right", "top", "bottom"}, naming the allowed set.

import prism_node
import prism_arrange
import prism_content

// Vertical divider glyph (prism_spl_split_h, prism_spl_panes) and the glyph-run width for the
// horizontal divider (prism_spl_split_v) -- see header note on why the divider is a label.
let PRISM_SPL_VBAR = "|"
let PRISM_SPL_HDIV_WIDTH = 3

// The closed set of sides a collapsed pane can be pinned to.
let PRISM_SPL_SIDES = ["left", "right", "top", "bottom"]

// ── 1. Horizontal split ────────────────────────────────────────────────────────────────────────
fn prism_spl_split_h(left: PrismNode, right: PrismNode, left_pct: int) -> Result<PrismNode>
    if left_pct < 1 or left_pct > 99
        return err("prism_spl_split_h: left_pct ({left_pct}) must be in [1, 99] -- 0 or 100 collapses one pane entirely, which is not a split")
    let right_pct = 100 - left_pct
    let divider = prism_content.prism_label("{PRISM_SPL_VBAR}{left_pct}/{right_pct}")?
    prism_arrange.prism_band([left, divider, right])

// ── 2. Vertical split ──────────────────────────────────────────────────────────────────────────
fn prism_spl_split_v(top: PrismNode, bottom: PrismNode, top_pct: int) -> Result<PrismNode>
    if top_pct < 1 or top_pct > 99
        return err("prism_spl_split_v: top_pct ({top_pct}) must be in [1, 99] -- 0 or 100 collapses one pane entirely, which is not a split")
    let bottom_pct = 100 - top_pct
    let bar = str_repeat("-", PRISM_SPL_HDIV_WIDTH)
    let divider = prism_content.prism_label("{bar}{top_pct}/{bottom_pct}{bar}")?
    prism_arrange.prism_stack([top, divider, bottom])

// ── 3. N-pane band ─────────────────────────────────────────────────────────────────────────────
fn prism_spl_panes(panes: list, pcts: list) -> Result<PrismNode>
    if len(panes) != len(pcts)
        return err("prism_spl_panes: panes ({len(panes)}) and pcts ({len(pcts)}) must be the same length")
    if len(panes) < 2
        return err("prism_spl_panes: needs at least 2 panes, got {len(panes)}")
    for i, p in panes
        if type_name(p) != "PrismNode"
            return err("prism_spl_panes: panes[{i}] is not a PrismNode (got {type_name(p)})")
    for i, pct in pcts
        if pct < 1
            return err("prism_spl_panes: pcts[{i}] ({pct}) must be >= 1")
    let total = pcts.sum()
    if total != 100
        return err("prism_spl_panes: pcts must sum to 100, got {total}")
    let items = []
    for i, pair in panes.zip(pcts)
        if i > 0
            let divider = prism_content.prism_label("{pcts[i - 1]}{PRISM_SPL_VBAR}{pair[1]}")?
            items.push(divider)
        items.push(pair[0])
    prism_arrange.prism_band(items)

// ── 4. Titled horizontal split ─────────────────────────────────────────────────────────────────
fn prism_spl_labeled_split(left_title: string, left: PrismNode, right_title: string, right: PrismNode, left_pct: int) -> Result<PrismNode>
    if len(left_title) == 0
        return err("prism_spl_labeled_split: left_title must not be empty")
    if len(right_title) == 0
        return err("prism_spl_labeled_split: right_title must not be empty")
    let lt = prism_content.prism_label(left_title)?
    let rt = prism_content.prism_label(right_title)?
    let left_pane = prism_arrange.prism_stack([lt, left])?
    let right_pane = prism_arrange.prism_stack([rt, right])?
    prism_spl_split_h(left_pane, right_pane, left_pct)

// ── 5. Collapsed-pane indicator ────────────────────────────────────────────────────────────────
// The indicator sits on the side named by `side`: before `content` for "left"/"top", after it for
// "right"/"bottom" -- the same side that collapsed is the side the strip appears on. "left"/"right"
// arrange as a `band` (horizontal neighbors); "top"/"bottom" arrange as a `stack` (vertical
// neighbors), matching the axis the collapse happened on.
fn prism_spl_collapsed(content: PrismNode, side: string) -> Result<PrismNode>
    if side not in PRISM_SPL_SIDES
        let allowed = join(PRISM_SPL_SIDES, ", ")
        return err("prism_spl_collapsed: side must be one of {allowed}, got '{side}'")
    let glyph_text = ">" if side == "left" else ("<" if side == "right" else ("v" if side == "top" else "^"))
    let indicator = prism_content.prism_label(glyph_text)?
    let before = side == "left" or side == "top"
    let children = [indicator, content] if before else [content, indicator]
    prism_arrange.prism_band(children) if (side == "left" or side == "right") else prism_arrange.prism_stack(children)
