import prism_node
import prism_arrange
import prism_content

// Simple blockquote: band["|", text_label]
fn prism_qt_quote(text: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_qt_quote: text must not be empty")
    let bar = prism_content.prism_label("|")?
    let body = prism_content.prism_label(text)?
    prism_arrange.prism_band([bar, body])

// Attributed quote: stack[quote, attribution]
fn prism_qt_attributed(text: string, author: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_qt_attributed: text must not be empty")
    if len(author) == 0
        return err("prism_qt_attributed: author must not be empty")
    let quote = prism_qt_quote(text)?
    let attr = prism_content.prism_label("— " + author)?
    prism_arrange.prism_stack([quote, attr])

// Pull quote: stack[open_mark, text, close_mark] (decorative)
fn prism_qt_pullquote(text: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_qt_pullquote: text must not be empty")
    let open_mark = prism_content.prism_label("\"")?
    let body = prism_content.prism_label(text)?
    let close_mark = prism_content.prism_label("\"")?
    prism_arrange.prism_stack([open_mark, body, close_mark])

// Callout box: band[prefix_label, stack[title, body]]
fn prism_qt_callout(prefix: string, title: string, body: string) -> Result<PrismNode>
    if len(prefix) == 0
        return err("prism_qt_callout: prefix must not be empty")
    if len(title) == 0
        return err("prism_qt_callout: title must not be empty")
    let pfx = prism_content.prism_label(prefix)?
    let t = prism_content.prism_label(title)?
    let children = [t]
    if len(body) > 0
        let b = prism_content.prism_label(body)?
        children.push(b)
    let right = prism_arrange.prism_stack(children)?
    prism_arrange.prism_band([pfx, right])
