// prism_ui_settings -- settings/preferences panel components (prism/ui/, milestone MB.27): a
// labelled on/off row, a labelled single-choice row, a titled group of rows, and the page those
// groups are assembled into. Every one is a COMPOSITION over the closed 22-primitive vocabulary
// (widget/), built through prism_arrange/prism_content/prism_interact directly and
// prism_ui_kit.nova wherever it fits -- no new PrismNodeKind (PRISM_SPEC.md axiom A7), the same
// discipline every prism_ui_*.nova file in this codebase follows. This is the iOS Settings /
// Android Settings / Ant Design "Form-in-a-List" family: a switch row, a picker row, a titled
// section, and the screen those sections are laid out on.
//
// ── WHY prism_cfg_toggle REUSES cfg_label AS THE FLAG'S OWN ACCESSIBLE NAME, NOT A 2ND PARAM ────
// `prism_interact.prism_flag(label: string, state: bool)` requires ITS OWN non-empty accessible
// name (PRISM_SPEC.md §9, enforced in prism_interact.nova). In every real settings row (iOS's
// "Wi-Fi" switch, Android's "Dark theme" switch, Ant Design's `List.Item` + `Switch`), the row's
// VISIBLE text and the control's ACCESSIBLE name are the identical string -- a screen reader
// announcing anything other than the row's own label for its own switch would be actively
// misleading. Passing `cfg_label` straight through to `prism_flag` is therefore not a shortcut, it
// is the only correct choice: a second `toggle_a11y_name` parameter would let a caller supply two
// different texts and manufacture exactly the mismatch above, for zero benefit any real caller has
// ever needed.
//
// ── WHY cfg_description TOLERANT-DEGRADES `Some("")` TO THE SAME SHAPE AS `None` ────────────────
// Same rule `prism_rt_review`'s `rt_date`, `prism_nt_item`'s `nt_time`, and
// `prism_ui_feedback.prism_fb_alert`'s `detail` already apply (see each file's own header): "no
// description" and "description is the empty string" are different facts, but rendering the
// latter as a stray blank label under the title helps no one and reads as a bug, not an
// intentional layout. `cfg_description` therefore only contributes a second label when it is
// `Some` AND non-empty; `_prism_cfg_desc_part` is this file's version of the same 0-or-1-element
// splice helper `_prism_nt_opt_part`/`_prism_rt_...` already use.
//
// ── WHY cfg_choice's OPTIONS ARE VALUE==LABEL, NOT TWO SEPARATE STRINGS ───────────────────────────
// The task's own shape for `cfg_options` is a bare `list` of plain strings -- there is no second
// "internal id" channel anywhere in it, unlike `prism_interact.PrismPickOption`'s general
// value/label split (built for callers who DO have a separate stored id vs. display text, e.g. a
// country code vs. its name). `prism_ui_color_pick.prism_cp_picker` already made the identical
// call for its own bare `list<string>` of hex swatches (the hex string is both the identity and
// the display text); this file follows that exact precedent rather than inventing a second
// convention for the same shape -- each raw string becomes
// `prism_interact.prism_pick_option(s, s)`.
//
// ── WHY cfg_choice REJECTS `cfg_selected` NOT AMONG `cfg_options`, RATHER THAN ALLOWING "" AS
//    "NO SELECTION" (prism_interact.prism_pick's OWN, LAXER RULE) ────────────────────────────────
// `prism_pick` itself treats `selected_value == ""` as a legitimate "nothing currently selected"
// state (its own header: "selected_value == '' means no current selection and is always
// allowed"). A settings CHOICE row is a narrower case: every real settings picker (theme:
// light/dark/system, language, notification sound) always has a concrete ACTIVE value in effect --
// there is no "no preference chosen yet" state a settings page ever renders, the row exists to
// show and change whichever value already applies. So this file adds its OWN, stricter check on
// top of `prism_pick`'s: `cfg_selected` must name one of `cfg_options`, full stop. An empty
// `cfg_selected` is rejected exactly like any other value absent from the list -- it is simply
// never a member of a non-empty string list unless the caller literally put `""` in
// `cfg_options`, which stays legal and is treated the same as any other option string.
//
// ── WHY prism_cfg_group's GAP IS 8 AND prism_cfg_page's IS 16, NOT THE SAME CONSTANT ─────────────
// A two-level visual hierarchy, the same one iOS's grouped table view and Ant Design's `List`
// sections both use: a SMALL gap separates rows WITHIN one titled group (`PRISM_CFG_GROUP_GAP`,
// matching `prism_ui_notice.prism_nt_group`'s own `8`), and a LARGER gap separates whole GROUPS on
// a page (`PRISM_CFG_PAGE_GAP`, double the row-level gap) -- so a page with several groups reads
// visibly as several sections, not one long undifferentiated list of rows.
//
// ── WHY prism_cfg_group/prism_cfg_page DO NOT SHARE ONE PRIVATE HELPER DESPITE THE NEAR-IDENTICAL
//    SHAPE ─────────────────────────────────────────────────────────────────────────────────────
// Both are `stack[label(title), gap(N), stack(items)]` with only the gap size and the error-
// message wording ("settings" vs. "groups") differing. `prism_ui_notice.nova` already establishes
// the precedent for this exact situation: `prism_nt_list` and `prism_nt_group`, in the SAME file,
// each carry their own independent `for idx, it in items: if type_name(it) != "PrismNode"` loop
// rather than sharing one parameterized helper. Following that precedent here keeps each
// function's own error string self-contained and independently editable, instead of growing a
// shared helper whose signature would need to smuggle "which noun goes in the error message"
// through as an extra parameter.
//
// ── FIELD-SLOT COLLISION: N/A -- THIS FILE DECLARES NO STRUCTS OR ENUMS ───────────────────────────
// Every value here is a plain scalar (`string`/`bool`) or a `PrismNode` built through
// `prism_content`/`prism_arrange`/`prism_interact`'s own already-safe constructors -- no new
// `type` or `enum`, so the "prefix every field" discipline
// (reference_field_slot_collision_scales_with_imports.md) has nothing to apply to here.
//
// PUBLIC API
//   prism_cfg_toggle(cfg_label: string, cfg_description: string?, cfg_on: bool) -> Result<PrismNode>
//     -> band[stack[label(cfg_label), label(cfg_description)?], flag(cfg_label, cfg_on)]
//     a present-but-empty cfg_description degrades to the same shape as None (see header).
//     Rejects an empty cfg_label.
//   prism_cfg_choice(cfg_label: string, cfg_options: list, cfg_selected: string) -> Result<PrismNode>
//     -> stack[label(cfg_label), pick(options, cfg_selected)]; cfg_options: bare list<string>,
//     each converted to a PrismPickOption(value=s, label=s) (see header). Rejects an empty
//     cfg_label, an empty cfg_options, a non-string element (named by index and actual type), a
//     duplicate option string (via prism_pick's own check), and a cfg_selected not among
//     cfg_options (checked here -- stricter than prism_pick's own "" == no-selection allowance,
//     see header).
//   prism_cfg_group(cfg_title: string, settings: list) -> Result<PrismNode>
//     -> stack[label(cfg_title), gap(8), stack(settings)]; settings: bare list<PrismNode>
//     (runtime-checked). Rejects an empty cfg_title, an empty settings list, and a non-PrismNode
//     element (named by index and actual type).
//   prism_cfg_page(cfg_title: string, groups: list) -> Result<PrismNode>
//     -> stack[label(cfg_title), gap(16), stack(groups)]; groups: bare list<PrismNode>
//     (runtime-checked, typically each built by prism_cfg_group). Rejects an empty cfg_title, an
//     empty groups list, and a non-PrismNode element (named by index and actual type).

import prism_arrange
import prism_content
import prism_interact
import prism_ui_kit

// ── Toggle: a labelled on/off row ─────────────────────────────────────────────────────────────

// 0-or-1-element splice for the optional description, tolerant-degrading a present-but-empty
// `Some("")` to the same "[]" shape as `None` -- see header.
fn _prism_cfg_desc_part(cfg_description: string?) -> Result<list>
    match cfg_description
        None => ok([])
        Some(text) =>
            if len(text) == 0
                return ok([])
            let node = prism_content.prism_label(text)?
            ok([node])

fn prism_cfg_toggle(cfg_label: string, cfg_description: string?, cfg_on: bool) -> Result<PrismNode>
    if len(cfg_label) == 0
        return err("prism_cfg_toggle: cfg_label must not be empty")
    let label_node = prism_content.prism_label(cfg_label)?
    let desc_parts = _prism_cfg_desc_part(cfg_description)?
    let text_stack = prism_arrange.prism_stack([label_node, ...desc_parts])?
    // cfg_label doubles as the flag's own accessible name -- see header.
    let flag_node = prism_interact.prism_flag(cfg_label, cfg_on)?
    prism_arrange.prism_band([text_stack, flag_node])

// ── Choice: a labelled single-select row ──────────────────────────────────────────────────────

// `cfg_options` is a bare `list` (not `list<string>` -- mirroring every other bare-list parameter
// in this codebase's ui/ layer), so every element is guarded with the same `is_string(...)` check
// `prism_cp_picker`/`prism_ui_kv` already use, naming the offending index and actual type on
// rejection, BEFORE anything downstream reads it as a string.
fn prism_cfg_choice(cfg_label: string, cfg_options: list, cfg_selected: string) -> Result<PrismNode>
    if len(cfg_label) == 0
        return err("prism_cfg_choice: cfg_label must not be empty")
    if len(cfg_options) == 0
        return err("prism_cfg_choice: cfg_options must not be empty")
    for idx, o in cfg_options
        if not is_string(o)
            return err("prism_cfg_choice: cfg_options[" + str(idx) + "] is not a string (got " + type_name(o) + ")")
    // Stricter than prism_pick's own "" == no-selection allowance -- see header.
    if cfg_selected not in cfg_options
        return err("prism_cfg_choice: cfg_selected '" + cfg_selected + "' is not one of cfg_options")
    let label_node = prism_content.prism_label(cfg_label)?
    let mk = fn(s) ok(prism_interact.prism_pick_option(s, s))
    let opts = prism_ui_kit.prism_ui_collect(cfg_options, mk)?
    // prism_pick itself still rejects a duplicate option string here (its own "seen" check).
    let pick_node = prism_interact.prism_pick(opts, cfg_selected)?
    prism_arrange.prism_stack([label_node, pick_node])

// ── Group: a titled section of already-built setting rows ────────────────────────────────────

let PRISM_CFG_GROUP_GAP = 8

// `settings` is a bare `list` (not `list<PrismNode>` -- same self-referential-generic caution
// prism_node.nova's own header documents), so every element is guarded with the same
// `type_name(...) != "PrismNode"` check `prism_nt_group`/`prism_rt_review_list` already use,
// naming the offending index and actual type on rejection.
fn prism_cfg_group(cfg_title: string, settings: list) -> Result<PrismNode>
    if len(cfg_title) == 0
        return err("prism_cfg_group: cfg_title must not be empty")
    if len(settings) == 0
        return err("prism_cfg_group: settings must not be empty")
    for idx, s in settings
        if type_name(s) != "PrismNode"
            return err("prism_cfg_group: settings[" + str(idx) + "] is not a PrismNode (got " + type_name(s) + ")")
    let title_node = prism_content.prism_label(cfg_title)?
    let gap_node = prism_arrange.prism_gap(some(PRISM_CFG_GROUP_GAP))?
    let settings_node = prism_arrange.prism_stack(settings)?
    prism_arrange.prism_stack([title_node, gap_node, settings_node])

// ── Page: a titled screen of already-built groups ─────────────────────────────────────────────

// Double the group-level gap -- see header for the two-level visual hierarchy this establishes.
let PRISM_CFG_PAGE_GAP = 16

fn prism_cfg_page(cfg_title: string, groups: list) -> Result<PrismNode>
    if len(cfg_title) == 0
        return err("prism_cfg_page: cfg_title must not be empty")
    if len(groups) == 0
        return err("prism_cfg_page: groups must not be empty")
    for idx, g in groups
        if type_name(g) != "PrismNode"
            return err("prism_cfg_page: groups[" + str(idx) + "] is not a PrismNode (got " + type_name(g) + ")")
    let title_node = prism_content.prism_label(cfg_title)?
    let gap_node = prism_arrange.prism_gap(some(PRISM_CFG_PAGE_GAP))?
    let groups_node = prism_arrange.prism_stack(groups)?
    prism_arrange.prism_stack([title_node, gap_node, groups_node])
