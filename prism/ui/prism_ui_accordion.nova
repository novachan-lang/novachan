import prism_node
import prism_arrange
import prism_content
import prism_interact

// 1. Collapsible panel: stack[header_button, content_or_nothing]
//    header is a press button with chevron_right (collapsed) or chevron_down (expanded)
fn prism_ac_panel(title: string, content: list, expanded: bool) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_ac_panel: title must not be empty")
    if len(content) == 0
        return err("prism_ac_panel: content must not be empty")
    let mut idx = 0
    for c in content
        if type_name(c) != "PrismNode"
            return err("prism_ac_panel: child " + str(idx) + " is not a PrismNode (got " + type_name(c) + ")")
        idx += 1
    let icon_label = prism_content.prism_label("v ")?
    if not expanded
        icon_label = prism_content.prism_label("> ")?
    let title_label = prism_content.prism_label(title)?
    let header_inner = prism_arrange.prism_band([icon_label, title_label])?
    let header = prism_interact.prism_press("Toggle " + title, [header_inner])?
    if expanded
        let body = prism_arrange.prism_stack(content)?
        return prism_arrange.prism_stack([header, body])
    prism_arrange.prism_stack([header])

// 2. Accordion group: stack of panels (mutual exclusion is caller's job — pure value)
fn prism_ac_group(panels: list, gap_px: int) -> Result<PrismNode>
    if len(panels) == 0
        return err("prism_ac_group: panels must not be empty")
    if gap_px <= 0
        return err("prism_ac_group: gap_px must be > 0")
    let children = []
    let mut idx = 0
    for p in panels
        if type_name(p) != "PrismNode"
            return err("prism_ac_group: panel " + str(idx) + " is not a PrismNode (got " + type_name(p) + ")")
        if idx > 0
            let g = prism_arrange.prism_gap(some(gap_px))?
            children.push(g)
        children.push(p)
        idx += 1
    prism_arrange.prism_stack(children)

// 3. Simple collapsible text: panel with a single label as content
fn prism_ac_text(title: string, text: string, expanded: bool) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_ac_text: title must not be empty")
    if len(text) == 0
        return err("prism_ac_text: text must not be empty")
    let body = prism_content.prism_label(text)?
    prism_ac_panel(title, [body], expanded)

// 4. FAQ item: stack[question_label, answer_panel] — answer is collapsible
fn prism_ac_faq(question: string, answer: string, expanded: bool) -> Result<PrismNode>
    if len(question) == 0
        return err("prism_ac_faq: question must not be empty")
    if len(answer) == 0
        return err("prism_ac_faq: answer must not be empty")
    let q = prism_content.prism_label("Q: " + question)?
    let a_body = prism_content.prism_label("A: " + answer)?
    let a_panel = prism_ac_panel("Answer", [a_body], expanded)?
    prism_arrange.prism_stack([q, a_panel])
