// prism_ui_switch -- Switch / Checkbox / Radio component family (prism/ui/ composition layer): a
// single on/off switch, a single checkbox, a checkbox group (independently toggleable items), a
// radio group (mutually exclusive choice), and a switch list (independent on/off switches driven
// by parallel `labels`/`states` lists). Composition over the closed 22-primitive vocabulary
// (widget/), per PRISM_SPEC.md axiom A7.
//
// prism_node.nova has no on/off or checked/unchecked attribute anywhere in the 22-primitive
// vocabulary, so every state here is rendered as TEXT -- the exact same trick prism_ui_slider.nova
// uses for a thumb position ("the position lives in the string content a `label` already legally
// carries") and prism_ui_tabs.nova uses for an active tab ("the marker lives in the STRING the
// label already carries, not a new widget concept"). The vocabulary stays closed; on/off,
// checked/unchecked and selected/unselected all live in the string content of a `label` node.
// (prism_interact.nova's `prism_flag` is the actual boolean INTERACTION primitive with a real a11y
// role -- but this file, like prism_ui_slider.nova and prism_ui_tabs.nova before it, is the
// composition layer: a text-rendered visual built from stack/band/label, not a thin rename of an
// existing primitive.)
//
// ── WHY band[label, glyph] FOR SWITCH BUT band[glyph, label] FOR CHECKBOX/RADIO ────────────────
// A toggle switch conventionally reads as "the thing being toggled, then its current state" ("Wi-Fi
// ... [ON]"), which is why the label comes first. A checkbox or radio button conventionally reads
// as "the mark, then what it marks" (a ballot glyph followed by its option), which is why the glyph
// comes first there. Both are the SAME two-node band -- the only difference is argument order --
// so this is a naming/ordering choice, not two different construction strategies.
//
// ── WHY ONE SHARED `_prism_swt_check_labels`, NOT THREE COPIES ──────────────────────────────────
// prism_swt_checkbox_group, prism_swt_radio_group and prism_swt_switch_list all take a `labels:
// list` with the identical requirement -- non-empty, every element a non-empty string -- exactly
// the same sharing prism_ui_tabs.nova's `_prism_tbs_check_titles` already does for its `titles`
// parameter. Written once here rather than three near-identical loops that could drift apart.
//
// ── WHY checked_indices IS VALIDATED SEPARATELY FROM MEMBERSHIP TESTING ─────────────────────────
// `prism_swt_checkbox_group` renders "is index i checked?" with a plain `i in checked_indices`
// membership test (correct regardless of whether the list is well-formed), but a caller passing a
// non-int element, an out-of-range index, or the same index twice is a bug worth REJECTING rather
// than silently accepting -- an out-of-range index can never be reached by `i in checked_indices`
// for any real row and would render as if it were simply ignored, and a duplicate index is
// ambiguous about intent. `_prism_swt_check_checked_indices` catches all three BEFORE any node is
// built, using the same "seen" dict-as-set de-duplication `prism_interact.prism_pick` uses for its
// option values.
//
// PUBLIC API (all Result<PrismNode>; every one validates, none fails silently)
//   prism_swt_switch(label, on)                    -> band[label, "[ON]"/"[OFF]"].
//     rejects an empty label.
//   prism_swt_checkbox(label, checked)              -> band["[x]"/"[ ]", label].
//     rejects an empty label.
//   prism_swt_checkbox_group(labels, checked_indices) -> stack[checkbox...].
//     rejects empty labels, a non-string/empty label, a non-int/out-of-range/duplicate checked
//     index.
//   prism_swt_radio_group(labels, selected)         -> stack[radio...], glyphs "(o)"/"( )".
//     same label rejects as checkbox_group, plus selected outside [0, len(labels)).
//   prism_swt_switch_list(labels, states)           -> stack[switch...], labels.zip(states)-driven.
//     same label rejects as checkbox_group, plus len(labels) != len(states) or a non-bool state.

import prism_node
import prism_arrange
import prism_content

// ── Shared validation ────────────────────────────────────────────────────────────────────────

fn _prism_swt_check_label(fn_name: string, label: string) -> Result<int>
    if len(label) == 0
        return err("{fn_name}: label must not be empty")
    ok(0)

// Shared by every group function below -- see header note.
fn _prism_swt_check_labels(fn_name: string, labels: list) -> Result<int>
    if len(labels) == 0
        return err("{fn_name}: labels must not be empty")
    for i, lbl in labels
        if not is_string(lbl)
            return err("{fn_name}: labels[{i}] must be a string, got {type_name(lbl)}")
        if len(lbl) == 0
            return err("{fn_name}: labels[{i}] must not be empty")
    ok(0)

// checked_indices: every element must be an int in [0, n), and no index may repeat -- see header
// note on why this is checked up front rather than left to fall out of membership testing.
fn _prism_swt_check_checked_indices(fn_name: string, checked_indices: list, n: int) -> Result<int>
    let seen = {}
    for i, idx in checked_indices
        if not is_int(idx)
            return err("{fn_name}: checked_indices[{i}] must be an int, got {type_name(idx)}")
        if idx < 0 or idx >= n
            return err("{fn_name}: checked_indices[{i}] ({idx}) must be in [0, {n})")
        if idx in seen
            return err("{fn_name}: checked_indices[{i}] ({idx}) is a duplicate")
        seen[idx] = true
    ok(0)

// ── 1. Single on/off switch ──────────────────────────────────────────────────────────────────
fn _prism_swt_switch_core(label: string, on: bool) -> Result<PrismNode>
    let glyph = "[ON]" if on else "[OFF]"
    let lbl = prism_content.prism_label(label)?
    let g = prism_content.prism_label(glyph)?
    prism_arrange.prism_band([lbl, g])

fn prism_swt_switch(label: string, on: bool) -> Result<PrismNode>
    _prism_swt_check_label("prism_swt_switch", label)?
    _prism_swt_switch_core(label, on)

// ── 2. Single checkbox ───────────────────────────────────────────────────────────────────────
fn _prism_swt_checkbox_core(label: string, checked: bool) -> Result<PrismNode>
    let glyph = "[x]" if checked else "[ ]"
    let g = prism_content.prism_label(glyph)?
    let lbl = prism_content.prism_label(label)?
    prism_arrange.prism_band([g, lbl])

fn prism_swt_checkbox(label: string, checked: bool) -> Result<PrismNode>
    _prism_swt_check_label("prism_swt_checkbox", label)?
    _prism_swt_checkbox_core(label, checked)

// ── 3. Checkbox group: independently toggleable items ───────────────────────────────────────
fn prism_swt_checkbox_group(labels: list, checked_indices: list) -> Result<PrismNode>
    _prism_swt_check_labels("prism_swt_checkbox_group", labels)?
    _prism_swt_check_checked_indices("prism_swt_checkbox_group", checked_indices, len(labels))?
    let items = []
    for i, lbl in labels
        let checked = i in checked_indices
        let item = _prism_swt_checkbox_core(lbl, checked)?
        items.push(item)
    prism_arrange.prism_stack(items)

// ── 4. Radio group: mutually exclusive choice ────────────────────────────────────────────────
fn _prism_swt_radio_core(label: string, selected: bool) -> Result<PrismNode>
    let glyph = "(o)" if selected else "( )"
    let g = prism_content.prism_label(glyph)?
    let lbl = prism_content.prism_label(label)?
    prism_arrange.prism_band([g, lbl])

fn prism_swt_radio_group(labels: list, selected: int) -> Result<PrismNode>
    _prism_swt_check_labels("prism_swt_radio_group", labels)?
    if selected < 0 or selected >= len(labels)
        return err("prism_swt_radio_group: selected ({selected}) must be in [0, {len(labels)})")
    let items = []
    for i, lbl in labels
        let item = _prism_swt_radio_core(lbl, i == selected)?
        items.push(item)
    prism_arrange.prism_stack(items)

// ── 5. Switch list: independent on/off switches, labels.zip(states)-driven ──────────────────
// The zip is used only to PAIR the two parallel lists into plain [label, state] elements -- the
// actual node construction stays a plain `for` loop (never `.map(fn(p) ...core(p)?)`), because a
// `?` inside a lambda body silently swallows its error instead of propagating it (verified trap,
// see this component's KAT header / MB.62's finding).
//
// ── VERIFIED, NEW: a `bool` stored in a plain `list` reads back as `type_name == "int"` ─────────
// A throwaway probe (`for i, s in [true, false]; is_bool(s)`) returns `false` and `type_name(s)`
// returns `"int"` for every element -- the exact int(0)/int(1) encoding prism_node.nova's own
// `prism_node_attr_bool` already documents for a bool read out of a DICT, now confirmed to also
// apply to a bool read out of a LIST. This REFINES that earlier note ("inline=int, fn-arg=bool"):
// passing the value as a function ARGUMENT (`is_bool(s)`, itself a call) does NOT restore the
// bool tag here, so the fn-arg boundary alone is not sufficient to recover it once a `bool` has
// passed through an untyped list. `is_bool`/`type_name` are therefore useless for rejecting a
// genuinely wrong state here -- so, following prism_node_attr_bool's own precedent, "int 0 or 1"
// is accepted as the alternate valid encoding of a bool and only a DIFFERENT scalar (a string, a
// float, an int outside {0,1}, ...) is rejected. (Separately verified harmless: passing this same
// int(0)/int(1) value into `_prism_swt_switch_core`'s `on: bool`-typed parameter DOES render the
// correct "[ON]"/"[OFF]" glyph -- the coercion happens at the typed-parameter boundary, just not
// at a bare function-argument boundary the way the dict case implied.)
fn prism_swt_switch_list(labels: list, states: list) -> Result<PrismNode>
    _prism_swt_check_labels("prism_swt_switch_list", labels)?
    if len(labels) != len(states)
        return err("prism_swt_switch_list: labels ({len(labels)}) and states ({len(states)}) must be the same length")
    for i, s in states
        let tn = type_name(s)
        let is_boolish = tn == "bool" or (tn == "int" and (s == 0 or s == 1))
        if not is_boolish
            return err("prism_swt_switch_list: states[{i}] must be a bool, got {tn}")
    let items = []
    for p in labels.zip(states)
        let item = _prism_swt_switch_core(p[0], p[1])?
        items.push(item)
    prism_arrange.prism_stack(items)
