import prism_node
import prism_arrange
import prism_content

// 1. Simple list item: band[bullet_label, text_label]
fn prism_ls_item(text: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_ls_item: text must not be empty")
    let bullet = prism_content.prism_label("• ")?
    let content = prism_content.prism_label(text)?
    prism_arrange.prism_band([bullet, content])

// 2. Numbered list item: band[number_label, text_label]
fn prism_ls_numbered(index: int, text: string) -> Result<PrismNode>
    if index < 0
        return err("prism_ls_numbered: index must be >= 0")
    if len(text) == 0
        return err("prism_ls_numbered: text must not be empty")
    let num = prism_content.prism_label(str(index + 1) + ". ")?
    let content = prism_content.prism_label(text)?
    prism_arrange.prism_band([num, content])

// 3. Description item: stack[term_label, description_label] (like HTML <dt>/<dd>)
fn prism_ls_desc(term: string, description: string) -> Result<PrismNode>
    if len(term) == 0
        return err("prism_ls_desc: term must not be empty")
    if len(description) == 0
        return err("prism_ls_desc: description must not be empty")
    let t = prism_content.prism_label(term)?
    let d = prism_content.prism_label("  " + description)?
    prism_arrange.prism_stack([t, d])

// 4. List container: stack of items with gap between
fn prism_ls_list(items: list, gap_px: int) -> Result<PrismNode>
    if len(items) == 0
        return err("prism_ls_list: items must not be empty")
    if gap_px <= 0
        return err("prism_ls_list: gap_px must be > 0")
    let children = []
    let mut idx = 0
    for item in items
        if type_name(item) != "PrismNode"
            return err("prism_ls_list: item " + str(idx) + " is not a PrismNode (got " + type_name(item) + ")")
        if idx > 0
            let g = prism_arrange.prism_gap(some(gap_px))?
            children.push(g)
        children.push(item)
        idx += 1
    prism_arrange.prism_stack(children)

// 5. Checklist item: band[icon, text_label] — check for done, minus for undone
fn prism_ls_check(text: string, done: bool) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_ls_check: text must not be empty")
    let icon_node = prism_content.prism_label("x")
    if done
        icon_node = prism_content.prism_label("[x] ")?
    else
        icon_node = prism_content.prism_label("[ ] ")?
    let content = prism_content.prism_label(text)?
    prism_arrange.prism_band([icon_node, content])
