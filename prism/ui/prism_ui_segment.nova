import prism_node
import prism_arrange
import prism_content
import prism_interact

// 1. Segment option: press button, selected one gets "[*] " prefix, unselected gets "[ ] "
fn prism_sg_option(label: string, selected: bool) -> Result<PrismNode>
    if len(label) == 0
        return err("prism_sg_option: label must not be empty")
    let prefix = "[ ] "
    if selected
        prefix = "[*] "
    let lbl = prism_content.prism_label(prefix + label)?
    prism_interact.prism_press("Select " + label, [lbl])

// 2. Segmented control: band of options, exactly one selected (by index)
fn prism_sg_segment(options: list, selected: int) -> Result<PrismNode>
    if len(options) == 0
        return err("prism_sg_segment: options must not be empty")
    if selected < 0 or selected >= len(options)
        return err("prism_sg_segment: selected " + str(selected) + " out of bounds (0.." + str(len(options) - 1) + ")")
    let children = []
    let mut idx = 0
    for opt in options
        if type_name(opt) != "string"
            return err("prism_sg_segment: option " + str(idx) + " is not a string (got " + type_name(opt) + ")")
        let is_sel = idx == selected
        let btn = prism_sg_option(opt, is_sel)?
        children.push(btn)
        idx += 1
    prism_arrange.prism_band(children)

// 3. Toggle group: like segment but vertical (stack), for settings panels
fn prism_sg_toggle_group(options: list, selected: int) -> Result<PrismNode>
    if len(options) == 0
        return err("prism_sg_toggle_group: options must not be empty")
    if selected < 0 or selected >= len(options)
        return err("prism_sg_toggle_group: selected " + str(selected) + " out of bounds (0.." + str(len(options) - 1) + ")")
    let children = []
    let mut idx = 0
    for opt in options
        if type_name(opt) != "string"
            return err("prism_sg_toggle_group: option " + str(idx) + " is not a string (got " + type_name(opt) + ")")
        let is_sel = idx == selected
        let btn = prism_sg_option(opt, is_sel)?
        children.push(btn)
        idx += 1
    prism_arrange.prism_stack(children)

// 4. Multi-select segment: band of options, multiple can be selected (by list of indices)
fn prism_sg_multi(options: list, selected_indices: list) -> Result<PrismNode>
    if len(options) == 0
        return err("prism_sg_multi: options must not be empty")
    // build set of selected indices
    let sel_set = {}
    for si in selected_indices
        if type_name(si) != "int"
            return err("prism_sg_multi: selected index is not an int (got " + type_name(si) + ")")
        if si < 0 or si >= len(options)
            return err("prism_sg_multi: selected index " + str(si) + " out of bounds (0.." + str(len(options) - 1) + ")")
        sel_set[str(si)] = true
    let children = []
    let mut idx = 0
    for opt in options
        if type_name(opt) != "string"
            return err("prism_sg_multi: option " + str(idx) + " is not a string (got " + type_name(opt) + ")")
        let is_sel = str(idx) in sel_set
        let btn = prism_sg_option(opt, is_sel)?
        children.push(btn)
        idx += 1
    prism_arrange.prism_band(children)
