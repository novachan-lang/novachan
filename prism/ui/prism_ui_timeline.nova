// prism_ui_timeline -- vertical timeline component (prism/ui/, composition layer): a single
// status-tagged entry, a plain event timeline, a step-indicator (order-tracking / wizard
// progress) timeline, and a changelog-style timeline. Every one is a COMPOSITION over the closed
// 22-primitive vocabulary (widget/), built through prism_ui_kit.nova's helpers wherever they fit
// -- no new PrismNodeKind (PRISM_SPEC.md axiom A7), same discipline as every other prism_ui_*.nova
// file in this tree.
//
// ── THIS IS NOT prism_ui_data.prism_ui_timeline, AND THE OVERLAP IS DELIBERATE, NOT MISSED ──────
// Grepped before writing a line of this file (CLAUDE.md's "does this already exist" discipline):
// prism_ui_data.nova ALREADY has a `PrismTimelineStatus` (TlDone/TlActive/TlPending, 3 values) and
// a `prism_ui_timeline(events: list)`. This file is a DIFFERENT, richer component, not a
// duplicate: `PrismTlStatus` here is its own 4-value enum (adds `TlError`, which the existing one
// has no case for at all -- a failed step in an order-tracking timeline is a real, common state
// that enum cannot represent), and every status here maps to a DISTINCT GLYPH via
// `prism_tl_status_icon` (the existing timeline tells active/pending apart only by a queryable
// attr string, rendering both as a bare label with no icon at all). Two closed enums sharing 3 of
// 4 bare variant names (`TlDone`/`TlActive`/`TlPending`) across two different files is already a
// tested, SAFE shape in this codebase -- prism_ui_token.nova's own header records the direct probe
// that proved two enums declaring the same bare variant name do not collide in NOVA's flat LLVM
// symbol space (constructors are mangled per-enum). This file's own type name (`PrismTlStatus`,
// not `PrismTimelineStatus`) and function prefix (`prism_tl_*`, not `prism_ui_timeline*`) keep the
// two components callable side by side with zero ambiguity at any call site.
//
// ── WHY prism_tl_status_icon SUBSTITUTES 2 OF THE 4 REQUESTED ICONS ─────────────────────────────
// The originating spec asked for `prism_icon_more()` (pending) and `prism_icon_edit()` (active).
// Neither exists -- verified by grep across prism/widget/prism_content.nova, the ONLY file that
// may declare a `PrismIcon` variant: the closed vocabulary there is exactly Check/Close/Search/
// Menu/Plus/Minus/ChevronUp/Down/Left/Right/Warning/Info (12, see that file's own header). Axiom
// A7 closes the PRIMITIVE vocabulary (PrismNodeKind), and PrismIcon is the identical closed-set
// discipline applied one layer up -- adding a 13th icon ad hoc for one component, rather than
// through prism_content.nova's own additive-extension path, would let every future component
// invent its own icon on demand, and the "closed, typed icon set" guarantee (PRISM_SPEC.md §8)
// would stop meaning anything. Two existing icons were chosen for the closest honest semantic fit
// instead:
//   `TlPending` -> `prism_icon_minus()` -- reuses prism_ui_input.nova's own precedent for this
//     EXACT icon meaning "neutral, nothing here yet" (that file's header, describing its stepper's
//     idle state) and prism_ui_data.nova's `PrismStatTrend.StatFlat()` ("no change yet"). A step
//     that has not started is the same "nothing to report yet" state.
//   `TlActive` -> `prism_icon_chevron_right()` -- the existing convention for "current position /
//     moving forward" (prism_ui_data.nova's `PrismStatTrend` already uses chevron-up/down for
//     directional state; a step wizard's "you are here, next thing happens" is the same pointer
//     idea, rotated to a single forward-pointing chevron rather than a bidirectional pair).
// `TlDone -> prism_icon_check()` and `TlError -> prism_icon_close()` match the originating spec
// exactly (both already exist), and the KAT proves all 4 stay pairwise distinct -- the entire
// payoff of doing this as an exhaustive match rather than "warning for everything else".
//
// ── WHY PrismTlChange's `tlc_date` IS THE ONE FIELD prism_tlc_new DOES NOT REJECT WHEN EMPTY ────
// `tlc_version` and `tlc_summary` are rejected empty (an unlabelled or content-free changelog
// entry is useless, same bar prism_fb_confirm's labels and prism_table_column's key/header get).
// `tlc_date` is deliberately NOT required: the Keep a Changelog convention (the de facto standard
// this component's shape is modeling) has a real, common "Unreleased" section with no date yet --
// forcing every entry to carry one would make that legitimate, common state unrepresentable
// without a caller smuggling a fake placeholder date, which is worse than allowing a real absence.
// `_prism_tl_changelog_desc` renders `summary` alone when `date` is empty rather than composing a
// leading "`: summary`" -- avoiding exactly the "blank line" / stray-punctuation failure mode
// prism_ui_kit's own `note: string?` handling and prism_fb_alert's `detail: string?` handling
// already guard against for optional text.
//
// ── WHY prism_tl_step_timeline REUSES prism_tl_item RATHER THAN prism_nav_steps' SHAPE ──────────
// prism_ui_nav.nova already has a step indicator (`prism_nav_steps`), also derived from a label
// list + a current index -- checked before writing this, and it is a DIFFERENT shape on purpose:
// it renders a horizontal `band` of plain labels distinguished only by a `step_state` attr (no
// icon at all, by design -- see that file's own header on why a non-interactive "you are here"
// indicator should not pretend to be a richer control). `prism_tl_step_timeline` is the vertical,
// icon-per-status TIMELINE rendering of the identical index-vs-current derivation (the same
// three-way `idx < current` / `idx == current` / `idx > current` split that file's own
// `_prism_nav_step_state_for` already established) -- Ant Design ships both a `Steps` and a
// `Timeline` component for exactly this reason: a horizontal wizard nav and a vertical status
// history read differently and are used in different places (a form wizard header vs. an
// order-tracking page). Composing this one out of `prism_tl_item` rather than re-deriving the
// icon-per-status logic a second time keeps the "each status maps to exactly one icon" guarantee
// in ONE place (`prism_tl_status_icon`) for every caller of this file, timeline or step-timeline.
//
// PUBLIC API
//   Status (closed, 4 values -- see header for the icon substitution)
//     PrismTlStatus                                      TlPending()|TlActive()|TlDone()|TlError()
//     prism_tl_pending() / _active() / _done() / _error()   cross-module ctors
//     prism_tl_status_name(s) -> string     exhaustive: "pending"|"active"|"done"|"error"
//     prism_tl_status_icon(s) -> PrismIcon  exhaustive, no wildcard, all 4 pairwise distinct
//   Components (all Result<PrismNode>; every one validates, none fails silently)
//     prism_tl_item(label, description: string?, status) -> band(icon+label), or stack adding a
//       description line beneath. Rejects an empty label; a present-but-empty description
//       degrades to no description (same tolerance as prism_ui_kit's `note: string?`).
//     prism_tl_timeline(items: list) -> stack(items)
//       items: list<PrismNode> (bare list, runtime-checked). Rejects an empty list and a
//       non-PrismNode element (named by index and actual type).
//     prism_tl_step_timeline(steps: list, current_index: int) -> stack(one prism_tl_item per step)
//       steps: list<string> (bare list, runtime-checked); index < current_index -> TlDone,
//       == current_index -> TlActive, > current_index -> TlPending. Rejects an empty steps list,
//       a non-string or empty step (named by index), and an out-of-range current_index.
//     prism_tl_changelog(entries: list) -> stack(one prism_tl_item per entry)
//       entries: list<PrismTlChange> (bare list, runtime-checked). version -> label, date+summary
//       -> description (date omitted from the text when absent, see header). Rejects an empty
//       list and a non-PrismTlChange element (named by index and actual type).
//   Struct
//     PrismTlChange { tlc_version, tlc_date, tlc_summary } (all `tlc_`-prefixed -- global
//       field-slot table, see prism_ui_nav.nova's header for the reproduced defect this avoids)
//     prism_tlc_new(version, date, summary) -> Result<PrismTlChange>
//       rejects an empty version or summary; date may be empty (see header)

import prism_arrange
import prism_content
import prism_ui_kit

// ── Status: closed, 4 values (see header) ────────────────────────────────────────────────────
enum PrismTlStatus
    TlPending()
    TlActive()
    TlDone()
    TlError()

fn prism_tl_pending() -> PrismTlStatus
    TlPending()
fn prism_tl_active() -> PrismTlStatus
    TlActive()
fn prism_tl_done() -> PrismTlStatus
    TlDone()
fn prism_tl_error() -> PrismTlStatus
    TlError()

// Exhaustive, no wildcard arm -- adding a 5th status without a case here is a compile error.
fn prism_tl_status_name(s: PrismTlStatus) -> string
    match s
        TlPending() => "pending"
        TlActive() => "active"
        TlDone() => "done"
        TlError() => "error"

// Exhaustive, no wildcard arm. Each arm names a DIFFERENT icon from the closed 12-icon set (see
// header for why 2 of the 4 are substitutes for icons that do not exist) -- the KAT proves all 4
// stay distinct.
fn prism_tl_status_icon(s: PrismTlStatus) -> PrismIcon
    match s
        TlPending() => prism_content.prism_icon_minus()
        TlActive() => prism_content.prism_icon_chevron_right()
        TlDone() => prism_content.prism_icon_check()
        TlError() => prism_content.prism_icon_close()

// ── Single timeline entry ─────────────────────────────────────────────────────────────────────
// icon + label (prism_ui_kit's `icon_text`), plus an optional description line stacked below --
// identical shape to prism_fb_alert's own title/detail split, for the identical reason (see that
// file's header: "no detail" and "detail is the empty string" are different facts).
fn prism_tl_item(label: string, description: string?, status: PrismTlStatus) -> Result<PrismNode>
    if len(label) == 0
        return err("prism_tl_item: label must not be empty")
    let head = prism_ui_kit.prism_ui_icon_text(prism_tl_status_icon(status), label)?
    match description
        None => ok(head)
        Some(text) =>
            if len(text) == 0
                return ok(head)
            let note = prism_content.prism_label(text)?
            prism_arrange.prism_stack([head, note])

// ── Plain event timeline ──────────────────────────────────────────────────────────────────────
// `items` is a bare `list` (not `list<PrismNode>` -- mirroring prism_node.nova's own
// self-referential-generic caution, and prism_tk_tag_group's identical choice for the identical
// reason), so every element is guarded with the same `type_name(...) != "PrismNode"` check,
// naming the offending index and actual type on rejection.
fn prism_tl_timeline(items: list) -> Result<PrismNode>
    if len(items) == 0
        return err("prism_tl_timeline: items must not be empty")
    for idx, it in items
        if type_name(it) != "PrismNode"
            return err("prism_tl_timeline: item " + str(idx) + " is not a PrismNode (got " + type_name(it) + ")")
    prism_arrange.prism_stack(items)

// ── Step-indicator timeline (order tracking / wizard progress) ───────────────────────────────
// See header for why this reuses prism_tl_item rather than prism_nav_steps' shape. Status is
// purely a function of position: strictly before current_index is TlDone, exactly at it is
// TlActive, strictly after is TlPending -- the same three-way split prism_ui_nav.nova's own
// `_prism_nav_step_state_for` already established for its own (differently-rendered) step nav.
fn _prism_tl_step_status(idx: int, current_index: int) -> PrismTlStatus
    if idx < current_index
        return prism_tl_done()
    if idx == current_index
        return prism_tl_active()
    prism_tl_pending()

// `steps`: bare `list` of strings (not `list<string>` -- same caution prism_tk_tag_input applies
// to its own bare-`list`-of-strings `tags` parameter). Checked in the order a caller would want to
// read them: every step's type and content first (a bad step makes checking current_index against
// the list meaningless), then current_index's own bounds, then built.
fn prism_tl_step_timeline(steps: list, current_index: int) -> Result<PrismNode>
    if len(steps) == 0
        return err("prism_tl_step_timeline: steps must not be empty")
    for idx, s in steps
        if not is_string(s)
            return err("prism_tl_step_timeline: step " + str(idx) + " is not a string (got " + type_name(s) + ")")
        if len(s) == 0
            return err("prism_tl_step_timeline: step " + str(idx) + " must not be empty")
    if current_index < 0 or current_index >= len(steps)
        return err("prism_tl_step_timeline: current_index " + str(current_index) + " out of bounds for " + str(len(steps)) + " step(s)")
    let out = []
    for idx, s in steps
        let item = prism_tl_item(s, none(), _prism_tl_step_status(idx, current_index))?
        out.push(item)
    prism_arrange.prism_stack(out)

// ── Changelog ──────────────────────────────────────────────────────────────────────────────────
// Fields are `tlc_`-prefixed -- see header, same collision discipline as every other struct in
// prism/ui/ (prism_ui_nav.nova's PrismBreadcrumbItem/PrismMenuEntry, prism_ui_data.nova's
// PrismUiListItem/PrismUiTreeNode/PrismUiTimelineEvent, ...).
type PrismTlChange
    tlc_version: string
    tlc_date: string
    tlc_summary: string

// Rejects an empty version or summary; date may be empty (see header: Keep a Changelog's
// "Unreleased" convention).
fn prism_tlc_new(version: string, date: string, summary: string) -> Result<PrismTlChange>
    if len(version) == 0
        return err("prism_tlc_new: version must not be empty")
    if len(summary) == 0
        return err("prism_tlc_new: summary must not be empty")
    ok(PrismTlChange(version, date, summary))

// `date + ": " + summary` when a date is present; `summary` alone when it is not -- avoids a
// stray leading "`: `" for an undated ("Unreleased") entry (see header).
fn _prism_tl_changelog_desc(e) -> string
    if len(e.tlc_date) == 0
        return e.tlc_summary
    e.tlc_date + ": " + e.tlc_summary

// Every changelog entry renders as TlDone -- a changelog entry, dated or not, records a release
// that has already been cut (even an "Unreleased" entry documents work already merged, not work
// in progress from THIS component's point of view); differentiating "the latest one" from the
// rest would be an assumption about caller intent this constructor has no basis for and nothing
// in the spec asks for.
fn _prism_tl_changelog_item(e) -> Result<PrismNode>
    prism_tl_item(e.tlc_version, some(_prism_tl_changelog_desc(e)), prism_tl_done())

// `entries`: bare `list` of PrismTlChange (same bare-list-with-runtime-guard discipline as
// prism_tl_timeline above). Rejects an empty list and a non-PrismTlChange element (named by
// index and actual type) before building anything.
fn prism_tl_changelog(entries: list) -> Result<PrismNode>
    if len(entries) == 0
        return err("prism_tl_changelog: entries must not be empty")
    for idx, e in entries
        if type_name(e) != "PrismTlChange"
            return err("prism_tl_changelog: entry " + str(idx) + " is not a PrismTlChange (got " + type_name(e) + ")")
    let mk = fn(e) _prism_tl_changelog_item(e)
    let nodes = prism_ui_kit.prism_ui_collect(entries, mk)?
    prism_arrange.prism_stack(nodes)
