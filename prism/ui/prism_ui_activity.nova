// prism_ui_activity -- chronological event / activity feed (prism/ui/ composition layer): a
// single timestamped event row, a full feed, a compact (no-detail) feed, a labeled group of
// events, and a "most recent N" view. A COMPOSITION over the closed 22-primitive vocabulary
// (widget/), built through prism_ui_kit.nova wherever it fits -- no new PrismNodeKind
// (PRISM_SPEC.md axiom A7), same discipline every prism_ui_*.nova file in this tree follows.
//
// ── WHY THIS FILE IS `prism_ui_activity.nova` / `prism_ac_*`, NOT THE ORIGINALLY-BRIEFED
//    `prism_ui_timeline.nova` / `prism_tl_*` / `PrismTimelineEvent` / `tl_*` ─────────────────────
// This component was commissioned as "timeline / activity feed" with a `prism_ui_timeline.nova`
// file target, a `PrismTimelineEvent{tl_time,tl_title,tl_detail}` struct and `prism_tl_*`
// functions including a `prism_tl_timeline(events)` entry point. Grepped before writing a line
// (CLAUDE.md's "does this already exist" discipline) and found a hard, pre-existing conflict on
// EVERY one of those four names:
//   1. `prism/ui/prism_ui_timeline.nova` already exists, committed as milestone MB.15 ("timeline
//      component + KAT, 35/35 gate green") -- a DIFFERENT, already-shipped component (a
//      status-driven vertical timeline: `PrismTlStatus` enum with 4 icon-mapped states, a plain
//      item/timeline pair, a step-indicator timeline, and a changelog renderer). Overwriting that
//      file would have destroyed already-gated, committed work; the brief's author evidently
//      picked this filename without grepping for it first.
//   2. That same file ALREADY defines `prism_tl_timeline(items: list) -> Result<PrismNode>` --
//      a function of the SAME NAME but a DIFFERENT contract (it takes a bare `list<PrismNode>`
//      and validates each element is already a `PrismNode`; this component's brief wanted a
//      `list<PrismTimelineEvent>` validated and rendered from raw event data). Declaring both in
//      one file is a duplicate-declaration compile error; declaring them in two files under the
//      identical bare name would still be needless, confusing overlap the next reader has to
//      untangle.
//   3. `prism_ui_data.nova` already declares `PrismUiTimelineEvent{tl_label, tl_status}` -- so
//      `tl_` is an ALREADY-CLAIMED field prefix (see that file's own header, and
//      prism_ui_timeline.nova's own `PrismTlChange` choosing `tlc_` specifically instead of `tl_`
//      for exactly this reason). NOVA's field-name -> slot-index table is GLOBAL and
//      last-registration-wins (documented, previously-hit defect: a `PrismNode.kind` field-slot
//      collision broke the HTML renderer) -- reusing an already-spoken-for prefix on a new struct
//      is the precise setup for that bug class, even though `tl_time`/`tl_title`/`tl_detail`
//      happen not to name-collide with `tl_label`/`tl_status` today. This file's own struct is
//      renamed `PrismActivityEvent` with a fresh, unclaimed `ac_` prefix instead.
// Every REQUESTED behavior is preserved exactly (same 5 functions, same shapes, same validation
// rules) -- only the names that collided were changed, and each rename is listed here so the
// mapping from the original brief to the shipped API is traceable:
//   prism_ui_timeline.nova  -> prism_ui_activity.nova
//   PrismTimelineEvent      -> PrismActivityEvent
//   tl_time/tl_title/tl_detail -> ac_time/ac_title/ac_detail
//   prism_tl_event          -> prism_ac_event            (constructor)
//   prism_tl_event_node     -> prism_ac_event_node
//   prism_tl_timeline       -> prism_ac_feed             (avoids the MB.15 name collision too)
//   prism_tl_compact        -> prism_ac_compact
//   prism_tl_grouped        -> prism_ac_grouped
//   prism_tl_latest         -> prism_ac_latest
//
// ── WHY `prism_ac_event_node` ALWAYS BUILDS A 2-CHILD DETAIL STACK, EVEN WHEN `ac_detail` IS
//    EMPTY ─────────────────────────────────────────────────────────────────────────────────────
// `ac_detail` is a plain `string`, not `string?` (the brief's own struct shape) -- unlike
// `prism_ui_kit.prism_ui_field_row`'s `note: string?`, there is no type-level "absent" state to
// switch on here, only "empty". `prism_content.prism_label` never rejects an empty string (it
// renders an empty label, proven by direct read of that function), so choosing to omit the
// detail node when `ac_detail` is empty would make the SAME function return a 2-child band in one
// case and a 3-child band in another for reasons invisible at the call site -- exactly the kind
// of shape-varies-on-content surprise `prism_tl_changelog`'s own `_prism_tl_changelog_desc`
// works around by varying TEXT, never child count. This function keeps the child count and shape
// constant (`band[time, gap, stack[title, detail]]`, always) and lets an empty detail render as
// an honest empty line -- the caller who never wants that line can simply not populate it, or a
// future caller who wants "no line" can filter degenerate events before calling this.
//
// ── WHY `prism_ac_compact`'S ROW IS `band[time, title]` -- NO GAP, UNLIKE `prism_ac_event_node`
// The full event node's gap exists to separate the fixed-width timestamp from the title+detail
// block visually; the compact row is deliberately terser (this is the "collapse the feed to fit
// more rows" view), so it reduces to the two pieces of information advertised by its own name --
// exactly the 2-element shape the commissioning brief specifies.
//
// ── WHY `prism_ac_grouped`/`prism_ac_latest` DELEGATE TO `prism_ac_feed` AND LET ITS OWN
//    VALIDATION SURFACE UNCHANGED ────────────────────────────────────────────────────────────────
// Same "propagate the sub-component's own validation unchanged" discipline `prism_pf_card`
// documents for its own header/bio/stats calls: `prism_ac_grouped` checks only the one thing it
// alone is responsible for (`label` non-empty) and then hands `events` straight to
// `prism_ac_feed`, which owns the "non-empty, every element a PrismActivityEvent" rule -- one
// place enforces that rule, not two copies that could drift. `prism_ac_latest` checks only
// `count > 0` (its own, unique responsibility) before slicing and doing the identical delegation.
//
// ── WHY `prism_ac_latest` NEVER ERRORS WHEN `count` EXCEEDS `len(events)` ───────────────────────
// "Latest N" is a request for AT MOST N, not EXACTLY N -- a caller asking for the 10 most recent
// events against a feed that only has 3 is a completely ordinary state (a new feed, a quiet day),
// not a caller bug. The slice loop below naturally produces `min(count, len(events))` items with
// no special-casing (a `for` loop with an index-vs-`count` guard simply never fires past the
// underlying list's own length), the identical "the general rule already covers the boundary"
// shape `prism_ui_pager.nova`'s own header documents for its windowing algorithm.
//
// ── FIELD PREFIX ──────────────────────────────────────────────────────────────────────────────
// `PrismActivityEvent` fields are `ac_`-prefixed -- global field-slot table, see above; `ac_` was
// grepped clean (no existing struct in this tree claims it) before use.
//
// ── ACCESSORS: NOT IN THE ORIGINAL BRIEF, ADDED FOR THE SAME REASON `prism_xf_item` HAS THEM ────
// `prism_xf_item`/`_key`/`_label`/`_disabled` in prism_ui_transfer.nova is the direct precedent:
// every other prism/ui/ struct with a public constructor also ships a same-file, one-line
// accessor per field, and that file's own KAT reads the struct exclusively through them rather
// than bare `.field` access from a different module. Three tiny accessors here follow the exact
// same, already-proven pattern rather than being the first struct in this tree to skip it.
//
// PUBLIC API
//   Event
//     PrismActivityEvent { ac_time: string, ac_title: string, ac_detail: string } +
//       prism_ac_event(time, title, detail) -> PrismActivityEvent   (plain wrapper, no validation
//       -- validation happens at render time, matching prism_xf_item's own constructor)
//     prism_ac_event_time(e) / prism_ac_event_title(e) / prism_ac_event_detail(e)   accessors
//   Render
//     prism_ac_event_node(ev: PrismActivityEvent) -> Result<PrismNode>
//       band[time_label, gap(8), stack[title_label, detail_label]] -- single event render.
//       rejects an empty ac_time or ac_title; ac_detail may be empty (see header)
//     prism_ac_feed(events: list) -> Result<PrismNode>
//       stack of prism_ac_event_node results, in source order (prism_ui_kit.prism_ui_collect).
//       rejects an empty events list and a non-PrismActivityEvent element (named by index/type)
//     prism_ac_compact(events: list) -> Result<PrismNode>
//       stack of band[time_label, title_label] rows (no detail), same list validation as feed
//     prism_ac_grouped(label: string, events: list) -> Result<PrismNode>
//       stack[section_label, feed]; rejects an empty label, propagates prism_ac_feed's own
//       validation for events unchanged (see header)
//     prism_ac_latest(events: list, count: int) -> Result<PrismNode>
//       prism_ac_feed of the first min(count, len(events)) events; rejects count <= 0, propagates
//       prism_ac_feed's own validation for events unchanged (see header)

import prism_arrange
import prism_content
import prism_ui_kit

// ── Event ─────────────────────────────────────────────────────────────────────────────────────
type PrismActivityEvent
    ac_time: string
    ac_title: string
    ac_detail: string

// Struct positional constructors are file-local cross-module (the same shape prism_xf_item's own
// header verifies), hence the ordinary wrapper. No validation here -- see header.
fn prism_ac_event(time: string, title: string, detail: string) -> PrismActivityEvent
    PrismActivityEvent(time, title, detail)

fn prism_ac_event_time(e: PrismActivityEvent) -> string
    e.ac_time

fn prism_ac_event_title(e: PrismActivityEvent) -> string
    e.ac_title

fn prism_ac_event_detail(e: PrismActivityEvent) -> string
    e.ac_detail

// A small, constant breathing space between an event's timestamp and its title/detail block --
// the same fixed-not-flexible reasoning prism_ui_profile.nova's own PRISM_PF_CARD_GAP carries.
let PRISM_AC_GAP = 8

// Shared field-level check for both prism_ac_event_node and the compact row below -- neutral
// "prism_ac:" prefix rather than the caller's own name, the same shared-helper convention
// prism_ui_transfer.nova's own `_prism_xf_index` uses for its cross-function checks.
fn _prism_ac_check(e: PrismActivityEvent) -> Result<bool>
    if len(e.ac_time) == 0
        return err("prism_ac: event time must not be empty")
    if len(e.ac_title) == 0
        return err("prism_ac: event title must not be empty")
    ok(true)

// Shared list-level check for prism_ac_feed and prism_ac_compact: non-empty, every element a
// PrismActivityEvent (bare `list`, runtime-checked -- same discipline prism_ui_timeline.nova's
// own prism_tl_timeline/prism_tl_changelog apply to their own bare-list inputs). `who` names the
// CALLING function in the error text, the same `what`-parameter trick
// prism_ui_transfer.nova's `_prism_xf_key_set` uses to keep one shared helper's errors precise.
fn _prism_ac_check_list(events: list, who: string) -> Result<bool>
    if len(events) == 0
        return err(who + ": events must not be empty")
    for idx, e in events
        if type_name(e) != "PrismActivityEvent"
            return err(who + ": events[" + str(idx) + "] is not a PrismActivityEvent (got " + type_name(e) + ")")
    ok(true)

// ── 1. Single event render ────────────────────────────────────────────────────────────────────
// band[time_label, gap(8), stack[title_label, detail_label]] -- see header for why the stack is
// always 2 children, even when ac_detail is empty.
fn prism_ac_event_node(ev: PrismActivityEvent) -> Result<PrismNode>
    _prism_ac_check(ev)?
    let time_node = prism_content.prism_label(ev.ac_time)?
    let gap = prism_arrange.prism_gap(some(PRISM_AC_GAP))?
    let title_node = prism_content.prism_label(ev.ac_title)?
    let detail_node = prism_content.prism_label(ev.ac_detail)?
    let body = prism_arrange.prism_stack([title_node, detail_node])?
    prism_arrange.prism_band([time_node, gap, body])

// ── 2. Full feed ──────────────────────────────────────────────────────────────────────────────
fn prism_ac_feed(events: list) -> Result<PrismNode>
    _prism_ac_check_list(events, "prism_ac_feed")?
    let mk = fn(e) prism_ac_event_node(e)
    let nodes = prism_ui_kit.prism_ui_collect(events, mk)?
    prism_arrange.prism_stack(nodes)

// ── 3. Compact feed (no detail) ───────────────────────────────────────────────────────────────
// band[time_label, title_label] -- no gap, no detail (see header).
fn _prism_ac_compact_item(ev: PrismActivityEvent) -> Result<PrismNode>
    _prism_ac_check(ev)?
    let time_node = prism_content.prism_label(ev.ac_time)?
    let title_node = prism_content.prism_label(ev.ac_title)?
    prism_arrange.prism_band([time_node, title_node])

fn prism_ac_compact(events: list) -> Result<PrismNode>
    _prism_ac_check_list(events, "prism_ac_compact")?
    let mk = fn(e) _prism_ac_compact_item(e)
    let nodes = prism_ui_kit.prism_ui_collect(events, mk)?
    prism_arrange.prism_stack(nodes)

// ── 4. Labeled group ──────────────────────────────────────────────────────────────────────────
// stack[section_label, feed]; only `label` is this function's own responsibility to check (see
// header on delegation).
fn prism_ac_grouped(label: string, events: list) -> Result<PrismNode>
    if len(label) == 0
        return err("prism_ac_grouped: label must not be empty")
    let header = prism_content.prism_label(label)?
    let feed = prism_ac_feed(events)?
    prism_arrange.prism_stack([header, feed])

// ── 5. Most recent N ──────────────────────────────────────────────────────────────────────────
// Only `count > 0` is this function's own responsibility to check (see header on delegation and
// on why exceeding len(events) is never an error).
fn prism_ac_latest(events: list, count: int) -> Result<PrismNode>
    if count <= 0
        return err("prism_ac_latest: count must be > 0, got " + str(count))
    let sliced = []
    for idx, e in events
        if idx >= count
            break
        sliced.push(e)
    prism_ac_feed(sliced)
