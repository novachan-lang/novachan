import prism_node
import prism_arrange
import prism_content

// 1. Text spinner: label showing a spinning character based on frame index
//    frames cycle through ["|", "/", "-", "\\"]
fn prism_sp_spinner(frame: int) -> Result<PrismNode>
    if frame < 0
        return err("prism_sp_spinner: frame must be >= 0")
    let chars = ["|", "/", "-", "\\"]
    let idx = frame % 4
    prism_content.prism_label(str(chars[idx]))

// 2. Spinner with message: band[spinner, gap, message_label]
fn prism_sp_loading(message: string, frame: int) -> Result<PrismNode>
    if len(message) == 0
        return err("prism_sp_loading: message must not be empty")
    let spinner = prism_sp_spinner(frame)?
    let gap = prism_arrange.prism_gap(some(4))?
    let msg = prism_content.prism_label(message)?
    prism_arrange.prism_band([spinner, gap, msg])

// 3. Dots loader: label showing dots based on frame (1-3 dots cycling)
fn prism_sp_dots(frame: int) -> Result<PrismNode>
    if frame < 0
        return err("prism_sp_dots: frame must be >= 0")
    let count = (frame % 3) + 1
    let mut dots = ""
    let mut i = 0
    while i < count
        dots = dots + "."
        i += 1
    prism_content.prism_label(dots)

// 4. Progress spinner: band[spinner, percentage_label]
fn prism_sp_progress(current: int, total: int, frame: int) -> Result<PrismNode>
    if total <= 0
        return err("prism_sp_progress: total must be > 0")
    if current < 0
        return err("prism_sp_progress: current must be >= 0")
    let mut clamped = current
    if clamped > total
        clamped = total
    let pct = (clamped * 100) / total
    let spinner = prism_sp_spinner(frame)?
    let gap = prism_arrange.prism_gap(some(4))?
    let pct_label = prism_content.prism_label(str(pct) + "%")?
    prism_arrange.prism_band([spinner, gap, pct_label])

// 5. Overlay loader: layer[content, loading_overlay] when loading; just content when not
fn prism_sp_overlay(content: list, loading: bool, message: string, frame: int) -> Result<PrismNode>
    if len(content) == 0
        return err("prism_sp_overlay: content must not be empty")
    let mut idx = 0
    for c in content
        if type_name(c) != "PrismNode"
            return err("prism_sp_overlay: child " + str(idx) + " is not a PrismNode (got " + type_name(c) + ")")
        idx += 1
    let body = prism_arrange.prism_stack(content)?
    if not loading
        return ok(body)
    let loader = prism_sp_loading(message, frame)?
    prism_arrange.prism_layer([body, loader])
