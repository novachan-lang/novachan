// prism_ui_result -- error/result state components (prism/ui/, milestone MB.26): a full error
// page (404/500/etc.), a small inline field-level error, a success state, and a loading
// indicator. Every one is a COMPOSITION over the closed 22-primitive vocabulary (widget/), built
// through prism_arrange/prism_content/prism_interact and prism_ui_kit.nova's helpers wherever
// they fit -- no new PrismNodeKind, the same "this is a composition, not a new primitive"
// discipline every prism_ui_*.nova file follows (PRISM_SPEC.md axiom A7). This is the family Ant
// Design ships as `Result` + `Alert type="error"` + `Spin`: a full-page terminal state you can't
// recover from in place (404, 500), a small inline correction you CAN recover from in place (a
// bad form field), a positive terminal state, and "work is happening, please wait."
//
// ── WHY THIS FILE NEEDS NO `import prism_node` (UNLIKE prism_ui_notice.nova/prism_ui_calendar.nova) ──
// Several sibling ui/ files (`prism_nt_item`, `_prism_cal_with_attrs`) import `prism_node`
// directly to bolt an extra attr onto an already-built node via `dict_merge(node.attrs, extra)` +
// `prism_node.prism_node_new(...)`. Nothing in THIS file needs that: every node here is either a
// bare `prism_content`/`prism_arrange`/`prism_interact`/`prism_ui_kit` constructor call, or a
// `stack`/`band` built directly over already-built children -- no node ever needs a bolt-on attr
// after construction. Left out of the import list for exactly that reason.
//
// ── WHY `rs_code` TOLERANT-DEGRADES A BLANK `Some("")`, BUT `rs_action_label` DOES NOT ─────────
// Same split `prism_fb_alert`'s `detail: string?` and `prism_fb_toast`'s `dismiss_label: string?`
// already draw (prism_ui_feedback.nova). A blank optional TEXT field (an error code string) has
// an honest "nothing to show" reading -- rendering a stray blank label helps no one -- so
// `rs_code` degrades a present-but-blank `Some("")` to "no code line", exactly like
// `detail`/`nt_time` already do (`_prism_rs_opt_label`, mirroring `_prism_nt_opt_part`). An
// optional ACTION LABEL is different: it names an interactive control's accessible text, and a
// present-but-blank name is a genuine authoring bug (an unlabelled, unclickable-by-screen-reader
// button), not an intentional omission -- so `rs_action_label` is handed to `prism_press`
// UNCHECKED (`_prism_rs_opt_press`) and inherits `prism_press`'s own "text or child required"
// rejection, mirroring `prism_fb_toast`'s `dismiss_label` and `prism_fb_empty`'s `cta_label`
// exactly (neither pre-screens for blank either, for the identical reason).
//
// ── WHY `prism_rs_loading`'S SEARCH GLYPH CARRIES NO STORED "SPINNING" ATTR ─────────────────────
// The closed 12-icon set (`prism_content.nova`) has no literal spinner/in-progress icon --
// `prism_ui_upload.nova`'s header and `prism_ui_table.nova`'s own loading-state note both already
// establish this and pick an available icon (`ChevronUp`, or plain text) to STAND IN for
// "in-progress" rather than inventing a fake attribute for it. This file follows the identical
// precedent: `Search` stands in for "looking for something" (loading), and any actual per-frame
// animation is a BACKEND/paint concern -- the ANSI backend already owns exactly that job
// (`prism_ansi_spinner(i)` in `prism/backend/ansi/prism_ansi.nova` cycles spinner frames by
// index) -- never a fact this structural composition layer stores on the node. Storing a
// `"rs_spinning": true` attr here would need `prism_node.prism_node_new` to bolt it onto an
// already-built glyph leaf (the `dict_merge`-and-reconstruct pattern `prism_nt_dot`/`prism_nt_item`
// use), an import this file deliberately does not carry (see note above). The glyph node is
// therefore BYTE-IDENTICAL (`{"icon": "search"}`) whether or not a message accompanies it -- the
// KAT proves this directly by comparing the bare-glyph and with-message glyph's attrs.
//
// ── WHY `prism_rs_success`'S CHECK GLYPH IS UNCONDITIONAL, BUT `rs_code` (ERROR PAGE) IS OPTIONAL ──
// A success state has exactly one visual signal worth showing (the checkmark) and it is
// spec-fixed -- there is no "which glyph" decision a caller makes, so it is never a parameter. An
// error page's `rs_code` is different: not every error is a coded one (a generic client-side
// validation failure has no "500"/"404" to show), so it stays `string?` and degrades exactly like
// the optional fields above.
//
// ── WHY `prism_rs_inline_error` IS A `band`, BUT `prism_rs_error_page` IS A `stack` ─────────────
// An inline error sits BESIDE the field it corrects (PRISM_SPEC.md §7: band is the inline axis)
// -- exactly the shape a form's note line already uses (`prism_ui_kit.prism_ui_field_row`), just
// with a glyph in place of plain text. Reused directly via `prism_ui_kit.prism_ui_icon_text`
// (already exactly `band[glyph, label]`) rather than hand-rolled -- CLAUDE.md's "does this
// already exist" rule. An error PAGE is a full block-level replacement for the screen (the block
// axis, `stack`) -- there is no adjacent content it sits beside, so `stack` is the only fit.
//
// PUBLIC API
//   Components (all Result<PrismNode>; every one validates except prism_rs_loading, which never
//   fails -- see its own note)
//     prism_rs_error_page(rs_title: string, rs_code: string?, rs_message: string, rs_action_label: string?)
//       -> stack[label(code)?, label(title), label(message), press(action)?]
//       rejects an empty rs_title/rs_message; a present-but-blank rs_code degrades to absent;
//       a present-but-blank rs_action_label is rejected (see header)
//     prism_rs_inline_error(rs_message: string)
//       -> band[glyph(Close), label(message)]   (prism_ui_kit.prism_ui_icon_text)
//       rejects an empty rs_message
//     prism_rs_success(rs_title: string, rs_message: string, rs_action_label: string?)
//       -> stack[glyph(Check), label(title), label(message), press(action)?]
//       rejects an empty rs_title/rs_message; a present-but-blank rs_action_label is rejected
//     prism_rs_loading(rs_message: string?)
//       -> band[glyph(Search), label(message)] (prism_ui_kit.prism_ui_icon_text) when rs_message
//          is Some and non-empty; bare glyph(Search) when None or blank. Never fails.

import prism_arrange
import prism_content
import prism_interact
import prism_ui_kit

// ── Shared optional-field helpers ────────────────────────────────────────────────────────────
// 0-or-1-element list, spliced into a parent's child list with `...` -- the same shape
// `prism_nt_item`'s `_prism_nt_opt_part` (prism_ui_notice.nova) already established for the
// identical "optional text line, blank degrades to absent" case.
fn _prism_rs_opt_label(text: string?) -> Result<list>
    match text
        None => ok([])
        Some(t) =>
            if len(t) == 0
                return ok([])
            let node = prism_content.prism_label(t)?
            ok([node])

// Deliberately UNCHECKED for blank -- see header. `prism_press` itself rejects an empty label
// with no children, which is exactly the behavior wanted for a present-but-blank action label.
fn _prism_rs_opt_press(rs_action_label: string?) -> Result<list>
    match rs_action_label
        None => ok([])
        Some(label) =>
            let btn = prism_interact.prism_press(label, [])?
            ok([btn])

// ── Error page ────────────────────────────────────────────────────────────────────────────────
fn prism_rs_error_page(rs_title: string, rs_code: string?, rs_message: string, rs_action_label: string?) -> Result<PrismNode>
    if len(rs_title) == 0
        return err("prism_rs_error_page: rs_title must not be empty")
    if len(rs_message) == 0
        return err("prism_rs_error_page: rs_message must not be empty")
    let code_parts = _prism_rs_opt_label(rs_code)?
    let title_node = prism_content.prism_label(rs_title)?
    let message_node = prism_content.prism_label(rs_message)?
    let action_parts = _prism_rs_opt_press(rs_action_label)?
    prism_arrange.prism_stack([...code_parts, title_node, message_node, ...action_parts])

// ── Inline error ──────────────────────────────────────────────────────────────────────────────
fn prism_rs_inline_error(rs_message: string) -> Result<PrismNode>
    if len(rs_message) == 0
        return err("prism_rs_inline_error: rs_message must not be empty")
    prism_ui_kit.prism_ui_icon_text(prism_content.prism_icon_close(), rs_message)

// ── Success ───────────────────────────────────────────────────────────────────────────────────
fn prism_rs_success(rs_title: string, rs_message: string, rs_action_label: string?) -> Result<PrismNode>
    if len(rs_title) == 0
        return err("prism_rs_success: rs_title must not be empty")
    if len(rs_message) == 0
        return err("prism_rs_success: rs_message must not be empty")
    let check_glyph = prism_content.prism_glyph(prism_content.prism_icon_check())?
    let title_node = prism_content.prism_label(rs_title)?
    let message_node = prism_content.prism_label(rs_message)?
    let action_parts = _prism_rs_opt_press(rs_action_label)?
    prism_arrange.prism_stack([check_glyph, title_node, message_node, ...action_parts])

// ── Loading ───────────────────────────────────────────────────────────────────────────────────
// See header for why the Search glyph carries no stored "spinning" attr. Never fails: a closed
// icon enum can't produce an invalid glyph, any string is a legitimate label, and a 2-child
// band/bare leaf never exceeds PRISM_SPEC.md §16's resource bounds.
fn prism_rs_loading(rs_message: string?) -> Result<PrismNode>
    match rs_message
        None => prism_content.prism_glyph(prism_content.prism_icon_search())
        Some(text) =>
            if len(text) == 0
                return prism_content.prism_glyph(prism_content.prism_icon_search())
            prism_ui_kit.prism_ui_icon_text(prism_content.prism_icon_search(), text)
