import prism_node
import prism_arrange
import prism_content

// Alert levels: "info", "success", "warning", "error"
fn _prism_al_valid_level(level: string) -> bool
    if level == "info"
        return true
    if level == "success"
        return true
    if level == "warning"
        return true
    if level == "error"
        return true
    false

fn _prism_al_icon_for_level(level: string) -> Result<PrismNode>
    if level == "success"
        return prism_content.prism_glyph(prism_content.prism_icon_check())
    if level == "error"
        return prism_content.prism_glyph(prism_content.prism_icon_close())
    if level == "warning"
        return prism_content.prism_glyph(prism_content.prism_icon_warning())
    // info — use the same as warning for now (no dedicated info icon glyph)
    prism_content.prism_glyph(prism_content.prism_icon_warning())

// Simple alert: band[icon, message_label] with al_level attr
fn prism_al_alert(message: string, level: string) -> Result<PrismNode>
    if len(message) == 0
        return err("prism_al_alert: message must not be empty")
    if not _prism_al_valid_level(level)
        return err("prism_al_alert: invalid level '" + level + "' (must be info/success/warning/error)")
    let icon = _prism_al_icon_for_level(level)?
    let msg = prism_content.prism_label(message)?
    prism_arrange.prism_band([icon, msg])

// Alert with title: band[icon, stack[title, message]]
fn prism_al_titled(title: string, message: string, level: string) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_al_titled: title must not be empty")
    if len(message) == 0
        return err("prism_al_titled: message must not be empty")
    if not _prism_al_valid_level(level)
        return err("prism_al_titled: invalid level '" + level + "'")
    let icon = _prism_al_icon_for_level(level)?
    let t = prism_content.prism_label(title)?
    let m = prism_content.prism_label(message)?
    let body = prism_arrange.prism_stack([t, m])?
    prism_arrange.prism_band([icon, body])

// Inline alert: just a label with level prefix e.g. "[!] message"
fn prism_al_inline(message: string, level: string) -> Result<PrismNode>
    if len(message) == 0
        return err("prism_al_inline: message must not be empty")
    if not _prism_al_valid_level(level)
        return err("prism_al_inline: invalid level '" + level + "'")
    let prefix = ""
    if level == "success"
        prefix = "[ok] "
    if level == "error"
        prefix = "[!!] "
    if level == "warning"
        prefix = "[!] "
    if level == "info"
        prefix = "[i] "
    prism_content.prism_label(prefix + message)
