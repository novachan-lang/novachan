// prism_ui_tooltip -- tooltip / popover component (prism/ui/): a COMPOSITION over the closed
// widget vocabulary (widget/, core/) -- no new PrismNodeKind is invented here (axiom A7), the
// same discipline every other ui/ module (prism_ui_overlay.nova, prism_ui_media.nova, ...)
// already follows.
//
// ── prism_layer TAKES A LIST, NOT (base, overlay) -- VERIFIED AGAINST prism_arrange.nova FIRST ──
// The real signature (prism/widget/prism_arrange.nova) is `prism_layer(children: list)` --
// later children painted on top -- not a two-positional-argument `(base, overlay)` form. Every
// wrap/popover below calls it as `prism_layer([base, overlay])` for exactly this reason
// (CLAUDE.md's "verify before acting": grep the live code before trusting a remembered API
// shape). `prism_style`'s `prism_pad` does not exist anywhere in this codebase (grepped
// project-wide before writing this file) -- not used here.
//
// ── FIELD PREFIX: `tt_`, CHECKED AGAINST EVERY OTHER ui/ MODULE FIRST ────────────────────────
// Grepped project-wide (`^\s+tt_\w+:`) before naming anything here, same discipline
// prism_ui_overlay.nova's header documents for `dd_`. Unclaimed at time of writing.
//
// ── WHY `content`/`trigger`/`body` HAVE NO RUNTIME "IS THIS A PrismNode" CHECK ───────────────
// Each of those parameters is typed `PrismNode`, not the untyped `list` prism_ov_dropdown's
// items are -- exactly the same reasoning prism_arrange.nova's own header gives for
// `prism_pane(child: PrismNode)`: the shape is enforced by the parameter's own type, so a
// caller literally cannot construct the wrong shape, and a redundant `type_name(x) !=
// "PrismNode"` runtime check would be dead code that can never observe a violation from a
// well-typed caller. "Non-PrismNode content" is therefore a COMPILE error (E1002 type
// mismatch) here, never a runtime `Err` -- the KAT documents this rather than faking a runtime
// test for something the type system already forecloses.
//
// PUBLIC API
//   PrismTooltip { tt_text: string, tt_position: string } + prism_tt_tooltip(text, position)
//     `position` must be one of "top"|"bottom"|"left"|"right" -- kept as a validated string
//     (not a new enum) because it round-trips through the "tt_pos" node attr as a plain string,
//     same convention prism_ov_popover's own "placement" attr already uses. Rejects empty text
//     and any position outside the 4-value closed set.
//   prism_tt_text(tip) -> string / prism_tt_position(tip) -> string    accessors
//   prism_tt_wrap(content: PrismNode, tip: PrismTooltip) -> Result<PrismNode>
//     layer([content, tooltip_label]) -- the tooltip is a label carrying "tt_pos" + "tt_text"
//     attrs (readable by any backend without re-deriving them from the label's own "text").
//   prism_tt_popover(title: string, body: PrismNode, trigger: PrismNode) -> Result<PrismNode>
//     layer([trigger, stack([heading_label, body])]) -- title renders as a plain label (spec
//     axiom A3: content is glyphs, never markup). Rejects an empty title.
//   prism_tt_help(text: string) -> Result<PrismNode>
//     convenience: an info glyph wrapped with a "top" tooltip -- the common "(?)" help pattern.
//
// Errors: empty tooltip text, invalid position (not one of the 4), empty popover title.
// (Non-PrismNode content/trigger/body: compile-time only, see note above.)

import prism_node
import prism_content
import prism_arrange

let PRISM_TT_POSITIONS = ["top", "bottom", "left", "right"]

fn _prism_tt_is_valid_position(position: string) -> bool
    for p in PRISM_TT_POSITIONS
        if p == position
            return true
    false

type PrismTooltip
    tt_text: string
    tt_position: string

fn prism_tt_tooltip(text: string, position: string) -> Result<PrismTooltip>
    if len(text) == 0
        return err("prism_tt_tooltip: text must not be empty")
    if not _prism_tt_is_valid_position(position)
        return err("prism_tt_tooltip: position must be one of top|bottom|left|right, got '" + position + "'")
    ok(PrismTooltip(text, position))

fn prism_tt_text(tip: PrismTooltip) -> string
    tip.tt_text

fn prism_tt_position(tip: PrismTooltip) -> string
    tip.tt_position

// Builds the tooltip's own node: a label (content vocabulary) reconstructed with "tt_pos" and
// "tt_text" attrs merged in -- the same dict_merge + prism_node_new reconstruction pattern
// prism_ui_overlay.nova's `_prism_ov_with_attrs` uses, kept as this file's own small copy
// rather than importing another ui/ module for one helper (every ui/ module already does this).
fn _prism_tt_label_node(tip: PrismTooltip) -> Result<PrismNode>
    let base = prism_content.prism_label(tip.tt_text)?
    let merged = dict_merge(base.attrs, {"tt_pos": tip.tt_position, "tt_text": tip.tt_text})
    prism_node.prism_node_new(base.kind, merged, base.children, base.key)

// See header for why `prism_layer([content, tip_node])`, not a two-arg `(base, overlay)` call.
fn prism_tt_wrap(content: PrismNode, tip: PrismTooltip) -> Result<PrismNode>
    let tip_node = _prism_tt_label_node(tip)?
    prism_arrange.prism_layer([content, tip_node])

fn prism_tt_popover(title: string, body: PrismNode, trigger: PrismNode) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_tt_popover: title must not be empty")
    let heading = prism_content.prism_label(title)?
    let panel = prism_arrange.prism_stack([heading, body])?
    prism_arrange.prism_layer([trigger, panel])

// Convenience: the common "(?)" / info-icon help pattern -- an info glyph wrapped with a
// "top"-positioned tooltip carrying `text`.
fn prism_tt_help(text: string) -> Result<PrismNode>
    let icon_node = prism_content.prism_glyph(prism_content.prism_icon_info())?
    let tip = prism_tt_tooltip(text, "top")?
    prism_tt_wrap(icon_node, tip)
