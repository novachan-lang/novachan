// prism_ui_kv -- key-value / description-list components (prism/ui/, milestone MB.21): a single
// key-value pair, a vertical list of already-built pairs, a structured table built from a typed
// `PrismKvEntry` (key + value + an optional note), and a titled section wrapping a list of pairs.
// Every one is a COMPOSITION over the closed 22-primitive vocabulary (widget/), built through
// prism_content/prism_arrange directly and prism_ui_kit.nova wherever it fits -- no new
// PrismNodeKind (PRISM_SPEC.md axiom A7), the same discipline every prism_ui_*.nova file in this
// tree follows. This is the Ant Design `Descriptions` / GOV.UK `Summary list` family: the
// label-left-value-right block used for an object detail view, an order summary, a settings
// readout.
//
// ── THIS IS NOT prism_ui_kit.prism_ui_kv, AND THE OVERLAP IS DELIBERATE, NOT MISSED ─────────────
// Grepped before writing a line of this file (CLAUDE.md's "does this already exist" discipline):
// `prism_ui_kit.nova` (MB.2) already has a `prism_ui_kv(pairs: list)` that renders a stack of
// `band[label, label]` rows. That is a real, deliberate overlap in DOMAIN (both draw a key/value
// block), but the two functions solve a DIFFERENT problem, at a different composition layer:
//   - `prism_ui_kit.prism_ui_kv` takes RAW DATA -- a bare list of `[key, value]` 2-element STRING
//     lists -- and builds every row itself. Its own doc comment names its origin: "the shape a
//     caller already has when reading a struct through RTTI (`field_names` + `field_get`)". It is
//     a data-to-nodes adapter for exactly one shape (an untyped list of untyped 2-tuples), with no
//     way to attach a note to a row and no way to reuse an already-built row somewhere else.
//   - This file's `prism_kv_pair` is the row-builder ITSELF, exposed as a first-class, independently
//     reusable `Result<PrismNode>` -- a caller can build one, hold onto it, pass it to
//     `prism_kv_list` alongside pairs built some other way, or drop it into an unrelated `stack`/
//     `band` composition entirely. `prism_kv_kit.prism_ui_kv`'s row-builder
//     (`_prism_ui_kv_row`) is PRIVATE -- unreachable outside that file -- so no such reuse is
//     possible with the existing function no matter how a caller's data is shaped.
//   - `prism_kv_list` takes a list of ALREADY-BUILT `PrismNode`s (runtime-checked, the same "any
//     PrismNode" discipline `prism_st_dashboard`/`prism_rt_review_list`/`prism_tl_timeline` all
//     already use), not raw string tuples -- a caller who already has heterogeneous rows (some
//     `prism_kv_pair` results, one plain label, a divider) can stack them together, which
//     `prism_ui_kit.prism_ui_kv`'s raw-string-only input can never accept.
//   - `prism_kv_table` and `prism_kv_section` have NO equivalent in `prism_ui_kit.nova` at all --
//     that file has no notion of a typed entry with an optional per-row note, and no notion of a
//     titled key-value section.
// Net effect: `prism_ui_kit.prism_ui_kv` stays exactly as it is (a convenience adapter for the
// RTTI-dump use case it was built for) and is not touched by this file; this file adds the
// composable, typed layer on top that the task actually asks for. A future cleanup MAY reimplement
// `prism_ui_kit.prism_ui_kv(pairs)` as `prism_kv_list(prism_ui_collect(pairs, mk_pair))` once both
// files are known to be stable, but that is out of scope here and is not assumed.
//
// ── WHY PrismKvEntry EXISTS AT ALL, RATHER THAN JUST PASSING MORE PrismNode PAIRS ────────────────
// `prism_kv_pair`/`prism_kv_list` operate purely on already-rendered `PrismNode`s -- by the time a
// pair reaches `prism_kv_list` there is no way to ask "does this row have a note", because a
// `band[label, label]` and a `band[label, label]` built for a totally different reason look
// identical. A per-row optional note (an e-commerce order line's "Payment method: Visa •••• 4242
// (expires 03/29)") needs the SOURCE DATA, not the rendered shape, so `prism_kv_table` takes typed
// `PrismKvEntry` values and decides the note layout itself. This mirrors the exact reason
// `prism_rt_review`'s `rt_date` and `prism_fb_alert`'s `detail` are plain parameters rather than an
// extra caller-supplied `PrismNode` slot: the component, not the caller, owns the decision of
// whether/how the optional part renders.
//
// ── WHY A NOTE DEGRADES TO THE BARE ROW, NEVER A 1-CHILD STACK WRAPPER ───────────────────────────
// Same tolerance as `prism_rt_review`'s `rt_date`/`prism_fb_alert`'s `detail`/`prism_st_stat`'s
// `st_prefix`: "no note" (`None`) and "note is the empty string" (`Some("")`) are different facts,
// but neither should produce a visible artifact. An entry with no honest note renders as the bare
// `band[label(key), label(value)]` row directly -- exactly `prism_kv_pair`'s own shape -- rather
// than wrapping it in a `stack` of one child that exists only to satisfy a uniform "always 2
// children" internal convention. This keeps `prism_kv_table`'s depth/count arithmetic identical in
// shape to `prism_kv_pair`'s for note-less entries instead of inventing a third convention, and the
// KAT proves both the noted and note-less shapes coexist correctly in the same table.
//
// ── WHY prism_kv_section's SHAPE IS "title + FIXED gap + stack(pairs)", NOT prism_ui_section's
//    "title + stack(children)" (no gap) ────────────────────────────────────────────────────────
// `prism_ui_kit.prism_ui_section(title, children)` already exists and is the closest reusable
// helper, but its actual rendered shape is `stack([title_label, stack(children)])` -- NO explicit
// breathing space between the title and the body. The task's own spec for this function is
// `stack[label(title), gap, stack(pairs)]`, an explicit third element between title and body. That
// is not a style variation this file may silently ignore in favor of reusing `prism_ui_section`
// unmodified (doing so would produce a different node shape than specified, and a different
// depth/count than the KAT is required to prove). The precedent for a title with a small, fixed
// gap before its body already exists in this exact codebase -- `prism_st_card` (prism_ui_stat.nova)
// -- and this file reuses that identical `prism_gap(some(8))` value for the identical reason (an
// unremarkable, un-special breathing-room constant), named `PRISM_KV_SECTION_GAP` rather than
// imported, matching every prior file's choice to keep its own small layout constants file-local.
//
// ── FIELD-SLOT COLLISION: `kv_` PREFIX, VERIFIED CLEAR ────────────────────────────────────────────
// NOVA's field-name -> slot index table is GLOBAL and last-registration-wins (the documented defect
// behind the PrismNode.kind collision that once crashed the HTML renderer, and the same reason
// prism_ui_transfer.nova's `xf_`/prism_interact.nova's `pick_`/prism_ui_timeline.nova's `tlc_`
// prefixes all exist) -- every field on `PrismKvEntry` is `kv_`-prefixed. Grepped the whole `prism/`
// tree and `nova-compiler/lib/` before choosing it: no other struct anywhere declares `kv_key`,
// `kv_value`, or `kv_note` (the only unrelated hits were unrelated function names in
// forge_etcd.nova, not struct fields, so there is no slot collision).
//
// ── WHY prism_kve_new REJECTS AN EMPTY key BUT NOT AN EMPTY value ────────────────────────────────
// A key names WHICH fact is being shown ("Status", "Owner") -- an unlabelled row is meaningless and
// indistinguishable from a rendering bug, the same bar `prism_kv_pair`'s own `kv_key` check and
// `prism_ui_labeled`'s `label` check both already enforce. A value legitimately CAN be blank (a
// field that is genuinely empty right now -- "Middle name: ", "Discount code: ") and rendering that
// honestly is more useful than forcing every caller to invent a placeholder string; `prism_label`
// itself (prism_content.nova) never rejects an empty string for exactly this reason.
//
// PUBLIC API
//   Entry (typed, for prism_kv_table)
//     PrismKvEntry { kv_key: string, kv_value: string, kv_note: string? }
//     prism_kve_new(key, value, note: string?) -> Result<PrismKvEntry>   rejects an empty key
//     prism_kve_key(e) / prism_kve_value(e) / prism_kve_note(e)          accessors
//   Components (all `Result<PrismNode>`, every one validates, none fails silently)
//     prism_kv_pair(kv_key, kv_value) -> band[label(key), label(value)]; rejects an empty kv_key.
//     prism_kv_list(pairs: list) -> stack(pairs); `pairs` is a bare list of already-built
//       PrismNodes (runtime-checked, same "any PrismNode" discipline as prism_st_dashboard); rejects
//       an empty list and a non-PrismNode element (named by index and actual type).
//     prism_kv_table(kv_entries: list) -> stack of per-entry rows; each entry renders as
//       band[label(key), label(value)], or stack[that band, label(note)] when kv_note is Some and
//       non-empty (see header). `kv_entries` is a bare list; rejects an empty list and a
//       non-PrismKvEntry element (named by index and actual type).
//     prism_kv_section(kv_title, pairs: list) -> stack[label(title), gap(8), stack(pairs)]; `pairs`
//       has the identical bare-list/non-empty/PrismNode discipline as prism_kv_list. Rejects an
//       empty kv_title, an empty pairs list, and a non-PrismNode element.

import prism_arrange
import prism_content
import prism_ui_kit

// ── Entry: key + value + an optional per-row note (see header) ──────────────────────────────────
// Fields are `kv_`-prefixed -- verified clear of collision across the whole tree (see header).
type PrismKvEntry
    kv_key: string
    kv_value: string
    kv_note: string?

// Struct positional constructors are file-local cross-module (verified for this exact shape by
// prism_interact.nova's `prism_pick_option` header note and prism_ui_transfer.nova's
// `prism_xf_item`), hence the validating wrapper below rather than a bare `PrismKvEntry(...)` call
// from an importing file. Rejects an empty key -- see header for why value stays unrestricted.
fn prism_kve_new(key: string, value: string, note: string?) -> Result<PrismKvEntry>
    if len(key) == 0
        return err("prism_kve_new: key must not be empty")
    ok(PrismKvEntry(key, value, note))

fn prism_kve_key(e: PrismKvEntry) -> string
    e.kv_key

fn prism_kve_value(e: PrismKvEntry) -> string
    e.kv_value

fn prism_kve_note(e: PrismKvEntry) -> string?
    e.kv_note

// ── Shared: "a bare list of already-built PrismNodes, non-empty" -- the EXACT discipline
// prism_kv_list and prism_kv_section both need. Same "type_name(...) != PrismNode, named by index
// and type" guard prism_node_new's own children check, prism_st_card/prism_st_dashboard, and
// prism_rt_review_list all already use, deduplicated here because both call sites in THIS file
// need the identical check (the same reasoning `_prism_rt_check_bounds`/`_prism_xf_index` already
// apply to their own files' repeated checks).
fn _prism_kv_check_pairs(fn_name: string, pairs: list) -> Result<int>
    if len(pairs) == 0
        return err(fn_name + ": pairs must not be empty")
    for idx, p in pairs
        if type_name(p) != "PrismNode"
            return err(fn_name + ": pair " + str(idx) + " is not a PrismNode (got " + type_name(p) + ")")
    ok(0)

// ── Single pair: band[label(key), label(value)] ──────────────────────────────────────────────────
fn prism_kv_pair(kv_key: string, kv_value: string) -> Result<PrismNode>
    if len(kv_key) == 0
        return err("prism_kv_pair: kv_key must not be empty")
    let key_node = prism_content.prism_label(kv_key)?
    let value_node = prism_content.prism_label(kv_value)?
    prism_arrange.prism_band([key_node, value_node])

// ── Vertical list of already-built pairs: stack(pairs) ───────────────────────────────────────────
fn prism_kv_list(pairs: list) -> Result<PrismNode>
    _prism_kv_check_pairs("prism_kv_list", pairs)?
    prism_arrange.prism_stack(pairs)

// ── Structured table from typed PrismKvEntry values ──────────────────────────────────────────────
// One entry -> its rendered row (see header for the note-degrades-to-bare-row rule). PRIVATE and
// takes the already-guarded, typed struct directly -- `prism_kv_table` checks `type_name(e) ==
// "PrismKvEntry"` for every element BEFORE this runs, the same "guard before the first field read"
// discipline prism_node_new's own children loop established, so no re-check happens here.
fn _prism_kv_entry_node(e: PrismKvEntry) -> Result<PrismNode>
    let row = prism_kv_pair(e.kv_key, e.kv_value)?
    match e.kv_note
        None => ok(row)
        Some(n) =>
            if len(n) == 0
                return ok(row)
            let note_node = prism_content.prism_label(n)?
            prism_arrange.prism_stack([row, note_node])

// `kv_entries` is a bare `list` (not `list<PrismKvEntry>` -- mirroring every other bare-list
// parameter of a caller-supplied struct collection in this codebase, e.g. prism_ui_transfer.nova's
// `all_items`), so every element is guarded with the same `type_name(...) != "PrismKvEntry"` check,
// named by index and actual type, before any field is read.
fn prism_kv_table(kv_entries: list) -> Result<PrismNode>
    if len(kv_entries) == 0
        return err("prism_kv_table: kv_entries must not be empty")
    for idx, e in kv_entries
        if type_name(e) != "PrismKvEntry"
            return err("prism_kv_table: entry " + str(idx) + " is not a PrismKvEntry (got " + type_name(e) + ")")
    let mk = fn(e) _prism_kv_entry_node(e)
    let rows = prism_ui_kit.prism_ui_collect(kv_entries, mk)?
    prism_arrange.prism_stack(rows)

// ── Titled section: title + a fixed gap + a stack of pairs (see header for why the gap is fixed
// and why this is not a reuse of prism_ui_kit.prism_ui_section) ─────────────────────────────────
let PRISM_KV_SECTION_GAP = 8

fn prism_kv_section(kv_title: string, pairs: list) -> Result<PrismNode>
    if len(kv_title) == 0
        return err("prism_kv_section: kv_title must not be empty")
    _prism_kv_check_pairs("prism_kv_section", pairs)?
    let title_node = prism_content.prism_label(kv_title)?
    let gap_node = prism_arrange.prism_gap(some(PRISM_KV_SECTION_GAP))?
    let body = prism_arrange.prism_stack(pairs)?
    prism_arrange.prism_stack([title_node, gap_node, body])
