{
  "name": "nova-lang",
  "displayName": "NOVA Language",
  "description": "Language support for NOVA — syntax highlighting, diagnostics, and completion",
  "version": "0.2.0",
  "publisher": "nova-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nova",
        "aliases": [
          "NOVA",
          "nova"
        ],
        "extensions": [
          ".nova",
          ".nv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nova",
        "scopeName": "source.nova",
        "path": "./syntaxes/nova.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "NOVA",
      "properties": {
        "nova.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the NOVA LSP server binary (nova-lsp.exe). If empty, uses bin/nova-lsp.exe inside the extension."
        },
        "nova.compiler.path": {
          "type": "string",
          "default": "",
          "description": "Path to the NOVA compiler binary (nova-compiler.exe). If empty, uses bin/nova-compiler.exe inside the extension."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nova-lang/nova"
  }
}
