{
  "name": "nova-lang",
  "displayName": "NOVA Language",
  "description": "Language support for NOVA — syntax highlighting, diagnostics, goto-definition, completion, outline, find-references, rename, formatting, folding, and workspace symbol search",
  "version": "0.4.0",
  "publisher": "nova-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nova",
        "aliases": [
          "NOVA",
          "nova"
        ],
        "extensions": [
          ".nova",
          ".nv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nova",
        "scopeName": "source.nova",
        "path": "./syntaxes/nova.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "NOVA",
      "properties": {
        "nova.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the NOVA compiler/LSP binary (nova-compiler.exe). If empty, uses bin/nova-compiler.exe inside the extension. This binary handles compilation, LSP (goto-definition, diagnostics, completions), and debugging."
        },
        "nova.compiler.path": {
          "type": "string",
          "default": "",
          "description": "Path to the NOVA compiler binary (nova-compiler.exe). If empty, uses bin/nova-compiler.exe inside the extension."
        },
        "nova.debug.lldbDapPath": {
          "type": "string",
          "default": "",
          "description": "Path to lldb-dap (LLDB's DAP adapter). If empty, the extension looks for lldb-dap on PATH."
        }
      }
    },
    "debuggers": [
      {
        "type": "nova",
        "label": "NOVA",
        "languages": [
          "nova"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .nova source file to compile and debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Command-line arguments passed to the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory.",
                "default": "${workspaceFolder}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause at program entry instead of running to first breakpoint.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nova",
            "request": "launch",
            "name": "NOVA: Debug current file",
            "program": "${file}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "NOVA: Launch",
            "description": "Compile + debug a NOVA file with lldb-dap.",
            "body": {
              "type": "nova",
              "request": "launch",
              "name": "NOVA: Debug current file",
              "program": "^\"\\${file}\"",
              "args": [],
              "cwd": "^\"\\${workspaceFolder}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "workbench.action.gotoSymbol",
        "key": "ctrl+o",
        "when": "editorTextFocus && editorLangId == nova"
      },
      {
        "command": "editor.action.referenceSearch.trigger",
        "key": "ctrl+shift+g",
        "when": "editorTextFocus && editorLangId == nova"
      },
      {
        "command": "editor.action.rename",
        "key": "alt+shift+r",
        "when": "editorTextFocus && editorLangId == nova"
      },
      {
        "command": "workbench.action.showAllSymbols",
        "key": "ctrl+shift+t",
        "when": "editorTextFocus && editorLangId == nova"
      },
      {
        "command": "editor.action.formatDocument",
        "key": "ctrl+shift+f",
        "when": "editorTextFocus && editorLangId == nova && !editorReadonly"
      },
      {
        "command": "editor.action.triggerParameterHints",
        "key": "ctrl+shift+space",
        "when": "editorTextFocus && editorLangId == nova"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nova-lang/nova"
  }
}
