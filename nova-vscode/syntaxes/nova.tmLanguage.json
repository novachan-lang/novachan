{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "NOVA",
    "scopeName": "source.nova",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#functions" },
        { "include": "#operators" },
        { "include": "#constants" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.nova",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.nova",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "meta.interpolation.nova",
                            "begin": "\\{",
                            "end": "\\}",
                            "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.nova" } },
                            "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.nova" } },
                            "patterns": [
                                { "include": "#numbers" },
                                { "include": "#keywords" },
                                { "include": "#functions" },
                                { "include": "#operators" }
                            ]
                        },
                        {
                            "name": "constant.character.escape.nova",
                            "match": "\\\\[nrt\\\\\"\\{\\}0]"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.nova",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.hex.nova",
                    "match": "\\b0x[0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.integer.nova",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.nova",
                    "match": "\\b(if|else|for|while|match|return|break|continue|try|catch|yield|loop|defer|unless|until)\\b"
                },
                {
                    "name": "keyword.declaration.nova",
                    "match": "\\b(fn|let|const|type|enum|trait|impl|import|as|mod|extern|with)\\b"
                },
                {
                    "name": "keyword.operator.logical.nova",
                    "match": "\\b(and|or|not|in|matches)\\b"
                },
                {
                    "name": "keyword.concurrency.nova",
                    "match": "\\b(spawn|send|receive|channel|select|reschedule|shutdown_requested)\\b"
                },
                {
                    "name": "keyword.unsafe.nova",
                    "match": "\\b(unsafe)\\b"
                },
                {
                    "name": "keyword.other.nova",
                    "match": "\\b(copy|arena_enter|arena_exit)\\b"
                },
                {
                    "name": "meta.decorator.nova",
                    "match": "@(test|get|post|put|delete|patch|route|cdecl|bench|init|shutdown|middleware|websocket|cron|validate)",
                    "captures": { "0": { "name": "entity.name.function.decorator.nova" } }
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.nova",
                    "match": "\\b(int|string|float|bool|list|dict|any|void|bytes)\\b"
                },
                {
                    "name": "entity.name.type.nova",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "comment": "fn <T> name(...) — generic function",
                    "name": "meta.function.definition.generic.nova",
                    "match": "\\b(fn)\\s+(<[^>]+>)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.nova" },
                        "2": { "name": "storage.type.generic.nova" },
                        "3": { "name": "entity.name.function.nova" }
                    }
                },
                {
                    "comment": "fn Type.method(...) — receiver method",
                    "name": "meta.function.definition.method.nova",
                    "match": "\\b(fn)\\s+([A-Z][a-zA-Z0-9_]*)\\.([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.nova" },
                        "2": { "name": "entity.name.type.nova" },
                        "3": { "name": "entity.name.function.nova" }
                    }
                },
                {
                    "comment": "fn name(...) — regular function",
                    "name": "meta.function.definition.nova",
                    "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.nova" },
                        "2": { "name": "entity.name.function.nova" }
                    }
                },
                {
                    "name": "support.function.builtin.nova",
                    "match": "\\b(print|println|len|str|int|float|bool|push|pop|ord|chr|assert|contains|read_file|write_file|append_file|args|exit|split|join|upper|lower|trim|replace|starts_with|ends_with|slice|repeat|chars|time_ms|sleep|clock_ns|type_of|range|sort|sort_by|keys|values|system|exec|http_get|http_post|mkdir|mkdir_p|path_join|path_exists|path_parent|path_name|parse_int|parse_float|file_exists|find|read_line|channel|close|send|recv|select|spawn|copy|sqrt|abs|min|max|floor|ceil|round|pow|log|exp|to_json|from_json|from_json_safe|json_stringify|json_parse|format|sprintf|index_of|last_index_of|reverse|zip|enumerate|flat_map|reduce|any|all|count|sum|product|tcp_connect|tcp_listen|tcp_accept|tcp_send|tcp_recv|tcp_close|dns_resolve|dns_resolve_all|logx|log_debug|log_info|log_warn|log_error|hash|sha256|base64_encode|base64_decode|random_int|random_float|bytes_of|bytes_len|bytes_get|bytes_set|arena_enter|arena_exit|reschedule|shutdown_requested)\\b"
                },
                {
                    "name": "entity.name.function.call.nova",
                    "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.nova" }
                    }
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.nova",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.nova",
                    "match": "->|=>"
                },
                {
                    "name": "keyword.operator.range.nova",
                    "match": "\\.\\."
                },
                {
                    "name": "keyword.operator.comparison.nova",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.nova",
                    "match": "\\+=|-=|\\*=|/=|%=|="
                },
                {
                    "name": "keyword.operator.arithmetic.nova",
                    "match": "[+\\-*/%]"
                },
                {
                    "name": "keyword.operator.try.nova",
                    "match": "\\?"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.bracket.nova",
                    "match": "[\\(\\)\\[\\]\\{\\}]"
                },
                {
                    "name": "punctuation.separator.nova",
                    "match": "[,:]"
                },
                {
                    "name": "punctuation.accessor.nova",
                    "match": "\\."
                }
            ]
        }
    }
}
