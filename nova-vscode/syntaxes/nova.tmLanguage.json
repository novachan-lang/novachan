{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "NOVA",
    "scopeName": "source.nova",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#functions" },
        { "include": "#operators" },
        { "include": "#constants" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.nova",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.interpolated.nova",
                    "begin": "f\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "meta.interpolation.nova",
                            "begin": "\\{",
                            "end": "\\}",
                            "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.nova" } },
                            "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.nova" } },
                            "patterns": [
                                { "include": "source.nova" }
                            ]
                        },
                        {
                            "name": "constant.character.escape.nova",
                            "match": "\\\\[nrt\\\\\"\\{\\}0]"
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.nova",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.nova",
                            "match": "\\\\[nrt\\\\\"0]"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.nova",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.hex.nova",
                    "match": "\\b0x[0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.integer.nova",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.nova",
                    "match": "\\b(if|else|for|while|match|return|break|continue|try|catch|yield)\\b"
                },
                {
                    "name": "keyword.declaration.nova",
                    "match": "\\b(fn|let|type|enum|trait|import|as)\\b"
                },
                {
                    "name": "keyword.operator.logical.nova",
                    "match": "\\b(and|or|not|in|matches)\\b"
                },
                {
                    "name": "keyword.concurrency.nova",
                    "match": "\\b(spawn|send|receive|channel|select)\\b"
                },
                {
                    "name": "keyword.other.nova",
                    "match": "\\b(copy)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.nova",
                    "match": "\\b(int|string|float|bool|list|dict|any|void)\\b"
                },
                {
                    "name": "entity.name.type.nova",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "meta.function.definition.nova",
                    "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.nova" },
                        "2": { "name": "entity.name.function.nova" }
                    }
                },
                {
                    "name": "support.function.builtin.nova",
                    "match": "\\b(print|len|str|int|push|ord|chr|assert|contains|read_file|write_file|args|exit|split|join|upper|lower|trim|replace|starts_with|ends_with|slice|repeat|chars|time_ms|sleep|clock_ns|type_of|range|sort|keys|values|system|exec|http_get|http_post|mkdir|mkdir_p|path_join|path_exists|path_parent|path_name|parse_int|parse_float|file_exists|find|append_file|read_line)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.nova",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.nova",
                    "match": "->|=>"
                },
                {
                    "name": "keyword.operator.comparison.nova",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.nova",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arithmetic.nova",
                    "match": "[+\\-*/%]"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.bracket.nova",
                    "match": "[\\(\\)\\[\\]\\{\\}]"
                },
                {
                    "name": "punctuation.separator.nova",
                    "match": "[,:]"
                },
                {
                    "name": "punctuation.accessor.nova",
                    "match": "\\."
                }
            ]
        }
    }
}
