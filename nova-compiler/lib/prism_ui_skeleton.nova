import prism_node
import prism_arrange
import prism_content

// Skeleton line: label with sk_width attr for placeholder width
fn prism_sk_line(width: int) -> Result<PrismNode>
    if width <= 0
        return err("prism_sk_line: width must be > 0")
    // Create a label with repeated placeholder chars
    let mut text = ""
    let mut i = 0
    while i < width
        text = text + "_"
        i += 1
    prism_content.prism_label(text)

// Skeleton paragraph: stack of N lines
fn prism_sk_paragraph(lines: int, width: int) -> Result<PrismNode>
    if lines <= 0
        return err("prism_sk_paragraph: lines must be > 0")
    if width <= 0
        return err("prism_sk_paragraph: width must be > 0")
    let children = []
    let mut i = 0
    while i < lines
        let line = prism_sk_line(width)?
        children.push(line)
        i += 1
    prism_arrange.prism_stack(children)

// Skeleton card: band[circle_placeholder, paragraph]
fn prism_sk_card(lines: int) -> Result<PrismNode>
    if lines <= 0
        return err("prism_sk_card: lines must be > 0")
    let circle = prism_content.prism_label("[O]")?
    let body = prism_sk_paragraph(lines, 20)?
    prism_arrange.prism_band([circle, body])

// Skeleton list: stack of N identical skeleton lines
fn prism_sk_list(count: int, width: int) -> Result<PrismNode>
    if count <= 0
        return err("prism_sk_list: count must be > 0")
    if width <= 0
        return err("prism_sk_list: width must be > 0")
    let children = []
    let mut i = 0
    while i < count
        let line = prism_sk_line(width)?
        children.push(line)
        i += 1
    prism_arrange.prism_stack(children)
