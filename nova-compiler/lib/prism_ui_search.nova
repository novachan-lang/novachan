// prism_ui_search -- search/filter bar composite widgets built on prism_arrange/prism_content/
// prism_interact primitives.
//
// NOTE on prism_entry's real signature: prism_interact.prism_entry takes (prompt, kind, value) --
// NOT a bare (placeholder) -- so the search entry here is built with prism_entry_kind_search()
// and an empty initial value. The `placeholder` parameter name on the functions below is kept
// as the caller-facing concept (the prompt text shown on the search field).

import prism_node
import prism_arrange
import prism_content
import prism_interact

// 1. Search bar: band[search_entry, search_button]
fn prism_sr_search(placeholder: string) -> Result<PrismNode>
    if len(placeholder) == 0
        return err("prism_sr_search: placeholder must not be empty")
    let entry = prism_interact.prism_entry(placeholder, prism_interact.prism_entry_kind_search(), "")?
    let btn_lbl = prism_content.prism_label("Search")?
    let btn = prism_interact.prism_press("Search", [btn_lbl])?
    prism_arrange.prism_band([entry, btn])

// 2. Search with clear: band[entry, clear_button, search_button]
fn prism_sr_clearable(placeholder: string, has_text: bool) -> Result<PrismNode>
    if len(placeholder) == 0
        return err("prism_sr_clearable: placeholder must not be empty")
    let entry = prism_interact.prism_entry(placeholder, prism_interact.prism_entry_kind_search(), "")?
    let search_lbl = prism_content.prism_label("Search")?
    let search_btn = prism_interact.prism_press("Search", [search_lbl])?
    if has_text
        let clear_lbl = prism_content.prism_label("Clear")?
        let clear_btn = prism_interact.prism_press("Clear search", [clear_lbl])?
        return prism_arrange.prism_band([entry, clear_btn, search_btn])
    prism_arrange.prism_band([entry, search_btn])

// 3. Filter bar: band[filter_buttons...] -- each filter is a press button
fn prism_sr_filters(filters: list, active_filter: string) -> Result<PrismNode>
    if len(filters) == 0
        return err("prism_sr_filters: filters must not be empty")
    let children = []
    let mut idx = 0
    for f in filters
        if type_name(f) != "string"
            return err("prism_sr_filters: filter " + str(idx) + " is not a string (got " + type_name(f) + ")")
        let prefix = "  "
        if f == active_filter
            prefix = "> "
        let lbl = prism_content.prism_label(prefix + f)?
        let btn = prism_interact.prism_press("Filter by " + f, [lbl])?
        children.push(btn)
        idx += 1
    prism_arrange.prism_band(children)

// 4. Search with filters: stack[search_bar, filter_bar]
fn prism_sr_combo(placeholder: string, filters: list, active_filter: string) -> Result<PrismNode>
    if len(placeholder) == 0
        return err("prism_sr_combo: placeholder must not be empty")
    if len(filters) == 0
        return err("prism_sr_combo: filters must not be empty")
    let search = prism_sr_search(placeholder)?
    let filter_bar = prism_sr_filters(filters, active_filter)?
    let gap = prism_arrange.prism_gap(some(8))?
    prism_arrange.prism_stack([search, gap, filter_bar])

// 5. Result count: label showing "N results" or "No results"
fn prism_sr_count(count: int) -> Result<PrismNode>
    if count < 0
        return err("prism_sr_count: count must be >= 0")
    if count == 0
        return prism_content.prism_label("No results")
    prism_content.prism_label(str(count) + " results")
