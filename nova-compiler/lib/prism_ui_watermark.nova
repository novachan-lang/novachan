import prism_node
import prism_arrange
import prism_content

// 1. Watermark: layer[content, watermark_label] — text overlaid on content
fn prism_wm_watermark(content: list, text: string) -> Result<PrismNode>
    if len(content) == 0
        return err("prism_wm_watermark: content must not be empty")
    if len(text) == 0
        return err("prism_wm_watermark: text must not be empty")
    let mut idx = 0
    for c in content
        if type_name(c) != "PrismNode"
            return err("prism_wm_watermark: child " + str(idx) + " is not a PrismNode (got " + type_name(c) + ")")
        idx += 1
    let body = prism_arrange.prism_stack(content)?
    let mark = prism_content.prism_label(text)?
    prism_arrange.prism_layer([body, mark])

// 2. Stamp: band[stamp_label] — a standalone badge/stamp label
fn prism_wm_stamp(text: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_wm_stamp: text must not be empty")
    let lbl = prism_content.prism_label("[" + text + "]")?
    prism_arrange.prism_band([lbl])

// 3. Confidential watermark: preset watermark with "CONFIDENTIAL" text
fn prism_wm_confidential(content: list) -> Result<PrismNode>
    prism_wm_watermark(content, "CONFIDENTIAL")

// 4. Draft watermark: preset watermark with "DRAFT" text
fn prism_wm_draft(content: list) -> Result<PrismNode>
    prism_wm_watermark(content, "DRAFT")

// 5. Watermark with repeat: layer[content, repeated_watermark_labels]
//    repeats the watermark text N times in a stack
fn prism_wm_repeated(content: list, text: string, repeat_count: int) -> Result<PrismNode>
    if len(content) == 0
        return err("prism_wm_repeated: content must not be empty")
    if len(text) == 0
        return err("prism_wm_repeated: text must not be empty")
    if repeat_count <= 0
        return err("prism_wm_repeated: repeat_count must be > 0")
    let mut idx = 0
    for c in content
        if type_name(c) != "PrismNode"
            return err("prism_wm_repeated: child " + str(idx) + " is not a PrismNode (got " + type_name(c) + ")")
        idx += 1
    let body = prism_arrange.prism_stack(content)?
    let marks = []
    idx = 0
    while idx < repeat_count
        let m = prism_content.prism_label(text)?
        marks.push(m)
        idx += 1
    let overlay = prism_arrange.prism_stack(marks)?
    prism_arrange.prism_layer([body, overlay])
