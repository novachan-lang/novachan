// forge_ops_health -- Health check framework: named checks are zero-arg callables returning a
// Result (ok(msg) = healthy, err(msg) = unhealthy). The registry runs each check IN REGISTRATION
// ORDER, times it with time_ms(), and returns a flat per-check result list -- convenient for
// rendering a /healthz JSON body or a health dashboard row-by-row.
//
// Distinct from the existing health modules: forge_health's health_check() returns a nested
// {status, components} dict with no timing; forge_health_checker's hc_ API is a pass/fail counter,
// not a per-run report; forge_health_check_runner's hcr_ API checks a fixed endpoint string, not a
// callable; forge_health_aggregator's ha_ API tracks up/down history per service, not one-shot
// timed runs. None of them report duration_ms or return an ordered list shape. LEAF -- imports
// NOTHING.

fn oh_new() -> dict
    {"names": [], "checks": {}}

// Register (or replace) a named check. `check_fn` is a zero-arg callable returning Result:
// ok(message) means healthy, err(message) means unhealthy. Fluent.
fn oh_add(reg: dict, name: string, check_fn) -> dict
    if name not in reg["checks"]
        push(reg["names"], name)
    reg["checks"][name] = check_fn
    reg

// Run every registered check, in registration order, timing each with time_ms(). Returns a list of
// {"name": string, "status": "healthy"|"unhealthy", "msg": string, "duration_ms": int}.
fn oh_run_all(reg: dict) -> list
    let results = []
    let names = reg["names"]
    for i in 0..len(names)
        let name = names[i]
        let check = reg["checks"][name]
        let start = time_ms()
        let r = check()
        let elapsed = time_ms() - start
        let status = "healthy" if is_ok(r) else "unhealthy"
        let msg = unwrap(r) if is_ok(r) else unwrap_err(r)
        let entry = {"name": name, "status": status, "msg": msg, "duration_ms": elapsed}
        push(results, entry)
    results

// Aggregate: true iff every result in `results` (as returned by oh_run_all) is "healthy".
// An empty result list is vacuously healthy.
fn oh_is_healthy(results: list) -> bool
    for i in 0..len(results)
        if results[i]["status"] != "healthy"
            return false
    true

fn oh_check_count(reg: dict) -> int
    len(reg["names"])
