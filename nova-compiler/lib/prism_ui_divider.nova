// prism_ui_divider -- divider/separator components (MB.32)
//
// Visual separators between content sections. No new PrismNodeKind — composes
// the existing 22 primitives (axiom A7). A divider is a label("---") or a
// band/stack arrangement thereof.

import prism_node
import prism_arrange
import prism_content

// ── Simple dividers ──────────────────────────────────────────────────────────

fn prism_dv_horizontal() -> Result<PrismNode>
    prism_content.prism_label("---")

fn prism_dv_vertical() -> Result<PrismNode>
    prism_content.prism_label("|")

// ── Labeled divider: band["---", text, "---"] ────────────────────────────────

fn prism_dv_labeled(text: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_dv_labeled: text must not be empty")
    let left = prism_content.prism_label("---")?
    let mid = prism_content.prism_label(text)?
    let right = prism_content.prism_label("---")?
    prism_arrange.prism_band([left, mid, right])

// ── Spaced divider: stack[gap, hr, gap] ──────────────────────────────────────
// prism_gap takes int? — `some(px)` for fixed, `none()` for flexible.

fn prism_dv_spaced(px: int) -> Result<PrismNode>
    if px <= 0
        return err("prism_dv_spaced: px must be > 0")
    let top_gap = prism_arrange.prism_gap(some(px))?
    let divider = prism_dv_horizontal()?
    let bottom_gap = prism_arrange.prism_gap(some(px))?
    prism_arrange.prism_stack([top_gap, divider, bottom_gap])

// ── Section: stack[labeled_divider, ...children] ─────────────────────────────

fn prism_dv_section(title: string, children: list) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_dv_section: title must not be empty")
    if len(children) == 0
        return err("prism_dv_section: children must not be empty")
    let mut idx = 0
    for child in children
        if type_name(child) != "PrismNode"
            return err("prism_dv_section: child " + str(idx) + " is not a PrismNode (got " + type_name(child) + ")")
        idx += 1
    let heading = prism_dv_labeled(title)?
    let items = [heading]
    for child in children
        items.push(child)
    prism_arrange.prism_stack(items)
