import prism_node
import prism_arrange
import prism_content

// Step status: "done", "active", "pending"
// represented as string since we can't use cross-module enums

// 1. Step indicator: band[status_marker, label]
//    done = "[x] ", active = "[>] ", pending = "[ ] "
fn prism_st_step(label: string, status: string) -> Result<PrismNode>
    if len(label) == 0
        return err("prism_st_step: label must not be empty")
    if status != "done" and status != "active" and status != "pending"
        return err("prism_st_step: status must be 'done', 'active', or 'pending' (got '" + status + "')")
    let marker = "[ ] "
    if status == "done"
        marker = "[x] "
    if status == "active"
        marker = "[>] "
    let m = prism_content.prism_label(marker)?
    let l = prism_content.prism_label(label)?
    prism_arrange.prism_band([m, l])

// 2. Connector between steps: label("---")
fn prism_st_connector() -> Result<PrismNode>
    prism_content.prism_label("---")

// 3. Steps bar: band[step, connector, step, connector, ..., step]
//    Takes a list of [label, status] pairs as a flat list: [label1, status1, label2, status2, ...]
fn prism_st_steps(labels: list, statuses: list) -> Result<PrismNode>
    if len(labels) == 0
        return err("prism_st_steps: labels must not be empty")
    if len(labels) != len(statuses)
        return err("prism_st_steps: labels and statuses must have same length (got " + str(len(labels)) + " vs " + str(len(statuses)) + ")")
    let children = []
    let mut idx = 0
    for label in labels
        if type_name(label) != "string"
            return err("prism_st_steps: label " + str(idx) + " is not a string (got " + type_name(label) + ")")
        if type_name(statuses[idx]) != "string"
            return err("prism_st_steps: status " + str(idx) + " is not a string (got " + type_name(statuses[idx]) + ")")
        if idx > 0
            let conn = prism_st_connector()?
            children.push(conn)
        let step = prism_st_step(label, statuses[idx])?
        children.push(step)
        idx += 1
    prism_arrange.prism_band(children)

// 4. Auto steps: given step names and current index, auto-assign done/active/pending
fn prism_st_auto(step_names: list, current: int) -> Result<PrismNode>
    if len(step_names) == 0
        return err("prism_st_auto: step_names must not be empty")
    if current < 0 or current >= len(step_names)
        return err("prism_st_auto: current " + str(current) + " out of bounds (0.." + str(len(step_names) - 1) + ")")
    let statuses = []
    let mut idx = 0
    for name in step_names
        if type_name(name) != "string"
            return err("prism_st_auto: step " + str(idx) + " is not a string (got " + type_name(name) + ")")
        if idx < current
            statuses.push("done")
        if idx == current
            statuses.push("active")
        if idx > current
            statuses.push("pending")
        idx += 1
    prism_st_steps(step_names, statuses)

// 5. Vertical steps: stack[step, connector, step, ...] (vertical layout)
fn prism_st_vertical(labels: list, statuses: list) -> Result<PrismNode>
    if len(labels) == 0
        return err("prism_st_vertical: labels must not be empty")
    if len(labels) != len(statuses)
        return err("prism_st_vertical: labels and statuses must have same length")
    let children = []
    let mut idx = 0
    for label in labels
        if type_name(label) != "string"
            return err("prism_st_vertical: label " + str(idx) + " is not a string")
        if type_name(statuses[idx]) != "string"
            return err("prism_st_vertical: status " + str(idx) + " is not a string")
        if idx > 0
            let conn = prism_content.prism_label("  |")?
            children.push(conn)
        let step = prism_st_step(label, statuses[idx])?
        children.push(step)
        idx += 1
    prism_arrange.prism_stack(children)
