import prism_node
import prism_arrange
import prism_content

type PrismComment
    cm_author: string
    cm_text: string
    cm_time: string

fn prism_cm_comment(author: string, text: string, time: string) -> PrismComment
    PrismComment(author, text, time)

fn prism_cm_author(c: PrismComment) -> string
    c.cm_author

fn prism_cm_text(c: PrismComment) -> string
    c.cm_text

fn prism_cm_time(c: PrismComment) -> string
    c.cm_time

// Render a single comment: stack[band[author_label, time_label], text_label]
fn prism_cm_render(comment: PrismComment) -> Result<PrismNode>
    if len(comment.cm_author) == 0
        return err("prism_cm_render: author must not be empty")
    if len(comment.cm_text) == 0
        return err("prism_cm_render: text must not be empty")
    let author_lbl = prism_content.prism_label(comment.cm_author)?
    let children = [author_lbl]
    if len(comment.cm_time) > 0
        let time_lbl = prism_content.prism_label(comment.cm_time)?
        children.push(time_lbl)
    let header = prism_arrange.prism_band(children)?
    let body = prism_content.prism_label(comment.cm_text)?
    prism_arrange.prism_stack([header, body])

// Render a thread: stack of rendered comments
fn prism_cm_thread(comments: list) -> Result<PrismNode>
    if len(comments) == 0
        return err("prism_cm_thread: comments list must not be empty")
    let nodes = []
    let mut idx = 0
    for c in comments
        if type_name(c) != "PrismComment"
            return err("prism_cm_thread: element " + str(idx) + " is not a PrismComment (got " + type_name(c) + ")")
        let node = prism_cm_render(c)?
        nodes.push(node)
        idx += 1
    prism_arrange.prism_stack(nodes)

// Reply indicator: band["> ", author, ": ", snippet]
fn prism_cm_reply_preview(comment: PrismComment, max_len: int) -> Result<PrismNode>
    if len(comment.cm_author) == 0
        return err("prism_cm_reply_preview: author must not be empty")
    if max_len <= 0
        return err("prism_cm_reply_preview: max_len must be > 0")
    let prefix = prism_content.prism_label("> ")?
    let author_lbl = prism_content.prism_label(comment.cm_author + ": ")?
    let text = comment.cm_text
    let mut snippet = text
    if len(text) > max_len
        snippet = ""
        let mut i = 0
        while i < max_len
            snippet = snippet + str(text[i])
            i += 1
        snippet = snippet + "..."
    let snippet_lbl = prism_content.prism_label(snippet)?
    prism_arrange.prism_band([prefix, author_lbl, snippet_lbl])
