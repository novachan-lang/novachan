import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_link

// 1. Page header: band[logo_label, flexible_gap, nav_items]
fn prism_hd_header(logo: string, nav_items: list) -> Result<PrismNode>
    if len(logo) == 0
        return err("prism_hd_header: logo must not be empty")
    let logo_lbl = prism_content.prism_label(logo)?
    let spacer = prism_arrange.prism_gap(none())?
    if len(nav_items) == 0
        return prism_arrange.prism_band([logo_lbl, spacer])
    let mut idx = 0
    for n in nav_items
        if type_name(n) != "PrismNode"
            return err("prism_hd_header: nav_item " + str(idx) + " is not a PrismNode (got " + type_name(n) + ")")
        idx += 1
    let nav = prism_arrange.prism_band(nav_items)?
    prism_arrange.prism_band([logo_lbl, spacer, nav])

// 2. Page footer: stack[divider, band[copyright, flexible_gap, links]]
fn prism_hd_footer(copyright: string, link_items: list) -> Result<PrismNode>
    if len(copyright) == 0
        return err("prism_hd_footer: copyright must not be empty")
    let divider = prism_content.prism_label("---")?
    let copy_lbl = prism_content.prism_label(copyright)?
    let spacer = prism_arrange.prism_gap(none())?
    if len(link_items) == 0
        let row = prism_arrange.prism_band([copy_lbl, spacer])?
        return prism_arrange.prism_stack([divider, row])
    let mut idx = 0
    for l in link_items
        if type_name(l) != "PrismNode"
            return err("prism_hd_footer: link_item " + str(idx) + " is not a PrismNode (got " + type_name(l) + ")")
        idx += 1
    let links = prism_arrange.prism_band(link_items)?
    let row = prism_arrange.prism_band([copy_lbl, spacer, links])?
    prism_arrange.prism_stack([divider, row])

// 3. Hero section: stack[title, subtitle, optional CTA button]
fn prism_hd_hero(title: string, subtitle: string, cta_label: string) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_hd_hero: title must not be empty")
    if len(subtitle) == 0
        return err("prism_hd_hero: subtitle must not be empty")
    let t = prism_content.prism_label(title)?
    let s = prism_content.prism_label(subtitle)?
    let gap = prism_arrange.prism_gap(some(16))?
    if len(cta_label) == 0
        return prism_arrange.prism_stack([t, s])
    let btn_lbl = prism_content.prism_label(cta_label)?
    let btn = prism_interact.prism_press(cta_label, [btn_lbl])?
    prism_arrange.prism_stack([t, gap, s, gap, btn])

// 4. Page layout: stack[header, flexible_gap, content, flexible_gap, footer]
fn prism_hd_page(header: PrismNode, content: list, footer: PrismNode) -> Result<PrismNode>
    if len(content) == 0
        return err("prism_hd_page: content must not be empty")
    let mut idx = 0
    for c in content
        if type_name(c) != "PrismNode"
            return err("prism_hd_page: content " + str(idx) + " is not a PrismNode (got " + type_name(c) + ")")
        idx += 1
    let body = prism_arrange.prism_stack(content)?
    let top_gap = prism_arrange.prism_gap(some(16))?
    let bottom_gap = prism_arrange.prism_gap(some(16))?
    prism_arrange.prism_stack([header, top_gap, body, bottom_gap, footer])
