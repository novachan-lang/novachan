import prism_node
import prism_arrange
import prism_content

// Helper: pad a number to 2 digits (e.g., 5 -> "05", 12 -> "12")
fn _prism_cd_pad2(n: int) -> string
    if n < 0
        return "00"
    if n < 10
        return "0" + str(n)
    str(n)

// 1. Timer display: label showing "HH:MM:SS" from total seconds
fn prism_cd_timer(total_seconds: int) -> Result<PrismNode>
    if total_seconds < 0
        return err("prism_cd_timer: total_seconds must be >= 0")
    let hours = total_seconds / 3600
    let minutes = (total_seconds % 3600) / 60
    let seconds = total_seconds % 60
    let text = _prism_cd_pad2(hours) + ":" + _prism_cd_pad2(minutes) + ":" + _prism_cd_pad2(seconds)
    prism_content.prism_label(text)

// 2. Compact timer: label showing "MM:SS" (no hours)
fn prism_cd_compact(total_seconds: int) -> Result<PrismNode>
    if total_seconds < 0
        return err("prism_cd_compact: total_seconds must be >= 0")
    let minutes = total_seconds / 60
    let seconds = total_seconds % 60
    let text = _prism_cd_pad2(minutes) + ":" + _prism_cd_pad2(seconds)
    prism_content.prism_label(text)

// 3. Countdown with label: stack[title_label, timer_label]
fn prism_cd_labeled(title: string, total_seconds: int) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_cd_labeled: title must not be empty")
    let t = prism_content.prism_label(title)?
    let timer = prism_cd_timer(total_seconds)?
    prism_arrange.prism_stack([t, timer])

// 4. Segmented countdown: band[hours_label, ":", minutes_label, ":", seconds_label]
//    Each segment is a separate label for styling
fn prism_cd_segmented(total_seconds: int) -> Result<PrismNode>
    if total_seconds < 0
        return err("prism_cd_segmented: total_seconds must be >= 0")
    let hours = total_seconds / 3600
    let minutes = (total_seconds % 3600) / 60
    let seconds = total_seconds % 60
    let h = prism_content.prism_label(_prism_cd_pad2(hours))?
    let sep1 = prism_content.prism_label(":")?
    let m = prism_content.prism_label(_prism_cd_pad2(minutes))?
    let sep2 = prism_content.prism_label(":")?
    let s = prism_content.prism_label(_prism_cd_pad2(seconds))?
    prism_arrange.prism_band([h, sep1, m, sep2, s])

// 5. Countdown with progress: stack[timer, progress_bar_label]
//    Shows remaining/total as a text bar like "[====------]"
fn prism_cd_progress(remaining: int, total: int, bar_width: int) -> Result<PrismNode>
    if total <= 0
        return err("prism_cd_progress: total must be > 0")
    if remaining < 0
        return err("prism_cd_progress: remaining must be >= 0")
    if bar_width <= 0
        return err("prism_cd_progress: bar_width must be > 0")
    let mut clamped = remaining
    if clamped > total
        clamped = total
    let filled = (clamped * bar_width) / total
    let empty = bar_width - filled
    let mut bar = "["
    let mut i = 0
    while i < filled
        bar = bar + "="
        i += 1
    i = 0
    while i < empty
        bar = bar + "-"
        i += 1
    bar = bar + "]"
    let timer = prism_cd_timer(remaining)?
    let progress = prism_content.prism_label(bar)?
    prism_arrange.prism_stack([timer, progress])
