// forge_ops_canary -- pure canary-split arithmetic and promote/abort threshold gating. Holds NO
// state of its own; it complements the existing STATEFUL canary trackers (forge_canary_deploy's
// cd_ API, forge_canary_release's cr_ API), which already own live traffic routing and running
// request/error counters. This module answers two narrower, stateless questions: given a total
// request volume and a canary percentage, how many requests should each side get (ca_split); and
// given an already-computed metrics snapshot, does the observed error rate clear a promotion/abort
// threshold (ca_promote / ca_abort). LEAF -- imports NOTHING.

// Split `traffic_total` requests between canary and stable at `canary_pct` percent (clamped to
// 0-100). stable_count is the remainder, so canary_count + stable_count always == traffic_total.
fn ca_split(traffic_total: int, canary_pct: int) -> dict
    let pct = canary_pct
    if pct < 0
        pct = 0
    if pct > 100
        pct = 100
    let canary_count = traffic_total * pct / 100
    let stable_count = traffic_total - canary_count
    {"canary_count": canary_count, "stable_count": stable_count}

// canary_metrics: {"requests": int, "errors": int}. Error rate as an integer percentage
// (0 if there have been no requests yet).
fn _ca_error_rate_pct(canary_metrics: dict) -> int
    let requests = canary_metrics["requests"]
    if requests == 0
        return 0
    canary_metrics["errors"] * 100 / requests

// True iff the canary's error rate is strictly below `threshold_pct` -- safe to promote to stable.
fn ca_promote(canary_metrics: dict, threshold_pct: int) -> bool
    _ca_error_rate_pct(canary_metrics) < threshold_pct

// True iff the canary's error rate has reached or exceeded `threshold_pct` -- abort the rollout.
fn ca_abort(canary_metrics: dict, threshold_pct: int) -> bool
    _ca_error_rate_pct(canary_metrics) >= threshold_pct
