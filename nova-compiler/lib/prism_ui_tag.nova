import prism_node
import prism_arrange
import prism_content
import prism_interact

// 1. Simple tag: label with brackets, e.g., "[Bug]"
fn prism_tg_tag(text: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_tg_tag: text must not be empty")
    prism_content.prism_label("[" + text + "]")

// 2. Colored tag: label with color prefix, e.g., "(red) [Bug]"
fn prism_tg_colored(text: string, color: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_tg_colored: text must not be empty")
    if len(color) == 0
        return err("prism_tg_colored: color must not be empty")
    prism_content.prism_label("(" + color + ") [" + text + "]")

// 3. Removable tag: band[tag_label, close_button]
fn prism_tg_removable(text: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_tg_removable: text must not be empty")
    let tag = prism_content.prism_label("[" + text + "]")?
    let x_lbl = prism_content.prism_label("x")?
    let close = prism_interact.prism_press("Remove tag " + text, [x_lbl])?
    prism_arrange.prism_band([tag, close])

// 4. Tag group: flow layout of tags
fn prism_tg_group(tags: list) -> Result<PrismNode>
    if len(tags) == 0
        return err("prism_tg_group: tags must not be empty")
    let mut idx = 0
    for t in tags
        if type_name(t) != "PrismNode"
            return err("prism_tg_group: tag " + str(idx) + " is not a PrismNode (got " + type_name(t) + ")")
        idx += 1
    prism_arrange.prism_flow(tags)

// 5. Tag with count: label showing "Bug (3)" style
fn prism_tg_counted(text: string, count: int) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_tg_counted: text must not be empty")
    if count < 0
        return err("prism_tg_counted: count must be >= 0")
    prism_content.prism_label("[" + text + " (" + str(count) + ")]")
