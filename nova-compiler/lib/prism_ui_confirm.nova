import prism_node
import prism_arrange
import prism_content
import prism_interact

// 1. Confirm dialog: layer[backdrop, dialog_panel] when visible; empty label when not
//    dialog_panel = stack[message, button_row(cancel + confirm)]
fn prism_cf_confirm(message: string, confirm_label: string, cancel_label: string, visible: bool) -> Result<PrismNode>
    if len(message) == 0
        return err("prism_cf_confirm: message must not be empty")
    if len(confirm_label) == 0
        return err("prism_cf_confirm: confirm_label must not be empty")
    if len(cancel_label) == 0
        return err("prism_cf_confirm: cancel_label must not be empty")
    if not visible
        return prism_content.prism_label("")
    let msg = prism_content.prism_label(message)?
    let gap = prism_arrange.prism_gap(some(12))?
    let confirm_lbl = prism_content.prism_label(confirm_label)?
    let confirm_btn = prism_interact.prism_press(confirm_label, [confirm_lbl])?
    let cancel_lbl = prism_content.prism_label(cancel_label)?
    let cancel_btn = prism_interact.prism_press(cancel_label, [cancel_lbl])?
    let btn_gap = prism_arrange.prism_gap(some(8))?
    let buttons = prism_arrange.prism_band([cancel_btn, btn_gap, confirm_btn])?
    let panel = prism_arrange.prism_stack([msg, gap, buttons])?
    let backdrop = prism_content.prism_label("")?
    prism_arrange.prism_layer([backdrop, panel])

// 2. Delete confirm: preset confirm with warning message
fn prism_cf_delete(item_name: string, visible: bool) -> Result<PrismNode>
    if len(item_name) == 0
        return err("prism_cf_delete: item_name must not be empty")
    prism_cf_confirm("Are you sure you want to delete " + item_name + "?", "Delete", "Cancel", visible)

// 3. Popconfirm: layer[trigger_button, confirm_dialog]
fn prism_cf_popconfirm(trigger_label: string, message: string, confirm_label: string, cancel_label: string, visible: bool) -> Result<PrismNode>
    if len(trigger_label) == 0
        return err("prism_cf_popconfirm: trigger_label must not be empty")
    let trig_lbl = prism_content.prism_label(trigger_label)?
    let trigger = prism_interact.prism_press(trigger_label, [trig_lbl])?
    let dialog = prism_cf_confirm(message, confirm_label, cancel_label, visible)?
    prism_arrange.prism_layer([trigger, dialog])

// 4. Alert dialog: stack[icon_label, message, ok_button] — informational, single button
fn prism_cf_alert(message: string, ok_label: string, visible: bool) -> Result<PrismNode>
    if len(message) == 0
        return err("prism_cf_alert: message must not be empty")
    if len(ok_label) == 0
        return err("prism_cf_alert: ok_label must not be empty")
    if not visible
        return prism_content.prism_label("")
    let icon = prism_content.prism_label("(i) ")?
    let msg = prism_content.prism_label(message)?
    let header = prism_arrange.prism_band([icon, msg])?
    let gap = prism_arrange.prism_gap(some(12))?
    let ok_lbl = prism_content.prism_label(ok_label)?
    let ok_btn = prism_interact.prism_press(ok_label, [ok_lbl])?
    let panel = prism_arrange.prism_stack([header, gap, ok_btn])?
    let backdrop = prism_content.prism_label("")?
    prism_arrange.prism_layer([backdrop, panel])
