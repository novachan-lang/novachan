// forge_ops_inventory -- generic tag-based host inventory: each host carries an arbitrary
// {tag_key: tag_value} dict (env=prod, role=web, region=us-east-1, ...), filterable and groupable
// by any tag key at query time.
//
// Distinct from forge_infra_inventory's inv_ API, which tracks resources under a FIXED two-field
// schema (type, region) baked into the add/query functions themselves -- it cannot answer "group by
// role" or "filter by env=staging" without new code. This module's schema is whatever tags the
// caller attaches. LEAF -- imports NOTHING.

fn oi_new() -> dict
    let inv = {}
    inv["hosts"] = {}
    inv["names"] = []
    inv["count"] = 0
    inv

// Add (or replace the tags of) a host. Fluent.
fn oi_add_host(inv: dict, name: string, tags: dict) -> dict
    if contains(inv["hosts"], name) != true
        push(inv["names"], name)
        inv["count"] = inv["count"] + 1
    inv["hosts"][name] = tags
    inv

// Names of every host whose `tag` key equals `value` (hosts missing `tag` never match).
fn oi_filter(inv: dict, tag: string, value: string) -> list
    let result = []
    let names = inv["names"]
    let i = 0
    while i < len(names)
        let name = names[i]
        let tags = inv["hosts"][name]
        if contains(tags, tag)
            if tags[tag] == value
                push(result, name)
        i = i + 1
    result

// Group every host by the value of `tag_key` -> {tag_value: [host names]}. Hosts missing
// `tag_key` are omitted from every group.
fn oi_groups(inv: dict, tag_key: string) -> dict
    let groups = {}
    let names = inv["names"]
    let i = 0
    while i < len(names)
        let name = names[i]
        let tags = inv["hosts"][name]
        if contains(tags, tag_key)
            let v = tags[tag_key]
            if contains(groups, v) != true
                groups[v] = []
            push(groups[v], name)
        i = i + 1
    groups

fn oi_count(inv: dict) -> int
    inv["count"]

fn oi_has_host(inv: dict, name: string) -> bool
    contains(inv["hosts"], name)
