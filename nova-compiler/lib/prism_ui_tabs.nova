// prism_ui_tabs -- Tabs component family (prism/ui/ composition layer): a plain tab bar (labels
// with the active one marked), a full tabs widget (bar + the active panel), closable tabs (each tab
// pairs its label with a close button), vertical/sidebar tabs, and card-style tabs (bar + gap +
// panel). Composition over the closed 22-primitive vocabulary (widget/), per PRISM_SPEC.md axiom A7.
//
// The active tab is marked by bracketing its own text "[Title]" rather than a boolean flag on the
// label node -- prism_content.prism_label carries no such attr, and the PrismNode vocabulary stays
// closed (axiom A7): the marker lives in the STRING the label already carries, not a new widget
// concept invented just for this file.
//
// `titles` and `panels` travel as two parallel lists rather than one list of [title, panel] pairs --
// prism_tbs_tab_bar and prism_tbs_closable have no panels at all, and share the exact same
// title/active validation that prism_tbs_tabs/vertical/card_tabs also need; a combined-pair shape
// would force the panel-less callers to invent a placeholder panel just to reuse that check.
//
// PUBLIC API (all Result<PrismNode>; every one validates, none fails silently)
//   prism_tbs_tab_bar(titles, active)            -> band[label...], active one is "[Title]".
//     rejects empty titles, a non-string/empty title, active outside [0, len(titles)).
//   prism_tbs_tabs(titles, panels, active)       -> stack[tab_bar, panels[active]].
//     same rejects as tab_bar, plus len(titles) != len(panels) or a non-PrismNode panel.
//   prism_tbs_closable(titles, active)           -> band[band[label, close_press]...]. same rejects
//     as tab_bar.
//   prism_tbs_vertical(titles, panels, active)   -> band[stack[label...], panels[active]]. same
//     rejects as tabs (sidebar layout: tabs stacked, panel beside them).
//   prism_tbs_card_tabs(titles, panels, active)  -> stack[tab_bar, gap(8), panels[active]]. same
//     rejects as tabs.

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_ui_kit

// Shared title/active validation -- every public fn below needs it (every tab bar is built from
// `titles` + `active`), so it lives once instead of five near-identical copies.
fn _prism_tbs_check_titles(fn_name: string, titles: list, active: int) -> Result<int>
    if len(titles) == 0
        return err("{fn_name}: titles must not be empty")
    for i, t in titles
        if not is_string(t)
            return err("{fn_name}: titles[{i}] must be a string, got {type_name(t)}")
        if len(t) == 0
            return err("{fn_name}: titles[{i}] must not be empty")
    if active < 0 or active >= len(titles)
        return err("{fn_name}: active ({active}) must be in [0, {len(titles)})")
    ok(active)

// titles/panels must line up 1:1, and every panel must be a real PrismNode -- the same
// `type_name(...) != "PrismNode"` per-element discipline prism_ui_card / prism_ui_accordion use.
fn _prism_tbs_check_panels(fn_name: string, titles: list, panels: list) -> Result<int>
    if len(titles) != len(panels)
        return err("{fn_name}: titles ({len(titles)}) and panels ({len(panels)}) must be the same length")
    for i, p in panels
        if type_name(p) != "PrismNode"
            return err("{fn_name}: panels[{i}] is not a PrismNode (got {type_name(p)})")
    ok(0)

// One tab label; the active tab is bracketed (see header) -- literal text, never a widget flag.
fn _prism_tbs_label(title: string, i: int, active: int) -> Result<PrismNode>
    prism_content.prism_label("[{title}]") if i == active else prism_content.prism_label(title)

// The row of tab labels shared by tab_bar/tabs/card_tabs (arranged as a band) and vertical
// (arranged as a stack) -- built once, arranged twice, rather than re-derived per caller. Needs the
// index to know which title is active, so it is its own loop rather than prism_ui_kit.prism_ui_collect
// (which maps a plain item -> Result<T> with no index).
fn _prism_tbs_labels(titles: list, active: int) -> Result<list>
    let out = []
    for i, t in titles
        let lbl = _prism_tbs_label(t, i, active)?
        out.push(lbl)
    ok(out)

// ── 1. Plain tab bar ─────────────────────────────────────────────────────────────────────────────
fn prism_tbs_tab_bar(titles: list, active: int) -> Result<PrismNode>
    _prism_tbs_check_titles("prism_tbs_tab_bar", titles, active)?
    let items = _prism_tbs_labels(titles, active)?
    prism_arrange.prism_band(items)

// ── 2. Full tabs: bar + the active panel ────────────────────────────────────────────────────────
fn prism_tbs_tabs(titles: list, panels: list, active: int) -> Result<PrismNode>
    _prism_tbs_check_titles("prism_tbs_tabs", titles, active)?
    _prism_tbs_check_panels("prism_tbs_tabs", titles, panels)?
    let bar = prism_tbs_tab_bar(titles, active)?
    prism_arrange.prism_stack([bar, panels[active]])

// ── 3. Closable tabs: each tab pairs its label with a close button ─────────────────────────────
fn _prism_tbs_closable_item(title: string, i: int, active: int) -> Result<PrismNode>
    let lbl = _prism_tbs_label(title, i, active)?
    let close_btn = prism_interact.prism_press("Close {title}", [])?
    prism_arrange.prism_band([lbl, close_btn])

fn prism_tbs_closable(titles: list, active: int) -> Result<PrismNode>
    _prism_tbs_check_titles("prism_tbs_closable", titles, active)?
    let out = []
    for i, t in titles
        let item = _prism_tbs_closable_item(t, i, active)?
        out.push(item)
    prism_arrange.prism_band(out)

// ── 4. Vertical / sidebar tabs: band[stacked tabs, active panel] ───────────────────────────────
fn prism_tbs_vertical(titles: list, panels: list, active: int) -> Result<PrismNode>
    _prism_tbs_check_titles("prism_tbs_vertical", titles, active)?
    _prism_tbs_check_panels("prism_tbs_vertical", titles, panels)?
    let items = _prism_tbs_labels(titles, active)?
    let side = prism_arrange.prism_stack(items)?
    prism_arrange.prism_band([side, panels[active]])

// ── 5. Card-style tabs: stack[tab_bar, gap, active panel] ──────────────────────────────────────
fn prism_tbs_card_tabs(titles: list, panels: list, active: int) -> Result<PrismNode>
    _prism_tbs_check_titles("prism_tbs_card_tabs", titles, active)?
    _prism_tbs_check_panels("prism_tbs_card_tabs", titles, panels)?
    let bar = prism_tbs_tab_bar(titles, active)?
    let gap = prism_arrange.prism_gap(some(8))?
    prism_arrange.prism_stack([bar, gap, panels[active]])
