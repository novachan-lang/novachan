// prism_ui_transfer -- dual-list transfer / assignment picker (prism/ui/, milestone MB.13): move
// items between a "left" (available) panel and a "right" (assigned) panel by key. A COMPOSITION
// over the closed 22-primitive vocabulary (widget/), built through prism_ui_kit.nova wherever it
// fits -- no new PrismNodeKind (PRISM_SPEC.md axiom A7), same discipline as prism_ui_token.nova
// (MB.12) and every prism/ui/ component before it.
//
// ── WHY THIS IS "STANDARD PERMISSIONS UI", NOT A NOVEL WIDGET ───────────────────────────────────
// This is the assign-roles-to-a-user / grant-permissions-to-a-group shape that appears in every
// admin console (Ant Design's Transfer, Element Plus's el-transfer, Shoelace's dual listbox) --
// exactly the "Ant-Design-class component" set ui/README.md targets. The whole component reduces
// to ONE question -- "is this key currently a member of the right-hand set?" -- and two mutations
// that add or remove a key from that set. Nothing about that needs a new primitive: it renders as
// a `band` holding two `stack`s and a button column, the identical "arrangement primitives
// composing arrangement primitives" shape prism_ui_token's tag input already uses (a `stack` over
// a `flow` and an `entry`).
//
// ── WHY prism_xf_transfer IS A PURE VALUE FUNCTION, NOT A STATEFUL WIDGET ───────────────────────
// Prism has no client-side mutable widget state yet (the reactivity engine is a later milestone) --
// the same boundary prism_interact.prism_pick and prism_ui_input.prism_in_multiselect already live
// inside: the CALLER owns the current selection and re-renders after every change.
// `prism_xf_transfer` takes the current partition as an explicit `right_keys: list` parameter and
// RENDERS it; it never mutates anything. `prism_xf_move_right`/`prism_xf_move_left` are pure
// functions too -- given the current `right_keys` and the keys the user just selected, each
// returns the NEXT `right_keys`, and the caller is responsible for feeding that back into the next
// `prism_xf_transfer` call. This is the identical "value in, value out, caller re-renders"
// discipline every other prism/ui/ component with a "current selection" concept already follows
// (`prism_in_multiselect`'s `selected: list`, `prism_pick`'s `selected_value: string`) -- no
// exception is carved out here.
//
// ── WHY DUPLICATE ITEM KEYS ARE REJECTED AT CONSTRUCTION ────────────────────────────────────────
// `xf_key` is the identity the whole component partitions on: "is this key in `right_keys`" is the
// entire left/right decision, and `prism_xf_move_right`/`_move_left` key their own mutation off it
// too. Two items sharing one key make "move item X right" ambiguous -- which of the two physical
// items does `right_keys` now name? Exactly the ambiguity `prism_interact.prism_pick` already
// rejects for its own option values and `prism_ui_token.prism_tk_tag_input` rejects for tag
// strings -- the same "a caller-visible identifier must denote exactly one thing" rule, applied
// here to `PrismTransferItem.xf_key` instead of a bare string.
//
// ── WHY A DISABLED ITEM RENDERS BUT CANNOT BE MOVED ─────────────────────────────────────────────
// `xf_disabled` models a permission the caller's domain forbids revoking or granting through this
// control (a mandatory role, a locked default) -- it must stay VISIBLE (hiding it would make the
// current assignment look incomplete) but inert to the two mutation functions, mirroring
// `prism_ui_input`'s own stepper rule: "inert-but-present," never silently absent. Because
// `prism_interact` has no `disabled` attr yet (PRISM_SPEC.md defers bound-cell state to the
// reactivity engine, the same limitation that file's header already documents), a disabled item is
// distinguished the same way the closed 12-icon set's absence of a star icon was worked around in
// `prism_ui_input.prism_in_rating`: an honest textual marker (" (disabled)") rather than inventing
// a widget-level attr this layer has nowhere to validate.
//
// PUBLIC API
//   Item
//     PrismTransferItem { xf_key, xf_label: string, xf_disabled: bool } +
//       prism_xf_item(key, label, disabled) -> PrismTransferItem
//     prism_xf_item_key(i) / prism_xf_item_label(i) / prism_xf_item_disabled(i)   accessors
//   Render
//     prism_xf_transfer(all_items: list, right_keys: list, left_title: string, right_title: string)
//       -> Result<PrismNode>
//       band [left_panel, button_column, right_panel]; each panel is a stack [title label, item
//       labels...] in all_items order; a disabled item's label carries a " (disabled)" suffix.
//       rejects: a non-PrismTransferItem element, a duplicate xf_key, a right_keys entry naming no
//       item, an empty left_title or right_title
//   Mutation (pure -- see header: return the NEXT right_keys, caller re-renders)
//     prism_xf_move_right(all_items, right_keys, selected_keys) -> Result<list>
//       adds each selected key to right_keys (skipping a disabled one); rejects an unknown
//       selected key or one already in right_keys (i.e. not currently in the left panel)
//     prism_xf_move_left(all_items, right_keys, selected_keys) -> Result<list>
//       removes each selected key from right_keys (skipping a disabled one); rejects an unknown
//       selected key or one not currently in right_keys (i.e. not currently in the right panel)

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_ui_kit

// ── Item ──────────────────────────────────────────────────────────────────────────────────────
// Fields are `xf_`-prefixed -- NOVA's field-name -> slot index table is GLOBAL and
// last-registration-wins (the exact defect prism_interact.nova's PrismPickOption header and
// prism_ui_data.nova's list_/tree_/tl_ prefixes both document), so no bare field name here may
// risk colliding with another struct anywhere in the program.
type PrismTransferItem
    xf_key: string
    xf_label: string
    xf_disabled: bool

// Struct positional constructors are file-local cross-module (verified for exactly this shape by
// prism_interact.nova's own `prism_pick_option` header note), hence the ordinary wrapper.
fn prism_xf_item(key: string, label: string, disabled: bool) -> PrismTransferItem
    PrismTransferItem(key, label, disabled)

fn prism_xf_item_key(i: PrismTransferItem) -> string
    i.xf_key

fn prism_xf_item_label(i: PrismTransferItem) -> string
    i.xf_label

fn prism_xf_item_disabled(i: PrismTransferItem) -> bool
    i.xf_disabled

// ── Shared validation ────────────────────────────────────────────────────────────────────────
// Builds key -> item, guarding the element's type BEFORE the first field read (the same
// wild-pointer-read class prism_node_new's own `children` guard closes, applied here to
// `all_items`, which every public function below receives as a bare, runtime-checked `list`) and
// rejecting a duplicate key (see header). Shared by all three public functions below rather than
// re-derived three times, the same "seen dict, reject the second occurrence" idiom prism_pick and
// prism_tk_tag_input each already use for their own duplicate checks.
fn _prism_xf_index(all_items: list) -> Result<dict>
    let by_key = {}
    let mut idx = 0
    for it in all_items
        if type_name(it) != "PrismTransferItem"
            return err("prism_xf: item " + str(idx) + " is not a PrismTransferItem (got " + type_name(it) + ")")
        if it.xf_key in by_key
            return err("prism_xf: duplicate item key '" + it.xf_key + "'")
        by_key[it.xf_key] = it
        idx += 1
    ok(by_key)

// Validates every entry of `keys` names a real item (against an already-built `by_key` index),
// returning the set (dict key -> true) for O(1) membership tests by the caller. `what` names the
// caller's own parameter in the error text (e.g. "right_keys") so one shared helper still reports
// which argument was bad, rather than a generic message that leaves the caller to guess.
fn _prism_xf_key_set(keys: list, by_key: dict, what: string) -> Result<dict>
    let set = {}
    for k in keys
        if k not in by_key
            return err("prism_xf: " + what + " contains unknown key '" + k + "'")
        set[k] = true
    ok(set)

// ── Render ────────────────────────────────────────────────────────────────────────────────────

// See header: a disabled item stays visible with an honest textual marker rather than a widget
// attr this layer has nowhere to validate.
fn _prism_xf_item_node(it: PrismTransferItem) -> Result<PrismNode>
    if it.xf_disabled
        return prism_content.prism_label(it.xf_label + " (disabled)")
    prism_content.prism_label(it.xf_label)

fn _prism_xf_panel(title: string, items: list) -> Result<PrismNode>
    let t = prism_content.prism_label(title)?
    let mk = fn(it) _prism_xf_item_node(it)
    let rows = prism_ui_kit.prism_ui_collect(items, mk)?
    let children = [t]
    for r in rows
        children.push(r)
    prism_arrange.prism_stack(children)

// The button column: ">>" moves the current left-panel selection right, "<<" moves the current
// right-panel selection left. Each button's ACCESSIBLE name is a full sentence (PRISM_SPEC.md §13
// -- the same rule prism_interact.prism_press and prism_ui_token.prism_tk_tag_closable's
// close_label already enforce: a control named only by its glyph is invisible to a screen reader);
// the ">>"/"<<" glyph is the button's separate VISUAL content, the exact text/children split
// `prism_press`'s own signature makes.
fn _prism_xf_buttons() -> Result<PrismNode>
    let right_glyph = prism_content.prism_label(">>")?
    let right_btn = prism_interact.prism_press("Move selected to right panel", [right_glyph])?
    let left_glyph = prism_content.prism_label("<<")?
    let left_btn = prism_interact.prism_press("Move selected to left panel", [left_glyph])?
    prism_arrange.prism_stack([right_btn, left_btn])

// `all_items` is the FULL universe of transferable items, in the fixed order both panels render
// them; `right_keys` is the current right-panel membership set. Order within each panel is always
// `all_items`'s own source order (never selection order), so re-rendering after a move never
// reshuffles items the user did not touch.
fn prism_xf_transfer(all_items: list, right_keys: list, left_title: string, right_title: string) -> Result<PrismNode>
    if len(left_title) == 0
        return err("prism_xf_transfer: left_title must not be empty")
    if len(right_title) == 0
        return err("prism_xf_transfer: right_title must not be empty")
    let by_key = _prism_xf_index(all_items)?
    let right_set = _prism_xf_key_set(right_keys, by_key, "right_keys")?
    let left_items = []
    let right_items = []
    for it in all_items
        if it.xf_key in right_set
            right_items.push(it)
        else
            left_items.push(it)
    let left_panel = _prism_xf_panel(left_title, left_items)?
    let right_panel = _prism_xf_panel(right_title, right_items)?
    let buttons = _prism_xf_buttons()?
    prism_arrange.prism_band([left_panel, buttons, right_panel])

// ── Mutation (pure -- see header) ───────────────────────────────────────────────────────────────

// Validates BEFORE mutating: every selected key must name a real item, and must currently be on
// the LEFT (i.e. not already in right_set) -- "move right something already on the right" is a
// caller/UI bug, not a value this function should silently accept. A disabled item is a legal
// selection (it is genuinely sitting in the left panel) but never actually moves -- see header.
fn prism_xf_move_right(all_items: list, right_keys: list, selected_keys: list) -> Result<list>
    let by_key = _prism_xf_index(all_items)?
    let right_set = _prism_xf_key_set(right_keys, by_key, "right_keys")?
    for k in selected_keys
        if k not in by_key
            return err("prism_xf_move_right: selected key '" + k + "' names no item")
        if k in right_set
            return err("prism_xf_move_right: selected key '" + k + "' is already in the right panel, not the left")
    let next_right = []
    for k in right_keys
        next_right.push(k)
    for k in selected_keys
        if k not in right_set
            let it = by_key[k]
            if not it.xf_disabled
                next_right.push(k)
                right_set[k] = true
    ok(next_right)

// Mirror image of move_right: every selected key must name a real item and must currently be on
// the RIGHT (i.e. already in right_set). A disabled item is a legal selection but never actually
// leaves the right panel -- the "locked assignment" case (a mandatory role already granted).
fn prism_xf_move_left(all_items: list, right_keys: list, selected_keys: list) -> Result<list>
    let by_key = _prism_xf_index(all_items)?
    let right_set = _prism_xf_key_set(right_keys, by_key, "right_keys")?
    for k in selected_keys
        if k not in by_key
            return err("prism_xf_move_left: selected key '" + k + "' names no item")
        if k not in right_set
            return err("prism_xf_move_left: selected key '" + k + "' is not in the right panel, so it cannot be moved left")
    let drop = {}
    for k in selected_keys
        let it = by_key[k]
        if not it.xf_disabled
            drop[k] = true
    let next_right = []
    for k in right_keys
        if k not in drop
            next_right.push(k)
    ok(next_right)
