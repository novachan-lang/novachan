import prism_node
import prism_arrange
import prism_content
import prism_interact

// 1. Toolbar action button: press with text label
fn prism_tb_action(label: string) -> Result<PrismNode>
    if len(label) == 0
        return err("prism_tb_action: label must not be empty")
    let lbl = prism_content.prism_label(label)?
    prism_interact.prism_press(label, [lbl])

// 2. Toolbar separator: label("|")
fn prism_tb_separator() -> Result<PrismNode>
    prism_content.prism_label("|")

// 3. Toolbar: band of actions with gaps between them
fn prism_tb_toolbar(items: list, gap_px: int) -> Result<PrismNode>
    if len(items) == 0
        return err("prism_tb_toolbar: items must not be empty")
    if gap_px <= 0
        return err("prism_tb_toolbar: gap_px must be > 0")
    let children = []
    let mut idx = 0
    for item in items
        if type_name(item) != "PrismNode"
            return err("prism_tb_toolbar: item " + str(idx) + " is not a PrismNode (got " + type_name(item) + ")")
        if idx > 0
            let g = prism_arrange.prism_gap(some(gap_px))?
            children.push(g)
        children.push(item)
        idx += 1
    prism_arrange.prism_band(children)

// 4. Toolbar group: band of actions (no gap, visually grouped)
fn prism_tb_group(actions: list) -> Result<PrismNode>
    if len(actions) == 0
        return err("prism_tb_group: actions must not be empty")
    let mut idx = 0
    for a in actions
        if type_name(a) != "PrismNode"
            return err("prism_tb_group: action " + str(idx) + " is not a PrismNode (got " + type_name(a) + ")")
        idx += 1
    prism_arrange.prism_band(actions)

// 5. Action bar: band[left_group, flexible_gap, right_group]
fn prism_tb_action_bar(left: list, right: list) -> Result<PrismNode>
    if len(left) == 0 and len(right) == 0
        return err("prism_tb_action_bar: at least one side must have items")
    let mut idx = 0
    for l in left
        if type_name(l) != "PrismNode"
            return err("prism_tb_action_bar: left item " + str(idx) + " is not a PrismNode (got " + type_name(l) + ")")
        idx += 1
    idx = 0
    for r in right
        if type_name(r) != "PrismNode"
            return err("prism_tb_action_bar: right item " + str(idx) + " is not a PrismNode (got " + type_name(r) + ")")
        idx += 1
    let left_band = prism_arrange.prism_band(left)?
    let spacer = prism_arrange.prism_gap(none())?
    let right_band = prism_arrange.prism_band(right)?
    prism_arrange.prism_band([left_band, spacer, right_band])
