import prism_node
import prism_arrange
import prism_content
import prism_interact

// A single read-only chip: label node
fn prism_ch_chip(text: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_ch_chip: text must not be empty")
    prism_content.prism_label(text)

// A dismissible chip: band[label, close_button]
fn prism_ch_dismissible(text: string) -> Result<PrismNode>
    if len(text) == 0
        return err("prism_ch_dismissible: text must not be empty")
    let lbl = prism_content.prism_label(text)?
    let icon = prism_content.prism_glyph(prism_content.prism_icon_close())?
    let btn = prism_interact.prism_press("Remove " + text, [icon])?
    prism_arrange.prism_band([lbl, btn])

// A group of chips: flow layout (wrapping)
fn prism_ch_group(labels: list) -> Result<PrismNode>
    if len(labels) == 0
        return err("prism_ch_group: labels must not be empty")
    let children = []
    let mut idx = 0
    for lbl in labels
        if type_name(lbl) != "string"
            return err("prism_ch_group: element " + str(idx) + " is not a string (got " + type_name(lbl) + ")")
        if len(lbl) == 0
            return err("prism_ch_group: element " + str(idx) + " is empty")
        let chip = prism_ch_chip(lbl)?
        children.push(chip)
        idx += 1
    prism_arrange.prism_flow(children)

// Filter chips: flow of dismissible chips
fn prism_ch_filter_group(labels: list) -> Result<PrismNode>
    if len(labels) == 0
        return err("prism_ch_filter_group: labels must not be empty")
    let children = []
    let mut idx = 0
    for lbl in labels
        if type_name(lbl) != "string"
            return err("prism_ch_filter_group: element " + str(idx) + " is not a string (got " + type_name(lbl) + ")")
        if len(lbl) == 0
            return err("prism_ch_filter_group: element " + str(idx) + " is empty")
        let chip = prism_ch_dismissible(lbl)?
        children.push(chip)
        idx += 1
    prism_arrange.prism_flow(children)
