// forge_ops_changelog -- timestamped, tag-filterable operations change log: an audit trail of "who
// changed what, when, tagged how" (config edits, deploys, manual interventions) -- not a release
// artifact. Distinct from forge_changelog's Keep-a-Changelog CATEGORY sections and
// forge_changelog_gen's semver RELEASE-NOTES generator: neither supports a time-range query or
// free-form tag filtering, and both are release-oriented (versioned sections) rather than a running
// ops audit trail (arbitrary timestamped entries). LEAF -- imports NOTHING.

fn cl_new() -> dict
    {"entries": []}

// Append one entry. `tags` is a list of free-form strings (e.g. ["deploy", "db"]). Fluent.
fn cl_add(log: dict, timestamp: int, author: string, description: string, tags: list) -> dict
    let entry = {"ts": timestamp, "author": author, "description": description, "tags": tags}
    push(log["entries"], entry)
    log

// Entries carrying `tag`, in original insertion order.
fn cl_filter(log: dict, tag: string) -> list
    let entries = log["entries"]
    [e for e in entries if tag in e["tags"]]

// Entries with start_ts <= ts <= end_ts (inclusive), in original insertion order.
fn cl_between(log: dict, start_ts: int, end_ts: int) -> list
    let entries = log["entries"]
    [e for e in entries if e["ts"] >= start_ts and e["ts"] <= end_ts]

// One line per entry: "<ts> [<author>] <description> (<tag>,<tag>,...)" -- the tag suffix is
// omitted for entries with no tags.
fn cl_render(log: dict) -> string
    let nl = chr(10)
    let out_parts = []
    let entries = log["entries"]
    for i in 0..len(entries)
        let e = entries[i]
        let ts = str(e["ts"])
        let author = e["author"]
        let description = e["description"]
        push(out_parts, "{ts} [{author}] {description}")
        if len(e["tags"]) > 0
            push(out_parts, " (" + join(e["tags"], ",") + ")")
        push(out_parts, nl)
    let out = join(out_parts, "")
    out

fn cl_count(log: dict) -> int
    len(log["entries"])
