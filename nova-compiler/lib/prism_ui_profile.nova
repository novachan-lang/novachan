// prism_ui_profile -- user profile / identity card family (prism/ui/, milestone MB.58): a compact
// header (single-letter avatar placeholder + name + role), a row of labelled stat counters, a bio
// block, a full card composition, and a contact-details list. A COMPOSITION over the closed
// 22-primitive vocabulary (widget/), built through prism_ui_kit.nova wherever it fits -- no new
// PrismNodeKind (PRISM_SPEC.md axiom A7), the same discipline every prism_ui_*.nova file follows.
// This is the Ant Design `Card` + `Descriptions` + `Statistic` combination seen on every user
// profile page / account settings screen / team-member card.
//
// ── WHY THE HEADER'S AVATAR PLACEHOLDER IS ONE LETTER, COMPUTED LOCALLY -- NOT prism_ui_avatar OR
//    prism_ui_media.prism_ui_avatar (grepped before writing a line, per CLAUDE.md's "does this
//    already exist?" rule) ────────────────────────────────────────────────────────────────────
// Two richer avatar families already exist in this codebase: `prism_ui_avatar.prism_av_avatar`
// builds a full `PrismAvatar` value (name + image + up-to-2-char initials) with circle/card/group/
// presence renderers, and `prism_ui_media.prism_ui_avatar` builds one sized circle (image or
// up-to-2-char initials) behind a closed `PrismAvatarSize` enum. Neither is what `prism_pf_header`
// needs: the header's avatar is a purely decorative, minimal placeholder INLINE beside the
// name/role stack -- one uppercased letter, no image support, no size variants, no standalone
// card/group/presence shape of its own. Pulling in either richer family here would mean
// constructing (and validating) a whole `PrismAvatar` value or a size enum for something this
// component only ever reduces to a single character. The local `_prism_pf_initial` helper (first
// non-blank character, uppercased manually -- the identical ord()/chr() technique
// `prism_ui_avatar.nova`'s own header already justifies over the `upper()` builtin) is the honest,
// minimal fit; this file's only string-builtin dependency beyond the primitives is
// `trim`/`ord`/`chr`, each already proven elsewhere in this tree. A caller wanting a real
// image-backed or multi-letter avatar composes `prism_av_circle`/`prism_ui_avatar` alongside
// `prism_pf_bio`/`prism_pf_contact` instead -- this file does not attempt to replace either.
//
// ── WHY prism_pf_stats/prism_pf_contact TAKE PARALLEL LISTS, NOT A LIST<Struct> ──────────────────
// The public API is fixed by the caller-facing shape this milestone specifies: a stat row is a
// (label, count) pair and a contact row is a (field, value) pair, each most naturally supplied as
// two same-length lists (the shape a caller already has from two separate columns of data) rather
// than forcing construction of a throwaway struct per row. Both functions validate `len(a) ==
// len(b)` UP FRONT and reject a per-index non-string/empty element by name, mirroring
// `prism_ui_kv._prism_ui_kv_row`'s identical "validate the row shape before trusting it" discipline
// for its own 2-element list pairs -- so a caller mismatch is one clear typed error, never a
// silent truncation or an out-of-bounds read three functions later.
//
// ── WHY BOTH BUILD A `pairs: list<list>` THEN prism_ui_kit.prism_ui_collect OVER IT ────────────
// `prism_ui_collect` maps ONE list through a fallible constructor with error propagation (see that
// file's own header for why this saved hundreds of lines across the whole `ui/` layer) -- but it
// cannot zip two separate lists on its own. Zipping `labels`/`counts` (or `fields`/`values`) into
// one `pairs` list of `[a, b]` 2-element lists during the same pass that validates them is the
// smallest amount of manual iteration that makes `prism_ui_collect` applicable at all, rather than
// hand-writing the collect-with-error-propagation loop a second time for a two-list input.
//
// ── FIELD PREFIXES ────────────────────────────────────────────────────────────────────────────
// None needed -- like `prism_ui_stat.nova` (MB.17), every function here takes plain
// string/list arguments, so no struct is declared and the global field-name -> slot collision
// (CLAUDE.md, every earlier `ui/` file's header) never arises.
//
// PUBLIC API
//   prism_pf_header(name, role) -> Result<PrismNode>
//     band[avatar_initial_label, gap(8), stack[name_label, role_label]]; rejects a blank
//     (empty or all-whitespace) name or an empty role
//   prism_pf_stats(labels: list, counts: list) -> Result<PrismNode>
//     band of stat items (stack[count_label, name_label] each, in `labels`/`counts` source order,
//     built via prism_ui_kit.prism_ui_collect + a lambda); rejects an empty labels list, a length
//     mismatch, a non-string element (named by index and actual type), and an empty label/count
//   prism_pf_bio(name, bio) -> Result<PrismNode>
//     stack[name_label, bio_label]; rejects a blank name or an empty bio
//   prism_pf_card(name, role, bio, stat_labels, stat_counts) -> Result<PrismNode>
//     stack[header, gap(8), bio, gap(8), stats]; propagates every sub-component's own validation
//     unchanged (header's name/role checks, bio's name/bio checks, stats' list checks)
//   prism_pf_contact(fields: list, values: list) -> Result<PrismNode>
//     stack of band[field_label, value_label] rows, in source order; same validation discipline as
//     prism_pf_stats (empty list, length mismatch, non-string element, empty field/value)

import prism_arrange
import prism_content
import prism_ui_kit

// ── Avatar placeholder: one uppercased letter, computed locally (see header) ────────────────────
fn _prism_pf_upper_char(c: string) -> string
    let code = ord(c)
    if code >= 97 and code <= 122
        chr(code - 32)
    else
        c

// First non-blank character of `name`, uppercased. Callers validate `name` is non-blank before
// this runs (see `prism_pf_header`), so the empty-trimmed-name branch is defensive, not load-
// bearing -- it degrades to an empty label rather than an out-of-bounds index read.
fn _prism_pf_initial(name: string) -> string
    let trimmed = trim(name)
    if len(trimmed) == 0
        ""
    else
        _prism_pf_upper_char(trimmed[0])

// ── Header: avatar placeholder beside a name/role stack ──────────────────────────────────────────
fn prism_pf_header(name: string, role: string) -> Result<PrismNode>
    if len(trim(name)) == 0
        return err("prism_pf_header: name must not be empty (or all whitespace)")
    if len(role) == 0
        return err("prism_pf_header: role must not be empty")
    let avatar = prism_content.prism_label(_prism_pf_initial(name))?
    let gap = prism_arrange.prism_gap(some(8))?
    let name_node = prism_content.prism_label(name)?
    let role_node = prism_content.prism_label(role)?
    let info = prism_arrange.prism_stack([name_node, role_node])?
    prism_arrange.prism_band([avatar, gap, info])

// ── Stats: a band of (count, label) items built from two parallel lists ──────────────────────────
fn _prism_pf_stat_item(pair: list) -> Result<PrismNode>
    let count_node = prism_content.prism_label(pair[1])?
    let label_node = prism_content.prism_label(pair[0])?
    prism_arrange.prism_stack([count_node, label_node])

fn prism_pf_stats(labels: list, counts: list) -> Result<PrismNode>
    if len(labels) == 0
        return err("prism_pf_stats: labels must not be empty")
    if len(labels) != len(counts)
        return err("prism_pf_stats: labels and counts must be the same length (got " + str(len(labels)) + " and " + str(len(counts)) + ")")
    let pairs = []
    for idx, label in labels
        if not is_string(label)
            return err("prism_pf_stats: label " + str(idx) + " is not a string (got " + type_name(label) + ")")
        if len(label) == 0
            return err("prism_pf_stats: label " + str(idx) + " must not be empty")
        let count = counts[idx]
        if not is_string(count)
            return err("prism_pf_stats: count " + str(idx) + " is not a string (got " + type_name(count) + ")")
        if len(count) == 0
            return err("prism_pf_stats: count " + str(idx) + " must not be empty")
        pairs.push([label, count])
    let mk = fn(p) _prism_pf_stat_item(p)
    let items = prism_ui_kit.prism_ui_collect(pairs, mk)?
    prism_arrange.prism_band(items)

// ── Bio: name above a free-text bio line ─────────────────────────────────────────────────────────
fn prism_pf_bio(name: string, bio: string) -> Result<PrismNode>
    if len(trim(name)) == 0
        return err("prism_pf_bio: name must not be empty (or all whitespace)")
    if len(bio) == 0
        return err("prism_pf_bio: bio must not be empty")
    let name_node = prism_content.prism_label(name)?
    let bio_node = prism_content.prism_label(bio)?
    prism_arrange.prism_stack([name_node, bio_node])

// A small, constant breathing space between the card's three blocks -- same fixed-not-flexible
// reasoning `prism_ui_stat.nova`'s own `PRISM_ST_CARD_GAP` header note gives.
let PRISM_PF_CARD_GAP = 8

// ── Card: the full composition -- header, bio, stats ─────────────────────────────────────────────
fn prism_pf_card(name: string, role: string, bio: string, stat_labels: list, stat_counts: list) -> Result<PrismNode>
    let header = prism_pf_header(name, role)?
    let bio_block = prism_pf_bio(name, bio)?
    let stats = prism_pf_stats(stat_labels, stat_counts)?
    let g1 = prism_arrange.prism_gap(some(PRISM_PF_CARD_GAP))?
    let g2 = prism_arrange.prism_gap(some(PRISM_PF_CARD_GAP))?
    prism_arrange.prism_stack([header, g1, bio_block, g2, stats])

// ── Contact: a stack of (field, value) rows built from two parallel lists ────────────────────────
fn _prism_pf_contact_row(pair: list) -> Result<PrismNode>
    let field_node = prism_content.prism_label(pair[0])?
    let value_node = prism_content.prism_label(pair[1])?
    prism_arrange.prism_band([field_node, value_node])

fn prism_pf_contact(fields: list, values: list) -> Result<PrismNode>
    if len(fields) == 0
        return err("prism_pf_contact: fields must not be empty")
    if len(fields) != len(values)
        return err("prism_pf_contact: fields and values must be the same length (got " + str(len(fields)) + " and " + str(len(values)) + ")")
    let pairs = []
    for idx, field in fields
        if not is_string(field)
            return err("prism_pf_contact: field " + str(idx) + " is not a string (got " + type_name(field) + ")")
        if len(field) == 0
            return err("prism_pf_contact: field " + str(idx) + " must not be empty")
        let value = values[idx]
        if not is_string(value)
            return err("prism_pf_contact: value " + str(idx) + " is not a string (got " + type_name(value) + ")")
        if len(value) == 0
            return err("prism_pf_contact: value " + str(idx) + " must not be empty")
        pairs.push([field, value])
    let mk = fn(p) _prism_pf_contact_row(p)
    let rows = prism_ui_kit.prism_ui_collect(pairs, mk)?
    prism_arrange.prism_stack(rows)
