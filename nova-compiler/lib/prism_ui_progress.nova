import prism_node
import prism_arrange
import prism_content

// Progress bar: band[filled_label, empty_label] showing "==="/"---" proportional
fn prism_pg_bar(current: int, total: int, width: int) -> Result<PrismNode>
    if total <= 0
        return err("prism_pg_bar: total must be > 0")
    if current < 0
        return err("prism_pg_bar: current must be >= 0")
    if width <= 0
        return err("prism_pg_bar: width must be > 0")
    let mut clamped = current
    if clamped > total
        clamped = total
    let filled_count = (clamped * width) / total
    let empty_count = width - filled_count
    let mut filled_str = ""
    let mut i = 0
    while i < filled_count
        filled_str = filled_str + "="
        i += 1
    let mut empty_str = ""
    i = 0
    while i < empty_count
        empty_str = empty_str + "-"
        i += 1
    let filled = prism_content.prism_label(filled_str)?
    let empty = prism_content.prism_label(empty_str)?
    prism_arrange.prism_band([filled, empty])

// Percentage label: "42%"
fn prism_pg_percent(current: int, total: int) -> Result<PrismNode>
    if total <= 0
        return err("prism_pg_percent: total must be > 0")
    if current < 0
        return err("prism_pg_percent: current must be >= 0")
    let mut clamped = current
    if clamped > total
        clamped = total
    let pct = (clamped * 100) / total
    prism_content.prism_label(str(pct) + "%")

// Progress with label: stack[label, bar, percent]
fn prism_pg_labeled(label: string, current: int, total: int, width: int) -> Result<PrismNode>
    if len(label) == 0
        return err("prism_pg_labeled: label must not be empty")
    let lbl = prism_content.prism_label(label)?
    let bar = prism_pg_bar(current, total, width)?
    let pct = prism_pg_percent(current, total)?
    prism_arrange.prism_stack([lbl, bar, pct])

// Multi-step progress: band of step labels, current one marked with [*]
fn prism_pg_steps(steps: list, current_step: int) -> Result<PrismNode>
    if len(steps) == 0
        return err("prism_pg_steps: steps must not be empty")
    if current_step < 0 or current_step >= len(steps)
        return err("prism_pg_steps: current_step " + str(current_step) + " out of bounds (0.." + str(len(steps) - 1) + ")")
    let children = []
    let mut idx = 0
    for s in steps
        if type_name(s) != "string"
            return err("prism_pg_steps: step " + str(idx) + " is not a string (got " + type_name(s) + ")")
        let prefix = "  "
        if idx == current_step
            prefix = "> "
        let lbl = prism_content.prism_label(prefix + s)?
        children.push(lbl)
        idx += 1
    prism_arrange.prism_band(children)
