import prism_node
import prism_arrange
import prism_content
import prism_interact

// Simple empty state: stack[icon, message]
fn prism_em_empty(message: string) -> Result<PrismNode>
    if len(message) == 0
        return err("prism_em_empty: message must not be empty")
    let icon = prism_content.prism_glyph(prism_content.prism_icon_info())?
    let msg = prism_content.prism_label(message)?
    prism_arrange.prism_stack([icon, msg])

// Empty state with a call-to-action button
fn prism_em_action(message: string, action_label: string) -> Result<PrismNode>
    if len(message) == 0
        return err("prism_em_action: message must not be empty")
    if len(action_label) == 0
        return err("prism_em_action: action_label must not be empty")
    let icon = prism_content.prism_glyph(prism_content.prism_icon_info())?
    let msg = prism_content.prism_label(message)?
    let btn_label = prism_content.prism_label(action_label)?
    let btn = prism_interact.prism_press(action_label, [btn_label])?
    prism_arrange.prism_stack([icon, msg, btn])

// Error empty state: stack[warning_icon, title, detail]
fn prism_em_error(title: string, detail: string) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_em_error: title must not be empty")
    let icon = prism_content.prism_glyph(prism_content.prism_icon_warning())?
    let t = prism_content.prism_label(title)?
    let children = [icon, t]
    if len(detail) > 0
        let d = prism_content.prism_label(detail)?
        children.push(d)
    prism_arrange.prism_stack(children)

// Custom empty state: stack[icon_node, ...content_nodes]
fn prism_em_custom(icon_node: PrismNode, content: list) -> Result<PrismNode>
    if len(content) == 0
        return err("prism_em_custom: content must not be empty")
    let mut idx = 0
    for c in content
        if type_name(c) != "PrismNode"
            return err("prism_em_custom: content[" + str(idx) + "] is not a PrismNode (got " + type_name(c) + ")")
        idx += 1
    let children = [icon_node]
    for c in content
        children.push(c)
    prism_arrange.prism_stack(children)
