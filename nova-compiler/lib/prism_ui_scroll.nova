import prism_node
import prism_arrange
import prism_content
import prism_interact

// 1. Scrollable container: stack[items..., load_more_button_or_end_label]
fn prism_sc_scroll(items: list, has_more: bool) -> Result<PrismNode>
    if len(items) == 0
        return err("prism_sc_scroll: items must not be empty")
    let mut idx = 0
    for item in items
        if type_name(item) != "PrismNode"
            return err("prism_sc_scroll: item " + str(idx) + " is not a PrismNode (got " + type_name(item) + ")")
        idx += 1
    let children = []
    for item in items
        children.push(item)
    if has_more
        let btn_lbl = prism_content.prism_label("Load more")?
        let btn = prism_interact.prism_press("Load more items", [btn_lbl])?
        children.push(btn)
    else
        let end = prism_content.prism_label("-- End --")?
        children.push(end)
    prism_arrange.prism_stack(children)

// 2. Virtual list: shows a window of items from offset to offset+count
//    Returns stack of visible items + info label showing "Showing X-Y of Z"
fn prism_sc_virtual(all_items: list, offset: int, visible_count: int) -> Result<PrismNode>
    if len(all_items) == 0
        return err("prism_sc_virtual: all_items must not be empty")
    if offset < 0
        return err("prism_sc_virtual: offset must be >= 0")
    if visible_count <= 0
        return err("prism_sc_virtual: visible_count must be > 0")
    if offset >= len(all_items)
        return err("prism_sc_virtual: offset " + str(offset) + " >= total " + str(len(all_items)))
    let mut end = offset + visible_count
    if end > len(all_items)
        end = len(all_items)
    let children = []
    let mut i = offset
    while i < end
        let item = all_items[i]
        if type_name(item) != "PrismNode"
            return err("prism_sc_virtual: item " + str(i) + " is not a PrismNode (got " + type_name(item) + ")")
        children.push(item)
        i += 1
    let info = prism_content.prism_label("Showing " + str(offset + 1) + "-" + str(end) + " of " + str(len(all_items)))?
    children.push(info)
    prism_arrange.prism_stack(children)

// 3. Scroll to top button: press button with "Top" label
fn prism_sc_top_button() -> Result<PrismNode>
    let lbl = prism_content.prism_label("Top")?
    prism_interact.prism_press("Scroll to top", [lbl])

// 4. Paginated scroll: stack[items, nav_band[prev_btn, page_info, next_btn]]
fn prism_sc_paginated(items: list, page: int, total_pages: int) -> Result<PrismNode>
    if len(items) == 0
        return err("prism_sc_paginated: items must not be empty")
    if page < 1
        return err("prism_sc_paginated: page must be >= 1")
    if total_pages < 1
        return err("prism_sc_paginated: total_pages must be >= 1")
    if page > total_pages
        return err("prism_sc_paginated: page " + str(page) + " > total_pages " + str(total_pages))
    let mut idx = 0
    for item in items
        if type_name(item) != "PrismNode"
            return err("prism_sc_paginated: item " + str(idx) + " is not a PrismNode (got " + type_name(item) + ")")
        idx += 1
    let prev_lbl = prism_content.prism_label("< Prev")?
    let prev = prism_interact.prism_press("Previous page", [prev_lbl])?
    let info = prism_content.prism_label("Page " + str(page) + " of " + str(total_pages))?
    let next_lbl = prism_content.prism_label("Next >")?
    let next_btn = prism_interact.prism_press("Next page", [next_lbl])?
    let nav = prism_arrange.prism_band([prev, info, next_btn])?
    let children = []
    for item in items
        children.push(item)
    children.push(nav)
    prism_arrange.prism_stack(children)
