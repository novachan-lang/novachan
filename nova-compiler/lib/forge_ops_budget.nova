// forge_ops_budget -- hard-capped resource budget: ob_consume REJECTS (Result err) any request that
// would push usage over `limit`, rather than allowing overdraw and only reporting it after the
// fact. Distinct from forge_cost_allocator's ca_ API, which tracks unlimited running cost totals
// per service/owner with no cap and no rejection path -- this is the "will this deployment/job fit
// in what's left" admission gate. LEAF -- imports NOTHING.

fn ob_new(name: string, limit: int) -> dict
    let b = {}
    b["name"] = name
    b["limit"] = limit
    b["used"] = 0
    b

// Consume `amount` from the budget. Rejects (err) a negative amount or one that would exceed the
// limit -- the budget is left UNCHANGED on rejection. Returns ok(budget) on success.
fn ob_consume(b: dict, amount: int) -> Result
    if amount < 0
        return err("amount must be non-negative")
    if b["used"] + amount > b["limit"]
        let left = b["limit"] - b["used"]
        return err("budget exceeded: " + b["name"] + " has " + str(left) + " remaining, requested " + str(amount))
    b["used"] = b["used"] + amount
    ok(b)

fn ob_remaining(b: dict) -> int
    b["limit"] - b["used"]

// Usage as a float percentage of the limit (0.0 if the limit itself is 0, to avoid a divide by zero).
fn ob_usage_pct(b: dict) -> float
    if b["limit"] == 0
        return 0.0
    float(b["used"]) * 100.0 / float(b["limit"])

fn ob_reset(b: dict) -> dict
    b["used"] = 0
    b
