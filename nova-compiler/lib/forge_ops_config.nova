// forge_ops_config -- config loader that actually touches a file path: reads a JSON file off disk
// (missing file -> empty base, not an error), then lets any process env var whose NAME matches an
// existing key override it (env wins). Companion oc_require/oc_validate check REQUIRED-key presence
// and a flat TYPE SCHEMA.
//
// None of the existing config modules load from a path: forge_config's config_ API works purely on
// in-memory dicts the caller already built; forge_config_validator's cv_ API validates a field-LIST
// schema (with per-field defaults) against an in-memory dict; forge_config_merger's cm_ API merges
// three in-memory tiers (defaults/env/overrides) the caller assembled by hand. This module is the
// "point me at ops-config.json" entrypoint that feeds any of them. LEAF -- imports NOTHING but the
// file/json/env builtins.

// Load config from a JSON file at `path`. Missing file -> {} (not an error -- callers combine this
// with oc_require to make specific keys mandatory). Any key present after the JSON load is then
// overridden by an environment variable of the same name, if that env var is set and non-empty.
fn oc_load(path: string) -> dict
    let cfg = {}
    if file_exists(path)
        let raw = read_file(path)
        let parsed = json_decode(raw)
        for k in keys(parsed)
            cfg[k] = parsed[k]
    for k in keys(cfg)
        let v = env(k)
        if len(v) > 0
            cfg[k] = v
    cfg

// Read `key`, or `default` if absent.
fn oc_get(config: dict, key: string, default: any) -> any
    if contains(config, key)
        return config[key]
    default

// Fail if any of `required_keys` is missing from `config`.
fn oc_require(config: dict, required_keys: list) -> Result
    let missing = []
    let i = 0
    while i < len(required_keys)
        let k = required_keys[i]
        if contains(config, k) != true
            push(missing, k)
        i = i + 1
    if len(missing) > 0
        return err("missing required config keys: " + join(missing, ", "))
    ok(config)

// Validate `config` against a flat type schema {key: "int"|"string"|"bool"|...} (as reported by
// type_of). A schema key absent from config, or present with the wrong type_of, is an error; keys
// in config but not in the schema are ignored (the schema only constrains what it names).
fn oc_validate(config: dict, schema: dict) -> Result
    let errors = []
    for k in keys(schema)
        if contains(config, k)
            let expected = schema[k]
            let actual = type_of(config[k])
            if actual != expected
                push(errors, k + ": expected " + expected + ", got " + actual)
        else
            push(errors, k + ": missing")
    if len(errors) > 0
        return err(join(errors, "; "))
    ok(config)
