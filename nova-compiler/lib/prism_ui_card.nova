// prism_ui_card -- Card/panel container component family, the `ui/` composition layer (built on
// the widget/ arrangement + content + interaction primitives, never on markup -- PRISM_SPEC.md
// axiom A3). Five constructors: a basic title+body card, a header/body/footer card, an image
// card (with or without a description), a clickable card, and a card group with separators.
//
// ── CORRECTION (found while wiring this file, verified against prism/widget/prism_content.nova
//    directly, not guessed): `prism_content.prism_art` takes ONE parameter, `source: string` --
//    there is no `alt` parameter on it anywhere in the live module, and every existing caller in
//    this codebase (prism_ui_avatar, prism_ui_carousel, prism_ui_media's figure, prism_ui_upload,
//    every KAT that touches `prism_art`) passes exactly one argument. `prism_cd_image` below still
//    takes and validates `image_alt` (a real accessibility requirement -- an image with no
//    alternative text is a screen-reader dead end), but attaches it onto the built art node with
//    the SAME `dict_merge` + `prism_node_new` re-construction prism_ui_media.nova's
//    `_prism_md_with_attrs` already established for exactly this "attach caller metadata without
//    inventing a new PrismNodeKind" need (reused here rather than re-derived -- CLAUDE.md's "does
//    this already exist?" rule) instead of a second constructor argument that does not exist.
//
// PUBLIC API
//   prism_cd_card(title, content: list)                          -> Result<PrismNode>
//   prism_cd_full(header: PrismNode, content: list, footer: PrismNode) -> Result<PrismNode>
//   prism_cd_image(image_src, image_alt, title, description)     -> Result<PrismNode>
//   prism_cd_clickable(title, description)                       -> Result<PrismNode>
//   prism_cd_group(cards: list, gap_px: int)                     -> Result<PrismNode>

import prism_node
import prism_arrange
import prism_content
import prism_interact

// Attaches extra attrs onto an already-built node without inventing a new PrismNodeKind. Same
// dict_merge + prism_node_new re-construction prism_ui_media.nova's `_prism_md_with_attrs`
// already established (reused, not reinvented).
fn _prism_cd_with_attrs(n: PrismNode, extra: dict) -> Result<PrismNode>
    let merged = dict_merge(n.attrs, extra)
    prism_node.prism_node_new(n.kind, merged, n.children, n.key)

// 1. Basic card: stack[title_label, gap, body_content]
fn prism_cd_card(title: string, content: list) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_cd_card: title must not be empty")
    if len(content) == 0
        return err("prism_cd_card: content must not be empty")
    let mut idx = 0
    for c in content
        if type_name(c) != "PrismNode"
            return err("prism_cd_card: child " + str(idx) + " is not a PrismNode (got " + type_name(c) + ")")
        idx += 1
    let t = prism_content.prism_label(title)?
    let gap = prism_arrange.prism_gap(some(8))?
    let body = prism_arrange.prism_stack(content)?
    prism_arrange.prism_stack([t, gap, body])

// 2. Card with header and footer: stack[header, gap, body, gap, footer]
fn prism_cd_full(header: PrismNode, content: list, footer: PrismNode) -> Result<PrismNode>
    if len(content) == 0
        return err("prism_cd_full: content must not be empty")
    let mut idx = 0
    for c in content
        if type_name(c) != "PrismNode"
            return err("prism_cd_full: child " + str(idx) + " is not a PrismNode (got " + type_name(c) + ")")
        idx += 1
    let body = prism_arrange.prism_stack(content)?
    let g1 = prism_arrange.prism_gap(some(8))?
    let g2 = prism_arrange.prism_gap(some(8))?
    prism_arrange.prism_stack([header, g1, body, g2, footer])

// 3. Image card: stack[art, title, description]
fn prism_cd_image(image_src: string, image_alt: string, title: string, description: string) -> Result<PrismNode>
    if len(image_src) == 0
        return err("prism_cd_image: image_src must not be empty")
    if len(image_alt) == 0
        return err("prism_cd_image: image_alt must not be empty")
    if len(title) == 0
        return err("prism_cd_image: title must not be empty")
    let raw_art = prism_content.prism_art(image_src)?
    let img = _prism_cd_with_attrs(raw_art, {"alt": image_alt})?
    let t = prism_content.prism_label(title)?
    if len(description) == 0
        return prism_arrange.prism_stack([img, t])
    let d = prism_content.prism_label(description)?
    prism_arrange.prism_stack([img, t, d])

// 4. Clickable card: press wrapping a card's content
fn prism_cd_clickable(title: string, description: string) -> Result<PrismNode>
    if len(title) == 0
        return err("prism_cd_clickable: title must not be empty")
    if len(description) == 0
        return err("prism_cd_clickable: description must not be empty")
    let t = prism_content.prism_label(title)?
    let d = prism_content.prism_label(description)?
    let body = prism_arrange.prism_stack([t, d])?
    prism_interact.prism_press(title, [body])

// 5. Card group: stack of cards with gaps
fn prism_cd_group(cards: list, gap_px: int) -> Result<PrismNode>
    if len(cards) == 0
        return err("prism_cd_group: cards must not be empty")
    if gap_px <= 0
        return err("prism_cd_group: gap_px must be > 0")
    let children = []
    let mut idx = 0
    for card in cards
        if type_name(card) != "PrismNode"
            return err("prism_cd_group: card " + str(idx) + " is not a PrismNode (got " + type_name(card) + ")")
        if idx > 0
            let g = prism_arrange.prism_gap(some(gap_px))?
            children.push(g)
        children.push(card)
        idx += 1
    prism_arrange.prism_stack(children)
