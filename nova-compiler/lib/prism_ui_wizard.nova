// prism_ui_wizard -- multi-step wizard / form components (prism/ui/, milestone MB.26): a
// horizontal step-progress header, a single wizard page (title above content), the back/next
// navigation bar, and the fully-assembled wizard. Every one is a COMPOSITION over the closed
// 22-primitive vocabulary (widget/), built through prism_arrange/prism_content/prism_interact
// plus prism_ui_kit.nova's `prism_ui_icon_text` helper wherever it fits -- no new PrismNodeKind,
// the same "this is a composition, not a new primitive" discipline every prism_ui_*.nova file in
// this tree follows (PRISM_SPEC.md axiom A7). No struct is introduced anywhere in this file, so
// the field-slot-collision prefixing question (reference_field_slot_collision_scales_with_imports)
// never arises here -- every function takes only primitives, `PrismNode`, and a bare `list`.
//
// ── THIS IS NOT A DUPLICATE OF `prism_nav_steps` OR `prism_tl_step_timeline` -- A THIRD, DISTINCT
//    SHAPE FOR THE SAME "WHERE AM I IN AN ORDERED SEQUENCE" QUESTION ────────────────────────────
// Grepped before writing a line of this file (CLAUDE.md's "does this already exist" discipline):
// TWO existing components already answer "index vs. current index" with an icon-driven step
// indicator, and this file deliberately does neither of their things:
//   `prism_ui_nav.prism_nav_steps(labels, current_idx)` -- horizontal `band`, but ONLY completed
//     steps get an icon (`glyph(check)+label`); current and pending are BOTH a plain `label`,
//     told apart only by a queryable `step_state` attr (that file's own header: "a control whose
//     action is 'go nowhere' is not a real affordance" -- extended there to "current" as well as
//     "pending", since neither is clickable at this layer).
//   `prism_ui_timeline.prism_tl_step_timeline(steps, current_index)` -- vertical `stack`, and
//     EVERY step gets an icon: done=check, active=chevron_right, pending=minus (that file's own
//     header on why `minus` stands in for "nothing to report yet").
// `prism_wz_step_header` below is a THIRD combination, not a rename of either: horizontal `band`
// (like `prism_nav_steps`, because a wizard header reads left-to-right across the top of a page,
// not top-to-bottom down a status feed), but CURRENT gets its own icon distinct from pending (like
// `prism_tl_step_timeline`'s three-way split) while FUTURE/pending gets NO icon at all -- neither
// existing precedent does exactly this. The reasoning for the no-icon-on-future choice: a future
// step has not been visited and has no status to report yet (not even "pending", which is itself
// a status); rendering it as bare `label(name)` is the most honest thing this vocabulary can do,
// and keeps the ONE icon-bearing state (`current`) visually unambiguous as "you are here" without
// a `minus`/pending icon competing for the same attention on every step you haven't reached. Three
// components computing the identical `idx < current` / `== current` / `> current` split and
// rendering three different shapes from it is not duplication -- Ant Design itself ships `Steps`
// (this shape), `Timeline` (`prism_tl_step_timeline`'s shape) and breadcrumb-style progress
// (`prism_nav_steps`'s shape) as three separate components for exactly this reason: the same fact
// serves a header, a status feed, and a page trail differently.
//
// ── WHY `prism_wz_nav` NEEDS NO SPECIAL CASE FOR "LAST STEP" EVEN THOUGH THE BRIEF NAMES ONE ─────
// The brief describes three positions -- step 0 (next only), the last step (back + finish, using
// the next label), and everything between (back + next) -- as if "last step" were a third render
// shape. It is not. `wz_next_label` is whatever text the CALLER chose to pass for this position;
// this function never hard-codes the word "Finish" anywhere, so a caller wanting a finish button
// simply passes `wz_next_label = "Finish"` when composing the last page. The ONLY structural fact
// this function computes is "is there a step behind me to go back to", i.e. `wz_current > 0` --
// true for every non-first step, last one included. So the real render rule collapses to TWO
// shapes, not three: `wz_current == 0` -> `band[next]`; every other in-range position, including
// the last, -> `band[back, next]`, letting "last step" fall out of the general rule rather than
// needing to be recognized as a distinct case up front (the identical "no special case at the
// boundary" shape `prism_ui_pager.prism_pg_pager`'s own header already establishes for its window
// edges). The KAT proves the last-step shape is BYTE-IDENTICAL in structure to a middle step's.
//
// ── WHY BOTH `wz_back_label` AND `wz_next_label` ARE VALIDATED UNCONDITIONALLY, EVEN AT STEP 0 ───
// `wz_back_label` is never rendered when `wz_current == 0` (there is nothing to go back to), so
// the cheapest implementation would validate it only inside the `wz_current > 0` branch. Rejected
// for the same reason `prism_ui_notice.prism_nt_list` validates its `nt_empty_text` unconditionally
// (see that file's own header): a caller who always passes the same broken (empty) back-label
// string for step 0's call site would never see the error until a LATER page in the same wizard
// flow happened to need it -- a deferred failure surfacing at the worst possible time, exactly what
// the "no deferred decisions on critical path items" quality standard forbids. Validating both
// labels up front, unconditionally, on every call regardless of position, means a caller finds a
// typo'd label on the very first page of the wizard, not three screens later. Proven directly: the
// KAT calls `prism_wz_nav(0, N, "", "Next")` (step 0, where back never renders) and asserts it is
// STILL rejected.
//
// ── WHY `prism_wz_wizard`'S SHAPE IS `stack[header, content, nav]`, NOT
//    `stack[header, prism_wz_page(...), nav]` ──────────────────────────────────────────────────
// `prism_wz_wizard` takes a bare `content: PrismNode`, not a `wz_title` + inner content pair --
// there is no title parameter to hand `prism_wz_page` even if this function wanted to call it.
// "Step header + page + nav combined" (the informal description of what this function does) uses
// "page" to mean "whatever is currently on screen for this step", not a literal invocation of
// `prism_wz_page`; a caller who wants a titled page simply builds one with `prism_wz_page` FIRST
// and passes the result in as `content` -- proven directly in the KAT, which does exactly that and
// asserts the composed depth/count come out consistent with `prism_wz_page`'s own documented shape.
// Forcing every wizard screen through a mandatory title would also be a real regression: not every
// step of a real wizard wants a repeated on-page heading duplicating what the step header already
// says (Stripe Checkout's multi-step flow, for one, titles only some steps).
//
// PUBLIC API (all Result<PrismNode>; every one validates, none fails silently)
//   prism_wz_step_header(wz_steps: list, wz_current: int) -> Result<PrismNode>
//     band of one node per step. wz_steps: list<string> (bare list, runtime-checked).
//     index < wz_current  -> prism_ui_icon_text(check, name)     -- band[glyph(check), label(name)]
//     index == wz_current -> prism_ui_icon_text(chevron_right, name) -- band[glyph(chevron), label]
//     index > wz_current  -> label(name) alone (see header: no status to report yet)
//     rejects: an empty wz_steps, a non-string element (named by index and actual type), and
//     wz_current < 0 or >= len(wz_steps)
//   prism_wz_page(wz_title: string, content: PrismNode) -> Result<PrismNode>
//     stack[label(wz_title), content]. rejects an empty wz_title.
//   prism_wz_nav(wz_current: int, wz_total: int, wz_back_label: string, wz_next_label: string)
//     -> Result<PrismNode>
//     wz_current == 0 -> band[press(wz_next_label)]
//     otherwise (incl. the last step, see header) -> band[press(wz_back_label), press(wz_next_label)]
//     rejects: wz_total < 1, wz_current < 0 or >= wz_total, an empty wz_back_label or
//     wz_next_label (both validated unconditionally -- see header)
//   prism_wz_wizard(wz_steps: list, wz_current: int, content: PrismNode, wz_back_label: string,
//     wz_next_label: string) -> Result<PrismNode>
//     stack[prism_wz_step_header(wz_steps, wz_current), content, prism_wz_nav(wz_current,
//     len(wz_steps), wz_back_label, wz_next_label)]. rejects the full union of both sub-calls'
//     rejections: everything `prism_wz_step_header` rejects, plus an empty wz_back_label/
//     wz_next_label (`prism_wz_nav`'s own wz_total < 1 clause can never actually fire here, since
//     `wz_total` is always `len(wz_steps)` and `prism_wz_step_header` has already required that to
//     be non-empty -- documented rather than silently relied upon)

import prism_arrange
import prism_content
import prism_interact
import prism_ui_kit

// ── 1. Step-progress header ──────────────────────────────────────────────────────────────────
// One item per step. See header for why this is a THIRD shape, distinct from both
// `prism_nav_steps` and `prism_tl_step_timeline`.
fn _prism_wz_step_item(name: string, idx: int, current: int) -> Result<PrismNode>
    if idx < current
        return prism_ui_kit.prism_ui_icon_text(prism_content.prism_icon_check(), name)
    if idx == current
        return prism_ui_kit.prism_ui_icon_text(prism_content.prism_icon_chevron_right(), name)
    prism_content.prism_label(name)

// `wz_steps`: bare `list` of strings (not `list<string>` -- same caution prism_tl_step_timeline
// applies to its own bare-`list`-of-strings `steps` parameter and prism_nt_list applies to
// `list<PrismNode>`), so every element is guarded with an `is_string` check before it is ever
// handed to `prism_content.prism_label`. Checked in the order a caller would want to read them:
// the list's own shape (non-empty, every element a string) before `wz_current` is checked against
// its length -- a badly-typed list makes that bound comparison meaningless anyway.
fn prism_wz_step_header(wz_steps: list, wz_current: int) -> Result<PrismNode>
    if len(wz_steps) == 0
        return err("prism_wz_step_header: wz_steps must not be empty")
    for idx, s in wz_steps
        if not is_string(s)
            return err("prism_wz_step_header: wz_steps[" + str(idx) + "] must be a string (got " + type_name(s) + ")")
    if wz_current < 0 or wz_current >= len(wz_steps)
        return err("prism_wz_step_header: wz_current (" + str(wz_current) + ") is out of bounds for " + str(len(wz_steps)) + " step(s)")
    let items = []
    for idx, name in wz_steps
        let item = _prism_wz_step_item(name, idx, wz_current)?
        items.push(item)
    prism_arrange.prism_band(items)

// ── 2. Single wizard page ────────────────────────────────────────────────────────────────────
// Title above content -- stacked rather than inline for the same reason `prism_ui_kit.prism_ui_labeled`
// stacks a label above its control (that file's own header: stacking is the layout that degrades
// gracefully at every width, and Prism has no media queries to rescue an inline layout that breaks
// down at narrow widths). `content` is an arbitrary already-built `PrismNode`, so a caller composes
// whatever this step actually needs (a form, a summary, a review table) before handing it in.
fn prism_wz_page(wz_title: string, content: PrismNode) -> Result<PrismNode>
    if len(wz_title) == 0
        return err("prism_wz_page: wz_title must not be empty")
    let title_node = prism_content.prism_label(wz_title)?
    prism_arrange.prism_stack([title_node, content])

// ── 3. Navigation buttons ────────────────────────────────────────────────────────────────────
// See header for why "last step" needs no third shape, and why both labels are validated
// unconditionally. Both buttons are `press` (an activatable control, PRISM_SPEC.md §9), not
// `link` -- a wizard step transition is in-flow application state, not a navigable destination
// with its own URL, the same distinction `prism_ui_pager.prism_pg_load_more`'s own `press` button
// draws for its "load more" affordance.
fn prism_wz_nav(wz_current: int, wz_total: int, wz_back_label: string, wz_next_label: string) -> Result<PrismNode>
    if wz_total < 1
        return err("prism_wz_nav: wz_total must be >= 1, got " + str(wz_total))
    if wz_current < 0 or wz_current >= wz_total
        return err("prism_wz_nav: wz_current (" + str(wz_current) + ") is out of bounds for " + str(wz_total) + " step(s)")
    if len(wz_back_label) == 0
        return err("prism_wz_nav: wz_back_label must not be empty -- validated unconditionally, even at step 0 where no back button renders (see header)")
    if len(wz_next_label) == 0
        return err("prism_wz_nav: wz_next_label must not be empty")
    let next_node = prism_interact.prism_press(wz_next_label, [])?
    if wz_current == 0
        return prism_arrange.prism_band([next_node])
    let back_node = prism_interact.prism_press(wz_back_label, [])?
    prism_arrange.prism_band([back_node, next_node])

// ── 4. The full wizard ───────────────────────────────────────────────────────────────────────
// See header for why this is `stack[header, content, nav]` and not
// `stack[header, prism_wz_page(...), nav]`. Rejects the full union of what `prism_wz_step_header`
// and `prism_wz_nav` each reject on their own (see header on why `prism_wz_nav`'s own
// `wz_total < 1` clause can never actually fire through this call path).
fn prism_wz_wizard(wz_steps: list, wz_current: int, content: PrismNode, wz_back_label: string, wz_next_label: string) -> Result<PrismNode>
    let header = prism_wz_step_header(wz_steps, wz_current)?
    let nav = prism_wz_nav(wz_current, len(wz_steps), wz_back_label, wz_next_label)?
    prism_arrange.prism_stack([header, content, nav])
