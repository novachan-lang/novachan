// NOVA Standard Library: io
// Provides file I/O and console I/O functions.

fn input()
    return read_line()

fn slurp(path)
    return read_file(path)

fn spit(path, content)
    return write_file(path, content)

fn println(msg)
    print(msg)
    return 0

fn prompt(msg)
    print(msg)
    return read_line()

fn file_exists(path)
    content = read_file(path)
    return len(content) > 0
