// NOVA Standard Library: list
// Provides list manipulation functions.

fn length(lst)
    return len(lst)

fn reverse(lst)
    return lst.reverse()

fn sort(lst)
    return lst.sort()

fn map(lst, f)
    return lst.map(f)

fn filter(lst, f)
    return lst.filter(f)

fn sum(lst)
    total = 0
    i = 0
    while i < len(lst)
        total = total + lst[i]
        i = i + 1
    return total

fn product(lst)
    result = 1
    i = 0
    while i < len(lst)
        result = result * lst[i]
        i = i + 1
    return result

fn contains(lst, val)
    i = 0
    while i < len(lst)
        if lst[i] == val
            return 1
        i = i + 1
    return 0

fn index_of(lst, val)
    i = 0
    while i < len(lst)
        if lst[i] == val
            return i
        i = i + 1
    return 0 - 1

fn min_val(lst)
    result = lst[0]
    i = 1
    while i < len(lst)
        if lst[i] < result
            result = lst[i]
        i = i + 1
    return result

fn max_val(lst)
    result = lst[0]
    i = 1
    while i < len(lst)
        if lst[i] > result
            result = lst[i]
        i = i + 1
    return result

fn take(lst, n)
    result = []
    i = 0
    while i < n and i < len(lst)
        result.append(lst[i])
        i = i + 1
    return result

fn drop(lst, n)
    result = []
    i = n
    while i < len(lst)
        result.append(lst[i])
        i = i + 1
    return result

fn range(start, end)
    result = []
    i = start
    while i < end
        result.append(i)
        i = i + 1
    return result
