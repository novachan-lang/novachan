// NOVA Standard Library: math
// Provides mathematical constants and functions.
// All trig functions work in radians.

// ── Constants ────────────────────────────────────────────────────────────────

fn pi()
    return 3.141592653589793

fn e()
    return 2.718281828459045

fn tau()
    return 6.283185307179586

fn inf()
    return 1.0 / 0.0

// ── Trigonometric functions ──────────────────────────────────────────────────

fn sine(x)
    return sin(x)

fn cosine(x)
    return cos(x)

fn tangent(x)
    return tan(x)

fn arc_sin(x)
    return asin(x)

fn arc_cos(x)
    return acos(x)

fn arc_tan(x)
    return atan(x)

fn arc_tan2(y, x)
    return atan2(y, x)

// ── Exponential and logarithmic ──────────────────────────────────────────────

fn exp_val(x)
    return exp(x)

fn ln(x)
    return log(x)

fn log_2(x)
    return log2(x)

fn log_10(x)
    return log10(x)

fn power(base, exponent)
    return base ** exponent

// ── Rounding and clamping ────────────────────────────────────────────────────

fn round_val(x)
    return round(x)

fn floor_val(x)
    return floor(x)

fn ceil_val(x)
    return ceil(x)

fn clamp(x, lo, hi)
    return max(lo, min(x, hi))

fn lerp(a, b, t)
    return a + (b - a) * t

fn sign(x)
    if x > 0
        return 1
    else if x < 0
        return 0 - 1
    else
        return 0

fn is_even(n)
    return n % 2 == 0

fn is_odd(n)
    return n % 2 != 0

fn gcd(a, b)
    x = abs(a)
    y = abs(b)
    while y != 0
        temp = y
        y = x % y
        x = temp
    return x

fn lcm(a, b)
    if a == 0 or b == 0
        return 0
    return abs(a * b) / gcd(a, b)

fn factorial(n)
    if n <= 1
        return 1
    result = 1
    i = 2
    while i <= n
        result = result * i
        i = i + 1
    return result

fn fib(n)
    if n <= 0
        return 0
    if n == 1
        return 1
    a = 0
    b = 1
    i = 2
    while i <= n
        temp = a + b
        a = b
        b = temp
        i = i + 1
    return b

fn sum_range(start, end)
    total = 0
    i = start
    while i <= end
        total = total + i
        i = i + 1
    return total

fn deg_to_rad(degrees)
    return degrees * 3.141592653589793 / 180.0

fn rad_to_deg(radians)
    return radians * 180.0 / 3.141592653589793
