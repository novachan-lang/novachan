// NOVA Standard Library: string
// Provides string manipulation functions.

fn length(s)
    return len(s)

fn upper(s)
    return s.upper()

fn lower(s)
    return s.lower()

fn trim(s)
    return s.trim()

fn contains(s, sub)
    return s.contains(sub)

fn starts_with(s, prefix)
    return s.starts_with(prefix)

fn ends_with(s, suffix)
    return s.ends_with(suffix)

fn find(s, sub)
    return s.find(sub)

fn replace(s, old, new_val)
    return s.replace(old, new_val)

fn split(s, delim)
    return s.split(delim)

fn join(parts, sep)
    return parts.join(sep)

fn slice(s, start, end)
    return s.slice(start, end)

fn chars(s)
    return s.chars()

fn repeat(s, n)
    result = ""
    i = 0
    while i < n
        result = result + s
        i = i + 1
    return result

fn reverse(s)
    ch = s.chars()
    result = ""
    i = len(s) - 1
    while i >= 0
        result = result + ch[i]
        i = i - 1
    return result

fn is_empty(s)
    return len(s) == 0

fn pad_left(s, width, ch)
    result = s
    while len(result) < width
        result = ch + result
    return result

fn pad_right(s, width, ch)
    result = s
    while len(result) < width
        result = result + ch
    return result
