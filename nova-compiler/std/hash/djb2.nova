// std/hash/djb2.nova — DJB2 string hashes (Dan Bernstein, comp.lang.c 1991).
// All three variants return a 32-bit unsigned integer (0..4294967295).
// The mask & 0xFFFFFFFF is applied after EVERY multiply/add/xor step to
// prevent 64-bit values from drifting out of the 32-bit unsigned range.
//
// NOVA GOTCHAS embedded:
//   • >> is ARITHMETIC in NOVA. Values kept <= 0xFFFFFFFF so the top 32
//     bits are zero and right-shift is effectively logical here — but we
//     never right-shift in djb2, so this is moot.
//   • Integer multiply can exceed 32 bits; mask after every h*33 step.
//   • char_at(s, i) + ord() reads a single byte 0..255.
//   • '/' on two ints is INTEGER division.
//   • dict keys are STRINGS; not used here but noted for callers.
//
// Provided functions:
//   h_djb2(s)              -> int   DJB2 classic  (hash*33 + byte, init 5381)
//   h_djb2a(s)             -> int   DJB2a XOR     (hash*33 ^ byte, init 5381)
//   h_djb2_seeded(s, seed) -> int   DJB2 with custom initial seed
//
// KAT vectors (hand-computed and verified, mask = 0xFFFFFFFF = 4294967295):
//
//   h_djb2("") = 5381
//     (empty string — init value returned unchanged)
//
//   h_djb2("a") = 177670
//     step: h=5381; c=97('a'); h=(5381*33+97)&mask = (177573+97)&mask = 177670
//
//   h_djb2("ab") = 5863208
//     step1: h=5381; c=97('a'); h=(5381*33+97)&mask=177670
//     step2: h=177670; c=98('b'); h=(177670*33+98)&mask=(5863110+98)&mask=5863208
//
//   h_djb2("hello") = 261238937
//   h_djb2a("") = 5381
//   h_djb2a("a") = 177604
//     step: h=5381; c=97; h=(5381*33^97)&mask=(177573^97)&mask=177604
//   h_djb2a("hello") = 178056679

// ---------------------------------------------------------------------------
// DJB2 classic (addition variant)
// Algorithm: h = 5381; for each byte c: h = ((h * 33) + c) & 0xFFFFFFFF
// ---------------------------------------------------------------------------
fn h_djb2(s) -> int
    let h = 5381
    let n = len(s)
    let i = 0
    while i < n
        let c = ord(char_at(s, i))
        h = (h * 33 + c) & 0xFFFFFFFF
        i = i + 1
    h

// ---------------------------------------------------------------------------
// DJB2a (XOR variant)
// Same as DJB2 but uses XOR instead of addition. Slightly better avalanche.
// Algorithm: h = 5381; for each byte c: h = ((h * 33) ^ c) & 0xFFFFFFFF
// ---------------------------------------------------------------------------
fn h_djb2a(s) -> int
    let h = 5381
    let n = len(s)
    let i = 0
    while i < n
        let c = ord(char_at(s, i))
        h = (h * 33 ^ c) & 0xFFFFFFFF
        i = i + 1
    h

// ---------------------------------------------------------------------------
// DJB2 seeded — caller supplies the initial hash value instead of 5381.
// Useful for salted hashing, domain separation, or hash-table sharding.
// Algorithm: h = seed; for each byte c: h = ((h * 33) + c) & 0xFFFFFFFF
// Passing seed=5381 produces the same result as h_djb2(s).
// ---------------------------------------------------------------------------
fn h_djb2_seeded(s, seed) -> int
    let h = seed & 0xFFFFFFFF
    let n = len(s)
    let i = 0
    while i < n
        let c = ord(char_at(s, i))
        h = (h * 33 + c) & 0xFFFFFFFF
        i = i + 1
    h
