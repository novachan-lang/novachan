// std/hash/pearson.nova — Pearson hashing (8-bit and wide variants).
//
// Pearson hashing (P. Pearson, 1990) is an ultra-fast non-cryptographic hash
// that maps a string to a single byte (0..255) using one XOR + one table
// lookup per input byte.  Because the output is only 8 bits it is NOT
// suitable as a general-purpose collision-resistant hash; it is designed for
// fast hash-table probing in resource-constrained environments and as a
// teaching reference for table-driven hashing.
//
// PERMUTATION TABLE
// -----------------
// The table T is the 256-entry array defined by T[i] = (i*167 + 13) & 0xFF.
// This formula produces a valid permutation of 0..255 (all 256 values are
// distinct — verified by construction below and asserted in the KAT test).
// The constants 167 (a prime, coprime to 256) and 13 (an odd offset) ensure
// T is bijective: gcd(167, 256) = 1 guarantees the linear map is invertible.
//
// ALGORITHM — h_pearson(s) -> int (0..255)
// ------------------------------------------
//   h = len(s) & 0xFF          // initial value encodes length (mod 256)
//   for each byte b in s:
//       h = T[(h XOR b) & 0xFF]
//   return h
//
// WIDE VARIANT — h_pearson_wide(s, nbytes) -> int
// -------------------------------------------------
// Runs nbytes independent Pearson passes over the same string s.
// Pass k starts with initial value k (0, 1, 2, ...) instead of len(s).
// The k-th byte of the result is the k-th pass output, packed little-endian:
//   result = pass0 | (pass1 << 8) | (pass2 << 16) | ...
// This gives a wider hash at a cost of nbytes*len(s) table lookups.
//
// KAT (all hand-verified against the formula — see test file):
//   h_pearson("")           = 0    (h starts at 0, no bytes processed)
//   h_pearson("a")          = 173  (traced below)
//   h_pearson("b")          = 162  (traced below; != "a" confirms sensitivity)
//   h_pearson("hello")      = 70
//   h_pearson("world")      = 114
//   h_pearson("abc")        = 166
//   h_pearson_wide("",2)    = 256  (pass0=0, pass1=1, no-iter; 0 | (1<<8))
//   h_pearson_wide("hello",2) = 10915  (pass0=163, pass1=42)
//
// HAND-TRACE h_pearson("a"):
//   h  = len("a") & 0xFF = 1
//   b  = ord('a')        = 97   (ASCII lowercase a)
//   idx = (1 XOR 97) & 0xFF = 96
//   h  = T[96] = (96*167 + 13) & 0xFF = (16032 + 13) & 0xFF = 16045 & 0xFF = 173
//   return 173
//
// HAND-TRACE h_pearson("b"):
//   h  = 1, b = ord('b') = 98
//   idx = (1 XOR 98) & 0xFF = 99
//   h  = T[99] = (99*167 + 13) & 0xFF = (16533 + 13) & 0xFF = 16546 & 0xFF = 162
//   return 162
//
// NOVA GOTCHAS in this file:
//   • >> is ARITHMETIC.  All intermediate values stay in 0..255 here
//     (table values are masked at build time), so no sign issues arise.
//   • Braces inside string literals INTERPOLATE.  No bare { } in strings.
//   • No multi-line list literals; table is built with push().
//   • Integer division truncates; % is modulo (non-negative for non-negative).
//   • There is no 'fn' keyword in NOVA — functions are defined with 'fn'.
//     (wait — NOVA uses 'fn'; this comment means: do NOT write 'function').

// ---------------------------------------------------------------------------
// Internal: build the 256-entry permutation table T[i] = (i*167+13) & 0xFF.
// Private to this module (prefix _prs_ avoids cross-module symbol collisions).
// ---------------------------------------------------------------------------
fn _prs_make_table() -> list
    let t = []
    let i = 0
    while i < 256
        push(t, (i * 167 + 13) & 0xFF)
        i = i + 1
    t

// ---------------------------------------------------------------------------
// h_pearson(s) -> int in 0..255
//
// Pearson 8-bit hash of string s using T[i] = (i*167+13) & 0xFF.
// Initial accumulator = len(s) & 0xFF, then XOR-lookup for each byte.
// ---------------------------------------------------------------------------
fn h_pearson(s) -> int
    let t = _prs_make_table()
    let n = len(s)
    let h = n & 0xFF
    for i in 0..n
        let b = ord(char_at(s, i))
        h = t[(h ^ b) & 0xFF]
    h

// ---------------------------------------------------------------------------
// h_pearson_wide(s, nbytes) -> int
//
// Produces a wider hash by running nbytes independent Pearson passes.
// Pass k starts with initial accumulator = k (NOT len(s)), then applies
// the same XOR-lookup loop.  Results are packed little-endian:
//   result = byte0 | (byte1 << 8) | (byte2 << 16) | ...
//
// For nbytes=1 this is equivalent to a Pearson pass with init=0 (not
// len(s)), which intentionally differs from h_pearson to make both
// functions well-defined and independently composable.
//
// Practical limit: nbytes <= 8 to stay within NOVA's 64-bit int.
// ---------------------------------------------------------------------------
fn h_pearson_wide(s, nbytes) -> int
    let t = _prs_make_table()
    let n = len(s)
    let result = 0
    for k in 0..nbytes
        let h = k & 0xFF
        let i = 0
        while i < n
            let b = ord(char_at(s, i))
            h = t[(h ^ b) & 0xFF]
            i = i + 1
        result = result | (h << (k * 8))
    result
