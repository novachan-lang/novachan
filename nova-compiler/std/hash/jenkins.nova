// std/hash/jenkins.nova — Jenkins one-at-a-time hash (32-bit).
//
// Reference: Bob Jenkins, "A hash function for hash table lookup"
//   https://www.burtleburtle.net/bob/hash/doobs.html
//
// Algorithm (per-byte loop, then final mix):
//   for each byte b:
//     hash = (hash + b)          & 0xFFFFFFFF
//     hash = (hash + (hash<<10)) & 0xFFFFFFFF
//     hash = hash ^ (hash>>6)
//   final mix:
//     hash = (hash + (hash<<3))  & 0xFFFFFFFF
//     hash = hash ^ (hash>>11)
//     hash = (hash + (hash<<15)) & 0xFFFFFFFF
//
// NOVA GOTCHAS embedded here:
//   • >> is ARITHMETIC in NOVA. For values already masked to 32 bits (top 32 bits zero),
//     right-shift is effectively logical — but we re-mask results after XOR for safety.
//   • Left-shift + add can exceed 32 bits → mask every intermediate with & 0xFFFFFFFF.
//   • The mask constant is written as 4294967295 (= 0xFFFFFFFF) because NOVA hex literal
//     0xFFFFFFFF evaluates correctly as a positive i64 on the NOVA runtime.
//
// KAT vectors (hand-traced and verified):
//   h_jenkins("")      = 0             (empty input — hash stays 0 through all final-mix steps)
//   h_jenkins("a")     = 3392050242    (0xCA2E9442 — see trace below)
//   h_jenkins("hello") = 3372029979    (0xC8FD181B — step-traced in test file)
//
// Trace for "a" (byte = 97):
//   h=0  step1: (0+97)&mask        = 97
//        step2: (97+(97<<10))&mask  = (97+99328)&mask = 99425
//        step3: 99425^(99425>>6)   = 99425^1553       = 98928
//   final-mix:
//        step4: (98928+(98928<<3))&mask  = (98928+791424)&mask = 890352
//        step5: 890352^(890352>>11)      = 890352^434          = 889922
//        step6: (889922+(889922<<15))&mask
//               889922<<15 = 29172572160  (before mask)
//               (889922+29172572160) & 4294967295
//               = 29173462082 & 4294967295
//               = 3392050242                                (0xCA2E9442)
//
// Provided functions:
//   h_jenkins(s) -> int    Jenkins one-at-a-time hash of string s (32-bit unsigned result)

let _JK_MASK = 4294967295

// Jenkins one-at-a-time hash of string s.
// Returns a 32-bit unsigned integer in the range [0, 4294967295].
fn h_jenkins(s: str) -> int
    let h = 0
    let n = len(s)
    let i = 0
    while i < n
        let b = ord(char_at(s, i))
        h = (h + b) & _JK_MASK
        h = (h + (h << 10)) & _JK_MASK
        h = h ^ ((h >> 6) & _JK_MASK)
        i = i + 1
    // final avalanche mix
    h = (h + (h << 3)) & _JK_MASK
    h = h ^ ((h >> 11) & _JK_MASK)
    h = (h + (h << 15)) & _JK_MASK
    h
