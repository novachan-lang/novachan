// std/hash/hashcombine.nova
// Hash-combining utilities: boost-style combine, FNV-style combine,
// range fold, and splitmix64 finalizer.
// All arithmetic is 64-bit wrapping (NOVA i64 wraps mod 2^64).

// Logical right shift for 64-bit values (>> is arithmetic in NOVA).
fn _shr64(x, n)
    let mask = (1 << (64 - n)) - 1
    return (x >> n) & mask

// Boost-style hash combine: seed ^= v + 0x9E3779B9 + (seed<<6) + (seed>>2)
// Uses 64-bit wrapping arithmetic throughout.
fn h_combine_boost(seed, v)
    let magic = 0x9E3779B9
    let mixed = v + magic + (seed << 6) + _shr64(seed, 2)
    return seed ^ mixed

// FNV-style hash combine: (seed XOR v) * FNV-64-prime
// FNV-64 prime = 0x00000100000001B3
fn h_combine_fnv(seed, v)
    let fnv_prime = (0x00000100 << 32) | 0x000001B3
    return (seed ^ v) * fnv_prime

// Fold h_combine_boost over a list of ints, starting seed = 0.
fn h_hash_range_boost(lst)
    let seed = 0
    let n = len(lst)
    for i in 0..n
        seed = h_combine_boost(seed, lst[i])
    return seed

// splitmix64 finalizer (bijective 64-bit mix).
// Constants: 0x9E3779B97F4A7C15, 0xBF58476D1CE4E5B9, 0x94D049BB133111EB
fn h_mix64(x)
    let c_add = (0x9E3779B9 << 32) | 0x7F4A7C15
    let c1 = (0xBF58476D << 32) | 0x1CE4E5B9
    let c2 = (0x94D049BB << 32) | 0x133111EB
    let z = x + c_add
    z = (z ^ _shr64(z, 30)) * c1
    z = (z ^ _shr64(z, 27)) * c2
    return z ^ _shr64(z, 31)
