// std/hash/sdbm.nova — SDBM string hash (used in gawk, Berkeley DB, SDBM file format).
//
// Algorithm: hash = 0; for each byte b: hash = b + (hash << 6) + (hash << 16) - hash
// This is equivalent to hash = b + hash * 65599, but the shift form is the canonical
// description.  All intermediate and final values are masked to 32 bits unsigned.
//
// NOVA GOTCHAS applied in this file:
//   • >> is ARITHMETIC (sign-extending). Intermediate values are kept <= 32 bits (top
//     bits zero) by masking after every step, so arithmetic right-shift == logical.
//   • Integer arithmetic can overflow 64-bit signed range for very long inputs, but
//     masking after each byte keeps the running value in [0, 0xFFFFFFFF] so no overflow.
//   • Float/int compare is unsound — all comparisons here are int-only, no issue.
//   • dict keys must be strings; not used here.
//
// Public API:
//   h_sdbm(s)            -> int   SDBM hash, seed 0   (canonical)
//   h_sdbm_seeded(s, seed) -> int SDBM hash with custom seed
//
// KAT vectors (hand-verified):
//   h_sdbm("")       = 0
//   h_sdbm("a")      = 97
//   h_sdbm("ab")     = 6363201   (see trace below)
//   h_sdbm("hello")  = 684824882 (cross-checked against noncrypto.nova reference)
//
// Hand-trace of h_sdbm("ab"):
//   Init:   h = 0
//   byte 0: c = ord('a') = 97
//           h = (97 + (0 << 6) + (0 << 16) - 0) & 0xFFFFFFFF
//             = (97 + 0 + 0 - 0) & 0xFFFFFFFF
//             = 97
//   byte 1: c = ord('b') = 98
//           h = (98 + (97 << 6) + (97 << 16) - 97) & 0xFFFFFFFF
//             = (98 + 6208 + 6356992 - 97) & 0xFFFFFFFF
//             = 6363201 & 0xFFFFFFFF
//             = 6363201
//
// Seeded variant: h_sdbm_seeded(s, seed) uses seed as the initial hash value.
// This allows domain separation: two callers with different seeds cannot have the
// same output for the same input (unless the seed difference is cancelled by the
// input — which is unlikely in practice for non-adversarial inputs).
// Note: SDBM is NOT cryptographic. Do not use for security-sensitive applications.

// ---------------------------------------------------------------------------
// SDBM hash of string s with explicit initial value (private helper).
// Both public functions delegate here to avoid code duplication.
// Private to this module — _sdbm_ prefix prevents cross-module name collision.
// ---------------------------------------------------------------------------

fn _sdbm_core(s, init)
    let h = init & 0xFFFFFFFF
    let n = len(s)
    for i in 0..n
        let c = ord(char_at(s, i))
        // SDBM step: h = c + (h << 6) + (h << 16) - h
        // Mask after every step to stay in [0, 0xFFFFFFFF].
        // Since h is already <= 0xFFFFFFFF:
        //   h << 6  stays within 64-bit positive range
        //   h << 16 stays within 64-bit positive range
        //   subtraction can't go below -(0xFFFFFFFF) which is fine for i64
        //   final mask brings everything back into [0, 0xFFFFFFFF]
        h = (c + (h << 6) + (h << 16) - h) & 0xFFFFFFFF
    return h

// ---------------------------------------------------------------------------
// Public: canonical SDBM hash (seed = 0)
// ---------------------------------------------------------------------------

// h_sdbm(s) — compute the SDBM hash of string s.
// Returns an integer in [0, 4294967295] (32-bit unsigned).
// This is the original algorithm as used by gawk and the SDBM file format.
fn h_sdbm(s)
    return _sdbm_core(s, 0)

// ---------------------------------------------------------------------------
// Public: seeded SDBM hash
// ---------------------------------------------------------------------------

// h_sdbm_seeded(s, seed) — SDBM hash of s starting with initial value seed.
// Useful for domain separation or building hash chains.
// seed is masked to 32 bits on entry; the return value is in [0, 4294967295].
fn h_sdbm_seeded(s, seed)
    return _sdbm_core(s, seed)
