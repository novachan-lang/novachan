// std/hash/crc16.nova — CRC-16 checksum variants.
//
// Four industry-standard 16-bit CRCs, all operating on a NOVA bytes value:
//
//   Variant         Poly    Init    Reflect   Final XOR   Check ("123456789")
//   ───────────────────────────────────────────────────────────────────────────
//   CRC-16/CCITT-FALSE  0x1021  0xFFFF  no / no   0x0000      0x29B1 (10673)
//   CRC-16/XMODEM       0x1021  0x0000  no / no   0x0000      0x31C3 (12739)
//   CRC-16/MODBUS       0x8005  0xFFFF  yes/ yes  0x0000      0x4B37 (19255)
//   CRC-16/ARC          0x8005  0x0000  yes/ yes  0x0000      0xBB3D (47933)
//
// CCITT-FALSE and XMODEM are MSB-first (non-reflected): each input byte is
// XOR'd into the HIGH byte of the 16-bit CRC, then 8 bit-iterations test the
// MSB and conditionally XOR with the polynomial 0x1021.
//
// MODBUS and ARC are LSB-first (reflected): each input byte is XOR'd into the
// LOW byte of the 16-bit CRC, then 8 bit-iterations test the LSB and
// conditionally XOR with 0xA001 (the bit-reversed form of 0x8005).
//
// NOVA-specific hazards:
//   • '>>' is ARITHMETIC (sign-extending).  All 16-bit CRC values fit in
//     [0, 65535] so they are always non-negative — plain '>>' is safe here.
//   • Multi-line list literals do NOT compile.
//   • No '&&' / '||': use 'and' / 'or'.
//   • Unused local variables are a compile error.
//   • bytes_get(b, i) returns int 0..255; bytes_len(b) returns element count.
//
// Private helpers are prefixed '_crc16_' to avoid link collisions.

// ─── CCITT-FALSE / XMODEM (non-reflected, poly 0x1021) ───────────────────────

// _crc16_hi — core MSB-first CRC-16 engine.
// init: starting register value (0xFFFF for CCITT-FALSE, 0x0000 for XMODEM).
fn _crc16_hi(b: any, init: int) -> int
    let crc = init & 0xFFFF
    let n = bytes_len(b)
    let i = 0
    while i < n
        let byte = bytes_get(b, i)
        crc = crc ^ (byte << 8)
        crc = crc & 0xFFFF
        let j = 0
        while j < 8
            let msb = (crc >> 15) & 1
            crc = (crc << 1) & 0xFFFF
            if msb == 1
                crc = crc ^ 0x1021
            j = j + 1
        i = i + 1
    crc & 0xFFFF

// h_crc16_ccitt — CRC-16/CCITT-FALSE (poly 0x1021, init 0xFFFF, no reflection).
// Empty input returns 0xFFFF (65535).
fn h_crc16_ccitt(b: any) -> int
    return _crc16_hi(b, 0xFFFF)

// h_crc16_xmodem — CRC-16/XMODEM (poly 0x1021, init 0x0000, no reflection).
// Empty input returns 0x0000 (0).
fn h_crc16_xmodem(b: any) -> int
    return _crc16_hi(b, 0x0000)

// ─── MODBUS / ARC (reflected, poly 0xA001 = bit-reverse of 0x8005) ───────────

// _crc16_lo — core LSB-first CRC-16 engine.
// init: starting register value (0xFFFF for MODBUS, 0x0000 for ARC).
fn _crc16_lo(b: any, init: int) -> int
    let crc = init & 0xFFFF
    let n = bytes_len(b)
    let i = 0
    while i < n
        let byte = bytes_get(b, i)
        crc = crc ^ byte
        crc = crc & 0xFFFF
        let j = 0
        while j < 8
            let lsb = crc & 1
            crc = (crc >> 1) & 0x7FFF
            if lsb == 1
                crc = crc ^ 0xA001
            j = j + 1
        i = i + 1
    crc & 0xFFFF

// h_crc16_modbus — CRC-16/MODBUS (poly 0x8005 reflected, init 0xFFFF).
// Empty input returns 0xFFFF (65535).
fn h_crc16_modbus(b: any) -> int
    return _crc16_lo(b, 0xFFFF)

// h_crc16_arc — CRC-16/ARC (poly 0x8005 reflected, init 0x0000).
// Empty input returns 0x0000 (0).
fn h_crc16_arc(b: any) -> int
    return _crc16_lo(b, 0x0000)
