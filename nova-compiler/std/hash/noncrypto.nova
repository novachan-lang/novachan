// std/hash/noncrypto.nova — Non-cryptographic string hashes returning 32-bit unsigned ints.
// All results are masked with & 0xFFFFFFFF before return so callers see a consistent u32 range.
//
// NOVA GOTCHAS embedded in this file:
//   • >> is ARITHMETIC (sign-extending). For values we have already masked to 32 bits (top
//     32 bits are zero), right-shift is effectively logical — but we re-mask outputs anyway.
//   • Strings are NUL-terminated; ord(char_at(s,i)) reads a byte 0..255.
//   • No multi-line list literals; tables are built with push().
//   • Integer multiplication can produce > 32 bits — always mask result.
//
// Provided functions:
//   h_fnv1a32(s) -> int   FNV-1a 32-bit  (FNV offset basis = 2166136261)
//   h_djb2(s)    -> int   DJB2 (Bernstein, hash*33 + c, init 5381)
//   h_sdbm(s)    -> int   SDBM (hash*65599 + c, init 0, computed as c + h<<6 + h<<16 - h)
//   h_crc32(s)   -> int   CRC-32/ISO-HDLC (poly 0xEDB88320, init 0xFFFFFFFF, xorout 0xFFFFFFFF)
//
// KAT vectors (verified against authoritative reference implementations):
//   h_fnv1a32("")          = 2166136261
//   h_fnv1a32("a")         = 3826002220
//   h_fnv1a32("hello")     = 1335831723
//   h_djb2("")             = 5381
//   h_djb2("hello")        = 261238937
//   h_sdbm("")             = 0
//   h_sdbm("hello")        = 684824882
//   h_crc32("123456789")   = 3421780262   (CRC-32/ISO-HDLC standard check value)
//   h_crc32("")            = 0
//   h_crc32("hello")       = 907060870

// ---------------------------------------------------------------------------
// FNV-1a 32-bit
// ---------------------------------------------------------------------------

// FNV-1a 32-bit hash of string s.
// Algorithm: start with offset_basis; for each byte c: hash = (hash XOR c) * prime, mask to 32 bits.
fn h_fnv1a32(s: str) -> int
    let h = 2166136261
    let prime = 16777619
    let n = len(s)
    for i in 0..n
        let c = ord(char_at(s, i))
        h = ((h ^ c) * prime) & 0xFFFFFFFF
    h

// ---------------------------------------------------------------------------
// DJB2
// ---------------------------------------------------------------------------

// DJB2 hash by Dan Bernstein: init 5381, hash = hash * 33 + c.
// Equivalent (and usually written as): hash = (hash << 5) + hash + c
fn h_djb2(s: str) -> int
    let h = 5381
    let n = len(s)
    for i in 0..n
        let c = ord(char_at(s, i))
        h = (h * 33 + c) & 0xFFFFFFFF
    h

// ---------------------------------------------------------------------------
// SDBM
// ---------------------------------------------------------------------------

// SDBM hash: init 0, hash = c + hash*65599.
// Computed efficiently as: h = c + (h << 6) + (h << 16) - h
fn h_sdbm(s: str) -> int
    let h = 0
    let n = len(s)
    for i in 0..n
        let c = ord(char_at(s, i))
        h = (c + (h << 6) + (h << 16) - h) & 0xFFFFFFFF
    h

// ---------------------------------------------------------------------------
// CRC-32/ISO-HDLC  (also known as CRC-32b, used by zlib, gzip, Ethernet)
// Poly: 0x04C11DB7 (normal) = 0xEDB88320 (reflected/reversed)
// Parameters: init=0xFFFFFFFF, xorout=0xFFFFFFFF, refin=true, refout=true
// ---------------------------------------------------------------------------

// Build and return the 256-entry CRC-32 lookup table.
// Private — callers use h_crc32 which calls this once per invocation.
// Performance note: for hash-checking use cases (not hot loops) this is fine.
// If you need repeated CRC hashing of many strings, cache this list externally.
fn _crc32_table() -> list
    let tbl = []
    for i in 0..256
        let c = i
        let bit = 0
        while bit < 8
            if (c & 1) == 1
                // c = 0xEDB88320 XOR (c >> 1)
                // Since c is in 0..0xFFFFFFFF (positive 64-bit), >> 1 is effectively logical.
                c = 0xEDB88320 ^ ((c >> 1) & 0x7FFFFFFF)
            else
                c = (c >> 1) & 0x7FFFFFFF
            bit += 1
        push(tbl, c)
    tbl

// CRC-32/ISO-HDLC hash of string s.
// Returns a 32-bit unsigned integer (0..4294967295).
fn h_crc32(s: str) -> int
    let tbl = _crc32_table()
    let crc = 0xFFFFFFFF
    let n = len(s)
    for i in 0..n
        let byte_val = ord(char_at(s, i))
        let idx = (crc ^ byte_val) & 0xFF
        // crc is 32-bit (always masked), so >> 8 is safe (top 32 bits already zero)
        crc = (tbl[idx] ^ ((crc >> 8) & 0x00FFFFFF)) & 0xFFFFFFFF
    (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF
