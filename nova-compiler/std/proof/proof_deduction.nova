// std/proof/proof_deduction.nova — Meta-theorems / derived rules as checkable transformations.
// Formula representation (tagged lists):
//   ["var",name] ; ["not",f] ; ["and",a,b] ; ["or",a,b] ; ["imp",a,b] ; ["bot"] ; ["top"]
// All functions return formulas (lists) or the string "FAIL" on mismatch.
// LEAF — imports NOTHING.
// All public functions prefixed pded_.

// ── formula constructors ──────────────────────────────────────────────────────

// pded_var — build variable formula ["var", name].
fn pded_var(name) -> list
    let f = []
    push(f, "var")
    push(f, name)
    f

// pded_not — build negation formula ["not", a].
fn pded_not(a) -> list
    let f = []
    push(f, "not")
    push(f, a)
    f

// pded_and — build conjunction formula ["and", a, b].
fn pded_and(a, b) -> list
    let f = []
    push(f, "and")
    push(f, a)
    push(f, b)
    f

// pded_or — build disjunction formula ["or", a, b].
fn pded_or(a, b) -> list
    let f = []
    push(f, "or")
    push(f, a)
    push(f, b)
    f

// pded_imp — build implication formula ["imp", a, b].
fn pded_imp(a, b) -> list
    let f = []
    push(f, "imp")
    push(f, a)
    push(f, b)
    f

// pded_bot — build false formula ["bot"].
fn pded_bot() -> list
    let f = []
    push(f, "bot")
    f

// pded_top — build true formula ["top"].
fn pded_top() -> list
    let f = []
    push(f, "top")
    f

// ── formula equality ──────────────────────────────────────────────────────────

// _pded_feq — structural equality of two formulas; returns 1 if equal else 0.
fn _pded_feq(a, b) -> int
    if len(a) == 0
        if len(b) == 0
            return 1
        return 0
    if len(b) == 0
        return 0
    let ta = a[0]
    let tb = b[0]
    if ta != tb
        return 0
    if ta == "bot"
        return 1
    if ta == "top"
        return 1
    if ta == "var"
        if a[1] == b[1]
            return 1
        return 0
    if ta == "not"
        return _pded_feq(a[1], b[1])
    if ta == "imp"
        if _pded_feq(a[1], b[1]) == 1
            return _pded_feq(a[2], b[2])
        return 0
    if ta == "and"
        if _pded_feq(a[1], b[1]) == 1
            return _pded_feq(a[2], b[2])
        return 0
    if ta == "or"
        if _pded_feq(a[1], b[1]) == 1
            return _pded_feq(a[2], b[2])
        return 0
    0

// ── derived rules ─────────────────────────────────────────────────────────────

// pded_modus_ponens — given imp(A,B) and A, return B; else "FAIL".
fn pded_modus_ponens(fAB, fA) -> any
    if len(fAB) < 3
        return "FAIL"
    if fAB[0] != "imp"
        return "FAIL"
    let dom = fAB[1]
    let cod = fAB[2]
    if _pded_feq(dom, fA) == 0
        return "FAIL"
    cod

// pded_hyp_syllogism — given imp(A,B) and imp(B,C), return imp(A,C); else "FAIL".
fn pded_hyp_syllogism(fAB, fBC) -> any
    if len(fAB) < 3
        return "FAIL"
    if fAB[0] != "imp"
        return "FAIL"
    if len(fBC) < 3
        return "FAIL"
    if fBC[0] != "imp"
        return "FAIL"
    let A = fAB[1]
    let B = fAB[2]
    let B2 = fBC[1]
    let C = fBC[2]
    if _pded_feq(B, B2) == 0
        return "FAIL"
    pded_imp(A, C)

// pded_contrapositive — given imp(A,B), return imp(not B, not A); else "FAIL".
fn pded_contrapositive(fAB) -> any
    if len(fAB) < 3
        return "FAIL"
    if fAB[0] != "imp"
        return "FAIL"
    let A = fAB[1]
    let B = fAB[2]
    pded_imp(pded_not(B), pded_not(A))

// pded_double_neg_intro — given formula A, return imp(A, not(not(A))).
fn pded_double_neg_intro(fA) -> list
    pded_imp(fA, pded_not(pded_not(fA)))

// pded_deduction_forward — given assumption A and conclusion B, return imp(A,B).
fn pded_deduction_forward(fA, fB) -> list
    pded_imp(fA, fB)

// pded_currying — given imp(and(A,B),C), return imp(A,imp(B,C)); else "FAIL".
fn pded_currying(fAndC) -> any
    if len(fAndC) < 3
        return "FAIL"
    if fAndC[0] != "imp"
        return "FAIL"
    let ab = fAndC[1]
    let C = fAndC[2]
    if len(ab) < 3
        return "FAIL"
    if ab[0] != "and"
        return "FAIL"
    let A = ab[1]
    let B = ab[2]
    pded_imp(A, pded_imp(B, C))

// pded_uncurrying — given imp(A, imp(B,C)), return imp(and(A,B),C); else "FAIL".
fn pded_uncurrying(fABC) -> any
    if len(fABC) < 3
        return "FAIL"
    if fABC[0] != "imp"
        return "FAIL"
    let A = fABC[1]
    let inner = fABC[2]
    if len(inner) < 3
        return "FAIL"
    if inner[0] != "imp"
        return "FAIL"
    let B = inner[1]
    let C = inner[2]
    pded_imp(pded_and(A, B), C)

// pded_conj_intro — conjunction introduction: from A and B, return and(A,B).
fn pded_conj_intro(fA, fB) -> list
    pded_and(fA, fB)

// pded_conj_elim_l — conjunction left elimination: from and(A,B), return A; else "FAIL".
fn pded_conj_elim_l(fAB) -> any
    if len(fAB) < 3
        return "FAIL"
    if fAB[0] != "and"
        return "FAIL"
    fAB[1]

// pded_conj_elim_r — conjunction right elimination: from and(A,B), return B; else "FAIL".
fn pded_conj_elim_r(fAB) -> any
    if len(fAB) < 3
        return "FAIL"
    if fAB[0] != "and"
        return "FAIL"
    fAB[2]

// ── truth-table cross-check helpers ──────────────────────────────────────────

// _pded_collect_vars — collect unique variable names from a formula.
fn _pded_collect_vars(fml, seen, out)
    let tag = fml[0]
    if tag == "var"
        let nm = fml[1]
        if nm not in seen
            seen[nm] = 1
            push(out, nm)
        return
    if tag == "not"
        _pded_collect_vars(fml[1], seen, out)
        return
    if tag == "bot"
        return
    if tag == "top"
        return
    if tag == "and"
        _pded_collect_vars(fml[1], seen, out)
        _pded_collect_vars(fml[2], seen, out)
        return
    if tag == "or"
        _pded_collect_vars(fml[1], seen, out)
        _pded_collect_vars(fml[2], seen, out)
        return
    if tag == "imp"
        _pded_collect_vars(fml[1], seen, out)
        _pded_collect_vars(fml[2], seen, out)
        return

// _pded_eval — evaluate formula under env dict (name->0/1). Returns 0/1.
fn _pded_eval(fml, env) -> int
    let tag = fml[0]
    if tag == "top"
        return 1
    if tag == "bot"
        return 0
    if tag == "var"
        if fml[1] in env
            return env[fml[1]]
        return 0
    if tag == "not"
        if _pded_eval(fml[1], env) == 0
            return 1
        return 0
    if tag == "and"
        if _pded_eval(fml[1], env) == 1
            if _pded_eval(fml[2], env) == 1
                return 1
        return 0
    if tag == "or"
        if _pded_eval(fml[1], env) == 1
            return 1
        if _pded_eval(fml[2], env) == 1
            return 1
        return 0
    if tag == "imp"
        if _pded_eval(fml[1], env) == 1
            if _pded_eval(fml[2], env) == 0
                return 0
        return 1
    0

// pded_is_tautology — truth-table check; true iff formula holds on ALL assignments.
fn pded_is_tautology(fml) -> bool
    let seen = {}
    let vars = []
    _pded_collect_vars(fml, seen, vars)
    let nvars = len(vars)
    let total = 1
    for k in 0..nvars
        total = total * 2
    for i in 0..total
        let env = {}
        let b = 0
        while b < nvars
            env[vars[b]] = (i >> b) & 1
            b += 1
        if _pded_eval(fml, env) == 0
            return false
    true
