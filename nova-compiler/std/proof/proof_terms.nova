// std/proof/proof_terms.nova — Curry-Howard proof terms for intuitionistic implicational logic.
// A proof term is a tagged list:
//   ["pv", name]              — proof variable
//   ["plam", name, formula, body] — lambda abstraction (assume name:formula, prove body)
//   ["papp", f, a]            — application (modus ponens)
// A FORMULA (for types) is a tagged list:
//   ["var", name] ; ["imp", a, b]  (implicational fragment only here)
// A CONTEXT is a list of [name, formula] pairs (newest-first binding order).
// All public functions prefixed ppt_.
// LEAF — imports NOTHING.

// ── formula constructors ──────────────────────────────────────────────────────

// ppt_var — build a propositional variable formula ["var", name].
fn ppt_var(name) -> list
    let f = []
    push(f, "var")
    push(f, name)
    f

// ppt_imp — build implication formula ["imp", a, b].
fn ppt_imp(a, b) -> list
    let f = []
    push(f, "imp")
    push(f, a)
    push(f, b)
    f

// ppt_not — build negation as ["imp", a, ["bot"]] — A->bot.
fn ppt_not(a) -> list
    let bot = []
    push(bot, "bot")
    ppt_imp(a, bot)

// ppt_and — build conjunction ["and", a, b].
fn ppt_and(a, b) -> list
    let f = []
    push(f, "and")
    push(f, a)
    push(f, b)
    f

// ppt_or — build disjunction ["or", a, b].
fn ppt_or(a, b) -> list
    let f = []
    push(f, "or")
    push(f, a)
    push(f, b)
    f

// ── proof term constructors ───────────────────────────────────────────────────

// ppt_mk_pv — build proof variable term ["pv", name].
fn ppt_mk_pv(name) -> list
    let t = []
    push(t, "pv")
    push(t, name)
    t

// ppt_mk_plam — build lambda proof term ["plam", name, formula, body].
fn ppt_mk_plam(name, formula, body) -> list
    let t = []
    push(t, "plam")
    push(t, name)
    push(t, formula)
    push(t, body)
    t

// ppt_mk_papp — build application proof term ["papp", f, a].
fn ppt_mk_papp(f, a) -> list
    let t = []
    push(t, "papp")
    push(t, f)
    push(t, a)
    t

// ── formula equality ──────────────────────────────────────────────────────────

// _ppt_feq — structural equality of two formulas; returns 1 if equal, 0 otherwise.
fn _ppt_feq(a, b) -> int
    if len(a) == 0
        if len(b) == 0
            return 1
        return 0
    if len(b) == 0
        return 0
    let ta = a[0]
    let tb = b[0]
    if ta != tb
        return 0
    if ta == "bot"
        return 1
    if ta == "top"
        return 1
    if ta == "var"
        if a[1] == b[1]
            return 1
        return 0
    if ta == "not"
        return _ppt_feq(a[1], b[1])
    if ta == "imp"
        if _ppt_feq(a[1], b[1]) == 1
            return _ppt_feq(a[2], b[2])
        return 0
    if ta == "and"
        if _ppt_feq(a[1], b[1]) == 1
            return _ppt_feq(a[2], b[2])
        return 0
    if ta == "or"
        if _ppt_feq(a[1], b[1]) == 1
            return _ppt_feq(a[2], b[2])
        return 0
    0

// ── context lookup ────────────────────────────────────────────────────────────

// _ppt_ctx_lookup — look up name in context (newest-first), return formula or [] if absent.
fn _ppt_ctx_lookup(ctx, name) -> list
    let n = len(ctx)
    for i in 0..n
        let entry = ctx[i]
        if entry[0] == name
            return entry[1]
    let empty = []
    empty

// ── type inference ────────────────────────────────────────────────────────────

// ppt_infer — infer the formula a proof term proves in context ctx.
// Returns the formula (list) or the string "FAIL" if ill-typed.
fn ppt_infer(ctx, term) -> any
    let tag = term[0]
    if tag == "pv"
        let name = term[1]
        let fml = _ppt_ctx_lookup(ctx, name)
        if len(fml) == 0
            return "FAIL"
        return fml
    if tag == "plam"
        let vname = term[1]
        let atype = term[2]
        let body = term[3]
        let entry = []
        push(entry, vname)
        push(entry, atype)
        let newctx = []
        push(newctx, entry)
        for i in 0..len(ctx)
            push(newctx, ctx[i])
        let btype = ppt_infer(newctx, body)
        if btype == "FAIL"
            return "FAIL"
        return ppt_imp(atype, btype)
    if tag == "papp"
        let fn_term = term[1]
        let arg_term = term[2]
        let ft = ppt_infer(ctx, fn_term)
        if ft == "FAIL"
            return "FAIL"
        let at = ppt_infer(ctx, arg_term)
        if at == "FAIL"
            return "FAIL"
        if ft[0] != "imp"
            return "FAIL"
        let dom = ft[1]
        let cod = ft[2]
        if _ppt_feq(dom, at) == 0
            return "FAIL"
        return cod
    "FAIL"

// ppt_check — check that a proof term proves a specific formula in context ctx.
fn ppt_check(ctx, term, formula) -> bool
    let inferred = ppt_infer(ctx, term)
    if inferred == "FAIL"
        return false
    if _ppt_feq(inferred, formula) == 1
        return true
    false

// ── truth-table cross-check helpers ──────────────────────────────────────────

// _ppt_vars_collect — collect variable names from a formula into a list (no duplicates).
fn _ppt_vars_collect(fml, seen, out)
    let tag = fml[0]
    if tag == "var"
        let nm = fml[1]
        if nm not in seen
            seen[nm] = 1
            push(out, nm)
        return
    if tag == "imp"
        _ppt_vars_collect(fml[1], seen, out)
        _ppt_vars_collect(fml[2], seen, out)
        return
    if tag == "and"
        _ppt_vars_collect(fml[1], seen, out)
        _ppt_vars_collect(fml[2], seen, out)
        return
    if tag == "or"
        _ppt_vars_collect(fml[1], seen, out)
        _ppt_vars_collect(fml[2], seen, out)
        return
    if tag == "not"
        _ppt_vars_collect(fml[1], seen, out)
        return

// _ppt_eval — evaluate a formula under an assignment (dict name->0/1). Returns 0/1.
fn _ppt_eval(fml, env) -> int
    let tag = fml[0]
    if tag == "top"
        return 1
    if tag == "bot"
        return 0
    if tag == "var"
        if fml[1] in env
            return env[fml[1]]
        return 0
    if tag == "not"
        if _ppt_eval(fml[1], env) == 0
            return 1
        return 0
    if tag == "and"
        if _ppt_eval(fml[1], env) == 1
            if _ppt_eval(fml[2], env) == 1
                return 1
        return 0
    if tag == "or"
        if _ppt_eval(fml[1], env) == 1
            return 1
        if _ppt_eval(fml[2], env) == 1
            return 1
        return 0
    if tag == "imp"
        if _ppt_eval(fml[1], env) == 1
            if _ppt_eval(fml[2], env) == 0
                return 0
        return 1
    0

// ppt_is_tautology — check if a formula is a tautology (true under all assignments).
fn ppt_is_tautology(fml) -> bool
    let seen = {}
    let vars = []
    _ppt_vars_collect(fml, seen, vars)
    let nvars = len(vars)
    let total = 1
    for k in 0..nvars
        total = total * 2
    for i in 0..total
        let env = {}
        let b = 0
        while b < nvars
            env[vars[b]] = (i >> b) & 1
            b += 1
        if _ppt_eval(fml, env) == 0
            return false
    true
