// std/proof/proof_tableau.nova — Analytic (semantic) tableaux for propositional logic.
// LEAF — imports NOTHING.
//
// Formula tags: ["var",name], ["not",f], ["and",a,b], ["or",a,b], ["imp",a,b], ["bot"], ["top"].
// Signed formula: [sign, formula] where sign is "T" or "F".
// Alpha rules (expand single branch): T-and, F-or, F-imp, T-not, F-not, T-bot, F-top.
// Beta rules (split branch): F-and, T-or, T-imp.
// A branch CLOSES when it contains both ["T",f] and ["F",f] for some formula f.
//
// Public API:
//   ptab_is_valid(f)         -> bool  true iff f is a tautology
//   ptab_is_satisfiable(f)   -> bool  true iff f is satisfiable
//   ptab_is_contradiction(f) -> bool  true iff f is unsatisfiable

// _ptab_fmteq — syntactic equality of two formula trees.
fn _ptab_fmteq(a, b) -> bool
    if type_of(a) != type_of(b)
        return false
    if type_of(a) == "string"
        return a == b
    if type_of(a) == "int"
        return a == b
    if type_of(a) != "list"
        return false
    if len(a) != len(b)
        return false
    let n = len(a)
    let i = 0
    while i < n
        if not _ptab_fmteq(a[i], b[i])
            return false
        i = i + 1
    true

// _ptab_branch_contains — true iff signed formula sf is in the branch.
fn _ptab_branch_contains(branch, sf) -> bool
    let n = len(branch)
    let i = 0
    while i < n
        let s = branch[i]
        if s[0] == sf[0]
            if _ptab_fmteq(s[1], sf[1])
                return true
        i = i + 1
    false

// _ptab_branch_closed — true iff branch has both ["T",f] and ["F",f] for some f.
fn _ptab_branch_closed(branch) -> bool
    let n = len(branch)
    let i = 0
    while i < n
        let sf = branch[i]
        if sf[0] == "T"
            let f = sf[1]
            let j = 0
            while j < n
                if branch[j][0] == "F"
                    if _ptab_fmteq(branch[j][1], f)
                        return true
                j = j + 1
        i = i + 1
    false

// _ptab_copy_branch — shallow copy a branch.
fn _ptab_copy_branch(branch) -> list
    let out = []
    let n = len(branch)
    let i = 0
    while i < n
        push(out, branch[i])
        i = i + 1
    out

// _ptab_fmttag — tag string of a formula.
fn _ptab_fmttag(f) -> string
    if type_of(f) != "list"
        return "bad"
    if len(f) == 0
        return "bad"
    if type_of(f[0]) != "string"
        return "bad"
    f[0]

// _ptab_sub1 — sub-formula at index 1.
fn _ptab_sub1(f) -> any
    f[1]

// _ptab_sub2 — sub-formula at index 2.
fn _ptab_sub2(f) -> any
    f[2]

// _ptab_sf_kind — classify signed formula: 0=literal, 1=alpha, 2=beta, 3=trivially-close.
fn _ptab_sf_kind(sf) -> int
    let sign = sf[0]
    let tag = _ptab_fmttag(sf[1])
    if tag == "var"
        return 0
    if tag == "top"
        if sign == "F"
            return 3
        return 0
    if tag == "bot"
        if sign == "T"
            return 3
        return 0
    if sign == "T" and tag == "and"
        return 1
    if sign == "F" and tag == "or"
        return 1
    if sign == "F" and tag == "imp"
        return 1
    if sign == "T" and tag == "not"
        return 1
    if sign == "F" and tag == "not"
        return 1
    if sign == "F" and tag == "and"
        return 2
    if sign == "T" and tag == "or"
        return 2
    if sign == "T" and tag == "imp"
        return 2
    0

// _ptab_alpha_parts — return list of signed formulas to add for alpha expansion of sf.
fn _ptab_alpha_parts(sf) -> list
    let sign = sf[0]
    let f = sf[1]
    let tag = _ptab_fmttag(f)
    let r = []
    if sign == "T" and tag == "and"
        push(r, ["T", _ptab_sub1(f)])
        push(r, ["T", _ptab_sub2(f)])
        return r
    if sign == "F" and tag == "or"
        push(r, ["F", _ptab_sub1(f)])
        push(r, ["F", _ptab_sub2(f)])
        return r
    if sign == "F" and tag == "imp"
        push(r, ["T", _ptab_sub1(f)])
        push(r, ["F", _ptab_sub2(f)])
        return r
    if sign == "T" and tag == "not"
        push(r, ["F", _ptab_sub1(f)])
        return r
    if sign == "F" and tag == "not"
        push(r, ["T", _ptab_sub1(f)])
        return r
    r

// _ptab_beta_left — signed formulas to add to left sub-branch of beta expansion.
fn _ptab_beta_left(sf) -> list
    let sign = sf[0]
    let f = sf[1]
    let tag = _ptab_fmttag(f)
    let r = []
    if sign == "F" and tag == "and"
        push(r, ["F", _ptab_sub1(f)])
        return r
    if sign == "T" and tag == "or"
        push(r, ["T", _ptab_sub1(f)])
        return r
    if sign == "T" and tag == "imp"
        push(r, ["F", _ptab_sub1(f)])
        return r
    r

// _ptab_beta_right — signed formulas to add to right sub-branch of beta expansion.
fn _ptab_beta_right(sf) -> list
    let sign = sf[0]
    let f = sf[1]
    let tag = _ptab_fmttag(f)
    let r = []
    if sign == "F" and tag == "and"
        push(r, ["F", _ptab_sub2(f)])
        return r
    if sign == "T" and tag == "or"
        push(r, ["T", _ptab_sub2(f)])
        return r
    if sign == "T" and tag == "imp"
        push(r, ["T", _ptab_sub2(f)])
        return r
    r

// _ptab_branch_without_idx — copy branch excluding element at index idx.
fn _ptab_branch_without_idx(branch, idx) -> list
    let out = []
    let n = len(branch)
    let i = 0
    while i < n
        if i != idx
            push(out, branch[i])
        i = i + 1
    out

// _ptab_find_expandable — find first index of a non-literal signed formula, or -1 if none.
fn _ptab_find_expandable(branch) -> int
    let n = len(branch)
    let i = 0
    while i < n
        let k = _ptab_sf_kind(branch[i])
        if k != 0
            return i
        i = i + 1
    -1

// _ptab_expand_and_close — recursively expand branch; returns true iff it closes.
// branch: list of signed formulas. Processes one expandable formula per call.
fn _ptab_expand_and_close(branch) -> bool
    if _ptab_branch_closed(branch)
        return true
    let idx = _ptab_find_expandable(branch)
    if idx == -1
        return false
    let sf = branch[idx]
    let kind = _ptab_sf_kind(sf)
    // Remove sf from branch
    let rest = _ptab_branch_without_idx(branch, idx)
    if kind == 3
        // trivially-closes: T-bot or F-top forces closure (just add opposite to make it close)
        return true
    if kind == 1
        // alpha: add expansion to rest, recurse
        let parts = _ptab_alpha_parts(sf)
        let nb = _ptab_copy_branch(rest)
        let ni = 0
        while ni < len(parts)
            push(nb, parts[ni])
            ni = ni + 1
        return _ptab_expand_and_close(nb)
    if kind == 2
        // beta: split into two sub-branches
        let left_adds = _ptab_beta_left(sf)
        let right_adds = _ptab_beta_right(sf)
        let bleft = _ptab_copy_branch(rest)
        let ni2 = 0
        while ni2 < len(left_adds)
            push(bleft, left_adds[ni2])
            ni2 = ni2 + 1
        let bright = _ptab_copy_branch(rest)
        let ni3 = 0
        while ni3 < len(right_adds)
            push(bright, right_adds[ni3])
            ni3 = ni3 + 1
        let c0 = _ptab_expand_and_close(bleft)
        if not c0
            return false
        return _ptab_expand_and_close(bright)
    false

// _ptab_expand_and_open — expand branch; returns true iff SOME final branch stays open (sat).
fn _ptab_expand_and_open(branch) -> bool
    if _ptab_branch_closed(branch)
        return false
    let idx = _ptab_find_expandable(branch)
    if idx == -1
        return true
    let sf = branch[idx]
    let kind = _ptab_sf_kind(sf)
    let rest = _ptab_branch_without_idx(branch, idx)
    if kind == 3
        return false
    if kind == 1
        let parts = _ptab_alpha_parts(sf)
        let nb = _ptab_copy_branch(rest)
        let ni = 0
        while ni < len(parts)
            push(nb, parts[ni])
            ni = ni + 1
        return _ptab_expand_and_open(nb)
    if kind == 2
        let left_adds = _ptab_beta_left(sf)
        let right_adds = _ptab_beta_right(sf)
        let bleft = _ptab_copy_branch(rest)
        let ni2 = 0
        while ni2 < len(left_adds)
            push(bleft, left_adds[ni2])
            ni2 = ni2 + 1
        let bright = _ptab_copy_branch(rest)
        let ni3 = 0
        while ni3 < len(right_adds)
            push(bright, right_adds[ni3])
            ni3 = ni3 + 1
        let o0 = _ptab_expand_and_open(bleft)
        if o0
            return true
        return _ptab_expand_and_open(bright)
    false

// ptab_is_valid — true iff f is a tautology. Starts tableau from ["F", f]; valid iff all branches close.
fn ptab_is_valid(f) -> bool
    let init = []
    push(init, ["F", f])
    _ptab_expand_and_close(init)

// ptab_is_satisfiable — true iff f has a model. Starts from ["T", f]; sat iff some branch stays open.
fn ptab_is_satisfiable(f) -> bool
    let init = []
    push(init, ["T", f])
    _ptab_expand_and_open(init)

// ptab_is_contradiction — true iff f is unsatisfiable.
fn ptab_is_contradiction(f) -> bool
    not ptab_is_satisfiable(f)
