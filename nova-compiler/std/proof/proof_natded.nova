// std/proof/proof_natded.nova — Natural deduction proof trees.
// LEAF — imports NOTHING.
//
// Formula representation (tagged lists):
//   ["var", name], ["not", f], ["and", a, b], ["or", a, b],
//   ["imp", a, b], ["bot"], ["top"]
//
// Proof tree nodes:
//   ["assume", formula]
//   ["and_i", p, q]
//   ["and_e1", p]
//   ["and_e2", p]
//   ["or_i1", formula, p]    — or-introduction-left  (formula = right disjunct)
//   ["or_i2", formula, p]    — or-introduction-right (formula = left disjunct)
//   ["or_e", p, fL, qL, fR, qR]
//   ["imp_i", assumed, p]    — discharges all ["assume",assumed] leaves in p
//   ["imp_e", p, q]          — modus ponens: p: A->B, q: A => B
//   ["not_i", assumed, p]    — p derives bot => concludes not(assumed)
//   ["not_e", p, q]          — p: not(A), q: A => bot
//   ["bot_e", formula, p]    — p: bot => formula
//
// pnd_conclusion(proof) -> any   formula proved by proof, or "FAIL" if malformed
// pnd_open(proof) -> list        list of undischarged assumption formulas
// pnd_check(proof) -> bool       structurally valid (and_i both arms type-check, etc.)
// pnd_is_closed(proof) -> bool   no open assumptions

// _pnd_formula_eq — deep equality of two formula tagged-lists
fn _pnd_formula_eq(a, b) -> bool
    if len(a) != len(b)
        return false
    let tag_a = a[0]
    let tag_b = b[0]
    if tag_a != tag_b
        return false
    if tag_a == "bot"
        return true
    if tag_a == "top"
        return true
    if tag_a == "var"
        return a[1] == b[1]
    if tag_a == "not"
        return _pnd_formula_eq(a[1], b[1])
    if tag_a == "and"
        if not _pnd_formula_eq(a[1], b[1])
            return false
        return _pnd_formula_eq(a[2], b[2])
    if tag_a == "or"
        if not _pnd_formula_eq(a[1], b[1])
            return false
        return _pnd_formula_eq(a[2], b[2])
    if tag_a == "imp"
        if not _pnd_formula_eq(a[1], b[1])
            return false
        return _pnd_formula_eq(a[2], b[2])
    false

// _pnd_is_bot — true iff formula is ["bot"]
fn _pnd_is_bot(f) -> bool
    if len(f) < 1
        return false
    f[0] == "bot"

// _pnd_should_discharge — true iff this assumption formula matches any in 'discharged' list
fn _pnd_should_discharge(f, discharged) -> bool
    for i in 0..len(discharged)
        if _pnd_formula_eq(f, discharged[i])
            return true
    false

// _pnd_open_rec — collect undischarged assumption formulas from proof.
// 'discharged' is a list of formulas to suppress (those already discharged by enclosing rules).
// Results accumulated into 'acc'.
fn _pnd_open_rec(proof, acc, discharged)
    let tag = proof[0]
    if tag == "assume"
        if not _pnd_should_discharge(proof[1], discharged)
            push(acc, proof[1])
        return null
    if tag == "and_i"
        _pnd_open_rec(proof[1], acc, discharged)
        _pnd_open_rec(proof[2], acc, discharged)
        return null
    if tag == "and_e1"
        _pnd_open_rec(proof[1], acc, discharged)
        return null
    if tag == "and_e2"
        _pnd_open_rec(proof[1], acc, discharged)
        return null
    if tag == "or_i1"
        _pnd_open_rec(proof[2], acc, discharged)
        return null
    if tag == "or_i2"
        _pnd_open_rec(proof[2], acc, discharged)
        return null
    if tag == "or_e"
        // proof[1] = main disjunct; proof[2]=fL; proof[3]=qL; proof[4]=fR; proof[5]=qR
        _pnd_open_rec(proof[1], acc, discharged)
        let dL = [proof[2]]
        for i in 0..len(discharged)
            push(dL, discharged[i])
        _pnd_open_rec(proof[3], acc, dL)
        let dR = [proof[4]]
        for j in 0..len(discharged)
            push(dR, discharged[j])
        _pnd_open_rec(proof[5], acc, dR)
        return null
    if tag == "imp_i"
        // assumed = proof[1]; sub-proof = proof[2]; imp_i discharges proof[1]
        let d2 = [proof[1]]
        for i in 0..len(discharged)
            push(d2, discharged[i])
        _pnd_open_rec(proof[2], acc, d2)
        return null
    if tag == "imp_e"
        _pnd_open_rec(proof[1], acc, discharged)
        _pnd_open_rec(proof[2], acc, discharged)
        return null
    if tag == "not_i"
        // assumed = proof[1]; sub-proof = proof[2]; not_i discharges proof[1]
        let d3 = [proof[1]]
        for i in 0..len(discharged)
            push(d3, discharged[i])
        _pnd_open_rec(proof[2], acc, d3)
        return null
    if tag == "not_e"
        _pnd_open_rec(proof[1], acc, discharged)
        _pnd_open_rec(proof[2], acc, discharged)
        return null
    if tag == "bot_e"
        _pnd_open_rec(proof[2], acc, discharged)
        return null
    null

// pnd_conclusion — compute the formula proved by a proof tree, or "FAIL"
fn pnd_conclusion(proof) -> any
    let tag = proof[0]
    if tag == "assume"
        return proof[1]
    if tag == "and_i"
        let ca = pnd_conclusion(proof[1])
        let cb = pnd_conclusion(proof[2])
        if ca == "FAIL"
            return "FAIL"
        if cb == "FAIL"
            return "FAIL"
        return ["and", ca, cb]
    if tag == "and_e1"
        let c = pnd_conclusion(proof[1])
        if c == "FAIL"
            return "FAIL"
        if len(c) < 1
            return "FAIL"
        if c[0] != "and"
            return "FAIL"
        return c[1]
    if tag == "and_e2"
        let c = pnd_conclusion(proof[1])
        if c == "FAIL"
            return "FAIL"
        if len(c) < 1
            return "FAIL"
        if c[0] != "and"
            return "FAIL"
        return c[2]
    if tag == "or_i1"
        let c = pnd_conclusion(proof[2])
        if c == "FAIL"
            return "FAIL"
        return ["or", c, proof[1]]
    if tag == "or_i2"
        let c = pnd_conclusion(proof[2])
        if c == "FAIL"
            return "FAIL"
        return ["or", proof[1], c]
    if tag == "or_e"
        let cp = pnd_conclusion(proof[1])
        if cp == "FAIL"
            return "FAIL"
        if len(cp) < 1
            return "FAIL"
        if cp[0] != "or"
            return "FAIL"
        let fL = proof[2]
        let qL = proof[3]
        let fR = proof[4]
        let qR = proof[5]
        if not _pnd_formula_eq(cp[1], fL)
            return "FAIL"
        if not _pnd_formula_eq(cp[2], fR)
            return "FAIL"
        let cqL = pnd_conclusion(qL)
        let cqR = pnd_conclusion(qR)
        if cqL == "FAIL"
            return "FAIL"
        if cqR == "FAIL"
            return "FAIL"
        if not _pnd_formula_eq(cqL, cqR)
            return "FAIL"
        return cqL
    if tag == "imp_i"
        let assumed = proof[1]
        let c = pnd_conclusion(proof[2])
        if c == "FAIL"
            return "FAIL"
        return ["imp", assumed, c]
    if tag == "imp_e"
        let cp = pnd_conclusion(proof[1])
        let cq = pnd_conclusion(proof[2])
        if cp == "FAIL"
            return "FAIL"
        if cq == "FAIL"
            return "FAIL"
        if len(cp) < 1
            return "FAIL"
        if cp[0] != "imp"
            return "FAIL"
        if not _pnd_formula_eq(cp[1], cq)
            return "FAIL"
        return cp[2]
    if tag == "not_i"
        let assumed = proof[1]
        let c = pnd_conclusion(proof[2])
        if c == "FAIL"
            return "FAIL"
        if not _pnd_is_bot(c)
            return "FAIL"
        return ["not", assumed]
    if tag == "not_e"
        let cp = pnd_conclusion(proof[1])
        let cq = pnd_conclusion(proof[2])
        if cp == "FAIL"
            return "FAIL"
        if cq == "FAIL"
            return "FAIL"
        if len(cp) < 1
            return "FAIL"
        if cp[0] != "not"
            return "FAIL"
        if not _pnd_formula_eq(cp[1], cq)
            return "FAIL"
        return ["bot"]
    if tag == "bot_e"
        let c = pnd_conclusion(proof[2])
        if c == "FAIL"
            return "FAIL"
        if not _pnd_is_bot(c)
            return "FAIL"
        return proof[1]
    "FAIL"

// pnd_open — list of all undischarged assumption formulas in the proof
fn pnd_open(proof) -> list
    let acc = []
    let empty = []
    _pnd_open_rec(proof, acc, empty)
    acc

// pnd_check — true iff proof tree is structurally valid (each rule correctly typed)
fn pnd_check(proof) -> bool
    let c = pnd_conclusion(proof)
    if c == "FAIL"
        return false
    true

// pnd_is_closed — true iff proof has no open (undischarged) assumptions
fn pnd_is_closed(proof) -> bool
    let opens = pnd_open(proof)
    len(opens) == 0
