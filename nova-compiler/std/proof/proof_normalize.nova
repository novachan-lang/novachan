// std/proof/proof_normalize.nova — Natural-deduction normalization (detour elimination).
// LEAF — imports NOTHING.
//
// Formula representation identical to proof_natded:
//   ["var", name], ["not", f], ["and", a, b], ["or", a, b],
//   ["imp", a, b], ["bot"], ["top"]
//
// Proof tree nodes: same as proof_natded (assume, and_i, and_e1, and_e2,
//   or_i1, or_i2, or_e, imp_i, imp_e, not_i, not_e, bot_e).
//
// A DETOUR is a rule-intro immediately followed by its own rule-elim:
//   and_e1(and_i(p,q))          — eliminates to p
//   and_e2(and_i(p,q))          — eliminates to q
//   imp_e(imp_i(A,p), q)        — eliminates to p[q/["assume",A]]  (substitute q for A-assumptions in p)
//   or_e over or_i1             — or_e(or_i1(fR,pL), fL, ...) when pL proves fL => take left branch
//   or_e over or_i2             — or_e(or_i2(fL,pR), fL, ...) when pR proves fR => take right branch
//
// pnorm_conclusion(proof) -> any    formula proved by proof (own impl, no import)
// pnorm_has_detour(proof) -> bool   outermost node is a detour
// pnorm_step(proof) -> any          contract ONE outermost detour (returns reduced proof)
// pnorm_normalize(proof, maxsteps) -> any  iterate pnorm_step until normal or maxsteps
// pnorm_is_normal(proof) -> bool    no detours exist anywhere in proof tree

// --- Formula equality ---

fn _pnorm_feq(a, b) -> bool
    if len(a) != len(b)
        return false
    if a[0] != b[0]
        return false
    let tag = a[0]
    if tag == "bot"
        return true
    if tag == "top"
        return true
    if tag == "var"
        return a[1] == b[1]
    if tag == "not"
        return _pnorm_feq(a[1], b[1])
    if tag == "and"
        if not _pnorm_feq(a[1], b[1])
            return false
        return _pnorm_feq(a[2], b[2])
    if tag == "or"
        if not _pnorm_feq(a[1], b[1])
            return false
        return _pnorm_feq(a[2], b[2])
    if tag == "imp"
        if not _pnorm_feq(a[1], b[1])
            return false
        return _pnorm_feq(a[2], b[2])
    false

// --- Own conclusion implementation (no import) ---

fn _pnorm_is_bot(f) -> bool
    if len(f) < 1
        return false
    f[0] == "bot"

fn pnorm_conclusion(proof) -> any
    let tag = proof[0]
    if tag == "assume"
        return proof[1]
    if tag == "and_i"
        let ca = pnorm_conclusion(proof[1])
        let cb = pnorm_conclusion(proof[2])
        if ca == "FAIL"
            return "FAIL"
        if cb == "FAIL"
            return "FAIL"
        return ["and", ca, cb]
    if tag == "and_e1"
        let c = pnorm_conclusion(proof[1])
        if c == "FAIL"
            return "FAIL"
        if len(c) < 1
            return "FAIL"
        if c[0] != "and"
            return "FAIL"
        return c[1]
    if tag == "and_e2"
        let c = pnorm_conclusion(proof[1])
        if c == "FAIL"
            return "FAIL"
        if len(c) < 1
            return "FAIL"
        if c[0] != "and"
            return "FAIL"
        return c[2]
    if tag == "or_i1"
        let c = pnorm_conclusion(proof[2])
        if c == "FAIL"
            return "FAIL"
        return ["or", c, proof[1]]
    if tag == "or_i2"
        let c = pnorm_conclusion(proof[2])
        if c == "FAIL"
            return "FAIL"
        return ["or", proof[1], c]
    if tag == "or_e"
        let cp = pnorm_conclusion(proof[1])
        if cp == "FAIL"
            return "FAIL"
        if len(cp) < 1
            return "FAIL"
        if cp[0] != "or"
            return "FAIL"
        let cqL = pnorm_conclusion(proof[3])
        let cqR = pnorm_conclusion(proof[5])
        if cqL == "FAIL"
            return "FAIL"
        if cqR == "FAIL"
            return "FAIL"
        if not _pnorm_feq(cqL, cqR)
            return "FAIL"
        return cqL
    if tag == "imp_i"
        let c = pnorm_conclusion(proof[2])
        if c == "FAIL"
            return "FAIL"
        return ["imp", proof[1], c]
    if tag == "imp_e"
        let cp = pnorm_conclusion(proof[1])
        let cq = pnorm_conclusion(proof[2])
        if cp == "FAIL"
            return "FAIL"
        if cq == "FAIL"
            return "FAIL"
        if len(cp) < 1
            return "FAIL"
        if cp[0] != "imp"
            return "FAIL"
        if not _pnorm_feq(cp[1], cq)
            return "FAIL"
        return cp[2]
    if tag == "not_i"
        let c = pnorm_conclusion(proof[2])
        if c == "FAIL"
            return "FAIL"
        if not _pnorm_is_bot(c)
            return "FAIL"
        return ["not", proof[1]]
    if tag == "not_e"
        let cp = pnorm_conclusion(proof[1])
        let cq = pnorm_conclusion(proof[2])
        if cp == "FAIL"
            return "FAIL"
        if cq == "FAIL"
            return "FAIL"
        if len(cp) < 1
            return "FAIL"
        if cp[0] != "not"
            return "FAIL"
        if not _pnorm_feq(cp[1], cq)
            return "FAIL"
        return ["bot"]
    if tag == "bot_e"
        let c = pnorm_conclusion(proof[2])
        if c == "FAIL"
            return "FAIL"
        if not _pnorm_is_bot(c)
            return "FAIL"
        return proof[1]
    "FAIL"

// --- Substitution: replace ["assume", target_formula] leaves with replacement proof ---

fn _pnorm_subst(proof, target, replacement) -> any
    let tag = proof[0]
    if tag == "assume"
        if _pnorm_feq(proof[1], target)
            return replacement
        return proof
    if tag == "and_i"
        let p1 = _pnorm_subst(proof[1], target, replacement)
        let p2 = _pnorm_subst(proof[2], target, replacement)
        return ["and_i", p1, p2]
    if tag == "and_e1"
        return ["and_e1", _pnorm_subst(proof[1], target, replacement)]
    if tag == "and_e2"
        return ["and_e2", _pnorm_subst(proof[1], target, replacement)]
    if tag == "or_i1"
        return ["or_i1", proof[1], _pnorm_subst(proof[2], target, replacement)]
    if tag == "or_i2"
        return ["or_i2", proof[1], _pnorm_subst(proof[2], target, replacement)]
    if tag == "or_e"
        let sp = _pnorm_subst(proof[1], target, replacement)
        let sqL = _pnorm_subst(proof[3], target, replacement)
        let sqR = _pnorm_subst(proof[5], target, replacement)
        return ["or_e", sp, proof[2], sqL, proof[4], sqR]
    if tag == "imp_i"
        // If imp_i re-discharges the same assumed formula, don't substitute inside
        if _pnorm_feq(proof[1], target)
            return proof
        return ["imp_i", proof[1], _pnorm_subst(proof[2], target, replacement)]
    if tag == "imp_e"
        let sp = _pnorm_subst(proof[1], target, replacement)
        let sq = _pnorm_subst(proof[2], target, replacement)
        return ["imp_e", sp, sq]
    if tag == "not_i"
        if _pnorm_feq(proof[1], target)
            return proof
        return ["not_i", proof[1], _pnorm_subst(proof[2], target, replacement)]
    if tag == "not_e"
        let sp = _pnorm_subst(proof[1], target, replacement)
        let sq = _pnorm_subst(proof[2], target, replacement)
        return ["not_e", sp, sq]
    if tag == "bot_e"
        return ["bot_e", proof[1], _pnorm_subst(proof[2], target, replacement)]
    proof

// --- Detour detection and contraction ---

// pnorm_has_detour — true iff the OUTERMOST node is a detour
fn pnorm_has_detour(proof) -> bool
    let tag = proof[0]
    if tag == "and_e1"
        let inner = proof[1]
        return inner[0] == "and_i"
    if tag == "and_e2"
        let inner = proof[1]
        return inner[0] == "and_i"
    if tag == "imp_e"
        let inner = proof[1]
        return inner[0] == "imp_i"
    if tag == "or_e"
        let inner = proof[1]
        return inner[0] == "or_i1" or inner[0] == "or_i2"
    false

// pnorm_step — contract ONE outermost detour; returns reduced proof (or same proof if no detour)
fn pnorm_step(proof) -> any
    let tag = proof[0]
    // and_e1(and_i(p,q)) -> p
    if tag == "and_e1"
        let inner = proof[1]
        if inner[0] == "and_i"
            return inner[1]
        return proof
    // and_e2(and_i(p,q)) -> q
    if tag == "and_e2"
        let inner = proof[1]
        if inner[0] == "and_i"
            return inner[2]
        return proof
    // imp_e(imp_i(A,p), q) -> p[q/["assume",A]]
    if tag == "imp_e"
        let inner = proof[1]
        if inner[0] == "imp_i"
            let assumed_formula = inner[1]
            let body = inner[2]
            let arg = proof[2]
            return _pnorm_subst(body, assumed_formula, arg)
        return proof
    // or_e(or_i1(fR, pL), fL, qL, fR2, qR) -> qL[pL/["assume",fL]]
    // or_e(or_i2(fL, pR), fL, qL, fR, qR)  -> qR[pR/["assume",fR]]
    if tag == "or_e"
        let inner = proof[1]
        if inner[0] == "or_i1"
            // inner = ["or_i1", fR, pL]; inner[2] = pL proves fL
            let pL = inner[2]
            let fL = proof[2]
            let qL = proof[3]
            return _pnorm_subst(qL, fL, pL)
        if inner[0] == "or_i2"
            // inner = ["or_i2", fL, pR]; inner[2] = pR proves fR
            let pR = inner[2]
            let fR = proof[4]
            let qR = proof[5]
            return _pnorm_subst(qR, fR, pR)
        return proof
    proof

// pnorm_is_normal — true iff there are NO detours anywhere in the proof tree
fn pnorm_is_normal(proof) -> bool
    if pnorm_has_detour(proof)
        return false
    let tag = proof[0]
    if tag == "assume"
        return true
    if tag == "and_i"
        if not pnorm_is_normal(proof[1])
            return false
        return pnorm_is_normal(proof[2])
    if tag == "and_e1"
        return pnorm_is_normal(proof[1])
    if tag == "and_e2"
        return pnorm_is_normal(proof[1])
    if tag == "or_i1"
        return pnorm_is_normal(proof[2])
    if tag == "or_i2"
        return pnorm_is_normal(proof[2])
    if tag == "or_e"
        if not pnorm_is_normal(proof[1])
            return false
        if not pnorm_is_normal(proof[3])
            return false
        return pnorm_is_normal(proof[5])
    if tag == "imp_i"
        return pnorm_is_normal(proof[2])
    if tag == "imp_e"
        if not pnorm_is_normal(proof[1])
            return false
        return pnorm_is_normal(proof[2])
    if tag == "not_i"
        return pnorm_is_normal(proof[2])
    if tag == "not_e"
        if not pnorm_is_normal(proof[1])
            return false
        return pnorm_is_normal(proof[2])
    if tag == "bot_e"
        return pnorm_is_normal(proof[2])
    true

// pnorm_normalize — repeatedly apply pnorm_step until normal or maxsteps exhausted
fn pnorm_normalize(proof, maxsteps) -> any
    let cur = proof
    let steps = 0
    while steps < maxsteps
        if pnorm_is_normal(cur)
            return cur
        cur = pnorm_step(cur)
        steps = steps + 1
    cur
