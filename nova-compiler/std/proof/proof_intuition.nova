// std/proof/proof_intuition.nova — Classical vs intuitionistic validity via Kripke models.
// Formula representation (tagged lists):
//   ["var",name] ; ["not",f] ; ["and",a,b] ; ["or",a,b] ; ["imp",a,b] ; ["bot"] ; ["top"]
// Classical validity: truth-table check (all 2^k assignments).
// Intuitionistic validity: Kripke semantics — search all frames up to 3 worlds.
//   A Kripke model = (worlds, accessibility relation, valuation).
//   Accessibility: partial order (reflexive + transitive). We encode as a reachability matrix.
//   Forcing: w||-var iff val[w][var]=1; monotone (if w<=w' and w||-p then w'||-p).
//   w||-bot never; w||-top always; w||-A&B iff both; w||-A|B iff either;
//   w||-A->B iff for all w'>=w: w'||-A implies w'||-B;
//   w||-~A iff for all w'>=w: not(w'||-A).
// LEAF — imports NOTHING.
// All public functions prefixed pint_.

// ── formula constructors ──────────────────────────────────────────────────────

// pint_var — build variable formula.
fn pint_var(name) -> list
    let f = []
    push(f, "var")
    push(f, name)
    f

// pint_not — build negation formula.
fn pint_not(a) -> list
    let f = []
    push(f, "not")
    push(f, a)
    f

// pint_and — build conjunction formula.
fn pint_and(a, b) -> list
    let f = []
    push(f, "and")
    push(f, a)
    push(f, b)
    f

// pint_or — build disjunction formula.
fn pint_or(a, b) -> list
    let f = []
    push(f, "or")
    push(f, a)
    push(f, b)
    f

// pint_imp — build implication formula.
fn pint_imp(a, b) -> list
    let f = []
    push(f, "imp")
    push(f, a)
    push(f, b)
    f

// pint_bot — build false formula.
fn pint_bot() -> list
    let f = []
    push(f, "bot")
    f

// pint_top — build true formula.
fn pint_top() -> list
    let f = []
    push(f, "top")
    f

// ── variable collection ───────────────────────────────────────────────────────

// _pint_collect_vars — collect unique variable names from a formula into out list.
fn _pint_collect_vars(fml, seen, out)
    let tag = fml[0]
    if tag == "var"
        let nm = fml[1]
        if not contains(seen, nm)
            seen[nm] = 1
            push(out, nm)
        return
    if tag == "not"
        _pint_collect_vars(fml[1], seen, out)
        return
    if tag == "bot"
        return
    if tag == "top"
        return
    if tag == "and"
        _pint_collect_vars(fml[1], seen, out)
        _pint_collect_vars(fml[2], seen, out)
        return
    if tag == "or"
        _pint_collect_vars(fml[1], seen, out)
        _pint_collect_vars(fml[2], seen, out)
        return
    if tag == "imp"
        _pint_collect_vars(fml[1], seen, out)
        _pint_collect_vars(fml[2], seen, out)
        return

// ── classical evaluation ──────────────────────────────────────────────────────

// _pint_eval_classical — evaluate formula under env dict (name->0/1). Returns 0/1.
fn _pint_eval_classical(fml, env) -> int
    let tag = fml[0]
    if tag == "top"
        return 1
    if tag == "bot"
        return 0
    if tag == "var"
        if contains(env, fml[1])
            return env[fml[1]]
        return 0
    if tag == "not"
        if _pint_eval_classical(fml[1], env) == 0
            return 1
        return 0
    if tag == "and"
        if _pint_eval_classical(fml[1], env) == 1
            if _pint_eval_classical(fml[2], env) == 1
                return 1
        return 0
    if tag == "or"
        if _pint_eval_classical(fml[1], env) == 1
            return 1
        if _pint_eval_classical(fml[2], env) == 1
            return 1
        return 0
    if tag == "imp"
        if _pint_eval_classical(fml[1], env) == 1
            if _pint_eval_classical(fml[2], env) == 0
                return 0
        return 1
    0

// pint_is_classically_valid — truth-table check; true iff formula holds on all assignments.
fn pint_is_classically_valid(fml) -> bool
    let seen = {}
    let vars = []
    _pint_collect_vars(fml, seen, vars)
    let nvars = len(vars)
    let total = 1
    for k in 0..nvars
        total = total * 2
    for i in 0..total
        let env = {}
        let b = 0
        while b < nvars
            env[vars[b]] = (i >> b) & 1
            b = b + 1
        if _pint_eval_classical(fml, env) == 0
            return false
    true

// ── Kripke forcing ────────────────────────────────────────────────────────────
// A Kripke frame has `nw` worlds (0..nw-1).
// reach[w1*nw+w2] = 1 if world w1 can see world w2 (w1 <= w2 in the partial order).
// val[w*nvars+v] = 1 if world w forces variable v.
// Monotonicity: val must satisfy: if reach[w1*nw+w2]=1 then val[w1*nvars+v]<=val[w2*nvars+v].

// _pint_forces — check if world w forces formula fml in a Kripke model.
fn _pint_forces(fml, w, nw, reach, val, vars) -> int
    let tag = fml[0]
    if tag == "bot"
        return 0
    if tag == "top"
        return 1
    if tag == "var"
        // find index of variable in vars list
        let vname = fml[1]
        let vi = 0
        let nvars = len(vars)
        while vi < nvars
            if vars[vi] == vname
                return val[w * nvars + vi]
            vi = vi + 1
        return 0
    if tag == "not"
        // w||-~A iff for all w'>=w, not(w'||-A)
        for w2 in 0..nw
            if reach[w * nw + w2] == 1
                if _pint_forces(fml[1], w2, nw, reach, val, vars) == 1
                    return 0
        return 1
    if tag == "and"
        if _pint_forces(fml[1], w, nw, reach, val, vars) == 1
            if _pint_forces(fml[2], w, nw, reach, val, vars) == 1
                return 1
        return 0
    if tag == "or"
        if _pint_forces(fml[1], w, nw, reach, val, vars) == 1
            return 1
        if _pint_forces(fml[2], w, nw, reach, val, vars) == 1
            return 1
        return 0
    if tag == "imp"
        // w||-A->B iff for all w'>=w: if w'||-A then w'||-B
        for w2 in 0..nw
            if reach[w * nw + w2] == 1
                if _pint_forces(fml[1], w2, nw, reach, val, vars) == 1
                    if _pint_forces(fml[2], w2, nw, reach, val, vars) == 0
                        return 0
        return 1
    0

// _pint_check_monotone — verify valuation is monotone w.r.t. reachability.
fn _pint_check_monotone(nw, nvars, reach, val) -> int
    for w1 in 0..nw
        let w2 = 0
        while w2 < nw
            if reach[w1 * nw + w2] == 1
                let v = 0
                while v < nvars
                    if val[w1 * nvars + v] == 1
                        if val[w2 * nvars + v] == 0
                            return 0
                    v = v + 1
            w2 = w2 + 1
    1

// _pint_check_transitive — verify reach encodes a transitive relation.
fn _pint_check_transitive(nw, reach) -> int
    let a = 0
    while a < nw
        for b in 0..nw
            if reach[a * nw + b] == 1
                let c = 0
                while c < nw
                    if reach[b * nw + c] == 1
                        if reach[a * nw + c] == 0
                            return 0
                    c = c + 1
        a = a + 1
    1

// _pint_forced_all_worlds — check if formula is forced at ALL worlds 0..nw-1.
fn _pint_forced_all_worlds(fml, nw, reach, val, vars) -> int
    for w in 0..nw
        if _pint_forces(fml, w, nw, reach, val, vars) == 0
            return 0
    1

// _pint_search_countermodel — try all Kripke models up to max_worlds worlds.
// Returns 1 if a countermodel exists (formula NOT forced at some world of some model), else 0.
fn _pint_search_countermodel(fml, max_worlds) -> int
    let seen = {}
    let vars = []
    _pint_collect_vars(fml, seen, vars)
    let nvars = len(vars)
    // For nw = 1, 2, 3
    let nw = 1
    while nw <= max_worlds
        // Enumerate reachability matrices: nw*nw bits, reflexive (diag must be 1).
        // Total bits to choose freely = nw*nw - nw (off-diagonal entries).
        // We enumerate all 2^(nw*nw) matrices and filter for partial orders.
        let reach_total = 1
        for ri in 0..(nw * nw)
            reach_total = reach_total * 2
        for rm in 0..reach_total
            // Build reach as a flat list nw*nw.
            let reach = []
            let ii = 0
            while ii < nw * nw
                push(reach, (rm >> ii) & 1)
                ii = ii + 1
            // Check: reflexive (each world can see itself).
            let refl_ok = 1
            let wr = 0
            while wr < nw
                if reach[wr * nw + wr] == 0
                    refl_ok = 0
                wr = wr + 1
            if refl_ok == 1
                // Check: transitive.
                if _pint_check_transitive(nw, reach) == 1
                    // Enumerate all valuations: nw*nvars bits.
                    let val_bits = nw * nvars
                    let val_total = 1
                    let vb = 0
                    while vb < val_bits
                        val_total = val_total * 2
                        vb = vb + 1
                    let vm = 0
                    while vm < val_total
                        // Build val as flat list.
                        let val = []
                        let vi = 0
                        while vi < val_bits
                            push(val, (vm >> vi) & 1)
                            vi = vi + 1
                        // Check monotonicity.
                        if _pint_check_monotone(nw, nvars, reach, val) == 1
                            // Check if formula is NOT forced at every world.
                            if _pint_forced_all_worlds(fml, nw, reach, val, vars) == 0
                                return 1
                        vm = vm + 1
        nw = nw + 1
    0

// pint_is_intuitionistically_valid — true iff no Kripke countermodel exists (up to 3 worlds).
fn pint_is_intuitionistically_valid(fml) -> bool
    if _pint_search_countermodel(fml, 3) == 1
        return false
    true

// pint_needs_classical — true iff classically valid but NOT intuitionistically valid.
fn pint_needs_classical(fml) -> bool
    if not pint_is_classically_valid(fml)
        return false
    if pint_is_intuitionistically_valid(fml)
        return false
    true
