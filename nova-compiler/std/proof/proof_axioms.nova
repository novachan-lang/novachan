// std/proof/proof_axioms.nova — axiom schema matching and instantiation.
// LEAF — imports NOTHING.
//
// A SCHEMA is a formula whose ["var", name] leaves may be METAVARIABLES.
// Metavariables are var-nodes whose name starts with an uppercase letter (A-Z).
// A concrete variable (schema or formula) has a lowercase-starting name.
//
// Formula shape (tagged list) — same convention as proof_formula:
//   ["var", name] ; ["not", f] ; ["and", a, b] ; ["or", a, b] ; ["imp", a, b] ; ["bot"] ; ["top"]
//
// Public API: all prefixed pax_.

// ── Formula constructors (self-contained) ─────────────────────────────────────

// pax_var — propositional variable (concrete or meta).
fn pax_var(name: string) -> list
    let f = []
    push(f, "var")
    push(f, name)
    f

// pax_not — negation.
fn pax_not(a: list) -> list
    let f = []
    push(f, "not")
    push(f, a)
    f

// pax_and — conjunction.
fn pax_and(a: list, b: list) -> list
    let f = []
    push(f, "and")
    push(f, a)
    push(f, b)
    f

// pax_or — disjunction.
fn pax_or(a: list, b: list) -> list
    let f = []
    push(f, "or")
    push(f, a)
    push(f, b)
    f

// pax_imp — implication.
fn pax_imp(a: list, b: list) -> list
    let f = []
    push(f, "imp")
    push(f, a)
    push(f, b)
    f

// pax_bot — falsity.
fn pax_bot() -> list
    let f = []
    push(f, "bot")
    f

// pax_top — truth.
fn pax_top() -> list
    let f = []
    push(f, "top")
    f

// ── Structural equality ───────────────────────────────────────────────────────

// _pax_eq — structural equality of two formulas (returns 0/1).
fn _pax_eq(f: list, g: list) -> int
    let ft = f[0]
    let gt = g[0]
    if ft != gt
        return 0
    if ft == "bot"
        return 1
    if ft == "top"
        return 1
    if ft == "var"
        if f[1] == g[1]
            return 1
        return 0
    if ft == "not"
        return _pax_eq(f[1], g[1])
    if ft == "and"
        if _pax_eq(f[1], g[1]) == 0
            return 0
        return _pax_eq(f[2], g[2])
    if ft == "or"
        if _pax_eq(f[1], g[1]) == 0
            return 0
        return _pax_eq(f[2], g[2])
    if ft == "imp"
        if _pax_eq(f[1], g[1]) == 0
            return 0
        return _pax_eq(f[2], g[2])
    0

// ── Metavariable detection ────────────────────────────────────────────────────

// _pax_is_meta — true if name starts with uppercase A-Z.
fn _pax_is_meta(name: string) -> int
    let o = ord(slice(name, 0, 1))
    if o >= 65
        if o <= 90
            return 1
    0

// ── Schema matching ────────────────────────────────────────────────────────────
//
// _pax_match_rec — attempt to unify schema against formula under bindings dict.
// Returns 1 if consistent, 0 on mismatch.
// Binding dict maps metavariable name -> formula (list).

fn _pax_match_rec(schema: list, f: list, bindings: dict) -> int
    let stag = schema[0]
    if stag == "var"
        let sname = schema[1]
        if _pax_is_meta(sname) == 1
            // metavariable: check or record binding
            if contains(bindings, sname)
                let bound = bindings[sname]
                return _pax_eq(bound, f)
            else
                bindings[sname] = f
                return 1
        else
            // concrete schema variable: formula must be the exact same var
            if f[0] != "var"
                return 0
            if f[1] == sname
                return 1
            return 0
    // Non-var schema node: formula must have same tag
    if stag != f[0]
        return 0
    if stag == "bot"
        return 1
    if stag == "top"
        return 1
    if stag == "not"
        return _pax_match_rec(schema[1], f[1], bindings)
    if stag == "and"
        if _pax_match_rec(schema[1], f[1], bindings) == 0
            return 0
        return _pax_match_rec(schema[2], f[2], bindings)
    if stag == "or"
        if _pax_match_rec(schema[1], f[1], bindings) == 0
            return 0
        return _pax_match_rec(schema[2], f[2], bindings)
    if stag == "imp"
        if _pax_match_rec(schema[1], f[1], bindings) == 0
            return 0
        return _pax_match_rec(schema[2], f[2], bindings)
    0

// pax_matches — true iff formula f is an instance of schema with consistent metavariable bindings.
fn pax_matches(schema: list, f: list) -> bool
    let bindings = {}
    _pax_match_rec(schema, f, bindings) == 1

// pax_bindings — compute metavariable bindings for schema against formula.
// Returns a dict mapping metavar-name -> formula, or a list ["FAIL"] on mismatch.
fn pax_bindings(schema: list, f: list) -> dict
    let bindings = {}
    let ok = _pax_match_rec(schema, f, bindings)
    if ok == 0
        // Return sentinel failure dict with key "FAIL"
        let fail_d = {}
        fail_d["FAIL"] = pax_var("FAIL")
        return fail_d
    bindings

// ── Schema instantiation ──────────────────────────────────────────────────────

// _pax_instantiate_rec — replace metavariables in schema using bindings dict.
fn _pax_instantiate_rec(schema: list, bindings: dict) -> list
    let tag = schema[0]
    if tag == "var"
        let nm = schema[1]
        if _pax_is_meta(nm) == 1
            if contains(bindings, nm)
                return bindings[nm]
        return schema
    if tag == "bot"
        return schema
    if tag == "top"
        return schema
    if tag == "not"
        let sub = _pax_instantiate_rec(schema[1], bindings)
        let r = []
        push(r, "not")
        push(r, sub)
        return r
    if tag == "and"
        let l2 = _pax_instantiate_rec(schema[1], bindings)
        let r2 = _pax_instantiate_rec(schema[2], bindings)
        let nd = []
        push(nd, "and")
        push(nd, l2)
        push(nd, r2)
        return nd
    if tag == "or"
        let l3 = _pax_instantiate_rec(schema[1], bindings)
        let r3 = _pax_instantiate_rec(schema[2], bindings)
        let nd2 = []
        push(nd2, "or")
        push(nd2, l3)
        push(nd2, r3)
        return nd2
    if tag == "imp"
        let l4 = _pax_instantiate_rec(schema[1], bindings)
        let r4 = _pax_instantiate_rec(schema[2], bindings)
        let nd3 = []
        push(nd3, "imp")
        push(nd3, l4)
        push(nd3, r4)
        return nd3
    schema

// pax_instantiate — instantiate schema using bindings dict; returns the ground formula.
fn pax_instantiate(schema: list, bindings: dict) -> list
    _pax_instantiate_rec(schema, bindings)

// ── Built-in axiom systems ────────────────────────────────────────────────────

// _pax_schema_a1 — A1: A -> (B -> A)
fn _pax_schema_a1() -> list
    pax_imp(pax_var("A"), pax_imp(pax_var("B"), pax_var("A")))

// _pax_schema_a2 — A2: (A -> (B -> C)) -> ((A -> B) -> (A -> C))
fn _pax_schema_a2() -> list
    pax_imp(pax_imp(pax_var("A"), pax_imp(pax_var("B"), pax_var("C"))), pax_imp(pax_imp(pax_var("A"), pax_var("B")), pax_imp(pax_var("A"), pax_var("C"))))

// _pax_schema_a3 — A3: (~A -> ~B) -> (B -> A)
fn _pax_schema_a3() -> list
    pax_imp(pax_imp(pax_not(pax_var("A")), pax_not(pax_var("B"))), pax_imp(pax_var("B"), pax_var("A")))

// _pax_schema_peirce — Peirce's law: ((A->B)->A)->A  (classical, not intuitionistic)
fn _pax_schema_peirce() -> list
    pax_imp(pax_imp(pax_imp(pax_var("A"), pax_var("B")), pax_var("A")), pax_var("A"))

// pax_system — return list of axiom schemas for named system.
// "classical" = [A1, A2, A3]; "implicational" = [A1, A2]
fn pax_system(name: string) -> list
    let schemas = []
    if name == "classical"
        push(schemas, _pax_schema_a1())
        push(schemas, _pax_schema_a2())
        push(schemas, _pax_schema_a3())
    if name == "implicational"
        push(schemas, _pax_schema_a1())
        push(schemas, _pax_schema_a2())
    schemas
