// randomtest -- NIST-lite statistical randomness tests on byte or bit sequences.
// Operates on lists of ints. Bytes are lists of ints 0..255; bits are lists of 0 or 1.

// Expand each byte in bytes to 8 bits MSB-first (bit7 first), returning a bit list.
fn rt_bits_from_bytes(bytes: any) -> any
    let bits = []
    for i in 0..len(bytes)
        let b = bytes[i]
        for s in 0..8
            let mv = 1 << (7 - s)
            push(bits, 1 if (b & mv) != 0 else 0)
    bits

// Returns the count of 1 bits in a bit list.
fn rt_ones_count(bits: any) -> int
    sum(bits)

// Returns the count of 0 bits in a bit list.
fn rt_zeros_count(bits: any) -> int
    len(bits) - rt_ones_count(bits)

// NIST monobit test: pass if |ones - zeros|^2 <= 4*n (avoids float sqrt).
fn rt_monobit_pass(bits: any) -> bool
    let n = len(bits)
    if n == 0
        return true
    let ones = rt_ones_count(bits)
    let zeros = n - ones
    let diff = abs(ones - zeros)
    diff * diff <= 4 * n

// Returns the number of maximal runs (sequences of identical consecutive bits).
fn rt_runs(bits: any) -> int
    let n = len(bits)
    if n == 0
        return 0
    let count = 1
    for i in 1..n
        if bits[i] != bits[i-1]
            count += 1
    count

// Returns true if the number of runs is within a sane band for n>=8.
fn rt_runs_pass(bits: any) -> bool
    let n = len(bits)
    if n < 8
        return true
    let r = rt_runs(bits)
    r >= n / 4 and r <= 3 * n / 4

// Returns the length of the longest run of consecutive 1 bits.
fn rt_longest_run(bits: any) -> int
    let best = 0
    let cur = 0
    for i in 0..len(bits)
        if bits[i] == 1
            cur += 1
            if cur > best
                best = cur
        else
            cur = 0
    best

// Returns true if every block's ones-count is within [blocksize/4 .. 3*blocksize/4].
fn rt_block_frequency_ok(bits: any, blocksize: int) -> bool
    let n = len(bits)
    if n == 0 or blocksize <= 0
        return true
    let lo = blocksize / 4
    let hi = 3 * blocksize / 4
    let i = 0
    while i + blocksize <= n
        let count = sum([bits[j] for j in i..(i + blocksize)])
        if count < lo or count > hi
            return false
        i += blocksize
    true

// Returns a dict with overlapping adjacent-pair counts: '00','01','10','11'.
fn rt_serial(bits: any) -> any
    let d = {"00": 0, "01": 0, "10": 0, "11": 0}
    let n = len(bits)
    for i in 0..(n - 1)
        let a = bits[i]
        let b = bits[i+1]
        if a == 0 and b == 0
            d["00"] += 1
        if a == 0 and b == 1
            d["01"] += 1
        if a == 1 and b == 0
            d["10"] += 1
        if a == 1 and b == 1
            d["11"] += 1
    d

// Returns count of positions i where bits[i] == bits[i+shift].
fn rt_autocorr(bits: any, shift: int) -> int
    let n = len(bits)
    len([i for i in 0..(n - shift) if bits[i] == bits[i + shift]])

// Returns a list of 256 int counts, one per byte value 0..255.
fn rt_byte_histogram(bytes: any) -> any
    let hist = [0 for i in 0..256]
    for j in 0..len(bytes)
        let b = bytes[j]
        if b >= 0 and b <= 255
            hist[b] += 1
    hist

// Returns a summary dict with keys: ones, zeros, runs, longest_run, monobit_pass.
fn rt_summary(bytes: any) -> any
    let bits = rt_bits_from_bytes(bytes)
    let ones = rt_ones_count(bits)
    let zeros = rt_zeros_count(bits)
    let r = rt_runs(bits)
    let lr = rt_longest_run(bits)
    let mp = rt_monobit_pass(bits)
    {"ones": ones, "zeros": zeros, "runs": r, "longest_run": lr, "monobit_pass": mp}
