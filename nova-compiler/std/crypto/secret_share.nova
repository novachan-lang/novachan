// std/crypto/secret_share -- Shamir's Secret Sharing (threshold secret sharing) over GF(p) for
// a Mersenne prime p = 2^31 - 1.
//
// A degree-(threshold-1) polynomial P(x) = secret + a1*x + a2*x^2 + ... is built over GF(p);
// share i is the point (i, P(i)). Any `threshold` shares reconstruct P(0) = secret via Lagrange
// interpolation; fewer reveal nothing (information-theoretic security within the field).
//
// The field prime is p = 2147483647 (2^31 - 1, a Mersenne prime) rather than a 61/63-bit prime:
// GF(p) arithmetic needs a*b to fit in a 64-bit accumulator without overflow, and two ~31-bit
// operands multiply to at most 62 bits -- safely inside NOVA's 64-bit int. This bounds secrets
// to 0 <= secret < 2^31 - 1; for larger secrets, split into 31-bit limbs and share each limb.
//
// Coefficient generation is a deterministic splitmix64-derived PRNG seeded from the secret
// itself (same tradeoff std/crypto/securetok documents: reproducible for KATs; production use
// should draw coefficients from a real CSPRNG instead).
//
// LEAF -- imports nothing.

fn _ss_prime() -> int
    2147483647

// PRIVATE: reduce a (possibly negative, possibly >= p) int into [0, p).
fn _ss_mod(a: int) -> int
    let p = _ss_prime()
    let r = a % p
    (r + p) % p

// PRIVATE: (a * b) mod p. Safe: |a|,|b| < p < 2^31 so |a*b| < 2^62, well inside int64.
fn _ss_mulmod(a: int, b: int) -> int
    _ss_mod(a * b)

// PRIVATE: base^exp mod p via square-and-multiply (exp assumed >= 0).
fn _ss_modpow(base: int, exp: int) -> int
    let p = _ss_prime()
    let result = 1
    let b = _ss_mod(base)
    let e = exp
    while e > 0
        if (e & 1) == 1
            result = _ss_mulmod(result, b)
        b = _ss_mulmod(b, b)
        e = e >> 1
    result

// PRIVATE: modular inverse of a mod p, via Fermat's little theorem (p prime): a^(p-2) mod p.
fn _ss_modinv(a: int) -> int
    _ss_modpow(a, _ss_prime() - 2)

// PRIVATE: advance a splitmix64-style PRNG state; returns {"v": output, "s": next_state}.
fn _ss_sm_next(state: int) -> any
    let s = (state + 0x9E3779B97F4A7C15) & 0xFFFFFFFFFFFFFFFF
    let z = s
    let t1 = (z ^ ((z >> 30) & 0x3FFFFFFFF)) & 0xFFFFFFFFFFFFFFFF
    z = (t1 * 0xBF58476D1CE4E5B9) & 0xFFFFFFFFFFFFFFFF
    let t2 = (z ^ ((z >> 27) & 0x1FFFFFFFFF)) & 0xFFFFFFFFFFFFFFFF
    z = (t2 * 0x94D049BB133111EB) & 0xFFFFFFFFFFFFFFFF
    let t3 = (z ^ ((z >> 31) & 0x1FFFFFFFF)) & 0xFFFFFFFFFFFFFFFF
    let out = {}
    out["v"] = t3
    out["s"] = s
    out

// PRIVATE: evaluate the polynomial (coeffs[0] + coeffs[1]*x + ...) mod p at x, via Horner's method.
fn _ss_eval(coeffs: any, x: int) -> int
    let result = 0
    let i = len(coeffs) - 1
    while i >= 0
        result = _ss_mod(_ss_mulmod(result, x) + coeffs[i])
        i -= 1
    result

// ss_split(secret_int, n, threshold) -> list of n shares, each a {"x": int, "y": int} dict.
// Any `threshold` of the n shares reconstruct secret_int via ss_combine. Requires
// 1 <= threshold <= n and 0 <= secret_int < 2^31 - 1.
fn ss_split(secret_int: int, n: int, threshold: int) -> any
    let coeffs = []
    push(coeffs, _ss_mod(secret_int))
    let state = secret_int ^ 0x5EE5E11EE5EE5EED
    for k in 1..threshold
        let r = _ss_sm_next(state)
        state = r["s"]
        push(coeffs, _ss_mod(r["v"]))
    let shares = []
    let i = 1
    while i <= n
        let share = {}
        share["x"] = i
        share["y"] = _ss_eval(coeffs, i)
        push(shares, share)
        i += 1
    shares

// ss_combine(shares, threshold) -> reconstructed secret_int, via Lagrange interpolation at x=0
// using the first min(threshold, len(shares)) shares. Shares must have distinct x values.
fn ss_combine(shares: any, threshold: int) -> int
    let k = threshold
    if k > len(shares)
        k = len(shares)
    if k <= 0
        return 0
    let secret = 0
    for i in 0..k
        let xi = shares[i]["x"]
        let yi = shares[i]["y"]
        let num = 1
        let den = 1
        let j = 0
        while j < k
            if j != i
                let xj = shares[j]["x"]
                num = _ss_mulmod(num, _ss_mod(0 - xj))
                den = _ss_mulmod(den, _ss_mod(xi - xj))
            j += 1
        let li = _ss_mulmod(num, _ss_modinv(den))
        secret = _ss_mod(secret + _ss_mulmod(yi, li))
    secret

// ss_verify_share(share, coeffs) -> bool. Debug/test helper: true iff share["y"] matches the
// polynomial defined by coeffs evaluated at share["x"]. Not part of the reconstruction protocol
// (real Shamir sharing has no coeffs available post-split) -- useful for KATs and property tests.
fn ss_verify_share(share: any, coeffs: any) -> bool
    _ss_eval(coeffs, share["x"]) == share["y"]
