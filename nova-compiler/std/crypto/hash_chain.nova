// std/crypto/hash_chain -- SHA-256 hash chains (Lamport / S/KEY style one-time-password chains).
//
// A hash chain of length n from a seed is: h[0] = SHA256(seed), h[i] = SHA256(h[i-1]) for
// i = 1..n-1. h[n-1] (the "anchor") is published/trusted once; each h[i] going backward from
// there authenticates itself by hashing forward to the previously-trusted value -- this is the
// basis of S/KEY and of Lamport one-time signatures' hash-chain public keys.
//
// All chain elements are 64-char lowercase hex strings (plain text, no embedded NUL), so the
// ordinary string-based `sha256` builtin is binary-safe here -- no byte-list machinery needed
// (contrast with std/crypto/hkdf and std/crypto/pbkdf2, whose RFC test vectors have embedded
// 0x00 bytes; hash-chain seeds/hashes never do).
//
// LEAF -- imports nothing.

// hc_build(seed, n) -> list of n hex hashes: [SHA256(seed), SHA256(h[0]), ..., SHA256(h[n-2])].
// n <= 0 returns an empty list.
fn hc_build(seed: string, n: int) -> any
    let chain = []
    if n <= 0
        return chain
    let h = sha256(seed)
    push(chain, h)
    let i = 1
    while i < n
        h = sha256(h)
        push(chain, h)
        i = i + 1
    chain

// hc_at(chain, i) -> the hash at index i, or "" if i is out of bounds (bounds-checked read).
fn hc_at(chain: any, i: int) -> string
    if i < 0
        return ""
    if i >= len(chain)
        return ""
    chain[i]

// hc_verify(chain) -> bool. Checks internal forward-consistency: chain[i] == SHA256(chain[i-1])
// for every i > 0. An empty or single-element chain is trivially consistent. This does NOT
// check chain[0] against a seed (the chain alone doesn't carry one) -- use
// hc_verify_against_seed for that.
fn hc_verify(chain: any) -> bool
    let n = len(chain)
    let i = 1
    while i < n
        if sha256(chain[i - 1]) != chain[i]
            return false
        i = i + 1
    true

// hc_verify_against_seed(seed, chain) -> bool. Like hc_verify, but also checks chain[0] == SHA256(seed).
fn hc_verify_against_seed(seed: string, chain: any) -> bool
    if len(chain) == 0
        return true
    if sha256(seed) != chain[0]
        return false
    hc_verify(chain)

// hc_anchor(chain) -> the last (trust-anchor) hash of the chain, or "" if empty.
fn hc_anchor(chain: any) -> string
    let n = len(chain)
    if n == 0
        return ""
    chain[n - 1]

// hc_verify_step(candidate, trusted, steps) -> bool. S/KEY-style single-step authentication:
// true iff hashing `candidate` forward `steps` times reaches `trusted` (so revealing `candidate`
// at chain position k authenticates against a trust anchor at position k+steps without either
// party needing the full chain).
fn hc_verify_step(candidate: string, trusted: string, steps: int) -> bool
    if steps < 0
        return false
    let h = candidate
    let i = 0
    while i < steps
        h = sha256(h)
        i = i + 1
    h == trusted
