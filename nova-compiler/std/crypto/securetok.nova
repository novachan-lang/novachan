// std/crypto/securetok — secure token generation (deterministic from seed) + constant-time compare.
// All token generators are deterministic given a seed so KATs are reproducible.
// Uses a splitmix64-inspired PRNG: each step mixes a 64-bit state and returns a new state + value.

// Advance splitmix64 state and return next 64-bit pseudo-random value.
// Returns a dict {"v": int, "s": int} — v is the output, s is the next state.
fn _sm_next(state: int) -> any
    let s = (state + 0x9E3779B97F4A7C15) & 0xFFFFFFFFFFFFFFFF
    let z = s
    let t1 = (z ^ ((z >> 30) & 0x3FFFFFFFF)) & 0xFFFFFFFFFFFFFFFF
    z = (t1 * 0xBF58476D1CE4E5B9) & 0xFFFFFFFFFFFFFFFF
    let t2 = (z ^ ((z >> 27) & 0x1FFFFFFFFF)) & 0xFFFFFFFFFFFFFFFF
    z = (t2 * 0x94D049BB133111EB) & 0xFFFFFFFFFFFFFFFF
    let t3 = (z ^ ((z >> 31) & 0x1FFFFFFFF)) & 0xFFFFFFFFFFFFFFFF
    let out = {}
    out["v"] = t3
    out["s"] = s
    out

// Extract a byte 0..255 from a 64-bit splitmix64 output (low byte).
fn _sm_byte(state: int) -> any
    let r = _sm_next(state)
    let ns = r["s"]
    let bv = r["v"] & 0xFF
    let out = {}
    out["b"] = bv
    out["s"] = ns
    out

// stok_hex(nbytes, seed) -> lowercase hex string of nbytes random bytes, length nbytes*2.
fn stok_hex(nbytes: int, seed: int) -> string
    let digs = "0123456789abcdef"
    let out = ""
    let state = seed
    for i in 0..nbytes
        let r = _sm_byte(state)
        state = r["s"]
        let b = r["b"]
        let hi = (b >> 4) & 0xF
        let lo = b & 0xF
        out = out + char_at(digs, hi) + char_at(digs, lo)
    out

// stok_alnum(nchars, seed) -> alphanumeric string of length nchars from [0-9A-Za-z] (62 chars).
fn stok_alnum(nchars: int, seed: int) -> string
    let alpha = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
    let out = ""
    let state = seed
    for i in 0..nchars
        let r = _sm_next(state)
        state = r["s"]
        let idx = r["v"] & 0x7FFFFFFFFFFFFFFF
        let c = char_at(alpha, idx % 62)
        out = out + c
    out

// stok_urlsafe(nbytes, seed) -> base64url chars [A-Za-z0-9-_] of length nbytes (no padding).
fn stok_urlsafe(nbytes: int, seed: int) -> string
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    let out = ""
    let state = seed
    for i in 0..nbytes
        let r = _sm_next(state)
        state = r["s"]
        let idx = r["v"] & 0x7FFFFFFFFFFFFFFF
        let c = char_at(alpha, idx % 64)
        out = out + c
    out

// stok_numeric(ndigits, seed) -> string of ndigits decimal digits [0-9].
fn stok_numeric(ndigits: int, seed: int) -> string
    let digs = "0123456789"
    let out = ""
    let state = seed
    for i in 0..ndigits
        let r = _sm_next(state)
        state = r["s"]
        let idx = r["v"] & 0x7FFFFFFFFFFFFFFF
        let c = char_at(digs, idx % 10)
        out = out + c
    out

// stok_ct_eq(a, b) -> bool: constant-time string equality — delegates to the C runtime builtin
// (optnone, immune to -O2 transforming into short-circuiting memcmp).
fn stok_ct_eq(a: string, b: string) -> bool
    ct_eq(a, b) == 1

// stok_ct_bytes_eq(a, b) -> bool: constant-time equality for byte-lists (lists of ints 0..255).
fn stok_ct_bytes_eq(a: any, b: any) -> bool
    let la = len(a)
    let lb = len(b)
    if la != lb
        return false
    let acc = 0
    for i in 0..la
        acc = acc | (a[i] ^ b[i])
    acc == 0

// stok_is_hex(s) -> bool: true iff every char in s is in [0-9a-fA-F].
fn stok_is_hex(s: string) -> bool
    let n = len(s)
    if n == 0
        return true
    for i in 0..n
        let c = ord(char_at(s, i))
        let ok = false
        if c >= 48 and c <= 57
            ok = true
        if c >= 65 and c <= 70
            ok = true
        if c >= 97 and c <= 102
            ok = true
        if not ok
            return false
    true

// stok_mask(s, visible) -> string: replace all but the last `visible` chars with '*'.
fn stok_mask(s: string, visible: int) -> string
    let n = len(s)
    let stars = n - visible
    if stars < 0
        stars = 0
    let out = ""
    let i = 0
    while i < stars
        out = out + "*"
        i = i + 1
    i = stars
    while i < n
        out = out + char_at(s, i)
        i = i + 1
    out

// stok_len_hex(nbytes) -> int: byte count to hex string length (always nbytes*2).
fn stok_len_hex(nbytes: int) -> int
    nbytes * 2

// stok_entropy_bits(nchars, charset_size) -> float: Shannon entropy in bits = nchars * log2(charset_size).
// Uses log builtin (natural log): log2(x) = log(x) / log(2).
fn stok_entropy_bits(nchars: int, charset_size: float) -> float
    let ln2 = 0.6931471805599453
    let logc = log(charset_size)
    let log2c = logc / ln2
    let result = nchars * 1.0 * log2c
    result
