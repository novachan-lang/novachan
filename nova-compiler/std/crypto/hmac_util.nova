// std/crypto/hmac_util -- thin, safe wrappers around the HMAC-SHA256 builtin: verification,
// truncation (RFC 2104 section 5), and truncated-MAC verification.
//
// Inputs here are ordinary text keys/messages and lowercase hex MACs -- none of them are
// expected to carry embedded 0x00 bytes, so the plain string-based `hmac_sha256`/`ct_eq`
// builtins are the right (and simplest) tool. For binary-exact keys/messages that may contain
// arbitrary bytes, build the MAC with std/crypto/hkdf's or std/crypto/pbkdf2's byte-list HMAC
// core instead.
//
// LEAF -- imports nothing.

// hu_mac(key, msg) -> 64-char lowercase hex HMAC-SHA256. Thin, named wrapper for symmetry
// with hu_verify/hu_truncate below.
fn hu_mac(key: string, msg: string) -> string
    hmac_sha256(key, msg)

// hu_verify(key, msg, expected_mac) -> bool. Recomputes HMAC-SHA256(key, msg) and compares to
// expected_mac using the runtime's constant-time comparator (ct_eq is optnone -- immune to
// -O2 turning the comparison into a short-circuiting memcmp).
fn hu_verify(key: string, msg: string, expected_mac: string) -> bool
    let got = hmac_sha256(key, msg)
    ct_eq(got, expected_mac) == 1

// hu_truncate(mac, n_bytes) -> the first n_bytes of `mac` (a hex string), re-hex-encoded.
// n_bytes is clamped to [0, len(mac)/2]. RFC 2104 section 5 requires n_bytes >= 10 and
// recommends n_bytes >= half the underlying hash length (16 for SHA-256) -- see
// hu_is_recommended_length below; this function itself does not enforce that, it just truncates.
fn hu_truncate(mac: string, n_bytes: int) -> string
    let max_bytes = len(mac) / 2
    let n = n_bytes
    if n < 0
        n = 0
    if n > max_bytes
        n = max_bytes
    slice(mac, 0, n * 2)

// hu_is_recommended_length(n_bytes) -> bool. RFC 2104 section 5: a truncated MAC must be at
// least 10 bytes (80 bits) and SHOULD be at least half the hash length (16 bytes for SHA-256).
fn hu_is_recommended_length(n_bytes: int) -> bool
    n_bytes >= 16

// hu_verify_truncated(key, msg, expected_truncated) -> bool. Verifies a MAC that was truncated
// to len(expected_truncated)/2 bytes (RFC 2104 truncated-MAC verification: recompute the full
// MAC, truncate it to the SAME length, then constant-time compare -- never compare full-length
// MACs against a short one).
fn hu_verify_truncated(key: string, msg: string, expected_truncated: string) -> bool
    let n_bytes = len(expected_truncated) / 2
    if n_bytes <= 0
        return false
    let full = hmac_sha256(key, msg)
    let got = hu_truncate(full, n_bytes)
    ct_eq(got, expected_truncated) == 1
