// std/crypto/kdf_context -- context-bound key derivation: separate keys for separate purposes
// from one master secret, via the HKDF pattern (RFC 5869; see std/crypto/hkdf, which this
// module is built on -- cross-module imports within std/crypto are an established pattern, see
// std/crypto/argon2id importing std/crypto/blake2b).
//
// This is the standard "key separation" technique: never use one raw secret directly for
// multiple purposes (e.g. both "encrypt session tokens" and "sign webhook payloads"); instead
// derive a distinct sub-key per (purpose, generation) pair via HKDF-Expand, keyed off a single
// PRK extracted from the master secret. Because HKDF-Expand's `info` parameter is exactly a
// domain-separation tag, binding it to `context_label + "#" + counter` means every
// (label, counter) pair yields an independent-looking key, and rotating a purpose's key is just
// bumping its counter -- no need to touch the master secret or any other purpose's keys.
//
// Depends on: std/crypto/hkdf.

import std/crypto/hkdf

// PRIVATE: hex-encode plain ASCII text (context labels are human-chosen strings, not attacker
// binary data, so this ord()-per-char encoding -- not a byte-list -- is the right, simple tool).
fn _kc_str_to_hex(s: string) -> string
    let digs = "0123456789abcdef"
    let out_parts = []
    for i in 0..len(s)
        let b = ord(char_at(s, i))
        push(out_parts, char_at(digs, (b >> 4) & 0xF) + char_at(digs, b & 0xF))
    let out = join(out_parts, "")
    out

// PRIVATE: the HKDF `info` for a given (context_label, counter): hex("<label>#<counter>").
// Distinct labels or counters always hex-encode to distinct byte strings (the "#" separator
// can't appear inside str(counter), and a label containing "#" just shifts where later digits
// fall -- HKDF's info is a domain tag, not a parsed structure, so that's harmless).
fn _kc_info_hex(context_label: string, counter: int) -> string
    _kc_str_to_hex(context_label + "#" + str(counter))

// kc_derive(master_hex, context_label, counter) -> a 32-byte derived key, as 64 hex chars.
// Same (master_hex, context_label, counter) always yields the same key; changing any one of
// the three yields an independent-looking key.
fn kc_derive(master_hex: string, context_label: string, counter: int) -> string
    let prk = hk_extract("", master_hex)
    hk_expand(prk, _kc_info_hex(context_label, counter), 32)

// kc_derive_len(master_hex, context_label, counter, length) -> a `length`-byte derived key, as
// (length*2) hex chars. Like kc_derive but for callers that need a key length other than 32.
fn kc_derive_len(master_hex: string, context_label: string, counter: int, length: int) -> string
    let prk = hk_extract("", master_hex)
    hk_expand(prk, _kc_info_hex(context_label, counter), length)

// kc_rotate(master_hex, context_label, counter) -> the NEXT generation's derived key for this
// context (counter + 1). Rotating a purpose's key this way requires no coordination with any
// other purpose's keys or with the master secret itself.
fn kc_rotate(master_hex: string, context_label: string, counter: int) -> string
    kc_derive(master_hex, context_label, counter + 1)
