// std/crypto/discrete_log.nova — Discrete logarithm via Baby-Step Giant-Step
// (Shanks' algorithm): given g, h, prime p, find the smallest x >= 0 such
// that g^x === h (mod p), or -1 if no such x exists in the searched range.
// LEAF — imports nothing.
//
// Public API (prefix dlog_):
//   dlog_pow_mod(base, exp, mod)   -> int  modular exponentiation
//   dlog_mod_inverse(a, p)         -> int  modular inverse of a mod prime p
//                                          (via Fermat's little theorem)
//   dlog_bsgs(g, h, p)             -> int  smallest x in [0, p-2] with
//                                          g^x === h (mod p), or -1 if none found
//   dlog_verify(g, x, h, p)        -> bool true iff g^x === h (mod p)
//
// ALGORITHM: BSGS solves g^x = h (mod p) in O(sqrt(p)) by writing
// x = i*m + j with m = ceil(sqrt(p-1)). Precompute a "baby step" table of
// g^j for j in [0,m). Then for each "giant step" i, test whether
// h * (g^-m)^i lands in the baby-step table; if g^j == h*(g^-m)^i then
// x = i*m + j solves g^x = h.
//
// KNOWN ANSWERS (hand-verified):
//   dlog_pow_mod(2, 10, 1000)   = 24        (1024 mod 1000)
//   dlog_pow_mod(3, 0, 7)       = 1
//   dlog_mod_inverse(3, 7)      = 5         (3*5 = 15 === 1 mod 7)
//   dlog_mod_inverse(1, 13)     = 1
//   dlog_bsgs(5, 8, 23)         = 6         (5^6 = 15625 === 8 mod 23; verified by
//                                            direct enumeration 5^0..5^6 mod 23)
//   dlog_bsgs(2, 3, 7)          = -1        (subgroup generated by 2 mod 7 is
//                                            {1,2,4}; 3 is never reached)
//   dlog_verify(5, 6, 8, 23)    = true

// dlog_pow_mod — (base^exp) mod m via binary exponentiation. exp >= 0, m >= 1.
fn dlog_pow_mod(base, exp, m)
    if m == 1
        return 0
    let result = 1
    let b = base % m
    if b < 0
        b = b + m
    let e = exp
    while e > 0
        if e % 2 == 1
            result = (result * b) % m
        b = (b * b) % m
        e = e / 2
    return result

// dlog_mod_inverse — modular inverse of a mod prime p, via Fermat's little
// theorem: a^(p-2) === a^-1 (mod p).
fn dlog_mod_inverse(a, p)
    return dlog_pow_mod(a, p - 2, p)

// _dlog_ceil_sqrt — smallest integer m with m*m >= n (n >= 0).
fn _dlog_ceil_sqrt(n)
    let m = int(sqrt(float(n)))
    while m * m < n
        m = m + 1
    while m > 0 and (m - 1) * (m - 1) >= n
        m = m - 1
    return m

// dlog_bsgs — smallest x in [0, p-2] with g^x === h (mod p), or -1 if none
// is found by the search (assumes p is prime).
fn dlog_bsgs(g, h, p)
    let n = p - 1
    let m = _dlog_ceil_sqrt(n)
    if m < 1
        m = 1
    // Baby steps: babyvals[j] = g^j mod p, for j in [0, m).
    let babyvals = []
    let j = 0
    let cur_g = 1
    while j < m
        push(babyvals, cur_g)
        cur_g = (cur_g * g) % p
        j = j + 1
    // Giant step factor: (g^-1)^m mod p.
    let ginv = dlog_mod_inverse(g, p)
    let factor = dlog_pow_mod(ginv, m, p)
    let cur = h % p
    if cur < 0
        cur = cur + p
    for i in 0..m
        let idx = -1
        let k = 0
        while k < m
            if babyvals[k] == cur
                idx = k
            k = k + 1
        if idx != -1
            return i * m + idx
        cur = (cur * factor) % p
    return -1

// dlog_verify — true iff g^x === h (mod p).
fn dlog_verify(g, x, h, p)
    let lhs = dlog_pow_mod(g, x, p)
    let rhs = h % p
    if rhs < 0
        rhs = rhs + p
    return lhs == rhs
