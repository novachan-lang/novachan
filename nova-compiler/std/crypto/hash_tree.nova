// std/crypto/hash_tree -- SHA-256 Merkle tree with inclusion proofs (RFC 6962-style domain
// separation: leaf tag "0", internal-node tag "1"; odd-width levels duplicate the last node,
// Bitcoin-style, to pair with itself).
//
// This differs from std/crypto/merkle (which uses a private 63-bit polynomial hash, chosen
// there to keep that module allocation-free and dependency-free) by using the REAL SHA-256
// builtin, giving genuine cryptographic collision resistance -- the right choice when the tree
// is meant to be an actual authenticated data structure (transparency logs, certificate
// chains, content-addressed storage) rather than a fast structural checksum.
//
// All hashes are 64-char lowercase hex strings (plain ASCII, never embeds NUL), so the ordinary
// string-based `sha256` builtin is binary-safe here.
//
// LEAF -- imports nothing.

// PRIVATE: leaf hash = SHA256("0" || leaf).
fn _ht_leaf_hash(leaf: string) -> string
    sha256("0" + leaf)

// PRIVATE: internal node hash = SHA256("1" || left_hex || right_hex).
fn _ht_node_hash(left_hex: string, right_hex: string) -> string
    sha256("1" + left_hex + right_hex)

// PRIVATE: build one level up from a list of hex hashes (duplicating the last if odd count).
fn _ht_next_level(level: any) -> any
    let out = []
    let n = len(level)
    let i = 0
    while i < n
        let left = level[i]
        let right = ""
        if i + 1 < n
            right = level[i + 1]
        else
            right = level[i]
        push(out, _ht_node_hash(left, right))
        i += 2
    out

// PRIVATE: full level-by-level tree; levels[0] = leaf hashes, levels[last] = [root].
// Empty input returns an empty list of levels.
fn _ht_build_levels(leaves: any) -> any
    let n = len(leaves)
    let levels = []
    if n == 0
        return levels
    let leaf_level = [_ht_leaf_hash(leaves[i]) for i in 0..n]
    push(levels, leaf_level)
    let cur = leaf_level
    while len(cur) > 1
        cur = _ht_next_level(cur)
        push(levels, cur)
    levels

// ht_build(leaves) -> root hex hash. A single leaf's root is its leaf hash.
// An empty leaf list returns SHA256("") (the empty-tree convention).
fn ht_build(leaves: any) -> string
    if len(leaves) == 0
        return sha256("")
    let levels = _ht_build_levels(leaves)
    let top = levels[len(levels) - 1]
    top[0]

// ht_proof(leaves, index) -> inclusion proof: a list of {"hash": sibling_hex, "right": bool}
// steps from the leaf level up toward the root. "right": true means the sibling sits to the
// RIGHT of the current node (so combine as node_hash(cur, sibling)); false means combine as
// node_hash(sibling, cur).
fn ht_proof(leaves: any, index: int) -> any
    let levels = _ht_build_levels(leaves)
    let proof = []
    let idx = index
    for lv in 0..(len(levels) - 1)
        let level = levels[lv]
        let n = len(level)
        let sibling = ""
        let is_right = false
        if idx % 2 == 0
            if idx + 1 < n
                sibling = level[idx + 1]
            else
                sibling = level[idx]
            is_right = true
        else
            sibling = level[idx - 1]
            is_right = false
        let step = {}
        step["hash"] = sibling
        step["right"] = is_right
        push(proof, step)
        idx = idx / 2
    proof

// ht_verify(root, leaf, proof, index) -> bool. Recomputes the root from leaf + proof and
// compares to `root` (plain == on hex strings -- Merkle proof verification is not a secret
// comparison, so constant-time equality is not required here).
fn ht_verify(root: string, leaf: string, proof: any, index: int) -> bool
    let cur = _ht_leaf_hash(leaf)
    for i in 0..len(proof)
        let step = proof[i]
        if step["right"]
            cur = _ht_node_hash(cur, step["hash"])
        else
            cur = _ht_node_hash(step["hash"], cur)
    cur == root
