// std/complex/complex_convert.nova — Construction, conversion, and display of complex integers.
// Representation: z = [re, im] where re, im are integers. All operations are EXACT.
// PREFIX: cxc_   LEAF — imports nothing.
//
// Public API:
//   cxc_from_real(r)      -> list    embed integer r as complex [r, 0]
//   cxc_to_string(z)      -> string  format z (e.g. '3-2i', 'i', '-i', '5', '0')
//   cxc_is_real(z)        -> bool    imaginary part is zero
//   cxc_is_imaginary(z)   -> bool    real part is zero AND imaginary part is non-zero
//   cxc_is_zero(z)        -> bool    both parts are zero
//   cxc_equal(a, b)       -> bool    component-wise equality

// cxc_from_real — embed integer r as complex [r, 0].
fn cxc_from_real(r) -> any
    let result = [r, 0]
    result

// cxc_to_string — format complex integer z as a human-readable string.
// Rules: drop coefficient 1 on 'i'; format negative imaginary as '-' not '+-';
// pure-real -> str(re); pure-imag -> 'i', '-i', str(im)+'i'; zero -> '0'.
fn cxc_to_string(z) -> string
    let re = z[0]
    let im = z[1]
    if re == 0 and im == 0
        return "0"
    if im == 0
        return str(re)
    if re == 0
        if im == 1
            return "i"
        if im == 0 - 1
            return "-i"
        let s = str(im) + "i"
        return s
    let rs = str(re)
    let result = rs
    if im > 0
        if im == 1
            result = rs + "+i"
        if im != 1
            result = rs + "+" + str(im) + "i"
    if im < 0
        if im == 0 - 1
            result = rs + "-i"
        if im != 0 - 1
            let abs_im = 0 - im
            result = rs + "-" + str(abs_im) + "i"
    result

// cxc_is_real — true iff the imaginary part of z is zero.
fn cxc_is_real(z) -> bool
    z[1] == 0

// cxc_is_imaginary — true iff re==0 and im!=0.
fn cxc_is_imaginary(z) -> bool
    z[0] == 0 and z[1] != 0

// cxc_is_zero — true iff both re and im are zero.
fn cxc_is_zero(z) -> bool
    z[0] == 0 and z[1] == 0

// cxc_equal — component-wise equality of two complex integers.
fn cxc_equal(a, b) -> bool
    a[0] == b[0] and a[1] == b[1]
