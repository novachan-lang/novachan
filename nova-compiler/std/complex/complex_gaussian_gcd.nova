// std/complex/complex_gaussian_gcd.nova — Euclidean algorithm for Gaussian integers Z[i].
// LEAF — imports NOTHING.
//
// A Gaussian integer is a 2-element list [re, im] of int.
// The Euclidean algorithm works because Z[i] has a norm function N(a+bi) = a^2 + b^2
// that is multiplicative and N(r) < N(b) for the remainder in cxg_divmod.
//
// Public API (prefix cxg_):
//   cxg_norm(z)          -> int    squared-magnitude a^2 + b^2
//   cxg_divmod(a, b)     -> list   [q, r] where q,r are [re,im] and a = q*b + r, N(r)<N(b)
//   cxg_gcd_norm(a, b)   -> int    norm of a GCD of a and b in Z[i] (well-defined up to units)

// _cxg_round — round an integer numerator/denominator pair to nearest integer.
// Used internally to snap the quotient components to the nearest Gaussian integer.
fn _cxg_round(num: int, den: int) -> int
    let q = num / den
    let r = num % den
    let r2 = r
    if r2 < 0
        r2 = 0 - r2
    let den2 = den
    if den2 < 0
        den2 = 0 - den2
    let twice_r = r2 * 2
    if twice_r > den2
        if num >= 0
            q += 1
        else
            q -= 1
    q

// _cxg_mul — multiply two Gaussian integers: [a,b]*[c,d] = [a*c-b*d, a*d+b*c].
fn _cxg_mul(a: list, b: list) -> list
    let ar = a[0]
    let ai = a[1]
    let br = b[0]
    let bi = b[1]
    let out = []
    push(out, ar * br - ai * bi)
    push(out, ar * bi + ai * br)
    out

// _cxg_sub — subtract two Gaussian integers: [a,b] - [c,d] = [a-c, b-d].
fn _cxg_sub(a: list, b: list) -> list
    let out = []
    push(out, a[0] - b[0])
    push(out, a[1] - b[1])
    out

// cxg_norm — squared-magnitude of a Gaussian integer: N(a+bi) = a^2 + b^2.
fn cxg_norm(z: list) -> int
    z[0] * z[0] + z[1] * z[1]

// cxg_divmod — Euclidean division in Z[i]: given a, b returns [q, r] where
// a = q*b + r and N(r) < N(b). Each quotient component is rounded to nearest int.
fn cxg_divmod(a: list, b: list) -> list
    let ar = a[0]
    let ai = a[1]
    let br = b[0]
    let bi = b[1]
    // (a+bi)/(c+di) = (a+bi)(c-di) / (c^2+d^2)
    // numerator real part: ar*br + ai*bi
    // numerator imag part: ai*br - ar*bi
    let nb = br * br + bi * bi
    let nr = ar * br + ai * bi
    let ni = ai * br - ar * bi
    let qr = _cxg_round(nr, nb)
    let qi = _cxg_round(ni, nb)
    let q = []
    push(q, qr)
    push(q, qi)
    // r = a - q*b
    let qb = _cxg_mul(q, b)
    let r = _cxg_sub(a, qb)
    let out = []
    push(out, q)
    push(out, r)
    out

// cxg_gcd_norm — norm of a Gaussian GCD of a and b via Euclidean algorithm.
// The GCD in Z[i] is defined only up to multiplication by a unit {1,-1,i,-i},
// but its norm N(gcd) is uniquely determined. Returns that norm.
// gcd(0,0) = 0 by convention (norm 0).
fn cxg_gcd_norm(a: list, b: list) -> int
    let u = []
    push(u, a[0])
    push(u, a[1])
    let v = []
    push(v, b[0])
    push(v, b[1])
    while cxg_norm(v) != 0
        let dm = cxg_divmod(u, v)
        let r = dm[1]
        u = v
        v = r
    cxg_norm(u)
