// std/complex/complex_norm.nova — Norm/magnitude utilities for integer complex numbers.
// LEAF — imports NOTHING.
//
// Representation: complex number = [re, im] (integers).
// All operations are exact integer arithmetic (no floating point).
//
// Public API (prefix cxn_):
//   cxn_norm_sq(z)          -> int   |z|^2 = re^2 + im^2 (exact integer)
//   cxn_is_zero(z)          -> bool  true iff z == 0+0i
//   cxn_compare_abs(z1, z2) -> int   -1 / 0 / 1 by comparing |z1| vs |z2| (via norm_sq)
//   cxn_is_unit(z)          -> bool  true iff |z|^2 == 1 (i.e. z in {1,-1,i,-i})

// cxn_norm_sq — squared magnitude: re^2 + im^2 (exact integer, never negative).
fn cxn_norm_sq(z: list) -> int
    z[0] * z[0] + z[1] * z[1]

// cxn_is_zero — true iff both components are zero.
fn cxn_is_zero(z: list) -> bool
    z[0] == 0 and z[1] == 0

// cxn_compare_abs — compare magnitudes of z1 and z2 using norm_sq (avoids sqrt).
// Returns -1 if |z1| < |z2|, 0 if equal, 1 if |z1| > |z2|.
fn cxn_compare_abs(z1: list, z2: list) -> int
    let n1 = cxn_norm_sq(z1)
    let n2 = cxn_norm_sq(z2)
    if n1 < n2
        return -1
    if n1 > n2
        return 1
    0

// cxn_is_unit — true iff |z|^2 == 1 (the Gaussian integer units: 1, -1, i, -i).
fn cxn_is_unit(z: list) -> bool
    cxn_norm_sq(z) == 1
