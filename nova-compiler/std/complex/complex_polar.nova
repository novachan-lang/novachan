// std/complex/complex_polar.nova — Polar/norm properties of complex integers.
// Representation: z = [re, im] where re, im are integers.
// norm_sq and quadrant are EXACT; magnitude uses sqrt (float).
// PREFIX: cxpl_   LEAF — imports nothing.
//
// Public API:
//   cxpl_norm_sq(z)    -> int    exact squared norm: re^2 + im^2
//   cxpl_magnitude(z)  -> float  sqrt(re^2 + im^2) — the ONE float function
//   cxpl_quadrant(z)   -> int    1/2/3/4 for quadrants; 0 for origin;
//                                axis points go to CCW-next quadrant:
//                                +real axis -> Q1, +imag axis -> Q2,
//                                -real axis -> Q3, -imag axis -> Q4.

// cxpl_norm_sq — exact integer squared norm: re^2 + im^2.
fn cxpl_norm_sq(z) -> int
    let re = z[0]
    let im = z[1]
    re * re + im * im

// cxpl_magnitude — float magnitude sqrt(re^2 + im^2).
// Binds intermediate to named lets to avoid float-slot codegen hazard.
fn cxpl_magnitude(z) -> float
    let re = z[0]
    let im = z[1]
    let nsq = re * re + im * im
    let nsqf = nsq * 1.0
    let mag = sqrt(nsqf)
    mag

// cxpl_quadrant — quadrant classification with axis-point convention.
// Returns 0 for origin, 1 for Q1 (re>0,im>=0 axis included), 2 for Q2 (re<=0 axis, im>0),
// 3 for Q3 (re<0,im<=0 axis), 4 for Q4 (re>=0 axis, im<0).
// Axis convention: +real axis (im=0,re>0) -> Q1; +imag axis (re=0,im>0) -> Q2;
//                  -real axis (im=0,re<0) -> Q3; -imag axis (re=0,im<0) -> Q4.
fn cxpl_quadrant(z) -> int
    let re = z[0]
    let im = z[1]
    if re == 0 and im == 0
        return 0
    let result = 1
    if re > 0 and im >= 0
        result = 1
    if re <= 0 and im > 0
        result = 2
    if re < 0 and im <= 0
        result = 3
    if re >= 0 and im < 0
        result = 4
    result
