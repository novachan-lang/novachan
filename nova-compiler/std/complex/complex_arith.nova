// std/complex/complex_arith.nova — Basic arithmetic on integer complex numbers.
// LEAF — imports NOTHING.
//
// Representation: complex number = [re, im] where re, im are integers.
// i*i = -1, so (a+bi)(c+di) = [a*c - b*d, a*d + b*c].
//
// Public API (prefix cx_):
//   cx_add(a, b)     -> list   a + b
//   cx_sub(a, b)     -> list   a - b
//   cx_mul(a, b)     -> list   a * b
//   cx_neg(a)        -> list   -a (additive inverse)
//   cx_conj(a)       -> list   complex conjugate (re, -im)
//   cx_scale(a, s)   -> list   scalar multiply: a * s (s is a real integer)

// cx_add — add two integer complex numbers: [a0+b0, a1+b1].
fn cx_add(a: list, b: list) -> list
    [a[0] + b[0], a[1] + b[1]]

// cx_sub — subtract two integer complex numbers: [a0-b0, a1-b1].
fn cx_sub(a: list, b: list) -> list
    [a[0] - b[0], a[1] - b[1]]

// cx_mul — multiply two integer complex numbers: (a+bi)(c+di)=[ac-bd, ad+bc].
fn cx_mul(a: list, b: list) -> list
    let re = a[0] * b[0] - a[1] * b[1]
    let im = a[0] * b[1] + a[1] * b[0]
    [re, im]

// cx_neg — additive inverse of a complex number: [-re, -im].
fn cx_neg(a: list) -> list
    [-a[0], -a[1]]

// cx_conj — complex conjugate: [re, -im].
fn cx_conj(a: list) -> list
    [a[0], -a[1]]

// cx_scale — multiply a complex number by a real integer scalar s: [re*s, im*s].
fn cx_scale(a: list, s: int) -> list
    [a[0] * s, a[1] * s]
