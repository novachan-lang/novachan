// std/complex/complex_gaussian_prime.nova — Gaussian prime classification in Z[i].
// LEAF — imports NOTHING.
//
// A Gaussian integer z = a + bi is a Gaussian prime iff:
//   1. If one of a, b is 0 and the other is non-zero: |a| or |b| must be a rational
//      prime p with p ≡ 3 (mod 4).
//   2. If both a, b are non-zero: N(z) = a^2 + b^2 must be a rational prime.
//      (This covers all primes ≡ 1 mod 4, plus the case p=2 = N(1+i).)
//
// Public API (prefix cxgp_):
//   cxgp_norm_is_prime(z) -> bool   is N(z) = a^2+b^2 a rational prime?
//   cxgp_is_prime(z)      -> bool   is z a Gaussian prime?

// _cxgp_is_rat_prime — trial-division rational prime test for small n >= 2.
fn _cxgp_is_rat_prime(n: int) -> bool
    if n < 2
        return false
    if n == 2
        return true
    if n % 2 == 0
        return false
    let i = 3
    while i * i <= n
        if n % i == 0
            return false
        i = i + 2
    true

// cxgp_norm_is_prime — true iff N(z) = re^2 + im^2 is a rational prime.
fn cxgp_norm_is_prime(z: list) -> bool
    let re = z[0]
    let im = z[1]
    let n = re * re + im * im
    _cxgp_is_rat_prime(n)

// cxgp_is_prime — true iff z is a Gaussian prime.
// Handles: [0,0] and units are not prime. Both-nonzero: norm prime. One-zero: |other| is p≡3 mod 4.
fn cxgp_is_prime(z: list) -> bool
    let re = z[0]
    let im = z[1]
    // check for zero or unit: norm <= 1 means not prime
    let n = re * re + im * im
    if n <= 1
        return false
    if re == 0
        // purely imaginary: |im| must be a rational prime ≡ 3 mod 4
        let av = im
        if av < 0
            av = 0 - av
        if not _cxgp_is_rat_prime(av)
            return false
        return av % 4 == 3
    if im == 0
        // purely real: |re| must be a rational prime ≡ 3 mod 4
        let av2 = re
        if av2 < 0
            av2 = 0 - av2
        if not _cxgp_is_rat_prime(av2)
            return false
        return av2 % 4 == 3
    // both nonzero: Gaussian prime iff the norm is a rational prime
    _cxgp_is_rat_prime(n)
