// std/complex/complex_pow.nova — Integer-power exponentiation for complex numbers.
// Representation: z = [re, im] where re, im are integers. Arithmetic is EXACT.
// PREFIX: cxp_   LEAF — imports nothing.
//
// Public API:
//   cxp_power(z, n)          -> list   z raised to the non-negative integer power n (exact)
//   cxp_is_real_power(z, n)  -> bool   true iff the imaginary part of z^n is zero

// _cxp_mul: private — multiply two complex integers [a,b] * [c,d] = [a*c - b*d, a*d + b*c].
fn _cxp_mul(a, b) -> any
    let ar = a[0]
    let ai = a[1]
    let br = b[0]
    let bi = b[1]
    let re = ar * br - ai * bi
    let im = ar * bi + ai * br
    let result = [re, im]
    result

// cxp_power — z raised to the non-negative integer power n (exact integer arithmetic).
// n==0 returns [1,0]; n==1 returns z unchanged; uses repeated multiplication.
fn cxp_power(z, n) -> any
    if n == 0
        let r = [1, 0]
        return r
    let acc = [1, 0]
    for i in 0..n
        acc = _cxp_mul(acc, z)
    acc

// cxp_is_real_power — true iff z^n has zero imaginary part.
// Uses cxp_power and checks im == 0.
fn cxp_is_real_power(z, n) -> bool
    let p = cxp_power(z, n)
    p[1] == 0
