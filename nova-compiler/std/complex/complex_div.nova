// std/complex/complex_div.nova — Exact rational division of integer complex numbers.
// LEAF — imports NOTHING.
//
// Representation: complex number = [re, im] (integers).
// Division result = [re_num, im_num, den] where the quotient is
//   (re_num + im_num*i) / den, reduced so gcd(|re_num|,|im_num|,den)==1 and den>0.
//
// Algorithm: a/b = a*conj(b) / |b|^2 (exact integer numerator and denominator).
//
// Public API (prefix cxd_):
//   cxd_div(a, b)        -> list  [re_num, im_num, den]  exact quotient a/b
//   cxd_reciprocal(a)    -> list  [re_num, im_num, den]  exact 1/a

// _cxd_gcd — Euclidean GCD on absolute values; gcd(0,n)=n.
fn _cxd_gcd(a: int, b: int) -> int
    let u = a
    if u < 0
        u = 0 - u
    let v = b
    if v < 0
        v = 0 - v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// _cxd_gcd3 — GCD of three values (uses absolute values internally).
fn _cxd_gcd3(a: int, b: int, c: int) -> int
    let g = _cxd_gcd(a, b)
    _cxd_gcd(g, c)

// _cxd_reduce — reduce [rn, in, den] so gcd(|rn|,|in|,den)==1 and den>0.
// den==0 means division by zero; return [0,0,0] sentinel.
fn _cxd_reduce(rn: int, im: int, den: int) -> list
    let bad = []
    push(bad, 0)
    push(bad, 0)
    push(bad, 0)
    if den == 0
        return bad
    // ensure den > 0
    let srn = rn
    let sim = im
    let sd = den
    if sd < 0
        srn = 0 - srn
        sim = 0 - sim
        sd = 0 - sd
    // compute gcd of all three magnitudes
    let arn = srn
    if arn < 0
        arn = 0 - arn
    let aim = sim
    if aim < 0
        aim = 0 - aim
    let g = _cxd_gcd3(arn, aim, sd)
    let out = []
    if g == 0
        push(out, 0)
        push(out, 0)
        push(out, 1)
        return out
    push(out, srn / g)
    push(out, sim / g)
    push(out, sd / g)
    out

// cxd_div — exact division a/b = a*conj(b) / |b|^2, result reduced.
// Returns [0,0,0] if b is zero.
fn cxd_div(a: list, b: list) -> list
    let ar = a[0]
    let ai = a[1]
    let br = b[0]
    let bi = b[1]
    let norm_sq = br * br + bi * bi
    // a * conj(b): (ar+ai*i)*(br-bi*i) = [ar*br+ai*bi, ai*br-ar*bi]
    let rn = ar * br + ai * bi
    let im = ai * br - ar * bi
    _cxd_reduce(rn, im, norm_sq)

// cxd_reciprocal — exact 1/a = conj(a)/|a|^2, result reduced.
// Returns [0,0,0] if a is zero.
fn cxd_reciprocal(a: list) -> list
    let one = []
    push(one, 1)
    push(one, 0)
    cxd_div(one, a)
