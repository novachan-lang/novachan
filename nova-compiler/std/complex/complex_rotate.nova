// std/complex/complex_rotate.nova
// Rotation and reflection operations on Gaussian integers [re, im].
// All operations are exact integer arithmetic.
// LEAF — imports nothing.
//
// Public API (prefix cxrot_):
//   cxrot_by_i(z)        -> [re, im]   multiply by i  (90-degree CCW rotation)
//   cxrot_by_ik(z, k)   -> [re, im]   multiply by i^(k mod 4)
//   cxrot_conj(z)        -> [re, im]   complex conjugate (reflect over real axis)
//   cxrot_by_unit(z, u) -> [re, im]   multiply z by u (general Gaussian integer multiply)

// cxrot_by_i: rotate z by 90 degrees CCW — multiply by i.
// i*(a+bi) = ai + bi^2 = -b + ai
fn cxrot_by_i(z: list) -> list
    return [0 - z[1], z[0]]

// cxrot_by_ik: multiply z by i^k (k taken mod 4).
// i^0=1, i^1=i, i^2=-1, i^3=-i
fn cxrot_by_ik(z: list, k: int) -> list
    let r = k % 4
    if r < 0
        r = r + 4
    if r == 0
        return [z[0], z[1]]
    if r == 1
        return [0 - z[1], z[0]]
    if r == 2
        return [0 - z[0], 0 - z[1]]
    return [z[1], 0 - z[0]]

// cxrot_conj: reflect z over the real axis — negate imaginary part.
fn cxrot_conj(z: list) -> list
    return [z[0], 0 - z[1]]

// cxrot_by_unit: multiply z by u using standard Gaussian integer multiplication.
// (a+bi)(c+di) = (ac-bd) + (ad+bc)i
fn cxrot_by_unit(z: list, u: list) -> list
    let re = z[0] * u[0] - z[1] * u[1]
    let im = z[0] * u[1] + z[1] * u[0]
    return [re, im]
