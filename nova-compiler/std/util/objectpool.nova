// std/util/objectpool.nova
// Object pool of reusable integer handles 0..size-1.
// Prefix: pool_

fn pool_new(size)
    let free = []
    let i = 0
    while i < size
        let dummy = 0
        free.push(i)
        i = i + 1
    let p = {"capacity": size, "free": free, "in_use": 0}
    return p

fn pool_acquire(p)
    let f = p["free"]
    if len(f) == 0
        return 0 - 1
    let handle = pop(f)
    p["in_use"] = p["in_use"] + 1
    return handle

fn pool_release(p, handle)
    let f = p["free"]
    f.push(handle)
    p["in_use"] = p["in_use"] - 1

fn pool_available(p)
    let f = p["free"]
    return len(f)

fn pool_in_use(p)
    return p["in_use"]

fn pool_capacity(p)
    return p["capacity"]
