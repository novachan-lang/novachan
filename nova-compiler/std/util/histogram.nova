// ============================================================================
// NOVA Standard Library — std/util/histogram
// ============================================================================
// Numeric histogram binning over integer value lists.
//
// All bins are equal-width spanning [min(values)..max(values)].
// The maximum value always lands in the LAST bin (closed right edge).
//
// Public API:
//   hist_bins(values: list, nbins: int) -> list
//     Returns a list of nbins ints: the count of values in each bin.
//     Edge case: if all values are equal (range=0), every value goes to bin 0.
//
//   hist_bin_edges(values: list, nbins: int) -> list
//     Returns a list of nbins+1 float edge values.
//     edges[0] = min, edges[nbins] = max.
//
//   hist_max_bin(values: list, nbins: int) -> int
//     Returns the index of the bin with the most values (ties: first wins).
//
//   hist_render(values: list, nbins: int, width: int) -> str
//     Returns a multi-line text bar chart. Each bin is one line of '#' chars
//     scaled so the largest bin occupies exactly `width` chars.

// ── internal helpers ──────────────────────────────────────────────────────────

// Return the minimum value in a non-empty list of ints.
fn _hist_min(values: list) -> int
    let m = values[0]
    let i = 1
    while i < len(values)
        let v = values[i]
        if v < m
            m = v
        i = i + 1
    m

// Return the maximum value in a non-empty list of ints.
fn _hist_max(values: list) -> int
    let m = values[0]
    let i = 1
    while i < len(values)
        let v = values[i]
        if v > m
            m = v
        i = i + 1
    m

// Compute the bin index for a single value given:
//   vmin, range_val (= vmax - vmin), nbins
// Uses scaled integer arithmetic: bin = (v - vmin) * nbins / range_val
// The last bin is closed on the right (value == vmax → bin nbins-1).
fn _hist_bin_index(v: int, vmin: int, range_val: int, nbins: int) -> int
    if range_val == 0
        return 0
    let idx = (v - vmin) * nbins / range_val
    // Clamp: the maximum value gives idx==nbins; place it in the last bin.
    if idx >= nbins
        idx = nbins - 1
    idx

// ── hist_bins ─────────────────────────────────────────────────────────────────
fn hist_bins(values: list, nbins: int) -> list
    // Build a zero-initialised counts list.
    let counts = []
    let k = 0
    while k < nbins
        counts.push(0)
        k = k + 1

    let n = len(values)
    if n == 0
        return counts

    let vmin = _hist_min(values)
    let vmax = _hist_max(values)
    let range_val = vmax - vmin

    let i = 0
    while i < n
        let v = values[i]
        let idx = _hist_bin_index(v, vmin, range_val, nbins)
        counts[idx] = counts[idx] + 1
        i = i + 1

    counts

// ── hist_bin_edges ────────────────────────────────────────────────────────────
// Returns nbins+1 float edge values: edges[j] = vmin + j * bin_width.
fn hist_bin_edges(values: list, nbins: int) -> list
    let edges = []
    let n = len(values)
    if n == 0
        let j = 0
        while j <= nbins
            edges.push(0.0)
            j = j + 1
        return edges

    let vmin = _hist_min(values)
    let vmax = _hist_max(values)
    // bin_width as a float
    let range_f = (vmax - vmin) * 1.0
    let bw = range_f / (nbins * 1.0)
    let vmin_f = vmin * 1.0

    let j = 0
    while j <= nbins
        let edge = vmin_f + bw * (j * 1.0)
        edges.push(edge)
        j = j + 1

    edges

// ── hist_max_bin ──────────────────────────────────────────────────────────────
fn hist_max_bin(values: list, nbins: int) -> int
    let counts = hist_bins(values, nbins)
    let best_idx = 0
    let best_cnt = counts[0]
    let i = 1
    while i < nbins
        let c = counts[i]
        if c > best_cnt
            best_cnt = c
            best_idx = i
        i = i + 1
    best_idx

// ── hist_render ───────────────────────────────────────────────────────────────
// Produces a text bar chart with one line per bin.
// Each line contains a run of '#' characters proportional to the bin's count,
// scaled so the largest bin is exactly `width` chars wide.
// An empty bin produces an empty line.
fn _hist_repeat_char(c: str, n: int) -> str
    let s = ""
    let i = 0
    while i < n
        s = s + c
        i = i + 1
    s

fn hist_render(values: list, nbins: int, width: int) -> str
    let counts = hist_bins(values, nbins)

    // Find the peak count for scaling.
    let peak = 0
    let i = 0
    while i < nbins
        let c = counts[i]
        if c > peak
            peak = c
        i = i + 1

    let lines = []
    let j = 0
    while j < nbins
        let c = counts[j]
        let bar_len = 0
        if peak > 0
            bar_len = c * width / peak
        lines.push(_hist_repeat_char("#", bar_len))
        j = j + 1

    join(lines, "\n")
