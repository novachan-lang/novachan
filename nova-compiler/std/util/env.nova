// ============================================================================
// NOVA Standard Library — env module (std/util/env)
// ============================================================================
// Typed environment-variable getters built on native env(name) and set_env().
//
// Public API:
//   ev_str(name, default)  -> string  raw env value, or default if unset/empty
//   ev_int(name, default)  -> int     parse env as integer, default on failure
//   ev_bool(name, default) -> bool    "1"/"true"/"yes"/"on" -> true,
//                                     "0"/"false"/"no"/"off" -> false,
//                                     anything else -> default
//   ev_has(name)           -> bool    true iff env(name) is non-empty
//
// Parser helpers (also public; useful for unit testing without set_env):
//   ev_parse_int(s, default)  -> int
//   ev_parse_bool(s, default) -> bool

// ── internal helpers ──────────────────────────────────────────────────────────

// Return true iff ch is a decimal digit '0'..'9'.
fn _ev_is_digit(ch: str) -> bool
    let o = ord(ch)
    o >= 48 and o <= 57

// Parse a decimal integer string (may start with '-').
// Returns def on empty string or any non-digit character.
fn ev_parse_int(s: str, def: int) -> int
    if len(s) == 0
        return def
    let start = 0
    let neg = false
    if s[0] == "-"
        neg = true
        start = 1
    if start >= len(s)
        return def
    let result = 0
    let i = start
    while i < len(s)
        let ch = s[i]
        if not _ev_is_digit(ch)
            return def
        let d = ord(ch) - 48
        result = result * 10 + d
        i += 1
    if neg
        return 0 - result
    result

// Parse an env-style boolean string (case-insensitive).
// "1","true","yes","on"  -> true
// "0","false","no","off" -> false
// anything else          -> def
fn ev_parse_bool(s: str, def: bool) -> bool
    let lo = lower(s)
    if lo == "1" or lo == "true" or lo == "yes" or lo == "on"
        return true
    if lo == "0" or lo == "false" or lo == "no" or lo == "off"
        return false
    def

// ── public API ────────────────────────────────────────────────────────────────

// Return the value of environment variable 'name', or 'def' if unset/empty.
fn ev_str(name: str, def: str) -> str
    let v = env(name)
    if v == ""
        return def
    v

// Return the value of 'name' parsed as an integer, or 'def' on failure.
fn ev_int(name: str, def: int) -> int
    let v = env(name)
    ev_parse_int(v, def)

// Return the value of 'name' parsed as a bool, or 'def' if unrecognised.
fn ev_bool(name: str, def: bool) -> bool
    let v = env(name)
    ev_parse_bool(v, def)

// Return true iff environment variable 'name' is set and non-empty.
fn ev_has(name: str) -> bool
    env(name) != ""
