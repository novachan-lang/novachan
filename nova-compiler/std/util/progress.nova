// std/util/progress.nova
// Progress-bar / percentage rendering utilities.
// PREFIX: prog_
//
// Public API:
//   prog_percent(current, total)         -> int    integer 0..100 (floor)
//   prog_bar(current, total, width)      -> string bar of width chars with "#"/"-", followed by " NN%"
//   prog_spinner(frame)                  -> string one of |/-\ cycling by frame%4

// prog_percent: integer percent 0..100 (floor). Returns 0 when total <= 0.
fn prog_percent(current, total) -> int
    if total <= 0
        return 0
    let pct = (current * 100) / total
    if pct < 0
        return 0
    if pct > 100
        return 100
    pct

// prog_bar: build a progress bar string.
// width chars: filled slots = "#", empty slots = "-", then " NN%".
fn prog_bar(current, total, width) -> string
    let pct = prog_percent(current, total)
    let filled = (pct * width) / 100
    let bar_parts = []
    for i in 0..width
        let ch = "-"
        if i < filled
            ch = "#"
        push(bar_parts, ch)
    let bar = join(bar_parts, "")
    bar + " " + str(pct) + "%"

// prog_spinner: one of the 4 chars |/-\ cycling by frame%4.
fn prog_spinner(frame) -> string
    let idx = frame % 4
    if idx == 0
        return "|"
    if idx == 1
        return "/"
    if idx == 2
        return "-"
    chr(92)
