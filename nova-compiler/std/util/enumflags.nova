// ============================================================================
// NOVA Standard Library — std/util/enumflags
// ============================================================================
// Bit-flag / enum-set helpers over integer bitmasks.
//
// All operations work on signed 64-bit integers used as flag words.
// Bit positions are 0-based; only bits 0..30 are safe (bit 31+ may interact
// with the sign bit or exceed the 31-bit complement mask used internally).
//
// NOTE: NOVA's `>>` is arithmetic (sign-extending); bit masks are always
// positive integers so this is not an issue for any operation here.
//
// Public API:
//   ef_flag(bit: int)             -> int   // 1 << bit  (bit in 0..30)
//   ef_has(mask: int, flag: int)  -> bool  // (mask & flag) != 0
//   ef_add(mask: int, flag: int)  -> int   // mask | flag
//   ef_remove(mask: int, flag: int) -> int // mask & ~flag  (31-bit safe)
//   ef_toggle(mask: int, flag: int) -> int // mask ^ flag
//   ef_combine(flags: list)       -> int   // OR of all elements
//   ef_count(mask: int)           -> int   // popcount (number of set bits)
// ============================================================================

// _EF_FULL_MASK covers bits 0..30 (31 bits all-1 = 2147483647 = 0x7FFFFFFF).
// Used to compute bitwise NOT within the 31-bit flag space:
//   ~flag (31-bit) = flag ^ _ef_full_mask()
fn _ef_full_mask() -> int
    2147483647

// ── ef_flag ──────────────────────────────────────────────────────────────────
// Return the single-bit mask for the given bit position (0-based).
// Caller must ensure bit is in 0..30; results for bit >= 31 are unspecified.
fn ef_flag(bit: int) -> int
    let result = 1
    let i = 0
    while i < bit
        result = result * 2
        i = i + 1
    result

// ── ef_has ───────────────────────────────────────────────────────────────────
// Return true if ANY bit in `flag` is set in `mask`.
fn ef_has(mask: int, flag: int) -> bool
    (mask & flag) != 0

// ── ef_add ───────────────────────────────────────────────────────────────────
// Return `mask` with `flag` bits set.
fn ef_add(mask: int, flag: int) -> int
    mask | flag

// ── ef_remove ────────────────────────────────────────────────────────────────
// Return `mask` with `flag` bits cleared.
// Complement is computed within the 31-bit flag space to avoid sign issues.
fn ef_remove(mask: int, flag: int) -> int
    let not_flag = flag ^ _ef_full_mask()
    mask & not_flag

// ── ef_toggle ────────────────────────────────────────────────────────────────
// Return `mask` with `flag` bits flipped.
fn ef_toggle(mask: int, flag: int) -> int
    mask ^ flag

// ── ef_combine ───────────────────────────────────────────────────────────────
// Return the OR of all integers in `flags`.
// An empty list returns 0 (identity element for OR).
fn ef_combine(flags: list) -> int
    let result = 0
    let i = 0
    while i < len(flags)
        result = result | flags[i]
        i = i + 1
    result

// ── ef_count ─────────────────────────────────────────────────────────────────
// Return the number of set bits in `mask` (Hamming weight / popcount).
// Delegates to the native `popcount` builtin.
fn ef_count(mask: int) -> int
    popcount(mask)
