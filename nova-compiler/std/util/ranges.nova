// std/util/ranges.nova — Python-style numeric range object.
//
// A range is an immutable dict describing an arithmetic sequence
//   start, start+step, start+2*step, ...
// where each element is strictly before stop (exclusive) in the direction of
// step.  step must be non-zero; a step that would never reach stop yields an
// empty range (length 0).
//
// Public API (all functions prefixed "rg_" to avoid dict-key collisions)
//   rg_new(start, stop, step) -> dict   create a range object
//   rg_to_list(r)             -> list   materialise every element
//   rg_len(r)                 -> int    number of elements
//   rg_contains(r, x)         -> bool   true if x is in the sequence
//   rg_get(r, i)              -> int    i-th element (0-based)
//   rg_sum(r)                 -> int    sum of all elements
//   rg_reverse(r)             -> dict   new range that traverses the same
//                                       elements in reverse order

// ---------------------------------------------------------------------------
// Private helpers — all prefixed "rg_" (same as public) so private helpers
// share the module namespace safely.

// rg_ceil_div: compute ceil(a / b) for a >= 0, b > 0 (all-integer).
fn rg_ceil_div(a: int, b: int) -> int
    let q = a / b
    let rem = a - q * b
    if rem == 0
        return q
    q + 1

// rg_abs: absolute value of an integer.
fn rg_abs(x: int) -> int
    if x < 0
        return 0 - x
    x

// ---------------------------------------------------------------------------
// rg_new — create a range object.
// step must be non-zero (caller's responsibility; zero step silently stored
// but every subsequent operation returns 0 / empty results for safety).
fn rg_new(start: int, stop: int, step: int) -> dict
    let d = {}
    d["rg_start"] = start
    d["rg_stop"]  = stop
    d["rg_step"]  = step
    d

// ---------------------------------------------------------------------------
// rg_len — number of elements in the range.
// Formula: max(0, ceil((stop - start) / step))
fn rg_len(r: dict) -> int
    let start = r["rg_start"]
    let stop  = r["rg_stop"]
    let step  = r["rg_step"]
    let span = stop - start
    // If span and step have opposite signs (or span==0), length is 0.
    if step > 0
        if span <= 0
            return 0
        return rg_ceil_div(span, step)
    // step < 0
    if span >= 0
        return 0
    // span < 0, step < 0: ceil(|span| / |step|)
    let abs_span = rg_abs(span)
    let abs_step = rg_abs(step)
    rg_ceil_div(abs_span, abs_step)

// ---------------------------------------------------------------------------
// rg_to_list — materialise the range into a list of ints.
fn rg_to_list(r: dict) -> list
    let start = r["rg_start"]
    let step  = r["rg_step"]
    let n     = rg_len(r)
    let out   = []
    let i     = 0
    while i < n
        let val = start + i * step
        out.push(val)
        let i = i + 1
    out

// ---------------------------------------------------------------------------
// rg_contains — true iff x is a member of the arithmetic sequence.
// x must equal start + k*step for some integer k in [0, len).
fn rg_contains(r: dict, x: int) -> bool
    let start = r["rg_start"]
    let step  = r["rg_step"]
    let n     = rg_len(r)
    if n == 0
        return 0
    let diff = x - start
    // diff must be divisible by step and the quotient in [0, n).
    if step > 0
        if diff < 0
            return 0
        let rem = diff - (diff / step) * step
        if rem != 0
            return 0
        let k = diff / step
        if k < n
            return 1
        return 0
    // step < 0
    if diff > 0
        return 0
    let abs_diff = rg_abs(diff)
    let abs_step = rg_abs(step)
    let rem = abs_diff - (abs_diff / abs_step) * abs_step
    if rem != 0
        return 0
    let k = abs_diff / abs_step
    if k < n
        return 1
    return 0

// ---------------------------------------------------------------------------
// rg_get — i-th element of the range (0-based index).
fn rg_get(r: dict, i: int) -> int
    let start = r["rg_start"]
    let step  = r["rg_step"]
    start + i * step

// ---------------------------------------------------------------------------
// rg_sum — sum of all elements using the arithmetic-series formula
// n * start + step * (n*(n-1)/2)
fn rg_sum(r: dict) -> int
    let start = r["rg_start"]
    let step  = r["rg_step"]
    let n     = rg_len(r)
    if n == 0
        return 0
    let s = n * start + step * (n * (n - 1) / 2)
    s

// ---------------------------------------------------------------------------
// rg_reverse — return a new range that visits the same elements in reverse.
// If the original is empty the reversed range is also empty.
fn rg_reverse(r: dict) -> dict
    let n = rg_len(r)
    if n == 0
        return rg_new(r["rg_start"], r["rg_stop"], 0 - r["rg_step"])
    let start = r["rg_start"]
    let step  = r["rg_step"]
    let new_start = start + (n - 1) * step
    let new_step  = 0 - step
    let new_stop  = start - step
    rg_new(new_start, new_stop, new_step)
