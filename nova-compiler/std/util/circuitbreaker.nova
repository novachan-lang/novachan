// std/util/circuitbreaker.nova
// Circuit breaker state machine with injected time (deterministic).
// Prefix: cbk_
//
// States:
//   "closed"    -- normal operation; failures accumulate
//   "open"      -- tripped; requests blocked until cooldown expires
//   "half_open" -- cooldown elapsed; one probe request allowed
//
// Time is injected as an integer so the module is fully deterministic
// and testable without wall-clock access.
//
// Public API
// ----------
//   cbk_new(failure_threshold, cooldown) -> dict
//       Create a new circuit breaker.
//       failure_threshold : int  -- consecutive failures that trip to "open"
//       cooldown          : int  -- time units before "open" -> "half_open"
//
//   cbk_state(c) -> str
//       Return current state: "closed", "open", or "half_open".
//
//   cbk_record_failure(c, now)
//       Record a failure at time `now`.
//       Closed: increment counter; trip to "open" when threshold reached.
//       Half_open: re-trip immediately to "open".
//       Open: no-op.
//
//   cbk_record_success(c)
//       Record a success.
//       Closed/Half_open: reset to "closed" with 0 failures.
//       Open: no-op (caller should check cbk_allow first).
//
//   cbk_allow(c, now) -> bool
//       Decide whether to allow a request at time `now`.
//       Closed    -> true
//       Half_open -> true
//       Open      -> false unless now >= opened_at + cooldown,
//                    in which case transition to "half_open" and return true.

fn cbk_new(failure_threshold, cooldown)
    {"state": "closed", "failures": 0, "failure_threshold": failure_threshold, "cooldown": cooldown, "opened_at": 0}

fn cbk_state(c)
    c["state"]

fn cbk_record_failure(c, now)
    let st = c["state"]
    if st == "half_open"
        c["state"] = "open"
        c["opened_at"] = now
        c["failures"] = c["failure_threshold"]
    else if st == "closed"
        c["failures"] += 1
        if c["failures"] >= c["failure_threshold"]
            c["state"] = "open"
            c["opened_at"] = now

fn cbk_record_success(c)
    let st = c["state"]
    if st == "half_open"
        c["state"] = "closed"
        c["failures"] = 0
    else if st == "closed"
        c["failures"] = 0

fn cbk_allow(c, now)
    let st = c["state"]
    if st == "closed" or st == "half_open"
        return true
    // state == "open"
    let ready_at = c["opened_at"] + c["cooldown"]
    if now >= ready_at
        c["state"] = "half_open"
        return true
    false
