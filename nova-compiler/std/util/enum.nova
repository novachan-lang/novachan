// ============================================================================
// NOVA Standard Library — std/util/enum
// ============================================================================
// Enum as a name<->ordinal bimap built from a list of string names.
//
// An enum value is a plain dict holding:
//   "_names"   — the ordered list of names (list)
//   "_count"   — total number of names (int)
//   "v_<NAME>" — ordinal (int) for each name, keyed by "v_" + name
//
// The "v_" prefix on name keys prevents collision with the two meta-keys
// and is never visible through the public API.
//
// Public API:
//   en_new(names)          -> dict  Build an enum from a list of strings.
//   en_value(e, name)      -> int   Ordinal for name, or -1 if absent.
//   en_name(e, value)      -> str   Name for ordinal, or "" if out of range.
//   en_names(e)            -> list  Ordered list of all names.
//   en_count(e)            -> int   Number of entries.
//   en_has(e, name)        -> bool  True iff name is a member.
//   en_next(e, name)       -> str   Next name cyclically; "" if name absent.
// ============================================================================

// ── en_new ───────────────────────────────────────────────────────────────────
// Build a bimap dict from an ordered list of name strings.
// Ordinals are assigned 0, 1, 2, ... in list order.
// Duplicate names are silently overwritten (last occurrence wins), which
// mirrors the behaviour of most language enum definitions.
fn en_new(names) -> dict
    let e = {}
    let n = len(names)
    e["_count"] = n
    e["_names"] = names
    for i in 0..n
        let nm = names[i]
        let key = "v_" + nm
        e[key] = i
    e

// ── en_value ─────────────────────────────────────────────────────────────────
// Return the ordinal for `name`, or -1 if `name` is not a member.
fn en_value(e, name) -> int
    let key = "v_" + name
    if not contains(e, key)
        return -1
    e[key]

// ── en_name ──────────────────────────────────────────────────────────────────
// Return the name string for ordinal `value`, or "" if out of range.
fn en_name(e, value) -> str
    let n = e["_count"]
    if value < 0 or value >= n
        return ""
    let names = e["_names"]
    names[value]

// ── en_names ─────────────────────────────────────────────────────────────────
// Return the ordered list of all member names.
fn en_names(e) -> list
    e["_names"]

// ── en_count ─────────────────────────────────────────────────────────────────
// Return the total number of enum members.
fn en_count(e) -> int
    e["_count"]

// ── en_has ───────────────────────────────────────────────────────────────────
// Return true iff `name` is a member of the enum.
fn en_has(e, name) -> bool
    let key = "v_" + name
    contains(e, key)

// ── en_next ──────────────────────────────────────────────────────────────────
// Return the name that follows `name` cyclically (wraps from last back to
// first). Returns "" if `name` is not a member of the enum.
fn en_next(e, name) -> str
    let key = "v_" + name
    if not contains(e, key)
        return ""
    let idx = e[key]
    let n = e["_count"]
    let next_idx = (idx + 1) % n
    let names = e["_names"]
    names[next_idx]
