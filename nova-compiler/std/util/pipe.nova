// ============================================================================
// NOVA Standard Library — std/util/pipe
// ============================================================================
// Left-to-right function pipeline.
//
// pp_pipe(value, fns: list) -> any
//   Apply each closure in fns left-to-right, threading the result.
//   fns is a list of closures fn(x) -> y.
//   Empty list returns value unchanged (identity).
//
// pp_pipe_all(values: list, fns: list) -> list
//   Apply pp_pipe to every value in values, returning a new list.
//
// pp_tap(value, tap_fn) -> any
//   Call tap_fn(value) for side effects, return original value.
//
// Public API:
//   pp_pipe(value, fns: list) -> any
//   pp_pipe_all(values: list, fns: list) -> list
//   pp_tap(value, tap_fn) -> any

// ── pp_pipe ──────────────────────────────────────────────────────────────────
// Apply each function in fns to acc in order, threading the result.
fn pp_pipe(value, fns: list)
    let acc = value
    for i in 0..len(fns)
        let f = fns[i]
        acc = f(acc)
    acc

// ── pp_pipe_all ───────────────────────────────────────────────────────────────
// Map pp_pipe over every element in values.
fn pp_pipe_all(values: list, fns: list) -> list
    let result = []
    for i in 0..len(values)
        result.push(pp_pipe(values[i], fns))
    result

// ── pp_tap ────────────────────────────────────────────────────────────────────
// Call tap_fn(value) for side effect, return original value unchanged.
fn pp_tap(value, tap_fn)
    tap_fn(value)
    value
