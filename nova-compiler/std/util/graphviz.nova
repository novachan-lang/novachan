// ============================================================================
// NOVA Standard Library — std/util/graphviz
// ============================================================================
// Emit Graphviz DOT text from a graph built incrementally.
//
// Usage:
//   let g = gv_new(true)            // directed graph
//   gv_add_node(g, "A")
//   gv_add_edge(g, "A", "B")
//   gv_add_labeled_edge(g, "B", "C", "next")
//   let dot = gv_to_dot(g)          // "digraph G {\n  A\n  A -> B\n  ...}\n"
//
// Graph dict layout:
//   g["directed"]  : int   (1=digraph, 0=graph)
//   g["nodes"]     : list  of str  (declared node names, in insertion order)
//   g["edges"]     : list  of str  (pre-rendered edge lines, in insertion order)
//
// Public API:
//   gv_new(directed: int) -> dict
//   gv_add_node(g: dict, name: str)
//   gv_add_edge(g: dict, from_name: str, to_name: str)
//   gv_add_labeled_edge(g: dict, from_name: str, to_name: str, label: str)
//   gv_to_dot(g: dict) -> str

// ── gv_new ────────────────────────────────────────────────────────────────────
// Create a new empty graph.
// directed: 1 → digraph (A -> B), 0 → graph (A -- B).
fn gv_new(directed: int) -> dict
    let g = {}
    g["directed"] = directed
    g["nodes"] = []
    g["edges"] = []
    g

// ── gv_add_node ───────────────────────────────────────────────────────────────
// Declare a node explicitly. Nodes referenced only in edges need not be
// declared separately — gv_to_dot renders edge lines regardless.
// Duplicate names are allowed (DOT itself ignores duplicates).
fn gv_add_node(g: dict, name: str)
    let ns = g["nodes"]
    ns.push(name)
    g["nodes"] = ns

// ── _gv_edge_line ─────────────────────────────────────────────────────────────
// Build a single edge line: "  from_name -> to_name" or "  from_name -- to_name",
// with an optional label attribute.
fn _gv_edge_line(directed: int, from_name: str, to_name: str, label: str) -> str
    let arrow = " -- "
    if directed == 1
        arrow = " -> "
    let line = "  " + from_name + arrow + to_name
    if len(label) > 0
        line = line + " [label=" + chr(34) + label + chr(34) + "]"
    line

// ── gv_add_edge ───────────────────────────────────────────────────────────────
fn gv_add_edge(g: dict, from_name: str, to_name: str)
    let directed = g["directed"]
    let line = _gv_edge_line(directed, from_name, to_name, "")
    let es = g["edges"]
    es.push(line)
    g["edges"] = es

// ── gv_add_labeled_edge ───────────────────────────────────────────────────────
fn gv_add_labeled_edge(g: dict, from_name: str, to_name: str, label: str)
    let directed = g["directed"]
    let line = _gv_edge_line(directed, from_name, to_name, label)
    let es = g["edges"]
    es.push(line)
    g["edges"] = es

// ── gv_to_dot ────────────────────────────────────────────────────────────────
// Render the graph as a DOT-language string.
// Directed:   "digraph G {\n  <nodes>\n  <edges>\n}\n"
// Undirected: "graph G {\n  <nodes>\n  <edges>\n}\n"
fn gv_to_dot(g: dict) -> str
    let directed = g["directed"]
    let header = "graph G " + chr(123) + "\n"
    if directed == 1
        header = "digraph G " + chr(123) + "\n"
    let result = header

    // Emit explicitly declared nodes.
    let ns = g["nodes"]
    for ni in 0..len(ns)
        result = result + "  " + ns[ni] + "\n"

    // Emit edge lines (already pre-rendered).
    let es = g["edges"]
    for ei in 0..len(es)
        result = result + es[ei] + "\n"

    result = result + chr(125) + "\n"
    result
