// ============================================================================
// NOVA Standard Library — std/textlayout/textcolumns
// ============================================================================
// Multi-column text layout utilities (ASCII, row-major and column-major fill).
//
// Public API (all functions prefixed tc_):
//   tc_max_width(items) -> int
//       Return the length of the longest string in items.  0 if list is empty.
//
//   tc_rows_needed(nitems, ncols) -> int
//       Ceiling-divide nitems by ncols.  0 when nitems == 0.
//
//   tc_pad_items(items) -> list
//       Return a new list where every string is right-padded with spaces to
//       tc_max_width(items).
//
//   tc_columns(items, ncols) -> string
//       Arrange items in row-major order into ncols columns.  Every cell is
//       padded to tc_max_width(items) characters, columns separated by 2 spaces.
//       Lines joined with chr(10).  Returns "" for empty lists.
//
//   tc_columns_width(items, ncols, total_width) -> string
//       Like tc_columns but the column width is chosen so that ncols columns
//       (each column + 2-space sep after it, except the last) fit within
//       total_width characters.  If total_width is too narrow, falls back to
//       tc_max_width(items).
//
//   tc_column_major(items, ncols) -> string
//       Like tc_columns but fills column-major (down each column, then next).
//
//   tc_side_by_side(left, right, gap) -> string
//       Place two multi-line text blocks next to each other.  The left block is
//       padded so every line is as wide as its widest line; the blocks are
//       separated by `gap` space characters.  If one block has fewer lines, the
//       shorter side is padded with blanks.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Repeat single-char string ch exactly n times; returns "" for n <= 0.
fn _tc_rep(ch, n) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + ch
        i = i + 1
    out

// Left-justify s to exactly w chars (pad spaces on right); never truncates.
fn _tc_ljust(s, w) -> string
    let slen = len(s)
    if slen >= w
        return s
    s + _tc_rep(" ", w - slen)

// Strip trailing spaces from a line (avoids invisible trailing whitespace on the
// last column of a laid-out row).
fn _tc_rstrip(s) -> string
    let e = len(s)
    while e > 0 and slice(s, e - 1, e) == " "
        e = e - 1
    slice(s, 0, e)

// Split a string on chr(10) into a list of lines.
fn _tc_split_lines(s) -> list
    let nl = chr(10)
    let raw = split(s, nl)
    // drop a trailing empty element produced by a trailing newline
    let n = len(raw)
    if n > 0 and len(raw[n - 1]) == 0
        let out = []
        let i = 0
        while i < n - 1
            out = out + [raw[i]]
            i = i + 1
        return out
    raw

// Join a list of strings with chr(10).
fn _tc_join_lines(lines) -> string
    let n = len(lines)
    if n == 0
        return ""
    let nl = chr(10)
    let out = ""
    let i = 0
    while i < n
        if i > 0
            out = out + nl
        out = out + lines[i]
        i = i + 1
    out

// Integer max of two values.
fn _tc_max2(a, b) -> int
    if a > b
        return a
    b

// Ceiling division: ceil(a / b); b must be > 0.
fn _tc_ceil_div(a, b) -> int
    let q = a / b
    if q * b < a
        return q + 1
    q

// ── public API ───────────────────────────────────────────────────────────────

// tc_max_width(items) -> int
// Return the length of the longest string in items; 0 for an empty list.
fn tc_max_width(items) -> int
    let n = len(items)
    let mx = 0
    let i = 0
    while i < n
        let l = len(items[i])
        if l > mx
            mx = l
        i = i + 1
    mx

// tc_rows_needed(nitems, ncols) -> int
// Number of rows required to hold nitems items in ncols columns (ceiling div).
fn tc_rows_needed(nitems, ncols) -> int
    if nitems == 0 or ncols == 0
        return 0
    _tc_ceil_div(nitems, ncols)

// tc_pad_items(items) -> list
// Return a copy of items where every string is padded to tc_max_width(items).
fn tc_pad_items(items) -> list
    let w = tc_max_width(items)
    let n = len(items)
    let out = []
    let i = 0
    while i < n
        out = out + [_tc_ljust(items[i], w)]
        i = i + 1
    out

// tc_columns(items, ncols) -> string
// Arrange items row-major into ncols columns.  Every cell is padded to
// tc_max_width(items).  Columns separated by 2 spaces.  Lines joined by chr(10).
// Returns "" if items is empty.
fn tc_columns(items, ncols) -> string
    let nitems = len(items)
    if nitems == 0 or ncols == 0
        return ""
    let cw = tc_max_width(items)
    let nrows = tc_rows_needed(nitems, ncols)
    let sep = "  "
    let lines = []
    let r = 0
    while r < nrows
        let line = ""
        let c = 0
        while c < ncols
            let idx = r * ncols + c
            let cell = ""
            if idx < nitems
                cell = _tc_ljust(items[idx], cw)
            else
                cell = _tc_rep(" ", cw)
            if c > 0
                line = line + sep
            line = line + cell
            c = c + 1
        lines = lines + [_tc_rstrip(line)]
        r = r + 1
    _tc_join_lines(lines)

// tc_columns_width(items, ncols, total_width) -> string
// Like tc_columns, but derive the per-cell width so that ncols columns fit
// within total_width characters.  Layout: ncols cells, each cell_w wide,
// separated by (ncols-1) * 2 spaces.  Falls back to tc_max_width when the
// computed width would be smaller.
fn tc_columns_width(items, ncols, total_width) -> string
    if len(items) == 0 or ncols == 0
        return ""
    let sep_total = (ncols - 1) * 2
    let avail = total_width - sep_total
    let cell_w = avail / ncols
    let natural_w = tc_max_width(items)
    if cell_w < natural_w
        cell_w = natural_w
    let nitems = len(items)
    let nrows = tc_rows_needed(nitems, ncols)
    let sep = "  "
    let lines = []
    let r = 0
    while r < nrows
        let line = ""
        let c = 0
        while c < ncols
            let idx = r * ncols + c
            let cell = ""
            if idx < nitems
                cell = _tc_ljust(items[idx], cell_w)
            else
                cell = _tc_rep(" ", cell_w)
            if c > 0
                line = line + sep
            line = line + cell
            c = c + 1
        lines = lines + [_tc_rstrip(line)]
        r = r + 1
    _tc_join_lines(lines)

// tc_column_major(items, ncols) -> string
// Arrange items in column-major order (fill down each column first, then next).
// Every cell padded to tc_max_width(items).  Columns separated by 2 spaces.
fn tc_column_major(items, ncols) -> string
    let nitems = len(items)
    if nitems == 0 or ncols == 0
        return ""
    let cw = tc_max_width(items)
    let nrows = tc_rows_needed(nitems, ncols)
    let sep = "  "
    let lines = []
    let r = 0
    while r < nrows
        let line = ""
        let c = 0
        while c < ncols
            // column-major: item at column c, row r = index c*nrows + r
            let idx = c * nrows + r
            let cell = ""
            if idx < nitems
                cell = _tc_ljust(items[idx], cw)
            else
                cell = _tc_rep(" ", cw)
            if c > 0
                line = line + sep
            line = line + cell
            c = c + 1
        lines = lines + [_tc_rstrip(line)]
        r = r + 1
    _tc_join_lines(lines)

// tc_side_by_side(left, right, gap) -> string
// Place two multi-line blocks side by side.  The left block is padded to its
// widest line; blocks are separated by `gap` space characters.  Missing lines
// in the shorter block are treated as empty strings.
fn tc_side_by_side(left, right, gap) -> string
    let llines = _tc_split_lines(left)
    let rlines = _tc_split_lines(right)
    let lcount = len(llines)
    let rcount = len(rlines)
    // Width of the left block = max line length.
    let lw = 0
    let i = 0
    while i < lcount
        let l = len(llines[i])
        if l > lw
            lw = l
        i = i + 1
    let nrows = lcount
    if rcount > nrows
        nrows = rcount
    let gsep = _tc_rep(" ", gap)
    let lines = []
    let r = 0
    while r < nrows
        let lpart = ""
        if r < lcount
            lpart = _tc_ljust(llines[r], lw)
        else
            lpart = _tc_rep(" ", lw)
        let rpart = ""
        if r < rcount
            rpart = rlines[r]
        lines = lines + [lpart + gsep + rpart]
        r = r + 1
    _tc_join_lines(lines)
