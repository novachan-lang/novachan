// ============================================================================
// NOVA Standard Library — std/textlayout/textfill
// ============================================================================
// Paragraph fill and justify utilities for plain-ASCII text.
// All functions are SELF-CONTAINED: no imports; helpers are file-private.
//
// Public API (prefix tf_):
//   tf_normalize_ws(text) -> string
//       Collapse runs of whitespace (spaces/tabs/newlines) to single spaces,
//       then trim leading/trailing spaces.
//
//   tf_fill(text, width) -> string
//       Collapse internal whitespace then greedy-wrap to width.
//       Lines joined by chr(10). Empty/whitespace input returns "".
//
//   tf_fill_justify(text, width) -> string
//       Like tf_fill but every line EXCEPT the last is space-justified to
//       exactly `width` chars by distributing extra spaces between words.
//
//   tf_wrap_lines(text, width) -> any
//       Return a list of lines (greedy wrapped) after normalising whitespace.
//
//   tf_fill_indent(text, width, indent) -> string
//       Fill then prepend `indent` to every line; effective wrap width is
//       width - len(indent).
//
//   tf_fill_first_indent(text, width, first, rest) -> string
//       Fill with a different indent for the first line vs continuations
//       (like Python textwrap.fill with initial_indent / subsequent_indent).
//
// LEAF — imports NOTHING.
// ============================================================================

// ── private helpers ───────────────────────────────────────────────────────────

// _tf_is_ws: true if the character at code `c` is a whitespace byte.
fn _tf_is_ws(c) -> int
    if c == 32
        return 1
    if c == 9
        return 1
    if c == 10
        return 1
    if c == 13
        return 1
    0

// _tf_split_words: split a string on whitespace, returning a list of
// non-empty word tokens (runs of whitespace collapse to a single split point).
fn _tf_split_words(text) -> list
    let words = []
    let n = len(text)
    let i = 0
    // skip leading whitespace
    while i < n and _tf_is_ws(ord(slice(text, i, i + 1))) == 1
        i = i + 1
    let start = i
    let in_word = 0
    if i < n
        in_word = 1
    while i < n
        let c = ord(slice(text, i, i + 1))
        if _tf_is_ws(c) == 1
            if in_word == 1
                words = words + [slice(text, start, i)]
                in_word = 0
        else
            if in_word == 0
                start = i
                in_word = 1
        i = i + 1
    if in_word == 1
        words = words + [slice(text, start, n)]
    words

// _tf_join_nl: join a list of strings with chr(10).
fn _tf_join_nl(lines) -> string
    let out = ""
    let i = 0
    let n = len(lines)
    let nl = chr(10)
    while i < n
        if i > 0
            out = out + nl
        out = out + lines[i]
        i = i + 1
    out

// _tf_repeat_char: produce a string of `count` copies of character ch.
fn _tf_repeat_char(ch, count) -> string
    let out = ""
    let i = 0
    while i < count
        out = out + ch
        i = i + 1
    out

// _tf_greedy_wrap_words: given a list of words, greedily wrap into lines of
// at most `width` chars. Returns a list of line strings.
fn _tf_greedy_wrap_words(words, width) -> list
    let lines = []
    let nw = len(words)
    if nw == 0
        return lines
    let cur = ""
    let cur_len = 0
    let i = 0
    while i < nw
        let word = words[i]
        let wlen = len(word)
        if cur_len == 0
            cur = word
            cur_len = wlen
        else
            if cur_len + 1 + wlen <= width
                cur = cur + " " + word
                cur_len = cur_len + 1 + wlen
            else
                lines = lines + [cur]
                cur = word
                cur_len = wlen
        i = i + 1
    if cur_len > 0
        lines = lines + [cur]
    lines

// _tf_justify_line: justify a line (list of words on that line) to exactly
// `width` chars by inserting extra spaces between words.
// If there is only one word, pad on the right (left-align); that case only
// happens for a single-word line.
fn _tf_justify_line(line_str, width) -> string
    // Re-split the already-built line string on single spaces.
    let words = []
    let n = len(line_str)
    let i = 0
    let start = 0
    let in_w = 0
    while i < n
        let c = ord(slice(line_str, i, i + 1))
        if c == 32
            if in_w == 1
                words = words + [slice(line_str, start, i)]
                in_w = 0
        else
            if in_w == 0
                start = i
                in_w = 1
        i = i + 1
    if in_w == 1
        words = words + [slice(line_str, start, n)]
    let nw = len(words)
    if nw <= 1
        // Single word — return as-is (no padding; caller skips last line anyway).
        return line_str
    // Total chars occupied by words.
    let word_chars = 0
    let j = 0
    while j < nw
        word_chars = word_chars + len(words[j])
        j = j + 1
    let gaps = nw - 1
    let total_spaces = width - word_chars
    if total_spaces < gaps
        // Degenerate: line already at or over width; leave as-is.
        return line_str
    let base_sp = total_spaces / gaps
    let extra = total_spaces - base_sp * gaps
    // extra gaps (leftmost) get base_sp+1 spaces; the rest get base_sp.
    let out = words[0]
    let k = 1
    while k < nw
        let sp_count = base_sp
        if k - 1 < extra
            sp_count = sp_count + 1
        out = out + _tf_repeat_char(" ", sp_count)
        out = out + words[k]
        k = k + 1
    out

// ── public API ────────────────────────────────────────────────────────────────

// tf_normalize_ws(text) -> string
// Collapse runs of whitespace (space/tab/newline/CR) to single spaces; trim.
fn tf_normalize_ws(text) -> string
    let words = _tf_split_words(text)
    let nw = len(words)
    if nw == 0
        return ""
    let out = words[0]
    let i = 1
    while i < nw
        out = out + " " + words[i]
        i = i + 1
    out

// tf_wrap_lines(text, width) -> any
// Normalise whitespace then greedy-wrap to `width`; return list of line strings.
// Empty / whitespace-only text returns [].
fn tf_wrap_lines(text, width) -> any
    if width <= 0
        return []
    let words = _tf_split_words(text)
    _tf_greedy_wrap_words(words, width)

// tf_fill(text, width) -> string
// Collapse internal whitespace then greedy-wrap to width; join lines with chr(10).
// Empty / whitespace-only text returns "".
fn tf_fill(text, width) -> string
    if width <= 0
        return ""
    let lines = tf_wrap_lines(text, width)
    _tf_join_nl(lines)

// tf_fill_justify(text, width) -> string
// Like tf_fill but every line EXCEPT the last is stretched to exactly `width`
// characters by distributing extra spaces evenly between words.
fn tf_fill_justify(text, width) -> string
    if width <= 0
        return ""
    let lines = tf_wrap_lines(text, width)
    let nl = len(lines)
    if nl == 0
        return ""
    let out_lines = []
    let i = 0
    while i < nl
        if i < nl - 1
            out_lines = out_lines + [_tf_justify_line(lines[i], width)]
        else
            out_lines = out_lines + [lines[i]]
        i = i + 1
    _tf_join_nl(out_lines)

// tf_fill_indent(text, width, indent) -> string
// Fill the text with every line indented by `indent`; effective wrap width is
// max(1, width - len(indent)).
fn tf_fill_indent(text, width, indent) -> string
    let indent_len = len(indent)
    let inner_width = width - indent_len
    if inner_width < 1
        inner_width = 1
    let lines = tf_wrap_lines(text, inner_width)
    let nl = len(lines)
    if nl == 0
        return ""
    let out_lines = []
    let i = 0
    while i < nl
        out_lines = out_lines + [indent + lines[i]]
        i = i + 1
    _tf_join_nl(out_lines)

// tf_fill_first_indent(text, width, first, rest) -> string
// Fill text; the first line is prefixed with `first`, subsequent lines with `rest`.
// Effective wrap widths: width-len(first) for line 0, width-len(rest) for lines 1+.
// Like Python's textwrap.fill(initial_indent=first, subsequent_indent=rest).
fn tf_fill_first_indent(text, width, first, rest) -> string
    let words = _tf_split_words(text)
    let nw = len(words)
    if nw == 0
        return ""
    let first_width = width - len(first)
    let rest_width = width - len(rest)
    if first_width < 1
        first_width = 1
    if rest_width < 1
        rest_width = 1
    // Greedy pack with two separate widths: line 0 uses first_width, rest use rest_width.
    let out_lines = []
    let cur = ""
    let cur_len = 0
    let line_idx = 0
    let i = 0
    while i < nw
        let word = words[i]
        let wlen = len(word)
        let max_w = rest_width
        if line_idx == 0
            max_w = first_width
        if cur_len == 0
            cur = word
            cur_len = wlen
        else
            if cur_len + 1 + wlen <= max_w
                cur = cur + " " + word
                cur_len = cur_len + 1 + wlen
            else
                out_lines = out_lines + [cur]
                line_idx = line_idx + 1
                cur = word
                cur_len = wlen
        i = i + 1
    if cur_len > 0
        out_lines = out_lines + [cur]
    // Now prepend the appropriate indent.
    let nl_char = chr(10)
    let result = ""
    let j = 0
    let nl2 = len(out_lines)
    while j < nl2
        if j > 0
            result = result + nl_char
        if j == 0
            result = result + first + out_lines[j]
        else
            result = result + rest + out_lines[j]
        j = j + 1
    result
