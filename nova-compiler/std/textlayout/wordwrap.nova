// ============================================================================
// NOVA Standard Library — std/textlayout/wordwrap
// ============================================================================
// Greedy word-wrap utilities for plain-text ASCII strings.
//
// All widths are measured in characters (1 ASCII byte = 1 column).
// Multi-line input is flattened: newlines inside text are treated as spaces.
//
// Public API (prefix ww_):
//   ww_split_words(text)         -> list  split text on spaces, drop empties
//   ww_fits(word, width)         -> bool  true if len(word) <= width
//   ww_break_long(word, width)   -> list  hard-break one word into <=width chunks
//   ww_wrap(text, width)         -> list  greedy soft-wrap (long words stay whole)
//   ww_wrap_str(text, width)     -> string  ww_wrap joined by chr(10)
//   ww_lines(text, width)        -> int   number of output lines
//   ww_wrap_hard(text, width)    -> list  greedy wrap + hard-break long words
//
// LEAF — imports nothing; all helpers prefixed ww_.

// ── private helpers ───────────────────────────────────────────────────────────

// Join a list of strings with sep.
fn _ww_join(parts, sep) -> string
    let out = ""
    let i = 0
    let n = len(parts)
    while i < n
        if i > 0
            out = out + sep
        out = out + parts[i]
        i = i + 1
    out

// ── public API ────────────────────────────────────────────────────────────────

// ww_split_words: split text on chr(32), skipping empty tokens.
// Newlines inside text are NOT normalised here; callers normalise if needed.
fn ww_split_words(text) -> list
    let words = []
    let cur = ""
    let i = 0
    let n = len(text)
    while i < n
        let ch = slice(text, i, i + 1)
        if ch == " " or ch == chr(10) or ch == chr(13)
            if len(cur) > 0
                words = words + [cur]
                cur = ""
        else
            cur = cur + ch
        i = i + 1
    if len(cur) > 0
        words = words + [cur]
    words

// ww_fits: return true when word length is <= width.
fn ww_fits(word, width) -> bool
    len(word) <= width

// ww_break_long: hard-break one word into sequential chunks of exactly width
// characters (last chunk may be shorter). Returns [""] for an empty word.
fn ww_break_long(word, width) -> list
    let chunks = []
    let wlen = len(word)
    if wlen == 0
        chunks = chunks + [""]
        return chunks
    let pos = 0
    while pos < wlen
        let end = pos + width
        if end > wlen
            end = wlen
        chunks = chunks + [slice(word, pos, end)]
        pos = end
    chunks

// ww_wrap: greedy soft-wrap.
// Words that fit on the current line (with one space separator) are appended;
// otherwise a new line is started. A word longer than width goes on its own
// line, unbroken. Returns [] for empty or whitespace-only input.
fn ww_wrap(text, width) -> list
    let lines = []
    if len(text) == 0
        return lines
    let words = ww_split_words(text)
    let nw = len(words)
    if nw == 0
        return lines
    let cur_line = ""
    let cur_len = 0
    let i = 0
    while i < nw
        let word = words[i]
        let wlen = len(word)
        if cur_len == 0
            // First word on a fresh line — always place, even if oversized.
            cur_line = word
            cur_len = wlen
        else
            if cur_len + 1 + wlen <= width
                cur_line = cur_line + " " + word
                cur_len = cur_len + 1 + wlen
            else
                // Flush current line; start a new one.
                lines = lines + [cur_line]
                cur_line = word
                cur_len = wlen
        i = i + 1
    if cur_len > 0
        lines = lines + [cur_line]
    lines

// ww_wrap_str: wrap and join resulting lines with chr(10).
fn ww_wrap_str(text, width) -> string
    let ls = ww_wrap(text, width)
    _ww_join(ls, chr(10))

// ww_lines: return the number of output lines produced by ww_wrap.
fn ww_lines(text, width) -> int
    len(ww_wrap(text, width))

// ww_wrap_hard: greedy wrap with hard-breaking of words that exceed width.
// Long words are first split into <=width chunks via ww_break_long; the
// resulting chunks are then packed greedily onto lines.
fn ww_wrap_hard(text, width) -> list
    let lines = []
    if len(text) == 0
        return lines
    let words = ww_split_words(text)
    let nw = len(words)
    if nw == 0
        return lines
    let cur_line = ""
    let cur_len = 0
    let i = 0
    while i < nw
        let word = words[i]
        let chunks = ww_break_long(word, width)
        let nc = len(chunks)
        let ci = 0
        while ci < nc
            let chunk = chunks[ci]
            let clen = len(chunk)
            if cur_len == 0
                cur_line = chunk
                cur_len = clen
            else
                if cur_len + 1 + clen <= width
                    cur_line = cur_line + " " + chunk
                    cur_len = cur_len + 1 + clen
                else
                    lines = lines + [cur_line]
                    cur_line = chunk
                    cur_len = clen
            ci = ci + 1
        i = i + 1
    if cur_len > 0
        lines = lines + [cur_line]
    lines
