// ============================================================================
// NOVA Standard Library — std/textlayout/hangindent
// ============================================================================
// Hanging-indent and bullet/numbered-list utilities for plain-ASCII text.
// All functions are SELF-CONTAINED: no imports; helpers are file-private.
//
// Public API (prefix hi_):
//   hi_continuation_width(width, indent) -> int
//       Content width available on continuation lines = width - indent.
//
//   hi_hang(text, width, indent) -> string
//       Wrap text to `width`; the first line starts at column 0 (full width),
//       every continuation line is indented by `indent` spaces with content
//       width = width - indent.
//
//   hi_bullet(text, width, bullet) -> string
//       Format text as a bullet item. The bullet marker occupies the first
//       line; continuation lines are aligned to start beneath the text, i.e.
//       indented by len(bullet) spaces.
//
//   hi_numbered(items, width) -> string
//       Format a list of text items as a numbered list (1., 2., ...) with
//       hanging indent so continuation lines align under the item text.
//
//   hi_first_indent(text, width, first, rest) -> string
//       Wrap text to `width` with separate indent strings for the first line
//       and continuation lines (effective widths adjusted accordingly).
//
//   hi_dedent_hang(text, indent) -> string
//       Remove exactly `indent` leading spaces from every line that starts
//       with that many spaces (strips the hanging indent added by hi_hang).
//
// LEAF — imports NOTHING.
// ============================================================================

// ── private helpers ───────────────────────────────────────────────────────────

// _hi_is_ws: true (1) if byte code is whitespace (space or tab).
fn _hi_is_ws(c) -> int
    if c == 32
        return 1
    if c == 9
        return 1
    0

// _hi_split_words: split text on whitespace, returning non-empty word tokens.
fn _hi_split_words(text) -> list
    let words = []
    let n = len(text)
    let i = 0
    while i < n and _hi_is_ws(ord(slice(text, i, i + 1))) == 1
        i += 1
    let start = i
    let in_word = 0
    if i < n
        in_word = 1
    while i < n
        let c = ord(slice(text, i, i + 1))
        if _hi_is_ws(c) == 1
            if in_word == 1
                words += [slice(text, start, i)]
                in_word = 0
        else
            if in_word == 0
                start = i
                in_word = 1
        i += 1
    if in_word == 1
        words += [slice(text, start, n)]
    words

// _hi_join_nl: join list of strings with chr(10).
fn _hi_join_nl(lines) -> string
    let out = ""
    let i = 0
    let n = len(lines)
    let nl = chr(10)
    while i < n
        if i > 0
            out += nl
        out += lines[i]
        i += 1
    out

// _hi_repeat_space: produce a string of `n` spaces.
fn _hi_repeat_space(n) -> string
    let out_parts = []
    for i in 0..n
        push(out_parts, " ")
    let out = join(out_parts, "")
    out

// _hi_str_n: convert an integer to its decimal string representation.
fn _hi_str_n(n) -> string
    str(n)

// _hi_wrap_two_widths: wrap words list using first_width for line 0 and
// rest_width for subsequent lines. Returns list of raw word-content lines
// (no indentation applied here).
fn _hi_wrap_two_widths(words, first_width, rest_width) -> list
    let lines = []
    let nw = len(words)
    if nw == 0
        return lines
    let cur = ""
    let cur_len = 0
    let line_idx = 0
    for i in 0..nw
        let word = words[i]
        let wlen = len(word)
        let max_w = rest_width
        if line_idx == 0
            max_w = first_width
        if cur_len == 0
            cur = word
            cur_len = wlen
        else
            if cur_len + 1 + wlen <= max_w
                cur += " " + word
                cur_len += 1 + wlen
            else
                lines += [cur]
                line_idx += 1
                cur = word
                cur_len = wlen
    if cur_len > 0
        lines += [cur]
    lines

// ── public API ────────────────────────────────────────────────────────────────

// hi_continuation_width(width, indent) -> int
// Returns the content width available on continuation lines.
fn hi_continuation_width(width, indent) -> int
    let w = width - indent
    if w < 1
        return 1
    w

// hi_hang(text, width, indent) -> string
// First line starts at column 0 (full `width`). Continuation lines are
// indented by `indent` spaces with content width = width - indent.
fn hi_hang(text, width, indent) -> string
    if width <= 0
        return ""
    let words = _hi_split_words(text)
    let nw = len(words)
    if nw == 0
        return ""
    let cont_width = hi_continuation_width(width, indent)
    let raw_lines = _hi_wrap_two_widths(words, width, cont_width)
    let nl_char = chr(10)
    let pad = _hi_repeat_space(indent)
    let result = ""
    let i = 0
    let nl = len(raw_lines)
    while i < nl
        if i > 0
            result += nl_char
        if i == 0
            result += raw_lines[i]
        else
            result += pad + raw_lines[i]
        i += 1
    result

// hi_bullet(text, width, bullet) -> string
// The bullet marker appears on the first line; continuation lines are indented
// by len(bullet) spaces so the text columns align.
fn hi_bullet(text, width, bullet) -> string
    if width <= 0
        return ""
    let blen = len(bullet)
    let words = _hi_split_words(text)
    let nw = len(words)
    if nw == 0
        return bullet
    let first_width = width - blen
    if first_width < 1
        first_width = 1
    let cont_width = first_width
    let raw_lines = _hi_wrap_two_widths(words, first_width, cont_width)
    let nl_char = chr(10)
    let pad = _hi_repeat_space(blen)
    let result = ""
    let i = 0
    let nl = len(raw_lines)
    while i < nl
        if i > 0
            result += nl_char
        if i == 0
            result += bullet + raw_lines[i]
        else
            result += pad + raw_lines[i]
        i += 1
    result

// hi_numbered(items, width) -> string
// Format a list of text items as a numbered list "1. item text ...".
// The hanging indent is computed from the width of the number+". " prefix
// so continuation lines align under the text.
fn hi_numbered(items, width) -> string
    let n = len(items)
    if n == 0
        return ""
    let nl_char = chr(10)
    let result = ""
    for i in 0..n
        let num_str = _hi_str_n(i + 1)
        let bullet = num_str + ". "
        let block = hi_bullet(items[i], width, bullet)
        if i > 0
            result += nl_char
        result += block
    result

// hi_first_indent(text, width, first, rest) -> string
// Wrap text to `width`; prepend `first` to line 0 and `rest` to all others.
// Effective content widths: width-len(first) for line 0, width-len(rest) for rest.
fn hi_first_indent(text, width, first, rest) -> string
    if width <= 0
        return ""
    let words = _hi_split_words(text)
    let nw = len(words)
    if nw == 0
        return ""
    let fw = width - len(first)
    let rw = width - len(rest)
    if fw < 1
        fw = 1
    if rw < 1
        rw = 1
    let raw_lines = _hi_wrap_two_widths(words, fw, rw)
    let nl_char = chr(10)
    let result_parts = []
    let i = 0
    let nl = len(raw_lines)
    while i < nl
        if i > 0
            push(result_parts, nl_char)
        if i == 0
            push(result_parts, first + raw_lines[i])
        else
            push(result_parts, rest + raw_lines[i])
        i += 1
    let result = join(result_parts, "")
    result

// hi_dedent_hang(text, indent) -> string
// Remove exactly `indent` leading spaces from every line that has them.
// Lines with fewer than `indent` leading spaces are left unchanged.
fn hi_dedent_hang(text, indent) -> string
    if indent <= 0
        return text
    let nl_char = chr(10)
    let raw = split(text, nl_char)
    let nr = len(raw)
    let out_lines = []
    for i in 0..nr
        let line = raw[i]
        let llen = len(line)
        // Count leading spaces.
        let sp = 0
        let j = 0
        while j < llen and j < indent
            if ord(slice(line, j, j + 1)) == 32
                sp += 1
            else
                j = llen  // break
            j += 1
        if sp >= indent
            out_lines += [slice(line, indent, llen)]
        else
            out_lines += [line]
    _hi_join_nl(out_lines)
