// ============================================================================
// NOVA Standard Library — std/textlayout/reflow
// ============================================================================
// Paragraph reflow: split text into paragraphs on blank lines, unwrap each
// paragraph into one logical line, then rewrap to the target width.
// All functions are SELF-CONTAINED: no imports; helpers are file-private.
//
// Public API (prefix rf_):
//   rf_is_blank(line) -> bool
//       True if the line is empty or contains only whitespace.
//
//   rf_paragraphs(text) -> any
//       Split text on blank lines; return a list of paragraph strings
//       (each paragraph is the raw multi-line block with its own newlines,
//       blank lines stripped from the boundaries).
//
//   rf_unwrap(para) -> string
//       Join the (possibly wrapped) lines of one paragraph into a single
//       logical line separated by single spaces.
//
//   rf_reflow_para(para, width) -> string
//       Unwrap a paragraph then greedy-wrap it to `width`.
//
//   rf_join_paragraphs(paras) -> string
//       Join a list of paragraph strings with a single blank line between them.
//
//   rf_squeeze_blanks(text) -> string
//       Collapse consecutive blank lines into a single blank line.
//
//   rf_reflow(text, width) -> string
//       Full reflow pipeline: split into paragraphs, unwrap, rewrap to width,
//       rejoin with blank lines between paragraphs.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── private helpers ───────────────────────────────────────────────────────────

// _rf_split_lines: split text on chr(10) returning ALL segments including
// trailing empty ones (unlike splitlines in some modules). Used internally
// so we preserve blank lines as separators.
fn _rf_split_lines(text) -> list
    let nl = chr(10)
    let raw = split(text, nl)
    raw

// _rf_trim_ws(s) -> string: strip leading and trailing spaces.
fn _rf_trim_ws(s) -> string
    let n = len(s)
    let i = 0
    while i < n
        let c = ord(slice(s, i, i + 1))
        if c != 32 and c != 9 and c != 13
            // found first non-ws
            let j = n - 1
            while j >= i
                let c2 = ord(slice(s, j, j + 1))
                if c2 != 32 and c2 != 9 and c2 != 13
                    return slice(s, i, j + 1)
                j = j - 1
            return slice(s, i, i + 1)
        i = i + 1
    ""

// _rf_join_nl: join a list with chr(10).
fn _rf_join_nl(lines) -> string
    let out = ""
    let i = 0
    let n = len(lines)
    let nl = chr(10)
    while i < n
        if i > 0
            out = out + nl
        out = out + lines[i]
        i = i + 1
    out

// _rf_split_words: split a string on spaces/tabs, returning non-empty tokens.
fn _rf_split_words(text) -> list
    let words = []
    let n = len(text)
    let i = 0
    let start = 0
    let in_word = 0
    while i < n
        let c = ord(slice(text, i, i + 1))
        if c == 32 or c == 9
            if in_word == 1
                words = words + [slice(text, start, i)]
                in_word = 0
        else
            if in_word == 0
                start = i
                in_word = 1
        i = i + 1
    if in_word == 1
        words = words + [slice(text, start, n)]
    words

// _rf_greedy_wrap: wrap a list of words to at most `width` chars per line.
fn _rf_greedy_wrap(words, width) -> list
    let lines = []
    let nw = len(words)
    if nw == 0
        return lines
    let cur = ""
    let cur_len = 0
    let i = 0
    while i < nw
        let word = words[i]
        let wlen = len(word)
        if cur_len == 0
            cur = word
            cur_len = wlen
        else
            if cur_len + 1 + wlen <= width
                cur = cur + " " + word
                cur_len = cur_len + 1 + wlen
            else
                lines = lines + [cur]
                cur = word
                cur_len = wlen
        i = i + 1
    if cur_len > 0
        lines = lines + [cur]
    lines

// ── public API ────────────────────────────────────────────────────────────────

// rf_is_blank(line) -> bool
// True if the line is empty or contains only spaces/tabs.
fn rf_is_blank(line) -> bool
    let n = len(line)
    if n == 0
        return true
    let i = 0
    while i < n
        let c = ord(slice(line, i, i + 1))
        if c != 32 and c != 9 and c != 13
            return false
        i = i + 1
    true

// rf_paragraphs(text) -> any
// Split text on blank lines; return a list where each element is a paragraph
// string (non-blank lines joined with chr(10), with no leading/trailing
// blank lines within the paragraph).
fn rf_paragraphs(text) -> any
    let paras = []
    if len(text) == 0
        return paras
    let all_lines = _rf_split_lines(text)
    let n = len(all_lines)
    let cur_lines = []
    let i = 0
    while i < n
        let line = all_lines[i]
        if rf_is_blank(line) == true
            if len(cur_lines) > 0
                paras = paras + [_rf_join_nl(cur_lines)]
                cur_lines = []
        else
            cur_lines = cur_lines + [line]
        i = i + 1
    if len(cur_lines) > 0
        paras = paras + [_rf_join_nl(cur_lines)]
    paras

// rf_unwrap(para) -> string
// Join the (possibly soft-wrapped) lines of a paragraph into a single logical
// line, separated by single spaces. Trims each line of leading/trailing space.
fn rf_unwrap(para) -> string
    let lines = _rf_split_lines(para)
    let n = len(lines)
    let out = ""
    let i = 0
    while i < n
        let trimmed = _rf_trim_ws(lines[i])
        if len(trimmed) > 0
            if len(out) > 0
                out = out + " " + trimmed
            else
                out = trimmed
        i = i + 1
    out

// rf_reflow_para(para, width) -> string
// Unwrap a paragraph then greedy-wrap it to at most `width` chars per line.
fn rf_reflow_para(para, width) -> string
    let logical = rf_unwrap(para)
    if len(logical) == 0
        return ""
    let words = _rf_split_words(logical)
    let lines = _rf_greedy_wrap(words, width)
    _rf_join_nl(lines)

// rf_join_paragraphs(paras) -> string
// Join a list of paragraph strings with a single blank line between them.
fn rf_join_paragraphs(paras) -> string
    let n = len(paras)
    if n == 0
        return ""
    let nl = chr(10)
    let sep = nl + nl
    let out = paras[0]
    let i = 1
    while i < n
        out = out + sep + paras[i]
        i = i + 1
    out

// rf_squeeze_blanks(text) -> string
// Collapse runs of two or more consecutive blank lines into exactly one blank
// line (i.e. two adjacent chr(10) become exactly two chr(10): "...\n\n...").
fn rf_squeeze_blanks(text) -> string
    let all_lines = _rf_split_lines(text)
    let n = len(all_lines)
    let out_lines = []
    let blank_run = 0
    let i = 0
    while i < n
        let line = all_lines[i]
        if rf_is_blank(line) == true
            blank_run = blank_run + 1
            if blank_run <= 1
                out_lines = out_lines + [line]
        else
            blank_run = 0
            out_lines = out_lines + [line]
        i = i + 1
    _rf_join_nl(out_lines)

// rf_reflow(text, width) -> string
// Full reflow pipeline: split into paragraphs on blank lines, unwrap each
// paragraph, rewrap to `width`, rejoin with a single blank line between them.
fn rf_reflow(text, width) -> string
    if width <= 0
        return ""
    let paras = rf_paragraphs(text)
    let n = len(paras)
    if n == 0
        return ""
    let reflowed = []
    let i = 0
    while i < n
        reflowed = reflowed + [rf_reflow_para(paras[i], width)]
        i = i + 1
    rf_join_paragraphs(reflowed)
