// ============================================================================
// NOVA Standard Library — std/textlayout/truncate_text
// ============================================================================
// Truncation utilities for ASCII strings, with configurable ellipsis styles.
//
// All lengths are measured in characters (1 ASCII byte = 1 column).
//
// Ellipsis convention: the three-character literal "..." is used throughout.
//
// Public API (prefix tt_):
//   tt_visible_len(s)             -> int    character length (= len(s))
//   tt_needs_truncate(s, width)   -> bool   true if len(s) > width
//   tt_cut(s, width)              -> string hard cut to width chars, no ellipsis
//   tt_truncate(s, width)         -> string cut to width with "..." suffix
//   tt_shorten(s, width)          -> string alias for tt_truncate
//   tt_ellipsis_middle(s, width)  -> string keep head + tail, "..." in the middle
//   tt_truncate_word(s, width)    -> string word-boundary cut + "..."
//
// tt_truncate_word convention:
//   Find the longest prefix of whole words whose character count is <= width-3,
//   then append "...". If even a single word exceeds width-3, take zero words and
//   return "..." padded up to width (i.e. up to width dots or exactly "...").
//   If the full string fits within width, return it unchanged (no ellipsis).
//
// LEAF — imports nothing; all helpers prefixed tt_.

// ── private helpers ───────────────────────────────────────────────────────────

// Split text into words on spaces (chr(32)), skipping empty tokens.
fn _tt_split_words(text) -> list
    let words = []
    let cur = ""
    let i = 0
    let n = len(text)
    while i < n
        let ch = slice(text, i, i + 1)
        if ch == " "
            if len(cur) > 0
                words = words + [cur]
                cur = ""
        else
            cur = cur + ch
        i = i + 1
    if len(cur) > 0
        words = words + [cur]
    words

// ── public API ────────────────────────────────────────────────────────────────

// tt_visible_len: return the character length of s (each ASCII char = 1 column).
fn tt_visible_len(s) -> int
    len(s)

// tt_needs_truncate: return true if s is longer than width characters.
fn tt_needs_truncate(s, width) -> bool
    len(s) > width

// tt_cut: hard-cut s to exactly width characters, no ellipsis.
// If len(s) <= width, return s unchanged.
fn tt_cut(s, width) -> string
    let result = s
    if len(s) > width
        result = slice(s, 0, width)
    result

// tt_truncate: truncate s to at most width characters total, using "..." suffix.
// If len(s) <= width, return s unchanged.
// If width <= 3, return the first width characters of "..." (e.g. width=2 -> "..").
// Otherwise return slice(s, 0, width-3) + "..." (total = width chars).
fn tt_truncate(s, width) -> string
    let result = s
    if len(s) > width
        if width <= 3
            result = slice("...", 0, width)
        else
            result = slice(s, 0, width - 3) + "..."
    result

// tt_shorten: alias for tt_truncate.
fn tt_shorten(s, width) -> string
    tt_truncate(s, width)

// tt_ellipsis_middle: keep the start and end of s with "..." inserted in the
// middle so that the total length equals width. If len(s) <= width, return s.
// Allocation:
//   head_len = (width - 3) / 2          (integer division, floor)
//   tail_len = width - 3 - head_len
// If width <= 3, return the first width chars of "...".
fn tt_ellipsis_middle(s, width) -> string
    let slen = len(s)
    let result = s
    if slen > width
        if width <= 3
            result = slice("...", 0, width)
        else
            let head_len = (width - 3) / 2
            let tail_len = width - 3 - head_len
            let tail_start = slen - tail_len
            result = slice(s, 0, head_len) + "..." + slice(s, tail_start, slen)
    result

// tt_truncate_word: truncate s at a word boundary and append "...".
// Convention: greedily accumulate whole words (separated by spaces) as long as
// the accumulated text is <= (width - 3) characters. Then append "...".
// If the full string fits in width, return it unchanged (no "...").
// If zero words fit (the first word already exceeds width-3), and width > 3,
// return the first (width-3) characters of the first word + "..." (at most
// width chars total). If width <= 3, return the first width chars of "...".
fn tt_truncate_word(s, width) -> string
    let slen = len(s)
    let result = s
    if slen > width
        if width <= 3
            result = slice("...", 0, width)
        else
            let budget = width - 3
            let words = _tt_split_words(s)
            let nw = len(words)
            // Build the longest prefix of words fitting within budget.
            let acc = ""
            let acc_len = 0
            let i = 0
            let kept = 0
            while i < nw
                let wlen = len(words[i])
                let needed = acc_len
                if acc_len > 0
                    needed = acc_len + 1 + wlen
                else
                    needed = wlen
                if needed <= budget
                    if acc_len == 0
                        acc = words[i]
                        acc_len = wlen
                    else
                        acc = acc + " " + words[i]
                        acc_len = acc_len + 1 + wlen
                    kept = kept + 1
                else
                    // Stop — this word would exceed budget.
                    i = nw
                i = i + 1
            if kept == 0
                // Not even one word fits; hard-cut to budget chars.
                result = slice(s, 0, budget) + "..."
            else
                result = acc + "..."
    result
