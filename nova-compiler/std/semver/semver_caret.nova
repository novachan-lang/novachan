// std/semver/semver_caret.nova — SemVer 2.0.0 caret-range evaluation.
//
// Caret ranges (npm SemVer §6): ^MAJOR.MINOR.PATCH
//   Allows changes that do NOT modify the left-most non-zero element.
//   ^1.2.3  := >=1.2.3 <2.0.0   (major is non-zero: lock major)
//   ^0.2.3  := >=0.2.3 <0.3.0   (major=0, minor non-zero: lock minor)
//   ^0.0.3  := >=0.0.3 <0.0.4   (both zero: lock patch)
//
// Public API (prefix svr_):
//   svr_lower(range)              — minimum inclusive version string (strips '^')
//   svr_upper(range)              — exclusive upper bound version string
//   svr_satisfies(version, range) — true iff version >= lower AND version < upper
//
// KAT vectors (hand-verified against npm SemVer spec §6):
//   svr_satisfies("1.5.0","^1.2.3") = true   (1.5.0 in [1.2.3,2.0.0))
//   svr_satisfies("2.0.0","^1.2.3") = false  (2.0.0 >= 2.0.0 upper)
//   svr_satisfies("1.2.2","^1.2.3") = false  (below lower)
//   svr_satisfies("0.2.5","^0.2.3") = true   (0.2.5 in [0.2.3,0.3.0))
//   svr_satisfies("0.3.0","^0.2.3") = false  (at upper bound)
//   svr_satisfies("0.0.3","^0.0.3") = true   (exactly lower)
//   svr_satisfies("0.0.4","^0.0.3") = false  (above patch upper 0.0.4)

// Parse a non-negative decimal integer from a digit string.
fn _svr_parse_int(s) -> int
    let n = len(s)
    let i = 0
    let v = 0
    while i < n
        let d = ord(slice(s, i, i + 1)) - 48
        if d >= 0 and d <= 9
            v = v * 10 + d
        i = i + 1
    return v

// Parse "MAJOR.MINOR.PATCH[-pre][+build]" -> [major, minor, patch].
// Prerelease and build are stripped; malformed parts default to 0.
fn _svr_parse(s) -> list
    let core = s
    let slen = len(s)
    let i = 0
    while i < slen
        let ch = slice(s, i, i + 1)
        if ch == "+" or ch == "-"
            core = slice(s, 0, i)
            i = slen
        i = i + 1
    let parts = split(core, ".")
    let major = 0
    let minor = 0
    let patch = 0
    if len(parts) >= 1
        major = _svr_parse_int(parts[0])
    if len(parts) >= 2
        minor = _svr_parse_int(parts[1])
    if len(parts) >= 3
        patch = _svr_parse_int(parts[2])
    return [major, minor, patch]

// Compare two version triples [maj,min,pat]: returns -1, 0, or 1.
// Prerelease ignored; build ignored (compare core only per SemVer §11).
fn _svr_cmp(a, b) -> int
    if a[0] != b[0]
        if a[0] < b[0]
            return -1
        return 1
    if a[1] != b[1]
        if a[1] < b[1]
            return -1
        return 1
    if a[2] != b[2]
        if a[2] < b[2]
            return -1
        return 1
    return 0

// Strip leading '^' from a range string and return the bare version.
fn _svr_strip(range) -> str
    if len(range) > 0 and slice(range, 0, 1) == "^"
        return slice(range, 1, len(range))
    return range

// Format [major, minor, patch] as "X.Y.Z".
fn _svr_fmt(major, minor, patch) -> str
    return str(major) + "." + str(minor) + "." + str(patch)

// Lower bound (inclusive) of a caret range: the version itself (without '^').
fn svr_lower(range) -> str
    return _svr_strip(range)

// Exclusive upper bound of a caret range per npm SemVer §6:
//   ^X.Y.Z where X>0  -> (X+1).0.0
//   ^0.Y.Z where Y>0  -> 0.(Y+1).0
//   ^0.0.Z            -> 0.0.(Z+1)
fn svr_upper(range) -> str
    let bare = _svr_strip(range)
    let p = _svr_parse(bare)
    let major = p[0]
    let minor = p[1]
    let patch = p[2]
    if major > 0
        return _svr_fmt(major + 1, 0, 0)
    if minor > 0
        return _svr_fmt(0, minor + 1, 0)
    return _svr_fmt(0, 0, patch + 1)

// True iff version satisfies the caret range: lower <= version < upper.
// Prerelease/build in version string are stripped for core comparison.
fn svr_satisfies(version, range) -> bool
    let lo = _svr_parse(svr_lower(range))
    let hi = _svr_parse(svr_upper(range))
    let vp = _svr_parse(version)
    let ge_lo = _svr_cmp(vp, lo) >= 0
    let lt_hi = _svr_cmp(vp, hi) < 0
    return ge_lo and lt_hi
