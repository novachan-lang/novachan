// std/semver/semver_tilde.nova — SemVer 2.0.0 tilde-range evaluation.
//
// Tilde ranges (npm SemVer §5): ~MAJOR.MINOR.PATCH / ~MAJOR.MINOR / ~MAJOR
//   ~1.2.3  := >=1.2.3 <1.3.0   (patch-level changes only)
//   ~1.2    := >=1.2.0 <1.3.0   (patch-level changes; same as ~1.2.0)
//   ~1      := >=1.0.0 <2.0.0   (minor+patch changes within major 1)
//
// The tilde locks the minor version when MINOR is specified; when only
// MAJOR is given it locks only the major version.
//
// Public API (prefix svt_):
//   svt_lower(range)              — minimum inclusive version string (strips '~')
//   svt_upper(range)              — exclusive upper bound version string
//   svt_satisfies(version, range) — true iff version >= lower AND version < upper
//
// KAT vectors (hand-verified against npm SemVer spec §5):
//   svt_satisfies("1.2.5","~1.2.3") = true   (patch bump, same minor)
//   svt_satisfies("1.3.0","~1.2.3") = false  (at minor upper 1.3.0)
//   svt_satisfies("1.2.3","~1.2.3") = true   (exactly lower)
//   svt_satisfies("1.2.2","~1.2.3") = false  (below lower)
//   svt_satisfies("1.2.9","~1.2")   = true   (patch bump within 1.2.x)
//   svt_satisfies("1.3.0","~1.2")   = false  (at minor upper 1.3.0)
//   svt_satisfies("1.9.9","~1")     = true   (any minor/patch in major 1)

// Parse a non-negative decimal integer from a digit string.
fn _svt_parse_int(s) -> int
    let n = len(s)
    let i = 0
    let v = 0
    while i < n
        let d = ord(slice(s, i, i + 1)) - 48
        if d >= 0 and d <= 9
            v = v * 10 + d
        i += 1
    return v

// Parse version string (core only, strips prerelease/build) -> [major, minor, patch].
// Returns -1 for patch (and -1 for minor) when component is absent.
// "1"     -> [1, -1, -1]
// "1.2"   -> [1,  2, -1]
// "1.2.3" -> [1,  2,  3]
fn _svt_parse(s) -> list
    let core = s
    let slen = len(s)
    let i = 0
    while i < slen
        let ch = slice(s, i, i + 1)
        if ch == "+" or ch == "-"
            core = slice(s, 0, i)
            i = slen
        i += 1
    let parts = split(core, ".")
    let np = len(parts)
    let major = 0
    let minor = -1
    let patch = -1
    if np >= 1
        major = _svt_parse_int(parts[0])
    if np >= 2
        minor = _svt_parse_int(parts[1])
    if np >= 3
        patch = _svt_parse_int(parts[2])
    return [major, minor, patch]

// Compare two fully-specified version triples [maj,min,pat]: -1, 0, or 1.
fn _svt_cmp(a, b) -> int
    if a[0] != b[0]
        if a[0] < b[0]
            return -1
        return 1
    if a[1] != b[1]
        if a[1] < b[1]
            return -1
        return 1
    if a[2] != b[2]
        if a[2] < b[2]
            return -1
        return 1
    return 0

// Strip leading '~' and return the bare version fragment.
fn _svt_strip(range) -> str
    if len(range) > 0 and slice(range, 0, 1) == "~"
        return slice(range, 1, len(range))
    return range

// Format three ints as "X.Y.Z".
fn _svt_fmt(major, minor, patch) -> str
    return str(major) + "." + str(minor) + "." + str(patch)

// Lower bound (inclusive): bare version with missing minor/patch filled in as 0.
// "~1.2.3" -> "1.2.3"; "~1.2" -> "1.2.0"; "~1" -> "1.0.0"
fn svt_lower(range) -> str
    let bare = _svt_strip(range)
    let p = _svt_parse(bare)
    let major = p[0]
    let minor = p[1]
    let patch = p[2]
    if minor < 0
        minor = 0
    if patch < 0
        patch = 0
    return _svt_fmt(major, minor, patch)

// Exclusive upper bound per npm SemVer §5:
//   If MINOR was specified: upper = MAJOR.(MINOR+1).0
//   If only MAJOR given:    upper = (MAJOR+1).0.0
fn svt_upper(range) -> str
    let bare = _svt_strip(range)
    let p = _svt_parse(bare)
    let major = p[0]
    let minor = p[1]
    if minor >= 0
        return _svt_fmt(major, minor + 1, 0)
    return _svt_fmt(major + 1, 0, 0)

// True iff version satisfies the tilde range: lower <= version < upper.
// Prerelease/build in version string are stripped for core comparison.
fn svt_satisfies(version, range) -> bool
    let lo_str = svt_lower(range)
    let hi_str = svt_upper(range)
    let lo = _svt_parse(lo_str)
    let hi = _svt_parse(hi_str)
    let vp = _svt_parse(version)
    let vfull = [vp[0], vp[1], vp[2]]
    if vfull[1] < 0
        vfull[1] = 0
    if vfull[2] < 0
        vfull[2] = 0
    let lofull = [lo[0], lo[1], lo[2]]
    let hifull = [hi[0], hi[1], hi[2]]
    if lofull[1] < 0
        lofull[1] = 0
    if lofull[2] < 0
        lofull[2] = 0
    if hifull[1] < 0
        hifull[1] = 0
    if hifull[2] < 0
        hifull[2] = 0
    let ge_lo = _svt_cmp(vfull, lofull) >= 0
    let lt_hi = _svt_cmp(vfull, hifull) < 0
    return ge_lo and lt_hi
