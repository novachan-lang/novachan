// std/semver/semver_comparator -- SemVer 2.0.0 single-comparator evaluation.
// LEAF -- imports NOTHING.
//
// A single comparator is one of:
//   '>=1.2.3'  '<=1.2.3'  '>1.2.3'  '<1.2.3'  '=1.2.3'  or bare '1.2.3' (means =).
//
// Public API:
//   svcmp_operator(comparator)            -> string  ('>=','<=','>','<','=')
//   svcmp_version(comparator)             -> string  (the version portion)
//   svcmp_satisfies(version, comparator)  -> int     (1 if satisfied, 0 otherwise)

// PRIVATE: parse non-negative integer from digit string; -1 on bad input.
fn _svcmp_parse_int(s: string) -> int
    let n = len(s)
    if n == 0
        return -1
    let v = 0
    for i in 0..n
        let o = ord(char_at(s, i))
        if o < 48 or o > 57
            return -1
        v = v * 10 + (o - 48)
    v

// PRIVATE: parse 'major.minor.patch[-pre][+build]' -> [maj, min, pat, pre, build].
fn _svcmp_parse_ver(v: string) -> list
    let maj = 0
    let mn = 0
    let pat = 0
    let pre = ""
    let bld = ""
    // isolate build metadata after '+'
    let bplus = split(v, "+")
    let core = bplus[0]
    if len(bplus) >= 2
        bld = bplus[1]
    // isolate pre-release after first '-'
    let dashparts = split(core, "-")
    let vercore = dashparts[0]
    if len(dashparts) >= 2
        for pi in 1..len(dashparts)
            if pre == ""
                pre = dashparts[pi]
            else
                pre = pre + "-" + dashparts[pi]
    let parts = split(vercore, ".")
    if len(parts) >= 1
        let pm = _svcmp_parse_int(parts[0])
        if pm >= 0
            maj = pm
    if len(parts) >= 2
        let pn = _svcmp_parse_int(parts[1])
        if pn >= 0
            mn = pn
    if len(parts) >= 3
        let pp = _svcmp_parse_int(parts[2])
        if pp >= 0
            pat = pp
    let r = []
    push(r, maj)
    push(r, mn)
    push(r, pat)
    push(r, pre)
    push(r, bld)
    r

// PRIVATE: compare pre-release identifier strings per SemVer §11.
fn _svcmp_cmp_pre_id(a: string, b: string) -> int
    if a == b
        return 0
    let an = _svcmp_parse_int(a)
    let bn = _svcmp_parse_int(b)
    if an >= 0 and bn >= 0
        if an < bn
            return -1
        if an > bn
            return 1
        return 0
    if an >= 0 and bn < 0
        return -1
    if an < 0 and bn >= 0
        return 1
    if a < b
        return -1
    if a > b
        return 1
    0

// PRIVATE: compare full pre-release strings per SemVer §11.4.
fn _svcmp_cmp_pre(apre: string, bpre: string) -> int
    if apre == bpre
        return 0
    if apre == "" and bpre != ""
        return 1
    if apre != "" and bpre == ""
        return -1
    let aids = split(apre, ".")
    let bids = split(bpre, ".")
    let na = len(aids)
    let nb = len(bids)
    let shorter = na
    if nb < shorter
        shorter = nb
    let i = 0
    let result = 0
    let done = 0
    while i < shorter and done == 0
        let c = _svcmp_cmp_pre_id(aids[i], bids[i])
        if c != 0
            result = c
            done = 1
        i = i + 1
    if done == 0
        if na < nb
            return -1
        if na > nb
            return 1
    result

// PRIVATE: compare two fully-parsed versions. Returns -1, 0, or 1.
// Build metadata (index 4) ignored per SemVer §10.
fn _svcmp_cmp_parsed(ap: list, bp: list) -> int
    let amaj = ap[0]
    let amin = ap[1]
    let apat = ap[2]
    let apre = ap[3]
    let bmaj = bp[0]
    let bmin = bp[1]
    let bpat = bp[2]
    let bpre = bp[3]
    if amaj < bmaj
        return -1
    if amaj > bmaj
        return 1
    if amin < bmin
        return -1
    if amin > bmin
        return 1
    if apat < bpat
        return -1
    if apat > bpat
        return 1
    _svcmp_cmp_pre(apre, bpre)

// PRIVATE: extract the operator prefix from a comparator string.
// Recognized prefixes: '>=', '<=', '>', '<', '='. Bare versions yield '='.
fn _svcmp_get_op(comparator: string) -> string
    let n = len(comparator)
    if n == 0
        return "="
    let c0 = char_at(comparator, 0)
    if c0 == ">"
        if n >= 2 and char_at(comparator, 1) == "="
            return ">="
        return ">"
    if c0 == "<"
        if n >= 2 and char_at(comparator, 1) == "="
            return "<="
        return "<"
    if c0 == "="
        // could be '=1.2.3'
        return "="
    // no operator prefix: bare version treated as '='
    "="

// svcmp_operator(">=1.2.3") -> ">="
// svcmp_operator("1.2.3")   -> "="
fn svcmp_operator(comparator: string) -> string
    let op = _svcmp_get_op(comparator)
    op

// svcmp_version(">=1.2.3") -> "1.2.3"
// svcmp_version("1.2.3")   -> "1.2.3"
fn svcmp_version(comparator: string) -> string
    let n = len(comparator)
    if n == 0
        return ""
    let c0 = char_at(comparator, 0)
    if c0 == ">"
        if n >= 2 and char_at(comparator, 1) == "="
            let s = slice(comparator, 2, n)
            return s
        let s2 = slice(comparator, 1, n)
        return s2
    if c0 == "<"
        if n >= 2 and char_at(comparator, 1) == "="
            let s3 = slice(comparator, 2, n)
            return s3
        let s4 = slice(comparator, 1, n)
        return s4
    if c0 == "="
        let s5 = slice(comparator, 1, n)
        return s5
    // bare version
    comparator

// svcmp_satisfies("1.5.0", ">=1.2.3") -> 1
// svcmp_satisfies("1.2.3", ">1.2.3")  -> 0
// svcmp_satisfies("1.9.9", "<2.0.0")  -> 1
// svcmp_satisfies("1.2.3", "=1.2.3")  -> 1
// svcmp_satisfies("1.2.3", "1.2.3")   -> 1
fn svcmp_satisfies(version: string, comparator: string) -> int
    let op = _svcmp_get_op(comparator)
    let ver_str = svcmp_version(comparator)
    let vp = _svcmp_parse_ver(version)
    let cp = _svcmp_parse_ver(ver_str)
    let c = _svcmp_cmp_parsed(vp, cp)
    if op == ">="
        if c >= 0
            return 1
        return 0
    if op == "<="
        if c <= 0
            return 1
        return 0
    if op == ">"
        if c > 0
            return 1
        return 0
    if op == "<"
        if c < 0
            return 1
        return 0
    // op == "=" (default / bare)
    if c == 0
        return 1
    0
