// ============================================================================
// NOVA Standard Library -- std/semver/semver_sort.nova
// SemVer 2.0.0 sorting and extrema.
// LEAF -- imports NOTHING.
//
// Public API (prefix: svso_)
//   svso_sort(versions)   -> list  ascending by SemVer precedence (stable insertion sort)
//   svso_rsort(versions)  -> list  descending by SemVer precedence
//   svso_max(versions)    -> string  highest-precedence version or '' if empty
//   svso_min(versions)    -> string  lowest-precedence version or '' if empty
// ============================================================================

// ── internal: digit helpers ──────────────────────────────────────────────────

// True iff the 1-char string c is an ASCII digit.
fn _svso_is_digit(c: string) -> bool
    let b = ord(c)
    if b < 48
        return false
    if b > 57
        return false
    true

// True iff every character of s is a digit AND s is non-empty.
fn _svso_all_digits(s: string) -> bool
    let n = len(s)
    if n == 0
        return false
    let i = 0
    let ok = 1
    while i < n
        if not _svso_is_digit(slice(s, i, i + 1))
            ok = 0
        i += 1
    ok == 1

// Parse a non-negative decimal integer from a digit string; 0 on empty/invalid.
fn _svso_atoi(s: string) -> int
    let n = len(s)
    let v = 0
    for i in 0..n
        let b = ord(slice(s, i, i + 1))
        if b >= 48
            if b <= 57
                v = v * 10 + (b - 48)
    v

// ── internal: semver parse ────────────────────────────────────────────────────

// Parse 'X.Y.Z[-pre][+build]' into [major, minor, patch, pre, build].
// Strips leading 'v'. Missing minor/patch default to 0.
fn _svso_parse(s: string) -> list
    let src = s
    if len(src) > 0
        if slice(src, 0, 1) == "v"
            src = slice(src, 1, len(src))
    // strip build metadata
    let build = ""
    let plus = find(src, "+")
    if plus >= 0
        build = slice(src, plus + 1, len(src))
        src = slice(src, 0, plus)
    // split prerelease
    let pre = ""
    let dash = find(src, "-")
    if dash >= 0
        pre = slice(src, dash + 1, len(src))
        src = slice(src, 0, dash)
    let parts = split(src, ".")
    let major = 0
    let minor = 0
    let patch = 0
    if len(parts) >= 1
        major = _svso_atoi(parts[0])
    if len(parts) >= 2
        minor = _svso_atoi(parts[1])
    if len(parts) >= 3
        patch = _svso_atoi(parts[2])
    let result = []
    push(result, major)
    push(result, minor)
    push(result, patch)
    push(result, pre)
    push(result, build)
    result

// ── internal: prerelease comparison ──────────────────────────────────────────

// Compare two single prerelease dot-identifiers per SemVer §11.4.
fn _svso_cmp_pr_id(a: string, b: string) -> int
    let a_num = _svso_all_digits(a)
    let b_num = _svso_all_digits(b)
    if a_num and b_num
        let av = _svso_atoi(a)
        let bv = _svso_atoi(b)
        if av < bv
            return -1
        if av > bv
            return 1
        return 0
    if a_num and not b_num
        return -1
    if not a_num and b_num
        return 1
    if a < b
        return -1
    if a > b
        return 1
    0

// Compare prerelease strings. '' = no prerelease = higher than any with pre.
fn _svso_cmp_pre(a: string, b: string) -> int
    if a == "" and b == ""
        return 0
    if a != "" and b == ""
        return -1
    if a == "" and b != ""
        return 1
    let pa = split(a, ".")
    let pb = split(b, ".")
    let la = len(pa)
    let lb = len(pb)
    let min_len = la
    if lb < la
        min_len = lb
    for i in 0..min_len
        let c = _svso_cmp_pr_id(pa[i], pb[i])
        if c != 0
            return c
    if la < lb
        return -1
    if la > lb
        return 1
    0

// ── internal: full version comparison ────────────────────────────────────────

// Compare two parsed 5-element version lists. Returns -1, 0, or 1.
fn _svso_cmp(a: list, b: list) -> int
    let amaj = a[0]
    let bmaj = b[0]
    if amaj < bmaj
        return -1
    if amaj > bmaj
        return 1
    let amin = a[1]
    let bmin = b[1]
    if amin < bmin
        return -1
    if amin > bmin
        return 1
    let apat = a[2]
    let bpat = b[2]
    if apat < bpat
        return -1
    if apat > bpat
        return 1
    let ap = a[3]
    let bp = b[3]
    _svso_cmp_pre(ap, bp)

// Compare two raw version strings. Returns -1, 0, or 1.
fn _svso_cmp_str(a: string, b: string) -> int
    _svso_cmp(_svso_parse(a), _svso_parse(b))

// ── internal: insertion sort ──────────────────────────────────────────────────

// Copy a list of strings into a new list (to avoid mutating the input).
fn _svso_copy_list(src: list) -> list
    let out = [src[i] for i in 0..len(src)]
    out

// In-place insertion sort (ascending) on a list of version strings.
// Uses a done-flag approach; NO negative-index sentinel.
fn _svso_isort_asc(lst: list)
    let n = len(lst)
    for i in 1..n
        let key = lst[i]
        let j = i - 1
        let placed = 0
        while j >= 0
            if placed == 0
                if _svso_cmp_str(lst[j], key) > 0
                    lst[j + 1] = lst[j]
                    j -= 1
                else
                    lst[j + 1] = key
                    placed = 1
                    j = -1
            else
                j = -1
        if placed == 0
            lst[0] = key

// ── public API ───────────────────────────────────────────────────────────────

// svso_sort -- return a new list of versions sorted ascending by SemVer precedence.
fn svso_sort(versions: list) -> list
    let out = _svso_copy_list(versions)
    _svso_isort_asc(out)
    out

// svso_rsort -- return a new list of versions sorted descending by SemVer precedence.
fn svso_rsort(versions: list) -> list
    let out = _svso_copy_list(versions)
    _svso_isort_asc(out)
    // reverse the sorted list
    let n = len(out)
    let rev = []
    let i = n - 1
    while i >= 0
        push(rev, out[i])
        i -= 1
    rev

// svso_max -- return the highest-precedence version string, or '' if empty.
fn svso_max(versions: list) -> string
    let n = len(versions)
    if n == 0
        return ""
    let best = versions[0]
    for i in 1..n
        if _svso_cmp_str(versions[i], best) > 0
            best = versions[i]
    best

// svso_min -- return the lowest-precedence version string, or '' if empty.
fn svso_min(versions: list) -> string
    let n = len(versions)
    if n == 0
        return ""
    let best = versions[0]
    for i in 1..n
        if _svso_cmp_str(versions[i], best) < 0
            best = versions[i]
    best
