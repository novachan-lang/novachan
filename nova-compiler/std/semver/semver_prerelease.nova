// std/semver/semver_prerelease.nova — SemVer 2.0.0 pre-release comparison.
// Implements §11 pre-release precedence rules: split on '.', compare identifiers
// left-to-right.  A purely-numeric identifier compares numerically and ranks
// LOWER than an alphanumeric one.  More identifiers (longer) wins when the shared
// prefix is equal.  Empty string = no pre-release = HIGHEST precedence.
// Self-contained: imports nothing.

// _svp_parse_uint — parse all-digit string to integer (0 if empty/non-digit).
fn _svp_parse_uint(s: string) -> int
    let n = len(s)
    if n == 0
        return 0
    let val = 0
    for i in 0..n
        let d = ord(slice(s, i, i + 1)) - 48
        if d < 0 or d > 9
            return 0
        val = val * 10 + d
    val

// svp_is_numeric_ident — true if id is a non-empty string containing only digits.
fn svp_is_numeric_ident(id: string) -> bool
    let n = len(id)
    if n == 0
        return false
    for i in 0..n
        let d = ord(slice(id, i, i + 1)) - 48
        if d < 0 or d > 9
            return false
    true

// svp_compare — compare two pre-release strings per SemVer §11.4.
// '' (empty) means no pre-release, which has HIGHEST precedence (returns 1 vs any non-empty).
// Numeric identifiers rank lower than alphanumeric; longer list wins on equal prefix.
fn svp_compare(pre_a: string, pre_b: string) -> int
    if pre_a == "" and pre_b == ""
        return 0
    if pre_a == ""
        return 1
    if pre_b == ""
        return -1
    let pa = split(pre_a, ".")
    let pb = split(pre_b, ".")
    let la = len(pa)
    let lb = len(pb)
    let minl = la
    if lb < la
        minl = lb
    for i in 0..minl
        let ia = pa[i]
        let ib = pb[i]
        let ia_num = svp_is_numeric_ident(ia)
        let ib_num = svp_is_numeric_ident(ib)
        if ia_num and ib_num
            // Both numeric: integer comparison
            let va = _svp_parse_uint(ia)
            let vb = _svp_parse_uint(ib)
            if va < vb
                return -1
            if va > vb
                return 1
        else
            if ia_num and not ib_num
                // Numeric < alphanumeric
                return -1
            if not ia_num and ib_num
                // Alphanumeric > numeric
                return 1
            // Both alphanumeric: ASCII lexicographic
            if ia < ib
                return -1
            if ia > ib
                return 1
    // All shared identifiers equal: longer list has higher precedence
    if la < lb
        return -1
    if la > lb
        return 1
    0
