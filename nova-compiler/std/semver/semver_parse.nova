// std/semver/semver_parse.nova — SemVer 2.0.0 parsing and validation.
// Parses "MAJOR.MINOR.PATCH[-prerelease][+build]" into a 5-element list
// [major:int, minor:int, patch:int, prerelease:string, build:string].
// prerelease and build are '' when absent.  Self-contained: imports nothing.

// _sv_parse_uint — scan decimal digits from s; return value, or -1 on empty/non-digit.
fn _sv_parse_uint(s: string) -> int
    let n = len(s)
    if n == 0
        return -1
    let val = 0
    for i in 0..n
        let ch = slice(s, i, i + 1)
        let d = ord(ch) - 48
        if d < 0 or d > 9
            return -1
        val = val * 10 + d
    val

// _sv_find_char — first index of ch in s, or -1 if absent.
fn _sv_find_char(s: string, ch: string) -> int
    let n = len(s)
    for i in 0..n
        if slice(s, i, i + 1) == ch
            return i
    -1

// _sv_has_leading_zero — true when s is a decimal integer with a leading zero
// AND is not exactly "0".
fn _sv_has_leading_zero(s: string) -> bool
    if len(s) < 2
        return false
    slice(s, 0, 1) == "0"

// _sv_is_numeric_only — true when every char of s is 0-9.
fn _sv_is_numeric_only(s: string) -> bool
    let n = len(s)
    if n == 0
        return false
    for i in 0..n
        let d = ord(slice(s, i, i + 1)) - 48
        if d < 0 or d > 9
            return false
    true

// _sv_valid_pre_id — a valid pre-release identifier is non-empty, contains only
// [0-9A-Za-z-], and if purely numeric must not have leading zeros.
fn _sv_valid_pre_id(id: string) -> bool
    let n = len(id)
    if n == 0
        return false
    for i in 0..n
        let c = slice(id, i, i + 1)
        let o = ord(c)
        let ok = (o >= 48 and o <= 57) or (o >= 65 and o <= 90) or (o >= 97 and o <= 122) or c == "-"
        if not ok
            return false
    if _sv_is_numeric_only(id)
        return not _sv_has_leading_zero(id)
    true

// _sv_valid_build_id — a valid build identifier is non-empty, contains only
// [0-9A-Za-z-].  Leading zeros ARE allowed in build identifiers.
fn _sv_valid_build_id(id: string) -> bool
    let n = len(id)
    if n == 0
        return false
    for i in 0..n
        let c = slice(id, i, i + 1)
        let o = ord(c)
        let ok = (o >= 48 and o <= 57) or (o >= 65 and o <= 90) or (o >= 97 and o <= 122) or c == "-"
        if not ok
            return false
    true

// sv_parse — parse s into [major, minor, patch, prerelease, build].
// On malformed input returns [0, 0, 0, '', ''] (graceful degradation).
fn sv_parse(s: string) -> list
    let pre = ""
    let build = ""
    let core = s
    // Strip build metadata (after first '+')
    let plus = _sv_find_char(core, "+")
    if plus >= 0
        build = slice(core, plus + 1, len(core))
        core = slice(core, 0, plus)
    // Strip pre-release (after first '-')
    let dash = _sv_find_char(core, "-")
    if dash >= 0
        pre = slice(core, dash + 1, len(core))
        core = slice(core, 0, dash)
    let parts = split(core, ".")
    let major = 0
    let minor = 0
    let patch = 0
    if len(parts) >= 1
        let v = _sv_parse_uint(parts[0])
        if v >= 0
            major = v
    if len(parts) >= 2
        let v2 = _sv_parse_uint(parts[1])
        if v2 >= 0
            minor = v2
    if len(parts) >= 3
        let v3 = _sv_parse_uint(parts[2])
        if v3 >= 0
            patch = v3
    let result = [major, minor, patch, pre, build]
    result

// sv_major — extract major version number from version string.
fn sv_major(s: string) -> int
    let p = sv_parse(s)
    p[0]

// sv_minor — extract minor version number from version string.
fn sv_minor(s: string) -> int
    let p = sv_parse(s)
    p[1]

// sv_patch — extract patch version number from version string.
fn sv_patch(s: string) -> int
    let p = sv_parse(s)
    p[2]

// sv_prerelease — extract prerelease string from version string ('' if absent).
fn sv_prerelease(s: string) -> string
    let p = sv_parse(s)
    p[3]

// sv_build — extract build metadata string from version string ('' if absent).
fn sv_build(s: string) -> string
    let p = sv_parse(s)
    p[4]

// sv_is_valid — strict SemVer 2.0.0 validation: exactly MAJOR.MINOR.PATCH,
// all numeric with no leading zeros, optional valid -prerelease and +build.
fn sv_is_valid(s: string) -> bool
    let pre = ""
    let build = ""
    let core = s
    // Extract build metadata
    let plus = _sv_find_char(core, "+")
    if plus >= 0
        build = slice(core, plus + 1, len(core))
        core = slice(core, 0, plus)
        // Validate build identifiers
        let bparts = split(build, ".")
        for bi in 0..len(bparts)
            if not _sv_valid_build_id(bparts[bi])
                return false
    // Extract prerelease
    let dash = _sv_find_char(core, "-")
    if dash >= 0
        pre = slice(core, dash + 1, len(core))
        core = slice(core, 0, dash)
        // Validate prerelease identifiers
        let pparts = split(pre, ".")
        for pi in 0..len(pparts)
            if not _sv_valid_pre_id(pparts[pi])
                return false
    // Core must be exactly MAJOR.MINOR.PATCH
    let parts = split(core, ".")
    if len(parts) != 3
        return false
    for i in 0..3
        let seg = parts[i]
        if len(seg) == 0
            return false
        if not _sv_is_numeric_only(seg)
            return false
        if _sv_has_leading_zero(seg)
            return false
    true
