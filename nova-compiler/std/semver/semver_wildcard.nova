// std/semver/semver_wildcard -- SemVer 2.0.0 x-ranges (wildcard ranges).
// LEAF -- imports NOTHING.
//
// An x-range specifies a wildcard component using 'x', 'X', or '*'.
//   '*'  or 'x'    := any version (unbounded)
//   '1.x'          := >=1.0.0 <2.0.0
//   '1.2.x'        := >=1.2.0 <1.3.0
//   '1.2.*'        := >=1.2.0 <1.3.0  (same as '1.2.x')
//
// Public API:
//   svw_lower(range)              -> string  (lower bound version, inclusive; '' if unbounded)
//   svw_upper(range)              -> string  (upper bound version, exclusive; '' if unbounded)
//   svw_satisfies(version, range) -> int     (1 if version is within range, 0 otherwise)

// PRIVATE: returns 1 if s is a wildcard token ('x', 'X', '*'), else 0.
fn _svw_is_wild(s: string) -> int
    if s == "x"
        return 1
    if s == "X"
        return 1
    if s == "*"
        return 1
    0

// PRIVATE: parse a non-negative integer from a digit string; returns -1 if empty or non-digit.
fn _svw_parse_int(s: string) -> int
    let n = len(s)
    if n == 0
        return -1
    let v = 0
    for i in 0..n
        let o = ord(char_at(s, i))
        if o < 48 or o > 57
            return -1
        v = v * 10 + (o - 48)
    v

// PRIVATE: compare two parsed versions [maj, min, pat] numerically.
// Returns -1, 0, or 1.
fn _svw_cmp3(amaj: int, amin: int, apat: int, bmaj: int, bmin: int, bpat: int) -> int
    if amaj < bmaj
        return -1
    if amaj > bmaj
        return 1
    if amin < bmin
        return -1
    if amin > bmin
        return 1
    if apat < bpat
        return -1
    if apat > bpat
        return 1
    0

// PRIVATE: parse 'major.minor.patch' (ignoring pre-release/build) into maj/min/pat via out-param list.
// Returns [maj, min, pat] list; on bad input each missing field defaults to 0.
fn _svw_parse_ver(v: string) -> list
    let parts = split(v, ".")
    let maj = 0
    let mn = 0
    let pat = 0
    if len(parts) >= 1
        let pm = _svw_parse_int(parts[0])
        if pm >= 0
            maj = pm
    if len(parts) >= 2
        let pn = _svw_parse_int(parts[1])
        if pn >= 0
            mn = pn
    if len(parts) >= 3
        // strip pre-release from patch field (e.g. "0-alpha")
        let ps = parts[2]
        let di = 0
        let found = 0
        while di < len(ps) and found == 0
            let ch = char_at(ps, di)
            if ch == "-" or ch == "+"
                found = 1
            else
                di += 1
        let ps2 = slice(ps, 0, di)
        let pp = _svw_parse_int(ps2)
        if pp >= 0
            pat = pp
    let r = []
    push(r, maj)
    push(r, mn)
    push(r, pat)
    r

// svw_lower("1.2.x") -> "1.2.0"
// svw_lower("1.x")   -> "1.0.0"
// svw_lower("*")     -> ""
fn svw_lower(range: string) -> string
    let parts = split(range, ".")
    let n = len(parts)
    // all-wildcard
    if n == 1
        if _svw_is_wild(parts[0]) == 1
            return ""
    // check if patch (index 2) is wildcard  -> lower = maj.min.0
    if n == 3
        if _svw_is_wild(parts[2]) == 1
            let lo = parts[0] + "." + parts[1] + ".0"
            return lo
    // check if minor (index 1) is wildcard -> lower = maj.0.0
    if n == 2
        if _svw_is_wild(parts[1]) == 1
            let lo2 = parts[0] + ".0.0"
            return lo2
    // no wildcard found: treat as exact version lower bound (but this fn is for x-ranges)
    // fallback: return the range itself interpreted as "major.minor.patch" with missing=0
    if n == 1
        let lo3 = parts[0] + ".0.0"
        return lo3
    if n == 2
        let lo4 = parts[0] + "." + parts[1] + ".0"
        return lo4
    range

// svw_upper("1.2.x") -> "1.3.0"  (exclusive)
// svw_upper("1.x")   -> "2.0.0"  (exclusive)
// svw_upper("*")     -> ""        (unbounded)
fn svw_upper(range: string) -> string
    let parts = split(range, ".")
    let n = len(parts)
    // all-wildcard
    if n == 1
        if _svw_is_wild(parts[0]) == 1
            return ""
    // patch wildcard '1.2.x' -> upper = 1.3.0
    if n == 3
        if _svw_is_wild(parts[2]) == 1
            let mn = _svw_parse_int(parts[1])
            if mn < 0
                mn = 0
            let up = parts[0] + "." + str(mn + 1) + ".0"
            return up
    // minor wildcard '1.x' -> upper = 2.0.0
    if n == 2
        if _svw_is_wild(parts[1]) == 1
            let maj = _svw_parse_int(parts[0])
            if maj < 0
                maj = 0
            let up2 = str(maj + 1) + ".0.0"
            return up2
    // no wildcard: no upper bound (exact match range — satisfies handles this separately)
    ""

// svw_satisfies("1.2.5", "1.2.x") -> 1
// svw_satisfies("1.3.0", "1.2.x") -> 0
// svw_satisfies("9.9.9", "*")     -> 1
fn svw_satisfies(version: string, range: string) -> int
    let parts = split(range, ".")
    let n = len(parts)
    // '*' or 'x' alone -> always satisfied
    if n == 1
        if _svw_is_wild(parts[0]) == 1
            return 1
    // determine which component is wild
    let wild_patch = 0
    let wild_minor = 0
    if n == 3
        if _svw_is_wild(parts[2]) == 1
            wild_patch = 1
    if n == 2
        if _svw_is_wild(parts[1]) == 1
            wild_minor = 1
    // if no wildcard detected, treat as exact version equality
    let vp = _svw_parse_ver(version)
    let vmaj = vp[0]
    let vmin = vp[1]
    let vpat = vp[2]
    if wild_patch == 1
        // range: >=maj.min.0 and <maj.(min+1).0
        let rmaj = _svw_parse_int(parts[0])
        let rmin = _svw_parse_int(parts[1])
        if rmaj < 0
            rmaj = 0
        if rmin < 0
            rmin = 0
        // check vmaj==rmaj, vmin==rmin (patch can be anything)
        let lo_cmp = _svw_cmp3(vmaj, vmin, vpat, rmaj, rmin, 0)
        if lo_cmp < 0
            return 0
        let hi_cmp = _svw_cmp3(vmaj, vmin, vpat, rmaj, rmin + 1, 0)
        if hi_cmp >= 0
            return 0
        return 1
    if wild_minor == 1
        // range: >=maj.0.0 and <(maj+1).0.0
        let rmaj2 = _svw_parse_int(parts[0])
        if rmaj2 < 0
            rmaj2 = 0
        let lo_cmp2 = _svw_cmp3(vmaj, vmin, vpat, rmaj2, 0, 0)
        if lo_cmp2 < 0
            return 0
        let hi_cmp2 = _svw_cmp3(vmaj, vmin, vpat, rmaj2 + 1, 0, 0)
        if hi_cmp2 >= 0
            return 0
        return 1
    // no wildcard: exact match (major.minor.patch)
    let ep = _svw_parse_ver(range)
    let emaj = ep[0]
    let emin = ep[1]
    let epat = ep[2]
    if _svw_cmp3(vmaj, vmin, vpat, emaj, emin, epat) == 0
        return 1
    0
