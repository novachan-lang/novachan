// std/dsp/window.nova — Window functions for digital signal processing.
// All functions return a float list of length n.
// Signals are float lists; win_apply multiplies element-wise.
//
// FLOAT HAZARDS obeyed throughout:
//   - cos()/sin() return boxed floats — always bind to a named let.
//   - Never return a bare multi-term float expression — single-exit named result.
//   - abs(float) returns int — use if/else for float absolute value.
//   - float vs int compare is UNSOUND — coerce with *1.0 before comparisons.
//   - NO single-line 'if cond then stmt' — always use a block body.
//   - Module-level float consts silently truncate — all consts inside fn bodies.
//
// API:
//   win_rectangular(n)          -> list  all 1.0
//   win_hann(n)                 -> list  0.5 - 0.5*cos(2*pi*i/(n-1))
//   win_hamming(n)              -> list  0.54 - 0.46*cos(2*pi*i/(n-1))
//   win_blackman(n)             -> list  0.42 - 0.5*cos(2pi i/(n-1)) + 0.08*cos(4pi i/(n-1))
//   win_triangular(n)           -> list  Bartlett zero-endpoint: 1 - |2i/(n-1) - 1|
//   win_apply(signal, window)   -> list  element-wise multiply

// Return a rectangular window of length n (all weights = 1.0).
fn win_rectangular(n: int) -> list
    let result = []
    let i = 0
    while i < n
        result.push(1.0)
        i += 1
    result

// Return a Hann window of length n.
// w[i] = 0.5 - 0.5 * cos(2 * pi * i / (n - 1))
// For n == 1, returns [1.0] (degenerate single-sample window).
fn win_hann(n: int) -> list
    let result = []
    if n == 1
        result.push(1.0)
        return result
    let PI = pi()
    let nm1 = (n - 1) * 1.0
    let i = 0
    while i < n
        let phase = 2.0 * PI * (i * 1.0) / nm1
        let cv = cos(phase)
        let w = 0.5 - 0.5 * cv
        result.push(w)
        i += 1
    result

// Return a Hamming window of length n.
// w[i] = 0.54 - 0.46 * cos(2 * pi * i / (n - 1))
// For n == 1, returns [1.0].
fn win_hamming(n: int) -> list
    let result = []
    if n == 1
        result.push(1.0)
        return result
    let PI = pi()
    let nm1 = (n - 1) * 1.0
    let i = 0
    while i < n
        let phase = 2.0 * PI * (i * 1.0) / nm1
        let cv = cos(phase)
        let w = 0.54 - 0.46 * cv
        result.push(w)
        i += 1
    result

// Return a Blackman window of length n.
// w[i] = 0.42 - 0.5*cos(2pi*i/(n-1)) + 0.08*cos(4pi*i/(n-1))
// For n == 1, returns [1.0].
fn win_blackman(n: int) -> list
    let result = []
    if n == 1
        result.push(1.0)
        return result
    let PI = pi()
    let nm1 = (n - 1) * 1.0
    let i = 0
    while i < n
        let if1 = 2.0 * PI * (i * 1.0) / nm1
        let if2 = 4.0 * PI * (i * 1.0) / nm1
        let c1 = cos(if1)
        let c2 = cos(if2)
        let w = 0.42 - 0.5 * c1 + 0.08 * c2
        result.push(w)
        i += 1
    result

// Return a triangular (Bartlett) window of length n — zero-endpoint form.
// w[i] = 1 - |2*i/(n-1) - 1|
// For n == 1, returns [1.0].
fn win_triangular(n: int) -> list
    let result = []
    if n == 1
        result.push(1.0)
        return result
    let nm1 = (n - 1) * 1.0
    for i in 0..n
        let x = 2.0 * (i * 1.0) / nm1 - 1.0
        let ax = x
        if x < 0.0
            ax = 0.0 - x
        let w = 1.0 - ax
        result.push(w)
    result

// Apply a window to a signal by element-wise multiplication.
// Lengths are assumed equal; result length = min(len(signal), len(window)).
fn win_apply(signal: list, window: list) -> list
    let result = []
    let slen = len(signal)
    let wlen = len(window)
    let lim = slen
    if wlen < lim
        lim = wlen
    for i in 0..lim
        let sv = signal[i] * 1.0
        let wv = window[i] * 1.0
        let out = sv * wv
        result.push(out)
    result
