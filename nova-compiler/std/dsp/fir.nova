// std/dsp/fir.nova — FIR (Finite Impulse Response) digital filter.
// All signals are float lists. The filter operates in direct-form I:
//   output[i] = sum_j( coeffs[j] * signal[i-j] )
// with zero-padded history (signal values before index 0 are treated as 0.0).
// Output length always equals input signal length.
//
// Public API (prefix: fir_):
//   fir_apply(signal, coeffs) -> list   direct-form FIR convolution
//   fir_moving_average_coeffs(n) -> list  n equal coefficients, each 1/n (DC gain = 1)
//   fir_lowpass_coeffs(n, cutoff) -> list windowed-sinc low-pass (Hann window)
//   fir_gain(coeffs) -> float            sum of all coefficients (= DC gain)
//
// LEAF — imports nothing.

// ── private helpers ──────────────────────────────────────────────────────────

// Absolute value of a float (avoids abs() which returns int in NOVA runtime).
fn _fir_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// Normalized sinc: sinc(x) = sin(pi*x) / (pi*x), sinc(0) = 1.0
fn _fir_sinc(x: float) -> float
    let ax = _fir_fabs(x)
    if ax < 0.0000001
        return 1.0
    let pix = pi * x
    let s = sin(pix)
    let result = s / pix
    result

// Hann window value at position i of n: 0.5*(1 - cos(2*pi*i/(n-1)))
// For n==1 the window is 1.0 (single-tap — no division by zero).
fn _fir_hann(i: int, n: int) -> float
    if n <= 1
        return 1.0
    let denom = (n - 1) * 1.0
    let angle = 2.0 * pi * (i * 1.0) / denom
    let c = cos(angle)
    let w = 0.5 * (1.0 - c)
    w

// ── public API ───────────────────────────────────────────────────────────────

// fir_apply — direct-form FIR filter.
// output[i] = sum over j of coeffs[j] * signal[i-j], with signal[k]=0 for k<0.
// Output has the same length as signal.
fn fir_apply(signal: list, coeffs: list) -> list
    let nc = len(coeffs)
    let ns = len(signal)
    let out = []
    for i in 0..ns
        let acc = 0.0
        let j = 0
        while j < nc
            let si = i - j
            if si >= 0
                let sv = signal[si] * 1.0
                let cv = coeffs[j] * 1.0
                acc += sv * cv
            j += 1
        push(out, acc)
    out

// fir_moving_average_coeffs — n equal weights summing to 1.0.
// Each coefficient is 1/n (integer division avoided via float arithmetic).
fn fir_moving_average_coeffs(n: int) -> list
    let out = []
    if n <= 0
        return out
    let w = 1.0 / (n * 1.0)
    let i = 0
    while i < n
        push(out, w)
        i += 1
    out

// fir_lowpass_coeffs — windowed-sinc low-pass filter with Hann window.
// n: number of taps (odd recommended for linear phase).
// cutoff: normalised cutoff frequency in (0.0, 0.5); 0.5 = Nyquist.
// h[i] = sinc(2*cutoff*(i - (n-1)/2)) * hann(i, n), then normalised for unity DC gain.
fn fir_lowpass_coeffs(n: int, cutoff: float) -> list
    let out = []
    if n <= 0
        return out
    let half = (n - 1) * 1.0 / 2.0
    // build raw windowed-sinc taps
    for i in 0..n
        let offset = (i * 1.0) - half
        let s = _fir_sinc(2.0 * cutoff * offset)
        let w = _fir_hann(i, n)
        push(out, s * w)
    // normalise so DC gain = 1 (sum of taps = 1)
    let total = 0.0
    for k in 0..n
        total += out[k] * 1.0
    if total < 0.0000001 and total > 0.0 - 0.0000001
        return out
    let norm = []
    for m in 0..n
        let v = out[m] * 1.0
        push(norm, v / total)
    norm

// fir_gain — DC gain of a filter: the sum of all coefficients.
fn fir_gain(coeffs: list) -> float
    let s = 0.0
    for i in 0..len(coeffs)
        s += coeffs[i] * 1.0
    s
