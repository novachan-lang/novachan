// std/dsp/peak.nova -- Peak and zero-crossing detection. LEAF -- imports NOTHING.
//
// Signals are represented as float lists.
//
// Public API (prefix pk_)
//   pk_find_peaks(xs)     -> list   Indices of local maxima (strictly greater than both neighbors).
//   pk_find_valleys(xs)   -> list   Indices of local minima (strictly less than both neighbors).
//   pk_max_index(xs)      -> int    Index of the global maximum element.
//   pk_zero_crossings(xs) -> int    Count of sign changes between adjacent samples.
//   pk_count(xs)          -> int    Number of peaks (equivalent to len(pk_find_peaks(xs))).
//
// Float arithmetic notes (NOVA gotchas)
//   - List element reads are 'any'; multiply by 1.0 to force float before comparison.
//   - abs(float) returns int in NOVA; use if/else for float absolute value.
//   - Integer division truncates; use float denominators for real division.
//   - Bind sqrt() and composite float expressions to a named 'let' (uninit-slot bug).
//   - Float vs int compare is UNSOUND; coerce with *1.0.

// _pk_sign -- returns 1 if x >= 0.0, -1 if x < 0.0.
// Used for zero-crossing detection.
fn _pk_sign(x: float) -> int
    if x < 0.0
        return 0 - 1
    1

// pk_find_peaks -- Return list of indices i where xs[i] > xs[i-1] and xs[i] > xs[i+1].
// Endpoints (index 0 and len-1) are never peaks.
// Returns empty list for xs of length < 3.
fn pk_find_peaks(xs: list) -> list
    let result = []
    let n = len(xs)
    if n < 3
        return result
    let i = 1
    while i < n - 1
        let prev = xs[i - 1] * 1.0
        let curr = xs[i] * 1.0
        let next = xs[i + 1] * 1.0
        if curr > prev
            if curr > next
                push(result, i)
        i += 1
    result

// pk_find_valleys -- Return list of indices i where xs[i] < xs[i-1] and xs[i] < xs[i+1].
// Endpoints (index 0 and len-1) are never valleys.
// Returns empty list for xs of length < 3.
fn pk_find_valleys(xs: list) -> list
    let result = []
    let n = len(xs)
    if n < 3
        return result
    for i in 1..(n - 1)
        let prev = xs[i - 1] * 1.0
        let curr = xs[i] * 1.0
        let next = xs[i + 1] * 1.0
        if curr < prev
            if curr < next
                push(result, i)
    result

// pk_max_index -- Return the index of the maximum element in xs.
// Returns 0 for an empty list (safe default).
fn pk_max_index(xs: list) -> int
    let n = len(xs)
    if n == 0
        return 0
    let best_idx = 0
    let best_val = xs[0] * 1.0
    let i = 1
    while i < n
        let v = xs[i] * 1.0
        if v > best_val
            best_val = v
            best_idx = i
        i += 1
    best_idx

// pk_zero_crossings -- Count the number of sign changes between adjacent samples.
// A crossing at position i means sign(xs[i]) != sign(xs[i+1]).
// Zero is treated as positive (sign >= 0).
// Returns 0 for xs of length < 2.
fn pk_zero_crossings(xs: list) -> int
    let n = len(xs)
    if n < 2
        return 0
    let count = 0
    for i in 0..(n - 1)
        let a = xs[i] * 1.0
        let b = xs[i + 1] * 1.0
        let sa = _pk_sign(a)
        let sb = _pk_sign(b)
        if sa != sb
            count += 1
    count

// pk_count -- Return the number of peaks in xs (local maxima strictly greater than both neighbors).
// Equivalent to len(pk_find_peaks(xs)).
fn pk_count(xs: list) -> int
    let peaks = pk_find_peaks(xs)
    len(peaks)
