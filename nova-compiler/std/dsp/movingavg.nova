// std/dsp/movingavg.nova -- Batch moving-average transforms over float lists.
//
// All functions consume a full float list and produce a new list of results.
// This is the analytical / offline API; for online/streaming use forge_movingavg
// (ring-buffer SMA + EMA with no history). Signals are represented as float lists.
//
// Public API (prefix mav_)
//   mav_sma(xs, window) -> list   Simple Moving Average; output length = len(xs)-window+1.
//   mav_ema(xs, alpha)  -> list   Exponential MA; same length as xs; ema[0] = xs[0].
//   mav_wma(xs, window) -> list   Weighted MA with linear weights; same output length as mav_sma.
//   mav_cumulative(xs)  -> list   Running (cumulative) mean; same length as xs.
//
// Float arithmetic notes
//   - List element reads are 'any'; multiply by 1.0 to force float before math.
//   - Integer division truncates; always use float denominators.
//   - abs(float) returns int in NOVA; negate via if/else.
//   - Bind composite float expressions to a 'let' before returning (uninit-slot bug).

// mav_sma -- Simple Moving Average.
// For a window of size w, output[i] = mean(xs[i..i+w-1]).
// Output length = len(xs) - window + 1.
// Returns an empty list when window <= 0 or window > len(xs).
fn mav_sma(xs: list, window: int) -> list
    let result = []
    let n = len(xs)
    if window <= 0
        return result
    if window > n
        return result
    let wf = window * 1.0
    for i in 0..(n - window + 1)
        let s = 0.0
        for j in 0..window
            let v = xs[i + j] * 1.0
            s += v
        let avg = s / wf
        push(result, avg)
    result

// mav_ema -- Exponential Moving Average with smoothing factor alpha in (0,1].
// ema[0] = xs[0]; ema[i] = alpha*xs[i] + (1-alpha)*ema[i-1].
// Returns a list of the same length as xs, or empty list if xs is empty.
fn mav_ema(xs: list, alpha: float) -> list
    let result = []
    let n = len(xs)
    if n == 0
        return result
    let first = xs[0] * 1.0
    push(result, first)
    let prev = first
    let one_minus = 1.0 - alpha
    for i in 1..n
        let xi = xs[i] * 1.0
        let next = alpha * xi + one_minus * prev
        push(result, next)
        prev = next
    result

// mav_wma -- Weighted Moving Average with linearly increasing integer weights.
// For window w, weights are 1,2,...,w (weight_sum = w*(w+1)/2).
// output[i] = (1*xs[i] + 2*xs[i+1] + ... + w*xs[i+w-1]) / weight_sum.
// Output length = len(xs) - window + 1.
fn mav_wma(xs: list, window: int) -> list
    let result = []
    let n = len(xs)
    if window <= 0
        return result
    if window > n
        return result
    let wsum = (window * (window + 1)) / 2
    let wsumf = wsum * 1.0
    for i in 0..(n - window + 1)
        let s = 0.0
        for j in 0..window
            let weight = (j + 1) * 1.0
            let v = xs[i + j] * 1.0
            s += weight * v
        let avg = s / wsumf
        push(result, avg)
    result

// mav_cumulative -- Running (cumulative) arithmetic mean.
// output[i] = mean(xs[0..i]) = (xs[0]+...+xs[i]) / (i+1).
// Returns a list of the same length as xs, or empty list if xs is empty.
fn mav_cumulative(xs: list) -> list
    let result = []
    let n = len(xs)
    if n == 0
        return result
    let running_sum = 0.0
    for i in 0..n
        let v = xs[i] * 1.0
        running_sum += v
        let cnt = (i + 1) * 1.0
        let avg = running_sum / cnt
        push(result, avg)
    result
