// std/dsp/envelope.nova -- Signal envelope extraction. LEAF — imports NOTHING.
//
// All functions consume float lists and produce new float lists.
// Signals are represented as float lists.
//
// Public API (prefix env_)
//   env_abs(xs)            -> list   Rectified absolute value (|x| per element).
//   env_peak(xs, window)   -> list   Sliding max of |x| over window; output length = len(xs)-window+1.
//   env_rms(xs, window)    -> list   Sliding RMS over window; output length = len(xs)-window+1.
//   env_hilbert_approx(xs) -> list   Approximate magnitude envelope via abs + EMA smoothing (alpha=0.5).
//
// Float arithmetic notes (NOVA gotchas)
//   - List element reads are 'any'; multiply by 1.0 to force float before math.
//   - abs(float) returns int in NOVA; use if/else for float absolute value.
//   - Integer division truncates; use float denominators (e.g. wf = window*1.0).
//   - Bind sqrt() and composite float expressions to a named 'let' (uninit-slot bug).
//   - Float vs int compare is UNSOUND; coerce with *1.0.

// _env_fabs -- float absolute value (abs(float) returns int in NOVA).
fn _env_fabs(x: float) -> float
    if x < 0.0
        let r = 0.0 - x
        return r
    x

// env_abs -- Rectified absolute value: output[i] = |xs[i]|.
// Returns a new list of the same length as xs.
fn env_abs(xs: list) -> list
    let result = []
    let n = len(xs)
    for i in 0..n
        let v = xs[i] * 1.0
        let av = _env_fabs(v)
        push(result, av)
    result

// env_peak -- Sliding maximum of |x| over a window.
// output[i] = max(|xs[i]|, |xs[i+1]|, ..., |xs[i+window-1]|)
// Output length = len(xs) - window + 1.
// Returns empty list when window <= 0 or window > len(xs).
fn env_peak(xs: list, window: int) -> list
    let result = []
    let n = len(xs)
    if window <= 0
        return result
    if window > n
        return result
    for i in 0..(n - window + 1)
        let first_v = xs[i] * 1.0
        let mx = _env_fabs(first_v)
        for j in 1..window
            let v = xs[i + j] * 1.0
            let av = _env_fabs(v)
            if av > mx
                mx = av
        push(result, mx)
    result

// env_rms -- Sliding Root Mean Square over a window.
// output[i] = sqrt(mean(xs[i]^2, ..., xs[i+window-1]^2))
// Output length = len(xs) - window + 1.
// Returns empty list when window <= 0 or window > len(xs).
fn env_rms(xs: list, window: int) -> list
    let result = []
    let n = len(xs)
    if window <= 0
        return result
    if window > n
        return result
    let wf = window * 1.0
    for i in 0..(n - window + 1)
        let s = 0.0
        for j in 0..window
            let v = xs[i + j] * 1.0
            s += v * v
        let mean_sq = s / wf
        let r = sqrt(mean_sq)
        push(result, r)
    result

// env_hilbert_approx -- Approximate magnitude envelope.
// Step 1: rectify (abs per element).
// Step 2: apply EMA smoothing with alpha=0.5 to approximate the analytic signal envelope.
// This is a common low-cost envelope detector used in audio and vibration analysis.
// Output length = same as xs; returns empty list for empty input.
fn env_hilbert_approx(xs: list) -> list
    let result = []
    let n = len(xs)
    if n == 0
        return result
    // Rectify: abs of each sample
    let rect = []
    for i in 0..n
        let v = xs[i] * 1.0
        let av = _env_fabs(v)
        push(rect, av)
    // EMA with alpha=0.5 over rectified signal
    let alpha = 0.5
    let one_minus = 0.5
    let first = rect[0] * 1.0
    push(result, first)
    let prev = first
    for k in 1..n
        let rv = rect[k] * 1.0
        let next = alpha * rv + one_minus * prev
        push(result, next)
        prev = next
    result
