// reservoir — reservoir sampling (Algorithm R, Vitter 1985), seeded PRNG.
//
// Maintains a fixed-size random sample of a stream without storing the full
// stream. After seeing n items total, each item in the reservoir was selected
// with equal probability k/n — an unbiased, uniform random sample.
// Deterministic given the same seed: same seed + same stream = identical result.
// State is a dict containing the reservoir ("res" list), total items seen
// ("cnt"), capacity ("k"), and 64-bit PRNG state ("rng").

// Splitmix64 step — deterministic LCG-style PRNG producing positive 63-bit ints.
fn _rs_mix(rng) -> int
    let z = (rng + 0x9E3779B97F4A7C15) & 0x7FFFFFFFFFFFFFFF
    let a = ((z ^ (z >> 30)) * 0x4Be98134A5995AD5) & 0x7FFFFFFFFFFFFFFF
    let b = ((a ^ (a >> 27)) * 0x38B34AE8Ec9BD5A5) & 0x7FFFFFFFFFFFFFFF
    return (b ^ (b >> 31)) & 0x7FFFFFFFFFFFFFFF

// Advance PRNG state and store it back; returns the new pseudo-random int.
fn rs_next_rand(st) -> int
    let rng = st["rng"]
    let rng2 = (rng + 0x9E3779B97F4A7C15) & 0x7FFFFFFFFFFFFFFF
    st["rng"] = rng2
    let z = rng2
    let a = ((z ^ (z >> 30)) * 0x4Be98134A5995AD5) & 0x7FFFFFFFFFFFFFFF
    let b = ((a ^ (a >> 27)) * 0x38B34AE8Ec9BD5A5) & 0x7FFFFFFFFFFFFFFF
    return (b ^ (b >> 31)) & 0x7FFFFFFFFFFFFFFF

// Create a new reservoir sampler: k slots, seeded with seed.
fn rs_new(k, seed) -> any
    return {"k": k, "cnt": 0, "res": [], "rng": _rs_mix(seed & 0x7FFFFFFFFFFFFFFF)}

// Add an item to the reservoir (Algorithm R).
// First k items fill the reservoir directly; subsequent item i replaces a
// random slot j (0 <= j < i) with probability k/i.
fn rs_add(st, item) -> any
    let cnt = st["cnt"]
    let k = st["k"]
    let res = st["res"]
    if k == 0
        st["cnt"] = cnt + 1
        return st
    if cnt < k
        push(res, item)
        st["cnt"] = cnt + 1
        return st
    // item index = cnt (0-based), so range is [0, cnt]
    let r = rs_next_rand(st)
    let slot = r % (cnt + 1)
    if slot < k
        res[slot] = item
    st["cnt"] = cnt + 1
    return st

// Return a copy of the current reservoir.
fn rs_sample(st) -> any
    let res = st["res"]
    return [res[i] for i in 0..len(res)]

// Return the current reservoir size (min(items_seen, k)).
fn rs_size(st) -> int
    return len(st["res"])

// Return the total number of items seen by the sampler.
fn rs_count(st) -> int
    return st["cnt"]

// Reset the sampler to empty (preserving k; re-seeds from the current rng).
fn rs_reset(st) -> any
    let rng = st["rng"]
    let rng2 = _rs_mix(rng)
    st["cnt"] = 0
    st["res"] = []
    st["rng"] = rng2
    return st

// Weighted reservoir sampling (A-Res, Efraimidis & Spirakis 2006, simplified).
// Assigns key = rand^(1/weight); retains the k items with the largest keys.
// Stored as (key_approx, item) pairs; key approximated as rand / weight.
fn rs_weighted_add(st, item, weight) -> any
    let k = st["k"]
    let res = st["res"]
    if k == 0
        return st
    let r = rs_next_rand(st)
    let key = r / weight if weight > 0 else 0
    if len(res) < k
        push(res, [key, item])
        st["cnt"] += 1
        return st
    // Find the slot with minimum key.
    let min_idx = 0
    let min_key = res[0][0]
    for i in 1..len(res)
        let ck = res[i][0]
        if ck < min_key
            min_idx = i
            min_key = ck
    if key > min_key
        res[min_idx] = [key, item]
    st["cnt"] += 1
    return st
