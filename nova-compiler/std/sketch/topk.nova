// topk — Space-Saving heavy-hitter tracker (Metwally et al. 2005).
//
// Maintains a bounded dictionary of (item -> count) monitored entries.
// Frequency-count guarantee: for a MONITORED item, tk_estimate over-estimates
// (true_count <= estimate <= true_count + error) — it never underestimates a
// monitored item. NOTE: tk_estimate returns 0 for items NOT in the monitored set
// (never seen OR already evicted); an evicted item's true count is at most the
// current minimum monitored count, so 0 is a lower bound, not exact.
// When the monitor is full, the minimum-count entry is evicted and replaced
// by the new item with count = min_count + 1, preserving the error bound.
// State is a dict; items are stored in "items" (list), counts in "counts" (list),
// capacity in "cap", and current size in "sz".

// 63-bit hash (seed A) — deterministic, always positive.
fn _tk_h63a(s) -> int
    let h = 1125899906842597
    let i = 0
    let n = len(s)
    while i < n
        h = (h * 131 + ord(char_at(s, i))) & 0x7FFFFFFFFFFFFFFF
        i = i + 1
    return h

// Create a new Space-Saving state tracking up to k heavy hitters.
fn tk_new(k) -> any
    let st = {}
    st["cap"] = k
    st["sz"] = 0
    st["items"] = []
    st["counts"] = []
    return st

// Find the index of item in the monitored list, or -1 if absent.
fn _tk_find(st, item) -> int
    let items = st["items"]
    let n = st["sz"]
    for i in 0..n
        if items[i] == item
            return i
    return 0 - 1

// Find the index of the minimum-count entry (linear scan).
fn _tk_min_idx(st) -> int
    let counts = st["counts"]
    let n = st["sz"]
    let best = 0
    let bval = counts[0]
    for i in 1..n
        let cv = counts[i]
        if cv < bval
            best = i
            bval = cv
    return best

// Add an item to the Space-Saving tracker.
// If monitored: increment its count. If room: add with count 1.
// Otherwise: replace the min-count entry with count = min_count + 1.
fn tk_add(st, item) -> any
    let idx = _tk_find(st, item)
    if idx >= 0
        let counts = st["counts"]
        counts[idx] = counts[idx] + 1
        return st
    let sz = st["sz"]
    let cap = st["cap"]
    if sz < cap
        let items = st["items"]
        let counts = st["counts"]
        push(items, item)
        push(counts, 1)
        st["sz"] = sz + 1
        return st
    let mi = _tk_min_idx(st)
    let items = st["items"]
    let counts = st["counts"]
    let mc = counts[mi]
    items[mi] = item
    counts[mi] = mc + 1
    return st

// Return the top-n items by count in descending order (insertion sort, no negative sentinels).
fn tk_top(st, n) -> any
    let sz = st["sz"]
    let items = st["items"]
    let counts = st["counts"]
    let take = n
    if sz < take
        take = sz
    let out_items = []
    let out_counts = []
    for i in 0..sz
        push(out_items, items[i])
        push(out_counts, counts[i])
    // Insertion sort descending by count.
    for j in 1..sz
        let ki = out_counts[j]
        let vi = out_items[j]
        let k = j
        let done = false
        while k > 0 and done == false
            if out_counts[k - 1] < ki
                out_counts[k] = out_counts[k - 1]
                out_items[k] = out_items[k - 1]
                k = k - 1
            else
                done = true
        out_counts[k] = ki
        out_items[k] = vi
    // Return the first `take` items.
    let result = []
    for r in 0..take
        push(result, out_items[r])
    return result

// Return the approximate count for an item (0 if not monitored).
fn tk_estimate(st, item) -> int
    let idx = _tk_find(st, item)
    if idx >= 0
        let counts = st["counts"]
        return counts[idx]
    return 0

// Return the number of currently monitored entries.
fn tk_count(st) -> int
    return st["sz"]

// Return the smallest monitored count (0 if tracker is empty).
fn tk_min_count(st) -> int
    let sz = st["sz"]
    if sz == 0
        return 0
    let counts = st["counts"]
    let m = counts[0]
    for i in 1..sz
        if counts[i] < m
            m = counts[i]
    return m

// Return true if the item is currently in the monitored set.
fn tk_contains(st, item) -> bool
    let idx = _tk_find(st, item)
    return idx >= 0

// Return a copy of the monitored items list (unordered).
fn tk_items(st) -> any
    let items = st["items"]
    let sz = st["sz"]
    let result = [items[i] for i in 0..sz]
    return result
