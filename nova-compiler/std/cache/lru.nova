// std/cache/lru — fixed-capacity Least-Recently-Used cache.
//
// Representation (dict c):
//   "cap"   -> int capacity (max resident entries)
//   "order" -> list of keys, LRU-first (index 0 = least recently used,
//              the end of the list = most recently used)
//   "data"  -> dict str(key) -> stored value, defined exactly for keys
//              currently present in "order"
//
// Every get/put that touches an existing key moves it to the MRU end of
// "order" in O(n) (list search+splice). This is a straightforward reference
// implementation — a doubly-linked-list + hashmap LRU is O(1) per op, but
// NOVA's dict/list builtins don't expose a splice-by-pointer primitive, so
// O(n) touch is the honest cost here (documented, not hidden).
//
// Public API:
//   ca_new(capacity)       -> dict
//   ca_get(cache, key)     -> any (cached value, or 0 on miss; promotes on hit)
//   ca_put(cache, key, val)-> dict (insert/update; evicts LRU entry if at capacity)
//   ca_contains(cache, key)-> bool
//   ca_remove(cache, key)  -> bool (true if key was present and removed)
//   ca_size(cache)         -> int
//   ca_clear(cache)        -> (mutates cache to empty)
//   ca_keys(cache)         -> list (LRU-first order, a copy)
//
// LEAF — imports nothing.

// ca_new: create a new empty LRU cache with the given resident capacity.
fn ca_new(capacity) -> dict
    let c = {}
    c["cap"] = capacity
    c["order"] = []
    c["data"] = {}
    return c

// _ca_touch: move key to the MRU end of order (key must already be present).
fn _ca_touch(order, key)
    remove(order, key)
    push(order, key)

// ca_get: return the cached value for key, or 0 on a miss. A hit promotes
// the key to the MRU end.
fn ca_get(cache, key)
    let data = cache["data"]
    let k = str(key)
    if k not in data
        return 0
    _ca_touch(cache["order"], key)
    return data[k]

// ca_contains: true if key is currently resident (does not affect recency).
fn ca_contains(cache, key) -> bool
    return contains(cache["data"], str(key))

// ca_put: insert or update key -> val. If key is new and the cache is at
// capacity, evicts the LRU (front) entry first.
fn ca_put(cache, key, val) -> dict
    let cap = cache["cap"]
    if cap <= 0
        return cache
    let data = cache["data"]
    let k = str(key)
    let order = cache["order"]
    if k in data
        data[k] = val
        _ca_touch(order, key)
        return cache
    if len(order) >= cap
        let oldest = order[0]
        remove(order, oldest)
        del(data, str(oldest))
    push(order, key)
    data[k] = val
    return cache

// ca_remove: evict key if present. Returns true if it was present.
fn ca_remove(cache, key) -> bool
    let data = cache["data"]
    let k = str(key)
    if k not in data
        return false
    del(data, k)
    remove(cache["order"], key)
    return true

// ca_size: number of resident entries.
fn ca_size(cache) -> int
    return len(cache["order"])

// ca_clear: drop every entry (mutates cache in place).
fn ca_clear(cache)
    cache["order"] = []
    cache["data"] = {}

// ca_keys: resident keys, LRU-first, as a fresh list (safe to mutate).
fn ca_keys(cache) -> list
    let out = [k for k in cache["order"]]
    return out
