// std/coding/checksum_fletcher.nova — Fletcher and Adler checksums.
// Operates on lists of ints 0..255 (byte lists) — NO floats, NO imports.
//
// PUBLIC API (all prefixed fl_):
//   fl_fletcher8(data)        -> int   Fletcher-8:  two 4-bit sums mod 15, combined
//   fl_fletcher16(data)       -> int   Fletcher-16: two 8-bit sums mod 255, combined as (s2<<8)|s1
//   fl_fletcher16_sums(data)  -> any   [s1, s2] pair for Fletcher-16
//   fl_fletcher32(data)       -> int   Fletcher-32: 16-bit word sums mod 65535, combined as (s2<<16)|s1
//   fl_adler32(data)          -> int   Adler-32: sums mod 65521 (A base-1), combined as (B<<16)|A
//   fl_verify16(data, expected) -> bool  True iff fl_fletcher16(data) == expected
//   fl_checkbytes16(data)     -> any   Two check bytes such that fl_fletcher16(data++cb) == 0
//
// ALGORITHM NOTES:
//   Fletcher-16: s1 = sum(bytes) mod 255; s2 = sum of partial s1 values mod 255.
//   Modulus is 255 (not 256) — this is the classic Fletcher definition.
//   Adler-32: A = 1 + sum(bytes) mod 65521; B = len*A_init + sum(A_partial) mod 65521.
//   Base-1 means A starts at 1 (not 0).
//   Fletcher-32: processes 16-bit words (LE pairs), sums mod 65535.
//
// KAT VECTORS (verified against RFC/authoritative references):
//   fl_fletcher16([97,98,99,100,101])  == 0xC8F0
//   fl_fletcher16([97,98,99,100,101,102]) == 0x2057
//   fl_fletcher32([97,98,99,100,101])  == 0xF04FC729
//   fl_adler32([97,98,99])             == 0x024D0127
//   fl_fletcher16([])                  == 0

// ---------------------------------------------------------------------------
// Internal helper: check if two lists of ints are equal (length + content).
// ---------------------------------------------------------------------------
fn _fl_list_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    for i in 0..len(a)
        if a[i] != b[i]
            return false
    true

// ---------------------------------------------------------------------------
// fl_fletcher8 — Fletcher-8 checksum over a byte list.
// Uses modulus 15 (2^4 - 1), nibble sums; returns (s2<<4)|s1 (8-bit result).
// ---------------------------------------------------------------------------
fn fl_fletcher8(data: list) -> int
    let s1 = 0
    let s2 = 0
    for i in 0..len(data)
        s1 = (s1 + (data[i] & 0xFF)) % 15
        s2 = (s2 + s1) % 15
    (s2 << 4) | s1

// ---------------------------------------------------------------------------
// fl_fletcher16 — Fletcher-16 checksum over a byte list.
// s1 = sum(bytes) mod 255; s2 = sum of partial s1 values mod 255.
// Result: (s2 << 8) | s1  (16-bit).
// ---------------------------------------------------------------------------
fn fl_fletcher16(data: list) -> int
    let s1 = 0
    let s2 = 0
    for i in 0..len(data)
        s1 = (s1 + (data[i] & 0xFF)) % 255
        s2 = (s2 + s1) % 255
    (s2 << 8) | s1

// ---------------------------------------------------------------------------
// fl_fletcher16_sums — Return [s1, s2] for Fletcher-16 (not combined).
// Useful when check-byte arithmetic needs the parts separately.
// ---------------------------------------------------------------------------
fn fl_fletcher16_sums(data: list) -> any
    let s1 = 0
    let s2 = 0
    for i in 0..len(data)
        s1 = (s1 + (data[i] & 0xFF)) % 255
        s2 = (s2 + s1) % 255
    let result = []
    push(result, s1)
    push(result, s2)
    result

// ---------------------------------------------------------------------------
// fl_fletcher32 — Fletcher-32 checksum over a byte list treated as LE 16-bit words.
// Odd final byte is zero-padded.  Sums mod 65535.  Result: (s2<<16)|s1.
// ---------------------------------------------------------------------------
fn fl_fletcher32(data: list) -> int
    let s1 = 0
    let s2 = 0
    let n = len(data)
    let i = 0
    while i < n
        let lo = data[i] & 0xFF
        let hi = 0
        if i + 1 < n
            hi = data[i + 1] & 0xFF
        let word = lo + hi * 256
        s1 = (s1 + word) % 65535
        s2 = (s2 + s1) % 65535
        i += 2
    (s2 << 16) | s1

// ---------------------------------------------------------------------------
// fl_adler32 — Adler-32 checksum (RFC 1950) over a byte list.
// A = 1 + sum(bytes) mod 65521; B = n*1 + n*A contributions mod 65521.
// Initial A=1, B=0.  Result: (B<<16)|A.
// ---------------------------------------------------------------------------
fn fl_adler32(data: list) -> int
    let a = 1
    let b = 0
    for i in 0..len(data)
        a = (a + (data[i] & 0xFF)) % 65521
        b = (b + a) % 65521
    (b << 16) | a

// ---------------------------------------------------------------------------
// fl_verify16 — Return true iff fl_fletcher16(data) == expected.
// ---------------------------------------------------------------------------
fn fl_verify16(data: list, expected: int) -> bool
    fl_fletcher16(data) == expected

// ---------------------------------------------------------------------------
// fl_checkbytes16 — Return the two-byte check appendage for Fletcher-16.
// After appending these two bytes, fl_fletcher16 of the extended data == 0.
// Derivation: cb1 = 255 - ((s1 + s2) % 255); cb2 = 255 - ((s1 + cb1) % 255).
// ---------------------------------------------------------------------------
fn fl_checkbytes16(data: list) -> any
    let s1 = 0
    let s2 = 0
    for i in 0..len(data)
        s1 = (s1 + (data[i] & 0xFF)) % 255
        s2 = (s2 + s1) % 255
    let cb1 = 255 - ((s1 + s2) % 255)
    let cb2 = 255 - ((s1 + cb1) % 255)
    let result = []
    push(result, cb1)
    push(result, cb2)
    result
