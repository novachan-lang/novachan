// ============================================================================
// NOVA Standard Library — std/coding/repetition_code
// ============================================================================
// n-repetition code: each bit is repeated n times; majority vote decodes.
//
// Parameters: block length n (must be odd for guaranteed 1-error correction).
//   Rate = 1/n.  Minimum distance d = n.  Corrects t = floor((n-1)/2) errors.
//
// ENCODING: rep_encode([b0,b1,...], n) -> [b0,b0,...(n times),b1,b1,...(n times)]
// DECODING: rep_decode(code, n) -> [b0,b1,...] via majority vote per group of n.
//   Majority vote: count 1s in a group; if count > n/2, output 1, else 0.
//   Tie (n even, exactly n/2 ones) -> 0 (defined convention).
//
// SYMBOLS: all public fns prefixed rep_
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// list_eq: true iff two int lists have same length and contents.
fn _rep_list_eq(a, b) -> bool
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    for i in 0..la
        if a[i] != b[i]
            return 0
    1

// ── Public API ────────────────────────────────────────────────────────────────

// rep_min_distance: minimum Hamming distance of the n-repetition code = n.
fn rep_min_distance(n) -> int
    n

// rep_correct_capability: number of errors the n-repetition code can correct
// = floor((n-1)/2).
fn rep_correct_capability(n) -> int
    (n - 1) / 2

// rep_detects: number of errors the n-repetition code can detect = n-1.
fn rep_detects(n) -> int
    n - 1

// rep_can_correct: true if the n-repetition code can correct `errors` errors.
fn rep_can_correct(n, errors) -> bool
    if errors <= rep_correct_capability(n)
        return 1
    0

// rep_decode_block: majority vote on one group of bits (a list of n ints 0/1).
// Returns 1 if strictly more than half are 1, else 0.
fn rep_decode_block(group) -> int
    let n = len(group)
    let ones = 0
    for i in 0..n
        ones = ones + (group[i] & 1)
    // ones > n/2: for integer division, ones*2 > n
    if ones * 2 > n
        return 1
    0

// rep_encode_msg: alias for rep_encode (encode message bits with n repetitions).
fn rep_encode_msg(bits, n) -> any
    let out = []
    let nb = len(bits)
    for i in 0..nb
        let b = bits[i] & 1
        let j = 0
        while j < n
            push(out, b)
            j = j + 1
    out

// rep_encode: encode a list of bits by repeating each bit n times.
// Example: rep_encode([1,0], 3) == [1,1,1,0,0,0]
fn rep_encode(bits, n) -> any
    rep_encode_msg(bits, n)

// rep_decode: decode an encoded word (list of bits) by majority vote per group.
// The code length must be divisible by n.
// Example: rep_decode([1,1,1,0,0,0], 3) == [1,0]
fn rep_decode(code, n) -> any
    let total = len(code)
    let nblocks = total / n
    let out = []
    for i in 0..nblocks
        let group = []
        let j = 0
        while j < n
            push(group, code[i * n + j])
            j = j + 1
        push(out, rep_decode_block(group))
    out
