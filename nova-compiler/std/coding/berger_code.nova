// std/coding/berger_code.nova — Berger code for unidirectional error detection.
//
// A Berger code appends check bits encoding the count of ZERO bits in the
// information word.  This detects ALL unidirectional errors — errors where all
// changed bits flip in the same direction (all 0→1 or all 1→0).  No symmetric
// error correction is performed.
//
// Code parameters for an k-bit information word:
//   - check bits: c = ceil(log2(k+1))   (enough to represent counts 0..k)
//   - total codeword length: k + c bits
//   - detects: all unidirectional errors (100% detection, proven by Berger 1961)
//   - corrects: 0 errors (detection only)
//
// Example: k=4, information = [1,0,1,0]
//   zeros  = 2
//   c      = ceil(log2(5)) = 3
//   check  = binary(2, 3 bits) = [0,1,0]
//   code   = [1,0,1,0, 0,1,0]
//
// SELF-CONTAINED — imports NOTHING.
// All private helpers are prefixed _bg_ to avoid global symbol collisions.

// _bg_list_eq — element-wise equality of two int lists.
fn _bg_list_eq(a, b) -> bool
    let na = len(a)
    let nb = len(b)
    if na != nb
        return false
    for i in 0..na
        if a[i] != b[i]
            return false
    true

// _bg_ceil_log2 — smallest integer c such that 2^c >= x.
// Used to compute the number of check bits needed.
// For x <= 1 returns 0; for x=2 returns 1; for x=3..4 returns 2; etc.
fn _bg_ceil_log2(x) -> int
    if x <= 1
        return 0
    let c = 0
    let p = 1
    while p < x
        p = p + p
        c = c + 1
    c

// bg_check_bits_needed — number of check bits for a k-bit information word.
// The check bits must be able to represent the zero-count, which ranges 0..k.
// This requires ceil(log2(k+1)) bits (enough bits for the value k itself).
fn bg_check_bits_needed(k) -> int
    _bg_ceil_log2(k + 1)

// bg_count_zeros — count the number of 0-bits in a bit list.
fn bg_count_zeros(bits) -> int
    let n = len(bits)
    let count = 0
    for i in 0..n
        if bits[i] == 0
            count = count + 1
    count

// _bg_int_to_bits — convert a non-negative integer to a list of c bits, MSB first.
fn _bg_int_to_bits(v, c) -> any
    let result = []
    for i in 0..c
        result.push(0)
    let pos = c - 1
    let rem = v
    while pos >= 0
        let bit = rem & 1
        result[pos] = bit
        rem = (rem >> 1) & 0x7FFFFFFFFFFFFFFF
        pos = pos - 1
    result

// bg_check_value — compute the check-bit portion for a given information bit list.
// Returns a list of ceil(log2(k+1)) bits representing the count of zeros in bits.
fn bg_check_value(bits) -> any
    let k = len(bits)
    let c = bg_check_bits_needed(k)
    let zeros = bg_count_zeros(bits)
    _bg_int_to_bits(zeros, c)

// bg_encode — encode an information bit list as a Berger codeword.
// Appends ceil(log2(k+1)) check bits = binary encoding of the zero count.
// Returns a new list: information bits followed by check bits.
fn bg_encode(bits) -> any
    let k = len(bits)
    let chk = bg_check_value(bits)
    let c = len(chk)
    let code = []
    for i in 0..k
        code.push(bits[i])
    for j in 0..c
        code.push(chk[j])
    code

// bg_verify — check a Berger codeword for validity.
// k is the number of information bits (the rest are check bits).
// Returns true iff the check bits match the zero count of the first k bits.
fn bg_verify(code, k) -> bool
    let c = bg_check_bits_needed(k)
    if len(code) != k + c
        return false
    // Extract information bits
    let info = []
    for i in 0..k
        info.push(code[i])
    // Extract check bits
    let chk = []
    for j in 0..c
        chk.push(code[k + j])
    // Compute expected check bits
    let expected = bg_check_value(info)
    _bg_list_eq(chk, expected)

// bg_decode — extract the information bits from a Berger codeword.
// Returns the first k bits (no error correction — Berger is detection-only).
fn bg_decode(code, k) -> any
    let info = []
    for i in 0..k
        info.push(code[i])
    info

// bg_detects_unidirectional — always returns true.
// Berger codes are proven to detect ALL unidirectional errors by construction:
// any unidirectional flip changes the zero count, which mismatches the check bits.
fn bg_detects_unidirectional() -> bool
    true
