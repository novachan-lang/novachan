// ============================================================================
// NOVA Standard Library — std/coding/convolutional
// ============================================================================
// Rate-1/2 constraint-length-3 convolutional encoder.
//
// Generator polynomials (octal notation standard):
//   G1 = 7  (binary 111) — output bit 0: XOR of input, shift-reg[0], shift-reg[1]
//   G2 = 5  (binary 101) — output bit 1: XOR of input, shift-reg[1]
//
// State = 2-bit shift register = last 2 input bits fed in.
//   state[0] = most recent previous input bit  (s1)
//   state[1] = older previous input bit        (s2)
//
// For each input bit `u`:
//   g1_out = u ^ s1 ^ s2
//   g2_out = u ^ s2
//   next state: shift register shifts left — new s1 = u, new s2 = old s1
//
// Encoding with flush appends 2 zero bits (K-1 = 2) to drain the shift register,
// producing 2*(N + K-1) output bits for N input bits.
//
// Code parameters:
//   Rate = 1/2
//   Constraint length K = 3
//   Free distance d_free = 5
//   Error-correction capability t = floor((d_free - 1) / 2) = 2
//
// PUBLIC API (prefix cv_):
//   cv_encode(bits)               -> any   Rate-1/2 encode with 2-zero flush
//   cv_encode_no_flush(bits)      -> any   Rate-1/2 encode without flush
//   cv_state_transition(state, u) -> any   [next_state, [g1_out, g2_out]]
//   cv_output(state, u)           -> any   [g1_out, g2_out]
//   cv_g1()                       -> int   7
//   cv_g2()                       -> int   5
//   cv_rate()                     -> any   [1, 2]
//   cv_constraint()               -> int   3
//
// KNOWN TEST VECTORS:
//   cv_g1() == 7
//   cv_g2() == 5
//   cv_constraint() == 3
//   cv_encode([1]) == [1,1, 1,0, 1,1]
//   cv_output(0, 1) == [1, 1]
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _cv_s1: extract s1 (bit 1, higher) from 2-bit state (0..3).
// state = s1*2 + s2  where s1 is most-recently-shifted-in.
fn _cv_s1(state) -> int
    let v = (state >> 1) & 1
    v

// _cv_s2: extract s2 (bit 0, older) from 2-bit state (0..3).
fn _cv_s2(state) -> int
    let v = state & 1
    v

// _cv_encode_step: produce [g1_out, g2_out] from state and one input bit.
// g1 = u ^ s1 ^ s2,  g2 = u ^ s2
fn _cv_encode_step(state, u) -> any
    let s1 = _cv_s1(state)
    let s2 = _cv_s2(state)
    let g1 = u ^ s1 ^ s2
    let g2 = u ^ s2
    let out = []
    push(out, g1)
    push(out, g2)
    out

// _cv_next_state: advance the shift register by one input bit.
// New state: new_s1 = u,  new_s2 = old s1  => state = u*2 + s1
fn _cv_next_state(state, u) -> int
    let s1 = _cv_s1(state)
    let ns = u * 2 + s1
    ns

// ── Public API ────────────────────────────────────────────────────────────────

// cv_g1: return generator polynomial G1 value (7 = binary 111).
fn cv_g1() -> int
    7

// cv_g2: return generator polynomial G2 value (5 = binary 101).
fn cv_g2() -> int
    5

// cv_constraint: return constraint length K = 3.
fn cv_constraint() -> int
    3

// cv_rate: return code rate as [numerator, denominator] = [1, 2].
fn cv_rate() -> any
    let r = []
    push(r, 1)
    push(r, 2)
    r

// cv_output: compute the 2 output bits for a given state and input bit.
// Returns [g1_out, g2_out] where g1 = u^s1^s2 and g2 = u^s2.
//
// Example: cv_output(0, 1) == [1, 1]
fn cv_output(state, inbit) -> any
    _cv_encode_step(state, inbit)

// cv_state_transition: compute the next state and output bits for one input bit.
// Returns [next_state, [g1_out, g2_out]].
//
// Example: cv_state_transition(0, 1) == [2, [1, 1]]
fn cv_state_transition(state, inbit) -> any
    let outs = _cv_encode_step(state, inbit)
    let ns = _cv_next_state(state, inbit)
    let result = []
    push(result, ns)
    push(result, outs)
    result

// cv_encode_no_flush: rate-1/2 encode without appending flush zeros.
// For N input bits, produces exactly 2*N output bits (interleaved g1, g2 pairs).
// Initial state is always 00.
//
// Example: cv_encode_no_flush([1, 0]) == [1,1, 1,0]
fn cv_encode_no_flush(bits) -> any
    let n = len(bits)
    let state = 0
    let out = []
    for i in 0..n
        let u = bits[i]
        let pair = _cv_encode_step(state, u)
        push(out, pair[0])
        push(out, pair[1])
        state = _cv_next_state(state, u)
    out

// cv_encode: rate-1/2 encode with 2-zero flush to drain the shift register.
// For N input bits, produces 2*(N + K-1) = 2*(N+2) output bits.
// The 2 appended flush bits return the encoder to state 00.
// Initial state is always 00.
//
// Example: cv_encode([1]) == [1,1, 1,0, 1,1]
//   Step 0: u=1, state=00 -> g1=1^0^0=1, g2=1^0=1 -> 11; next_state=10
//   Step 1: u=0, state=10 -> g1=0^1^0=1, g2=0^0=0 -> 10; next_state=01
//   Step 2: u=0, state=01 -> g1=0^0^1=1, g2=0^1=1 -> 11; next_state=00
fn cv_encode(bits) -> any
    let n = len(bits)
    let state = 0
    let out = []
    for i in 0..n
        let u = bits[i]
        let pair = _cv_encode_step(state, u)
        push(out, pair[0])
        push(out, pair[1])
        state = _cv_next_state(state, u)
    // flush: K-1 = 2 zero bits
    for f in 0..2
        let pair = _cv_encode_step(state, 0)
        push(out, pair[0])
        push(out, pair[1])
        state = _cv_next_state(state, 0)
    out
