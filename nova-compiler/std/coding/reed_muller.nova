// ============================================================================
// NOVA Standard Library — std/coding/reed_muller
// ============================================================================
// Reed-Muller RM(1,m) codes: first-order Reed-Muller codes.
//
// RM(1,m): length n=2^m, dimension k=m+1, minimum distance d=2^(m-1).
// Corrects t = floor((d-1)/2) = 2^(m-2) - ... for m>=2, concretely:
//   RM(1,3): n=8, k=4, d=4, t=1  (corrects 1 error)
//
// This implementation focuses on RM(1,3) for fixed-parameter functions
// (rm_encode, rm_decode, rm_correct) and provides general-m functions
// (rm_generator, rm_dimension, rm_length, rm_min_distance).
//
// GENERATOR MATRIX G for RM(1,m) is (m+1) x 2^m:
//   Row 0: all-ones vector [1,1,...,1]
//   Row i (i=1..m): bit (i-1) of column index j for j=0..2^m-1
// Encoding: c = msg * G  (over GF(2), i.e., XOR of selected rows)
//
// DECODING via Fast Hadamard Transform (majority-logic equivalent):
//   Map codeword bits 0->-1, 1->+1. Apply Hadamard transform.
//   The peak magnitude position gives the message. Sign of peak at pos 0
//   gives message bit m0 (the all-ones row coefficient).
//
// SYMBOLS: all public fns prefixed rm_
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// list_eq: true if two int lists have identical length and contents.
fn _rm_list_eq(a, b) -> bool
    let la = len(a)
    let lb = len(b)
    if la != lb
        return 0
    for i in 0..la
        if a[i] != b[i]
            return 0
    1

// Compute 2^k (integer power of 2).
fn _rm_pow2(k) -> int
    let r = 1
    for i in 0..k
        r = r * 2
    r

// XOR two lists of equal length (GF(2) addition).
fn _rm_xor_lists(a, b) -> any
    let n = len(a)
    let out = []
    let i = 0
    while i < n
        push(out, (a[i] ^ b[i]) & 1)
        i += 1
    out

// Return bit k of integer v (0 = LSB).
fn _rm_bit(v, k) -> int
    let shifted = v >> k
    shifted & 1

// ── General RM(1,m) functions ─────────────────────────────────────────────────

// rm_length: codeword length for RM(1,m) = 2^m.
fn rm_length(m) -> int
    _rm_pow2(m)

// rm_dimension: message length for RM(1,m) = m+1.
fn rm_dimension(m) -> int
    m + 1

// rm_min_distance: minimum Hamming distance for RM(1,m) = 2^(m-1).
fn rm_min_distance(m) -> int
    _rm_pow2(m - 1)

// rm_generator: generator matrix for RM(1,m) as list of (m+1) rows,
// each row a list of n=2^m bits.
// Row 0 = all-ones. Row i (i=1..m) = bit (i-1) of column index.
fn rm_generator(m) -> any
    let n = _rm_pow2(m)
    let k = m + 1
    let rows = []
    // Row 0: all-ones
    let row0 = []
    let j = 0
    while j < n
        push(row0, 1)
        j += 1
    push(rows, row0)
    // Rows 1..m: coordinate vectors
    let i = 1
    while i <= m
        let rowi = [_rm_bit(jj, i - 1) for jj in 0..n]
        push(rows, rowi)
        i += 1
    rows

// ── RM(1,3) fixed functions ───────────────────────────────────────────────────

// rm_encode: encode a 4-bit message as an 8-bit RM(1,3) codeword.
// msg = [m0, m1, m2, m3]; output = 8-bit list over GF(2).
// c[j] = m0 XOR (m1 * bit0(j)) XOR (m2 * bit1(j)) XOR (m3 * bit2(j)), j=0..7
fn rm_encode(msg) -> any
    let m0 = msg[0] & 1
    let m1 = msg[1] & 1
    let m2 = msg[2] & 1
    let m3 = msg[3] & 1
    let out = []
    for j in 0..8
        let b0 = _rm_bit(j, 0)
        let b1 = _rm_bit(j, 1)
        let b2 = _rm_bit(j, 2)
        let c = (m0 ^ (m1 * b0) ^ (m2 * b1) ^ (m3 * b2)) & 1
        push(out, c)
    out

// _rm_hadamard8: apply length-8 Walsh-Hadamard transform to an array of ints.
// H8 = H2 tensor H2 tensor H2; butterfly in 3 stages.
// Input: 8 ints (mapped from bits: 0-bit->-1, 1-bit->+1).
// Output: 8 ints (un-normalized transform).
fn _rm_hadamard8(r) -> any
    // Make a mutable copy
    let a = [r[i] for i in 0..8]
    // Stage 1: stride 1, pairs (0,1),(2,3),(4,5),(6,7)
    let j = 0
    while j < 8
        let u = a[j]
        let v = a[j + 1]
        a[j] = u + v
        a[j + 1] = u - v
        j += 2
    // Stage 2: stride 2, pairs (0,2),(1,3),(4,6),(5,7)
    let k = 0
    while k < 8
        let u2 = a[k]
        let v2 = a[k + 2]
        a[k] = u2 + v2
        a[k + 2] = u2 - v2
        let u3 = a[k + 1]
        let v3 = a[k + 3]
        a[k + 1] = u3 + v3
        a[k + 3] = u3 - v3
        k += 4
    // Stage 3: stride 4, pairs (0,4),(1,5),(2,6),(3,7)
    let p = 0
    while p < 4
        let u4 = a[p]
        let v4 = a[p + 4]
        a[p] = u4 + v4
        a[p + 4] = u4 - v4
        p += 1
    a

// _rm_abs: absolute value (integer).
fn _rm_abs(x) -> int
    if x < 0
        return 0 - x
    x

// rm_decode: decode an 8-bit received word to a 4-bit message via fast
// Hadamard transform (majority-logic decoding for RM(1,3)).
// Corrects up to 1 error (t=1, since d=4).
// Algorithm:
//   1. Map bits: 0->-1, 1->+1  (bipolar representation)
//   2. Apply WHT (Walsh-Hadamard Transform)
//   3. Find position p with maximum |WHT[p]|
//   4. m0 = sign(WHT[0]) -- coefficient of all-ones row, read at pos 0
//      Actually: sign of WHT[p] at peak position, then unpack p for m1..m3,
//      and m0 from sign(WHT[peak]) if peak != 0, or sign(WHT[0]) if peak = 0.
//   Correct decoding: peak at index p means:
//     - The message vector (excluding m0) encodes p in binary: m1=bit0(p), m2=bit1(p), m3=bit2(p)
//     - m0 = 1 if WHT[p] > 0, else m0 = 0
fn rm_decode(code) -> any
    // Map to bipolar: bit 0 -> -1, bit 1 -> +1
    let r = []
    for i in 0..8
        if code[i] == 1
            push(r, 1)
        else
            push(r, 0 - 1)
    // Apply WHT
    let h = _rm_hadamard8(r)
    // Find peak magnitude
    let peak_idx = 0
    let peak_val = h[0]
    let peak_abs = _rm_abs(h[0])
    for j in 1..8
        let av = _rm_abs(h[j])
        if av > peak_abs
            peak_abs = av
            peak_val = h[j]
            peak_idx = j
    // Recover message
    // m0 = 1 if WHT[peak_idx] > 0, else 0
    let m0 = 0
    if peak_val > 0
        m0 = 1
    // m1,m2,m3 from binary representation of peak_idx
    let m1 = _rm_bit(peak_idx, 0)
    let m2 = _rm_bit(peak_idx, 1)
    let m3 = _rm_bit(peak_idx, 2)
    let out = []
    push(out, m0)
    push(out, m1)
    push(out, m2)
    push(out, m3)
    out

// rm_correct: apply error correction and return the corrected codeword.
// Decodes the message, then re-encodes it to get the nearest codeword.
fn rm_correct(code) -> any
    let msg = rm_decode(code)
    rm_encode(msg)
