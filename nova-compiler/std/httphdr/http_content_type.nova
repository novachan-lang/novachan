// ============================================================================
// NOVA Standard Library — std/httphdr/http_content_type
// ============================================================================
// HTTP Content-Type header value parser (RFC 7231 §3.1.1.5).
//
// PUBLIC API:
//   hct_mime(s)        -> string
//     Return "type/subtype" (lowercased) with all parameters stripped.
//
//   hct_type(s)        -> string
//     Return the media type component (before "/"), lowercased.
//
//   hct_subtype(s)     -> string
//     Return the media subtype component (after "/"), lowercased.
//
//   hct_charset(s)     -> string
//     Return the charset parameter value (lowercased), or "" if absent.
//
//   hct_boundary(s)    -> string
//     Return the boundary parameter value, or "" if absent.
//     Boundary values are NOT lowercased (they are opaque tokens).
//
//   hct_param(s, key)  -> string
//     Return the value of any named parameter (key matched case-insensitively).
//     Returns "" if absent. Value is unquoted.
//
// DESIGN:
//   Content-Type: type/subtype *( ";" SP param )
//   We split on the first ";", take the left side as the media type, and parse
//   remaining tokens as key=value parameters per RFC 7231.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _hct_trim: strip leading and trailing ASCII spaces.
fn _hct_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and char_at(s, start) == " "
        start += 1
    let stop = n - 1
    while stop >= start and char_at(s, stop) == " "
        stop -= 1
    if start > stop
        return ""
    slice(s, start, stop + 1)

// _hct_to_lower: ASCII-lowercase a string.
fn _hct_to_lower(s: string) -> string
    let n = len(s)
    let result_parts = []
    for i in 0..n
        let c = char_at(s, i)
        let o = ord(c)
        if o >= 65 and o <= 90
            push(result_parts, chr(o + 32))
        else
            push(result_parts, c)
    let result = join(result_parts, "")
    result

// _hct_unquote: remove surrounding double-quotes (if present).
fn _hct_unquote(s: string) -> string
    let n = len(s)
    if n >= 2 and char_at(s, 0) == "\"" and char_at(s, n - 1) == "\""
        return slice(s, 1, n - 1)
    s

// _hct_find_char: find first occurrence of c in s at or after pos.
// Returns -1 if not found.
fn _hct_find_char(s: string, c: string, pos: int) -> int
    let n = len(s)
    let i = pos
    let found = -1
    while i < n and found < 0
        if char_at(s, i) == c
            found = i
        else
            i += 1
    found

// _hct_media_type: return the lowercased "type/subtype" portion of s.
// This is the text before the first ";", trimmed.
fn _hct_media_type(s: string) -> string
    if len(s) == 0
        return ""
    let tokens = split(s, ";")
    _hct_to_lower(_hct_trim(tokens[0]))

// _hct_param_val: extract a named parameter from a parsed token list.
// tokens[0] = media type; tokens[1..] = param tokens "key=value".
// Returns unquoted value or "" if not found.
fn _hct_param_val(tokens: list, pname: string) -> string
    let target = _hct_to_lower(_hct_trim(pname))
    let n = len(tokens)
    let i = 1
    let result = ""
    while i < n
        let tok = _hct_trim(tokens[i])
        let eq = _hct_find_char(tok, "=", 0)
        if eq >= 0
            let kraw = _hct_to_lower(_hct_trim(slice(tok, 0, eq)))
            if kraw == target
                let vraw = _hct_unquote(_hct_trim(slice(tok, eq + 1, len(tok))))
                result = vraw
                i = n
            else
                i += 1
        else
            i += 1
    result

// ── Public API ────────────────────────────────────────────────────────────────

// hct_mime: return the lowercased "type/subtype" with all parameters stripped.
fn hct_mime(s: string) -> string
    _hct_media_type(s)

// hct_type: return the major type component (before "/"), lowercased.
fn hct_type(s: string) -> string
    let mt = _hct_media_type(s)
    if len(mt) == 0
        return ""
    let slash = _hct_find_char(mt, "/", 0)
    if slash < 0
        return mt
    slice(mt, 0, slash)

// hct_subtype: return the subtype component (after "/"), lowercased.
fn hct_subtype(s: string) -> string
    let mt = _hct_media_type(s)
    if len(mt) == 0
        return ""
    let slash = _hct_find_char(mt, "/", 0)
    if slash < 0
        return ""
    slice(mt, slash + 1, len(mt))

// hct_charset: return the charset parameter value (lowercased), or "".
fn hct_charset(s: string) -> string
    if len(s) == 0
        return ""
    let tokens = split(s, ";")
    let raw = _hct_param_val(tokens, "charset")
    _hct_to_lower(raw)

// hct_boundary: return the boundary parameter value (case-preserved), or "".
fn hct_boundary(s: string) -> string
    if len(s) == 0
        return ""
    let tokens = split(s, ";")
    _hct_param_val(tokens, "boundary")

// hct_param: return the value of a named parameter (case-insensitive key), or "".
fn hct_param(s: string, key: string) -> string
    if len(s) == 0
        return ""
    let tokens = split(s, ";")
    _hct_param_val(tokens, key)
