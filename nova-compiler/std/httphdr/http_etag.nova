// ============================================================================
// NOVA Standard Library — std/httphdr/http_etag
// ============================================================================
// HTTP ETag value parser and comparator (RFC 7232).
//
// An ETag is either a strong tag:  "opaque-string"
// or a weak tag:                   W/"opaque-string"
//
// PUBLIC API:
//   het_is_weak(s)           -> bool   true if s starts with W/
//   het_tag(s)               -> string opaque tag with surrounding quotes stripped
//   het_strong_match(a, b)   -> bool   both strong AND tags equal
//   het_weak_match(a, b)     -> bool   tags equal ignoring weakness
//   het_matches_list(etag, if_none_match) -> bool
//                                       '*' matches any; else weak-compare against the comma list
//
// LEAF — imports NOTHING.
// ============================================================================

// _het_trim: strip leading and trailing ASCII spaces from a string.
fn _het_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and char_at(s, start) == " "
        start += 1
    let stop = n - 1
    while stop >= start and char_at(s, stop) == " "
        stop -= 1
    if start > stop
        return ""
    slice(s, start, stop + 1)

// _het_starts_with: true if s begins with prefix.
fn _het_starts_with(s: string, prefix: string) -> bool
    let pn = len(prefix)
    if pn > len(s)
        return false
    slice(s, 0, pn) == prefix

// _het_extract_tag: extract the opaque tag from an ETag value string.
// Strips the W/ prefix if present, then strips surrounding double-quotes.
// Returns the raw inner string, or "" if malformed.
fn _het_extract_tag(s: string) -> string
    let src = _het_trim(s)
    // Strip weak prefix
    if _het_starts_with(src, "W/")
        src = slice(src, 2, len(src))
    // Must now be a quoted string
    let n = len(src)
    if n < 2
        return ""
    if char_at(src, 0) != chr(34)
        return ""
    if char_at(src, n - 1) != chr(34)
        return ""
    slice(src, 1, n - 1)

// _het_split_comma: split s on commas and return list of trimmed segments.
fn _het_split_comma(s: string) -> list
    let parts = split(s, ",")
    let result = []
    for i in 0..len(parts)
        let t = _het_trim(parts[i])
        if len(t) > 0
            push(result, t)
    result

// het_is_weak: return true if the ETag value starts with W/ (weak tag).
// Example: het_is_weak('W/"abc"') -> true
//          het_is_weak('"abc"')   -> false
fn het_is_weak(s: string) -> bool
    _het_starts_with(_het_trim(s), "W/")

// het_tag: return the opaque tag string with its surrounding quotes stripped.
// Works for both strong ("abc") and weak (W/"abc") ETags.
// Returns "" for malformed input.
// Example: het_tag('W/"abc"') -> 'abc'
//          het_tag('"hello"') -> 'hello'
fn het_tag(s: string) -> string
    _het_extract_tag(s)

// het_strong_match: true when both a and b are strong tags and their tags are equal.
// A weak tag never strongly matches anything.
// Example: het_strong_match('"abc"', '"abc"') -> true
//          het_strong_match('W/"abc"', '"abc"') -> false
fn het_strong_match(a: string, b: string) -> bool
    if het_is_weak(a)
        return false
    if het_is_weak(b)
        return false
    _het_extract_tag(a) == _het_extract_tag(b)

// het_weak_match: true when the opaque tags of a and b are equal (ignoring W/ prefix).
// Example: het_weak_match('W/"abc"', '"abc"') -> true
//          het_weak_match('"x"', '"y"')       -> false
fn het_weak_match(a: string, b: string) -> bool
    _het_extract_tag(a) == _het_extract_tag(b)

// het_matches_list: true if etag weak-matches any entry in the If-None-Match list.
// '*' in if_none_match matches any non-empty ETag.
// Otherwise splits the list on commas and compares tags using weak match.
// Example: het_matches_list('"abc"', '*')           -> true
//          het_matches_list('"abc"', '"x", "abc"')  -> true
//          het_matches_list('"abc"', '"y"')          -> false
fn het_matches_list(etag: string, if_none_match: string) -> bool
    let inm = _het_trim(if_none_match)
    if inm == "*"
        return true
    if len(_het_trim(etag)) == 0
        return false
    let candidates = _het_split_comma(inm)
    for i in 0..len(candidates)
        if het_weak_match(etag, candidates[i])
            return true
    false
