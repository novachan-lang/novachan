// ============================================================================
// NOVA Standard Library — std/httphdr/http_link
// ============================================================================
// HTTP Link header value parser (RFC 8288).
//
// A Link header value is a comma-separated list of link values, each of the form:
//   <URL>; param1=value1; param2=value2; ...
//
// This module extracts the URL (from angle brackets) and the rel= parameter.
//
// PUBLIC API:
//   hlk_parse(s)        -> list of [url, rel] pairs parsed from the Link header
//   hlk_by_rel(s, rel)  -> url string for the given rel, or "" if not found
//   hlk_rels(s)         -> list of all rel values found in the header
//
// LEAF — imports NOTHING.
// ============================================================================

// _hlk_trim: strip leading and trailing ASCII spaces from a string.
fn _hlk_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and char_at(s, start) == " "
        start = start + 1
    let stop = n - 1
    while stop >= start and char_at(s, stop) == " "
        stop = stop - 1
    if start > stop
        return ""
    slice(s, start, stop + 1)

// _hlk_to_lower: convert ASCII uppercase letters to lowercase.
fn _hlk_to_lower(s: string) -> string
    let n = len(s)
    let result_parts = []
    for i in 0..n
        let c = char_at(s, i)
        let o = ord(c)
        if o >= 65 and o <= 90
            push(result_parts, chr(o + 32))
        else
            push(result_parts, c)
    let result = join(result_parts, "")
    result

// _hlk_index_of_char: find the first occurrence of char c in s starting at from.
// Returns -1 if not found.
fn _hlk_index_of_char(s: string, c: string, from: int) -> int
    let n = len(s)
    let i = from
    while i < n
        if char_at(s, i) == c
            return i
        i = i + 1
    -1

// _hlk_strip_quotes: if s is surrounded by double-quotes, return inner content.
// Otherwise return s unchanged.
fn _hlk_strip_quotes(s: string) -> string
    let n = len(s)
    if n >= 2 and char_at(s, 0) == chr(34) and char_at(s, n - 1) == chr(34)
        return slice(s, 1, n - 1)
    s

// _hlk_extract_url: extract the URL from a single link segment like '<URL>; ...'.
// Returns "" if no angle brackets found.
fn _hlk_extract_url(seg: string) -> string
    let n = len(seg)
    let open = _hlk_index_of_char(seg, "<", 0)
    if open < 0
        return ""
    let close = _hlk_index_of_char(seg, ">", open + 1)
    if close < 0
        return ""
    slice(seg, open + 1, close)

// _hlk_extract_rel: extract the rel parameter value from a single link segment.
// Searches for 'rel=' (case-insensitive) in the params section after the '>'.
// Returns "" if no rel= parameter found.
fn _hlk_extract_rel(seg: string) -> string
    let n = len(seg)
    // Find end of URL part
    let close = _hlk_index_of_char(seg, ">", 0)
    if close < 0
        return ""
    let rest = slice(seg, close + 1, n)
    // Split rest on ';' to get parameters
    let params = split(rest, ";")
    for i in 0..len(params)
        let p = _hlk_trim(params[i])
        let pl = _hlk_to_lower(p)
        // Check if this param starts with 'rel='
        if len(pl) >= 4 and slice(pl, 0, 4) == "rel="
            let val = slice(p, 4, len(p))
            return _hlk_strip_quotes(_hlk_trim(val))
    ""

// _hlk_split_links: split the Link header value on commas, but only at the
// top level (outside angle brackets). Returns list of raw link segments.
// Simple approach: split on ", " but re-join if inside <>.
fn _hlk_split_links(s: string) -> list
    let result = []
    let n = len(s)
    let i = 0
    let seg = ""
    let depth = 0
    while i < n
        let c = char_at(s, i)
        if c == "<"
            depth = depth + 1
            seg = seg + c
        else if c == ">"
            depth = depth - 1
            seg = seg + c
        else if c == "," and depth == 0
            let trimmed = _hlk_trim(seg)
            if len(trimmed) > 0
                push(result, trimmed)
            seg = ""
        else
            seg = seg + c
        i = i + 1
    let last = _hlk_trim(seg)
    if len(last) > 0
        push(result, last)
    result

// hlk_parse: parse a Link header value and return a list of [url, rel] pairs.
// Entries without a rel= parameter have rel="" in their pair.
// Example: hlk_parse('<https://x>; rel="self"') -> [['https://x', 'self']]
fn hlk_parse(s: string) -> list
    let result = []
    if len(_hlk_trim(s)) == 0
        return result
    let segs = _hlk_split_links(s)
    for i in 0..len(segs)
        let seg = segs[i]
        let url = _hlk_extract_url(seg)
        let rel = _hlk_extract_rel(seg)
        let pair = []
        push(pair, url)
        push(pair, rel)
        push(result, pair)
    result

// hlk_by_rel: return the URL for the first link with the given rel value.
// Comparison is case-insensitive. Returns "" if not found.
// Example: hlk_by_rel('<https://api/p2>; rel="next"', 'next') -> 'https://api/p2'
fn hlk_by_rel(s: string, rel: string) -> string
    let pairs = hlk_parse(s)
    let want = _hlk_to_lower(rel)
    for i in 0..len(pairs)
        let pair = pairs[i]
        let prel = _hlk_to_lower(pair[1])
        if prel == want
            return pair[0]
    ""

// hlk_rels: return a list of all rel values found in the Link header.
// Preserves order; entries with empty rel are excluded.
// Example: hlk_rels('<u1>; rel="next", <u2>; rel="last"') -> ['next', 'last']
fn hlk_rels(s: string) -> list
    let pairs = hlk_parse(s)
    let result = []
    for i in 0..len(pairs)
        let pair = pairs[i]
        let rel = pair[1]
        if len(rel) > 0
            push(result, rel)
    result
