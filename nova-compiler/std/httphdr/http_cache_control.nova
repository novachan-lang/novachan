// ============================================================================
// NOVA Standard Library — std/httphdr/http_cache_control
// ============================================================================
// HTTP Cache-Control header value parser (RFC 7234 §5.2).
//
// PUBLIC API:
//   hcc_parse(s)          -> list of [directive, value] pairs
//     Parse Cache-Control header value into a list of 2-element lists.
//     Valueless directives (e.g. "no-store") get value "".
//     Directive names are lowercased. Quoted values are unquoted.
//
//   hcc_max_age(s)        -> int  (-1 if absent)
//     Extract the max-age directive value as an integer.
//
//   hcc_has(s, directive) -> bool  (case-insensitive)
//     Return true if the named directive is present.
//
//   hcc_is_cacheable(s)   -> bool
//     Return false if s contains no-store, no-cache, or private.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _hcc_trim: strip leading and trailing ASCII spaces from a string.
fn _hcc_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and char_at(s, start) == " "
        start = start + 1
    let stop = n - 1
    while stop >= start and char_at(s, stop) == " "
        stop = stop - 1
    if start > stop
        return ""
    slice(s, start, stop + 1)

// _hcc_to_lower: ASCII-lowercase a string.
fn _hcc_to_lower(s: string) -> string
    let n = len(s)
    let result = ""
    let i = 0
    while i < n
        let c = char_at(s, i)
        let o = ord(c)
        if o >= 65 and o <= 90
            result = result + chr(o + 32)
        else
            result = result + c
        i = i + 1
    result

// _hcc_unquote: remove surrounding double-quotes from a value string (if any).
fn _hcc_unquote(s: string) -> string
    let n = len(s)
    if n >= 2 and char_at(s, 0) == "\"" and char_at(s, n - 1) == "\""
        return slice(s, 1, n - 1)
    s

// _hcc_find_char: find first occurrence of character c in s starting at pos.
// Returns -1 if not found.
fn _hcc_find_char(s: string, c: string, pos: int) -> int
    let n = len(s)
    let i = pos
    let found = -1
    while i < n and found < 0
        if char_at(s, i) == c
            found = i
        else
            i = i + 1
    found

// _hcc_parse_int: parse a non-negative decimal integer from string s.
// Returns -1 on empty or non-digit input.
fn _hcc_parse_int(s: string) -> int
    let n = len(s)
    if n == 0
        return -1
    let result = 0
    let i = 0
    let valid = 1
    while i < n
        let o = ord(char_at(s, i))
        if o >= 48 and o <= 57
            result = result * 10 + (o - 48)
        else
            valid = 0
            i = n
        i = i + 1
    if valid == 0
        return -1
    result

// ── Public API ────────────────────────────────────────────────────────────────

// hcc_parse: parse Cache-Control header value into [directive, value] pairs.
// Splits on commas; each token is split on the first '='.
// Directive names are lowercased; values are trimmed and unquoted.
fn hcc_parse(s: string) -> list
    let result = []
    if len(s) == 0
        return result
    let tokens = split(s, ",")
    let i = 0
    while i < len(tokens)
        let tok = _hcc_trim(tokens[i])
        if len(tok) > 0
            let eq = _hcc_find_char(tok, "=", 0)
            let pair = []
            if eq < 0
                pair.push(_hcc_to_lower(tok))
                pair.push("")
            else
                let dname = _hcc_to_lower(_hcc_trim(slice(tok, 0, eq)))
                let dval = _hcc_unquote(_hcc_trim(slice(tok, eq + 1, len(tok))))
                pair.push(dname)
                pair.push(dval)
            result.push(pair)
        i = i + 1
    result

// hcc_max_age: return the max-age directive value as an integer, or -1 if absent.
fn hcc_max_age(s: string) -> int
    let pairs = hcc_parse(s)
    let i = 0
    let found = -1
    while i < len(pairs)
        let pair = pairs[i]
        if pair[0] == "max-age"
            found = _hcc_parse_int(pair[1])
            i = len(pairs)
        else
            i = i + 1
    found

// hcc_has: return true if the Cache-Control value contains the given directive.
// Both the header value and the query directive are compared case-insensitively.
fn hcc_has(s: string, directive: string) -> bool
    let target = _hcc_to_lower(_hcc_trim(directive))
    let pairs = hcc_parse(s)
    let i = 0
    let found = false
    while i < len(pairs)
        let pair = pairs[i]
        if pair[0] == target
            found = true
            i = len(pairs)
        else
            i = i + 1
    found

// hcc_is_cacheable: return false if no-store, no-cache, or private is present.
fn hcc_is_cacheable(s: string) -> bool
    if hcc_has(s, "no-store")
        return false
    if hcc_has(s, "no-cache")
        return false
    if hcc_has(s, "private")
        return false
    true
