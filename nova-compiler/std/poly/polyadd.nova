// std/poly/polyadd.nova — polynomial addition, subtraction, scaling, and coefficient utilities.
// Representation: list of coefficients in ASCENDING degree order.
//   coeffs[i] = coefficient of x^i.  [6,-5,1] = 6 - 5x + x^2.
// All functions return normalized polynomials (no trailing zeros).
// LEAF — imports nothing.

// pa_normalize — strip trailing zero coefficients; [] represents the zero polynomial.
fn pa_normalize(p: list) -> any
    let n = len(p)
    let last = n - 1
    while last >= 0
        let v = p[last]
        if v != 0
            let out = []
            for i in 0..last + 1
                push(out, p[i])
            return out
        last -= 1
    let zero = []
    zero

// pa_degree — highest-index with a nonzero coefficient; -1 for the zero polynomial.
fn pa_degree(p: list) -> int
    let n = len(p)
    let d = n - 1
    while d >= 0
        if p[d] != 0
            return d
        d -= 1
    -1

// pa_is_zero — true iff p is the zero polynomial (empty or all zeros).
fn pa_is_zero(p: list) -> bool
    pa_degree(p) == -1

// pa_leading — leading coefficient (coefficient of the highest-degree term); 0 for zero poly.
fn pa_leading(p: list) -> int
    let d = pa_degree(p)
    if d == -1
        return 0
    p[d]

// pa_zero — canonical zero polynomial representation.
fn pa_zero() -> any
    let z = []
    z

// pa_constant — polynomial with a single constant term c; normalizes (0 -> []).
fn pa_constant(c: int) -> any
    if c == 0
        let z = []
        return z
    let out = []
    push(out, c)
    out

// pa_add — add two polynomials coefficient-wise; result is normalized.
fn pa_add(a: list, b: list) -> any
    let la = len(a)
    let lb = len(b)
    let lmax = la
    if lb > la
        lmax = lb
    let out = []
    for i in 0..lmax
        let va = 0
        let vb = 0
        if i < la
            va = a[i]
        if i < lb
            vb = b[i]
        push(out, va + vb)
    pa_normalize(out)

// pa_sub — subtract polynomial b from a; result is normalized.
fn pa_sub(a: list, b: list) -> any
    let la = len(a)
    let lb = len(b)
    let lmax = la
    if lb > la
        lmax = lb
    let out = []
    for i in 0..lmax
        let va = 0
        let vb = 0
        if i < la
            va = a[i]
        if i < lb
            vb = b[i]
        push(out, va - vb)
    pa_normalize(out)

// pa_scale — multiply every coefficient of p by scalar s; result is normalized.
fn pa_scale(p: list, s: int) -> any
    let n = len(p)
    let out = []
    for i in 0..n
        push(out, p[i] * s)
    pa_normalize(out)

// pa_neg — negate every coefficient of p; result is normalized.
fn pa_neg(p: list) -> any
    pa_scale(p, -1)

// pa_equal — true iff polynomials a and b are equal (after normalization).
fn pa_equal(a: list, b: list) -> bool
    let na = pa_normalize(a)
    let nb = pa_normalize(b)
    let la = len(na)
    let lb = len(nb)
    if la != lb
        return false
    for i in 0..la
        if na[i] != nb[i]
            return false
    true

// pa_shift — multiply p by x^k (prepend k zeros); k must be >= 0.
fn pa_shift(p: list, k: int) -> any
    let n = len(p)
    if n == 0
        let z = []
        return z
    if pa_is_zero(p)
        let z = []
        return z
    let out = []
    for i in 0..k
        push(out, 0)
    for j in 0..n
        push(out, p[j])
    pa_normalize(out)
