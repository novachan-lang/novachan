// std/poly/polymul.nova — polynomial multiplication, power, convolution, and scaling.
// Representation: list of coefficients in ASCENDING degree order.
//   coeffs[i] = coefficient of x^i.
// All functions return normalized polynomials (no trailing zeros).
// LEAF — imports nothing.

// pm_normalize — strip trailing zero coefficients; [] represents the zero polynomial.
fn pm_normalize(p: list) -> any
    let n = len(p)
    let last = n - 1
    while last >= 0
        let v = p[last]
        if v != 0
            let out = []
            let i = 0
            while i <= last
                push(out, p[i])
                i = i + 1
            return out
        last = last - 1
    let zero = []
    zero

// pm_degree — highest-index with a nonzero coefficient; -1 for the zero polynomial.
fn pm_degree(p: list) -> int
    let n = len(p)
    let d = n - 1
    while d >= 0
        if p[d] != 0
            return d
        d = d - 1
    -1

// pm_scale — multiply every coefficient of p by integer scalar s; result is normalized.
fn pm_scale(p: list, s: int) -> any
    let n = len(p)
    let out = []
    for i in 0..n
        push(out, p[i] * s)
    pm_normalize(out)

// pm_mul — multiply two polynomials via convolution; result is normalized.
// deg(result) = deg(a) + deg(b).  Zero polynomial * anything = zero polynomial.
fn pm_mul(a: list, b: list) -> any
    let la = len(a)
    let lb = len(b)
    if la == 0
        let z = []
        return z
    if lb == 0
        let z = []
        return z
    let da = pm_degree(a)
    let db = pm_degree(b)
    if da == -1
        let z = []
        return z
    if db == -1
        let z = []
        return z
    let lout = la + lb - 1
    let out = []
    let k = 0
    while k < lout
        push(out, 0)
        k = k + 1
    for i in 0..la
        let ai = a[i]
        if ai != 0
            let j = 0
            while j < lb
                let bj = b[j]
                let cur = out[i + j]
                out[i + j] = cur + ai * bj
                j = j + 1
    pm_normalize(out)

// pm_conv — convolution of two coefficient lists; alias for pm_mul.
fn pm_conv(a: list, b: list) -> any
    pm_mul(a, b)

// pm_square — square a polynomial; p^2 via convolution.
fn pm_square(p: list) -> any
    pm_mul(p, p)

// pm_mul_monomial — multiply polynomial p by c*x^k (k >= 0).
fn pm_mul_monomial(p: list, c: int, k: int) -> any
    if c == 0
        let z = []
        return z
    let n = len(p)
    if n == 0
        let z = []
        return z
    if pm_degree(p) == -1
        let z = []
        return z
    let out = []
    for i in 0..k
        push(out, 0)
    for j in 0..n
        push(out, p[j] * c)
    pm_normalize(out)

// pm_power — raise polynomial p to a non-negative integer power k.
// p^0 = [1] (even for the zero polynomial, matching mathematical convention).
fn pm_power(p: list, k: int) -> any
    if k == 0
        let one = []
        push(one, 1)
        return one
    let result = []
    push(result, 1)
    for i in 0..k
        result = pm_mul(result, p)
    result

// pm_multiply_all — product of a list of polynomials; empty list -> [1].
fn pm_multiply_all(polys: list) -> any
    let n = len(polys)
    let acc = []
    push(acc, 1)
    for i in 0..n
        let pi = polys[i]
        acc = pm_mul(acc, pi)
    acc
