// std/poly/polyfromroots.nova — build a polynomial from its roots + Vieta's formulas.
// Representation: ascending coefficient list; coeffs[i] = coefficient of x^i.
// Integer roots produce exact integer coefficients (stored as ints via 1.0 coerce).
// SELF-CONTAINED — imports NOTHING.
//
// PUBLIC API (prefix pfr_):
//   pfr_from_roots(roots) -> list          monic poly whose roots are the given values
//   pfr_from_roots_monic(roots) -> list    alias for pfr_from_roots
//   pfr_vieta(roots) -> list               signed elementary symmetric polynomials
//   pfr_sum_of_roots(poly) -> float        -c_{n-1}/c_n  (Vieta)
//   pfr_product_of_roots(poly) -> float    (-1)^n * c_0/c_n  (Vieta)
//   pfr_from_roots_scaled(roots, lead) -> list  same poly but with leading coeff = lead
//   pfr_verify(roots, tol) -> bool         eval built poly at each root; all must be ~0
//   pfr_add_root(poly, r) -> list          extend poly by (x - r)

// --- internal helpers ---

// Internal: multiply polynomial p by monomial (x - r).
// p is an ascending-coefficient list.  Result has len(p)+1 coefficients.
fn pfr_mul_monomial(p: list, r: int) -> list
    let n = len(p)
    // new polynomial has n+1 coefficients
    let out = []
    let k = 0
    while k <= n
        push(out, 0)
        k += 1
    // coefficient j of out = p[j-1] - r*p[j]  (where p[-1]=0, p[n]=0)
    let j = 0
    while j <= n
        let pj = 0
        let pjm1 = 0
        if j < n
            pj = p[j]
        if j > 0
            pjm1 = p[j - 1]
        out[j] = pjm1 - r * pj
        j += 1
    out

// Internal: evaluate polynomial at a float x using Horner's method.
fn pfr_eval(coeffs: list, x: float) -> float
    let n = len(coeffs)
    if n == 0
        let z = 0.0
        return z
    let result = coeffs[n - 1] * 1.0
    let i = n - 2
    while i >= 0
        let ci = coeffs[i] * 1.0
        result = result * x + ci
        i -= 1
    result

// --- Public functions ---

// pfr_from_roots — build the monic polynomial (x-r0)(x-r1)...(x-r_{k-1}).
// roots: list of integer values.
// Returns ascending coefficient list with len == len(roots)+1.
// pfr_from_roots([2,3]) = [6,-5,1] since (x-2)(x-3) = x^2 - 5x + 6.
fn pfr_from_roots(roots: list) -> list
    let n = len(roots)
    // start with p(x) = 1
    let p = [1]
    for i in 0..n
        let r = roots[i]
        p = pfr_mul_monomial(p, r)
    p

// pfr_from_roots_monic — identical to pfr_from_roots (always monic).
fn pfr_from_roots_monic(roots: list) -> list
    pfr_from_roots(roots)

// pfr_vieta — compute elementary symmetric polynomials e_1..e_n from n roots.
// Returns [(-1)^n * e_n, ..., (-1) * e_1, 1] which are the coefficients of
// the monic polynomial — same as pfr_from_roots but named for clarity.
fn pfr_vieta(roots: list) -> list
    pfr_from_roots(roots)

// pfr_sum_of_roots — by Vieta: sum of roots = -c_{n-1} / c_n.
// poly: ascending coefficient list of a monic or general polynomial.
fn pfr_sum_of_roots(poly: list) -> float
    let n = len(poly)
    if n < 2
        let z = 0.0
        return z
    let cn = poly[n - 1] * 1.0
    let cnm1 = poly[n - 2] * 1.0
    let result = 0.0 - cnm1 / cn
    result

// pfr_product_of_roots — by Vieta: product of roots = (-1)^n * c_0 / c_n.
// n is the degree (len(poly) - 1).
fn pfr_product_of_roots(poly: list) -> float
    let n = len(poly)
    if n < 2
        let z = 0.0
        return z
    let cn = poly[n - 1] * 1.0
    let c0 = poly[0] * 1.0
    let deg = n - 1
    // sign = (-1)^deg
    let sign = 1.0
    let half = deg / 2
    if half * 2 != deg
        sign = 0.0 - 1.0
    let result = sign * c0 / cn
    result

// pfr_from_roots_scaled — like pfr_from_roots but with leading coefficient = lead.
fn pfr_from_roots_scaled(roots: list, lead: int) -> list
    let p = pfr_from_roots(roots)
    let n = len(p)
    let out = []
    for i in 0..n
        let v = p[i] * lead
        push(out, v)
    out

// pfr_verify — evaluate the polynomial built from roots at each root; all must be ~0.
// Rebuilds the polynomial from roots, then checks eval at each root is within tol.
// Returns 1 (true) if all roots satisfy |p(root)| <= tol, else 0 (false).
fn pfr_verify(roots: list, tol: float) -> bool
    let poly = pfr_from_roots(roots)
    let n = len(roots)
    for i in 0..n
        let r = roots[i] * 1.0
        let v = pfr_eval(poly, r)
        let av = v
        if av < 0.0
            av = 0.0 - av
        if av > tol
            return false
    true

// pfr_add_root — extend an existing polynomial by multiplying by (x - r).
// Equivalent to adding one more root r to an already-built polynomial.
fn pfr_add_root(poly: list, r: int) -> list
    pfr_mul_monomial(poly, r)
