// std/poly/polygcd.nova — polynomial GCD/LCM over rationals using Euclidean algorithm.
// Polynomial representation: list of coefficients in ASCENDING order (coeffs[i] = coeff of x^i).
// GCD result is always normalized to monic (leading coefficient = 1.0) as floats.
// LEAF — imports nothing.
//
// FLOAT HAZARDS:
//   Bind every sub-expression to a named let.
//   Float abs: use (if v < 0.0 then 0.0 - v else v).
//   Float compare to zero: use abs(v) < eps.

// Return the degree of polynomial p (highest index with nonzero coeff); -1 for zero poly.
fn pg_degree(p) -> int
    let n = len(p)
    if n == 0
        return -1
    let d = n - 1
    while d >= 0
        let cv = p[d] * 1.0
        let acv = cv
        if acv < 0.0
            acv = 0.0 - acv
        if acv > 0.0000000001
            return d
        d -= 1
    -1

// Normalize polynomial p: strip trailing near-zero coefficients, return new list.
fn pg_normalize(p) -> any
    let n = len(p)
    if n == 0
        let empty = []
        return empty
    let d = pg_degree(p)
    if d < 0
        let empty2 = []
        return empty2
    let out = []
    let i = 0
    while i <= d
        let cv = p[i] * 1.0
        push(out, cv)
        i += 1
    out

// Divide polynomial a by leading coefficient to make it monic (leading coeff = 1.0).
fn pg_make_monic(p) -> any
    let d = pg_degree(p)
    if d < 0
        let empty = []
        return empty
    let lc = p[d] * 1.0
    let out = []
    let i = 0
    while i <= d
        let ci = p[i] * 1.0
        let v = ci / lc
        push(out, v)
        i += 1
    out

// Polynomial pseudo-division: returns [quotient, remainder] where a = q*b + r.
// Works over floats; both a and b must be non-empty.
fn pg_divmod(a, b) -> any
    let da = pg_degree(a)
    let db = pg_degree(b)
    if db < 0
        // division by zero — return [a, []] sentinel
        let result = []
        let na = pg_normalize(a)
        let rem = []
        push(result, na)
        push(result, rem)
        return result
    // copy a into rem as floats
    let rem = []
    let ai = 0
    while ai <= da
        let cv = a[ai] * 1.0
        push(rem, cv)
        ai += 1
    let quot = []
    let qi = 0
    let qlen = da - db + 1
    if qlen < 0
        qlen = 0
    while qi < qlen
        let zv = 0.0
        push(quot, zv)
        qi += 1
    let cur_deg = da
    while cur_deg >= db
        let leading = rem[cur_deg] * 1.0
        let lca = leading
        if lca < 0.0
            lca = 0.0 - lca
        if lca < 0.0000000001
            cur_deg -= 1
        else
            let b_lc = b[db] * 1.0
            let factor = leading / b_lc
            let q_idx = cur_deg - db
            quot[q_idx] = factor
            let j = 0
            while j <= db
                let bj = b[j] * 1.0
                let old_r = rem[cur_deg - db + j] * 1.0
                rem[cur_deg - db + j] = old_r - factor * bj
                j += 1
            cur_deg -= 1
    let norm_rem = pg_normalize(rem)
    let norm_quot = pg_normalize(quot)
    let result2 = []
    push(result2, norm_quot)
    push(result2, norm_rem)
    result2

// Polynomial GCD using the Euclidean algorithm; result is monic (leading coeff = 1).
fn pg_gcd(a, b) -> any
    let fa = pg_normalize(a)
    let fb = pg_normalize(b)
    let da = pg_degree(fa)
    let db = pg_degree(fb)
    // ensure deg(fa) >= deg(fb)
    let p = fa
    let q = fb
    if db > da
        p = fb
        q = fa
    let done = 0
    while done == 0
        let dq = pg_degree(q)
        if dq < 0
            done = 1
        else
            let parts = pg_divmod(p, q)
            let r = parts[1]
            p = q
            q = r
    // p is the gcd; make it monic
    let dp = pg_degree(p)
    if dp < 0
        // gcd is zero poly — shouldn't happen for nonzero inputs; return [1.0]
        let one = [1.0]
        return one
    let monic = pg_make_monic(p)
    monic

// Polynomial LCM: lcm(a,b) = a*b / gcd(a,b), returned monic.
fn pg_lcm(a, b) -> any
    let g = pg_gcd(a, b)
    let dg = pg_degree(g)
    if dg < 0
        let empty = []
        return empty
    // divide a by g to get a/g, then multiply by b
    let parts = pg_divmod(a, g)
    let ag = parts[0]
    // multiply ag * b
    let lag = len(ag)
    let lb = len(b)
    if lag == 0
        let empty2 = []
        return empty2
    if lb == 0
        let empty3 = []
        return empty3
    let lout = lag + lb - 1
    let out = []
    for k in 0..lout
        let zv = 0.0
        push(out, zv)
    for i in 0..lag
        let ai2 = ag[i] * 1.0
        let j = 0
        while j < lb
            let bj = b[j] * 1.0
            let old = out[i + j] * 1.0
            out[i + j] = old + ai2 * bj
            j += 1
    let norm = pg_normalize(out)
    let monic_lcm = pg_make_monic(norm)
    monic_lcm

// Returns 1 (true) if gcd(a,b) is a nonzero constant (degree 0), else 0.
fn pg_is_coprime(a, b) -> int
    let g = pg_gcd(a, b)
    let dg = pg_degree(g)
    if dg == 0
        return 1
    return 0

// Return the degree of gcd(a,b).
fn pg_gcd_degree(a, b) -> int
    let g = pg_gcd(a, b)
    let dg = pg_degree(g)
    dg
