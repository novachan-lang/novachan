// std/poly/bernstein.nova — Bernstein basis polynomials and Bezier curve evaluation.
// Bernstein basis: B_{i,n}(t) = C(n,i) * t^i * (1-t)^(n-i), t in [0,1].
// Control points are 1-D scalar values (floats) in ascending order.
// SELF-CONTAINED — imports NOTHING.
//
// PUBLIC API (prefix bern_):
//   bern_binom(n, k) -> int           binomial coefficient C(n,k)
//   bern_basis(n, i, t) -> float      B_{i,n}(t) = C(n,i)*t^i*(1-t)^(n-i)
//   bern_all_basis(n, t) -> list      all n+1 basis values [B_{0,n},..,B_{n,n}]
//   bern_bezier_point(ctrl, t) -> float   1-D Bezier value via de Casteljau
//   bern_de_casteljau(pts, t) -> float    alias for bern_bezier_point
//   bern_bezier_deriv(ctrl, t) -> float   derivative of 1-D Bezier at t
//   bern_to_power(ctrl) -> list       convert n+1 control pts to power-basis coeffs
//   bern_elevate(pts) -> list         degree elevation: n+1 pts -> n+2 pts

// bern_binom — binomial coefficient C(n,k) via multiplicative formula.
// C(n,k) = product_{j=0}^{k-1} (n-j)/(j+1).  Uses symmetry (min(k,n-k)).
fn bern_binom(n: int, k: int) -> int
    if k < 0
        return 0
    if k > n
        return 0
    let r = n - k
    let kk = k
    if r < kk
        kk = r
    let acc = 1
    for j in 0..kk
        acc *= (n - j)
        acc /= (j + 1)
    acc

// bern_basis — single Bernstein basis polynomial B_{i,n}(t).
// B_{i,n}(t) = C(n,i) * t^i * (1-t)^(n-i).
fn bern_basis(n: int, i: int, t: float) -> float
    if i < 0
        let z = 0.0
        return z
    if i > n
        let z = 0.0
        return z
    let c = bern_binom(n, i) * 1.0
    // compute t^i
    let tp = 1.0
    for j in 0..i
        tp *= t
    // compute (1-t)^(n-i)
    let omt = 1.0 - t
    let ni = n - i
    let omtp = 1.0
    for k in 0..ni
        omtp *= omt
    let result = c * tp * omtp
    result

// bern_all_basis — all n+1 Bernstein basis values at t; sum == 1 (partition of unity).
// Uses the recurrence B_{i,n}(t) = (1-t)*B_{i,n-1}(t) + t*B_{i-1,n-1}(t)
// via the de Boor–Bezier triangle for numerical stability.
fn bern_all_basis(n: int, t: float) -> list
    // Build via triangular recurrence starting from degree 0.
    let b = []
    let init = 1.0
    push(b, init)
    for d in 1..n + 1
        // degree-elevate b from degree d-1 to d in-place (right-to-left)
        let last = b[d - 1] * 1.0
        let newval = t * last
        push(b, newval)
        let ii = d - 1
        while ii >= 1
            let cur = b[ii] * 1.0
            let prev = b[ii - 1] * 1.0
            b[ii] = (1.0 - t) * cur + t * prev
            ii -= 1
        let b0 = b[0] * 1.0
        b[0] = (1.0 - t) * b0
    b

// bern_bezier_point — evaluate a 1-D Bezier curve at t via de Casteljau algorithm.
// ctrl: list of n+1 scalar control point values (floats).
// Returns the interpolated float value.
fn bern_bezier_point(ctrl: list, t: float) -> float
    let n = len(ctrl)
    if n == 0
        let z = 0.0
        return z
    if n == 1
        let v = ctrl[0] * 1.0
        return v
    // copy control points into a working list
    let work = []
    for i in 0..n
        let v = ctrl[i] * 1.0
        push(work, v)
    // de Casteljau: n-1 rounds of linear interpolation
    let r = n - 1
    while r >= 1
        for j in 0..r
            let a = work[j] * 1.0
            let b = work[j + 1] * 1.0
            work[j] = (1.0 - t) * a + t * b
        r -= 1
    let result = work[0] * 1.0
    result

// bern_de_casteljau — alias for bern_bezier_point.
fn bern_de_casteljau(pts: list, t: float) -> float
    bern_bezier_point(pts, t)

// bern_bezier_deriv — derivative of a 1-D Bezier curve at t.
// The derivative of a degree-n Bezier with control points P_i is a degree-(n-1)
// Bezier with control points Q_i = n*(P_{i+1} - P_i).
// Then evaluate that degree-(n-1) Bezier at t.
fn bern_bezier_deriv(ctrl: list, t: float) -> float
    let n = len(ctrl)
    if n <= 1
        let z = 0.0
        return z
    let deg = n - 1
    let dpts = []
    for i in 0..deg
        let a = ctrl[i] * 1.0
        let b = ctrl[i + 1] * 1.0
        let v = deg * 1.0 * (b - a)
        push(dpts, v)
    bern_bezier_point(dpts, t)

// bern_to_power — convert Bezier control points to standard power-basis coefficients.
// For n+1 control points P_0..P_n, the polynomial is:
//   p(t) = sum_{i=0}^{n} P_i * B_{i,n}(t)
// which expands to a degree-n polynomial in ascending order [c_0, c_1, ..., c_n].
// We compute coefficients via the formula:
//   c_j = sum_{i=0}^{j} (-1)^{j-i} C(n,j) C(j,i) P_i
fn bern_to_power(ctrl: list) -> list
    let n = len(ctrl)
    if n == 0
        let emp = []
        return emp
    let deg = n - 1
    let result = []
    for j in 0..n
        let cj = 0.0
        let cnj = bern_binom(deg, j) * 1.0
        for i in 0..j + 1
            let cji = bern_binom(j, i) * 1.0
            let pi = ctrl[i] * 1.0
            // sign = (-1)^(j-i)
            let sign = 1.0
            let parity = j - i
            // check if parity is odd
            let half = parity / 2
            if half * 2 != parity
                sign = 0.0 - 1.0
            cj += sign * cnj * cji * pi
        push(result, cj)
    result

// bern_elevate — degree elevation: convert n+1 control points to n+2 control points.
// The elevated control points Q_i = (i/(n+1))*P_{i-1} + (1 - i/(n+1))*P_i
// where P_{-1} = P_{n+1} = 0 by convention (out-of-range).
// The resulting Bezier represents the identical curve.
fn bern_elevate(pts: list) -> list
    let n = len(pts)
    if n == 0
        let emp = []
        return emp
    let deg = n - 1
    let newdeg = deg + 1
    let out = []
    for i in 0..newdeg + 1
        let alpha = i * 1.0 / (newdeg * 1.0)
        let q = 0.0
        if i > 0 and i <= deg
            let pm1 = pts[i - 1] * 1.0
            let pi = pts[i] * 1.0
            q = alpha * pm1 + (1.0 - alpha) * pi
        else
            if i == 0
                q = pts[0] * 1.0
            else
                // i == newdeg
                q = pts[deg] * 1.0
        push(out, q)
    out
