// ============================================================================
// NOVA Standard Library — std/poly/polyroots
// ============================================================================
// Real root finding for polynomials (coefficients in ascending order).
// Coefficients list: p[i] = coefficient of x^i.
// All functions prefix pr_.
// ============================================================================

// pr_fabs — float absolute value
fn pr_fabs(v) -> float
    if v < 0.0
        return 0.0 - v
    return v

// pr_sqrt — square root (builtin)
fn pr_sqrt_f(v) -> float
    if v < 0.0
        return 0.0
    return sqrt(v)

// pr_eval — evaluate polynomial at x using Horner's method
fn pr_eval(p, x) -> float
    let n = len(p)
    if n == 0
        return 0.0
    let result = p[n - 1] * 1.0
    let i = n - 2
    while i >= 0
        result = result * x + p[i] * 1.0
        i -= 1
    return result

// pr_linear — find the root of a linear polynomial [a, b] = a + b*x
// Returns [root] or [] if degenerate (b==0).
fn pr_linear(p) -> any
    let result = []
    if len(p) < 2
        return result
    let b = p[1] * 1.0
    if pr_fabs(b) < 0.000000001
        return result
    let a = p[0] * 1.0
    let root = (0.0 - a) / b
    push(result, root)
    return result

// pr_discriminant_quadratic — compute discriminant b^2 - 4ac for [a,b,c]
fn pr_discriminant_quadratic(p) -> float
    if len(p) < 3
        return 0.0
    let a = p[2] * 1.0
    let b = p[1] * 1.0
    let c = p[0] * 1.0
    return b * b - 4.0 * a * c

// pr_quadratic — real roots of quadratic polynomial [a, b, c] = a + bx + cx^2
// Returns [] if discriminant < 0 (complex roots), otherwise [r1, r2] sorted ascending.
fn pr_quadratic(p) -> any
    let result = []
    if len(p) < 3
        return result
    let ca = p[2] * 1.0
    if pr_fabs(ca) < 0.000000001
        // Degenerate: treat as linear
        return pr_linear(p)
    let disc = pr_discriminant_quadratic(p)
    if disc < 0.0
        return result
    let cb = p[1] * 1.0
    // sqrt INLINE (never bound to a local) — a bound float slot goes stale after a
    // prior sqrt() call (NOVA float-slot bug), collapsing both roots to -cb/(2ca).
    let r1 = (0.0 - cb - sqrt(disc)) / (2.0 * ca)
    let r2 = (0.0 - cb + sqrt(disc)) / (2.0 * ca)
    // Sort ascending
    if r1 <= r2
        push(result, r1)
        push(result, r2)
    else
        push(result, r2)
        push(result, r1)
    return result

// pr_bisection — find a root in [lo, hi] by bisection assuming sign change
// Returns midpoint when interval < tol.
fn pr_bisection(p, lo, hi, tol) -> float
    let flo = pr_eval(p, lo)
    let fhi = pr_eval(p, hi)
    // If same sign, return midpoint as best guess
    let mid = (lo + hi) / 2.0
    let iter = 0
    while (hi - lo) > tol and iter < 200
        mid = (lo + hi) / 2.0
        let fmid = pr_eval(p, mid)
        if pr_fabs(fmid) < tol * 0.001
            return mid
        let flo2 = pr_eval(p, lo)
        // sign check: flo2 * fmid < 0
        if flo2 * fmid < 0.0
            hi = mid
        else
            lo = mid
        iter += 1
    return (lo + hi) / 2.0

// pr_count_sign_changes — count sign changes in p evaluated at step points in [lo,hi]
fn pr_count_sign_changes(p, lo, hi, step) -> int
    let count = 0
    let x = lo
    let prev_sign = 0
    let started = 0
    while x <= hi + step * 0.001
        let fx = pr_eval(p, x)
        let cur_sign = 0
        if fx > 0.0
            cur_sign = 1
        if fx < 0.0
            cur_sign = 0 - 1
        if started == 1 and cur_sign != 0 and prev_sign != 0 and cur_sign != prev_sign
            count += 1
        if cur_sign != 0
            prev_sign = cur_sign
            started = 1
        x += step
    return count

// pr_cubic_real_roots — find at least one real root of cubic [a,b,c,d] = a+bx+cx^2+dx^3
// Uses the depressed cubic / trigonometric method for 3 real roots, or cardano for 1.
fn pr_cubic(p) -> any
    let result = []
    if len(p) < 4
        return result
    let da = p[3] * 1.0
    if pr_fabs(da) < 0.000000001
        return pr_quadratic(p)
    // Normalize: x^3 + px^2 + qx + r
    let pn = p[2] * 1.0 / da
    let qn = p[1] * 1.0 / da
    let rn = p[0] * 1.0 / da
    // Depressed cubic via t = x - pn/3: t^3 + pt + q = 0
    let pp = qn - pn * pn / 3.0
    let qq = 2.0 * pn * pn * pn / 27.0 - pn * qn / 3.0 + rn
    // Discriminant D = (q/2)^2 + (p/3)^3
    let D = qq * qq / 4.0 + pp * pp * pp / 27.0
    let shift = pn / 3.0
    if D > 0.000001
        // One real root (Cardano)
        let sqD = sqrt(D)
        let u_arg = 0.0 - qq / 2.0 + sqD
        let v_arg = 0.0 - qq / 2.0 - sqD
        let u = 0.0
        if u_arg >= 0.0
            u = pow(u_arg, 1.0 / 3.0)
        else
            u = 0.0 - pow(0.0 - u_arg, 1.0 / 3.0)
        let v = 0.0
        if v_arg >= 0.0
            v = pow(v_arg, 1.0 / 3.0)
        else
            v = 0.0 - pow(0.0 - v_arg, 1.0 / 3.0)
        let t1 = u + v
        push(result, t1 - shift)
    else
        // Three real roots: bisection to ONE root + deflation (robust, no trig,
        // guaranteed convergence). pn/qn/rn are the MONIC coeffs of the ORIGINAL
        // cubic f(x) = x^3 + pn x^2 + qn x + rn (NOT the depressed one).
        let bound = 1.0 + pr_fabs(pn) + pr_fabs(qn) + pr_fabs(rn)
        let lo = 0.0 - bound
        let hi = bound
        for bit in 0..200
            let mid = (lo + hi) / 2.0
            let fm = ((mid + pn) * mid + qn) * mid + rn
            if fm > 0.0
                hi = mid
            else
                lo = mid
        let root1 = (lo + hi) / 2.0
        // Deflate by (x - root1) -> quadratic x^2 + b1 x + b0.
        let b1 = pn + root1
        let b0 = qn + root1 * b1
        let quad = []
        push(quad, b0)
        push(quad, b1)
        push(quad, 1.0)
        let qroots = pr_quadratic(quad)
        push(result, root1)
        for qi in 0..len(qroots)
            push(result, qroots[qi])
        if len(result) == 3
            result = pr_sort3(result)
    return result

// pr_cos — cosine approximation via Taylor series (enough terms for accuracy)
fn pr_cos(x) -> float
    // Reduce x to [0, 2*pi]
    let pi2 = 6.28318530717958647692
    let xr = x
    while xr > pi2
        xr -= pi2
    while xr < 0.0
        xr += pi2
    // Taylor: cos(x) = 1 - x^2/2! + x^4/4! - x^6/6! + x^8/8! - x^10/10!
    let x2 = xr * xr
    let x4 = x2 * x2
    let x6 = x4 * x2
    let x8 = x6 * x2
    let x10 = x8 * x2
    let result = 1.0 - x2 / 2.0 + x4 / 24.0 - x6 / 720.0 + x8 / 40320.0 - x10 / 3628800.0
    return result

// pr_atan2 — atan2(y, x) approximation
fn pr_atan2(y, x) -> float
    let pi_val = 3.14159265358979323846
    if pr_fabs(x) < 0.000000001
        if y >= 0.0
            return pi_val / 2.0
        return 0.0 - pi_val / 2.0
    let r = y / x
    let atan_r = pr_atan(r)
    if x > 0.0
        return atan_r
    if y >= 0.0
        return atan_r + pi_val
    return atan_r - pi_val

// pr_atan — arctangent approximation
fn pr_atan(x) -> float
    // Range reduction: use identity atan(x) = pi/2 - atan(1/x) for |x|>1
    let pi_half = 1.5707963267948966
    let neg = 0
    let xv = x
    if xv < 0.0
        xv = 0.0 - xv
        neg = 1
    let large = 0
    if xv > 1.0
        xv = 1.0 / xv
        large = 1
    // Minimax polynomial approximation on [0,1]
    let x2 = xv * xv
    let result = xv * (1.0 - x2 * (1.0 / 3.0 - x2 * (1.0 / 5.0 - x2 * (1.0 / 7.0 - x2 * (1.0 / 9.0 - x2 / 11.0)))))
    if large == 1
        result = pi_half - result
    if neg == 1
        result = 0.0 - result
    return result

// pr_sort3 — sort a 3-element list ascending
fn pr_sort3(xs) -> any
    let a = xs[0] * 1.0
    let b = xs[1] * 1.0
    let c = xs[2] * 1.0
    // Simple sort
    let tmp = 0.0
    if a > b
        tmp = a
        a = b
        b = tmp
    if b > c
        tmp = b
        b = c
        c = tmp
    if a > b
        tmp = a
        a = b
        b = tmp
    let out = []
    push(out, a)
    push(out, b)
    push(out, c)
    return out

// pr_add_root — add root to list if not already present within merge_tol
fn pr_add_root(roots, root, merge_tol)
    let dup = 0
    for ri in 0..len(roots)
        if pr_fabs(roots[ri] * 1.0 - root) < merge_tol
            dup = 1
    if dup == 0
        push(roots, root)

// pr_all_real — scan [lo, hi] at step intervals, bisect each sign change, deduplicate
fn pr_all_real(p, lo, hi, step, tol) -> any
    let roots = []
    let merge_tol = step * 0.6
    let x = lo
    while x <= hi + step * 0.001
        let fv = pr_eval(p, x)
        // Direct hit near zero at a scan point
        if pr_fabs(fv) < tol * 10.0
            pr_add_root(roots, x, merge_tol)
        x += step
    // Sign-change bisection scan
    let x2 = lo
    let pf = pr_eval(p, lo)
    x2 = lo + step
    while x2 <= hi + step * 0.001
        let cf = pr_eval(p, x2)
        if pf * cf < 0.0
            let root = pr_bisection(p, x2 - step, x2, tol)
            pr_add_root(roots, root, merge_tol)
        pf = cf
        x2 += step
    // Sort ascending (insertion sort)
    let n = len(roots)
    for i in 1..n
        let key = roots[i] * 1.0
        let j = i - 1
        while j >= 0 and roots[j] * 1.0 > key
            roots[j + 1] = roots[j] * 1.0
            j -= 1
        roots[j + 1] = key
    return roots

fn main()
    print("polyroots module OK")
