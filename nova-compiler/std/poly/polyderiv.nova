// std/poly/polyderiv.nova — polynomial differentiation and integration.
// Polynomial representation: list of coefficients in ASCENDING order (coeffs[i] = coeff of x^i).
// E.g. [1,2,3] = 1 + 2x + 3x^2.  Derivative: [2,6].  Integral (c=0): [0,1,3].
// LEAF — imports nothing.
//
// FLOAT HAZARDS:
//   Bind every sub-expression to a named let.
//   Float abs: use (if v < 0.0 then 0.0 - v else v).

// Evaluate polynomial at x using Horner's method; internal helper.
fn pder_eval_horner(p, x) -> float
    let n = len(p)
    if n == 0
        let z = 0.0
        return z
    let result = p[n - 1] * 1.0
    let i = n - 2
    while i >= 0
        let ci = p[i] * 1.0
        result = result * x + ci
        i -= 1
    result

// Strip trailing zero coefficients; returns new normalized list.
fn pder_normalize(p) -> any
    let n = len(p)
    if n == 0
        let empty = []
        return empty
    let d = n - 1
    while d > 0
        let cv = p[d] * 1.0
        let acv = cv
        if acv < 0.0
            acv = 0.0 - acv
        if acv > 0.0000000001
            let out2 = []
            for i2 in 0..d + 1
                let v2 = p[i2] * 1.0
                push(out2, v2)
            return out2
        d -= 1
    // degree 0 or all zeros
    let v0 = p[0] * 1.0
    let vabs = v0
    if vabs < 0.0
        vabs = 0.0 - vabs
    if vabs > 0.0000000001
        let const_out = [v0]
        return const_out
    let empty3 = []
    empty3

// Formal first derivative: d/dx[c0 + c1*x + ... + cn*x^n] = c1 + 2*c2*x + ... + n*cn*x^(n-1).
// Derivative of a constant or empty polynomial is the zero polynomial [].
fn pder_derivative(p) -> any
    let n = len(p)
    if n <= 1
        let empty = []
        return empty
    let out = []
    for i in 1..n
        let ci = p[i] * 1.0
        let di = i * 1.0
        let v = ci * di
        push(out, v)
    // normalize trailing zeros
    let norm = pder_normalize(out)
    norm

// Compute the n-th derivative of polynomial p.
fn pder_nth_derivative(p, n) -> any
    let cur = p
    for k in 0..n
        cur = pder_derivative(cur)
    cur

// Indefinite integral with constant term c: integral(c0 + c1*x + ...) = c + c0*x + (c1/2)*x^2 + ...
// Returns float coefficients.
fn pder_integral(p, c) -> any
    let n = len(p)
    let out = []
    let cv = c * 1.0
    push(out, cv)
    for i in 0..n
        let ci = p[i] * 1.0
        let denom = (i + 1) * 1.0
        let v = ci / denom
        push(out, v)
    out

// Indefinite integral with constant term 0.
fn pder_antiderivative(p) -> any
    let z = 0.0
    let r = pder_integral(p, z)
    r

// Definite integral of p from a to b: returns float.
fn pder_definite_integral(p, a, b) -> float
    // antiderivative with c=0
    let anti = pder_antiderivative(p)
    let fb = pder_eval_horner(anti, b)
    let fa = pder_eval_horner(anti, a)
    let result = fb - fa
    result

// Returns 1 if p is a constant polynomial (degree 0 or empty), else 0.
fn pder_is_constant(p) -> int
    let n = len(p)
    if n == 0
        return 1
    if n == 1
        return 1
    // check if all coefficients beyond index 0 are zero
    for i in 1..n
        let ci = p[i] * 1.0
        let aci = ci
        if aci < 0.0
            aci = 0.0 - aci
        if aci > 0.0000000001
            return 0
    1

// Return the k-th coefficient of p (= p^(k)(0) / k!), i.e., the Taylor coefficient at 0.
// This is simply coeffs[k] if k < len(p), else 0.0.
fn pder_taylor_coeff(p, k) -> float
    let n = len(p)
    if k >= n
        let z = 0.0
        return z
    let v = p[k] * 1.0
    v
