// std/devtool/gitignore_star — "**" (globstar) .gitignore pattern handling.
//
// WHAT: implements the three documented "**" placements from the gitignore
// spec (git-scm.com/docs/gitignore):
//   "**/"  at the START — matches in all directories (zero or more).
//          "**/foo" matches "foo", "a/foo", "a/b/foo", ...
//   "/**"  at the END   — matches everything INSIDE (one or more segments).
//          "foo/**" matches "foo/a", "foo/a/b", ... but NOT "foo" itself.
//   "/**/" in the MIDDLE — matches zero or more whole directories.
//          "a/**/b" matches "a/b", "a/x/b", "a/x/y/b", ...
// A "**" only gets this special globstar meaning when it stands ALONE as a
// whole "/"-delimited segment; a segment like "a**b" is matched as an
// ordinary (if unusual) literal/glob segment by the single-segment matcher.
//
// This module owns its own single-segment "*"/"?" glob matcher (leaf
// module — no imports); "*" here never crosses a "/" since matching is
// always done per already-split segment.
//
// PREFIX: gis_
//
// Public API:
//   gis_has_doublestar(pattern)              -> int   1 if pattern contains "**"
//   gis_expand(pattern)                      -> list  pattern split on the "**" substring
//   gis_match(pattern, path)                 -> int   full "**"-aware match
//   gis_match_recursive(segments, path_segs) -> int   match "/"-split pattern
//                                                       segments (a segment
//                                                       exactly "**" is the
//                                                       globstar marker)
//                                                       against "/"-split
//                                                       path segments

// gis_has_doublestar(pattern) -> int
// 1 if pattern contains the literal substring "**".
fn gis_has_doublestar(pattern) -> int
    let n = len(pattern)
    let i = 0
    while i + 1 < n
        if slice(pattern, i, i + 1) == "*" and slice(pattern, i + 1, i + 2) == "*"
            return 1
        i = i + 1
    return 0

// gis_expand(pattern) -> list
// Splits pattern on the literal substring "**" into the list of pieces
// between (and around) each occurrence.
//   "a/**/b" -> ["a/", "/b"]
//   "**/foo" -> ["", "/foo"]
//   "plain"  -> ["plain"]        (no "**": single-element list)
fn gis_expand(pattern) -> list
    let out = []
    let n = len(pattern)
    let cur = ""
    let i = 0
    while i < n
        if i + 1 < n and slice(pattern, i, i + 1) == "*" and slice(pattern, i + 1, i + 2) == "*"
            push(out, cur)
            cur = ""
            i = i + 2
        else
            cur = cur + slice(pattern, i, i + 1)
            i = i + 1
    push(out, cur)
    return out

// _gis_split_slash(s) -> list
// Splits s on "/" into path segments (private helper; this module owns its
// own copy since it may not import other std modules).
fn _gis_split_slash(s) -> list
    let out = []
    let n = len(s)
    let cur = ""
    for i in 0..n
        let ch = slice(s, i, i + 1)
        if ch == "/"
            push(out, cur)
            cur = ""
        else
            cur = cur + ch
    push(out, cur)
    return out

// _gis_core(s, si, p, pi) -> int (1/0)
// Minimal recursive glob for one path segment: "*" matches any run of
// characters (including empty), "?" matches exactly one character.
fn _gis_core(s, si, p, pi) -> int
    let sn = len(s)
    let pn = len(p)
    if pi == pn and si == sn
        return 1
    if pi == pn
        return 0
    let pc = slice(p, pi, pi + 1)
    if pc == "*"
        let npi = pi + 1
        while npi < pn and slice(p, npi, npi + 1) == "*"
            npi = npi + 1
        if _gis_core(s, si, p, npi) == 1
            return 1
        if si < sn
            return _gis_core(s, si + 1, p, pi)
        return 0
    if si >= sn
        return 0
    if pc == "?"
        return _gis_core(s, si + 1, p, pi + 1)
    if pc == slice(s, si, si + 1)
        return _gis_core(s, si + 1, p, pi + 1)
    return 0

// _gis_match_idx(segs, si, path, pi) -> int (1/0)
// Index-based recursive matcher over pattern segments (segs, from index si)
// and path segments (path, from index pi). A segment exactly "**" is the
// globstar marker:
//   - if it is the LAST pattern segment (a trailing "/**"), it requires at
//     least one remaining path segment ("everything inside") and then
//     matches unconditionally (consumes all remaining segments).
//   - otherwise (a leading or middle "**"), it matches zero or more whole
//     path segments: try consuming 0, then 1, then 2, ... until the rest of
//     the pattern matches the rest of the path.
// Any other segment must glob-match exactly one path segment.
fn _gis_match_idx(segs, si, path, pi) -> int
    let sn = len(segs)
    let pn = len(path)
    if si == sn and pi == pn
        return 1
    if si == sn
        return 0
    let head = segs[si]
    if head == "**"
        let is_trailing = 0
        if si + 1 == sn
            is_trailing = 1
        if is_trailing == 1
            if pi >= pn
                return 0
            return 1
        if _gis_match_idx(segs, si + 1, path, pi) == 1
            return 1
        if pi < pn
            return _gis_match_idx(segs, si, path, pi + 1)
        return 0
    if pi >= pn
        return 0
    if _gis_core(path[pi], 0, head, 0) == 0
        return 0
    return _gis_match_idx(segs, si + 1, path, pi + 1)

// gis_match_recursive(segments, path_segs) -> int
// Public entry point over already-"/"-split segment lists — see
// _gis_match_idx for the matching algorithm. segments: pattern parts split
// on "/" ("**" is the globstar marker segment). path_segs: path parts split
// on "/".
fn gis_match_recursive(segments, path_segs) -> int
    return _gis_match_idx(segments, 0, path_segs, 0)

// gis_match(pattern, path) -> int
// Full "**"-aware match: strips a leading/trailing "/" from both pattern
// and path (so callers may pass either root-anchored or bare forms), splits
// both on "/", and delegates to gis_match_recursive.
fn gis_match(pattern, path) -> int
    let pat = pattern
    if len(pat) > 0 and slice(pat, 0, 1) == "/"
        pat = slice(pat, 1, len(pat))
    let pn = len(pat)
    if pn > 0 and slice(pat, pn - 1, pn) == "/"
        pat = slice(pat, 0, pn - 1)
    let pth = path
    if len(pth) > 0 and slice(pth, 0, 1) == "/"
        pth = slice(pth, 1, len(pth))
    let ln = len(pth)
    if ln > 0 and slice(pth, ln - 1, ln) == "/"
        pth = slice(pth, 0, ln - 1)
    let segments = _gis_split_slash(pat)
    let path_segs = _gis_split_slash(pth)
    return gis_match_recursive(segments, path_segs)
