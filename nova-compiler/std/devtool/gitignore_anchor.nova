// std/devtool/gitignore_anchor — anchored vs unanchored .gitignore pattern handling.
//
// WHAT: a gitignore pattern that contains a "/" (anywhere — leading, middle,
// or as the only separator) is ANCHORED: it is matched against the full
// relative path, segment by segment, from the location of the .gitignore
// file (we treat that as the repo root). A pattern with no "/" at all is
// UNANCHORED: it is matched against just the basename (final path
// component) and may therefore match at any depth.
//
// Simplification note: real git additionally treats a pattern whose ONLY
// "/" is a single trailing one (e.g. "build/") as unanchored (it is purely a
// directory marker). This module follows the simpler literal rule given by
// its spec — "anchored iff the pattern contains '/'" — so a lone trailing
// slash also counts as anchored here. Callers that need the fuller nuance
// can strip a trailing "/" (directory marker) before calling
// gia_is_anchored, or use std/devtool/gitignore_negate's gin_apply, which
// applies the directory-marker rule independently of anchoring.
//
// Glob matching within a single "/"-segment supports "*" (any run of chars,
// including empty — never crosses a "/" since matching is per-segment) and
// "?" (exactly one char). See std/devtool/gitignore_star for "**".
//
// PREFIX: gia_
//
// Public API:
//   gia_is_anchored(pattern)                -> int    1 if pattern contains "/"
//   gia_strip_leading_slash(pattern)        -> string  removes one leading "/"
//   gia_match_anchored(pattern, path)       -> int     full-path segment match
//   gia_match_unanchored(pattern, basename) -> int     single-segment match

// gia_is_anchored(pattern) -> int
fn gia_is_anchored(pattern) -> int
    let n = len(pattern)
    for i in 0..n
        if slice(pattern, i, i + 1) == "/"
            return 1
    return 0

// gia_strip_leading_slash(pattern) -> string
fn gia_strip_leading_slash(pattern) -> string
    if len(pattern) > 0 and slice(pattern, 0, 1) == "/"
        return slice(pattern, 1, len(pattern))
    return pattern

// _gia_strip_trailing_slash(s) -> string
fn _gia_strip_trailing_slash(s) -> string
    let n = len(s)
    if n > 0 and slice(s, n - 1, n) == "/"
        return slice(s, 0, n - 1)
    return s

// _gia_split_slash(s) -> list
// Splits s on "/" into path segments (private helper; this module owns its
// own copy since it may not import other std modules).
fn _gia_split_slash(s) -> list
    let out = []
    let n = len(s)
    let cur = ""
    for i in 0..n
        let ch = slice(s, i, i + 1)
        if ch == "/"
            push(out, cur)
            cur = ""
        else
            cur += ch
    push(out, cur)
    return out

// _gia_glob(s, si, p, pi) -> int (1/0)
// Minimal recursive glob for one path segment: "*" matches any run of
// characters (including empty), "?" matches exactly one character.
fn _gia_glob(s, si, p, pi) -> int
    let sn = len(s)
    let pn = len(p)
    if pi == pn and si == sn
        return 1
    if pi == pn
        return 0
    let pc = slice(p, pi, pi + 1)
    if pc == "*"
        let npi = pi + 1
        while npi < pn and slice(p, npi, npi + 1) == "*"
            npi += 1
        if _gia_glob(s, si, p, npi) == 1
            return 1
        if si < sn
            return _gia_glob(s, si + 1, p, pi)
        return 0
    if si >= sn
        return 0
    if pc == "?"
        return _gia_glob(s, si + 1, p, pi + 1)
    if pc == slice(s, si, si + 1)
        return _gia_glob(s, si + 1, p, pi + 1)
    return 0

// gia_match_anchored(pattern, path) -> int
// Matches an anchored pattern against a full relative path: both are split
// on "/" and must have the same number of segments, each matching via glob.
// A leading "/" and a trailing "/" (directory marker) are stripped from
// both sides before splitting, so callers may pass either root-anchored
// ("/foo/bar") or bare ("foo/bar") forms.
fn gia_match_anchored(pattern, path) -> int
    let pat = gia_strip_leading_slash(pattern)
    pat = _gia_strip_trailing_slash(pat)
    let pth = gia_strip_leading_slash(path)
    pth = _gia_strip_trailing_slash(pth)
    let pseg = _gia_split_slash(pat)
    let sseg = _gia_split_slash(pth)
    let n = len(pseg)
    if n != len(sseg)
        return 0
    for i in 0..n
        if _gia_glob(sseg[i], 0, pseg[i], 0) == 0
            return 0
    return 1

// gia_match_unanchored(pattern, basename) -> int
// Matches an unanchored (no "/") pattern against a single basename via
// glob. A trailing "/" (directory marker) on pattern is stripped first.
fn gia_match_unanchored(pattern, basename) -> int
    let pat = _gia_strip_trailing_slash(pattern)
    return _gia_glob(basename, 0, pat, 0)
