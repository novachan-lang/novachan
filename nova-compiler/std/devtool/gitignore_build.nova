// std/devtool/gitignore_build.nova — programmatic construction of .gitignore file content.
//
// WHAT: a small builder over a "patterns" list, where each element is already the literal
// text of ONE eventual line of the .gitignore file — a raw ignore pattern, a "!"-negated
// pattern, a "# comment", or a blank separator line. Building this way (instead of hand-
// concatenating strings) keeps section order explicit and lets callers compose from reusable
// pieces (see gitignore_common for ready-made per-ecosystem sections that plug straight into
// gib_add_section). Self-contained: imports nothing.
//
// PREFIX: gib_
//
// Public API:
//   gib_new()                                        -> list    empty pattern list
//   gib_add(patterns, pattern)                        -> list   appends one raw pattern line
//   gib_add_comment(patterns, text)                    -> list   appends "# text"
//   gib_add_blank(patterns)                            -> list   appends one blank separator line
//   gib_add_negate(patterns, pattern)                  -> list   appends "!pattern"
//   gib_add_section(patterns, name, section_patterns)  -> list   blank separator (if `patterns`
//                                                                  is non-empty) + "# name" +
//                                                                  every entry of section_patterns
//   gib_render(patterns)                               -> string newline-joined file content
//                                                                  (no forced trailing newline —
//                                                                  callers writing to disk via
//                                                                  write_file should add one if
//                                                                  their platform convention wants it)
//
// Every gib_add* function both mutates `patterns` in place (lists are reference values in
// NOVA) and returns it, so calls chain naturally:
//   let g = gib_add(gib_add(gib_new(), "*.log"), "*.tmp")
// or, more commonly, threaded through repeated reassignment:
//   let g = gib_new()
//   g = gib_add_section(g, "Python", ["__pycache__/", "*.pyc", ".venv/"])
//   g = gib_add_section(g, "Node", ["node_modules/", "*.log"])
//   let text = gib_render(g)

// gib_new() -> list : a fresh, empty pattern list.
fn gib_new() -> list
    return []

// gib_add(patterns, pattern) -> list : appends `pattern` unchanged.
fn gib_add(patterns: list, pattern: string) -> list
    push(patterns, pattern)
    return patterns

// gib_add_comment(patterns, text) -> list : appends "# " + text.
fn gib_add_comment(patterns: list, text: string) -> list
    push(patterns, "# " + text)
    return patterns

// gib_add_blank(patterns) -> list : appends one blank line (a section separator).
fn gib_add_blank(patterns: list) -> list
    push(patterns, "")
    return patterns

// gib_add_negate(patterns, pattern) -> list : appends "!" + pattern.
fn gib_add_negate(patterns: list, pattern: string) -> list
    push(patterns, "!" + pattern)
    return patterns

// gib_add_section(patterns, name, section_patterns) -> list
// Appends a labeled group: a blank separator line (only when `patterns` already has content,
// so the very first section in a file doesn't start with a stray blank line), then "# name",
// then every entry of `section_patterns` in order (each added via gib_add, so a caller that
// wants a negated or comment line inside a section can pre-format it — e.g. "!keep.log" —
// and pass it through as an ordinary string).
fn gib_add_section(patterns: list, name: string, section_patterns: list) -> list
    if len(patterns) > 0
        patterns = gib_add_blank(patterns)
    patterns = gib_add_comment(patterns, name)
    let i = 0
    let n = len(section_patterns)
    while i < n
        patterns = gib_add(patterns, section_patterns[i])
        i += 1
    return patterns

// gib_render(patterns) -> string : the newline-joined .gitignore file content.
fn gib_render(patterns: list) -> string
    return join(patterns, "\n")
