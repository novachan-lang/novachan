// std/compress/zip_read — ZIP archive record parser (RFC 1951 / PKWARE APPNOTE)
//
// Parses ZIP local file headers, central directory headers, and end-of-central-
// directory (EOCD) records from a byte buffer (list of ints 0..255).
// All ZIP integer fields are LITTLE-ENDIAN.
//
// Signatures:
//   Local file header:       0x04034b50  (bytes: 80,75,3,4)
//   Central directory entry: 0x02014b50  (bytes: 80,75,1,2)
//   End-of-central-directory:0x06054b50  (bytes: 80,75,5,6)
//
// Local header field offsets (from record start at pos):
//   sig(0,4) version_u16(4) flags_u16(6) method_u16(8) modtime_u16(10)
//   moddate_u16(12) crc32_u32(14) comp_size_u32(18) uncomp_size_u32(22)
//   name_len_u16(26) extra_len_u16(28)
//
// EOCD field offsets (from record start at pos):
//   sig(0,4) disk_u16(4) cd_disk_u16(6) disk_entries_u16(8)
//   total_entries_u16(10) cd_size_u32(12) cd_offset_u32(16) comment_len_u16(20)

// _zr_u16le: read a little-endian u16 from buf at byte position p.
fn _zr_u16le(buf: any, p: int) -> int
    return buf[p] + buf[p+1]*256

// _zr_u32le: read a little-endian u32 from buf at byte position p.
fn _zr_u32le(buf: any, p: int) -> int
    return buf[p] + buf[p+1]*256 + buf[p+2]*65536 + buf[p+3]*16777216

// _zr_ok: return 1 if buf has at least min_len bytes from position pos onward.
fn _zr_ok(buf: any, pos: int, min_len: int) -> int
    if len(buf) < pos + min_len
        return 0
    return 1

// zip_local_check: return true if buf at pos holds a valid local file header signature.
fn zip_local_check(buf: any, pos: int) -> bool
    if _zr_ok(buf, pos, 4) == 0
        return false
    if buf[pos] != 80
        return false
    if buf[pos+1] != 75
        return false
    if buf[pos+2] != 3
        return false
    if buf[pos+3] != 4
        return false
    return true

// zip_local_method: return the compression method field (u16 at pos+8); 0=stored 8=deflate.
fn zip_local_method(buf: any, pos: int) -> int
    if _zr_ok(buf, pos, 10) == 0
        return 0
    return _zr_u16le(buf, pos+8)

// zip_local_crc32: return the CRC-32 field (u32 at pos+14).
fn zip_local_crc32(buf: any, pos: int) -> int
    if _zr_ok(buf, pos, 18) == 0
        return 0
    return _zr_u32le(buf, pos+14)

// zip_local_comp_size: return compressed size (u32 at pos+18).
fn zip_local_comp_size(buf: any, pos: int) -> int
    if _zr_ok(buf, pos, 22) == 0
        return 0
    return _zr_u32le(buf, pos+18)

// zip_local_uncomp_size: return uncompressed size (u32 at pos+22).
fn zip_local_uncomp_size(buf: any, pos: int) -> int
    if _zr_ok(buf, pos, 26) == 0
        return 0
    return _zr_u32le(buf, pos+22)

// zip_local_name_len: return filename length (u16 at pos+26).
fn zip_local_name_len(buf: any, pos: int) -> int
    if _zr_ok(buf, pos, 28) == 0
        return 0
    return _zr_u16le(buf, pos+26)

// zip_local_method_name: return human-readable name of the compression method.
fn zip_local_method_name(buf: any, pos: int) -> string
    let m = zip_local_method(buf, pos)
    if m == 0
        return "stored"
    if m == 8
        return "deflate"
    return "other"

// zip_central_check: return true if buf at pos holds a valid central directory header signature.
fn zip_central_check(buf: any, pos: int) -> bool
    if _zr_ok(buf, pos, 4) == 0
        return false
    if buf[pos] != 80
        return false
    if buf[pos+1] != 75
        return false
    if buf[pos+2] != 1
        return false
    if buf[pos+3] != 2
        return false
    return true

// zip_eocd_check: return true if buf at pos holds a valid EOCD signature.
fn zip_eocd_check(buf: any, pos: int) -> bool
    if _zr_ok(buf, pos, 4) == 0
        return false
    if buf[pos] != 80
        return false
    if buf[pos+1] != 75
        return false
    if buf[pos+2] != 5
        return false
    if buf[pos+3] != 6
        return false
    return true

// zip_eocd_total_entries: return total number of entries (u16 at pos+10).
fn zip_eocd_total_entries(buf: any, pos: int) -> int
    if _zr_ok(buf, pos, 12) == 0
        return 0
    return _zr_u16le(buf, pos+10)

// zip_eocd_cd_offset: return offset of central directory start (u32 at pos+16).
fn zip_eocd_cd_offset(buf: any, pos: int) -> int
    if _zr_ok(buf, pos, 20) == 0
        return 0
    return _zr_u32le(buf, pos+16)

// zip_eocd_cd_size: return total size of central directory (u32 at pos+12).
fn zip_eocd_cd_size(buf: any, pos: int) -> int
    if _zr_ok(buf, pos, 16) == 0
        return 0
    return _zr_u32le(buf, pos+12)
