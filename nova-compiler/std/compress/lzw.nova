// ============================================================================
// NOVA Standard Library — std/compress/lzw
// ============================================================================
// LZW (Lempel-Ziv-Welch) compression on byte-lists.
//
// PUBLIC API:
//   lzw_compress(bytes: list) -> list
//       Compress a byte-list (ints 0..255) to a list of integer codes.
//       Initial dictionary: 256 single-byte entries (code b -> byte b).
//
//   lzw_decompress(codes: list) -> list
//       Decompress a list of LZW codes back to the original byte-list.
//       Handles the KwKwK edge case (code == next_code not yet in dict).
//
// ALGORITHM (classic LZW, Welch 1984):
//   COMPRESS:
//     Init dict: single byte b -> code b, for b in 0..255. next_code = 256.
//     Walk bytes: maintain current phrase W (as a dict key).
//     If W + [b] is in dict: extend W.
//     Else: emit code(W), add W+[b] with next_code++, reset W = [b].
//     After loop: emit code(W).
//
//   DECOMPRESS:
//     Init dict: code b -> [b] for b in 0..255. next_code = 256.
//     prev = decode first code and emit it.
//     For each subsequent code:
//       If code is in dict: entry = dict[code].
//       Else (KwKwK): entry = prev + [prev[0]].
//       Emit entry.
//       Add prev + [entry[0]] to dict with next_code++.
//       prev = entry.
//
// DICT KEY ENCODING:
//   The encoding dict maps phrase -> int code.
//   Phrases are byte-lists; we encode them as decimal-comma strings
//   (e.g. [65,66] -> "65,66") to avoid NUL-byte issues in NOVA dict keys.
//   The decode dict maps int code (as a string key) -> byte-list.
//
// EDGE CASE (KwKwK):
//   When the decompressor encounters a code that equals next_code (not yet
//   in the dict), the phrase is prev + [prev[0]]. This happens when the
//   compressor emits code(W) for a phrase W that is also the NEXT phrase
//   being added. Classic example: "ababab" -> codes for "a","b","ab","aba"
//   where the cScSc pattern triggers this case.
//
// COMPLEXITY: O(n) compress and decompress (hash dict lookups O(1) average).
//
// PRIVATE SYMBOLS: prefixed _lzw_ to avoid link collisions.
// LEAF — imports NOTHING.

// ── Private: encode a phrase (byte-list, first phrase_len bytes) as dict key ─

fn _lzw_phrase_key(phrase, phrase_len) -> string
    if phrase_len == 0
        return ""
    let k = str(phrase[0])
    for i in 1..phrase_len
        k = k + "," + str(phrase[i])
    k

// Extend an existing phrase key by one byte.
fn _lzw_key_extend(key, b) -> string
    if len(key) == 0
        return str(b)
    key + "," + str(b)

// ── lzw_compress ──────────────────────────────────────────────────────────────

fn lzw_compress(bytes) -> list
    let n    = len(bytes)
    let codes = []
    if n == 0
        return codes
    // Init encode dict: single-byte phrases.
    let enc = {}
    for b0 in 0..256
        let k = str(b0)
        enc[k] = b0
    let next_code = 256
    // Current phrase key and its code.
    let w_key  = str(bytes[0])
    let w_code = bytes[0]
    for i in 1..n
        let b     = bytes[i]
        let wc_key = _lzw_key_extend(w_key, b)
        if contains(enc, wc_key)
            // Extend the current phrase.
            w_key  = wc_key
            w_code = enc[wc_key]
        else
            // Emit code for current phrase.
            push(codes, w_code)
            // Add new phrase to dict.
            enc[wc_key] = next_code
            next_code = next_code + 1
            // Reset to single-byte phrase.
            w_key  = str(b)
            w_code = b
    // Emit the final phrase.
    push(codes, w_code)
    codes

// ── lzw_decompress ────────────────────────────────────────────────────────────

fn lzw_decompress(codes) -> list
    let nc  = len(codes)
    let out = []
    if nc == 0
        return out
    // Init decode dict: code b -> [b] for b in 0..255.
    // We store as dec[str(code)] = byte-list.
    let dec = {}
    for b0 in 0..256
        let phrase = []
        push(phrase, b0)
        dec[str(b0)] = phrase
    let next_code = 256
    // Process first code.
    let first    = codes[0]
    let prev     = dec[str(first)]
    // Emit first phrase.
    let fi = 0
    let prev_len = len(prev)
    while fi < prev_len
        push(out, prev[fi])
        fi = fi + 1
    for i in 1..nc
        let code  = codes[i]
        let entry = []
        let code_key = str(code)
        if contains(dec, code_key)
            // Normal case: code is already in dict.
            let src = dec[code_key]
            let si = 0
            let src_len = len(src)
            while si < src_len
                push(entry, src[si])
                si = si + 1
        else
            // KwKwK edge case: code == next_code (not in dict yet).
            // Entry = prev + [prev[0]].
            let plen = len(prev)
            let pi = 0
            while pi < plen
                push(entry, prev[pi])
                pi = pi + 1
            push(entry, prev[0])
        // Emit entry.
        let ei = 0
        let elen = len(entry)
        while ei < elen
            push(out, entry[ei])
            ei = ei + 1
        // Add prev + [entry[0]] to dict.
        let new_phrase = []
        let npi = 0
        let nplen = len(prev)
        while npi < nplen
            push(new_phrase, prev[npi])
            npi = npi + 1
        push(new_phrase, entry[0])
        dec[str(next_code)] = new_phrase
        next_code = next_code + 1
        prev = entry
    out
