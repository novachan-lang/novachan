// ============================================================================
// NOVA Standard Library — std/compress/code_unary
// ============================================================================
// Unary codes: the simplest possible self-delimiting integer codes.
//
// UNARY CODE (n >= 1):
//   Encode n as (n-1) one-bits followed by a single zero terminator.
//
//   Examples:
//     n=1  -> [0]              (1 bit)
//     n=2  -> [1, 0]           (2 bits)
//     n=3  -> [1, 1, 0]        (3 bits)
//     n=5  -> [1, 1, 1, 1, 0]  (5 bits)
//
//   Code length = n bits total.
//   Optimal for a geometric distribution with p = 0.5.
//   Used internally in Huffman coding, Rice/Golomb codes, and LZ encoders.
//
// UNARY0 CODE (n >= 0):
//   Encode n as n zero-bits followed by a single one terminator.
//   This is the "inverted" or "type-0" unary code convention.
//
//   Examples:
//     n=0  -> [1]              (1 bit)
//     n=1  -> [0, 1]           (2 bits)
//     n=2  -> [0, 0, 1]        (3 bits)
//     n=3  -> [0, 0, 0, 1]     (4 bits)
//
//   Code length = n+1 bits total.
//
// BIT REPRESENTATION:
//   Bitstream is a LIST of ints, each 0 or 1, MSB-first in the order written.
//   encode(n)       -> bit-list
//   decode(bits, pos) -> [value, next_pos]
//   pos is the index into bits to start reading; next_pos is just past the
//   last consumed bit — suitable for sequential multi-value decoding.
//
// PUBLIC API:
//   unary_encode(n)           -> list  (n >= 1)
//     Returns bit-list: (n-1) ones then a zero.
//
//   unary_decode(bits, pos)   -> list  [value, next_pos]
//     Decode one unary value starting at bits[pos].
//     Reads one-bits until a zero terminator is found.
//     Returns [n, next_pos]. If bits ends before terminator: [-1, len(bits)].
//
//   unary_encode0(n)          -> list  (n >= 0)
//     Returns bit-list: n zeros then a one.
//
//   unary_decode0(bits, pos)  -> list  [value, next_pos]
//     Decode one unary0 value starting at bits[pos].
//     Reads zero-bits until a one terminator is found.
//     Returns [n, next_pos]. If bits ends before terminator: [-1, len(bits)].
//
// SYMBOL COLLISION GUARD:
//   Private helpers use prefix _un_ to avoid link collisions.
//
// LEAF — imports NOTHING.

// ── Public API ────────────────────────────────────────────────────────────────

// unary_encode: encode n (>= 1) using unary code.
//
// Emits (n-1) one-bits then one zero-bit terminator.
// Total bits = n.
//
// Examples:
//   unary_encode(1) -> [0]
//   unary_encode(3) -> [1, 1, 0]
//   unary_encode(5) -> [1, 1, 1, 1, 0]
fn unary_encode(n) -> list
    let bits = []
    for i in 0..(n - 1)
        push(bits, 1)
    push(bits, 0)
    bits

// unary_decode: decode one unary value from bits starting at position pos.
//
// Reads 1-bits until a 0 terminator is found.
// Returns [value, next_pos] where value is the decoded n (>= 1).
// If the bitstream ends before a zero terminator: returns [-1, len(bits)].
//
// Examples:
//   unary_decode([0], 0)              -> [1, 1]
//   unary_decode([1, 1, 0], 0)        -> [3, 3]
//   unary_decode([1, 1, 1, 1, 0], 0)  -> [5, 5]
fn unary_decode(bits, pos) -> list
    let blen = len(bits)
    let cur = pos
    let count = 0
    let found = 0
    while cur < blen and found == 0
        if bits[cur] == 0
            found = 1
        else
            count = count + 1
            cur = cur + 1
    let result = []
    if found == 0
        push(result, -1)
        push(result, blen)
    else
        push(result, count + 1)
        push(result, cur + 1)
    result

// unary_encode0: encode n (>= 0) using unary0 code.
//
// Emits n zero-bits then one one-bit terminator.
// Total bits = n+1.
//
// Examples:
//   unary_encode0(0) -> [1]
//   unary_encode0(1) -> [0, 1]
//   unary_encode0(3) -> [0, 0, 0, 1]
fn unary_encode0(n) -> list
    let bits = []
    for i in 0..n
        push(bits, 0)
    push(bits, 1)
    bits

// unary_decode0: decode one unary0 value from bits starting at position pos.
//
// Reads 0-bits until a 1 terminator is found.
// Returns [value, next_pos] where value is the decoded n (>= 0).
// If the bitstream ends before a one terminator: returns [-1, len(bits)].
//
// Examples:
//   unary_decode0([1], 0)           -> [0, 1]
//   unary_decode0([0, 1], 0)        -> [1, 2]
//   unary_decode0([0, 0, 0, 1], 0)  -> [3, 4]
fn unary_decode0(bits, pos) -> list
    let blen = len(bits)
    let cur = pos
    let count = 0
    let found = 0
    while cur < blen and found == 0
        if bits[cur] == 1
            found = 1
        else
            count = count + 1
            cur = cur + 1
    let result = []
    if found == 0
        push(result, -1)
        push(result, blen)
    else
        push(result, count)
        push(result, cur + 1)
    result
