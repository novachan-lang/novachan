// ============================================================================
// NOVA Standard Library — std/compress/rle
// ============================================================================
// Run-Length Encoding (RLE) — lossless compression for strings with repeated
// characters (e.g. "aaabbc" -> runs [["a",3],["b",2],["c",1]]).
//
// RLE is one of the simplest and oldest compression algorithms. It achieves
// compression whenever the input has long runs of repeated characters. It
// expands for inputs with no repetition (each char becomes "1x"). The ratio
// function lets callers decide whether compression is worth applying.
//
// PUBLIC API:
//   rlc_compress(s) -> list
//     Returns a list of [char, count] pairs (each element is a 2-list).
//     Empty string -> empty list. Each run is [ch, n] where ch is a
//     one-character string and n is a positive integer.
//
//   rlc_decompress(runs) -> string
//     Reconstructs the original string from a list of [char, count] pairs.
//     Inverse of rlc_compress. rlc_decompress(rlc_compress(s)) == s.
//
//   rlc_compress_str(s) -> string
//     Compact string encoding: counts followed immediately by characters.
//     "aaabbc" -> "3a2b1c". Counts are in decimal. Single-char runs still
//     include the count ("a" -> "1a") for unambiguous parsing.
//
//   rlc_decompress_str(encoded) -> string
//     Inverse of rlc_compress_str. Parses "3a2b1c" back to "aaabbc".
//     Each token is: one-or-more decimal digits followed by exactly one
//     character. Stops at end of string. Malformed input (digit with no
//     following char, non-digit start) yields "" for the malformed part.
//
//   rlc_ratio(s) -> float
//     Returns compressed_len / original_len as a float (lower = better).
//     For the empty string returns 1.0 (no information to compress).
//     compressed_len here is the byte-length of rlc_compress_str(s).
//     A ratio < 1.0 means compression reduced size.
//
// ALGORITHM:
//   Single linear scan: track current character and its run count. When the
//   character changes (or input ends) emit a run. O(n) time, O(k) extra space
//   where k is the number of distinct runs (at most n runs, at most n/2 when
//   no char repeats).
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _rlc_ to avoid link collisions when other
//   std modules are compiled into the same binary.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Repeat a single character c exactly n times, returning the resulting string.
// Used by rlc_decompress to reconstruct each run.
fn _rlc_repeat(c, n) -> string
    let out = ""
    for i in 0..n
        let dummy = 0
        out = out + c
    out

// Parse a decimal integer starting at position pos in string s.
// Returns the integer value. pos is updated by the caller by knowing
// how many characters were consumed — we return [value, new_pos] as a
// two-element list: index 0 = parsed int, index 1 = new position.
// If s[pos] is not a digit, returns [0, pos] (zero consumed).
fn _rlc_parse_int(s, pos) -> list
    let slen = len(s)
    let val = 0
    let cur = pos
    let has_digit = 0
    while cur < slen and ord(s[cur]) >= 48 and ord(s[cur]) <= 57
        let dummy = 0
        val = val * 10 + (ord(s[cur]) - 48)
        cur = cur + 1
        has_digit = 1
    let result = []
    result.push(val)
    result.push(cur)
    result.push(has_digit)
    result

// ── Public API ────────────────────────────────────────────────────────────────

// rlc_compress: encode a string as a list of [char, count] run pairs.
//
// Each element of the returned list is itself a 2-element list [ch, n]:
//   ch — a one-character string (the repeated character)
//   n  — a positive integer (how many times ch appears consecutively)
//
// The list is in input order (left to right). Empty input -> empty list.
//
// Examples:
//   rlc_compress("")        -> []
//   rlc_compress("a")       -> [["a", 1]]
//   rlc_compress("aaabbc")  -> [["a", 3], ["b", 2], ["c", 1]]
//   rlc_compress("abcdef")  -> [["a",1],["b",1],["c",1],["d",1],["e",1],["f",1]]
fn rlc_compress(s) -> list
    let n = len(s)
    let runs = []
    if n == 0
        return runs
    let cur_ch = s[0]
    let cur_cnt = 1
    for i in 1..n
        let ch = s[i]
        if ch == cur_ch
            cur_cnt = cur_cnt + 1
        else
            let run = []
            run.push(cur_ch)
            run.push(cur_cnt)
            runs.push(run)
            cur_ch = ch
            cur_cnt = 1
    let last_run = []
    last_run.push(cur_ch)
    last_run.push(cur_cnt)
    runs.push(last_run)
    runs

// rlc_decompress: reconstruct original string from a list of [char, count] pairs.
//
// Inverse of rlc_compress. Each element must be a 2-list [ch, n] where
// ch is a one-character string and n is a positive integer.
//
// rlc_decompress(rlc_compress(s)) == s  for all strings s.
//
// Examples:
//   rlc_decompress([])                            -> ""
//   rlc_decompress([["a", 3], ["b", 2], ["c",1]]) -> "aaabbc"
fn rlc_decompress(runs) -> string
    let out = ""
    let nr = len(runs)
    for i in 0..nr
        let run = runs[i]
        let ch = run[0]
        let cnt = run[1]
        out = out + _rlc_repeat(ch, cnt)
    out

// rlc_compress_str: encode a string in the compact "NcNc..." form.
//
// Each run is represented as: decimal count immediately followed by character.
// Single-character runs include the "1" prefix so the format is always
// unambiguous (every token starts with a digit).
//
// Examples:
//   rlc_compress_str("")       -> ""
//   rlc_compress_str("a")      -> "1a"
//   rlc_compress_str("aaabbc") -> "3a2b1c"
//   rlc_compress_str("abcdef") -> "1a1b1c1d1e1f"
fn rlc_compress_str(s) -> string
    let runs = rlc_compress(s)
    let nr = len(runs)
    let out = ""
    for i in 0..nr
        let run = runs[i]
        let ch = run[0]
        let cnt = run[1]
        out = out + str(cnt) + ch
    out

// rlc_decompress_str: reconstruct original string from the compact "NcNc..." form.
//
// Parses: (decimal-digits)(one-character)* repeated until end of string.
// Malformed input (missing count, missing character after digits) terminates
// parsing early — the already-processed portion is returned.
//
// Examples:
//   rlc_decompress_str("")       -> ""
//   rlc_decompress_str("1a")     -> "a"
//   rlc_decompress_str("3a2b1c") -> "aaabbc"
fn rlc_decompress_str(encoded) -> string
    let slen = len(encoded)
    let out_parts = []
    let pos = 0
    while pos < slen
        let parsed = _rlc_parse_int(encoded, pos)
        let cnt = parsed[0]
        let new_pos = parsed[1]
        let has_digit = parsed[2]
        // If no digit was found at this position, stop parsing (malformed).
        if has_digit == 0
            pos = slen
        else
            // After the digits we need exactly one character.
            if new_pos >= slen
                pos = slen
            else
                let ch = encoded[new_pos]
                push(out_parts, _rlc_repeat(ch, cnt))
                pos = new_pos + 1
    let out = join(out_parts, "")
    out

// rlc_ratio: measure the compression ratio (compressed / original length).
//
// Uses the rlc_compress_str representation length as the "compressed" size,
// since that is the actual byte footprint of the encoded string.
//
// Returns a float in (0.0, +inf):
//   ratio < 1.0  -> compression reduced size (good)
//   ratio == 1.0 -> neutral (or empty input)
//   ratio > 1.0  -> compression expanded size (bad for this input)
//
// For the empty string, returns 1.0 (by convention — no information to compare).
//
// Example:
//   rlc_ratio("aaabbc")  -> 6.0/6  = 1.0  ("3a2b1c" is same length)
//   rlc_ratio("aaaaaaa") -> 2.0/7  ~ 0.286 (huge gain)
//   rlc_ratio("abcdef")  -> 12.0/6 = 2.0  (expansion — no repetition)
fn rlc_ratio(s) -> float
    let orig = len(s)
    if orig == 0
        return 1.0
    let compressed = len(rlc_compress_str(s))
    compressed * 1.0 / (orig * 1.0)
