// ============================================================================
// NOVA Standard Library — std/compress/context_mix2
// ============================================================================
// Order-1 context-model compressor with residual coding.
//
// ALGORITHM:
//   The compressor maintains an order-1 model: for each possible "context"
//   byte c (0..255), it tracks the most-frequent byte that follows c so far.
//   To compress byte b when the previous byte was ctx:
//     - Look up the predicted byte for context ctx.
//     - Emit a 1-byte "tag":
//         0   if b == predicted (hit — match)
//         1   if b != predicted but b is 0 (so residual needs escaping)
//         2+  otherwise (residual = b itself, but we emit b+2? No —
//             to stay simple: emit b XOR predicted, shifted to avoid 0)
//       Actually we use a simpler scheme: emit [tag, byte?]
//         tag == 0:     prediction hit, no extra byte
//         tag == 1:     miss, next byte is the actual byte b
//   - Update the model: increment count of b in context ctx.
//
// MODEL SYNC GUARANTEE:
//   Both encoder and decoder apply the SAME model update after each byte
//   (update AFTER processing, using the same order). Because they process
//   bytes in the same order with the same context history, they stay
//   byte-perfect in sync with no model data in the stream.
//
// OUTPUT FORMAT (cm_compress → list of ints):
//   [total_bytes, tag0, (b0?), tag1, (b1?), ...]
//   - First element: the original byte count (needed for decompression to
//     know when to stop, since tag=0 emits no extra byte).
//   - tag == 0:  prediction correct, no following byte.
//   - tag == 1:  prediction wrong, next element is the actual byte.
//
// PUBLIC API:
//   cm_compress(bytes) -> list
//     Compress a byte-list (list of ints 0..255).
//     Returns an encoded list. First element is original length.
//
//   cm_decompress(encoded) -> list
//     Decompress back to byte-list.
//     cm_decompress(cm_compress(bytes)) == bytes for all byte-lists.
//
// CORRECTNESS vs RATIO:
//   This implementation favours correctness and simplicity. On repetitive
//   input the prediction hit rate is high (many tag=0 entries). On random
//   input it falls back to tag=1 + literal (slight expansion from length
//   prefix). Round-trip is always exact.
//
// SYMBOL COLLISION GUARD:
//   All private helpers use _cm2_ prefix.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// _cm2_make_model: create a fresh order-1 model.
// Returns a list of 256 elements, each being [predicted_byte, count].
// predicted_byte starts at 0; count starts at 0.
// We represent the model as a flat list of 512 ints:
//   slot 2*c     = predicted byte for context c
//   slot 2*c + 1 = count of how many times that byte was seen
// Additionally we need per-context frequency tables to pick the BEST
// prediction, but full 256x256 tables would be 65536 entries — fine here.
// We use a simpler approach: a flat 512-entry list for (pred, count) pairs,
// updated via a count-of-counts strategy:
//   When byte b follows context c:
//     if b == model[2*c] (current best): model[2*c+1]++
//     else if count of b > model[2*c+1]: update model[2*c]=b, model[2*c+1]=1
//     else: do nothing (current best stays)
// This is a lightweight "majority vote" approximation — it correctly tracks
// the running most-frequent follower for each context.

fn _cm2_make_model() -> list
    let m = []
    for i in 0..256
        push(m, 0)    // predicted byte
        push(m, 0)    // count
    m

// _cm2_predict: return predicted byte for context ctx.
fn _cm2_predict(model, ctx) -> int
    model[ctx * 2]

// _cm2_update: update model after seeing byte b in context ctx.
// Uses majority-vote: if b matches current prediction, increment count.
// If b != prediction but beats it, replace.
fn _cm2_update(model, ctx, b)
    let slot = ctx * 2
    let pred = model[slot]
    let cnt  = model[slot + 1]
    if b == pred
        model[slot + 1] = cnt + 1
    else
        // b is different from current prediction.
        // We use a simple heuristic: new byte always replaces if count <= 1,
        // otherwise it takes 2 consecutive misses to displace.
        // For simplicity and sync-safety: replace when count == 0.
        if cnt == 0
            model[slot] = b
            model[slot + 1] = 1
        // else current prediction stays (it won at least once).

// ── Public API ────────────────────────────────────────────────────────────────

// cm_compress: order-1 context-model compress a byte-list.
//
// Returns a list: [original_length, tag0, (byte0?), tag1, (byte1?), ...]
//   tag == 0: prediction correct
//   tag == 1: prediction wrong; next element is the actual byte
//
// Both encoder and decoder apply identical model updates in the same order,
// so the model is always in sync without any embedded model data.
fn cm_compress(bytes) -> list
    let n = len(bytes)
    let out = []
    push(out, n)       // header: original byte count
    if n == 0
        return out
    let model = _cm2_make_model()
    let ctx = 0        // initial context: byte 0 (a neutral start)
    for i in 0..n
        let b = bytes[i]
        let pred = _cm2_predict(model, ctx)
        if b == pred
            push(out, 0)   // tag: hit
        else
            push(out, 1)   // tag: miss
            push(out, b)   // actual byte
        // Update model and advance context.
        _cm2_update(model, ctx, b)
        ctx = b
    out

// cm_decompress: decode the output of cm_compress back to a byte-list.
//
// Reads the header (original length), then processes tag/byte pairs,
// rebuilding the model identically to the encoder.
fn cm_decompress(encoded) -> list
    let en = len(encoded)
    let out = []
    if en == 0
        return out
    let orig_n = encoded[0]
    if orig_n == 0
        return out
    let model = _cm2_make_model()
    let ctx = 0
    let pos = 1
    for count in 0..orig_n
        let tag = encoded[pos]
        pos += 1
        let b = 0
        if tag == 0
            // Prediction hit — recover the byte from the model.
            b = _cm2_predict(model, ctx)
        else
            // Prediction miss — next element is the actual byte.
            b = encoded[pos]
            pos += 1
        push(out, b)
        _cm2_update(model, ctx, b)
        ctx = b
    out
