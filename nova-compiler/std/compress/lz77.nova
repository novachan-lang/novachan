// ============================================================================
// NOVA Standard Library — std/compress/lz77
// ============================================================================
// LZ77 sliding-window compression (Ziv & Lempel 1977).
//
// TOKEN FORMAT:
//   Every token is a 3-element list [offset, length, nextChar].
//
//   offset == 0 AND length == 0:
//       LITERAL token — emit chr(nextChar) verbatim.
//
//   offset > 0 (length >= 1):
//       BACK-REFERENCE — copy `length` bytes from position
//       (current_pos - offset) in the already-decoded output,
//       then emit chr(nextChar) if nextChar > 0, else nothing.
//       nextChar == 0 means no trailing literal (used only when
//       a back-reference ends exactly at the end of input).
//
// PUBLIC API:
//   lz7_compress(s, window) -> list of tokens
//       Compresses string s using a sliding window of `window` bytes.
//       window must be >= 1 (recommended: 255 or 4095).
//
//   lz7_decompress(tokens) -> string
//       Reconstructs the original string from a token list.
//
//   lz7_compress_default(s) -> list of tokens
//       Shorthand for lz7_compress(s, 255).
//
// ROUND-TRIP GUARANTEE:
//   lz7_decompress(lz7_compress(s, w)) == s for any string s and window w >= 1.
//
// ALGORITHM NOTES:
//   Greedy match search: for each position scan the window backwards,
//   prefer the longest match. O(n * w) time — fine for practical window
//   sizes (255-4095). Production implementations would use a hash chain
//   or suffix array, but this is the reference/portable version.
//
//   Back-references can span the original match length (overlapping copy
//   is legal — e.g., "aaa" at offset 1, length 3 is valid LZ77).
//
// PRIVATE SYMBOL GUARD:
//   All internal helpers use _lz7_ prefix.

// ── Private helpers ───────────────────────────────────────────────────────────

// Find the longest match for the look-ahead starting at position `pos`
// in string `s` within the last `window` characters.
// Returns [best_offset, best_length].
// offset is the distance back from pos (>= 1); length is the match length.
// Returns [0, 0] if no match found.
fn _lz7_find_match(s, pos, slen, window) -> list
    let best_off = 0
    let best_len = 0
    // Maximum look-ahead we can match (leave at least 1 char for the literal,
    // unless we're handling the final stretch).
    let max_la = slen - pos
    // Search start: furthest back we'll look (clamp to start of string).
    let search_start = pos - window
    if search_start < 0
        search_start = 0
    // Scan candidate start positions from the earliest to most recent.
    // Most-recent wins on equal length (smaller offset = less ambiguity).
    let cand = search_start
    while cand < pos
        // How long does the match run from `cand`?
        let mlen = 0
        let running = 1
        while running == 1 and mlen < max_la
            let si = cand + mlen
            let pi = pos + mlen
            if s[si] != s[pi]
                running = 0
            else
                mlen = mlen + 1
        // Keep longest; tie-break favours most recent (smaller offset).
        if mlen > best_len
            best_len = mlen
            best_off = pos - cand
        cand = cand + 1
    [best_off, best_len]

// ── Public API ────────────────────────────────────────────────────────────────

// lz7_compress: compress string s with given sliding window size.
// Returns a list of tokens; each token is [offset, length, nextChar].
fn lz7_compress(s, window) -> list
    let tokens = []
    let slen = len(s)
    if slen == 0
        return tokens
    let pos = 0
    while pos < slen
        // Find best match in the window.
        let mr = _lz7_find_match(s, pos, slen, window)
        let moff = mr[0]
        let mlen = mr[1]
        // We need at least length 1 match AND there must be a char after it
        // (or we're exactly at end). Minimum useful match is length >= 1 to
        // beat a literal, but we need a literal char after unless at end.
        // Require mlen >= 2 when we need a trailing literal; mlen >= 1 at end.
        let use_ref = 0
        if moff > 0 and mlen >= 2
            use_ref = 1
        if use_ref == 0
            // Check: is mlen == slen - pos (match fills remaining)?
            if moff > 0 and mlen >= 1 and mlen == slen - pos
                use_ref = 1
        if use_ref == 1
            // Back-reference token.
            let after_match = pos + mlen
            let nc = 0
            if after_match < slen
                // Consume one literal after the match.
                nc = ord(s[after_match])
                pos = after_match + 1
            else
                // Match ends exactly at end of string; no literal.
                nc = 0
                pos = after_match
            let tok = [moff, mlen, nc]
            push(tokens, tok)
        else
            // Literal token.
            let tok2 = [0, 0, ord(s[pos])]
            push(tokens, tok2)
            pos = pos + 1
    tokens

// lz7_decompress: reconstruct original string from token list.
fn lz7_decompress(tokens) -> string
    let out = ""
    let ti = 0
    let tlen = len(tokens)
    while ti < tlen
        let tok = tokens[ti]
        let toff = tok[0]
        let tmlen = tok[1]
        let tnc = tok[2]
        if toff == 0 and tmlen == 0
            // Literal token.
            out = out + chr(tnc)
        else
            // Back-reference: copy tmlen chars starting from (out_pos - toff).
            let outlen = len(out)
            let cp_start = outlen - toff
            let ci = 0
            while ci < tmlen
                out = out + out[cp_start + ci]
                ci = ci + 1
            // Trailing literal (nc > 0 means there is one).
            if tnc > 0
                out = out + chr(tnc)
        ti = ti + 1
    out

// lz7_compress_default: compress with default window size of 255.
fn lz7_compress_default(s) -> list
    lz7_compress(s, 255)
