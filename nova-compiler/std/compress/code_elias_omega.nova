// ============================================================================
// NOVA Standard Library — std/compress/code_elias_omega
// ============================================================================
// Elias omega code for positive integers (n >= 1).
//
// Elias omega is a "recursive" universal code that achieves
//   code_length(n) = floor(log2(n)) + floor(log2(floor(log2(n))+1)) + ... + 1
// which grows far more slowly than gamma or delta for very large n.
//
// ENCODING ALGORITHM (n >= 1):
//   1.  Start with a terminator group [0] at the tail.
//   2.  Set k = n.
//   3.  While k > 1:
//         a.  Prepend binary(k) (MSB-first bit list) to the current list.
//         b.  Set k = floor(log2(k)).
//   4.  The resulting list is the codeword (MSB of last prepended group first).
//
//   Worked examples:
//     n=1: k=1, loop never runs    -> [0]
//     n=2: k=2, binary(2)=[1,0]   -> prepend -> [1,0,0],   k=1 -> done
//     n=3: k=3, binary(3)=[1,1]   -> prepend -> [1,1,0],   k=1 -> done
//     n=4: k=4, binary(4)=[1,0,0] -> prepend -> [1,0,0,0], k=2
//          k=2, binary(2)=[1,0]   -> prepend -> [1,0,1,0,0,0], k=1 -> done
//     n=7: k=7, binary(7)=[1,1,1] -> prepend -> [1,1,1,0], k=1 -> done
//     n=8: k=8, binary(8)=[1,0,0,0]-> prepend->[1,0,0,0,0],k=3
//          k=3, binary(3)=[1,1]   -> prepend->[1,1,1,0,0,0,0],k=1 -> done
//
// DECODING ALGORITHM (from bit position pos):
//   1.  Set n = 1.
//   2.  Read next bit.  If it is 0: done, return [n, pos+1].
//   3.  Otherwise (bit is 1): this bit is the MSB of an (n+1)-bit group.
//         Read the remaining n bits.
//         The group's integer value becomes the new n.
//         Go to step 2.
//
// The decoder reads groups of INCREASING bit-width, guided by the current n.
//
// PUBLIC API:
//   omega_encode(n)           -> list of 0/1 ints (MSB-first, self-delimiting)
//   omega_decode(bits, pos)   -> [value, next_pos]
//
//   pack_bits(bit_list)       -> list of bytes (ints 0..255), 8 bits/byte,
//                                MSB-first, last byte zero-padded if needed.
//   omega_bit_length(n)       -> int (number of bits in the code for n)
//
// BIT REPRESENTATION:
//   A bitstream is a list of ints, each 0 or 1, MSB-first in the order
//   written.  This is shared with every other std/compress/code_* module.
//
// SYMBOL COLLISION GUARD:
//   All private helpers use prefix _omg_ to avoid link collisions.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// _omg_floor_log2: floor(log2(n)) for n >= 1.
//   n=1 -> 0, n=2 -> 1, n=3 -> 1, n=4 -> 2, n=7 -> 2, n=8 -> 3, ...
fn _omg_floor_log2(n) -> int
    let k = 0
    let v = n
    while v > 1
        let dummy = 0
        v = v / 2
        k = k + 1
    k

// _omg_bit_width: number of bits needed to represent integer v in binary.
//   Equals floor(log2(v)) + 1 for v >= 1.  Returns 1 for v=0 (edge case).
fn _omg_bit_width(v) -> int
    if v <= 0
        return 1
    _omg_floor_log2(v) + 1

// _omg_prepend_binary: prepend the MSB-first binary representation of v
//   (using exactly nbits bits) at the front of list lst.
//   Returns the new list (lst is consumed; caller must use the return value).
//   This builds [msb, ..., lsb] ++ old_lst.
fn _omg_prepend_binary(v, nbits, lst) -> list
    let out = []
    let i = nbits - 1
    while i >= 0
        let bit = (v >> i) & 1
        push(out, bit)
        i = i - 1
    let j = 0
    let olen = len(lst)
    while j < olen
        let dummy = 0
        push(out, lst[j])
        j = j + 1
    out

// ── Public API ────────────────────────────────────────────────────────────────

// omega_encode: encode positive integer n using Elias omega coding.
//
// Returns a list of 0/1 ints (MSB-first, self-delimiting).
// n must be >= 1.  Returns [0] for n=1.
//
// Algorithm (see module header):
//   Start with [0] (terminator).  Set k=n.
//   While k > 1: prepend binary(k), set k=floor(log2(k)).
fn omega_encode(n) -> list
    let code = []
    push(code, 0)
    let k = n
    while k > 1
        let dummy = 0
        let nbits = _omg_bit_width(k)
        code = _omg_prepend_binary(k, nbits, code)
        k = _omg_floor_log2(k)
    code

// omega_decode: decode one Elias omega codeword from bit list bits at position pos.
//
// Returns [value, next_pos] where next_pos is the first bit index after the
// consumed codeword.  On malformed input (bitstream ends before the terminator)
// returns [-1, len(bits)].
//
// Decoding algorithm (standard Elias omega):
//   k = 1
//   Loop:
//     read bit b = bits[cur]; cur++
//     if b == 0: return [k, cur]    (terminator — done; k is the decoded value)
//     else (b == 1):
//       Read k MORE bits (after the already-consumed 1 bit).
//       The (k+1)-bit group = [1, bit_{0}, ..., bit_{k-1}] interpreted as integer.
//       That integer becomes the new k.
//       Continue.
//
// The 1 bit that triggered the group is the MSB of the (k+1)-bit integer.
// So group_value = (1 << k) | (those k bits as integer).
//
// Trace for [1,0,0] (n=2):
//   k=1; read bit[0]=1; read 1 more bit: bit[1]=0; group=(1<<1)|0=2; k=2.
//   k=2; read bit[2]=0; done; return [2, 3]. ✓
//
// Trace for [1,0,1,0,0,0] (n=4):
//   k=1; read bit[0]=1; read 1 bit: bit[1]=0; group=2; k=2.
//   k=2; read bit[2]=1; read 2 bits: bit[3]=0,bit[4]=0; group=(1<<2)|0=4; k=4.
//   k=4; read bit[5]=0; done; return [4, 6]. ✓
fn omega_decode(bits, pos) -> list
    let blen = len(bits)
    let result = []
    if pos >= blen
        push(result, -1)
        push(result, blen)
        return result
    let k = 1
    let cur = pos
    let failed = 0
    let done_flag = 0
    while done_flag == 0 and failed == 0
        let dummy = 0
        if cur >= blen
            failed = 1
        else
            let b = bits[cur]
            cur = cur + 1
            if b == 0
                done_flag = 1
            else
                // b==1: read k more bits; form (k+1)-bit integer with 1 as MSB.
                if cur + k > blen
                    failed = 1
                else
                    // Start accumulator with 1 (the MSB we already read).
                    let val = 1
                    for i in 0..k
                        let dummy2 = 0
                        val = val * 2 + bits[cur]
                        cur = cur + 1
                    k = val
    if failed == 1
        push(result, -1)
        push(result, blen)
    else
        push(result, k)
        push(result, cur)
    result

// pack_bits: pack a list of 0/1 ints into bytes (list of ints 0..255).
//
// Groups of 8 bits are packed MSB-first into each byte.  The last byte is
// zero-padded on the right if the total number of bits is not a multiple of 8.
// An empty input returns an empty list.
//
// Example:
//   pack_bits([1,0,1,1,0,0,1,0,  1,1,0]) -> [0xB2=178, 0xC0=192]
//   (last byte: [1,1,0,0,0,0,0,0] = 0xC0)
fn pack_bits(bit_list) -> list
    let out = []
    let blen = len(bit_list)
    let i = 0
    while i < blen
        let dummy = 0
        let byte_val = 0
        for j in 0..8
            let dummy2 = 0
            byte_val = byte_val * 2
            if i < blen
                byte_val = byte_val + bit_list[i]
                i = i + 1
            else
                i = i + 1
        push(out, byte_val)
    out

// omega_bit_length: return the number of bits in the omega code for n >= 1.
//
// Computed without materialising the full bit list — just accumulates widths.
fn omega_bit_length(n) -> int
    let total = 1
    let k = n
    while k > 1
        let dummy = 0
        total = total + _omg_bit_width(k)
        k = _omg_floor_log2(k)
    total
