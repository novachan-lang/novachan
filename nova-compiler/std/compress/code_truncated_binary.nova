// ============================================================================
// NOVA Standard Library — std/compress/code_truncated_binary
// ============================================================================
// Truncated binary encoding for a uniform distribution over n symbols
// (values 0..n-1).
//
// This is the provably optimal fixed-alphabet encoding for a uniform source
// with n symbols when n is NOT a power of two. When n IS a power of two it
// degenerates to plain binary (k bits, no truncation needed).
//
// THEORY:
//   k = floor(log2(n))        -- base bit width
//   u = 2^(k+1) - n           -- number of "short" (k-bit) codewords
//
//   The [0..n-1] values are split into two ranges:
//     SHORT range  [0 .. u-1]      -> encode directly as k bits   (k    bits)
//     LONG  range  [u .. n-1]      -> encode as (value + u) in k+1 bits
//
//   Decoder mirrors this: read k bits -> tentative v.
//     if v < u:  result = v           (short, stop here)
//     else:      read one more bit -> result = v*2 + extra_bit - u
//
//   This allocation assigns the lexicographically smaller codewords to lower
//   values, preserving prefix-freeness and minimising average length.
//
// EXAMPLES (n=5, k=2, u=3):
//   value=0 -> 00        (short, 2 bits)
//   value=1 -> 01        (short, 2 bits)
//   value=2 -> 10        (short, 2 bits)
//   value=3 -> 110       (long:  3+3=6 -> [1,1,0])
//   value=4 -> 111       (long:  4+3=7 -> [1,1,1])
//
// SPECIAL CASE n=1: only value 0 is valid, encodes to [] (0 bits).
//
// PUBLIC API:
//   trunc_encode(value, n) -> list
//     Encodes 'value' (0..n-1) as a list of 0/1 ints (MSB-first).
//     Returns [] on invalid input (value < 0, value >= n, n < 1).
//
//   trunc_decode(bits, pos, n) -> list
//     Decode one truncated-binary value from bit-list 'bits' at index pos.
//     Returns [value, next_pos] on success.
//     Returns [-1, pos] on malformed/truncated input.
//
//   trunc_len(value, n) -> int
//     Returns the number of bits used by trunc_encode(value, n).
//     Returns -1 on invalid input.
//
// SYMBOL COLLISION GUARD:
//   All private helpers use prefix _ctb_ to avoid link collisions.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// _ctb_floor_log2: return floor(log2(n)) for n >= 1.
// n=1 -> 0, n=2 -> 1, n=3 -> 1, n=4 -> 2, etc.
fn _ctb_floor_log2(n) -> int
    let k = 0
    let v = n
    while v > 1
        let _unused = 0
        v = v / 2
        k = k + 1
    k

// _ctb_pow2: return 2^e for e >= 0.
fn _ctb_pow2(e) -> int
    let r = 1
    let i = 0
    while i < e
        let _unused = 0
        r = r * 2
        i = i + 1
    r

// _ctb_int_to_bits: convert integer v to an nbits-wide MSB-first list of 0/1.
// v must fit in nbits. nbits=0 returns [].
fn _ctb_int_to_bits(v, nbits) -> list
    let out = []
    if nbits == 0
        return out
    let i = nbits - 1
    while i >= 0
        let _unused = 0
        let bit = (v >> i) & 1
        push(out, bit)
        i = i - 1
    out

// _ctb_bits_to_int: interpret k bits from bit-list 'bits' starting at pos
// as an MSB-first unsigned integer. Returns the integer value.
// Caller must guarantee pos+k <= len(bits).
fn _ctb_bits_to_int(bits, pos, k) -> int
    let v = 0
    let j = 0
    while j < k
        let _unused = 0
        v = v * 2 + bits[pos + j]
        j = j + 1
    v

// ── Public API ────────────────────────────────────────────────────────────────

// trunc_encode: truncated binary code for 'value' in alphabet of size n.
//
// Encodes value in [0..n-1] using the minimum number of bits consistent with
// a prefix-free code over exactly n symbols.
//
// Algorithm:
//   n=1          -> [] (0 bits, trivially)
//   k = floor(log2(n)); u = 2^(k+1) - n
//   value < u    -> _ctb_int_to_bits(value, k)          -- k bits
//   value >= u   -> _ctb_int_to_bits(value + u, k+1)    -- k+1 bits
//
// Returns [] on invalid input (value < 0, value >= n, n < 1).
//
// Complexity: O(log n) time and space.
fn trunc_encode(value, n) -> list
    let out = []
    if n < 1
        return out
    if value < 0
        return out
    if value >= n
        return out
    // Special case: n=1 -> 0 bits (the only symbol needs no bits)
    if n == 1
        return out
    let k = _ctb_floor_log2(n)
    let two_k1 = _ctb_pow2(k + 1)
    let u = two_k1 - n
    if value < u
        // short codeword: k bits
        out = _ctb_int_to_bits(value, k)
    else
        // long codeword: k+1 bits, encode (value + u)
        out = _ctb_int_to_bits(value + u, k + 1)
    out

// trunc_decode: decode one truncated-binary value from bit-list at offset pos.
//
// Returns [value, next_pos] where next_pos is immediately past the last
// consumed bit. Suitable for sequential decoding of concatenated codes.
//
// Returns [-1, pos] on truncated/malformed input.
//
// Algorithm:
//   n=1: return [0, pos]   (0-bit code, no bits consumed)
//   k = floor(log2(n)); u = 2^(k+1) - n
//   Read k bits -> tentative v
//   if v < u:   result = v,              next_pos = pos+k
//   else:       read one more bit b,    result = v*2 + b - u,  next_pos = pos+k+1
//
// Complexity: O(log n) time.
fn trunc_decode(bits, pos, n) -> list
    let result = []
    let blen = len(bits)
    if n < 1
        push(result, -1)
        push(result, pos)
        return result
    // Special case: n=1 -> consume 0 bits
    if n == 1
        push(result, 0)
        push(result, pos)
        return result
    let k = _ctb_floor_log2(n)
    let two_k1 = _ctb_pow2(k + 1)
    let u = two_k1 - n
    // Need at least k bits
    if pos + k > blen
        push(result, -1)
        push(result, pos)
        return result
    // Read k bits as tentative value
    let v = _ctb_bits_to_int(bits, pos, k)
    if v < u
        // short codeword: done after k bits
        push(result, v)
        push(result, pos + k)
    else
        // long codeword: need one more bit
        if pos + k + 1 > blen
            push(result, -1)
            push(result, pos)
            return result
        let extra = bits[pos + k]
        let decoded = v * 2 + extra - u
        push(result, decoded)
        push(result, pos + k + 1)
    result

// trunc_len: number of bits used to encode 'value' in alphabet of size n.
//
// Returns k   if value < u  (short codeword)
// Returns k+1 if value >= u (long  codeword)
// Returns 0   if n == 1
// Returns -1  on invalid input.
//
// Complexity: O(log n) time.
fn trunc_len(value, n) -> int
    if n < 1
        return -1
    if value < 0
        return -1
    if value >= n
        return -1
    if n == 1
        return 0
    let k = _ctb_floor_log2(n)
    let two_k1 = _ctb_pow2(k + 1)
    let u = two_k1 - n
    if value < u
        k
    else
        k + 1
