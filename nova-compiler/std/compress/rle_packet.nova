// ============================================================================
// NOVA Standard Library — std/compress/rle_packet
// ============================================================================
// PackBits-style Run-Length Encoding operating on byte-lists (list of ints 0..255).
//
// PackBits format (from Apple/TIFF spec):
//   - A "run" packet:     control byte (257 - n) where n in 2..128, then 1 value byte.
//                         On decode: repeat value byte n times.
//   - A "literal" packet: control byte (n - 1) where n in 1..128, then n literal bytes.
//                         Control byte range: 0..127.
//   - Control byte 128 is a no-op; never emitted by this encoder.
//
// Encoding strategy:
//   Scan input left to right.
//   If next 2+ bytes are equal: emit a run packet (up to 128 bytes per packet).
//   Otherwise: collect up to 128 literal bytes (stopping before any run of 2+).
//
// PUBLIC API:
//   rle_packet_compress(bytes) -> byte-list
//   rle_packet_decompress(bytes) -> byte-list
//
// ROUND-TRIP GUARANTEE:
//   rle_packet_decompress(rle_packet_compress(x)) == x for all byte-lists x.
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _rlpkt_
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Count how many bytes starting at pos equal bytes[pos].
// Returns run length >= 1. Caps at max_run.
fn _rlpkt_run_len(bytes, pos, n, max_run) -> int
    let val = bytes[pos]
    let i = pos + 1
    let done = 0
    while i < n and (i - pos) < max_run and done == 0
        if bytes[i] != val
            done = 1
        else
            i = i + 1
    i - pos

// Collect literal bytes starting at pos, stopping before a run of >= 2 identical
// bytes, or at max_lit literals, or at end of input.
// Returns the count of literals to emit.
fn _rlpkt_lit_count(bytes, pos, n, max_lit) -> int
    let count = 0
    let done = 0
    while count < max_lit and (pos + count) < n and done == 0
        let cur = pos + count
        // Check if a run of >= 2 starts here (only if we already have >= 1 literal)
        if count > 0
            let run = _rlpkt_run_len(bytes, cur, n, 128)
            if run >= 2
                done = 1
            else
                count = count + 1
        else
            count = count + 1
    count

// ── Public API ────────────────────────────────────────────────────────────────

// rle_packet_compress: PackBits-style compression of a byte-list.
//
// Each packet in the output is either:
//   [257-n, val]              — a run of n identical bytes (n in 2..128)
//   [n-1, b0, b1, ..., bn-1] — n literal bytes (n in 1..128)
//
// A run of 100 identical bytes 0xAA compresses to just 2 bytes: [158, 0xAA].
// Mixed literal+run input round-trips exactly.
fn rle_packet_compress(bytes) -> list
    let n = len(bytes)
    let out = []
    let pos = 0
    while pos < n
        let run = _rlpkt_run_len(bytes, pos, n, 128)
        if run >= 2
            // Emit a run packet.
            let ctrl = 257 - run
            out.push(ctrl)
            out.push(bytes[pos])
            pos = pos + run
        else
            // Collect literals.
            let lit_count = _rlpkt_lit_count(bytes, pos, n, 128)
            if lit_count == 0
                // Safety: should not happen, but emit 1 literal to avoid infinite loop.
                lit_count = 1
            let ctrl = lit_count - 1
            out.push(ctrl)
            for j in 0..lit_count
                out.push(bytes[pos + j])
            pos = pos + lit_count
    out

// rle_packet_decompress: decode a PackBits-encoded byte-list.
//
// Reads packets sequentially:
//   control byte 0..127   -> next (control + 1) bytes are literals, copy them.
//   control byte 129..255 -> next byte repeated (257 - control) times.
//   control byte 128      -> no-op; skip (never emitted by our encoder).
//
// rle_packet_decompress(rle_packet_compress(x)) == x for all byte-lists x.
fn rle_packet_decompress(bytes) -> list
    let n = len(bytes)
    let out = []
    let pos = 0
    while pos < n
        let ctrl = bytes[pos]
        pos = pos + 1
        if ctrl <= 127
            // Literal packet: next (ctrl + 1) bytes.
            let lit_count = ctrl + 1
            let j = 0
            while j < lit_count and pos < n
                out.push(bytes[pos])
                pos = pos + 1
                j = j + 1
        else
            if ctrl >= 129
                // Run packet: repeat next byte (257 - ctrl) times.
                let run_count = 257 - ctrl
                if pos < n
                    let val = bytes[pos]
                    pos = pos + 1
                    for j in 0..run_count
                        out.push(val)
            // ctrl == 128: no-op, skip.
    out
