// ============================================================================
// NOVA Standard Library — std/compress/arithmetic
// ============================================================================
// Integer Range/Arithmetic Coding — a lossless entropy coder that achieves
// compression approaching the Shannon entropy limit.
//
// ALGORITHM OVERVIEW:
//   Arithmetic coding represents a message as a single rational number in
//   [0, 1), partitioned by the cumulative probability distribution of
//   symbols. This implementation uses a 31-bit integer range coder:
//
//   ENCODE (range coding with E3 straddle scaling):
//     low = 0, high = 2^31-1  (the initial interval covering [0, 1))
//     For each symbol S with cumulative range [c_lo, c_hi) out of total:
//       range = high - low + 1
//       high  = low + range * c_hi / total - 1
//       low   = low + range * c_lo / total
//     Renormalize (emit bits and rescale) until interval is large enough.
//     Flush final bits to uniquely identify the interval.
//
//   DECODE (symmetric rescaling):
//     Read a window of bits into `value`, track low/high identically to encoder.
//     For each symbol: find which S satisfies
//       c_lo/total <= (value - low) * total / range < c_hi/total
//     Rescale exactly as encoder does, shifting in new bits from the stream.
//
// RENORMALIZATION (E1/E2/E3 scaling):
//   E1: both low and high < HALF (MSB=0) — emit 0, left-shift interval
//   E2: both low and high >= HALF (MSB=1) — emit 1, left-shift interval
//   E3: interval straddles HALF — remove middle bit, track straddle count
//       When an E1/E2 bit is finally emitted, follow it with (straddle_count)
//       complementary bits.
//
// INTEGER CONSTANTS (31-bit, all fit in i64 signed):
//   FULL  = 2147483647 = 0x7FFFFFFF = 2^31 - 1
//   HALF  = 1073741824 = 0x40000000 = 2^30
//   THREE_QUARTER = 1610612736 = 0x60000000 = 3 * 2^29
//   QUARTER = 536870912 = 0x20000000 = 2^29
//
// MODEL (from arc_build_model):
//   dict {
//     "total": int,           total cumulative frequency
//     "chars": dict {         char -> [cum_lo, cum_hi] list  (0 <= lo < hi <= total)
//       "a": [0, 3],
//       "b": [3, 4],
//       ...
//     },
//     "order": list           chars in sorted order (for deterministic decoding)
//   }
//
// ENCODE OUTPUT (from arc_encode):
//   list of int (0 or 1) — the bit stream, MSB first.
//   Empty string -> empty list.  Single-symbol alphabet -> short flush sequence.
//
// DECODE INPUT (to arc_decode):
//   the bit list from arc_encode, the same model, and the original message length.
//
// SPECIAL CASES:
//   empty string  — model has total=0; encode returns []; decode returns ""
//   single-symbol — model has total=len(s); all range consumed by one symbol;
//                   encode emits only flush bits; decode reconstructs correctly
//
// COMPLEXITY: O(n * |alphabet|) encode+decode (|alphabet| <= 256).
//
// SYMBOL COLLISION GUARD:
//   All private helpers prefixed _arc_ to avoid link collisions.
//
// LEAF — imports NOTHING.

// ── Integer constants ─────────────────────────────────────────────────────────
// 31-bit range coder constants. All fit comfortably in i64 signed arithmetic.

fn _arc_full() -> int
    // 2^31 - 1 = 0x7FFFFFFF
    2147483647

fn _arc_half() -> int
    // 2^30 = 0x40000000
    1073741824

fn _arc_quarter() -> int
    // 2^29 = 0x20000000
    536870912

fn _arc_three_quarter() -> int
    // 3 * 2^29 = 0x60000000
    1610612736

// ── Model construction ────────────────────────────────────────────────────────

// _arc_count_chars: count frequency of each character in s.
// Returns dict: char -> count (int >= 1).
fn _arc_count_chars(s) -> any
    let freq = {}
    let n = len(s)
    let i = 0
    while i < n
        let c = s[i]
        if contains(freq, c)
            freq[c] = freq[c] + 1
        else
            freq[c] = 1
        i = i + 1
    return freq

// _arc_sort_chars: return a sorted list of the keys of dict freq.
// Sorted by ord() value (ascending) for a deterministic model.
fn _arc_sort_chars(freq) -> list
    let char_list = keys(freq)
    let nc = len(char_list)
    // Insertion sort (alphabet is small, at most 256 entries).
    let si = 1
    while si < nc
        let key_c = char_list[si]
        let key_ord = ord(key_c)
        let sj = si - 1
        let sdone = 0
        while sj >= 0 and sdone == 0
            if ord(char_list[sj]) > key_ord
                char_list[sj + 1] = char_list[sj]
                sj = sj - 1
            else
                sdone = 1
        char_list[sj + 1] = key_c
        si = si + 1
    return char_list

// arc_build_model: build a cumulative frequency model from string s.
//
// Returns a dict:
//   "total"  -> int              total of all frequencies (= len(s))
//   "chars"  -> dict             char -> [cum_lo, cum_hi] (exclusive upper bound)
//   "order"  -> list             chars in ascending ord() order (deterministic)
//
// The cumulative ranges partition [0, total):
//   chars[order[0]] = [0, freq(order[0]))
//   chars[order[1]] = [freq(order[0]), freq(order[0]) + freq(order[1]))
//   ...
//
// Empty string: total=0, chars={}, order=[].
//
// Example: arc_build_model("abba")
//   -> total=4, chars={"a":[0,2], "b":[2,4]}, order=["a","b"]
fn arc_build_model(s) -> any
    let model = {}
    let n = len(s)
    model["total"] = n
    let chars_dict = {}
    model["chars"] = chars_dict
    model["order"] = []
    if n == 0
        return model
    let freq = _arc_count_chars(s)
    let order = _arc_sort_chars(freq)
    model["order"] = order
    let nc = len(order)
    let cum = 0
    let i = 0
    while i < nc
        let c = order[i]
        let f = freq[c]
        let range_pair = [cum, cum + f]
        chars_dict[c] = range_pair
        cum = cum + f
        i = i + 1
    return model

// ── Encoder ───────────────────────────────────────────────────────────────────

// _arc_emit_bit: append a bit and all pending straddle bits to the output list.
// pending_bits is a list used as a mutable counter: pending_bits[0] = count.
fn _arc_emit_bit(bits_out, b, pending_bits)
    bits_out.push(b)
    let count = pending_bits[0]
    let flipped = 1 - b
    let j = 0
    while j < count
        let dummy = 0
        bits_out.push(flipped)
        j = j + 1
    pending_bits[0] = 0

// arc_encode: encode string s using arithmetic coding with the given model.
//
// Returns a list of int (0 or 1) — the bit stream (MSB first).
// The model must have been built from s (or any string with the same
// character set and frequencies).
//
// EMPTY string: returns [].
// SINGLE-SYMBOL alphabet: returns a short flush sequence (a few bits).
//
// Example:
//   let m = arc_build_model("ab")
//   arc_encode("ab", m)  -> a list of 0/1 ints that decodes back to "ab"
fn arc_encode(s, model) -> list
    let n = len(s)
    let bits_out = []
    if n == 0
        return bits_out
    let total = model["total"]
    if total == 0
        return bits_out
    let chars_dict = model["chars"]
    let full = _arc_full()
    let half = _arc_half()
    let quarter = _arc_quarter()
    let three_q = _arc_three_quarter()
    let low = 0
    let high = full
    // pending_bits[0] = straddle counter
    let pending_bits = [0]
    let i = 0
    while i < n
        let c = s[i]
        let pair = chars_dict[c]
        let c_lo = pair[0]
        let c_hi = pair[1]
        // Narrow the interval: [low + range*c_lo/total, low + range*c_hi/total - 1]
        let range = high - low + 1
        let new_high = low + range * c_hi / total - 1
        let new_low = low + range * c_lo / total
        high = new_high
        low = new_low
        // Renormalize: emit bits until interval is large enough (>= quarter)
        let renorm_done = 0
        while renorm_done == 0
            if high < half
                // E1: both MSBs are 0 — emit 0 with pending complement bits
                _arc_emit_bit(bits_out, 0, pending_bits)
                low = low * 2
                high = high * 2 + 1
            else
                if low >= half
                    // E2: both MSBs are 1 — emit 1 with pending complement bits
                    _arc_emit_bit(bits_out, 1, pending_bits)
                    low = (low - half) * 2
                    high = (high - half) * 2 + 1
                else
                    if low >= quarter and high < three_q
                        // E3: straddle — remove middle bit, count it
                        pending_bits[0] = pending_bits[0] + 1
                        low = (low - quarter) * 2
                        high = (high - quarter) * 2 + 1
                    else
                        renorm_done = 1
        i = i + 1
    // Flush: emit enough bits to uniquely identify the final interval.
    // We emit one final bit (based on which half of the interval we're in),
    // then flush the straddle count, then one more zero to end.
    pending_bits[0] = pending_bits[0] + 1
    if low < quarter
        _arc_emit_bit(bits_out, 0, pending_bits)
    else
        _arc_emit_bit(bits_out, 1, pending_bits)
    return bits_out

// ── Decoder ───────────────────────────────────────────────────────────────────

// _arc_read_bit: read the next bit from the bit stream list.
// State dict keys: "bits" -> list, "pos" -> int.
// Returns 0 if stream is exhausted.
fn _arc_read_bit(state) -> int
    let pos = state["pos"]
    let bits = state["bits"]
    let n = len(bits)
    let b = 0
    if pos < n
        b = bits[pos]
        state["pos"] = pos + 1
    return b

// _arc_find_symbol: find which symbol in model contains the cumulative value v.
// v is in [0, total). Returns the character whose [c_lo, c_hi) contains v.
// Uses the "order" list to iterate deterministically.
fn _arc_find_symbol(model, v) -> string
    let order = model["order"]
    let chars_dict = model["chars"]
    let nc = len(order)
    let found = ""
    let i = 0
    while i < nc and found == ""
        let c = order[i]
        let pair = chars_dict[c]
        let c_lo = pair[0]
        let c_hi = pair[1]
        if v >= c_lo and v < c_hi
            found = c
        i = i + 1
    return found

// arc_decode: decode a bit list back to the original string.
//
// bits_list: list of int (0 or 1), as produced by arc_encode.
// model:     the same model used during encoding (arc_build_model of original).
// length:    the exact number of symbols to decode (= len(original string)).
//
// Returns the decoded string. arc_decode(arc_encode(s, m), m, len(s)) == s.
//
// EMPTY: length==0 -> returns "".
//
// Example:
//   let m = arc_build_model("hello")
//   let bits = arc_encode("hello", m)
//   arc_decode(bits, m, 5) == "hello"
fn arc_decode(bits_list, model, length) -> string
    if length == 0
        return ""
    let total = model["total"]
    if total == 0
        return ""
    let full = _arc_full()
    let half = _arc_half()
    let quarter = _arc_quarter()
    let three_q = _arc_three_quarter()
    // Bit stream state
    let state = {}
    state["bits"] = bits_list
    state["pos"] = 0
    // Initialise decoder value by reading the first 31 bits from the stream.
    let value = 0
    let k = 0
    while k < 31
        let dummy = 0
        let b = _arc_read_bit(state)
        value = value * 2 + b
        k = k + 1
    let low = 0
    let high = full
    let out = ""
    let i = 0
    while i < length
        // Determine cumulative value scaled into [0, total).
        let range = high - low + 1
        // cum = (value - low + 1) * total / range - 1  (scaled into [0, total))
        // We need integer arithmetic. The +1/-1 offsets follow the standard
        // integer range coder convention for exact symmetric decode.
        let scaled = (value - low + 1) * total - 1
        let cum = scaled / range
        // Find the symbol whose cumulative range contains cum.
        let c = _arc_find_symbol(model, cum)
        out = out + c
        // Narrow interval (same as encoder)
        let chars_dict = model["chars"]
        let pair = chars_dict[c]
        let c_lo = pair[0]
        let c_hi = pair[1]
        let new_high = low + range * c_hi / total - 1
        let new_low = low + range * c_lo / total
        high = new_high
        low = new_low
        // Renormalize (identical rescaling as encoder, but also shift value)
        let renorm_done = 0
        while renorm_done == 0
            if high < half
                // E1
                low = low * 2
                high = high * 2 + 1
                value = value * 2 + _arc_read_bit(state)
            else
                if low >= half
                    // E2
                    low = (low - half) * 2
                    high = (high - half) * 2 + 1
                    value = (value - half) * 2 + _arc_read_bit(state)
                else
                    if low >= quarter and high < three_q
                        // E3
                        low = (low - quarter) * 2
                        high = (high - quarter) * 2 + 1
                        value = (value - quarter) * 2 + _arc_read_bit(state)
                    else
                        renorm_done = 1
        i = i + 1
    return out

// ── Utility ───────────────────────────────────────────────────────────────────

// arc_bits_count: return the number of bits arc_encode produces for s.
// Equivalent to len(arc_encode(s, arc_build_model(s))) but expressive as a
// standalone function for benchmarking compression ratios.
fn arc_bits_count(s) -> int
    let n = len(s)
    if n == 0
        return 0
    let m = arc_build_model(s)
    let bits = arc_encode(s, m)
    return len(bits)
