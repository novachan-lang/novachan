// std/chem/kinetics.nova — Chemical kinetics formula functions.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float consts defined inside fn bodies (module-level float consts truncate to int).
//   * All intermediate results bound to named `let` variables.
//   * Never return a bare multi-term float expression — single-exit named result.
//   * ABS OF FLOAT: (if x < 0.0 then 0.0 - x else x) — NOT abs().
//   * Integer division: coerce with *1.0 to get float division.
//   * Gas constant R = 8.314 J/(mol·K).
//
// API (PREFIX: ck_):
//   ck_rate_constant_arrhenius(a, ea, t) -> float  k = A * exp(-Ea / (R*T))
//   ck_half_life_first_order(k)          -> float  t_half = 0.693 / k
//   ck_first_order_conc(c0, k, t)        -> float  [A](t) = [A]0 * exp(-k*t)
//   ck_reaction_rate(delta_conc, delta_t)-> float  rate = delta_conc / delta_t

// Arrhenius equation: k = A * exp(-Ea / (R*T))
// a  = pre-exponential factor (frequency factor), same units as k
// ea = activation energy in J/mol
// t  = temperature in Kelvin
// R  = 8.314 J/(mol·K)
fn ck_rate_constant_arrhenius(a: float, ea: float, t: float) -> float
    let r_gas = 8.314
    let rt = r_gas * t
    let neg_ea = 0.0 - ea
    let exponent = neg_ea / rt
    let k = a * exp(exponent)
    k

// Half-life of a first-order reaction: t_half = ln(2) / k = 0.693 / k
// k must be > 0 (caller responsibility).
fn ck_half_life_first_order(k: float) -> float
    let ln2 = 0.693147
    let t_half = ln2 / k
    t_half

// First-order integrated rate law: [A](t) = [A]0 * exp(-k * t)
// c0 = initial concentration
// k  = rate constant (1/time)
// t  = elapsed time
fn ck_first_order_conc(c0: float, k: float, t: float) -> float
    let neg_k = 0.0 - k
    let exponent = neg_k * t
    let growth = exp(exponent)
    let conc = c0 * growth
    conc

// Instantaneous (average) reaction rate: rate = |delta_conc| / delta_t
// delta_conc = change in concentration (can be negative for reactants; sign preserved).
// delta_t    = elapsed time (must be > 0).
// Returns signed rate (positive = product formation, negative = reactant consumption).
fn ck_reaction_rate(delta_conc: float, delta_t: float) -> float
    let rate = delta_conc / delta_t
    rate
