// std/chem/colligative.nova — Colligative property formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   boiling_point_elevation(kb, molality, i)   -> float  dTb = Kb * m * i
//   freezing_point_depression(kf, molality, i) -> float  dTf = Kf * m * i
//   osmotic_pressure(m, t)                     -> float  pi = m * R * T  (R=0.0821 L·atm/mol·K)
//   new_boiling_point(bp, elevation)            -> float  Tb_new = Tb + dTb
//
// kb/kf = ebullioscopic/cryoscopic constants (°C·kg/mol).
// molality = moles solute per kg solvent.
// i = van't Hoff factor (number of particles dissolved: 1 for sugar, 2 for NaCl).
// m (osmotic) = molarity in mol/L; t = temperature in Kelvin.
// R = 0.0821 L·atm/(mol·K) for osmotic_pressure.

// Gas constant for osmotic pressure (L·atm/(mol·K)).
fn R_atm()
    let r = 0.0821
    return r

// boiling_point_elevation — dTb = Kb * m * i
fn boiling_point_elevation(kb, molality, i)
    let dtb = kb * molality * i
    return dtb

// freezing_point_depression — dTf = Kf * m * i
fn freezing_point_depression(kf, molality, i)
    let dtf = kf * molality * i
    return dtf

// osmotic_pressure — pi = M * R * T  (R = 0.0821 L·atm/mol·K)
fn osmotic_pressure(m, t)
    let r = R_atm()
    let pi = m * r * t
    return pi

// new_boiling_point — Tb_new = Tb + dTb
fn new_boiling_point(bp, elevation)
    let tb_new = bp + elevation
    return tb_new
