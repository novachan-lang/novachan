// std/chem/equilibrium.nova — Chemical equilibrium formula functions.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float consts defined inside fn bodies (module-level float consts truncate to int).
//   * All intermediate results bound to named `let` variables.
//   * Never return a bare multi-term float expression — single-exit named result.
//   * ABS OF FLOAT: (if x < 0.0 then 0.0 - x else x) — NOT abs().
//   * Integer division: coerce with *1.0 to get float division.
//
// API (PREFIX: ceq_):
//   ceq_keq(products, reactants) -> float
//       Equilibrium constant: product of [P_i]^coeff_i over product of [R_j]^coeff_j.
//       products/reactants: list of [conc, coeff] pairs encoded as flat list [c1,exp1,c2,exp2,...].
//   ceq_reaction_quotient(products, reactants) -> float
//       Same formula as keq but for non-equilibrium concentrations (returns Q).
//   ceq_keq_simple(prod, react) -> float
//       Simplified Keq = prod / react (single concentration ratio).
//   ceq_le_chatelier_shift(q, k) -> str
//       Returns "forward" if Q < K, "reverse" if Q > K, "equilibrium" if Q == K.

// Internal: compute product of (conc^coeff) from a flat list [c1,exp1,c2,exp2,...].
// Each pair: conc at index 2i, exponent at index 2i+1.
fn ceq_product_terms(terms: list) -> float
    let n = len(terms)
    let result = 1.0
    let i = 0
    while i < n
        let conc = terms[i] * 1.0
        let coeff = terms[i + 1] * 1.0
        let term = pow(conc, coeff)
        result = result * term
        i += 2
    result

// Equilibrium constant Keq from lists of [conc,coeff] pairs.
// products  = flat list [p1_conc, p1_coeff, p2_conc, p2_coeff, ...]
// reactants = flat list [r1_conc, r1_coeff, r2_conc, r2_coeff, ...]
fn ceq_keq(products: list, reactants: list) -> float
    let num = ceq_product_terms(products)
    let den = ceq_product_terms(reactants)
    let keq = num / den
    keq

// Reaction quotient Q — same formula as Keq but used before equilibrium is reached.
fn ceq_reaction_quotient(products: list, reactants: list) -> float
    let num = ceq_product_terms(products)
    let den = ceq_product_terms(reactants)
    let q = num / den
    q

// Simple Keq for single-species ratio: Keq = [products] / [reactants]
fn ceq_keq_simple(prod: float, react: float) -> float
    let keq = prod / react
    keq

// Le Chatelier's principle: predict shift direction from Q vs K.
// Q < K  -> reaction shifts forward (more products form)
// Q > K  -> reaction shifts reverse (more reactants form)
// Q == K -> system is at equilibrium
fn ceq_le_chatelier_shift(q: float, k: float) -> str
    if q < k
        return "forward"
    if q > k
        return "reverse"
    return "equilibrium"
