// std/chem/acid_base.nova — pH / pOH and acid-base equilibrium formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   ph_from_h(h_conc)       -> float  pH = -log10([H+])
//   poh_from_oh(oh_conc)    -> float  pOH = -log10([OH-])
//   ph_to_h(ph)             -> float  [H+] = 10^(-pH)
//   poh_to_oh(poh)          -> float  [OH-] = 10^(-pOH)
//   ph_poh_sum()            -> float  pH + pOH = 14.0 (at 25°C)
//   ka_from_ph(ph, conc)    -> float  Ka ≈ [H+]^2 / (conc - [H+])  (weak acid approx)
//   is_acidic(ph)           -> bool   ph < 7.0
//
// log10(x) inlined as log(x)/log(10.0) — NOVA has log() (natural log) but not log10().

// ph_from_h: pH = -log10([H+])
fn ph_from_h(h_conc)
    let ln10 = log(10.0)
    let lnh = log(h_conc)
    let log10h = lnh / ln10
    let ph = -log10h
    return ph

// poh_from_oh: pOH = -log10([OH-])
fn poh_from_oh(oh_conc)
    let ln10 = log(10.0)
    let lnoh = log(oh_conc)
    let log10oh = lnoh / ln10
    let poh = -log10oh
    return poh

// ph_to_h: [H+] = 10^(-pH)
fn ph_to_h(ph)
    let neg_ph = -ph
    let h = pow(10.0, neg_ph)
    return h

// poh_to_oh: [OH-] = 10^(-pOH)
fn poh_to_oh(poh)
    let neg_poh = -poh
    let oh = pow(10.0, neg_poh)
    return oh

// ph_poh_sum: pH + pOH = 14.0 at 25°C
fn ph_poh_sum()
    let s = 14.0
    return s

// ka_from_ph: weak acid approximation Ka ≈ [H+]^2 / (conc - [H+])
fn ka_from_ph(ph, conc)
    let h = ph_to_h(ph)
    let h2 = h * h
    let denom = conc - h
    let ka = h2 / denom
    return ka

// is_acidic: true if pH < 7.0
fn is_acidic(ph)
    ph < 7.0
