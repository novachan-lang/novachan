// std/chem/molar_mass.nova — Chemical formula parser and molar mass calculator.
//
// Parses Hill-notation chemical formulas (elements optionally followed by
// integer counts, parenthesised groups followed by integer multipliers).
// Supports: "H2O", "NaCl", "C6H12O6", "Ca(OH)2", "CO2", "NH4NO3", etc.
//
// FLOAT RULES obeyed:
//   * Float constants defined inside fn bodies (no module-level floats).
//   * Intermediate results bound to named lets.
//   * No bare multi-term float return — single-exit named result.
//   * abs(float): if x < 0.0 { 0.0 - x } else { x }
//
// Public API:
//   molar_mass(formula: string) -> float
//       Sum of atomic masses for all atoms in formula.  Returns 0.0 on parse error.
//
//   parse_formula(formula: string) -> list
//       Returns a list of two-element lists [[symbol, count], ...] giving the
//       atom composition (counts summed over all occurrences and group expansions).

// ---------------------------------------------------------------------------
// PRIVATE — inline element mass table (avoids cross-module import overhead).
// Only elements needed for common formulas; returns 0.0 for unknowns.
// ---------------------------------------------------------------------------
fn _elem_mass(sym: string) -> float
    if sym == "H"
        let m = 1.008
        return m
    if sym == "He"
        let m = 4.003
        return m
    if sym == "Li"
        let m = 6.941
        return m
    if sym == "Be"
        let m = 9.012
        return m
    if sym == "B"
        let m = 10.811
        return m
    if sym == "C"
        let m = 12.011
        return m
    if sym == "N"
        let m = 14.007
        return m
    if sym == "O"
        let m = 15.999
        return m
    if sym == "F"
        let m = 18.998
        return m
    if sym == "Ne"
        let m = 20.180
        return m
    if sym == "Na"
        let m = 22.990
        return m
    if sym == "Mg"
        let m = 24.305
        return m
    if sym == "Al"
        let m = 26.982
        return m
    if sym == "Si"
        let m = 28.086
        return m
    if sym == "P"
        let m = 30.974
        return m
    if sym == "S"
        let m = 32.065
        return m
    if sym == "Cl"
        let m = 35.453
        return m
    if sym == "Ar"
        let m = 39.948
        return m
    if sym == "K"
        let m = 39.098
        return m
    if sym == "Ca"
        let m = 40.078
        return m
    if sym == "Fe"
        let m = 55.845
        return m
    if sym == "Cu"
        let m = 63.546
        return m
    if sym == "Zn"
        let m = 65.38
        return m
    if sym == "Br"
        let m = 79.904
        return m
    if sym == "Ag"
        let m = 107.868
        return m
    if sym == "I"
        let m = 126.904
        return m
    if sym == "Au"
        let m = 196.967
        return m
    let zero = 0.0
    return zero

// ---------------------------------------------------------------------------
// PRIVATE — character classification helpers
// ---------------------------------------------------------------------------

// Is the character an uppercase ASCII letter?
fn _is_upper(c: string) -> int
    let o = ord(c)
    if o >= 65
        if o <= 90
            return 1
    return 0

// Is the character a lowercase ASCII letter?
fn _is_lower(c: string) -> int
    let o = ord(c)
    if o >= 97
        if o <= 122
            return 1
    return 0

// Is the character an ASCII digit?
fn _is_digit(c: string) -> int
    let o = ord(c)
    if o >= 48
        if o <= 57
            return 1
    return 0

// ---------------------------------------------------------------------------
// PRIVATE — dict manipulation helpers for atom counts
// ---------------------------------------------------------------------------

// Add `count` to the tally for `sym` in a counts dict.
fn _tally_add(counts: dict, sym: string, count: int)
    if contains(counts, sym)
        let old = counts[sym]
        counts[sym] = old + count
    else
        counts[sym] = count

// Merge a child counts dict into a parent, multiplying child counts by mult.
fn _tally_merge(parent: dict, child: dict, mult: int)
    let keys = keys(child)
    for i in 0..len(keys)
        let sym = keys[i]
        let cnt = child[sym]
        _tally_add(parent, sym, cnt * mult)

// ---------------------------------------------------------------------------
// PRIVATE — parse an integer at position pos in formula.
// Returns [value, new_pos].  If no digit at pos returns [1, pos].
// ---------------------------------------------------------------------------
fn _parse_int(formula: string, n: int, pos: int) -> list
    let val = 0
    let p = pos
    let going = 1
    while going == 1
        if p >= n
            going = 0
        else
            let c = char_at(formula, p)
            if _is_digit(c) == 1
                let dv = ord(c) - 48
                val = val * 10 + dv
                p = p + 1
            else
                going = 0
    if val == 0
        val = 1
    let result = []
    push(result, val)
    push(result, p)
    return result

// ---------------------------------------------------------------------------
// PRIVATE — parse a group starting at pos (pos points PAST the opening '(').
// Returns [counts_dict, new_pos] where new_pos is past the closing ')' and
// any following digit multiplier.
// Handles one level of nesting (sufficient for common formulas).
// ---------------------------------------------------------------------------
fn _parse_group(formula: string, n: int, pos: int) -> list
    let counts = {}
    let p = pos
    let going = 1
    while going == 1
        if p >= n
            going = 0
        else
            let c = char_at(formula, p)
            if c == ")"
                p = p + 1
                going = 0
            else
                if _is_upper(c) == 1
                    // Start of element symbol: uppercase + optional lowercase
                    let sym = c
                    p = p + 1
                    if p < n
                        let c2 = char_at(formula, p)
                        if _is_lower(c2) == 1
                            sym = sym + c2
                            p = p + 1
                    // Parse count after symbol
                    let int_res = _parse_int(formula, n, p)
                    let cnt = int_res[0]
                    p = int_res[1]
                    _tally_add(counts, sym, cnt)
                else
                    // Skip unexpected characters gracefully
                    p = p + 1
    // Parse multiplier after ')'
    let mult_res = _parse_int(formula, n, p)
    let mult = mult_res[0]
    p = mult_res[1]
    // Apply multiplier to all group counts
    let gkeys = keys(counts)
    for i in 0..len(gkeys)
        let gsym = gkeys[i]
        let gc = counts[gsym]
        counts[gsym] = gc * mult
    let result = []
    push(result, counts)
    push(result, p)
    return result

// ---------------------------------------------------------------------------
// PRIVATE — parse a full formula into a counts dict.
// Handles parenthesised groups by calling _parse_group.
// ---------------------------------------------------------------------------
fn _parse_counts(formula: string) -> dict
    let counts = {}
    let n = len(formula)
    let p = 0
    while p < n
        let c = char_at(formula, p)
        if _is_upper(c) == 1
            // Element symbol start
            let sym = c
            p = p + 1
            if p < n
                let c2 = char_at(formula, p)
                if _is_lower(c2) == 1
                    sym = sym + c2
                    p = p + 1
            // Count following the symbol
            let int_res = _parse_int(formula, n, p)
            let cnt = int_res[0]
            p = int_res[1]
            _tally_add(counts, sym, cnt)
        else
            if c == "("
                p = p + 1
                let grp_res = _parse_group(formula, n, p)
                let grp_counts = grp_res[0]
                p = grp_res[1]
                _tally_merge(counts, grp_counts, 1)
            else
                // Skip unexpected chars
                p = p + 1
    return counts

// ---------------------------------------------------------------------------
// PUBLIC: parse_formula(formula) -> list of [symbol, count] pairs
// ---------------------------------------------------------------------------
fn parse_formula(formula: string) -> list
    let counts = _parse_counts(formula)
    let result = []
    let ks = keys(counts)
    for i in 0..len(ks)
        let sym = ks[i]
        let cnt = counts[sym]
        let pair = []
        push(pair, sym)
        push(pair, cnt)
        push(result, pair)
    return result

// ---------------------------------------------------------------------------
// PUBLIC: molar_mass(formula) -> float  (sum of atomic masses * counts)
// ---------------------------------------------------------------------------
fn molar_mass(formula: string) -> float
    let counts = _parse_counts(formula)
    let total = 0.0
    let ks = keys(counts)
    for i in 0..len(ks)
        let sym = ks[i]
        let cnt = counts[sym]
        let m = _elem_mass(sym)
        let contrib = m * (cnt * 1.0)
        total = total + contrib
    return total
