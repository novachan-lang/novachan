// std/chem/thermochem.nova — Thermochemistry formula functions.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float consts defined inside fn bodies (module-level float consts truncate to int).
//   * All intermediate results bound to named `let` variables.
//   * Never return a bare multi-term float expression — single-exit named result.
//   * ABS OF FLOAT: (if x < 0.0 then 0.0 - x else x) — NOT abs().
//   * Integer division: coerce with *1.0 to get float division.
//
// API (PREFIX: tc_):
//   tc_enthalpy_change(products_h, reactants_h) -> float   delta_H = products - reactants (kJ/mol)
//   tc_heat_q(mass, specific_heat, delta_t)     -> float   q = m * c * delta_T (J)
//   tc_hess_sum(delta_h_list)                   -> float   Hess's law: sum a list of delta_H values
//   tc_bond_energy_change(broken, formed)        -> float   delta_H = bonds_broken - bonds_formed (kJ/mol)

// Enthalpy change: delta_H = sum(H_products) - sum(H_reactants).
// Both arguments are sums already (caller aggregates per-species enthalpies).
fn tc_enthalpy_change(products_h: float, reactants_h: float) -> float
    let delta_h = products_h - reactants_h
    delta_h

// Heat transferred: q = m * c * delta_T
// mass in g, specific_heat in J/(g·K), delta_t in K or °C difference.
fn tc_heat_q(mass: float, specific_heat: float, delta_t: float) -> float
    let q = mass * specific_heat * delta_t
    q

// Hess's law summation: sum all delta_H steps in a reaction pathway.
// delta_h_list is a list of floats (each step's enthalpy change in kJ/mol).
fn tc_hess_sum(delta_h_list: list) -> float
    let n = len(delta_h_list)
    let total = 0.0
    let i = 0
    while i < n
        let val = delta_h_list[i]
        let fval = val * 1.0
        total = total + fval
        i = i + 1
    total

// Bond energy change: delta_H_rxn = bonds_broken - bonds_formed.
// bonds_broken = total energy needed to break reactant bonds (kJ/mol, positive).
// bonds_formed = total energy released forming product bonds (kJ/mol, positive).
// Result is negative for exothermic (more energy released than absorbed).
fn tc_bond_energy_change(broken: float, formed: float) -> float
    let delta_h = broken - formed
    delta_h
