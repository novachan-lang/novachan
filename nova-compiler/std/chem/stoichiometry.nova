// std/chem/stoichiometry.nova — Mole/mass/particle conversions and
// limiting-reactant analysis.
//
// Avogadro's number: 6.02214076e23 mol⁻¹ (CODATA 2018, exact by SI definition).
//
// FLOAT RULES obeyed:
//   * Float constants defined inside fn bodies (no module-level floats).
//   * All intermediate results bound to named lets.
//   * No bare multi-term float return — single-exit named result.
//   * abs(float): if x < 0.0 { 0.0 - x } else { x }
//   * Scientific 6.022e23 written as 6.022 * pow(10.0, 23.0).
//
// Public API:
//   avogadro()                                -> float  (6.02214076e23)
//   moles_from_mass(mass, molar_mass)         -> float  moles = mass / molar_mass
//   mass_from_moles(moles, molar_mass)        -> float  mass = moles * molar_mass
//   particles_from_moles(moles)               -> float  particles = moles * Nₐ
//   moles_from_particles(particles)           -> float  moles = particles / Nₐ
//   mole_ratio(a_coeff, b_coeff)              -> float  a_coeff / b_coeff
//   limiting_reactant(molesA, coeffA, molesB, coeffB) -> string  "A" or "B"

// avogadro — Avogadro's number in mol⁻¹.
fn avogadro() -> float
    let base = pow(10.0, 23.0)
    let na = 6.02214076 * base
    return na

// moles_from_mass — n = m / M
// mass      : mass in grams
// molar_mass: molar mass in g/mol
fn moles_from_mass(mass: float, molar_mass_val: float) -> float
    let n = mass / molar_mass_val
    return n

// mass_from_moles — m = n * M
// moles     : amount in mol
// molar_mass: molar mass in g/mol
fn mass_from_moles(moles: float, molar_mass_val: float) -> float
    let m = moles * molar_mass_val
    return m

// particles_from_moles — N = n * Nₐ
// Returns number of particles (atoms/molecules) as a float
// because it exceeds int range for typical quantities.
fn particles_from_moles(moles: float) -> float
    let na = avogadro()
    let n = moles * na
    return n

// moles_from_particles — n = N / Nₐ
fn moles_from_particles(particles: float) -> float
    let na = avogadro()
    let n = particles / na
    return n

// mole_ratio — stoichiometric ratio of reactant A to B.
// a_coeff and b_coeff are the stoichiometric coefficients from a balanced equation.
// Returns moles of A consumed per mole of B (a_coeff / b_coeff).
fn mole_ratio(a_coeff: float, b_coeff: float) -> float
    let ratio = a_coeff / b_coeff
    return ratio

// limiting_reactant — identifies which reactant runs out first.
// molesA / coeffA gives how many "reaction-equivalents" reactant A can support.
// molesB / coeffB gives the same for B.
// Whichever is smaller is the limiting reactant.
// Returns "A" or "B".
fn limiting_reactant(molesA: float, coeffA: float, molesB: float, coeffB: float) -> string
    let equivA = molesA / coeffA
    let equivB = molesB / coeffB
    if equivA < equivB
        return "A"
    return "B"
