// std/chem/elements.nova — Atomic data table for common elements.
//
// Covers H..Ca plus Fe, Cu, Zn, Ag, Au, Cl, Br, I, N, O, S, P, Na, K, Mg.
// All data from IUPAC 2021 standard atomic weights.
//
// FLOAT RULES obeyed:
//   * Float constants defined inside fn bodies only.
//   * Intermediate results bound to named lets.
//   * No multi-term bare float return expressions.
//   * abs(float): if x < 0.0 { 0.0 - x } else { x }
//
// Public API:
//   atomic_number(symbol: string) -> int      0 if unknown
//   atomic_mass(symbol: string)   -> float    0.0 if unknown
//   element_name(symbol: string)  -> string   "" if unknown
//   symbol_of(z: int)             -> string   "" if unknown

// atomic_number — returns proton count for element symbol.
// Returns 0 for unrecognised symbols.
fn atomic_number(symbol: string) -> int
    if symbol == "H"
        return 1
    if symbol == "He"
        return 2
    if symbol == "Li"
        return 3
    if symbol == "Be"
        return 4
    if symbol == "B"
        return 5
    if symbol == "C"
        return 6
    if symbol == "N"
        return 7
    if symbol == "O"
        return 8
    if symbol == "F"
        return 9
    if symbol == "Ne"
        return 10
    if symbol == "Na"
        return 11
    if symbol == "Mg"
        return 12
    if symbol == "Al"
        return 13
    if symbol == "Si"
        return 14
    if symbol == "P"
        return 15
    if symbol == "S"
        return 16
    if symbol == "Cl"
        return 17
    if symbol == "Ar"
        return 18
    if symbol == "K"
        return 19
    if symbol == "Ca"
        return 20
    if symbol == "Fe"
        return 26
    if symbol == "Cu"
        return 29
    if symbol == "Zn"
        return 30
    if symbol == "Br"
        return 35
    if symbol == "Ag"
        return 47
    if symbol == "I"
        return 53
    if symbol == "Au"
        return 79
    return 0

// atomic_mass — returns standard atomic weight in g/mol.
// Returns 0.0 for unrecognised symbols.
fn atomic_mass(symbol: string) -> float
    if symbol == "H"
        let m = 1.008
        return m
    if symbol == "He"
        let m = 4.0026
        return m
    if symbol == "Li"
        let m = 6.941
        return m
    if symbol == "Be"
        let m = 9.0122
        return m
    if symbol == "B"
        let m = 10.811
        return m
    if symbol == "C"
        let m = 12.011
        return m
    if symbol == "N"
        let m = 14.007
        return m
    if symbol == "O"
        let m = 15.999
        return m
    if symbol == "F"
        let m = 18.998
        return m
    if symbol == "Ne"
        let m = 20.180
        return m
    if symbol == "Na"
        let m = 22.990
        return m
    if symbol == "Mg"
        let m = 24.305
        return m
    if symbol == "Al"
        let m = 26.982
        return m
    if symbol == "Si"
        let m = 28.086
        return m
    if symbol == "P"
        let m = 30.974
        return m
    if symbol == "S"
        let m = 32.065
        return m
    if symbol == "Cl"
        let m = 35.453
        return m
    if symbol == "Ar"
        let m = 39.948
        return m
    if symbol == "K"
        let m = 39.098
        return m
    if symbol == "Ca"
        let m = 40.078
        return m
    if symbol == "Fe"
        let m = 55.845
        return m
    if symbol == "Cu"
        let m = 63.546
        return m
    if symbol == "Zn"
        let m = 65.38
        return m
    if symbol == "Br"
        let m = 79.904
        return m
    if symbol == "Ag"
        let m = 107.868
        return m
    if symbol == "I"
        let m = 126.904
        return m
    if symbol == "Au"
        let m = 196.967
        return m
    let zero = 0.0
    return zero

// element_name — returns IUPAC English name for a symbol.
// Returns "" for unrecognised symbols.
fn element_name(symbol: string) -> string
    if symbol == "H"
        return "Hydrogen"
    if symbol == "He"
        return "Helium"
    if symbol == "Li"
        return "Lithium"
    if symbol == "Be"
        return "Beryllium"
    if symbol == "B"
        return "Boron"
    if symbol == "C"
        return "Carbon"
    if symbol == "N"
        return "Nitrogen"
    if symbol == "O"
        return "Oxygen"
    if symbol == "F"
        return "Fluorine"
    if symbol == "Ne"
        return "Neon"
    if symbol == "Na"
        return "Sodium"
    if symbol == "Mg"
        return "Magnesium"
    if symbol == "Al"
        return "Aluminum"
    if symbol == "Si"
        return "Silicon"
    if symbol == "P"
        return "Phosphorus"
    if symbol == "S"
        return "Sulfur"
    if symbol == "Cl"
        return "Chlorine"
    if symbol == "Ar"
        return "Argon"
    if symbol == "K"
        return "Potassium"
    if symbol == "Ca"
        return "Calcium"
    if symbol == "Fe"
        return "Iron"
    if symbol == "Cu"
        return "Copper"
    if symbol == "Zn"
        return "Zinc"
    if symbol == "Br"
        return "Bromine"
    if symbol == "Ag"
        return "Silver"
    if symbol == "I"
        return "Iodine"
    if symbol == "Au"
        return "Gold"
    return ""

// symbol_of — returns element symbol for a given atomic number.
// Returns "" for unrecognised atomic numbers.
fn symbol_of(z: int) -> string
    if z == 1
        return "H"
    if z == 2
        return "He"
    if z == 3
        return "Li"
    if z == 4
        return "Be"
    if z == 5
        return "B"
    if z == 6
        return "C"
    if z == 7
        return "N"
    if z == 8
        return "O"
    if z == 9
        return "F"
    if z == 10
        return "Ne"
    if z == 11
        return "Na"
    if z == 12
        return "Mg"
    if z == 13
        return "Al"
    if z == 14
        return "Si"
    if z == 15
        return "P"
    if z == 16
        return "S"
    if z == 17
        return "Cl"
    if z == 18
        return "Ar"
    if z == 19
        return "K"
    if z == 20
        return "Ca"
    if z == 26
        return "Fe"
    if z == 29
        return "Cu"
    if z == 30
        return "Zn"
    if z == 35
        return "Br"
    if z == 47
        return "Ag"
    if z == 53
        return "I"
    if z == 79
        return "Au"
    return ""
