// std/chem/elements.nova — Atomic data table for common elements.
//
// Covers H..Ca plus Fe, Cu, Zn, Ag, Au, Cl, Br, I, N, O, S, P, Na, K, Mg.
// All data from IUPAC 2021 standard atomic weights.
//
// FLOAT RULES obeyed:
//   * Float constants defined inside fn bodies only.
//   * Intermediate results bound to named lets.
//   * No multi-term bare float return expressions.
//   * abs(float): if x < 0.0 { 0.0 - x } else { x }
//
// Public API:
//   atomic_number(symbol: string) -> int      0 if unknown
//   atomic_mass(symbol: string)   -> float    0.0 if unknown
//   element_name(symbol: string)  -> string   "" if unknown
//   symbol_of(z: int)             -> string   "" if unknown

// _atomic_numbers — proton-count lookup table, keyed by element symbol.
fn _atomic_numbers() -> dict
    return {"H": 1, "He": 2, "Li": 3, "Be": 4, "B": 5, "C": 6, "N": 7, "O": 8, "F": 9, "Ne": 10,
            "Na": 11, "Mg": 12, "Al": 13, "Si": 14, "P": 15, "S": 16, "Cl": 17, "Ar": 18, "K": 19, "Ca": 20,
            "Fe": 26, "Cu": 29, "Zn": 30, "Br": 35, "Ag": 47, "I": 53, "Au": 79}

// atomic_number — returns proton count for element symbol.
// Returns 0 for unrecognised symbols.
fn atomic_number(symbol: string) -> int
    let table = _atomic_numbers()
    table[symbol] if symbol in table else 0

// _atomic_masses — standard atomic weight (g/mol) lookup table, keyed by symbol.
fn _atomic_masses() -> dict
    return {"H": 1.008, "He": 4.0026, "Li": 6.941, "Be": 9.0122, "B": 10.811, "C": 12.011,
            "N": 14.007, "O": 15.999, "F": 18.998, "Ne": 20.180, "Na": 22.990, "Mg": 24.305,
            "Al": 26.982, "Si": 28.086, "P": 30.974, "S": 32.065, "Cl": 35.453, "Ar": 39.948,
            "K": 39.098, "Ca": 40.078, "Fe": 55.845, "Cu": 63.546, "Zn": 65.38, "Br": 79.904,
            "Ag": 107.868, "I": 126.904, "Au": 196.967}

// atomic_mass — returns standard atomic weight in g/mol.
// Returns 0.0 for unrecognised symbols.
fn atomic_mass(symbol: string) -> float
    let table = _atomic_masses()
    table[symbol] if symbol in table else 0.0

// _element_names — IUPAC English name lookup table, keyed by symbol.
fn _element_names() -> dict
    return {"H": "Hydrogen", "He": "Helium", "Li": "Lithium", "Be": "Beryllium", "B": "Boron",
            "C": "Carbon", "N": "Nitrogen", "O": "Oxygen", "F": "Fluorine", "Ne": "Neon",
            "Na": "Sodium", "Mg": "Magnesium", "Al": "Aluminum", "Si": "Silicon", "P": "Phosphorus",
            "S": "Sulfur", "Cl": "Chlorine", "Ar": "Argon", "K": "Potassium", "Ca": "Calcium",
            "Fe": "Iron", "Cu": "Copper", "Zn": "Zinc", "Br": "Bromine", "Ag": "Silver",
            "I": "Iodine", "Au": "Gold"}

// element_name — returns IUPAC English name for a symbol.
// Returns "" for unrecognised symbols.
fn element_name(symbol: string) -> string
    let table = _element_names()
    table[symbol] if symbol in table else ""

// _symbols_by_number — element symbol lookup table, keyed by str(atomic number).
fn _symbols_by_number() -> dict
    return {"1": "H", "2": "He", "3": "Li", "4": "Be", "5": "B", "6": "C", "7": "N", "8": "O",
            "9": "F", "10": "Ne", "11": "Na", "12": "Mg", "13": "Al", "14": "Si", "15": "P",
            "16": "S", "17": "Cl", "18": "Ar", "19": "K", "20": "Ca", "26": "Fe", "29": "Cu",
            "30": "Zn", "35": "Br", "47": "Ag", "53": "I", "79": "Au"}

// symbol_of — returns element symbol for a given atomic number.
// Returns "" for unrecognised atomic numbers.
fn symbol_of(z: int) -> string
    let table = _symbols_by_number()
    let k = str(z)
    table[k] if k in table else ""
