// std/physics/circuits_dc.nova — DC circuit formulas (Ohm's law, power, resistance).
// LEAF — imports NOTHING.
//
// Public API:
//   ohms_v(current, resistance)  -> float   V = I * R
//   ohms_i(voltage, resistance)  -> float   I = V / R
//   power_vi(voltage, current)   -> float   P = V * I
//   series_resistance(rs)        -> float   R_total = sum of list rs
//   parallel_two(r1, r2)         -> float   R = r1*r2 / (r1+r2)
//
// Units: SI (Volts, Amperes, Ohms, Watts).

// ohms_v — V = I * R (voltage from current and resistance).
fn ohms_v(current, resistance)
    let v = current * resistance
    return v

// ohms_i — I = V / R (current from voltage and resistance).
// Caller must ensure resistance != 0.0.
fn ohms_i(voltage, resistance)
    let i = voltage / resistance
    return i

// power_vi — P = V * I (power from voltage and current).
fn power_vi(voltage, current)
    let p = voltage * current
    return p

// series_resistance — R_total = R1 + R2 + ... + Rn (resistors in series).
// rs: list of float resistance values.
fn series_resistance(rs)
    let total = 0.0
    let n = len(rs)
    for i in 0..n
        let r = rs[i]
        total = total + r
    return total

// parallel_two — R = r1*r2 / (r1+r2) (two resistors in parallel).
// Caller must ensure r1 + r2 != 0.0.
fn parallel_two(r1, r2)
    let num = r1 * r2
    let den = r1 + r2
    let r = num / den
    return r
