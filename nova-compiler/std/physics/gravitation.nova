// std/physics/gravitation.nova — Newtonian gravitation formulas.
//
// FLOAT RULES obeyed:
//   - All literals have decimal points.
//   - 6.674e-11 written as 6.674 / pow(10.0, 11.0) (scientific literals may not parse).
//   - Sub-expressions bound to named lets before return.
//   - No multi-term float returns.
//
// API:
//   G()                        -> float  gravitational constant ~ 6.674e-11 N m^2 kg^-2
//   grav_force(m1, m2, r)      -> float  F = G * m1 * m2 / r^2
//   orbital_velocity(m, r)     -> float  v = sqrt(G * m / r)  (circular orbit)
//   escape_velocity(m, r)      -> float  v_e = sqrt(2 * G * m / r)

// Gravitational constant: 6.674 * 10^-11 N m^2 kg^-2
fn G() -> float
    let num = 6.674
    let den = pow(10.0, 11.0)
    let result = num / den
    result

// Newton's law of universal gravitation: F = G * m1 * m2 / r^2
fn grav_force(m1: float, m2: float, r: float) -> float
    let g = G()
    let gm1 = g * m1
    let gm1m2 = gm1 * m2
    let r2 = r * r
    let result = gm1m2 / r2
    result

// Orbital velocity for a circular orbit: v = sqrt(G * m / r)
fn orbital_velocity(m: float, r: float) -> float
    let g = G()
    let gm = g * m
    let gm_r = gm / r
    let result = sqrt(gm_r)
    result

// Escape velocity: v_e = sqrt(2 * G * m / r)
fn escape_velocity(m: float, r: float) -> float
    let g = G()
    let gm = g * m
    let two_gm = 2.0 * gm
    let two_gm_r = two_gm / r
    let result = sqrt(two_gm_r)
    result
