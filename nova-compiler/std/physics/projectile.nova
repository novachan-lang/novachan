// std/physics/projectile.nova
// Projectile motion formulas under constant gravity (g = 9.81 m/s^2).
// All float sub-expressions bound to named lets to avoid uninit-float-slot bug.
//
// Public API:
//   deg_to_rad(d)                  -> float  degrees to radians
//   proj_range(v, angle_deg)       -> float  horizontal range (m)
//   proj_max_height(v, angle_deg)  -> float  maximum height (m)
//   proj_time_of_flight(v, angle_deg) -> float  total time in air (s)

// deg_to_rad: convert degrees to radians.
fn deg_to_rad(d)
    let pi = 3.14159265358979
    let ratio = pi / 180.0
    let r = d * ratio
    r

// proj_range: Horizontal range of a projectile launched at speed v (m/s)
// and angle angle_deg (degrees) from the horizontal.
// Formula: R = v^2 * sin(2*theta) / g
fn proj_range(v, angle_deg)
    let g = 9.81
    let theta = deg_to_rad(angle_deg)
    let two_theta = 2.0 * theta
    let s2t = sin(two_theta)
    let vsq = v * v
    let num = vsq * s2t
    let r = num / g
    r

// proj_max_height: Maximum height reached by the projectile.
// Formula: H = v^2 * sin^2(theta) / (2*g)
fn proj_max_height(v, angle_deg)
    let g = 9.81
    let theta = deg_to_rad(angle_deg)
    let st = sin(theta)
    let st2 = st * st
    let vsq = v * v
    let num = vsq * st2
    let denom = 2.0 * g
    let h = num / denom
    h

// proj_time_of_flight: Total time the projectile is in the air.
// Formula: T = 2 * v * sin(theta) / g
fn proj_time_of_flight(v, angle_deg)
    let g = 9.81
    let theta = deg_to_rad(angle_deg)
    let st = sin(theta)
    let num = 2.0 * v * st
    let t = num / g
    t
