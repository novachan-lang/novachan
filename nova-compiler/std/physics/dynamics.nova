// std/physics/dynamics.nova — Newton's laws of motion (dynamics).
// LEAF — imports NOTHING.
//
// Public API:
//   force(m, a)          -> float   F = m * a  (Newton's Second Law)
//   weight(m)            -> float   W = m * g  (g = 9.81 m/s^2)
//   acceleration(f, m)   -> float   a = F / m
//   newton_second(m, a)  -> float   alias for force(m, a)
//
// g constant exposed as zero-arg fn for use in other modules.

// g — standard gravity constant (m/s^2).
fn g()
    return 9.81

// force — F = m * a.
fn force(m, a)
    let f = m * a
    return f

// weight — W = m * g.
fn weight(m)
    let gval = 9.81
    let w = m * gval
    return w

// acceleration — a = F / m.
// Caller must ensure m != 0.0.
fn acceleration(f, m)
    let a = f / m
    return a

// newton_second — F = m * a (alias, explicit Newton naming).
fn newton_second(m, a)
    let f = m * a
    return f
