// std/physics/rotation.nova — Rotational mechanics formulas.
//
// FLOAT RULES obeyed:
//   - All literals have decimal points.
//   - Float abs via if/else (not abs()).
//   - Sub-expressions bound to named lets before return.
//   - No multi-term float returns.
//
// API:
//   torque(f, r)                    -> float  tau = F * r
//   angular_velocity(theta, t)      -> float  omega = theta / t
//   centripetal_accel(v, r)         -> float  a_c = v^2 / r
//   moment_of_inertia_disk(m, r)    -> float  I = 0.5 * m * r^2
//   angular_momentum(i, w)          -> float  L = I * omega

fn torque(f: float, r: float) -> float
    let tau = f * r
    tau

fn angular_velocity(theta: float, t: float) -> float
    let omega = theta / t
    omega

fn centripetal_accel(v: float, r: float) -> float
    let v2 = v * v
    let ac = v2 / r
    ac

// Moment of inertia for a solid disk about its central axis: I = 0.5 * m * r^2
fn moment_of_inertia_disk(m: float, r: float) -> float
    let r2 = r * r
    let mr2 = m * r2
    let result = 0.5 * mr2
    result

fn angular_momentum(i: float, w: float) -> float
    let l = i * w
    l
