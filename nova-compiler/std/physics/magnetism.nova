// std/physics/magnetism.nova — electromagnetism formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   lorentz_force(charge, velocity, field)     -> float   F = q*v*B
//   force_on_wire(field, current, length)      -> float   F = B*I*L
//   solenoid_field(turns_per_m, current)       -> float   B = mu0 * n * I
//   cyclotron_frequency(charge, field, mass)   -> float   f = q*B / (2*pi*m)
//
// SI units: C, m/s, T, A, m, kg, Hz.

// lorentz_force — F = q*v*B (perpendicular, scalar form).
fn lorentz_force(charge, velocity, field)
    let f = charge * velocity * field
    return f

// force_on_wire — F = B*I*L (perpendicular, scalar form).
fn force_on_wire(field, current, length)
    let f = field * current * length
    return f

// solenoid_field — B = mu0 * n * I, mu0 = 4*pi*1e-7 = 1.2566e-6 T*m/A.
fn solenoid_field(turns_per_m, current)
    let mu0 = 1.2566 * pow(10.0, -6.0)
    let b = mu0 * turns_per_m * current
    return b

// cyclotron_frequency — f = q*B / (2*pi*m).
fn cyclotron_frequency(charge, field, mass)
    let pi = 3.14159265358979
    let two_pi_m = 2.0 * pi * mass
    let f = charge * field / two_pi_m
    return f
