// std/physics/blackbody.nova — Blackbody radiation formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   wien_peak_wavelength(temp)              -> float   lambda_max = b/T  (b=2.898e-3 m*K)
//   stefan_boltzmann_power(temp)            -> float   j = sigma*T^4  (sigma=5.67e-8 W/m^2/K^4)
//   radiated_power(emissivity, area, temp)  -> float   P = e*sigma*A*T^4
//
// SI units: temp in K, wavelength in m, power in W/m^2 (stefan) or W (radiated).

// wien_peak_wavelength — Wien displacement law: lambda_max = b / T.
// b = 2.898e-3 m*K  (written via pow to avoid scientific-notation literals).
fn wien_peak_wavelength(temp)
    let b = 2.898 * pow(10.0, 0.0 - 3.0)
    let lam = b / temp
    return lam

// stefan_boltzmann_power — Stefan-Boltzmann law irradiance: j = sigma * T^4.
// sigma = 5.67e-8 W/m^2/K^4.
fn stefan_boltzmann_power(temp)
    let sigma = 5.67 * pow(10.0, 0.0 - 8.0)
    let t4 = pow(temp, 4.0)
    let j = sigma * t4
    return j

// radiated_power — total radiated power from a grey body: P = e * sigma * A * T^4.
fn radiated_power(emissivity, area, temp)
    let sigma = 5.67 * pow(10.0, 0.0 - 8.0)
    let t4 = pow(temp, 4.0)
    let p = emissivity * sigma * area * t4
    return p
