// std/physics/circuits_ac.nova — AC circuit formulas (reactance, impedance, resonance).
// LEAF — imports NOTHING.
//
// Public API:
//   reactance_capacitive(freq, cap)    -> float   Xc = 1 / (2*pi*f*C)
//   reactance_inductive(freq, ind)     -> float   Xl = 2*pi*f*L
//   impedance(r, xl, xc)              -> float   Z = sqrt(R^2 + (Xl-Xc)^2)
//   resonant_frequency(ind, cap)       -> float   f0 = 1 / (2*pi*sqrt(L*C))
//
// Units: SI (Hz, Farads, Henrys, Ohms).
// PI = 3.14159265358979.

// pi — mathematical constant.
fn pi()
    return 3.14159265358979

// reactance_capacitive — Xc = 1 / (2 * pi * f * C).
// Caller must ensure freq != 0.0 and cap != 0.0.
fn reactance_capacitive(freq, cap)
    let two_pi = 2.0 * pi()
    let denom = two_pi * freq * cap
    let xc = 1.0 / denom
    return xc

// reactance_inductive — Xl = 2 * pi * f * L.
fn reactance_inductive(freq, ind)
    let two_pi = 2.0 * pi()
    let xl = two_pi * freq * ind
    return xl

// impedance — Z = sqrt(R^2 + (Xl - Xc)^2).
fn impedance(r, xl, xc)
    let r2 = r * r
    let x_diff = xl - xc
    let x2 = x_diff * x_diff
    let sum = r2 + x2
    let z = sqrt(sum)
    return z

// resonant_frequency — f0 = 1 / (2 * pi * sqrt(L * C)).
// Caller must ensure ind > 0.0 and cap > 0.0.
fn resonant_frequency(ind, cap)
    let lc = ind * cap
    let sq = sqrt(lc)
    let two_pi = 2.0 * pi()
    let denom = two_pi * sq
    let f0 = 1.0 / denom
    return f0
