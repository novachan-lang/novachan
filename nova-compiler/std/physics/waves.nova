// std/physics/waves.nova — wave mechanics formulas (SI units).
// LEAF — imports NOTHING.
//
// Public API:
//   wave_speed(freq, wavelength) -> float   v = f * lambda
//   wave_period(freq)            -> float   T = 1 / f
//   wavenumber(wavelength)       -> float   k = 2*pi / lambda
//   angular_frequency(freq)      -> float   omega = 2*pi * f

// wave_speed — v = f * lambda.
fn wave_speed(freq, wavelength)
    let v = freq * wavelength
    return v

// wave_period — T = 1 / f.
fn wave_period(freq)
    let t = 1.0 / freq
    return t

// wavenumber — k = 2*pi / lambda.
fn wavenumber(wavelength)
    let two_pi = 2.0 * 3.14159265358979
    let k = two_pi / wavelength
    return k

// angular_frequency — omega = 2*pi * f.
fn angular_frequency(freq)
    let two_pi = 2.0 * 3.14159265358979
    let omega = two_pi * freq
    return omega
