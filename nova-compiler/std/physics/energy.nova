// std/physics/energy.nova — Work, energy, and power formulas.
// LEAF — imports NOTHING.
//
// Public API:
//   kinetic(m, v)              -> float   KE = 0.5 * m * v^2
//   potential(m, h)            -> float   PE = m * g * h  (g = 9.81 m/s^2)
//   work(f, d)                 -> float   W = F * d
//   power(w, t)                -> float   P = W / t
//   work_energy_theorem(m, v1, v2) -> float  net work = delta_KE = 0.5*m*(v2^2 - v1^2)
//
// SI units throughout (J, W, m, s, kg, m/s).

// kinetic — KE = 0.5 * m * v^2.
fn kinetic(m, v)
    let v2 = v * v
    let ke = 0.5 * m * v2
    return ke

// potential — PE = m * g * h.
fn potential(m, h)
    let gval = 9.81
    let pe = m * gval * h
    return pe

// work — W = F * d.
fn work(f, d)
    let w = f * d
    return w

// power — P = W / t.
// Caller must ensure t != 0.0.
fn power(w, t)
    let p = w / t
    return p

// work_energy_theorem — net work = delta KE = 0.5 * m * (v2^2 - v1^2).
fn work_energy_theorem(m, v1, v2)
    let v1sq = v1 * v1
    let v2sq = v2 * v2
    let delta = v2sq - v1sq
    let net = 0.5 * m * delta
    return net
