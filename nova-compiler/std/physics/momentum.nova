// std/physics/momentum.nova — Linear momentum and collision formulas.
//
// FLOAT RULES obeyed:
//   - All literals have decimal points.
//   - Float abs via if/else (not abs()).
//   - Sub-expressions bound to named lets before return.
//   - No multi-term float returns.
//
// API:
//   momentum(m, v)                    -> float  p = m*v
//   impulse(f, t)                     -> float  J = F*t
//   elastic_final_v1(m1,v1,m2,v2)    -> float  1D elastic: v1' = ((m1-m2)*v1 + 2*m2*v2)/(m1+m2)
//   inelastic_final_v(m1,v1,m2,v2)   -> float  perfectly inelastic: v' = (m1*v1+m2*v2)/(m1+m2)

fn momentum(m: float, v: float) -> float
    let p = m * v
    p

fn impulse(f: float, t: float) -> float
    let j = f * t
    j

// 1D elastic collision: final velocity of object 1.
// v1' = ((m1 - m2)*v1 + 2*m2*v2) / (m1 + m2)
fn elastic_final_v1(m1: float, v1: float, m2: float, v2: float) -> float
    let diff_m = m1 - m2
    let sum_m = m1 + m2
    let term1 = diff_m * v1
    let term2 = 2.0 * m2
    let term3 = term2 * v2
    let num = term1 + term3
    let result = num / sum_m
    result

// Perfectly inelastic collision: combined final velocity.
// v' = (m1*v1 + m2*v2) / (m1 + m2)
fn inelastic_final_v(m1: float, v1: float, m2: float, v2: float) -> float
    let p1 = m1 * v1
    let p2 = m2 * v2
    let total_p = p1 + p2
    let total_m = m1 + m2
    let result = total_p / total_m
    result
