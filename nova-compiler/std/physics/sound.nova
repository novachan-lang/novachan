// std/physics/sound.nova — acoustics and sound formulas (SI units).
// LEAF — imports NOTHING.
//
// Public API:
//   speed_in_air(temp_c)                    -> float   speed = 331.3 + 0.606*T
//   beat_frequency(f1, f2)                  -> float   |f1 - f2|
//   intensity_db(intensity)                 -> float   dB = 10*log10(I/I0), I0=1e-12
//   doppler_observed(f, vsound, vobs, vsrc) -> float   f_obs = f*(v+vobs)/(v-vsrc)

// speed_in_air — speed of sound in air at temperature temp_c (Celsius).
// Formula: v = 331.3 + 0.606 * T
fn speed_in_air(temp_c)
    let correction = 0.606 * temp_c
    let speed = 331.3 + correction
    return speed

// beat_frequency — absolute difference between two frequencies.
fn beat_frequency(f1, f2)
    let diff = f1 - f2
    if diff < 0.0
        diff = -diff
    return diff

// intensity_db — sound intensity in decibels relative to threshold of hearing.
// I0 = 1e-12 W/m^2; dB = 10 * log10(I / I0)
fn intensity_db(intensity)
    let i0 = 1.0 * pow(10.0, -12.0)
    let ratio = intensity / i0
    let log_ratio = log(ratio) / log(10.0)
    let db = 10.0 * log_ratio
    return db

// doppler_observed — observed frequency due to Doppler effect.
// f_obs = f * (vsound + vobs) / (vsound - vsrc)
// vsound = speed of sound, vobs = observer velocity (+ toward source),
// vsrc  = source velocity (+ toward observer).
fn doppler_observed(f, vsound, vobs, vsrc)
    let num = vsound + vobs
    let den = vsound - vsrc
    let ratio = num / den
    let fobs = f * ratio
    return fobs
