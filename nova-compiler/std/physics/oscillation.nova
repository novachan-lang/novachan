// std/physics/oscillation.nova
// Simple harmonic motion and pendulum period formulas.
// All float sub-expressions bound to named lets to avoid uninit-float-slot bug.
//
// Public API:
//   PI()                  -> float  3.14159265358979
//   shm_period(m, k)      -> float  T = 2*pi*sqrt(m/k)  (mass-spring period, seconds)
//   shm_frequency(m, k)   -> float  f = 1/T             (oscillation frequency, Hz)
//   pendulum_period(length) -> float  T = 2*pi*sqrt(L/g)  (simple pendulum period)

// PI: the mathematical constant pi.
fn PI()
    let p = 3.14159265358979
    p

// shm_period: Period of a mass-spring simple harmonic oscillator.
// T = 2 * pi * sqrt(m / k)
// m = mass (kg), k = spring constant (N/m).
fn shm_period(m, k)
    let p = 3.14159265358979
    let ratio = m / k
    let sq = sqrt(ratio)
    let two_pi = 2.0 * p
    let t = two_pi * sq
    t

// shm_frequency: Frequency of a mass-spring SHM oscillator (Hz).
// f = 1 / T = 1 / (2*pi*sqrt(m/k))
fn shm_frequency(m, k)
    let t = shm_period(m, k)
    let f = 1.0 / t
    f

// pendulum_period: Period of a simple (small-angle) pendulum.
// T = 2 * pi * sqrt(L / g)
// length = pendulum length (m), g = 9.81 m/s^2.
fn pendulum_period(length)
    let g = 9.81
    let p = 3.14159265358979
    let ratio = length / g
    let sq = sqrt(ratio)
    let two_pi = 2.0 * p
    let t = two_pi * sq
    t
