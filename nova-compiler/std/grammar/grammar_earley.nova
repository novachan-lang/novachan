// ============================================================================
// NOVA Standard Library — std/grammar/grammar_earley
// ============================================================================
// Earley recognizer / parse-count for arbitrary CFGs (including left-recursive
// and ambiguous grammars).
//
// Grammar convention:
//   A nonterminal is a string whose first char is A-Z.
//   A terminal is anything else.
//   Productions: [lhs, rhs] where rhs is a list of symbol strings ([] = epsilon).
//   Grammar = list of productions.
//
// An Earley item is encoded as the string  "ruleIdx|dot|origin"
//   ruleIdx = index into prods (int)
//   dot     = position in rhs (0 = before first symbol)
//   origin  = chart-set index where this item was first created
//
// Chart[k] = sorted list of item-strings for position k (0..n).
// Chart[0] seeds from start predictions; Chart[n] is checked for acceptance.
//
// Public API (prefix gre_):
//   gre_recognize(prods, start, tokens)            -> bool(int)
//   gre_parse_count(prods, start, tokens)          -> int  (number of leftmost derivations)
//   gre_is_ambiguous_upto(prods, start, max_len)   -> bool(int)
//
// parse_count is bounded: if more than 1000 partial combinations are accumulated
// the count saturates at 1001 (signals ambiguity without full enumeration).
//
// is_ambiguous_upto generates all strings over the grammar's terminals up to
// length max_len and returns true if any has parse_count > 1.
//
// Self-contained: imports nothing.
// ============================================================================

// ── Symbol / item helpers ─────────────────────────────────────────────────────

// _gre_is_nt: true iff sym starts with A-Z.
fn _gre_is_nt(sym) -> int
    if len(sym) == 0
        return 0
    let c = slice(sym, 0, 1)
    if c >= "A" and c <= "Z"
        return 1
    return 0

// _gre_lst_has: linear search for string in list.
fn _gre_lst_has(lst, s) -> int
    1 if s in lst else 0

// _gre_lst_add: add s to lst only if absent.
fn _gre_lst_add(lst, s)
    if s not in lst
        push(lst, s)

// _gre_encode_item: encode ruleIdx, dot, origin as a single string.
fn _gre_encode_item(ruleIdx, dot, origin) -> string
    return "{ruleIdx}|{dot}|{origin}"

// _gre_decode_field: extract field 0/1/2 from encoded item string "a|b|c".
fn _gre_decode_field(item, field) -> int
    // Find positions of '|' chars
    let n = len(item)
    let pipe1 = -1
    let pipe2 = -1
    for i in 0..n
        let ch = slice(item, i, i + 1)
        if ch == "|"
            if pipe1 == -1
                pipe1 = i
            else if pipe2 == -1
                pipe2 = i
    let s = ""
    if field == 0
        s = slice(item, 0, pipe1)
    else if field == 1
        s = slice(item, pipe1 + 1, pipe2)
    else if field == 2
        s = slice(item, pipe2 + 1, n)
    // Convert s to int
    let neg = 0
    let start = 0
    if len(s) > 0 and slice(s, 0, 1) == "-"
        neg = 1
        start = 1
    let val = 0
    for j in start..len(s)
        let dv = ord(slice(s, j, j + 1)) - 48
        val = val * 10 + dv
    if neg == 1
        val = -val
    return val

// ── Core Earley chart builder ─────────────────────────────────────────────────

// _gre_build_chart: run the Earley algorithm and return the chart (list of item-lists).
// Chart has n+1 entries (positions 0..n).
fn _gre_build_chart(prods, start, tokens) -> list
    let n = len(tokens)
    // Initialise chart: (n+1) empty item-lists
    let chart = [[] for ci in 0..(n + 1)]
    // Seed Chart[0]: all productions for start symbol
    for pi in 0..len(prods)
        let p = prods[pi]
        if p[0] == start
            let item = _gre_encode_item(pi, 0, 0)
            _gre_lst_add(chart[0], item)
    // Process each chart position
    for k in 0..(n + 1)
        let pos = 0
        while pos < len(chart[k])
            let it = chart[k][pos]
            let ri = _gre_decode_field(it, 0)
            let dot = _gre_decode_field(it, 1)
            let orig = _gre_decode_field(it, 2)
            let rhs = prods[ri][1]
            let rlen = len(rhs)
            if dot == rlen
                // COMPLETE: item is fully matched (dot at end of rhs)
                let comp_lhs = prods[ri][0]
                // Find all items in chart[orig] with dot pointing at comp_lhs
                // (chart[orig] can grow while we scan it, e.g. orig == k, so this
                //  stays a while loop that re-reads len() each iteration)
                let ji = 0
                while ji < len(chart[orig])
                    let jt = chart[orig][ji]
                    let jri = _gre_decode_field(jt, 0)
                    let jdot = _gre_decode_field(jt, 1)
                    let jorig = _gre_decode_field(jt, 2)
                    let jrhs = prods[jri][1]
                    let jrlen = len(jrhs)
                    if jdot < jrlen and jrhs[jdot] == comp_lhs
                        let new_item = _gre_encode_item(jri, jdot + 1, jorig)
                        _gre_lst_add(chart[k], new_item)
                    ji += 1
            else
                let next_sym = rhs[dot]
                if _gre_is_nt(next_sym) == 1
                    // PREDICT: add all productions for next_sym at position k
                    for pj in 0..len(prods)
                        if prods[pj][0] == next_sym
                            let new_item = _gre_encode_item(pj, 0, k)
                            _gre_lst_add(chart[k], new_item)
                else
                    // SCAN: if next_sym == tokens[k], advance to chart[k+1]
                    if k < n and tokens[k] == next_sym
                        let new_item = _gre_encode_item(ri, dot + 1, orig)
                        _gre_lst_add(chart[k + 1], new_item)
            pos += 1
    return chart

// gre_recognize: true iff tokens is in the language of (prods, start).
// An item (start -> rhs •, 0) in Chart[n] means acceptance.
fn gre_recognize(prods, start, tokens) -> int
    let n = len(tokens)
    let chart = _gre_build_chart(prods, start, tokens)
    // Check chart[n] for a complete start item with origin 0
    for i in 0..len(chart[n])
        let it = chart[n][i]
        let ri = _gre_decode_field(it, 0)
        let dot = _gre_decode_field(it, 1)
        let orig = _gre_decode_field(it, 2)
        if orig == 0 and prods[ri][0] == start and dot == len(prods[ri][1])
            return 1
    return 0

// ── Parse counting via chart DP ───────────────────────────────────────────────
//
// We count derivations bottom-up after building the chart.
// count[(A, i, j)] = number of parse trees for nonterminal A spanning tokens[i..j-1].
// Stored in a dict keyed by "A|i|j".
// For terminals: count[(a, i, i+1)] = 1 if tokens[i]==a, else 0.
// For nonterminals: count[(A, i, j)] = sum over all rules A->X1..Xk and
//   all ways to split [i,j] into k contiguous sub-spans where each Xi derives its span.
//
// This is O(n^3 * |G|) with memoization — feasible for the small grammars in KATs.
// Saturation cap at 1001 to prevent overflow on highly ambiguous grammars.

fn _gre_ckey(sym, i, j) -> string
    return "{sym}|{i}|{j}"

// _gre_cnt_rhs: count ways to derive rhs[dot..] over tokens[i..j-1].
// Uses a memo dict (passed by reference as a list containing one dict).
fn _gre_cnt_rhs(prods, rhs, dot, i, j, memo_box, tokens) -> int
    let rlen = len(rhs)
    // Base: dot reached end of rhs
    if dot == rlen
        return 1 if i == j else 0
    // Only one symbol left: must span exactly [i,j-1] i.e. length 1
    let sym = rhs[dot]
    let memo = memo_box[0]
    if _gre_is_nt(sym) == 1
        // Try all split points m in [i .. j]
        // (each remaining symbol needs at least 1 token, except nullable — simplified here:
        //  we allow m=i when we also allow empty derivations via the chart)
        let total = 0
        for m in i..(j + 1)
            // Count for sym spanning [i,m]
            let sym_key = _gre_ckey(sym, i, m)
            let sym_cnt = memo[sym_key] if sym_key in memo else 0
            // Count for remaining rhs[dot+1..] spanning [m,j]
            let rest_cnt = _gre_cnt_rhs(prods, rhs, dot + 1, m, j, memo_box, tokens)
            total += sym_cnt * rest_cnt
            if total > 1001
                total = 1001
        return total
    else if dot == rlen - 1
        // Terminal, last symbol: must match tokens[i] and i+1 == j
        if i + 1 == j and i < len(tokens) and tokens[i] == sym
            return 1
        return 0
    else
        // Terminal, not last: consume one token at i, continue with rest over [i+1..j]
        if i < len(tokens) and tokens[i] == sym
            return _gre_cnt_rhs(prods, rhs, dot + 1, i + 1, j, memo_box, tokens)
        return 0

// _gre_fill_counts: fill memo for all nonterminals and spans using chart information.
// Only fills (A,i,j) that are reachable (i.e., A->*... spans [i,j] in the chart).
fn _gre_fill_counts(prods, tokens, chart, memo_box)
    let n = len(tokens)
    // We iterate over all (i,j) pairs with i<=j, j from 0..n
    // For each pair, check which nonterminals appear completed in chart[j] with origin i
    // For each such (A, i, j): count = sum over rules A->rhs of count_rhs(rhs, i, j)
    // Fill in order of increasing span length
    for length in 0..(n + 1)
        for si in 0..(n - length + 1)
            let ej = si + length
            // Find completed nonterminals for span [si, ej]
            // A completed item (A->rhs•, si) in chart[ej] means A spans [si, ej]
            // But we also need to count the actual ways
            // Collect the nonterminals to evaluate at this span
            let nts_here = []
            for ci in 0..len(chart[ej])
                let it = chart[ej][ci]
                let ri = _gre_decode_field(it, 0)
                let dot = _gre_decode_field(it, 1)
                let orig = _gre_decode_field(it, 2)
                if orig == si and dot == len(prods[ri][1])
                    _gre_lst_add(nts_here, prods[ri][0])
            // For each nonterminal A in nts_here, compute count(A, si, ej)
            for ni in 0..len(nts_here)
                let A = nts_here[ni]
                let key = _gre_ckey(A, si, ej)
                let memo = memo_box[0]
                if key not in memo
                    // Sum over all rules for A
                    let total = 0
                    for pi in 0..len(prods)
                        let p = prods[pi]
                        if p[0] == A
                            let cnt = _gre_cnt_rhs(prods, p[1], 0, si, ej, memo_box, tokens)
                            total += cnt
                            if total > 1001
                                total = 1001
                    let memo2 = memo_box[0]
                    memo2[key] = total

// gre_parse_count: count distinct parse trees for (prods, start, tokens).
// Returns 0 if not recognized, or the number of parse trees (capped at 1001).
fn gre_parse_count(prods, start, tokens) -> int
    let n = len(tokens)
    let chart = _gre_build_chart(prods, start, tokens)
    // Check recognition first
    let recognized = 0
    for ci in 0..len(chart[n])
        let it = chart[n][ci]
        let ri = _gre_decode_field(it, 0)
        let dot = _gre_decode_field(it, 1)
        let orig = _gre_decode_field(it, 2)
        if orig == 0 and prods[ri][0] == start and dot == len(prods[ri][1])
            recognized = 1
    if recognized == 0
        return 0
    // Fill memo
    let memo_box = [{}]
    _gre_fill_counts(prods, tokens, chart, memo_box)
    // Return count(start, 0, n)
    let key = _gre_ckey(start, 0, n)
    let memo = memo_box[0]
    if key in memo
        return memo[key]
    return 0

// ── Ambiguity detection ───────────────────────────────────────────────────────

// _gre_collect_terminals: collect all terminal symbols from grammar.
fn _gre_collect_terminals(prods) -> list
    let terms = []
    for i in 0..len(prods)
        let rhs = prods[i][1]
        for j in 0..len(rhs)
            let sym = rhs[j]
            if _gre_is_nt(sym) == 0
                _gre_lst_add(terms, sym)
    return terms

// _gre_gen_strings: generate all token lists over terminals up to max_len.
// BFS; returns list of token-lists.
fn _gre_gen_strings(terms, max_len) -> list
    let result = []
    push(result, [])
    if max_len == 0
        return result
    let queue = []
    push(queue, [])
    // queue grows while we scan it (BFS worklist), so it stays a while loop.
    let qi = 0
    while qi < len(queue)
        let cur = queue[qi]
        if len(cur) < max_len
            for ti in 0..len(terms)
                let new_toks = []
                for ci in 0..len(cur)
                    push(new_toks, cur[ci])
                push(new_toks, terms[ti])
                push(result, new_toks)
                push(queue, new_toks)
        qi += 1
    return result

// gre_is_ambiguous_upto: true iff some string of length <= max_len has > 1 parse.
fn gre_is_ambiguous_upto(prods, start, max_len) -> int
    let terms = _gre_collect_terminals(prods)
    if len(terms) == 0
        return 0
    let all_strs = _gre_gen_strings(terms, max_len)
    for i in 0..len(all_strs)
        let toks = all_strs[i]
        let cnt = gre_parse_count(prods, start, toks)
        if cnt > 1
            return 1
    return 0
