// ============================================================================
// NOVA Standard Library — std/grammar/grammar_cnf
// ============================================================================
// Convert an arbitrary CFG to Chomsky Normal Form (CNF).
//
// A SYMBOL is a string.  A nonterminal is any string whose FIRST character
// is in A-Z (this module uses generated names like "N1","N2" etc. so the
// single-letter restriction is RELAXED for generated symbols — any string
// starting with A-Z is treated as a nonterminal internally).
// A terminal is a string whose first character is NOT A-Z (or the string "").
// EPSILON (empty derivation) = rhs is the empty list [].
//
// Productions: [lhs, rhs] where rhs is a list of symbol strings.
// Grammar = list of productions.  Start symbol passed separately.
//
// Public API (prefix grcnf_):
//   grcnf_convert(prods, start) -> [new_prods, new_start]
//   grcnf_is_cnf(prods)        -> bool(int)
//
// Conversion steps (Dragon Book / Hopcroft-Ullman order):
//   1. Fresh start S0 -> start
//   2. Eliminate epsilon productions (except possibly S0->eps if start was nullable)
//   3. Eliminate unit productions (A -> B, B a nonterminal)
//   4. Replace terminals in long RHS (length>=2) with fresh nonterminals
//   5. Break RHS of length>2 into binary chains
//
// Self-contained: imports nothing.
// ============================================================================

// ── Symbol helpers ───────────────────────────────────────────────────────────

// grcnf_is_nt: true iff sym starts with an uppercase letter A-Z.
fn grcnf_is_nt(sym) -> int
    if len(sym) == 0
        return 0
    let c = slice(sym, 0, 1)
    let ok = 0
    if c == "A" or c == "B" or c == "C" or c == "D" or c == "E"
        ok = 1
    if c == "F" or c == "G" or c == "H" or c == "I" or c == "J"
        ok = 1
    if c == "K" or c == "L" or c == "M" or c == "N" or c == "O"
        ok = 1
    if c == "P" or c == "Q" or c == "R" or c == "S" or c == "T"
        ok = 1
    if c == "U" or c == "V" or c == "W" or c == "X" or c == "Y"
        ok = 1
    if c == "Z"
        ok = 1
    return ok

// _grcnf_lst_has: linear membership test for string in list.
fn _grcnf_lst_has(lst, s) -> int
    for i in 0..len(lst)
        if lst[i] == s
            return 1
    return 0

// _grcnf_lst_add: add s to lst if absent (no-dup).
fn _grcnf_lst_add(lst, s)
    if _grcnf_lst_has(lst, s) == 0
        push(lst, s)

// _grcnf_rhs_eq: true iff two rhs lists are identical.
fn _grcnf_rhs_eq(a, b) -> int
    if len(a) != len(b)
        return 0
    for i in 0..len(a)
        if a[i] != b[i]
            return 0
    return 1

// _grcnf_prod_dup: true iff [lhs,rhs] already in prods.
fn _grcnf_prod_dup(prods, lhs, rhs) -> int
    for i in 0..len(prods)
        let p = prods[i]
        if p[0] == lhs
            if _grcnf_rhs_eq(p[1], rhs) == 1
                return 1
    return 0

// _grcnf_add_prod: add [lhs,rhs] to prods if not duplicate, not lhs->lhs unit.
fn _grcnf_add_prod(prods, lhs, rhs)
    // Skip self-unit: A->A
    if len(rhs) == 1
        if rhs[0] == lhs
            return null
    if _grcnf_prod_dup(prods, lhs, rhs) == 0
        let np = [lhs, rhs]
        push(prods, np)

// ── Step 2: Find nullable nonterminals ──────────────────────────────────────

// _grcnf_find_nullable: fixpoint to find all nonterminals that can derive epsilon.
fn _grcnf_find_nullable(prods) -> list
    let nullable = []
    // Seed: any A -> [] (direct epsilon production)
    for i in 0..len(prods)
        let p = prods[i]
        if len(p[1]) == 0
            _grcnf_lst_add(nullable, p[0])
    // Fixpoint: A -> X1 X2 ... Xk where all Xi are nullable
    let changed = 1
    while changed == 1
        changed = 0
        for j in 0..len(prods)
            let p = prods[j]
            let lhs = p[0]
            let rhs = p[1]
            // Check if all rhs symbols are nullable nonterminals
            let all_null = 1
            let k = 0
            while k < len(rhs)
                let sym = rhs[k]
                if grcnf_is_nt(sym) == 0
                    all_null = 0
                if _grcnf_lst_has(nullable, sym) == 0
                    all_null = 0
                k = k + 1
            if len(rhs) == 0
                all_null = 0
            if all_null == 1
                if _grcnf_lst_has(nullable, lhs) == 0
                    _grcnf_lst_add(nullable, lhs)
                    changed = 1
    return nullable

// _grcnf_eps_subsets: given rhs and which positions are nullable,
// enumerate all subsets obtained by omitting nullable symbols (at least one omitted,
// never the empty result for non-start). Returns list of rhs lists.
// Uses iterative bit-masking over nullable positions.
fn _grcnf_eps_subsets(rhs, nullable) -> list
    // Identify nullable positions
    let null_pos = []
    for i in 0..len(rhs)
        if grcnf_is_nt(rhs[i]) == 1
            if _grcnf_lst_has(nullable, rhs[i]) == 1
                push(null_pos, i)
    let ncount = len(null_pos)
    let result = []
    // Iterate over all non-zero subsets of null_pos (2^ncount - 1 masks)
    let total = 1
    for bi in 0..ncount
        total = total * 2
    // mask 0 = keep all (original, don't add here — caller keeps original)
    // mask 1..total-1 = omit some nullable positions
    for mask in 1..total
        // Build new rhs omitting positions in null_pos where bit is set
        let new_rhs = []
        let j = 0
        while j < len(rhs)
            // Is position j flagged for omission?
            let omit = 0
            let ki = 0
            while ki < ncount
                if null_pos[ki] == j
                    // Check bit ki in mask
                    let bit = 1
                    let shi = 0
                    while shi < ki
                        bit = bit * 2
                        shi = shi + 1
                    if (mask / bit) - ((mask / bit) / 2) * 2 == 1
                        omit = 1
                ki = ki + 1
            if omit == 0
                push(new_rhs, rhs[j])
            j = j + 1
        // Only add non-empty results (empty -> handled as epsilon separately)
        if len(new_rhs) > 0
            push(result, new_rhs)
    return result

// ── Step 2: Eliminate epsilon productions ───────────────────────────────────

// _grcnf_remove_eps: eliminate all epsilon productions.
// Returns new prod list.  If orig_start was nullable, caller decides about S0->eps.
fn _grcnf_remove_eps(prods, nullable) -> list
    let out = []
    for i in 0..len(prods)
        let p = prods[i]
        let lhs = p[0]
        let rhs = p[1]
        // Keep non-epsilon productions
        if len(rhs) > 0
            _grcnf_add_prod(out, lhs, rhs)
            // Add all subset-omission variants
            let subs = _grcnf_eps_subsets(rhs, nullable)
            let si = 0
            while si < len(subs)
                _grcnf_add_prod(out, lhs, subs[si])
                si = si + 1
        // Skip epsilon productions (they are removed)
    return out

// ── Step 3: Eliminate unit productions ──────────────────────────────────────

// _grcnf_unit_closure: find all B such that A ->* B via unit productions.
fn _grcnf_unit_closure(prods, A) -> list
    let reachable = []
    _grcnf_lst_add(reachable, A)
    let changed = 1
    while changed == 1
        changed = 0
        for i in 0..len(reachable)
            let X = reachable[i]
            let j = 0
            while j < len(prods)
                let p = prods[j]
                if p[0] == X
                    let rhs = p[1]
                    if len(rhs) == 1
                        if grcnf_is_nt(rhs[0]) == 1
                            if _grcnf_lst_has(reachable, rhs[0]) == 0
                                _grcnf_lst_add(reachable, rhs[0])
                                changed = 1
                j = j + 1
    return reachable

// _grcnf_remove_units: eliminate all unit productions.
fn _grcnf_remove_units(prods) -> list
    // Collect all nonterminals
    let nts = []
    for i in 0..len(prods)
        let lhs = prods[i][0]
        _grcnf_lst_add(nts, lhs)
    let out = []
    // For each nonterminal A, for each B in unit-closure(A),
    // add all non-unit productions of B under lhs A.
    for ai in 0..len(nts)
        let A = nts[ai]
        let closure = _grcnf_unit_closure(prods, A)
        let ci = 0
        while ci < len(closure)
            let B = closure[ci]
            let pi = 0
            while pi < len(prods)
                let p = prods[pi]
                if p[0] == B
                    let rhs = p[1]
                    // Add if not a unit production
                    let is_unit = 0
                    if len(rhs) == 1
                        if grcnf_is_nt(rhs[0]) == 1
                            is_unit = 1
                    if is_unit == 0
                        _grcnf_add_prod(out, A, rhs)
                pi = pi + 1
            ci = ci + 1
    return out

// ── Steps 4+5: Terminal replacement and binarization ────────────────────────

// _grcnf_term_name: generate a fresh nonterminal name for terminal sym.
// Uses "Nt_" prefix followed by the terminal string (sanitized).
// The generated name starts with 'N' (uppercase) -> treated as nonterminal.
fn _grcnf_term_name(sym, counter_box) -> string
    // counter_box is a 1-element list holding the current counter int
    let n = counter_box[0]
    counter_box[0] = n + 1
    return "Nt" + str(n)

// _grcnf_bin_name: generate a fresh nonterminal name for binarization.
fn _grcnf_bin_name(counter_box) -> string
    let n = counter_box[0]
    counter_box[0] = n + 1
    return "Nb" + str(n)

// _grcnf_term_replace: for each long-RHS (len>=2) production,
// replace every terminal t with a fresh nonterminal Nt, adding Nt->t.
// Returns new productions list.
fn _grcnf_term_replace(prods, counter_box) -> list
    let out = []
    // Map terminal -> nonterminal name
    let term_map = {}
    for i in 0..len(prods)
        let p = prods[i]
        let lhs = p[0]
        let rhs = p[1]
        if len(rhs) <= 1
            // Unit or epsilon: keep as-is
            _grcnf_add_prod(out, lhs, rhs)
        else
            // Long: replace terminals
            let new_rhs = []
            let j = 0
            while j < len(rhs)
                let sym = rhs[j]
                if grcnf_is_nt(sym) == 0
                    // Terminal: get or create a wrapper nonterminal
                    if contains(term_map, sym) == 0
                        let nm = _grcnf_term_name(sym, counter_box)
                        term_map[sym] = nm
                        // Add Nt -> sym production
                        let tsym = sym
                        let term_rhs = [tsym]
                        _grcnf_add_prod(out, nm, term_rhs)
                    push(new_rhs, term_map[sym])
                else
                    push(new_rhs, sym)
                j = j + 1
            _grcnf_add_prod(out, lhs, new_rhs)
    return out

// _grcnf_binarize: break all RHS of length > 2 into binary chains.
// A -> X1 X2 X3 ... Xk becomes A -> X1 N1, N1 -> X2 N2, ..., N(k-2) -> X(k-1) Xk
fn _grcnf_binarize(prods, counter_box) -> list
    let out = []
    for i in 0..len(prods)
        let p = prods[i]
        let lhs = p[0]
        let rhs = p[1]
        if len(rhs) <= 2
            _grcnf_add_prod(out, lhs, rhs)
        else
            // Chain decomposition
            // Build list of [current_lhs, remaining_rhs] pairs to process
            let cur_lhs = lhs
            let cur_rhs = rhs
            let going = 1
            while going == 1
                if len(cur_rhs) <= 2
                    _grcnf_add_prod(out, cur_lhs, cur_rhs)
                    going = 0
                else
                    // Split: cur_lhs -> cur_rhs[0], fresh_N
                    // fresh_N -> cur_rhs[1:]
                    let fresh = _grcnf_bin_name(counter_box)
                    let first_sym = cur_rhs[0]
                    let pair_rhs = [first_sym, fresh]
                    _grcnf_add_prod(out, cur_lhs, pair_rhs)
                    // Build tail
                    let tail = []
                    let ti = 1
                    while ti < len(cur_rhs)
                        push(tail, cur_rhs[ti])
                        ti = ti + 1
                    cur_lhs = fresh
                    cur_rhs = tail
    return out

// ── Main conversion ──────────────────────────────────────────────────────────

// grcnf_convert: convert grammar (prods, start) to Chomsky Normal Form.
// Returns [new_prods, new_start] where new_start is "S0" (the fresh start).
// CNF allows S0 -> epsilon if original start was nullable.
fn grcnf_convert(prods, start) -> list
    let counter_box = [0]
    // Step 1: fresh start S0 -> start
    let s0 = "S0"
    let init_rhs = [start]
    let p0 = [s0, init_rhs]
    let working = []
    push(working, p0)
    for i in 0..len(prods)
        push(working, prods[i])
    // Step 2: find nullable, remove epsilon
    let nullable = _grcnf_find_nullable(working)
    let after_eps = _grcnf_remove_eps(working, nullable)
    // If original start was nullable, add S0 -> epsilon
    if _grcnf_lst_has(nullable, start) == 1
        let eps_rhs = []
        _grcnf_add_prod(after_eps, s0, eps_rhs)
    // Step 3: remove unit productions
    let after_units = _grcnf_remove_units(after_eps)
    // Step 4: replace terminals in long RHS
    let after_term = _grcnf_term_replace(after_units, counter_box)
    // Step 5: binarize
    let after_bin = _grcnf_binarize(after_term, counter_box)
    let result = [after_bin, s0]
    return result

// ── CNF validator ────────────────────────────────────────────────────────────

// grcnf_is_cnf: true iff every production is A->BC (two nonterminals) or
// A->a (one terminal), or A->epsilon only for the distinguished start symbol
// (caller must decide if eps is allowed for start).
// This validator accepts A->[] (epsilon) for any lhs (lenient about start).
fn grcnf_is_cnf(prods) -> int
    let i = 0
    let valid = 1
    while i < len(prods)
        let p = prods[i]
        let lhs = p[0]
        let rhs = p[1]
        if grcnf_is_nt(lhs) == 0
            valid = 0
        let rlen = len(rhs)
        if rlen == 0
            // epsilon: allowed for start only — we allow it leniently here
            let dummy = 0
        else
            if rlen == 1
                // Must be a terminal (not a nonterminal)
                if grcnf_is_nt(rhs[0]) == 1
                    valid = 0
            else
                if rlen == 2
                    // Both must be nonterminals
                    if grcnf_is_nt(rhs[0]) == 0
                        valid = 0
                    if grcnf_is_nt(rhs[1]) == 0
                        valid = 0
                else
                    valid = 0
        i = i + 1
    return valid
