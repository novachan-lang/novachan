// std/grammar/grammar_core — Core grammar representation utilities.
//
// SYMBOL CONVENTION:
//   A NONTERMINAL is a string that is exactly ONE uppercase letter A-Z.
//   Everything else (multi-char strings, lowercase, punctuation) is a TERMINAL.
//   EPSILON is represented by an EMPTY right-hand-side list [].
//
// PRODUCTION: 2-element list [lhs, rhs]
//   lhs  = nonterminal string
//   rhs  = list of symbol strings (possibly [])
//
// GRAMMAR: list of productions.
//
// All public functions are prefixed grc_.

// Return 1 if sym is a nonterminal (single uppercase letter A-Z), else 0.
fn grc_is_nonterminal(sym) -> int
    if len(sym) != 1
        return 0
    let c = sym[0]
    if c >= "A" and c <= "Z"
        return 1
    return 0

// Return 1 if sym is a terminal (not a nonterminal), else 0.
fn grc_is_terminal(sym) -> int
    if grc_is_nonterminal(sym) == 1
        return 0
    return 1

// Insertion-sort a list of strings in-place (ascending lexicographic).
fn grc_sort_strings(lst)
    let n = len(lst)
    let i = 1
    while i < n
        let key = lst[i]
        let j = i - 1
        while j >= 0 and lst[j] > key
            lst[j + 1] = lst[j]
            j = j - 1
        lst[j + 1] = key
        i = i + 1

// Deduplicate a SORTED list of strings in-place; returns deduped list.
fn grc_dedup_sorted(lst) -> list
    let result = []
    let n = len(lst)
    let i = 0
    while i < n
        if i == 0
            push(result, lst[i])
        else
            if lst[i] != lst[i - 1]
                push(result, lst[i])
        i = i + 1
    return result

// Return 1 if sorted string list lst contains s (binary search), else 0.
fn grc_list_contains(lst, s) -> int
    let lo = 0
    let hi = len(lst) - 1
    while lo <= hi
        let mid = (lo + hi) / 2
        if lst[mid] == s
            return 1
        if lst[mid] < s
            lo = mid + 1
        else
            hi = mid - 1
    return 0

// Insert s into a sorted+deduped string list; maintains sort+dedup invariant.
// Rebuilds the list segment; returns 0 (unit).
fn grc_insert_sorted(lst, s)
    let n = len(lst)
    // Binary search for insertion point.
    let lo = 0
    let hi = n
    while lo < hi
        let mid = (lo + hi) / 2
        if lst[mid] < s
            lo = mid + 1
        else
            hi = mid
    // lo = insertion index; check for duplicate.
    if lo < n and lst[lo] == s
        return 0
    // Shift elements right: overwrite from right to lo+1, then set lst[lo]=s.
    // First extend the list by one slot.
    push(lst, s)
    // Now shift elements right.
    let i = n
    while i > lo
        lst[i] = lst[i - 1]
        i = i - 1
    lst[lo] = s
    return 0

// Return sorted unique list of nonterminal symbols appearing in prods
// (as lhs OR as a single-uppercase-letter appearing in any rhs).
fn grc_nonterminals(prods) -> list
    let result = []
    let n = len(prods)
    let i = 0
    while i < n
        let prod = prods[i]
        let lhs = prod[0]
        if grc_is_nonterminal(lhs) == 1
            grc_insert_sorted(result, lhs)
        let rhs = prod[1]
        let j = 0
        while j < len(rhs)
            let sym = rhs[j]
            if grc_is_nonterminal(sym) == 1
                grc_insert_sorted(result, sym)
            j = j + 1
        i = i + 1
    return result

// Return sorted unique list of terminal symbols appearing in any rhs.
fn grc_terminals(prods) -> list
    let result = []
    let n = len(prods)
    let i = 0
    while i < n
        let prod = prods[i]
        let rhs = prod[1]
        let j = 0
        while j < len(rhs)
            let sym = rhs[j]
            if grc_is_terminal(sym) == 1
                grc_insert_sorted(result, sym)
            j = j + 1
        i = i + 1
    return result

// Return sorted unique list of ALL symbols (nonterminals + terminals) in prods.
fn grc_symbols(prods) -> list
    let result = []
    let n = len(prods)
    let i = 0
    while i < n
        let prod = prods[i]
        let lhs = prod[0]
        grc_insert_sorted(result, lhs)
        let rhs = prod[1]
        let j = 0
        while j < len(rhs)
            grc_insert_sorted(result, rhs[j])
            j = j + 1
        i = i + 1
    return result

// Return list of all rhs alternatives (each a list of symbols) for nonterminal nt.
fn grc_productions_for(prods, nt) -> list
    let result = []
    let n = len(prods)
    let i = 0
    while i < n
        let prod = prods[i]
        if prod[0] == nt
            push(result, prod[1])
        i = i + 1
    return result

// Return the number of productions (alternatives) for nonterminal nt.
fn grc_alt_count(prods, nt) -> int
    let cnt = 0
    let n = len(prods)
    let i = 0
    while i < n
        if prods[i][0] == nt
            cnt = cnt + 1
        i = i + 1
    return cnt
