// std/grammar/grammar_follow — FOLLOW-set computation for context-free grammars.
//
// Representation:
//   A SYMBOL is a string.  A NONTERMINAL is a single uppercase letter A..Z.
//   EPSILON is represented as "" (empty string) in FIRST sets.
//   "$"  is the end-of-input marker placed in FOLLOW(start).
//   A PRODUCTION is [lhs, rhs] where lhs is a nonterminal string and
//   rhs is a list of symbol strings ([] = epsilon production).
//   A GRAMMAR is a list of productions.
//   Sets are SORTED + DEDUPED lists of strings.
//
// Public API:
//   grfo_follow_sets(prods, start) -> dict  (nonterminal -> sorted set list)
//   grfo_follow(prods, start, nt)  -> list  (sorted set for one nonterminal)

// _grfo_is_nt: true iff symbol is a single uppercase letter (nonterminal).
fn _grfo_is_nt(sym)
    if len(sym) != 1
        return 0
    let c = sym[0]
    if c >= "A" and c <= "Z"
        return 1
    return 0

// _grfo_set_contains: check membership in a sorted list set.
fn _grfo_set_contains(s, v)
    let i = 0
    let n = len(s)
    while i < n
        if s[i] == v
            return 1
        i += 1
    return 0

// _grfo_set_insert: insert v into sorted list set in-place (sorted by string compare).
fn _grfo_set_insert(s, v)
    if _grfo_set_contains(s, v) == 1
        return 0
    let n = len(s)
    for i in 0..n
        if v < s[i]
            // Insert before position i — build new list
            let newl = []
            let j = 0
            while j < i
                newl.push(s[j])
                j += 1
            newl.push(v)
            while j < n
                newl.push(s[j])
                j += 1
            // Copy back into s
            let k = 0
            while k < len(newl)
                if k < n
                    s[k] = newl[k]
                else
                    s.push(newl[k])
                k += 1
            return 1
    s.push(v)
    return 1

// _grfo_set_union: merge src into dst; return 1 if dst changed.
fn _grfo_set_union(dst, src)
    let changed = 0
    let i = 0
    let n = len(src)
    while i < n
        let added = _grfo_set_insert(dst, src[i])
        if added == 1
            changed = 1
        i += 1
    return changed

// _grfo_collect_nts: collect all nonterminals in grammar into a sorted set.
fn _grfo_collect_nts(prods)
    let nts = []
    let i = 0
    let n = len(prods)
    while i < n
        let prod = prods[i]
        let lhs = prod[0]
        _grfo_set_insert(nts, lhs)
        let rhs = prod[1]
        let j = 0
        let m = len(rhs)
        while j < m
            let sym = rhs[j]
            if _grfo_is_nt(sym) == 1
                _grfo_set_insert(nts, sym)
            j += 1
        i += 1
    return nts

// _grfo_nullable: compute which nonterminals can derive epsilon; return dict nt->1.
fn _grfo_nullable(prods)
    let nullable = {}
    let changed = 1
    while changed == 1
        let changed = 0
        let i = 0
        let n = len(prods)
        while i < n
            let prod = prods[i]
            let lhs = prod[0]
            let rhs = prod[1]
            if lhs not in nullable
                // Check if all symbols in rhs are nullable (empty rhs = epsilon production)
                let all_null = 1
                let j = 0
                let m = len(rhs)
                while j < m
                    let sym = rhs[j]
                    if _grfo_is_nt(sym) == 1
                        if sym not in nullable
                            all_null = 0
                    else
                        all_null = 0
                    j += 1
                if all_null == 1
                    nullable[lhs] = 1
                    changed = 1
            i += 1
    return nullable

// _grfo_first_of_seq: FIRST of a sequence of symbols (given nullable dict and first_map).
// Returns a sorted list; includes "" iff the entire suffix can derive epsilon.
fn _grfo_first_of_seq(seq_syms, nullable, first_map)
    let result = []
    let all_nullable = 1
    let i = 0
    let n = len(seq_syms)
    while i < n
        let sym = seq_syms[i]
        if _grfo_is_nt(sym) == 1
            // Add FIRST(sym) \ {epsilon} to result
            if sym in first_map
                let fsym = first_map[sym]
                let j = 0
                let m2 = len(fsym)
                while j < m2
                    if fsym[j] != ""
                        _grfo_set_insert(result, fsym[j])
                    j += 1
            // If sym is not nullable, stop propagating
            if sym not in nullable
                all_nullable = 0
                i = n  // break
        else
            // Terminal: add it and stop
            _grfo_set_insert(result, sym)
            all_nullable = 0
            i = n  // break
        i += 1
    if all_nullable == 1
        _grfo_set_insert(result, "")
    return result

// _grfo_first_sets: compute FIRST sets for all nonterminals; return dict nt -> sorted list.
fn _grfo_first_sets(prods)
    let nullable = _grfo_nullable(prods)
    let nts = _grfo_collect_nts(prods)
    // Initialize all FIRST sets to empty
    let first_map = {}
    let k = 0
    let kn = len(nts)
    while k < kn
        let empty_list = []
        first_map[nts[k]] = empty_list
        k += 1
    // Fixpoint: repeat until no change
    let changed = 1
    while changed == 1
        let changed = 0
        let i = 0
        let n = len(prods)
        while i < n
            let prod = prods[i]
            let lhs = prod[0]
            let rhs = prod[1]
            // Compute FIRST of rhs
            let add = _grfo_first_of_seq(rhs, nullable, first_map)
            let dst = first_map[lhs]
            let c2 = _grfo_set_union(dst, add)
            if c2 == 1
                changed = 1
            i += 1
    return first_map

// grfo_follow_sets: compute FOLLOW sets for every nonterminal.
// Rule 1: $ in FOLLOW(start).
// Rule 2: For A->...B beta..., add FIRST(beta)\{eps} to FOLLOW(B).
// Rule 3: For A->...B (or B in position where beta is nullable), add FOLLOW(A) to FOLLOW(B).
// Fixpoint until stable.
fn grfo_follow_sets(prods, start)
    let nullable = _grfo_nullable(prods)
    let first_map = _grfo_first_sets(prods)
    let nts = _grfo_collect_nts(prods)
    // Initialize all FOLLOW sets to empty
    let follow_map = {}
    let k = 0
    let kn = len(nts)
    while k < kn
        let empty_list = []
        follow_map[nts[k]] = empty_list
        k += 1
    // Rule 1: $ in FOLLOW(start)
    let start_set = follow_map[start]
    _grfo_set_insert(start_set, "$")
    // Fixpoint
    let changed = 1
    while changed == 1
        let changed = 0
        let i = 0
        let n = len(prods)
        while i < n
            let prod = prods[i]
            let lhs = prod[0]
            let rhs = prod[1]
            let rlen = len(rhs)
            for j in 0..rlen
                let sym = rhs[j]
                if _grfo_is_nt(sym) == 1
                    // Compute FIRST of the suffix rhs[j+1..]
                    let suffix = []
                    let jj = j + 1
                    while jj < rlen
                        suffix.push(rhs[jj])
                        jj += 1
                    let first_suffix = _grfo_first_of_seq(suffix, nullable, first_map)
                    let dst = follow_map[sym]
                    // Rule 2: add FIRST(suffix) \ {eps}
                    let fi = 0
                    let fn2 = len(first_suffix)
                    while fi < fn2
                        if first_suffix[fi] != ""
                            let added = _grfo_set_insert(dst, first_suffix[fi])
                            if added == 1
                                changed = 1
                        fi += 1
                    // Rule 3: if suffix can derive eps, add FOLLOW(lhs)
                    if _grfo_set_contains(first_suffix, "") == 1
                        let flhs = follow_map[lhs]
                        let c2 = _grfo_set_union(dst, flhs)
                        if c2 == 1
                            changed = 1
            i += 1
    return follow_map

// grfo_follow: return the FOLLOW set (sorted list) for a single nonterminal.
fn grfo_follow(prods, start, nt)
    let fm = grfo_follow_sets(prods, start)
    if nt in fm
        return fm[nt]
    return []
