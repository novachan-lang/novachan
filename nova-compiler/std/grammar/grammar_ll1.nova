// std/grammar/grammar_ll1 — LL(1) predictive parsing table and parser.
//
// Same grammar representation as grammar_follow:
//   PRODUCTION = [lhs, rhs];  GRAMMAR = list of productions.
//   Terminals: any string that is NOT a single uppercase letter A..Z.
//   "$" = end-of-input;  "" = epsilon marker in FIRST sets.
//
// Public API:
//   grll_is_ll1(prods, start) -> int  (1 iff grammar has no LL(1) conflicts)
//   grll_table(prods, start)  -> list of [nt, terminal, rhs]  (predictive table entries)
//   grll_parse(prods, start, tokens) -> int  (1 = accepted, 0 = rejected)
//
// All FIRST/FOLLOW/nullable logic is implemented internally (self-contained).

// _grll_is_nt: true iff symbol is a single uppercase letter.
fn _grll_is_nt(sym)
    if len(sym) != 1
        return 0
    let c = sym[0]
    if c >= "A" and c <= "Z"
        return 1
    return 0

// _grll_set_contains: membership test in a sorted list set.
fn _grll_set_contains(s, v)
    let i = 0
    let n = len(s)
    while i < n
        if s[i] == v
            return 1
        i = i + 1
    return 0

// _grll_set_insert: insert v into a sorted list set; return 1 if changed.
fn _grll_set_insert(s, v)
    if _grll_set_contains(s, v) == 1
        return 0
    let n = len(s)
    let i = 0
    while i < n
        if v < s[i]
            let newl = []
            let j = 0
            while j < i
                newl.push(s[j])
                j = j + 1
            newl.push(v)
            while j < n
                newl.push(s[j])
                j = j + 1
            let k = 0
            while k < len(newl)
                if k < n
                    s[k] = newl[k]
                else
                    s.push(newl[k])
                k = k + 1
            return 1
        i = i + 1
    s.push(v)
    return 1

// _grll_set_union: union src into dst; return 1 if dst changed.
fn _grll_set_union(dst, src)
    let changed = 0
    let i = 0
    let n = len(src)
    while i < n
        let added = _grll_set_insert(dst, src[i])
        if added == 1
            changed = 1
        i = i + 1
    return changed

// _grll_collect_nts: collect all nonterminals appearing in grammar into a sorted list.
fn _grll_collect_nts(prods)
    let nts = []
    let i = 0
    let n = len(prods)
    while i < n
        let prod = prods[i]
        let lhs = prod[0]
        _grll_set_insert(nts, lhs)
        let rhs = prod[1]
        let j = 0
        let m = len(rhs)
        while j < m
            let sym = rhs[j]
            if _grll_is_nt(sym) == 1
                _grll_set_insert(nts, sym)
            j = j + 1
        i = i + 1
    return nts

// _grll_nullable: compute nullable nonterminals; return dict nt->1.
fn _grll_nullable(prods)
    let nullable = {}
    let changed = 1
    while changed == 1
        let changed = 0
        let i = 0
        let n = len(prods)
        while i < n
            let prod = prods[i]
            let lhs = prod[0]
            let rhs = prod[1]
            if not contains(nullable, lhs)
                let all_null = 1
                let j = 0
                let m = len(rhs)
                while j < m
                    let sym = rhs[j]
                    if _grll_is_nt(sym) == 1
                        if not contains(nullable, sym)
                            all_null = 0
                    else
                        all_null = 0
                    j = j + 1
                if all_null == 1
                    nullable[lhs] = 1
                    changed = 1
            i = i + 1
    return nullable

// _grll_first_of_seq: FIRST of a list of symbols given nullable dict and first_map.
fn _grll_first_of_seq(seq_syms, nullable, first_map)
    let result = []
    let all_nullable = 1
    let i = 0
    let n = len(seq_syms)
    while i < n
        let sym = seq_syms[i]
        if _grll_is_nt(sym) == 1
            if contains(first_map, sym)
                let fsym = first_map[sym]
                let j = 0
                let m2 = len(fsym)
                while j < m2
                    if fsym[j] != ""
                        _grll_set_insert(result, fsym[j])
                    j = j + 1
            if not contains(nullable, sym)
                all_nullable = 0
                i = n
        else
            _grll_set_insert(result, sym)
            all_nullable = 0
            i = n
        i = i + 1
    if all_nullable == 1
        _grll_set_insert(result, "")
    return result

// _grll_first_sets: compute FIRST sets for all nonterminals.
fn _grll_first_sets(prods)
    let nullable = _grll_nullable(prods)
    let nts = _grll_collect_nts(prods)
    let first_map = {}
    let k = 0
    let kn = len(nts)
    while k < kn
        let empty_list = []
        first_map[nts[k]] = empty_list
        k = k + 1
    let changed = 1
    while changed == 1
        let changed = 0
        let i = 0
        let n = len(prods)
        while i < n
            let prod = prods[i]
            let lhs = prod[0]
            let rhs = prod[1]
            let add = _grll_first_of_seq(rhs, nullable, first_map)
            let dst = first_map[lhs]
            let c2 = _grll_set_union(dst, add)
            if c2 == 1
                changed = 1
            i = i + 1
    return first_map

// _grll_follow_sets: compute FOLLOW sets; return dict nt -> sorted list.
fn _grll_follow_sets(prods, start)
    let nullable = _grll_nullable(prods)
    let first_map = _grll_first_sets(prods)
    let nts = _grll_collect_nts(prods)
    let follow_map = {}
    let k = 0
    let kn = len(nts)
    while k < kn
        let empty_list = []
        follow_map[nts[k]] = empty_list
        k = k + 1
    let start_set = follow_map[start]
    _grll_set_insert(start_set, "$")
    let changed = 1
    while changed == 1
        let changed = 0
        let i = 0
        let n = len(prods)
        while i < n
            let prod = prods[i]
            let lhs = prod[0]
            let rhs = prod[1]
            let rlen = len(rhs)
            let j = 0
            while j < rlen
                let sym = rhs[j]
                if _grll_is_nt(sym) == 1
                    let suffix = []
                    let jj = j + 1
                    while jj < rlen
                        suffix.push(rhs[jj])
                        jj = jj + 1
                    let first_suffix = _grll_first_of_seq(suffix, nullable, first_map)
                    let dst = follow_map[sym]
                    let fi = 0
                    let fn2 = len(first_suffix)
                    while fi < fn2
                        if first_suffix[fi] != ""
                            let added = _grll_set_insert(dst, first_suffix[fi])
                            if added == 1
                                changed = 1
                        fi = fi + 1
                    if _grll_set_contains(first_suffix, "") == 1
                        let flhs = follow_map[lhs]
                        let c2 = _grll_set_union(dst, flhs)
                        if c2 == 1
                            changed = 1
                j = j + 1
            i = i + 1
    return follow_map

// _grll_tkey: build a table key string "NT|terminal".
fn _grll_tkey(nt, term)
    return nt + "|" + term

// grll_table: build the LL(1) predictive parse table.
// Returns a list of [nt, terminal, rhs] entries.
// For each production A->alpha, for each a in FIRST(alpha)\{eps},
//   add entry [A, a, alpha].
// If eps in FIRST(alpha), for each b in FOLLOW(A), add entry [A, b, alpha].
fn grll_table(prods, start)
    let nullable = _grll_nullable(prods)
    let first_map = _grll_first_sets(prods)
    let follow_map = _grll_follow_sets(prods, start)
    let entries = []
    let i = 0
    let n = len(prods)
    while i < n
        let prod = prods[i]
        let lhs = prod[0]
        let rhs = prod[1]
        let first_rhs = _grll_first_of_seq(rhs, nullable, first_map)
        // For each terminal in FIRST(rhs) (excluding eps)
        let j = 0
        let flen = len(first_rhs)
        while j < flen
            let term = first_rhs[j]
            if term != ""
                let entry = [lhs, term, rhs]
                entries.push(entry)
            j = j + 1
        // If eps in FIRST(rhs), add entries for FOLLOW(lhs)
        if _grll_set_contains(first_rhs, "") == 1
            let flhs = follow_map[lhs]
            let fi = 0
            let fln = len(flhs)
            while fi < fln
                let entry2 = [lhs, flhs[fi], rhs]
                entries.push(entry2)
                fi = fi + 1
        i = i + 1
    return entries

// grll_is_ll1: return 1 iff the grammar has no LL(1) conflicts.
// A conflict exists iff any (nt, terminal) pair has more than one production entry.
fn grll_is_ll1(prods, start)
    let entries = grll_table(prods, start)
    let seen = {}
    let i = 0
    let n = len(entries)
    while i < n
        let entry = entries[i]
        let nt = entry[0]
        let term = entry[1]
        let k = _grll_tkey(nt, term)
        if contains(seen, k)
            return 0
        seen[k] = 1
        i = i + 1
    return 1

// _grll_build_tmap: build a dict from "NT|terminal" -> rhs for fast lookup.
fn _grll_build_tmap(prods, start)
    let entries = grll_table(prods, start)
    let tmap = {}
    let i = 0
    let n = len(entries)
    while i < n
        let entry = entries[i]
        let nt = entry[0]
        let term = entry[1]
        let rhs = entry[2]
        let k = _grll_tkey(nt, term)
        tmap[k] = rhs
        i = i + 1
    return tmap

// grll_parse: table-driven LL(1) predictive parse.
// tokens = list of terminal strings (do NOT include "$").
// Returns 1 iff the token string is accepted by the grammar.
fn grll_parse(prods, start, tokens)
    let tmap = _grll_build_tmap(prods, start)
    // Stack: list, top = last element. Initialize with [$, start].
    let stack = []
    stack.push("$")
    stack.push(start)
    // Append "$" sentinel to tokens
    let input = []
    let ti = 0
    let tn = len(tokens)
    while ti < tn
        input.push(tokens[ti])
        ti = ti + 1
    input.push("$")
    let pos = 0
    let ok = 1
    while ok == 1
        let slen = len(stack)
        if slen == 0
            ok = 0
        if ok == 1
            let top = stack[slen - 1]
            let cur = input[pos]
            if top == "$"
                if cur == "$"
                    // Accept: stack bottom matches end of input
                    return 1
                else
                    return 0
            if _grll_is_nt(top) == 1
                // Nonterminal: look up in table
                let k = _grll_tkey(top, cur)
                if not contains(tmap, k)
                    return 0
                let rhs = tmap[k]
                // Pop the nonterminal
                let newstack = []
                let si = 0
                while si < slen - 1
                    newstack.push(stack[si])
                    si = si + 1
                stack = newstack
                // Push rhs in reverse so leftmost symbol ends up on top
                let rlen = len(rhs)
                let ri = rlen - 1
                while ri >= 0
                    stack.push(rhs[ri])
                    ri = ri - 1
            else
                // Terminal: must match current input token
                if top != cur
                    return 0
                // Pop stack top and advance input
                let newstack2 = []
                let si2 = 0
                while si2 < slen - 1
                    newstack2.push(stack[si2])
                    si2 = si2 + 1
                stack = newstack2
                pos = pos + 1
    return 0
