// std/backtracking/bt_combinations_k.nova — all k-combinations of integers 1..n.
// LEAF — imports NOTHING.
//
// Public API:
//   ck_solve(n, k)  -> list  all k-combinations of [1..n] in ascending (lex) order
//   ck_count(n, k)  -> int   C(n, k) — binomial coefficient

// _ck_snap — copy the first `depth` elements of slot into a fresh list
fn _ck_snap(slot, depth) -> any
    let out = []
    let i = 0
    while i < depth
        push(out, slot[i])
        i = i + 1
    out

// _ck_gen — recursive backtracking generating all k-combinations of [1..n].
// slot = pre-allocated working array of size k; slot[0..depth-1] are chosen so far.
// start = smallest integer we may still choose (choices are start..n).
fn _ck_gen(n, k, depth, start, slot, result)
    if depth == k
        push(result, _ck_snap(slot, depth))
        return null
    let need = k - depth
    let i = start
    while i <= n - need + 1
        slot[depth] = i
        _ck_gen(n, k, depth + 1, i + 1, slot, result)
        i = i + 1

// ck_solve — all k-combinations of the integers 1..n in ascending order.
// ck_solve(n, 0) = [[]] (one empty combination).
// ck_solve(n, k) = [] if k > n or k < 0.
fn ck_solve(n: int, k: int) -> any
    let result = []
    if k < 0
        return result
    if k > n
        return result
    if k == 0
        push(result, [])
        return result
    let slot = []
    let i = 0
    while i < k
        push(slot, 0)
        i = i + 1
    _ck_gen(n, k, 0, 1, slot, result)
    result

// _ck_nCr — binomial coefficient C(n, k) via multiplicative formula.
fn _ck_nCr(n: int, k: int) -> int
    if k < 0
        return 0
    if k > n
        return 0
    let r = k
    if n - k < r
        r = n - k
    let res = 1
    let i = 0
    while i < r
        res = res * (n - i)
        res = res / (i + 1)
        i = i + 1
    res

// ck_count — C(n, k): number of k-combinations of integers 1..n.
fn ck_count(n: int, k: int) -> int
    _ck_nCr(n, k)
