// std/backtracking/bt_combination_sum.nova — combinations with unlimited reuse summing to target.
// LEAF — imports NOTHING. INTEGER candidates and target only.
//
// Public API:
//   cs_solve(candidates, target) -> list  all unique non-decreasing combinations summing to target
//   cs_count(candidates, target) -> int   count of such combinations

// _cs_dup_n — copy first n elements of src into a new list
fn _cs_dup_n(src, n)
    let dst = [src[i] for i in 0..n]
    dst

// _cs_dup — shallow copy of a whole list
fn _cs_dup(src)
    _cs_dup_n(src, len(src))

// _cs_sort — insertion sort in ascending order in-place
fn _cs_sort(arr)
    let n = len(arr)
    for i in 1..n
        let key = arr[i]
        let j = i - 1
        while j >= 0 and arr[j] > key
            arr[j + 1] = arr[j]
            j -= 1
        arr[j + 1] = key

// _cs_dedup_sorted — remove consecutive duplicates from a sorted list; returns new list
fn _cs_dedup_sorted(arr)
    let out = []
    let n = len(arr)
    let i = 0
    while i < n
        if i == 0 or arr[i] != arr[i - 1]
            push(out, arr[i])
        i += 1
    out

// _cs_bt — backtracking core; slot is a pre-allocated working array of size max_depth.
// depth = current number of elements chosen; rem = remaining sum to reach.
// Explores candidates[start..] at each level, reusing the same candidate (i stays same in recursion).
fn _cs_bt(candidates, start, rem, slot, depth, results)
    if rem == 0
        push(results, _cs_dup_n(slot, depth))
        return null
    let n = len(candidates)
    let i = start
    while i < n
        let c = candidates[i]
        if c <= rem
            slot[depth] = c
            _cs_bt(candidates, i, rem - c, slot, depth + 1, results)
        i += 1

// cs_solve — all unique non-decreasing combinations of candidates summing to target.
// Each candidate may appear any number of times. Candidates may contain duplicates
// (duplicates are collapsed). Returns [] if target <= 0 and target != 0.
fn cs_solve(candidates, target) -> any
    let results = []
    if target < 0
        return results
    if target == 0
        push(results, [])
        return results
    let sorted = _cs_dup(candidates)
    _cs_sort(sorted)
    let uniq = _cs_dedup_sorted(sorted)
    // max elements in any combo = target (when smallest candidate is 1)
    let slot = [0 for si in 0..target]
    _cs_bt(uniq, 0, target, slot, 0, results)
    results

// cs_count — number of unique combinations of candidates summing to target.
fn cs_count(candidates, target) -> int
    len(cs_solve(candidates, target))
