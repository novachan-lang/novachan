// std/backtracking/bt_letter_combos.nova — phone-keypad letter combinations.
// LEAF — imports NOTHING.
//
// Mapping: 2->abc 3->def 4->ghi 5->jkl 6->mno 7->pqrs 8->tuv 9->wxyz
//
// Public API:
//   lc_solve(digits)  -> list   all letter combination strings (depth-first, choices ascending)
//   lc_count(digits)  -> int    total number of combinations (product of key lengths)

// _lc_letters — return the letter string for a single digit character.
// Returns "" for unrecognised digits (0, 1, or non-digit).
fn _lc_letters(d: string) -> string
    if d == "2"
        return "abc"
    if d == "3"
        return "def"
    if d == "4"
        return "ghi"
    if d == "5"
        return "jkl"
    if d == "6"
        return "mno"
    if d == "7"
        return "pqrs"
    if d == "8"
        return "tuv"
    if d == "9"
        return "wxyz"
    ""

// _lc_rec — backtracking: append one letter per digit position and collect into result.
// digits is the full input string; pos is the current index into it.
// current is the combination built so far as a string.
fn _lc_rec(digits: string, pos: int, current: string, result)
    let n = len(digits)
    if pos == n
        push(result, current)
        return null
    let d = char_at(digits, pos)
    let letters = _lc_letters(d)
    let m = len(letters)
    if m == 0
        return null
    let i = 0
    while i < m
        let ch = char_at(letters, i)
        _lc_rec(digits, pos + 1, current + ch, result)
        i = i + 1

// lc_solve — all letter combinations for the digit string (depth-first, letters ascending).
// lc_solve("") returns [] (no combinations for empty input).
fn lc_solve(digits: string) -> any
    let result = []
    if len(digits) == 0
        return result
    _lc_rec(digits, 0, "", result)
    result

// lc_count — number of combinations = product of key lengths for each digit.
// lc_count("") = 0. Unrecognised digits contribute factor 0 (no combos possible).
fn lc_count(digits: string) -> int
    let n = len(digits)
    if n == 0
        return 0
    let total = 1
    let i = 0
    while i < n
        let d = char_at(digits, i)
        let letters = _lc_letters(d)
        let m = len(letters)
        total = total * m
        i = i + 1
    total
