// std/backtracking/bt_generate_parens.nova — all valid strings of n pairs of parentheses.
// LEAF — imports NOTHING. Pure string backtracking.
//
// Public API:
//   gp_solve(n)    -> list  all valid balanced-paren strings for n pairs (depth-first)
//   gp_count(n)    -> int   number of valid strings = C(n), the n-th Catalan number
//
// Algorithm: backtracking with (open_remaining, close_remaining) counters.
// At each position we can place '(' if open_remaining > 0; ')'
// if close_remaining > open_remaining (i.e. open count > close count so far).
// This directly tracks open=remaining '(' budget, close=remaining ')' budget.

// _gp_bt — recursive backtracking core.
// open = '(' tokens still allowed; close = ')' tokens still allowed; cur = partial string; out = result list.
fn _gp_bt(open: int, close: int, cur: string, out: list)
    if open == 0 and close == 0
        push(out, cur)
        return null
    if open > 0
        _gp_bt(open - 1, close + 1, cur + "(", out)
    if close > 0
        _gp_bt(open, close - 1, cur + ")", out)
    return null

// gp_solve — all valid balanced-paren strings of exactly n pairs.
// Returns them in depth-first order: '(' choices before ')' choices at each step.
// gp_solve(0) = [""], gp_solve(1) = ["()"], len(gp_solve(3)) = 5.
fn gp_solve(n: int) -> list
    let out = []
    if n <= 0
        push(out, "")
        return out
    _gp_bt(n, 0, "", out)
    out

// gp_count — n-th Catalan number C(n): counts valid paren strings of n pairs.
// Sequence: C(0)=1, C(1)=1, C(2)=2, C(3)=5, C(4)=14, C(5)=42.
// Iterative recurrence: C(k) = C(k-1) * 2*(2k-1) / (k+1).
fn gp_count(n: int) -> int
    if n <= 0
        return 1
    let val = 1
    let k = 1
    while k <= n
        val = val * 2 * (2 * k - 1) / (k + 1)
        k = k + 1
    val
