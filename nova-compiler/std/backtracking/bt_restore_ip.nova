// std/backtracking/bt_restore_ip.nova — all valid IPv4 addresses from a digit string.
// LEAF — imports NOTHING. Pure integer/string backtracking.
//
// Public API:
//   ri_solve(digits)  -> list  all valid dotted IPv4 strings (4 octets, each 0-255, no leading zeros)
//   ri_count(digits)  -> int   count of such valid addresses
//
// Rules for a valid octet parsed from a substring:
//   - Length 1-3 characters (non-empty, at most 3 digits)
//   - No leading zeros UNLESS the octet is exactly "0" (single character)
//   - Numeric value 0-255
//
// Algorithm: backtracking over 4 octet positions.
// At each octet slot, try all valid substrings of length 1, 2, or 3 starting at current position.
// Prune: remaining chars after this octet must be feasible for the remaining octets.
// Backtracking uses pop(parts) to undo each push — lists are reference types.
//
// Note: digits[i] in NOVA returns a single-character string.
// to_int(slice(s, lo, hi)) converts a digit substring to its integer value.

// _ri_substr — extract digits[lo..hi] (inclusive) as a string.
fn _ri_substr(digits: string, lo: int, hi: int) -> string
    let s_parts = []
    let k = lo
    while k <= hi
        push(s_parts, digits[k])
        k = k + 1
    let s = join(s_parts, "")
    s

// _ri_valid_octet — true iff digits[lo..hi] is a valid octet (0-255, no leading zeros except "0").
// Leading zero: a multi-character octet cannot start with '0'.
// Value check: to_int of the substring must be 0..255.
fn _ri_valid_octet(digits: string, lo: int, hi: int) -> bool
    let length = hi - lo + 1
    if length < 1 or length > 3
        return false
    // No leading zeros for multi-digit octets.
    if length > 1 and digits[lo] == "0"
        return false
    let val = parse_int(_ri_substr(digits, lo, hi))
    val >= 0 and val <= 255

// _ri_bt — backtracking: fill 4 octets (oct_idx = 0..3) starting at position start in digits.
// parts accumulates the 4 octet strings; out receives completed dotted addresses.
// IMPORTANT: push(parts, ...) mutates parts in place; pop(parts) undoes it. Lists are reference types.
fn _ri_bt(digits: string, start: int, oct_idx: int, parts: list, out: list)
    let total = len(digits)
    if oct_idx == 4
        if start == total
            // Build dotted string from parts[0..3].
            let addr = parts[0] + "." + parts[1] + "." + parts[2] + "." + parts[3]
            push(out, addr)
        return null
    // Remaining octets after this one.
    let octs_after = 3 - oct_idx
    // Try lengths 1, 2, 3 for current octet.
    let length = 1
    while length <= 3
        let hi = start + length - 1
        if hi < total
            if _ri_valid_octet(digits, start, hi)
                // Prune: remaining chars after this octet must be feasible.
                let chars_after = total - (start + length)
                if chars_after >= octs_after and chars_after <= octs_after * 3
                    let piece = _ri_substr(digits, start, hi)
                    push(parts, piece)
                    _ri_bt(digits, start + length, oct_idx + 1, parts, out)
                    pop(parts)
        length = length + 1
    return null

// ri_solve — all valid IPv4 addresses formable by inserting 3 dots into digits.
// Each octet must be 0-255 with no leading zeros (except the single character "0").
// ri_solve("0000") = ["0.0.0.0"].
// ri_solve("25525511135") = ["255.255.11.135","255.255.111.35"] (in that depth-first order).
fn ri_solve(digits: string) -> list
    let out = []
    let parts = []
    _ri_bt(digits, 0, 0, parts, out)
    out

// ri_count — number of valid IPv4 addresses formable from digits.
// ri_count("25525511135")=2, ri_count("0000")=1, ri_count("1111")=1,
// ri_count("101023")=5, ri_count("12")=0.
fn ri_count(digits: string) -> int
    let out = []
    let parts = []
    _ri_bt(digits, 0, 0, parts, out)
    len(out)
