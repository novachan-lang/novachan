// ============================================================================
// NOVA Standard Library — std/midi/tempo
// ============================================================================
// Tempo and timing conversions for Standard MIDI Files (SMF).
//
// MIDI represents tempo as microseconds per quarter note (us/qn).
// BPM (beats per minute) and us/qn are inverses: us_per_qn = 60,000,000 / bpm.
//
// SMF timing: "ticks" are the smallest time unit. The SMF header carries a
// "division" field (ticks per quarter note, e.g. 480 PPQ). Given ticks and
// the current tempo you can convert to wall-clock time.
//
// PUBLIC API
//   bpm_to_us(bpm)                              -> int   microseconds per quarter note
//   us_to_bpm(us)                               -> int   beats per minute
//   ticks_to_ms(ticks, division, us_per_quarter)-> int   milliseconds
//   ms_to_ticks(ms, division, us_per_quarter)   -> int   ticks
//   beats_to_ticks(beats, division)             -> int   ticks
// ============================================================================

// bpm_to_us(bpm) -> int
//   Convert beats-per-minute to microseconds per quarter note.
//   Formula: 60_000_000 / bpm.
//   bpm must be >= 1; returns 60000000 for bpm <= 0 (graceful floor).
fn bpm_to_us(bpm)
    let result = 60000000
    if bpm > 0
        result = 60000000 / bpm
    result

// us_to_bpm(us) -> int
//   Convert microseconds per quarter note to beats per minute.
//   Formula: 60_000_000 / us.
//   us must be >= 1; returns 60000000 for us <= 0 (graceful floor).
fn us_to_bpm(us)
    let result = 60000000
    if us > 0
        result = 60000000 / us
    result

// ticks_to_ms(ticks, division, us_per_quarter) -> int
//   Convert a tick count to milliseconds.
//   Formula: ticks * us_per_quarter / division / 1000.
//   division must be >= 1; us_per_quarter must be >= 1.
//   Returns 0 for degenerate inputs.
fn ticks_to_ms(ticks, division, us_per_quarter)
    let result = 0
    if division > 0
        if us_per_quarter > 0
            result = ticks * us_per_quarter / division / 1000
    result

// ms_to_ticks(ms, division, us_per_quarter) -> int
//   Convert milliseconds to ticks.
//   Formula: ms * 1000 * division / us_per_quarter.
//   division must be >= 1; us_per_quarter must be >= 1.
//   Returns 0 for degenerate inputs.
fn ms_to_ticks(ms, division, us_per_quarter)
    let result = 0
    if division > 0
        if us_per_quarter > 0
            result = ms * 1000 * division / us_per_quarter
    result

// beats_to_ticks(beats, division) -> int
//   Convert a beat count to ticks.
//   Formula: beats * division  (one beat = one quarter note = division ticks).
fn beats_to_ticks(beats, division)
    beats * division
