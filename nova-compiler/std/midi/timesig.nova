// ============================================================================
// NOVA Standard Library — std/midi/timesig
// ============================================================================
// Time signature and key signature helpers for Standard MIDI Files (SMF).
//
// SMF Meta Event 0x58 (Time Signature) carries four bytes:
//   [numerator, denominator_power, clocks_per_metronome, n32nd_per_quarter]
//   denominator_power = log2(denominator): 4/4 -> den_power=2, 6/8 -> den_power=3.
//   clocks = 24 (MIDI clock pulses per metronome click, standard).
//   n32     = 8  (32nd notes per quarter note, standard).
//
// SMF Meta Event 0x59 (Key Signature) carries two bytes:
//   [sf, mi]
//   sf   = number of sharps (positive) or flats (negative) stored as signed byte
//          (two's complement: -1 -> 0xFF, -2 -> 0xFE, etc.)
//   mi   = 0 for major, 1 for minor.
//
// PUBLIC API
//   timesig_encode(num, den)           -> list  [num, den_power, 24, 8]
//   timesig_decode(fields)             -> list  [num, den]
//   keysig_encode(sharps, is_minor)    -> list  [sf_byte, mi_byte]
//   keysig_name(sharps, is_minor)      -> string
// ============================================================================

// ── private: integer log2 for denominator ────────────────────────────────────

// _log2_den(den) -> int
//   Compute floor(log2(den)) for den in {1,2,4,8,16,32,64}.
//   Returns 0 for den <= 1, or the highest valid power otherwise.
fn _log2_den(den)
    let result = 0
    if den >= 64
        result = 6
    else if den >= 32
        result = 5
    else if den >= 16
        result = 4
    else if den >= 8
        result = 3
    else if den >= 4
        result = 2
    else if den >= 2
        result = 1
    else
        result = 0
    result

// _pow2(n) -> int
//   Return 2^n for n in 0..7 (covers all SMF denominator powers).
fn _pow2(n)
    let result = 1
    if n == 0
        result = 1
    else if n == 1
        result = 2
    else if n == 2
        result = 4
    else if n == 3
        result = 8
    else if n == 4
        result = 16
    else if n == 5
        result = 32
    else if n == 6
        result = 64
    else
        result = 128
    result

// ── private: key name tables ──────────────────────────────────────────────────

// _major_name(sharps) -> string
//   Return the major key name for sharps in -7..7.
//   Positive = sharps, negative = flats.
fn _major_name(sharps)
    let name = "C major"
    if sharps == 0
        name = "C major"
    else if sharps == 1
        name = "G major"
    else if sharps == 2
        name = "D major"
    else if sharps == 3
        name = "A major"
    else if sharps == 4
        name = "E major"
    else if sharps == 5
        name = "B major"
    else if sharps == 6
        name = "F# major"
    else if sharps == 7
        name = "C# major"
    else if sharps == -1
        name = "F major"
    else if sharps == -2
        name = "Bb major"
    else if sharps == -3
        name = "Eb major"
    else if sharps == -4
        name = "Ab major"
    else if sharps == -5
        name = "Db major"
    else if sharps == -6
        name = "Gb major"
    else
        name = "Cb major"
    name

// _minor_name(sharps) -> string
//   Return the minor key name for sharps in -7..7.
fn _minor_name(sharps)
    let name = "A minor"
    if sharps == 0
        name = "A minor"
    else if sharps == 1
        name = "E minor"
    else if sharps == 2
        name = "B minor"
    else if sharps == 3
        name = "F# minor"
    else if sharps == 4
        name = "C# minor"
    else if sharps == 5
        name = "G# minor"
    else if sharps == 6
        name = "D# minor"
    else if sharps == 7
        name = "A# minor"
    else if sharps == -1
        name = "D minor"
    else if sharps == -2
        name = "G minor"
    else if sharps == -3
        name = "C minor"
    else if sharps == -4
        name = "F minor"
    else if sharps == -5
        name = "Bb minor"
    else if sharps == -6
        name = "Eb minor"
    else
        name = "Ab minor"
    name

// ── public API ────────────────────────────────────────────────────────────────

// timesig_encode(num, den) -> list
//   Encode a time signature as four SMF meta event bytes:
//     [numerator, denominator_power, clocks_per_metronome, n32nd_per_quarter]
//   den_power = log2(den): e.g. 4 -> 2, 8 -> 3.
//   clocks is always 24 (standard MIDI metronome pulses per click).
//   n32 is always 8 (standard: 8 x 32nd notes = 1 quarter note).
//   num must be 1..255; den must be a power of 2 in 1..128.
fn timesig_encode(num, den)
    let dp = _log2_den(den)
    let result = []
    push(result, num)
    push(result, dp)
    push(result, 24)
    push(result, 8)
    result

// timesig_decode(fields) -> list
//   Decode a 4-element SMF time signature field list back to [numerator, denominator].
//   fields[0] = numerator, fields[1] = denominator_power.
//   den = 2^den_power.
fn timesig_decode(fields)
    let num = fields[0]
    let dp = fields[1]
    let den = _pow2(dp)
    let result = []
    push(result, num)
    push(result, den)
    result

// keysig_encode(sharps, is_minor) -> list
//   Encode a key signature as two SMF meta event bytes [sf_byte, mi_byte].
//   sharps: positive = sharps count (1..7), negative = flats count (-1..-7), 0 = C/Am.
//   is_minor: 0 = major, 1 = minor.
//   sf_byte is the signed value stored as an unsigned byte (two's complement):
//     -1 -> 255, -2 -> 254, ... , 0..7 stored as-is.
fn keysig_encode(sharps, is_minor)
    let sf = sharps
    if sf < 0
        sf = 256 + sf
    let mi = is_minor
    if mi != 0
        mi = 1
    let result = []
    push(result, sf)
    push(result, mi)
    result

// keysig_name(sharps, is_minor) -> string
//   Return a human-readable key name, e.g. "C major", "A minor", "D major".
//   sharps: -7..7 (negative = flats).
//   is_minor: 0 = major, 1 = minor.
fn keysig_name(sharps, is_minor)
    let name = "C major"
    if is_minor != 0
        name = _minor_name(sharps)
    else
        name = _major_name(sharps)
    name
