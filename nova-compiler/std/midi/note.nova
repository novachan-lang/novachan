// ============================================================================
// NOVA Standard Library — std/midi/note
// ============================================================================
// MIDI note number <-> name, frequency, and transposition utilities.
//
// Convention:
//   Middle C = C4 = MIDI note 60.
//   A4       = MIDI note 69 = 440 Hz (standard concert pitch).
//   Note names use sharps only: C C# D D# E F F# G G# A A# B.
//   Octave formula: octave = (n / 12) - 1  (integer division).
//   Valid MIDI note range: 0..127.
//
// FREQUENCY FORMULA
//   freq_hz = round(440.0 * 2^((n - 69) / 12.0))
//   Implemented using the builtin pow(base: float, exp: float) -> float.
//   FLOAT HAZARD: never return a bare pow/multi-term float expr; bind to let.
//
// PUBLIC API
//   note_name(n)         -> str    e.g. note_name(60) == "C4"
//   note_number(name)    -> int    e.g. note_number("A4") == 69, -1 if invalid
//   note_freq_hz(n)      -> int    rounded integer Hz
//   transpose(n, semis)  -> int    n + semis (clamped to 0..127)
//   note_octave(n)       -> int    octave number (C-1=0 is octave -1)
//   note_pitchclass(n)   -> int    0..11 (C=0, C#=1, ..., B=11)
// ============================================================================

// ── private: pitch-class names ───────────────────────────────────────────────

// note_pc_name(pc) -> str
//   Return the sharp-only name for pitch class pc in 0..11.
fn _note_pc_name(pc)
    let name = "C"
    if pc == 0
        name = "C"
    else if pc == 1
        name = "C#"
    else if pc == 2
        name = "D"
    else if pc == 3
        name = "D#"
    else if pc == 4
        name = "E"
    else if pc == 5
        name = "F"
    else if pc == 6
        name = "F#"
    else if pc == 7
        name = "G"
    else if pc == 8
        name = "G#"
    else if pc == 9
        name = "A"
    else if pc == 10
        name = "A#"
    else
        name = "B"
    name

// _note_pc_from_name(s) -> int
//   Parse a pitch-class string (e.g. "C#", "G") -> 0..11, or -1 if unrecognised.
fn _note_pc_from_name(s)
    let result = -1
    if s == "C"
        result = 0
    else if s == "C#"
        result = 1
    else if s == "D"
        result = 2
    else if s == "D#"
        result = 3
    else if s == "E"
        result = 4
    else if s == "F"
        result = 5
    else if s == "F#"
        result = 6
    else if s == "G"
        result = 7
    else if s == "G#"
        result = 8
    else if s == "A"
        result = 9
    else if s == "A#"
        result = 10
    else if s == "B"
        result = 11
    result

// _note_parse_octave(s) -> int
//   Parse an octave string (possibly negative, e.g. "-1", "4") -> int.
//   Returns -99 on parse failure.
fn _note_parse_octave(s)
    let slen = len(s)
    let result = -99
    if slen == 0
        result = -99
    else
        let neg = 0
        let start = 0
        if slice(s, 0, 1) == "-"
            neg = 1
            start = 1
        let acc = 0
        let valid = 1
        let i = start
        while i < slen
            let ch = slice(s, i, i + 1)
            let d = -1
            if ch == "0"
                d = 0
            else if ch == "1"
                d = 1
            else if ch == "2"
                d = 2
            else if ch == "3"
                d = 3
            else if ch == "4"
                d = 4
            else if ch == "5"
                d = 5
            else if ch == "6"
                d = 6
            else if ch == "7"
                d = 7
            else if ch == "8"
                d = 8
            else if ch == "9"
                d = 9
            if d < 0
                valid = 0
            acc = acc * 10 + d
            i += 1
        if valid == 1
            if neg == 1
                result = 0 - acc
            else
                result = acc
    result

// ── public API ───────────────────────────────────────────────────────────────

// note_pitchclass(n) -> int
//   Return the pitch class (0..11) of MIDI note n.
//   C=0, C#=1, D=2, D#=3, E=4, F=5, F#=6, G=7, G#=8, A=9, A#=10, B=11.
fn note_pitchclass(n)
    n - (n / 12) * 12

// note_octave(n) -> int
//   Return the octave number for MIDI note n.
//   Middle C (n=60) is C4, so octave = (n/12) - 1.
fn note_octave(n)
    (n / 12) - 1

// note_name(n) -> str
//   Return the note name string for MIDI note n (0..127).
//   E.g. note_name(60) == "C4", note_name(69) == "A4", note_name(0) == "C-1".
fn note_name(n)
    let pc = note_pitchclass(n)
    let oct = note_octave(n)
    let pcstr = _note_pc_name(pc)
    pcstr + str(oct)

// note_number(name) -> int
//   Parse a note name string (e.g. "C4", "A#3", "G#5") -> MIDI note number.
//   Returns -1 if the name is invalid or out of range 0..127.
//   Accepts: pitch-class letter(s) followed immediately by octave (possibly negative).
//   Sharp names only (no flats).
fn note_number(name)
    let nlen = len(name)
    let result = -1
    if nlen < 2
        result = -1
    else
        // Determine pitch class width: 1 char ("C","D","E","F","G","A","B")
        // or 2 chars for sharps ("C#","D#","F#","G#","A#").
        let pc = -1
        let oct_start = 1
        // Try 2-char pitch class first (requires nlen >= 3).
        if nlen >= 3
            let two = slice(name, 0, 2)
            let pc2 = _note_pc_from_name(two)
            if pc2 >= 0
                pc = pc2
                oct_start = 2
        // Fall back to 1-char pitch class.
        if pc < 0
            let one = slice(name, 0, 1)
            pc = _note_pc_from_name(one)
        if pc < 0
            result = -1
        else
            let oct_str = slice(name, oct_start, nlen)
            let oct = _note_parse_octave(oct_str)
            if oct == -99
                result = -1
            else
                let n = (oct + 1) * 12 + pc
                if n < 0
                    result = -1
                else if n > 127
                    result = -1
                else
                    result = n
    result

// note_freq_hz(n) -> int
//   Return the frequency in Hz (rounded to nearest integer) for MIDI note n.
//   Formula: round(440.0 * 2^((n - 69) / 12.0)).
//   FLOAT HAZARD: bind intermediate results to named lets; avoid bare return of
//   multi-term float expression (uninit-slot compiler bug).
fn note_freq_hz(n)
    let diff = n - 69
    let exponent = diff * 1.0 / 12.0
    let ratio = pow(2.0, exponent)
    let freq_f = 440.0 * ratio
    let freq_i = round(freq_f)
    freq_i

// transpose(n, semis) -> int
//   Transpose MIDI note n by semis semitones (may be negative).
//   Result is clamped to valid MIDI range 0..127.
fn transpose(n, semis)
    let result = n + semis
    if result < 0
        result = 0
    else if result > 127
        result = 127
    result
