// ============================================================================
// NOVA Standard Library — std/midi/cc
// ============================================================================
// MIDI Control Change (CC) number/name mapping and 14-bit CC helpers.
//
// MIDI CC OVERVIEW
//   Control Change messages use status byte 0xBn (n=channel 0-15).
//   The first data byte is the CC number (0..127).
//   The second data byte is the controller value (0..127 for most; 0/127 for switches).
//
//   Standard CC assignments (partial — most widely used):
//     0   Bank Select MSB          1   Modulation Wheel
//     2   Breath Controller        4   Foot Controller
//     5   Portamento Time          6   Data Entry MSB
//     7   Volume                   8   Balance
//     10  Pan                      11  Expression
//     12  Effect Control 1         13  Effect Control 2
//     32  Bank Select LSB          38  Data Entry LSB
//     64  Sustain (Damper)         65  Portamento On/Off
//     66  Sostenuto                67  Soft Pedal
//     68  Legato Footswitch        69  Hold 2
//     71  Resonance (Filter Q)     72  Release Time
//     73  Attack Time              74  Cutoff (Brightness)
//     75  Decay Time               84  Portamento Control
//     91  Reverb Depth             92  Tremolo Depth
//     93  Chorus Depth             94  Detune Depth
//     95  Phaser Depth             96  Data Increment
//     97  Data Decrement           120 All Sound Off
//     121 Reset All Controllers    122 Local Control On/Off
//     123 All Notes Off            124 Omni Off
//     125 Omni On                  126 Mono On
//     127 Poly On
//
// 14-BIT HIGH-RESOLUTION CC
//   CCs 0..31 are MSB controllers; their paired LSB is CC (n+32).
//   value14 is a 14-bit integer 0..16383. Split:
//     MSB = (value14 >> 7) & 0x7F   (sent on the primary CC number)
//     LSB = value14 & 0x7F          (sent on CC number+32)
//
// SWITCH CCs (on/off semantics)
//   CCs 64..69 are interpreted as on/off: value >= 64 → on, value 0 → off.
//
// PUBLIC API
//   cc_name(n)           -> string   Human name for CC number n (0..127);
//                                    "Undefined" if n is not a named CC.
//   cc_number(name)      -> int      CC number for the given name string;
//                                    -1 if not found.
//   cc14_split(value14)  -> list     [msb, lsb] for a 14-bit CC value (0..16383).
//                                    msb = (value14 >> 7) & 0x7F  (0..127)
//                                    lsb = value14 & 0x7F          (0..127)
//   cc14_combine(msb, lsb) -> int   Reconstruct 14-bit value: (msb<<7)|lsb.
//                                    Inputs clamped to 0..127.
//   cc_is_switch(n)      -> bool    true iff CC n is a switch controller (64..69).
// ============================================================================

// ── cc_name ─────────────────────────────────────────────────────────────────
// Returns the human-readable name for a MIDI CC number.
// "Undefined" is returned for any CC not in the standard named set.
fn cc_name(n: int) -> string
    if n == 0
        return "Bank Select MSB"
    if n == 1
        return "Modulation"
    if n == 2
        return "Breath Controller"
    if n == 4
        return "Foot Controller"
    if n == 5
        return "Portamento Time"
    if n == 6
        return "Data Entry MSB"
    if n == 7
        return "Volume"
    if n == 8
        return "Balance"
    if n == 10
        return "Pan"
    if n == 11
        return "Expression"
    if n == 12
        return "Effect Control 1"
    if n == 13
        return "Effect Control 2"
    if n == 32
        return "Bank Select LSB"
    if n == 38
        return "Data Entry LSB"
    if n == 64
        return "Sustain"
    if n == 65
        return "Portamento On/Off"
    if n == 66
        return "Sostenuto"
    if n == 67
        return "Soft Pedal"
    if n == 68
        return "Legato Footswitch"
    if n == 69
        return "Hold 2"
    if n == 71
        return "Resonance"
    if n == 72
        return "Release Time"
    if n == 73
        return "Attack Time"
    if n == 74
        return "Cutoff"
    if n == 75
        return "Decay Time"
    if n == 84
        return "Portamento Control"
    if n == 91
        return "Reverb"
    if n == 92
        return "Tremolo Depth"
    if n == 93
        return "Chorus"
    if n == 94
        return "Detune Depth"
    if n == 95
        return "Phaser Depth"
    if n == 96
        return "Data Increment"
    if n == 97
        return "Data Decrement"
    if n == 120
        return "AllSoundOff"
    if n == 121
        return "ResetAllControllers"
    if n == 122
        return "Local Control On/Off"
    if n == 123
        return "AllNotesOff"
    if n == 124
        return "Omni Off"
    if n == 125
        return "Omni On"
    if n == 126
        return "Mono On"
    if n == 127
        return "Poly On"
    "Undefined"

// ── cc_number ────────────────────────────────────────────────────────────────
// Returns the CC number for a given name string, or -1 if not found.
// Case-sensitive. Matches the exact names returned by cc_name().
fn cc_number(name: string) -> int
    if name == "Bank Select MSB"
        return 0
    if name == "Modulation"
        return 1
    if name == "Breath Controller"
        return 2
    if name == "Foot Controller"
        return 4
    if name == "Portamento Time"
        return 5
    if name == "Data Entry MSB"
        return 6
    if name == "Volume"
        return 7
    if name == "Balance"
        return 8
    if name == "Pan"
        return 10
    if name == "Expression"
        return 11
    if name == "Effect Control 1"
        return 12
    if name == "Effect Control 2"
        return 13
    if name == "Bank Select LSB"
        return 32
    if name == "Data Entry LSB"
        return 38
    if name == "Sustain"
        return 64
    if name == "Portamento On/Off"
        return 65
    if name == "Sostenuto"
        return 66
    if name == "Soft Pedal"
        return 67
    if name == "Legato Footswitch"
        return 68
    if name == "Hold 2"
        return 69
    if name == "Resonance"
        return 71
    if name == "Release Time"
        return 72
    if name == "Attack Time"
        return 73
    if name == "Cutoff"
        return 74
    if name == "Decay Time"
        return 75
    if name == "Portamento Control"
        return 84
    if name == "Reverb"
        return 91
    if name == "Tremolo Depth"
        return 92
    if name == "Chorus"
        return 93
    if name == "Detune Depth"
        return 94
    if name == "Phaser Depth"
        return 95
    if name == "Data Increment"
        return 96
    if name == "Data Decrement"
        return 97
    if name == "AllSoundOff"
        return 120
    if name == "ResetAllControllers"
        return 121
    if name == "Local Control On/Off"
        return 122
    if name == "AllNotesOff"
        return 123
    if name == "Omni Off"
        return 124
    if name == "Omni On"
        return 125
    if name == "Mono On"
        return 126
    if name == "Poly On"
        return 127
    -1

// ── cc14_split ───────────────────────────────────────────────────────────────
// Split a 14-bit CC value (0..16383) into [msb, lsb].
//   msb = (value14 >> 7) & 0x7F   sent on the primary (MSB) CC number
//   lsb = value14 & 0x7F           sent on the paired CC (number + 32)
// Input is masked to 14 bits before splitting (safe for any int input).
fn cc14_split(value14: int) -> list
    let v = value14 & 0x3FFF
    let msb = (v >> 7) & 0x7F
    let lsb = v & 0x7F
    let out = []
    push(out, msb)
    push(out, lsb)
    out

// ── cc14_combine ─────────────────────────────────────────────────────────────
// Reconstruct a 14-bit CC value from MSB and LSB bytes.
// Both inputs must be in 0..127; they are masked to 0x7F for safety.
// Result is in 0..16383.
fn cc14_combine(msb: int, lsb: int) -> int
    ((msb & 0x7F) << 7) | (lsb & 0x7F)

// ── cc_is_switch ─────────────────────────────────────────────────────────────
// Returns true iff CC number n is a switch controller (64..69).
// These controllers use value >= 64 as "on" and 0 as "off".
fn cc_is_switch(n: int) -> bool
    if n >= 64 and n <= 69
        return true
    false
