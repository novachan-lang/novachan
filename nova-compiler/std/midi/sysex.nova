// std/midi/sysex.nova -- MIDI System Exclusive (SysEx) message builder and decoder.
// LEAF — imports NOTHING.
//
// System Exclusive (SysEx) messages are used to send manufacturer-specific or
// universal data in MIDI. Format: 0xF0 <data bytes 0x00..0x7F> 0xF7
//
// All data bytes MUST be 0..127 (high bit clear). Status bytes (>=0x80) are
// rejected. The 0xF0 (start) and 0xF7 (end) delimiters are never part of the
// inner data — they are inserted/stripped by this module.
//
// Public API
//   sysex(data_bytes) -> list
//     Wrap raw data bytes with SysEx delimiters: [0xF0] ++ data_bytes ++ [0xF7].
//     Data bytes outside 0..127 are clamped to 0x7F (safe: never embeds a status).
//
//   sysex_manufacturer(mfr_id, data) -> list
//     Build a manufacturer SysEx: [0xF0, mfr_id & 0x7F] ++ data ++ [0xF7].
//
//   sysex_universal_nonrealtime(dev, sub1, sub2, data) -> list
//     Build a Universal Non-Realtime SysEx:
//     [0xF0, 0x7E, dev & 0x7F, sub1 & 0x7F, sub2 & 0x7F] ++ data ++ [0xF7].
//
//   sysex_decode(bytes_list) -> list
//     Extract inner data from a complete SysEx message (between F0 and F7).
//     Returns empty list if message is malformed (no F0 start, no F7 end).
//
//   manufacturer_name(id) -> string
//     Return a human-readable name for a known MIDI manufacturer ID.
//     Returns "Unknown" for unrecognised IDs.

// ── private helpers ──────────────────────────────────────────────────────────

// _clamp7 -- Clamp a value to the 0..127 data-byte range.
fn _clamp7(v)
    if v < 0
        return 0
    if v > 127
        return 127
    v

// _append_data -- Append all elements of src to dst (both lists).
// Clamps each element to 0..127 to ensure no status byte leaks in.
fn _append_data(dst, src)
    let n = len(src)
    for i in 0..n
        let b = src[i]
        push(dst, _clamp7(b))

// ── public API ───────────────────────────────────────────────────────────────

// sysex -- Wrap data_bytes with SysEx delimiters F0 ... F7.
// data_bytes: list of ints 0..127.
// Returns: [0xF0] ++ data_bytes ++ [0xF7].
fn sysex(data_bytes)
    let msg = []
    push(msg, 0xF0)
    _append_data(msg, data_bytes)
    push(msg, 0xF7)
    msg

// sysex_manufacturer -- Build a manufacturer-specific SysEx message.
// mfr_id: manufacturer ID byte (0..127). data: additional data bytes.
// Returns: [0xF0, mfr_id & 0x7F] ++ data ++ [0xF7].
fn sysex_manufacturer(mfr_id, data)
    let msg = []
    push(msg, 0xF0)
    push(msg, _clamp7(mfr_id))
    _append_data(msg, data)
    push(msg, 0xF7)
    msg

// sysex_universal_nonrealtime -- Build a Universal Non-Realtime SysEx.
// dev:  target device (0x00..0x7F; 0x7F = all devices).
// sub1: sub-ID #1 (e.g. 0x06 = General Information).
// sub2: sub-ID #2 (e.g. 0x01 = Identity Request).
// data: additional payload bytes (may be empty list).
// Returns: [0xF0, 0x7E, dev, sub1, sub2] ++ data ++ [0xF7].
fn sysex_universal_nonrealtime(dev, sub1, sub2, data)
    let msg = []
    push(msg, 0xF0)
    push(msg, 0x7E)
    push(msg, _clamp7(dev))
    push(msg, _clamp7(sub1))
    push(msg, _clamp7(sub2))
    _append_data(msg, data)
    push(msg, 0xF7)
    msg

// sysex_decode -- Extract inner data from a complete SysEx message.
// bytes_list: list starting with 0xF0 and ending with 0xF7.
// Returns the bytes between the delimiters (not including F0/F7 themselves).
// Returns empty list on malformed input (missing F0 or F7, or too short).
fn sysex_decode(bytes_list)
    let result = []
    let n = len(bytes_list)
    // Need at least [0xF0, 0xF7] = 2 bytes.
    if n < 2
        return result
    // Must start with F0.
    if bytes_list[0] != 0xF0
        return result
    // Must end with F7.
    if bytes_list[n - 1] != 0xF7
        return result
    // Copy the inner bytes (indices 1 .. n-2 inclusive).
    for i in 1..(n - 1)
        push(result, bytes_list[i])
    result

// manufacturer_name -- Return the name for a known MIDI manufacturer ID.
// Common IDs per the MIDI Manufacturers Association registry:
//   0x01 Sequential Circuits, 0x02 IDP, 0x07 Digital Visions,
//   0x08 Octave/Plateau, 0x09 Moog, 0x0F Ensoniq,
//   0x10 Oberheim, 0x13 Passport Designs, 0x15 JL Cooper,
//   0x18 Emu, 0x1B Passport (alt), 0x1C Siel, 0x24 Hohner,
//   0x40 Kawai, 0x41 Roland, 0x42 Korg, 0x43 Yamaha,
//   0x44 Casio, 0x47 Akai, 0x48 Sony, 0x4C Sony (alt),
//   0x7D Educational / Non-Commercial, 0x7E Universal Non-Realtime,
//   0x7F Universal Realtime.
fn manufacturer_name(id)
    if id == 0x01
        return "Sequential Circuits"
    if id == 0x07
        return "Digital Visions"
    if id == 0x08
        return "Octave/Plateau"
    if id == 0x09
        return "Moog"
    if id == 0x0F
        return "Ensoniq"
    if id == 0x10
        return "Oberheim"
    if id == 0x18
        return "Emu Systems"
    if id == 0x24
        return "Hohner"
    if id == 0x40
        return "Kawai"
    if id == 0x41
        return "Roland"
    if id == 0x42
        return "Korg"
    if id == 0x43
        return "Yamaha"
    if id == 0x44
        return "Casio"
    if id == 0x47
        return "Akai"
    if id == 0x48
        return "Sony"
    if id == 0x7D
        return "Educational"
    if id == 0x7E
        return "Universal Non-Realtime"
    if id == 0x7F
        return "Universal Realtime"
    "Unknown"
