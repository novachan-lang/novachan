// std/security/sanitize — input sanitization for web-facing code.
//
// Each function handles exactly ONE injection context. Callers MUST pick the
// function matching where the string is actually going (HTML body vs. SQL
// string literal vs. filesystem path) — there is no universal "sanitize
// everything" function, because there is no universal escaping rule; the
// same input can be safe in one context and dangerous in another.
//
// Public API:
//   san_html(input)          -> string (escapes & < > " for HTML text/attributes)
//   san_sql_string(input)    -> string (doubles ' — for building a quoted SQL
//                                        string literal; prefer parameterized
//                                        queries over this whenever possible)
//   san_path(input)          -> string (rejects path traversal: "" if any
//                                        path segment is exactly "..", else input unchanged)
//   san_strip_tags(input)    -> string (removes everything between < and >, inclusive)
//   san_truncate(input, max_len) -> string (caps length, no-op if already shorter)
//   san_alphanumeric(input)  -> string (keeps only ASCII [A-Za-z0-9])
//
// LEAF — imports nothing.

// san_html: escape the four characters that are dangerous when placed
// verbatim into HTML text content or a double-quoted attribute value.
//   &  -> &amp;   (escaped FIRST so this pass never double-encodes itself)
//   <  -> &lt;
//   >  -> &gt;
//   "  -> &quot;
fn san_html(input) -> string
    let out = ""
    let i = 0
    let n = len(input)
    while i < n
        let c = input[i]
        let b = ord(c)
        if b == 38
            out = out + "&amp;"
        else if b == 60
            out = out + "&lt;"
        else if b == 62
            out = out + "&gt;"
        else if b == 34
            out = out + "&quot;"
        else
            out = out + c
        i = i + 1
    return out

// san_sql_string: double every single-quote so input is safe to place inside
// a single-quoted SQL string literal ('...'). This is a last-resort escaper —
// parameterized/prepared queries avoid the whole class of SQL injection and
// should be used instead wherever the driver supports them.
fn san_sql_string(input) -> string
    let out = ""
    let i = 0
    let n = len(input)
    while i < n
        let c = input[i]
        if c == "'"
            out = out + "''"
        else
            out = out + c
        i = i + 1
    return out

// _san_normalize_slashes: backslashes treated as path separators too, so
// "..\\..\\etc" is caught on Windows-style input as well as "../../etc".
fn _san_normalize_slashes(input) -> string
    return replace(input, chr(92), "/")

// san_path: reject path traversal. Returns "" if any "/"-separated segment
// of input is exactly "..", otherwise returns input unchanged.
// NOTE: this rejects, it does not "clean" — a caller that wants a usable
// path back must reject "" and ask the user again, not silently substitute
// a default.
fn san_path(input) -> string
    let norm = _san_normalize_slashes(input)
    let segs = split(norm, "/")
    for seg in segs
        if seg == ".."
            return ""
    return input

// san_strip_tags: remove every "<...>" span (inclusive of the angle
// brackets). An unterminated "<" with no matching ">" strips to end of
// string (fails closed: nothing after a dangling "<" survives).
fn san_strip_tags(input) -> string
    let out = ""
    let i = 0
    let n = len(input)
    let in_tag = 0
    while i < n
        let c = input[i]
        if in_tag == 1
            if c == ">"
                in_tag = 0
        else
            if c == "<"
                in_tag = 1
            else
                out = out + c
        i = i + 1
    return out

// san_truncate: cap input to at most max_len characters. No-op if input is
// already max_len or shorter.
fn san_truncate(input, max_len) -> string
    if len(input) <= max_len
        return input
    return slice(input, 0, max_len)

// _san_is_alnum_char: true for ASCII '0'-'9', 'A'-'Z', 'a'-'z'.
fn _san_is_alnum_char(c) -> bool
    let b = ord(c)
    if b >= 48 and b <= 57
        return true
    if b >= 65 and b <= 90
        return true
    if b >= 97 and b <= 122
        return true
    return false

// san_alphanumeric: keep only ASCII letters and digits, drop everything else
// (no replacement character inserted — the string simply gets shorter).
fn san_alphanumeric(input) -> string
    let out = ""
    let i = 0
    let n = len(input)
    while i < n
        let c = input[i]
        if _san_is_alnum_char(c)
            out = out + c
        i = i + 1
    return out
