// std/graph/cycledetect.nova — Cycle detection for directed and undirected graphs.
//
// Graph representation: adj is a dict mapping node-name STRING to a list of
// neighbor-name STRINGs (unweighted).  nodes is a list of all node-name strings
// (needed to cover isolated nodes with no adjacency entries).
//
// Public API:
//   cd_has_cycle_directed(adj, nodes)   -> bool  true iff the directed graph has a cycle
//   cd_has_cycle_undirected(adj, nodes) -> bool  true iff the undirected graph has a cycle
//   cd_is_dag(adj, nodes)               -> bool  true iff the graph is a directed acyclic graph
//
// Algorithm (directed): Iterative DFS with 3-color marking.
//   color[v] = 0  (WHITE)  — not yet visited
//   color[v] = 1  (GRAY)   — in the current DFS call stack (back-edge target = cycle)
//   color[v] = 2  (BLACK)  — fully processed (no cycle through this node)
//   An explicit stack stores [node, neighborIndex] frames; when all neighbours of
//   a node are exhausted we set its color to BLACK.  If we reach a GRAY node we
//   found a back edge and the graph has a cycle.
//
// Algorithm (undirected): Iterative DFS tracking the immediate parent of each node.
//   If a visited neighbour is NOT the parent of the current node, a cycle exists.
//   For multi-edges the parent is compared by name (first edge to parent is skipped).
//
// Module-private prefix: _cd_

// ─── directed helpers ─────────────────────────────────────────────────────────

// _cd_nbrs: safely fetch the neighbor list for a node; returns [] if absent.
fn _cd_nbrs(adj, u)
    if contains(adj, u)
        return adj[u]
    return []

// _cd_directed_component: iterative 3-color DFS from start.
// color dict is mutated in-place (shared across all start nodes).
// Returns 1 if a cycle is found, 0 otherwise.
fn _cd_directed_component(adj, start, color)
    // Stack entries: each entry is a 2-element list [nodeString, nextNeighborIndex].
    // We push [start, 0] and process until the stack is empty.
    // Avoids 'while A and B' (NOVA IR gotcha) — uses done sentinel instead.
    let stk = []
    color[start] = 1
    stk.push([start, 0])
    let found = 0
    let done = 0
    while done == 0
        let slen = len(stk)
        if slen == 0
            done = 1
        else
            let top_idx = slen - 1
            let frame = stk[top_idx]
            let u = frame[0]
            let ni = frame[1]
            let nbrs = _cd_nbrs(adj, u)
            if ni >= len(nbrs)
                // All neighbours of u exhausted — mark BLACK and pop
                color[u] = 2
                stk = slice(stk, 0, top_idx)
            else
                // Advance the neighbour index for next iteration
                frame[1] = ni + 1
                let v = nbrs[ni]
                if contains(color, v)
                    let cv = color[v]
                    if cv == 1
                        // Back edge — cycle detected
                        found = 1
                        done = 1
                    // cv == 2: already fully processed, safe to skip
                else
                    // WHITE — tree edge; push new frame and mark GRAY
                    color[v] = 1
                    stk.push([v, 0])
    return found

// ─── undirected helpers ───────────────────────────────────────────────────────

// _cd_undirected_component: BFS from start for undirected graphs.
// visited: dict node -> 1 (mutated in-place).
// parent: dict node -> parentName string (mutated in-place).
// Returns 1 if a cycle is found, 0 otherwise.
// Uses BFS (queue+head-index) to avoid any slice/stack pop complexity.
fn _cd_undirected_component(adj, start, visited, parent)
    let queue = []
    let head = 0
    visited[start] = 1
    parent[start] = ""
    queue.push(start)
    let found = 0
    while head < len(queue)
        let u = queue[head]
        head = head + 1
        let nbrs = _cd_nbrs(adj, u)
        let par = parent[u]
        for i in 0..len(nbrs)
            let v = nbrs[i]
            if contains(visited, v)
                // Already visited — if not the direct parent, cycle found
                if v != par
                    found = 1
            else
                // Unvisited tree edge
                visited[v] = 1
                parent[v] = u
                queue.push(v)
    return found

// ─── public API ───────────────────────────────────────────────────────────────

// cd_has_cycle_directed: returns true iff the directed graph contains at least
// one cycle.  Handles disconnected graphs by starting a DFS from every unvisited
// node.
fn cd_has_cycle_directed(adj, nodes) -> bool
    let color = {}
    let found = 0
    for i in 0..len(nodes)
        let v = nodes[i]
        if contains(color, v) == 0
            if found == 0
                let res = _cd_directed_component(adj, v, color)
                if res == 1
                    found = 1
    if found == 1
        return true
    return false

// cd_has_cycle_undirected: returns true iff the undirected graph contains at
// least one cycle.  Handles disconnected graphs by starting a DFS from every
// unvisited node.  The adjacency list must be symmetric (each edge appears in
// both directions) for correct results.
fn cd_has_cycle_undirected(adj, nodes) -> bool
    let visited = {}
    let parent = {}
    let found = 0
    for i in 0..len(nodes)
        let v = nodes[i]
        if contains(visited, v) == 0
            if found == 0
                let res = _cd_undirected_component(adj, v, visited, parent)
                if res == 1
                    found = 1
    if found == 1
        return true
    return false

// cd_is_dag: returns true iff the directed graph is acyclic (a DAG).
// Equivalent to NOT cd_has_cycle_directed.
fn cd_is_dag(adj, nodes) -> bool
    let has_cycle = cd_has_cycle_directed(adj, nodes)
    if has_cycle
        return false
    return true
