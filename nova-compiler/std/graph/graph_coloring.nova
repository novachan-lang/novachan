// std/graph/graph_coloring.nova — Graph coloring algorithms for undirected graphs.
// LEAF — imports NOTHING.
//
// Graph representation:
//   adj = list of lists: adj[i] = list of integer neighbor ids for node i
//   n   = number of nodes (0..n-1)
//
// Public API:
//   gc_greedy(adj, n)           -> list  color per vertex (0-indexed), greedy in order 0..n-1
//   gc_num_colors_greedy(adj, n)-> int   number of distinct colors used by greedy
//   gc_is_m_colorable(adj, n, m)-> bool  backtracking: true iff graph is m-colorable
//   gc_chromatic(adj, n)        -> int   minimum number of colors (chromatic number)
//
// Greedy algorithm: for each vertex in order 0..n-1, assign the smallest color
// not used by any already-colored neighbor.
//
// Backtracking algorithm: assign colors 0..m-1 to each vertex in order, pruning
// branches where a color conflicts with a neighbor already colored.
//
// Private helpers prefixed _gc_

// _gc_color_ok: return 1 iff color c can be assigned to node v without conflicting
// with any already-assigned neighbor (colors[u] >= 0 means u is assigned).
fn _gc_color_ok(adj, colors, v, c) -> int
    let nbrs = adj[v]
    for i in 0..len(nbrs)
        let u = nbrs[i]
        if colors[u] == c
            return 0
    return 1

// _gc_greedy_assign: return the smallest non-negative color not used by neighbors of v.
fn _gc_greedy_assign(adj, colors, v) -> int
    let nbrs = adj[v]
    // collect neighbor colors into a used-marker list
    // upper bound: at most deg(v)+1 colors needed
    let deg = len(nbrs)
    let used = []
    let k = 0
    while k <= deg
        push(used, 0)
        k = k + 1
    for i in 0..deg
        let u = nbrs[i]
        let c = colors[u]
        if c >= 0
            if c <= deg
                used[c] = 1
    let c2 = 0
    while c2 <= deg
        if used[c2] == 0
            return c2
        c2 = c2 + 1
    return deg + 1

// _gc_max_color: return the maximum value in the colors list.
fn _gc_max_color(colors, n) -> int
    let mx = 0
    let i = 0
    while i < n
        if colors[i] > mx
            mx = colors[i]
        i = i + 1
    return mx

// _gc_bt_dfs: backtracking search for m-coloring.
// colors = list of int (-1 = unassigned, else color 0..m-1).
// v = current vertex to assign. Returns 1 if coloring found, 0 otherwise.
fn _gc_bt_dfs(adj, n, colors, m, v) -> int
    if v == n
        return 1
    for c in 0..m
        if _gc_color_ok(adj, colors, v, c) == 1
            colors[v] = c
            let ok = _gc_bt_dfs(adj, n, colors, m, v + 1)
            if ok == 1
                return 1
            colors[v] = -1
    return 0

// gc_greedy: assign colors to vertices 0..n-1 using greedy first-fit.
// Returns a list of n integers where result[i] is the color of vertex i.
fn gc_greedy(adj, n) -> list
    let colors = []
    for i in 0..n
        push(colors, -1)
    for v in 0..n
        let c = _gc_greedy_assign(adj, colors, v)
        colors[v] = c
    return colors

// gc_num_colors_greedy: return the number of distinct colors used by greedy coloring.
// For an empty graph returns 1 (by convention, 0-node graph returns 0).
fn gc_num_colors_greedy(adj, n) -> int
    if n == 0
        return 0
    let colors = gc_greedy(adj, n)
    let mx = _gc_max_color(colors, n)
    return mx + 1

// gc_is_m_colorable: return true iff the graph can be colored with at most m colors.
// Uses backtracking. Returns false if m <= 0.
fn gc_is_m_colorable(adj, n, m) -> bool
    if n == 0
        return true
    if m <= 0
        return false
    let colors = [-1 for i in 0..n]
    let found = _gc_bt_dfs(adj, n, colors, m, 0)
    if found == 1
        return true
    return false

// gc_chromatic: return the chromatic number (minimum number of colors needed).
// Tries m = 1, 2, 3, ... until gc_is_m_colorable returns true.
// Upper bound: n colors always suffice (trivial); also bounded by greedy.
fn gc_chromatic(adj, n) -> int
    if n == 0
        return 0
    let upper = gc_num_colors_greedy(adj, n)
    let m = 1
    while m <= upper
        if gc_is_m_colorable(adj, n, m)
            return m
        m = m + 1
    return upper
