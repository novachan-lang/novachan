// std/graph/graph_metrics.nova — Structural metrics for undirected graphs.
//
// Graph representation: adj[i] = list of neighbor integers (undirected, symmetric).
// n = number of nodes (0..n-1). Each undirected edge appears in both adjacency lists.
//
// Public API:
//   gm_is_connected(adj, n)      -> bool  true iff graph is connected
//   gm_component_count(adj, n)   -> int   number of connected components
//   gm_is_tree(adj, n)           -> bool  connected AND exactly n-1 edges AND acyclic
//   gm_is_bipartite(adj, n)      -> bool  2-colorable (no odd cycles)
//   gm_diameter(adj, n)          -> int   max shortest-path distance (-1 if disconnected)
//   gm_degree_sequence(adj, n)   -> list  degrees sorted descending
//
// Algorithms:
//   gm_is_connected / gm_component_count: BFS flood-fill from each unvisited node.
//   gm_is_tree: connected + edge-count == n-1 (acyclicity follows from connectedness + n-1 edges).
//   gm_is_bipartite: BFS 2-coloring; odd cycle detected when neighbor has same color.
//   gm_diameter: BFS from every node; max over all shortest distances.
//   gm_degree_sequence: collect degrees, insertion-sort descending.
//
// Module-private prefix: _gm_

// ─── BFS helpers ─────────────────────────────────────────────────────────────

// _gm_bfs_visit: BFS from src; marks visited[] = 1 for all reachable nodes.
// Returns the number of newly-visited nodes.
fn _gm_bfs_visit(adj, src, visited) -> int
    let queue = []
    push(queue, src)
    visited[src] = 1
    let head = 0
    let cnt = 1
    while head < len(queue)
        let u = queue[head]
        head += 1
        let nbrs = adj[u]
        for ni in 0..len(nbrs)
            let v = nbrs[ni]
            if visited[v] == 0
                visited[v] = 1
                push(queue, v)
                cnt += 1
    return cnt

// _gm_edge_count: count total number of undirected edges (sum of degrees / 2).
fn _gm_edge_count(adj, n) -> int
    let total = 0
    for i in 0..n
        total += len(adj[i])
    return total / 2

// ─── public API ──────────────────────────────────────────────────────────────

// gm_is_connected: returns true iff all nodes are reachable from node 0.
fn gm_is_connected(adj, n) -> bool
    if n == 0
        return true
    let visited = []
    for i in 0..n
        push(visited, 0)
    let cnt = _gm_bfs_visit(adj, 0, visited)
    if cnt == n
        return true
    return false

// gm_component_count: returns the number of connected components.
fn gm_component_count(adj, n) -> int
    if n == 0
        return 0
    let visited = [0 for i in 0..n]
    let comps = 0
    for u in 0..n
        if visited[u] == 0
            _gm_bfs_visit(adj, u, visited)
            comps += 1
    return comps

// gm_is_tree: returns true iff the graph is connected and has exactly n-1 edges.
// A connected graph with n-1 edges is always acyclic (a tree).
fn gm_is_tree(adj, n) -> bool
    if n == 0
        return true
    let ec = _gm_edge_count(adj, n)
    if ec != n - 1
        return false
    let conn = gm_is_connected(adj, n)
    return conn

// gm_is_bipartite: returns true iff the graph is 2-colorable (no odd cycles).
// Uses BFS 2-coloring; handles disconnected graphs by starting from each unvisited node.
fn gm_is_bipartite(adj, n) -> bool
    if n == 0
        return true
    let color = [-1 for i in 0..n]
    let is_bip = 1
    let src = 0
    while src < n
        if color[src] == -1
            color[src] = 0
            let queue = []
            push(queue, src)
            let head = 0
            while head < len(queue)
                let u = queue[head]
                head += 1
                let cu = color[u]
                let nbrs = adj[u]
                for ni in 0..len(nbrs)
                    let v = nbrs[ni]
                    if color[v] == -1
                        // Uncolored: assign opposite color
                        if cu == 0
                            color[v] = 1
                        else
                            color[v] = 0
                        push(queue, v)
                    else
                        // Already colored: same color = odd cycle
                        if color[v] == cu
                            is_bip = 0
        src += 1
    if is_bip == 1
        return true
    return false

// _gm_bfs_dists: BFS from src; returns list of distances (n entries; -1 = unreachable).
fn _gm_bfs_dists(adj, n, src) -> list
    let dist = [-1 for i in 0..n]
    dist[src] = 0
    let queue = []
    push(queue, src)
    let head = 0
    while head < len(queue)
        let u = queue[head]
        head += 1
        let du = dist[u]
        let nbrs = adj[u]
        for ni in 0..len(nbrs)
            let v = nbrs[ni]
            if dist[v] == -1
                dist[v] = du + 1
                push(queue, v)
    return dist

// gm_diameter: returns the maximum shortest-path distance over all pairs of nodes
// (unweighted BFS). Returns -1 if the graph is disconnected (n>1) or empty (n==0).
fn gm_diameter(adj, n) -> int
    if n == 0
        return -1
    if n == 1
        return 0
    // First check connectivity
    let conn = gm_is_connected(adj, n)
    if conn == false
        return -1
    let diam = 0
    for src in 0..n
        let dists = _gm_bfs_dists(adj, n, src)
        let j = 0
        while j < n
            let d = dists[j]
            if d > diam
                diam = d
            j += 1
    return diam

// _gm_isort_desc: insertion-sort a list of integers descending (in-place).
fn _gm_isort_desc(xs)
    let sz = len(xs)
    for i in 1..sz
        let key = xs[i]
        let j = i - 1
        let jdone = 0
        while jdone == 0
            if j < 0
                jdone = 1
            else
                if xs[j] < key
                    xs[j + 1] = xs[j]
                    j -= 1
                else
                    jdone = 1
        xs[j + 1] = key

// gm_degree_sequence: returns the degree sequence of the graph sorted in descending order.
fn gm_degree_sequence(adj, n) -> list
    let degs = [len(adj[i]) for i in 0..n]
    _gm_isort_desc(degs)
    return degs
