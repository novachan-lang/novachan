// std/graph/kruskal.nova — Kruskal Minimum Spanning Tree via union-find.
// Undirected weighted graph; edges = list of [u, v, weight] triples.
// Nodes = list of all node name strings (needed for isolated-node detection).
// LEAF — imports NOTHING.
//
// Public API:
//   kr_mst(edges, nodes)        -> list   MST edges as [u,v,w], sorted by weight then u then v
//   kr_mst_weight(edges, nodes) -> int    total weight of MST
//   kr_is_connected(edges, nodes) -> bool true iff the graph is connected
//
// Private helpers (tag: kr_):
//   kr_sort_edges(edges)        -> list   insertion-sort edges by weight (stable)
//   kr_find(parent, x)          -> string path-compressed root of x in union-find
//   kr_union(parent, rank, a, b)         union by rank; modifies parent+rank dicts in place
//   kr_edge_lt(a, b)            -> bool  compare two edges: weight, then u, then v

// kr_sort_edges — insertion-sort a list of [u,v,w] edge triples by weight ascending.
// Stable, O(n^2) — acceptable for typical graph sizes.
fn kr_sort_edges(edges: list) -> list
    let n = len(edges)
    let result = []
    let i = 0
    while i < n
        let dummy = 0
        result.push(edges[i])
        i = i + 1
    // insertion sort on result
    let j = 1
    while j < n
        let cur = result[j]
        let cw = cur[2]
        let cu = cur[0]
        let cv = cur[1]
        let k = j - 1
        let done = 0
        while k >= 0 and done == 0
            let other = result[k]
            let ow = other[2]
            let ou = other[0]
            let ov = other[1]
            let should_shift = 0
            if ow > cw
                should_shift = 1
            if ow == cw and ou > cu
                should_shift = 1
            if ow == cw and ou == cu and ov > cv
                should_shift = 1
            if should_shift == 1
                result[k + 1] = result[k]
                k = k - 1
            if should_shift == 0
                done = 1
        result[k + 1] = cur
        j = j + 1
    result

// kr_find — path-compressed find in union-find parent dict.
// Returns the root representative of the set containing x.
// Performs path compression by iteratively finding the root,
// then updating each node on the path directly to the root.
fn kr_find(parent: dict, x: string) -> string
    // walk to root
    let root = x
    let walking = 1
    while walking == 1
        if contains(parent, root)
            let p = parent[root]
            if p == root
                walking = 0
            if p != root
                root = p
        if not contains(parent, root)
            walking = 0
    // path compression: set all nodes on path to root
    let cur = x
    let compressing = 1
    while compressing == 1
        if contains(parent, cur)
            let p = parent[cur]
            if p == root
                compressing = 0
            if p != root
                parent[cur] = root
                cur = p
        if not contains(parent, cur)
            compressing = 0
    root

// kr_union — union by rank. Merges sets containing a and b.
// Modifies parent and rank dicts in place.
fn kr_union(parent: dict, rank: dict, a: string, b: string)
    let ra = kr_find(parent, a)
    let rb = kr_find(parent, b)
    if ra == rb
        return null
    // rank comparison
    let rka = 0
    if contains(rank, ra)
        rka = rank[ra]
    let rkb = 0
    if contains(rank, rb)
        rkb = rank[rb]
    if rka < rkb
        parent[ra] = rb
    if rka > rkb
        parent[rb] = ra
    if rka == rkb
        parent[rb] = ra
        rank[ra] = rka + 1

// kr_mst — Kruskal MST algorithm.
// Returns the MST as a list of [u, v, w] edge triples,
// sorted by weight ascending, then u, then v.
// For a disconnected graph returns a spanning forest (maximum spanning tree of each component).
fn kr_mst(edges: list, nodes: list) -> list
    let sorted = kr_sort_edges(edges)
    // initialize union-find: each node is its own parent with rank 0
    let parent = {}
    let rank = {}
    let ni = 0
    let nn = len(nodes)
    while ni < nn
        let nd = nodes[ni]
        parent[nd] = nd
        rank[nd] = 0
        ni = ni + 1
    let mst = []
    let ei = 0
    let ne = len(sorted)
    while ei < ne
        let edge = sorted[ei]
        let u = edge[0]
        let v = edge[1]
        let w = edge[2]
        // ensure nodes exist in union-find (handles nodes not in nodes list)
        if not contains(parent, u)
            parent[u] = u
            rank[u] = 0
        if not contains(parent, v)
            parent[v] = v
            rank[v] = 0
        let ru = kr_find(parent, u)
        let rv = kr_find(parent, v)
        if ru != rv
            kr_union(parent, rank, u, v)
            mst.push(edge)
        ei = ei + 1
    mst

// kr_mst_weight — total weight of the MST.
fn kr_mst_weight(edges: list, nodes: list) -> int
    let mst = kr_mst(edges, nodes)
    let total = 0
    let i = 0
    let n = len(mst)
    while i < n
        let e = mst[i]
        total = total + e[2]
        i = i + 1
    total

// kr_is_connected — true iff the graph on these nodes is connected.
// A connected graph on n nodes has an MST with exactly n-1 edges.
// An empty node list or single-node graph is trivially connected.
fn kr_is_connected(edges: list, nodes: list) -> bool
    let n = len(nodes)
    if n <= 1
        return true
    let mst = kr_mst(edges, nodes)
    len(mst) == n - 1
