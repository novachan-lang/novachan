// std/graph/dijkstra.nova — Dijkstra shortest-path algorithm.
// Graph representation: adj is a dict mapping node-name string -> list of edges,
// where each edge is a 2-element list [neighborName, weightInt] (non-negative weights).
// All nodes that appear in the graph must be keys of adj (even if their edge list is empty).
//
// Public API:
//   dj_shortest(adj, source) -> dict  node -> shortest distance (1000000000 = unreachable)
//   dj_distance(adj, source, target) -> int  (-1 if unreachable)
//   dj_path(adj, source, target) -> list  (node sequence, [] if unreachable)
//
// Implementation: O(V²) selection (no priority queue). Correct for all non-negative weights.
// Private helpers are prefixed _dj_ to avoid name collisions.

let _DJ_INF = 1000000000

// _dj_pick: find the unvisited node with the smallest tentative distance.
// Returns "" if every node has been visited (or all unvisited nodes are unreachable).
fn _dj_pick(node_list, dist, visited) -> str
    let best = ""
    let best_d = _DJ_INF + 1
    for i in 0..len(node_list)
        let nd = node_list[i]
        let is_vis = 0
        if contains(visited, nd)
            is_vis = visited[nd]
        if is_vis == 0
            let d = _DJ_INF
            if contains(dist, nd)
                d = dist[nd]
            if d < best_d
                best_d = d
                best = nd
    return best

// _dj_core: run Dijkstra from source.
// Returns [dist_dict, prev_dict]:
//   dist_dict  — node -> shortest distance (_DJ_INF if unreachable)
//   prev_dict  — node -> predecessor on shortest path (absent for source)
fn _dj_core(adj, source) -> list
    let node_list = keys(adj)
    let n = len(node_list)
    let dist = {}
    let prev = {}
    let visited = {}
    // initialise all tentative distances to INF
    for i in 0..n
        let nd = node_list[i]
        dist[nd] = _DJ_INF
    // source costs zero to reach itself
    dist[source] = 0
    // main loop: settle one node per iteration (at most n iterations)
    let iter = 0
    while iter < n
        let u = _dj_pick(node_list, dist, visited)
        if u == ""
            iter = n
        if u != ""
            visited[u] = 1
            let du = dist[u]
            // relax every outgoing edge from u
            if contains(adj, u)
                let edges = adj[u]
                for ei in 0..len(edges)
                    let edge = edges[ei]
                    let v = edge[0]
                    let w = edge[1]
                    let dv = _DJ_INF
                    if contains(dist, v)
                        dv = dist[v]
                    let alt = du + w
                    if alt < dv
                        dist[v] = alt
                        prev[v] = u
            iter = iter + 1
    return [dist, prev]

// dj_shortest: returns dict mapping each node to its shortest distance from source.
// Unreachable nodes map to _DJ_INF (1000000000).
fn dj_shortest(adj, source) -> dict
    let result = _dj_core(adj, source)
    return result[0]

// dj_distance: shortest distance from source to target. Returns -1 if unreachable.
fn dj_distance(adj, source, target) -> int
    let d_map = dj_shortest(adj, source)
    let d = _DJ_INF
    if contains(d_map, target)
        d = d_map[target]
    if d >= _DJ_INF
        return -1
    return d

// _dj_build_path: walk prev links from target back to source, return reversed list.
// Returns [] if the predecessor chain is broken (should not happen for reachable nodes).
fn _dj_build_path(source, target, prev) -> list
    let rev = []
    let cur = target
    let done = 0
    let safety = 0
    while done == 0 and safety < 100000
        push(rev, cur)
        if cur == source
            done = 1
        if done == 0
            if contains(prev, cur)
                cur = prev[cur]
            if not contains(prev, cur)
                if cur != source
                    done = 2
        safety = safety + 1
    if done != 1
        return []
    return rev

// dj_path: returns the node sequence [source, ..., target] for the shortest path.
// Returns [] if target is unreachable from source.
fn dj_path(adj, source, target) -> list
    let result = _dj_core(adj, source)
    let d_map = result[0]
    let prev = result[1]
    // check reachability
    let d = _DJ_INF
    if contains(d_map, target)
        d = d_map[target]
    if d >= _DJ_INF
        return []
    // trivial case: source == target
    if target == source
        return [source]
    // reconstruct: walk backwards from target to source, then reverse
    let rev = _dj_build_path(source, target, prev)
    if len(rev) == 0
        return []
    let path = []
    let ri = len(rev) - 1
    while ri >= 0
        push(path, rev[ri])
        ri = ri - 1
    return path
