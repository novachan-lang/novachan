// std/graph/directed.nova — directed graph as an adjacency list.
//
// Representation: a dict with two entries:
//   "nodes" -> dict   node_name -> 1        (membership set, insertion order)
//   "edges" -> dict   node_name -> list     (ordered list of outgoing neighbors)
//
// dg_add_edge registers both endpoints as nodes (auto-vivifies from/to) and
// is idempotent (adding the same edge twice does not create a duplicate).
//
// Public API (prefix dg_):
//   dg_new()                 -> dict
//   dg_add_node(g, node)
//   dg_add_edge(g, from, to)
//   dg_neighbors(g, node)    -> list
//   dg_has_edge(g, from, to) -> bool
//   dg_nodes(g)              -> list
//   dg_bfs(g, start)         -> list   (BFS visiting order from start)
//   dg_dfs(g, start)         -> list   (DFS visiting order from start, pre-order)
//   dg_has_path(g, from, to) -> bool
//
// LEAF — imports nothing.

// dg_new: create an empty directed graph.
fn dg_new() -> dict
    let g = {}
    g["nodes"] = {}
    g["edges"] = {}
    return g

// dg_add_node: register node (no-op if already present).
fn dg_add_node(g, node)
    let nodes = g["nodes"]
    nodes[node] = 1
    g["nodes"] = nodes
    let edges = g["edges"]
    if node not in edges
        edges[node] = []
        g["edges"] = edges

// dg_add_edge: add a directed edge from -> to. Both endpoints are
// auto-registered as nodes. Adding the same edge twice is a no-op the
// second time (no duplicate neighbor entries).
fn dg_add_edge(g, from, to)
    dg_add_node(g, from)
    dg_add_node(g, to)
    let edges = g["edges"]
    let lst = edges[from]
    if to not in lst
        push(lst, to)
        edges[from] = lst
        g["edges"] = edges

// dg_neighbors: outgoing neighbors of node, in insertion order.
// Unknown node -> [].
fn dg_neighbors(g, node) -> list
    let edges = g["edges"]
    if node in edges
        return edges[node]
    return []

// dg_has_edge: true iff there is a direct edge from -> to.
fn dg_has_edge(g, from, to) -> bool
    let nbrs = dg_neighbors(g, from)
    return contains(nbrs, to)

// dg_nodes: all known node names, in insertion order.
fn dg_nodes(g) -> list
    return keys(g["nodes"])

// dg_bfs: breadth-first traversal order starting at start.
// Unknown start -> [start] is still visited (it is trivially reachable from
// itself) even if it was never registered via dg_add_node/dg_add_edge.
fn dg_bfs(g, start) -> list
    let visited = {}
    let order = []
    let queue = [start]
    visited[start] = 1
    let qi = 0
    while qi < len(queue)
        let cur = queue[qi]
        qi += 1
        push(order, cur)
        let nbrs = dg_neighbors(g, cur)
        for i in 0..len(nbrs)
            let nb = nbrs[i]
            if nb not in visited
                visited[nb] = 1
                push(queue, nb)
    return order

// Private: recursive pre-order DFS visitor. visited/order are mutated
// in place (both are dict/list reference values).
fn _dg_dfs_visit(g, node, visited, order)
    visited[node] = 1
    push(order, node)
    let nbrs = dg_neighbors(g, node)
    for i in 0..len(nbrs)
        let nb = nbrs[i]
        if nb not in visited
            _dg_dfs_visit(g, nb, visited, order)

// dg_dfs: depth-first (pre-order) traversal order starting at start.
fn dg_dfs(g, start) -> list
    let visited = {}
    let order = []
    _dg_dfs_visit(g, start, visited, order)
    return order

// dg_has_path: true iff to is reachable from from by following directed
// edges (from == to is always true, even for an unregistered node).
fn dg_has_path(g, from, to) -> bool
    if from == to
        return true
    let reached = dg_bfs(g, from)
    return contains(reached, to)
