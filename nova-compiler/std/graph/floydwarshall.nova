// std/graph/floydwarshall.nova — Floyd-Warshall all-pairs shortest paths.
// LEAF — imports NOTHING.
//
// Graph representation: adj = dict mapping node-name STRING -> list of edges.
// Each edge is a 2-element list [neighborNameString, weightInt].
// nodes = list of all node name strings (needed for isolated nodes).
//
// Public API:
//   fw_all_pairs(adj, nodes)          -> dist dict  (dist[u] is a dict v->distance;
//                                         unreachable = 1000000000; self = 0)
//   fw_distance(result, u, v)         -> int        distance from u to v
//   fw_has_negative_cycle(result, nodes) -> bool    any dist[v][v] < 0
//
// Algorithm: O(n^3) dynamic programming over intermediate nodes.
//   dist[u][v] = min over all k: dist[u][k] + dist[k][v]
//
// All private helpers use the _fw_ prefix to avoid cross-module collisions.

// _fw_INF — sentinel for unreachable (1 billion, fits in i64 without overflow in
//           the addition dist[u][k] + dist[k][v] since 1e9+1e9 < 2^31).
fn _fw_inf()
    return 1000000000

// fw_all_pairs — run Floyd-Warshall and return the full distance matrix.
//
// Input:
//   adj   — dict: node -> list of [neighbor, weight] edges (may be absent for
//           isolated nodes; guard with contains())
//   nodes — list of all node name strings
//
// Output:
//   A dict: each key is a node u; value is a dict v -> distance (int).
//   Unreachable pairs carry _fw_inf() (1000000000).
//   Self-distance is always 0.
fn fw_all_pairs(adj, nodes)
    let INF = _fw_inf()
    let n = len(nodes)

    // Build the initial distance matrix as a dict-of-dicts.
    // Start: self=0, direct edges=weight, everything else=INF.
    let dist = {}
    let i = 0
    while i < n
        let u = nodes[i]
        let row = {}
        let j = 0
        while j < n
            let v = nodes[j]
            if u == v
                row[v] = 0
            else
                row[v] = INF
            j = j + 1
        dist[u] = row
        i = i + 1

    // Populate direct edges from adj.
    let i2 = 0
    while i2 < n
        let u = nodes[i2]
        if contains(adj, u)
            let edges = adj[u]
            let e = 0
            while e < len(edges)
                let edge = edges[e]
                let v = edge[0]
                let w = edge[1]
                let row2 = dist[u]
                if w < row2[v]
                    row2[v] = w
                e = e + 1
        i2 = i2 + 1

    // Main Floyd-Warshall triple loop: relax through each intermediate node k.
    let ki = 0
    while ki < n
        let k = nodes[ki]
        let ui = 0
        while ui < n
            let u = nodes[ui]
            let rowu = dist[u]
            let rowk = dist[k]
            let duk = rowu[k]
            if duk < INF
                let vi = 0
                while vi < n
                    let v = nodes[vi]
                    let dkv = rowk[v]
                    if dkv < INF
                        let through = duk + dkv
                        let cur = rowu[v]
                        if through < cur
                            rowu[v] = through
                    vi = vi + 1
            ui = ui + 1
        ki = ki + 1

    return dist

// fw_distance — query the distance from u to v in the precomputed result.
//
// Returns 1000000000 if unreachable, 0 if u==v (guaranteed by fw_all_pairs),
// or the shortest-path weight otherwise.
fn fw_distance(result, u, v)
    if contains(result, u)
        let row = result[u]
        if contains(row, v)
            return row[v]
    return _fw_inf()

// fw_has_negative_cycle — return true (1) if any node v has dist[v][v] < 0.
//
// Floyd-Warshall exposes negative cycles via negative self-distances.
// A graph with no negative edges (or only positive weights) always returns false.
fn fw_has_negative_cycle(result, nodes)
    let i = 0
    while i < len(nodes)
        let v = nodes[i]
        if contains(result, v)
            let row = result[v]
            if contains(row, v)
                let self_dist = row[v]
                if self_dist < 0
                    return 1
        i = i + 1
    return 0
