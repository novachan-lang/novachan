// std/graph/tarjan.nova — Tarjan strongly-connected components (SCCs) for NOVA.
//
// Graph representation: adj is a dict mapping node-name STRING to a list of
// neighbor-name STRINGs (directed, unweighted).  nodes is a list of all node
// name strings (needed to discover isolated nodes with no adjacency entries).
//
// Public API
//   tj_scc(adj, nodes)            -> list of SCCs; each SCC is a sorted list of
//                                    node-name strings; the outer list is sorted
//                                    by each SCC's smallest member.
//   tj_count(adj, nodes)          -> int  (number of SCCs)
//   tj_same_scc(adj, nodes, u, v) -> int  (1 if u and v are in the same SCC)
//
// Algorithm: classic recursive Tarjan (Tarjan 1972).
//   disc[v]     — DFS discovery timestamp of v
//   low[v]      — lowest disc reachable from v's subtree via back/cross edges
//   on_stk[v]   — 1 if v is currently on the SCC candidate stack
//   When low[v] == disc[v] after visiting children, pop down to v — that is one SCC.
//
// Stack implementation: sp-pointer + data list (same pattern as
// std/collections/graph.nova _gr_stk_*) — avoids slice() which only works on strings.
//
// NOTE: nested `while <a> and <b>` triggers an IR bug when inside another loop.
//   Replaced with done-flag inner loops throughout.
//
// Module-private prefix: _tj_

// ─── stack helpers ────────────────────────────────────────────────────────────

fn _tj_stk_new()
    let s = {}
    s["data"] = []
    s["sp"]   = 0
    return s

fn _tj_stk_push(s, v)
    let data = s["data"]
    let sp   = s["sp"]
    if sp < len(data)
        data[sp] = v
    else
        data.push(v)
    s["sp"] = sp + 1

fn _tj_stk_pop(s)
    let sp     = s["sp"]
    let new_sp = sp - 1
    s["sp"] = new_sp
    let data = s["data"]
    return data[new_sp]

fn _tj_stk_len(s)
    return s["sp"]

// ─── sort helpers ─────────────────────────────────────────────────────────────

// Insertion-sort a list of strings ascending (in-place).
// Avoids nested `while <a> and <b>` via done-flag inner loop.
fn _tj_sort_strs(xs)
    let n = len(xs)
    let i = 1
    while i < n
        let key   = xs[i]
        let j     = i - 1
        let jdone = 0
        while jdone == 0
            let jcmp = j
            if jcmp < 0
                jdone = 1
            else
                let elem = xs[jcmp]
                if elem > key
                    xs[jcmp + 1] = xs[jcmp]
                    j = jcmp - 1
                else
                    jdone = 1
        xs[j + 1] = key
        i = i + 1

// Insertion-sort a list of SCC lists by each SCC's first element (string).
fn _tj_sort_sccs(sccs)
    let n = len(sccs)
    let i = 1
    while i < n
        let key_scc  = sccs[i]
        let key_name = key_scc[0]
        let j        = i - 1
        let jdone    = 0
        while jdone == 0
            let jcmp = j
            if jcmp < 0
                jdone = 1
            else
                let pivot_scc  = sccs[jcmp]
                let pivot_name = pivot_scc[0]
                if pivot_name > key_name
                    sccs[jcmp + 1] = sccs[jcmp]
                    j = jcmp - 1
                else
                    jdone = 1
        sccs[j + 1] = key_scc
        i = i + 1

// ─── Tarjan DFS ───────────────────────────────────────────────────────────────

fn _tj_make_state()
    let st = {}
    st["disc"]    = {}
    st["low"]     = {}
    st["on_stk"]  = {}
    st["stk"]     = _tj_stk_new()
    let timer     = []
    timer.push(0)
    st["timer"]   = timer
    st["sccs"]    = []
    return st

// Recursive Tarjan DFS from node v.  All mutable state lives in st.
fn _tj_visit(adj, v, st)
    let disc_map = st["disc"]
    let low_map  = st["low"]
    let on_stk   = st["on_stk"]
    let timer    = st["timer"]
    let stk      = st["stk"]
    // Assign discovery time to v
    let t = timer[0]
    disc_map[v] = t
    low_map[v]  = t
    on_stk[v]   = 1
    _tj_stk_push(stk, v)
    timer[0] = t + 1
    // Collect neighbours into a local list
    let neighbours = []
    if contains(adj, v)
        let raw = adj[v]
        let ni  = 0
        while ni < len(raw)
            let nb_name = raw[ni]
            neighbours.push(nb_name)
            ni = ni + 1
    let i = 0
    while i < len(neighbours)
        let w = neighbours[i]
        if contains(disc_map, w)
            // w already visited — if w is on the stack, update low[v]
            let won = on_stk[w]
            if won == 1
                let dw = disc_map[w]
                let lv = low_map[v]
                if dw < lv
                    low_map[v] = dw
        else
            // tree edge — recurse then propagate low
            _tj_visit(adj, w, st)
            let lw = low_map[w]
            let lv = low_map[v]
            if lw < lv
                low_map[v] = lw
        i = i + 1
    // If v is the SCC root, pop the stack segment
    let lv2 = low_map[v]
    let dv  = disc_map[v]
    if lv2 == dv
        let comp = []
        let done = 0
        while done == 0
            let top = _tj_stk_pop(stk)
            on_stk[top] = 0
            comp.push(top)
            if top == v
                done = 1
        _tj_sort_strs(comp)
        let sccs = st["sccs"]
        sccs.push(comp)

// Run Tarjan over all nodes; return sorted list of SCCs.
fn _tj_run(adj, nodes)
    let st       = _tj_make_state()
    let disc_map = st["disc"]
    let i        = 0
    while i < len(nodes)
        let v = nodes[i]
        if contains(disc_map, v) == 0
            _tj_visit(adj, v, st)
        i = i + 1
    let sccs = st["sccs"]
    _tj_sort_sccs(sccs)
    return sccs

// ─── public API ───────────────────────────────────────────────────────────────

// Returns list of SCCs; each SCC is a sorted list of node-name strings;
// the outer list is sorted by each SCC's smallest member.
fn tj_scc(adj, nodes)
    return _tj_run(adj, nodes)

// Returns the number of strongly-connected components.
fn tj_count(adj, nodes)
    let sccs = _tj_run(adj, nodes)
    return len(sccs)

// Returns 1 if nodes u and v are in the same SCC, 0 otherwise.
fn tj_same_scc(adj, nodes, u, v)
    let sccs = _tj_run(adj, nodes)
    let i    = 0
    while i < len(sccs)
        let comp    = sccs[i]
        let found_u = 0
        let found_v = 0
        let j       = 0
        while j < len(comp)
            let name = comp[j]
            if name == u
                found_u = 1
            if name == v
                found_v = 1
            j = j + 1
        if found_u == 1 and found_v == 1
            return 1
        i = i + 1
    return 0
