// std/graph/boruvka_mst.nova — Minimum spanning tree via Boruvka's algorithm.
//
// Graph representation: n = node count (0..n-1); edges = list of [u,v,w] triples
// (undirected, weighted integers). Multi-edges and self-loops allowed.
//
// Public API:
//   bm_weight(n, edges)       -> total MST weight, or -1 if disconnected
//   bm_edge_count(n, edges)   -> edges in the MST (n-1 if connected, -1 if not)
//   bm_is_connected(n, edges) -> bool
//
// Algorithm: Boruvka's algorithm.
//   Each round: for every component, find the minimum-weight outgoing edge.
//   Union those edges, accumulate weight. Repeat until 1 component or no merges.
//   Self-loops are ignored (they can never be in an MST).
//   O(E log V) total time.
//
// Module-private prefix: _bm_

// _bm_make_list: build a list of n ints all set to val.
fn _bm_make_list(n, val)
    let lst = []
    let i = 0
    while i < n
        lst.push(val)
        i += 1
    return lst

// _bm_find: path-compressing find in union-find stored as a plain list (parent[i]).
fn _bm_find(parent, x)
    let root = x
    let walking = 1
    while walking == 1
        let p = parent[root]
        if p == root
            walking = 0
        else
            root = p
    // path compression
    let cur = x
    let compressing = 1
    while compressing == 1
        let p = parent[cur]
        if p == root
            compressing = 0
        else
            parent[cur] = root
            cur = p
    return root

// _bm_union: union by rank; returns 1 if a merge happened, 0 if already same set.
fn _bm_union(parent, rank, a, b)
    let ra = _bm_find(parent, a)
    let rb = _bm_find(parent, b)
    if ra == rb
        return 0
    let rka = rank[ra]
    let rkb = rank[rb]
    if rka < rkb
        parent[ra] = rb
    else
        if rka > rkb
            parent[rb] = ra
        else
            parent[rb] = ra
            rank[ra] = rka + 1
    return 1

// _bm_run: execute Boruvka's algorithm.
// Returns [total_weight, edge_count, is_connected_int].
fn _bm_run(n, edges)
    if n == 0
        let r = []
        r.push(0)
        r.push(0)
        r.push(1)
        return r
    if n == 1
        let r = []
        r.push(0)
        r.push(0)
        r.push(1)
        return r
    let parent = _bm_make_list(n, 0)
    let rank   = _bm_make_list(n, 0)
    for i in 0..n
        parent[i] = i
    let total_weight = 0
    let edge_count   = 0
    let num_comp = n
    let changed = 1
    while changed == 1 and num_comp > 1
        // cheapest[c] = [weight, u, v] for the cheapest outgoing edge from component c.
        // We store -1 in weight slot to indicate "no edge found yet".
        let cheapest = []
        for ci in 0..n
            let slot = []
            slot.push(-1)
            slot.push(-1)
            slot.push(-1)
            cheapest.push(slot)
        // scan all edges
        let ei = 0
        let ne = len(edges)
        while ei < ne
            let edge = edges[ei]
            let u = edge[0]
            let v = edge[1]
            let w = edge[2]
            // skip self-loops
            if u != v
                let ru = _bm_find(parent, u)
                let rv = _bm_find(parent, v)
                if ru != rv
                    // edge crosses component boundary — candidate for ru
                    let slot_ru = cheapest[ru]
                    let best_ru = slot_ru[0]
                    if best_ru == -1
                        slot_ru[0] = w
                        slot_ru[1] = u
                        slot_ru[2] = v
                    else
                        if w < best_ru
                            slot_ru[0] = w
                            slot_ru[1] = u
                            slot_ru[2] = v
                    cheapest[ru] = slot_ru
                    // candidate for rv
                    let slot_rv = cheapest[rv]
                    let best_rv = slot_rv[0]
                    if best_rv == -1
                        slot_rv[0] = w
                        slot_rv[1] = u
                        slot_rv[2] = v
                    else
                        if w < best_rv
                            slot_rv[0] = w
                            slot_rv[1] = u
                            slot_rv[2] = v
                    cheapest[rv] = slot_rv
            ei += 1
        // merge components using cheapest edges
        changed = 0
        for ki in 0..n
            let slot = cheapest[ki]
            let best_w = slot[0]
            if best_w >= 0
                let eu = slot[1]
                let ev = slot[2]
                let merged = _bm_union(parent, rank, eu, ev)
                if merged == 1
                    total_weight += best_w
                    edge_count   = edge_count + 1
                    num_comp     = num_comp - 1
                    changed = 1
    let is_conn = 0
    if num_comp == 1
        is_conn = 1
    let result = []
    result.push(total_weight)
    result.push(edge_count)
    result.push(is_conn)
    return result

// bm_weight: total MST weight. Returns -1 if the graph is disconnected.
// Returns 0 for n<=1 (trivially connected, no edges needed).
fn bm_weight(n, edges)
    if n <= 0
        return 0
    if n == 1
        return 0
    let res = _bm_run(n, edges)
    let is_conn = res[2]
    if is_conn == 0
        return -1
    return res[0]

// bm_edge_count: number of edges in the MST. Returns n-1 if connected, -1 if not.
// Returns 0 for n<=1.
fn bm_edge_count(n, edges)
    if n <= 0
        return 0
    if n == 1
        return 0
    let res = _bm_run(n, edges)
    let is_conn = res[2]
    if is_conn == 0
        return -1
    return res[1]

// bm_is_connected: true iff all n nodes belong to a single connected component
// (ignoring self-loops). n==0 or n==1 is trivially true.
fn bm_is_connected(n, edges)
    if n <= 1
        return true
    let res = _bm_run(n, edges)
    let is_conn = res[2]
    if is_conn == 1
        return true
    return false
