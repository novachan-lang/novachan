// std/graph/euler_path.nova — Euler circuit/path existence for undirected graphs.
// LEAF — imports NOTHING.
//
// Graph representation:
//   adj = list of lists: adj[i] = list of integer neighbor ids for node i
//   n   = number of nodes (0..n-1)
//
// Connectivity check ignores isolated vertices (degree-0 nodes) for the
// Euler property: a graph has an Euler circuit iff its non-isolated vertices
// form a single connected component AND every vertex has even degree.
//
// Public API:
//   ep_has_euler_circuit(adj, n) -> bool  connected + all even degree
//   ep_has_euler_path(adj, n)    -> bool  connected + exactly 0 or 2 odd-degree vertices
//   ep_circuit_length(adj, n)    -> int   total edge count if circuit exists, else -1
//
// Private helpers prefixed _ep_

// _ep_degree: return the degree of node i (length of its neighbor list).
fn _ep_degree(adj, i) -> int
    let nbrs = adj[i]
    return len(nbrs)

// _ep_count_edges: count total edges (sum of degrees / 2).
fn _ep_count_edges(adj, n) -> int
    let total = 0
    let i = 0
    while i < n
        total = total + _ep_degree(adj, i)
        i = i + 1
    return total / 2

// _ep_count_odd: return the number of vertices with odd degree.
fn _ep_count_odd(adj, n) -> int
    let cnt = 0
    let i = 0
    while i < n
        let d = _ep_degree(adj, i)
        let rem = d - (d / 2) * 2
        if rem == 1
            cnt = cnt + 1
        i = i + 1
    return cnt

// _ep_bfs_from: BFS from start, return the set of visited nodes (list of ints).
// Only traverses edges present in adj (no visited dict — uses a list of size n).
fn _ep_bfs_from(adj, n, start) -> list
    let vis = []
    let qi = 0
    while qi < n
        push(vis, 0)
        qi = qi + 1
    vis[start] = 1
    let queue = []
    push(queue, start)
    let head = 0
    while head < len(queue)
        let u = queue[head]
        head = head + 1
        let nbrs = adj[u]
        let j = 0
        while j < len(nbrs)
            let v = nbrs[j]
            if vis[v] == 0
                vis[v] = 1
                push(queue, v)
            j = j + 1
    return vis

// _ep_is_connected_noniso: true iff all non-isolated vertices are in one component.
// Isolated = degree 0. If no non-isolated vertices exist, treat as connected.
fn _ep_is_connected_noniso(adj, n) -> bool
    if n == 0
        return true
    // find first non-isolated vertex
    let start = -1
    let i = 0
    while i < n
        if _ep_degree(adj, i) > 0
            if start == -1
                start = i
        i = i + 1
    // no edges at all — trivially satisfy Euler connectivity (degenerate)
    if start == -1
        return true
    let vis = _ep_bfs_from(adj, n, start)
    // check all non-isolated vertices are visited
    let i2 = 0
    let ok = 1
    while i2 < n
        if _ep_degree(adj, i2) > 0
            if vis[i2] == 0
                ok = 0
        i2 = i2 + 1
    if ok == 1
        return true
    return false

// ep_has_euler_circuit: true iff the graph has an Euler circuit.
// Conditions: non-isolated vertices connected + all vertices have even degree.
fn ep_has_euler_circuit(adj, n) -> bool
    if n == 0
        return false
    if not _ep_is_connected_noniso(adj, n)
        return false
    let odd = _ep_count_odd(adj, n)
    if odd == 0
        return true
    return false

// ep_has_euler_path: true iff the graph has an Euler path (circuit OR path).
// Conditions: non-isolated vertices connected + exactly 0 or 2 odd-degree vertices.
fn ep_has_euler_path(adj, n) -> bool
    if n == 0
        return false
    if not _ep_is_connected_noniso(adj, n)
        return false
    let odd = _ep_count_odd(adj, n)
    if odd == 0
        return true
    if odd == 2
        return true
    return false

// ep_circuit_length: return total edge count if an Euler circuit exists, else -1.
fn ep_circuit_length(adj, n) -> int
    if not ep_has_euler_circuit(adj, n)
        return -1
    return _ep_count_edges(adj, n)
