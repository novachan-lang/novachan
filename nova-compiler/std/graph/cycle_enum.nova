// std/graph/cycle_enum.nova — Cycle enumeration metrics for undirected graphs.
//
// Graph representation: adj[i] = list of neighbor integers (undirected, symmetric).
// n = number of nodes (0..n-1). Each undirected edge appears in both adjacency lists.
//
// Public API:
//   ce_has_cycle(adj, n)         -> bool  true iff the graph contains at least one cycle
//   ce_girth(adj, n)             -> int   length of shortest cycle (-1 if acyclic)
//   ce_count_triangles(adj, n)   -> int   number of 3-cliques (triangles)
//
// Algorithms:
//   ce_has_cycle: union-find. If adding an edge connects two already-connected nodes,
//     a cycle exists.
//   ce_girth: for each node, run a BFS and find the shortest back-edge that closes a cycle.
//     The minimum across all BFS runs is the girth. O(V*(V+E)).
//   ce_count_triangles: for each edge (u,v), count how many nodes w appear in both
//     adj[u] and adj[v]. Divide by 6 (each triangle counted 3 times per edge direction,
//     but edges are undirected so the pair (u,v)+(v,u) gives factor 2, times 3 edges = 6).
//
// Module-private prefix: _ce_

// ─── union-find helpers ──────────────────────────────────────────────────────

// _ce_uf_new: create parent+rank lists for n nodes.
fn _ce_uf_new(n) -> list
    let parent = []
    let rank = []
    let i = 0
    while i < n
        push(parent, i)
        push(rank, 0)
        i = i + 1
    let uf = []
    push(uf, parent)
    push(uf, rank)
    return uf

// _ce_uf_find: path-compressing find; returns root of node x.
fn _ce_uf_find(uf, x) -> int
    let parent = uf[0]
    let root = x
    let cur = x
    let done = 0
    while done == 0
        let p = parent[cur]
        if p == cur
            done = 1
            root = cur
        else
            cur = p
    // path compression
    cur = x
    let done2 = 0
    while done2 == 0
        let p = parent[cur]
        if p == root
            done2 = 1
        else
            parent[cur] = root
            cur = p
    return root

// _ce_uf_union: merge components of a and b; returns 1 if they were different, 0 if same.
fn _ce_uf_union(uf, a, b) -> int
    let ra = _ce_uf_find(uf, a)
    let rb = _ce_uf_find(uf, b)
    if ra == rb
        return 0
    let parent = uf[0]
    let rank = uf[1]
    let rka = rank[ra]
    let rkb = rank[rb]
    if rka < rkb
        parent[ra] = rb
    else
        if rka > rkb
            parent[rb] = ra
        else
            parent[rb] = ra
            rank[ra] = rka + 1
    return 1

// ─── public API ──────────────────────────────────────────────────────────────

// ce_has_cycle: returns true iff the undirected graph contains at least one cycle.
// Uses union-find: if merging u and v finds they are already connected, a cycle exists.
fn ce_has_cycle(adj, n) -> bool
    if n == 0
        return false
    let uf = _ce_uf_new(n)
    let u = 0
    let found = 0
    while u < n
        let nbrs = adj[u]
        let ni = 0
        while ni < len(nbrs)
            let v = nbrs[ni]
            // Only process each edge once: u < v to avoid double-counting
            if u < v
                let merged = _ce_uf_union(uf, u, v)
                if merged == 0
                    found = 1
            ni = ni + 1
        u = u + 1
    if found == 1
        return true
    return false

// _ce_bfs_girth: BFS from source node src; returns the length of the shortest
// cycle passing through src, or -1 if no cycle is found.
// dist[v] = BFS distance from src, -1 = unvisited.
fn _ce_bfs_girth(adj, n, src) -> int
    let dist = []
    let i = 0
    while i < n
        push(dist, -1)
        i = i + 1
    dist[src] = 0
    let queue = []
    push(queue, src)
    let head = 0
    let best = -1
    while head < len(queue)
        let u = queue[head]
        head = head + 1
        let du = dist[u]
        let nbrs = adj[u]
        let ni = 0
        while ni < len(nbrs)
            let v = nbrs[ni]
            let dv = dist[v]
            if dv == -1
                dist[v] = du + 1
                push(queue, v)
            else
                // v already visited and not the tree-parent direction
                // cycle length = dist[u] + dist[v] + 1
                if dv >= du
                    let cyc = du + dv + 1
                    if best == -1
                        best = cyc
                    else
                        if cyc < best
                            best = cyc
            ni = ni + 1
    return best

// ce_girth: returns the length of the shortest cycle in the undirected graph.
// Returns -1 if the graph is acyclic. Runs BFS from every node.
fn ce_girth(adj, n) -> int
    if n == 0
        return -1
    let best = -1
    let src = 0
    while src < n
        let g = _ce_bfs_girth(adj, n, src)
        if g != -1
            if best == -1
                best = g
            else
                if g < best
                    best = g
        src = src + 1
    return best

// _ce_mark_set: build a list of length n where mark[i]=1 if i is in the neighbor list nbrs.
fn _ce_mark_set(nbrs, n) -> list
    let mark = []
    let i = 0
    while i < n
        push(mark, 0)
        i = i + 1
    let j = 0
    while j < len(nbrs)
        let v = nbrs[j]
        mark[v] = 1
        j = j + 1
    return mark

// ce_count_triangles: returns the number of distinct 3-cliques (triangles) in the graph.
// For each ordered pair (u,v) with u<v that share an edge, count common neighbors w>v.
// Each triangle {u,v,w} is counted exactly once.
fn ce_count_triangles(adj, n) -> int
    if n < 3
        return 0
    let count = 0
    let u = 0
    while u < n
        // Build a membership set for neighbors of u
        let mark_u = _ce_mark_set(adj[u], n)
        let nbrs_u = adj[u]
        let ni = 0
        while ni < len(nbrs_u)
            let v = nbrs_u[ni]
            if v > u
                // For each neighbor v of u with v>u, find common neighbors w>v
                let nbrs_v = adj[v]
                let vi = 0
                while vi < len(nbrs_v)
                    let w = nbrs_v[vi]
                    if w > v
                        if mark_u[w] == 1
                            count = count + 1
                    vi = vi + 1
            ni = ni + 1
        u = u + 1
    return count
