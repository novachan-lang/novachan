// std/graph/connected.nova — Connected components for undirected graphs.
//
// Graph representation: adj is a dict mapping node-name STRING to a list of
// neighbor-name STRINGs (undirected, must be symmetric).
// nodes is a list of all node-name strings (needed to cover isolated nodes).
//
// Public API:
//   cc_components(adj, nodes)           -> list  list of components; each
//                                          component is a sorted node-name list;
//                                          components sorted by smallest member.
//   cc_count(adj, nodes)                -> int   number of connected components.
//   cc_is_connected(adj, nodes)         -> bool  true iff the graph is connected.
//   cc_component_of(adj, nodes, node)   -> list  sorted component containing node.
//
// Algorithm: Union-Find (path compression + union by rank) for O((V+E) α(V)).
// Module-private prefix: _cc_

// ─── Union-Find helpers ───────────────────────────────────────────────────────

// _cc_make_uf: create a union-find structure as a dict with two sub-dicts:
//   "parent" -> dict node->node
//   "rank"   -> dict node->int
fn _cc_make_uf(nodes) -> dict
    let parent = {}
    let rank = {}
    for i in 0..len(nodes)
        let v = nodes[i]
        parent[v] = v
        rank[v] = 0
    let uf = {}
    uf["parent"] = parent
    uf["rank"] = rank
    return uf

// _cc_find: path-compressing find — returns the root of node v.
// uf is mutated in-place.
fn _cc_find(uf, v) -> str
    let parent = uf["parent"]
    let root = v
    // walk to root
    let cur = v
    while parent[cur] != cur
        cur = parent[cur]
    root = cur
    // path compression: rewire all nodes on the path to point directly to root
    cur = v
    while parent[cur] != root
        let next = parent[cur]
        parent[cur] = root
        cur = next
    return root

// _cc_union: union by rank.  Merges the components of a and b.
fn _cc_union(uf, a, b)
    let ra = _cc_find(uf, a)
    let rb = _cc_find(uf, b)
    if ra == rb
        return
    let rank = uf["rank"]
    let parent = uf["parent"]
    let rka = rank[ra]
    let rkb = rank[rb]
    if rka < rkb
        parent[ra] = rb
    else
        if rka > rkb
            parent[rb] = ra
        else
            parent[rb] = ra
            rank[ra] = rka + 1

// _cc_build: run union-find over the whole graph, return the uf dict.
fn _cc_build(adj, nodes) -> dict
    let uf = _cc_make_uf(nodes)
    for i in 0..len(nodes)
        let u = nodes[i]
        if contains(adj, u)
            let nbrs = adj[u]
            let j = 0
            while j < len(nbrs)
                let v = nbrs[j]
                _cc_union(uf, u, v)
                j = j + 1
    return uf

// _cc_min_str: return the lexicographically smaller of two strings.
fn _cc_min_str(a, b) -> str
    if a < b
        return a
    return b

// _cc_sort_list: insertion-sort a list of strings in-place (ascending lex).
// Returns the sorted list (same reference, mutated).
fn _cc_sort_list(lst) -> list
    let n = len(lst)
    for i in 1..n
        let key = lst[i]
        let j = i - 1
        while j >= 0 and lst[j] > key
            lst[j + 1] = lst[j]
            j = j - 1
        lst[j + 1] = key
    return lst

// ─── internal: gather components as a list of lists ──────────────────────────

// _cc_gather: collect nodes into component lists keyed by their root.
// Returns a dict root->list-of-nodes (unsorted internally).
fn _cc_gather(uf, nodes) -> dict
    let groups = {}
    for i in 0..len(nodes)
        let v = nodes[i]
        let r = _cc_find(uf, v)
        if contains(groups, r)
            groups[r].push(v)
        else
            let grp = []
            grp.push(v)
            groups[r] = grp
    return groups

// _cc_components_raw: returns a list of components; each component is sorted
// internally; the outer list is sorted by the smallest (first) element.
fn _cc_components_raw(adj, nodes) -> list
    let uf = _cc_build(adj, nodes)
    let groups = _cc_gather(uf, nodes)
    // collect and sort each component internally
    let roots = keys(groups)
    let comps = []
    for i in 0..len(roots)
        let r = roots[i]
        let grp = groups[r]
        _cc_sort_list(grp)
        comps.push(grp)
    // sort comps by their smallest member (first element after internal sort)
    // insertion sort on comps list by comp[0]
    let n = len(comps)
    for j in 1..n
        let key_comp = comps[j]
        let key_val = key_comp[0]
        let k = j - 1
        while k >= 0 and comps[k][0] > key_val
            comps[k + 1] = comps[k]
            k = k - 1
        comps[k + 1] = key_comp
    return comps

// ─── Public API ───────────────────────────────────────────────────────────────

// cc_components: returns list of connected components.
// Each component is a sorted list of node names.
// Components are ordered by their lexicographically smallest member.
fn cc_components(adj, nodes) -> list
    return _cc_components_raw(adj, nodes)

// cc_count: returns the number of connected components.
fn cc_count(adj, nodes) -> int
    let comps = _cc_components_raw(adj, nodes)
    return len(comps)

// cc_is_connected: returns true iff the entire graph is a single component.
// An empty graph (no nodes) is considered connected.
fn cc_is_connected(adj, nodes) -> bool
    if len(nodes) == 0
        return true
    let comps = _cc_components_raw(adj, nodes)
    if len(comps) == 1
        return true
    return false

// cc_component_of: returns the sorted component containing the given node.
// If node is not in nodes, returns an empty list.
fn cc_component_of(adj, nodes, node) -> list
    let uf = _cc_build(adj, nodes)
    let groups = _cc_gather(uf, nodes)
    // find which root node belongs to
    let found = 0
    for i in 0..len(nodes)
        let v = nodes[i]
        if v == node
            found = 1
    if found == 0
        return []
    let r = _cc_find(uf, node)
    let grp = groups[r]
    _cc_sort_list(grp)
    return grp
