// ============================================================================
// NOVA Standard Library — std/config/envschema.nova
// ============================================================================
// Typed configuration from an environment dict with a schema.
//
// Public API
//   es_new()  -> dict
//       Create an empty schema descriptor.
//
//   es_field(schema, name, type, default, required) -> dict
//       Register a field on the schema and return the schema for chaining.
//       type in "int" / "float" / "bool" / "string"
//       default is a string (the raw env-var representation of the default).
//       required is a bool / int (1 = field must be present in envdict).
//
//   es_load(schema, envdict) -> dict
//       For every registered field, read the value from envdict (string keys
//       to string values) or fall back to the default, then coerce:
//         bool   "true"/"1"/"yes"/"on"  -> int 1  (anything else -> int 0)
//         int    parse decimal string   -> int
//         float  parse decimal string  -> float
//         string keep as string
//       Returns a dict mapping field name -> coerced value.
//
//   es_errors(schema, envdict) -> list
//       Returns a list of field names whose required flag is set but that
//       are absent from envdict.
//
// Design notes:
//   - Schema state lives in a dict: "fields" key holds a list of field-dicts.
//     Each field-dict has keys: "name", "type", "default", "required".
//   - Helper functions are prefixed _es_ to avoid cross-module collisions.
//   - NOVA cannot distinguish bool from int at runtime; bool fields are
//     returned as int 1 / 0.
//   - Uses native parse_int / parse_float builtins for correct coercion.
//   - Single-exit style where possible to avoid NOVA return-null mistag.
// ============================================================================

// _es_str_to_bool: canonical bool coercion.
// "true" / "1" / "yes" / "on" -> 1  (case-insensitive)
// everything else -> 0
fn _es_str_to_bool(s) -> int
    let lo = lower(s)
    let r = 0
    if lo == "true"
        r = 1
    else
        if lo == "1"
            r = 1
        else
            if lo == "yes"
                r = 1
            else
                if lo == "on"
                    r = 1
    r

// _es_coerce_int: parse raw string as integer via native builtin.
fn _es_coerce_int(raw) -> int
    let v = 0
    if len(raw) > 0
        v = parse_int(raw)
    v

// _es_coerce_float: parse raw string as float via native builtin.
fn _es_coerce_float(raw) -> float
    let fv = 0.0
    if len(raw) > 0
        fv = parse_float(raw)
    fv

// ----------------------------------------------------------------------------
// Public API
// ----------------------------------------------------------------------------

// es_new: create an empty schema descriptor.
fn es_new() -> dict
    let schema = {}
    schema["fields"] = []
    schema

// es_field: register a typed field on the schema.
// Returns the schema dict so calls can be chained.
fn es_field(schema, name, ftype, default, required) -> dict
    let field = {}
    field["name"]    = name
    field["type"]    = ftype
    field["default"] = default
    if required
        field["required"] = 1
    else
        field["required"] = 0
    let fields = schema["fields"]
    fields.push(field)
    schema

// es_load: load and coerce configuration from envdict using schema.
// Returns a dict mapping field name -> coerced value.
fn es_load(schema, envdict) -> dict
    let out = {}
    let fields = schema["fields"]
    let n = len(fields)
    for i in 0..n
        let field = fields[i]
        let name  = field["name"]
        let ftype = field["type"]
        let def   = field["default"]
        let raw = def
        if contains(envdict, name)
            raw = envdict[name]
        if ftype == "bool"
            out[name] = _es_str_to_bool(raw)
        else
            if ftype == "int"
                out[name] = _es_coerce_int(raw)
            else
                if ftype == "float"
                    out[name] = _es_coerce_float(raw)
                else
                    // "string" or unknown — pass through as string
                    out[name] = raw
    out

// es_errors: return list of required field names missing from envdict.
fn es_errors(schema, envdict) -> list
    let errs = []
    let fields = schema["fields"]
    let n = len(fields)
    for i in 0..n
        let field = fields[i]
        let req   = field["required"]
        if req == 1
            let name = field["name"]
            if not contains(envdict, name)
                errs.push(name)
    errs

fn main()
    print("envschema module loaded")
