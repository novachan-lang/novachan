// std/config/env — environment-variable config reader (ce_ API)
//
// WHAT:
//   ce_get / ce_get_int / ce_get_bool / ce_require / ce_prefix / ce_is_set
//   over process environment variables, for the std/config category.
//
// DUPLICATION NOTE: std/os/envconfig.nova (ec_ prefix) already implements
// this exact behavior — ec_get/ec_get_int/ec_get_bool/ec_require/ec_prefix.
// Rather than re-implement the same logic under a second prefix (which
// would violate "does this already exist?" — see quality-standards.md), this
// module is a thin re-export under the std/config-category ce_ names the
// caller asked for, delegating every shared operation to std/os/envconfig.
// ce_is_set is the one genuinely new operation (envconfig has no equivalent).
// FLAG FOR REVIEW: having both std/os/envconfig AND std/config/env with
// near-identical public surfaces under two prefixes is itself questionable
// API surface — worth deciding at the orchestration level whether one
// should simply re-export the other permanently, or whether std/config/env
// should be the canonical location and std/os/envconfig deprecated. Left
// as-is here since removing/deprecating an existing shipped module is a
// design call above this module's scope.
//
// NOTE on ce_prefix: exactly like ec_prefix, NOVA's runtime exposes only
// `env(name)` (single-key lookup) — there is no environ()-style builtin to
// enumerate the whole environment table. ce_prefix therefore takes an
// explicit list of candidate key suffixes to probe, matching envconfig's
// documented platform limitation (not a partial/fake "list all env vars").
//
// Public API:
//   ce_get(name, default)              -> string  env(name) if set
//                                                   (non-empty), else default.
//   ce_get_int(name, default)          -> int      parsed int if env(name)
//                                                   is a valid integer, else
//                                                   default.
//   ce_get_bool(name, default)         -> bool     "true"/"1" (ci) -> true,
//                                                   "false"/"0" -> false,
//                                                   anything else -> default.
//   ce_require(name)                   -> Result   ok(value) if set, else
//                                                   err("missing required
//                                                   env var: <name>").
//   ce_prefix(prefix, candidate_keys)  -> dict     "<prefix><key>" -> value
//                                                   for every key in
//                                                   candidate_keys whose env
//                                                   var is set.
//   ce_is_set(name)                    -> bool     true iff env(name) is a
//                                                   non-empty string.
//
// Imports std/os/envconfig for the shared lookup/coercion logic.
// ============================================================================

import std/os/envconfig

// ce_get(name, default) -> string
fn ce_get(name: string, default_value: string) -> string
    return ec_get(name, default_value)

// ce_get_int(name, default) -> int
fn ce_get_int(name: string, default_value: int) -> int
    return ec_get_int(name, default_value)

// ce_get_bool(name, default) -> bool
fn ce_get_bool(name: string, default_value: bool) -> bool
    return ec_get_bool(name, default_value)

// ce_require(name) -> Result  ok(value) if set and non-empty, else
// err("missing required env var: <name>").
fn ce_require(name: string) -> any
    return ec_require(name)

// ce_prefix(prefix, candidate_keys) -> dict  "<prefix><key>" -> value for
// each candidate key whose "<prefix><key>" env var is set (non-empty). See
// module header for why this takes an explicit candidate list rather than
// enumerating the whole environment.
fn ce_prefix(prefix: string, candidate_keys: any) -> any
    return ec_prefix(prefix, candidate_keys)

// ce_is_set(name) -> bool  true iff the environment variable is set to a
// non-empty string. This is the one operation envconfig does not already
// expose.
fn ce_is_set(name: string) -> bool
    return len(env(name)) > 0

fn main()
    print("config env module loaded")
