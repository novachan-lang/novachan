// std/term/hyperlink.nova — OSC 8 terminal hyperlinks and OSC 0 title.
//
// All functions return raw escape strings (no side effects).
// The caller writes to stdout to render the hyperlink or set the title.
//
// ESCAPE SEQUENCE NOTES
//   ESC = chr(27).  OSC prefix = chr(27)+"]".
//   ST  = chr(27)+chr(92)  (ESC backslash — ANSI String Terminator).
//   BEL alternative for ST = chr(7) — not used here; ST is more portable.
//   Sequences are built via string concatenation only — NEVER literal { }
//   (triggers NOVA interpolation) and NEVER "\e" or "\x1b".
//
// OSC 8 HYPERLINK FORMAT (per https://gist.github.com/egmontkob/eb114294efbcd5adb1944c9f3cb5feda)
//   ESC ] 8 ; params ; url ST  text  ESC ] 8 ; ; ST
//   params: empty for a plain link; "id=<id>" for a named/multi-cell link.
//   Closing sequence always uses empty params AND empty url.
//
// PUBLIC API
//   link(url, text)          -> OSC-8 hyperlink (no id)
//   link_id(url, text, id)   -> OSC-8 hyperlink with id param
//   set_title(title)         -> OSC 0 window/tab title sequence
//
// VALIDATION
//   Empty url: rendered as an empty url field (safe — produces a no-op link).
//   Empty text: rendered as empty visible text (safe).
//   Empty title: rendered as empty title field (safe).

// ── private helpers ────────────────────────────────────────────────────────────

// OSC prefix: ESC + "]"
fn _hl_osc() -> string
    let result = chr(27) + "]"
    result

// String Terminator: ESC + backslash  (chr(27)+chr(92))
fn _hl_st() -> string
    let result = chr(27) + chr(92)
    result

// Build one OSC 8 opener: ESC ] 8 ; <params> ; <url> ST
// params is "" for a plain link, "id=xyz" for a named link.
fn _hl_open(params: string, url: string) -> string
    let osc = _hl_osc()
    let st = _hl_st()
    let result = osc + "8;" + params + ";" + url + st
    result

// Build the OSC 8 closer: ESC ] 8 ; ; ST  (empty params, empty url)
fn _hl_close() -> string
    let osc = _hl_osc()
    let st = _hl_st()
    let result = osc + "8;;" + st
    result

// ── public API ────────────────────────────────────────────────────────────────

// link(url, text) -> ESC]8;;url ST  text  ESC]8;; ST
// Plain OSC 8 hyperlink with no id parameter.
fn link(url: string, text: string) -> string
    let opener = _hl_open("", url)
    let closer = _hl_close()
    let result = opener + text + closer
    result

// link_id(url, text, id) -> ESC]8;id=<id>;url ST  text  ESC]8;; ST
// OSC 8 hyperlink with an id parameter (for multi-cell / synchronized links).
fn link_id(url: string, text: string, id: string) -> string
    let params = "id=" + id
    let opener = _hl_open(params, url)
    let closer = _hl_close()
    let result = opener + text + closer
    result

// set_title(title) -> ESC ] 0 ; title ST
// Sets the terminal window title (and icon name) via OSC 0.
fn set_title(title: string) -> string
    let osc = _hl_osc()
    let st = _hl_st()
    let result = osc + "0;" + title + st
    result
