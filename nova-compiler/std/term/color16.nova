// std/term/color16.nova — 16-color ANSI SGR (foreground + background, normal + bright).
//
// Maps the 8 classic terminal color names to their SGR codes:
//   black red green yellow blue magenta cyan white
//   fg base 30; bg base 40; bright-fg base 90; bright-bg base 100.
//
// PUBLIC API
//   RESET         -> str   ESC[0m — reset all attributes
//   fg(name)      -> str   normal foreground SGR sequence, "" for unknown name
//   bg(name)      -> str   normal background SGR sequence, "" for unknown name
//   fg_bright(name) -> str bright foreground SGR sequence, "" for unknown name
//   bg_bright(name) -> str bright background SGR sequence, "" for unknown name
//   colorize(text, name) -> str  fg(name)+text+RESET, or plain text if unknown
//
// DESIGN NOTES
//   * ESC is chr(27) — NOVA may not recognise \e or \x1b literals.
//   * CSI = chr(27)+"[".  Sequences built by concatenation: no string interpolation
//     and no literal { } (those trigger NOVA interpolation/parse errors).
//   * The color-code table is a plain dict (name -> offset 0..7).
//     The offset is added to the relevant base (30/40/90/100) to form the SGR code.
//   * Unknown names return "" so callers can test emptiness without a crash.
//   * NOVA GOTCHAS obeyed:
//       - chr(27) for ESC; str(n) for integer->string
//       - no multi-line list/dict literals; no literal { } in strings
//       - every let must be read; reserved words avoided as var names
//       - push(list, x) mutates and returns unit; missing dict key reads 0
//       - no &&/||; use 'and'/'or' or nested if

// ── RESET ─────────────────────────────────────────────────────────────────────

// ESC[0m — clears all SGR attributes.
// Exposed as a zero-argument function because NOVA module-level lets are not
// visible across import boundaries.
fn RESET() -> str
    let r = chr(27) + "[0m"
    r

// ── internal offset table ────────────────────────────────────────────────────

// Build a dict mapping each of the 8 standard color names to its 0-based offset.
// black=0, red=1, green=2, yellow=3, blue=4, magenta=5, cyan=6, white=7.
fn _c16_offsets() -> dict
    let d = {}
    d["black"]   = 0
    d["red"]     = 1
    d["green"]   = 2
    d["yellow"]  = 3
    d["blue"]    = 4
    d["magenta"] = 5
    d["cyan"]    = 6
    d["white"]   = 7
    d

// ── internal SGR builder ─────────────────────────────────────────────────────

// Build an SGR sequence: ESC [ <code> m.
// code is passed as an integer and converted to its decimal string.
fn _c16_sgr(code: int) -> str
    let seq = chr(27) + "[" + str(code) + "m"
    seq

// ── public API ───────────────────────────────────────────────────────────────

// Normal foreground color (base 30).
// Returns "" for an unrecognised name.
fn fg(name: str) -> str
    let tbl = _c16_offsets()
    let result = ""
    if contains(tbl, name)
        let off = tbl[name]
        result = _c16_sgr(30 + off)
    result

// Normal background color (base 40).
// Returns "" for an unrecognised name.
fn bg(name: str) -> str
    let tbl = _c16_offsets()
    let result = ""
    if contains(tbl, name)
        let off = tbl[name]
        result = _c16_sgr(40 + off)
    result

// Bright (intense) foreground color (base 90).
// Returns "" for an unrecognised name.
fn fg_bright(name: str) -> str
    let tbl = _c16_offsets()
    let result = ""
    if contains(tbl, name)
        let off = tbl[name]
        result = _c16_sgr(90 + off)
    result

// Bright (intense) background color (base 100).
// Returns "" for an unrecognised name.
fn bg_bright(name: str) -> str
    let tbl = _c16_offsets()
    let result = ""
    if contains(tbl, name)
        let off = tbl[name]
        result = _c16_sgr(100 + off)
    result

// Wrap text with a foreground color and a trailing reset sequence.
// If name is not recognised, returns the plain text unchanged.
fn colorize(text: str, name: str) -> str
    let prefix = fg(name)
    let result = text
    if len(prefix) > 0
        result = prefix + text + RESET()
    result
