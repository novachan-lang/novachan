// ============================================================================
// NOVA Standard Library — std/term/style
// ============================================================================
// ANSI SGR (Select Graphic Rendition) text-style escape sequences.
//
// All functions return ESC [ <code> m strings built with chr(27)
// — never "\e" or "\x1b" which NOVA does not interpret.
//
// PUBLIC API
//   bold()      -> string   ESC[1m
//   dim()       -> string   ESC[2m
//   italic()    -> string   ESC[3m
//   underline() -> string   ESC[4m
//   blink()     -> string   ESC[5m
//   reverse()   -> string   ESC[7m
//   hidden()    -> string   ESC[8m
//   strike()    -> string   ESC[9m
//   reset()     -> string   ESC[0m
//   style(text, name) -> string
//     Wraps text with the named style escape + reset.
//     Recognised names: bold dim italic underline blink reverse hidden strike.
//     Unknown name returns text unchanged.

// ── private helper ────────────────────────────────────────────────────────────

// Build ESC [ <code> m from an integer SGR code.
fn _sgr(code: int) -> str
    chr(27) + "[" + str(code) + "m"

// ── public style accessors ────────────────────────────────────────────────────

fn bold() -> str
    _sgr(1)

fn dim() -> str
    _sgr(2)

fn italic() -> str
    _sgr(3)

fn underline() -> str
    _sgr(4)

fn blink() -> str
    _sgr(5)

fn reverse() -> str
    _sgr(7)

fn hidden() -> str
    _sgr(8)

fn strike() -> str
    _sgr(9)

fn reset() -> str
    _sgr(0)

// ── style(text, name) ─────────────────────────────────────────────────────────

// Apply a named SGR style to text, appending reset() afterwards.
// Returns text unchanged for unrecognised names.
fn style(text: str, name: str) -> str
    let esc = ""
    if name == "bold"
        esc = bold()
    if name == "dim"
        esc = dim()
    if name == "italic"
        esc = italic()
    if name == "underline"
        esc = underline()
    if name == "blink"
        esc = blink()
    if name == "reverse"
        esc = reverse()
    if name == "hidden"
        esc = hidden()
    if name == "strike"
        esc = strike()
    if len(esc) == 0
        return text
    esc + text + reset()
