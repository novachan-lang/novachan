// ============================================================================
// NOVA Standard Library — std/term/color256
// ============================================================================
// 256-color and 24-bit truecolor ANSI SGR escape sequences.
//
// ANSI 256-color palette (xterm-256color):
//   fg: ESC[38;5;{n}m   (n = 0..255)
//   bg: ESC[48;5;{n}m
//
// Truecolor (24-bit, ISO 8613-6 / ITU T.416):
//   fg: ESC[38;2;{r};{g};{b}m
//   bg: ESC[48;2;{r};{g};{b}m
//
// Reset SGR: ESC[0m
//
// PUBLIC API
//   fg256(n: int) -> str
//     ESC[38;5;{n}m  — 256-color foreground.  n clamped 0..255.
//
//   bg256(n: int) -> str
//     ESC[48;5;{n}m  — 256-color background.  n clamped 0..255.
//
//   fg_rgb(r: int, g: int, b: int) -> str
//     ESC[38;2;{r};{g};{b}m  — 24-bit truecolor foreground.
//     r, g, b each clamped 0..255.
//
//   bg_rgb(r: int, g: int, b: int) -> str
//     ESC[48;2;{r};{g};{b}m  — 24-bit truecolor background.
//     r, g, b each clamped 0..255.
//
//   colorize256(text: str, n: int) -> str
//     Wraps text in fg256(n) + text + SGR-reset.
//     Returns text unchanged if text is empty.
//
// DESIGN NOTES
//   - ESC = chr(27).  NOVA does not interpret "\e" or "\x1b".
//   - CSI = chr(27) + "[".  All sequences built by concatenation.
//   - No string interpolation: { } in string literals triggers NOVA's
//     interpolator.  All numbers inserted via str(n).
//   - ST (String Terminator) would be chr(27)+chr(92) — not needed here.
//   - All helpers prefixed _c256_ to avoid symbol collisions when multiple
//     term modules are imported together.

// ── private helpers ──────────────────────────────────────────────────────────

// ESC character.
fn _c256_esc() -> str
    return chr(27)

// CSI = ESC + "[".
fn _c256_csi() -> str
    return chr(27) + "["

// SGR reset sequence: ESC[0m.
fn _c256_reset() -> str
    return chr(27) + "[0m"

// Clamp an integer to [0, 255].
fn _c256_clamp(n: int) -> int
    let v = n
    if v < 0
        v = 0
    if v > 255
        v = 255
    return v

// ── public API ───────────────────────────────────────────────────────────────

// fg256: 256-color foreground SGR.  ESC[38;5;{n}m.  n clamped 0..255.
fn fg256(n: int) -> str
    let v = _c256_clamp(n)
    return _c256_csi() + "38;5;" + str(v) + "m"

// bg256: 256-color background SGR.  ESC[48;5;{n}m.  n clamped 0..255.
fn bg256(n: int) -> str
    let v = _c256_clamp(n)
    return _c256_csi() + "48;5;" + str(v) + "m"

// fg_rgb: 24-bit truecolor foreground SGR.  ESC[38;2;{r};{g};{b}m.
// Each channel clamped 0..255.
fn fg_rgb(r: int, g: int, b: int) -> str
    let rv = _c256_clamp(r)
    let gv = _c256_clamp(g)
    let bv = _c256_clamp(b)
    return _c256_csi() + "38;2;" + str(rv) + ";" + str(gv) + ";" + str(bv) + "m"

// bg_rgb: 24-bit truecolor background SGR.  ESC[48;2;{r};{g};{b}m.
// Each channel clamped 0..255.
fn bg_rgb(r: int, g: int, b: int) -> str
    let rv = _c256_clamp(r)
    let gv = _c256_clamp(g)
    let bv = _c256_clamp(b)
    return _c256_csi() + "48;2;" + str(rv) + ";" + str(gv) + ";" + str(bv) + "m"

// colorize256: wrap text in fg256(n) ... SGR-reset.
// Returns text unchanged when text is empty (avoids emitting bare escape codes).
fn colorize256(text: str, n: int) -> str
    if len(text) == 0
        return text
    return fg256(n) + text + _c256_reset()
