// std/term/spinner.nova — Spinner animation frame sets for terminal progress indicators.
//
// Provides four spinner styles as lists of frame strings:
//   "line"   — classic ASCII:  |  /  -  \
//   "dots"   — Unicode braille: 4-frame braille rotation
//   "arrow"  — Unicode arrows: four rotational arrow chars
//   "bounce" — ASCII bouncing block: [ ] movement pattern
//
// PUBLIC API
//   spinner_frames(style) -> list   all frame strings for the named style
//   spinner_at(style, i)  -> str    frame at index i mod count (safe wrap)
//   spinner_count(style)  -> int    number of frames for the style
//
// Unknown style returns the "line" fallback — never crashes.
//
// DESIGN NOTES
//   * No ANSI escape sequences needed — frames are plain Unicode/ASCII strings.
//   * chr(92) = backslash — avoids any potential escape-sequence ambiguity.
//   * push(list,x) mutates and returns unit; lists built one push at a time.
//   * No multi-line list literals, no { } in strings (NOVA interpolation guard).
//   * Every let is read; no reserved words used as var names.

// ── internal frame builders ────────────────────────────────────────────────

fn _line_frames() -> list
    let frames = []
    push(frames, "|")
    push(frames, "/")
    push(frames, "-")
    push(frames, chr(92))
    frames

fn _dots_frames() -> list
    let frames = []
    push(frames, chr(8964))
    push(frames, chr(8965))
    push(frames, chr(8966))
    push(frames, chr(8967))
    frames

fn _arrow_frames() -> list
    let frames = []
    push(frames, chr(8593))
    push(frames, chr(8594))
    push(frames, chr(8595))
    push(frames, chr(8592))
    frames

fn _bounce_frames() -> list
    let frames = []
    push(frames, "[=   ]")
    push(frames, "[ =  ]")
    push(frames, "[  = ]")
    push(frames, "[   =]")
    push(frames, "[  = ]")
    push(frames, "[ =  ]")
    frames

// ── public API ────────────────────────────────────────────────────────────

// spinner_frames returns the list of frame strings for the given style.
// Unknown style falls back to "line" (never crashes).
fn spinner_frames(style) -> list
    let result = []
    if style == "line"
        result = _line_frames()
    else if style == "dots"
        result = _dots_frames()
    else if style == "arrow"
        result = _arrow_frames()
    else if style == "bounce"
        result = _bounce_frames()
    else
        result = _line_frames()
    result

// spinner_count returns the number of frames for the given style.
fn spinner_count(style) -> int
    let frames = spinner_frames(style)
    len(frames)

// spinner_at returns the frame at position i (wraps around via mod).
// Safe for any integer i including negatives after mod.
fn spinner_at(style, i) -> str
    let frames = spinner_frames(style)
    let n = len(frames)
    let idx = i % n
    if idx < 0
        idx += n
    frames[idx]
