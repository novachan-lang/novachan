// ============================================================================
// NOVA Standard Library — std/term/strip
// ============================================================================
// Strip ANSI / CSI / OSC escape sequences from a string; measure visible width.
//
// Escape sequence grammar handled:
//   CSI  = ESC '[' <param/intermediate bytes>* <final-byte>
//          where ESC=chr(27), final-byte has ord in [64..126] (0x40..0x7E).
//          Covers: SGR, cursor movement, erase, scroll, … everything CSI.
//   OSC  = ESC ']' <any>* (ST | BEL)
//          ST = ESC chr(92), BEL = chr(7).
//          Covers: title, color queries, hyperlinks, …
//   Bare ESC followed by any single byte that is NOT '[' or ']' is also
//   consumed (Fe/Fs two-byte sequences like ESC M, ESC 7, ESC c, etc.).
//   Malformed / truncated sequences at end-of-string are consumed silently
//   (no partial escape leaks into output).
//
// Public API:
//   strip_ansi(s)  -> str   remove all escape sequences, return bare text
//   visible_len(s) -> int   length of strip_ansi(s) — O(n), no extra alloc
//   has_ansi(s)    -> bool  true if s contains at least one ESC sequence
//
// Complexity: O(n) time, O(n) space for strip_ansi; O(n) time O(1) extra
// space for visible_len; O(n) worst-case early-exit for has_ansi.
// ============================================================================

// Internal: scan one CSI sequence starting just AFTER the ESC '['.
// Returns the index of the first byte after the full sequence (i.e. past
// the final byte). i must already point past the '['.
fn _skip_csi(s, i, n) -> int
    let done = 0
    while i < n and done == 0
        let b = ord(slice(s, i, i + 1))
        // Final byte: 0x40 (64) .. 0x7E (126)
        if b >= 64 and b <= 126
            i = i + 1
            done = 1
        else
            i = i + 1
    i

// Internal: scan one OSC sequence starting just AFTER the ESC ']'.
// Terminated by ST (ESC chr(92)) or BEL (chr(7)). Consume the terminator.
fn _skip_osc(s, i, n) -> int
    let done = 0
    while i < n and done == 0
        let b = ord(slice(s, i, i + 1))
        if b == 7
            // BEL terminator
            i = i + 1
            done = 1
        else
            if b == 27 and i + 1 < n
                let nb = ord(slice(s, i + 1, i + 2))
                if nb == 92
                    // ESC '\' = String Terminator
                    i = i + 2
                    done = 1
                else
                    i = i + 1
            else
                i = i + 1
    i

// ── strip_ansi ────────────────────────────────────────────────────────────────

// Remove all CSI, OSC, and bare-ESC sequences from s.
// Returns the visible text content with no ANSI control sequences.
fn strip_ansi(s) -> str
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(slice(s, i, i + 1))
        if b == 27
            // ESC — look at next byte to classify
            if i + 1 < n
                let nb = ord(slice(s, i + 1, i + 2))
                if nb == 91
                    // ESC '[' → CSI sequence
                    i = _skip_csi(s, i + 2, n)
                else
                    if nb == 93
                        // ESC ']' → OSC sequence
                        i = _skip_osc(s, i + 2, n)
                    else
                        // Bare two-byte escape (Fe/Fs): ESC + one byte, skip both
                        i = i + 2
            else
                // Lone ESC at end-of-string — consume it, no output
                i = i + 1
        else
            out = out + slice(s, i, i + 1)
            i = i + 1
    out

// ── visible_len ───────────────────────────────────────────────────────────────

// Return the number of visible (non-escape) characters in s.
// Equivalent to len(strip_ansi(s)) but avoids building the output string.
fn visible_len(s) -> int
    let count = 0
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(slice(s, i, i + 1))
        if b == 27
            if i + 1 < n
                let nb = ord(slice(s, i + 1, i + 2))
                if nb == 91
                    i = _skip_csi(s, i + 2, n)
                else
                    if nb == 93
                        i = _skip_osc(s, i + 2, n)
                    else
                        i = i + 2
            else
                i = i + 1
        else
            count = count + 1
            i = i + 1
    count

// ── has_ansi ──────────────────────────────────────────────────────────────────

// Return true (1) if s contains at least one ESC-introduced sequence,
// false (0) otherwise. Early-exit on first ESC found.
fn has_ansi(s) -> bool
    let i = 0
    let n = len(s)
    let found = 0
    while i < n and found == 0
        let b = ord(slice(s, i, i + 1))
        if b == 27
            found = 1
        else
            i = i + 1
    found == 1
