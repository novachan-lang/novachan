// std/typesystem/type_higher — Kind system for higher-kinded types.
// LEAF module — imports NOTHING.
//
// A kind is:
//   ["star"]         — the kind of ordinary types (*)
//   ["karr", k1, k2] — the kind of type constructors (k1 -> k2)
//
// Type-constructor kinds:
//   int, bool : *           (fully saturated base types)
//   list      : * -> *      (takes one type arg)
//   pair      : * -> * -> * (takes two type args)
//
// Public type builders (tyc_ prefix, self-contained copy):
//   tyc_tvar(k), tyc_arr(a,b), tyc_con(name,args), tyc_int(), tyc_bool(),
//   tyc_list(a), tyc_pair(a,b)
//
// Public API (thk_ prefix):
//   thk_star()                         -> ["star"]
//   thk_karr(k1, k2)                   -> ["karr", k1, k2]
//   thk_kind_of_con(name)              -> kind of the UNapplied constructor name
//   thk_apply(con_kind, arg_kinds)     -> kind after applying constructor to args,
//                                         or "FAIL" if kinds don't match
//   thk_kind_equal(k1, k2)             -> bool (structural equality on kinds)
//   thk_kind_str(k)                    -> string (for debugging)

// ── Type builders (self-contained copy) ──────────────────────────────────────

// tyc_tvar — build a type variable node.
fn tyc_tvar(k: int) -> list
    let t = []
    push(t, "tvar")
    push(t, k)
    return t

// tyc_arr — build a function type node.
fn tyc_arr(a: list, b: list) -> list
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    return t

// tyc_con — build a type constructor node.
fn tyc_con(name: string, args: list) -> list
    let t = []
    push(t, "con")
    push(t, name)
    push(t, args)
    return t

// tyc_int — build the Int base type.
fn tyc_int() -> list
    let args = []
    return tyc_con("int", args)

// tyc_bool — build the Bool base type.
fn tyc_bool() -> list
    let args = []
    return tyc_con("bool", args)

// tyc_list — build a list type.
fn tyc_list(a: list) -> list
    let args = []
    push(args, a)
    return tyc_con("list", args)

// tyc_pair — build a pair type.
fn tyc_pair(a: list, b: list) -> list
    let args = []
    push(args, a)
    push(args, b)
    return tyc_con("pair", args)

// ── Kind constructors ──────────────────────────────────────────────────────────

// thk_star — the base kind *.
fn thk_star() -> list
    let k = []
    push(k, "star")
    return k

// thk_karr — the arrow kind k1 -> k2.
fn thk_karr(k1: list, k2: list) -> list
    let k = []
    push(k, "karr")
    push(k, k1)
    push(k, k2)
    return k

// ── Kind equality ──────────────────────────────────────────────────────────────

// thk_kind_equal — structural equality on kinds.
fn thk_kind_equal(k1: list, k2: list) -> bool
    let tag1 = k1[0]
    let tag2 = k2[0]
    if tag1 != tag2
        return false
    if tag1 == "star"
        return true
    // both "karr"
    if thk_kind_equal(k1[1], k2[1]) == false
        return false
    return thk_kind_equal(k1[2], k2[2])

// ── Kind of a type constructor ─────────────────────────────────────────────────

// thk_kind_of_con — return the kind of an UNapplied type constructor.
// int, bool -> *
// list -> * -> *
// pair -> * -> * -> *
// Unknown constructors default to *.
fn thk_kind_of_con(name: string) -> list
    if name == "int"
        return thk_star()
    if name == "bool"
        return thk_star()
    if name == "list"
        // * -> *
        return thk_karr(thk_star(), thk_star())
    if name == "pair"
        // * -> * -> *  modeled as * -> (* -> *)
        return thk_karr(thk_star(), thk_karr(thk_star(), thk_star()))
    // unknown constructor: assume *
    return thk_star()

// ── Kind application ───────────────────────────────────────────────────────────

// thk_apply — compute the result kind of applying a constructor of kind con_kind
// to a list of argument kinds.
// Returns the result kind, or the string "FAIL" if any argument kind mismatches.
//
// Algorithm: fold left; at each step, if current kind is karr(a,b) and
// next arg kind equals a, the result kind becomes b. Otherwise FAIL.
fn thk_apply(con_kind: list, arg_kinds: list) -> list
    let cur = con_kind
    let i = 0
    let n = len(arg_kinds)
    let failed = 0
    while i < n
        if failed == 1
            i += 1
        else
            let ak = arg_kinds[i]
            if cur[0] != "karr"
                // too many arguments
                failed = 1
            else
                let param_k = cur[1]
                let result_k = cur[2]
                if thk_kind_equal(param_k, ak) == false
                    failed = 1
                else
                    cur = result_k
            i += 1
    if failed == 1
        // return a sentinel list encoding FAIL
        let f = []
        push(f, "FAIL")
        return f
    return cur

// thk_apply_fails — return 1 if thk_apply returned FAIL sentinel.
fn thk_apply_fails(k: list) -> int
    if k[0] == "FAIL"
        return 1
    return 0

// ── Kind pretty-printing ───────────────────────────────────────────────────────

// thk_kind_str — print a kind as a string (for debugging and tests).
fn thk_kind_str(k: list) -> string
    if k[0] == "star"
        return "*"
    if k[0] == "FAIL"
        return "FAIL"
    // karr: right-associative; wrap left in parens only if it is also karr
    let k1 = k[1]
    let k2 = k[2]
    let left = ""
    if k1[0] == "karr"
        left = "(" + thk_kind_str(k1) + ")"
    else
        left = thk_kind_str(k1)
    return left + " -> " + thk_kind_str(k2)
