// std/typesystem/type_check — Simply-typed lambda calculus type checker.
//
// TYPE REPRESENTATION (tagged lists):
//   ["tvar", k]          — type variable (k = int id)
//   ["arr", a, b]        — function type a -> b
//   ["con", name, args]  — type constructor (name = string, args = list of types)
//     Base types: ["con","int",[]]  ["con","bool",[]]
//
// TERMS (annotated simply-typed lambda):
//   ["var", name]              — variable (name = string)
//   ["ann", term, ty]          — annotated term (ascription)
//   ["lamA", name, argty, body]— lambda with explicit argument type
//   ["app", f, a]              — application
//
// ENVIRONMENT: list of [name, type] pairs.
//
// All public functions are prefixed tchk_.

// --- Type constructors ---

// Build the int base type.
fn tyc_int() -> list
    let t = []
    push(t, "con")
    push(t, "int")
    let args = []
    push(t, args)
    return t

// Build the bool base type.
fn tyc_bool() -> list
    let t = []
    push(t, "con")
    push(t, "bool")
    let args = []
    push(t, args)
    return t

// Build a function type a -> b.
fn tyc_arr(a, b) -> list
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    return t

// Build a tvar type.
fn tyc_tvar(k) -> list
    let t = []
    push(t, "tvar")
    push(t, k)
    return t

// Build a pair constructor type.
fn tyc_pair(a, b) -> list
    let t = []
    push(t, "con")
    push(t, "pair")
    let args = []
    push(args, a)
    push(args, b)
    push(t, args)
    return t

// Build a list constructor type.
fn tyc_list(a) -> list
    let t = []
    push(t, "con")
    push(t, "list")
    let args = []
    push(args, a)
    push(t, args)
    return t

// --- Structural equality on types ---

// Compare two scalar values (int or string) for equality.
fn _tchk_scalar_eq(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "int"
        if a == b
            return 1
        return 0
    if ta == "string"
        if a == b
            return 1
        return 0
    return 0

// Structural (deep) equality of two types. Returns 1 if equal, 0 otherwise.
fn tchk_type_eq(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "list"
        let na = len(a)
        let nb = len(b)
        if na != nb
            return 0
        let i = 0
        let ok = 1
        while i < na
            let ai = a[i]
            let bi = b[i]
            if type_of(ai) == "list"
                let sub = tchk_type_eq(ai, bi)
                if sub == 0
                    ok = 0
            else
                let veq = _tchk_scalar_eq(ai, bi)
                if veq == 0
                    ok = 0
            i += 1
        return ok
    return _tchk_scalar_eq(a, b)

// --- Environment lookup ---

// Look up a variable name in the environment. Returns the type or "FAIL".
fn _tchk_env_lookup(env, name) -> any
    // Scan NEWEST-first: bindings are appended at the end, so an inner (later)
    // binding must shadow an outer one with the same name (lexical scoping).
    let i = len(env) - 1
    while i >= 0
        let pair = env[i]
        if pair[0] == name
            return pair[1]
        i -= 1
    return "FAIL"

// --- Type inference (simply-typed, no unification) ---

// tchk_infer_st: infer the type of a term under env.
// Returns the type (a list) or "FAIL" (a string) on type error.
fn tchk_infer_st(env, term) -> any
    let tag = term[0]
    if tag == "var"
        let name = term[1]
        let ty = _tchk_env_lookup(env, name)
        return ty
    if tag == "ann"
        let inner = term[1]
        let annty = term[2]
        let inferred = tchk_infer_st(env, inner)
        if type_of(inferred) == "string"
            return "FAIL"
        let eq = tchk_type_eq(inferred, annty)
        if eq == 0
            return "FAIL"
        return annty
    if tag == "lamA"
        let name = term[1]
        let argty = term[2]
        let body = term[3]
        let newenv = []
        for i in 0..len(env)
            push(newenv, env[i])
        let pair = []
        push(pair, name)
        push(pair, argty)
        push(newenv, pair)
        let bodyty = tchk_infer_st(newenv, body)
        if type_of(bodyty) == "string"
            return "FAIL"
        return tyc_arr(argty, bodyty)
    if tag == "app"
        let f = term[1]
        let a = term[2]
        let fty = tchk_infer_st(env, f)
        if type_of(fty) == "string"
            return "FAIL"
        if fty[0] != "arr"
            return "FAIL"
        let domty = fty[1]
        let codty = fty[2]
        let aty = tchk_infer_st(env, a)
        if type_of(aty) == "string"
            return "FAIL"
        let eq = tchk_type_eq(domty, aty)
        if eq == 0
            return "FAIL"
        return codty
    return "FAIL"

// tchk_check: check that term has type ty under env. Returns 1 (true) or 0 (false).
fn tchk_check(env, term, ty) -> int
    let inferred = tchk_infer_st(env, term)
    if type_of(inferred) == "string"
        return 0
    return tchk_type_eq(inferred, ty)
