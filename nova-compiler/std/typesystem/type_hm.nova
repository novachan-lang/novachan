// ============================================================================
// NOVA Standard Library — std/typesystem/type_hm.nova
// Full Hindley-Milner with let-polymorphism (var/lam/app/let).
// Schemes = ["forall", quantified_id_list, type].
// Failure = string "FAIL". Leaf module — imports NOTHING.
// All public functions prefixed thm_.
// ============================================================================

// ---------------------------------------------------------------------------
// Type constructors
// ---------------------------------------------------------------------------

// _thm_tvar(k) — type variable.
fn _thm_tvar(k)
    let t = []
    push(t, "tvar")
    push(t, k)
    t

// _thm_arr(a, b) — function type a -> b.
fn _thm_arr(a, b)
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    t

// _thm_con(name, args) — type constructor.
fn _thm_con(name, args)
    let t = []
    push(t, "con")
    push(t, name)
    push(t, args)
    t

// ---------------------------------------------------------------------------
// Fresh variable counter
// ---------------------------------------------------------------------------

fn _thm_fresh(ctr)
    let id = ctr[0]
    ctr[0] = ctr[0] + 1
    _thm_tvar(id)

// ---------------------------------------------------------------------------
// Occurs check
// ---------------------------------------------------------------------------

fn _thm_occurs(k, t)
    let tag = t[0]
    if tag == "tvar"
        if t[1] == k
            return 1
        return 0
    if tag == "arr"
        if _thm_occurs(k, t[1]) == 1
            return 1
        return _thm_occurs(k, t[2])
    if tag == "con"
        let args = t[2]
        for i in 0..len(args)
            if _thm_occurs(k, args[i]) == 1
                return 1
        return 0
    0

// ---------------------------------------------------------------------------
// Apply substitution to a type
// ---------------------------------------------------------------------------

fn _thm_apply(sub, t)
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let i = 0
        let result = t
        while i < len(sub)
            let pair = sub[i]
            if pair[0] == k
                result = _thm_apply(sub, pair[1])
            i += 1
        result
    else
        if tag == "arr"
            let a2 = _thm_apply(sub, t[1])
            let b2 = _thm_apply(sub, t[2])
            _thm_arr(a2, b2)
        else
            if tag == "con"
                let nm = t[1]
                let args = t[2]
                let new_args = []
                for i in 0..len(args)
                    push(new_args, _thm_apply(sub, args[i]))
                _thm_con(nm, new_args)
            else
                t

// ---------------------------------------------------------------------------
// Apply substitution to a scheme ["forall", qs, body]
// (only applies to the body; quantified vars are not free)
// ---------------------------------------------------------------------------

fn _thm_apply_scheme(sub, sc)
    let qs = sc[1]
    let body = sc[2]
    // Filter out from sub any bindings for quantified vars
    let qs_set = {}
    for qi in 0..len(qs)
        qs_set[str(qs[qi])] = 1
    let filtered = []
    for fi in 0..len(sub)
        let pair = sub[fi]
        if not contains(qs_set, str(pair[0]))
            push(filtered, pair)
    let new_body = _thm_apply(filtered, body)
    let new_sc = []
    push(new_sc, "forall")
    push(new_sc, qs)
    push(new_sc, new_body)
    new_sc

// ---------------------------------------------------------------------------
// Apply substitution to environment (list of [name, scheme] pairs)
// ---------------------------------------------------------------------------

fn _thm_apply_env(sub, env)
    let out = []
    for i in 0..len(env)
        let binding = env[i]
        let pair = []
        push(pair, binding[0])
        push(pair, _thm_apply_scheme(sub, binding[1]))
        push(out, pair)
    out

// ---------------------------------------------------------------------------
// Compose substitutions: compose(s2, s1) = s1 then s2.
// ---------------------------------------------------------------------------

fn _thm_compose(s2, s1)
    let result = []
    for i in 0..len(s1)
        let pair = s1[i]
        let new_pair = []
        push(new_pair, pair[0])
        push(new_pair, _thm_apply(s2, pair[1]))
        push(result, new_pair)
    let s1keys = {}
    for ki in 0..len(s1)
        s1keys[str(s1[ki][0])] = 1
    for j in 0..len(s2)
        let pair2 = s2[j]
        if not contains(s1keys, str(pair2[0]))
            push(result, pair2)
    result

// ---------------------------------------------------------------------------
// Unification
// ---------------------------------------------------------------------------

fn _thm_unify(s, t)
    let stag = s[0]
    let ttag = t[0]
    if stag == "tvar"
        let k = s[1]
        if ttag == "tvar"
            if t[1] == k
                return []
        if _thm_occurs(k, t) == 1
            return "FAIL"
        let pair = []
        push(pair, k)
        push(pair, t)
        let sub = []
        push(sub, pair)
        return sub
    if ttag == "tvar"
        return _thm_unify(t, s)
    if stag == "arr"
        if ttag == "arr"
            let s1 = _thm_unify(s[1], t[1])
            if s1 == "FAIL"
                return "FAIL"
            let s2 = _thm_unify(_thm_apply(s1, s[2]), _thm_apply(s1, t[2]))
            if s2 == "FAIL"
                return "FAIL"
            return _thm_compose(s2, s1)
        return "FAIL"
    if stag == "con"
        if ttag == "con"
            if s[1] != t[1]
                return "FAIL"
            let sargs = s[2]
            let targs = t[2]
            if len(sargs) != len(targs)
                return "FAIL"
            let sub = []
            for i in 0..len(sargs)
                let si = _thm_unify(_thm_apply(sub, sargs[i]), _thm_apply(sub, targs[i]))
                if si == "FAIL"
                    return "FAIL"
                sub = _thm_compose(si, sub)
            return sub
        return "FAIL"
    "FAIL"

// ---------------------------------------------------------------------------
// Free type variables in a type
// ---------------------------------------------------------------------------

fn _thm_ftv_type(t, seen, out)
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let ks = str(k)
        if ks not in seen
            seen[ks] = 1
            push(out, k)
    if tag == "arr"
        _thm_ftv_type(t[1], seen, out)
        _thm_ftv_type(t[2], seen, out)
    if tag == "con"
        let args = t[2]
        for i in 0..len(args)
            _thm_ftv_type(args[i], seen, out)

fn _thm_type_ftv(t)
    let seen = {}
    let out = []
    _thm_ftv_type(t, seen, out)
    out

// Free type variables in the environment (through schemes)
fn _thm_env_ftv(env)
    let seen = {}
    let out = []
    for i in 0..len(env)
        let binding = env[i]
        let sc = binding[1]
        let qs = sc[1]
        let body = sc[2]
        let qset = {}
        for qi in 0..len(qs)
            qset[str(qs[qi])] = 1
        let bvars = _thm_type_ftv(body)
        for bi in 0..len(bvars)
            let k = bvars[bi]
            let ks = str(k)
            if ks not in qset
                if ks not in seen
                    seen[ks] = 1
                    push(out, k)
    out

// ---------------------------------------------------------------------------
// Generalize: quantify over tvars free in t but not in env.
// ---------------------------------------------------------------------------

fn _thm_generalize(env, t)
    let tfvs = _thm_type_ftv(t)
    let efvs = _thm_env_ftv(env)
    let eset = {}
    for ei in 0..len(efvs)
        eset[str(efvs[ei])] = 1
    let qs = []
    for ti in 0..len(tfvs)
        let k = tfvs[ti]
        if not contains(eset, str(k))
            push(qs, k)
    let sc = []
    push(sc, "forall")
    push(sc, qs)
    push(sc, t)
    sc

// ---------------------------------------------------------------------------
// Instantiate: replace quantified vars with fresh type variables.
// ---------------------------------------------------------------------------

fn _thm_instantiate(sc, ctr)
    let qs = sc[1]
    let body = sc[2]
    let sub = []
    for qi in 0..len(qs)
        let old_id = qs[qi]
        let new_id = ctr[0]
        ctr[0] = ctr[0] + 1
        let pair = []
        push(pair, old_id)
        push(pair, _thm_tvar(new_id))
        push(sub, pair)
    _thm_apply(sub, body)

// ---------------------------------------------------------------------------
// Environment lookup
// ---------------------------------------------------------------------------

fn _thm_env_lookup(env, name)
    // Scan NEWEST-first so an inner binding shadows an outer same-named one.
    let i = len(env) - 1
    while i >= 0
        let binding = env[i]
        if binding[0] == name
            return binding[1]
        i -= 1
    "FAIL"

// ---------------------------------------------------------------------------
// Algorithm W — full HM with let-polymorphism
// Returns ["sub", type] or "FAIL".
// env is a list of [name, scheme] pairs.
// ---------------------------------------------------------------------------

fn _thm_w(env, term, ctr)
    let tag = term[0]
    if tag == "var"
        let name = term[1]
        let sc = _thm_env_lookup(env, name)
        if sc == "FAIL"
            return "FAIL"
        // Instantiate the scheme to get a fresh monotype
        let mono = _thm_instantiate(sc, ctr)
        let res = []
        push(res, [])
        push(res, mono)
        return res
    if tag == "lam"
        let x = term[1]
        let body = term[2]
        // Fresh tvar for parameter; wrap as mono scheme
        let a = _thm_fresh(ctr)
        let a_sc = []
        push(a_sc, "forall")
        let empty_qs = []
        push(a_sc, empty_qs)
        push(a_sc, a)
        // Extend env
        let env2 = []
        for bi in 0..len(env)
            push(env2, env[bi])
        let xbind = []
        push(xbind, x)
        push(xbind, a_sc)
        push(env2, xbind)
        let wr = _thm_w(env2, body, ctr)
        if wr == "FAIL"
            return "FAIL"
        let s = wr[0]
        let tbody = wr[1]
        let tparam = _thm_apply(s, a)
        let res = []
        push(res, s)
        push(res, _thm_arr(tparam, tbody))
        return res
    if tag == "app"
        let f = term[1]
        let arg = term[2]
        let wr1 = _thm_w(env, f, ctr)
        if wr1 == "FAIL"
            return "FAIL"
        let s1 = wr1[0]
        let t1 = wr1[1]
        let env2 = _thm_apply_env(s1, env)
        let wr2 = _thm_w(env2, arg, ctr)
        if wr2 == "FAIL"
            return "FAIL"
        let s2 = wr2[0]
        let t2 = wr2[1]
        let b = _thm_fresh(ctr)
        let s3 = _thm_unify(_thm_apply(s2, t1), _thm_arr(t2, b))
        if s3 == "FAIL"
            return "FAIL"
        let sfull = _thm_compose(_thm_compose(s3, s2), s1)
        let res = []
        push(res, sfull)
        push(res, _thm_apply(s3, b))
        return res
    if tag == "let"
        let x = term[1]
        let e1 = term[2]
        let e2 = term[3]
        // Infer type of e1
        let wr1 = _thm_w(env, e1, ctr)
        if wr1 == "FAIL"
            return "FAIL"
        let s1 = wr1[0]
        let t1 = wr1[1]
        // Generalize in the residual environment
        let env1 = _thm_apply_env(s1, env)
        let t1_applied = _thm_apply(s1, t1)
        let sc = _thm_generalize(env1, t1_applied)
        // Extend env with x : sc
        let env2 = []
        for bi in 0..len(env1)
            push(env2, env1[bi])
        let xbind = []
        push(xbind, x)
        push(xbind, sc)
        push(env2, xbind)
        // Infer e2
        let wr2 = _thm_w(env2, e2, ctr)
        if wr2 == "FAIL"
            return "FAIL"
        let s2 = wr2[0]
        let t2 = wr2[1]
        let res = []
        push(res, _thm_compose(s2, s1))
        push(res, t2)
        return res
    "FAIL"

// ---------------------------------------------------------------------------
// Alpha-equivalence canonicalization
// ---------------------------------------------------------------------------

fn _thm_canon_type(t, mapping, ctr)
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let ks = str(k)
        if ks not in mapping
            mapping[ks] = ctr[0]
            ctr[0] = ctr[0] + 1
        _thm_tvar(mapping[ks])
    else
        if tag == "arr"
            let a2 = _thm_canon_type(t[1], mapping, ctr)
            let b2 = _thm_canon_type(t[2], mapping, ctr)
            _thm_arr(a2, b2)
        else
            if tag == "con"
                let nm = t[1]
                let args = t[2]
                let new_args = [_thm_canon_type(args[i], mapping, ctr) for i in 0..len(args)]
                _thm_con(nm, new_args)
            else
                t

fn thm_canonicalize(t)
    let mapping = {}
    let ctr = [0]
    _thm_canon_type(t, mapping, ctr)

// ---------------------------------------------------------------------------
// Structural type equality
// ---------------------------------------------------------------------------

fn _thm_type_eq(a, b)
    if a[0] != b[0]
        return 0
    let tag = a[0]
    if tag == "tvar"
        if a[1] == b[1]
            return 1
        return 0
    if tag == "arr"
        if _thm_type_eq(a[1], b[1]) == 0
            return 0
        return _thm_type_eq(a[2], b[2])
    if tag == "con"
        if a[1] != b[1]
            return 0
        let aa = a[2]
        let ba = b[2]
        if len(aa) != len(ba)
            return 0
        for i in 0..len(aa)
            if _thm_type_eq(aa[i], ba[i]) == 0
                return 0
        return 1
    0

// thm_alpha_eq(t1, t2) — true (1) if t1 and t2 are alpha-equivalent.
fn thm_alpha_eq(t1, t2)
    let c1 = thm_canonicalize(t1)
    let c2 = thm_canonicalize(t2)
    _thm_type_eq(c1, c2)

// ---------------------------------------------------------------------------
// thm_infer(term) — top-level HM inference. Returns principal type or "FAIL".
// Starts with an empty environment (no built-in primitives).
// ---------------------------------------------------------------------------

fn thm_infer(term)
    let ctr = [0]
    let env = []
    let wr = _thm_w(env, term, ctr)
    if wr == "FAIL"
        return "FAIL"
    wr[1]
