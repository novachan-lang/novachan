// ============================================================================
// NOVA Standard Library — std/typesystem/type_infer.nova
// Algorithm W for the pure lambda fragment: var / lam / app (NO let).
// Types are tagged lists; substitutions are lists of [k, type] pairs.
// Failure is represented by the string "FAIL".
// Leaf module — imports NOTHING. All public functions prefixed tinf_.
// ============================================================================

// ---------------------------------------------------------------------------
// Type constructors
// ---------------------------------------------------------------------------

// _tinf_tvar(k) — type variable node.
fn _tinf_tvar(k)
    let t = []
    push(t, "tvar")
    push(t, k)
    t

// _tinf_arr(a, b) — function type a -> b.
fn _tinf_arr(a, b)
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    t

// _tinf_con(name, args) — type constructor node.
fn _tinf_con(name, args)
    let t = []
    push(t, "con")
    push(t, name)
    push(t, args)
    t

// ---------------------------------------------------------------------------
// Fresh variable counter
// ---------------------------------------------------------------------------

// _tinf_fresh(ctr) — allocate next type variable id from ctr cell.
fn _tinf_fresh(ctr)
    let id = ctr[0]
    ctr[0] = ctr[0] + 1
    _tinf_tvar(id)

// ---------------------------------------------------------------------------
// Occurs check
// ---------------------------------------------------------------------------

// _tinf_occurs(k, t) — true (1) if tvar k appears anywhere in type t.
fn _tinf_occurs(k, t)
    let tag = t[0]
    if tag == "tvar"
        if t[1] == k
            return 1
        return 0
    if tag == "arr"
        if _tinf_occurs(k, t[1]) == 1
            return 1
        return _tinf_occurs(k, t[2])
    if tag == "con"
        let args = t[2]
        let i = 0
        while i < len(args)
            if _tinf_occurs(k, args[i]) == 1
                return 1
            i = i + 1
        return 0
    0

// ---------------------------------------------------------------------------
// Apply substitution
// ---------------------------------------------------------------------------

// _tinf_apply(sub, t) — apply substitution list to type t (walk and replace tvars).
fn _tinf_apply(sub, t)
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let i = 0
        let result = t
        while i < len(sub)
            let pair = sub[i]
            if pair[0] == k
                // Apply sub recursively to handle chains
                result = _tinf_apply(sub, pair[1])
            i = i + 1
        result
    else
        if tag == "arr"
            let a2 = _tinf_apply(sub, t[1])
            let b2 = _tinf_apply(sub, t[2])
            _tinf_arr(a2, b2)
        else
            if tag == "con"
                let nm = t[1]
                let args = t[2]
                let new_args = []
                let i = 0
                while i < len(args)
                    push(new_args, _tinf_apply(sub, args[i]))
                    i = i + 1
                _tinf_con(nm, new_args)
            else
                t

// ---------------------------------------------------------------------------
// Apply substitution to environment (list of [name, type] pairs)
// ---------------------------------------------------------------------------

fn _tinf_apply_env(sub, env)
    let out = []
    let i = 0
    while i < len(env)
        let binding = env[i]
        let pair = []
        push(pair, binding[0])
        push(pair, _tinf_apply(sub, binding[1]))
        push(out, pair)
        i = i + 1
    out

// ---------------------------------------------------------------------------
// Compose substitutions: compose(s2, s1) means "apply s1 first, then s2".
// Result: apply s2 to each rhs of s1, then append bindings from s2 not in s1.
// ---------------------------------------------------------------------------

fn _tinf_compose(s2, s1)
    // Apply s2 to every rhs in s1
    let result = []
    let i = 0
    while i < len(s1)
        let pair = s1[i]
        let new_pair = []
        push(new_pair, pair[0])
        push(new_pair, _tinf_apply(s2, pair[1]))
        push(result, new_pair)
        i = i + 1
    // Build set of keys already in s1
    let s1keys = {}
    let ki = 0
    while ki < len(s1)
        s1keys[str(s1[ki][0])] = 1
        ki = ki + 1
    // Append s2 bindings not already covered by s1
    let j = 0
    while j < len(s2)
        let pair2 = s2[j]
        if not contains(s1keys, str(pair2[0]))
            push(result, pair2)
        j = j + 1
    result

// ---------------------------------------------------------------------------
// Unification
// ---------------------------------------------------------------------------

// _tinf_unify(s, t) — unify types s and t; returns substitution list or "FAIL".
fn _tinf_unify(s, t)
    let stag = s[0]
    let ttag = t[0]
    if stag == "tvar"
        let k = s[1]
        // tvar == tvar same id -> empty subst
        if ttag == "tvar"
            if t[1] == k
                return []
        // occurs check
        if _tinf_occurs(k, t) == 1
            return "FAIL"
        // bind k -> t
        let pair = []
        push(pair, k)
        push(pair, t)
        let sub = []
        push(sub, pair)
        return sub
    if ttag == "tvar"
        // symmetric case
        return _tinf_unify(t, s)
    if stag == "arr"
        if ttag == "arr"
            let s1 = _tinf_unify(s[1], t[1])
            if s1 == "FAIL"
                return "FAIL"
            let s2 = _tinf_unify(_tinf_apply(s1, s[2]), _tinf_apply(s1, t[2]))
            if s2 == "FAIL"
                return "FAIL"
            return _tinf_compose(s2, s1)
        return "FAIL"
    if stag == "con"
        if ttag == "con"
            if s[1] != t[1]
                return "FAIL"
            let sargs = s[2]
            let targs = t[2]
            if len(sargs) != len(targs)
                return "FAIL"
            let sub = []
            let i = 0
            while i < len(sargs)
                let si = _tinf_unify(_tinf_apply(sub, sargs[i]), _tinf_apply(sub, targs[i]))
                if si == "FAIL"
                    return "FAIL"
                sub = _tinf_compose(si, sub)
                i = i + 1
            return sub
        return "FAIL"
    "FAIL"

// ---------------------------------------------------------------------------
// Environment lookup (plain type, no scheme here — lambda fragment only)
// ---------------------------------------------------------------------------

// _tinf_env_lookup(env, name) — find binding for name; return type or "FAIL".
fn _tinf_env_lookup(env, name)
    // Scan NEWEST-first so an inner binding shadows an outer same-named one.
    let i = len(env) - 1
    while i >= 0
        let binding = env[i]
        if binding[0] == name
            return binding[1]
        i = i - 1
    "FAIL"

// ---------------------------------------------------------------------------
// Algorithm W (lambda fragment: var / lam / app)
// Returns ["sub", type] list, or "FAIL".
// env is a list of [name, type] pairs (monomorphic — no schemes in lambda frag).
// ---------------------------------------------------------------------------

fn _tinf_w(env, term, ctr)
    let tag = term[0]
    if tag == "var"
        let name = term[1]
        let ty = _tinf_env_lookup(env, name)
        if ty == "FAIL"
            return "FAIL"
        // monomorphic — return as-is with empty substitution
        let res = []
        push(res, [])
        push(res, ty)
        return res
    if tag == "lam"
        let x = term[1]
        let body = term[2]
        // fresh type variable for the parameter
        let a = _tinf_fresh(ctr)
        // extend env with x : a
        let env2 = []
        let bi = 0
        while bi < len(env)
            push(env2, env[bi])
            bi = bi + 1
        let xbind = []
        push(xbind, x)
        push(xbind, a)
        push(env2, xbind)
        let wr = _tinf_w(env2, body, ctr)
        if wr == "FAIL"
            return "FAIL"
        let s = wr[0]
        let tbody = wr[1]
        let tparam = _tinf_apply(s, a)
        let res = []
        push(res, s)
        push(res, _tinf_arr(tparam, tbody))
        return res
    if tag == "app"
        let f = term[1]
        let arg = term[2]
        let wr1 = _tinf_w(env, f, ctr)
        if wr1 == "FAIL"
            return "FAIL"
        let s1 = wr1[0]
        let t1 = wr1[1]
        let env2 = _tinf_apply_env(s1, env)
        let wr2 = _tinf_w(env2, arg, ctr)
        if wr2 == "FAIL"
            return "FAIL"
        let s2 = wr2[0]
        let t2 = wr2[1]
        let b = _tinf_fresh(ctr)
        let s3 = _tinf_unify(_tinf_apply(s2, t1), _tinf_arr(t2, b))
        if s3 == "FAIL"
            return "FAIL"
        let sfull = _tinf_compose(_tinf_compose(s3, s2), s1)
        let res = []
        push(res, sfull)
        push(res, _tinf_apply(s3, b))
        return res
    "FAIL"

// ---------------------------------------------------------------------------
// Alpha-equivalence canonicalization
// ---------------------------------------------------------------------------

// _tinf_canon_type(t, mapping, ctr) — canonicalize type variable numbering.
// mapping is a dict (str(old_id) -> new_id). ctr is [next_id].
fn _tinf_canon_type(t, mapping, ctr)
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let ks = str(k)
        if not contains(mapping, ks)
            mapping[ks] = ctr[0]
            ctr[0] = ctr[0] + 1
        _tinf_tvar(mapping[ks])
    else
        if tag == "arr"
            let a2 = _tinf_canon_type(t[1], mapping, ctr)
            let b2 = _tinf_canon_type(t[2], mapping, ctr)
            _tinf_arr(a2, b2)
        else
            if tag == "con"
                let nm = t[1]
                let args = t[2]
                let new_args = []
                let i = 0
                while i < len(args)
                    push(new_args, _tinf_canon_type(args[i], mapping, ctr))
                    i = i + 1
                _tinf_con(nm, new_args)
            else
                t

// tinf_canonicalize(t) — return canonical form of type t (tvars renumbered 0,1,2,...).
fn tinf_canonicalize(t)
    let mapping = {}
    let ctr = [0]
    _tinf_canon_type(t, mapping, ctr)

// ---------------------------------------------------------------------------
// Type equality check (structural, after canonicalization)
// ---------------------------------------------------------------------------

// _tinf_type_eq(a, b) — structural equality of two canonical types.
fn _tinf_type_eq(a, b)
    if a[0] != b[0]
        return 0
    let tag = a[0]
    if tag == "tvar"
        if a[1] == b[1]
            return 1
        return 0
    if tag == "arr"
        if _tinf_type_eq(a[1], b[1]) == 0
            return 0
        return _tinf_type_eq(a[2], b[2])
    if tag == "con"
        if a[1] != b[1]
            return 0
        let aa = a[2]
        let ba = b[2]
        if len(aa) != len(ba)
            return 0
        let i = 0
        while i < len(aa)
            if _tinf_type_eq(aa[i], ba[i]) == 0
                return 0
            i = i + 1
        return 1
    0

// tinf_alpha_eq(t1, t2) — true (1) if t1 and t2 are alpha-equivalent types.
fn tinf_alpha_eq(t1, t2)
    let c1 = tinf_canonicalize(t1)
    let c2 = tinf_canonicalize(t2)
    _tinf_type_eq(c1, c2)

// ---------------------------------------------------------------------------
// tinf_infer(term) — top-level inference. Returns principal type or "FAIL".
// ---------------------------------------------------------------------------

fn tinf_infer(term)
    let ctr = [0]
    let env = []
    let wr = _tinf_w(env, term, ctr)
    if wr == "FAIL"
        return "FAIL"
    wr[1]
