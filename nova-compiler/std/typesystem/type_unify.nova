// std/typesystem/type_unify — Robinson's unification algorithm for Hindley-Milner.
//
// TYPE REPRESENTATION (self-contained; identical to type_core):
//   ["tvar", k]          — type variable with integer id k
//   ["arr", a, b]        — function type a -> b
//   ["con", name, args]  — type constructor
//
// SUBSTITUTION: list of [k, type] pairs. Failure is represented by the string "FAIL".
//
// All public functions are prefixed tuni_.

// ── internal type constructors ──────────────────────────────────────────────

fn _tuni_tvar(k) -> list
    let t = []
    push(t, "tvar")
    push(t, k)
    return t

fn _tuni_arr(a, b) -> list
    let t = []
    push(t, "arr")
    push(t, a)
    push(t, b)
    return t

fn _tuni_con(name, args) -> list
    let t = []
    push(t, "con")
    push(t, name)
    push(t, args)
    return t

// ── internal substitution helpers ───────────────────────────────────────────

// Look up key k in sub; return the bound type or "NOTFOUND".
fn _tuni_lookup(sub, k) -> any
    for i in 0..len(sub)
        let pair = sub[i]
        if pair[0] == k
            return pair[1]
    return "NOTFOUND"

// Apply sub to type t (walk and replace bound tvars).
fn _tuni_apply(sub, t) -> any
    if type_of(t) != "list"
        return t
    if len(t) < 1
        return t
    let tag = t[0]
    if tag == "tvar"
        let k = t[1]
        let found = _tuni_lookup(sub, k)
        if type_of(found) == "string"
            if found == "NOTFOUND"
                return t
        return _tuni_apply(sub, found)
    if tag == "arr"
        let a2 = _tuni_apply(sub, t[1])
        let b2 = _tuni_apply(sub, t[2])
        return _tuni_arr(a2, b2)
    if tag == "con"
        let name = t[1]
        let args = t[2]
        let new_args = [_tuni_apply(sub, args[i]) for i in 0..len(args)]
        return _tuni_con(name, new_args)
    return t

// compose(s2, s1): apply s2 to rhs of s1 then append s2's own bindings.
fn _tuni_compose(s2, s1) -> list
    let result = []
    for i in 0..len(s1)
        let pair = s1[i]
        let k = pair[0]
        let v2 = _tuni_apply(s2, pair[1])
        let new_pair = []
        push(new_pair, k)
        push(new_pair, v2)
        push(result, new_pair)
    for j in 0..len(s2)
        let pair2 = s2[j]
        let k2 = pair2[0]
        let found = 0
        let m = 0
        while m < len(s1)
            if s1[m][0] == k2
                found = 1
            m = m + 1
        if found == 0
            push(result, pair2)
    return result

// ── occurs check ────────────────────────────────────────────────────────────

// tuni_occurs: return 1 if type variable k appears anywhere in type t, 0 otherwise.
fn tuni_occurs(k, t) -> int
    if type_of(t) != "list"
        return 0
    if len(t) < 1
        return 0
    let tag = t[0]
    if tag == "tvar"
        if t[1] == k
            return 1
        return 0
    if tag == "arr"
        let in_a = tuni_occurs(k, t[1])
        if in_a == 1
            return 1
        return tuni_occurs(k, t[2])
    if tag == "con"
        let args = t[2]
        for i in 0..len(args)
            let r = tuni_occurs(k, args[i])
            if r == 1
                return 1
        return 0
    return 0

// ── structural equality (needed for tvar == tvar check) ────────────────────

fn _tuni_type_eq(a, b) -> int
    let ta = type_of(a)
    let tb = type_of(b)
    if ta != tb
        return 0
    if ta == "int"
        if a == b
            return 1
        return 0
    if ta == "string"
        if a == b
            return 1
        return 0
    if ta == "list"
        let na = len(a)
        if na != len(b)
            return 0
        for i in 0..na
            let r = _tuni_type_eq(a[i], b[i])
            if r == 0
                return 0
        return 1
    return 0

// ── Robinson's unification ──────────────────────────────────────────────────

// tuni_unify: unify types s and t. Returns a substitution list, or the string "FAIL".
fn tuni_unify(s, t) -> any
    if type_of(s) != "list"
        return "FAIL"
    if type_of(t) != "list"
        return "FAIL"
    let stag = s[0]
    let ttag = t[0]
    // Both type variables
    if stag == "tvar"
        let k = s[1]
        if ttag == "tvar"
            if t[1] == k
                return []
        if tuni_occurs(k, t) == 1
            return "FAIL"
        let pair = []
        push(pair, k)
        push(pair, t)
        let sub = []
        push(sub, pair)
        return sub
    if ttag == "tvar"
        let k = t[1]
        if tuni_occurs(k, s) == 1
            return "FAIL"
        let pair = []
        push(pair, k)
        push(pair, s)
        let sub = []
        push(sub, pair)
        return sub
    // Both function types
    if stag == "arr"
        if ttag == "arr"
            let s1 = tuni_unify(s[1], t[1])
            if type_of(s1) == "string"
                return "FAIL"
            let s2 = tuni_unify(_tuni_apply(s1, s[2]), _tuni_apply(s1, t[2]))
            if type_of(s2) == "string"
                return "FAIL"
            return _tuni_compose(s2, s1)
        return "FAIL"
    // Both type constructors
    if stag == "con"
        if ttag == "con"
            if s[1] != t[1]
                return "FAIL"
            let sargs = s[2]
            let targs = t[2]
            if len(sargs) != len(targs)
                return "FAIL"
            let sub = []
            for i in 0..len(sargs)
                let sa = _tuni_apply(sub, sargs[i])
                let ta2 = _tuni_apply(sub, targs[i])
                let si = tuni_unify(sa, ta2)
                if type_of(si) == "string"
                    return "FAIL"
                sub = _tuni_compose(si, sub)
            return sub
        return "FAIL"
    return "FAIL"

// tuni_succeeds: return 1 if s and t unify, 0 otherwise.
fn tuni_succeeds(s, t) -> int
    let result = tuni_unify(s, t)
    if type_of(result) == "string"
        return 0
    return 1

// tuni_unify_pair: unify a pair of type lists [(s0,t0),(s1,t1),...].
// Each element is a 2-element list [s, t]. Returns combined substitution or "FAIL".
fn tuni_unify_pair(pairs) -> any
    let sub = []
    for i in 0..len(pairs)
        let pair = pairs[i]
        let s2 = _tuni_apply(sub, pair[0])
        let t2 = _tuni_apply(sub, pair[1])
        let si = tuni_unify(s2, t2)
        if type_of(si) == "string"
            return "FAIL"
        sub = _tuni_compose(si, sub)
    return sub
