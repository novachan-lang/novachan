// std/matrix/mattranspose.nova — Transpose and structural predicates.
//
// Matrix representation (shared convention): a dict with keys 'r' (rows),
// 'c' (cols), 'd' (flat row-major list of floats, length r*c).
// Element (i,j) = d[i*c + j].
//
// All public functions are prefixed mt_ to avoid global symbol collisions.
//
// Public API:
//   mt_make(r,c,data)              -> any    build a matrix dict
//   mt_get(m,i,j)                  -> float  element access
//   mt_set(m,i,j,v)                          mutate element
//   mt_transpose(m)                -> any    row↔col flip
//   mt_is_square(m)                -> bool   r == c
//   mt_is_symmetric(m, tol)        -> bool   m == m^T (within tol)
//   mt_is_diagonal(m, tol)         -> bool   off-diagonal ≈ 0 (within tol)
//   mt_is_identity(m, tol)         -> bool   diagonal ≈ 1, off-diagonal ≈ 0
//   mt_trace(m)                    -> float  sum of diagonal
//   mt_diagonal(m)                 -> any    diagonal elements as a list
//   mt_is_upper_triangular(m, tol) -> bool   below-diagonal ≈ 0
//   mt_is_lower_triangular(m, tol) -> bool   above-diagonal ≈ 0
//   mt_swap_rows(m, i, j)          -> any    new matrix with rows i,j swapped
//   mt_swap_cols(m, i, j)          -> any    new matrix with cols i,j swapped
//   mt_submatrix(m, skip_r, skip_c)-> any    delete row skip_r and col skip_c

// mt_make — create a matrix dict from r, c, and a flat float list.
fn mt_make(r: int, c: int, data: list) -> any
    let m = {}
    m["r"] = r
    m["c"] = c
    m["d"] = data
    m

// _mt_zeros — internal: build an r×c zero matrix.
fn _mt_zeros(r: int, c: int) -> any
    let d = []
    let total = r * c
    let k = 0
    while k < total
        push(d, 0.0)
        k = k + 1
    mt_make(r, c, d)

// mt_get — return element (i,j) as a float.
fn mt_get(m: any, i: int, j: int) -> float
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    let v = d[idx]
    v * 1.0

// mt_set — mutate element (i,j) to float value v.
fn mt_set(m: any, i: int, j: int, v: float)
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    d[idx] = v

// _mt_fabs — absolute value of a float.
fn _mt_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// _mt_approx — true if |a - b| < tol.
fn _mt_approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < tol

// mt_transpose — return the transpose of matrix m (r×c -> c×r).
fn mt_transpose(m: any) -> any
    let r = m["r"]
    let c = m["c"]
    let result = _mt_zeros(c, r)
    let i = 0
    while i < r
        let j = 0
        while j < c
            let v = mt_get(m, i, j)
            mt_set(result, j, i, v)
            j = j + 1
        i = i + 1
    result

// mt_is_square — true iff the matrix has equal row and column count.
fn mt_is_square(m: any) -> bool
    let r = m["r"]
    let c = m["c"]
    r == c

// mt_is_symmetric — true iff m(i,j) ≈ m(j,i) for all i,j (requires square).
fn mt_is_symmetric(m: any, tol: float) -> bool
    let r = m["r"]
    let c = m["c"]
    if r != c
        return false
    let ok = true
    let i = 0
    while i < r
        let j = 0
        while j < c
            let aij = mt_get(m, i, j)
            let aji = mt_get(m, j, i)
            if not _mt_approx(aij, aji, tol)
                ok = false
            j = j + 1
        i = i + 1
    ok

// mt_is_diagonal — true iff all off-diagonal elements are within tol of 0.
fn mt_is_diagonal(m: any, tol: float) -> bool
    let r = m["r"]
    let c = m["c"]
    let ok = true
    let i = 0
    while i < r
        let j = 0
        while j < c
            if i != j
                let v = mt_get(m, i, j)
                if not _mt_approx(v, 0.0, tol)
                    ok = false
            j = j + 1
        i = i + 1
    ok

// mt_is_identity — true iff diagonal ≈ 1 and off-diagonal ≈ 0 (within tol).
fn mt_is_identity(m: any, tol: float) -> bool
    let r = m["r"]
    let c = m["c"]
    if r != c
        return false
    let ok = true
    let i = 0
    while i < r
        let j = 0
        while j < c
            let v = mt_get(m, i, j)
            if i == j
                if not _mt_approx(v, 1.0, tol)
                    ok = false
            else
                if not _mt_approx(v, 0.0, tol)
                    ok = false
            j = j + 1
        i = i + 1
    ok

// mt_trace — sum of the diagonal elements (min(r,c) terms).
fn mt_trace(m: any) -> float
    let r = m["r"]
    let c = m["c"]
    let n = r
    if c < n
        n = c
    let s = 0.0
    let i = 0
    while i < n
        let v = mt_get(m, i, i)
        s = s + v
        i = i + 1
    s

// mt_diagonal — return the diagonal elements as a list of floats.
fn mt_diagonal(m: any) -> any
    let r = m["r"]
    let c = m["c"]
    let n = r
    if c < n
        n = c
    let result = []
    let i = 0
    while i < n
        let v = mt_get(m, i, i)
        push(result, v)
        i = i + 1
    result

// mt_is_upper_triangular — true iff all elements below the diagonal are within tol of 0.
fn mt_is_upper_triangular(m: any, tol: float) -> bool
    let r = m["r"]
    let c = m["c"]
    let ok = true
    let i = 0
    while i < r
        let j = 0
        while j < c
            if i > j
                let v = mt_get(m, i, j)
                if not _mt_approx(v, 0.0, tol)
                    ok = false
            j = j + 1
        i = i + 1
    ok

// mt_is_lower_triangular — true iff all elements above the diagonal are within tol of 0.
fn mt_is_lower_triangular(m: any, tol: float) -> bool
    let r = m["r"]
    let c = m["c"]
    let ok = true
    let i = 0
    while i < r
        let j = 0
        while j < c
            if i < j
                let v = mt_get(m, i, j)
                if not _mt_approx(v, 0.0, tol)
                    ok = false
            j = j + 1
        i = i + 1
    ok

// mt_swap_rows — return a copy of m with rows i and j exchanged.
fn mt_swap_rows(m: any, ri: int, rj: int) -> any
    let r = m["r"]
    let c = m["c"]
    let result = _mt_zeros(r, c)
    let i = 0
    while i < r
        let j = 0
        while j < c
            let src_row = i
            if i == ri
                src_row = rj
            else
                if i == rj
                    src_row = ri
            let v = mt_get(m, src_row, j)
            mt_set(result, i, j, v)
            j = j + 1
        i = i + 1
    result

// mt_swap_cols — return a copy of m with columns ci and cj exchanged.
fn mt_swap_cols(m: any, ci: int, cj: int) -> any
    let r = m["r"]
    let c = m["c"]
    let result = _mt_zeros(r, c)
    let i = 0
    while i < r
        let j = 0
        while j < c
            let src_col = j
            if j == ci
                src_col = cj
            else
                if j == cj
                    src_col = ci
            let v = mt_get(m, i, src_col)
            mt_set(result, i, j, v)
            j = j + 1
        i = i + 1
    result

// mt_submatrix — return the (r-1)×(c-1) matrix formed by deleting row skip_r and col skip_c.
// Used for cofactor/minor computation.
fn mt_submatrix(m: any, skip_r: int, skip_c: int) -> any
    let r = m["r"]
    let c = m["c"]
    let nr = r - 1
    let nc = c - 1
    let result = _mt_zeros(nr, nc)
    let di = 0
    let si = 0
    while si < r
        if si != skip_r
            let dj = 0
            let sj = 0
            while sj < c
                if sj != skip_c
                    let v = mt_get(m, si, sj)
                    mt_set(result, di, dj, v)
                    dj = dj + 1
                sj = sj + 1
            di = di + 1
        si = si + 1
    result
