// std/matrix/matnorm.nova — Matrix and vector norms.
//
// Matrix representation: dict with keys 'r','c','d' (flat row-major float list).
// All public functions are prefixed mn_ to avoid global symbol collisions.
//
// Public API:
//   mn_frobenius(m)         -> float  sqrt(sum of squares of all elements)
//   mn_one(m)               -> float  max absolute column sum
//   mn_inf(m)               -> float  max absolute row sum
//   mn_max(m)               -> float  max absolute element
//   mn_vec_l1(v)            -> float  sum of |v_i|
//   mn_vec_l2(v)            -> float  sqrt(sum of v_i^2)
//   mn_vec_linf(v)          -> float  max |v_i|
//   mn_trace_norm_hint(m)   -> float  sum of |diagonal| elements (proxy)
//   mn_is_zero(m, tol)      -> bool   all elements within tol of 0
//   mn_normalize_frobenius(m) -> any  m / frobenius(m) (returns zero matrix if norm==0)
//   mn_dot(u, v)            -> float  dot product of two float vectors
//   mn_distance_frobenius(a, b) -> float  frobenius norm of (a - b)

// mn_make — build a matrix dict from r, c, and a flat float list.
fn mn_make(r: int, c: int, data: list) -> any
    let m = {}
    m["r"] = r
    m["c"] = c
    m["d"] = data
    m

// _mn_make — internal alias (same as mn_make; kept for internal callers).
fn _mn_make(r: int, c: int, data: list) -> any
    mn_make(r, c, data)

// _mn_get — internal: element (i,j) as float.
fn _mn_get(m: any, i: int, j: int) -> float
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    let v = d[idx]
    v * 1.0

// _mn_set — internal: set element (i,j).
fn _mn_set(m: any, i: int, j: int, v: float)
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    d[idx] = v

// _mn_zeros — internal: r×c zero matrix.
fn _mn_zeros(r: int, c: int) -> any
    let total = r * c
    let d = [0.0 for k in 0..total]
    _mn_make(r, c, d)

// _mn_fabs — absolute value of a float.
fn _mn_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// mn_frobenius — Frobenius norm: sqrt of the sum of squared elements.
fn mn_frobenius(m: any) -> float
    let r = m["r"]
    let c = m["c"]
    let s = 0.0
    for i in 0..r
        let j = 0
        while j < c
            let v = _mn_get(m, i, j)
            s = s + v * v
            j = j + 1
    let result = sqrt(s)
    result

// mn_one — induced 1-norm: maximum absolute column sum.
fn mn_one(m: any) -> float
    let r = m["r"]
    let c = m["c"]
    let best = 0.0
    for j in 0..c
        let col_sum = 0.0
        let i = 0
        while i < r
            let v = _mn_get(m, i, j)
            let av = _mn_fabs(v)
            col_sum = col_sum + av
            i = i + 1
        if col_sum > best
            best = col_sum
    best

// mn_inf — infinity norm: maximum absolute row sum.
fn mn_inf(m: any) -> float
    let r = m["r"]
    let c = m["c"]
    let best = 0.0
    for i in 0..r
        let row_sum = 0.0
        let j = 0
        while j < c
            let v = _mn_get(m, i, j)
            let av = _mn_fabs(v)
            row_sum = row_sum + av
            j = j + 1
        if row_sum > best
            best = row_sum
    best

// mn_max — max norm: maximum absolute element value.
fn mn_max(m: any) -> float
    let r = m["r"]
    let c = m["c"]
    let best = 0.0
    for i in 0..r
        let j = 0
        while j < c
            let v = _mn_get(m, i, j)
            let av = _mn_fabs(v)
            if av > best
                best = av
            j = j + 1
    best

// mn_vec_l1 — L1 norm of a float vector: sum of absolute values.
fn mn_vec_l1(v: list) -> float
    let n = len(v)
    let s = 0.0
    for i in 0..n
        let vi = v[i] * 1.0
        let av = _mn_fabs(vi)
        s = s + av
    s

// mn_vec_l2 — L2 (Euclidean) norm of a float vector: sqrt(sum of squares).
fn mn_vec_l2(v: list) -> float
    let n = len(v)
    let s = 0.0
    for i in 0..n
        let vi = v[i] * 1.0
        s = s + vi * vi
    let result = sqrt(s)
    result

// mn_vec_linf — L-infinity norm of a float vector: maximum absolute value.
fn mn_vec_linf(v: list) -> float
    let n = len(v)
    let best = 0.0
    for i in 0..n
        let vi = v[i] * 1.0
        let av = _mn_fabs(vi)
        if av > best
            best = av
    best

// mn_trace_norm_hint — sum of absolute values of diagonal elements (a proxy for the
// nuclear norm when only singular values coincide with diagonal; exact for diagonal matrices).
fn mn_trace_norm_hint(m: any) -> float
    let r = m["r"]
    let c = m["c"]
    let n = r
    if c < n
        n = c
    let s = 0.0
    for i in 0..n
        let v = _mn_get(m, i, i)
        let av = _mn_fabs(v)
        s = s + av
    s

// mn_is_zero — true iff every element is within tol of 0.
fn mn_is_zero(m: any, tol: float) -> bool
    let r = m["r"]
    let c = m["c"]
    let ok = true
    for i in 0..r
        let j = 0
        while j < c
            let v = _mn_get(m, i, j)
            let av = _mn_fabs(v)
            if av > tol
                ok = false
            j = j + 1
    ok

// mn_normalize_frobenius — return m / frobenius(m).
// Returns the zero matrix (same shape) if the Frobenius norm is zero.
fn mn_normalize_frobenius(m: any) -> any
    let r = m["r"]
    let c = m["c"]
    let nrm = mn_frobenius(m)
    let result = _mn_zeros(r, c)
    if nrm < 0.0000001
        return result
    for i in 0..r
        let j = 0
        while j < c
            let v = _mn_get(m, i, j)
            let nv = v / nrm
            _mn_set(result, i, j, nv)
            j = j + 1
    result

// mn_dot — dot product of two float vectors of equal length.
fn mn_dot(u: list, v: list) -> float
    let n = len(u)
    let s = 0.0
    let i = 0
    while i < n
        let ui = u[i] * 1.0
        let vi = v[i] * 1.0
        s = s + ui * vi
        i = i + 1
    s

// mn_distance_frobenius — Frobenius norm of (a - b), i.e. distance between two matrices.
fn mn_distance_frobenius(a: any, b: any) -> float
    let r = a["r"]
    let c = a["c"]
    let s = 0.0
    for i in 0..r
        let j = 0
        while j < c
            let av = _mn_get(a, i, j)
            let bv = _mn_get(b, i, j)
            let diff = av - bv
            s = s + diff * diff
            j = j + 1
    let result = sqrt(s)
    result
