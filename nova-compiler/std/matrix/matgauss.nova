// std/matrix/matgauss.nova — Gaussian elimination primitives.
// LEAF — imports NOTHING.
// Matrix representation: dict{r:int, c:int, d:list[float]} row-major flat.
// Public prefix: mg_
//
// API:
//   mg_mat_make(r,c,data)         -> dict   build a matrix from a flat float list
//   mg_mat_get(m,i,j)             -> float  get element (i,j)
//   mg_mat_set(m,i,j,v)                     set element (i,j) in-place
//   mg_mat_zeros(r,c)             -> dict   zero matrix
//   mg_mat_identity(n)            -> dict   n×n identity
//   mg_pivot_row(m,col,from_row)  -> int    row index of max-abs pivot
//   mg_swap_rows(m,i,j)           -> dict   new matrix with rows i,j swapped
//   mg_scale_row(m,i,s)           -> dict   new matrix with row i scaled by s
//   mg_add_scaled_row(m,dst,src,factor) -> dict  row[dst] += factor * row[src]
//   mg_forward(m,tol)             -> dict   row echelon form (REF)
//   mg_rref(m,tol)                -> dict   reduced row echelon form (RREF)
//   mg_row_reduce(m,tol)          -> dict   alias for mg_rref
//   mg_eliminate(a,b)             -> list   [upper_matrix, rhs_vector] after forward elimination
//   mg_back_substitute(u,b)       -> list   solve upper-triangular U x = b

// mg_mat_make — build a matrix dict from r, c, and a flat float list.
fn mg_mat_make(r, c, data)
    let m = {}
    m["r"] = r
    m["c"] = c
    m["d"] = data
    m

// mg_mat_get — get element at row i, col j (0-indexed).
fn mg_mat_get(m, i, j)
    let cols = m["c"]
    let d = m["d"]
    let idx = i * cols + j
    d[idx] * 1.0

// mg_mat_set — set element at row i, col j in-place.
fn mg_mat_set(m, i, j, v)
    let cols = m["c"]
    let d = m["d"]
    let idx = i * cols + j
    d[idx] = v

// mg_mat_zeros — zero matrix of size r×c.
fn mg_mat_zeros(r, c)
    let total = r * c
    let data = [0.0 for k in 0..total]
    mg_mat_make(r, c, data)

// mg_mat_identity — n×n identity matrix.
fn mg_mat_identity(n)
    let m = mg_mat_zeros(n, n)
    for i in 0..n
        mg_mat_set(m, i, i, 1.0)
    m

// mg_mat_copy — deep copy of a matrix.
fn mg_mat_copy(m)
    let r = m["r"]
    let c = m["c"]
    let d = m["d"]
    let nd = []
    let k = 0
    let total = r * c
    while k < total
        push(nd, d[k] * 1.0)
        k = k + 1
    mg_mat_make(r, c, nd)

// mg_pivot_row — find row index (>= from_row) with maximum absolute value in column col.
fn mg_pivot_row(m, col, from_row)
    let r = m["r"]
    let best = from_row
    let bv = mg_mat_get(m, from_row, col)
    if bv < 0.0
        bv = 0.0 - bv
    let i = from_row + 1
    while i < r
        let v = mg_mat_get(m, i, col)
        if v < 0.0
            v = 0.0 - v
        if v > bv
            bv = v
            best = i
        i = i + 1
    best

// mg_swap_rows — return a new matrix with rows i and j swapped.
fn mg_swap_rows(m, i, j)
    let mc = mg_mat_copy(m)
    let c = mc["c"]
    for k in 0..c
        let vi = mg_mat_get(mc, i, k)
        let vj = mg_mat_get(mc, j, k)
        mg_mat_set(mc, i, k, vj)
        mg_mat_set(mc, j, k, vi)
    mc

// mg_scale_row — return a new matrix with row i scaled by scalar s.
fn mg_scale_row(m, i, s)
    let mc = mg_mat_copy(m)
    let c = mc["c"]
    for k in 0..c
        let v = mg_mat_get(mc, i, k)
        mg_mat_set(mc, i, k, v * s)
    mc

// mg_add_scaled_row — return a new matrix with row[dst] += factor * row[src].
fn mg_add_scaled_row(m, dst, src, factor)
    let mc = mg_mat_copy(m)
    let c = mc["c"]
    for k in 0..c
        let vdst = mg_mat_get(mc, dst, k)
        let vsrc = mg_mat_get(mc, src, k)
        mg_mat_set(mc, dst, k, vdst + factor * vsrc)
    mc

// mg_forward — row echelon form (REF) via Gaussian elimination with partial pivoting.
fn mg_forward(m, tol)
    let mc = mg_mat_copy(m)
    let r = mc["r"]
    let c = mc["c"]
    let pivot_row = 0
    let col = 0
    while col < c
        if pivot_row >= r
            col = c
        else
            let pr = mg_pivot_row(mc, col, pivot_row)
            let pv = mg_mat_get(mc, pr, col)
            if pv < 0.0
                pv = 0.0 - pv
            if pv < tol
                col = col + 1
            else
                if pr != pivot_row
                    mc = mg_swap_rows(mc, pivot_row, pr)
                let diag = mg_mat_get(mc, pivot_row, col)
                let row = pivot_row + 1
                while row < r
                    let v = mg_mat_get(mc, row, col)
                    let factor = 0.0 - (v / diag)
                    mc = mg_add_scaled_row(mc, row, pivot_row, factor)
                    row = row + 1
                pivot_row = pivot_row + 1
                col = col + 1
    mc

// mg_rref — reduced row echelon form (RREF) via Gauss-Jordan with partial pivoting.
fn mg_rref(m, tol)
    let mc = mg_mat_copy(m)
    let r = mc["r"]
    let c = mc["c"]
    let pivot_row = 0
    let col = 0
    while col < c
        if pivot_row >= r
            col = c
        else
            let pr = mg_pivot_row(mc, col, pivot_row)
            let pv = mg_mat_get(mc, pr, col)
            if pv < 0.0
                pv = 0.0 - pv
            if pv < tol
                col = col + 1
            else
                if pr != pivot_row
                    mc = mg_swap_rows(mc, pivot_row, pr)
                let diag = mg_mat_get(mc, pivot_row, col)
                mc = mg_scale_row(mc, pivot_row, 1.0 / diag)
                let row = 0
                while row < r
                    if row != pivot_row
                        let v = mg_mat_get(mc, row, col)
                        let factor = 0.0 - v
                        mc = mg_add_scaled_row(mc, row, pivot_row, factor)
                    row = row + 1
                pivot_row = pivot_row + 1
                col = col + 1
    mc

// mg_row_reduce — alias for mg_rref (reduced row echelon form).
fn mg_row_reduce(m, tol)
    mg_rref(m, tol)

// mg_eliminate — forward elimination with partial pivoting on augmented [A|b].
// Returns a list [upper_mat, rhs_vec] where upper_mat is the upper-triangular A part
// and rhs_vec is the transformed right-hand side.
fn mg_eliminate(a, b)
    let r = a["r"]
    let c = a["c"]
    let aug_data = []
    for i in 0..r
        let j = 0
        while j < c
            push(aug_data, mg_mat_get(a, i, j))
            j = j + 1
        push(aug_data, b[i] * 1.0)
    let aug = mg_mat_make(r, c + 1, aug_data)
    let tol = 0.000001
    let pivot_row = 0
    let col = 0
    while col < c
        if pivot_row >= r
            col = c
        else
            let pr = mg_pivot_row(aug, col, pivot_row)
            let pv = mg_mat_get(aug, pr, col)
            if pv < 0.0
                pv = 0.0 - pv
            if pv < tol
                col = col + 1
            else
                if pr != pivot_row
                    aug = mg_swap_rows(aug, pivot_row, pr)
                let diag = mg_mat_get(aug, pivot_row, col)
                let row = pivot_row + 1
                while row < r
                    let v = mg_mat_get(aug, row, col)
                    let factor = 0.0 - (v / diag)
                    aug = mg_add_scaled_row(aug, row, pivot_row, factor)
                    row = row + 1
                pivot_row = pivot_row + 1
                col = col + 1
    let upper_data = []
    for bi in 0..r
        let j = 0
        while j < c
            push(upper_data, mg_mat_get(aug, bi, j))
            j = j + 1
    let upper = mg_mat_make(r, c, upper_data)
    let rhs = [mg_mat_get(aug, ri, c) for ri in 0..r]
    let result = []
    push(result, upper)
    push(result, rhs)
    result

// mg_back_substitute — solve upper-triangular system U x = b.
// Returns the solution vector x, or empty list if the system is degenerate.
fn mg_back_substitute(u, b)
    let n = u["r"]
    let x = [0.0 for k in 0..n]
    let tol = 0.000001
    let i = n - 1
    while i >= 0
        let uii = mg_mat_get(u, i, i)
        if uii < 0.0
            uii = 0.0 - uii
        if uii < tol
            return []
        let sum = b[i] * 1.0
        let j = i + 1
        while j < n
            let uij = mg_mat_get(u, i, j)
            let xj = x[j] * 1.0
            sum = sum - uij * xj
            j = j + 1
        let uii_real = mg_mat_get(u, i, i)
        x[i] = sum / uii_real
        i = i - 1
    x
