// std/matrix/matmul.nova — Matrix multiply and vector operations.
//
// Matrix representation: a dict with keys 'r' (rows), 'c' (cols), 'd' (flat
// row-major list of floats, length r*c).  Element (i,j) = d[i*c + j].
//
// All public functions are prefixed mm_ to avoid global symbol collisions.
//
// Public API:
//   mm_make(r, c, data) -> any     build a matrix from a flat float list
//   mm_identity(n)      -> any     n×n identity matrix
//   mm_mul(a, b)        -> any     matrix multiply (r_a×c_a) × (c_a×c_b)
//   mm_matvec(m, v)     -> any     matrix–vector product (returns list)
//   mm_add(a, b)        -> any     element-wise addition
//   mm_sub(a, b)        -> any     element-wise subtraction
//   mm_scale(m, s)      -> any     scalar multiply
//   mm_hadamard(a, b)   -> any     element-wise (Hadamard) product
//   mm_power(m, k)      -> any     integer matrix power (k >= 0)
//   mm_get(m, i, j)     -> float   element access
//   mm_dims(m)          -> any     [rows, cols] as a list
//   mm_equal(a, b, tol) -> bool    element-wise approximate equality

// mm_make — create a matrix dict from r, c and a flat float list.
fn mm_make(r: int, c: int, data: list) -> any
    let m = {}
    m["r"] = r
    m["c"] = c
    m["d"] = data
    m

// mm_get — return element (i, j) of matrix m.
fn mm_get(m: any, i: int, j: int) -> float
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    let v = d[idx]
    v * 1.0

// mm_set — set element (i, j) of matrix m to value v (mutates d in place).
fn mm_set(m: any, i: int, j: int, v: float)
    let c = m["c"]
    let d = m["d"]
    let idx = i * c + j
    d[idx] = v

// mm_zeros — build an r×c zero matrix.
fn mm_zeros(r: int, c: int) -> any
    let total = r * c
    let d = [0.0 for k in 0..total]
    mm_make(r, c, d)

// mm_identity — build an n×n identity matrix.
fn mm_identity(n: int) -> any
    let m = mm_zeros(n, n)
    for i in 0..n
        mm_set(m, i, i, 1.0)
    m

// mm_dims — return [rows, cols] as a list.
fn mm_dims(m: any) -> any
    let r = m["r"]
    let c = m["c"]
    let result = []
    push(result, r)
    push(result, c)
    result

// mm_mul — multiply matrix a (r_a×c_a) by matrix b (c_a×c_b).
// Panics (wrong answer) if dimensions don't match — caller must ensure c_a == r_b.
fn mm_mul(a: any, b: any) -> any
    let ra = a["r"]
    let ca = a["c"]
    let cb = b["c"]
    let result = mm_zeros(ra, cb)
    for i in 0..ra
        let j = 0
        while j < cb
            let s = 0.0
            let k = 0
            while k < ca
                let av = mm_get(a, i, k)
                let bv = mm_get(b, k, j)
                s += av * bv
                k += 1
            mm_set(result, i, j, s)
            j += 1
    result

// mm_matvec — multiply matrix m (r×c) by vector v (length c); returns list.
fn mm_matvec(m: any, v: list) -> any
    let r = m["r"]
    let c = m["c"]
    let result = []
    for i in 0..r
        let s = 0.0
        let j = 0
        while j < c
            let mv = mm_get(m, i, j)
            let vv = v[j] * 1.0
            s += mv * vv
            j += 1
        push(result, s)
    result

// mm_add — element-wise addition of two same-shape matrices.
fn mm_add(a: any, b: any) -> any
    let r = a["r"]
    let c = a["c"]
    let result = mm_zeros(r, c)
    for i in 0..r
        let j = 0
        while j < c
            let av = mm_get(a, i, j)
            let bv = mm_get(b, i, j)
            mm_set(result, i, j, av + bv)
            j += 1
    result

// mm_sub — element-wise subtraction of two same-shape matrices.
fn mm_sub(a: any, b: any) -> any
    let r = a["r"]
    let c = a["c"]
    let result = mm_zeros(r, c)
    for i in 0..r
        let j = 0
        while j < c
            let av = mm_get(a, i, j)
            let bv = mm_get(b, i, j)
            mm_set(result, i, j, av - bv)
            j += 1
    result

// mm_scale — multiply every element of matrix m by scalar s.
fn mm_scale(m: any, s: float) -> any
    let r = m["r"]
    let c = m["c"]
    let result = mm_zeros(r, c)
    for i in 0..r
        let j = 0
        while j < c
            let v = mm_get(m, i, j)
            mm_set(result, i, j, v * s)
            j += 1
    result

// mm_hadamard — element-wise (Hadamard) product of two same-shape matrices.
fn mm_hadamard(a: any, b: any) -> any
    let r = a["r"]
    let c = a["c"]
    let result = mm_zeros(r, c)
    for i in 0..r
        let j = 0
        while j < c
            let av = mm_get(a, i, j)
            let bv = mm_get(b, i, j)
            mm_set(result, i, j, av * bv)
            j += 1
    result

// mm_power — raise square matrix m to the k-th integer power (k >= 0).
// k == 0 returns the identity matrix of the same size.
// Uses repeated multiplication (not fast exponentiation — n is small).
fn mm_power(m: any, k: int) -> any
    let n = m["r"]
    let result = mm_identity(n)
    for i in 0..k
        result = mm_mul(result, m)
    result

// _mm_approx — true if two floats are within tol of each other.
fn _mm_approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < tol

// mm_equal — true if two same-shape matrices are element-wise within tol.
fn mm_equal(a: any, b: any, tol: float) -> bool
    let r = a["r"]
    let c = a["c"]
    let ok = true
    for i in 0..r
        let j = 0
        while j < c
            let av = mm_get(a, i, j)
            let bv = mm_get(b, i, j)
            if not _mm_approx(av, bv, tol)
                ok = false
            j += 1
    ok
