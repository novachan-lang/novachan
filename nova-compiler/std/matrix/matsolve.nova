// std/matrix/matsolve.nova — Linear system solver A x = b.
// LEAF — imports NOTHING.
// Matrix representation: dict{r:int, c:int, d:list[float]} row-major flat.
// Public prefix: msv_
//
// API:
//   msv_solve(a, b)                -> list  solve A x = b (empty if singular)
//   msv_solve_multiple(a, bmat)    -> any   solve A X = B for multiple rhs (returns list of solution vectors)
//   msv_residual(a, x, b)          -> float ||A x - b|| (Euclidean norm of residual)
//   msv_is_consistent(a, b, tol)   -> bool  true if the system has a solution
//   msv_solvable(a, tol)           -> bool  true if A is nonsingular (full rank)
//   msv_cramer_2x2(a, b)           -> list  Cramer's rule solution for 2×2 system
//   msv_verify(a, x, b, tol)       -> bool  true if A x == b within tol

// --- Private matrix helpers (self-contained) ---

fn _msv_mat_make(r, c, data)
    let m = {}
    m["r"] = r
    m["c"] = c
    m["d"] = data
    m

// msv_make: public constructor — build a matrix dict from rows, cols, flat row-major data.
fn msv_make(r, c, data)
    return _msv_mat_make(r, c, data)

fn _msv_mat_get(m, i, j)
    let cols = m["c"]
    let d = m["d"]
    let idx = i * cols + j
    d[idx] * 1.0

fn _msv_mat_set(m, i, j, v)
    let cols = m["c"]
    let d = m["d"]
    let idx = i * cols + j
    d[idx] = v

fn _msv_mat_zeros(r, c)
    let total = r * c
    let data = [0.0 for k in 0..total]
    _msv_mat_make(r, c, data)

fn _msv_mat_copy(m)
    let r = m["r"]
    let c = m["c"]
    let d = m["d"]
    let nd = []
    let k = 0
    let total = r * c
    while k < total
        push(nd, d[k] * 1.0)
        k = k + 1
    _msv_mat_make(r, c, nd)

fn _msv_pivot_row(m, col, from_row)
    let r = m["r"]
    let best = from_row
    let bv = _msv_mat_get(m, from_row, col)
    if bv < 0.0
        bv = 0.0 - bv
    let i = from_row + 1
    while i < r
        let v = _msv_mat_get(m, i, col)
        if v < 0.0
            v = 0.0 - v
        if v > bv
            bv = v
            best = i
        i = i + 1
    best

fn _msv_swap_rows(m, i, j)
    let mc = _msv_mat_copy(m)
    let c = mc["c"]
    for k in 0..c
        let vi = _msv_mat_get(mc, i, k)
        let vj = _msv_mat_get(mc, j, k)
        _msv_mat_set(mc, i, k, vj)
        _msv_mat_set(mc, j, k, vi)
    mc

fn _msv_add_scaled_row(m, dst, src, factor)
    let mc = _msv_mat_copy(m)
    let c = mc["c"]
    for k in 0..c
        let vdst = _msv_mat_get(mc, dst, k)
        let vsrc = _msv_mat_get(mc, src, k)
        _msv_mat_set(mc, dst, k, vdst + factor * vsrc)
    mc

// _msv_det2 — determinant of a 2×2 matrix.
fn _msv_det2(a)
    let a00 = _msv_mat_get(a, 0, 0)
    let a01 = _msv_mat_get(a, 0, 1)
    let a10 = _msv_mat_get(a, 1, 0)
    let a11 = _msv_mat_get(a, 1, 1)
    a00 * a11 - a01 * a10

// _msv_gauss_elim_aug — forward elimination on augmented [A|b], returns [upper_mat, rhs].
fn _msv_gauss_elim_aug(a, b)
    let r = a["r"]
    let c = a["c"]
    let aug_data = []
    for i in 0..r
        let j = 0
        while j < c
            push(aug_data, _msv_mat_get(a, i, j))
            j = j + 1
        push(aug_data, b[i] * 1.0)
    let aug = _msv_mat_make(r, c + 1, aug_data)
    let tol = 0.000001
    let pivot_row = 0
    let col = 0
    while col < c
        if pivot_row >= r
            col = c
        else
            let pr = _msv_pivot_row(aug, col, pivot_row)
            let pv = _msv_mat_get(aug, pr, col)
            if pv < 0.0
                pv = 0.0 - pv
            if pv < tol
                col = col + 1
            else
                if pr != pivot_row
                    aug = _msv_swap_rows(aug, pivot_row, pr)
                let diag = _msv_mat_get(aug, pivot_row, col)
                let row = pivot_row + 1
                while row < r
                    let v = _msv_mat_get(aug, row, col)
                    let factor = 0.0 - (v / diag)
                    aug = _msv_add_scaled_row(aug, row, pivot_row, factor)
                    row = row + 1
                pivot_row = pivot_row + 1
                col = col + 1
    let upper_data = []
    for bi in 0..r
        let j = 0
        while j < c
            push(upper_data, _msv_mat_get(aug, bi, j))
            j = j + 1
    let upper = _msv_mat_make(r, c, upper_data)
    let rhs = [_msv_mat_get(aug, ri, c) for ri in 0..r]
    let result = []
    push(result, upper)
    push(result, rhs)
    result

// _msv_back_sub — back substitution for upper-triangular U x = b.
fn _msv_back_sub(u, b)
    let n = u["r"]
    let x = [0.0 for k in 0..n]
    let tol = 0.000001
    let i = n - 1
    while i >= 0
        let uii = _msv_mat_get(u, i, i)
        if uii < 0.0
            uii = 0.0 - uii
        if uii < tol
            return []
        let sum = b[i] * 1.0
        let j = i + 1
        while j < n
            let uij = _msv_mat_get(u, i, j)
            let xj = x[j] * 1.0
            sum = sum - uij * xj
            j = j + 1
        let uii_real = _msv_mat_get(u, i, i)
        x[i] = sum / uii_real
        i = i - 1
    x

// --- Public API ---

// msv_solve — solve A x = b via Gaussian elimination + back-substitution.
// Returns solution vector x, or empty list if A is singular.
fn msv_solve(a, b)
    let elim = _msv_gauss_elim_aug(a, b)
    let upper = elim[0]
    let rhs = elim[1]
    _msv_back_sub(upper, rhs)

// msv_solve_multiple — solve A X = B for multiple right-hand sides.
// bmat is a list of b-vectors; returns a list of solution vectors.
fn msv_solve_multiple(a, bmat)
    let solutions = []
    for k in 0..len(bmat)
        let x = msv_solve(a, bmat[k])
        push(solutions, x)
    solutions

// msv_residual — Euclidean norm ||A x - b||.
fn msv_residual(a, x, b)
    let r = a["r"]
    let c = a["c"]
    let sum_sq = 0.0
    for i in 0..r
        let ax_i = 0.0
        let j = 0
        while j < c
            let aij = _msv_mat_get(a, i, j)
            let xj = x[j] * 1.0
            ax_i = ax_i + aij * xj
            j = j + 1
        let bi = b[i] * 1.0
        let diff = ax_i - bi
        sum_sq = sum_sq + diff * diff
    sqrt(sum_sq)

// msv_is_consistent — true if the system A x = b has at least one solution.
fn msv_is_consistent(a, b, tol)
    let x = msv_solve(a, b)
    if len(x) == 0
        return false
    let res = msv_residual(a, x, b)
    res < tol

// msv_solvable — true if A is nonsingular (has full rank, solution is unique).
fn msv_solvable(a, tol)
    let n = a["r"]
    let b = [0.0 for k in 0..n]
    let elim = _msv_gauss_elim_aug(a, b)
    let upper = elim[0]
    for i in 0..n
        let uii = _msv_mat_get(upper, i, i)
        if uii < 0.0
            uii = 0.0 - uii
        if uii < tol
            return false
    true

// msv_cramer_2x2 — solve 2×2 system using Cramer's rule.
// Returns [x1, x2] or empty list if det == 0.
fn msv_cramer_2x2(a, b)
    let a00 = _msv_mat_get(a, 0, 0)
    let a01 = _msv_mat_get(a, 0, 1)
    let a10 = _msv_mat_get(a, 1, 0)
    let a11 = _msv_mat_get(a, 1, 1)
    let b0 = b[0] * 1.0
    let b1 = b[1] * 1.0
    let det = a00 * a11 - a01 * a10
    if det < 0.0
        det = 0.0 - det
    if det < 0.000001
        return []
    let det_real = a00 * a11 - a01 * a10
    let x1 = (b0 * a11 - a01 * b1) / det_real
    let x2 = (a00 * b1 - b0 * a10) / det_real
    let result = []
    push(result, x1)
    push(result, x2)
    result

// msv_verify — true if ||A x - b|| < tol.
fn msv_verify(a, x, b, tol)
    let res = msv_residual(a, x, b)
    res < tol
