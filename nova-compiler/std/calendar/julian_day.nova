// std/calendar/julian_day.nova — Julian Day Number (JDN) core.
// LEAF — imports NOTHING.
//
// Public API:
//   greg_to_jdn(y, m, d) -> int   Proleptic Gregorian date to Julian Day Number
//   jdn_to_greg(jdn)     -> list  JDN to [y, m, d] via Richards algorithm
//   jdn_weekday(jdn)     -> int   0=Monday .. 6=Sunday (ISO weekday)
//
// Reference values:
//   greg_to_jdn(2000,1,1) == 2451545  (J2000.0 epoch)
//   greg_to_jdn(1970,1,1) == 2440588  (Unix epoch)
//   jdn_weekday(2451545)  == 5        (Saturday: 2000-01-01 was Saturday)
//
// PRIVATE prefix: _jdn_

// _jdn_fdiv — floor division (toward -infinity).
// NOVA '/' truncates toward zero; for positive operands floor == trunc.
// For negative dividends we correct by -1 when remainder is nonzero.
fn _jdn_fdiv(a, b)
    let q = a / b
    if (a < 0) != (b < 0)
        if a - q * b != 0
            return q - 1
    q

// greg_to_jdn — Proleptic Gregorian calendar date to Julian Day Number.
// Formula: Meeus "Astronomical Algorithms" 2nd ed., ch. 7 (fully integer).
// Valid for all positive years; integer division truncates toward zero which
// equals floor for the positive intermediate values that arise here.
fn greg_to_jdn(y, m, d)
    let a = (14 - m) / 12
    let yy = y + 4800 - a
    let mm = m + 12*a - 3
    return d + (153*mm + 2)/5 + 365*yy + yy/4 - yy/100 + yy/400 - 32045

// jdn_to_greg — Convert Julian Day Number to proleptic Gregorian [y, m, d].
// Richards (2013) algorithm, proleptic Gregorian variant.
// All modular reductions computed as: a mod b = a - (a/b)*b  (b > 0, a >= 0 here).
fn jdn_to_greg(jdn)
    let f = jdn + 1401 + (_jdn_fdiv(_jdn_fdiv(4*jdn + 274277, 146097) * 3, 4)) - 38
    let e = 4*f + 3
    let g = (e - (e/1461)*1461) / 4
    let h = 5*g + 2
    let hdiv = h / 153
    let day = (h - hdiv*153) / 5 + 1
    let month = (hdiv + 2) - ((hdiv + 2) / 12) * 12 + 1
    let year = _jdn_fdiv(e, 1461) - 4716 + (14 - month) / 12
    return [year, month, day]

// jdn_weekday — ISO weekday from Julian Day Number.
// Returns 0=Monday, 1=Tuesday, 2=Wednesday, 3=Thursday, 4=Friday,
//         5=Saturday, 6=Sunday.
// JDN 0 is Monday (proleptic Julian 4713 BC Nov 24 = Monday).
// jdn mod 7 maps directly: 0=Mon, ..., 5=Sat, 6=Sun.
// Verified: 2451545 mod 7 = 5 (Saturday, correct for 2000-01-01).
fn jdn_weekday(jdn)
    jdn - _jdn_fdiv(jdn, 7) * 7
