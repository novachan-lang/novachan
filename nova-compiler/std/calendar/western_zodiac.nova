// ============================================================================
// NOVA Standard Library — std/calendar/western_zodiac
// Western (tropical) zodiac: sun signs, date ranges, and elements.
// Pure integer arithmetic; no floating point, no runtime calls.
// ============================================================================
//
// PUBLIC API:
//   western_zodiac(m, d) -> string
//       Returns the zodiac sign name for the given month (1-12) and day (1-31).
//       Boundaries use the traditional (Lahiri-aligned) cutoffs.
//
//   zodiac_dates(sign) -> list [start_m, start_d, end_m, end_d]
//       Returns the start and end dates for the named sign.
//       Returns [0, 0, 0, 0] for an unrecognised sign name.
//
//   zodiac_element(sign) -> string  ("fire" | "earth" | "air" | "water")
//       Returns the classical element for the named sign.
//       Returns "unknown" for an unrecognised sign name.
//
// SIGN BOUNDARIES (traditional):
//   Aries        Mar 21 – Apr 19   fire
//   Taurus       Apr 20 – May 20   earth
//   Gemini       May 21 – Jun 20   air
//   Cancer       Jun 21 – Jul 22   water
//   Leo          Jul 23 – Aug 22   fire
//   Virgo        Aug 23 – Sep 22   earth
//   Libra        Sep 23 – Oct 22   air
//   Scorpio      Oct 23 – Nov 21   water
//   Sagittarius  Nov 22 – Dec 21   fire
//   Capricorn    Dec 22 – Jan 19   earth
//   Aquarius     Jan 20 – Feb 18   air
//   Pisces       Feb 19 – Mar 20   water
//
// REFERENCE VALUES:
//   western_zodiac(3, 25) = "Aries"
//   western_zodiac(1,  1) = "Capricorn"
//   western_zodiac(6, 15) = "Gemini"
//   western_zodiac(12,25) = "Capricorn"
//   zodiac_element("Aries") = "fire"
//
// PRIVATE prefix: _wz_
// ============================================================================

// ── western_zodiac ────────────────────────────────────────────────────────────
// Returns the sun sign for a given (month, day).
// Walk through each month; within the month compare the day to the cutoff.
// Before the cutoff = previous sign; on/after = current sign.
//
// Encoding per month:
//   Jan: <20 = Capricorn, >=20 = Aquarius
//   Feb: <19 = Aquarius,  >=19 = Pisces
//   Mar: <21 = Pisces,    >=21 = Aries
//   Apr: <20 = Aries,     >=20 = Taurus
//   May: <21 = Taurus,    >=21 = Gemini
//   Jun: <21 = Gemini,    >=21 = Cancer
//   Jul: <23 = Cancer,    >=23 = Leo
//   Aug: <23 = Leo,       >=23 = Virgo
//   Sep: <23 = Virgo,     >=23 = Libra
//   Oct: <23 = Libra,     >=23 = Scorpio
//   Nov: <22 = Scorpio,   >=22 = Sagittarius
//   Dec: <22 = Sagittarius, >=22 = Capricorn

fn western_zodiac(m, d) -> string
    if m == 1
        if d < 20
            return "Capricorn"
        return "Aquarius"
    if m == 2
        if d < 19
            return "Aquarius"
        return "Pisces"
    if m == 3
        if d < 21
            return "Pisces"
        return "Aries"
    if m == 4
        if d < 20
            return "Aries"
        return "Taurus"
    if m == 5
        if d < 21
            return "Taurus"
        return "Gemini"
    if m == 6
        if d < 21
            return "Gemini"
        return "Cancer"
    if m == 7
        if d < 23
            return "Cancer"
        return "Leo"
    if m == 8
        if d < 23
            return "Leo"
        return "Virgo"
    if m == 9
        if d < 23
            return "Virgo"
        return "Libra"
    if m == 10
        if d < 23
            return "Libra"
        return "Scorpio"
    if m == 11
        if d < 22
            return "Scorpio"
        return "Sagittarius"
    if m == 12
        if d < 22
            return "Sagittarius"
        return "Capricorn"
    "Unknown"

// ── zodiac_dates ──────────────────────────────────────────────────────────────
// Returns [start_m, start_d, end_m, end_d] for the named zodiac sign.
// Returns [0, 0, 0, 0] for an unrecognised name.

fn zodiac_dates(sign) -> list
    if sign == "Aries"
        return [3, 21, 4, 19]
    if sign == "Taurus"
        return [4, 20, 5, 20]
    if sign == "Gemini"
        return [5, 21, 6, 20]
    if sign == "Cancer"
        return [6, 21, 7, 22]
    if sign == "Leo"
        return [7, 23, 8, 22]
    if sign == "Virgo"
        return [8, 23, 9, 22]
    if sign == "Libra"
        return [9, 23, 10, 22]
    if sign == "Scorpio"
        return [10, 23, 11, 21]
    if sign == "Sagittarius"
        return [11, 22, 12, 21]
    if sign == "Capricorn"
        return [12, 22, 1, 19]
    if sign == "Aquarius"
        return [1, 20, 2, 18]
    if sign == "Pisces"
        return [2, 19, 3, 20]
    [0, 0, 0, 0]

// ── zodiac_element ────────────────────────────────────────────────────────────
// Returns the classical element ("fire", "earth", "air", "water") for a sign.
// Fire:  Aries, Leo, Sagittarius
// Earth: Taurus, Virgo, Capricorn
// Air:   Gemini, Libra, Aquarius
// Water: Cancer, Scorpio, Pisces

fn zodiac_element(sign) -> string
    if sign == "Aries" or sign == "Leo" or sign == "Sagittarius"
        return "fire"
    if sign == "Taurus" or sign == "Virgo" or sign == "Capricorn"
        return "earth"
    if sign == "Gemini" or sign == "Libra" or sign == "Aquarius"
        return "air"
    if sign == "Cancer" or sign == "Scorpio" or sign == "Pisces"
        return "water"
    "unknown"
