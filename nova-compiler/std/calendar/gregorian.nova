// std/calendar/gregorian.nova — Gregorian calendar arithmetic helpers.
// LEAF — imports NOTHING.
//
// Public API:
//   greg_is_leap(y)          -> bool  True iff year y is a Gregorian leap year
//   greg_days_in_month(y, m) -> int   Days in month m of year y (1-indexed)
//   greg_day_of_year(y, m, d)-> int   Ordinal day-of-year (1=Jan-1, 365/366=Dec-31)
//   greg_valid(y, m, d)      -> bool  True iff (y, m, d) is a valid Gregorian date
//
// Gregorian leap year rule:
//   Divisible by 4 AND (not divisible by 100 OR divisible by 400).
//
// Reference values:
//   greg_is_leap(2000)  == true   (div by 400)
//   greg_is_leap(1900)  == false  (div by 100 but not 400)
//   greg_is_leap(2024)  == true   (div by 4, not by 100)
//   greg_is_leap(2023)  == false

// greg_is_leap — True iff year y is a Gregorian leap year.
fn greg_is_leap(y)
    if (y - (y/4)*4) != 0
        return false
    if (y - (y/100)*100) != 0
        return true
    if (y - (y/400)*400) != 0
        return false
    true

// _greg_dim_common — days in each month for a common (non-leap) year.
// Index 1-12 maps m -> day count; [0] unused.
fn _greg_dim_common(m)
    if m == 1
        return 31
    if m == 2
        return 28
    if m == 3
        return 31
    if m == 4
        return 30
    if m == 5
        return 31
    if m == 6
        return 30
    if m == 7
        return 31
    if m == 8
        return 31
    if m == 9
        return 30
    if m == 10
        return 31
    if m == 11
        return 30
    31

// greg_days_in_month — Days in month m of year y.
// m must be 1..12.  Returns 28, 29, 30, or 31.
fn greg_days_in_month(y, m)
    if m == 2
        if greg_is_leap(y)
            return 29
        return 28
    _greg_dim_common(m)

// greg_day_of_year — Ordinal day-of-year for (y, m, d).
// Returns 1 for Jan 1, up to 365 (common) or 366 (leap) for Dec 31.
// Computed by summing days in prior months then adding d.
fn greg_day_of_year(y, m, d)
    let total = d
    for month in 1..m
        total = total + greg_days_in_month(y, month)
    total

// greg_valid — True iff (y, m, d) is a valid proleptic Gregorian date.
// Requires: y any integer, m in 1..12, d in 1..days_in_month(y,m).
fn greg_valid(y, m, d)
    if m < 1
        return false
    if m > 12
        return false
    if d < 1
        return false
    if d > greg_days_in_month(y, m)
        return false
    true
