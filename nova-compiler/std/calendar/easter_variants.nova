// ============================================================================
// NOVA Standard Library — std/calendar/easter_variants
// Western and Orthodox Easter date computation.  Pure integer arithmetic.
// ============================================================================
//
// PUBLIC API:
//   easter_western(y)  -> list [y, m, d]  (Gregorian, Meeus/Jones/Butcher)
//   easter_orthodox(y) -> list [y, m, d]  (Julian computus, Gregorian expression)
//
// ALGORITHMS:
//   easter_western:  Anonymous Gregorian algorithm (Meeus/Jones/Butcher).
//                    Correct for all Gregorian years from 1582 onward.
//   easter_orthodox: Anonymous Julian algorithm ("Meeus Julian"), then add the
//                    Julian-to-Gregorian century offset so the result is
//                    expressed as a Gregorian calendar date.
//
// REFERENCE VALUES:
//   easter_western(2024)  = [2024, 3, 31]
//   easter_western(2025)  = [2025, 4, 20]
//   easter_western(2027)  = [2027, 3, 28]
//   easter_orthodox(2024) = [2024, 5, 5]
//
// PRIVATE prefix: _ev_
// ============================================================================

// ── Days-per-month helper (non-leap) ─────────────────────────────────────────

fn _ev_is_leap(y) -> bool
    if y % 400 == 0
        return true
    if y % 100 == 0
        return false
    if y % 4 == 0
        return true
    false

fn _ev_days_in_month(y, m) -> int
    if m == 2
        if _ev_is_leap(y)
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    31

// ── Advance a Gregorian date by n days ───────────────────────────────────────
// Used to shift the Julian Easter date into the Gregorian calendar.

fn _ev_add_days(y, m, d, n) -> list
    let yy = y
    let mm = m
    let dd = d + n
    let done = 0
    while done == 0
        let dim = _ev_days_in_month(yy, mm)
        if dd <= dim
            done = 1
        if done == 0
            dd = dd - dim
            mm = mm + 1
            if mm > 12
                mm = 1
                yy = yy + 1
    [yy, mm, dd]

// ── Julian-to-Gregorian offset ───────────────────────────────────────────────
// Returns the number of Gregorian days ahead of the Julian calendar for year y.
// Formula: (y/100 - y/400 - 2) where / is integer truncation.
// For 1900–2099 this equals 13; for 2100–2199 it equals 14, etc.

fn _ev_jg_offset(y) -> int
    y / 100 - y / 400 - 2

// ── easter_western ───────────────────────────────────────────────────────────
// Meeus/Jones/Butcher algorithm for the Gregorian Easter.
// Returns [year, month, day].

fn easter_western(y) -> list
    let a = y - (y / 19) * 19
    let b = y / 100
    let c = y - (y / 100) * 100
    let d = b / 4
    let e = b - (b / 4) * 4
    let f = (b + 8) / 25
    let g = (b - f + 1) / 3
    let h = (19 * a + b - d - g + 15) - ((19 * a + b - d - g + 15) / 30) * 30
    let i = c / 4
    let k = c - (c / 4) * 4
    let l = (32 + 2 * e + 2 * i - h - k) - ((32 + 2 * e + 2 * i - h - k) / 7) * 7
    let m2 = (a + 11 * h + 22 * l) / 451
    let month = (h + l - 7 * m2 + 114) / 31
    let day = (h + l - 7 * m2 + 114) - ((h + l - 7 * m2 + 114) / 31) * 31 + 1
    [y, month, day]

// ── easter_orthodox ──────────────────────────────────────────────────────────
// Anonymous Julian algorithm for the Orthodox Easter (Old Calendar computus),
// then converted to the Gregorian calendar by adding the Julian-to-Gregorian
// offset for the given year.
// Returns [year, month, day] in the Gregorian calendar.

fn easter_orthodox(y) -> list
    let a = y - (y / 4) * 4
    let b = y - (y / 7) * 7
    let c = y - (y / 19) * 19
    let d = (19 * c + 15) - ((19 * c + 15) / 30) * 30
    let e = (2 * a + 4 * b - d + 34) - ((2 * a + 4 * b - d + 34) / 7) * 7
    let month = (d + e + 114) / 31
    let day = (d + e + 114) - ((d + e + 114) / 31) * 31 + 1
    // Julian Easter date is [y, month, day]; convert to Gregorian.
    let offset = _ev_jg_offset(y)
    _ev_add_days(y, month, day, offset)
