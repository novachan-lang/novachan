// ============================================================================
// NOVA Standard Library — std/calendar/islamic
// Tabular Islamic (Hijri) calendar conversions via Julian Day Number.
//
// Epoch: 1 Muharram 1 AH = JDN 1948440 (astronomical/Thursday epoch).
// Leap year rule: 11 leap years in a 30-year cycle.
// Leap years (within each 30-year period): 2, 5, 7, 10, 13, 16, 18, 21, 24, 26, 29.
//
// PUBLIC API:
//   islamic_to_jdn(y, m, d) -> int   convert Islamic date to JDN
//   jdn_to_islamic(jdn)     -> list  [y, m, d] convert JDN to Islamic date
//   islamic_is_leap(y)      -> bool  true if y is a leap year in the tabular cycle
// ============================================================================

// islamic_is_leap: returns true if y is a leap year in the 30-year cycle.
// Leap years are 2, 5, 7, 10, 13, 16, 18, 21, 24, 26, 29 within each cycle.
// Equivalent to: (11*y + 14) mod 30 < 11
fn islamic_is_leap(y) -> bool
    let r = (11 * y + 14) % 30
    r < 11

// _islamic_year_length: number of days in Islamic year y (354 or 355).
fn _islamic_year_length(y) -> int
    if islamic_is_leap(y)
        return 355
    354

// _islamic_month_days: number of days in month m of Islamic year y.
// Odd months have 30 days, even months have 29 days,
// except month 12 has 30 days in a leap year.
fn _islamic_month_days(y, m) -> int
    if m == 12
        if islamic_is_leap(y)
            return 30
        return 29
    if m % 2 == 1
        return 30
    29

// _cum_years: cumulative days in years 1..(n) within a 30-year cycle (0-indexed n=yr_in_cyc).
// Formula: n*354 + floor((11*n + 3)/30)
// Counts: n*354 base days, plus the leap day extras for the leap years in 1..n.
// Leap years in positions 1..n of a cycle: the formula (11*n+3)/30 counts them.
fn _cum_years(n) -> int
    n * 354 + (11 * n + 3) / 30

// islamic_to_jdn: convert tabular Islamic date (y, m, d) to Julian Day Number.
// Formula derived from the epoch: 1/1/1 AH = JDN 1948440.
//
// Month cumulative days before month m (months are alternating 30/29 days):
//   Cum[1]=0, Cum[2]=30, Cum[3]=59, Cum[4]=89, Cum[5]=118, Cum[6]=148,
//   Cum[7]=177, Cum[8]=207, Cum[9]=236, Cum[10]=266, Cum[11]=295, Cum[12]=325
// Formula: (29*(m-1)) + m/2  (integer division)
// Verification: m=1: 0+0=0; m=2: 29+1=30; m=3: 58+1=59; m=12: 319+6=325 ✓
fn islamic_to_jdn(y, m, d) -> int
    // Complete 30-year cycles before year y (0-indexed)
    let cyc = (y - 1) / 30
    let yr_in_cyc = (y - 1) % 30
    // Days from complete cycles + leftover years within cycle
    let days = cyc * 10631 + _cum_years(yr_in_cyc)
    // Cumulative days of months 1..m-1 within year y
    let mon_days = (29 * (m - 1)) + m / 2
    // Epoch offset + year days + month days + day (1-based) → JDN
    1948440 + days + mon_days + d - 1

// jdn_to_islamic: convert Julian Day Number to tabular Islamic date [y, m, d].
// Algorithm:
//   1. Shift to 0-based offset n from epoch.
//   2. Find the 30-year cycle and day within that cycle.
//   3. Estimate year within cycle using floor approximation, then adjust forward.
//   4. Find month by subtracting month lengths.
fn jdn_to_islamic(jdn) -> list
    // 0-based day count from Islamic epoch
    let n = jdn - 1948440
    // Decompose into 30-year cycles
    let cyc = n / 10631
    let rem = n % 10631
    // Handle negative remainder for pre-epoch dates
    if rem < 0
        cyc = cyc - 1
        rem = rem + 10631
    // Estimate year within cycle (0-based, 0..29) using floor: slightly under-shoots.
    // cyc_year in 0..29; _cum_years(cyc_year) <= rem < _cum_years(cyc_year+1)
    let cyc_year = 30 * rem / 10631
    // Clamp to valid range
    if cyc_year > 29
        cyc_year = 29
    // Day offset within estimated year
    let diy = rem - _cum_years(cyc_year)
    // Step forward if the estimate undershot (diy >= year length)
    let ylen = _islamic_year_length(cyc * 30 + cyc_year + 1)
    while diy >= ylen
        cyc_year = cyc_year + 1
        diy = diy - ylen
        ylen = _islamic_year_length(cyc * 30 + cyc_year + 1)
    // Reconstruct absolute Islamic year
    let y = cyc * 30 + cyc_year + 1
    // Find month by subtracting month lengths from diy (0-based day in year)
    let m = 1
    let mdays = _islamic_month_days(y, m)
    while diy >= mdays
        diy = diy - mdays
        m = m + 1
        mdays = _islamic_month_days(y, m)
    let d = diy + 1
    let result = []
    push(result, y)
    push(result, m)
    push(result, d)
    result
