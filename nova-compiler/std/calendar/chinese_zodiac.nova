// ============================================================================
// NOVA Standard Library — std/calendar/chinese_zodiac
// Chinese zodiac animal, element, and sexagenary cycle position by year.
// Pure integer arithmetic; all cycles anchored to known reference years.
// ============================================================================
//
// PUBLIC API:
//   chinese_zodiac(y)      -> string  animal name (12-year cycle; 2020 = Rat)
//   chinese_element(y)     -> string  element name (10-year stem cycle; 2024 = Wood)
//   chinese_sexagenary(y)  -> int     position 1..60 in the sexagenary cycle
//
// CYCLES:
//   Animal (12-year):    Rat Ox Tiger Rabbit Dragon Snake Horse Goat
//                        Monkey Rooster Dog Pig  (anchor: 2020 = Rat, index 0)
//   Element (10-year stem, 2 years per element):
//                        Wood Fire Earth Metal Water  (anchor: 2024 = Wood)
//                        Years ending in 4-5 = Wood, 6-7 = Fire, 8-9 = Earth,
//                        0-1 = Metal, 2-3 = Water.
//   Sexagenary (60-year):anchor 1984 = position 1 (Jiazi: Wood Rat).
//
// REFERENCE VALUES:
//   chinese_zodiac(2020)  = "Rat"
//   chinese_zodiac(2021)  = "Ox"
//   chinese_zodiac(2024)  = "Dragon"
//   chinese_zodiac(2008)  = "Rat"
//   chinese_element(2024) = "Wood"
//   chinese_sexagenary(1984) = 1
//   chinese_sexagenary(2024) = 41
//
// NOTES:
//   These functions operate on the YEAR NUMBER only, not on the lunar new year
//   boundary.  This is the simplified astronomical/astronomical convention
//   (year starts Jan 1).  For strictly lunar-calendar accuracy the boundary
//   would shift by up to ~7 weeks, but that requires a separate lunar calendar
//   module.  The KAT vectors all fall in the safe mid-year region.
//
// PRIVATE prefix: _cz_
// ============================================================================

// ── Positive modulo helper ────────────────────────────────────────────────────
// NOVA '/' truncates toward zero.  For y with any sign we need true modulo >= 0.

fn _cz_mod(a, b) -> int
    let r = a - (a / b) * b
    if r < 0
        return r + b
    r

// ── chinese_zodiac ────────────────────────────────────────────────────────────
// Returns the Chinese zodiac animal for the given year.
// Anchor: 2020 = Rat (index 0 in the 12-year cycle).
// Sequence (0..11): Rat Ox Tiger Rabbit Dragon Snake Horse Goat Monkey Rooster Dog Pig

fn chinese_zodiac(y) -> string
    let idx = _cz_mod(y - 2020, 12)
    if idx == 0
        return "Rat"
    if idx == 1
        return "Ox"
    if idx == 2
        return "Tiger"
    if idx == 3
        return "Rabbit"
    if idx == 4
        return "Dragon"
    if idx == 5
        return "Snake"
    if idx == 6
        return "Horse"
    if idx == 7
        return "Goat"
    if idx == 8
        return "Monkey"
    if idx == 9
        return "Rooster"
    if idx == 10
        return "Dog"
    "Pig"

// ── chinese_element ───────────────────────────────────────────────────────────
// Returns the Chinese element for the given year based on the 10-year Heavenly
// Stem cycle.  Two consecutive years share the same element; the cycle is:
//   Wood (last digit 4-5), Fire (6-7), Earth (8-9), Metal (0-1), Water (2-3).
// This matches the traditional Stems: Jia/Yi=Wood, Bing/Ding=Fire, Wu/Ji=Earth,
// Geng/Xin=Metal, Ren/Gui=Water.

fn chinese_element(y) -> string
    let last = _cz_mod(y, 10)
    if last == 4 or last == 5
        return "Wood"
    if last == 6 or last == 7
        return "Fire"
    if last == 8 or last == 9
        return "Earth"
    if last == 0 or last == 1
        return "Metal"
    "Water"

// ── chinese_sexagenary ────────────────────────────────────────────────────────
// Returns the 1-based position (1..60) in the 60-year sexagenary cycle.
// Anchor: 1984 = position 1 (Jiazi — Wood Rat).
// Formula: ((y - 1984) mod 60) + 1.

fn chinese_sexagenary(y) -> int
    _cz_mod(y - 1984, 60) + 1
