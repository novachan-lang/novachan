// ============================================================================
// NOVA Standard Library — std/calendar/julian_cal
// The (proleptic) Julian calendar: conversions to/from Julian Day Numbers,
// leap-year test, and round-trip codec.
//
// The Julian calendar was introduced by Julius Caesar in 45 BC and remained
// the civil calendar of Europe until the Gregorian reform of 1582.
// Leap year rule: every year divisible by 4 is a leap year (no century rule).
//
// PUBLIC API:
//   julian_is_leap(y)          -> bool   (true iff y % 4 == 0)
//   julian_days_in_month(y, m) -> int    (1..31, Feb=29 in leap years)
//   julian_to_jdn(y, m, d)    -> int    (proleptic Julian date -> JDN)
//   jdn_to_julian(jdn)         -> list   [y, m, d]
// ============================================================================

// julian_is_leap: every year divisible by 4 is a leap year in the Julian
// calendar.  Unlike the Gregorian calendar there is NO century exception.
fn julian_is_leap(y) -> bool
    y % 4 == 0

// _jul_std_days: days in month m for a non-leap year (internal helper).
fn _jul_std_days(m) -> int
    if m == 2
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    31

// julian_days_in_month: days in month m of Julian year y.
fn julian_days_in_month(y, m) -> int
    if m == 2 and julian_is_leap(y)
        return 29
    _jul_std_days(m)

// julian_to_jdn: convert a proleptic Julian calendar date (y, m, d) to a
// Julian Day Number using the standard astronomical formula.
//
// Formula (Richards 2013 / USNO):
//   a  = (14 - m) / 12
//   Y  = y + 4800 - a
//   M  = m + 12*a - 3
//   JDN = d + (153*M + 2)/5 + 365*Y + Y/4 - 32083
//
// Reference: julian_to_jdn(1, 1, 1) == 1721424 (proleptic Julian epoch)
//            julian_to_jdn(1970, 1, 1) == 2440601 (Julian 1 Jan 1970)
fn julian_to_jdn(y, m, d) -> int
    let a = (14 - m) / 12
    let yy = y + 4800 - a
    let mm = m + 12 * a - 3
    d + (153 * mm + 2) / 5 + 365 * yy + yy / 4 - 32083

// jdn_to_julian: convert a Julian Day Number back to a proleptic Julian
// calendar date [y, m, d].
//
// Inverse of julian_to_jdn using Richards 2013 algorithm variant for Julian.
//
// Returns list [year, month, day] (all integers, 1-based month/day).
fn jdn_to_julian(jdn) -> list
    let c = jdn + 32082
    let d0 = (4 * c + 3) / 1461
    let e = c - (1461 * d0) / 4
    let m0 = (5 * e + 2) / 153
    let day = e - (153 * m0 + 2) / 5 + 1
    let month = m0 + 3 - 12 * (m0 / 10)
    let year = d0 - 4800 + m0 / 10
    [year, month, day]
