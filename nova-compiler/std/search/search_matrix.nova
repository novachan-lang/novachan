// std/search/search_matrix.nova — Searching in sorted 2D matrices.
//
// Three search strategies for sorted matrices:
//   sm_search_row_col_sorted  — staircase O(R+C), works when each row AND each
//       column is sorted ascending (not required to be fully sorted overall).
//   sm_find_position          — same staircase, returns [row, col] or [-1, -1].
//   sm_search_fully_sorted    — O(log(R*C)) binary search, requires each row
//       ascending AND first element of row i+1 > last element of row i.
//
// All functions are prefix-free (prefix sm_). No imports.

// sm_search_row_col_sorted — return true if t exists in a row-and-column sorted
// matrix using staircase search starting from the top-right corner.
fn sm_search_row_col_sorted(mat: list, t: int) -> bool
    let rows = len(mat)
    if rows == 0
        return false
    let cols = len(mat[0])
    if cols == 0
        return false
    let r = 0
    let c = cols - 1
    while r < rows and c >= 0
        let v = mat[r][c]
        if v == t
            return true
        if v > t
            c -= 1
        else
            r += 1
    return false

// sm_find_position — return [row, col] of t in a row-and-column sorted matrix,
// or [-1, -1] if not found. Uses staircase search from the top-right corner.
fn sm_find_position(mat: list, t: int) -> list
    let rows = len(mat)
    if rows == 0
        let not_found = [-1, -1]
        return not_found
    let cols = len(mat[0])
    if cols == 0
        let not_found2 = [-1, -1]
        return not_found2
    let r = 0
    let c = cols - 1
    while r < rows and c >= 0
        let v = mat[r][c]
        if v == t
            let found = [r, c]
            return found
        if v > t
            c -= 1
        else
            r += 1
    let miss = [-1, -1]
    return miss

// sm_search_fully_sorted — return true if t exists in a fully sorted matrix
// (each row ascending, and first element of each row > last element of previous
// row). Binary searches the virtual flat sequence of R*C elements.
fn sm_search_fully_sorted(mat: list, t: int) -> bool
    let rows = len(mat)
    if rows == 0
        return false
    let cols = len(mat[0])
    if cols == 0
        return false
    let lo = 0
    let total = rows * cols
    let hi = total - 1
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        let mr = mid / cols
        let mc = mid - mr * cols
        let v = mat[mr][mc]
        if v == t
            return true
        if v < t
            lo = mid + 1
        else
            hi = mid - 1
    return false
