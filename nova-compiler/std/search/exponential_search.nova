// std/search/exponential_search.nova — exponential (doubling) search on sorted int lists.
// Doubles an index bound (1, 2, 4, 8, …) until a[bound] >= target or bound exceeds n,
// then does a binary search within that window. O(log n) probes.
// LEAF — imports NOTHING.
//
// Contract: input list must be sorted ascending. Duplicate values are handled correctly.
// Returns the index of an occurrence of the target, or -1 if not found.
//
// Public API:
//   es_search(a, t)   -> int   index of t in a, or -1
//   es_contains(a, t) -> bool  true iff t appears in a

// _es_bsearch — binary search in a[lo..hi] (inclusive) for value t.
// Uses mid = lo + (hi - lo) / 2 to avoid overflow. Returns index or -1.
fn _es_bsearch(a: any, lo: int, hi: int, t: int) -> int
    let l = lo
    let h = hi
    let found = -1
    while l <= h
        let mid = l + (h - l) / 2
        let v = a[mid]
        if v == t
            found = mid
            h = mid - 1
        if v < t
            l = mid + 1
        if v > t
            h = mid - 1
    found

// es_search — find t in sorted ascending list a using exponential + binary search.
// Doubles a bound index starting at 1 until a[bound] >= t or bound >= n,
// then binary-searches within [bound/2, min(bound, n-1)].
// Returns index of an occurrence of t, or -1 if not found.
fn es_search(a: any, t: int) -> int
    let n = len(a)
    if n == 0
        return -1
    if a[0] == t
        return 0
    let bound = 1
    while bound < n and a[bound] < t
        bound = bound * 2
    let lo = bound / 2
    let hi = bound
    if hi >= n
        hi = n - 1
    _es_bsearch(a, lo, hi, t)

// es_contains — true iff t appears anywhere in sorted ascending list a.
fn es_contains(a: any, t: int) -> bool
    let idx = es_search(a, t)
    idx >= 0
