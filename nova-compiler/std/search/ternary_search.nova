// std/search/ternary_search.nova — find the maximum of a strictly unimodal array.
// A strictly unimodal array strictly increases to a single maximum, then strictly decreases.
// Uses binary search on the slope: compare a[mid] vs a[mid+1] to halve the search space.
// O(log n). Works correctly on monotone arrays (all increasing or all decreasing).
// LEAF — imports NOTHING.

// ts_max_index — returns the index of the maximum element in a strictly unimodal array.
// Returns 0 for a single-element or empty array (empty: by convention).
fn ts_max_index(a: list) -> int
    let n = len(a)
    if n == 0
        return 0
    if n == 1
        return 0
    let lo = 0
    let hi = n - 1
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if a[mid] < a[mid + 1]
            lo = mid + 1
        else
            hi = mid
    lo

// ts_max_value — returns the maximum value in a strictly unimodal array.
// Returns -1 for an empty array (by convention; caller should check length).
fn ts_max_value(a: list) -> int
    let n = len(a)
    if n == 0
        return -1
    let idx = ts_max_index(a)
    a[idx]
