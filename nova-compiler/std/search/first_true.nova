// std/search/first_true.nova — Binary search on monotone predicates.
//
// All three functions use pure binary search (O(log n) or O(log target)).
//
// Public API (prefix ft_):
//   ft_boundary(bools)           -> int   first index of true in [false*,true*]; -1 if all false
//   ft_smallest_with_sq_ge(t)   -> int   smallest x>=0 s.t. x*x >= t
//   ft_largest_with_sq_le(t)    -> int   largest x>=0 s.t. x*x <= t
//
// No imports. No linear scan anywhere.

// ft_boundary — return the index of the first true in a monotone bool list
// [false, ..., false, true, ..., true]. Returns -1 if all elements are false.
// Uses binary search: lo=0, hi=len, invariant: result is in [lo, hi].
fn ft_boundary(bools: list) -> int
    let n = len(bools)
    if n == 0
        return -1
    let lo = 0
    let hi = n
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if bools[mid]
            hi = mid
        else
            lo = mid + 1
    if lo == n
        return -1
    return lo

// ft_smallest_with_sq_ge — return the smallest non-negative integer x such that
// x*x >= target. Uses binary search over [0, target+1]. For target <= 0 returns 0.
fn ft_smallest_with_sq_ge(target: int) -> int
    if target <= 0
        return 0
    let lo = 0
    let hi = target
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if mid * mid >= target
            hi = mid
        else
            lo = mid + 1
    return lo

// ft_largest_with_sq_le — return the largest non-negative integer x such that
// x*x <= target. Returns 0 when target <= 0. Uses binary search over [0, target].
fn ft_largest_with_sq_le(target: int) -> int
    if target <= 0
        return 0
    let lo = 0
    let hi = target
    while lo < hi
        let mid = lo + (hi - lo + 1) / 2
        if mid * mid <= target
            lo = mid
        else
            hi = mid - 1
    return lo
