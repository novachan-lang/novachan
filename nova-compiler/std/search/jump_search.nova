// std/search/jump_search.nova — jump search on sorted int lists.
// Jumps ahead in blocks of floor(sqrt(n)), then does a linear scan backwards
// through the block that straddles the target. O(sqrt(n)) comparisons.
// LEAF — imports NOTHING.
//
// Contract: input list must be sorted ascending. Returns first occurrence found
// in the block (linear scan from block start), or -1 if not found.
//
// Public API:
//   js_search(a, t)   -> int   index of t in a, or -1
//   js_contains(a, t) -> bool  true iff t appears in a

// _js_isqrt — integer square root of n via binary search (n >= 0).
// Returns floor(sqrt(n)).
fn _js_isqrt(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 1
    let lo = 1
    let hi = n
    // hi can be safely capped: sqrt(n) <= n/2 for n >= 4
    if hi > n / 2 + 1
        hi = n / 2 + 1
    let result = 1
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        let sq = mid * mid
        if sq == n
            return mid
        if sq < n
            result = mid
            lo = mid + 1
        if sq > n
            hi = mid - 1
    result

// js_search — find t in sorted ascending list a using jump search.
// Block size = floor(sqrt(n)). Jumps forward until a[right] >= t or end,
// then scans linearly within the block [left, min(right, n-1)].
// Returns index of t, or -1 if not found.
fn js_search(a: any, t: int) -> int
    let n = len(a)
    if n == 0
        return -1
    let step = _js_isqrt(n)
    if step < 1
        step = 1
    let left = 0
    let right = step - 1
    // Jump forward until a[right] >= t or we've passed end of array
    while right < n and a[right] < t
        left = right + 1
        right = right + step
    // Clamp right to last valid index
    if right >= n
        right = n - 1
    // Linear scan backwards from right within block [left, right]
    let i = right
    while i >= left
        if a[i] == t
            return i
        i = i - 1
    -1

// js_contains — true iff t appears anywhere in sorted ascending list a.
fn js_contains(a: any, t: int) -> bool
    let idx = js_search(a, t)
    idx >= 0
