// std/search/rotated_search.nova — Search in a rotated sorted array of distinct integers.
// A rotated array: [4,5,6,7,0,1,2] is [0,1,2,3,4,5,6] rotated at index 4.
// All functions are pure, deterministic, and import nothing.
// Handles empty arrays, single-element arrays, and non-rotated arrays correctly.

// rs_min_index — index of the minimum element (= the rotation point).
// Uses binary search: when a[mid] > a[hi], the minimum lies in (mid, hi]; otherwise [lo, mid].
// For an unrotated (non-rotated) array the minimum is always at index 0.
fn rs_min_index(a: list) -> int
    let n = len(a)
    if n == 0
        return -1
    let lo = 0
    let hi = n - 1
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if a[mid] > a[hi]
            lo = mid + 1
        else
            hi = mid
    lo

// rs_find_min — the minimum VALUE in the rotated sorted array.
// Returns the value at rs_min_index; returns -1 for empty arrays.
fn rs_find_min(a: list) -> int
    let n = len(a)
    if n == 0
        return -1
    let idx = rs_min_index(a)
    a[idx]

// rs_search — return the index of t in the rotated sorted array, or -1 if not present.
// Classic approach: at each step determine which of [lo,mid] or [mid+1,hi] is sorted
// (by comparing endpoints), then check whether t falls in the sorted half.
// This avoids any modular arithmetic and terminates in O(log n).
fn rs_search(a: list, t: int) -> int
    let n = len(a)
    if n == 0
        return -1
    let lo = 0
    let hi = n - 1
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        if a[mid] == t
            return mid
        if a[lo] <= a[mid]
            if t >= a[lo] and t < a[mid]
                hi = mid - 1
            else
                lo = mid + 1
        else
            if t > a[mid] and t <= a[hi]
                lo = mid + 1
            else
                hi = mid - 1
    -1
