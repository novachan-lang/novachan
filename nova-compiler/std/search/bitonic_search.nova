// std/search/bitonic_search.nova — Search operations on a bitonic (unimodal) array.
//
// A bitonic array strictly increases then strictly decreases.
// The peak is the unique maximum element.
//
// Public API (prefix bt_):
//   bt_find_peak(a) -> int    index of the peak element
//   bt_max(a)       -> int    the peak value
//   bt_search(a, t) -> int    index of t, or -1 if absent
//
// All algorithms use binary search; O(log n). No imports.

// bt_find_peak — return the index of the peak (maximum) element in a bitonic
// array using binary search. Returns 0 for a single-element array.
fn bt_find_peak(a: list) -> int
    let n = len(a)
    if n == 0
        return -1
    if n == 1
        return 0
    let lo = 0
    let hi = n - 1
    while lo < hi
        let mid = lo + (hi - lo) / 2
        if a[mid] < a[mid + 1]
            lo = mid + 1
        else
            hi = mid
    return lo

// bt_max — return the maximum (peak) value of a bitonic array.
fn bt_max(a: list) -> int
    let pk = bt_find_peak(a)
    return a[pk]

// _bt_asc_search — binary search t in a[lo..hi] ascending; returns index or -1.
fn _bt_asc_search(a: list, t: int, lo: int, hi: int) -> int
    let l = lo
    let h = hi
    while l <= h
        let mid = l + (h - l) / 2
        if a[mid] == t
            return mid
        if a[mid] < t
            l = mid + 1
        else
            h = mid - 1
    return -1

// _bt_desc_search — binary search t in a[lo..hi] descending; returns index or -1.
fn _bt_desc_search(a: list, t: int, lo: int, hi: int) -> int
    let l = lo
    let h = hi
    while l <= h
        let mid = l + (h - l) / 2
        if a[mid] == t
            return mid
        if a[mid] > t
            l = mid + 1
        else
            h = mid - 1
    return -1

// bt_search — return the index of t in a bitonic array, or -1 if not found.
// Finds the peak then binary searches the ascending and descending halves.
fn bt_search(a: list, t: int) -> int
    let n = len(a)
    if n == 0
        return -1
    let pk = bt_find_peak(a)
    if a[pk] == t
        return pk
    let r1 = _bt_asc_search(a, t, 0, pk - 1)
    if r1 >= 0
        return r1
    return _bt_desc_search(a, t, pk + 1, n - 1)
