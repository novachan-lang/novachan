// std/search/binary_search.nova — Binary search over sorted ascending int lists.
// All functions are pure, deterministic, and import nothing.
// Handles empty lists and duplicates correctly; always terminates.
// mid = lo + (hi - lo) / 2 throughout to avoid overflow.

// bs_find — return any index where a[i] == t, or -1 if not present.
// Standard binary search; no guarantee on which duplicate is returned.
fn bs_find(a: list, t: int) -> int
    let lo = 0
    let hi = len(a) - 1
    let result = -1
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        if a[mid] == t
            result = mid
            lo = hi + 1
        else if a[mid] < t
            lo = mid + 1
        else
            hi = mid - 1
    result

// bs_first — return the FIRST (leftmost) index where a[i] == t, or -1 if not present.
// Uses a lower-bound search: narrows to the left while a[mid] >= t.
fn bs_first(a: list, t: int) -> int
    let n = len(a)
    if n == 0
        return -1
    let lo = 0
    let hi = n - 1
    let ans = -1
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        if a[mid] == t
            ans = mid
            hi = mid - 1
        else if a[mid] < t
            lo = mid + 1
        else
            hi = mid - 1
    ans

// bs_last — return the LAST (rightmost) index where a[i] == t, or -1 if not present.
// Uses an upper-bound search: narrows to the right while a[mid] <= t.
fn bs_last(a: list, t: int) -> int
    let n = len(a)
    if n == 0
        return -1
    let lo = 0
    let hi = n - 1
    let ans = -1
    while lo <= hi
        let mid = lo + (hi - lo) / 2
        if a[mid] == t
            ans = mid
            lo = mid + 1
        else if a[mid] < t
            lo = mid + 1
        else
            hi = mid - 1
    ans

// bs_contains — true iff t is present anywhere in sorted ascending list a.
fn bs_contains(a: list, t: int) -> bool
    bs_find(a, t) != -1
