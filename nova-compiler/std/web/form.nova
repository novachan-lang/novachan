// ============================================================================
// NOVA Standard Library — std/web/form
// ============================================================================
// HTML form data (application/x-www-form-urlencoded) builder and parser.
// A form is a plain dict — callers create one with wf_new() and pass it to
// every operation. Field insertion order is preserved so wf_encode produces
// deterministic, caller-controlled output (unlike std/net/querystring's
// qs_build, which sorts keys).
//
// Encoding/decoding is delegated entirely to std/encoding/percent's
// pct_encode_form / pct_decode_form (space <-> '+', unreserved chars pass
// through, everything else — including a literal '+' — becomes %XX) — the
// exact application/x-www-form-urlencoded rules a real HTML <form> uses. No
// encoding logic is duplicated here.
//
// Internal dict layout:
//   f["keys"] : list of string   field names, in first-insertion order
//   f["vals"] : dict             field name (string) -> value (string)
//
// Public API (prefix wf_):
//   wf_new()                 -> dict    create an empty form
//   wf_set(f, key, val)               set (or overwrite) a field's value;
//                                      first use of a new key appends it to
//                                      the key order, re-setting an existing
//                                      key updates its value IN PLACE
//                                      (order unchanged)
//   wf_get(f, key)            -> string  field value, or "" if absent
//   wf_has(f, key)            -> bool    true iff the field exists
//   wf_encode(f)              -> string  "k1=v1&k2=v2" in insertion order
//   wf_decode(encoded)        -> dict    parse "k1=v1&k2=v2" back into a form
//   wf_keys(f)                -> list    field names, in insertion order
//
// LEAF (besides percent) — imports only std/encoding/percent (also a leaf).
// ============================================================================

import std/encoding/percent

// ── private: split "key=value" on the FIRST '=' only ─────────────────────────
// Returns a 2-element list [key, value]. If no '=' is present, returns
// [s, ""] (a bare field name with an empty value, matching HTML form
// semantics for a checkbox/flag field submitted with no value).
fn _wf_split_pair(s: string) -> list
    let n = len(s)
    let found = -1
    let i = 0
    while i < n
        if char_at(s, i) == "="
            found = i
            i = n
        else
            i = i + 1
    let result = []
    if found < 0
        result.push(s)
        result.push("")
    else
        result.push(slice(s, 0, found))
        result.push(slice(s, found + 1, n))
    return result

// ── wf_new ────────────────────────────────────────────────────────────────────
// Returns a freshly initialised, empty form.
fn wf_new() -> dict
    let f = {}
    f["keys"] = []
    f["vals"] = {}
    return f

// ── wf_set ────────────────────────────────────────────────────────────────────
// Sets field key to val. The first time a key is set it is appended to the
// insertion order; setting an already-present key again only updates its
// value, leaving its position in wf_keys unchanged.
fn wf_set(f: dict, key: string, val: string)
    let vals = f["vals"]
    if not contains(vals, key)
        let keys_list = f["keys"]
        keys_list.push(key)
    vals[key] = val

// ── wf_get ────────────────────────────────────────────────────────────────────
// Returns the value of field key, or "" if the field was never set.
fn wf_get(f: dict, key: string) -> string
    let vals = f["vals"]
    if contains(vals, key)
        return vals[key]
    return ""

// ── wf_has ────────────────────────────────────────────────────────────────────
// Returns true iff field key has been set.
fn wf_has(f: dict, key: string) -> bool
    return contains(f["vals"], key)

// ── wf_encode ─────────────────────────────────────────────────────────────────
// Serializes the form to "k1=v1&k2=v2" (application/x-www-form-urlencoded),
// in field insertion order. Returns "" for an empty form.
//
// Example:
//   let f = wf_new()
//   wf_set(f, "q", "a+b c")
//   wf_set(f, "page", "2")
//   wf_encode(f) -> "q=a%2Bb+c&page=2"
fn wf_encode(f: dict) -> string
    let keys_list = f["keys"]
    let vals = f["vals"]
    let n = len(keys_list)
    let out = ""
    let i = 0
    while i < n
        let k = keys_list[i]
        let v = vals[k]
        let enc_k = pct_encode_form(k)
        let enc_v = pct_encode_form(v)
        if i == 0
            out = enc_k + "=" + enc_v
        else
            out = out + "&" + enc_k + "=" + enc_v
        i = i + 1
    return out

// ── wf_decode ─────────────────────────────────────────────────────────────────
// Parses an application/x-www-form-urlencoded string back into a form,
// preserving the order fields appear in `encoded`. A pair with no '=' is
// treated as a field with an empty value. Empty segments (from "&&" or a
// leading/trailing '&') are skipped. Returns an empty form for "".
//
// Example:
//   wf_decode("q=a%2Bb+c&page=2")
//     -> form where wf_get(_, "q") == "a+b c" and wf_get(_, "page") == "2"
fn wf_decode(encoded: string) -> dict
    let f = wf_new()
    if len(encoded) == 0
        return f
    let parts = split(encoded, "&")
    let n = len(parts)
    let i = 0
    while i < n
        let raw = parts[i]
        if len(raw) > 0
            let pair = _wf_split_pair(raw)
            let k = pct_decode_form(pair[0])
            let v = pct_decode_form(pair[1])
            wf_set(f, k, v)
        i = i + 1
    return f

// ── wf_keys ───────────────────────────────────────────────────────────────────
// Returns the list of field names, in insertion order.
fn wf_keys(f: dict) -> list
    return f["keys"]
