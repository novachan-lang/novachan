// std/gametheory/subtraction_game.nova — Sprague-Grundy analysis of subtraction games.
// A subtraction game: given a pile of n tokens and an allowed move-set (list of positive
// removals), a player picks any m in the move-set with m <= n and removes m tokens.
// Last player to move wins (normal play convention).
//
// Grundy values are computed bottom-up (iterative), avoiding exponential recursion.
//
// Public API:
//   sg_grundy(n, moves)           -> int   Grundy value of position n
//   sg_is_winning(n, moves)       -> bool  true iff Grundy(n) != 0
//   sg_grundy_seq(upto, moves)    -> list  Grundy values for 0..upto (inclusive)
//
// LEAF — imports NOTHING.

// _sg_mex_from_table — compute mex of {table[n-m] | m in moves, m<=n}.
// table is a list of Grundy values already computed for 0..n-1.
fn _sg_mex_from_table(n: int, moves, table) -> int
    // Build a presence set via a dict keyed by reachable Grundy value.
    let present = {}
    let mi = 0
    let nm = len(moves)
    while mi < nm
        let m = moves[mi]
        if m <= n
            let g = table[n - m]
            present[str(g)] = 1
        mi = mi + 1
    // Find the mex: smallest non-negative int not in present.
    let cand = 0
    while contains(present, str(cand))
        cand = cand + 1
    cand

// sg_grundy_seq — compute Grundy values for positions 0..upto (inclusive), bottom-up.
// Returns a list of length (upto+1) where result[i] = Grundy(i).
fn sg_grundy_seq(upto: int, moves) -> list
    let table = []
    let i = 0
    while i <= upto
        let g = _sg_mex_from_table(i, moves, table)
        push(table, g)
        i = i + 1
    table

// sg_grundy — Grundy value of position n for the given move-set.
// Computes the full table 0..n (bottom-up) then returns table[n].
fn sg_grundy(n: int, moves) -> int
    let table = sg_grundy_seq(n, moves)
    table[n]

// sg_is_winning — true iff position n is an N-position (Grundy value != 0).
// An N-position means the player to move has a winning strategy.
fn sg_is_winning(n: int, moves) -> bool
    let g = sg_grundy(n, moves)
    g != 0
