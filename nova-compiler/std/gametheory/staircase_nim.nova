// std/gametheory/staircase_nim.nova — Staircase Nim.
//
// Coins sit on numbered steps (0 = ground, 1, 2, ...).  On each turn a player
// moves any positive number of coins from step i (i >= 1) to step i-1.
// Coins on step 0 (ground) are out of play.  Last player to move wins.
//
// Key theorem: Staircase Nim reduces to ordinary Nim on coins at ODD-indexed steps.
//   nim_value = XOR of coins at steps 1, 3, 5, ...
//   nim_value == 0  ->  current player LOSES (P-position)
//   nim_value != 0  ->  current player WINS  (N-position)
//
// Public API:
//   stn_nim_value(steps) -> int   XOR of coin counts at odd-indexed steps
//   stn_is_winning(steps) -> bool  true iff nim_value != 0
//   stn_odd_heaps(steps) -> list   coin counts at odd-indexed steps (in order)
//
// LEAF — imports nothing.

// stn_odd_heaps — return the list of coin counts at odd-indexed steps.
fn stn_odd_heaps(steps)
    let n = len(steps)
    let result = []
    let i = 1
    while i < n
        push(result, steps[i])
        i += 2
    result

// stn_nim_value — XOR of coins at odd-indexed steps.
fn stn_nim_value(steps)
    let n = len(steps)
    let xv = 0
    let i = 1
    while i < n
        xv = xv ^ steps[i]
        i += 2
    xv

// stn_is_winning — true iff the current player has a winning strategy.
fn stn_is_winning(steps)
    stn_nim_value(steps) != 0
