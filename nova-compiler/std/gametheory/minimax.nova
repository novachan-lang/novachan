// std/gametheory/minimax.nova — minimax value of alternating MAX/MIN game trees.
// A tree node is either:
//   - an int (leaf): its value is the game score.
//   - a list of child subtrees (internal node): value = max or min over children.
// The root level determines whether the first player maximises or minimises.
// Levels strictly alternate: if root=MAX, depth-1 children are MIN, etc.
//
// Public API:
//   mm_value(tree)     -> int  root is a MAX node (maximiser moves first)
//   mm_value_min(tree) -> int  root is a MIN node (minimiser moves first)
//
// LEAF — imports NOTHING.

// _mm_eval — evaluate tree node where is_max=1 means current node is a MAX node.
// Detects leaves via type_of(node)=="int".
fn _mm_eval(node, is_max: int) -> int
    if type_of(node) == "int"
        return node
    // Internal node: iterate over children with the opposite role.
    let nc = len(node)
    let child_is_max = 1
    if is_max == 1
        child_is_max = 0
    // Initialise best value.
    let best = 0
    let first = 1
    for i in 0..nc
        let cv = _mm_eval(node[i], child_is_max)
        if first == 1
            best = cv
            first = 0
        if is_max == 1
            if cv > best
                best = cv
        if is_max == 0
            if cv < best
                best = cv
    best

// mm_value — minimax value when the root is a MAX node.
// Leaf returns its own value. Internal node returns max of children's min-values.
fn mm_value(tree) -> int
    _mm_eval(tree, 1)

// mm_value_min — minimax value when the root is a MIN node.
// Leaf returns its own value. Internal node returns min of children's max-values.
fn mm_value_min(tree) -> int
    _mm_eval(tree, 0)
