// std/quantum/quantum_gate2.nova — two-qubit gates (CNOT, CZ, SWAP, controlled-U,
// Toffoli) applied to an n-qubit state.
// Imports std/quantum/quantum_state (complex numbers + n-qubit state vectors).
//
// Representation (matches quantum_state.nova):
//   COMPLEX number = 2-element list of floats [re, im].
//   GATE MATRIX    = 2x2 complex matrix as a list of 2 rows, each a list of 2
//                    complex numbers: [[c00,c01],[c10,c11]] (same shape used
//                    by std/quantum/quantum_gate1).
//   control/target/a/b/c1/c2 are 0-based BIG-ENDIAN qubit indices (qubit 0 is
//   the most-significant bit of the basis index — see quantum_state.nova).
//
// Public API (prefix qg2_):
//   qg2_cnot(state, control, target)          -> list  flip target iff control==1
//   qg2_cz(state, control, target)             -> list  phase-flip iff control==1 and target==1
//   qg2_swap(state, a, b)                      -> list  swap qubits a and b
//   qg2_controlled(state, control, target, gate) -> list  apply 2x2 gate to target iff control==1
//   qg2_toffoli(state, c1, c2, target)         -> list  flip target iff c1==1 and c2==1

import std/quantum/quantum_state

// ── internal helpers ────────────────────────────────────────────────────────

// _qg2_copy_state — copy every amplitude of `state` into a fresh list.
fn _qg2_copy_state(state: list) -> list
    let dim = qst_dim(state)
    let out = []
    let i = 0
    while i < dim
        push(out, qst_amp(state, i))
        i += 1
    out

// _qg2_swap_pair — swap the amplitudes at basis indices i and j within `out`
// (reading the ORIGINAL amplitudes from `state`, so this is safe to call once
// per unordered pair regardless of iteration order). Mutates `out` in place
// (list is a reference) and also returns it. Shared by qg2_cnot, qg2_swap,
// and qg2_toffoli so the swap logic is written ONCE.
fn _qg2_swap_pair(state: list, out: list, i: int, j: int) -> list
    let ai = qst_amp(state, i)
    let aj = qst_amp(state, j)
    out[i] = aj
    out[j] = ai
    out

// ── two-qubit gates ─────────────────────────────────────────────────────────

// qg2_cnot — flip `target` iff `control` is 1. Iterating every basis index i
// where control==1 and target==0 visits each swapped pair exactly once (its
// partner j has target==1, so the inner condition skips it when i==j on the
// second visit).
fn qg2_cnot(state: list, control: int, target: int) -> list
    let n = qst_num_qubits(state)
    let dim = qst_dim(state)
    let out = _qg2_copy_state(state)
    for i in 0..dim
        if qst_bit(i, n, control) == 1
            if qst_bit(i, n, target) == 0
                let j = qst_flip_bit(i, n, target)
                _qg2_swap_pair(state, out, i, j)
    out

// qg2_cz — multiply the amplitude by -1 for every basis state where BOTH
// control and target bits are 1 (diagonal gate — no pairing needed).
fn qg2_cz(state: list, control: int, target: int) -> list
    let n = qst_num_qubits(state)
    let dim = qst_dim(state)
    let out = _qg2_copy_state(state)
    let i = 0
    while i < dim
        if qst_bit(i, n, control) == 1
            if qst_bit(i, n, target) == 1
                out[i] = qst_cscale(qst_amp(state, i), -1.0)
        i += 1
    out

// qg2_swap — swap qubits a and b. Iterating every basis index i where
// bit(a)==0 and bit(b)==1 visits each swapped pair exactly once (its partner
// j2 has bit(a)==1, so the inner condition skips it on the second visit).
fn qg2_swap(state: list, a: int, b: int) -> list
    let n = qst_num_qubits(state)
    let dim = qst_dim(state)
    let out = _qg2_copy_state(state)
    for i in 0..dim
        if qst_bit(i, n, a) == 0
            if qst_bit(i, n, b) == 1
                let j = qst_set_bit(i, n, a, 1)
                let j2 = qst_set_bit(j, n, b, 0)
                _qg2_swap_pair(state, out, i, j2)
    out

// qg2_controlled — apply a 2x2 `gate` matrix to `target` only on the subspace
// where `control`==1 (control==0 basis states pass through unchanged). Same
// per-pair linear combination as qg1_apply's core loop, restricted to the
// control==1 subspace.
fn qg2_controlled(state: list, control: int, target: int, gate: list) -> list
    let n = qst_num_qubits(state)
    let dim = qst_dim(state)
    let out = _qg2_copy_state(state)
    let g00 = gate[0][0]
    let g01 = gate[0][1]
    let g10 = gate[1][0]
    let g11 = gate[1][1]
    for i in 0..dim
        if qst_bit(i, n, control) == 1
            if qst_bit(i, n, target) == 0
                let j = qst_flip_bit(i, n, target)
                let a0 = qst_amp(state, i)
                let a1 = qst_amp(state, j)
                let t0 = qst_cadd(qst_cmul(g00, a0), qst_cmul(g01, a1))
                let t1 = qst_cadd(qst_cmul(g10, a0), qst_cmul(g11, a1))
                out[i] = t0
                out[j] = t1
    out

// qg2_toffoli — flip `target` iff BOTH c1 and c2 are 1. Same pairing argument
// as qg2_cnot, with an extra AND condition on the two controls.
fn qg2_toffoli(state: list, c1: int, c2: int, target: int) -> list
    let n = qst_num_qubits(state)
    let dim = qst_dim(state)
    let out = _qg2_copy_state(state)
    for i in 0..dim
        if qst_bit(i, n, c1) == 1
            if qst_bit(i, n, c2) == 1
                if qst_bit(i, n, target) == 0
                    let j = qst_flip_bit(i, n, target)
                    _qg2_swap_pair(state, out, i, j)
    out
