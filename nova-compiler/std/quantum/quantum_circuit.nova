// std/quantum/quantum_circuit.nova — circuits: ordered lists of gate ops,
// composed from already-built single- and two-qubit gate modules.
// Imports std/quantum/quantum_state, std/quantum/quantum_gate1, std/quantum/quantum_gate2.
//
// Representation (PINNED):
//   OP (1-qubit)  = list [name, q]         name in {"h","x","y","z","s","t"}
//   OP (2-qubit)  = list [name, a, b]      name in {"cnot","cz","swap"}
//   OP (3-qubit)  = list ["toffoli", c1, c2, t]
//   CIRCUIT       = list of ops, in program order.
// Op fields are stored as `any` (name is a string, qubit indices are ints) in
// one flat list per op, matching the shape used throughout std/quantum.
//
// Public API (prefix qcr_):
//   qcr_new()                     -> list  empty circuit (no ops)
//   qcr_h(circ, q)                -> list  append "h" op, mutate + return circ
//   qcr_x(circ, q)                -> list  append "x" op
//   qcr_y(circ, q)                -> list  append "y" op
//   qcr_z(circ, q)                -> list  append "z" op
//   qcr_s(circ, q)                -> list  append "s" op
//   qcr_t(circ, q)                -> list  append "t" op
//   qcr_cnot(circ, c, t)          -> list  append "cnot" op
//   qcr_cz(circ, c, t)            -> list  append "cz" op
//   qcr_swap(circ, a, b)          -> list  append "swap" op
//   qcr_toffoli(circ, c1, c2, t)  -> list  append "toffoli" op
//   qcr_run_from(circ, state)     -> list  apply every op of circ to state in order, return final state
//   qcr_run(circ, n)              -> list  qcr_run_from(circ, qst_zero(n))
//   qcr_gate_count(circ)          -> int   number of ops (len(circ))
//   qcr_qubits_of(op)             -> list  the qubit indices an op touches (1, 2, or 3 of them)
//   qcr_depth(circ)               -> int   greedy circuit depth (max over per-qubit layer counts)

import std/quantum/quantum_state
import std/quantum/quantum_gate1
import std/quantum/quantum_gate2

// ── internal helpers ────────────────────────────────────────────────────────

// _qcr_op1 — build + append a 1-qubit op [name, q] to circ. Shared by every
// 1-qubit convenience wrapper so the append shape is written ONCE.
fn _qcr_op1(circ: list, name: string, q: int) -> list
    let op = []
    push(op, name)
    push(op, q)
    push(circ, op)
    circ

// _qcr_op2 — build + append a 2-qubit op [name, a, b] to circ. Shared by
// every 2-qubit convenience wrapper.
fn _qcr_op2(circ: list, name: string, a: int, b: int) -> list
    let op = []
    push(op, name)
    push(op, a)
    push(op, b)
    push(circ, op)
    circ

// _qcr_max — larger of two ints.
fn _qcr_max(a: int, b: int) -> int
    if a > b
        return a
    b

// _qcr_time_get — read time[key] from the depth dict, defaulting to 0 when
// the qubit has not been touched yet (guarded with contains, per NOVA
// gotcha: a missing dict key otherwise reads back as int 0 anyway, but the
// guard makes the default explicit and future-proof).
fn _qcr_time_get(time: dict, key: string) -> int
    if contains(time, key)
        return time[key]
    0

// ── constructors ─────────────────────────────────────────────────────────

// qcr_new — empty circuit.
fn qcr_new() -> list
    []

// ── 1-qubit op builders ─────────────────────────────────────────────────

// qcr_h — append a Hadamard op on qubit q.
fn qcr_h(circ: list, q: int) -> list
    _qcr_op1(circ, "h", q)

// qcr_x — append a Pauli-X op on qubit q.
fn qcr_x(circ: list, q: int) -> list
    _qcr_op1(circ, "x", q)

// qcr_y — append a Pauli-Y op on qubit q.
fn qcr_y(circ: list, q: int) -> list
    _qcr_op1(circ, "y", q)

// qcr_z — append a Pauli-Z op on qubit q.
fn qcr_z(circ: list, q: int) -> list
    _qcr_op1(circ, "z", q)

// qcr_s — append an S op on qubit q.
fn qcr_s(circ: list, q: int) -> list
    _qcr_op1(circ, "s", q)

// qcr_t — append a T op on qubit q.
fn qcr_t(circ: list, q: int) -> list
    _qcr_op1(circ, "t", q)

// ── 2/3-qubit op builders ───────────────────────────────────────────────

// qcr_cnot — append a CNOT op (control c, target t).
fn qcr_cnot(circ: list, c: int, t: int) -> list
    _qcr_op2(circ, "cnot", c, t)

// qcr_cz — append a CZ op (control c, target t).
fn qcr_cz(circ: list, c: int, t: int) -> list
    _qcr_op2(circ, "cz", c, t)

// qcr_swap — append a SWAP op on qubits a and b.
fn qcr_swap(circ: list, a: int, b: int) -> list
    _qcr_op2(circ, "swap", a, b)

// qcr_toffoli — append a Toffoli op (controls c1,c2, target t).
fn qcr_toffoli(circ: list, c1: int, c2: int, t: int) -> list
    let op = []
    push(op, "toffoli")
    push(op, c1)
    push(op, c2)
    push(op, t)
    push(circ, op)
    circ

// ── execution ────────────────────────────────────────────────────────────

// qcr_run_from — apply every op of circ, in order, to `state`, threading the
// returned state through each step. This is the single shared dispatch used
// by qcr_run — written ONCE here, never duplicated.
fn qcr_run_from(circ: list, state: list) -> list
    let cur = state
    let n = len(circ)
    for i in 0..n
        let op = circ[i]
        let name = op[0]
        if name == "h"
            cur = qg1_apply_h(cur, op[1])
        else if name == "x"
            cur = qg1_apply_x(cur, op[1])
        else if name == "y"
            cur = qg1_apply_y(cur, op[1])
        else if name == "z"
            cur = qg1_apply_z(cur, op[1])
        else if name == "s"
            cur = qg1_apply_s(cur, op[1])
        else if name == "t"
            cur = qg1_apply_t(cur, op[1])
        else if name == "cnot"
            cur = qg2_cnot(cur, op[1], op[2])
        else if name == "cz"
            cur = qg2_cz(cur, op[1], op[2])
        else if name == "swap"
            cur = qg2_swap(cur, op[1], op[2])
        else if name == "toffoli"
            cur = qg2_toffoli(cur, op[1], op[2], op[3])
    cur

// qcr_run — run circ starting from the n-qubit |0...0> state.
fn qcr_run(circ: list, n: int) -> list
    qcr_run_from(circ, qst_zero(n))

// ── introspection ────────────────────────────────────────────────────────

// qcr_gate_count — number of ops in the circuit.
fn qcr_gate_count(circ: list) -> int
    len(circ)

// qcr_qubits_of — the list of qubit indices op touches (1 for a 1-qubit op,
// 2 for a 2-qubit op, 3 for toffoli). Dispatches on op[0] the same way
// qcr_run_from does, so op shape stays in one place conceptually.
fn qcr_qubits_of(op: list) -> list
    let name = op[0]
    let qs = []
    if name == "cnot"
        push(qs, op[1])
        push(qs, op[2])
    else if name == "cz"
        push(qs, op[1])
        push(qs, op[2])
    else if name == "swap"
        push(qs, op[1])
        push(qs, op[2])
    else if name == "toffoli"
        push(qs, op[1])
        push(qs, op[2])
        push(qs, op[3])
    else
        push(qs, op[1])
    qs

// qcr_depth — greedy circuit depth. Keeps a per-qubit "time" dict keyed by
// str(q). For each op, layer = 1 + max(time[q]) over the op's qubits; every
// touched qubit's time is then set to that layer. Returns the max layer seen
// (0 for an empty circuit).
fn qcr_depth(circ: list) -> int
    let time = {}
    let n = len(circ)
    let best = 0
    for i in 0..n
        let op = circ[i]
        let qs = qcr_qubits_of(op)
        let m = len(qs)
        let latest = 0
        let j = 0
        while j < m
            let key = str(qs[j])
            let t = _qcr_time_get(time, key)
            latest = _qcr_max(latest, t)
            j = j + 1
        let layer = latest + 1
        let j2 = 0
        while j2 < m
            let key2 = str(qs[j2])
            time[key2] = layer
            j2 = j2 + 1
        best = _qcr_max(best, layer)
    best
