// std/quantum/quantum_bloch.nova — Bloch-sphere coordinates of a single qubit.
// Imports std/quantum/quantum_qubit only — owns its own tiny complex algebra
// (re/im component math, inlined) rather than importing quantum_state, matching
// quantum_qubit's own "leaf" design so Bloch-sphere geometry stays independent
// of the general n-qubit state-vector module.
//
// Representation (matches quantum_qubit.nova): a QUBIT q = [amp0, amp1], each
// amp a 2-element list of floats [re, im].
//
// Public API (prefix qbl_):
//   qbl_x_x1000(q)            -> int   Bloch x = 2*Re(conj(amp0)*amp1), x1000
//   qbl_y_x1000(q)            -> int   Bloch y = 2*Im(conj(amp0)*amp1), x1000
//   qbl_z_x1000(q)            -> int   Bloch z = |amp0|^2 - |amp1|^2, x1000
//   qbl_from_angles(theta,phi) -> list  cos(theta/2)|0> + e^{i phi} sin(theta/2)|1>
//   qbl_purity_x1000(q)       -> int   round((x^2+y^2+z^2)*1000); 1000 for any pure qubit
//   qbl_theta_x1000(q)        -> int   polar angle theta = acos(z) (radians), x1000
//
// Trig-derived values (qbl_theta_x1000, qbl_from_angles round trips) may be
// off by up to 2 (x1000 units) from libm rounding — documented tolerance.

import std/quantum/quantum_qubit

// ── internal helpers ────────────────────────────────────────────────────────

// _qbl_round1000 — round x*1000 to the nearest int, handling negative x correctly.
fn _qbl_round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

// _qbl_clamp1 — clamp x into [-1,1], guarding acos() against domain errors
// caused by float rounding drift (e.g. a normalized z landing at 1.0000000002).
fn _qbl_clamp1(x: float) -> float
    if x > 1.0
        return 1.0
    if x < (0.0 - 1.0)
        return 0.0 - 1.0
    x

// _qbl_x / _qbl_y / _qbl_z — shared Bloch-vector component computation, used
// by every qbl_*_x1000 accessor below plus qbl_purity_x1000/qbl_theta_x1000
// (extracted once so no float formula is ever copy-pasted).
fn _qbl_x(q: list) -> float
    let a0 = qbt_amp0(q)
    let a1 = qbt_amp1(q)
    let t1 = a0[0] * a1[0]
    let t2 = a0[1] * a1[1]
    let s = t1 + t2
    2.0 * s

fn _qbl_y(q: list) -> float
    let a0 = qbt_amp0(q)
    let a1 = qbt_amp1(q)
    let t1 = a0[0] * a1[1]
    let t2 = a0[1] * a1[0]
    let d = t1 - t2
    2.0 * d

fn _qbl_z(q: list) -> float
    let p0 = qbt_prob0(q)
    let p1 = qbt_prob1(q)
    p0 - p1

// ── Bloch vector components ─────────────────────────────────────────────────

// qbl_x_x1000 — Bloch x-coordinate, x1000.
fn qbl_x_x1000(q: list) -> int
    let x = _qbl_x(q)
    _qbl_round1000(x)

// qbl_y_x1000 — Bloch y-coordinate, x1000.
fn qbl_y_x1000(q: list) -> int
    let y = _qbl_y(q)
    _qbl_round1000(y)

// qbl_z_x1000 — Bloch z-coordinate, x1000.
fn qbl_z_x1000(q: list) -> int
    let z = _qbl_z(q)
    _qbl_round1000(z)

// ── construction from angles ─────────────────────────────────────────────────

// qbl_from_angles — qubit at polar angle theta, azimuth phi:
// |psi> = cos(theta/2)|0> + e^{i phi} sin(theta/2)|1>.
fn qbl_from_angles(theta: float, phi: float) -> list
    let half = theta / 2.0
    let c_half = cos(half)
    let s_half = sin(half)
    let cphi = cos(phi)
    let sphi = sin(phi)
    let a1re = cphi * s_half
    let a1im = sphi * s_half
    qbt_make(c_half, 0.0, a1re, a1im)

// ── derived scalars ───────────────────────────────────────────────────────────

// qbl_purity_x1000 — round((x^2+y^2+z^2)*1000). A pure single qubit always
// sits on the unit sphere, so this is 1000 for any (normalized) input qubit.
fn qbl_purity_x1000(q: list) -> int
    let x = _qbl_x(q)
    let y = _qbl_y(q)
    let z = _qbl_z(q)
    let x2 = x * x
    let y2 = y * y
    let z2 = z * z
    let sum2 = x2 + y2 + z2
    _qbl_round1000(sum2)

// qbl_theta_x1000 — polar angle theta = acos(z), in radians, x1000.
fn qbl_theta_x1000(q: list) -> int
    let z = _qbl_z(q)
    let zc = _qbl_clamp1(z)
    let theta = acos(zc)
    _qbl_round1000(theta)
