// std/quantum/quantum_entangle.nova — standard entangled states (Bell/GHZ/W) + probes.
// FOUNDATION-ONLY: imports quantum_state and builds amplitudes DIRECTLY (qst_zero +
// qst_set_amp). Does NOT import any gate module — entangling gates (CNOT/H) are not
// used here; the target states are constructed by their known closed-form amplitudes.
//
// Representation (matches quantum_state.nova — PINNED across std/quantum):
//   COMPLEX number  = 2-element list of floats [re, im].
//   n-QUBIT STATE   = flat list of 2^n complex amplitudes, BIG-ENDIAN (qubit 0 = MSB).
//     |b0 b1 ... b(n-1)> has basis index b0*2^(n-1) + b1*2^(n-2) + ... + b(n-1)*2^0.
//
// Public API (prefix qen_):
//   qen_bell_phi_plus()          -> list   2-qubit (|00>+|11>)/sqrt(2)
//   qen_bell_phi_minus()         -> list   2-qubit (|00>-|11>)/sqrt(2)
//   qen_bell_psi_plus()          -> list   2-qubit (|01>+|10>)/sqrt(2)
//   qen_bell_psi_minus()         -> list   2-qubit (|01>-|10>)/sqrt(2)
//   qen_ghz(n)                   -> list   n-qubit GHZ (|0...0>+|1...1>)/sqrt(2)
//   qen_w(n)                     -> list   n-qubit W state: uniform superposition over
//                                           every basis state with exactly one bit set,
//                                           each amplitude 1/sqrt(n)
//   qen_is_product_2q(state)     -> int    1 if a 2-qubit state is a PRODUCT (separable)
//                                           state, 0 if entangled
//   qen_concurrence_x1000(state) -> int    round(concurrence*1000) for a 2-qubit pure
//                                           state (Bell states -> 1000, product -> 0)

import std/quantum/quantum_state

// ── internal helpers ────────────────────────────────────────────────────────

// _qen_pow2 — 2^k for k >= 0, via a while loop.
fn _qen_pow2(k: int) -> int
    let r = 1
    for i in 0..k
        r = r * 2
    r

// _qen_round1000 — round x*1000 to the nearest int, handling negative x correctly.
fn _qen_round1000(x: float) -> int
    if x < 0.0
        let neg = 0.0 - x
        let scaled = neg * 1000.0 + 0.5
        let r = float_to_int(scaled)
        return 0 - r
    let scaled = x * 1000.0 + 0.5
    float_to_int(scaled)

// _qen_inv_sqrt2 — 1/sqrt(2), shared by the four Bell-state constructors and GHZ.
fn _qen_inv_sqrt2() -> float
    let two = 2.0
    let s = sqrt(two)
    let r = 1.0 / s
    r

// _qen_two_amp — build an n-qubit state with amp[i]=ai and amp[j]=aj (real, im=0),
// every other amplitude 0. Shared by the four Bell constructors and qen_ghz, which
// differ only in WHICH two basis indices are nonzero and their signs (anti-duplication:
// avoids repeating the same zero+set+set construction four separate times).
fn _qen_two_amp(n: int, i: int, ai: float, j: int, aj: float) -> list
    let s = qst_zero(n)
    qst_set_amp(s, 0, qst_c(0.0, 0.0))
    qst_set_amp(s, i, qst_c(ai, 0.0))
    qst_set_amp(s, j, qst_c(aj, 0.0))
    s

// _qen_det2x2 — determinant of the 2x2 amplitude matrix of a 2-qubit state
// [[a00,a01],[a10,a11]]: det = a00*a11 - a01*a10 (complex). Shared by
// qen_is_product_2q and qen_concurrence_x1000 (anti-duplication: both need the same
// four-amplitude readout + determinant).
fn _qen_det2x2(state: list) -> list
    let a00 = qst_amp(state, 0)
    let a01 = qst_amp(state, 1)
    let a10 = qst_amp(state, 2)
    let a11 = qst_amp(state, 3)
    let t1 = qst_cmul(a00, a11)
    let t2 = qst_cmul(a01, a10)
    qst_csub(t1, t2)

// ── Bell states ──────────────────────────────────────────────────────────────

// qen_bell_phi_plus — (|00>+|11>)/sqrt(2).
fn qen_bell_phi_plus() -> list
    let inv = _qen_inv_sqrt2()
    _qen_two_amp(2, 0, inv, 3, inv)

// qen_bell_phi_minus — (|00>-|11>)/sqrt(2).
fn qen_bell_phi_minus() -> list
    let inv = _qen_inv_sqrt2()
    let neg = 0.0 - inv
    _qen_two_amp(2, 0, inv, 3, neg)

// qen_bell_psi_plus — (|01>+|10>)/sqrt(2).
fn qen_bell_psi_plus() -> list
    let inv = _qen_inv_sqrt2()
    _qen_two_amp(2, 1, inv, 2, inv)

// qen_bell_psi_minus — (|01>-|10>)/sqrt(2).
fn qen_bell_psi_minus() -> list
    let inv = _qen_inv_sqrt2()
    let neg = 0.0 - inv
    _qen_two_amp(2, 1, inv, 2, neg)

// ── multi-qubit entangled states ───────────────────────────────────────────

// qen_ghz — n-qubit GHZ state (|0...0>+|1...1>)/sqrt(2): amp[0]=amp[2^n-1]=1/sqrt(2).
fn qen_ghz(n: int) -> list
    let dim = _qen_pow2(n)
    let inv = _qen_inv_sqrt2()
    _qen_two_amp(n, 0, inv, dim - 1, inv)

// qen_w — n-qubit W state: uniform superposition over the n basis states with
// exactly one bit set (2^(n-1), 2^(n-2), ..., 2^0), each amplitude 1/sqrt(n).
fn qen_w(n: int) -> list
    let s = qst_zero(n)
    qst_set_amp(s, 0, qst_c(0.0, 0.0))
    let nf = n * 1.0
    let amp = 1.0 / sqrt(nf)
    for q in 0..n
        let shift = n - 1 - q
        let place = _qen_pow2(shift)
        qst_set_amp(s, place, qst_c(amp, 0.0))
    s

// ── entanglement probes ─────────────────────────────────────────────────────

// qen_is_product_2q — 1 if the 2-qubit state [a00,a01,a10,a11] is a PRODUCT
// (separable) state (det of the amplitude matrix == 0, within tolerance), else 0.
fn qen_is_product_2q(state: list) -> int
    let det = _qen_det2x2(state)
    let mag2 = qst_cabs2(det)
    let r = _qen_round1000(mag2)
    if r == 0
        return 1
    0

// qen_concurrence_x1000 — concurrence C = 2*|a00*a11 - a01*a10| for a 2-qubit pure
// state, returned as round(C*1000). Bell states -> 1000 (maximally entangled);
// product states -> 0.
fn qen_concurrence_x1000(state: list) -> int
    let det = _qen_det2x2(state)
    let mag2 = qst_cabs2(det)
    let mag = sqrt(mag2)
    let c = 2.0 * mag
    _qen_round1000(c)
