// ============================================================================
// NOVA Standard Library — std/data/properties
// ============================================================================
// Java .properties file parser and writer (java.util.Properties#load /
// #store text format, plain-key-value form — no XML variant).
//
// FORMAT SUPPORTED:
//   - Separators: 'key=value', 'key:value', and 'key value' (whitespace-only
//     separator — the FIRST unescaped '=', ':', or run of whitespace after
//     the key ends the key; at most one '=' or ':' is then consumed as the
//     explicit separator, with surrounding whitespace skipped).
//   - Comments: a line whose first non-whitespace character is '#' or '!'
//     runs to end of line and is ignored. Comment lines are NOT eligible
//     for continuation-joining (checked before continuation processing).
//   - Blank lines (empty after trimming leading whitespace) are ignored.
//   - Line continuation: a natural (physical) line ending in an ODD number
//     of trailing backslashes continues onto the next physical line — the
//     final backslash is the continuation marker (dropped), and the next
//     line's LEADING whitespace (space/tab/formfeed) is trimmed before it
//     is appended. Joining repeats until a physical line has an EVEN
//     trailing-backslash count (0 included) or input runs out.
//   - Escapes recognized in both key and value: \n \t \r \f \\ \= \: \(sp)
//     and \uXXXX (exactly 4 hex digits -> one UTF-8-encoded BMP code
//     point). Any other \X decodes to the literal character X (matches
//     java.util.Properties, which silently drops the backslash).
//   - Leading whitespace of the FIRST physical line of a logical line is
//     trimmed before key parsing begins (so indented "  key=val" parses
//     the same as "key=val"); trailing whitespace of a value is NEVER
//     trimmed — it is significant and preserved verbatim.
//
// PUBLIC API:
//   props_parse(text: string) -> dict
//     Parse .properties text into a string->string dict. Last key wins on
//     duplicate keys (matches java.util.Properties / LinkedHashMap#put).
//
//   props_write(d: dict) -> string
//     Serialize a dict back to .properties text, one 'key=value' line per
//     entry (LF-terminated), escaping whatever is necessary so that
//     props_parse(props_write(d)) == d for every string key/value NovA can
//     represent (see ESCAPING RULES below).
//
// ESCAPING RULES (props_write) — the minimum needed for a lossless
// round-trip through props_parse, not a byte-for-byte mirror of any other
// implementation's output:
//   KEY   : \\ \n \r \t \f are backslash-escaped; every space is escaped
//           as "\ " (any unescaped space would end the key early); '='
//           and ':' are escaped (would truncate the key as a separator);
//           if the key's FIRST character is '#' or '!' it is escaped so
//           the emitted line is not mistaken for a comment on re-parse.
//   VALUE : \\ \n \r \t \f are backslash-escaped; ONLY the value's very
//           first character, if it is a space/tab/formfeed, is escaped
//           (props_parse eats a run of separator whitespace immediately
//           after the key — escaping just the first byte breaks that run
//           so the rest of the leading run, and all interior/trailing
//           whitespace, survives untouched; nothing else in the value
//           needs escaping since props_parse copies the remainder of the
//           line verbatim once past the separator).
//   \uXXXX is never emitted by props_write — raw UTF-8 bytes for
//   non-ASCII values round-trip fine because props_parse only treats a
//   literal backslash specially; any byte >= 0x80 is passed through
//   unchanged in both directions.
//
// KNOWN LIMITATION: a code-point-U+0000 escape (or any path that decodes to
// byte value zero) embeds a NUL into the result string, which NOVA's
// C-string-backed string operations (len/slice/etc. on non-fat strings)
// may truncate at -- a pre-existing NOVA string limitation, not specific
// to this module. Real .properties files essentially never contain that.
//
// IMPLEMENTATION NOTES — NOVA GOTCHAS:
//   - All scans are byte-indexed (str_to_bytes/bytes_get, O(1) random
//     access) and accumulate output via buffer()/buf_append* (O(1)
//     amortized append) — NEVER char_at() in a loop or `s = s + c` string
//     concatenation. char_at indexes by Unicode CODEPOINT and rescans the
//     string from byte 0 on EVERY call (O(index) per call), so a
//     `while i < n: char_at(s, i)` loop is O(n^2) overall; and
//     nova_rt_str_concat is O(la+lb) with no amortized headroom, so
//     `s = s + c` per character is also O(n^2). See AUDIT NOTE below.
//
// AUDIT NOTE (text-parser soundness audit — same bug class as
// std/data/ini.nova's audit): this module previously scanned every line
// with char_at(line, i)/i=i+1 and built key/value/comment-escape strings
// via `key = key + c`. Two real bugs followed from that:
//   (a) PATHOLOGICAL BLOWUP — char_at's O(index)-per-call rescan makes any
//       such loop O(n^2); _propsd_split_lines' loop spans the WHOLE FILE
//       TEXT (not per-line), so parsing an ordinary multi-hundred-KB
//       properties file was already unacceptably slow, and a larger file
//       effectively hangs. The continuation-join loop in props_parse
//       additionally accumulated the logical-line text via `cur = cur +
//       nxt` per physical line, which is also O(n^2) for a file built
//       mostly of continuation lines (a realistic construction: many
//       physical lines each ending in a single backslash). Fixed by
//       switching every scan to str_to_bytes/bytes_get and every
//       accumulation to buffer()/buf_append_char/buf_to_str; the
//       continuation join now tracks a pending-backslash-run COUNT
//       incrementally (never rescans or re-concatenates the growing
//       logical line) so the whole parse is O(total input length).
//   (b) SILENT UTF-8 CORRUPTION — char_at indexes by codepoint while
//       len()/slice() index/operate by raw BYTE offset. This module mixed
//       the two throughout (e.g. _propsd_parse_kv used a byte-length loop
//       bound `n = len(line)` together with a codepoint-indexed
//       char_at(line, i), and _propsd_decode_escape's "unrecognized
//       escape" path read one FULL codepoint via char_at while the caller
//       advanced its index as if it were a byte count). For properties
//       text containing multi-byte UTF-8 (this module's own docs say raw
//       UTF-8 bytes >= 0x80 round-trip via pass-through, so real callers
//       DO feed it non-ASCII values/keys/comments), any multi-byte
//       character earlier in the line desynced every char_at call after
//       it from the byte offsets slice()/len() use, silently
//       misplacing/corrupting the key/value split. The byte-based rewrite
//       uses ONE consistent index space (bytes) throughout, matching
//       slice()'s semantics exactly, which eliminates this corruption as
//       a side effect of the same fix.
//   Neither bug required Class-1 recursion (this format is flat/line-based,
//   not recursive-descent) nor changed any function's public signature.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers — whitespace / hex ─────────────────────────────────────

// _propsd_is_ws: true for space (32), tab (9), or form feed (12) — the three
// whitespace bytes java.util.Properties treats as key/value separators.
fn _propsd_is_ws(b) -> int
    if b == 32 or b == 9 or b == 12
        return 1
    return 0

// _propsd_ltrim: strip leading space/tab/formfeed from s. Byte-indexed
// (str_to_bytes/bytes_get, O(1) random access) so this is O(n) even on
// adversarially long input, and its result offset is a byte offset —
// consistent with slice()'s byte-offset semantics (see AUDIT NOTE above).
fn _propsd_ltrim(s) -> string
    let bts = str_to_bytes(s)
    let n = bytes_len(bts)
    let i = 0
    while i < n and _propsd_is_ws(bytes_get(bts, i)) == 1
        i = i + 1
    if i == 0
        return s
    slice(s, i, n)

// _propsd_hex_val: hex digit value of a raw BYTE b, or -1 if not a hex
// digit. Takes a byte value directly (not a character) — see AUDIT NOTE.
fn _propsd_hex_val(b) -> int
    if b >= 48 and b <= 57
        return b - 48
    if b >= 97 and b <= 102
        return b - 97 + 10
    if b >= 65 and b <= 70
        return b - 65 + 10
    -1

// _propsd_cp_to_utf8: encode a Unicode code point (0..0xFFFF — the full
// range a 4-hex-digit \uXXXX escape can express) as UTF-8 bytes packed
// into a NOVA string via chr() (one raw byte per chr() call, matching this
// codebase's established convention — see std/data/asn1_string.nova).
fn _propsd_cp_to_utf8(cp) -> string
    let c = cp
    if c < 0
        c = 0
    if c <= 127
        return chr(c)
    if c <= 2047
        let b0 = 192 + c / 64
        let b1 = 128 + c % 64
        return chr(b0) + chr(b1)
    // 2048..65535 -> 3-byte form
    let b0 = 224 + c / 4096
    let b1 = 128 + (c / 64) % 64
    let b2 = 128 + c % 64
    chr(b0) + chr(b1) + chr(b2)

// _propsd_split_lines: split text into physical lines on LF/CRLF/CR, same
// convention as std/data/ini.nova's _ini_split_lines. Returned lines do
// NOT include the terminator. Single top-level loop over the WHOLE file
// text, no recursion; byte-indexed (str_to_bytes/bytes_get) and
// accumulates each line in a buffer() (O(1)-amortized append), so this is
// O(n) total regardless of file size or line count — this was the
// module's worst offender pre-fix (see AUDIT NOTE above). Copying
// individual raw bytes (rather than char_at's decoded codepoints) still
// reconstructs multi-byte UTF-8 sequences byte-for-byte, because none of
// LF(10)/CR(13) can appear as a UTF-8 continuation or lead byte (those are
// always >= 0x80).
fn _propsd_split_lines(text) -> list
    let lines = []
    let bts = str_to_bytes(text)
    let n = bytes_len(bts)
    let i = 0
    let cur = buffer()
    while i < n
        let b = bytes_get(bts, i)
        if b == 10
            lines.push(buf_to_str(cur))
            cur = buffer()
        else if b == 13
            lines.push(buf_to_str(cur))
            cur = buffer()
            if i + 1 < n and bytes_get(bts, i + 1) == 10
                i = i + 1
        else
            buf_append_char(cur, b)
        i = i + 1
    if buf_len(cur) > 0
        lines.push(buf_to_str(cur))
    lines

// _propsd_trailing_backslashes_bytes: count consecutive '\' (92) bytes at
// the end of an ALREADY-CONVERTED byte array (bts, length n). Used to
// detect line continuation (odd count = continues). Takes the byte array
// directly (rather than converting a string internally) so callers that
// already hold the bytes for other purposes avoid a redundant O(n)
// str_to_bytes conversion.
fn _propsd_trailing_backslashes_bytes(bts, n) -> int
    let i = n - 1
    let count = 0
    while i >= 0 and bytes_get(bts, i) == 92
        count = count + 1
        i = i - 1
    count

// _propsd_decode_escape: decode ONE escape sequence in the byte array
// `bts` (length n) whose backslash is at index (pos - 1); `pos` is the
// index of the byte immediately following that backslash. Returns
// [decoded: string, consumed: int] where `consumed` is how many BYTES
// after the backslash were consumed (the caller advances i by 1 +
// consumed) — byte-indexed throughout, matching bts's index space (see
// AUDIT NOTE above: the prior char_at-based version consumed CODEPOINTS
// while the caller's index tracked bytes, desyncing on multi-byte input).
//
// Boundary case: pos >= n means the backslash was the very last byte of
// the line with nothing following (can only happen for an EVEN trailing-
// backslash tail, since odd tails are already absorbed by continuation-
// joining) — treated defensively as a literal backslash.
fn _propsd_decode_escape(bts, n, pos) -> any
    if pos >= n
        return ["\\", 0]
    let b = bytes_get(bts, pos)
    if b == 110
        return [chr(10), 1]
    if b == 116
        return [chr(9), 1]
    if b == 114
        return [chr(13), 1]
    if b == 102
        return [chr(12), 1]
    if b == 92
        return [chr(92), 1]
    if b == 61
        return ["=", 1]
    if b == 58
        return [":", 1]
    if b == 32
        return [" ", 1]
    if b == 117
        // \uXXXX — consume up to 4 valid hex digits (defensive: fewer is
        // accepted rather than crashing, per NOVA edge-case policy).
        let cp = 0
        let j = pos + 1
        let cnt = 0
        while cnt < 4 and j < n and _propsd_hex_val(bytes_get(bts, j)) >= 0
            cp = cp * 16 + _propsd_hex_val(bytes_get(bts, j))
            j = j + 1
            cnt = cnt + 1
        [_propsd_cp_to_utf8(cp), 1 + cnt]
    else
        // unrecognized escape -> literal BYTE, backslash dropped (matches
        // java.util.Properties behavior). Decoding one raw byte at a time
        // (rather than one codepoint) still reproduces multi-byte UTF-8
        // content byte-for-byte: the remaining continuation byte(s) of a
        // multi-byte sequence are >= 0x80, never match '\' (92) in the
        // caller's main scan loop, and are copied through literally.
        [chr(b), 1]

// _propsd_parse_kv: parse ONE fully-joined logical line (leading
// whitespace of its first physical line already trimmed by the caller,
// comment/blank already ruled out) into [key: string, value: string].
// Byte-indexed throughout (str_to_bytes once up front, bytes_get for
// every scan step) and accumulates key/value via buffer() rather than
// per-character string concatenation — O(n) total, see AUDIT NOTE above.
//
// Algorithm (mirrors java.util.Properties#loadConvert / LineReader):
//   Phase 1 — scan the key, decoding escapes as we go; an UNESCAPED
//             whitespace byte or an UNESCAPED '=' / ':' ends the key
//             (the ending byte itself is NOT consumed here).
//   Phase 2 — skip any run of whitespace immediately after the key.
//   Phase 3 — skip at most ONE '=' or ':' separator, then skip any run
//             of whitespace after it.
//   Phase 4 — the rest of the line is the value, decoded for escapes;
//             nothing is trimmed (trailing/interior whitespace in a
//             value is significant and preserved verbatim).
fn _propsd_parse_kv(line) -> any
    let bts = str_to_bytes(line)
    let n = bytes_len(bts)
    let i = 0
    let keybuf = buffer()
    let key_ended = 0
    while i < n and key_ended == 0
        let b = bytes_get(bts, i)
        if b == 92
            let dec = _propsd_decode_escape(bts, n, i + 1)
            buf_append(keybuf, dec[0])
            i = i + 1 + dec[1]
        else if _propsd_is_ws(b) == 1
            key_ended = 1
        else if b == 61 or b == 58
            key_ended = 1
        else
            buf_append_char(keybuf, b)
            i = i + 1
    // Phase 2: skip whitespace after the key.
    while i < n and _propsd_is_ws(bytes_get(bts, i)) == 1
        i = i + 1
    // Phase 3: skip one explicit separator, then whitespace after it.
    if i < n
        let sb = bytes_get(bts, i)
        if sb == 61 or sb == 58
            i = i + 1
            while i < n and _propsd_is_ws(bytes_get(bts, i)) == 1
                i = i + 1
    // Phase 4: the remainder is the value, with escapes decoded.
    let valbuf = buffer()
    while i < n
        let b = bytes_get(bts, i)
        if b == 92
            let dec = _propsd_decode_escape(bts, n, i + 1)
            buf_append(valbuf, dec[0])
            i = i + 1 + dec[1]
        else
            buf_append_char(valbuf, b)
            i = i + 1
    [buf_to_str(keybuf), buf_to_str(valbuf)]

// ── Public API ───────────────────────────────────────────────────────────

// props_parse: parse Java .properties text into a string->string dict.
fn props_parse(text) -> dict
    let result = {}
    let phys = _propsd_split_lines(text)
    let n = len(phys)
    let i = 0
    while i < n
        let raw = phys[i]
        i = i + 1
        let trimmed = _propsd_ltrim(raw)
        if len(trimmed) == 0
            // blank line -> skip
        else
            let tbts0 = str_to_bytes(trimmed)
            let fc = bytes_get(tbts0, 0)
            if fc == 35 or fc == 33
                // '#' or '!' -> comment line, skip (never continuation-joined)
            else
                // Begin a logical line — join continuations. Byte-indexed
                // and O(total logical-line length): rather than
                // repeatedly re-concatenating the growing accumulated
                // string and re-scanning it for a trailing-backslash
                // count (both O(n^2) — see AUDIT NOTE at top of file),
                // this tracks `pending_bs`, the length of the trailing
                // backslash run not yet committed to curbuf, purely as an
                // integer counter carried across physical lines. Each
                // physical line's own trailing-backslash count is
                // computed once (O(that line's length)); a continuation
                // marker is "dropped" by decrementing pending_bs rather
                // than slicing a string. This is byte-for-byte equivalent
                // to the original cur = cur[:-1] + ltrim(next) algorithm,
                // including the (rare) case of a physical line consisting
                // entirely of backslash bytes, which correctly carries
                // pending_bs forward instead of resetting it.
                let curbuf = buffer()
                let line = trimmed
                let pending_bs = 0
                let more = 1
                while more == 1
                    let lbts = str_to_bytes(line)
                    let llen = bytes_len(lbts)
                    let own_tb = _propsd_trailing_backslashes_bytes(lbts, llen)
                    if own_tb < llen
                        // A non-backslash byte precedes this line's
                        // trailing run, so any earlier carry has ended —
                        // flush it as literal backslash bytes first.
                        let fk = 0
                        while fk < pending_bs
                            buf_append_char(curbuf, 92)
                            fk = fk + 1
                        buf_append(curbuf, slice(line, 0, llen - own_tb))
                        pending_bs = own_tb
                    else
                        // Entire line is backslash bytes (or empty) —
                        // extend the carry, nothing to flush yet.
                        pending_bs = pending_bs + llen
                    if pending_bs % 2 == 1 and i < n
                        // Odd trailing run and more input available: the
                        // last backslash is a continuation marker — drop
                        // it (never flushed) and join the next line.
                        pending_bs = pending_bs - 1
                        line = _propsd_ltrim(phys[i])
                        i = i + 1
                    else
                        more = 0
                // Flush whatever backslash run remains (even count, or
                // input ran out with an unresolved odd tail — matches the
                // original's "raw trailing backslash left as literal"
                // defensive behavior, see _propsd_decode_escape above).
                let fk2 = 0
                while fk2 < pending_bs
                    buf_append_char(curbuf, 92)
                    fk2 = fk2 + 1
                let cur = buf_to_str(curbuf)
                let kv = _propsd_parse_kv(cur)
                result[kv[0]] = kv[1]
    result

// _propsw_escape_value: escape a value string for lossless round-tripping
// through props_parse — see ESCAPING RULES in the module header.
// Byte-indexed and buffer-accumulated — O(n), see AUDIT NOTE above.
fn _propsw_escape_value(v) -> string
    let bts = str_to_bytes(v)
    let n = bytes_len(bts)
    let out = buffer()
    let i = 0
    while i < n
        let b = bytes_get(bts, i)
        if i == 0 and _propsd_is_ws(b) == 1
            if b == 32
                buf_append(out, "\\ ")
            else if b == 9
                buf_append(out, "\\t")
            else
                buf_append(out, "\\f")
        else if b == 92
            buf_append(out, "\\\\")
        else if b == 10
            buf_append(out, "\\n")
        else if b == 13
            buf_append(out, "\\r")
        else if b == 9
            buf_append(out, "\\t")
        else if b == 12
            buf_append(out, "\\f")
        else
            buf_append_char(out, b)
        i = i + 1
    buf_to_str(out)

// _propsw_escape_key: escape a key string for lossless round-tripping
// through props_parse — see ESCAPING RULES in the module header.
// Byte-indexed and buffer-accumulated — O(n), see AUDIT NOTE above.
fn _propsw_escape_key(k) -> string
    let bts = str_to_bytes(k)
    let n = bytes_len(bts)
    let out = buffer()
    let i = 0
    while i < n
        let b = bytes_get(bts, i)
        if i == 0 and (b == 35 or b == 33)
            buf_append_char(out, 92)
            buf_append_char(out, b)
        else if b == 92
            buf_append(out, "\\\\")
        else if b == 32
            buf_append(out, "\\ ")
        else if b == 61
            buf_append(out, "\\=")
        else if b == 58
            buf_append(out, "\\:")
        else if b == 10
            buf_append(out, "\\n")
        else if b == 13
            buf_append(out, "\\r")
        else if b == 9
            buf_append(out, "\\t")
        else if b == 12
            buf_append(out, "\\f")
        else
            buf_append_char(out, b)
        i = i + 1
    buf_to_str(out)

// props_write: serialize a string->string dict into .properties text —
// one "key=value\n" line per entry. props_parse(props_write(d)) == d for
// every key/value NOVA strings can hold (modulo the documented U+0000
// limitation). Buffer-accumulated (O(total output) rather than
// O(entry-count^2) via repeated `out = out + ...` — see AUDIT NOTE above).
fn props_write(d) -> string
    let nl = chr(10)
    let out = buffer()
    let ks = keys(d)
    let n = len(ks)
    let i = 0
    while i < n
        let k = ks[i]
        let v = d[k]
        buf_append(out, _propsw_escape_key(k))
        buf_append(out, "=")
        buf_append(out, _propsw_escape_value(v))
        buf_append(out, nl)
        i = i + 1
    buf_to_str(out)
