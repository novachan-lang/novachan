// ============================================================================
// NOVA Standard Library — std/data/fixedwidth
// ============================================================================
// Fixed-width columnar text parser and formatter.
//
// PUBLIC API:
//   fxw_parse(line, widths) -> list
//     Split a single line into fields of the given character widths.
//     Each field has trailing spaces stripped.  If the line is shorter than
//     the sum of widths, the missing characters are treated as spaces (the
//     field becomes "" after trimming).
//
//   fxw_parse_all(text, widths) -> list
//     Split text on chr(10), skip blank lines, apply fxw_parse to each
//     non-blank line.  Returns a list of field-lists.
//
//   fxw_format(fields, widths) -> string
//     Left-justify each field to its column width, padding with spaces on
//     the right.  If a field value is longer than its width, it is
//     truncated to exactly width characters.  Returns a single string that
//     is exactly sum(widths) characters long.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - Single-exit style throughout (avoids NOVA return-null mistag).
//   - No multi-line list/dict literals in module body.
//   - Brace chars via chr(123)/chr(125) — never literal braces in strings.
//   - slice() is STRING-ONLY (never used on lists here).
//   - Trailing-space stripping is done character-by-character (trim() strips
//     both leading AND trailing which would destroy leading-space fields;
//     we want only trailing spaces removed).
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// Strip ONLY trailing spaces from a string.
// We iterate from the right and slice off the suffix of spaces.
fn _fxw_rstrip(s) -> string
    let n = len(s)
    let end = n
    let done = 0
    let i = n - 1
    while i >= 0 and done == 0
        let ch = s[i]
        if ord(ch) == 32
            end = i
            i -= 1
        else
            done = 1
    slice(s, 0, end)

// Extract one fixed-width field from line starting at byte offset `start`
// with the given width.  Returns the field with trailing spaces stripped.
fn _fxw_field(line, start, width) -> string
    let line_len = len(line)
    let field_end = start + width
    let raw = ""
    if start >= line_len
        raw = ""
    else
        if field_end > line_len
            raw = slice(line, start, line_len)
        else
            raw = slice(line, start, field_end)
    _fxw_rstrip(raw)

// Build a spaces-only string of exactly n characters.
fn _fxw_spaces(n) -> string
    let result = ""
    for i in 0..n
        result += " "
    result

// ── Public API ───────────────────────────────────────────────────────────────

// fxw_parse: split a single fixed-width line into a list of trimmed fields.
//
// widths is a list of positive integers whose sum equals the expected line
// length.  Fields are extracted in order; the line may be shorter (missing
// characters are treated as spaces → "" after trimming).
fn fxw_parse(line, widths) -> list
    let fields = []
    let nw = len(widths)
    let offset = 0
    for i in 0..nw
        let w = widths[i]
        let f = _fxw_field(line, offset, w)
        fields.push(f)
        offset += w
    fields

// fxw_parse_all: parse every non-blank line in text as a fixed-width record.
//
// Lines are split on chr(10).  A line is considered blank when its length
// after stripping trailing chr(13) (CRLF tolerance) is zero.
// Returns a list of field-lists, one per non-blank line.
fn fxw_parse_all(text, widths) -> list
    let rows = []
    let lines = split(text, chr(10))
    let n = len(lines)
    let i = 0
    while i < n
        let raw = lines[i]
        let line_len = len(raw)
        let line = raw
        if line_len > 0
            if ord(raw[line_len - 1]) == 13
                line = slice(raw, 0, line_len - 1)
        if len(line) > 0
            let fields = fxw_parse(line, widths)
            rows.push(fields)
        i += 1
    rows

// fxw_format: format a list of fields into a fixed-width string.
//
// Each field is left-justified and padded to exactly widths[i] characters.
// If a field value is longer than widths[i] it is truncated.
// widths may be longer than fields; extra columns are emitted as all-spaces.
// widths shorter than fields: extra fields are silently ignored.
fn fxw_format(fields, widths) -> string
    let result_parts = []
    let nw = len(widths)
    let nf = len(fields)
    for i in 0..nw
        let w = widths[i]
        let cell = ""
        if i < nf
            let raw = fields[i]
            let fl = len(raw)
            if fl >= w
                cell = slice(raw, 0, w)
            else
                let pad = _fxw_spaces(w - fl)
                cell = raw + pad
        else
            cell = _fxw_spaces(w)
        push(result_parts, cell)
    let result = join(result_parts, "")
    result
