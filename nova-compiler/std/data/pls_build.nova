// ============================================================================
// NOVA Standard Library — std/data/pls_build
// ============================================================================
// PLS playlist builder and parser.
//
// PLS is a plain-text INI-style playlist format used by media players
// (Winamp, VLC, etc.).  Format:
//
//   [playlist]
//   File1=<url>
//   Title1=<title>
//   Length1=<seconds>   (-1 means unknown)
//   File2=...
//   NumberOfEntries=N
//   Version=2
//
// PUBLIC API
//   pls_build(entries) -> string
//       entries: list of dicts with keys "url", "title", "length" (int seconds)
//       Returns a complete PLS document string.
//
//   pls_parse(text) -> list
//       Parse a PLS document back to a list of dicts {url, title, length}.
//       Unknown or missing Length values default to -1.
//
// EXAMPLES
//   let e = {}
//   e["url"]    = "http://example.com/a.mp3"
//   e["title"]  = "Song A"
//   e["length"] = 180
//   let entries = [e]
//   pls_build(entries)
//   // => "[playlist]\nFile1=http://example.com/a.mp3\nTitle1=Song A\nLength1=180\nNumberOfEntries=1\nVersion=2\n"
//
// IMPLEMENTATION NOTES
//   • Private helpers prefixed _pls_ to avoid link collisions.
//   • Single-exit style throughout (NOVA early-return mistag bug avoidance).
//   • No multi-line list/dict literals.
//   • LEAF module — imports nothing.
//   • LF = chr(10).
// ============================================================================

// ── Private: integer to decimal string ───────────────────────────────────────

fn _pls_int_str(n)
    let result = ""
    if n == 0
        result = "0"
    else
        let neg = 0
        let v = n
        if v < 0
            neg = 1
            v = 0 - v
        let digits = ""
        let go = 1
        while go == 1
            let d = v % 10
            digits = chr(48 + d) + digits
            v = v / 10
            if v == 0
                go = 0
        if neg == 1
            result = "-" + digits
        else
            result = digits
    return result

// ── Private: parse a decimal integer string ──────────────────────────────────

fn _pls_parse_int(s)
    let result = 0
    let neg = 0
    let i = 0
    let n = len(s)
    let go = 1
    while go == 1
        if i >= n
            go = 0
        else
            let ch = char_at(s, i)
            if ch == "-" and i == 0
                neg = 1
                i += 1
            else
                let o = ord(ch)
                if o >= 48 and o <= 57
                    result = result * 10 + (o - 48)
                    i += 1
                else
                    go = 0
    if neg == 1
        result = 0 - result
    return result

// ── Private: find first occurrence of sub in s starting at pos ──────────────

fn _pls_find(s, sub, pos)
    let result = -1
    let slen = len(s)
    let sublen = len(sub)
    let i = pos
    let go = 1
    while go == 1
        if i + sublen > slen
            go = 0
        else
            let frag = slice(s, i, i + sublen)
            if frag == sub
                result = i
                go = 0
            else
                i += 1
    return result

// ── Private: extract a line from text starting at pos, returns [line, newpos] ─

fn _pls_get_line(s, pos)
    let slen = len(s)
    let end_pos = pos
    let go = 1
    while go == 1
        if end_pos >= slen
            go = 0
        else
            let ch = char_at(s, end_pos)
            if ch == chr(10)
                go = 0
            else
                end_pos += 1
    let line = slice(s, pos, end_pos)
    // Strip trailing CR if present (Windows line endings)
    let linelen = len(line)
    if linelen > 0
        let last = char_at(line, linelen - 1)
        if last == chr(13)
            line = slice(line, 0, linelen - 1)
    let result = []
    push(result, line)
    // newpos: skip past the LF
    let newpos = end_pos
    if end_pos < slen
        newpos = end_pos + 1
    push(result, newpos)
    return result

// ── Public: pls_build ────────────────────────────────────────────────────────

// pls_build: emit a PLS playlist string from a list of entry dicts.
// Each entry dict must have keys: "url" (string), "title" (string),
// "length" (int, seconds; -1 = unknown).
fn pls_build(entries)
    let lf = chr(10)
    let result = "[playlist]" + lf
    let n = len(entries)
    for i in 0..n
        let e = entries[i]
        let idx = _pls_int_str(i + 1)
        let url = e["url"]
        let title = e["title"]
        let length = e["length"]
        result += "File" + idx + "=" + url + lf
        result += "Title" + idx + "=" + title + lf
        result += "Length" + idx + "=" + _pls_int_str(length) + lf
    result += "NumberOfEntries=" + _pls_int_str(n) + lf
    result += "Version=2" + lf
    return result

// ── Public: pls_parse ────────────────────────────────────────────────────────

// pls_parse: parse a PLS playlist string to a list of entry dicts.
// Returns a list of dicts with keys "url", "title", "length".
fn pls_parse(text)
    let slen = len(text)
    // First pass: collect all key=value pairs into a flat dict
    let kv = {}
    let pos = 0
    let go = 1
    while go == 1
        if pos >= slen
            go = 0
        else
            let lr = _pls_get_line(text, pos)
            let line = lr[0]
            pos = lr[1]
            // Skip [playlist] header and blank lines
            let llen = len(line)
            if llen > 0
                // Find '='
                let eq = _pls_find(line, "=", 0)
                if eq > 0
                    let k = slice(line, 0, eq)
                    let v = slice(line, eq + 1, llen)
                    kv[k] = v
    // Determine count from NumberOfEntries
    let count = 0
    if "NumberOfEntries" in kv
        count = _pls_parse_int(kv["NumberOfEntries"])
    // Build result list
    let result = []
    let i = 1
    while i <= count
        let idx = _pls_int_str(i)
        let entry = {}
        // url
        let url_key = "File" + idx
        let url_val = ""
        if url_key in kv
            url_val = kv[url_key]
        entry["url"] = url_val
        // title
        let title_key = "Title" + idx
        let title_val = ""
        if title_key in kv
            title_val = kv[title_key]
        entry["title"] = title_val
        // length
        let len_key = "Length" + idx
        let len_val = -1
        if len_key in kv
            len_val = _pls_parse_int(kv[len_key])
        entry["length"] = len_val
        push(result, entry)
        i += 1
    return result
