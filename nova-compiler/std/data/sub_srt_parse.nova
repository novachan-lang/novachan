// ============================================================================
// NOVA Standard Library — std/data/sub_srt_parse
// ============================================================================
// SRT subtitle parser.
//
// PUBLIC API:
//   srt_parse(text)     -> list of cue dicts
//     Each cue: {"index":int, "start":int, "end":int, "text":string}
//     Multi-line subtitle text is joined with chr(10).
//     CRLF is normalized to LF before parsing.
//     Blank lines separate cues.
//
//   srt_cue_count(text) -> int
//     Number of cues in the SRT document.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing (timecode parsing inlined).
//   - Single-exit style throughout.
//   - Timecode: "HH:MM:SS,mmm --> HH:MM:SS,mmm"
// ============================================================================

// Strip a leading UTF-8 BOM (bytes 0xEF,0xBB,0xBF), if present. Common in
// SRT files saved by Windows editors (Notepad, some Windows Media Player
// exports). Left unstripped, the BOM's bytes corrupt the first cue's index
// parse (_sp_parse_int reads garbage digits) or make the first index line
// look non-numeric.
fn _sp_strip_bom(text) -> string
    let result = text
    if len(text) >= 3
        if ord(slice(text, 0, 1)) == 239 and ord(slice(text, 1, 2)) == 187 and ord(slice(text, 2, 3)) == 191
            result = slice(text, 3, len(text))
    result

// ── Inlined timecode helper ──────────────────────────────────────────────────

// Parse a substring as a decimal integer.
fn _sp_parse_int(s, start, end) -> int
    let result = 0
    let i = start
    while i < end
        let ch = ord(slice(s, i, i + 1))
        result = result * 10 + (ch - 48)
        i += 1
    result

// Parse "HH:MM:SS,mmm" -> milliseconds.
fn _sp_parse_tc(s) -> int
    let h = _sp_parse_int(s, 0, 2)
    let m = _sp_parse_int(s, 3, 5)
    let sec = _sp_parse_int(s, 6, 8)
    let ms = _sp_parse_int(s, 9, 12)
    h * 3600000 + m * 60000 + sec * 1000 + ms

// ── Private helpers ──────────────────────────────────────────────────────────

// Strip trailing CR from a line (CRLF tolerance).
fn _sp_strip_cr(line) -> string
    let result = line
    let n = len(line)
    if n > 0
        if ord(slice(line, n - 1, n)) == 13
            result = slice(line, 0, n - 1)
    result

// Determine if a line is blank (empty after CR strip).
fn _sp_blank(line) -> int
    let stripped = _sp_strip_cr(line)
    let result = 0
    if len(stripped) == 0
        result = 1
    result

// Parse a timing line "HH:MM:SS,mmm --> HH:MM:SS,mmm" into start/end ms.
// Returns a list [start_ms, end_ms].
fn _sp_parse_timing(line) -> list
    // Start at position 0, length 12; arrow " --> " is 5 chars; end starts at 17
    let start_ms = _sp_parse_tc(slice(line, 0, 12))
    let end_ms = _sp_parse_tc(slice(line, 17, 29))
    let parts = []
    parts.push(start_ms)
    parts.push(end_ms)
    parts

// Is this line a timing line? Check for "-->" after position 12.
fn _sp_is_timing(line) -> int
    let result = 0
    if len(line) >= 29
        let arrow = slice(line, 12, 17)
        if arrow == " --> "
            result = 1
    result

// ── Public API ───────────────────────────────────────────────────────────────

// srt_parse: parse SRT text into a list of cue dicts.
fn srt_parse(text) -> list
    let cues = []
    let lines = split(_sp_strip_bom(text), chr(10))
    let n = len(lines)
    // State machine: 0=awaiting_index, 1=awaiting_timing, 2=reading_text
    // 'handled' prevents cascading state transitions within one line.
    let state = 0
    let cur_index = 0
    let cur_start = 0
    let cur_end = 0
    let cur_text = ""
    for i in 0..n
        let raw = lines[i]
        let line = _sp_strip_cr(raw)
        let handled = 0
        if state == 0
            if handled == 0
                if len(line) > 0
                    cur_index = _sp_parse_int(line, 0, len(line))
                    cur_start = 0
                    cur_end = 0
                    cur_text = ""
                    state = 1
                    handled = 1
        if state == 1
            if handled == 0
                if _sp_is_timing(line) == 1
                    let timing = _sp_parse_timing(line)
                    cur_start = timing[0]
                    cur_end = timing[1]
                    state = 2
                    handled = 1
        if state == 2
            if handled == 0
                // Reading text lines until blank
                if len(line) == 0
                    // Blank line: flush cue
                    let cue = {}
                    cue["index"] = cur_index
                    cue["start"] = cur_start
                    cue["end"] = cur_end
                    cue["text"] = cur_text
                    cues.push(cue)
                    state = 0
                    handled = 1
                if handled == 0
                    if len(line) > 0
                        if len(cur_text) == 0
                            cur_text = line
                        else
                            cur_text += chr(10) + line
    // Flush last cue if text ended without trailing blank line
    if state == 2
        let cue = {}
        cue["index"] = cur_index
        cue["start"] = cur_start
        cue["end"] = cur_end
        cue["text"] = cur_text
        cues.push(cue)
    cues

// srt_cue_count: return the number of cues in the SRT document.
fn srt_cue_count(text) -> int
    let cues = srt_parse(text)
    len(cues)
