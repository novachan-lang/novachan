// std/data/java_class -- Java .class file header parser (big-endian).
//
// Java .class files begin with a 10-byte header:
//   Offset  Size  Field
//   ------  ----  -----
//    0       4    Magic: 0xCA 0xFE 0xBA 0xBE (202,254,186,190)
//    4       2    minor_version (u16be)
//    6       2    major_version (u16be)
//    8       2    constant_pool_count (u16be)
//
// Major version -> JDK:
//   45=1.1, 46=1.2, 47=1.3, 48=1.4, 49=5, 50=6, 51=7, 52=8,
//   53=9, 54=10, 55=11, 56=12, 57=13, 58=14, 59=15, 60=16,
//   61=17, 62=18, 63=19, 64=20, 65=21
//
// PUBLIC API (prefix jclass_):
//   jclass_magic_check(buf)    -> bool   true if magic bytes match
//   jclass_minor(buf)          -> int    minor_version field
//   jclass_major(buf)          -> int    major_version field
//   jclass_cp_count(buf)       -> int    constant_pool_count field
//   jclass_java_version(buf)   -> string JDK version string or 'unknown'
//   jclass_major_to_jdk(major) -> string map major version to JDK string
//   jclass_is_valid(buf)       -> bool   magic ok and buf length >= 10
//   jclass_is_preview(buf)     -> bool   minor_version == 65535
//   jclass_min_supported()     -> int    45 (Java 1.1)
//   jclass_max_known()         -> int    65 (Java 21)
//   jclass_describe(buf)       -> string 'Java class, JDK <version>'
//
// LEAF module -- imports nothing.

// _u16be: read a big-endian u16 from list buf at byte offset p.
fn _u16be(b: any, p: int) -> int
    return b[p]*256 + b[p+1]

// jclass_magic_check: return true if bytes 0..3 equal the Java magic 0xCAFEBABE.
fn jclass_magic_check(buf: any) -> bool
    if len(buf) < 4
        return false
    if buf[0] != 202
        return false
    if buf[1] != 254
        return false
    if buf[2] != 186
        return false
    if buf[3] != 190
        return false
    return true

// jclass_minor: return the minor_version field (u16be at offset 4).
fn jclass_minor(buf: any) -> int
    if len(buf) < 6
        return 0
    return _u16be(buf, 4)

// jclass_major: return the major_version field (u16be at offset 6).
fn jclass_major(buf: any) -> int
    if len(buf) < 8
        return 0
    return _u16be(buf, 6)

// jclass_cp_count: return the constant_pool_count field (u16be at offset 8).
fn jclass_cp_count(buf: any) -> int
    if len(buf) < 10
        return 0
    return _u16be(buf, 8)

// jclass_major_to_jdk: map a raw major version number to a JDK version string.
// Returns 'unknown' for values outside 45..65.
fn jclass_major_to_jdk(major: int) -> string
    if major == 45
        return "1.1"
    if major == 46
        return "1.2"
    if major == 47
        return "1.3"
    if major == 48
        return "1.4"
    if major == 49
        return "5"
    if major == 50
        return "6"
    if major == 51
        return "7"
    if major == 52
        return "8"
    if major == 53
        return "9"
    if major == 54
        return "10"
    if major == 55
        return "11"
    if major == 56
        return "12"
    if major == 57
        return "13"
    if major == 58
        return "14"
    if major == 59
        return "15"
    if major == 60
        return "16"
    if major == 61
        return "17"
    if major == 62
        return "18"
    if major == 63
        return "19"
    if major == 64
        return "20"
    if major == 65
        return "21"
    return "unknown"

// jclass_java_version: return the JDK version string for the class file's major version.
fn jclass_java_version(buf: any) -> string
    let maj = jclass_major(buf)
    return jclass_major_to_jdk(maj)

// jclass_is_valid: return true if magic is correct and buffer has at least 10 bytes.
fn jclass_is_valid(buf: any) -> bool
    if len(buf) < 10
        return false
    return jclass_magic_check(buf)

// jclass_is_preview: return true if minor_version == 65535 (preview feature marker).
fn jclass_is_preview(buf: any) -> bool
    return jclass_minor(buf) == 65535

// jclass_min_supported: return the minimum known major version (45 = Java 1.1).
fn jclass_min_supported() -> int
    return 45

// jclass_max_known: return the maximum known major version (65 = Java 21).
fn jclass_max_known() -> int
    return 65

// jclass_describe: return a human-readable description of the class file.
fn jclass_describe(buf: any) -> string
    let ver = jclass_java_version(buf)
    return "Java class, JDK " + ver
