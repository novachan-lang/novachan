// ============================================================================
// NOVA Standard Library — std/data/tabular
// ============================================================================
// Tabular data operations over a list of row-dicts.
// Each "row" is a dict with string keys and scalar (string/int/float) values.
//
// PUBLIC API
//   tb_columns(rows) -> list
//       Return the sorted union of all keys across every row.
//
//   tb_select(rows, cols) -> list
//       Project each row to only the columns in `cols`.
//       Missing keys are omitted from the output row (no null padding).
//
//   tb_filter(rows, key, value) -> list
//       Return rows where row[key] == value.
//       Rows that do not contain key are silently excluded.
//
//   tb_sort_by(rows, key) -> list
//       Return a stable-sorted copy of rows by row[key] (ascending).
//       String keys use lexicographic order; numeric keys use numeric order.
//       Rows missing the key sort last.
//
//   tb_to_matrix(rows, cols) -> list of lists
//       Convert rows to a 2-D list (list of value-lists), column order = cols.
//       Missing cells become the empty string "".
//
//   tb_group_count(rows, key) -> dict
//       Return a dict mapping each distinct value of row[key] to its row count.
//       Rows missing the key are silently skipped.
//
// IMPLEMENTATION NOTES
//   • Guard every dict read with contains().
//   • Single-exit pattern used throughout (avoids return-null mistag bug).
//   • Insertion sort for tb_sort_by (stable; correct for typical table sizes).
//   • All private helpers prefixed _tb_.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _tb_contains_str: return 1 if string s already appears in list lst.
fn _tb_contains_str(lst, s) -> int
    let found = 0
    let n = len(lst)
    for i in 0..n
        if lst[i] == s
            found = 1
    return found

// _tb_cmp_vals: compare two scalar values.
// Returns -1 (a < b), 0 (a == b), +1 (a > b).
// Both strings -> lexicographic. Otherwise -> numeric (multiply by 1.0).
fn _tb_cmp_vals(a, b) -> int
    let result = 0
    let ta = type_of(a)
    let tb = type_of(b)
    if ta == "string" and tb == "string"
        if a < b
            result = -1
        else
            if a > b
                result = 1
            else
                result = 0
    else
        let af = a * 1.0
        let bf = b * 1.0
        if af < bf
            result = -1
        else
            if af > bf
                result = 1
            else
                result = 0
    return result

// ── Public API ───────────────────────────────────────────────────────────────

// tb_columns: return the sorted union of all keys across every row.
//
// Example:
//   tb_columns([{"a":1,"b":2},{"b":3,"c":4}])  ->  ["a","b","c"]
fn tb_columns(rows)
    let seen = []
    let n = len(rows)
    for i in 0..n
        let row = rows[i]
        let ks = keys(row)
        for k in ks
            if _tb_contains_str(seen, k) == 0
                seen.push(k)
    return sort(seen)

// tb_select: project each row to only the listed columns.
// Keys absent from a given row are simply omitted (no null padding).
//
// Example:
//   tb_select(rows, ["name","age"])  ->  rows with only "name" and "age" keys
fn tb_select(rows, cols)
    let out = []
    let n = len(rows)
    let m = len(cols)
    for i in 0..n
        let row = rows[i]
        let new_row = {}
        for j in 0..m
            let col = cols[j]
            if col in row == 1
                new_row[col] = row[col]
        out.push(new_row)
    return out

// tb_filter: return rows where row[key] == value.
// Rows that do not contain key are silently excluded.
//
// Example:
//   tb_filter(rows, "status", "active")  ->  rows where status == "active"
fn tb_filter(rows, key, value)
    let out = []
    let n = len(rows)
    for i in 0..n
        let row = rows[i]
        if key in row == 1
            if row[key] == value
                out.push(row)
    return out

// tb_sort_by: return a stable-sorted copy of rows by row[key] (ascending).
// String column -> lexicographic. Numeric column -> numeric order.
// Rows missing the key sort after all rows that have it.
// Uses insertion sort (stable for any table size).
//
// Example:
//   tb_sort_by(rows, "score")  ->  rows ordered by score, smallest first
fn tb_sort_by(rows, key)
    // Copy into a fresh list first (never mutate caller's list).
    let sorted = []
    let n = len(rows)
    for i in 0..n
        sorted.push(rows[i])
    // Insertion sort (stable).
    for j in 1..n
        let cur = sorted[j]
        let pos = j
        while pos > 0
            let prev = sorted[pos - 1]
            let prev_has = key in prev
            let cur_has = key in cur
            let do_swap = 0
            if cur_has == 1 and prev_has == 0
                // cur has the key but prev doesn't -> cur should come first.
                do_swap = 1
            else
                if cur_has == 1 and prev_has == 1
                    let cmp = _tb_cmp_vals(prev[key], cur[key])
                    // Ascending: swap when prev > cur.
                    if cmp > 0
                        do_swap = 1
            if do_swap == 1
                sorted[pos] = sorted[pos - 1]
                sorted[pos - 1] = cur
                pos -= 1
            else
                pos = 0
    return sorted

// tb_to_matrix: convert rows to a list of value-lists, ordered by cols.
// Missing cells are represented as the empty string "".
//
// Example:
//   tb_to_matrix([{"a":"1","b":"2"}], ["a","b"])  ->  [["1","2"]]
fn tb_to_matrix(rows, cols)
    let out = []
    let n = len(rows)
    let m = len(cols)
    for i in 0..n
        let row = rows[i]
        let row_vals = []
        for j in 0..m
            let col = cols[j]
            if col in row == 1
                row_vals.push(row[col])
            else
                row_vals.push("")
        out.push(row_vals)
    return out

// tb_group_count: count how many rows share each distinct value of row[key].
// Returns a dict mapping value (as string) -> count (int).
// Rows missing the key are silently skipped.
//
// Example:
//   tb_group_count(rows, "status")  ->  {"active": 3, "inactive": 1}
fn tb_group_count(rows, key)
    let counts = {}
    let n = len(rows)
    for i in 0..n
        let row = rows[i]
        if key in row == 1
            let val = str(row[key])
            if val in counts == 1
                counts[val] = counts[val] + 1
            else
                counts[val] = 1
    return counts
