// ============================================================================
// NOVA Standard Library — std/data/toml
// ============================================================================
// TOML v1.0 document PARSER. Parses TOML source text into a nested NOVA dict.
//
// PUBLIC API
//   toml_parse(text: string) -> dict
//     Parse a whole TOML document into a nested dict.
//   toml_get(config: dict, path: string) -> any
//     Dotted-path lookup ("database.port") into a parsed dict; "" if any
//     segment along the path is missing or not a dict.
//
// SUPPORTED SURFACE (TOML v1.0)
//   - bare key = value                      title = "NOVA"
//   - dotted keys                           a.b.c = 1        (implicit tables)
//   - basic strings "..." with escapes      \n \t \" \\ \r   (unknown escape:
//                                            backslash dropped, char kept literal)
//   - literal strings '...'                 no escape processing
//   - integers                              42, -7, 1_000 (underscores stripped)
//   - floats                                3.14, -0.5, 1e10, 6.02_214e23
//   - booleans                              true / false
//   - arrays                                [1, 2, 3]  — MAY span multiple
//                                            lines and contain '#' comments
//                                            inside the brackets; trailing
//                                            comma allowed (beyond the single-
//                                            line form the spec calls for)
//   - [table] headers                       nested dict at that dotted path
//   - [[array.of.tables]] headers           list-of-dicts; each occurrence
//                                            appends a new dict and becomes
//                                            the target for subsequent keys /
//                                            subtable headers (so a following
//                                            `[fruits.physical]` after
//                                            `[[fruits]]` correctly nests into
//                                            the LAST appended element — this
//                                            is standard TOML v1.0 behaviour)
//   - comments                              # to end of line (not honoured
//                                            inside a quoted string)
//
// KNOWN SUBSET LIMITS (documented, not silently wrong):
//   - No triple-quoted multi-line strings (""" / ''').
//   - No inline tables ({ k = v }) as a value.
//   - No hex/octal/binary integers (0x.., 0o.., 0b..), no inf/nan.
//   - No RFC-3339 datetime type — a bareword that doesn't parse as a plain
//     int/float is returned verbatim as its raw string (safe fallback, never
//     a crash).
//   - Quoted keys ("a b" = 1) ARE supported as a bonus (reuses the same
//     string-body parser) even though the task spec only requires bare keys.
//
// SOUNDNESS (audited — see nova-compiler/test_programs/_kat_toml_parse_audit.nova):
//   - Nested-array recursion (_tm_parse_value <-> _tm_parse_array on '[') is
//     capped at _TM_MAX_DEPTH (1000). Deeper input (e.g. 20000x "[") falls
//     back to an iterative, non-recursive bracket skip past the cap, so
//     native call-stack usage is bounded regardless of input nesting depth.
//   - toml_parse's top-level loop and _tm_parse_array's element loop both
//     guarantee >= 1 byte of forward progress per iteration, so a stray
//     delimiter with no value before it (e.g. a bare "]" / "}" / "," where a
//     key or value was expected) is skipped rather than looped on forever.
//   - Per the "KNOWN SUBSET LIMITS" above, this parser is intentionally
//     LENIENT: it has no Result/err channel and never fails a document —
//     malformed input is recovered from best-effort (as documented per
//     construct above) rather than rejected. This is a pre-existing,
//     deliberate design choice, not something introduced by the audit.
//
// PERF AUDIT (O(n^2) DoS fix — see std/data/ini.nova for the same class of
// bug and the proven fix): every scanning loop in this module previously
// advanced a cursor with char_at(s, p)/ord(char_at(s, p)) and built output
// strings via `buf = buf + char_at(s, p)`. char_at compiles to
// nova_rt_char_at, which does strlen(s) plus a full UTF-8 re-decode from
// byte 0 on EVERY call — so char_at(s, p) is O(p), and any
// `while p < n: char_at(s, p); p = p + 1` loop is O(n^2) overall; a flat
// 2000-line TOML document measured ~1.7s under the old code. Fixed by
// computing `let bs = str_to_bytes(text)` / `let n = bytes_len(bs)` ONCE in
// toml_parse and threading `bs` (for O(1) `bytes_get(bs, p)` scanning)
// through every helper alongside the shared `st["pos"]` cursor, instead of
// re-deriving a byte view per call. Output strings are now built either via
// slice(s, start, end) (bare keys/tokens/literal-string bodies — a plain,
// untransformed byte range, so a single O(len) copy) or via
// buffer()/buf_append_char/buf_to_str (basic-string bodies, which need
// per-byte escape processing) — both O(1)-amortized per byte, never
// O(index) per byte. `s` (the original string) is still threaded alongside
// `bs` wherever slice() is needed, since slice() operates on the original
// string and its offsets are byte offsets — the SAME offsets `bs`/`bytes_get`
// use, so no separate index space is introduced.
//   As a side effect this also closes the same latent UTF-8 bug class
// documented in std/data/ini.nova's audit note: char_at indexes by
// Unicode CODEPOINT while len()/slice() index by raw BYTE offset, and the
// pre-fix code used `len(text)` (a byte count) as the bound for a
// char_at-based (codepoint-indexed) cursor — for input containing
// multi-byte UTF-8, that mismatch could silently misplace scan boundaries.
// The byte-based rewrite uses ONE consistent index space (bytes) throughout,
// matching slice()'s semantics exactly, eliminating that class of bug here
// too. Multi-byte UTF-8 content in string bodies is now copied byte-by-byte
// (one loop iteration = one raw byte, via bytes_get/buf_append_char), which
// reconstructs multi-byte sequences byte-for-byte since every byte in the
// scan range is visited and copied in order.
//
// NOVA TYPING NOTE: `type_of(true) == "int"` (documented language gotcha —
// booleans and integers share scalar representation), but `x == true` /
// `x == false` comparisons on a bool-boxed value still evaluate correctly;
// verified empirically for the exact shape used here (single `let result`
// of inferred `any` type, reassigned across branches, one final `return`).
//
// DESIGN NOTES
//   - Mutable cursor threaded as dict {"pos": int} (same convention as
//     std/data/json5.nova and std/data/edn.nova).
//   - Single-exit style throughout (avoid the NOVA early-return mistag bug).
//   - No multi-line list/dict literals in module body (NOVA parser limit).
//   - All private helpers prefixed `_tm_` to avoid symbol collisions.
//   - LEAF module — imports nothing.
//
// KAT vectors (see nova-compiler/test_programs/_toml_test.nova):
//   toml_parse('title = "NOVA"\n[db]\nport = 5432\nenabled = true\n
//               tags = ["x","y"]\n[[srv]]\nip = "10.0.0.1"\n[[srv]]\n
//               ip = "10.0.0.2"')
//     -> result["title"] == "NOVA"
//     -> result["db"]["port"] == 5432
//     -> result["db"]["enabled"] == true
//     -> result["db"]["tags"][1] == "y"
//     -> len(result["srv"]) == 2
//     -> result["srv"][1]["ip"] == "10.0.0.2"
// ============================================================================

// _TM_MAX_DEPTH: safety cap on nested-array recursion depth (_tm_parse_value
// <-> _tm_parse_array are mutually recursive on '[') — unbounded input like
// "x = [[[[[...20000 times]]]]]" would otherwise recurse 1 native stack
// frame pair per nesting level with no limit -> stack overflow. Past this
// cap, _tm_skip_balanced (iterative, no recursion) takes over so arbitrarily
// deep further nesting is bounded to O(1) extra stack regardless of depth.
let _TM_MAX_DEPTH = 1000

// ── Character classification ─────────────────────────────────────────────────

// _tm_is_hspace: 1 if code-point o is horizontal whitespace (space, tab).
fn _tm_is_hspace(o)
    let result = 0
    if o == 32
        result = 1
    else
        if o == 9
            result = 1
    return result

// _tm_is_nl: 1 if code-point o is a newline component (LF or CR).
fn _tm_is_nl(o)
    let result = 0
    if o == 10
        result = 1
    else
        if o == 13
            result = 1
    return result

// _tm_is_digit: 1 if code-point o is ASCII '0'-'9'.
fn _tm_is_digit(o)
    let result = 0
    if o >= 48
        if o <= 57
            result = 1
    return result

// _tm_is_bare_key_char: 1 if o is valid in a bare TOML key (A-Z a-z 0-9 _ -).
fn _tm_is_bare_key_char(o)
    let result = 0
    if o >= 65
        if o <= 90
            result = 1
    if result == 0
        if o >= 97
            if o <= 122
                result = 1
    if result == 0
        if _tm_is_digit(o) == 1
            result = 1
    if result == 0
        if o == 95
            result = 1
    if result == 0
        if o == 45
            result = 1
    return result

// ── Skipping: whitespace, newlines, comments ─────────────────────────────────
// These are pure cursor-advance scans (no output text produced), so they
// only need the byte view `bs`/`n`, not the original string `s`.

// _tm_skip_h: advance st["pos"] past horizontal whitespace only (does not
// cross a newline — used mid-line, where a value stops at end of line).
// Byte-indexed (bytes_get is O(1) per call, unlike char_at — see PERF AUDIT
// at top of file), so this is O(run length), never O(n) per call.
fn _tm_skip_h(bs, n, st)
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            if _tm_is_hspace(bytes_get(bs, p)) == 1
                st["pos"] = p + 1
            else
                go = 0

// _tm_skip_to_eol: advance st["pos"] to just before the next '\n' (or EOF).
// Used to discard a '#' comment; does not consume the newline itself.
fn _tm_skip_to_eol(bs, n, st)
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            if bytes_get(bs, p) == 10
                go = 0
            else
                st["pos"] = p + 1

// _tm_skip_ws_nl_comments: advance st["pos"] past any mix of whitespace,
// newlines, and '#' line comments. Used between top-level statements and
// (since arrays may span multiple lines) between array elements.
fn _tm_skip_ws_nl_comments(bs, n, st)
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = bytes_get(bs, p)
            if _tm_is_hspace(o) == 1
                st["pos"] = p + 1
            else
                if _tm_is_nl(o) == 1
                    st["pos"] = p + 1
                else
                    if o == 35
                        _tm_skip_to_eol(bs, n, st)
                    else
                        go = 0

// ── String bodies ─────────────────────────────────────────────────────────────

// _tm_parse_basic_string: parse a double-quoted string body (pos must be just
// AFTER the opening '"'). Handles \n \t \" \\ \r; any other escaped char is
// kept literal (backslash dropped). Stops at the closing '"' or EOF.
// Byte-indexed (see PERF AUDIT at top of file): escape processing transforms
// bytes (e.g. \n -> a literal newline byte), so the result can't be a plain
// slice() of the input — it is accumulated in a buffer() and each byte
// appended via buf_append_char (O(1)-amortized), never `buf = buf + c`
// string concatenation (O(n^2) — see ini.nova's audit note for that class of
// bug). Multi-byte UTF-8 content is copied through byte-by-byte, which
// reconstructs it byte-for-byte since every byte in range is visited in order.
fn _tm_parse_basic_string(bs, n, st)
    let buf = buffer()
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = bytes_get(bs, p)
            if o == 34
                st["pos"] = p + 1
                go = 0
            else
                if o == 92
                    st["pos"] = p + 1
                    let q = st["pos"]
                    if q < n
                        let eo = bytes_get(bs, q)
                        st["pos"] = q + 1
                        if eo == 110
                            buf_append_char(buf, 10)
                        else
                            if eo == 116
                                buf_append_char(buf, 9)
                            else
                                if eo == 34
                                    buf_append_char(buf, 34)
                                else
                                    if eo == 92
                                        buf_append_char(buf, 92)
                                    else
                                        if eo == 114
                                            buf_append_char(buf, 13)
                                        else
                                            buf_append_char(buf, eo)
                else
                    buf_append_char(buf, o)
                    st["pos"] = p + 1
    return buf_to_str(buf)

// _tm_parse_literal_string: parse a single-quoted string body (pos must be
// just AFTER the opening "'"). No escape processing (TOML literal-string
// semantics). Stops at the closing "'" or EOF. Byte-indexed (see PERF AUDIT
// at top of file): since no escape processing happens, the body is an exact
// untransformed byte range of the original string, so it is captured with a
// single slice(s, start, end) call (O(len), one copy) rather than
// accumulating char-by-char. `s` is threaded alongside `bs` for this reason.
fn _tm_parse_literal_string(s, bs, n, st)
    let start = st["pos"]
    let stop_pos = start
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            stop_pos = p
            go = 0
        else
            if bytes_get(bs, p) == 39
                stop_pos = p
                st["pos"] = p + 1
                go = 0
            else
                st["pos"] = p + 1
    return slice(s, start, stop_pos)

// ── Bare tokens / scalar classification ──────────────────────────────────────

// _tm_read_bare_key: read a run of bare-key characters. Byte-indexed (see
// PERF AUDIT at top of file); the run is an untransformed byte range, so it
// is captured with a single slice(s, start, end) call.
fn _tm_read_bare_key(s, bs, n, st)
    let start = st["pos"]
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = bytes_get(bs, p)
            if _tm_is_bare_key_char(o) == 1
                st["pos"] = p + 1
            else
                go = 0
    return slice(s, start, st["pos"])

// _tm_read_bare_token: read a value-position bareword — stops at horizontal
// whitespace, newline, ',', ']', '}', '#', or EOF. Used for numbers/booleans.
// Byte-indexed (see PERF AUDIT at top of file); the run is an untransformed
// byte range, so it is captured with a single slice(s, start, end) call.
fn _tm_read_bare_token(s, bs, n, st)
    let start = st["pos"]
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = bytes_get(bs, p)
            let stop = 0
            if _tm_is_hspace(o) == 1
                stop = 1
            else
                if _tm_is_nl(o) == 1
                    stop = 1
                else
                    if o == 44
                        stop = 1
                    else
                        if o == 93
                            stop = 1
                        else
                            if o == 125
                                stop = 1
                            else
                                if o == 35
                                    stop = 1
            if stop == 1
                go = 0
            else
                st["pos"] = p + 1
    return slice(s, start, st["pos"])

// _tm_strip_underscores: remove '_' digit-group separators from a token.
// `tok` is an already-extracted (bounded) token, not the whole document, but
// is still scanned byte-indexed (str_to_bytes/bytes_get + buffer()
// accumulation) rather than char_at/string-concat for the same reason as
// every other scan in this file (see PERF AUDIT at top of file) — a
// pathologically long non-numeric bareword must not become O(len^2).
fn _tm_strip_underscores(tok)
    let tbs = str_to_bytes(tok)
    let tn = bytes_len(tbs)
    let out = buffer()
    for i in 0..tn
        let b = bytes_get(tbs, i)
        if b != 95
            buf_append_char(out, b)
    return buf_to_str(out)

// _tm_is_numeric: 1 if cleaned (underscore-stripped) token is a plain decimal
// integer or float literal: optional leading sign, digits, optional single
// '.', optional single exponent ('e'/'E', optional sign, digits).
// Byte-indexed for the same reason as _tm_strip_underscores above.
fn _tm_is_numeric(tok)
    let tbs = str_to_bytes(tok)
    let tn = bytes_len(tbs)
    let result = 0
    if tn > 0
        let i = 0
        let b0 = bytes_get(tbs, 0)
        if b0 == 45
            i = 1
        else
            if b0 == 43
                i = 1
        if i < tn
            let digits_seen = 0
            let dot_seen = 0
            let exp_seen = 0
            let ok = 1
            while i < tn
                let b = bytes_get(tbs, i)
                if _tm_is_digit(b) == 1
                    digits_seen = 1
                    i = i + 1
                else
                    if b == 46 and dot_seen == 0 and exp_seen == 0
                        dot_seen = 1
                        i = i + 1
                    else
                        if (b == 101 or b == 69) and exp_seen == 0 and digits_seen == 1
                            exp_seen = 1
                            i = i + 1
                            if i < tn
                                let bn = bytes_get(tbs, i)
                                if bn == 43 or bn == 45
                                    i = i + 1
                        else
                            ok = 0
                            i = tn
            if ok == 1 and digits_seen == 1
                result = 1
    return result

// _tm_classify_scalar: classify a bareword read in value position into
// bool / int / float / raw string (fallback for anything out of scope, e.g.
// a datetime literal — never crashes).
fn _tm_classify_scalar(tok)
    let result = null
    if tok == "true"
        result = true
    else
        if tok == "false"
            result = false
        else
            let cleaned = _tm_strip_underscores(tok)
            if _tm_is_numeric(cleaned) == 1
                if find(cleaned, ".") >= 0 or find(cleaned, "e") >= 0 or find(cleaned, "E") >= 0
                    result = parse_float(cleaned)
                else
                    result = parse_int(cleaned)
            else
                result = tok
    return result

// ── Values (strings, arrays, scalars) ────────────────────────────────────────

// _tm_skip_balanced: iteratively (NO recursion) advance st["pos"] past the
// remainder of an array value whose opening '[' has already been consumed,
// to its matching closing ']' (or EOF). Used once _TM_MAX_DEPTH is reached,
// so a pathologically deep tail of "[[[[...]]]]" past the cap is skipped in
// O(remaining length) with O(1) added stack, instead of recursing further.
// Correctly steps over quoted string bodies so a ']' or '[' inside a string
// literal can't desync the bracket count, and over '#' comments. Byte-
// indexed (see PERF AUDIT at top of file); `s` is threaded through only
// because it calls _tm_parse_literal_string, which needs it for slice().
fn _tm_skip_balanced(s, bs, n, st)
    let level = 1
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = bytes_get(bs, p)
            if o == 34
                st["pos"] = p + 1
                _tm_parse_basic_string(bs, n, st)
            else
                if o == 39
                    st["pos"] = p + 1
                    _tm_parse_literal_string(s, bs, n, st)
                else
                    if o == 91
                        level = level + 1
                        st["pos"] = p + 1
                    else
                        if o == 93
                            level = level - 1
                            st["pos"] = p + 1
                            if level <= 0
                                go = 0
                        else
                            if o == 35
                                _tm_skip_to_eol(bs, n, st)
                            else
                                st["pos"] = p + 1

// _tm_parse_array: parse array elements after the opening '[' (pos just
// after it) until the closing ']'. Tolerant of newlines, '#' comments, and a
// trailing comma inside the brackets (beyond the single-line array form the
// task spec calls for — cheap and low-risk to support). `depth` is the
// current array-nesting level (see _tm_parse_value / _TM_MAX_DEPTH).
fn _tm_parse_array(s, bs, n, st, depth)
    let result = []
    let go = 1
    while go == 1
        _tm_skip_ws_nl_comments(bs, n, st)
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = bytes_get(bs, p)
            if o == 93
                st["pos"] = p + 1
                go = 0
            else
                if o == 44
                    st["pos"] = p + 1
                else
                    let v = _tm_parse_value(s, bs, n, st, depth)
                    push(result, v)
                    // Forward-progress guard: a value-position byte this
                    // parser doesn't recognise as starting any value (e.g.
                    // '}' from an unsupported inline-table literal) makes
                    // _tm_parse_value return without consuming anything,
                    // which would otherwise spin on the same byte forever.
                    // Force at least 1 byte of progress so malformed array
                    // content is skipped, never hung on. No-op on any input
                    // that actually parsed a value (always advances >= 1).
                    if st["pos"] <= p
                        st["pos"] = p + 1
    return result

// _tm_parse_value: parse a single TOML value at the current cursor position.
// Dispatches on the first non-horizontal-whitespace character. `depth` is
// the current array-nesting level (0 at top level); see _TM_MAX_DEPTH.
fn _tm_parse_value(s, bs, n, st, depth)
    _tm_skip_h(bs, n, st)
    let result = null
    let p = st["pos"]
    if p < n
        let o = bytes_get(bs, p)
        if o == 34
            st["pos"] = p + 1
            result = _tm_parse_basic_string(bs, n, st)
        else
            if o == 39
                st["pos"] = p + 1
                result = _tm_parse_literal_string(s, bs, n, st)
            else
                if o == 91
                    st["pos"] = p + 1
                    if depth >= _TM_MAX_DEPTH
                        _tm_skip_balanced(s, bs, n, st)
                        result = []
                    else
                        result = _tm_parse_array(s, bs, n, st, depth + 1)
                else
                    let tok = _tm_read_bare_token(s, bs, n, st)
                    result = _tm_classify_scalar(tok)
    return result

// ── Key paths (dotted keys, table header names) ──────────────────────────────

// _tm_read_key_path: read a dotted key path ("a.b.c") into a list of segment
// strings. A segment may be a bare key, a double-quoted string, or a
// single-quoted (literal) string.
fn _tm_read_key_path(s, bs, n, st)
    let segs = []
    let go = 1
    while go == 1
        _tm_skip_h(bs, n, st)
        let p = st["pos"]
        let seg = ""
        if p < n
            let o = bytes_get(bs, p)
            if o == 34
                st["pos"] = p + 1
                seg = _tm_parse_basic_string(bs, n, st)
            else
                if o == 39
                    st["pos"] = p + 1
                    seg = _tm_parse_literal_string(s, bs, n, st)
                else
                    seg = _tm_read_bare_key(s, bs, n, st)
        push(segs, seg)
        _tm_skip_h(bs, n, st)
        let q = st["pos"]
        if q < n and bytes_get(bs, q) == 46
            st["pos"] = q + 1
        else
            go = 0
    return segs

// ── Tree navigation / assignment ─────────────────────────────────────────────

// _tm_nav: resolve dict `node`'s child `key` as the dict to descend into for
// an intermediate path segment. If the child doesn't exist, creates an empty
// dict there. If the child is a list (an array-of-tables, from `[[x]]`),
// descends into its LAST element — this is what makes `[fruits.physical]`
// correctly attach to the most recently appended `[[fruits]]` entry.
fn _tm_nav(node, key)
    let result = {}
    if contains(node, key)
        let v = node[key]
        if type_of(v) == "dict"
            result = v
        else
            if type_of(v) == "list"
                let ln = len(v)
                if ln > 0
                    result = v[ln - 1]
                else
                    let d = {}
                    push(v, d)
                    result = d
            else
                // Name collision with a scalar (invalid TOML) — defensively
                // replace with a fresh table rather than crash.
                let d = {}
                node[key] = d
                result = d
    else
        let d = {}
        node[key] = d
        result = d
    return result

// _tm_assign: assign `value` at dotted path `segs` starting from dict `root`,
// creating any missing intermediate tables.
fn _tm_assign(root, segs, value)
    let parent = root
    let n = len(segs)
    for i in 0..(n - 1)
        parent = _tm_nav(parent, segs[i])
    parent[segs[n - 1]] = value

// _tm_open_table: process a `[table]` or `[[array.of.tables]]` header whose
// dotted segments are `segs`. Returns the dict that subsequent key = value
// lines / nested headers should target.
fn _tm_open_table(root, segs, is_array)
    let parent = root
    let n = len(segs)
    for i in 0..(n - 1)
        parent = _tm_nav(parent, segs[i])
    let last = segs[n - 1]
    let current = {}
    if is_array == 1
        let arr = []
        if contains(parent, last) and type_of(parent[last]) == "list"
            arr = parent[last]
        else
            parent[last] = arr
        let newd = {}
        push(arr, newd)
        current = newd
    else
        current = _tm_nav(parent, last)
    return current

// ── Top-level document parser ────────────────────────────────────────────────

// toml_parse: parse a whole TOML document into a nested dict. Top-level keys
// (before any `[table]` header) go directly into the result; keys after a
// `[table]`/`[[array]]` header go into that (possibly nested) table.
// Byte-indexed: `bs`/`n` are computed ONCE here (str_to_bytes/bytes_len) and
// threaded through every helper for O(1) cursor reads, instead of every
// helper re-deriving a byte view (or worse, using char_at) per call — see
// PERF AUDIT at top of file.
fn toml_parse(text: string) -> dict
    let result = {}
    let current = result
    let bs = str_to_bytes(text)
    let n = bytes_len(bs)
    let st = {}
    st["pos"] = 0
    let go = 1
    while go == 1
        _tm_skip_ws_nl_comments(bs, n, st)
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = bytes_get(bs, p)
            if o == 91
                st["pos"] = p + 1
                let is_array = 0
                if st["pos"] < n and bytes_get(bs, st["pos"]) == 91
                    is_array = 1
                    st["pos"] = st["pos"] + 1
                let segs = _tm_read_key_path(text, bs, n, st)
                _tm_skip_h(bs, n, st)
                if st["pos"] < n and bytes_get(bs, st["pos"]) == 93
                    st["pos"] = st["pos"] + 1
                if is_array == 1
                    if st["pos"] < n and bytes_get(bs, st["pos"]) == 93
                        st["pos"] = st["pos"] + 1
                current = _tm_open_table(result, segs, is_array)
            else
                let segs2 = _tm_read_key_path(text, bs, n, st)
                _tm_skip_h(bs, n, st)
                if st["pos"] < n and bytes_get(bs, st["pos"]) == 61
                    st["pos"] = st["pos"] + 1
                _tm_skip_h(bs, n, st)
                let val = _tm_parse_value(text, bs, n, st, 0)
                _tm_assign(current, segs2, val)
            // Forward-progress guard: a stray delimiter where a key/header
            // was expected (e.g. a bare ',' / ']' / '}' at statement
            // position) makes both the table-header and key=value branches
            // read an empty key path and an empty value without consuming a
            // single byte -- looping forever on the same position. Every
            // WELL-FORMED statement always advances st["pos"] past `p`, so
            // this is a no-op on valid TOML; it only fires to force
            // termination on malformed input, guaranteeing this loop runs
            // at most `n` iterations.
            if st["pos"] <= p
                st["pos"] = p + 1
    return result

// toml_get: dotted-path lookup ("database.port") into a parsed dict; "" if
// any segment along the path is missing or not a dict.
fn toml_get(config: dict, path: string) -> any
    let segs = split(path, ".")
    let node = config
    let result: any = ""
    let ok = 1
    for seg in segs
        if ok == 1
            if type_of(node) == "dict" and contains(node, seg)
                node = node[seg]
            else
                ok = 0
    if ok == 1
        result = node
    return result
