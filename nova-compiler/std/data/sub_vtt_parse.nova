// ============================================================================
// NOVA Standard Library — std/data/sub_vtt_parse
// ============================================================================
// WebVTT subtitle parser.
//
// PUBLIC API:
//   vtt_parse(text) -> list
//     Parse a WebVTT document into a list of cue dicts.
//     Each cue: {"index":int,"start":ms_int,"end":ms_int,"text":string}
//     Skips the "WEBVTT" header line and any NOTE blocks.
//     Normalises CRLF to LF before processing.
//     Blank lines separate cue blocks.
//
//   vtt_has_header(text) -> bool (1/0)
//     Returns 1 if the text begins with "WEBVTT", 0 otherwise.
//
// TIMECODE FORMAT: "HH:MM:SS.mmm"  (dot separator)
//   ms = h*3600000 + m*60000 + s*1000 + mmm
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - Inline timecode helper (_vtt_tc_to_ms).
//   - Single-exit style to avoid NOVA return-null mistag.
//   - No module-level constants (would truncate).
//   - No multi-line list/dict literals.
//   - Uses 'and'/'or'/'not' (not &&/||/!).
// ============================================================================

// ── Private: BOM + CRLF normalisation ────────────────────────────────────────
// Byte-indexed (str_to_bytes/bytes_get, O(1) random access) and accumulates
// via buffer()/buf_append_char (O(1)-amortized append), so both helpers are
// O(n) over the whole document. A per-character loop using text[i] + string
// concatenation (`clean = clean + ch`) would be O(n^2): the `[]` string
// index re-scans via strlen() on every call, and string concatenation
// re-copies the accumulated prefix on every call — an ordinary multi-hundred-
// KB WebVTT file (a feature-length movie easily has 1-2k cues) would already
// be unacceptably slow under that pattern.

// Strip a leading UTF-8 BOM (bytes 0xEF,0xBB,0xBF), if present. Common in
// VTT files saved by Windows editors; left unstripped it breaks the
// "WEBVTT" header match (vtt_has_header / the header-skip state machine).
fn _vtt_strip_bom(text) -> string
    let result = text
    if len(text) >= 3
        if ord(slice(text, 0, 1)) == 239 and ord(slice(text, 1, 2)) == 187 and ord(slice(text, 2, 3)) == 191
            result = slice(text, 3, len(text))
    result

// Remove all CR (13) bytes from text, normalising CRLF and lone-CR line
// endings to LF-only. O(n): single byte-indexed scan, buffer()-accumulated.
fn _vtt_normalize_crlf(text) -> string
    let bts = str_to_bytes(text)
    let n = bytes_len(bts)
    let out = buffer()
    for i in 0..n
        let b = bytes_get(bts, i)
        if b != 13
            buf_append_char(out, b)
    buf_to_str(out)

// ── Private: timecode "HH:MM:SS.mmm" -> milliseconds ────────────────────────
// Splits on ':' and '.' to extract h, m, s, ms.

fn _vtt_tc_to_ms(tc) -> int
    // tc = "HH:MM:SS.mmm"
    // Find first ':' -> hours
    let i = 0
    let n = len(tc)
    let h = 0
    let m = 0
    let s = 0
    let ms = 0
    // parse hours (up to first ':')
    let colon1 = 0
    let k = 0
    while k < n
        if ord(tc[k]) == 58
            colon1 = k
            k = n
        k = k + 1
    let hstr = slice(tc, 0, colon1)
    h = int(hstr)
    // parse minutes (from colon1+1 to next ':')
    let colon2 = 0
    k = colon1 + 1
    while k < n
        if ord(tc[k]) == 58
            colon2 = k
            k = n
        k = k + 1
    let mstr = slice(tc, colon1 + 1, colon2)
    m = int(mstr)
    // parse seconds (from colon2+1 to '.')
    let dot1 = 0
    k = colon2 + 1
    while k < n
        if ord(tc[k]) == 46
            dot1 = k
            k = n
        k = k + 1
    let sstr = slice(tc, colon2 + 1, dot1)
    s = int(sstr)
    // parse milliseconds (after '.')
    let msstr = slice(tc, dot1 + 1, n)
    ms = int(msstr)
    h * 3600000 + m * 60000 + s * 1000 + ms

// ── Private: check if a line is a timecode arrow line "... --> ..." ──────────

fn _vtt_is_timing(line) -> int
    // Look for " --> " in the line
    let n = len(line)
    let found = 0
    let i = 0
    while i < n - 4
        if slice(line, i, i + 5) == " --> "
            found = 1
            i = n
        i = i + 1
    found

// ── Private: parse one timing line into start/end ms via a 2-element list ───
// Returns [start_ms, end_ms].

fn _vtt_parse_timing(line) -> list
    // Find " --> "
    let n = len(line)
    let arrow = 0
    let i = 0
    while i < n - 4
        if slice(line, i, i + 5) == " --> "
            arrow = i
            i = n
        i = i + 1
    let start_tc = slice(line, 0, arrow)
    // end timecode starts after " --> " (5 chars); may have trailing style info
    // take only up to first space after end timecode (or end of string)
    let end_start = arrow + 5
    let end_end = n
    let j = end_start
    while j < n
        if ord(line[j]) == 32
            end_end = j
            j = n
        j = j + 1
    let end_tc = slice(line, end_start, end_end)
    let sms = _vtt_tc_to_ms(start_tc)
    let ems = _vtt_tc_to_ms(end_tc)
    let r = [sms, ems]
    r

// ── Public: vtt_has_header ────────────────────────────────────────────────────

fn vtt_has_header(text) -> int
    let clean = _vtt_strip_bom(text)
    let result = 0
    if len(clean) >= 6
        if slice(clean, 0, 6) == "WEBVTT"
            result = 1
    result

// ── Public: vtt_parse ────────────────────────────────────────────────────────

fn vtt_parse(text) -> list
    let cues = []
    let nl = chr(10)
    // Strip BOM, then normalise CRLF: remove all chr(13). O(n) — see the
    // normalisation note above _vtt_strip_bom.
    let clean = _vtt_normalize_crlf(_vtt_strip_bom(text))
    // Split into lines
    let lines = split(clean, nl)
    let nlines = len(lines)
    // A state machine (below) walks the lines: it finds the blank line that
    // ends the "WEBVTT" header block, then alternates between a timing line
    // and the cue's text lines.
    let cue_idx = 0
    let state = 0
    // state 0: looking for timing line (or "NOTE" to skip)
    // state 1: collecting text lines for current cue
    let cur_start = 0
    let cur_end = 0
    let cur_text = ""
    let in_note = 0
    let li = 0
    // Find blank line after header first
    let header_done = 0
    while li < nlines
        let line = lines[li]
        if header_done == 0
            if len(line) == 0
                header_done = 1
        else
            if in_note == 1
                if len(line) == 0
                    in_note = 0
            else
                if state == 0
                    if len(line) >= 4
                        if slice(line, 0, 4) == "NOTE"
                            in_note = 1
                    if _vtt_is_timing(line) == 1
                        let times = _vtt_parse_timing(line)
                        cur_start = times[0]
                        cur_end = times[1]
                        cur_text = ""
                        state = 1
                else
                    // state == 1: collecting text
                    if len(line) == 0
                        // blank line ends cue
                        cue_idx = cue_idx + 1
                        let cue = {}
                        cue["index"] = cue_idx
                        cue["start"] = cur_start
                        cue["end"] = cur_end
                        cue["text"] = cur_text
                        cues.push(cue)
                        state = 0
                    else
                        if len(cur_text) == 0
                            cur_text = line
                        else
                            cur_text = cur_text + nl + line
        li = li + 1
    // Flush last cue if file doesn't end with blank line
    if state == 1
        cue_idx = cue_idx + 1
        let last_cue = {}
        last_cue["index"] = cue_idx
        last_cue["start"] = cur_start
        last_cue["end"] = cur_end
        last_cue["text"] = cur_text
        cues.push(last_cue)
    cues
