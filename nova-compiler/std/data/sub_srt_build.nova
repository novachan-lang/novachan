// ============================================================================
// NOVA Standard Library — std/data/sub_srt_build
// ============================================================================
// SRT subtitle builder.
//
// PUBLIC API:
//   srt_build_cue(cue) -> string
//     Render a single cue dict {"index":int,"start":int,"end":int,"text":str}
//     to its SRT block (ends with a blank line: two chr(10)).
//
//   srt_build(cues) -> string
//     Render a list of cue dicts to a complete SRT document string.
//     Cues are separated by blank lines (each block ends with chr(10)+chr(10)).
//
// DESIGN NOTES:
//   - LEAF module — imports nothing (timecode formatting inlined).
//   - Single-exit style throughout.
//   - Timecode separator is comma for SRT: "HH:MM:SS,mmm".
// ============================================================================

// ── Inlined timecode helpers ─────────────────────────────────────────────────

// Zero-pad integer to exactly 2 digits.
fn _sb_pad2(n) -> string
    let s = str(n)
    let result = s
    if len(s) < 2
        result = "0" + s
    result

// Zero-pad integer to exactly 3 digits.
fn _sb_pad3(n) -> string
    let s = str(n)
    let result = s
    if len(s) == 1
        result = "00" + s
    if len(s) == 2
        result = "0" + s
    result

// Decompose ms into [h, m, s, millis].
fn _sb_ms_to_hms(ms) -> list
    let total_s = ms / 1000
    let millis = ms - total_s * 1000
    let h = total_s / 3600
    let rem = total_s - h * 3600
    let m = rem / 60
    let s = rem - m * 60
    let parts = []
    parts.push(h)
    parts.push(m)
    parts.push(s)
    parts.push(millis)
    parts

// Format ms as "HH:MM:SS,mmm" (SRT timecode).
fn _sb_format_tc(ms) -> string
    let parts = _sb_ms_to_hms(ms)
    let h = parts[0]
    let m = parts[1]
    let s = parts[2]
    let millis = parts[3]
    _sb_pad2(h) + ":" + _sb_pad2(m) + ":" + _sb_pad2(s) + "," + _sb_pad3(millis)

// ── Public API ───────────────────────────────────────────────────────────────

// srt_build_cue: render one cue dict to its SRT text block.
// Output format:
//   <index>LF
//   <HH:MM:SS,mmm> --> <HH:MM:SS,mmm>LF
//   <text>LF
//   LF
fn srt_build_cue(cue) -> string
    let lf = chr(10)
    let idx = cue["index"]
    let start_ms = cue["start"]
    let end_ms = cue["end"]
    let text = cue["text"]
    let timing = _sb_format_tc(start_ms) + " --> " + _sb_format_tc(end_ms)
    str(idx) + lf + timing + lf + text + lf + lf

// srt_build: render a list of cue dicts to a full SRT document string.
fn srt_build(cues) -> string
    let result = ""
    let n = len(cues)
    let i = 0
    while i < n
        let block = srt_build_cue(cues[i])
        result = result + block
        i = i + 1
    result
