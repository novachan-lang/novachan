// ============================================================================
// NOVA Standard Library — std/data/geojson_build
// ============================================================================
// Build a GeoJSON geometry string from a dict {type, coordinates}.
//
// PUBLIC API
//   geojson_build(geom) -> string
//     geom must be a dict with:
//       "type"        -> string: "Point", "LineString", or "Polygon"
//       "coordinates" -> nested list of floats (matching the type):
//           Point      -> [lon, lat]
//           LineString -> [[lon,lat], ...]
//           Polygon    -> [[[lon,lat], ...], ...]
//
// DESIGN NOTES
//   - LEAF module — imports nothing.
//   - Floats rendered via str() builtin.
//   - chr(34)='"', chr(123)='{', chr(125)='}', chr(91)='[', chr(93)=']'.
//   - Single-exit style throughout.
//   - Float str() may produce e.g. "1" for 1.0 — acceptable for round-trip.
// ============================================================================

// ── Private: render a single float as a string ────────────────────────────────

fn _gb_float_str(f) -> string
    str(f)

// ── Private: render a position [lon, lat] -> "[lon,lat]" ─────────────────────

fn _gb_pos(pos_list) -> string
    let n = len(pos_list)
    let result = "["
    for i in 0..n
        if i > 0
            result += ","
        let fv = pos_list[i]
        let fs = _gb_float_str(fv)
        result += fs
    result + "]"

// ── Private: render a list of positions [[lon,lat],...] ──────────────────────

fn _gb_pos_array(positions) -> string
    let n = len(positions)
    let result = "["
    for i in 0..n
        if i > 0
            result += ","
        let pos = positions[i]
        let ps = _gb_pos(pos)
        result += ps
    result + "]"

// ── Private: render a list of rings [[[lon,lat],...]] ────────────────────────

fn _gb_ring_array(rings) -> string
    let n = len(rings)
    let result = "["
    for i in 0..n
        if i > 0
            result += ","
        let ring = rings[i]
        let rs = _gb_pos_array(ring)
        result += rs
    result + "]"

// ── Public: geojson_build ─────────────────────────────────────────────────────

fn geojson_build(geom) -> string
    let q = chr(34)
    let ob = chr(123)
    let cb = chr(125)
    let geom_type = geom["type"]
    let coords = geom["coordinates"]

    let coord_str = ""
    if geom_type == "Point"
        coord_str = _gb_pos(coords)
    else if geom_type == "LineString"
        coord_str = _gb_pos_array(coords)
    else if geom_type == "Polygon"
        coord_str = _gb_ring_array(coords)
    else
        // Fallback: render as flat position
        coord_str = _gb_pos(coords)

    let type_kv = q + "type" + q + ":" + q + geom_type + q
    let coord_kv = q + "coordinates" + q + ":" + coord_str
    ob + type_kv + "," + coord_kv + cb
