// ============================================================================
// NOVA Standard Library — std/data/gpx_parse
// ============================================================================
// Parse GPX (GPS Exchange Format) XML into a list of [lat, lon] float pairs.
//
// PUBLIC API
//   gpx_parse(xml) -> list
//     Returns a list of [lat, lon] float pairs from <trkpt> and <wpt>
//     elements.  Each pair is a two-element list: [lat_float, lon_float].
//     Returns [] for empty or invalid input.
//
// GPX ATTRIBUTE LAYOUT
//   <trkpt lat="1.5" lon="2.5"></trkpt>
//   <wpt   lat="3.0" lon="4.0"/>
//   Both element types produce the same output: [lat, lon].
//
// IMPLEMENTATION NOTES
//   - LEAF module — imports nothing.
//   - All private helpers prefixed _gpxp_ to avoid link collisions.
//   - XML parsing by character-level string search (no DOM required).
//   - Floats extracted with parse_float() builtin (boxes correctly).
//   - chr(34)='"', chr(60)='<', chr(62)='>'
//   - Single-exit style throughout (avoids NOVA return-null mistag bug).
//   - Reserved words NOT used as variable names: match/loop/type/in.
// ============================================================================

// ── Private: find first occurrence of needle in s starting at from ───────────

fn _gpxp_find(s, needle, from)
    let ns = len(s)
    let nn = len(needle)
    let result = 0 - 1
    if nn > 0
        let i = from
        let go = 1
        while go == 1
            if i + nn > ns
                go = 0
            else
                let ok = 1
                let j = 0
                let mgo = 1
                while mgo == 1
                    if j >= nn
                        mgo = 0
                    else
                        if char_at(s, i + j) != char_at(needle, j)
                            ok = 0
                            mgo = 0
                        else
                            j += 1
                if ok == 1
                    result = i
                    go = 0
                else
                    i += 1
    return result

// ── Private: extract value of attribute attr_name from tag_text ──────────────
// e.g. _gpxp_attr('<trkpt lat="1.5" lon="2.5">', "lat") -> "1.5"

fn _gpxp_attr(tag_text, attr_name)
    let dq = chr(34)
    let needle = attr_name + "=" + dq
    let p = _gpxp_find(tag_text, needle, 0)
    let result = ""
    if p >= 0
        let start = p + len(needle)
        let ns = len(tag_text)
        let end_pos = start
        let go = 1
        while go == 1
            if end_pos >= ns
                go = 0
            else
                if char_at(tag_text, end_pos) == dq
                    go = 0
                else
                    end_pos += 1
        result = slice(tag_text, start, end_pos)
    return result

// ── Private: scan xml for the next <trkpt or <wpt tag starting at from ───────
// Returns [tag_end_pos, lat_str, lon_str] or [] if none found.
// tag_end_pos is the position just after '>' of the opening tag.

fn _gpxp_next_point_tag(xml, from)
    let ns = len(xml)
    let trkpt = "<trkpt"
    let wpt = "<wpt"
    let result = []
    let pos = from
    let go = 1
    while go == 1
        // find next '<' from pos
        let p = pos
        let fgo = 1
        while fgo == 1
            if p >= ns
                fgo = 0
            else
                if char_at(xml, p) == "<"
                    fgo = 0
                else
                    p += 1
        if p >= ns
            go = 0
        else
            // check if it's <trkpt or <wpt
            let is_trkpt = 0
            let is_wpt = 0
            // check <trkpt
            let tp = _gpxp_find(xml, trkpt, p)
            if tp == p
                is_trkpt = 1
            if is_trkpt == 0
                let wp = _gpxp_find(xml, wpt, p)
                if wp == p
                    is_wpt = 1
            if is_trkpt == 1 or is_wpt == 1
                // find the closing '>' of this opening tag
                let gt = p + 1
                let ggo = 1
                while ggo == 1
                    if gt >= ns
                        ggo = 0
                    else
                        if char_at(xml, gt) == ">"
                            ggo = 0
                        else
                            gt += 1
                let tag_text = slice(xml, p + 1, gt)
                let lat_str = _gpxp_attr(tag_text, "lat")
                let lon_str = _gpxp_attr(tag_text, "lon")
                let tag_end = gt + 1
                push(result, tag_end)
                push(result, lat_str)
                push(result, lon_str)
                go = 0
            else
                pos = p + 1
    return result

// ── Public: gpx_parse ────────────────────────────────────────────────────────

// gpx_parse: parse a GPX XML string and return a list of [lat, lon] pairs.
// Both <trkpt> and <wpt> elements are included in order of appearance.
fn gpx_parse(xml)
    let points = []
    let ns = len(xml)
    let pos = 0
    let go = 1
    while go == 1
        if pos >= ns
            go = 0
        else
            let info = _gpxp_next_point_tag(xml, pos)
            if len(info) == 0
                go = 0
            else
                let tag_end = info[0]
                let lat_str = info[1]
                let lon_str = info[2]
                if len(lat_str) > 0 and len(lon_str) > 0
                    let lat_f = parse_float(lat_str)
                    let lon_f = parse_float(lon_str)
                    let pair = []
                    push(pair, lat_f)
                    push(pair, lon_f)
                    push(points, pair)
                pos = tag_end
    return points
