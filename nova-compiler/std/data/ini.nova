// ============================================================================
// NOVA Standard Library — std/data/ini
// ============================================================================
// INI config file parser and writer.
//
// INI has no formal standard; this module implements the common denominator
// used across Windows .ini, Python configparser, PHP php.ini, git config,
// and systemd unit files, PLUS the ':' key/value separator (Python
// configparser / Java .properties style):
//
//   - Sections:   [SectionName]        — a line whose first non-ws char is '['
//   - Entries:    key = value          — first '=' OR ':' splits key/value
//                 key : value
//   - Comments:   ; ... to end of line
//                 # ... to end of line
//                 (comments may follow a value on the same line: "quote
//                 tracking" means a ';' or '#' INSIDE a "..." quoted value
//                 does not start a comment)
//   - Blank lines are ignored.
//   - Keys appearing before any [section] header land in the default
//     section, keyed by "" in the returned dict.
//   - Leading/trailing whitespace around keys and values is trimmed.
//   - A value wrapped in double quotes ("...") has the quotes stripped;
//     the inner text (including any leading/trailing spaces the quotes
//     were protecting) is kept verbatim.
//
// PUBLIC API:
//   ini_parse(text: string) -> dict
//     Returns dict { section_name -> dict { key -> value } }, all strings.
//     Pre-header keys live under section "". Duplicate keys within a
//     section: last definition wins.
//
//   ini_write(d: dict) -> string
//     Serializes a parsed-shape dict back to INI text. The default section
//     ("") is emitted first with no [header]. Named sections follow, each
//     preceded by a [name] header line. A value is auto-quoted (wrapped in
//     "...") when writing it unquoted would corrupt a round-trip — i.e. it
//     is empty, or contains a space, ';', or '#'. This makes
//     ini_parse(ini_write(d)) reproduce d's values exactly.
//
// IMPLEMENTATION NOTES — NOVA GOTCHAS:
//   - dict keys are ALWAYS strings; section names are strings.
//   - Multi-line list/dict literals are ILLEGAL — dicts are built incrementally.
//   - chr(10) = LF, chr(13) = CR, chr(9) = TAB, chr(34) = '"'.
//   - contains(dict, key) MUST precede every dict lookup.
//   - '{'/'}' in string literals INTERPOLATE — this module avoids them,
//     using chr(91)/chr(93) for '[' / ']' where needed.
//   - No unroll: all scans are real while-loops over string length.
//   - All scans use str_to_bytes/bytes_get (O(1) random access) and
//     accumulate output via buffer()/buf_append* (O(1)-amortized append) —
//     NEVER char_at() in a loop or `s = s + c` string concatenation. char_at
//     indexes by Unicode CODEPOINT and rescans the string from byte 0 on
//     EVERY call (O(index) per call), so a `while i < n: char_at(s, i)`
//     loop is O(n^2) overall; and nova_rt_str_concat is O(la+lb) with no
//     amortized headroom, so `s = s + c` per character is also O(n^2). Both
//     were audited findings fixed in this module — see AUDIT NOTE below.
//
// AUDIT NOTE (text-parser soundness audit): every character-scanning loop
// in this module previously used char_at(s, i)/i=i+1, and _ini_split_lines
// additionally built each line via `cur = cur + char_at(text, i)`. Two real
// bugs followed from that:
//   (a) PATHOLOGICAL BLOWUP — char_at's O(index)-per-call rescan makes any
//       such loop O(n^2); _ini_split_lines' loop spans the WHOLE FILE TEXT
//       (not per-line), so parsing an ordinary few-hundred-KB config file —
//       not even an adversarial one — was already unacceptably slow, and a
//       larger file effectively hangs. Fixed by switching every scan to
//       str_to_bytes/bytes_get (O(1) random byte access) and every
//       accumulation to buffer()/buf_append_char/buf_to_str.
//   (b) SILENT UTF-8 CORRUPTION — char_at indexes by codepoint while len()
//       and slice() index/operate by raw BYTE offset. The module mixed the
//       two: e.g. _ini_trim used len(s) (byte length) as the char_at
//       (codepoint-index) scan bound, and the section-header/separator
//       scans fed a char_at-derived codepoint index straight into
//       byte-offset slice() calls. For INI text containing multi-byte UTF-8
//       (an accented key, a CJK section name, non-ASCII text before a
//       comment/separator/']'), this silently truncated/misplaced the
//       key/value/section-name split — valid input, silently mis-parsed.
//       The byte-based rewrite uses ONE consistent index space (bytes)
//       throughout, matching slice()'s semantics exactly, which eliminates
//       this corruption as a side effect of the same fix.
//   Neither bug required Class-1 recursion (this format is flat/line-based,
//   not recursive-descent — see per-function notes below) nor changed any
//   function's public signature.
//
// LEAF — imports NOTHING.

// ── Private helpers ──────────────────────────────────────────────────────────

// _ini_is_ws: true for space (32) or tab (9). Takes a raw byte value.
fn _ini_is_ws(b) -> int
    if b == 32 or b == 9
        return 1
    return 0

// _ini_trim: remove leading and trailing whitespace (space/tab) from s.
// Single top-level loop, no recursion; byte-indexed (str_to_bytes/bytes_get)
// so it is O(n) even on adversarially long input, and its result offsets
// are byte offsets — consistent with slice()'s byte-offset semantics.
fn _ini_trim(s) -> string
    let bts = str_to_bytes(s)
    let n = bytes_len(bts)
    let st = 0
    while st < n and _ini_is_ws(bytes_get(bts, st)) == 1
        st = st + 1
    let en = n
    while en > st and _ini_is_ws(bytes_get(bts, en - 1)) == 1
        en = en - 1
    if st == 0 and en == n
        return s
    slice(s, st, en)

// _ini_strip_comment: truncate a line at the first ';' or '#' that is NOT
// inside a "..." quoted span. Quote-state is tracked left to right; an odd
// number of quote chars before the comment marker means we are "inside" a
// quote span and the marker is left alone. Single top-level loop, no
// recursion; byte-indexed so this is O(n), and the returned slice index is
// a byte offset (matching slice()'s semantics — see AUDIT NOTE above).
fn _ini_strip_comment(line) -> string
    let bts = str_to_bytes(line)
    let n = bytes_len(bts)
    let i = 0
    let in_quote = 0
    while i < n
        let b = bytes_get(bts, i)
        if b == 34
            if in_quote == 1
                in_quote = 0
            else
                in_quote = 1
        else if in_quote == 0 and (b == 59 or b == 35)
            return slice(line, 0, i)
        i = i + 1
    line

// _ini_index_of_sep: index (byte offset) of the first '=' (61) or ':' (58)
// in s, else -1. Single top-level loop, no recursion; byte-indexed, O(n).
fn _ini_index_of_sep(s) -> int
    let bts = str_to_bytes(s)
    let n = bytes_len(bts)
    for i in 0..n
        let b = bytes_get(bts, i)
        if b == 61 or b == 58
            return i
    return -1

// _ini_unquote: strip a single pair of surrounding double quotes, if present.
// Byte-indexed (see AUDIT NOTE above) — the prior char_at(s, n - 1) used a
// BYTE length n as a CODEPOINT index; for a quoted value containing any
// multi-byte UTF-8 character (e.g. "café") that landed past the last real
// codepoint, char_at returned "" (ord 0), so the closing-quote check never
// matched and the quotes were silently left attached to the value instead
// of being stripped.
fn _ini_unquote(s) -> string
    let bts = str_to_bytes(s)
    let n = bytes_len(bts)
    if n >= 2 and bytes_get(bts, 0) == 34 and bytes_get(bts, n - 1) == 34
        return slice(s, 1, n - 1)
    s

// _ini_needs_quote: true if writing v unquoted would not round-trip cleanly
// (empty value, contains a space/tab, ';', or '#', or has leading/trailing
// whitespace of any kind — the parser trims unquoted values, so any value
// whose first or last byte is a space or tab MUST be quoted or that
// whitespace is silently lost on ini_parse). Single top-level loop, no
// recursion; byte-indexed so this is O(n) and cannot misread a trailing
// byte that follows multi-byte UTF-8 content (see AUDIT NOTE above — the
// prior char_at(v, n-1) used a BYTE length n as a CODEPOINT index, which
// for multi-byte content could land past the last real codepoint and
// silently miss real trailing whitespace).
fn _ini_needs_quote(v) -> int
    let bts = str_to_bytes(v)
    let n = bytes_len(bts)
    if n == 0
        return 1
    let first = bytes_get(bts, 0)
    let last = bytes_get(bts, n - 1)
    if first == 32 or first == 9 or last == 32 or last == 9
        return 1
    for i in 0..n
        let b = bytes_get(bts, i)
        if b == 32 or b == 9 or b == 59 or b == 35
            return 1
    return 0

// _ini_write_value: quote v if needed for a lossless round-trip.
fn _ini_write_value(v) -> string
    if _ini_needs_quote(v) == 1
        chr(34) + v + chr(34)
    else
        v

// _ini_ensure_section: ensure parsed[sec] exists as an inner dict.
fn _ini_ensure_section(parsed, sec)
    if contains(parsed, sec) == 0
        let empty = {}
        parsed[sec] = empty

// _ini_set_key: set key->val inside the inner dict for section sec.
// Assumes _ini_ensure_section(parsed, sec) was already called.
fn _ini_set_key(parsed, sec, key, val)
    let inner = parsed[sec]
    inner[key] = val
    parsed[sec] = inner

// _ini_split_lines: split text into lines, handling LF, CRLF, and lone CR.
// Returned lines do NOT include the line terminator. Single top-level loop
// over the WHOLE file text, no recursion; byte-indexed (str_to_bytes/
// bytes_get) and accumulates each line in a buffer() (O(1)-amortized
// append), so this is O(n) total regardless of file size or line count —
// this was the module's worst offender pre-fix (see AUDIT NOTE above): its
// char_at-based scan spanned the entire input, not just one line, so an
// ordinary multi-hundred-KB config file was already unacceptably slow.
// Copying individual raw bytes (rather than char_at's decoded codepoints)
// still reconstructs multi-byte UTF-8 sequences byte-for-byte, because
// none of LF(10)/CR(13) can appear as a UTF-8 continuation or lead byte
// (those are always >= 0x80).
fn _ini_split_lines(text) -> list
    let lines = []
    let bts = str_to_bytes(text)
    let n = bytes_len(bts)
    let i = 0
    let cur = buffer()
    while i < n
        let b = bytes_get(bts, i)
        if b == 10
            lines.push(buf_to_str(cur))
            cur = buffer()
        else if b == 13
            lines.push(buf_to_str(cur))
            cur = buffer()
            if i + 1 < n and bytes_get(bts, i + 1) == 10
                i = i + 1
        else
            buf_append_char(cur, b)
        i = i + 1
    if buf_len(cur) > 0
        lines.push(buf_to_str(cur))
    lines

// ── Public API ────────────────────────────────────────────────────────────────

// ini_parse: parse INI-format text into a nested dict of
// section-name -> (key -> value), both strings. Pre-header keys are
// stored under section "".
fn ini_parse(text) -> any
    let parsed = {}
    let cur_sec = ""
    let lines = _ini_split_lines(text)
    let li = 0
    let nl = len(lines)
    while li < nl
        let raw = lines[li]
        li = li + 1
        let no_comment = _ini_strip_comment(raw)
        let line = _ini_trim(no_comment)
        if len(line) == 0
            // blank or comment-only line — skip
        else
            // Byte-indexed (see AUDIT NOTE at top of file): a single very
            // long section-header line was previously O(n^2) via char_at,
            // and its char_at-derived codepoint index was fed straight into
            // byte-offset slice() calls below — corrupting multi-byte UTF-8
            // section names. bytes_get is O(1) and its index IS a byte
            // offset, matching slice()'s semantics exactly.
            let lbts = str_to_bytes(line)
            let sn = bytes_len(lbts)
            let c0 = bytes_get(lbts, 0)
            if c0 == 91
                // '[' — section header; find matching ']' (93). Single
                // top-level loop, no recursion — O(n) per line.
                let rbracket = -1
                let si = 1
                while si < sn
                    if bytes_get(lbts, si) == 93
                        rbracket = si
                        si = sn
                    si = si + 1
                let sec_name = ""
                if rbracket == -1
                    sec_name = _ini_trim(slice(line, 1, sn))
                else
                    sec_name = _ini_trim(slice(line, 1, rbracket))
                cur_sec = sec_name
                _ini_ensure_section(parsed, cur_sec)
            else
                let sep = _ini_index_of_sep(line)
                if sep >= 0
                    let key = _ini_trim(slice(line, 0, sep))
                    let raw_val = _ini_trim(slice(line, sep + 1, len(line)))
                    let val = _ini_unquote(raw_val)
                    if len(key) > 0
                        _ini_ensure_section(parsed, cur_sec)
                        _ini_set_key(parsed, cur_sec, key, val)
    parsed

// ini_write: serialize a parsed-shape dict (section -> key -> value) back
// to INI text. Default section "" (if present) is emitted first with no
// header. Values are auto-quoted where needed for a lossless round-trip.
// Accumulates output in a buffer() (O(1)-amortized append) rather than
// repeated `out = out + ...` string concatenation, which is O(entry-count^2)
// — see AUDIT NOTE at top of file (same class of bug as the parse side,
// lower severity since it scales with entry COUNT not character count, but
// the same fix applies for a dict with many entries).
fn ini_write(d) -> string
    let nl = chr(10)
    let out = buffer()
    let first_block = 1
    if contains(d, "") == 1
        let inner = d[""]
        let dk = keys(inner)
        for di in 0..len(dk)
            let k = dk[di]
            buf_append(out, k)
            buf_append(out, "=")
            buf_append(out, _ini_write_value(inner[k]))
            buf_append(out, nl)
        first_block = 0
    let all_secs = keys(d)
    let si = 0
    while si < len(all_secs)
        let sec = all_secs[si]
        si = si + 1
        if sec != ""
            if first_block == 0
                buf_append(out, nl)
            first_block = 0
            buf_append(out, chr(91))
            buf_append(out, sec)
            buf_append(out, chr(93))
            buf_append(out, nl)
            let inner = d[sec]
            let sk = keys(inner)
            for ki in 0..len(sk)
                let k = sk[ki]
                buf_append(out, k)
                buf_append(out, "=")
                buf_append(out, _ini_write_value(inner[k]))
                buf_append(out, nl)
    buf_to_str(out)
