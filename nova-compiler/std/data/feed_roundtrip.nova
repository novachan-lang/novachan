// ============================================================================
// NOVA Standard Library — std/data/feed_roundtrip
// ============================================================================
// Feed dispatch and detection — handle RSS, Atom, and OPML feeds uniformly.
//
// PUBLIC API
//   detect_feed_type(xml) -> string
//     Returns "rss", "atom", "opml", or "unknown".
//     Detection by string search for characteristic root element markers:
//       "<rss"     → "rss"
//       "<feed "   or "<feed>" or "<feed\n" (Atom) → "atom"
//       "<opml"    → "opml"
//       otherwise  → "unknown"
//
//   feed_parse(xml) -> dict
//     Detect format and parse to a dict with a "type" field added:
//       RSS:  {"type": "rss",  "title": ..., "link": ..., "items": [...]}
//       Atom: {"type": "atom", "title": ..., "entries": [...]}
//       OPML: {"type": "opml", "title": ..., "outlines": [...]}
//       unknown: {"type": "unknown"}
//
//   feed_titles(xml) -> list
//     Returns a list of title strings for all items/entries regardless of format.
//     For RSS:  the "title" field of each item in feed["items"]
//     For Atom: the "title" field of each entry in feed["entries"]
//     For OPML: the "text" field of each top-level outline
//     For unknown: empty list
//
// EXAMPLES
//   detect_feed_type("<rss>...</rss>")             → "rss"
//   detect_feed_type("<feed xmlns=...>...</feed>") → "atom"
//   detect_feed_type("<opml>...</opml>")           → "opml"
//   detect_feed_type("<html>...</html>")           → "unknown"
//   feed_titles(rss_xml)   → ["Item 1", "Item 2"]
//   feed_titles(atom_xml)  → ["Entry 1", "Entry 2"]
//
// IMPLEMENTATION NOTES
//   • Imports rss_parse, atom_parse, opml_parse.
//   • All private helpers prefixed _frt_ to avoid link collisions.
//   • Uses string search (contains builtin or manual) for detection.
//   • Single-exit style throughout.
// ============================================================================

import std/data/rss_parse
import std/data/atom_parse
import std/data/opml_parse

// ── Private: check if s contains needle (returns 1 or 0) ─────────────────────

fn _frt_has(s, needle)
    let ns = len(s)
    let nn = len(needle)
    let result = 0
    if nn > 0
        let i = 0
        let go = 1
        while go == 1
            if i + nn > ns
                go = 0
            else
                let match_ok = 1
                let j = 0
                let mgo = 1
                while mgo == 1
                    if j >= nn
                        mgo = 0
                    else
                        if char_at(s, i + j) != char_at(needle, j)
                            match_ok = 0
                            mgo = 0
                        else
                            j += 1
                if match_ok == 1
                    result = 1
                    go = 0
                else
                    i += 1
    return result

// ── Public: detect_feed_type ─────────────────────────────────────────────────

// detect_feed_type: determine the feed type from raw XML content.
//
// Detection priority: rss > atom > opml > unknown.
// Atom feeds may have various namespace declarations so we check for
// both "<feed " (with space) and "<feed>" (bare) and "<feed\n".
fn detect_feed_type(xml)
    let result = "unknown"
    // Atom detection: <feed with space, >, or newline following
    if _frt_has(xml, "<rss") == 1
        result = "rss"
    else if _frt_has(xml, "<feed ") == 1 or _frt_has(xml, "<feed>") == 1 or _frt_has(xml, "<feed" + chr(10)) == 1
        result = "atom"
    else if _frt_has(xml, "<opml") == 1
        result = "opml"
    return result

// ── Public: feed_parse ───────────────────────────────────────────────────────

// feed_parse: parse a feed XML string into a typed dict.
//
// Returns a dict with a "type" key and format-specific fields.
fn feed_parse(xml)
    let ftype = detect_feed_type(xml)
    let result = {}
    if ftype == "rss"
        let rss = rss_parse(xml)
        result["type"] = "rss"
        result["title"] = rss["title"]
        result["link"] = rss["link"]
        result["description"] = rss["description"]
        result["items"] = rss["items"]
    else if ftype == "atom"
        let atom = atom_parse(xml)
        result["type"] = "atom"
        result["title"] = atom["title"]
        result["entries"] = atom["entries"]
    else if ftype == "opml"
        let opml = opml_parse(xml)
        result["type"] = "opml"
        result["title"] = opml["title"]
        result["outlines"] = opml["outlines"]
    else
        result["type"] = "unknown"
    return result

// ── Public: feed_titles ───────────────────────────────────────────────────────

// feed_titles: extract a flat list of item/entry titles from any feed format.
//
// RSS:  returns item "title" from each item in feed["items"]
// Atom: returns entry "title" from each entry in feed["entries"]
// OPML: returns top-level outline "text" fields
// unknown: returns empty list
fn feed_titles(xml)
    let ftype = detect_feed_type(xml)
    let titles = []
    if ftype == "rss"
        let rss = rss_parse(xml)
        titles = [it["title"] for it in rss["items"]]
    else if ftype == "atom"
        let atom = atom_parse(xml)
        titles = [e["title"] for e in atom["entries"]]
    else if ftype == "opml"
        let opml = opml_parse(xml)
        titles = [o["text"] for o in opml["outlines"]]
    return titles
