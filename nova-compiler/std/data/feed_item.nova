// ============================================================================
// NOVA Standard Library — std/data/feed_item
// ============================================================================
// Unified accessors over parsed feed item dicts.
// Works for both RSS 2.0 item dicts (from rss_parse) and Atom entry dicts
// (from atom_parse) without requiring either module as a dependency.
//
// PUBLIC API:
//   item_title(item)   -> string   — "title" field (RSS + Atom)
//   item_link(item)    -> string   — "link"  field (RSS + Atom)
//   item_date(item)    -> string   — "pubDate" (RSS) or "updated" (Atom)
//   item_summary(item) -> string   — "description" (RSS) or "summary" (Atom)
//   normalize_item(item) -> dict   — common shape:
//                                      { "title", "link", "date", "summary" }
//
// DESIGN NOTES:
//   - LEAF module — imports nothing (works standalone, no sibling deps).
//   - RSS uses  "pubDate"     for date,    "description" for body text.
//   - Atom uses "updated"     for date,    "summary"     for body text.
//   - Missing keys return "" (dict missing-key = 0 in NOVA; guarded via
//     contains()).
// ============================================================================

// ── Private helper ───────────────────────────────────────────────────────────

// Safe string read from a dict.  Returns the value if key is present and
// is a string, otherwise returns dflt.
fn _fi_get(d, key, dflt) -> string
    let result = dflt
    if key in d
        let v = d[key]
        if type_of(v) == "string"
            result = v
    result

// ── Public API ───────────────────────────────────────────────────────────────

// item_title: return the title of a feed item (RSS or Atom).
fn item_title(item) -> string
    _fi_get(item, "title", "")

// item_link: return the link/URL of a feed item (RSS or Atom).
fn item_link(item) -> string
    _fi_get(item, "link", "")

// item_date: return the date string of a feed item.
//   RSS:  "pubDate" field
//   Atom: "updated" field
// Returns whichever is present (pubDate first, then updated, then "").
fn item_date(item) -> string
    let result = ""
    if "pubDate" in item
        let v = item["pubDate"]
        if type_of(v) == "string" and len(v) > 0
            result = v
    if len(result) == 0 and "updated" in item
        let v2 = item["updated"]
        if type_of(v2) == "string"
            result = v2
    result

// item_summary: return the body/summary text of a feed item.
//   RSS:  "description" field
//   Atom: "summary"     field
// Returns whichever is present (description first, then summary, then "").
fn item_summary(item) -> string
    let result = ""
    if "description" in item
        let v = item["description"]
        if type_of(v) == "string" and len(v) > 0
            result = v
    if len(result) == 0 and "summary" in item
        let v2 = item["summary"]
        if type_of(v2) == "string"
            result = v2
    result

// normalize_item: map a raw RSS item or Atom entry dict to a common shape:
//   { "title", "link", "date", "summary" }
// The resulting dict always has all four keys (empty string if missing).
fn normalize_item(item) -> dict
    {"title": item_title(item), "link": item_link(item), "date": item_date(item), "summary": item_summary(item)}
