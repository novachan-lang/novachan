// ============================================================================
// NOVA Standard Library — std/data/msgpack
// ============================================================================
// MessagePack (https://msgpack.org) binary serialization format.
//
// MessagePack encodes structured data into a compact binary format.  It is
// more space-efficient than JSON and avoids the UTF-8-string-only restriction
// that makes CBOR complex.  NOVA strings are used for string values; all
// other NOVA values (int, bool, null, list, dict) map cleanly.
//
// PUBLIC API
//   mp_encode(v)             -> bytes   encode any NOVA value to MsgPack bytes
//   mp_decode(b)             -> Result  Ok(value) iff b holds EXACTLY one
//                                        well-formed MessagePack value (any
//                                        legitimate decoded value, including
//                                        one that happens to be null/0/"");
//                                        Err(message) for empty/truncated/
//                                        malformed/unrecognized-format-byte
//                                        input, or trailing bytes after the
//                                        value — see SOUNDNESS AUDIT below.
//   mp_decode_at(b, pos)     -> list    [decoded_value, next_pos] (for
//                                        streaming multiple concatenated
//                                        values). On malformed/truncated
//                                        input at pos, returns [null, pos]
//                                        (next_pos == pos, i.e. NO progress)
//                                        — collision-free because every
//                                        successful decode strictly advances
//                                        next_pos > pos. Callers MUST check
//                                        for next_pos == pos before trusting
//                                        the decoded value.
//
// SOUNDNESS AUDIT (decoder hardening — see mp_decode_at/mp_decode below).
// Before this revision, mp_decode_at performed ZERO bounds checking: every
// length-prefixed read (fixstr, str8, uint8/16/32/64) trusted the declared
// length against the buffer with no validation, and an unrecognized/
// unsupported format byte (e.g. bin/ext/float32/float64/int8-16-32-64
// signed/str16/str32/array16/array32/map16/map32/reserved 0xc1 — all
// UNIMPLEMENTED by this module) silently decoded as nil (0xc0) and advanced
// only 1 byte. Because the runtime's bytes_get clamps out-of-range reads to
// 0 rather than trapping, a truncated or hostile buffer never crashed — it
// silently produced a WRONG, zero-padded/misaligned value that mp_decode
// returned as if it were a valid decode, and a malformed/unknown-format
// buffer was INDISTINGUISHABLE from a legitimately encoded nil (a
// class-2/class-4 collision: decode-error vs. legitimate-null and
// truncation-as-success). mp_decode_at now bounds-checks every
// length-prefixed read using the overflow-safe form `len > n - pos` (never
// `pos + len > n`, which can wrap negative for an attacker-controlled len
// near 2^63-1 and silently bypass the check), rejects any unrecognized
// format byte, and propagates rejection through recursive fixarray/fixmap
// elements. mp_decode additionally verifies the ENTIRE buffer was consumed
// (rejects trailing content) and returns NOVA's native Result so a decode
// failure can never be confused with a legitimately decoded value.
//
// SUPPORTED TYPES (encode + decode)
//   null       -> 0xc0  (nil)
//   false      -> 0xc2  (false)
//   true       -> 0xc3  (true)
//   int 0..127 -> fixint  (positive fixint 0x00..0x7f)
//   int -32..-1-> negative fixint 0xe0..(0xff) i.e. 0xe0 | (v & 0x1f)
//   int 128..255       -> uint8  (0xcc, 1 byte)
//   int 256..65535     -> uint16 (0xcd, 2 bytes big-endian)
//   int 65536..4294967295 -> uint32 (0xce, 4 bytes big-endian)
//   int >4294967295    -> uint64 (0xcf, 8 bytes big-endian)
//   string len<32 -> fixstr (0xa0|len, then UTF-8 bytes)
//   string len>=32 -> str8  (0xd9, 1-byte len, then UTF-8 bytes)
//   list  len<16  -> fixarray (0x90|len, then elements)
//   dict  len<16  -> fixmap  (0x80|len, then alternating key bytes + value bytes)
//     (dict keys are serialised as strings; keys() order is used)
//
// KNOWN-ANSWER TESTS (see _msgpack_test.nova, _kat_msgpack_audit.nova):
//   mp_encode(1)    -> first byte == 1   (positive fixint)
//   mp_encode(127)  -> first byte == 127 (positive fixint, upper edge)
//   mp_encode(-1)   -> first byte == 255 (0xff = 0xe0 | 0x1f negative fixint)
//   mp_encode("a")  -> [161, 97]         (fixstr len=1, then 'a'=97)
//   mp_encode([1,2,3]) -> [147, 1, 2, 3] (fixarray len=3, elements)
//   match mp_decode(mp_encode("hello")): Ok(v) => v == "hello"
//   match mp_decode(mp_encode([1,2,3])): Ok(v) => v == [1,2,3]
//   let d={}; d["x"]=1
//   match mp_decode(mp_encode(d)): Ok(v) => v["x"] == 1
//   mp_decode(bytes(0)) is Err (empty buffer, was silently 0 pre-fix)
//   mp_decode(mp_encode(1) + <extra byte>) is Err (trailing content)
//
// IMPLEMENTATION NOTES
//   • All private helpers prefixed _mp_ to avoid link collisions.
//   • bytes_append returns a NEW bytes value — always reassign.
//   • str_to_bytes(s) converts a NOVA string to its UTF-8 byte sequence.
//   • NOVA integer division: / truncates toward zero.
//   • >> is arithmetic (sign-extending) — mask results with & 0xFF etc.
//   • Single-exit style to avoid the NOVA early-return mistag bug.
//   • chr(123)='{', chr(125)='}' guard — no bare braces in string literals.
//   • LEAF module — imports nothing.
// ============================================================================

// ── Private: write a big-endian uint16 (2 bytes) ────────────────────────────
fn _mp_put_u16(b, v)
    let out = b
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// ── Private: write a big-endian uint32 (4 bytes) ────────────────────────────
fn _mp_put_u32(b, v)
    let out = b
    out = bytes_append(out, (v >> 24) & 0xFF)
    out = bytes_append(out, (v >> 16) & 0xFF)
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// ── Private: write a big-endian uint64 (8 bytes) ────────────────────────────
fn _mp_put_u64(b, v)
    let out = b
    out = bytes_append(out, (v >> 56) & 0xFF)
    out = bytes_append(out, (v >> 48) & 0xFF)
    out = bytes_append(out, (v >> 40) & 0xFF)
    out = bytes_append(out, (v >> 32) & 0xFF)
    out = bytes_append(out, (v >> 24) & 0xFF)
    out = bytes_append(out, (v >> 16) & 0xFF)
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// ── Private: encode an integer value into b ─────────────────────────────────
fn _mp_enc_int(b, v)
    let out = b
    if v >= 0 and v <= 127
        // positive fixint: 0x00..0x7f
        out = bytes_append(out, v)
    else if v >= -32 and v < 0
        // negative fixint: 0xe0..(0xff)
        out = bytes_append(out, 0xe0 | (v & 0x1f))
    else if v >= 128 and v <= 255
        // uint8: 0xcc + 1 byte
        out = bytes_append(out, 0xcc)
        out = bytes_append(out, v & 0xFF)
    else if v >= 256 and v <= 65535
        // uint16: 0xcd + 2 bytes big-endian
        out = bytes_append(out, 0xcd)
        out = _mp_put_u16(out, v)
    else if v >= 65536 and v <= 4294967295
        // uint32: 0xce + 4 bytes big-endian
        out = bytes_append(out, 0xce)
        out = _mp_put_u32(out, v)
    else
        // uint64: 0xcf + 8 bytes big-endian
        out = bytes_append(out, 0xcf)
        out = _mp_put_u64(out, v)
    out

// ── Private: encode a string into b ─────────────────────────────────────────
fn _mp_enc_str(b, s)
    let out = b
    let slen = len(s)
    let sbytes = str_to_bytes(s)
    if slen < 32
        // fixstr: 0xa0 | len, then bytes
        out = bytes_append(out, 0xa0 | slen)
    else
        // str8: 0xd9, 1-byte length, then bytes
        out = bytes_append(out, 0xd9)
        out = bytes_append(out, slen & 0xFF)
    // append string bytes
    for i in 0..slen
        let sb = bytes_get(sbytes, i)
        out = bytes_append(out, sb)
    out

// ── Private: encode a list into b ───────────────────────────────────────────
fn _mp_enc_list(b, lst)
    let out = b
    let n = len(lst)
    // fixarray: 0x90 | len (for len < 16)
    out = bytes_append(out, 0x90 | (n & 0x0f))
    for i in 0..n
        let elem = lst[i]
        out = mp_encode_into(out, elem)
    out

// ── Private: encode a dict into b ───────────────────────────────────────────
fn _mp_enc_dict(b, d)
    let out = b
    let ks = keys(d)
    let n = len(ks)
    // fixmap: 0x80 | len (for len < 16)
    out = bytes_append(out, 0x80 | (n & 0x0f))
    for i in 0..n
        let k = ks[i]
        // encode key as string
        out = _mp_enc_str(out, k)
        // encode value
        let val = d[k]
        out = mp_encode_into(out, val)
    out

// ── Private: encode any value v into existing bytes b ───────────────────────
// This is the workhorse recursive helper called by the list/dict encoders.
fn mp_encode_into(b, v)
    let out = b
    if v == null
        out = bytes_append(out, 0xc0)
    else
        if type_of(v) == "int"
            // Check for bool: true==1, false==0 in NOVA type_of, but they are
            // still type "int".  We detect them by checking v==0 or v==1 and
            // the original literal — however NOVA has no is_bool builtin.
            // Encode plain int; the KAT for bool is not in the spec, so
            // we follow the conservative path: true/false encode as 0xc3/0xc2
            // only when the caller explicitly passes them — here they arrive as
            // int 1/0 which we cannot distinguish from the integer 1/0.
            // The spec says: "bool false->0xc2 true->0xc3" but NOVA type_of(true)=="int"
            // and true==1, false==0.  Without an is_bool native there is no way to
            // distinguish them in a generic encoder receiving an `any` argument.
            // We therefore encode integers; callers who need explicit bool tags
            // must use mp_encode_bool.
            out = _mp_enc_int(out, v)
        else if is_string(v)
            out = _mp_enc_str(out, v)
        else if is_list(v)
            out = _mp_enc_list(out, v)
        else if is_dict(v)
            out = _mp_enc_dict(out, v)
        else
            // Fallback: encode as nil for unknown types
            out = bytes_append(out, 0xc0)
    out

// ── mp_encode ────────────────────────────────────────────────────────────────
// Encode any NOVA value to a MsgPack bytes value.
// Supported: null, int (includes bool), string, list, dict.
fn mp_encode(v) -> any
    let out = bytes(0)
    mp_encode_into(out, v)

// ── Private: read a big-endian uint16 from bytes b at offset pos ─────────────
fn _mp_read_u16(b, pos)
    let hi = bytes_get(b, pos)
    let lo = bytes_get(b, pos + 1)
    (hi * 256) + lo

// ── Private: read a big-endian uint32 from bytes b at offset pos ─────────────
fn _mp_read_u32(b, pos)
    let b0 = bytes_get(b, pos)
    let b1 = bytes_get(b, pos + 1)
    let b2 = bytes_get(b, pos + 2)
    let b3 = bytes_get(b, pos + 3)
    ((b0 * 16777216) + (b1 * 65536)) + ((b2 * 256) + b3)

// ── Private: read a big-endian uint64 from bytes b at offset pos ─────────────
fn _mp_read_u64(b, pos)
    let hi = _mp_read_u32(b, pos)
    let lo = _mp_read_u32(b, pos + 4)
    hi * 4294967296 + lo

// ── Private: read `slen` UTF-8 bytes from b at pos, return as string ─────────
fn _mp_read_str(b, pos, slen)
    let s_parts = []
    for i in 0..slen
        push(s_parts, chr(bytes_get(b, pos + i)))
    let s = join(s_parts, "")
    s

// ── mp_decode_at ─────────────────────────────────────────────────────────────
// Decode one MsgPack value from bytes b starting at byte offset pos.
// Returns a list: [decoded_value, next_pos].
// This is the streaming/recursive primitive; mp_decode wraps it.
//
// Hardened (see SOUNDNESS AUDIT in the module header): every length-prefixed
// read is bounds-checked against the buffer's actual remaining length BEFORE
// it is performed, using the overflow-safe form `len > n - pos` for
// variable (attacker-controlled) lengths and a constant addend (`pos + K >
// n`) for fixed-size payloads — never the unsafe `pos + len > n`, which can
// wrap negative and silently bypass the check. On ANY bounds violation, or
// an unrecognized/unsupported format byte, this function REJECTS by
// returning next_pos == pos (no progress) instead of a value — this is
// collision-free (every successful decode strictly advances next_pos > pos)
// and matches the same "stall means reject" idiom std/data/asn1_bool.nova
// and std/data/asn1_length.nova already use for this exact
// [value, next_pos] shape. The recursive fixarray/fixmap branches check
// every child's next_pos for a stall and immediately propagate the
// rejection to their own caller (rather than continuing to decode sibling
// elements past malformed data, or returning a partially-built container).
fn mp_decode_at(b, pos) -> any
    let n = bytes_len(b)
    let result = null
    let next = pos
    let bad = 0
    if pos < 0 or pos >= n
        // No byte available at pos: empty or truncated input.
        bad = 1
    else
        let byte0 = bytes_get(b, pos)
        next = pos + 1
        // Positive fixint: 0x00..0x7f
        if byte0 >= 0 and byte0 <= 127
            result = byte0
        else
            // Negative fixint: 0xe0..0xff
            if byte0 >= 224
                // Decode as signed: 0xe0..0xff -> -32..-1
                result = byte0 - 256
            else
                // fixstr: 0xa0..0xbf
                if byte0 >= 160 and byte0 <= 191
                    let slen = byte0 - 160
                    if slen > n - next
                        bad = 1
                    else
                        result = _mp_read_str(b, next, slen)
                        next += slen
                else
                    // fixarray: 0x90..0x9f
                    if byte0 >= 144 and byte0 <= 159
                        let alen = byte0 - 144
                        let lst = []
                        let cur = next
                        let ai = 0
                        while ai < alen and bad == 0
                            let sub = mp_decode_at(b, cur)
                            let subnext = sub[1]
                            if subnext == cur
                                // element decode made no progress -> reject
                                bad = 1
                            else
                                lst.push(sub[0])
                                cur = subnext
                            ai += 1
                        if bad == 0
                            result = lst
                            next = cur
                    else
                        // fixmap: 0x80..0x8f
                        if byte0 >= 128 and byte0 <= 143
                            let mlen = byte0 - 128
                            let d = {}
                            let cur = next
                            let mi = 0
                            while mi < mlen and bad == 0
                                let ksub = mp_decode_at(b, cur)
                                let kcur = ksub[1]
                                if kcur == cur
                                    bad = 1
                                else
                                    let kval = ksub[0]
                                    let vsub = mp_decode_at(b, kcur)
                                    let vcur = vsub[1]
                                    if vcur == kcur
                                        bad = 1
                                    else
                                        let vval = vsub[0]
                                        d[kval] = vval
                                        cur = vcur
                                mi += 1
                            if bad == 0
                                result = d
                                next = cur
                        else
                            // nil: 0xc0
                            if byte0 == 192
                                result = null
                            else
                                // false: 0xc2
                                if byte0 == 194
                                    result = 0
                                else
                                    // true: 0xc3
                                    if byte0 == 195
                                        result = 1
                                    else
                                        // uint8: 0xcc (constant addend pos+2 is overflow-safe)
                                        if byte0 == 204
                                            if pos + 2 > n
                                                bad = 1
                                            else
                                                result = bytes_get(b, next)
                                                next += 1
                                        else
                                            // uint16: 0xcd (constant addend pos+3 is overflow-safe)
                                            if byte0 == 205
                                                if pos + 3 > n
                                                    bad = 1
                                                else
                                                    result = _mp_read_u16(b, next)
                                                    next += 2
                                            else
                                                // uint32: 0xce (constant addend pos+5 is overflow-safe)
                                                if byte0 == 206
                                                    if pos + 5 > n
                                                        bad = 1
                                                    else
                                                        result = _mp_read_u32(b, next)
                                                        next += 4
                                                else
                                                    // uint64: 0xcf (constant addend pos+9 is overflow-safe)
                                                    if byte0 == 207
                                                        if pos + 9 > n
                                                            bad = 1
                                                        else
                                                            result = _mp_read_u64(b, next)
                                                            next += 8
                                                    else
                                                        // str8: 0xd9
                                                        if byte0 == 217
                                                            // length byte itself: constant addend, overflow-safe
                                                            if pos + 2 > n
                                                                bad = 1
                                                            else
                                                                let slen2 = bytes_get(b, next)
                                                                let sp = next + 1
                                                                if slen2 > n - sp
                                                                    bad = 1
                                                                else
                                                                    result = _mp_read_str(b, sp, slen2)
                                                                    next = sp + slen2
                                                        else
                                                            // Unrecognized/unsupported format byte: bin8/16/32,
                                                            // ext8/16/32, float32/64, int8/16/32/64 (signed),
                                                            // fixext1/2/4/8/16, str16/32, array16/32, map16/32,
                                                            // and reserved 0xc1 are all UNIMPLEMENTED by this
                                                            // module's supported subset (see header). REJECT --
                                                            // never silently decode as null-and-advance-by-1,
                                                            // which would be indistinguishable from a
                                                            // legitimately encoded nil (0xc0) and would also
                                                            // desynchronize every sibling/enclosing decode in
                                                            // the same buffer.
                                                            bad = 1
    if bad == 1
        result = null
        next = pos
    let ret = []
    ret.push(result)
    ret.push(next)
    ret

// ── mp_decode ────────────────────────────────────────────────────────────────
// Decode a complete MsgPack-encoded bytes value.
// Returns Result<any,string>: Ok(value) when b holds EXACTLY one
// well-formed MessagePack value (any legitimate decoded value, including
// one that happens to be null/0/"" — see SOUNDNESS AUDIT in the module
// header), Err(message) for an empty buffer, malformed/truncated/
// unrecognized-format-byte input, or trailing bytes after the decoded
// value (b is documented as holding exactly one message; use
// mp_decode_at directly to stream multiple concatenated values from one
// buffer — that is its documented purpose and it is unaffected by this
// trailing-content check).
fn mp_decode(b) -> Result
    let n = bytes_len(b)
    if n == 0
        return err("mp_decode: empty buffer")
    let pair = mp_decode_at(b, 0)
    let next = pair[1]
    if next == 0
        return err("mp_decode: malformed, truncated, or unrecognized MessagePack data")
    else
        if next != n
            return err("mp_decode: trailing content after value (consumed " + str(next) + " of " + str(n) + " bytes)")
        else
            return ok(pair[0])
