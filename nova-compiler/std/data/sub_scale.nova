// ============================================================================
// NOVA Standard Library — std/data/sub_scale
// ============================================================================
// Subtitle cue time scaling: stretch/compress timing by rational factors,
// frame-rate conversion, and anchor-relative stretching.
//
// CUE SHAPE: dict {"index":int,"start":ms,"end":ms,"text":string}
//   where ms = milliseconds (integer).
//
// PUBLIC API
//   sub_scale(cues, num, den) -> list
//       Scale all start/end times by num/den (integer arithmetic: ms*num/den).
//       Returns a new list; original cues are not mutated.
//
//   sub_fps_convert(cues, from_fps, to_fps) -> list
//       Convert timestamps from one frame rate to another.
//       Equivalent to sub_scale(cues, from_fps, to_fps) — time is inverted:
//       ms_new = ms_old * from_fps / to_fps.
//       (Higher to_fps = faster playback = earlier timestamps.)
//
//   sub_stretch(cues, anchor_ms, num, den) -> list
//       Stretch times around an anchor point:
//         new_ms = anchor_ms + (old_ms - anchor_ms) * num / den
//       The anchor cue (if exactly at anchor_ms) stays fixed.
//       Returns a new list; original cues are not mutated.
//
// IMPLEMENTATION NOTES
//   Integer arithmetic throughout. All ms values are truncated (floor division).
//   For scale(cues, num, den): new_ms = old_ms * num / den (int division).
//   This may produce slight rounding in large values — acceptable for subtitle use.
//
// LEAF — imports NOTHING.
// ============================================================================

// _ss_clone_cue: create a shallow copy of a cue dict.
fn _ss_clone_cue(c)
    let out = {}
    out["index"] = c["index"]
    out["start"] = c["start"]
    out["end"] = c["end"]
    out["text"] = c["text"]
    return out

// sub_scale: multiply all start and end times by num/den.
//
// new_start = old_start * num / den   (integer truncation)
// new_end   = old_end   * num / den
//
// Returns a new list of cloned cues with scaled times.
// Original list and cues are not modified.
//
// Examples:
//   sub_scale([{start:1000,end:2000}], 2, 1) -> [{start:2000,end:4000}]
//   sub_scale([{start:1000,end:2000}], 1, 2) -> [{start:500, end:1000}]
//   sub_scale([{start:1000,end:2000}], 3, 2) -> [{start:1500,end:3000}]
fn sub_scale(cues, num, den)
    let result = []
    let n = len(cues)
    for i in 0..n
        let c = _ss_clone_cue(cues[i])
        c["start"] = cues[i]["start"] * num / den
        c["end"] = cues[i]["end"] * num / den
        push(result, c)
    return result

// sub_fps_convert: convert timestamps between two frame rates.
//
// When a video's frame rate changes, subtitle timestamps must be recalculated.
// A cue that was at 1000ms in a 24fps source corresponds to:
//   1000 * 24 / 25 = 960ms in a 25fps target (earlier, plays sooner).
//
// Formula: new_ms = old_ms * from_fps / to_fps
//
// Returns a new list; original cues are not mutated.
//
// Example (24→25 fps):
//   cue at start=1000 -> 1000 * 24 / 25 = 960
//   cue at start=2500 -> 2500 * 24 / 25 = 2400
fn sub_fps_convert(cues, from_fps, to_fps)
    return sub_scale(cues, from_fps, to_fps)

// sub_stretch: stretch cue times around an anchor point.
//
// All offsets are measured from `anchor_ms`:
//   offset_old = old_ms - anchor_ms
//   new_ms = anchor_ms + offset_old * num / den
//
// When num > den, cues expand away from the anchor.
// When num < den, cues compress toward the anchor.
// A cue exactly at anchor_ms is always unchanged.
//
// Returns a new list; original cues are not mutated.
//
// Examples:
//   anchor=0, num=2, den=1:  start=1000 -> 0 + 1000*2/1 = 2000
//   anchor=5000, num=1, den=2: start=7000 -> 5000 + (7000-5000)*1/2 = 6000
fn sub_stretch(cues, anchor_ms, num, den)
    let result = []
    let n = len(cues)
    for i in 0..n
        let c = _ss_clone_cue(cues[i])
        let old_start = cues[i]["start"]
        let old_end = cues[i]["end"]
        let off_start = old_start - anchor_ms
        let off_end = old_end - anchor_ms
        c["start"] = anchor_ms + off_start * num / den
        c["end"] = anchor_ms + off_end * num / den
        push(result, c)
    return result
