// ============================================================================
// NOVA Standard Library — std/data/rss_parse
// ============================================================================
// Parse RSS 2.0 XML feeds into structured dicts.
//
// PUBLIC API:
//   rss_parse(xml) -> dict
//     Parse an RSS 2.0 XML string.  Returns a dict with keys:
//       "title"       — channel title string
//       "link"        — channel link string
//       "description" — channel description string
//       "items"       — list of item dicts, each with:
//                         "title", "link", "description", "pubDate", "guid"
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - String-search XML parsing: find "<tag>" / "</tag>" boundaries.
//   - No namespace awareness; works on the raw text.
//   - LF = chr(10).  Brace chars via chr(123)/chr(125).
//   - Single-exit style throughout.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// Find the index of needle in haystack starting at pos.
// Returns -1 if not found.
fn _rss_index_of(haystack, needle, pos) -> int
    let hn = len(haystack)
    let nn = len(needle)
    let result = -1
    let i = pos
    let done = 0
    while i <= hn - nn and done == 0
        let matched = 1
        let j = 0
        while j < nn and matched == 1
            if char_at(haystack, i + j) != char_at(needle, j)
                matched = 0
            j += 1
        if matched == 1
            result = i
            done = 1
        i += 1
    result

// Extract the text content of the FIRST occurrence of <tag>...</tag>
// starting the search at pos.  Returns "" if not found.
fn _rss_extract_tag(xml, tag, pos) -> string
    let open_tag = "<" + tag + ">"
    let close_tag = "</" + tag + ">"
    let result = ""
    let start = _rss_index_of(xml, open_tag, pos)
    if start >= 0
        let content_start = start + len(open_tag)
        let end_pos = _rss_index_of(xml, close_tag, content_start)
        if end_pos >= 0
            result = slice(xml, content_start, end_pos)
    result

// Extract all <item>...</item> blocks from the channel text.
// Returns a list of strings, each being the raw inner XML of one <item>.
fn _rss_extract_items(channel_xml) -> list
    let items = []
    let n = len(channel_xml)
    let pos = 0
    let open_tag = "<item>"
    let close_tag = "</item>"
    let done = 0
    while done == 0
        let start = _rss_index_of(channel_xml, open_tag, pos)
        if start < 0
            done = 1
        else
            let content_start = start + len(open_tag)
            let end_pos = _rss_index_of(channel_xml, close_tag, content_start)
            if end_pos < 0
                done = 1
            else
                let block = slice(channel_xml, content_start, end_pos)
                items.push(block)
                pos = end_pos + len(close_tag)
    items

// Parse one <item> block (inner XML) into a dict.
fn _rss_parse_item(item_xml) -> dict
    let d = {}
    d["title"]       = _rss_extract_tag(item_xml, "title", 0)
    d["link"]        = _rss_extract_tag(item_xml, "link", 0)
    d["description"] = _rss_extract_tag(item_xml, "description", 0)
    d["pubDate"]     = _rss_extract_tag(item_xml, "pubDate", 0)
    d["guid"]        = _rss_extract_tag(item_xml, "guid", 0)
    d

// ── Public API ───────────────────────────────────────────────────────────────

// rss_parse: parse an RSS 2.0 XML string into a structured dict.
fn rss_parse(xml) -> dict
    let result = {}
    result["title"]       = ""
    result["link"]        = ""
    result["description"] = ""
    result["items"]       = []

    // Find <channel>...</channel>
    let chan_open = "<channel>"
    let chan_close = "</channel>"
    let chan_start = _rss_index_of(xml, chan_open, 0)
    if chan_start >= 0
        let chan_content_start = chan_start + len(chan_open)
        let chan_end = _rss_index_of(xml, chan_close, chan_content_start)
        let chan_xml = xml
        if chan_end >= 0
            chan_xml = slice(xml, chan_content_start, chan_end)
        else
            chan_xml = slice(xml, chan_content_start, len(xml))

        // Extract channel-level fields (first occurrence, before any <item>).
        // To avoid picking up <title> inside an <item>, we extract from the
        // channel text.  The helper naturally finds the first match.
        result["title"]       = _rss_extract_tag(chan_xml, "title", 0)
        result["link"]        = _rss_extract_tag(chan_xml, "link", 0)
        result["description"] = _rss_extract_tag(chan_xml, "description", 0)

        // Extract all items.
        let raw_items = _rss_extract_items(chan_xml)
        let n = len(raw_items)
        let i = 0
        let items_list = []
        while i < n
            let item_dict = _rss_parse_item(raw_items[i])
            items_list.push(item_dict)
            i += 1
        result["items"] = items_list

    result
