// ============================================================================
// NOVA Standard Library — std/data/sub_timecode
// ============================================================================
// Timecode utilities for subtitle formats (SRT and WebVTT).
//
// PUBLIC API:
//   srt_tc_parse(s)    -> int (milliseconds)  "HH:MM:SS,mmm"
//   srt_tc_format(ms)  -> string              "HH:MM:SS,mmm"
//   vtt_tc_parse(s)    -> int (milliseconds)  "HH:MM:SS.mmm" or "MM:SS.mmm"
//   vtt_tc_format(ms)  -> string              "HH:MM:SS.mmm"
//   ms_to_hms(ms)      -> list [h, m, s, millis]
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - All timecode parsing is inline (no sibling imports).
//   - Single-exit style to avoid NOVA return-null mistag.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// Parse an integer from a substring slice(s, start, end).
fn _tc_parse_int(s, start, end) -> int
    let result = 0
    for i in start..end
        let ch = ord(slice(s, i, i + 1))
        result = result * 10 + (ch - 48)
    result

// Zero-pad an integer to exactly 2 digits.
fn _tc_pad2(n) -> string
    let s = str(n)
    "0" + s if len(s) < 2 else s

// Zero-pad an integer to exactly 3 digits.
fn _tc_pad3(n) -> string
    let s = str(n)
    if len(s) == 1
        "00" + s
    else if len(s) == 2
        "0" + s
    else
        s

// ── Public API ───────────────────────────────────────────────────────────────

// ms_to_hms: decompose milliseconds into [hours, minutes, seconds, millis].
fn ms_to_hms(ms) -> list
    let total_s = ms / 1000
    let millis = ms - total_s * 1000
    let h = total_s / 3600
    let rem = total_s - h * 3600
    let m = rem / 60
    let s = rem - m * 60
    let parts = []
    parts.push(h)
    parts.push(m)
    parts.push(s)
    parts.push(millis)
    parts

// srt_tc_parse: parse "HH:MM:SS,mmm" -> milliseconds.
fn srt_tc_parse(s) -> int
    // Expected format: HH:MM:SS,mmm (length >= 12)
    let h = _tc_parse_int(s, 0, 2)
    let m = _tc_parse_int(s, 3, 5)
    let sec = _tc_parse_int(s, 6, 8)
    let ms = _tc_parse_int(s, 9, 12)
    h * 3600000 + m * 60000 + sec * 1000 + ms

// srt_tc_format: format milliseconds -> "HH:MM:SS,mmm".
fn srt_tc_format(ms) -> string
    let parts = ms_to_hms(ms)
    let h = parts[0]
    let m = parts[1]
    let s = parts[2]
    let millis = parts[3]
    _tc_pad2(h) + ":" + _tc_pad2(m) + ":" + _tc_pad2(s) + "," + _tc_pad3(millis)

// vtt_tc_parse: parse "HH:MM:SS.mmm" or "MM:SS.mmm" -> milliseconds.
fn vtt_tc_parse(s) -> int
    // Determine format by total length / colon positions.
    // "HH:MM:SS.mmm" => length 12, "MM:SS.mmm" => length 9
    let n = len(s)
    let result = 0
    if n >= 12
        // HH:MM:SS.mmm
        let h = _tc_parse_int(s, 0, 2)
        let m = _tc_parse_int(s, 3, 5)
        let sec = _tc_parse_int(s, 6, 8)
        let ms = _tc_parse_int(s, 9, 12)
        result = h * 3600000 + m * 60000 + sec * 1000 + ms
    if n < 12
        // MM:SS.mmm
        let m = _tc_parse_int(s, 0, 2)
        let sec = _tc_parse_int(s, 3, 5)
        let ms = _tc_parse_int(s, 6, 9)
        result = m * 60000 + sec * 1000 + ms
    result

// vtt_tc_format: format milliseconds -> "HH:MM:SS.mmm".
fn vtt_tc_format(ms) -> string
    let parts = ms_to_hms(ms)
    let h = parts[0]
    let m = parts[1]
    let s = parts[2]
    let millis = parts[3]
    _tc_pad2(h) + ":" + _tc_pad2(m) + ":" + _tc_pad2(s) + "." + _tc_pad3(millis)
