// ============================================================================
// NOVA Standard Library — std/data/plist
// ============================================================================
// Apple XML property-list (plist) PARSER — subset reader.
//
// Handles the DOCTYPE-free XML subset used in real .plist files:
//   <dict>   with <key>..</key> then a value element
//   <array>  with ordered value elements
//   <string> text content
//   <integer> text content parsed as int
//   <real>    text content returned as string (no float arithmetic required)
//   <true/>  returns int 1
//   <false/> returns int 0
//
// The <?xml ..?> processing instruction and <plist ..> wrapper are stripped
// automatically if present.
//
// PUBLIC API
//   plst_parse(xml)           -> any      Parse XML plist string to NOVA value
//   plst_get(value, key, dflt) -> any     Dict key-lookup with default
//
// EXAMPLES
//   let x = "<dict><key>name</key><string>nova</string></dict>"
//   let d = plst_parse(x)      // -> {"name": "nova"}
//   d["name"]                  // -> "nova"
//   plst_parse("<integer>42</integer>")   // -> 42
//   plst_parse("<true/>")                // -> 1
//   plst_parse("<array><integer>1</integer><integer>2</integer></array>")
//                                        // -> [1, 2]
//   plst_get(d, "name", "")    // -> "nova"
//   plst_get(d, "x", "dflt")  // -> "dflt"
//
// IMPLEMENTATION NOTES
//   • All private helpers prefixed _plst_ to avoid link collisions.
//   • Cursor state threaded as dict {"pos": int} — NOVA idiomatic pattern.
//   • Single-exit style throughout (NOVA return-null mistag avoidance).
//   • Comments // not #.  No and-and / or-or — use and/or words.
//   • No multi-line list/dict literals in module body.
//   • chr(60)='<'  chr(62)='>'  chr(47)='/'  chr(61)='='  chr(34)='"'
//   • LEAF module — imports nothing.
// ============================================================================

// ── Private: skip whitespace ──────────────────────────────────────────────────

fn _plst_skip_ws(s, n, st)
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = ord(char_at(s, p))
            // space=32  tab=9  CR=13  LF=10
            if o == 32
                st["pos"] = p + 1
            else
                if o == 9
                    st["pos"] = p + 1
                else
                    if o == 13
                        st["pos"] = p + 1
                    else
                        if o == 10
                            st["pos"] = p + 1
                        else
                            go = 0

// ── Private: integer string -> int ───────────────────────────────────────────

fn _plst_parse_int(s)
    let result = 0
    let n = len(s)
    let i = 0
    let neg = 0
    if n > 0
        let fc = char_at(s, 0)
        if ord(fc) == 45
            neg = 1
            i = 1
    let go = 1
    while go == 1
        if i >= n
            go = 0
        else
            let o = ord(char_at(s, i))
            if o < 48
                go = 0
            else
                if o > 57
                    go = 0
                else
                    result = result * 10 + (o - 48)
                    i = i + 1
    if neg == 1
        result = 0 - result
    return result

// ── Private: trim leading/trailing whitespace from a string ──────────────────

fn _plst_trim(s)
    let n = len(s)
    let start = 0
    let finish = n
    // trim leading
    let go = 1
    while go == 1
        if start >= finish
            go = 0
        else
            let o = ord(char_at(s, start))
            if o == 32
                start = start + 1
            else
                if o == 9
                    start = start + 1
                else
                    if o == 10
                        start = start + 1
                    else
                        if o == 13
                            start = start + 1
                        else
                            go = 0
    // trim trailing
    let go2 = 1
    while go2 == 1
        if finish <= start
            go2 = 0
        else
            let o2 = ord(char_at(s, finish - 1))
            if o2 == 32
                finish = finish - 1
            else
                if o2 == 9
                    finish = finish - 1
                else
                    if o2 == 10
                        finish = finish - 1
                    else
                        if o2 == 13
                            finish = finish - 1
                        else
                            go2 = 0
    let result = ""
    if finish > start
        result = slice(s, start, finish)
    return result

// ── Private: read until '<', return the text content ─────────────────────────

fn _plst_read_text(s, n, st)
    let p = st["pos"]
    let start = p
    let go = 1
    while go == 1
        if p >= n
            go = 0
        else
            let o = ord(char_at(s, p))
            if o == 60
                go = 0
            else
                p = p + 1
    st["pos"] = p
    let result = ""
    if p > start
        result = slice(s, start, p)
    return result

// ── Private: read a tag name (letters, digits, underscore, colon, hyphen) ────
// Starts with pos AFTER the '<' (and after any leading '/')
// Returns just the name; does NOT consume the rest of the tag.

fn _plst_read_tagname(s, n, st)
    let p = st["pos"]
    let start = p
    let go = 1
    while go == 1
        if p >= n
            go = 0
        else
            let o = ord(char_at(s, p))
            // alpha A-Z=65-90 a-z=97-122 digit=48-57 _=95 :=58 -=45 .=46
            let ok = 0
            if o >= 65
                if o <= 90
                    ok = 1
            if o >= 97
                if o <= 122
                    ok = 1
            if o >= 48
                if o <= 57
                    ok = 1
            if o == 95
                ok = 1
            if o == 58
                ok = 1
            if o == 45
                ok = 1
            if o == 46
                ok = 1
            if ok == 1
                p = p + 1
            else
                go = 0
    st["pos"] = p
    let result = ""
    if p > start
        result = slice(s, start, p)
    return result

// ── Private: skip to end of current tag (past the '>') ───────────────────────

fn _plst_skip_to_gt(s, n, st)
    let go = 1
    while go == 1
        let p = st["pos"]
        if p >= n
            go = 0
        else
            let o = ord(char_at(s, p))
            st["pos"] = p + 1
            if o == 62
                go = 0

// ── Private: skip a comment <!-- ... --> or PI <?...?> ───────────────────────
// Called with pos AFTER the opening '<'; first char is '!' or '?'

fn _plst_skip_special(s, n, st)
    // just scan for '>' — good enough for plist (no > inside comments normally)
    _plst_skip_to_gt(s, n, st)

// ── Private: decode XML text escapes in a string ─────────────────────────────

fn _plst_unescape(s)
    let n = len(s)
    let result_parts = []
    let i = 0
    while i < n
        let ch = char_at(s, i)
        let o = ord(ch)
        if o == 38
            // '&' — find matching ';'
            let j = i + 1
            let go = 1
            while go == 1
                if j >= n
                    go = 0
                else
                    let oo = ord(char_at(s, j))
                    if oo == 59
                        go = 0
                    else
                        j = j + 1
            let entity = slice(s, i + 1, j)
            let repl = ch
            if entity == "lt"
                repl = "<"
            else
                if entity == "gt"
                    repl = ">"
                else
                    if entity == "amp"
                        repl = "&"
                    else
                        if entity == "apos"
                            repl = "'"
                        else
                            if entity == "quot"
                                repl = chr(34)
                            else
                                repl = "&" + entity + ";"
            push(result_parts, repl)
            i = j + 1
        else
            push(result_parts, ch)
            i = i + 1
    let result = join(result_parts, "")
    return result

// ── Private: parse one plist value node, advancing st["pos"] ─────────────────
// Called with pos pointing at the '<' of the opening tag.

fn _plst_parse_node(s, n, st)
    let result = null
    _plst_skip_ws(s, n, st)
    let p = st["pos"]
    if p < n
        let c0 = char_at(s, p)
        if ord(c0) == 60
            // consume '<'
            st["pos"] = p + 1
            _plst_skip_ws(s, n, st)
            let p2 = st["pos"]
            if p2 < n
                let c1 = char_at(s, p2)
                let o1 = ord(c1)
                if o1 == 33
                    // comment <!
                    _plst_skip_special(s, n, st)
                    result = _plst_parse_node(s, n, st)
                else
                    if o1 == 63
                        // PI <?
                        _plst_skip_special(s, n, st)
                        result = _plst_parse_node(s, n, st)
                    else
                        if o1 == 47
                            // closing tag </ — caller didn't expect this; return null
                            // rewind to before '<'
                            st["pos"] = p
                        else
                            // opening tag name
                            let tag = _plst_read_tagname(s, n, st)
                            // skip attributes and check for self-closing '/>'
                            let self_close = 0
                            let gs = 1
                            while gs == 1
                                let pp = st["pos"]
                                if pp >= n
                                    gs = 0
                                else
                                    let oo = ord(char_at(s, pp))
                                    if oo == 62
                                        // '>'
                                        st["pos"] = pp + 1
                                        gs = 0
                                    else
                                        if oo == 47
                                            // '/' — check next for '>'
                                            let pn = pp + 1
                                            if pn < n
                                                let on2 = ord(char_at(s, pn))
                                                if on2 == 62
                                                    self_close = 1
                                                    st["pos"] = pn + 1
                                                    gs = 0
                                                else
                                                    st["pos"] = pp + 1
                                            else
                                                st["pos"] = pp + 1
                                        else
                                            st["pos"] = pp + 1
                            // dispatch by tag name
                            if tag == "true"
                                result = 1
                            else
                                if tag == "false"
                                    result = 0
                                else
                                    if tag == "string"
                                        if self_close == 0
                                            let raw = _plst_read_text(s, n, st)
                                            result = _plst_unescape(raw)
                                            // consume </string>
                                            _plst_skip_to_gt(s, n, st)
                                        else
                                            result = ""
                                    else
                                        if tag == "integer"
                                            if self_close == 0
                                                let raw2 = _plst_read_text(s, n, st)
                                                result = _plst_parse_int(_plst_trim(raw2))
                                                _plst_skip_to_gt(s, n, st)
                                            else
                                                result = 0
                                        else
                                            if tag == "real"
                                                if self_close == 0
                                                    let raw3 = _plst_read_text(s, n, st)
                                                    result = _plst_trim(raw3)
                                                    _plst_skip_to_gt(s, n, st)
                                                else
                                                    result = "0.0"
                                            else
                                                if tag == "key"
                                                    // <key> text </key> — return just text
                                                    if self_close == 0
                                                        let raw4 = _plst_read_text(s, n, st)
                                                        result = _plst_unescape(_plst_trim(raw4))
                                                        _plst_skip_to_gt(s, n, st)
                                                    else
                                                        result = ""
                                                else
                                                    if tag == "array"
                                                        if self_close == 0
                                                            let items = []
                                                            let ga = 1
                                                            while ga == 1
                                                                _plst_skip_ws(s, n, st)
                                                                let pa = st["pos"]
                                                                if pa >= n
                                                                    ga = 0
                                                                else
                                                                    // peek: is it a closing tag?
                                                                    let ca = char_at(s, pa)
                                                                    if ord(ca) == 60
                                                                        let pa2 = pa + 1
                                                                        if pa2 < n
                                                                            let ca2 = char_at(s, pa2)
                                                                            if ord(ca2) == 47
                                                                                // closing </array>
                                                                                _plst_skip_to_gt(s, n, st)
                                                                                ga = 0
                                                                            else
                                                                                let elem = _plst_parse_node(s, n, st)
                                                                                items.push(elem)
                                                                        else
                                                                            ga = 0
                                                                    else
                                                                        ga = 0
                                                            result = items
                                                        else
                                                            result = []
                                                    else
                                                        if tag == "dict"
                                                            if self_close == 0
                                                                let d = {}
                                                                let gd = 1
                                                                while gd == 1
                                                                    _plst_skip_ws(s, n, st)
                                                                    let pd = st["pos"]
                                                                    if pd >= n
                                                                        gd = 0
                                                                    else
                                                                        let cd = char_at(s, pd)
                                                                        if ord(cd) == 60
                                                                            let pd2 = pd + 1
                                                                            if pd2 < n
                                                                                let cd2 = char_at(s, pd2)
                                                                                if ord(cd2) == 47
                                                                                    // closing </dict>
                                                                                    _plst_skip_to_gt(s, n, st)
                                                                                    gd = 0
                                                                                else
                                                                                    // parse <key>
                                                                                    let k = _plst_parse_node(s, n, st)
                                                                                    // parse value
                                                                                    let v = _plst_parse_node(s, n, st)
                                                                                    if k == null
                                                                                        gd = 0
                                                                                    else
                                                                                        d[k] = v
                                                                            else
                                                                                gd = 0
                                                                        else
                                                                            gd = 0
                                                                result = d
                                                            else
                                                                result = {}
                                                        else
                                                            // unknown tag — skip to its closing tag
                                                            if self_close == 0
                                                                let gu = 1
                                                                while gu == 1
                                                                    _plst_skip_ws(s, n, st)
                                                                    let pu = st["pos"]
                                                                    if pu >= n
                                                                        gu = 0
                                                                    else
                                                                        let cu = char_at(s, pu)
                                                                        if ord(cu) == 60
                                                                            let pu2 = pu + 1
                                                                            if pu2 < n
                                                                                let cu2 = char_at(s, pu2)
                                                                                if ord(cu2) == 47
                                                                                    _plst_skip_to_gt(s, n, st)
                                                                                    gu = 0
                                                                                else
                                                                                    _plst_skip_to_gt(s, n, st)
                                                                            else
                                                                                gu = 0
                                                                        else
                                                                            st["pos"] = pu + 1
    return result

// ── Private: strip <?xml..?> and <plist..> wrappers ──────────────────────────
// Finds the first real value element after stripping boilerplate.
// Returns the position of the first content '<'

fn _plst_find_content_start(s, n, st)
    let done = 0
    while done == 0
        _plst_skip_ws(s, n, st)
        let p = st["pos"]
        if p >= n
            done = 1
        else
            let c0 = ord(char_at(s, p))
            if c0 == 60
                // peek next char
                let p1 = p + 1
                if p1 >= n
                    done = 1
                else
                    let c1 = ord(char_at(s, p1))
                    if c1 == 63
                        // <? processing instruction — skip it
                        st["pos"] = p + 1
                        _plst_skip_special(s, n, st)
                    else
                        if c1 == 33
                            // <!-- comment or <!DOCTYPE — skip
                            st["pos"] = p + 1
                            _plst_skip_special(s, n, st)
                        else
                            // real tag — check if it's <plist
                            let p2 = p + 1
                            st["pos"] = p2
                            let tagname = _plst_read_tagname(s, n, st)
                            if tagname == "plist"
                                // skip to '>' of <plist ...>
                                _plst_skip_to_gt(s, n, st)
                            else
                                // restore: rewind to the '<'
                                st["pos"] = p
                                done = 1
            else
                done = 1

// ── Public: plst_parse ────────────────────────────────────────────────────────

// plst_parse: parse an XML plist string to a NOVA value.
//
// Supported types: dict, array, string, integer, real (as string), true->1, false->0.
// The <?xml..?> declaration and <plist..> wrapper are stripped automatically.
//
// Examples:
//   plst_parse("<string>hi</string>")          -> "hi"
//   plst_parse("<integer>42</integer>")        -> 42
//   plst_parse("<true/>")                      -> 1
//   plst_parse("<array><integer>1</integer><integer>2</integer></array>") -> [1, 2]
fn plst_parse(xml)
    let n = len(xml)
    let st = {}
    st["pos"] = 0
    _plst_find_content_start(xml, n, st)
    let result = _plst_parse_node(xml, n, st)
    return result

// ── Public: plst_get ──────────────────────────────────────────────────────────

// plst_get: look up a key in a parsed plist dict value with a default.
//
// Examples:
//   plst_get(d, "name", "")        -> "nova"   (key present)
//   plst_get(d, "missing", "x")   -> "x"       (key absent)
fn plst_get(value, key, dflt)
    let result = dflt
    if is_dict(value)
        if contains(keys(value), key)
            result = value[key]
    return result
