// proplist — association list (ordered list of [key, value] pairs).
//
// Unlike a plain dict, a proplist preserves insertion order AND allows
// duplicate keys.  All keys are strings; values may be any NOVA value.
//
// Representation (a plain NOVA dict):
//   "pairs" -> list  (each element is a two-element list [key, value])
//
// Public API
//   pl_new()               -> proplist
//   pl_add(pl, k, v)       -> unit  (append [k, v] to pairs)
//   pl_get(pl, k)          -> first value for k, or null if none
//   pl_get_all(pl, k)      -> list of all values for k, in order
//   pl_keys(pl)            -> list of keys in order (duplicates included)
//   pl_has(pl, k)          -> 1 if k appears at least once, 0 otherwise
//   pl_remove_first(pl, k) -> unit  (remove first pair whose key == k; no-op if absent)
//   pl_len(pl)             -> total number of pairs
//
// LEAF — imports NOTHING.

// pl_new: create an empty proplist.
fn pl_new()
    return {"pairs": []}

// pl_add: append a new [k, v] pair.  Duplicate keys are allowed.
fn pl_add(pl, k, v)
    pl["pairs"].push([k, v])

// pl_get: return the value from the FIRST pair whose key == k.
// Returns null if no such pair exists.
fn pl_get(pl, k)
    let pairs = pl["pairs"]
    let n = len(pairs)
    let result = null
    let found = 0
    for i in 0..n
        if found == 0
            let pair = pairs[i]
            if pair[0] == k
                result = pair[1]
                found = 1
    return result

// pl_get_all: return a list of all values whose key == k, in order.
// Returns [] if k is not present.
fn pl_get_all(pl, k)
    let pairs = pl["pairs"]
    let n = len(pairs)
    let result = []
    for i in 0..n
        let pair = pairs[i]
        if pair[0] == k
            result.push(pair[1])
    return result

// pl_keys: return every key in order, including duplicates.
fn pl_keys(pl)
    let pairs = pl["pairs"]
    let n = len(pairs)
    let result = []
    for i in 0..n
        let pair = pairs[i]
        result.push(pair[0])
    return result

// pl_has: return 1 if k appears as a key in any pair, 0 otherwise.
fn pl_has(pl, k)
    let pairs = pl["pairs"]
    let n = len(pairs)
    let found = 0
    for i in 0..n
        if found == 0
            let pair = pairs[i]
            if pair[0] == k
                found = 1
    return found

// pl_remove_first: remove the first pair whose key == k.
// No-op if k does not appear.
fn pl_remove_first(pl, k)
    let pairs = pl["pairs"]
    let n = len(pairs)
    let new_pairs = []
    let removed = 0
    for i in 0..n
        let pair = pairs[i]
        if removed == 0
            if pair[0] == k
                removed = 1
            else
                new_pairs.push(pair)
        else
            new_pairs.push(pair)
    pl["pairs"] = new_pairs

// pl_len: return the total number of pairs (including duplicate-key pairs).
fn pl_len(pl)
    let pairs = pl["pairs"]
    return len(pairs)
