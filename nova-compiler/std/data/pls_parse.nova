// ============================================================================
// NOVA Standard Library — std/data/pls_parse
// ============================================================================
// Parse PLS playlists (INI-like format used by Winamp / SHOUTcast).
//
// PUBLIC API
//   pls_parse(text) -> list of dict {"url","title","length"}
//
// Format (case-insensitive keys; we handle lowercase comparisons):
//   [playlist]           — section header (ignored structurally)
//   File1=http://...     — URL for track 1
//   Title1=Name          — Title for track 1
//   Length1=seconds      — Duration in seconds (int; -1 = unknown/live)
//   NumberOfEntries=N    — Total track count (used as a hint)
//   Version=2            — Version marker (ignored)
//
// Returned list is ordered by numeric suffix (1, 2, 3, ...).
// Missing keys default to: url="", title="", length=-1.
//
// LEAF module — imports nothing.
// ============================================================================

// _pls_ltrim / _pls_rtrim / _pls_trim: whitespace stripping
fn _pls_ltrim(s)
    let i = 0
    let n = len(s)
    let result = s
    let done = 0
    while i < n and done == 0
        let c = slice(s, i, i+1)
        if c == " " or c == "\t" or c == "\r" or c == chr(10)
            i += 1
        else
            done = 1
    if i > 0
        result = slice(s, i, n)
    return result

fn _pls_rtrim(s)
    let n = len(s)
    let i = n
    let result = s
    let done = 0
    while i > 0 and done == 0
        let c = slice(s, i-1, i)
        if c == " " or c == "\t" or c == "\r" or c == chr(10)
            i -= 1
        else
            done = 1
    if i < n
        result = slice(s, 0, i)
    return result

fn _pls_trim(s)
    return _pls_rtrim(_pls_ltrim(s))

// _pls_split_lines: split on LF
fn _pls_split_lines(text)
    let lines = []
    let n = len(text)
    let start = 0
    for i in 0..n
        if slice(text, i, i+1) == chr(10)
            push(lines, slice(text, start, i))
            start = i + 1
    if start < n
        push(lines, slice(text, start, n))
    return lines

// _pls_find_eq: find '=' index in line; -1 if absent
fn _pls_find_eq(line)
    let result = -1
    let n = len(line)
    let i = 0
    let found = 0
    while i < n and found == 0
        if slice(line, i, i+1) == "="
            result = i
            found = 1
        i += 1
    return result

// _pls_starts_with_ci: case-insensitive prefix check
fn _pls_starts_with_ci(s, prefix)
    let result = 0
    let slen = len(s)
    let plen = len(prefix)
    if slen >= plen
        if lower(slice(s, 0, plen)) == lower(prefix)
            result = 1
    return result

// _pls_parse_int: parse decimal integer string; returns -1 on failure/empty
fn _pls_parse_int(s)
    let n = len(s)
    let result = -1
    if n > 0
        let neg = 0
        let start = 0
        if slice(s, 0, 1) == "-"
            neg = 1
            start = 1
        let v = 0
        let i = start
        let valid = 1
        while i < n
            let o = ord(slice(s, i, i+1))
            if o < 48 or o > 57
                valid = 0
            else
                v = v * 10 + (o - 48)
            i += 1
        if valid == 1
            result = -v if neg == 1 else v
    return result

// _pls_parse_suffix: extract the numeric suffix from a key like "File1", "Title23"
//   Returns the suffix int, or -1 if no digits found.
fn _pls_parse_suffix(key)
    let n = len(key)
    let i = n
    // scan backwards while character is a digit
    let done = 0
    while i > 0 and done == 0
        let o = ord(slice(key, i-1, i))
        if o >= 48 and o <= 57
            i -= 1
        else
            done = 1
    let result = -1
    if i < n
        result = _pls_parse_int(slice(key, i, n))
    return result

// pls_parse: main entry point.
fn pls_parse(text)
    let lines = _pls_split_lines(text)
    // Collect raw fields into per-index dicts:
    // urls[idx] = url string, titles[idx] = title string, lengths[idx] = length int
    let urls = {}
    let titles = {}
    let lengths = {}
    let max_idx = 0
    for i in 0..len(lines)
        let raw = lines[i]
        let line = _pls_trim(raw)
        // Skip blank lines and comments (;) and section headers ([...])
        if len(line) > 0 and not _pls_starts_with_ci(line, ";") and not _pls_starts_with_ci(line, "[")
            let eq = _pls_find_eq(line)
            if eq >= 0
                let key = _pls_trim(slice(line, 0, eq))
                let val = _pls_trim(slice(line, eq+1, len(line)))
                // Determine key type and suffix
                if _pls_starts_with_ci(key, "File")
                    let suffix = _pls_parse_suffix(key)
                    if suffix > 0
                        urls[str(suffix)] = val
                        if suffix > max_idx
                            max_idx = suffix
                if _pls_starts_with_ci(key, "Title")
                    let suffix = _pls_parse_suffix(key)
                    if suffix > 0
                        titles[str(suffix)] = val
                        if suffix > max_idx
                            max_idx = suffix
                if _pls_starts_with_ci(key, "Length")
                    // Make sure it's Length<N>, not NumberOfEntries or similar
                    // The suffix extraction handles this: "Length1" -> suffix=1
                    let suffix = _pls_parse_suffix(key)
                    if suffix > 0
                        lengths[str(suffix)] = _pls_parse_int(val)
                        if suffix > max_idx
                            max_idx = suffix
                // NumberOfEntries and Version: ignored (max_idx covers count)
    // Build output list ordered 1..max_idx
    let result = []
    for j in 1..(max_idx + 1)
        let jk = str(j)
        // Only emit entries that have at least a URL
        if jk in urls
            let title = titles[jk] if jk in titles else ""
            let length = lengths[jk] if jk in lengths else -1
            push(result, {"url": urls[jk], "title": title, "length": length})
    return result
