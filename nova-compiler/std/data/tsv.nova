// ============================================================================
// NOVA Standard Library — std/data/tsv
// ============================================================================
// Tab-Separated Values (TSV) parser and formatter.
//
// PUBLIC API:
//   tsv_parse(text) -> list
//     Parse a TSV document into a list of rows, where each row is a list of
//     string fields.  Lines are split on chr(10); fields on chr(9).
//     Trailing chr(13) on each line is stripped (CRLF tolerance).
//     Empty trailing lines (e.g. from a trailing newline) are skipped.
//
//   tsv_format(rows) -> string
//     Serialize a list of rows (each a list of string fields) back to TSV.
//     Fields are joined by chr(9); rows are joined by chr(10).
//     Returns "" for an empty input.
//
//   tsv_parse_dicts(text) -> list
//     Like tsv_parse but uses the FIRST row as header keys.  Returns a list
//     of dicts mapping header -> field string.  If the input has only a
//     header row and no data rows, returns an empty list.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - Single-exit style throughout (avoids NOVA return-null mistag).
//   - No module-level float constants (would silently truncate to 0).
//   - No multi-line list/dict literals in module body (parser abort).
//   - Brace interpolation hazard: brace chars via chr(123)/chr(125) in tests.
//
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// Strip a trailing CR (chr(13)) from a line if present (CRLF tolerance).
fn _tsv_strip_cr(line) -> string
    let result = line
    let n = len(line)
    if n > 0
        if ord(line[n - 1]) == 13
            result = slice(line, 0, n - 1)
    result

// Split a single TSV line into a list of string fields on chr(9) (tab).
fn _tsv_split_fields(line) -> list
    split(line, chr(9))

// ── Public API ───────────────────────────────────────────────────────────────

// tsv_parse: parse a TSV text into a list of rows (each row = list of strings).
//
// Algorithm:
//   1. Split on chr(10) to get candidate lines.
//   2. Strip trailing chr(13) from each line (CRLF tolerance).
//   3. Skip lines that are empty after stripping.
//   4. Split each non-empty line on chr(9) to get fields.
//   5. Collect and return all rows.
fn tsv_parse(text) -> list
    let rows = []
    let lines = split(text, chr(10))
    let n = len(lines)
    for i in 0..n
        let raw = lines[i]
        let line = _tsv_strip_cr(raw)
        if len(line) > 0
            let fields = _tsv_split_fields(line)
            rows.push(fields)
    rows

// tsv_format: serialize a list of rows back to TSV text.
//
// Each row's fields are joined by chr(9); rows are joined by chr(10).
// An empty input produces an empty string (no trailing newline).
fn tsv_format(rows) -> string
    join([join(row, chr(9)) for row in rows], chr(10))

// tsv_parse_dicts: parse TSV where the first row is the header.
//
// Returns a list of dicts mapping header key -> string field value.
// If a data row has fewer fields than the header, the missing keys get "".
// If a data row has more fields than the header, extra fields are ignored.
// Returns [] when the text has no data rows (only a header or is empty).
fn tsv_parse_dicts(text) -> list
    let result = []
    let rows = tsv_parse(text)
    let nr = len(rows)
    if nr > 0
        let header = rows[0]
        let nh = len(header)
        for i in 1..nr
            let row = rows[i]
            let nf = len(row)
            let d = {}
            for j in 0..nh
                d[header[j]] = row[j] if j < nf else ""
            result.push(d)
    result
