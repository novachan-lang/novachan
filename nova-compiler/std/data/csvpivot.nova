// ============================================================================
// NOVA Standard Library — std/data/csvpivot
// ============================================================================
// Pivot-table aggregation over a list of row-dicts.
//
// PUBLIC API
//   cpv_pivot_sum(rows, rowKey, colKey, valKey) -> dict
//       Two-level pivot: result[rowVal][colVal] = SUM of int(row[valKey])
//       across all rows where row[rowKey]==rowVal and row[colKey]==colVal.
//       Rows missing any of the three keys are silently skipped.
//
//   cpv_pivot_count(rows, rowKey, colKey) -> dict
//       Two-level pivot: result[rowVal][colVal] = COUNT of rows with that
//       (rowVal, colVal) combination.
//       Rows missing either key are silently skipped.
//
//   cpv_row_labels(pivot) -> list
//       Return the sorted list of outer (row) keys of a pivot dict.
//
//   cpv_col_labels(pivot) -> list
//       Return the sorted union of ALL inner (column) keys across every
//       outer key, de-duplicated and sorted lexicographically.
//
// IMPLEMENTATION NOTES
//   • Private helpers prefixed _cpv_.
//   • All dict reads guarded with contains().
//   • Single-exit pattern used throughout (avoids return-null mistag bug).
//   • No '&&' / '||' — use 'and' / 'or' words.
//   • int() coerces string-of-digits to int.
//   • Nested dict assignment: result[rv][cv] = x is always done at
//     the top-most if-level inside the while body to stay within the
//     1-level field-assign propagation limit.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _cpv_to_int: coerce any value (string digits, int, float) to int.
fn _cpv_to_int(v) -> int
    let result = 0
    let t = type_of(v)
    if t == "int"
        result = v
    else
        if t == "float"
            result = float_to_int(v)
        else
            result = int(v)
    return result

// _cpv_str: convert any value to its string representation for use as a key.
fn _cpv_str(v) -> string
    return str(v)

// _cpv_col_union: collect sorted de-duplicated col keys from all inner dicts.
// pivot is a dict of dicts; we walk all inner dicts and union their keys.
fn _cpv_col_union(pivot) -> list
    let seen = {}
    let outer_keys = keys(pivot)
    let n = len(outer_keys)
    for i in 0..n
        let rk = outer_keys[i]
        let inner = pivot[rk]
        let ck_list = keys(inner)
        let m = len(ck_list)
        let j = 0
        while j < m
            let ck = ck_list[j]
            seen[ck] = 1
            j = j + 1
    let all_cols = keys(seen)
    let sorted = sort(all_cols)
    return sorted

// ── Public API ───────────────────────────────────────────────────────────────

// cpv_pivot_sum: two-level pivot summing int(row[valKey]).
// Returns dict: rowVal -> dict: colVal -> int sum.
// Example:
//   rows = [{"r":"a","c":"x","v":"2"},{"r":"a","c":"x","v":"3"},
//           {"r":"a","c":"y","v":"4"},{"r":"b","c":"x","v":"5"}]
//   cpv_pivot_sum(rows, "r", "c", "v")
//   -> {"a": {"x": 5, "y": 4}, "b": {"x": 5}}
fn cpv_pivot_sum(rows, rowKey, colKey, valKey)
    let result = {}
    let n = len(rows)
    for i in 0..n
        let row = rows[i]
        let ok = 1
        if contains(row, rowKey) == 0
            ok = 0
        if contains(row, colKey) == 0
            ok = 0
        if contains(row, valKey) == 0
            ok = 0
        if ok == 1
            let rv = _cpv_str(row[rowKey])
            let cv = _cpv_str(row[colKey])
            let vv = _cpv_to_int(row[valKey])
            if contains(result, rv) == 0
                result[rv] = {}
            let inner = result[rv]
            if contains(inner, cv) == 0
                inner[cv] = 0
            inner[cv] = inner[cv] + vv
            result[rv] = inner
    return result

// cpv_pivot_count: two-level pivot counting rows per (rowVal, colVal).
// Returns dict: rowVal -> dict: colVal -> int count.
// Example:
//   cpv_pivot_count(rows, "r", "c")
//   -> {"a": {"x": 2, "y": 1}, "b": {"x": 1}}
fn cpv_pivot_count(rows, rowKey, colKey)
    let result = {}
    let n = len(rows)
    for i in 0..n
        let row = rows[i]
        let ok = 1
        if contains(row, rowKey) == 0
            ok = 0
        if contains(row, colKey) == 0
            ok = 0
        if ok == 1
            let rv = _cpv_str(row[rowKey])
            let cv = _cpv_str(row[colKey])
            if contains(result, rv) == 0
                result[rv] = {}
            let inner = result[rv]
            if contains(inner, cv) == 0
                inner[cv] = 0
            inner[cv] = inner[cv] + 1
            result[rv] = inner
    return result

// cpv_row_labels: sorted list of outer (row) keys in a pivot dict.
// Example:
//   cpv_row_labels({"b":{},"a":{}}) -> ["a","b"]
fn cpv_row_labels(pivot) -> list
    let ks = keys(pivot)
    let sorted = sort(ks)
    return sorted

// cpv_col_labels: sorted union of all inner (column) keys across every row.
// Example:
//   cpv_col_labels({"a":{"x":5,"y":4},"b":{"x":5}}) -> ["x","y"]
fn cpv_col_labels(pivot) -> list
    return _cpv_col_union(pivot)
