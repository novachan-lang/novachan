// ============================================================================
// NOVA Standard Library — std/data/po_build
// ============================================================================
// GNU gettext PO (Portable Object) file builder.
//
// Emits a well-formed PO document from a list of entry dicts.
//
// Entry dict keys:
//   "msgid"    : string  — message identifier (required; "" for header entry)
//   "msgstr"   : string  — translated string (required)
//   "comments" : list    — list of strings; each emitted as "# <text>" line
//
// PO output format per entry:
//   # <comment>        (one line per comment)
//   msgid "<escaped>"
//   msgstr "<escaped>"
//                      (blank line between entries)
//
// Escape sequences applied inside quoted strings:
//   backslash -> \\
//   double-quote -> \"
//   newline (LF) -> \n
//   tab -> \t
//
// PUBLIC API
//   po_build(entries) -> string
//
// EXAMPLES
//   let e = {}
//   e["msgid"]    = "hello"
//   e["msgstr"]   = "bonjour"
//   e["comments"] = []
//   po_build([e])
//   // => "msgid \"hello\"\nmsgstr \"bonjour\"\n\n"
//
// IMPLEMENTATION NOTES
//   • Private helpers prefixed _pob_ to avoid link collisions.
//   • Single-exit style throughout (NOVA early-return mistag bug avoidance).
//   • No multi-line list/dict literals (NOVA parser limitation).
//   • chr(10)=LF, chr(34)='"', chr(92)=backslash, chr(9)=TAB.
//   • LEAF module — imports nothing.
// ============================================================================

// ── Private: escape a PO string value (content only, no surrounding quotes) ──

fn _pob_escape(s)
    let n = len(s)
    let result = ""
    let i = 0
    let bslash = chr(92)
    let dquote = chr(34)
    let lf     = chr(10)
    let tab    = chr(9)
    while i < n
        let ch = char_at(s, i)
        if ch == bslash
            result += bslash + bslash
        else if ch == dquote
            result += bslash + dquote
        else if ch == lf
            result += bslash + "n"
        else if ch == tab
            result += bslash + "t"
        else
            result += ch
        i += 1
    return result

// ── Public: po_build ─────────────────────────────────────────────────────────

// po_build: emit a PO file string from a list of entry dicts.
fn po_build(entries)
    let lf     = chr(10)
    let dquote = chr(34)
    let result_parts = []
    let n = len(entries)
    for i in 0..n
        let e = entries[i]
        // Emit comment lines
        let comms = e["comments"]
        let nc = len(comms)
        for j in 0..nc
            push(result_parts, "# " + comms[j] + lf)
        // Emit msgid
        let mid = e["msgid"]
        push(result_parts, "msgid " + dquote + _pob_escape(mid) + dquote + lf)
        // Emit msgstr
        let mstr = e["msgstr"]
        push(result_parts, "msgstr " + dquote + _pob_escape(mstr) + dquote + lf)
        // Blank line between entries
        push(result_parts, lf)
    let result = join(result_parts, "")
    return result
