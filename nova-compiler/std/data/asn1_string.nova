// ============================================================================
// NOVA Standard Library — std/data/asn1_string
// ============================================================================
// ASN.1 DER string-type encoder/decoder.
//
// Covers the three most common character-string types used in X.509 and PKIX:
//
//   UTF8String     (tag 0x0C) — UTF-8 encoded Unicode string
//   PrintableString(tag 0x13) — restricted ASCII subset (letters, digits,
//                                space and a few punctuation chars per X.680)
//   IA5String      (tag 0x16) — full 7-bit ASCII (IA5 = International Alphabet 5)
//
// All three are PRIMITIVE types.  Their content bytes are the raw octet encoding
// of the characters — no BOM, no terminator.  DER is deterministic: always
// minimal length encoding, always primitive (never constructed).
//
// PUBLIC API:
//
//   asn1_utf8_encode(s: str) -> bytes
//     Encode string s as a DER UTF8String TLV.
//     Tag = 0x0C.  Content = UTF-8 octets of s.
//     Example: asn1_utf8_encode("hi") == [0x0C, 0x02, 0x68, 0x69]
//              asn1_utf8_encode("")   == [0x0C, 0x00]
//
//   asn1_printable_encode(s: str) -> bytes
//     Encode string s as a DER PrintableString TLV.
//     Tag = 0x13.  Content = ASCII octets of s.
//     Example: asn1_printable_encode("US") == [0x13, 0x02, 0x55, 0x53]
//
//   asn1_ia5_encode(s: str) -> bytes
//     Encode string s as a DER IA5String TLV.
//     Tag = 0x16.  Content = ASCII octets of s.
//     Example: asn1_ia5_encode("a@b") == [0x16, 0x03, 0x61, 0x40, 0x62]
//
//   asn1_string_decode(b: bytes, pos: int) -> list
//     Decode ONE DER string-type TLV starting at byte offset pos in b.
//     Accepts UTF8String (0x0C), PrintableString (0x13), and IA5String (0x16).
//     Returns [dict{"tag": tag_int, "value": value_str}, next_pos].
//     On any error (unsupported tag, truncated, malformed length):
//       returns [dict{"tag": -1, "value": ""}, pos].
//
// PRIVATE HELPERS:
//   _asn1s_str_to_bytes(s) -> bytes   — convert string chars to raw octets
//   _asn1s_tlv(tag, content) -> bytes — build TLV: tag || DER_length || content
//   _asn1s_read_len(b, pos) -> list   — [decoded_length, next_pos] or [-1, pos]
//   _asn1s_bytes_to_str(b, s, e) -> str — convert bytes slice [s,e) to string
//
// DESIGN NOTES:
//   - LEAF module — no imports.
//   - Every byte read is bounds-checked before access.
//   - Single-exit style (let result / reassign) throughout to avoid the NOVA
//     return-null mistag bug.
//   - Binary content always uses bytes API, never string+chr.
//   - >> is arithmetic shift in NOVA; mask with &0xFF for byte extraction.
//
// KAT VECTORS (X.690 / RFC 5280 verified):
//   asn1_utf8_encode("hi")  == [0x0C, 0x02, 0x68, 0x69]
//   asn1_utf8_encode("")    == [0x0C, 0x00]
//   asn1_printable_encode("US") == [0x13, 0x02, 0x55, 0x53]
//   asn1_ia5_encode("a@b")  == [0x16, 0x03, 0x61, 0x40, 0x62]
//   round-trip: asn1_string_decode(asn1_utf8_encode(s), 0)[0]["value"] == s
// ============================================================================

// _asn1s_str_to_bytes: convert a NOVA string to a bytes value holding the
// raw octet values of each character.
//
// Uses ord() to get the integer code point of each character, then writes it
// into a bytes buffer via bytes_set.  This is correct for ASCII and for
// single-byte code points as used in all three target string types.
fn _asn1s_str_to_bytes(s: str) -> any
    let n = len(s)
    let out = bytes(n)
    for i in 0..n
        bytes_set(out, i, ord(slice(s, i, i + 1)))
    out

// _asn1s_tlv: build a complete DER TLV from a tag byte and pre-built content.
//
// Length encoding (X.690 §8.1.3 DER minimal form):
//   0..127   — short form: 1 byte equal to the length
//   128..255 — long form: 0x81 then one byte
//   256..65535 — long form: 0x82 then two big-endian bytes
//   (content longer than 65535 is not expected for string types in practice;
//    if needed, extend the else branch)
fn _asn1s_tlv(tag: int, content: any) -> any
    let clen = bytes_len(content)
    let out = bytes(0)
    out = bytes_append(out, tag)
    if clen < 128
        out = bytes_append(out, clen)
    else
        if clen < 256
            out = bytes_append(out, 129)
            out = bytes_append(out, clen)
        else
            let hi = clen / 256
            let lo = clen % 256
            out = bytes_append(out, 130)
            out = bytes_append(out, hi)
            out = bytes_append(out, lo)
    out = bytes_concat(out, content)
    out

// _asn1s_read_len: decode a DER length field at byte offset pos within b.
//
// Returns [decoded_length, first_content_byte_pos].
// Returns [-1, pos] on any error (truncated, indefinite form, k>4).
//
// Short form: first byte < 0x80 → length = that byte, content at pos+1.
// Long form:  first byte = 0x80|k → k subsequent bytes hold length big-endian.
// Indefinite form (byte == 0x80) → rejected with -1.
fn _asn1s_read_len(b: any, pos: int) -> any
    let total = bytes_len(b)
    let result = [-1, pos]
    if pos >= 0
        if pos < total
            let first = bytes_get(b, pos)
            if first < 128
                result = [first, pos + 1]
            else
                let k = first & 127
                if k == 0
                    // indefinite form — reject
                    result = [-1, pos + 1]
                else
                    if k > 4
                        // astronomically large — reject
                        result = [-1, pos]
                    else
                        if pos + k < total
                            let acc = 0
                            for j in 0..k
                                let bv = bytes_get(b, pos + 1 + j)
                                acc = acc * 256 + bv
                            result = [acc, pos + 1 + k]
    result

// _asn1s_bytes_to_str: reconstruct a NOVA string from bytes b in the
// half-open byte range [start, end_pos).
//
// Each byte is converted to a single-character string via chr() and
// concatenated.  This works correctly for ASCII and single-byte UTF-8
// characters (code points 0x00-0x7F).
// For multi-byte UTF-8 sequences (code points >= 0x80) the bytes are
// concatenated as individual chr() calls, which is correct because NOVA
// strings use the same raw byte representation internally.
//
// Bounds-checked: returns "" if start < 0 or end_pos > bytes_len(b).
fn _asn1s_bytes_to_str(b: any, start: int, end_pos: int) -> any
    let total = bytes_len(b)
    let result = ""
    if start >= 0
        if end_pos <= total
            let i = start
            while i < end_pos
                result = result + chr(bytes_get(b, i))
                i = i + 1
    result

// asn1_utf8_encode: DER TLV for UTF8String (tag 0x0C).
//
// Content = raw UTF-8 octets of s.  For ASCII strings this is identical to
// the ASCII byte values.  NOVA strings are stored as UTF-8, so the octet
// sequence matches the internal representation directly.
fn asn1_utf8_encode(s: str) -> any
    let content = _asn1s_str_to_bytes(s)
    _asn1s_tlv(12, content)

// asn1_printable_encode: DER TLV for PrintableString (tag 0x13).
//
// Content = ASCII octets of s.  This function does not validate that s
// contains only the PrintableString-permitted characters (caller's
// responsibility per X.680 §41.4).
fn asn1_printable_encode(s: str) -> any
    let content = _asn1s_str_to_bytes(s)
    _asn1s_tlv(19, content)

// asn1_ia5_encode: DER TLV for IA5String (tag 0x16).
//
// Content = 7-bit ASCII octets of s.  This function does not validate that
// s stays within the 7-bit range (caller's responsibility).
fn asn1_ia5_encode(s: str) -> any
    let content = _asn1s_str_to_bytes(s)
    _asn1s_tlv(22, content)

// asn1_string_decode: decode ONE DER string TLV at position pos in b.
//
// Accepted tags:
//   0x0C (12)  UTF8String
//   0x13 (19)  PrintableString
//   0x16 (22)  IA5String
//
// Algorithm:
//   1. Bounds-check: need at least 2 bytes (tag + length byte).
//   2. Read tag; reject if not in the accepted set.
//   3. Parse DER length via _asn1s_read_len.
//   4. Verify content range fits within b.
//   5. Convert content bytes to string via _asn1s_bytes_to_str.
//   6. Build and return [dict{"tag":tag,"value":value}, next_pos].
//
// On any error returns [dict{"tag":-1,"value":""}, pos].
fn asn1_string_decode(b: any, pos: int) -> any
    let total = bytes_len(b)
    let err_dict = {"tag": -1, "value": ""}
    let result = [err_dict, pos]
    if pos >= 0
        if pos + 1 < total
            let tag = bytes_get(b, pos)
            let tag_ok = 0
            if tag == 12
                tag_ok = 1
            if tag == 19
                tag_ok = 1
            if tag == 22
                tag_ok = 1
            if tag_ok == 1
                let lr = _asn1s_read_len(b, pos + 1)
                let clen = lr[0]
                let cstart = lr[1]
                if clen >= 0
                    let cend = cstart + clen
                    if cend <= total
                        let value = _asn1s_bytes_to_str(b, cstart, cend)
                        let d = {"tag": tag, "value": value}
                        result = [d, cend]
    result
