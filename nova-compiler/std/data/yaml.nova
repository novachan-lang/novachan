// ============================================================================
// NOVA Standard Library — std/data/yaml
// ============================================================================
// YAML 1.2 (common subset) PARSER. Parses indentation-based block YAML into
// nested NOVA values: dict for block mappings, list for block sequences, and
// TYPED scalars (int / float / bool / null / string) for leaves — unlike
// forge_yaml.nova (a config-reader that intentionally keeps every scalar as a
// string), this module infers the YAML core-schema scalar type so callers get
// real int/float/bool/null values straight out of yaml_parse.
//
// PUBLIC API:
//   yaml_parse(text: string) -> any
//     Parse a whole YAML document. Root is a dict (block mapping), a list
//     (block sequence), or a bare scalar. Blank lines and comment-only lines
//     are dropped. Indentation defines nesting (any consistent step; 2 spaces
//     is typical). Supports:
//       - block mappings:  `key: value`, nested by indentation
//       - block sequences: `- item` (scalar or nested map/seq items), with
//         the `-` marker EITHER indented deeper than the parent mapping key
//         OR at the SAME column as it (YAML 1.2 sec 8.2.1; the latter is the
//         dominant k8s/docker-compose/GitHub-Actions/Ansible style)
//       - scalars: bare (type-inferred) and single/double-quoted (always string)
//       - comments: `#` to end-of-line (quote-aware — a `#` inside a quoted
//         scalar is NOT treated as a comment start)
//       - core-schema scalar typing: `true`/`false` -> bool, `null`/`~`/empty
//         -> null, integer/float lexical forms -> int/float, everything else
//         -> string
//
//   yaml_get(node: any, path: string) -> any
//     Dotted-path lookup ("database.port") into a parsed structure. "" if any
//     segment is missing or a segment is not a dict.
//
// SUBSET LIMITS (out of scope, matches forge_yaml's documented subset): flow
// style (`[a, b]` / `{a: 1}`), multi-line block scalars (`|` and `>`), anchors
// & aliases, multiple documents (`---`), tabs for indentation (YAML forbids
// them anyway), and explicit typing tags (`!!int`).
//
// LEAF MODULE — imports nothing.
//
// KAT vector (hand-computed against YAML 1.2 core schema):
//   yaml_parse("name: NOVA\nversion: 1\nactive: true\ntags:\n  - a\n  - b\n
//     db:\n  host: localhost\n  port: 5432\n")
//   -> {"name":"NOVA","version":1,"active":true,"tags":["a","b"],
//       "db":{"host":"localhost","port":5432}}
// ============================================================================

// ── Private: indentation / comment / quote scanning ──────────────────────────

// PRIVATE: count leading spaces (the indentation level) of a raw line.
// Scans via a pre-split `chars()` list (O(1) per index) rather than repeated
// char_at(line, i) calls -- char_at re-decodes UTF-8 from the START of the
// string on every call (O(index) per call), so an index-incrementing
// char_at loop is O(L^2) per line, not O(L). On a line with large L (e.g. a
// deeply-indented line in a pathologically nested document, or simply a
// very long line) that quadratic-per-line cost is a real CPU-exhaustion
// blowup -- see the identical fix in _y_strip_comment/_y_colon/
// _y_is_int_token/_y_is_float_token/_y_unescape_dq below.
fn _y_indent(line: string) -> int
    let cs = chars(line)
    let n = len(cs)
    let ind = 0
    let i = 0
    let stop = 0
    while i < n and stop == 0
        if cs[i] == " "
            ind += 1
            i += 1
        else
            stop = 1
    ind

// PRIVATE: quote-aware `#`-comment stripper. A `#` counts as a comment start
// only when it is the first character of the line or is preceded by a space,
// AND it is not inside a single- or double-quoted span. Returns the line with
// the comment (and nothing else) removed; indentation on the left is kept.
// (See _y_indent above for why this scans via chars() instead of char_at-in-
// a-loop: char_at is O(index) per call, making an incrementing-index loop
// over it O(L^2) per line.)
fn _y_strip_comment(line: string) -> string
    let dq = chr(34)
    let sq = chr(39)
    let hash = chr(35)
    let cs = chars(line)
    let n = len(cs)
    let i = 0
    let inQuote = 0
    let cutAt = -1
    while i < n and cutAt < 0
        let c = cs[i]
        if inQuote == 1
            if c == sq
                inQuote = 0
        else
            if inQuote == 2
                if c == dq
                    inQuote = 0
            else
                if c == sq
                    inQuote = 1
                else
                    if c == dq
                        inQuote = 2
                    else
                        if c == hash
                            if i == 0
                                cutAt = i
                            else
                                if cs[i - 1] == " "
                                    cutAt = i
        i += 1
    let out = line
    if cutAt >= 0
        out = slice(line, 0, cutAt)
    out

// PRIVATE: quote-aware index of the first `key: value` separator in a content
// string. A `:` counts as a separator only when it is followed by a space or
// is the last character, AND it is not inside a quoted span (so a quoted key
// like "a: b": 1 is handled correctly). Returns -1 if this is not a mapping
// line. (See _y_indent above for why this scans via chars() instead of
// char_at-in-a-loop.)
fn _y_colon(content: string) -> int
    let dq = chr(34)
    let sq = chr(39)
    let cs = chars(content)
    let n = len(cs)
    let i = 0
    let inQuote = 0
    let result = -1
    while i < n and result < 0
        let c = cs[i]
        if inQuote == 1
            if c == sq
                inQuote = 0
        else
            if inQuote == 2
                if c == dq
                    inQuote = 0
            else
                if c == sq
                    inQuote = 1
                else
                    if c == dq
                        inQuote = 2
                    else
                        if c == ":"
                            if i == n - 1
                                result = i
                            else
                                if cs[i + 1] == " "
                                    result = i
        i += 1
    result

// ── Private: scalar type inference (YAML core schema) ────────────────────────

// PRIVATE: 1 if code-point o is ASCII '0'-'9'.
fn _y_is_digit(o: int) -> int
    let r = 0
    if o >= 48 and o <= 57
        r = 1
    r

// PRIVATE: 1 if trimmed token `tok` is a plain decimal integer literal
// (optional leading sign, digits only). Scans via chars() (O(1) per index),
// not char_at-in-a-loop -- see _y_indent's comment for why (char_at is
// O(index) per call, so an incrementing-index loop over it is O(L^2)).
fn _y_is_int_token(tok: string) -> int
    let cs = chars(tok)
    let n = len(cs)
    let result = 0
    if n > 0
        let i = 0
        if cs[0] == "-" or cs[0] == "+"
            i = 1
        if i < n
            let ok = 1
            let sawDigit = 0
            while i < n
                if _y_is_digit(ord(cs[i])) == 1
                    sawDigit = 1
                else
                    ok = 0
                i += 1
            if ok == 1 and sawDigit == 1
                result = 1
    result

// PRIVATE: 1 if trimmed token `tok` is a decimal float literal (optional
// leading sign, digits, optional single '.', optional single exponent
// 'e'/'E' with optional sign) — requires a '.' or an exponent to distinguish
// from an integer. Scans via chars() -- see _y_is_int_token above.
fn _y_is_float_token(tok: string) -> int
    let cs = chars(tok)
    let n = len(cs)
    let result = 0
    if n > 0
        let i = 0
        if cs[0] == "-" or cs[0] == "+"
            i = 1
        if i < n
            let ok = 1
            let sawDigit = 0
            let dotSeen = 0
            let expSeen = 0
            while i < n
                let c = cs[i]
                if _y_is_digit(ord(c)) == 1
                    sawDigit = 1
                    i += 1
                else
                    if c == "." and dotSeen == 0 and expSeen == 0
                        dotSeen = 1
                        i += 1
                    else
                        if (c == "e" or c == "E") and expSeen == 0 and sawDigit == 1
                            expSeen = 1
                            i += 1
                            if i < n and (cs[i] == "-" or cs[i] == "+")
                                i += 1
                        else
                            ok = 0
                            i = n
            if ok == 1 and sawDigit == 1 and (dotSeen == 1 or expSeen == 1)
                result = 1
    result

// PRIVATE: unescape a double-quoted YAML scalar body (backslash escapes).
// Scans via chars() (see _y_indent's comment: char_at-in-a-loop is O(L^2)
// per call to this function, not O(L)) and accumulates output chunks in a
// list, joined ONCE at the end (O(n) total) rather than repeated string `+`
// (each `+` reallocates and copies the WHOLE accumulated-so-far string --
// also O(n) per character, O(n^2) total). Both were real CPU-exhaustion
// blowups on a large double-quoted scalar, e.g. a certificate/blob pasted
// into a config value as a quoted string.
fn _y_unescape_dq(inner: string) -> string
    let cs = chars(inner)
    let n = len(cs)
    let parts = []
    let i = 0
    while i < n
        let c = cs[i]
        if c == "\\" and i + 1 < n
            let e = cs[i + 1]
            if e == "n"
                push(parts, chr(10))
            else
                if e == "t"
                    push(parts, chr(9))
                else
                    if e == "r"
                        push(parts, chr(13))
                    else
                        if e == chr(34)
                            push(parts, chr(34))
                        else
                            if e == "\\"
                                push(parts, "\\")
                            else
                                push(parts, e)
            i += 2
        else
            push(parts, c)
            i += 1
    join(parts, "")

// PRIVATE: convert a trimmed raw scalar (as it appeared after the `:` or the
// `- `) into a typed NOVA value. Quoted scalars (single or double) are always
// strings, with double-quoted scalars unescaped. Unquoted scalars are typed
// against the YAML core schema: null/~/empty -> null, true/false -> bool,
// integer/float lexical forms -> int/float, else -> string.
fn _y_scalar_value(raw: string) -> any
    let s = trim(raw)
    let n = len(s)
    let dq = chr(34)
    let sq = chr(39)
    let isQuoted = 0
    let quoteCh = ""
    if n >= 2
        let f = char_at(s, 0)
        if (f == dq or f == sq) and char_at(s, n - 1) == f
            isQuoted = 1
            quoteCh = f
    let out = null
    if isQuoted == 1
        let inner = slice(s, 1, n - 1)
        if quoteCh == dq
            out = _y_unescape_dq(inner)
        else
            out = inner
    else
        if n == 0
            out = null
        else
            if s == "null" or s == "Null" or s == "NULL" or s == "~"
                out = null
            else
                if s == "true" or s == "True" or s == "TRUE"
                    out = true
                else
                    if s == "false" or s == "False" or s == "FALSE"
                        out = false
                    else
                        if _y_is_int_token(s) == 1
                            // parse_int_safe (not the raw parse_int/atoll
                            // path): atoll's overflow behavior is undefined
                            // by the C standard, and _y_is_int_token accepts
                            // any-length all-digit tokens. A literal whose
                            // magnitude exceeds i64 (e.g. 40 nines) safely
                            // falls back to this module's normal "can't type
                            // it -> string" convention instead of ever
                            // reaching that overflow.
                            let ir = parse_int_safe(s)
                            if is_ok(ir) == 1
                                out = unwrap(ir)
                            else
                                out = s
                        else
                            if _y_is_float_token(s) == 1
                                out = parse_float(s)
                            else
                                out = s
    out

// ── Private: block structure parser (indentation -> nested dict/list) ────────

// _Y_MAX_DEPTH: safety cap on _y_block's nesting-recursion depth. _y_block
// recurses into itself once per level of block nesting (a mapping key or
// sequence item whose value is itself a nested block -- see the 3 call
// sites below). Unbounded input such as ~20000 levels of nested mapping
// keys (each one indented further than its parent, however slightly) would
// otherwise recurse 1 native stack frame per level with no limit -> stack
// overflow (crash/UB). Past this cap, the boundary each nested block spans
// (already computed iteratively by _y_value_span/_y_child_end/_y_list_end,
// unconditionally, to advance the caller's scan position) is used to skip
// over the block WITHOUT recursing into it; that key/item's value becomes
// null instead -- the same convention this parser already uses for an
// ordinary dangling key with no nested value.
let _Y_MAX_DEPTH = 1000

// PRIVATE: for the line at index `idx`, find the end of the block of lines
// strictly more-indented than `min_indent` (its children). Returns the first
// index at or after idx+1 whose indent is <= min_indent (or `end`).
fn _y_child_end(lines: list, idx: int, end: int, min_indent: int) -> int
    let j = idx + 1
    let stop = 0
    while j < end and stop == 0
        let row = lines[j]
        if row[0] > min_indent
            j += 1
        else
            stop = 1
    j

// PRIVATE: for a SAME-INDENT block sequence whose first item row is at index
// `idx` (a `- ...` row sitting at `base_indent` -- the same column as the
// mapping key it is the value of), find the end of that sequence: the first
// index at or after idx whose row is at indent < base_indent (dedent out of
// the mapping entirely), OR at indent == base_indent but is NOT itself a
// sequence-item line (i.e. it's the next sibling key of the same mapping,
// terminating the list). Rows with indent > base_indent are nested content
// belonging to the current sequence item (e.g. a mapping item's extra
// fields) and are always included.
fn _y_list_end(lines: list, idx: int, end: int, base_indent: int) -> int
    let j = idx
    let stop = 0
    while j < end and stop == 0
        let row = lines[j]
        if row[0] < base_indent
            stop = 1
        else
            if row[0] == base_indent
                let content = row[1]
                if starts_with(content, "- ") or content == "-"
                    j += 1
                else
                    stop = 1
            else
                j += 1
    j

// PRIVATE: resolve the nested-value block that follows an empty `key:` (or
// dangling `- key:`) row at index `i` (indent `base_indent`) in `lines`.
// Returns a 2-element list [value_end, value_indent]:
//   - value_end    the first line index PAST the nested value's rows (equal
//                   to i+1 when there IS no nested value, i.e. a dangling key)
//   - value_indent the indentation `_y_block` should recurse at to build the
//                   value: `base_indent` itself for a same-indent block
//                   sequence (the fix -- YAML 1.2 sec 8.2.1), or the deeper
//                   child rows' own indent for the ordinary nested-block case.
// Caller must still check `value_end > i + 1` before treating the result as
// a real (non-null) nested value.
fn _y_value_span(lines: list, i: int, end: int, base_indent: int) -> list
    let result = []
    if i + 1 >= end
        push(result, i + 1)
        push(result, base_indent)
    else
        let nextRow = lines[i + 1]
        if nextRow[0] == base_indent
            let nextContent = nextRow[1]
            if starts_with(nextContent, "- ") or nextContent == "-"
                // Same-indent block sequence: this key's value.
                push(result, _y_list_end(lines, i + 1, end, base_indent))
                push(result, base_indent)
            else
                // Another line at this key's own column that isn't a
                // sequence item -- no nested value (dangling key).
                push(result, i + 1)
                push(result, base_indent)
        else
            if nextRow[0] > base_indent
                push(result, _y_child_end(lines, i, end, base_indent))
                push(result, nextRow[0])
            else
                push(result, i + 1)
                push(result, base_indent)
    result

// PRIVATE: build a NOVA value from block lines[start..end) that sit at exactly
// `base_indent`. `lines` is a list of [indent:int, content:string] rows
// (blank/comment-only lines already dropped). Returns a LIST if the block's
// rows are sequence items (`- ...`), otherwise a MAPPING (dict). Recurses for
// nested blocks. Scalar leaves are typed via _y_scalar_value. `depth` is the
// current nesting depth (0 at the document root); see _Y_MAX_DEPTH -- once
// it is reached, further nested values are bounded to null rather than
// recursing (DEEP-NESTING DoS guard).
fn _y_block(lines: list, start: int, end: int, base_indent: int, depth: int) -> any
    // Peek the first row at base_indent to decide list vs mapping.
    let firstContent = ""
    let k = start
    let found = 0
    while k < end and found == 0
        let probe = lines[k]
        if probe[0] == base_indent
            firstContent = probe[1]
            found = 1
        else
            k += 1

    let isList = starts_with(firstContent, "- ") or firstContent == "-"
    let result = null

    if isList
        let arr = []
        let i = start
        while i < end
            let row = lines[i]
            if row[0] == base_indent
                let content = row[1]
                if starts_with(content, "- ") or content == "-"
                    let rest = ""
                    if len(content) > 2
                        rest = trim(slice(content, 2, len(content)))
                    let childEnd = _y_child_end(lines, i, end, base_indent)
                    let colon = _y_colon(rest)
                    if colon < 0 and len(rest) > 0
                        // Pure scalar sequence item: `- value`.
                        push(arr, _y_scalar_value(rest))
                        i += 1
                    else
                        // Mapping sequence item: `- key: value` (+ possibly
                        // deeper child lines forming further sibling keys).
                        // Sibling keys -- and this item's OWN inline key, if
                        // it turns out to have a nested value -- sit at the
                        // inline key's column (base_indent + 2). A nested
                        // value can be either an ordinary deeper-indented
                        // block OR a block SEQUENCE at that SAME column
                        // (YAML 1.2 sec 8.2.1) -- `_y_value_span` decides
                        // which, exactly like the top-level mapping case
                        // above, and reports how many rows it consumed so
                        // the sibling scan below never re-reads them.
                        let item = {}
                        let mapIndent = base_indent + 2
                        let siblingStart = i + 1
                        if colon >= 0
                            let ikey = trim(slice(rest, 0, colon))
                            let ival = trim(slice(rest, colon + 1, len(rest)))
                            if len(ival) > 0
                                item[ikey] = _y_scalar_value(ival)
                            else
                                let ispan = _y_value_span(lines, i, childEnd, mapIndent)
                                let ivalEnd = ispan[0]
                                let ivalIndent = ispan[1]
                                if ivalEnd > i + 1
                                    if depth < _Y_MAX_DEPTH
                                        item[ikey] = _y_block(lines, i + 1, ivalEnd, ivalIndent, depth + 1)
                                    else
                                        item[ikey] = null
                                else
                                    item[ikey] = null
                                siblingStart = ivalEnd
                        let j = siblingStart
                        while j < childEnd
                            let mrow = lines[j]
                            if mrow[0] == mapIndent
                                let mcontent = mrow[1]
                                let mcolon = _y_colon(mcontent)
                                if mcolon >= 0
                                    let mkey = trim(slice(mcontent, 0, mcolon))
                                    let mval = trim(slice(mcontent, mcolon + 1, len(mcontent)))
                                    if len(mval) > 0
                                        item[mkey] = _y_scalar_value(mval)
                                        j += 1
                                    else
                                        let mspan = _y_value_span(lines, j, childEnd, mapIndent)
                                        let mvalEnd = mspan[0]
                                        let mvalIndent = mspan[1]
                                        if mvalEnd > j + 1
                                            if depth < _Y_MAX_DEPTH
                                                item[mkey] = _y_block(lines, j + 1, mvalEnd, mvalIndent, depth + 1)
                                            else
                                                item[mkey] = null
                                        else
                                            item[mkey] = null
                                        j = mvalEnd
                                else
                                    j += 1
                            else
                                j += 1
                        push(arr, item)
                        i = childEnd
                else
                    i += 1
            else
                i += 1
        result = arr
    else
        // MAPPING.
        let out = {}
        let i = start
        while i < end
            let row = lines[i]
            if row[0] == base_indent
                let content = row[1]
                let colon = _y_colon(content)
                if colon >= 0
                    let key = trim(slice(content, 0, colon))
                    let val = trim(slice(content, colon + 1, len(content)))
                    if len(val) > 0
                        out[key] = _y_scalar_value(val)
                        i += 1
                    else
                        // Empty value -> nested block: either the ordinary
                        // deeper-indented case, or a block SEQUENCE at the
                        // SAME indentation as this key (YAML 1.2 sec 8.2.1).
                        let span = _y_value_span(lines, i, end, base_indent)
                        let valEnd = span[0]
                        let valIndent = span[1]
                        if valEnd > i + 1
                            if depth < _Y_MAX_DEPTH
                                out[key] = _y_block(lines, i + 1, valEnd, valIndent, depth + 1)
                            else
                                out[key] = null
                        else
                            out[key] = null
                        i = valEnd
                else
                    i += 1
            else
                i += 1
        result = out
    result

// ── Public API ─────────────────────────────────────────────────────────────

// Parse a whole YAML document into a nested dict/list with typed scalars.
// Blank lines and comment-only lines are dropped; every remaining line
// becomes an [indent, content] row, then the recursive block parser builds
// the structure from indentation.
fn yaml_parse(text: string) -> any
    let raw = split(text, chr(10))
    let lines = []
    for rl in raw
        let stripped = _y_strip_comment(rl)
        let content = trim(stripped)
        if len(content) > 0
            let row = []
            push(row, _y_indent(stripped))
            push(row, content)
            push(lines, row)
    let out = null
    if len(lines) == 0
        out = {}
    else
        let first = lines[0]
        out = _y_block(lines, 0, len(lines), first[0], 0)
    out

// Dotted-path lookup ("database.port") into the parsed structure; "" if any
// segment is missing or a segment is not a dict. Walks dicts only (list
// indexing is not part of the path grammar).
fn yaml_get(node: any, path: string) -> any
    let segs = split(path, ".")
    let cur = node
    let bad = 0
    for seg in segs
        if bad == 0
            if type_of(cur) == "dict" and seg in cur
                cur = cur[seg]
            else
                bad = 1
    let out = cur
    if bad == 1
        out = ""
    out
