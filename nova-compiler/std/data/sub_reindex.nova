// ============================================================================
// NOVA Standard Library — std/data/sub_reindex
// ============================================================================
// Subtitle cue reindexing, sorting, renumbering, and validation.
//
// CUE SHAPE: dict {"index":int,"start":ms,"end":ms,"text":string}
//   where ms = milliseconds (integer).
//
// PUBLIC API
//   sub_reindex(cues) -> list
//       Return a new list of cues with index fields set to 1..N (preserving order).
//
//   sub_sort(cues) -> list
//       Return a new list of cues sorted by "start" ascending (stable insertion sort).
//
//   sub_renumber_from(cues, start_idx) -> list
//       Return a new list of cues with index fields starting at `start_idx`.
//
//   sub_validate(cues) -> bool (returned as int: 1=valid, 0=invalid)
//       Validate that:
//         1. Indices are sequential starting from 1 (cues[0]["index"]==1, etc.)
//         2. Each cue has start < end.
//         3. Cues are non-overlapping (each cue's start >= previous cue's end).
//
// LEAF — imports NOTHING.
// ============================================================================

// _sri_clone_cue: create a shallow copy of a cue dict.
fn _sri_clone_cue(c)
    let out = {}
    out["index"] = c["index"]
    out["start"] = c["start"]
    out["end"] = c["end"]
    out["text"] = c["text"]
    return out

// sub_reindex: reassign index fields 1..N in-order.
//
// Returns a new list; original cues are not mutated.
// Preserves the order of the input list.
//
// Example:
//   cues with indices [5,9,2] -> reindexed [1,2,3]
fn sub_reindex(cues)
    let result = []
    let n = len(cues)
    let i = 0
    while i < n
        let c = _sri_clone_cue(cues[i])
        c["index"] = i + 1
        push(result, c)
        i = i + 1
    return result

// sub_sort: sort cues by "start" ascending using insertion sort.
//
// Returns a new list (does not mutate input).
// The sort is stable: cues with equal start times retain their relative order.
//
// Example:
//   cues [{start:9000,...},{start:1000,...},{start:5000,...}]
//     -> [{start:1000,...},{start:5000,...},{start:9000,...}]
fn sub_sort(cues)
    // First clone all cues into the result list
    let result = []
    let n = len(cues)
    let i = 0
    while i < n
        push(result, _sri_clone_cue(cues[i]))
        i = i + 1
    // Insertion sort by start
    let j = 1
    while j < n
        let key_cue = result[j]
        let key_start = key_cue["start"]
        let k = j - 1
        while k >= 0 and result[k]["start"] > key_start
            result[k + 1] = result[k]
            k = k - 1
        result[k + 1] = key_cue
        j = j + 1
    return result

// sub_renumber_from: reassign index fields starting from `start_idx`.
//
// Returns a new list; original cues are not mutated.
// The input order is preserved; indices become start_idx, start_idx+1, ...
//
// Example:
//   cues with indices [1,2,3], start_idx=10 -> indices [10,11,12]
fn sub_renumber_from(cues, start_idx)
    let result = []
    let n = len(cues)
    let i = 0
    while i < n
        let c = _sri_clone_cue(cues[i])
        c["index"] = start_idx + i
        push(result, c)
        i = i + 1
    return result

// sub_validate: check structural correctness of a cue list.
//
// Returns 1 (valid) if ALL of:
//   1. Indices are sequential starting from 1: cues[0]["index"]==1, cues[1]["index"]==2, ...
//   2. Every cue has start < end (positive duration).
//   3. Cues are non-overlapping: cues[i]["start"] >= cues[i-1]["end"] for all i>0.
//
// Returns 0 on the first violation.
// An empty list is considered valid.
//
// Examples:
//   [{index:1,start:0,end:1000,...}] -> 1 (valid)
//   [{index:1,start:1000,end:500,...}] -> 0 (start >= end)
//   [{index:2,start:0,end:1000,...}] -> 0 (first index != 1)
fn sub_validate(cues)
    let n = len(cues)
    let valid = 1
    let i = 0
    while i < n and valid == 1
        let c = cues[i]
        // Rule 1: sequential index
        if c["index"] != i + 1
            valid = 0
        // Rule 2: start < end
        if valid == 1 and c["start"] >= c["end"]
            valid = 0
        // Rule 3: non-overlapping (start >= previous end)
        if valid == 1 and i > 0
            let prev = cues[i - 1]
            if c["start"] < prev["end"]
                valid = 0
        i = i + 1
    return valid
