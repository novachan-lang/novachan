// ============================================================================
// NOVA Standard Library — std/data/opml_parse
// ============================================================================
// OPML (Outline Processor Markup Language) parser.
//
// PUBLIC API
//   opml_parse(xml) -> dict
//     Returns: {"title": string, "outlines": list}
//     Each outline: {"text": string, "xmlUrl": string, "children": list}
//
// IMPLEMENTATION NOTES
//   • Leaf module — imports nothing.
//   • String search by character comparison.
//   • All private helpers prefixed _oparse_ to avoid link collisions.
//   • chr(34)='"' chr(47)='/' chr(60)='<' chr(62)='>'
//   • Single-exit style throughout (NOVA return-null mistag avoidance).
//   • AVOID reserved words as param/variable names: until/loop/match/in/type
//     (use upto/run/m/item/kind instead).
// ============================================================================

// ── Private: find first occurrence of needle starting at from ────────────────

fn _oparse_find(s, needle, from)
    let ns = len(s)
    let nn = len(needle)
    let result = 0 - 1
    if nn > 0
        let i = from
        let go = 1
        while go == 1
            if i + nn > ns
                go = 0
            else
                let match_ok = 1
                let j = 0
                let mgo = 1
                while mgo == 1
                    if j >= nn
                        mgo = 0
                    else
                        if char_at(s, i + j) != char_at(needle, j)
                            match_ok = 0
                            mgo = 0
                        else
                            j = j + 1
                if match_ok == 1
                    result = i
                    go = 0
                else
                    i = i + 1
    return result

// ── Private: extract text between first open_tag and close_tag after from ────

fn _oparse_between(s, open_tag, close_tag, from)
    let p1 = _oparse_find(s, open_tag, from)
    let result = ""
    if p1 >= 0
        let p2 = p1 + len(open_tag)
        let p3 = _oparse_find(s, close_tag, p2)
        if p3 >= 0
            result = slice(s, p2, p3)
    return result

// ── Private: extract attr="..." value from tag_content string ────────────────

fn _oparse_attr(tag_content, attr_name)
    let dq = chr(34)
    let needle = attr_name + "=" + dq
    let p1 = _oparse_find(tag_content, needle, 0)
    let result = ""
    if p1 >= 0
        let start = p1 + len(needle)
        let ns = len(tag_content)
        let end_pos = start
        let go = 1
        while go == 1
            if end_pos >= ns
                go = 0
            else
                if char_at(tag_content, end_pos) == dq
                    go = 0
                else
                    end_pos = end_pos + 1
        result = slice(tag_content, start, end_pos)
    return result

// ── Private: find position after next '>' starting from pos ──────────────────

fn _oparse_skip_gt(s, pos)
    let ns = len(s)
    let i = pos
    let result = ns
    let go = 1
    while go == 1
        if i >= ns
            go = 0
        else
            if char_at(s, i) == ">"
                result = i + 1
                go = 0
            else
                i = i + 1
    return result

// ── Private: check if tag_content ends with "/" (self-closing) ───────────────

fn _oparse_is_sc(tag_content)
    let n = len(tag_content)
    let result = 0
    if n > 0
        let i = n - 1
        let go = 1
        while go == 1
            if i < 0
                go = 0
            else
                let o = ord(char_at(tag_content, i))
                if o == 32
                    i = i - 1
                else
                    if o == 9
                        i = i - 1
                    else
                        if o == 10
                            i = i - 1
                        else
                            if o == 47
                                result = 1
                            go = 0
    return result

// ── Private: check if xml[p..p+np-1] matches prefix ─────────────────────────

fn _oparse_starts(xml, ns, prefix, p)
    let np = len(prefix)
    let result = 0
    if p + np <= ns
        let all_match = 1
        let j = 0
        let go = 1
        while go == 1
            if j >= np
                go = 0
            else
                if char_at(xml, p + j) != char_at(prefix, j)
                    all_match = 0
                    go = 0
                else
                    j = j + 1
        result = all_match
    return result

// ── Private: tokenize body region into outline open/selfclose/close tokens ───
// NOTE: param renamed from 'until' (reserved keyword) to 'upto'.

fn _oparse_tokenize(xml, from, upto)
    let tokens = []
    let pos = from
    let ns = len(xml)
    let go = 1
    while go == 1
        if pos >= upto
            go = 0
        else
            // find next '<' in [pos, upto)
            let p = pos
            let find_go = 1
            while find_go == 1
                if p >= upto
                    find_go = 0
                else
                    if char_at(xml, p) == "<"
                        find_go = 0
                    else
                        p = p + 1
            if p >= upto
                go = 0
            else
                // p is at '<'
                let is_close = _oparse_starts(xml, ns, "</outline", p)
                if is_close == 1
                    let after = _oparse_skip_gt(xml, p + 1)
                    let tok = {}
                    tok["type"] = "close"
                    tok["text"] = ""
                    tok["xmlUrl"] = ""
                    push(tokens, tok)
                    pos = after
                else
                    let is_open = _oparse_starts(xml, ns, "<outline", p)
                    if is_open == 1
                        let nc_pos = p + 8
                        let nc_ok = 0
                        if nc_pos < ns
                            let nc_o = ord(char_at(xml, nc_pos))
                            if nc_o == 32
                                nc_ok = 1
                            else
                                if nc_o == 47
                                    nc_ok = 1
                                else
                                    if nc_o == 62
                                        nc_ok = 1
                        else
                            nc_ok = 1
                        if nc_ok == 1
                            let gt_pos = _oparse_skip_gt(xml, p + 1)
                            let tc = slice(xml, p + 1, gt_pos - 1)
                            let sc = _oparse_is_sc(tc)
                            let txt = _oparse_attr(tc, "text")
                            let xu = _oparse_attr(tc, "xmlUrl")
                            let tok2 = {}
                            if sc == 1
                                tok2["type"] = "selfclose"
                            else
                                tok2["type"] = "open"
                            tok2["text"] = txt
                            tok2["xmlUrl"] = xu
                            push(tokens, tok2)
                            pos = gt_pos
                        else
                            pos = p + 1
                    else
                        pos = p + 1
    return tokens

// ── Private: build tree from tokens using index-based parallel stacks ─────────

fn _oparse_build(tokens)
    let root = []
    let cur = root
    let stk_lists = []
    let stk_texts = []
    let stk_urls = []
    let n = len(tokens)
    let i = 0
    while i < n
        let tok = tokens[i]
        let tt = tok["type"]
        if tt == "selfclose"
            let outline = {}
            outline["text"] = tok["text"]
            outline["xmlUrl"] = tok["xmlUrl"]
            outline["children"] = []
            push(cur, outline)
        else
            if tt == "open"
                push(stk_lists, cur)
                push(stk_texts, tok["text"])
                push(stk_urls, tok["xmlUrl"])
                let new_children = []
                cur = new_children
            else
                // "close"
                let depth = len(stk_lists)
                if depth > 0
                    let last = depth - 1
                    let par = stk_lists[last]
                    let otxt = stk_texts[last]
                    let oxu = stk_urls[last]
                    let nl = []
                    let nt = []
                    let nu = []
                    let k = 0
                    while k < last
                        push(nl, stk_lists[k])
                        push(nt, stk_texts[k])
                        push(nu, stk_urls[k])
                        k = k + 1
                    stk_lists = nl
                    stk_texts = nt
                    stk_urls = nu
                    let outline2 = {}
                    outline2["text"] = otxt
                    outline2["xmlUrl"] = oxu
                    outline2["children"] = cur
                    push(par, outline2)
                    cur = par
        i = i + 1
    return cur

// ── Public: opml_parse ───────────────────────────────────────────────────────

// opml_parse: parse an OPML XML string into a structured dict.
//
// Returns {"title": string, "outlines": list}
// Each outline: {"text": string, "xmlUrl": string, "children": list}
fn opml_parse(xml)
    let head = _oparse_between(xml, "<head>", "</head>", 0)
    let title = ""
    if len(head) > 0
        title = _oparse_between(head, "<title>", "</title>", 0)
    let body_open = "<body>"
    let body_close = "</body>"
    let bp = _oparse_find(xml, body_open, 0)
    let outlines = []
    if bp >= 0
        let bstart = bp + len(body_open)
        let bend = _oparse_find(xml, body_close, bstart)
        let blen = len(xml)
        let bupto = blen
        if bend >= 0
            bupto = bend
        let tokens = _oparse_tokenize(xml, bstart, bupto)
        outlines = _oparse_build(tokens)
    let doc = {}
    doc["title"] = title
    doc["outlines"] = outlines
    return doc
