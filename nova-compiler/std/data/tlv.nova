// std/data/tlv -- Type-Length-Value (TLV) binary encoding over the native `bytes` type.
//
// TLV is the backbone of many wire protocols (BER/DER ASN.1, EMV payment cards, SNMP,
// Bluetooth HCI, NFC, numerous proprietary protocols). The encoding is deliberately
// minimal: each record is exactly 3 fields:
//
//   +--------+--------+----------------+
//   |  type  | length |  value bytes   |
//   | 1 byte | 1 byte |  length bytes  |
//   +--------+--------+----------------+
//
// This implements the single-byte length variant (len 0..254; len=255 reserved as an
// escape for future multi-byte lengths). Values may be any bytes, including embedded
// NUL bytes (the API is NUL-safe; length is authoritative, not strlen).
//
// Public API (prefix tl_):
//   tl_bytes(s)               -> bytes  (convert a string to bytes -- convenience helper)
//   tl_encode(type, val)      -> bytes  (encode one TLV record)
//   tl_decode_at(buf, pos)    -> list   ([type:int, value:bytes, next_pos:int])
//   tl_encode_all(items)      -> bytes  (encode list of [type, valuebytes] pairs)
//   tl_decode_all(buf)        -> list   (list of [type:int, value:bytes] pairs)
//
// LEAF -- imports nothing.

// tl_bytes: convert a NOVA string to a bytes value. Convenience helper so callers
// can write tl_bytes("AB") instead of str_to_bytes("AB").
fn tl_bytes(s) -> any
    str_to_bytes(s)

// tl_encode: encode a single TLV record.
// type must be 0..255; value must be a bytes value of length 0..254.
// Returns a bytes value: [type_byte, len_byte, ...value_bytes...].
fn tl_encode(type_tag: int, val) -> any
    let vlen = bytes_len(val)
    let out = bytes(0)
    out = bytes_append(out, type_tag & 255)
    out = bytes_append(out, vlen & 255)
    out = bytes_concat(out, val)
    out

// tl_decode_at: decode a single TLV record starting at byte position pos in buf.
// Returns a three-element list: [type:int, value:bytes, next_pos:int].
// type is the tag byte (0..255); value is a bytes value of `length` bytes;
// next_pos is the position after this record (= pos + 2 + length).
fn tl_decode_at(buf, pos: int) -> list
    let type_tag = bytes_get(buf, pos)
    let vlen = bytes_get(buf, pos + 1)
    let val = bytes_slice(buf, pos + 2, pos + 2 + vlen)
    let next_pos = pos + 2 + vlen
    [type_tag, val, next_pos]

// tl_encode_all: encode a list of [type, valuebytes] pairs into a single bytes blob.
// items is a NOVA list where each element is a two-element list [type:int, valuebytes:bytes].
// Returns the concatenation of all encoded TLV records.
fn tl_encode_all(items) -> any
    let n = len(items)
    let out = bytes(0)
    for i in 0..n
        let item = items[i]
        let t = item[0]
        let v = item[1]
        let encoded = tl_encode(t, v)
        out = bytes_concat(out, encoded)
    out

// tl_decode_all: decode all TLV records from a bytes blob.
// Returns a list of [type:int, value:bytes] pairs, one per encoded record.
// Stops when pos reaches the end of buf.
fn tl_decode_all(buf) -> list
    let total = bytes_len(buf)
    let result = []
    let pos = 0
    while pos < total
        let rec = tl_decode_at(buf, pos)
        let type_tag = rec[0]
        let val = rec[1]
        let next_pos = rec[2]
        result.push([type_tag, val])
        pos = next_pos
    result
