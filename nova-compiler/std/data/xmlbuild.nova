// ============================================================================
// NOVA Standard Library — std/data/xmlbuild
// ============================================================================
// Programmatic XML string builder.  Complements std/text/xml (which PARSES).
//
// PUBLIC API:
//   xb_text_escape(s) -> string
//     Escape a plain string for safe embedding in XML text or attribute values.
//     Replaces: & -> &amp;  < -> &lt;  > -> &gt;  " -> &quot;  ' -> &apos;
//
//   xb_attr(attrs) -> string
//     Render a dict of attribute key/value pairs as a space-prefixed attribute
//     string, e.g. {" href=\"url\" id=\"x\""}.  Keys are emitted in SORTED
//     order (lexicographic, ascending) for deterministic output.  Values are
//     escaped via xb_text_escape.  Returns "" for an empty dict.
//     Attribute quotes use chr(34) (double-quote).
//
//   xb_element(tag, attrs, inner) -> string
//     Build a complete XML element string.
//       - If inner is "" → self-closing:  <tag attrs/>
//       - Otherwise      → open+close:    <tag attrs>inner</tag>
//     attrs is a dict (use {} for no attributes).
//     inner is a pre-rendered string (may itself contain child element strings).
//     The tag and attribute NAMES are NOT escaped (caller supplies valid XML
//     names); only attribute VALUES and text content flow through xb_text_escape.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - Single-exit style throughout (avoids NOVA return-null mistag).
//   - No multi-line list/dict literals in module body (NOVA parser limitation).
//   - Brace chars via chr(123)/chr(125) to avoid string interpolation.
//   - Uses chr(34) for the attribute quote character (" = double-quote).
//   - Uses chr(60)/chr(62) for the < > chars in tag construction so the code
//     is explicit and immune to any future interpolation expansion.
//   - Attribute keys sorted via native sort(keys(d)) for determinism.
//   - No heap objects other than strings; fully composable with NOVA values.
//
// KAT vectors (hand-computed):
//   xb_element("br", {}, "")          == "<br/>"
//   xb_element("p",  {}, "hi")        == "<p>hi</p>"
//   xb_text_escape("a<b>&c")          == "a&lt;b&gt;&amp;c"
//   xb_element("a", {"href":"x"}, "link") contains "href=" and quoted "x"
//   xb_text_escape(chr(34))           == "&quot;"
//   element with 2 attrs has them in sorted key order
// ============================================================================

// ── Private: escape a single character at position i inside s ────────────────

fn _xb_esc_char(c: string) -> string
    let result = c
    let o = ord(c)
    // & must be first to avoid double-escaping
    if o == 38
        result = "&amp;"
    else
        if o == 60
            result = "&lt;"
        else
            if o == 62
                result = "&gt;"
            else
                if o == 34
                    result = "&quot;"
                else
                    if o == 39
                        result = "&apos;"
    result

// ── Public API ───────────────────────────────────────────────────────────────

// xb_text_escape: escape s for safe use in XML text content or attribute values.
//
// Processes the string character by character, replacing the 5 XML special
// characters with their predefined entity references.  All other characters
// pass through unchanged.
fn xb_text_escape(s: string) -> string
    let n = len(s)
    let out = ""
    for i in 0..n
        let c = s[i]
        out = out + _xb_esc_char(c)
    out

// xb_attr: render an attribute dict to a space-prefixed attribute string.
//
// Keys are sorted lexicographically (ascending) for deterministic output.
// Each attribute is rendered as: SPACE key=DQUOTE escaped_value DQUOTE
// Returns "" for an empty dict (no leading space).
fn xb_attr(attrs: dict) -> string
    let dq = chr(34)
    let attr_keys = sort(keys(attrs))
    let nk = len(attr_keys)
    let out_parts = []
    for i in 0..nk
        let k = attr_keys[i]
        let v = xb_text_escape(attrs[k])
        push(out_parts, " " + k + "=" + dq + v + dq)
    let out = join(out_parts, "")
    out

// xb_element: build a complete XML element string.
//
// If inner == "" the element is self-closing: <tag attrs/>
// Otherwise a paired open/close is produced:  <tag attrs>inner</tag>
//
// The caller is responsible for supplying a valid XML tag name and valid
// attribute key names.  Only attribute VALUES and inner content must be
// escaped — pass them through xb_text_escape before calling this function
// if they are raw user/data strings.  (inner is treated as a pre-rendered
// string so that nested xb_element calls compose naturally.)
fn xb_element(tag: string, attrs: dict, inner: string) -> string
    let lt = chr(60)
    let gt = chr(62)
    let sl = chr(47)
    let attr_str = xb_attr(attrs)
    let result = ""
    if len(inner) == 0
        result = lt + tag + attr_str + sl + gt
    else
        result = lt + tag + attr_str + gt + inner + lt + sl + tag + gt
    result
