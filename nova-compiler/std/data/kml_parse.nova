// ============================================================================
// NOVA Standard Library — std/data/kml_parse
// ============================================================================
// Parse KML <coordinates> elements into a list of [lon, lat] pairs.
//
// PUBLIC API:
//   kml_parse(xml) -> list
//     Extract all coordinate pairs from KML <coordinates>...</coordinates>
//     elements.  Each whitespace-separated tuple is "lon,lat,alt" or "lon,lat";
//     the altitude (3rd component) is DROPPED.  Returns a list of [lon, lat]
//     pairs where each pair is a 2-element list of floats.
//
//   kml_coords_text(xml) -> string
//     Return the raw text content of the first <coordinates> element, or ""
//     if none found.  Useful for debugging.
//
//   kml_approx(a, b, tol) -> int
//     Float comparison within tolerance.  Returns 1 if |a-b| <= tol, else 0.
//
// DESIGN NOTES:
//   - LEAF module — imports nothing.
//   - XML is parsed by simple string search (finds first <coordinates> tag).
//   - Numbers are parsed with parse_float for correct float boxing.
//   - Altitude (3rd comma-separated component) is silently dropped.
//   - Whitespace splitting uses a 2-state machine (in_token / between_tokens)
//     to avoid nested loops with break signals.
// ============================================================================

// ── Private: tag search helper ───────────────────────────────────────────────

// Return 1 if xml[pos..pos+taglen) matches tag character-by-character.
fn _kml_tag_match(xml, pos, tag, taglen) -> int
    let ok = 1
    let j = 0
    while j < taglen
        if char_at(xml, pos + j) != char_at(tag, j)
            ok = 0
        j = j + 1
    ok

// Extract raw text between <coordinates> and </coordinates>.
// Returns "" if the opening tag is not found.
fn _kml_extract_coords_text(xml) -> string
    let result = ""
    let open_tag = "<coordinates>"
    let close_tag = "</coordinates>"
    let nxml = len(xml)
    let nopen = len(open_tag)
    let nclose = len(close_tag)
    // Scan for opening tag.
    let start = -1
    let i = 0
    while i <= nxml - nopen
        if start < 0
            if _kml_tag_match(xml, i, open_tag, nopen) == 1
                start = i + nopen
        i = i + 1
    if start >= 0
        // Scan for closing tag from start.
        let end_pos = nxml
        let k = start
        while k <= nxml - nclose
            if end_pos == nxml
                if _kml_tag_match(xml, k, close_tag, nclose) == 1
                    end_pos = k
            k = k + 1
        result = slice(xml, start, end_pos)
    result

// ── Private: whitespace check ────────────────────────────────────────────────

// Return 1 if code is ASCII whitespace: space(32), tab(9), LF(10), CR(13).
fn _kml_is_ws(code) -> int
    let result = 0
    if code == 32
        result = 1
    if code == 9
        result = 1
    if code == 10
        result = 1
    if code == 13
        result = 1
    result

// ── Private: whitespace token splitter ───────────────────────────────────────

// Split s on runs of whitespace.  Uses a 2-state machine (state 0 = between
// tokens, state 1 = inside a token) with one outer loop and no nested loops.
// Returns a list of non-empty token strings.
fn _kml_split_ws(s) -> list
    let tokens = []
    let n = len(s)
    let state = 0   // 0=between, 1=in-token
    let tstart = 0
    let i = 0
    while i < n
        let code = ord(char_at(s, i))
        let is_ws = _kml_is_ws(code)
        if state == 0
            // Between tokens: look for start of a token.
            if is_ws == 0
                tstart = i
                state = 1
        else
            // Inside a token: look for end.
            if is_ws == 1
                tokens.push(slice(s, tstart, i))
                state = 0
        i = i + 1
    // If we ended inside a token, flush it.
    if state == 1
        tokens.push(slice(s, tstart, n))
    tokens

// ── Private: parse one coordinate tuple ──────────────────────────────────────

// Parse "lon,lat" or "lon,lat,alt" into a [lon, lat] list.
// Returns [] if no comma is found.
fn _kml_parse_tuple(token) -> list
    let result = []
    let n = len(token)
    // Find first comma position.
    let c1 = -1
    let i = 0
    while i < n
        if c1 < 0
            if char_at(token, i) == ","
                c1 = i
        i = i + 1
    if c1 >= 0
        let lon_str = slice(token, 0, c1)
        // Find second comma (start of optional alt).
        let c2 = -1
        let j = c1 + 1
        while j < n
            if c2 < 0
                if char_at(token, j) == ","
                    c2 = j
            j = j + 1
        let lat_end = n
        if c2 >= 0
            lat_end = c2
        let lat_str = slice(token, c1 + 1, lat_end)
        let lon_f = parse_float(lon_str)
        let lat_f = parse_float(lat_str)
        let pair = []
        pair.push(lon_f)
        pair.push(lat_f)
        result = pair
    result

// ── Public API ───────────────────────────────────────────────────────────────

// kml_coords_text: return raw text inside first <coordinates> element.
fn kml_coords_text(xml) -> string
    _kml_extract_coords_text(xml)

// kml_parse: parse KML XML and return list of [lon, lat] float pairs.
// Altitude component is dropped.  Returns [] if no <coordinates> found.
fn kml_parse(xml) -> list
    let result = []
    let coords_text = _kml_extract_coords_text(xml)
    if len(coords_text) > 0
        let tokens = _kml_split_ws(coords_text)
        let nt = len(tokens)
        let i = 0
        while i < nt
            let pair = _kml_parse_tuple(tokens[i])
            if len(pair) == 2
                result.push(pair)
            i = i + 1
    result

// kml_approx: float comparison within tolerance (exported for tests).
fn kml_approx(a, b, tol) -> int
    let diff = a - b
    let result = 0
    if diff < 0.0
        diff = 0.0 - diff
    if diff <= tol
        result = 1
    result
