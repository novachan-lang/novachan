// std/color/contrast.nova — WCAG 2.1 contrast-ratio utilities.
//
// PREFIX: cst_
//
// FLOAT HAZARDS obeyed throughout:
//   * All intermediate float expressions bound to named lets (uninit-slot bug).
//   * Float abs via if/else — abs() returns int in NOVA.
//   * Integer division avoided — always use float literals (e.g. 255.0).
//   * float-vs-int compare unsound — coerce *1.0 or compare float literals.
//   * pow results always bound to a let before use.
//   * Single-exit pattern on every fn.
//
// API:
//   cst_luminance(c)        -> float  relative luminance 0..1 (WCAG 2.1)
//   cst_ratio(a, b)         -> float  contrast ratio 1..21 (lighter/darker)
//   cst_passes_aa(a, b)     -> bool   ratio >= 4.5 (WCAG AA normal text)
//   cst_passes_aaa(a, b)    -> bool   ratio >= 7.0 (WCAG AAA normal text)
//   cst_best_text(bg)       -> list   [0,0,0] or [255,255,255] with higher contrast
//
// sRGB linearization (IEC 61966-2-1 piecewise):
//   if c/255 <= 0.04045: linear = c/255/12.92
//   else:                linear = ((c/255 + 0.055) / 1.055) ^ 2.4
//
// Relative luminance = 0.2126*R_lin + 0.7152*G_lin + 0.0722*B_lin
//
// Contrast ratio = (L_lighter + 0.05) / (L_darker + 0.05)

// Internal: linearize one sRGB channel (int 0..255) -> float 0..1
fn _cst_linearize(ch: int) -> float
    let v = ch * 1.0
    let v255 = v / 255.0
    let thresh = 0.04045
    let result = 0.0
    if v255 <= thresh
        let lin = v255 / 12.92
        result = lin
    else
        let inner = v255 + 0.055
        let denom = inner / 1.055
        let ex = 2.4
        let lin = pow(denom, ex)
        result = lin
    result

// cst_luminance: relative luminance of an RGB list [r,g,b] (0..255 ints) -> 0..1 float
// Formula: 0.2126*R_lin + 0.7152*G_lin + 0.0722*B_lin
fn cst_luminance(c: list) -> float
    let r = c[0]
    let g = c[1]
    let b = c[2]
    let rl = _cst_linearize(r)
    let gl = _cst_linearize(g)
    let bl = _cst_linearize(b)
    let wr = 0.2126
    let wg = 0.7152
    let wb = 0.0722
    let lr = rl * wr
    let lg = gl * wg
    let lb = bl * wb
    let lum1 = lr + lg
    let lum = lum1 + lb
    lum

// cst_ratio: WCAG contrast ratio between two RGB colors, always >= 1.0
// (lighter + 0.05) / (darker + 0.05)
fn cst_ratio(a: list, b: list) -> float
    let la = cst_luminance(a)
    let lb = cst_luminance(b)
    let offset = 0.05
    let la_off = la + offset
    let lb_off = lb + offset
    let result = (la_off / lb_off) if la >= lb else (lb_off / la_off)
    result

// cst_passes_aa: true if contrast ratio >= 4.5 (WCAG 2.1 AA for normal text)
fn cst_passes_aa(a: list, b: list) -> bool
    let r = cst_ratio(a, b)
    let thresh = 4.5
    let result = false
    if r >= thresh
        result = true
    result

// cst_passes_aaa: true if contrast ratio >= 7.0 (WCAG 2.1 AAA for normal text)
fn cst_passes_aaa(a: list, b: list) -> bool
    let r = cst_ratio(a, b)
    let thresh = 7.0
    let result = false
    if r >= thresh
        result = true
    result

// cst_best_text: returns [0,0,0] (black) or [255,255,255] (white),
// whichever gives higher contrast against bg.
fn cst_best_text(bg: list) -> list
    let black = []
    black.push(0)
    black.push(0)
    black.push(0)
    let white = []
    white.push(255)
    white.push(255)
    white.push(255)
    let rb = cst_ratio(bg, black)
    let rw = cst_ratio(bg, white)
    let result = white if rw > rb else black
    result
