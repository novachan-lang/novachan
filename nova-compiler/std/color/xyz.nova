// std/color/xyz.nova — sRGB <-> CIE XYZ (D65) color science.
//
// PREFIX: cxyz_
//
// FLOAT HAZARDS obeyed throughout:
//   * All intermediate float expressions bound to named lets (uninit-slot bug).
//   * Float abs via if/else — abs() returns int in NOVA.
//   * Integer division avoided — always use float literals (e.g. 255.0).
//   * float-vs-int compare coerced with *1.0 where needed.
//   * pow/sqrt results always bound to a let before use.
//
// API:
//   cxyz_from_rgb(c)      -> list [X, Y, Z] floats, D65, scaled 0..100
//   cxyz_to_rgb(x, y, z)  -> list [r, g, b] ints 0..255
//   cxyz_luminance(c)     -> float, relative luminance 0..1 (Y/100)
//
// Standard D65 matrix (IEC 61966-2-1 / sRGB spec):
//   X =  0.4124564*R + 0.3575761*G + 0.1804375*B
//   Y =  0.2126729*R + 0.7151522*G + 0.0721750*B
//   Z =  0.0193339*R + 0.1191920*G + 0.9503041*B
// (result multiplied by 100 so white maps to [95.047, 100.0, 108.883])
//
// Inverse D65 matrix:
//   R =  3.2404542*X - 1.5371385*Y - 0.4985314*Z
//   G = -0.9692660*X + 1.8760108*Y + 0.0415560*Z
//   B =  0.0556434*X - 0.2040259*Y + 1.0572252*Z

// Expand one sRGB channel (0-255 int) to linear light (0.0-1.0 float).
// IEC 61966-2-1 piecewise function.
fn _cxyz_expand(channel: int) -> float
    let v = channel * 1.0
    let v255 = v / 255.0
    let thresh = 0.04045
    let result = 0.0
    if v255 <= thresh
        let lin = v255 / 12.92
        result = lin
    else
        let inner = v255 + 0.055
        let denom = inner / 1.055
        let ex = 2.4
        let lin = pow(denom, ex)
        result = lin
    result

// Compress one linear-light value (0.0-1.0) to sRGB encoded (0.0-1.0 float).
fn _cxyz_compress(lin: float) -> float
    let thresh = 0.0031308
    let result = 0.0
    if lin <= thresh
        let enc = lin * 12.92
        result = enc
    else
        let ex = 0.41666666666666667
        let powered = pow(lin, ex)
        let scaled = powered * 1.055
        let enc = scaled - 0.055
        result = enc
    result

// Clamp a float to [lo, hi].
fn _cxyz_clampf(v: float, lo: float, hi: float) -> float
    if v < lo
        return lo
    if v > hi
        return hi
    v

// Convert sRGB [r,g,b] int list to CIE XYZ D65 list [X,Y,Z] floats, scaled 0..100.
fn cxyz_from_rgb(c: list) -> list
    let ri = c[0]
    let gi = c[1]
    let bi = c[2]
    let rl = _cxyz_expand(ri)
    let gl = _cxyz_expand(gi)
    let bl = _cxyz_expand(bi)
    // Row 0: X
    let x0 = 0.4124564 * rl
    let x1 = 0.3575761 * gl
    let x2 = 0.1804375 * bl
    let xsum = x0 + x1
    let xval = xsum + x2
    let X = xval * 100.0
    // Row 1: Y
    let y0 = 0.2126729 * rl
    let y1 = 0.7151522 * gl
    let y2 = 0.0721750 * bl
    let ysum = y0 + y1
    let yval = ysum + y2
    let Y = yval * 100.0
    // Row 2: Z
    let z0 = 0.0193339 * rl
    let z1 = 0.1191920 * gl
    let z2 = 0.9503041 * bl
    let zsum = z0 + z1
    let zval = zsum + z2
    let Z = zval * 100.0
    [X, Y, Z]

// Convert CIE XYZ D65 (scaled 0..100) to sRGB [r,g,b] int list (0..255).
fn cxyz_to_rgb(x: float, y: float, z: float) -> list
    // Scale down to 0..1 range
    let xs = x / 100.0
    let ys = y / 100.0
    let zs = z / 100.0
    // Inverse D65 matrix: linear sRGB channels
    let r0 = 3.2404542 * xs
    let r1 = 1.5371385 * ys
    let r2 = 0.4985314 * zs
    let rl_raw = r0 - r1
    let rl_raw2 = rl_raw - r2
    let g0 = 0.9692660 * xs
    let g1 = 1.8760108 * ys
    let g2 = 0.0415560 * zs
    let gl_raw = g1 - g0
    let gl_raw2 = gl_raw + g2
    let b0 = 0.0556434 * xs
    let b1 = 0.2040259 * ys
    let b2 = 1.0572252 * zs
    let bl_raw = b0 - b1
    let bl_raw2 = bl_raw + b2
    // Clamp linear values to [0, 1] before gamma-compress
    let rl = _cxyz_clampf(rl_raw2, 0.0, 1.0)
    let gl = _cxyz_clampf(gl_raw2, 0.0, 1.0)
    let bl = _cxyz_clampf(bl_raw2, 0.0, 1.0)
    // Gamma-compress and scale to 0..255
    let rc = _cxyz_compress(rl)
    let gc = _cxyz_compress(gl)
    let bc = _cxyz_compress(bl)
    let rscale = rc * 255.0
    let gscale = gc * 255.0
    let bscale = bc * 255.0
    // Round to nearest int via float_to_int(x + 0.5)
    let rhalf = rscale + 0.5
    let ghalf = gscale + 0.5
    let bhalf = bscale + 0.5
    let ri = float_to_int(rhalf)
    let gi = float_to_int(ghalf)
    let bi = float_to_int(bhalf)
    [ri, gi, bi]

// Relative luminance of sRGB [r,g,b] color, 0.0 (black) to 1.0 (white).
// = Y/100 from CIE XYZ, where Y uses linearized (gamma-expanded) channels.
fn cxyz_luminance(c: list) -> float
    let ri = c[0]
    let gi = c[1]
    let bi = c[2]
    let rl = _cxyz_expand(ri)
    let gl = _cxyz_expand(gi)
    let bl = _cxyz_expand(bi)
    let y0 = 0.2126729 * rl
    let y1 = 0.7151522 * gl
    let y2 = 0.0721750 * bl
    let ysum = y0 + y1
    let lum = ysum + y2
    lum
