// std/color/blend.nova — Color blending / mixing (RGB [r,g,b] int lists).
//
// All colors represented as int lists [r, g, b] with channels 0..255.
//
// FLOAT HAZARDS obeyed throughout:
//   * bare multi-term float return -> bind every intermediate to a named let.
//   * abs(float) returns int -> use if/else for float abs.
//   * '/' two ints = INTEGER division -> use floats for real division.
//   * float-vs-int compare unsound -> coerce *1.0 where needed.
//   * Single-exit pattern on every fn to avoid float-slot Heisenbug.
//
// API:
//   blnd_mix(a, b, t)      -> list  linear interpolate, t 0..1
//   blnd_multiply(a, b)    -> list  per-channel a*b/255
//   blnd_screen(a, b)      -> list  255-(255-a)(255-b)/255
//   blnd_overlay(a, b)     -> list  overlay blend mode
//   blnd_add(a, b)         -> list  clamped sum
//   blnd_average(a, b)     -> list  per-channel average

// Internal: clamp int to [0, 255]
fn _blnd_clamp(v: int) -> int
    let result = 0 if v < 0 else 255 if v > 255 else v
    result

// Internal: linear interpolate two ints with float t, result clamped and rounded
fn _blnd_lerp_ch(a: int, b: int, t: float) -> int
    let af = a * 1.0
    let bf = b * 1.0
    let diff = bf - af
    let scaled = t * diff
    let raw = af + scaled
    let rounded = float_to_int(raw + 0.5)
    let result = _blnd_clamp(rounded)
    result

// blnd_mix: linear interpolate between colors a and b by t (0.0=a, 1.0=b)
fn blnd_mix(a: list, b: list, t: float) -> list
    let ar = a[0]
    let ag = a[1]
    let ab = a[2]
    let br = b[0]
    let bg = b[1]
    let bb = b[2]
    let nr = _blnd_lerp_ch(ar, br, t)
    let ng = _blnd_lerp_ch(ag, bg, t)
    let nb = _blnd_lerp_ch(ab, bb, t)
    let out = []
    out.push(nr)
    out.push(ng)
    out.push(nb)
    out

// blnd_multiply: per-channel floor(a*b/255), clamped
fn blnd_multiply(a: list, b: list) -> list
    let ar = a[0]
    let ag = a[1]
    let ab = a[2]
    let br = b[0]
    let bg = b[1]
    let bb = b[2]
    let rr = ar * br / 255
    let rg = ag * bg / 255
    let rb = ab * bb / 255
    let cr = _blnd_clamp(rr)
    let cg = _blnd_clamp(rg)
    let cb = _blnd_clamp(rb)
    let out = []
    out.push(cr)
    out.push(cg)
    out.push(cb)
    out

// blnd_screen: 255 - (255-a)*(255-b)/255, clamped
fn blnd_screen(a: list, b: list) -> list
    let ar = a[0]
    let ag = a[1]
    let ab = a[2]
    let br = b[0]
    let bg = b[1]
    let bb = b[2]
    let rr = 255 - (255 - ar) * (255 - br) / 255
    let rg = 255 - (255 - ag) * (255 - bg) / 255
    let rb = 255 - (255 - ab) * (255 - bb) / 255
    let cr = _blnd_clamp(rr)
    let cg = _blnd_clamp(rg)
    let cb = _blnd_clamp(rb)
    let out = []
    out.push(cr)
    out.push(cg)
    out.push(cb)
    out

// Internal: overlay blend on one channel (a is base, b is blend layer)
// If a < 128: 2*a*b/255   else: 255 - 2*(255-a)*(255-b)/255
fn _blnd_overlay_ch(a: int, b: int) -> int
    let result = (2 * a * b / 255) if a < 128 else (255 - 2 * (255 - a) * (255 - b) / 255)
    let clamped = _blnd_clamp(result)
    clamped

// blnd_overlay: overlay blend mode (a=base, b=blend layer)
fn blnd_overlay(a: list, b: list) -> list
    let ar = a[0]
    let ag = a[1]
    let ab = a[2]
    let br = b[0]
    let bg = b[1]
    let bb = b[2]
    let nr = _blnd_overlay_ch(ar, br)
    let ng = _blnd_overlay_ch(ag, bg)
    let nb = _blnd_overlay_ch(ab, bb)
    let out = []
    out.push(nr)
    out.push(ng)
    out.push(nb)
    out

// blnd_add: per-channel sum, clamped to 255
fn blnd_add(a: list, b: list) -> list
    let ar = a[0]
    let ag = a[1]
    let ab = a[2]
    let br = b[0]
    let bg = b[1]
    let bb = b[2]
    let rr = ar + br
    let rg = ag + bg
    let rb = ab + bb
    let cr = _blnd_clamp(rr)
    let cg = _blnd_clamp(rg)
    let cb = _blnd_clamp(rb)
    let out = []
    out.push(cr)
    out.push(cg)
    out.push(cb)
    out

// blnd_average: per-channel floor((a+b)/2)
fn blnd_average(a: list, b: list) -> list
    let ar = a[0]
    let ag = a[1]
    let ab = a[2]
    let br = b[0]
    let bg = b[1]
    let bb = b[2]
    let rr = (ar + br) / 2
    let rg = (ag + bg) / 2
    let rb = (ab + bb) / 2
    let cr = _blnd_clamp(rr)
    let cg = _blnd_clamp(rg)
    let cb = _blnd_clamp(rb)
    let out = []
    out.push(cr)
    out.push(cg)
    out.push(cb)
    out
