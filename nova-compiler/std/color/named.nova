// ── cn_to_rgb ────────────────────────────────────────────────────────────────

// Look up a CSS color name (case-insensitive) and return [r, g, b].
// Returns [-1, -1, -1] if the name is not recognized.
fn cn_to_rgb(name: str) -> list
    let lc = lower(name)
    let tbl = _cn_build_table()
    let unknown = []
    unknown.push(0 - 1)
    unknown.push(0 - 1)
    unknown.push(0 - 1)
    let result = unknown
    if contains(tbl, lc)
        let packed = tbl[lc]
        let rv = _cn_r(packed)
        let gv = _cn_g(packed)
        let bv = _cn_b(packed)
        let found = []
        found.push(rv)
        found.push(gv)
        found.push(bv)
        result = found
    result

// ── cn_name ──────────────────────────────────────────────────────────────────

// Return the CSS name for an exact [r, g, b] color, or "" if none.
// When multiple names map to the same RGB (e.g. aqua/cyan, fuchsia/magenta,
// gray/grey), the first alphabetical match is returned via sorted-key scan.
fn cn_name(c: list) -> str
    let r = c[0]
    let g = c[1]
    let b = c[2]
    let target = _cn_pack(r, g, b)
    let tbl = _cn_build_table()
    let nms = keys(tbl)
    let sorted_nms = sort(nms)
    let result = ""
    let i = 0
    while i < len(sorted_nms)
        let nm = sorted_nms[i]
        let packed = tbl[nm]
        if packed == target
            if len(result) == 0
                result = nm
        i = i + 1
    result

// ── cn_is_named ──────────────────────────────────────────────────────────────

// Return true iff name is a recognized CSS color name (case-insensitive).
fn cn_is_named(name: str) -> bool
    let lc = lower(name)
    let tbl = _cn_build_table()
    let result = false
    if contains(tbl, lc)
        result = true
    result

// ── cn_names ─────────────────────────────────────────────────────────────────

// Return a lexicographically sorted list of all supported CSS color names.
fn cn_names() -> list
    let tbl = _cn_build_table()
    let nms = keys(tbl)
    let sorted_nms = sort(nms)
    sorted_nms
