// std/color/named.nova — CSS named colors <-> RGB.
//
// Colors are represented as [r, g, b] int lists (channels 0..255).
// Names are matched case-insensitively (lowercased before lookup).
//
// DESIGN NOTES
//   * The color table is a dict mapping lowercase CSS name -> packed int
//     where packed = r*65536 + g*256 + b.  This keeps the table in one
//     dict with simple arithmetic for encode/decode and avoids multi-line
//     list literals (which NOVA does not support).
//   * All private helpers are prefixed _cn_ to avoid symbol collisions.
//   * NOVA GOTCHAS obeyed:
//       - no &&/||; use 'and'/'or' or nested if
//       - abs(float)->int; irrelevant here (int-only module)
//       - '/' two ints = integer division (intentional here)
//       - dict keys must be strings
//       - NO multi-line list/dict literals; build with push / d[k]=v
//
// PUBLIC API
//   cn_to_rgb(name)  -> list [r,g,b]  (lowercased lookup; [-1,-1,-1] if unknown)
//   cn_name(c)       -> str            (exact RGB -> CSS name, or "" if none)
//   cn_is_named(name)-> bool           (true iff name is a known CSS color)
//   cn_names()       -> list           (all supported names, lexicographically sorted)

// ── pack / unpack helpers ────────────────────────────────────────────────────

// Pack (r,g,b) ints into a single int: r*65536 + g*256 + b.
fn _cn_pack(r: int, g: int, b: int) -> int
    let v = r * 65536 + g * 256 + b
    v

// Unpack the red channel from a packed int.
fn _cn_r(v: int) -> int
    let r = v / 65536
    r

// Unpack the green channel from a packed int.
fn _cn_g(v: int) -> int
    let rr = v / 65536
    let rem = v - rr * 65536
    let g = rem / 256
    g

// Unpack the blue channel from a packed int.
fn _cn_b(v: int) -> int
    let rr = v / 65536
    let rem = v - rr * 65536
    let gg = rem / 256
    let b = rem - gg * 256
    b

// ── color table ──────────────────────────────────────────────────────────────

// Build and return the complete CSS named-color table.
// Returns a dict: lowercase_name -> packed_int.
// Contains all 40 most common CSS Level 1-4 named colors.
fn _cn_build_table() -> dict
    let d = {}
    d["aliceblue"] = _cn_pack(240, 248, 255)
    d["antiquewhite"] = _cn_pack(250, 235, 215)
    d["aqua"] = _cn_pack(0, 255, 255)
