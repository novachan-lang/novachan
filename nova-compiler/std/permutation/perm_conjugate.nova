// std/permutation/perm_conjugate.nova — conjugation and cycle-type in S_n.
// LEAF — imports NOTHING.
//
// Public API (prefix pcj_):
//   pcj_conjugate(p, g)      -> any   conjugate of p by g: result[g[i]] = g[p[i]]
//   pcj_cycle_type(p)        -> any   sorted list of cycle lengths (fixed points = length-1 cycles)
//   pcj_are_conjugate(p, q)  -> bool  true iff p and q have the same cycle type

// _pcj_dup — deep-copy an integer list.
fn _pcj_dup(a) -> any
    let out = []
    let i = 0
    let n = len(a)
    while i < n
        push(out, a[i])
        i += 1
    return out

// _pcj_inverse — compute the inverse of permutation p: inv[p[i]] = i.
fn _pcj_inverse(p) -> any
    let n = len(p)
    let inv = []
    let i = 0
    while i < n
        push(inv, 0)
        i += 1
    for j in 0..n
        inv[p[j]] = j
    return inv

// pcj_conjugate — conjugate of p by g: result[g[i]] = g[p[i]] for each i.
// Equivalently result = g * p * g^{-1} under the convention (a after b)[i]=a[b[i]].
fn pcj_conjugate(p, g) -> any
    let n = len(p)
    let r = [0 for i in 0..n]
    for j in 0..n
        r[g[j]] = g[p[j]]
    return r

// _pcj_sort_asc — insertion sort of integer list in ascending order (in-place).
fn _pcj_sort_asc(a)
    let n = len(a)
    for i in 1..n
        let key = a[i]
        let j = i - 1
        while j >= 0
            if a[j] > key
                a[j + 1] = a[j]
                j -= 1
            if a[j] <= key
                j = -1
        a[j + 1] = key

// pcj_cycle_type — cycle lengths of permutation p, sorted ascending.
// Fixed points contribute a cycle of length 1.
fn pcj_cycle_type(p) -> any
    let n = len(p)
    let visited = [0 for i in 0..n]
    let lengths = []
    for start in 0..n
        if visited[start] == 0
            let cyc_len = 0
            let cur = start
            while visited[cur] == 0
                visited[cur] = 1
                cur = p[cur]
                cyc_len += 1
            push(lengths, cyc_len)
    _pcj_sort_asc(lengths)
    return lengths

// _pcj_lists_equal — true iff two integer lists are equal.
fn _pcj_lists_equal(a, b) -> bool
    if len(a) != len(b)
        return false
    for i in 0..len(a)
        if a[i] != b[i]
            return false
    return true

// pcj_are_conjugate — true iff p and q have the same cycle type.
fn pcj_are_conjugate(p, q) -> bool
    let tp = pcj_cycle_type(p)
    let tq = pcj_cycle_type(q)
    return _pcj_lists_equal(tp, tq)
