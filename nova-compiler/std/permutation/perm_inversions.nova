// std/permutation/perm_inversions.nova — inversion counting and enumeration.
// LEAF — imports NOTHING.
// Representation: p is a list in one-line notation over {0..n-1}.
//
// Public API:
//   pinv_count(p)     -> int    number of inversions: pairs (i,j) with i<j and p[i]>p[j]
//   pinv_is_sorted(p) -> bool   true iff inversion count is zero (p is sorted ascending)
//   pinv_list(p)      -> any    list of [i,j] pairs (i<j, p[i]>p[j]) in lexicographic order

// pinv_count — count pairs (i<j) with p[i] > p[j]; O(n^2).
fn pinv_count(p) -> int
    let n = len(p)
    let cnt = 0
    for i in 0..n
        let j = i + 1
        while j < n
            if p[i] > p[j]
                cnt = cnt + 1
            j = j + 1
    return cnt

// pinv_is_sorted — true iff p has no inversions (equivalently, p[0]<=p[1]<=...<=p[n-1]).
fn pinv_is_sorted(p) -> bool
    let n = len(p)
    let i = 0
    while i < n - 1
        if p[i] > p[i + 1]
            return false
        i = i + 1
    return true

// pinv_list — return the list of inverting pairs [i,j] with i<j and p[i]>p[j].
fn pinv_list(p) -> any
    let n = len(p)
    let out = []
    for i in 0..n
        let j = i + 1
        while j < n
            if p[i] > p[j]
                let pair = []
                push(pair, i)
                push(pair, j)
                push(out, pair)
            j = j + 1
    return out
