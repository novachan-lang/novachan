// std/permutation/perm_derangement.nova — derangement predicates and subfactorial.
// LEAF — imports NOTHING.
//
// Public API (prefix pd_):
//   pd_is_derangement(p)  -> bool  true iff p has no fixed points (p[i] != i for all i)
//   pd_fixed_free(p)      -> bool  alias for pd_is_derangement
//   pd_count(n)           -> int   subfactorial D_n; D_0=1, D_1=0, D_n=(n-1)*(D_{n-1}+D_{n-2})

// pd_is_derangement — returns true iff permutation p has no fixed point (p[i] != i for all i).
fn pd_is_derangement(p) -> bool
    let n = len(p)
    for i in 0..n
        if p[i] == i
            return false
    return true

// pd_fixed_free — alias for pd_is_derangement; returns true iff p has no fixed point.
fn pd_fixed_free(p) -> bool
    return pd_is_derangement(p)

// pd_count — subfactorial D_n: count of derangements of n elements.
// D_0=1, D_1=0, D_n = (n-1)*(D_{n-1} + D_{n-2}).
fn pd_count(n: int) -> int
    if n == 0
        return 1
    if n == 1
        return 0
    let d_prev2 = 1
    let d_prev1 = 0
    let i = 2
    while i <= n
        let d_cur = (i - 1) * (d_prev1 + d_prev2)
        d_prev2 = d_prev1
        d_prev1 = d_cur
        i += 1
    return d_prev1
