// std/permutation/perm_fixed.nova — fixed-point and moved-point queries.
// LEAF — imports NOTHING.
// Representation: p is a list in one-line notation over {0..n-1}; p[i]==i means i is fixed.
//
// Public API:
//   pf_fixed_points(p)  -> any   ascending list of indices i where p[i]==i
//   pf_fixed_count(p)   -> int   number of fixed points
//   pf_moved_count(p)   -> int   number of moved points (n minus fixed count)
//   pf_moved_points(p)  -> any   ascending list of indices i where p[i]!=i

// pf_fixed_points — return sorted list of indices i with p[i] == i.
fn pf_fixed_points(p) -> any
    let n = len(p)
    let out = []
    for i in 0..n
        if p[i] == i
            push(out, i)
    return out

// pf_fixed_count — number of elements i with p[i] == i.
fn pf_fixed_count(p) -> int
    let n = len(p)
    let cnt = 0
    for i in 0..n
        if p[i] == i
            cnt += 1
    return cnt

// pf_moved_count — number of elements i with p[i] != i.
fn pf_moved_count(p) -> int
    return len(p) - pf_fixed_count(p)

// pf_moved_points — return sorted list of indices i with p[i] != i.
fn pf_moved_points(p) -> any
    let n = len(p)
    let out = [i for i in 0..n if p[i] != i]
    return out
