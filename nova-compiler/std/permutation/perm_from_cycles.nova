// std/permutation/perm_from_cycles.nova — build/decode permutations from cycle notation.
// LEAF — imports NOTHING.
//
// Public API (prefix pfc_):
//   pfc_from_cycles(cycles, n)    -> any   one-line permutation from disjoint cycle list
//   pfc_to_cycles(p)              -> any   canonical cycle decomposition of p
//   pfc_is_valid_cycles(cycles,n) -> bool  true iff cycles are valid disjoint cycles over {0..n-1}

// _pfc_dup — deep-copy an integer list.
fn _pfc_dup(a) -> any
    let out = []
    let i = 0
    let n = len(a)
    while i < n
        push(out, a[i])
        i = i + 1
    return out

// pfc_from_cycles — build one-line permutation from disjoint cycle notation.
// Each cycle c means c[0]->c[1]->...->c[k-1]->c[0]; unlisted elements are fixed.
fn pfc_from_cycles(cycles, n: int) -> any
    let r = []
    let i = 0
    while i < n
        push(r, i)
        i = i + 1
    let ci = 0
    let nc = len(cycles)
    while ci < nc
        let c = cycles[ci]
        let clen = len(c)
        if clen > 0
            let k = 0
            while k < clen
                let nxt = k + 1
                if nxt >= clen
                    nxt = 0
                r[c[k]] = c[nxt]
                k = k + 1
        ci = ci + 1
    return r

// _pfc_sort_asc — insertion sort of integer list in ascending order (in-place).
fn _pfc_sort_asc(a)
    let n = len(a)
    let i = 1
    while i < n
        let key = a[i]
        let j = i - 1
        while j >= 0
            if a[j] > key
                a[j + 1] = a[j]
                j = j - 1
            if a[j] <= key
                j = -1
        a[j + 1] = key
        i = i + 1

// _pfc_min_idx — index of minimum value in list (returns 0 if empty).
fn _pfc_min_idx(a) -> int
    let n = len(a)
    if n == 0
        return 0
    let mi = 0
    let i = 1
    while i < n
        if a[i] < a[mi]
            mi = i
        i = i + 1
    return mi

// pfc_to_cycles — canonical cycle decomposition of permutation p.
// Canonical: each cycle rotated so its smallest element comes first;
// cycles ordered by their first (smallest) element ascending.
// Fixed points (length-1 cycles) are included.
fn pfc_to_cycles(p) -> any
    let n = len(p)
    let visited = []
    let i = 0
    while i < n
        push(visited, 0)
        i = i + 1
    // collect raw cycles (each starting at the traversal start)
    let raw = []
    let start = 0
    while start < n
        if visited[start] == 0
            let cyc = []
            let cur = start
            while visited[cur] == 0
                visited[cur] = 1
                push(cyc, cur)
                cur = p[cur]
            // rotate so smallest element is first
            let mi = _pfc_min_idx(cyc)
            let rotated = []
            let clen = len(cyc)
            let k = 0
            while k < clen
                push(rotated, cyc[(mi + k) % clen])
                k = k + 1
            push(raw, rotated)
        start = start + 1
    // sort raw cycles by their first element (bubble sort on first elem)
    let nr = len(raw)
    let si = 0
    while si < nr - 1
        let sj = 0
        while sj < nr - si - 1
            if raw[sj][0] > raw[sj + 1][0]
                let tmp = raw[sj]
                raw[sj] = raw[sj + 1]
                raw[sj + 1] = tmp
            sj = sj + 1
        si = si + 1
    return raw

// pfc_is_valid_cycles — returns true iff cycles form a valid disjoint-cycle cover of {0..n-1}.
// Each element in 0..n-1 must appear exactly once across all cycles.
fn pfc_is_valid_cycles(cycles, n: int) -> bool
    let seen = []
    let i = 0
    while i < n
        push(seen, 0)
        i = i + 1
    let ci = 0
    let nc = len(cycles)
    while ci < nc
        let c = cycles[ci]
        let clen = len(c)
        let k = 0
        while k < clen
            let v = c[k]
            if v < 0
                return false
            if v >= n
                return false
            if seen[v] != 0
                return false
            seen[v] = 1
            k = k + 1
        ci = ci + 1
    // every element must be covered
    let j = 0
    while j < n
        if seen[j] == 0
            return false
        j = j + 1
    return true
