// std/permutation/perm_power.nova — permutation exponentiation and related queries.
// LEAF — imports NOTHING.
// Representation: p is a list in one-line notation; p[i] = image of i over {0..n-1}.
//
// Public API:
//   ppw_power(p, k)              -> any   p composed with itself k times; k<0 uses inverse; k==0 -> identity
//   ppw_is_identity_power(p, k)  -> bool  true iff ppw_power(p,k) is the identity permutation
//   ppw_sqrt_exists(p)           -> bool  true iff there exists q such that q composed q == p

// _ppw_identity — build the identity permutation of length n.
fn _ppw_identity(n: int) -> any
    let r = []
    let i = 0
    while i < n
        push(r, i)
        i = i + 1
    return r

// _ppw_compose — compose two permutations: result[i] = a[b[i]].
fn _ppw_compose(a, b) -> any
    let n = len(a)
    let r = []
    let i = 0
    while i < n
        push(r, a[b[i]])
        i = i + 1
    return r

// _ppw_inverse — inverse permutation: inv[p[i]] = i.
fn _ppw_inverse(p) -> any
    let n = len(p)
    let r = []
    let i = 0
    while i < n
        push(r, 0)
        i = i + 1
    let j = 0
    while j < n
        r[p[j]] = j
        j = j + 1
    return r

// _ppw_dup — shallow copy of a list.
fn _ppw_dup(a) -> any
    let r = []
    let i = 0
    let n = len(a)
    while i < n
        push(r, a[i])
        i = i + 1
    return r

// _ppw_pow_positive — compute p^k for k >= 1 by repeated squaring.
fn _ppw_pow_positive(p, k: int) -> any
    let n = len(p)
    let result = _ppw_identity(n)
    let base = _ppw_dup(p)
    let exp = k
    while exp > 0
        if exp / 2 * 2 != exp
            result = _ppw_compose(result, base)
        base = _ppw_compose(base, base)
        exp = exp / 2
    return result

// ppw_power — p composed with itself k times; k==0 returns identity; k<0 uses the inverse.
fn ppw_power(p, k: int) -> any
    let n = len(p)
    if n == 0
        return []
    if k == 0
        return _ppw_identity(n)
    if k > 0
        return _ppw_pow_positive(p, k)
    let inv = _ppw_inverse(p)
    let kpos = 0 - k
    return _ppw_pow_positive(inv, kpos)

// ppw_is_identity_power — true iff p^k equals the identity permutation.
fn ppw_is_identity_power(p, k: int) -> bool
    let q = ppw_power(p, k)
    let n = len(q)
    let i = 0
    while i < n
        if q[i] != i
            return false
        i = i + 1
    return true

// _ppw_cycle_lengths — returns a list of the lengths of all cycles in p.
fn _ppw_cycle_lengths(p) -> any
    let n = len(p)
    let visited = []
    let i = 0
    while i < n
        push(visited, 0)
        i = i + 1
    let lengths = []
    let start = 0
    while start < n
        if visited[start] == 0
            let cur = start
            let clen = 0
            while visited[cur] == 0
                visited[cur] = 1
                cur = p[cur]
                clen = clen + 1
            push(lengths, clen)
        start = start + 1
    return lengths

// _ppw_gcd — greatest common divisor (Euclidean).
fn _ppw_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    while y != 0
        let t = y
        y = x - (x / y) * y
        x = t
    return x

// ppw_sqrt_exists — true iff there exists q with q^2 == p.
// A permutation has a square root iff every even-length cycle appears an even number of times.
fn ppw_sqrt_exists(p) -> any
    let n = len(p)
    if n == 0
        return true
    let lengths = _ppw_cycle_lengths(p)
    let nl = len(lengths)
    // Count occurrences of each even length; odd lengths always OK.
    // Use a dict keyed by stringified length.
    let counts = {}
    let i = 0
    while i < nl
        let cl = lengths[i]
        if cl / 2 * 2 == cl
            let key = str(cl)
            let prev = counts[key]
            counts[key] = prev + 1
        i = i + 1
    // Every even-length cycle count must be even.
    let i2 = 0
    while i2 < nl
        let cl = lengths[i2]
        if cl / 2 * 2 == cl
            let key = str(cl)
            let cnt = counts[key]
            if cnt / 2 * 2 != cnt
                return false
        i2 = i2 + 1
    return true
