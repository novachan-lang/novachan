// std/permutation/perm_compose.nova — composition and identity for one-line permutations.
// LEAF — imports NOTHING.
//
// A permutation of {0..n-1} is a list p where p[i] is the image of i.
// Composition convention: (p after q)[i] = p[q[i]].
//
// Public API:
//   pc_compose(p, q)     -> list  composition (p after q): result[i] = p[q[i]]
//   pc_identity(n)       -> list  identity permutation [0,1,...,n-1]
//   pc_is_identity(p)    -> bool  true iff p[i] == i for all i
//   pc_equal(p, q)       -> bool  true iff p and q are the same permutation

// pc_compose — compute (p after q): result[i] = p[q[i]] for all i in 0..len(q)-1.
fn pc_compose(p, q) -> any
    let n = len(q)
    let r = []
    for i in 0..n
        push(r, p[q[i]])
    r

// pc_identity — the identity permutation on {0..n-1}: result[i] = i.
fn pc_identity(n: int) -> any
    let r = []
    for i in 0..n
        push(r, i)
    r

// pc_is_identity — true iff every element p[i] == i (p is the identity).
fn pc_is_identity(p) -> bool
    let n = len(p)
    for i in 0..n
        if p[i] != i
            return false
    true

// pc_equal — true iff p and q have the same length and p[i] == q[i] for all i.
fn pc_equal(p, q) -> bool
    let n = len(p)
    if n != len(q)
        return false
    for i in 0..n
        if p[i] != q[i]
            return false
    true
