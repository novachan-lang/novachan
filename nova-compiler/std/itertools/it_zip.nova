// std/itertools/it_zip.nova — Eager zip/unzip helpers.
// LEAF — imports NOTHING.
//
// Public API (prefix itz_):
//   itz_zip(a, b)            -> list-of-2-lists  pairs, truncated to shorter
//   itz_zip3(a, b, c)        -> list-of-3-lists  triples, truncated to shortest
//   itz_unzip(pairs)         -> [firsts, seconds] inverse of itz_zip
//   itz_zip_longest(a,b,fill)-> list-of-2-lists  pad shorter with fill
//   itz_enumerate(xs)        -> [[0,x0],[1,x1],...]  index+value pairs
//
// RAISED 2026-08-05: this file did NOT have the quadratic-append bug — it
// already used `push(out, ...)` throughout. What was raised: every index
// `while` loop building a fixed-size, index-determined output collapsed to a
// single comprehension (each out[i] is a pure function of i, so there is no
// reason to hand-roll the loop).

// itz_zip — pair elements from a and b, truncated to the shorter length.
fn itz_zip(a, b) -> any
    let m = min(len(a), len(b))
    [[a[i], b[i]] for i in 0..m]

// itz_zip3 — triple elements from a, b, c, truncated to the shortest length.
fn itz_zip3(a, b, c) -> any
    let m = min(min(len(a), len(b)), len(c))
    [[a[i], b[i], c[i]] for i in 0..m]

// itz_unzip — split a list-of-2-element-lists into [firsts, seconds].
// Returns [[],[]] for an empty input.
fn itz_unzip(pairs) -> any
    [[p[0] for p in pairs], [p[1] for p in pairs]]

// itz_zip_longest — pair elements, padding the shorter list with fill.
fn itz_zip_longest(a, b, fill: int) -> any
    let na = len(a)
    let nb = len(b)
    let m = max(na, nb)
    [[a[i] if i < na else fill, b[i] if i < nb else fill] for i in 0..m]

// itz_enumerate — produce [[0, x0], [1, x1], ...] from xs.
fn itz_enumerate(xs) -> any
    [[i, xs[i]] for i in 0..len(xs)]
