// std/itertools/it_accumulate.nova — Prefix-scan / running-aggregate helpers.
// LEAF — imports NOTHING.
//
// Public API (prefix ita_):
//   ita_sums(xs)     -> list  prefix sums     (same length as xs; [] for empty)
//   ita_products(xs) -> list  prefix products (same length as xs; [] for empty)
//   ita_maxima(xs)   -> list  running maximum (same length as xs; [] for empty)
//   ita_minima(xs)   -> list  running minimum (same length as xs; [] for empty)
//   ita_diffs(xs)    -> list  adjacent differences (length len(xs)-1; [] for 0 or 1 elem)
//
// RAISED 2026-08-05: this file did NOT have the quadratic-append bug — it
// already used `push(out, ...)` throughout. What was raised: the index
// `while i < n` loops (seeded from i=1, since index 0 is the running
// accumulator's seed) became `for i in 1..n`. ita_diffs has no running
// accumulator (out[i] depends only on xs[i], xs[i+1]) so it collapsed to a
// single comprehension. NOT delegated to std/core/collect.scan: scan(xs, f,
// init) seeds from an explicit `init` and returns length len(xs)+1 (init
// first) — a different contract from these, which seed from xs[0] and
// return length len(xs).

// ita_sums — prefix sums: out[i] = xs[0]+xs[1]+...+xs[i].
fn ita_sums(xs) -> any
    let n = len(xs)
    if n == 0
        return []
    let out = []
    let acc = xs[0]
    push(out, acc)
    for i in 1..n
        acc = acc + xs[i]
        push(out, acc)
    return out

// ita_products — prefix products: out[i] = xs[0]*xs[1]*...*xs[i].
fn ita_products(xs) -> any
    let n = len(xs)
    if n == 0
        return []
    let out = []
    let acc = xs[0]
    push(out, acc)
    for i in 1..n
        acc = acc * xs[i]
        push(out, acc)
    return out

// ita_maxima — running maximum: out[i] = max(xs[0..i]).
fn ita_maxima(xs) -> any
    let n = len(xs)
    if n == 0
        return []
    let out = []
    let cur = xs[0]
    push(out, cur)
    for i in 1..n
        if xs[i] > cur
            cur = xs[i]
        push(out, cur)
    return out

// ita_minima — running minimum: out[i] = min(xs[0..i]).
fn ita_minima(xs) -> any
    let n = len(xs)
    if n == 0
        return []
    let out = []
    let cur = xs[0]
    push(out, cur)
    for i in 1..n
        if xs[i] < cur
            cur = xs[i]
        push(out, cur)
    return out

// ita_diffs — adjacent differences: out[i] = xs[i+1]-xs[i]; length = len(xs)-1.
fn ita_diffs(xs) -> any
    let n = len(xs)
    if n <= 1
        return []
    [xs[i + 1] - xs[i] for i in 0..(n - 1)]
