// std/itertools/it_flatten.nova — Eager list-concatenation helpers.
// LEAF — imports NOTHING.
//
// Public API (prefix itf_):
//   itf_flatten(xss)        -> list   concatenate a list-of-lists one level deep
//   itf_concat(a, b)        -> list   concatenate two flat lists
//   itf_concat_all(lists)   -> list   concatenate many flat lists
//   itf_repeat_concat(xs,n) -> list   xs repeated n times, concatenated
//
// RAISED 2026-08-05: this file did NOT have the quadratic-append bug — it
// already used `push(out, ...)` throughout. What was raised: index `while`
// loops became flat-map comprehensions (`for a in xs for b in a`, which
// chains exactly like the nested while did), and itf_concat became a spread
// (single allocation, no loop at all).
//
// NOT delegated to std/core/collect.flatten, on purpose: that flatten checks
// `type_of(x) == "list"` and passes a non-list element through unchanged.
// itf_flatten here unconditionally does `for v in inner` over every element
// of xss — given a non-list element it takes whatever NOVA's `for` does with
// that value (e.g. iterates a string's characters) rather than passing it
// through as one atom. Different contract on that edge case; kept separate.

// itf_flatten — concatenate a list-of-lists into one flat list (one level only).
fn itf_flatten(xss) -> any
    [v for inner in xss for v in inner]

// itf_concat — concatenate two flat lists.
fn itf_concat(a, b) -> any
    [...a, ...b]

// itf_concat_all — concatenate many flat lists.
fn itf_concat_all(lists) -> any
    [v for xs in lists for v in xs]

// itf_repeat_concat — concatenate xs with itself n times; n<=0 yields [].
fn itf_repeat_concat(xs, n: int) -> any
    if n <= 0
        return []
    [v for _ in 0..n for v in xs]
