// ============================================================================
// NOVA Standard Library — std/itertools/it_take_drop
// Slicing, stepping, and sub-list helpers for int lists.
// All public functions are prefixed itt_.
// ============================================================================
// RAISED 2026-08-05. Every function built its result with `out = out + [x]`
// inside a `while` — O(n^2) copies. itt_take/drop/take_last/drop_last/slice
// are all a fixed contiguous index range, so they became one-line
// comprehensions. itt_step walks by `step` (an IRREGULAR index jump, not a
// fixed range), so it keeps its `while` — but appends with `push` in place
// instead of `out = out + [...]`.
fn itt_take(xs, n)
    let lim = min(max(n, 0), len(xs))
    [xs[i] for i in 0..lim]

// itt_drop(xs, n) — all elements after the first n; n < 0 treated as 0.
fn itt_drop(xs, n)
    let start = max(n, 0)
    [xs[i] for i in start..len(xs)]

// itt_take_last(xs, n) — last n elements; clamped to [0, len(xs)].
fn itt_take_last(xs, n)
    let total = len(xs)
    let lim = min(max(n, 0), total)
    let start = total - lim
    [xs[i] for i in start..total]

// itt_drop_last(xs, n) — all elements except the last n; n < 0 treated as 0.
fn itt_drop_last(xs, n)
    let stop = max(len(xs) - n, 0)
    [xs[i] for i in 0..stop]

// itt_slice(xs, start, stop) — elements at indices [start, stop); clamps to valid range.
fn itt_slice(xs, start, stop)
    let s = max(start, 0)
    let e = min(stop, len(xs))
    [xs[i] for i in s..e]

// itt_step(xs, step) — every step-th element starting at index 0; step <= 0 returns [].
fn itt_step(xs, step)
    let out = []
    if step <= 0
        return out
    let n = len(xs)
    let i = 0
    while i < n
        push(out, xs[i])
        i += step
    return out
