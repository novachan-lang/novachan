// ============================================================================
// NOVA Standard Library — std/itertools/it_group.nova
// Run-length grouping and encoding helpers. Operates on lists of ints.
// ============================================================================
// RAISED 2026-08-05. Every function built its result (and, for group/rle, the
// per-run sublist too) with `out = out + [x]` — quadratic in both the outer
// and inner loop. The outer scan itself (finding where a run of equal
// adjacent values ends) is genuinely irregular — it jumps the index by the
// run length, not by 1 — so it keeps its `while`, but now with `push`.
// itg_rle is the one true scan; itg_group_consecutive and itg_run_lengths
// are now both DERIVED from it (a run's elements are just its value repeated
// `count` times, and a run's length is just `count`) instead of re-scanning
// xs themselves — same output, one code path to keep correct.
fn itg_rle(xs)
    let out = []
    let n = len(xs)
    let i = 0
    while i < n
        let v = xs[i]
        let j = i + 1
        while j < n and xs[j] == v
            j += 1
        push(out, [v, j - i])
        i = j
    return out

// itg_group_consecutive(xs) — split xs into sublists of equal adjacent values.
// [] -> []. [1,1,2] -> [[1,1],[2]].
fn itg_group_consecutive(xs)
    [[v for _ in 0..cnt] for (v, cnt) in itg_rle(xs)]

// itg_rle_decode(pairs) — decode run-length pairs [[value,count],...] back to flat list.
// [[1,2],[2,1],[3,3]] -> [1,1,2,3,3,3].
fn itg_rle_decode(pairs)
    let out = []
    for pair in pairs
        for _ in 0..pair[1]
            push(out, pair[0])
    return out

// itg_run_lengths(xs) — return just the consecutive run counts (not values).
// [1,1,2,3,3,3] -> [2,1,3]. [] -> [].
fn itg_run_lengths(xs)
    [cnt for (v, cnt) in itg_rle(xs)]
