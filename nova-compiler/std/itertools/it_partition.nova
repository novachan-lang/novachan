// ============================================================================
// NOVA Standard Library — std/itertools/it_partition.nova
// Partition helpers: split, halve, parity-split, chunked-runs.
// All functions are pure NOVA — int lists in, list-of-lists out.
// Prefix: itp_
// ============================================================================

// itp_split_at(xs, i) — split xs into [xs[0..i), xs[i..n)]; i clamped to [0,n].
fn itp_split_at(xs, i)
    let n = len(xs)
    let cut = i
    if cut < 0
        cut = 0
    if cut > n
        cut = n
    let left = []
    let j = 0
    while j < cut
        left = left + [xs[j]]
        j = j + 1
    let right = []
    let k = cut
    while k < n
        right = right + [xs[k]]
        k = k + 1
    let out = []
    out = out + [left]
    out = out + [right]
    return out

// itp_partition_parity(xs) — [evens_by_value, odds_by_value] preserving order.
fn itp_partition_parity(xs)
    let evens = []
    let odds = []
    let i = 0
    while i < len(xs)
        let v = xs[i]
        if v % 2 == 0
            evens = evens + [v]
        else
            odds = odds + [v]
        i = i + 1
    let out = []
    out = out + [evens]
    out = out + [odds]
    return out

// itp_halve(xs) — [first floor(n/2) elements, rest]; empty stays [[], []].
fn itp_halve(xs)
    let n = len(xs)
    let half = n / 2
    let left = []
    let i = 0
    while i < half
        left = left + [xs[i]]
        i = i + 1
    let right = []
    let j = half
    while j < n
        right = right + [xs[j]]
        j = j + 1
    let out = []
    out = out + [left]
    out = out + [right]
    return out

// itp_split_runs(xs, n) — chunk xs into consecutive runs of length n (last may be shorter); n<=0 returns [].
fn itp_split_runs(xs, n)
    let out = []
    if n <= 0
        return out
    let total = len(xs)
    let i = 0
    while i < total
        let chunk = []
        let j = 0
        while j < n and i + j < total
            chunk = chunk + [xs[i + j]]
            j = j + 1
        out = out + [chunk]
        i = i + n
    return out
