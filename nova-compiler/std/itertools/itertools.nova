// ============================================================================
// NOVA Standard Library — std/itertools/itertools.nova
// Lazy-ish iterator combinators over lists (return lists).
// All functions are pure NOVA — no new builtins required.
// ============================================================================

// it_range(a, b) — integers from a (inclusive) to b (exclusive)
fn it_range(a: int, b: int)
    let out = []
    let i = a
    while i < b
        out = out + [i]
        i = i + 1
    return out

// it_chain(xs, ys) — concatenate two lists
fn it_chain(xs, ys)
    let out = []
    let i = 0
    while i < len(xs)
        out = out + [xs[i]]
        i = i + 1
    let j = 0
    while j < len(ys)
        out = out + [ys[j]]
        j = j + 1
    return out

// it_zip(xs, ys) — pair elements: [[xs[0],ys[0]], [xs[1],ys[1]], ...]
// truncates to shorter length
fn it_zip(xs, ys)
    let out = []
    let m = len(xs)
    if len(ys) < m
        m = len(ys)
    let i = 0
    while i < m
        let pair = [xs[i], ys[i]]
        out = out + [pair]
        i = i + 1
    return out

// it_take(xs, n) — first n elements (clamped to list length)
fn it_take(xs, n)
    let out = []
    let lim = n
    if lim > len(xs)
        lim = len(xs)
    if lim < 0
        lim = 0
    let i = 0
    while i < lim
        out = out + [xs[i]]
        i = i + 1
    return out

// it_drop(xs, n) — all but the first n elements
fn it_drop(xs, n)
    let out = []
    let i = n
    if i < 0
        i = 0
    while i < len(xs)
        out = out + [xs[i]]
        i = i + 1
    return out

// it_windowed(xs, k) — sliding windows of size k (step 1)
// windows shorter than k at the tail are omitted
fn it_windowed(xs, k)
    let out = []
    if k <= 0
        return out
    let i = 0
    while i + k <= len(xs)
        let w = []
        let j = 0
        while j < k
            w = w + [xs[i + j]]
            j = j + 1
        out = out + [w]
        i = i + 1
    return out

// it_chunked(xs, k) — non-overlapping chunks of size k
// last chunk may be shorter; k<=0 returns []
fn it_chunked(xs, k)
    let out = []
    if k <= 0
        return out
    let i = 0
    while i < len(xs)
        let part = []
        let j = 0
        while j < k and i + j < len(xs)
            part = part + [xs[i + j]]
            j = j + 1
        out = out + [part]
        i = i + k
    return out

// it_enumerate(xs) — [[0, xs[0]], [1, xs[1]], ...]
fn it_enumerate(xs)
    let out = []
    let i = 0
    while i < len(xs)
        let pair = [i, xs[i]]
        out = out + [pair]
        i = i + 1
    return out

// it_flatten(xss) — concatenate a list of lists into one flat list
fn it_flatten(xss)
    let out = []
    let i = 0
    while i < len(xss)
        let inner = xss[i]
        let j = 0
        while j < len(inner)
            out = out + [inner[j]]
            j = j + 1
        i = i + 1
    return out

// it_repeat(x, n) — produce a list of n copies of x
fn it_repeat(x, n)
    let out = []
    let i = 0
    while i < n
        out = out + [x]
        i = i + 1
    return out
