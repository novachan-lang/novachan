// ============================================================================
// NOVA Standard Library — std/itertools/it_rotate.nova
// Rotation and cyclic helpers for int lists.
// Prefix: itr_
// ============================================================================
// RAISED 2026-08-05. Every function built its result with `out = out + [x]`
// inside a `while` — O(n^2) copies. Rotation and cyclic-take are both a
// fixed-size output where element i is a modular-arithmetic function of the
// input index, so each became a one-line comprehension. itr_reverse now
// delegates to the builtin `reverse`.
fn itr_rotate_left(xs, k)
    let n = len(xs)
    if n == 0
        return []
    let shift = ((k % n) + n) % n
    [xs[(shift + i) % n] for i in 0..n]

// itr_rotate_right(xs, k) — rotate right by k mod len(xs).
fn itr_rotate_right(xs, k)
    let n = len(xs)
    if n == 0
        return []
    let shift = ((k % n) + n) % n
    let start = n - shift
    [xs[(start + i) % n] for i in 0..n]

// itr_cycle_take(xs, n) — repeat xs cyclically to produce exactly n elements; xs empty or n<=0 returns [].
fn itr_cycle_take(xs, n)
    let m = len(xs)
    if m == 0 or n <= 0
        return []
    [xs[i % m] for i in 0..n]

// itr_reverse(xs) — reverse the list.
fn itr_reverse(xs)
    reverse(xs)
