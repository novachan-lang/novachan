// ============================================================================
// NOVA Standard Library — std/itertools/it_window
// Sliding-window helpers for int lists.
// Self-contained — imports nothing.
// All public functions are prefixed itw_.
// ============================================================================

// itw_window(xs, k) — all length-k sliding windows with step 1; returns [] if k > len(xs) or k <= 0.
fn itw_window(xs, k)
    let out = []
    if k <= 0
        return out
    let n = len(xs)
    let i = 0
    while i + k <= n
        let row = []
        let j = 0
        while j < k
            row = row + [xs[i + j]]
            j = j + 1
        out = out + [row]
        i = i + 1
    return out

// itw_pairwise(xs) — adjacent pairs [[xs[0],xs[1]], [xs[1],xs[2]], ...]; [] if len < 2.
fn itw_pairwise(xs)
    let out = []
    let n = len(xs)
    let i = 0
    while i + 2 <= n
        let row = [xs[i], xs[i + 1]]
        out = out + [row]
        i = i + 1
    return out

// itw_windows_count(xs, k) — number of windows itw_window(xs,k) would produce.
fn itw_windows_count(xs, k)
    if k <= 0
        return 0
    let n = len(xs)
    if n < k
        return 0
    return n - k + 1

// itw_triples(xs) — all consecutive triples [[xs[0],xs[1],xs[2]], ...]; [] if len < 3.
fn itw_triples(xs)
    let out = []
    let n = len(xs)
    let i = 0
    while i + 3 <= n
        let row = [xs[i], xs[i + 1], xs[i + 2]]
        out = out + [row]
        i = i + 1
    return out
