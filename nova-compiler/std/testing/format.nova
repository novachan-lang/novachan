// std/testing/format.nova -- TAP-style test-result formatting.
//
// Public API (prefix tfmt_):
//   tfmt_result(name, ok)       -> string  "ok - name" or "not ok - name"
//   tfmt_tap(results)           -> string  full TAP report ("1..N" header + lines)
//   tfmt_summary(passed, failed)-> string  "N passed, M failed"
//   tfmt_pct(passed, total)     -> int     pass percentage (0/0 -> 100)
//
// LEAF -- imports NOTHING.
// `ok` is an int (booleans are ints in NOVA: true==1, false==0).

// ── public functions ─────────────────────────────────────────────────────────

// Format a single test result in TAP style.
// tfmt_result("test1", 1) -> "ok - test1"
// tfmt_result("test2", 0) -> "not ok - test2"
fn tfmt_result(name: string, ok: int) -> string
    if ok
        return "ok - " + name
    return "not ok - " + name

// Build a complete TAP report from a list of [name, ok] pairs.
// Produces: "1..N\n<line1>\n<line2>\n..." (no trailing newline).
// tfmt_tap([["a",1],["b",0]]) ->
//   "1..2\nok - a\nnot ok - b"
fn tfmt_tap(results) -> string
    let n = len(results)
    let out = "1.." + str(n)
    let i = 0
    while i < n
        let row = results[i]
        let rname = row[0]
        let rok = row[1]
        let line = tfmt_result(rname, rok)
        out = out + "\n" + line
        i = i + 1
    out

// Summarise pass/fail counts.
// tfmt_summary(3, 1) -> "3 passed, 1 failed"
fn tfmt_summary(passed: int, failed: int) -> string
    str(passed) + " passed, " + str(failed) + " failed"

// Pass percentage. Returns 100 when total == 0 (vacuously all passed).
// tfmt_pct(3, 4) -> 75
// tfmt_pct(0, 0) -> 100
fn tfmt_pct(passed: int, total: int) -> int
    if total == 0
        return 100
    return passed * 100 / total
