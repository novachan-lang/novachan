// ============================================================================
// NOVA Standard Library — std/testing/mock
// ============================================================================
// Call-recording mock / stub (data-driven, no function values needed).
// A mock is represented as a plain dict — callers create one with tmock_new()
// and pass it to every operation.  This keeps the API pure-data and avoids
// any closure or function-value requirements.
//
// Internal dict layout:
//   m["calls"]   : list of recorded arg-lists  (each element is a list)
//   m["ret"]     : the configured return value  (any)
//   m["has_ret"] : int  1 = a return value has been configured, 0 = not yet
//
// Public API (prefix tmock_):
//   tmock_new()                  -> dict   create a fresh mock
//   tmock_record(m, args_list)           record one call with its args
//   tmock_call_count(m)          -> int   total number of recorded calls
//   tmock_called_with(m, args)   -> int   1 iff any call matches args exactly
//   tmock_nth_call(m, i)         -> list  args of the i-th call (0-indexed)
//   tmock_set_return(m, value)           configure the mock's return value
//   tmock_return(m)              -> any   the configured return value
//   tmock_reset(m)                       clear all recorded calls and return
// ============================================================================

// ── private: element-wise list equality ──────────────────────────────────────
// Returns 1 iff lists a and b have the same length and a[i]==b[i] for all i.
// We cannot rely on list==list performing deep equality across all contexts,
// so we implement it explicitly.
fn _tmock_lists_eq(a, b) -> int
    let na = len(a)
    let nb = len(b)
    let eq = 0
    if na == nb
        let i = 0
        let all = 1
        while i < na and all == 1
            let av = a[i]
            let bv = b[i]
            if av != bv
                all = 0
            i = i + 1
        eq = all
    return eq

// ── tmock_new ─────────────────────────────────────────────────────────────────
// Returns a freshly initialised mock dict.
fn tmock_new() -> dict
    let m = {}
    m["calls"] = []
    m["ret"] = null
    m["has_ret"] = 0
    return m

// ── tmock_record ─────────────────────────────────────────────────────────────
// Append args_list as one recorded call.  args_list should be a list of the
// arguments passed to the mock (e.g. [1, 2]).
fn tmock_record(m, args_list)
    let calls = m["calls"]
    calls.push(args_list)

// ── tmock_call_count ─────────────────────────────────────────────────────────
// Returns the number of calls recorded so far.
fn tmock_call_count(m) -> int
    let calls = m["calls"]
    return len(calls)

// ── tmock_called_with ────────────────────────────────────────────────────────
// Returns 1 if the mock was called at least once with exactly these args
// (element-wise equality), 0 otherwise.
fn tmock_called_with(m, args_list) -> int
    let calls = m["calls"]
    let n = len(calls)
    let i = 0
    let found = 0
    while i < n and found == 0
        let call = calls[i]
        if _tmock_lists_eq(call, args_list) == 1
            found = 1
        i = i + 1
    return found

// ── tmock_nth_call ───────────────────────────────────────────────────────────
// Returns the arg-list of the i-th recorded call (0-indexed).
// Returns an empty list if i is out of range.
fn tmock_nth_call(m, i) -> list
    let calls = m["calls"]
    let n = len(calls)
    let result = []
    if i >= 0 and i < n
        result = calls[i]
    return result

// ── tmock_set_return ─────────────────────────────────────────────────────────
// Configure the value that tmock_return will produce.
fn tmock_set_return(m, value)
    m["ret"] = value
    m["has_ret"] = 1

// ── tmock_return ─────────────────────────────────────────────────────────────
// Returns the configured return value (set via tmock_set_return).
// Returns null if no return value has been configured.
fn tmock_return(m)
    return m["ret"]

// ── tmock_reset ──────────────────────────────────────────────────────────────
// Clears all recorded calls and resets the configured return value.
// After reset the mock is in the same state as a freshly created one.
fn tmock_reset(m)
    m["calls"] = []
    m["ret"] = null
    m["has_ret"] = 0
