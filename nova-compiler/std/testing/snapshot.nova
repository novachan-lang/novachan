// ============================================================================
// NOVA Standard Library — std/testing/snapshot
// ============================================================================
// Snapshot testing: serialize a value to a canonical string, compare vs stored.
//
// Public API (prefix snap_):
//   snap_serialize(value) -> string
//       Deterministic canonical serialization.
//       Scalars (int/float/bool/null/string): str() representation as-is.
//       Lists:  "[a,b,c]"  (elements serialized recursively, no spaces).
//       Dicts:  "{k:v,...}" with keys sorted lexicographically, no spaces.
//
//   snap_matches(value, stored) -> bool (1/0)
//       Returns 1 iff snap_serialize(value) == stored.
//
//   snap_diff(value, stored) -> string
//       Returns "" if snap_matches; otherwise a diagnostic string:
//       "snapshot mismatch: got <serialized> want <stored>".
//
// This file also provides a second, independent API — a keyed snapshot
// STORE (prefix sn_) built directly on top of snap_serialize/snap_diff
// above. Where snap_* compares one value against one already-known stored
// string, sn_* manages a whole collection of named snapshots (e.g. one per
// test case) in a single dict, so a suite can record/check many snapshots
// by key without the caller threading individual "stored" strings around.
// See the "Keyed snapshot store" section below for full documentation.
//
// NOTE: Brace characters INTERPOLATE in NOVA string literals.
//       chr(123) = '{'   chr(125) = '}'
// All functions are pure (no I/O). They never call exit, so they are safe
// inside any test framework.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _snap_ser_list serializes a list to "[e0,e1,...,eN-1]".
// Each element is serialized recursively via snap_serialize.
fn _snap_ser_list(xs) -> string
    let n = len(xs)
    let out = "["
    for i in 0..n
        let elem = xs[i]
        let s = snap_serialize(elem)
        if i == 0
            out = out + s
        else
            out = out + "," + s
    out = out + "]"
    return out

// _snap_ser_dict serializes a dict to "{k0:v0,k1:v1,...}" with sorted keys.
// Keys are always strings (NOVA dict constraint). Values serialized recursively.
// Uses chr(123) for '{' and chr(125) for '}' to avoid brace interpolation.
fn _snap_ser_dict(d) -> string
    let ks = keys(d)
    let sorted_ks = sort(ks)
    let n = len(sorted_ks)
    let ob = chr(123)
    let cb = chr(125)
    let out = ob
    let i = 0
    while i < n
        let k = sorted_ks[i]
        let v = d[k]
        let vs = snap_serialize(v)
        if i == 0
            out = out + k + ":" + vs
        else
            out = out + "," + k + ":" + vs
        i = i + 1
    out = out + cb
    return out

// ── Public API ───────────────────────────────────────────────────────────────

// snap_serialize produces a deterministic canonical string for any NOVA value.
// Scalars:  str(value)              e.g. "42", "3.14", "hello", "true", "null"
// Lists:    "[e0,e1,e2]"            elements serialized recursively
// Dicts:    "{k0:v0,k1:v1}"        keys sorted lexicographically, values recursive
fn snap_serialize(value) -> string
    let t = type_of(value)
    if t == "list"
        return _snap_ser_list(value)
    if t == "dict"
        return _snap_ser_dict(value)
    return str(value)

// snap_matches returns 1 iff snap_serialize(value) == stored.
fn snap_matches(value, stored: string) -> int
    let s = snap_serialize(value)
    if s == stored
        return 1
    return 0

// snap_diff returns "" if the serialized value matches stored,
// or a diagnostic string describing the mismatch.
fn snap_diff(value, stored: string) -> string
    let s = snap_serialize(value)
    if s == stored
        return ""
    return "snapshot mismatch: got " + s + " want " + stored

// ============================================================================
// Keyed snapshot store (prefix sn_)
// ============================================================================
// A store is a plain dict mapping key (string) -> the CANONICAL SERIALIZED
// string for that key (i.e. snap_serialize(value) at record time, never the
// raw value). Every sn_* operation re-serializes its `value` argument via
// snap_serialize and compares/stores that string — no serialization logic
// is duplicated here.
//
// Public API (prefix sn_):
//   sn_new()                     -> dict    create an empty snapshot store
//   sn_record(store, key, value)          save value's canonical serialization
//                                          under key (overwrites any prior one)
//   sn_check(store, key, value)  -> int     1 iff key exists AND its stored
//                                          serialization == snap_serialize(value);
//                                          0 if the key was never recorded OR
//                                          the value differs
//   sn_diff(store, key, value)   -> string  "" if sn_check would return 1;
//                                          otherwise a diagnostic string.
//                                          If key was never recorded:
//                                            "no snapshot recorded for key <key>"
//                                          Else reuses snap_diff's message:
//                                            "snapshot mismatch: got <s> want <stored>"
//   sn_keys(store)                -> list   all recorded keys (unsorted —
//                                          insertion-order-independent per
//                                          NOVA dict semantics; sort() the
//                                          result if a deterministic order
//                                          is required)
//   sn_count(store)               -> int    number of recorded keys
// ============================================================================

// ── sn_new ────────────────────────────────────────────────────────────────────
// Returns a freshly initialised, empty snapshot store.
fn sn_new() -> dict
    return {}

// ── sn_record ─────────────────────────────────────────────────────────────────
// Serializes value canonically and stores it under key, overwriting any
// snapshot previously recorded for that key.
fn sn_record(store: dict, key: string, value)
    store[key] = snap_serialize(value)

// ── sn_check ──────────────────────────────────────────────────────────────────
// Returns 1 iff key has a recorded snapshot AND it matches value's current
// canonical serialization. Returns 0 if key was never recorded, or if it
// was recorded but the serialization differs.
fn sn_check(store: dict, key: string, value) -> int
    if not contains(store, key)
        return 0
    return snap_matches(value, store[key])

// ── sn_diff ───────────────────────────────────────────────────────────────────
// Returns "" when sn_check(store, key, value) would return 1. Otherwise
// returns a diagnostic string: a dedicated message when key has no recorded
// snapshot yet, or snap_diff's standard mismatch message when it does but
// the value has changed.
fn sn_diff(store: dict, key: string, value) -> string
    if not contains(store, key)
        return "no snapshot recorded for key " + key
    return snap_diff(value, store[key])

// ── sn_keys ───────────────────────────────────────────────────────────────────
// Returns the list of every key currently recorded in store.
fn sn_keys(store: dict) -> list
    return keys(store)

// ── sn_count ──────────────────────────────────────────────────────────────────
// Returns the number of keys currently recorded in store.
fn sn_count(store: dict) -> int
    return len(keys(store))

// ============================================================================
fn main()
    print("std/testing/snapshot loaded")
