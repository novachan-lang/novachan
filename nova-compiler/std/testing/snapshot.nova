// ============================================================================
// NOVA Standard Library — std/testing/snapshot
// ============================================================================
// Snapshot testing: serialize a value to a canonical string, compare vs stored.
//
// Public API (prefix snap_):
//   snap_serialize(value) -> string
//       Deterministic canonical serialization.
//       Scalars (int/float/bool/null/string): str() representation as-is.
//       Lists:  "[a,b,c]"  (elements serialized recursively, no spaces).
//       Dicts:  "{k:v,...}" with keys sorted lexicographically, no spaces.
//
//   snap_matches(value, stored) -> bool (1/0)
//       Returns 1 iff snap_serialize(value) == stored.
//
//   snap_diff(value, stored) -> string
//       Returns "" if snap_matches; otherwise a diagnostic string:
//       "snapshot mismatch: got <serialized> want <stored>".
//
// NOTE: Brace characters INTERPOLATE in NOVA string literals.
//       chr(123) = '{'   chr(125) = '}'
// All functions are pure (no I/O). They never call exit, so they are safe
// inside any test framework.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _snap_ser_list serializes a list to "[e0,e1,...,eN-1]".
// Each element is serialized recursively via snap_serialize.
fn _snap_ser_list(xs) -> string
    let n = len(xs)
    let out = "["
    let i = 0
    while i < n
        let elem = xs[i]
        let s = snap_serialize(elem)
        if i == 0
            out = out + s
        else
            out = out + "," + s
        i = i + 1
    out = out + "]"
    return out

// _snap_ser_dict serializes a dict to "{k0:v0,k1:v1,...}" with sorted keys.
// Keys are always strings (NOVA dict constraint). Values serialized recursively.
// Uses chr(123) for '{' and chr(125) for '}' to avoid brace interpolation.
fn _snap_ser_dict(d) -> string
    let ks = keys(d)
    let sorted_ks = sort(ks)
    let n = len(sorted_ks)
    let ob = chr(123)
    let cb = chr(125)
    let out = ob
    let i = 0
    while i < n
        let k = sorted_ks[i]
        let v = d[k]
        let vs = snap_serialize(v)
        if i == 0
            out = out + k + ":" + vs
        else
            out = out + "," + k + ":" + vs
        i = i + 1
    out = out + cb
    return out

// ── Public API ───────────────────────────────────────────────────────────────

// snap_serialize produces a deterministic canonical string for any NOVA value.
// Scalars:  str(value)              e.g. "42", "3.14", "hello", "true", "null"
// Lists:    "[e0,e1,e2]"            elements serialized recursively
// Dicts:    "{k0:v0,k1:v1}"        keys sorted lexicographically, values recursive
fn snap_serialize(value) -> string
    let t = type_of(value)
    if t == "list"
        return _snap_ser_list(value)
    if t == "dict"
        return _snap_ser_dict(value)
    return str(value)

// snap_matches returns 1 iff snap_serialize(value) == stored.
fn snap_matches(value, stored: string) -> int
    let s = snap_serialize(value)
    if s == stored
        return 1
    return 0

// snap_diff returns "" if the serialized value matches stored,
// or a diagnostic string describing the mismatch.
fn snap_diff(value, stored: string) -> string
    let s = snap_serialize(value)
    if s == stored
        return ""
    return "snapshot mismatch: got " + s + " want " + stored

// ============================================================================
fn main()
    print("std/testing/snapshot loaded")
