// std/testing/matchers -- Predicate matchers returning bool (1/0). LEAF -- imports NOTHING.
//
// Public API (prefix matchr_):
//   matchr_is_empty(x)        -> bool  1 if string/list/dict has length 0
//   matchr_is_sorted(xs)      -> bool  1 if list is in non-descending order
//   matchr_is_unique(xs)      -> bool  1 if list has no duplicate int/string values
//   matchr_in_range(x,lo,hi)  -> bool  1 if lo <= x <= hi (inclusive, int)
//   matchr_has_key(d, k)      -> bool  1 if dict d contains key k
//   matchr_length(x, n)       -> bool  1 if len(x) == n
//   matchr_starts_with(s, p)  -> bool  1 if string s starts with prefix p
//   matchr_between(x, lo, hi) -> bool  1 if lo < x < hi (exclusive, int)

// matchr_is_empty: returns 1 if x is an empty string, list, or dict.
fn matchr_is_empty(x) -> int
    let n = len(x)
    if n == 0
        return 1
    return 0

// matchr_is_sorted: returns 1 if list xs is in non-descending order.
// Works with int elements. An empty or single-element list is sorted.
fn matchr_is_sorted(xs) -> int
    let n = len(xs)
    if n <= 1
        return 1
    let i = 1
    let ok = 1
    while i < n and ok == 1
        let prev = xs[i - 1]
        let curr = xs[i]
        if curr < prev
            ok = 0
        i += 1
    ok

// matchr_is_unique: returns 1 if list xs has no duplicate elements.
// Uses a dict as a seen-set; elements are converted to string keys.
fn matchr_is_unique(xs) -> int
    let n = len(xs)
    let seen = {}
    let i = 0
    let ok = 1
    while i < n and ok == 1
        let k = str(xs[i])
        if k in seen
            ok = 0
        seen[k] = 1
        i += 1
    ok

// matchr_in_range: returns 1 if lo <= x <= hi (inclusive).
fn matchr_in_range(x, lo, hi) -> int
    if x < lo
        return 0
    if x > hi
        return 0
    return 1

// matchr_has_key: returns 1 if dict d contains string key k.
fn matchr_has_key(d, k) -> int
    if k in d
        return 1
    return 0

// matchr_length: returns 1 if len(x) == n.
fn matchr_length(x, n) -> int
    let l = len(x)
    if l == n
        return 1
    return 0

// matchr_starts_with: returns 1 if string s starts with prefix p.
// Empty prefix always matches. p longer than s never matches.
fn matchr_starts_with(s, p) -> int
    let sl = len(s)
    let pl = len(p)
    if pl == 0
        return 1
    if pl > sl
        return 0
    let prefix = slice(s, 0, pl)
    if prefix == p
        return 1
    return 0

// matchr_between: returns 1 if lo < x < hi (exclusive).
fn matchr_between(x, lo, hi) -> int
    if x <= lo
        return 0
    if x >= hi
        return 0
    return 1
