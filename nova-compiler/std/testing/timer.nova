// ============================================================================
// NOVA Standard Library — std/testing/timer
// ============================================================================
// Deterministic test-timing utilities. All time values are nanoseconds (int).
// Uses INJECTED timestamps so tests never depend on a real wall clock.
//
// Public API (prefix ttmr_):
//   ttmr_new(startNs)          -> dict  create a timer starting at startNs
//   ttmr_elapsed(t, nowNs)     -> int   total ns since start
//   ttmr_lap(t, nowNs)         -> int   ns since last lap (mutates t["lap"])
//   ttmr_format_ns(ns)         -> string human-readable time (e.g. "1.50ms")
//   ttmr_faster(nsA, nsB)      -> bool  true iff nsA < nsB
//
// LEAF — imports NOTHING.
// ============================================================================

// ── private helper: format 2 decimal places as "D.DDunit" ────────────────────
// Takes whole units and the remainder scaled to 100ths, e.g.
//   whole=1, frac100=50, unit="ms" -> "1.50ms"
// frac100 is the fractional part already scaled: floor((ns % denom)*100/denom).
fn _ttmr_fmt2(whole, frac100, unit) -> string
    let frac_str = str(frac100)
    let frac_padded = frac_str
    if frac100 < 10
        frac_padded = "0" + frac_str
    return str(whole) + "." + frac_padded + unit

// ── ttmr_new ─────────────────────────────────────────────────────────────────
// Create a new timer dict seeded at startNs.
//   t["start"] — the start time in ns
//   t["lap"]   — the last-lap reference point (starts equal to start)
fn ttmr_new(startNs) -> dict
    let t = {}
    t["start"] = startNs
    t["lap"] = startNs
    return t

// ── ttmr_elapsed ─────────────────────────────────────────────────────────────
// Total nanoseconds since the timer was created.
fn ttmr_elapsed(t, nowNs) -> int
    return nowNs - t["start"]

// ── ttmr_lap ─────────────────────────────────────────────────────────────────
// Nanoseconds since the last lap (or start if no lap yet).
// Mutates t["lap"] to nowNs so subsequent calls measure from this point.
fn ttmr_lap(t, nowNs) -> int
    let prev = t["lap"]
    let delta = nowNs - prev
    t["lap"] = nowNs
    return delta

// ── ttmr_format_ns ───────────────────────────────────────────────────────────
// Format a nanosecond count as a human-readable string.
// Thresholds:
//   >= 1_000_000_000 ns  -> seconds  "X.YYs"
//   >= 1_000_000 ns      -> ms       "X.YYms"
//   >= 1_000 ns          -> us       "X.YYus"
//   < 1_000 ns           -> ns       "Nns"   (integer, no decimals)
fn ttmr_format_ns(ns) -> string
    let result = ""
    if ns >= 1000000000
        let whole = ns / 1000000000
        let rem = ns - whole * 1000000000
        let frac100 = rem * 100 / 1000000000
        result = _ttmr_fmt2(whole, frac100, "s")
    else
        if ns >= 1000000
            let whole = ns / 1000000
            let rem = ns - whole * 1000000
            let frac100 = rem * 100 / 1000000
            result = _ttmr_fmt2(whole, frac100, "ms")
        else
            if ns >= 1000
                let whole = ns / 1000
                let rem = ns - whole * 1000
                let frac100 = rem * 100 / 1000
                result = _ttmr_fmt2(whole, frac100, "us")
            else
                result = str(ns) + "ns"
    return result

// ── ttmr_faster ──────────────────────────────────────────────────────────────
// Returns true (1) iff nsA is strictly less than nsB.
fn ttmr_faster(nsA, nsB) -> bool
    return nsA < nsB
