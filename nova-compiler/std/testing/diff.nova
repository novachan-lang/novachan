// ============================================================================
// NOVA Standard Library — std/testing/diff
// ============================================================================
// Value diffing for test failure messages.
//
// Public API (prefix tdif_):
//   tdif_equal(a, b) -> bool
//       Deep equality: scalars compared with ==; lists element-by-element;
//       dicts key-by-key (both key-sets and all mapped values must agree).
//       Returns true if structurally identical, false otherwise.
//
//   tdif_values(a, b) -> string
//       Human-readable diff: "" if equal; otherwise a description such as
//       "expected <a> got <b>" (scalars) or "[index <i>] expected <x> got <y>"
//       for the first differing position in a list.
//
//   tdif_lists(a, b) -> list
//       Returns a list of integer indices where the two lists first differ.
//       Both lists are compared up to the shorter length; then any trailing
//       indices of the longer list are also included as divergence points.
//       Returns [] if identical (same length, same elements).
//
//   tdif_summary(a, b) -> string
//       One-line summary: "EQUAL" if equal, otherwise
//       "DIFF: <N> difference(s)" where N is the count of differing indices
//       for lists, or 1 for scalar/dict divergence.
//
// All functions are pure (no I/O, no side effects). They RETURN data; they
// never call exit, so they are safe to use inside other test frameworks.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _type_tag returns a string tag for the runtime kind of a value.
// NOVA type_of returns: "int", "float", "bool", "null", "string",
//                        "list", "dict", "struct", "fn", ...
fn _type_tag(v)
    return type_of(v)

// _scalar_eq compares two non-list, non-dict values for equality.
// Falls back to == which handles int/float/string/bool/null.
fn _scalar_eq(a, b)
    if a == b
        return true
    return false

// _list_eq returns true when a and b are lists with identical length
// and pairwise-equal elements (recursive).
fn _list_eq(a, b)
    let la = len(a)
    let lb = len(b)
    if la != lb
        return false
    let i = 0
    while i < la
        let ea = a[i]
        let eb = b[i]
        if not tdif_equal(ea, eb)
            return false
        i = i + 1
    return true

// _dict_eq returns true when a and b are dicts with the same key-set and
// pairwise-equal values for every key.
fn _dict_eq(a, b)
    let ka = keys(a)
    let kb = keys(b)
    if len(ka) != len(kb)
        return false
    // Every key in a must exist in b with the same value.
    let i = 0
    while i < len(ka)
        let k = ka[i]
        if not contains(b, k)
            return false
        let va = a[k]
        let vb = b[k]
        if not tdif_equal(va, vb)
            return false
        i = i + 1
    // All keys in b must also be in a (length already equal, so no extras).
    return true

// ── Public API ───────────────────────────────────────────────────────────────

// tdif_equal performs a deep structural equality check.
// Scalars: standard == comparison.
// Lists:   same length + all elements recursively equal.
// Dicts:   same key-set + all values recursively equal.
fn tdif_equal(a, b)
    let ta = _type_tag(a)
    let tb = _type_tag(b)
    if ta != tb
        return false
    if ta == "list"
        return _list_eq(a, b)
    if ta == "dict"
        return _dict_eq(a, b)
    return _scalar_eq(a, b)

// tdif_values produces a human-readable diff string.
// Returns "" when a and b are equal.
// For scalars/dicts: "expected <a> got <b>".
// For lists: describes the first differing index.
fn tdif_values(a, b)
    if tdif_equal(a, b)
        return ""
    let ta = _type_tag(a)
    if ta == "list"
        let la = len(a)
        let lb = len(b)
        let shorter = la
        if lb < la
            shorter = lb
        let i = 0
        while i < shorter
            let ea = a[i]
            let eb = b[i]
            if not tdif_equal(ea, eb)
                return "[index " + str(i) + "] expected " + str(ea) + " got " + str(eb)
            i = i + 1
        // Lengths differ — report the first extra index.
        if la != lb
            return "[length] expected " + str(la) + " got " + str(lb)
        return ""
    // Scalar or dict fallback.
    return "expected " + str(a) + " got " + str(b)

// tdif_lists returns a list of indices at which two lists diverge.
// Indices beyond the shorter list are included when lengths differ.
fn tdif_lists(a, b)
    let la = len(a)
    let lb = len(b)
    let shorter = la
    if lb < la
        shorter = lb
    let result = []
    let i = 0
    while i < shorter
        if not tdif_equal(a[i], b[i])
            result.push(i)
        i = i + 1
    // Extra indices from the longer list count as divergence.
    let longer = la
    if lb > la
        longer = lb
    while i < longer
        result.push(i)
        i = i + 1
    return result

// tdif_summary returns "EQUAL" when the values are structurally identical,
// otherwise "DIFF: <N> difference(s)".
// For lists the count is the number of differing indices (via tdif_lists).
// For scalars and dicts the count is always 1.
fn tdif_summary(a, b)
    if tdif_equal(a, b)
        return "EQUAL"
    let ta = _type_tag(a)
    if ta == "list"
        let diffs = tdif_lists(a, b)
        let n = len(diffs)
        return "DIFF: " + str(n) + " difference(s)"
    return "DIFF: 1 difference(s)"

// ============================================================================
fn main()
    print("std/testing/diff loaded")
