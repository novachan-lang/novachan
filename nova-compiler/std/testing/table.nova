// ============================================================================
// NOVA Standard Library — std/testing/table.nova
// Table-driven testing: run a batch of [input, expected] rows through a
// comparator function and collect pass/fail statistics.
// Pure NOVA, no new builtins. Prefix: ttab_
// ============================================================================

// ttab_run(rows, comparator_fn) -> dict
//   rows          : list of [input, expected] pairs
//   comparator_fn : fn(input) -> actual
//
// For each row, calls comparator_fn(input) and checks whether the result
// deep-equals expected (using ==). Returns a summary dict:
//   {
//     "passed"   : int,          // number of rows that passed
//     "failed"   : int,          // number of rows that failed
//     "failures" : list          // list of failure-info dicts (empty if all pass)
//   }
//
// Each failure-info dict has:
//   { "index": int, "expected": any, "actual": any }
fn ttab_run(rows, comparator_fn)
    let passed = 0
    let failed = 0
    let failures = []
    for i in 0..len(rows)
        let row = rows[i]
        let input = row[0]
        let expected = row[1]
        let actual = comparator_fn(input)
        if actual == expected
            passed = passed + 1
        else
            failed = failed + 1
            let info = {}
            info["index"] = i
            info["expected"] = expected
            info["actual"] = actual
            failures.push(info)
    let result = {}
    result["passed"] = passed
    result["failed"] = failed
    result["failures"] = failures
    return result

// ttab_run_eq(rows, f) -> dict
//   Convenience wrapper: uses built-in == equality as the comparator.
//   Equivalent to ttab_run(rows, f) since ttab_run already uses ==.
//   f : fn(input) -> actual
fn ttab_run_eq(rows, f)
    return ttab_run(rows, f)

// ttab_all_pass(result) -> bool
//   Returns true iff the result dict from ttab_run / ttab_run_eq has
//   zero failures (result["failed"] == 0).
fn ttab_all_pass(result)
    return result["failed"] == 0
