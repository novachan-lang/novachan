// std/testing/property.nova — Property-based testing helpers.
// Pure NOVA. LEAF — imports nothing.
//
// Public API (prefix prop_):
//
//   prop_forall_int(predicate, lo, hi, trials, seed) -> dict
//     Runs predicate(x) for 'trials' random ints x in [lo, hi] using a
//     seeded LCG.  Returns:
//       { "ok": bool, "counterexample": int, "trials": int }
//     "ok"==1 means all sampled values satisfied the predicate.
//     "counterexample" is the first failing int (0 if all pass).
//     "trials" is the number of values actually tested.
//
//   prop_check(predicate, values) -> dict
//     Runs predicate(x) for each x in the explicit list.  Returns the
//     same dict shape as prop_forall_int.
//
// LCG parameters (Numerical Recipes): m=2^32, a=1664525, c=1013904223.
// We keep the state as a positive i64 by masking to 32 bits.

// _lcg_next: advance state and return the new state (always in [0, 2^32-1]).
fn _lcg_next(state) -> int
    let next = (state * 1664525 + 1013904223) and 4294967295
    return next

// _lcg_range: map an LCG state to an int in [lo, hi] (inclusive).
// Uses modulo; slight bias acceptable for property testing.
fn _lcg_range(state, lo, hi) -> int
    let span = hi - lo + 1
    let v = state - (state / span) * span
    return lo + v

// prop_forall_int: property test over random ints in [lo, hi].
fn prop_forall_int(predicate, lo, hi, trials, seed) -> dict
    let result = {}
    let state = seed and 4294967295
    let i = 0
    let ok = 1
    let counterexample = 0
    while i < trials and ok == 1
        state = _lcg_next(state)
        let x = _lcg_range(state, lo, hi)
        let passed = predicate(x)
        if passed == 0
            ok = 0
            counterexample = x
        i = i + 1
    result["ok"] = ok
    result["counterexample"] = counterexample
    result["trials"] = i
    return result

// prop_check: property test over an explicit list of values.
fn prop_check(predicate, values) -> dict
    let result = {}
    let n = len(values)
    let i = 0
    let ok = 1
    let counterexample = 0
    while i < n and ok == 1
        let x = values[i]
        let passed = predicate(x)
        if passed == 0
            ok = 0
            counterexample = x
        i = i + 1
    result["ok"] = ok
    result["counterexample"] = counterexample
    result["trials"] = i
    return result
