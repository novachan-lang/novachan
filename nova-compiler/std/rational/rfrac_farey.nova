// std/rational/rfrac_farey.nova — Farey sequences and mediants for exact rationals.
// LEAF — imports NOTHING.
//
// Rational representation: [num, den] of int, den > 0, gcd(|num|,den)=1.
// Zero = [0,1]. One = [1,1].
//
// Public API (prefix rff_):
//   rff_mediant(a,b)                  -> rational  mediant [an+bn, ad+bd] reduced
//   rff_farey_sequence(n)             -> list       all rationals in [0,1] with den<=n, ascending
//   rff_farey_next(an,ad,bn,bd,n)     -> rational   next term after b (given predecessor a) in F_n
//   rff_farey_length(n)               -> int         number of terms in F_n
//   rff_is_farey_neighbor(a,b)        -> bool        |an*bd - bn*ad| == 1

// _rff_gcd — Euclidean GCD on absolute values.
fn _rff_gcd(a, b)
    let u = a
    if u < 0
        u = 0 - u
    let v = b
    if v < 0
        v = 0 - v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// _rff_make — canonical rational [n,d] in lowest terms with den > 0.
// Invalid (d==0) returns [0,0].
fn _rff_make(n, d)
    let out = []
    if d == 0
        out.push(0)
        out.push(0)
        return out
    let num = n
    let den = d
    if den < 0
        num = 0 - num
        den = 0 - den
    if num == 0
        out.push(0)
        out.push(1)
        return out
    let an = num
    if an < 0
        an = 0 - an
    let g = _rff_gcd(an, den)
    out.push(num / g)
    out.push(den / g)
    out

// _rff_euler_phi — Euler's totient function phi(n) for n >= 1.
// Used by rff_farey_length.
fn _rff_euler_phi(n)
    if n <= 0
        return 0
    if n == 1
        return 1
    let result = n
    let p = 2
    let rem = n
    while p * p <= rem
        if rem % p == 0
            while rem % p == 0
                rem = rem / p
            result = result - result / p
        p = p + 1
    if rem > 1
        result = result - result / rem
    result

// rff_mediant — mediant of rationals a=[an,ad] and b=[bn,bd]: reduced [an+bn, ad+bd].
// For Farey neighbors the mediant is already in lowest terms; we reduce anyway for safety.
fn rff_mediant(a, b)
    let an = a[0]
    let ad = a[1]
    let bn = b[0]
    let bd = b[1]
    _rff_make(an + bn, ad + bd)

// rff_farey_next — compute the next term after p/q in Farey sequence F_n,
// given its predecessor a/b (where a/b < p/q are consecutive in F_n).
// Recurrence: k = floor((n + b) / q); next = [k*p - a, k*q - b].
// Arguments: an,ad = predecessor numerator/denominator; bn,bd = current num/den; n = order.
// rff_farey_next(0,1,1,5,5) -> [1,4]
fn rff_farey_next(an, ad, bn, bd, n)
    let k = (n + ad) / bd
    let next_n = k * bn - an
    let next_d = k * bd - ad
    _rff_make(next_n, next_d)

// rff_farey_sequence — generate all terms of F_n in ascending order.
// Starts with (0,1) and (1,n), then applies the Farey recurrence until (1,1) is reached.
// rff_farey_sequence(5) has 11 terms starting [0,1],[1,5],...,[1,1].
fn rff_farey_sequence(n)
    let out = []
    if n < 1
        return out
    // First two terms: 0/1 and 1/n
    let f0 = []
    f0.push(0)
    f0.push(1)
    out.push(f0)
    if n == 1
        let f1 = []
        f1.push(1)
        f1.push(1)
        out.push(f1)
        return out
    let prev_n = 0
    let prev_d = 1
    let curr_n = 1
    let curr_d = n
    let fn1 = []
    fn1.push(1)
    fn1.push(n)
    out.push(fn1)
    let done = 0
    while done == 0
        // Check if we've reached 1/1
        if curr_n == 1 and curr_d == 1
            done = 1
        if done == 0
            // Compute next term via Farey recurrence
            let k = (n + prev_d) / curr_d
            let next_n = k * curr_n - prev_n
            let next_d = k * curr_d - prev_d
            let term = []
            term.push(next_n)
            term.push(next_d)
            out.push(term)
            prev_n = curr_n
            prev_d = curr_d
            curr_n = next_n
            curr_d = next_d
    out

// rff_farey_length — number of terms in the Farey sequence F_n.
// Formula: |F_n| = 1 + sum_{k=1}^{n} phi(k).
// F_1 = 2, F_2 = 3, F_3 = 5, F_4 = 7, F_5 = 11.
fn rff_farey_length(n)
    if n < 1
        return 0
    let total = 1
    let k = 1
    while k <= n
        total = total + _rff_euler_phi(k)
        k = k + 1
    total

// rff_is_farey_neighbor — true iff a and b are Farey neighbors: |an*bd - bn*ad| == 1.
// This is the cross-product (determinant) condition for adjacent Farey fractions.
fn rff_is_farey_neighbor(a, b)
    let an = a[0]
    let ad = a[1]
    let bn = b[0]
    let bd = b[1]
    let cross = an * bd - bn * ad
    if cross < 0
        cross = 0 - cross
    cross == 1
