// std/rational/rfrac_harmonic.nova — exact harmonic sums as reduced rational [num, den].
// Representation: [num, den] with den > 0, gcd(|num|,den) = 1. Zero = [0,1]. Undefined = [0,0].
// PREFIX: rfh_   LEAF — imports nothing.

// _gcd: private — Euclidean gcd on absolute values.
fn _rfh_gcd(a, b) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    let tmp = 0
    if a == 0
        return b
    if b == 0
        return a
    tmp = b
    while tmp != 0
        let r = a - (a / tmp) * tmp
        a = tmp
        tmp = r
    a

// _make: private — build [n, d] in lowest terms with den > 0. Returns [0,0] if d==0.
fn _rfh_make(n, d) -> any
    if d == 0
        let r = [0, 0]
        return r
    if n == 0
        let r = [0, 1]
        return r
    let sign = 1
    if d < 0
        sign = 0 - 1
        d = 0 - d
        n = 0 - n
    let g = _rfh_gcd(n, d)
    if g < 0
        g = 0 - g
    if g == 0
        g = 1
    let rn = n / g
    let rd = d / g
    let r = [rn, rd]
    r

// _add: private — add two rationals.
fn _rfh_add(a, b) -> any
    let an = a[0]
    let ad = a[1]
    let bn = b[0]
    let bd = b[1]
    let n = an * bd + bn * ad
    let d = ad * bd
    _rfh_make(n, d)

// rfh_harmonic(n) -> rational H(n) = sum_{k=1..n} 1/k.
fn rfh_harmonic(n) -> any
    let acc = [0, 1]
    let k = 1
    while k <= n
        let term = _rfh_make(1, k)
        acc = _rfh_add(acc, term)
        k = k + 1
    acc

// _pow_int: private — integer power k^m (m >= 0).
fn _rfh_pow_int(k, m) -> int
    if m == 0
        return 1
    let result = 1
    let i = 0
    while i < m
        result = result * k
        i = i + 1
    result

// rfh_generalized(n, m) -> rational sum_{k=1..n} 1/k^m.
fn rfh_generalized(n, m) -> any
    let acc = [0, 1]
    let k = 1
    while k <= n
        let km = _rfh_pow_int(k, m)
        let term = _rfh_make(1, km)
        acc = _rfh_add(acc, term)
        k = k + 1
    acc

// rfh_unit_sum(dens) -> rational sum of 1/d_i for each d in dens.
fn rfh_unit_sum(dens) -> any
    let acc = [0, 1]
    let i = 0
    let n = len(dens)
    while i < n
        let d = dens[i]
        let term = _rfh_make(1, d)
        acc = _rfh_add(acc, term)
        i = i + 1
    acc

// rfh_alternating_harmonic(n) -> rational sum_{k=1..n} (-1)^(k+1) / k = 1 - 1/2 + 1/3 - ...
fn rfh_alternating_harmonic(n) -> any
    let acc = [0, 1]
    let k = 1
    while k <= n
        let num = 1
        if k - (k / 2) * 2 == 0
            num = 0 - 1
        let term = _rfh_make(num, k)
        acc = _rfh_add(acc, term)
        k = k + 1
    acc
