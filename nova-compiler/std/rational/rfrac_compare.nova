// std/rational/rfrac_compare.nova — Ordering and comparison for exact rationals.
// LEAF — imports NOTHING.
//
// Representation (same as rfrac_core, self-contained):
//   rational = [num, den] in lowest terms, den > 0. Zero=[0,1]. Invalid=[0,0].
//
// Comparison by cross-multiplication: a/b vs c/d => sign of (a*d - c*b).
// Since both b and d are positive, this preserves the correct ordering.
//
// Public API (prefix rfc_):
//   rfc_compare(a, b)  -> int   -1 if a<b, 0 if a==b, 1 if a>b
//   rfc_equals(a, b)   -> bool  a == b
//   rfc_lt(a, b)       -> bool  a < b
//   rfc_lte(a, b)      -> bool  a <= b
//   rfc_gt(a, b)       -> bool  a > b
//   rfc_gte(a, b)      -> bool  a >= b
//   rfc_min(a, b)      -> rational  lesser of a, b
//   rfc_max(a, b)      -> rational  greater of a, b
//   rfc_clamp(x,lo,hi) -> rational  x clamped to [lo, hi]

// _rfc_gcd — Euclidean GCD on absolute values (private).
fn _rfc_gcd(a: int, b: int) -> int
    let u = -a if a < 0 else a
    let v = -b if b < 0 else b
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// _rfc_make — reduce [n, d] to lowest terms, sign to numerator, den > 0.
// d == 0 -> [0, 0] (invalid).
fn _rfc_make(n: int, d: int) -> list
    if d == 0
        return [0, 0]
    let num = -n if d < 0 else n
    let den = -d if d < 0 else d
    if num == 0
        return [0, 1]
    let an = -num if num < 0 else num
    let g = _rfc_gcd(an, den)
    [num / g, den / g]

// _rfc_sign_of — returns -1, 0, or 1 for an integer value (private).
fn _rfc_sign_of(x: int) -> int
    if x < 0
        return -1
    if x > 0
        return 1
    0

// rfc_compare — three-way comparison of two rationals.
// Returns -1 if a < b, 0 if a == b, 1 if a > b.
// Cross-multiply: sign(an*bd - bn*ad). Both ad and bd are positive (canonical form),
// so the sign of the cross-product directly reflects the ordering.
fn rfc_compare(a: list, b: list) -> int
    let an = a[0]
    let ad = a[1]
    let bn = b[0]
    let bd = b[1]
    // compute cross difference: an*bd - bn*ad
    let lhs = an * bd
    let rhs = bn * ad
    let diff = lhs - rhs
    _rfc_sign_of(diff)

// rfc_equals — true iff a == b (equivalent fractions).
fn rfc_equals(a: list, b: list) -> bool
    rfc_compare(a, b) == 0

// rfc_lt — true iff a < b.
fn rfc_lt(a: list, b: list) -> bool
    rfc_compare(a, b) == -1

// rfc_lte — true iff a <= b.
fn rfc_lte(a: list, b: list) -> bool
    rfc_compare(a, b) != 1

// rfc_gt — true iff a > b.
fn rfc_gt(a: list, b: list) -> bool
    rfc_compare(a, b) == 1

// rfc_gte — true iff a >= b.
fn rfc_gte(a: list, b: list) -> bool
    rfc_compare(a, b) != -1

// rfc_min — return the lesser of two rationals.
fn rfc_min(a: list, b: list) -> list
    let c = rfc_compare(a, b)
    if c != 1
        return a
    b

// rfc_max — return the greater of two rationals.
fn rfc_max(a: list, b: list) -> list
    let c = rfc_compare(a, b)
    if c == 1
        return a
    b

// rfc_clamp — clamp rational x into [lo, hi].
// If x < lo returns lo; if x > hi returns hi; else returns x.
fn rfc_clamp(x: list, lo: list, hi: list) -> list
    if rfc_compare(x, lo) == -1
        return lo
    if rfc_compare(x, hi) == 1
        return hi
    x
