// std/rational/rfrac_continued.nova — Continued-fraction expansion of exact rationals.
// LEAF — imports NOTHING.
//
// Rational representation: [num, den] of int, den > 0, gcd(|num|,den)=1.
// Zero = [0,1]. Invalid/undefined = [0,0].
//
// Public API (prefix rfk_):
//   rfk_continued_fraction(r) -> list of int  CF coefficients via Euclidean algorithm
//   rfk_from_continued(coeffs) -> rational     reconstruct rational from CF coefficients
//   rfk_convergents(r)         -> list         successive convergents (list of rationals)
//   rfk_nth_convergent(r,n)    -> rational     n-th convergent (0-indexed)

// _rfk_gcd — Euclidean GCD on absolute values.
fn _rfk_gcd(a, b)
    let u = a
    if u < 0
        u = 0 - u
    let v = b
    if v < 0
        v = 0 - v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// _rfk_make — build canonical rational [n,d] in lowest terms with den > 0.
// Invalid input (d==0) returns [0,0].
fn _rfk_make(n, d)
    let out = []
    if d == 0
        out.push(0)
        out.push(0)
        return out
    let num = n
    let den = d
    if den < 0
        num = 0 - num
        den = 0 - den
    if num == 0
        out.push(0)
        out.push(1)
        return out
    let an = num
    if an < 0
        an = 0 - an
    let g = _rfk_gcd(an, den)
    out.push(num / g)
    out.push(den / g)
    out

// rfk_continued_fraction — CF coefficients [a0,a1,...] of rational r=[num,den].
// Uses the standard Euclidean algorithm: emit floor(n/d), then (n,d) <- (d, n mod d).
// For n/d >= 0: floor(n/d) = n/d in NOVA (truncation equals floor for non-negative).
// The sign of the rational is handled: if r is negative, a0 is negative (standard CF).
// rfk_continued_fraction([415,93]) -> [4,2,6,7]
// rfk_continued_fraction([1,2])    -> [0,2]
// rfk_continued_fraction([5,1])    -> [5]
fn rfk_continued_fraction(r)
    let out = []
    let n = r[0]
    let d = r[1]
    if d == 0
        return out
    // Ensure d > 0 (should always be true for canonical rationals)
    if d < 0
        n = 0 - n
        d = 0 - d
    // Euclidean loop: emit floor(n/d) at each step
    let done = 0
    while done == 0
        // floor(n/d): for negative n, NOVA truncation != floor; adjust.
        let q = n / d
        if n < 0
            if q * d != n
                q = q - 1
        let rem = n - q * d
        out.push(q)
        if rem == 0
            done = 1
        if done == 0
            n = d
            d = rem
    out

// rfk_from_continued — reconstruct rational from CF coefficients.
// Evaluates from the tail: start with h=last_coeff, k=1;
// for each coeff a going backward: new_h = a*h + k, new_k = h.
// rfk_from_continued([4,2,6,7]) -> [415,93]
// rfk_from_continued([0,2])     -> [1,2]
fn rfk_from_continued(coeffs)
    let n = len(coeffs)
    if n == 0
        let empty = []
        empty.push(0)
        empty.push(1)
        return empty
    let h = coeffs[n - 1]
    let k = 1
    let i = n - 2
    while i >= 0
        let a = coeffs[i]
        let new_h = a * h + k
        let new_k = h
        h = new_h
        k = new_k
        i = i - 1
    _rfk_make(h, k)

// rfk_convergents — compute all convergents of rational r as a list of rationals.
// The k-th convergent p_k/q_k is computed via the standard recurrence:
//   p_{-1}=1, q_{-1}=0, p_0=a_0, q_0=1
//   p_k = a_k * p_{k-1} + p_{k-2}
//   q_k = a_k * q_{k-1} + q_{k-2}
// Each convergent is stored as [p_k, q_k] (unreduced — convergents are already in lowest terms
// by the theory of continued fractions when the input is in lowest terms).
// rfk_convergents([415,93]) -> [[4,1],[9,2],[58,13],[415,93]]
fn rfk_convergents(r)
    let cflist = rfk_continued_fraction(r)
    let nc = len(cflist)
    let out = []
    if nc == 0
        return out
    // Recurrence seed
    let pm2 = 1
    let qm2 = 0
    let pm1 = cflist[0]
    let qm1 = 1
    let c0 = []
    c0.push(pm1)
    c0.push(qm1)
    out.push(c0)
    for i in 1..nc
        let a = cflist[i]
        let p = a * pm1 + pm2
        let q = a * qm1 + qm2
        let ci = []
        ci.push(p)
        ci.push(q)
        out.push(ci)
        pm2 = pm1
        qm2 = qm1
        pm1 = p
        qm1 = q
    out

// rfk_nth_convergent — the n-th convergent of rational r (0-indexed).
// Returns [0,1] if n is out of range.
fn rfk_nth_convergent(r, n)
    let cvs = rfk_convergents(r)
    let nc = len(cvs)
    if n < 0
        let z = []
        z.push(0)
        z.push(1)
        return z
    if n >= nc
        let z = []
        z.push(0)
        z.push(1)
        return z
    cvs[n]
