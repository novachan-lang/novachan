// std/rational/rfrac_format.nova — parsing and formatting of exact rationals [num, den].
// Representation: [num, den] with den > 0, gcd(|num|,den) = 1. Zero = [0,1]. Undefined = [0,0].
// PREFIX: rft_   LEAF — imports nothing.

// _gcd: private — Euclidean gcd on absolute values.
fn _rft_gcd(a, b) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    if a == 0
        return b
    if b == 0
        return a
    let tmp = b
    while tmp != 0
        let r = a - (a / tmp) * tmp
        a = tmp
        tmp = r
    a

// _make: private — build [n, d] in lowest terms with den > 0. Returns [0,0] if d==0.
fn _rft_make(n, d) -> any
    if d == 0
        let r = [0, 0]
        return r
    if n == 0
        let r = [0, 1]
        return r
    if d < 0
        d = 0 - d
        n = 0 - n
    let g = _rft_gcd(n, d)
    if g < 0
        g = 0 - g
    if g == 0
        g = 1
    let rn = n / g
    let rd = d / g
    let r = [rn, rd]
    r

// _parse_int: private — parse decimal integer string to int (handles leading '-').
fn _rft_parse_int(s) -> int
    let neg = 0
    let start = 0
    let n = len(s)
    if n > 0
        let ch0 = slice(s, 0, 1)
        if ch0 == "-"
            neg = 1
            start = 1
    let result = 0
    let i = start
    while i < n
        let ch = slice(s, i, i + 1)
        let digit = 0
        if ch == "0"
            digit = 0
        if ch == "1"
            digit = 1
        if ch == "2"
            digit = 2
        if ch == "3"
            digit = 3
        if ch == "4"
            digit = 4
        if ch == "5"
            digit = 5
        if ch == "6"
            digit = 6
        if ch == "7"
            digit = 7
        if ch == "8"
            digit = 8
        if ch == "9"
            digit = 9
        result = result * 10 + digit
        i = i + 1
    if neg == 1
        result = 0 - result
    result

// _index_of: private — find first occurrence of char c in s starting from pos; returns -1 if not found.
fn _rft_index_of(s, c, pos) -> int
    let n = len(s)
    let i = pos
    while i < n
        let ch = slice(s, i, i + 1)
        if ch == c
            return i
        i = i + 1
    0 - 1

// rft_parse(s) -> rational: accepts 'n/d', '-n/d', 'n', '-n', 'w n/d', '-w n/d' (mixed number).
// Reduces the result. '6/4' -> [3,2]. '1 3/4' -> [7,4].
fn rft_parse(s) -> any
    let n = len(s)
    // Find space (indicates mixed number: "w n/d")
    let sp = _rft_index_of(s, " ", 0)
    if sp >= 0
        // Mixed number form: whole part before space, fraction after
        let whole_s = slice(s, 0, sp)
        let frac_s = slice(s, sp + 1, n)
        let whole = _rft_parse_int(whole_s)
        // Parse the fraction part
        let sl = _rft_index_of(frac_s, "/", 0)
        let fn_len = len(frac_s)
        let fnum = _rft_parse_int(slice(frac_s, 0, sl))
        let fden = _rft_parse_int(slice(frac_s, sl + 1, fn_len))
        // whole + fnum/fden: sign of whole applies to fraction too
        let neg = 0
        if whole < 0
            neg = 1
        let abs_whole = whole
        if abs_whole < 0
            abs_whole = 0 - abs_whole
        let total_num = abs_whole * fden + fnum
        if neg == 1
            total_num = 0 - total_num
        return _rft_make(total_num, fden)
    // Find slash (fraction form: "n/d")
    let sl = _rft_index_of(s, "/", 0)
    if sl >= 0
        let num_s = slice(s, 0, sl)
        let den_s = slice(s, sl + 1, n)
        let num = _rft_parse_int(num_s)
        let den = _rft_parse_int(den_s)
        return _rft_make(num, den)
    // Plain integer
    let num = _rft_parse_int(s)
    _rft_make(num, 1)

// rft_to_string(r) -> 'n/d' or 'n' (if denominator is 1).
fn rft_to_string(r) -> string
    let num = r[0]
    let den = r[1]
    if den == 1
        return str(num)
    let s = str(num) + "/" + str(den)
    s

// rft_to_mixed_string(r) -> mixed number string e.g. '1 3/4' for [7,4]; '3/4' if |num|<den; 'n' if integer.
fn rft_to_mixed_string(r) -> string
    let num = r[0]
    let den = r[1]
    if den == 1
        return str(num)
    let neg = 0
    let abs_num = num
    if abs_num < 0
        neg = 1
        abs_num = 0 - abs_num
    let whole = abs_num / den
    let rem = abs_num - whole * den
    if whole == 0
        return rft_to_string(r)
    let sign_s = ""
    if neg == 1
        sign_s = "-"
    let s = sign_s + str(whole) + " " + str(rem) + "/" + str(den)
    s

// rft_to_ratio(r) -> 'n:d' ratio string.
fn rft_to_ratio(r) -> string
    let s = str(r[0]) + ":" + str(r[1])
    s

// rft_from_ratio(s) -> rational: parse 'n:d' ratio string.
fn rft_from_ratio(s) -> any
    let n = len(s)
    let col = _rft_index_of(s, ":", 0)
    if col < 0
        let num = _rft_parse_int(s)
        return _rft_make(num, 1)
    let num_s = slice(s, 0, col)
    let den_s = slice(s, col + 1, n)
    let num = _rft_parse_int(num_s)
    let den = _rft_parse_int(den_s)
    _rft_make(num, den)

// rft_to_percent(r) -> string: FLOOR integer percent + '%'.
// Floor: q = num*100/den; if num*100 < 0 and q*den != num*100 then q = q-1 (floor toward -inf).
fn rft_to_percent(r) -> string
    let num = r[0]
    let den = r[1]
    let product = num * 100
    let q = product / den
    // Floor correction for negative truncation
    if product < 0
        let check = q * den
        if check != product
            q = q - 1
    let s = str(q) + "%"
    s
