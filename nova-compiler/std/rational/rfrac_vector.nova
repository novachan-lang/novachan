// std/rational/rfrac_vector.nova — exact vector operations on lists of rationals [num, den].
// Representation: [num, den] with den > 0, gcd(|num|,den) = 1. Zero = [0,1]. Undefined = [0,0].
// PREFIX: rfvec_   LEAF — imports nothing.

// _gcd: private — Euclidean gcd on absolute values.
fn _rfvec_gcd(a, b) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    if a == 0
        return b
    if b == 0
        return a
    let tmp = b
    while tmp != 0
        let r = a - (a / tmp) * tmp
        a = tmp
        tmp = r
    a

// _make: private — build [n, d] in lowest terms with den > 0. Returns [0,0] if d==0.
fn _rfvec_make(n, d) -> any
    if d == 0
        let r = [0, 0]
        return r
    if n == 0
        let r = [0, 1]
        return r
    if d < 0
        d = 0 - d
        n = 0 - n
    let g = _rfvec_gcd(n, d)
    if g < 0
        g = 0 - g
    if g == 0
        g = 1
    let rn = n / g
    let rd = d / g
    let r = [rn, rd]
    r

// _add: private — add two rationals.
fn _rfvec_add(a, b) -> any
    let an = a[0]
    let ad = a[1]
    let bn = b[0]
    let bd = b[1]
    let n = an * bd + bn * ad
    let d = ad * bd
    _rfvec_make(n, d)

// _mul: private — multiply two rationals.
fn _rfvec_mul(a, b) -> any
    let n = a[0] * b[0]
    let d = a[1] * b[1]
    _rfvec_make(n, d)

// rfvec_sum(list) -> rational: exact sum of a list of rationals.
fn rfvec_sum(xs) -> any
    let acc = [0, 1]
    let i = 0
    let n = len(xs)
    while i < n
        acc = _rfvec_add(acc, xs[i])
        i = i + 1
    acc

// rfvec_mean(list) -> rational: exact arithmetic mean (sum / count).
fn rfvec_mean(xs) -> any
    let n = len(xs)
    if n == 0
        let r = [0, 0]
        return r
    let s = rfvec_sum(xs)
    let sn = s[0]
    let sd = s[1]
    // divide by n: multiply denominator by n
    let rn = sn
    let rd = sd * n
    _rfvec_make(rn, rd)

// rfvec_dot(a, b) -> rational: exact dot product of two equal-length vectors of rationals.
fn rfvec_dot(a, b) -> any
    let n = len(a)
    let acc = [0, 1]
    let i = 0
    while i < n
        let prod = _rfvec_mul(a[i], b[i])
        acc = _rfvec_add(acc, prod)
        i = i + 1
    acc

// rfvec_scale(list, r) -> list of rationals: multiply each element by rational r.
fn rfvec_scale(xs, r) -> any
    let result = []
    let i = 0
    let n = len(xs)
    while i < n
        let v = _rfvec_mul(xs[i], r)
        push(result, v)
        i = i + 1
    result

// rfvec_weighted_mean(vals, weights) -> rational: sum(v_i * w_i) / sum(w_i).
fn rfvec_weighted_mean(vals, weights) -> any
    let n = len(vals)
    if n == 0
        let r = [0, 0]
        return r
    let num_acc = [0, 1]
    let den_acc = [0, 1]
    let i = 0
    while i < n
        let prod = _rfvec_mul(vals[i], weights[i])
        num_acc = _rfvec_add(num_acc, prod)
        den_acc = _rfvec_add(den_acc, weights[i])
        i = i + 1
    // result = num_acc / den_acc = (num_acc[0]/num_acc[1]) / (den_acc[0]/den_acc[1])
    //        = num_acc[0] * den_acc[1] / (num_acc[1] * den_acc[0])
    let rn = num_acc[0] * den_acc[1]
    let rd = num_acc[1] * den_acc[0]
    _rfvec_make(rn, rd)
