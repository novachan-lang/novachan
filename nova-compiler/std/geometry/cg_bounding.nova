// std/geometry/cg_bounding.nova — Axis-aligned bounding box for 2D integer points.
//
// Points are 2-element integer lists [x, y].  ALL arithmetic is EXACT INTEGER.
// No floats — center is returned doubled (2*cx, 2*cy) to stay integer.
//
// Public API:
//   cgb_bbox(points)       -> list  [xmin, ymin, xmax, ymax]
//   cgb_bbox_area(points)  -> int   (xmax-xmin)*(ymax-ymin)
//   cgb_width(points)      -> int   xmax - xmin
//   cgb_height(points)     -> int   ymax - ymin
//   cgb_center_2x(points)  -> list  [2*cx, 2*cy] (integer doubled center)
//
// Degenerate: single point returns bbox=[x,y,x,y], area=0, width=0, height=0,
//             center_2x=[2*x, 2*y].
// Empty list returns [0,0,0,0] for bbox and 0 for area/width/height.
//
// Private helpers prefixed _cgb_ to avoid collisions.
// LEAF — imports NOTHING.

// cgb_bbox: axis-aligned bounding box [xmin, ymin, xmax, ymax] of a point set.
fn cgb_bbox(points: list) -> list
    let n = len(points)
    if n == 0
        let r = [0, 0, 0, 0]
        return r
    let xmin = points[0][0]
    let ymin = points[0][1]
    let xmax = points[0][0]
    let ymax = points[0][1]
    let i = 1
    while i < n
        let x = points[i][0]
        let y = points[i][1]
        if x < xmin
            xmin = x
        if x > xmax
            xmax = x
        if y < ymin
            ymin = y
        if y > ymax
            ymax = y
        i = i + 1
    let r = [xmin, ymin, xmax, ymax]
    r

// cgb_bbox_area: (xmax-xmin)*(ymax-ymin) — exact integer area of the bounding box.
fn cgb_bbox_area(points: list) -> int
    let bb = cgb_bbox(points)
    let w = bb[2] - bb[0]
    let h = bb[3] - bb[1]
    let r = w * h
    r

// cgb_width: xmax - xmin of the bounding box.
fn cgb_width(points: list) -> int
    let bb = cgb_bbox(points)
    let r = bb[2] - bb[0]
    r

// cgb_height: ymax - ymin of the bounding box.
fn cgb_height(points: list) -> int
    let bb = cgb_bbox(points)
    let r = bb[3] - bb[1]
    r

// cgb_center_2x: [2*cx, 2*cy] — center of the bounding box, doubled to stay integer.
// 2*cx = xmin + xmax,  2*cy = ymin + ymax.
fn cgb_center_2x(points: list) -> list
    let bb = cgb_bbox(points)
    let cx2 = bb[0] + bb[2]
    let cy2 = bb[1] + bb[3]
    let r = [cx2, cy2]
    r
