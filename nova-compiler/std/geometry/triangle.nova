// std/geometry/triangle.nova — Triangle geometry (exact integer + float where required).
//
// All three vertices are [x, y] two-element lists of integers.
// Exact integer arithmetic is used for area (shoelace), side comparisons, and predicates.
// Floats appear only for true lengths and area in float form; every sub-expression is
// bound to a named `let` to avoid the uninit-float-slot compiler bug.
//
// Private helpers use the _tr_ prefix (unique to this module).
//
// Public API:
//   tr_area2(a, b, c)       -> int   2x signed area (absolute value); 0 iff degenerate
//   tr_area(a, b, c)        -> float true area = tr_area2/2
//   tr_perimeter(a, b, c)   -> float sum of the three side lengths
//   tr_centroid(a, b, c)    -> list  [cx, cy] float centroid = simple vertex average
//   tr_is_right(a, b, c)    -> bool  Pythagorean check on squared sides (any vertex)
//   tr_is_equilateral(a, b, c) -> bool  all three squared sides equal
//   tr_is_degenerate(a, b, c)  -> bool  collinear; tr_area2 == 0

// _tr_distsq — squared Euclidean distance between two [x,y] int points.
fn _tr_distsq(p: list, q: list) -> int
    let px = p[0]
    let py = p[1]
    let qx = q[0]
    let qy = q[1]
    let dx = qx - px
    let dy = qy - py
    let dsq = dx * dx + dy * dy
    dsq

// _tr_dist — Euclidean distance between two [x,y] int points (float).
// Binds sqrt result to a let to avoid uninit-float-slot bug.
fn _tr_dist(p: list, q: list) -> float
    let dsq = _tr_distsq(p, q)
    let dsqf = dsq * 1.0
    let d = sqrt(dsqf)
    d

// _tr_iabs — absolute value of an integer.
fn _tr_iabs(x: int) -> int
    -x if x < 0 else x

// tr_area2 — 2x the area of triangle ABC (exact integer, always non-negative).
// Computed via the cross product of (B-A) and (C-A):
//   cross = (bx-ax)*(cy-ay) - (by-ay)*(cx-ax)
// Returns |cross|, so the result is always >= 0.
fn tr_area2(a: list, b: list, c: list) -> int
    let ax = a[0]
    let ay = a[1]
    let bx = b[0]
    let by = b[1]
    let cx = c[0]
    let cy = c[1]
    let cross = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)
    let result = _tr_iabs(cross)
    result

// tr_area — true area of triangle ABC as a float.
// = tr_area2 / 2.0
fn tr_area(a: list, b: list, c: list) -> float
    let a2 = tr_area2(a, b, c)
    let a2f = a2 * 1.0
    let area = a2f / 2.0
    area

// tr_perimeter — sum of the three side lengths (float).
// Sides: AB, BC, CA.  Each length is computed via sqrt of squared distance.
// All intermediate float results are bound to named lets (uninit-slot safety).
fn tr_perimeter(a: list, b: list, c: list) -> float
    let lab = _tr_dist(a, b)
    let lbc = _tr_dist(b, c)
    let lca = _tr_dist(c, a)
    let perim = lab + lbc + lca
    perim

// tr_centroid — [cx, cy] float centroid of triangle ABC.
// For a triangle the centroid is simply the average of the three vertices:
//   cx = (ax + bx + cx) / 3.0,  cy = (ay + by + cy) / 3.0
fn tr_centroid(a: list, b: list, c: list) -> list
    let ax = a[0]
    let ay = a[1]
    let bx = b[0]
    let by = b[1]
    let cx = c[0]
    let cy = c[1]
    let sx = ax + bx + cx
    let sy = ay + by + cy
    let sxf = sx * 1.0
    let syf = sy * 1.0
    let centx = sxf / 3.0
    let centy = syf / 3.0
    let result = []
    push(result, centx)
    push(result, centy)
    result

// tr_is_right — true iff the triangle has a right angle (at any vertex).
// Uses exact integer squared side lengths and the Pythagorean theorem:
//   a right triangle satisfies max_side² = sum of the other two squared sides.
fn tr_is_right(a: list, b: list, c: list) -> bool
    let ab2 = _tr_distsq(a, b)
    let bc2 = _tr_distsq(b, c)
    let ca2 = _tr_distsq(c, a)
    // Find the maximum squared side.
    let mx = ab2
    if bc2 > mx
        mx = bc2
    if ca2 > mx
        mx = ca2
    // Check if max = sum of the other two.
    let right = false
    if mx == ab2 and bc2 + ca2 == mx
        right = true
    if mx == bc2 and ab2 + ca2 == mx
        right = true
    if mx == ca2 and ab2 + bc2 == mx
        right = true
    right

// tr_is_equilateral — true iff all three squared side lengths are equal.
fn tr_is_equilateral(a: list, b: list, c: list) -> bool
    let ab2 = _tr_distsq(a, b)
    let bc2 = _tr_distsq(b, c)
    let ca2 = _tr_distsq(c, a)
    ab2 == bc2 and bc2 == ca2

// tr_is_degenerate — true iff the three points are collinear (zero area).
fn tr_is_degenerate(a: list, b: list, c: list) -> bool
    let a2 = tr_area2(a, b, c)
    a2 == 0
