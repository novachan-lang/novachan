// std/geometry/bbox.nova
// Axis-aligned bounding boxes.  Box representation: dict with string keys
// "minx", "miny", "maxx", "maxy" (all integers).
// Exact integer arithmetic throughout except bb_center (returns [float,float]).
// Private helpers prefixed _bbx_ to avoid symbol collisions.

// _bbx_min: integer minimum of two values
fn _bbx_min(a: int, b: int) -> int
    if b < a
        return b
    return a

// _bbx_max: integer maximum of two values
fn _bbx_max(a: int, b: int) -> int
    if b > a
        return b
    return a

// bb_from_points: build the tightest AABB enclosing all points (list of [x,y]).
// Requires at least one point.
fn bb_from_points(points: list) -> dict
    let p0 = points[0]
    let mnx = p0[0]
    let mny = p0[1]
    let mxx = p0[0]
    let mxy = p0[1]
    let n = len(points)
    let i = 1
    while i < n
        let pt = points[i]
        let px = pt[0]
        let py = pt[1]
        mnx = _bbx_min(mnx, px)
        mny = _bbx_min(mny, py)
        mxx = _bbx_max(mxx, px)
        mxy = _bbx_max(mxy, py)
        i = i + 1
    let box = {}
    box["minx"] = mnx
    box["miny"] = mny
    box["maxx"] = mxx
    box["maxy"] = mxy
    return box

// bb_contains: true if point (px,py) is inside or on the boundary of box.
fn bb_contains(box: dict, px: int, py: int) -> bool
    let mnx = box["minx"]
    let mny = box["miny"]
    let mxx = box["maxx"]
    let mxy = box["maxy"]
    if px < mnx
        return false
    if px > mxx
        return false
    if py < mny
        return false
    if py > mxy
        return false
    return true

// bb_intersects: true if two boxes overlap (touching edges count).
fn bb_intersects(b1: dict, b2: dict) -> bool
    let mnx1 = b1["minx"]
    let mny1 = b1["miny"]
    let mxx1 = b1["maxx"]
    let mxy1 = b1["maxy"]
    let mnx2 = b2["minx"]
    let mny2 = b2["miny"]
    let mxx2 = b2["maxx"]
    let mxy2 = b2["maxy"]
    if mxx1 < mnx2
        return false
    if mxx2 < mnx1
        return false
    if mxy1 < mny2
        return false
    if mxy2 < mny1
        return false
    return true

// bb_union: smallest AABB that contains both b1 and b2.
fn bb_union(b1: dict, b2: dict) -> dict
    let mnx1 = b1["minx"]
    let mny1 = b1["miny"]
    let mxx1 = b1["maxx"]
    let mxy1 = b1["maxy"]
    let mnx2 = b2["minx"]
    let mny2 = b2["miny"]
    let mxx2 = b2["maxx"]
    let mxy2 = b2["maxy"]
    let umnx = _bbx_min(mnx1, mnx2)
    let umny = _bbx_min(mny1, mny2)
    let umxx = _bbx_max(mxx1, mxx2)
    let umxy = _bbx_max(mxy1, mxy2)
    let box = {}
    box["minx"] = umnx
    box["miny"] = umny
    box["maxx"] = umxx
    box["maxy"] = umxy
    return box

// bb_area: integer area (width * height).
fn bb_area(box: dict) -> int
    let w = box["maxx"] - box["minx"]
    let h = box["maxy"] - box["miny"]
    let a = w * h
    return a

// bb_width: integer width (maxx - minx).
fn bb_width(box: dict) -> int
    let w = box["maxx"] - box["minx"]
    return w

// bb_height: integer height (maxy - miny).
fn bb_height(box: dict) -> int
    let h = box["maxy"] - box["miny"]
    return h

// bb_center: [cx, cy] float centroid of the box.
fn bb_center(box: dict) -> list
    let mnxf = box["minx"] * 1.0
    let mnyf = box["miny"] * 1.0
    let mxxf = box["maxx"] * 1.0
    let mxyf = box["maxy"] * 1.0
    let cx = (mnxf + mxxf) / 2.0
    let cy = (mnyf + mxyf) / 2.0
    let result = [cx, cy]
    return result
