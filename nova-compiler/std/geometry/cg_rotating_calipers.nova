// std/geometry/cg_rotating_calipers.nova — Rotating-calipers style extremal pair queries.
//
// Points are 2-element integer lists [x, y].  ALL arithmetic is EXACT INTEGER.
// No floats, no sqrt — all results are squared distances or index pairs.
//
// Public API:
//   cgr_diameter_sq(poly)     -> int     Maximum squared distance between any two vertices.
//   cgr_farthest_pair(poly)   -> list    [i, j] indices of a farthest pair (i < j).
//   cgr_closest_pair_sq(poly) -> int     Minimum squared distance between any two DISTINCT vertices.
//
// Implementation uses O(n^2) brute-force over the vertex list.
// Degenerate inputs: 0 or 1 vertex -> diameter_sq=0, farthest_pair=[0,0], closest_pair_sq=0.
//
// Private helpers prefixed _cgr_ to avoid collisions.
// LEAF — imports NOTHING.

// _cgr_sq_dist: squared Euclidean distance between two [x,y] points (exact integer).
fn _cgr_sq_dist(p: list, q: list) -> int
    let dx = p[0] - q[0]
    let dy = p[1] - q[1]
    let r = dx * dx + dy * dy
    r

// cgr_diameter_sq: maximum squared distance between any two vertices of poly.
// Returns 0 for 0 or 1 vertices.
fn cgr_diameter_sq(poly: list) -> int
    let n = len(poly)
    if n < 2
        return 0
    let best = 0
    let i = 0
    while i < n
        let j = i + 1
        while j < n
            let d = _cgr_sq_dist(poly[i], poly[j])
            if d > best
                best = d
            j += 1
        i += 1
    best

// cgr_farthest_pair: returns [i, j] (i < j) indices of a farthest vertex pair.
// Returns [0, 0] for 0 or 1 vertices.
fn cgr_farthest_pair(poly: list) -> list
    let n = len(poly)
    if n < 2
        let r = [0, 0]
        return r
    let best = 0
    let bi = 0
    let bj = 1
    for i in 0..n
        let j = i + 1
        while j < n
            let d = _cgr_sq_dist(poly[i], poly[j])
            if d > best
                best = d
                bi = i
                bj = j
            j += 1
    let r = [bi, bj]
    r

// cgr_closest_pair_sq: minimum squared distance between any two DISTINCT vertices.
// Returns 0 for 0 or 1 vertices.
fn cgr_closest_pair_sq(poly: list) -> int
    let n = len(poly)
    if n < 2
        return 0
    let best = -1
    for i in 0..n
        let j = i + 1
        while j < n
            let d = _cgr_sq_dist(poly[i], poly[j])
            if best < 0
                best = d
            else
                if d < best
                    best = d
            j += 1
    best
