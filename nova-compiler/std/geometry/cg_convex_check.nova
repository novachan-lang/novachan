// std/geometry/cg_convex_check.nova — Convexity check for simple polygons (exact integer).
//
// A polygon is a list of [x, y] integer points, no repeated closing vertex.
// All arithmetic is EXACT INTEGER — no floats, no rounding.
//
// cgv_is_convex:     true iff the polygon is convex (all turns same sign or zero).
// cgv_is_ccw_convex: true iff the polygon is convex AND wound counter-clockwise.
//
// Edge cases:
//   < 3 vertices -> always convex (degenerate: point / segment).
//   All collinear -> is_convex=true (degenerate "flat" polygon).
//   < 3 vertices -> is_ccw_convex=false (no meaningful CCW winding).
//
// Algorithm: for each consecutive triple of vertices compute the cross product of
// the two edge vectors.  Convex iff all non-zero cross products have the same sign.
// CCW additionally requires the dominant sign to be positive.
// LEAF — imports NOTHING.

// _cgvx_cross: cross product of consecutive edges (p[i]->p[j]) and (p[j]->p[k]).
// Returns (bx-ax)*(cy-ay) - (by-ay)*(cx-ax) where a=p[i], b=p[j], c=p[k].
fn _cgvx_cross(a: list, b: list, c: list) -> int
    let ax = b[0] - a[0]
    let ay = b[1] - a[1]
    let bx = c[0] - b[0]
    let by = c[1] - b[1]
    let r = ax * by - ay * bx
    r

// cgv_is_convex: true iff the polygon is convex.
// A simple polygon is convex iff every consecutive triple of vertices produces a
// cross product whose sign is consistent (positive, negative, or zero).
// Collinear edges (cross = 0) are allowed — they do not break convexity.
// Returns true for degenerate polygons with fewer than 3 vertices.
fn cgv_is_convex(poly: list) -> bool
    let n = len(poly)
    if n < 3
        return true
    let i = 0
    let first_sign = 0
    let convex = true
    while i < n
        let j = i + 1
        if j >= n
            j = 0
        let k = j + 1
        if k >= n
            k = 0
        let cross = _cgvx_cross(poly[i], poly[j], poly[k])
        if cross != 0
            if first_sign == 0
                if cross > 0
                    first_sign = 1
                if cross < 0
                    first_sign = -1
            else
                if first_sign == 1 and cross < 0
                    convex = false
                if first_sign == -1 and cross > 0
                    convex = false
        i += 1
    convex

// cgv_is_ccw_convex: true iff the polygon is convex AND counter-clockwise.
// Requires: all cross products >= 0 (no CW turn), and at least one > 0 (not fully
// degenerate / fewer than 3 distinct non-collinear vertices).
// Returns false for degenerate polygons with fewer than 3 vertices.
fn cgv_is_ccw_convex(poly: list) -> bool
    let n = len(poly)
    if n < 3
        return false
    let i = 0
    let has_positive = false
    let all_nonneg = true
    while i < n
        let j = i + 1
        if j >= n
            j = 0
        let k = j + 1
        if k >= n
            k = 0
        let cross = _cgvx_cross(poly[i], poly[j], poly[k])
        if cross < 0
            all_nonneg = false
        if cross > 0
            has_positive = true
        i += 1
    all_nonneg and has_positive
