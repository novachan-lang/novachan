// std/geometry/segment.nova — Line-segment predicates (exact integer arithmetic).
//
// All orientation and intersection tests use exact integer cross products.
// No floats are used; results are deterministic and fragility-free.
//
// CONVENTIONS:
//   Points are [x, y] two-element int lists.
//   Private helpers are prefixed `sg_` (unique per-module tag).
//
// API:
//   sg_orientation(ax,ay,bx,by,cx,cy) -> int
//       0 = collinear, 1 = clockwise, 2 = counter-clockwise
//       via cross product sign of (B-A) x (C-A)
//
//   sg_on_segment(px,py,qx,qy,rx,ry) -> bool
//       true iff q lies on segment p-r (assumes q is collinear with p-r)
//
//   sg_intersect(p1, p2, p3, p4) -> bool
//       true iff segment p1-p2 and segment p3-p4 intersect
//       (including collinear overlap and endpoint touching)

// sg_orientation — orientation of the ordered triple A, B, C.
// Cross product of (B-A) x (C-A):
//   cross = (bx-ax)*(cy-ay) - (by-ay)*(cx-ax)
// Returns 0 (collinear), 1 (clockwise), 2 (counter-clockwise).
fn sg_orientation(ax: int, ay: int, bx: int, by: int, cx: int, cy: int) -> int
    let dbx = bx - ax
    let dby = by - ay
    let dcx = cx - ax
    let dcy = cy - ay
    let cross = dbx * dcy - dby * dcx
    let result = 0
    if cross > 0
        result = 2
    else
        if cross < 0
            result = 1
    result

// sg_on_segment — is q on segment p-r? (assumes p, q, r are collinear)
// q lies on p-r iff qx is in [min(px,rx), max(px,rx)] and qy in [min(py,ry), max(py,ry)].
fn sg_on_segment(px: int, py: int, qx: int, qy: int, rx: int, ry: int) -> bool
    let min_x = px
    if rx < px
        min_x = rx
    let max_x = px
    if rx > px
        max_x = rx
    let min_y = py
    if ry < py
        min_y = ry
    let max_y = py
    if ry > py
        max_y = ry
    let x_ok = false
    if qx >= min_x
        if qx <= max_x
            x_ok = true
    let y_ok = false
    if qy >= min_y
        if qy <= max_y
            y_ok = true
    let result = false
    if x_ok
        if y_ok
            result = true
    result

// sg_intersect — do segments p1-p2 and p3-p4 intersect?
// Uses the four-orientation algorithm. Points are [x,y] lists.
// Handles proper crossings, endpoint-touching, and collinear overlap.
fn sg_intersect(p1: list, p2: list, p3: list, p4: list) -> bool
    let ax = p1[0]
    let ay = p1[1]
    let bx = p2[0]
    let by = p2[1]
    let cx = p3[0]
    let cy = p3[1]
    let dx = p4[0]
    let dy = p4[1]
    // d1 = orientation(p1, p2, p3)
    let d1 = sg_orientation(ax, ay, bx, by, cx, cy)
    // d2 = orientation(p1, p2, p4)
    let d2 = sg_orientation(ax, ay, bx, by, dx, dy)
    // d3 = orientation(p3, p4, p1)
    let d3 = sg_orientation(cx, cy, dx, dy, ax, ay)
    // d4 = orientation(p3, p4, p2)
    let d4 = sg_orientation(cx, cy, dx, dy, bx, by)
    // Proper crossing: d1 and d2 on opposite sides, d3 and d4 on opposite sides.
    // "opposite sides" means one is 1 and the other is 2 (both nonzero with different signs).
    let proper = false
    if d1 != d2
        if d1 != 0
            if d2 != 0
                if d3 != d4
                    if d3 != 0
                        if d4 != 0
                            proper = true
    let result = false
    if proper
        result = true
    else
        // Collinear cases: check if the collinear endpoint lies on the other segment.
        if d1 == 0
            let on1 = sg_on_segment(ax, ay, cx, cy, bx, by)
            if on1
                result = true
        if d2 == 0
            let on2 = sg_on_segment(ax, ay, dx, dy, bx, by)
            if on2
                result = true
        if d3 == 0
            let on3 = sg_on_segment(cx, cy, ax, ay, dx, dy)
            if on3
                result = true
        if d4 == 0
            let on4 = sg_on_segment(cx, cy, bx, by, dx, dy)
            if on4
                result = true
    result
