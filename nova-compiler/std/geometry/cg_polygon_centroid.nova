// std/geometry/cg_polygon_centroid.nova — Exact rational centroid of a polygon.
//
// A polygon is a list of [x,y] integer-coordinate vertices in order (no repeated closing vertex).
// All arithmetic is exact integer; the centroid is returned as an exact rational [num, den]
// reduced by gcd with den > 0.
//
// Centroid formula (weighted shoelace):
//   Let A2 = signed 2*area (shoelace sum), cross_i = xi*yj - xj*yi
//   cx = sum_i((xi+xj)*cross_i) / (3 * A2)
//   cy = sum_i((yi+yj)*cross_i) / (3 * A2)
//
// Public API (prefix cgc_):
//   cgc_centroid(poly)   -> [cx_num, cy_num, den]  exact centroid, gcd-reduced, den>0
//   cgc_centroid_x(poly) -> [num, den]              x coordinate only
//   cgc_centroid_y(poly) -> [num, den]              y coordinate only
//
// Degenerate case (area=0 / collinear): den=0 in the raw formula; returned as [0,0,0].
// LEAF — imports nothing.

// _cgc_gcd — Euclidean gcd of two non-negative integers; gcd(0,0)=0.
fn _cgc_gcd(a: int, b: int) -> int
    let x = 0
    if a < 0
        x = 0 - a
    else
        x = a
    let y = 0
    if b < 0
        y = 0 - b
    else
        y = b
    let r = 0
    while y != 0
        r = x - (x / y) * y
        x = y
        y = r
    x

// _cgc_iabs — absolute value of an integer.
fn _cgc_iabs(x: int) -> int
    let r = 0
    if x < 0
        r = 0 - x
    else
        r = x
    r

// _cgc_area2 — signed shoelace 2*area of poly (exact integer).
fn _cgc_area2(poly: list) -> int
    let n = len(poly)
    let s = 0
    for i in 0..n
        let j = i + 1
        if j >= n
            j = 0
        let xi = poly[i][0]
        let yi = poly[i][1]
        let xj = poly[j][0]
        let yj = poly[j][1]
        s = s + (xi * yj - xj * yi)
    s

// cgc_centroid — [cx_num, cy_num, den] exact centroid reduced by gcd, den>0.
// Returns [0,0,0] for degenerate (collinear) polygons.
fn cgc_centroid(poly: list) -> list
    let n = len(poly)
    let a2 = _cgc_area2(poly)
    let result = []
    if a2 == 0
        push(result, 0)
        push(result, 0)
        push(result, 0)
        result
    else
        let cx_num = 0
        let cy_num = 0
        for i in 0..n
            let j = i + 1
            if j >= n
                j = 0
            let xi = poly[i][0]
            let yi = poly[i][1]
            let xj = poly[j][0]
            let yj = poly[j][1]
            let cross = xi * yj - xj * yi
            cx_num = cx_num + (xi + xj) * cross
            cy_num = cy_num + (yi + yj) * cross
        // denominator = 3 * a2; may be negative if CW winding
        let raw_den = 3 * a2
        // Normalise so den > 0: if raw_den < 0, negate both numerators and denominator
        let nx = cx_num
        let ny = cy_num
        let nd = raw_den
        if nd < 0
            nx = 0 - nx
            ny = 0 - ny
            nd = 0 - nd
        // Reduce all three by gcd of absolute values
        let gx = _cgc_gcd(_cgc_iabs(nx), _cgc_iabs(ny))
        let g = _cgc_gcd(gx, nd)
        if g == 0
            g = 1
        let rx = nx / g
        let ry = ny / g
        let rd = nd / g
        push(result, rx)
        push(result, ry)
        push(result, rd)
        result

// cgc_centroid_x — [num, den] exact x-coordinate of centroid, gcd-reduced, den>0.
// Returns [0,0] for degenerate polygons.
fn cgc_centroid_x(poly: list) -> list
    let full = cgc_centroid(poly)
    let result = []
    let fd = full[2]
    if fd == 0
        push(result, 0)
        push(result, 0)
        result
    else
        let nx = full[0]
        let nd = full[2]
        // Already reduced in cgc_centroid; re-reduce x/den pair in case cy_num shared a factor
        let g = _cgc_gcd(_cgc_iabs(nx), nd)
        if g == 0
            g = 1
        push(result, nx / g)
        push(result, nd / g)
        result

// cgc_centroid_y — [num, den] exact y-coordinate of centroid, gcd-reduced, den>0.
// Returns [0,0] for degenerate polygons.
fn cgc_centroid_y(poly: list) -> list
    let full = cgc_centroid(poly)
    let result = []
    let fd = full[2]
    if fd == 0
        push(result, 0)
        push(result, 0)
        result
    else
        let ny = full[1]
        let nd = full[2]
        let g = _cgc_gcd(_cgc_iabs(ny), nd)
        if g == 0
            g = 1
        push(result, ny / g)
        push(result, nd / g)
        result
