// std/geometry/cg_orientation.nova — Point orientation and cross product (exact integer).
//
// A point is a 2-element integer list [x, y].
// All arithmetic is EXACT INTEGER — no floats, no rounding.
// Degenerate inputs (collinear points, identical points) are handled correctly.
// LEAF — imports NOTHING.

// cgo_cross: integer cross product of vectors OA and OB.
// Returns (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0]).
// Positive = CCW turn, zero = collinear, negative = CW turn.
fn cgo_cross(o: list, a: list, b: list) -> int
    let ax = a[0] - o[0]
    let ay = a[1] - o[1]
    let bx = b[0] - o[0]
    let by = b[1] - o[1]
    let r = ax * by - ay * bx
    r

// cgo_orient: orientation of the ordered triple (a, b, c).
// Returns 1 if the turn a->b->c is counter-clockwise (left turn),
//        -1 if it is clockwise (right turn),
//         0 if the three points are collinear.
fn cgo_orient(a: list, b: list, c: list) -> int
    let cross = cgo_cross(a, b, c)
    if cross > 0
        return 1
    if cross < 0
        return -1
    0

// cgo_collinear: true iff points a, b, c are collinear.
fn cgo_collinear(a: list, b: list, c: list) -> bool
    let cross = cgo_cross(a, b, c)
    cross == 0

// cgo_left: true iff point c is strictly to the LEFT of the directed line a->b.
// Equivalent to a CCW orientation (cgo_orient == 1).
fn cgo_left(a: list, b: list, c: list) -> bool
    let cross = cgo_cross(a, b, c)
    cross > 0
