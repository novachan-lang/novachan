// std/geometry/cg_triangulate.nova — Ear-clipping triangulation of a simple polygon.
//
// Input: a simple polygon as a list of [x,y] integer points (CCW or CW winding,
// no repeated closing vertex). The algorithm handles both windings by detecting
// the signed area.
//
// All arithmetic is exact integer — no floats, no sqrt.
// Private helpers use prefix _cgt_ (unique to this module).
//
// Public API (prefix cgt_):
//   cgt_triangulate(poly)     -> list of [i,j,k] vertex-index triples, exactly n-2 entries
//   cgt_count(poly)           -> int  number of triangles = n-2  (0 for n<3)
//   cgt_total_area_2x(poly)   -> int  sum of 2*area of all triangles = polygon 2*area (abs)
//
// LEAF — imports nothing.

// _cgt_cross2: signed 2x area of triangle (ax,ay)-(bx,by)-(cx,cy).
// Returns (bx-ax)*(cy-ay) - (by-ay)*(cx-ax).
fn _cgt_cross2(ax: int, ay: int, bx: int, by: int, cx: int, cy: int) -> int
    let dbx = bx - ax
    let dby = by - ay
    let dcx = cx - ax
    let dcy = cy - ay
    let cross = dbx * dcy - dby * dcx
    cross

// _cgt_iabs: absolute value of an integer.
fn _cgt_iabs(x: int) -> int
    let r = x
    if x < 0
        r = 0 - x
    r

// _cgt_imin2: integer minimum.
fn _cgt_imin2(a: int, b: int) -> int
    let r = a
    if b < a
        r = b
    r

// _cgt_imax2: integer maximum.
fn _cgt_imax2(a: int, b: int) -> int
    let r = a
    if b > a
        r = b
    r

// _cgt_poly_area2: signed 2x shoelace area of a polygon (list of [x,y] points).
// Positive = CCW, negative = CW.
fn _cgt_poly_area2(pts: list) -> int
    let n = len(pts)
    let i = 0
    let s = 0
    while i < n
        let j = i + 1
        if j >= n
            j = 0
        let xi = pts[i][0]
        let yi = pts[i][1]
        let xj = pts[j][0]
        let yj = pts[j][1]
        s = s + xi * yj - xj * yi
        i = i + 1
    s

// _cgt_pt_in_triangle_strict: true iff point P=(px,py) is STRICTLY inside triangle
// A=(ax,ay)-B=(bx,by)-C=(cx,cy). "Strictly" means not on the boundary.
// Uses the sign of barycentric coordinates via cross products.
// All three cross products must have the same (nonzero) sign for a strict interior point.
fn _cgt_pt_in_triangle_strict(px: int, py: int, ax: int, ay: int, bx: int, by: int, cx: int, cy: int) -> bool
    let d0 = _cgt_cross2(ax, ay, bx, by, px, py)
    let d1 = _cgt_cross2(bx, by, cx, cy, px, py)
    let d2 = _cgt_cross2(cx, cy, ax, ay, px, py)
    // All same sign and none zero means strictly inside.
    let all_pos = false
    if d0 > 0 and d1 > 0 and d2 > 0
        all_pos = true
    let all_neg = false
    if d0 < 0 and d1 < 0 and d2 < 0
        all_neg = true
    let result = false
    if all_pos
        result = true
    if all_neg
        result = true
    result

// _cgt_is_ear: true if vertex at working-list position pos is an ear.
// winding: +1 for CCW polygon, -1 for CW polygon.
// The ear is valid if:
//   1. The triangle (prev, curr, next) has cross product sign == winding sign (not reflex/collinear).
//   2. No other polygon vertex (from the working list) lies strictly inside the triangle.
// idxs: current working list of original vertex indices (into poly).
// poly: the original polygon.
fn _cgt_is_ear(idxs: list, pos: int, poly: list, winding: int) -> bool
    let m = len(idxs)
    let prev_pos = pos - 1
    if prev_pos < 0
        prev_pos = m - 1
    let next_pos = pos + 1
    if next_pos >= m
        next_pos = 0
    let ai = idxs[prev_pos]
    let bi = idxs[pos]
    let ci = idxs[next_pos]
    let ax = poly[ai][0]
    let ay = poly[ai][1]
    let bx = poly[bi][0]
    let by = poly[bi][1]
    let cx = poly[ci][0]
    let cy = poly[ci][1]
    let cross = _cgt_cross2(ax, ay, bx, by, cx, cy)
    // Cross must have same sign as winding (a convex ear).
    let sign_ok = false
    if winding > 0 and cross > 0
        sign_ok = true
    if winding < 0 and cross < 0
        sign_ok = true
    let ear = false
    if sign_ok
        // Check no other working vertex is strictly inside the ear triangle.
        let k = 0
        let has_inside = false
        while k < m and not has_inside
            if k != prev_pos and k != pos and k != next_pos
                let vi = idxs[k]
                let vx = poly[vi][0]
                let vy = poly[vi][1]
                let inside = _cgt_pt_in_triangle_strict(vx, vy, ax, ay, bx, by, cx, cy)
                if inside
                    has_inside = true
            k = k + 1
        if not has_inside
            ear = true
    ear

// _cgt_remove: remove the element at position pos from a list, returning new list.
// In NOVA, lists are mutable; we build a fresh list without the element.
fn _cgt_remove(xs: list, pos: int) -> list
    let m = len(xs)
    let result = []
    let k = 0
    while k < m
        if k != pos
            push(result, xs[k])
        k = k + 1
    result

// cgt_count: number of triangles in the triangulation = n-2 (0 for n<3).
fn cgt_count(poly: list) -> int
    let n = len(poly)
    let result = 0
    if n >= 3
        result = n - 2
    result

// cgt_triangulate: ear-clipping triangulation of a simple polygon.
// Returns a list of [i,j,k] vertex-index triples (into the original poly list).
// Exactly n-2 triangles for an n-gon. Empty list for n < 3.
// Winding direction is auto-detected from the shoelace area.
fn cgt_triangulate(poly: list) -> list
    let n = len(poly)
    let tris = []
    if n < 3
        tris
    else
        // Detect winding from signed area.
        let area2 = _cgt_poly_area2(poly)
        let winding = 1
        if area2 < 0
            winding = -1
        // Build working index list [0,1,...,n-1].
        let idxs = [k for k in 0..n]
        // Ear clip: each iteration finds an ear and clips it.
        let iterations = 0
        let max_iter = n * n
        while len(idxs) >= 3 and iterations < max_iter
            let m = len(idxs)
            let found = false
            let pos = 0
            while pos < m and not found
                let is_e = _cgt_is_ear(idxs, pos, poly, winding)
                if is_e
                    let prev_pos = pos - 1
                    if prev_pos < 0
                        prev_pos = m - 1
                    let next_pos = pos + 1
                    if next_pos >= m
                        next_pos = 0
                    let ai = idxs[prev_pos]
                    let bi = idxs[pos]
                    let ci = idxs[next_pos]
                    // Record this triangle as [ai, bi, ci].
                    let tri = []
                    push(tri, ai)
                    push(tri, bi)
                    push(tri, ci)
                    push(tris, tri)
                    // Remove vertex at pos from working list.
                    idxs = _cgt_remove(idxs, pos)
                    found = true
                pos = pos + 1
            if not found
                // Degenerate polygon (all collinear or error); stop.
                iterations = max_iter
            iterations = iterations + 1
        tris

// cgt_total_area_2x: sum of 2*areas of all triangulation triangles = polygon area * 2.
// Exact integer arithmetic.
fn cgt_total_area_2x(poly: list) -> int
    let tris = cgt_triangulate(poly)
    let nt = len(tris)
    let total = 0
    for k in 0..nt
        let tri = tris[k]
        let ai = tri[0]
        let bi = tri[1]
        let ci = tri[2]
        let ax = poly[ai][0]
        let ay = poly[ai][1]
        let bx = poly[bi][0]
        let by = poly[bi][1]
        let cx = poly[ci][0]
        let cy = poly[ci][1]
        let c2 = _cgt_cross2(ax, ay, bx, by, cx, cy)
        let c2a = _cgt_iabs(c2)
        total = total + c2a
    total
