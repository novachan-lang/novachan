// std/geometry/vector3.nova
// 3D vector math over [x,y,z] integer lists.
// Exact integer arithmetic for add/sub/scale/dot/cross/length_sq.
// Float results only for v3_length and v3_normalize.
// Private helpers prefixed _v3g_ to avoid cross-module collisions.

fn v3_add(a, b)
    let ax = a[0]
    let ay = a[1]
    let az = a[2]
    let bx = b[0]
    let by = b[1]
    let bz = b[2]
    let result = [ax + bx, ay + by, az + bz]
    result

fn v3_sub(a, b)
    let ax = a[0]
    let ay = a[1]
    let az = a[2]
    let bx = b[0]
    let by = b[1]
    let bz = b[2]
    let result = [ax - bx, ay - by, az - bz]
    result

fn v3_scale(a, s)
    let ax = a[0]
    let ay = a[1]
    let az = a[2]
    let result = [ax * s, ay * s, az * s]
    result

fn v3_dot(a, b)
    let ax = a[0]
    let ay = a[1]
    let az = a[2]
    let bx = b[0]
    let by = b[1]
    let bz = b[2]
    let d = ax * bx + ay * by + az * bz
    d

fn v3_cross(a, b)
    let ax = a[0]
    let ay = a[1]
    let az = a[2]
    let bx = b[0]
    let by = b[1]
    let bz = b[2]
    let cx = ay * bz - az * by
    let cy = az * bx - ax * bz
    let cz = ax * by - ay * bx
    let result = [cx, cy, cz]
    result

fn v3_length_sq(a)
    let ax = a[0]
    let ay = a[1]
    let az = a[2]
    let lsq = ax * ax + ay * ay + az * az
    lsq

fn v3_length(a)
    let ax = a[0]
    let ay = a[1]
    let az = a[2]
    let lsq = ax * ax + ay * ay + az * az
    let lsq_f = lsq * 1.0
    let len = sqrt(lsq_f)
    len

fn v3_normalize(a)
    let ax = a[0]
    let ay = a[1]
    let az = a[2]
    let lsq = ax * ax + ay * ay + az * az
    let lsq_f = lsq * 1.0
    let len = sqrt(lsq_f)
    let nx = ax * 1.0 / len
    let ny = ay * 1.0 / len
    let nz = az * 1.0 / len
    let result = [nx, ny, nz]
    result
