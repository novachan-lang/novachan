// std/geometry/polygon.nova — Polygon operations over ordered vertex lists.
//
// Each vertex is a two-element integer list [x, y].
// Exact integer arithmetic is used wherever possible:
//   shoelace 2*area, cross products, orientation, ray-casting intersection test.
// Floats are used only for true geometric measures: edge length, area, centroid.
//
// FLOAT HAZARDS obeyed throughout (per NOVA gotchas):
//   • sqrt() result always bound to a named let before use.
//   • abs(float) returns int in NOVA -> use  if v < 0.0  then  v = 0.0 - v  instead.
//   • float vs int compare unsound -> coerce ints with *1.0.
//   • Never return a bare multi-term float expression.
//
// Public API:
//   pg_area2(pts)           -> int    2 * signed shoelace area  (+CCW, -CW)
//   pg_area(pts)            -> float  absolute area
//   pg_perimeter(pts)       -> float  sum of edge lengths
//   pg_centroid(pts)        -> list   [cx:float, cy:float]
//   pg_contains(pts, px, py)-> bool   point-in-polygon (ray casting, strictly inside)
//   pg_is_convex(pts)       -> bool   true iff all consecutive turns have the same sign
//
// Private helpers are prefixed _pgx_ to avoid symbol collisions.
// LEAF — imports nothing.

// ── private helpers ──────────────────────────────────────────────────────────

// Edge length between two [x,y] integer points (float).
fn _pgx_edge_len(a: list, b: list) -> float
    let dx = b[0] - a[0]
    let dy = b[1] - a[1]
    let dsqf = (dx * dx + dy * dy) * 1.0
    let elen = sqrt(dsqf)
    elen

// ── public API ───────────────────────────────────────────────────────────────

// pg_area2: 2 * signed shoelace area (exact integer).
// Returns a positive value for CCW winding, negative for CW.
fn pg_area2(pts: list) -> int
    let n = len(pts)
    let i = 0
    let s = 0
    while i < n
        let j = i + 1
        if j >= n
            j = 0
        let xi = pts[i][0]
        let yi = pts[i][1]
        let xj = pts[j][0]
        let yj = pts[j][1]
        s += (xi * yj - xj * yi)
        i += 1
    s

// pg_area: absolute polygon area (float).
fn pg_area(pts: list) -> float
    let a2f = pg_area2(pts) * 1.0
    if a2f < 0.0
        a2f = 0.0 - a2f
    let result = a2f * 0.5
    result

// pg_perimeter: sum of Euclidean edge lengths (float).
fn pg_perimeter(pts: list) -> float
    let n = len(pts)
    let i = 0
    let perim = 0.0
    while i < n
        let j = i + 1
        if j >= n
            j = 0
        let el = _pgx_edge_len(pts[i], pts[j])
        perim += el
        i += 1
    perim

// pg_centroid: [cx, cy] float centroid via the weighted shoelace formula.
//
//   cx = sum_i((xi+xj)*(xi*yj - xj*yi)) / (3 * area2)
//   cy = sum_i((yi+yj)*(xi*yj - xj*yi)) / (3 * area2)
//
// The denominator is  3 * area2  (exact int), then converted to float.
fn pg_centroid(pts: list) -> list
    let n = len(pts)
    let i = 0
    let sx = 0
    let sy = 0
    let a2 = pg_area2(pts)
    while i < n
        let j = i + 1
        if j >= n
            j = 0
        let xi = pts[i][0]
        let yi = pts[i][1]
        let xj = pts[j][0]
        let yj = pts[j][1]
        let cross = xi * yj - xj * yi
        sx += (xi + xj) * cross
        sy += (yi + yj) * cross
        i += 1
    let denom = (3 * a2) * 1.0
    let cx = sx * 1.0 / denom
    let cy = sy * 1.0 / denom
    [cx, cy]

// pg_contains: point-in-polygon test via horizontal ray casting.
// Returns true iff (px, py) is strictly inside the polygon.
//
// Algorithm: cast a horizontal ray rightward from (px,py); count the number
// of edges that cross it (half-open interval on y: yi <= py < yj OR yj <= py < yi).
// An odd count means inside; even means outside.
//
// The crossing test is done with INTEGER arithmetic to avoid float-compare UB:
//   intersection x = xi + (py-yi)*(xj-xi)/(yj-yi)  > px
//   rearranged:   (xj-xi)*(py-yi)  > (yj-yi)*(px-xi)
// When yi <= py < yj (i.e. yj-yi > 0) this sign is preserved.
// When yj <= py < yi (i.e. yj-yi < 0) we negate both sides to keep dy positive.
fn pg_contains(pts: list, px: int, py: int) -> bool
    let n = len(pts)
    let i = 0
    let cnt = 0
    while i < n
        let j = i + 1
        if j >= n
            j = 0
        let xi = pts[i][0]
        let yi = pts[i][1]
        let xj = pts[j][0]
        let yj = pts[j][1]
        // Determine if the edge straddles the ray's y-level (half-open interval).
        let hit = false
        if yi <= py and yj > py
            // upward crossing: dy = yj-yi > 0
            let lhs = (xj - xi) * (py - yi)
            let rhs = (yj - yi) * (px - xi)
            if lhs > rhs
                hit = true
        if yj <= py and yi > py
            // downward crossing: dy = yi-yj > 0 after negation
            let lhs = (xi - xj) * (py - yj)
            let rhs = (yi - yj) * (px - xj)
            if lhs > rhs
                hit = true
        if hit
            cnt += 1
        i += 1
    // Odd crossing count -> inside
    let rem = cnt - (cnt / 2) * 2
    rem == 1

// pg_is_convex: true iff all consecutive edge cross products share the same sign.
// Cross product of zero (collinear edges) is allowed — the polygon is still convex.
fn pg_is_convex(pts: list) -> bool
    let n = len(pts)
    let i = 0
    let first_sign = 0
    let convex = true
    while i < n
        let j = i + 1
        if j >= n
            j = 0
        let k = j + 1
        if k >= n
            k = 0
        let ax = pts[j][0] - pts[i][0]
        let ay = pts[j][1] - pts[i][1]
        let bx = pts[k][0] - pts[j][0]
        let by = pts[k][1] - pts[j][1]
        let cross = ax * by - ay * bx
        if cross != 0
            if first_sign == 0
                if cross > 0
                    first_sign = 1
                if cross < 0
                    first_sign = -1
            else
                if first_sign == 1 and cross < 0
                    convex = false
                if first_sign == -1 and cross > 0
                    convex = false
        i += 1
    convex
