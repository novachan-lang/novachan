// std/geometry/vector2.nova — 2D integer vector math.
// Vectors are 2-element lists [x, y] with integer coordinates.
// Exact integer arithmetic is used throughout to avoid float fragility.
// Float results (v2_length) bind every sub-expression to a named let to
// avoid the uninit-float-slot compiler bug.
//
// FLOAT HAZARDS obeyed:
//   • bare multi-term float return -> bind EVERY intermediate to a named `let`.
//   • abs(float) returns int -> use if/else for float absolute value.
//   • Single-exit pattern on every fn.
//
// Private helpers use the _v2_ prefix (unique to this module).
//
// Public API:
//   v2_add(a, b)       -> list  element-wise add: [ax+bx, ay+by]
//   v2_sub(a, b)       -> list  element-wise subtract: [ax-bx, ay-by]
//   v2_scale(a, s)     -> list  scalar multiply: [ax*s, ay*s]
//   v2_dot(a, b)       -> int   dot product: ax*bx + ay*by
//   v2_cross(a, b)     -> int   scalar z-component of cross product: ax*by - ay*bx
//   v2_length_sq(a)    -> int   squared length: ax*ax + ay*ay
//   v2_length(a)       -> float Euclidean length: sqrt(ax*ax + ay*ay)
//   v2_perp(a)         -> list  90-degree CCW perpendicular: [-ay, ax]
//   v2_manhattan(a)    -> int   Manhattan norm: |ax| + |ay|

// _v2_iabs — integer absolute value.
// NOVA abs() works on int; just delegates to the builtin.
fn _v2_iabs(x: int) -> int
    let r = abs(x)
    r

// v2_add — element-wise vector addition.
// Returns [a[0]+b[0], a[1]+b[1]].
fn v2_add(a: list, b: list) -> list
    let ax = a[0]
    let ay = a[1]
    let bx = b[0]
    let by = b[1]
    let result = []
    push(result, ax + bx)
    push(result, ay + by)
    result

// v2_sub — element-wise vector subtraction.
// Returns [a[0]-b[0], a[1]-b[1]].
fn v2_sub(a: list, b: list) -> list
    let ax = a[0]
    let ay = a[1]
    let bx = b[0]
    let by = b[1]
    let result = []
    push(result, ax - bx)
    push(result, ay - by)
    result

// v2_scale — scalar multiplication.
// Returns [a[0]*s, a[1]*s].
fn v2_scale(a: list, s: int) -> list
    let ax = a[0]
    let ay = a[1]
    let result = []
    push(result, ax * s)
    push(result, ay * s)
    result

// v2_dot — dot product.
// Returns ax*bx + ay*by (integer).
fn v2_dot(a: list, b: list) -> int
    let ax = a[0]
    let ay = a[1]
    let bx = b[0]
    let by = b[1]
    let d = ax * bx + ay * by
    d

// v2_cross — scalar z-component of the 3D cross product.
// For 2D vectors: ax*by - ay*bx.
// Positive = b is CCW from a; negative = CW; zero = collinear.
fn v2_cross(a: list, b: list) -> int
    let ax = a[0]
    let ay = a[1]
    let bx = b[0]
    let by = b[1]
    let c = ax * by - ay * bx
    c

// v2_length_sq — squared Euclidean length.
// Returns ax*ax + ay*ay (integer, exact).
fn v2_length_sq(a: list) -> int
    let ax = a[0]
    let ay = a[1]
    let lsq = ax * ax + ay * ay
    lsq

// v2_length — Euclidean length as float.
// Binds sqrt result to a let to avoid uninit-float-slot bug.
// For integer inputs, v2_length_sq gives an exact int; coerce to float
// before sqrt via *1.0.
fn v2_length(a: list) -> float
    let ax = a[0]
    let ay = a[1]
    let lsq = ax * ax + ay * ay
    let lsqf = lsq * 1.0
    let r = sqrt(lsqf)
    r

// v2_perp — 90-degree CCW perpendicular vector.
// Rotates [x, y] by 90 degrees counter-clockwise: result is [-y, x].
fn v2_perp(a: list) -> list
    let ax = a[0]
    let ay = a[1]
    let result = []
    let neg_ay = -ay
    push(result, neg_ay)
    push(result, ax)
    result

// v2_manhattan — Manhattan (L1) norm.
// Returns |ax| + |ay| (integer).
fn v2_manhattan(a: list) -> int
    let ax = a[0]
    let ay = a[1]
    let absx = _v2_iabs(ax)
    let absy = _v2_iabs(ay)
    let m = absx + absy
    m
