// std/geometry/cg_polygon_area.nova — Exact integer polygon area via the shoelace formula.
//
// A polygon is a list of [x,y] integer-coordinate vertices in order (no repeated closing vertex).
// All arithmetic is exact integer; no floats, no sqrt.
//
// Public API (prefix cga_):
//   cga_area_2x(poly)     -> int   signed 2*area (+CCW, -CW, 0 degenerate)
//   cga_area_abs_2x(poly) -> int   absolute value of 2*area
//   cga_is_ccw(poly)      -> bool  true iff signed area > 0 (CCW winding)
//
// LEAF — imports nothing.

// _cga_iabs — absolute value of an integer.
fn _cga_iabs(x: int) -> int
    let r = 0
    if x < 0
        r = 0 - x
    else
        r = x
    r

// cga_area_2x — signed shoelace 2*area; positive for CCW, negative for CW, 0 for degenerate.
fn cga_area_2x(poly: list) -> int
    let n = len(poly)
    let s = 0
    for i in 0..n
        let j = i + 1
        if j >= n
            j = 0
        let xi = poly[i][0]
        let yi = poly[i][1]
        let xj = poly[j][0]
        let yj = poly[j][1]
        s = s + (xi * yj - xj * yi)
    s

// cga_area_abs_2x — absolute value of signed 2*area; always >= 0.
fn cga_area_abs_2x(poly: list) -> int
    let a = cga_area_2x(poly)
    _cga_iabs(a)

// cga_is_ccw — true iff the polygon has counter-clockwise winding (signed area > 0).
fn cga_is_ccw(poly: list) -> bool
    let a = cga_area_2x(poly)
    a > 0
