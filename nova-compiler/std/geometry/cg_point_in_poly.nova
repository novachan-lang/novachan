// std/geometry/cg_point_in_poly.nova — Exact integer point-in-polygon tests.
//
// A polygon is a list of [x,y] integer-coordinate vertices in order (no repeated closing vertex).
// A point is a 2-element integer list [px, py].
// All arithmetic is exact integer; no floats, no sqrt.
//
// Public API (prefix cgp_):
//   cgp_on_boundary(poly, pt) -> bool  pt lies on an edge of poly
//   cgp_inside(poly, pt)      -> bool  pt is strictly inside poly (ray casting)
//   cgp_contains(poly, pt)    -> bool  pt is inside OR on the boundary
//
// Ray-casting algorithm: cast a horizontal ray rightward from pt; count upward crossings
// minus downward crossings (half-open y interval [yi,yj) or [yj,yi)).
// All crossing tests are done with pure integer arithmetic (no division).
//
// On-boundary test: for each edge AB, check collinearity via cross product and that pt
// lies within the bounding box of the edge (all exact integer).
//
// LEAF — imports nothing.

// _cgp_cross2 — 2D cross product of vectors OA=(ax-ox,ay-oy) and OB=(bx-ox,by-oy).
// Inline helper used for the boundary test.
fn _cgp_cross2(ox: int, oy: int, ax: int, ay: int, bx: int, by: int) -> int
    let dax = ax - ox
    let day = ay - oy
    let dbx = bx - ox
    let dby = by - oy
    let cross = dax * dby - day * dbx
    cross

// _cgp_between — true iff v is in [lo, hi] (inclusive, lo <= hi guaranteed by caller).
fn _cgp_between(lo: int, v: int, hi: int) -> bool
    v >= lo and v <= hi

// _cgp_iabs — absolute value of an integer.
fn _cgp_iabs(x: int) -> int
    let r = 0
    if x < 0
        r = 0 - x
    else
        r = x
    r

// _cgp_min2 — min of two ints.
fn _cgp_min2(a: int, b: int) -> int
    let r = 0
    if a < b
        r = a
    else
        r = b
    r

// _cgp_max2 — max of two ints.
fn _cgp_max2(a: int, b: int) -> int
    let r = 0
    if a > b
        r = a
    else
        r = b
    r

// cgp_on_boundary — true iff pt lies exactly on any edge of poly.
// For each edge (A,B): pt is on the edge iff cross(A, B, pt)==0 AND pt is within the
// axis-aligned bounding box of the edge.
fn cgp_on_boundary(poly: list, pt: list) -> bool
    let n = len(poly)
    let px = pt[0]
    let py = pt[1]
    let found = false
    let i = 0
    while i < n
        let j = i + 1
        if j >= n
            j = 0
        let ax = poly[i][0]
        let ay = poly[i][1]
        let bx = poly[j][0]
        let by = poly[j][1]
        // cross product (B-A) x (P-A) — if zero, P is collinear with A,B
        let dxba = bx - ax
        let dyba = by - ay
        let dxpa = px - ax
        let dypa = py - ay
        let cross = dxba * dypa - dyba * dxpa
        if cross == 0
            // Collinear: check bounding box
            let xlo = _cgp_min2(ax, bx)
            let xhi = _cgp_max2(ax, bx)
            let ylo = _cgp_min2(ay, by)
            let yhi = _cgp_max2(ay, by)
            if _cgp_between(xlo, px, xhi) and _cgp_between(ylo, py, yhi)
                found = true
        i = i + 1
    found

// cgp_inside — true iff pt is strictly inside poly (not on boundary).
// Uses the ray-casting (Jordan curve) algorithm with exact integer arithmetic.
// A horizontal ray is cast rightward from (px,py); edges are counted via half-open
// y-interval [yi,yj) or [yj,yi) and an integer-only crossing test (no division).
// Boundary points are explicitly excluded first (they would be misclassified by pure
// ray casting when the ray grazes an edge or vertex exactly).
fn cgp_inside(poly: list, pt: list) -> bool
    // Strictly inside means NOT on the boundary
    if cgp_on_boundary(poly, pt)
        false
    else
        let n = len(poly)
        let px = pt[0]
        let py = pt[1]
        let cnt = 0
        let i = 0
        while i < n
            let j = i + 1
            if j >= n
                j = 0
            let xi = poly[i][0]
            let yi = poly[i][1]
            let xj = poly[j][0]
            let yj = poly[j][1]
            // Upward crossing: yi <= py < yj  (dy = yj-yi > 0)
            if yi <= py and yj > py
                // crossing x = xi + (py-yi)*(xj-xi)/(yj-yi) > px
                // rearranged (dy > 0): (xj-xi)*(py-yi) > (yj-yi)*(px-xi)
                let lhs = (xj - xi) * (py - yi)
                let rhs = (yj - yi) * (px - xi)
                if lhs > rhs
                    cnt = cnt + 1
            // Downward crossing: yj <= py < yi  (dy = yi-yj > 0 after flip)
            if yj <= py and yi > py
                // flip sign: (xi-xj)*(py-yj) > (yi-yj)*(px-xj)
                let lhs = (xi - xj) * (py - yj)
                let rhs = (yi - yj) * (px - xj)
                if lhs > rhs
                    cnt = cnt + 1
            i = i + 1
        // Odd crossing count = inside
        let rem = cnt - (cnt / 2) * 2
        rem == 1

// cgp_contains — true iff pt is strictly inside OR on the boundary of poly.
fn cgp_contains(poly: list, pt: list) -> bool
    cgp_inside(poly, pt) or cgp_on_boundary(poly, pt)
