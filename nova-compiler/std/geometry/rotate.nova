// std/geometry/rotate.nova — 2D affine transforms of points (floats).
//
// A 2D point is represented as a 2-element list [x, y] with float coordinates.
//
// FLOAT HAZARDS obeyed (see NOVA gotchas):
//   • Every sin/cos call is bound to a named let before arithmetic.
//   • Never return a multi-term float expression bare — bind to let first.
//   • abs(float) returns int — avoided here (no float abs needed).
//   • Subtraction of a float from 0: use 0.0 - x, not -x.
//   • pi() — use the builtin, never a bare 'pi' identifier.
//
// Private helpers prefixed _ro_ (unique to this module).
//
// Public API:
//   ro_rotate(px, py, angle_rad)             -> list [x', y']   rotate about origin (CCW)
//   ro_rotate_about(px, py, cx, cy, angle)   -> list [x', y']   rotate about arbitrary centre
//   ro_translate(px, py, dx, dy)             -> list [x', y']   translate by (dx, dy)
//   ro_scale(px, py, sx, sy)                 -> list [x', y']   scale about origin
//   ro_rotate_points(points, angle)          -> list             rotate a list of points about origin

// ro_rotate — rotate point (px, py) by angle_rad CCW about the origin.
// x' = px*cos(a) - py*sin(a)
// y' = px*sin(a) + py*cos(a)
// Every trig result is bound to a named let to avoid the uninit-float-slot bug.
fn ro_rotate(px, py, angle_rad)
    let c = cos(angle_rad)
    let s = sin(angle_rad)
    let px_f = px * 1.0
    let py_f = py * 1.0
    let rx = px_f * c - py_f * s
    let ry = px_f * s + py_f * c
    let result = [rx, ry]
    result

// ro_rotate_about — rotate point (px, py) CCW by angle about centre (cx, cy).
// Algorithm: translate to origin, rotate, translate back.
fn ro_rotate_about(px, py, cx, cy, angle)
    let c = cos(angle)
    let s = sin(angle)
    let tx = px * 1.0 - cx * 1.0
    let ty = py * 1.0 - cy * 1.0
    let rx = tx * c - ty * s
    let ry = tx * s + ty * c
    let ox = rx + cx * 1.0
    let oy = ry + cy * 1.0
    let result = [ox, oy]
    result

// ro_translate — translate point (px, py) by vector (dx, dy).
fn ro_translate(px, py, dx, dy)
    let rx = px * 1.0 + dx * 1.0
    let ry = py * 1.0 + dy * 1.0
    let result = [rx, ry]
    result

// ro_scale — scale point (px, py) about the origin by (sx, sy).
fn ro_scale(px, py, sx, sy)
    let rx = px * 1.0 * (sx * 1.0)
    let ry = py * 1.0 * (sy * 1.0)
    let result = [rx, ry]
    result

// ro_rotate_points — rotate every point in 'points' by angle_rad CCW about the origin.
// Returns a new list of transformed [x, y] float pairs.
fn ro_rotate_points(points, angle_rad)
    let c = cos(angle_rad)
    let s = sin(angle_rad)
    let n = len(points)
    let out = []
    let i = 0
    while i < n
        let pt = points[i]
        let px_f = pt[0] * 1.0
        let py_f = pt[1] * 1.0
        let rx = px_f * c - py_f * s
        let ry = px_f * s + py_f * c
        let rpt = [rx, ry]
        push(out, rpt)
        let i = i + 1
    out
