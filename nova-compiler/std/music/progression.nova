// ============================================================================
// NOVA Standard Library — std/music/progression
// ============================================================================
// Chord progressions from Roman numeral degrees in a major key.
//
// DIATONIC TRIADS IN MAJOR KEY
//   The seven diatonic scale degrees and their chord qualities:
//     I   (degree 1) — major,       semitone offset from key root: 0
//     ii  (degree 2) — minor,       semitone offset: 2
//     iii (degree 3) — minor,       semitone offset: 4
//     IV  (degree 4) — major,       semitone offset: 5
//     V   (degree 5) — major,       semitone offset: 7
//     vi  (degree 6) — minor,       semitone offset: 9
//     vii (degree 7) — diminished,  semitone offset: 11
//
//   Roman numeral convention:
//     Uppercase (I, II, III, IV, V, VI, VII) → major
//     Lowercase (ii, iii, vi, vii)            → minor or diminished
//     vii is always diminished in a major key
//
// TRIAD INTERVALS
//   major       [0, 4, 7]   (root, major third, perfect fifth)
//   minor       [0, 3, 7]   (root, minor third, perfect fifth)
//   dim         [0, 3, 6]   (root, minor third, diminished fifth)
//
// PUBLIC API
//   roman_to_root(key_root, roman)   -> int    chord root MIDI note
//   roman_to_chord(key_root, roman)  -> list   chord MIDI notes
//   progression(key_root, romans)    -> list   list of chord-note lists
//   roman_quality(roman)             -> string "major" | "minor" | "dim" | "unknown"
//
// NOTES
//   key_root is a MIDI note number (e.g. 60 = C4).
//   All arithmetic is integer-only; no floats used.
//   Unrecognised Roman numeral strings return -1 / [] / "unknown" respectively.
// ============================================================================

// ── private: Roman numeral -> semitone offset from key root ─────────────────

// _roman_offset(roman) -> int
//   Return the semitone offset (0..11) for the given Roman numeral degree
//   in a major key.  Returns -1 if not recognised.
fn _roman_offset(roman)
    let offset = -1
    if roman == "I"
        offset = 0
    else if roman == "ii"
        offset = 2
    else if roman == "iii"
        offset = 4
    else if roman == "IV"
        offset = 5
    else if roman == "V"
        offset = 7
    else if roman == "vi"
        offset = 9
    else if roman == "vii"
        offset = 11
    offset

// ── private: build triad interval lists ─────────────────────────────────────

// _major_ivs() -> list
fn _major_ivs()
    let ivs = []
    push(ivs, 0)
    push(ivs, 4)
    push(ivs, 7)
    ivs

// _minor_ivs() -> list
fn _minor_ivs()
    let ivs = []
    push(ivs, 0)
    push(ivs, 3)
    push(ivs, 7)
    ivs

// _dim_ivs() -> list
fn _dim_ivs()
    let ivs = []
    push(ivs, 0)
    push(ivs, 3)
    push(ivs, 6)
    ivs

// ── public API ───────────────────────────────────────────────────────────────

// roman_quality(roman) -> string
//   Return the chord quality for the given Roman numeral degree in a major key.
//   "I", "IV", "V" -> "major"
//   "ii", "iii", "vi" -> "minor"
//   "vii" -> "dim"
//   Anything else -> "unknown"
fn roman_quality(roman)
    let quality = "unknown"
    if roman == "I"
        quality = "major"
    else if roman == "ii"
        quality = "minor"
    else if roman == "iii"
        quality = "minor"
    else if roman == "IV"
        quality = "major"
    else if roman == "V"
        quality = "major"
    else if roman == "vi"
        quality = "minor"
    else if roman == "vii"
        quality = "dim"
    quality

// roman_to_root(key_root, roman) -> int
//   Return the MIDI note number of the chord root for the given Roman numeral
//   degree in a major key rooted at key_root.
//   E.g. roman_to_root(60, "V") == 67  (G4 in C major).
//   Returns -1 if roman is not a recognised diatonic degree.
fn roman_to_root(key_root, roman)
    let offset = _roman_offset(roman)
    let result = -1
    if offset >= 0
        result = key_root + offset
    result

// roman_to_chord(key_root, roman) -> list
//   Return the MIDI note numbers for the diatonic triad on the given Roman
//   numeral degree in a major key rooted at key_root.
//   The chord is built in root position: [root, third, fifth].
//   Returns an empty list if roman is not recognised.
fn roman_to_chord(key_root, roman)
    let root = roman_to_root(key_root, roman)
    let result = []
    if root >= 0
        let quality = roman_quality(roman)
        let ivs = []
        if quality == "major"
            ivs = _major_ivs()
        else if quality == "minor"
            ivs = _minor_ivs()
        else if quality == "dim"
            ivs = _dim_ivs()
        let ni = len(ivs)
        for i in 0..ni
            push(result, root + ivs[i])
    result

// progression(key_root, romans) -> list
//   Return a list of chords (each chord is a list of MIDI note numbers) for
//   the given sequence of Roman numeral strings in a major key.
//   E.g. progression(60, ["I","IV","V"]) returns three chord lists.
//   Unrecognised Roman numerals produce empty chord lists at that position.
fn progression(key_root, romans)
    let chords = []
    let i = 0
    let n = len(romans)
    while i < n
        let chord = roman_to_chord(key_root, romans[i])
        push(chords, chord)
        i += 1
    chords
