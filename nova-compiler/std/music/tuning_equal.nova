// ============================================================================
// NOVA Standard Library — std/music/tuning_equal
// ============================================================================
// 12-tone equal temperament (12-TET) — integer math only.
//
// Convention:
//   One semitone = 100 cents exactly (no approximation needed).
//   Frequencies from A4=440 Hz: f(n) = round(440 * 2^((n-69)/12)).
//   MIDI note numbers: C4=60, A4=69. Pitch class = note % 12.
//   C=0, C#=1, D=2, D#=3, E=4, F=5, F#=6, G=7, G#=8, A=9, A#=10, B=11.
//
// FLOAT HAZARD: bind intermediate float results to named lets before return.
//   Never return a bare multi-term float expression (uninit-slot compiler bug).
//
// PUBLIC API
//   et_cents(semitones)          -> int   semitones * 100 (cents in 12-TET)
//   et_freq_hz(note)             -> int   frequency in Hz, rounded to nearest int
//   et_ratio_millicents(semis)   -> int   semitones * 100  (cents value; same formula)
//   et_interval_cents(a, b)      -> int   signed cents from note a to note b
// ============================================================================

// et_cents(semitones) -> int
//   Return the number of cents in a given number of semitones.
//   In 12-TET, 1 semitone = 100 cents exactly.
//   Examples: et_cents(1)==100, et_cents(12)==1200, et_cents(7)==700.
fn et_cents(semitones)
    semitones * 100

// et_freq_hz(note) -> int
//   Return the frequency in Hz (rounded to nearest integer) for MIDI note n.
//   Formula: round(440.0 * 2^((n - 69) / 12.0)).
//   A4(69)=440 Hz, A3(57)=220 Hz, A5(81)=880 Hz, C4(60)=262 Hz.
//   FLOAT HAZARD: bind each sub-expression to a named let (compiler bug workaround).
fn et_freq_hz(note)
    let diff = note - 69
    let exponent = diff * 1.0 / 12.0
    let ratio = pow(2.0, exponent)
    let freq_f = 440.0 * ratio
    let freq_i = round(freq_f)
    freq_i

// et_ratio_millicents(semis) -> int
//   Return the cent value for a given number of semitones in 12-TET.
//   Identical in value to et_cents; provided for API completeness when a
//   caller needs to label the quantity as "cents of the equal-tempered ratio".
//   1 semitone = 100 cents; no fractional cents arise in 12-TET semitone counts.
fn et_ratio_millicents(semis)
    semis * 100

// et_interval_cents(a, b) -> int
//   Return the signed interval in cents from MIDI note a to MIDI note b.
//   Positive when b is higher than a; negative when b is lower.
//   Examples: et_interval_cents(60, 67)==700, et_interval_cents(67, 60)==-700.
fn et_interval_cents(a, b)
    (b - a) * 100
