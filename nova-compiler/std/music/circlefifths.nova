// ============================================================================
// NOVA Standard Library — std/music/circlefifths
// ============================================================================
// Circle of fifths: the 12 major keys arranged in clockwise order of ascending
// perfect fifths (7 semitones each), starting at C.
//
// Clockwise order (position 0..11):
//   0=C  1=G  2=D  3=A  4=E  5=B  6=F#  7=Db  8=Ab  9=Eb  10=Bb  11=F
//
// Enharmonic convention: the flat side uses flat names (Db Ab Eb Bb) because
// that is standard music-theory notation for the circle of fifths.
// F# (position 6) is treated as a sharp key; Gb is its enharmonic but we
// canonically name it F#.
//
// PUBLIC API
//   circle_order()              -> list   12 key names clockwise from C
//   circle_position(key)        -> int    0-based clockwise index; -1 if unknown
//   fifth_up(key)               -> str    next key clockwise (one perfect fifth up)
//   fifth_down(key)             -> str    next key counter-clockwise (one perfect fifth down)
//   distance_fifths(a, b)       -> int    clockwise steps from a to b (0..11)
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _cof_name(pos) -> str
//   Return the canonical key name at clockwise position pos (0..11).
fn _cof_name(pos)
    let name = "C"
    if pos == 0
        name = "C"
    else if pos == 1
        name = "G"
    else if pos == 2
        name = "D"
    else if pos == 3
        name = "A"
    else if pos == 4
        name = "E"
    else if pos == 5
        name = "B"
    else if pos == 6
        name = "F#"
    else if pos == 7
        name = "Db"
    else if pos == 8
        name = "Ab"
    else if pos == 9
        name = "Eb"
    else if pos == 10
        name = "Bb"
    else if pos == 11
        name = "F"
    name

// _cof_pos(key) -> int
//   Return the clockwise position (0..11) for a canonical key name; -1 if unknown.
//   Accepts enharmonic aliases: Gb=F#, C#=Db, G#=Ab, D#=Eb, A#=Bb.
fn _cof_pos(key)
    let pos = -1
    if key == "C"
        pos = 0
    else if key == "G"
        pos = 1
    else if key == "D"
        pos = 2
    else if key == "A"
        pos = 3
    else if key == "E"
        pos = 4
    else if key == "B"
        pos = 5
    else if key == "F#"
        pos = 6
    else if key == "Gb"
        pos = 6
    else if key == "Db"
        pos = 7
    else if key == "C#"
        pos = 7
    else if key == "Ab"
        pos = 8
    else if key == "G#"
        pos = 8
    else if key == "Eb"
        pos = 9
    else if key == "D#"
        pos = 9
    else if key == "Bb"
        pos = 10
    else if key == "A#"
        pos = 10
    else if key == "F"
        pos = 11
    pos

// ── public API ───────────────────────────────────────────────────────────────

// circle_order() -> list
//   Return a list of 12 key names in clockwise order starting at C.
fn circle_order()
    let keys = []
    push(keys, "C")
    push(keys, "G")
    push(keys, "D")
    push(keys, "A")
    push(keys, "E")
    push(keys, "B")
    push(keys, "F#")
    push(keys, "Db")
    push(keys, "Ab")
    push(keys, "Eb")
    push(keys, "Bb")
    push(keys, "F")
    keys

// circle_position(key) -> int
//   Return the clockwise position (0=C, 1=G, ..., 11=F) of the given key.
//   Enharmonic aliases (e.g. Gb=F#, C#=Db) are accepted.
//   Returns -1 if the key name is not recognised.
fn circle_position(key)
    _cof_pos(key)

// fifth_up(key) -> str
//   Return the key one perfect fifth above (one step clockwise) on the circle.
//   Returns "" if key is not recognised.
fn fifth_up(key)
    let pos = _cof_pos(key)
    let result = ""
    if pos >= 0
        let next = pos + 1
        if next > 11
            next = 0
        result = _cof_name(next)
    result

// fifth_down(key) -> str
//   Return the key one perfect fifth below (one step counter-clockwise) on the circle.
//   Returns "" if key is not recognised.
fn fifth_down(key)
    let pos = _cof_pos(key)
    let result = ""
    if pos >= 0
        let prev = pos - 1
        if prev < 0
            prev = 11
        result = _cof_name(prev)
    result

// distance_fifths(a, b) -> int
//   Return the number of clockwise steps from key a to key b on the circle (0..11).
//   Returns -1 if either key is not recognised.
fn distance_fifths(a, b)
    let pa = _cof_pos(a)
    let pb = _cof_pos(b)
    let result = -1
    if pa >= 0 and pb >= 0
        let d = pb - pa
        if d < 0
            d = d + 12
        result = d
    result
