// ============================================================================
// NOVA Standard Library — std/music/arpeggio
// ============================================================================
// Arpeggiate a chord (list of MIDI note numbers) into a sequence following
// a pattern.  All arithmetic is integer-only; no floats used.
//
// CONVENTION
//   Input notes may be in any order.  "Up" means sorted ascending by MIDI
//   note number; "down" means sorted descending.  Pitch class is irrelevant
//   here — we work with absolute MIDI note numbers.
//
// PUBLIC API
//   arp_up(notes)             -> list  ascending order
//   arp_down(notes)           -> list  descending order
//   arp_updown(notes)         -> list  up then down, no repeated top/bottom
//   arp_downup(notes)         -> list  down then up, no repeated top/bottom
//   arp_pattern(notes,idxs)   -> list  custom index pattern into sorted notes
//   arp_octaves(notes,octaves)-> list  repeat the ascending arp across N octaves
//
// NOTES
//   arp_updown:  [a,b,c] -> [a,b,c,b]  (top and bottom not repeated at the join)
//   arp_downup:  [a,b,c] -> [c,b,a,b]  (top and bottom not repeated at the join)
//   arp_pattern: indices wrap-around modulo the length of the sorted note list;
//                out-of-range indices are safe.
//   arp_octaves: the sorted chord is transposed by +12 per octave and
//                concatenated; octaves=1 returns one copy (the original range).
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _arp_sort_asc(notes) -> new list sorted ascending (selection sort)
fn _arp_sort_asc(notes)
    let n = len(notes)
    let result = []
    let i = 0
    while i < n
        push(result, notes[i])
        i = i + 1
    // Selection sort ascending: find minimum in remaining range, swap to front.
    let k = 0
    while k < n
        let min_idx = k
        let j = k + 1
        while j < n
            if result[j] < result[min_idx]
                min_idx = j
            j = j + 1
        // Swap result[k] and result[min_idx].
        if min_idx != k
            let tmp = result[k]
            result[k] = result[min_idx]
            result[min_idx] = tmp
        k = k + 1
    result

// ── public API ────────────────────────────────────────────────────────────────

// arp_up(notes) -> list
//   Return the notes sorted in ascending order (lowest to highest).
fn arp_up(notes)
    _arp_sort_asc(notes)

// arp_down(notes) -> list
//   Return the notes sorted in descending order (highest to lowest).
fn arp_down(notes)
    let asc = _arp_sort_asc(notes)
    let n = len(asc)
    let result = []
    let i = n - 1
    while i >= 0
        push(result, asc[i])
        i = i - 1
    result

// arp_updown(notes) -> list
//   Ascending then descending, without repeating the highest note at the
//   turnaround or the lowest note at the end.
//   E.g. [a,b,c] -> [a,b,c,b]  (3 notes -> 4 steps)
//   For a single note, returns just that note.
//   For two notes, [a,b] -> [a,b,a] follows the same rule (only the top is
//   not repeated; the bottom is not repeated at the end either).
//   Wait — spec says: up then down WITHOUT repeating top/bottom.
//   [a,b,c]: up=[a,b,c], down-without-first=[b,a], without-last=[b] -> [a,b,c,b].
fn arp_updown(notes)
    let asc = _arp_sort_asc(notes)
    let n = len(asc)
    let result = []
    // Up pass: all notes.
    let i = 0
    while i < n
        push(result, asc[i])
        i = i + 1
    // Down pass: exclude the top (index n-1, already added) and the bottom
    // (index 0, would repeat).  So iterate from n-2 down to 1 inclusive.
    if n > 1
        let j = n - 2
        while j >= 1
            push(result, asc[j])
            j = j - 1
    result

// arp_downup(notes) -> list
//   Descending then ascending, without repeating the lowest note at the
//   turnaround or the highest note at the end.
//   E.g. [a,b,c] -> [c,b,a,b]  (3 notes -> 4 steps)
fn arp_downup(notes)
    let asc = _arp_sort_asc(notes)
    let n = len(asc)
    let result = []
    // Down pass: from highest (n-1) to lowest (0).
    let i = n - 1
    while i >= 0
        push(result, asc[i])
        i = i - 1
    // Up pass: exclude the bottom (index 0, already added) and the top
    // (index n-1, would repeat).  Iterate from 1 up to n-2 inclusive.
    if n > 1
        let j = 1
        while j <= n - 2
            push(result, asc[j])
            j = j + 1
    result

// arp_pattern(notes, indices) -> list
//   Apply a custom index pattern to the sorted note list.
//   Each element of indices selects a note from the ascending-sorted chord.
//   Indices wrap modulo chord length (safe for any value).
fn arp_pattern(notes, indices)
    let asc = _arp_sort_asc(notes)
    let nlen = len(asc)
    let plen = len(indices)
    let result = []
    let i = 0
    while i < plen
        let idx = indices[i]
        // Positive modulo: handle negative indices gracefully.
        let wrapped = idx - (idx / nlen) * nlen
        if wrapped < 0
            wrapped = wrapped + nlen
        push(result, asc[wrapped])
        i = i + 1
    result

// arp_octaves(notes, octaves) -> list
//   Repeat the ascending arpeggio across N octaves, transposing each
//   successive copy up by 12 semitones.
//   octaves=1 returns one copy (the base chord).
//   octaves=2 returns base + base+12, etc.
fn arp_octaves(notes, octaves)
    let asc = _arp_sort_asc(notes)
    let nlen = len(asc)
    let result = []
    let oct = 0
    while oct < octaves
        let shift = oct * 12
        let i = 0
        while i < nlen
            push(result, asc[i] + shift)
            i = i + 1
        oct = oct + 1
    result
