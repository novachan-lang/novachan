// ============================================================================
// NOVA Standard Library — std/music/tuning_just
// ============================================================================
// Just intonation ratios and cents values.
//
// Just intonation tunes intervals using pure integer ratios (small whole
// numbers) instead of 12-TET equal temperament. This gives beatless perfect
// consonances at the cost of mistuned intervals in other keys.
//
// RATIOS (as [num, den] integer pairs):
//   P1  1/1    P8  2/1
//   m2  16/15  M2  9/8   m3  6/5   M3  5/4
//   P4  4/3    TT  45/32
//   P5  3/2    m6  8/5   M6  5/3   m7  9/5   M7  15/8
//
// CENTS:  round(1200 * log2(num/den))
//   P1=0   m2=112  M2=204  m3=316  M3=386
//   P4=498 TT=590  P5=702  m6=814  M6=884
//   m7=1018 M7=1088 P8=1200
//
// NOTE: 12-TET equal temperament reference: P5=700c, M3=400c, P4=500c.
// Just ratios differ by small amounts (syntonic comma, schisma, etc.).
//
// PUBLIC API
//   just_ratio(name)         -> list [num, den]   ratio for named interval
//   just_cents(name)         -> int               cents (rounded) for named interval
//   ratio_to_cents(num, den) -> int               compute cents from any ratio
//   ratio_reduce(num, den)   -> list [num, den]   reduce ratio by GCD
// ============================================================================

// ── private: GCD (Euclidean) ─────────────────────────────────────────────────

fn _ji_gcd(a, b)
    let x = a
    let y = b
    while y != 0
        let t = y
        y = x - (x / y) * y
        x = t
    x

// ── public API ───────────────────────────────────────────────────────────────

// just_ratio(name) -> list [num, den]
//   Return the just-intonation ratio for the named interval as a 2-element list
//   [numerator, denominator] in lowest terms.
//   Returns [1, 1] for unrecognised names.
fn just_ratio(name)
    let result = [1, 1]
    if name == "P1"
        result = [1, 1]
    else if name == "m2"
        result = [16, 15]
    else if name == "M2"
        result = [9, 8]
    else if name == "m3"
        result = [6, 5]
    else if name == "M3"
        result = [5, 4]
    else if name == "P4"
        result = [4, 3]
    else if name == "TT"
        result = [45, 32]
    else if name == "P5"
        result = [3, 2]
    else if name == "m6"
        result = [8, 5]
    else if name == "M6"
        result = [5, 3]
    else if name == "m7"
        result = [9, 5]
    else if name == "M7"
        result = [15, 8]
    else if name == "P8"
        result = [2, 1]
    result

// just_cents(name) -> int
//   Return the precomputed cents value (rounded to nearest integer) for the
//   named just-intonation interval.
//   Returns 0 for unrecognised names.
fn just_cents(name)
    let c = 0
    if name == "P1"
        c = 0
    else if name == "m2"
        c = 112
    else if name == "M2"
        c = 204
    else if name == "m3"
        c = 316
    else if name == "M3"
        c = 386
    else if name == "P4"
        c = 498
    else if name == "TT"
        c = 590
    else if name == "P5"
        c = 702
    else if name == "m6"
        c = 814
    else if name == "M6"
        c = 884
    else if name == "m7"
        c = 1018
    else if name == "M7"
        c = 1088
    else if name == "P8"
        c = 1200
    c

// ratio_to_cents(num, den) -> int
//   Compute cents for any ratio num/den using the formula:
//   round(1200 * log2(num / den)).
//   Handles unison (num == den) without floating-point: returns 0.
//   FLOAT HAZARD: all intermediate float results bound to named lets.
fn ratio_to_cents(num, den)
    let result = 0
    if num == den
        result = 0
    else
        let fnum = num * 1.0
        let fden = den * 1.0
        let ratio = fnum / fden
        let lg = log2(ratio)
        let cents_f = 1200.0 * lg
        result = round(cents_f)
    result

// ratio_reduce(num, den) -> list [num, den]
//   Return the ratio num/den reduced to lowest terms by dividing both by GCD.
//   If den is 0, returns [num, 0] unchanged.
fn ratio_reduce(num, den)
    let result = [num, den]
    if den != 0
        let g = _ji_gcd(num, den)
        if g > 1
            result = [num / g, den / g]
    result
