// ============================================================================
// NOVA Standard Library — std/music/interval
// ============================================================================
// Interval arithmetic between MIDI note numbers.
//
// Convention:
//   MIDI note numbers: C4=60, A4=69.
//   Pitch class = note % 12 (C=0, C#=1, D=2, D#=3, E=4, F=5,
//                             F#=6, G=7, G#=8, A=9, A#=10, B=11).
//   Intervals measured in semitones (0..12 for within one octave).
//
// PUBLIC API
//   interval(a, b)          -> int    semitones between a and b (absolute)
//   interval_name(semis)    -> string name for 0..12 ("P1","m2","M2","m3",
//                                      "M3","P4","TT","P5","m6","M6","m7",
//                                      "M7","P8"); "?" for out-of-range
//   interval_semitones(name)-> int    inverse of interval_name; -1 if unknown
//   interval_invert(semis)  -> int    12 - semis  (interval inversion)
//   is_consonant(semis)     -> int    1 if consonant (P1/m3/M3/P4/P5/m6/M6/P8)
//                                     0 otherwise
// ============================================================================

// ── public API ───────────────────────────────────────────────────────────────

// interval(a, b) -> int
//   Return the absolute interval in semitones between MIDI notes a and b.
//   The result is always >= 0; order of a and b does not matter.
fn interval(a, b)
    let d = a - b
    if d < 0
        d = -d
    d

// interval_name(semis) -> string
//   Return the standard name for an interval given its size in semitones.
//   semis in 0..12; returns "?" for any other value.
fn interval_name(semis)
    let name = "?"
    if semis == 0
        name = "P1"
    else if semis == 1
        name = "m2"
    else if semis == 2
        name = "M2"
    else if semis == 3
        name = "m3"
    else if semis == 4
        name = "M3"
    else if semis == 5
        name = "P4"
    else if semis == 6
        name = "TT"
    else if semis == 7
        name = "P5"
    else if semis == 8
        name = "m6"
    else if semis == 9
        name = "M6"
    else if semis == 10
        name = "m7"
    else if semis == 11
        name = "M7"
    else if semis == 12
        name = "P8"
    name

// interval_semitones(name) -> int
//   Inverse of interval_name: return semitones for a named interval.
//   Returns -1 for an unrecognised name.
fn interval_semitones(name)
    let semis = -1
    if name == "P1"
        semis = 0
    else if name == "m2"
        semis = 1
    else if name == "M2"
        semis = 2
    else if name == "m3"
        semis = 3
    else if name == "M3"
        semis = 4
    else if name == "P4"
        semis = 5
    else if name == "TT"
        semis = 6
    else if name == "P5"
        semis = 7
    else if name == "m6"
        semis = 8
    else if name == "M6"
        semis = 9
    else if name == "m7"
        semis = 10
    else if name == "M7"
        semis = 11
    else if name == "P8"
        semis = 12
    semis

// interval_invert(semis) -> int
//   Return the inversion of an interval within the octave: 12 - semis.
//   E.g. M3 (4) inverts to m6 (8); P5 (7) inverts to P4 (5).
fn interval_invert(semis)
    12 - semis

// is_consonant(semis) -> int
//   Return 1 if the interval is consonant, 0 if dissonant.
//   Consonant intervals: P1(0), m3(3), M3(4), P4(5), P5(7), m6(8), M6(9), P8(12).
//   Dissonant: m2(1), M2(2), TT(6), m7(10), M7(11) and all others.
fn is_consonant(semis)
    let result = 0
    if semis == 0
        result = 1
    else if semis == 3
        result = 1
    else if semis == 4
        result = 1
    else if semis == 5
        result = 1
    else if semis == 7
        result = 1
    else if semis == 8
        result = 1
    else if semis == 9
        result = 1
    else if semis == 12
        result = 1
    result
