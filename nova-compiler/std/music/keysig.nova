// ============================================================================
// NOVA Standard Library — std/music/keysig
// ============================================================================
// Key signatures: sharps/flats count, accidental note names, relative minor,
// relative major, and parallel minor.
//
// CONVENTION
//   - key names use standard notation: "C", "G", "D", "F", "Bb", "Eb", etc.
//   - Sharps count: positive = sharps, negative = flats, 0 = C major (no acc.)
//   - Sharps order (added one by one): F# C# G# D# A# E# B#
//   - Flats order  (added one by one): Bb Eb Ab Db Gb Cb Fb
//
// PUBLIC API
//   key_sharps(key)        -> int    number of sharps (neg = flats); -99 = unknown
//   key_accidentals(key)   -> list   sharp/flat note names in signature order
//   relative_minor(major)  -> str    e.g. relative_minor("C") == "Am"
//   relative_major(minor)  -> str    e.g. relative_major("Am") == "C"
//   parallel_minor(key)    -> str    e.g. parallel_minor("C") == "Cm"
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _ks_sharps_for(key) -> int
//   Returns the sharp count for a major key name, or -99 if unrecognised.
fn _ks_sharps_for(key)
    let n = -99
    if key == "C"
        n = 0
    else if key == "G"
        n = 1
    else if key == "D"
        n = 2
    else if key == "A"
        n = 3
    else if key == "E"
        n = 4
    else if key == "B"
        n = 5
    else if key == "F#"
        n = 6
    else if key == "C#"
        n = 7
    else if key == "F"
        n = -1
    else if key == "Bb"
        n = -2
    else if key == "Eb"
        n = -3
    else if key == "Ab"
        n = -4
    else if key == "Db"
        n = -5
    else if key == "Gb"
        n = -6
    else if key == "Cb"
        n = -7
    n

// ── public API ───────────────────────────────────────────────────────────────

// key_sharps(key) -> int
//   Returns the number of sharps (positive) or flats (negative as negative int)
//   for the given major key. Returns -99 if the key is unrecognised.
//   Examples: key_sharps("C")==0, key_sharps("G")==1, key_sharps("F")==-1.
fn key_sharps(key)
    _ks_sharps_for(key)

// key_accidentals(key) -> list
//   Returns the list of accidental note names (sharps or flats) that appear in
//   the key signature, in the canonical order they are written on the staff.
//   Sharps order: F# C# G# D# A# E# B#
//   Flats  order: Bb Eb Ab Db Gb Cb Fb
//   Returns empty list for C major (no accidentals). Returns [] for unknown key.
fn key_accidentals(key)
    let count = _ks_sharps_for(key)
    let result = []
    if count == 0 or count == -99
        result = result
    else if count > 0
        // sharps: F# C# G# D# A# E# B#  — add the first `count` of these
        let sharps = []
        push(sharps, "F#")
        push(sharps, "C#")
        push(sharps, "G#")
        push(sharps, "D#")
        push(sharps, "A#")
        push(sharps, "E#")
        push(sharps, "B#")
        for i in 0..count
            push(result, sharps[i])
    else
        // flats: Bb Eb Ab Db Gb Cb Fb — add the first `abs(count)` of these
        let flats = []
        push(flats, "Bb")
        push(flats, "Eb")
        push(flats, "Ab")
        push(flats, "Db")
        push(flats, "Gb")
        push(flats, "Cb")
        push(flats, "Fb")
        let n = -count
        for i in 0..n
            push(result, flats[i])
    result

// relative_minor(major_key) -> str
//   Returns the relative minor key name for a major key.
//   The relative minor is rooted 3 semitones below the major tonic (a minor 3rd).
//   Written with standard minor key names (e.g. "Am", "Em", "F#m").
//   Returns "" if the major key is unrecognised.
fn relative_minor(major_key)
    let result = ""
    if major_key == "C"
        result = "Am"
    else if major_key == "G"
        result = "Em"
    else if major_key == "D"
        result = "Bm"
    else if major_key == "A"
        result = "F#m"
    else if major_key == "E"
        result = "C#m"
    else if major_key == "B"
        result = "G#m"
    else if major_key == "F#"
        result = "D#m"
    else if major_key == "C#"
        result = "A#m"
    else if major_key == "F"
        result = "Dm"
    else if major_key == "Bb"
        result = "Gm"
    else if major_key == "Eb"
        result = "Cm"
    else if major_key == "Ab"
        result = "Fm"
    else if major_key == "Db"
        result = "Bbm"
    else if major_key == "Gb"
        result = "Ebm"
    else if major_key == "Cb"
        result = "Abm"
    result

// relative_major(minor_key) -> str
//   Returns the relative major key name for a minor key.
//   The relative major is rooted 3 semitones above the minor tonic.
//   Minor key names must end in "m" (e.g. "Am", "Em", "F#m").
//   Returns "" if the minor key is unrecognised.
fn relative_major(minor_key)
    let result = ""
    if minor_key == "Am"
        result = "C"
    else if minor_key == "Em"
        result = "G"
    else if minor_key == "Bm"
        result = "D"
    else if minor_key == "F#m"
        result = "A"
    else if minor_key == "C#m"
        result = "E"
    else if minor_key == "G#m"
        result = "B"
    else if minor_key == "D#m"
        result = "F#"
    else if minor_key == "A#m"
        result = "C#"
    else if minor_key == "Dm"
        result = "F"
    else if minor_key == "Gm"
        result = "Bb"
    else if minor_key == "Cm"
        result = "Eb"
    else if minor_key == "Fm"
        result = "Ab"
    else if minor_key == "Bbm"
        result = "Db"
    else if minor_key == "Ebm"
        result = "Gb"
    else if minor_key == "Abm"
        result = "Cb"
    result

// parallel_minor(key) -> str
//   Returns the parallel (same-tonic) minor key name for a major key.
//   E.g. parallel_minor("C") == "Cm", parallel_minor("G") == "Gm".
//   The parallel minor shares the same root note but uses a different key signature.
//   Returns "" if the major key is unrecognised.
fn parallel_minor(key)
    let result = ""
    if key == "C"
        result = "Cm"
    else if key == "G"
        result = "Gm"
    else if key == "D"
        result = "Dm"
    else if key == "A"
        result = "Am"
    else if key == "E"
        result = "Em"
    else if key == "B"
        result = "Bm"
    else if key == "F#"
        result = "F#m"
    else if key == "C#"
        result = "C#m"
    else if key == "F"
        result = "Fm"
    else if key == "Bb"
        result = "Bbm"
    else if key == "Eb"
        result = "Ebm"
    else if key == "Ab"
        result = "Abm"
    else if key == "Db"
        result = "Dbm"
    else if key == "Gb"
        result = "Gbm"
    else if key == "Cb"
        result = "Cbm"
    result
