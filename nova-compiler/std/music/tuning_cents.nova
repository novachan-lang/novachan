// ============================================================================
// NOVA Standard Library — std/music/tuning_cents
// ============================================================================
// Cents arithmetic: integer cents values, integer-pair ratios.
//
// One cent = 1/100 of an equal-temperament semitone = 1/1200 of an octave.
// All returned cent values are rounded integers. Frequency ratios are
// returned as [num, den] int-pair lists (small integers, denominator <= 128).
//
// FLOAT HAZARD: bind every intermediate float to a named let before use.
// Never return a bare multi-term float expression (uninit-slot compiler bug).
//
// PUBLIC API
//   cents_from_ratio(num, den) -> int
//       round(1200 * log2(num/den)); e.g. (2,1)->1200, (3,2)->702
//   cents_add(a, b) -> int
//       a + b (integer addition; preserved for symmetry with future ops)
//   cents_to_ratio_approx(cents) -> list [num, den]
//       Best small-integer rational approximation of 2^(cents/1200),
//       denominator <= 128 (Stern-Brocot tree search).
//   interval_cents(freq_a, freq_b) -> int
//       round(1200 * log2(freq_b / freq_a)); both freqs positive ints/floats.
//   is_octave(cents) -> bool
//       True iff cents is an exact multiple of 1200.
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _log2_ratio(num_f, den_f) -> float
//   Compute log2(num_f / den_f) via change-of-base: log(num_f/den_f)/log(2).
//   FLOAT HAZARD: all intermediates bound to named lets.
fn _log2_ratio(num_f, den_f)
    let ratio_f = num_f / den_f
    let ln_ratio = log(ratio_f)
    let ln2 = log(2.0)
    let result = ln_ratio / ln2
    result

// _abs_int(x) -> int
//   Absolute value for integers.
fn _abs_int(x)
    let r = x
    if x < 0
        r = 0 - x
    r

// ── public API ───────────────────────────────────────────────────────────────

// cents_from_ratio(num, den) -> int
//   Return the interval in cents for the frequency ratio num:den,
//   rounded to the nearest integer.
//   Examples: (2,1)->1200, (3,2)->702, (4,3)->498, (1,1)->0, (4,1)->2400.
//   Requires num > 0, den > 0.
fn cents_from_ratio(num, den)
    let nf = num * 1.0
    let df = den * 1.0
    let l2 = _log2_ratio(nf, df)
    let cents_f = 1200.0 * l2
    let result = round(cents_f)
    result

// cents_add(a, b) -> int
//   Add two cent values. Integer addition; provided for API symmetry.
fn cents_add(a, b)
    a + b

// cents_to_ratio_approx(cents) -> list [num, den]
//   Find the best rational approximation p/q (denominator <= 128) of
//   the exact ratio 2^(cents/1200) using a Stern-Brocot tree search.
//   Returns a list [p, q] where p and q are positive integers.
//   Examples: 1200->[2,1], 702->[3,2], 0->[1,1], 386->[5,4].
fn cents_to_ratio_approx(cents)
    // Compute the float target: 2^(cents/1200).
    let cents_f = cents * 1.0
    let exp_f = cents_f / 1200.0
    let target = pow(2.0, exp_f)
    // Stern-Brocot tree: start with mediant between 0/1 and 1/0.
    // We search for best p/q with q <= 128.
    // Left bound: lo_p/lo_q = 0/1  (represents 0)
    // Right bound: hi_p/hi_q = 1/0 (represents +inf, tracked as ceiling)
    // We track the best approximation found so far.
    let lo_p = 0
    let lo_q = 1
    let hi_p = 1
    let hi_q = 0
    let best_p = 1
    let best_q = 1
    // Initial best error: |target - 1.0| in float, scaled for comparison.
    // We compare errors as float differences; bind each to a let.
    let best_err = target
    if best_err < 0.0
        best_err = 0.0 - best_err
    // Subtract 1.0 from initial best (1/1) error estimate.
    let init_diff = target - 1.0
    if init_diff < 0.0
        best_err = 0.0 - init_diff
    else
        best_err = init_diff
    // Stern-Brocot iteration: up to 256 steps.
    let steps = 0
    let done = 0
    while steps < 256 and done == 0
        // Compute mediant med_p/med_q.
        let med_p = lo_p + hi_p
        let med_q = lo_q + hi_q
        // If denominator exceeds limit, stop.
        if med_q > 128
            done = 1
        else
            // Compare mediant to target: is med_p/med_q < target?
            // i.e. med_p < target * med_q  (both positive)
            let med_f = med_p * 1.0 / med_q
            let diff = med_f - target
            let adiff = diff
            if diff < 0.0
                adiff = 0.0 - diff
            // Update best if this mediant is closer.
            if adiff < best_err
                best_err = adiff
                best_p = med_p
                best_q = med_q
            // Decide direction.
            if med_f < target
                // Mediant is too small; go right.
                lo_p = med_p
                lo_q = med_q
            else if med_f > target
                // Mediant is too large; go left.
                hi_p = med_p
                hi_q = med_q
            else
                // Exact match; stop.
                done = 1
        steps += 1
    let result = []
    push(result, best_p)
    push(result, best_q)
    result

// interval_cents(freq_a, freq_b) -> int
//   Return the interval in cents between two frequencies (positive integers).
//   Result = round(1200 * log2(freq_b / freq_a)).
//   E.g. interval_cents(440, 880) == 1200 (one octave).
fn interval_cents(freq_a, freq_b)
    let af = freq_a * 1.0
    let bf = freq_b * 1.0
    let l2 = _log2_ratio(bf, af)
    let cents_f = 1200.0 * l2
    let result = round(cents_f)
    result

// is_octave(cents) -> bool
//   Return true iff cents is an exact multiple of 1200.
//   E.g. is_octave(1200)==true, is_octave(2400)==true, is_octave(700)==false.
fn is_octave(cents)
    let rem = cents - (cents / 1200) * 1200
    rem == 0
