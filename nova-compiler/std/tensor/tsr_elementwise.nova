// std/tensor/tsr_elementwise.nova — Elementwise integer tensor operations.
//
// Tensor representation: [flat, shape] where flat is a row-major flat int list and
// shape is a list of ints (dimension sizes). All operations require identical shapes.
//
// All public functions prefixed te_.
//
// Public API:
//   te_add(a, b)      -> tensor  elementwise addition (requires same shape)
//   te_sub(a, b)      -> tensor  elementwise subtraction (requires same shape)
//   te_mul(a, b)      -> tensor  elementwise (Hadamard) product (requires same shape)
//   te_scale(a, s)    -> tensor  multiply every element by scalar int s
//   te_neg(a)         -> tensor  negate every element
//   te_equal(a, b)    -> bool    same shape AND same flat data

// _te_shapes_match — true iff two shape lists are identical.
fn _te_shapes_match(sa: any, sb: any) -> bool
    let na = len(sa)
    let nb = len(sb)
    if na != nb
        return false
    for i in 0..na
        if sa[i] != sb[i]
            return false
    true

// _te_empty_tensor — return a zero tensor with the given shape.
fn _te_empty_tensor(shape: any) -> any
    let n = len(shape)
    let size = 1
    for i in 0..n
        size *= shape[i]
    let flat = [0 for k in 0..size]
    [flat, shape]

// te_add — elementwise addition; returns a if shapes differ.
fn te_add(a: any, b: any) -> any
    let fa = a[0]
    let sa = a[1]
    let fb = b[0]
    let sb = b[1]
    if not _te_shapes_match(sa, sb)
        return a
    let size = len(fa)
    [[fa[i] + fb[i] for i in 0..size], sa]

// te_sub — elementwise subtraction; returns a if shapes differ.
fn te_sub(a: any, b: any) -> any
    let fa = a[0]
    let sa = a[1]
    let fb = b[0]
    let sb = b[1]
    if not _te_shapes_match(sa, sb)
        return a
    let size = len(fa)
    [[fa[i] - fb[i] for i in 0..size], sa]

// te_mul — elementwise (Hadamard) product; returns a if shapes differ.
fn te_mul(a: any, b: any) -> any
    let fa = a[0]
    let sa = a[1]
    let fb = b[0]
    let sb = b[1]
    if not _te_shapes_match(sa, sb)
        return a
    let size = len(fa)
    [[fa[i] * fb[i] for i in 0..size], sa]

// te_scale — multiply every element by scalar int s.
fn te_scale(a: any, s: int) -> any
    let fa = a[0]
    let sa = a[1]
    let size = len(fa)
    [[fa[i] * s for i in 0..size], sa]

// te_neg — negate every element.
fn te_neg(a: any) -> any
    let fa = a[0]
    let sa = a[1]
    let size = len(fa)
    let out = [-fa[i] for i in 0..size]
    [out, sa]

// te_equal — true iff a and b have the same shape and identical flat data.
fn te_equal(a: any, b: any) -> bool
    let fa = a[0]
    let sa = a[1]
    let fb = b[0]
    let sb = b[1]
    if not _te_shapes_match(sa, sb)
        return false
    let size = len(fa)
    for i in 0..size
        if fa[i] != fb[i]
            return false
    true
