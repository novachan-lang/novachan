// ============================================================================
// NOVA Standard Library — std/tensor/tsr_index
// ============================================================================
// N-dimensional integer tensor indexing: strides, ravel/unravel, get/set.
//
// Tensor representation: [flat, shape]  where
//   flat  = flat list of ints in row-major (C) order
//   shape = list of dimension sizes
//
// Row-major strides for shape s of length n:
//   stride[k] = product(s[k+1], ..., s[n-1])   (stride[n-1] = 1, stride[] = [])
//
// All arithmetic is integer-exact. No floats.
//
// Public API (prefix ti_):
//   ti_strides(shape)         -> list   row-major strides for shape
//   ti_ravel(shape, idx)      -> int    multi-index -> flat offset
//   ti_unravel(shape, offset) -> list   flat offset -> multi-index
//   ti_get(t, idx)            -> int    element at multi-index (list of ints)
//   ti_set(t, idx, v)         -> any    new tensor with element replaced
//
// LEAF — imports nothing.
// ============================================================================

// ti_strides computes row-major strides for shape.
// stride[k] = product of shape[k+1 ..].  For a 1-D shape [n] -> [1].
// For empty shape (scalar) -> [].
fn ti_strides(shape) -> any
    let n = len(shape)
    let strides = [0 for i in 0..n]
    // fill from the right
    let k = n - 1
    let p = 1
    while k >= 0
        strides[k] = p
        p = p * shape[k]
        k = k - 1
    strides

// ti_ravel converts a multi-index (list of ints) to a flat offset.
// Uses row-major: offset = sum(idx[k] * stride[k]).
fn ti_ravel(shape, idx) -> int
    let n = len(shape)
    let strides = ti_strides(shape)
    let off = 0
    let k = 0
    while k < n
        off = off + idx[k] * strides[k]
        k = k + 1
    off

// ti_unravel converts a flat offset to a multi-index for shape.
// Uses row-major: idx[k] = (offset / stride[k]) % shape[k].
fn ti_unravel(shape, offset) -> any
    let n = len(shape)
    let strides = ti_strides(shape)
    let idx = []
    let rem = offset
    for k in 0..n
        let s = strides[k]
        let q = rem / s
        rem = rem - q * s
        push(idx, q)
    idx

// ti_get returns the integer element of tensor t at multi-index idx.
fn ti_get(t, idx) -> int
    let flat = t[0]
    let shape = t[1]
    let off = ti_ravel(shape, idx)
    flat[off]

// ti_set returns a NEW tensor identical to t but with element at idx replaced by v.
// The original tensor is not modified.
fn ti_set(t, idx, v) -> any
    let old_flat = t[0]
    let shape = t[1]
    let off = ti_ravel(shape, idx)
    let n = len(old_flat)
    let new_flat = [old_flat[i] for i in 0..n]
    new_flat[off] = v
    let result = []
    push(result, new_flat)
    push(result, shape)
    result

fn main()
    print("std/tensor/tsr_index loaded")
