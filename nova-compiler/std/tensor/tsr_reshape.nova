// ============================================================================
// NOVA Standard Library — std/tensor/tsr_reshape
// ============================================================================
// N-dimensional integer tensor shape manipulation.
//
// Tensor representation: [flat, shape]  where
//   flat  = flat list of ints in row-major (C) order
//   shape = list of dimension sizes
//
// Reshape operations share the SAME flat data when safe (new_shape same total
// size); set operations always produce a new tensor.
//
// All arithmetic is integer-exact. No floats.
//
// Public API (prefix tr_):
//   tr_reshape(t, new_shape)  -> tensor  view with new shape (same flat)
//   tr_flatten(t)             -> tensor  1-D tensor, shape [size]
//   tr_ravel(t)               -> list    the raw flat int list
//   tr_expand_dims(t, axis)   -> tensor  insert a size-1 dim at axis
//   tr_squeeze(t)             -> tensor  remove all size-1 dimensions
//
// LEAF — imports nothing.
// ============================================================================

// _tr_product computes the product of a shape list (1 for empty).
fn _tr_product(shape) -> int
    let n = len(shape)
    let p = 1
    for i in 0..n
        p = p * shape[i]
    p

// _tr_copy_flat returns a copy of a flat list.
fn _tr_copy_flat(flat) -> any
    let n = len(flat)
    let out = []
    for i in 0..n
        push(out, flat[i])
    out

// _tr_copy_shape returns a copy of a shape list.
fn _tr_copy_shape(shape) -> any
    let n = len(shape)
    let out = [shape[i] for i in 0..n]
    out

// tr_reshape returns a tensor with new_shape but the same flat data.
// If the total size does not match the original, returns the original unchanged.
fn tr_reshape(t, new_shape) -> any
    let flat = t[0]
    let old_shape = t[1]
    let old_sz = _tr_product(old_shape)
    let new_sz = _tr_product(new_shape)
    if old_sz != new_sz
        return t
    let result = []
    push(result, flat)
    push(result, new_shape)
    result

// tr_flatten returns a 1-D tensor with all elements in row-major order.
fn tr_flatten(t) -> any
    let flat = t[0]
    let old_shape = t[1]
    let sz = _tr_product(old_shape)
    let new_shape = []
    push(new_shape, sz)
    let result = []
    push(result, flat)
    push(result, new_shape)
    result

// tr_ravel returns the raw flat int list of the tensor.
fn tr_ravel(t) -> any
    t[0]

// tr_expand_dims inserts a size-1 dimension at position axis.
// axis is clamped to [0, ndim].
fn tr_expand_dims(t, axis) -> any
    let flat = t[0]
    let shape = t[1]
    let ndim = len(shape)
    // clamp axis
    let ax = axis
    if ax < 0
        ax = 0
    if ax > ndim
        ax = ndim
    let new_shape = []
    let i = 0
    while i < ax
        push(new_shape, shape[i])
        i = i + 1
    push(new_shape, 1)
    while i < ndim
        push(new_shape, shape[i])
        i = i + 1
    let result = []
    push(result, flat)
    push(result, new_shape)
    result

// tr_squeeze removes all size-1 dimensions from a tensor.
fn tr_squeeze(t) -> any
    let flat = t[0]
    let shape = t[1]
    let n = len(shape)
    let new_shape = [shape[i] for i in 0..n if shape[i] != 1]
    let result = []
    push(result, flat)
    push(result, new_shape)
    result

fn main()
    print("std/tensor/tsr_reshape loaded")
