// std/tensor/tsr_reduce.nova — reduction operations on integer tensors.
// Tensor representation: t = [flat, shape] where flat is a flat list of ints
// in row-major (C) order and shape is a list of ints (dimension sizes).
// Examples: 2x3 matrix [[1,2,3],[4,5,6]] -> [[1,2,3,4,5,6],[2,3]].
//           scalar 7 -> [[7],[]].  1-D vector [1,2,3] -> [[1,2,3],[3]].
// LEAF — imports NOTHING.
//
// API:
//   td_sum(t)          -> int   sum of ALL elements
//   td_prod(t)         -> int   product of ALL elements (1 for empty)
//   td_max(t)          -> int   maximum element (0 for empty)
//   td_min(t)          -> int   minimum element (0 for empty)
//   td_argmax(t)       -> int   flat index of the maximum element (0 for empty)
//   td_sum_axis(t,axis)-> tensor reduce 2-D tensor along axis (0=rows->col sums, 1=cols->row sums)
//   td_mean_floor(t)   -> int   floor(sum(all) / size); 0 for empty

// Sum of all elements in the flat list.
fn td_sum(t) -> int
    let flat = t[0]
    let n = len(flat)
    let s = 0
    for i in 0..n
        s += flat[i]
    s

// Product of all elements; empty tensor returns 1.
fn td_prod(t) -> int
    let flat = t[0]
    let n = len(flat)
    let p = 1
    for i in 0..n
        p = p * flat[i]
    p

// Maximum element; returns 0 for empty tensor.
fn td_max(t) -> int
    let flat = t[0]
    let n = len(flat)
    if n == 0
        return 0
    let m = flat[0]
    for i in 1..n
        if flat[i] > m
            m = flat[i]
    m

// Minimum element; returns 0 for empty tensor.
fn td_min(t) -> int
    let flat = t[0]
    let n = len(flat)
    if n == 0
        return 0
    let m = flat[0]
    for i in 1..n
        if flat[i] < m
            m = flat[i]
    m

// Flat index of the maximum element; returns 0 for empty tensor.
fn td_argmax(t) -> int
    let flat = t[0]
    let n = len(flat)
    if n == 0
        return 0
    let best = flat[0]
    let idx = 0
    for i in 1..n
        if flat[i] > best
            best = flat[i]
            idx = i
    idx

// Reduce a 2-D tensor along the given axis.
//   axis=0: sum across rows -> result shape [ncols]  (column sums)
//   axis=1: sum across cols -> result shape [nrows]  (row sums)
// Returns a 1-D tensor. Falls back to the original tensor if ndim != 2.
fn td_sum_axis(t, axis: int) -> list
    let flat = t[0]
    let shape = t[1]
    if len(shape) != 2
        return t
    let nrows = shape[0]
    let ncols = shape[1]
    if axis == 0
        // column sums: result has ncols elements
        let out = []
        for j in 0..ncols
            let s = 0
            let i = 0
            while i < nrows
                s += flat[i * ncols + j]
                i += 1
            push(out, s)
        let rshape = []
        push(rshape, ncols)
        let res = []
        push(res, out)
        push(res, rshape)
        return res
    // axis == 1: row sums; result has nrows elements
    let out = []
    for i in 0..nrows
        let s = 0
        let j = 0
        while j < ncols
            s += flat[i * ncols + j]
            j += 1
        push(out, s)
    let rshape = []
    push(rshape, nrows)
    let res = []
    push(res, out)
    push(res, rshape)
    res

// Integer floor of sum / size; 0 for empty tensor.
fn td_mean_floor(t) -> int
    let flat = t[0]
    let n = len(flat)
    if n == 0
        return 0
    let s = td_sum(t)
    s / n
