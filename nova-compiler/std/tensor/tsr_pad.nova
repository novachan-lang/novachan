// std/tensor/tsr_pad.nova — padding, rolling, flipping, and tiling for integer tensors.
// Tensor representation: [flat, shape] where flat is a flat int list in
// row-major (C) order and shape is a list of ints (dimension sizes).
// LEAF — imports NOTHING. All arithmetic is exact integer.
//
// Public API (PREFIX tp_):
//   tp_pad(t, width, value)  -> 2-D: add a uniform border of `width` filled with `value`
//   tp_roll(t, shift)        -> 1-D: circular shift right by `shift`
//   tp_flip(t, axis)         -> reverse along an axis (1-D or 2-D)
//   tp_tile(t, reps)         -> 1-D: repeat the flat data `reps` times

// tp_pad: add a uniform border of `width` cells filled with `value` around a 2-D tensor.
// Input must have ndim >= 2; shape [R, C] -> shape [R+2*width, C+2*width].
// For non-2D input returns a copy unchanged.
fn tp_pad(t: list, width: int, value: int) -> list
    let flat = t[0]
    let shape = t[1]
    let nd = len(shape)
    if nd < 2
        let out_flat = []
        for i in 0..len(flat)
            push(out_flat, flat[i])
        let out_shape = []
        let k = 0
        while k < nd
            push(out_shape, shape[k])
            k += 1
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    let rows = shape[0]
    let cols = shape[1]
    let new_rows = rows + width * 2
    let new_cols = cols + width * 2
    let out_flat = []
    let total = new_rows * new_cols
    for i in 0..total
        let r = i / new_cols
        let c = i % new_cols
        // Is this cell inside the original data region?
        if r < width or r >= rows + width or c < width or c >= cols + width
            push(out_flat, value)
        else
            let src_r = r - width
            let src_c = c - width
            push(out_flat, flat[src_r * cols + src_c])
    let out_shape = []
    push(out_shape, new_rows)
    push(out_shape, new_cols)
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res

// tp_roll: circular shift a 1-D tensor right by `shift` positions.
// Element at position k moves to position (k + shift) % n.
// Normalizes shift to [0, n) via modulo. Returns a new tensor.
fn tp_roll(t: list, shift: int) -> list
    let flat = t[0]
    let shape = t[1]
    let n = len(flat)
    let out_flat = []
    let out_shape = []
    if n == 0
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        push(out_shape, 0)
        let res2 = []
        push(res2, out_flat)
        push(res2, out_shape)
        return res2
    // Normalize shift to be in [0, n).
    let s = shift % n
    if s < 0
        s += n
    // pre-fill output with zeros then fill by source position
    let i = 0
    while i < n
        push(out_flat, 0)
        i += 1
    i = 0
    while i < n
        let dest = (i + s) % n
        out_flat[dest] = flat[i]
        i += 1
    for k in 0..len(shape)
        push(out_shape, shape[k])
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res

// tp_flip: reverse elements along a given axis.
// For 1-D tensors (ndim=1), axis=0 reverses all elements.
// For 2-D tensors: axis=0 reverses row order; axis=1 reverses column order within each row.
// For other ndim or invalid axis, returns a copy unchanged.
fn tp_flip(t: list, axis: int) -> list
    let flat = t[0]
    let shape = t[1]
    let nd = len(shape)
    let out_flat = []
    let out_shape = []
    for k in 0..nd
        push(out_shape, shape[k])
    let n = len(flat)
    if nd == 1
        if axis == 0
            let i = n - 1
            while i >= 0
                push(out_flat, flat[i])
                i -= 1
        else
            // invalid axis for 1-D, return copy
            for i in 0..n
                push(out_flat, flat[i])
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    if nd == 2
        let rows = shape[0]
        let cols = shape[1]
        if axis == 0
            // reverse row order: row 0 becomes last row
            let r = rows - 1
            while r >= 0
                for c in 0..cols
                    push(out_flat, flat[r * cols + c])
                r -= 1
        else
            // axis == 1: reverse column order within each row
            for r in 0..rows
                let c = cols - 1
                while c >= 0
                    push(out_flat, flat[r * cols + c])
                    c -= 1
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    // For higher-dimensional tensors, return copy unchanged
    for i in 0..n
        push(out_flat, flat[i])
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res

// tp_tile: repeat a 1-D tensor's flat data `reps` times end-to-end.
// Result shape is [n * reps] for a 1-D input of length n.
// For non-1D input or reps<=0, returns a copy or empty tensor.
fn tp_tile(t: list, reps: int) -> list
    let flat = t[0]
    let shape = t[1]
    let n = len(flat)
    let out_flat = []
    let out_shape = []
    if reps <= 0 or n == 0
        push(out_shape, 0)
        let res = []
        push(res, out_flat)
        push(res, out_shape)
        return res
    for r in 0..reps
        let i = 0
        while i < n
            push(out_flat, flat[i])
            i += 1
    push(out_shape, n * reps)
    let res = []
    push(res, out_flat)
    push(res, out_shape)
    res
