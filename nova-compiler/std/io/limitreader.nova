// std/io/limitreader — Reads at most N chars total from a backing string.
// lr_new(s, limit)->dict; lr_read(r,n)->string; lr_remaining(r)->int;
// lr_exhausted(r)->bool; lr_read_all(r)->string.
// Private helpers prefixed _lim_ to avoid cross-module collisions.

fn lr_new(s, limit)
    let r = {"s": s, "pos": 0, "limit": limit}
    return r

fn _lim_available(r) -> int
    let slen = len(r["s"])
    let pos = r["pos"]
    let rem_in_s = slen - pos
    let lim = r["limit"]
    let used = pos
    let lim_left_raw = lim - used
    let lim_left = 0 if lim_left_raw < 0 else lim_left_raw
    rem_in_s if rem_in_s < lim_left else lim_left

fn lr_read(r, n) -> string
    let avail = _lim_available(r)
    let take = avail if avail < n else n
    if take <= 0
        return ""
    let pos = r["pos"]
    let chunk = slice(r["s"], pos, pos + take)
    r["pos"] = pos + take
    return chunk

fn lr_remaining(r) -> int
    let lim = r["limit"]
    let pos = r["pos"]
    let left = lim - pos
    0 if left < 0 else left

fn lr_exhausted(r) -> bool
    let avail = _lim_available(r)
    avail <= 0

fn lr_read_all(r) -> string
    let avail = _lim_available(r)
    if avail <= 0
        return ""
    let pos = r["pos"]
    let chunk = slice(r["s"], pos, pos + avail)
    r["pos"] = pos + avail
    return chunk
