// std/io/csv_writer — incremental CSV writer with a configurable delimiter
// and quote character (RFC 4180 quoting rules).
//
// DUPLICATE-SURVEY NOTE: std/data/csv.nova already has a full RFC 4180
// csv_write(rows) that takes a complete list-of-rows and serializes it with
// a HARD-CODED comma delimiter and double-quote quote character. This
// module is a genuine complement, not a duplicate: it (1) is an INCREMENTAL
// builder (rows are appended one at a time, useful when a caller is
// streaming/generating rows rather than holding the whole document in
// memory up front) and (2) supports a CONFIGURABLE delimiter and quote
// character (e.g. semicolon-delimited or tab-delimited "CSV" dialects, or a
// single-quote quote character) — neither of which std/data/csv.nova or any
// of its siblings (csvdict/csvpivot/csvschema/csvsniff, which all build on
// the same hard-coded comma/quote writer) provide.
//
// Design mirrors std/io/textwriter.nova: the writer is a plain dict (not an
// opaque handle) so callers can inspect it freely; escaping is deferred to
// csvw_to_string() time, so calling csvw_set_delimiter/csvw_set_quote AFTER
// rows have been added still changes how those rows render (the writer
// always reflects its CURRENT settings, not the settings in effect when
// each row was appended).
//
// PUBLIC API (prefix csvw_):
//   csvw_new()                 -> dict   { rows: [], delim: ",", quote: "\"" }
//   csvw_set_delimiter(w, ch)  ->        set the field delimiter (1 char)
//   csvw_set_quote(w, ch)      ->        set the quote character (1 char)
//   csvw_add_row(w, values)    ->        append a row (list of string fields)
//   csvw_to_string(w)          -> string render all rows to CSV text (LF
//                                          row separators, no trailing LF)
//   csvw_row_count(w)          -> int    number of rows appended
//
// A field is quoted iff it contains the current delimiter, the current
// quote character, CR, or LF; an internal quote character is doubled.
// Scans use str_to_bytes/bytes_get (O(1) random access) and accumulate
// output in a buffer() (O(1)-amortized append) rather than char_at-in-a-loop
// or `s = s + c` concatenation, following this stdlib's established
// text-scanning convention (see std/data/csv.nova / std/data/ini.nova for
// the audited rationale: both are O(n^2) traps on realistic input sizes).
//
// LEAF — imports NOTHING.

fn csvw_new() -> dict
    let w = {}
    w["rows"] = []
    w["delim"] = ","
    w["quote"] = chr(34)
    return w

fn csvw_set_delimiter(w: dict, ch: string)
    w["delim"] = ch

fn csvw_set_quote(w: dict, ch: string)
    w["quote"] = ch

// csvw_add_row: append a shallow copy of `values` as a new row.
fn csvw_add_row(w: dict, values: list)
    let rows = w["rows"]
    let copy = [values[i] for i in 0..len(values)]
    push(rows, copy)

fn csvw_row_count(w: dict) -> int
    let rows = w["rows"]
    return len(rows)

// _csvw_needs_quote: true if val contains the delimiter, the quote char,
// CR, or LF (byte codes passed in so the scan never re-derives them).
fn _csvw_needs_quote(val: string, delim_code: int, quote_code: int) -> int
    let bts = str_to_bytes(val)
    let n = bytes_len(bts)
    for i in 0..n
        let c = bytes_get(bts, i)
        if c == delim_code or c == quote_code or c == 13 or c == 10
            return 1
    return 0

// _csvw_escape: quote-and-double val if needed, else return it unchanged.
fn _csvw_escape(val: string, delim_code: int, quote_code: int) -> string
    if _csvw_needs_quote(val, delim_code, quote_code) == 0
        return val
    let bts = str_to_bytes(val)
    let n = bytes_len(bts)
    let buf = buffer()
    buf_append_char(buf, quote_code)
    for i in 0..n
        let c = bytes_get(bts, i)
        if c == quote_code
            buf_append_char(buf, quote_code)
            buf_append_char(buf, quote_code)
        else
            buf_append_char(buf, c)
    buf_append_char(buf, quote_code)
    return buf_to_str(buf)

// csvw_to_string: render every row using the writer's CURRENT delimiter and
// quote settings. Rows are LF-joined; no trailing newline.
fn csvw_to_string(w: dict) -> string
    let rows = w["rows"]
    let delim = w["delim"]
    let quote = w["quote"]
    let delim_code = ord(delim)
    let quote_code = ord(quote)
    let buf = buffer()
    let nr = len(rows)
    for r in 0..nr
        if r > 0
            buf_append_char(buf, 10)
        let row = rows[r]
        let nf = len(row)
        let j = 0
        while j < nf
            if j > 0
                buf_append(buf, delim)
            buf_append(buf, _csvw_escape(row[j], delim_code, quote_code))
            j += 1
    return buf_to_str(buf)

fn main()
    print("std/io/csv_writer loaded")
