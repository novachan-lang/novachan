// std/io/bytebuffer.nova
// Growable binary buffer with a read cursor, backed by native bytes.
// All private helpers are prefixed _bb_ to avoid cross-module collisions.
//
// bb["buf"]  : the native bytes value (grows as data is appended)
// bb["rpos"] : read cursor (index into buf)

fn bb_new()
    let buf = bytes(0)
    let bb = {"buf": buf, "rpos": 0}
    return bb

fn bb_write_byte(bb, b)
    let cur = bb["buf"]
    let next = bytes_append(cur, b)
    bb["buf"] = next

fn bb_write_bytes(bb, bytesval)
    let n = bytes_len(bytesval)
    for i in 0..n
        let b = bytes_get(bytesval, i)
        bb_write_byte(bb, b)

fn bb_write_str(bb, s)
    let sbytes = str_to_bytes(s)
    let n = bytes_len(sbytes)
    for i in 0..n
        let b = bytes_get(sbytes, i)
        bb_write_byte(bb, b)

fn bb_write_u16_le(bb, v)
    let b0 = v & 0xFF
    let b1 = (v >> 8) & 0xFF
    bb_write_byte(bb, b0)
    bb_write_byte(bb, b1)

fn bb_write_u32_le(bb, v)
    let b0 = v & 0xFF
    let b1 = (v >> 8) & 0xFF
    let b2 = (v >> 16) & 0xFF
    let b3 = (v >> 24) & 0xFF
    bb_write_byte(bb, b0)
    bb_write_byte(bb, b1)
    bb_write_byte(bb, b2)
    bb_write_byte(bb, b3)

fn bb_len(bb)
    let cur = bb["buf"]
    return bytes_len(cur)

fn bb_to_bytes(bb)
    return bb["buf"]

fn bb_read_byte(bb)
    let cur = bb["buf"]
    let pos = bb["rpos"]
    let total = bytes_len(cur)
    if pos >= total
        return -1
    let b = bytes_get(cur, pos)
    bb["rpos"] = pos + 1
    return b

fn bb_read_u16_le(bb)
    let lo = bb_read_byte(bb)
    let hi = bb_read_byte(bb)
    if lo < 0
        return -1
    if hi < 0
        return -1
    let v = lo | (hi << 8)
    return v

fn bb_remaining(bb)
    let cur = bb["buf"]
    let pos = bb["rpos"]
    let total = bytes_len(cur)
    let r = total - pos
    if r < 0
        return 0
    return r

fn bb_reset_read(bb)
    bb["rpos"] = 0
