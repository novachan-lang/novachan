// std/io/textwriter — indented string builder (source-code emitter style).
//
// WHAT: A lightweight text accumulator that tracks an indentation level and
//       prepends the correct prefix whenever a "line" is written. Designed for
//       code generators, pretty-printers, and any task that emits structured
//       text with nesting (e.g. compilers, template engines, config writers).
//
// WHY: Building indented output via hand-rolled string concatenation is
//      error-prone and hard to read. A textwriter separates the "what to emit"
//      from the "how deeply to indent", mirroring Python's textwrap.indent or
//      Java's PrintWriter-plus-counter pattern — but zero-allocation until the
//      final tw_str() call (parts accumulate in a list; join happens once).
//
// DESIGN NOTE: The writer is a plain dict, not an opaque handle, so callers
//      can inspect/modify fields (e.g. temporarily change the indent unit)
//      without any ceremony.  All functions are pure-NOVA; no native calls
//      beyond list/string builtins and join().
//
// API:
//   tw_new()             -> dict { parts: [], level: 0, unit: "  " }
//   tw_new_unit(unit)    -> same with a custom indent unit string
//   tw_write(tw, s)      -> append s verbatim (no newline, no indent)
//   tw_writeln(tw, s)    -> append (level*unit) + s + newline
//   tw_line(tw)          -> append a blank newline (no indent)
//   tw_indent(tw)        -> increase level by 1
//   tw_dedent(tw)        -> decrease level by 1 (floor 0)
//   tw_str(tw)           -> join all accumulated parts into one string

// Build the indent prefix string for the current level.
fn _tw_prefix(tw: dict) -> string
    let unit = tw["unit"]
    let level = tw["level"]
    let out_parts = []
    for i in 0..level
        push(out_parts, unit)
    let out = join(out_parts, "")
    out

// ─── Public API ──────────────────────────────────────────────────────────────

// Create a new textwriter with the default two-space indent unit.
fn tw_new() -> dict
    let tw = {}
    tw["parts"] = []
    tw["level"] = 0
    tw["unit"] = "  "
    tw

// Create a new textwriter with a custom indent unit (e.g. "\t" or "    ").
fn tw_new_unit(unit: string) -> dict
    let tw = {}
    tw["parts"] = []
    tw["level"] = 0
    tw["unit"] = unit
    tw

// Append s verbatim — no newline, no indentation prefix.
// Use for continuing a partially-started line or embedding raw content.
fn tw_write(tw: dict, s: string)
    let parts = tw["parts"]
    push(parts, s)

// Append the current indentation prefix + s + a newline character.
// This is the primary emission function for structured text.
fn tw_writeln(tw: dict, s: string)
    let parts = tw["parts"]
    let prefix = _tw_prefix(tw)
    push(parts, prefix + s + chr(10))

// Append a blank line (bare newline, no indentation).
fn tw_line(tw: dict)
    let parts = tw["parts"]
    push(parts, chr(10))

// Increase the indentation level by one step.
fn tw_indent(tw: dict)
    tw["level"] = tw["level"] + 1

// Decrease the indentation level by one step; never goes below zero.
fn tw_dedent(tw: dict)
    let cur = tw["level"]
    if cur > 0
        tw["level"] = cur - 1

// Concatenate all accumulated parts into a single string and return it.
// The writer is not reset — further writes will extend the same document.
fn tw_str(tw: dict) -> string
    let parts = tw["parts"]
    join(parts, "")
