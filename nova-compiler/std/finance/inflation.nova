// std/finance/inflation.nova — Inflation adjustment functions.
// All monetary results are floats. Rates are decimals (0.03 = 3%).
// years is int. All pow() results bound to a let (NOVA codegen requirement).
// LEAF — imports NOTHING.

// infl_future_value — cost of an item in the future given inflation.
//   FV = present * (1 + inflation_rate)^years
fn infl_future_value(present: float, inflation_rate: float, years: int) -> float
    let factor = pow(1.0 + inflation_rate, years * 1.0)
    let result = present * factor
    result

// infl_present_value — purchasing power equivalent in today's dollars.
//   PV = future / (1 + inflation_rate)^years
fn infl_present_value(future: float, inflation_rate: float, years: int) -> float
    let factor = pow(1.0 + inflation_rate, years * 1.0)
    let result = future / factor
    result

// infl_real_rate — Fisher equation: real rate after stripping out inflation.
//   real = (1 + nominal) / (1 + inflation) - 1
fn infl_real_rate(nominal_rate: float, inflation_rate: float) -> float
    let result = (1.0 + nominal_rate) / (1.0 + inflation_rate) - 1.0
    result

// infl_purchasing_power — how much today's amount buys after years of inflation.
//   pp = amount / (1 + inflation_rate)^years
fn infl_purchasing_power(amount: float, inflation_rate: float, years: int) -> float
    let factor = pow(1.0 + inflation_rate, years * 1.0)
    let result = amount / factor
    result
