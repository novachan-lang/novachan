// std/finance/tax.nova — Progressive tax bracket calculations.
// LEAF — imports NOTHING.
//
// A bracket set is a list of [threshold, rate] pairs sorted by threshold
// ascending.  The rate applies to income ABOVE that threshold up to the
// next threshold.
//
// Example: [[0.0, 0.1], [10000.0, 0.2], [40000.0, 0.3]]
//   10 % on $0–$10 000, 20 % on $10 000–$40 000, 30 % on $40 000+.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float consts defined inside fn bodies.
//   * Every intermediate result bound to a named `let` before use.
//   * Float ABS: (if x < 0.0 then 0.0 - x else x) — NOT abs().
//   * Integer division coerced via *1.0.
//   * NO single-line `if cond then stmt` — always block body.
//   * NO and-and/or-or — use nested if.
//
// Public API (prefix tax_):
//   tax_compute(income, brackets)       -> float   total tax owed
//   tax_effective_rate(income, brackets)-> float   tax / income
//   tax_marginal_rate(income, brackets) -> float   rate of the bracket income falls in
//   tax_after_tax(income, brackets)     -> float   income - tax

// tax_compute — sum tax owed across all brackets for the given income.
// For each bracket i, the taxable slice is:
//   low  = brackets[i][0]
//   high = brackets[i+1][0]  (or income if last bracket)
//   taxable = max(0, min(income, high) - low)
//   tax += taxable * rate
fn tax_compute(income: float, brackets: list) -> float
    let n = len(brackets)
    if n == 0
        return 0.0
    let total = 0.0
    let i = 0
    while i < n
        let bracket = brackets[i]
        let low = bracket[0] * 1.0
        let rate = bracket[1] * 1.0
        // Determine the upper boundary of this bracket.
        let high = income
        if i + 1 < n
            let next_bracket = brackets[i + 1]
            let next_low = next_bracket[0] * 1.0
            if income > next_low
                high = next_low
        // Only tax if income exceeds the lower threshold of this bracket.
        if income > low
            let slice = high - low
            let contribution = slice * rate
            total = total + contribution
        i = i + 1
    total

// tax_marginal_rate — the rate of the highest bracket the income falls into.
// Returns 0.0 if brackets is empty or income is below all thresholds.
fn tax_marginal_rate(income: float, brackets: list) -> float
    let n = len(brackets)
    if n == 0
        return 0.0
    let mrate = 0.0
    let i = 0
    while i < n
        let bracket = brackets[i]
        let low = bracket[0] * 1.0
        if income > low
            mrate = bracket[1] * 1.0
        i = i + 1
    mrate

// tax_effective_rate — tax as a fraction of gross income.
// Returns 0.0 for zero income to avoid division by zero.
fn tax_effective_rate(income: float, brackets: list) -> float
    if income == 0.0
        return 0.0
    let tax = tax_compute(income, brackets)
    let rate = tax / income
    rate

// tax_after_tax — take-home pay: income minus total tax.
fn tax_after_tax(income: float, brackets: list) -> float
    let tax = tax_compute(income, brackets)
    let result = income - tax
    result
