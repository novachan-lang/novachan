// std/finance/annuity.nova — Annuity present/future value calculations.
//
// FLOAT HAZARDS obeyed throughout:
//   * All intermediate results bound to named `let` variables.
//   * Never return a bare multi-term float expression — single-exit named result.
//   * ABS OF FLOAT: (if x < 0.0 then 0.0 - x else x) — NOT abs().
//   * Integer division: coerce with *1.0 to get float division.
//   * NO single-line `if cond then stmt` — always block body.
//
// API (PREFIX: ann_):
//   ann_pv_ordinary(pmt, rate, n)    -> float  PV of ordinary annuity
//   ann_fv_ordinary(pmt, rate, n)    -> float  FV of ordinary annuity
//   ann_pv_due(pmt, rate, n)         -> float  PV of annuity-due
//   ann_fv_due(pmt, rate, n)         -> float  FV of annuity-due
//   ann_perpetuity_pv(pmt, rate)     -> float  PV of perpetuity: pmt/rate
//   ann_payment_from_pv(pv, rate, n) -> float  payment that recovers PV in n periods

// Present value of an ordinary annuity (payments at END of each period).
// formula: PV = pmt * (1 - (1+rate)^-n) / rate
fn ann_pv_ordinary(pmt: float, rate: float, n: float) -> float
    let base = 1.0 + rate
    let disc = pow(base, 0.0 - n)
    let factor = (1.0 - disc) / rate
    let result = pmt * factor
    result

// Future value of an ordinary annuity (payments at END of each period).
// formula: FV = pmt * ((1+rate)^n - 1) / rate
fn ann_fv_ordinary(pmt: float, rate: float, n: float) -> float
    let base = 1.0 + rate
    let grown = pow(base, n)
    let factor = (grown - 1.0) / rate
    let result = pmt * factor
    result

// Present value of an annuity-due (payments at BEGINNING of each period).
// formula: PV_due = PV_ordinary * (1 + rate)
fn ann_pv_due(pmt: float, rate: float, n: float) -> float
    let base = 1.0 + rate
    let disc = pow(base, 0.0 - n)
    let factor = (1.0 - disc) / rate
    let pv_ord = pmt * factor
    let result = pv_ord * (1.0 + rate)
    result

// Future value of an annuity-due (payments at BEGINNING of each period).
// formula: FV_due = FV_ordinary * (1 + rate)
fn ann_fv_due(pmt: float, rate: float, n: float) -> float
    let base = 1.0 + rate
    let grown = pow(base, n)
    let factor = (grown - 1.0) / rate
    let fv_ord = pmt * factor
    let result = fv_ord * (1.0 + rate)
    result

// Present value of a perpetuity (infinite series of equal payments).
// formula: PV = pmt / rate
fn ann_perpetuity_pv(pmt: float, rate: float) -> float
    let result = pmt / rate
    result

// Periodic payment that fully amortises a present value in n periods.
// Inverse of ann_pv_ordinary: pmt = pv * rate / (1 - (1+rate)^-n)
fn ann_payment_from_pv(pv: float, rate: float, n: float) -> float
    let base = 1.0 + rate
    let disc = pow(base, 0.0 - n)
    let denom = 1.0 - disc
    let result = pv * rate / denom
    result

// --- Canonical-name aliases (task-spec names) ---

// annuity_payment: payment to pay off pv over n periods at rate.
fn annuity_payment(pv: float, rate: float, n: int) -> float
    let nf = n * 1.0
    let result = ann_payment_from_pv(pv, rate, nf)
    result

// perpetuity_pv: PV of perpetuity = pmt/rate.
fn perpetuity_pv(pmt: float, rate: float) -> float
    let result = ann_perpetuity_pv(pmt, rate)
    result

// growing_annuity_pv: PV of an annuity where payments grow at `growth` per period.
// Formula: pmt * (1 - ((1+growth)/(1+rate))^n) / (rate - growth)
// Special case: rate == growth -> pmt * n / (1+rate)
fn growing_annuity_pv(pmt: float, rate: float, growth: float, n: int) -> float
    let nf = n * 1.0
    if rate == growth
        let result = pmt * nf / (1.0 + rate)
        return result
    let ratio = (1.0 + growth) / (1.0 + rate)
    let ratio_n = pow(ratio, nf)
    let numerator = 1.0 - ratio_n
    let denominator = rate - growth
    let result = pmt * numerator / denominator
    result
