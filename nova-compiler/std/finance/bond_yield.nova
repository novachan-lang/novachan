// std/finance/bond_yield.nova — Bond yield calculation functions.
// LEAF — imports NOTHING.
//
// Public API:
//   current_yield(annual_coupon, price) -> float
//       Current yield = annual coupon payment / current market price.
//       Returns 0.0 if price == 0.0 (guard against division by zero).
//
//   approximate_ytm(face, coupon_rate, price, periods) -> float
//       Hicks/textbook approximation formula for yield-to-maturity:
//       YTM ≈ (C + (F - P) / n) / ((F + P) / 2)
//       where C = face * coupon_rate (annual coupon).
//       Accurate to within ~0.5% for near-par bonds.
//       Returns 0.0 if (F + P) == 0.0 (guard against division by zero).
//
// All rates are decimal fractions (e.g. 0.05 for 5%).
// periods is number of annual periods (int).
// NOVA float-codegen: every intermediate result is bound to a named let
// before further arithmetic (avoids uninit-slot bug).

// current_yield — annual coupon / current price.
// current_yield(50.0, 1000.0) == 0.05
// current_yield(50.0, 950.0)  == 0.05263...
fn current_yield(annual_coupon: float, price: float) -> float
    if price == 0.0
        return 0.0
    let result = annual_coupon / price
    result

// approximate_ytm — Hicks approximation for yield-to-maturity.
//   YTM ≈ (C + (F - P) / n) / ((F + P) / 2)
//   C = face * coupon_rate  (annual coupon)
//   For a par bond (P == F): numerator = C, denominator = F => YTM = C/F = coupon_rate
//   For a discount bond (P < F): capital gain pushes YTM above coupon rate.
//   For a premium bond  (P > F): capital loss pulls YTM below coupon rate.
fn approximate_ytm(face: float, coupon_rate: float, price: float, periods: int) -> float
    let denom = (face + price) / 2.0
    if denom == 0.0
        return 0.0
    let coupon = face * coupon_rate
    let capital_gain = (face - price) / (periods * 1.0)
    let numerator = coupon + capital_gain
    let result = numerator / denom
    result
