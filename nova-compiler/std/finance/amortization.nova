// std/finance/amortization.nova — loan amortization (fixed-rate, fixed-term).
// All functions take: principal (float), rate (per-period float), n (int periods).
//
// amt_payment(principal, rate, n) -> float
//   Monthly payment using the standard annuity formula:
//   P = principal * rate * (1+rate)^n / ((1+rate)^n - 1)
//   Special case: rate==0 -> principal/n (zero-interest loan).
//
// amt_schedule(principal, rate, n) -> list of rows
//   Each row: [payment, interest, principalPaid, balance]  (all float).
//   Builds the complete amortization table row by row.
//
// amt_total_interest(principal, rate, n) -> float
//   Sum of all interest payments = total_paid - principal.
//
// amt_balance_after(principal, rate, n, k) -> float
//   Remaining balance after k full payments have been made (k=0 -> principal).
//   Uses the closed-form prospective balance formula.
//
// Precision: standard double-precision floating point; epsilon 0.01 for money.
// LEAF — no imports.

// Private: compute (1+rate)^n via repeated multiplication (n is typically small,
// e.g. 360 for 30-year monthly). Using a loop avoids the uninit-slot bug that
// hits a bare `return pow(...)`.
fn _amt_pow(base: float, exp: int) -> float
    let result = 1.0
    for i in 0..exp
        result = result * base
    result

// amt_payment: standard annuity payment formula.
fn amt_payment(principal: float, rate: float, n: int) -> float
    if rate == 0.0
        let p = principal / (n * 1.0)
        return p
    let factor = _amt_pow(1.0 + rate, n)
    let num = principal * rate * factor
    let den = factor - 1.0
    let payment = num / den
    payment

// amt_schedule: build full amortization table.
// Each row is a list [payment, interest, principalPaid, balance].
fn amt_schedule(principal: float, rate: float, n: int) -> list
    let rows = []
    let payment = amt_payment(principal, rate, n)
    let balance = principal
    for i in 0..n
        let interest = balance * rate
        let principal_paid = payment - interest
        balance -= principal_paid
        // clamp last-row rounding drift to exactly 0
        if balance < 0.0
            balance = 0.0
        let row = [payment, interest, principal_paid, balance]
        rows.push(row)
    rows

// amt_total_interest: total interest paid over the life of the loan.
fn amt_total_interest(principal: float, rate: float, n: int) -> float
    let payment = amt_payment(principal, rate, n)
    let total_paid = payment * (n * 1.0)
    let interest = total_paid - principal
    interest

// amt_balance_after: remaining balance after k payments (prospective formula).
// B(k) = principal*(1+rate)^k - payment*((1+rate)^k - 1)/rate
// For rate==0: B(k) = principal - k*payment.
fn amt_balance_after(principal: float, rate: float, n: int, k: int) -> float
    let payment = amt_payment(principal, rate, n)
    if rate == 0.0
        let bal = principal - (k * 1.0) * payment
        return bal
    let factor = _amt_pow(1.0 + rate, k)
    let grown = principal * factor
    let paid_down = payment * (factor - 1.0) / rate
    let balance = grown - paid_down
    if balance < 0.0
        balance = 0.0
    balance

// --- Canonical-name aliases (task-spec names) ---

// loan_payment: alias for amt_payment with months parameter name.
fn loan_payment(principal: float, monthly_rate: float, months: int) -> float
    let p = amt_payment(principal, monthly_rate, months)
    p

// total_interest: total interest paid over loan life.
fn total_interest(principal: float, monthly_rate: float, months: int) -> float
    let ti = amt_total_interest(principal, monthly_rate, months)
    ti

// remaining_balance: balance after `after` payments.
fn remaining_balance(principal: float, monthly_rate: float, months: int, after: int) -> float
    let rb = amt_balance_after(principal, monthly_rate, months, after)
    rb
