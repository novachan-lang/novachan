// std/finance/tvm.nova — Time Value of Money (TVM) functions.
// All functions return float. Rate is per-period (e.g. 0.05 = 5% per period).
// n is number of periods (int). pv/fv/pmt are monetary floats.
//
// Handles zero-rate edge cases explicitly (division by rate would be /0).
// Binds all pow() results to a let before further arithmetic (NOVA codegen requirement).
// LEAF — imports NOTHING.

// tvm_fv — future value of a lump sum.
//   FV = PV * (1+rate)^n
fn tvm_fv(pv: float, rate: float, n: int) -> float
    let factor = pow(1.0 + rate, n * 1.0)
    let result = pv * factor
    result

// tvm_pv — present value of a future lump sum.
//   PV = FV / (1+rate)^n
fn tvm_pv(fv: float, rate: float, n: int) -> float
    let factor = pow(1.0 + rate, n * 1.0)
    let result = fv / factor
    result

// tvm_fv_annuity — future value of an ordinary annuity (payments at END of period).
//   FV = PMT * ((1+r)^n - 1) / r
// Zero-rate case: FV = PMT * n  (no compounding, just sum)
fn tvm_fv_annuity(pmt: float, rate: float, n: int) -> float
    if rate == 0.0
        let result = pmt * (n * 1.0)
        return result
    let factor = pow(1.0 + rate, n * 1.0)
    let result = pmt * (factor - 1.0) / rate
    result

// tvm_pv_annuity — present value of an ordinary annuity (payments at END of period).
//   PV = PMT * (1 - (1+r)^-n) / r
// Zero-rate case: PV = PMT * n
fn tvm_pv_annuity(pmt: float, rate: float, n: int) -> float
    if rate == 0.0
        let result = pmt * (n * 1.0)
        return result
    let factor = pow(1.0 + rate, n * 1.0)
    let result = pmt * (1.0 - 1.0 / factor) / rate
    result

// tvm_pmt — periodic payment for a loan (ordinary annuity, payment at END of period).
//   PMT = PV * r / (1 - (1+r)^-n)
// Zero-rate case: PMT = PV / n  (no interest, equal principal payments)
fn tvm_pmt(pv: float, rate: float, n: int) -> float
    if rate == 0.0
        let result = pv / (n * 1.0)
        return result
    let factor = pow(1.0 + rate, n * 1.0)
    let denom = 1.0 - 1.0 / factor
    let result = pv * rate / denom
    result

// Canonical short-name aliases (for KAT and external callers).
fn future_value(pv: float, rate: float, n: int) -> float
    let factor = pow(1.0 + rate, n * 1.0)
    let result = pv * factor
    result

fn present_value(fv: float, rate: float, n: int) -> float
    let factor = pow(1.0 + rate, n * 1.0)
    let result = fv / factor
    result

fn annuity_fv(pmt: float, rate: float, n: int) -> float
    if rate == 0.0
        let result = pmt * (n * 1.0)
        return result
    let factor = pow(1.0 + rate, n * 1.0)
    let result = pmt * (factor - 1.0) / rate
    result

fn annuity_pv(pmt: float, rate: float, n: int) -> float
    if rate == 0.0
        let result = pmt * (n * 1.0)
        return result
    let factor = pow(1.0 + rate, n * 1.0)
    let result = pmt * (1.0 - 1.0 / factor) / rate
    result
