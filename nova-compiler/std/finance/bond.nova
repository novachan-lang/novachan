// std/finance/bond.nova — Bond pricing and yield functions.
// LEAF — imports NOTHING.
//
// Public API:
//   bnd_price(face, coupon_rate, market_rate, n) -> float
//       Present value of a fixed-coupon bond (annual, end-of-period coupons).
//       PV = C * (1 - (1+r)^-n) / r  +  F / (1+r)^n
//       where C = face * coupon_rate, r = market_rate.
//       At par (coupon_rate == market_rate) returns exactly face.
//
//   bnd_current_yield(face, coupon_rate, price) -> float
//       Current yield = annual coupon / price.
//       (face * coupon_rate) / price.
//
//   bnd_ytm_approx(face, coupon_rate, price, n) -> float
//       Approximate yield-to-maturity (Hicks approximation):
//       YTM ≈ (C + (F - P) / n) / ((F + P) / 2)
//       where C = face * coupon_rate.  Accurate to ~0.5% for near-par bonds.
//
//   bnd_duration(face, coupon_rate, market_rate, n) -> float
//       Macaulay duration: weighted average time of cash flows.
//       D = sum(t * PV(CF_t)) / bnd_price(...)
//       Measures interest-rate sensitivity (in years).
//
// All rates are decimal fractions (e.g. 0.05 for 5%).
// n is number of annual periods (int).
// NOVA float-codegen: every pow/multi-step float result is bound to a
// named `let` before further arithmetic to avoid the uninit-slot bug.

// _bnd_pow — raise base to a non-negative integer exponent iteratively.
// pow() native is fine too, but an integer loop avoids float-exp rounding.
fn _bnd_pow(base: float, exp: int) -> float
    let result = 1.0
    for i in 0..exp
        result = result * base
    result

// bnd_price — present value of a fixed-coupon bond (annual coupons, end of period).
//   PV_coupons = C * (1 - 1/(1+r)^n) / r
//   PV_face    = F / (1+r)^n
//   Price      = PV_coupons + PV_face
// Zero market_rate edge: price = C*n + F (no discounting).
fn bnd_price(face: float, coupon_rate: float, market_rate: float, n: int) -> float
    let c = face * coupon_rate
    if market_rate == 0.0
        let result = c * (n * 1.0) + face
        return result
    let disc = 1.0 + market_rate
    let disc_n = _bnd_pow(disc, n)
    let pv_face = face / disc_n
    let annuity_factor = (1.0 - 1.0 / disc_n) / market_rate
    let pv_coupons = c * annuity_factor
    let result = pv_coupons + pv_face
    result

// bnd_current_yield — annual coupon divided by current market price.
//   CY = (face * coupon_rate) / price
// Returns 0.0 if price is 0 to avoid division by zero.
fn bnd_current_yield(face: float, coupon_rate: float, price: float) -> float
    if price == 0.0
        return 0.0
    let coupon = face * coupon_rate
    let result = coupon / price
    result

// bnd_ytm_approx — approximate yield to maturity (Hicks/Approximation formula).
//   YTM ≈ (C + (F - P) / n) / ((F + P) / 2)
// Returns 0.0 if (F+P) is 0 to avoid division by zero.
fn bnd_ytm_approx(face: float, coupon_rate: float, price: float, n: int) -> float
    let c = face * coupon_rate
    let denom = (face + price) / 2.0
    if denom == 0.0
        return 0.0
    let capital_gain = (face - price) / (n * 1.0)
    let numerator = c + capital_gain
    let result = numerator / denom
    result

// bnd_duration — Macaulay duration in years.
//   D = (1/Price) * sum_{t=1}^{n} [ t * PV(CF_t) ]
// where CF_t = coupon for t < n, CF_n = coupon + face.
// Returns 0.0 if price is 0 or n == 0.
// Implementation: accumulate coupon PV for all t, then at t==n add the face PV.
fn bnd_duration(face: float, coupon_rate: float, market_rate: float, n: int) -> float
    if n == 0
        return 0.0
    let price = bnd_price(face, coupon_rate, market_rate, n)
    if price == 0.0
        return 0.0
    let c = face * coupon_rate
    let disc = 1.0 + market_rate
    let weighted_sum = 0.0
    let t = 1
    while t <= n
        let disc_t = _bnd_pow(disc, t)
        let pv_coupon = c / disc_t
        let contrib = (t * 1.0) * pv_coupon
        weighted_sum = weighted_sum + contrib
        t = t + 1
    // Add weighted PV of face redemption at period n
    let disc_n = _bnd_pow(disc, n)
    let pv_face = face / disc_n
    let face_contrib = (n * 1.0) * pv_face
    weighted_sum = weighted_sum + face_contrib
    let result = weighted_sum / price
    result
