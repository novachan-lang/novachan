// ============================================================================
// NOVA Standard Library — Internal Rate of Return
// std/finance/irr.nova
// ============================================================================
// Computes the Internal Rate of Return (IRR) and related metrics.
//
// Public API (prefix irr_):
//   irr_npv(rate, cashflows) -> float
//       Net present value of a series of cashflows at the given discount rate.
//       cashflows[t] is the cash flow at period t (t=0 is now).
//
//   irr_compute(cashflows) -> float
//       The rate r where irr_npv(r, cashflows) == 0.
//       Uses bisection on [-0.99, 10.0], capped at 200 iterations.
//       cashflows[0] is typically negative (the initial investment).
//       Returns -0.9999 if no sign change found in [-0.99, 10.0].
//
//   irr_mirr(cashflows, finance_rate, reinvest_rate) -> float
//       Modified Internal Rate of Return.
//       Negative cashflows are discounted at finance_rate (cost of capital).
//       Positive cashflows are compounded at reinvest_rate (reinvestment rate).
//       Formula: ((FV_pos / PV_neg_abs)^(1/(n-1))) - 1
//       where n = len(cashflows).
//
// All private helpers are prefixed _irr_.
// LEAF module — imports nothing.
// ============================================================================

// _irr_fabs: float absolute value (abs() builtin returns int in NOVA).
fn _irr_fabs(x: float) -> float
    if x < 0.0
        let r = x * -1.0
        return r
    x

// irr_npv: net present value of cashflows discounted at rate r.
// NPV = sum_{t=0}^{n-1} cashflows[t] / (1+r)^t
// cashflows is a list of floats (or ints coerced to float).
fn irr_npv(rate: float, cashflows: list) -> float
    let n = len(cashflows)
    if n == 0
        return 0.0
    let npv = 0.0
    let i = 0
    // discount_factor tracks (1+r)^i starting at 1.0
    let df = 1.0
    let r1 = 1.0 + rate
    while i < n
        let cf = cashflows[i] * 1.0
        let term = cf / df
        npv = npv + term
        df = df * r1
        i = i + 1
    npv

// irr_compute: find r in [-0.99, 10.0] such that irr_npv(r, cashflows) == 0.
// Uses bisection with up to 200 iterations; tolerance 1e-7.
// Returns -0.9999 if no bracketing sign change exists in the search range.
fn irr_compute(cashflows: list) -> float
    let lo = -0.99
    let hi = 10.0
    let tol = 0.0000001
    let maxiter = 200
    // Evaluate NPV at the two endpoints
    let flo = irr_npv(lo, cashflows)
    let fhi = irr_npv(hi, cashflows)
    // Need opposite signs for bisection to work
    // Check: flo < 0 and fhi > 0, OR flo > 0 and fhi < 0
    let has_bracket = 0
    if flo < 0.0
        if fhi > 0.0
            has_bracket = 1
    if flo > 0.0
        if fhi < 0.0
            has_bracket = 1
    if has_bracket == 0
        return -0.9999
    // Bisection state in dict (safe for mutation inside while+if)
    let st = {}
    st["lo"] = lo
    st["hi"] = hi
    st["flo"] = flo
    let iter = 0
    while iter < maxiter
        let cur_lo = st["lo"]
        let cur_hi = st["hi"]
        let cur_flo = st["flo"]
        let width = cur_hi - cur_lo
        if width < tol
            let iter = maxiter
        if iter < maxiter
            let mid = cur_lo + (cur_hi - cur_lo) * 0.5
            let fmid = irr_npv(mid, cashflows)
            // Determine which half contains the root
            // If flo and fmid have same sign -> root in [mid, hi]
            // Else root in [lo, mid]
            if cur_flo < 0.0
                if fmid < 0.0
                    st["lo"] = mid
                    st["flo"] = fmid
                if fmid >= 0.0
                    st["hi"] = mid
            if cur_flo >= 0.0
                if fmid >= 0.0
                    st["lo"] = mid
                    st["flo"] = fmid
                if fmid < 0.0
                    st["hi"] = mid
            let iter = iter + 1
    let final_lo = st["lo"]
    let final_hi = st["hi"]
    let result = final_lo + (final_hi - final_lo) * 0.5
    result

// irr_mirr: Modified Internal Rate of Return.
// Separates positive and negative cashflows, applies different rates.
// finance_rate   = cost of borrowing (applied to negative cashflows)
// reinvest_rate  = return on reinvestment (applied to positive cashflows)
// n = len(cashflows); periods run from 0 to n-1.
// PV_neg = sum of PV of negative cashflows discounted at finance_rate
// FV_pos = sum of FV of positive cashflows compounded at reinvest_rate
// MIRR = (FV_pos / |PV_neg|)^(1/(n-1)) - 1
// Returns 0.0 if there are no negative or no positive cashflows.
fn irr_mirr(cashflows: list, finance_rate: float, reinvest_rate: float) -> float
    let n = len(cashflows)
    if n < 2
        return 0.0
    let pv_neg = 0.0
    let fv_pos = 0.0
    let i = 0
    let r1f = 1.0 + finance_rate
    let r1r = 1.0 + reinvest_rate
    while i < n
        let cf = cashflows[i] * 1.0
        if cf < 0.0
            // discount negative cashflows back to period 0 at finance_rate
            let df = pow(r1f, i * 1.0)
            let pv_term = cf / df
            pv_neg = pv_neg + pv_term
        if cf > 0.0
            // compound positive cashflows forward to period n-1 at reinvest_rate
            let exp_periods = (n - 1 - i) * 1.0
            let cf_term = cf * pow(r1r, exp_periods)
            fv_pos = fv_pos + cf_term
        i = i + 1
    if pv_neg >= 0.0
        return 0.0
    let pv_neg_abs = pv_neg * -1.0
    if pv_neg_abs < 0.0000001
        return 0.0
    if fv_pos < 0.0000001
        return 0.0
    let ratio = fv_pos / pv_neg_abs
    let exp_pow = 1.0 / ((n - 1) * 1.0)
    let mirr = pow(ratio, exp_pow) - 1.0
    mirr

fn main()
    print("irr module OK")
