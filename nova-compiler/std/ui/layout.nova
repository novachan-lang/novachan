// std/ui/layout.nova — Box-model UI layout engine (integer pixel coordinates).
//
// BOX MODEL (CSS-like, all fields int, pixel units):
//   ly_box(x,y,w,h) creates dict {x,y,w,h, mt,mr,mb,ml, pt,pr,pb,pl}; margin
//   and padding all default to 0.  (x,y,w,h) is the box's own border-box rect.
//     margin box (outer, used for stacking) = [x-ml, y-mt, w+ml+mr, h+mt+mb]
//     content box (inner)                   = [x+pl, y+pt, w-pl-pr, h-pt-pb]
//
// PREFIX: ly_  (private helpers: _ly_)
//
// API:
//   ly_box(x, y, w, h)                        -> any   new box, margin=padding=0
//   ly_margin(box, top, right, bottom, left)  -> any   new box with margin set
//   ly_padding(box, top, right, bottom, left) -> any   new box with padding set
//   ly_content_rect(box)                      -> list  [x, y, w, h] inner content
//                                                        rect (w/h clamped >= 0)
//   ly_hstack(boxes, gap)                     -> list  boxes repositioned
//                                                        left-to-right (x only;
//                                                        y, w, h, margins kept)
//   ly_vstack(boxes, gap)                     -> list  boxes repositioned
//                                                        top-to-bottom (y only;
//                                                        x, w, h, margins kept)

// ── construction ─────────────────────────────────────────────────────────────

fn ly_box(x: int, y: int, w: int, h: int) -> any
    let b = {}
    b["x"] = x
    b["y"] = y
    b["w"] = w
    b["h"] = h
    b["mt"] = 0
    b["mr"] = 0
    b["mb"] = 0
    b["ml"] = 0
    b["pt"] = 0
    b["pr"] = 0
    b["pb"] = 0
    b["pl"] = 0
    b

fn _ly_copy(box: any) -> any
    let c = {}
    c["x"] = box["x"]
    c["y"] = box["y"]
    c["w"] = box["w"]
    c["h"] = box["h"]
    c["mt"] = box["mt"]
    c["mr"] = box["mr"]
    c["mb"] = box["mb"]
    c["ml"] = box["ml"]
    c["pt"] = box["pt"]
    c["pr"] = box["pr"]
    c["pb"] = box["pb"]
    c["pl"] = box["pl"]
    c

// ── margin / padding ──────────────────────────────────────────────────────────

fn ly_margin(box: any, top: int, right: int, bottom: int, left: int) -> any
    let b = _ly_copy(box)
    b["mt"] = top
    b["mr"] = right
    b["mb"] = bottom
    b["ml"] = left
    b

fn ly_padding(box: any, top: int, right: int, bottom: int, left: int) -> any
    let b = _ly_copy(box)
    b["pt"] = top
    b["pr"] = right
    b["pb"] = bottom
    b["pl"] = left
    b

// ── content rect ──────────────────────────────────────────────────────────────

// ly_content_rect: [x, y, w, h] of the box's content area (border-box rect
// shrunk by padding). Width/height are clamped to >= 0 (padding larger than
// the box never produces a negative size).
fn ly_content_rect(box: any) -> list
    let x = box["x"]
    let y = box["y"]
    let w = box["w"]
    let h = box["h"]
    let pt = box["pt"]
    let pr = box["pr"]
    let pb = box["pb"]
    let pl = box["pl"]
    let cx = x + pl
    let cy = y + pt
    let cw = w - pl - pr
    let ch = h - pt - pb
    if cw < 0
        cw = 0
    if ch < 0
        ch = 0
    [cx, cy, cw, ch]

// ── stacking ──────────────────────────────────────────────────────────────────

// ly_hstack: lay boxes out left-to-right. cursor starts at 0; each box's new
// x = cursor + its own left margin; cursor then advances past the box's width,
// right margin, and the gap. y, w, h, and margins/paddings are unchanged.
fn ly_hstack(boxes: list, gap: int) -> list
    let out = []
    let n = len(boxes)
    let cursor = 0
    for i in 0..n
        let src = boxes[i]
        let b = _ly_copy(src)
        let ml = b["ml"]
        let mr = b["mr"]
        let w = b["w"]
        let nx = cursor + ml
        b["x"] = nx
        cursor = nx + w + mr + gap
        out.push(b)
    out

// ly_vstack: lay boxes out top-to-bottom (mirror of ly_hstack on the y axis).
fn ly_vstack(boxes: list, gap: int) -> list
    let out = []
    let n = len(boxes)
    let cursor = 0
    for i in 0..n
        let src = boxes[i]
        let b = _ly_copy(src)
        let mt = b["mt"]
        let mb = b["mb"]
        let h = b["h"]
        let ny = cursor + mt
        b["y"] = ny
        cursor = ny + h + mb + gap
        out.push(b)
    out
