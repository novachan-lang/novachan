// std/ui/color.nova — UI color manipulation (dict-based color model).
//
// COLOR MODEL: dict {"r": int, "g": int, "b": int}, channels clamped 0..255.
// (Distinct from std/color/rgb.nova's list-based [r,g,b] model — this module
// is dict-based to match dict-oriented UI code, e.g. std/ui/layout.nova boxes.
// It does not duplicate std/color/hex.nova's list-oriented hex codec: field
// names and return shapes are dict-based throughout.)
//
// PREFIX: uc_  (private helpers: _uc_)
//
// FLOAT HAZARDS obeyed throughout (see std/color/lab.nova):
//   * every intermediate float expression bound to a named let.
//   * float-returning private helpers use single-exit (no early `return`).
//   * 'abs(float)' returns int in NOVA — never used here.
//
// API:
//   uc_rgb(r, g, b)           -> any    color dict, channels clamped 0..255
//   uc_hex(hex_str)           -> any    parse "#rrggbb" / "rrggbb" / "#rgb" /
//                                        "rgb" -> color dict (black on malformed
//                                        input)
//   uc_to_hex(color)          -> str    "#rrggbb" lowercase
//   uc_blend(c1, c2, ratio)   -> any    linear interpolation; ratio clamped
//                                        to [0.0, 1.0] (0 = c1, 1 = c2)
//   uc_brightness(color)      -> int    perceived brightness, ITU-R BT.601
//                                        luma (299r+587g+114b)/1000, 0..255
//   uc_contrast_ratio(c1, c2) -> float  WCAG 2.x contrast ratio, range
//                                        [1.0, 21.0]; symmetric in c1/c2

// ── construction ─────────────────────────────────────────────────────────────

fn _uc_clamp255(v: int) -> int
    let r = v
    if v < 0
        r = 0
    if v > 255
        r = 255
    r

fn uc_rgb(r: int, g: int, b: int) -> any
    let c = {}
    c["r"] = _uc_clamp255(r)
    c["g"] = _uc_clamp255(g)
    c["b"] = _uc_clamp255(b)
    c

// ── hex codec ─────────────────────────────────────────────────────────────────

fn _uc_alpha() -> str
    "0123456789abcdef"

// Parse a single hex character (either case) to a nibble 0..15, or -1.
fn _uc_nibble(ch: str) -> int
    let lc = lower(ch)
    let alpha = _uc_alpha()
    for i in 0..16
        if alpha[i] == lc
            return i
    0 - 1

fn _uc_byte_to_hex(b: int) -> str
    let alpha = _uc_alpha()
    let hi = b / 16
    let lo = b - hi * 16
    alpha[hi] + alpha[lo]

// Parse two consecutive hex chars at s[pos..pos+1] to a byte, or -1.
fn _uc_parse_byte(s: str, pos: int) -> int
    let hi = _uc_nibble(s[pos])
    let lo = _uc_nibble(s[pos + 1])
    let result = 0 - 1
    if hi >= 0 and lo >= 0
        result = hi * 16 + lo
    result

// Parse one hex char at s[pos], expanded to a byte by nibble repetition
// (CSS shorthand: 'a' -> 0xaa = 170), or -1.
fn _uc_parse_nibble_expanded(s: str, pos: int) -> int
    let n = _uc_nibble(s[pos])
    let result = 0 - 1
    if n >= 0
        result = n * 16 + n
    result

// uc_hex: parse "#rrggbb", "rrggbb", "#rgb", or "rgb" into a color dict.
// Malformed input (wrong length or non-hex characters) returns black
// (uc_rgb(0,0,0)).
fn uc_hex(hex_str: str) -> any
    let start = 0
    if len(hex_str) > 0
        if hex_str[0] == "#"
            start = 1
    let digits = len(hex_str) - start
    let c = uc_rgb(0, 0, 0)
    if digits == 3
        let rv = _uc_parse_nibble_expanded(hex_str, start)
        let gv = _uc_parse_nibble_expanded(hex_str, start + 1)
        let bv = _uc_parse_nibble_expanded(hex_str, start + 2)
        if rv >= 0 and gv >= 0 and bv >= 0
            c = uc_rgb(rv, gv, bv)
    if digits == 6
        let rv = _uc_parse_byte(hex_str, start)
        let gv = _uc_parse_byte(hex_str, start + 2)
        let bv = _uc_parse_byte(hex_str, start + 4)
        if rv >= 0 and gv >= 0 and bv >= 0
            c = uc_rgb(rv, gv, bv)
    c

// uc_to_hex: color dict -> lowercase "#rrggbb" (always 7 chars).
fn uc_to_hex(color: any) -> str
    let r = color["r"]
    let g = color["g"]
    let b = color["b"]
    "#" + _uc_byte_to_hex(r) + _uc_byte_to_hex(g) + _uc_byte_to_hex(b)

// ── blend ─────────────────────────────────────────────────────────────────────

// uc_blend: linear interpolation between c1 and c2. ratio clamped to
// [0.0, 1.0]; 0.0 -> c1, 1.0 -> c2. Rounds to nearest int per channel.
fn uc_blend(c1: any, c2: any, ratio: float) -> any
    let t = ratio
    if t < 0.0
        t = 0.0
    if t > 1.0
        t = 1.0
    let r1 = c1["r"]
    let g1 = c1["g"]
    let b1 = c1["b"]
    let r2 = c2["r"]
    let g2 = c2["g"]
    let b2 = c2["b"]
    let r1f = r1 * 1.0
    let g1f = g1 * 1.0
    let b1f = b1 * 1.0
    let r2f = r2 * 1.0
    let g2f = g2 * 1.0
    let b2f = b2 * 1.0
    let dr = r2f - r1f
    let dg = g2f - g1f
    let db = b2f - b1f
    let nr = r1f + t * dr
    let ng = g1f + t * dg
    let nb = b1f + t * db
    let nr2 = nr + 0.5
    let ng2 = ng + 0.5
    let nb2 = nb + 0.5
    let ri = float_to_int(nr2)
    let gi = float_to_int(ng2)
    let bi = float_to_int(nb2)
    uc_rgb(ri, gi, bi)

// ── brightness ────────────────────────────────────────────────────────────────

// uc_brightness: ITU-R BT.601 perceived brightness (integer luma), 0..255.
fn uc_brightness(color: any) -> int
    let r = color["r"]
    let g = color["g"]
    let b = color["b"]
    let sum = r * 299 + g * 587 + b * 114
    sum / 1000

// ── WCAG contrast ratio ──────────────────────────────────────────────────────

// sRGB gamma expansion (channel 0..255 int -> linear float 0..1), WCAG 2.x
// piecewise formula (threshold 0.03928 on the normalized 0..1 channel).
fn _uc_gamma_decode(channel: int) -> float
    let v = channel * 1.0
    let vs = v / 255.0
    let thresh = 0.03928
    let result = 0.0
    if vs <= thresh
        let lin = vs / 12.92
        result = lin
    else
        let inner = vs + 0.055
        let denom = inner / 1.055
        let ex = 2.4
        let lin = pow(denom, ex)
        result = lin
    result

// Relative luminance L = 0.2126*R_lin + 0.7152*G_lin + 0.0722*B_lin (WCAG 2.x).
fn _uc_luminance(color: any) -> float
    let r = color["r"]
    let g = color["g"]
    let b = color["b"]
    let lr = _uc_gamma_decode(r)
    let lg = _uc_gamma_decode(g)
    let lb = _uc_gamma_decode(b)
    let wr = lr * 0.2126
    let wg = lg * 0.7152
    let wb = lb * 0.0722
    let sum1 = wr + wg
    let sum2 = sum1 + wb
    sum2

// uc_contrast_ratio: WCAG contrast ratio (L_lighter+0.05)/(L_darker+0.05).
// Symmetric in c1/c2; range [1.0, 21.0] (1:1 identical colors, 21:1 black/white).
fn uc_contrast_ratio(c1: any, c2: any) -> float
    let l1 = _uc_luminance(c1)
    let l2 = _uc_luminance(c2)
    let lighter = l1
    let darker = l2
    if l2 > l1
        lighter = l2
        darker = l1
    let num = lighter + 0.05
    let den = darker + 0.05
    num / den
