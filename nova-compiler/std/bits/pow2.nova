// std/bits/pow2.nova — power-of-two queries, rounding, and logarithms.
// Uses the native `clz` (count-leading-zeros, 64-bit) builtin.
// LEAF — imports NOTHING.
//
// SHIFT SAFETY: >> is arithmetic in NOVA. Functions below only right-shift
// values that are known to be non-negative (already masked or already >= 0),
// so arithmetic right shift == logical right shift here.
//
// Public API:
//   p2_is_pow2(x)             -> bool  true iff x > 0 and x is an exact power of 2
//   p2_next_pow2(x)           -> int   smallest power of 2 >= x (p2_next_pow2(0)=1)
//   p2_prev_pow2(x)           -> int   largest power of 2 <= x  (x >= 1)
//   p2_log2_floor(x)          -> int   floor(log2(x))           (x >= 1)
//   p2_log2_ceil(x)           -> int   ceil(log2(x))            (x >= 1)
//   p2_round_up_multiple(x,m) -> int   round x up to nearest multiple of m (m > 0)

// p2_is_pow2 — true iff x is a positive exact power of two.
// Classic trick: (x & (x-1)) == 0 iff x has exactly one bit set; guard x > 0.
fn p2_is_pow2(x: int) -> bool
    if x <= 0
        return false
    (x & (x - 1)) == 0

// p2_log2_floor — floor(log2(x)) for x >= 1.
// Uses the native 64-bit clz: clz(x) = number of leading zeros in the 64-bit
// representation of x, so floor(log2(x)) = 63 - clz(x).
fn p2_log2_floor(x: int) -> int
    63 - clz(x)

// p2_log2_ceil — ceil(log2(x)) for x >= 1.
// Equals floor(log2(x)) when x is a power of 2, otherwise floor+1.
fn p2_log2_ceil(x: int) -> int
    if x <= 1
        return 0
    if p2_is_pow2(x)
        return p2_log2_floor(x)
    p2_log2_floor(x) + 1

// p2_next_pow2 — smallest power of 2 that is >= x.
// p2_next_pow2(0) = 1; p2_next_pow2(1) = 1.
// For x > 1 and not a power of 2: result = 1 << ceil(log2(x)).
fn p2_next_pow2(x: int) -> int
    if x <= 1
        return 1
    if p2_is_pow2(x)
        return x
    let lg = p2_log2_floor(x)
    1 << (lg + 1)

// p2_prev_pow2 — largest power of 2 that is <= x, for x >= 1.
// Equals 1 << floor(log2(x)).
fn p2_prev_pow2(x: int) -> int
    if x <= 0
        return 0
    1 << p2_log2_floor(x)

// p2_round_up_multiple — round x up to the nearest multiple of m (m > 0).
// Works for any positive m, not just powers of 2.
// Formula: ((x + m - 1) / m) * m   (integer division truncates toward zero).
fn p2_round_up_multiple(x: int, m: int) -> int
    ((x + m - 1) / m) * m
