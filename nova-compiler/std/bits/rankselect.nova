// std/bits/rankselect.nova — rank and select operations on i64 bit vectors.
// rank(x, i) = number of set bits in positions 0..i-1 (low i bits).
// select(x, k) = 0-indexed position of the k-th set bit (1-indexed k).
// LEAF — imports NOTHING.
//
// SHIFT SAFETY: >> is arithmetic in NOVA. rk_popcount counts bits of non-negative
// inputs (all KAT inputs are 8-bit quantities ≤ 255, always non-negative in i64).
// rk_rank masks to low i bits (always non-negative), so >> acts logically.
// PRECEDENCE: all & | ^ comparisons are fully parenthesized.

// rk_popcount — count total set bits in x (Hamming weight).
// Uses the classic parallel bit-count for 64-bit integers.
// Input treated as unsigned 64-bit pattern; works correctly for 0..2^63-1.
fn rk_popcount(x: int) -> int
    let v = x
    // Count set bits in pairs: subtract pairs by half-pair count.
    let m1 = 0x5555555555555555
    v = v - ((v >> 1) & m1)
    // Sum pairs into nibbles.
    let m2 = 0x3333333333333333
    v = ((v >> 2) & m2) + (v & m2)
    // Sum nibbles into bytes.
    let m4 = 0x0F0F0F0F0F0F0F0F
    v = ((v + (v >> 4)) & m4)
    // Sum the eight byte-slots by looping over them.
    // After step 3, each byte of v holds its nibble-pair sum (0..16) and
    // v is non-negative (bit 63 = 0), so >> 8 here is always logical.
    let acc = 0
    let i = 0
    let tmp = v
    while i < 8
        acc = acc + (tmp & 0xFF)
        tmp = tmp >> 8
        i = i + 1
    acc

// rk_rank — count of set bits in positions 0..i-1 (the low i bits of x).
// rk_rank(x, 0) = 0. rk_rank(x, 64) = rk_popcount(x).
// For i in 1..63, mask = (1<<i)-1 isolates exactly the low i bits (non-negative).
fn rk_rank(x: int, i: int) -> int
    if i <= 0
        return 0
    if i >= 64
        return rk_popcount(x)
    // mask = (1 << i) - 1; i in 1..63, so 1<<i is valid (no 1<<64 issue).
    let mask = (1 << i) - 1
    rk_popcount(x & mask)

// rk_select — 0-indexed position of the k-th set bit (k is 1-indexed).
// Returns -1 if x has fewer than k set bits.
// Scans from position 0 upward; stops early for performance on sparse inputs.
fn rk_select(x: int, k: int) -> int
    if k <= 0
        return -1
    let total = rk_popcount(x)
    if k > total
        return -1
    let count = 0
    let pos = 0
    while pos < 64
        if ((x >> pos) & 1) == 1
            count = count + 1
            if count == k
                return pos
        pos = pos + 1
    0 - 1

// rk_count_range — count set bits in positions [lo, hi) of x.
// Equivalent to rk_rank(x, hi) - rk_rank(x, lo).
fn rk_count_range(x: int, lo: int, hi: int) -> int
    if hi <= lo
        return 0
    rk_rank(x, hi) - rk_rank(x, lo)
