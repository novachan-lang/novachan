// std/bits/bitscan.nova — Bit-scan operations: count trailing/leading zeros, bit length, find-first-set.
// All functions are pure, deterministic, and import nothing.
// SHIFT SAFETY: >> is arithmetic in NOVA; we only right-shift values that have
// been masked to a positive range so arithmetic == logical shift.
// Convention: bs_ctz(0) = 64, bs_msb_pos(0) = -1, bs_lsb_pos(0) = -1, bs_ffs(0) = 0.

// bs_ctz — count trailing zeros in x (number of consecutive 0 bits from bit 0 upward).
// Returns 64 when x == 0 (all 64 bits are zero / no set bit exists).
fn bs_ctz(x: int) -> int
    if x == 0
        return 64
    let count = 0
    for i in 0..64
        if ((x >> i) & 1) == 1
            return i
    64

// bs_bit_length — position of the highest set bit plus 1.
// Equivalently: the minimum number of bits needed to represent x.
// Returns 0 when x == 0; returns 1 when x == 1; returns 8 when x == 255.
fn bs_bit_length(x: int) -> int
    if x == 0
        return 0
    // Scan from bit 63 downward; first set bit found at position p -> length = p+1.
    let i = 63
    while i >= 0
        if ((x >> i) & 1) == 1
            return i + 1
        i -= 1
    0

// bs_msb_pos — index (0-based) of the most significant (highest) set bit.
// Returns -1 if x == 0 (no set bit).
fn bs_msb_pos(x: int) -> int
    if x == 0
        return 0 - 1
    let i = 63
    while i >= 0
        if ((x >> i) & 1) == 1
            return i
        i -= 1
    0 - 1

// bs_lsb_pos — index (0-based) of the least significant (lowest) set bit.
// Returns -1 if x == 0 (no set bit).
fn bs_lsb_pos(x: int) -> int
    if x == 0
        return 0 - 1
    for i in 0..64
        if ((x >> i) & 1) == 1
            return i
    0 - 1

// bs_ffs — find-first-set: 1-indexed position of the lowest set bit.
// Returns 0 if x == 0 (POSIX ffs convention).
fn bs_ffs(x: int) -> int
    if x == 0
        return 0
    for i in 0..64
        if ((x >> i) & 1) == 1
            return i + 1
    0

// bs_clz — count leading zeros within a width-bit field.
// Masks x to the low `width` bits, then counts zeros above the highest set bit.
// width must be in 1..63 (caller responsibility; we guard width > 63 -> 0).
// bs_clz(0, width) = width (all bits are zero).
fn bs_clz(x: int, width: int) -> int
    if width <= 0
        return 0
    let w = width
    if w > 63
        w = 63
    // Build mask for low w bits: (1 << w) - 1.  Safe because w <= 62 by spec (width<=32).
    let mask = (1 << w) - 1
    let v = x & mask
    if v == 0
        return w
    // Scan from bit (w-1) downward to find the highest set bit.
    let i = w - 1
    while i >= 0
        if ((v >> i) & 1) == 1
            return w - 1 - i
        i -= 1
    w
