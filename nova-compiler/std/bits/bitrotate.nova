// std/bits/bitrotate.nova — Bit rotation (cyclic shift) for arbitrary widths up to 32 bits.
// All functions are pure, deterministic, and import nothing.
// SHIFT SAFETY: width <= 32, so masks and shifts stay well within 62-bit range.
// The low `width` bits of x are first isolated (so the value is non-negative),
// making arithmetic right-shift equivalent to logical right-shift.

// rot_rotl — rotate the low `width` bits of x left by k positions.
// width must be in 1..32. k is reduced modulo width (a full rotation is identity).
// The result fits in width bits (return value is in [0, 2^width - 1]).
fn rot_rotl(x: int, k: int, width: int) -> int
    // Build the width-bit mask.  width <= 32 so (1 << width) is safe (max shift=32).
    // Special-case width == 32 to avoid 1<<32 which gives 2^32 (fine here, but keep explicit).
    let mask = (1 << width) - 1
    let v = x & mask
    let r = k - (k / width) * width
    if r == 0
        return v
    let hi = (v << r) & mask
    // v is non-negative (top bits zero), so arithmetic >> == logical >>
    let lo = v >> (width - r)
    hi | lo

// rot_rotr — rotate the low `width` bits of x right by k positions.
// width must be in 1..32. k is reduced modulo width (a full rotation is identity).
// The result fits in width bits (return value is in [0, 2^width - 1]).
fn rot_rotr(x: int, k: int, width: int) -> int
    let mask = (1 << width) - 1
    let v = x & mask
    let r = k - (k / width) * width
    if r == 0
        return v
    // v is non-negative (top bits zero), so arithmetic >> == logical >>
    let lo = v >> r
    let hi = (v << (width - r)) & mask
    lo | hi
