// sched_hrrn — Highest Response Ratio Next (HRRN) non-preemptive CPU scheduler.
// Process format: [arrival, burst]. PID = index in input list.
// Response ratio = (wait + burst) / burst; ties broken by lowest PID.
// Ratios compared by cross-multiplication (integer-exact, no floats).
//
// Public API:
//   hr_completion_times(procs) -> list  per-pid completion time
//   hr_order(procs)            -> list  PID sequence in which processes ran
//   hr_waiting_times(procs)    -> list  per-pid waiting time = completion - arrival - burst

// _hr_abs: absolute value of integer.
fn _hr_abs(x) -> int
    -x if x < 0 else x

// _hr_pick_highest_rr: at current time t, among arrived and unfinished processes,
// pick the one with the highest response ratio (wait+burst)/burst.
// Ties broken by lowest PID.
// Returns -1 if no process has arrived.
fn _hr_pick_highest_rr(procs, done, t) -> int
    let n = len(procs)
    let best_pid = -1
    // best ratio stored as numerator/denominator for cross-multiply comparison
    let best_num = 0
    let best_den = 1
    for i in 0..n
        if done[i] == 0
            let arr = procs[i][0]
            let burst = procs[i][1]
            if arr <= t
                let wait = t - arr
                let ratio_num = wait + burst
                let ratio_den = burst
                // compare ratio_num/ratio_den > best_num/best_den
                // i.e. ratio_num * best_den > best_num * ratio_den
                let lhs = ratio_num * best_den
                let rhs = best_num * ratio_den
                if best_pid < 0 or lhs > rhs
                    best_pid = i
                    best_num = ratio_num
                    best_den = ratio_den
    return best_pid

// _hr_next_arrival: find the earliest future arrival time among not-yet-done processes
// (used when CPU is idle).
fn _hr_next_arrival(procs, done) -> int
    let n = len(procs)
    let best = -1
    for i in 0..n
        if done[i] == 0
            let arr = procs[i][0]
            if best < 0 or arr < best
                best = arr
    return best

// _hr_run: core HRRN simulation.
// Returns [completion_times, order].
fn _hr_run(procs) -> list
    let n = len(procs)
    let completion = [0 for i in 0..n]
    let done = [0 for i in 0..n]
    let order = []
    let t = 0
    let finished = 0
    while finished < n
        let pid = _hr_pick_highest_rr(procs, done, t)
        if pid < 0
            // CPU idle: advance to the next arrival
            let nxt = _hr_next_arrival(procs, done)
            t = nxt
        if pid >= 0
            let burst = procs[pid][1]
            t += burst
            completion[pid] = t
            done[pid] = 1
            push(order, pid)
            finished += 1
    return [completion, order]

// hr_completion_times: return per-pid completion time for HRRN schedule.
fn hr_completion_times(procs) -> list
    if len(procs) == 0
        return []
    let res = _hr_run(procs)
    return res[0]

// hr_order: return the PID sequence in which HRRN chose to run processes.
fn hr_order(procs) -> list
    if len(procs) == 0
        return []
    let res = _hr_run(procs)
    return res[1]

// hr_waiting_times: return per-pid waiting time = completion - arrival - burst.
fn hr_waiting_times(procs) -> list
    if len(procs) == 0
        return []
    let ct = hr_completion_times(procs)
    return [ct[i] - procs[i][0] - procs[i][1] for i in 0..len(procs)]
