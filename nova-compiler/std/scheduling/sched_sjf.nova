// sched_sjf — Shortest Job First, non-preemptive CPU scheduling.
//
// Among all processes that have arrived at the current time, pick the one with
// the smallest burst. Ties broken by lowest PID (input index). CPU idles when
// no process has yet arrived.
//
// Each process is [arrival, burst].
//
// Public API:
//   sj_completion_times(procs) -> list   completion time per PID
//   sj_waiting_times(procs)    -> list   waiting time per PID (= completion - arrival - burst)
//   sj_order(procs)            -> list   PIDs in execution order

// _sj_compute: run the SJF scheduler, returns [completion_list, order_list].
fn _sj_compute(procs)
    let n = len(procs)
    let completion = []
    let exec_order = []
    let done = []
    let i = 0
    while i < n
        push(completion, 0)
        push(done, 0)
        i = i + 1
    if n == 0
        let result = []
        push(result, completion)
        push(result, exec_order)
        return result
    let time = 0
    let finished = 0
    while finished < n
        // find earliest arrival among not-done processes (to detect idle)
        let min_arr = -1
        let j = 0
        while j < n
            if done[j] == 0
                if min_arr == -1 or procs[j][0] < min_arr
                    min_arr = procs[j][0]
            j = j + 1
        // advance time if needed (idle gap)
        if time < min_arr
            time = min_arr
        // pick shortest burst among arrived, not-done; tie by lowest index
        let best = -1
        let k = 0
        while k < n
            if done[k] == 0 and procs[k][0] <= time
                if best == -1
                    best = k
                else
                    let bb = procs[best][1]
                    let kb = procs[k][1]
                    let pick = false
                    if kb < bb
                        pick = true
                    if kb == bb and k < best
                        pick = true
                    if pick
                        best = k
            k = k + 1
        // run best to completion
        time = time + procs[best][1]
        completion[best] = time
        done[best] = 1
        push(exec_order, best)
        finished = finished + 1
    let result = []
    push(result, completion)
    push(result, exec_order)
    return result

// sj_completion_times: completion time per PID in input order.
fn sj_completion_times(procs)
    let r = _sj_compute(procs)
    return r[0]

// sj_waiting_times: waiting time per PID = completion - arrival - burst.
fn sj_waiting_times(procs)
    let n = len(procs)
    let r = _sj_compute(procs)
    let comp = r[0]
    let result = []
    let i = 0
    while i < n
        let w = comp[i] - procs[i][0] - procs[i][1]
        push(result, w)
        i = i + 1
    return result

// sj_order: PIDs in the order they were scheduled.
fn sj_order(procs)
    let r = _sj_compute(procs)
    return r[1]
