// std/scheduling/bankers.nova
// Banker's deadlock-avoidance algorithm (Silberschatz/Galvin textbook version).
// Determines whether a resource allocation state is safe, and finds a safe sequence.
// Inputs: alloc = per-process allocated resources (list of resource lists),
//         max   = per-process maximum resource claims (same shape),
//         available = currently available resource vector.
// LEAF — imports nothing.

// _bk_num_res: number of resource types (length of any resource vector)
fn _bk_num_res(alloc: list) -> int
    if len(alloc) == 0
        return 0
    return len(alloc[0])

// _bk_can_satisfy: true if need[pid] <= work (element-wise), where need = max - alloc
fn _bk_can_satisfy(alloc: list, max: list, work: list, pid: int) -> bool
    let r = len(work)
    for i in 0..r
        let need_i = max[pid][i] - alloc[pid][i]
        if need_i > work[i]
            return false
    return true

// _bk_add_alloc: work[i] += alloc[pid][i] for all i (release pid's resources into work)
fn _bk_add_alloc(work: list, alloc: list, pid: int)
    let r = len(work)
    for i in 0..r
        work[i] = work[i] + alloc[pid][i]

// _bk_copy_list: shallow copy of a flat integer list
fn _bk_copy_list(xs: list) -> list
    let result = []
    let n = len(xs)
    for i in 0..n
        push(result, xs[i])
    return result

// bk_need: compute need matrix (max - alloc), returned as list of resource lists.
fn bk_need(alloc: list, max: list) -> list
    let np = len(alloc)
    let result = []
    for p in 0..np
        let r = len(alloc[p])
        let row = [max[p][i] - alloc[p][i] for i in 0..r]
        push(result, row)
    return result

// bk_is_safe: true if the current state is safe (a safe sequence exists).
// Safety algorithm: greedily find processes whose needs can be satisfied, simulate
// their completion, and repeat until all finish or no progress can be made.
fn bk_is_safe(alloc: list, max: list, available: list) -> bool
    let np = len(alloc)
    if np == 0
        return true
    let work = _bk_copy_list(available)
    // finished[p] = 0 means not yet completed
    let finished = []
    let p = 0
    while p < np
        push(finished, 0)
        p += 1
    let done_count = 0
    let progress = true
    while progress and done_count < np
        progress = false
        p = 0
        while p < np
            if finished[p] == 0
                if _bk_can_satisfy(alloc, max, work, p)
                    _bk_add_alloc(work, alloc, p)
                    finished[p] = 1
                    done_count += 1
                    progress = true
            p += 1
    if done_count == np
        return true
    return false

// bk_safe_sequence: returns one safe ordering of all process PIDs (lowest-index-first
// greedy), or [] if no safe sequence exists.
fn bk_safe_sequence(alloc: list, max: list, available: list) -> list
    let np = len(alloc)
    if np == 0
        return []
    let work = _bk_copy_list(available)
    let finished = []
    let p = 0
    while p < np
        push(finished, 0)
        p += 1
    let sequence = []
    let done_count = 0
    let progress = true
    while progress and done_count < np
        progress = false
        p = 0
        while p < np
            if finished[p] == 0
                if _bk_can_satisfy(alloc, max, work, p)
                    _bk_add_alloc(work, alloc, p)
                    finished[p] = 1
                    push(sequence, p)
                    done_count += 1
                    progress = true
            p += 1
    if done_count == np
        return sequence
    // unsafe: return empty
    let empty = []
    return empty
