// disk_fcfs_sstf — Disk arm scheduling: FCFS and SSTF.
// Computes total head movement (sum of absolute seek distances).
//
// Public API:
//   dk_fcfs(requests, head)       -> int   total movement serving requests in given order
//   dk_sstf(requests, head)       -> int   total movement using Shortest Seek Time First
//   dk_fcfs_order(requests, head) -> list  visit order (same as requests for FCFS)
//   dk_sstf_order(requests, head) -> list  visit order chosen by SSTF

// _dk_abs: absolute value of integer.
fn _dk_abs(x) -> int
    if x < 0
        return 0 - x
    return x

// dk_fcfs: serve all requests in the given order; return total head movement.
fn dk_fcfs(requests, head) -> int
    let n = len(requests)
    let total = 0
    let cur = head
    let i = 0
    while i < n
        let seek = _dk_abs(requests[i] - cur)
        total = total + seek
        cur = requests[i]
        i = i + 1
    return total

// dk_fcfs_order: return requests in their original order (FCFS serves them as given).
fn dk_fcfs_order(requests, head) -> list
    let out = []
    let i = 0
    while i < len(requests)
        push(out, requests[i])
        i = i + 1
    return out

// _dk_sstf_next: find index of nearest unserved request to cur_head.
// Ties broken by smallest cylinder number.
fn _dk_sstf_next(requests, served, cur_head) -> int
    let n = len(requests)
    let best_idx = -1
    let best_dist = -1
    let best_cyl = -1
    let i = 0
    while i < n
        if served[i] == 0
            let d = _dk_abs(requests[i] - cur_head)
            let pick = 0
            if best_idx < 0
                pick = 1
            if best_idx >= 0 and d < best_dist
                pick = 1
            if best_idx >= 0 and d == best_dist and requests[i] < best_cyl
                pick = 1
            if pick == 1
                best_idx = i
                best_dist = d
                best_cyl = requests[i]
        i = i + 1
    return best_idx

// dk_sstf: serve all requests using Shortest Seek Time First; return total head movement.
fn dk_sstf(requests, head) -> int
    let n = len(requests)
    let served = []
    let i = 0
    while i < n
        push(served, 0)
        i = i + 1
    let total = 0
    let cur = head
    let count = 0
    while count < n
        let idx = _dk_sstf_next(requests, served, cur)
        let seek = _dk_abs(requests[idx] - cur)
        total = total + seek
        cur = requests[idx]
        served[idx] = 1
        count = count + 1
    return total

// dk_sstf_order: return the cylinder visit sequence chosen by SSTF.
fn dk_sstf_order(requests, head) -> list
    let n = len(requests)
    let served = []
    let i = 0
    while i < n
        push(served, 0)
        i = i + 1
    let out = []
    let cur = head
    let count = 0
    while count < n
        let idx = _dk_sstf_next(requests, served, cur)
        push(out, requests[idx])
        cur = requests[idx]
        served[idx] = 1
        count = count + 1
    return out
