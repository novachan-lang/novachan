// sched_srtf — Shortest Remaining Time First, preemptive CPU scheduling.
//
// At each unit of time (and at each new arrival), the process with the smallest
// remaining burst is selected. Ties broken by lowest PID. CPU idles when no
// process has arrived yet.
//
// Each process is [arrival, burst].
//
// Public API:
//   sr_completion_times(procs) -> list   completion time per PID
//   sr_waiting_times(procs)    -> list   waiting time per PID (= completion - arrival - burst)

// _sr_min_arrival: smallest arrival time among not-done processes; -1 if all done.
fn _sr_min_arrival(procs, done)
    let n = len(procs)
    let mn = -1
    for i in 0..n
        if done[i] == 0
            if mn == -1 or procs[i][0] < mn
                mn = procs[i][0]
    return mn

// _sr_pick: pick the PID with smallest remaining burst among arrived+not-done; ties by lowest PID.
fn _sr_pick(procs, rem, done, time)
    let n = len(procs)
    let best = -1
    for i in 0..n
        if done[i] == 0 and procs[i][0] <= time
            if best == -1
                best = i
            else
                let rb = rem[best]
                let ri = rem[i]
                let pick = false
                if ri < rb
                    pick = true
                if ri == rb and i < best
                    pick = true
                if pick
                    best = i
    return best

// _sr_next_arrival: smallest arrival > time among not-done, or -1 if none.
fn _sr_next_arrival(procs, done, time)
    let n = len(procs)
    let mn = -1
    for i in 0..n
        if done[i] == 0 and procs[i][0] > time
            if mn == -1 or procs[i][0] < mn
                mn = procs[i][0]
    return mn

// _sr_compute: run SRTF, returns completion list indexed by PID.
fn _sr_compute(procs)
    let n = len(procs)
    let completion = []
    let rem = []
    let done = []
    for i in 0..n
        push(completion, 0)
        push(rem, procs[i][1])
        push(done, 0)
    if n == 0
        return completion
    // find start time
    let time = _sr_min_arrival(procs, done)
    let finished = 0
    while finished < n
        let pid = _sr_pick(procs, rem, done, time)
        if pid == -1
            // no process ready: jump to next arrival
            let nxt = _sr_next_arrival(procs, done, time)
            time = nxt
            pid = _sr_pick(procs, rem, done, time)
        // determine how long we can run this pid without preemption:
        // run until its remaining time hits 0, OR a new process arrives with shorter remaining time.
        // scan for soonest disruptive arrival (a process arriving with burst < rem[pid]).
        let run_until = time + rem[pid]
        for j in 0..n
            if done[j] == 0 and j != pid and procs[j][0] > time and procs[j][0] < run_until
                // if the arriving process could preempt: its remaining = burst
                // preempt if burst < rem[pid] - (arrival - time)
                let elapsed = procs[j][0] - time
                let remaining_at_arrival = rem[pid] - elapsed
                if procs[j][1] < remaining_at_arrival
                    run_until = procs[j][0]
                if procs[j][1] == remaining_at_arrival and j < pid
                    run_until = procs[j][0]
        let delta = run_until - time
        rem[pid] = rem[pid] - delta
        time = run_until
        if rem[pid] == 0
            done[pid] = 1
            completion[pid] = time
            finished = finished + 1
    return completion

// sr_completion_times: completion time per PID in input order.
fn sr_completion_times(procs)
    return _sr_compute(procs)

// sr_waiting_times: waiting time per PID = completion - arrival - burst.
fn sr_waiting_times(procs)
    let n = len(procs)
    let comp = _sr_compute(procs)
    let result = []
    for i in 0..n
        let w = comp[i] - procs[i][0] - procs[i][1]
        push(result, w)
    return result
