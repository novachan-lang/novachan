// std/game/mastermind.nova — Mastermind scoring.
//
// mastermind_score(guess, secret) -> list [black, white]
//   black = exact position matches (right color, right position)
//   white = right color, wrong position — not double-counted
//
// Algorithm (standard Mastermind):
//   1. Count black pegs (exact matches).
//   2. For white pegs: for each color, min(count_in_guess, count_in_secret) gives
//      total matches; subtract the blacks for that color to get whites.
//      Sum whites across all colors.
// LEAF — imports nothing.

fn mastermind_score(guess, secret)
    let n = len(guess)
    let black = 0

    // Per-color excess counts (after removing exact matches)
    // We use two frequency dicts: one for guess, one for secret.
    // Keys are string(color_value).
    let freq_g = {}
    let freq_s = {}

    for i in 0..n
        let g = guess[i]
        let s = secret[i]
        if g == s
            black += 1
        else
            // Tally non-matching positions for white calculation
            let kg = str(g)
            if kg in freq_g
                freq_g[kg] += 1
            else
                freq_g[kg] = 1
            let ks = str(s)
            if ks in freq_s
                freq_s[ks] += 1
            else
                freq_s[ks] = 1

    // White = sum over all colors of min(freq_g[color], freq_s[color])
    let white = 0
    let ks = keys(freq_g)
    for j in 0..len(ks)
        let k = ks[j]
        if k in freq_s
            let mg = freq_g[k]
            let ms = freq_s[k]
            white += mg if mg < ms else ms

    return [black, white]
