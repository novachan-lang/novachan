// std/game/cribbage -- Cribbage hand scoring (4 hand cards + 1 starter).
// LEAF -- imports NOTHING.
//
// Card convention (shared across std/game/):
//   A card is a 2-element list [rank, suit].
//   rank 2..14 (11=J, 12=Q, 13=K, 14=A high). suit 0..3 (0=C,1=D,2=H,3=S).
//
// Cribbage point values:
//   Fifteens  : every subset of the 5 cards (hand4+starter) summing to 15 = 2 pts.
//               Rank values for counting: 2..9 face value; 10,J,Q,K = 10; A = 1.
//   Pairs     : every pair of equal-rank cards = 2 pts (3-of-a-kind=6, 4-of-a-kind=12).
//   Runs      : longest run(s) of 3+ consecutive ranks = 1 pt/card.
//               With duplicates a run is multiplied (e.g., double run of 3 = 6 pts).
//   Flush     : all 4 hand cards same suit = 4 pts;
//               if starter also matches = 5 pts (starter alone does NOT make flush).
//   His nobs  : Jack in hand whose suit matches starter suit = 1 pt.
//
// Public API:
//   crib_score(hand4, starter)  -> int   total score for the hand
//   crib_fifteens(cards5)       -> int   points from fifteens only (multiple of 2)
//   crib_pairs(cards5)          -> int   points from pairs only
//   crib_runs(cards5)           -> int   points from runs only

// ── private helpers ────────────────────────────────────────────────────────

// _cb_rank(card) -- extract rank field.
fn _cb_rank(card) -> int
    card[0]

// _cb_suit(card) -- extract suit field.
fn _cb_suit(card) -> int
    card[1]

// _cb_val(card) -- cribbage counting value: A=1, 2-9 face, T/J/Q/K=10.
fn _cb_val(card) -> int
    let r = card[0]
    if r >= 10
        return 10
    r

// _cb_val_by_rank(r) -- same but takes rank int directly (for subset enumeration).
fn _cb_val_by_rank(r) -> int
    if r >= 10
        return 10
    r

// _cb_subset_sum(vals, mask) -- sum of elements whose bit is set in mask.
// vals is a list of 5 ints (counting values). mask is 0..31.
fn _cb_subset_sum(vals, mask) -> int
    let s = 0
    if mask >= 16
        s += vals[4]
    let m4 = mask
    if m4 >= 16
        m4 -= 16
    if m4 >= 8
        s += vals[3]
    let m3 = m4
    if m3 >= 8
        m3 -= 8
    if m3 >= 4
        s += vals[2]
    let m2 = m3
    if m2 >= 4
        m2 -= 4
    if m2 >= 2
        s += vals[1]
    let m1 = m2
    if m1 >= 2
        m1 -= 2
    if m1 >= 1
        s += vals[0]
    s

// _cb_popcount(mask) -- number of set bits in mask (0..31).
fn _cb_popcount(mask) -> int
    let c = 0
    let m = mask
    if m >= 16
        c += 1
        m -= 16
    if m >= 8
        c += 1
        m -= 8
    if m >= 4
        c += 1
        m -= 4
    if m >= 2
        c += 1
        m -= 2
    if m >= 1
        c += 1
    c

// _cb_sort5_ranks(r0,r1,r2,r3,r4) -- insertion-sort 5 ranks ascending; return list.
fn _cb_sort5_ranks(r0, r1, r2, r3, r4) -> list
    let a = []
    push(a, r0)
    push(a, r1)
    push(a, r2)
    push(a, r3)
    push(a, r4)
    for i in 1..5
        let key = a[i]
        let j = i - 1
        while j >= 0 and a[j] > key
            a[j + 1] = a[j]
            j -= 1
        a[j + 1] = key
    a

// _cb_freq5(ranks_sorted) -- build frequency list for 5 sorted ranks.
// Returns list of [rank, count] pairs in ascending rank order (no duplicates).
fn _cb_freq5(sr) -> list
    let result = []
    let i = 0
    while i < 5
        let r = sr[i]
        let cnt = 1
        while i + cnt < 5 and sr[i + cnt] == r
            cnt += 1
        let pair = []
        push(pair, r)
        push(pair, cnt)
        push(result, pair)
        i += cnt
    result

// ── Public scoring functions ───────────────────────────────────────────────

// crib_fifteens(cards5) -> int
// Score points from all subsets of the 5 cards that sum to 15.
// Each such subset scores 2 pts.
fn crib_fifteens(cards5) -> int
    let v0 = _cb_val(cards5[0])
    let v1 = _cb_val(cards5[1])
    let v2 = _cb_val(cards5[2])
    let v3 = _cb_val(cards5[3])
    let v4 = _cb_val(cards5[4])
    let vals = []
    push(vals, v0)
    push(vals, v1)
    push(vals, v2)
    push(vals, v3)
    push(vals, v4)
    let pts = 0
    // Iterate all non-empty subsets: mask 1..31
    // We need at least 2 cards summing to 15, so skip single-card masks unless val==15
    for mask in 1..32
        if _cb_popcount(mask) >= 2
            if _cb_subset_sum(vals, mask) == 15
                pts += 2
    pts

// crib_pairs(cards5) -> int
// Score points from all pairs of equal-rank cards.
// Each pair scores 2 pts (3-of-a-kind = 3 pairs = 6; 4-of-a-kind = 6 pairs = 12).
fn crib_pairs(cards5) -> int
    let pts = 0
    let i = 0
    while i < 4
        let j = i + 1
        while j < 5
            if _cb_rank(cards5[i]) == _cb_rank(cards5[j])
                pts += 2
            j += 1
        i += 1
    pts

// crib_runs(cards5) -> int
// Score points from runs (sequences of 3+ consecutive ranks).
// Duplicates multiply the run (double run of 3 = 2*3=6, triple run of 3 = 3*3=9, etc.).
// Only the LONGEST run(s) score -- but in cribbage ALL qualifying runs count,
// so we find the best run length and tally its multiplied score.
fn crib_runs(cards5) -> int
    let r0 = _cb_rank(cards5[0])
    let r1 = _cb_rank(cards5[1])
    let r2 = _cb_rank(cards5[2])
    let r3 = _cb_rank(cards5[3])
    let r4 = _cb_rank(cards5[4])
    let sr = _cb_sort5_ranks(r0, r1, r2, r3, r4)
    let freq = _cb_freq5(sr)
    // freq = list of [rank, count] in ascending order of rank.
    // We look for the longest run of consecutive distinct ranks; the multiplier
    // is the product of the frequencies of ranks in that run.
    // Strategy: try run length 5, 4, 3; return first (longest) that has a
    // non-zero multiplier (i.e., whose constituent ranks all appear).
    let nf = len(freq)

    // Check full-5-card run: all 5 distinct ranks consecutive.
    if nf == 5
        let ok = 1
        let fi = 0
        while fi < 4
            if freq[fi + 1][0] != freq[fi][0] + 1
                ok = 0
            fi += 1
        if ok == 1
            return 5

    // Check run of 4: any 4 consecutive distinct ranks from freq.
    // With 5 cards there can be at most 1 rank appearing twice; a run-of-4 needs
    // 4 distinct ranks. We try starting positions fi=0 and fi=1 in freq.
    if nf >= 4
        // Try fi=0..nf-4 (up to 2 starting positions with nf<=5)
        let start4 = 0
        while start4 <= nf - 4
            let ok4 = 1
            let ki = start4
            while ki < start4 + 3
                if freq[ki + 1][0] != freq[ki][0] + 1
                    ok4 = 0
                ki += 1
            if ok4 == 1
                // multiplier = product of counts of the 4 ranks in this run
                let mult4 = freq[start4][1] * freq[start4 + 1][1] * freq[start4 + 2][1] * freq[start4 + 3][1]
                return mult4 * 4
            start4 += 1

    // Check run of 3: any 3 consecutive distinct ranks.
    if nf >= 3
        let start3 = 0
        while start3 <= nf - 3
            let ok3 = 1
            let ki = start3
            while ki < start3 + 2
                if freq[ki + 1][0] != freq[ki][0] + 1
                    ok3 = 0
                ki += 1
            if ok3 == 1
                let mult3 = freq[start3][1] * freq[start3 + 1][1] * freq[start3 + 2][1]
                return mult3 * 3
            start3 += 1

    0

// crib_score(hand4, starter) -> int
// Total cribbage score for a 4-card hand + 1 starter card.
// Scores fifteens + pairs + runs + flush + his nobs.
fn crib_score(hand4, starter) -> int
    // Build 5-card combined list.
    let cards5 = []
    push(cards5, hand4[0])
    push(cards5, hand4[1])
    push(cards5, hand4[2])
    push(cards5, hand4[3])
    push(cards5, starter)

    let pts = 0

    // Fifteens
    pts += crib_fifteens(cards5)

    // Pairs
    pts += crib_pairs(cards5)

    // Runs
    pts += crib_runs(cards5)

    // Flush: all 4 hand cards same suit?
    let s0 = _cb_suit(hand4[0])
    let s1 = _cb_suit(hand4[1])
    let s2 = _cb_suit(hand4[2])
    let s3 = _cb_suit(hand4[3])
    if s0 == s1 and s1 == s2 and s2 == s3
        // 4-card flush (hand only)
        if _cb_suit(starter) == s0
            // 5-card flush
            pts += 5
        else
            pts += 4

    // His nobs: Jack in hand matching starter suit.
    let starter_suit = _cb_suit(starter)
    for hi in 0..4
        if _cb_rank(hand4[hi]) == 11 and _cb_suit(hand4[hi]) == starter_suit
            pts += 1

    pts
