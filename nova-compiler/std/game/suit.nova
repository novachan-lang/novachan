// std/game/suit.nova — Suit and rank utilities for card game modules.
// LEAF — imports NOTHING.
//
// Card convention: a card is a 2-element list [rank, suit].
//   rank: 2..14  (11=J, 12=Q, 13=K, 14=A high)
//   suit: 0..3   (0=clubs, 1=diamonds, 2=hearts, 3=spades)
//
// Public API:
//   suit_symbol(suit)      -> string  (0->"C", 1->"D", 2->"H", 3->"S")
//   suit_color(suit)       -> string  ("red" for D/H, "black" for C/S)
//   rank_char(rank)        -> string  (2->"2"..9->"9", 10->"T", 11->"J", 12->"Q", 13->"K", 14->"A")
//   sort_by_rank(cards)    -> list    ascending by rank (stable: ties keep original order)
//   sort_by_suit(cards)    -> list    ascending by suit then rank
//   group_by_suit(cards)   -> list    4-element list: [clubs, diamonds, hearts, spades]

// suit_symbol — convert suit integer to single-character symbol.
// 0->"C", 1->"D", 2->"H", 3->"S". Returns "?" for invalid input.
fn suit_symbol(suit: int) -> string
    let result = "?"
    if suit == 0
        result = "C"
    if suit == 1
        result = "D"
    if suit == 2
        result = "H"
    if suit == 3
        result = "S"
    result

// suit_color — return "red" for diamonds/hearts, "black" for clubs/spades.
// Returns "?" for invalid suit.
fn suit_color(suit: int) -> string
    let result = "?"
    if suit == 0
        result = "black"
    if suit == 1
        result = "red"
    if suit == 2
        result = "red"
    if suit == 3
        result = "black"
    result

// rank_char — convert rank integer to single-character string.
// 2-9->"2"-"9", 10->"T", 11->"J", 12->"Q", 13->"K", 14->"A".
// Returns "?" for invalid rank.
fn rank_char(rank: int) -> string
    let result = "?"
    if rank == 2
        result = "2"
    if rank == 3
        result = "3"
    if rank == 4
        result = "4"
    if rank == 5
        result = "5"
    if rank == 6
        result = "6"
    if rank == 7
        result = "7"
    if rank == 8
        result = "8"
    if rank == 9
        result = "9"
    if rank == 10
        result = "T"
    if rank == 11
        result = "J"
    if rank == 12
        result = "Q"
    if rank == 13
        result = "K"
    if rank == 14
        result = "A"
    result

// _copy_cards — return a shallow copy of a card list (each card is [rank,suit]).
fn _copy_cards(cards: list) -> list
    let result = []
    let n = len(cards)
    let i = 0
    while i < n
        let c = cards[i]
        let nc = [c[0], c[1]]
        push(result, nc)
        i = i + 1
    result

// _rank_key — compute sort key: rank only.
fn _rank_key(card: list) -> int
    card[0]

// _suit_rank_key — compute sort key: suit * 100 + rank.
// Suits 0..3, ranks 2..14 -> unique keys, suit primary, rank secondary.
fn _suit_rank_key(card: list) -> int
    card[1] * 100 + card[0]

// _insertion_sort — in-place insertion sort on cards list using the given key function.
// key_mode: 0 = rank only, 1 = suit*100+rank
fn _insertion_sort(cards: list, key_mode: int)
    let n = len(cards)
    let i = 1
    while i < n
        let cur = cards[i]
        let cur_key = 0
        if key_mode == 0
            cur_key = _rank_key(cur)
        if key_mode == 1
            cur_key = _suit_rank_key(cur)
        // Find insertion point: shift elements right while they are greater.
        // pos tracks where cur will be inserted.
        let pos = 0
        let j = i - 1
        let searching = 1
        while j >= 0 and searching == 1
            let cmp_card = cards[j]
            let cmp_key = 0
            if key_mode == 0
                cmp_key = _rank_key(cmp_card)
            if key_mode == 1
                cmp_key = _suit_rank_key(cmp_card)
            if cmp_key > cur_key
                cards[j + 1] = cmp_card
                j = j - 1
            else
                pos = j + 1
                searching = 0
        if searching == 1
            pos = 0
        cards[pos] = cur
        i = i + 1

// sort_by_rank — return a new list of cards sorted ascending by rank.
// Ties preserve relative (original) order (stable via insertion sort).
fn sort_by_rank(cards: list) -> list
    let result = _copy_cards(cards)
    _insertion_sort(result, 0)
    result

// sort_by_suit — return a new list of cards sorted by suit (primary, ascending)
// then rank (secondary, ascending). Ties preserve relative order.
fn sort_by_suit(cards: list) -> list
    let result = _copy_cards(cards)
    _insertion_sort(result, 1)
    result

// group_by_suit — partition cards into 4 lists by suit.
// Returns [[clubs],[diamonds],[hearts],[spades]].
// Each sub-list preserves the original relative order of those cards.
fn group_by_suit(cards: list) -> list
    let clubs = []
    let diamonds = []
    let hearts = []
    let spades = []
    let n = len(cards)
    let i = 0
    while i < n
        let c = cards[i]
        let s = c[1]
        let nc = [c[0], c[1]]
        if s == 0
            push(clubs, nc)
        if s == 1
            push(diamonds, nc)
        if s == 2
            push(hearts, nc)
        if s == 3
            push(spades, nc)
        i = i + 1
    let result = []
    push(result, clubs)
    push(result, diamonds)
    push(result, hearts)
    push(result, spades)
    result
