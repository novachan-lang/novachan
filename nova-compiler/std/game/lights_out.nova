// std/game/lights_out.nova — Lights Out puzzle solver via GF(2) Gaussian elimination.
//
// Board: flat list of n*n integers, each 0 or 1.
// Pressing cell i toggles cell i and its orthogonal neighbors.
//
// Public API:
//   lights_out_solve(board, n) -> list  0/1 list of which cells to press; [] if unsolvable
//   lights_out_apply(board, n, presses) -> list  resulting board after applying presses
//
// Algorithm:
//   Build the n² x n² toggle matrix A over GF(2), then augment with b (the board).
//   Gaussian elimination with column pivoting over GF(2).
//   Back-substitute to get the solution vector x.
//   If the system is inconsistent, return [].
//
// Internal representation:
//   Augmented matrix rows: each row is a list of (n*n + 1) values in GF(2).
//   Row r represents: A[r][0]*x[0] + ... + A[r][n²-1]*x[n²-1] = b[r]
//   The last column (index n²) holds the RHS (board value at cell r).

// _cell_neighbors — return list of cell indices toggled when cell c is pressed (includes c itself).
fn _cell_neighbors(c: int, n: int) -> list
    let result = []
    push(result, c)
    let row = c / n
    let col = c % n
    // up
    if row > 0
        push(result, c - n)
    // down
    if row < n - 1
        push(result, c + n)
    // left
    if col > 0
        push(result, c - 1)
    // right
    if col < n - 1
        push(result, c + 1)
    result

// _build_matrix — build augmented matrix [A | b] of size n² x (n²+1) over GF(2).
// Row r: column j = 1 if pressing cell j toggles cell r; last col = board[r].
fn _build_matrix(board: list, n: int) -> list
    let sz = n * n
    let mat = []
    let r = 0
    while r < sz
        let row = []
        let c = 0
        while c < sz
            push(row, 0)
            c += 1
        // last column = RHS = board[r]
        push(row, board[r])
        // mark which columns (pressed cells) toggle row r
        // pressing cell c toggles r iff r is in _cell_neighbors(c, n)
        // equivalently: c == r, or c is a neighbor of r
        let rc = r / n
        let cc_r = r % n
        // self
        row[r] = 1
        // up neighbor of r
        if rc > 0
            row[r - n] = 1
        // down neighbor of r
        if rc < n - 1
            row[r + n] = 1
        // left neighbor of r
        if cc_r > 0
            row[r - 1] = 1
        // right neighbor of r
        if cc_r < n - 1
            row[r + 1] = 1
        push(mat, row)
        r += 1
    mat

// _gf2_elim — Gaussian elimination over GF(2) on the augmented matrix (in place).
// Returns the pivot column list (length = number of pivots found).
fn _gf2_elim(mat: list, n: int) -> list
    let sz = n * n
    let pivot_row = 0
    let pivots = []   // stores pivot column indices in order
    let col = 0
    while col < sz and pivot_row < sz
        // find a row >= pivot_row with a 1 in this column
        let found_r = -1
        let scan = pivot_row
        while scan < sz and found_r < 0
            if mat[scan][col] == 1
                found_r = scan
            scan += 1
        if found_r < 0
            // no pivot in this column; move on
            col += 1
        else
            // swap found_r with pivot_row
            if found_r != pivot_row
                let tmp = mat[pivot_row]
                mat[pivot_row] = mat[found_r]
                mat[found_r] = tmp
            // record pivot
            push(pivots, col)
            // eliminate all other rows
            for er in 0..sz
                if er != pivot_row and mat[er][col] == 1
                    // XOR row er with pivot_row
                    let ecols = sz + 1
                    let ec = 0
                    while ec < ecols
                        mat[er][ec] = (mat[er][ec] + mat[pivot_row][ec]) % 2
                        ec += 1
            pivot_row += 1
            col += 1
    pivots

// lights_out_solve — solve the Lights Out puzzle.
// Returns a 0/1 list of length n*n indicating which cells to press.
// Returns [] (empty list) if the puzzle is unsolvable.
fn lights_out_solve(board: list, n: int) -> list
    let sz = n * n
    let mat = _build_matrix(board, n)
    let pivots = _gf2_elim(mat, n)
    let np = len(pivots)

    // check consistency: for every non-pivot row, the RHS must be 0
    // after elimination, pivot rows have exactly one leading 1; the rest are zero-rows.
    // we need to check: for each row r that has all-zero in columns 0..sz-1, mat[r][sz] must be 0.
    for r in 0..sz
        let all_zero = true
        let c = 0
        while c < sz
            if mat[r][c] == 1
                all_zero = false
            c += 1
        if all_zero and mat[r][sz] == 1
            // inconsistent
            let empty = []
            return empty

    // build solution: for free variables, set x=0 (minimum presses heuristic).
    // pivot columns get their value from the RHS of the reduced row.
    let sol = [0 for i in 0..sz]
    // for each pivot, find its row (after elimination, pivot column p has a unique 1 in some row)
    for pi in 0..np
        let pc = pivots[pi]
        // find the row that has the pivot (leading 1 in column pc)
        // after RREF, each pivot column has exactly one 1
        let pr = 0
        while pr < sz
            if mat[pr][pc] == 1
                sol[pc] = mat[pr][sz]
                pr = sz   // break
            pr += 1
    sol

// lights_out_apply — apply a set of presses to a board.
// presses: 0/1 list of which cells to press. Returns the resulting board.
fn lights_out_apply(board: list, n: int, presses: list) -> list
    let sz = n * n
    // copy board
    let result = [board[i] for i in 0..sz]
    // apply each press
    for p in 0..sz
        if presses[p] == 1
            let nb = _cell_neighbors(p, n)
            let j = 0
            while j < len(nb)
                let cell = nb[j]
                result[cell] = (result[cell] + 1) % 2
                j += 1
    result
