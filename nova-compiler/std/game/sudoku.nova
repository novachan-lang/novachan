// std/game/sudoku.nova — Backtracking Sudoku solver.
//
// Board layout: a flat list of 81 ints, row-major order.
//   board[r*9 + c] = digit at row r, col c (0 = empty).
//
// Public API:
//   sudoku_solve(board) -> list
//       Returns the solved board (a new list), or the input board if unsolvable.
//   sudoku_is_solved(board) -> bool
//       Returns true if every cell is filled AND no duplicates exist in any
//       row, column, or 3x3 box.

// Build a bitmask of digits already used in a 9-cell house.
// Bit d is set if digit d is present (d=1..9).
fn _house_mask(board, i0, i1, i2, i3, i4, i5, i6, i7, i8)
    let mask = 0
    let v = board[i0]
    if v > 0
        mask = mask | (1 << v)
    v = board[i1]
    if v > 0
        mask = mask | (1 << v)
    v = board[i2]
    if v > 0
        mask = mask | (1 << v)
    v = board[i3]
    if v > 0
        mask = mask | (1 << v)
    v = board[i4]
    if v > 0
        mask = mask | (1 << v)
    v = board[i5]
    if v > 0
        mask = mask | (1 << v)
    v = board[i6]
    if v > 0
        mask = mask | (1 << v)
    v = board[i7]
    if v > 0
        mask = mask | (1 << v)
    v = board[i8]
    if v > 0
        mask = mask | (1 << v)
    mask

// Compute the OR of all three house masks for cell idx.
fn _conflicts(board, idx)
    let r = idx / 9
    let c = idx - r * 9
    let rbase = r * 9
    let rmask = _house_mask(board, rbase+0, rbase+1, rbase+2, rbase+3, rbase+4, rbase+5, rbase+6, rbase+7, rbase+8)
    let cmask = _house_mask(board, c+0, c+9, c+18, c+27, c+36, c+45, c+54, c+63, c+72)
    let br = (r / 3) * 3
    let bc = (c / 3) * 3
    let b0 = br * 9 + bc
    let bmask = _house_mask(board, b0+0, b0+1, b0+2, b0+9, b0+10, b0+11, b0+18, b0+19, b0+20)
    rmask | cmask | bmask

// Find the first empty cell (0). Returns -1 if none.
fn _find_empty(board)
    let i = 0
    let result = -1
    while i < 81 and result == -1
        if board[i] == 0
            result = i
        i = i + 1
    result

// Check if bit d is set in mask (d >= 1).
fn _bit_set(mask, d)
    let bit = 1 << d
    let shifted = mask / bit
    let is_odd = shifted - (shifted / 2) * 2
    is_odd == 1

// Recursive backtracking solver.
// work is the mutable board (81-element list).
// Returns 1 if solved, 0 if unsolvable from this state.
fn _bt_solve(work)
    let idx = _find_empty(work)
    if idx == -1
        return 1
    let mask = _conflicts(work, idx)
    let d = 1
    let solved = 0
    while d <= 9 and solved == 0
        if _bit_set(mask, d) == false
            work[idx] = d
            let sub = _bt_solve(work)
            if sub == 1
                solved = 1
            if sub == 0
                work[idx] = 0
        d = d + 1
    solved

// Copy a list of 81 ints.
fn _copy81(src)
    let dst = []
    let i = 0
    while i < 81
        push(dst, src[i])
        i = i + 1
    dst

// Solve a 9x9 Sudoku board.
// Returns the solved board, or the original board if unsolvable.
fn sudoku_solve(board)
    let work = _copy81(board)
    let ok = _bt_solve(work)
    if ok == 1
        return work
    board

// Check a group of 9 cells: all non-zero digits must be in 1-9 with no dups.
fn _check_group9(board, i0, i1, i2, i3, i4, i5, i6, i7, i8)
    let seen = []
    let i = 0
    while i < 10
        push(seen, 0)
        i = i + 1
    let ok = 1
    let v = board[i0]
    if v < 1 or v > 9
        ok = 0
    if ok == 1
        if seen[v] == 1
            ok = 0
    if ok == 1
        seen[v] = 1
    v = board[i1]
    if ok == 1
        if v < 1 or v > 9
            ok = 0
    if ok == 1
        if seen[v] == 1
            ok = 0
    if ok == 1
        seen[v] = 1
    v = board[i2]
    if ok == 1
        if v < 1 or v > 9
            ok = 0
    if ok == 1
        if seen[v] == 1
            ok = 0
    if ok == 1
        seen[v] = 1
    v = board[i3]
    if ok == 1
        if v < 1 or v > 9
            ok = 0
    if ok == 1
        if seen[v] == 1
            ok = 0
    if ok == 1
        seen[v] = 1
    v = board[i4]
    if ok == 1
        if v < 1 or v > 9
            ok = 0
    if ok == 1
        if seen[v] == 1
            ok = 0
    if ok == 1
        seen[v] = 1
    v = board[i5]
    if ok == 1
        if v < 1 or v > 9
            ok = 0
    if ok == 1
        if seen[v] == 1
            ok = 0
    if ok == 1
        seen[v] = 1
    v = board[i6]
    if ok == 1
        if v < 1 or v > 9
            ok = 0
    if ok == 1
        if seen[v] == 1
            ok = 0
    if ok == 1
        seen[v] = 1
    v = board[i7]
    if ok == 1
        if v < 1 or v > 9
            ok = 0
    if ok == 1
        if seen[v] == 1
            ok = 0
    if ok == 1
        seen[v] = 1
    v = board[i8]
    if ok == 1
        if v < 1 or v > 9
            ok = 0
    if ok == 1
        if seen[v] == 1
            ok = 0
    if ok == 1
        seen[v] = 1
    ok

fn sudoku_is_solved(board)
    if len(board) != 81
        return false
    let ok = 1
    // rows
    let r = 0
    while r < 9 and ok == 1
        let base = r * 9
        let g = _check_group9(board, base+0, base+1, base+2, base+3, base+4, base+5, base+6, base+7, base+8)
        if g == 0
            ok = 0
        r = r + 1
    // cols
    let c = 0
    while c < 9 and ok == 1
        let g = _check_group9(board, c+0, c+9, c+18, c+27, c+36, c+45, c+54, c+63, c+72)
        if g == 0
            ok = 0
        c = c + 1
    // boxes
    let br = 0
    while br < 3 and ok == 1
        let bc = 0
        while bc < 3 and ok == 1
            let b0 = br*27 + bc*3
            let g = _check_group9(board, b0+0, b0+1, b0+2, b0+9, b0+10, b0+11, b0+18, b0+19, b0+20)
            if g == 0
                ok = 0
            bc = bc + 1
        br = br + 1
    ok == 1
