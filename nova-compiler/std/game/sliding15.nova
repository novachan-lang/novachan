// std/game/sliding15.nova — 15-puzzle (n-puzzle) utilities.
//
// Board: list of n*n tiles (integers), where 0 = blank.
// Tile values: 1..(n*n-1), then 0.
//
// Public API:
//   sliding_is_goal(board, n) -> bool   1 if board == [1,2,...,n*n-1,0]
//   sliding_solvable(board, n) -> bool  1 if the board is reachable from goal
//   sliding_neighbors(board, n) -> list list of boards reachable by one blank move

// Returns 1 if board is in goal state: [1,2,...,n*n-1,0]
fn sliding_is_goal(board, n)
    let total = n * n
    let i = 0
    while i < total - 1
        if board[i] != i + 1
            return 0
        i = i + 1
    if board[total - 1] != 0
        return 0
    return 1

// Private: count inversions in board (ignoring the blank tile 0).
// An inversion is a pair (i,j) with i<j and board[i]>board[j], both nonzero.
fn _s15_inversions(board, total)
    let inv = 0
    for i in 0..total
        let vi = board[i]
        if vi != 0
            let j = i + 1
            while j < total
                let vj = board[j]
                if vj != 0 and vi > vj
                    inv = inv + 1
                j = j + 1
    return inv

// Private: find row of the blank (0) from the bottom (1-indexed).
// Row 1 = bottom row.
fn _s15_blank_row_from_bottom(board, n)
    let total = n * n
    let bi = 0
    for i in 0..total
        if board[i] == 0
            bi = i
    // bi / n gives row from top (0-indexed); row from bottom = n - (bi / n)
    let row_from_top = bi / n
    return n - row_from_top

// Returns 1 if the board configuration is solvable (reachable from goal).
// Rules:
//   Odd n (e.g. 3):  solvable iff inversions is even.
//   Even n (e.g. 4): solvable iff (inversions + blank_row_from_bottom) is odd.
fn sliding_solvable(board, n)
    let total = n * n
    let inv = _s15_inversions(board, total)
    // n is odd
    let n_mod2 = n - (n / 2) * 2
    if n_mod2 != 0
        // odd n: solvable iff inv is even
        let inv_mod2 = inv - (inv / 2) * 2
        if inv_mod2 == 0
            return 1
        return 0
    // even n: solvable iff (inv + blank_row_from_bottom) is odd
    let brow = _s15_blank_row_from_bottom(board, n)
    let sum = inv + brow
    let sum_mod2 = sum - (sum / 2) * 2
    if sum_mod2 != 0
        return 1
    return 0

// Private: copy a list of integers.
fn _s15_copy(board, total)
    let b2 = [board[i] for i in 0..total]
    return b2

// Returns list of boards reachable by sliding one tile into the blank.
// Blank can move Up/Down/Left/Right; tile moves in the opposite direction.
fn sliding_neighbors(board, n)
    let total = n * n
    // Find blank index
    let bi = 0
    for i in 0..total
        if board[i] == 0
            bi = i

    let br = bi / n
    let bc = bi - br * n

    let result = []

    // Move blank UP: blank row > 0 -> swap with cell above
    if br > 0
        let nb = _s15_copy(board, total)
        let above = (br - 1) * n + bc
        nb[bi] = nb[above]
        nb[above] = 0
        push(result, nb)

    // Move blank DOWN: blank row < n-1
    if br < n - 1
        let nb = _s15_copy(board, total)
        let below = (br + 1) * n + bc
        nb[bi] = nb[below]
        nb[below] = 0
        push(result, nb)

    // Move blank LEFT: blank col > 0
    if bc > 0
        let nb = _s15_copy(board, total)
        let lft = br * n + (bc - 1)
        nb[bi] = nb[lft]
        nb[lft] = 0
        push(result, nb)

    // Move blank RIGHT: blank col < n-1
    if bc < n - 1
        let nb = _s15_copy(board, total)
        let rgt = br * n + (bc + 1)
        nb[bi] = nb[rgt]
        nb[rgt] = 0
        push(result, nb)

    return result
