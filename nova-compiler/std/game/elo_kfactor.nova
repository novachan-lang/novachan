// std/game/elo_kfactor.nova — USCF-style K-factor selection.
// kfactor(rating, games_played) -> float
//   40.0 if games_played < 30 (provisional player)
//   20.0 if rating < 2400 (established player)
//   10.0 if rating >= 2400 (high-rated player)
// LEAF — imports nothing.

// kfactor — USCF-ish K-factor for a player.
//   rating:       current rating (float)
//   games_played: number of rated games (int)
// Returns 40.0, 20.0, or 10.0.
fn kfactor(rating: float, games_played: int) -> float
    let k = 10.0
    if games_played < 30
        k = 40.0
    else
        if rating < 2400.0
            k = 20.0
    k
