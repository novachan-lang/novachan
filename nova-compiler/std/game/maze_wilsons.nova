// std/game/maze_wilsons.nova — Wilson's loop-erased random walk maze generator.
//
// Generates a PERFECT maze (spanning tree) using Wilson's algorithm:
//   1. Mark cell 0 as in-maze.
//   2. Pick an unvisited cell; do a random walk until reaching the in-maze region.
//      Loop erasure: path_next[c] is the most-recently chosen next step from c;
//      revisiting c overwrites the pointer, automatically erasing the loop.
//   3. Carve the loop-erased path into the maze (passages are bidirectional).
//   4. Repeat until all cells are in the maze.
//
// Grid: w×h, cell index c = row*w+col.
// Links: list of w*h lists; links[c] = cells joined to c by a passage.
//
// Public API:
//   gen(w, h, seed) -> list

// LCG random number generator
fn _mz_rng(state)
    return (state * 1103515245 + 12345) & 0x7FFFFFFF

// Returns [new_state, value in 0..n-1].
// Uses high bits (ns >> 16) % n to avoid the low-bit correlation of this LCG:
// ns % 4 cycles 0,1,2,3 deterministically, causing infinite loops in 4-neighbor grids.
// High bits have much better statistical quality (standard practice for Park-Miller LCGs).
fn _mz_randint(state, n)
    let ns = _mz_rng(state)
    return [ns, (ns / 65536) % n]

// Returns list of valid neighbor cell indices for cell c in w×h grid
fn _mz_neighbors(c, w, h)
    let nb = []
    let total = w * h
    if c >= w
        push(nb, c - w)
    if c + w < total
        push(nb, c + w)
    if c % w > 0
        push(nb, c - 1)
    if c % w < w - 1
        push(nb, c + 1)
    return nb

// Carve a bidirectional passage between cells a and b
fn _mz_link(links, a, b)
    push(links[a], b)
    push(links[b], a)

// Find first unvisited cell (in_maze[c]==0) starting from index 1
fn _mz_first_unvisited(in_maze, total)
    let fi = 1
    while fi < total
        if in_maze[fi] == 0
            return fi
        fi = fi + 1
    return -1

// Wilson's algorithm: generates a perfect maze via loop-erased random walks
fn gen(w, h, seed)
    let total = w * h
    let rng = seed

    // Build adjacency list: total empty lists
    let links = []
    let bi = 0
    while bi < total
        let empty = []
        push(links, empty)
        bi = bi + 1

    // Early exit for trivial grids
    if total == 1
        return links

    // in_maze[c] = 1 if cell c is in the maze, 0 otherwise
    let in_maze = []
    let mi = 0
    while mi < total
        push(in_maze, 0)
        mi = mi + 1

    // path_next[c] = next step from c in the current walk, or -1 if not on walk
    let path_next = []
    let pi = 0
    while pi < total
        push(path_next, -1)
        pi = pi + 1

    // on_path[c] = 1 if c was visited in the current walk (for carve cycle detection)
    let on_path = []
    let oi = 0
    while oi < total
        push(on_path, 0)
        oi = oi + 1

    // Start: cell 0 is in the maze
    in_maze[0] = 1
    let maze_count = 1

    // Walk step bound: Wilson's expected walk is O(total^2); 8*total^2 is a safe cap
    let walk_bound = total * total * 8 + total

    while maze_count < total
        // Find an unvisited cell to start the walk from
        let start = _mz_first_unvisited(in_maze, total)
        if start == -1
            maze_count = total
        else
            // --- Loop-erased random walk ---
            // Walk from start, updating path_next[cur] at each step.
            // Revisiting a cell overwrites its pointer (loop erasure).
            let cur = start
            let reached = 0
            let steps = 0

            while reached == 0 and steps < walk_bound
                if in_maze[cur] == 1
                    reached = 1
                else
                    // Mark that cur was visited this walk
                    on_path[cur] = 1
                    // Pick a random neighbor
                    let nb = _mz_neighbors(cur, w, h)
                    let nb_count = len(nb)
                    let rr = _mz_randint(rng, nb_count)
                    rng = rr[0]
                    let idx = rr[1]
                    let nxt = nb[idx]
                    // Loop erasure: overwrite path_next[cur]
                    path_next[cur] = nxt
                    cur = nxt
                    steps = steps + 1

            // reached == 1 means cur is now an in_maze cell.
            // The loop-erased path from start to cur is encoded in path_next.

            // --- Carve the path from start to the in_maze terminus ---
            // Use a separate "carved_this_walk" array to detect cycles and prevent
            // duplicate edges if path_next has any unexpected structure.
            let carved = []
            let cvi = 0
            while cvi < total
                push(carved, 0)
                cvi = cvi + 1

            let carve = start
            let safe_steps = 0
            while in_maze[carve] == 0 and safe_steps < total
                let nxt_carve = path_next[carve]
                // Guard: if we've already carved from this cell this walk, stop
                // (prevents double-carving in any pathological case)
                if carved[carve] == 1
                    // Break out of loop by forcing in_maze check to pass
                    in_maze[carve] = 1
                    maze_count = maze_count + 1
                else
                    if nxt_carve == -1
                        // No path forward — treat as terminus
                        in_maze[carve] = 1
                        maze_count = maze_count + 1
                    else
                        _mz_link(links, carve, nxt_carve)
                        carved[carve] = 1
                        in_maze[carve] = 1
                        maze_count = maze_count + 1
                        carve = nxt_carve
                        safe_steps = safe_steps + 1

            // --- Reset path_next and on_path for all visited cells ---
            let ri = 0
            while ri < total
                path_next[ri] = -1
                on_path[ri] = 0
                ri = ri + 1

    return links
