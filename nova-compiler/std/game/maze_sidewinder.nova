// std/game/maze_sidewinder.nova — Sidewinder maze generation.
//
// Processes the grid row by row, left to right.  In each row a "run" of cells
// is accumulated.  At each step the algorithm either carves east (extending the
// run) or closes the run by carving north from a randomly chosen member of the
// run.  The top row is a special case: passages are always carved east so the
// entire top row forms one connected corridor.
//
// Grid convention:
//   w x h grid; cell index c = row*w + col.
//   Neighbors: up=c-w, down=c+w, left=c-1, right=c+1 (bounds-checked).
//   links[c] = list of cells c has an open passage to (bidirectional).
//
// Public API:
//   gen(w, h, seed) -> list   (list of w*h lists; the adjacency structure)

// --- Seeded LCG RNG (deterministic) ---

fn _mz_rng(state)
    return (state * 1103515245 + 12345) & 0x7FFFFFFF

fn _mz_randint(state, n)
    let ns = _mz_rng(state)
    return [ns, ns % n]

// --- Sidewinder maze generator ---
// Returns links: a list of w*h lists.  links[c] = open passage targets from c.

fn gen(w, h, seed)
    let total = w * h

    // Initialize links as w*h empty lists.
    let links = []
    let i = 0
    while i < total
        let empty = []
        push(links, empty)
        i = i + 1

    let state = seed

    // Process row by row.
    let row = 0
    while row < h
        // Current run: flat list of cell indices in this row's active run.
        let run = []
        let col = 0
        while col < w
            let c = row * w + col
            push(run, c)

            // Determine whether we MUST close the run now:
            //   - At the rightmost column: cannot carve east.
            //   - On the top row (row==0): never carve north, always carve east.
            // So we close if: at_east_boundary OR (not top_row AND choose_close).
            let at_east = 0
            if col == w - 1
                at_east = 1

            let on_top = 0
            if row == 0
                on_top = 1

            // Flip a coin: 0=carve east, 1=close run.
            // (We only use the coin when not forced.)
            let coin = 0
            if at_east == 0 and on_top == 0
                let rr = _mz_randint(state, 2)
                state = rr[0]
                coin = rr[1]

            // Decide action.
            let do_close = 0
            if at_east == 1
                do_close = 1
            if on_top == 0 and coin == 1
                do_close = 1

            if do_close == 1
                // Close the run: pick a random cell from run and carve north.
                if row > 0
                    let rlen = len(run)
                    let rr2 = _mz_randint(state, rlen)
                    state = rr2[0]
                    let pick = run[rr2[1]]
                    let above = pick - w
                    push(links[pick], above)
                    push(links[above], pick)
                // Start a new run.
                run = []
            else
                // Carve east: connect c to c+1.
                let east = c + 1
                push(links[c], east)
                push(links[east], c)

            col = col + 1
        row = row + 1

    return links
