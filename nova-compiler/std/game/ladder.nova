// std/game/ladder.nova — Ladder tournament management.
// A ladder is an ordered list of player ids; position 0 = top of ladder.
// A challenger at a higher index (lower rank) can challenge a defender at a
// lower index (higher rank). If the challenger wins, they swap positions.
// If the challenger loses, the ladder is unchanged.
//
// Public API:
//   ladder_challenge(ladder, chal_pos, def_pos, chal_wins) -> new ladder list
//   ladder_rank(ladder, id) -> int  (0-based position; -1 if not found)
// LEAF — imports nothing.

// ladder_rank — return the 0-based index of id in the ladder, or -1 if absent.
fn ladder_rank(ladder: list, id: int) -> int
    let n = len(ladder)
    let i = 0
    while i < n
        if ladder[i] == id
            return i
        i = i + 1
    -1

// ladder_challenge — apply one challenge match to the ladder.
// chal_pos: index of the challenger (must be > def_pos to be a valid upward challenge).
// def_pos: index of the defender (must be < chal_pos).
// chal_wins: if true AND chal_pos > def_pos, swap them; otherwise unchanged.
// Returns a new ladder list (does not mutate the input).
fn ladder_challenge(ladder: list, chal_pos: int, def_pos: int, chal_wins: bool) -> list
    let n = len(ladder)
    let out = []
    let i = 0
    while i < n
        push(out, ladder[i])
        i = i + 1
    if chal_wins and chal_pos > def_pos
        let tmp = out[chal_pos]
        out[chal_pos] = out[def_pos]
        out[def_pos] = tmp
    out
