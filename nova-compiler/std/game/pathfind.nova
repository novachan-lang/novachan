// std/game/pathfind.nova — Grid-based A* pathfinding.
//
// GRID MODEL: grid is a list of rows, each row a list of ints (list of lists).
// grid[y][x]: 0 = walkable, non-zero = wall. Precondition: rectangular (every
// row has the same length as grid[0]) — ragged grids are read safely (every
// access is bounds-checked per row) but the internal A* scoring arrays assume
// a uniform width, so ragged input is not a supported configuration.
//
// PREFIX: pf_  (private helpers: _pf_)
//
// Algorithm: A* with Manhattan-distance heuristic (admissible/consistent on a
// 4-connected grid), binary min-heap open set keyed on [f, g, cell_index],
// closed-set to prevent re-expansion, ties broken by lower g.
//
// API:
//   pf_heuristic(x1, y1, x2, y2)      -> int   Manhattan distance
//   pf_neighbors(grid, x, y)          -> list  walkable 4-connected [x,y] neighbors
//   pf_find(grid, sx, sy, ex, ey)     -> list  path [[x,y], ...] start..end
//                                                inclusive, or [] if unreachable
//                                                (or start/end is a wall/OOB)

// ── heuristic ─────────────────────────────────────────────────────────────────

// pf_heuristic: Manhattan distance |x2-x1| + |y2-y1|.
fn pf_heuristic(x1: int, y1: int, x2: int, y2: int) -> int
    let dx = x2 - x1
    let dy = y2 - y1
    if dx < 0
        dx = 0 - dx
    if dy < 0
        dy = 0 - dy
    dx + dy

// ── grid queries ────────────────────────────────────────────────────────────────

fn _pf_in_bounds(grid: list, x: int, y: int) -> bool
    let h = len(grid)
    if y < 0 or y >= h
        return false
    let row = grid[y]
    let w = len(row)
    if x < 0 or x >= w
        return false
    true

fn _pf_walkable(grid: list, x: int, y: int) -> bool
    let inb = _pf_in_bounds(grid, x, y)
    if not inb
        return false
    let row = grid[y]
    let v = row[x]
    v == 0

// pf_neighbors: walkable, in-bounds, 4-connected (N/S/E/W) neighbors of (x,y).
fn pf_neighbors(grid: list, x: int, y: int) -> list
    let result = []
    let dxs = [0, 0, 1, -1]
    let dys = [-1, 1, 0, 0]
    let i = 0
    while i < 4
        let nx = x + dxs[i]
        let ny = y + dys[i]
        let ok = _pf_walkable(grid, nx, ny)
        if ok
            result.push([nx, ny])
        i = i + 1
    result

// ── min-heap on [f, g, cell_index] triples ──────────────────────────────────────

fn _pf_hp_less(heap: list, i: int, j: int) -> int
    let ei = heap[i]
    let ej = heap[j]
    let fi = ei[0]
    let fj = ej[0]
    if fi < fj
        return 1
    if fi > fj
        return 0
    let gi = ei[1]
    let gj = ej[1]
    if gi < gj
        return 1
    return 0

fn _pf_hp_swap(heap: list, i: int, j: int)
    let tmp = heap[i]
    heap[i] = heap[j]
    heap[j] = tmp

fn _pf_hp_sift_up(heap: list, idx: int)
    let pos = idx
    let going = 1
    while pos > 0 and going == 1
        let par = (pos - 1) / 2
        let cmp = _pf_hp_less(heap, pos, par)
        if cmp == 1
            _pf_hp_swap(heap, pos, par)
            pos = par
        if cmp == 0
            going = 0

fn _pf_hp_sift_down(heap: list, pos: int, hsz: int)
    let cur = pos
    let going = 1
    while going == 1
        let left = cur * 2 + 1
        let right = cur * 2 + 2
        let smallest = cur
        if left < hsz
            if _pf_hp_less(heap, left, smallest) == 1
                smallest = left
        if right < hsz
            if _pf_hp_less(heap, right, smallest) == 1
                smallest = right
        let swapped = 0
        if smallest != cur
            _pf_hp_swap(heap, cur, smallest)
            cur = smallest
            swapped = 1
        if swapped == 0
            going = 0

fn _pf_heap_push(heap: list, f: int, g: int, ci: int)
    let entry = [f, g, ci]
    heap.push(entry)
    let idx = len(heap) - 1
    _pf_hp_sift_up(heap, idx)

fn _pf_heap_pop(heap: list) -> list
    let sz = len(heap)
    let top = heap[0]
    let last_idx = sz - 1
    if last_idx == 0
        pop(heap)
        return top
    heap[0] = heap[last_idx]
    pop(heap)
    _pf_hp_sift_down(heap, 0, last_idx)
    return top

// ── A* core ───────────────────────────────────────────────────────────────────

// pf_find: shortest path from (start_x,start_y) to (end_x,end_y).
// Returns list of [x,y] cells, start..end inclusive. Returns [] if start or
// end is out of bounds/a wall, or if end is unreachable from start.
fn pf_find(grid: list, start_x: int, start_y: int, end_x: int, end_y: int) -> list
    let h = len(grid)
    let w = 0
    if h > 0
        let row0 = grid[0]
        w = len(row0)
    let total = w * h

    if total == 0
        return []
    let start_ok = _pf_walkable(grid, start_x, start_y)
    if not start_ok
        return []
    let end_ok = _pf_walkable(grid, end_x, end_y)
    if not end_ok
        return []

    let start_ci = start_y * w + start_x
    let end_ci = end_y * w + end_x

    // g_score[ci]: best known cost from start; -1 = unvisited.
    let g_score = []
    for gi in 0..total
        g_score.push(-1)
    g_score[start_ci] = 0

    // parent_x/parent_y[ci]: predecessor coords; -1 = none.
    let parent_x = []
    let parent_y = []
    for pi in 0..total
        parent_x.push(-1)
        parent_y.push(-1)

    // closed[ci]: 1 if permanently settled.
    let closed = []
    for ki in 0..total
        closed.push(0)

    let heap = []
    let h0 = pf_heuristic(start_x, start_y, end_x, end_y)
    _pf_heap_push(heap, h0, 0, start_ci)

    let expanded = 0
    let max_expand = total + 1

    while len(heap) > 0 and expanded < max_expand
        let entry = _pf_heap_pop(heap)
        let cur_g = entry[1]
        let cur_ci = entry[2]

        if closed[cur_ci] == 0
            closed[cur_ci] = 1
            expanded = expanded + 1

            if cur_ci == end_ci
                // Reconstruct path by walking parent pointers end -> start.
                let path = []
                let cx = end_x
                let cy = end_y
                let walk = 0
                let max_walk = total + 1
                let done = 0
                while done == 0 and walk < max_walk
                    path.push([cx, cy])
                    let pci = cy * w + cx
                    let npx = parent_x[pci]
                    let npy = parent_y[pci]
                    if npx == -1
                        done = 1
                    if done == 0
                        cx = npx
                        cy = npy
                    walk = walk + 1
                // path is end..start; reverse to start..end.
                let plen = len(path)
                let rev = []
                let ri = plen - 1
                while ri >= 0
                    rev.push(path[ri])
                    ri = ri - 1
                return rev

            let cur_y = cur_ci / w
            let cur_x = cur_ci - cur_y * w
            let nbrs = pf_neighbors(grid, cur_x, cur_y)
            let nlen = len(nbrs)
            for ni in 0..nlen
                let nb = nbrs[ni]
                let nx = nb[0]
                let ny = nb[1]
                let nb_ci = ny * w + nx
                if closed[nb_ci] == 0
                    let new_g = cur_g + 1
                    let old_g = g_score[nb_ci]
                    if old_g == -1 or new_g < old_g
                        g_score[nb_ci] = new_g
                        parent_x[nb_ci] = cur_x
                        parent_y[nb_ci] = cur_y
                        let nb_h = pf_heuristic(nx, ny, end_x, end_y)
                        let nb_f = new_g + nb_h
                        _pf_heap_push(heap, nb_f, new_g, nb_ci)

    return []
