// std/game/tourney_bracket.nova — single-elimination tournament bracket utilities.
//
// Public API:
//   single_elim_rounds(num_players) -> int
//       Number of rounds needed for a single-elimination tournament with the
//       given number of players. Equals ceil(log2(num_players)).
//       single_elim_rounds(1) = 0 (no rounds needed).
//
//   bracket_size(num_players) -> int
//       The next power of 2 >= num_players.
//       bracket_size(8) = 8; bracket_size(5) = 8.
//
//   advance_bracket(winners) -> list
//       Pair up a list of winners for the next round.
//       Returns a list of 2-element [playerA, playerB] matchup lists.
//       If winners has an odd length the last player gets a bye (unpaired);
//       the bye entry is a 1-element list [player].
//
// LEAF — imports nothing.

// bracket_size: smallest power of 2 that is >= num_players.
// bracket_size(1) = 1, bracket_size(2) = 2, bracket_size(5) = 8.
fn bracket_size(num_players)
    if num_players <= 1
        return 1
    let sz = 1
    while sz < num_players
        sz = sz * 2
    return sz

// single_elim_rounds: number of rounds to determine a winner.
// equals ceil(log2(num_players)).
// single_elim_rounds(1) = 0.
// single_elim_rounds(8) = 3.
// single_elim_rounds(5) = 3.
fn single_elim_rounds(num_players)
    if num_players <= 1
        return 0
    let rounds = 0
    let sz = 1
    while sz < num_players
        sz = sz * 2
        rounds += 1
    return rounds

// advance_bracket: pair up winners for the next round.
// winners = [p1, p2, p3, p4, ...]
// Returns [[p1,p2],[p3,p4],...] (consecutive pairs).
// If the list has odd length, the last player advances with a bye: [player].
fn advance_bracket(winners)
    let n = len(winners)
    let out = []
    let i = 0
    while i + 1 < n
        let matchup = []
        push(matchup, winners[i])
        push(matchup, winners[i + 1])
        push(out, matchup)
        i += 2
    // Handle bye if odd number of winners
    if i < n
        let bye = []
        push(bye, winners[i])
        push(out, bye)
    return out
