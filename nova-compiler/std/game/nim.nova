// std/game/nim.nova — Nim combinatorial game theory.
//
// Nim: players alternate removing >=1 objects from any single heap.
// Last player to remove wins (normal play convention).
//
// Sprague-Grundy theorem: XOR (nim-sum) of all heap sizes determines outcome.
//   nim-sum == 0 -> current player LOSES with perfect play (P-position).
//   nim-sum != 0 -> current player WINS with perfect play (N-position).
//
// Public API:
//   nim_xor(heaps)        -> int   XOR of all heap sizes
//   nim_is_winning(heaps) -> bool  true if nim-sum != 0 (current player wins)
//   nim_winning_move(heaps) -> list  [heap_index, remove_count]
//       Returns a move that leaves nim-sum == 0 for the opponent.
//       Returns [-1, 0] if already in a losing position (nim-sum == 0).
// LEAF — imports nothing.

// nim_xor — XOR of all heap sizes.
fn nim_xor(heaps)
    let x = 0
    let i = 0
    let n = len(heaps)
    while i < n
        x = x ^ heaps[i]
        i += 1
    x

// nim_is_winning — true if nim-sum != 0 (current player has a winning strategy).
fn nim_is_winning(heaps)
    let x = nim_xor(heaps)
    x != 0

// nim_winning_move — find a move that leaves nim-sum == 0 for the opponent.
// Strategy: find a heap where (heap_size XOR nim_sum) < heap_size.
//           Remove (heap_size - (heap_size XOR nim_sum)) from that heap.
// Returns [heap_index, remove_count], or [-1, 0] if no winning move (already losing).
fn nim_winning_move(heaps)
    let result = []
    push(result, -1)
    push(result, 0)
    let x = nim_xor(heaps)
    if x == 0
        return result
    let n = len(heaps)
    for i in 0..n
        let h = heaps[i]
        let new_h = h ^ x
        if new_h < h
            result[0] = i
            result[1] = h - new_h
            return result
    result
