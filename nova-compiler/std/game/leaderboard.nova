// std/game/leaderboard.nova — leaderboard ranking utilities.
//
// An "entry" is a 2-element list [id, score] where id and score are ints.
//
// Public API:
//   rank_entries(entries) -> list  sorted desc by score, each entry becomes
//                                  [id, score, rank] with standard competition
//                                  ranking (ties share the same rank; next rank
//                                  skips by tie count).
//   top_n(entries, n)     -> list  first n entries from rank_entries result.
//
// LEAF — imports nothing.

// _lb_copy_entry: copy a 2-element entry into a new list.
fn _lb_copy_entry(e)
    return [e[0], e[1]]

// _lb_sort_desc: selection-sort entries by score descending.
// Works on a list of 2-element [id, score] lists.
// Returns a new sorted list (does not mutate input).
// Uses selection sort to avoid needing inner-loop break with index math.
fn _lb_sort_desc(entries)
    let n = len(entries)
    let a = [_lb_copy_entry(entries[i]) for i in 0..n]
    // Selection sort descending by score (index 1)
    for outer in 0..n
        let best = outer
        for inner in (outer + 1)..n
            if a[inner][1] > a[best][1]
                best = inner
        // Swap a[outer] and a[best]
        if best != outer
            let tmp = a[outer]
            a[outer] = a[best]
            a[best] = tmp
    return a

// rank_entries: sort entries desc by score and assign standard competition ranks.
// Ties receive the same rank; the next rank after a tie group of size g is
// previous_rank + g (1,2,2,4 pattern).
// Returns a list of [id, score, rank] lists.
fn rank_entries(entries)
    let n = len(entries)
    if n == 0
        return []
    let sorted = _lb_sort_desc(entries)
    // Provisional rank = 1-based position; fixed up for ties below.
    let out = [[sorted[i][0], sorted[i][1], i + 1] for i in 0..n]
    // Re-pass to fix ranks for ties: scan output and for each group of equal
    // scores assign the minimum rank in that group to all.
    let m = len(out)
    for p in 0..m
        let base_score = out[p][1]
        let base_rank = out[p][2]
        let q = p + 1
        while q < m and out[q][1] == base_score
            // Same score: assign base_rank
            out[q] = [out[q][0], out[q][1], base_rank]
            q += 1
    return out

// top_n: return the first n entries from rank_entries(entries).
// If n >= total entries, returns all.
fn top_n(entries, n)
    let ranked = rank_entries(entries)
    let total = len(ranked)
    let limit = n
    if limit > total
        limit = total
    let out = [ranked[i] for i in 0..limit]
    return out
