// std/game/glicko1.nova — Simplified Glicko-1 rating update.
//
// Glicko-1 (Glickman 1995) extends Elo with a Rating Deviation (RD) that
// represents uncertainty in the rating. Lower RD = more certain.
//
// API:
//   glicko_update(rating, rd, opp_rating, opp_rd, score) -> list [new_rating, new_rd]
//     rating      : current player rating (float, e.g. 1500.0)
//     rd          : current player RD (float, e.g. 173.7)
//     opp_rating  : opponent rating (float)
//     opp_rd      : opponent RD (float)
//     score       : game result for player (1.0=win, 0.5=draw, 0.0=loss)
//   Returns: [new_rating, new_rd] as a 2-element list.
//
// Simplified Glicko-1 single-game variant:
//   q = ln(10) / 400
//   g(RD) = 1 / sqrt(1 + 3*q^2*RD^2 / pi^2)
//   E(s|r,r_j,RD_j) = 1 / (1 + 10^( -g(RD_j)*(r - r_j) / 400 ))
//   d^2 = 1 / (q^2 * g(RD_j)^2 * E * (1-E))
//   r' = r + (q / (1/RD^2 + 1/d^2)) * g(RD_j) * (score - E)
//   RD' = sqrt(1 / (1/RD^2 + 1/d^2))
//   RD' is clamped to minimum 30.0 (never < 30).
//
// LEAF module — imports nothing.

// Private: compute g(RD) = 1 / sqrt(1 + 3*q^2*RD^2 / pi^2)
// q = ln(10)/400 ~ 0.005756
fn _glicko_g(rd: float) -> float
    let q = log(10.0) / 400.0
    let pi_val = pi()
    let q2 = q * q
    let rd2 = rd * rd
    let denom_inner = 1.0 + 3.0 * q2 * rd2 / (pi_val * pi_val)
    let denom = sqrt(denom_inner)
    let result = 1.0 / denom
    result

// Private: compute expected score E = 1 / (1 + 10^(-g_val*(r - r_j)/400))
fn _glicko_e(r: float, r_j: float, g_val: float) -> float
    let diff = r - r_j
    let exponent = 0.0 - g_val * diff / 400.0
    let p = pow(10.0, exponent)
    let result = 1.0 / (1.0 + p)
    result

// glicko_update: compute new [rating, rd] after one game.
// score = 1.0 win, 0.5 draw, 0.0 loss (from the player's perspective).
fn glicko_update(rating: float, rd: float, opp_rating: float, opp_rd: float, score: float) -> list
    let q = log(10.0) / 400.0
    let g_val = _glicko_g(opp_rd)
    let e_val = _glicko_e(rating, opp_rating, g_val)
    // d^2 = 1 / (q^2 * g^2 * E * (1-E))
    let q2 = q * q
    let g2 = g_val * g_val
    let e1 = 1.0 - e_val
    let d2 = 1.0 / (q2 * g2 * e_val * e1)
    // r' = r + (q / (1/RD^2 + 1/d^2)) * g * (score - E)
    let rd2 = rd * rd
    let inv_rd2 = 1.0 / rd2
    let inv_d2 = 1.0 / d2
    let denom = inv_rd2 + inv_d2
    let factor = q / denom
    let se = score - e_val
    let new_rating = rating + factor * g_val * se
    // RD' = sqrt(1 / (1/RD^2 + 1/d^2))
    let new_rd2 = 1.0 / denom
    let new_rd = sqrt(new_rd2)
    // Clamp RD to minimum 30.0
    let clamped_rd = new_rd
    if new_rd < 30.0
        clamped_rd = 30.0
    [new_rating, clamped_rd]
