// std/game/handrank.nova — Poker 5-card hand classification.
// Cards: 2-element list [rank, suit]. rank 2..14 (11=J,12=Q,13=K,14=A). suit 0..3.
// Public API:
//   classify_poker(cards) -> string   — name of the best hand
//   is_flush(cards)       -> bool
//   is_straight(cards)    -> bool
// Ace can be high (10-J-Q-K-A) or low (A-2-3-4-5 wheel).
// LEAF — imports nothing.

// Private: extract rank from a card [rank, suit]
fn _hr_rank(card: list) -> int
    card[0]

// Private: extract suit from a card [rank, suit]
fn _hr_suit(card: list) -> int
    card[1]

// Private: insertion-sort a 5-element list of integers, ascending. Returns new sorted list.
fn _hr_sort5(xs: list) -> list
    let a = []
    push(a, xs[0])
    push(a, xs[1])
    push(a, xs[2])
    push(a, xs[3])
    push(a, xs[4])
    // bubble sort over 5 elements
    let i = 0
    while i < 5
        let j = 0
        while j < 4 - i
            if a[j] > a[j+1]
                let tmp = a[j]
                a[j] = a[j+1]
                a[j+1] = tmp
            j = j + 1
        i = i + 1
    a

// Private: build rank frequency dict {rank_str -> count} for the 5 cards.
fn _hr_freq(cards: list) -> dict
    let freq = {}
    let i = 0
    while i < len(cards)
        let card = cards[i]
        let r = _hr_rank(card)
        let k = str(r)
        if contains(freq, k)
            freq[k] = freq[k] + 1
        else
            freq[k] = 1
        i = i + 1
    freq

// Private: returns the highest count in the frequency dict (1,2,3,4).
fn _hr_max_freq(freq: dict) -> int
    let mx = 0
    let ks = keys(freq)
    let i = 0
    while i < len(ks)
        let v = freq[ks[i]]
        if v > mx
            mx = v
        i = i + 1
    mx

// Private: count how many distinct ranks have exactly cnt occurrences.
fn _hr_count_with(freq: dict, cnt: int) -> int
    let n = 0
    let ks = keys(freq)
    let i = 0
    while i < len(ks)
        if freq[ks[i]] == cnt
            n = n + 1
        i = i + 1
    n

// is_flush — true if all 5 cards share the same suit.
fn is_flush(cards: list) -> bool
    let card0 = cards[0]
    let s = _hr_suit(card0)
    let i = 1
    let ok = true
    while i < len(cards)
        let c = cards[i]
        if _hr_suit(c) != s
            ok = false
        i = i + 1
    ok

// is_straight — true if the 5 cards form a sequence of consecutive ranks.
// Handles the wheel: A(14)-2-3-4-5.
fn is_straight(cards: list) -> bool
    let ranks = []
    let i = 0
    while i < len(cards)
        let card = cards[i]
        push(ranks, _hr_rank(card))
        i = i + 1
    let sorted = _hr_sort5(ranks)
    // Check normal straight: each rank = prev+1
    let normal = true
    let j = 1
    while j < 5
        if sorted[j] != sorted[j-1] + 1
            normal = false
        j = j + 1
    if normal
        return true
    // Check wheel: A-2-3-4-5 -> sorted = [2,3,4,5,14]
    if sorted[0] == 2 and sorted[1] == 3 and sorted[2] == 4 and sorted[3] == 5 and sorted[4] == 14
        return true
    false

// classify_poker — classify a 5-card hand into its best category name.
fn classify_poker(cards: list) -> string
    let fl = is_flush(cards)
    let st = is_straight(cards)
    let freq = _hr_freq(cards)
    let mx = _hr_max_freq(freq)
    let pairs = _hr_count_with(freq, 2)
    let trips = _hr_count_with(freq, 3)

    // Straight flush (includes royal)
    if fl and st
        let ranks = []
        let i = 0
        while i < len(cards)
            let card = cards[i]
            push(ranks, _hr_rank(card))
            i = i + 1
        let sorted = _hr_sort5(ranks)
        // Royal: [10,11,12,13,14]
        if sorted[0] == 10 and sorted[4] == 14
            return "royal_flush"
        return "straight_flush"

    if mx == 4
        return "four_kind"
    if trips == 1 and pairs == 1
        return "full_house"
    if fl
        return "flush"
    if st
        return "straight"
    if trips == 1
        return "three_kind"
    if pairs == 2
        return "two_pair"
    if pairs == 1
        return "pair"
    "high_card"
