// std/game/tilemap.nova — Tilemap storage engine.
//
// TILEMAP MODEL: dict { "width": w, "height": h, "tile_size": ts,
// "tiles": [w*h ints] }. tiles is a flat row-major list; cell (x,y) ->
// tiles[y*width+x]. New tiles default to id 0. tm_get returns -1 for
// out-of-bounds coordinates (distinct from the valid tile id 0).
//
// PREFIX: tm_  (private helpers: _tm_)
//
// NOTE ON THE tm_ PREFIX: std/game2d/tilemap.nova also uses tm_, with its own
// dict schema and semantics (a different tile-map flavor, oriented around
// world<->tile coordinate conversion). Prefix reuse across independent NOVA
// stdlib modules is an established, accepted pattern here (tm_ is already
// independently reused by std/automata/turing.nova, std/collections/triemap.nova,
// std/geo/tile_math.nova, std/tensor/tsr_matmul.nova, std/tree/tree_dp_mis.nova) —
// each module is compiled/imported per file, so this is safe as long as a
// single file does not `import` two tm_-prefixed modules unqualified; use
// `import ... as alias` if both are ever needed together in one file.
//
// API:
//   tm_new(width, height, tile_size) -> any  new tilemap, every tile = 0
//   tm_set(map, x, y, tile_id)       -> any  set tile; no-op if OOB; returns map
//   tm_get(map, x, y)                -> int  tile id, or -1 if OOB
//   tm_fill(map, tile_id)            -> any  set every tile to tile_id; returns map
//   tm_region(map, x, y, w, h)       -> any  new w x h tilemap copied from (x,y);
//                                              source cells outside the parent
//                                              map are filled with 0

// ── construction ─────────────────────────────────────────────────────────────

fn tm_new(width: int, height: int, tile_size: int) -> any
    let tiles = []
    let total = width * height
    for i in 0..total
        tiles.push(0)
    let m = {}
    m["width"] = width
    m["height"] = height
    m["tile_size"] = tile_size
    m["tiles"] = tiles
    m

// ── accessors ─────────────────────────────────────────────────────────────────

fn _tm_in_bounds(map: any, x: int, y: int) -> bool
    let w = map["width"]
    let h = map["height"]
    if x < 0 or x >= w
        return false
    if y < 0 or y >= h
        return false
    true

// tm_set: set tile at (x,y) to tile_id. Out-of-bounds is a no-op. Returns map.
fn tm_set(map: any, x: int, y: int, tile_id: int) -> any
    let inb = _tm_in_bounds(map, x, y)
    if inb
        let w = map["width"]
        let tiles = map["tiles"]
        let idx = y * w + x
        tiles[idx] = tile_id
    map

// tm_get: tile id at (x,y), or -1 if (x,y) is out of bounds.
fn tm_get(map: any, x: int, y: int) -> int
    let inb = _tm_in_bounds(map, x, y)
    let result = -1
    if inb
        let w = map["width"]
        let tiles = map["tiles"]
        let idx = y * w + x
        result = tiles[idx]
    result

// ── bulk operations ───────────────────────────────────────────────────────────

// tm_fill: set every tile in the map to tile_id. Returns map.
fn tm_fill(map: any, tile_id: int) -> any
    let tiles = map["tiles"]
    let n = len(tiles)
    for i in 0..n
        tiles[i] = tile_id
    map

// tm_region: extract a w x h sub-region starting at (x,y) as a new tilemap
// (same tile_size as the source). Cells whose source coordinate falls outside
// the parent map are filled with 0.
fn tm_region(map: any, x: int, y: int, w: int, h: int) -> any
    let ts = map["tile_size"]
    let out = tm_new(w, h, ts)
    for ry in 0..h
        let sy = y + ry
        let rx = 0
        while rx < w
            let sx = x + rx
            let v = tm_get(map, sx, sy)
            if v == -1
                v = 0
            tm_set(out, rx, ry, v)
            rx = rx + 1
    out
