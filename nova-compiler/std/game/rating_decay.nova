// std/game/rating_decay.nova — Rating decay for inactive players and provisional bonuses.
//
// API:
//   inactivity_decay(rating, weeks_inactive, floor) -> float
//     Subtracts a small amount per week of inactivity, never going below floor.
//     Decay rate: 2.0 points per week (negligible for short absences, meaningful long-term).
//     0 weeks inactive: returns rating unchanged.
//
//   provisional_bonus(rating, games) -> float
//     Returns an adjusted rating incorporating a bonus for players with few games,
//     reflecting uncertainty: rating + bonus where bonus decreases with game count.
//     Bonus = max(0, 100 * (1 - games/20)).  After 20+ games, bonus = 0.
//     This matches the intuition that new players may be underrated until settled.
//
// LEAF module — imports nothing.

// inactivity_decay: subtract DECAY_PER_WEEK per week inactive, floor-clamped.
// DECAY_PER_WEEK = 2.0 (2 rating points per week of inactivity).
fn inactivity_decay(rating: float, weeks_inactive: int, floor: float) -> float
    let decay_per_week = 2.0
    let weeks = weeks_inactive * 1.0
    let total_decay = decay_per_week * weeks
    let decayed = rating - total_decay
    // clamp to floor
    let result = floor if decayed < floor else decayed
    result

// provisional_bonus: bonus for players with few games played.
// bonus = max(0, 100 * (1 - games/20))
// At 0 games: bonus = 100.0
// At 10 games: bonus = 50.0
// At 20+ games: bonus = 0.0
fn provisional_bonus(rating: float, games: int) -> float
    let max_games = 20.0
    let g = games * 1.0
    let ratio = g / max_games
    let raw_bonus = 100.0 * (1.0 - ratio)
    let bonus = 0.0 if raw_bonus < 0.0 else raw_bonus
    let result = rating + bonus
    result
