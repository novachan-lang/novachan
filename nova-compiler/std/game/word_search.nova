// std/game/word_search.nova — Word search in a letter grid (all 8 directions).
//
// grid = list of strings (rows). Each string is a row of characters.
// word = string to find.
//
// Directions (indexed 0..7):
//   0: right       (dr=0,  dc=+1)
//   1: left        (dr=0,  dc=-1)
//   2: down        (dr=+1, dc=0)
//   3: up          (dr=-1, dc=0)
//   4: down-right  (dr=+1, dc=+1)
//   5: down-left   (dr=+1, dc=-1)
//   6: up-right    (dr=-1, dc=+1)
//   7: up-left     (dr=-1, dc=-1)
//
// Public API:
//   word_search(grid, word) -> bool  (1 if found, 0 if not)
//   word_search_pos(grid, word) -> list [row, col, dir]  (-1,-1,-1 if not found)
// LEAF — imports nothing.

// Private: row delta for direction d
fn _ws_dr(d)
    if d == 0
        return 0
    if d == 1
        return 0
    if d == 2
        return 1
    if d == 3
        return -1
    if d == 4
        return 1
    if d == 5
        return 1
    if d == 6
        return -1
    // d == 7
    return -1

// Private: col delta for direction d
fn _ws_dc(d)
    if d == 0
        return 1
    if d == 1
        return -1
    if d == 2
        return 0
    if d == 3
        return 0
    if d == 4
        return 1
    if d == 5
        return -1
    if d == 6
        return 1
    // d == 7
    return -1

// Private: check if word starts at (row, col) going in direction d.
// Returns 1 if match, 0 otherwise.
fn _ws_check(grid, word, rows, cols, row, col, d, wlen)
    let dr = _ws_dr(d)
    let dc = _ws_dc(d)
    let k = 0
    while k < wlen
        let r = row + dr * k
        let c = col + dc * k
        if r < 0 or r >= rows or c < 0 or c >= cols
            return 0
        let rowstr = grid[r]
        let ch = char_at(rowstr, c)
        let wch = char_at(word, k)
        if ch != wch
            return 0
        k = k + 1
    return 1

// Returns 1 if word is found anywhere in grid (any of 8 directions), else 0.
fn word_search(grid, word)
    let rows = len(grid)
    if rows == 0
        return 0
    let cols = len(grid[0])
    let wlen = len(word)
    if wlen == 0
        return 0
    let r = 0
    while r < rows
        let c = 0
        while c < cols
            let d = 0
            while d < 8
                if _ws_check(grid, word, rows, cols, r, c, d, wlen) == 1
                    return 1
                d = d + 1
            c = c + 1
        r = r + 1
    return 0

// Returns [row, col, dir] of first occurrence, or [-1, -1, -1] if not found.
fn word_search_pos(grid, word)
    let rows = len(grid)
    let not_found = []
    push(not_found, -1)
    push(not_found, -1)
    push(not_found, -1)
    if rows == 0
        return not_found
    let cols = len(grid[0])
    let wlen = len(word)
    if wlen == 0
        return not_found
    let r = 0
    while r < rows
        let c = 0
        while c < cols
            let d = 0
            while d < 8
                if _ws_check(grid, word, rows, cols, r, c, d, wlen) == 1
                    let res = []
                    push(res, r)
                    push(res, c)
                    push(res, d)
                    return res
                d = d + 1
            c = c + 1
        r = r + 1
    return not_found
