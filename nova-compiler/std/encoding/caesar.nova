// ============================================================================
// NOVA Standard Library — std/encoding/caesar
// ============================================================================
// Caesar cipher: rotate ASCII letters by a fixed shift, preserving case and
// leaving all non-letter characters unchanged.
//
// PUBLIC API (prefix cae_):
//   cae_encrypt(s: string, shift: int) -> string
//     Rotate every ASCII letter forward by `shift` mod 26.
//     Case is preserved; non-letters pass through unchanged.
//
//   cae_decrypt(s: string, shift: int) -> string
//     Reverse of cae_encrypt. cae_decrypt(cae_encrypt(s,k),k) == s.
//
//   cae_rot13(s: string) -> string
//     cae_encrypt with shift=13 (self-inverse).
//
//   cae_brute(s: string) -> list
//     Returns a list of 25 strings: all non-trivial shifts (shift 1..25)
//     applied as decryptions. Useful for manual cryptanalysis.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// Normalise any integer shift to the range 0..25.
fn _cae_norm(shift) -> int
    let s = shift - (shift / 26) * 26
    if s < 0
        s += 26
    s

// Rotate a single ASCII letter codepoint `b` by `sh` (0..25) around `base`
// (65=uppercase, 97=lowercase). Returns the rotated codepoint.
fn _cae_shift_byte(b, base, sh) -> int
    let raw = b - base + sh
    let q = raw / 26
    let r = raw - q * 26
    r + base

// Rotate one character `c` by `sh` (already normalised 0..25),
// preserving case; non-letters returned unchanged.
fn _cae_char(c, sh) -> string
    let b = ord(c)
    if b >= 65 and b <= 90
        return chr(_cae_shift_byte(b, 65, sh))
    if b >= 97 and b <= 122
        return chr(_cae_shift_byte(b, 97, sh))
    c

// Apply shift `sh` (0..25, already normalised) to every character in `s`.
fn _cae_apply(s, sh) -> string
    let out_parts = []
    let n = len(s)
    for i in 0..n
        let ch = _cae_char(s[i], sh)
        push(out_parts, ch)
    let out = join(out_parts, "")
    out

// ── Public API ───────────────────────────────────────────────────────────────

// cae_encrypt: rotate every ASCII letter in `s` forward by `shift` positions.
// shift is reduced modulo 26; any integer is accepted.
// Examples:
//   cae_encrypt("Hello", 3)  == "Khoor"
//   cae_encrypt("abc",   1)  == "bcd"
//   cae_encrypt("xyz",   3)  == "abc"
//   cae_encrypt("Hi, Bob!", 1) == "Ij, Cpc!"
fn cae_encrypt(s, shift) -> string
    let sh = _cae_norm(shift)
    _cae_apply(s, sh)

// cae_decrypt: reverse of cae_encrypt.
// Rotates every ASCII letter backward by `shift` positions.
// cae_decrypt(cae_encrypt(s, k), k) == s for any integer k.
// Examples:
//   cae_decrypt("Khoor", 3) == "Hello"
fn cae_decrypt(s, shift) -> string
    let sh = _cae_norm(shift)
    let inv = 26 - sh
    if inv == 26
        inv = 0
    _cae_apply(s, inv)

// cae_rot13: Caesar cipher with shift=13 (self-inverse).
// cae_rot13(cae_rot13(s)) == s for all s.
// Example:
//   cae_rot13("Hello") == "Uryyb"
fn cae_rot13(s) -> string
    _cae_apply(s, 13)

// cae_brute: return all 25 non-trivial shift-decryptions of `s` (shifts 1..25).
// The list has exactly 25 entries; index 0 = shift-by-1 decryption, etc.
// Useful for manual frequency-analysis of Caesar-encrypted text.
// Example:
//   len(cae_brute("abc")) == 25
fn cae_brute(s) -> list
    let results = []
    for shift in 1..26
        let dec = cae_decrypt(s, shift)
        results.push(dec)
    results
