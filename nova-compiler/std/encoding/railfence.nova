// ============================================================================
// NOVA Standard Library — std/encoding/railfence
// ============================================================================
// Rail-fence transposition cipher.
//
// The rail-fence cipher writes plaintext in a zig-zag pattern across a fixed
// number of "rails" (rows), then reads off each row in order to produce the
// ciphertext. Decryption reverses the process.
//
// PUBLIC API:
//   rail_encrypt(text: string, rails: int) -> string
//     Encrypt `text` using the rail-fence cipher with `rails` rails.
//     Characters are placed on rails 0..rails-1 in zig-zag order; the output
//     is the concatenation of all rails read top-to-bottom.
//     If rails <= 1 or rails >= len(text), the text is returned unchanged.
//
//   rail_decrypt(cipher: string, rails: int) -> string
//     Reverse rail_encrypt. Reconstructs the original plaintext from the
//     rail-fence ciphertext given the same number of rails.
//     If rails <= 1 or rails >= len(cipher), the cipher is returned unchanged.
//
// ALGORITHM:
//   Encrypt:
//     1. Build zig-zag pattern: a list that maps each position to its rail.
//        Rail index oscillates: 0,1,2,...,rails-1,rails-2,...,1,0,1,...
//     2. Scatter each character to its rail (dict rail_str -> string accumulator).
//     3. Concatenate rail strings in order 0..rails-1.
//
//   Decrypt:
//     1. Build same zig-zag pattern to determine how many chars land on each rail.
//     2. Slice the ciphertext into per-rail segments using a dict of offsets.
//     3. Walk the zig-zag pattern again; for each position pull the next char
//        from the appropriate rail segment, advancing a per-rail read offset.
//
// COMPLEXITY: O(n) time, O(n) space for both encrypt and decrypt.
//
// EXAMPLES:
//   rail_encrypt("WEAREDISCOVEREDFLEEATONCE", 3) == "WECRLTEERDSOEEFEAOCAIVDEN"
//   rail_decrypt("WECRLTEERDSOEEFEAOCAIVDEN", 3) == "WEAREDISCOVEREDFLEEATONCE"
//   rail_encrypt("HELLO", 2)  == "HLOEL"
//   rail_decrypt("HLOEL", 2)  == "HELLO"
//   rail_encrypt("abc", 1)    == "abc"
//
// GOTCHAS:
//   - Dict keys must be strings; rail indices are converted via str().
//   - '/' is integer division in NOVA.
//   - No '&&'/'||'; use 'and'/'or'.
//   - While body starts with a let statement.
//
// Private helpers are prefixed _rail_ to avoid symbol collisions.
//
// LEAF — imports NOTHING.

// ── Private helpers ────────────────────────────────────────────────────────────

// _rail_build_pattern: compute the zig-zag rail assignment for each position.
// Returns a list of integers where result[i] is the rail (0..rails-1) that
// position i belongs to.
// Runs in O(n) time.
fn _rail_build_pattern(n, rails) -> list
    let pattern = []
    let rail = 0
    let dir = 1
    let i = 0
    while i < n
        let dummy = push(pattern, rail)
        if rail == rails - 1
            dir = -1
        else
            if rail == 0
                dir = 1
        rail = rail + dir
        i = i + 1
    pattern

// _rail_count_per_rail: count how many positions fall on each rail.
// `pattern` is from _rail_build_pattern; `rails` is the number of rails.
// Returns a dict mapping str(rail_index) -> count.
fn _rail_count_per_rail(pattern, rails) -> dict
    let counts = {}
    let r = 0
    while r < rails
        let k = str(r)
        counts[k] = 0
        r = r + 1
    let n = len(pattern)
    let i = 0
    while i < n
        let k = str(pattern[i])
        counts[k] = counts[k] + 1
        i = i + 1
    counts

// ── Public API ────────────────────────────────────────────────────────────────

// rail_encrypt: encrypt `text` using the rail-fence cipher.
//
// Characters are distributed across `rails` rails in zig-zag order,
// then all rails are concatenated top-to-bottom.
//
// Edge cases:
//   - rails <= 1: return text unchanged (single rail = identity).
//   - rails >= len(text): return text unchanged (every char on its own rail,
//     so read-order equals write-order).
//   - Empty text: return "".
//
// Examples:
//   rail_encrypt("WEAREDISCOVEREDFLEEATONCE", 3) == "WECRLTEERDSOEEFEAOCAIVDEN"
//   rail_encrypt("HELLO", 2)  == "HLOEL"
//   rail_encrypt("HELLO", 5)  == "HELLO"
//   rail_encrypt("abc", 1)    == "abc"
//   rail_encrypt("", 3)       == ""
fn rail_encrypt(text, rails) -> string
    let n = len(text)
    if n == 0
        return ""
    if rails <= 1
        return text
    if rails >= n
        return text
    // Build zig-zag pattern
    let pattern = _rail_build_pattern(n, rails)
    // Accumulate each rail's characters into a dict of strings
    let rail_str = {}
    let r = 0
    while r < rails
        let k = str(r)
        rail_str[k] = ""
        r = r + 1
    // Scatter characters to their rails
    let i = 0
    while i < n
        let k = str(pattern[i])
        rail_str[k] = rail_str[k] + text[i]
        i = i + 1
    // Concatenate rails in order
    let out = ""
    let j = 0
    while j < rails
        let k = str(j)
        out = out + rail_str[k]
        j = j + 1
    out

// rail_decrypt: decrypt a rail-fence ciphertext back to the original plaintext.
//
// Given the same number of rails used to encrypt, reconstructs the plaintext
// by reversing the zig-zag scatter/read process.
//
// Edge cases:
//   - rails <= 1: return cipher unchanged.
//   - rails >= len(cipher): return cipher unchanged.
//   - Empty cipher: return "".
//
// Examples:
//   rail_decrypt("WECRLTEERDSOEEFEAOCAIVDEN", 3) == "WEAREDISCOVEREDFLEEATONCE"
//   rail_decrypt("HLOEL", 2) == "HELLO"
//   rail_decrypt("abc", 1)   == "abc"
//   rail_decrypt("", 3)      == ""
fn rail_decrypt(cipher, rails) -> string
    let n = len(cipher)
    if n == 0
        return ""
    if rails <= 1
        return cipher
    if rails >= n
        return cipher
    // Step 1: build zig-zag pattern (same as encrypt)
    let pattern = _rail_build_pattern(n, rails)
    // Step 2: count how many chars on each rail
    let counts = _rail_count_per_rail(pattern, rails)
    // Step 3: slice ciphertext into per-rail segments using dict of start offsets
    // start_off[k] = index in cipher where rail k's segment begins
    // cur_off[k]   = current read position within rail k's segment
    let start_off = {}
    let cur_off = {}
    let offset = 0
    let r = 0
    while r < rails
        let k = str(r)
        start_off[k] = offset
        cur_off[k] = 0
        offset = offset + counts[k]
        r = r + 1
    // Step 4: walk zig-zag pattern; for each position read from the right rail
    let out = ""
    let i = 0
    while i < n
        let k = str(pattern[i])
        let pos = start_off[k] + cur_off[k]
        out = out + cipher[pos]
        cur_off[k] = cur_off[k] + 1
        i = i + 1
    out
