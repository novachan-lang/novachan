// ============================================================================
// NOVA Standard Library — std/encoding/properties
// ============================================================================
// Java-style .properties file parser and serializer.
//
// Supports the canonical Java .properties format:
//   - key=value  or  key:value  (both separators accepted)
//   - Leading/trailing whitespace trimmed around both key and value
//   - Lines starting with # or ! (after optional leading whitespace) are comments
//   - Blank lines are silently skipped
//   - Duplicate keys: last value wins
//
// PUBLIC API:
//   prop_parse(text: string) -> dict
//     Parse a .properties text into a dict mapping string keys to string values.
//     Comment lines (# or !) and blank lines are ignored.
//     Both = and : are accepted as key-value separators.
//     Whitespace around keys and values is trimmed.
//
//   prop_get(p: dict, key: string) -> string
//     Safely retrieve a value from a parsed properties dict.
//     Returns "" if the key is absent (guard with contains(p, key) for disambiguation).
//
//   prop_serialize(p: dict) -> string
//     Serialize a dict back to .properties text (key=value lines, one per entry).
//     Output is deterministic within a single run (dict iteration order).
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _prop_ to avoid collisions with other
//   std modules compiled into the same binary.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Trim leading ASCII whitespace (space=32, tab=9, CR=13, LF=10) from string s.
fn _prop_ltrim(s) -> string
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(s[i])
        if b == 32 or b == 9 or b == 13 or b == 10
            i += 1
        else
            return slice(s, i, n)
    ""

// Trim trailing ASCII whitespace from string s.
fn _prop_rtrim(s) -> string
    let n = len(s)
    let i = n - 1
    while i >= 0
        let b = ord(s[i])
        if b == 32 or b == 9 or b == 13 or b == 10
            i -= 1
        else
            return slice(s, 0, i + 1)
    ""

// Trim both leading and trailing ASCII whitespace.
fn _prop_trim(s) -> string
    let v = _prop_ltrim(s)
    _prop_rtrim(v)

// Split text into lines on LF (0x0A). CR before LF is handled by rtrim on each line.
fn _prop_lines(text) -> list
    let result = []
    let n = len(text)
    let start = 0
    for i in 0..n
        if ord(text[i]) == 10
            result.push(slice(text, start, i))
            start = i + 1
    // trailing content without a final newline
    if start < n
        result.push(slice(text, start, n))
    result

// Find the first occurrence of character c (as int ordinal) in s, starting
// at position 'from'. Returns -1 if not found.
fn _prop_index_of(s, c, from) -> int
    let n = len(s)
    let i = from
    while i < n
        if ord(s[i]) == c
            return i
        i += 1
    -1

// ── Public API ────────────────────────────────────────────────────────────────

// prop_parse: parse .properties text into a string->string dict.
//
// Algorithm per line:
//   1. Trim the raw line.
//   2. If empty after trim -> skip.
//   3. If first char is '#' or '!' -> comment, skip.
//   4. Find first '=' (61) or ':' (58) — whichever comes first.
//   5. Everything before it = key (trimmed); everything after = value (trimmed).
//   6. Lines with no separator at all: whole line is the key, value = "".
//
// Examples:
//   "a=1"          -> {"a": "1"}
//   "b : 2"        -> {"b": "2"}
//   "# comment"    -> (skipped)
//   "! comment"    -> (skipped)
//   "d=hello world"-> {"d": "hello world"}
//
fn prop_parse(text) -> dict
    let result = {}
    let lines = _prop_lines(text)
    let n = len(lines)
    let i = 0
    while i < n
        let raw = lines[i]
        let line = _prop_trim(raw)
        // skip blank
        if len(line) == 0
            i += 1
        else
            // check for comment
            let fc = ord(line[0])
            if fc == 35 or fc == 33
                // '#'=35, '!'=33 — comment line
                i += 1
            else
                // find first '=' or ':'
                let eq_pos = _prop_index_of(line, 61, 0)
                let co_pos = _prop_index_of(line, 58, 0)
                let sep = -1
                if eq_pos >= 0 and co_pos >= 0
                    // both found — pick the earlier one
                    if eq_pos < co_pos
                        sep = eq_pos
                    else
                        sep = co_pos
                else
                    if eq_pos >= 0
                        sep = eq_pos
                    else
                        sep = co_pos
                let key = ""
                let val = ""
                if sep < 0
                    // no separator — whole line is key, value is empty
                    key = _prop_trim(line)
                    val = ""
                else
                    key = _prop_rtrim(slice(line, 0, sep))
                    val = _prop_ltrim(slice(line, sep + 1, len(line)))
                if len(key) > 0
                    result[key] = val
                i += 1
    result

// prop_get: safely retrieve a value from a parsed properties dict.
//
// Returns the stored string value, or "" if the key is absent.
// To distinguish "key absent" from "key present with empty value", use
//   contains(p, key)  before calling prop_get.
//
fn prop_get(p, key) -> string
    if key in p
        return p[key]
    ""

// prop_serialize: convert a dict back into .properties text.
//
// Each entry is emitted as:  key=value\n
// Keys and values are written verbatim — no escaping is applied (values
// containing newlines will produce malformed output; callers must ensure
// values are single-line if round-tripping is required).
//
fn prop_serialize(p) -> string
    let out_parts = []
    let nl = chr(10)
    let keys = dict_keys(p)
    let n = len(keys)
    for i in 0..n
        let k = keys[i]
        let v = p[k]
        push(out_parts, k + "=" + v + nl)
    let out = join(out_parts, "")
    out
