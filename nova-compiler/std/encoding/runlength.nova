// ============================================================================
// NOVA Standard Library — std/encoding/runlength
// ============================================================================
// Run-length encoding (RLE) — compact representation of runs of repeated
// characters by prefixing each character with its decimal run count.
//
// Format:  <count1><char1><count2><char2>...
//   "aaabbc"  →  "3a2b1c"
//   "wwwwaaadexxxxxx"  →  "4w3a1d1e6x"
//
// Counts are positive decimal integers (≥1); multi-digit counts are fully
// supported in both directions ("10a" decodes to "aaaaaaaaaa").
//
// PUBLIC API:
//   rl_encode(s: string) -> string
//     Encode a string to RLE form. Each run of identical consecutive
//     characters becomes "<count><char>". Empty input returns "".
//
//   rl_decode(s: string) -> string
//     Decode an RLE string back to the original. Parses a sequence of
//     (decimal-integer, character) pairs. Empty input returns "".
//
//   rl_encode_pairs(s: string) -> list
//     Return a list of [char, count] pairs representing each run.
//     e.g. "aab" → [["a", 2], ["b", 1]]
//     Empty input returns [].
//
//   rl_decode_pairs(pairs: list) -> string
//     Reconstruct a string from a list of [char, count] pairs.
//     Empty list returns "".
//
// ALGORITHM NOTES:
//   encode: single pass O(n). Walk string, accumulate run length; when
//     character changes (or end reached) emit count+char.
//   decode: single pass O(n+output). Parse digit sequence into count;
//     next character is the run character. Repeat char × count and advance.
//   encode_pairs: same as encode but emits [char, count] sub-lists.
//   decode_pairs: for each pair [c, cnt], append c repeated cnt times.
//
// GOTCHAS:
//   • '/' in NOVA is integer division — no issue here (we use * for repeat).
//   • '>>' is arithmetic right shift — not used here.
//   • Booleans are ints in NOVA.
//   • No '&&'/'||' — use 'and'/'or'.
//   • Braces in strings interpolate — none appear in this module.
//
// Private helpers are prefixed _rl_ to avoid symbol collisions.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// _rl_repeat: repeat string `c` exactly `n` times.
// Returns "" for n <= 0.
fn _rl_repeat(c, n) -> string
    let out = ""
    for i in 0..n
        let dummy = 0
        out += c
    out

// _rl_int_to_str: convert a non-negative integer to its decimal string.
// Used when encoding run counts.
fn _rl_int_to_str(n) -> string
    if n == 0
        return "0"
    let digits = ""
    let v = n
    while v > 0
        let d = v - (v / 10) * 10
        digits = chr(48 + d) + digits
        v = v / 10
    digits

// ── Public API ────────────────────────────────────────────────────────────────

// rl_encode: encode a string to run-length form.
//
// Each maximal run of identical consecutive characters becomes "<count><char>".
// Single-character runs use count 1 (e.g. "abc" → "1a1b1c").
//
// Examples:
//   rl_encode("")             == ""
//   rl_encode("a")            == "1a"
//   rl_encode("aaabbc")       == "3a2b1c"
//   rl_encode("abc")          == "1a1b1c"
//   rl_encode("wwwwaaadexxxxxx") == "4w3a1d1e6x"
fn rl_encode(s) -> string
    let n = len(s)
    if n == 0
        return ""
    let out = ""
    let cur = s[0]
    let cnt = 1
    for i in 1..n
        let ch = s[i]
        if ch == cur
            cnt += 1
        else
            out += _rl_int_to_str(cnt) + cur
            cur = ch
            cnt = 1
    // emit the final run
    out += _rl_int_to_str(cnt) + cur
    out

// rl_decode: decode a run-length encoded string back to the original.
//
// Parses alternating (decimal-count, character) pairs from the input.
// Multi-digit counts are fully supported ("10a" → "aaaaaaaaaa").
// Stops gracefully at end of string; a trailing incomplete digit sequence
// with no following character is silently ignored.
//
// Examples:
//   rl_decode("")        == ""
//   rl_decode("3a2b1c")  == "aaabbc"
//   rl_decode("10a")     == "aaaaaaaaaa"
//   rl_decode("1a1b1c")  == "abc"
fn rl_decode(s) -> string
    let n = len(s)
    if n == 0
        return ""
    let out = ""
    let i = 0
    while i < n
        // parse decimal digits
        let cnt = 0
        let have_digit = 0
        let done = 0
        while i < n and done == 0
            let b = ord(s[i])
            if b >= 48 and b <= 57
                cnt = cnt * 10 + (b - 48)
                have_digit = 1
                i += 1
            else
                done = 1
        // next character is the run character (if we have digits and a char)
        if have_digit == 1 and i < n
            let ch = s[i]
            i += 1
            out += _rl_repeat(ch, cnt)
    out

// rl_encode_pairs: encode a string to a list of [char, count] pairs.
//
// Each element of the returned list is a two-element list [char, count]
// where char is a single-character string and count is a positive integer.
//
// Examples:
//   rl_encode_pairs("")       == []
//   rl_encode_pairs("aab")    == [["a", 2], ["b", 1]]
//   rl_encode_pairs("abc")    == [["a", 1], ["b", 1], ["c", 1]]
//   rl_encode_pairs("aaabbc") == [["a", 3], ["b", 2], ["c", 1]]
fn rl_encode_pairs(s) -> list
    let n = len(s)
    let result = []
    if n == 0
        return result
    let cur = s[0]
    let cnt = 1
    for i in 1..n
        let ch = s[i]
        if ch == cur
            cnt += 1
        else
            let pair = [cur, cnt]
            push(result, pair)
            cur = ch
            cnt = 1
    // emit the final run
    let last_pair = [cur, cnt]
    push(result, last_pair)
    result

// rl_decode_pairs: reconstruct a string from a list of [char, count] pairs.
//
// Each pair must be a two-element list where pair[0] is a character string
// and pair[1] is a positive integer count.
//
// Examples:
//   rl_decode_pairs([])                        == ""
//   rl_decode_pairs([["a", 2], ["b", 1]])      == "aab"
//   rl_decode_pairs([["w", 4], ["x", 3]])      == "wwwwxxx"
fn rl_decode_pairs(pairs) -> string
    let out_parts = []
    let i = 0
    let np = len(pairs)
    while i < np
        let pair = pairs[i]
        let ch = pair[0]
        let cnt = pair[1]
        push(out_parts, _rl_repeat(ch, cnt))
        i += 1
    let out = join(out_parts, "")
    out
