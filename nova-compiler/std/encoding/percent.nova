// ============================================================================
// NOVA Standard Library — std/encoding/percent
// ============================================================================
// RFC 3986 URL percent-encoding. Binary-safe: the raw-data side is `bytes`
// so 0x00 bytes survive encode and decode without truncation.
//
// THE BINARY-SAFETY PROPERTY:
//   NOVA strings are C-string-shaped: a 0x00 byte in a string silently
//   truncates it (reference_nova_string_nul_truncation). Percent-encoding is
//   used for binary payloads (query values, path segments, auth tokens) which
//   CAN contain 0x00. This module takes and returns `bytes` on the data side.
//   The encoded TEXT side is a plain string (only [A-Za-z0-9\-._~%] appear —
//   none of which is 0x00, so the text side is always NUL-safe).
//
// THE DRAWBACK AVOIDED — form-encoding confusion:
//   application/x-www-form-urlencoded maps SPACE <-> '+' in addition to %20.
//   RFC 3986 percent-encoding does NOT do this. This module is STRICT RFC 3986:
//   '+' encodes as "%2B" and decodes as its literal byte value 0x2B (43).
//   If you need form-encoding, use a form-encoding module; do NOT use this one.
//
// PUBLIC API:
//   percent_encode(data: bytes) -> string
//     RFC 3986 unreserved characters (A-Za-z0-9 - . _ ~) pass through as-is.
//     Every other byte encodes as "%XX" with UPPERCASE hex digits.
//     A zero byte (0x00) encodes as "%00" and round-trips correctly.
//
//   percent_decode(s: string) -> bytes
//     "%XX" sequences (uppercase or lowercase hex) decode to the byte value.
//     A literal '+' decodes as its byte value 0x2B — NOT a space.
//     A lone or malformed '%' passes through as its byte value 0x25.
//     The result is always a valid `bytes` value; never errors hard.
//
//   pct_encode_component(s: string) -> string
//     RFC 3986 encoding of a whole string (the string is treated as its raw
//     UTF-8/byte sequence — multi-byte characters get every byte encoded).
//     Only the unreserved set passes through. Convenience wrapper around
//     percent_encode(str_to_bytes(s)) for the common string-in/string-out
//     case (e.g. encoding one path segment or one query parameter value).
//
//   pct_encode_path(s: string) -> string
//     Like pct_encode_component but ALSO preserves '/' (0x2F) unescaped —
//     for encoding an already-segmented path (e.g. "a/b c" -> "a/b%20c")
//     without exploding the segment separators.
//
//   pct_encode_query(s: string) -> string
//     Like pct_encode_component but ALSO preserves '&' (0x26) and '='
//     (0x3D) unescaped — for encoding an already-assembled "k=v&k2=v2"
//     query string where the structural characters must survive.
//
//   pct_decode(s: string) -> string
//     Strict RFC 3986 decode (same rules as percent_decode) returning a
//     `string` instead of `bytes`. NOTE: decoded bytes are pushed through
//     NOVA's C-string-shaped `string` type, so a decoded 0x00 byte will
//     truncate the result exactly like any other NOVA string
//     (reference_nova_string_nul_truncation) — use percent_decode (bytes)
//     if the payload may contain NUL.
//
//   pct_encode_form(s: string) -> string
//     application/x-www-form-urlencoded encoding: space (0x20) becomes '+',
//     unreserved characters pass through, everything else (including a
//     literal '+', which would otherwise collide with the space encoding)
//     becomes "%XX".
//
//   pct_decode_form(s: string) -> string
//     The inverse of pct_encode_form: '+' decodes to a space, "%XX"
//     sequences decode per the usual rules, everything else passes through.
//
// ROUND-TRIP GUARANTEE:
//   percent_decode(percent_encode(x)) == x  for any bytes value x.
//   This holds even when x contains 0x00, 0xFF, or any binary value.
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _pct_ to avoid collisions with other
//   std modules compiled into the same binary.
//
// ARITHMETIC HAZARD — >> IS ARITHMETIC IN NOVA:
//   We use (b >> 4) & 0x0F and b & 0x0F to extract nibbles. The mask after
//   the shift is mandatory to guard against sign-extension on any negative value
//   (bytes_get returns an int; & 0xFF first, then nibble-split).
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Uppercase hex alphabet for encoding.
fn _pct_alpha() -> string
    "0123456789ABCDEF"

// Map one ASCII character byte-value to its hex nibble (0..15).
// Returns -1 if the character is not a valid hex digit.
fn _pct_hexval(b) -> int
    if b >= 48 and b <= 57
        return b - 48
    if b >= 65 and b <= 70
        return b - 55
    if b >= 97 and b <= 102
        return b - 87
    return -1

// Return 1 if byte value b is an RFC 3986 unreserved character, 0 otherwise.
// Unreserved set: A-Z (65-90), a-z (97-122), 0-9 (48-57), '-'(45), '.'(46),
// '_'(95), '~'(126).
fn _pct_unreserved(b) -> int
    if b >= 65 and b <= 90
        return 1
    if b >= 97 and b <= 122
        return 1
    if b >= 48 and b <= 57
        return 1
    if b == 45 or b == 46 or b == 95 or b == 126
        return 1
    return 0

// ── Public API ────────────────────────────────────────────────────────────────

// percent_encode: convert binary bytes to an RFC 3986 percent-encoded string.
//
// Each byte in `data` that belongs to the RFC 3986 unreserved set
// (A-Za-z0-9 - . _ ~) is passed through as the corresponding ASCII character.
// Every other byte, including 0x00, is encoded as "%XX" where XX is two
// uppercase hex digits.
//
// Examples:
//   percent_encode(bytes of "hello")   == "hello"          (all unreserved)
//   percent_encode(bytes of "a b")     == "a%20b"          (space = 0x20)
//   percent_encode(bytes of "a/b?c=d") == "a%2Fb%3Fc%3Dd"  (reserved encoded)
//   percent_encode(bytes of "~-._")    == "~-._"           (all unreserved)
//   percent_encode(bytes of [0x00,0xFF]) == "%00%FF"
fn percent_encode(data) -> string
    let alpha = _pct_alpha()
    let out = ""
    let nb = bytes_len(data)
    let i = 0
    while i < nb
        let b = bytes_get(data, i) & 0xFF
        if _pct_unreserved(b) == 1
            out = out + chr(b)
        else
            let hi = (b >> 4) & 0x0F
            let lo = b & 0x0F
            out = out + "%" + alpha[hi] + alpha[lo]
        i = i + 1
    return out

// percent_decode: convert an RFC 3986 percent-encoded string back to bytes.
//
// "%XX" sequences (case-insensitive hex digits) decode to the corresponding
// byte value. A literal '+' is NOT treated as a space — it decodes as byte
// 0x2B (this is RFC 3986, not form-encoding). A lone '%' or a '%' followed
// by fewer than two hex digits passes through as byte 0x25. A '%' followed
// by non-hex characters passes through as byte 0x25 and the non-hex
// characters are processed normally.
//
// Returns a `bytes` value. Never throws; always returns a valid result.
//
// Examples:
//   percent_decode("a%20b")  -> bytes [0x61, 0x20, 0x62]   (= "a b")
//   percent_decode("%00%ff") -> bytes [0x00, 0xFF]          (case-insensitive)
//   percent_decode("hello")  -> bytes [0x68,0x65,0x6C,0x6C,0x6F]
fn percent_decode(s) -> any
    let out = bytes(0)
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(s[i])
        if b == 37 and i + 2 < n
            let hi = _pct_hexval(ord(s[i + 1]))
            let lo = _pct_hexval(ord(s[i + 2]))
            if hi >= 0 and lo >= 0
                out = bytes_append(out, (hi * 16 + lo) & 0xFF)
                i = i + 3
            else
                out = bytes_append(out, 37)
                i = i + 1
        else if b == 37
            out = bytes_append(out, 37)
            i = i + 1
        else
            out = bytes_append(out, b & 0xFF)
            i = i + 1
    return out

// ── Extended RFC 3986 / form encoding (component / path / query / form) ────────

// Shared encode core: unreserved set PLUS up to two extra "preserve" byte
// values (pass -1 for a slot to skip). Every other byte becomes "%XX" with
// uppercase hex digits.
fn _pct_encode_extra(data, extra_a, extra_b) -> string
    let alpha = _pct_alpha()
    let out = ""
    let nb = bytes_len(data)
    let i = 0
    while i < nb
        let b = bytes_get(data, i) & 0xFF
        if _pct_unreserved(b) == 1 or b == extra_a or b == extra_b
            out = out + chr(b)
        else
            let hi = (b >> 4) & 0x0F
            let lo = b & 0x0F
            out = out + "%" + alpha[hi] + alpha[lo]
        i = i + 1
    return out

// pct_encode_component: RFC 3986 percent-encode an entire string, escaping
// everything outside the unreserved set (A-Za-z0-9 - . _ ~). The natural
// choice for encoding ONE opaque value that must not be interpreted as
// structure by whatever it's embedded in (a single path segment, a single
// query parameter's value or key).
//
// Examples:
//   pct_encode_component("hello world") == "hello%20world"
//   pct_encode_component("a/b?c=d")     == "a%2Fb%3Fc%3Dd"
//   pct_encode_component("")            == ""
fn pct_encode_component(s) -> string
    return _pct_encode_extra(str_to_bytes(s), -1, -1)

// pct_encode_path: RFC 3986 percent-encode a string that is already a
// composed path (multiple segments joined by '/'), preserving the '/'
// separators unescaped so the path structure survives.
//
// Examples:
//   pct_encode_path("/a/b c/d")  == "/a/b%20c/d"
//   pct_encode_path("a/b?c")     == "a/b%3Fc"
fn pct_encode_path(s) -> string
    return _pct_encode_extra(str_to_bytes(s), 47, -1)

// pct_encode_query: RFC 3986 percent-encode a string that is already a
// composed "key=value&key2=value2" query string, preserving '&' and '='
// unescaped so the query structure survives.
//
// Examples:
//   pct_encode_query("q=hello world&lang=en") == "q=hello%20world&lang=en"
//   pct_encode_query("a=b/c")                 == "a=b%2Fc"
fn pct_encode_query(s) -> string
    return _pct_encode_extra(str_to_bytes(s), 38, 61)

// pct_decode: strict RFC 3986 percent-decode, returning a `string`.
// "%XX" sequences (case-insensitive hex) decode to the byte value; '+'
// decodes as literal 0x2B (NOT a space — this is RFC 3986, not form
// encoding); a malformed/lone '%' passes through as byte 0x25. Never
// errors hard.
//
// NOTE (binary safety): the result is a NOVA `string`, which is
// C-string-shaped — a decoded 0x00 byte truncates it. Use percent_decode
// (returns `bytes`) if the encoded payload might contain a NUL byte.
//
// Examples:
//   pct_decode("hello%20world") == "hello world"
//   pct_decode("a%2Fb%3Fc%3Dd") == "a/b?c=d"
//   pct_decode("100%25")        == "100%"
//   pct_decode("already-plain") == "already-plain"
fn pct_decode(s) -> string
    return bytes_to_str(percent_decode(s))

// pct_encode_form: application/x-www-form-urlencoded encoding. Space
// (0x20) becomes '+'; unreserved characters pass through as-is; every
// other byte — including a literal '+' (0x2B), which must NOT collide
// with the space encoding — becomes "%XX".
//
// Examples:
//   pct_encode_form("hello world") == "hello+world"
//   pct_encode_form("a+b")         == "a%2Bb"
//   pct_encode_form("q=1&r=2")     == "q%3D1%26r%3D2"
fn pct_encode_form(s) -> string
    let data = str_to_bytes(s)
    let alpha = _pct_alpha()
    let out = ""
    let nb = bytes_len(data)
    let i = 0
    while i < nb
        let b = bytes_get(data, i) & 0xFF
        if b == 32
            out = out + "+"
        else if _pct_unreserved(b) == 1
            out = out + chr(b)
        else
            let hi = (b >> 4) & 0x0F
            let lo = b & 0x0F
            out = out + "%" + alpha[hi] + alpha[lo]
        i = i + 1
    return out

// pct_decode_form: inverse of pct_encode_form. '+' decodes to a space;
// "%XX" sequences decode per the usual case-insensitive-hex rules; every
// other character passes through unchanged. Never errors hard.
//
// Examples:
//   pct_decode_form("hello+world") == "hello world"
//   pct_decode_form("a%2Bb")       == "a+b"
//   pct_decode_form("q%3D1%26r%3D2") == "q=1&r=2"
fn pct_decode_form(s) -> string
    let out = bytes(0)
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(s[i])
        if b == 43
            out = bytes_append(out, 32)
            i = i + 1
        else if b == 37 and i + 2 < n
            let hi = _pct_hexval(ord(s[i + 1]))
            let lo = _pct_hexval(ord(s[i + 2]))
            if hi >= 0 and lo >= 0
                out = bytes_append(out, (hi * 16 + lo) & 0xFF)
                i = i + 3
            else
                out = bytes_append(out, 37)
                i = i + 1
        else if b == 37
            out = bytes_append(out, 37)
            i = i + 1
        else
            out = bytes_append(out, b & 0xFF)
            i = i + 1
    return bytes_to_str(out)
