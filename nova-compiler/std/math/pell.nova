// std/math/pell.nova — Pell numbers, companion (Pell-Lucas) sequence, and Pell equation solver.
// LEAF — imports NOTHING.
//
// Pell numbers:       P(0)=0, P(1)=1, P(n)=2*P(n-1)+P(n-2)
//   Values: 0, 1, 2, 5, 12, 29, 70, 169, 408, 985, ...
//
// Companion (Pell-Lucas / Q) sequence: Q(0)=2, Q(1)=2, Q(n)=2*Q(n-1)+Q(n-2)
//   Values: 2, 2, 6, 14, 34, 82, 198, ...
//
// Pell equation: x^2 - D*y^2 = 1, fundamental solution via brute search over y.
//
// Public API:
//   pel_pell(n)            -> int   nth Pell number (0-indexed)
//   pel_companion(n)       -> int   nth companion Pell-Lucas number (0-indexed)
//   pel_solve_equation(D)  -> list  [x, y] fundamental solution of x^2 - D*y^2 = 1
//   pel_list(n)            -> list  first n Pell numbers [P(0)..P(n-1)]
//
// Private helpers use the pel_ prefix (all helpers also private-prefixed).

// pel_isqrt — integer square root (Newton's method).
// Returns floor(sqrt(v)). Returns 0 for v <= 0.
fn pel_isqrt(v: int) -> int
    if v <= 0
        return 0
    let x = v
    let y = (v + 1) / 2
    while y < x
        x = y
        y = (y + v / y) / 2
    x

// pel_is_perfect_square — returns 1 if v is a perfect square, 0 otherwise.
fn pel_is_perfect_square(v: int) -> int
    if v < 0
        return 0
    let r = pel_isqrt(v)
    if r * r == v
        return 1
    return 0

// pel_pell — nth Pell number (0-indexed, iterative).
// P(0)=0, P(1)=1, P(n)=2*P(n-1)+P(n-2) for n>=2.
// Returns 0 for n <= 0.
fn pel_pell(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 1
    let a = 0
    let b = 1
    let i = 2
    while i <= n
        let c = 2 * b + a
        a = b
        b = c
        i = i + 1
    b

// pel_companion — nth companion Pell-Lucas (Q) number (0-indexed, iterative).
// Q(0)=2, Q(1)=2, Q(n)=2*Q(n-1)+Q(n-2) for n>=2.
// Returns 2 for n <= 0.
fn pel_companion(n: int) -> int
    if n <= 0
        return 2
    if n == 1
        return 2
    let a = 2
    let b = 2
    let i = 2
    while i <= n
        let c = 2 * b + a
        a = b
        b = c
        i = i + 1
    b

// pel_solve_equation — fundamental solution [x, y] of x^2 - D*y^2 = 1.
// D must be a non-square integer > 1. For square D or D <= 1, returns [0, 0].
// Uses brute-force increasing y; correct for moderate D (fundamental solution
// grows roughly as exp(pi / sqrt(D)) so small D is always fast).
fn pel_solve_equation(D: int) -> list
    let empty = []
    push(empty, 0)
    push(empty, 0)
    if D <= 1
        return empty
    // Reject perfect-square D (no solution exists)
    let sq = pel_is_perfect_square(D)
    if sq == 1
        return empty
    let y = 1
    let found = 0
    let rx = 0
    let ry = 0
    while found == 0
        let rhs = D * y * y + 1
        let chk = pel_is_perfect_square(rhs)
        if chk == 1
            let x = pel_isqrt(rhs)
            rx = x
            ry = y
            found = 1
        y = y + 1
    let out = []
    push(out, rx)
    push(out, ry)
    out

// pel_list — first n Pell numbers: [P(0), P(1), ..., P(n-1)].
// pel_list(0)=[], pel_list(1)=[0], pel_list(6)=[0,1,2,5,12,29].
fn pel_list(n: int) -> list
    let out = []
    if n <= 0
        return out
    push(out, 0)
    if n == 1
        return out
    push(out, 1)
    if n == 2
        return out
    let a = 0
    let b = 1
    for i in 2..n
        let c = 2 * b + a
        a = b
        b = c
        push(out, b)
    out
