// std/math/variance.nova — variance, standard deviation, and moment statistics.
// Provides population AND sample variants explicitly.
// Distinct from std/math/stats which offers a broader descriptive set; this
// module owns the population/sample split and higher moments.
//
// All functions take a list of ints or floats.
// Empty list returns 0.0 (no crash / no divide-by-zero).
// Float arithmetic: multiply by 1.0 to coerce int elements.
// LEAF — imports NOTHING.
//
// Functions:
//   var_population(xs)  -> float   mean of squared deviations (divide by n)
//   var_sample(xs)      -> float   unbiased estimator          (divide by n-1)
//   sd_population(xs)   -> float   sqrt(var_population)
//   sd_sample(xs)       -> float   sqrt(var_sample)
//   var_coefficient(xs) -> float   sd_sample / mean  (coefficient of variation)
//   var_zscore(x, xs)   -> float   (x - mean) / sd_population

// Private: sum of elements as float.
fn _var_sum(xs: list) -> float
    let s = 0.0
    for i in 0..len(xs)
        s += xs[i] * 1.0
    s

// Private: arithmetic mean as float; 0.0 on empty.
fn _var_mean(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    _var_sum(xs) / (n * 1.0)

// Population variance: E[(X - mu)^2]  i.e. divide by n.
fn var_population(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let mu = _var_mean(xs)
    let acc = 0.0
    for i in 0..n
        let d = xs[i] * 1.0 - mu
        acc += d * d
    acc / (n * 1.0)

// Sample variance: unbiased estimator, divide by n-1 (Bessel's correction).
// Returns 0.0 when n < 2 (undefined; single element has no spread).
fn var_sample(xs: list) -> float
    let n = len(xs)
    if n < 2
        return 0.0
    let mu = _var_mean(xs)
    let acc = 0.0
    for i in 0..n
        let d = xs[i] * 1.0 - mu
        acc += d * d
    acc / ((n - 1) * 1.0)

// Population standard deviation: sqrt(var_population).
// Bind sqrt result to a local (NOVA float-return safety rule).
fn sd_population(xs: list) -> float
    let v = var_population(xs)
    let sd = sqrt(v)
    sd

// Sample standard deviation: sqrt(var_sample).
fn sd_sample(xs: list) -> float
    let v = var_sample(xs)
    let sd = sqrt(v)
    sd

// Coefficient of variation: sd_sample / mean.
// Measures relative dispersion; 0.0 when mean == 0.0 or n < 2.
fn var_coefficient(xs: list) -> float
    let n = len(xs)
    if n < 2
        return 0.0
    let mu = _var_mean(xs)
    if mu < 0.0001 and mu > -0.0001
        return 0.0
    let sd = sd_sample(xs)
    sd / mu

// Z-score of a single value x relative to the population xs:
//   z = (x - mean) / sd_population.
// Returns 0.0 if population is empty or sd is 0.
fn var_zscore(x: float, xs: list) -> float
    if len(xs) == 0
        return 0.0
    let mu = _var_mean(xs)
    let sd = sd_population(xs)
    if sd < 0.0000001 and sd > -0.0000001
        return 0.0
    (x - mu) / sd
