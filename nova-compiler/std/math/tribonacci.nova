// std/math/tribonacci.nova — Tribonacci sequence utilities (iterative, 64-bit ints).
// LEAF — imports NOTHING.
//
// Public API:
//   trib(n)      -> int   nth Tribonacci number, 0-indexed: T(0)=0, T(1)=1, T(2)=1
//   trib_list(n) -> list  first n Tribonacci numbers [T(0)..T(n-1)]
//   trib_sum(n)  -> int   sum of first n Tribonacci numbers T(0)+...+T(n-1)
//
// Recurrence: T(n) = T(n-1) + T(n-2) + T(n-3) for n >= 3.
// Seed values: T(0)=0, T(1)=1, T(2)=1.
//
// Private helpers use the _tb_ prefix to avoid cross-module symbol collisions.
// All functions are purely iterative (no recursion).

// trib — nth Tribonacci number (0-indexed, iterative).
// T(0)=0, T(1)=1, T(2)=1, T(3)=2, T(4)=4, T(5)=7, T(6)=13, T(7)=24.
// Returns 0 for n < 0.
fn trib(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 1
    if n == 2
        return 1
    let a = 0
    let b = 1
    let c = 1
    let i = 3
    while i <= n
        let d = a + b + c
        a = b
        b = c
        c = d
        i = i + 1
    c

// trib_list — list of first n Tribonacci numbers: [T(0), T(1), ..., T(n-1)].
// trib_list(0)=[], trib_list(1)=[0], trib_list(3)=[0,1,1], trib_list(7)=[0,1,1,2,4,7,13].
fn trib_list(n: int) -> list
    let out = []
    if n <= 0
        return out
    push(out, 0)
    if n == 1
        return out
    push(out, 1)
    if n == 2
        return out
    push(out, 1)
    if n == 3
        return out
    let a = 0
    let b = 1
    let c = 1
    for i in 3..n
        let d = a + b + c
        a = b
        b = c
        c = d
        push(out, c)
    out

// trib_sum — sum of first n Tribonacci numbers: T(0)+T(1)+...+T(n-1).
// trib_sum(0)=0, trib_sum(1)=0, trib_sum(7)=0+1+1+2+4+7+13=28.
// Iterates the sequence once, accumulating.
fn trib_sum(n: int) -> int
    if n <= 0
        return 0
    if n == 1
        return 0
    if n == 2
        return 1
    if n == 3
        return 2
    let a = 0
    let b = 1
    let c = 1
    let acc = 2
    for i in 3..n
        let d = a + b + c
        a = b
        b = c
        c = d
        acc = acc + c
    acc
