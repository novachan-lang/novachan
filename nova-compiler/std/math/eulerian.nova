// std/math/eulerian.nova — Eulerian numbers A(n,k).
// LEAF — imports NOTHING.
//
// An Eulerian number A(n,k) counts the number of permutations of {1..n}
// that have exactly k ascents (positions i where perm[i] < perm[i+1]).
//
// Public API:
//   eu_number(n, k)   -> int   A(n,k) via recurrence
//   eu_row(n)         -> list  [A(n,0), A(n,1), ..., A(n,n-1)]  (length n, or [1] for n=0)
//   eu_triangle(n)    -> list  list of n+1 rows: row 0 = [1], row k = eu_row(k)
//
// Recurrence:
//   A(0,0) = 1
//   A(n,k) = 0  when k < 0 or k >= n  (for n > 0)
//   A(n,k) = (k+1)*A(n-1,k) + (n-k)*A(n-1,k-1)
//
// Row sums: sum of A(n,k) for k=0..n-1 = n! (all permutations of length n).
//
// Notable values:
//   A(1,0)=1
//   A(2,0)=1, A(2,1)=1
//   A(3,0)=1, A(3,1)=4, A(3,2)=1
//   A(4,0)=1, A(4,1)=11, A(4,2)=11, A(4,3)=1
//   A(5,0)=1, A(5,1)=26, A(5,2)=66, A(5,3)=26, A(5,4)=1
//
// Private helpers use the _eu_ prefix.

// _eu_prev_val — safely read A(n-1, idx) from a previous-row list.
// Returns 0 for out-of-bounds indices (k < 0 or k >= len(prev)).
fn _eu_prev_val(prev: list, idx: int) -> int
    let plen = len(prev)
    if idx < 0
        return 0
    if idx >= plen
        return 0
    prev[idx]

// _eu_next_row — given row n-1 as a list of length n (indices 0..n-1),
// produce row n as a list of length n+1 (indices 0..n).
//
// A(n, k) = (k+1)*A(n-1, k) + (n-k)*A(n-1, k-1)
//
// For row index n, we build indices k = 0..n (n+1 elements).
// A(n, n) = 0 always (no permutation of n elements has n ascents).
fn _eu_next_row(prev: list, n: int) -> list
    let row = []
    let k = 0
    while k <= n
        let term1 = (k + 1) * _eu_prev_val(prev, k)
        let term2 = (n - k) * _eu_prev_val(prev, k - 1)
        push(row, term1 + term2)
        k = k + 1
    row

// eu_triangle — build rows 0 through n of the Eulerian triangle.
// Returns a list of n+1 lists.
//   Row 0: [1]          (A(0,0)=1)
//   Row 1: [1, 0]       (A(1,0)=1; A(1,1)=0 excluded by convention -> see eu_row)
//   Row k: length k+1, last element always 0
//
// Note: eu_triangle stores the FULL row including the trailing 0 for n>0.
// eu_row() trims the trailing 0 for n>=1.
fn eu_triangle(n: int) -> list
    let tri = []
    let row0 = []
    push(row0, 1)
    push(tri, row0)
    if n <= 0
        return tri
    let i = 1
    while i <= n
        let prev = tri[i - 1]
        let next = _eu_next_row(prev, i)
        push(tri, next)
        i = i + 1
    tri

// eu_number — compute A(n,k) directly.
// A(0,0)=1; A(n,k)=0 for k<0 or k>=n when n>0.
fn eu_number(n: int, k: int) -> int
    if n < 0
        return 0
    if k < 0
        return 0
    if n == 0
        if k == 0
            return 1
        return 0
    // k >= n means no permutation of n elements has >= n ascents
    if k >= n
        return 0
    // Build triangle up to row n and read off A(n,k)
    let tri = eu_triangle(n)
    let row = tri[n]
    row[k]

// eu_row — return [A(n,0), A(n,1), ..., A(n,n-1)].
// Length is max(1, n) — for n=0 returns [1], for n>=1 returns n elements
// (the last element A(n,n-1) for n>=1 is always 1).
fn eu_row(n: int) -> list
    if n <= 0
        let out = []
        push(out, 1)
        return out
    // eu_triangle row n has length n+1; last element is 0 (A(n,n)=0)
    // We trim it to length n.
    let tri = eu_triangle(n)
    let full = tri[n]
    let out = [full[k] for k in 0..n]
    out
