// std/math/egyptian.nova
// Egyptian (unit) fractions — Fibonacci-Sylvester greedy decomposition.
// All arithmetic is pure integer; denominators may grow large but stay in i64.
// LEAF — imports NOTHING.
//
// Public API:
//   eg_reduce(num, den)        -> list [n, d]   reduce num/den to lowest terms
//   eg_is_unit(num, den)       -> int (1=true)  does num/den reduce to 1/k for some k?
//   eg_decompose(num, den)     -> list           denominators of unit fractions summing to
//                                                num/den (0 < num < den); greedy algorithm.
//
// ALGORITHM — Fibonacci-Sylvester greedy:
//   1. Given num/den, compute k = ceil(den/num) = (den + num - 1) / num.
//   2. Append k to result list; subtract 1/k: new fraction = (num*k - den) / (den*k).
//   3. Reduce the new fraction; repeat until numerator reaches 0.
//
// OVERFLOW NOTE: denominators grow roughly exponentially.  For typical inputs
// (num/den well below 1, small values) the algorithm terminates in O(num) steps
// and intermediate products fit comfortably in signed 64-bit integers for
// denominators up to ~10^9.

// _eg_gcd — Euclidean GCD; always returns a value >= 1 (returns 1 when both 0).
fn _eg_gcd(a, b)
    let u = a
    let v = b
    if u < 0
        u = 0 - u
    if v < 0
        v = 0 - v
    while v != 0
        let t = u % v
        u = v
        v = t
    if u == 0
        return 1
    u

// eg_reduce(num, den) -> list [n, d]
// Reduces num/den to lowest terms; always returns positive denominator.
// eg_reduce(4, 10) -> [2, 5]; eg_reduce(2, 6) -> [1, 3].
fn eg_reduce(num, den)
    let n = num
    let d = den
    if d < 0
        n = 0 - n
        d = 0 - d
    if d == 0
        d = 1
    let g = _eg_gcd(n, d)
    let rn = n / g
    let rd = d / g
    let out = []
    out.push(rn)
    out.push(rd)
    out

// eg_is_unit(num, den) -> int (1 = true, 0 = false)
// Returns 1 if num/den reduces to a unit fraction 1/k for some positive integer k.
// eg_is_unit(1, 5) -> 1; eg_is_unit(2, 6) -> 1 (since 2/6 = 1/3); eg_is_unit(2, 5) -> 0.
fn eg_is_unit(num, den)
    let n = num
    let d = den
    if d < 0
        n = 0 - n
        d = 0 - d
    let g = _eg_gcd(n, d)
    let rn = n / g
    if rn == 1
        return 1
    0

// eg_decompose(num, den) -> list of denominators
// Greedy Fibonacci-Sylvester decomposition of num/den (requires 0 < num < den).
// Returns list of distinct integer denominators k1 < k2 < ... such that
// 1/k1 + 1/k2 + ... == num/den exactly.
// eg_decompose(2, 3) -> [2, 6]; eg_decompose(4, 5) -> [2, 4, 20].
fn eg_decompose(num, den)
    let result = []
    let cur_n = num
    let cur_d = den
    let done = 0
    while done == 0
        // Reduce current fraction
        let g = _eg_gcd(cur_n, cur_d)
        cur_n = cur_n / g
        cur_d = cur_d / g
        // Check termination: numerator reached 0
        if cur_n == 0
            done = 1
        if done == 0
            // k = ceil(cur_d / cur_n) = (cur_d + cur_n - 1) / cur_n
            let k = (cur_d + cur_n - 1) / cur_n
            result.push(k)
            // Subtract 1/k: new_n = cur_n*k - cur_d, new_d = cur_d*k
            let new_n = cur_n * k - cur_d
            let new_d = cur_d * k
            cur_n = new_n
            cur_d = new_d
    result
