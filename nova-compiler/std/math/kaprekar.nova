// std/math/kaprekar.nova — Kaprekar numbers and the 6174 routine.
// LEAF — imports NOTHING.
//
// Public API:
//   kap_is(n)              -> bool  true if n is a Kaprekar number
//   kap_upto(limit)        -> list  all Kaprekar numbers in [1, limit]
//   kap_routine_6174(n)    -> int   # iterations to reach 6174; -1 for repdigits
//
// DEFINITION (kap_is):
//   n is Kaprekar if n > 0 AND:
//     let sq = n * n
//     let d  = digit count of n          (e.g. 45 -> d=2)
//     let pw = 10^d                      (e.g. 45 -> pw=100)
//     let right = sq mod pw              (e.g. 2025 mod 100 = 25)
//     let left  = sq / pw                (e.g. 2025 / 100 = 20)
//     left + right == n   AND  right > 0 (right may NOT be 0 for n > 1;
//                                         but also right != sq, i.e. left != 0,
//                                         unless n == 1 which is a traditional exception)
//   n = 1 is treated as Kaprekar by convention.
//
// KNOWN ANSWERS (hand-traced):
//   kap_is(1)   true   (conventional)
//   kap_is(9)   true   9*9=81  d=1 pw=10  right=1 left=8   8+1=9
//   kap_is(45)  true   45*45=2025 d=2 pw=100 right=25 left=20  20+25=45
//   kap_is(55)  true   55*55=3025 d=2 pw=100 right=25 left=30  30+25=55
//   kap_is(99)  true   99*99=9801 d=2 pw=100 right=01  left=98  98+1=99
//   kap_is(297) true   297*297=88209 d=3 pw=1000 right=209 left=88  88+209=297
//   kap_is(10)  false  10*10=100 d=2 pw=100 right=0 left=1  1+0!=10
//
// KAPREKAR'S ROUTINE (4-digit):
//   Given a 4-digit number (not all same digit), arrange digits descending, ascending,
//   subtract ascending from descending. Repeat until reaching 6174.
//   kap_routine_6174(3524): 5432-2345=3087, 8730-0378=8352, 8532-2358=6174 -> 3 steps.
//   Returns -1 if n is a repdigit (all 4 digits identical, e.g. 1111).
//
// Private helpers use the _kp_ prefix.

// _kp_pow10 — compute 10^exp for exp >= 0.
fn _kp_pow10(exp: int) -> int
    let result = 1
    for i in 0..exp
        result *= 10
    result

// _kp_digit_count — number of decimal digits of n (n >= 1).
fn _kp_digit_count(n: int) -> int
    let v = n
    let count = 0
    while v > 0
        count += 1
        v /= 10
    count

// kap_is — true if n is a Kaprekar number (n >= 1 required).
// n=1 is Kaprekar by convention.
// For n > 1: compute sq = n*n, split right part to same digit-width as n;
// require left+right == n, right > 0, and left > 0 (right != sq).
fn kap_is(n: int) -> bool
    if n <= 0
        return false
    if n == 1
        return true
    let sq = n * n
    let d = _kp_digit_count(n)
    let pw = _kp_pow10(d)
    let right = sq % pw
    let left = sq / pw
    // right must be > 0 and left must be > 0 (right is not the whole square)
    if right == 0
        return false
    if left == 0
        return false
    left + right == n

// kap_upto — list of all Kaprekar numbers in [1, limit], ascending.
fn kap_upto(limit: int) -> list
    let out = []
    if limit < 1
        return out
    for k in 1..limit + 1
        if kap_is(k)
            push(out, k)
    out

// _kp_digits4 — extract the 4 digits of a 4-digit number as a sorted list (ascending).
// Used internally for the Kaprekar routine.
fn _kp_digits4(n: int) -> list
    let d0 = n % 10
    let d1 = (n / 10) % 10
    let d2 = (n / 100) % 10
    let d3 = (n / 1000) % 10
    let digits = [d0, d1, d2, d3]
    sort(digits)
    digits

// _kp_is_repdigit4 — true if all 4 digits of n are the same.
fn _kp_is_repdigit4(n: int) -> bool
    let digits = _kp_digits4(n)
    let d0 = digits[0]
    let d1 = digits[1]
    let d2 = digits[2]
    let d3 = digits[3]
    if d0 != d1
        return false
    if d1 != d2
        return false
    if d2 != d3
        return false
    true

// _kp_asc4 — build the ascending (smallest) number from sorted digits.
// digits[0] is the smallest digit (most significant in asc form).
// E.g. sorted [2,3,4,5] -> 2*1000+3*100+4*10+5 = 2345.
fn _kp_asc4(digits: list) -> int
    let a = digits[0]
    let b = digits[1]
    let c = digits[2]
    let d = digits[3]
    a * 1000 + b * 100 + c * 10 + d

// _kp_desc4 — build the descending (largest) number from sorted digits.
// E.g. sorted [2,3,4,5] -> 5*1000+4*100+3*10+2 = 5432.
fn _kp_desc4(digits: list) -> int
    let a = digits[0]
    let b = digits[1]
    let c = digits[2]
    let d = digits[3]
    d * 1000 + c * 100 + b * 10 + a

// kap_routine_6174 — number of iterations of Kaprekar's routine to reach 6174.
// Input must be a 4-digit number (1000..9999).
// Returns -1 if n is a repdigit (stuck forever at 0000 or similar).
// Returns 0 if n is already 6174.
// Maximum iterations before reaching 6174 is 7 for any valid 4-digit non-repdigit.
fn kap_routine_6174(n: int) -> int
    if _kp_is_repdigit4(n)
        return -1
    let v = n
    let iters = 0
    while v != 6174
        let digits = _kp_digits4(v)
        let asc = _kp_asc4(digits)
        let desc = _kp_desc4(digits)
        v = desc - asc
        iters += 1
        // safety guard: max known is 7, bail at 20 to avoid infinite loop
        if iters > 20
            return -1
    iters
