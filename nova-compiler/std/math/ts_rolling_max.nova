// std/math/ts_rolling_max.nova — rolling maximum over a sliding window.
// ts_rolling_max(data, window) -> list
//   Returns a list of length (n - window + 1) where each element is the
//   maximum of the corresponding window of `window` consecutive values.
//   Edge cases: empty data or window < 1 -> []; window > n -> [].
// LEAF — imports NOTHING.

fn ts_rolling_max(data: list, window: int) -> list
    let n = len(data)
    let out = []
    if window < 1
        return out
    if window > n
        return out
    let i = 0
    while i <= n - window
        let mx = data[i] * 1.0
        let j = i + 1
        while j < i + window
            let v = data[j] * 1.0
            if v > mx
                mx = v
            j += 1
        push(out, mx)
        i += 1
    out
