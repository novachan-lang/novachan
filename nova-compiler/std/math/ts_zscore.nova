// std/math/ts_zscore.nova — z-score normalization for a float time series.
// ts_zscore(data) -> list: (x - mean) / population_stddev for each element.
// Empty list or constant series (stddev == 0.0) -> list of 0.0s (same length).
// Uses population std (divide by n), not sample std (n-1).
// LEAF — imports NOTHING.

fn ts_zscore(data: list) -> list
    let n = len(data)
    let out = []
    if n == 0
        return out
    // compute mean
    let sum = 0.0
    let i = 0
    while i < n
        sum = sum + data[i] * 1.0
        i = i + 1
    let mean = sum * 1.0 / (n * 1.0)
    // compute population variance
    let var = 0.0
    let j = 0
    while j < n
        let d = data[j] * 1.0 - mean
        var = var + d * d
        j = j + 1
    var = var / (n * 1.0)
    let std = sqrt(var)
    // guard: constant series
    if std < 0.0000001
        let k = 0
        while k < n
            push(out, 0.0)
            k = k + 1
        return out
    // normalize
    let m = 0
    while m < n
        let z = (data[m] * 1.0 - mean) / std
        push(out, z)
        m = m + 1
    out
