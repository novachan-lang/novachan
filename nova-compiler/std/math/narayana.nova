// std/math/narayana.nova — Narayana numbers N(n,k) = C(n,k)*C(n,k-1)/n.
// LEAF — imports NOTHING.
//
// Public API:
//   nr_narayana(n, k) -> int   N(n,k) for 1<=k<=n; 0 outside that range
//   nr_row(n)         -> list  [N(n,1), N(n,2), ..., N(n,n)]
//   nr_row_sum(n)     -> int   sum of nr_row(n), equals the nth Catalan number
//
// Formula: N(n,k) = C(n,k) * C(n,k-1) / n
// where C(n,r) = n! / (r! * (n-r)!) is the binomial coefficient.
// The division by n is always exact for valid (n,k).
//
// All private helpers use the nr_ prefix to avoid cross-module symbol collisions.

// nr_binom — binomial coefficient C(n, r) computed iteratively with exact integer arithmetic.
// Uses the multiplicative formula: C(n,r) = product_{i=1}^{r} (n-r+i) / i
// At each step (n-r+i)/i is exact (Kummer's theorem / divisibility of rising factorials).
// Returns 0 for r<0 or r>n; 1 for r==0 or r==n.
fn nr_binom(n, r)
    if r < 0
        return 0
    if r > n
        return 0
    if r == 0
        return 1
    if r == n
        return 1
    // Use symmetry: C(n,r) == C(n, n-r); pick the smaller r to minimise iterations.
    let rr = r
    if n - r < rr
        rr = n - r
    let result = 1
    let i = 1
    while i <= rr
        result = result * (n - rr + i) / i
        i = i + 1
    result

// nr_narayana — Narayana number N(n,k) = C(n,k) * C(n,k-1) / n.
// Valid range: 1 <= k <= n.  Returns 0 for n<=0 or k<1 or k>n.
// Known values: N(1,1)=1; N(4,1)=1, N(4,2)=6, N(4,3)=6, N(4,4)=1;
//               N(5,2)=10.
fn nr_narayana(n, k)
    if n <= 0
        return 0
    if k < 1
        return 0
    if k > n
        return 0
    let a = nr_binom(n, k)
    let b = nr_binom(n, k - 1)
    a * b / n

// nr_row — list [N(n,1), N(n,2), ..., N(n,n)].
// nr_row(1) = [1]; nr_row(4) = [1,6,6,1].
fn nr_row(n)
    let out = []
    if n <= 0
        return out
    let k = 1
    while k <= n
        out.push(nr_narayana(n, k))
        k = k + 1
    out

// nr_row_sum — sum of all entries in nr_row(n).
// This equals the nth Catalan number: nr_row_sum(4)=14, nr_row_sum(5)=42.
fn nr_row_sum(n)
    let total = 0
    if n <= 0
        return total
    let k = 1
    while k <= n
        total = total + nr_narayana(n, k)
        k = k + 1
    total
