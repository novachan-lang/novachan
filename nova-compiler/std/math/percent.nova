// std/math/percent.nova — percentage arithmetic (float).
// All functions coerce inputs to float so integer arguments work naturally.
// pc_of(part, whole) -> part/whole*100
// pc_apply(value, pct) -> value * pct/100  (e.g. "15% of 200 = 30")
// pc_change(old, new_v) -> percent change from old to new_v
// pc_add(value, pct) -> value increased by pct percent
// pc_discount(value, pct) -> value decreased by pct percent
// pc_ratio_to_pct(num, den) -> num/den expressed as percentage

fn pc_of(part, whole) -> float
    let p = part * 1.0
    let w = whole * 1.0
    let r = p / w * 100.0
    r

fn pc_apply(value, pct) -> float
    let v = value * 1.0
    let p = pct * 1.0
    let r = v * p / 100.0
    r

fn pc_change(old, new_v) -> float
    let o = old * 1.0
    let n = new_v * 1.0
    let r = (n - o) / o * 100.0
    r

fn pc_add(value, pct) -> float
    let v = value * 1.0
    let p = pct * 1.0
    let r = v + v * p / 100.0
    r

fn pc_discount(value, pct) -> float
    let v = value * 1.0
    let p = pct * 1.0
    let r = v - v * p / 100.0
    r

fn pc_ratio_to_pct(num, den) -> float
    let n = num * 1.0
    let d = den * 1.0
    let r = n / d * 100.0
    r
