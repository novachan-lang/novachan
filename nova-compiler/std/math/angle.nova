// std/math/angle.nova — Angle math utilities (degrees and radians).
//
// FLOAT HAZARDS obeyed throughout:
//   • Module-level float constants SILENTLY truncate to int — all consts inside fn bodies.
//   • bare multi-term float return -> bind to EVERY intermediate to a named `let`.
//   • ABS OF FLOAT: use if x<0.0 then (0.0-x) else x  (NOT abs()).
//   • Single-exit pattern on every fn to avoid float-slot Heisenbug.
//   • floor() returns int-typed value; *1.0 coerces to float for further float math.
//
// API:
//   ang_deg2rad(d)        -> float  degrees to radians
//   ang_rad2deg(r)        -> float  radians to degrees
//   ang_normalize_deg(d)  -> float  map any degree angle to [0, 360)
//   ang_normalize_rad(r)  -> float  map any radian angle to [0, 2*pi)
//   ang_diff_deg(a, b)    -> float  signed shortest angular distance a->b in [-180, 180)

// degrees -> radians
fn ang_deg2rad(d: float) -> float
    let PI = pi()
    let t = d * PI
    let r = t / 180.0
    r

// radians -> degrees
fn ang_rad2deg(r: float) -> float
    let PI = pi()
    let t = r * 180.0
    let d = t / PI
    d

// positive floor-mod for floats: result in [0, m)
// Uses float_to_int (truncation toward zero) then negative-remainder correction.
// Single-exit pattern; every float sub-expression bound to a let.
fn _fmod_pos(x: float, m: float) -> float
    let q = x / m
    let n = float_to_int(q)
    let nf = n * 1.0
    let sub = nf * m
    let rem = x - sub
    let result = rem + m if rem < 0.0 else rem
    result

// Normalize degree angle to [0, 360)
fn ang_normalize_deg(d: float) -> float
    let m = 360.0
    let r = _fmod_pos(d, m)
    r

// Normalize radian angle to [0, 2*pi)
fn ang_normalize_rad(r: float) -> float
    let PI = pi()
    let TWO_PI = PI * 2.0
    let result = _fmod_pos(r, TWO_PI)
    result

// Signed shortest angular distance from a to b in degrees, result in [-180, 180).
// Formula: ((b - a + 180) mod 360) - 180  using positive floor-mod.
fn ang_diff_deg(a: float, b: float) -> float
    let ba = b - a
    let raw = ba + 180.0
    let m = _fmod_pos(raw, 360.0)
    let result = m - 180.0
    result
