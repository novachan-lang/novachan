// std/math/ts_rolling_std.nova — rolling (sliding-window) population std deviation.
// ts_rolling_std(data, window) -> list
//   Returns the population standard deviation (sqrt of population variance) of
//   each full sliding window of length `window`.
//   Output length = len(data) - window + 1.
//   Std of a constant window = 0.0.
//   Window > len(data): returns empty list.
// LEAF — imports NOTHING.

// Compute population variance of data[start .. start+window-1].
fn _tsrs_window_var(data: list, start: int, window: int) -> float
    let wf = window * 1.0
    let s = 0.0
    for k in 0..window
        s = s + data[start + k] * 1.0
    let mu = s / wf
    let acc = 0.0
    for j in 0..window
        let d = data[start + j] * 1.0 - mu
        acc = acc + d * d
    let v = acc / wf
    v

fn ts_rolling_std(data: list, window: int) -> list
    let n = len(data)
    let out = []
    if window <= 0
        return out
    if window > n
        return out
    let count = n - window + 1
    for i in 0..count
        let v = _tsrs_window_var(data, i, window)
        let sd = sqrt(v)
        push(out, sd)
    out
