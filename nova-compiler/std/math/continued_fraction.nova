// std/math/continued_fraction.nova — Continued fractions of FLOATING-POINT
// (possibly irrational) numbers: expansion, evaluation, convergents, the
// periodic expansion of sqrt(n), and best rational approximation.
//
// DUPLICATE-SURVEY NOTE: std/math/continued.nova (cf_) already computes
// continued fractions of EXACT rationals via the Euclidean algorithm
// (cf_from_rational/cf_to_rational/cf_convergents). std/rational/
// additionally has rfrac_continued.nova (rfk_: same exact-rational CF
// machinery) and rfrac_approx.nova (rfx_: best rational approximation of an
// EXACT rational via CF convergents/semiconvergents + Stern-Brocot search).
// All of that operates on exact [num, den] pairs. This module is
// deliberately different: it starts from a FLOAT (which may be irrational,
// e.g. sqrt(2) or pi — there is no exact numerator/denominator to feed a
// Euclidean algorithm), and it adds the periodic continued-fraction
// expansion of sqrt(n) for integer n, which is not implemented anywhere in
// std/ (surveyed std/math/pell.nova, which solves Pell's equation x^2-D*y^2=1
// by brute search over y, WITHOUT going through the sqrt(n) periodic-CF
// route that number theory normally uses).
//
// Public API (prefix cfr_):
//   cfr_from_float(x, max_terms)  -> list    CF coefficients approximating
//                                              float x, up to max_terms long
//                                              (stops early once the
//                                              remaining fractional part is
//                                              ~0, i.e. x was exactly
//                                              representable by the CF so far)
//   cfr_evaluate(coeffs)          -> float   evaluate CF coefficients back
//                                              to a float (Horner-style, from
//                                              the innermost term outward)
//   cfr_convergent(coeffs, k)     -> list    [num, den] of the k-th
//                                              convergent (0-indexed) of coeffs
//   cfr_convergents(coeffs)       -> list    [num, den] for every prefix of
//                                              coeffs (index 0..len-1)
//   cfr_sqrt_periodic(n)          -> list    [a0, [a1..a_period]] periodic CF
//                                              expansion of sqrt(n); period
//                                              list is [] iff n is a perfect
//                                              square (CF terminates at a0)
//   cfr_best_approx(x, max_den)   -> list    [num, den], the best rational
//                                              approximation of float x with
//                                              denominator <= max_den, found
//                                              by walking cfr_from_float's
//                                              convergents
//
// FLOAT HAZARDS (NOVA): always bind sub-expressions to named lets before
// returning float values. Float-vs-int compare is unsound — coerce with
// *1.0 when mixing. '/' on two ints is integer division.
//
// LEAF — imports NOTHING.

// _cfr_isqrt: floor(sqrt(v)) via Newton's method, exact for all int v >= 0.
fn _cfr_isqrt(v)
    if v <= 0
        return 0
    let x = v
    let y = (v + 1) / 2
    while y < x
        x = y
        y = (y + v / y) / 2
    return x

// cfr_from_float: continued-fraction coefficients of x, up to max_terms
// long. Stops early if the running fractional remainder is within
// 0.0000001 of an integer (x was exactly represented by the CF so far, or
// float error has bottomed out — continuing would only add noise terms).
fn cfr_from_float(x, max_terms)
    let coeffs = []
    let cur = x
    let a0f = floor(cur)
    let a0 = int(a0f)
    push(coeffs, a0)
    let a0d = a0 * 1.0
    let frac = cur - a0d
    for n in 1..max_terms
        let af = abs(frac)
        if af < 0.0000001
            return coeffs
        cur = 1.0 / frac
        let af1 = floor(cur)
        let a = int(af1)
        push(coeffs, a)
        let af2 = a * 1.0
        frac = cur - af2
    return coeffs

// cfr_evaluate: reconstruct the float value of a CF coefficient list,
// working from the innermost (last) term outward:
//   value = coeffs[k-1]
//   value = coeffs[i] + 1.0/value   for i = k-2 down to 0
fn cfr_evaluate(coeffs)
    let n = len(coeffs)
    if n == 0
        return 0.0
    let last = coeffs[n - 1]
    let value = last * 1.0
    let i = n - 2
    while i >= 0
        let ai = coeffs[i] * 1.0
        value = ai + 1.0 / value
        i -= 1
    return value

// cfr_convergent: the k-th convergent (0-indexed) of coeffs as [num, den],
// via the standard linear recurrence:
//   h[-1]=1, h[-2]=0 ; k_[-1]=0, k_[-2]=1
//   h[i] = a[i]*h[i-1] + h[i-2] ; k[i] = a[i]*k[i-1] + k[i-2]
fn cfr_convergent(coeffs, k)
    let h_prev2 = 0
    let h_prev1 = 1
    let k_prev2 = 1
    let k_prev1 = 0
    let i = 0
    let h = 1
    let d = 0
    while i <= k
        let a = coeffs[i]
        h = a * h_prev1 + h_prev2
        d = a * k_prev1 + k_prev2
        h_prev2 = h_prev1
        h_prev1 = h
        k_prev2 = k_prev1
        k_prev1 = d
        i += 1
    let out = []
    push(out, h)
    push(out, d)
    return out

// cfr_convergents: [num, den] for every prefix of coeffs, computed in one
// pass of the same recurrence used by cfr_convergent.
fn cfr_convergents(coeffs)
    let n = len(coeffs)
    let out = []
    let h_prev2 = 0
    let h_prev1 = 1
    let k_prev2 = 1
    let k_prev1 = 0
    for i in 0..n
        let a = coeffs[i]
        let h = a * h_prev1 + h_prev2
        let d = a * k_prev1 + k_prev2
        let pair = []
        push(pair, h)
        push(pair, d)
        push(out, pair)
        h_prev2 = h_prev1
        h_prev1 = h
        k_prev2 = k_prev1
        k_prev1 = d
    return out

// cfr_sqrt_periodic: periodic continued-fraction expansion of sqrt(n) for
// non-negative integer n. Returns [a0, period] where period is the
// repeating block [a1, a2, ..., a_p]. If n is a perfect square, sqrt(n) is
// an integer and the CF terminates: period is [].
// Algorithm: classic m/d/a recurrence (m0=0, d0=1, a0=floor(sqrt(n))):
//   m[i+1] = d[i]*a[i] - m[i]
//   d[i+1] = (n - m[i+1]^2) / d[i]
//   a[i+1] = floor((a0 + m[i+1]) / d[i+1])
// terminates (end of one period) when a[i+1] == 2*a0.
fn cfr_sqrt_periodic(n)
    let a0 = _cfr_isqrt(n)
    let out = []
    if a0 * a0 == n
        push(out, a0)
        push(out, [])
        return out
    let m = 0
    let d = 1
    let a = a0
    let period = []
    let guard = 0
    while guard < 1000
        m = d * a - m
        d = (n - m * m) / d
        a = (a0 + m) / d
        push(period, a)
        if a == 2 * a0
            guard = 1000
        else
            guard += 1
    push(out, a0)
    push(out, period)
    return out

// cfr_best_approx: best rational approximation [num, den] of float x with
// denominator <= max_den. Walks the convergents of x's continued-fraction
// expansion (30 terms is generous — CF convergents converge doubly
// exponentially, 30 terms vastly exceeds float64 precision) and returns the
// last one whose denominator still fits within max_den.
fn cfr_best_approx(x, max_den)
    let coeffs = cfr_from_float(x, 30)
    let convs = cfr_convergents(coeffs)
    let n = len(convs)
    let best = []
    push(best, coeffs[0])
    push(best, 1)
    for i in 0..n
        let num = convs[i][0]
        let den = convs[i][1]
        if den <= max_den and den >= 1
            best = convs[i]
    return best
