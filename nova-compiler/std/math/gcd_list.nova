// std/math/gcd_list.nova — GCD and LCM folded over a whole list.
// Native gcd/lcm are pairwise only; this module folds across arbitrary lists.
// LEAF — imports NOTHING.
//
// Public API:
//   gl_gcd2(a, b)      -> int   pairwise GCD via Euclidean algorithm (abs via if/else)
//   gl_lcm2(a, b)      -> int   pairwise LCM (overflow-safe: divide before multiply)
//   gl_gcd(xs)         -> int   GCD of all elements; empty list -> 0, single -> that element
//   gl_lcm(xs)         -> int   LCM of all elements; empty list -> 1
//   gl_coprime_all(xs) -> bool  true iff gl_gcd(xs) == 1

// gl_gcd2 — greatest common divisor of two integers via Euclidean algorithm.
// Handles negatives by taking absolute value with if/else (no builtin abs).
// gcd(0,0) = 0.
fn gl_gcd2(a: int, b: int) -> int
    let u = a
    if u < 0
        u = 0 - u
    let v = b
    if v < 0
        v = 0 - v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// gl_lcm2 — least common multiple of two integers.
// Divides first to avoid overflow: lcm = (|a| / gcd) * |b|.
// lcm(0, *) = 0.
fn gl_lcm2(a: int, b: int) -> int
    let g = gl_gcd2(a, b)
    if g == 0
        return 0
    let u = a
    if u < 0
        u = 0 - u
    let v = b
    if v < 0
        v = 0 - v
    (u / g) * v

// gl_gcd — GCD of all integers in list xs.
// gl_gcd([])  = 0   (identity for GCD fold: gcd(0, x) = x)
// gl_gcd([n]) = n
// gl_gcd([a, b, ...]) = gcd(a, gcd(b, ...))
fn gl_gcd(xs: list) -> int
    let n = len(xs)
    if n == 0
        return 0
    let acc = xs[0]
    if acc < 0
        acc = 0 - acc
    for i in 1..n
        acc = gl_gcd2(acc, xs[i])
    acc

// gl_lcm — LCM of all integers in list xs.
// gl_lcm([])  = 1   (identity for LCM fold: lcm(1, x) = x)
// gl_lcm([n]) = |n|
// gl_lcm([a, b, ...]) = lcm(a, lcm(b, ...))
fn gl_lcm(xs: list) -> int
    let n = len(xs)
    if n == 0
        return 1
    let acc = xs[0]
    if acc < 0
        acc = 0 - acc
    for i in 1..n
        acc = gl_lcm2(acc, xs[i])
    acc

// gl_coprime_all — true iff the GCD of all elements in xs equals 1.
// By definition, the empty list has GCD 0, so gl_coprime_all([]) = false.
fn gl_coprime_all(xs: list) -> bool
    gl_gcd(xs) == 1
