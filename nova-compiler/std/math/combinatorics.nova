// std/math/combinatorics.nova — integer combinatorics.
// All inputs must be non-negative integers.
// LEAF — imports NOTHING.
//
// Public API:
//   cb_factorial(n)        -> int   n! (n >= 0); cb_factorial(0)=1
//   cb_nCr(n, r)           -> int   binomial coefficient C(n,r); 0 if r>n
//   cb_nPr(n, r)           -> int   permutations P(n,r) = n!/(n-r)!; 0 if r>n
//   cb_catalan(n)           -> int   n-th Catalan number = C(2n,n)/(n+1)
//   cb_binomial_row(n)      -> list  Pascal's row n: list of n+1 ints
//
// OVERFLOW NOTE: cb_nCr uses the multiplicative formula with integer division
// at each step (always exact because k | C(n,k)*k) so it stays in 64-bit for
// n up to ~30 (C(30,15)~155M). For n>60 products will overflow signed 64-bit;
// results remain correct as long as the intermediate value fits i64.

// cb_factorial — n! via iterative product. cb_factorial(0) = 1.
fn cb_factorial(n: int) -> int
    let acc = 1
    let i = 2
    while i <= n
        acc = acc * i
        i = i + 1
    acc

// cb_nCr — C(n, r) using the multiplicative formula.
// C(n,r) = product_{k=1}^{r} (n-k+1)/k  (integer division is exact at each step).
// Exploits symmetry: use r = min(r, n-r) to halve the loop count.
fn cb_nCr(n: int, r: int) -> int
    if r < 0
        return 0
    if r > n
        return 0
    // symmetry: C(n,r) == C(n,n-r)
    let k = r
    if n - r < k
        k = n - r
    let result = 1
    for i in 0..k
        result = result * (n - i)
        result = result / (i + 1)
    result

// cb_nPr — P(n, r) = n! / (n-r)! = product of r terms n*(n-1)*...*(n-r+1).
fn cb_nPr(n: int, r: int) -> int
    if r < 0
        return 0
    if r > n
        return 0
    let result = 1
    for i in 0..r
        result = result * (n - i)
    result

// cb_catalan — n-th Catalan number = C(2n, n) / (n+1).
// Catalan(0)=1, Catalan(1)=1, Catalan(2)=2, Catalan(3)=5, Catalan(4)=14, ...
fn cb_catalan(n: int) -> int
    let c = cb_nCr(2 * n, n)
    c / (n + 1)

// cb_binomial_row — Pascal's triangle row n as a list of n+1 integers.
// Row 0 = [1], Row 1 = [1,1], Row 4 = [1,4,6,4,1].
// Built iteratively: start with [1], update in-place right-to-left each step.
fn cb_binomial_row(n: int) -> list
    let row = []
    let i = 0
    while i <= n
        row.push(0)
        i = i + 1
    // row[0] = 1 always
    row[0] = 1
    let j = 1
    while j <= n
        // update right-to-left so we only need one array
        let k = j
        while k >= 1
            row[k] = row[k] + row[k - 1]
            k = k - 1
        j = j + 1
    row
