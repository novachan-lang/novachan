// std/math/ts_diff.nova — first-difference and n-th order difference for time series.
// ts_diff(data) -> list
//   Returns list of consecutive differences: [data[1]-data[0], data[2]-data[1], ...].
//   Length = len(data) - 1. Empty or single-element list -> [].
// ts_diff_n(data, order) -> list
//   Returns the n-th order difference by applying ts_diff repeatedly `order` times.
//   order 0 -> copy of data; order >= len(data) -> [].
// LEAF — imports NOTHING.

fn ts_diff(data: list) -> list
    let n = len(data)
    let out = []
    if n < 2
        return out
    let i = 0
    while i < n - 1
        let d = data[i + 1] * 1.0 - data[i] * 1.0
        push(out, d)
        i = i + 1
    out

fn ts_diff_n(data: list, order: int) -> list
    // order 0: return a float copy of data
    if order <= 0
        let out = []
        let i = 0
        while i < len(data)
            push(out, data[i] * 1.0)
            i = i + 1
        return out
    // apply ts_diff `order` times
    let cur = []
    let i = 0
    while i < len(data)
        push(cur, data[i] * 1.0)
        i = i + 1
    let k = 0
    while k < order
        let nxt = []
        let m = len(cur)
        if m < 2
            return nxt
        let j = 0
        while j < m - 1
            let d = cur[j + 1] - cur[j]
            push(nxt, d)
            j = j + 1
        cur = nxt
        k = k + 1
    cur
