// std/math/quaternion.nova — unit quaternion math (floats).
// A quaternion is a 4-element list [w, x, y, z].
// All operations return NEW lists; inputs are never mutated.
// LEAF — imports NOTHING.
//
// FLOAT HAZARDS obeyed:
//   • sqrt() returns a boxed float — always bound to a named `let`.
//   • abs() on floats mis-types to int — use (if x<0.0 then 0.0-x else x).
//   • Float vs int compare UNSOUND — every element coerced via *1.0.
//   • Big multi-term float expressions are bound to `let`s before return.
//
// API:
//   q_new(w,x,y,z)           -> list  — construct quaternion
//   q_mul(a, b)               -> list  — Hamilton product
//   q_conjugate(q)            -> list  — [w, -x, -y, -z]
//   q_norm(q)                 -> list  — normalize to unit quaternion
//   q_from_axis_angle(ax,ay,az,angle) -> list — axis must not be zero-length
//   q_rotate_vec(q,vx,vy,vz) -> list  — v' = q*v*q^-1 (returns [x,y,z])

fn q_new(w: float, x: float, y: float, z: float) -> list
    let out = []
    push(out, w)
    push(out, x)
    push(out, y)
    push(out, z)
    out

// Hamilton product: (a.w + a.x*i + a.y*j + a.z*k) * (b.w + b.x*i + b.y*j + b.z*k)
fn q_mul(a: list, b: list) -> list
    let aw = a[0] * 1.0
    let ax = a[1] * 1.0
    let ay = a[2] * 1.0
    let az = a[3] * 1.0
    let bw = b[0] * 1.0
    let bx = b[1] * 1.0
    let by = b[2] * 1.0
    let bz = b[3] * 1.0
    let rw = aw * bw - ax * bx - ay * by - az * bz
    let rx = aw * bx + ax * bw + ay * bz - az * by
    let ry = aw * by - ax * bz + ay * bw + az * bx
    let rz = aw * bz + ax * by - ay * bx + az * bw
    let out = []
    push(out, rw)
    push(out, rx)
    push(out, ry)
    push(out, rz)
    out

fn q_conjugate(q: list) -> list
    let qw = q[0] * 1.0
    let qx = q[1] * 1.0
    let qy = q[2] * 1.0
    let qz = q[3] * 1.0
    let nx = 0.0 - qx
    let ny = 0.0 - qy
    let nz = 0.0 - qz
    let out = []
    push(out, qw)
    push(out, nx)
    push(out, ny)
    push(out, nz)
    out

fn q_norm(q: list) -> list
    let qw = q[0] * 1.0
    let qx = q[1] * 1.0
    let qy = q[2] * 1.0
    let qz = q[3] * 1.0
    let mag2 = qw * qw + qx * qx + qy * qy + qz * qz
    let mag = sqrt(mag2)
    // guard against zero-length input
    let safe = mag
    if safe < 0.0000001
        safe = 1.0
    let inv = 1.0 / safe
    let nw = qw * inv
    let nx = qx * inv
    let ny = qy * inv
    let nz = qz * inv
    let out = []
    push(out, nw)
    push(out, nx)
    push(out, ny)
    push(out, nz)
    out

fn q_from_axis_angle(ax: float, ay: float, az: float, angle: float) -> list
    // normalize axis
    let mag2 = ax * ax + ay * ay + az * az
    let mag = sqrt(mag2)
    let safe = mag
    if safe < 0.0000001
        safe = 1.0
    let inv = 1.0 / safe
    let nx = ax * inv
    let ny = ay * inv
    let nz = az * inv
    let half = angle * 0.5
    let qw = cos(half)
    let s = sin(half)
    let qx = nx * s
    let qy = ny * s
    let qz = nz * s
    let out = []
    push(out, qw)
    push(out, qx)
    push(out, qy)
    push(out, qz)
    out

// v' = q * (0,vx,vy,vz) * q^-1
// For unit q, q^-1 = q_conjugate(q).
// The xyz of the result is the rotated vector.
// We use the expanded formula to avoid the pure-quaternion intermediate:
//   t = 2 * cross(qxyz, v)
//   v' = v + qw*t + cross(qxyz, t)
fn q_rotate_vec(q: list, vx: float, vy: float, vz: float) -> list
    let qw = q[0] * 1.0
    let qx = q[1] * 1.0
    let qy = q[2] * 1.0
    let qz = q[3] * 1.0
    // t = 2 * (qxyz cross v)
    let tx = 2.0 * (qy * vz - qz * vy)
    let ty = 2.0 * (qz * vx - qx * vz)
    let tz = 2.0 * (qx * vy - qy * vx)
    // v' = v + qw*t + (qxyz cross t)
    let rx = vx + qw * tx + (qy * tz - qz * ty)
    let ry = vy + qw * ty + (qz * tx - qx * tz)
    let rz = vz + qw * tz + (qx * ty - qy * tx)
    let out = []
    push(out, rx)
    push(out, ry)
    push(out, rz)
    out
