// std/math/vector.nova — small N-dimensional float vector operations.
// A vector is represented as a list of numbers (int or float).
// All operations coerce elements to float via *1.0 and return NEW lists.
// Inputs are never mutated. LEAF — imports NOTHING.
//
// FLOAT HAZARDS (see NOVA memory):
//   • sqrt() returns a boxed float — always bind to a named `let` before use.
//   • Float-return Heisenbug: bind sub-expressions to `let`s; never return bare
//     multi-term float expressions from the final statement.
//   • Float vs int compare UNSOUND — coerce with *1.0.
//
// API:
//   vec_add(a, b) -> list           elementwise a[i]+b[i]
//   vec_sub(a, b) -> list           elementwise a[i]-b[i]
//   vec_scale(a, k: float) -> list  a[i]*k
//   vec_dot(a, b) -> float          sum a[i]*b[i]
//   vec_length(a) -> float          sqrt(dot(a,a))
//   vec_normalize(a) -> list        a scaled by 1/length; if length==0 returns copy
//   vec_cross(a, b) -> list         3-D cross product (a,b must have length 3)

fn vec_add(a: list, b: list) -> list
    let out = []
    let i = 0
    while i < len(a)
        let v = a[i] * 1.0 + b[i] * 1.0
        push(out, v)
        i = i + 1
    out

fn vec_sub(a: list, b: list) -> list
    let out = []
    let i = 0
    while i < len(a)
        let v = a[i] * 1.0 - b[i] * 1.0
        push(out, v)
        i = i + 1
    out

fn vec_scale(a: list, k: float) -> list
    let out = []
    let i = 0
    while i < len(a)
        let v = a[i] * 1.0 * k
        push(out, v)
        i = i + 1
    out

fn vec_dot(a: list, b: list) -> float
    let s = 0.0
    let i = 0
    while i < len(a)
        let ai = a[i] * 1.0
        let bi = b[i] * 1.0
        s = s + ai * bi
        i = i + 1
    s

fn vec_length(a: list) -> float
    let d = vec_dot(a, a)
    let r = sqrt(d)
    r

fn vec_normalize(a: list) -> list
    let ln = vec_length(a)
    if ln < 0.0000001
        let out = []
        let i = 0
        while i < len(a)
            let v = a[i] * 1.0
            push(out, v)
            i = i + 1
        return out
    let inv = 1.0 / ln
    vec_scale(a, inv)

fn vec_cross(a: list, b: list) -> list
    let a0 = a[0] * 1.0
    let a1 = a[1] * 1.0
    let a2 = a[2] * 1.0
    let b0 = b[0] * 1.0
    let b1 = b[1] * 1.0
    let b2 = b[2] * 1.0
    let cx = a1 * b2 - a2 * b1
    let cy = a2 * b0 - a0 * b2
    let cz = a0 * b1 - a1 * b0
    let out = []
    push(out, cx)
    push(out, cy)
    push(out, cz)
    out
