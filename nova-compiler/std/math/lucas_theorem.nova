// std/math/lucas_theorem.nova — Lucas's theorem: binomial coefficients mod a
// prime, computed digit-by-digit in base p instead of via huge factorials.
// Not to be confused with the Lucas *number* sequence (see std/math/lucas.nova) —
// this module is the combinatorial theorem about C(m,n) mod p.
// LEAF — imports nothing.
//
// Public API (prefix luct_):
//   luct_digits(n, p)            -> list  base-p digits of n, least-significant first
//   luct_small_binom(n, k)       -> int   exact C(n,k) via Pascal's triangle (small n,k)
//   luct_binom_mod(m, n, p)      -> int   C(m,n) mod p via Lucas's theorem (p prime)
//   luct_binom_direct_mod(m, n, p) -> int C(m,n) mod p via direct Pascal's triangle
//                                          (reference implementation; only for small m)
//   luct_verify(m, n, p)         -> bool  true iff luct_binom_mod and the direct
//                                          Pascal computation agree
//
// LUCAS'S THEOREM: for prime p and nonnegative integers m, n with base-p
// digit expansions m = m_k...m_1 m_0, n = n_k...n_1 n_0:
//   C(m,n) mod p = product_i C(m_i, n_i) mod p   (0 if any n_i > m_i)
// Since each digit is < p, every per-digit binomial coefficient is small and
// can be computed exactly with Pascal's triangle — no need for factorials of m.
//
// KNOWN ANSWERS (hand-verified):
//   luct_digits(11, 2)        = [1,1,0,1]      (11 = 1011b, LSB first)
//   luct_digits(100, 10)      = [0,0,1]
//   luct_small_binom(5,2)     = 10
//   luct_small_binom(6,3)     = 20
//   luct_small_binom(3,5)     = 0     (k > n)
//   luct_binom_mod(10,3,3)    = 0     (C(10,3)=120, 120 mod 3 = 0)
//   luct_binom_mod(5,2,3)     = 1     (C(5,2)=10, 10 mod 3 = 1)
//   luct_binom_mod(7,4,5)     = 0     (C(7,4)=35, 35 mod 5 = 0)
//   luct_binom_mod(13,5,7)    = 6     (C(13,5)=1287, 1287 mod 7 = 6)

// luct_digits — base-p digits of n, least-significant digit first.
// n must be >= 0. If n == 0, returns [0].
fn luct_digits(n, p)
    let out = []
    let m = n
    if m == 0
        push(out, 0)
        return out
    while m > 0
        push(out, m % p)
        m = m / p
    return out

// luct_small_binom — exact binomial coefficient C(n,k) via Pascal's triangle.
// Intended for small n (each row built from the previous; O(n^2)).
fn luct_small_binom(n, k)
    if k < 0
        return 0
    if k > n
        return 0
    // Build row n of Pascal's triangle iteratively, row by row.
    let row = [1]
    for r in 0..n
        let next = [1]
        let i = 1
        while i <= r
            let v = row[i - 1] + row[i]
            push(next, v)
            i = i + 1
        push(next, 1)
        row = next
    return row[k]

// luct_binom_mod — C(m,n) mod p via Lucas's theorem (p prime).
fn luct_binom_mod(m, n, p)
    let dm = luct_digits(m, p)
    let dn = luct_digits(n, p)
    let len_m = len(dm)
    let len_n = len(dn)
    let result = 1
    for i in 0..len_m
        let mi = dm[i]
        let ni = 0
        if i < len_n
            ni = dn[i]
        let c = luct_small_binom(mi, ni)
        if c == 0
            return 0
        result = (result * c) % p
    // If n has more (nonzero) digits than m, C(m,n) is 0.
    if len_n > len_m
        let j = len_m
        while j < len_n
            if dn[j] != 0
                return 0
            j = j + 1
    return result

// luct_binom_direct_mod — reference C(m,n) mod p via direct Pascal's triangle
// mod p. Only intended for small m (this builds the full row).
fn luct_binom_direct_mod(m, n, p)
    if n < 0
        return 0
    if n > m
        return 0
    let row = [1 % p]
    for r in 0..m
        let next = [1 % p]
        let i = 1
        while i <= r
            let v = (row[i - 1] + row[i]) % p
            push(next, v)
            i = i + 1
        push(next, 1 % p)
        row = next
    return row[n]

// luct_verify — true iff Lucas's theorem and the direct Pascal computation
// agree on C(m,n) mod p.
fn luct_verify(m, n, p)
    let a = luct_binom_mod(m, n, p)
    let b = luct_binom_direct_mod(m, n, p)
    return a == b
