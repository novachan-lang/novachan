// std/math/stats.nova — descriptive statistics over a list of numbers.
// Input: int or float list. Output: float (wherever fractional result is possible).
// Empty list: sum=0.0, all other functions return 0.0 (never crash / divide-by-zero).
// Median and percentile sort a COPY — the input list is never mutated.
// Uses the `sqrt` builtin for stddev. LEAF — imports NOTHING.
//
// CODEGEN NOTE: `floor(x)` returns a boxed float in the NOVA runtime (bitcast i64),
// not a hardware integer, so it cannot be used as a list index directly. The private
// helper _stats_float_to_idx converts a non-negative float to an integer index by
// counting loop — the same pattern used in nova-compiler/test_programs/stats.nova.

// Private: convert a non-negative float to an integer list index (floor toward 0).
fn _stats_float_to_idx(fval: float) -> int
    let k = 0
    let acc = 0.0
    while acc + 1.0 <= fval
        acc += 1.0
        k += 1
    k

fn stats_sum(xs: list) -> float
    let s = 0.0
    for i in 0..len(xs)
        s += xs[i] * 1.0
    s

fn stats_mean(xs: list) -> float
    if len(xs) == 0
        return 0.0
    stats_sum(xs) / (len(xs) * 1.0)

fn stats_min(xs: list) -> float
    if len(xs) == 0
        return 0.0
    let m = xs[0] * 1.0
    for i in 1..len(xs)
        let v = xs[i] * 1.0
        if v < m
            m = v
    m

fn stats_max(xs: list) -> float
    if len(xs) == 0
        return 0.0
    let m = xs[0] * 1.0
    for i in 1..len(xs)
        let v = xs[i] * 1.0
        if v > m
            m = v
    m

// Private helper: return a new float list sorted ascending (insertion sort; O(n²)).
// The caller's list is never modified.
fn _stats_sorted(xs: list) -> list
    let out = []
    for i in 0..len(xs)
        let v = xs[i] * 1.0
        push(out, v)
        let j = len(out) - 1
        while j > 0 and out[j - 1] > v
            out[j] = out[j - 1]
            j -= 1
        out[j] = v
    out

fn stats_median(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = _stats_sorted(xs)
    if n % 2 == 1
        return s[n / 2] * 1.0
    (s[n / 2 - 1] * 1.0 + s[n / 2] * 1.0) / 2.0

// Population variance: mean of squared deviations ( divided by n, not n-1 ).
fn stats_variance(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let mu = stats_mean(xs)
    let acc = 0.0
    for i in 0..len(xs)
        let d = xs[i] * 1.0 - mu
        acc += d * d
    acc / (n * 1.0)

fn stats_stddev(xs: list) -> float
    let v = stats_variance(xs)
    let sd = sqrt(v)
    sd

// p-th percentile (p in 0..100) with linear interpolation between adjacent ranks.
// rank = (p/100) * (n-1) in 0-indexed sorted array; fractional part is interpolated.
// p=0  -> minimum (index 0), p=100 -> maximum (index n-1).
// rank is kept as a float; _stats_float_to_idx converts it to an integer index.
fn stats_percentile(xs: list, p: int) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = _stats_sorted(xs)
    if n == 1
        return s[0] * 1.0
    let rank = p * 1.0 / 100.0 * ((n - 1) * 1.0)
    let lo_i = _stats_float_to_idx(rank)
    let hi_i = lo_i + 1
    if hi_i >= n
        return s[n - 1] * 1.0
    let lo_f = lo_i * 1.0
    let frac = rank - lo_f
    s[lo_i] * 1.0 + frac * (s[hi_i] * 1.0 - s[lo_i] * 1.0)
