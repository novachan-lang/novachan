// std/math/ts_rolling_min.nova — rolling minimum over a sliding window.
// ts_rolling_min(data, window) -> list
//   Returns a list of length (n - window + 1) where each element is the
//   minimum of the corresponding window of `window` consecutive values.
//   Edge cases: empty data or window < 1 -> []; window > n -> [].
// LEAF — imports NOTHING.

fn ts_rolling_min(data: list, window: int) -> list
    let n = len(data)
    let out = []
    if window < 1
        return out
    if window > n
        return out
    let i = 0
    while i <= n - window
        let mn = data[i] * 1.0
        for j in i + 1..i + window
            let v = data[j] * 1.0
            if v < mn
                mn = v
        push(out, mn)
        i += 1
    out
