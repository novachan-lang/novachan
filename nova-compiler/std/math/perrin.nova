// std/math/perrin.nova — Perrin sequence utilities (iterative, 64-bit ints).
// LEAF — imports NOTHING.
//
// Public API:
//   pe_perrin(n)    -> int   nth Perrin number, 0-indexed: P(0)=3, P(1)=0, P(2)=2
//   pe_list(n)      -> list  first n Perrin numbers [P(0)..P(n-1)]
//   pe_is_perrin(v) -> bool  true iff v appears in the Perrin sequence
//
// Perrin recurrence: P(n) = P(n-2) + P(n-3), with P(0)=3, P(1)=0, P(2)=2.
// Sequence: 3, 0, 2, 3, 2, 5, 5, 7, 10, 12, 17, 22, 29, 39, 51, ...
//
// All private helpers use the pe_ prefix to avoid cross-module symbol collisions.
// All functions are purely iterative (no recursion).

// pe_perrin — nth Perrin number (0-indexed, iterative).
// P(0)=3, P(1)=0, P(2)=2, P(n)=P(n-2)+P(n-3) for n>=3.
// Returns P(0)=3 for n < 0 (clamp to base case).
fn pe_perrin(n: int) -> int
    if n <= 0
        return 3
    if n == 1
        return 0
    if n == 2
        return 2
    // a = P(i-3), b = P(i-2), c = P(i-1); iterate until i == n
    let a = 3
    let b = 0
    let c = 2
    let i = 3
    while i <= n
        let next = a + b
        a = b
        b = c
        c = next
        i += 1
    c

// pe_list — list of first n Perrin numbers: [P(0), P(1), ..., P(n-1)].
// pe_list(0)=[], pe_list(1)=[3], pe_list(6)=[3,0,2,3,2,5].
fn pe_list(n: int) -> list
    let out = []
    if n <= 0
        return out
    push(out, 3)
    if n == 1
        return out
    push(out, 0)
    if n == 2
        return out
    push(out, 2)
    if n == 3
        return out
    let a = 3
    let b = 0
    let c = 2
    for i in 3..n
        let next = a + b
        a = b
        b = c
        c = next
        push(out, c)
    out

// pe_is_perrin — true iff v appears anywhere in the Perrin sequence.
// Iterates the sequence up to v (Perrin numbers grow ~1.32^n, so O(log v) steps).
// Special case: 0 appears at index 1; negative values never appear.
fn pe_is_perrin(v: int) -> bool
    if v < 0
        return false
    if v == 3
        return true
    if v == 0
        return true
    if v == 2
        return true
    // Sequence after the seed: strictly increasing for n >= 5, so iterate until >= v.
    let a = 3
    let b = 0
    let c = 2
    let found = false
    let done = false
    while done == false
        let next = a + b
        a = b
        b = c
        c = next
        if c == v
            found = true
            done = true
        if c > v
            done = true
    found
