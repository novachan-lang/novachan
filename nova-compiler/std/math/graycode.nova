// std/math/graycode.nova
// Reflected binary Gray code utilities.
// All operations are on non-negative 32-bit-range integers.
// '>>' is arithmetic in NOVA; mask with &0xFFFFFFFF where needed.
//
// Public API:
//   gray_encode(n)                  -> int   binary n -> Gray code
//   gray_decode(g)                  -> int   Gray code g -> binary n
//   gray_list(bits)                 -> list  2^bits Gray codes in sequence
//   gray_adjacent_differ_one(a,b)   -> bool  popcount(a^b)==1

// gray_encode(n) -> int
// Returns the Gray code corresponding to binary integer n.
// Formula: n XOR (n >> 1), masked to 32 bits.
fn gray_encode(n)
    let r = (n ^ ((n >> 1) & 0x7FFFFFFF)) & 0xFFFFFFFF
    r

// gray_decode(g) -> int
// Inverse of gray_encode: recovers the original binary integer from Gray code g.
// Uses the standard fold: XOR-cascade through 1/2/4/8/16 shifts covers all 32 bits.
fn gray_decode(g)
    let n = g & 0xFFFFFFFF
    let s = (n >> 1) & 0x7FFFFFFF
    n = n ^ s
    s = (n >> 2) & 0x3FFFFFFF
    n = n ^ s
    s = (n >> 4) & 0x0FFFFFFF
    n = n ^ s
    s = (n >> 8) & 0x00FFFFFF
    n = n ^ s
    s = (n >> 16) & 0x0000FFFF
    n = n ^ s
    n & 0xFFFFFFFF

// gray_list(bits) -> list
// Returns the 2^bits Gray codes in reflected-binary order (the standard sequence).
// bits must be in [1..30] for practical use.
fn gray_list(bits)
    let size = 1 << bits
    let result = []
    let i = 0
    while i < size
        result.push(gray_encode(i))
        i += 1
    result

// gray_adjacent_differ_one(a, b) -> bool
// Returns true iff popcount(a XOR b) == 1, i.e. a and b differ in exactly one bit.
// This is the defining property of consecutive Gray code entries.
fn gray_adjacent_differ_one(a, b)
    popcount((a ^ b) & 0xFFFFFFFF) == 1
