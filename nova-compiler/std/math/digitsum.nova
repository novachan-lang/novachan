// std/math/digitsum.nova — Decimal digit operations on non-negative integers.
// All functions require n >= 0.  Base-10 by default; ds_sum_base supports any
// integer base >= 2.
// LEAF — imports NOTHING.
//
// Public API:
//   ds_sum(n)            -> int   sum of decimal digits of n  (ds_sum(0)==0)
//   ds_sum_base(n, base) -> int   sum of digits of n in given base
//   ds_count(n)          -> int   number of decimal digits  (ds_count(0)==1)
//   ds_reverse(n)        -> int   decimal number formed by reversing digits
//   ds_persistence(n)    -> int   additive persistence: steps of ds_sum to 1 digit

// _ds_sum_inner — shared work-horse for base-b digit summing.
// Extracts digits via repeated division; returns their sum.
// Returns 0 when n == 0.
fn _ds_sum_inner(n: int, base: int) -> int
    let s = 0
    let m = n
    while m > 0
        s += (m % base)
        m /= base
    s

// ds_sum — sum of decimal digits of n.
// ds_sum(0) == 0 (digit 0 contributes 0).
// ds_sum(1234) == 1+2+3+4 == 10.
fn ds_sum(n: int) -> int
    _ds_sum_inner(n, 10)

// ds_sum_base — sum of digits of n expressed in the given base.
// ds_sum_base(255, 16) == 15+15 == 30.
fn ds_sum_base(n: int, base: int) -> int
    _ds_sum_inner(n, base)

// ds_count — number of decimal digits of n.
// ds_count(0) == 1 (zero has one digit by convention).
// ds_count(1234) == 4.
fn ds_count(n: int) -> int
    if n == 0
        return 1
    let m = n
    let c = 0
    while m > 0
        c += 1
        m /= 10
    c

// ds_reverse — reverse the decimal digits of n.
// ds_reverse(1234) == 4321.
// ds_reverse(0) == 0; ds_reverse(100) == 1 (leading zeros drop).
fn ds_reverse(n: int) -> int
    let m = n
    let r = 0
    while m > 0
        r = r * 10 + (m % 10)
        m /= 10
    r

// ds_persistence — additive persistence of n.
// Counts how many times ds_sum must be applied to n until the result is a
// single digit (< 10).  If n < 10 already, persistence is 0.
// ds_persistence(9875) == 3  (9875 -> 29 -> 11 -> 2).
// ds_persistence(5)    == 0.
fn ds_persistence(n: int) -> int
    let m = n
    let steps = 0
    while m >= 10
        m = _ds_sum_inner(m, 10)
        steps += 1
    steps
