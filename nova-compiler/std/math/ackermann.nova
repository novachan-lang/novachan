// std/math/ackermann.nova — Ackermann-Peter function.
// LEAF — imports NOTHING.
//
// Public API:
//   ack(m, n)               -> int   Ackermann-Peter function value
//   ack_is_defined_small(m) -> bool  true iff m <= 3 (safe to compute for small n)
//
// Definition:
//   ack(0, n) = n + 1
//   ack(m, 0) = ack(m-1, 1)          for m > 0
//   ack(m, n) = ack(m-1, ack(m,n-1)) for m > 0, n > 0
//
// Private helpers use the _ackm_ prefix to avoid cross-module symbol collisions.
// m=4 is astronomically large; only m<=3 is practically computable.

// ack — Ackermann-Peter function.
// ack(0,0)=1; ack(1,1)=3; ack(2,2)=7; ack(3,3)=61; ack(3,4)=125.
fn ack(m, n)
    if m == 0
        return n + 1
    if n == 0
        return ack(m - 1, 1)
    let inner = ack(m, n - 1)
    ack(m - 1, inner)

// ack_is_defined_small — true iff m <= 3 (practically computable).
// ack(4, n) grows beyond any plausible stack or runtime budget.
fn ack_is_defined_small(m)
    m <= 3
