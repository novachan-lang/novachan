// std/math/ts_pct_change.nova — fractional percentage change for time-series.
// ts_pct_change(data) -> list of length len(data)-1
//   result[i] = (data[i+1] - data[i]) / data[i]
// Edge cases:
//   - empty or single-element list -> []
//   - zero base (data[i] == 0.0) -> result element = 0.0 (guard)
// LEAF — imports NOTHING.

// Fractional pct-change between consecutive elements.
// Returns a list of length (len(data)-1).
fn ts_pct_change(data: list) -> list
    let n = len(data)
    let out = []
    if n < 2
        return out
    for i in 0..(n - 1)
        let cur = data[i] * 1.0
        let nxt = data[i + 1] * 1.0
        let pct = 0.0
        if cur < 0.0 or cur > 0.0
            pct = (nxt - cur) / cur
        push(out, pct)
    out
