// std/math/geometry2d.nova — 2-D geometry on float coordinates.
// Points are passed as individual (x, y) floats; polygon vertices are passed
// as a list of [x, y] two-element lists.
//
// FLOAT HAZARDS obeyed throughout:
//   • sqrt() returns a boxed float — always bind to a named `let` before return.
//   • Never return a bare multi-term float expression as the final statement.
//   • float vs int compare is UNSOUND — coerce with *1.0 before comparisons.
//
// API:
//   geo_dist(ax,ay,bx,by)  -> float   Euclidean distance
//   geo_dist2(ax,ay,bx,by) -> float   squared distance (avoids sqrt)
//   geo_dot(ax,ay,bx,by)   -> float   dot product of vectors (a,b)
//   geo_cross(ax,ay,bx,by) -> float   2-D cross product ax*by - ay*bx
//   geo_ccw(ax,ay,bx,by,cx,cy) -> int  orientation: 1=CCW 0=collinear -1=CW
//   geo_poly_area(pts)      -> float   signed shoelace area (absolute value)
//   geo_convex_hull(pts)    -> list    convex hull via Andrew's monotone chain

fn geo_dist2(ax: float, ay: float, bx: float, by: float) -> float
    let dx = bx - ax
    let dy = by - ay
    let r = dx * dx + dy * dy
    r

fn geo_dist(ax: float, ay: float, bx: float, by: float) -> float
    let d2 = geo_dist2(ax, ay, bx, by)
    let r = sqrt(d2)
    r

fn geo_dot(ax: float, ay: float, bx: float, by: float) -> float
    let r = ax * bx + ay * by
    r

fn geo_cross(ax: float, ay: float, bx: float, by: float) -> float
    let r = ax * by - ay * bx
    r

// orientation of ordered triple (A, B, C):
//   1  = counter-clockwise
//   0  = collinear
//  -1  = clockwise
// Uses the cross product of vectors (B-A) and (C-A).
fn geo_ccw(ax: float, ay: float, bx: float, by: float, cx: float, cy: float) -> int
    let dx1 = bx - ax
    let dy1 = by - ay
    let dx2 = cx - ax
    let dy2 = cy - ay
    let c = dx1 * dy2 - dy1 * dx2
    if c > 0.0
        return 1
    if c < 0.0
        return -1
    0

// Shoelace formula: area = abs(sum_i(x_i*(y_{i+1}-y_{i-1}))) / 2
// Equivalent: sum_i(x_i*y_{i+1} - x_{i+1}*y_i), then abs/2.
// pts is a list of [x, y] two-element lists (any numeric type).
fn geo_poly_area(pts: list) -> float
    let n = len(pts)
    if n < 3
        return 0.0
    let s = 0.0
    for i in 0..n
        let j = i + 1
        if j >= n
            j = 0
        let xi = pts[i][0] * 1.0
        let yi = pts[i][1] * 1.0
        let xj = pts[j][0] * 1.0
        let yj = pts[j][1] * 1.0
        let term_a = xi * yj
        let term_b = xj * yi
        let term = term_a - term_b
        s = s + term
    let a = 0.0
    if s < 0.0
        a = (0.0 - s) * 0.5
    else
        a = s * 0.5
    a

// ── internal helpers for convex hull ──────────────────────────────────────

// Compare two points [x,y] lexicographically (x first, then y).
// Returns -1 if p < q, 0 if equal, 1 if p > q.
fn _pt_cmp(p: list, q: list) -> int
    let px = p[0] * 1.0
    let qx = q[0] * 1.0
    if px < qx
        return -1
    if px > qx
        return 1
    let py = p[1] * 1.0
    let qy = q[1] * 1.0
    if py < qy
        return -1
    if py > qy
        return 1
    0

// In-place insertion sort of pts by (x, y).  Stable and correct for any size.
fn _sort_pts(pts: list) -> list
    let n = len(pts)
    for i in 1..n
        let key = pts[i]
        let j = i - 1
        while j >= 0 and _pt_cmp(pts[j], key) > 0
            pts[j + 1] = pts[j]
            j = j - 1
        pts[j + 1] = key
    pts

// Cross product of vectors (O->A) and (O->B).
// Positive = CCW, negative = CW, zero = collinear.
fn _hull_cross(ox: float, oy: float, ax: float, ay: float, bx: float, by: float) -> float
    let r = (ax - ox) * (by - oy) - (ay - oy) * (bx - ox)
    r

// Andrew's monotone chain O(n log n) — here O(n^2) due to insertion sort
// but the hull traversal itself is O(n).  Returns a new list of hull points
// in counter-clockwise order starting from the bottom-left point.
fn geo_convex_hull(pts: list) -> list
    let n = len(pts)
    if n < 3
        return pts
    // work on a copy so we don't mutate the caller's list
    let work = []
    for ci in 0..n
        let p = pts[ci]
        let cp = [p[0], p[1]]
        push(work, cp)
    _sort_pts(work)
    // lower hull
    let lower = []
    for li in 0..n
        let px = work[li][0] * 1.0
        let py = work[li][1] * 1.0
        while len(lower) >= 2
            let last = lower[len(lower) - 1]
            let prev = lower[len(lower) - 2]
            let ox = prev[0] * 1.0
            let oy = prev[1] * 1.0
            let ax = last[0] * 1.0
            let ay = last[1] * 1.0
            let c = _hull_cross(ox, oy, ax, ay, px, py)
            if c <= 0.0
                pop(lower)
            else
                break
        push(lower, work[li])
    // upper hull (right to left)
    let upper = []
    let ui = n - 1
    while ui >= 0
        let px = work[ui][0] * 1.0
        let py = work[ui][1] * 1.0
        while len(upper) >= 2
            let last = upper[len(upper) - 1]
            let prev = upper[len(upper) - 2]
            let ox = prev[0] * 1.0
            let oy = prev[1] * 1.0
            let ax = last[0] * 1.0
            let ay = last[1] * 1.0
            let c = _hull_cross(ox, oy, ax, ay, px, py)
            if c <= 0.0
                pop(upper)
            else
                break
        push(upper, work[ui])
        ui = ui - 1
    // concatenate: lower[0..len-1] + upper[0..len-1]
    // (the last point of each half equals the first point of the other half)
    let hull = []
    for hi in 0..(len(lower) - 1)
        push(hull, lower[hi])
    for hj in 0..(len(upper) - 1)
        push(hull, upper[hj])
    hull
