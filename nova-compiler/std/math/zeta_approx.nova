// std/math/zeta_approx.nova — numerical approximation of the Riemann zeta
// function zeta(s) = sum_{k=1..inf} 1/k^s for real s > 1, plus the faster-
// converging Dirichlet eta (alternating zeta) series and the classical
// identity relating the two: eta(s) = (1 - 2^(1-s)) * zeta(s).
// Distinct from std/math/harmonic.nova (partial sums of 1/k, s == 1, the
// divergent case) and from std/math/bernoulli.nova (Bernoulli numbers,
// which give zeta at negative integers via a wholly different formula).
// LEAF — imports NOTHING.
//
// Public API:
//   zta_direct_sum(s, n_terms) -> float
//     Partial sum of the defining series: sum_{k=1..n_terms} 1/k^s.
//     Converges for s > 1; the tail sum_{k=n+1..inf} 1/k^s is bounded above
//     by 1/((s-1) * n^(s-1)), so for s == 2 the truncation error is <= 1/n.
//   zta_eta_sum(s, n_terms) -> float
//     Partial sum of the Dirichlet eta (alternating zeta) series:
//     sum_{k=1..n_terms} (-1)^(k+1) / k^s. Converges for s > 0 (including
//     0 < s <= 1, where the direct zeta series diverges) and, being an
//     alternating series of decreasing terms, its error after n_terms is
//     bounded by the (n_terms+1)-th term itself — far faster than the
//     direct sum for the same term count.
//   zta_from_eta(s, n_terms) -> float
//     zeta(s) recovered from the eta series via eta(s) = (1-2^(1-s))*zeta(s),
//     i.e. zeta(s) = eta(s) / (1 - 2^(1-s)). Only valid for s != 1 (the
//     factor (1-2^(1-s)) vanishes at s == 1, where zeta itself has a pole).
//   zta_basel_error(n_terms) -> float
//     abs(zta_direct_sum(2.0, n_terms) - pi^2/6): demonstrates convergence
//     to the exact Basel-problem value zeta(2) = pi^2/6.
//
// KNOWN ANSWERS (hand-verified against the exact closed forms):
//   zeta(2) = pi^2/6  ~= 1.6449340668...
//   zeta(4) = pi^4/90 ~= 1.0823232337...
//   eta(2)  = pi^2/12 ~= 0.8224670334...  (exactly half of zeta(2))
//   zta_direct_sum(2.0, 100000) is within 1e-4 of pi^2/6 (tail bound 1/n).
//   zta_eta_sum(2.0, 1000) is within 1e-5 of pi^2/12 (alternating-series
//     error bound: next term 1/1001^2 ~= 1e-6).
//   zta_from_eta(2.0, 1000) is within 1e-5 of pi^2/6.
//   zta_basel_error(100000) < 1e-3.

// zta_direct_sum — direct partial sum of 1/k^s for k = 1..n_terms.
fn zta_direct_sum(s, n_terms)
    let total = 0.0
    let k = 1
    while k <= n_terms
        let kf = k * 1.0
        let denom = pow(kf, s)
        total += 1.0 / denom
        k += 1
    return total

// zta_eta_sum — alternating (Dirichlet eta) partial sum for k = 1..n_terms.
fn zta_eta_sum(s, n_terms)
    let total = 0.0
    let sign = 1.0
    let k = 1
    while k <= n_terms
        let kf = k * 1.0
        let denom = pow(kf, s)
        total += sign / denom
        sign = 0.0 - sign
        k += 1
    return total

// zta_from_eta — zeta(s) recovered from the eta series (faster convergence
// than zta_direct_sum for the same n_terms, valid for s != 1).
fn zta_from_eta(s, n_terms)
    let eta = zta_eta_sum(s, n_terms)
    let expo = 1.0 - s
    let two_pow = pow(2.0, expo)
    let factor = 1.0 - two_pow
    return eta / factor

// zta_basel_error — |zta_direct_sum(2.0, n_terms) - pi^2/6|.
fn zta_basel_error(n_terms)
    let approx = zta_direct_sum(2.0, n_terms)
    let PI = pi()
    let exact = (PI * PI) / 6.0
    let diff = approx - exact
    return abs(diff)
