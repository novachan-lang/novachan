// std/math/continued.nova — Continued fractions of a rational number.
// LEAF — imports NOTHING.
//
// A continued fraction [a0, a1, a2, ..., an] represents:
//   a0 + 1/(a1 + 1/(a2 + 1/(... + 1/an)))
//
// Public API:
//   cf_from_rational(num, den) -> list  CF coefficients [a0, a1, ...] via Euclidean algorithm
//   cf_to_rational(coeffs)     -> list  [num, den] reduced rational from CF coefficients
//   cf_convergents(coeffs)     -> list  list of [num, den] pairs (successive convergents)
//
// All denominators returned are positive. GCD reduction applied to cf_to_rational output.
// Private helpers use _cf_ prefix to avoid cross-module symbol collisions.

// _cf_gcd — greatest common divisor via Euclidean algorithm, always >= 0.
// gcd(0, 0) = 0 (no sentinel: callers guard against zero-den before calling).
fn _cf_gcd(a, b)
    let u = a
    let v = b
    if u < 0
        u = -u
    if v < 0
        v = -v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// _cf_reduce — return [num/g, den/g] with den > 0.
// Ensures the canonical reduced form: positive denominator, gcd(|num|,den)==1.
fn _cf_reduce(n, d)
    let num = n
    let den = d
    if den < 0
        num = -num
        den = -den
    if den == 0
        den = 1
    let g = _cf_gcd(num, den)
    if g == 0
        g = 1
    let rn = num / g
    let rd = den / g
    let out = []
    out.push(rn)
    out.push(rd)
    out

// cf_from_rational — compute continued fraction coefficients for num/den.
// Uses the standard Euclidean algorithm: at each step emit floor(num/den),
// then replace (num, den) with (den, num mod den) until den == 0.
// cf_from_rational(415, 93) -> [4, 2, 6, 7]
// cf_from_rational(3, 2)    -> [1, 2]
// cf_from_rational(7, 1)    -> [7]
// cf_from_rational(1, 1)    -> [1]
// cf_from_rational(0, 1)    -> [0]
// Handles negative inputs: sign tracked separately; coefficients always positive.
fn cf_from_rational(num, den)
    let out = []
    let n = num
    let d = den
    if d < 0
        n = -n
        d = -d
    if d == 0
        return out
    // Handle sign: if n/d negative, the first coefficient is negative,
    // all subsequent are positive (standard CF convention).
    let sign = 1
    if n < 0
        sign = -1
        n = -n
    // Now n >= 0, d > 0. Euclidean loop.
    let done = 0
    while done == 0
        let q = n / d
        let r = n % d
        if sign == -1
            out.push(0 - q)
            sign = 1
        else
            out.push(q)
        if r == 0
            done = 1
        if done == 0
            n = d
            d = r
    out

// cf_to_rational — reconstruct [num, den] from CF coefficients, reduced to lowest terms.
// Evaluates the CF from the tail back to the head:
//   Start with h = last_coeff / 1, then for each earlier coeff a:
//   new value = a + 1/(current) = (a * cur_den + cur_num) / cur_den
// cf_to_rational([4, 2, 6, 7]) -> [415, 93]
// cf_to_rational([1, 2])       -> [3, 2]
// cf_to_rational([7])          -> [7, 1]
fn cf_to_rational(coeffs)
    let n = len(coeffs)
    if n == 0
        let empty = []
        empty.push(0)
        empty.push(1)
        return empty
    // Start from the last coefficient.
    let h = coeffs[n - 1]
    let k = 1
    // Walk backwards through the remaining coefficients.
    let i = n - 2
    while i >= 0
        let a = coeffs[i]
        // new = a + k/h  =>  (a*h + k) / h
        let new_h = a * h + k
        let new_k = h
        h = new_h
        k = new_k
        i -= 1
    _cf_reduce(h, k)

// cf_convergents — compute the list of convergents for the given CF coefficients.
// The k-th convergent p_k/q_k is defined by the recurrence:
//   p_{-1} = 1,  p_0 = a_0
//   q_{-1} = 0,  q_0 = 1
//   p_k = a_k * p_{k-1} + p_{k-2}
//   q_k = a_k * q_{k-1} + q_{k-2}
// Each convergent is returned as a two-element list [p_k, q_k] (already reduced).
// The last convergent equals cf_to_rational(coeffs).
// cf_convergents([4,2,6,7]) -> [[4,1],[9,2],[58,13],[415,93]]
fn cf_convergents(coeffs)
    let out = []
    let n = len(coeffs)
    if n == 0
        return out
    // Seed: p_{-1}=1, q_{-1}=0; p_0=a_0, q_0=1
    let pm2 = 1
    let qm2 = 0
    let pm1 = coeffs[0]
    let qm1 = 1
    // Push the first convergent [a_0, 1].
    let c0 = []
    c0.push(pm1)
    c0.push(qm1)
    out.push(c0)
    for i in 1..n
        let a = coeffs[i]
        let p = a * pm1 + pm2
        let q = a * qm1 + qm2
        let ci = []
        ci.push(p)
        ci.push(q)
        out.push(ci)
        pm2 = pm1
        qm2 = qm1
        pm1 = p
        qm1 = q
    out
