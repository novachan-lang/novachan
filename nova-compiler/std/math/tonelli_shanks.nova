// std/math/tonelli_shanks.nova — Modular square roots via the Tonelli-Shanks
// algorithm: given a and an odd prime p, find r such that r*r === a (mod p).
// LEAF — imports nothing.
//
// Public API (prefix tsh_):
//   tsh_pow_mod(base, exp, mod)  -> int   modular exponentiation
//   tsh_legendre(a, p)           -> int   Legendre symbol (a/p): 1, -1, or 0
//   tsh_is_residue(a, p)         -> bool  true iff a is a quadratic residue mod p
//   tsh_sqrt(a, p)                -> int  a square root of a mod p, or -1 if
//                                          a is not a residue mod p
//   tsh_verify(r, a, p)           -> bool true iff r*r === a (mod p)
//
// ALGORITHM: if p === 3 (mod 4), a square root is simply a^((p+1)/4) mod p.
// Otherwise write p-1 = q * 2^s with q odd, find any quadratic non-residue z,
// and run the standard Tonelli-Shanks loop, repeatedly halving the order of
// the "error" term t until it collapses to 1.
//
// KNOWN ANSWERS (hand-verified):
//   tsh_legendre(2, 41)    = 1     (2 is a QR mod 41)
//   tsh_legendre(3, 41)    = -1    (3 is a non-residue mod 41)
//   tsh_legendre(0, 7)     = 0
//   tsh_is_residue(2, 7)   = true  (3*3 = 9 === 2 mod 7)
//   tsh_is_residue(3, 7)   = false
//   tsh_sqrt(2, 7)         = 4     (p mod 4 == 3 shortcut: 2^((7+1)/4)=2^2=4;
//                                   4*4 = 16 === 2 mod 7)
//   tsh_sqrt(3, 11)        = 5     (p mod 4 == 3 shortcut: 3^3 = 27 === 5 mod 11;
//                                   5*5 = 25 === 3 mod 11)
//   tsh_sqrt(3, 7)         = -1    (3 is not a residue mod 7)
//   tsh_sqrt(10, 41)       = 16    (p mod 4 == 1, full algorithm; hand-traced:
//                                   16*16 = 256 = 6*41 + 10 === 10 mod 41)
//   tsh_verify(4, 2, 7)    = true
//   tsh_verify(5, 3, 7)    = false (5*5 = 25 === 4 mod 7, not 3)

// tsh_pow_mod — (base^exp) mod m via binary exponentiation. exp >= 0, m >= 1.
fn tsh_pow_mod(base, exp, m)
    if m == 1
        return 0
    let result = 1
    let b = base % m
    if b < 0
        b += m
    let e = exp
    while e > 0
        if e % 2 == 1
            result = (result * b) % m
        b = (b * b) % m
        e = e / 2
    return result

// tsh_legendre — Legendre symbol (a/p) via Euler's criterion. p must be an
// odd prime (p == 2 is handled as a special case, returning a % 2).
fn tsh_legendre(a, p)
    if p == 2
        return a % 2
    let am = a % p
    if am < 0
        am += p
    if am == 0
        return 0
    let ls = tsh_pow_mod(am, (p - 1) / 2, p)
    if ls == p - 1
        return -1
    return ls

// tsh_is_residue — true iff a is a quadratic residue mod p (0 counts as a
// residue: 0*0 === 0).
fn tsh_is_residue(a, p)
    let am = a % p
    if am < 0
        am += p
    if am == 0
        return true
    return tsh_legendre(am, p) == 1

// tsh_sqrt — a square root of a mod odd prime p, or -1 if a is not a
// quadratic residue mod p.
fn tsh_sqrt(a, p)
    let amod = a % p
    if amod < 0
        amod += p
    if amod == 0
        return 0
    if not tsh_is_residue(amod, p)
        return -1
    if p % 4 == 3
        return tsh_pow_mod(amod, (p + 1) / 4, p)
    // General Tonelli-Shanks: factor p-1 = q * 2^s, q odd.
    let q = p - 1
    let s = 0
    while q % 2 == 0
        q = q / 2
        s += 1
    // Find a quadratic non-residue z.
    let z = 2
    while tsh_legendre(z, p) != -1
        z += 1
    let m = s
    let c = tsh_pow_mod(z, q, p)
    let t = tsh_pow_mod(amod, q, p)
    let r = tsh_pow_mod(amod, (q + 1) / 2, p)
    while t != 1
        // Find least i in (0, m) such that t^(2^i) === 1 (mod p).
        let i = 0
        let tt = t
        while tt != 1
            tt = (tt * tt) % p
            i += 1
        let b = c
        let e = m - i - 1
        for k in 0..e
            b = (b * b) % p
        m = i
        c = (b * b) % p
        t = (t * c) % p
        r = (r * b) % p
    return r

// tsh_verify — true iff r*r === a (mod p).
fn tsh_verify(r, a, p)
    let lhs = (r * r) % p
    if lhs < 0
        lhs += p
    let rhs = a % p
    if rhs < 0
        rhs += p
    return lhs == rhs
