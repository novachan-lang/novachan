// std/validation/password.nova — Password strength validation.
// LEAF — imports NOTHING.
//
// Public API:
//   vpw_has_lower(s)   -> bool   true iff s contains at least one lowercase ASCII letter
//   vpw_has_upper(s)   -> bool   true iff s contains at least one uppercase ASCII letter
//   vpw_has_digit(s)   -> bool   true iff s contains at least one ASCII digit 0-9
//   vpw_has_special(s) -> bool   true iff s contains at least one non-alphanumeric printable ASCII char
//   vpw_score(s)       -> int    0..5 strength score:
//                                  +1 len >= 8
//                                  +1 has lowercase letter
//                                  +1 has uppercase letter
//                                  +1 has digit
//                                  +1 has special character
//   vpw_strength(s)    -> string "weak" (score<=2), "medium" (score 3 or 4), "strong" (score==5)
//   vpw_meets(s, minLen, needUpper, needDigit, needSpecial) -> bool
//                         true iff the password satisfies all specified requirements

// vpw_has_lower — true iff s contains at least one lowercase ASCII letter (a-z).
fn vpw_has_lower(s: string) -> bool
    let n = len(s)
    let i = 0
    let found = 0
    while i < n
        let c = ord(char_at(s, i))
        if c >= 97
            if c <= 122
                found = 1
        i += 1
    found == 1

// vpw_has_upper — true iff s contains at least one uppercase ASCII letter (A-Z).
fn vpw_has_upper(s: string) -> bool
    let n = len(s)
    let i = 0
    let found = 0
    while i < n
        let c = ord(char_at(s, i))
        if c >= 65
            if c <= 90
                found = 1
        i += 1
    found == 1

// vpw_has_digit — true iff s contains at least one ASCII digit (0-9).
fn vpw_has_digit(s: string) -> bool
    let n = len(s)
    let i = 0
    let found = 0
    while i < n
        let c = ord(char_at(s, i))
        if c >= 48
            if c <= 57
                found = 1
        i += 1
    found == 1

// vpw_has_special — true iff s contains at least one printable ASCII special character
// (printable ASCII that is not a letter or digit: ord 33-47, 58-64, 91-96, 123-126).
fn vpw_has_special(s: string) -> bool
    let n = len(s)
    let i = 0
    let found = 0
    while i < n
        let c = ord(char_at(s, i))
        // printable ASCII range: 33-126 (skip space=32)
        // not a digit (48-57), not uppercase (65-90), not lowercase (97-122)
        if c >= 33
            if c <= 126
                let is_alpha_or_digit = 0
                if c >= 48
                    if c <= 57
                        is_alpha_or_digit = 1
                if c >= 65
                    if c <= 90
                        is_alpha_or_digit = 1
                if c >= 97
                    if c <= 122
                        is_alpha_or_digit = 1
                if is_alpha_or_digit == 0
                    found = 1
        i += 1
    found == 1

// vpw_score — compute password strength score 0..5.
// Criteria (each worth 1 point):
//   1. length >= 8
//   2. contains at least one lowercase letter
//   3. contains at least one uppercase letter
//   4. contains at least one digit
//   5. contains at least one special character
fn vpw_score(s: string) -> int
    let score = 0
    if len(s) >= 8
        score += 1
    if vpw_has_lower(s)
        score += 1
    if vpw_has_upper(s)
        score += 1
    if vpw_has_digit(s)
        score += 1
    if vpw_has_special(s)
        score += 1
    score

// vpw_strength — classify password as "weak", "medium", or "strong".
//   score <= 2  -> "weak"
//   score 3..4  -> "medium"
//   score == 5  -> "strong"
fn vpw_strength(s: string) -> string
    let sc = vpw_score(s)
    if sc >= 5
        return "strong"
    if sc >= 3
        return "medium"
    "weak"

// vpw_meets — check whether the password satisfies the given policy requirements.
//   minLen      : minimum required length (0 = no length requirement beyond empty)
//   needUpper   : if true, at least one uppercase letter required
//   needDigit   : if true, at least one digit required
//   needSpecial : if true, at least one special character required
// Note: a lowercase letter is always allowed. needLower is not a parameter (always valid).
fn vpw_meets(s: string, minLen: int, needUpper: bool, needDigit: bool, needSpecial: bool) -> bool
    if len(s) < minLen
        return false
    if needUpper
        if vpw_has_upper(s) == false
            return false
    if needDigit
        if vpw_has_digit(s) == false
            return false
    if needSpecial
        if vpw_has_special(s) == false
            return false
    true
