// ============================================================================
// NOVA Standard Library — std/validation/schema
// ============================================================================
// Lightweight schema validation for dicts. No regex engine required — pattern
// checks are deliberately simple (substring probes), matching the philosophy
// of the rest of std/validation (email.nova, url.nova, etc. do their own
// deeper checks; schema.nova is the generic glue that composes field rules).
//
// Public API:
//   vs_required(data, field)              -> bool
//   vs_min_length(s, n)                   -> bool
//   vs_max_length(s, n)                   -> bool
//   vs_in_range(val, lo, hi)              -> bool
//   vs_matches_pattern(s, pattern)        -> bool
//   vs_validate(data, rules)              -> list of error strings
//   vs_is_valid(data, rules)              -> bool
//
// A rule is a 3-element list: [field, rule_name, param]
//   rule_name == "required"    -> param unused (pass 0)
//   rule_name == "min_length"  -> param = int n
//   rule_name == "max_length"  -> param = int n
//   rule_name == "in_range"    -> param = [lo, hi]
//   rule_name == "pattern"     -> param = pattern name ("email" | "url")
// ============================================================================

// vs_required: field must exist in data AND, if its value is a string, must
// be non-empty. Non-string values (numbers, lists, dicts) only need to exist.
fn vs_required(data, field) -> bool
    if not contains(data, field)
        return false
    let v = data[field]
    if type_of(v) == "string" and len(v) == 0
        return false
    true

// vs_min_length: string length lower bound (inclusive).
fn vs_min_length(s, n) -> bool
    len(s) >= n

// vs_max_length: string length upper bound (inclusive).
fn vs_max_length(s, n) -> bool
    len(s) <= n

// vs_in_range: numeric bound check, inclusive on both ends.
fn vs_in_range(val, lo, hi) -> bool
    val >= lo and val <= hi

// vs_matches_pattern: simple named-pattern probes.
//   "email" -> contains "@"
//   "url"   -> contains "://"
// Unknown pattern names never match (fail closed).
fn vs_matches_pattern(s, pattern) -> bool
    if pattern == "email"
        return contains(s, "@")
    if pattern == "url"
        return contains(s, "://")
    false

// vs_validate: run every rule against data, collect one error string per
// failing rule (format: "<field>: failed <rule_name>"). Missing fields are
// treated as an empty string for the string-shaped checks (min/max
// length/pattern) so a missing optional field only fails an explicit
// "required" rule, not an unrelated length/pattern rule.
fn vs_validate(data, rules) -> list
    let errors = []
    let i = 0
    while i < len(rules)
        let rule = rules[i]
        let field = rule[0]
        let rule_name = rule[1]
        let param = rule[2]
        let value = ""
        if contains(data, field)
            value = data[field]
        let ok = true
        if rule_name == "required"
            ok = vs_required(data, field)
        else if rule_name == "min_length"
            ok = vs_min_length(value, param)
        else if rule_name == "max_length"
            ok = vs_max_length(value, param)
        else if rule_name == "in_range"
            let lo = param[0]
            let hi = param[1]
            ok = vs_in_range(value, lo, hi)
        else if rule_name == "pattern"
            ok = vs_matches_pattern(value, param)
        if not ok
            errors.push(field + ": failed " + rule_name)
        i = i + 1
    errors

// vs_is_valid: convenience wrapper — true iff vs_validate found zero errors.
fn vs_is_valid(data, rules) -> bool
    len(vs_validate(data, rules)) == 0

// ============================================================================
fn main()
    print("std/validation/schema loaded")
