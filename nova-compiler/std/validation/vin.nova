// std/validation/vin.nova — Vehicle Identification Number (VIN) validation.
// ISO 3779 / NHTSA standard: 17 characters, check digit at position 8 (0-indexed).
// LEAF — imports NOTHING.
//
// Public API:
//   vvin_is_valid(s)      -> bool    uppercase; exactly 17 chars; no I, O, Q;
//                                    check digit at index 8 equals computed value.
//   vvin_check_digit(s)   -> string  computed check digit ("0"-"9" or "X");
//                                    returns "" if the VIN cannot be evaluated.
//   vvin_wmi(s)           -> string  World Manufacturer Identifier (chars 0-2).
//   vvin_year_char(s)     -> string  model-year character (char at index 9).

// ---------- internal helpers ----------

// _vvin_translit — translate a single uppercase VIN character to its numeric
// value for the check-digit calculation.
// Digits 0-9    => face value (0..9)
// A-H (65-72)   => ord - 64  (A=1..H=8)
// J-R (74-82)   => ord - 73  (J=1..R=9; note P=7, Q is invalid so skipped at call site)
// S-Z (83-90)   => ord - 81  (S=2..Z=9)
// Invalid chars (I=73, O=79, Q=81) => -1
fn _vvin_translit(c: string) -> int
    let o = ord(c)
    // Digits 0-9
    if o >= 48
        if o <= 57
            return o - 48
    // Letters A-H
    if o >= 65
        if o <= 72
            return o - 64
    // I is invalid (ord 73)
    if o == 73
        return -1
    // Letters J-N (74-78)
    if o >= 74
        if o <= 78
            return o - 73
    // O is invalid (ord 79)
    if o == 79
        return -1
    // P (80)
    if o == 80
        return 7
    // Q is invalid (ord 81)
    if o == 81
        return -1
    // R (82)
    if o == 82
        return 9
    // Letters S-Z (83-90)
    if o >= 83
        if o <= 90
            return o - 81
    // Anything else is invalid
    -1

// _vvin_compute — compute the ISO 3779 check digit sum for the given VIN string.
// The string must already be uppercased and exactly 17 chars.
// Returns the check digit character: "0"-"9" or "X".
// Returns "" on any invalid character.
fn _vvin_compute(s: string) -> string
    let weights = [8, 7, 6, 5, 4, 3, 2, 10, 0, 9, 8, 7, 6, 5, 4, 3, 2]
    let total = 0
    let i = 0
    let ok = true
    while i < 17
        let c = char_at(s, i)
        let v = _vvin_translit(c)
        if v < 0
            ok = false
        if ok
            // Read weight from list; coerce to plain int to avoid any-boxing issues
            let w = weights[i] * 1
            total += v * w
        i += 1
    if ok
        let rem = total % 11
        if rem == 10
            return "X"
        return str(rem)
    ""

// ---------- public API ----------

// vvin_is_valid — returns true iff s is a valid ISO 3779 VIN.
// Criteria:
//   1. Exactly 17 characters.
//   2. No I, O, or Q anywhere.
//   3. Check digit at position 8 (0-indexed) equals the computed value.
fn vvin_is_valid(s: string) -> bool
    let n = len(s)
    if n != 17
        return false
    // Uppercase the whole string first
    let up = upper(s)
    // Scan for illegal characters I, O, Q
    let i = 0
    let illegal = false
    while i < 17
        let c = char_at(up, i)
        if c == "I"
            illegal = true
        if c == "O"
            illegal = true
        if c == "Q"
            illegal = true
        i += 1
    if illegal
        return false
    // Compute expected check digit
    let expected = _vvin_compute(up)
    if len(expected) == 0
        return false
    // Check digit is at position 8 (0-indexed)
    let actual = char_at(up, 8)
    actual == expected

// vvin_check_digit — returns the computed ISO 3779 check digit for the given VIN.
// The input is uppercased before computation.
// Returns "" if the VIN is the wrong length or contains invalid characters.
fn vvin_check_digit(s: string) -> string
    if len(s) != 17
        return ""
    _vvin_compute(upper(s))

// vvin_wmi — returns the World Manufacturer Identifier (first 3 characters).
// Returns "" if the VIN is shorter than 3 characters.
fn vvin_wmi(s: string) -> string
    let up = upper(s)
    if len(up) < 3
        return ""
    slice(up, 0, 3)

// vvin_year_char — returns the model-year character at position 9 (0-indexed).
// Returns "" if the VIN is shorter than 10 characters.
fn vvin_year_char(s: string) -> string
    let up = upper(s)
    if len(up) < 10
        return ""
    char_at(up, 9)
