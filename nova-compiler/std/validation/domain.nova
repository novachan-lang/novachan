// ============================================================================
// NOVA Standard Library — std/validation/domain
// ============================================================================
// RFC 1035-lite domain-name validation and decomposition.
//
// PUBLIC API:
//   vdom_is_valid(s: string) -> bool
//     True iff s is a well-formed domain name:
//       - Total length 1..253 characters
//       - At least two labels (contains at least one dot)
//       - Each label 1..63 characters, containing only [A-Za-z0-9-],
//         and NOT starting or ending with a hyphen
//       - TLD (last label) contains only letters (A-Za-z) and is >=2 chars
//
//   vdom_tld(s: string) -> string
//     Return the last label (top-level domain) of s.
//     If s contains no dot, returns s unchanged.
//
//   vdom_labels(s: string) -> list
//     Split s on '.' and return the list of labels.
//
//   vdom_is_subdomain(s: string) -> bool
//     True iff s has more than 2 labels (i.e. is a subdomain of a 2-label name).
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// _vdom_is_alnum_or_hyphen: true iff c is [A-Za-z0-9-].
fn _vdom_is_alnum_or_hyphen(c: string) -> bool
    let v = ord(c)
    if v == 45
        // hyphen '-'
        return true
    if v >= 48
        if v <= 57
            // digit 0-9
            return true
    if v >= 65
        if v <= 90
            // uppercase A-Z
            return true
    if v >= 97
        if v <= 122
            // lowercase a-z
            return true
    false

// _vdom_is_alpha: true iff c is [A-Za-z].
fn _vdom_is_alpha(c: string) -> bool
    let v = ord(c)
    if v >= 65
        if v <= 90
            return true
    if v >= 97
        if v <= 122
            return true
    false

// _vdom_label_ok: true iff label is a valid non-TLD domain label.
// Rules: length 1..63, chars all [A-Za-z0-9-], no leading or trailing hyphen.
fn _vdom_label_ok(label: string) -> bool
    let n = len(label)
    if n < 1
        return false
    if n > 63
        return false
    // must not start with hyphen
    if char_at(label, 0) == "-"
        return false
    // must not end with hyphen
    if char_at(label, n - 1) == "-"
        return false
    // all chars must be alphanumeric or hyphen
    let i = 0
    let ok = true
    while i < n
        let c = char_at(label, i)
        if _vdom_is_alnum_or_hyphen(c) == false
            ok = false
        i += 1
    ok

// _vdom_tld_ok: true iff label is a valid TLD (only letters, length >= 2).
fn _vdom_tld_ok(label: string) -> bool
    let n = len(label)
    if n < 2
        return false
    if n > 63
        return false
    let i = 0
    let ok = true
    while i < n
        let c = char_at(label, i)
        if _vdom_is_alpha(c) == false
            ok = false
        i += 1
    ok

// ── Public API ────────────────────────────────────────────────────────────────

// vdom_labels: split the domain on '.' and return the list of labels.
//
// Example:
//   vdom_labels("a.b.com") -> ["a", "b", "com"]
fn vdom_labels(s: string) -> list
    split(s, ".")

// vdom_tld: return the last label (TLD) of the domain.
// If there is no dot, returns s unchanged.
//
// Example:
//   vdom_tld("a.b.com") -> "com"
fn vdom_tld(s: string) -> string
    let parts = split(s, ".")
    let n = len(parts)
    if n < 1
        return ""
    // last element
    let result = ""
    for i in 0..n
        let lbl = parts[i]
        result = lbl
    result

// vdom_is_subdomain: true iff the domain has more than 2 labels.
//
// Example:
//   vdom_is_subdomain("a.b.com") -> true   (3 labels)
//   vdom_is_subdomain("example.com") -> false  (2 labels)
fn vdom_is_subdomain(s: string) -> bool
    let parts = split(s, ".")
    len(parts) > 2

// vdom_is_valid: RFC 1035-lite domain name validation.
//
// Returns true iff:
//   - Total string length is 1..253 chars
//   - Contains at least one '.' (two or more labels)
//   - Each non-TLD label: 1..63 chars, [A-Za-z0-9-] only, no leading/trailing hyphen
//   - TLD (last label): letters only [A-Za-z], length >= 2
//
// Examples:
//   vdom_is_valid("example.com")        -> true
//   vdom_is_valid("sub.example.co.uk")  -> true
//   vdom_is_valid("a-b.example.com")    -> true
//   vdom_is_valid("-bad.com")           -> false  (label starts with hyphen)
//   vdom_is_valid("bad-.com")           -> false  (label ends with hyphen)
//   vdom_is_valid("example")            -> false  (no dot, no TLD)
//   vdom_is_valid("ex ample.com")       -> false  (space not allowed)
fn vdom_is_valid(s: string) -> bool
    let total = len(s)
    if total < 1
        return false
    if total > 253
        return false
    // must contain at least one dot (two labels minimum)
    let has_dot = false
    for di in 0..total
        let dc = char_at(s, di)
        if dc == "."
            has_dot = true
    if has_dot == false
        return false
    // split into labels and validate
    let parts = split(s, ".")
    let n = len(parts)
    if n < 2
        return false
    // validate TLD (last label)
    let tld_label = ""
    for ti in 0..n
        let tl = parts[ti]
        tld_label = tl
    if _vdom_tld_ok(tld_label) == false
        return false
    // validate all non-TLD labels (indices 0..n-2)
    let valid = true
    for li in 0..(n - 1)
        let lbl = parts[li]
        if _vdom_label_ok(lbl) == false
            valid = false
    valid
