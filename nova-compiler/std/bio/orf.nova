// std/bio/orf.nova — Open reading frame (ORF) finding in DNA sequences.
// LEAF — imports NOTHING.
//
// Convention: an ORF spans from the ATG start codon through the end of the
// stop codon (TAA, TAG, TGA), INCLUSIVE.  Each ORF dict has keys:
//   "start"  -> 0-based index of the A in ATG
//   "end"    -> 0-based index of the last base of the stop codon (exclusive upper bound = end+1-th base)
//   "length" -> end - start + 1  (includes stop codon)
//
// The genetic code (standard codon table) maps each 3-letter codon to an
// amino-acid letter or "*" for stop.  Only the 20-AA single-letter codes are
// used.  Ambiguous / unknown codons translate as '?'.
//
// FLOAT HAZARDS obeyed:
//   * All intermediate floats bound to named lets before arithmetic.
//   * Abs of float: if x<0.0 then 0.0-x else x.
//
// API (prefix: orf_):
//   orf_find(dna)                   -> any  list of ORF dicts in frame 0
//   orf_find_frame(dna,frame)       -> any  list of ORF dicts in given frame (0,1,2)
//   orf_find_all_frames(dna)        -> any  list of ORF dicts across all three frames
//   orf_longest(dna)                -> any  dict of the longest ORF, or {} if none
//   orf_translate(dna,start,end)    -> string  AA sequence for dna[start..end+1]
//   orf_longest_protein(dna)        -> string  translated longest ORF
//   orf_count(dna)                  -> int  number of ORFs in frame 0
//   orf_has_orf(dna)                -> bool  true iff at least one ORF in frame 0
//   orf_gc(dna,start,end)           -> float  GC fraction within dna[start..end+1]
//   orf_upstream(dna,start,n)       -> string  n bases immediately before start
//   orf_between(dna,start,end)      -> string  the ORF substring dna[start..end+1]
//   orf_min_length_filter(orfs,min) -> any  filter list keeping ORFs with length>=min

// _codon_aa: translate a single 3-letter codon to its 1-letter AA or "*" for stop.
fn _codon_aa(codon) -> string
    if codon == "TTT" or codon == "TTC"
        return "F"
    if codon == "TTA" or codon == "TTG"
        return "L"
    if codon == "CTT" or codon == "CTC" or codon == "CTA" or codon == "CTG"
        return "L"
    if codon == "ATT" or codon == "ATC" or codon == "ATA"
        return "I"
    if codon == "ATG"
        return "M"
    if codon == "GTT" or codon == "GTC" or codon == "GTA" or codon == "GTG"
        return "V"
    if codon == "TCT" or codon == "TCC" or codon == "TCA" or codon == "TCG"
        return "S"
    if codon == "CCT" or codon == "CCC" or codon == "CCA" or codon == "CCG"
        return "P"
    if codon == "ACT" or codon == "ACC" or codon == "ACA" or codon == "ACG"
        return "T"
    if codon == "GCT" or codon == "GCC" or codon == "GCA" or codon == "GCG"
        return "A"
    if codon == "TAT" or codon == "TAC"
        return "Y"
    if codon == "TAA" or codon == "TAG" or codon == "TGA"
        return "*"
    if codon == "CAT" or codon == "CAC"
        return "H"
    if codon == "CAA" or codon == "CAG"
        return "Q"
    if codon == "AAT" or codon == "AAC"
        return "N"
    if codon == "AAA" or codon == "AAG"
        return "K"
    if codon == "GAT" or codon == "GAC"
        return "D"
    if codon == "GAA" or codon == "GAG"
        return "E"
    if codon == "TGT" or codon == "TGC"
        return "C"
    if codon == "TGG"
        return "W"
    if codon == "CGT" or codon == "CGC" or codon == "CGA" or codon == "CGG"
        return "R"
    if codon == "AGA" or codon == "AGG"
        return "R"
    if codon == "AGT" or codon == "AGC"
        return "S"
    if codon == "GGT" or codon == "GGC" or codon == "GGA" or codon == "GGG"
        return "G"
    return "?"

// _is_stop_codon: returns true if the codon is a stop codon.
fn _is_stop_codon(codon) -> bool
    if codon == "TAA" or codon == "TAG" or codon == "TGA"
        return true
    return false

// orf_find_frame: list of ORF dicts in the given reading frame (0, 1, or 2).
// ORF end is inclusive (last base of stop codon).
fn orf_find_frame(dna, frame) -> any
    let result = []
    let n = len(dna)
    let in_orf = false
    let orf_start = 0
    let i = frame
    while i + 2 < n
        let codon = slice(dna, i, i + 3)
        if in_orf == false
            if codon == "ATG"
                in_orf = true
                orf_start = i
        else
            if _is_stop_codon(codon)
                let orf_end = i + 2
                let orf_len = orf_end - orf_start + 1
                let rec = {}
                rec["start"] = orf_start
                rec["end"] = orf_end
                rec["length"] = orf_len
                push(result, rec)
                in_orf = false
        i = i + 3
    return result

// orf_find: list of ORF dicts in frame 0.
fn orf_find(dna) -> any
    let r = orf_find_frame(dna, 0)
    return r

// orf_find_all_frames: list of ORF dicts across all three frames (0, 1, 2).
fn orf_find_all_frames(dna) -> any
    let result = []
    let f0 = orf_find_frame(dna, 0)
    let f1 = orf_find_frame(dna, 1)
    let f2 = orf_find_frame(dna, 2)
    let i = 0
    while i < len(f0)
        push(result, f0[i])
        i = i + 1
    i = 0
    while i < len(f1)
        push(result, f1[i])
        i = i + 1
    i = 0
    while i < len(f2)
        push(result, f2[i])
        i = i + 1
    return result

// orf_longest: the longest ORF dict found across all three frames, or {} if none.
fn orf_longest(dna) -> any
    let all = orf_find_all_frames(dna)
    let n = len(all)
    if n == 0
        let empty = {}
        return empty
    let best = all[0]
    let best_len = best["length"]
    for i in 1..n
        let orf = all[i]
        let olen = orf["length"]
        if olen > best_len
            best = orf
            best_len = olen
    return best

// orf_translate: translate dna[start..end+1] (inclusive end) to amino acid string.
// Stops at stop codon (exclusive) — stop codon itself is not included in output.
fn orf_translate(dna, start, end) -> string
    let aa_parts = []
    let i = start
    while i + 2 <= end
        let codon = slice(dna, i, i + 3)
        let a = _codon_aa(codon)
        if a == "*"
            i = end + 1
        else
            push(aa_parts, a)
            i = i + 3
    let aa = join(aa_parts, "")
    return aa

// orf_longest_protein: translated AA sequence of the longest ORF, "" if none.
fn orf_longest_protein(dna) -> string
    let best = orf_longest(dna)
    if not contains(best, "start")
        return ""
    let s = best["start"]
    let e = best["end"]
    let prot = orf_translate(dna, s, e)
    return prot

// orf_count: number of ORFs found in frame 0.
fn orf_count(dna) -> int
    let orfs = orf_find(dna)
    let c = len(orfs)
    return c

// orf_has_orf: true iff at least one ORF exists in frame 0.
fn orf_has_orf(dna) -> bool
    let c = orf_count(dna)
    if c > 0
        return true
    return false

// orf_gc: GC fraction within dna[start..end+1] (inclusive).
fn orf_gc(dna, start, end) -> float
    let total = end - start + 1
    if total <= 0
        return 0.0
    let gc = 0
    let i = start
    while i <= end
        let ch = slice(dna, i, i + 1)
        if ch == "G" or ch == "C"
            gc = gc + 1
        i = i + 1
    let gf = gc * 1.0
    let tf = total * 1.0
    let ratio = gf / tf
    return ratio

// orf_upstream: n bases immediately before start; returns "" if start==0 or n==0.
fn orf_upstream(dna, start, n) -> string
    if start <= 0 or n <= 0
        return ""
    let begin = start - n
    if begin < 0
        begin = 0
    let up = slice(dna, begin, start)
    return up

// orf_between: the ORF substring dna[start..end+1] (inclusive end).
fn orf_between(dna, start, end) -> string
    let sub = slice(dna, start, end + 1)
    return sub

// orf_min_length_filter: return only ORFs whose length >= minlen.
fn orf_min_length_filter(orfs, minlen) -> any
    let result = []
    let i = 0
    let n = len(orfs)
    while i < n
        let orf = orfs[i]
        let olen = orf["length"]
        if olen >= minlen
            push(result, orf)
        i = i + 1
    return result
