// std/bio/seqstats.nova — Sequence composition statistics for DNA/RNA/protein.
// LEAF — imports NOTHING.
//
// Sequences are plain uppercase-letter strings.
//
// Public API:
//   gc_content(s)              -> float  fraction of G+C bases
//   gc_skew(s)                 -> float  (G-C)/(G+C), 0.0 if no G or C
//   at_skew(s)                 -> float  (A-T)/(A+T), 0.0 if no A or T
//   cumulative_gc_skew(s)      -> any    list of running GC skew values
//   dinucleotide_freq(s)       -> any    dict 2-mer -> count
//   cpg_count(s)               -> int    number of CG dinucleotides
//   cpg_observed_expected(s)   -> float  (count_CG*len)/(count_C*count_G)
//   base_composition(s)        -> any    dict base -> fraction
//   shannon_entropy(s)         -> float  entropy in bits over base frequencies
//   sequence_complexity(s)     -> float  distinct 2-mers / total 2-mers
//   melting_temp_wallace(s)    -> float  2*(A+T) + 4*(G+C) (Wallace rule, Celsius)
//   molecular_weight_dna(s)    -> float  approximate MW sum (Da)
//   purine_fraction(s)         -> float  fraction of A+G

// _count_base: private — count occurrences of a single-char base in sequence.
fn _count_base(s, base) -> int
    let count = 0
    let i = 0
    let n = len(s)
    while i < n
        let c = slice(s, i, i+1)
        if c == base
            count = count + 1
        i = i + 1
    return count

// _log2: private — log base 2 via ln.
fn _log2(x) -> float
    let ln2 = 0.6931471805599453
    let lx = log(x)
    let result = lx / ln2
    return result

// gc_content: fraction of G and C nucleotides.
fn gc_content(s) -> float
    let n = len(s)
    if n == 0
        return 0.0
    let g = _count_base(s, "G")
    let c = _count_base(s, "C")
    let gc = (g + c) * 1.0
    let nf = n * 1.0
    let frac = gc / nf
    return frac

// gc_skew: (G-C)/(G+C); returns 0.0 if no G or C.
fn gc_skew(s) -> float
    let g = _count_base(s, "G")
    let c = _count_base(s, "C")
    let denom = g + c
    if denom == 0
        return 0.0
    let gf = g * 1.0
    let cf = c * 1.0
    let num = gf - cf
    let df = denom * 1.0
    let skew = num / df
    return skew

// at_skew: (A-T)/(A+T); returns 0.0 if no A or T.
fn at_skew(s) -> float
    let a = _count_base(s, "A")
    let t = _count_base(s, "T")
    let denom = a + t
    if denom == 0
        return 0.0
    let af = a * 1.0
    let tf = t * 1.0
    let num = af - tf
    let df = denom * 1.0
    let skew = num / df
    return skew

// cumulative_gc_skew: running cumulative GC skew per position.
// At each position: adds +1 for G, -1 for C to a running sum; skew = sum/(G+C so far).
fn cumulative_gc_skew(s) -> any
    let n = len(s)
    let result = []
    let running_g = 0
    let running_c = 0
    for i in 0..n
        let ch = slice(s, i, i+1)
        if ch == "G"
            running_g = running_g + 1
        if ch == "C"
            running_c = running_c + 1
        let denom = running_g + running_c
        let skew_val = 0.0
        if denom > 0
            let gf = running_g * 1.0
            let cf = running_c * 1.0
            let df = denom * 1.0
            skew_val = (gf - cf) / df
        push(result, skew_val)
    return result

// dinucleotide_freq: count of all 2-mers in the sequence.
fn dinucleotide_freq(s) -> any
    let n = len(s)
    let result = {}
    for i in 0..(n - 1)
        let di = slice(s, i, i+2)
        if contains(result, di)
            result[di] = result[di] + 1
        else
            result[di] = 1
    return result

// cpg_count: count occurrences of the dinucleotide "CG".
fn cpg_count(s) -> int
    let n = len(s)
    let count = 0
    for i in 0..(n - 1)
        let di = slice(s, i, i+2)
        if di == "CG"
            count = count + 1
    return count

// cpg_observed_expected: CpG O/E ratio = (count_CG * len) / (count_C * count_G).
// Returns 0.0 if no C or G.
fn cpg_observed_expected(s) -> float
    let n = len(s)
    if n == 0
        return 0.0
    let cg = cpg_count(s)
    let count_c = _count_base(s, "C")
    let count_g = _count_base(s, "G")
    if count_c == 0 or count_g == 0
        return 0.0
    let cgf = cg * 1.0
    let nf = n * 1.0
    let cf = count_c * 1.0
    let gf = count_g * 1.0
    let ratio = (cgf * nf) / (cf * gf)
    return ratio

// base_composition: fraction of each distinct character in the sequence.
fn base_composition(s) -> any
    let n = len(s)
    let counts = {}
    for i in 0..n
        let ch = slice(s, i, i+1)
        if contains(counts, ch)
            counts[ch] = counts[ch] + 1
        else
            counts[ch] = 1
    let result = {}
    let nf = n * 1.0
    for k in counts
        let cnt = counts[k]
        let frac = (cnt * 1.0) / nf
        result[k] = frac
    return result

// shannon_entropy: Shannon information entropy in bits over base frequencies.
// H = -sum(p * log2(p)) for each unique base with p > 0.
fn shannon_entropy(s) -> float
    let n = len(s)
    if n == 0
        return 0.0
    let counts = {}
    for i in 0..n
        let ch = slice(s, i, i+1)
        if contains(counts, ch)
            counts[ch] = counts[ch] + 1
        else
            counts[ch] = 1
    let nf = n * 1.0
    let entropy = 0.0
    for k in counts
        let cnt = counts[k]
        let p = (cnt * 1.0) / nf
        if p > 0.0
            let lp = _log2(p)
            entropy = entropy + p * lp
    let neg_h = 0.0 - entropy
    return neg_h

// sequence_complexity: ratio of distinct 2-mers to total 2-mer positions.
fn sequence_complexity(s) -> float
    let n = len(s)
    if n < 2
        return 0.0
    let total = n - 1
    let seen = {}
    for i in 0..total
        let di = slice(s, i, i+2)
        seen[di] = 1
    let distinct = 0
    for k in seen
        distinct = distinct + 1
    let df = distinct * 1.0
    let tf = total * 1.0
    let complexity = df / tf
    return complexity

// melting_temp_wallace: Tm = 2*(A+T) + 4*(G+C) degrees Celsius (Wallace rule for short oligos).
fn melting_temp_wallace(s) -> float
    let a = _count_base(s, "A")
    let t = _count_base(s, "T")
    let g = _count_base(s, "G")
    let c = _count_base(s, "C")
    let at = (a + t) * 1.0
    let gc = (g + c) * 1.0
    let tm = 2.0 * at + 4.0 * gc
    return tm

// molecular_weight_dna: approximate molecular weight in Daltons.
// Average nucleotide MW (ssDNA): A=313.2, C=289.2, G=329.2, T=304.2.
// Subtract 61.96 for the water released at the 5' end (one phosphate group adjustment).
// Empty sequence returns 0.0 (the adjustment must not be applied to a zero-base chain).
fn molecular_weight_dna(s) -> float
    if len(s) == 0
        return 0.0
    let a = _count_base(s, "A")
    let c = _count_base(s, "C")
    let g = _count_base(s, "G")
    let t = _count_base(s, "T")
    let af = a * 1.0
    let cf = c * 1.0
    let gf = g * 1.0
    let tf = t * 1.0
    let mw = af * 313.2 + cf * 289.2 + gf * 329.2 + tf * 304.2
    let adj = 61.96
    let result = mw - adj
    return result

// purine_fraction: fraction of purines (A and G) in the sequence.
fn purine_fraction(s) -> float
    let n = len(s)
    if n == 0
        return 0.0
    let a = _count_base(s, "A")
    let g = _count_base(s, "G")
    let pf = (a + g) * 1.0
    let nf = n * 1.0
    let frac = pf / nf
    return frac
