// std/bio/population.nova — Population genetics: Hardy-Weinberg, allele frequencies, diversity.
// LEAF — imports NOTHING.
//
// Genotypes are 2-character strings (e.g. "AA","Aa","aa"). Alleles are 1-char strings.
//
// Public API:
//   allele_count(genotypes,allele)         -> int
//   allele_freq(genotypes,allele)          -> float
//   num_alleles(genotypes)                 -> int   (unique allele count in the pool)
//   minor_allele_freq(genotypes,a1,a2)     -> float (smaller of the two allele freqs)
//   hw_expected_freqs(p)                   -> any   dict AA->float, Aa->float, aa->float
//   hw_chi_square(observed,p)              -> float chi-square statistic
//   is_in_hwe(observed,p,threshold)        -> bool
//   heterozygosity(genotypes)              -> float fraction with two different alleles
//   expected_heterozygosity(p)             -> float 2*p*(1-p)
//   fst(subpop_freqs)                      -> float Wright's Fst approximation
//   nucleotide_diversity(seqs)             -> float mean pairwise p-distance
//   inbreeding_coefficient(obs_het,exp_het)-> float 1 - obs/exp

// _abs_f: private absolute value for floats.
fn _abs_f(x) -> float
    if x < 0.0
        return 0.0 - x
    return x

// _min_len_s: private — minimum of two ints (for sequence comparison).
fn _min_len_s(a, b) -> int
    if a < b
        return a
    return b

// _p_dist: private pairwise p-distance between two sequences.
fn _p_dist(a, b) -> float
    let n = _min_len_s(len(a), len(b))
    if n == 0
        return 0.0
    let count = 0
    let i = 0
    while i < n
        let ca = slice(a, i, i+1)
        let cb = slice(b, i, i+1)
        if ca != cb
            count = count + 1
        i = i + 1
    let cf = count * 1.0
    let nf = n * 1.0
    let d = cf / nf
    return d

// allele_count: count occurrences of allele in the genotype list (each genotype contributes 2 alleles).
fn allele_count(genotypes, allele) -> int
    let count = 0
    let i = 0
    while i < len(genotypes)
        let g = genotypes[i]
        let a1 = slice(g, 0, 1)
        let a2 = slice(g, 1, 2)
        if a1 == allele
            count = count + 1
        if a2 == allele
            count = count + 1
        i = i + 1
    return count

// allele_freq: frequency of allele in the genotype list (count / total alleles).
fn allele_freq(genotypes, allele) -> float
    let n = len(genotypes)
    if n == 0
        return 0.0
    let total = n * 2
    let cnt = allele_count(genotypes, allele)
    let cf = cnt * 1.0
    let tf = total * 1.0
    let freq = cf / tf
    return freq

// num_alleles: count distinct allele characters in the genotype pool.
fn num_alleles(genotypes) -> int
    let seen = {}
    let i = 0
    while i < len(genotypes)
        let g = genotypes[i]
        let a1 = slice(g, 0, 1)
        let a2 = slice(g, 1, 2)
        seen[a1] = 1
        seen[a2] = 1
        i = i + 1
    let count = 0
    for k in seen
        count = count + 1
    return count

// minor_allele_freq: return the smaller frequency of the two given alleles.
fn minor_allele_freq(genotypes, a1, a2) -> float
    let f1 = allele_freq(genotypes, a1)
    let f2 = allele_freq(genotypes, a2)
    if f1 < f2
        return f1
    return f2

// hw_expected_freqs: Hardy-Weinberg expected genotype frequencies given allele freq p.
// Returns dict with keys "AA", "Aa", "aa".
fn hw_expected_freqs(p) -> any
    let q = 1.0 - p
    let fAA = p * p
    let fAa = 2.0 * p * q
    let faa = q * q
    let result = {}
    result["AA"] = fAA
    result["Aa"] = fAa
    result["aa"] = faa
    return result

// hw_chi_square: chi-square test of observed genotype counts vs HW expectation.
// observed = dict "AA"->int, "Aa"->int, "aa"->int.
// Zero-expected cells (e.g. when p=0 or p=1) are excluded per standard convention:
// dividing by zero would produce NaN, so those terms contribute 0.0 to the sum.
fn hw_chi_square(observed, p) -> float
    let n = observed["AA"] + observed["Aa"] + observed["aa"]
    let nf = n * 1.0
    let q = 1.0 - p
    let exp_AA = nf * p * p
    let exp_Aa = nf * 2.0 * p * q
    let exp_aa = nf * q * q
    let obs_AA = observed["AA"] * 1.0
    let obs_Aa = observed["Aa"] * 1.0
    let obs_aa = observed["aa"] * 1.0
    let chi = 0.0
    if exp_AA > 0.0
        let dAA = obs_AA - exp_AA
        chi = chi + (dAA * dAA) / exp_AA
    if exp_Aa > 0.0
        let dAa = obs_Aa - exp_Aa
        chi = chi + (dAa * dAa) / exp_Aa
    if exp_aa > 0.0
        let daa = obs_aa - exp_aa
        chi = chi + (daa * daa) / exp_aa
    return chi

// is_in_hwe: returns true if chi-square statistic is below threshold (e.g. 3.841 for p=0.05, 1 df).
fn is_in_hwe(observed, p, threshold) -> bool
    let chi = hw_chi_square(observed, p)
    if chi < threshold
        return true
    return false

// heterozygosity: fraction of genotypes with two different alleles.
fn heterozygosity(genotypes) -> float
    let n = len(genotypes)
    if n == 0
        return 0.0
    let het_count = 0
    let i = 0
    while i < n
        let g = genotypes[i]
        let a1 = slice(g, 0, 1)
        let a2 = slice(g, 1, 2)
        if a1 != a2
            het_count = het_count + 1
        i = i + 1
    let hf = het_count * 1.0
    let nf = n * 1.0
    let h = hf / nf
    return h

// expected_heterozygosity: H_e = 2*p*q = 2*p*(1-p).
fn expected_heterozygosity(p) -> float
    let q = 1.0 - p
    let he = 2.0 * p * q
    return he

// fst: Wright's Fst approximation from list of subpopulation allele frequencies.
// Fst = (Ht - Hs) / Ht, where Ht is total heterozygosity, Hs is mean subpop heterozygosity.
fn fst(subpop_freqs) -> float
    let k = len(subpop_freqs)
    if k == 0
        return 0.0
    // mean allele frequency across subpopulations
    let sum_p = 0.0
    let i = 0
    while i < k
        sum_p = sum_p + subpop_freqs[i]
        i = i + 1
    let kf = k * 1.0
    let mean_p = sum_p / kf
    let mean_q = 1.0 - mean_p
    let Ht = 2.0 * mean_p * mean_q
    if Ht <= 0.0
        return 0.0
    // mean within-subpop heterozygosity
    let sum_hs = 0.0
    let j = 0
    while j < k
        let pj = subpop_freqs[j]
        let qj = 1.0 - pj
        let hs_j = 2.0 * pj * qj
        sum_hs = sum_hs + hs_j
        j = j + 1
    let Hs = sum_hs / kf
    let fst_val = (Ht - Hs) / Ht
    return fst_val

// nucleotide_diversity: mean pairwise p-distance across all pairs of sequences.
fn nucleotide_diversity(seqs) -> float
    let n = len(seqs)
    if n < 2
        return 0.0
    let sum_d = 0.0
    let i = 0
    while i < n
        let j = i + 1
        while j < n
            let d = _p_dist(seqs[i], seqs[j])
            sum_d = sum_d + d
            j = j + 1
        i = i + 1
    let pairs = (n * (n - 1)) / 2
    let pf = pairs * 1.0
    let pi_val = sum_d / pf
    return pi_val

// inbreeding_coefficient: F = 1 - (observed heterozygosity / expected heterozygosity).
fn inbreeding_coefficient(obs_het, exp_het) -> float
    if exp_het <= 0.0
        return 0.0
    let ratio = obs_het / exp_het
    let F = 1.0 - ratio
    return F
