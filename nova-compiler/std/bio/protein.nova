// std/bio/protein.nova — Protein and peptide property calculations.
//
// Sequences are strings of standard 20 amino acid uppercase letters.
// Uses AVERAGE residue masses (not monoisotopic) for each amino acid.
// All float operations follow NOVA float rules: bind intermediates to let,
// never return multi-term float expressions directly.
//
// Public API:
//   aa_mw(aa)             -> float  average residue mass (one-letter code)
//   peptide_mw(seq)       -> float  sum of residue masses + 18.01524 (water)
//   aa_is_hydrophobic(aa) -> bool   AILMFWVP set
//   aa_is_polar(aa)       -> bool   NCQSTY set (polar uncharged)
//   aa_is_charged(aa)     -> bool   DEKRH set
//   aa_charge_at_ph7(aa)  -> int    approx charge: D,E=-1; K,R=+1; others=0
//   net_charge(seq)       -> int    sum of aa_charge_at_ph7 over all residues
//   aa_composition(seq)   -> any    dict aa->count
//   hydrophobicity_gravy(seq) -> float  mean Kyte-Doolittle score
//   aromaticity(seq)      -> float  fraction of F, W, Y residues
//   count_positive(seq)   -> int    count of K and R residues
//   count_negative(seq)   -> int    count of D and E residues
//   protein_length(seq)   -> int    length of sequence string

// Average residue masses (Da) — standard 20 amino acids.
// Source: NIST/ExPASy average masses.
fn aa_mw(aa) -> float
    if aa == "A"
        let m = 71.0788
        return m
    if aa == "R"
        let m = 156.1875
        return m
    if aa == "N"
        let m = 114.1038
        return m
    if aa == "D"
        let m = 115.0886
        return m
    if aa == "C"
        let m = 103.1388
        return m
    if aa == "E"
        let m = 129.1155
        return m
    if aa == "Q"
        let m = 128.1307
        return m
    if aa == "G"
        let m = 57.0519
        return m
    if aa == "H"
        let m = 137.1411
        return m
    if aa == "I"
        let m = 113.1594
        return m
    if aa == "L"
        let m = 113.1594
        return m
    if aa == "K"
        let m = 128.1741
        return m
    if aa == "M"
        let m = 131.1926
        return m
    if aa == "F"
        let m = 147.1766
        return m
    if aa == "P"
        let m = 97.1167
        return m
    if aa == "S"
        let m = 87.0782
        return m
    if aa == "T"
        let m = 101.1051
        return m
    if aa == "W"
        let m = 186.2132
        return m
    if aa == "Y"
        let m = 163.1760
        return m
    if aa == "V"
        let m = 99.1326
        return m
    let zero = 0.0
    return zero

// Peptide molecular weight: sum of residue masses + 18.01524 (one water molecule).
fn peptide_mw(seq) -> float
    let total = 0.0
    let n = len(seq)
    for i in 0..n
        let aa = slice(seq, i, i + 1)
        let m = aa_mw(aa)
        total += m
    let water = 18.01524
    let result = total + water
    return result

// True if aa is in the hydrophobic set: A I L M F W V P.
fn aa_is_hydrophobic(aa) -> bool
    if aa == "A"
        return true
    if aa == "I"
        return true
    if aa == "L"
        return true
    if aa == "M"
        return true
    if aa == "F"
        return true
    if aa == "W"
        return true
    if aa == "V"
        return true
    if aa == "P"
        return true
    return false

// True if aa is polar uncharged: N C Q S T Y.
fn aa_is_polar(aa) -> bool
    if aa == "N"
        return true
    if aa == "C"
        return true
    if aa == "Q"
        return true
    if aa == "S"
        return true
    if aa == "T"
        return true
    if aa == "Y"
        return true
    return false

// True if aa is charged (positive or negative): D E K R H.
fn aa_is_charged(aa) -> bool
    if aa == "D"
        return true
    if aa == "E"
        return true
    if aa == "K"
        return true
    if aa == "R"
        return true
    if aa == "H"
        return true
    return false

// Approximate formal charge at pH 7: D,E = -1; K,R = +1; all others = 0.
// H is ~0 at pH 7 (pKa ~6.0, predominantly uncharged).
fn aa_charge_at_ph7(aa) -> int
    if aa == "D"
        return 0 - 1
    if aa == "E"
        return 0 - 1
    if aa == "K"
        return 1
    if aa == "R"
        return 1
    return 0

// Net charge of peptide at pH 7 (sum of per-residue charges).
fn net_charge(seq) -> int
    let total = 0
    let n = len(seq)
    for i in 0..n
        let aa = slice(seq, i, i + 1)
        let c = aa_charge_at_ph7(aa)
        total += c
    return total

// Amino acid composition as a dict mapping one-letter code -> count.
fn aa_composition(seq) -> any
    let comp = {}
    let n = len(seq)
    for i in 0..n
        let aa = slice(seq, i, i + 1)
        if aa in comp
            let old = comp[aa]
            comp[aa] = old + 1
        else
            comp[aa] = 1
    return comp

// Kyte-Doolittle hydrophobicity scale (standard values).
fn _kd_scale(aa) -> float
    if aa == "I"
        let v = 4.5
        return v
    if aa == "V"
        let v = 4.2
        return v
    if aa == "L"
        let v = 3.8
        return v
    if aa == "F"
        let v = 2.8
        return v
    if aa == "C"
        let v = 2.5
        return v
    if aa == "M"
        let v = 1.9
        return v
    if aa == "A"
        let v = 1.8
        return v
    if aa == "G"
        let v = 0.0 - 0.4
        return v
    if aa == "T"
        let v = 0.0 - 0.7
        return v
    if aa == "S"
        let v = 0.0 - 0.8
        return v
    if aa == "W"
        let v = 0.0 - 0.9
        return v
    if aa == "Y"
        let v = 0.0 - 1.3
        return v
    if aa == "P"
        let v = 0.0 - 1.6
        return v
    if aa == "H"
        let v = 0.0 - 3.2
        return v
    if aa == "E"
        let v = 0.0 - 3.5
        return v
    if aa == "Q"
        let v = 0.0 - 3.5
        return v
    if aa == "D"
        let v = 0.0 - 3.5
        return v
    if aa == "N"
        let v = 0.0 - 3.5
        return v
    if aa == "K"
        let v = 0.0 - 3.9
        return v
    if aa == "R"
        let v = 0.0 - 4.5
        return v
    let zero = 0.0
    return zero

// Mean Kyte-Doolittle hydrophobicity (GRAVY score) of a peptide sequence.
fn hydrophobicity_gravy(seq) -> float
    let n = len(seq)
    if n == 0
        let z = 0.0
        return z
    let total = 0.0
    for i in 0..n
        let aa = slice(seq, i, i + 1)
        let kd = _kd_scale(aa)
        total += kd
    let nf = n * 1.0
    let result = total / nf
    return result

// Fraction of residues that are aromatic (F, W, Y).
fn aromaticity(seq) -> float
    let n = len(seq)
    if n == 0
        let z = 0.0
        return z
    let count = 0
    for i in 0..n
        let aa = slice(seq, i, i + 1)
        if aa == "F"
            count += 1
        if aa == "W"
            count += 1
        if aa == "Y"
            count += 1
    let nf = n * 1.0
    let cf = count * 1.0
    let result = cf / nf
    return result

// Count positively charged residues (K, R) in sequence.
fn count_positive(seq) -> int
    let count = 0
    let n = len(seq)
    for i in 0..n
        let aa = slice(seq, i, i + 1)
        if aa == "K"
            count += 1
        if aa == "R"
            count += 1
    return count

// Count negatively charged residues (D, E) in sequence.
fn count_negative(seq) -> int
    let count = 0
    let n = len(seq)
    for i in 0..n
        let aa = slice(seq, i, i + 1)
        if aa == "D"
            count += 1
        if aa == "E"
            count += 1
    return count

// Length of the protein sequence (number of residues).
fn protein_length(seq) -> int
    return len(seq)
