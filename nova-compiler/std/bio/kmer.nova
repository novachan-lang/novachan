// ============================================================================
// NOVA Standard Library — std/bio/kmer
// ============================================================================
// k-mer extraction, counting, frequency, canonical k-mers, Jaccard similarity,
// top-N k-mers, position lists, and k-mer spectrum.
//
// SELF-CONTAINED: all helpers defined privately; no imports.
//
// PUBLIC API:
//   kmer_extract(s,k)         -> any    list of all length-k substrings (sliding)
//   kmer_count(s,k)           -> any    dict kmer->count
//   kmer_freq(s,k)            -> any    dict kmer->frequency float
//   kmer_unique(s,k)          -> int    number of distinct k-mers
//   kmer_total(s,k)           -> int    len(s)-k+1 (or 0 if k>len(s))
//   kmer_canonical(kmer)      -> string lexicographically smaller of kmer and
//                                       its reverse complement
//   kmer_count_canonical(s,k) -> any    dict canonical_kmer->count
//   kmer_top(s,k,n)           -> any    top-n k-mers by count (ties: lex asc)
//   kmer_jaccard(a,b,k)       -> float  Jaccard of k-mer SETS
//   kmer_contains(s,kmer)     -> bool   true iff kmer appears in s
//   kmer_positions(s,kmer)    -> any    list of start indices of kmer in s
//   kmer_spectrum(s,k)        -> any    sorted list of distinct k-mers
//
// PREFIX: kmer_ (private helpers _km_)
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _km_revcomp: reverse complement of a DNA k-mer.
fn _km_revcomp(kmer) -> string
    let n = len(kmer)
    let result_parts = []
    let i = n - 1
    while i >= 0
        let c = char_at(kmer, i)
        if c == "A"
            push(result_parts, "T")
        else if c == "T"
            push(result_parts, "A")
        else if c == "C"
            push(result_parts, "G")
        else if c == "G"
            push(result_parts, "C")
        else
            push(result_parts, c)
        i -= 1
    let result = join(result_parts, "")
    return result

// _km_str_lt: returns 1 iff string a is lexicographically less than string b.
fn _km_str_lt(a, b) -> int
    let na = len(a)
    let nb = len(b)
    let limit = na
    if nb < limit
        limit = nb
    let i = 0
    let decided = 0
    let result = 0
    while i < limit and decided == 0
        let oa = ord(char_at(a, i))
        let ob = ord(char_at(b, i))
        if oa < ob
            result = 1
            decided = 1
        else if oa > ob
            decided = 1
        i += 1
    if decided == 0
        if na < nb
            result = 1
    return result

// _km_str_le: returns 1 iff a <= b lexicographically.
fn _km_str_le(a, b) -> int
    if a == b
        return 1
    return _km_str_lt(a, b)

// _km_sort_strings: sort a list of strings lexicographically ascending.
// Returns a new sorted list. Uses the same selection-sort approach as
// std/text/anagram._ang_sort_strings.
fn _km_sort_strings(lst) -> any
    let n = len(lst)
    // Copy lst into a mutable working array.
    // Concatenate with "" to materialize strings from any-typed list elements.
    let work = []
    let k = 0
    while k < n
        work.push(lst[k] + "")
        k += 1
    // Repeatedly extract the minimum from work into sorted output.
    let sorted = []
    let remaining = n
    while remaining > 0
        // Find index of the lexicographically smallest element.
        let mi = 0
        for i in 1..remaining
            if _km_str_lt(work[i], work[mi]) == 1
                mi = i
        sorted.push(work[mi])
        // Shift elements after mi left by one to fill the gap.
        let fill = mi
        while fill < remaining - 1
            work[fill] = work[fill + 1]
            fill += 1
        remaining -= 1
    return sorted

// ── Public API ────────────────────────────────────────────────────────────────

// kmer_total: number of length-k substrings (sliding window) in s.
// Returns 0 if k > len(s) or k <= 0.
fn kmer_total(s, k) -> int
    let n = len(s)
    if k <= 0 or k > n
        return 0
    return n - k + 1

// kmer_extract: return a list of all length-k substrings of s (sliding by 1).
// Returns empty list if k > len(s) or k <= 0.
fn kmer_extract(s, k) -> any
    let result = []
    let total = kmer_total(s, k)
    for i in 0..total
        let kmer = ""
        let j = 0
        while j < k
            kmer += char_at(s, i + j)
            j += 1
        result.push(kmer)
    return result

// kmer_count: return a dict mapping each k-mer to its count in s.
fn kmer_count(s, k) -> any
    let d = {}
    let total = kmer_total(s, k)
    for i in 0..total
        let kmer = ""
        let j = 0
        while j < k
            kmer += char_at(s, i + j)
            j += 1
        if kmer in d
            d[kmer] = d[kmer] + 1
        else
            d[kmer] = 1
    return d

// kmer_freq: return a dict mapping each k-mer to its relative frequency.
// Frequencies sum to 1.0.  Returns empty dict if no k-mers.
fn kmer_freq(s, k) -> any
    let counts = kmer_count(s, k)
    let total = kmer_total(s, k)
    let d = {}
    if total == 0
        return d
    let tot_f = total * 1.0
    let ks = keys(counts)
    let nk = len(ks)
    for i in 0..nk
        let km = ks[i]
        let cnt = counts[km]
        let freq = cnt * 1.0 / tot_f
        d[km] = freq
    return d

// kmer_unique: number of distinct k-mers in s.
fn kmer_unique(s, k) -> int
    let counts = kmer_count(s, k)
    return len(keys(counts))

// kmer_canonical: return the lexicographically smaller of kmer and its
// reverse complement.  This gives the canonical (strand-agnostic) form.
fn kmer_canonical(kmer) -> string
    let rc = _km_revcomp(kmer)
    if _km_str_le(kmer, rc) == 1
        return kmer
    return rc

// kmer_count_canonical: count k-mers in their canonical form.
// Each k-mer and its reverse complement contribute to the same key.
fn kmer_count_canonical(s, k) -> any
    let d = {}
    let total = kmer_total(s, k)
    for i in 0..total
        let kmer_parts = []
        let j = 0
        while j < k
            push(kmer_parts, char_at(s, i + j))
            j += 1
        let kmer = join(kmer_parts, "")
        let ck = kmer_canonical(kmer)
        if ck in d
            d[ck] = d[ck] + 1
        else
            d[ck] = 1
    return d

// kmer_top: return the top-n k-mers by count (descending).
// Ties broken by lexicographic order (ascending).
// Uses selection sort to avoid negative-index footgun.
// Returns at most min(n, distinct_kmer_count) entries.
fn kmer_top(s, k, n) -> any
    let counts = kmer_count(s, k)
    let ks = keys(counts)
    let nk = len(ks)
    // Build working list of [kmer, count] pairs.
    // Materialize kmer strings via concatenation for correct char_at behavior.
    let work = []
    for i in 0..nk
        let km = ks[i] + ""
        let pair = [km, counts[km]]
        work.push(pair)
    // Selection sort: primary descending by count, secondary ascending by kmer.
    // Repeatedly find the "best" (highest count, then lex-smallest kmer) pair.
    let limit = n
    if nk < limit
        limit = nk
    let result = []
    let remaining = nk
    for ri in 0..limit
        // Find index of best pair in work[0..remaining).
        let bi = 0
        let ii = 1
        while ii < remaining
            let wp = work[ii]
            let bp = work[bi]
            let wc = wp[1]
            let bc = bp[1]
            // Current ii is better if: count > best count,
            // or count == best count AND kmer is lex smaller.
            let is_better = 0
            if wc > bc
                is_better = 1
            else if wc == bc
                let wkm = wp[0] + ""
                let bkm = bp[0] + ""
                if _km_str_lt(wkm, bkm) == 1
                    is_better = 1
            if is_better == 1
                bi = ii
            ii += 1
        result.push(work[bi][0])
        // Shift elements after bi left by one.
        let fill = bi
        while fill < remaining - 1
            work[fill] = work[fill + 1]
            fill += 1
        remaining -= 1
    return result

// kmer_jaccard: Jaccard similarity of k-mer SETS of strings a and b.
// J(A,B) = |A ∩ B| / |A ∪ B|.  Returns 1.0 if both sets are empty.
fn kmer_jaccard(a, b, k) -> float
    let ca = kmer_count(a, k)
    let cb = kmer_count(b, k)
    let ka = keys(ca)
    let na = len(ka)
    // Build union set and count intersection.
    let union_d = {}
    let inter = 0
    for i in 0..na
        let km = ka[i]
        union_d[km] = 1
    let kb = keys(cb)
    let nb = len(kb)
    for j in 0..nb
        let km = kb[j]
        if km in union_d
            inter += 1
        else
            union_d[km] = 1
    let union_size = len(keys(union_d))
    if union_size == 0
        return 1.0
    let inter_f = inter * 1.0
    let union_f = union_size * 1.0
    return inter_f / union_f

// kmer_contains: true iff kmer appears as a substring of s.
fn kmer_contains(s, kmer) -> bool
    let k = len(kmer)
    let total = kmer_total(s, k)
    let i = 0
    let found = false
    while i < total and not found
        let sub = ""
        for j in 0..k
            sub += char_at(s, i + j)
        if sub == kmer
            found = true
        i += 1
    return found

// kmer_positions: return a list of all start indices where kmer occurs in s.
fn kmer_positions(s, kmer) -> any
    let result = []
    let k = len(kmer)
    let total = kmer_total(s, k)
    for i in 0..total
        let sub_parts = []
        let j = 0
        while j < k
            push(sub_parts, char_at(s, i + j))
            j += 1
        let sub = join(sub_parts, "")
        if sub == kmer
            result.push(i)
    return result

// kmer_spectrum: return a sorted list of all distinct k-mers in s.
// Sorted lexicographically ascending.
fn kmer_spectrum(s, k) -> any
    let counts = kmer_count(s, k)
    let ks = keys(counts)
    // Copy into a mutable list for sorting.
    // Materialize dict keys as fresh strings via concatenation.
    let lst = []
    let i = 0
    let nk = len(ks)
    while i < nk
        lst.push(ks[i] + "")
        i += 1
    return _km_sort_strings(lst)
