// ============================================================================
// NOVA Standard Library — std/bio/codon
// ============================================================================
// Standard genetic code: codon table, translation, frame analysis.
//
// All 64 codons encoded as 3-letter uppercase DNA strings.
// Stop codons TAA, TAG, TGA encode to '*'.
//
// PUBLIC API:
//   codon_to_aa(codon)        -> string  3-letter DNA codon -> 1-letter AA
//   codon_is_start(codon)     -> bool    true iff codon == "ATG"
//   codon_is_stop(codon)      -> bool    true iff codon in {TAA,TAG,TGA}
//   translate(dna)            -> string  consecutive non-overlapping codons;
//                                        stop->append '*' and stop
//   translate_all_frames(dna) -> any     list of 3 forward-frame translations
//   aa_to_codons(aa)          -> any     list of codons encoding aa
//   codon_count(dna)          -> int     number of complete codons in dna
//   synonymous_codons(codon)  -> any     other codons for same AA
//   codon_gc3(dna)            -> float   GC content at 3rd codon positions
//   is_synonymous(c1,c2)      -> bool    true iff c1,c2 encode the same AA
//   codon_table_size()        -> int     64
//
// PREFIX: codon_ (private helpers _cdn_)
// ============================================================================

// _cdn_build_table: build the standard genetic code as a dict codon->AA.
// Standard NCBI table 1.  Stop codons -> '*'.
fn _cdn_build_table() -> any
    let t = {}
    // Phenylalanine F
    t["TTT"] = "F"
    t["TTC"] = "F"
    // Leucine L (TTA/TTG + CTX)
    t["TTA"] = "L"
    t["TTG"] = "L"
    t["CTT"] = "L"
    t["CTC"] = "L"
    t["CTA"] = "L"
    t["CTG"] = "L"
    // Isoleucine I
    t["ATT"] = "I"
    t["ATC"] = "I"
    t["ATA"] = "I"
    // Methionine M / start
    t["ATG"] = "M"
    // Valine V
    t["GTT"] = "V"
    t["GTC"] = "V"
    t["GTA"] = "V"
    t["GTG"] = "V"
    // Serine S (TCX + AGT/AGC)
    t["TCT"] = "S"
    t["TCC"] = "S"
    t["TCA"] = "S"
    t["TCG"] = "S"
    t["AGT"] = "S"
    t["AGC"] = "S"
    // Proline P
    t["CCT"] = "P"
    t["CCC"] = "P"
    t["CCA"] = "P"
    t["CCG"] = "P"
    // Threonine T
    t["ACT"] = "T"
    t["ACC"] = "T"
    t["ACA"] = "T"
    t["ACG"] = "T"
    // Alanine A
    t["GCT"] = "A"
    t["GCC"] = "A"
    t["GCA"] = "A"
    t["GCG"] = "A"
    // Tyrosine Y
    t["TAT"] = "Y"
    t["TAC"] = "Y"
    // Stop codons
    t["TAA"] = "*"
    t["TAG"] = "*"
    t["TGA"] = "*"
    // Histidine H
    t["CAT"] = "H"
    t["CAC"] = "H"
    // Glutamine Q
    t["CAA"] = "Q"
    t["CAG"] = "Q"
    // Asparagine N
    t["AAT"] = "N"
    t["AAC"] = "N"
    // Lysine K
    t["AAA"] = "K"
    t["AAG"] = "K"
    // Aspartate D
    t["GAT"] = "D"
    t["GAC"] = "D"
    // Glutamate E
    t["GAA"] = "E"
    t["GAG"] = "E"
    // Cysteine C
    t["TGT"] = "C"
    t["TGC"] = "C"
    // Tryptophan W
    t["TGG"] = "W"
    // Arginine R (CGX + AGA/AGG)
    t["CGT"] = "R"
    t["CGC"] = "R"
    t["CGA"] = "R"
    t["CGG"] = "R"
    t["AGA"] = "R"
    t["AGG"] = "R"
    // Serine S already added AGT/AGC above
    // Glycine G
    t["GGT"] = "G"
    t["GGC"] = "G"
    t["GGA"] = "G"
    t["GGG"] = "G"
    return t

// _cdn_table: module-level codon table (built lazily via call each time;
// NOVA has no module-level mutable globals, so we build per-call.
// The dict is small (64 entries) so cost is negligible.
fn _cdn_table() -> any
    return _cdn_build_table()

// codon_to_aa: map a 3-letter DNA codon to its 1-letter amino acid code.
// Stop codons (TAA, TAG, TGA) return '*'.
// Returns '?' for any unrecognised codon.
fn codon_to_aa(codon) -> string
    let t = _cdn_table()
    if contains(t, codon)
        return t[codon]
    return "?"

// codon_is_start: true iff codon is the start codon ATG.
fn codon_is_start(codon) -> bool
    return codon == "ATG"

// codon_is_stop: true iff codon is one of the three stop codons.
fn codon_is_stop(codon) -> bool
    return codon == "TAA" or codon == "TAG" or codon == "TGA"

// codon_count: number of complete (non-overlapping) codons in dna.
fn codon_count(dna) -> int
    return len(dna) / 3

// translate: translate dna left-to-right in non-overlapping triplets.
// Appends each amino acid; on a stop codon appends '*' and stops.
// Incomplete trailing bases (< 3) are ignored.
fn translate(dna) -> string
    let n = len(dna)
    let result_parts = []
    let i = 0
    let stopped = false
    while i + 2 < n and not stopped
        let c1 = char_at(dna, i)
        let c2 = char_at(dna, i + 1)
        let c3 = char_at(dna, i + 2)
        let codon = c1 + c2 + c3
        let aa = codon_to_aa(codon)
        push(result_parts, aa)
        if aa == "*"
            stopped = true
        i = i + 3
    let result = join(result_parts, "")
    return result

// translate_all_frames: return a list of 3 strings — one translation per
// forward reading frame (frame 0, 1, 2).
fn translate_all_frames(dna) -> any
    let frames = []
    for f in 0..3
        let sub_parts = []
        let n = len(dna)
        let i = f
        while i < n
            push(sub_parts, char_at(dna, i))
            i = i + 1
        let sub = join(sub_parts, "")
        frames.push(translate(sub))
    return frames

// aa_to_codons: return a list of all codons encoding the given amino acid.
// Uses the standard codon table.  Returns empty list for unknown AA.
fn aa_to_codons(aa) -> any
    let t = _cdn_table()
    let ks = keys(t)
    let nk = len(ks)
    let result = []
    let i = 0
    while i < nk
        let c = ks[i]
        if t[c] == aa
            result.push(c)
        i = i + 1
    return result

// synonymous_codons: return a list of OTHER codons that encode the same AA
// as the given codon (i.e., the codon's synonyms, excluding itself).
fn synonymous_codons(codon) -> any
    let aa = codon_to_aa(codon)
    let all = aa_to_codons(aa)
    let result = []
    let i = 0
    let n = len(all)
    while i < n
        if all[i] != codon
            result.push(all[i])
        i = i + 1
    return result

// codon_gc3: GC content at the 3rd codon position over all complete codons.
// Returns 0.0 if dna has fewer than 3 bases.
fn codon_gc3(dna) -> float
    let n = len(dna)
    let nc = n / 3
    if nc == 0
        return 0.0
    let gc = 0
    for i in 0..nc
        let pos = i * 3 + 2
        let c = char_at(dna, pos)
        if c == "G" or c == "C"
            gc = gc + 1
    let gc_f = gc * 1.0
    let nc_f = nc * 1.0
    return gc_f / nc_f

// is_synonymous: true iff c1 and c2 encode the same amino acid.
fn is_synonymous(c1, c2) -> bool
    return codon_to_aa(c1) == codon_to_aa(c2)

// codon_table_size: returns 64 (the number of entries in the standard table).
fn codon_table_size() -> int
    return 64
