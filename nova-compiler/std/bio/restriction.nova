// std/bio/restriction.nova — Restriction enzyme site finding and digestion.
// LEAF — imports NOTHING.
//
// Included enzymes (5 canonical):
//   EcoRI   GAATTC  (5' G^AATTC 3') — 4-base 5' overhang AATT
//   BamHI   GGATCC  (5' G^GATCC 3') — 4-base 5' overhang GATC
//   HindIII AAGCTT  (5' A^AGCTT 3') — 4-base 5' overhang AGCT
//   NotI    GCGGCCGC (5' GC^GGCCGC 3') — 4-base 5' overhang GGCC
//   PstI    CTGCAG  (5' CTGCA^G 3') — 4-base 3' overhang ACGT
//
// Palindrome check: a site is palindromic iff it equals its own reverse complement.
// Reverse complement: complement each base (A<->T, C<->G), then reverse.
//
// Cut convention for re_cut_positions: we return the index of the site start
// (left edge of the recognition sequence), which is the simplest deterministic
// cut model.  Callers needing enzyme-specific offsets should use the site start
// as an anchor.
//
// re_digest cuts at every occurrence of site (non-overlapping scanned left to
// right), splitting the DNA into fragments. Cutting at position p (site start)
// means the left fragment ends at p-1 and the right fragment begins at p+site_len.
// This yields (n_cuts + 1) fragments.
//
// API (prefix: re_):
//   re_enzymes()                 -> any   dict of name -> recognition site
//   re_site(name)                -> string  recognition site for named enzyme
//   re_find(dna,site)            -> any   list of 0-based start positions (all occurrences)
//   re_find_enzyme(dna,name)     -> any   re_find using named enzyme's site
//   re_cut_positions(dna,name)   -> any   same as re_find_enzyme (cut at site start)
//   re_digest(dna,site)          -> any   list of fragment strings
//   re_fragment_count(dna,site)  -> int   number of fragments after digestion
//   re_is_palindrome(site)       -> bool  site == revcomp(site)
//   re_count_sites(dna,name)     -> int   number of sites for enzyme in dna
//   re_overhang(name)            -> string  overhang sequence or '' if unknown
//   re_sites_in(dna)             -> any   list of enzyme names that cut dna
//   re_longest_fragment(dna,site)-> int   length of longest fragment after digestion

// _revcomp_base: complement of a single DNA base.
fn _revcomp_base(b) -> string
    if b == "A"
        return "T"
    if b == "T"
        return "A"
    if b == "C"
        return "G"
    if b == "G"
        return "C"
    return "N"

// _revcomp: reverse complement of a DNA string.
fn _revcomp(dna) -> string
    let n = len(dna)
    let result_parts = []
    let i = n - 1
    while i >= 0
        let b = slice(dna, i, i + 1)
        let cb = _revcomp_base(b)
        push(result_parts, cb)
        i = i - 1
    let result = join(result_parts, "")
    return result

// re_enzymes: dict mapping enzyme name -> recognition site.
fn re_enzymes() -> any
    let d = {}
    d["EcoRI"] = "GAATTC"
    d["BamHI"] = "GGATCC"
    d["HindIII"] = "AAGCTT"
    d["NotI"] = "GCGGCCGC"
    d["PstI"] = "CTGCAG"
    return d

// re_site: recognition sequence for a named enzyme; "" if not found.
fn re_site(name) -> string
    let d = re_enzymes()
    if contains(d, name)
        let s = d[name]
        return s
    return ""

// re_find: list of 0-based positions where site occurs in dna (all occurrences,
// including overlapping).
fn re_find(dna, site) -> any
    let positions = []
    let dn = len(dna)
    let sn = len(site)
    if sn == 0 or dn < sn
        return positions
    let i = 0
    while i <= dn - sn
        let sub = slice(dna, i, i + sn)
        if sub == site
            push(positions, i)
        i = i + 1
    return positions

// re_find_enzyme: list of cut positions for a named enzyme in dna.
fn re_find_enzyme(dna, name) -> any
    let site = re_site(name)
    if len(site) == 0
        let empty = []
        return empty
    let pos = re_find(dna, site)
    return pos

// re_cut_positions: same as re_find_enzyme (cut at site start by convention).
fn re_cut_positions(dna, name) -> any
    let pos = re_find_enzyme(dna, name)
    return pos

// re_digest: cut dna at every (non-overlapping, left-to-right) occurrence of
// site, returning the list of fragment strings.
// We scan for sites, track used positions to avoid overlapping cuts.
fn re_digest(dna, site) -> any
    let fragments = []
    let dn = len(dna)
    let sn = len(site)
    if sn == 0
        push(fragments, dna)
        return fragments
    let positions = re_find(dna, site)
    // filter to non-overlapping (greedy left-to-right)
    let cuts = []
    let last_cut = 0 - sn
    let pi = 0
    let pn = len(positions)
    while pi < pn
        let pos = positions[pi]
        if pos >= last_cut + sn
            push(cuts, pos)
            last_cut = pos
        pi = pi + 1
    // now build fragments: from last_end to cut, then from cut+sn onward
    let prev = 0
    let ci = 0
    let cn = len(cuts)
    while ci < cn
        let cut = cuts[ci]
        let frag = slice(dna, prev, cut)
        push(fragments, frag)
        prev = cut + sn
        ci = ci + 1
    // final fragment
    let last_frag = slice(dna, prev, dn)
    push(fragments, last_frag)
    return fragments

// re_fragment_count: number of fragments after digesting dna with site.
fn re_fragment_count(dna, site) -> int
    let frags = re_digest(dna, site)
    let c = len(frags)
    return c

// re_is_palindrome: true IFF the recognition site is a MOLECULAR palindrome:
// reverse_complement(site) == site.
// This is the correct restriction-enzymology definition.
// Examples: GAATTC->true, GGATCC->true, AATT->true, AAAA->false (revcomp=TTTT), ATGC->false.
fn re_is_palindrome(site) -> bool
    let rc = _revcomp(site)
    if site == rc
        return true
    return false

// re_count_sites: number of occurrences of enzyme's recognition site in dna.
fn re_count_sites(dna, name) -> int
    let positions = re_find_enzyme(dna, name)
    let c = len(positions)
    return c

// re_overhang: documented overhang for the enzyme, "" for unknown/blunt.
// Overhangs are the single-stranded tails after cutting (5' or 3').
fn re_overhang(name) -> string
    if name == "EcoRI"
        return "AATT"
    if name == "BamHI"
        return "GATC"
    if name == "HindIII"
        return "AGCT"
    if name == "NotI"
        return "GGCC"
    if name == "PstI"
        return "ACGT"
    return ""

// re_sites_in: list of enzyme names from re_enzymes() whose sites appear in dna.
fn re_sites_in(dna) -> any
    let found = []
    let d = re_enzymes()
    let names = ["EcoRI", "BamHI", "HindIII", "NotI", "PstI"]
    let i = 0
    let n = len(names)
    while i < n
        let name = names[i]
        let site = d[name]
        let positions = re_find(dna, site)
        if len(positions) > 0
            push(found, name)
        i = i + 1
    return found

// re_longest_fragment: length of the longest fragment after digesting dna with site.
fn re_longest_fragment(dna, site) -> int
    let frags = re_digest(dna, site)
    let nf = len(frags)
    if nf == 0
        return 0
    let maxlen = len(frags[0])
    for i in 1..nf
        let fl = len(frags[i])
        if fl > maxlen
            maxlen = fl
    return maxlen
