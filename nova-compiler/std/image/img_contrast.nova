// std/image/img_contrast.nova — Contrast adjustment and threshold on pixel lists.
//
// Image model: flat list of ints 0..255 (grayscale or single channel).
// All results clamped to [0, 255].
//
// API:
//   img_contrast(px, factor_pct) -> list   contrast around pivot 128:
//                                          new = clamp(128 + (p-128)*factor_pct/100)
//   img_threshold(px, level)     -> list   0 if p < level, else 255

// _con_clamp: clamp int to [0, 255]
fn _con_clamp(v: int) -> int
    let result = v
    if v < 0
        result = 0
    if v > 255
        result = 255
    result

// img_contrast: adjust contrast around the 128 pivot by factor_pct percent.
// factor_pct=100 is identity; 200 doubles contrast; 50 halves it.
// Uses integer arithmetic: new = clamp(128 + (p-128)*factor_pct/100).
fn img_contrast(px: list, factor_pct: int) -> list
    let out = []
    let n = len(px)
    for i in 0..n
        let p = px[i]
        let dev = p - 128
        let scaled = dev * factor_pct / 100
        let raw = 128 + scaled
        let c = _con_clamp(raw)
        out.push(c)
    out

// img_threshold: binarize — pixels below level become 0, level and above become 255.
fn img_threshold(px: list, level: int) -> list
    let out = []
    let n = len(px)
    for i in 0..n
        let p = px[i]
        let t = 0
        if p >= level
            t = 255
        out.push(t)
    out
