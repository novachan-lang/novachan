// std/image/img_composite.nova — Grayscale image compositing operations.
//
// IMAGE MODEL:
//   Grayscale image = flat list of ints 0..255 in row-major order.
//   All input lists must be the same length (same w x h).
//
// API:
//   img_blend(a, b, alpha_pct) -> list
//       Alpha blend: out[i] = a[i]*(100-alpha_pct)/100 + b[i]*alpha_pct/100, clamped.
//       alpha_pct=0 => pure a, alpha_pct=100 => pure b.
//   img_add(a, b) -> list
//       Per-pixel sum, clamped to 255.
//   img_subtract(a, b) -> list
//       Per-pixel difference a-b, clamped at 0 (floor is 0).
//   img_max(a, b) -> list
//       Per-pixel maximum.

// Internal: clamp int to [0, 255].
fn _ic_clamp(v: int) -> int
    let r = v
    if v < 0
        r = 0
    if v > 255
        r = 255
    r

// img_blend: alpha blend two same-size grayscale images.
// out[i] = a[i]*(100-alpha_pct)/100 + b[i]*alpha_pct/100, integer arithmetic, clamped.
fn img_blend(a: list, b: list, alpha_pct: int) -> list
    let n = len(a)
    let inv = 100 - alpha_pct
    let out = []
    let i = 0
    while i < n
        let av = a[i]
        let bv = b[i]
        let raw = av * inv / 100 + bv * alpha_pct / 100
        let pv = _ic_clamp(raw)
        out.push(pv)
        i = i + 1
    out

// img_add: per-pixel sum clamped to [0, 255].
fn img_add(a: list, b: list) -> list
    let n = len(a)
    let out = []
    let i = 0
    while i < n
        let av = a[i]
        let bv = b[i]
        let raw = av + bv
        let pv = _ic_clamp(raw)
        out.push(pv)
        i = i + 1
    out

// img_subtract: per-pixel a-b clamped at 0 (result in [0, 255]).
fn img_subtract(a: list, b: list) -> list
    let n = len(a)
    let out = []
    let i = 0
    while i < n
        let av = a[i]
        let bv = b[i]
        let raw = av - bv
        let pv = _ic_clamp(raw)
        out.push(pv)
        i = i + 1
    out

// img_max: per-pixel maximum.
fn img_max(a: list, b: list) -> list
    let n = len(a)
    let out = []
    let i = 0
    while i < n
        let av = a[i]
        let bv = b[i]
        let pv = av
        if bv > av
            pv = bv
        out.push(pv)
        i = i + 1
    out
