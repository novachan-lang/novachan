// std/image/img_resize.nova — Nearest-neighbor and bilinear resize for grayscale images.
//
// IMAGE MODEL: flat list of ints 0..255 in row-major order.
// Pixel at (row, col) is px[row*w + col].
//
// API:
//   img_resize_nearest(px, w, h, new_w, new_h) -> list  nearest-neighbor resize
//   img_resize_bilinear(px, w, h, new_w, new_h) -> list bilinear interpolation resize

// _clamp255: clamp an int to [0, 255]
fn _clamp255(v)
    if v < 0
        return 0
    if v > 255
        return 255
    v

// _ifloor: convert float to int (floor toward negative infinity)
// Uses float_to_int which truncates; for positive floats this is floor.
fn _ifloor(f)
    let i = float_to_int(f)
    i

// img_resize_nearest: scale image to new_w x new_h using nearest-neighbor sampling.
// For each output pixel (r, c), the source pixel is:
//   src_r = floor(r * h / new_h)
//   src_c = floor(c * w / new_w)
fn img_resize_nearest(px, w, h, new_w, new_h)
    let out = []
    let fh = h * 1.0
    let fw = w * 1.0
    let fnew_h = new_h * 1.0
    let fnew_w = new_w * 1.0
    let r = 0
    while r < new_h
        let fr = r * 1.0
        let src_rf = fr * fh
        let src_r_frac = src_rf / fnew_h
        let src_r = _ifloor(src_r_frac)
        // clamp src_r to [0, h-1]
        if src_r < 0
            src_r = 0
        if src_r >= h
            src_r = h - 1
        let c = 0
        while c < new_w
            let fc = c * 1.0
            let src_cf = fc * fw
            let src_c_frac = src_cf / fnew_w
            let src_c = _ifloor(src_c_frac)
            // clamp src_c to [0, w-1]
            if src_c < 0
                src_c = 0
            if src_c >= w
                src_c = w - 1
            let idx = src_r * w + src_c
            let v = px[idx]
            out.push(v)
            c += 1
        r += 1
    out

// img_resize_bilinear: scale image to new_w x new_h using bilinear interpolation.
// For each output pixel (r, c):
//   fy = (r + 0.5) * h / new_h - 0.5   (continuous source coordinate)
//   fx = (c + 0.5) * w / new_w - 0.5
//   y0 = floor(fy), y1 = y0+1, dy = fy - y0
//   x0 = floor(fx), x1 = x0+1, dx = fx - x0
//   bilinear = p(y0,x0)*(1-dy)*(1-dx) + p(y0,x1)*(1-dy)*dx
//            + p(y1,x0)*dy*(1-dx)     + p(y1,x1)*dy*dx
// Out-of-bounds samples are clamped to border.
fn _bilin_sample(px, w, h, row, col)
    // clamp and fetch pixel as float
    let r = row
    let c = col
    if r < 0
        r = 0
    if r >= h
        r = h - 1
    if c < 0
        c = 0
    if c >= w
        c = w - 1
    let idx = r * w + c
    let v = px[idx]
    let fv = v * 1.0
    fv

fn img_resize_bilinear(px, w, h, new_w, new_h)
    let out = []
    let fh = h * 1.0
    let fw = w * 1.0
    let fnew_h = new_h * 1.0
    let fnew_w = new_w * 1.0
    for r in 0..new_h
        let fr = r * 1.0
        // continuous source y: (r+0.5)*h/new_h - 0.5
        let ry = fr + 0.5
        let ry2 = ry * fh
        let fy = ry2 / fnew_h
        let fy2 = fy - 0.5
        let y0 = _ifloor(fy2)
        let y1 = y0 + 1
        let fy3 = y0 * 1.0
        let dy = fy2 - fy3
        let dy1 = 1.0 - dy
        let c = 0
        while c < new_w
            let fc = c * 1.0
            // continuous source x: (c+0.5)*w/new_w - 0.5
            let cx = fc + 0.5
            let cx2 = cx * fw
            let fx = cx2 / fnew_w
            let fx2 = fx - 0.5
            let x0 = _ifloor(fx2)
            let x1 = x0 + 1
            let fx3 = x0 * 1.0
            let dx = fx2 - fx3
            let dx1 = 1.0 - dx
            // fetch four neighbors (clamped)
            let p00 = _bilin_sample(px, w, h, y0, x0)
            let p01 = _bilin_sample(px, w, h, y0, x1)
            let p10 = _bilin_sample(px, w, h, y1, x0)
            let p11 = _bilin_sample(px, w, h, y1, x1)
            // bilinear interpolation
            let t00 = p00 * dy1
            let t01 = p01 * dy1
            let t10 = p10 * dy
            let t11 = p11 * dy
            let tt00 = t00 * dx1
            let tt01 = t01 * dx
            let tt10 = t10 * dx1
            let tt11 = t11 * dx
            let sum0 = tt00 + tt01
            let sum1 = tt10 + tt11
            let fval = sum0 + sum1
            // round to nearest int and clamp
            let fval2 = fval + 0.5
            let ival = _ifloor(fval2)
            let clamped = _clamp255(ival)
            out.push(clamped)
            c += 1
    out
