// std/image/img_convolve.nova — 3x3 convolution on grayscale images.
// LEAF — imports NOTHING.
//
// Image model: flat list of ints 0..255, row-major order.
// Pixel at (row, col) = px[row*w + col].
// Edge-clamping: out-of-bounds pixel coordinates are clamped to the nearest edge.
//
// Public API:
//   img_convolve(px, w, h, kernel9) -> list
//       Apply 3x3 kernel (9 ints/floats, row-major) to a grayscale image.
//       Sum is divided by the kernel sum if nonzero (normalised convolution).
//       Result is clamped to 0..255.
//   img_box_blur(px, w, h) -> list
//       3x3 box (averaging) blur — convenience wrapper around img_convolve.
//
// FLOAT HAZARDS obeyed:
//   * No multi-term float return — bind each intermediate to a named let.
//   * abs(float) returns i64 — use if/else for float abs.
//   * Integer division for ints, explicit *1.0 for float.
//   * Single-exit pattern on every fn.

// _icv_clamp — clamp int v to [0, 255].
fn _icv_clamp(v: int) -> int
    let r = v
    if v < 0
        r = 0
    if v > 255
        r = 255
    r

// _icv_pixel — return pixel at (row, col) with edge-clamp.
fn _icv_pixel(px: list, w: int, h: int, row: int, col: int) -> int
    let r = row
    let c = col
    if r < 0
        r = 0
    if r >= h
        r = h - 1
    if c < 0
        c = 0
    if c >= w
        c = w - 1
    px[r * w + c]

// img_convolve — apply 3x3 kernel to grayscale image px (w x h).
// kernel9 is a flat 9-element list (row-major).
// Divides accumulated sum by kernel sum if nonzero; clamps to 0..255.
fn img_convolve(px: list, w: int, h: int, kernel9: list) -> list
    // Compute kernel sum for normalisation.
    let ksum = 0
    let ki = 0
    while ki < 9
        let kv = kernel9[ki]
        ksum = ksum + kv
        ki = ki + 1
    let out = []
    let row = 0
    while row < h
        let col = 0
        while col < w
            // Accumulate 3x3 neighbourhood.
            let acc = 0.0
            let dr = -1
            while dr <= 1
                let dc = -1
                while dc <= 1
                    let kidx = (dr + 1) * 3 + (dc + 1)
                    let kval = kernel9[kidx] * 1.0
                    let pval = _icv_pixel(px, w, h, row + dr, col + dc) * 1.0
                    let contrib = kval * pval
                    acc = acc + contrib
                    dc = dc + 1
                dr = dr + 1
            // Normalise.
            let norm = acc
            if ksum != 0
                let ksumf = ksum * 1.0
                norm = acc / ksumf
            // Round and clamp.
            let rounded = float_to_int(norm + 0.5)
            let clamped = _icv_clamp(rounded)
            out.push(clamped)
            col = col + 1
        row = row + 1
    out

// img_box_blur — 3x3 averaging blur (uniform kernel, sum=9).
fn img_box_blur(px: list, w: int, h: int) -> list
    let k = []
    k.push(1)
    k.push(1)
    k.push(1)
    k.push(1)
    k.push(1)
    k.push(1)
    k.push(1)
    k.push(1)
    k.push(1)
    img_convolve(px, w, h, k)
