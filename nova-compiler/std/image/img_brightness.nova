// std/image/img_brightness.nova — Brightness and invert operations on pixel lists.
//
// Image model: flat list of ints 0..255 (grayscale or any single channel).
// All results clamped to [0, 255].
//
// API:
//   img_brightness(px, delta) -> list   add delta to each pixel, clamp 0..255
//   img_invert(px)            -> list   255 - p for each pixel

// _bri_clamp: clamp int to [0, 255]
fn _bri_clamp(v: int) -> int
    let result = v
    if v < 0
        result = 0
    if v > 255
        result = 255
    result

// img_brightness: add delta (positive or negative) to every pixel, clamped.
fn img_brightness(px: list, delta: int) -> list
    let out = []
    let n = len(px)
    for i in 0..n
        let p = px[i]
        let raw = p + delta
        let c = _bri_clamp(raw)
        out.push(c)
    out

// img_invert: compute 255 - p for every pixel.
fn img_invert(px: list) -> list
    let out = []
    let n = len(px)
    for i in 0..n
        let p = px[i]
        let inv = 255 - p
        out.push(inv)
    out
