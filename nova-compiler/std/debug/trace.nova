// ============================================================================
// NOVA Standard Library — std/debug/trace
// ============================================================================
// Execution trace helper: a lightweight, dependency-free call-tree logger.
// A trace is a plain dict — callers create one with dt_new() and pass it to
// every operation. Entries are pre-formatted, indented strings (two spaces
// per nesting level) so dt_dump() needs no further processing.
//
// Internal dict layout:
//   t["entries"] : list of string   already-formatted, indented log lines
//   t["depth"]   : int              current nesting depth (>= 0)
//
// Public API (prefix dt_):
//   dt_new()               -> dict    create a fresh, empty trace
//   dt_enter(t, fn_name)             log entry at current depth, THEN depth+1
//   dt_exit(t, fn_name)              depth-1 first, THEN log exit at new depth
//   dt_log(t, msg)                   log a plain message at current depth
//   dt_entries(t)           -> list   all logged lines, in order, as recorded
//   dt_depth(t)             -> int    current nesting depth
//   dt_dump(t)              -> string all entries joined with "\n"
//
// dt_enter/dt_exit are depth-symmetric by design: a matching enter/exit pair
// for the same call is logged at the SAME indentation level (the enter
// happens before incrementing; the exit happens after decrementing), so a
// dumped trace visually brackets nested calls like a call tree. dt_exit is
// guarded against underflow — calling it more times than dt_enter never
// takes depth below 0.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── private: build an indent string of n*2 spaces ────────────────────────────
fn _dt_indent(n: int) -> string
    let out_parts = []
    for i in 0..n
        push(out_parts, "  ")
    let out = join(out_parts, "")
    return out

// ── dt_new ────────────────────────────────────────────────────────────────────
// Returns a freshly initialised, empty trace log at depth 0.
fn dt_new() -> dict
    let t = {}
    t["entries"] = []
    t["depth"] = 0
    return t

// ── dt_enter ──────────────────────────────────────────────────────────────────
// Logs "-> fn_name" at the CURRENT depth, then increments depth by 1.
fn dt_enter(t: dict, fn_name: string)
    let depth = t["depth"]
    let entries = t["entries"]
    entries.push(_dt_indent(depth) + "-> " + fn_name)
    t["depth"] = depth + 1

// ── dt_exit ───────────────────────────────────────────────────────────────────
// Decrements depth by 1 first (never below 0), then logs "<- fn_name" at the
// new (decremented) depth — matching the depth dt_enter used for this call.
fn dt_exit(t: dict, fn_name: string)
    let depth = t["depth"]
    if depth > 0
        depth = depth - 1
    t["depth"] = depth
    let entries = t["entries"]
    entries.push(_dt_indent(depth) + "<- " + fn_name)

// ── dt_log ────────────────────────────────────────────────────────────────────
// Logs a plain message at the current depth (no depth change).
fn dt_log(t: dict, msg: string)
    let depth = t["depth"]
    let entries = t["entries"]
    entries.push(_dt_indent(depth) + msg)

// ── dt_entries ────────────────────────────────────────────────────────────────
// Returns all logged lines, in recorded order, exactly as stored.
fn dt_entries(t: dict) -> list
    return t["entries"]

// ── dt_depth ──────────────────────────────────────────────────────────────────
// Returns the current nesting depth (0 when no unmatched dt_enter is open).
fn dt_depth(t: dict) -> int
    return t["depth"]

// ── dt_dump ───────────────────────────────────────────────────────────────────
// Returns every entry joined by "\n" into a single formatted trace string.
// Returns "" for a trace with no entries.
fn dt_dump(t: dict) -> string
    return join(t["entries"], "\n")
