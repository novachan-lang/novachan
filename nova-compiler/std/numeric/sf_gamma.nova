// ============================================================================
// NOVA Standard Library — std/numeric/sf_gamma
// ============================================================================
// Gamma function via Lanczos approximation (g=7, 9-coefficient Spouge form).
//
// The Lanczos approximation computes Gamma(z) for z with real part > 0.5 as:
//   Gamma(z) = sqrt(2*pi) * ((z + g - 0.5) / e)^(z - 0.5) * A_g(z)
// where A_g(z) is a rational sum over the Lanczos coefficients c[k]:
//   A_g(z) = c[0] + sum_{k=1}^{N} c[k] / (z + k - 1)
//
// Reflection formula handles z < 0.5:
//   Gamma(z) = pi / (sin(pi*z) * Gamma(1-z))
//
// Public API (prefix gm_):
//   gamma(x) -> float       — Gamma(x), x > 0 real
//   ln_gamma(x) -> float    — log(Gamma(x)), numerically stable for large x
//   factorial_float(n) -> float — n! as float via gamma(n+1)
//
// All private helpers are prefixed _gm_.
// ============================================================================

// Lanczos g=7, coefficients from Numerical Recipes 3rd ed.
// p[0..8]: 9 coefficients for the Lanczos sum
fn _gm_lc0() -> float
    return 0.99999999999980993

fn _gm_lc1() -> float
    return 676.5203681218851

fn _gm_lc2() -> float
    return 0.0 - 1259.1392167224028

fn _gm_lc3() -> float
    return 771.32342877765313

fn _gm_lc4() -> float
    return 0.0 - 176.61502916214059

fn _gm_lc5() -> float
    return 12.507343278686905

fn _gm_lc6() -> float
    return 0.0 - 0.13857109526572012

fn _gm_lc7() -> float
    return 0.0000099843695780195716

fn _gm_lc8() -> float
    return 0.00000015056327351493116

// ln(sqrt(2*pi)) = 0.9189385332046727
fn _gm_ln_sqrt_2pi() -> float
    return 0.9189385332046727

// pi
fn _gm_pi() -> float
    return 3.141592653589793

// Lanczos sum: c0 + sum_{k=1}^{8} c[k]/(x+k)
// x is shifted: caller passes z-1 so we compute for z in standard form
fn _gm_sum(z) -> float
    let zf = z * 1.0
    let s = _gm_lc0()
    let d1 = zf + 1.0
    let v1 = _gm_lc1() / d1
    s = s + v1
    let d2 = zf + 2.0
    let v2 = _gm_lc2() / d2
    s = s + v2
    let d3 = zf + 3.0
    let v3 = _gm_lc3() / d3
    s = s + v3
    let d4 = zf + 4.0
    let v4 = _gm_lc4() / d4
    s = s + v4
    let d5 = zf + 5.0
    let v5 = _gm_lc5() / d5
    s = s + v5
    let d6 = zf + 6.0
    let v6 = _gm_lc6() / d6
    s = s + v6
    let d7 = zf + 7.0
    let v7 = _gm_lc7() / d7
    s = s + v7
    let d8 = zf + 8.0
    let v8 = _gm_lc8() / d8
    s = s + v8
    return s

// ln_gamma(x): log-Gamma for x > 0.
// Uses Lanczos: ln(Gamma(z)) = ln(sqrt(2pi)) + (z-0.5)*ln(z+g-0.5) - (z+g-0.5) + ln(A_g(z))
// g=7.5 (i.e., g=7, shift by 7.5)
fn ln_gamma(x) -> float
    let xf = x * 1.0
    let z = xf
    // Reflection for z < 0.5 not needed for ln_gamma in typical usage (x>0 required)
    let zm1 = z - 1.0
    let lsum = log(_gm_sum(zm1))
    let base = zm1 + 7.5
    let lbase = log(base)
    let t1 = (zm1 + 0.5) * lbase
    let t2 = 0.0 - base
    let result = _gm_ln_sqrt_2pi() + t1 + t2 + lsum
    return result

// gamma(x): Gamma function for real x.
// Uses reflection formula for x < 0.5.
fn gamma(x) -> float
    let xf = x * 1.0
    if xf < 0.5
        // Reflection: Gamma(x) = pi / (sin(pi*x) * Gamma(1-x))
        let pix = _gm_pi() * xf
        let sp = sin(pix)
        let lg = ln_gamma(1.0 - xf)
        let eg = exp(lg)
        let denom = sp * eg
        let result = _gm_pi() / denom
        return result
    let lg = ln_gamma(xf)
    let result = exp(lg)
    return result

// factorial_float(n): n! as a float, computed as gamma(n+1).
// Accurate for small integer n; for large n use ln_gamma.
fn factorial_float(n) -> float
    let nf = n * 1.0
    let arg = nf + 1.0
    let result = gamma(arg)
    return result
