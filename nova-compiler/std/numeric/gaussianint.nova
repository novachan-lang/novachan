// ============================================================================
// NOVA Standard Library — Gaussian Integers
// std/numeric/gaussianint.nova
// ============================================================================
// A Gaussian integer is a complex number a+bi where a,b are integers.
// Represented as a dict {"re": a, "im": b}.
// All arithmetic is exact integer arithmetic — no floats involved.
//
// Public API (prefix gi_):
//   gi_new(re, im)        -> dict
//   gi_add(x, y)          -> dict
//   gi_sub(x, y)          -> dict
//   gi_mul(x, y)          -> dict
//   gi_conj(x)            -> dict   (conjugate: a-bi)
//   gi_norm(x)            -> int    (re*re + im*im, always >= 0)
//   gi_eq(x, y)           -> bool   (structural equality)
//   gi_str(x)             -> string (pretty form: "a+bi", "a-bi", "a", "bi")
// ============================================================================

fn gi_new(re, im)
    let d = {}
    d["re"] = re
    d["im"] = im
    return d

fn gi_add(x, y)
    let d = {}
    d["re"] = x["re"] + y["re"]
    d["im"] = x["im"] + y["im"]
    return d

fn gi_sub(x, y)
    let d = {}
    d["re"] = x["re"] - y["re"]
    d["im"] = x["im"] - y["im"]
    return d

// (a+bi)(c+di) = (ac-bd) + (ad+bc)i
fn gi_mul(x, y)
    let a = x["re"]
    let b = x["im"]
    let c = y["re"]
    let dd = y["im"]
    let re = a * c - b * dd
    let im = a * dd + b * c
    let r = {}
    r["re"] = re
    r["im"] = im
    return r

fn gi_conj(x)
    let d = {}
    d["re"] = x["re"]
    d["im"] = 0 - x["im"]
    return d

// Norm = re^2 + im^2 (always a non-negative integer)
fn gi_norm(x)
    let a = x["re"]
    let b = x["im"]
    return a * a + b * b

fn gi_eq(x, y)
    if x["re"] == y["re"]
        if x["im"] == y["im"]
            return 1
    return 0

// Pretty-print:
//   re=0, im=0  -> "0"
//   re=0, im=1  -> "i"
//   re=0, im=-1 -> "-i"
//   re=0, im=k  -> "ki"  (k != 0, 1, -1)
//   re!=0, im=0 -> "a"
//   re!=0, im=1 -> "a+i"
//   re!=0, im=-1-> "a-i"
//   re!=0, im>0 -> "a+bi"
//   re!=0, im<0 -> "a-bi" (b shown as positive magnitude)
fn gi_str(x)
    let a = x["re"]
    let b = x["im"]
    // pure zero
    if a == 0
        if b == 0
            return "0"
    // purely imaginary (re == 0, im != 0)
    if a == 0
        if b == 1
            return "i"
        if b == 0 - 1
            return "-i"
        return str(b) + "i"
    // purely real (im == 0)
    if b == 0
        return str(a)
    // both nonzero — handle sign of imaginary part
    if b == 1
        return str(a) + "+i"
    if b == 0 - 1
        return str(a) + "-i"
    if b > 0
        return str(a) + "+" + str(b) + "i"
    // b < 0: negate for display, use minus sign
    let neg_b = 0 - b
    return str(a) + "-" + str(neg_b) + "i"
