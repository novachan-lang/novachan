// ============================================================================
// NOVA Standard Library — std/numeric/dist_uniform
// ============================================================================
// Continuous uniform distribution on [a, b].
//
// Public API (prefix uni_):
//   uni_pdf(x, a, b) -> float   — probability density at x
//   uni_cdf(x, a, b) -> float   — cumulative probability P(X <= x)
//   uni_mean(a, b)   -> float   — mean = (a + b) / 2
//   uni_var(a, b)    -> float   — variance = (b - a)^2 / 12
//
// Formulas:
//   pdf(x; a,b) = 1/(b-a)  for a <= x <= b, else 0
//   cdf(x; a,b) = 0               for x < a
//              = (x-a)/(b-a)      for a <= x <= b
//              = 1                for x > b
//   mean        = (a + b) / 2
//   variance    = (b - a)^2 / 12
// ============================================================================

fn uni_pdf(x, a, b) -> float
    let xf = x * 1.0
    let af = a * 1.0
    let bf = b * 1.0
    if xf < af
        return 0.0
    if xf > bf
        return 0.0
    let width = bf - af
    let result = 1.0 / width
    return result

fn uni_cdf(x, a, b) -> float
    let xf = x * 1.0
    let af = a * 1.0
    let bf = b * 1.0
    if xf < af
        return 0.0
    if xf > bf
        return 1.0
    let num = xf - af
    let denom = bf - af
    let result = num / denom
    return result

fn uni_mean(a, b) -> float
    let af = a * 1.0
    let bf = b * 1.0
    let result = (af + bf) / 2.0
    return result

fn uni_var(a, b) -> float
    let af = a * 1.0
    let bf = b * 1.0
    let width = bf - af
    let result = (width * width) / 12.0
    return result
