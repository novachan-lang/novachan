// ============================================================================
// NOVA Standard Library — Bisection Root-Finding
// std/numeric/bisection.nova
// ============================================================================
// Classical bisection method for finding a root of a continuous function f
// on an interval [a, b] where f(a) and f(b) have opposite signs.
//
// Public API (prefix bs_):
//   bs_root(f, a, b, tol)        -> float  root via bisection until |b-a| < tol
//   bs_root_iters(f, a, b, max)  -> float  root via bisection for at most max iterations
//   bs_has_root(f, a, b)         -> bool   true iff f(a) and f(b) have opposite signs
//
// All private helpers are prefixed _bs_ to avoid namespace collisions.
// Implementation notes:
//   - NOVA `let` inside an if-body creates a NEW scoped binding (does NOT update outer).
//     To update an outer variable use plain reassignment (var = value).
//   - The NOVA LLVM-label bug: do NOT plain-reassign a plain local inside
//     a nested if inside a while — only dict field updates are safe there.
//     Solution: store mutable bisection state in a dict throughout the loops.
// ============================================================================

// bs_has_root: returns true (1) iff f(a) and f(b) have strictly opposite signs.
// Uses nested if-returns to avoid any variable reassignment inside if-bodies.
//
// NOVA note: when f is passed as a function parameter, f(x) returns the raw i64
// bit-pattern of the float result (negative floats => MSB set => bit-pattern < 0).
// We compare against integer 0 (not float 0.0) because:
//   - float bit-patterns: negative float => negative i64 bit-pattern (MSB=sign)
//   - direct float calls: negative float value is also numerically < 0
// Both cases handled correctly by comparing against integer 0.
fn bs_has_root(f, a, b) -> bool
    // Route a and b through a dict to ensure proper float unboxing before
    // passing to f. Direct locals or inline `a * 1.0` expressions may pass
    // boxed float pointers through the any ABI; dict reads (nova_rt_dict_get)
    // always unbox to the proper float value.
    let p = {}
    p["a"] = a * 1.0
    p["b"] = b * 1.0
    let fa = f(p["a"])
    let fb = f(p["b"])
    // fa and fb are properly unboxed floats from f's return. Compare to 0 (int)
    // not 0.0 (float) because the function-parameter ABI may return raw i64
    // float bit-patterns; negative IEEE 754 floats have MSB=1 => bit-pattern < 0.
    if fa < 0
        if fb >= 0
            return 1
    if fa >= 0
        if fb < 0
            return 1
    return 0

// bs_root: bisection root-finding, iterates until interval width < tol.
// Precondition: f(a) and f(b) must have opposite signs.
// Returns the midpoint of the final bracket as the root estimate.
//
// State is kept in a dict (st) so dict field mutation is safe inside while+if.
// Invariant: root is always in [st["lo"], st["hi"]], and st["fa"] = f(st["lo"]).
fn bs_root(f, a, b, tol) -> float
    let st = {}
    st["lo"] = a * 1.0
    st["hi"] = b * 1.0
    st["fa"] = f(a * 1.0)
    st["done"] = 0
    while st["done"] == 0
        let lo = st["lo"]
        let hi = st["hi"]
        let fa = st["fa"]
        // lo <= hi is invariant (we only narrow inward), so width = hi-lo >= 0
        let width = hi - lo
        if width < tol
            st["done"] = 1
        if st["done"] == 0
            let m = lo + (hi - lo) * 0.5
            let fm = f(m)
            // if fa and fm have opposite signs, root is in [lo, m]
            // else root is in [m, hi]
            if fa < 0.0
                if fm >= 0.0
                    st["hi"] = m
                if fm < 0.0
                    st["lo"] = m
                    st["fa"] = fm
            if fa >= 0.0
                if fm < 0.0
                    st["hi"] = m
                if fm >= 0.0
                    st["lo"] = m
                    st["fa"] = fm
    let lo2 = st["lo"]
    let hi2 = st["hi"]
    let result = lo2 + (hi2 - lo2) * 0.5
    return result

// bs_root_iters: bisection root-finding, iterates at most maxiter times.
// Returns the midpoint of the final bracket.
// Same dict-based state strategy as bs_root to avoid LLVM label bug.
fn bs_root_iters(f, a, b, maxiter) -> float
    let st = {}
    st["lo"] = a * 1.0
    st["hi"] = b * 1.0
    st["fa"] = f(a * 1.0)
    let i = 0
    while i < maxiter
        let lo = st["lo"]
        let hi = st["hi"]
        let fa = st["fa"]
        let m = lo + (hi - lo) * 0.5
        let fm = f(m)
        if fa < 0.0
            if fm >= 0.0
                st["hi"] = m
            if fm < 0.0
                st["lo"] = m
                st["fa"] = fm
        if fa >= 0.0
            if fm < 0.0
                st["hi"] = m
            if fm >= 0.0
                st["lo"] = m
                st["fa"] = fm
        let i = i + 1
    let lo2 = st["lo"]
    let hi2 = st["hi"]
    let result = lo2 + (hi2 - lo2) * 0.5
    return result

fn main()
    print("bisection module OK")
