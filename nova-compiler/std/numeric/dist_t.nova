// ============================================================================
// NOVA Standard Library — std/numeric/dist_t
// ============================================================================
// Student's t-distribution with df degrees of freedom.
//
// The t-distribution models the mean of a normally-distributed sample
// when the population variance is unknown. With large df it converges to
// the standard normal distribution.
//
// Public API (prefix t_):
//   t_pdf(x, df) -> float   — probability density at x
//   t_cdf(x, df) -> float   — cumulative probability P(X <= x), via numerical integration
//
// Implementation notes:
//   - Gamma function via Lanczos approximation (g=7, 9 coefficients) — FULLY INLINED
//     into _td_ln_gamma to avoid any float-return-from-function ABI issues.
//   - ln_gamma used for numerical stability in t_pdf
//   - t_cdf integrates t_pdf from -50 to x using Simpson's composite rule (N=2000 steps)
//   - All private helpers prefixed _td_
// ============================================================================

// ln_gamma(x) for x > 0 via Lanczos g=7 (9 coefficients), fully inlined.
// All arithmetic uses float literals directly — no helper fn calls that could
// suffer the NOVA float-return-as-raw-bits issue.
fn _td_ln_gamma(x) -> float
    let xf = x * 1.0
    let zm1 = xf - 1.0
    // Compute Lanczos sum: denominator denominators are (zm1+1) .. (zm1+8)
    let z = zm1 * 1.0
    let c2 = 0.0 - 1259.1392167224028
    let c4 = 0.0 - 176.61502916214059
    let c6 = 0.0 - 0.13857109526572012
    let d1 = z + 1.0
    let d2 = z + 2.0
    let d3 = z + 3.0
    let d4 = z + 4.0
    let d5 = z + 5.0
    let d6 = z + 6.0
    let d7 = z + 7.0
    let d8 = z + 8.0
    let s = 0.99999999999980993
    s += 676.5203681218851 / d1
    s += c2 / d2
    s += 771.32342877765313 / d3
    s += c4 / d4
    s += 12.507343278686905 / d5
    s += c6 / d6
    s += 0.0000099843695780195716 / d7
    s += 0.00000015056327351493116 / d8
    // log(s): s is a local float variable — no ABI issue
    let ls = log(s)
    let base = zm1 + 7.5
    let lbase = log(base)
    let t1 = (zm1 + 0.5) * lbase
    let t2 = 0.0 - base
    // 0.9189385332046727 = ln(sqrt(2*pi))
    let result = 0.9189385332046727 + t1 + t2 + ls
    return result

// ---------------------------------------------------------------------------
// t_pdf: probability density of Student's t at x with df degrees of freedom
//
// Formula (log-space for numerical stability):
//   ln(pdf) = lgamma((df+1)/2) - lgamma(df/2) - 0.5*ln(df*pi)
//             - ((df+1)/2) * ln(1 + x^2/df)
// ---------------------------------------------------------------------------
fn t_pdf(x, df) -> float
    let xf = x * 1.0
    let dff = df * 1.0
    let pi = 3.14159265358979

    // half degrees of freedom
    let half_dfp1 = (dff + 1.0) / 2.0
    let half_df = dff / 2.0

    // log normalisation constant: lgamma((df+1)/2) - lgamma(df/2) - 0.5*ln(df*pi)
    let lg1_r = _td_ln_gamma(half_dfp1)
    let lg1 = lg1_r * 1.0
    let lg2_r = _td_ln_gamma(half_df)
    let lg2 = lg2_r * 1.0
    let dfpi = dff * pi
    let ln_dfpi = log(dfpi)
    let ln_norm = lg1 - lg2 - 0.5 * ln_dfpi

    // log kernel: -((df+1)/2) * ln(1 + x^2/df)
    let x2_over_df = (xf * xf) / dff
    let inner = 1.0 + x2_over_df
    let ln_inner = log(inner)
    let ln_kern = 0.0 - half_dfp1 * ln_inner

    let ln_pdf = ln_norm + ln_kern
    let result = exp(ln_pdf)
    return result

// ---------------------------------------------------------------------------
// t_cdf: cumulative distribution function via numerical integration
//
// Integrates t_pdf from -50.0 to x using composite Simpson's rule.
// N=2000 subintervals gives tolerance well under 0.001.
//
// For x far in the left tail (x < -50) we return 0.0.
// For x far in the right tail (x > 50) we return 1.0.
// ---------------------------------------------------------------------------
fn t_cdf(x, df) -> float
    let xf = x * 1.0
    let lower = 0.0 - 50.0

    // Tail clamps
    if xf <= lower
        return 0.0
    if xf >= 50.0
        return 1.0

    // Simpson's composite rule: N must be even
    // Use N=2000 steps from lower to xf
    let n = 2000
    let h = (xf - lower) / (n * 1.0)

    // f(lower) + f(x)
    let fa_r = t_pdf(lower, df)
    let fa = fa_r * 1.0
    let fb_r = t_pdf(xf, df)
    let fb = fb_r * 1.0
    let total = fa + fb

    // Interior points: odd indices get weight 4, even get weight 2
    let i = 1
    let done = 0
    while done == 0
        let xi = lower + i * 1.0 * h
        let fi_r = t_pdf(xi, df)
        let fi = fi_r * 1.0
        // Check if i is odd (weight 4) or even (weight 2)
        let half_i = i / 2
        let twice_half = half_i * 2
        if twice_half == i
            // i is even -> weight 2
            total += 2.0 * fi
        if twice_half != i
            // i is odd -> weight 4
            total += 4.0 * fi
        i += 1
        if i >= n
            done = 1

    let result = total * h / 3.0
    return result
