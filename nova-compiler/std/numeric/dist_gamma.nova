// ============================================================================
// NOVA Standard Library — std/numeric/dist_gamma
// ============================================================================
// Gamma distribution (shape k, rate lambda).
//
// Public API:
//   gamma_pdf(x, shape, rate)  -> float  — probability density function
//   gamma_cdf(x, shape, rate)  -> float  — cumulative distribution function
//   gamma_mean(shape, rate)    -> float  — mean = shape/rate
//
// PDF: f(x; k, lambda) = lambda^k * x^(k-1) * exp(-lambda*x) / Gamma(k)  for x > 0
// Written in log-space to avoid overflow:
//   ln f = k*ln(lambda) + (k-1)*ln(x) - lambda*x - ln_gamma(k)
//
// When shape=1 (exponential): f(x; 1, lambda) = lambda * exp(-lambda*x)
//
// CDF: numerically integrated via Simpson's rule (n=600 steps).
//      Upper integration bound chosen to capture ~99.9% of distribution mass.
//
// Inline Lanczos gamma function (g=7, 9 coefficients) — no external import.
//
// All private helpers prefixed _gd_.
// ============================================================================

// --- Inline Lanczos gamma approximation (g=7, Numerical Recipes coefficients) ---

fn _gd_lc0() -> float
    return 0.99999999999980993

fn _gd_lc1() -> float
    return 676.5203681218851

fn _gd_lc2() -> float
    return 0.0 - 1259.1392167224028

fn _gd_lc3() -> float
    return 771.32342877765313

fn _gd_lc4() -> float
    return 0.0 - 176.61502916214059

fn _gd_lc5() -> float
    return 12.507343278686905

fn _gd_lc6() -> float
    return 0.0 - 0.13857109526572012

fn _gd_lc7() -> float
    return 0.0000099843695780195716

fn _gd_lc8() -> float
    return 0.00000015056327351493116

fn _gd_ln_sqrt_2pi() -> float
    return 0.9189385332046727

fn _gd_pi() -> float
    return 3.14159265358979

fn _gd_lsum(zm1) -> float
    let z = zm1 * 1.0
    let c0 = _gd_lc0()
    let s = c0 * 1.0
    let c1 = _gd_lc1()
    let d1 = z + 1.0
    let v1 = c1 / d1
    s += v1
    let c2 = _gd_lc2()
    let d2 = z + 2.0
    let v2 = c2 / d2
    s += v2
    let c3 = _gd_lc3()
    let d3 = z + 3.0
    let v3 = c3 / d3
    s += v3
    let c4 = _gd_lc4()
    let d4 = z + 4.0
    let v4 = c4 / d4
    s += v4
    let c5 = _gd_lc5()
    let d5 = z + 5.0
    let v5 = c5 / d5
    s += v5
    let c6 = _gd_lc6()
    let d6 = z + 6.0
    let v6 = c6 / d6
    s += v6
    let c7 = _gd_lc7()
    let d7 = z + 7.0
    let v7 = c7 / d7
    s += v7
    let c8 = _gd_lc8()
    let d8 = z + 8.0
    let v8 = c8 / d8
    s += v8
    return s

// ln_gamma(x) for x > 0 via Lanczos
fn _gd_ln_gamma(x) -> float
    let xf = x * 1.0
    let zm1 = xf - 1.0
    let raw_sum = _gd_lsum(zm1)
    let sumf = raw_sum * 1.0
    let ls = log(sumf)
    let base = zm1 + 7.5
    let lbase = log(base)
    let shift = zm1 + 0.5
    let t1 = shift * lbase
    let t2 = 0.0 - base
    let lsp2 = _gd_ln_sqrt_2pi()
    let result = lsp2 + t1 + t2 + ls
    return result

// --- Public API ---

// gamma_pdf: gamma distribution probability density at x.
// shape > 0, rate > 0. Returns 0.0 for x < 0.
// ln f = shape*ln(rate) + (shape-1)*ln(x) - rate*x - ln_gamma(shape)
fn gamma_pdf(x, shape, rate) -> float
    let xf = x * 1.0
    let kf = shape * 1.0
    let lf = rate * 1.0
    if xf < 0.0
        return 0.0
    if xf == 0.0
        // shape > 1: pdf(0) = 0
        // shape < 1: pdf(0) -> inf (return 0 for safety)
        return 0.0
    // Bind float from user fn-return before arithmetic (NOVA float-ABI rule)
    let raw_lng = _gd_ln_gamma(kf)
    let lng = raw_lng * 1.0
    let llf = log(lf)
    let lx = log(xf)
    let km1 = kf - 1.0
    let t1 = kf * llf
    let t2 = km1 * lx
    let t3 = lf * xf
    let exponent = t1 + t2 - t3 - lng
    let result = exp(exponent)
    return result

// gamma_mean: mean of gamma distribution = shape/rate.
fn gamma_mean(shape, rate) -> float
    let kf = shape * 1.0
    let lf = rate * 1.0
    let result = kf / lf
    return result

// gamma_cdf: cumulative distribution function via Simpson's rule.
// Integrates gamma_pdf from 0+ to x. n=600 steps.
fn gamma_cdf(x, shape, rate) -> float
    let xf = x * 1.0
    let kf = shape * 1.0
    let lf = rate * 1.0
    if xf <= 0.0
        return 0.0
    let n = 600
    let nf = n * 1.0
    // Start just above 0 to avoid singularity at x=0 when shape < 1
    let eps = xf / (nf * 1000.0)
    let lo = eps
    let hi = xf
    let h = (hi - lo) / nf
    let st = {}
    st["sum"] = 0.0
    st["i"] = 0
    while st["i"] <= n
        let i = st["i"]
        let if2 = i * 1.0
        let xi = lo + if2 * h
        // Call public gamma_pdf (crosses the public-fn boundary for correct float ABI)
        let fi = gamma_pdf(xi, kf, lf)
        let fif = fi * 1.0
        if i == 0
            st["sum"] += fif
        if i == n
            st["sum"] += fif
        if i > 0 and i < n
            let imod = i - (i / 2) * 2
            if imod == 1
                let term = 4.0 * fif
                st["sum"] += term
            if imod == 0
                let term = 2.0 * fif
                st["sum"] += term
        st["i"] = i + 1
    let total = st["sum"]
    let totalf = total * 1.0
    let h3 = h / 3.0
    let result = h3 * totalf
    if result > 1.0
        result = 1.0
    if result < 0.0
        result = 0.0
    return result
