// ============================================================================
// NOVA Standard Library — std/numeric/dist_weibull
// ============================================================================
// Weibull distribution: a two-parameter distribution on [0, infinity).
// Parameterized by shape k > 0 and scale lambda > 0.
//
// Special case: shape=1 gives the Exponential distribution with rate 1/scale.
//
// PDF: weibull_pdf(x, k, lam) =
//        (k/lam) * (x/lam)^(k-1) * exp(-(x/lam)^k)   x >= 0
//        0.0                                             x < 0
//
// CDF: weibull_cdf(x, k, lam) =
//        1 - exp(-(x/lam)^k)   x >= 0
//        0.0                    x < 0
//
// Mean: weibull_mean(k, lam) = lam * Gamma(1 + 1/k)
//   where Gamma is computed via Lanczos approximation (g=7, 9 coefficients)
//
// Note: weibull_cdf(lam, k, lam) = 1 - 1/e ~= 0.6321 for any k > 0.
//   (since (lam/lam)^k = 1, CDF = 1-e^{-1})
//
// Public API:
//   weibull_pdf(x, shape, scale)    -> float
//   weibull_cdf(x, shape, scale)    -> float
//   weibull_mean(shape, scale)      -> float
//
// Private helpers prefixed _dw_.
// ============================================================================

// ---- Inlined Lanczos gamma (g=7, 9 coefficients) ---- //

fn _dw_lc0() -> float
    return 0.99999999999980993

fn _dw_lc1() -> float
    return 676.5203681218851

fn _dw_lc2() -> float
    return 0.0 - 1259.1392167224028

fn _dw_lc3() -> float
    return 771.32342877765313

fn _dw_lc4() -> float
    return 0.0 - 176.61502916214059

fn _dw_lc5() -> float
    return 12.507343278686905

fn _dw_lc6() -> float
    return 0.0 - 0.13857109526572012

fn _dw_lc7() -> float
    return 0.0000099843695780195716

fn _dw_lc8() -> float
    return 0.00000015056327351493116

fn _dw_ln_sqrt_2pi() -> float
    return 0.9189385332046727

// Lanczos rational sum (z = x - 1, x is the gamma argument)
fn _dw_lsum(z) -> float
    let zf = z * 1.0
    let s = _dw_lc0()
    let d1 = zf + 1.0
    let v1 = _dw_lc1() / d1
    s += v1
    let d2 = zf + 2.0
    let v2 = _dw_lc2() / d2
    s += v2
    let d3 = zf + 3.0
    let v3 = _dw_lc3() / d3
    s += v3
    let d4 = zf + 4.0
    let v4 = _dw_lc4() / d4
    s += v4
    let d5 = zf + 5.0
    let v5 = _dw_lc5() / d5
    s += v5
    let d6 = zf + 6.0
    let v6 = _dw_lc6() / d6
    s += v6
    let d7 = zf + 7.0
    let v7 = _dw_lc7() / d7
    s += v7
    let d8 = zf + 8.0
    let v8 = _dw_lc8() / d8
    s += v8
    return s

// ln_gamma(x) for x > 0 via Lanczos
fn _dw_ln_gamma(x) -> float
    let xf = x * 1.0
    let zm1 = xf - 1.0
    let sum_raw = _dw_lsum(zm1)
    let sum_f = pow(sum_raw, 1.0)
    let lsum_raw = log(sum_f)
    let lsum = pow(lsum_raw, 1.0)
    let base = zm1 + 7.5
    let lbase_raw = log(base)
    let lbase = pow(lbase_raw, 1.0)
    let t1 = (zm1 + 0.5) * lbase
    let t2 = 0.0 - base
    let result = _dw_ln_sqrt_2pi() + t1 + t2 + lsum
    return result

// gamma_fn(x): Gamma(x) = exp(ln_gamma(x)) for x > 0
fn _dw_gamma_fn(x) -> float
    let xf = x * 1.0
    let lg_raw = _dw_ln_gamma(xf)
    let lg = pow(lg_raw, 1.0)
    let result_raw = exp(lg)
    let result = pow(result_raw, 1.0)
    return result

// ---- Weibull distribution core ---- //

// weibull_pdf(x, shape, scale): PDF of Weibull(shape=k, scale=lam) at x.
// Returns 0.0 for x < 0.
fn weibull_pdf(x, shape, scale) -> float
    let xf = x * 1.0
    let kf = shape * 1.0
    let lf = scale * 1.0
    if xf < 0.0
        return 0.0
    if xf == 0.0
        // PDF at x=0: 0 for k>1, 1/lam for k=1, inf for k<1
        // For k>1 (common case), return 0; avoid division issues
        return 0.0
    // Compute (x/lam)
    let xl = xf / lf
    // xl^(k-1): use pow
    let km1 = kf - 1.0
    let xl_km1_raw = pow(xl, km1)
    let xl_km1 = pow(xl_km1_raw, 1.0)
    // xl^k: use pow
    let xl_k_raw = pow(xl, kf)
    let xl_k = pow(xl_k_raw, 1.0)
    // exp(-xl^k)
    let neg_xl_k = 0.0 - xl_k
    let exp_raw = exp(neg_xl_k)
    let expv = pow(exp_raw, 1.0)
    // PDF = (k/lam) * xl^(k-1) * exp(-xl^k)
    let kl = kf / lf
    let result = kl * xl_km1 * expv
    return result

// weibull_cdf(x, shape, scale): CDF of Weibull(shape=k, scale=lam) at x.
// CDF = 1 - exp(-(x/lam)^k) for x >= 0, 0 for x < 0.
fn weibull_cdf(x, shape, scale) -> float
    let xf = x * 1.0
    let kf = shape * 1.0
    let lf = scale * 1.0
    if xf < 0.0
        return 0.0
    if xf == 0.0
        return 0.0
    let xl = xf / lf
    let xl_k_raw = pow(xl, kf)
    let xl_k = pow(xl_k_raw, 1.0)
    let neg_xl_k = 0.0 - xl_k
    let exp_raw = exp(neg_xl_k)
    let expv = pow(exp_raw, 1.0)
    let result = 1.0 - expv
    return result

// weibull_mean(shape, scale): mean of Weibull(k, lam) = lam * Gamma(1 + 1/k).
fn weibull_mean(shape, scale) -> float
    let kf = shape * 1.0
    let lf = scale * 1.0
    let arg = 1.0 + 1.0 / kf
    let g_raw = _dw_gamma_fn(arg)
    let g = pow(g_raw, 1.0)
    let result = lf * g
    return result
