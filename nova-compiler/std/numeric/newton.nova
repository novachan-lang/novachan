// ============================================================================
// NOVA Standard Library — Newton-Raphson Root Finding
// std/numeric/newton.nova
// ============================================================================
// Classic Newton-Raphson iteration for finding roots of smooth functions.
//
// Given f and its derivative df, Newton's method converges quadratically:
//   x_{n+1} = x_n - f(x_n) / df(x_n)
//
// nt_root uses the analytic derivative (caller provides df).
// nt_root_auto uses a SECANT METHOD approximation (caller provides f only).
//   The secant method needs two initial points x0 and x1=x0+h to bootstrap.
//   It updates: x_{n+1} = x_n - f(x_n)*(x_n-x_{n-1})/(f(x_n)-f(x_{n-1}))
//   Convergence is superlinear (~1.618 order) — between Newton and bisection.
//
// NOVA HOF calling convention note:
//   The NOVA compiler has a known limitation: calling the SAME function
//   parameter more than ONCE within a single loop-body pass produces
//   corrupted return values for any call after the first, when the called
//   function itself calls a builtin (sin, cos, sqrt, exp, etc.).
//   Central difference (which needs f(x+h) AND f(x-h) in the same pass)
//   would hit this bug for transcendental functions.
//   The secant method avoids this by:
//     - Seeding the two starting f-values in SEPARATE loop iterations
//       (i=0 seeds f(xprev), i=1 seeds f(xcurr))
//     - Running the secant step in i>=2 iterations with exactly ONE f call
//   This guarantees at most ONE HOF call per loop-body pass.
//
// HOF caller note: every function passed as f or df MUST reference its
// parameter x in the return expression (even trivially: x*0+c).
// A function that ignores its argument entirely and returns a float
// constant triggers a NOVA HOF float-return bug (compiler limitation).
//
// Public API (prefix nt_):
//   nt_root(f, df, x0, tol, maxiter) -> float
//       Newton-Raphson with analytic derivative df.
//       f, df: function (float) -> float, passed as named fns.
//       x0:    initial guess (float)
//       tol:   convergence tolerance on |f(x)| (float)
//       maxiter: maximum iterations (int)
//       Returns the root approximation.
//
//   nt_root_auto(f, x0, tol) -> float
//       Secant-method root-finding (quasi-Newton, no df needed).
//       Uses x0 and x0+0.001 as the two starting points.
//       Runs at most 202 total passes (2 seed + 200 secant steps).
//       f: function (float) -> float, passed as a named fn.
//       x0:  initial guess (float)
//       tol: convergence tolerance on |f(x)| (float)
//       Returns the root approximation.
//
// All private helpers are prefixed _nt_ to avoid namespace collisions.
// ============================================================================

// _nt_fabs — float absolute value (abs() returns int in NOVA)
fn _nt_fabs(v) -> float
    -v if v < 0.0 else v

// nt_root — Newton-Raphson with analytic derivative.
// Returns x such that |f(x)| < tol. Iterates at most maxiter times.
// If the derivative df is zero at any iterate we stop rather than divide.
//
// Flat structure: all conditionals at single if-depth inside while so
// that st["x"] mutation is always at exactly one level of nesting.
fn nt_root(f, df, x0, tol, maxiter) -> float
    let st = {}
    st["x"] = x0 * 1.0
    let i = 0
    while i < maxiter
        let xc = st["x"]
        let fx = f(xc)
        let afx = _nt_fabs(fx)
        let dfx = df(xc)
        let adfx = _nt_fabs(dfx)
        let skip = 0
        if afx < tol
            skip = 1
        if adfx < 1e-30
            skip = 1
        if skip == 0
            let step = fx / dfx
            st["x"] = xc - step
        let i = i + 1
    let result = st["x"]
    return result

// nt_root_auto — Secant method root-finding (quasi-Newton, no df needed).
//
// Secant update: x_{n+1} = x_n - f(x_n)*(x_n-x_{n-1})/(f(x_n)-f(x_{n-1}))
//
// Loop structure (at most ONE HOF call per loop-body pass):
//   i=0: seed st["fprev"] = f(xprev)  — single call
//   i=1: seed st["fcurr"] = f(xcurr)  — single call, separate iteration
//   i>=2: compute secant step, call f once for new point
//
// State dict:
//   st["xprev"], st["xcurr"]  — two adjacent iterates
//   st["fprev"], st["fcurr"]  — their function values
fn nt_root_auto(f, x0, tol) -> float
    let xprev = x0 * 1.0
    let xcurr = xprev + 0.001
    let st = {}
    st["xprev"] = xprev
    st["xcurr"] = xcurr
    st["fprev"] = 0.0
    st["fcurr"] = 0.0
    let maxiter = 202
    let i = 0
    while i < maxiter
        // i=0: seed the previous-point function value (one HOF call)
        if i == 0
            let fxp = f(st["xprev"])
            st["fprev"] = fxp
        // i=1: seed the current-point function value (one HOF call)
        if i == 1
            let fxc = f(st["xcurr"])
            st["fcurr"] = fxc
        // i>=2: secant step — one HOF call per pass
        if i >= 2
            let xn = st["xcurr"]
            let xp = st["xprev"]
            let fxn = st["fcurr"]
            let fxp = st["fprev"]
            let afxn = _nt_fabs(fxn)
            let denom = fxn - fxp
            let adenom = _nt_fabs(denom)
            let skip = 0
            if afxn < tol
                skip = 1
            if adenom < 1e-20
                skip = 1
            if skip == 0
                let dx = xn - xp
                let step = fxn * dx / denom
                let xnext = xn - step
                let fxnext = f(xnext)
                st["xprev"] = xn
                st["fprev"] = fxn
                st["xcurr"] = xnext
                st["fcurr"] = fxnext
        let i = i + 1
    let result = st["xcurr"]
    return result
