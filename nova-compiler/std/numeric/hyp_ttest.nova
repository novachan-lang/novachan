// ============================================================================
// NOVA Standard Library — std/numeric/hyp_ttest
// ============================================================================
// Hypothesis testing: Student's t-tests.
//
// Public API:
//   t_one_sample(data, mu0) -> float
//     One-sample t-test. Returns t = (mean - mu0) / (s / sqrt(n)).
//     where s is the sample standard deviation (ddof=1).
//     Returns 0.0 if n < 2 (undefined).
//
//   t_two_sample(a, b) -> float
//     Two-sample t-test with pooled variance.
//     t = (mean_a - mean_b) / sqrt(sp2 * (1/na + 1/nb))
//     where sp2 = pooled variance = ((na-1)*sa2 + (nb-1)*sb2) / (na+nb-2).
//     Returns 0.0 if fewer than 2 elements in either sample.
//
// Implementation notes:
//   All intermediate float values are stored in a dict (st) and read back
//   before arithmetic. Dict reads (nova_rt_dict_get) correctly expose float
//   values for subsequent fmul/fadd/fsub/fdiv operations. This matches the
//   simpson/romberg pattern and avoids the any-ABI float boxing issue where
//   fn-return floats assigned directly to lets may not carry type info.
//
// All private helpers are prefixed _tt_ to avoid namespace collisions.

// _tt_mean: arithmetic mean of a list of floats.
fn _tt_mean(data) -> float
    let st = {}
    st["n"] = len(data)
    st["s"] = 0.0
    st["i"] = 0
    while st["i"] < st["n"]
        let _tt_i = st["i"]
        let _tt_v = data[_tt_i] * 1.0
        st["s"] = st["s"] + _tt_v
        st["i"] = _tt_i + 1
    let _tt_n = st["n"]
    let _tt_sum = st["s"]
    let result = _tt_sum / (_tt_n * 1.0)
    return result

// _tt_var: sample variance (ddof=1) of a list of floats given precomputed mean.
fn _tt_var(data, mean) -> float
    let st = {}
    st["n"] = len(data)
    st["ss"] = 0.0
    st["i"] = 0
    st["m"] = mean * 1.0
    while st["i"] < st["n"]
        let _tt_i = st["i"]
        let _tt_v = data[_tt_i] * 1.0
        let _tt_d = _tt_v - st["m"]
        st["ss"] = st["ss"] + _tt_d * _tt_d
        st["i"] = _tt_i + 1
    let _tt_n = st["n"]
    let _tt_ss = st["ss"]
    let result = _tt_ss / ((_tt_n - 1) * 1.0)
    return result

// t_one_sample: one-sample t-statistic.
// t = (mean - mu0) / (s / sqrt(n))
// Returns 0.0 when n < 2.
fn t_one_sample(data, mu0) -> float
    let st = {}
    st["n"] = len(data)
    if st["n"] < 2
        return 0.0
    // Store mu0 in dict to ensure float unboxing on subsequent reads.
    st["mu0"] = mu0 * 1.0
    // Compute and store xbar (mean) through dict so reads are properly float.
    let _tt_xbar0 = _tt_mean(data)
    st["xbar"] = _tt_xbar0 * 1.0
    // Compute variance using xbar read from dict.
    let _tt_xbar1 = st["xbar"]
    let _tt_v0 = _tt_var(data, _tt_xbar1)
    st["v"] = _tt_v0 * 1.0
    // Compute t = (xbar - mu0) / (sqrt(v) / sqrt(n))
    let _tt_n = st["n"]
    let _tt_xbar2 = st["xbar"]
    let _tt_mu0 = st["mu0"]
    let _tt_v1 = st["v"]
    let _tt_s = sqrt(_tt_v1)
    let _tt_sqrtn = sqrt(_tt_n * 1.0)
    let _tt_se = _tt_s / _tt_sqrtn
    let _tt_diff = _tt_xbar2 - _tt_mu0
    let result = _tt_diff / _tt_se
    return result

// t_two_sample: two-sample t-statistic with pooled variance.
// Returns 0.0 when either sample has fewer than 2 elements.
fn t_two_sample(a, b) -> float
    let st = {}
    st["na"] = len(a)
    st["nb"] = len(b)
    if st["na"] < 2
        return 0.0
    if st["nb"] < 2
        return 0.0
    let _tt_na = st["na"]
    let _tt_nb = st["nb"]
    // Compute means and store in dict.
    let _tt_ma0 = _tt_mean(a)
    st["ma"] = _tt_ma0 * 1.0
    let _tt_mb0 = _tt_mean(b)
    st["mb"] = _tt_mb0 * 1.0
    // Compute variances using dict-read means.
    let _tt_ma1 = st["ma"]
    let _tt_va0 = _tt_var(a, _tt_ma1)
    st["va"] = _tt_va0 * 1.0
    let _tt_mb1 = st["mb"]
    let _tt_vb0 = _tt_var(b, _tt_mb1)
    st["vb"] = _tt_vb0 * 1.0
    // Pooled variance: ((na-1)*va + (nb-1)*vb) / (na+nb-2)
    let _tt_va1 = st["va"]
    let _tt_vb1 = st["vb"]
    let _tt_num = ((_tt_na - 1) * 1.0) * _tt_va1 + ((_tt_nb - 1) * 1.0) * _tt_vb1
    let _tt_den = (_tt_na + _tt_nb - 2) * 1.0
    st["sp2"] = (_tt_num / _tt_den) * 1.0
    // Standard error = sqrt(sp2 * (1/na + 1/nb))
    let _tt_sp2 = st["sp2"]
    let _tt_inv_na = 1.0 / (_tt_na * 1.0)
    let _tt_inv_nb = 1.0 / (_tt_nb * 1.0)
    let _tt_se = sqrt(_tt_sp2 * (_tt_inv_na + _tt_inv_nb))
    let _tt_ma2 = st["ma"]
    let _tt_mb2 = st["mb"]
    let _tt_diff = _tt_ma2 - _tt_mb2
    let result = _tt_diff / _tt_se
    return result
