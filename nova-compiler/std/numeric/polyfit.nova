// ============================================================================
// NOVA Standard Library — std/numeric/polyfit
// ============================================================================
// Least-squares linear fitting and Pearson correlation for float lists.
//
// Public API (prefix pf_):
//   pf_linear(xs, ys)        -> list   [slope, intercept] of best-fit line
//   pf_correlation(xs, ys)   -> float  Pearson r correlation coefficient
//   pf_predict(coeffs, x)    -> float  slope*x + intercept
//
// Algorithm (simple linear regression via normal equations):
//   Given n data points (xs[i], ys[i]):
//     sx  = sum(xs),   sy  = sum(ys)
//     sxx = sum(xs[i]^2),  sxy = sum(xs[i]*ys[i])
//     syy = sum(ys[i]^2)
//     denom = n*sxx - sx*sx
//     slope     = (n*sxy - sx*sy) / denom
//     intercept = (sy - slope*sx) / n
//   Pearson r = (n*sxy - sx*sy) / sqrt((n*sxx - sx^2) * (n*syy - sy^2))
//
// All private helpers are prefixed _pf_ to avoid namespace collisions.
// ============================================================================

// _pf_tof — coerce any numeric value to float
fn _pf_tof(x) -> float
    return x * 1.0

// _pf_sqrt — Newton-Raphson square root (native sqrt exists as builtin)
// We use the native sqrt directly via the name sqrt.

// _pf_fabs — float absolute value (native abs() returns int, so we roll our own)
fn _pf_fabs(v) -> float
    let r = v
    if v < 0.0
        r = 0.0 - v
    return r

// _pf_sums — compute sx, sy, sxx, sxy, syy in one pass.
// Returns a dict with keys "sx","sy","sxx","sxy","syy","n".
fn _pf_sums(xs, ys) -> dict
    let n = len(xs)
    let sx = 0.0
    let sy = 0.0
    let sxx = 0.0
    let sxy = 0.0
    let syy = 0.0
    let i = 0
    while i < n
        let xi = _pf_tof(xs[i])
        let yi = _pf_tof(ys[i])
        sx = sx + xi
        sy = sy + yi
        sxx = sxx + xi * xi
        sxy = sxy + xi * yi
        syy = syy + yi * yi
        i = i + 1
    let d = {}
    d["sx"] = sx
    d["sy"] = sy
    d["sxx"] = sxx
    d["sxy"] = sxy
    d["syy"] = syy
    d["n"] = n * 1.0
    return d

// pf_linear — compute [slope, intercept] for the best-fit line through (xs, ys).
// Uses ordinary least squares (OLS):
//   denom = n*sxx - sx^2
//   slope = (n*sxy - sx*sy) / denom
//   intercept = (sy - slope*sx) / n
// If denom == 0 (all x-values identical), slope = 0, intercept = mean(ys).
fn pf_linear(xs, ys) -> list
    let s = _pf_sums(xs, ys)
    let n = s["n"] * 1.0
    let sx = s["sx"] * 1.0
    let sy = s["sy"] * 1.0
    let sxx = s["sxx"] * 1.0
    let sxy = s["sxy"] * 1.0
    let denom = n * sxx - sx * sx
    let slope = 0.0
    let intercept = 0.0
    if _pf_fabs(denom) < 0.0000000001
        let intercept = sy / n
    if _pf_fabs(denom) >= 0.0000000001
        let slp = (n * sxy - sx * sy) / denom
        let icp = (sy - slp * sx) / n
        slope = slp
        intercept = icp
    let result = [slope, intercept]
    return result

// pf_correlation — Pearson r correlation coefficient.
// r = (n*sxy - sx*sy) / sqrt((n*sxx - sx^2) * (n*syy - sy^2))
// Returns 0.0 if either variance is zero.
fn pf_correlation(xs, ys) -> float
    let s = _pf_sums(xs, ys)
    let n = s["n"] * 1.0
    let sx = s["sx"] * 1.0
    let sy = s["sy"] * 1.0
    let sxx = s["sxx"] * 1.0
    let sxy = s["sxy"] * 1.0
    let syy = s["syy"] * 1.0
    let num = n * sxy - sx * sy
    let varx = n * sxx - sx * sx
    let vary = n * syy - sy * sy
    let prod = varx * vary
    if prod < 0.0000000001
        return 0.0
    let denom = sqrt(prod)
    let r = num / denom
    return r

// pf_predict — evaluate the linear model at a single point x.
// coeffs is [slope, intercept] (output of pf_linear).
// Returns slope * x + intercept.
fn pf_predict(coeffs, x) -> float
    let slope = _pf_tof(coeffs[0])
    let intercept = _pf_tof(coeffs[1])
    let xf = _pf_tof(x)
    let y = slope * xf + intercept
    return y

fn main()
    print("polyfit module OK")
