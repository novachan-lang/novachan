// ============================================================================
// NOVA Standard Library — std/numeric/rungekutta
// ============================================================================
// Runge-Kutta 4th order (RK4) method for solving first-order ODEs of the form
//   dy/dt = f(t, y),  y(t0) = y0
//
// RK4 is a classical fixed-step explicit integrator with global error O(h^4),
// four times the order of Euler's method. For smooth ODEs it achieves excellent
// accuracy with moderate step counts; e.g. h=0.1 for dy/dt=y gives e^1 to 4
// correct decimal places.
//
// The RK4 step formula:
//   k1 = f(t,         y)
//   k2 = f(t + h/2,   y + h/2 * k1)
//   k3 = f(t + h/2,   y + h/2 * k2)
//   k4 = f(t + h,     y + h   * k3)
//   y_{n+1} = y_n + (h/6) * (k1 + 2*k2 + 2*k3 + k4)
//
// Public API (prefix rk_):
//
//   rk_solve(f, t0, y0, h, steps) -> list
//     Solve dy/dt = f(t, y) with y(t0) = y0 using `steps` RK4 steps of
//     size h.  Returns a list of (steps+1) pairs [t, y]; index 0 = [t0, y0].
//     f must be a named fn(t, y) -> float.
//
//   rk_final(f, t0, y0, h, steps) -> float
//     Like rk_solve but returns only the final y value, without allocating
//     the full trajectory.  O(1) memory, O(steps) time.
//     f must be a named fn(t, y) -> float.
//
// NOVA HOF calling-convention note:
//   When a function is passed as a first-class value and called inside a loop,
//   its float return arrives as a raw i64 bit-pattern (IEEE 754 reinterpret).
//   Similarly, floats read back from an 'any'-typed dict are boxed pointers.
//   The correct fix is to pass values through pow(x, 1.0) which invokes
//   nova_float_arg (i2f bit-reinterpret) internally, converting both boxed
//   floats and raw bit-patterns to proper doubles. See euler.nova for the same
//   pattern. Applied to: dict reads before passing to f, and f's return values.
//
// All private helpers are prefixed _rk_ to avoid namespace collisions.
// ============================================================================

// _rk_unbox: normalize a float value that may be a boxed dict-read or HOF return.
// pow(x, 1.0) uses nova_float_arg which performs an i2f bit-reinterpret,
// correctly handling both direct float values and raw i64 bit-patterns.
fn _rk_unbox(x) -> float
    let r = pow(x, 1.0)
    return r

// rk_final: RK4 returning only the final y value.
// State is stored in a dict; all values are unboxed with _rk_unbox before use.
fn rk_final(f, t0, y0, h, steps) -> float
    let hf = t0 * 0.0 + h * 1.0
    let h2 = hf * 0.5
    let h6 = hf / 6.0
    let st = {}
    st["t"] = t0 * 1.0
    st["y"] = y0 * 1.0
    let i = 0
    while i < steps
        let tc = _rk_unbox(st["t"])
        let yc = _rk_unbox(st["y"])
        let raw1 = f(tc, yc)
        let k1 = _rk_unbox(raw1)
        let raw2 = f(tc + h2, yc + h2 * k1)
        let k2 = _rk_unbox(raw2)
        let raw3 = f(tc + h2, yc + h2 * k2)
        let k3 = _rk_unbox(raw3)
        let raw4 = f(tc + hf, yc + hf * k3)
        let k4 = _rk_unbox(raw4)
        let wsum = k1 + 2.0 * k2 + 2.0 * k3 + k4
        let yn = yc + h6 * wsum
        st["y"] = yn
        st["t"] = tc + hf
        i = i + 1
    let rawres = st["y"]
    let result = _rk_unbox(rawres)
    return result

// rk_solve: RK4 returning the full trajectory as a list of [t, y] pairs.
// Returns steps+1 entries (including the initial condition at index 0).
// State is stored in a dict; all values are unboxed with _rk_unbox before use.
fn rk_solve(f, t0, y0, h, steps) -> list
    let hf = t0 * 0.0 + h * 1.0
    let h2 = hf * 0.5
    let h6 = hf / 6.0
    let st = {}
    st["t"] = t0 * 1.0
    st["y"] = y0 * 1.0
    let traj = []
    let t0f = t0 * 1.0
    let y0f = y0 * 1.0
    let pair0 = [t0f, y0f]
    traj = traj + [pair0]
    let i = 0
    while i < steps
        let tc = _rk_unbox(st["t"])
        let yc = _rk_unbox(st["y"])
        let raw1 = f(tc, yc)
        let k1 = _rk_unbox(raw1)
        let raw2 = f(tc + h2, yc + h2 * k1)
        let k2 = _rk_unbox(raw2)
        let raw3 = f(tc + h2, yc + h2 * k2)
        let k3 = _rk_unbox(raw3)
        let raw4 = f(tc + hf, yc + hf * k3)
        let k4 = _rk_unbox(raw4)
        let wsum = k1 + 2.0 * k2 + 2.0 * k3 + k4
        let yn = yc + h6 * wsum
        let tn = tc + hf
        st["y"] = yn
        st["t"] = tn
        let pair = [tn, yn]
        traj = traj + [pair]
        i = i + 1
    return traj
