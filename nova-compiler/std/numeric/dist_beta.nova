// ============================================================================
// NOVA Standard Library — std/numeric/dist_beta
// ============================================================================
// Beta distribution: a two-parameter continuous distribution on (0, 1).
// Parameterized by shape parameters a > 0 and b > 0.
//
// PDF: beta_pdf(x, a, b) = x^(a-1) * (1-x)^(b-1) / Beta(a, b)   for 0 < x < 1
//      beta_pdf(x, a, b) = 0.0                                     otherwise
//
// CDF: beta_cdf(x, a, b) = integral from 0 to x of beta_pdf(t, a, b) dt
//      Computed via adaptive Simpson numerical integration.
//
// Mean: beta_mean(a, b) = a / (a + b)
//
// Beta function inline (Lanczos gamma, g=7, 9 coefficients):
//   Beta(a, b) = Gamma(a)*Gamma(b) / Gamma(a+b)  [log-space for stability]
//
// Public API:
//   beta_pdf(x, a, b)    -> float
//   beta_cdf(x, a, b)    -> float
//   beta_mean(a, b)      -> float
//
// Private helpers prefixed _db_.
// ============================================================================

// ---- Inlined Lanczos gamma (g=7, 9 coefficients) ---- //

fn _db_lc0() -> float
    return 0.99999999999980993

fn _db_lc1() -> float
    return 676.5203681218851

fn _db_lc2() -> float
    return 0.0 - 1259.1392167224028

fn _db_lc3() -> float
    return 771.32342877765313

fn _db_lc4() -> float
    return 0.0 - 176.61502916214059

fn _db_lc5() -> float
    return 12.507343278686905

fn _db_lc6() -> float
    return 0.0 - 0.13857109526572012

fn _db_lc7() -> float
    return 0.0000099843695780195716

fn _db_lc8() -> float
    return 0.00000015056327351493116

fn _db_ln_sqrt_2pi() -> float
    return 0.9189385332046727

fn _db_pi() -> float
    return 3.14159265358979

// Lanczos rational sum
fn _db_lsum(z) -> float
    let zf = z * 1.0
    let s = _db_lc0()
    let d1 = zf + 1.0
    let v1 = _db_lc1() / d1
    s = s + v1
    let d2 = zf + 2.0
    let v2 = _db_lc2() / d2
    s = s + v2
    let d3 = zf + 3.0
    let v3 = _db_lc3() / d3
    s = s + v3
    let d4 = zf + 4.0
    let v4 = _db_lc4() / d4
    s = s + v4
    let d5 = zf + 5.0
    let v5 = _db_lc5() / d5
    s = s + v5
    let d6 = zf + 6.0
    let v6 = _db_lc6() / d6
    s = s + v6
    let d7 = zf + 7.0
    let v7 = _db_lc7() / d7
    s = s + v7
    let d8 = zf + 8.0
    let v8 = _db_lc8() / d8
    s = s + v8
    return s

// log-Gamma for x > 0
fn _db_ln_gamma(x) -> float
    let xf = x * 1.0
    let zm1 = xf - 1.0
    let sum_raw = _db_lsum(zm1)
    let sum_f = pow(sum_raw, 1.0)
    let lsum_raw = log(sum_f)
    let lsum = pow(lsum_raw, 1.0)
    let base = zm1 + 7.5
    let lbase_raw = log(base)
    let lbase = pow(lbase_raw, 1.0)
    let t1 = (zm1 + 0.5) * lbase
    let t2 = 0.0 - base
    let result = _db_ln_sqrt_2pi() + t1 + t2 + lsum
    return result

// log-Beta(a, b) = ln_gamma(a) + ln_gamma(b) - ln_gamma(a+b)
fn _db_ln_beta(a, b) -> float
    let af = a * 1.0
    let bf = b * 1.0
    let la_raw = _db_ln_gamma(af)
    let la = pow(la_raw, 1.0)
    let lb_raw = _db_ln_gamma(bf)
    let lb = pow(lb_raw, 1.0)
    let lab_raw = _db_ln_gamma(af + bf)
    let lab = pow(lab_raw, 1.0)
    let result = la + lb - lab
    return result

// Beta(a, b) via exp(ln_beta)
fn _db_beta_fn(a, b) -> float
    let lb_raw = _db_ln_beta(a, b)
    let lb = pow(lb_raw, 1.0)
    let result_raw = exp(lb)
    let result = pow(result_raw, 1.0)
    return result

// ---- Beta distribution core ---- //

// _db_pdf_unnorm(x, a, b): x^(a-1) * (1-x)^(b-1) — the unnormalized density.
// Uses pow() directly for numerical correctness and float-ABI safety.
fn _db_pdf_unnorm(x, a, b) -> float
    let xf = x * 1.0
    let af = a * 1.0
    let bf = b * 1.0
    let am1 = af - 1.0
    let bm1 = bf - 0.0 - 1.0
    let omx = 1.0 - xf
    // pow returns float; unbox immediately via mul by 1.0 via pow(v,1.0)
    let px_raw = pow(xf, am1)
    let px = pow(px_raw, 1.0)
    let py_raw = pow(omx, bm1)
    let py = pow(py_raw, 1.0)
    let result = px * py
    return result

// beta_pdf(x, a, b): PDF of Beta(a, b) at x.
// Returns 0.0 for x outside (0, 1).
fn beta_pdf(x, a, b) -> float
    let xf = x * 1.0
    let af = a * 1.0
    let bf = b * 1.0
    if xf <= 0.0
        return 0.0
    if xf >= 1.0
        return 0.0
    // Force-unbox float return values via pow(v,1.0) to avoid raw-bits ABI issue.
    let num_raw = _db_pdf_unnorm(xf, af, bf)
    let num = pow(num_raw, 1.0)
    let denom_raw = _db_beta_fn(af, bf)
    let denom = pow(denom_raw, 1.0)
    let result = num / denom
    return result

// beta_cdf(x, a, b): CDF of Beta(a, b) at x via Simpson's rule integration.
// Integrates beta_pdf from 0 to x using 200 panels (400 sub-intervals).
// Returns 0.0 for x <= 0, 1.0 for x >= 1.
fn beta_cdf(x, a, b) -> float
    let xf = x * 1.0
    let af = a * 1.0
    let bf = b * 1.0
    if xf <= 0.0
        return 0.0
    if xf >= 1.0
        return 1.0
    // Simpson's rule: integral from 0 to xf with n=200 panels (must be even)
    let n = 200
    let h = xf / (n * 1.0)
    // f(0) and f(xf): endpoints
    // f(0) = 0 (since x^(a-1) -> 0 for a>1, or pdf=0 at boundary for a>=1)
    // We compute pdf at each point
    let f0 = beta_pdf(0.0, af, bf)
    let fn_val = beta_pdf(xf, af, bf)
    let sum_ends = f0 + fn_val
    // Sum of odd-indexed (coefficient 4) and even-indexed (coefficient 2) terms
    let sum_odd = 0.0
    let sum_even = 0.0
    let i = 1
    while i < n
        let xi = i * 1.0 * h
        let fi = beta_pdf(xi, af, bf)
        // odd index: coefficient 4
        sum_odd = sum_odd + fi
        i = i + 1
        if i < n
            let xi2 = i * 1.0 * h
            let fi2 = beta_pdf(xi2, af, bf)
            // even index: coefficient 2
            sum_even = sum_even + fi2
            i = i + 1
    let total = sum_ends + 4.0 * sum_odd + 2.0 * sum_even
    let result = (h / 3.0) * total
    return result

// beta_mean(a, b): mean of Beta(a, b) = a / (a + b).
fn beta_mean(a, b) -> float
    let af = a * 1.0
    let bf = b * 1.0
    let result = af / (af + bf)
    return result
