// ============================================================================
// NOVA Standard Library — Natural cubic spline evaluation
// ============================================================================
// Given the knots (xs, ys) and the second-derivative array M (from
// spline_natural.spline_coeffs), evaluates the piecewise cubic polynomial.
//
// On the interval [xs[i], xs[i+1]] the cubic formula is:
//   h   = xs[i+1] - xs[i]
//   A   = (xs[i+1] - x) / h
//   B   = (x - xs[i])   / h
//   S(x) = A*ys[i] + B*ys[i+1]
//           + ((A^3-A)*M[i] + (B^3-B)*M[i+1]) * h^2 / 6
//
// This is the standard Hermite-like form that follows directly from
// integrating S'' = M with natural boundary conditions.
//
// spline_eval(xs, ys, coeffs, x) -> float
//   Evaluates the spline at a single query point x.
//   Clamps gracefully outside the data range (linear extrapolation from
//   the boundary interval: A or B can exceed [0,1] but the formula is
//   still evaluated — this is standard "not-a-knot" extrapolation practice).
//
// spline_eval_inline(xs, ys, x) -> float
//   Convenience wrapper: computes the natural-spline coefficients internally
//   and evaluates at x.  Prefer spline_eval when evaluating many points.
// ============================================================================

// _se_coeffs: Thomas-algorithm tridiagonal solve for interior M values.
// (Inlined duplicate of spline_natural so spline_eval is self-contained.)
fn _se_coeffs(xs, ys) -> list
    let n = len(xs) - 1
    if n < 2
        let m = []
        let i = 0
        while i <= n
            push(m, 0.0)
            i = i + 1
        return m

    let h = []
    for k in 0..n
        let hk = xs[k + 1] - xs[k]
        push(h, hk)

    let m_size = n - 1
    let a = []
    let b = []
    let c = []
    let r = []
    for j in 0..m_size
        let i = j + 1
        let hi1 = h[i - 1]
        let hi = h[i]
        let bj = 2.0 * (hi1 + hi)
        push(b, bj)
        if j > 0
            push(a, h[i - 1])
        else
            push(a, 0.0)
        if j < m_size - 1
            push(c, h[i])
        else
            push(c, 0.0)
        let slope_right = (ys[i + 1] - ys[i]) / hi
        let slope_left = (ys[i] - ys[i - 1]) / hi1
        let rj = 6.0 * (slope_right - slope_left)
        push(r, rj)

    // Forward sweep
    for fwd in 1..m_size
        let factor = a[fwd] / b[fwd - 1]
        b[fwd] = b[fwd] - factor * c[fwd - 1]
        r[fwd] = r[fwd] - factor * r[fwd - 1]

    // Back substitution
    let interior = [0.0 for pre in 0..m_size]
    let last_j = m_size - 1
    interior[last_j] = r[last_j] / b[last_j]
    let bk = m_size - 2
    while bk >= 0
        interior[bk] = (r[bk] - c[bk] * interior[bk + 1]) / b[bk]
        bk = bk - 1

    let M = []
    push(M, 0.0)
    for ii in 0..m_size
        push(M, interior[ii])
    push(M, 0.0)
    return M

// _se_eval_interval: evaluate the cubic formula on interval [xs[i], xs[i+1]]
fn _se_eval_interval(xs, ys, M, i: int, x: float) -> float
    let xi = xs[i]
    let xi1 = xs[i + 1]
    let yi = ys[i]
    let yi1 = ys[i + 1]
    let Mi = M[i]
    let Mi1 = M[i + 1]
    let h = xi1 - xi
    let A = (xi1 - x) / h
    let B = (x - xi) / h
    let A3 = A * A * A
    let B3 = B * B * B
    let h2 = h * h
    let cubic = ((A3 - A) * Mi + (B3 - B) * Mi1) * h2 / 6.0
    let result = A * yi + B * yi1 + cubic
    return result

// spline_eval: evaluate natural cubic spline at x given precomputed coeffs M
fn spline_eval(xs, ys, coeffs, x: float) -> float
    let n = len(xs) - 1
    // Clamp left: use first interval extrapolated
    let x0 = xs[0]
    if x <= x0
        let v = _se_eval_interval(xs, ys, coeffs, 0, x)
        return v
    // Clamp right: use last interval extrapolated
    let xlast = xs[n]
    if x >= xlast
        let v = _se_eval_interval(xs, ys, coeffs, n - 1, x)
        return v
    // Find bracketing interval
    for i in 0..n
        let xa = xs[i]
        let xb = xs[i + 1]
        if x >= xa and x <= xb
            let v = _se_eval_interval(xs, ys, coeffs, i, x)
            return v
    // Fallback (should not be reached)
    let vfb = _se_eval_interval(xs, ys, coeffs, n - 1, x)
    return vfb

// spline_eval_inline: compute coeffs and evaluate in one call (convenience)
fn spline_eval_inline(xs, ys, x: float) -> float
    let M = _se_coeffs(xs, ys)
    let v = spline_eval(xs, ys, M, x)
    return v
