// ============================================================================
// NOVA Standard Library — std/numeric/derivative
// ============================================================================
// Numerical differentiation via finite differences.
//
// Public API:
//   dv_forward(f, x, h) -> float
//     Forward-difference first derivative: (f(x+h) - f(x)) / h
//     First-order accurate (error O(h)).
//
//   dv_central(f, x, h) -> float
//     Central-difference first derivative: (f(x+h) - f(x-h)) / (2*h)
//     Second-order accurate (error O(h^2)).  Preferred for general use.
//
//   dv_second(f, x, h) -> float
//     Central-difference second derivative: (f(x+h) - 2*f(x) + f(x-h)) / (h^2)
//     Second-order accurate (error O(h^2)).
//
// All private helpers are prefixed _dv_ to avoid namespace collisions.
// ============================================================================

// _dv_tof: coerce any numeric value to float
fn _dv_tof(v) -> float
    return v * 1.0

// dv_forward: first derivative, forward-difference scheme, O(h) accuracy.
fn dv_forward(f, x, h) -> float
    let xf = _dv_tof(x)
    let hf = _dv_tof(h)
    let fxh = _dv_tof(f(xf + hf))
    let fx  = _dv_tof(f(xf))
    let num = fxh - fx
    let den = hf
    let result = num / den
    return result

// dv_central: first derivative, central-difference scheme, O(h^2) accuracy.
fn dv_central(f, x, h) -> float
    let xf = _dv_tof(x)
    let hf = _dv_tof(h)
    let fxph = _dv_tof(f(xf + hf))
    let fxmh = _dv_tof(f(xf - hf))
    let num = fxph - fxmh
    let den = 2.0 * hf
    let result = num / den
    return result

// dv_second: second derivative, central-difference scheme, O(h^2) accuracy.
fn dv_second(f, x, h) -> float
    let xf = _dv_tof(x)
    let hf = _dv_tof(h)
    let fxph = _dv_tof(f(xf + hf))
    let fxc  = _dv_tof(f(xf))
    let fxmh = _dv_tof(f(xf - hf))
    let num = fxph - 2.0 * fxc + fxmh
    let den = hf * hf
    let result = num / den
    return result
