// ============================================================================
// NOVA Standard Library — Integer Interval Arithmetic
// std/numeric/interval.nova
// ============================================================================
// Represents a closed integer interval [lo, hi] as a dict {"lo": int, "hi": int}.
// Intersection sets an "empty" key to 1 when intervals are disjoint.
// All arithmetic follows standard interval arithmetic rules.
//
// Public API (prefix iv_):
//   iv_new(lo, hi)            -> dict {"lo":lo, "hi":hi}
//   iv_add(x, y)              -> dict  [xlo+ylo, xhi+yhi]
//   iv_sub(x, y)              -> dict  [xlo-yhi, xhi-ylo]
//   iv_mul(x, y)              -> dict  [min of 4 products, max of 4 products]
//   iv_neg(x)                 -> dict  [-xhi, -xlo]
//   iv_contains(x, val)       -> bool  lo <= val <= hi
//   iv_width(x)               -> int   hi - lo
//   iv_intersect(x, y)        -> dict  [max(xlo,ylo), min(xhi,yhi)]; empty=1 if disjoint
//   iv_overlaps(x, y)         -> bool  true iff intersection is non-empty
//   iv_eq(x, y)               -> bool  lo equal AND hi equal (ignores empty flag)
// ============================================================================

// ── helpers (private, prefix _iv_) ──────────────────────────────────────────

fn _iv_min4(a, b, c, d) -> int
    let m = a
    if b < m
        m = b
    if c < m
        m = c
    if d < m
        m = d
    return m

fn _iv_max4(a, b, c, d) -> int
    let m = a
    if b > m
        m = b
    if c > m
        m = c
    if d > m
        m = d
    return m

// ── public API ───────────────────────────────────────────────────────────────

fn iv_new(lo, hi)
    let d = {}
    d["lo"] = lo
    d["hi"] = hi
    return d

// [a,b] + [c,d] = [a+c, b+d]
fn iv_add(x, y)
    let d = {}
    d["lo"] = x["lo"] + y["lo"]
    d["hi"] = x["hi"] + y["hi"]
    return d

// [a,b] - [c,d] = [a-d, b-c]
fn iv_sub(x, y)
    let d = {}
    d["lo"] = x["lo"] - y["hi"]
    d["hi"] = x["hi"] - y["lo"]
    return d

// [a,b] * [c,d] = [min(ac,ad,bc,bd), max(ac,ad,bc,bd)]
fn iv_mul(x, y)
    let a = x["lo"]
    let b = x["hi"]
    let c = y["lo"]
    let dd = y["hi"]
    let p1 = a * c
    let p2 = a * dd
    let p3 = b * c
    let p4 = b * dd
    let lo = _iv_min4(p1, p2, p3, p4)
    let hi = _iv_max4(p1, p2, p3, p4)
    let d = {}
    d["lo"] = lo
    d["hi"] = hi
    return d

// -[a,b] = [-b, -a]
fn iv_neg(x)
    let d = {}
    d["lo"] = 0 - x["hi"]
    d["hi"] = 0 - x["lo"]
    return d

// true iff lo <= val <= hi
fn iv_contains(x, val) -> bool
    if val < x["lo"]
        return 0
    if val > x["hi"]
        return 0
    return 1

// hi - lo
fn iv_width(x) -> int
    return x["hi"] - x["lo"]

// Intersection: [max(alo,blo), min(ahi,bhi)]; sets empty=1 if disjoint
fn iv_intersect(x, y)
    let lo = x["lo"]
    if y["lo"] > lo
        lo = y["lo"]
    let hi = x["hi"]
    if y["hi"] < hi
        hi = y["hi"]
    let d = {}
    d["lo"] = lo
    d["hi"] = hi
    if lo > hi
        d["empty"] = 1
    return d

// true iff intervals share at least one integer point
fn iv_overlaps(x, y) -> bool
    if x["hi"] < y["lo"]
        return 0
    if y["hi"] < x["lo"]
        return 0
    return 1

// structural equality on lo and hi (empty flag not compared)
fn iv_eq(x, y) -> bool
    if x["lo"] != y["lo"]
        return 0
    if x["hi"] != y["hi"]
        return 0
    return 1
