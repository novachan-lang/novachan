// ============================================================================
// NOVA Standard Library — std/numeric/dist_poisson
// ============================================================================
// Poisson distribution — PMF, CDF, and mean.
//
// Public API:
//   poisson_pmf(k, lambda) -> float   — P(X = k) for X ~ Poisson(lambda)
//   poisson_cdf(k, lambda) -> float   — P(X <= k) for X ~ Poisson(lambda)
//   poisson_mean(lambda)   -> float   — E[X] = lambda
//
// Internals:
//   Log-space computation for numerical stability.
//   Inline iterative log-factorial (while loop), no sub-function call across boundary.
//   CDF: sum of PMF values 0..k using dict-based while loop.
// ============================================================================

// poisson_pmf(k, lambda): P(X = k) for X ~ Poisson(lambda).
// Computed in log-space: exp(k*log(lambda) - lambda - log(k!)).
// k must be non-negative integer; lambda > 0.
fn poisson_pmf(k, lambda) -> float
    let kf = k * 1.0
    let lf = lambda * 1.0
    if k < 0
        return 0.0
    if lf <= 0.0
        return 0.0
    // Compute log(k!) iteratively using a dict-based while loop
    let st = {}
    st["logfact"] = 0.0
    st["j"] = 1
    while st["j"] <= k
        let j = st["j"]
        let jf = j * 1.0
        let ljf = log(jf)
        st["logfact"] += ljf
        st["j"] = j + 1
    let log_kfact = st["logfact"]
    let log_kfactf = log_kfact * 1.0
    // log(P) = k*log(lambda) - lambda - log(k!)
    let log_lam = log(lf)
    let log_pmf = kf * log_lam - lf - log_kfactf
    let result = exp(log_pmf)
    return result

// poisson_cdf(k, lambda): P(X <= k) for X ~ Poisson(lambda).
// Computed as sum of poisson_pmf(i, lambda) for i = 0, 1, ..., k.
fn poisson_cdf(k, lambda) -> float
    let lf = lambda * 1.0
    if k < 0
        return 0.0
    if lf <= 0.0
        return 1.0
    let st = {}
    st["acc"] = 0.0
    st["i"] = 0
    while st["i"] <= k
        let i = st["i"]
        let v = poisson_pmf(i, lf)
        let vf = v * 1.0
        st["acc"] += vf
        st["i"] = i + 1
    let total = st["acc"]
    let result = total * 1.0
    return result

// poisson_mean(lambda): expected value E[X] = lambda.
fn poisson_mean(lambda) -> float
    let result = lambda * 1.0
    return result
