// ============================================================================
// forge_signum -- arbitrary-precision SIGNED integer (bignum), sign + magnitude.
// ============================================================================

// ---- unsigned magnitude helpers (decimal-string schoolbook) ----

fn _mag_norm(s: string) -> string
    let out = "0"
    if len(s) > 0
        let i = 0
        while i < len(s) - 1 and char_at(s, i) == "0"
            i = i + 1
        let t = slice(s, i, len(s))
        if len(t) > 0
            out = t
    out

fn _mag_cmp(a0: string, b0: string) -> int
    let a = _mag_norm(a0)
    let b = _mag_norm(b0)
    let out = 0
    if len(a) < len(b)
        out = 0 - 1
    else
        if len(a) > len(b)
            out = 1
        else
            let k = 0
            let decided = false
            while k < len(a) and decided == false
                let ca = ord(char_at(a, k))
                let cb = ord(char_at(b, k))
                if ca < cb
                    out = 0 - 1
                    decided = true
                else
                    if ca > cb
                        out = 1
                        decided = true
                k = k + 1
    out

fn _mag_add(a0: string, b0: string) -> string
    let a = _mag_norm(a0)
    let b = _mag_norm(b0)
    let i = len(a) - 1
    let j = len(b) - 1
    let carry = 0
    let out = ""
    while i >= 0 or j >= 0 or carry > 0
        let da = 0
        if i >= 0
            da = ord(char_at(a, i)) - 48
            i = i - 1
        let db = 0
        if j >= 0
            db = ord(char_at(b, j)) - 48
            j = j - 1
        let s = da + db + carry
        carry = s / 10
        out = chr(48 + (s % 10)) + out
    _mag_norm(out)

fn _mag_sub(a0: string, b0: string) -> string
    let a = _mag_norm(a0)
    let b = _mag_norm(b0)
    let i = len(a) - 1
    let j = len(b) - 1
    let borrow = 0
    let out = ""
    while i >= 0
        let da = ord(char_at(a, i)) - 48
        let db = 0
        if j >= 0
            db = ord(char_at(b, j)) - 48
        let d = da - db - borrow
        if d < 0
            d = d + 10
            borrow = 1
        else
            borrow = 0
        out = chr(48 + d) + out
        i = i - 1
        j = j - 1
    _mag_norm(out)

fn _mag_mul(a0: string, b0: string) -> string
    let a = _mag_norm(a0)
    let b = _mag_norm(b0)
    let out = "0"
    if a != "0" and b != "0"
        let na = len(a)
        let nb = len(b)
        let res = []
        let z = 0
        while z < na + nb
            push(res, 0)
            z = z + 1
        let i = na - 1
        while i >= 0
            let da = ord(char_at(a, i)) - 48
            let carry = 0
            let j = nb - 1
            while j >= 0
                let db = ord(char_at(b, j)) - 48
                let pos = (na - 1 - i) + (nb - 1 - j)
                let cur = res[pos] + da * db + carry
                res[pos] = cur % 10
                carry = cur / 10
                j = j - 1
            let pos2 = (na - 1 - i) + nb
            while carry > 0
                let cur2 = res[pos2] + carry
                res[pos2] = cur2 % 10
                carry = cur2 / 10
                pos2 = pos2 + 1
            i = i - 1
        let s = ""
        let k = len(res) - 1
        while k >= 0
            s = s + chr(48 + res[k])
            k = k - 1
        out = _mag_norm(s)
    out

// unsigned long division: returns [quotient, remainder], both magnitudes.
fn _mag_divmod(a0: string, b0: string) -> list
    let a = _mag_norm(a0)
    let b = _mag_norm(b0)
    let quotient = ""
    let remainder = "0"
    let i = 0
    while i < len(a)
        remainder = _mag_norm(remainder + char_at(a, i))
        let d = 0
        while d < 9 and _mag_cmp(_mag_mul(b, str(d + 1)), remainder) <= 0
            d = d + 1
        quotient = quotient + chr(48 + d)
        remainder = _mag_sub(remainder, _mag_mul(b, str(d)))
        i = i + 1
    let outq = _mag_norm(quotient)
    let outr = _mag_norm(remainder)
    let pair = []
    push(pair, outq)
    push(pair, outr)
    pair

// ============================================================================
// SIGNED interface -- a Signum is a dict: {"sign": -1|0|1, "mag": "<decimal>"}.
// Zero is CANONICAL: sign 0, mag "0". No negative zero ever escapes.
// ============================================================================

fn _sn_make(sign: int, mag0: string) -> dict
    let mag = _mag_norm(mag0)
    let s = sign
    if mag == "0"
        s = 0
    let out = {}
    out["sign"] = s
    out["mag"] = mag
    out

fn sn_from_int(i: int) -> dict
    // Derive sign + magnitude by parsing str(i) DIRECTLY. This avoids the
    // 0 - INT_MIN two's-complement wrap: for INT_MIN, negate-then-str keeps a
    // '-' and doubles it ("--9223..."). Parsing the decimal string is exact
    // for INT_MIN, INT_MAX, 0, and all negatives -- no arithmetic on i at all.
    let s = str(i)
    let sign = 1
    let start = 0
    if len(s) > 0 and char_at(s, 0) == "-"
        sign = 0 - 1
        start = 1
    let mag = slice(s, start, len(s))
    if len(mag) == 0
        mag = "0"
    _sn_make(sign, mag)

fn sn_from_str(text: string) -> dict
    let s = text
    let sign = 1
    let start = 0
    if len(s) > 0 and char_at(s, 0) == "-"
        sign = 0 - 1
        start = 1
    else
        if len(s) > 0 and char_at(s, 0) == "+"
            start = 1
    let digits = slice(s, start, len(s))
    if len(digits) == 0
        digits = "0"
    _sn_make(sign, digits)

fn sn_is_zero(x: dict) -> bool
    x["sign"] == 0

fn sn_to_str(x: dict) -> string
    let out = x["mag"]
    if x["sign"] < 0
        out = "-" + x["mag"]
    out

fn sn_neg(x: dict) -> dict
    _sn_make(0 - x["sign"], x["mag"])

fn sn_abs(x: dict) -> dict
    let s = 0
    if x["sign"] != 0
        s = 1
    _sn_make(s, x["mag"])

// -1 if a<b, 0 if equal, 1 if a>b -- signed comparison.
fn sn_cmp(a: dict, b: dict) -> int
    let sa = a["sign"]
    let sb = b["sign"]
    let out = 0
    if sa < sb
        out = 0 - 1
    else
        if sa > sb
            out = 1
        else
            // same sign; compare magnitudes, flip for negatives
            let m = _mag_cmp(a["mag"], b["mag"])
            if sa < 0
                out = 0 - m
            else
                out = m
    out

fn sn_add(a: dict, b: dict) -> dict
    let out = _sn_make(0, "0")
    if a["sign"] == 0
        out = _sn_make(b["sign"], b["mag"])
    else
        if b["sign"] == 0
            out = _sn_make(a["sign"], a["mag"])
        else
            if a["sign"] == b["sign"]
                // same sign: add magnitudes, keep sign
                out = _sn_make(a["sign"], _mag_add(a["mag"], b["mag"]))
            else
                // opposite signs: subtract smaller magnitude from larger
                let c = _mag_cmp(a["mag"], b["mag"])
                if c == 0
                    out = _sn_make(0, "0")
                else
                    if c > 0
                        out = _sn_make(a["sign"], _mag_sub(a["mag"], b["mag"]))
                    else
                        out = _sn_make(b["sign"], _mag_sub(b["mag"], a["mag"]))
    out

fn sn_sub(a: dict, b: dict) -> dict
    sn_add(a, sn_neg(b))

fn sn_mul(a: dict, b: dict) -> dict
    let out = _sn_make(0, "0")
    if a["sign"] != 0 and b["sign"] != 0
        let sign = 1
        if a["sign"] != b["sign"]
            sign = 0 - 1
        out = _sn_make(sign, _mag_mul(a["mag"], b["mag"]))
    out

// ---- division: truncated toward zero ---------------------------------------
// Quotient sign = sign(a)*sign(b); the remainder takes the sign of the DIVIDEND
// a, so the identity  a == sn_div(a,b)*b + sn_mod(a,b)  holds EXACTLY for every
// sign combination. Examples (all verifiable by that identity):
//   -7 / 3 = -2, -7 % 3 = -1     ( -2*3  + -1 = -7 )
//    7 /-3 = -2,  7 %-3 =  1     ( -2*-3 +  1 =  7 )
//   -7 /-3 =  2, -7 %-3 = -1     (  2*-3 + -1 = -7 )
//
// sn_divmod_unchecked is the TOTAL engine returning [quotient, remainder].
// CONTRACT: the divisor b MUST be non-zero. Callers that cannot prove that use
// sn_div / sn_mod / sn_divmod below, which reject a zero divisor with err(...).
// A zero divisor here yields [0, 0] defensively (never loops); it is never
// reached through the checked API because that guards first.
fn sn_divmod_unchecked(a: dict, b: dict) -> list
    let z = _sn_make(0, "0")
    let out = []
    if b["sign"] == 0 or a["sign"] == 0
        push(out, z)
        push(out, z)
    else
        let qr = _mag_divmod(a["mag"], b["mag"])
        let qsign = 1
        if a["sign"] != b["sign"]
            qsign = 0 - 1
        push(out, _sn_make(qsign, qr[0]))
        push(out, _sn_make(a["sign"], qr[1]))
    out

// Checked divmod: err on division by zero, else ok([quotient, remainder]).
fn sn_divmod(a: dict, b: dict) -> Result
    if b["sign"] == 0
        return err("bignum: division by zero")
    return ok(sn_divmod_unchecked(a, b))

// Checked quotient (truncated toward zero). err on division by zero.
fn sn_div(a: dict, b: dict) -> Result
    if b["sign"] == 0
        return err("bignum: division by zero")
    let qr = sn_divmod_unchecked(a, b)
    return ok(qr[0])

// Checked remainder (sign of the dividend). err on division by zero.
fn sn_mod(a: dict, b: dict) -> Result
    if b["sign"] == 0
        return err("bignum: division by zero")
    let qr = sn_divmod_unchecked(a, b)
    return ok(qr[1])