// std/numeric/trapezoid.nova
// Trapezoidal numerical integration
// tz_integrate(f, a, b, n) -> float   composite trapezoid rule over n subintervals
// tz_integrate_points(xs, ys) -> float trapezoid rule over sampled data lists
//
// NOTE: f must be a named top-level fn. Its float parameter may arrive as raw
// i64 float-bits in the HOF calling convention; to handle both direct and HOF
// calls, use pow(x, 1.0) to normalize the argument inside f.
// The module applies pow(raw, 1.0) to each call result to normalize the return.

// _tz_call: invoke f(x) and normalize the float return via pow(·,1.0).
// pow uses nova_float_arg internally, which does a bit-reinterpret (i2f) on
// the raw i64 — this correctly converts both direct floats and HOF bit-packed
// returns to the proper double value.
fn _tz_call(f, x) -> float
    let raw = f(x)
    let r = pow(raw, 1.0)
    return r

fn tz_integrate(f, a, b, n) -> float
    let nf = n * 1.0
    let h = (b - a) / nf
    let fa = _tz_call(f, a)
    let fb = _tz_call(f, b)
    let sum = fa + fb
    for i in 1..n
        let if_ = i * 1.0
        let xi = a + if_ * h
        let yi = _tz_call(f, xi)
        sum += 2.0 * yi
    let result = sum * h / 2.0
    return result

fn tz_integrate_points(xs, ys) -> float
    let n = len(xs)
    let sum = 0.0
    for i in 0..(n - 1)
        let x0 = xs[i] * 1.0
        let x1 = xs[i + 1] * 1.0
        let y0 = ys[i] * 1.0
        let y1 = ys[i + 1] * 1.0
        let dx = x1 - x0
        let contrib = (y0 + y1) * dx / 2.0
        sum += contrib
    return sum
