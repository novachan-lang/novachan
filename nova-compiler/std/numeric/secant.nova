// std/numeric/secant.nova
// Secant method root-finding (no derivative required).
// sc_root(f, x0, x1, tol, maxiter) -> float
// Returns the root of f near the bracket [x0, x1].
// Converges when |x1 - x0| < tol or f(x1) == 0.0.

fn sc_root(f, x0, x1, tol, maxiter) -> float
    let sc_xa = x0 * 1.0
    let sc_xb = x1 * 1.0
    let sc_fa = f(sc_xa)
    let sc_fb = f(sc_xb)
    let sc_iter = 0
    let sc_done = 0
    let sc_result = sc_xb
    while sc_done == 0
        let sc_diff = sc_fb - sc_fa
        let sc_xc = 0.0
        if sc_diff == 0.0
            let sc_xc = sc_xb
            let sc_done = 1
        else
            let sc_xc = sc_xb - sc_fb * (sc_xb - sc_xa) / sc_diff
        let sc_fc = f(sc_xc)
        let sc_absdiff = sc_xc - sc_xb
        let sc_abdiff2 = 0.0
        if sc_absdiff < 0.0
            let sc_abdiff2 = 0.0 - sc_absdiff
        else
            let sc_abdiff2 = sc_absdiff
        let sc_result = sc_xc
        let sc_xa = sc_xb
        let sc_fa = sc_fb
        let sc_xb = sc_xc
        let sc_fb = sc_fc
        let sc_iter = sc_iter + 1
        if sc_abdiff2 < tol
            let sc_done = 1
        else
            if sc_iter >= maxiter
                let sc_done = 1
    let sc_out = sc_result
    return sc_out
