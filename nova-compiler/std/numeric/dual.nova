// ============================================================================
// NOVA Standard Library — dual numbers for forward-mode automatic differentiation
// ============================================================================
// A dual number is represented as a dict {"a": float, "b": float}
// where "a" is the real part and "b" is the infinitesimal (dual) part (epsilon).
//
// For f(x) evaluated at x = a + b*eps:
//   f(a + b*eps) = f(a) + f'(a)*b * eps
//
// To compute the derivative of f at point a, call f(du_new(a, 1.0))
// and read the "b" field of the result — that is f'(a).
//
// All private helpers are prefixed _du_ to avoid namespace collisions.

fn _du_f(x) -> float
    return x * 1.0

// Construct a dual number a + b*eps
fn du_new(a, b)
    let ra = _du_f(a)
    let rb = _du_f(b)
    let d = {}
    d["a"] = ra
    d["b"] = rb
    return d

// du_add: (a + b*eps) + (c + d*eps) = (a+c) + (b+d)*eps
fn du_add(x, y)
    let ra = x["a"] + y["a"]
    let rb = x["b"] + y["b"]
    let d = {}
    d["a"] = ra
    d["b"] = rb
    return d

// du_sub: (a + b*eps) - (c + d*eps) = (a-c) + (b-d)*eps
fn du_sub(x, y)
    let ra = x["a"] - y["a"]
    let rb = x["b"] - y["b"]
    let d = {}
    d["a"] = ra
    d["b"] = rb
    return d

// du_mul: (a + b*eps) * (c + d*eps) = a*c + (a*d + b*c)*eps
fn du_mul(x, y)
    let xa = x["a"]
    let xb = x["b"]
    let ya = y["a"]
    let yb = y["b"]
    let ra = xa * ya
    let rb = xa * yb + xb * ya
    let d = {}
    d["a"] = ra
    d["b"] = rb
    return d

// du_scale: scale real part and dual part by scalar s
fn du_scale(x, s)
    let sf = _du_f(s)
    let ra = x["a"] * sf
    let rb = x["b"] * sf
    let d = {}
    d["a"] = ra
    d["b"] = rb
    return d

// du_pow: (a + b*eps)^n = a^n + n * a^(n-1) * b * eps  (integer n >= 0)
fn _du_ipow(base, n) -> float
    let result = 1.0
    let i = 0
    while i < n
        let result = result * base
        let i = i + 1
    return result

fn du_pow(x, n)
    let xa = x["a"]
    let xb = x["b"]
    let ra = _du_ipow(xa, n)
    let d = {}
    if n == 0
        d["a"] = ra
        d["b"] = 0.0
        return d
    let nm1 = n - 1
    let base_pow = _du_ipow(xa, nm1)
    let nf = _du_f(n)
    let rb = nf * base_pow * xb
    d["a"] = ra
    d["b"] = rb
    return d

// du_sin: sin(a + b*eps) = sin(a) + cos(a)*b*eps
fn du_sin(x)
    let xa = x["a"]
    let xb = x["b"]
    let sa = sin(xa)
    let ca = cos(xa)
    let ra = sa
    let rb = ca * xb
    let d = {}
    d["a"] = ra
    d["b"] = rb
    return d

// du_cos: cos(a + b*eps) = cos(a) - sin(a)*b*eps
fn du_cos(x)
    let xa = x["a"]
    let xb = x["b"]
    let sa = sin(xa)
    let ca = cos(xa)
    let ra = ca
    let rb = -(sa * xb)
    let d = {}
    d["a"] = ra
    d["b"] = rb
    return d

// du_exp: exp(a + b*eps) = exp(a) + exp(a)*b*eps
fn du_exp(x)
    let xa = x["a"]
    let xb = x["b"]
    let ea = exp(xa)
    let ra = ea
    let rb = ea * xb
    let d = {}
    d["a"] = ra
    d["b"] = rb
    return d

fn main()
    print("dual module OK")
