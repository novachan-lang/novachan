// ============================================================================
// NOVA Standard Library — Romberg integration
// ============================================================================
// Romberg integration combines the composite trapezoidal rule with Richardson
// extrapolation to achieve high accuracy with few function evaluations.
//
// The Romberg tableau R[i][j] is built iteratively:
//   R[i][0] = composite trapezoid with 2^i subintervals (i = 0..order-1)
//   R[i][j] = (4^j * R[i][j-1] - R[i-1][j-1]) / (4^j - 1)  for j >= 1
//
// rb_integrate(f, a, b, order) -> float
//   f     : integrand, called as f(x) -> float
//   a, b  : integration limits (floats)
//   order : number of rows in the tableau (e.g. 5 or 6); more rows = more accuracy
//
// Implementation note: NOVA list-element assignment (xs[i] = v) is not supported
// for nested lists. The tableau is maintained as a flat list representing the
// CURRENT column being read and a NEW list being built by appending.
//
// Private helpers are prefixed _rb_ to avoid namespace collisions.
// ============================================================================

// _rb_trap: composite trapezoidal rule with n subintervals (n >= 1)
// a, b are floats; n is an int >= 1.
fn _rb_trap(f, a, b, n) -> float
    let fa = f(a)
    let fb = f(b)
    let nf = n * 1.0
    let h = (b - a) / nf
    let sum = fa + fb
    let i = 1
    while i < n
        let xi = a + i * h
        let yi = f(xi)
        sum = sum + 2.0 * yi
        i = i + 1
    let result = h * sum / 2.0
    return result

// _rb_pow4: compute 4^k as a float (k small: 1..order)
fn _rb_pow4(k) -> float
    let r = 1.0
    let i = 0
    while i < k
        let step = r * 4.0
        r = step
        i = i + 1
    return r

// rb_integrate: Romberg integration with `order` tableau rows
// Returns the best estimate: R[order-1][order-1]
fn rb_integrate(f, a, b, order) -> float
    // Column 0: build via trapezoid with 2^i subintervals for i = 0..order-1
    let col = []
    let ni = 1
    let ri = 0
    while ri < order
        let ti = _rb_trap(f, a, b, ni)
        push(col, ti)
        ni = ni * 2
        ri = ri + 1

    // For each Richardson extrapolation column j = 1..order-1:
    // build a new column from the previous one and replace col.
    let j = 1
    while j < order
        let p4 = _rb_pow4(j)
        let den = p4 - 1.0
        // The new column has entries only for ii = j..order-1
        // (entries 0..j-1 are not needed); pad the first j entries with
        // 0.0 (they will never be read) — order-independent, so built as
        // a single comprehension rather than an appending loop.
        let newcol = [0.0 for _ in 0..j]
        let ii = j
        while ii < order
            let prev_col_val = col[ii]
            let prev_row_val = col[ii - 1]
            let num = p4 * prev_col_val - prev_row_val
            let entry = num / den
            push(newcol, entry)
            ii = ii + 1
        col = newcol
        j = j + 1

    let last = order - 1
    let ans = col[last]
    return ans
