// ============================================================================
// NOVA Standard Library — std/numeric/poly_eval
// ============================================================================
// Polynomial evaluation (Horner), differentiation, and quadratic root finding.
//
// Coefficient convention throughout: LOWEST power first.
//   coeffs[0] is the constant term, coeffs[1] is the x coefficient, etc.
//   p(x) = coeffs[0] + coeffs[1]*x + coeffs[2]*x^2 + ...
//
// Public API:
//   poly_eval(coeffs, x)           -> float  Horner evaluation at x
//   poly_derivative(coeffs)        -> list   derivative coefficients (lowest first)
//   poly_roots_quadratic(a, b, c)  -> list   real roots of a*x^2+b*x+c (0,1 or 2)
//
// All private helpers prefixed _pe_ to avoid namespace collisions.
// ============================================================================

// _pe_fabs — float absolute value
fn _pe_fabs(v) -> float
    let r = v * 1.0
    if v < 0.0
        r = 0.0 - v
    return r

// poly_eval — evaluate polynomial at x using Horner's method.
// coeffs: list of floats, lowest power first.
// x: evaluation point (float).
// Horner: ((... * x + c2) * x + c1) * x + c0
fn poly_eval(coeffs, x) -> float
    let n = len(coeffs)
    if n == 0
        return 0.0
    let xf = x * 1.0
    let result = coeffs[n - 1] * 1.0
    let i = n - 2
    while i >= 0
        result = result * xf + coeffs[i] * 1.0
        i = i - 1
    return result

// poly_derivative — compute the formal derivative of a polynomial.
// Input:  coeffs = [c0, c1, c2, ..., cn]   (p(x) = c0 + c1*x + ... + cn*x^n)
// Output: [c1, 2*c2, 3*c3, ..., n*cn]      (p'(x) = c1 + 2*c2*x + ...)
// A constant polynomial (degree 0) has derivative [0.0].
fn poly_derivative(coeffs) -> list
    let n = len(coeffs)
    if n <= 1
        let zero_list = [0.0]
        return zero_list
    let result = []
    for i in 1..n
        let coeff = coeffs[i] * 1.0
        let power = i * 1.0
        push(result, power * coeff)
    return result

// poly_roots_quadratic — find real roots of a*x^2 + b*x + c = 0.
// Returns a list of real roots (may be empty, length 1, or length 2).
// Uses the standard discriminant: disc = b^2 - 4ac.
//   disc > 0  -> two distinct real roots
//   disc == 0 -> one real root (double)
//   disc < 0  -> no real roots (returns empty list)
fn poly_roots_quadratic(a, b, c) -> list
    let af = a * 1.0
    let bf = b * 1.0
    let cf = c * 1.0
    let roots = []
    // Degenerate: not quadratic
    if _pe_fabs(af) < 0.0000000001
        // Linear: b*x + c = 0
        if _pe_fabs(bf) > 0.0000000001
            let r = (0.0 - cf) / bf
            push(roots, r)
        return roots
    let disc = bf * bf - 4.0 * af * cf
    if disc < 0.0 - 0.0000000001
        // No real roots
        return roots
    if _pe_fabs(disc) <= 0.0000000001
        // Double root
        let r = (0.0 - bf) / (2.0 * af)
        push(roots, r)
        return roots
    // Two distinct real roots — return in ascending order
    let sq = sqrt(disc)
    let r1 = (0.0 - bf - sq) / (2.0 * af)
    let r2 = (0.0 - bf + sq) / (2.0 * af)
    if r1 < r2
        push(roots, r1)
        push(roots, r2)
    else
        push(roots, r2)
        push(roots, r1)
    return roots

fn main()
    print("poly_eval module OK")
