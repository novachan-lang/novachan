// ============================================================================
// NOVA Standard Library — std/numeric/sf_beta
// ============================================================================
// Beta function and related combinatorics using an inlined Lanczos gamma.
//
// Beta(a, b) = Gamma(a) * Gamma(b) / Gamma(a+b)
//
// Computed in log-space for numerical stability:
//   ln_beta(a, b) = ln_gamma(a) + ln_gamma(b) - ln_gamma(a+b)
//   beta(a, b) = exp(ln_beta(a, b))
//
// binomial_coeff_float(n, k) = 1 / ((n+1) * beta(n-k+1, k+1))
//   This is the standard identity: C(n,k) = 1/((n+1)*B(n-k+1,k+1))
//
// Lanczos approximation (g=7, 9 coefficients) inlined here so this module
// has no external dependencies.
//
// Public API (prefix bt_):
//   beta(a, b)                   -> float — Beta function B(a,b)
//   ln_beta(a, b)                -> float — log(B(a,b)), numerically stable
//   binomial_coeff_float(n, k)   -> float — C(n,k) as float
//
// All private helpers are prefixed _bt_.
// ============================================================================

// ---- Inlined Lanczos gamma (g=7, 9 coefficients) ---- //

fn _bt_lc0() -> float
    return 0.99999999999980993

fn _bt_lc1() -> float
    return 676.5203681218851

fn _bt_lc2() -> float
    return -1259.1392167224028

fn _bt_lc3() -> float
    return 771.32342877765313

fn _bt_lc4() -> float
    return -176.61502916214059

fn _bt_lc5() -> float
    return 12.507343278686905

fn _bt_lc6() -> float
    return -0.13857109526572012

fn _bt_lc7() -> float
    return 0.0000099843695780195716

fn _bt_lc8() -> float
    return 0.00000015056327351493116

fn _bt_ln_sqrt_2pi() -> float
    return 0.9189385332046727

fn _bt_pi() -> float
    return 3.141592653589793

// Lanczos rational sum: c0 + sum_{k=1}^{8} c[k] / (z + k)
// where z = x - 1 (x is the gamma argument, x >= 0.5)
fn _bt_sum(z) -> float
    let zf = z * 1.0
    let s = _bt_lc0()
    let d1 = zf + 1.0
    let v1 = _bt_lc1() / d1
    s += v1
    let d2 = zf + 2.0
    let v2 = _bt_lc2() / d2
    s += v2
    let d3 = zf + 3.0
    let v3 = _bt_lc3() / d3
    s += v3
    let d4 = zf + 4.0
    let v4 = _bt_lc4() / d4
    s += v4
    let d5 = zf + 5.0
    let v5 = _bt_lc5() / d5
    s += v5
    let d6 = zf + 6.0
    let v6 = _bt_lc6() / d6
    s += v6
    let d7 = zf + 7.0
    let v7 = _bt_lc7() / d7
    s += v7
    let d8 = zf + 8.0
    let v8 = _bt_lc8() / d8
    s += v8
    return s

// _bt_ln_gamma(x): log-Gamma for x > 0.
// Lanczos: ln(G(z)) = ln_sqrt_2pi + (z-0.5)*ln(z+6.5) - (z+6.5) + ln(sum(z-1))
fn _bt_ln_gamma(x) -> float
    let xf = x * 1.0
    let z = xf
    let zm1 = z - 1.0
    let lsum = log(_bt_sum(zm1))
    let base = zm1 + 7.5
    let lbase = log(base)
    let t1 = (zm1 + 0.5) * lbase
    let t2 = -base
    let result = _bt_ln_sqrt_2pi() + t1 + t2 + lsum
    return result

// _bt_gamma(x): Gamma(x) for real x.
// Uses reflection for x < 0.5: Gamma(x) = pi/(sin(pi*x)*Gamma(1-x))
fn _bt_gamma(x) -> float
    let xf = x * 1.0
    if xf < 0.5
        let pix = _bt_pi() * xf
        let sp = sin(pix)
        let lg = _bt_ln_gamma(1.0 - xf)
        let eg = exp(lg)
        let denom = sp * eg
        let result = _bt_pi() / denom
        return result
    let lg = _bt_ln_gamma(xf)
    let result = exp(lg)
    return result

// ---- Public API ---- //

// ln_beta(a, b): log(Beta(a,b)) = ln_gamma(a) + ln_gamma(b) - ln_gamma(a+b).
// Numerically stable for large a, b.
fn ln_beta(a, b) -> float
    let af = a * 1.0
    let bf = b * 1.0
    let la = _bt_ln_gamma(af)
    let lb = _bt_ln_gamma(bf)
    let lab = _bt_ln_gamma(af + bf)
    let result = la + lb - lab
    return result

// beta(a, b): Beta function B(a,b) = Gamma(a)*Gamma(b)/Gamma(a+b).
// Computed via exp(ln_beta(a,b)) for numerical stability.
// ln_beta returns a float that may be an i64 bit-pattern; unbox via pow(x,1.0).
fn beta(a, b) -> float
    let lb = ln_beta(a, b)
    let lbu = pow(lb, 1.0)
    let result = exp(lbu)
    return result

// binomial_coeff_float(n, k): C(n,k) as float.
// Identity: C(n,k) = 1 / ((n+1) * Beta(n-k+1, k+1))
// This avoids direct factorial computation for large n.
fn binomial_coeff_float(n, k) -> float
    let nf = n * 1.0
    let kf = k * 1.0
    let a = nf - kf + 1.0
    let b = kf + 1.0
    let bt = beta(a, b)
    let denom = (nf + 1.0) * bt
    let result = 1.0 / denom
    return result
