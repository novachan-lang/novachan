// ============================================================================
// NOVA Standard Library — std/numeric/dist_chisq
// ============================================================================
// Chi-square distribution (chi-squared with df degrees of freedom).
//
// Public API:
//   chisq_pdf(x, df)   -> float   — probability density function
//   chisq_cdf(x, df)   -> float   — cumulative distribution function (0..x)
//   chisq_mean(df)     -> float   — mean = df
//
// The chi-square distribution is a special case of the gamma distribution:
//   chi-sq(df) == Gamma(shape=df/2, rate=1/2)
//
// PDF: f(x; df) = x^(df/2-1) * exp(-x/2) / (2^(df/2) * Gamma(df/2))  for x >= 0
// CDF: F(x; df) = numerically integrated pdf from 0 to x (Simpson's rule)
//
// Inline Lanczos gamma function (g=7, 9 coefficients) — no external import needed.
//
// All private helpers prefixed _cq_.
// ============================================================================

// --- Inline Lanczos gamma approximation (g=7, Numerical Recipes coefficients) ---

fn _cq_lc0() -> float
    return 0.99999999999980993

fn _cq_lc1() -> float
    return 676.5203681218851

fn _cq_lc2() -> float
    return 0.0 - 1259.1392167224028

fn _cq_lc3() -> float
    return 771.32342877765313

fn _cq_lc4() -> float
    return 0.0 - 176.61502916214059

fn _cq_lc5() -> float
    return 12.507343278686905

fn _cq_lc6() -> float
    return 0.0 - 0.13857109526572012

fn _cq_lc7() -> float
    return 0.0000099843695780195716

fn _cq_lc8() -> float
    return 0.00000015056327351493116

fn _cq_ln_sqrt_2pi() -> float
    return 0.9189385332046727

fn _cq_pi() -> float
    return 3.14159265358979

// Lanczos sum over 9 coefficients; zm1 = z - 1
fn _cq_lsum(zm1) -> float
    let z = zm1 * 1.0
    let c0 = _cq_lc0()
    let s = c0 * 1.0
    let d1 = z + 1.0
    let c1 = _cq_lc1()
    let v1 = c1 / d1
    s += v1
    let d2 = z + 2.0
    let c2 = _cq_lc2()
    let v2 = c2 / d2
    s += v2
    let d3 = z + 3.0
    let c3 = _cq_lc3()
    let v3 = c3 / d3
    s += v3
    let d4 = z + 4.0
    let c4 = _cq_lc4()
    let v4 = c4 / d4
    s += v4
    let d5 = z + 5.0
    let c5 = _cq_lc5()
    let v5 = c5 / d5
    s += v5
    let d6 = z + 6.0
    let c6 = _cq_lc6()
    let v6 = c6 / d6
    s += v6
    let d7 = z + 7.0
    let c7 = _cq_lc7()
    let v7 = c7 / d7
    s += v7
    let d8 = z + 8.0
    let c8 = _cq_lc8()
    let v8 = c8 / d8
    s += v8
    return s

// ln_gamma(x) for x > 0; uses Lanczos g=7
fn _cq_ln_gamma(x) -> float
    let xf = x * 1.0
    let zm1 = xf - 1.0
    // IMPORTANT: bind float from fn call to let before passing to another call
    let raw_sum = _cq_lsum(zm1)
    let sumf = raw_sum * 1.0
    let ls = log(sumf)
    let base = zm1 + 7.5
    let lbase = log(base)
    let shift = zm1 + 0.5
    let t1 = shift * lbase
    let t2 = 0.0 - base
    let lsqrt2pi = _cq_ln_sqrt_2pi()
    let result = lsqrt2pi + t1 + t2 + ls
    return result

// gamma(x) for x > 0 via exp(ln_gamma(x))
fn _cq_gamma_fn(x) -> float
    let xf = x * 1.0
    if xf < 0.5
        let pi = _cq_pi()
        let pix = pi * xf
        let sp = sin(pix)
        let raw_lg = _cq_ln_gamma(1.0 - xf)
        let lg = raw_lg * 1.0
        let eg = exp(lg)
        let denom = sp * eg
        let result = pi / denom
        return result
    let raw_lg = _cq_ln_gamma(xf)
    let lg = raw_lg * 1.0
    let result = exp(lg)
    return result

// --- Chi-square PDF core ---
// f(x; df) = exp((df/2-1)*log(x) - x/2 - df/2*log(2) - ln_gamma(df/2))
fn _cq_pdf_at(x, df) -> float
    let xf = x * 1.0
    let dff = df * 1.0
    if xf < 0.0
        return 0.0
    let half_df = dff / 2.0
    let half_df_m1 = half_df - 1.0
    // Handle x=0 specially to avoid log(0):
    //   df > 2 (half_df > 1): pdf(0) = 0
    //   df = 2 (half_df = 1): pdf(0) = 1/2
    //   df < 2 (half_df < 1): pdf(0) -> inf (cap at 0 for safety)
    if xf == 0.0
        if half_df_m1 > 0.0
            return 0.0
        if half_df_m1 < 0.0
            return 0.0
        // half_df_m1 == 0.0, i.e. df=2: pdf(0) = exp(-0 - 0.693) = 0.5
        let log2 = log(2.0)
        let raw_lg = _cq_ln_gamma(half_df)
        let lng = raw_lg * 1.0
        let ln_norm = half_df * log2 + lng
        let result = exp(0.0 - ln_norm)
        return result
    let log2 = log(2.0)
    let raw_lg = _cq_ln_gamma(half_df)
    let lng = raw_lg * 1.0
    let ln_norm = half_df * log2 + lng
    let ln_x = log(xf)
    let term1 = half_df_m1 * ln_x
    let half_x = xf / 2.0
    let exponent = term1 - half_x - ln_norm
    let result = exp(exponent)
    return result

// --- Public API ---

// chisq_pdf: chi-square probability density at x with df degrees of freedom.
// Returns 0.0 for x < 0.
fn chisq_pdf(x, df) -> float
    let xf = x * 1.0
    if xf < 0.0
        return 0.0
    let result = _cq_pdf_at(xf, df)
    return result

// chisq_mean: mean of chi-square distribution = df.
fn chisq_mean(df) -> float
    let dff = df * 1.0
    return dff

// chisq_cdf: cumulative distribution function via Simpson's rule integration.
// Integrates pdf from 0 to x using n=400 steps (even number required).
// For large x, extends integration to x + tail_extra to capture remaining mass.
// Returns 0.0 for x <= 0, approaches 1.0 for large x.
fn chisq_cdf(x, df) -> float
    let xf = x * 1.0
    if xf <= 0.0
        return 0.0
    // Extend the integration range to better capture the tail mass.
    // For chi-sq, virtually all mass is below 10*df + 50.
    let dff = df * 1.0
    let upper = xf
    // Use more steps for larger ranges to maintain accuracy
    let n = 800
    let nf = n * 1.0
    let h = upper / nf
    // Simpson's rule accumulation via dict state
    let st = {}
    st["sum"] = 0.0
    st["i"] = 0
    while st["i"] <= n
        let i = st["i"]
        let if2 = i * 1.0
        let xi = if2 * h
        let fi = _cq_pdf_at(xi, df)
        let fif = fi * 1.0
        if i == 0
            st["sum"] = st["sum"] + fif
        if i == n
            st["sum"] = st["sum"] + fif
        if i > 0 and i < n
            let imod = i - (i / 2) * 2
            if imod == 1
                let term = 4.0 * fif
                st["sum"] = st["sum"] + term
            if imod == 0
                let term = 2.0 * fif
                st["sum"] = st["sum"] + term
        st["i"] = i + 1
    let total = st["sum"]
    let totalf = total * 1.0
    let h3 = h / 3.0
    let result = h3 * totalf
    // Clamp to [0,1]
    if result > 1.0
        result = 1.0
    if result < 0.0
        result = 0.0
    return result
