// ============================================================================
// NOVA Standard Library — Lagrange polynomial interpolation
// ============================================================================
// Given n data points (xs[i], ys[i]), the Lagrange interpolating polynomial
// is the unique polynomial of degree <= n-1 that passes through all points.
//
// lg_interpolate(xs, ys, x) -> float
//   Classical Lagrange formula:
//     P(x) = sum_i [ y_i * prod_{j!=i} (x - x_j) / (x_i - x_j) ]
//   xs, ys: float lists of equal length (n >= 1)
//   x     : query point
//   Returns the interpolated value P(x).
//
// lg_neville(xs, ys, x) -> float
//   Neville's algorithm — builds the same polynomial via a triangular table
//   Q[i][j] = polynomial through (xs[i], ys[i])..(xs[i+j], ys[i+j]).
//   Numerically equivalent result; slightly more numerically stable on
//   large n, and avoids the catastrophic cancellation in the naive product.
//
// Private helpers are prefixed _lg_ to avoid namespace collisions.
// ============================================================================

// _lg_basis: compute the i-th Lagrange basis polynomial L_i(x) for node set xs
fn _lg_basis(xs, i, x) -> float
    let n = len(xs)
    let prod = 1.0
    let xi = xs[i]
    let j = 0
    while j < n
        if j != i
            let xj = xs[j]
            let num = x - xj
            let den = xi - xj
            prod = prod * num / den
        j = j + 1
    return prod

// lg_interpolate: classical Lagrange interpolation at point x
fn lg_interpolate(xs, ys, x) -> float
    let n = len(xs)
    let sum = 0.0
    let i = 0
    while i < n
        let li = _lg_basis(xs, i, x)
        let yi = ys[i]
        sum = sum + yi * li
        i = i + 1
    return sum

// lg_neville: Neville's algorithm for the same polynomial
// Builds an n x n lower-triangular table Q where Q[i][0] = ys[i] and
//   Q[i][j] = ((x - xs[i-j]) * Q[i][j-1] - (x - xs[i]) * Q[i-1][j-1])
//             / (xs[i] - xs[i-j])
// The answer is Q[n-1][n-1].
fn lg_neville(xs, ys, x) -> float
    let n = len(xs)
    // Allocate n x n table, pre-filled with 0.0
    let q = []
    let i = 0
    while i < n
        let row = []
        let j = 0
        while j < n
            row.push(0.0)
            j = j + 1
        q.push(row)
        i = i + 1
    // Initialise first column with y values
    let k = 0
    while k < n
        q[k][0] = ys[k]
        k = k + 1
    // Fill remaining columns
    let col = 1
    while col < n
        let row = col
        while row < n
            let xi = xs[row]
            let xij = xs[row - col]
            let den = xi - xij
            let top = (x - xij) * q[row][col - 1] - (x - xi) * q[row - 1][col - 1]
            q[row][col] = top / den
            row = row + 1
        col = col + 1
    let last = n - 1
    let ans = q[last][last]
    return ans
