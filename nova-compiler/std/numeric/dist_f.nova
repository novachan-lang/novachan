// ============================================================================
// NOVA Standard Library — std/numeric/dist_f
// ============================================================================
// F-distribution (ratio of chi-squared variates, scaled by degrees of freedom).
//
// Public API:
//   f_pdf(x, d1, d2)   -> float   — probability density function
//   f_cdf(x, d1, d2)   -> float   — cumulative distribution function (0..x)
//   f_mean(d1, d2)     -> float   — mean = d2/(d2-2) for d2>2, else 0
//
// PDF: f(x; d1, d2) = sqrt((d1*x)^d1 * d2^d2 / (d1*x+d2)^(d1+d2))
//                     / (x * Beta(d1/2, d2/2))     for x > 0
// Written in log-space:
//   ln_pdf = 0.5*(d1*ln(d1*x) + d2*ln(d2) - (d1+d2)*ln(d1*x+d2))
//            - ln(x) - ln_beta(d1/2, d2/2)
// where ln_beta(a,b) = ln_gamma(a) + ln_gamma(b) - ln_gamma(a+b)
//
// CDF: numerically integrated via Simpson's rule (n=600 steps).
//
// Inline Lanczos gamma (g=7, 9 coefficients) — no external import.
//
// All private helpers prefixed _ff_.
// ============================================================================

// --- Inline Lanczos gamma (g=7, Numerical Recipes) ---

fn _ff_lc0() -> float
    return 0.99999999999980993

fn _ff_lc1() -> float
    return 676.5203681218851

fn _ff_lc2() -> float
    return 0.0 - 1259.1392167224028

fn _ff_lc3() -> float
    return 771.32342877765313

fn _ff_lc4() -> float
    return 0.0 - 176.61502916214059

fn _ff_lc5() -> float
    return 12.507343278686905

fn _ff_lc6() -> float
    return 0.0 - 0.13857109526572012

fn _ff_lc7() -> float
    return 0.0000099843695780195716

fn _ff_lc8() -> float
    return 0.00000015056327351493116

fn _ff_ln_sqrt_2pi() -> float
    return 0.9189385332046727

fn _ff_pi() -> float
    return 3.14159265358979

fn _ff_lsum(zm1) -> float
    let z = zm1 * 1.0
    let c0 = _ff_lc0()
    let s = c0 * 1.0
    let c1 = _ff_lc1()
    let d1 = z + 1.0
    let v1 = c1 / d1
    s += v1
    let c2 = _ff_lc2()
    let d2 = z + 2.0
    let v2 = c2 / d2
    s += v2
    let c3 = _ff_lc3()
    let d3 = z + 3.0
    let v3 = c3 / d3
    s += v3
    let c4 = _ff_lc4()
    let d4 = z + 4.0
    let v4 = c4 / d4
    s += v4
    let c5 = _ff_lc5()
    let d5 = z + 5.0
    let v5 = c5 / d5
    s += v5
    let c6 = _ff_lc6()
    let d6 = z + 6.0
    let v6 = c6 / d6
    s += v6
    let c7 = _ff_lc7()
    let d7 = z + 7.0
    let v7 = c7 / d7
    s += v7
    let c8 = _ff_lc8()
    let d8 = z + 8.0
    let v8 = c8 / d8
    s += v8
    return s

fn _ff_ln_gamma(x) -> float
    let xf = x * 1.0
    let zm1 = xf - 1.0
    let raw_sum = _ff_lsum(zm1)
    let sumf = raw_sum * 1.0
    let ls = log(sumf)
    let base = zm1 + 7.5
    let lbase = log(base)
    let shift = zm1 + 0.5
    let t1 = shift * lbase
    let t2 = 0.0 - base
    let lsp2 = _ff_ln_sqrt_2pi()
    let result = lsp2 + t1 + t2 + ls
    return result

// ln_beta(a, b) = ln_gamma(a) + ln_gamma(b) - ln_gamma(a+b)
fn _ff_ln_beta(a, b) -> float
    let af = a * 1.0
    let bf = b * 1.0
    let raw_la = _ff_ln_gamma(af)
    let la = raw_la * 1.0
    let raw_lb = _ff_ln_gamma(bf)
    let lb = raw_lb * 1.0
    let raw_lab = _ff_ln_gamma(af + bf)
    let lab = raw_lab * 1.0
    let result = la + lb - lab
    return result

// --- F-distribution PDF core ---
// For x > 0:
// ln f(x; d1, d2) = (d1/2-1)*ln(x) + d1/2*ln(d1) + d2/2*ln(d2)
//                  - (d1+d2)/2*ln(d1*x+d2) - ln_beta(d1/2, d2/2)
fn _ff_pdf_at(x, d1, d2) -> float
    let xf = x * 1.0
    let d1f = d1 * 1.0
    let d2f = d2 * 1.0
    if xf <= 0.0
        return 0.0
    let hd1 = d1f / 2.0
    let hd2 = d2f / 2.0
    // Bind each float fn return before use
    let raw_lb = _ff_ln_beta(hd1, hd2)
    let lbeta = raw_lb * 1.0
    let raw_lx = log(xf)
    let lx = raw_lx * 1.0
    let raw_ld1 = log(d1f)
    let ld1 = raw_ld1 * 1.0
    let raw_ld2 = log(d2f)
    let ld2 = raw_ld2 * 1.0
    let d1x = d1f * xf
    let d1xd2 = d1x + d2f
    let raw_ld1xd2 = log(d1xd2)
    let ld1xd2 = raw_ld1xd2 * 1.0
    let sum_d = d1f + d2f
    let half_sum = sum_d / 2.0
    let hd1_m1 = hd1 - 1.0
    let t1 = hd1_m1 * lx
    let t2 = hd1 * ld1
    let t3 = hd2 * ld2
    let t4 = half_sum * ld1xd2
    let exponent = t1 + t2 + t3 - t4 - lbeta
    let raw_res = exp(exponent)
    let result = raw_res * 1.0
    return result

// --- Public API ---

// f_pdf: F-distribution probability density at x with d1, d2 degrees of freedom.
// Returns 0.0 for x <= 0.
fn f_pdf(x, d1, d2) -> float
    let xf = x * 1.0
    if xf <= 0.0
        return 0.0
    let result = _ff_pdf_at(xf, d1, d2)
    return result

// f_mean: mean of F-distribution = d2/(d2-2) for d2 > 2, else undefined (0.0).
fn f_mean(d1, d2) -> float
    let d2f = d2 * 1.0
    if d2f <= 2.0
        return 0.0
    let result = d2f / (d2f - 2.0)
    return result

// f_cdf: cumulative distribution function via adaptive Simpson's rule.
// Integrates pdf from 0 to x. For large x the F-distribution approaches 1.
// n=600 steps; uses an upper bound capped at min(x, very_large) for safety.
fn f_cdf(x, d1, d2) -> float
    let xf = x * 1.0
    if xf <= 0.0
        return 0.0
    let n = 600
    let nf = n * 1.0
    // Start just above 0 to avoid singularity at x=0 when d1 < 2
    let eps = xf / (nf * 1000.0)
    let lo = eps
    let hi = xf
    let h = (hi - lo) / nf
    let st = {}
    st["sum"] = 0.0
    st["i"] = 0
    while st["i"] <= n
        let i = st["i"]
        let if2 = i * 1.0
        let xi = lo + if2 * h
        let fi = _ff_pdf_at(xi, d1, d2)
        let fif = fi * 1.0
        if i == 0
            st["sum"] = st["sum"] + fif
        if i == n
            st["sum"] = st["sum"] + fif
        if i > 0 and i < n
            let imod = i - (i / 2) * 2
            if imod == 1
                let term = 4.0 * fif
                st["sum"] = st["sum"] + term
            if imod == 0
                let term = 2.0 * fif
                st["sum"] = st["sum"] + term
        st["i"] = i + 1
    let total = st["sum"]
    let totalf = total * 1.0
    let h3 = h / 3.0
    let result = h3 * totalf
    if result > 1.0
        result = 1.0
    if result < 0.0
        result = 0.0
    return result
