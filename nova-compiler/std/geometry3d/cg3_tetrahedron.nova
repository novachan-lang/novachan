// std/geometry3d/cg3_tetrahedron.nova — 3-D tetrahedron exact arithmetic.
//
// Points are 3-element int lists [x,y,z].
// 6 * signed volume = scalar triple product (b-a) . ((c-a) x (d-a)).
// Centroid = [sum_x, sum_y, sum_z, 4] (exact, denominator always 4).
//
// Public API (prefix cgt3_):
//   cgt3_volume_6x(a,b,c,d)      -> int    6 * signed volume (scalar triple product)
//   cgt3_volume_abs_6x(a,b,c,d)  -> int    6 * absolute volume
//   cgt3_centroid(a,b,c,d)       -> list   [sx, sy, sz, 4] exact centroid
//   cgt3_is_degenerate(a,b,c,d)  -> bool   true if all four points are coplanar (volume == 0)
//
// LEAF — imports nothing.

// _cgt3_iabs: absolute value of an integer.
fn _cgt3_iabs(x: int) -> int
    -x if x < 0 else x

// cgt3_volume_6x: 6 * signed volume of the tetrahedron a,b,c,d.
// = (b-a) . ((c-a) x (d-a))
fn cgt3_volume_6x(a: list, b: list, c: list, d: list) -> int
    let bax = b[0] - a[0]
    let bay = b[1] - a[1]
    let baz = b[2] - a[2]
    let cax = c[0] - a[0]
    let cay = c[1] - a[1]
    let caz = c[2] - a[2]
    let dax = d[0] - a[0]
    let day = d[1] - a[1]
    let daz = d[2] - a[2]
    let cx = cay * daz - caz * day
    let cy = caz * dax - cax * daz
    let cz = cax * day - cay * dax
    bax * cx + bay * cy + baz * cz

// cgt3_volume_abs_6x: 6 * absolute volume of the tetrahedron a,b,c,d.
fn cgt3_volume_abs_6x(a: list, b: list, c: list, d: list) -> int
    _cgt3_iabs(cgt3_volume_6x(a, b, c, d))

// cgt3_centroid: exact centroid as [sx, sy, sz, 4] where centroid = (sx/4, sy/4, sz/4).
// sx = a[0]+b[0]+c[0]+d[0], etc.
fn cgt3_centroid(a: list, b: list, c: list, d: list) -> list
    let sx = a[0] + b[0] + c[0] + d[0]
    let sy = a[1] + b[1] + c[1] + d[1]
    let sz = a[2] + b[2] + c[2] + d[2]
    let r = []
    push(r, sx)
    push(r, sy)
    push(r, sz)
    push(r, 4)
    r

// cgt3_is_degenerate: true if the four points are coplanar (6*volume == 0).
fn cgt3_is_degenerate(a: list, b: list, c: list, d: list) -> bool
    cgt3_volume_6x(a, b, c, d) == 0
