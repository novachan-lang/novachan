// std/geometry3d/cg3_triangle3.nova — 3D triangle predicates in exact integer arithmetic.
//
// A 3D point is a 3-element integer list [x, y, z].
// All arithmetic is EXACT INTEGER — no floats, no sqrt, no rounding.
// Degenerate inputs (collinear or coincident vertices) are handled correctly.
// LEAF — imports NOTHING.

// cgtr3_sub: vector subtraction b - a.
fn cgtr3_sub(a: list, b: list) -> list
    let r = [b[0]-a[0], b[1]-a[1], b[2]-a[2]]
    r

// cgtr3_cross: cross product u x v.
fn cgtr3_cross(u: list, v: list) -> list
    let r = [u[1]*v[2]-u[2]*v[1], u[2]*v[0]-u[0]*v[2], u[0]*v[1]-u[1]*v[0]]
    r

// cgtr3_normal: cross product (b-a) x (c-a); the face normal (unnormalised).
// Returns [0,0,0] for degenerate (collinear/coincident) triangles.
fn cgtr3_normal(a: list, b: list, c: list) -> list
    let e1 = cgtr3_sub(a, b)
    let e2 = cgtr3_sub(a, c)
    cgtr3_cross(e1, e2)

// cgtr3_area_sq_4x: |cross((b-a),(c-a))|^2 = 4 * area^2.
// Returns 0 for degenerate triangles.
fn cgtr3_area_sq_4x(a: list, b: list, c: list) -> int
    let n = cgtr3_normal(a, b, c)
    n[0]*n[0] + n[1]*n[1] + n[2]*n[2]

// cgtr3_centroid: returns [sx, sy, sz, 3] where sx = a[0]+b[0]+c[0], etc.
// The true centroid is (sx/3, sy/3, sz/3); the denominator 3 is returned explicitly.
fn cgtr3_centroid(a: list, b: list, c: list) -> list
    let r = [a[0]+b[0]+c[0], a[1]+b[1]+c[1], a[2]+b[2]+c[2], 3]
    r

// cgtr3_is_degenerate: true iff a, b, c are collinear or coincident.
// Collinear means the cross product (b-a) x (c-a) is the zero vector.
fn cgtr3_is_degenerate(a: list, b: list, c: list) -> bool
    let n = cgtr3_normal(a, b, c)
    let mag2 = n[0]*n[0] + n[1]*n[1] + n[2]*n[2]
    mag2 == 0
