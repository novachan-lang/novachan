// std/template/simple — double-brace {{key}} template engine
//
// WHAT:
//   Mustache-style {{key}} placeholder substitution from a plain dict of
//   values, plus helpers to detect and enumerate the placeholders in a
//   template string. A missing key renders as "" (never crashes) — this
//   matches the non-failing sibling in std/text/template.nova
//   (template_render), just under the tpl_ prefix and dict-arg shape this
//   module's caller specified.
//
// Brace detection uses byte values (123 = '{', 125 = '}') via
// ord(char_at(s,i)) — NEVER bare "{"/"}" string-literal comparisons, which
// inside a NOVA string literal would themselves be parsed as
// INTERPOLATION at compile time (see std/text/template.nova's header for
// the same caution, confirmed live in this codebase).
//
// An unterminated "{{..." (no closing "}}" before end of string) degrades
// to literal text rather than erroring — malformed input never crashes the
// scanner.
//
// Public API:
//   tpl_render(template_str, vars_dict)      -> str    Substitute every
//                                                       {{key}} with
//                                                       str(vars_dict[key]);
//                                                       a missing key
//                                                       renders as "".
//   tpl_has_vars(template_str)               -> bool   True iff the template
//                                                       contains at least one
//                                                       well-formed {{key}}
//                                                       placeholder.
//   tpl_extract_vars(template_str)           -> list   Distinct key names,
//                                                       first-seen order.
//   tpl_render_list(template_str, list_of_dicts) -> list  tpl_render applied
//                                                       once per dict in
//                                                       list_of_dicts, in
//                                                       order.
//
// LEAF — imports nothing.
// ============================================================================

// _ts_parse: scan `template` into an ordered token list. Each token is a
// 2-element list [kind, text]: kind "L" = literal text, kind "K" = a
// {{key}} placeholder name (already trimmed). One left-to-right byte scan
// with a nested while for the key body — no unrolling, no duplicated
// blocks.
fn _ts_parse(template) -> list
    let toks = []
    let lit = ""
    let i = 0
    let n = len(template)
    while i < n
        if i + 1 < n and ord(char_at(template, i)) == 123 and ord(char_at(template, i + 1)) == 123
            // Opening "{{" — flush any pending literal text first.
            if len(lit) > 0
                toks.push(["L", lit])
                lit = ""
            let j = i + 2
            let key = ""
            let closed = false
            while j + 1 < n and not closed
                if ord(char_at(template, j)) == 125 and ord(char_at(template, j + 1)) == 125
                    closed = true
                else
                    key += char_at(template, j)
                    j += 1
            if closed
                toks.push(["K", trim(key)])
                i = j + 2
            else
                // Unterminated "{{..." — degrade to literal text. Consume
                // any trailing unscanned char first so no byte is dropped.
                while j < n
                    key += char_at(template, j)
                    j += 1
                lit += char_at(template, i) + char_at(template, i + 1) + key
                i = n
        else
            lit += char_at(template, i)
            i += 1
    if len(lit) > 0
        toks.push(["L", lit])
    return toks

// tpl_render: substitute every {{key}} in `template_str` with
// str(vars_dict[key]); a key missing from vars_dict renders as "".
fn tpl_render(template_str, vars_dict) -> str
    let toks = _ts_parse(template_str)
    let n = len(toks)
    let out_parts = []
    for i in 0..n
        let tok = toks[i]
        if tok[0] == "L"
            push(out_parts, tok[1])
        else
            if tok[1] in vars_dict
                push(out_parts, str(vars_dict[tok[1]]))
    let out = join(out_parts, "")
    return out

// tpl_has_vars: true iff template_str contains at least one well-formed
// {{key}} placeholder.
fn tpl_has_vars(template_str) -> bool
    let toks = _ts_parse(template_str)
    let n = len(toks)
    for i in 0..n
        if toks[i][0] == "K"
            return true
    return false

// tpl_extract_vars: distinct {{key}} names referenced in template_str, in
// first-seen order.
fn tpl_extract_vars(template_str) -> list
    let toks = _ts_parse(template_str)
    let n = len(toks)
    let seen = {}
    let out = []
    for i in 0..n
        let tok = toks[i]
        if tok[0] == "K"
            let k = tok[1]
            if k in seen == false
                seen[k] = 1
                out.push(k)
    return out

// tpl_render_list: render template_str once per dict in list_of_dicts,
// returning the list of rendered strings in the same order.
fn tpl_render_list(template_str, list_of_dicts) -> list
    let n = len(list_of_dicts)
    let out = []
    for i in 0..n
        out.push(tpl_render(template_str, list_of_dicts[i]))
    return out

fn main()
    print("template simple module loaded")
