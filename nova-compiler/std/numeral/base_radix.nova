// std/numeral/base_radix -- Integer <-> arbitrary base (2..36) string conversion.
// Digits: 0-9 then A-Z (uppercase). Handles 0 and negative integers.
//
// Public API:
//   br_to_base(n, base) -> string  -- encode integer n in given base (2..36)
//   br_from_base(s, base) -> int   -- decode base-N string to integer (accepts lower/uppercase)
//   br_is_valid(s, base) -> bool   -- true iff s is a valid numeral in the given base
//
// LEAF -- imports NOTHING.

// Private: map digit value 0..35 to its character.
fn _br_digit_char(v: int) -> string
    let result = ""
    if v < 10
        result = chr(48 + v)
    else
        result = chr(65 + (v - 10))
    result

// Private: map a character to its digit value in a given base; returns -1 if invalid.
fn _br_char_val(ch: string, base: int) -> int
    let code = ord(ch)
    let val = -1
    if code >= 48 and code <= 57
        // '0'..'9'
        let dv = code - 48
        if dv < base
            val = dv
    else if code >= 65 and code <= 90
        // 'A'..'Z'
        let dv = (code - 65) + 10
        if dv < base
            val = dv
    else if code >= 97 and code <= 122
        // 'a'..'z' -- accept lowercase
        let dv = (code - 97) + 10
        if dv < base
            val = dv
    val

// Encode integer n to a string in the given base (2..36).
// Returns '0' for n=0; prepends '-' for negative n.
fn br_to_base(n: int, base: int) -> string
    if n == 0
        return "0"
    let neg = false
    let cur = n
    if cur < 0
        neg = true
        cur = 0 - cur
    let digits = ""
    while cur > 0
        let rem = cur % base
        digits = _br_digit_char(rem) + digits
        cur = cur / base
    if neg
        digits = "-" + digits
    digits

// Decode a base-N string to an integer. Accepts lowercase or uppercase letters.
// Leading '-' indicates negative. Assumes the input is valid.
fn br_from_base(s: string, base: int) -> int
    let slen = len(s)
    if slen == 0
        return 0
    let neg = false
    let start = 0
    if slice(s, 0, 1) == "-"
        neg = true
        start = 1
    let acc = 0
    let i = start
    while i < slen
        let ch = slice(s, i, i + 1)
        let v = _br_char_val(ch, base)
        if v >= 0
            acc = acc * base + v
        i = i + 1
    if neg
        acc = 0 - acc
    acc

// Return true iff s is a valid numeral in the given base.
// Accepts an optional leading '-' followed by at least one digit.
fn br_is_valid(s: string, base: int) -> bool
    let slen = len(s)
    if slen == 0
        return false
    let start = 0
    if slice(s, 0, 1) == "-"
        start = 1
    if start >= slen
        return false
    let ok = true
    let i = start
    while i < slen
        let ch = slice(s, i, i + 1)
        let v = _br_char_val(ch, base)
        if v < 0
            ok = false
        i = i + 1
    ok
