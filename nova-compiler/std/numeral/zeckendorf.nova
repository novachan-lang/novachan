// std/numeral/zeckendorf -- Zeckendorf representation: every positive integer is uniquely
// representable as a sum of non-consecutive Fibonacci numbers (Zeckendorf's theorem).
// Fibonacci set used: 1, 2, 3, 5, 8, 13, 21, ... (F(2), F(3), F(4), ... in 1-indexed).
//
// Public API:
//   zk_encode(n: int) -> list   -- greedy encode; returns Fibonacci values used, descending
//   zk_decode(xs: list) -> int  -- sum of elements
//   zk_is_valid(xs: list) -> bool -- descending distinct Fibs, no two consecutive Fibonacci indices
//
// LEAF -- imports NOTHING.

// Private: build the Fibonacci sequence up to and including values <= cap (cap >= 1).
// Returns list in ascending order starting 1, 2, 3, 5, 8, ...
fn _zk_fibs_upto(cap: int) -> list
    let fibs = []
    let a = 1
    let b = 2
    fibs.push(a)
    while b <= cap
        fibs.push(b)
        let c = a + b
        a = b
        b = c
    fibs

// Private: return the index (0-based position in ascending Fib list) of value v,
// or -1 if v is not a Fibonacci number. Searches the given fibs list.
fn _zk_fib_index(fibs: list, v: int) -> int
    let idx = -1
    for i in 0..len(fibs)
        if fibs[i] == v
            idx = i
    idx

// Encode n (n >= 0) as Zeckendorf representation.
// Returns a list of Fibonacci values in descending order whose sum equals n.
// For n=0 returns empty list.
fn zk_encode(n: int) -> list
    if n <= 0
        return []
    let fibs = _zk_fibs_upto(n)
    let result = []
    let rem = n
    // Walk fib list from largest to smallest (greedy).
    let i = len(fibs) - 1
    while i >= 0
        let f = fibs[i]
        if f <= rem
            result.push(f)
            rem = rem - f
        i = i - 1
    result

// Decode a Zeckendorf list (sum of its elements).
fn zk_decode(xs: list) -> int
    let s = 0
    for i in 0..len(xs)
        s = s + xs[i]
    s

// Return true iff xs is a valid Zeckendorf representation:
//   1. Elements are distinct Fibonacci numbers in strictly descending order.
//   2. No two elements are consecutive Fibonacci numbers (indices differ by >= 2).
fn zk_is_valid(xs: list) -> bool
    let n = len(xs)
    if n == 0
        return true
    // Find a bound to build the fib sequence.
    let maxval = xs[0]
    for i in 1..n
        if xs[i] > maxval
            maxval = xs[i]
    let fibs = _zk_fibs_upto(maxval)
    // Validate each element is a Fibonacci number and list is strictly descending.
    let ok = true
    let prev_idx = -1
    for j in 0..n
        let v = xs[j]
        // Strictly descending: each element must be less than the previous.
        if j > 0
            if v >= xs[j - 1]
                ok = false
        // Must be a Fibonacci number.
        let fidx = _zk_fib_index(fibs, v)
        if fidx < 0
            ok = false
        else
            // No two consecutive Fibonacci indices allowed.
            if prev_idx >= 0
                if fidx >= prev_idx - 1
                    ok = false
            prev_idx = fidx
    ok
