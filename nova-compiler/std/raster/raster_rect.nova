// std/raster/raster_rect — rectangle rasterisation: filled, outline, rounded, clipped.
//
// All coordinates are integer pixels.  A rectangle is described by its
// top-left corner (rx,ry), width rw, and height rh.  It covers
// x in [rx, rx+rw) and y in [ry, ry+rh).
// Points are returned in ROW-MAJOR order: y outer, x inner.
//
// Public API:
//   rr_fill(x,y,w,h)               -> list  all [x,y] pixel points (row-major)
//   rr_outline(x,y,w,h)            -> list  border pixel points only
//   rr_fill_to_surface(s,x,y,w,h,val) -> any  clipped fill onto surface
//   rr_rounded(x,y,w,h,radius)     -> list  rounded-corner rectangle outline points
//   rr_area(w,h)                   -> int   w * h
//   rr_perimeter_points(w,h)       -> int   pixel count of outline
//   rr_contains(rx,ry,rw,rh,x,y)  -> bool  true iff (x,y) in [rx,rx+rw)x[ry,ry+rh)
//   rr_intersect(a,b)              -> list  [x,y,w,h] intersection or [] if disjoint
//   rr_clip(x,y,w,h,cx,cy,cw,ch)  -> list  clip rect to clamping region

// rr_area — total pixel count of a filled rectangle.
fn rr_area(w: int, h: int) -> int
    w * h

// rr_perimeter_points — pixel count of the outline of a w x h rectangle.
fn rr_perimeter_points(w: int, h: int) -> int
    let result = 0
    if w <= 0 or h <= 0
        result = 0
    else
        if w == 1 and h == 1
            result = 1
        else
            if w == 1
                result = h
            else
                if h == 1
                    result = w
                else
                    result = 2 * w + 2 * h - 4
    result

// rr_contains — true iff pixel (x,y) lies inside rectangle [rx,rx+rw) x [ry,ry+rh).
fn rr_contains(rx: int, ry: int, rw: int, rh: int, x: int, y: int) -> bool
    let result = false
    if x >= rx and x < rx + rw and y >= ry and y < ry + rh
        result = true
    result

// rr_fill — return all [x,y] points of filled rectangle in row-major order.
fn rr_fill(x: int, y: int, w: int, h: int) -> list
    let pts = []
    if w <= 0 or h <= 0
        return pts
    let row = y
    while row < y + h
        let col = x
        while col < x + w
            let pt = []
            push(pt, col)
            push(pt, row)
            push(pts, pt)
            col = col + 1
        row = row + 1
    pts

// rr_outline — return border [x,y] pixel points of rectangle in row-major order.
// For a 1-pixel-wide or 1-pixel-tall rectangle, this equals rr_fill.
fn rr_outline(x: int, y: int, w: int, h: int) -> list
    let pts = []
    if w <= 0 or h <= 0
        return pts
    if w == 1 or h == 1
        return rr_fill(x, y, w, h)
    // top row
    let col = x
    while col < x + w
        let pt = []
        push(pt, col)
        push(pt, y)
        push(pts, pt)
        col = col + 1
    // middle rows: left and right columns only
    let row = y + 1
    while row < y + h - 1
        let pl = []
        push(pl, x)
        push(pl, row)
        push(pts, pl)
        let pr = []
        push(pr, x + w - 1)
        push(pr, row)
        push(pts, pr)
        row = row + 1
    // bottom row
    let col2 = x
    while col2 < x + w
        let pt2 = []
        push(pt2, col2)
        push(pt2, y + h - 1)
        push(pts, pt2)
        col2 = col2 + 1
    pts

// rr_fill_to_surface — clipped fill of rectangle onto surface s with value val.
fn rr_fill_to_surface(s: dict, x: int, y: int, w: int, h: int, val: int) -> any
    let sw = s["w"]
    let sh = s["h"]
    let px = s["px"]
    // clip to surface bounds
    let x0 = x
    let y0 = y
    let x1 = x + w
    let y1 = y + h
    if x0 < 0
        x0 = 0
    if y0 < 0
        y0 = 0
    if x1 > sw
        x1 = sw
    if y1 > sh
        y1 = sh
    let row = y0
    while row < y1
        let col = x0
        while col < x1
            let idx = row * sw + col
            px[idx] = val
            col = col + 1
        row = row + 1
    s

// _rr_abs — integer absolute value.
fn _rr_abs(v: int) -> int
    let r = v
    if v < 0
        r = 0 - v
    r

// _rr_circle_quarter — push one octant of a midpoint circle (cx,cy,r) using
// the Bresenham/midpoint algorithm, adding all 8 symmetric points.
// Used by rr_rounded to generate arc corners.
fn _rr_push_circle_pts(pts: list, cx: int, cy: int, x: int, y: int)
    // 8-way symmetry pushes both [cx+x,cy+y] style
    let p1 = []
    push(p1, cx + x)
    push(p1, cy + y)
    push(pts, p1)
    let p2 = []
    push(p2, cx - x)
    push(p2, cy + y)
    push(pts, p2)
    let p3 = []
    push(p3, cx + x)
    push(p3, cy - y)
    push(pts, p3)
    let p4 = []
    push(p4, cx - x)
    push(p4, cy - y)
    push(pts, p4)
    let p5 = []
    push(p5, cx + y)
    push(p5, cy + x)
    push(pts, p5)
    let p6 = []
    push(p6, cx - y)
    push(p6, cy + x)
    push(pts, p6)
    let p7 = []
    push(p7, cx + y)
    push(p7, cy - x)
    push(pts, p7)
    let p8 = []
    push(p8, cx - y)
    push(p8, cy - x)
    push(pts, p8)

// _rr_arc_quadrant — push the arc points for a single corner quadrant.
// q selects which corner: 0=top-left, 1=top-right, 2=bottom-right, 3=bottom-left.
// cx,cy = center of arc; r = radius; quadrant selection filters by sign of dx,dy.
fn _rr_arc_quadrant(pts: list, cx: int, cy: int, r: int, q: int)
    let xi = 0
    let yi = r
    let d = 1 - r
    while xi <= yi
        // for each midpoint step, push the appropriate quadrant point
        // quadrant 0: dx<=0, dy<=0 (top-left)
        // quadrant 1: dx>=0, dy<=0 (top-right)
        // quadrant 2: dx>=0, dy>=0 (bottom-right)
        // quadrant 3: dx<=0, dy>=0 (bottom-left)
        // we push both the (xi,yi) octant and (yi,xi) octant
        let dx0 = xi
        let dy0 = yi
        let dx1 = yi
        let dy1 = xi
        if q == 0
            dx0 = 0 - xi
            dy0 = 0 - yi
            dx1 = 0 - yi
            dy1 = 0 - xi
        if q == 1
            dx0 = xi
            dy0 = 0 - yi
            dx1 = yi
            dy1 = 0 - xi
        if q == 2
            dx0 = xi
            dy0 = yi
            dx1 = yi
            dy1 = xi
        if q == 3
            dx0 = 0 - xi
            dy0 = yi
            dx1 = 0 - yi
            dy1 = xi
        let a = []
        push(a, cx + dx0)
        push(a, cy + dy0)
        push(pts, a)
        if dx0 != dx1 or dy0 != dy1
            let b = []
            push(b, cx + dx1)
            push(b, cy + dy1)
            push(pts, b)
        if d < 0
            d = d + 2 * xi + 3
        else
            d = d + 2 * (xi - yi) + 5
            yi = yi - 1
        xi = xi + 1

// rr_rounded — rounded-corner rectangle outline.
// Returns outline points: 4 straight edges + 4 arc corners.
// Corners are circles of given radius; if radius==0, equivalent to rr_outline.
fn rr_rounded(x: int, y: int, w: int, h: int, radius: int) -> list
    let pts = []
    if w <= 0 or h <= 0
        return pts
    let r = radius
    if r < 0
        r = 0
    // clamp radius
    let max_r = w / 2
    if h / 2 < max_r
        max_r = h / 2
    if r > max_r
        r = max_r
    if r == 0
        return rr_outline(x, y, w, h)
    // corner centers
    let cx_tl = x + r
    let cy_tl = y + r
    let cx_tr = x + w - 1 - r
    let cy_tr = y + r
    let cx_br = x + w - 1 - r
    let cy_br = y + h - 1 - r
    let cx_bl = x + r
    let cy_bl = y + h - 1 - r
    // arcs (quadrant = 0=top-left, 1=top-right, 2=bottom-right, 3=bottom-left)
    _rr_arc_quadrant(pts, cx_tl, cy_tl, r, 0)
    _rr_arc_quadrant(pts, cx_tr, cy_tr, r, 1)
    _rr_arc_quadrant(pts, cx_br, cy_br, r, 2)
    _rr_arc_quadrant(pts, cx_bl, cy_bl, r, 3)
    // straight horizontal edges between corner arcs
    // top edge: x in [x+r, x+w-1-r]
    let col = x + r
    while col <= x + w - 1 - r
        let pt = []
        push(pt, col)
        push(pt, y)
        push(pts, pt)
        col = col + 1
    // bottom edge
    let col2 = x + r
    while col2 <= x + w - 1 - r
        let pt2 = []
        push(pt2, col2)
        push(pt2, y + h - 1)
        push(pts, pt2)
        col2 = col2 + 1
    // left edge: y in [y+r, y+h-1-r]
    let row = y + r
    while row <= y + h - 1 - r
        let pt3 = []
        push(pt3, x)
        push(pt3, row)
        push(pts, pt3)
        row = row + 1
    // right edge
    let row2 = y + r
    while row2 <= y + h - 1 - r
        let pt4 = []
        push(pt4, x + w - 1)
        push(pt4, row2)
        push(pts, pt4)
        row2 = row2 + 1
    pts

// rr_intersect — compute intersection of two rectangles [x,y,w,h].
// Returns [x,y,w,h] of intersection, or [] if disjoint.
fn rr_intersect(a: list, b: list) -> list
    let ax = a[0]
    let ay = a[1]
    let aw = a[2]
    let ah = a[3]
    let bx = b[0]
    let by = b[1]
    let bw = b[2]
    let bh = b[3]
    let x0 = ax
    if bx > ax
        x0 = bx
    let y0 = ay
    if by > ay
        y0 = by
    let ax1 = ax + aw
    let bx1 = bx + bw
    let x1 = ax1
    if bx1 < ax1
        x1 = bx1
    let ay1 = ay + ah
    let by1 = by + bh
    let y1 = ay1
    if by1 < ay1
        y1 = by1
    let iw = x1 - x0
    let ih = y1 - y0
    let result = []
    if iw > 0 and ih > 0
        push(result, x0)
        push(result, y0)
        push(result, iw)
        push(result, ih)
    result

// rr_clip — clip rectangle (x,y,w,h) to clamping region (cx,cy,cw,ch).
// Returns clipped [x,y,w,h] or [] if fully outside.
fn rr_clip(x: int, y: int, w: int, h: int, cx: int, cy: int, cw: int, ch: int) -> list
    let ra = []
    push(ra, x)
    push(ra, y)
    push(ra, w)
    push(ra, h)
    let rb = []
    push(rb, cx)
    push(rb, cy)
    push(rb, cw)
    push(rb, ch)
    rr_intersect(ra, rb)
