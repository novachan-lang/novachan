// std/raster/sprite_mask.nova — 1-bit pixel masks and pixel-perfect collision.
// LEAF — imports NOTHING.
//
// MASK MODEL: dict with keys "w" (int), "h" (int), "px" (flat row-major 0/1 list).
// Pixel (x,y) = px[y*w + x].  All values are 0 or 1.
//
// Public API:
//   sm_from_bits(w,h,bits)       -> any   create mask from flat 0/1 list
//   sm_get(m,x,y)                -> int   read bit; 0 if out-of-bounds
//   sm_collides(a,ax,ay,b,bx,by) -> bool  pixel-perfect collision test
//   sm_bbox_overlap(ax,ay,aw,ah,bx,by,bw,bh) -> bool  AABB overlap pre-check
//   sm_and(a,b)                  -> any   bitwise AND of two same-size masks
//   sm_or(a,b)                   -> any   bitwise OR of two same-size masks
//   sm_count(m)                  -> int   number of set (1) pixels
//   sm_invert(m)                 -> any   flip all bits
//   sm_outline(m)                -> any   keep only edge pixels (border pixels of set regions)

// sm_from_bits: create a 1-bit mask surface from a flat 0/1 list.
fn sm_from_bits(w, h, bits)
    let m = {}
    m["w"] = w
    m["h"] = h
    let px = []
    let total = w * h
    for i in 0..total
        let v = bits[i]
        let b = 0
        if v != 0
            b = 1
        px.push(b)
    m["px"] = px
    m

// sm_get: read bit at (x,y); returns 0 if out-of-bounds.
fn sm_get(m, x, y)
    let w = m["w"]
    let h = m["h"]
    if x < 0
        return 0
    if x >= w
        return 0
    if y < 0
        return 0
    if y >= h
        return 0
    let px = m["px"]
    let idx = y * w + x
    px[idx]

// sm_bbox_overlap: AABB pre-check — do rectangles (ax,ay,aw,ah) and (bx,by,bw,bh) overlap?
fn sm_bbox_overlap(ax, ay, aw, ah, bx, by, bw, bh)
    if ax + aw <= bx
        return 0
    if bx + bw <= ax
        return 0
    if ay + ah <= by
        return 0
    if by + bh <= ay
        return 0
    return 1

// sm_collides: pixel-perfect collision between mask a at world pos (ax,ay)
// and mask b at world pos (bx,by).  Tests every pixel in the overlap region.
fn sm_collides(a, ax, ay, b, bx, by)
    let aw = a["w"]
    let ah = a["h"]
    let bw = b["w"]
    let bh = b["h"]
    // Compute overlap rectangle in world coords.
    let ox1 = ax
    if bx > ox1
        ox1 = bx
    let oy1 = ay
    if by > oy1
        oy1 = by
    let ox2 = ax + aw
    let bx2 = bx + bw
    if bx2 < ox2
        ox2 = bx2
    let oy2 = ay + ah
    let by2 = by + bh
    if by2 < oy2
        oy2 = by2
    if ox2 <= ox1
        return 0
    if oy2 <= oy1
        return 0
    let apx = a["px"]
    let bpx = b["px"]
    let wy = oy1
    while wy < oy2
        let wx = ox1
        while wx < ox2
            let alx = wx - ax
            let aly = wy - ay
            let blx = wx - bx
            let bly = wy - by
            let ai = aly * aw + alx
            let bi = bly * bw + blx
            let av = apx[ai]
            let bv = bpx[bi]
            if av != 0
                if bv != 0
                    return 1
            wx += 1
        wy += 1
    return 0

// _sm_new_empty: create a zeroed mask of given dimensions.
fn _sm_new_empty(w, h)
    let m = {}
    m["w"] = w
    m["h"] = h
    let px = []
    let total = w * h
    for i in 0..total
        px.push(0)
    m["px"] = px
    m

// sm_and: return a new mask = bitwise AND of two same-size masks.
fn sm_and(a, b)
    let w = a["w"]
    let h = a["h"]
    let apx = a["px"]
    let bpx = b["px"]
    let out = _sm_new_empty(w, h)
    let opx = out["px"]
    let total = w * h
    for i in 0..total
        let av = apx[i]
        let bv = bpx[i]
        let r = 0
        if av != 0
            if bv != 0
                r = 1
        opx[i] = r
    out

// sm_or: return a new mask = bitwise OR of two same-size masks.
fn sm_or(a, b)
    let w = a["w"]
    let h = a["h"]
    let apx = a["px"]
    let bpx = b["px"]
    let out = _sm_new_empty(w, h)
    let opx = out["px"]
    let total = w * h
    for i in 0..total
        let av = apx[i]
        let bv = bpx[i]
        let r = 0
        if av != 0
            r = 1
        if bv != 0
            r = 1
        opx[i] = r
    out

// sm_count: return the number of set (1) pixels in the mask.
fn sm_count(m)
    let px = m["px"]
    let total = len(px)
    let cnt = 0
    for i in 0..total
        if px[i] != 0
            cnt += 1
    cnt

// sm_invert: return a new mask with all bits flipped.
fn sm_invert(m)
    let w = m["w"]
    let h = m["h"]
    let px = m["px"]
    let total = w * h
    let out = _sm_new_empty(w, h)
    let opx = out["px"]
    for i in 0..total
        let v = px[i]
        let r = 1
        if v != 0
            r = 0
        opx[i] = r
    out

// _sm_is_set: check if (x,y) is within bounds and set.
fn _sm_is_set(px, w, h, x, y)
    if x < 0
        return 0
    if x >= w
        return 0
    if y < 0
        return 0
    if y >= h
        return 0
    let v = px[y * w + x]
    if v != 0
        return 1
    return 0

// sm_outline: return a new mask containing only edge pixels of set regions.
// A set pixel is an edge pixel if at least one of its 4 neighbours is unset or OOB.
fn sm_outline(m)
    let w = m["w"]
    let h = m["h"]
    let px = m["px"]
    let out = _sm_new_empty(w, h)
    let opx = out["px"]
    for y in 0..h
        let x = 0
        while x < w
            let idx = y * w + x
            let v = px[idx]
            if v != 0
                let is_edge = 0
                let up = _sm_is_set(px, w, h, x, y - 1)
                if up == 0
                    is_edge = 1
                let dn = _sm_is_set(px, w, h, x, y + 1)
                if dn == 0
                    is_edge = 1
                let lt = _sm_is_set(px, w, h, x - 1, y)
                if lt == 0
                    is_edge = 1
                let rt = _sm_is_set(px, w, h, x + 1, y)
                if rt == 0
                    is_edge = 1
                if is_edge != 0
                    opx[idx] = 1
            x += 1
    out
