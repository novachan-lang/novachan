// std/raster/thick_line.nova — Thick, dashed, dotted, and patterned line rasterization.
//
// All functions are integer-only (no floats).
// POINT-GENERATING: returns a list of [x,y] integer points.
// SELF-CONTAINED: imports nothing.
//
// Public API (prefix tl_):
//   tl_line(x0,y0,x1,y1)             -> list  plain Bresenham line
//   tl_thick(x0,y0,x1,y1,width)      -> list  thick line, width pixels wide (perpendicular offsets)
//   tl_thick_horizontal(x0,x1,y,width)-> list  thick horizontal span
//   tl_dashed(x0,y0,x1,y1,on,off)    -> list  dashed: `on` drawn, `off` skipped, repeating
//   tl_dotted(x0,y0,x1,y1,gap)       -> list  every gap-th pixel included (0,gap,2*gap,...)
//   tl_pattern(x0,y0,x1,y1,pattern)  -> list  include pixel i if bit (i mod 32) of pattern is set

// _tl_abs — integer absolute value.
fn _tl_abs(v: int) -> int
    let r = v
    if v < 0
        r = 0 - v
    r

// _tl_sign — sign of integer: -1, 0, or 1.
fn _tl_sign(v: int) -> int
    let r = 0
    if v > 0
        r = 1
    else
        if v < 0
            r = 0 - 1
    r

// _tl_key — encode (x,y) as a unique string key for deduplication.
fn _tl_key(x: int, y: int) -> string
    str(x) + "," + str(y)

// tl_line — plain Bresenham line from (x0,y0) to (x1,y1), inclusive.
fn tl_line(x0: int, y0: int, x1: int, y1: int) -> list
    let pts = []
    let adx = _tl_abs(x1 - x0)
    let ady = _tl_abs(y1 - y0)
    let sx = 1
    if x0 > x1
        sx = 0 - 1
    let sy = 1
    if y0 > y1
        sy = 0 - 1
    let err = adx - ady
    let x = x0
    let y = y0
    let going = true
    while going
        push(pts, [x, y])
        if x == x1 and y == y1
            going = false
        else
            let e2 = 2 * err
            if e2 > (0 - ady)
                err = err - ady
                x = x + sx
            if e2 < adx
                err = err + adx
                y = y + sy
    pts

// tl_thick — thick line of given width (pixels wide).
// Strategy: rasterise the centre line with Bresenham, then for each centre pixel
// add perpendicular offsets from -(half) to +(half).
// Perpendicular direction to (dx,dy) is (-dy_sign, dx_sign) for integer approximation.
// Deduplication via a dict of visited keys.
// Width 1 reproduces the plain line exactly.
fn tl_thick(x0: int, y0: int, x1: int, y1: int, width: int) -> list
    let pts = []
    let seen = {}
    let half = width / 2
    let center = tl_line(x0, y0, x1, y1)
    let dx = x1 - x0
    let dy = y1 - y0
    let psx = 0 - _tl_sign(dy)
    let psy = _tl_sign(dx)
    let ci = 0
    while ci < len(center)
        let cp = center[ci]
        let cx = cp[0]
        let cy = cp[1]
        let off = 0 - half
        while off <= half
            let nx = cx + psx * off
            let ny = cy + psy * off
            let k = _tl_key(nx, ny)
            if not contains(seen, k)
                seen[k] = 1
                push(pts, [nx, ny])
            off = off + 1
        ci = ci + 1
    pts

// tl_thick_horizontal — thick horizontal span from x0 to x1 at row y, width pixels tall.
// Centered: rows from y-(width/2) to y+(width/2).
// For width=3: half=1, rows y-1, y, y+1.
fn tl_thick_horizontal(x0: int, x1: int, y: int, width: int) -> list
    let pts = []
    let half = width / 2
    let row = y - half
    while row <= y + half
        let x = x0
        while x <= x1
            push(pts, [x, row])
            x = x + 1
        row = row + 1
    pts

// tl_dashed — dashed line: draw `on` pixels, skip `off` pixels, repeating.
// `on` and `off` must be >= 1.
fn tl_dashed(x0: int, y0: int, x1: int, y1: int, on: int, off: int) -> list
    let all = tl_line(x0, y0, x1, y1)
    let pts = []
    let period = on + off
    let i = 0
    while i < len(all)
        let pos = i % period
        if pos < on
            push(pts, all[i])
        i = i + 1
    pts

// tl_dotted — every gap-th pixel along the line (index 0, gap, 2*gap, ...).
fn tl_dotted(x0: int, y0: int, x1: int, y1: int, gap: int) -> list
    let all = tl_line(x0, y0, x1, y1)
    let pts = []
    let i = 0
    while i < len(all)
        if i % gap == 0
            push(pts, all[i])
        i = i + 1
    pts

// tl_pattern — include pixel at index i if bit (i mod 32) of pattern int is set.
// pattern is treated as a 32-bit bitmask cycling every 32 pixels.
fn tl_pattern(x0: int, y0: int, x1: int, y1: int, pattern: int) -> list
    let all = tl_line(x0, y0, x1, y1)
    let pts = []
    let i = 0
    while i < len(all)
        let bit = i % 32
        let masked = (pattern >> bit) & 1
        if masked != 0
            push(pts, all[i])
        i = i + 1
    pts
