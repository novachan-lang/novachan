// std/raster/raster_clip.nova — Cohen-Sutherland integer line clipping.
//
// Outcode bit assignments (documented):
//   LEFT   = 1  (x < xmin)
//   RIGHT  = 2  (x > xmax)
//   BOTTOM = 4  (y < ymin)
//   TOP    = 8  (y > ymax)
//
// Clipping uses integer arithmetic throughout (truncating division for intersections).
// SELF-CONTAINED: imports nothing.
//
// Public API (prefix rc_):
//   rc_outcode(x,y, xmin,ymin,xmax,ymax)          -> int   4-bit region code
//   rc_clip_line(x0,y0,x1,y1, xmin,ymin,xmax,ymax)-> list  [[cx0,cy0],[cx1,cy1]] or []
//   rc_point_in_rect(x,y, xmin,ymin,xmax,ymax)    -> bool  true iff inside (inclusive)
//   rc_clip_point(x,y, xmin,ymin,xmax,ymax)       -> list  [clamped_x,clamped_y]
//   rc_rect_intersect(a,b)                         -> any   intersection rect dict, or []
//   rc_line_fully_inside(x0,y0,x1,y1, rect)       -> bool  both endpoints inside rect
//   rc_line_fully_outside(x0,y0,x1,y1, rect)      -> bool  trivially outside (shared outcode bit)

// _rc_clamp — clamp value to [lo,hi].
fn _rc_clamp(v: int, lo: int, hi: int) -> int
    let r = v
    if v < lo
        r = lo
    else
        if v > hi
            r = hi
    r

// rc_outcode — compute the 4-bit Cohen-Sutherland outcode for point (x,y).
// LEFT=1 (x<xmin), RIGHT=2 (x>xmax), BOTTOM=4 (y<ymin), TOP=8 (y>ymax).
fn rc_outcode(x: int, y: int, xmin: int, ymin: int, xmax: int, ymax: int) -> int
    let code = 0
    if x < xmin
        code = code | 1
    if x > xmax
        code = code | 2
    if y < ymin
        code = code | 4
    if y > ymax
        code = code | 8
    code

// rc_point_in_rect — true iff (x,y) is inside the axis-aligned rectangle (inclusive).
fn rc_point_in_rect(x: int, y: int, xmin: int, ymin: int, xmax: int, ymax: int) -> bool
    let ok = false
    if x >= xmin and x <= xmax and y >= ymin and y <= ymax
        ok = true
    ok

// rc_clip_point — clamp (x,y) to the rectangle [xmin,xmax] x [ymin,ymax].
fn rc_clip_point(x: int, y: int, xmin: int, ymin: int, xmax: int, ymax: int) -> list
    let cx = _rc_clamp(x, xmin, xmax)
    let cy = _rc_clamp(y, ymin, ymax)
    [cx, cy]

// _rc_oc_and — bitwise AND of two outcodes (wrapped as fn to ensure precedence).
fn _rc_oc_and(a: int, b: int) -> int
    a & b

// _rc_oc_bit — test a bit in an outcode.
fn _rc_oc_bit(code: int, bit: int) -> bool
    let masked = (code >> bit) & 1
    masked != 0

// _rc_intersect_left — intersect line segment with x=xmin vertical boundary (integer).
fn _rc_intersect_left(x0: int, y0: int, x1: int, y1: int, xmin: int) -> list
    let dy = y1 - y0
    let dx = x1 - x0
    let ny = y0 + (xmin - x0) * dy / dx
    [xmin, ny]

// _rc_intersect_right — intersect line segment with x=xmax vertical boundary (integer).
fn _rc_intersect_right(x0: int, y0: int, x1: int, y1: int, xmax: int) -> list
    let dy = y1 - y0
    let dx = x1 - x0
    let ny = y0 + (xmax - x0) * dy / dx
    [xmax, ny]

// _rc_intersect_bottom — intersect line segment with y=ymin horizontal boundary (integer).
fn _rc_intersect_bottom(x0: int, y0: int, x1: int, y1: int, ymin: int) -> list
    let dy = y1 - y0
    let dx = x1 - x0
    let nx = x0 + (ymin - y0) * dx / dy
    [nx, ymin]

// _rc_intersect_top — intersect line segment with y=ymax horizontal boundary (integer).
fn _rc_intersect_top(x0: int, y0: int, x1: int, y1: int, ymax: int) -> list
    let dy = y1 - y0
    let dx = x1 - x0
    let nx = x0 + (ymax - y0) * dx / dy
    [nx, ymax]

// _rc_clip_one — clip point (cx, cy) with outcode oc against the boundary.
// Returns new [x,y] for the clipped point.
fn _rc_clip_one(cx0: int, cy0: int, cx1: int, cy1: int, oc: int, xmin: int, ymin: int, xmax: int, ymax: int) -> list
    let p = [cx0, cy0]
    if _rc_oc_bit(oc, 3)
        p = _rc_intersect_top(cx0, cy0, cx1, cy1, ymax)
    else
        if _rc_oc_bit(oc, 2)
            p = _rc_intersect_bottom(cx0, cy0, cx1, cy1, ymin)
        else
            if _rc_oc_bit(oc, 1)
                p = _rc_intersect_right(cx0, cy0, cx1, cy1, xmax)
            else
                if _rc_oc_bit(oc, 0)
                    p = _rc_intersect_left(cx0, cy0, cx1, cy1, xmin)
    p

// rc_clip_line — Cohen-Sutherland line clipping to rectangle [xmin,xmax]x[ymin,ymax].
// Returns [[cx0,cy0],[cx1,cy1]] if the segment intersects the clip rectangle, or [].
// Uses integer intersection arithmetic (truncating division).
fn rc_clip_line(x0: int, y0: int, x1: int, y1: int, xmin: int, ymin: int, xmax: int, ymax: int) -> list
    let cx0 = x0
    let cy0 = y0
    let cx1 = x1
    let cy1 = y1
    let accepted = false
    let rejected = false
    let iterations = 0
    while not accepted and not rejected and iterations < 20
        iterations = iterations + 1
        let oc0 = rc_outcode(cx0, cy0, xmin, ymin, xmax, ymax)
        let oc1 = rc_outcode(cx1, cy1, xmin, ymin, xmax, ymax)
        if oc0 == 0 and oc1 == 0
            accepted = true
        else
            let both = _rc_oc_and(oc0, oc1)
            if both != 0
                rejected = true
            else
                let oc = oc0
                if oc0 == 0
                    oc = oc1
                let p = _rc_clip_one(cx0, cy0, cx1, cy1, oc, xmin, ymin, xmax, ymax)
                if oc == oc0
                    cx0 = p[0]
                    cy0 = p[1]
                else
                    cx1 = p[0]
                    cy1 = p[1]
    let result = []
    if accepted
        let p0 = [cx0, cy0]
        let p1 = [cx1, cy1]
        push(result, p0)
        push(result, p1)
    result

// rc_rect_intersect — intersection of two rectangles a and b.
// Each rect is a dict with keys "xmin","ymin","xmax","ymax".
// Returns a list containing one dict (the intersection rect), or [] if disjoint.
fn rc_rect_intersect(a: dict, b: dict) -> any
    let axmin = a["xmin"]
    let aymin = a["ymin"]
    let axmax = a["xmax"]
    let aymax = a["ymax"]
    let bxmin = b["xmin"]
    let bymin = b["ymin"]
    let bxmax = b["xmax"]
    let bymax = b["ymax"]
    let ixmin = axmin
    if bxmin > axmin
        ixmin = bxmin
    let iymin = aymin
    if bymin > aymin
        iymin = bymin
    let ixmax = axmax
    if bxmax < axmax
        ixmax = bxmax
    let iymax = aymax
    if bymax < aymax
        iymax = bymax
    let result = []
    if ixmin <= ixmax and iymin <= iymax
        let r = {}
        r["xmin"] = ixmin
        r["ymin"] = iymin
        r["xmax"] = ixmax
        r["ymax"] = iymax
        push(result, r)
    result

// rc_line_fully_inside — true iff both endpoints are inside the rectangle (outcode == 0).
// rect is a dict with keys "xmin","ymin","xmax","ymax".
fn rc_line_fully_inside(x0: int, y0: int, x1: int, y1: int, rect: dict) -> bool
    let xmin = rect["xmin"]
    let ymin = rect["ymin"]
    let xmax = rect["xmax"]
    let ymax = rect["ymax"]
    let oc0 = rc_outcode(x0, y0, xmin, ymin, xmax, ymax)
    let oc1 = rc_outcode(x1, y1, xmin, ymin, xmax, ymax)
    let ok = false
    if oc0 == 0 and oc1 == 0
        ok = true
    ok

// rc_line_fully_outside — true iff the line is trivially rejected.
// Both endpoints share at least one outside region (their outcodes AND != 0).
// Note: this is a sufficient condition for no intersection; the line may pass outside
// without sharing an outcode bit.
fn rc_line_fully_outside(x0: int, y0: int, x1: int, y1: int, rect: dict) -> bool
    let xmin = rect["xmin"]
    let ymin = rect["ymin"]
    let xmax = rect["xmax"]
    let ymax = rect["ymax"]
    let oc0 = rc_outcode(x0, y0, xmin, ymin, xmax, ymax)
    let oc1 = rc_outcode(x1, y1, xmin, ymin, xmax, ymax)
    let both = _rc_oc_and(oc0, oc1)
    let outside = false
    if both != 0
        outside = true
    outside
