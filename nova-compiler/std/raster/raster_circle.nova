// std/raster/raster_circle.nova
// Midpoint circle algorithm (Bresenham) — pure integer, 8-way symmetry.
// SURFACE model: dict with 'w'(int), 'h'(int), 'px'(flat row-major list, length w*h).
// Point lists: each element is a 2-element [x,y] list.
// Private helpers use _rci_ prefix.

// --- Surface helpers (self-contained; not exported elsewhere) ---

// _rci_sur_new: create a new surface filled with fill value.
fn _rci_sur_new(w, h, fill)
    let total = w * h
    let px = [fill for i in 0..total]
    {"w": w, "h": h, "px": px}

// _rci_sur_in_bounds: true if (x,y) is within surface bounds.
fn _rci_sur_in_bounds(s, x, y)
    let w = s["w"]
    let h = s["h"]
    x >= 0 and y >= 0 and x < w and y < h

// _rci_sur_set: set pixel (x,y) to value v (mutates px).
fn _rci_sur_set(s, x, y, v)
    let ok = _rci_sur_in_bounds(s, x, y)
    if ok
        let w = s["w"]
        let idx = y * w + x
        let px = s["px"]
        px[idx] = v

// _rci_sur_get: get pixel value at (x,y); 0 if out of bounds.
fn _rci_sur_get(s, x, y)
    let ok = _rci_sur_in_bounds(s, x, y)
    let result = 0
    if ok
        let w = s["w"]
        let idx = y * w + x
        let px = s["px"]
        result = px[idx]
    result

// _rci_abs: absolute value of integer.
fn _rci_abs(v)
    -v if v < 0 else v

// --- Deduplication helper ---
// _rci_pt_in: true if [px,py] already exists in list pts (linear scan).
fn _rci_pt_in(pts, px, py)
    for p in pts
        if p[0] == px and p[1] == py
            return true
    false

// _rci_add_pt: add [px,py] to pts only if not already present.
fn _rci_add_pt(pts, px, py)
    if not _rci_pt_in(pts, px, py)
        push(pts, [px, py])

// --- 8-way symmetry octant emission ---
// _rci_emit8: emit up to 8 symmetric circle points for offset (dx,dy) around center (cx,cy).
fn _rci_emit8(pts, cx, cy, dx, dy)
    _rci_add_pt(pts, cx + dx, cy + dy)
    _rci_add_pt(pts, cx - dx, cy + dy)
    _rci_add_pt(pts, cx + dx, cy - dy)
    _rci_add_pt(pts, cx - dx, cy - dy)
    _rci_add_pt(pts, cx + dy, cy + dx)
    _rci_add_pt(pts, cx - dy, cy + dx)
    _rci_add_pt(pts, cx + dy, cy - dx)
    _rci_add_pt(pts, cx - dy, cy - dx)

// --- Public API ---

// rci_circle: boundary points of circle (cx,cy,r) via midpoint algorithm with 8-way symmetry.
// Returns a list of [x,y] integer points. Deduplicates octant-boundary collisions.
// r=0 returns [[cx,cy]]. Points are in generation order (x from 0 to r in first octant).
fn rci_circle(cx, cy, r)
    if r == 0
        return [[cx, cy]]
    let pts = []
    let x = r
    let y = 0
    let p = 1 - r
    while x >= y
        _rci_emit8(pts, cx, cy, x, y)
        y += 1
        if p <= 0
            p += 2 * y + 1
        else
            x -= 1
            p += 2 * y - 2 * x + 1
    pts

// rci_circle_to_surface: draw circle boundary onto surface s with pixel value val.
// Clips to surface bounds. Mutates s["px"] in place. Returns s.
fn rci_circle_to_surface(s, cx, cy, r, val)
    let pts = rci_circle(cx, cy, r)
    let n = len(pts)
    for i in 0..n
        let p = pts[i]
        _rci_sur_set(s, p[0], p[1], val)
    s

// rci_filled: all points (x,y) with (x-cx)^2+(y-cy)^2 <= r^2.
// Returns a list of [x,y] integer points in scanline order.
fn rci_filled(cx, cy, r)
    let pts = []
    let rsq = r * r
    let dy = -r
    while dy <= r
        let dx = -r
        while dx <= r
            let dsq = dx * dx + dy * dy
            if dsq <= rsq
                push(pts, [cx + dx, cy + dy])
            dx += 1
        dy += 1
    pts

// rci_arc: boundary points for one octant (0-7) of circle (cx,cy,r).
// Octant 0: first octant (x from r downto ~r/sqrt(2), y from 0 up).
// Octants 1-7 are successive 45-degree rotations applied to the (dx,dy) offset.
// Returns deduplicated points for that octant.
fn rci_arc(cx, cy, r, octant)
    let oct = octant
    // Normalise octant to 0..7
    if oct < 0
        oct = 0
    if oct > 7
        oct = 7
    // Re-derive the raw first-octant offsets, then rotate per octant.
    // Octant k covers 45*k to 45*(k+1) degrees in standard orientation.
    if r == 0
        return [[cx, cy]]
    let pts = []
    let x = r
    let y = 0
    let p = 1 - r
    while x >= y
        // octant 0: (+x,+y), 1: (+y,+x), 2: (-y,+x), 3: (-x,+y)
        // octant 4: (-x,-y), 5: (-y,-x), 6: (+y,-x), 7: (+x,-y)
        let ax = x
        let ay = y
        if oct == 1
            ax = y
            ay = x
        else if oct == 2
            ax = -y
            ay = x
        else if oct == 3
            ax = -x
            ay = y
        else if oct == 4
            ax = -x
            ay = -y
        else if oct == 5
            ax = -y
            ay = -x
        else if oct == 6
            ax = y
            ay = -x
        else if oct == 7
            ax = x
            ay = -y
        _rci_add_pt(pts, cx + ax, cy + ay)
        y += 1
        if p <= 0
            p += 2 * y + 1
        else
            x -= 1
            p += 2 * y - 2 * x + 1
    pts

// rci_point_count: number of distinct boundary points for a circle of radius r.
fn rci_point_count(r)
    let pts = rci_circle(0, 0, r)
    len(pts)

// rci_contains: true if (x,y) is inside or on the circle (cx,cy,r).
// Uses exact integer squared-distance comparison.
fn rci_contains(cx, cy, r, x, y)
    let dx = x - cx
    let dy = y - cy
    let dsq = dx * dx + dy * dy
    let rsq = r * r
    dsq <= rsq
