// std/raster/bresenham.nova — Bresenham integer line rasterization.
//
// SURFACE = dict with 'w'(int), 'h'(int), 'px'(flat list len w*h).
// Pixel (x,y) = px[y*w + x].
//
// POINT-GENERATING: returns list of [x,y] int points in draw order.
// SELF-CONTAINED: imports nothing.
//
// Public API (prefix bl_):
//   bl_line(x0,y0,x1,y1)              -> list  Bresenham points, start..end inclusive
//   bl_line_to_surface(s,x0,y0,x1,y1,val) -> any  draw onto surface, clipped
//   bl_points_count(x0,y0,x1,y1)      -> int  number of points (max(|dx|,|dy|)+1)
//   bl_horizontal(x0,x1,y)            -> list  horizontal span
//   bl_vertical(x,y0,y1)              -> list  vertical span
//   bl_slope_octant(dx,dy)            -> int   octant 0-7
//   bl_reverse(points)                -> list  reversed point list

// _bl_abs — integer absolute value.
fn _bl_abs(v: int) -> int
    let r = v
    if v < 0
        r = 0 - v
    r

// sur_new — create a new surface: w*h pixels initialised to fill.
fn sur_new(w: int, h: int, fill: int) -> dict
    let s = {}
    s["w"] = w
    s["h"] = h
    let px = []
    let total = w * h
    let i = 0
    while i < total
        push(px, fill)
        i = i + 1
    s["px"] = px
    s

// sur_in_bounds — true iff (x,y) is within the surface.
fn sur_in_bounds(s: dict, x: int, y: int) -> bool
    let w = s["w"]
    let h = s["h"]
    let ok = false
    if x >= 0 and x < w and y >= 0 and y < h
        ok = true
    ok

// sur_get — read pixel at (x,y).
fn sur_get(s: dict, x: int, y: int) -> int
    let w = s["w"]
    let px = s["px"]
    let idx = y * w + x
    px[idx]

// sur_set — write pixel at (x,y); mutates surface in place.
fn sur_set(s: dict, x: int, y: int, v: int)
    let w = s["w"]
    let px = s["px"]
    let idx = y * w + x
    px[idx] = v

// sur_clone — deep copy of a surface.
fn sur_clone(s: dict) -> dict
    let w = s["w"]
    let h = s["h"]
    let px = s["px"]
    let ns = {}
    ns["w"] = w
    ns["h"] = h
    let npx = []
    let total = w * h
    let i = 0
    while i < total
        push(npx, px[i])
        i = i + 1
    ns["px"] = npx
    ns

// bl_line — Bresenham integer line from (x0,y0) to (x1,y1), inclusive.
// Works in all 8 octants. Returns list of [x,y] points in draw order.
fn bl_line(x0: int, y0: int, x1: int, y1: int) -> list
    let pts = []
    let adx = _bl_abs(x1 - x0)
    let ady = _bl_abs(y1 - y0)
    let sx = 1
    if x0 > x1
        sx = 0 - 1
    let sy = 1
    if y0 > y1
        sy = 0 - 1
    let err = adx - ady
    let x = x0
    let y = y0
    let going = true
    while going
        let pt = [x, y]
        push(pts, pt)
        if x == x1 and y == y1
            going = false
        else
            let e2 = 2 * err
            if e2 > (0 - ady)
                err = err - ady
                x = x + sx
            if e2 < adx
                err = err + adx
                y = y + sy
    pts

// bl_line_to_surface — draw a Bresenham line onto surface s with pixel value val.
// Clips: only writes pixels that are within surface bounds.
fn bl_line_to_surface(s: dict, x0: int, y0: int, x1: int, y1: int, val: int) -> any
    let pts = bl_line(x0, y0, x1, y1)
    let i = 0
    while i < len(pts)
        let pt = pts[i]
        let px = pt[0]
        let py = pt[1]
        if sur_in_bounds(s, px, py)
            sur_set(s, px, py, val)
        i = i + 1
    0

// bl_points_count — number of pixels in a Bresenham line (= max(|dx|,|dy|) + 1).
fn bl_points_count(x0: int, y0: int, x1: int, y1: int) -> int
    let adx = _bl_abs(x1 - x0)
    let ady = _bl_abs(y1 - y0)
    let mx = adx
    if ady > adx
        mx = ady
    mx + 1

// bl_horizontal — a horizontal span from x0 to x1 at row y (inclusive).
fn bl_horizontal(x0: int, x1: int, y: int) -> list
    let pts = []
    let x = x0
    let sx = 1
    if x1 < x0
        sx = 0 - 1
    let going = true
    while going
        let pt = [x, y]
        push(pts, pt)
        if x == x1
            going = false
        else
            x = x + sx
    pts

// bl_vertical — a vertical span from y0 to y1 at column x (inclusive).
fn bl_vertical(x: int, y0: int, y1: int) -> list
    let pts = []
    let y = y0
    let sy = 1
    if y1 < y0
        sy = 0 - 1
    let going = true
    while going
        let pt = [x, y]
        push(pts, pt)
        if y == y1
            going = false
        else
            y = y + sy
    pts

// bl_slope_octant — returns the octant (0-7) for a direction vector (dx,dy).
// Octant 0: dx>0, dy>=0, dx>=dy (shallow right-up).
// Octant 1: dy>0, dx>=0, dy>dx  (steep up-right).
// Octant 2: dy>0, dx<=0, dy>(-dx)(steep up-left).
// Octant 3: dx<0, dy>=0, (-dx)>=dy (shallow left-up).
// Octant 4: dx<0, dy<0, (-dx)>=(-dy)(shallow left-down).
// Octant 5: dy<0, dx<=0, (-dy)>(-dx)(steep down-left).
// Octant 6: dy<0, dx>=0, (-dy)>dx (steep down-right).
// Octant 7: dx>0, dy<0, dx>=(-dy)(shallow right-down).
fn bl_slope_octant(dx: int, dy: int) -> int
    let adx = dx
    if dx < 0
        adx = 0 - dx
    let ady = dy
    if dy < 0
        ady = 0 - dy
    let oct = 0
    if dx >= 0 and dy >= 0
        if adx >= ady
            oct = 0
        else
            oct = 1
    else
        if dx < 0 and dy >= 0
            if adx >= ady
                oct = 3
            else
                oct = 2
        else
            if dx < 0 and dy < 0
                if adx >= ady
                    oct = 4
                else
                    oct = 5
            else
                if adx >= ady
                    oct = 7
                else
                    oct = 6
    oct

// bl_reverse — reverse a list of points.
fn bl_reverse(points: list) -> list
    let n = len(points)
    let result = []
    let i = n - 1
    while i >= 0
        push(result, points[i])
        i = i - 1
    result
