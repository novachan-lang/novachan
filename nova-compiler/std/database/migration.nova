// std/database/migration — schema migration tracker (data-only)
//
// WHAT:
//   Tracks a set of registered schema migrations (version, description,
//   up/down SQL) and answers "which are pending relative to some current
//   version" and "which have been marked applied". This module does NOT
//   execute SQL or talk to a database — it is pure bookkeeping, matching
//   the rest of std/database (see std/database/query_builder.nova, also
//   built in this batch, which only builds SQL strings).
//
// DESIGN NOTE on mg_applied: the task spec that commissioned this module
// lists mg_applied(tracker) with no companion "mark applied" mutator in the
// required API. Without one, "applied" cannot mean anything (the tracker
// has no other source of truth for which versions have actually run). We
// add ONE extra function, mg_apply(tracker, version), as the minimal
// completion needed to make mg_applied non-vacuous — each entry carries an
// "applied" flag (0/1) that starts at 0 and is flipped by mg_apply. This is
// documented here rather than silently invented so the gap is traceable.
//
// Representation: {"items": list of migration dicts}, each migration dict:
//   {"version": int, "description": str, "up_sql": str, "down_sql": str,
//    "applied": int(bool)}
//
// Public API:
//   mg_new()                              -> dict   Empty tracker.
//   mg_add(tracker, version, description,
//          up_sql, down_sql)              -> dict   The new entry (also
//                                                    stored in the tracker).
//   mg_apply(tracker, version)            -> int     1 if version was found
//                                                    and marked applied,
//                                                    else 0.
//   mg_pending(tracker, current_version)  -> list    Entries with
//                                                    version > current_version,
//                                                    ascending by version.
//   mg_applied(tracker)                   -> list    Entries with
//                                                    applied == 1, ascending
//                                                    by version.
//   mg_get(tracker, version)              -> dict    The matching entry, or
//                                                    {} if no such version.
//   mg_count(tracker)                     -> int     Total registered
//                                                    entries.
//   mg_latest(tracker)                    -> dict    Entry with the highest
//                                                    version, or {} if the
//                                                    tracker is empty.
//
// LEAF — imports nothing.
// ============================================================================

// _mg_insert_sorted: insert `entry` into `items` (already sorted ascending
// by "version") at the position that keeps the list sorted. Plain insertion
// — migration lists are small (tens to low hundreds of entries), so O(n) is
// the right tradeoff against the complexity of a real binary-insert.
fn _mg_insert_sorted(items, entry)
    let n = len(items)
    let v = entry["version"]
    let i = 0
    while i < n and items[i]["version"] < v
        i += 1
    items.insert(i, entry)

// mg_new: create an empty migration tracker.
fn mg_new() -> dict
    let t = {}
    t["items"] = []
    return t

// mg_add: register a new migration entry (kept in ascending-version order).
// Returns the newly created entry dict.
fn mg_add(tracker, version, description, up_sql, down_sql) -> dict
    let entry = {}
    entry["version"] = version
    entry["description"] = description
    entry["up_sql"] = up_sql
    entry["down_sql"] = down_sql
    entry["applied"] = 0
    let items = tracker["items"]
    _mg_insert_sorted(items, entry)
    return entry

// mg_apply: mark the entry for `version` as applied. Returns 1 if found and
// marked, 0 if no entry with that version exists.
fn mg_apply(tracker, version) -> int
    let items = tracker["items"]
    let n = len(items)
    for i in 0..n
        if items[i]["version"] == version
            items[i]["applied"] = 1
            return 1
    return 0

// mg_pending: entries whose version is strictly greater than
// current_version, ascending by version (items are already stored sorted).
fn mg_pending(tracker, current_version) -> list
    let items = tracker["items"]
    let n = len(items)
    let out = []
    for i in 0..n
        if items[i]["version"] > current_version
            out.push(items[i])
    return out

// mg_applied: entries marked applied via mg_apply, ascending by version.
fn mg_applied(tracker) -> list
    let items = tracker["items"]
    let n = len(items)
    let out = []
    for i in 0..n
        if items[i]["applied"] == 1
            out.push(items[i])
    return out

// mg_get: the entry matching `version`, or {} (empty dict) if not found.
fn mg_get(tracker, version) -> dict
    let items = tracker["items"]
    let n = len(items)
    for i in 0..n
        if items[i]["version"] == version
            return items[i]
    return {}

// mg_count: total number of registered migration entries.
fn mg_count(tracker) -> int
    return len(tracker["items"])

// mg_latest: the entry with the highest version, or {} if the tracker has
// no entries. Items are stored in ascending order, so this is the last one.
fn mg_latest(tracker) -> dict
    let items = tracker["items"]
    let n = len(items)
    if n == 0
        return {}
    return items[n - 1]

fn main()
    print("database migration module loaded")
