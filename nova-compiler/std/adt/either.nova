// ============================================================================
// std/adt/either — general-purpose Left/Right sum type
// ============================================================================
// NOVA's native `Result` (Ok/Err) always carries failure connotation — `Err`
// reads as "this went wrong". `Either` is the connotation-free sibling: a
// value that is genuinely one of two equally-valid alternatives (e.g. a
// parser that yields either a number or a string, a router that dispatches
// to one of two branches, a diff that is either an addition or a removal).
// Convention (matching Haskell/Scala): Left is the "other" branch, Right is
// the "primary"/expected branch — but unlike Result, neither side is wrong.
//
// Representation (a plain NOVA dict, prefix `ei_`):
//   {"ei_tag": "left",  "ei_val": v}
//   {"ei_tag": "right", "ei_val": v}
//
// Public API:
//   ei_left(v)              -> Either
//   ei_right(v)              -> Either
//   ei_is_left(e)             -> int (1/0)
//   ei_is_right(e)             -> int (1/0)
//   ei_unwrap_left(e)          -> value   (fatal: prints + exit(1) if e is Right)
//   ei_unwrap_right(e)          -> value   (fatal: prints + exit(1) if e is Left)
//   ei_map_left(e, f)            -> Either  apply f to a Left value; Right passes through
//   ei_map_right(e, f)            -> Either  apply f to a Right value; Left passes through
//   ei_fold(e, left_fn, right_fn)  -> value  left_fn(v) if Left, right_fn(v) if Right
//
// LEAF module — imports nothing.
// ============================================================================

fn ei_left(v)
    let r = {}
    r["ei_tag"] = "left"
    r["ei_val"] = v
    return r

fn ei_right(v)
    let r = {}
    r["ei_tag"] = "right"
    r["ei_val"] = v
    return r

fn ei_is_left(e)
    if e["ei_tag"] == "left"
        return 1
    return 0

fn ei_is_right(e)
    if e["ei_tag"] == "right"
        return 1
    return 0

// ei_unwrap_left: the Left value. Calling this on a Right is a programmer
// error — it prints a diagnostic and terminates (exit code 1) rather than
// returning a silently-wrong value, matching the "fail loud" convention
// used across NOVA's Result helpers.
fn ei_unwrap_left(e)
    if e["ei_tag"] == "left"
        return e["ei_val"]
    print("ei_unwrap_left: called on Right")
    exit(1)

// ei_unwrap_right: the Right value. Fatal if e is a Left (see ei_unwrap_left).
fn ei_unwrap_right(e)
    if e["ei_tag"] == "right"
        return e["ei_val"]
    print("ei_unwrap_right: called on Left")
    exit(1)

// ei_map_left: apply f to a Left value; a Right passes through unchanged.
fn ei_map_left(e, f)
    if e["ei_tag"] == "left"
        return ei_left(f(e["ei_val"]))
    return e

// ei_map_right: apply f to a Right value; a Left passes through unchanged.
fn ei_map_right(e, f)
    if e["ei_tag"] == "right"
        return ei_right(f(e["ei_val"]))
    return e

// ei_fold: eliminate the Either into a single value by supplying a handler
// for each side — left_fn(v) when Left, right_fn(v) when Right.
fn ei_fold(e, left_fn, right_fn)
    if e["ei_tag"] == "left"
        return left_fn(e["ei_val"])
    return right_fn(e["ei_val"])
