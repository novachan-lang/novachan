// std/logic/logic_boolexpr.nova — Parse and evaluate boolean expression strings.
// LEAF module — imports NOTHING.
//
// Operators by precedence (tight to loose):
//   ! (not, prefix, highest), & (and), ^ (xor), | (or, lowest)
//   Parentheses override precedence.
//   Variables are single lowercase letters a-z.
//
// AST node shapes (nested lists):
//   ["lit", name]     single variable
//   ["not", child]    !expr
//   ["and", l, r]     l & r
//   ["xor", l, r]     l ^ r
//   ["or",  l, r]     l | r
//
// Public API: all prefixed lbe_.

// ── private character helpers ─────────────────────────────────────────────────

// _lbe_is_lower — true if ch is a lowercase letter a-z.
fn _lbe_is_lower(ch) -> int
    let o = ord(ch)
    if o >= 97
        if o <= 122
            return 1
    0

// _lbe_is_space — true if ch is whitespace.
fn _lbe_is_space(ch) -> int
    let o = ord(ch)
    if o == 32
        return 1
    if o == 9
        return 1
    0

// ── tokeniser ─────────────────────────────────────────────────────────────────
// Token list: each token is a 1-char string or "!" "&" "^" "|" "(" ")".
// We skip whitespace.  Variables produce their letter.

// _lbe_tokenise — convert expression string to token list.
fn _lbe_tokenise(s) -> list
    let toks = []
    let n = len(s)
    let i = 0
    while i < n
        let ch = slice(s, i, i + 1)
        if _lbe_is_space(ch) == 0
            push(toks, ch)
        i = i + 1
    toks

// ── Pratt parser state (mutable dict) ────────────────────────────────────────
// state["toks"]  = token list
// state["pos"]   = current position (int)

// _lbe_peek — return current token or "" if at end.
fn _lbe_peek(st) -> str
    let toks = st["toks"]
    let pos = st["pos"]
    let result = ""
    if pos < len(toks)
        result = toks[pos]
    result

// _lbe_consume — advance position and return the consumed token.
fn _lbe_consume(st) -> str
    let toks = st["toks"]
    let pos = st["pos"]
    let tok = toks[pos]
    st["pos"] = pos + 1
    tok

// _lbe_rbp — right binding power of a binary operator (0 = not a binary op).
fn _lbe_rbp(op) -> int
    let p = 0
    if op == "|"
        p = 1
    if op == "^"
        p = 2
    if op == "&"
        p = 3
    p

// _lbe_make2 — build a 2-child AST node (tag, l, r).
fn _lbe_make2(tag, l, r) -> list
    let nd = []
    push(nd, tag)
    push(nd, l)
    push(nd, r)
    nd

// _lbe_nud — null denotation (prefix / atomic): parse and return atom/prefix.
fn _lbe_nud(st) -> list
    let tok = _lbe_consume(st)
    let result = []
    if tok == "!"
        let child = _lbe_pratt(st, 4)
        let nd = []
        push(nd, "not")
        push(nd, child)
        result = nd
    else
        if tok == "("
            let inner = _lbe_pratt(st, 0)
            // consume closing ")"
            let dummy = _lbe_consume(st)
            result = inner
        else
            // variable literal
            let nd2 = []
            push(nd2, "lit")
            push(nd2, tok)
            result = nd2
    result

// _lbe_pratt — Pratt precedence-climbing parser; min_rbp = minimum right BP.
fn _lbe_pratt(st, min_rbp) -> list
    let left = _lbe_nud(st)
    let going = 1
    while going == 1
        let op = _lbe_peek(st)
        let bp = _lbe_rbp(op)
        if bp == 0
            going = 0
        else
            if bp <= min_rbp
                going = 0
            else
                let consumed = _lbe_consume(st)
                let tag = ""
                if consumed == "&"
                    tag = "and"
                if consumed == "^"
                    tag = "xor"
                if consumed == "|"
                    tag = "or"
                let right = _lbe_pratt(st, bp)
                left = _lbe_make2(tag, left, right)
    left

// lbe_parse — parse a boolean expression string into an AST (nested list).
fn lbe_parse(s) -> list
    let toks = _lbe_tokenise(s)
    let st = {}
    st["toks"] = toks
    st["pos"] = 0
    _lbe_pratt(st, 0)

// ── evaluation ────────────────────────────────────────────────────────────────

// _lbe_lookup — find value of a variable name in names/vals parallel lists.
fn _lbe_lookup(name, names, vals) -> int
    let n = len(names)
    let i = 0
    let result = 0
    while i < n
        if names[i] == name
            result = vals[i]
        i = i + 1
    result

// _lbe_eval_ast — recursively evaluate an AST node.
fn _lbe_eval_ast(node, names, vals) -> int
    let tag = node[0]
    let result = 0
    if tag == "lit"
        result = _lbe_lookup(node[1], names, vals)
    if tag == "not"
        if _lbe_eval_ast(node[1], names, vals) == 0
            result = 1
    if tag == "and"
        if _lbe_eval_ast(node[1], names, vals) == 1
            if _lbe_eval_ast(node[2], names, vals) == 1
                result = 1
    if tag == "xor"
        let lv = _lbe_eval_ast(node[1], names, vals)
        let rv = _lbe_eval_ast(node[2], names, vals)
        if lv != rv
            result = 1
    if tag == "or"
        if _lbe_eval_ast(node[1], names, vals) == 1
            result = 1
        if _lbe_eval_ast(node[2], names, vals) == 1
            result = 1
    result

// lbe_eval_env — evaluate expression string s with named variables.
// names[i] is the name of variable i; vals[i] is its 0/1 value.
fn lbe_eval_env(s, names, vals) -> int
    let ast = lbe_parse(s)
    _lbe_eval_ast(ast, names, vals)

// ── variable extraction ───────────────────────────────────────────────────────

// _lbe_collect_vars — walk AST and collect variable names into seen dict + list.
fn _lbe_collect_vars(node, seen, out)
    let tag = node[0]
    if tag == "lit"
        let nm = node[1]
        if not contains(seen, nm)
            seen[nm] = 1
            push(out, nm)
    if tag == "not"
        _lbe_collect_vars(node[1], seen, out)
    if tag == "and"
        _lbe_collect_vars(node[1], seen, out)
        _lbe_collect_vars(node[2], seen, out)
    if tag == "xor"
        _lbe_collect_vars(node[1], seen, out)
        _lbe_collect_vars(node[2], seen, out)
    if tag == "or"
        _lbe_collect_vars(node[1], seen, out)
        _lbe_collect_vars(node[2], seen, out)

// _lbe_sort_strs — insertion sort a list of 1-char strings (in-place).
fn _lbe_sort_strs(lst)
    let n = len(lst)
    let i = 1
    while i < n
        let key = lst[i]
        let j = i - 1
        let going = 1
        while going == 1
            if j < 0
                going = 0
            else
                if lst[j] > key
                    lst[j + 1] = lst[j]
                    j = j - 1
                else
                    going = 0
        lst[j + 1] = key
        i = i + 1

// lbe_vars — return sorted unique variable letter strings in expression s.
fn lbe_vars(s) -> list
    let ast = lbe_parse(s)
    let seen = {}
    let out = []
    _lbe_collect_vars(ast, seen, out)
    _lbe_sort_strs(out)
    out

// ── truth table ───────────────────────────────────────────────────────────────

// lbe_truthtable — compute truth-table integer for expression s.
// names[b] is the variable for bit position b (LSB = names[0]).
// Bit i of result = f(assignment i) where bit b of i = value of names[b].
// ENUMERATION CHECK: all 2^n assignments are evaluated and OR'd into result.
fn lbe_truthtable(s, names) -> int
    let n = len(names)
    let total = 1
    let k = 0
    while k < n
        total = total * 2
        k = k + 1
    let ast = lbe_parse(s)
    let result = 0
    let i = 0
    while i < total
        // build vals list from bits of i
        let vals = []
        let b = 0
        while b < n
            push(vals, (i >> b) & 1)
            b = b + 1
        let bit = _lbe_eval_ast(ast, names, vals)
        if bit == 1
            result = result | (1 << i)
        i = i + 1
    result
