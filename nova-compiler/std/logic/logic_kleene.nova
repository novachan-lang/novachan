// std/logic/logic_kleene.nova — Kleene strong 3-valued logic.
// LEAF module — imports NOTHING.
//
// Three truth values: 0 = false, 1 = unknown, 2 = true.
// All connectives follow the Kleene strong K3 tables.
// All functions are pure and total over {0, 1, 2}.
// All public functions are prefixed lk3_.

// lk3_not — negation: NOT(a) = 2 - a.
// 0->2, 1->1, 2->0.
fn lk3_not(a) -> int
    2 - a

// lk3_and — conjunction: AND(a,b) = min(a,b).
// False dominates; unknown dominates true.
fn lk3_and(a, b) -> int
    let result = a
    if b < a
        result = b
    result

// lk3_or — disjunction: OR(a,b) = max(a,b).
// True dominates; unknown dominates false.
fn lk3_or(a, b) -> int
    let result = a
    if b > a
        result = b
    result

// lk3_implies — material implication: a->b = max(2-a, b).
// Equivalent to OR(NOT(a), b).
fn lk3_implies(a, b) -> int
    let nota = 2 - a
    let result = nota
    if b > nota
        result = b
    result

// lk3_iff — biconditional: a<->b.
// Defined as AND(implies(a,b), implies(b,a)) = min(max(2-a,b), max(2-b,a)).
fn lk3_iff(a, b) -> int
    let ab = lk3_implies(a, b)
    let ba = lk3_implies(b, a)
    let result = ab
    if ba < ab
        result = ba
    result

// lk3_is_designated — true iff a is a designated (accepted) value.
// In K3 only 2 (true) is designated; 0 and 1 are non-designated.
fn lk3_is_designated(a) -> bool
    a == 2

// lk3_from_bool — lift a classical boolean (0 or 1) into K3.
// 0 -> 0 (false), 1 -> 2 (true).
fn lk3_from_bool(x) -> int
    x * 2
