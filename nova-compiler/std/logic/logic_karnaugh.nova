// std/logic/logic_karnaugh.nova — Gray-code / K-map grouping utilities over n<=4 variables.
// Convention (A): TRUTH-TABLE-INT. Minterm index i = assignment as integer.
// LEAF — imports NOTHING.

// lkm_gray(k) -> int
// Standard Gray-code encoding: G(k) = k XOR (k >> 1).
fn lkm_gray(k)
    k ^ (k >> 1)

// lkm_gray_sequence(n) -> list of int
// Returns the 2^n Gray-code values in order: [G(0), G(1), ..., G(2^n - 1)].
fn lkm_gray_sequence(n)
    let total = 1 << n
    let out = []
    let i = 0
    while i < total
        push(out, lkm_gray(i))
        i += 1
    out

// lkm_adjacent(i, j) -> bool
// True iff i and j differ in exactly one bit (Hamming distance 1).
fn lkm_adjacent(i, j)
    let d = i ^ j
    if d == 0
        return false
    (d & (d - 1)) == 0

// _lkm_popcount(x) -> int
// Count set bits in non-negative integer x.
fn _lkm_popcount(x)
    let v = x
    let cnt = 0
    while v > 0
        cnt += (v & 1)
        v = v >> 1
    cnt

// _lkm_is_power_of_2(x) -> bool
// True iff x > 0 and x is a power of 2.
fn _lkm_is_power_of_2(x)
    if x <= 0
        return false
    (x & (x - 1)) == 0

// _lkm_validate_cells(cells, n) -> int
// Returns 1 if cells forms a valid K-map subcube, 0 otherwise.
// Internal helper used by both lkm_is_valid_group and lkm_group_to_cube.
// A valid subcube: non-empty, size = 2^k for some k, all 2^k combinations of the
// free (varying) bits appear, and all fixed bits agree across all cells.
fn _lkm_validate_cells(cells, n)
    let sz = len(cells)
    if sz == 0
        return 0
    if not _lkm_is_power_of_2(sz)
        return 0
    // Compute AND and OR of all cell indices.
    let andv = cells[0]
    let orv = cells[0]
    for i in 1..sz
        andv = andv & cells[i]
        orv = orv | cells[i]
    // Bits that differ across cells.
    let varying = orv ^ andv
    // Fixed mask: bits 0..n-1 that do NOT vary.
    let all_n_bits = (1 << n) - 1
    let fixed_mask = all_n_bits ^ varying
    let nfree = _lkm_popcount(varying)
    let expected_sz = 1 << nfree
    if expected_sz != sz
        return 0
    // All cells must agree on fixed bits (already guaranteed by andv/orv logic, but verify).
    let fixed_val = andv & fixed_mask
    // Enumerate all cells; compress free-bit pattern to an index and track seen patterns.
    let seen = 0
    for ci in 0..sz
        let c = cells[ci]
        if (c & fixed_mask) != fixed_val
            return 0
        // Compress the varying bits of c to a dense index.
        let idx = 0
        let bit_pos = 0
        let fb = 0
        while fb < n
            if (varying >> fb) & 1 == 1
                let bval = (c >> fb) & 1
                idx = idx | (bval << bit_pos)
                bit_pos += 1
            fb += 1
        if (seen >> idx) & 1 == 1
            return 0
        seen = seen | (1 << idx)
    // all_seen: bitmask with bits 0..expected_sz-1 all set.
    let all_seen = (1 << expected_sz) - 1
    if seen != all_seen
        return 0
    1

// lkm_is_valid_group(cells, n) -> bool
// True iff the set of minterm indices in cells forms a valid K-map subcube:
// non-empty, size a power of 2, and all 2^k combinations of the free bits appear.
fn lkm_is_valid_group(cells, n)
    _lkm_validate_cells(cells, n) == 1

// lkm_group_to_cube(cells, n) -> list
// If cells forms a valid K-map subcube, returns the covering cube (list of length n over {0,1,2}).
// Returns [] if cells is not a valid subcube.
fn lkm_group_to_cube(cells, n)
    if _lkm_validate_cells(cells, n) == 0
        return []
    let sz = len(cells)
    let andv = cells[0]
    let orv = cells[0]
    for i in 1..sz
        andv = andv & cells[i]
        orv = orv | cells[i]
    let varying = orv ^ andv
    // Build cube: varying bit => 2, fixed-1 bit => 1, fixed-0 bit => 0.
    let cube = []
    let b = 0
    let n2 = len(cells)
    // n2 not needed; use n parameter directly.
    while b < n
        if (varying >> b) & 1 == 1
            push(cube, 2)
        else if (andv >> b) & 1 == 1
            push(cube, 1)
        else
            push(cube, 0)
        b += 1
    cube
