// std/logic/logic_nnf.nova — Formula-AST transforms for propositional logic.
// LEAF module — imports NOTHING.
//
// AST NODES (nested lists, 2 or 3 elements):
//   ["var", k]      k = 0-based variable index (int)
//   ["const", v]    v = 0 (false) or 1 (true)
//   ["not", f]      unary negation
//   ["and", f, g]   binary conjunction
//   ["or",  f, g]   binary disjunction
//
// All public functions are prefixed lnf_.
//
// REPRESENTATION: an assignment 'asgn' is a list of 0/1 values
//   where asgn[k] is the truth value of variable k.

// lnf_eval — evaluate a formula AST under assignment asgn; returns 0 or 1.
fn lnf_eval(f, asgn) -> int
    let tag = f[0]
    let result = 0
    if tag == "const"
        result = f[1]
    else if tag == "var"
        result = asgn[f[1]]
    else if tag == "not"
        if lnf_eval(f[1], asgn) == 0
            result = 1
    else if tag == "and"
        if lnf_eval(f[1], asgn) == 1
            if lnf_eval(f[2], asgn) == 1
                result = 1
    else if tag == "or"
        if lnf_eval(f[1], asgn) == 1
            result = 1
        if lnf_eval(f[2], asgn) == 1
            result = 1
    result

// lnf_simplify — constant-fold a formula AST.
// Rules: and(f,const1)=>f, and(f,const0)=>const0,
//        or(f,const0)=>f, or(f,const1)=>const1,
//        not(const0)=>const1, not(const1)=>const0, not(not(f))=>f.
fn lnf_simplify(f) -> list
    let tag = f[0]
    let result = f
    if tag == "const"
        result = f
    else if tag == "var"
        result = f
    else if tag == "not"
        let inner = lnf_simplify(f[1])
        if inner[0] == "const"
            let flipped = 1 if inner[1] == 0 else 0
            let c = []
            push(c, "const")
            push(c, flipped)
            result = c
        else if inner[0] == "not"
            result = inner[1]
        else
            let n = []
            push(n, "not")
            push(n, inner)
            result = n
    else if tag == "and"
        let ls = lnf_simplify(f[1])
        let rs = lnf_simplify(f[2])
        if ls[0] == "const"
            if ls[1] == 0
                let c0 = []
                push(c0, "const")
                push(c0, 0)
                result = c0
            else
                result = rs
        else if rs[0] == "const"
            if rs[1] == 0
                let c0 = []
                push(c0, "const")
                push(c0, 0)
                result = c0
            else
                result = ls
        else
            let nd = []
            push(nd, "and")
            push(nd, ls)
            push(nd, rs)
            result = nd
    else if tag == "or"
        let ls2 = lnf_simplify(f[1])
        let rs2 = lnf_simplify(f[2])
        if ls2[0] == "const"
            if ls2[1] == 1
                let c1 = []
                push(c1, "const")
                push(c1, 1)
                result = c1
            else
                result = rs2
        else if rs2[0] == "const"
            if rs2[1] == 1
                let c1 = []
                push(c1, "const")
                push(c1, 1)
                result = c1
            else
                result = ls2
        else
            let od = []
            push(od, "or")
            push(od, ls2)
            push(od, rs2)
            result = od
    result

// _lnf_nnf_neg — push a negation down one level (NNF helper).
// Assumes the outer NOT has been stripped; produces NNF of (NOT f).
fn _lnf_nnf_neg(f) -> list
    let tag = f[0]
    let result = f
    if tag == "const"
        let flipped = 1 if f[1] == 0 else 0
        let c = []
        push(c, "const")
        push(c, flipped)
        result = c
    else if tag == "var"
        // NOT var => stay as NOT (literal)
        let n = []
        push(n, "not")
        push(n, f)
        result = n
    else if tag == "not"
        // double negation: NOT NOT f => lnf_to_nnf(f)
        result = lnf_to_nnf(f[1])
    else if tag == "and"
        // De Morgan: NOT(f AND g) => (NOT f) OR (NOT g)
        let left = _lnf_nnf_neg(f[1])
        let right = _lnf_nnf_neg(f[2])
        let od = []
        push(od, "or")
        push(od, left)
        push(od, right)
        result = od
    else if tag == "or"
        // De Morgan: NOT(f OR g) => (NOT f) AND (NOT g)
        let left2 = _lnf_nnf_neg(f[1])
        let right2 = _lnf_nnf_neg(f[2])
        let nd = []
        push(nd, "and")
        push(nd, left2)
        push(nd, right2)
        result = nd
    result

// lnf_to_nnf — convert formula to Negation Normal Form.
// NOTs are pushed all the way down to literals (var or const); double negations eliminated.
fn lnf_to_nnf(f) -> list
    let tag = f[0]
    let result = f
    if tag == "const"
        result = f
    else if tag == "var"
        result = f
    else if tag == "not"
        result = _lnf_nnf_neg(f[1])
    else if tag == "and"
        let ln = lnf_to_nnf(f[1])
        let rn = lnf_to_nnf(f[2])
        let nd = []
        push(nd, "and")
        push(nd, ln)
        push(nd, rn)
        result = nd
    else if tag == "or"
        let lo = lnf_to_nnf(f[1])
        let ro = lnf_to_nnf(f[2])
        let od = []
        push(od, "or")
        push(od, lo)
        push(od, ro)
        result = od
    result

// _lnf_dist_or — distribute OR over AND to get CNF.
// Given two sub-formulae already in CNF, produce (f OR g) in CNF.
// Uses distributive law: (A AND B) OR g => (A OR g) AND (B OR g).
fn _lnf_dist_or(f, g) -> list
    if f[0] == "and"
        // (fl AND fr) OR g => (fl OR g) AND (fr OR g)
        let left = _lnf_dist_or(f[1], g)
        let right = _lnf_dist_or(f[2], g)
        let nd = []
        push(nd, "and")
        push(nd, left)
        push(nd, right)
        nd
    else if g[0] == "and"
        // f OR (gl AND gr) => (f OR gl) AND (f OR gr)
        let left2 = _lnf_dist_or(f, g[1])
        let right2 = _lnf_dist_or(f, g[2])
        let nd2 = []
        push(nd2, "and")
        push(nd2, left2)
        push(nd2, right2)
        nd2
    else
        let od = []
        push(od, "or")
        push(od, f)
        push(od, g)
        od

// _lnf_nnf_to_cnf — convert an NNF formula to CNF via distributive laws.
fn _lnf_nnf_to_cnf(f) -> list
    let tag = f[0]
    let result = f
    if tag == "and"
        let lc = _lnf_nnf_to_cnf(f[1])
        let rc = _lnf_nnf_to_cnf(f[2])
        let nd = []
        push(nd, "and")
        push(nd, lc)
        push(nd, rc)
        result = nd
    else if tag == "or"
        let lc2 = _lnf_nnf_to_cnf(f[1])
        let rc2 = _lnf_nnf_to_cnf(f[2])
        result = _lnf_dist_or(lc2, rc2)
    result

// lnf_to_cnf — convert formula to Conjunctive Normal Form (AND of ORs).
// Result is logically equivalent. Via NNF then distributivity.
fn lnf_to_cnf(f) -> list
    let nnf = lnf_to_nnf(f)
    _lnf_nnf_to_cnf(nnf)

// _lnf_dist_and — distribute AND over OR to get DNF.
// Given two sub-formulae already in DNF, produce (f AND g) in DNF.
fn _lnf_dist_and(f, g) -> list
    if f[0] == "or"
        let left = _lnf_dist_and(f[1], g)
        let right = _lnf_dist_and(f[2], g)
        let od = []
        push(od, "or")
        push(od, left)
        push(od, right)
        od
    else if g[0] == "or"
        let left2 = _lnf_dist_and(f, g[1])
        let right2 = _lnf_dist_and(f, g[2])
        let od2 = []
        push(od2, "or")
        push(od2, left2)
        push(od2, right2)
        od2
    else
        let nd = []
        push(nd, "and")
        push(nd, f)
        push(nd, g)
        nd

// _lnf_nnf_to_dnf — convert an NNF formula to DNF via distributive laws.
fn _lnf_nnf_to_dnf(f) -> list
    let tag = f[0]
    let result = f
    if tag == "or"
        let ld = _lnf_nnf_to_dnf(f[1])
        let rd = _lnf_nnf_to_dnf(f[2])
        let od = []
        push(od, "or")
        push(od, ld)
        push(od, rd)
        result = od
    else if tag == "and"
        let ld2 = _lnf_nnf_to_dnf(f[1])
        let rd2 = _lnf_nnf_to_dnf(f[2])
        result = _lnf_dist_and(ld2, rd2)
    result

// lnf_to_dnf — convert formula to Disjunctive Normal Form (OR of ANDs).
// Result is logically equivalent. Via NNF then distributivity.
fn lnf_to_dnf(f) -> list
    let nnf = lnf_to_nnf(f)
    _lnf_nnf_to_dnf(nnf)
