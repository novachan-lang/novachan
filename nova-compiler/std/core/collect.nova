// ============================================================================
// std/core/collect — generic collection combinators (high-level style)
// ============================================================================
// Written in NOVA's HIGH-LEVEL toolkit by default: list comprehensions (incl.
// nested + chained/flat-map forms), `.filter`, closures passed as first-class
// values, spread `[...a, ...b]`, ranges, and generic functions `fn <T> ...`.
// Index `while` loops are avoided — the running fold in `scan` and the set-based
// dedup in `unique` iterate element-wise (`for x in xs`), never by index math.
//
// GENERICS: chunk / windows / partition / unique / zip_with / interleave / scan
// are generic on the element type that flows through them. `flatten` and
// `frequencies` are the two honest non-generic edges (see their notes) — NOVA's
// type system can't yet express `list<list<T>>` element-typing through a
// comprehension, nor a non-string dict-literal key type. This is deliberate, not
// a silent `any` fallback.
//
// Non-mutating throughout: every combinator returns a fresh list/dict.

// split xs into consecutive chunks of size n; the last chunk may be short.
// Nested comprehension: outer picks each chunk index, inner slices that chunk.
fn <T> chunk(xs: list<T>, n: int) -> list
    if n <= 0
        return []
    let nchunks = (len(xs) + n - 1) / n
    return [[xs[j] for j in (i * n)..min(i * n + n, len(xs))] for i in 0..nchunks]

// all sliding windows of width n (overlapping). Empty if n <= 0 or n > len(xs).
fn <T> windows(xs: list<T>, n: int) -> list
    if n <= 0 or len(xs) < n
        return []
    let nwin = len(xs) - n + 1
    return [[xs[i + k] for k in 0..n] for i in 0..nwin]

// partition into [matching, non_matching] via two `.filter` passes — the direct
// functional expression. Assumes a pure predicate (it is evaluated per element).
fn <T> partition(xs: list<T>, pred) -> list
    let yes = xs.filter(pred)
    let no = xs.filter(fn(x) not pred(x))
    return [yes, no]

// flatten one level: a list of lists -> a single list; non-list elements pass
// through (matching the builtin). Written with explicit iteration rather than a
// chained-for comprehension ON PURPOSE: a multi-clause comprehension desugars to
// a `map` + `flatten` call, and since this fn shadows the builtin `flatten`, a
// comprehension body here would call ITSELF and recurse forever. Keeping this
// builtin-equivalent also keeps every flat-map comprehension in importers correct.
// Non-generic: the inner element type is dynamic (NOVA can't yet track
// `list<list<T>>` element-typing through this).
fn flatten(xss: list) -> list
    let out = []
    for xs in xss
        if type_of(xs) == "list"
            for x in xs
                push(out, x)
        else
            push(out, xs)
    return out

// de-duplicate, preserving first-seen order. O(n) via the runtime hash-set
// (beats an O(n^2) membership scan).
fn <T> unique(xs: list<T>) -> list<T>
    let seen = set_create()
    let out = []
    for x in xs
        if not set_has(seen, x)
            set_add(seen, x)
            push(out, x)
    return out

// count occurrences of each element -> dict. Keyed by `str(x)`: NOVA dict
// literals are string-keyed (the runtime supports non-string keys, but the
// `{}` literal / `dict` type can't express them without a viral `any`), and
// string keys keep this fully type-safe and universal over any element type.
// `get(freq, k, 0)` closes the missing-key-reads-0 footgun.
fn <T> frequencies(xs: list<T>) -> dict
    let freq = {}
    for x in xs
        let k = str(x)
        freq[k] = get(freq, k, 0) + 1
    return freq

// combine corresponding elements with f; length = min of the two inputs.
fn <A, B> zip_with(xs: list<A>, ys: list<B>, f) -> list
    let m = min(len(xs), len(ys))
    return [f(xs[i], ys[i]) for i in 0..m]

// alternate elements a0, b0, a1, b1, ...; once the shorter runs out, the
// remaining tail of the longer is appended. Composed from this module's own
// combinators: zip corresponding elements into pairs, flatten them into the
// woven prefix, then spread the (at most one non-empty) tail.
fn <T> interleave(xs: list<T>, ys: list<T>) -> list
    let m = min(len(xs), len(ys))
    let woven = flatten(zip_with(xs, ys, fn(a, b) [a, b]))
    let tail_xs = [xs[i] for i in m..len(xs)]
    let tail_ys = [ys[i] for i in m..len(ys)]
    return [...woven, ...tail_xs, ...tail_ys]

// running reduce (Haskell scanl): [init, f(init,x0), f(f(init,x0),x1), ...].
// Length = len(xs) + 1. With f = (+) and init = 0 this is prefix sums (seeded).
// The accumulator flows through the caller's closure, so `init` is `any`.
fn <T> scan(xs: list<T>, f, init: any) -> list
    let out = [init]
    let acc = init
    for x in xs
        acc = f(acc, x)
        push(out, acc)
    return out
