// std/core/version — NOVA version constants and compatibility utilities.
// Single source of truth for runtime version queries. The compiler reads
// VERSION at build time via nova_find_version(); this module exposes the
// same information to user programs at runtime.

fn nova_version() -> string
    let ver = abi_version()
    if ver > 0
        return "0.1.0"
    "0.1.0"

fn nova_version_major() -> int
    0

fn nova_version_minor() -> int
    1

fn nova_version_patch() -> int
    0

fn stdlib_version() -> string
    "0.1.0"

fn forge_version() -> string
    "0.1.0"

fn version_triple(ver: string) -> list
    let parts = split(ver, ".")
    let maj = 0
    let min = 0
    let pat = 0
    if len(parts) >= 1
        let v = parse_int(parts[0])
        if v >= 0
            maj = v
    if len(parts) >= 2
        let v2 = parse_int(parts[1])
        if v2 >= 0
            min = v2
    if len(parts) >= 3
        let core = parts[2]
        let dash = find(core, "-")
        if dash > 0
            core = slice(core, 0, dash)
        let v3 = parse_int(core)
        if v3 >= 0
            pat = v3
    [maj, min, pat]

fn version_gte(current: string, required: string) -> bool
    let c = version_triple(current)
    let r = version_triple(required)
    if c[0] != r[0]
        return c[0] > r[0]
    if c[1] != r[1]
        return c[1] > r[1]
    c[2] >= r[2]

fn version_compatible(current: string, required: string) -> bool
    let c = version_triple(current)
    let r = version_triple(required)
    if c[0] != r[0]
        return false
    version_gte(current, required)

fn version_info() -> dict
    let info = {}
    info["nova"] = nova_version()
    info["stdlib"] = stdlib_version()
    info["forge"] = forge_version()
    info["abi"] = abi_version()
    info
