// ============================================================================
// std/core/dict — generic, high-level dict utilities
// ============================================================================
// High-level NOVA: generics + closures, non-mutating. `dict_get_or` also closes
// the "missing key -> 0" footgun with a typed default.

// get a key's value, or a default when absent (no silent 0/"" on a miss). Returns
// `any` — a dict value is dynamically typed (d[k] is `any`), so a generic `-> V`
// cannot be inferred here; the caller compares/uses it against a known type.
fn dict_get_or(d: dict, k: string, default: any) -> any
    if contains(d, k)
        return d[k]
    return default

// keys whose VALUE satisfies pred.
fn dict_keys_where(d: dict, pred) -> list
    let out = []
    for k in keys(d)
        if pred(d[k])
            push(out, k)
    return out

// apply f to every value, returning a NEW dict (non-mutating).
fn dict_map_values(d: dict, f) -> dict
    let out = {}
    for k in keys(d)
        out[k] = f(d[k])
    return out

// merge b into a (b wins on key conflict), non-mutating.
fn dict_merge(a: dict, b: dict) -> dict
    let out = {}
    for k in keys(a)
        out[k] = a[k]
    for k in keys(b)
        out[k] = b[k]
    return out

// count entries whose value satisfies pred.
fn dict_count(d: dict, pred) -> int
    let n = 0
    for k in keys(d)
        if pred(d[k])
            n = n + 1
    return n

// does any value satisfy pred?
fn dict_any_value(d: dict, pred) -> bool
    for k in keys(d)
        if pred(d[k])
            return true
    return false

// keep only entries whose value satisfies pred.
fn dict_filter_values(d: dict, pred) -> dict
    let out = {}
    for k in keys(d)
        if pred(d[k])
            out[k] = d[k]
    return out

// keep only entries whose key satisfies pred.
fn dict_filter_keys(d: dict, pred) -> dict
    let out = {}
    for k in keys(d)
        if pred(k)
            out[k] = d[k]
    return out

// invert: swap keys and values (last value wins on collision).
fn dict_invert(d: dict) -> dict
    let out = {}
    for k in keys(d)
        out[str(d[k])] = k
    return out

// sorted keys.
fn dict_sorted_keys(d: dict) -> list
    let ks = keys(d)
    return sort(ks)

// number of entries.
fn dict_size(d: dict) -> int
    return len(keys(d))

// all values satisfy pred?
fn dict_all_values(d: dict, pred) -> bool
    for k in keys(d)
        if not pred(d[k])
            return false
    return true
