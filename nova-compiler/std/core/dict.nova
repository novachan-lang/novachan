// ============================================================================
// std/core/dict — generic, high-level dict utilities
// ============================================================================
// High-level NOVA: generics + closures, non-mutating. `dict_get_or` also closes
// the "missing key -> 0" footgun with a typed default.

// get a key's value, or a default when absent (no silent 0/"" on a miss). Returns
// `any` — a dict value is dynamically typed (d[k] is `any`), so a generic `-> V`
// cannot be inferred here; the caller compares/uses it against a known type.
fn dict_get_or(d: dict, k: string, default: any) -> any
    if contains(d, k)
        return d[k]
    return default

// keys whose VALUE satisfies pred.
fn dict_keys_where(d: dict, pred) -> list
    let out = []
    for k in keys(d)
        if pred(d[k])
            push(out, k)
    return out

// apply f to every value, returning a NEW dict (non-mutating).
fn dict_map_values(d: dict, f) -> dict
    let out = {}
    for k in keys(d)
        out[k] = f(d[k])
    return out

// merge b into a (b wins on key conflict), non-mutating.
fn dict_merge(a: dict, b: dict) -> dict
    let out = {}
    for k in keys(a)
        out[k] = a[k]
    for k in keys(b)
        out[k] = b[k]
    return out

// count entries whose value satisfies pred.
fn dict_count(d: dict, pred) -> int
    let n = 0
    for k in keys(d)
        if pred(d[k])
            n = n + 1
    return n

// does any value satisfy pred?
fn dict_any_value(d: dict, pred) -> bool
    for k in keys(d)
        if pred(d[k])
            return true
    return false
