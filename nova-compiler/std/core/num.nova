// ============================================================================
// std/core/num — high-level integer utilities
// ============================================================================
// int-focused (avoids the abs(float)->i64 gotcha). All pure, total functions.

fn int_abs(x: int) -> int
    if x < 0
        return 0 - x
    return x

fn int_sign(x: int) -> int
    if x > 0
        return 1
    if x < 0
        return 0 - 1
    return 0

fn int_clamp(x: int, lo: int, hi: int) -> int
    if x < lo
        return lo
    if x > hi
        return hi
    return x

fn int_min(a: int, b: int) -> int
    if a < b
        return a
    return b

fn int_max(a: int, b: int) -> int
    if a > b
        return a
    return b

// greatest common divisor (Euclid), always non-negative.
fn int_gcd(a: int, b: int) -> int
    let x = int_abs(a)
    let y = int_abs(b)
    while y != 0
        let t = y
        y = x % y
        x = t
    return x

// least common multiple (0 if either operand is 0).
fn int_lcm(a: int, b: int) -> int
    if a == 0 or b == 0
        return 0
    let g = int_gcd(a, b)
    return int_abs(a / g * b)

// integer exponentiation (exp <= 0 -> 1).
fn int_pow(base: int, exp: int) -> int
    if exp <= 0
        return 1
    let r = 1
    let i = 0
    while i < exp
        r = r * base
        i = i + 1
    return r

fn int_is_even(x: int) -> bool
    return x % 2 == 0

fn int_is_odd(x: int) -> bool
    return x % 2 != 0
