// ============================================================================
// std/core/seq — generic, high-level sequence utilities
// ============================================================================
// Written in NOVA's HIGH-LEVEL style: generic functions (`fn <T> ...`), closures
// passed as first-class values, and `Result`/`match` for fallible ops — NOT the
// `any`+type_of+manual-loop style. This is the standard for new code, and it
// fills a real gap (the stdlib had 0 generic functions).

// fold left: collapse xs into an accumulator via f(acc, x). The accumulator type
// is dynamic (it flows through the caller's closure, which the inferencer cannot
// see into), so the result is `any` — the caller knows what it folded into. This
// is the honest type: NOVA cannot infer a generic return through an untyped
// closure, so it is not annotated as generic (a real, documented inference edge).
fn <T> seq_fold(xs: list<T>, init: any, f) -> any
    let acc = init
    for x in xs
        acc = f(acc, x)
    return acc

// reduce: fold with the first element as the seed. Result (Ok(acc) | Err) — Err on empty.
fn <T> seq_reduce(xs: list<T>, f) -> Result
    if len(xs) == 0
        return err("seq_reduce: empty sequence")
    let acc = xs[0]
    let i = 1
    while i < len(xs)
        acc = f(acc, xs[i])
        i = i + 1
    return ok(acc)

// find: first element satisfying pred, as Result<T,string> (Err if none).
fn <T> seq_find(xs: list<T>, pred) -> Result
    for x in xs
        if pred(x)
            return ok(x)
    return err("seq_find: no element matched")

// any / all: existential / universal quantifiers over a predicate.
fn <T> seq_any(xs: list<T>, pred) -> bool
    for x in xs
        if pred(x)
            return true
    return false

fn <T> seq_all(xs: list<T>, pred) -> bool
    for x in xs
        if not pred(x)
            return false
    return true

// count elements satisfying pred.
fn <T> seq_count(xs: list<T>, pred) -> int
    let n = 0
    for x in xs
        if pred(x)
            n = n + 1
    return n

// take / drop first k (bounds-clamped, defensive).
fn <T> seq_take(xs: list<T>, k: int) -> list<T>
    let out = []
    let i = 0
    while i < len(xs) and i < k
        push(out, xs[i])
        i = i + 1
    return out

fn <T> seq_drop(xs: list<T>, k: int) -> list<T>
    let out = []
    let i = k
    while i < len(xs)
        if i >= 0
            push(out, xs[i])
        i = i + 1
    return out

// zip two sequences into a list of 2-element [a,b] pairs (length = min).
fn <A, B> seq_zip(xs: list<A>, ys: list<B>) -> list
    let out = []
    let i = 0
    while i < len(xs) and i < len(ys)
        push(out, [xs[i], ys[i]])
        i = i + 1
    return out

// reverse (generic, non-mutating).
fn <T> seq_reverse(xs: list<T>) -> list<T>
    let out = []
    let i = len(xs) - 1
    while i >= 0
        push(out, xs[i])
        i = i - 1
    return out
