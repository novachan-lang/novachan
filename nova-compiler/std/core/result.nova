// ============================================================================
// std/core/result — high-level Result combinators
// ============================================================================
// Ergonomic helpers over `Result` (Ok(v) | Err(e)). These are now viable at
// multiple call sites because a bare `Result` annotation is a polymorphic sum
// (freshened per call) — the #1 inference fix that unblocked reusable Result
// libraries.

fn result_is_ok(r: Result) -> bool
    match r
        Ok(v) =>
            return true
        Err(e) =>
            return false

fn result_is_err(r: Result) -> bool
    return not result_is_ok(r)

// unwrap the Ok value, or a default when Err.
fn result_unwrap_or(r: Result, default: any) -> any
    match r
        Ok(v) =>
            return v
        Err(e) =>
            return default

// unwrap the Ok value, or apply a recovery closure to the Err message.
fn result_unwrap_or_else(r: Result, f) -> any
    match r
        Ok(v) =>
            return v
        Err(e) =>
            return f(e)

// apply f to the Ok value (Err passes through unchanged).
fn result_map(r: Result, f) -> Result
    match r
        Ok(v) =>
            return ok(f(v))
        Err(e) =>
            return err(e)

// apply f to the Err message (Ok passes through unchanged).
fn result_map_err(r: Result, f) -> Result
    match r
        Ok(v) =>
            return ok(v)
        Err(e) =>
            return err(f(e))

// chain: apply f (which itself returns a Result) to the Ok value.
fn result_and_then(r: Result, f) -> Result
    match r
        Ok(v) =>
            return f(v)
        Err(e) =>
            return err(e)
