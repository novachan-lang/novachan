// ============================================================================
// std/core/str — high-level string utilities
// ============================================================================
// Slicing-based (s[i:j]), non-mutating. Additive to the string builtins.

fn str_reverse(s: string) -> string
    let out = ""
    let i = len(s) - 1
    while i >= 0
        out = out + s[i:i+1]
        i = i - 1
    return out

fn str_repeat(s: string, n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + s
        i = i + 1
    return out

// left-pad with `pad` until length >= width.
fn str_pad_left(s: string, width: int, pad: string) -> string
    if len(pad) == 0
        return s
    let out = s
    while len(out) < width
        out = pad + out
    return out

// right-pad with `pad` until length >= width.
fn str_pad_right(s: string, width: int, pad: string) -> string
    if len(pad) == 0
        return s
    let out = s
    while len(out) < width
        out = out + pad
    return out

// count non-overlapping occurrences of sub in s.
fn str_count(s: string, sub: string) -> int
    if len(sub) == 0
        return 0
    let n = 0
    let i = 0
    while i <= len(s) - len(sub)
        if s[i:i+len(sub)] == sub
            n = n + 1
            i = i + len(sub)
        else
            i = i + 1
    return n

// character (1-char string) at index i, or "" if out of range.
fn str_char_at(s: string, i: int) -> string
    if i < 0
        return ""
    if i >= len(s)
        return ""
    return s[i:i+1]
