// ============================================================================
// std/core/list — high-level list utilities (complements std/core/seq)
// ============================================================================
// Uses only proven-working patterns (generic-param + closure + concrete return,
// value equality). Non-mutating.

fn list_contains(xs: list, target: any) -> bool
    for x in xs
        if x == target
            return true
    return false

// first index of target, or -1 if absent.
fn list_index_of(xs: list, target: any) -> int
    let i = 0
    while i < len(xs)
        if xs[i] == target
            return i
        i = i + 1
    return 0 - 1

// de-duplicate, preserving first-seen order.
fn list_unique(xs: list) -> list
    let out = []
    for x in xs
        if not list_contains(out, x)
            push(out, x)
    return out

// concatenate two lists into a new one.
fn list_concat(a: list, b: list) -> list
    let out = []
    for x in a
        push(out, x)
    for x in b
        push(out, x)
    return out

// flatten one level: a list of lists -> a single list.
fn list_flatten(xss: list) -> list
    let out = []
    for xs in xss
        for x in xs
            push(out, x)
    return out

// sum of an int list.
fn list_sum(xs: list<int>) -> int
    let s = 0
    for x in xs
        s = s + x
    return s

// split into consecutive chunks of size n (last chunk may be shorter).
fn list_chunk(xs: list, n: int) -> list
    let out = []
    let cur = []
    for x in xs
        push(cur, x)
        if len(cur) >= n
            push(out, cur)
            cur = []
    if len(cur) > 0
        push(out, cur)
    return out
