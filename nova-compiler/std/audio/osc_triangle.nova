// std/audio/osc_triangle.nova — Triangle wave oscillator.
// Prefix: osc_triangle_
// Provides: osc_triangle
// LEAF — imports NOTHING.
//
// osc_triangle(phase01) -> float
//   Triangle wave. phase01 in [0.0, 1.0).
//   Rises from -1.0 at phase01=0.0 to 1.0 at phase01=0.5,
//   then falls back to -1.0 at phase01=1.0.
//   Formula:
//     if phase01 < 0.5: -1.0 + 4.0*phase01
//     else:              3.0 - 4.0*phase01
//
// FLOAT RULES:
//   - All inputs/outputs are floats.
//   - Bind sub-expressions to named lets before returning.

// osc_triangle(phase01) -> float
// Triangle wave oscillator. phase01 in [0.0, 1.0).
fn osc_triangle(phase01: float) -> float
    let result = 0.0
    if phase01 < 0.5
        let scaled = 4.0 * phase01
        result = -1.0 + scaled
    else
        let scaled = 4.0 * phase01
        result = 3.0 - scaled
    result
