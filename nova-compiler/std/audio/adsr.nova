// std/audio/adsr.nova — ADSR envelope generator.
// Prefix: adsr_
// Provides: adsr_value
// LEAF — imports NOTHING.
//
// adsr_value(t, attack, decay, sustain, release, gate_time) -> float
//   Computes the ADSR envelope amplitude at time t.
//
//   Segments:
//     Attack:  t in [0, attack)              -> linear 0.0 to 1.0
//     Decay:   t in [attack, attack+decay)   -> linear 1.0 to sustain
//     Sustain: t in [attack+decay, gate_time)-> constant sustain level
//     Release: t in [gate_time, gate_time+release) -> linear sustain to 0.0
//     After:   t >= gate_time + release      -> 0.0
//
//   Parameters:
//     t         — time in seconds (>= 0.0)
//     attack    — attack duration in seconds (> 0.0)
//     decay     — decay duration in seconds (> 0.0)
//     sustain   — sustain level in [0.0, 1.0]
//     release   — release duration in seconds (> 0.0)
//     gate_time — time the note is released (end of sustain phase)
//
// FLOAT RULES:
//   - All inputs/outputs are floats.
//   - Bind sub-expressions to named lets before returning.
//   - Division guarded against zero (attack/decay/release assumed > 0.0).

// adsr_value(t, attack, decay, sustain, release, gate_time) -> float
// Returns envelope amplitude at time t.
fn adsr_value(t: float, attack: float, decay: float, sustain: float, release: float, gate_time: float) -> float
    let result = 0.0
    let attack_end = attack
    let decay_end = attack + decay
    if t < 0.0
        result = 0.0
    else
        if t < attack_end
            // Attack phase: linear ramp 0.0 -> 1.0
            let frac = t / attack
            result = frac
        else
            if t < decay_end
                // Decay phase: linear ramp 1.0 -> sustain
                let elapsed = t - attack_end
                let frac = elapsed / decay
                let drop = 1.0 - sustain
                result = 1.0 - frac * drop
            else
                if t < gate_time
                    // Sustain phase: constant sustain level
                    result = sustain
                else
                    let release_end = gate_time + release
                    if t < release_end
                        // Release phase: linear ramp sustain -> 0.0
                        let elapsed = t - gate_time
                        let frac = elapsed / release
                        result = sustain - frac * sustain
                    else
                        // After release: silence
                        result = 0.0
    result
