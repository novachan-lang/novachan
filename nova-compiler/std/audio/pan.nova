// std/audio/pan.nova -- Stereo panning utilities. LEAF -- imports NOTHING.
//
// Public API (prefix pan_)
//   pan_linear(sample, pan)         -> list [left, right]
//     pan in [-1.0, 1.0]: -1 = full left, 0 = center, +1 = full right.
//     left  = sample * (0.5 - 0.5 * pan)
//     right = sample * (0.5 + 0.5 * pan)
//
//   pan_constant_power(sample, pan) -> list [left, right]
//     Equal-power panning using sin/cos to keep loudness constant.
//     angle = (pan + 1.0) * PI / 4.0   (maps [-1,1] -> [0, PI/2])
//     left  = sample * cos(angle)
//     right = sample * sin(angle)
//
// FLOAT RULES obeyed:
//   - List element reads are 'any'; multiply by 1.0 to force float.
//   - Bind all composite sub-expressions to named lets before returning.
//   - Float vs int compare is UNSOUND; use float literals (0.0).
//   - PI constant via zero-arg fn (no module-level let consts).

// _pan_pi -- mathematical constant pi
fn _pan_pi() -> float
    let v = 3.14159265358979
    v

// pan_linear -- Linear amplitude panning.
// Returns a 2-element list [left, right].
// At pan=0 (center): left = right = sample * 0.5
// At pan=-1 (full left): left = sample, right = 0.0
// At pan=+1 (full right): left = 0.0, right = sample
fn pan_linear(sample: float, pan: float) -> list
    let half = 0.5
    let left_gain  = half - half * pan
    let right_gain = half + half * pan
    let left  = sample * left_gain
    let right = sample * right_gain
    let result = []
    push(result, left)
    push(result, right)
    result

// pan_constant_power -- Equal-power (constant-power) panning.
// Maps pan in [-1.0, 1.0] to an angle in [0, PI/2].
// Uses cos/sin so that left^2 + right^2 = sample^2 (power-invariant).
// At pan=0 (center): left = right = sample * cos(PI/4) = sample * sqrt(2)/2 ~= 0.7071 * sample
// Returns a 2-element list [left, right].
fn pan_constant_power(sample: float, pan: float) -> list
    let pi = _pan_pi()
    let shifted = pan + 1.0
    let angle = shifted * pi / 4.0
    let left  = sample * cos(angle)
    let right = sample * sin(angle)
    let result = []
    push(result, left)
    push(result, right)
    result
