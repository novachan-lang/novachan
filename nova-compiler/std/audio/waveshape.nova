// std/audio/waveshape.nova — Waveshaping / distortion functions.
// Provides: hard_clip, soft_clip, fold
// LEAF — imports NOTHING.
//
// hard_clip(x, threshold) -> float
//   Clamps x to [-threshold, threshold].
//
// soft_clip(x) -> float
//   Smooth saturation via x/(1.0+|x|). Bounded in (-1,1). Monotone odd fn.
//
// fold(x, limit) -> float
//   Wavefolding: reflects x at ±limit. Result always in [-limit, limit].
//   Period = 4*limit triangle: [0,L]->rises, [L,3L]->falls, [3L,4L]->rises.
//
// FLOAT RULES obeyed:
//   - abs(float): if x < 0.0 { 0.0-x } else { x }
//   - Bind all sub-expressions to lets before return.
//   - PI via zero-arg fn (unused here, but pattern noted).
//   - Float compare only to float literals.

// _ws_abs: float absolute value
fn _ws_abs(x: float) -> float
    let v = x
    if x < 0.0
        v = 0.0 - x
    v

// hard_clip(x, threshold) -> float
// Clamps x to [-threshold, threshold].
fn hard_clip(x: float, threshold: float) -> float
    let neg_t = 0.0 - threshold
    let v = x
    if x > threshold
        v = threshold
    else if x < neg_t
        v = neg_t
    v

// soft_clip(x) -> float
// x / (1.0 + |x|) — bounded in (-1,1), monotone, smooth.
fn soft_clip(x: float) -> float
    let ax = _ws_abs(x)
    let denom = 1.0 + ax
    let result = x / denom
    result

// _ws_fold_normalize: bring x into [0, period) where period = 4*limit.
// Uses while loops (no fmod builtin).
fn _ws_fold_normalize(x: float, period: float) -> float
    let s = x
    // make non-negative: add enough periods
    if s < 0.0
        let neg_s = 0.0 - s
        // how many periods needed: ceil(neg_s / period)
        let count = 0
        let acc = 0.0
        while acc < neg_s
            acc += period
            count += 1
        s += acc
    // bring below period
    while s >= period
        s -= period
    s

// fold(x, limit) -> float
// Wavefolding: triangle wave with period 4*limit, amplitude = limit.
// Maps any x to [-limit, limit].
fn fold(x: float, limit: float) -> float
    let period = 4.0 * limit
    // normalize to [0, 4*limit)
    let s = _ws_fold_normalize(x, period)
    // triangle fold:
    //   [0, limit]:     rising  0 -> limit
    //   [limit, 3*limit]: falling limit -> -limit
    //   [3*limit, 4*limit]: rising -limit -> 0
    let two_limit = 2.0 * limit
    let three_limit = 3.0 * limit
    let result = 0.0
    if s <= limit
        result = s
    else if s <= three_limit
        result = two_limit - s
    else
        result = s - 4.0 * limit
    result
