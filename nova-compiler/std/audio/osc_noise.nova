// std/audio/osc_noise.nova — White noise oscillator via inline LCG.
// Prefix: osc_noise_
// Provides: noise_seed, noise_next
// LEAF — imports NOTHING.
//
// noise_seed(seed) -> int
//   Initialize LCG state from an integer seed.
//   Returns the initial state (same as the seed value).
//
// noise_next(state) -> list
//   Advance the LCG and return [value, new_state].
//   value is a float in [-1.0, 1.0].
//   new_state is the next integer LCG state (use for subsequent calls).
//
// LCG parameters (Numerical Recipes):
//   multiplier = 1664525
//   increment  = 1013904223
//   modulus    = 2^32 = 4294967296
//   state_next = (state * multiplier + increment) mod modulus
//
// Conversion to [-1, 1]:
//   raw in [0, 4294967296)
//   normalized = raw / 2147483648.0 - 1.0  (maps [0,2^32) -> [-1.0, 2.0))
//   clamped to [-1.0, 1.0] via max(min(v, 1.0), -1.0)
//
// FLOAT RULES:
//   - value output is float in [-1.0, 1.0].
//   - state is int throughout (no float state).

// noise_seed(seed) -> int
// Returns the initial LCG state equal to the seed.
fn noise_seed(seed: int) -> int
    seed

// noise_next(state) -> list
// Advances LCG and returns [float_value, new_state].
// float_value in [-1.0, 1.0], new_state is next int state.
fn noise_next(state: int) -> list
    let mult = 1664525
    let inc = 1013904223
    let modulus = 4294967296
    let raw = (state * mult + inc) % modulus
    let half = 2147483648.0
    let normalized = raw * 1.0 / half - 1.0
    let value = 0.0
    if normalized > 1.0
        value = 1.0
    else if normalized < -1.0
        value = -1.0
    else
        value = normalized
    let result = [value, raw]
    result
