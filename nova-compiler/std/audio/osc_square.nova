// std/audio/osc_square.nova — Square and pulse wave oscillators.
// Prefix: osc_square_
// Provides: osc_square, osc_pulse
// LEAF — imports NOTHING.
//
// osc_square(phase01) -> float
//   50% duty cycle square wave. phase01 in [0.0, 1.0).
//   Returns 1.0 if phase01 < 0.5, else -1.0.
//
// osc_pulse(phase01, duty) -> float
//   Variable duty cycle pulse wave. phase01 in [0.0, 1.0), duty in (0.0, 1.0).
//   Returns 1.0 if phase01 < duty, else -1.0.
//   osc_square is osc_pulse with duty=0.5.
//
// FLOAT RULES:
//   - All inputs/outputs are floats.
//   - Bind sub-expressions to named lets before returning.

// osc_square(phase01) -> float
// 50% duty cycle square wave.
// Returns 1.0 if phase01 < 0.5, else -1.0.
fn osc_square(phase01: float) -> float
    let result = 1.0 if phase01 < 0.5 else -1.0
    result

// osc_pulse(phase01, duty) -> float
// Variable duty cycle pulse wave.
// Returns 1.0 if phase01 < duty, else -1.0.
fn osc_pulse(phase01: float, duty: float) -> float
    let result = 1.0 if phase01 < duty else -1.0
    result
