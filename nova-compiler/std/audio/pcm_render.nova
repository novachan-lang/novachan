// std/audio/pcm_render.nova -- PCM encoding/decoding and sine wave renderer. LEAF.
//
// Public API (prefix pcm_)
//   float_to_pcm16(sample)                    -> int
//     Clamp sample to [-1.0, 1.0] then scale to signed 16-bit integer.
//     -1.0 -> -32768,  0.0 -> 0,  1.0 -> 32767.
//     Values outside [-1.0, 1.0] are clamped before scaling.
//
//   pcm16_to_float(pcm)                       -> float
//     Convert a signed 16-bit integer back to a float in [-1.0, 1.0].
//     -32768 -> -1.0,  0 -> 0.0,  32767 -> ~1.0
//
//   render_sine(freq, duration_sec, sample_rate) -> list
//     Render a pure sine tone as a list of signed 16-bit PCM integers.
//     Number of samples = floor(duration_sec * sample_rate).
//     Phase is accumulated as phase01 in [0.0, 1.0) per cycle.
//
// FLOAT RULES obeyed:
//   - No scientific-notation literals; use pow(10.0, N) or plain decimals.
//   - Bind all composite sub-expressions to named lets before returning.
//   - Float vs int compare is UNSOUND; always compare floats to float literals.
//   - PI constant via zero-arg fn (no module-level let consts).
//   - abs(float) returns int in NOVA; use if/else for float abs.

// _pcm_pi -- mathematical constant pi
fn _pcm_pi() -> float
    let v = 3.14159265358979
    v

// float_to_pcm16 -- Clamp and quantize a float sample to signed 16-bit PCM.
// Clamping: values < -1.0 become -1.0; values > 1.0 become 1.0.
// Scaling: -1.0 -> -32768; +1.0 -> 32767 (asymmetric: standard PCM convention).
fn float_to_pcm16(sample: float) -> int
    // Clamp to [-1.0, 1.0]
    let s = sample
    if s < 0.0 - 1.0
        s = 0.0 - 1.0
    if s > 1.0
        s = 1.0
    // Scale and round toward zero (truncate)
    let scaled = s * 32767.0
    // Convert to int (truncates toward zero in NOVA)
    // For negative values we want floor behavior to hit -32768 at -1.0:
    // -1.0 * 32767 = -32767, not -32768; apply full range by using 32768 for negative side
    // Standard convention: positive uses 32767, negative uses 32768
    let result = 0
    if s < 0.0
        let neg_scaled = s * 32768.0
        // truncate toward zero means we need floor for negative: subtract 0.5 before cast
        // But NOVA int() truncates; for negative, floor(x) = int(x) if integer, else int(x)-1
        // Simplest correct approach: use round via +0.5/-0.5
        let shifted = neg_scaled - 0.5
        result = int(shifted)
    if s >= 0.0
        let pos_scaled = s * 32767.0
        let shifted = pos_scaled + 0.5
        result = int(shifted)
    // Final clamp to int16 range
    if result < 0 - 32768
        result = 0 - 32768
    if result > 32767
        result = 32767
    result

// pcm16_to_float -- Convert a signed 16-bit PCM integer to a float in [-1.0, 1.0].
// Uses a divisor of 32768.0 (the full negative range) for symmetric decode.
// pcm16_to_float(-32768) = -1.0, pcm16_to_float(0) = 0.0, pcm16_to_float(32767) ~= 0.9999695...
fn pcm16_to_float(pcm: int) -> float
    let fv = pcm * 1.0
    let result = fv / 32768.0
    result

// render_sine -- Render a pure sine tone as a list of signed 16-bit PCM integers.
// freq:         frequency in Hz
// duration_sec: length in seconds (will be multiplied by sample_rate and truncated)
// sample_rate:  samples per second (e.g. 44100)
// Returns a list of int values in [-32768, 32767].
// Phase is accumulated as phase01 in [0.0, 1.0), wrapping at 1.0.
// Output sample count = int(duration_sec * sample_rate).
fn render_sine(freq: float, duration_sec: float, sample_rate: float) -> list
    let result = []
    let total_f = duration_sec * sample_rate
    let total = int(total_f)
    let pi = _pcm_pi()
    let two_pi = 2.0 * pi
    // phase increment per sample
    let phase_inc = freq / sample_rate
    let phase01 = 0.0
    let i = 0
    while i < total
        // sine value from phase01 in [0.0, 1.0)
        let angle = phase01 * two_pi
        let sv = sin(angle)
        let pcm = float_to_pcm16(sv)
        push(result, pcm)
        // advance phase, wrap at 1.0
        phase01 = phase01 + phase_inc
        if phase01 >= 1.0
            phase01 = phase01 - 1.0
        i = i + 1
    result
