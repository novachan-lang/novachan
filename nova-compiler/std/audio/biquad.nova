// std/audio/biquad.nova — Biquad filter (RBJ cookbook) coefficients + apply.
// Prefix: biquad_
// Provides: biquad_lowpass, biquad_apply
// LEAF — imports NOTHING.
//
// biquad_lowpass(freq, q, sample_rate) -> list [b0, b1, b2, a1, a2]
//   Computes normalized RBJ lowpass coefficients (divided by a0).
//   freq: cutoff frequency in Hz
//   q: quality factor (bandwidth control)
//   sample_rate: samples per second
//
// biquad_apply(coeffs, x, state) -> list [y, new_state]
//   Applies biquad filter using Direct Form 1.
//   coeffs: [b0, b1, b2, a1, a2] from biquad_lowpass
//   x: current input sample
//   state: [x1, x2, y1, y2] — previous two inputs and outputs
//   Returns: [y, new_state] where new_state = [x, x1, y, y1]
//
// FLOAT RULES:
//   - All inputs/outputs are floats.
//   - Bind sub-expressions to named lets before returning.
//   - PI via zero-arg fn (no module-level const).
//   - List element reads are 'any'; multiply by 1.0 to force float.

fn _bq_pi() -> float
    let v = 3.14159265358979
    v

// biquad_lowpass(freq, q, sample_rate) -> list [b0, b1, b2, a1, a2]
// RBJ cookbook lowpass normalized by a0.
fn biquad_lowpass(freq: float, q: float, sample_rate: float) -> list
    let pi = _bq_pi()
    let w0 = 2.0 * pi * freq / sample_rate
    let cosw0 = cos(w0)
    let sinw0 = sin(w0)
    let alpha = sinw0 / (2.0 * q)
    // un-normalized coefficients
    let raw_b0 = (1.0 - cosw0) / 2.0
    let raw_b1 = 1.0 - cosw0
    let raw_b2 = (1.0 - cosw0) / 2.0
    let raw_a0 = 1.0 + alpha
    let raw_a1 = 0.0 - 2.0 * cosw0
    let raw_a2 = 1.0 - alpha
    // normalize by a0
    let b0 = raw_b0 / raw_a0
    let b1 = raw_b1 / raw_a0
    let b2 = raw_b2 / raw_a0
    let a1 = raw_a1 / raw_a0
    let a2 = raw_a2 / raw_a0
    let result = []
    push(result, b0)
    push(result, b1)
    push(result, b2)
    push(result, a1)
    push(result, a2)
    result

// biquad_apply(coeffs, x, state) -> list [y, new_state]
// Direct Form 1: y = b0*x + b1*x1 + b2*x2 - a1*y1 - a2*y2
// state = [x1, x2, y1, y2]
// Returns [y, [x, x1, y, y1]]
fn biquad_apply(coeffs: list, x: float, state: list) -> list
    let b0 = coeffs[0] * 1.0
    let b1 = coeffs[1] * 1.0
    let b2 = coeffs[2] * 1.0
    let a1 = coeffs[3] * 1.0
    let a2 = coeffs[4] * 1.0
    let x1 = state[0] * 1.0
    let x2 = state[1] * 1.0
    let y1 = state[2] * 1.0
    let y2 = state[3] * 1.0
    // DF1: y = b0*x + b1*x1 + b2*x2 - a1*y1 - a2*y2
    let t0 = b0 * x
    let t1 = b1 * x1
    let t2 = b2 * x2
    let t3 = a1 * y1
    let t4 = a2 * y2
    let y = t0 + t1 + t2 - t3 - t4
    // new state: shift input/output history
    let new_state = []
    push(new_state, x)
    push(new_state, x1)
    push(new_state, y)
    push(new_state, y1)
    let out = []
    push(out, y)
    push(out, new_state)
    out
