// std/interval/interval_partition.nova
// Interval partition: decompose intervals into atomic disjoint pieces
// using coordinate compression on all endpoints.
//
// Representation: interval = [lo, hi]; interval-set = list of [lo, hi].
// All closed intervals.  Endpoints may be int or float.
// Touching intervals [a,b] and [b,c] share the point b.
//
// Public API (prefix ip_):
//   ip_endpoints(intervals)        -> sorted unique endpoint list
//   ip_atoms(intervals)            -> elementary disjoint sub-intervals
//   ip_coverage_count(intervals)   -> [[atom, count], ...] per atom
//   ip_max_coverage(intervals)     -> int  max overlap at any atom
//   ip_partition_points(intervals) -> same as ip_endpoints
//   ip_stab_intervals(intervals,x) -> which intervals contain x
//   ip_refine(intervals)           -> same as ip_atoms
//   ip_layers(intervals)           -> min tracks (= max_coverage)

// _ip_dup_check: true if v already appears in sorted list xs (linear scan)
fn _ip_dup_check(xs: list, v) -> bool
    let n = len(xs)
    for i in 0..n
        if xs[i] == v
            return true
    return false

// _ip_sort_asc: insertion-sort a flat list of numbers ascending (in-place)
fn _ip_sort_asc(arr: list)
    let n = len(arr)
    for j in 1..n
        let key = arr[j]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            if arr[k] > key
                arr[k + 1] = arr[k]
                pos = k
                k = k - 1
            else
                done = true
        arr[pos] = key

// ip_endpoints: sorted unique list of all endpoints from all intervals.
fn ip_endpoints(intervals: list) -> list
    let result = []
    let n = len(intervals)
    for i in 0..n
        let iv = intervals[i]
        let lo = iv[0]
        let hi = iv[1]
        if not _ip_dup_check(result, lo)
            push(result, lo)
        if not _ip_dup_check(result, hi)
            push(result, hi)
    _ip_sort_asc(result)
    return result

// ip_atoms: elementary/atomic disjoint sub-intervals formed by all endpoints.
// Given sorted unique endpoints [e0,e1,...,ek], atoms are [e0,e1],[e1,e2],...,[ek-1,ek].
fn ip_atoms(intervals: list) -> list
    let eps = ip_endpoints(intervals)
    let result = []
    let m = len(eps)
    for i in 0..(m - 1)
        let atom = []
        push(atom, eps[i])
        push(atom, eps[i + 1])
        push(result, atom)
    return result

// _ip_covers: true if closed interval iv covers point x (lo <= x <= hi)
fn _ip_covers(iv: list, x) -> bool
    let lo = iv[0]
    let hi = iv[1]
    if x < lo
        return false
    if x > hi
        return false
    return true

// _ip_atom_covered: true if atom [alo,ahi] is entirely inside iv [lo,hi]
// An atom is covered when lo <= alo and ahi <= hi
fn _ip_atom_covered(iv: list, atom: list) -> bool
    let lo = iv[0]
    let hi = iv[1]
    let alo = atom[0]
    let ahi = atom[1]
    if lo > alo
        return false
    if hi < ahi
        return false
    return true

// ip_coverage_count: for each atom, count how many input intervals cover it.
// Returns list of [[alo,ahi], count].
fn ip_coverage_count(intervals: list) -> list
    let atoms = ip_atoms(intervals)
    let na = len(atoms)
    let ni = len(intervals)
    let result = []
    for a in 0..na
        let atom = atoms[a]
        let cnt = 0
        let i = 0
        while i < ni
            if _ip_atom_covered(intervals[i], atom)
                cnt = cnt + 1
            i = i + 1
        let entry = []
        push(entry, atom)
        push(entry, cnt)
        push(result, entry)
    return result

// ip_max_coverage: maximum number of input intervals overlapping at any single atom.
fn ip_max_coverage(intervals: list) -> int
    let cc = ip_coverage_count(intervals)
    let n = len(cc)
    if n == 0
        return 0
    let best = 0
    for i in 0..n
        let entry = cc[i]
        let cnt = entry[1]
        if cnt > best
            best = cnt
    return best

// ip_partition_points: sorted unique endpoints (alias for ip_endpoints).
fn ip_partition_points(intervals: list) -> list
    return ip_endpoints(intervals)

// ip_stab_intervals: which intervals in the set contain point x (lo<=x<=hi).
fn ip_stab_intervals(intervals: list, x) -> list
    let n = len(intervals)
    let result = [intervals[i] for i in 0..n if _ip_covers(intervals[i], x)]
    return result

// ip_refine: partition all input intervals into atomic disjoint pieces (= ip_atoms).
fn ip_refine(intervals: list) -> list
    return ip_atoms(intervals)

// ip_layers: minimum number of non-overlapping tracks to schedule all intervals
// without any two overlapping on the same track.  Equals ip_max_coverage.
fn ip_layers(intervals: list) -> int
    return ip_max_coverage(intervals)
