// std/interval/interval_set.nova — set algebra on disjoint interval sets.
// Representation: a list of [lo, hi] 2-element lists.
// A canonical (normalized) set is sorted, disjoint, non-touching.
// Touching intervals [1,2] and [2,3] DO merge (closed intervals share endpoint 2).
// PREFIX: is_  LEAF — imports nothing.
//
// Implementation note: sorting uses parallel scalar arrays (lo_arr, hi_arr) to
// avoid list-reference aliasing under NOVA's ownership model.

// --- internal helpers ---

// _is_to_parallel: decompose [[lo,hi],...] into two scalar arrays.
fn _is_to_parallel(intervals)
    let n = len(intervals)
    let los = []
    let his = []
    for i in 0..n
        let iv = intervals[i]
        push(los, iv[0])
        push(his, iv[1])
    let r = {}
    r["los"] = los
    r["his"] = his
    return r

// _is_sort_parallel: insertion-sort parallel (los, his) by lo endpoint (done-flag).
fn _is_sort_parallel(los, his)
    let n = len(los)
    for i in 1..n
        let key_lo = los[i]
        let key_hi = his[i]
        let pos = i
        let k = i - 1
        let done = false
        while k >= 0 and done == false
            if los[k] > key_lo
                los[k + 1] = los[k]
                his[k + 1] = his[k]
                pos = k
                k -= 1
            else
                done = true
        los[pos] = key_lo
        his[pos] = key_hi

// _is_merge_parallel: merge sorted parallel arrays; returns count of merged intervals.
// Result written to los/his starting at index 0.
fn _is_merge_parallel(los, his)
    let n = len(los)
    if n == 0
        return 0
    let out_los = []
    let out_his = []
    let cur_lo = los[0]
    let cur_hi = his[0]
    for i in 1..n
        let iv_lo = los[i]
        let iv_hi = his[i]
        if iv_lo <= cur_hi
            if iv_hi > cur_hi
                cur_hi = iv_hi
        else
            push(out_los, cur_lo)
            push(out_his, cur_hi)
            cur_lo = iv_lo
            cur_hi = iv_hi
    push(out_los, cur_lo)
    push(out_his, cur_hi)
    let m = len(out_los)
    for j in 0..m
        los[j] = out_los[j]
        his[j] = out_his[j]
    return m

// _is_normalize_impl: sort + merge; returns canonical [[lo,hi],...].
fn _is_normalize_impl(intervals)
    let n = len(intervals)
    if n == 0
        return []
    let p = _is_to_parallel(intervals)
    let los = p["los"]
    let his = p["his"]
    _is_sort_parallel(los, his)
    let m = _is_merge_parallel(los, his)
    let out = []
    for i in 0..m
        let iv = [los[i], his[i]]
        push(out, iv)
    return out

// --- public API ---

// is_normalize: return canonical sorted disjoint form of interval set.
fn is_normalize(intervals) -> any
    return _is_normalize_impl(intervals)

// is_union: union of two interval sets (normalized).
fn is_union(a, b) -> any
    let los = []
    let his = []
    let na = len(a)
    for i in 0..na
        let iv = a[i]
        push(los, iv[0])
        push(his, iv[1])
    let nb = len(b)
    for j in 0..nb
        let iv = b[j]
        push(los, iv[0])
        push(his, iv[1])
    if len(los) == 0
        return []
    _is_sort_parallel(los, his)
    let m = _is_merge_parallel(los, his)
    let out = []
    for k in 0..m
        let iv = [los[k], his[k]]
        push(out, iv)
    return out

// is_intersect: intersection of two normalized interval sets.
fn is_intersect(a, b) -> any
    let na = _is_normalize_impl(a)
    let nb = _is_normalize_impl(b)
    let la = len(na)
    let lb = len(nb)
    let out = []
    let ia = 0
    let ib = 0
    while ia < la and ib < lb
        let iva = na[ia]
        let ivb = nb[ib]
        let alo = iva[0]
        let ahi = iva[1]
        let blo = ivb[0]
        let bhi = ivb[1]
        let lo = alo
        if blo > lo
            lo = blo
        let hi = ahi
        if bhi < hi
            hi = bhi
        if lo <= hi
            let seg = [lo, hi]
            push(out, seg)
        if ahi < bhi
            ia += 1
        else
            if bhi < ahi
                ib += 1
            else
                ia += 1
                ib += 1
    return out

// is_difference: a minus b; clips a intervals around each b interval.
fn is_difference(a, b) -> any
    let na = _is_normalize_impl(a)
    let nb = _is_normalize_impl(b)
    let lb = len(nb)
    let current = na
    for ib in 0..lb
        let ivb = nb[ib]
        let blo = ivb[0]
        let bhi = ivb[1]
        let next_los = []
        let next_his = []
        let ic = 0
        let lc = len(current)
        while ic < lc
            let iv = current[ic]
            let alo = iv[0]
            let ahi = iv[1]
            if ahi < blo or alo > bhi
                push(next_los, alo)
                push(next_his, ahi)
            else
                if alo < blo
                    push(next_los, alo)
                    push(next_his, blo)
                if ahi > bhi
                    push(next_los, bhi)
                    push(next_his, ahi)
            ic += 1
        // rebuild current from parallel arrays
        let nc = len(next_los)
        let rebuilt = []
        let r = 0
        while r < nc
            let iv = [next_los[r], next_his[r]]
            push(rebuilt, iv)
            r += 1
        current = rebuilt
    return current

// is_complement: complement of interval set within universe [lo, hi].
fn is_complement(intervals, lo, hi) -> any
    let norm = _is_normalize_impl(intervals)
    let n = len(norm)
    let out_los = []
    let out_his = []
    let cur = lo
    let i = 0
    while i < n
        let iv = norm[i]
        let iv_lo = iv[0]
        let iv_hi = iv[1]
        if iv_hi < cur
            i += 1
        else
            if iv_lo > cur
                let g_hi = iv_lo
                if g_hi > hi
                    g_hi = hi
                if cur < g_hi
                    push(out_los, cur)
                    push(out_his, g_hi)
            if iv_hi > cur
                cur = iv_hi
            i += 1
    if cur < hi
        push(out_los, cur)
        push(out_his, hi)
    let out = []
    let j = 0
    let m = len(out_los)
    while j < m
        let iv = [out_los[j], out_his[j]]
        push(out, iv)
        j += 1
    return out

// is_contains_point: true if x lies in any interval of the set.
fn is_contains_point(set, x) -> bool
    let norm = _is_normalize_impl(set)
    let n = len(norm)
    for i in 0..n
        let iv = norm[i]
        let iv_lo = iv[0]
        let iv_hi = iv[1]
        if iv_lo > x
            return false
        if x <= iv_hi
            return true
    return false

// is_measure: total length (float) of all intervals after normalization.
fn is_measure(set) -> float
    let norm = _is_normalize_impl(set)
    let n = len(norm)
    let total = 0.0
    for i in 0..n
        let iv = norm[i]
        let w = (iv[1] - iv[0]) * 1.0
        total += w
    return total

// is_is_empty: true if the set has no intervals.
fn is_is_empty(set) -> bool
    let norm = _is_normalize_impl(set)
    return len(norm) == 0

// is_symmetric_difference: (a union b) minus (a intersect b).
fn is_symmetric_difference(a, b) -> any
    let u = is_union(a, b)
    let inter = is_intersect(a, b)
    return is_difference(u, inter)

// is_equal: true if a and b represent the same set of points after normalization.
fn is_equal(a, b) -> bool
    let na = _is_normalize_impl(a)
    let nb = _is_normalize_impl(b)
    let la = len(na)
    let lb = len(nb)
    if la != lb
        return false
    for i in 0..la
        let iva = na[i]
        let ivb = nb[i]
        if iva[0] != ivb[0]
            return false
        if iva[1] != ivb[1]
            return false
    return true
