// interval_tree2 — interval tree for overlap queries (sorted-list implementation).
//
// Representation: a dict with:
//   t["ivs"] -> list of [lo,hi] intervals, kept sorted by lo then hi after build.
//   t["n"]   -> int count of intervals.
//
// Closed intervals: x IN [lo,hi] iff lo <= x <= hi.
// Two intervals overlap iff their intersection is non-empty: [a,b] overlaps [c,d] iff a<=d AND c<=b.
//
// Public API (prefix it_)
//   it_build(intervals)          -> tree dict (sorted by lo)
//   it_query_point(tree, x)      -> all intervals containing x, sorted by lo
//   it_query_overlap(tree, lo, hi) -> all intervals overlapping [lo,hi], sorted by lo
//   it_insert(tree, iv)          -> tree with iv inserted (maintains sorted order)
//   it_count(tree)               -> int number of intervals
//   it_all(tree)                 -> all intervals as list of [lo,hi]
//   it_query_count(tree, lo, hi) -> int count of overlapping intervals
//   it_contains_point(tree, x)   -> bool (1 if any interval covers x)
//   it_max_endpoint(tree)        -> float max hi endpoint (0.0 if empty)

// ---- private helpers --------------------------------------------------------

// _it2_sort: insertion-sort a list of [lo,hi] pairs by lo asc, then hi asc.
// Builds a sorted NEW list to avoid RC self-assign UAF from in-place shifting.
// Returns the sorted list.
fn _it2_sort(src, n)
    // Build parallel lo/hi arrays to avoid list-reference RC pitfalls.
    let los = []
    let his = []
    for i in 0..n
        let ii = i
        let iv = src[ii]
        push(los, iv[0])
        push(his, iv[1])
    // Insertion-sort the parallel arrays by (lo, hi).
    for j in 1..n
        let klo = los[j]
        let khi = his[j]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let clo = los[k]
            let chi = his[k]
            let shift = 0
            if clo > klo
                shift = 1
            else
                if clo == klo and chi > khi
                    shift = 1
            if shift == 1
                los[k + 1] = los[k]
                his[k + 1] = his[k]
                pos = k
                k = k - 1
            else
                done = true
        if pos != j
            los[pos] = klo
            his[pos] = khi
    // Reconstruct as a list of [lo,hi] pairs.
    let out = []
    for m in 0..n
        let mm = m
        let pair = [los[mm], his[mm]]
        push(out, pair)
    return out

// ---- public API -------------------------------------------------------------

// it_build: build a tree from a list of [lo,hi] intervals, sorted by lo.
fn it_build(intervals)
    let n = len(intervals)
    let t = {}
    let sorted = _it2_sort(intervals, n)
    t["ivs"] = sorted
    t["n"] = n
    return t

// it_query_point: all intervals [lo,hi] containing x, in sorted order by lo.
fn it_query_point(tree, x)
    let ivs = tree["ivs"]
    let n = tree["n"]
    let out = []
    for i in 0..n
        let ii = i
        let iv = ivs[ii]
        if iv[0] <= x
            if x <= iv[1]
                push(out, iv)
    return out

// it_query_overlap: all intervals overlapping [lo,hi] (closed), sorted by lo.
// [a,b] overlaps [lo,hi] iff a<=hi AND lo<=b.
fn it_query_overlap(tree, lo, hi)
    let ivs = tree["ivs"]
    let n = tree["n"]
    let out = []
    for i in 0..n
        let ii = i
        let iv = ivs[ii]
        if iv[0] <= hi
            if lo <= iv[1]
                push(out, iv)
    return out

// it_insert: insert interval iv=[lo,hi] into the tree maintaining sorted order.
// Rebuilds sorted ivs list via _it2_sort to avoid RC in-place shift pitfalls.
// Returns the modified tree.
fn it_insert(tree, iv)
    let ivs = tree["ivs"]
    let n = tree["n"]
    // append the new interval, then re-sort
    push(ivs, iv)
    let n2 = n + 1
    let sorted = _it2_sort(ivs, n2)
    tree["ivs"] = sorted
    tree["n"] = n2
    return tree

// it_count: number of intervals in the tree.
fn it_count(tree)
    return tree["n"]

// it_all: all intervals as a list of [lo,hi], in sorted order.
fn it_all(tree)
    let ivs = tree["ivs"]
    let n = tree["n"]
    let out = []
    for i in 0..n
        let ii = i
        push(out, ivs[ii])
    return out

// it_query_count: count of intervals overlapping [lo,hi].
fn it_query_count(tree, lo, hi)
    let ivs = tree["ivs"]
    let n = tree["n"]
    let cnt = 0
    for i in 0..n
        let ii = i
        let iv = ivs[ii]
        if iv[0] <= hi
            if lo <= iv[1]
                cnt = cnt + 1
    return cnt

// it_contains_point: 1 if any interval covers x, 0 otherwise.
fn it_contains_point(tree, x)
    let ivs = tree["ivs"]
    let n = tree["n"]
    let i = 0
    let found = 0
    let done = false
    while i < n and done == false
        let ii = i
        let iv = ivs[ii]
        if iv[0] <= x
            if x <= iv[1]
                found = 1
                done = true
        i = i + 1
    return found

// it_max_endpoint: the maximum hi endpoint across all intervals, or 0.0 if empty.
fn it_max_endpoint(tree)
    let ivs = tree["ivs"]
    let n = tree["n"]
    if n == 0
        return 0.0
    let iv0 = ivs[0]
    let mx = iv0[1] * 1.0
    for i in 1..n
        let ii = i
        let iv = ivs[ii]
        let v = iv[1] * 1.0
        if v > mx
            mx = v
    return mx
