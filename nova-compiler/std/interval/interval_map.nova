// interval_map — associate arbitrary values with ranges [lo,hi].
//
// Representation: a list of 3-element lists [lo, hi, value].
// Multiple entries may overlap; imap_get returns ALL values whose interval covers x.
// Endpoints may be int or float. Closed: lo <= x <= hi.
//
// Public API (prefix imap_)
//   imap_new()                   -> empty map (list)
//   imap_put(map, lo, hi, value) -> new map with entry appended
//   imap_get(map, x)             -> list of values whose interval covers x
//   imap_get_first(map, x)       -> first covering value, or null
//   imap_covering(map, x)        -> list of [lo,hi,value] entries covering x
//   imap_remove_range(map, lo, hi) -> new map with entries whose [elo,ehi] is fully inside [lo,hi] removed
//   imap_size(map)               -> int number of entries
//   imap_keys(map)               -> list of [lo,hi] intervals
//   imap_values_in(map, lo, hi)  -> values whose interval overlaps [lo,hi]
//   imap_contains(map, x)        -> bool (1 if any entry covers x)

// ---- private helpers --------------------------------------------------------

// _imap_covers: 1 if entry [lo,hi,val] covers point x
fn _imap_covers(entry, x)
    if entry[0] <= x
        if x <= entry[1]
            return 1
    return 0

// _imap_overlaps: 1 if entry [elo,ehi,val] overlaps query [lo,hi]
// Closed overlap: elo <= hi AND lo <= ehi
fn _imap_overlaps(entry, lo, hi)
    if entry[0] <= hi
        if lo <= entry[1]
            return 1
    return 0

// ---- public API -------------------------------------------------------------

// imap_new: create an empty interval map.
fn imap_new()
    return []

// imap_put: add a [lo,hi]->value entry; returns the updated map.
fn imap_put(map, lo, hi, value)
    let entry = [lo, hi, value]
    push(map, entry)
    return map

// imap_get: list of all VALUES whose interval covers point x.
fn imap_get(map, x)
    let n = len(map)
    let out = []
    let i = 0
    while i < n
        let ii = i
        let e = map[ii]
        if _imap_covers(e, x) == 1
            push(out, e[2])
        i = i + 1
    return out

// imap_get_first: the first value whose interval covers x, or null if none.
fn imap_get_first(map, x)
    let n = len(map)
    let i = 0
    let result = null
    let done = false
    while i < n and done == false
        let ii = i
        let e = map[ii]
        if _imap_covers(e, x) == 1
            result = e[2]
            done = true
        i = i + 1
    return result

// imap_covering: list of [lo,hi,value] entries whose interval covers x.
fn imap_covering(map, x)
    let n = len(map)
    let out = []
    let i = 0
    while i < n
        let ii = i
        let e = map[ii]
        if _imap_covers(e, x) == 1
            push(out, e)
        i = i + 1
    return out

// imap_remove_range: return new map without entries whose interval is fully contained in [lo,hi].
// An entry [elo,ehi] is removed when lo <= elo AND ehi <= hi.
fn imap_remove_range(map, lo, hi)
    let n = len(map)
    let out = []
    let i = 0
    while i < n
        let ii = i
        let e = map[ii]
        let elo = e[0]
        let ehi = e[1]
        let contained = 0
        if lo <= elo
            if ehi <= hi
                contained = 1
        if contained == 0
            push(out, e)
        i = i + 1
    return out

// imap_size: number of entries in the map.
fn imap_size(map)
    return len(map)

// imap_keys: list of [lo,hi] intervals from each entry.
fn imap_keys(map)
    let n = len(map)
    let out = []
    let i = 0
    while i < n
        let ii = i
        let e = map[ii]
        let pair = [e[0], e[1]]
        push(out, pair)
        i = i + 1
    return out

// imap_values_in: values whose interval overlaps [lo,hi] (closed overlap).
fn imap_values_in(map, lo, hi)
    let n = len(map)
    let out = []
    let i = 0
    while i < n
        let ii = i
        let e = map[ii]
        if _imap_overlaps(e, lo, hi) == 1
            push(out, e[2])
        i = i + 1
    return out

// imap_contains: 1 if any entry covers point x, 0 otherwise.
fn imap_contains(map, x)
    let n = len(map)
    let i = 0
    let found = 0
    let done = false
    while i < n and done == false
        let ii = i
        if _imap_covers(map[ii], x) == 1
            found = 1
            done = true
        i = i + 1
    return found
