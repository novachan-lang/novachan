// std/interval/interval_cover.nova
// Covering problems on closed intervals.  Greedy algorithms.
//
// Representation: interval = [lo, hi]; interval-set = list of [lo, hi].
// target = [lo, hi] denoting the interval to cover.
//
// Closed interval semantics: [a,b] and [b,c] share the point b and together
// cover [a,c] without a gap.
//
// Public API (prefix ic_):
//   ic_min_points_to_stab(intervals)        -> list of points (minimum stabbing set)
//   ic_min_intervals_to_cover(target, ivs)  -> list of intervals (minimum cover)
//   ic_is_covered(target, intervals)        -> bool
//   ic_stab_count(intervals)               -> int (size of min stabbing set)
//   ic_greedy_cover(target, intervals)      -> list (alias for ic_min_intervals_to_cover)
//   ic_point_cover_size(intervals)          -> int (alias for ic_stab_count)

// _ic_sort_by_hi_asc: insertion-sort interval list by hi endpoint asc, tie-break lo asc.
fn _ic_sort_by_hi_asc(arr: list)
    let n = len(arr)
    for j in 1..n
        let key = arr[j]
        let khi = key[1]
        let klo = key[0]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let other = arr[k]
            let ohi = other[1]
            let olo = other[0]
            let shift = false
            if ohi > khi
                shift = true
            if ohi == khi and olo > klo
                shift = true
            if shift
                arr[k + 1] = arr[k]
                pos = k
                k -= 1
            else
                done = true
        arr[pos] = key

// _ic_copy_intervals: shallow copy of a list of intervals
fn _ic_copy_intervals(ivs: list) -> list
    let result = []
    let n = len(ivs)
    for i in 0..n
        push(result, ivs[i])
    return result

// _ic_sort_by_lo_asc: insertion-sort interval list by lo endpoint asc, tie-break hi desc.
fn _ic_sort_by_lo_asc(arr: list)
    let n = len(arr)
    for j in 1..n
        let key = arr[j]
        let klo = key[0]
        let khi = key[1]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let other = arr[k]
            let olo = other[0]
            let ohi = other[1]
            let shift = false
            if olo > klo
                shift = true
            if olo == klo and ohi < khi
                shift = true
            if shift
                arr[k + 1] = arr[k]
                pos = k
                k -= 1
            else
                done = true
        arr[pos] = key

// _ic_stabs: true if interval iv contains point x (closed: lo<=x<=hi)
fn _ic_stabs(iv: list, x) -> bool
    if x < iv[0]
        return false
    if x > iv[1]
        return false
    return true

// ic_min_points_to_stab: minimum set of points such that every interval contains
// at least one point.  Greedy: repeatedly pick the earliest end-point.
fn ic_min_points_to_stab(intervals: list) -> list
    let n = len(intervals)
    if n == 0
        return []
    let sorted = _ic_copy_intervals(intervals)
    _ic_sort_by_hi_asc(sorted)
    let result = []
    let covered = []
    let i = 0
    while i < n
        push(covered, false)
        i += 1
    i = 0
    while i < n
        if covered[i] == false
            let pt = sorted[i][1]
            push(result, pt)
            let j = 0
            while j < n
                if covered[j] == false
                    if _ic_stabs(sorted[j], pt)
                        covered[j] = true
                j += 1
        i += 1
    return result

// ic_stab_count: size of minimum stabbing set.
fn ic_stab_count(intervals: list) -> int
    let pts = ic_min_points_to_stab(intervals)
    return len(pts)

// ic_point_cover_size: alias for ic_stab_count.
fn ic_point_cover_size(intervals: list) -> int
    return ic_stab_count(intervals)

// ic_is_covered: true if the union of intervals covers every point in target [lo,hi].
// Greedy sweep: sort by lo, check for gaps.
fn ic_is_covered(target: list, intervals: list) -> bool
    let tlo = target[0]
    let thi = target[1]
    let n = len(intervals)
    if n == 0
        return false
    let sorted = _ic_copy_intervals(intervals)
    _ic_sort_by_lo_asc(sorted)
    let reach = tlo
    for i in 0..n
        let iv = sorted[i]
        let ilo = iv[0]
        let ihi = iv[1]
        if ilo > reach
            return false
        if ihi > reach
            reach = ihi
    if reach >= thi
        return true
    return false

// ic_min_intervals_to_cover: fewest intervals whose union covers target [lo,hi].
// Greedy furthest-reach: at each step pick the interval that starts at or before
// the current reach and extends the furthest.
// Returns [] if coverage is impossible.
fn ic_min_intervals_to_cover(target: list, intervals: list) -> list
    let tlo = target[0]
    let thi = target[1]
    let n = len(intervals)
    if n == 0
        return []
    let sorted = _ic_copy_intervals(intervals)
    _ic_sort_by_lo_asc(sorted)
    // used[j] tracks whether sorted[j] has already been selected
    let used = [false for zi in 0..n]
    let result = []
    let reach = tlo
    while reach < thi
        let best_hi = reach
        let best_idx = 0 - 1
        for j in 0..n
            if used[j] == false
                let iv = sorted[j]
                let ilo = iv[0]
                let ihi = iv[1]
                if ilo <= reach and ihi > best_hi
                    best_hi = ihi
                    best_idx = j
        if best_idx < 0
            return []
        used[best_idx] = true
        push(result, sorted[best_idx])
        reach = best_hi
    return result

// ic_greedy_cover: alias for ic_min_intervals_to_cover.
fn ic_greedy_cover(target: list, intervals: list) -> list
    return ic_min_intervals_to_cover(target, intervals)
