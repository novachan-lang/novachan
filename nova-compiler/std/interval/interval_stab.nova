// interval_stab — stabbing / point queries on a list of closed intervals [lo,hi].
//
// Representation: intervals is a list of 2-element lists, e.g. [[1,3],[5,7]].
// Endpoints may be int or float. Closed: point x IN [lo,hi] means lo <= x <= hi.
//
// Public API (prefix ist_)
//   ist_stab(intervals, x)              -> list of intervals containing x
//   ist_stab_count(intervals, x)        -> int count
//   ist_max_overlap_point(intervals)    -> [point, count] or [0,0] if empty
//   ist_max_overlap_count(intervals)    -> int max overlap depth
//   ist_count_at_each_endpoint(intervals) -> list of [point, count] at each endpoint
//   ist_first_stabbed(intervals, x)     -> first interval containing x or null
//   ist_any_stab(intervals, x)          -> bool (true if any interval contains x)
//   ist_deepest(intervals)              -> int max overlap depth (same as max_overlap_count)
//   ist_sweep(intervals)                -> sorted sweep-line events [[point, type, idx], ...]

// ---- private helpers --------------------------------------------------------

// _ist_contains: 1 if point x is in closed interval iv=[lo,hi]
fn _ist_contains(iv, x)
    if iv[0] <= x
        if x <= iv[1]
            return 1
    return 0

// _ist_collect_endpoints: gather all unique lo/hi endpoints, sorted ascending.
// Uses insertion sort; sentinel done-flag to avoid negative index sentinel.
fn _ist_collect_endpoints(intervals)
    let n = len(intervals)
    let pts = []
    for i in 0..n
        let ii = i
        let iv = intervals[ii]
        push(pts, iv[0])
        push(pts, iv[1])
    // sort pts by insertion sort
    let np = len(pts)
    for j in 1..np
        let key = pts[j]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            if pts[k] > key
                pts[k + 1] = pts[k]
                pos = k
                k = k - 1
            else
                done = true
        pts[pos] = key
    // deduplicate
    let out = []
    let prev_val = 0
    let has_prev = 0
    for m in 0..np
        let mm = m
        let v = pts[mm]
        if has_prev == 0
            push(out, v)
            prev_val = v
            has_prev = 1
        else
            if v != prev_val
                push(out, v)
                prev_val = v
    return out

// _ist_count_at(intervals, x): count intervals containing x
fn _ist_count_at(intervals, x)
    let n = len(intervals)
    let cnt = 0
    for i in 0..n
        let ii = i
        cnt = cnt + _ist_contains(intervals[ii], x)
    return cnt

// ---- public API -------------------------------------------------------------

// ist_stab: all intervals containing point x (closed: lo<=x<=hi).
fn ist_stab(intervals, x)
    let n = len(intervals)
    let out = []
    for i in 0..n
        let ii = i
        let iv = intervals[ii]
        if _ist_contains(iv, x) == 1
            push(out, iv)
    return out

// ist_stab_count: number of intervals containing point x.
fn ist_stab_count(intervals, x)
    return _ist_count_at(intervals, x)

// ist_max_overlap_point: [point, count] where max intervals overlap, or [0,0] if empty.
// Sweeps all unique endpoints; evaluates count at each.
fn ist_max_overlap_point(intervals)
    let n = len(intervals)
    if n == 0
        return [0, 0]
    let pts = _ist_collect_endpoints(intervals)
    let np = len(pts)
    let best_pt = pts[0]
    let best_cnt = 0
    for i in 0..np
        let ii = i
        let p = pts[ii]
        let c = _ist_count_at(intervals, p)
        if c > best_cnt
            best_cnt = c
            best_pt = p
    return [best_pt, best_cnt]

// ist_max_overlap_count: the maximum overlap depth (number of intervals sharing a point).
fn ist_max_overlap_count(intervals)
    let r = ist_max_overlap_point(intervals)
    return r[1]

// ist_count_at_each_endpoint: list of [point, count] for each unique endpoint, sorted.
fn ist_count_at_each_endpoint(intervals)
    let pts = _ist_collect_endpoints(intervals)
    let np = len(pts)
    let out = []
    for i in 0..np
        let ii = i
        let p = pts[ii]
        let c = _ist_count_at(intervals, p)
        let pair = [p, c]
        push(out, pair)
    return out

// ist_first_stabbed: first interval (by list order) containing x, or null if none.
fn ist_first_stabbed(intervals, x)
    let n = len(intervals)
    let i = 0
    let result = null
    let done = false
    while i < n and done == false
        let ii = i
        let iv = intervals[ii]
        if _ist_contains(iv, x) == 1
            result = iv
            done = true
        i = i + 1
    return result

// ist_any_stab: true (1) if any interval contains x, false (0) otherwise.
fn ist_any_stab(intervals, x)
    let n = len(intervals)
    let i = 0
    let found = 0
    let done = false
    while i < n and done == false
        let ii = i
        if _ist_contains(intervals[ii], x) == 1
            found = 1
            done = true
        i = i + 1
    return found

// ist_deepest: maximum overlap depth (same as ist_max_overlap_count).
fn ist_deepest(intervals)
    return ist_max_overlap_count(intervals)

// ist_sweep: produce sorted sweep-line events as list of [point, type, idx].
// type 0 = interval opens (lo), type 1 = interval closes (hi).
// Events sorted by point ascending; within same point, opens (0) before closes (1).
fn ist_sweep(intervals)
    let n = len(intervals)
    let evts = []
    for i in 0..n
        let ii = i
        let iv = intervals[ii]
        let eo = [iv[0], 0, ii]
        let ec = [iv[1], 1, ii]
        push(evts, eo)
        push(evts, ec)
    // insertion sort by (point, type)
    let ne = len(evts)
    for j in 1..ne
        let key = evts[j]
        let kp = key[0]
        let kt = key[1]
        let pos = j
        let k = j - 1
        let done = false
        while k >= 0 and done == false
            let cur = evts[k]
            let cp = cur[0]
            let ct = cur[1]
            let shift = 0
            if cp > kp
                shift = 1
            else
                if cp == kp and ct > kt
                    shift = 1
            if shift == 1
                evts[k + 1] = evts[k]
                pos = k
                k = k - 1
            else
                done = true
        evts[pos] = key
    return evts
