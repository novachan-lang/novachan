// std/interval/interval_arith.nova — interval arithmetic on closed intervals [lo, hi].
// Intervals are 2-element lists [lo, hi] with lo <= hi.
// PREFIX: ia_   LEAF — imports nothing.
//
// FLOAT HAZARDS:
//   Always bind sub-expressions to named lets before returning float values.
//   Float vs int compare is UNSOUND — coerce with *1.0 when mixing.

// ia__min4: private helper — minimum of four values.
fn ia__min4(a, b, c, d)
    let m = a
    if b < m
        m = b
    if c < m
        m = c
    if d < m
        m = d
    m

// ia__max4: private helper — maximum of four values.
fn ia__max4(a, b, c, d)
    let m = a
    if b > m
        m = b
    if c > m
        m = c
    if d > m
        m = d
    m

// ia_add(a, b) -> [a0+b0, a1+b1]  Interval addition.
fn ia_add(a, b) -> any
    let lo = a[0] + b[0]
    let hi = a[1] + b[1]
    let r = [lo, hi]
    r

// ia_sub(a, b) -> [a0-b1, a1-b0]  Interval subtraction.
fn ia_sub(a, b) -> any
    let lo = a[0] - b[1]
    let hi = a[1] - b[0]
    let r = [lo, hi]
    r

// ia_mul(a, b) -> [min(...), max(...)]  Interval multiplication (all four products).
fn ia_mul(a, b) -> any
    let p0 = a[0] * b[0]
    let p1 = a[0] * b[1]
    let p2 = a[1] * b[0]
    let p3 = a[1] * b[1]
    let lo = ia__min4(p0, p1, p2, p3)
    let hi = ia__max4(p0, p1, p2, p3)
    let r = [lo, hi]
    r

// ia_neg(a) -> [-a1, -a0]  Interval negation.
fn ia_neg(a) -> any
    let lo = -a[1]
    let hi = -a[0]
    let r = [lo, hi]
    r

// ia_scale(a, s) -> interval scaled by s; swaps if s < 0.
fn ia_scale(a, s) -> any
    let lo = a[1] * s if s < 0 else a[0] * s
    let hi = a[0] * s if s < 0 else a[1] * s
    let r = [lo, hi]
    r

// ia_abs(a) -> interval of absolute values of a.
fn ia_abs(a) -> any
    let a0 = a[0]
    let a1 = a[1]
    if a0 >= 0
        let r = [a0, a1]
        return r
    if a1 <= 0
        let lo = -a1
        let hi = -a0
        let r = [lo, hi]
        return r
    let neg0 = -a0
    let hi = a1 if a1 > neg0 else neg0
    let r = [0, hi]
    r

// ia_pow2(a) -> square of interval [min(a0^2,a1^2) if 0 outside, else [0, max^2]].
fn ia_pow2(a) -> any
    let a0 = a[0]
    let a1 = a[1]
    let s0 = a0 * a0
    let s1 = a1 * a1
    if a0 >= 0
        let r = [s0, s1]
        return r
    if a1 <= 0
        let r = [s1, s0]
        return r
    let hi = s1 if s1 > s0 else s0
    let r = [0, hi]
    r

// ia_contains_value(a, x) -> bool  True if x is in [a[0], a[1]].
fn ia_contains_value(a, x) -> bool
    if x < a[0]
        return false
    if x > a[1]
        return false
    return true

// ia_width(a) -> float  Width of the interval (hi - lo).
fn ia_width(a) -> float
    let lo = a[0] * 1.0
    let hi = a[1] * 1.0
    let w = hi - lo
    w

// ia_midpoint(a) -> float  Midpoint of the interval.
fn ia_midpoint(a) -> float
    let lo = a[0] * 1.0
    let hi = a[1] * 1.0
    let sum = lo + hi
    let m = sum / 2.0
    m

// ia_is_valid(a) -> bool  True if lo <= hi.
fn ia_is_valid(a) -> bool
    a[0] <= a[1]

// ia_from_center(c, radius) -> [c-radius, c+radius].
fn ia_from_center(c, radius) -> any
    let lo = c - radius
    let hi = c + radius
    let r = [lo, hi]
    r
