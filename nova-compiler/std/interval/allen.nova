// std/interval/allen.nova — Allen's 13 interval relations for closed intervals [lo, hi].
// An interval is a 2-element list: [lo, hi] with lo <= hi.
// All 13 Allen relations plus al_relation(a,b)->string.
// PREFIX: al_  LEAF — imports nothing.

// al_before: a is entirely before b with a gap (a_hi < b_lo).
fn al_before(a, b) -> bool
    let ahi = a[1]
    let blo = b[0]
    return ahi < blo

// al_meets: a ends exactly where b begins (a_hi == b_lo).
fn al_meets(a, b) -> bool
    let ahi = a[1]
    let blo = b[0]
    return ahi == blo

// al_overlaps: a starts before b, they share an interior, a ends before b ends.
// Requires: a_lo < b_lo < a_hi < b_hi
fn al_overlaps(a, b) -> bool
    let alo = a[0]
    let ahi = a[1]
    let blo = b[0]
    let bhi = b[1]
    return alo < blo and blo < ahi and ahi < bhi

// al_starts: a and b start together; a ends first (a_lo==b_lo, a_hi<b_hi).
fn al_starts(a, b) -> bool
    let alo = a[0]
    let ahi = a[1]
    let blo = b[0]
    let bhi = b[1]
    return alo == blo and ahi < bhi

// al_during: a is strictly inside b (b_lo<a_lo and a_hi<b_hi).
fn al_during(a, b) -> bool
    let alo = a[0]
    let ahi = a[1]
    let blo = b[0]
    let bhi = b[1]
    return blo < alo and ahi < bhi

// al_finishes: a and b end together; a starts later (a_hi==b_hi, a_lo>b_lo).
fn al_finishes(a, b) -> bool
    let alo = a[0]
    let ahi = a[1]
    let blo = b[0]
    let bhi = b[1]
    return ahi == bhi and alo > blo

// al_equals: a and b are identical intervals.
fn al_equals(a, b) -> bool
    let alo = a[0]
    let ahi = a[1]
    let blo = b[0]
    let bhi = b[1]
    return alo == blo and ahi == bhi

// al_after: a is entirely after b with a gap (inverse of al_before).
fn al_after(a, b) -> bool
    return al_before(b, a)

// al_met_by: b ends exactly where a begins (inverse of al_meets).
fn al_met_by(a, b) -> bool
    return al_meets(b, a)

// al_overlapped_by: b overlaps a from the left (inverse of al_overlaps).
fn al_overlapped_by(a, b) -> bool
    return al_overlaps(b, a)

// al_started_by: a and b start together; b ends first (inverse of al_starts).
fn al_started_by(a, b) -> bool
    return al_starts(b, a)

// al_contains: a strictly contains b (inverse of al_during).
fn al_contains(a, b) -> bool
    return al_during(b, a)

// al_finished_by: a and b end together; b starts later (inverse of al_finishes).
fn al_finished_by(a, b) -> bool
    return al_finishes(b, a)

// al_relation: returns the single Allen relation name as a string.
// Evaluates all 13 relations in canonical order; exactly one will match.
fn al_relation(a, b) -> string
    if al_equals(a, b)
        return "equals"
    if al_before(a, b)
        return "before"
    if al_after(a, b)
        return "after"
    if al_meets(a, b)
        return "meets"
    if al_met_by(a, b)
        return "met_by"
    if al_starts(a, b)
        return "starts"
    if al_started_by(a, b)
        return "started_by"
    if al_finishes(a, b)
        return "finishes"
    if al_finished_by(a, b)
        return "finished_by"
    if al_during(a, b)
        return "during"
    if al_contains(a, b)
        return "contains"
    if al_overlaps(a, b)
        return "overlaps"
    if al_overlapped_by(a, b)
        return "overlapped_by"
    return "unknown"
