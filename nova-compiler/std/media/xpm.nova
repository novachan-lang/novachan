// ============================================================================
// NOVA Standard Library -- std/media/xpm
// ============================================================================
// XPM (X PixMap) encode/decode.  XPM is a C-source TEXT format -- no binary
// bytes are used; the entire file is valid ASCII/C source.
//
// FORMAT (XPM2 / X11 standard):
//   Line 1:  /* XPM */
//   Line 2:  static char * img[] = {
//   Line 3:  geometry quoted string: "W H NCOLORS CPP",
//             where CPP = chars per pixel (we always use CPP=1)
//   Color lines (NCOLORS):  each "<char> c #RRGGBB",
//   Pixel rows (H lines):   "<row-chars>", (last row without trailing comma)
//   Final line: };
//
// This implementation uses CPP=1 (one char per pixel) and a fixed palette of
// up to 8 symbols drawn from the pool " .XoO+@#" (space is first, which is
// the conventional background / first-color entry).  This covers the vast
// majority of thumbnail and test-pattern use cases.
//
// PUBLIC API:
//   xpm_encode(w, h, px_rgb) -> string
//     Encode a flat RGB pixel list (length w*h*3) to an XPM text string.
//     Returns "" if w<=0 or h<=0 or len(px_rgb) < w*h*3.
//     Colors are assigned palette chars in first-seen order from " .XoO+@#".
//     If more than 8 unique colors appear, extras map to the last palette char.
//
//   xpm_decode(s) -> dict
//     Decode an XPM text string.  Returns a dict with keys:
//       "w"  -> int    image width
//       "h"  -> int    image height
//       "px" -> list   flat RGB ints, length w*h*3
//     On malformed input returns {"w":0,"h":0,"px":[]}.
//
// px = flat list of ints, length w*h*3, order: R0,G0,B0, R1,G1,B1, ...
//
// NOTES:
//   - chr(34) used for double-quote delimiters in generated XPM text.
//   - slice(s,start,end) is NOVA's substring builtin.
//   - s[i] indexes a string as a single-char string.
//   - Private helpers prefixed _xpm_ to avoid link collisions.
//   - LEAF -- imports NOTHING.
// ============================================================================

// ── Private: palette pool (8 chars, CPP=1) ───────────────────────────────────
fn _xpm_pool() -> string
    " .XoO+@#"

// ── Private: 2-digit uppercase hex for a byte value 0..255 ──────────────────
fn _xpm_hex2(v) -> string
    let digits = "0123456789ABCDEF"
    let hi = (v >> 4) & 0xF
    let lo = v & 0xF
    digits[hi] + digits[lo]

// ── Private: hex char -> 0..15 (0 on unrecognised char) ──────────────────────
fn _xpm_hexval(c) -> int
    let v = 0
    if c >= "0" and c <= "9"
        v = ord(c) - 48
    else if c >= "A" and c <= "F"
        v = ord(c) - 55
    else if c >= "a" and c <= "f"
        v = ord(c) - 87
    v

// ── Private: parse 2 hex chars at offset i in s -> 0..255 ───────────────────
fn _xpm_parse_hex2(s, i) -> int
    let sn = len(s)
    let result = 0
    if i + 1 < sn
        result = (_xpm_hexval(s[i]) << 4) | _xpm_hexval(s[i + 1])
    result

// ── Private: split s on LF; strip trailing CR from each line ─────────────────
fn _xpm_split_lines(s) -> list
    let lines = []
    let n = len(s)
    let start = 0
    for i in 0..n
        if s[i] == "\n"
            let line = slice(s, start, i)
            let ll = len(line)
            if ll > 0 and line[ll - 1] == "\r"
                line = slice(line, 0, ll - 1)
            lines.push(line)
            start = i + 1
    if start < n
        let last = slice(s, start, n)
        let ll2 = len(last)
        if ll2 > 0 and last[ll2 - 1] == "\r"
            last = slice(last, 0, ll2 - 1)
        lines.push(last)
    lines

// ── Private: extract content of first "..." pair in a line ───────────────────
// Finds first chr(34) then scans from end for matching chr(34).
// Returns the text between them, or "" if no pair found.
fn _xpm_quoted(line) -> string
    let n = len(line)
    let open_pos = -1
    for i in 0..n and open_pos == -1
        if ord(line[i]) == 34
            open_pos = i
    if open_pos == -1
        return ""
    let close_pos = -1
    let j = n - 1
    while j > open_pos and close_pos == -1
        if ord(line[j]) == 34
            close_pos = j
        j -= 1
    if close_pos <= open_pos
        return ""
    slice(line, open_pos + 1, close_pos)

// ── Private: parse space-separated ints from s -> list (at least 4 entries) ──
fn _xpm_parse_ints(s) -> list
    let n = len(s)
    let nums = []
    let cur = 0
    let in_num = 0
    for i in 0..n
        let c = s[i]
        if c >= "0" and c <= "9"
            cur *= 10 + (ord(c) - 48)
            in_num = 1
        else
            if in_num == 1
                nums.push(cur)
                cur = 0
                in_num = 0
    if in_num == 1
        nums.push(cur)
    while len(nums) < 4
        nums.push(0)
    nums

// ── Private: find index of char ch in pool s, or -1 ─────────────────────────
fn _xpm_pool_idx(pool, ch) -> int
    let n = len(pool)
    let i = 0
    let found = -1
    while i < n and found == -1
        if pool[i] == ch
            found = i
        i += 1
    found

// ============================================================================
// PUBLIC: xpm_encode
// ============================================================================
fn xpm_encode(w, h, px_rgb) -> string
    if w <= 0 or h <= 0
        return ""
    if len(px_rgb) < w * h * 3
        return ""

    // Build palette: collect first-seen unique packed RGB values (max 8)
    let pool = _xpm_pool()
    let pool_size = len(pool)
    let pal_rgb = []
    let pal_count = 0
    let px_count = w * h
    for pi in 0..px_count
        let r = px_rgb[pi * 3] & 0xFF
        let g = px_rgb[pi * 3 + 1] & 0xFF
        let b = px_rgb[pi * 3 + 2] & 0xFF
        let packed = (r << 16) | (g << 8) | b
        let found = 0
        for ci in 0..pal_count and found == 0
            if pal_rgb[ci] == packed
                found = 1
        if found == 0 and pal_count < pool_size
            pal_rgb.push(packed)
            pal_count += 1

    // q = chr(34) = double-quote
    let q = chr(34)

    // Header: /* XPM */
    // chr(123)='{' chr(125)='}' -- avoid interpolation inside strings
    let ob = chr(123)
    let cb = chr(125)
    let out = "/* XPM */\n"
    out += "static char * img[] = " + ob + "\n"

    // Geometry line
    out += q + str(w) + " " + str(h) + " " + str(pal_count) + " 1" + q + ",\n"

    // Color definition lines
    for ci2 in 0..pal_count
        let packed2 = pal_rgb[ci2]
        let rr = (packed2 >> 16) & 0xFF
        let gg = (packed2 >> 8) & 0xFF
        let bb = packed2 & 0xFF
        let pch = pool[ci2]
        out += q + pch + " c #" + _xpm_hex2(rr) + _xpm_hex2(gg) + _xpm_hex2(bb) + q + ",\n"

    // Pixel rows
    for row in 0..h
        let row_str_parts = []
        for col in 0..w
            let idx = (row * w + col) * 3
            let r2 = px_rgb[idx] & 0xFF
            let g2 = px_rgb[idx + 1] & 0xFF
            let b2 = px_rgb[idx + 2] & 0xFF
            let packed3 = (r2 << 16) | (g2 << 8) | b2
            let pidx = 0
            let pf = 0
            for pk in 0..pal_count and pf == 0
                if pal_rgb[pk] == packed3
                    pidx = pk
                    pf = 1
            if pf == 0
                pidx = pal_count - 1
            push(row_str_parts, pool[pidx])
        let row_str = join(row_str_parts, "")
        if row < h - 1
            out += q + row_str + q + ",\n"
        else
            out += q + row_str + q + "\n"

    out + cb + ";\n"

// ============================================================================
// PUBLIC: xpm_decode
// ============================================================================
fn xpm_decode(s) -> dict
    let empty = {"w": 0, "h": 0, "px": []}
    let lines = _xpm_split_lines(s)
    let nlines = len(lines)
    if nlines < 1
        return empty

    // Line 0 must contain "/* XPM */"
    let ln0 = lines[0]
    let ml = len(ln0)
    let found_magic = 0
    for mi in 0..(ml - 9 and found_magic == 0) + 1
        if slice(ln0, mi, mi + 9) == "/* XPM */"
            found_magic = 1
    if found_magic == 0
        return empty

    // Find geometry line (first quoted line)
    let li = 1
    let geom_str = ""
    let found_geom = 0
    while li < nlines and found_geom == 0
        let q2 = _xpm_quoted(lines[li])
        if len(q2) > 0
            found_geom = 1
            geom_str = q2
        li += 1
    if found_geom == 0
        return empty

    let geom = _xpm_parse_ints(geom_str)
    let w = geom[0]
    let h = geom[1]
    let ncolors = geom[2]
    let cpp = geom[3]
    if w <= 0 or h <= 0 or ncolors <= 0 or cpp != 1
        return empty

    // Read color definition lines -> color_map: char_string -> packed_rgb int
    let color_map = {}
    for ci3 in 0..ncolors and li < nlines
        // find next quoted line
        let q3 = ""
        let fq = 0
        while li < nlines and fq == 0
            let cand = _xpm_quoted(lines[li])
            li += 1
            if len(cand) > 0
                q3 = cand
                fq = 1
        if fq == 0
            return empty
        let qlen = len(q3)
        if qlen < 1
            return empty
        let pch2 = q3[0]
        // find '#' in q3
        let hash_pos = -1
        for qi in 0..qlen and hash_pos == -1
            if ord(q3[qi]) == 35
                hash_pos = qi
        let rr2 = 0
        let gg2 = 0
        let bb2 = 0
        if hash_pos >= 0 and hash_pos + 6 <= qlen
            rr2 = _xpm_parse_hex2(q3, hash_pos + 1)
            gg2 = _xpm_parse_hex2(q3, hash_pos + 3)
            bb2 = _xpm_parse_hex2(q3, hash_pos + 5)
        color_map[pch2] = (rr2 << 16) | (gg2 << 8) | bb2

    // Read pixel rows
    let px = []
    for row2 in 0..h and li < nlines
        let q4 = ""
        let fq2 = 0
        while li < nlines and fq2 == 0
            let cand2 = _xpm_quoted(lines[li])
            li += 1
            if len(cand2) > 0
                q4 = cand2
                fq2 = 1
        if fq2 == 0
            return empty
        if len(q4) < w
            return empty
        for col2 in 0..w
            let pch3 = q4[col2]
            let packed5 = 0
            if pch3 in color_map
                packed5 = color_map[pch3]
            let rr3 = (packed5 >> 16) & 0xFF
            let gg3 = (packed5 >> 8) & 0xFF
            let bb3 = packed5 & 0xFF
            px.push(rr3)
            px.push(gg3)
            px.push(bb3)

    {"w": w, "h": h, "px": px}
