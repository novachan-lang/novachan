// std/media/id3 -- ID3v2 tag header + ID3v1 tail detection for MP3 metadata.
//
// ID3v2 HEADER (10 bytes at offset 0):
//   Bytes 0..2  'ID3' = 73,68,51
//   Byte  3     major version (2, 3, or 4)
//   Byte  4     revision
//   Byte  5     flags (bit7=unsync, bit6=extended header, bit5=experimental, bit4=footer)
//   Bytes 6..9  tag size as syncsafe integer (each byte uses only low 7 bits):
//               size = (b6 & 0x7F) << 21 | (b7 & 0x7F) << 14 | (b8 & 0x7F) << 7 | (b9 & 0x7F)
//
// ID3v1 TAIL (128 bytes at end of file):
//   Bytes -128..-126 = 'TAG' = 84,65,71
//
// PUBLIC API (prefix id3v2_ / id3v1_):
//   id3v2_magic_check(buf)       -> bool   first 3 bytes are 'ID3'
//   id3v2_major(buf)             -> int    major version byte
//   id3v2_revision(buf)          -> int    revision byte
//   id3v2_flags(buf)             -> int    flags byte
//   id3v2_flag_unsync(buf)       -> bool   bit 7 of flags set
//   id3v2_flag_ext(buf)          -> bool   bit 6 of flags set (extended header)
//   id3v2_flag_experimental(buf) -> bool   bit 5 of flags set
//   id3v2_flag_footer(buf)       -> bool   bit 4 of flags set
//   id3v2_syncsafe(b0,b1,b2,b3) -> int    decode 4 syncsafe bytes to integer
//   id3v2_size(buf)              -> int    syncsafe decode of bytes 6..9
//   id3v2_total_size(buf)        -> int    10 (header) + tag size
//   id3v2_version_name(buf)      -> string 'ID3v2.<major>'
//   id3v1_check(buf)             -> bool   'TAG' at offset len-128 (requires len>=128)
//
// LEAF module -- imports nothing.

// id3v2_magic_check: return true if bytes 0..2 are 'ID3' (73,68,51).
fn id3v2_magic_check(buf: any) -> bool
    if len(buf) < 3
        return false
    if buf[0] != 73
        return false
    if buf[1] != 68
        return false
    if buf[2] != 51
        return false
    return true

// id3v2_major: return the major version byte at offset 3.
fn id3v2_major(buf: any) -> int
    if len(buf) < 4
        return 0
    return buf[3]

// id3v2_revision: return the revision byte at offset 4.
fn id3v2_revision(buf: any) -> int
    if len(buf) < 5
        return 0
    return buf[4]

// id3v2_flags: return the flags byte at offset 5.
fn id3v2_flags(buf: any) -> int
    if len(buf) < 6
        return 0
    return buf[5]

// id3v2_flag_unsync: return true if bit 7 (0x80) of the flags byte is set.
fn id3v2_flag_unsync(buf: any) -> bool
    return (id3v2_flags(buf) & 0x80) != 0

// id3v2_flag_ext: return true if bit 6 (0x40) of the flags byte is set (extended header).
fn id3v2_flag_ext(buf: any) -> bool
    return (id3v2_flags(buf) & 0x40) != 0

// id3v2_flag_experimental: return true if bit 5 (0x20) of the flags byte is set.
fn id3v2_flag_experimental(buf: any) -> bool
    return (id3v2_flags(buf) & 0x20) != 0

// id3v2_flag_footer: return true if bit 4 (0x10) of the flags byte is set.
fn id3v2_flag_footer(buf: any) -> bool
    return (id3v2_flags(buf) & 0x10) != 0

// id3v2_syncsafe: decode four syncsafe bytes into an integer.
// Each byte contributes only its low 7 bits.
// size = (b0 & 0x7F) << 21 | (b1 & 0x7F) << 14 | (b2 & 0x7F) << 7 | (b3 & 0x7F)
fn id3v2_syncsafe(b0: int, b1: int, b2: int, b3: int) -> int
    let v0 = (b0 & 0x7F) * 2097152
    let v1 = (b1 & 0x7F) * 16384
    let v2 = (b2 & 0x7F) * 128
    let v3 = b3 & 0x7F
    return v0 + v1 + v2 + v3

// id3v2_size: return the tag size decoded from the syncsafe integer at bytes 6..9.
fn id3v2_size(buf: any) -> int
    if len(buf) < 10
        return 0
    return id3v2_syncsafe(buf[6], buf[7], buf[8], buf[9])

// id3v2_total_size: return the total byte span of the ID3v2 tag (10-byte header + tag body).
fn id3v2_total_size(buf: any) -> int
    return 10 + id3v2_size(buf)

// id3v2_version_name: return a human-readable version string like 'ID3v2.3'.
fn id3v2_version_name(buf: any) -> string
    let maj = id3v2_major(buf)
    return "ID3v2.{maj}"

// id3v1_check: return true if 'TAG' (84,65,71) appears at offset len(buf)-128.
// Requires the buffer to be at least 128 bytes long.
fn id3v1_check(buf: any) -> bool
    let n = len(buf)
    if n < 128
        return false
    let start = n - 128
    if buf[start] != 84
        return false
    if buf[start+1] != 65
        return false
    if buf[start+2] != 71
        return false
    return true
