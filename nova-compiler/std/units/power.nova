// std/units/power.nova — Power unit conversions. Base unit = watt (w).
//
// Supported units (code -> watts):
//   w      = 1.0            (watt)
//   kw     = 1000.0         (kilowatt)
//   mw     = 1000000.0      (megawatt)
//   hp     = 745.6998715823 (mechanical horsepower)
//   hpm    = 735.49875      (metric horsepower)
//   btuh   = 0.29307107     (BTU per hour)
//   ftlbs  = 1.3558179483   (foot-pound per second)
//
// Unknown unit -> 0.0 (documented behavior).

// Return list of supported unit codes.
fn power_units() -> list
    let us = ["w", "kw", "mw", "hp", "hpm", "btuh", "ftlbs"]
    us

// Return factor: how many watts equals 1 of `unit`. Returns 0.0 for unknown.
fn power_factor(unit: string) -> float
    let factors = {"w": 1.0, "kw": 1000.0, "mw": 1000000.0, "hp": 745.6998715823, "hpm": 735.49875, "btuh": 0.29307107, "ftlbs": 1.3558179483}
    let result = factors[unit] if unit in factors else 0.0
    result

// Return 1 if `unit` is in the supported set, 0 otherwise.
fn power_is_supported(unit: string) -> int
    let f = power_factor(unit)
    let result = 1 if f > 0.0 else 0
    result

// Convert `value` in `unit` to watts (the base unit).
fn power_to_base(value: float, unit: string) -> float
    let f = power_factor(unit)
    let r = value * f
    r

// Convert `value` watts to `unit`. Returns 0.0 if unit unknown.
fn power_from_base(value: float, unit: string) -> float
    let f = power_factor(unit)
    let result = 0.0
    if f > 0.0
        result = value / f
    result

// Convert `value` from `from_unit` to `to_unit`.
fn power_convert(value: float, from_unit: string, to_unit: string) -> float
    let base = power_to_base(value, from_unit)
    let result = power_from_base(base, to_unit)
    result

// Convenience: kilowatts to watts.
fn kw_to_w(kw: float) -> float
    let r = kw * 1000.0
    r

// Convenience: watts to kilowatts.
fn w_to_kw(w: float) -> float
    let r = w / 1000.0
    r

// Convenience: horsepower (mechanical) to watts.
fn hp_to_w(hp: float) -> float
    let r = hp * 745.6998715823
    r

// Convenience: watts to horsepower (mechanical).
fn w_to_hp(w: float) -> float
    let r = w / 745.6998715823
    r
