// std/units/mass.nova — Mass unit conversions (SI base: kilogram).
//
// Supported unit codes (lowercase):
//   kg   kilogram           (1.0 kg)
//   g    gram               (0.001 kg)
//   mg   milligram          (0.000001 kg)
//   t    tonne              (1000.0 kg)
//   lb   pound              (0.45359237 kg)
//   oz   ounce              (0.028349523125 kg)
//   st   stone              (6.35029318 kg)
//   ct   carat              (0.0002 kg)
//
// Unknown units return 0.0 (conversion factor = 0.0).
//
// API:
//   mass_to_base(value, unit)        -> float  value in unit -> kilograms
//   mass_from_base(value, unit)      -> float  kilograms -> value in unit
//   mass_convert(value, from, to)    -> float  direct conversion
//   mass_factor(unit)                -> float  kilograms per unit
//   mass_is_supported(unit)          -> bool (1/0)
//   mass_units()                     -> list   all supported codes

// Return kilograms-per-unit factor for the given unit code.
fn mass_factor(unit: string) -> float
    let factors = {"kg": 1.0, "g": 0.001, "mg": 0.000001, "t": 1000.0, "lb": 0.45359237, "oz": 0.028349523125, "st": 6.35029318, "ct": 0.0002}
    let r = factors[unit] if unit in factors else 0.0
    r

// Convert value in the given unit to the SI base unit (kilogram).
fn mass_to_base(value: float, unit: string) -> float
    let f = mass_factor(unit)
    let result = value * f
    result

// Convert a value in kilograms to the given unit.
fn mass_from_base(value: float, unit: string) -> float
    let f = mass_factor(unit)
    let result = 0.0
    if f > 0.0
        result = value / f
    result

// Convert value from one unit to another.
fn mass_convert(value: float, from_unit: string, to_unit: string) -> float
    let base = mass_to_base(value, from_unit)
    let result = mass_from_base(base, to_unit)
    result

// Returns 1 if the unit code is supported, 0 otherwise.
fn mass_is_supported(unit: string) -> int
    let f = mass_factor(unit)
    let ok = 1 if f > 0.0 else 0
    ok

// Returns list of all supported unit codes.
fn mass_units() -> list
    let us = ["kg", "g", "mg", "t", "lb", "oz", "st", "ct"]
    us
