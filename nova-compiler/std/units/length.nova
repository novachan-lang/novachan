// std/units/length.nova — Length unit conversions (SI base: meter).
//
// Supported unit codes (lowercase):
//   m    metre              (1.0 m)
//   km   kilometre          (1000.0 m)
//   cm   centimetre         (0.01 m)
//   mm   millimetre         (0.001 m)
//   um   micrometre         (0.000001 m)
//   nm   nanometre          (0.000000001 m)
//   mi   mile               (1609.344 m)
//   yd   yard               (0.9144 m)
//   ft   foot               (0.3048 m)
//   in   inch               (0.0254 m)
//   nmi  nautical mile      (1852.0 m)
//
// Unknown units return 0.0 (conversion factor = 0.0).
//
// API:
//   length_to_base(value, unit)          -> float  value in unit -> metres
//   length_from_base(value, unit)        -> float  metres -> value in unit
//   length_convert(value, from, to)      -> float  direct conversion
//   length_factor(unit)                  -> float  metres per unit
//   length_is_supported(unit)            -> bool (1/0)
//   length_units()                       -> list   all supported codes
//   km_to_m(v)                           -> float  convenience
//   mi_to_km(v)                          -> float  convenience
//   ft_to_m(v)                           -> float  convenience

// Return metres-per-unit factor for the given unit code.
fn length_factor(unit: string) -> float
    let factors = {"m": 1.0, "km": 1000.0, "cm": 0.01, "mm": 0.001, "um": 0.000001, "nm": 0.000000001, "mi": 1609.344, "yd": 0.9144, "ft": 0.3048, "in": 0.0254, "nmi": 1852.0}
    let r = factors[unit] if unit in factors else 0.0
    r

// Convert value in the given unit to the SI base unit (metre).
fn length_to_base(value: float, unit: string) -> float
    let f = length_factor(unit)
    let result = value * f
    result

// Convert a value in metres to the given unit.
fn length_from_base(value: float, unit: string) -> float
    let f = length_factor(unit)
    let result = 0.0
    if f > 0.0
        result = value / f
    result

// Convert value from one unit to another.
fn length_convert(value: float, from_unit: string, to_unit: string) -> float
    let base = length_to_base(value, from_unit)
    let result = length_from_base(base, to_unit)
    result

// Returns 1 if the unit code is supported, 0 otherwise.
fn length_is_supported(unit: string) -> int
    let f = length_factor(unit)
    let ok = 1 if f > 0.0 else 0
    ok

// Returns list of all supported unit codes.
fn length_units() -> list
    let us = ["m", "km", "cm", "mm", "um", "nm", "mi", "yd", "ft", "in", "nmi"]
    us

// Convenience: kilometres to metres.
fn km_to_m(v: float) -> float
    let r = v * 1000.0
    r

// Convenience: miles to kilometres.
fn mi_to_km(v: float) -> float
    let factor = 1609.344
    let m = v * factor
    let km = m / 1000.0
    km

// Convenience: feet to metres.
fn ft_to_m(v: float) -> float
    let r = v * 0.3048
    r
