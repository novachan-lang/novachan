// std/units/time.nova — Time unit conversions (SI base: second).
//
// Supported unit codes (lowercase):
//   s    second             (1.0 s)
//   ms   millisecond        (0.001 s)
//   us   microsecond        (0.000001 s)
//   min  minute             (60.0 s)
//   h    hour               (3600.0 s)
//   d    day                (86400.0 s)
//   wk   week               (604800.0 s)
//   yr   year (365 days)    (31536000.0 s)
//
// Unknown units return 0.0 (conversion factor = 0.0).
//
// API:
//   time_to_base(value, unit)        -> float  value in unit -> seconds
//   time_from_base(value, unit)      -> float  seconds -> value in unit
//   time_convert(value, from, to)    -> float  direct conversion
//   time_factor(unit)                -> float  seconds per unit
//   time_is_supported(unit)          -> bool (1/0)
//   time_units()                     -> list   all supported codes

// Return seconds-per-unit factor for the given unit code.
fn time_factor(unit: string) -> float
    let factors = {"s": 1.0, "ms": 0.001, "us": 0.000001, "min": 60.0, "h": 3600.0, "d": 86400.0, "wk": 604800.0, "yr": 31536000.0}
    let r = factors[unit] if unit in factors else 0.0
    r

// Convert value in the given unit to the SI base unit (second).
fn time_to_base(value: float, unit: string) -> float
    let f = time_factor(unit)
    let result = value * f
    result

// Convert a value in seconds to the given unit.
fn time_from_base(value: float, unit: string) -> float
    let f = time_factor(unit)
    let result = 0.0
    if f > 0.0
        result = value / f
    result

// Convert value from one unit to another.
fn time_convert(value: float, from_unit: string, to_unit: string) -> float
    let base = time_to_base(value, from_unit)
    let result = time_from_base(base, to_unit)
    result

// Returns 1 if the unit code is supported, 0 otherwise.
fn time_is_supported(unit: string) -> int
    let f = time_factor(unit)
    let ok = 1 if f > 0.0 else 0
    ok

// Returns list of all supported unit codes.
fn time_units() -> list
    let us = ["s", "ms", "us", "min", "h", "d", "wk", "yr"]
    us
