// std/units/area.nova — area unit conversions.
// LEAF — imports NOTHING; all helpers are private (_area_ prefix).
//
// Base unit: square metre (m2).
// Conversion factors: how many m2 equals one unit.
//
// Supported unit codes and factors (to m2):
//   m2   = 1.0
//   km2  = 1000000.0
//   cm2  = 0.0001
//   mm2  = 0.000001
//   ha   = 10000.0           (hectare)
//   acre = 4046.8564224
//   ft2  = 0.09290304
//   in2  = 0.00064516
//   mi2  = 2589988.110336
//   yd2  = 0.83612736
//
// Public API:
//   area_factor(unit)                  -> float  (m2 per unit; 0.0 if unknown)
//   area_to_base(value, unit)          -> float  (value in unit -> m2)
//   area_from_base(value, unit)        -> float  (m2 -> value in unit)
//   area_convert(value, from, to)      -> float
//   area_units()                       -> list
//   area_is_supported(unit)            -> bool

// area_factor — returns how many square metres equal one `unit`.
// Returns 0.0 for unknown unit codes.
fn area_factor(unit)
    if unit == "m2"
        return 1.0
    if unit == "km2"
        return 1000000.0
    if unit == "cm2"
        return 0.0001
    if unit == "mm2"
        return 0.000001
    if unit == "ha"
        return 10000.0
    if unit == "acre"
        return 4046.8564224
    if unit == "ft2"
        return 0.09290304
    if unit == "in2"
        return 0.00064516
    if unit == "mi2"
        return 2589988.110336
    if unit == "yd2"
        return 0.83612736
    return 0.0

// area_to_base — convert `value` in `unit` to square metres.
fn area_to_base(value, unit)
    let f = area_factor(unit)
    let r = value * f
    return r

// area_from_base — convert square-metre value to `unit`.
fn area_from_base(value, unit)
    let f = area_factor(unit)
    if f == 0.0
        return 0.0
    let r = value / f
    return r

// area_convert — convert `value` from `from` unit to `to` unit.
// Returns 0.0 if either unit is unknown.
fn area_convert(value, from, to)
    let base = area_to_base(value, from)
    let result = area_from_base(base, to)
    return result

// area_units — list of supported unit codes.
fn area_units()
    let us = []
    push(us, "m2")
    push(us, "km2")
    push(us, "cm2")
    push(us, "mm2")
    push(us, "ha")
    push(us, "acre")
    push(us, "ft2")
    push(us, "in2")
    push(us, "mi2")
    push(us, "yd2")
    return us

// area_is_supported — true (1) if unit code is known, false (0) otherwise.
fn area_is_supported(unit)
    let f = area_factor(unit)
    if f == 0.0
        return 0
    return 1
