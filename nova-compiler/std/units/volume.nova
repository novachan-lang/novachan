// std/units/volume.nova — volume unit conversions.
// LEAF — imports NOTHING; all helpers are private (_vol_ prefix).
//
// Base unit: litre (l).
// Conversion factors: how many litres equal one unit.
//
// Supported unit codes and factors (to litres):
//   l     = 1.0
//   ml    = 0.001
//   m3    = 1000.0
//   cm3   = 0.001
//   galus = 3.785411784      (US gallon)
//   galuk = 4.54609          (UK/imperial gallon)
//   qtus  = 0.946352946      (US quart)
//   ptus  = 0.473176473      (US pint)
//   floz  = 0.0295735295625  (US fluid ounce)
//   cup   = 0.2365882365     (US customary cup = galus/16; NOT the 0.240 L FDA "legal cup")
//   ft3   = 28.316846592
//   in3   = 0.016387064
//
// Public API:
//   volume_factor(unit)                -> float  (litres per unit; 0.0 if unknown)
//   volume_to_base(value, unit)        -> float  (value in unit -> litres)
//   volume_from_base(value, unit)      -> float  (litres -> value in unit)
//   volume_convert(value, from, to)    -> float
//   volume_units()                     -> list
//   volume_is_supported(unit)          -> bool

// volume_factor — returns how many litres equal one `unit`.
// Returns 0.0 for unknown unit codes.
fn volume_factor(unit)
    let factors = {"l": 1.0, "ml": 0.001, "m3": 1000.0, "cm3": 0.001, "galus": 3.785411784, "galuk": 4.54609, "qtus": 0.946352946, "ptus": 0.473176473, "floz": 0.0295735295625, "cup": 0.2365882365, "ft3": 28.316846592, "in3": 0.016387064}
    return factors[unit] if unit in factors else 0.0

// volume_to_base — convert `value` in `unit` to litres.
fn volume_to_base(value, unit)
    let f = volume_factor(unit)
    let r = value * f
    return r

// volume_from_base — convert litre value to `unit`.
fn volume_from_base(value, unit)
    let f = volume_factor(unit)
    if f == 0.0
        return 0.0
    let r = value / f
    return r

// volume_convert — convert `value` from `from` unit to `to` unit.
// Returns 0.0 if either unit is unknown.
fn volume_convert(value, from, to)
    let base = volume_to_base(value, from)
    let result = volume_from_base(base, to)
    return result

// volume_units — list of supported unit codes.
fn volume_units()
    return ["l", "ml", "m3", "cm3", "galus", "galuk", "qtus", "ptus", "floz", "cup", "ft3", "in3"]

// volume_is_supported — true (1) if unit code is known, false (0) otherwise.
fn volume_is_supported(unit)
    let f = volume_factor(unit)
    return 0 if f == 0.0 else 1
