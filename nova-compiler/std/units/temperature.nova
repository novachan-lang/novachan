// std/units/temperature.nova — affine temperature conversions.
// LEAF — imports NOTHING; all helpers are private (_temp_ prefix).
//
// Base unit: Celsius (intermediate only; no "base" storage since conversions
// are affine, not pure-scale).
//
// Supported unit codes: 'c' (Celsius), 'f' (Fahrenheit), 'k' (Kelvin).
//
// Formulas (exact):
//   F = C * 9.0 / 5.0 + 32.0
//   C = (F - 32.0) * 5.0 / 9.0
//   K = C + 273.15
//   C = K - 273.15
//
// Public API:
//   c_to_f(v)                          -> float
//   f_to_c(v)                          -> float
//   c_to_k(v)                          -> float
//   k_to_c(v)                          -> float
//   f_to_k(v)                          -> float
//   k_to_f(v)                          -> float
//   temperature_convert(v, from, to)   -> float
//   temperature_units()                -> list
//   temperature_is_supported(unit)     -> bool

// _temp_to_c — convert a value in `unit` to Celsius.
fn _temp_to_c(value, unit)
    if unit == "c"
        return value
    if unit == "f"
        let c = (value - 32.0) * 5.0 / 9.0
        return c
    if unit == "k"
        let c = value - 273.15
        return c
    return value

// _temp_from_c — convert a Celsius value to `unit`.
fn _temp_from_c(celsius, unit)
    if unit == "c"
        return celsius
    if unit == "f"
        let f = celsius * 9.0 / 5.0 + 32.0
        return f
    if unit == "k"
        let k = celsius + 273.15
        return k
    return celsius

// c_to_f — convert Celsius to Fahrenheit.
fn c_to_f(v)
    let f = v * 9.0 / 5.0 + 32.0
    return f

// f_to_c — convert Fahrenheit to Celsius.
fn f_to_c(v)
    let c = (v - 32.0) * 5.0 / 9.0
    return c

// c_to_k — convert Celsius to Kelvin.
fn c_to_k(v)
    let k = v + 273.15
    return k

// k_to_c — convert Kelvin to Celsius.
fn k_to_c(v)
    let c = v - 273.15
    return c

// f_to_k — convert Fahrenheit to Kelvin.
fn f_to_k(v)
    let c = f_to_c(v)
    let k = c_to_k(c)
    return k

// k_to_f — convert Kelvin to Fahrenheit.
fn k_to_f(v)
    let c = k_to_c(v)
    let f = c_to_f(c)
    return f

// temperature_convert — general conversion between any two supported units.
// Unknown unit codes: returns the input value unchanged.
fn temperature_convert(value, from, to)
    let celsius = _temp_to_c(value, from)
    let result = _temp_from_c(celsius, to)
    return result

// temperature_units — list of supported unit codes.
fn temperature_units()
    return ["c", "f", "k"]

// temperature_is_supported — true (1) if unit code is known, false (0) otherwise.
fn temperature_is_supported(unit)
    if unit in ["c", "f", "k"]
        return 1
    return 0
