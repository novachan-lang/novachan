// ============================================================================
// NOVA Standard Library — std/time/tz
// Timezone + DST engine (pure NOVA, no FFI, same binary everywhere)
// ============================================================================
//
// WHAT:
//   Correct UTC<->local conversion with DST for all major IANA zones.
//   Backed by a POSIX-TZ-rule engine — compact, exactly correct for the
//   modern era (~2007+). No filesystem zoneinfo, no OS calls, no FFI.
//
// NOVA-WAY:
//   All epochs are UTC seconds (int) by definition — no "naive datetime"
//   that is silently wrong (the Python trap). Functions on ints+strings,
//   NOT a 15-class zoo (the Java ZoneId/ZonedDateTime trap). The result
//   of tz_offset_at is a plain int (seconds east of UTC); callers add it
//   to an epoch and get local wall seconds — nothing hidden.
//
// DRAWBACKS AVOIDED:
//   Java — ZoneId, ZonedDateTime, ZoneOffset, ZoneRules, Instant,
//           LocalDateTime + 10 more classes interacting in surprising ways.
//           NOVA: 4 public functions, everything is an int or string.
//   Python — datetime.datetime without tzinfo is "naive" and silently
//             computes wrong cross-timezone diffs. NOVA: no naive mode;
//             all epochs are UTC by construction.
//   Go    — time.LoadLocation reads /usr/share/zoneinfo, which is absent
//             in many Docker images, causing runtime panics. NOVA: rules
//             are compiled in; zero filesystem dependency.
//
// PUBLIC API:
//   tz_offset_at(epoch, zone) -> int
//       Signed offset in SECONDS EAST of UTC, DST-aware.
//       EST winter = -18000, EDT summer = -14400, IST = +19800, UTC = 0.
//       Unknown zone -> 0 (treated as UTC; never crashes).
//
//   tz_to_local(epoch, zone) -> int
//       epoch + tz_offset_at(epoch, zone)
//       Local "wall" seconds. Subtract tz_offset_at to go back to UTC.
//
//   tz_next_transition(epoch, zone) -> int
//       Next DST transition epoch strictly after `epoch`.
//       Returns -1 if zone has no DST (UTC, IST, JST ...).
//
//   tz_abbrev(epoch, zone) -> string
//       Abbreviation at that instant: "EST", "EDT", "BST", "IST", etc.
//       Unknown zone -> "UTC".
//
// POSIX TZ STRING FORMAT (brief):
//   stdABBR HOURS_WEST [dstABBR [HOURS_WEST_DST] [,Mm.w.d[/H],Mm.w.d[/H]]]
//   HOURS_WEST is positive WEST (EST5 = UTC-5 = -18000 s east).
//   Negative means east: IST-5:30 = UTC+5:30 = +19800 s east.
//   Mm.w.d = month m (1..12), week w (1..5; 5=last), weekday d (0=Sun).
//   /H suffix = local transition hour (default 2).
//   DST offset defaults to std_offset + 3600 (one hour ahead, east).

// ── Integer helpers ──────────────────────────────────────────────────────────

// ord of single character (avoids repeating ord(s[i:i+1]) pattern)
fn _ch_ord(s, i) -> int
    ord(s[i:i + 1])

// Is character at position i a digit? Returns 1/0.
fn _is_digit(s, i) -> int
    let c = _ch_ord(s, i)
    if c >= 48 and c <= 57
        return 1
    0

// Is character at position i alphabetic (A-Z or a-z)? Returns 1/0.
fn _is_alpha(s, i) -> int
    let c = _ch_ord(s, i)
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
        return 1
    0

// ── Calendar helpers (Howard Hinnant, pure integer, positive epochs only) ────
// For the POSIX-TZ engine we only need years ~2000+; all divisions are
// exact floor divisions since all operands are non-negative for modern eras.

fn _is_leap(y) -> int
    if y % 400 == 0
        return 1
    if y % 100 == 0
        return 0
    if y % 4 == 0
        return 1
    0

fn _days_in_month(y, m) -> int
    if m == 2
        if _is_leap(y) == 1
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    31

// Convert days-since-1970-01-01 to [year, month, day] list.
// Same algorithm as datefmtx._df_civil_from_days (verified correct).
fn _civil_from_days(z0) -> list
    let z = z0 + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if mp >= 10
        m = mp - 9
    if m <= 2
        y = y + 1
    [y, m, d]

// Convert calendar date to days-since-1970-01-01.
fn _days_from_civil(y0, m, d) -> int
    let y = y0
    if m <= 2
        y = y - 1
    let era = y / 400
    let yoe = y - era * 400
    let mp = m - 3
    if m <= 2
        mp = m + 9
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

// Year from epoch (UTC seconds). Fast path for modern positive epochs.
fn _year_from_epoch(epoch) -> int
    let days = epoch / 86400
    let ymd = _civil_from_days(days)
    ymd[0]

// Weekday of day-of-month dom in year y month m (0=Sun, 4=Thu for 1970-01-01).
fn _dom_weekday(y, m, dom) -> int
    let days = _days_from_civil(y, m, dom)
    (days + 4) % 7

// Day-of-month of the w-th occurrence of weekday wd in month m of year y.
// w=1..4 = first..fourth; w=5 = last.
fn _nth_weekday_dom(y, m, w, wd) -> int
    // Weekday of the 1st of the month.
    let wd1 = _dom_weekday(y, m, 1)
    // Days until the first wd from the 1st (0 if wd1 == wd).
    let diff = (wd - wd1 + 7) % 7
    let first = 1 + diff
    if w == 5
        // Last occurrence: advance by 7 until next would exceed dim.
        let dim = _days_in_month(y, m)
        let last = first
        while last + 7 <= dim
            last = last + 7
        return last
    first + (w - 1) * 7

// ── POSIX TZ string parsing ──────────────────────────────────────────────────
//
// We parse digit sequences and abbreviations character-by-character.
// NOVA string indexing: s[i:i+1] gives one character; ord() gives its code.

// Parse decimal integer starting at pos; stop at non-digit.
// Returns [value, new_pos].
fn _parse_int(s, pos) -> list
    let slen = len(s)
    let val = 0
    let p = pos
    while p < slen and _is_digit(s, p) == 1
        val = val * 10 + (_ch_ord(s, p) - 48)
        p = p + 1
    [val, p]

// Parse alphabetic abbreviation starting at pos.
// Returns [name_string, new_pos].
fn _parse_abbrev(s, pos) -> list
    let slen = len(s)
    let p = pos
    let name_parts = []
    while p < slen and _is_alpha(s, p) == 1
        push(name_parts, s[p:p + 1])
        p = p + 1
    let name = join(name_parts, "")
    [name, p]

// Parse a POSIX offset field starting at pos.
// Format: [+-]H[:MM]  — POSIX sign convention: positive = WEST.
// Returns [offset_east_secs, new_pos].
fn _parse_offset(s, pos) -> list
    let slen = len(s)
    let p = pos
    let sign = 1
    if p < slen and s[p:p + 1] == "-"
        sign = -1
        p = p + 1
    else if p < slen and s[p:p + 1] == "+"
        p = p + 1
    let hres = _parse_int(s, p)
    let hours = hres[0]
    p = hres[1]
    let mins = 0
    if p < slen and s[p:p + 1] == ":"
        p = p + 1
        let mres = _parse_int(s, p)
        mins = mres[0]
        p = mres[1]
    // POSIX positive = WEST; east = negate.
    let off_east = 0 - sign * (hours * 3600 + mins * 60)
    [off_east, p]

// Parse "Mm.w.d" or "Mm.w.d/H" starting at pos (pos points to 'M').
// Returns [month, week, weekday, local_hour, new_pos].
fn _parse_mwd(s, pos) -> list
    let slen = len(s)
    let p = pos + 1
    let mres = _parse_int(s, p)
    let mo = mres[0]
    p = mres[1]
    if p < slen and s[p:p + 1] == "."
        p = p + 1
    let wres = _parse_int(s, p)
    let wk = wres[0]
    p = wres[1]
    if p < slen and s[p:p + 1] == "."
        p = p + 1
    let dres = _parse_int(s, p)
    let wd = dres[0]
    p = dres[1]
    let hr = 2
    if p < slen and s[p:p + 1] == "/"
        p = p + 1
        let hres = _parse_int(s, p)
        hr = hres[0]
        p = hres[1]
    [mo, wk, wd, hr, p]

// Parse a full POSIX TZ string.
// Returns a dict with all fields needed by the DST engine.
fn _parse_tz(tz_str) -> dict
    let s = tz_str
    let slen = len(s)
    let r = {}
    r["std_name"] = "UTC"
    r["std_off"] = 0
    r["has_dst"] = 0
    r["dst_name"] = ""
    r["dst_off"] = 0
    r["start_m"] = 0
    r["start_w"] = 0
    r["start_d"] = 0
    r["start_h"] = 2
    r["end_m"] = 0
    r["end_w"] = 0
    r["end_d"] = 0
    r["end_h"] = 2
    if slen == 0
        return r
    // Parse std abbreviation.
    let ab1 = _parse_abbrev(s, 0)
    r["std_name"] = ab1[0]
    let p = ab1[1]
    // Parse std offset if present.
    if p < slen
        let ch0 = s[p:p + 1]
        if ch0 == "-" or ch0 == "+" or _is_digit(s, p) == 1
            let op = _parse_offset(s, p)
            r["std_off"] = op[0]
            p = op[1]
    // Check for DST abbreviation.
    if p >= slen
        return r
    if _is_alpha(s, p) == 0
        return r
    let ab2 = _parse_abbrev(s, p)
    r["dst_name"] = ab2[0]
    r["has_dst"] = 1
    p = ab2[1]
    // Parse DST offset if present; otherwise default = std + 3600 (one hour east).
    r["dst_off"] = r["std_off"] + 3600
    if p < slen
        let ch1 = s[p:p + 1]
        if ch1 == "-" or ch1 == "+" or _is_digit(s, p) == 1
            let dp = _parse_offset(s, p)
            r["dst_off"] = dp[0]
            p = dp[1]
    // Parse transition rules (expect ',').
    if p >= slen or s[p:p + 1] != ","
        return r
    p = p + 1
    // Parse start rule Mm.w.d[/H].
    if p < slen and s[p:p + 1] == "M"
        let sm = _parse_mwd(s, p)
        r["start_m"] = sm[0]
        r["start_w"] = sm[1]
        r["start_d"] = sm[2]
        r["start_h"] = sm[3]
        p = sm[4]
    // Expect ','.
    if p >= slen or s[p:p + 1] != ","
        return r
    p = p + 1
    // Parse end rule.
    if p < slen and s[p:p + 1] == "M"
        let em = _parse_mwd(s, p)
        r["end_m"] = em[0]
        r["end_w"] = em[1]
        r["end_d"] = em[2]
        r["end_h"] = em[3]
    r

// ── Zone table ────────────────────────────────────────────────────────────────
// Maps IANA zone names AND raw POSIX strings to their canonical POSIX TZ string.
// If zone is already a valid POSIX string (contains digits or commas), pass through.

fn _zone_posix(zone) -> string
    if zone == "UTC" or zone == "UTC0"
        return "UTC0"
    if zone == "Asia/Kolkata"
        return "IST-5:30"
    if zone == "IST-5:30"
        return "IST-5:30"
    if zone == "Asia/Tokyo" or zone == "JST-9"
        return "JST-9"
    if zone == "America/New_York"
        return "EST5EDT,M3.2.0,M11.1.0"
    if zone == "EST5EDT,M3.2.0,M11.1.0"
        return "EST5EDT,M3.2.0,M11.1.0"
    if zone == "America/Los_Angeles"
        return "PST8PDT,M3.2.0,M11.1.0"
    if zone == "PST8PDT,M3.2.0,M11.1.0"
        return "PST8PDT,M3.2.0,M11.1.0"
    if zone == "America/Chicago"
        return "CST6CDT,M3.2.0,M11.1.0"
    if zone == "CST6CDT,M3.2.0,M11.1.0"
        return "CST6CDT,M3.2.0,M11.1.0"
    if zone == "Europe/London"
        return "GMT0BST,M3.5.0/1,M10.5.0/2"
    if zone == "GMT0BST,M3.5.0/1,M10.5.0/2"
        return "GMT0BST,M3.5.0/1,M10.5.0/2"
    if zone == "Europe/Paris"
        return "CET-1CEST,M3.5.0,M10.5.0/3"
    if zone == "Europe/Berlin"
        return "CET-1CEST,M3.5.0,M10.5.0/3"
    if zone == "CET-1CEST,M3.5.0,M10.5.0/3"
        return "CET-1CEST,M3.5.0,M10.5.0/3"
    if zone == "Australia/Sydney"
        return "AEST-10AEDT,M10.1.0,M4.1.0/3"
    if zone == "AEST-10AEDT,M10.1.0,M4.1.0/3"
        return "AEST-10AEDT,M10.1.0,M4.1.0/3"
    // Unknown zone: UTC.
    "UTC0"

// ── DST transition epoch computation ──────────────────────────────────────────
//
// For a Mm.w.d[/H] rule in a given year:
//   1. Find the day-of-month of the w-th weekday d of month m.
//   2. "Local wall time" = that day at hour H (default 2).
//   3. Convert to UTC by subtracting the offset in effect just BEFORE
//      the transition (std_off for start, dst_off for end).

fn _rule_epoch(y, mo, w, wd, hr, offset_before) -> int
    let dom = _nth_weekday_dom(y, mo, w, wd)
    let base_days = _days_from_civil(y, mo, dom)
    let local_secs = base_days * 86400 + hr * 3600
    local_secs - offset_before

fn _dst_bounds(tz, year) -> list
    let s_ep = _rule_epoch(year, tz["start_m"], tz["start_w"], tz["start_d"], tz["start_h"], tz["std_off"])
    let e_ep = _rule_epoch(year, tz["end_m"], tz["end_w"], tz["end_d"], tz["end_h"], tz["dst_off"])
    [s_ep, e_ep]

// ── is_dst_for_year: 1 if epoch is in DST window for the given calendar year ──

fn _is_dst_for_year(epoch, tz, year) -> int
    if tz["has_dst"] == 0
        return 0
    let bounds = _dst_bounds(tz, year)
    let s = bounds[0]
    let e = bounds[1]
    // Northern hemisphere: DST start < DST end (e.g. Mar < Nov).
    if s < e
        if epoch >= s and epoch < e
            return 1
        return 0
    // Southern hemisphere: start > end (e.g. Oct > Apr), window wraps year-end.
    if epoch >= s or epoch < e
        return 1
    0

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// tz_offset_at: signed seconds east of UTC, DST-aware.
// Unknown zone -> 0 (safe UTC fallback; never crashes).
fn tz_offset_at(epoch, zone) -> int
    let posix = _zone_posix(zone)
    let tz = _parse_tz(posix)
    if tz["has_dst"] == 0
        return tz["std_off"]
    let year = _year_from_epoch(epoch)
    // Check current year first.
    if _is_dst_for_year(epoch, tz, year) == 1
        return tz["dst_off"]
    // Southern-hemisphere zones (start_m > end_m) wrap year-end.
    // An epoch in Jan..Apr of year Y might fall in the Y-1 DST window
    // (Oct Y-1 through Apr Y). Guard: only try Y-1 if the current year's
    // end transition hasn't yet passed (i.e. epoch < end_Y), which means
    // we are in the early-year segment of the southern window.
    if tz["start_m"] > tz["end_m"]
        let b_cur = _dst_bounds(tz, year)
        let e_cur = b_cur[1]
        if epoch < e_cur
            if _is_dst_for_year(epoch, tz, year - 1) == 1
                return tz["dst_off"]
    tz["std_off"]

// tz_to_local: epoch + timezone offset = local wall seconds.
fn tz_to_local(epoch, zone) -> int
    epoch + tz_offset_at(epoch, zone)

// tz_abbrev: abbreviation string ("EST", "EDT", "BST", "IST", "UTC", ...).
fn tz_abbrev(epoch, zone) -> string
    let posix = _zone_posix(zone)
    let tz = _parse_tz(posix)
    if tz["has_dst"] == 0
        return tz["std_name"]
    let year = _year_from_epoch(epoch)
    if _is_dst_for_year(epoch, tz, year) == 1
        return tz["dst_name"]
    if tz["start_m"] > tz["end_m"]
        let b_cur = _dst_bounds(tz, year)
        let e_cur = b_cur[1]
        if epoch < e_cur
            if _is_dst_for_year(epoch, tz, year - 1) == 1
                return tz["dst_name"]
    tz["std_name"]

// tz_next_transition: next DST transition epoch strictly after `epoch`.
// Returns -1 if zone has no DST.
fn tz_next_transition(epoch, zone) -> int
    let posix = _zone_posix(zone)
    let tz = _parse_tz(posix)
    if tz["has_dst"] == 0
        return -1
    let year = _year_from_epoch(epoch)
    let b = _dst_bounds(tz, year)
    let s = b[0]
    let e = b[1]
    // Return the nearest future transition from this year.
    if s > epoch and e > epoch
        if s < e
            return s
        return e
    if s > epoch
        return s
    if e > epoch
        return e
    // Both in the past — look at next year.
    let b2 = _dst_bounds(tz, year + 1)
    let s2 = b2[0]
    let e2 = b2[1]
    if s2 < e2
        return s2
    if e2 < s2
        return e2
    s2
