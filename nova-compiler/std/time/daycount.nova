// ============================================================================
// NOVA Standard Library — std/time/daycount
// Day-count conventions for finance and actuarial calculations.
// Pure integer arithmetic — no floats, no libc date calls.
// ============================================================================
//
// PUBLIC API:
//   dc_30_360(y1,m1,d1, y2,m2,d2)        -> int  US 30/360 (Bond Basis) day count
//   dc_act_365(y1,m1,d1, y2,m2,d2)       -> int  Actual/365 (Fixed) day count
//   dc_act_360_frac_bp(y1,m1,d1, y2,m2,d2) -> int  Actual/360 year fraction in basis points
//   dc_year_frac_30_360_bp(y1,m1,d1, y2,m2,d2) -> int  30/360 year fraction in basis points
//
// CONVENTIONS:
//   dc_30_360 : US (ISDA) 30/360 — "Bond Basis".
//     Rule: if D1=31 set D1=30; if D2=31 and D1=30 set D2=30.
//     Days = (Y2-Y1)*360 + (M2-M1)*30 + (D2-D1).
//     Invalid day-of-month inputs are clamped to the month's last valid day
//     before applying the 30/360 adjustments.
//
//   dc_act_365 : Actual/365 Fixed — counts exact calendar days (uses Howard
//     Hinnant proleptic Gregorian epoch arithmetic).  The "year fraction" is
//     NOT computed here; callers wanting the fraction multiply by 10000 and
//     divide by 365 themselves.  This function returns the raw day count
//     (same numerator as Actual/365 and Actual/Actual in most cases).
//
//   dc_act_360_frac_bp : Actual/360 year fraction × 10000 (basis points).
//     Formula: (actual_days * 10000) / 360.
//
//   dc_year_frac_30_360_bp : 30/360 year fraction × 10000 (basis points).
//     Formula: (dc_30_360_days * 10000) / 360.
//
// All inputs must satisfy year >= 1 (proleptic Gregorian). Safe for 1970..2100.
// Returns 0 (not negative) when the end date precedes the start date.
// ============================================================================

// ── Howard Hinnant proleptic Gregorian helpers ────────────────────────────
// days_from_civil: days since 1970-01-01 for date (y, m, d). Exact integer.

fn _days_from_civil(y, m, d)
    let yy = y
    if m <= 2
        yy -= 1
    let era = yy / 400
    let yoe = yy - era * 400
    let mp = m + 9
    if m > 2
        mp = m - 3
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

// _is_leap: true iff year y is a leap year (proleptic Gregorian).
fn _is_leap(y)
    if y % 400 == 0
        return true
    if y % 100 == 0
        return false
    return y % 4 == 0

// _month_days: number of days in month m of year y (1..12).
fn _month_days(y, m)
    if m == 2
        if _is_leap(y)
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11
        return 30
    return 31

// _clamp_day: clamp d to 1.._month_days(y,m). Ensures a valid calendar day.
fn _clamp_day(y, m, d)
    let mx = _month_days(y, m)
    if d < 1
        return 1
    if d > mx
        return mx
    return d

// ── US 30/360 (Bond Basis / ISDA) implementation ─────────────────────────
//
// Algorithm (ISDA 2006 Definitions, Section 4.16(f)):
//   1. Clamp d1 and d2 to valid calendar days for their respective months.
//   2. If D1 = 31, set D1 = 30.
//   3. If D2 = 31 AND D1 = 30, set D2 = 30.
//   4. Return (Y2-Y1)*360 + (M2-M1)*30 + (D2-D1).
//
// Note: result can be negative if end < start (month adjustment can produce
// a negative day component). Callers are responsible for ordering.

fn dc_30_360(y1, m1, d1, y2, m2, d2)
    let dd1 = _clamp_day(y1, m1, d1)
    let dd2 = _clamp_day(y2, m2, d2)
    if dd1 == 31
        dd1 = 30
    if dd2 == 31 and dd1 == 30
        dd2 = 30
    return (y2 - y1) * 360 + (m2 - m1) * 30 + (dd2 - dd1)

// ── Actual day count (shared numerator for Act/365 and Act/360) ───────────
//
// Returns exact calendar days from (y1,m1,d1) to (y2,m2,d2).
// Uses Howard Hinnant epoch arithmetic — exact, no overflow for 1970..2100.
// Returns 0 when end <= start (non-negative convention).

fn _actual_days(y1, m1, d1, y2, m2, d2)
    let a = _days_from_civil(y1, m1, d1)
    let b = _days_from_civil(y2, m2, d2)
    let diff = b - a
    if diff < 0
        return 0
    return diff

// ── PUBLIC: dc_act_365 ────────────────────────────────────────────────────
//
// Actual/365 Fixed: returns the exact number of calendar days between the
// two dates.  (The year fraction is actual_days / 365 — callers compute
// that themselves if needed.)  Returns 0 when end <= start.

fn dc_act_365(y1, m1, d1, y2, m2, d2)
    return _actual_days(y1, m1, d1, y2, m2, d2)

// ── PUBLIC: dc_act_360_frac_bp ────────────────────────────────────────────
//
// Actual/360 year fraction in basis points: (actual_days * 10000) / 360.
// Integer truncation toward zero (floor for positive results).
// Returns 0 when end <= start.

fn dc_act_360_frac_bp(y1, m1, d1, y2, m2, d2)
    let days = _actual_days(y1, m1, d1, y2, m2, d2)
    return (days * 10000) / 360

// ── PUBLIC: dc_year_frac_30_360_bp ───────────────────────────────────────
//
// 30/360 year fraction in basis points: (dc_30_360_days * 10000) / 360.
// Integer truncation toward zero.
// Returns 0 when the 30/360 day count is <= 0.

fn dc_year_frac_30_360_bp(y1, m1, d1, y2, m2, d2)
    let days = dc_30_360(y1, m1, d1, y2, m2, d2)
    if days <= 0
        return 0
    return (days * 10000) / 360
