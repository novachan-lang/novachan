// ============================================================================
// NOVA Standard Library — std/time/quarter
// Calendar and fiscal quarter arithmetic.  Pure integer math, no libc calls.
// All private day-serial helpers use Howard Hinnant's proleptic-Gregorian algo.
// ============================================================================
//
// PUBLIC API:
//   quarter_of(m)                      -> int  (1..4)  calendar quarter for month m
//   quarter_of_date(y,m,d)             -> int  (1..4)  calendar quarter for full date
//   quarter_start(y,q)                 -> list [y,m,d] first day of calendar quarter q
//   quarter_end(y,q)                   -> list [y,m,d] last day of calendar quarter q
//   fiscal_quarter(m, fiscal_start_month) -> int (1..4) quarter within fiscal year
//
// NOTES:
//   Calendar quarters: Q1=Jan-Mar, Q2=Apr-Jun, Q3=Jul-Sep, Q4=Oct-Dec.
//   Fiscal quarter: Q1 begins at fiscal_start_month; the year wraps at month 13.
//   Month inputs: 1..12.  Quarter inputs: 1..4.  Invalid inputs clamp safely.
//   Valid for years 1..9999 (keep KAT dates in 1970..2100 for full coverage).

// ── Private: Howard Hinnant day serial ───────────────────────────────────────
// days = days since 1970-01-01 (proleptic Gregorian; negative before 1970).

fn _days_from_civil(y, m, d)
    let yy = y
    if m <= 2
        yy = yy - 1
    let era = yy / 400
    let yoe = yy - era * 400
    let mp = m + 9
    if m > 2
        mp = m - 3
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

fn _civil_from_days(z0)
    let z = z0 + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if mp >= 10
        m = mp - 9
    if m <= 2
        y = y + 1
    return [y, m, d]

fn _is_leap(y)
    if y % 400 == 0
        return true
    if y % 100 == 0
        return false
    return y % 4 == 0

// ── Private: last day of a given month ───────────────────────────────────────

fn _month_days(y, m)
    if m == 2
        if _is_leap(y)
            return 29
        return 28
    if m == 4
        return 30
    if m == 6
        return 30
    if m == 9
        return 30
    if m == 11
        return 30
    return 31

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// quarter_of: calendar quarter (1..4) for month m (1..12).
// Clamps m to 1..12 for safety.
fn quarter_of(m) -> int
    let sm = m
    if sm < 1
        sm = 1
    if sm > 12
        sm = 12
    return (sm - 1) / 3 + 1

// quarter_of_date: calendar quarter (1..4) for full date (y,m,d).
fn quarter_of_date(y, m, d) -> int
    return quarter_of(m)

// quarter_start: first day of calendar quarter q in year y.
// q clamped to 1..4.
fn quarter_start(y, q) -> list
    let sq = q
    if sq < 1
        sq = 1
    if sq > 4
        sq = 4
    let sm = (sq - 1) * 3 + 1
    return [y, sm, 1]

// quarter_end: last day of calendar quarter q in year y.
// q clamped to 1..4.
fn quarter_end(y, q) -> list
    let sq = q
    if sq < 1
        sq = 1
    if sq > 4
        sq = 4
    let em = sq * 3
    let ed = _month_days(y, em)
    return [y, em, ed]

// fiscal_quarter: quarter (1..4) within a fiscal year whose Q1 begins at
// fiscal_start_month (1..12).  Month m is the calendar month (1..12).
// Example: fiscal_start_month=4 means Q1=Apr-Jun, Q2=Jul-Sep, Q3=Oct-Dec, Q4=Jan-Mar.
fn fiscal_quarter(m, fiscal_start_month) -> int
    let sm = fiscal_start_month
    if sm < 1
        sm = 1
    if sm > 12
        sm = 12
    let cm = m
    if cm < 1
        cm = 1
    if cm > 12
        cm = 12
    // Shift so that fiscal Q1 start maps to offset 0.
    let offset = cm - sm
    if offset < 0
        offset = offset + 12
    return offset / 3 + 1
