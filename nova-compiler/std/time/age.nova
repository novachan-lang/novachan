// ============================================================================
// NOVA Standard Library — std/time/age
// Age / years-between / next-birthday / zodiac sign.
// Pure integer arithmetic, no floats, no libc calls.
// All calendar math uses Howard Hinnant's proleptic-Gregorian algorithm.
// ============================================================================
//
// PUBLIC API:
//   age_years(by,bm,bd, ny,nm,nd)          -> int    completed years from birth to now
//   age_next_birthday(by,bm,bd, ny,nm,nd)  -> list   [y,m,d] of next birthday on/after now
//   age_days_until_birthday(by,bm,bd, ny,nm,nd) -> int  calendar days until next birthday
//   age_zodiac(m,d)                        -> string  western sun sign
//
// NOTES:
//   Birth leap-day (Feb 29): anniversary treated as Feb 28 in non-leap years.
//   All dates proleptic Gregorian, years >= 1.
//   "now" parameters (ny,nm,nd) are the current calendar date in local time —
//   the caller is responsible for obtaining them from the system clock.

// ── Private: Howard Hinnant day serial ───────────────────────────────────────
// days = days since 1970-01-01 (truncating integer division, valid y >= 1)

fn _days_from_civil(y, m, d)
    let yy = y
    if m <= 2
        yy = yy - 1
    let era = yy / 400
    let yoe = yy - era * 400
    let mp = m + 9
    if m > 2
        mp = m - 3
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

fn _civil_from_days(z0)
    let z = z0 + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if mp >= 10
        m = mp - 9
    if m <= 2
        y = y + 1
    return [y, m, d]

fn _is_leap(y)
    if y % 400 == 0
        return true
    if y % 100 == 0
        return false
    return y % 4 == 0

// ── Private: days-in-month (for clamping Feb 29 birthdays) ───────────────────

fn _days_in_month(y, m)
    if m == 2
        if _is_leap(y)
            return 29
        return 28
    if m == 4
        return 30
    if m == 6
        return 30
    if m == 9
        return 30
    if m == 11
        return 30
    return 31

// ── Private: clamp birthday day to valid day in target month/year ─────────────
// Handles Feb 29 birthdays in non-leap years → Feb 28.

fn _clamp_day(y, m, d)
    let dim = _days_in_month(y, m)
    if d > dim
        return dim
    return d

// ── Private: anniversary date in a given year ─────────────────────────────────
// Returns [y, bm, safe_day] where safe_day is clamped for non-leap years.

fn _anniversary_in_year(by, bm, bd, target_year)
    let safe_d = _clamp_day(target_year, bm, bd)
    return [target_year, bm, safe_d]

// ── Private: compare two dates; returns -1, 0, or 1 ─────────────────────────

fn _date_cmp(y1, m1, d1, y2, m2, d2)
    if y1 < y2
        return -1
    if y1 > y2
        return 1
    if m1 < m2
        return -1
    if m1 > m2
        return 1
    if d1 < d2
        return -1
    if d1 > d2
        return 1
    return 0

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// age_years: completed whole years from birth (by,bm,bd) to now (ny,nm,nd).
// Returns 0 if birth date equals now date.
// Returns -1 if now is before birth (caller should validate).
fn age_years(by, bm, bd, ny, nm, nd) -> int
    if _date_cmp(ny, nm, nd, by, bm, bd) < 0
        return -1
    // Candidate: calendar year difference
    let years = ny - by
    // Check whether the anniversary in ny has passed or not yet
    let ann = _anniversary_in_year(by, bm, bd, ny)
    let ann_y = ann[0]
    let ann_m = ann[1]
    let ann_d = ann[2]
    if _date_cmp(ny, nm, nd, ann_y, ann_m, ann_d) < 0
        // Birthday not yet reached this year
        years = years - 1
    return years

// age_next_birthday: the date of the next birthday on or after (ny,nm,nd).
// If today IS the birthday, returns today.
fn age_next_birthday(by, bm, bd, ny, nm, nd) -> list
    // Try anniversary in current year
    let ann = _anniversary_in_year(by, bm, bd, ny)
    let ann_y = ann[0]
    let ann_m = ann[1]
    let ann_d = ann[2]
    if _date_cmp(ny, nm, nd, ann_y, ann_m, ann_d) <= 0
        // Birthday is today or still in the future this year
        return [ann_y, ann_m, ann_d]
    // Birthday already passed this year; return next year's anniversary
    let next_ann = _anniversary_in_year(by, bm, bd, ny + 1)
    return next_ann

// age_days_until_birthday: calendar days from (ny,nm,nd) until the next
// birthday.  Returns 0 if today is the birthday.
fn age_days_until_birthday(by, bm, bd, ny, nm, nd) -> int
    let nb = age_next_birthday(by, bm, bd, ny, nm, nd)
    let nb_y = nb[0]
    let nb_m = nb[1]
    let nb_d = nb[2]
    let d_now = _days_from_civil(ny, nm, nd)
    let d_bday = _days_from_civil(nb_y, nb_m, nb_d)
    return d_bday - d_now

// age_zodiac: western sun sign for calendar month m and day d.
// Uses fixed Gregorian cutoff dates (Tropical / Western astrology convention).
// Returns "Unknown" for invalid inputs.
fn age_zodiac(m, d) -> string
    if m < 1
        return "Unknown"
    if m > 12
        return "Unknown"
    if d < 1
        return "Unknown"
    if d > 31
        return "Unknown"
    // Aries:       Mar 21 – Apr 19
    if m == 3
        if d >= 21
            return "Aries"
        return "Pisces"
    if m == 4
        if d <= 19
            return "Aries"
        return "Taurus"
    // Taurus:      Apr 20 – May 20
    if m == 5
        if d <= 20
            return "Taurus"
        return "Gemini"
    // Gemini:      May 21 – Jun 20
    if m == 6
        if d <= 20
            return "Gemini"
        return "Cancer"
    // Cancer:      Jun 21 – Jul 22
    if m == 7
        if d <= 22
            return "Cancer"
        return "Leo"
    // Leo:         Jul 23 – Aug 22
    if m == 8
        if d <= 22
            return "Leo"
        return "Virgo"
    // Virgo:       Aug 23 – Sep 22
    if m == 9
        if d <= 22
            return "Virgo"
        return "Libra"
    // Libra:       Sep 23 – Oct 22
    if m == 10
        if d <= 22
            return "Libra"
        return "Scorpio"
    // Scorpio:     Oct 23 – Nov 21
    if m == 11
        if d <= 21
            return "Scorpio"
        return "Sagittarius"
    // Sagittarius: Nov 22 – Dec 21
    if m == 12
        if d <= 21
            return "Sagittarius"
        return "Capricorn"
    // Capricorn:   Dec 22 – Jan 19
    if m == 1
        if d <= 19
            return "Capricorn"
        return "Aquarius"
    // Aquarius:    Jan 20 – Feb 18
    if m == 2
        if d <= 18
            return "Aquarius"
        return "Pisces"
    // Pisces:      Feb 19 – Mar 20 (handled above)
    return "Unknown"
