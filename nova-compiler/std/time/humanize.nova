// ============================================================================
// NOVA Standard Library — std/time/humanize
// Relative time phrasing from a delta-seconds integer.
// ============================================================================
//
// PUBLIC API:
//   hz_relative(delta_seconds) -> string
//       delta = now - then (positive = PAST, negative = FUTURE)
//
// BUCKETS (past / |delta|):
//   < 10           -> "just now"
//   < 60           -> "N second(s) ago"
//   < 3600         -> "N minute(s) ago"
//   < 86400        -> "N hour(s) ago"
//   < 2592000      -> "N day(s) ago"
//   else           -> "N month(s) ago"   (month = 2592000 s = 30 days)
//
// FUTURE mirror (delta < 0):
//   < 10           -> "just now"
//   else           -> "in N unit(s)"
//
// Singular/plural: N==1 -> "second", N>1 -> "seconds" (same pattern for all units).
//
// EXAMPLES:
//   hz_relative(5)       -> "just now"
//   hz_relative(1)       -> "just now"
//   hz_relative(90)      -> "1 minute ago"
//   hz_relative(120)     -> "2 minutes ago"
//   hz_relative(3600)    -> "1 hour ago"
//   hz_relative(7200)    -> "2 hours ago"
//   hz_relative(86400)   -> "1 day ago"
//   hz_relative(-3600)   -> "in 1 hour"
//   hz_relative(-172800) -> "in 2 days"
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _hz_plural: return "N unit" or "N units" correctly.
fn _hz_plural(n, unit) -> string
    if n == 1
        return str(n) + " " + unit
    str(n) + " " + unit + "s"

// _hz_past_phrase: build the "N unit(s) ago" or "just now" string for past.
fn _hz_past_phrase(abs_delta) -> string
    if abs_delta < 10
        return "just now"
    if abs_delta < 60
        return _hz_plural(abs_delta, "second") + " ago"
    if abs_delta < 3600
        let mins = abs_delta / 60
        return _hz_plural(mins, "minute") + " ago"
    if abs_delta < 86400
        let hrs = abs_delta / 3600
        return _hz_plural(hrs, "hour") + " ago"
    if abs_delta < 2592000
        let days = abs_delta / 86400
        return _hz_plural(days, "day") + " ago"
    let months = abs_delta / 2592000
    _hz_plural(months, "month") + " ago"

// _hz_future_phrase: build the "in N unit(s)" or "just now" string for future.
fn _hz_future_phrase(abs_delta) -> string
    if abs_delta < 10
        return "just now"
    if abs_delta < 60
        return "in " + _hz_plural(abs_delta, "second")
    if abs_delta < 3600
        let mins = abs_delta / 60
        return "in " + _hz_plural(mins, "minute")
    if abs_delta < 86400
        let hrs = abs_delta / 3600
        return "in " + _hz_plural(hrs, "hour")
    if abs_delta < 2592000
        let days = abs_delta / 86400
        return "in " + _hz_plural(days, "day")
    let months = abs_delta / 2592000
    "in " + _hz_plural(months, "month")

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// hz_relative: convert delta_seconds (now - then) to a human-readable phrase.
// positive delta = event is in the past; negative = event is in the future.
fn hz_relative(delta_seconds) -> string
    if delta_seconds >= 0
        return _hz_past_phrase(delta_seconds)
    let abs_delta = -delta_seconds
    _hz_future_phrase(abs_delta)
