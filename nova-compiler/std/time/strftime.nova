// ============================================================================
// NOVA Standard Library — std/time/strftime
// strftime-style formatting from a Unix epoch (UTC seconds, integer).
// Pure integer arithmetic — no floats, no bytes.
// All private helpers use the _sf_ prefix to avoid collisions with other
// std/time modules (_fdiv/_fmod/_pad2/etc. in datetime.nova).
// ============================================================================
//
// PUBLIC API:
//   dt_strftime(epoch, pattern) -> string
//       Format a UTC epoch using a strftime-compatible pattern.
//       Supported directives:
//         %Y  4-digit year (zero-padded)
//         %m  2-digit month (01..12)
//         %d  2-digit day   (01..31)
//         %H  2-digit hour  (00..23, 24-hour)
//         %M  2-digit minute (00..59)
//         %S  2-digit second (00..59)
//         %A  full weekday name (Sunday..Saturday)
//         %a  abbreviated weekday (Sun..Sat)
//         %B  full month name (January..December)
//         %b  abbreviated month (Jan..Dec)
//         %j  day-of-year, 3-digit zero-padded (001..366)
//         %w  weekday digit (0=Sunday..6=Saturday)
//         %p  AM or PM (based on 24-hour hour)
//         %I  12-hour clock hour, 2-digit zero-padded (01..12)
//         %%  literal percent sign
//       Unknown directives are passed through unchanged.
//
//   dt_from_ymdhms(y, m, d, hh, mm, ss) -> int
//       Build a UTC epoch (int, seconds) from calendar components.
//       Uses Howard Hinnant's algorithm. Valid for years >= 1.
//
// ALGORITHM: Howard Hinnant's civil_from_days / days_from_civil.
// Integer division in NOVA truncates toward zero (like C).
// These helpers only call on positive denominators so truncation == floor
// for all KAT dates in range 1970..2100.

// ── Floor-division helpers ────────────────────────────────────────────────────
// For positive-only denominators (which is ALL our use here) NOVA truncation
// equals floor division, so we can use plain / and %.  All calls below use
// positive divisors; the helpers below are named _sf_fdiv / _sf_fmod for
// completeness but are identical to their datetime.nova counterparts.

fn _sf_fdiv(a, b) -> int
    let q = a / b
    if (a < 0) != (b < 0)
        if a - q * b != 0
            return q - 1
    q

fn _sf_fmod(a, b) -> int
    a - b * _sf_fdiv(a, b)

// ── Calendar helpers (Howard Hinnant) ────────────────────────────────────────

fn _sf_days_from_civil(y0, m, d) -> int
    let y = y0
    if m <= 2
        y = y - 1
    let era = _sf_fdiv(y, 400)
    let yoe = y - era * 400
    let mp = m - 3
    if m <= 2
        mp = m + 9
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

fn _sf_civil_from_days(z0) -> list
    let z = z0 + 719468
    let era = _sf_fdiv(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = mp + 3
    if mp >= 10
        m = mp - 9
    if m <= 2
        y = y + 1
    [y, m, d]

// ── String padding helpers ────────────────────────────────────────────────────

fn _sf_pad2(n) -> string
    if n < 10
        return "0" + str(n)
    str(n)

fn _sf_pad3(n) -> string
    if n < 10
        return "00" + str(n)
    if n < 100
        return "0" + str(n)
    str(n)

fn _sf_pad4(n) -> string
    if n < 10
        return "000" + str(n)
    if n < 100
        return "00" + str(n)
    if n < 1000
        return "0" + str(n)
    str(n)

// ── Name tables ──────────────────────────────────────────────────────────────

fn _sf_weekday_full(w) -> string
    if w == 0
        return "Sunday"
    if w == 1
        return "Monday"
    if w == 2
        return "Tuesday"
    if w == 3
        return "Wednesday"
    if w == 4
        return "Thursday"
    if w == 5
        return "Friday"
    "Saturday"

fn _sf_weekday_abbr(w) -> string
    if w == 0
        return "Sun"
    if w == 1
        return "Mon"
    if w == 2
        return "Tue"
    if w == 3
        return "Wed"
    if w == 4
        return "Thu"
    if w == 5
        return "Fri"
    "Sat"

fn _sf_month_full(m) -> string
    if m == 1
        return "January"
    if m == 2
        return "February"
    if m == 3
        return "March"
    if m == 4
        return "April"
    if m == 5
        return "May"
    if m == 6
        return "June"
    if m == 7
        return "July"
    if m == 8
        return "August"
    if m == 9
        return "September"
    if m == 10
        return "October"
    if m == 11
        return "November"
    "December"

fn _sf_month_abbr(m) -> string
    if m == 1
        return "Jan"
    if m == 2
        return "Feb"
    if m == 3
        return "Mar"
    if m == 4
        return "Apr"
    if m == 5
        return "May"
    if m == 6
        return "Jun"
    if m == 7
        return "Jul"
    if m == 8
        return "Aug"
    if m == 9
        return "Sep"
    if m == 10
        return "Oct"
    if m == 11
        return "Nov"
    "Dec"

// ── Epoch decomposition ───────────────────────────────────────────────────────
// Returns a dict with year, month, day, hour, min, sec, weekday (0=Sun), yday.

fn _sf_from_epoch(epoch) -> dict
    let days = _sf_fdiv(epoch, 86400)
    let rem = _sf_fmod(epoch, 86400)
    let ymd = _sf_civil_from_days(days)
    let yr = ymd[0]
    let jan1 = _sf_days_from_civil(yr, 1, 1)
    let yday = days - jan1 + 1
    // 1970-01-01 was Thursday (weekday 4); floor-mod to handle negatives.
    let wd = _sf_fmod(_sf_fmod(days, 7) + 4 + 7, 7)
    let r = {}
    r["year"] = yr
    r["month"] = ymd[1]
    r["day"] = ymd[2]
    r["hour"] = rem / 3600
    r["min"] = (rem % 3600) / 60
    r["sec"] = rem % 60
    r["weekday"] = wd
    r["yday"] = yday
    r

// ── PUBLIC API ────────────────────────────────────────────────────────────────

// dt_from_ymdhms: Build a UTC epoch from calendar components.
// Uses Howard Hinnant's days_from_civil.  Valid for years >= 1.
fn dt_from_ymdhms(y, m, d, hh, mm, ss) -> int
    _sf_days_from_civil(y, m, d) * 86400 + hh * 3600 + mm * 60 + ss

// dt_strftime: Format epoch according to strftime-compatible pattern.
// Walks the pattern byte-by-byte; on '%' reads the next char as directive.
// Returns the formatted string.
fn dt_strftime(epoch, pattern) -> string
    let r = _sf_from_epoch(epoch)
    let yr = r["year"]
    let mo = r["month"]
    let dy = r["day"]
    let hh = r["hour"]
    let mi = r["min"]
    let ss = r["sec"]
    let wd = r["weekday"]
    let yd = r["yday"]
    let out = ""
    let plen = len(pattern)
    let i = 0
    while i < plen
        let ch = pattern[i:i+1]
        if ch == "%"
            let ni = i + 1
            if ni < plen
                let dir = pattern[ni:ni+1]
                if dir == "Y"
                    out = out + _sf_pad4(yr)
                else if dir == "m"
                    out = out + _sf_pad2(mo)
                else if dir == "d"
                    out = out + _sf_pad2(dy)
                else if dir == "H"
                    out = out + _sf_pad2(hh)
                else if dir == "M"
                    out = out + _sf_pad2(mi)
                else if dir == "S"
                    out = out + _sf_pad2(ss)
                else if dir == "A"
                    out = out + _sf_weekday_full(wd)
                else if dir == "a"
                    out = out + _sf_weekday_abbr(wd)
                else if dir == "B"
                    out = out + _sf_month_full(mo)
                else if dir == "b"
                    out = out + _sf_month_abbr(mo)
                else if dir == "j"
                    out = out + _sf_pad3(yd)
                else if dir == "w"
                    out = out + str(wd)
                else if dir == "p"
                    if hh < 12
                        out = out + "AM"
                    else
                        out = out + "PM"
                else if dir == "I"
                    let h12 = hh % 12
                    if h12 == 0
                        h12 = 12
                    out = out + _sf_pad2(h12)
                else if dir == "%"
                    out = out + "%"
                else
                    out = out + "%" + dir
                i = ni + 1
            else
                out = out + "%"
                i = i + 1
        else
            out = out + ch
            i = i + 1
    out
