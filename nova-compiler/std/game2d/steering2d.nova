// std/game2d/steering2d.nova -- 2D steering behaviors (seek/flee/arrive/pursue).
// Vectors are [x,y] float lists.  NO trigonometry; uses sqrt for length.
// All float sub-expressions bound to named lets to avoid uninit-float-slot bug.
// LEAF -- imports nothing.
//
// Public API (prefix st_):
//   st_length(x,y)                         -> float  magnitude of vector (x,y)
//   st_normalize(x,y)                      -> any    unit vector; [0,0] if zero
//   st_limit(x,y, max)                     -> any    cap vector magnitude to max
//   st_scale(x,y, s)                       -> any    multiply vector by scalar s
//   st_dist(x1,y1, x2,y2)                  -> float  Euclidean distance
//   st_seek(px,py, vx,vy, tx,ty, max_speed) -> any   desired velocity toward target
//   st_flee(px,py, tx,ty, max_speed)        -> any   desired velocity away from target
//   st_arrive(px,py, tx,ty, max_speed, slow_radius) -> any  seek with slow-down zone
//   st_pursue(px,py, tx,ty, tvx,tvy, max_speed)     -> any  seek predicted target position

// _st_absf -- float absolute value helper.
fn _st_absf(v: float) -> float
    if v < 0.0
        return 0.0 - v
    v

// st_length -- Euclidean magnitude of vector (x,y).
fn st_length(x: float, y: float) -> float
    let xx = x * x
    let yy = y * y
    let s = xx + yy
    let r = sqrt(s)
    r

// st_normalize -- unit vector of (x,y); returns [0.0, 0.0] for zero vector.
fn st_normalize(x: float, y: float) -> any
    let xx = x * x
    let yy = y * y
    let s = xx + yy
    let len = sqrt(s)
    let result = []
    if len <= 0.0
        push(result, 0.0)
        push(result, 0.0)
        return result
    let nx = x / len
    let ny = y / len
    push(result, nx)
    push(result, ny)
    result

// st_limit -- cap vector (x,y) to magnitude max; returns scaled list [vx,vy].
fn st_limit(x: float, y: float, max: float) -> any
    let xx = x * x
    let yy = y * y
    let s = xx + yy
    let len = sqrt(s)
    let result = []
    if len <= max
        push(result, x)
        push(result, y)
        return result
    let scale = max / len
    let nx = x * scale
    let ny = y * scale
    push(result, nx)
    push(result, ny)
    result

// st_scale -- multiply vector (x,y) by scalar s; returns [sx, sy].
fn st_scale(x: float, y: float, s: float) -> any
    let rx = x * s
    let ry = y * s
    let result = []
    push(result, rx)
    push(result, ry)
    result

// st_dist -- Euclidean distance between (x1,y1) and (x2,y2).
fn st_dist(x1: float, y1: float, x2: float, y2: float) -> float
    let dx = x2 - x1
    let dy = y2 - y1
    let dxdx = dx * dx
    let dydy = dy * dy
    let s = dxdx + dydy
    let r = sqrt(s)
    r

// st_seek -- desired velocity toward target (tx,ty) at up to max_speed.
// Ignores current velocity vx,vy (desired = normalized direction * max_speed).
fn st_seek(px: float, py: float, vx: float, vy: float, tx: float, ty: float, max_speed: float) -> any
    let dx = tx - px
    let dy = ty - py
    let dxdx = dx * dx
    let dydy = dy * dy
    let s = dxdx + dydy
    let len = sqrt(s)
    let result = []
    if len <= 0.0
        push(result, 0.0)
        push(result, 0.0)
        return result
    let scale = max_speed / len
    let rx = dx * scale
    let ry = dy * scale
    push(result, rx)
    push(result, ry)
    result

// st_flee -- desired velocity away from target (tx,ty) at max_speed.
fn st_flee(px: float, py: float, tx: float, ty: float, max_speed: float) -> any
    let dx = px - tx
    let dy = py - ty
    let dxdx = dx * dx
    let dydy = dy * dy
    let s = dxdx + dydy
    let len = sqrt(s)
    let result = []
    if len <= 0.0
        push(result, 0.0)
        push(result, 0.0)
        return result
    let scale = max_speed / len
    let rx = dx * scale
    let ry = dy * scale
    push(result, rx)
    push(result, ry)
    result

// st_arrive -- seek with deceleration inside slow_radius.
// When dist > slow_radius: full max_speed; inside slow_radius: speed = max_speed * dist / slow_radius.
fn st_arrive(px: float, py: float, tx: float, ty: float, max_speed: float, slow_radius: float) -> any
    let dx = tx - px
    let dy = ty - py
    let dxdx = dx * dx
    let dydy = dy * dy
    let s = dxdx + dydy
    let dist = sqrt(s)
    let result = []
    if dist <= 0.0
        push(result, 0.0)
        push(result, 0.0)
        return result
    let speed = max_speed
    if dist < slow_radius
        speed = max_speed * dist / slow_radius
    let scale = speed / dist
    let rx = dx * scale
    let ry = dy * scale
    push(result, rx)
    push(result, ry)
    result

// st_pursue -- seek the predicted future position of a moving target.
// Prediction time = distance / max_speed; predicted pos = target + tvx*t, tvy*t.
fn st_pursue(px: float, py: float, tx: float, ty: float, tvx: float, tvy: float, max_speed: float) -> any
    let dx = tx - px
    let dy = ty - py
    let dxdx = dx * dx
    let dydy = dy * dy
    let s = dxdx + dydy
    let dist = sqrt(s)
    let t = 0.0
    if max_speed > 0.0
        t = dist / max_speed
    let ptx = tx + tvx * t
    let pty = ty + tvy * t
    let ddx = ptx - px
    let ddy = pty - py
    let ddxddx = ddx * ddx
    let ddyddy = ddy * ddy
    let ps = ddxddx + ddyddy
    let plen = sqrt(ps)
    let result = []
    if plen <= 0.0
        push(result, 0.0)
        push(result, 0.0)
        return result
    let scale = max_speed / plen
    let rx = ddx * scale
    let ry = ddy * scale
    push(result, rx)
    push(result, ry)
    result
