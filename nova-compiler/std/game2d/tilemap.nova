// std/game2d/tilemap.nova — 2D tilemap storage and queries.
//
// Tilemap: dict {w, h, tilesize, tiles} where tiles is a flat row-major list
// of ints.  Cell (tx,ty) -> tiles[ty*w+tx].  0 = passable; non-zero = solid.
// World coordinates: tile (tx,ty) occupies world rect [tx*ts, ty*ts, ts, ts].
//
// No trigonometry; no higher-order functions.
//
// Public API (prefix tm_):
//   tm_new(w,h,tilesize,fill)          -> any   new tilemap filled with fill
//   tm_get(map,tx,ty)                  -> int   tile value at (tx,ty)
//   tm_set(map,tx,ty,v)                -> any   set tile; returns map
//   tm_in_bounds(map,tx,ty)            -> bool
//   tm_world_to_tile(map,wx,wy)        -> any   [tx,ty] via floor(w/ts)
//   tm_tile_to_world(map,tx,ty)        -> any   top-left world [x,y] of tile
//   tm_is_solid(map,tx,ty)             -> bool  tile value != 0
//   tm_solid_at_world(map,wx,wy)       -> bool  is the world point in a solid tile?
//   tm_neighbors4(map,tx,ty)           -> any   list of [tx,ty] in-bounds 4-neighbors
//   tm_tile_bounds(map,tx,ty)          -> any   AABB [wx,wy,tilesize,tilesize]
//   tm_fill_rect(map,tx,ty,tw,th,v)    -> any   fill a rect of tiles with value v
//   tm_count(map,v)                    -> int   count tiles with value == v

// ── Construction ───────────────────────────────────────────────────────────────

// tm_new: create a new w×h tilemap with all cells set to fill.
fn tm_new(w, h, tilesize, fill)
    let total = w * h
    let tiles = [fill for i in 0..total]
    let m = {}
    m["w"] = w
    m["h"] = h
    m["tilesize"] = tilesize
    m["tiles"] = tiles
    return m

// ── Basic accessors ────────────────────────────────────────────────────────────

// tm_in_bounds: true if (tx,ty) is within the map's tile extents.
fn tm_in_bounds(map, tx, ty)
    let w = map["w"]
    let h = map["h"]
    if tx < 0 or tx >= w
        return false
    if ty < 0 or ty >= h
        return false
    return true

// tm_get: return the tile value at (tx,ty). Returns 0 if out of bounds.
fn tm_get(map, tx, ty)
    let inb = tm_in_bounds(map, tx, ty)
    if not inb
        return 0
    let w = map["w"]
    let tiles = map["tiles"]
    let idx = ty * w + tx
    return tiles[idx]

// tm_set: set tile at (tx,ty) to v. No-op if out of bounds. Returns map.
fn tm_set(map, tx, ty, v)
    let inb = tm_in_bounds(map, tx, ty)
    if not inb
        return map
    let w = map["w"]
    let tiles = map["tiles"]
    let idx = ty * w + tx
    tiles[idx] = v
    return map

// ── Coordinate conversion ─────────────────────────────────────────────────────

// tm_world_to_tile: convert world coordinates to tile coordinates via floor division.
// Uses the floor() builtin which returns int (floor toward -infinity).
fn tm_world_to_tile(map, wx, wy)
    let ts = map["tilesize"]
    let fts = ts * 1.0
    let fwx = wx * 1.0
    let fwy = wy * 1.0
    let tx_f = fwx / fts
    let ty_f = fwy / fts
    let tx = floor(tx_f)
    let ty = floor(ty_f)
    let result = []
    push(result, tx)
    push(result, ty)
    return result

// tm_tile_to_world: return top-left world coordinates of tile (tx,ty).
fn tm_tile_to_world(map, tx, ty)
    let ts = map["tilesize"]
    let wx = tx * ts
    let wy = ty * ts
    let result = []
    push(result, wx)
    push(result, wy)
    return result

// ── Solid queries ─────────────────────────────────────────────────────────────

// tm_is_solid: true if tile at (tx,ty) has a non-zero value.
// Out-of-bounds tiles are treated as non-solid (passable outside map).
fn tm_is_solid(map, tx, ty)
    let v = tm_get(map, tx, ty)
    return v != 0

// tm_solid_at_world: true if the world point (wx,wy) falls in a solid tile.
fn tm_solid_at_world(map, wx, wy)
    let tile = tm_world_to_tile(map, wx, wy)
    let tx = tile[0]
    let ty = tile[1]
    return tm_is_solid(map, tx, ty)

// ── Neighbor enumeration ──────────────────────────────────────────────────────

// tm_neighbors4: return list of [tx,ty] in-bounds 4-connected neighbors of (tx,ty).
fn tm_neighbors4(map, tx, ty)
    let result = []
    let dxs = [0, 0, 1, -1]
    let dys = [-1, 1, 0, 0]
    for i in 0..4
        let nx = tx + dxs[i]
        let ny = ty + dys[i]
        let inb = tm_in_bounds(map, nx, ny)
        if inb
            let cell = []
            push(cell, nx)
            push(cell, ny)
            push(result, cell)
    return result

// ── Tile geometry ─────────────────────────────────────────────────────────────

// tm_tile_bounds: return AABB [wx, wy, tilesize, tilesize] for tile (tx,ty).
fn tm_tile_bounds(map, tx, ty)
    let ts = map["tilesize"]
    let wx = tx * ts
    let wy = ty * ts
    let bounds = []
    push(bounds, wx)
    push(bounds, wy)
    push(bounds, ts)
    push(bounds, ts)
    return bounds

// ── Bulk operations ───────────────────────────────────────────────────────────

// tm_fill_rect: fill a rectangle of tiles starting at (tx,ty) of size (tw,th) with v.
// Clamps to map bounds. Returns map.
fn tm_fill_rect(map, tx, ty, tw, th, v)
    for ry in 0..th
        let ty2 = ty + ry
        let rx = 0
        while rx < tw
            let tx2 = tx + rx
            tm_set(map, tx2, ty2, v)
            rx += 1
    return map

// tm_count: count the number of tiles with value == v.
fn tm_count(map, v)
    let tiles = map["tiles"]
    let n = len(tiles)
    let cnt = 0
    for i in 0..n
        if tiles[i] == v
            cnt += 1
    return cnt
