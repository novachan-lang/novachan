// std/game2d/aabb_collide.nova
// Axis-aligned bounding box (AABB) collision detection and utility functions.
// AABB representation: [x, y, w, h]  where (x,y) is the top-left corner,
// w is width, and h is height.  All coordinates are numeric (int or float).
//
// Overlap convention: closed intervals — touching edges COUNT as overlap.
// Sign convention for ab_mtv: the returned vector moves box A out of box B.
// When overlap on x < overlap on y the MTV is along x; otherwise along y.
// If A's centre is to the left of B's centre the x component is negative
// (pushes A left); if A's centre is above B's centre the y component is
// negative (pushes A up).
//
// Private helpers use the _abh_ prefix (unique to this module).
// Public functions use the ab_ prefix.

// _abh_fabs — float absolute value (builtin abs returns int; use if/else).
fn _abh_fabs(x: float) -> float
    let r = x
    if x < 0.0
        r = 0.0 - x
    r

// _abh_fmin — float minimum.
fn _abh_fmin(a: float, b: float) -> float
    let r = a
    if b < a
        r = b
    r

// _abh_fmax — float maximum.
fn _abh_fmax(a: float, b: float) -> float
    let r = a
    if b > a
        r = b
    r

// _abh_imax — integer maximum.
fn _abh_imax(a: int, b: int) -> int
    let r = a
    if b > a
        r = b
    r

// _abh_imin — integer minimum.
fn _abh_imin(a: int, b: int) -> int
    let r = a
    if b < a
        r = b
    r

// ab_overlap — true if AABB a and AABB b overlap (touching edges count).
// Intervals [ax, ax+aw] and [bx, bx+bw] overlap iff ax+aw >= bx AND bx+bw >= ax.
fn ab_overlap(a: list, b: list) -> bool
    let ax = a[0]
    let ay = a[1]
    let aw = a[2]
    let ah = a[3]
    let bx = b[0]
    let by = b[1]
    let bw = b[2]
    let bh = b[3]
    let result = true
    if ax + aw < bx
        result = false
    if bx + bw < ax
        result = false
    if ay + ah < by
        result = false
    if by + bh < ay
        result = false
    result

// ab_contains_point — true if point (px,py) lies inside or on the boundary of box.
fn ab_contains_point(box: list, px, py) -> bool
    let bx = box[0]
    let by = box[1]
    let bw = box[2]
    let bh = box[3]
    let result = true
    if px < bx
        result = false
    if px > bx + bw
        result = false
    if py < by
        result = false
    if py > by + bh
        result = false
    result

// ab_contains_box — true if AABB a fully contains AABB b.
// b is contained if all four corners of b lie within a.
fn ab_contains_box(a: list, b: list) -> bool
    let ax = a[0]
    let ay = a[1]
    let aw = a[2]
    let ah = a[3]
    let bx = b[0]
    let by = b[1]
    let bw = b[2]
    let bh = b[3]
    let result = true
    if bx < ax
        result = false
    if by < ay
        result = false
    if bx + bw > ax + aw
        result = false
    if by + bh > ay + ah
        result = false
    result

// ab_intersection — returns the overlapping AABB [ox,oy,ow,oh] or [] if disjoint.
// Uses integer arithmetic; w/h will be 0 if boxes only touch at an edge/corner.
fn ab_intersection(a: list, b: list) -> any
    let ax = a[0]
    let ay = a[1]
    let aw = a[2]
    let ah = a[3]
    let bx = b[0]
    let by = b[1]
    let bw = b[2]
    let bh = b[3]
    let ox = _abh_imax(ax, bx)
    let oy = _abh_imax(ay, by)
    let ox2 = _abh_imin(ax + aw, bx + bw)
    let oy2 = _abh_imin(ay + ah, by + bh)
    let result = []
    if ox2 >= ox
        if oy2 >= oy
            push(result, ox)
            push(result, oy)
            push(result, ox2 - ox)
            push(result, oy2 - oy)
    result

// ab_mtv — minimum translation vector to push A out of B.
// Returns [mx, my] such that translating A by (mx, my) exactly removes the overlap.
// Returns [0,0] if not overlapping.
// Sign: negative mx pushes A left; negative my pushes A up.
// Tie-break: x-axis preferred when overlaps are equal.
fn ab_mtv(a: list, b: list) -> any
    let ax = a[0]
    let ay = a[1]
    let aw = a[2]
    let ah = a[3]
    let bx = b[0]
    let by = b[1]
    let bw = b[2]
    let bh = b[3]
    let result = []
    // Check overlap on each axis
    let ov_x = ax + aw - bx
    let ov_x2 = bx + bw - ax
    let ov_y = ay + ah - by
    let ov_y2 = by + bh - ay
    // No overlap if any axis separates them
    let overlapping = true
    if ov_x < 0
        overlapping = false
    if ov_x2 < 0
        overlapping = false
    if ov_y < 0
        overlapping = false
    if ov_y2 < 0
        overlapping = false
    if not overlapping
        push(result, 0)
        push(result, 0)
        return result
    // Pick the smaller overlap direction on x
    let px = ov_x
    let push_x_neg = false
    if ov_x2 < ov_x
        px = ov_x2
        push_x_neg = true
    // Pick the smaller overlap direction on y
    let py = ov_y
    let push_y_neg = false
    if ov_y2 < ov_y
        py = ov_y2
        push_y_neg = true
    // Choose the axis with smaller penetration (x preferred on tie)
    let mx = 0
    let my = 0
    if px <= py
        // push on x axis
        if push_x_neg
            mx = px
        else
            mx = 0 - px
    else
        // push on y axis
        if push_y_neg
            my = py
        else
            my = 0 - py
    push(result, mx)
    push(result, my)
    result

// ab_overlap_area — area of the intersection rectangle (0.0 if disjoint).
fn ab_overlap_area(a: list, b: list) -> float
    let ax = a[0]
    let ay = a[1]
    let aw = a[2]
    let ah = a[3]
    let bx = b[0]
    let by = b[1]
    let bw = b[2]
    let bh = b[3]
    let ox = _abh_imax(ax, bx)
    let oy = _abh_imax(ay, by)
    let ox2 = _abh_imin(ax + aw, bx + bw)
    let oy2 = _abh_imin(ay + ah, by + bh)
    let area = 0.0
    if ox2 > ox
        if oy2 > oy
            let wf = (ox2 - ox) * 1.0
            let hf = (oy2 - oy) * 1.0
            area = wf * hf
    area

// ab_center — [cx, cy] float centroid of the box.
fn ab_center(box: list) -> any
    let bx = box[0]
    let by = box[1]
    let bw = box[2]
    let bh = box[3]
    let cx = bx * 1.0 + bw * 1.0 / 2.0
    let cy = by * 1.0 + bh * 1.0 / 2.0
    let result = []
    push(result, cx)
    push(result, cy)
    result

// ab_min_max — returns [minx, miny, maxx, maxy] from a [x,y,w,h] box.
fn ab_min_max(box: list) -> any
    let bx = box[0]
    let by = box[1]
    let bw = box[2]
    let bh = box[3]
    let result = []
    push(result, bx)
    push(result, by)
    push(result, bx + bw)
    push(result, by + bh)
    result

// ab_expand — expand box by d on all sides; returns new [x-d, y-d, w+2d, h+2d].
fn ab_expand(box: list, d) -> any
    let bx = box[0]
    let by = box[1]
    let bw = box[2]
    let bh = box[3]
    let result = []
    push(result, bx - d)
    push(result, by - d)
    push(result, bw + d + d)
    push(result, bh + d + d)
    result

// ab_from_min_max — construct [x,y,w,h] from min/max corners.
fn ab_from_min_max(minx, miny, maxx, maxy) -> any
    let result = []
    push(result, minx)
    push(result, miny)
    push(result, maxx - minx)
    push(result, maxy - miny)
    result
