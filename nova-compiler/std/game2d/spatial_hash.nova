// std/game2d/spatial_hash.nova
// Uniform spatial hash grid for broad-phase collision detection.
// Objects are inserted by position or AABB; queries return lists of object ids.
// Box format: [x, y, w, h] (top-left x,y + width,height), all floats.
// Cell key format: "<cx>,<cy>" (string, cx and cy are integer cell coords).
// Private helpers use the _sh_ prefix to avoid global symbol collisions.
// All float sub-expressions bound to named lets (uninit-float-slot safety).
//
// Public API (PREFIX sh_):
//   sh_new(cell_size)              -> any  create an empty spatial hash
//   sh_insert(hash, id, x, y)     -> any  insert id at point (x,y)
//   sh_insert_box(hash, id, box)  -> any  insert id for all cells the AABB spans
//   sh_query_point(hash, x, y)    -> any  list of ids in the cell containing (x,y)
//   sh_query_box(hash, box)       -> any  deduplicated ids in all cells the box spans
//   sh_cell_key(hash, x, y)       -> string  string key for cell containing (x,y)
//   sh_clear(hash)                -> any  remove all entries
//   sh_remove(hash, id, x, y)    -> any  remove id from the cell containing (x,y)
//   sh_cell_coords(cell_size,x,y) -> any  [cx, cy] integer cell coords
//   sh_neighbors(hash, x, y)     -> any  deduplicated ids in 3x3 neighborhood

// _sh_floor_div: floor division of a float by cell_size, returns int cell coord.
// Uses floor() builtin (float->int) to handle negative coords correctly.
fn _sh_floor_div(v: float, cs: float) -> int
    let q = v / cs
    let c = floor(q)
    c

// _sh_abs_int: integer absolute value via if/else.
fn _sh_abs_int(v: int) -> int
    let r = v
    if v < 0
        r = 0 - v
    r

// _sh_make_key: build string cell key from integer coords.
fn _sh_make_key(cx: int, cy: int) -> string
    let k = str(cx) + "," + str(cy)
    k

// _sh_dedup: deduplicate a list of ids, returns new list with each id once.
// Uses a dict as a seen-set. String keys: str(id).
fn _sh_dedup(ids: list) -> list
    let seen = {}
    let out = []
    let i = 0
    let n = len(ids)
    while i < n
        let v = ids[i]
        let k = str(v)
        if not contains(seen, k)
            seen[k] = 1
            push(out, v)
        i = i + 1
    out

// sh_new: create a new spatial hash with given cell_size (float).
// Returns a dict with keys "cell_size" (float) and "buckets" (dict of lists).
fn sh_new(cell_size: float) -> any
    let h = {}
    h["cell_size"] = cell_size
    let buckets = {}
    h["buckets"] = buckets
    h

// sh_cell_coords: compute the integer cell coordinates for point (x,y).
// Returns [cx, cy] where cx = floor(x / cell_size), cy = floor(y / cell_size).
fn sh_cell_coords(cell_size: float, x: float, y: float) -> any
    let cx = _sh_floor_div(x, cell_size)
    let cy = _sh_floor_div(y, cell_size)
    let result = []
    push(result, cx)
    push(result, cy)
    result

// sh_cell_key: string cell key for the cell containing point (x,y).
fn sh_cell_key(hash: any, x: float, y: float) -> string
    let cs = hash["cell_size"]
    let cx = _sh_floor_div(x, cs)
    let cy = _sh_floor_div(y, cs)
    let k = _sh_make_key(cx, cy)
    k

// sh_insert: insert id at point (x,y) into its cell bucket.
// Mutates the hash in place. Returns the hash.
fn sh_insert(hash: any, id: any, x: float, y: float) -> any
    let cs = hash["cell_size"]
    let cx = _sh_floor_div(x, cs)
    let cy = _sh_floor_div(y, cs)
    let key = _sh_make_key(cx, cy)
    let buckets = hash["buckets"]
    if not contains(buckets, key)
        let empty = []
        buckets[key] = empty
    let bucket = buckets[key]
    push(bucket, id)
    hash

// sh_insert_box: insert id into every cell the AABB [x,y,w,h] spans.
// Iterates over all cells from (floor(x/cs), floor(y/cs)) to
// (floor((x+w)/cs), floor((y+h)/cs)) inclusive.
fn sh_insert_box(hash: any, id: any, box: any) -> any
    let cs = hash["cell_size"]
    let bx = box[0]
    let by = box[1]
    let bw = box[2]
    let bh = box[3]
    let bxf = bx * 1.0
    let byf = by * 1.0
    let bwf = bw * 1.0
    let bhf = bh * 1.0
    let x1 = _sh_floor_div(bxf, cs)
    let y1 = _sh_floor_div(byf, cs)
    let x2end = bxf + bwf
    let y2end = byf + bhf
    let x2 = _sh_floor_div(x2end, cs)
    let y2 = _sh_floor_div(y2end, cs)
    let buckets = hash["buckets"]
    let cy = y1
    while cy <= y2
        let cx = x1
        while cx <= x2
            let key = _sh_make_key(cx, cy)
            if not contains(buckets, key)
                let empty = []
                buckets[key] = empty
            let bucket = buckets[key]
            push(bucket, id)
            cx = cx + 1
        cy = cy + 1
    hash

// sh_query_point: return list of ids in the cell containing (x,y).
// Returns an empty list if no ids in that cell.
fn sh_query_point(hash: any, x: float, y: float) -> any
    let cs = hash["cell_size"]
    let cx = _sh_floor_div(x, cs)
    let cy = _sh_floor_div(y, cs)
    let key = _sh_make_key(cx, cy)
    let buckets = hash["buckets"]
    let result = []
    if contains(buckets, key)
        let bucket = buckets[key]
        let i = 0
        let n = len(bucket)
        while i < n
            push(result, bucket[i])
            i = i + 1
    result

// sh_query_box: return deduplicated list of ids in all cells the AABB spans.
fn sh_query_box(hash: any, box: any) -> any
    let cs = hash["cell_size"]
    let bx = box[0]
    let by = box[1]
    let bw = box[2]
    let bh = box[3]
    let bxf = bx * 1.0
    let byf = by * 1.0
    let bwf = bw * 1.0
    let bhf = bh * 1.0
    let x1 = _sh_floor_div(bxf, cs)
    let y1 = _sh_floor_div(byf, cs)
    let x2end = bxf + bwf
    let y2end = byf + bhf
    let x2 = _sh_floor_div(x2end, cs)
    let y2 = _sh_floor_div(y2end, cs)
    let buckets = hash["buckets"]
    let all = []
    let cy = y1
    while cy <= y2
        let cx = x1
        while cx <= x2
            let key = _sh_make_key(cx, cy)
            if contains(buckets, key)
                let bucket = buckets[key]
                let i = 0
                let n = len(bucket)
                while i < n
                    push(all, bucket[i])
                    i = i + 1
            cx = cx + 1
        cy = cy + 1
    let result = _sh_dedup(all)
    result

// sh_clear: remove all entries from the hash.
fn sh_clear(hash: any) -> any
    let empty = {}
    hash["buckets"] = empty
    hash

// sh_remove: remove the first occurrence of id from the cell containing (x,y).
fn sh_remove(hash: any, id: any, x: float, y: float) -> any
    let cs = hash["cell_size"]
    let cx = _sh_floor_div(x, cs)
    let cy = _sh_floor_div(y, cs)
    let key = _sh_make_key(cx, cy)
    let buckets = hash["buckets"]
    if contains(buckets, key)
        let bucket = buckets[key]
        let n = len(bucket)
        let new_bucket = []
        let removed = 0
        let i = 0
        while i < n
            let v = bucket[i]
            if removed == 0 and v == id
                removed = 1
            else
                push(new_bucket, v)
            i = i + 1
        buckets[key] = new_bucket
    hash

// sh_neighbors: return deduplicated ids in the 3x3 cell block around (x,y).
// Covers cells (cx-1..cx+1) x (cy-1..cy+1).
fn sh_neighbors(hash: any, x: float, y: float) -> any
    let cs = hash["cell_size"]
    let cx = _sh_floor_div(x, cs)
    let cy = _sh_floor_div(y, cs)
    let buckets = hash["buckets"]
    let all = []
    let dy = 0 - 1
    while dy <= 1
        let dx = 0 - 1
        while dx <= 1
            let ncx = cx + dx
            let ncy = cy + dy
            let key = _sh_make_key(ncx, ncy)
            if contains(buckets, key)
                let bucket = buckets[key]
                let i = 0
                let n = len(bucket)
                while i < n
                    push(all, bucket[i])
                    i = i + 1
            dx = dx + 1
        dy = dy + 1
    let result = _sh_dedup(all)
    result
