// std/game2d/collision_resolve.nova -- 2D AABB collision response.
// AABB format: [x, y, w, h]  (top-left x,y; width w; height h).
// All float math binds sub-expressions to named lets (uninit-float-slot safety).
// LEAF -- imports nothing.
//
// Public API (prefix cr_):
//   cr_reflect_velocity(vx,vy, nx,ny)           -> any   reflect v off surface normal n
//   cr_bounce(vx,vy, nx,ny, restitution)         -> any   reflect * restitution factor
//   cr_slide(vx,vy, nx,ny)                       -> any   remove normal component of v
//   cr_impulse_1d(v1,v2, m1,m2, e)               -> any   1D elastic/inelastic collision
//   cr_penetration_mtv(a, b)                      -> any   MTV list [ox,oy] to push a out
//   cr_resolve_aabb(a, b)                         -> any   new [x,y] for a pushed out of b
//   cr_separate(a, b)                             -> any   [ax,ay,bx,by] push both apart

// _cr_absf -- float absolute value.
fn _cr_absf(v: float) -> float
    if v < 0.0
        return 0.0 - v
    v

// cr_reflect_velocity -- reflect velocity (vx,vy) off surface with unit normal (nx,ny).
// Formula: v' = v - 2*(v.n)*n
// Normal should be unit length; caller's responsibility.
fn cr_reflect_velocity(vx: float, vy: float, nx: float, ny: float) -> any
    let dot = vx * nx + vy * ny
    let two_dot = 2.0 * dot
    let rx = vx - two_dot * nx
    let ry = vy - two_dot * ny
    let result = []
    push(result, rx)
    push(result, ry)
    result

// cr_bounce -- reflect velocity off normal and scale by restitution (0=absorb, 1=elastic).
fn cr_bounce(vx: float, vy: float, nx: float, ny: float, restitution: float) -> any
    let dot = vx * nx + vy * ny
    let two_dot = 2.0 * dot
    let rx = vx - two_dot * nx
    let ry = vy - two_dot * ny
    let bx = rx * restitution
    let by = ry * restitution
    let result = []
    push(result, bx)
    push(result, by)
    result

// cr_slide -- remove the normal component from velocity (slide along surface).
// Formula: v' = v - (v.n)*n
fn cr_slide(vx: float, vy: float, nx: float, ny: float) -> any
    let dot = vx * nx + vy * ny
    let sx = vx - dot * nx
    let sy = vy - dot * ny
    let result = []
    push(result, sx)
    push(result, sy)
    result

// cr_impulse_1d -- 1D elastic/inelastic collision.
// Returns new velocities [v1', v2'] for two objects.
// e = coefficient of restitution (1.0 = elastic, 0.0 = perfectly inelastic).
// Formulas: v1' = (m1*v1 + m2*v2 - m2*e*(v1-v2)) / (m1+m2)
//           v2' = (m1*v1 + m2*v2 + m1*e*(v1-v2)) / (m1+m2)
fn cr_impulse_1d(v1: float, v2: float, m1: float, m2: float, e: float) -> any
    let total_m = m1 + m2
    let momentum = m1 * v1 + m2 * v2
    let rel_v = v1 - v2
    let impulse = e * rel_v
    let nv1 = (momentum - m2 * impulse) / total_m
    let nv2 = (momentum + m1 * impulse) / total_m
    let result = []
    push(result, nv1)
    push(result, nv2)
    result

// cr_penetration_mtv -- minimum translation vector to push AABB a out of AABB b.
// Returns [ox, oy] — the overlap displacement along the axis of least penetration.
// AABB format: [x, y, w, h].
// If no overlap, returns [0.0, 0.0].
fn cr_penetration_mtv(a: any, b: any) -> any
    let ax = a[0] * 1.0
    let ay = a[1] * 1.0
    let aw = a[2] * 1.0
    let ah = a[3] * 1.0
    let bx = b[0] * 1.0
    let by = b[1] * 1.0
    let bw = b[2] * 1.0
    let bh = b[3] * 1.0
    // compute right/bottom edges
    let ar = ax + aw
    let ab = ay + ah
    let br = bx + bw
    let bb = by + bh
    // overlap on each axis
    let ox1 = ar - bx
    let ox2 = br - ax
    let oy1 = ab - by
    let oy2 = bb - ay
    let result = []
    // no overlap?
    if ox1 <= 0.0 or ox2 <= 0.0 or oy1 <= 0.0 or oy2 <= 0.0
        push(result, 0.0)
        push(result, 0.0)
        return result
    // pick minimum overlap axis and determine push direction.
    // ox1 = a's right past b's left (push a LEFT to clear b's left edge)
    // ox2 = b's right past a's left (push a RIGHT to clear b's right edge)
    // Take the smaller overlap; the direction is the one that moves a away from b.
    let ox = ox1
    let ox_dir = 0.0 - 1.0
    if ox2 < ox1
        ox = ox2
        ox_dir = 1.0
    let oy = oy1
    let oy_dir = 0.0 - 1.0
    if oy2 < oy1
        oy = oy2
        oy_dir = 1.0
    if ox < oy
        push(result, ox * ox_dir)
        push(result, 0.0)
    else
        push(result, 0.0)
        push(result, oy * oy_dir)
    result

// cr_resolve_aabb -- push AABB a out of AABB b along minimum overlap axis.
// Returns the corrected [x, y] for a.
fn cr_resolve_aabb(a: any, b: any) -> any
    let mtv = cr_penetration_mtv(a, b)
    let ox = mtv[0] * 1.0
    let oy = mtv[1] * 1.0
    let ax = a[0] * 1.0
    let ay = a[1] * 1.0
    let nx = ax + ox
    let ny = ay + oy
    let result = []
    push(result, nx)
    push(result, ny)
    result

// cr_separate -- push both AABBs apart equally (half MTV each).
// Returns [ax, ay, bx, by] — new top-left positions for a and b.
fn cr_separate(a: any, b: any) -> any
    let mtv = cr_penetration_mtv(a, b)
    let ox = mtv[0] * 1.0
    let oy = mtv[1] * 1.0
    let half_ox = ox / 2.0
    let half_oy = oy / 2.0
    let ax = a[0] * 1.0
    let ay = a[1] * 1.0
    let bx_orig = b[0] * 1.0
    let by_orig = b[1] * 1.0
    let nax = ax + half_ox
    let nay = ay + half_oy
    let nbx = bx_orig - half_ox
    let nby = by_orig - half_oy
    let result = []
    push(result, nax)
    push(result, nay)
    push(result, nbx)
    push(result, nby)
    result
