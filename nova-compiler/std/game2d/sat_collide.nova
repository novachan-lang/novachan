// std/game2d/sat_collide.nova
// Separating Axis Theorem (SAT) collision detection for convex polygons.
// Polygons are lists of [x, y] vertex lists (convex, CCW winding).
//
// SAT principle: two convex shapes overlap iff there is NO separating axis.
// We test all edge normals from both polygons.  If projection intervals
// overlap on ALL axes then the shapes collide.
//
// Boundary convention: touching (intervals meeting at exactly one point)
// counts as COLLIDING (no separation).
//
// MTV sign convention: the MTV translates polyA OUT of polyB.
// The direction is along the axis that gives the smallest overlap;
// the sign is chosen so the MTV pushes A away from B's projection midpoint.
//
// All float arithmetic is bound to named lets to avoid the uninit-float-slot bug.
// abs(float) uses if/else (builtin abs returns int).
// No trigonometry: normals from edge perpendiculars only.
//
// Private helpers use the _sth_ prefix.
// Public functions use the sat_ prefix.

// _sth_fabs — float absolute value.
fn _sth_fabs(x: float) -> float
    let r = x
    if x < 0.0
        r = 0.0 - x
    r

// _sth_fsqrt — sqrt wrapper that ensures input is non-negative.
fn _sth_fsqrt(x: float) -> float
    let safe = x
    if x < 0.0
        safe = 0.0
    let r = sqrt(safe)
    r

// sat_dot — dot product of two 2D vectors (ax,ay) and (bx,by).
fn sat_dot(ax, ay, bx, by) -> float
    let axf = ax * 1.0
    let ayf = ay * 1.0
    let bxf = bx * 1.0
    let byf = by * 1.0
    let d = axf * bxf + ayf * byf
    d

// sat_edge_normal — outward edge normal for edge from (x1,y1) to (x2,y2).
// For a CCW polygon, the outward normal of edge (x1,y1)->(x2,y2) is (dy, -dx)
// where dx=x2-x1, dy=y2-y1.  Not normalised (length = edge length);
// the SAT only needs direction consistency across both polygons.
fn sat_edge_normal(x1, y1, x2, y2) -> any
    let dx = (x2 - x1) * 1.0
    let dy = (y2 - y1) * 1.0
    let result = []
    push(result, dy)
    push(result, 0.0 - dx)
    result

// sat_axes — all outward edge normals for a convex polygon.
// Returns a list of [nx, ny] float pairs; one per edge.
fn sat_axes(poly: list) -> any
    let n = len(poly)
    let axes = []
    let i = 0
    while i < n
        let v1 = poly[i]
        let j = i + 1
        if j >= n
            j = 0
        let v2 = poly[j]
        let x1 = v1[0]
        let y1 = v1[1]
        let x2 = v2[0]
        let y2 = v2[1]
        let ax = sat_edge_normal(x1, y1, x2, y2)
        push(axes, ax)
        i = i + 1
    axes

// sat_project — project all polygon vertices onto axis [ax, ay].
// Returns [min, max] scalar projection range.
fn sat_project(poly: list, axis: list) -> any
    let ax = axis[0]
    let ay = axis[1]
    let n = len(poly)
    let v0 = poly[0]
    let x0 = v0[0]
    let y0 = v0[1]
    let init = sat_dot(x0, y0, ax, ay)
    let mn = init
    let mx = init
    let i = 1
    while i < n
        let v = poly[i]
        let vx = v[0]
        let vy = v[1]
        let p = sat_dot(vx, vy, ax, ay)
        if p < mn
            mn = p
        if p > mx
            mx = p
        i = i + 1
    let result = []
    push(result, mn)
    push(result, mx)
    result

// sat_overlaps_on_axis — true if projections of poly a and poly b overlap on axis.
// Overlap: a.max >= b.min AND b.max >= a.min (touching counts as overlap).
fn sat_overlaps_on_axis(a: list, b: list, axis: list) -> bool
    let pa = sat_project(a, axis)
    let pb = sat_project(b, axis)
    let amin = pa[0]
    let amax = pa[1]
    let bmin = pb[0]
    let bmax = pb[1]
    let result = true
    if amax < bmin
        result = false
    if bmax < amin
        result = false
    result

// sat_collide — true if two convex polygons overlap via SAT.
// Tests all edge normals from both polygons.
// Returns false as soon as a separating axis is found (early exit).
fn sat_collide(polyA: list, polyB: list) -> bool
    let axesA = sat_axes(polyA)
    let na = len(axesA)
    let i = 0
    while i < na
        let axis = axesA[i]
        let overlaps = sat_overlaps_on_axis(polyA, polyB, axis)
        if not overlaps
            return false
        i = i + 1
    let axesB = sat_axes(polyB)
    let nb = len(axesB)
    let j = 0
    while j < nb
        let axis = axesB[j]
        let overlaps = sat_overlaps_on_axis(polyA, polyB, axis)
        if not overlaps
            return false
        j = j + 1
    true

// _sth_overlap_on_axis — compute signed overlap of A into B on one axis.
// Positive value = A extends into B; direction is axis direction.
// Returns: [overlap_magnitude, sign] where sign 1 = push A in +axis dir, -1 = in -axis dir.
// We want the smallest overlap magnitude across all axes for the MTV.
fn _sth_proj_overlap(a: list, b: list, axis: list) -> float
    let pa = sat_project(a, axis)
    let pb = sat_project(b, axis)
    let amin = pa[0]
    let amax = pa[1]
    let bmin = pb[0]
    let bmax = pb[1]
    // overlap1 = amount A's right side penetrates B's left
    let ov1 = amax - bmin
    // overlap2 = amount B's right side penetrates A's left
    let ov2 = bmax - amin
    // The actual penetration is min(ov1, ov2)
    let result = ov1
    if ov2 < ov1
        result = ov2
    result

// sat_mtv — minimum translation vector to separate polyA from polyB.
// Returns [mx, my] (float). If not overlapping, returns [0.0, 0.0].
// MTV direction: pushes A out of B; sign is chosen based on which projection
// overlap is smaller and oriented away from B's centre relative to A's centre.
fn sat_mtv(polyA: list, polyB: list) -> any
    let result = []
    // First check if they collide at all
    let collide = sat_collide(polyA, polyB)
    if not collide
        push(result, 0.0)
        push(result, 0.0)
        return result
    // Collect all axes from both polygons
    let axesA = sat_axes(polyA)
    let axesB = sat_axes(polyB)
    // Find the axis with minimum overlap
    let best_overlap = 0.0
    let best_ax = 0.0
    let best_ay = 0.0
    let found_first = false
    // Process A's axes
    let na = len(axesA)
    let i = 0
    while i < na
        let axis = axesA[i]
        let axv = axis[0]
        let ayv = axis[1]
        // Normalise axis length to get consistent overlap magnitude
        let lensq = axv * axv + ayv * ayv
        let axlen = _sth_fsqrt(lensq)
        let nax = axv
        let nay = ayv
        if axlen > 0.0000001
            nax = axv / axlen
            nay = ayv / axlen
        let naxis = []
        push(naxis, nax)
        push(naxis, nay)
        let ov = _sth_proj_overlap(polyA, polyB, naxis)
        if not found_first
            best_overlap = ov
            best_ax = nax
            best_ay = nay
            found_first = true
        else
            if ov < best_overlap
                best_overlap = ov
                best_ax = nax
                best_ay = nay
        i = i + 1
    // Process B's axes
    let nb = len(axesB)
    let j = 0
    while j < nb
        let axis = axesB[j]
        let axv = axis[0]
        let ayv = axis[1]
        let lensq = axv * axv + ayv * ayv
        let axlen = _sth_fsqrt(lensq)
        let nax = axv
        let nay = ayv
        if axlen > 0.0000001
            nax = axv / axlen
            nay = ayv / axlen
        let naxis = []
        push(naxis, nax)
        push(naxis, nay)
        let ov = _sth_proj_overlap(polyA, polyB, naxis)
        if ov < best_overlap
            best_overlap = ov
            best_ax = nax
            best_ay = nay
        j = j + 1
    // Determine MTV direction: should push A away from B.
    // Compute centroid A and centroid B, then ensure MTV points from B to A.
    let sumaxA = 0.0
    let sumayA = 0.0
    let naA = len(polyA)
    let k = 0
    while k < naA
        let v = polyA[k]
        sumaxA = sumaxA + v[0] * 1.0
        sumayA = sumayA + v[1] * 1.0
        k = k + 1
    let centAxA = sumaxA / (naA * 1.0)
    let centAyA = sumayA / (naA * 1.0)
    let sumaxB = 0.0
    let sumayB = 0.0
    let naB = len(polyB)
    let m = 0
    while m < naB
        let v = polyB[m]
        sumaxB = sumaxB + v[0] * 1.0
        sumayB = sumayB + v[1] * 1.0
        m = m + 1
    let centAxB = sumaxB / (naB * 1.0)
    let centAyB = sumayB / (naB * 1.0)
    // Direction from B centre to A centre
    let dirx = centAxA - centAxB
    let diry = centAyA - centAyB
    // Dot with best axis to determine sign
    let dot_dir = dirx * best_ax + diry * best_ay
    let mx = best_ax * best_overlap
    let my = best_ay * best_overlap
    if dot_dir < 0.0
        // axis points wrong way, flip
        mx = 0.0 - mx
        my = 0.0 - my
    push(result, mx)
    push(result, my)
    result
