// std/phonetic/statcan_code -- Statistics Canada name phonetic coding.
// LEAF -- imports NOTHING.
//
// Public API:
//   sc_encode(name: string) -> string
//   sc_normalize(name: string) -> string
//   sc_remove_vowels(s: string) -> string
//   sc_dedupe(s: string) -> string
//
// Algorithm:
//   1. Strip non-alpha, uppercase all letters.
//   2. If empty, return "".
//   3. Keep the first letter as-is.
//   4. From the remaining characters, remove vowels (A E I O U), Y, H.
//   5. Collapse consecutive duplicate letters in the remainder.
//   6. Prepend the first letter.
//
// Example: SMITH -> S + (MITH -> remove vowels/Y/H -> MT -> dedup -> MT) -> SMT

// Uppercase a single ASCII character; non-alpha returns "".
fn _sc_up(c: string) -> string
    let o = ord(c)
    let r = ""
    if o >= 65 and o <= 90
        r = c
    else if o >= 97 and o <= 122
        r = chr(o - 32)
    r

// Strip non-alpha and uppercase: return cleaned string.
fn _sc_clean(s: string) -> string
    let n = len(s)
    let out = ""
    let i = 0
    while i < n
        let uc = _sc_up(slice(s, i, i + 1))
        if len(uc) > 0
            out = out + uc
        i = i + 1
    out

// Return 1 if c is a vowel (AEIOU), 0 otherwise.
fn _sc_is_vowel(c: string) -> int
    let r = 0
    if c == "A" or c == "E" or c == "I" or c == "O" or c == "U"
        r = 1
    r

// Normalise a name: strip non-alpha and uppercase.
fn sc_normalize(name: string) -> string
    _sc_clean(name)

// Remove vowels (AEIOU), Y, and H from the entire string.
// Used as a helper; the first character is NOT specially preserved here.
fn sc_remove_vowels(s: string) -> string
    let n = len(s)
    let out = ""
    let i = 0
    while i < n
        let c = slice(s, i, i + 1)
        let drop = 0
        if _sc_is_vowel(c) == 1
            drop = 1
        else if c == "Y"
            drop = 1
        else if c == "H"
            drop = 1
        if drop == 0
            out = out + c
        i = i + 1
    out

// Collapse consecutive duplicate letters in a string.
// E.g., "BOOKKEEPER" -> "BOKEPER".
fn sc_dedupe(s: string) -> string
    let n = len(s)
    let out = ""
    let prev = ""
    let i = 0
    while i < n
        let c = slice(s, i, i + 1)
        if c != prev
            out = out + c
            prev = c
        i = i + 1
    out

// Encode a name using the Statistics Canada phonetic algorithm.
// Returns "" for empty input.
fn sc_encode(name: string) -> string
    let w = _sc_clean(name)
    let n = len(w)
    let result = ""
    if n > 0
        let first = slice(w, 0, 1)
        if n == 1
            result = first
        else
            let rest = slice(w, 1, n)
            // Remove vowels, Y, H from the rest.
            let stripped = sc_remove_vowels(rest)
            // Collapse consecutive duplicates.
            let deduped = sc_dedupe(stripped)
            result = first + deduped
    result
