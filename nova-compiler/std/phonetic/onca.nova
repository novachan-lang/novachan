// ============================================================================
// NOVA Standard Library — std/phonetic/onca
// ============================================================================
// Oxford Name Compression Algorithm (ONCA).
//
// ONCA = NYSIIS stage applied first, then Soundex applied to the result.
// Output is always a letter + exactly 3 digits (e.g. "S530", "M235").
//
// Public API:
//   on_normalize(name)      -> string  uppercase, letters only
//   on_nysiis_stage(name)   -> string  NYSIIS phonetic code (uppercase)
//   on_soundex_stage(name)  -> string  Soundex of a string (letter+3 digits)
//   on_encode(name)         -> string  ONCA = on_soundex_stage(on_nysiis_stage(name))
//
// Reference:
//   Gill, L.J. (1997). OX-LINK: The Oxford Medical Record Linkage System.
//   NYSIIS: Taft, R.L. (1970). Name search techniques. NYS Identification and
//           Intelligence System Occasional Paper Number 1.
//   Soundex: NARA (US National Archives and Records Administration) standard.
//
// LEAF — imports nothing.
// ============================================================================

// on_upper_char converts one ASCII character to uppercase.
fn on_upper_char(c) -> string
    let o = ord(c)
    let r = c
    if o >= 97 and o <= 122
        r = chr(o - 32)
    r

// on_is_letter returns 1 if c is an ASCII letter (A-Z or a-z).
fn on_is_letter(c) -> int
    let o = ord(c)
    let r = 0
    if (o >= 65 and o <= 90) or (o >= 97 and o <= 122)
        r = 1
    r

// on_is_vowel returns 1 if the uppercase character c is A, E, I, O, or U.
// Note: Y is NOT treated as a vowel in NYSIIS.
fn on_is_vowel(c) -> int
    let r = 0
    if c == "A" or c == "E" or c == "I" or c == "O" or c == "U"
        r = 1
    r

// on_normalize strips non-letters and uppercases the result.
fn on_normalize(name) -> string
    let n = len(name)
    let out_parts = []
    for i in 0..n
        let c = char_at(name, i)
        if on_is_letter(c) == 1
            push(out_parts, on_upper_char(c))
    let out = join(out_parts, "")
    out

// on_starts_with returns 1 if string s starts with prefix p.
fn on_starts_with(s, p) -> int
    let ls = len(s)
    let lp = len(p)
    let r = 0
    if ls >= lp
        if slice(s, 0, lp) == p
            r = 1
    r

// on_ends_with returns 1 if string s ends with suffix sf.
fn on_ends_with(s, sf) -> int
    let ls = len(s)
    let lsf = len(sf)
    let r = 0
    if ls >= lsf
        if slice(s, ls - lsf, ls) == sf
            r = 1
    r

// on_soundex_code returns the Soundex digit for one uppercase letter.
// BFPV=1, CGJKQSXZ=2, DT=3, L=4, MN=5, R=6, others (vowels/HWY)=0.
fn on_soundex_code(c) -> int
    let r = 0
    if c == "B" or c == "F" or c == "P" or c == "V"
        r = 1
    else if c == "C" or c == "G" or c == "J" or c == "K" or c == "Q" or c == "S" or c == "X" or c == "Z"
        r = 2
    else if c == "D" or c == "T"
        r = 3
    else if c == "L"
        r = 4
    else if c == "M" or c == "N"
        r = 5
    else if c == "R"
        r = 6
    r

// on_soundex_stage computes Soundex of an already-uppercase alphabetic string.
// Returns letter + 3 digits (e.g. "M235"). Returns "0000" for empty input.
// H and W are transparent (do not break a same-code run).
// Vowels reset the prev_code so the next same-coded consonant IS counted.
fn on_soundex_stage(s) -> string
    let n = len(s)
    let result = "0000"
    if n > 0
        let first = char_at(s, 0)
        let first_code = on_soundex_code(first)
        let digits = ""
        let prev_code = first_code
        let i = 1
        while i < n and len(digits) < 3
            let c = char_at(s, i)
            let is_hw = 0
            if c == "H" or c == "W"
                is_hw = 1
            if is_hw == 0
                let code = on_soundex_code(c)
                if code == 0
                    // Vowel or ignored: reset so next same-coded consonant counts.
                    prev_code = 0
                else if code != prev_code
                    digits = digits + str(code)
                    prev_code = code
            // H or W: do not update prev_code (transparent separator).
            i = i + 1
        // Pad to exactly 3 digits.
        let dlen = len(digits)
        if dlen < 3
            let pad = 3 - dlen
            if pad == 3
                digits = digits + "000"
            else if pad == 2
                digits = digits + "00"
            else
                digits = digits + "0"
        result = first + slice(digits, 0, 3)
    result

// on_nysiis_stage applies the NYSIIS algorithm to a name string.
// Returns the NYSIIS phonetic code (uppercase).
//
// Algorithm steps (Taft 1970):
//  1. Normalize to uppercase letters only.
//  2. Prefix transforms: MAC->MCC, KN->N, K->C, PH/PF->FF, SCH->SSS.
//  3. Suffix transforms: EE/IE->Y; DT/RT/RD/NT/ND->D.
//  4. Record first char; process remaining with rules:
//       EV->AF, vowels->A, Q->G, Z->S, M->N, KN->N, K->C,
//       SCH->SSS, PH->FF, H (near vowel)->drop, W (after vowel)->drop.
//  5. Remove trailing S (if len>1).
//  6. Replace trailing AY with Y.
//  7. Remove trailing A (if len>1).
//  8. Collapse consecutive duplicate characters.
//  9. Remove trailing H or W (always silent at word end).
fn on_nysiis_stage(name) -> string
    let s = on_normalize(name)
    let n = len(s)
    if n == 0
        return ""

    // Step 2: Prefix transforms.
    let work = s
    if on_starts_with(work, "MAC") == 1
        work = "MCC" + slice(work, 3, len(work))
    else if on_starts_with(work, "KN") == 1
        work = "N" + slice(work, 2, len(work))
    else if on_starts_with(work, "K") == 1
        work = "C" + slice(work, 1, len(work))
    if on_starts_with(work, "PH") == 1
        work = "FF" + slice(work, 2, len(work))
    else if on_starts_with(work, "PF") == 1
        work = "FF" + slice(work, 2, len(work))
    if on_starts_with(work, "SCH") == 1
        work = "SSS" + slice(work, 3, len(work))

    // Step 3: Suffix transforms.
    if on_ends_with(work, "EE") == 1
        work = slice(work, 0, len(work) - 2) + "Y"
    else if on_ends_with(work, "IE") == 1
        work = slice(work, 0, len(work) - 2) + "Y"
    if on_ends_with(work, "DT") == 1
        work = slice(work, 0, len(work) - 2) + "D"
    else if on_ends_with(work, "RT") == 1
        work = slice(work, 0, len(work) - 2) + "D"
    else if on_ends_with(work, "RD") == 1
        work = slice(work, 0, len(work) - 2) + "D"
    else if on_ends_with(work, "NT") == 1
        work = slice(work, 0, len(work) - 2) + "D"
    else if on_ends_with(work, "ND") == 1
        work = slice(work, 0, len(work) - 2) + "D"

    // Step 4: Record first char; build key from remaining chars.
    let key = slice(work, 0, 1)
    let i = 1
    let wlen = len(work)
    while i < wlen
        let c = char_at(work, i)
        let prev_c = char_at(work, i - 1)
        // EV -> AF (check before vowel rule)
        if c == "E" and i + 1 < wlen and char_at(work, i + 1) == "V"
            key = key + "AF"
            i = i + 2
        else if on_is_vowel(c) == 1
            // All vowels -> A
            key = key + "A"
            i = i + 1
        else if c == "Q"
            key = key + "G"
            i = i + 1
        else if c == "Z"
            key = key + "S"
            i = i + 1
        else if c == "M"
            key = key + "N"
            i = i + 1
        else if c == "K" and i + 1 < wlen and char_at(work, i + 1) == "N"
            // KN -> N
            key = key + "N"
            i = i + 2
        else if c == "K"
            key = key + "C"
            i = i + 1
        else if c == "S" and i + 1 < wlen and char_at(work, i + 1) == "C" and i + 2 < wlen and char_at(work, i + 2) == "H"
            // SCH -> SSS
            key = key + "SSS"
            i = i + 3
        else if c == "P" and i + 1 < wlen and char_at(work, i + 1) == "H"
            // PH -> FF
            key = key + "FF"
            i = i + 2
        else if c == "H"
            // H: remove if preceded by a vowel OR followed by a vowel.
            let remove_h = 0
            if on_is_vowel(prev_c) == 1
                remove_h = 1
            if remove_h == 0 and i + 1 < wlen
                if on_is_vowel(char_at(work, i + 1)) == 1
                    remove_h = 1
            if remove_h == 0
                key = key + "H"
            i = i + 1
        else if c == "W" and on_is_vowel(prev_c) == 1
            // W after vowel: remove (do not append).
            i = i + 1
        else
            key = key + c
            i = i + 1

    // Step 5: Remove trailing S if len > 1.
    let klen = len(key)
    if klen > 1 and on_ends_with(key, "S") == 1
        key = slice(key, 0, klen - 1)

    // Step 6: Replace trailing AY with Y.
    klen = len(key)
    if klen > 1 and on_ends_with(key, "AY") == 1
        key = slice(key, 0, klen - 2) + "Y"

    // Step 7: Remove trailing A if len > 1.
    klen = len(key)
    if klen > 1 and on_ends_with(key, "A") == 1
        key = slice(key, 0, klen - 1)

    // Step 8: Collapse consecutive duplicate characters.
    let collapsed_parts = []
    let ki = 0
    klen = len(key)
    while ki < klen
        let cur = char_at(key, ki)
        if ki == 0
            push(collapsed_parts, cur)
        else if cur != char_at(key, ki - 1)
            push(collapsed_parts, cur)
        ki = ki + 1

    let collapsed = join(collapsed_parts, "")
    // Step 9: Remove trailing H or W (always silent at word end).
    let clen = len(collapsed)
    if clen > 1
        let last = char_at(collapsed, clen - 1)
        if last == "H" or last == "W"
            collapsed = slice(collapsed, 0, clen - 1)

    collapsed

// on_encode computes the full ONCA code for a name.
// ONCA = Soundex(NYSIIS(name)), always letter + 3 digits.
fn on_encode(name) -> string
    let ny = on_nysiis_stage(name)
    if len(ny) == 0
        return "0000"
    on_soundex_stage(ny)

fn main()
    print("std/phonetic/onca loaded")
