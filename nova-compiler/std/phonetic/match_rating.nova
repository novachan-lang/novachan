// std/phonetic/match_rating -- Match Rating Approach (MRA) phonetic name matching.
// Implements the Western Airlines / Guth 1976 MRA algorithm.
// Self-contained: imports nothing. All helpers are module-private.
//
// Public API:
//   mra_codex(name: string) -> string
//     Compute the MRA codex: uppercase, strip non-alpha, remove non-leading vowels,
//     collapse doubled letters, keep first3+last3 if length > 6.
//
//   mra_compare(name1: string, name2: string) -> int
//     Return 1 if names match under MRA (codex both, check length diff <= 3,
//     compute similarity via 6 - floor((unmatched_a + unmatched_b) / 2),
//     compare against minimum-rating threshold table).
//
//   mra_similarity(name1: string, name2: string) -> int
//     Return the similarity value (0-6) without threshold check.
//
//   mra_min_rating(sumlen: int) -> int
//     Return the minimum matching threshold for the given combined codex length:
//     sum 4-5 -> 5, sum 6-7 -> 4, sum 8-11 -> 3, sum >= 12 -> 2.

// PRIVATE: uppercase a single ASCII character.
fn _mra_uc(c: string) -> string
    let o = ord(c)
    let r = c
    if o >= 97 and o <= 122
        r = chr(o - 32)
    r

// PRIVATE: test if character is ASCII alphabetic.
fn _mra_is_alpha(c: string) -> int
    let o = ord(c)
    let r = 0
    if o >= 65 and o <= 90
        r = 1
    if o >= 97 and o <= 122
        r = 1
    r

// PRIVATE: test if uppercase character is a vowel (A E I O U).
// Note: Y is treated as a consonant in MRA.
fn _mra_is_vowel(c: string) -> int
    let r = 0
    if c == "A" or c == "E" or c == "I" or c == "O" or c == "U"
        r = 1
    r

// PRIVATE: uppercase and keep only alpha characters.
fn _mra_clean(name: string) -> string
    let n = len(name)
    let out = ""
    for i in 0..n
        let c = slice(name, i, i + 1)
        if _mra_is_alpha(c) == 1
            out += _mra_uc(c)
    out

// PRIVATE: remove non-leading vowels from uppercase alpha string.
fn _mra_remove_vowels(s: string) -> string
    let n = len(s)
    if n == 0
        return ""
    // Keep first character regardless (leading letter, vowel or not).
    let out = slice(s, 0, 1)
    for i in 1..n
        let c = slice(s, i, i + 1)
        if _mra_is_vowel(c) == 0
            out += c
    out

// PRIVATE: collapse consecutive duplicate letters.
fn _mra_collapse_doubles(s: string) -> string
    let n = len(s)
    if n == 0
        return ""
    let out = slice(s, 0, 1)
    let prev = slice(s, 0, 1)
    for i in 1..n
        let c = slice(s, i, i + 1)
        if c != prev
            out += c
        prev = c
    out

// mra_codex: compute the Match Rating Approach codex for a name.
// Steps: uppercase + strip non-alpha, remove non-leading vowels,
// collapse doubled consonants, if length > 6 keep first 3 + last 3.
fn mra_codex(name: string) -> string
    let cleaned = _mra_clean(name)
    if len(cleaned) == 0
        return ""
    let no_vowels = _mra_remove_vowels(cleaned)
    let collapsed = _mra_collapse_doubles(no_vowels)
    let n = len(collapsed)
    if n <= 6
        return collapsed
    // Keep first 3 + last 3.
    let first3 = slice(collapsed, 0, 3)
    let last3 = slice(collapsed, n - 3, n)
    first3 + last3

// mra_min_rating: the minimum similarity threshold from the MRA specification.
// sumlen is the sum of the two codex lengths.
// sum 4-5 -> 5, sum 6-7 -> 4, sum 8-11 -> 3, sum >= 12 -> 2.
fn mra_min_rating(sumlen: int) -> int
    let r = 2
    if sumlen <= 5
        r = 5
    else if sumlen <= 7
        r = 4
    else if sumlen <= 11
        r = 3
    r

// PRIVATE: convert string to list of single-char strings.
fn _mra_to_list(s: string) -> any
    let n = len(s)
    let xs = [slice(s, i, i + 1) for i in 0..n]
    xs

// PRIVATE: compute the MRA similarity score (0-6) between two codex strings.
// Algorithm:
//   1. Match characters from left, removing matched pairs.
//   2. Match remaining characters from right, removing matched pairs.
//   3. similarity = 6 - floor((unmatched_a + unmatched_b) / 2)
fn _mra_sim(a: string, b: string) -> int
    let xs = _mra_to_list(a)
    let ys = _mra_to_list(b)
    // Left pass: consume matching chars from front.
    let done = 0
    while done == 0
        let xi = len(xs)
        let yi = len(ys)
        if xi == 0 or yi == 0
            done = 1
        else
            let x0 = xs[0]
            let y0 = ys[0]
            if x0 == y0
                let nx = []
                for i in 1..xi
                    push(nx, xs[i])
                let ny = []
                for j in 1..yi
                    push(ny, ys[j])
                xs = nx
                ys = ny
            else
                done = 1
    // Right pass: consume matching chars from back.
    let done2 = 0
    while done2 == 0
        let xi = len(xs)
        let yi = len(ys)
        if xi == 0 or yi == 0
            done2 = 1
        else
            let xlast = xs[xi - 1]
            let ylast = ys[yi - 1]
            if xlast == ylast
                let nx = [xs[i] for i in 0..(xi - 1)]
                let ny = [ys[j] for j in 0..(yi - 1)]
                xs = nx
                ys = ny
            else
                done2 = 1
    // Count unmatched.
    let ua = len(xs)
    let ub = len(ys)
    let sim = 6 - (ua + ub) / 2
    // Clamp to 0.
    if sim < 0
        sim = 0
    sim

// mra_similarity: return the similarity score (0-6) between two names.
fn mra_similarity(name1: string, name2: string) -> int
    let a = mra_codex(name1)
    let b = mra_codex(name2)
    _mra_sim(a, b)

// mra_compare: return 1 if the two names match under MRA rules.
// Conditions: codex length difference <= 3, similarity >= mra_min_rating(sumlen).
fn mra_compare(name1: string, name2: string) -> int
    let a = mra_codex(name1)
    let b = mra_codex(name2)
    let la = len(a)
    let lb = len(b)
    // Check length difference.
    let diff = la - lb
    if diff < 0
        diff = lb - la
    if diff > 3
        return 0
    let sumlen = la + lb
    let min_rating = mra_min_rating(sumlen)
    let sim = _mra_sim(a, b)
    let r = 0
    if sim >= min_rating
        r = 1
    r
