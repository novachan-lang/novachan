// std/phonetic/roman_soundex -- Russell/American Soundex phonetic encoding.
// LEAF -- imports NOTHING.
//
// Public API:
//   rs_digit(ch: string) -> int    Soundex digit for an uppercase letter.
//   rs_encode(name: string) -> string    Standard 4-char Soundex (letter+3 digits).
//   rs_encode_full(name: string) -> string  Soundex without 4-char truncation.
//   rs_difference(a: string, b: string) -> int  Count matching positions (0-4).
//
// Digit table (US NARA / Knuth standard):
//   B F P V           -> 1
//   C G J K Q S X Z   -> 2
//   D T               -> 3
//   L                 -> 4
//   M N               -> 5
//   R                 -> 6
//   A E I O U H W Y   -> 0 (ignored / separator)
//
// Collapsing rules:
//   Adjacent consonants with the same code are collapsed into one digit.
//   H and W are transparent: they do NOT break a same-code run.
//   A, E, I, O, U, Y reset the "last code" so next same-code consonant IS emitted.
//
// The standard 4-char output is: first-letter-uppercased + exactly 3 digits,
// zero-padded on the right if fewer than 3 coded consonants remain.

// Map a single uppercase character to its Soundex digit (0-6).
// 0 means the character is ignored (vowel, H, W, Y) or not a letter.
fn rs_digit(ch: string) -> int
    let r = 0
    if ch == "B" or ch == "F" or ch == "P" or ch == "V"
        r = 1
    else if ch == "C" or ch == "G" or ch == "J" or ch == "K" or ch == "Q" or ch == "S" or ch == "X" or ch == "Z"
        r = 2
    else if ch == "D" or ch == "T"
        r = 3
    else if ch == "L"
        r = 4
    else if ch == "M" or ch == "N"
        r = 5
    else if ch == "R"
        r = 6
    r

// Return 1 if c is H or W (transparent separators), 0 otherwise.
fn _rs_is_hw(c: string) -> int
    let r = 0
    if c == "H" or c == "W"
        r = 1
    r

// Uppercase a single character (A-Z only); non-alpha returned unchanged.
fn _rs_upper(c: string) -> string
    let o = ord(c)
    let r = c
    if o >= 97 and o <= 122
        r = chr(o - 32)
    r

// Compute the full Soundex digit string (no truncation) for the characters
// starting at position 1 of an already-uppercased, non-empty name string.
// prev_code is the Soundex digit of the first letter (used to avoid emitting
// the same code immediately after the first letter).
fn _rs_digits(w: string, start: int, prev_code: int) -> string
    let n = len(w)
    let digits = ""
    let prev = prev_code
    for i in start..n
        let c = _rs_upper(slice(w, i, i + 1))
        let hw = _rs_is_hw(c)
        if hw == 0
            let code = rs_digit(c)
            if code == 0
                // Vowel or Y: reset the same-code run guard.
                prev = 0
            else if code != prev
                digits += str(code)
                prev = code
            // else: same code as previous non-HW non-vowel -> collapse (skip).
        // H or W: do NOT update prev (transparent).
    digits

// Compute the American Soundex code for string s without truncation.
// Returns "0000" for empty or all-non-alpha input.
fn rs_encode_full(name: string) -> string
    let n = len(name)
    let result = "0000"
    if n > 0
        let first = _rs_upper(slice(name, 0, 1))
        let first_code = rs_digit(first)
        let digits = _rs_digits(name, 1, first_code)
        result = first + digits
    result

// Compute the standard 4-character American Soundex code.
// Output: one uppercase letter + exactly 3 digits (zero-padded, truncated as needed).
// Returns "0000" for empty or all-non-alpha input.
fn rs_encode(name: string) -> string
    let n = len(name)
    let result = "0000"
    if n > 0
        let first = _rs_upper(slice(name, 0, 1))
        let first_code = rs_digit(first)
        // Collect up to 3 digits.
        let slen = len(name)
        let digits = ""
        let prev = first_code
        let i = 1
        while i < slen and len(digits) < 3
            let c = _rs_upper(slice(name, i, i + 1))
            let hw = _rs_is_hw(c)
            if hw == 0
                let code = rs_digit(c)
                if code == 0
                    prev = 0
                else if code != prev
                    digits += str(code)
                    prev = code
            i += 1
        // Zero-pad to exactly 3 digits.
        let dlen = len(digits)
        if dlen == 0
            digits = "000"
        else if dlen == 1
            digits += "00"
        else if dlen == 2
            digits += "0"
        result = first + slice(digits, 0, 3)
    result

// Count how many of the 4 Soundex code positions match between two names.
// Returns 0-4.
fn rs_difference(a: string, b: string) -> int
    let ca = rs_encode(a)
    let cb = rs_encode(b)
    let count = 0
    for i in 0..4
        let la = ""
        let lb = ""
        if i < len(ca)
            la = slice(ca, i, i + 1)
        if i < len(cb)
            lb = slice(cb, i, i + 1)
        if la == lb
            count += 1
    count
