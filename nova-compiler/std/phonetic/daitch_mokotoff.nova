// std/phonetic/daitch_mokotoff -- Daitch-Mokotoff (D-M) Soundex phonetic encoding.
// Implements the 1985 D-M Soundex standard for Ashkenazic Jewish surnames.
// Self-contained: imports nothing. All helpers are module-private.
//
// Public API:
//   dm_encode(name: string) -> any
//     Returns a LIST of 6-digit D-M Soundex code strings.
//     D-M can yield multiple codes for ambiguous letter groups (e.g. CH).
//
//   dm_encode_primary(name: string) -> string
//     Returns the first (primary) 6-digit code string.
//
//   dm_code_groups() -> any
//     Returns a dict summarizing the D-M coding table (start/before-vowel/other columns).
//
//   dm_normalize(name: string) -> string
//     Uppercase and strip non-alpha characters.

// PRIVATE: uppercase a single ASCII character.
fn _dm_uc(c: string) -> string
    let o = ord(c)
    let r = c
    if o >= 97 and o <= 122
        r = chr(o - 32)
    r

// PRIVATE: test if character is ASCII alphabetic.
fn _dm_is_alpha(c: string) -> int
    let o = ord(c)
    let r = 0
    if o >= 65 and o <= 90
        r = 1
    if o >= 97 and o <= 122
        r = 1
    r

// PRIVATE: test if uppercase character is a vowel (A E I O U).
fn _dm_is_vowel(c: string) -> int
    let r = 0
    if c == "A" or c == "E" or c == "I" or c == "O" or c == "U"
        r = 1
    r

// dm_normalize: uppercase and keep only alpha characters.
fn dm_normalize(name: string) -> string
    let n = len(name)
    let out = ""
    let i = 0
    while i < n
        let c = slice(name, i, i + 1)
        if _dm_is_alpha(c) == 1
            out = out + _dm_uc(c)
        i = i + 1
    out

// PRIVATE: safe peek of k chars at position i.
fn _dm_peek(s: string, i: int, k: int) -> string
    let n = len(s)
    if i + k <= n
        return slice(s, i, i + k)
    ""

// PRIVATE: pad or truncate a digit string to exactly 6 chars.
fn _dm_pad6(s: string) -> string
    let out = s
    while len(out) < 6
        out = out + "0"
    if len(out) > 6
        out = slice(out, 0, 6)
    out

// PRIVATE: check if list contains a value.
fn _dm_has(xs: any, v: string) -> int
    let n = len(xs)
    let i = 0
    let f = 0
    while i < n
        if xs[i] == v
            f = 1
        i = i + 1
    f

// PRIVATE: deduplicate list preserving first-occurrence order.
fn _dm_dedup(xs: any) -> any
    let out = []
    let n = len(xs)
    for i in 0..n
        if _dm_has(out, xs[i]) == 0
            push(out, xs[i])
    out

// PRIVATE: append digit string to all codes in list.
fn _dm_append(codes: any, d: string) -> any
    let out = []
    let n = len(codes)
    for i in 0..n
        push(out, codes[i] + d)
    out

// PRIVATE: branch codes into two sets (d1 and d2), return combined list.
fn _dm_branch2(codes: any, d1: string, d2: string) -> any
    let out = []
    let n = len(codes)
    for i in 0..n
        push(out, codes[i] + d1)
        push(out, codes[i] + d2)
    out

// dm_encode: return list of 6-digit D-M Soundex codes.
fn dm_encode(name: string) -> any
    let s = dm_normalize(name)
    let n = len(s)
    if n == 0
        let r = []
        push(r, "000000")
        return r
    let codes = []
    push(codes, "")
    let i = 0
    let at_start = 1
    // prev_digit: last non-empty digit appended, used for same-digit deduplication.
    // Vowels (when silent in non-initial position) reset this to "".
    let prev_digit = ""
    while i < n
        // Stop if first code is already full.
        if len(codes[0]) >= 6
            i = n
        else
            let c1 = _dm_peek(s, i, 1)
            let p2 = _dm_peek(s, i, 2)
            let p3 = _dm_peek(s, i, 3)
            let p4 = _dm_peek(s, i, 4)
            let p5 = _dm_peek(s, i, 5)
            let skip_extra = 0  // additional chars beyond first to consume
            // col0=start, col1=before-vowel, col2=other
            let col0 = ""
            let col1 = ""
            let col2 = ""
            let do_branch = 0   // 1 = produce two code paths
            let bcol0 = ""
            let bcol1 = ""
            let bcol2 = ""
            let is_silent_vowel = 0  // 1 = non-initial pure vowel that resets dedup

            // 5-char groups
            if p5 == "SHTSH"
                skip_extra = 4
                col0 = "2"
                col1 = "4"
                col2 = "4"
            // 4-char groups
            else if p4 == "TSCH"
                skip_extra = 3
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p4 == "TRSH" or p4 == "TRZH"
                skip_extra = 3
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p4 == "STRZ" or p4 == "STRS"
                skip_extra = 3
                col0 = "2"
                col1 = "4"
                col2 = "4"
            else if p4 == "ZDZH" or p4 == "ZDSH"
                skip_extra = 3
                col0 = "2"
                col1 = "43"
                col2 = "43"
            // 3-char groups
            else if p3 == "SCH" or p3 == "SHT"
                skip_extra = 2
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p3 == "DZH" or p3 == "DZS" or p3 == "DSH"
                skip_extra = 2
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p3 == "DRZ" or p3 == "DRS"
                skip_extra = 2
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p3 == "CKS" or p3 == "CKZ"
                skip_extra = 2
                col0 = "5"
                col1 = "54"
                col2 = "54"
            else if p3 == "TRZ" or p3 == "TRS"
                skip_extra = 2
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p3 == "ZDZ" or p3 == "ZDS"
                skip_extra = 2
                col0 = "2"
                col1 = "43"
                col2 = "43"
            else if p3 == "SZC" or p3 == "SCS"
                skip_extra = 2
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p3 == "STR"
                skip_extra = 2
                col0 = "2"
                col1 = "4"
                col2 = "4"
            // 2-char groups
            else if p2 == "PH"
                skip_extra = 1
                col0 = "7"
                col1 = "7"
                col2 = "7"
            else if p2 == "TH"
                skip_extra = 1
                col0 = "3"
                col1 = "3"
                col2 = "3"
            else if p2 == "TZ" or p2 == "TS" or p2 == "TC"
                skip_extra = 1
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p2 == "ZD" or p2 == "ZT"
                skip_extra = 1
                col0 = "2"
                col1 = "43"
                col2 = "43"
            else if p2 == "ZH" or p2 == "ZS"
                skip_extra = 1
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p2 == "DZ" or p2 == "DS"
                skip_extra = 1
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p2 == "CK"
                skip_extra = 1
                col0 = "5"
                col1 = "45"
                col2 = "45"
            else if p2 == "CZ" or p2 == "CS"
                skip_extra = 1
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p2 == "CH"
                skip_extra = 1
                col0 = "5"
                col1 = "5"
                col2 = "5"
                do_branch = 1
                bcol0 = "4"
                bcol1 = "4"
                bcol2 = "4"
            else if p2 == "RZ" or p2 == "RS"
                skip_extra = 1
                col0 = "9"
                col1 = "94"
                col2 = "94"
            else if p2 == "MN" or p2 == "NM"
                skip_extra = 1
                col0 = "6"
                col1 = "6"
                col2 = "6"
            else if p2 == "SH" or p2 == "SZ"
                skip_extra = 1
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if p2 == "ST"
                skip_extra = 1
                col0 = "2"
                col1 = "43"
                col2 = "43"
            else if p2 == "KS"
                skip_extra = 1
                col0 = "5"
                col1 = "54"
                col2 = "54"
            else if p2 == "KH"
                skip_extra = 1
                col0 = "5"
                col1 = "5"
                col2 = "5"
            else if p2 == "AI" or p2 == "AJ" or p2 == "AY"
                skip_extra = 1
                col0 = "0"
                col1 = "1"
                col2 = "1"
            else if p2 == "EI" or p2 == "EJ" or p2 == "EY"
                skip_extra = 1
                col0 = "0"
                col1 = "1"
                col2 = "1"
            else if p2 == "OI" or p2 == "OJ" or p2 == "OY"
                skip_extra = 1
                col0 = "0"
                col1 = "1"
                col2 = "1"
            else if p2 == "UI" or p2 == "UJ" or p2 == "UY"
                skip_extra = 1
                col0 = "0"
                col1 = "1"
                col2 = "1"
            // Single characters
            else if c1 == "A" or c1 == "E" or c1 == "I" or c1 == "O" or c1 == "U"
                col0 = "0"
                col1 = ""
                col2 = ""
                is_silent_vowel = 1
            else if c1 == "B" or c1 == "P"
                col0 = "7"
                col1 = "7"
                col2 = "7"
            else if c1 == "C"
                col0 = "5"
                col1 = "4"
                col2 = "4"
            else if c1 == "D"
                col0 = "3"
                col1 = "3"
                col2 = "3"
            else if c1 == "F"
                col0 = "7"
                col1 = "7"
                col2 = "7"
            else if c1 == "G"
                col0 = "5"
                col1 = "5"
                col2 = "5"
            else if c1 == "H"
                col0 = "5"
                col1 = "5"
                col2 = ""
            else if c1 == "J"
                col0 = "1"
                col1 = "1"
                col2 = "1"
            else if c1 == "K"
                col0 = "5"
                col1 = "5"
                col2 = "5"
            else if c1 == "L"
                col0 = "8"
                col1 = "8"
                col2 = "8"
            else if c1 == "M"
                col0 = "6"
                col1 = "6"
                col2 = "6"
            else if c1 == "N"
                col0 = "6"
                col1 = "6"
                col2 = "6"
            else if c1 == "Q"
                col0 = "5"
                col1 = "5"
                col2 = "5"
            else if c1 == "R"
                col0 = "9"
                col1 = "9"
                col2 = "9"
            else if c1 == "S"
                col0 = "4"
                col1 = "4"
                col2 = "4"
            else if c1 == "T"
                col0 = "3"
                col1 = "3"
                col2 = "3"
            else if c1 == "V"
                col0 = "7"
                col1 = "7"
                col2 = "7"
            else if c1 == "W"
                col0 = "7"
                col1 = "7"
                col2 = "7"
            else if c1 == "X"
                col0 = "5"
                col1 = "54"
                col2 = "54"
            else if c1 == "Y"
                col0 = "1"
                col1 = "1"
                col2 = ""
            else if c1 == "Z"
                col0 = "4"
                col1 = "4"
                col2 = "4"
            // Advance position past consumed group.
            i = i + 1 + skip_extra
            // Determine which column to use.
            // Look at char immediately after the consumed group.
            let next_is_v = 0
            if i < n
                let nc = _dm_peek(s, i, 1)
                if _dm_is_vowel(nc) == 1
                    next_is_v = 1
            let digit = ""
            let bdigit = ""
            if at_start == 1
                digit = col0
                if do_branch == 1
                    bdigit = bcol0
            else if next_is_v == 1
                digit = col1
                if do_branch == 1
                    bdigit = bcol1
            else
                digit = col2
                if do_branch == 1
                    bdigit = bcol2
            at_start = 0
            // Non-initial silent vowel: digit="" and is_silent_vowel=1.
            // Reset the dedup guard so same-code consonants separated by a vowel
            // are both emitted (unlike Soundex where H/W are transparent).
            if digit == "" and is_silent_vowel == 1
                prev_digit = ""
            // Emit digit.
            if digit != ""
                if do_branch == 1
                    // Branch: produce both variants. Dedup check skipped at branch point.
                    // KNOWN LIMITATION: prev_digit tracks only the PRIMARY branch digit,
                    // so a later letter whose code equals the SECONDARY branch digit is
                    // not suppressed on the secondary code path. This affects only the
                    // rare names that both take the CH branch and then repeat the
                    // secondary digit; the primary code (the one dm_encode_primary
                    // returns) is always correct.
                    codes = _dm_branch2(codes, digit, bdigit)
                    prev_digit = digit
                else
                    if digit != prev_digit
                        codes = _dm_append(codes, digit)
                        prev_digit = digit
    // Pad all codes to 6 digits and dedup.
    let m = len(codes)
    let out = [_dm_pad6(codes[k]) for k in 0..m]
    _dm_dedup(out)

// dm_encode_primary: return the first 6-digit D-M code.
fn dm_encode_primary(name: string) -> string
    let codes = dm_encode(name)
    if len(codes) == 0
        return "000000"
    codes[0]

// dm_code_groups: return a dict describing the D-M coding table.
fn dm_code_groups() -> any
    let d = {}
    d["A-E-I-O-U"] = "0/0/-"
    d["AI-AJ-AY-EI-OI-UI"] = "0/1/1"
    d["B-P"] = "7/7/7"
    d["C-CZ-CS"] = "5or4/4/4"
    d["CH"] = "5or4/5or4/5or4"
    d["CK"] = "5/45/45"
    d["CKS"] = "5/54/54"
    d["D"] = "3/3/3"
    d["DZ-DS-DZH"] = "4/4/4"
    d["F-PH-V-W"] = "7/7/7"
    d["G"] = "5/5/5"
    d["H"] = "5/5/-"
    d["J"] = "1/1/1"
    d["K-KH-Q"] = "5/5/5"
    d["KS-CKS"] = "5/54/54"
    d["L"] = "8/8/8"
    d["M-N-MN-NM"] = "6/6/6"
    d["R"] = "9/9/9"
    d["RS-RZ"] = "9/94/94"
    d["S-SH-SZ-SCH"] = "4/4/4"
    d["ST"] = "2/43/43"
    d["T-TH"] = "3/3/3"
    d["TZ-TS-TC"] = "4/4/4"
    d["X"] = "5/54/54"
    d["Y"] = "1/1/-"
    d["Z-ZH-ZS"] = "4/4/4"
    d["ZD-ZT"] = "2/43/43"
    d
