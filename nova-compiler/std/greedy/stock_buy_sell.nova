// std/greedy/stock_buy_sell.nova — greedy stock-trading profit algorithms. LEAF — imports NOTHING.

// sb_one_transaction: max profit from at most ONE buy then sell (buy low sell high, in order).
//   Returns 0 if no profitable trade exists or prices is empty.
fn sb_one_transaction(prices: list) -> int
    let n = len(prices)
    if n < 2
        return 0
    let min_price = prices[0]
    let max_profit = 0
    for i in 1..n
        let p = prices[i]
        let profit = p - min_price
        if profit > max_profit
            max_profit = profit
        if p < min_price
            min_price = p
    return max_profit

// sb_multi_transaction: max profit from unlimited buy/sell transactions (no overlap).
//   Greedily captures every upward run: sum of all positive daily differences.
fn sb_multi_transaction(prices: list) -> int
    let n = len(prices)
    if n < 2
        return 0
    let total = 0
    for i in 1..n
        let diff = prices[i] - prices[i - 1]
        if diff > 0
            total += diff
    return total

// sb_with_fee: max profit from unlimited transactions each with a flat per-transaction fee.
//   Uses a two-state DP: cash = best profit while not holding; hold = best profit while holding.
fn sb_with_fee(prices: list, fee: int) -> int
    let n = len(prices)
    if n < 2
        return 0
    // cash: best profit when not holding stock (start with 0)
    // hold: best profit when holding stock (start by buying day 0)
    let cash = 0
    let hold = 0 - prices[0]
    for i in 1..n
        let p = prices[i]
        // sell: hold + p - fee vs stay cash
        let new_cash = cash
        let sell_val = hold + p - fee
        if sell_val > new_cash
            new_cash = sell_val
        // buy: cash - p vs stay hold
        let new_hold = hold
        let buy_val = cash - p
        if buy_val > new_hold
            new_hold = buy_val
        cash = new_cash
        hold = new_hold
    return cash
