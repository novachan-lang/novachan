// std/greedy/meeting_rooms.nova — Meeting rooms scheduling. LEAF — imports NOTHING.
// Meetings given as parallel arrays: starts[i] = start time, ends[i] = end time.
// Prefix: mr_

// _mr_sort_indices_by_start: return an index array sorted by starts[idx] ascending.
// Uses insertion sort on the index array; no negative-sentinel footgun.
fn _mr_sort_indices_by_start(starts: list) -> list
    let n = len(starts)
    let idx = []
    let k = 0
    while k < n
        push(idx, k)
        k = k + 1
    let j = 1
    while j < n
        let key_idx = idx[j]
        let key_val = starts[key_idx]
        let pos = j
        let i = j - 1
        let done = false
        while i >= 0 and done == false
            let other_idx = idx[i]
            let other_val = starts[other_idx]
            if other_val > key_val
                idx[i + 1] = idx[i]
                pos = i
                i = i - 1
            else
                done = true
        idx[pos] = key_idx
        j = j + 1
    return idx

// mr_can_attend_all: true if no two meetings overlap (a person can attend every meeting).
// Two meetings overlap if one starts before the other ends (strict: start < prev_end).
// Sort by start time; check each consecutive pair.
fn mr_can_attend_all(starts: list, ends: list) -> bool
    let n = len(starts)
    if n <= 1
        return true
    let idx = _mr_sort_indices_by_start(starts)
    let i = 1
    while i < n
        let prev = idx[i - 1]
        let cur = idx[i]
        if starts[cur] < ends[prev]
            return false
        i = i + 1
    return true

// _mr_sort_all_events: build a sorted event list from starts and ends.
// Each event is [time, type]: type=0 for end, type=1 for start.
// Ends before starts at same time so a room freed is reused immediately.
// Returns sorted list of [time, type] events (insertion sort, no neg sentinel).
fn _mr_sort_all_events(starts: list, ends: list) -> list
    let n = len(starts)
    let events = []
    let k = 0
    while k < n
        let ev_s = []
        push(ev_s, starts[k])
        push(ev_s, 1)
        push(events, ev_s)
        let ev_e = []
        push(ev_e, ends[k])
        push(ev_e, 0)
        push(events, ev_e)
        k = k + 1
    // insertion sort: by time asc; tie-break: end (type=0) before start (type=1)
    let ne = len(events)
    let j = 1
    while j < ne
        let key = events[j]
        let kt = key[0]
        let ktype = key[1]
        let pos = j
        let i = j - 1
        let done = false
        while i >= 0 and done == false
            let other = events[i]
            let ot = other[0]
            let otype = other[1]
            let shift = false
            if ot > kt
                shift = true
            if ot == kt and otype > ktype
                shift = true
            if shift
                events[i + 1] = events[i]
                pos = i
                i = i - 1
            else
                done = true
        events[pos] = key
        j = j + 1
    return events

// mr_min_rooms: minimum number of meeting rooms needed so no two overlapping
// meetings share a room.  Equals the maximum number of concurrently active meetings.
// Uses event sweep: end events (type=0) processed before start events (type=1)
// at the same time so a room freed at T is available for a meeting starting at T.
fn mr_min_rooms(starts: list, ends: list) -> int
    let n = len(starts)
    if n == 0
        return 0
    let events = _mr_sort_all_events(starts, ends)
    let ne = len(events)
    let cur = 0
    let best = 0
    let i = 0
    while i < ne
        let ev = events[i]
        if ev[1] == 1
            cur = cur + 1
            if cur > best
                best = cur
        else
            cur = cur - 1
        i = i + 1
    return best
