// std/greedy/activity_selection.nova — Greedy activity selection by earliest finish time.
// Activities are given as parallel arrays starts[] and ends[].
// Touching is allowed: a new activity may start exactly when the previous one ends.
// LEAF — imports NOTHING.

// _as_sort_by_end: return an index array sorted by ends[i] ascending (selection sort).
fn _as_sort_by_end(ends: list) -> list
    let n = len(ends)
    let order = [i for i in 0..n]
    for pos in 0..n
        let best = pos
        let j = pos + 1
        while j < n
            if ends[order[j]] < ends[order[best]]
                best = j
            j = j + 1
        let tmp = order[pos]
        order[pos] = order[best]
        order[best] = tmp
    return order

// as_max_count: maximum number of non-overlapping activities (greedy by earliest finish).
fn as_max_count(starts: list, ends: list) -> int
    let n = len(starts)
    if n == 0
        return 0
    let order = _as_sort_by_end(ends)
    let count = 1
    let last_end = ends[order[0]]
    for i in 1..n
        let idx = order[i]
        if starts[idx] >= last_end
            count = count + 1
            last_end = ends[idx]
    return count

// as_selected: list of original indices chosen by greedy activity selection (earliest finish).
// Indices are returned in the order they are selected (by finish time).
fn as_selected(starts: list, ends: list) -> list
    let n = len(starts)
    let result = []
    if n == 0
        return result
    let order = _as_sort_by_end(ends)
    let first = order[0]
    push(result, first)
    let last_end = ends[first]
    for i in 1..n
        let idx = order[i]
        if starts[idx] >= last_end
            push(result, idx)
            last_end = ends[idx]
    return result
