// std/greedy/gas_station.nova — Circular gas station route feasibility (greedy O(n)).
// gas[i] = fuel available at station i; cost[i] = fuel to travel from i to i+1.
// There is at most one valid starting index when a solution exists.
// LEAF — imports NOTHING.

// _gs_total_net: sum of (gas[i] - cost[i]) over all stations.
fn _gs_total_net(gas: list, cost: list) -> int
    let n = len(gas)
    let total = 0
    let i = 0
    while i < n
        total = total + gas[i] - cost[i]
        i = i + 1
    return total

// gs_can_complete: true iff there exists at least one starting station that can complete the circuit.
fn gs_can_complete(gas: list, cost: list) -> bool
    let n = len(gas)
    if n == 0
        return false
    return _gs_total_net(gas, cost) >= 0

// gs_start_index: the unique index from which the circuit can be completed, or -1 if impossible.
// Uses the standard single-pass greedy: whenever cumulative tank goes negative, reset to next station.
fn gs_start_index(gas: list, cost: list) -> int
    let n = len(gas)
    if n == 0
        return -1
    if _gs_total_net(gas, cost) < 0
        return -1
    let tank = 0
    let start = 0
    let i = 0
    while i < n
        tank = tank + gas[i] - cost[i]
        if tank < 0
            start = i + 1
            tank = 0
        i = i + 1
    return start
