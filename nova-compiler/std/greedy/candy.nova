// std/greedy/candy.nova — Candy distribution: each child gets >= 1 candy;
// a child with strictly higher rating than a neighbor gets strictly more candy.
// Two-pass greedy: left-to-right then right-to-left, take element-wise max.
// LEAF — imports NOTHING.

// cd_distribution: per-child candy counts satisfying the neighbor constraint.
fn cd_distribution(ratings: list) -> list
    let n = len(ratings)
    if n == 0
        return []
    // initialize all to 1
    let candies = []
    let i = 0
    while i < n
        push(candies, 1)
        i += 1
    // left-to-right pass: if rating[i] > rating[i-1], candy[i] = candy[i-1] + 1
    for i2 in 1..n
        if ratings[i2] > ratings[i2 - 1]
            candies[i2] = candies[i2 - 1] + 1
    // right-to-left pass: if rating[i] > rating[i+1], candy[i] = max(candy[i], candy[i+1] + 1)
    let i3 = n - 2
    while i3 >= 0
        if ratings[i3] > ratings[i3 + 1]
            let need = candies[i3 + 1] + 1
            if need > candies[i3]
                candies[i3] = need
        i3 -= 1
    return candies

// cd_min_candies: minimum total candies required for the given ratings array.
fn cd_min_candies(ratings: list) -> int
    let dist = cd_distribution(ratings)
    let total = 0
    for i in 0..len(dist)
        total += dist[i]
    return total
