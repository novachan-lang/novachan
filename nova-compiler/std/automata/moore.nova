// std/automata/moore — Moore Machine
//
// A Moore machine produces output per state (output depends only on the
// current state, not on the input symbol), in contrast to Mealy machines
// where output depends on both state and input.
//
// Representation: a dict with three entries:
//   "start"   -> string: the start state name
//   "output"  -> dict:   state_name -> output_string
//   "trans"   -> dict:   "<state>:<input>" -> nextState
//
// mor_run returns the concatenation of outputs for each state VISITED,
// including the start state. For an input string of length N, exactly
// N+1 state outputs are concatenated (start + one per symbol consumed).
// If a transition is missing the machine is "stuck" and "" is returned.
//
// All public functions are prefixed mor_.

// Create a new Moore machine with the given start state.
fn mor_new(start) -> dict
    return {"start": start, "output": {}, "trans": {}}

// Set the output string for a given state.
fn mor_set_output(m, state, output)
    let outs = m["output"]
    outs[state] = output
    m["output"] = outs

// Add a transition: in fromState on inputSym go to nextState.
// (Output is registered separately via mor_set_output.)
fn mor_add(m, state, input, nextState)
    let key = state + ":" + input
    let tr = m["trans"]
    tr[key] = nextState
    m["trans"] = tr

// Run the Moore machine on input string.
// Returns the concatenation of the output of each state visited
// (start state first, then one per input symbol consumed),
// so len(result_states) == len(input) + 1.
// Returns "" if any required transition or state output is missing.
fn mor_run(m, input) -> string
    let cur = m["start"]
    let tr = m["trans"]
    let outs = m["output"]
    let n = len(input)
    // Emit the output of the start state.
    if cur not in outs
        return ""
    let out = outs[cur]
    for i in 0..n
        let sym = slice(input, i, i + 1)
        let key = cur + ":" + sym
        if key not in tr
            return ""
        cur = tr[key]
        if cur not in outs
            return ""
        out += outs[cur]
    return out

// Run the Moore machine on input string and return only the output
// of the FINAL state reached (not the full concatenation).
// Returns "" if any required transition or state output is missing.
fn mor_final_output(m, input) -> string
    let cur = m["start"]
    let tr = m["trans"]
    let outs = m["output"]
    let n = len(input)
    for i in 0..n
        let sym = slice(input, i, i + 1)
        let key = cur + ":" + sym
        if key not in tr
            return ""
        cur = tr[key]
    if cur in outs
        return outs[cur]
    return ""
