// std/automata/wildcard.nova
// Wildcard matching engine with DP (* and ? only).
// * matches any run of characters including empty.
// ? matches exactly one character.
// Distinct from fnmatch which also handles [] character classes.
// PREFIX: wild_

// wild_has_wildcard(pattern) -> bool (1/0)
// Returns 1 if pattern contains * or ? wildcards, 0 otherwise.
fn wild_has_wildcard(pattern)
    let n = len(pattern)
    let i = 0
    let found = 0
    while i < n
        let ch = slice(pattern, i, i + 1)
        if ch == "*"
            found = 1
        if ch == "?"
            found = 1
        i = i + 1
    return found

// _wild_to_lower(s) -> string
// Convert string to lowercase ASCII (A-Z -> a-z).
fn _wild_to_lower(s)
    let n = len(s)
    let result = ""
    let i = 0
    while i < n
        let ch = slice(s, i, i + 1)
        let o = ord(ch)
        if o >= 65 and o <= 90
            result = result + chr(o + 32)
        else
            result = result + ch
        i = i + 1
    return result

// wild_match(pattern, text) -> bool (1/0)
// DP wildcard match. Uses a dict as a 2D boolean table.
// dp["i,j"] = 1 means pattern[0..i) matches text[0..j).
fn wild_match(pattern, text)
    let pn = len(pattern)
    let tn = len(text)
    let dp = {}

    // Base: empty pattern matches empty text
    dp["0,0"] = 1

    // dp["i,0"]: pattern[0..i) matches empty string only if
    // pattern[0..i-1) matched empty AND pattern[i-1]=='*'
    let i = 1
    while i <= pn
        let prev_key = str(i - 1) + ",0"
        if contains(dp, prev_key)
            let pch = slice(pattern, i - 1, i)
            if pch == "*"
                dp[str(i) + ",0"] = 1
        i = i + 1

    // Fill DP table row by row
    let i = 1
    while i <= pn
        let pch = slice(pattern, i - 1, i)
        let j = 1
        while j <= tn
            let tch = slice(text, j - 1, j)
            let val = 0
            if pch == "*"
                // * matches empty: check dp[i-1][j]
                let k1 = str(i - 1) + "," + str(j)
                if contains(dp, k1)
                    val = 1
                // * matches one more char: check dp[i][j-1]
                if val == 0
                    let k2 = str(i) + "," + str(j - 1)
                    if contains(dp, k2)
                        val = 1
            else
                if pch == "?"
                    // ? matches exactly one char: check dp[i-1][j-1]
                    let k1 = str(i - 1) + "," + str(j - 1)
                    if contains(dp, k1)
                        val = 1
                else
                    // literal: chars must match + check dp[i-1][j-1]
                    if pch == tch
                        let k1 = str(i - 1) + "," + str(j - 1)
                        if contains(dp, k1)
                            val = 1
            if val == 1
                dp[str(i) + "," + str(j)] = 1
            j = j + 1
        i = i + 1

    let result_key = str(pn) + "," + str(tn)
    if contains(dp, result_key)
        return 1
    return 0

// wild_match_ci(pattern, text) -> bool (1/0)
// Case-insensitive wildcard match.
fn wild_match_ci(pattern, text)
    let lp = _wild_to_lower(pattern)
    let lt = _wild_to_lower(text)
    return wild_match(lp, lt)
