// std/tree/tree_count.nova — Node/degree counting queries on unrooted trees.
//
// Tree representation: adj is a list of lists (undirected adjacency list).
//   adj[i] = list of neighbor node ids for node i.
//   n = number of nodes (ids 0..n-1). A single-node tree has adj=[[]] and n=1.
//
// Public API:
//   tcnt_leaves(adj, n)              -> int   number of degree-1 nodes (single node counts as 1)
//   tcnt_internal(adj, n)            -> int   number of nodes with degree >= 2 (n - leaves)
//   tcnt_degree(adj, n, node)        -> int   degree of the given node
//   tcnt_nodes_at_depth(adj, n, root, d) -> int  count of nodes at BFS depth d from root

// tcnt_leaves(adj, n) -- count nodes with degree 1; a single node (n=1) counts as 1 leaf.
fn tcnt_leaves(adj, n)
    if n == 1
        return 1
    let count = 0
    for i in 0..n
        if len(adj[i]) == 1
            count += 1
    return count

// tcnt_internal(adj, n) -- count nodes with degree >= 2 (n minus the leaf count).
fn tcnt_internal(adj, n)
    return n - tcnt_leaves(adj, n)

// tcnt_degree(adj, n, node) -- degree of node (number of neighbors).
fn tcnt_degree(adj, n, node)
    return len(adj[node])

// tcnt_nodes_at_depth(adj, n, root, d) -- count of nodes at BFS depth d from root.
fn tcnt_nodes_at_depth(adj, n, root, d)
    if d == 0
        return 1
    let depth = [-1 for i in 0..n]
    depth[root] = 0
    let queue = []
    push(queue, root)
    let head = 0
    while head < len(queue)
        let u = queue[head]
        head += 1
        if depth[u] < d
            let nbrs = adj[u]
            for k in 0..len(nbrs)
                let v = nbrs[k]
                if depth[v] == -1
                    depth[v] = depth[u] + 1
                    push(queue, v)
    let count = 0
    for j in 0..n
        if depth[j] == d
            count += 1
    return count
