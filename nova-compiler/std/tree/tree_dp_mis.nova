// std/tree/tree_dp_mis.nova — Maximum Independent Set on a tree via DP.
//
// An independent set is a subset of nodes where no two are adjacent.
// Tree DP: for each node v (rooted at 0), maintain:
//   dp_in[v]  = max IS size/weight when v IS in the set
//   dp_out[v] = max IS size/weight when v is NOT in the set
//
// dp_in[v]  = weight[v] + sum over children c of dp_out[c]
// dp_out[v] = sum over children c of max(dp_in[c], dp_out[c])
//
// Tree representation: adj[i] = list of integer neighbors (undirected).
// n = node count (0..n-1). Root = 0. No imports required.
//
// Public API:
//   tm_mis_size(adj, n)               -> int max independent set size
//   tm_mis_weighted(adj, n, weights)  -> int max weight independent set
//
// Private prefix: _tm_

// _tm_fill: build a list of n integers all set to val.
fn _tm_fill(n, val)
    let lst = []
    for i in 0..n
        lst.push(val)
    return lst

// _tm_bfs_order: BFS from root 0, returns [order, par].
// order = BFS traversal order (parent before children).
fn _tm_bfs_order(adj, n)
    let par   = _tm_fill(n, -1)
    let vis   = _tm_fill(n, 0)
    let order = []
    let queue = []
    queue.push(0)
    vis[0] = 1
    for qi in 0..len(queue)
        let u = queue[qi]
        order.push(u)
        let nbrs = adj[u]
        for j in 0..len(nbrs)
            let v = nbrs[j]
            if vis[v] == 0
                vis[v] = 1
                par[v] = u
                queue.push(v)
    let res = []
    res.push(order)
    res.push(par)
    return res

// _tm_run: core DP — returns max IS total weight given per-node weights.
fn _tm_run(adj, n, weights)
    if n == 1
        return weights[0]
    let info  = _tm_bfs_order(adj, n)
    let order = info[0]
    let par   = info[1]
    let dp_in  = _tm_fill(n, 0)
    let dp_out = _tm_fill(n, 0)
    // initialize leaves with their own weight
    for i in 0..n
        dp_in[i] = weights[i]
    // process in reverse BFS order (children before parents)
    let oi = len(order) - 1
    while oi >= 0
        let v = order[oi]
        let p = par[v]
        if p >= 0
            // contribute to parent
            dp_in[p]  = dp_in[p] + dp_out[v]
            let best_v = dp_in[v]
            if dp_out[v] > best_v
                best_v = dp_out[v]
            dp_out[p] = dp_out[p] + best_v
        oi -= 1
    let ans = dp_in[0]
    if dp_out[0] > ans
        ans = dp_out[0]
    return ans

// tm_mis_size: maximum independent set SIZE (unweighted — each node has weight 1).
fn tm_mis_size(adj, n)
    if n == 0
        return 0
    let weights = _tm_fill(n, 1)
    return _tm_run(adj, n, weights)

// tm_mis_weighted: maximum independent set total WEIGHT given per-node weights list.
fn tm_mis_weighted(adj, n, weights)
    if n == 0
        return 0
    return _tm_run(adj, n, weights)
