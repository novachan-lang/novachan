// std/tree/tree_subtree.nova — Subtree sizes and subtree sums for rooted trees.
//
// Tree representation: adj[i] = list of neighbor integers (undirected, symmetric).
// n = node count (0..n-1). root = designated root node id.
//
// Public API:
//   ts_sizes(adj, n, root)         -> list  ts_sizes[i] = size of subtree rooted at node i
//   ts_size(adj, n, root, node)    -> int   size of the subtree rooted at `node`
//   ts_sum(adj, n, root, values)   -> int   sum of values[i] for all i in tree
//                                            (equals sum of the whole tree, since subtree
//                                            of root covers all nodes; provided as per spec)
//
// Algorithm: iterative postorder DFS to compute subtree sizes bottom-up.
// Each node's subtree size = 1 + sum of children's subtree sizes.
//
// Module-private prefix: _ts_

// _ts_isort_asc: insertion-sort a list of integers ascending (in-place).
fn _ts_isort_asc(xs)
    let sz = len(xs)
    let i = 1
    while i < sz
        let key = xs[i]
        let j = i - 1
        let done = 0
        while done == 0
            if j < 0
                done = 1
            else
                if xs[j] > key
                    xs[j + 1] = xs[j]
                    j = j - 1
                else
                    done = 1
        xs[j + 1] = key
        i = i + 1

// _ts_children_of: return sorted ascending children of node u given parent par.
fn _ts_children_of(adj, u, par) -> list
    let nbrs = adj[u]
    let ch = []
    let i = 0
    while i < len(nbrs)
        let v = nbrs[i]
        if v != par
            push(ch, v)
        i = i + 1
    _ts_isort_asc(ch)
    return ch

// _ts_compute_sizes: compute subtree size for every node via iterative postorder.
// Returns a list of size n where result[i] = subtree size rooted at node i.
fn _ts_compute_sizes(adj, n, root) -> list
    let sz = []
    let i = 0
    while i < n
        push(sz, 1)
        i = i + 1
    // Use iterative postorder: stack stores [node, parent, phase].
    // phase=0: push children and flip to phase=1.
    // phase=1: accumulate into parent's size.
    // We simulate this with a two-list approach: visit_order = postorder sequence,
    // parent_of = parent for each node (to know whose size to update).
    let parent_of = []
    let pi = 0
    while pi < n
        push(parent_of, -1)
        pi = pi + 1
    // Build visit_order (postorder) via iterative DFS.
    let visit_order = []
    let stack = []
    push(stack, root)
    parent_of[root] = -1
    while len(stack) > 0
        let u = stack[len(stack) - 1]
        stack = stack[0:len(stack) - 1]
        push(visit_order, u)
        let ch = _ts_children_of(adj, u, parent_of[u])
        // push children so smallest is processed first -> push reverse order
        let ci = len(ch) - 1
        while ci >= 0
            let v = ch[ci]
            parent_of[v] = u
            push(stack, v)
            ci = ci - 1
    // visit_order is preorder; reverse to get postorder
    let n_v = len(visit_order)
    let oi = n_v - 1
    while oi >= 0
        let u = visit_order[oi]
        let p = parent_of[u]
        if p != -1
            sz[p] = sz[p] + sz[u]
        oi = oi - 1
    return sz

// ts_sizes: returns the subtree-size list for all nodes (indexed by node id).
fn ts_sizes(adj, n, root) -> list
    return _ts_compute_sizes(adj, n, root)

// ts_size: returns the subtree size of a single node.
fn ts_size(adj, n, root, node) -> int
    let s = _ts_compute_sizes(adj, n, root)
    return s[node]

// ts_sum: returns the sum of values[] over all nodes in the subtree rooted at `root`.
// Since root's subtree covers the whole tree, this is sum(values).
// Implemented via the same postorder pass; each node accumulates value sums.
fn ts_sum(adj, n, root, values) -> int
    // Compute subtree value sums bottom-up, mirroring _ts_compute_sizes.
    let vsum = []
    let i = 0
    while i < n
        push(vsum, values[i])
        i = i + 1
    let parent_of = []
    let pi = 0
    while pi < n
        push(parent_of, -1)
        pi = pi + 1
    let visit_order = []
    let stack = []
    push(stack, root)
    parent_of[root] = -1
    while len(stack) > 0
        let u = stack[len(stack) - 1]
        stack = stack[0:len(stack) - 1]
        push(visit_order, u)
        let ch = []
        let nbrs = adj[u]
        let ni = 0
        while ni < len(nbrs)
            let v = nbrs[ni]
            if v != parent_of[u]
                push(ch, v)
            ni = ni + 1
        _ts_isort_asc(ch)
        let ci = len(ch) - 1
        while ci >= 0
            let v = ch[ci]
            parent_of[v] = u
            push(stack, v)
            ci = ci - 1
    let n_v = len(visit_order)
    let oi = n_v - 1
    while oi >= 0
        let u = visit_order[oi]
        let p = parent_of[u]
        if p != -1
            vsum[p] = vsum[p] + vsum[u]
        oi = oi - 1
    return vsum[root]
