// std/tree/tree_dp_cover.nova — Minimum Vertex Cover and Maximum Matching on a tree via tree DP.
//
// Tree representation: adj[i] = list of integer neighbors of node i (undirected, 0..n-1).
// n = number of nodes. No imports required.
//
// On a tree (bipartite graph), by König's theorem:
//   MVC + MIS = n   and   MVC = Max Matching.
//
// Algorithm: iterative post-order DP.
//   dp0[v] = min cover of v's subtree when v is NOT in the cover.
//   dp1[v] = min cover of v's subtree when v IS in the cover.
//   If v not in cover: every child c must be in cover (to cover edge v-c):  dp0[v] = sum(dp1[c]).
//   If v in cover: each child c picks the cheaper option:                    dp1[v] = 1 + sum(min(dp0[c], dp1[c])).
//   choice[v] = 0 or 1: which option was used (for cover_set backtrack).
//
// Public API:
//   tv_min_vertex_cover(adj, n) -> int          size of a minimum vertex cover
//   tv_max_matching(adj, n)     -> int          size of a maximum matching (= MVC by König)
//   tv_cover_set(adj, n)        -> list         a minimum vertex cover as sorted node list
//
// Private prefix: _tv_

// _tv_fill: build a list of n elements all set to val.
fn _tv_fill(n, val) -> list
    let lst = []
    let i = 0
    while i < n
        push(lst, val)
        i = i + 1
    return lst

// _tv_post_order: iterative DFS to get nodes in post-order and record parents.
// Returns [order_list, par_list] where order_list is post-order traversal.
fn _tv_post_order(adj, n, root) -> list
    let par = _tv_fill(n, -1)
    let vis = _tv_fill(n, 0)
    let stk = []
    let order = []
    push(stk, root)
    vis[root] = 1
    while len(stk) > 0
        let top = len(stk) - 1
        let u = stk[top]
        stk = stk[0:top]
        push(order, u)
        let nbrs = adj[u]
        let j = 0
        while j < len(nbrs)
            let v = nbrs[j]
            if vis[v] == 0
                vis[v] = 1
                par[v] = u
                push(stk, v)
            j = j + 1
    let res = []
    push(res, order)
    push(res, par)
    return res

// _tv_run_dp: run the vertex cover tree DP, return [dp0, dp1, choice].
// choice[v] = 0 if we chose NOT to include v; 1 if we chose to include v.
// For the chosen option: if dp0[v] <= dp1[v] then choice[v]=0, else choice[v]=1.
fn _tv_run_dp(adj, n) -> list
    if n == 1
        let dp0 = _tv_fill(1, 0)
        let dp1 = _tv_fill(1, 1)
        let ch  = _tv_fill(1, 0)
        let res = []
        push(res, dp0)
        push(res, dp1)
        push(res, ch)
        return res
    let info = _tv_post_order(adj, n, 0)
    let order = info[0]
    let par   = info[1]
    let dp0 = _tv_fill(n, 0)
    let dp1 = _tv_fill(n, 1)
    let ch  = _tv_fill(n, 0)
    // process in reverse post-order = bottom-up (leaves first)
    let oi = len(order) - 1
    while oi >= 0
        let v = order[oi]
        let nbrs = adj[v]
        let j = 0
        while j < len(nbrs)
            let c = nbrs[j]
            if c != par[v]
                // c is a child of v
                // v not in cover: child must be in cover
                dp0[v] = dp0[v] + dp1[c]
                // v in cover: child takes cheaper option
                let cheaper = dp0[c]
                if dp1[c] < dp0[c]
                    cheaper = dp1[c]
                dp1[v] = dp1[v] + cheaper
            j = j + 1
        // record choice for backtracking
        if dp0[v] <= dp1[v]
            ch[v] = 0
        else
            ch[v] = 1
        oi = oi - 1
    let res = []
    push(res, dp0)
    push(res, dp1)
    push(res, ch)
    return res

// tv_min_vertex_cover: returns the size of a minimum vertex cover of the tree.
fn tv_min_vertex_cover(adj, n) -> int
    if n == 0
        return 0
    let dp_info = _tv_run_dp(adj, n)
    let dp0 = dp_info[0]
    let dp1 = dp_info[1]
    if dp0[0] <= dp1[0]
        return dp0[0]
    return dp1[0]

// tv_max_matching: returns the size of a maximum matching.
// By König's theorem on trees (bipartite), max matching = min vertex cover.
fn tv_max_matching(adj, n) -> int
    return tv_min_vertex_cover(adj, n)

// _tv_insertion_sort: sort a list of ints in-place ascending via insertion sort.
fn _tv_insertion_sort(lst) -> list
    let n = len(lst)
    let i = 1
    while i < n
        let key = lst[i]
        let j = i - 1
        while j >= 0 and lst[j] > key
            lst[j + 1] = lst[j]
            j = j - 1
        lst[j + 1] = key
        i = i + 1
    return lst

// tv_cover_set: returns a minimum vertex cover as a sorted list of node indices.
// Reconstructs the chosen set by backtracking from root 0 down the tree.
// Rule: if v is chosen (in cover), children can be anything per their dp choice.
//       if v is NOT chosen, every child must be in the cover.
fn tv_cover_set(adj, n) -> list
    if n == 0
        return []
    let dp_info = _tv_run_dp(adj, n)
    let dp0 = dp_info[0]
    let dp1 = dp_info[1]
    let ch  = dp_info[2]
    // We need parent info too — re-run post_order to get par
    let info = _tv_post_order(adj, n, 0)
    let order = info[0]
    let par   = info[1]
    // chosen[v] = 1 if v is in the cover
    let chosen = _tv_fill(n, -1)
    // Decide for root 0
    if dp0[0] <= dp1[0]
        chosen[0] = 0
    else
        chosen[0] = 1
    // Process in DFS order (pre-order = order list reversed, since post-order was stored)
    // Actually order is in pre-ish order (DFS push order reversed due to stack) —
    // use the order list directly (it is pre-order from the iterative DFS using stack).
    // The DFS stack produces a reversed-preorder; let's process order forward for parent->child.
    let oi = 0
    while oi < len(order)
        let v = order[oi]
        let nbrs = adj[v]
        let j = 0
        while j < len(nbrs)
            let c = nbrs[j]
            if c != par[v]
                // c is a child of v
                if chosen[v] == 0
                    // v not in cover, child MUST be in cover
                    chosen[c] = 1
                else
                    // v in cover, child picks its own optimal choice
                    chosen[c] = ch[c]
            j = j + 1
        oi = oi + 1
    // Collect all nodes with chosen=1
    let cover = []
    let k = 0
    while k < n
        if chosen[k] == 1
            push(cover, k)
        k = k + 1
    _tv_insertion_sort(cover)
    return cover
