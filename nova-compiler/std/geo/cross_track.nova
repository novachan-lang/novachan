// std/geo/cross_track.nova — Cross-track distance (signed, meters) from a
// point to a great-circle path defined by two endpoint coordinates.
//
// FLOAT HAZARDS obeyed throughout:
//   * All float constants defined inside fn bodies (module-level truncates to int).
//   * Every sqrt/sin/cos/atan2 result bound to a named let.
//   * Never return a bare multi-term float expression — bind to result let.
//   * NOVA has no asin/acos builtins — inline via atan2.
//   * Float abs: use (if x<0.0 then 0.0-x else x).
//   * CRITICAL: do NOT call helper fns that use atan2 and combine their results
//     in another atan2 — codegen float-slot aliasing causes wrong values.
//     All atan2 usage is INLINED into a single function body.
//
// API:
//   cross_track(lat, lon, lat1, lon1, lat2, lon2) -> float
//     Signed perpendicular distance in meters from point (lat,lon) to the
//     great-circle path defined by (lat1,lon1)->(lat2,lon2).
//     Positive = point is to the right of the path direction.
//     Magnitude = how far off-track (meters).

// cross_track: signed perpendicular distance in meters from point (lat,lon) to
// the great-circle path (lat1,lon1)->(lat2,lon2).
// Formula: d_xt = asin( sin(d13) * sin(θ13 − θ12) ) * R
// where d13 = angular distance from start to point (radians),
//       θ13  = bearing start→point (radians),
//       θ12  = bearing start→end (radians).
// All trigonometric helpers are fully inlined to avoid atan2 slot aliasing.
fn cross_track(lat: float, lon: float, lat1: float, lon1: float, lat2: float, lon2: float) -> float
    let PI = 3.14159265358979
    let R = 6371000.0
    // Convert all coords to radians
    let rlat = lat * PI / 180.0
    let rlon = lon * PI / 180.0
    let rlat1 = lat1 * PI / 180.0
    let rlon1 = lon1 * PI / 180.0
    let rlat2 = lat2 * PI / 180.0
    let rlon2 = lon2 * PI / 180.0
    // ── d13: haversine angular distance from start to point (radians) ────────
    let dlat13 = rlat - rlat1
    let dlon13 = rlon - rlon1
    let sdlat13 = dlat13 / 2.0
    let sdlon13 = dlon13 / 2.0
    let sin_sdlat13 = sin(sdlat13)
    let sin_sdlon13 = sin(sdlon13)
    let sin_sdlat13_sq = sin_sdlat13 * sin_sdlat13
    let sin_sdlon13_sq = sin_sdlon13 * sin_sdlon13
    let cosLat1 = cos(rlat1)
    let cosLat = cos(rlat)
    let a13 = sin_sdlat13_sq + cosLat1 * cosLat * sin_sdlon13_sq
    let b13 = 1.0 - a13
    let sqA13 = sqrt(a13)
    let sqB13 = sqrt(b13)
    let c13 = atan2(sqA13, sqB13)
    let d13 = c13 * 2.0
    // ── θ13: bearing from start to point ─────────────────────────────────────
    let sinDlon13 = sin(dlon13)
    let cosDlon13 = cos(dlon13)
    let sinLat1 = sin(rlat1)
    let sinLat = sin(rlat)
    let x13 = sinDlon13 * cosLat
    let y13 = cosLat1 * sinLat - sinLat1 * cosLat * cosDlon13
    let theta13 = atan2(x13, y13)
    // ── θ12: bearing from start to end ────────────────────────────────────────
    let dlon12 = rlon2 - rlon1
    let sinDlon12 = sin(dlon12)
    let cosDlon12 = cos(dlon12)
    let cosLat2 = cos(rlat2)
    let sinLat2 = sin(rlat2)
    let x12 = sinDlon12 * cosLat2
    let y12 = cosLat1 * sinLat2 - sinLat1 * cosLat2 * cosDlon12
    let theta12 = atan2(x12, y12)
    // ── cross-track formula ───────────────────────────────────────────────────
    let diff = theta13 - theta12
    let sinD13 = sin(d13)
    let sinDiff = sin(diff)
    let arg = sinD13 * sinDiff
    // inline asin(arg) via atan2
    let arg2 = arg * arg
    let one_minus_arg2 = 1.0 - arg2
    let sqArg = sqrt(one_minus_arg2)
    let ang = atan2(arg, sqArg)
    let result = ang * R
    result
