// std/geo/antipode.nova — The antipodal point (point diametrically opposite on Earth).
//
// The antipode of (lat, lon) is (-lat, lon+180) with lon normalised to (-180, 180].
//
// Normalisation rule: add 180 to lon; if result > 180 subtract 360.
//
// FLOAT HAZARDS obeyed:
//   • All constants inside fn bodies.
//   • No multi-term float expression returned bare.
//
// API:
//   antipode(lat, lon) -> list [lat2, lon2]  (degrees, lat2=-lat, lon2 normalised)

// antipode — returns the point diametrically opposite to (lat, lon).
// lat2 = -lat
// lon2 = lon + 180, normalised to (-180, 180]
fn antipode(lat: float, lon: float) -> list
    let lat2 = 0.0 - lat
    let lon2 = lon + 180.0
    // Normalise lon2 to (-180, 180]
    let lon2n = lon2
    if lon2 > 180.0
        lon2n = lon2 - 360.0
    if lon2 < -180.0
        lon2n = lon2 + 360.0
    let result = [lat2, lon2n]
    result
