// std/geo/geo_area.nova — Spherical polygon area.
//
// Computes the area of a spherical polygon given a list of [lat, lon] points
// in degrees, using the spherical excess formula (Girard's theorem applied via
// the spherical analog of the shoelace formula).
//
// ALGORITHM:
//   The signed spherical excess is:
//     E = sum over edges of: atan2(sin(dlon) * sin(lat_avg), cos(lat_avg))
//   But the standard robust formula for the spherical area uses the fact that
//   for each edge (A -> B):
//     tan(E/2) = tan(dlat/2) * tan((lat1+lat2)/2) + ... (complex)
//   Instead we use the robust L'Huilier / direct integration approach:
//   For each consecutive edge (lat1,lon1)→(lat2,lon2) (in radians):
//     contribution += (lon2 - lon1) * sin((lat1 + lat2) / 2)
//   Area = |sum| * R^2   (R = Earth radius in meters)
//   This is the standard spherical shoelace formula.
//
// API:
//   polygon_area(points) -> float  area in m^2 (non-negative)
//     points = list of [lat, lon] pairs in degrees.
//     - < 3 points: returns 0.0
//     - Polygon is automatically closed (last point connects to first).
//
// FLOAT RULES obeyed throughout.
// ─────────────────────────────────────────────────────────────────────────────

fn polygon_area(points: list) -> float
    let n = len(points)
    if n < 3
        return 0.0
    let PI = 3.14159265358979
    let R = 6371000.0
    let deg2rad = PI / 180.0
    let sum = 0.0
    for i in 0..n
        let j = i + 1
        if j >= n
            j = 0
        let pi_row = points[i]
        let pj_row = points[j]
        let lat1_d = pi_row[0] * 1.0
        let lon1_d = pi_row[1] * 1.0
        let lat2_d = pj_row[0] * 1.0
        let lon2_d = pj_row[1] * 1.0
        let lat1 = lat1_d * deg2rad
        let lat2 = lat2_d * deg2rad
        let lon1 = lon1_d * deg2rad
        let lon2 = lon2_d * deg2rad
        let dlon = lon2 - lon1
        let lat_avg = (lat1 + lat2) / 2.0
        let sin_lat_avg = sin(lat_avg)
        let contrib = dlon * sin_lat_avg
        sum = sum + contrib
    let area_r = sum * R * R
    if area_r < 0.0
        area_r = 0.0 - area_r
    area_r
