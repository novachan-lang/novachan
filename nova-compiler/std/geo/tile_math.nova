// std/geo/tile_math.nova — Slippy-map / quadtree tile arithmetic (integer only).
//
// Slippy maps tile the world into a 2^zoom × 2^zoom grid at each zoom level.
// Tiles are addressed by (tx, ty, zoom) where 0 <= tx,ty < 2^zoom.
//
// No lat/lon projection math here — only the pure tile arithmetic.
// Longitude → tile is LINEAR (lon/360 * 2^zoom); latitude projection is deferred.
//
// All public functions prefixed tm_ to avoid global symbol collisions.
//
// Morton encoding: interleave bits of tx and ty (x gets even bit positions,
// y gets odd).  This maps a 2D tile to a 1D index (the quadkey integer value).
// ─────────────────────────────────────────────────────────────────────────────

// _tm_pow2: 2^n for n in 0..30 (tile arithmetic stays within int range).
fn _tm_pow2(n) -> int
    let result = 1
    for i in 0..n
        result = result * 2
    result

// _tm_floor_div: integer floor division (correct for non-negative values only;
// tile coords are always non-negative so this is safe).
fn _tm_floor_div(a, b) -> int
    a / b

// tm_num_tiles: number of tiles per axis at the given zoom level (2^zoom).
fn tm_num_tiles(zoom) -> int
    _tm_pow2(zoom)

// tm_total_tiles: total tile count at zoom (4^zoom = 2^(2*zoom)).
fn tm_total_tiles(zoom) -> int
    let side = _tm_pow2(zoom)
    side * side

// tm_parent: parent tile [px, py, pz] of (tx, ty, zoom) at zoom-1.
// At zoom 0 the tile is its own "parent" (no parent exists; returns same tile).
fn tm_parent(tx, ty, zoom) -> any
    let result = []
    if zoom <= 0
        push(result, tx)
        push(result, ty)
        push(result, 0)
        return result
    let pz = zoom - 1
    let px = tx / 2
    let py = ty / 2
    push(result, px)
    push(result, py)
    push(result, pz)
    result

// tm_children: the 4 children of (tx, ty, zoom) at zoom+1.
// Returns [[cx0,cy0],[cx1,cy1],[cx2,cy2],[cx3,cy3]] in NW/NE/SW/SE order.
// (Top-left = smaller tx/ty because y increases downward in slippy maps.)
fn tm_children(tx, ty, zoom) -> any
    let bx = tx * 2
    let by = ty * 2
    let result = []
    let c0 = []
    push(c0, bx)
    push(c0, by)
    let c1 = []
    push(c1, bx + 1)
    push(c1, by)
    let c2 = []
    push(c2, bx)
    push(c2, by + 1)
    let c3 = []
    push(c3, bx + 1)
    push(c3, by + 1)
    push(result, c0)
    push(result, c1)
    push(result, c2)
    push(result, c3)
    result

// tm_neighbors: up to 8 neighbors of (tx, ty, zoom), clamped to grid bounds.
// Returns a list of [nx, ny] pairs (excludes the tile itself).
fn tm_neighbors(tx, ty, zoom) -> any
    let side = _tm_pow2(zoom)
    let result = []
    let dy = -1
    while dy <= 1
        let dx = -1
        while dx <= 1
            if not (dx == 0 and dy == 0)
                let nx = tx + dx
                let ny = ty + dy
                if nx >= 0 and nx < side and ny >= 0 and ny < side
                    let nb = []
                    push(nb, nx)
                    push(nb, ny)
                    push(result, nb)
            dx = dx + 1
        dy = dy + 1
    result

// tm_lon_bounds: [west_lon, east_lon] for tile tx at the given zoom.
// Linear: lon = tx / 2^zoom * 360 - 180
fn tm_lon_bounds(tx, zoom) -> any
    let side = _tm_pow2(zoom)
    let side_f = side * 1.0
    let tx_f = tx * 1.0
    let west = (tx_f / side_f) * 360.0 - 180.0
    let east = ((tx_f + 1.0) / side_f) * 360.0 - 180.0
    let result = []
    push(result, west)
    push(result, east)
    result

// tm_is_valid: true if (tx, ty) are valid tile coordinates at zoom.
fn tm_is_valid(tx, ty, zoom) -> bool
    let side = _tm_pow2(zoom)
    tx >= 0 and ty >= 0 and tx < side and ty < side

// _tm_interleave_bit: interleave bit k of x into even positions, y into odd.
// Returns the Morton code by walking bits 0..max_bits-1.
fn _tm_morton_inner(x, y, bits) -> int
    let result = 0
    let i = 0
    let shift = 0
    while i < bits
        // x bit i into position 2i
        let xbit = (x >> i) & 1
        let xshift = xbit * _tm_pow2(shift)
        result = result + xshift
        shift = shift + 1
        // y bit i into position 2i+1
        let ybit = (y >> i) & 1
        let yshift = ybit * _tm_pow2(shift)
        result = result + yshift
        shift = shift + 1
        i = i + 1
    result

// tm_morton: interleave bits of (tx, ty) at zoom to produce the quadkey integer.
// Uses zoom bits from each of tx and ty.
fn tm_morton(tx, ty, zoom) -> int
    _tm_morton_inner(tx, ty, zoom)

// tm_flip_y: convert between TMS (y=0 at bottom) and XYZ (y=0 at top) y-coord.
// Involution: flip_y(flip_y(ty, zoom), zoom) == ty.
fn tm_flip_y(ty, zoom) -> int
    let side = _tm_pow2(zoom)
    side - 1 - ty

// tm_zoom_in: zoom into tile (tx, ty) by one level — returns [tx*2, ty*2, zoom+1]
// (the top-left child; same as tm_children element 0).
fn tm_zoom_in(tx, ty) -> any
    let result = []
    push(result, tx * 2)
    push(result, ty * 2)
    result

// tm_ancestor: ancestor of (tx, ty, zoom) that is `levels` zoom levels up.
// Returns [anc_tx, anc_ty, anc_zoom].  Clamps levels to avoid going below zoom 0.
fn tm_ancestor(tx, ty, zoom, levels) -> any
    let levels_up = levels
    if levels_up > zoom
        levels_up = zoom
    let anc_tx = tx
    let anc_ty = ty
    let anc_zoom = zoom
    for i in 0..levels_up
        anc_tx = anc_tx / 2
        anc_ty = anc_ty / 2
        anc_zoom = anc_zoom - 1
    let result = []
    push(result, anc_tx)
    push(result, anc_ty)
    push(result, anc_zoom)
    result
