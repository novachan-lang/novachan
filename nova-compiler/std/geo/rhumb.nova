// std/geo/rhumb.nova — Rhumb-line (loxodrome) distance and bearing.
//
// A rhumb line is a path that crosses all meridians at the same angle
// (constant bearing). Unlike great-circle routes it is not the shortest
// path, but it has a fixed compass heading — useful in navigation.
//
// FLOAT HAZARDS obeyed throughout:
//   • All constants inside fn bodies.
//   • Every math builtin bound to a named let.
//   • No bare multi-term float expression returned.
//   • NOVA has no asin/acos/atan — use atan2 identities.
//   • log() = natural log in NOVA.
//
// Formulas (Bowring / Ed Williams aviation formulary):
//   Δφ = lat2 - lat1  (radians)
//   Δλ = lon2 - lon1  (radians, normalised to (-π, π])
//   Δψ = ln( tan(π/4 + lat2/2) / tan(π/4 + lat1/2) )   [Mercator N]
//   q  = Δφ/Δψ   (if |Δψ| small, q ≈ cos(lat1))
//   d  = R * sqrt(Δφ² + q²·Δλ²)                        [distance, meters]
//   θ  = atan2(Δλ, Δψ)                                   [bearing, -π..π]
//
// API:
//   rhumb_distance(lat1,lon1,lat2,lon2) -> float  (meters)
//   rhumb_bearing(lat1,lon1,lat2,lon2)  -> float  (degrees, 0..360)

// _rhumb_fabs — absolute value of a float
fn _rhumb_fabs(x: float) -> float
    0.0 - x if x < 0.0 else x

// _rhumb_fmod_pos — positive-modulo so result is in [0, m)
fn _rhumb_fmod_pos(x: float, m: float) -> float
    let q = x / m
    let n = float_to_int(q)
    let nf = n * 1.0
    let sub = nf * m
    let rem = x - sub
    rem + m if rem < 0.0 else rem

// rhumb_distance — rhumb-line distance in meters between (lat1,lon1) and (lat2,lon2) (degrees).
fn rhumb_distance(lat1: float, lon1: float, lat2: float, lon2: float) -> float
    let PI = 3.14159265358979
    let R = 6371000.0
    let rlat1 = lat1 * PI / 180.0
    let rlat2 = lat2 * PI / 180.0
    let rlon1 = lon1 * PI / 180.0
    let rlon2 = lon2 * PI / 180.0
    // Δφ, Δλ
    let dphi = rlat2 - rlat1
    let dlam = rlon2 - rlon1
    // Normalise Δλ to (-π, π]
    let dlam_n = dlam - 2.0 * PI if dlam > PI else (dlam + 2.0 * PI if dlam < -PI else dlam)
    // Mercator northing difference Δψ
    let half_pi = PI / 4.0
    let t2 = half_pi + rlat2 / 2.0
    let t1 = half_pi + rlat1 / 2.0
    let tan2 = sin(t2) / cos(t2)
    let tan1 = sin(t1) / cos(t1)
    let tan2a = _rhumb_fabs(tan2)
    let tan1a = _rhumb_fabs(tan1)
    let ln2 = log(tan2a)
    let ln1 = log(tan1a)
    let dpsi = ln2 - ln1
    // q = dphi/dpsi (or cos(lat1) when dpsi very small)
    let eps = 0.0000001
    let dpsi_abs = _rhumb_fabs(dpsi)
    let q = cos(rlat1) if dpsi_abs < eps else dphi / dpsi
    // distance
    let dphi2 = dphi * dphi
    let qdlam = q * dlam_n
    let qdlam2 = qdlam * qdlam
    let inner = dphi2 + qdlam2
    let sq = sqrt(inner)
    let dist = R * sq
    dist

// rhumb_bearing — rhumb bearing in degrees [0, 360) from (lat1,lon1) to (lat2,lon2) (degrees).
fn rhumb_bearing(lat1: float, lon1: float, lat2: float, lon2: float) -> float
    let PI = 3.14159265358979
    let rlat1 = lat1 * PI / 180.0
    let rlat2 = lat2 * PI / 180.0
    let rlon1 = lon1 * PI / 180.0
    let rlon2 = lon2 * PI / 180.0
    let dlam = rlon2 - rlon1
    // Normalise Δλ to (-π, π]
    let dlam_n = dlam - 2.0 * PI if dlam > PI else (dlam + 2.0 * PI if dlam < -PI else dlam)
    // Mercator northing difference
    let half_pi = PI / 4.0
    let t2 = half_pi + rlat2 / 2.0
    let t1 = half_pi + rlat1 / 2.0
    let tan2 = sin(t2) / cos(t2)
    let tan1 = sin(t1) / cos(t1)
    let tan2a = _rhumb_fabs(tan2)
    let tan1a = _rhumb_fabs(tan1)
    let ln2 = log(tan2a)
    let ln1 = log(tan1a)
    let dpsi = ln2 - ln1
    // bearing
    let theta = atan2(dlam_n, dpsi)
    let deg = theta * 180.0 / PI
    let result = _rhumb_fmod_pos(deg, 360.0)
    result
