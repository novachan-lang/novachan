// std/geo/geo_normalize.nova — Coordinate normalization and validation helpers.
//
// All functions are pure arithmetic: no trig, no projection, no external deps.
// Prefix: gn_
// ─────────────────────────────────────────────────────────────────────────────

// _gn_floor: floor for floats (toward -infinity).
fn _gn_floor(x) -> float
    let xi = int(x)
    let xf = xi * 1.0
    if xf > x
        return xf - 1.0
    xf

// _gn_fabs: absolute value of a float.
fn _gn_fabs(x) -> float
    if x < 0.0
        return 0.0 - x
    x

// gn_wrap_lon: wrap longitude into [-180, 180).
fn gn_wrap_lon(lon) -> float
    let v = lon * 1.0
    // Shift so range becomes [0, 360), do mod, then shift back.
    // mod 360: v - 360 * floor(v / 360)
    let shifted = v + 180.0
    let d = shifted / 360.0
    let fl = _gn_floor(d)
    let rem = shifted - fl * 360.0
    rem - 180.0

// gn_clamp_lat: clamp latitude into [-90, 90].
fn gn_clamp_lat(lat) -> float
    let v = lat * 1.0
    if v < 0.0 - 90.0
        return 0.0 - 90.0
    if v > 90.0
        return 90.0
    v

// gn_normalize: normalize (lat, lon) returning [clamped_lat, wrapped_lon].
fn gn_normalize(lat, lon) -> any
    let clat = gn_clamp_lat(lat * 1.0)
    let wlon = gn_wrap_lon(lon * 1.0)
    let out = []
    push(out, clat)
    push(out, wlon)
    out

// gn_is_valid_lat: true iff lat is in [-90, 90].
fn gn_is_valid_lat(lat) -> bool
    let v = lat * 1.0
    if v < 0.0 - 90.0
        return false
    if v > 90.0
        return false
    true

// gn_is_valid_lon: true iff lon is in [-180, 180].
fn gn_is_valid_lon(lon) -> bool
    let v = lon * 1.0
    if v < 0.0 - 180.0
        return false
    if v > 180.0
        return false
    true

// gn_is_valid: true iff both lat and lon are in standard ranges.
fn gn_is_valid(lat, lon) -> bool
    if not gn_is_valid_lat(lat * 1.0)
        return false
    gn_is_valid_lon(lon * 1.0)

// _gn_pow10: integer power of 10 (for rounding helper).
fn _gn_pow10(n) -> float
    let r = 1.0
    let i = 0
    while i < n
        r = r * 10.0
        i = i + 1
    r

// gn_round_coord: round float x to `decimals` decimal places.
fn gn_round_coord(x, decimals) -> float
    let scale = _gn_pow10(decimals)
    let v = x * 1.0
    let shifted = v * scale
    // round-half-up: floor(x + 0.5)
    let fl = _gn_floor(shifted + 0.5)
    fl / scale

// gn_snap_to_grid: snap (lat, lon) to the nearest grid point of spacing `step`.
fn gn_snap_to_grid(lat, lon, step) -> any
    let s = step * 1.0
    let la = lat * 1.0
    let lo = lon * 1.0
    // nearest = floor((v / step) + 0.5) * step
    let flata = _gn_floor(la / s + 0.5)
    let flona = _gn_floor(lo / s + 0.5)
    let snapped_lat = flata * s
    let snapped_lon = flona * s
    let out = []
    push(out, snapped_lat)
    push(out, snapped_lon)
    out

// gn_dedup_precision: round both lat and lon to `decimals` decimal places.
fn gn_dedup_precision(lat, lon, decimals) -> any
    let rlat = gn_round_coord(lat * 1.0, decimals)
    let rlon = gn_round_coord(lon * 1.0, decimals)
    let out = []
    push(out, rlat)
    push(out, rlon)
    out

// gn_lat_direction: 'N' for non-negative latitude, 'S' for negative.
fn gn_lat_direction(lat) -> string
    if lat * 1.0 < 0.0
        return "S"
    "N"

// gn_lon_direction: 'E' for non-negative longitude, 'W' for negative.
fn gn_lon_direction(lon) -> string
    if lon * 1.0 < 0.0
        return "W"
    "E"
