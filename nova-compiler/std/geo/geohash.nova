// std/geo/geohash.nova — Geohash encode/decode (Gustavo Niemeyer, 2008).
//
// Encodes (lat, lon) as a base32 string whose prefix is a spatial prefix-code.
//
// ALPHABET: "0123456789bcdefghjkmnpqrstuvwxyz" (i/l/o/u omitted).
//
// ALGORITHM — encode(lat, lon, precision):
//   Interleave longitude bits (even positions: 0,2,4,...) and latitude bits
//   (odd positions: 1,3,5,...), MSB first. Every 5 bits emit one base32 char.
//
// ALGORITHM — decode(hash):
//   Feed each character's 5 bits back: even bits narrow longitude, odd narrow
//   latitude. Cell center = (min + max) / 2.
//
// API:
//   geohash_encode(lat, lon, precision) -> string
//   geohash_decode(hash)               -> list [lat, lon]  (cell center)
//
// CRITICAL FLOAT BOXING NOTE:
//   All range variables (lat_min/lat_max/lon_min/lon_max) MUST stay in raw-float
//   mode throughout computation. They are NEVER stored into a list until the very
//   end; helper functions that return floats and store into these vars would cause
//   the compiler to box them, corrupting reads on the next iteration.
//   All midpoint arithmetic is inlined (not via helper functions) in decode.
//
// Symbol collision guard: all private helpers prefixed _ggh_.
// ─────────────────────────────────────────────────────────────────────────────

// _ggh_alpha: the 32-char geohash alphabet.
fn _ggh_alpha() -> string
    "0123456789bcdefghjkmnpqrstuvwxyz"

// _ggh_char_to_idx: map a geohash character to its 5-bit value (0..31).
// Returns -1 for characters not in the alphabet.
fn _ggh_char_to_idx(c) -> int
    let b = ord(c)
    // '0'..'9' -> 0..9
    if b >= 48 and b <= 57
        return b - 48
    // 'b'=98 -> 10, 'c'=99 -> 11, 'd'=100 -> 12, 'e'=101 -> 13
    // 'f'=102 -> 14, 'g'=103 -> 15, 'h'=104 -> 16, 'j'=106 -> 17
    // 'k'=107 -> 18, 'm'=109 -> 19, 'n'=110 -> 20, 'p'=112 -> 21
    // 'q'=113 -> 22, 'r'=114 -> 23, 's'=115 -> 24, 't'=116 -> 25
    // 'u'=117 -> 26, 'v'=118 -> 27, 'w'=119 -> 28, 'x'=120 -> 29
    // 'y'=121 -> 30, 'z'=122 -> 31
    if b == 98
        return 10
    if b == 99
        return 11
    if b == 100
        return 12
    if b == 101
        return 13
    if b == 102
        return 14
    if b == 103
        return 15
    if b == 104
        return 16
    if b == 106
        return 17
    if b == 107
        return 18
    if b == 109
        return 19
    if b == 110
        return 20
    if b == 112
        return 21
    if b == 113
        return 22
    if b == 114
        return 23
    if b == 115
        return 24
    if b == 116
        return 25
    if b == 117
        return 26
    if b == 118
        return 27
    if b == 119
        return 28
    if b == 120
        return 29
    if b == 121
        return 30
    if b == 122
        return 31
    -1

// geohash_encode: encode (lat, lon) to a geohash string of the given precision.
//
// precision: number of base32 characters (1..12 typical; higher = finer cell).
//   precision 5 ≈ ±2.4 km   precision 9 ≈ ±2.4 m   precision 12 ≈ sub-cm
//
// Preconditions: -90 <= lat <= 90, -180 <= lon <= 180, precision >= 1
fn geohash_encode(lat, lon, precision) -> string
    let alpha = _ggh_alpha()
    let lat_min = 0.0 - 90.0
    let lat_max = 90.0
    let lon_min = 0.0 - 180.0
    let lon_max = 180.0
    let result = ""
    let hash_val = 0
    let bits = 0
    let even = 1
    let lat_f = lat * 1.0
    let lon_f = lon * 1.0
    let target = precision
    let done = 0
    while done == 0
        let mid_lon = (lon_min + lon_max) / 2.0
        let mid_lat = (lat_min + lat_max) / 2.0
        if even == 1
            if lon_f >= mid_lon
                hash_val = (hash_val * 2) + 1
                lon_min = mid_lon
            else
                hash_val = hash_val * 2
                lon_max = mid_lon
            even = 0
        else
            if lat_f >= mid_lat
                hash_val = (hash_val * 2) + 1
                lat_min = mid_lat
            else
                hash_val = hash_val * 2
                lat_max = mid_lat
            even = 1
        bits = bits + 1
        if bits == 5
            result = result + alpha[hash_val]
            hash_val = 0
            bits = 0
        if len(result) >= target
            done = 1
    result

// _ggh_decode_bounds: decode a hash to [lat_min, lat_max, lon_min, lon_max].
//
// All midpoint arithmetic is INLINED (not via a helper function) to keep all
// range variables in raw-float mode. See file header for the boxing hazard.
fn _ggh_decode_bounds(hash) -> list
    let lat_min = 0.0 - 90.0
    let lat_max = 90.0
    let lon_min = 0.0 - 180.0
    let lon_max = 180.0
    let n = len(hash)
    let i = 0
    let even = 1
    while i < n
        let c = hash[i]
        let idx = _ggh_char_to_idx(c)
        // Bit 16
        let set16 = idx & 16
        if even == 1
            let mid16 = (lon_min + lon_max) / 2.0
            if set16 > 0
                lon_min = mid16
            else
                lon_max = mid16
        else
            let mid16 = (lat_min + lat_max) / 2.0
            if set16 > 0
                lat_min = mid16
            else
                lat_max = mid16
        if even == 1
            even = 0
        else
            even = 1
        // Bit 8
        let set8 = idx & 8
        if even == 1
            let mid8 = (lon_min + lon_max) / 2.0
            if set8 > 0
                lon_min = mid8
            else
                lon_max = mid8
        else
            let mid8 = (lat_min + lat_max) / 2.0
            if set8 > 0
                lat_min = mid8
            else
                lat_max = mid8
        if even == 1
            even = 0
        else
            even = 1
        // Bit 4
        let set4 = idx & 4
        if even == 1
            let mid4 = (lon_min + lon_max) / 2.0
            if set4 > 0
                lon_min = mid4
            else
                lon_max = mid4
        else
            let mid4 = (lat_min + lat_max) / 2.0
            if set4 > 0
                lat_min = mid4
            else
                lat_max = mid4
        if even == 1
            even = 0
        else
            even = 1
        // Bit 2
        let set2 = idx & 2
        if even == 1
            let mid2 = (lon_min + lon_max) / 2.0
            if set2 > 0
                lon_min = mid2
            else
                lon_max = mid2
        else
            let mid2 = (lat_min + lat_max) / 2.0
            if set2 > 0
                lat_min = mid2
            else
                lat_max = mid2
        if even == 1
            even = 0
        else
            even = 1
        // Bit 1
        let set1 = idx & 1
        if even == 1
            let mid1 = (lon_min + lon_max) / 2.0
            if set1 > 0
                lon_min = mid1
            else
                lon_max = mid1
        else
            let mid1 = (lat_min + lat_max) / 2.0
            if set1 > 0
                lat_min = mid1
            else
                lat_max = mid1
        if even == 1
            even = 0
        else
            even = 1
        i = i + 1
    let out = []
    out.push(lat_min)
    out.push(lat_max)
    out.push(lon_min)
    out.push(lon_max)
    out

// geohash_decode: decode a geohash string to the cell center [lat, lon].
//
// Returns [lat, lon] where both are the CENTER of the decoded cell.
fn geohash_decode(hash) -> list
    let bounds = _ggh_decode_bounds(hash)
    let lat_min = bounds[0] * 1.0
    let lat_max = bounds[1] * 1.0
    let lon_min = bounds[2] * 1.0
    let lon_max = bounds[3] * 1.0
    let lat_sum = lat_min + lat_max
    let lat_c = lat_sum / 2.0
    let lon_sum = lon_min + lon_max
    let lon_c = lon_sum / 2.0
    let res = []
    res.push(lat_c)
    res.push(lon_c)
    res
