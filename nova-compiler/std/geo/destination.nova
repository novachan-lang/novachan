// std/geo/destination.nova — Destination point from start + bearing + distance.
//
// FLOAT HAZARDS obeyed:
//   • All float sub-expressions bound to named lets.
//   • atan2 result bound to let BEFORE any further arithmetic.
//   • No asin/acos builtins — _asin/_acos inlined via atan2+sqrt.
//   • No multi-term float return — always return final named let.
//   • Float literals always carry a decimal point.
//
// API:
//   destination(lat, lon, bearing_deg, dist_m) -> list [lat2, lon2]
//     lat, lon in degrees; bearing_deg in degrees (0=north, 90=east);
//     dist_m in meters; returns [lat2_deg, lon2_deg].

fn _dst_pi()
    let p = 3.14159265358979
    p

fn _dst_R()
    let r = 6371000.0
    r

fn _dst_deg2rad(d)
    let PI = _dst_pi()
    let t = d * PI
    let r = t / 180.0
    r

fn _dst_rad2deg(r)
    let PI = _dst_pi()
    let t = r * 180.0
    let d = t / PI
    d

// Inline _asin: asin(x) = atan2(x, sqrt(1 - x*x))
fn _dst_asin(x)
    let x2 = x * x
    let sub = 1.0 - x2
    let s = sqrt(sub)
    let r = atan2(x, s)
    r

// destination: Compute destination point given start lat/lon, bearing (deg), distance (m).
// Formula (WGS-84 spherical approx):
//   delta = d / R                             (angular distance)
//   lat2 = asin(sin(lat1)*cos(delta) + cos(lat1)*sin(delta)*cos(brg))
//   lon2 = lon1 + atan2(sin(brg)*sin(delta)*cos(lat1),
//                        cos(delta) - sin(lat1)*sin(lat2))
fn destination(lat, lon, bearing_deg, dist_m)
    let R = _dst_R()
    let rlat1 = _dst_deg2rad(lat)
    let rlon1 = _dst_deg2rad(lon)
    let rbrg = _dst_deg2rad(bearing_deg)
    let delta = dist_m / R
    let sindelta = sin(delta)
    let cosdelta = cos(delta)
    let sinlat1 = sin(rlat1)
    let coslat1 = cos(rlat1)
    let cosbrg = cos(rbrg)
    let sinbrg = sin(rbrg)
    // lat2 = asin(sin(lat1)*cos(delta) + cos(lat1)*sin(delta)*cos(brg))
    let t1 = sinlat1 * cosdelta
    let t2 = coslat1 * sindelta
    let t3 = t2 * cosbrg
    let t4 = t1 + t3
    // clamp t4 to [-1,1] to guard asin domain
    let t4c = t4
    if t4c > 1.0
        t4c = 1.0
    if t4c < -1.0
        t4c = -1.0
    let rlat2 = _dst_asin(t4c)
    let sinlat2 = sin(rlat2)
    // lon2 = lon1 + atan2(sin(brg)*sin(delta)*cos(lat1), cos(delta) - sin(lat1)*sin(lat2))
    let ny = sinbrg * sindelta * coslat1
    let nx1 = cosdelta - sinlat1 * sinlat2
    // bind atan2 result to a let before further arithmetic
    let dlon = atan2(ny, nx1)
    let rlon2 = rlon1 + dlon
    let lat2 = _dst_rad2deg(rlat2)
    let lon2 = _dst_rad2deg(rlon2)
    let result = []
    push(result, lat2)
    push(result, lon2)
    result
