// std/geo/quadkey.nova — Bing Maps tile quadkey encoding/decoding.
//
// A quadkey encodes a tile (tx, ty, zoom) as a string of digits 0-3.
// For each zoom level from 'zoom' down to 1, a single digit is appended:
//   digit = (x_bit) + 2*(y_bit)
// where x_bit and y_bit are the bits of tx and ty at position (zoom_level-1).
//
// Bit extraction: for level i (1..zoom), bit position = i-1.
//   x_bit = (tx >> (i-1)) & 1
//   y_bit = (ty >> (i-1)) & 1
// The first digit (highest zoom level) comes from the most-significant bits.
// For zoom=3: first digit uses bit 2, second uses bit 1, third uses bit 0.
//
// Symbol prefix: qk_ (public), _qk_ (private).

// _qk_ibit: extract bit at position pos from integer v. Returns 0 or 1.
fn _qk_ibit(v, pos) -> int
    let shifted = v >> pos
    let bit = shifted & 1
    bit

// qk_from_tile: encode tile (tx, ty) at given zoom to a quadkey string.
// tx in [0, 2^zoom), ty in [0, 2^zoom).
fn qk_from_tile(tx, ty, zoom) -> string
    let result_parts = []
    let i = zoom
    while i >= 1
        let pos = i - 1
        let xb = _qk_ibit(tx, pos)
        let yb = _qk_ibit(ty, pos)
        let d = xb + 2 * yb
        push(result_parts, str(d))
        i = i - 1
    let result = join(result_parts, "")
    result

// qk_to_tile: decode a quadkey string to {tx, ty, zoom}.
fn qk_to_tile(quadkey) -> any
    let n = len(quadkey)
    let tx = 0
    let ty = 0
    for i in 0..n
        let ch = quadkey[i]
        let d = 0
        if ch == "0"
            d = 0
        if ch == "1"
            d = 1
        if ch == "2"
            d = 2
        if ch == "3"
            d = 3
        // bit position for this character: (n - 1 - i)
        let pos = n - 1 - i
        let xb = d & 1
        let yb = (d >> 1) & 1
        if xb == 1
            tx = tx + (1 << pos)
        if yb == 1
            ty = ty + (1 << pos)
    let result = {}
    result["tx"] = tx
    result["ty"] = ty
    result["zoom"] = n
    result

// qk_zoom: return the zoom level of a quadkey (its length).
fn qk_zoom(quadkey) -> int
    len(quadkey)

// qk_parent: return the parent quadkey (drop the last digit; empty string for zoom-0).
fn qk_parent(quadkey) -> string
    let n = len(quadkey)
    if n <= 0
        return ""
    slice(quadkey, 0, n - 1)

// qk_children: return the 4 children quadkeys by appending 0, 1, 2, 3.
fn qk_children(quadkey) -> list
    let kids = []
    kids.push(quadkey + "0")
    kids.push(quadkey + "1")
    kids.push(quadkey + "2")
    kids.push(quadkey + "3")
    kids

// qk_is_valid: return true if quadkey contains only characters 0-3.
fn qk_is_valid(quadkey) -> bool
    let n = len(quadkey)
    if n == 0
        return false
    for i in 0..n
        let ch = quadkey[i]
        if ch != "0" and ch != "1" and ch != "2" and ch != "3"
            return false
    true

// qk_from_tile_valid: return true if (tx, ty) are valid tile coordinates at zoom.
// Valid: tx in [0, 2^zoom), ty in [0, 2^zoom).
fn qk_from_tile_valid(tx, ty, zoom) -> bool
    if zoom < 0
        return false
    if tx < 0 or ty < 0
        return false
    // max tile index = 2^zoom - 1
    let max_idx = 1
    for k in 0..zoom
        max_idx = max_idx * 2
    max_idx = max_idx - 1
    if tx > max_idx
        return false
    if ty > max_idx
        return false
    true
