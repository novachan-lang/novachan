// std/vector/vec_angle.nova — exact integer/rational angle predicates on N-d int vectors.
// A vector is a list of integers. LEAF — imports NOTHING.
// cos^2 is represented as a reduced rational [num, den] with den > 0.
// NO floats, NO sqrt. Exact integer arithmetic throughout.

// _gcd: non-negative gcd via Euclidean algorithm
fn _van_gcd(a: int, b: int) -> int
    let x = a
    let y = b
    if x < 0
        x = 0 - x
    if y < 0
        y = 0 - y
    while y != 0
        let t = y
        y = x - (x / y) * y
        x = t
    x

// _reduce: reduce rational [num, den] to lowest terms with den > 0
fn _van_reduce(num: int, den: int) -> list
    if den == 0
        let r = [0, 0]
        return r
    let n = num
    let d = den
    if d < 0
        n = 0 - n
        d = 0 - d
    let g = _van_gcd(n, d)
    if g == 0
        g = 1
    let r = [n / g, d / g]
    r

// _dot: dot product of two integer vectors
fn _van_dot(a: list, b: list) -> int
    let n = len(a)
    let m = len(b)
    if m < n
        n = m
    let s = 0
    let i = 0
    while i < n
        s = s + a[i] * b[i]
        i = i + 1
    s

// _normsq: squared magnitude of an integer vector
fn _van_normsq(a: list) -> int
    let s = 0
    let i = 0
    while i < len(a)
        s = s + a[i] * a[i]
        i = i + 1
    s

// van_cos_sq: cos^2(angle between a and b) = (a.b)^2 / (|a|^2 * |b|^2).
// Returns reduced rational [num, den]. Returns [0, 0] if either vector is zero.
fn van_cos_sq(a: list, b: list) -> list
    let na2 = _van_normsq(a)
    let nb2 = _van_normsq(b)
    if na2 == 0
        let r = [0, 0]
        return r
    if nb2 == 0
        let r = [0, 0]
        return r
    let dot = _van_dot(a, b)
    _van_reduce(dot * dot, na2 * nb2)

// van_is_orthogonal: true if the angle between a and b is 90 degrees (dot == 0).
fn van_is_orthogonal(a: list, b: list) -> bool
    _van_dot(a, b) == 0

// van_is_parallel: true if the angle between a and b is 0 or 180 degrees (cos^2 == 1).
// Equivalent to (a.b)^2 == |a|^2 * |b|^2. False if either vector is zero.
fn van_is_parallel(a: list, b: list) -> bool
    let na2 = _van_normsq(a)
    let nb2 = _van_normsq(b)
    if na2 == 0
        return false
    if nb2 == 0
        return false
    let dot = _van_dot(a, b)
    dot * dot == na2 * nb2

// van_is_acute: true if the angle between a and b is acute (dot product > 0).
fn van_is_acute(a: list, b: list) -> bool
    _van_dot(a, b) > 0

// van_is_obtuse: true if the angle between a and b is obtuse (dot product < 0).
fn van_is_obtuse(a: list, b: list) -> bool
    _van_dot(a, b) < 0
