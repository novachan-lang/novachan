// std/vector/vec_dot.nova — Integer vector dot product and derived operations.
// A vector is a list of integers [x0, x1, ...].
// All results are EXACT integers — no floats, no rounding.
// LEAF — imports NOTHING.
//
// Public API (prefix vd_):
//   vd_dot(a, b)            -> int    dot product sum(a[i]*b[i]); length = min(len(a),len(b))
//   vd_norm_sq(a)           -> int    squared Euclidean norm = vd_dot(a,a)
//   vd_is_zero(a)           -> bool   true iff all components are zero
//   vd_is_orthogonal(a, b)  -> bool   true iff vd_dot(a,b) == 0

// vd_dot — integer dot product of a and b; sums over min(len(a),len(b)) terms.
fn vd_dot(a, b)
    let na = len(a)
    let nb = len(b)
    let n = na
    if nb < n
        n = nb
    let sum = 0
    let i = 0
    while i < n
        sum = sum + a[i] * b[i]
        i = i + 1
    sum

// vd_norm_sq — squared Euclidean norm: sum of squares of all components.
fn vd_norm_sq(a)
    let n = len(a)
    let sum = 0
    let i = 0
    while i < n
        sum = sum + a[i] * a[i]
        i = i + 1
    sum

// vd_is_zero — true iff every component of a is zero.
fn vd_is_zero(a)
    let n = len(a)
    let i = 0
    while i < n
        if a[i] != 0
            return false
        i = i + 1
    true

// vd_is_orthogonal — true iff vd_dot(a,b) == 0 (vectors are perpendicular).
fn vd_is_orthogonal(a, b)
    let d = vd_dot(a, b)
    d == 0
