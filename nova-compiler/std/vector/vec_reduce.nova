// std/vector/vec_reduce.nova — Integer vector GCD reduction to primitive form.
//
// Vectors are lists of integers [x0, x1, ...].
// All arithmetic is EXACT INTEGER — no floats.
// LEAF — imports NOTHING.
//
// Public API (prefix vr_):
//   vr_gcd(a)          -> int    GCD of absolute values of components; 0 for zero vector
//   vr_primitive(a)    -> list   vector divided by vr_gcd(a); unchanged if gcd is 0
//   vr_is_primitive(a) -> bool   vr_gcd(a) == 1

// _vr_abs: absolute value of an integer.
fn _vr_abs(x: int) -> int
    if x < 0
        return 0 - x
    x

// _vr_gcd2: Euclidean GCD of two non-negative integers. gcd(0,0)=0 by convention.
fn _vr_gcd2(a: int, b: int) -> int
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    a

// vr_gcd: GCD of the absolute values of all components of a.
// Returns 0 for the zero vector (all components are zero).
fn vr_gcd(a: list) -> int
    let n = len(a)
    if n == 0
        return 0
    let g = 0
    for i in 0..n
        let v = _vr_abs(a[i])
        g = _vr_gcd2(g, v)
    g

// vr_primitive: divide each component by vr_gcd(a) to obtain the primitive vector.
// If gcd is 0 (zero vector), returns the vector unchanged.
// The sign convention preserves original signs (first nonzero component keeps its sign).
fn vr_primitive(a: list) -> list
    let g = vr_gcd(a)
    let n = len(a)
    let result = []
    if g == 0
        for i in 0..n
            push(result, a[i])
        return result
    for i in 0..n
        push(result, a[i] / g)
    result

// vr_is_primitive: true when vr_gcd(a) == 1 (components share no common factor > 1).
fn vr_is_primitive(a: list) -> bool
    vr_gcd(a) == 1
