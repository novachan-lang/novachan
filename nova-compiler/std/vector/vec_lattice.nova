// std/vector/vec_lattice.nova — Exact integer determinant for square integer lattice bases.
// A basis is a list of N rows, each a list of N integers (an NxN square matrix).
// The determinant is the signed covolume of the lattice — exact, no fractions.
// Uses fraction-free Bareiss elimination so all intermediate values remain integers.
// LEAF — imports NOTHING.
//
// Public API (prefix vl_):
//   vl_det(basis)           -> int    exact signed integer determinant of the square basis matrix
//   vl_abs_det(basis)       -> int    |vl_det(basis)|
//   vl_is_unimodular(basis) -> bool   true iff |det(basis)| == 1 (basis is a lattice automorphism)

// _vl_iabs — absolute value of an integer.
fn _vl_iabs(x)
    if x < 0
        return 0 - x
    x

// vl_det — exact signed integer determinant via Bareiss fraction-free elimination.
// Row-swaps are counted for sign. Returns 0 for singular matrices.
fn vl_det(basis)
    let n = len(basis)
    if n == 0
        return 1
    if n == 1
        return basis[0][0]
    // copy basis into a mutable list of rows
    let mat = []
    let ci = 0
    while ci < n
        let row = []
        let cj = 0
        while cj < n
            row = row + [basis[ci][cj]]
            cj = cj + 1
        mat = mat + [row]
        ci = ci + 1
    let sign = 1
    let prev = 1
    let k = 0
    while k < n - 1
        // find non-zero pivot in column k at or below row k
        let pivot_row = -1
        let sr = k
        while sr < n
            if mat[sr][k] != 0
                pivot_row = sr
                sr = n
            sr = sr + 1
        if pivot_row == -1
            return 0
        // swap rows if needed
        if pivot_row != k
            let tmp = mat[k]
            let swapped = []
            let si = 0
            while si < n
                if si == k
                    swapped = swapped + [mat[pivot_row]]
                else
                    if si == pivot_row
                        swapped = swapped + [tmp]
                    else
                        swapped = swapped + [mat[si]]
                si = si + 1
            mat = swapped
            sign = 0 - sign
        // Bareiss step: eliminate column k below pivot
        let pkk = mat[k][k]
        let next_mat = []
        let i = 0
        while i < n
            if i <= k
                next_mat = next_mat + [mat[i]]
            else
                let old_row = mat[i]
                let pik = old_row[k]
                let new_row = []
                let j = 0
                while j < n
                    if j <= k
                        new_row = new_row + [0]
                    else
                        let val = pkk * old_row[j] - pik * mat[k][j]
                        let dv = val / prev
                        new_row = new_row + [dv]
                    j = j + 1
                next_mat = next_mat + [new_row]
            i = i + 1
        mat = next_mat
        prev = pkk
        k = k + 1
    let result = sign * mat[n - 1][n - 1]
    result

// vl_abs_det — absolute value of the lattice determinant.
fn vl_abs_det(basis)
    let d = vl_det(basis)
    _vl_iabs(d)

// vl_is_unimodular — true iff |det(basis)| == 1 (the basis is a unimodular lattice transform).
fn vl_is_unimodular(basis)
    let d = vl_abs_det(basis)
    d == 1
