// std/vector/vec_distance.nova — exact integer distance metrics between N-d int vectors.
// A vector is a list of integers. All results are integers. LEAF — imports NOTHING.
// Handles empty vectors (returns 0) and mismatched lengths (uses shorter length).

// _abs: absolute value of an integer
fn _vds_abs(x: int) -> int
    if x < 0
        return 0 - x
    x

// vds_l2_sq: squared Euclidean distance — sum of (a[i]-b[i])^2. Exact integer result.
fn vds_l2_sq(a: list, b: list) -> int
    let n = len(a)
    let m = len(b)
    if m < n
        n = m
    let s = 0
    let i = 0
    while i < n
        let d = a[i] - b[i]
        s += d * d
        i += 1
    s

// vds_l1: Manhattan (taxicab) distance — sum of |a[i]-b[i]|. Exact integer result.
fn vds_l1(a: list, b: list) -> int
    let n = len(a)
    let m = len(b)
    if m < n
        n = m
    let s = 0
    let i = 0
    while i < n
        let d = a[i] - b[i]
        s += _vds_abs(d)
        i += 1
    s

// vds_linf: Chebyshev distance — maximum of |a[i]-b[i]|. Exact integer result.
fn vds_linf(a: list, b: list) -> int
    let n = len(a)
    let m = len(b)
    if m < n
        n = m
    let best = 0
    for i in 0..n
        let d = _vds_abs(a[i] - b[i])
        if d > best
            best = d
    best
