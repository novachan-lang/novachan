// ============================================================================
// NOVA Standard Library — std/ml/label_encode
// ============================================================================
// Maps arbitrary string labels to dense int codes 0..n-1 (first-seen
// order) and back. This is the bridge module: run le_fit/le_transform on
// raw string labels first, then feed the resulting int codes into
// std/ml/confusion, std/ml/one_hot, std/ml/knn, std/ml/naive_bayes,
// std/ml/decision_stump, std/ml/kmeans and std/ml/cross_validate, which all
// operate on int labels. Pure math, no dependencies — LEAF module.
//
// PUBLIC API
//   le_fit(labels)              -> dict   { "map": dict(label -> int),
//                                            "classes": list(label) }
//                                          "classes"[code] is the original
//                                          label string for int code `code`
//   le_transform(labels, mapping) -> list   int codes; a label absent from
//                                            mapping["map"] encodes to -1
//                                            (sentinel: unseen label)
//   le_inverse(encoded, mapping)  -> list   original label strings; a code
//                                            out of range decodes to ""
//                                            (sentinel: invalid code)
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _le_.
// ============================================================================

// le_fit: assign each DISTINCT label in `labels` a dense int code in
// first-seen order, and return both directions of the mapping.
fn le_fit(labels: list) -> dict
    let map = {}
    let classes = []
    for i in 0..len(labels)
        let lbl = labels[i]
        if lbl not in map
            map[lbl] = len(classes)
            push(classes, lbl)
    let out = {}
    out["map"] = map
    out["classes"] = classes
    out

// le_transform: encode a list of labels to int codes using a fitted
// mapping. Labels never seen during le_fit encode to -1 rather than
// crashing or silently aliasing to an existing class.
fn le_transform(labels: list, mapping: dict) -> list
    let map = mapping["map"]
    let out = []
    for i in 0..len(labels)
        let lbl = labels[i]
        if lbl in map
            push(out, map[lbl])
        else
            push(out, -1)
    out

// le_inverse: decode a list of int codes back to their original label
// strings using a fitted mapping. An out-of-range code decodes to "".
fn le_inverse(encoded: list, mapping: dict) -> list
    let classes = mapping["classes"]
    let n = len(classes)
    let out = []
    for i in 0..len(encoded)
        let code = encoded[i]
        if code >= 0 and code < n
            push(out, classes[code])
        else
            push(out, "")
    out
