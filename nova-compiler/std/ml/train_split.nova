// ============================================================================
// NOVA Standard Library — std/ml/train_split
// ============================================================================
// Deterministic (NOT random) dataset splitting for train/test partitioning
// and k-fold cross-validation index generation. Determinism is intentional:
// the same input always produces the same split, so KATs and downstream
// pipelines are reproducible without needing a seeded PRNG. Callers who
// want a randomized split should shuffle `data` themselves (e.g. with
// std/random) before calling ts_split. Pure math, no dependencies — LEAF.
//
// PUBLIC API
//   ts_split(data, ratio)     -> list   [train, test], train = first
//                                        floor(len(data) * ratio) elements
//                                        (original order preserved), test =
//                                        the remainder
//   ts_kfold_indices(n, k)    -> list   k entries, each [train_idx, test_idx]
//                                        (lists of int, 0..n-1); fold i's
//                                        test_idx is a contiguous block,
//                                        train_idx is everything else
//
// ts_split: ratio is clamped to [0.0, 1.0]. n==0 -> [[], []].
// ts_kfold_indices: k is clamped to [1, n] (k > n would create empty test
// folds, which is never useful and would also make fold-size arithmetic
// divide unevenly in confusing ways); n==0 -> [] (no folds at all, since
// there is nothing to split). Folds are sized as evenly as possible — the
// first (n mod k) folds get one extra element, matching the standard
// k-fold convention used by scikit-learn's KFold.
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _ts_.
// ============================================================================

// ts_split: deterministic prefix/suffix split. `ratio` is the fraction of
// `data` (by position, not by value) placed in the train partition.
fn ts_split(data: list, ratio: float) -> list
    let n = len(data)
    if n == 0
        return [[], []]
    let r = ratio
    if r < 0.0
        r = 0.0
    if r > 1.0
        r = 1.0
    let cut = float_to_int(r * (n * 1.0))
    if cut < 0
        cut = 0
    if cut > n
        cut = n
    let train = []
    let test = []
    for i in 0..n
        if i < cut
            push(train, data[i])
        else
            push(test, data[i])
    [train, test]

// ts_kfold_indices: build k deterministic contiguous folds over indices
// 0..n-1. Returns a list of k [train_idx, test_idx] pairs.
fn ts_kfold_indices(n: int, k: int) -> list
    if n <= 0
        return []
    let kk = k
    if kk < 1
        kk = 1
    if kk > n
        kk = n
    let base = n / kk
    let extra = n - base * kk
    // fold_start[f] = index where fold f begins; fold_start[kk] = n (sentinel).
    let fold_start = []
    push(fold_start, 0)
    for f in 0..kk
        let size = base
        if f < extra
            size = size + 1
        push(fold_start, fold_start[f] + size)
    let folds = []
    for g in 0..kk
        let lo = fold_start[g]
        let hi = fold_start[g + 1]
        let test_idx = []
        let train_idx = []
        let idx = 0
        while idx < n
            if idx >= lo and idx < hi
                push(test_idx, idx)
            else
                push(train_idx, idx)
            idx = idx + 1
        push(folds, [train_idx, test_idx])
    folds
