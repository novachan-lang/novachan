// ============================================================================
// NOVA Standard Library — std/ml/knn
// ============================================================================
// k-nearest-neighbors classification over a dense float feature matrix with
// int class labels. Pure math, no dependencies — LEAF module.
//
// PUBLIC API
//   kn_euclidean(a, b)                        -> float   Euclidean distance
//                                                          between two
//                                                          equal-length
//                                                          float vectors
//   kn_classify(train_x, train_y, test_point, k) -> int   majority-vote
//                                                          predicted label
//                                                          among the k
//                                                          nearest training
//                                                          points
//
// train_x is a list of feature rows (list of float); train_y is the
// aligned list of int labels (train_y[i] is the label of train_x[i]). Ties
// in the majority vote are broken by the label with the SMALLEST nearest-
// neighbor rank sum among tied labels (i.e. among labels tied for the vote,
// prefer whichever one's closest representative is nearer) — deterministic
// and matches the common "break ties toward the closer neighbor" heuristic.
// k is clamped to [1, len(train_x)]; an empty training set returns -1
// (sentinel: no possible prediction).
//
// float codegen safety: every returned float is bound to a `let` before
// return.
//
// SYMBOL COLLISION GUARD: all private helpers prefixed _kn_.
// ============================================================================

// kn_euclidean: Euclidean distance between two equal-length float vectors.
// Bounds-checked: walks min(len(a), len(b)) components.
fn kn_euclidean(a: list, b: list) -> float
    let n = len(a)
    if len(b) < n
        n = len(b)
    let acc = 0.0
    for i in 0..n
        let d = a[i] * 1.0 - b[i] * 1.0
        acc += d * d
    let result = sqrt(acc)
    result

// _kn_topk_indices: indices of the k training points nearest to
// test_point, sorted nearest-first (insertion-sort by distance — O(n*k),
// fine for the small-to-medium datasets this module targets).
fn _kn_topk_indices(train_x: list, test_point: list, k: int) -> list
    let n = len(train_x)
    let idx = []
    let dist = []
    for i in 0..n
        let d = kn_euclidean(train_x[i], test_point)
        // Insertion-sort d into (idx, dist), kept in ascending-distance order.
        let pos = len(dist)
        push(dist, d)
        push(idx, i)
        while pos > 0 and dist[pos - 1] > dist[pos]
            let tmp_d = dist[pos - 1]
            dist[pos - 1] = dist[pos]
            dist[pos] = tmp_d
            let tmp_i = idx[pos - 1]
            idx[pos - 1] = idx[pos]
            idx[pos] = tmp_i
            pos -= 1
    let kk = k
    if kk > n
        kk = n
    let out = [idx[j] for j in 0..kk]
    out

// kn_classify: predict the label of test_point via majority vote among its
// k nearest neighbors in train_x/train_y.
fn kn_classify(train_x: list, train_y: list, test_point: list, k: int) -> int
    let n = len(train_x)
    if n == 0
        return -1
    let kk = k
    if kk < 1
        kk = 1
    if kk > n
        kk = n
    let neighbors = _kn_topk_indices(train_x, test_point, kk)
    // Tally votes; track, per distinct label, its count and the smallest
    // neighbor-rank (0 = nearest) at which it appears, for tie-breaking.
    let labels = []
    let counts = []
    let best_rank = []
    for rank in 0..len(neighbors)
        let idx = neighbors[rank]
        let lbl = train_y[idx]
        let li = -1
        let s = 0
        while s < len(labels)
            if labels[s] == lbl
                li = s
            s += 1
        if li < 0
            push(labels, lbl)
            push(counts, 1)
            push(best_rank, rank)
        else
            counts[li] += 1
    let best_i = 0
    for m in 0..len(labels)
        if counts[m] > counts[best_i]
            best_i = m
        else
            if counts[m] == counts[best_i] and best_rank[m] < best_rank[best_i]
                best_i = m
    labels[best_i]
