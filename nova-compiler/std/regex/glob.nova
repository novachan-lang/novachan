// std/regex/glob — glob PATTERN matching over plain strings (not filesystem
// paths — see std/os/glob for path globbing built on top of these same
// wildcard rules). Supports:
//   *        matches zero or more of any character
//   ?        matches exactly one of any character
//   [abc]    matches exactly one character that is 'a', 'b', or 'c'
//   [a-z]    matches exactly one character in the inclusive range a..z
//            (a class may mix literals and ranges, e.g. "[a-cX0-9]")
//   [!abc]   [^abc] negated class: one character that is NOT 'a','b','c'
// A literal "[" with no matching "]" is matched as a plain character (not
// treated as a broken class).
//
// Public API:
//   gl_match(pattern, text)  -> bool
//   gl_filter(pattern, list) -> list  (elements of list matching pattern)
//   gl_is_pattern(text)      -> bool  (true if text contains *, ?, or [)
//
// LEAF — imports nothing.

// _gl_find_class_end: given p[open_idx] == '[', return the index of the
// matching ']', or -1 if the class is never closed. A leading '!'/'^'
// (negation) and a leading ']' immediately after it (or after '[' with no
// negation) are treated as class content, not terminators — matching the
// conventional glob rule that "[]abc]" includes a literal ']'.
fn _gl_find_class_end(p: string, open_idx: int) -> int
    let n = len(p)
    let start = open_idx + 1
    if start < n
        let c = char_at(p, start)
        if c == "!" or c == "^"
            start = start + 1
    if start < n
        if char_at(p, start) == "]"
            start = start + 1
    let j = start
    while j < n
        if char_at(p, j) == "]"
            return j
        j = j + 1
    return 0 - 1

// _gl_class_body_matches: does ch appear (literally, or via an "a-z" range)
// anywhere in body?
fn _gl_class_body_matches(body: string, ch: string) -> bool
    let n = len(body)
    let i = 0
    let found = 0
    while i < n and found == 0
        let c = char_at(body, i)
        let is_range = 0
        if i + 2 < n
            if char_at(body, i + 1) == "-"
                is_range = 1
        if is_range == 1
            let lo = ord(c)
            let hi = ord(char_at(body, i + 2))
            let cb = ord(ch)
            if cb >= lo and cb <= hi
                found = 1
            i = i + 3
        else
            if c == ch
                found = 1
            i = i + 1
    return found == 1

// _gl_class_matches: does ch satisfy class content cls (the text strictly
// between '[' and ']', e.g. "abc", "a-z", "!abc")?
fn _gl_class_matches(cls: string, ch: string) -> bool
    let negate = 0
    let body = cls
    let n = len(cls)
    if n > 0
        let first = char_at(cls, 0)
        if first == "!" or first == "^"
            negate = 1
            body = slice(cls, 1, n)
    let matched = _gl_class_body_matches(body, ch)
    if negate == 1
        return not matched
    return matched

// _gl_match_at: recursive matcher — does p[pi..] match s[si..] to the end
// of both strings? `*` backtracks by trying "match zero more" first, then
// "consume one source char and retry the same pattern position".
fn _gl_match_at(p: string, pi: int, s: string, si: int) -> bool
    let pn = len(p)
    let sn = len(s)
    if pi == pn
        return si == sn
    let pc = char_at(p, pi)
    if pc == "*"
        if _gl_match_at(p, pi + 1, s, si)
            return true
        if si < sn
            return _gl_match_at(p, pi, s, si + 1)
        return false
    if si >= sn
        return false
    if pc == "?"
        return _gl_match_at(p, pi + 1, s, si + 1)
    if pc == "["
        let close = _gl_find_class_end(p, pi)
        if close < 0
            // Unterminated class: '[' is just a literal character.
            if char_at(s, si) == "["
                return _gl_match_at(p, pi + 1, s, si + 1)
            return false
        let cls = slice(p, pi + 1, close)
        if _gl_class_matches(cls, char_at(s, si))
            return _gl_match_at(p, close + 1, s, si + 1)
        return false
    if pc == char_at(s, si)
        return _gl_match_at(p, pi + 1, s, si + 1)
    return false

// gl_match: does text match pattern in its entirety?
fn gl_match(pattern: string, text: string) -> bool
    return _gl_match_at(pattern, 0, text, 0)

// gl_filter: elements of lst (a list of strings) that match pattern, in
// original order.
fn gl_filter(pattern: string, lst: list) -> list
    let out = [item for item in lst if gl_match(pattern, item)]
    return out

// gl_is_pattern: true if text contains any glob metacharacter (*, ?, or [),
// i.e. it should be treated as a pattern rather than a literal string.
fn gl_is_pattern(text: string) -> bool
    let i = 0
    let n = len(text)
    while i < n
        let c = char_at(text, i)
        if c == "*" or c == "?" or c == "["
            return true
        i = i + 1
    return false
