// ============================================================================
// NOVA Standard Library — std/money/tax.nova
//
// Tax calculation in exact integer arithmetic.
// All amounts are minor units (e.g. cents). Rates are basis points.
// 100% = 10000 bps.  8% VAT = 800 bps.
//
// Half-up rounding: (n + d/2) / d.
//
// Public API (prefix tax_):
//   tax_amount(net_minor, rate_bps)        -> int   tax portion (half-up)
//   tax_add(net_minor, rate_bps)           -> int   gross = net + tax
//   tax_extract_net(gross_minor, rate_bps) -> int   recover net from inclusive gross
//   tax_extract_tax(gross_minor, rate_bps) -> int   recover tax from inclusive gross
//   tax_gross_to_net(gross, bps)           -> int   alias for tax_extract_net
//   tax_breakdown(net, bps)                -> list  [net, tax, gross]
//   tax_effective_bps(net, tax)            -> int   actual rate in bps
// ============================================================================

// _tax_half_up — integer division n/d rounded half away from zero.
// For negative n, round the absolute value then re-apply the sign,
// so ties always go away from zero (e.g. -3/2 = -2, not -1).
fn _tax_half_up(n: int, d: int) -> int
    if d == 0
        return 0
    if n < 0
        let a = 0 - n
        let q = (a + d / 2) / d
        return 0 - q
    let result = (n + d / 2) / d
    result

// tax_amount — compute the tax on a net amount at rate_bps.
// tax = net * rate_bps / 10000, rounded half-up.
fn tax_amount(net_minor: int, rate_bps: int) -> int
    let result = _tax_half_up(net_minor * rate_bps, 10000)
    result

// tax_add — return the tax-inclusive gross (net + tax).
fn tax_add(net_minor: int, rate_bps: int) -> int
    let t = tax_amount(net_minor, rate_bps)
    let result = net_minor + t
    result

// tax_extract_net — recover the net from a tax-inclusive gross.
// Formula: net = gross * 10000 / (10000 + rate_bps), rounded half-up.
fn tax_extract_net(gross_minor: int, rate_bps: int) -> int
    let denom = 10000 + rate_bps
    let result = _tax_half_up(gross_minor * 10000, denom)
    result

// tax_extract_tax — compute the tax portion embedded in a gross amount.
// tax = gross - net.
fn tax_extract_tax(gross_minor: int, rate_bps: int) -> int
    let net = tax_extract_net(gross_minor, rate_bps)
    let result = gross_minor - net
    result

// tax_gross_to_net — alias for tax_extract_net for clarity at the call site.
fn tax_gross_to_net(gross: int, bps: int) -> int
    let result = tax_extract_net(gross, bps)
    result

// tax_breakdown — return [net, tax, gross] as a list.
fn tax_breakdown(net: int, bps: int) -> list
    let t = tax_amount(net, bps)
    let g = net + t
    let result = []
    push(result, net)
    push(result, t)
    push(result, g)
    result

// tax_effective_bps — given net and the actual tax paid, return the effective rate in bps.
// Returns 0 if net is zero to avoid division by zero.
fn tax_effective_bps(net: int, tax: int) -> int
    if net == 0
        return 0
    let result = tax * 10000 / net
    result
