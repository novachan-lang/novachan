// ============================================================================
// NOVA Standard Library — std/money/aggregate.nova
//
// Money aggregation over lists of minor-unit integers.
// All amounts are EXACT integers (minor units, e.g. cents).
// NO floats anywhere in this module.
//
// Rounding mode strings: "half_up" | "trunc" (truncation toward zero).
// Percentage results are in BASIS POINTS (10000 bps = 100.00%).
//
// Public API (prefix magg_):
//   magg_sum(xs)               -> int   sum of all amounts
//   magg_avg(xs, mode)         -> int   integer average, rounded per mode
//   magg_min(xs)               -> int   minimum amount
//   magg_max(xs)               -> int   maximum amount
//   magg_count(xs)             -> int   number of elements
//   magg_pct_of(part, whole)   -> int   basis points (part*10000/whole)
//   magg_running_total(xs)     -> list  cumulative sums
//   magg_diff(xs)              -> list  successive differences
//   magg_range(xs)             -> int   max - min
//   magg_median(xs)            -> int   middle value (or average of two middle)
// ============================================================================

// _magg_half_up — integer division n/d rounded half-up (ties away from zero).
fn _magg_half_up(n: int, d: int) -> int
    if d == 0
        return 0
    let half = d / 2
    let result = (n + half) / d
    result

// _magg_abs — absolute value of an integer.
fn _magg_abs(x: int) -> int
    if x < 0
        return 0 - x
    x

// magg_sum — sum all amounts in the list; returns 0 for empty list.
fn magg_sum(xs: list) -> int
    let s = 0
    for i in 0..len(xs)
        s = s + xs[i]
    s

// magg_count — number of elements in the list.
fn magg_count(xs: list) -> int
    len(xs)

// magg_avg — integer average; mode "half_up" rounds ties up, else truncates.
// Returns 0 for empty list.
fn magg_avg(xs: list, mode: string) -> int
    let n = len(xs)
    if n == 0
        return 0
    let s = magg_sum(xs)
    if mode == "half_up"
        return _magg_half_up(s, n)
    s / n

// magg_min — minimum element; returns 0 for empty list.
fn magg_min(xs: list) -> int
    let n = len(xs)
    if n == 0
        return 0
    let m = xs[0]
    for i in 1..n
        let v = xs[i]
        if v < m
            m = v
    m

// magg_max — maximum element; returns 0 for empty list.
fn magg_max(xs: list) -> int
    let n = len(xs)
    if n == 0
        return 0
    let m = xs[0]
    for i in 1..n
        let v = xs[i]
        if v > m
            m = v
    m

// magg_pct_of — percentage of part in whole, expressed as basis points.
// part * 10000 / whole, rounded half-up. Returns 0 if whole == 0.
fn magg_pct_of(part: int, whole: int) -> int
    if whole == 0
        return 0
    let num = part * 10000
    let result = _magg_half_up(num, whole)
    result

// magg_running_total — cumulative prefix sums of the list.
// [] -> [], [a,b,c] -> [a, a+b, a+b+c].
fn magg_running_total(xs: list) -> list
    let out = []
    let acc = 0
    for i in 0..len(xs)
        acc = acc + xs[i]
        push(out, acc)
    out

// magg_diff — successive differences between adjacent elements.
// [] -> [], [a] -> [], [a,b,c] -> [b-a, c-b].
fn magg_diff(xs: list) -> list
    let out = []
    let n = len(xs)
    if n < 2
        return out
    for i in 1..n
        let d = xs[i] - xs[i - 1]
        push(out, d)
    out

// magg_range — max - min; returns 0 for empty list.
fn magg_range(xs: list) -> int
    let n = len(xs)
    if n == 0
        return 0
    let mn = magg_min(xs)
    let mx = magg_max(xs)
    mx - mn

// _magg_sorted — return a new sorted copy (insertion sort, done-flag pattern).
// NEVER uses a negative sentinel index. Safe for any list length >= 0.
fn _magg_sorted(xs: list) -> list
    let out = []
    for i in 0..len(xs)
        push(out, xs[i])
        // insert out[i] into its correct position using a done-flag
        let j = len(out) - 1
        let done = 0
        while j > 0 and done == 0
            let prev = j - 1
            if out[prev] > out[j]
                let tmp = out[j]
                out[j] = out[prev]
                out[prev] = tmp
                j = prev
            else
                done = 1
    out

// magg_median — median of the list (sorted copy).
// Odd-length: middle element. Even-length: average (half-up) of two middle elements.
// Returns 0 for empty list.
fn magg_median(xs: list) -> int
    let n = len(xs)
    if n == 0
        return 0
    let s = _magg_sorted(xs)
    let mid = n / 2
    if n % 2 == 1
        return s[mid]
    let a = s[mid - 1]
    let b = s[mid]
    _magg_half_up(a + b, 2)
