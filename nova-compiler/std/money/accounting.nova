// ============================================================================
// NOVA Standard Library — std/money/accounting.nova
//
// Accounting-style presentation and double-entry bookkeeping primitives.
// All amounts are EXACT integers (minor units, e.g. cents). NO floats.
//
// Negative amounts displayed in parentheses per accounting convention.
// Thousands-separators and decimal points are inserted by acct_fmt.
//
// Public API (prefix acct_):
//   acct_fmt(minor, decimals)              -> string  "1,234.56" / "(1,234.56)"
//   acct_fmt_symbol(minor, decimals, sym)  -> string  "$1,234.56" / "($1,234.56)"
//   acct_sign_str(minor)                   -> string  "DR" | "CR" | ""
//   acct_debit_credit(minor)               -> list    [debit, credit]
//   acct_balance(debits, credits)          -> int     sum(debits) - sum(credits)
//   acct_is_balanced(debits, credits)      -> bool    balance == 0
//   acct_normal_side(minor, is_asset)      -> string  "DR" | "CR"
//   acct_zero_pad(minor, decimals)         -> string  raw digits zero-padded
// ============================================================================

// _acct_abs — absolute value.
fn _acct_abs(x: int) -> int
    if x < 0
        return 0 - x
    x

// _acct_list_sum — sum a list of ints.
fn _acct_list_sum(xs: list) -> int
    let s = 0
    let i = 0
    while i < len(xs)
        s = s + xs[i]
        i = i + 1
    s

// _acct_pow10 — compute 10^n for n >= 0 (integer, loop-based).
fn _acct_pow10(n: int) -> int
    let r = 1
    let i = 0
    while i < n
        r = r * 10
        i = i + 1
    r

// _acct_digits — convert non-negative integer to decimal string (no sign).
fn _acct_digits(x: int) -> string
    if x == 0
        return "0"
    let s = ""
    let v = x
    while v > 0
        let d = v % 10
        s = str(d) + s
        v = v / 10
    s

// _acct_group — insert thousands separators into an unsigned digit string.
// "1234567" -> "1,234,567"
fn _acct_group(digits: string) -> string
    let n = len(digits)
    let result = ""
    let i = 0
    while i < n
        let pos_from_right = n - 1 - i
        result = result + slice(digits, i, i + 1)
        if pos_from_right > 0 and pos_from_right % 3 == 0
            result = result + ","
        i = i + 1
    result

// _acct_format_abs — format |minor| with decimals decimal places, grouped.
// e.g. (123456, 2) -> "1,234.56"; (100, 0) -> "100".
fn _acct_format_abs(abs_minor: int, decimals: int) -> string
    if decimals == 0
        let ds = _acct_digits(abs_minor)
        return _acct_group(ds)
    let scale = _acct_pow10(decimals)
    let major = abs_minor / scale
    let frac = abs_minor % scale
    // zero-pad the fractional part to exactly 'decimals' digits
    let frac_str = _acct_digits(frac)
    let frac_padded = frac_str
    let pad_needed = decimals - len(frac_str)
    let pi = 0
    while pi < pad_needed
        frac_padded = "0" + frac_padded
        pi = pi + 1
    let major_str = _acct_digits(major)
    let grouped = _acct_group(major_str)
    grouped + "." + frac_padded

// acct_fmt — format a minor-unit amount with decimals decimal places.
// Negative amounts are displayed in parentheses: (1,234.56). Positive: 1,234.56.
fn acct_fmt(minor: int, decimals: int) -> string
    let abs_val = _acct_abs(minor)
    let formatted = _acct_format_abs(abs_val, decimals)
    if minor < 0
        return "(" + formatted + ")"
    formatted

// acct_fmt_symbol — like acct_fmt but with a currency symbol prefix.
// Negative: ($1,234.56). Positive: $1,234.56.
fn acct_fmt_symbol(minor: int, decimals: int, symbol: string) -> string
    let abs_val = _acct_abs(minor)
    let formatted = _acct_format_abs(abs_val, decimals)
    if minor < 0
        return "(" + symbol + formatted + ")"
    symbol + formatted

// acct_sign_str — return "DR" for positive (debit), "CR" for negative (credit), "" for zero.
fn acct_sign_str(minor: int) -> string
    if minor > 0
        return "DR"
    if minor < 0
        return "CR"
    ""

// acct_debit_credit — split a signed amount into [debit, credit].
// Positive: [minor, 0]. Negative: [0, |minor|]. Zero: [0, 0].
fn acct_debit_credit(minor: int) -> list
    let out = []
    if minor > 0
        push(out, minor)
        push(out, 0)
        return out
    if minor < 0
        push(out, 0)
        push(out, 0 - minor)
        return out
    push(out, 0)
    push(out, 0)
    out

// acct_balance — net balance: sum(debits) - sum(credits).
fn acct_balance(debits: list, credits: list) -> int
    let d = _acct_list_sum(debits)
    let c = _acct_list_sum(credits)
    d - c

// acct_is_balanced — true iff sum(debits) == sum(credits).
fn acct_is_balanced(debits: list, credits: list) -> bool
    acct_balance(debits, credits) == 0

// acct_normal_side — normal balance side per accounting convention.
// Assets/Expenses have a normal debit (DR) balance (is_asset = true or any nonzero).
// Liabilities/Equity/Revenue have a normal credit (CR) balance (is_asset = false/0).
fn acct_normal_side(minor: int, is_asset: int) -> string
    if is_asset != 0
        return "DR"
    "CR"

// acct_zero_pad — raw decimal representation zero-padded to min width.
// e.g. (1234, 2) -> "1234"; (5, 2) -> "05"; (0, 3) -> "000".
// Returns the zero-padded string of |minor| to at least 'decimals' digits.
fn acct_zero_pad(minor: int, decimals: int) -> string
    let abs_val = _acct_abs(minor)
    let ds = _acct_digits(abs_val)
    let result = ds
    let pad = decimals - len(ds)
    let pi = 0
    while pi < pad
        result = "0" + result
        pi = pi + 1
    result
