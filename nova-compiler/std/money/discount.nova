// ============================================================================
// NOVA Standard Library — std/money/discount.nova
//
// Discount calculations using exact integer arithmetic.
// All amounts are minor units (e.g. cents). Rates are basis points.
// 100% = 10000 bps.  25% off = 2500 bps.
//
// Half-up rounding: (n + d/2) / d.
//
// Public API (prefix disc_):
//   disc_pct(minor, pct_bps)              -> int   amount after percentage discount
//   disc_pct_amount(minor, pct_bps)       -> int   the discount amount only
//   disc_fixed(minor, off_minor)          -> int   minor - off, floored at 0
//   disc_compound(minor, bps_list)        -> int   successive percentage discounts
//   disc_tiered(minor, thresholds, bps_list) -> int  pick tier for highest threshold <= minor
//   disc_best(minor, pct_bps, fixed_off)  -> int   whichever yields the lower price
//   disc_markup(cost, margin_bps)         -> int   price = cost*10000/(10000-margin_bps)
// ============================================================================

// _disc_half_up — integer division n/d rounded half away from zero.
// For negative n, round the absolute value then re-apply the sign,
// so ties always go away from zero (e.g. -3/2 = -2, not -1).
fn _disc_half_up(n: int, d: int) -> int
    if d == 0
        return 0
    if n < 0
        let a = 0 - n
        let q = (a + d / 2) / d
        return 0 - q
    let result = (n + d / 2) / d
    result

// disc_pct_amount — compute the discount (reduction) for a percentage in bps.
// discount = minor * pct_bps / 10000, rounded half-up.
fn disc_pct_amount(minor: int, pct_bps: int) -> int
    let result = _disc_half_up(minor * pct_bps, 10000)
    result

// disc_pct — return the amount after a percentage discount.
// result = minor - disc_pct_amount(minor, pct_bps).
fn disc_pct(minor: int, pct_bps: int) -> int
    let d = disc_pct_amount(minor, pct_bps)
    let result = minor - d
    result

// disc_fixed — subtract a fixed amount off, floored at 0.
fn disc_fixed(minor: int, off_minor: int) -> int
    let result = minor - off_minor
    if result < 0
        return 0
    result

// disc_compound — apply a list of percentage discounts in sequence.
// Each element of bps_list is a discount in bps applied to the running amount.
// e.g. [1000, 1000] means 10% off then 10% off the remainder.
fn disc_compound(minor: int, bps_list: list) -> int
    let amount = minor
    let n = len(bps_list)
    for i in 0..n
        let bps = bps_list[i]
        let d = _disc_half_up(amount * bps, 10000)
        amount = amount - d
    amount

// disc_tiered — pick the highest threshold that is <= minor, apply its bps.
// thresholds and bps_list are parallel lists (same length).
// If no threshold applies (minor < first threshold), return minor unchanged.
fn disc_tiered(minor: int, thresholds: list, bps_list: list) -> int
    let n = len(thresholds)
    if n == 0
        return minor
    let chosen_bps = 0
    for i in 0..n
        let thr = thresholds[i]
        if minor >= thr
            chosen_bps = bps_list[i]
    let d = _disc_half_up(minor * chosen_bps, 10000)
    let result = minor - d
    result

// disc_best — apply whichever discount (pct or fixed) yields the lower price.
fn disc_best(minor: int, pct_bps: int, fixed_off: int) -> int
    let after_pct = disc_pct(minor, pct_bps)
    let after_fixed = disc_fixed(minor, fixed_off)
    if after_pct < after_fixed
        return after_pct
    after_fixed

// disc_markup — compute a sale price from cost and a gross margin in bps.
// price = cost * 10000 / (10000 - margin_bps).
// e.g. 50% margin (5000 bps): price = cost * 10000 / 5000 = cost * 2.
fn disc_markup(cost: int, margin_bps: int) -> int
    let denom = 10000 - margin_bps
    if denom <= 0
        return 0
    let result = _disc_half_up(cost * 10000, denom)
    result
