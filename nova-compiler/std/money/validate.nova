// ============================================================================
// NOVA Standard Library — std/money/validate.nova
//
// Money validation and safe arithmetic primitives.
// All amounts are EXACT integers (minor units, e.g. cents). NO floats.
//
// mvalid_add_safe clamps the result to +/- limit (documented behavior).
// mvalid_max_amount returns 9_223_372_036_854_775 (i64 max / 1000, a safe cap).
//
// Public API (prefix mvalid_):
//   mvalid_range(minor, lo, hi)              -> bool   lo <= minor <= hi
//   mvalid_positive(minor)                   -> bool   minor > 0
//   mvalid_non_negative(minor)               -> bool   minor >= 0
//   mvalid_same_currency(a_code, b_code)     -> bool   string equality
//   mvalid_add_safe(a, b, limit)             -> int    a+b clamped to +/-limit
//   mvalid_is_minor(x)                       -> bool   always true for int inputs
//   mvalid_max_amount()                      -> int    9223372036854775
//   mvalid_no_overflow_mul(a, b, limit)      -> bool   |a*b| <= limit
//   mvalid_currency_match_or(a, b, dflt)     -> string a if a==b else dflt
//   mvalid_cents_in_range(cents, decimals)   -> bool   0 <= cents < 10^decimals
//   mvalid_round_trip(minor, decimals)       -> bool   parse/format round-trip check
// ============================================================================

// _mvalid_abs — absolute value of an integer.
fn _mvalid_abs(x: int) -> int
    if x < 0
        return 0 - x
    x

// _mvalid_pow10 — compute 10^n for n >= 0 (loop-based, no overflow risk for n <= 18).
fn _mvalid_pow10(n: int) -> int
    let r = 1
    for i in 0..n
        r = r * 10
    r

// mvalid_range — true iff lo <= minor <= hi.
fn mvalid_range(minor: int, lo: int, hi: int) -> bool
    minor >= lo and minor <= hi

// mvalid_positive — true iff minor > 0.
fn mvalid_positive(minor: int) -> bool
    minor > 0

// mvalid_non_negative — true iff minor >= 0.
fn mvalid_non_negative(minor: int) -> bool
    minor >= 0

// mvalid_same_currency — true iff both ISO codes are identical strings.
fn mvalid_same_currency(a_code: string, b_code: string) -> bool
    a_code == b_code

// mvalid_add_safe — add a and b; if |result| > limit, clamp to +limit or -limit.
// Clamping is safe and documented (not silent truncation — callers should check).
fn mvalid_add_safe(a: int, b: int, limit: int) -> int
    let sum = a + b
    if sum > limit
        return limit
    if sum < 0 - limit
        return 0 - limit
    sum

// mvalid_is_minor — true for any integer (NOVA integers are always valid minor units).
fn mvalid_is_minor(x: int) -> bool
    true

// mvalid_max_amount — a sane upper bound for monetary amounts in minor units.
// 9223372036854775 is i64_max / 1000, safely below overflow for most operations.
fn mvalid_max_amount() -> int
    9223372036854775

// mvalid_no_overflow_mul — true iff |a * b| <= limit (pre-multiplication check).
// Avoids actual overflow by dividing: |a| <= limit / |b| when |b| > 0.
fn mvalid_no_overflow_mul(a: int, b: int, limit: int) -> bool
    let abs_a = _mvalid_abs(a)
    let abs_b = _mvalid_abs(b)
    if abs_b == 0
        return true
    let safe_threshold = limit / abs_b
    abs_a <= safe_threshold

// mvalid_currency_match_or — return a_code if a_code == b_code, else dflt.
fn mvalid_currency_match_or(a_code: string, b_code: string, dflt: string) -> string
    if a_code == b_code
        return a_code
    dflt

// mvalid_cents_in_range — true iff 0 <= cents < 10^decimals.
// e.g. cents=34, decimals=2: 0 <= 34 < 100 -> true.
//      cents=100, decimals=2: 100 < 100 is false -> false.
fn mvalid_cents_in_range(cents: int, decimals: int) -> bool
    if cents < 0
        return false
    let limit = _mvalid_pow10(decimals)
    cents < limit

// _mvalid_reconstruct — reconstruct minor units from major and fractional parts.
// minor = major * 10^decimals + frac_part.
fn _mvalid_reconstruct(major: int, frac_part: int, decimals: int) -> int
    let scale = _mvalid_pow10(decimals)
    major * scale + frac_part

// mvalid_round_trip — verify that decomposing minor into (major, frac) and
// reconstructing gives back the original minor amount.
// Decomposition: major = minor / 10^decimals; frac = minor % 10^decimals.
// For negative amounts, the sign is on major; frac is taken from abs value.
fn mvalid_round_trip(minor: int, decimals: int) -> bool
    let scale = _mvalid_pow10(decimals)
    let major = minor / scale
    let frac = minor % scale
    let reconstructed = _mvalid_reconstruct(major, frac, decimals)
    reconstructed == minor
