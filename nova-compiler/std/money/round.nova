// ============================================================================
// NOVA Standard Library — std/money/round.nova
//
// Integer rounding modes for exact money arithmetic.
// PRINCIPLE: money is ALWAYS an integer count of minor units.
//   All division here produces an integer result by choosing a rounding mode.
//   No floats anywhere. All math is pure integer arithmetic.
//
// Percentages/rates use basis points (integer): 8% = 800 bps, 100% = 10000 bps.
//
// Public API (prefix mround_):
//   mround_div(num, den, mode) -> int    general rounding division
//   mround_half_up(num, den)   -> int    round half away from zero
//   mround_half_even(num, den) -> int    banker's rounding (round half to even)
//   mround_half_down(num, den) -> int    round half toward zero
//   mround_ceil(num, den)      -> int    ceiling (toward +infinity)
//   mround_floor(num, den)     -> int    floor (toward -infinity)
//   mround_trunc(num, den)     -> int    truncation (toward zero)
//   mround_bankers(num, den)   -> int    alias for mround_half_even
//   mround_pct(minor, bps, mode) -> int  apply basis-point percentage with rounding
//
// IMPLEMENTATION NOTES:
//   NOVA integer division truncates toward zero (C semantics).
//   NOVA `%` remainder carries the sign of the dividend.
//   We normalize: abs_r = |r| so comparisons are always non-negative.
//   To avoid duplicate if/else nesting we use local int flags.
//
// LEAF — imports NOTHING. All helpers private with _mr_ prefix.
// ============================================================================

// _mr_abs — absolute value of an integer.
fn _mr_abs(x: int) -> int
    if x < 0
        return -x
    x

// _mr_sign_of — sign of x: -1 if x<0, 1 if x>0, 0 if zero.
fn _mr_sign_of(x: int) -> int
    if x < 0
        return -1
    if x > 0
        return 1
    0

// _mr_away_from_zero — add 1 in the direction away from zero for the quotient.
// If num and den have the same sign, quotient is positive → add 1.
// If opposite signs, quotient is negative → subtract 1.
fn _mr_away_from_zero(q: int, num: int, den: int) -> int
    // Same sign (both pos or both neg) → positive quotient → round up toward +inf
    let num_sign = _mr_sign_of(num)
    let den_sign = _mr_sign_of(den)
    if num_sign == den_sign
        return q + 1
    q - 1

// mround_trunc — truncate division (toward zero). This is NOVA's native `/`.
// mround_trunc(7, 2) == 3 (3.5 → 3)
// mround_trunc(-7, 2) == -3 (-3.5 → -3, toward zero)
fn mround_trunc(num: int, den: int) -> int
    num / den

// mround_ceil — ceiling division (toward +infinity).
// mround_ceil(5, 2) == 3   (2.5 → 3)
// mround_ceil(-5, 2) == -2 (-2.5 → -2, toward +inf)
fn mround_ceil(num: int, den: int) -> int
    let q = num / den
    let r = num % den
    // If remainder is positive (numerator pushed past a whole), go up
    if r > 0
        return q + 1
    q

// mround_floor — floor division (toward -infinity).
// mround_floor(5, 2) == 2   (2.5 → 2)
// mround_floor(-5, 2) == -3 (-2.5 → -3, toward -inf)
fn mround_floor(num: int, den: int) -> int
    let q = num / den
    let r = num % den
    // If remainder is negative (numerator pushed below a whole), go down
    if r < 0
        return q - 1
    q

// mround_half_up — round half away from zero. Tie (exactly .5) rounds away.
// mround_half_up(5, 2) == 3   (2.5 → 3, away from zero)
// mround_half_up(7, 2) == 4   (3.5 → 4)
// mround_half_up(-5, 2) == -3 (-2.5 → -3, away from zero)
fn mround_half_up(num: int, den: int) -> int
    let q = num / den
    let r = num % den
    let abs_r = _mr_abs(r)
    let two_r = 2 * abs_r
    // If 2*|r| >= den, round away from zero
    if two_r >= den
        return _mr_away_from_zero(q, num, den)
    q

// mround_half_down — round half toward zero. Tie rounds toward zero.
// mround_half_down(5, 2) == 2  (2.5 → 2, toward zero)
// mround_half_down(7, 2) == 3  (3.5 → 3, toward zero)
fn mround_half_down(num: int, den: int) -> int
    let q = num / den
    let r = num % den
    let abs_r = _mr_abs(r)
    let two_r = 2 * abs_r
    // Only round away from zero if STRICTLY past the midpoint
    if two_r > den
        return _mr_away_from_zero(q, num, den)
    q

// mround_half_even — banker's rounding (round half to nearest even).
// When exactly halfway (2*|r| == den), round to the nearest even quotient.
// mround_half_even(5, 2) == 2  (2.5 → 2, because 2 is even)
// mround_half_even(7, 2) == 4  (3.5 → 4, because 4 is even)
// mround_half_even(2, 2) == 1  (1.0 → 1, exact, no rounding)
fn mround_half_even(num: int, den: int) -> int
    let q = num / den
    let r = num % den
    let abs_r = _mr_abs(r)
    let two_r = 2 * abs_r
    if two_r > den
        // Past midpoint: round away from zero
        return _mr_away_from_zero(q, num, den)
    if two_r == den
        // Exactly halfway: round to even
        // q % 2: if odd, round away from zero; if even, stay
        let mod2 = q % 2
        if mod2 != 0
            return _mr_away_from_zero(q, num, den)
    q

// mround_bankers — alias for mround_half_even (banker's rounding).
fn mround_bankers(num: int, den: int) -> int
    mround_half_even(num, den)

// mround_div — general rounding division. Dispatches to the appropriate mode.
// Supported modes: "half_up", "up", "half_down", "half_even", "bankers",
//                  "ceil", "floor", "trunc".
// Unknown mode falls back to trunc.
fn mround_div(num: int, den: int, mode: string) -> int
    if mode == "half_up" or mode == "up"
        return mround_half_up(num, den)
    if mode == "half_down"
        return mround_half_down(num, den)
    if mode == "half_even" or mode == "bankers"
        return mround_half_even(num, den)
    if mode == "ceil"
        return mround_ceil(num, den)
    if mode == "floor"
        return mround_floor(num, den)
    // "trunc" or unknown
    mround_trunc(num, den)

// mround_pct — apply a basis-point percentage to a minor-unit amount.
// Computes: minor * bps / 10000, rounded per `mode`.
// mround_pct(10000, 2550, "half_up") == 2550  (25.5% of 100.00 = 25.50 = 2550 cents)
// mround_pct(10000, 1000, "half_up") == 1000  (10% of 100.00 = 10.00)
fn mround_pct(minor: int, bps: int, mode: string) -> int
    let product = minor * bps
    mround_div(product, 10000, mode)
