// std/probability/prob_geometric.nova — geometric distribution (first-success model).
// SELF-CONTAINED — imports NOTHING.
//
// Fractions are [num, den] lists reduced to lowest terms; den > 0 always.
//
// Public API:
//   pg_pmf(k, pnum, pden) -> [num,den]   P(X=k) = (1-p)^(k-1) * p
//   pg_cdf(k, pnum, pden) -> [num,den]   P(X<=k) = 1 - (1-p)^k
//   pg_mean(pnum, pden)   -> [num,den]   E[X] = 1/p

// _gcd — Euclidean GCD; always non-negative.
fn _gcd(a: int, b: int) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    return a

// _make — build a reduced fraction [num, den] with den > 0.
fn _make(n: int, d: int) -> any
    if d < 0
        n = 0 - n
        d = 0 - d
    if n == 0
        let r = [0, 1]
        return r
    let g = _gcd(n, d)
    if g < 0
        g = 0 - g
    if g == 0
        g = 1
    let r = [n / g, d / g]
    return r

// _frac_pow — raise fraction [pn, pd] to power k; returns [num,den] reduced.
fn _frac_pow(pn: int, pd: int, k: int) -> any
    if k == 0
        let r = [1, 1]
        return r
    let rn = 1
    let rd = 1
    for i in 0..k
        rn = rn * pn
        rd = rd * pd
    return _make(rn, rd)

// _frac_sub — compute 1 - [n,d] = [(d-n)/d].
fn _frac_sub_from_one(n: int, d: int) -> any
    return _make(d - n, d)

// _frac_mul — multiply two fractions [an,ad] * [bn,bd].
fn _frac_mul(an: int, ad: int, bn: int, bd: int) -> any
    return _make(an * bn, ad * bd)

// pg_pmf — P(X=k) for geometric distribution with success prob p=pnum/pden.
// P(X=k) = (1-p)^(k-1) * p.  Returns [0,1] for k<1 or invalid p.
fn pg_pmf(k: int, pnum: int, pden: int) -> any
    if k < 1
        return _make(0, 1)
    if pnum <= 0 or pden <= 0
        return _make(0, 1)
    if pnum > pden
        return _make(0, 1)
    // q = 1 - p = (pden - pnum) / pden
    let qn = pden - pnum
    let qd = pden
    // q^(k-1)
    let qk = _frac_pow(qn, qd, k - 1)
    // * p
    return _frac_mul(qk[0], qk[1], pnum, pden)

// pg_cdf — P(X<=k) = 1 - (1-p)^k.  Returns [0,1] for k<1 or invalid p.
fn pg_cdf(k: int, pnum: int, pden: int) -> any
    if k < 1
        return _make(0, 1)
    if pnum <= 0 or pden <= 0
        return _make(0, 1)
    if pnum > pden
        return _make(1, 1)
    // q^k
    let qn = pden - pnum
    let qd = pden
    let qk = _frac_pow(qn, qd, k)
    // 1 - q^k
    return _frac_sub_from_one(qk[0], qk[1])

// pg_mean — E[X] = 1/p = pden/pnum.  Returns [0,1] for invalid p.
fn pg_mean(pnum: int, pden: int) -> any
    if pnum <= 0 or pden <= 0
        return _make(0, 1)
    return _make(pden, pnum)
