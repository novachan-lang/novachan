// std/probability/prob_binomial.nova — Exact binomial distribution with rational p.
// LEAF — imports NOTHING.
//
// Success probability p = pnum/pden is an exact reduced fraction.
// All results are exact reduced fractions [num, den] with den > 0
// and gcd(|num|, den) == 1.  Zero = [0, 1].
//
// Public API:
//   pb_pmf(n, k, pnum, pden)          -> list   P(X=k) = C(n,k) * p^k * (1-p)^(n-k)
//   pb_cdf(n, k, pnum, pden)          -> list   P(X<=k) = sum_{j=0}^{k} pmf(n,j,p)
//   pb_mean(n, pnum, pden)            -> list   n * p
//   pb_variance(n, pnum, pden)        -> list   n * p * (1-p)

// _gcd — Euclidean GCD on non-negative integers.
fn _gcd(a: int, b: int) -> int
    let u = a
    if u < 0
        u = -u
    let v = b
    if v < 0
        v = -v
    while v != 0
        let t = u % v
        u = v
        v = t
    u

// _make — reduce p/q to lowest terms with den > 0.
fn _make(p: int, q: int) -> list
    let out = []
    if p == 0
        out.push(0)
        out.push(1)
        return out
    let ap = p
    if ap < 0
        ap = -ap
    let aq = q
    if aq < 0
        aq = -aq
    let g = _gcd(ap, aq)
    let rp = p / g
    let rq = q / g
    if rq < 0
        rp = -rp
        rq = -rq
    out.push(rp)
    out.push(rq)
    out

// _comb — C(n, k) via multiplicative formula with running integer division.
fn _comb(n: int, k: int) -> int
    if k < 0
        return 0
    if k > n
        return 0
    let kk = k
    if n - k < kk
        kk = n - k
    let val = 1
    for i in 0..kk
        val *= (n - i) / (i + 1)
    val

// _frac_mul — multiply two fractions [n1,d1] * [n2,d2], return reduced result.
fn _frac_mul(f1: list, f2: list) -> list
    let n1 = f1[0]
    let d1 = f1[1]
    let n2 = f2[0]
    let d2 = f2[1]
    if n1 == 0 or n2 == 0
        return _make(0, 1)
    // cross-reduce n1/d2 and n2/d1 to keep numbers small
    let g1 = _gcd(n1, d2)
    if g1 < 0
        g1 = -g1
    let g2 = _gcd(n2, d1)
    if g2 < 0
        g2 = -g2
    let rn1 = n1 / g1
    let rd2 = d2 / g1
    let rn2 = n2 / g2
    let rd1 = d1 / g2
    _make(rn1 * rn2, rd1 * rd2)

// _frac_add — add two fractions [n1,d1] + [n2,d2], return reduced result.
fn _frac_add(f1: list, f2: list) -> list
    let n1 = f1[0]
    let d1 = f1[1]
    let n2 = f2[0]
    let d2 = f2[1]
    let g = _gcd(d1, d2)
    let d1r = d1 / g
    let d2r = d2 / g
    let top = n1 * d2r + n2 * d1r
    let bot = d1 * d2r
    _make(top, bot)

// _frac_pow — raise fraction [pn, pd] to integer power e; returns reduced fraction.
// [pn, pd]^0 = [1, 1]; result = [pn^e, pd^e].
fn _frac_pow(pn: int, pd: int, e: int) -> list
    if e == 0
        return _make(1, 1)
    let rn = 1
    let rd = 1
    for i in 0..e
        rn *= pn
        rd *= pd
    _make(rn, rd)

// pb_pmf — P(X = k) for X ~ Binomial(n, pnum/pden).
// = C(n,k) * (pnum/pden)^k * ((pden-pnum)/pden)^(n-k)
fn pb_pmf(n: int, k: int, pnum: int, pden: int) -> list
    if k < 0 or k > n
        return _make(0, 1)
    let c = _comb(n, k)
    // p^k
    let pk = _frac_pow(pnum, pden, k)
    // (1-p)^(n-k) = ((pden-pnum)/pden)^(n-k)
    let qn = pden - pnum
    let qk = _frac_pow(qn, pden, n - k)
    // C(n,k) as fraction [c, 1]
    let cf = _make(c, 1)
    // result = cf * pk * qk
    let tmp = _frac_mul(cf, pk)
    _frac_mul(tmp, qk)

// pb_cdf — P(X <= k) = sum_{j=0}^{k} P(X=j).
fn pb_cdf(n: int, k: int, pnum: int, pden: int) -> list
    let acc = _make(0, 1)
    let j = 0
    let kk = k
    if kk > n
        kk = n
    while j <= kk
        let term = pb_pmf(n, j, pnum, pden)
        acc = _frac_add(acc, term)
        j += 1
    acc

// pb_mean — E[X] = n * p = n * pnum / pden; returns [num, den] reduced.
fn pb_mean(n: int, pnum: int, pden: int) -> list
    _make(n * pnum, pden)

// pb_variance — Var[X] = n * p * (1-p) = n * pnum * (pden-pnum) / pden^2; returns [num, den].
fn pb_variance(n: int, pnum: int, pden: int) -> list
    let qnum = pden - pnum
    _make(n * pnum * qnum, pden * pden)
