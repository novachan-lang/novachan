// std/probability/prob_gambler.nova — gambler's ruin exact probability and duration.
// LEAF — imports NOTHING. Probabilities are exact reduced fractions [num,den].
//
// Gambler starts with i units, target N units, single-bet win probability p = pnum/pden.
// Ruin = reaching 0 before N.
//
// Formulas:
//   p == 1/2 (fair):   P(ruin | i) = (N-i)/N
//   p != 1/2 (biased): P(ruin | i) = (r^i - r^N) / (1 - r^N)  where r = (1-p)/p = qnum/qden
//   Expected duration (fair game only): i*(N-i)

// _gcd — greatest common divisor via Euclidean algorithm (always non-negative).
fn _gcd(a: int, b: int) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    return a

// _make — build reduced fraction [num, den] with den>0.
fn _make(n: int, d: int) -> any
    if d < 0
        n = 0 - n
        d = 0 - d
    if n == 0
        let r = []
        push(r, 0)
        push(r, 1)
        return r
    let g = _gcd(n, d)
    let r = []
    push(r, n / g)
    push(r, d / g)
    return r

// _fmul — multiply two fractions [an,ad] and [bn,bd], return reduced fraction.
fn _fmul(an: int, ad: int, bn: int, bd: int) -> any
    return _make(an * bn, ad * bd)

// _fsub — subtract two fractions: [an,ad] - [bn,bd], return reduced fraction.
fn _fsub(an: int, ad: int, bn: int, bd: int) -> any
    return _make(an * bd - bn * ad, ad * bd)

// _fpow — raise fraction [fn_,fd] to non-negative integer power k, return reduced fraction.
fn _fpow(fn_: int, fd: int, k: int) -> any
    let rn = 1
    let rd = 1
    let i = 0
    while i < k
        let p = _fmul(rn, rd, fn_, fd)
        rn = p[0]
        rd = p[1]
        i = i + 1
    return _make(rn, rd)

// pgm_ruin_prob — probability of being ruined (reaching 0 before N) starting from i.
// Returns exact reduced fraction [num, den].
fn pgm_ruin_prob(i: int, N: int, pnum: int, pden: int) -> any
    // Edge cases
    if i <= 0
        return _make(1, 1)
    if i >= N
        return _make(0, 1)
    // Check fair game: 2*pnum == pden (p == 1/2)
    if 2 * pnum == pden
        return _make(N - i, N)
    // Biased: r = (1-p)/p = (pden-pnum)/pnum
    let qnum = pden - pnum
    let qden = pnum
    // r^i and r^N as reduced fractions
    let ri = _fpow(qnum, qden, i)
    let rN = _fpow(qnum, qden, N)
    // P(ruin) = (r^i - r^N) / (1 - r^N)
    // numerator = r^i - r^N = ri[0]*rN[1] - rN[0]*ri[1]  over ri[1]*rN[1]
    // denominator = 1 - r^N = (rN[1] - rN[0]) / rN[1]
    // full fraction = [(ri[0]*rN[1] - rN[0]*ri[1]) / (ri[1]*rN[1])] / [(rN[1]-rN[0])/rN[1]]
    //              = (ri[0]*rN[1] - rN[0]*ri[1]) / (ri[1] * (rN[1]-rN[0]))
    let num = ri[0] * rN[1] - rN[0] * ri[1]
    let den = ri[1] * (rN[1] - rN[0])
    return _make(num, den)

// pgm_reach_target_prob — probability of reaching N before 0, starting from i.
// = 1 - P(ruin | i).
fn pgm_reach_target_prob(i: int, N: int, pnum: int, pden: int) -> any
    let ruin = pgm_ruin_prob(i, N, pnum, pden)
    // 1 - ruin[0]/ruin[1] = (ruin[1] - ruin[0]) / ruin[1]
    return _make(ruin[1] - ruin[0], ruin[1])

// pgm_expected_duration — expected number of bets until ruin or win in the fair (p=1/2) game.
// Formula: E[T | start=i] = i * (N - i).  Returns an int.
fn pgm_expected_duration(i: int, N: int) -> int
    return i * (N - i)
