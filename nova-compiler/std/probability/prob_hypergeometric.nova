// std/probability/prob_hypergeometric.nova — hypergeometric distribution (exact).
// Draws WITHOUT replacement from a finite population.
// All results are exact reduced fractions [num, den] (den > 0, gcd(|num|,den)=1).
// LEAF — imports NOTHING.
//
// Public API (prefix ph_):
//   ph_pmf(N, K, n, k)     -> [num, den]  P(X=k); population N, K successes, draw n
//   ph_mean(N, K, n)        -> [num, den]  E[X] = n*K/N
//   ph_at_least(N, K, n, k) -> [num, den]  P(X >= k) = sum_{j=k}^{min(K,n)} P(X=j)

// _gcd — Euclidean GCD; always returns a positive value.
fn _gcd(a: int, b: int) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    if a == 0
        return 1
    a

// _make — reduce num/den to lowest terms; ensure den > 0.
fn _make(n: int, d: int) -> list
    if d < 0
        n = 0 - n
        d = 0 - d
    if n == 0
        return [0, 1]
    let g = _gcd(n, d)
    if g < 0
        g = 0 - g
    let rn = n / g
    let rd = d / g
    [rn, rd]

// _comb — C(n, k) via multiplicative formula with running integer division.
// result = product_{i=0}^{k-1} (n-i)/(i+1); each step is exact (always divisible).
// Returns 0 for k < 0 or k > n.
fn _comb(n: int, k: int) -> int
    if k < 0
        return 0
    if k > n
        return 0
    // symmetry: C(n,k) == C(n,n-k)
    let kk = k
    if n - k < kk
        kk = n - k
    let result = 1
    for i in 0..kk
        result = result * (n - i)
        result = result / (i + 1)
    result

// ph_pmf — P(X=k) for hypergeometric(N, K, n).
// Formula: C(K,k) * C(N-K, n-k) / C(N, n).
// Returns [0,1] for any out-of-range k.
fn ph_pmf(N: int, K: int, n: int, k: int) -> list
    if k < 0
        return [0, 1]
    if k > K
        return [0, 1]
    if k > n
        return [0, 1]
    if n - k > N - K
        return [0, 1]
    let num = _comb(K, k) * _comb(N - K, n - k)
    let den = _comb(N, n)
    if den == 0
        return [0, 1]
    _make(num, den)

// ph_mean — E[X] = n*K/N (exact fraction).
// Returns [0,1] when N=0.
fn ph_mean(N: int, K: int, n: int) -> list
    if N == 0
        return [0, 1]
    _make(n * K, N)

// ph_at_least — P(X >= k) = sum_{j=k}^{min(K,n)} ph_pmf(N,K,n,j).
// Result accumulated as an exact fraction via cross-multiplication.
fn ph_at_least(N: int, K: int, n: int, k: int) -> list
    let hi = K
    if n < hi
        hi = n
    if k > hi
        return [0, 1]
    // accumulate as p_num/p_den
    let p_num = 0
    let p_den = 1
    let j = k
    while j <= hi
        let t = ph_pmf(N, K, n, j)
        let tn = t[0]
        let td = t[1]
        // p = p + tn/td  ->  (p_num*td + tn*p_den) / (p_den*td)
        let new_num = p_num * td + tn * p_den
        let new_den = p_den * td
        let r = _make(new_num, new_den)
        p_num = r[0]
        p_den = r[1]
        j = j + 1
    [p_num, p_den]
