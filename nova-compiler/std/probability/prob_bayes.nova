// std/probability/prob_bayes.nova — exact Bayesian update and related calculations.
// All results are exact reduced fractions [num, den] (den > 0, gcd(|num|,den)=1).
// LEAF — imports NOTHING.
//
// Public API (prefix pby_):
//   pby_posterior(prior_n, prior_d, sens_n, sens_d, fpr_n, fpr_d) -> [num, den]
//     P(A|B) via Bayes: prior*sens / (prior*sens + (1-prior)*fpr)
//   pby_joint(pa_n, pa_d, pb_n, pb_d) -> [num, den]
//     Joint probability of independent events: P(A)*P(B)
//   pby_total_prob(prior_n, prior_d, sens_n, sens_d, fpr_n, fpr_d) -> [num, den]
//     Denominator P(B) = prior*sens + (1-prior)*fpr

// _gcd — Euclidean GCD; always returns a positive value.
fn _gcd(a: int, b: int) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    if a == 0
        return 1
    a

// _make — reduce num/den to lowest terms; ensure den > 0.
fn _make(n: int, d: int) -> list
    if d < 0
        n = 0 - n
        d = 0 - d
    if n == 0
        return [0, 1]
    let g = _gcd(n, d)
    if g < 0
        g = 0 - g
    let rn = n / g
    let rd = d / g
    [rn, rd]

// _frac_mul — exact fraction multiply: (an/ad) * (bn/bd) reduced.
fn _frac_mul(an: int, ad: int, bn: int, bd: int) -> list
    _make(an * bn, ad * bd)

// _frac_add — exact fraction add: (an/ad) + (bn/bd) reduced.
fn _frac_add(an: int, ad: int, bn: int, bd: int) -> list
    _make(an * bd + bn * ad, ad * bd)

// _frac_sub — exact fraction subtract: (an/ad) - (bn/bd) reduced.
fn _frac_sub(an: int, ad: int, bn: int, bd: int) -> list
    _make(an * bd - bn * ad, ad * bd)

// pby_total_prob — P(B) = prior*sens + (1-prior)*fpr.
// This is the total probability of testing positive (the Bayes denominator).
fn pby_total_prob(prior_n: int, prior_d: int, sens_n: int, sens_d: int, fpr_n: int, fpr_d: int) -> list
    // term1 = prior * sens
    let t1 = _frac_mul(prior_n, prior_d, sens_n, sens_d)
    // complement = 1 - prior = (prior_d - prior_n) / prior_d
    let comp = _frac_sub(prior_d, prior_d, prior_n, prior_d)
    // term2 = (1 - prior) * fpr
    let t2 = _frac_mul(comp[0], comp[1], fpr_n, fpr_d)
    // P(B) = term1 + term2
    _frac_add(t1[0], t1[1], t2[0], t2[1])

// pby_posterior — P(A|B) = prior*sens / (prior*sens + (1-prior)*fpr).
// Classic diagnostic Bayes update.
// Returns [0,1] when denominator is zero.
fn pby_posterior(prior_n: int, prior_d: int, sens_n: int, sens_d: int, fpr_n: int, fpr_d: int) -> list
    // numerator = prior * sens
    let num_f = _frac_mul(prior_n, prior_d, sens_n, sens_d)
    // denominator = total probability P(B)
    let den_f = pby_total_prob(prior_n, prior_d, sens_n, sens_d, fpr_n, fpr_d)
    if den_f[0] == 0
        return [0, 1]
    // posterior = num_f / den_f = (num_f[0]/num_f[1]) / (den_f[0]/den_f[1])
    //           = num_f[0] * den_f[1] / (num_f[1] * den_f[0])
    _make(num_f[0] * den_f[1], num_f[1] * den_f[0])

// pby_joint — joint probability of two independent events: P(A) * P(B).
fn pby_joint(pa_n: int, pa_d: int, pb_n: int, pb_d: int) -> list
    _frac_mul(pa_n, pa_d, pb_n, pb_d)
