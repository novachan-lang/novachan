// std/probability/prob_derangement.nova — derangement probabilities (exact fractions).
// SELF-CONTAINED — imports NOTHING.
//
// Fractions are [num, den] lists reduced to lowest terms; den > 0 always.
//
// Public API:
//   pdr_count(n)                  -> int       D_n (number of derangements of n elements)
//   pdr_prob(n)                   -> [num,den] D_n / n!  (probability a random permutation is a derangement)
//   pdr_at_least_one_fixed(n)     -> [num,den] 1 - D_n/n!  (probability at least one element is fixed)

// _gcd — Euclidean GCD; always non-negative.
fn _gcd(a: int, b: int) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    return a

// _make — build a reduced fraction [num, den] with den > 0.
fn _make(n: int, d: int) -> any
    if d < 0
        n = 0 - n
        d = 0 - d
    if n == 0
        let r = [0, 1]
        return r
    let g = _gcd(n, d)
    if g < 0
        g = 0 - g
    if g == 0
        g = 1
    let r = [n / g, d / g]
    return r

// _factorial — n! iterative.
fn _factorial(n: int) -> int
    if n <= 1
        return 1
    let acc = 1
    let i = 2
    while i <= n
        acc = acc * i
        i += 1
    return acc

// pdr_count — subfactorial D_n via recurrence D_n = (n-1)*(D_{n-1}+D_{n-2}).
// D_0=1, D_1=0.
fn pdr_count(n: int) -> int
    if n == 0
        return 1
    if n == 1
        return 0
    let d_prev2 = 1
    let d_prev1 = 0
    let i = 2
    while i <= n
        let d_cur = (i - 1) * (d_prev1 + d_prev2)
        d_prev2 = d_prev1
        d_prev1 = d_cur
        i += 1
    return d_prev1

// pdr_prob — D_n / n! as a reduced fraction [num,den].
// For n=0: D_0/0! = 1/1. For n=1: D_1/1! = 0/1.
fn pdr_prob(n: int) -> any
    if n < 0
        return _make(0, 1)
    let dn = pdr_count(n)
    let fn_ = _factorial(n)
    return _make(dn, fn_)

// pdr_at_least_one_fixed — 1 - D_n/n! as a reduced fraction.
// Probability that a random permutation of n elements has at least one fixed point.
fn pdr_at_least_one_fixed(n: int) -> any
    if n < 0
        return _make(0, 1)
    let p = pdr_prob(n)
    // 1 - p[0]/p[1] = (p[1] - p[0]) / p[1]
    return _make(p[1] - p[0], p[1])
