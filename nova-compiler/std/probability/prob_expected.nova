// std/probability/prob_expected.nova — exact expectation and variance.
// All results are exact reduced fractions [num, den] (den > 0, gcd(|num|,den)=1).
// Values and weights are lists of integers. Empty inputs return [0,1].
// LEAF — imports NOTHING.
//
// Public API (prefix pe_):
//   pe_expected(values, weights) -> [num, den]  weighted mean sum(v_i*w_i)/sum(w_i)
//   pe_variance(values, weights) -> [num, den]  E[X^2] - E[X]^2 (exact)
//   pe_mean_uniform(values)      -> [num, den]  uniform mean = sum(v_i)/n

// _gcd — Euclidean GCD; always returns a positive value.
fn _gcd(a: int, b: int) -> int
    if a < 0
        a = 0 - a
    if b < 0
        b = 0 - b
    while b != 0
        let t = b
        b = a - (a / b) * b
        a = t
    if a == 0
        return 1
    a

// _make — reduce num/den to lowest terms; ensure den > 0.
fn _make(n: int, d: int) -> list
    if d < 0
        n = 0 - n
        d = 0 - d
    if n == 0
        return [0, 1]
    let g = _gcd(n, d)
    if g < 0
        g = 0 - g
    let rn = n / g
    let rd = d / g
    [rn, rd]

// _frac_add — add two exact fractions a_n/a_d + b_n/b_d, return reduced [num,den].
fn _frac_add(an: int, ad: int, bn: int, bd: int) -> list
    let num = an * bd + bn * ad
    let den = ad * bd
    _make(num, den)

// _frac_sub — subtract b_n/b_d from a_n/a_d, return reduced [num,den].
fn _frac_sub(an: int, ad: int, bn: int, bd: int) -> list
    let num = an * bd - bn * ad
    let den = ad * bd
    _make(num, den)

// _frac_mul — multiply two exact fractions, return reduced [num,den].
fn _frac_mul(an: int, ad: int, bn: int, bd: int) -> list
    _make(an * bn, ad * bd)

// pe_expected — weighted mean: sum(v_i * w_i) / sum(w_i).
// Empty list or zero total weight returns [0,1].
fn pe_expected(values: list, weights: list) -> list
    let n = len(values)
    if n == 0
        return [0, 1]
    let w_sum = 0
    let wv_num = 0
    let wv_den = 1
    for i in 0..n
        let w = weights[i]
        let v = values[i]
        w_sum += w
        // accumulate wv as exact fraction: wv += v*w/1
        let r = _frac_add(wv_num, wv_den, v * w, 1)
        wv_num = r[0]
        wv_den = r[1]
    if w_sum == 0
        return [0, 1]
    // result = wv_num/wv_den / w_sum = wv_num / (wv_den * w_sum)
    _make(wv_num, wv_den * w_sum)

// pe_variance — population variance: E[X^2] - E[X]^2 (exact).
// Uses weighted mean of squares minus square of weighted mean.
// Empty list or zero total weight returns [0,1].
fn pe_variance(values: list, weights: list) -> list
    let n = len(values)
    if n == 0
        return [0, 1]
    let w_sum = 0
    let wv_num = 0
    let wv_den = 1
    let wv2_num = 0
    let wv2_den = 1
    for i in 0..n
        let w = weights[i]
        let v = values[i]
        w_sum += w
        let r1 = _frac_add(wv_num, wv_den, v * w, 1)
        wv_num = r1[0]
        wv_den = r1[1]
        let r2 = _frac_add(wv2_num, wv2_den, v * v * w, 1)
        wv2_num = r2[0]
        wv2_den = r2[1]
    if w_sum == 0
        return [0, 1]
    // E[X]   = wv_num  / (wv_den  * w_sum)
    // E[X^2] = wv2_num / (wv2_den * w_sum)
    let ex_n = wv_num
    let ex_d = wv_den * w_sum
    let ex2_n = wv2_num
    let ex2_d = wv2_den * w_sum
    // variance = E[X^2] - E[X]^2
    let ex2r = _make(ex2_n, ex2_d)
    let exr  = _make(ex_n, ex_d)
    // (E[X])^2 = exr[0]^2 / exr[1]^2
    let ex_sq_n = exr[0] * exr[0]
    let ex_sq_d = exr[1] * exr[1]
    _frac_sub(ex2r[0], ex2r[1], ex_sq_n, ex_sq_d)

// pe_mean_uniform — uniform mean: sum(v_i) / n (exact).
// Empty list returns [0,1].
fn pe_mean_uniform(values: list) -> list
    let n = len(values)
    if n == 0
        return [0, 1]
    let s = 0
    for i in 0..n
        s += values[i]
    _make(s, n)
