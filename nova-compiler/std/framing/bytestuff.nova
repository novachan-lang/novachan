// ============================================================================
// NOVA Standard Library — std/framing/bytestuff
// ============================================================================
// Generic byte stuffing / escaping for stream framing.
//
// Byte stuffing replaces special delimiter bytes with an escape sequence so
// they can pass transparently through a framed stream.  The scheme used here
// follows the PPP / SLIP convention:
//
//   special_byte -> ESC, (special_byte XOR 0x20)
//   ESC          -> ESC, (ESC         XOR 0x20)
//
// A buffer is a LIST OF INTS, each 0..255.
//
// PUBLIC API:
//   bs_stuff(data, special, esc)       -> list  Stuff one special byte + ESC.
//   bs_unstuff(data, esc)              -> list  Reverse stuffing.
//   bs_stuff_set(data, specials, esc)  -> list  Stuff a set of special bytes.
//   bs_unstuff_set(data, esc)          -> list  Reverse stuffing (same as bs_unstuff).
//   bs_count_specials(data, specials)  -> int   Count occurrences of any special byte.
//   bs_overhead(data, specials)        -> int   Extra bytes the stuffing will add.
//   bs_escape_byte(b, esc)             -> int   Compute the escaped payload: b XOR 0x20.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// _bs_in_set: return 1 if byte b is in the list `specials`, else 0.
fn _bs_in_set(b: int, specials: list) -> int
    1 if b in specials else 0

// ── Public API ────────────────────────────────────────────────────────────────

// bs_escape_byte: return the escaped payload byte for byte b: b XOR 0x20.
// Used both for the special delimiter and for ESC itself.
fn bs_escape_byte(b: int, esc: int) -> int
    b ^ 0x20

// bs_stuff: escape every occurrence of `special` and `esc` in `data`.
//   special -> esc, (special XOR 0x20)
//   esc     -> esc, (esc     XOR 0x20)
// Returns a new list; `data` is not modified.
fn bs_stuff(data: list, special: int, esc: int) -> list
    let out = []
    let n = len(data)
    for i in 0..n
        let b = data[i]
        if b == special
            push(out, esc)
            push(out, special ^ 0x20)
        else if b == esc
            push(out, esc)
            push(out, esc ^ 0x20)
        else
            push(out, b)
    out

// bs_unstuff: reverse byte stuffing applied by bs_stuff.
// After an ESC byte, the next byte is XOR-0x20'd to recover the original byte.
// Unknown escape sequences (ESC,X where X is not a known escape) still decode
// via XOR-0x20 — consistent and lossless for any conformant encoder.
// Returns a new list; never crashes on malformed (trailing ESC dropped).
fn bs_unstuff(data: list, esc: int) -> list
    let out = []
    let n = len(data)
    let i = 0
    while i < n
        let b = data[i]
        if b == esc
            if i + 1 < n
                let nb = data[i + 1]
                push(out, nb ^ 0x20)
                i += 2
            else
                i += 1
        else
            push(out, b)
            i += 1
    out

// bs_stuff_set: escape every byte in `specials` and also `esc` itself.
// Each such byte x -> esc, (x XOR 0x20).
// Returns a new list.
fn bs_stuff_set(data: list, specials: list, esc: int) -> list
    let out = []
    let n = len(data)
    for i in 0..n
        let b = data[i]
        if b == esc
            push(out, esc)
            push(out, esc ^ 0x20)
        else if b in specials
            push(out, esc)
            push(out, b ^ 0x20)
        else
            push(out, b)
    out

// bs_unstuff_set: reverse stuffing from bs_stuff_set.
// Semantically identical to bs_unstuff — the decoder is ESC-only, stateless.
fn bs_unstuff_set(data: list, esc: int) -> list
    let out = []
    let n = len(data)
    let i = 0
    while i < n
        let b = data[i]
        if b == esc
            if i + 1 < n
                let nb = data[i + 1]
                push(out, nb ^ 0x20)
                i += 2
            else
                i += 1
        else
            push(out, b)
            i += 1
    out

// bs_count_specials: count how many bytes in `data` are in the `specials` list.
fn bs_count_specials(data: list, specials: list) -> int
    len([b for b in data if b in specials])

// bs_overhead: how many extra bytes stuffing adds for the bytes in `specials`.
// Counts each byte of `data` that is in `specials` (each becomes 2 bytes). NOTE: this
// does NOT receive the esc byte — since bs_stuff_set also escapes esc, include esc in
// `specials` when you want the true total overhead.
fn bs_overhead(data: list, specials: list) -> int
    len([b for b in data if b in specials])
