// std/framing/delimiter.nova
// Delimiter-based stream framing — split a byte stream on sentinel bytes/sequences.
// Used in line-oriented protocols (HTTP headers, SMTP, NNTP), SLIP, netstrings, etc.
//
// PUBLIC API:
//   delim_frames(stream, delim)         -> list  split on single delimiter byte; drop empty trailing
//   delim_frames_seq(stream, delimlist) -> list  split on multi-byte delimiter sequence
//   delim_append(frame, delim)          -> list  append delimiter byte to a frame
//   delim_has_complete(stream, delim)   -> bool  true if at least one delimiter found
//   delim_first_frame(stream, delim)    -> dict  {frame, rest} split off first frame
//   delim_count(stream, delim)          -> int   count delimiter occurrences
//   delim_line_frames(stream)           -> list  split on 0x0A (LF/newline)
//   delim_strip_cr(frame)               -> list  remove trailing 0x0D (CR)
//
// SELF-CONTAINED: imports nothing.  All helpers prefixed _delim_.

// ── Private helpers ───────────────────────────────────────────────────────────

// Copy a slice buf[start..start+count) into a new list.
fn _delim_slice(buf, start, count) -> any
    let out = []
    for i in 0..count
        push(out, buf[start + i] & 0xFF)
    out

// Check whether delimlist appears in stream starting at position pos.
fn _delim_seq_match(stream, pos, delimlist) -> bool
    let sn = len(stream)
    let dn = len(delimlist)
    if dn == 0
        return true
    if pos + dn > sn
        return false
    let i = 0
    let ok = true
    while i < dn and ok
        if (stream[pos + i] & 0xFF) != (delimlist[i] & 0xFF)
            ok = false
        i += 1
    ok

// ── Public API ────────────────────────────────────────────────────────────────

// delim_frames: split stream into frames on a single delimiter byte.
// Empty frames between consecutive delimiters are included.
// A trailing empty frame after a final delimiter is dropped.
fn delim_frames(stream, delim) -> any
    let frames = []
    let n = len(stream)
    let db = delim & 0xFF
    let start = 0
    for i in 0..n
        let b = stream[i] & 0xFF
        if b == db
            let frame = _delim_slice(stream, start, i - start)
            push(frames, frame)
            start = i + 1
    // add trailing segment only if non-empty
    let tail_len = n - start
    if tail_len > 0
        let tail = _delim_slice(stream, start, tail_len)
        push(frames, tail)
    frames

// delim_frames_seq: split stream into frames on a multi-byte delimiter sequence.
// Empty frames between consecutive delimiter sequences are included.
// A trailing empty frame after a final delimiter sequence is dropped.
fn delim_frames_seq(stream, delimlist) -> any
    let frames = []
    let sn = len(stream)
    let dn = len(delimlist)
    if dn == 0
        let whole = _delim_slice(stream, 0, sn)
        push(frames, whole)
        return frames
    let start = 0
    let i = 0
    while i <= sn - dn
        if _delim_seq_match(stream, i, delimlist)
            let frame = _delim_slice(stream, start, i - start)
            push(frames, frame)
            start = i + dn
            i = start
        else
            i += 1
    // add trailing segment only if non-empty
    let tail_len = sn - start
    if tail_len > 0
        let tail = _delim_slice(stream, start, tail_len)
        push(frames, tail)
    frames

// delim_append: concatenate frame bytes with a single trailing delimiter byte.
fn delim_append(frame, delim) -> any
    let out = []
    let n = len(frame)
    for i in 0..n
        push(out, frame[i] & 0xFF)
    push(out, delim & 0xFF)
    out

// delim_has_complete: true if stream contains at least one occurrence of delim.
fn delim_has_complete(stream, delim) -> bool
    let n = len(stream)
    let db = delim & 0xFF
    for i in 0..n
        if (stream[i] & 0xFF) == db
            return true
    false

// delim_first_frame: split off the bytes before the first delimiter.
// Returns {frame: list, rest: list}.
// If no delimiter is found, frame = entire stream, rest = [].
fn delim_first_frame(stream, delim) -> any
    let n = len(stream)
    let db = delim & 0xFF
    let r = {}
    for i in 0..n
        if (stream[i] & 0xFF) == db
            r["frame"] = _delim_slice(stream, 0, i)
            r["rest"] = _delim_slice(stream, i + 1, n - i - 1)
            return r
    r["frame"] = _delim_slice(stream, 0, n)
    let empty = []
    r["rest"] = empty
    r

// delim_count: count how many times delim byte appears in stream.
fn delim_count(stream, delim) -> int
    let n = len(stream)
    let db = delim & 0xFF
    let count = 0
    for i in 0..n
        if (stream[i] & 0xFF) == db
            count += 1
    count

// delim_line_frames: split a byte stream on 0x0A (LF) characters.
// Equivalent to delim_frames(stream, 0x0A).
fn delim_line_frames(stream) -> any
    delim_frames(stream, 10)

// delim_strip_cr: remove a trailing 0x0D (CR) byte from a frame, if present.
// Handles the common CRLF protocol pattern where lines end with CR+LF but
// the LF is the delimiter (consumed by splitting) leaving a trailing CR.
fn delim_strip_cr(frame) -> any
    let n = len(frame)
    if n == 0
        let empty = []
        return empty
    let last = frame[n - 1] & 0xFF
    if last == 13
        return _delim_slice(frame, 0, n - 1)
    _delim_slice(frame, 0, n)
