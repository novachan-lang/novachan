// ============================================================================
// NOVA Standard Library — std/framing/escaping
// ============================================================================
// General-purpose byte escape/unescape with configurable escape maps.
//
// PUBLIC API:
//   esc_escape(data, esc, map_from, map_to)  -> list
//     Escape data: for each byte b in map_from, emit esc then the
//     corresponding byte from map_to. The escape byte itself must be
//     included in map_from (with its own replacement in map_to).
//
//   esc_unescape(data, esc, map_to, map_from) -> list
//     Invert esc_escape. When esc is encountered, read the next byte,
//     look it up in map_to and emit the corresponding byte from map_from.
//
//   esc_simple(data, esc, specials) -> list
//     Simple escaping: escape byte and each byte in specials as
//     esc followed by (byte XOR 0x20). Used by SLIP-like protocols.
//
//   esc_unsimple(data, esc) -> list
//     Invert esc_simple: esc followed by B gives (B XOR 0x20).
//
//   esc_needs_escaping(b, specials) -> bool
//     True if byte b appears in the specials list.
//
//   esc_count(data, specials) -> int
//     Count of bytes in data that require escaping.
//
//   esc_c_style(s) -> string
//     Escape a string C-style: LF->\n, TAB->\t, backslash->\\, quote->\".
//
//   esc_c_unstyle(s) -> string
//     Invert esc_c_style.
//
//   esc_hex_dump_escape(data) -> string
//     Non-printable bytes (< 0x20 or >= 0x7F) rendered as \xHH; others as-is.
//
// All private helpers use prefix _esc_.
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// _esc_find: find byte b in list, return index or -1 if not found.
fn _esc_find(lst: list, b: int) -> int
    let n = len(lst)
    for i in 0..n
        if lst[i] == b
            return i
    -1

// _esc_hex_char: convert nibble 0..15 to lowercase ASCII hex char code.
fn _esc_hex_char(nibble: int) -> int
    if nibble < 10
        return 48 + nibble
    return 87 + nibble

// ── Public API ────────────────────────────────────────────────────────────────

// esc_escape: escape each byte in map_from using esc + corresponding map_to byte.
// map_from and map_to must be same length. Bytes not in map_from pass through unchanged.
fn esc_escape(data: list, esc: int, map_from: list, map_to: list) -> list
    let out = []
    let n = len(data)
    for i in 0..n
        let b = data[i]
        let idx = _esc_find(map_from, b)
        if idx >= 0
            push(out, esc)
            push(out, map_to[idx])
        else
            push(out, b)
    out

// esc_unescape: invert esc_escape. esc followed by byte in map_to yields
// the corresponding byte from map_from. Unescaped bytes pass through.
fn esc_unescape(data: list, esc: int, map_to: list, map_from: list) -> list
    let out = []
    let n = len(data)
    let i = 0
    while i < n
        let b = data[i]
        if b == esc
            i += 1
            if i < n
                let next = data[i]
                let idx = _esc_find(map_to, next)
                if idx >= 0
                    push(out, map_from[idx])
                else
                    // Unknown escape sequence: pass through both bytes
                    push(out, esc)
                    push(out, next)
        else
            push(out, b)
        i += 1
    out

// esc_simple: escape esc byte and each byte in specials as esc,(byte XOR 0x20).
// This is the SLIP/KISS-style escaping scheme.
fn esc_simple(data: list, esc: int, specials: list) -> list
    let out = []
    let n = len(data)
    for i in 0..n
        let b = data[i]
        let is_special = false
        if b == esc
            is_special = true
        if not is_special
            let sidx = _esc_find(specials, b)
            if sidx >= 0
                is_special = true
        if is_special
            push(out, esc)
            let xored = b ^ 0x20
            let masked = xored & 0xFF
            push(out, masked)
        else
            push(out, b)
    out

// esc_unsimple: invert esc_simple. esc followed by B yields (B XOR 0x20).
fn esc_unsimple(data: list, esc: int) -> list
    let out = []
    let n = len(data)
    let i = 0
    while i < n
        let b = data[i]
        if b == esc
            i += 1
            if i < n
                let next = data[i]
                let restored = next ^ 0x20
                let masked = restored & 0xFF
                push(out, masked)
        else
            push(out, b)
        i += 1
    out

// esc_needs_escaping: true if byte b is in the specials list.
fn esc_needs_escaping(b: int, specials: list) -> bool
    let idx = _esc_find(specials, b)
    if idx >= 0
        return true
    false

// esc_count: count of bytes in data that need escaping (appear in specials).
fn esc_count(data: list, specials: list) -> int
    let n = len(data)
    let count = 0
    for i in 0..n
        if esc_needs_escaping(data[i], specials)
            count += 1
    count

// esc_c_style: escape a string C-style.
// LF (10) -> backslash n, TAB (9) -> backslash t, backslash (92) -> \\, quote (34) -> \".
// All outputs use chr(92) for backslash since NOVA "\\" produces one backslash.
fn esc_c_style(s: string) -> string
    let n = len(s)
    let out = ""
    let bs = chr(92)
    for i in 0..n
        let ch = s[i]
        let code = ord(ch)
        if code == 10
            out += bs + "n"
        else
            if code == 9
                out += bs + "t"
            else
                if code == 92
                    out += bs + bs
                else
                    if code == 34
                        out += bs + chr(34)
                    else
                        out += ch
    out

// esc_c_unstyle: invert esc_c_style.
// \n->LF, \t->TAB, \\->backslash, \"->quote. Other \X passes X through.
fn esc_c_unstyle(s: string) -> string
    let n = len(s)
    let out = ""
    let i = 0
    let bs = 92
    while i < n
        let ch = s[i]
        let code = ord(ch)
        if code == bs
            i += 1
            if i < n
                let next = s[i]
                let nc = ord(next)
                if nc == 110
                    out += chr(10)
                else
                    if nc == 116
                        out += chr(9)
                    else
                        if nc == bs
                            out += chr(92)
                        else
                            if nc == 34
                                out += chr(34)
                            else
                                out += next
        else
            out += ch
        i += 1
    out

// esc_hex_dump_escape: non-printable bytes (< 0x20 or >= 0x7F) as \xHH, others as-is.
fn esc_hex_dump_escape(data: list) -> string
    let n = len(data)
    let out_parts = []
    for i in 0..n
        let b = data[i]
        let masked = b & 0xFF
        if masked < 32 or masked >= 127
            let hi = (masked >> 4) & 0xF
            let lo = masked & 0xF
            push(out_parts, chr(92) + "x" + chr(_esc_hex_char(hi)) + chr(_esc_hex_char(lo)))
        else
            push(out_parts, chr(masked))
    let out = join(out_parts, "")
    out
