// ============================================================================
// NOVA Standard Library — std/cipher/foursquare
// ============================================================================
// Four-Square cipher (Wheatstone 1817, popularised by Felix Delastelle ~1902).
//
// Uses four 5×5 Polybius squares arranged in a 2×2 grid:
//
//   [ TL: standard ]  [ TR: key1    ]
//   [ BL: key2     ]  [ BR: standard]
//
// The standard squares use the 25-letter alphabet A-Z with J omitted (I≡J).
// The keyed squares fill positions with key letters first (deduped, left to
// right), then the remaining alphabet letters, also omitting J.
//
// I/J HANDLING: J in input is silently replaced by I before encryption.
// J never appears in any square. Decrypted output also never contains J.
//
// ENCRYPTION (digraph):
//   Locate p1 in TL (row r1, col c1) and p2 in BR (row r2, col c2).
//   Output c1 = TR[r1][c2]  and  c2 = BL[r2][c1].
//
// DECRYPTION (digraph):
//   Locate c1 in TR (row r1, col c2) and c2 in BL (row r2, col c1).
//   Output p1 = TL[r1][c1]  and  p2 = BR[r2][c2].
//
// ODD-LENGTH INPUT: a trailing X is appended to make the length even before
// encryption.  Callers should be aware that decrypted output may end in X.
//
// PUBLIC API:
//   foursquare_encrypt(pt, key1, key2) -> string
//     Normalise pt (uppercase, J→I, drop non-letters, pad odd with X),
//     then encrypt using key1 (TR square) and key2 (BL square).
//
//   foursquare_decrypt(ct, key1, key2) -> string
//     Normalise ct (uppercase, J→I, drop non-letters) then decrypt.
//     foursquare_decrypt(foursquare_encrypt(pt,k1,k2),k1,k2) == normalise(pt)
//     for any even-length (or X-padded) plaintext.
//
// KNOWN VECTOR:
//   foursquare_encrypt("HELPMEOBIWAN", "EXAMPLE", "KEYWORD") == "FYGMKYHOBXMF"
//   foursquare_decrypt("FYGMKYHOBXMF", "EXAMPLE", "KEYWORD") == "HELPMEOBIWAN"
//
// COMPLEXITY: O(k + n) where k = key length, n = plaintext length.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// _fs_std_alpha: the 25-letter standard alphabet string (no J).
fn _fs_std_alpha() -> string
    "ABCDEFGHIKLMNOPQRSTUVWXYZ"

// _fs_build_square: build a keyed 5×5 square as a flat 25-element list.
// `key` letters appear first (uppercased, J→I, deduped), then the remaining
// standard alphabet letters in order.  Returns a list of 25 single-char strings.
fn _fs_build_square(key) -> list
    // Phase 1: collect unique key letters (uppercase, J→I) preserving order
    let seen = {}
    let sq = []
    let klen = len(key)
    for i in 0..klen
        let b = ord(key[i])
        // Uppercase
        if b >= 97 and b <= 122
            b = b - 32
        // Skip non-letters
        if b >= 65 and b <= 90
            // J→I
            if b == 74
                b = 73
            let ch = chr(b)
            if contains(seen, ch) == 0
                seen[ch] = 1
                let dummy = push(sq, ch)
                dummy = dummy
    // Phase 2: fill with remaining standard alphabet letters
    let alpha = _fs_std_alpha()
    for ai in 0..25
        let ch = slice(alpha, ai, ai + 1)
        if contains(seen, ch) == 0
            seen[ch] = 1
            let dummy = push(sq, ch)
            dummy = dummy
    sq

// _fs_build_index: build a reverse-lookup dict from letter -> flat index (0..24)
// for a square returned by _fs_build_square.
fn _fs_build_index(sq) -> dict
    let idx = {}
    for i in 0..25
        idx[sq[i]] = i
    idx

// _fs_normalize: uppercase input, replace J→I, drop non-letters.
fn _fs_normalize(s) -> string
    let n = len(s)
    let out = ""
    for i in 0..n
        let b = ord(s[i])
        if b >= 97 and b <= 122
            b = b - 32
        if b >= 65 and b <= 90
            if b == 74
                b = 73
            out = out + chr(b)
    out

// ── Public API ────────────────────────────────────────────────────────────────

// foursquare_encrypt: encrypt plaintext using the four-square cipher.
//
// `pt`   — plaintext (any case, may contain non-letters which are dropped).
// `key1` — keyword for the top-right square.
// `key2` — keyword for the bottom-left square.
//
// Returns uppercase ciphertext of even length.
//
// Examples:
//   foursquare_encrypt("HELPMEOBIWAN", "EXAMPLE", "KEYWORD") == "FYGMKYHOBXMF"
//   foursquare_encrypt("", "A", "B")                         == ""
fn foursquare_encrypt(pt, key1, key2) -> string
    // Build squares
    let std_sq = _fs_build_square("")
    let tr_sq  = _fs_build_square(key1)
    let bl_sq  = _fs_build_square(key2)
    // Build reverse-lookup for TL (standard) and BR (standard) — same square
    let std_idx = _fs_build_index(std_sq)
    // Normalise and pad
    let norm = _fs_normalize(pt)
    if len(norm) % 2 == 1
        norm = norm + "X"
    let n = len(norm)
    let out = ""
    let i = 0
    while i < n
        let p1 = slice(norm, i, i + 1)
        let p2 = slice(norm, i + 1, i + 2)
        // Locate p1 in TL (standard): flat index → row, col
        let idx1 = std_idx[p1]
        let r1 = idx1 / 5
        let c1 = idx1 - r1 * 5
        // Locate p2 in BR (standard): flat index → row, col
        let idx2 = std_idx[p2]
        let r2 = idx2 / 5
        let c2 = idx2 - r2 * 5
        // c1 = TR[r1][c2]
        let o1 = tr_sq[r1 * 5 + c2]
        // c2 = BL[r2][c1]
        let o2 = bl_sq[r2 * 5 + c1]
        out = out + o1 + o2
        i = i + 2
    out

// foursquare_decrypt: decrypt ciphertext using the four-square cipher.
//
// `ct`   — ciphertext (uppercase letters; non-letters are dropped on input).
// `key1` — keyword for the top-right square (same as used during encryption).
// `key2` — keyword for the bottom-left square (same as used during encryption).
//
// Returns uppercase plaintext.  If encryption padded with X, the trailing X
// will appear in the decrypted output.
//
// foursquare_decrypt(foursquare_encrypt(pt, k1, k2), k1, k2)
//   == foursquare_encrypt normalisation of pt
//
// Examples:
//   foursquare_decrypt("FYGMKYHOBXMF", "EXAMPLE", "KEYWORD") == "HELPMEOBIWAN"
//   foursquare_decrypt("", "A", "B")                          == ""
fn foursquare_decrypt(ct, key1, key2) -> string
    // Build squares
    let std_sq = _fs_build_square("")
    let tr_sq  = _fs_build_square(key1)
    let bl_sq  = _fs_build_square(key2)
    // Build reverse-lookup for TR and BL (keyed squares)
    let tr_idx = _fs_build_index(tr_sq)
    let bl_idx = _fs_build_index(bl_sq)
    // Normalise ciphertext
    let norm = _fs_normalize(ct)
    // Pad to even length if necessary (shouldn't happen for valid ciphertexts)
    if len(norm) % 2 == 1
        norm = norm + "X"
    let n = len(norm)
    let out_parts = []
    let i = 0
    while i < n
        let c1 = slice(norm, i, i + 1)
        let c2 = slice(norm, i + 1, i + 2)
        // Locate c1 in TR: row r1, col c2_col
        let ti1 = tr_idx[c1]
        let r1 = ti1 / 5
        let c2_col = ti1 - r1 * 5
        // Locate c2 in BL: row r2, col c1_col
        let bi2 = bl_idx[c2]
        let r2 = bi2 / 5
        let c1_col = bi2 - r2 * 5
        // p1 = TL[r1][c1_col]  (standard square)
        let p1 = std_sq[r1 * 5 + c1_col]
        // p2 = BR[r2][c2_col]  (standard square)
        let p2 = std_sq[r2 * 5 + c2_col]
        push(out_parts, p1 + p2)
        i = i + 2
    let out = join(out_parts, "")
    out
