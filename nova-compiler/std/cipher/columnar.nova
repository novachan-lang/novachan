// std/cipher/columnar -- Columnar transposition cipher. LEAF -- imports NOTHING.
//
// Plaintext is written row-by-row under a keyword. Columns are numbered by the
// alphabetical rank (0-based) of each keyword letter. Ciphertext is produced by
// reading columns in rank order (lowest-ranked letter first). The final row is
// padded with 'X' if the plaintext does not fill the rectangle exactly.
//
// I/J: Both are treated as distinct letters (no merging). Only A-Z are used.
//
// Public API:
//   column_order(keyword)                 -> list  (rank of each column, 0-based)
//   columnar_encrypt(pt, keyword)         -> string
//   columnar_decrypt(ct, keyword)         -> string

// PRIVATE: normalize to uppercase A-Z only (drop all non-letters).
fn _col_normalize(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = upper(slice(s, i, i + 1))
        let o = ord(c)
        if o >= 65
            if o <= 90
                out = out + c
        i = i + 1
    out

// column_order(keyword) -> list of ranks (one per column position).
// column_order("ZEBRAS") = [5,2,1,3,0,4]
//   Z->rank5, E->rank2, B->rank1, R->rank3, A->rank0, S->rank4
//
// Algorithm: for each position i, count how many OTHER keyword letters are
// strictly less than keyword[i]; ties (duplicate letters) are broken by
// position (earlier occurrence gets the lower rank).
fn column_order(keyword: string) -> list
    let kw = upper(keyword)
    let ncols = len(kw)
    let ranks = []
    let i = 0
    while i < ncols
        // rank of column i = number of positions j where kw[j] < kw[i],
        // plus number of positions j < i where kw[j] == kw[i].
        let ci = ord(slice(kw, i, i + 1))
        let rank = 0
        let j = 0
        while j < ncols
            let cj = ord(slice(kw, j, j + 1))
            if cj < ci
                rank = rank + 1
            else
                if cj == ci
                    if j < i
                        rank = rank + 1
            j = j + 1
        push(ranks, rank)
        i = i + 1
    ranks

// columnar_encrypt(pt, keyword) -> ciphertext string.
// Input plaintext is normalized (uppercase, letters only). Grid is padded
// with 'X' to fill the rectangle. Columns are read in rank order.
fn columnar_encrypt(pt: string, keyword: string) -> string
    let norm = _col_normalize(pt)
    let ncols = len(upper(keyword))
    if ncols == 0
        return norm
    let plen = len(norm)
    // pad to full rectangle
    let nrows = (plen + ncols - 1) / ncols
    let total = nrows * ncols
    let padded = norm
    let pi = plen
    while pi < total
        padded = padded + "X"
        pi = pi + 1
    // build grid: grid[row][col] = char (stored flat as list of strings)
    let grid = []
    let r = 0
    while r < nrows
        let c = 0
        while c < ncols
            push(grid, slice(padded, r * ncols + c, r * ncols + c + 1))
            c = c + 1
        r = r + 1
    // compute read order: for each rank 0..ncols-1, find the column index
    let orders = column_order(keyword)
    // invert: read_col[rank] = column_index
    let read_col = []
    let tmp = 0
    while tmp < ncols
        push(read_col, 0)
        tmp = tmp + 1
    let ci = 0
    while ci < ncols
        let rk = orders[ci]
        read_col[rk] = ci
        ci = ci + 1
    // read columns in rank order 0..ncols-1
    let out = ""
    let rk = 0
    while rk < ncols
        let col = read_col[rk]
        let row = 0
        while row < nrows
            out = out + grid[row * ncols + col]
            row = row + 1
        rk = rk + 1
    out

// columnar_decrypt(ct, keyword) -> plaintext string.
// ciphertext is normalized. Reverses encrypt: places columns back in their
// original column positions, then reads row by row.
fn columnar_decrypt(ct: string, keyword: string) -> string
    let norm = _col_normalize(ct)
    let ncols = len(upper(keyword))
    if ncols == 0
        return norm
    let clen = len(norm)
    if clen == 0
        return ""
    // determine grid dimensions
    let nrows = (clen + ncols - 1) / ncols
    let extra = clen % ncols
    // extra = number of "long" columns (those that appear in the last partial row)
    // A column with rank r < extra gets nrows rows; rank r >= extra gets (nrows-1) rows
    // (when extra==0 all get nrows rows).
    // compute read_col[rank] = original column index (inverse of column_order)
    let orders = column_order(keyword)
    let read_col = []
    let tmp = 0
    while tmp < ncols
        push(read_col, 0)
        tmp = tmp + 1
    let ci = 0
    while ci < ncols
        let rk = orders[ci]
        read_col[rk] = ci
        ci = ci + 1
    // allocate flat grid (nrows * ncols) filled with empty string
    let grid = []
    let gi = 0
    while gi < nrows * ncols
        push(grid, "")
        gi = gi + 1
    // fill columns from ciphertext (rank order 0..ncols-1)
    let pos = 0
    let rk = 0
    while rk < ncols
        let col = read_col[rk]
        // length of this column
        let col_len = nrows
        if extra > 0
            if rk >= extra
                col_len = nrows - 1
        let row = 0
        while row < col_len
            grid[row * ncols + col] = slice(norm, pos, pos + 1)
            pos = pos + 1
            row = row + 1
        rk = rk + 1
    // read grid row by row
    let out = ""
    let r = 0
    while r < nrows
        let c = 0
        while c < ncols
            out = out + grid[r * ncols + c]
            c = c + 1
        r = r + 1
    out
