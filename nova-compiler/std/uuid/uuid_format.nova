// std/uuid/uuid_format.nova — Format a 16-byte list to UUID string forms (RFC 4122).
//
// Accepts a list of exactly 16 ints (0..255) and emits various UUID string
// representations. The canonical form is 8-4-4-4-12 lowercase hex with hyphens.
//
// SELF-CONTAINED — imports NOTHING.
// All private helpers are prefixed _ufo_ to avoid symbol collisions.
//
// PUBLIC API:
//   ufo_canonical(bytes16: list) -> str   lowercase 8-4-4-4-12, e.g. '550e8400-...'
//   ufo_hex32(bytes16: list) -> str       32 lowercase hex chars, no hyphens
//   ufo_urn(bytes16: list) -> str         'urn:uuid:' + canonical
//   ufo_upper(bytes16: list) -> str       uppercase canonical, e.g. '550E8400-...'
//   ufo_braces(bytes16: list) -> str      '{' + canonical + '}'
//
// DESIGN: empty list or list not of length 16 returns '' (safe failure).
// ARITHMETIC NOTE: >> is arithmetic in NOVA; mask with & 0x0F for nibble extracts.

// ── Private: hex alphabet ────────────────────────────────────────────────────

// Lowercase hex alphabet for byte->char mapping.
fn _ufo_hex_alpha_lo() -> str
    "0123456789abcdef"

// Uppercase hex alphabet for byte->char mapping.
fn _ufo_hex_alpha_up() -> str
    "0123456789ABCDEF"

// ── Private: byte -> two hex characters ──────────────────────────────────────

// Convert one byte (0..255) to its two lowercase hex characters.
fn _ufo_byte_lo(b: int) -> str
    let alpha = _ufo_hex_alpha_lo()
    let hi = (b >> 4) & 0x0F
    let lo = b & 0x0F
    alpha[hi] + alpha[lo]

// Convert one byte (0..255) to its two uppercase hex characters.
fn _ufo_byte_up(b: int) -> str
    let alpha = _ufo_hex_alpha_up()
    let hi = (b >> 4) & 0x0F
    let lo = b & 0x0F
    alpha[hi] + alpha[lo]

// ── Private: guard ────────────────────────────────────────────────────────────

// Return true iff bytes16 is a list of exactly 16 elements.
fn _ufo_valid(bytes16: list) -> bool
    len(bytes16) == 16

// ── Private: build 32-char hex strings ───────────────────────────────────────

// Build a 32-character lowercase hex string from bytes16 (no hyphens).
fn _ufo_to_hex32_lo(bytes16: list) -> str
    let out = ""
    for i in 0..16
        out = out + _ufo_byte_lo(bytes16[i])
    out

// Build a 32-character uppercase hex string from bytes16 (no hyphens).
fn _ufo_to_hex32_up(bytes16: list) -> str
    let out_parts = []
    for i in 0..16
        push(out_parts, _ufo_byte_up(bytes16[i]))
    let out = join(out_parts, "")
    out

// ── Private: insert hyphens into a 32-char hex string to form 36-char UUID ───

// Convert a 32-char hex string to 8-4-4-4-12 form by inserting hyphens.
fn _ufo_insert_hyphens(h32: str) -> str
    let part1 = slice(h32, 0, 8)
    let part2 = slice(h32, 8, 12)
    let part3 = slice(h32, 12, 16)
    let part4 = slice(h32, 16, 20)
    let part5 = slice(h32, 20, 32)
    part1 + "-" + part2 + "-" + part3 + "-" + part4 + "-" + part5

// ── Public API ────────────────────────────────────────────────────────────────

// ufo_canonical: format bytes16 as lowercase 8-4-4-4-12 UUID string.
// Returns '' if bytes16 does not have exactly 16 elements.
fn ufo_canonical(bytes16: list) -> str
    if not _ufo_valid(bytes16)
        return ""
    _ufo_insert_hyphens(_ufo_to_hex32_lo(bytes16))

// ufo_hex32: format bytes16 as 32 lowercase hex chars with no hyphens.
// Returns '' if bytes16 does not have exactly 16 elements.
fn ufo_hex32(bytes16: list) -> str
    if not _ufo_valid(bytes16)
        return ""
    _ufo_to_hex32_lo(bytes16)

// ufo_urn: format bytes16 as 'urn:uuid:' + canonical form.
// Returns '' if bytes16 does not have exactly 16 elements.
fn ufo_urn(bytes16: list) -> str
    if not _ufo_valid(bytes16)
        return ""
    "urn:uuid:" + _ufo_insert_hyphens(_ufo_to_hex32_lo(bytes16))

// ufo_upper: format bytes16 as uppercase 8-4-4-4-12 UUID string.
// Returns '' if bytes16 does not have exactly 16 elements.
fn ufo_upper(bytes16: list) -> str
    if not _ufo_valid(bytes16)
        return ""
    _ufo_insert_hyphens(_ufo_to_hex32_up(bytes16))

// ufo_braces: format bytes16 as '{' + canonical + '}'.
// Returns '' if bytes16 does not have exactly 16 elements.
// Uses chr(123)='{' and chr(125)='}' to avoid NOVA string interpolation.
fn ufo_braces(bytes16: list) -> str
    if not _ufo_valid(bytes16)
        return ""
    chr(123) + _ufo_insert_hyphens(_ufo_to_hex32_lo(bytes16)) + chr(125)
