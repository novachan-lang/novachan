// ============================================================================
// NOVA Standard Library — std/uuid/uuid_namespace
// ============================================================================
// RFC 4122 §4.3 / RFC 9562 §5.3-5.5: name-based UUID preparation helpers.
//
// Name-based UUIDs (v3 using MD5, v5 using SHA-1) are produced by:
//   1. Concatenate the 16-byte namespace UUID with the name bytes -> a buffer.
//   2. Hash the buffer (MD5 for v3, SHA-1 for v5).
//   3. Take the first 16 bytes of the digest.
//   4. Force the version nibble and RFC 4122 variant.
//   5. Format the 16 bytes as a canonical UUID string.
//
// This module handles steps 1, 4, and 5.  The caller supplies the hash
// (step 2-3), which this module has no dependency on (keeping it self-contained
// and hash-algorithm-agnostic).
//
// WELL-KNOWN NAMESPACE UUIDs (RFC 4122 Appendix C):
//   DNS  = 6ba7b810-9dad-11d1-80b4-00c04fd430c8
//   URL  = 6ba7b811-9dad-11d1-80b4-00c04fd430c8
//   OID  = 6ba7b812-9dad-11d1-80b4-00c04fd430c8
//   X500 = 6ba7b814-9dad-11d1-80b4-00c04fd430c8
//
// PUBLIC API:
//   uns_build_buffer(namespace_uuid_str, name) -> list[int]
//       Returns a list of bytes: 16 namespace bytes followed by the ASCII
//       bytes of `name`. This is the buffer to hash for v3/v5.
//       Returns [] on malformed namespace_uuid_str.
//
//   uns_finalize(digest_bytes16, version) -> str
//       Force the version nibble (byte 6 high nibble = version) and
//       RFC 4122 variant (byte 8 high two bits = 10), then format canonical.
//       version should be 3 or 5 for standard name-based UUIDs.
//       digest_bytes16 must be a list of at least 16 ints 0-255.
//
//   uns_dns()  -> str   The DNS  namespace UUID string.
//   uns_url()  -> str   The URL  namespace UUID string.
//   uns_oid()  -> str   The OID  namespace UUID string.
//   uns_x500() -> str   The X500 namespace UUID string.
//
// SELF-CONTAINED: no imports; all helpers prefixed _uns_.

// ── Hex helpers ──────────────────────────────────────────────────────────────

// Lowercase hex alphabet indexed by nibble value 0-15.
fn _uns_alpha() -> str
    "0123456789abcdef"

// Nibble value 0-15 -> single lowercase hex character.
fn _uns_nibble(v) -> str
    let a = _uns_alpha()
    a[v]

// Byte 0-255 -> two lowercase hex characters, high nibble first.
fn _uns_b2h(b) -> str
    let hi = b / 16
    let lo = b - hi * 16
    _uns_nibble(hi) + _uns_nibble(lo)

// Hex character (upper or lower) -> nibble value 0-15, or -1 if invalid.
fn _uns_hval(c) -> int
    let i = 0
    let a = _uns_alpha()
    while i < 16
        if a[i] == c
            return i
        i += 1
    if c == "A"
        return 10
    if c == "B"
        return 11
    if c == "C"
        return 12
    if c == "D"
        return 13
    if c == "E"
        return 14
    if c == "F"
        return 15
    -1

// ── UUID parser ───────────────────────────────────────────────────────────────

// Parse a canonical UUID string (36 chars, 8-4-4-4-12) into a list of 16 bytes.
// Returns [] on any parse error (wrong length, non-hex chars, missing dashes).
fn _uns_parse(uuid_str) -> list
    if len(uuid_str) != 36
        return []
    // Verify dashes at expected positions.
    if uuid_str[8] != "-" or uuid_str[13] != "-" or uuid_str[18] != "-" or uuid_str[23] != "-"
        return []
    // Extract hex runs: 8 chars, 4, 4, 4, 12 (at offsets 0, 9, 14, 19, 24).
    let hex_parts = []
    for i in 0..36
        if i != 8 and i != 13 and i != 18 and i != 23
            push(hex_parts, uuid_str[i])
    let hex = join(hex_parts, "")
    // hex must now be exactly 32 hex chars.
    if len(hex) != 32
        return []
    let bytes = []
    let j = 0
    while j < 32
        let hi = _uns_hval(hex[j])
        let lo = _uns_hval(hex[j + 1])
        if hi < 0 or lo < 0
            return []
        push(bytes, hi * 16 + lo)
        j += 2
    bytes

// ── uns_build_buffer ──────────────────────────────────────────────────────────

// Build the pre-hash buffer for a name-based UUID: 16 namespace bytes followed
// by the ASCII bytes of `name`. Returns [] if namespace_uuid_str is malformed.
fn uns_build_buffer(namespace_uuid_str, name) -> list
    let ns_bytes = _uns_parse(namespace_uuid_str)
    if len(ns_bytes) != 16
        return []
    // Append ASCII bytes of name.
    let buf = ns_bytes
    let i = 0
    let nlen = len(name)
    while i < nlen
        push(buf, ord(name[i]))
        i += 1
    buf

// ── uns_finalize ──────────────────────────────────────────────────────────────

// Stamp version and variant bits onto the first 16 bytes of digest_bytes16,
// then format as a canonical UUID string.
// byte 6 high nibble = version (e.g. 3 or 5).
// byte 8 high two bits = 10 (RFC 4122 variant).
fn uns_finalize(digest_bytes16, version) -> str
    let n = len(digest_bytes16)
    let b0  = 0
    let b1  = 0
    let b2  = 0
    let b3  = 0
    let b4  = 0
    let b5  = 0
    let b6  = 0
    let b7  = 0
    let b8  = 0
    let b9  = 0
    let b10 = 0
    let b11 = 0
    let b12 = 0
    let b13 = 0
    let b14 = 0
    let b15 = 0
    if n > 0
        b0 = digest_bytes16[0]
    if n > 1
        b1 = digest_bytes16[1]
    if n > 2
        b2 = digest_bytes16[2]
    if n > 3
        b3 = digest_bytes16[3]
    if n > 4
        b4 = digest_bytes16[4]
    if n > 5
        b5 = digest_bytes16[5]
    if n > 6
        b6 = digest_bytes16[6]
    if n > 7
        b7 = digest_bytes16[7]
    if n > 8
        b8 = digest_bytes16[8]
    if n > 9
        b9 = digest_bytes16[9]
    if n > 10
        b10 = digest_bytes16[10]
    if n > 11
        b11 = digest_bytes16[11]
    if n > 12
        b12 = digest_bytes16[12]
    if n > 13
        b13 = digest_bytes16[13]
    if n > 14
        b14 = digest_bytes16[14]
    if n > 15
        b15 = digest_bytes16[15]
    // Force version nibble: byte 6 high nibble = version value.
    b6 = (b6 & 15) | (version * 16)
    // Force variant: byte 8 high two bits = 10.
    b8 = (b8 & 63) | 128
    // Format 8-4-4-4-12.
    let out = _uns_b2h(b0) + _uns_b2h(b1) + _uns_b2h(b2) + _uns_b2h(b3)
    out += "-"
    out += _uns_b2h(b4) + _uns_b2h(b5)
    out += "-"
    out += _uns_b2h(b6) + _uns_b2h(b7)
    out += "-"
    out += _uns_b2h(b8) + _uns_b2h(b9)
    out += "-"
    out += _uns_b2h(b10) + _uns_b2h(b11) + _uns_b2h(b12) + _uns_b2h(b13) + _uns_b2h(b14) + _uns_b2h(b15)
    out

// ── Standard namespace UUID strings (RFC 4122 Appendix C) ─────────────────────

// Return the well-known DNS namespace UUID string.
fn uns_dns() -> str
    "6ba7b810-9dad-11d1-80b4-00c04fd430c8"

// Return the well-known URL namespace UUID string.
fn uns_url() -> str
    "6ba7b811-9dad-11d1-80b4-00c04fd430c8"

// Return the well-known OID namespace UUID string.
fn uns_oid() -> str
    "6ba7b812-9dad-11d1-80b4-00c04fd430c8"

// Return the well-known X.500 DN namespace UUID string.
fn uns_x500() -> str
    "6ba7b814-9dad-11d1-80b4-00c04fd430c8"
