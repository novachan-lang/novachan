// std/uuid/uuid_parse.nova — Parse UUID strings to byte lists (RFC 4122 / RFC 9562).
//
// A UUID canonical string is exactly 36 characters: 8-4-4-4-12 lowercase-or-
// uppercase hex digits separated by hyphens at positions 8, 13, 18, 23.
// The byte list representation is 16 ints in 0..255 (big-endian field order).
//
// SELF-CONTAINED — imports NOTHING.
// All private helpers are prefixed _upa_ to avoid symbol collisions.
//
// PUBLIC API:
//   upa_parse(s: str) -> list         16-element int list, or [] on malformed input
//   upa_is_valid(s: str) -> bool      true iff s is exact canonical 8-4-4-4-12 form
//   upa_normalize(s: str) -> str      strip {} / urn:uuid: prefix, lowercase; '' on invalid
//
// DESIGN NOTES:
//   upa_is_valid accepts both lowercase and uppercase hex (per RFC 4122 §3 ABNF).
//   upa_normalize additionally strips the optional URN form and brace form.
//   upa_parse delegates to upa_is_valid first, then converts hex pairs to ints.
//
// ARITHMETIC NOTE:
//   >> is arithmetic (sign-extending) in NOVA; we mask with & 0x0F to guard nibbles.
//   Parenthesise all bitwise ops vs comparison operators.

// ── Private: hex alphabet and converters ─────────────────────────────────────

// nibble->char lookup table (lowercase).
fn _upa_hex_alpha() -> str
    "0123456789abcdef"

// Map one hex character (0-9 a-f A-F) to its nibble value 0..15.
// Returns -1 on invalid input.
fn _upa_hex_val(c: str) -> int
    let b = ord(c)
    if b >= 48 and b <= 57
        return b - 48
    if b >= 97 and b <= 102
        return b - 97 + 10
    if b >= 65 and b <= 70
        return b - 65 + 10
    -1

// Convert a lowercase hex character to its lowercase form (no-op for already-lower).
// For uppercase A-F: shift to lowercase a-f. Other chars returned as-is.
fn _upa_to_lower(c: str) -> str
    let b = ord(c)
    if b >= 65 and b <= 90
        return chr(b + 32)
    c

// ── Private: core parse of 32 hex chars (no hyphens) to 16-byte list ─────────

// Given a string of exactly 32 hex characters (no hyphens), return list of 16 bytes.
// Assumes caller already verified all chars are valid hex.
fn _upa_hex32_to_bytes(h: str) -> list
    let result = []
    let i = 0
    while i < 32
        let hi = _upa_hex_val(h[i])
        let lo = _upa_hex_val(h[i + 1])
        push(result, (hi * 16 + lo) & 0xFF)
        i = i + 2
    result

// ── Private: extract the 32 raw hex chars from a canonical 36-char UUID ──────

// Given a validated 36-char UUID string, strip the 4 hyphens and return 32 hex chars.
fn _upa_strip_hyphens(s: str) -> str
    // positions 8, 13, 18, 23 are hyphens; rest are hex
    let out = slice(s, 0, 8)
    out = out + slice(s, 9, 13)
    out = out + slice(s, 14, 18)
    out = out + slice(s, 19, 23)
    out = out + slice(s, 24, 36)
    out

// ── Private: check all characters in a segment are valid hex ──────────────────

// Returns true if every character in s[start..end) is a valid hex digit.
fn _upa_seg_ok(s: str, start: int, end: int) -> bool
    let i = start
    while i < end
        if _upa_hex_val(s[i]) == -1
            return false
        i = i + 1
    true

// ── Public API ────────────────────────────────────────────────────────────────

// upa_is_valid: true iff s is an exact canonical 8-4-4-4-12 UUID string.
// Accepts both lowercase and uppercase hex digits. Hyphens must be at positions
// 8, 13, 18, 23. Length must be exactly 36. No surrounding braces or URN prefix.
fn upa_is_valid(s: str) -> bool
    if len(s) != 36
        return false
    if s[8] != "-"
        return false
    if s[13] != "-"
        return false
    if s[18] != "-"
        return false
    if s[23] != "-"
        return false
    if not _upa_seg_ok(s, 0, 8)
        return false
    if not _upa_seg_ok(s, 9, 13)
        return false
    if not _upa_seg_ok(s, 14, 18)
        return false
    if not _upa_seg_ok(s, 19, 23)
        return false
    if not _upa_seg_ok(s, 24, 36)
        return false
    true

// upa_parse: parse a UUID string to a list of 16 bytes (ints 0..255).
// Accepts canonical 8-4-4-4-12 form (upper or lowercase).
// Returns [] on any malformed input.
fn upa_parse(s: str) -> list
    if not upa_is_valid(s)
        return []
    let h32 = _upa_strip_hyphens(s)
    _upa_hex32_to_bytes(h32)

// upa_normalize: canonicalize a UUID string to lowercase 8-4-4-4-12 form.
// Strips a surrounding '{' ... '}' wrapper or a leading 'urn:uuid:' prefix.
// Returns '' if the result is not a valid UUID after stripping.
fn upa_normalize(s: str) -> str
    let n = len(s)
    let working = s
    // strip urn:uuid: prefix (9 characters)
    if n >= 9 and slice(s, 0, 9) == "urn:uuid:"
        working = slice(s, 9, n)
    // strip surrounding braces {} — use chr(123)='{' chr(125)='}' to avoid interpolation
    let wn = len(working)
    if wn >= 2 and working[0] == chr(123) and working[wn - 1] == chr(125)
        working = slice(working, 1, wn - 1)
    // now working should be a 36-char canonical UUID
    if not upa_is_valid(working)
        return ""
    // lowercase all hex digits, keep hyphens
    let out = ""
    let i = 0
    while i < 36
        out = out + _upa_to_lower(working[i])
        i = i + 1
    out
