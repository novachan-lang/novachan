// ============================================================================
// NOVA Standard Library — std/uuid/uuid_v8
// ============================================================================
// RFC 9562 §5.8 UUID version 8: custom / vendor-specific UUID.
//
// UUIDv8 is a deliberately open format: the 122 non-fixed bits are entirely
// application-defined. The only constraints the RFC imposes are:
//   - byte 6 high nibble (version bits 48-51) = 0x8
//   - byte 8 high two bits (variant bits 64-65) = 10  (RFC 4122 variant)
//
// This module handles the structural stamping (forcing version/variant) and
// canonical formatting, leaving the semantics of the other 122 bits to the
// caller.
//
// DETERMINISTIC: no RNG calls; all entropy comes from the bytes16 argument.
//
// PUBLIC API:
//   u8_from_bytes(bytes16) -> str   Force v8 version/variant, format canonical.
//   u8_is_v8(uuid_str)     -> bool  True iff uuid_str is a valid v8 UUID.
//
// SELF-CONTAINED: no imports; all helpers prefixed _u8_.

// ── Hex helpers ──────────────────────────────────────────────────────────────

// Lowercase hex alphabet indexed by nibble value 0-15.
fn _u8_alpha() -> str
    "0123456789abcdef"

// Nibble value 0-15 -> single lowercase hex character.
fn _u8_nibble(v) -> str
    let a = _u8_alpha()
    a[v]

// Byte 0-255 -> two lowercase hex characters, high nibble first.
fn _u8_b2h(b) -> str
    let hi = b / 16
    let lo = b - hi * 16
    _u8_nibble(hi) + _u8_nibble(lo)

// Hex character (upper or lower) -> nibble value 0-15, or -1 if invalid.
fn _u8_hval(c) -> int
    let i = 0
    let a = _u8_alpha()
    while i < 16
        if a[i] == c
            return i
        i = i + 1
    if c == "A"
        return 10
    if c == "B"
        return 11
    if c == "C"
        return 12
    if c == "D"
        return 13
    if c == "E"
        return 14
    if c == "F"
        return 15
    -1

// ── u8_from_bytes ─────────────────────────────────────────────────────────────

// Force the UUIDv8 version nibble and RFC 4122 variant onto bytes16, then
// return the canonical 8-4-4-4-12 lowercase hex string.
// bytes16 must be a list of at least 16 ints 0-255; any extra elements are ignored.
// If bytes16 is shorter than 16, missing bytes default to 0.
fn u8_from_bytes(bytes16) -> str
    // Safe-read helper (inline to keep module self-contained).
    let n = len(bytes16)
    let b0  = 0
    let b1  = 0
    let b2  = 0
    let b3  = 0
    let b4  = 0
    let b5  = 0
    let b6  = 0
    let b7  = 0
    let b8  = 0
    let b9  = 0
    let b10 = 0
    let b11 = 0
    let b12 = 0
    let b13 = 0
    let b14 = 0
    let b15 = 0
    if n > 0
        b0 = bytes16[0]
    if n > 1
        b1 = bytes16[1]
    if n > 2
        b2 = bytes16[2]
    if n > 3
        b3 = bytes16[3]
    if n > 4
        b4 = bytes16[4]
    if n > 5
        b5 = bytes16[5]
    if n > 6
        b6 = bytes16[6]
    if n > 7
        b7 = bytes16[7]
    if n > 8
        b8 = bytes16[8]
    if n > 9
        b9 = bytes16[9]
    if n > 10
        b10 = bytes16[10]
    if n > 11
        b11 = bytes16[11]
    if n > 12
        b12 = bytes16[12]
    if n > 13
        b13 = bytes16[13]
    if n > 14
        b14 = bytes16[14]
    if n > 15
        b15 = bytes16[15]
    // Force version: byte 6 high nibble = 8 (0x80).
    b6 = (b6 & 15) | 128
    // Force variant: byte 8 high two bits = 10 (0x80).
    b8 = (b8 & 63) | 128
    // Format as 8-4-4-4-12.
    let out = _u8_b2h(b0) + _u8_b2h(b1) + _u8_b2h(b2) + _u8_b2h(b3)
    out = out + "-"
    out = out + _u8_b2h(b4) + _u8_b2h(b5)
    out = out + "-"
    out = out + _u8_b2h(b6) + _u8_b2h(b7)
    out = out + "-"
    out = out + _u8_b2h(b8) + _u8_b2h(b9)
    out = out + "-"
    out = out + _u8_b2h(b10) + _u8_b2h(b11) + _u8_b2h(b12) + _u8_b2h(b13) + _u8_b2h(b14) + _u8_b2h(b15)
    out

// ── u8_is_v8 ──────────────────────────────────────────────────────────────────

// Return true iff uuid_str is a well-formed RFC 9562 version-8 UUID.
// Checks: length 36, dashes at 8/13/18/23, all LOWERCASE hex digits elsewhere,
// version nibble at index 14 is '8', variant nibble at index 19 in {8,9,a,b}.
// Uppercase hex is rejected — canonical form per RFC 4122 is lowercase.
fn _u8_is_lower_hex(c) -> bool
    let a = _u8_alpha()
    let i = 0
    while i < 16
        if a[i] == c
            return true
        i = i + 1
    false

fn u8_is_v8(uuid_str) -> bool
    if len(uuid_str) != 36
        return false
    let i = 0
    while i < 36
        let c = uuid_str[i]
        if i == 8 or i == 13 or i == 18 or i == 23
            if c != "-"
                return false
        else
            if not _u8_is_lower_hex(c)
                return false
        i = i + 1
    // Version nibble at index 14 must be '8'.
    if uuid_str[14] != "8"
        return false
    // Variant nibble at index 19 must be 8, 9, a, or b.
    let vn = uuid_str[19]
    if vn != "8" and vn != "9" and vn != "a" and vn != "b"
        return false
    true
