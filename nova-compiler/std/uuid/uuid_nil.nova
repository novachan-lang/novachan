// ============================================================================
// NOVA Standard Library — std/uuid/uuid_nil
// ============================================================================
// RFC 4122 / RFC 9562 nil and max UUIDs with validation predicates.
//
// The nil UUID (all bits zero) and max UUID (all bits one) are special-case
// sentinels defined by the spec. Neither has a version or variant field in the
// conventional sense — they are used as null values and high-bound sentinels.
//
// PUBLIC API:
//   uni_nil()         -> string   "00000000-0000-0000-0000-000000000000"
//   uni_max()         -> string   "ffffffff-ffff-ffff-ffff-ffffffffffff"
//   uni_is_nil(s)     -> bool     true iff s is exactly the nil UUID string
//   uni_is_max(s)     -> bool     true iff s is exactly the max UUID string
//
// SELF-CONTAINED: imports nothing.

// uni_nil: return the RFC 4122 nil UUID string (all 32 hex digits zero).
fn uni_nil() -> string
    "00000000-0000-0000-0000-000000000000"

// uni_max: return the RFC 9562 max UUID string (all 32 hex digits 'f').
fn uni_max() -> string
    "ffffffff-ffff-ffff-ffff-ffffffffffff"

// uni_is_nil: return true iff uuid_str equals the nil UUID (case-sensitive).
fn uni_is_nil(uuid_str) -> bool
    uuid_str == "00000000-0000-0000-0000-000000000000"

// uni_is_max: return true iff uuid_str equals the max UUID (case-sensitive).
fn uni_is_max(uuid_str) -> bool
    uuid_str == "ffffffff-ffff-ffff-ffff-ffffffffffff"
