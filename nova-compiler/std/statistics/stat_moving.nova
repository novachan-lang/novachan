// std/statistics/stat_moving.nova — moving/rolling and cumulative averages.
// All window-based functions return a shorter list (output len = input len - w + 1).
// Empty list or invalid window: return [].
// alpha for EMA is given as a rational number: alpha = alpha_num / alpha_den.
// LEAF — imports NOTHING.

// smv_sma — simple moving average with window w.
// Each output element is the arithmetic mean of w consecutive input elements.
// Output length = len(xs) - w + 1. Returns [] when w < 1 or w > len(xs).
fn smv_sma(xs: list, w: int) -> list
    let n = len(xs)
    if n == 0
        return []
    if w < 1
        return []
    if w > n
        return []
    let out = []
    let i = 0
    while i <= n - w
        let acc = 0.0
        let j = 0
        while j < w
            acc = acc + xs[i + j] * 1.0
            j = j + 1
        let avg = acc / (w * 1.0)
        push(out, avg)
        i = i + 1
    out

// smv_cumulative — running cumulative sum.
// Output[i] = sum of xs[0..i]. Output length equals input length.
// Returns [] on empty list.
fn smv_cumulative(xs: list) -> list
    let n = len(xs)
    if n == 0
        return []
    let out = []
    let running = 0
    let i = 0
    while i < n
        running = running + xs[i]
        push(out, running)
        i = i + 1
    out

// smv_wma — linearly weighted moving average with window w.
// Weights are 1, 2, ..., w (oldest gets weight 1, newest gets weight w).
// sum(x[k] * weight[k]) / sum(weights) where sum(weights) = w*(w+1)/2.
// Output length = len(xs) - w + 1. Returns [] when w < 1 or w > len(xs).
fn smv_wma(xs: list, w: int) -> list
    let n = len(xs)
    if n == 0
        return []
    if w < 1
        return []
    if w > n
        return []
    let wsum = w * (w + 1) / 2
    let wsum_f = wsum * 1.0
    let out = []
    let i = 0
    while i <= n - w
        let acc = 0.0
        let j = 0
        while j < w
            let wt = (j + 1) * 1.0
            acc = acc + xs[i + j] * 1.0 * wt
            j = j + 1
        let avg = acc / wsum_f
        push(out, avg)
        i = i + 1
    out

// smv_ema — exponential moving average with smoothing factor alpha = alpha_num / alpha_den.
// Seeds with the first element; each subsequent value: ema = alpha*x + (1-alpha)*ema.
// Output length equals input length. Returns [] on empty list or alpha_den == 0.
fn smv_ema(xs: list, alpha_num: int, alpha_den: int) -> list
    let n = len(xs)
    if n == 0
        return []
    if alpha_den == 0
        return []
    let alpha = alpha_num * 1.0 / (alpha_den * 1.0)
    let one_minus = 1.0 - alpha
    let out = []
    let ema = xs[0] * 1.0
    push(out, ema)
    let i = 1
    while i < n
        let x = xs[i] * 1.0
        let new_ema = alpha * x + one_minus * ema
        ema = new_ema
        push(out, ema)
        i = i + 1
    out
