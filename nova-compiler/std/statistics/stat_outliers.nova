// std/statistics/stat_outliers.nova — outlier detection via Tukey fences and z-scores.
// Quartiles use the EXCLUSIVE method: median of lower/upper half excluding the middle
// element when n is odd.  sou_tukey_fences returns [lower_fence, upper_fence].
// LEAF — imports NOTHING.

// Private: convert a non-negative float to integer (floor toward 0).
fn _sou_ftoi(fval: float) -> int
    let k = 0
    let acc = 0.0
    while acc + 1.0 <= fval
        acc = acc + 1.0
        k = k + 1
    k

// Private: return a new float list sorted ascending (insertion sort, stable).
fn _sou_sorted(xs: list) -> list
    let out = []
    for i in 0..len(xs)
        let v = xs[i] * 1.0
        push(out, v)
        let j = len(out) - 1
        while j > 0 and out[j - 1] > v
            out[j] = out[j - 1]
            j = j - 1
        out[j] = v
    out

// Private: median of a SORTED sub-list from index lo to hi (inclusive).
fn _sou_median_range(s: list, lo: int, hi: int) -> float
    let cnt = hi - lo + 1
    if cnt <= 0
        return 0.0
    let mid = lo + cnt / 2
    if cnt % 2 == 1
        return s[mid] * 1.0
    let a = s[mid - 1] * 1.0
    let b = s[mid] * 1.0
    let r = (a + b) / 2.0
    r

// Private: population mean over a float list.
fn _sou_mean(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = 0.0
    for i in 0..n
        s = s + xs[i] * 1.0
    s / (n * 1.0)

// Private: population standard deviation.
fn _sou_stddev(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let mu = _sou_mean(xs)
    let acc = 0.0
    for i in 0..n
        let d = xs[i] * 1.0 - mu
        acc = acc + d * d
    let v = acc / (n * 1.0)
    let sd = sqrt(v)
    sd

// sou_tukey_fences — [Q1 - 1.5*IQR, Q3 + 1.5*IQR] using exclusive-quartile method.
// Returns [0.0, 0.0] on empty list or single element.
fn sou_tukey_fences(xs: list) -> list
    let n = len(xs)
    if n <= 1
        let r = []
        push(r, 0.0)
        push(r, 0.0)
        return r
    let s = _sou_sorted(xs)
    let lo_hi = 0
    let hi_lo = 0
    if n % 2 == 0
        lo_hi = n / 2 - 1
        hi_lo = n / 2
    else
        lo_hi = n / 2 - 1
        hi_lo = n / 2 + 1
    let q1 = _sou_median_range(s, 0, lo_hi)
    let q3 = _sou_median_range(s, hi_lo, n - 1)
    let iqr = q3 - q1
    let iqr15 = iqr * 1.5
    let lower = q1 - iqr15
    let upper = q3 + iqr15
    let out = []
    push(out, lower)
    push(out, upper)
    out

// sou_iqr_outliers — values outside the Tukey fences, returned in ascending order.
// Returns [] on empty list.
fn sou_iqr_outliers(xs: list) -> list
    let n = len(xs)
    if n == 0
        return []
    let fences = sou_tukey_fences(xs)
    let lower = fences[0] * 1.0
    let upper = fences[1] * 1.0
    let s = _sou_sorted(xs)
    let out = []
    for i in 0..n
        let v = s[i] * 1.0
        if v < lower or v > upper
            push(out, v)
    out

// sou_zscore_outliers — values whose |z-score| >= thresh_num/thresh_den (with 0.001 tolerance).
// Uses population mean and population stddev.
// Returns values in ascending order. Returns [] on empty list or zero stddev.
fn sou_zscore_outliers(xs: list, thresh_num: int, thresh_den: int) -> list
    let n = len(xs)
    if n == 0
        return []
    let mu = _sou_mean(xs)
    let sd = _sou_stddev(xs)
    if sd <= 0.0
        return []
    let thresh = thresh_num * 1.0 / (thresh_den * 1.0)
    let lo_thresh = thresh - 0.001
    let s = _sou_sorted(xs)
    let out = []
    for i in 0..n
        let v = s[i] * 1.0
        let z = (v - mu) / sd
        let az = z
        if az < 0.0
            az = 0.0 - az
        if az >= lo_thresh
            push(out, v)
    out
