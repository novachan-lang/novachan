// std/statistics/stat_entropy.nova — entropy and impurity measures from a count/weight list.
// Input: list of non-negative int or float counts (zeros are ignored in sums).
// Shannon entropy is in BITS (base-2 logarithm).
// LEAF — imports NOTHING.

// Private: natural logarithm via the identity ln(x) = 2 * atanh((x-1)/(x+1)).
// atanh(t) = t + t^3/3 + t^5/5 + ... (converges for |t| < 1; all valid since x > 0).
// We use 40 terms for ~15 decimal digits of precision.
fn _sen_ln(x: float) -> float
    let t = (x - 1.0) / (x + 1.0)
    let t2 = t * t
    let term = t
    let acc = t
    let k = 1
    while k < 40
        term = term * t2
        let denom = (2 * k + 1) * 1.0
        acc = acc + term / denom
        k = k + 1
    let r = acc * 2.0
    r

// Private: log base 2 via change-of-base: log2(x) = ln(x) / ln(2).
fn _sen_log2(x: float) -> float
    let ln2 = _sen_ln(2.0)
    let lnx = _sen_ln(x)
    let r = lnx / ln2
    r

// Private: sum of counts as float.
fn _sen_total(counts: list) -> float
    let s = 0.0
    for i in 0..len(counts)
        s = s + counts[i] * 1.0
    s

// sen_shannon — Shannon entropy in bits: -sum(p * log2(p)) over non-zero probabilities.
// Returns 0.0 on empty list or total == 0.
fn sen_shannon(counts: list) -> float
    let n = len(counts)
    if n == 0
        return 0.0
    let total = _sen_total(counts)
    if total <= 0.0
        return 0.0
    let acc = 0.0
    for i in 0..n
        let c = counts[i] * 1.0
        if c > 0.0
            let p = c / total
            let lg = _sen_log2(p)
            acc = acc + p * lg
    let h = 0.0 - acc
    h

// sen_gini — Gini impurity: 1 - sum(p^2).
// Returns 0.0 on empty list or total == 0.
fn sen_gini(counts: list) -> float
    let n = len(counts)
    if n == 0
        return 0.0
    let total = _sen_total(counts)
    if total <= 0.0
        return 0.0
    let sumsq = 0.0
    for i in 0..n
        let c = counts[i] * 1.0
        let p = c / total
        sumsq = sumsq + p * p
    let g = 1.0 - sumsq
    g

// sen_normalized — Shannon entropy divided by log2(k) where k = number of classes.
// Returns value in [0, 1]. Returns 0.0 when there is only one class or entropy is 0.
fn sen_normalized(counts: list) -> float
    let k = len(counts)
    if k <= 1
        return 0.0
    let h = sen_shannon(counts)
    if h <= 0.0
        return 0.0
    let kf = k * 1.0
    let max_h = _sen_log2(kf)
    if max_h <= 0.0
        return 0.0
    let r = h / max_h
    r
