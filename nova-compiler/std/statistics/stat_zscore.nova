// std/statistics/stat_zscore.nova — z-score and normalization transforms.
// All functions accept int or float lists; results are float or list-of-float.
// Empty list: returns 0.0 or [] (never crash / divide-by-zero).
// Population stddev is used throughout (divide by n, not n-1).
// LEAF — imports NOTHING.

// Private: arithmetic mean as float; 0.0 on empty list.
fn _sz_mean(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let s = 0.0
    for i in 0..n
        s = s + xs[i] * 1.0
    s / (n * 1.0)

// Private: population variance (divide by n); 0.0 on empty list.
fn _sz_var(xs: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let mu = _sz_mean(xs)
    let acc = 0.0
    for i in 0..n
        let d = xs[i] * 1.0 - mu
        acc = acc + d * d
    acc / (n * 1.0)

// sz_zscore — z-score of a single value x: (x - mean) / stddev.
// Returns 0.0 when stddev == 0.0 (constant distribution).
fn sz_zscore(x: float, mean: float, stddev: float) -> float
    if stddev == 0.0
        return 0.0
    let z = (x - mean) / stddev
    z

// sz_standardize — return a new list where each element is its z-score
// computed using the POPULATION stddev of xs.
// Returns [] on empty list; returns list of 0.0 when stddev == 0.
fn sz_standardize(xs: list) -> list
    let n = len(xs)
    if n == 0
        return []
    let mu = _sz_mean(xs)
    let v = _sz_var(xs)
    let sd = sqrt(v)
    let out = []
    for i in 0..n
        let z = 0.0
        if sd > 0.0
            let d = xs[i] * 1.0 - mu
            z = d / sd
        push(out, z)
    out

// sz_minmax — rescale xs to [0, 1] via (x - min) / (max - min).
// When max == min (all equal), returns a list of 0.0 for every element.
// Returns [] on empty list.
fn sz_minmax(xs: list) -> list
    let n = len(xs)
    if n == 0
        return []
    let mn = xs[0] * 1.0
    let mx = xs[0] * 1.0
    for i in 1..n
        let v = xs[i] * 1.0
        if v < mn
            mn = v
        if v > mx
            mx = v
    let rng = mx - mn
    let out = []
    for j in 0..n
        let scaled = 0.0
        if rng > 0.0
            let v2 = xs[j] * 1.0
            scaled = (v2 - mn) / rng
        push(out, scaled)
    out
