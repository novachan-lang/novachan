// std/statistics/stat_rank.nova — rank-based statistics (Spearman correlation).
// sr_rankings produces 1-based average ranks (ties share the average of their positions).
// LEAF — imports NOTHING.

// Private: insertion-sort a list of indices by corresponding value in vals (ascending).
fn _sr_argsort(vals: list) -> list
    let n = len(vals)
    let idx = []
    let i = 0
    while i < n
        push(idx, i)
        i = i + 1
    let j = 1
    while j < n
        let key_idx = idx[j]
        let key_val = vals[key_idx] * 1.0
        let k = j - 1
        while k >= 0 and vals[idx[k]] * 1.0 > key_val
            idx[k + 1] = idx[k]
            k = k - 1
        idx[k + 1] = key_idx
        j = j + 1
    idx

// sr_rankings — return 1-based average ranks as a float list.
// Ties receive the arithmetic mean of the positions they would have occupied.
fn sr_rankings(xs: list) -> list
    let n = len(xs)
    let out = []
    let ii = 0
    while ii < n
        push(out, 0.0)
        ii = ii + 1
    if n == 0
        return out
    let sorted_idx = _sr_argsort(xs)
    let i = 0
    while i < n
        let j = i
        let cur_val = xs[sorted_idx[i]] * 1.0
        while j < n and xs[sorted_idx[j]] * 1.0 == cur_val
            j = j + 1
        let rank_sum = 0.0
        let k = i
        while k < j
            rank_sum = rank_sum + (k + 1) * 1.0
            k = k + 1
        let tie_count = (j - i) * 1.0
        let avg_rank = rank_sum / tie_count
        let m = i
        while m < j
            out[sorted_idx[m]] = avg_rank
            m = m + 1
        i = j
    out

// Private: compute Pearson correlation of two float lists (used by sr_spearman).
fn _sr_pearson_float(xs: list, ys: list) -> float
    let n = len(xs)
    if n == 0
        return 0.0
    let sx = 0.0
    let sy = 0.0
    let i = 0
    while i < n
        sx = sx + xs[i] * 1.0
        sy = sy + ys[i] * 1.0
        i = i + 1
    let fn_f = n * 1.0
    let mx = sx / fn_f
    let my = sy / fn_f
    let cov = 0.0
    let vx = 0.0
    let vy = 0.0
    let j = 0
    while j < n
        let dx = xs[j] * 1.0 - mx
        let dy = ys[j] * 1.0 - my
        cov = cov + dx * dy
        vx = vx + dx * dx
        vy = vy + dy * dy
        j = j + 1
    let cov_v = cov / fn_f
    let var_x = vx / fn_f
    let var_y = vy / fn_f
    if var_x < 0.000001 and var_x > -0.000001
        return 0.0
    if var_y < 0.000001 and var_y > -0.000001
        return 0.0
    let sdx = sqrt(var_x)
    let sdy = sqrt(var_y)
    let denom = sdx * sdy
    cov_v / denom

// sr_spearman — Spearman rank correlation = Pearson correlation of the rankings.
// Returns 0.0 for empty or constant-rank inputs.
fn sr_spearman(xs: list, ys: list) -> float
    let rx = sr_rankings(xs)
    let ry = sr_rankings(ys)
    _sr_pearson_float(rx, ry)
