// std/statistics/stat_histogram.nova — equal-width histogram over a numeric list.
// Bins span [min, max] with equal width; the LAST bin is inclusive of max.
// All functions return empty list / zero on empty input or num_bins < 1.
// LEAF — imports NOTHING.

// Private: convert a non-negative float to an integer (floor toward 0).
fn _shi_ftoi(fval: float) -> int
    let k = 0
    let acc = 0.0
    while acc + 1.0 <= fval
        acc = acc + 1.0
        k = k + 1
    k

// Private: compute min over the list as float.
fn _shi_min(xs: list) -> float
    let m = xs[0] * 1.0
    for i in 1..len(xs)
        let v = xs[i] * 1.0
        if v < m
            m = v
    m

// Private: compute max over the list as float.
fn _shi_max(xs: list) -> float
    let m = xs[0] * 1.0
    for i in 1..len(xs)
        let v = xs[i] * 1.0
        if v > m
            m = v
    m

// shi_bin_edges — return num_bins+1 edge floats from min to max (inclusive).
// Returns [] on empty xs or num_bins < 1.
fn shi_bin_edges(xs: list, num_bins: int) -> list
    let n = len(xs)
    if n == 0
        return []
    if num_bins < 1
        return []
    let mn = _shi_min(xs)
    let mx = _shi_max(xs)
    let nb = num_bins * 1.0
    let width = (mx - mn) / nb
    let edges = []
    let i = 0
    while i <= num_bins
        let edge = mn + i * 1.0 * width
        push(edges, edge)
        i = i + 1
    edges

// shi_bin_counts — return a list of num_bins integers: count of xs values per bin.
// Bin k covers [edges[k], edges[k+1]); the last bin is [edges[n-1], edges[n]] INCLUSIVE.
// Returns [] on empty xs or num_bins < 1.
fn shi_bin_counts(xs: list, num_bins: int) -> list
    let n = len(xs)
    if n == 0
        return []
    if num_bins < 1
        return []
    let mn = _shi_min(xs)
    let mx = _shi_max(xs)
    let nb = num_bins * 1.0
    let width = (mx - mn) / nb
    let counts = [0 for bi in 0..num_bins]
    for i in 0..n
        let v = xs[i] * 1.0
        let idx = 0
        if width <= 0.0
            idx = 0
        else
            let raw = (v - mn) / width
            idx = _shi_ftoi(raw)
            if idx >= num_bins
                idx = num_bins - 1
        counts[idx] = counts[idx] + 1
    counts

// shi_relative — return per-bin relative frequencies (count / total) as floats.
// Returns [] on empty xs or num_bins < 1.
fn shi_relative(xs: list, num_bins: int) -> list
    let n = len(xs)
    if n == 0
        return []
    if num_bins < 1
        return []
    let counts = shi_bin_counts(xs, num_bins)
    let total = n * 1.0
    let rel = []
    for i in 0..num_bins
        let r = counts[i] * 1.0 / total
        push(rel, r)
    rel
