// daryheap — d-ary array-backed MIN-heap with configurable arity d.
//
// A d-ary heap generalises the binary heap: each node has up to d children.
// Higher d reduces tree height (O(log_d n)) but increases the work per
// sift-down (finding the minimum child across d candidates).
// d=2 == binary heap; d=4 is often cache-friendly for pop-heavy workloads.
//
// Representation (a dict for reference semantics):
//   "items" -> list   (items[0] is always the minimum)
//   "d"     -> int    (branching factor; must be >= 2)
//
// Heap invariant:
//   For every node i: items[i] <= items[d*i + k]  for k in 1..d
//   i.e. every parent is <= all of its d children.
//
// Public API
//   dh_new(d)         -> heap dict (empty; branching factor d)
//   dh_push(h, v)     -> unit   (insert v; O(log_d n))
//   dh_pop(h)         -> int    (remove+return minimum; null if empty; O(d * log_d n))
//   dh_peek(h)        -> int    (return minimum without removing; null if empty; O(1))
//   dh_size(h)        -> int    (number of elements; O(1))
//   dh_from(lst, d)   -> heap   (build from list via Floyd heapify; O(n))

// _dh_swap: swap items[a] and items[b] in-place.
fn _dh_swap(items, a, b)
    let tmp = items[a]
    items[a] = items[b]
    items[b] = tmp

// _dh_sift_up: move element at index i toward root until heap property holds.
// Parent of i in a d-ary heap is (i - 1) / d  (integer division).
fn _dh_sift_up(items, i, d)
    let done = 0
    while i > 0 and done == 0
        let par = (i - 1) / d
        if items[i] < items[par]
            _dh_swap(items, i, par)
            i = par
        else
            done = 1

// _dh_sift_down: move element at index i toward leaves until heap property holds.
// Children of i are at indices d*i+1 .. d*i+d (clamped to [0, n)).
fn _dh_sift_down(items, i, n, d)
    let done = 0
    while done == 0
        let smallest = i
        let first_child = d * i + 1
        let k = 0
        while k < d
            let ci = first_child + k
            if ci < n
                if items[ci] < items[smallest]
                    smallest = ci
            k = k + 1
        if smallest == i
            done = 1
        else
            _dh_swap(items, i, smallest)
            i = smallest

// dh_new: create an empty d-ary min-heap with branching factor d (>= 2).
fn dh_new(d)
    let h = {}
    h["items"] = []
    h["d"] = d
    return h

// dh_push: insert value v into the heap in O(log_d n).
fn dh_push(h, v)
    let items = h["items"]
    let d = h["d"]
    items.push(v)
    _dh_sift_up(items, len(items) - 1, d)

// dh_pop: remove and return the minimum element in O(d * log_d n).
// Returns null if the heap is empty.
fn dh_pop(h)
    let items = h["items"]
    let d = h["d"]
    let n = len(items)
    if n == 0
        return null
    let min_val = items[0]
    if n == 1
        items.pop()
        return min_val
    let last = items.pop()
    items[0] = last
    _dh_sift_down(items, 0, len(items), d)
    return min_val

// dh_peek: return the minimum element without removing it.
// Returns null if the heap is empty.
fn dh_peek(h)
    let items = h["items"]
    if len(items) == 0
        return null
    return items[0]

// dh_size: return the number of elements in the heap.
fn dh_size(h)
    return len(h["items"])

// dh_from: build a d-ary min-heap from an arbitrary list in O(n) via Floyd's algorithm.
// lst is not modified; a fresh heap dict is returned.
fn dh_from(lst, d)
    let n = len(lst)
    let buf = []
    let i = 0
    while i < n
        buf.push(lst[i])
        i = i + 1
    // Sift down every non-leaf node from bottom up.
    // Last internal node index in a d-ary heap: (n - 2) / d
    let start = (n - 2) / d
    let idx = start
    while idx >= 0
        _dh_sift_down(buf, idx, n, d)
        idx = idx - 1
    let h = {}
    h["items"] = buf
    h["d"] = d
    return h
