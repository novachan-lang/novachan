// trie — prefix tree over lowercase strings.
//
// Each node is a NOVA dict.  The key "$" marks end-of-word (value 1).
// All other keys are single-character strings whose value is the child node dict.
//
// Public API:
//   tr_new()                       -> dict  (empty trie root node)
//   tr_insert(t, word)             -> unit  (add word to trie; no-op if already present)
//   tr_contains(t, word)  -> bool  (exact match)
//   tr_starts_with(t, prefix)      -> bool  (any word with that prefix exists)
//   tr_keys_with_prefix(t, prefix) -> list  (all words sharing prefix, sorted)
//   tr_keys(t)                     -> list  (ALL stored words, sorted ascending)
//   tr_size(t)                     -> int   (total distinct words stored)

// Return a new empty trie root node.
fn tr_new() -> dict
    let r = {}
    return r

// Insert `word` into the trie rooted at `t`.
// Navigates char-by-char, creating child nodes as needed.
fn tr_insert(t: dict, word: string)
    let node = t
    let i = 0
    let n = len(word)
    while i < n
        let ch = char_at(word, i)
        if not contains(node, ch)
            let child = {}
            node[ch] = child
        node = node[ch]
        i = i + 1
    node["$"] = 1

// Return true if `word` is stored exactly in the trie.
fn tr_contains(t: dict, word: string) -> bool
    let node = t
    let i = 0
    let n = len(word)
    while i < n
        let ch = char_at(word, i)
        if not contains(node, ch)
            return false
        node = node[ch]
        i = i + 1
    if contains(node, "$")
        return true
    return false

// Return true if any stored word begins with `prefix`.
fn tr_starts_with(t: dict, prefix: string) -> bool
    let node = t
    let i = 0
    let n = len(prefix)
    while i < n
        let ch = char_at(prefix, i)
        if not contains(node, ch)
            return false
        node = node[ch]
        i = i + 1
    return true

// Internal: depth-first collect all complete words reachable from `node`,
// prepending `prefix` to each. Appends found words into `acc` list.
fn _tr_collect(node, prefix: string, acc: list)
    if contains(node, "$")
        push(acc, prefix)
    let ks = sort(keys(node))
    let i = 0
    while i < len(ks)
        let k = ks[i]
        if k != "$"
            _tr_collect(node[k], prefix + k, acc)
        i = i + 1

// Return all words sharing `prefix`, in sorted (lexicographic) order.
fn tr_keys_with_prefix(t: dict, prefix: string) -> list
    let node = t
    let i = 0
    let n = len(prefix)
    while i < n
        let ch = char_at(prefix, i)
        if not contains(node, ch)
            return []
        node = node[ch]
        i = i + 1
    let acc = []
    _tr_collect(node, prefix, acc)
    return sort(acc)

// Internal: count end-of-word markers reachable from `node` (recursive DFS).
fn _tr_count(node) -> int
    let total = 0
    if contains(node, "$")
        total = total + 1
    let ks = keys(node)
    let i = 0
    while i < len(ks)
        let k = ks[i]
        if k != "$"
            total = total + _tr_count(node[k])
        i = i + 1
    return total

// Return ALL words stored in the trie, in sorted ascending order.
fn tr_keys(t: dict) -> list
    let acc = []
    _tr_collect(t, "", acc)
    return sort(acc)

// Return the total number of distinct words stored in the trie.
fn tr_size(t: dict) -> int
    return _tr_count(t)
