// union_find — Disjoint Set Union with path compression + union by rank.
//
// Representation dict keys:
//   "p" -> list of ints  (parent[i]; root when parent[i]==i)
//   "r" -> list of ints  (rank[i]; upper-bound on subtree depth)
//   "s" -> list of ints  (size[i]; valid only when i is a root)
//   "c" -> int           (number of disjoint sets)
//
// All operations are near-O(1) amortised (inverse-Ackermann).

// uf_make(n) -> new structure with n singletons 0..n-1.
fn uf_make(n)
    let p = []
    let r = []
    let s = []
    let i = 0
    while i < n
        p.push(i)
        r.push(0)
        s.push(1)
        i = i + 1
    let uf = {}
    uf["p"] = p
    uf["r"] = r
    uf["s"] = s
    uf["c"] = n
    return uf

// _uf_root(p, x) -> root of x with iterative full-path compression.
fn _uf_root(p, x)
    let root = x
    while p[root] != root
        root = p[root]
    let cur = x
    while cur != root
        let nxt = p[cur]
        p[cur] = root
        cur = nxt
    return root

// uf_find(uf, x) -> canonical root representative of x's set.
fn uf_find(uf, x)
    return _uf_root(uf["p"], x)

// uf_union(uf, a, b) -> merge sets of a and b; returns true if they were separate.
fn uf_union(uf, a, b)
    let p = uf["p"]
    let r = uf["r"]
    let s = uf["s"]
    let ra = _uf_root(p, a)
    let rb = _uf_root(p, b)
    if ra == rb
        return false
    if r[ra] < r[rb]
        let tmp = ra
        ra = rb
        rb = tmp
    p[rb] = ra
    s[ra] = s[ra] + s[rb]
    if r[ra] == r[rb]
        r[ra] = r[ra] + 1
    uf["c"] = uf["c"] - 1
    return true

// uf_connected(uf, a, b) -> true if a and b share the same set.
fn uf_connected(uf, a, b)
    let p = uf["p"]
    return _uf_root(p, a) == _uf_root(p, b)

// uf_count(uf) -> number of disjoint sets in the structure.
fn uf_count(uf)
    return uf["c"]

// uf_set_size(uf, x) -> number of elements in x's set.
fn uf_set_size(uf, x)
    let p = uf["p"]
    let root = _uf_root(p, x)
    return uf["s"][root]
