// lazy_segment_tree — Range-add + range-sum segment tree with lazy propagation.
//
// Representation dict keys:
//   "n"  -> int           (logical element count)
//   "pw" -> int           (next power-of-two >= n; tree leaf offset)
//   "t"  -> list of ints  (1-indexed sums, length 2*pw; index 0 unused)
//   "lz" -> list of ints  (1-indexed lazy addend, length 2*pw; index 0 unused)
//
// lz[node] is a pending per-element addend not yet pushed to children.
// t[node] already reflects all lazy from ancestors (pushed before read/write).
// All operations are O(log n).

// _lseg_pow2(n) -> smallest power-of-two >= n.
fn _lseg_pow2(n)
    let p = 1
    while p < n
        p = p * 2
    return p

// lseg_build(arr) -> new lazy segment tree loaded from arr (0-indexed list of ints).
fn lseg_build(arr)
    let n = len(arr)
    let pw = _lseg_pow2(n)
    let sz = pw * 2
    let t = []
    let lz = []
    let k = 0
    while k < sz
        t.push(0)
        lz.push(0)
        k = k + 1
    let i = 0
    while i < n
        t[pw + i] = arr[i]
        i = i + 1
    let j = pw - 1
    while j >= 1
        t[j] = t[j * 2] + t[j * 2 + 1]
        if j == 1
            j = 0
        else
            j = j - 1
    let tree = {}
    tree["n"] = n
    tree["pw"] = pw
    tree["t"] = t
    tree["lz"] = lz
    return tree

// _lseg_push(t, lz, node, half) -> push lazy from node to its two children.
// half = number of elements in each child's segment.
fn _lseg_push(t, lz, node, half)
    let v = lz[node]
    if v == 0
        return null
    let lc = node * 2
    let rc = node * 2 + 1
    t[lc] = t[lc] + v * half
    lz[lc] = lz[lc] + v
    t[rc] = t[rc] + v * half
    lz[rc] = lz[rc] + v
    lz[node] = 0

// lseg_range_add(tree, l, r, val) -> add val to every element in 0-based [l, r].
fn lseg_range_add(tree, l, r, val)
    let pw = tree["pw"]
    let t = tree["t"]
    let lz = tree["lz"]
    _lseg_add(t, lz, 1, 0, pw - 1, l, r, val)

// _lseg_add(t, lz, node, nl, nr, l, r, val) — recursive range add.
fn _lseg_add(t, lz, node, nl, nr, l, r, val)
    if l > nr or r < nl
        return null
    if l <= nl and nr <= r
        t[node] = t[node] + val * (nr - nl + 1)
        lz[node] = lz[node] + val
        return null
    let mid = (nl + nr) / 2
    let half = mid - nl + 1
    _lseg_push(t, lz, node, half)
    _lseg_add(t, lz, node * 2, nl, mid, l, r, val)
    _lseg_add(t, lz, node * 2 + 1, mid + 1, nr, l, r, val)
    t[node] = t[node * 2] + t[node * 2 + 1]

// lseg_range_sum(tree, l, r) -> sum of elements in 0-based [l, r].
fn lseg_range_sum(tree, l, r)
    let pw = tree["pw"]
    let t = tree["t"]
    let lz = tree["lz"]
    return _lseg_sum(t, lz, 1, 0, pw - 1, l, r)

// _lseg_sum(t, lz, node, nl, nr, l, r) — recursive range sum query.
fn _lseg_sum(t, lz, node, nl, nr, l, r)
    if l > nr or r < nl
        return 0
    if l <= nl and nr <= r
        return t[node]
    let mid = (nl + nr) / 2
    let half = mid - nl + 1
    _lseg_push(t, lz, node, half)
    return _lseg_sum(t, lz, node * 2, nl, mid, l, r) + _lseg_sum(t, lz, node * 2 + 1, mid + 1, nr, l, r)

// lseg_point_query(tree, i) -> value of element at 0-based index i.
fn lseg_point_query(tree, i)
    return lseg_range_sum(tree, i, i)
