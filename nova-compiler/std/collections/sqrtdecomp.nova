// sqrtdecomp — Sqrt decomposition for range-sum queries and point updates.
//
// Representation (dict keys):
//   "arr"  -> list of ints (the raw array, 0-indexed)
//   "blk"  -> list of ints (block sums; block k covers arr[k*bsz .. (k+1)*bsz-1])
//   "n"    -> int (length of arr)
//   "bsz"  -> int (block size, approx floor(sqrt(n)))
//   "nb"   -> int (number of blocks)
//
// All public functions use the sqd_ prefix.
// Time complexities: sqd_new O(n), sqd_update O(sqrt n), sqd_range_sum O(sqrt n), sqd_point O(1).

// _sqd_isqrt(n) -> floor(sqrt(n)) via integer Newton iteration.
fn _sqd_isqrt(n)
    if n <= 0
        return 1
    let x = n
    let x2 = (x + 1) / 2
    let done = 0
    while done == 0
        if x2 < x
            x = x2
            x2 = (x + n / x) / 2
        else
            done = 1
    return x

// sqd_new(arr) -> dict
// Build a sqrt-decomposition structure from a list of ints.
fn sqd_new(arr)
    let n = len(arr)
    let bsz = _sqd_isqrt(n)
    if bsz < 1
        bsz = 1
    let nb = (n + bsz - 1) / bsz

    // Build block sums
    let blk = []
    for k in 0..nb
        blk.push(0)

    // Populate block sums by iterating over arr
    let i = 0
    while i < n
        let b = i / bsz
        blk[b] = blk[b] + arr[i]
        i += 1

    let s = {}
    s["arr"] = arr
    s["blk"] = blk
    s["n"] = n
    s["bsz"] = bsz
    s["nb"] = nb
    return s

// sqd_point(s, i) -> int
// Return the value at index i (0-based).
fn sqd_point(s, i)
    let arr = s["arr"]
    return arr[i]

// sqd_update(s, i, val)
// Set arr[i] = val and recompute the affected block sum.
fn sqd_update(s, i, val)
    let arr = s["arr"]
    let blk = s["blk"]
    let bsz = s["bsz"]
    let b = i / bsz
    arr[i] = val

    // Recompute block b sum by walking its range
    let n = s["n"]
    let start = b * bsz
    let stop = start + bsz
    if stop > n
        stop = n
    let newsum = 0
    let j = start
    while j < stop
        newsum += arr[j]
        j += 1
    blk[b] = newsum

// sqd_range_sum(s, lo, hi) -> int
// Return sum of arr[lo..hi] inclusive (0-based).
fn sqd_range_sum(s, lo, hi)
    let arr = s["arr"]
    let blk = s["blk"]
    let bsz = s["bsz"]
    let total = 0

    // Left partial block: from lo up to the end of its block (or hi)
    let lb = lo / bsz
    let rb = hi / bsz

    if lb == rb
        // lo and hi are in the same block — walk element by element
        let i = lo
        while i <= hi
            total += arr[i]
            i += 1
        return total

    // Left partial block: lo .. (lb+1)*bsz - 1
    let left_end = (lb + 1) * bsz - 1
    let i = lo
    while i <= left_end
        total += arr[i]
        i += 1

    // Full middle blocks: lb+1 .. rb-1
    let b = lb + 1
    while b < rb
        total += blk[b]
        b += 1

    // Right partial block: rb*bsz .. hi
    let right_start = rb * bsz
    let j = right_start
    while j <= hi
        total += arr[j]
        j += 1

    return total
