// fenwick — Binary Indexed Tree (Fenwick Tree) for 1-indexed integer prefix sums.
//
// Representation: a dict with keys:
//   "a" -> list of ints (length n+1; index 0 unused; 1-indexed BIT array)
//   "n" -> int (logical size)
//
// All indices are 1-based (as is conventional for BIT).
// fw_update, fw_prefix, fw_range, fw_get all operate in O(log n) time.

// fw_new(n) -> a new Fenwick tree over n elements, all initialised to zero.
fn fw_new(n)
    let a = []
    let i = 0
    // push n+1 zeroes so valid indices are 1..n
    while i <= n
        a.push(0)
        i = i + 1
    let fw = {}
    fw["a"] = a
    fw["n"] = n
    return fw

// fw_update(fw, i, delta) — add delta to element at 1-based position i.
// Updates all ancestor nodes in the BIT.
fn fw_update(fw, i, delta)
    let a = fw["a"]
    let n = fw["n"]
    while i <= n
        a[i] = a[i] + delta
        // i += i & (-i)  — lowest set bit of i
        let lsb = i & (0 - i)
        i = i + lsb

// fw_prefix(fw, i) -> sum of elements at positions 1..i (inclusive).
fn fw_prefix(fw, i)
    let a = fw["a"]
    let s = 0
    while i > 0
        s = s + a[i]
        // i -= i & (-i)  — strip lowest set bit
        let lsb = i & (0 - i)
        i = i - lsb
    return s

// fw_range(fw, l, r) -> sum of elements at positions l..r (inclusive, 1-based).
fn fw_range(fw, l, r)
    return fw_prefix(fw, r) - fw_prefix(fw, l - 1)

// fw_get(fw, i) -> value at position i (point query).
fn fw_get(fw, i)
    return fw_range(fw, i, i)

// fw_size(fw) -> logical size n of the tree.
fn fw_size(fw)
    return fw["n"]
