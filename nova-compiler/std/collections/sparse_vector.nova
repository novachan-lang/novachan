// std/collections/sparse_vector.nova — Sparse vector arithmetic.
// A sparse vector is a dict {"idx": list<float>, "val": list<float>} where
// "idx" holds strictly ascending, integral indices (stored as floats to keep
// the dict's value type uniform) and "val" holds the nonzero value at each
// matching index. Both lists always have equal length (== nnz).
// LEAF — imports nothing.
//
// Public API (prefix spv_):
//   spv_make(idx, val)      -> dict   build a sparse vector from parallel lists
//                                      (idx must already be ascending & unique)
//   spv_nnz(sv)             -> int    number of stored (nonzero) entries
//   spv_get(sv, i)          -> float  value at dense index i (0.0 if absent)
//   spv_to_dense(sv, n)     -> list   dense list of length n
//   spv_from_dense(dense)   -> dict   sparse vector built from a dense list,
//                                      skipping exact-zero entries
//   spv_add(a, b)           -> dict   elementwise a + b
//   spv_negate(sv)          -> dict   elementwise -sv
//   spv_sub(a, b)           -> dict   elementwise a - b
//   spv_scale(sv, c)        -> dict   elementwise sv * c
//   spv_dot(a, b)           -> float  dot product (only overlapping indices contribute)
//   spv_norm1(sv)           -> float  sum of |values|
//   spv_norm2(sv)           -> float  Euclidean norm, sqrt(sum of values^2)
//   spv_equal(a, b)         -> bool   true iff a and b have identical (idx,val) entries
//   spv_is_zero(sv)         -> bool   true iff nnz == 0
//
// KNOWN ANSWERS (hand-verified):
//   v1 = spv_from_dense([0,3,0,5,0,2])  -> idx=[1,3,5] val=[3,5,2]
//   v2 = spv_from_dense([1,0,0,2,0,4])  -> idx=[0,3,5] val=[1,2,4]
//   spv_nnz(v1) = 3;  spv_get(v1,3) = 5.0;  spv_get(v1,2) = 0.0
//   spv_add(v1,v2)  -> idx=[0,1,3,5] val=[1,3,7,6]
//   spv_sub(v1,v2)  -> idx=[0,1,3,5] val=[-1,3,3,-2]
//   spv_dot(v1,v2)  = 5*2 + 2*4 = 18
//   spv_norm1(v1)   = 3+5+2 = 10
//   spv_norm2([0,1]->idx=[0,1] val=[3,4]) = sqrt(9+16) = 5.0

// spv_make — build a sparse vector from parallel index/value lists.
fn spv_make(idx, val)
    let sv = {"idx": idx, "val": val}
    return sv

// spv_nnz — number of stored entries.
fn spv_nnz(sv)
    let idx = sv["idx"]
    return len(idx)

// spv_get — value at dense index i, or 0.0 if not stored.
fn spv_get(sv, i)
    let idx = sv["idx"]
    let val = sv["val"]
    let n = len(idx)
    let target = float(i)
    for k in 0..n
        if idx[k] == target
            return val[k]
    return 0.0

// spv_to_dense — expand sv into a dense list of length n (0.0 elsewhere).
fn spv_to_dense(sv, n)
    let out = [0.0 for i in 0..n]
    let idx = sv["idx"]
    let val = sv["val"]
    let m = len(idx)
    for k in 0..m
        let pos = int(idx[k])
        out[pos] = val[k]
    return out

// spv_from_dense — build a sparse vector from a dense list, skipping zeros.
fn spv_from_dense(dense)
    let idx = []
    let val = []
    let n = len(dense)
    for i in 0..n
        let v = dense[i]
        if v != 0.0
            push(idx, float(i))
            push(val, v)
    return spv_make(idx, val)

// spv_add — elementwise a + b via merge of the two ascending index lists.
fn spv_add(a, b)
    let ai = a["idx"]
    let av = a["val"]
    let bi = b["idx"]
    let bv = b["val"]
    let na = len(ai)
    let nb = len(bi)
    let ridx = []
    let rval = []
    let i = 0
    let j = 0
    while i < na and j < nb
        if ai[i] < bi[j]
            push(ridx, ai[i])
            push(rval, av[i])
            i = i + 1
        else
            if bi[j] < ai[i]
                push(ridx, bi[j])
                push(rval, bv[j])
                j = j + 1
            else
                let s = av[i] + bv[j]
                if s != 0.0
                    push(ridx, ai[i])
                    push(rval, s)
                i = i + 1
                j = j + 1
    for k in i..na
        push(ridx, ai[k])
        push(rval, av[k])
    for k in j..nb
        push(ridx, bi[k])
        push(rval, bv[k])
    return spv_make(ridx, rval)

// _spv_copy — shallow copy of a float list.
fn _spv_copy(lst)
    return [v for v in lst]

// spv_negate — elementwise -sv.
fn spv_negate(sv)
    let idx = sv["idx"]
    let val = sv["val"]
    let rval = [0.0 - v for v in val]
    return spv_make(_spv_copy(idx), rval)

// spv_sub — elementwise a - b.
fn spv_sub(a, b)
    let nb = spv_negate(b)
    return spv_add(a, nb)

// spv_scale — elementwise sv * c.
fn spv_scale(sv, c)
    let idx = sv["idx"]
    let val = sv["val"]
    // NOTE: NOT a comprehension — `[v * c for v in val]` mistypes the captured
    // function parameter `c`, producing raw-bit garbage instead of a float
    // multiply (isolated repro; compiler bug, out of scope for this module).
    let rval = []
    for v in val
        push(rval, v * c)
    return spv_make(_spv_copy(idx), rval)

// spv_dot — dot product; only indices present in both vectors contribute.
fn spv_dot(a, b)
    let ai = a["idx"]
    let av = a["val"]
    let bi = b["idx"]
    let bv = b["val"]
    let na = len(ai)
    let nb = len(bi)
    let sum = 0.0
    let i = 0
    let j = 0
    while i < na and j < nb
        if ai[i] < bi[j]
            i = i + 1
        else
            if bi[j] < ai[i]
                j = j + 1
            else
                sum = sum + av[i] * bv[j]
                i = i + 1
                j = j + 1
    return sum

// spv_norm1 — sum of absolute values.
fn spv_norm1(sv)
    let val = sv["val"]
    // NOTE: NOT reduce() — reduce() on an empty list loses the float type of
    // the init value on display (str() prints "0" not "0.0"); isolated repro,
    // compiler bug, out of scope for this module.
    let sum = 0.0
    for v in val
        sum = sum + abs(v)
    return sum

// spv_norm2 — Euclidean norm.
fn spv_norm2(sv)
    let val = sv["val"]
    let sum = 0.0
    for v in val
        sum = sum + v * v
    return sqrt(sum)

// spv_equal — true iff a and b store identical (idx,val) entries.
fn spv_equal(a, b)
    let ai = a["idx"]
    let av = a["val"]
    let bi = b["idx"]
    let bv = b["val"]
    let na = len(ai)
    let nb = len(bi)
    if na != nb
        return false
    for k in 0..na
        if ai[k] != bi[k]
            return false
        if av[k] != bv[k]
            return false
    return true

// spv_is_zero — true iff sv has no stored entries.
fn spv_is_zero(sv)
    return spv_nnz(sv) == 0
