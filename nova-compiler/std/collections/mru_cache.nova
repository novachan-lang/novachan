// std/collections/mru_cache.nova — fixed-capacity Most-Recently-Used cache.
// KAT: test_programs/_kat_fleet6.nova
//
// std/cache/lru.nova (LRU) and std/collections/lfu_cache.nova (LFU) already
// cover the two classic eviction policies; MRU is the genuinely different
// third one — on overflow it evicts the entry that was used MOST recently
// (not least), which is the right policy for scan-resistant caching (e.g. a
// full sequential table scan that would otherwise thrash an LRU cache by
// repeatedly evicting the working set you actually want to keep).
//
// Representation (dict c), deliberately mirroring std/cache/lru.nova's shape
// so the two are easy to compare side by side:
//   "cap"   -> int capacity (max resident entries)
//   "order" -> list of keys, MRU-first (index 0 = most recently used, the
//              end of the list = least recently used — the MIRROR of
//              std/cache/lru.nova's LRU-first ordering)
//   "data"  -> dict str(key) -> stored value
//
// Public API:
//   mru_new(capacity)        -> dict
//   mru_get(cache, key)      -> any (cached value, or 0 on miss; promotes on hit)
//   mru_put(cache, key, val) -> dict (insert/update; evicts the MRU entry if at capacity)
//   mru_contains(cache, key) -> bool
//   mru_size(cache)          -> int
//   mru_is_full(cache)       -> bool
//   mru_is_empty(cache)      -> bool
//   mru_to_list(cache)       -> list  [key,value] pairs, MRU-first
//
// LEAF — imports nothing.

// mru_new: create a new empty MRU cache with the given resident capacity.
fn mru_new(capacity) -> dict
    let c = {}
    c["cap"] = capacity
    c["order"] = []
    c["data"] = {}
    return c

// _mru_touch: move key to the front of order (the MRU position). Key must
// already be present in order.
fn _mru_touch(order, key)
    remove(order, key)
    insert(order, 0, key)

// mru_get: return the cached value for key, or 0 on a miss. A hit promotes
// the key to the MRU (front) position.
fn mru_get(cache, key)
    let data = cache["data"]
    let k = str(key)
    if not contains(data, k)
        return 0
    _mru_touch(cache["order"], key)
    return data[k]

// mru_contains: true if key is currently resident (does not affect recency).
fn mru_contains(cache, key) -> bool
    return contains(cache["data"], str(key))

// mru_put: insert or update key -> val. If key is new and the cache is at
// capacity, evicts the MRU (front) entry first — the defining MRU trait.
fn mru_put(cache, key, val) -> dict
    let cap = cache["cap"]
    if cap <= 0
        return cache
    let data = cache["data"]
    let k = str(key)
    let order = cache["order"]
    if contains(data, k)
        data[k] = val
        _mru_touch(order, key)
        return cache
    if len(order) >= cap
        let evict = order[0]
        remove(order, evict)
        del(data, str(evict))
    insert(order, 0, key)
    data[k] = val
    return cache

// mru_size: number of resident entries.
fn mru_size(cache) -> int
    return len(cache["order"])

// mru_is_full: true iff the cache is currently at capacity.
fn mru_is_full(cache) -> bool
    return len(cache["order"]) >= cache["cap"]

// mru_is_empty: true iff the cache currently holds no entries.
fn mru_is_empty(cache) -> bool
    return len(cache["order"]) == 0

// mru_to_list: resident [key,value] pairs, MRU-first, as a fresh list.
fn mru_to_list(cache) -> list
    let out = []
    let data = cache["data"]
    for k in cache["order"]
        let v = data[str(k)]
        let pair = [k, v]
        push(out, pair)
    return out
