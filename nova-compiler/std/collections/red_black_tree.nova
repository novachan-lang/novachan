// red_black_tree — Left-Leaning Red-Black tree (Sedgewick's LLRB) as an
// ordered set of ints.
//
// LLRB is a simplified representation of a 2-3 tree using a standard BST
// augmented with a color bit per node, where red links always lean left.
// This collapses the usual 2*log2(n) red-black case analysis down to just
// three local transformations (rotate-left, rotate-right, flip-colors),
// applied bottom-up on the way back from the recursion. It guarantees the
// same O(log n) height bound as a classic red-black tree (height <= 2*log2(n+1))
// with far simpler code than the textbook top-down insertion.
//
// Reference: Robert Sedgewick, "Left-leaning Red-Black Trees" (2008),
// and Algorithms 4th ed. (Sedgewick & Wayne), chapter 3.3.
//
// Each node is a dict: {"k": int, "red": int, "l": node|null, "r": node|null}
//   k   = key
//   red = 1 if the link FROM THE PARENT to this node is red, 0 if black
//         (root is always treated as black regardless of its own flag by
//          forcing red=0 on the root after every insert/delete)
//   l/r = left/right children (null = empty, always "black" by convention)
//
// The tree dict itself: {"root": node|null, "size": int}
//
// Invariants maintained:
//   BST      — left subtree keys < node key < right subtree keys
//   Balance  — every root-to-null-link path has the same number of black links
//   Left-lean — no node has a red right link with a black left link (red
//               links only ever appear on the left)
//   No red-red — a red node never has a red child (no two consecutive reds)
//
// Public API:
//   rbt_new()              -> tree
//   rbt_insert(t, key)     -> unit   (no-op if key already present)
//   rbt_contains(t, key)   -> bool
//   rbt_delete(t, key)     -> unit   (no-op if key absent)
//   rbt_inorder(t)         -> list   (ascending sorted ints)
//   rbt_size(t)            -> int
//   rbt_height(t)          -> int    (longest root-to-leaf path length; 0 if empty)
//   rbt_black_height(t)    -> int    (# black links on any root-to-null path;
//                                      diagnostic — proves the balance invariant)
//   rbt_min(t)             -> int    (precondition: tree non-empty)
//   rbt_max(t)             -> int    (precondition: tree non-empty)
//
// SYMBOL COLLISION GUARD: all helpers prefixed _rbt_ / public API prefixed rbt_.
// LEAF — imports NOTHING.

// ── Color/rotation primitives ───────────────────────────────────────────────

// _rbt_is_red: true (1) iff nd is non-null and its "red" flag is set.
// null links are always considered black (0), per LLRB convention.
fn _rbt_is_red(nd)
    if nd == null
        return 0
    return nd["red"]

// _rbt_rotate_left: rotate a (temporarily) right-leaning red link at h to
// the left, restoring the left-leaning invariant locally.
//   Before:  h(blk)          After:  x(h's old color)
//              \                      /
//              x(red)                h(red)
//             /                        \
//            t                          t
fn _rbt_rotate_left(h)
    let x = h["r"]
    h["r"] = x["l"]
    x["l"] = h
    x["red"] = h["red"]
    h["red"] = 1
    return x

// _rbt_rotate_right: rotate a left-leaning red link at h to the right.
// Used to fix a run of two consecutive left-leaning red links.
fn _rbt_rotate_right(h)
    let x = h["l"]
    h["l"] = x["r"]
    x["r"] = h
    x["red"] = h["red"]
    h["red"] = 1
    return x

// _rbt_flip_colors: flip h and both of its children between red/black.
// Used to (a) split a temporary 4-node during insert, and (b) merge/borrow
// during delete's move-red-left / move-red-right.
fn _rbt_flip_colors(h)
    h["red"] = 1 - h["red"]
    let l = h["l"]
    let r = h["r"]
    l["red"] = 1 - l["red"]
    r["red"] = 1 - r["red"]
    return 0

// _rbt_balance: after a structural change below h, restore the LLRB
// invariants at h. Applied bottom-up on every return path of insert/delete.
fn _rbt_balance(h)
    if _rbt_is_red(h["r"]) and not _rbt_is_red(h["l"])
        h = _rbt_rotate_left(h)
    if _rbt_is_red(h["l"]) and _rbt_is_red(h["l"]["l"])
        h = _rbt_rotate_right(h)
    if _rbt_is_red(h["l"]) and _rbt_is_red(h["r"])
        _rbt_flip_colors(h)
    return h

// ── Insert ───────────────────────────────────────────────────────────────────

// _rbt_insert: recursive insert of key into subtree rooted at h.
// New nodes are inserted red (a red link to a fresh 2-node). Returns the
// (possibly new) subtree root.
fn _rbt_insert(h, key)
    if h == null
        let node = {}
        node["k"] = key
        node["red"] = 1
        node["l"] = null
        node["r"] = null
        return node
    let hk = h["k"]
    if key < hk
        h["l"] = _rbt_insert(h["l"], key)
    else
        if key > hk
            h["r"] = _rbt_insert(h["r"], key)
        // key == hk: duplicate, subtree unchanged
    return _rbt_balance(h)

// rbt_new: create a new empty red-black tree.
fn rbt_new()
    let t = {}
    t["root"] = null
    t["size"] = 0
    return t

// _rbt_contains: search subtree for key.
fn _rbt_contains(h, key)
    let cur = h
    let found = 0
    while cur != null and found == 0
        let ck = cur["k"]
        if key == ck
            found = 1
        else
            if key < ck
                cur = cur["l"]
            else
                cur = cur["r"]
    return found

// rbt_contains: return true iff key is present in the tree.
fn rbt_contains(t, key)
    return _rbt_contains(t["root"], key) == 1

// rbt_insert: insert key. No-op if already present.
fn rbt_insert(t, key)
    if _rbt_contains(t["root"], key) == 1
        return 0
    t["root"] = _rbt_insert(t["root"], key)
    t["root"]["red"] = 0
    t["size"] = t["size"] + 1
    return 0

// ── Delete ───────────────────────────────────────────────────────────────────
// Sedgewick's LLRB deletion: push red links downward so the node actually
// removed always has zero or one child, then rebalance on the way back up.

// _rbt_move_red_left: h is red and both h.l and h.l.l are black; make h.l
// (or one of its children) red by borrowing from h.r.
fn _rbt_move_red_left(h)
    _rbt_flip_colors(h)
    if _rbt_is_red(h["r"]["l"])
        h["r"] = _rbt_rotate_right(h["r"])
        h = _rbt_rotate_left(h)
        _rbt_flip_colors(h)
    return h

// _rbt_move_red_right: symmetric — borrow from h.l to make h.r red.
fn _rbt_move_red_right(h)
    _rbt_flip_colors(h)
    if _rbt_is_red(h["l"]["l"])
        h = _rbt_rotate_right(h)
        _rbt_flip_colors(h)
    return h

// _rbt_min_node: leftmost node of a non-null subtree.
fn _rbt_min_node(h)
    let cur = h
    while cur["l"] != null
        cur = cur["l"]
    return cur

// _rbt_max_node: rightmost node of a non-null subtree.
fn _rbt_max_node(h)
    let cur = h
    while cur["r"] != null
        cur = cur["r"]
    return cur

// _rbt_delete_min: remove the minimum key from subtree h. Precondition: h != null.
fn _rbt_delete_min(h)
    if h["l"] == null
        return null
    if not _rbt_is_red(h["l"]) and not _rbt_is_red(h["l"]["l"])
        h = _rbt_move_red_left(h)
    h["l"] = _rbt_delete_min(h["l"])
    return _rbt_balance(h)

// _rbt_delete: recursive delete of key from subtree h. Precondition: key
// is present somewhere in h (checked once by the public wrapper).
fn _rbt_delete(h, key)
    if key < h["k"]
        if not _rbt_is_red(h["l"]) and not _rbt_is_red(h["l"]["l"])
            h = _rbt_move_red_left(h)
        h["l"] = _rbt_delete(h["l"], key)
    else
        if _rbt_is_red(h["l"])
            h = _rbt_rotate_right(h)
        let is_match = 0
        if key == h["k"]
            is_match = 1
        if is_match == 1 and h["r"] == null
            return null
        if not _rbt_is_red(h["r"]) and not _rbt_is_red(h["r"]["l"])
            h = _rbt_move_red_right(h)
        if key == h["k"]
            // Replace with the in-order successor (min of right subtree),
            // then delete that successor from the right subtree instead.
            let succ = _rbt_min_node(h["r"])
            h["k"] = succ["k"]
            h["r"] = _rbt_delete_min(h["r"])
        else
            h["r"] = _rbt_delete(h["r"], key)
    return _rbt_balance(h)

// rbt_delete: remove key from the tree. No-op if key is absent.
fn rbt_delete(t, key)
    if _rbt_contains(t["root"], key) == 0
        return 0
    // Ensure the root itself is treated as red going in, per Sedgewick's
    // top-level delete convention (guarantees move_red_left/right preconditions).
    if not _rbt_is_red(t["root"]["l"]) and not _rbt_is_red(t["root"]["r"])
        t["root"]["red"] = 1
    t["root"] = _rbt_delete(t["root"], key)
    if t["root"] != null
        t["root"]["red"] = 0
    t["size"] = t["size"] - 1
    return 0

// ── Queries ──────────────────────────────────────────────────────────────────

fn _rbt_inorder(h, acc)
    if h == null
        return 0
    _rbt_inorder(h["l"], acc)
    acc.push(h["k"])
    _rbt_inorder(h["r"], acc)
    return 0

// rbt_inorder: all keys in ascending order.
fn rbt_inorder(t)
    let acc = []
    _rbt_inorder(t["root"], acc)
    return acc

// rbt_size: number of keys currently stored.
fn rbt_size(t)
    return t["size"]

fn _rbt_height(h)
    if h == null
        return 0
    let lh = _rbt_height(h["l"])
    let rh = _rbt_height(h["r"])
    if lh > rh
        return lh + 1
    return rh + 1

// rbt_height: length (in edges) of the longest root-to-leaf path.
fn rbt_height(t)
    return _rbt_height(t["root"])

fn _rbt_black_height(h)
    if h == null
        return 0
    let add = 1
    if _rbt_is_red(h)
        add = 0
    return _rbt_black_height(h["l"]) + add

// rbt_black_height: number of black links from the root down any
// root-to-null path (this is well-defined only when the balance invariant
// holds, which LLRB always maintains — useful as a self-check in tests).
fn rbt_black_height(t)
    return _rbt_black_height(t["root"])

// rbt_min: smallest key in the tree. Precondition: tree is non-empty.
fn rbt_min(t)
    let nd = _rbt_min_node(t["root"])
    return nd["k"]

// rbt_max: largest key in the tree. Precondition: tree is non-empty.
fn rbt_max(t)
    let nd = _rbt_max_node(t["root"])
    return nd["k"]
