// binaryheap — array-based binary MIN-heap, wrapped in a dict for reference semantics.
//
// Representation:
//   {"items": []}   — items[0] is always the smallest element (heap root)
//
// Heap invariant: items[i] <= items[2*i+1]  and  items[i] <= items[2*i+2]
// (every parent is <= both its children).
//
// Public API
//   bh_new()          -> heap dict (empty)
//   bh_push(h, v)     -> (mutates h; inserts v; sifts up to restore invariant)
//   bh_pop(h)         -> int  (remove+return minimum; null if empty)
//   bh_peek(h)        -> int  (return minimum without removing; null if empty)
//   bh_size(h)        -> int
//   bh_heapify(lst)   -> heap dict (build heap from a list in O(n) via Floyd)
//   bh_sort(lst)      -> list (ascending heapsort; non-destructive on lst)

// bh_swap_elems: swap items[a] and items[b] in-place.
fn bh_swap_elems(items, a, b)
    let tmp = items[a]
    items[a] = items[b]
    items[b] = tmp

// bh_sift_up: move element at index i toward the root until heap property holds.
fn bh_sift_up(items, i)
    let done = 0
    while i > 0 and done == 0
        let parent = (i - 1) / 2
        if items[i] < items[parent]
            bh_swap_elems(items, i, parent)
            i = parent
        else
            done = 1

// bh_sift_down: move element at index i toward leaves until heap property holds.
// Only considers indices in [0, n).
fn bh_sift_down(items, i, n)
    let done = 0
    while done == 0
        let smallest = i
        let left = 2 * i + 1
        let right = 2 * i + 2
        if left < n
            if items[left] < items[smallest]
                smallest = left
        if right < n
            if items[right] < items[smallest]
                smallest = right
        if smallest == i
            done = 1
        else
            bh_swap_elems(items, i, smallest)
            i = smallest

// bh_new: create and return an empty min-heap.
fn bh_new()
    let h = {}
    h["items"] = []
    return h

// bh_push: insert value v into the heap in O(log n).
fn bh_push(h, v)
    let items = h["items"]
    items.push(v)
    bh_sift_up(items, len(items) - 1)

// bh_pop: remove and return the minimum element in O(log n).
// Returns null if the heap is empty.
fn bh_pop(h)
    let items = h["items"]
    let n = len(items)
    if n == 0
        return null
    let min_val = items[0]
    if n == 1
        items.pop()
        return min_val
    // Replace root with last element, then shrink and sift down.
    let last = items.pop()
    items[0] = last
    bh_sift_down(items, 0, len(items))
    return min_val

// bh_peek: return the minimum element without removing it.
// Returns null if the heap is empty.
fn bh_peek(h)
    let items = h["items"]
    if len(items) == 0
        return null
    return items[0]

// bh_size: number of elements in the heap.
fn bh_size(h)
    return len(h["items"])

// bh_heapify: build a min-heap from an arbitrary list in O(n) via Floyd's algorithm.
// A fresh heap dict is returned; lst is not modified.
fn bh_heapify(lst)
    let n = len(lst)
    let buf = []
    let i = 0
    while i < n
        buf.push(lst[i])
        i = i + 1
    // Sift down every non-leaf node, starting from the last non-leaf.
    let start = n / 2 - 1
    let idx = start
    while idx >= 0
        bh_sift_down(buf, idx, n)
        idx = idx - 1
    let h = {}
    h["items"] = buf
    return h

// bh_sort: return a new list with elements of lst sorted ascending.
// Uses a fresh min-heap (non-destructive on lst).
fn bh_sort(lst)
    let n = len(lst)
    if n == 0
        return []
    let h = bh_heapify(lst)
    let out = []
    let i = 0
    while i < n
        let v = bh_pop(h)
        out.push(v)
        i = i + 1
    return out
