// treap — randomised BST (Treap) as an ordered set of ints.
//
// Priority is deterministic: prio(k) = (k * 2654435761) & 0x7FFFFFFF
// so the shape is reproducible for any given set of keys.
//
// Each node is a dict: {"k": int, "p": int, "l": node|null, "r": node|null}
// The treap dict itself: {"root": node|null, "size": int}
//
// Invariants:
//   BST  — left subtree keys < node key < right subtree keys
//   Heap — node priority >= children priorities (max-heap)
//
// Public API:
//   tr_new()              -> treap
//   tr_insert(t, key)     -> unit   (no-op if already present)
//   tr_contains(t, key)   -> bool
//   tr_delete(t, key)     -> unit   (no-op if absent)
//   tr_inorder(t)         -> list   (ascending sorted ints)
//   tr_size(t)            -> int
//   tr_min(t)             -> int    (undefined on empty treap)
//   tr_max(t)             -> int    (undefined on empty treap)

// _trp_prio: deterministic priority for a key.
// Knuth multiplicative hash, clamped to non-negative i32 range.
fn _trp_prio(key)
    let h = key * 2654435761
    // mask to 31 bits — keep non-negative
    let m = 2147483647
    // NOVA >> is arithmetic; use modulo-style masking
    // We want h & 0x7FFFFFFF.
    // h may be negative from overflow, so normalise via modulo + abs trick:
    // h mod (m+1) gives 0..m range for positive; for negative we adjust.
    let base = m + 1
    let r = h - (h / base) * base
    if r < 0
        r += base
    return r

// _trp_node: allocate a new leaf node.
fn _trp_node(key)
    let nd = {}
    nd["k"] = key
    nd["p"] = _trp_prio(key)
    nd["l"] = null
    nd["r"] = null
    return nd

// _trp_rotate_right: right rotation around `nd`.
//   Before:    nd              After:  lc
//             /  \                   /  \
//            lc   R                LL   nd
//           /  \                       /  \
//          LL   LR                    LR   R
// Returns new subtree root.
fn _trp_rotate_right(nd)
    let lc = nd["l"]
    let lr = lc["r"]
    lc["r"] = nd
    nd["l"] = lr
    return lc

// _trp_rotate_left: left rotation around `nd`.
//   Before:  nd               After:   rc
//           /  \                      /  \
//          L   rc                   nd   RR
//             /  \                 /  \
//            RL   RR              L   RL
// Returns new subtree root.
fn _trp_rotate_left(nd)
    let rc = nd["r"]
    let rl = rc["l"]
    rc["l"] = nd
    nd["r"] = rl
    return rc

// _trp_insert: recursive insert into subtree rooted at `nd`.
// Returns the (possibly new) root of the subtree.
fn _trp_insert(nd, key)
    if nd == null
        return _trp_node(key)
    let nk = nd["k"]
    if key < nk
        nd["l"] = _trp_insert(nd["l"], key)
        // Restore heap: if left child has higher priority, rotate right
        let lc = nd["l"]
        if lc["p"] > nd["p"]
            nd = _trp_rotate_right(nd)
    else
        if key > nk
            nd["r"] = _trp_insert(nd["r"], key)
            // Restore heap: if right child has higher priority, rotate left
            let rc = nd["r"]
            if rc["p"] > nd["p"]
                nd = _trp_rotate_left(nd)
        // key == nk: already present, do nothing
    return nd

// _trp_delete: recursive delete of key from subtree rooted at `nd`.
// Returns the (possibly new) root of the subtree.
fn _trp_delete(nd, key)
    if nd == null
        return null
    let nk = nd["k"]
    if key < nk
        nd["l"] = _trp_delete(nd["l"], key)
        return nd
    if key > nk
        nd["r"] = _trp_delete(nd["r"], key)
        return nd
    // key == nk: delete this node by rotating it down until it's a leaf
    let lc = nd["l"]
    let rc = nd["r"]
    if lc == null
        return rc
    if rc == null
        return lc
    // Both children exist: rotate towards the higher-priority child
    let lp = lc["p"]
    let rp = rc["p"]
    if lp > rp
        // Left has higher priority: rotate right, then delete from new right subtree
        nd = _trp_rotate_right(nd)
        nd["r"] = _trp_delete(nd["r"], key)
    else
        // Right has higher priority (or equal): rotate left, then delete from new left subtree
        nd = _trp_rotate_left(nd)
        nd["l"] = _trp_delete(nd["l"], key)
    return nd

// _trp_contains: search subtree for key. Returns 1 if found, 0 if not.
fn _trp_contains(nd, key)
    if nd == null
        return 0
    let nk = nd["k"]
    if key == nk
        return 1
    if key < nk
        return _trp_contains(nd["l"], key)
    return _trp_contains(nd["r"], key)

// _trp_inorder: append keys from subtree to acc in ascending order.
fn _trp_inorder(nd, acc)
    if nd == null
        return 0
    _trp_inorder(nd["l"], acc)
    acc.push(nd["k"])
    _trp_inorder(nd["r"], acc)
    return 0

// _trp_min_node: find node with minimum key in subtree.
fn _trp_min_node(nd)
    let cur = nd
    while cur["l"] != null
        cur = cur["l"]
    return cur

// _trp_max_node: find node with maximum key in subtree.
fn _trp_max_node(nd)
    let cur = nd
    while cur["r"] != null
        cur = cur["r"]
    return cur

// tr_new: create a new empty treap.
fn tr_new()
    let t = {}
    t["root"] = null
    t["size"] = 0
    return t

// tr_insert: insert key into treap. No-op if already present.
fn tr_insert(t, key)
    if _trp_contains(t["root"], key) == 1
        return 0
    t["root"] = _trp_insert(t["root"], key)
    t["size"] = t["size"] + 1
    return 0

// tr_contains: return true (1) if key is in the treap, false (0) otherwise.
fn tr_contains(t, key)
    return _trp_contains(t["root"], key)

// tr_delete: remove key from treap. No-op if absent.
fn tr_delete(t, key)
    if _trp_contains(t["root"], key) == 0
        return 0
    t["root"] = _trp_delete(t["root"], key)
    t["size"] = t["size"] - 1
    return 0

// tr_inorder: return list of all keys in ascending order.
fn tr_inorder(t)
    let acc = []
    _trp_inorder(t["root"], acc)
    return acc

// tr_size: return number of keys currently stored.
fn tr_size(t)
    return t["size"]

// tr_min: return the minimum key in the treap.
// Precondition: treap is non-empty.
fn tr_min(t)
    let nd = _trp_min_node(t["root"])
    return nd["k"]

// tr_max: return the maximum key in the treap.
// Precondition: treap is non-empty.
fn tr_max(t)
    let nd = _trp_max_node(t["root"])
    return nd["k"]
