// heapselect — bounded-heap selection (avoid full sort for k << n).
//
// Strategy:
//   kth_smallest: maintain a max-heap of size k; scan remainder; root = k-th smallest.
//   kth_largest:  maintain a min-heap of size k; scan remainder; root = k-th largest.
//   top_k_smallest: collect k smallest via max-heap, extract in ascending order.
//   top_k_largest:  collect k largest  via min-heap, extract in descending order.
//
// All heaps are array-backed, stored as a dict {"items":[]}.
// Time: O(n log k) per call.  Space: O(k).
//
// Public API
//   kth_smallest(lst, k)  -> int  (1-based; k-th smallest value; null if k < 1 or list empty)
//   kth_largest(lst, k)   -> int  (1-based; k-th largest value; null if k < 1 or list empty)
//   top_k_smallest(lst, k) -> list (ascending, at most min(k, len) elements)
//   top_k_largest(lst, k)  -> list (descending, at most min(k, len) elements)

// ---------------------------------------------------------------------------
// Internal: max-heap helpers (items[0] = largest)
// ---------------------------------------------------------------------------

fn _hs_max_swap(items, a, b)
    let tmp = items[a]
    items[a] = items[b]
    items[b] = tmp

fn _hs_max_sift_up(items, i)
    let done = 0
    while i > 0 and done == 0
        let parent = (i - 1) / 2
        if items[i] > items[parent]
            _hs_max_swap(items, i, parent)
            i = parent
        else
            done = 1

fn _hs_max_sift_down(items, i, n)
    let done = 0
    while done == 0
        let largest = i
        let left = 2 * i + 1
        let right = 2 * i + 2
        if left < n
            if items[left] > items[largest]
                largest = left
        if right < n
            if items[right] > items[largest]
                largest = right
        if largest == i
            done = 1
        else
            _hs_max_swap(items, i, largest)
            i = largest

fn _hs_max_new()
    let h = {}
    h["items"] = []
    return h

fn _hs_max_push(h, v)
    let items = h["items"]
    items.push(v)
    _hs_max_sift_up(items, len(items) - 1)

fn _hs_max_pop(h)
    let items = h["items"]
    let n = len(items)
    if n == 0
        return null
    let top = items[0]
    if n == 1
        items.pop()
        return top
    let last = items.pop()
    items[0] = last
    _hs_max_sift_down(items, 0, len(items))
    return top

fn _hs_max_peek(h)
    let items = h["items"]
    if len(items) == 0
        return null
    return items[0]

fn _hs_max_size(h)
    return len(h["items"])

// ---------------------------------------------------------------------------
// Internal: min-heap helpers (items[0] = smallest)
// ---------------------------------------------------------------------------

fn _hs_min_swap(items, a, b)
    let tmp = items[a]
    items[a] = items[b]
    items[b] = tmp

fn _hs_min_sift_up(items, i)
    let done = 0
    while i > 0 and done == 0
        let parent = (i - 1) / 2
        if items[i] < items[parent]
            _hs_min_swap(items, i, parent)
            i = parent
        else
            done = 1

fn _hs_min_sift_down(items, i, n)
    let done = 0
    while done == 0
        let smallest = i
        let left = 2 * i + 1
        let right = 2 * i + 2
        if left < n
            if items[left] < items[smallest]
                smallest = left
        if right < n
            if items[right] < items[smallest]
                smallest = right
        if smallest == i
            done = 1
        else
            _hs_min_swap(items, i, smallest)
            i = smallest

fn _hs_min_new()
    let h = {}
    h["items"] = []
    return h

fn _hs_min_push(h, v)
    let items = h["items"]
    items.push(v)
    _hs_min_sift_up(items, len(items) - 1)

fn _hs_min_pop(h)
    let items = h["items"]
    let n = len(items)
    if n == 0
        return null
    let top = items[0]
    if n == 1
        items.pop()
        return top
    let last = items.pop()
    items[0] = last
    _hs_min_sift_down(items, 0, len(items))
    return top

fn _hs_min_peek(h)
    let items = h["items"]
    if len(items) == 0
        return null
    return items[0]

fn _hs_min_size(h)
    return len(h["items"])

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

// kth_smallest: return the k-th smallest element (1-based) from lst.
// Uses a max-heap of size k: maintain the k smallest seen so far;
// the heap root is always the largest of those k, i.e. the k-th smallest.
// Returns null if lst is empty, k < 1, or k > len(lst) would be out of range
// (when k > len we clamp to return the actual maximum = the len-th smallest).
fn kth_smallest(lst, k)
    let n = len(lst)
    if n == 0
        return null
    if k < 1
        return null
    // clamp k to n (k > n means "the n-th smallest" = the maximum)
    let kk = k
    if kk > n
        kk = n
    let h = _hs_max_new()
    let i = 0
    while i < n
        let v = lst[i]
        if _hs_max_size(h) < kk
            _hs_max_push(h, v)
        else
            let top = _hs_max_peek(h)
            if v < top
                _hs_max_pop(h)
                _hs_max_push(h, v)
        i += 1
    return _hs_max_peek(h)

// kth_largest: return the k-th largest element (1-based) from lst.
// Uses a min-heap of size k: maintain the k largest seen so far;
// the heap root is always the smallest of those k, i.e. the k-th largest.
// Returns null if lst is empty or k < 1. Clamps k to n.
fn kth_largest(lst, k)
    let n = len(lst)
    if n == 0
        return null
    if k < 1
        return null
    let kk = k
    if kk > n
        kk = n
    let h = _hs_min_new()
    for i in 0..n
        let v = lst[i]
        if _hs_min_size(h) < kk
            _hs_min_push(h, v)
        else
            let top = _hs_min_peek(h)
            if v > top
                _hs_min_pop(h)
                _hs_min_push(h, v)
    return _hs_min_peek(h)

// top_k_smallest: return the k smallest elements sorted ascending.
// Uses a max-heap of size k to collect them, then extracts in descending
// order and reverses to give ascending output.
// If k >= n returns all elements sorted ascending.
fn top_k_smallest(lst, k)
    let n = len(lst)
    if n == 0
        return []
    if k < 1
        return []
    let kk = k
    if kk > n
        kk = n
    let h = _hs_max_new()
    for i in 0..n
        let v = lst[i]
        if _hs_max_size(h) < kk
            _hs_max_push(h, v)
        else
            let top = _hs_max_peek(h)
            if v < top
                _hs_max_pop(h)
                _hs_max_push(h, v)
    // Extract from max-heap: comes out descending; reverse to ascending.
    let tmp = []
    let sz = _hs_max_size(h)
    for j in 0..sz
        let val = _hs_max_pop(h)
        tmp.push(val)
    // tmp is descending; reverse it
    let out = []
    let lo = len(tmp) - 1
    while lo >= 0
        out.push(tmp[lo])
        lo -= 1
    return out

// top_k_largest: return the k largest elements sorted descending.
// Uses a min-heap of size k to collect them, then extracts in ascending
// order and reverses to give descending output.
// If k >= n returns all elements sorted descending.
fn top_k_largest(lst, k)
    let n = len(lst)
    if n == 0
        return []
    if k < 1
        return []
    let kk = k
    if kk > n
        kk = n
    let h = _hs_min_new()
    for i in 0..n
        let v = lst[i]
        if _hs_min_size(h) < kk
            _hs_min_push(h, v)
        else
            let top = _hs_min_peek(h)
            if v > top
                _hs_min_pop(h)
                _hs_min_push(h, v)
    // Extract from min-heap: comes out ascending; reverse to descending.
    let tmp = []
    let sz = _hs_min_size(h)
    for j in 0..sz
        let val = _hs_min_pop(h)
        tmp.push(val)
    // tmp is ascending; reverse it
    let out = []
    let lo = len(tmp) - 1
    while lo >= 0
        out.push(tmp[lo])
        lo -= 1
    return out
