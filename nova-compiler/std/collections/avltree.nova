// avltree — AVL self-balancing BST as an ordered set of ints.
//
// Each node is a dict: {"k": int, "h": int, "l": node|null, "r": node|null}
//   k = key, h = height (leaf = 1, null = 0)
//   l = left child, r = right child
//
// The AVL tree dict itself: {"root": node|null, "size": int}
//
// Invariants:
//   BST     — left subtree keys < node key < right subtree keys
//   Balance — |height(left) - height(right)| <= 1 for every node
//
// Rotations used to restore balance:
//   LL (left-left)   — right rotation at unbalanced node
//   RR (right-right) — left rotation at unbalanced node
//   LR (left-right)  — left rotation at left child, then right rotation
//   RL (right-left)  — right rotation at right child, then left rotation
//
// Public API:
//   av_new()              -> avltree
//   av_insert(t, key)     -> unit   (no-op if already present)
//   av_contains(t, key)   -> bool
//   av_delete(t, key)     -> unit   (no-op if absent)
//   av_inorder(t)         -> list   (ascending sorted ints)
//   av_size(t)            -> int
//   av_height(t)          -> int    (height of the root node, 0 if empty)
//   av_min(t)             -> int    (undefined on empty tree)
//   av_max(t)             -> int    (undefined on empty tree)

// _avl_ht: return height of a node (0 for null).
fn _avl_ht(nd)
    if nd == null
        return 0
    return nd["h"]

// _avl_update_h: recompute and store the height of nd from its children.
fn _avl_update_h(nd)
    let lh = _avl_ht(nd["l"])
    let rh = _avl_ht(nd["r"])
    let mx = lh
    if rh > lh
        mx = rh
    nd["h"] = mx + 1
    return 0

// _avl_bf: balance factor = height(left) - height(right).
fn _avl_bf(nd)
    return _avl_ht(nd["l"]) - _avl_ht(nd["r"])

// _avl_rot_right: right rotation around nd.
//   Before:    nd              After:  lc
//             /  \                   /  \
//            lc   R                LL   nd
//           /  \                       /  \
//          LL   LR                    LR   R
// Returns new subtree root.
fn _avl_rot_right(nd)
    let lc = nd["l"]
    let lr = lc["r"]
    lc["r"] = nd
    nd["l"] = lr
    _avl_update_h(nd)
    _avl_update_h(lc)
    return lc

// _avl_rot_left: left rotation around nd.
//   Before:  nd               After:   rc
//           /  \                      /  \
//          L   rc                   nd   RR
//             /  \                 /  \
//            RL   RR              L   RL
// Returns new subtree root.
fn _avl_rot_left(nd)
    let rc = nd["r"]
    let rl = rc["l"]
    rc["l"] = nd
    nd["r"] = rl
    _avl_update_h(nd)
    _avl_update_h(rc)
    return rc

// _avl_balance: apply the correct rotation(s) to restore AVL balance at nd.
// Precondition: nd's children are already balanced; only nd may be off.
// Returns the (possibly new) subtree root.
fn _avl_balance(nd)
    _avl_update_h(nd)
    let bf = _avl_bf(nd)
    if bf > 1
        // Left-heavy
        let lc = nd["l"]
        if _avl_bf(lc) < 0
            // LR case: left child is right-heavy — double rotation
            nd["l"] = _avl_rot_left(lc)
        // LL case (or now fixed LR): single right rotation
        return _avl_rot_right(nd)
    if bf < -1
        // Right-heavy
        let rc = nd["r"]
        if _avl_bf(rc) > 0
            // RL case: right child is left-heavy — double rotation
            nd["r"] = _avl_rot_right(rc)
        // RR case (or now fixed RL): single left rotation
        return _avl_rot_left(nd)
    // Already balanced
    return nd

// _avl_insert: recursive insert into subtree rooted at nd.
// Returns the (possibly new) subtree root.
fn _avl_insert(nd, key)
    if nd == null
        let node = {}
        node["k"] = key
        node["h"] = 1
        node["l"] = null
        node["r"] = null
        return node
    let nk = nd["k"]
    if key < nk
        nd["l"] = _avl_insert(nd["l"], key)
    else
        if key > nk
            nd["r"] = _avl_insert(nd["r"], key)
        // key == nk: duplicate, no-op
    return _avl_balance(nd)

// _avl_min_node: return the node with the minimum key in a subtree.
// Precondition: nd != null.
fn _avl_min_node(nd)
    let cur = nd
    while cur["l"] != null
        cur = cur["l"]
    return cur

// _avl_delete: recursive delete of key from subtree rooted at nd.
// Returns the (possibly new) subtree root.
fn _avl_delete(nd, key)
    if nd == null
        return null
    let nk = nd["k"]
    if key < nk
        nd["l"] = _avl_delete(nd["l"], key)
        return _avl_balance(nd)
    if key > nk
        nd["r"] = _avl_delete(nd["r"], key)
        return _avl_balance(nd)
    // key == nk: this is the node to remove
    let lc = nd["l"]
    let rc = nd["r"]
    if lc == null
        return rc
    if rc == null
        return lc
    // Both children present: replace with in-order successor (min of right subtree)
    let succ = _avl_min_node(rc)
    let sk = succ["k"]
    nd["k"] = sk
    nd["r"] = _avl_delete(nd["r"], sk)
    return _avl_balance(nd)

// _avl_contains: search subtree for key. Returns 1 if found, 0 if not.
fn _avl_contains(nd, key)
    if nd == null
        return 0
    let nk = nd["k"]
    if key == nk
        return 1
    if key < nk
        return _avl_contains(nd["l"], key)
    return _avl_contains(nd["r"], key)

// _avl_inorder: append keys from subtree to acc in ascending order.
fn _avl_inorder(nd, acc)
    if nd == null
        return 0
    _avl_inorder(nd["l"], acc)
    acc.push(nd["k"])
    _avl_inorder(nd["r"], acc)
    return 0

// _avl_max_node: return the node with the maximum key in a subtree.
// Precondition: nd != null.
fn _avl_max_node(nd)
    let cur = nd
    while cur["r"] != null
        cur = cur["r"]
    return cur

// av_new: create a new empty AVL tree.
fn av_new()
    let t = {}
    t["root"] = null
    t["size"] = 0
    return t

// av_insert: insert key into the AVL tree. No-op if already present.
fn av_insert(t, key)
    if _avl_contains(t["root"], key) == 1
        return 0
    t["root"] = _avl_insert(t["root"], key)
    t["size"] = t["size"] + 1
    return 0

// av_contains: return 1 (true) if key is in the tree, 0 (false) otherwise.
fn av_contains(t, key)
    return _avl_contains(t["root"], key)

// av_delete: remove key from the AVL tree. No-op if absent.
fn av_delete(t, key)
    if _avl_contains(t["root"], key) == 0
        return 0
    t["root"] = _avl_delete(t["root"], key)
    t["size"] = t["size"] - 1
    return 0

// av_inorder: return a list of all keys in ascending order.
fn av_inorder(t)
    let acc = []
    _avl_inorder(t["root"], acc)
    return acc

// av_size: return the number of keys currently stored.
fn av_size(t)
    return t["size"]

// av_height: return the height of the root (0 for empty tree).
// For a balanced AVL tree with n nodes: height <= floor(1.44 * log2(n+2)).
fn av_height(t)
    return _avl_ht(t["root"])

// av_min: return the minimum key in the tree.
// Precondition: tree is non-empty.
fn av_min(t)
    let nd = _avl_min_node(t["root"])
    return nd["k"]

// av_max: return the maximum key in the tree.
// Precondition: tree is non-empty.
fn av_max(t)
    let nd = _avl_max_node(t["root"])
    return nd["k"]
