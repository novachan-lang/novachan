// unionfind — disjoint-set / union-find data structure.
//
// Representation: a dict with keys:
//   "parent" -> list of ints (parent[i] = parent of element i; root when parent[i]==i)
//   "rank"   -> list of ints (rank[i] = upper-bound on tree depth from i)
//   "count"  -> int (number of disjoint sets)
//
// Path compression and union-by-rank give near-O(1) amortised operations.

// uf_new(n) -> a new union-find structure with n singletons (0..n-1).
fn uf_new(n)
    let parent = []
    let rank = []
    let i = 0
    while i < n
        parent.push(i)
        rank.push(0)
        i = i + 1
    let uf = {}
    uf["parent"] = parent
    uf["rank"] = rank
    uf["count"] = n
    return uf

// _uf_find_root(parent, x) -> root of x using iterative path compression.
// Mutates the parent list in-place (two-pass: find root, then compress).
fn _uf_find_root(parent, x)
    // Phase 1: walk to root
    let root = x
    while parent[root] != root
        root = parent[root]
    // Phase 2: path compression — point every node on the path to root
    let cur = x
    while cur != root
        let next = parent[cur]
        parent[cur] = root
        cur = next
    return root

// uf_find(uf, x) -> canonical root representative of the set containing x.
fn uf_find(uf, x)
    let parent = uf["parent"]
    return _uf_find_root(parent, x)

// uf_union(uf, a, b) -> merge the sets containing a and b (union by rank).
// Returns true if they were in different sets (a merge happened), false if already same.
fn uf_union(uf, a, b)
    let parent = uf["parent"]
    let rank = uf["rank"]
    let ra = _uf_find_root(parent, a)
    let rb = _uf_find_root(parent, b)
    if ra == rb
        return false
    // Attach smaller-rank tree under larger-rank root
    if rank[ra] < rank[rb]
        parent[ra] = rb
    else
        if rank[ra] > rank[rb]
            parent[rb] = ra
        else
            parent[rb] = ra
            rank[ra] = rank[ra] + 1
    uf["count"] = uf["count"] - 1
    return true

// uf_connected(uf, a, b) -> true if a and b are in the same set.
fn uf_connected(uf, a, b)
    let parent = uf["parent"]
    return _uf_find_root(parent, a) == _uf_find_root(parent, b)

// uf_count(uf) -> number of disjoint sets currently in the structure.
fn uf_count(uf)
    return uf["count"]
