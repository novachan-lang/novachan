// weightedunion — weighted (union-by-size) union-find with path compression.
//
// Unlike std/collections/dsu_weighted.nova (which tracks a per-element
// POTENTIAL/relative-weight for asserting "phi(b)-phi(a) = w" style
// constraints), this is the plain textbook disjoint-set structure: elements
// 0..n-1, merged by connectivity only, using union-by-size to keep the
// tree shallow (O(log n) worst case per op, effectively O(alpha(n)) amortised
// once path compression is folded in — the standard result for this
// combination of heuristics).
//
// Representation (dict u):
//   "parent" -> list[int]  parent[i] = parent of i (i is a root iff parent[i]==i)
//   "size"   -> list[int]  size[r] = size of the tree rooted at r (meaningful
//                          only when r is currently a root)
//   "comp"   -> int        current number of connected components
//
// Public API:
//   wuf_new(n)            -> dict
//   wuf_find(u, x)        -> list  ([root, u])
//   wuf_union(u, x, y)    -> dict  (merge x's and y's components; returns u)
//   wuf_connected(u, x, y) -> int  (1 if x and y are in the same component)
//   wuf_size(u)           -> int   (number of connected components)

// _wuf_find_root: iterative find with full path compression (every visited
// node ends up pointing directly at the root).
fn _wuf_find_root(parent, x)
    let cur = x
    while parent[cur] != cur
        cur = parent[cur]
    let root = cur
    cur = x
    while parent[cur] != root
        let nxt = parent[cur]
        parent[cur] = root
        cur = nxt
    return root

// wuf_new: create a weighted union-find over elements 0..n-1, all singletons.
fn wuf_new(n)
    let parent = []
    let sz = []
    for i in 0..n
        parent.push(i)
        sz.push(1)
    let u = {}
    u["parent"] = parent
    u["size"] = sz
    u["comp"] = n
    return u

// wuf_find: return [root_of_x, u] (path-compresses u["parent"] as a side effect).
fn wuf_find(u, x)
    let root = _wuf_find_root(u["parent"], x)
    let r = []
    r.push(root)
    r.push(u)
    return r

// wuf_union: merge the components containing x and y. The smaller tree (by
// element count) is attached under the root of the larger one. No-op if x
// and y are already in the same component.
fn wuf_union(u, x, y)
    let parent = u["parent"]
    let sz = u["size"]
    let rx = _wuf_find_root(parent, x)
    let ry = _wuf_find_root(parent, y)
    if rx == ry
        return u
    if sz[rx] < sz[ry]
        parent[rx] = ry
        sz[ry] = sz[ry] + sz[rx]
    else
        parent[ry] = rx
        sz[rx] = sz[rx] + sz[ry]
    u["comp"] = u["comp"] - 1
    return u

// wuf_connected: 1 if x and y are in the same component, 0 otherwise.
fn wuf_connected(u, x, y)
    let parent = u["parent"]
    let rx = _wuf_find_root(parent, x)
    let ry = _wuf_find_root(parent, y)
    if rx == ry
        return 1
    return 0

// wuf_size: current number of connected components.
fn wuf_size(u)
    return u["comp"]
