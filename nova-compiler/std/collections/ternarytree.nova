// ternarytree — Ternary Search Tree (TST) for string keys with prefix search.
//
// Each TST node is a NOVA dict:
//   "c"   -> string  (single character stored at this node)
//   "lo"  -> node|0  (left subtree: keys whose current char < this node's char)
//   "eq"  -> node|0  (middle subtree: keys whose current char == this node's char, next char)
//   "hi"  -> node|0  (right subtree: keys whose current char > this node's char)
//   "end" -> int     (1 if a complete word ends at this node, 0 otherwise)
//
// The tree itself is a dict {"root": node|0, "size": int}.
// 0 (integer) represents the absent/null node sentinel.
//
// Public API:
//   tst_new()                            -> dict   (empty TST)
//   tst_insert(t, word)                  -> unit   (insert word; idempotent)
//   tst_contains(t, word)                -> bool   (exact-match lookup)
//   tst_starts_with(t, prefix)           -> bool   (any word with this prefix exists)
//   tst_keys_with_prefix(t, prefix)      -> list   (all words with prefix, sorted)
//   tst_keys(t)                          -> list   (all words, sorted)
//   tst_size(t)                          -> int    (distinct word count)

// Return a new empty TST.
fn tst_new() -> dict
    let t = {}
    t["root"] = 0
    t["size"] = 0
    return t

// Internal: make a fresh TST node for character ch.
fn _tst_make_node(ch: string) -> dict
    let nd = {}
    nd["c"] = ch
    nd["lo"] = 0
    nd["eq"] = 0
    nd["hi"] = 0
    nd["end"] = 0
    return nd

// Internal: recursive insert of word[idx..] into the subtree rooted at `nd`.
// `nd` may be 0 (absent). Returns the (possibly new) root of the subtree.
// Also updates the "size" counter in `t` when a truly new word is added.
fn _tst_insert_r(nd, word: string, idx: int, t: dict)
    let ch = char_at(word, idx)
    if not is_dict(nd)
        nd = _tst_make_node(ch)
    if ch < nd["c"]
        nd["lo"] = _tst_insert_r(nd["lo"], word, idx, t)
    if ch > nd["c"]
        nd["hi"] = _tst_insert_r(nd["hi"], word, idx, t)
    if ch == nd["c"]
        let next = idx + 1
        if next == len(word)
            if nd["end"] == 0
                nd["end"] = 1
                t["size"] = t["size"] + 1
        if next < len(word)
            nd["eq"] = _tst_insert_r(nd["eq"], word, next, t)
    return nd

// Insert word into the TST.  No-op if word is already present.
fn tst_insert(t: dict, word: string)
    if len(word) == 0
        return
    t["root"] = _tst_insert_r(t["root"], word, 0, t)

// Internal: search for word[idx..] starting at node `nd`.
// Returns 1 (found and ends-here), -1 (prefix found but not a word), 0 (no path).
fn _tst_search_r(nd, word: string, idx: int) -> int
    if not is_dict(nd)
        return 0
    let ch = char_at(word, idx)
    if ch < nd["c"]
        return _tst_search_r(nd["lo"], word, idx)
    if ch > nd["c"]
        return _tst_search_r(nd["hi"], word, idx)
    // ch == nd["c"]
    let next = idx + 1
    if next == len(word)
        return nd["end"]
    return _tst_search_r(nd["eq"], word, next)

// Return true if word is stored exactly in the TST.
fn tst_contains(t: dict, word: string) -> bool
    if len(word) == 0
        return false
    let r = _tst_search_r(t["root"], word, 0)
    if r == 1
        return true
    return false

// Internal: navigate the eq-chain through prefix entirely, return the eq-child
// after the last prefix character (the subtree to collect from), or 0 if prefix
// is absent.  Separately returns whether the last prefix node itself is end=1.
// We pack both into a list [subtree_for_collection, end_of_last_node].
fn _tst_prefix_node(nd, word: string, idx: int) -> list
    if not is_dict(nd)
        let miss = [0, 0]
        return miss
    let ch = char_at(word, idx)
    if ch < nd["c"]
        return _tst_prefix_node(nd["lo"], word, idx)
    if ch > nd["c"]
        return _tst_prefix_node(nd["hi"], word, idx)
    // ch == nd["c"]
    let next = idx + 1
    if next == len(word)
        // Prefix consumed: the "eq" child is the subtree that extends the prefix,
        // and nd["end"] says whether the prefix itself is a complete word.
        let found = [nd["eq"], nd["end"]]
        return found
    return _tst_prefix_node(nd["eq"], word, next)

// Return true if any stored word begins with prefix.
fn tst_starts_with(t: dict, prefix: string) -> bool
    if len(prefix) == 0
        return true
    let info = _tst_prefix_node(t["root"], prefix, 0)
    let subtree = info[0]
    let endhere = info[1]
    if endhere == 1
        return true
    if is_dict(subtree)
        return true
    return false

// Internal: depth-first collect all complete words reachable from `nd`
// by following eq-chains, accumulating into `acc`.  `prefix` is the string
// built so far (characters consumed by eq-links reaching this node).
fn _tst_collect(nd, prefix: string, acc: list)
    if not is_dict(nd)
        return
    // lo and hi siblings share the same prefix depth — same character position.
    _tst_collect(nd["lo"], prefix, acc)
    _tst_collect(nd["hi"], prefix, acc)
    // Extend prefix with this node's character.
    let here = prefix + nd["c"]
    if nd["end"] == 1
        push(acc, here)
    // eq child goes deeper into the word.
    _tst_collect(nd["eq"], here, acc)

// Return all words sharing prefix, in sorted lexicographic order.
fn tst_keys_with_prefix(t: dict, prefix: string) -> list
    let acc = []
    if len(prefix) == 0
        _tst_collect(t["root"], "", acc)
        return sort(acc)
    let info = _tst_prefix_node(t["root"], prefix, 0)
    let subtree = info[0]
    let endhere = info[1]
    if endhere == 1
        push(acc, prefix)
    _tst_collect(subtree, prefix, acc)
    return sort(acc)

// Return ALL words stored in the TST, in sorted ascending order.
fn tst_keys(t: dict) -> list
    let acc = []
    _tst_collect(t["root"], "", acc)
    return sort(acc)

// Return the total number of distinct words stored in the TST.
fn tst_size(t: dict) -> int
    return t["size"]
