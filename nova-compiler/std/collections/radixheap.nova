// radixheap — Monotone radix heap (integer keys + associated value).
//
// A monotone radix heap is a priority queue that requires keys to be
// inserted >= the last extracted minimum (monotone invariant).  This
// enables Dijkstra-style shortest-path runs where keys never decrease.
//
// Structure:
//   h["buckets"] = list of 33 lists (bucket[b] = list of [key, val] pairs)
//   h["size"]    = int  (total element count)
//   h["last"]    = int  (last extracted minimum; initially 0)
//
// Bucket assignment rule:
//   b = msb_index(key XOR last)   where msb_index(0) = 0, msb_index(x) = floor(log2(x)) + 1
//   So bucket 0 holds elements equal to last; bucket b>0 holds elements
//   whose MSB of (key XOR last) is bit (b-1), i.e., differs in bit b-1.
//
// Extract-min:
//   Scan buckets 0..32 in order for first non-empty bucket b.
//   If b == 0: all entries have key == last; pop one entry (any order).
//   If b >  0: find minimum key in bucket b; set last = that min;
//              re-insert all entries in bucket b into their new correct buckets;
//              then pop the min (now in bucket 0) from bucket 0.
//
// Time complexity: insert O(1), extract-min O(B+n) worst-case; amortised
// O(B) per extract over a sequence of n inserts (each element re-bucketed at most B times).
//
// Public API:
//   rh_new()                  -> h
//   rh_insert(h, key, value)  -> (mutates h)
//   rh_extract_min(h)         -> [key, value]  or null if empty
//   rh_size(h)                -> int
//   rh_peek_min(h)            -> int  (key of minimum; null if empty)

// _rh_msb_bucket: compute bucket index for a given XOR distance d.
// Returns 0 if d == 0 (key equals last_min).
// Returns k in 1..32 where k-1 is the highest set bit index of d.
fn _rh_msb_bucket(d)
    if d == 0
        return 0
    let b = 0
    let v = d
    if v >= 65536
        b = b + 16
        v = v / 65536
    if v >= 256
        b = b + 8
        v = v / 256
    if v >= 16
        b = b + 4
        v = v / 16
    if v >= 4
        b = b + 2
        v = v / 4
    if v >= 2
        b = b + 1
    return b + 1

// _rh_bucket_for: return the bucket index for key given current last_min.
fn _rh_bucket_for(key, last_min)
    let d = key - last_min
    return _rh_msb_bucket(d)

// rh_new: create and return an empty radix heap.
fn rh_new()
    let h = {}
    let bkts = []
    let i = 0
    while i < 33
        let b = []
        bkts.push(b)
        i = i + 1
    h["buckets"] = bkts
    h["size"] = 0
    h["last"] = 0
    return h

// rh_size: return total number of elements in the heap.
fn rh_size(h)
    return h["size"]

// rh_insert: insert key+value into the heap.
// Precondition: key >= last extracted minimum (monotone invariant).
fn rh_insert(h, key, value)
    let last_min = h["last"]
    let b = _rh_bucket_for(key, last_min)
    let bkts = h["buckets"]
    let bucket = bkts[b]
    let pair = []
    pair.push(key)
    pair.push(value)
    bucket.push(pair)
    h["size"] = h["size"] + 1

// _rh_find_min_in_bucket: scan bucket list, return the minimum key found.
// bucket must be non-empty.
fn _rh_find_min_in_bucket(bucket)
    let n = len(bucket)
    let min_k = bucket[0][0]
    let i = 1
    while i < n
        let k = bucket[i][0]
        if k < min_k
            min_k = k
        i = i + 1
    return min_k

// rh_peek_min: return the key of the minimum element without removing it.
// Returns null if the heap is empty.
fn rh_peek_min(h)
    if h["size"] == 0
        return null
    let bkts = h["buckets"]
    let b = 0
    let found = 0
    while b < 33 and found == 0
        let bucket = bkts[b]
        if len(bucket) > 0
            found = 1
        else
            b = b + 1
    if found == 0
        return null
    let bucket = bkts[b]
    if b == 0
        return bucket[0][0]
    return _rh_find_min_in_bucket(bucket)

// rh_extract_min: remove and return [key, value] of the minimum element.
// Returns null if the heap is empty.
// After extraction, last_min is updated so future inserts must be >= returned key.
fn rh_extract_min(h)
    if h["size"] == 0
        return null
    let bkts = h["buckets"]
    // Find first non-empty bucket.
    let b = 0
    let found = 0
    while b < 33 and found == 0
        let bucket = bkts[b]
        if len(bucket) > 0
            found = 1
        else
            b = b + 1
    if found == 0
        return null
    // If not bucket 0: redistribute entries in bucket b after finding new last_min.
    if b > 0
        let bucket = bkts[b]
        let new_last = _rh_find_min_in_bucket(bucket)
        h["last"] = new_last
        // Remove all entries from bucket b and re-insert into correct buckets.
        let old_entries = bucket
        bkts[b] = []
        let n = len(old_entries)
        let i = 0
        while i < n
            let entry = old_entries[i]
            let ek = entry[0]
            let nb = _rh_bucket_for(ek, new_last)
            let dest = bkts[nb]
            dest.push(entry)
            i = i + 1
    // Now bucket 0 has all keys == last_min; pop one entry.
    let b0 = bkts[0]
    let sz0 = len(b0)
    // Find the entry with the minimum key in bucket 0 (all should equal last_min,
    // but be safe: pick first, swap with last, pop).
    let result = b0[0]
    if sz0 == 1
        b0.pop()
    else
        // Swap result with last entry, then pop last.
        let last_entry = b0[sz0 - 1]
        b0[0] = last_entry
        b0.pop()
    h["size"] = h["size"] - 1
    // Update last to the extracted key so monotone invariant is maintained.
    h["last"] = result[0]
    return result
