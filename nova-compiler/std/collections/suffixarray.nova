// suffixarray — suffix array of a string with binary-search substring queries.
//
// A suffix array is a sorted list of starting indices of all suffixes of string s,
// ordered lexicographically by the suffix they represent.
//
// For s = "banana":
//   suffixes: "banana"(0) "anana"(1) "nana"(2) "ana"(3) "na"(4) "a"(5)
//   sorted:   "a"(5) "ana"(3) "anana"(1) "banana"(0) "na"(4) "nana"(2)
//   sa_build returns [5,3,1,0,4,2]
//
// Public API:
//   sa_build(s)           -> list  (suffix array; indices sorted by suffix lex order)
//   sa_contains(s,sa,pat) -> bool  (true if pat appears anywhere in s)
//   sa_count(s,sa,pat)    -> int   (number of occurrences of pat in s)
//   sa_search(s,sa,pat)   -> list  (sorted list of start positions where pat occurs)

// _sa_cmp_suffix: compare suffix of s starting at i against suffix starting at j.
// Returns negative if suffix[i] < suffix[j], 0 if equal, positive if suffix[i] > suffix[j].
fn _sa_cmp_suffix(s, i, j)
    let n = len(s)
    let li = n - i
    let lj = n - j
    let min_len = li
    if lj < min_len
        min_len = lj
    let k = 0
    let result = 0
    let done = 0
    while k < min_len
        if done == 0
            let ci = ord(char_at(s, i + k))
            let cj = ord(char_at(s, j + k))
            if ci < cj
                result = -1
                done = 1
            else
                if ci > cj
                    result = 1
                    done = 1
        k += 1
    if done == 1
        return result
    // common prefix exhausted; shorter suffix is smaller
    if li < lj
        return -1
    if li > lj
        return 1
    return 0

// _sa_cmp_prefix: compare suffix of s starting at idx against pattern pat.
// Used for binary search: compares only as many characters as pat has.
// Returns -1 if suffix < pat prefix-wise, 0 if suffix starts with pat, 1 if suffix > pat.
fn _sa_cmp_prefix(s, idx, pat)
    let sn = len(s)
    let pn = len(pat)
    let avail = sn - idx
    let min_len = pn
    if avail < min_len
        min_len = avail
    let k = 0
    let result = 0
    let done = 0
    while k < min_len
        if done == 0
            let cs = ord(char_at(s, idx + k))
            let cp = ord(char_at(pat, k))
            if cs < cp
                result = -1
                done = 1
            else
                if cs > cp
                    result = 1
                    done = 1
        k += 1
    if done == 1
        return result
    // first min_len chars matched
    if avail < pn
        // suffix is shorter than pattern and is a prefix of pat -> suffix < pat
        return -1
    // suffix is at least as long and first pn chars match -> suffix starts with pat
    return 0

// sa_build: construct the suffix array of string s using insertion sort.
// O(n^2 log n) in worst case — correct and simple for moderate strings.
fn sa_build(s)
    let n = len(s)
    let sa = [i for i in 0..n]
    // insertion sort: for each element j, find its correct position among 0..j-1
    for j in 1..n
        let key = sa[j]
        // scan backwards to find insertion point; shift elements right as we go
        // we track the insertion index separately
        let ins = j
        let pos = j - 1
        while pos >= 0
            if _sa_cmp_suffix(s, sa[pos], key) > 0
                sa[pos + 1] = sa[pos]
                ins = pos
                pos -= 1
            else
                pos = -2
        sa[ins] = key
    return sa

// _sa_lower_bound: leftmost index in sa where suffix starts with pat (or where it would be).
fn _sa_lower_bound(s, sa, pat)
    let lo = 0
    let hi = len(sa)
    while lo < hi
        let mid = (lo + hi) / 2
        let cmp = _sa_cmp_prefix(s, sa[mid], pat)
        if cmp < 0
            lo = mid + 1
        else
            hi = mid
    return lo

// _sa_upper_bound: one-past-last index in sa where suffix starts with pat.
// We want the first position where cmp_prefix > 0 (suffix is strictly greater than pat prefix).
fn _sa_upper_bound(s, sa, pat)
    let lo = 0
    let hi = len(sa)
    while lo < hi
        let mid = (lo + hi) / 2
        let cmp = _sa_cmp_prefix(s, sa[mid], pat)
        if cmp <= 0
            lo = mid + 1
        else
            hi = mid
    return lo

// sa_contains: true if pat occurs anywhere in s (binary search over sa).
fn sa_contains(s, sa, pat)
    if len(pat) == 0
        return 1
    let lb = _sa_lower_bound(s, sa, pat)
    let ub = _sa_upper_bound(s, sa, pat)
    if ub > lb
        return 1
    return 0

// sa_count: number of times pat occurs in s.
fn sa_count(s, sa, pat)
    if len(pat) == 0
        return len(s) + 1
    let lb = _sa_lower_bound(s, sa, pat)
    let ub = _sa_upper_bound(s, sa, pat)
    return ub - lb

// sa_search: sorted list of all start positions where pat occurs in s.
fn sa_search(s, sa, pat)
    let result = []
    if len(pat) == 0
        return result
    let lb = _sa_lower_bound(s, sa, pat)
    let ub = _sa_upper_bound(s, sa, pat)
    let i = lb
    while i < ub
        push(result, sa[i])
        i += 1
    return sort(result)
