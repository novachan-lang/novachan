// skewheap — Skew heap (self-adjusting mergeable min-heap).
//
// A skew heap is a self-adjusting variant of a leftist heap.  Merge is the
// single primitive; insert and delete-min are trivially expressed via merge.
//
// Merge rule (min-heap, recursive):
//   merge(null, b) = b
//   merge(a, null) = a
//   If a.key <= b.key:
//     new_right = merge(a.right, b)      // merge a's right subtree with b
//     a.left, a.right = new_right, a.left  // swap children (the "skew" step)
//     return a
//   Else: symmetric with a and b swapped.
//
// The unconditional child-swap after every merge keeps the heap balanced
// in an amortised sense without maintaining any rank or balance information.
//
// Node representation (dict):
//   {"key": int, "left": node|null, "right": node|null}
// An empty heap is represented as null.
//
// Public API:
//   sk_empty()              -> null
//   sk_insert(root, v)      -> new_root
//   sk_find_min(root)       -> int   (safe: returns null on empty)
//   sk_delete_min(root)     -> new_root  (returns null on empty)
//   sk_merge(a, b)          -> new_root
//   sk_to_sorted(root)      -> list  (ascending; non-destructive)

// _sk_node: allocate a single leaf node.
fn _sk_node(key)
    return {"key": key, "left": null, "right": null}

// sk_empty: return an empty skew heap (null).
fn sk_empty()
    return null

// sk_merge: merge two skew heap roots a and b; returns the new root.
// Both a and b may be null.
fn sk_merge(a, b)
    if a == null
        return b
    if b == null
        return a
    let ak = a["key"]
    let bk = b["key"]
    if ak <= bk
        // a has the smaller key: merge a's right subtree with b,
        // then swap a's children (right becomes merged, left becomes old right).
        let old_left = a["left"]
        let merged = sk_merge(a["right"], b)
        a["right"] = old_left
        a["left"] = merged
        return a
    else
        // b has the smaller key: symmetric.
        let old_left = b["left"]
        let merged = sk_merge(a, b["right"])
        b["right"] = old_left
        b["left"] = merged
        return b

// sk_insert: insert integer v into the skew heap rooted at root.
// Returns the new root.
fn sk_insert(root, v)
    let nd = _sk_node(v)
    return sk_merge(root, nd)

// sk_find_min: return the minimum key without removing it.
// Returns null on an empty heap.
fn sk_find_min(root)
    if root == null
        return null
    return root["key"]

// sk_delete_min: remove and discard the minimum element.
// Returns the new root (null if heap becomes empty).
fn sk_delete_min(root)
    if root == null
        return null
    let left = root["left"]
    let right = root["right"]
    return sk_merge(left, right)

// sk_to_sorted: destructively drain the heap into an ascending sorted list.
// The original root is consumed; pass a copy if you need the heap afterwards.
fn sk_to_sorted(root)
    let out = []
    let cur = root
    while cur != null
        out.push(cur["key"])
        cur = sk_delete_min(cur)
    return out
