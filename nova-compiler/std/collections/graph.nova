// ============================================================================
// NOVA Standard Library — std/collections/graph
// ============================================================================
// Adjacency-list graph supporting both directed and undirected modes.
//
// PRIMARY API (gr_ prefix) — spec-compliant, supports directed/undirected:
//   gr_new(directed)         -> graph dict {"adj":{}, "dir":directed}
//   gr_add_node(g, n)        -> unit  (idempotent)
//   gr_add_edge(g, u, v)     -> unit  (deduplicates; adds reverse edge if undirected)
//   gr_neighbors(g, n)       -> list of neighbor strings (insertion order)
//   gr_has_edge(g, u, v)     -> 1 if edge u->v exists, 0 otherwise
//   gr_bfs(g, start)         -> list of nodes in BFS visit order
//   gr_dfs(g, start)         -> list of nodes in DFS preorder
//   gr_has_path(g, u, v)     -> 1 if v reachable from u, 0 otherwise
//   gr_topo_sort(g)          -> topological order (Kahn's); [] if cycle
//
// LEGACY API (g_ prefix) — directed only, preserved for backward compatibility:
//   g_new() / g_add_node / g_add_edge / g_neighbors / g_bfs / g_dfs
//   g_has_path / g_topo_sort
// ============================================================================

// ---- Internal stack helpers ------------------------------------------------
// Used by DFS (iterative) to avoid recursion depth limits.

fn _gr_stk_new()
    let s = {}
    s["data"] = []
    s["sp"] = 0
    return s

fn _gr_stk_push(s, v)
    let data = s["data"]
    let sp = s["sp"]
    if sp < len(data)
        data[sp] = v
    else
        data.push(v)
    s["sp"] = sp + 1

fn _gr_stk_pop(s)
    let sp = s["sp"]
    if sp <= 0
        return null
    let new_sp = sp - 1
    s["sp"] = new_sp
    let data = s["data"]
    return data[new_sp]

fn _gr_stk_len(s)
    return s["sp"]

// ---- Internal helpers ------------------------------------------------------

// _gr_list_contains: return 1 if string val is in list xs, else 0.
fn _gr_list_contains(xs, val)
    let i = 0
    while i < len(xs)
        if xs[i] == val
            return 1
        i = i + 1
    return 0

// ===========================================================================
// PRIMARY API — gr_ prefix
// ===========================================================================

// gr_new: create an empty graph.
//   directed = 1 -> directed; directed = 0 -> undirected (edges added both ways)
fn gr_new(directed)
    let g = {}
    g["adj"] = {}
    g["dir"] = directed
    return g

// gr_add_node: add node n if not already present. Idempotent.
fn gr_add_node(g, n)
    let adj = g["adj"]
    if contains(adj, n)
        return null
    adj[n] = []
    return null

// gr_add_edge: add edge u->v (and v->u if undirected). Deduplicates.
//   Auto-creates both endpoints if absent.
fn gr_add_edge(g, u, v)
    gr_add_node(g, u)
    gr_add_node(g, v)
    let adj = g["adj"]
    // Deduplicate: only append if not already present
    let nbrs_u = adj[u]
    if _gr_list_contains(nbrs_u, v) == 0
        nbrs_u.push(v)
    // If undirected, also add reverse edge
    let d = g["dir"]
    if d == 0
        let nbrs_v = adj[v]
        if _gr_list_contains(nbrs_v, u) == 0
            nbrs_v.push(u)
    return null

// gr_neighbors: return neighbor list of n (insertion order). [] if n unknown.
fn gr_neighbors(g, n)
    let adj = g["adj"]
    if contains(adj, n)
        return adj[n]
    return []

// gr_has_edge: return 1 if edge u->v exists, 0 otherwise.
fn gr_has_edge(g, u, v)
    let adj = g["adj"]
    if contains(adj, u) == 0
        return 0
    let nbrs = adj[u]
    return _gr_list_contains(nbrs, v)

// gr_bfs: breadth-first traversal from start. Returns visit-order list.
//   Neighbors explored in insertion order.
fn gr_bfs(g, start)
    let adj = g["adj"]
    if contains(adj, start) == 0
        return []
    let visited = {}
    let order = []
    let queue = []
    queue.push(start)
    let head = 0
    visited[start] = 1
    while head < len(queue)
        let node = queue[head]
        head = head + 1
        order.push(node)
        let nbrs = adj[node]
        let i = 0
        while i < len(nbrs)
            let nb = nbrs[i]
            if contains(visited, nb) == 0
                visited[nb] = 1
                queue.push(nb)
            i = i + 1
    return order

// gr_dfs: depth-first traversal (preorder) from start. Returns visit-order list.
//   Uses an explicit stack; neighbors pushed in reverse insertion order so that
//   the first inserted neighbor is visited first (matches recursive preorder DFS).
fn gr_dfs(g, start)
    let adj = g["adj"]
    if contains(adj, start) == 0
        return []
    let visited = {}
    let order = []
    let stk = _gr_stk_new()
    _gr_stk_push(stk, start)
    while _gr_stk_len(stk) > 0
        let top = _gr_stk_pop(stk)
        if contains(visited, top) == 0
            visited[top] = 1
            order.push(top)
            // Push neighbors in reverse so leftmost (insertion-order) is processed first
            let nbrs = adj[top]
            let i = len(nbrs) - 1
            while i >= 0
                let nb = nbrs[i]
                if contains(visited, nb) == 0
                    _gr_stk_push(stk, nb)
                i = i - 1
    return order

// gr_has_path: 1 if v is reachable from u, 0 otherwise.
fn gr_has_path(g, u, v)
    let adj = g["adj"]
    if contains(adj, u) == 0
        return 0
    if u == v
        return 1
    let visited = {}
    let queue = []
    queue.push(u)
    let head = 0
    visited[u] = 1
    while head < len(queue)
        let node = queue[head]
        head = head + 1
        let nbrs = adj[node]
        let i = 0
        while i < len(nbrs)
            let nb = nbrs[i]
            if nb == v
                return 1
            if contains(visited, nb) == 0
                visited[nb] = 1
                queue.push(nb)
            i = i + 1
    return 0

// gr_topo_sort: Kahn's algorithm. Returns topological order, or [] on cycle.
//   Only meaningful for directed graphs.
fn gr_topo_sort(g)
    let adj = g["adj"]
    let all_nodes = keys(adj)
    let n = len(all_nodes)
    if n == 0
        return []
    // Build in-degree map (initialise all to 0)
    let indeg = {}
    let i = 0
    while i < n
        indeg[all_nodes[i]] = 0
        i = i + 1
    // Count in-edges from every node's adjacency list
    i = 0
    while i < n
        let node = all_nodes[i]
        let nbrs = adj[node]
        let j = 0
        while j < len(nbrs)
            let nb = nbrs[j]
            indeg[nb] = indeg[nb] + 1
            j = j + 1
        i = i + 1
    // Seed queue with all zero-indegree nodes (key insertion order for determinism)
    let queue = []
    i = 0
    while i < n
        if indeg[all_nodes[i]] == 0
            queue.push(all_nodes[i])
        i = i + 1
    let head = 0
    let result = []
    while head < len(queue)
        let node = queue[head]
        head = head + 1
        result.push(node)
        let nbrs = adj[node]
        let j = 0
        while j < len(nbrs)
            let nb = nbrs[j]
            indeg[nb] = indeg[nb] - 1
            if indeg[nb] == 0
                queue.push(nb)
            j = j + 1
    // Cycle detected: not all nodes processed
    if len(result) != n
        return []
    return result

// ===========================================================================
// LEGACY API — g_ prefix (directed only, no deduplication)
// ===========================================================================

// Internal stack helpers (g_ legacy uses separate symbols to avoid collision)
fn _stk_new()
    let s = {}
    s["data"] = []
    s["sp"] = 0
    return s

fn _stk_push(s, v)
    let data = s["data"]
    let sp = s["sp"]
    if sp < len(data)
        data[sp] = v
    else
        data.push(v)
    s["sp"] = sp + 1

fn _stk_pop(s)
    let sp = s["sp"]
    if sp <= 0
        return null
    let new_sp = sp - 1
    s["sp"] = new_sp
    let data = s["data"]
    return data[new_sp]

fn _stk_len(s)
    return s["sp"]

fn g_new()
    let g = {}
    g["adj"] = {}
    return g

fn g_add_node(g, u)
    let adj = g["adj"]
    if contains(adj, u)
        return null
    adj[u] = []
    return null

fn g_add_edge(g, u, v)
    g_add_node(g, u)
    g_add_node(g, v)
    let adj = g["adj"]
    let nbrs = adj[u]
    nbrs.push(v)
    return null

fn g_neighbors(g, u)
    let adj = g["adj"]
    if contains(adj, u)
        return adj[u]
    return []

fn g_bfs(g, start)
    let adj = g["adj"]
    if contains(adj, start) == 0
        return []
    let visited = {}
    let order = []
    let queue = []
    queue.push(start)
    let head = 0
    visited[start] = 1
    while head < len(queue)
        let node = queue[head]
        head = head + 1
        order.push(node)
        let nbrs = adj[node]
        let i = 0
        while i < len(nbrs)
            let nb = nbrs[i]
            if contains(visited, nb) == 0
                visited[nb] = 1
                queue.push(nb)
            i = i + 1
    return order

fn g_dfs(g, start)
    let adj = g["adj"]
    if contains(adj, start) == 0
        return []
    let visited = {}
    let order = []
    let stk = _stk_new()
    _stk_push(stk, start)
    while _stk_len(stk) > 0
        let top = _stk_pop(stk)
        if contains(visited, top) == 0
            visited[top] = 1
            order.push(top)
            let nbrs = adj[top]
            let i = len(nbrs) - 1
            while i >= 0
                let nb = nbrs[i]
                if contains(visited, nb) == 0
                    _stk_push(stk, nb)
                i = i - 1
    return order

fn g_has_path(g, u, v)
    let adj = g["adj"]
    if contains(adj, u) == 0
        return 0
    if u == v
        return 1
    let visited = {}
    let queue = []
    queue.push(u)
    let head = 0
    visited[u] = 1
    while head < len(queue)
        let node = queue[head]
        head = head + 1
        let nbrs = adj[node]
        let i = 0
        while i < len(nbrs)
            let nb = nbrs[i]
            if nb == v
                return 1
            if contains(visited, nb) == 0
                visited[nb] = 1
                queue.push(nb)
            i = i + 1
    return 0

fn g_topo_sort(g)
    let adj = g["adj"]
    let all_nodes = keys(adj)
    let n = len(all_nodes)
    if n == 0
        return []
    let indeg = {}
    let i = 0
    while i < n
        indeg[all_nodes[i]] = 0
        i = i + 1
    i = 0
    while i < n
        let node = all_nodes[i]
        let nbrs = adj[node]
        let j = 0
        while j < len(nbrs)
            let nb = nbrs[j]
            indeg[nb] = indeg[nb] + 1
            j = j + 1
        i = i + 1
    let queue = []
    i = 0
    while i < n
        if indeg[all_nodes[i]] == 0
            queue.push(all_nodes[i])
        i = i + 1
    let head = 0
    let result = []
    while head < len(queue)
        let node = queue[head]
        head = head + 1
        result.push(node)
        let nbrs = adj[node]
        let j = 0
        while j < len(nbrs)
            let nb = nbrs[j]
            indeg[nb] = indeg[nb] - 1
            if indeg[nb] == 0
                queue.push(nb)
            j = j + 1
    if len(result) != n
        return []
    return result
