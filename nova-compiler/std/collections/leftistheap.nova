// leftistheap — Leftist heap (rank-biased mergeable min-heap).
//
// A leftist heap maintains the leftist property: the rank (null-path-length,
// i.e. the shortest path from a node to a null child) of any left child is
// >= the rank of its right sibling.  Merge always walks the right spine, so
// its cost is O(log n).  Insert and delete-min are expressed via merge.
//
// Node representation (dict):
//   {"key": int, "rank": int, "left": node|null, "right": node|null}
// An empty heap is represented as null.
//
// Rank rule: rank(null) = 0; rank(node) = 1 + rank(node.right)
// After merging into the right child, if right.rank > left.rank, swap
// children so the subtree with higher rank is always on the left.
//
// Public API:
//   lh_empty()            -> null
//   lh_insert(root, v)    -> new_root
//   lh_find_min(root)     -> int   (null on empty)
//   lh_delete_min(root)   -> new_root  (null if heap becomes empty)
//   lh_merge(a, b)        -> new_root
//   lh_to_sorted(root)    -> list  (ascending; destructive on root)

// _lh_rank: return the rank of a node (0 for null).
fn _lh_rank(nd)
    if nd == null
        return 0
    return nd["rank"]

// _lh_node: allocate a leaf node with the given key (rank=1, no children).
fn _lh_node(key)
    return {"key": key, "rank": 1, "left": null, "right": null}

// lh_empty: return an empty leftist heap (null).
fn lh_empty()
    return null

// lh_merge: merge two leftist heap roots a and b; returns the new root.
// Both a and b may be null.
fn lh_merge(a, b)
    if a == null
        return b
    if b == null
        return a
    let ak = a["key"]
    let bk = b["key"]
    if ak <= bk
        // a has the smaller key: recurse on a's right subtree and b.
        let merged_right = lh_merge(a["right"], b)
        let al = a["left"]
        let lr = _lh_rank(al)
        let rr = _lh_rank(merged_right)
        if lr >= rr
            a["left"] = al
            a["right"] = merged_right
            a["rank"] = rr + 1
        else
            a["left"] = merged_right
            a["right"] = al
            a["rank"] = lr + 1
        return a
    else
        // b has the smaller key: recurse on b's right subtree and a.
        let merged_right = lh_merge(a, b["right"])
        let bl = b["left"]
        let lr = _lh_rank(bl)
        let rr = _lh_rank(merged_right)
        if lr >= rr
            b["left"] = bl
            b["right"] = merged_right
            b["rank"] = rr + 1
        else
            b["left"] = merged_right
            b["right"] = bl
            b["rank"] = lr + 1
        return b

// lh_insert: insert integer v into the leftist heap rooted at root.
// Returns the new root.
fn lh_insert(root, v)
    let nd = _lh_node(v)
    return lh_merge(root, nd)

// lh_find_min: return the minimum key without removing it.
// Returns null on an empty heap.
fn lh_find_min(root)
    if root == null
        return null
    return root["key"]

// lh_delete_min: remove and discard the minimum element (root).
// Returns the new root (null if heap becomes empty).
fn lh_delete_min(root)
    if root == null
        return null
    let left = root["left"]
    let right = root["right"]
    return lh_merge(left, right)

// lh_to_sorted: drain the heap into an ascending sorted list.
// The original root is consumed by repeated delete-min.
fn lh_to_sorted(root)
    let out = []
    let cur = root
    while cur != null
        out.push(cur["key"])
        cur = lh_delete_min(cur)
    return out
