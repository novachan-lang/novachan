// orderedset — insertion-ordered set of strings for NOVA.
//
// Maintains insertion order while enforcing uniqueness.  Duplicates are
// silently ignored on add.
//
// Representation (a plain NOVA dict):
//   "items" -> list   (insertion-ordered list of member strings)
//   "seen"  -> dict   (member -> 1, for O(1) membership test)
//
// Public API
//   os_new()               -> orderedset
//   os_add(os, x)          -> unit  (append x if not already present)
//   os_has(os, x)          -> 1 if present, 0 otherwise
//   os_remove(os, x)       -> unit  (no-op if absent)
//   os_len(os)             -> number of members
//   os_items(os)           -> list in insertion order
//   os_union(a, b)         -> new orderedset (a items then b items, no dups)
//   os_intersect(a, b)     -> new orderedset (items in a that are also in b, a-order)
//   os_difference(a, b)    -> new orderedset (items in a not in b, a-order)

fn os_new()
    let os = {}
    os["items"] = []
    os["seen"] = {}
    return os

// os_add: append x to items only if it has not been seen before.
fn os_add(os, x)
    let seen = os["seen"]
    if contains(seen, x)
        return null
    let items = os["items"]
    items.push(x)
    seen[x] = 1

// os_has: 1 if x is a member, 0 otherwise.
fn os_has(os, x)
    let seen = os["seen"]
    if contains(seen, x)
        return 1
    return 0

// os_remove: remove x from both items list and seen dict.  No-op if absent.
fn os_remove(os, x)
    let seen = os["seen"]
    if contains(seen, x)
        del(seen, x)
        let items = os["items"]
        let new_items = []
        let i = 0
        while i < len(items)
            if items[i] != x
                new_items.push(items[i])
            i = i + 1
        os["items"] = new_items

// os_len: number of members.
fn os_len(os)
    return len(os["items"])

// os_items: return members in insertion order.
fn os_items(os)
    return os["items"]

// os_union: new orderedset with all items from a, then any items from b not in a.
fn os_union(a, b)
    let result = os_new()
    let ai = os_items(a)
    for i in 0..len(ai)
        os_add(result, ai[i])
    let bi = os_items(b)
    for j in 0..len(bi)
        os_add(result, bi[j])
    return result

// os_intersect: new orderedset with items from a that are also in b (a-order preserved).
fn os_intersect(a, b)
    let result = os_new()
    let ai = os_items(a)
    for i in 0..len(ai)
        let x = ai[i]
        if os_has(b, x)
            os_add(result, x)
    return result

// os_difference: new orderedset with items from a that are NOT in b (a-order preserved).
fn os_difference(a, b)
    let result = os_new()
    let ai = os_items(a)
    for i in 0..len(ai)
        let x = ai[i]
        if os_has(b, x) == 0
            os_add(result, x)
    return result
