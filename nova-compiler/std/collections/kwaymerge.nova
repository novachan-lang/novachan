// kwaymerge — K-way merge of sorted lists using a min-heap of entry dicts.
//
// Each heap entry is a dict:
//   {"val": int, "li": int, "ei": int}
//   where val = current value, li = list index, ei = element index within that list.
//
// For kmerge_pairs, entries are:
//   {"val": int, "li": int, "ei": int, "pval": int}
//   where val = the key of the pair, pval = the value of the pair.
//
// Public API:
//   kmerge(lists)        -> list  (merge k sorted int-lists ascending)
//   kmerge_pairs(plists) -> list  (merge k sorted pair-lists by key; each pair is [key,val])
//   kmerge_dedup(lists)  -> list  (merge k sorted int-lists, duplicates removed)
//
// Heap representation: {"items": [list of entry dicts]}
// Heap invariant (min-heap by "val"): items[i]["val"] <= items[child]["val"]

// _km_swap: swap entries at indices a and b in items list.
fn _km_swap(items, a, b)
    let tmp = items[a]
    items[a] = items[b]
    items[b] = tmp

// _km_sift_up: restore heap property after insert at index i.
fn _km_sift_up(items, i)
    let done = 0
    while i > 0 and done == 0
        let parent = (i - 1) / 2
        let iv = items[i]["val"]
        let pv = items[parent]["val"]
        if iv < pv
            _km_swap(items, i, parent)
            i = parent
        else
            done = 1

// _km_sift_down: restore heap property after removing root; n = heap size.
fn _km_sift_down(items, i, n)
    let done = 0
    while done == 0
        let smallest = i
        let left = 2 * i + 1
        let right = 2 * i + 2
        if left < n
            let lv = items[left]["val"]
            let sv = items[smallest]["val"]
            if lv < sv
                smallest = left
        if right < n
            let rv = items[right]["val"]
            let sv2 = items[smallest]["val"]
            if rv < sv2
                smallest = right
        if smallest == i
            done = 1
        else
            _km_swap(items, i, smallest)
            i = smallest

// _km_heap_new: create an empty entry-heap.
fn _km_heap_new()
    let h = {}
    h["items"] = []
    return h

// _km_heap_push: insert entry dict e into the heap.
fn _km_heap_push(h, e)
    let items = h["items"]
    items.push(e)
    _km_sift_up(items, len(items) - 1)

// _km_heap_pop: remove and return the minimum-val entry. Returns null if empty.
fn _km_heap_pop(h)
    let items = h["items"]
    let n = len(items)
    if n == 0
        return null
    let top = items[0]
    if n == 1
        items.pop()
        return top
    let last = items.pop()
    items[0] = last
    _km_sift_down(items, 0, len(items))
    return top

// _km_heap_size: number of entries in heap.
fn _km_heap_size(h)
    return len(h["items"])

// _km_make_entry: build an entry dict for integer merge.
fn _km_make_entry(val, li, ei)
    let e = {}
    e["val"] = val
    e["li"] = li
    e["ei"] = ei
    return e

// _km_make_pair_entry: build an entry dict for pair merge (val=key, pval=value).
fn _km_make_pair_entry(key, pval, li, ei)
    let e = {}
    e["val"] = key
    e["li"] = li
    e["ei"] = ei
    e["pval"] = pval
    return e

// kmerge: merge k sorted ascending int-lists into one sorted ascending list.
// kmerge([]) -> []; kmerge([[5]]) -> [5]; handles empty sublists gracefully.
fn kmerge(lists)
    let k = len(lists)
    let out = []
    if k == 0
        return out
    let h = _km_heap_new()
    // Seed: push first element of each non-empty list.
    let li = 0
    while li < k
        let lst = lists[li]
        if len(lst) > 0
            let e = _km_make_entry(lst[0], li, 0)
            _km_heap_push(h, e)
        li = li + 1
    // Extract min, then advance that list's pointer.
    let sz = _km_heap_size(h)
    while sz > 0
        let top = _km_heap_pop(h)
        out.push(top["val"])
        let next_li = top["li"]
        let next_ei = top["ei"] + 1
        let src = lists[next_li]
        if next_ei < len(src)
            let ne = _km_make_entry(src[next_ei], next_li, next_ei)
            _km_heap_push(h, ne)
        sz = _km_heap_size(h)
    return out

// kmerge_pairs: merge k sorted pair-lists by key (ascending).
// Each pair-list is a list of [key, val] two-element lists.
// Returns a flat merged list of [key, val] pairs in ascending key order.
fn kmerge_pairs(plists)
    let k = len(plists)
    let out = []
    if k == 0
        return out
    let h = _km_heap_new()
    // Seed: push first pair of each non-empty pair-list.
    let li = 0
    while li < k
        let lst = plists[li]
        if len(lst) > 0
            let pr = lst[0]
            let e = _km_make_pair_entry(pr[0], pr[1], li, 0)
            _km_heap_push(h, e)
        li = li + 1
    // Extract min-key entry, advance pointer.
    let sz = _km_heap_size(h)
    while sz > 0
        let top = _km_heap_pop(h)
        let pair = []
        pair.push(top["val"])
        pair.push(top["pval"])
        out.push(pair)
        let next_li = top["li"]
        let next_ei = top["ei"] + 1
        let src = plists[next_li]
        if next_ei < len(src)
            let pr2 = src[next_ei]
            let ne = _km_make_pair_entry(pr2[0], pr2[1], next_li, next_ei)
            _km_heap_push(h, ne)
        sz = _km_heap_size(h)
    return out

// kmerge_dedup: merge k sorted int-lists, removing duplicate values.
// Output is sorted ascending with each value appearing at most once.
fn kmerge_dedup(lists)
    let k = len(lists)
    let out = []
    if k == 0
        return out
    let h = _km_heap_new()
    // Seed: push first element of each non-empty list.
    let li = 0
    while li < k
        let lst = lists[li]
        if len(lst) > 0
            let e = _km_make_entry(lst[0], li, 0)
            _km_heap_push(h, e)
        li = li + 1
    let last_emitted = 0
    let have_last = 0
    let sz = _km_heap_size(h)
    while sz > 0
        let top = _km_heap_pop(h)
        let cur_val = top["val"]
        // Emit only if different from the last emitted value.
        if have_last == 0
            out.push(cur_val)
            last_emitted = cur_val
            have_last = 1
        else
            if cur_val != last_emitted
                out.push(cur_val)
                last_emitted = cur_val
        let next_li = top["li"]
        let next_ei = top["ei"] + 1
        let src = lists[next_li]
        if next_ei < len(src)
            let ne = _km_make_entry(src[next_ei], next_li, next_ei)
            _km_heap_push(h, ne)
        sz = _km_heap_size(h)
    return out
