// binary_lifting — LCA and k-th ancestor on a rooted tree via binary lifting.
//
// Preprocessing: O(n log n) time and space.
// Queries:       O(log n) per blt_lca / blt_kth_ancestor call.
//
// Representation (dict bl):
//   "n"     -> int           number of nodes
//   "LOG"   -> int           floor(log2(n))+1 — number of lifting levels
//   "depth" -> list[int]     depth[v] = depth of v (root = 0)
//   "anc"   -> list[list]    anc[k][v] = 2^k-th ancestor of v
//                            (-1 if that ancestor does not exist / above root)

// _blt_log(n) — floor(log2(n)) for n >= 1; returns 0 for n=1.
// LOG levels = _blt_log(n) + 1, covering ancestors up to 2^LOG - 1 >= n - 1.
fn _blt_log(n)
    let k = 0
    let v = n
    while v > 1
        v = v / 2
        k = k + 1
    return k

// blt_build(parent, root) — build binary-lifting table from a parent array.
// parent[root] should equal root (or any value — it is ignored at root).
// Returns the binary-lifting dict bl.
fn blt_build(parent, root)
    let n = len(parent)
    let LOG = _blt_log(n) + 1
    // Build depth array via BFS (iterative).
    let depth = []
    let i = 0
    while i < n
        depth.push(0)
        i = i + 1
    // Children adjacency list: build from parent array.
    let children = []
    let ci = 0
    while ci < n
        let tmp = []
        children.push(tmp)
        ci = ci + 1
    let j = 0
    while j < n
        if j != root
            let p = parent[j]
            children[p].push(j)
        j = j + 1
    // BFS from root to assign depths.
    let queue = []
    queue.push(root)
    let qi = 0
    while qi < len(queue)
        let v = queue[qi]
        qi = qi + 1
        let ch = children[v]
        let k = 0
        while k < len(ch)
            let c = ch[k]
            depth[c] = depth[v] + 1
            queue.push(c)
            k = k + 1
    // Build anc table: anc is a list of LOG lists, each of length n.
    // anc[0][v] = direct parent of v (or -1 for root).
    let anc = []
    let lv = 0
    while lv < LOG
        let row = []
        let ri = 0
        while ri < n
            row.push(-1)
            ri = ri + 1
        anc.push(row)
        lv = lv + 1
    // Level 0: direct parent.
    let v = 0
    while v < n
        if v == root
            anc[0][v] = -1
        else
            anc[0][v] = parent[v]
        v = v + 1
    // Levels 1..LOG-1: anc[k][v] = anc[k-1][anc[k-1][v]].
    let lk = 1
    while lk < LOG
        let vv = 0
        while vv < n
            let half = anc[lk - 1][vv]
            if half == -1
                anc[lk][vv] = -1
            else
                anc[lk][vv] = anc[lk - 1][half]
            vv = vv + 1
        lk = lk + 1
    let bl = {}
    bl["n"] = n
    bl["LOG"] = LOG
    bl["depth"] = depth
    bl["anc"] = anc
    return bl

// blt_depth(bl, node) — depth of node in the rooted tree (root = 0).
fn blt_depth(bl, node)
    let depth = bl["depth"]
    return depth[node]

// blt_kth_ancestor(bl, node, k) — k-th ancestor of node.
// Returns -1 if the k-th ancestor does not exist (goes above the root).
fn blt_kth_ancestor(bl, node, k)
    let LOG = bl["LOG"]
    let anc = bl["anc"]
    let cur = node
    let bit = 0
    while bit < LOG
        if cur == -1
            return -1
        // Test if bit 'bit' of k is set.
        let pw = 1
        let bi = 0
        while bi < bit
            pw = pw * 2
            bi = bi + 1
        let kbit = (k / pw) % 2
        if kbit == 1
            cur = anc[bit][cur]
        bit = bit + 1
    return cur

// blt_lca(bl, u, v) — lowest common ancestor of u and v.
fn blt_lca(bl, u, v)
    let LOG = bl["LOG"]
    let anc = bl["anc"]
    let depth = bl["depth"]
    let a = u
    let b = v
    // Bring both nodes to the same depth.
    if depth[a] < depth[b]
        let tmp = a
        a = b
        b = tmp
    // Now depth[a] >= depth[b]. Lift a up by diff.
    let diff = depth[a] - depth[b]
    let bit = 0
    while bit < LOG
        let pw = 1
        let bi = 0
        while bi < bit
            pw = pw * 2
            bi = bi + 1
        let dbit = (diff / pw) % 2
        if dbit == 1
            a = anc[bit][a]
        bit = bit + 1
    // If they meet, return.
    if a == b
        return a
    // Binary-lift both until their ancestors diverge.
    let lk = LOG - 1
    while lk >= 0
        let aa = anc[lk][a]
        let bb = anc[lk][b]
        if aa != bb
            a = aa
            b = bb
        lk = lk - 1
    // One more step up is the LCA.
    return anc[0][a]

// blt_distance(bl, u, v) — number of edges on the path between u and v.
fn blt_distance(bl, u, v)
    let depth = bl["depth"]
    let l = blt_lca(bl, u, v)
    return depth[u] + depth[v] - 2 * depth[l]
