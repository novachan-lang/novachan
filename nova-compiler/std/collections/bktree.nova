// ============================================================================
// NOVA Standard Library — std/collections/bktree
// ============================================================================
// BK-tree for fuzzy string matching by edit distance.
//
// A BK-tree (Burkhard-Keller tree) is a metric-space tree for discrete metrics.
// Each node stores a word and a dict mapping integer edit distances (as strings)
// to child nodes. Insertion and query both use the triangle inequality property
// of Levenshtein distance to prune the search space.
//
// Node shape: {"w": word, "children": {dist_str: node, ...}}
// Tree shape: {"root": null | node, "sz": int}
//
// Public API:
//   bk_new()              -> dict       create an empty BK-tree
//   bk_insert(t, word)                  insert a word into the tree
//   bk_size(t)            -> int        number of words stored
//   bk_query(t, word, maxdist) -> list  all words within edit distance maxdist (sorted)
//   bk_contains(t, word)  -> bool       exact match (edit distance 0)
//
// Dependencies: std/text/distance (d_levenshtein)
// ============================================================================

import std/text/distance

// ── Internal helpers ─────────────────────────────────────────────────────────

// _bkt_node: create a new BK-tree node for `word`
fn _bkt_node(word) -> dict
    let children = {}
    let node = {"w": word, "children": children}
    node

// _bkt_insert_node: recursively insert `word` into the subtree rooted at `node`
// Returns the (possibly mutated) node (same reference — dicts are reference values).
fn _bkt_insert_node(node, word) -> dict
    let d = d_levenshtein(node["w"], word)
    if d == 0
        // word already in tree — no duplicate insertion
        return node
    let dk = str(d)
    let children = node["children"]
    if contains(children, dk)
        _bkt_insert_node(children[dk], word)
    else
        let newnode = _bkt_node(word)
        children[dk] = newnode
    node

// _bkt_query_node: collect all words in the subtree rooted at `node` within
// edit distance `maxdist` of `word`, appending them to `results` list.
fn _bkt_query_node(node, word, maxdist, results) -> int
    let d = d_levenshtein(node["w"], word)
    if d <= maxdist
        results.push(node["w"])
    let children = node["children"]
    let ks = keys(children)
    let i = 0
    while i < len(ks)
        let dk = ks[i]
        let child_d = 0
        // parse dk back to int
        let parsed = 0
        let ci = 0
        while ci < len(dk)
            parsed = parsed * 10 + ord(dk[ci]) - 48
            ci = ci + 1
        child_d = parsed
        // Triangle inequality: the child subtree can only contain words within
        // edit distance maxdist of `word` if child_d is in [d - maxdist, d + maxdist].
        let lo = d - maxdist
        let hi = d + maxdist
        if child_d >= lo and child_d <= hi
            _bkt_query_node(children[dk], word, maxdist, results)
        i = i + 1
    0

// ── Public API ───────────────────────────────────────────────────────────────

// bk_new: create an empty BK-tree.
fn bk_new() -> dict
    let t = {"root": null, "sz": 0}
    t

// bk_insert: insert `word` into the BK-tree `t`.
// Duplicate words are silently ignored (the tree is a set).
fn bk_insert(t, word)
    if t["root"] == null
        let n = _bkt_node(word)
        t["root"] = n
        t["sz"] = t["sz"] + 1
    else
        let before = _bkt_count_node(t["root"])
        _bkt_insert_node(t["root"], word)
        let after = _bkt_count_node(t["root"])
        t["sz"] = after

// _bkt_count_node: count total nodes in a subtree (to track unique insertions).
fn _bkt_count_node(node) -> int
    let children = node["children"]
    let ks = keys(children)
    let total = 1
    let i = 0
    while i < len(ks)
        total = total + _bkt_count_node(children[ks[i]])
        i = i + 1
    total

// bk_size: return the number of unique words stored in the tree.
fn bk_size(t) -> int
    t["sz"]

// bk_query: return a sorted list of all words in the tree within edit distance
// `maxdist` of `word`. Uses BK-tree triangle-inequality pruning.
fn bk_query(t, word, maxdist) -> list
    let results = []
    if t["root"] != null
        _bkt_query_node(t["root"], word, maxdist, results)
    sort(results)
    results

// bk_contains: return true (1) iff `word` is exactly present in the tree.
fn bk_contains(t, word) -> int
    let r = bk_query(t, word, 0)
    if len(r) > 0
        return 1
    0

// ============================================================================
fn main()
    print("std/collections/bktree loaded")
