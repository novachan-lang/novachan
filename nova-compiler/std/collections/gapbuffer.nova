// ============================================================================
// NOVA Standard Library — std/collections/gapbuffer
// ============================================================================
// Gap buffer for text editing.
// The buffer is represented as a dict holding the current text as a flat
// string. All operations rebuild the string using slice(). Correctness is
// the primary goal.
//
// PUBLIC API
//   gap_new(s)               -> dict  (create buffer pre-populated with s)
//   gap_insert(g, pos, text)         (insert text at char position pos)
//   gap_delete(g, pos, n)            (delete n chars starting at pos)
//   gap_text(g)              -> string (full text content)
//   gap_length(g)            -> int    (number of characters)
//   gap_char_at(g, i)        -> string (single character at 0-based index i)
// ============================================================================

// gap_new: create a gap buffer pre-populated with string s.
fn gap_new(s)
    let g = {}
    g["text"] = s
    return g

// gap_clamp: clamp integer v to [lo, hi] (inclusive both ends).
fn gap_clamp(v, lo, hi)
    let result = v
    if v < lo
        result = lo
    if v > hi
        result = hi
    return result

// gap_insert: insert text at char position pos (0 = before first char).
// Positions beyond end are clamped to end.
fn gap_insert(g, pos, text)
    let cur = g["text"]
    let n = len(cur)
    let p = gap_clamp(pos, 0, n)
    let before = slice(cur, 0, p)
    let after = slice(cur, p, n)
    g["text"] = before + text + after

// gap_delete: delete n chars starting at pos.
// Clamps pos to [0, length) and n so it does not exceed available chars.
fn gap_delete(g, pos, n)
    let cur = g["text"]
    let total = len(cur)
    let p = gap_clamp(pos, 0, total)
    let avail = total - p
    let count = n
    if count > avail
        count = avail
    if count < 0
        count = 0
    let before = slice(cur, 0, p)
    let after = slice(cur, p + count, total)
    g["text"] = before + after

// gap_text: return the full text content of the buffer.
fn gap_text(g)
    return g["text"]

// gap_length: return the number of characters in the buffer.
fn gap_length(g)
    return len(g["text"])

// gap_char_at: return a single-character string at 0-based index i.
// Returns "" if i is out of range.
fn gap_char_at(g, i)
    let cur = g["text"]
    let n = len(cur)
    let result = ""
    if i >= 0
        if i < n
            result = slice(cur, i, i + 1)
    return result
