// ostree — Order-Statistic Tree: AVL BST augmented with subtree sizes.
//
// Supports O(log n) rank and select in addition to standard BST operations.
//
// Each node is a dict:
//   {"k": int, "h": int, "sz": int, "l": node|null, "r": node|null}
//   k  = key
//   h  = height (leaf = 1, null = 0)  — used for AVL balancing
//   sz = subtree size (including this node)
//   l  = left child
//   r  = right child
//
// The tree dict itself: {"root": node|null}
//
// Public API:
//   ost_new()              -> tree
//   ost_insert(t, k)       -> unit   (no-op if already present)
//   ost_contains(t, k)     -> int    (1 = true, 0 = false)
//   ost_select(t, i)       -> int    (0-indexed i-th smallest key)
//   ost_rank(t, k)         -> int    (number of elements strictly less than k)
//   ost_size(t)            -> int    (total number of elements)

// _ost_ht: height of a node, 0 for null.
fn _ost_ht(nd)
    if nd == null
        return 0
    return nd["h"]

// _ost_sz: subtree size of a node, 0 for null.
fn _ost_sz(nd)
    if nd == null
        return 0
    return nd["sz"]

// _ost_fix: recompute h and sz from children. Must be called after any
// structural change to nd's children.
fn _ost_fix(nd)
    let lh = _ost_ht(nd["l"])
    let rh = _ost_ht(nd["r"])
    let mx = lh
    if rh > lh
        mx = rh
    nd["h"] = mx + 1
    nd["sz"] = _ost_sz(nd["l"]) + _ost_sz(nd["r"]) + 1
    return 0

// _ost_bf: balance factor = height(left) - height(right).
fn _ost_bf(nd)
    return _ost_ht(nd["l"]) - _ost_ht(nd["r"])

// _ost_rot_right: right rotation around nd.
//   Before:  nd           After:  lc
//           /  \                 /  \
//          lc   R              LL   nd
//         /  \                     /  \
//        LL   LR                  LR   R
// Returns new subtree root.
fn _ost_rot_right(nd)
    let lc = nd["l"]
    let lr = lc["r"]
    lc["r"] = nd
    nd["l"] = lr
    _ost_fix(nd)
    _ost_fix(lc)
    return lc

// _ost_rot_left: left rotation around nd.
//   Before:  nd           After:  rc
//           /  \                 /  \
//          L   rc              nd   RR
//             /  \            /  \
//            RL   RR         L   RL
// Returns new subtree root.
fn _ost_rot_left(nd)
    let rc = nd["r"]
    let rl = rc["l"]
    rc["l"] = nd
    nd["r"] = rl
    _ost_fix(nd)
    _ost_fix(rc)
    return rc

// _ost_balance: apply AVL rotations if needed, then fix nd's h/sz.
// Returns the (possibly new) subtree root.
fn _ost_balance(nd)
    _ost_fix(nd)
    let bf = _ost_bf(nd)
    if bf > 1
        // Left-heavy
        let lc = nd["l"]
        if _ost_bf(lc) < 0
            // LR case: left child is right-heavy — double rotation
            nd["l"] = _ost_rot_left(lc)
        return _ost_rot_right(nd)
    if bf < -1
        // Right-heavy
        let rc = nd["r"]
        if _ost_bf(rc) > 0
            // RL case: right child is left-heavy — double rotation
            nd["r"] = _ost_rot_right(rc)
        return _ost_rot_left(nd)
    return nd

// _ost_insert: recursive insert into subtree rooted at nd.
// Returns the (possibly new) subtree root.
fn _ost_insert(nd, key)
    if nd == null
        let node = {}
        node["k"] = key
        node["h"] = 1
        node["sz"] = 1
        node["l"] = null
        node["r"] = null
        return node
    let nk = nd["k"]
    if key < nk
        nd["l"] = _ost_insert(nd["l"], key)
    else
        if key > nk
            nd["r"] = _ost_insert(nd["r"], key)
        // key == nk: duplicate, no-op
    return _ost_balance(nd)

// _ost_contains: search subtree for key. Returns 1 if found, 0 if not.
fn _ost_contains(nd, key)
    if nd == null
        return 0
    let nk = nd["k"]
    if key == nk
        return 1
    if key < nk
        return _ost_contains(nd["l"], key)
    return _ost_contains(nd["r"], key)

// _ost_select: return the i-th smallest key (0-indexed) in subtree nd.
// Precondition: 0 <= i < _ost_sz(nd).
fn _ost_select(nd, i)
    let ls = _ost_sz(nd["l"])
    if i < ls
        return _ost_select(nd["l"], i)
    if i == ls
        return nd["k"]
    return _ost_select(nd["r"], i - ls - 1)

// _ost_rank: return number of keys strictly less than key in subtree nd.
fn _ost_rank(nd, key)
    if nd == null
        return 0
    let nk = nd["k"]
    if key <= nk
        return _ost_rank(nd["l"], key)
    // key > nk: all of left subtree + this node + those in right subtree < key
    return _ost_sz(nd["l"]) + 1 + _ost_rank(nd["r"], key)

// ost_new: create a new empty order-statistic tree.
fn ost_new()
    let t = {}
    t["root"] = null
    return t

// ost_insert: insert key k into the tree. No-op if already present.
fn ost_insert(t, k)
    if _ost_contains(t["root"], k) == 1
        return 0
    t["root"] = _ost_insert(t["root"], k)
    return 0

// ost_contains: return 1 if k is in the tree, 0 otherwise.
fn ost_contains(t, k)
    return _ost_contains(t["root"], k)

// ost_select: return the i-th smallest key (0-indexed).
// Precondition: 0 <= i < ost_size(t).
fn ost_select(t, i)
    return _ost_select(t["root"], i)

// ost_rank: return the number of elements strictly less than k.
fn ost_rank(t, k)
    return _ost_rank(t["root"], k)

// ost_size: return the total number of elements in the tree.
fn ost_size(t)
    return _ost_sz(t["root"])
