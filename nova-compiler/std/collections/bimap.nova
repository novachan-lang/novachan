// bimap — bidirectional string<->string map for NOVA.
//
// Each key maps to exactly one value and each value maps to exactly one key.
// Setting a key to a new value automatically removes the old reverse mapping,
// and if another key already held that value it is evicted as well (one-to-one
// invariant is enforced on every write).
//
// Representation (a plain NOVA dict):
//   "fwd" -> dict  (key -> value)
//   "rev" -> dict  (value -> key)
//
// Public API
//   bm_new()           -> bimap
//   bm_set(bm, k, v)   -> unit  (enforces bijection; cleans stale entries)
//   bm_get(bm, k)      -> value string ("" if absent)
//   bm_get_key(bm, v)  -> key string   ("" if absent)
//   bm_has_key(bm, k)  -> 1 if present, 0 otherwise
//   bm_has_value(bm,v) -> 1 if present, 0 otherwise
//   bm_del_key(bm, k)  -> unit  (removes k and its reverse entry; no-op if absent)
//   bm_len(bm)         -> number of key->value pairs

fn bm_new()
    let bm = {}
    bm["fwd"] = {}
    bm["rev"] = {}
    return bm

// bm_set: insert k->v with full bijection maintenance.
//   1. If k already has an old value, remove the reverse entry for that old value.
//   2. If v is already held by a different key, remove that key's forward entry.
//   3. Write the new k->v and v->k entries.
fn bm_set(bm, k, v)
    let fwd = bm["fwd"]
    let rev = bm["rev"]
    if contains(fwd, k)
        let old_v = fwd[k]
        if contains(rev, old_v)
            del(rev, old_v)
    if contains(rev, v)
        let old_k = rev[v]
        if contains(fwd, old_k)
            del(fwd, old_k)
    fwd[k] = v
    rev[v] = k

// bm_get: return the value mapped to k, or "" if absent.
fn bm_get(bm, k)
    let fwd = bm["fwd"]
    if contains(fwd, k)
        return fwd[k]
    return ""

// bm_get_key: return the key that maps to v, or "" if absent.
fn bm_get_key(bm, v)
    let rev = bm["rev"]
    if contains(rev, v)
        return rev[v]
    return ""

// bm_has_key: 1 if k is present in the forward map, 0 otherwise.
fn bm_has_key(bm, k)
    let fwd = bm["fwd"]
    if contains(fwd, k)
        return 1
    return 0

// bm_has_value: 1 if v is present in the reverse map, 0 otherwise.
fn bm_has_value(bm, v)
    let rev = bm["rev"]
    if contains(rev, v)
        return 1
    return 0

// bm_del_key: remove k and its paired value entry; no-op if absent.
fn bm_del_key(bm, k)
    let fwd = bm["fwd"]
    let rev = bm["rev"]
    if contains(fwd, k)
        let v = fwd[k]
        del(fwd, k)
        if contains(rev, v)
            del(rev, v)

// bm_len: number of key->value pairs (fwd and rev always have the same count).
fn bm_len(bm)
    let fwd = bm["fwd"]
    return len(fwd)
