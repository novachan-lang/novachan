// heapsort — in-place heapsort variants for lists of ints.
//
// All variants use a MAX-heap internally, which enables in-place ascending sort
// by heapifying the whole array and then iteratively extracting the max to the
// back (classic Williams/Floyd heapsort; O(n log n), O(1) extra space).
//
// Public API
//   heapsort_asc(list)      -> list  (new list, ascending)
//   heapsort_desc(list)     -> list  (new list, descending)
//   heapsort_inplace(list)  -> unit  (mutates argument, ascending)
//   heapsort_by_key(pairs)  -> list  (pairs = [[key,val],...]; sort by key asc)

// _hs_swap: swap a[i] and a[j] in-place.
fn _hs_swap(a, i, j)
    let tmp = a[i]
    a[i] = a[j]
    a[j] = tmp

// _hs_sift_down: restore max-heap property at index i within [0, n).
// The element at i is sifted down until both children are smaller.
fn _hs_sift_down(a, i, n)
    let done = 0
    while done == 0
        let largest = i
        let left = 2 * i + 1
        let right = 2 * i + 2
        if left < n
            if a[left] > a[largest]
                largest = left
        if right < n
            if a[right] > a[largest]
                largest = right
        if largest == i
            done = 1
        else
            _hs_swap(a, i, largest)
            i = largest

// _hs_build_max_heap: Floyd's O(n) heapify on a (mutates in-place).
fn _hs_build_max_heap(a, n)
    let start = n / 2 - 1
    let i = start
    while i >= 0
        _hs_sift_down(a, i, n)
        i = i - 1

// _hs_copy: shallow copy of list lst into a new list.
fn _hs_copy(lst)
    let out = []
    let i = 0
    let n = len(lst)
    while i < n
        out.push(lst[i])
        i = i + 1
    return out

// heapsort_inplace: sort list a ascending in-place using max-heap.
// Returns nothing (unit). The list is mutated directly.
fn heapsort_inplace(a)
    let n = len(a)
    if n < 2
        return null
    _hs_build_max_heap(a, n)
    let i = n - 1
    while i > 0
        _hs_swap(a, 0, i)
        _hs_sift_down(a, 0, i)
        i = i - 1

// heapsort_asc: return a new list with elements of lst sorted ascending.
// lst is not modified.
fn heapsort_asc(lst)
    let a = _hs_copy(lst)
    heapsort_inplace(a)
    return a

// heapsort_desc: return a new list with elements of lst sorted descending.
// Builds ascending then reverses in-place.
fn heapsort_desc(lst)
    let a = _hs_copy(lst)
    heapsort_inplace(a)
    // reverse a in-place
    let lo = 0
    let hi = len(a) - 1
    while lo < hi
        _hs_swap(a, lo, hi)
        lo = lo + 1
        hi = hi - 1
    return a

// _hs_sift_down_pairs: max-heap sift-down for list of [key,val] pairs,
// comparing by key (integer) at index 0. Operates within [0, n).
fn _hs_sift_down_pairs(a, i, n)
    let done = 0
    while done == 0
        let largest = i
        let left = 2 * i + 1
        let right = 2 * i + 2
        if left < n
            let lp = a[left]
            let cp = a[largest]
            if lp[0] > cp[0]
                largest = left
        if right < n
            let rp = a[right]
            let cp2 = a[largest]
            if rp[0] > cp2[0]
                largest = right
        if largest == i
            done = 1
        else
            _hs_swap(a, i, largest)
            i = largest

// heapsort_by_key: sort a list of [key,val] pairs by key ascending.
// Returns a new sorted list of pairs; input is not modified.
fn heapsort_by_key(pairs)
    let a = _hs_copy(pairs)
    let n = len(a)
    if n < 2
        return a
    // Build max-heap by key
    let start = n / 2 - 1
    let i = start
    while i >= 0
        _hs_sift_down_pairs(a, i, n)
        i = i - 1
    // Extract max repeatedly to sort ascending
    let j = n - 1
    while j > 0
        _hs_swap(a, 0, j)
        _hs_sift_down_pairs(a, 0, j)
        j = j - 1
    return a
