// rangemap — map from disjoint integer ranges to values for NOVA.
//
// Stores a sequence of [lo, hi, value] entries (insertion order).
// When multiple ranges overlap at a queried point, the LAST inserted
// range wins (later rm_set calls take precedence).
//
// Public API
//   rm_new()                  -> rangemap (a dict with internal "ranges" list)
//   rm_set(m, lo, hi, value)  -> unit  (append range [lo..hi] inclusive -> value)
//   rm_get(m, x, dflt)        -> value (last range containing x, else dflt)
//   rm_contains(m, x)         -> int   (1 if any range contains x, else 0)
//   rm_ranges(m)              -> list  (insertion-order list of [lo, hi, value] triples)
//
// Private helpers prefixed _rm_

fn rm_new()
    let m = {}
    let lst = []
    m["ranges"] = lst
    return m

fn rm_set(m, lo, hi, value)
    let ranges = m["ranges"]
    let entry = []
    entry.push(lo)
    entry.push(hi)
    entry.push(value)
    ranges.push(entry)

// rm_get: scan all ranges; last match wins (latest rm_set takes precedence)
fn rm_get(m, x, dflt)
    let ranges = m["ranges"]
    let n = len(ranges)
    let result = dflt
    let found = 0
    for i in 0..n
        let entry = ranges[i]
        let lo = entry[0]
        let hi = entry[1]
        if x >= lo and x <= hi
            result = entry[2]
            found = 1
    if found == 1
        return result
    return dflt

fn rm_contains(m, x)
    let ranges = m["ranges"]
    let n = len(ranges)
    for i in 0..n
        let entry = ranges[i]
        let lo = entry[0]
        let hi = entry[1]
        if x >= lo and x <= hi
            return 1
    return 0

fn rm_ranges(m)
    return m["ranges"]
