// intervaltree — interval set with overlap queries.
//
// Representation (a plain NOVA dict):
//   t["ivs"] -> list of [lo, hi] pairs (unsorted; inserted in order)
//   t["n"]   -> int count of intervals stored
//
// Closed intervals: a point x is IN [lo,hi] when lo <= x <= hi.
//
// Public API
//   it_new()                  -> interval-tree dict
//   it_insert(t, lo, hi)      -> unit (insert closed interval [lo,hi])
//   it_contains_point(t, x)   -> bool (1 if any interval covers x, else 0)
//   it_overlaps(t, lo, hi)    -> bool (1 if any stored interval overlaps [lo,hi], else 0)
//   it_query_point(t, x)      -> list of [lo,hi] pairs covering x
//   it_size(t)                -> int  (number of intervals stored)
//   it_merge_overlapping(t)   -> list of merged [lo,hi] (sorted, disjoint)

// ---- helpers ----------------------------------------------------------------

// _it_sort_pairs: insertion-sort a list of [lo,hi] pairs by lo ascending.
// Returns a NEW sorted list (does not mutate the input).
fn _it_sort_pairs(pairs)
    let n = len(pairs)
    let out = []
    for i in 0..n
        out.push(pairs[i])
    // insertion sort by pair[0] (lo)
    for j in 1..n
        let key = out[j]
        let klo = key[0]
        // shift elements that are greater than klo one position to the right
        let k = j - 1
        let pos = 0
        let searching = 1
        while searching == 1
            if k >= 0
                let cur = out[k]
                if cur[0] > klo
                    out[k + 1] = cur
                    k -= 1
                else
                    pos = k + 1
                    searching = 0
            else
                pos = 0
                searching = 0
        out[pos] = key
    return out

// ---- public API -------------------------------------------------------------

fn it_new()
    let t = {}
    t["ivs"] = []
    t["n"] = 0
    return t

// it_insert: append the closed interval [lo, hi] to the set.
fn it_insert(t, lo, hi)
    let pair = [lo, hi]
    t["ivs"].push(pair)
    t["n"] = t["n"] + 1

// it_contains_point: 1 if any interval covers x (lo <= x <= hi), else 0.
fn it_contains_point(t, x)
    let ivs = t["ivs"]
    let n = t["n"]
    for i in 0..n
        let iv = ivs[i]
        if iv[0] <= x
            if x <= iv[1]
                return 1
    return 0

// it_overlaps: 1 if any stored interval overlaps the query [lo,hi].
// Two closed intervals [a,b] and [c,d] overlap iff a <= d AND c <= b.
fn it_overlaps(t, lo, hi)
    let ivs = t["ivs"]
    let n = t["n"]
    for i in 0..n
        let iv = ivs[i]
        if iv[0] <= hi
            if lo <= iv[1]
                return 1
    return 0

// it_query_point: return all [lo,hi] pairs whose interval covers x.
fn it_query_point(t, x)
    let ivs = t["ivs"]
    let n = t["n"]
    let out = []
    for i in 0..n
        let iv = ivs[i]
        if iv[0] <= x
            if x <= iv[1]
                out.push(iv)
    return out

// it_size: number of intervals stored (duplicates counted separately).
fn it_size(t)
    return t["n"]

// it_merge_overlapping: merge all overlapping/touching intervals and return
// a sorted, disjoint list of [lo, hi] pairs.
// Algorithm: sort by lo, then sweep and merge when current lo <= last hi.
fn it_merge_overlapping(t)
    let n = t["n"]
    if n == 0
        return []
    let sorted = _it_sort_pairs(t["ivs"])
    let out = []
    let first = sorted[0]
    let cur_lo = first[0]
    let cur_hi = first[1]
    for i in 1..n
        let iv = sorted[i]
        let ilo = iv[0]
        let ihi = iv[1]
        if ilo <= cur_hi
            // overlapping or touching — extend the current merged interval
            if ihi > cur_hi
                cur_hi = ihi
        else
            // gap — flush the current merged interval and start a new one
            let merged = [cur_lo, cur_hi]
            out.push(merged)
            cur_lo = ilo
            cur_hi = ihi
    // flush last
    let last = [cur_lo, cur_hi]
    out.push(last)
    return out
