// fenwickrange — Fenwick tree with RANGE-UPDATE and POINT-QUERY.
//
// Uses the difference-array trick:
//   range_add(lo, hi, delta)  -> update BIT at lo with +delta, at hi+1 with -delta
//   point_query(i)            -> prefix_sum(BIT, i)
//
// Both operations run in O(log n).
//
// Representation: a dict with keys:
//   "b" -> list of ints (length n+2; index 0 unused; indices 1..n+1 are live)
//   "n" -> int (logical size, 1-indexed positions 1..n)
//
// Prefix: fwr_

// _fwr_update — internal: add delta to BIT position i and propagate upward.
fn _fwr_update(b, n1, i, delta)
    while i <= n1
        b[i] = b[i] + delta
        let lsb = i & (0 - i)
        i += lsb

// _fwr_prefix — internal: prefix sum of BIT positions 1..i.
fn _fwr_prefix(b, i)
    let s = 0
    while i > 0
        s += b[i]
        let lsb = i & (0 - i)
        i -= lsb
    return s

// fwr_new(n) -> a new range-update/point-query Fenwick tree over n elements.
// All values initialised to zero.  Positions are 1-indexed (1..n).
fn fwr_new(n)
    let b = []
    let i = 0
    // allocate n+2 slots: index 0 unused; indices 1..n are user positions;
    // index n+1 is the sentinel used by range_add when hi==n.
    let cap = n + 2
    while i < cap
        b.push(0)
        i += 1
    let t = {}
    t["b"] = b
    t["n"] = n
    return t

// fwr_range_add(t, lo, hi, delta) — add delta to every position lo..hi inclusive.
// lo and hi are 1-indexed and must satisfy 1 <= lo <= hi <= fwr_size(t).
fn fwr_range_add(t, lo, hi, delta)
    let b = t["b"]
    let n = t["n"]
    _fwr_update(b, n + 1, lo, delta)
    _fwr_update(b, n + 1, hi + 1, 0 - delta)

// fwr_point_query(t, i) -> current value at 1-indexed position i.
fn fwr_point_query(t, i)
    let b = t["b"]
    return _fwr_prefix(b, i)

// fwr_size(t) -> logical size n of the tree.
fn fwr_size(t)
    return t["n"]
