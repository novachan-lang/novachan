// disjointinterval — disjoint interval set with automatic merging (inclusive integer intervals).
//
// Representation (a plain NOVA dict):
//   s["iv"] -> flat list [lo0, hi0, lo1, hi1, ...]
//              intervals kept sorted by lo, always disjoint and maximally merged.
//
// Public API
//   dvl_new()                -> dict
//   dvl_add(s, lo, hi)       -> unit  (insert [lo,hi], merging overlapping/adjacent)
//   dvl_contains(s, x)       -> 1 if x is covered, else 0
//   dvl_intervals(s)         -> list of [lo, hi] (sorted, disjoint, merged)
//   dvl_total_length(s)      -> int (sum of hi-lo+1 across all intervals)
//   dvl_count(s)             -> int (number of disjoint intervals)

// ---- private helpers --------------------------------------------------------

// _dvl_n: number of intervals (flat list length / 2)
fn _dvl_n(iv)
    return len(iv) / 2

// _dvl_lo: lo of the i-th interval in the flat list
fn _dvl_lo(iv, i)
    return iv[i * 2]

// _dvl_hi: hi of the i-th interval in the flat list
fn _dvl_hi(iv, i)
    return iv[i * 2 + 1]

// _dvl_build: reconstruct a flat list from parallel lo[] and hi[] arrays
fn _dvl_build(los, his)
    let n = len(los)
    let out = []
    for k in 0..n
        let kk = k
        out.push(los[kk])
        out.push(his[kk])
    return out

// ---- public API -------------------------------------------------------------

fn dvl_new()
    let s = {}
    s["iv"] = []
    return s

// dvl_add: insert [lo, hi], merging all intervals that overlap with [lo,hi].
// Two intervals [a,b] and [c,d] overlap when a <= d AND c <= b (inclusive).
// Adjacent but non-overlapping intervals (e.g. [1,4] and [5,7]) are kept separate.
fn dvl_add(s, lo, hi)
    let iv = s["iv"]
    let n = _dvl_n(iv)
    let mlo = lo
    let mhi = hi
    let keep_lo = []
    let keep_hi = []
    for k in 0..n
        let kk = k
        let elo = _dvl_lo(iv, kk)
        let ehi = _dvl_hi(iv, kk)
        // Overlap condition: elo <= mhi AND ehi >= mlo
        if elo <= mhi and ehi >= mlo
            if elo < mlo
                mlo = elo
            if ehi > mhi
                mhi = ehi
        else
            keep_lo.push(elo)
            keep_hi.push(ehi)
    // insert merged interval at correct sorted position
    let out_lo = []
    let out_hi = []
    let inserted = 0
    let j = 0
    let kn = len(keep_lo)
    while j < kn
        let jj = j
        if inserted == 0 and keep_lo[jj] > mlo
            out_lo.push(mlo)
            out_hi.push(mhi)
            inserted = 1
        out_lo.push(keep_lo[jj])
        out_hi.push(keep_hi[jj])
        j = j + 1
    if inserted == 0
        out_lo.push(mlo)
        out_hi.push(mhi)
    s["iv"] = _dvl_build(out_lo, out_hi)

// dvl_contains: 1 if x lies in any stored interval, 0 otherwise.
// Intervals are sorted so we can short-circuit when elo > x.
fn dvl_contains(s, x)
    let iv = s["iv"]
    let n = _dvl_n(iv)
    let k = 0
    let found = 0
    let done = 0
    while k < n and done == 0
        let kk = k
        let elo = _dvl_lo(iv, kk)
        let ehi = _dvl_hi(iv, kk)
        if elo > x
            done = 1
        else
            if x <= ehi
                found = 1
                done = 1
        k = k + 1
    return found

// dvl_intervals: list of [lo, hi] pairs, sorted ascending, disjoint.
fn dvl_intervals(s)
    let iv = s["iv"]
    let n = _dvl_n(iv)
    let out = []
    for k in 0..n
        let kk = k
        let pair = [_dvl_lo(iv, kk), _dvl_hi(iv, kk)]
        out.push(pair)
    return out

// dvl_total_length: sum of (hi-lo+1) across all intervals.
fn dvl_total_length(s)
    let iv = s["iv"]
    let n = _dvl_n(iv)
    let total = 0
    for k in 0..n
        let kk = k
        total = total + (_dvl_hi(iv, kk) - _dvl_lo(iv, kk) + 1)
    return total

// dvl_count: number of disjoint intervals currently stored.
fn dvl_count(s)
    let iv = s["iv"]
    return _dvl_n(iv)
