// triemap — Trie-based map from string keys to arbitrary values.
//
// Each node is a dict:
//   "children"  -> dict (single-character string -> child node dict)
//   "value"     -> the stored value at this node (meaningful only if has_value==1)
//   "has_value" -> int (1 if a value has been inserted ending at this node, else 0)
//
// Public API
//   tm_new()                  -> dict  (empty trie map: its root node)
//   tm_insert(t, key, val)    -> dict  (insert/overwrite key -> val; returns t)
//   tm_lookup(t, key)         -> any   (stored value, or 0 if key absent)
//   tm_contains(t, key)       -> int   (1 if key present, 0 otherwise)
//   tm_delete(t, key)         -> dict  (remove key if present; returns t)
//   tm_keys(t)                -> list  (all keys, sorted ascending)
//   tm_prefix_keys(t, prefix) -> list  (all keys starting with prefix, sorted ascending)

// _tm_node: create a fresh empty trie node.
fn _tm_node()
    let node = {}
    node["children"] = {}
    node["value"] = 0
    node["has_value"] = 0
    return node

// tm_new: create a new empty trie map (its root node).
fn tm_new()
    return _tm_node()

// tm_insert: insert key -> val, creating intermediate nodes as needed.
fn tm_insert(t, key, val)
    let node = t
    let i = 0
    let n = len(key)
    while i < n
        let ch = char_at(key, i)
        let children = node["children"]
        if not contains(children, ch)
            children[ch] = _tm_node()
        node = children[ch]
        i = i + 1
    node["value"] = val
    node["has_value"] = 1
    return t

// _tm_walk: follow key from node t, returning the terminal node or null if the
// path breaks before key is exhausted.
fn _tm_walk(t, key)
    let node = t
    let i = 0
    let n = len(key)
    while i < n
        let children = node["children"]
        let ch = char_at(key, i)
        if not contains(children, ch)
            return null
        node = children[ch]
        i = i + 1
    return node

// tm_lookup: return the value stored at key, or 0 if absent.
fn tm_lookup(t, key)
    let node = _tm_walk(t, key)
    if node == null
        return 0
    if node["has_value"] == 0
        return 0
    return node["value"]

// tm_contains: return 1 if key is present, 0 otherwise.
fn tm_contains(t, key)
    let node = _tm_walk(t, key)
    if node == null
        return 0
    return node["has_value"]

// tm_delete: remove key if present. Only clears the has_value flag — the path
// structure is left in place, so a later insert along the same prefix simply
// reuses the existing nodes (no dangling-pointer risk, at the cost of not
// reclaiming now-dead branches; acceptable for a map-sized-for-its-workload).
fn tm_delete(t, key)
    let node = _tm_walk(t, key)
    if node != null
        node["has_value"] = 0
        node["value"] = 0
    return t

// _tm_collect: DFS from node, appending every stored key (prefix so far) to out.
// Children are visited in sorted character order so results come out already
// sorted (single-character keys sort the same whether compared as chars or
// as one-character strings).
fn _tm_collect(node, prefix, out)
    if node["has_value"] == 1
        out.push(prefix)
    let children = node["children"]
    let chs = sort(keys(children))
    let i = 0
    while i < len(chs)
        let ch = chs[i]
        _tm_collect(children[ch], prefix + ch, out)
        i = i + 1

// tm_keys: return all stored keys, sorted ascending.
fn tm_keys(t)
    let out = []
    _tm_collect(t, "", out)
    return out

// tm_prefix_keys: return all stored keys that start with prefix, sorted ascending.
// Returns [] if no key has this prefix (including when the prefix path itself
// doesn't exist in the trie).
fn tm_prefix_keys(t, prefix)
    let node = _tm_walk(t, prefix)
    let out = []
    if node == null
        return out
    _tm_collect(node, prefix, out)
    return out
