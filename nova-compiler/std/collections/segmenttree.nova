// segmenttree — Segment tree for range queries with point updates.
//
// Representation: a dict with keys:
//   "n"    -> int  (logical size = number of elements)
//   "p"    -> int  (next power-of-two >= n; tree offset)
//   "op"   -> str  ("sum", "min", or "max")
//   "vals" -> list of ints (original values, 0-indexed, length n)
//   "tree" -> list of ints (1-indexed tree, length 2*p; index 0 unused)
//
// Leaf i (0-based) lives at tree index p+i.
// Internal node k has children 2k and 2k+1.
// All operations are O(log n).

// _st_next_pow2(n) — smallest power of two >= n.
fn _st_next_pow2(n)
    let p = 1
    while p < n
        p = p * 2
    return p

// _st_combine(op, a, b) — fold two values under the given operation.
fn _st_combine(op, a, b)
    if op == "sum"
        return a + b
    if op == "min"
        if a < b
            return a
        return b
    // "max"
    if a > b
        return a
    return b

// _st_identity(op) — identity element for the operation.
fn _st_identity(op)
    if op == "sum"
        return 0
    if op == "min"
        // large sentinel
        return 1073741824
    // "max"
    return 0 - 1073741824

// st_build(values, op) -> dict
// Build a segment tree over 'values' (a list of ints) for operation op.
// op must be one of: "sum", "min", "max".
fn st_build(values, op)
    let n = len(values)
    let p = _st_next_pow2(n)
    let size = p * 2
    let id = _st_identity(op)
    // Allocate tree: 2*p slots, index 0 unused (1-indexed).
    let tree = []
    for k in 0..size
        tree.push(id)
    // Copy leaves into positions p..p+n-1
    let i = 0
    while i < n
        tree[p + i] = values[i]
        i += 1
    // Build internal nodes bottom-up: from p-1 down to 1
    let j = p - 1
    while j >= 1
        tree[j] = _st_combine(op, tree[j * 2], tree[j * 2 + 1])
        j -= 1
    // Copy original values for point-query reference
    let vals = []
    for vi in 0..n
        vals.push(values[vi])
    let st = {}
    st["n"] = n
    st["p"] = p
    st["op"] = op
    st["vals"] = vals
    st["tree"] = tree
    return st

// st_query(st, l, r) -> int
// Inclusive 0-based range [l, r] fold.
// Uses iterative bottom-up accumulation on the 1-indexed tree.
fn st_query(st, l, r)
    let p = st["p"]
    let tree = st["tree"]
    let op = st["op"]
    let id = _st_identity(op)
    // Convert to 1-indexed leaf positions; r is inclusive so r+1 is exclusive end.
    let lo = l + p
    let hi = r + p + 1
    let res_l = id
    let res_r = id
    while lo < hi
        // If lo is a right child (odd), include it and move right
        if lo & 1 == 1
            res_l = _st_combine(op, res_l, tree[lo])
            lo += 1
        // If hi is a right child (odd), include hi-1 from the right
        if hi & 1 == 1
            hi -= 1
            res_r = _st_combine(op, tree[hi], res_r)
        lo = lo / 2
        hi = hi / 2
    return _st_combine(op, res_l, res_r)

// st_update(st, i, val)
// Point update: set index i (0-based) to val and refresh ancestors.
fn st_update(st, i, val)
    let p = st["p"]
    let tree = st["tree"]
    let op = st["op"]
    let vals = st["vals"]
    // Update original-values snapshot
    vals[i] = val
    // Set leaf
    let pos = i + p
    tree[pos] = val
    // Propagate up
    pos = pos / 2
    while pos >= 1
        tree[pos] = _st_combine(op, tree[pos * 2], tree[pos * 2 + 1])
        if pos == 1
            pos = 0
        else
            pos = pos / 2
