// heapmedian — running median via two sorted lists acting as heaps.
//
// Representation (a plain NOVA dict):
//   "lower" -> list  (sorted ascending; the MAX element is at the end = max-heap of lower half)
//   "upper" -> list  (sorted ascending; the MIN element is at the front = min-heap of upper half)
//   "count" -> int
//
// Invariant: len(lower) == len(upper) OR len(lower) == len(upper) + 1
//   i.e. lower holds the same number or one more element than upper.
//
// Public API
//   hmd_new()       -> dict
//   hmd_add(h, v)   -> unit  (v is an int or float)
//   hmd_median(h)   -> float (average of two middles for even count)
//   hmd_count(h)    -> int

// hmd_new: create an empty running-median tracker.
fn hmd_new()
    let h = {}
    h["lower"] = []
    h["upper"] = []
    h["count"] = 0
    return h

// hmd_lower_insert: insert v into lower (sorted ascending) using binary search.
fn hmd_lower_insert(lower, v)
    let lo = 0
    let hi = len(lower)
    let done = 0
    while done == 0
        if lo >= hi
            done = 1
        else
            let mid = (lo + hi) / 2
            let mv = lower[mid] * 1.0
            let fv = v * 1.0
            if mv < fv
                lo = mid + 1
            else
                hi = mid
    insert(lower, lo, v)

// hmd_upper_insert: insert v into upper (sorted ascending) using binary search.
fn hmd_upper_insert(upper, v)
    let lo = 0
    let hi = len(upper)
    let done = 0
    while done == 0
        if lo >= hi
            done = 1
        else
            let mid = (lo + hi) / 2
            let mv = upper[mid] * 1.0
            let fv = v * 1.0
            if mv < fv
                lo = mid + 1
            else
                hi = mid
    insert(upper, lo, v)

// hmd_add: add a value to the running median structure.
fn hmd_add(h, v)
    let lower = h["lower"]
    let upper = h["upper"]
    let nl = len(lower)
    let nu = len(upper)
    // Decide which side v goes on.
    // v goes to lower if lower is empty OR v <= lower_max.
    let goes_lower = 0
    if nl == 0
        goes_lower = 1
    else
        let lower_max = lower[nl - 1] * 1.0
        let fv = v * 1.0
        if fv <= lower_max
            goes_lower = 1
    if goes_lower == 1
        hmd_lower_insert(lower, v)
    else
        hmd_upper_insert(upper, v)
    // Rebalance: ensure len(lower) == len(upper) or len(lower) == len(upper) + 1
    let nl2 = len(lower)
    let nu2 = len(upper)
    if nl2 > nu2 + 1
        // lower has too many: move lower_max to upper
        let lmax = lower[nl2 - 1]
        pop(lower)
        hmd_upper_insert(upper, lmax)
    else
        if nu2 > nl2
            // upper has too many: move upper_min to lower
            let umin = upper[0]
            let new_upper = []
            for i in 1..nu2
                new_upper.push(upper[i])
            h["upper"] = new_upper
            hmd_lower_insert(lower, umin)
    h["count"] = h["count"] + 1

// hmd_median: return the current median as a float.
//   Odd count  -> max of lower half (lower[len-1])
//   Even count -> average of lower_max and upper_min
fn hmd_median(h)
    let lower = h["lower"]
    let upper = h["upper"]
    let nl = len(lower)
    let nu = len(upper)
    let result = 0.0
    if nl > nu
        // odd: median is top of lower
        result = lower[nl - 1] * 1.0
    else
        // even: average of lower_max and upper_min
        let lv = lower[nl - 1] * 1.0
        let uv = upper[0] * 1.0
        result = (lv + uv) / 2.0
    return result

// hmd_count: return total number of values added.
fn hmd_count(h)
    return h["count"]
