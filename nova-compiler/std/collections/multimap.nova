// multimap — string key -> list-of-values multi-map for NOVA.
//
// A key can hold any number of associated values (stored as a list).
// The multimap itself is a plain NOVA dict:
//   "data" -> dict  (string key -> list of values)
//
// Public API
//   mm_new()              -> multimap
//   mm_add(mm, k, v)      -> unit  (append v to key's list; create list if absent)
//   mm_get(mm, k)         -> list  (empty list if key absent)
//   mm_get_first(mm, k)   -> value (first element; null if key absent or empty)
//   mm_has(mm, k)         -> bool  (1 if key has at least one value, 0 otherwise)
//   mm_count(mm, k)       -> int   (number of values for key; 0 if absent)
//   mm_keys(mm)           -> list  (all keys that have at least one value)
//   mm_total(mm)          -> int   (total number of values across all keys)
//   mm_remove_key(mm, k)  -> unit  (remove key and all its values; no-op if absent)

fn mm_new()
    let mm = {}
    mm["data"] = {}
    return mm

fn mm_add(mm, k, v)
    let data = mm["data"]
    if contains(data, k)
        let lst = data[k]
        lst.push(v)
    else
        let lst = []
        lst.push(v)
        data[k] = lst

fn mm_get(mm, k)
    let data = mm["data"]
    if contains(data, k)
        return data[k]
    return []

fn mm_get_first(mm, k)
    let data = mm["data"]
    if contains(data, k)
        let lst = data[k]
        if len(lst) > 0
            return lst[0]
    return null

fn mm_has(mm, k)
    let data = mm["data"]
    if contains(data, k)
        let lst = data[k]
        if len(lst) > 0
            return 1
    return 0

fn mm_count(mm, k)
    let data = mm["data"]
    if contains(data, k)
        return len(data[k])
    return 0

fn mm_keys(mm)
    let data = mm["data"]
    return keys(data)

fn mm_total(mm)
    let data = mm["data"]
    let ks = keys(data)
    let total = 0
    let i = 0
    while i < len(ks)
        let k = ks[i]
        total = total + len(data[k])
        i = i + 1
    return total

fn mm_remove_key(mm, k)
    let data = mm["data"]
    if contains(data, k)
        del(data, k)
