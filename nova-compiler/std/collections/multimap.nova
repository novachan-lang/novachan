// multimap — string key -> list-of-values multi-map for NOVA.
//
// A key can hold any number of associated values (stored as a list).
// The multimap itself is a plain NOVA dict:
//   "data" -> dict  (string key -> list of values)
//
// Public API
//   mm_new()              -> multimap
//   mm_add(mm, k, v)      -> unit  (append v to key's list; create list if absent)
//   mm_get(mm, k)         -> list  (empty list if key absent)
//   mm_get_first(mm, k)   -> value (first element; null if key absent or empty)
//   mm_has(mm, k)         -> bool  (1 if key has at least one value, 0 otherwise)
//   mm_count(mm, k)       -> int   (number of values for key; 0 if absent)
//   mm_keys(mm)           -> list  (all keys that have at least one value)
//   mm_total(mm)          -> int   (total number of values across all keys)
//   mm_remove_key(mm, k)  -> unit  (remove key and all its values; no-op if absent)

fn mm_new()
    let mm = {}
    mm["data"] = {}
    return mm

fn mm_add(mm, k, v)
    let data = mm["data"]
    if k in data
        let lst = data[k]
        lst.push(v)
    else
        let lst = []
        lst.push(v)
        data[k] = lst

fn mm_get(mm, k)
    let data = mm["data"]
    if k in data
        return data[k]
    return []

fn mm_get_first(mm, k)
    let data = mm["data"]
    if k in data
        let lst = data[k]
        if len(lst) > 0
            return lst[0]
    return null

fn mm_has(mm, k)
    let data = mm["data"]
    if k in data
        let lst = data[k]
        if len(lst) > 0
            return 1
    return 0

fn mm_count(mm, k)
    let data = mm["data"]
    if k in data
        return len(data[k])
    return 0

fn mm_keys(mm)
    let data = mm["data"]
    return keys(data)

fn mm_total(mm)
    let data = mm["data"]
    let ks = keys(data)
    let total = 0
    for i in 0..len(ks)
        let k = ks[i]
        total += len(data[k])
    return total

fn mm_remove_key(mm, k)
    let data = mm["data"]
    if k in data
        del(data, k)

// ============================================================================
// Extensions: put/remove-one-value/remove-all/contains, layered on the
// original mm_new/mm_add/mm_get/... API above. Kept in this same file
// (rather than a second std/collections/multimap.nova) to avoid a duplicate
// `mm_`-prefixed module colliding with this one's function names.
// ============================================================================

//   mm_put(mm, k, v)          -> unit  alias for mm_add (append v under key k)
//   mm_remove(mm, k, v)       -> int   remove the FIRST occurrence of v under
//                                      key k (1 if removed, 0 if absent);
//                                      the key is dropped entirely if that
//                                      was its last remaining value
//   mm_remove_all(mm, k)      -> unit  alias for mm_remove_key (drop key + all values)
//   mm_contains(mm, k, v)     -> int   1 if v is among key k's values, else 0

// mm_put: append v under key k. Alias for mm_add under the verb this
// module's KAT/API surface was specified with.
fn mm_put(mm, k, v)
    mm_add(mm, k, v)

// mm_remove: remove the first occurrence of v from key k's value list.
// Returns 1 if a value was removed, 0 if k is absent or v is not among its
// values. Drops the key entirely once its value list becomes empty, so
// mm_has/mm_keys stay consistent with mm_add's "list exists iff non-empty"
// invariant.
fn mm_remove(mm, k, v)
    let data = mm["data"]
    if k not in data
        return 0
    let lst = data[k]
    let n = len(lst)
    let idx = -1
    for i in 0..n
        if idx == -1 and lst[i] == v
            idx = i
    if idx == -1
        return 0
    let out = []
    for j in 0..n
        if j != idx
            out.push(lst[j])
    if len(out) == 0
        del(data, k)
    else
        data[k] = out
    return 1

// mm_remove_all: drop key k and every value under it. Alias for
// mm_remove_key under the verb this module's KAT/API surface was specified
// with.
fn mm_remove_all(mm, k)
    mm_remove_key(mm, k)

// mm_contains: 1 if v is present among key k's values, 0 otherwise
// (including when k itself is absent).
fn mm_contains(mm, k, v)
    let data = mm["data"]
    if k not in data
        return 0
    let lst = data[k]
    for i in 0..len(lst)
        if lst[i] == v
            return 1
    return 0
