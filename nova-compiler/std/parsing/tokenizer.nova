// ============================================================================
// NOVA Standard Library — std/parsing/tokenizer.nova
//
// Rule-based lexer producing structured token dicts.
// Distinct from std/automata/lexer (generic rule-table approach); this module
// hard-codes language-level token kinds and handles quoted string literals
// with backslash escapes.
//
// Token dict fields:
//   "kind" : string -- one of "ident" | "int" | "str" | "op"
//   "text" : string -- the matched text
//                      For "str" tokens: the RAW lexeme INCLUDING surrounding
//                      quotes, e.g. `"hello"` (backslash sequences preserved
//                      as-is in the text field; callers strip quotes if needed).
//   "pos"  : int    -- byte offset of first character in src
//
// Whitespace is consumed and SKIPPED (not emitted).
//
// Token kinds:
//   ident  -- [A-Za-z_][A-Za-z0-9_]*
//   int    -- [0-9]+
//   str    -- "..." with backslash escapes (\n \t \\ \" and any other \X)
//   op     -- any single character that is not whitespace/ident/int/quote
//
// Public API:
//   tokenize(src: string) -> list    -- list of token dicts; ws skipped
//   tok_kinds(src: string) -> list   -- list of kind strings (convenience)
// ============================================================================

// ---------------------------------------------------------------------------
// PRIVATE helpers — character classification
// ---------------------------------------------------------------------------

fn _is_ws(c: string) -> int
    let o = ord(c)
    if o == 32
        return 1
    if o == 9
        return 1
    if o == 10
        return 1
    if o == 13
        return 1
    return 0

fn _is_digit(c: string) -> int
    let o = ord(c)
    if o >= 48
        if o <= 57
            return 1
    return 0

fn _is_ident_start(c: string) -> int
    let o = ord(c)
    if o == 95
        return 1
    if o >= 65
        if o <= 90
            return 1
    if o >= 97
        if o <= 122
            return 1
    return 0

fn _is_ident_cont(c: string) -> int
    let o = ord(c)
    if o == 95
        return 1
    if o >= 65
        if o <= 90
            return 1
    if o >= 97
        if o <= 122
            return 1
    if o >= 48
        if o <= 57
            return 1
    return 0

// ---------------------------------------------------------------------------
// PRIVATE: scan one ident token starting at pos (caller knows pos is ident_start)
// Returns the token dict; advances state via returned end position embedded in dict.
// We return a 2-element list [tok, end_pos] to communicate back the new position.
// ---------------------------------------------------------------------------

fn _scan_ident(src: string, n: int, pos: int) -> list
    let i = pos + 1
    while i < n
        let c = char_at(src, i)
        if _is_ident_cont(c) == 1
            i = i + 1
        else
            i = n + i  // break: encode end into i by adding n (sentinel trick won't work cleanly)
    // Recover real end: if i > n we overflowed the while sentinel — real end is i - n.
    // Actually simpler: rebuild with a flag.
    // Let's redo cleanly with a done flag.
    let end = pos + 1
    let going = 1
    while going == 1
        if end >= n
            going = 0
        else
            let cc = char_at(src, end)
            if _is_ident_cont(cc) == 1
                end = end + 1
            else
                going = 0
    let tok = {}
    tok["kind"] = "ident"
    tok["text"] = slice(src, pos, end)
    tok["pos"] = pos
    let result = []
    push(result, tok)
    push(result, end)
    return result

// ---------------------------------------------------------------------------
// PRIVATE: scan one int token starting at pos (caller knows pos is digit)
// ---------------------------------------------------------------------------

fn _scan_int(src: string, n: int, pos: int) -> list
    let end = pos + 1
    let going = 1
    while going == 1
        if end >= n
            going = 0
        else
            let cc = char_at(src, end)
            if _is_digit(cc) == 1
                end = end + 1
            else
                going = 0
    let tok = {}
    tok["kind"] = "int"
    tok["text"] = slice(src, pos, end)
    tok["pos"] = pos
    let result = []
    push(result, tok)
    push(result, end)
    return result

// ---------------------------------------------------------------------------
// PRIVATE: scan one str token starting at pos (pos points at opening quote `"`)
// Handles backslash escapes: any \X pair is consumed as two chars.
// Unterminated strings (EOF before closing quote) emit a str token with
// whatever was accumulated — safe, no crash.
// The "text" field is the raw lexeme INCLUDING the surrounding double-quotes.
// ---------------------------------------------------------------------------

fn _scan_str(src: string, n: int, pos: int) -> list
    let i = pos + 1  // skip opening quote
    let going = 1
    while going == 1
        if i >= n
            going = 0  // unterminated — stop at EOF
        else
            let cc = char_at(src, i)
            if cc == "\\"
                i = i + 2  // skip the escape pair (\X)
            else
                if cc == "\""
                    i = i + 1  // consume closing quote then stop
                    going = 0
                else
                    i = i + 1
    let tok = {}
    tok["kind"] = "str"
    tok["text"] = slice(src, pos, i)
    tok["pos"] = pos
    let result = []
    push(result, tok)
    push(result, i)
    return result

// ---------------------------------------------------------------------------
// PRIVATE: emit one op token at pos (single character)
// ---------------------------------------------------------------------------

fn _scan_op(src: string, pos: int) -> list
    let tok = {}
    tok["kind"] = "op"
    tok["text"] = slice(src, pos, pos + 1)
    tok["pos"] = pos
    let result = []
    push(result, tok)
    push(result, pos + 1)
    return result

// ---------------------------------------------------------------------------
// PUBLIC: tokenize(src) -> list of token dicts
// Whitespace is consumed and not emitted.
// On malformed input (e.g. unterminated string) the lexer recovers and
// continues — it never crashes.
// ---------------------------------------------------------------------------

fn tokenize(src: string) -> list
    let tokens = []
    let n = len(src)
    let pos = 0
    while pos < n
        let c = char_at(src, pos)
        if _is_ws(c) == 1
            pos = pos + 1
        else
            if _is_ident_start(c) == 1
                let pair = _scan_ident(src, n, pos)
                push(tokens, pair[0])
                pos = pair[1]
            else
                if _is_digit(c) == 1
                    let pair = _scan_int(src, n, pos)
                    push(tokens, pair[0])
                    pos = pair[1]
                else
                    if c == "\""
                        let pair = _scan_str(src, n, pos)
                        push(tokens, pair[0])
                        pos = pair[1]
                    else
                        let pair = _scan_op(src, pos)
                        push(tokens, pair[0])
                        pos = pair[1]
    return tokens

// ---------------------------------------------------------------------------
// PUBLIC: tok_kinds(src) -> list of kind strings (convenience wrapper)
// ---------------------------------------------------------------------------

fn tok_kinds(src: string) -> list
    let toks = tokenize(src)
    let kinds = []
    let i = 0
    while i < len(toks)
        let t = toks[i]
        push(kinds, t["kind"])
        i = i + 1
    return kinds
