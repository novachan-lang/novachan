// ============================================================================
// NOVA Standard Library — std/parsing/numparse.nova
//
// Robust numeric literal parsing for integer representations.
// Supports: decimal, 0x hex, 0b binary, 0o octal.
// Also supports: optional leading +/- sign, digit-group underscores.
//
// Public API:
//   numparse(s: string) -> int
//       Parse an integer literal. Returns 0 on any invalid/malformed input.
//       Never crashes on empty or malformed input.
//
//   numparse_ok(s: string) -> bool (returned as int 1/0)
//       Returns 1 if s is a valid integer literal, 0 otherwise.
//       Same rules as numparse.
//
//   parse_radix(s: string, radix: int) -> int
//       Parse s as unsigned integer in the given radix (2..36).
//       Accepts digits 0-9 and letters a-z / A-Z for bases > 10.
//       Returns 0 on invalid input or invalid radix.
//       Digit-group underscores are accepted and stripped.
//       No sign prefix (+ or -) is consumed — caller strips if needed.
// ============================================================================

// ---------------------------------------------------------------------------
// PRIVATE: trim leading and trailing ASCII whitespace from s.
// ---------------------------------------------------------------------------

fn _np_trim(s: string) -> string
    let n = len(s)
    let lo = 0
    let hi = n
    // advance lo past leading whitespace
    let going = 1
    while going == 1
        if lo >= hi
            going = 0
        else
            let o = ord(slice(s, lo, lo + 1))
            if o == 32
                lo += 1
            else
                if o == 9
                    lo += 1
                else
                    if o == 10
                        lo += 1
                    else
                        if o == 13
                            lo += 1
                        else
                            going = 0
    // retreat hi past trailing whitespace
    let going2 = 1
    while going2 == 1
        if hi <= lo
            going2 = 0
        else
            let o2 = ord(slice(s, hi - 1, hi))
            if o2 == 32
                hi -= 1
            else
                if o2 == 9
                    hi -= 1
                else
                    if o2 == 10
                        hi -= 1
                    else
                        if o2 == 13
                            hi -= 1
                        else
                            going2 = 0
    return slice(s, lo, hi)

// ---------------------------------------------------------------------------
// PRIVATE: digit value for a single character in the given radix.
// Returns -1 if the character is not a valid digit for that radix.
// ---------------------------------------------------------------------------

fn _np_digit_val(c: string, radix: int) -> int
    let o = ord(c)
    let dv = -1
    // 0-9
    if o >= 48
        if o <= 57
            dv = o - 48
    // A-Z
    if dv == -1
        if o >= 65
            if o <= 90
                dv = o - 55
    // a-z
    if dv == -1
        if o >= 97
            if o <= 122
                dv = o - 87
    // check within radix
    if dv == -1
        return -1
    if dv >= radix
        return -1
    return dv

// ---------------------------------------------------------------------------
// PRIVATE: strip underscores from s (digit-group separator).
// Returns the cleaned string.
// ---------------------------------------------------------------------------

fn _np_strip_underscores(s: string) -> string
    let n = len(s)
    let out_parts = []
    for i in 0..n
        let c = slice(s, i, i + 1)
        if c != "_"
            push(out_parts, c)
    let out = join(out_parts, "")
    return out

// ---------------------------------------------------------------------------
// PRIVATE: parse unsigned integer body (no sign, no prefix) in given radix.
// Returns a 2-element list: [ok: int, value: int]
//   ok == 1  => valid, value == result
//   ok == 0  => invalid (empty, bad digit), value == 0
// Underscores are accepted as digit-group separators.
// ---------------------------------------------------------------------------

fn _np_parse_body(s: string, radix: int) -> list
    let clean = _np_strip_underscores(s)
    let n = len(clean)
    let result = []
    if n == 0
        push(result, 0)
        push(result, 0)
        return result
    let acc = 0
    let i = 0
    let valid = 1
    while i < n
        let c = slice(clean, i, i + 1)
        let dv = _np_digit_val(c, radix)
        if dv == -1
            valid = 0
            i = n
        else
            acc = acc * radix + dv
            i += 1
    if valid == 0
        push(result, 0)
        push(result, 0)
        return result
    push(result, 1)
    push(result, acc)
    return result

// ---------------------------------------------------------------------------
// PRIVATE: core parse logic. Returns [ok, value].
// Handles sign, prefix detection, and body parsing.
// ---------------------------------------------------------------------------

fn _np_core(s: string) -> list
    let fail = []
    push(fail, 0)
    push(fail, 0)
    let t = _np_trim(s)
    let n = len(t)
    if n == 0
        return fail
    // Consume optional sign
    let neg = 0
    let start = 0
    let ch0 = slice(t, 0, 1)
    if ch0 == "+"
        start = 1
    else
        if ch0 == "-"
            neg = 1
            start = 1
    let body = slice(t, start, n)
    let blen = len(body)
    if blen == 0
        return fail
    // Detect radix prefix
    let radix = 10
    let digits = body
    if blen >= 2
        let pfx = slice(body, 0, 2)
        if pfx == "0x"
            radix = 16
            digits = slice(body, 2, blen)
        else
            if pfx == "0X"
                radix = 16
                digits = slice(body, 2, blen)
            else
                if pfx == "0b"
                    radix = 2
                    digits = slice(body, 2, blen)
                else
                    if pfx == "0B"
                        radix = 2
                        digits = slice(body, 2, blen)
                    else
                        if pfx == "0o"
                            radix = 8
                            digits = slice(body, 2, blen)
                        else
                            if pfx == "0O"
                                radix = 8
                                digits = slice(body, 2, blen)
    let parsed = _np_parse_body(digits, radix)
    if parsed[0] == 0
        return fail
    let val = parsed[1]
    if neg == 1
        val = 0 - val
    let ok = []
    push(ok, 1)
    push(ok, val)
    return ok

// ---------------------------------------------------------------------------
// PUBLIC: numparse(s) -> int
// Parse an integer literal. Returns 0 on invalid input.
// ---------------------------------------------------------------------------

fn numparse(s: string) -> int
    let r = _np_core(s)
    return r[1]

// ---------------------------------------------------------------------------
// PUBLIC: numparse_ok(s) -> int (1 = valid, 0 = invalid)
// ---------------------------------------------------------------------------

fn numparse_ok(s: string) -> int
    let r = _np_core(s)
    return r[0]

// ---------------------------------------------------------------------------
// PUBLIC: parse_radix(s, radix) -> int
// Parse s as an unsigned integer in the given radix (2..36).
// Returns 0 on invalid input (bad digits, empty, invalid radix).
// Digit-group underscores accepted. No sign prefix consumed.
// ---------------------------------------------------------------------------

fn parse_radix(s: string, radix: int) -> int
    if radix < 2
        return 0
    if radix > 36
        return 0
    let t = _np_trim(s)
    if len(t) == 0
        return 0
    let parsed = _np_parse_body(t, radix)
    if parsed[0] == 0
        return 0
    return parsed[1]
