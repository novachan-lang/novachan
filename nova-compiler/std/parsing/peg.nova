// ============================================================================
// NOVA Standard Library — std/parsing/peg
// ============================================================================
// PEG (Parsing Expression Grammar) combinator matcher.
//
// Expressions are plain dicts with a "kind" string field.
// peg_match(expr, input, pos) -> list [ok:int, new_pos:int]
//   ok=1 on success, ok=0 on failure (pos is unchanged on failure).
//
// Constructors:
//   lit(s)             -- match literal string s
//   seq(exprs)         -- match all in sequence (exprs is a list of exprs)
//   choice(exprs)      -- ordered choice (PEG /): try each, return first match
//   star(e)            -- zero or more repetitions (greedy, never fails)
//   plus(e)            -- one or more repetitions (fails if zero matches)
//   opt(e)             -- zero or one (never fails)
//   cls(chars)         -- match one char that is in the chars string
//   anychar            -- match any single character (fails at end-of-input)
//   andp(e)            -- positive lookahead (&e): succeeds if e matches, no consume
//   notp(e)            -- negative lookahead (!e): succeeds if e fails, no consume
//
// NOVA constraints obeyed:
//   - No multi-line list/dict literals.
//   - No reserved words as vars (match/loop/in/fn/let/return/and/or).
//   - Every let must be read (E1000).
//   - Single-exit style for functions that return lists (avoids mistag).
//   - No && / ||; use 'and' / 'or' or nested ifs.
//   - slice(s, i, i+1) for single-char extraction.
//   - LEAF module — imports NOTHING.
// ============================================================================

// ── Constructors ─────────────────────────────────────────────────────────────

// lit(s) -> PEG expression dict: match literal string s
fn lit(s: string) -> dict
    let e = {}
    e["kind"] = "lit"
    e["s"] = s
    e

// seq(exprs) -> PEG expression dict: match all expressions in sequence
fn seq(exprs: list) -> dict
    let e = {}
    e["kind"] = "seq"
    e["exprs"] = exprs
    e

// choice(exprs) -> PEG expression dict: ordered choice (first match wins)
fn choice(exprs: list) -> dict
    let e = {}
    e["kind"] = "choice"
    e["exprs"] = exprs
    e

// star(inner) -> PEG expression dict: zero or more repetitions
fn star(inner: dict) -> dict
    let e = {}
    e["kind"] = "star"
    e["inner"] = inner
    e

// plus(inner) -> PEG expression dict: one or more repetitions
fn plus(inner: dict) -> dict
    let e = {}
    e["kind"] = "plus"
    e["inner"] = inner
    e

// opt(inner) -> PEG expression dict: zero or one (optional)
fn opt(inner: dict) -> dict
    let e = {}
    e["kind"] = "opt"
    e["inner"] = inner
    e

// cls(chars) -> PEG expression dict: match one char from the chars string
fn cls(chars: string) -> dict
    let e = {}
    e["kind"] = "cls"
    e["chars"] = chars
    e

// anychar -> PEG expression dict: match any single character
fn anychar() -> dict
    let e = {}
    e["kind"] = "anychar"
    e

// andp(inner) -> PEG expression dict: positive lookahead (&e)
fn andp(inner: dict) -> dict
    let e = {}
    e["kind"] = "andp"
    e["inner"] = inner
    e

// notp(inner) -> PEG expression dict: negative lookahead (!e)
fn notp(inner: dict) -> dict
    let e = {}
    e["kind"] = "notp"
    e["inner"] = inner
    e

// ── Private helpers ───────────────────────────────────────────────────────────

// _peg_ok(new_pos) -> [1, new_pos]
fn _peg_ok(new_pos: int) -> list
    let r = []
    push(r, 1)
    push(r, new_pos)
    r

// _peg_fail(pos) -> [0, pos]
fn _peg_fail(pos: int) -> list
    let r = []
    push(r, 0)
    push(r, pos)
    r

// _peg_cls_match(chars, ch) -> 1 if ch is in chars string, else 0
fn _peg_cls_match(chars: string, ch: string) -> int
    let n = len(chars)
    let i = 0
    let found = 0
    while i < n and found == 0
        let c = slice(chars, i, i + 1)
        if c == ch
            found = 1
        i += 1
    found

// ── Core matcher ─────────────────────────────────────────────────────────────
//
// peg_match(expr, input, pos) -> list [ok:int, new_pos:int]
//
// Dispatches on expr["kind"]. All branches use single-exit (let result = ...)
// to avoid the return-mistag bug with list returns.

fn peg_match(expr: dict, input: string, pos: int) -> list
    let ilen = len(input)
    let kind = expr["kind"]

    // ── lit ──────────────────────────────────────────────────────────────────
    if kind == "lit"
        let s = expr["s"]
        let slen = len(s)
        let result = _peg_fail(pos)
        if slen == 0
            result = _peg_ok(pos)
        else
            if pos + slen <= ilen
                let sub = slice(input, pos, pos + slen)
                if sub == s
                    result = _peg_ok(pos + slen)
        return result

    // ── anychar ──────────────────────────────────────────────────────────────
    if kind == "anychar"
        let result = _peg_fail(pos)
        if pos < ilen
            result = _peg_ok(pos + 1)
        return result

    // ── cls ───────────────────────────────────────────────────────────────────
    if kind == "cls"
        let chars = expr["chars"]
        let result = _peg_fail(pos)
        if pos < ilen
            let ch = slice(input, pos, pos + 1)
            let hit = _peg_cls_match(chars, ch)
            if hit == 1
                result = _peg_ok(pos + 1)
        return result

    // ── seq ───────────────────────────────────────────────────────────────────
    if kind == "seq"
        let exprs = expr["exprs"]
        let n = len(exprs)
        let cur = pos
        let failed = 0
        let i = 0
        while i < n and failed == 0
            let sub = peg_match(exprs[i], input, cur)
            let subok = sub[0]
            if subok == 0
                failed = 1
            else
                cur = sub[1]
            i += 1
        let result = _peg_fail(pos)
        if failed == 0
            result = _peg_ok(cur)
        return result

    // ── choice ────────────────────────────────────────────────────────────────
    if kind == "choice"
        let exprs = expr["exprs"]
        let n = len(exprs)
        let i = 0
        let found = 0
        let win_pos = pos
        while i < n and found == 0
            let sub = peg_match(exprs[i], input, pos)
            let subok = sub[0]
            if subok == 1
                found = 1
                win_pos = sub[1]
            i += 1
        let result = _peg_fail(pos)
        if found == 1
            result = _peg_ok(win_pos)
        return result

    // ── star ──────────────────────────────────────────────────────────────────
    if kind == "star"
        let inner = expr["inner"]
        let cur = pos
        let going = 1
        while going == 1
            let sub = peg_match(inner, input, cur)
            let subok = sub[0]
            if subok == 0
                going = 0
            else
                let new_cur = sub[1]
                if new_cur == cur
                    going = 0
                else
                    cur = new_cur
        return _peg_ok(cur)

    // ── plus ──────────────────────────────────────────────────────────────────
    if kind == "plus"
        let inner = expr["inner"]
        let first = peg_match(inner, input, pos)
        let firstok = first[0]
        let result = _peg_fail(pos)
        if firstok == 1
            let cur = first[1]
            let going = 1
            while going == 1
                let sub = peg_match(inner, input, cur)
                let subok = sub[0]
                if subok == 0
                    going = 0
                else
                    let new_cur = sub[1]
                    if new_cur == cur
                        going = 0
                    else
                        cur = new_cur
            result = _peg_ok(cur)
        return result

    // ── opt ───────────────────────────────────────────────────────────────────
    if kind == "opt"
        let inner = expr["inner"]
        let sub = peg_match(inner, input, pos)
        let subok = sub[0]
        let result = _peg_ok(pos)
        if subok == 1
            result = _peg_ok(sub[1])
        return result

    // ── andp (positive lookahead) ─────────────────────────────────────────────
    if kind == "andp"
        let inner = expr["inner"]
        let sub = peg_match(inner, input, pos)
        let subok = sub[0]
        let result = _peg_fail(pos)
        if subok == 1
            result = _peg_ok(pos)
        return result

    // ── notp (negative lookahead) ─────────────────────────────────────────────
    if kind == "notp"
        let inner = expr["inner"]
        let sub = peg_match(inner, input, pos)
        let subok = sub[0]
        let result = _peg_ok(pos)
        if subok == 1
            result = _peg_fail(pos)
        return result

    // ── unknown kind: fail safely ─────────────────────────────────────────────
    _peg_fail(pos)

fn main()
    print("std/parsing/peg loaded")
