// ============================================================================
// NOVA Standard Library -- std/parsing/glob
// ============================================================================
// Full glob/fnmatch matching with extended meta-characters.
//
// META-CHARACTERS:
//   *        matches any run of characters EXCEPT '/' (path segment wildcard)
//   ?        matches exactly one character (not '/')
//   [set]    matches one character in the set; ranges [a-z] supported
//   [!set]   negated set (also [^set])
//   **       matches any path sequence INCLUDING '/' separators
//   {a,b,c}  brace alternation -- expands to multiple patterns
//
// PUBLIC API:
//   glob_match(pattern, text)  -> bool    true if text matches pattern
//   glob_to_regex(pattern)     -> string  convert pattern to regex string
//   brace_expand(pattern)      -> list    expand braces into list of patterns
//
// NOVA CONSTRAINTS:
//   slice(s,i,i+1) for char access; push(list,x) mutates; no reserved words as vars.
//   No multi-line literals; no literal {} in strings -- use chr(123)/chr(125).
//   Simple 'and' in while conditions is OK; avoid 'and' with fn calls in if.

// chr(91)='[' chr(93)=']' chr(123)='{' chr(125)='}'

// ============================================================================
// BRACE EXPANSION
// ============================================================================

// _gb_find_close: find the matching '}' for a '{' at position 'open' in s.
// Returns index of '}', or -1 if not found. Handles nested braces.
fn _gb_find_close(s: string, open: int) -> int
    let lbrace = chr(123)
    let rbrace = chr(125)
    let n = len(s)
    let depth = 1
    let i = open + 1
    let result = -1
    while i < n and result == -1
        let ch = slice(s, i, i + 1)
        if ch == lbrace
            depth += 1
        if ch == rbrace
            if depth == 1
                result = i
            depth -= 1
        i += 1
    return result

// _gb_split_alts: split the content of a brace group on top-level commas.
// Returns list of strings (the alternatives).
fn _gb_split_alts(s: string) -> any
    let lbrace = chr(123)
    let rbrace = chr(125)
    let n = len(s)
    let parts = []
    let depth = 0
    let start = 0
    for i in 0..n
        let ch = slice(s, i, i + 1)
        if ch == lbrace
            depth += 1
        if ch == rbrace
            depth -= 1
        if ch == ","
            if depth == 0
                push(parts, slice(s, start, i))
                start = i + 1
    push(parts, slice(s, start, n))
    return parts

// brace_expand(pattern) -> list
// Recursively expand all {a,b,c} groups in pattern.
// Returns list of fully-expanded strings.
fn brace_expand(pattern: string) -> any
    let lbrace = chr(123)
    let n = len(pattern)
    if n == 0
        let r = []
        push(r, "")
        return r
    // Find the first top-level '{'
    let open = -1
    let i = 0
    while i < n and open == -1
        let ch = slice(pattern, i, i + 1)
        if ch == lbrace
            open = i
        i += 1
    if open == -1
        let r = []
        push(r, pattern)
        return r
    let close = _gb_find_close(pattern, open)
    if close == -1
        let r = []
        push(r, pattern)
        return r
    let prefix = slice(pattern, 0, open)
    let inner = slice(pattern, open + 1, close)
    let suffix = slice(pattern, close + 1, n)
    let alts = _gb_split_alts(inner)
    let result = []
    let ai = 0
    let na = len(alts)
    while ai < na
        let alt = alts[ai]
        let mid = prefix + alt + suffix
        let expanded = brace_expand(mid)
        let ei = 0
        let ne = len(expanded)
        while ei < ne
            push(result, expanded[ei])
            ei += 1
        ai += 1
    return result

// ============================================================================
// GLOB TO REGEX
// ============================================================================

// _gb_esc: escape a single char for use in a regex string.
fn _gb_esc(ch: string) -> string
    if ch == "."
        return "\\."
    if ch == "^"
        return "\\^"
    if ch == "$"
        return "\\$"
    if ch == "+"
        return "\\+"
    if ch == "("
        return "\\("
    if ch == ")"
        return "\\)"
    if ch == "|"
        return "\\|"
    if ch == "\\"
        return "\\\\"
    return ch

// glob_to_regex(pattern) -> string
// Convert a glob pattern to a regex string (anchored: ^...$).
// ** -> ".*"; * -> "[^/]*"; ? -> "[^/]"; [!set] -> [^set]; literals escaped.
fn glob_to_regex(pattern: string) -> string
    let lbk = chr(91)
    let rbk = chr(93)
    let hat = "^"
    let slash = "/"
    let n = len(pattern)
    let out = "^"
    let i = 0
    while i < n
        let ch = slice(pattern, i, i + 1)
        if ch == "*"
            let is_dstar = 0
            if i + 1 < n
                let nc = slice(pattern, i + 1, i + 2)
                if nc == "*"
                    is_dstar = 1
            if is_dstar == 1
                out += ".*"
                i += 2
            else
                out += ".*"
                i += 1
        else
            if ch == "?"
                out += "."
                i += 1
            else
                if ch == lbk
                    out += lbk
                    i += 1
                    if i < n
                        let nc2 = slice(pattern, i, i + 1)
                        if nc2 == "!"
                            out += hat
                            i += 1
                        else
                            if nc2 == hat
                                out += hat
                                i += 1
                    // Copy until closing ']' (or end of pattern)
                    let done = 0
                    while i < n and done == 0
                        let bc = slice(pattern, i, i + 1)
                        out += bc
                        i += 1
                        if bc == rbk
                            done = 1
                else
                    out += _gb_esc(ch)
                    i += 1
    out += "$"
    return out

// ============================================================================
// BRACKET MATCHING
// ============================================================================

// _gb_bracket: match character 'ch' against [...] class starting at pi (after '[').
// Returns [matched:int, next_pi:int].
// matched=1 if ch is in the class; next_pi is position after the closing ']'.
fn _gb_bracket(ch: string, p: string, pi: int) -> any
    let pn = len(p)
    let rbk = chr(93)
    let negate = 0
    let start = pi
    if start < pn
        let fc = slice(p, start, start + 1)
        if fc == "!"
            negate = 1
            start += 1
        else
            if fc == "^"
                negate = 1
                start += 1
    // Find closing ']' -- stop as soon as found
    let end = start
    let found_close = 0
    let scan = start
    while scan < pn and found_close == 0
        let sc = slice(p, scan, scan + 1)
        if sc == rbk
            end = scan
            found_close = 1
        else
            scan += 1
    if found_close == 0
        let bad = [0, pi]
        return bad
    // Evaluate class -- stop as soon as matched
    let matched = 0
    let ci = start
    while ci < end and matched == 0
        let is_range = 0
        if ci + 2 < end
            let mid = slice(p, ci + 1, ci + 2)
            if mid == "-"
                is_range = 1
        if is_range == 1
            let lo = slice(p, ci, ci + 1)
            let hi = slice(p, ci + 2, ci + 3)
            let o = ord(ch)
            if o >= ord(lo)
                if o <= ord(hi)
                    matched = 1
            ci += 3
        else
            let cc = slice(p, ci, ci + 1)
            if cc == ch
                matched = 1
            ci += 1
    if negate == 1
        if matched == 1
            matched = 0
        else
            matched = 1
    let res = [matched, end + 1]
    return res

// ============================================================================
// CORE RECURSIVE MATCHER
// ============================================================================

// _gb_core: match text[si..] against pattern[pi..].
// no_slash=1: '*' and '?' refuse to match '/'.
// Returns bool.
fn _gb_core(s: string, si: int, p: string, pi: int, no_slash: int) -> bool
    let sn = len(s)
    let pn = len(p)
    let lbk = chr(91)
    // Both exhausted
    if pi == pn
        if si == sn
            return true
        return false
    let pc = slice(p, pi, pi + 1)
    // Check for '**'
    let is_dstar = 0
    if pc == "*"
        if pi + 1 < pn
            let nc = slice(p, pi + 1, pi + 2)
            if nc == "*"
                is_dstar = 1
    if is_dstar == 1
        let npi = pi + 2
        // Skip a trailing '/' after '**' so "**/" works
        if npi < pn
            let sep = slice(p, npi, npi + 1)
            if sep == "/"
                npi += 1
        // Try: ** matches empty (advance pattern only)
        if _gb_core(s, si, p, npi, no_slash)
            return true
        // Try: ** matches one more char (any char, including /)
        if si < sn
            return _gb_core(s, si + 1, p, pi, no_slash)
        return false
    // '*' -- matches any run, no '/'
    if pc == "*"
        let npi2 = pi + 1
        // Try: '*' matches empty
        if _gb_core(s, si, p, npi2, no_slash)
            return true
        // Try: '*' matches one more char
        if si < sn
            let sc = slice(s, si, si + 1)
            if no_slash == 1
                if sc == "/"
                    return false
            return _gb_core(s, si + 1, p, pi, no_slash)
        return false
    // String exhausted but pattern not (and not '*')
    if si >= sn
        return false
    let sc2 = slice(s, si, si + 1)
    // '?' -- one char (not '/')
    if pc == "?"
        if no_slash == 1
            if sc2 == "/"
                return false
        return _gb_core(s, si + 1, p, pi + 1, no_slash)
    // '[' -- character class
    if pc == lbk
        let br = _gb_bracket(sc2, p, pi + 1)
        let ok = br[0]
        let npi3 = br[1]
        if ok == 1
            return _gb_core(s, si + 1, p, npi3, no_slash)
        return false
    // Literal match
    if pc == sc2
        return _gb_core(s, si + 1, p, pi + 1, no_slash)
    return false

// ============================================================================
// PUBLIC API
// ============================================================================

// glob_match(pattern, text) -> bool
// Returns true if text matches pattern.
// Brace alternation is expanded first; any expansion that matches wins.
fn glob_match(pattern: string, text: string) -> bool
    let expanded = brace_expand(pattern)
    let n = len(expanded)
    let i = 0
    let found = false
    while i < n and found == false
        let pat = expanded[i]
        if _gb_core(text, 0, pat, 0, 1)
            found = true
        i += 1
    return found
