// ============================================================================
// NOVA Standard Library — std/barcode/bc_checkdigit
// ============================================================================
// Shared check-digit algorithms used by multiple barcode symbologies.
//
// PUBLIC API:
//   mod10_gtin(digits: string) -> int
//     Computes the EAN/UPC/GTIN Mod-10 check digit.
//     Weights from right: positions 0,2,4,... (0-indexed from right) get weight
//     3; positions 1,3,5,... get weight 1. check = (10 - sum%10) % 10.
//     Example: mod10_gtin("12345678901") == 2  (as in EAN-13 for payload 123456789012)
//
//   mod10_luhn(digits: string) -> int
//     Luhn (Mod-10) algorithm used by credit cards, IMEI, etc.
//     Working right-to-left: even positions (0-indexed from right) are doubled;
//     if doubled > 9, subtract 9. check = (10 - sum%10) % 10.
//     Example: mod10_luhn("7992739871") == 3
//
//   mod11(digits: string, weights: list) -> int
//     ISO 7064 Mod-11 check digit. Multiplies each digit by the corresponding
//     weight (cycling if weights shorter than digits), sums, result = 11 - (sum%11).
//     If result == 11 -> 0; if result == 10 -> special (returned as 10, caller
//     decides). Returns the raw mod-11 check value (0..10).
//
//   mod43_code39(text: string) -> int
//     Code 39 Mod-43 check character. Sums the Code 39 value of each character
//     and returns sum % 43. The Code 39 character set maps:
//       0-9 -> 0..9, A-Z -> 10..35, - -> 36, . -> 37, space -> 38,
//       $ -> 39, / -> 40, + -> 41, % -> 42
//
// LEAF — imports NOTHING.

// ── Private: Code 39 character value ─────────────────────────────────────────

// Return the Code 39 value (0..42) for a character, or -1 if not in alphabet.
fn _bcd_c39val(c) -> int
    let b = ord(c)
    // '0'..'9' -> 0..9
    if b >= 48 and b <= 57
        return b - 48
    // 'A'..'Z' -> 10..35
    if b >= 65 and b <= 90
        return b - 65 + 10
    // '-' -> 36
    if b == 45
        return 36
    // '.' -> 37
    if b == 46
        return 37
    // ' ' (space) -> 38
    if b == 32
        return 38
    // '$' -> 39
    if b == 36
        return 39
    // '/' -> 40
    if b == 47
        return 40
    // '+' -> 41
    if b == 43
        return 41
    // '%' -> 42
    if b == 37
        return 42
    -1

// ── Public API ───────────────────────────────────────────────────────────────

// mod10_gtin: EAN/UPC/GTIN Mod-10 check digit.
//
// Alternating weights from right: rightmost digit gets weight 3, next gets 1,
// alternating outward. This is the standard GS1/EAN-13 check digit rule.
// sum = sum of each_digit * weight; check = (10 - sum%10) % 10.
//
// Example: mod10_gtin("12345678901") == 2
fn mod10_gtin(digits) -> int
    let s = 0
    let n = len(digits)
    for i in 0..n
        let d = ord(digits[i]) - 48
        let pos_from_right = n - 1 - i
        let w = 1
        if pos_from_right % 2 == 0
            w = 3
        s += d * w
    let r = s % 10
    if r == 0
        return 0
    10 - r

// mod10_luhn: Luhn algorithm check digit.
//
// Working right-to-left on the input digits (which are all PAYLOAD digits,
// not including the check digit): positions 0,2,4,... (0-indexed from right)
// are doubled; if result > 9, subtract 9. Sum all. check = (10 - sum%10) % 10.
//
// Example: mod10_luhn("7992739871") == 3
fn mod10_luhn(digits) -> int
    let s = 0
    let n = len(digits)
    let i = 0
    while i < n
        let d = ord(digits[i]) - 48
        let pos_from_right = n - 1 - i
        if pos_from_right % 2 == 0
            d = d * 2
            if d > 9
                d -= 9
        s += d
        i += 1
    let r = s % 10
    if r == 0
        return 0
    10 - r

// mod11: ISO 7064 Mod-11 check digit with caller-supplied weights.
//
// Multiplies digits[i] by weights[i % len(weights)], sums all products.
// result = 11 - (sum % 11). If result == 11 returns 0; if 10 returns 10
// (caller can handle X check character as needed).
//
// Example: mod11("12345", [2,3,4,5,6]) -> verifiable reference value
fn mod11(digits, weights) -> int
    let s = 0
    let n = len(digits)
    let wn = len(weights)
    for i in 0..n
        let d = ord(digits[i]) - 48
        let w = weights[i % wn]
        s += d * w
    let r = 11 - (s % 11)
    if r == 11
        return 0
    r

// mod43_code39: Code 39 Mod-43 check character value.
//
// Sums the Code 39 character values (0..42) for each character in text.
// Returns sum % 43. The caller maps this integer to the Code 39 alphabet
// to get the check character.
//
// Code 39 alphabet values:
//   0-9 -> 0..9, A-Z -> 10..35, - -> 36, . -> 37, space -> 38,
//   $ -> 39, / -> 40, + -> 41, % -> 42
//
// Example: mod43_code39("CODE39") == 32
fn mod43_code39(text) -> int
    let s = 0
    let n = len(text)
    for i in 0..n
        let v = _bcd_c39val(text[i])
        if v >= 0
            s += v
    s % 43
