// ============================================================================
// NOVA Standard Library — std/barcode/codabar
// ============================================================================
// Codabar (Monarch/NW-7/USD-4) barcode encoder.
//
// Codabar encodes digits (0-9), special chars (- $ : / . +), and start/stop
// letters (A, B, C, D). Each character maps to 7 elements alternating
// bar/space/bar/space/bar/space/bar, encoded as narrow (N) or wide (W).
//
// Pattern table (7 elements per char, 0=narrow, 1=wide):
//   0: 0000011   1: 0000110   2: 0001001   3: 1100000
//   4: 0010010   5: 1000010   6: 0100001   7: 0100100
//   8: 0110000   9: 1001000   -: 0001100   $: 0011000
//   :: 1000101   /: 1010001   .: 1110000   +: 0101001
//   A: 0011010   B: 0101100   C: 0001101   D: 0110100
//
// In the output pattern: '1' = bar present (mark), '0' = space.
// Elements alternate bar/space starting with a bar.
// Between characters, a narrow inter-character gap (space='0') is appended.
//
// PUBLIC API:
//   codabar_valid_char(c: string) -> bool
//     True if c is a valid Codabar character (digits, - $ : / . + A B C D).
//
//   codabar_encode(data: string) -> string
//     Encode a string (including any start/stop letters) to a bar pattern.
//     Returns "" if any character is not a valid Codabar character.
//     Each character produces 7 elements + a trailing narrow gap space,
//     except the last character which has no trailing gap.
//
//   codabar_with_guards(data: string, start: string, stop: string) -> string
//     Wrap data with start/stop letters (A, B, C, or D) and encode.
//     start and stop must be one of A, B, C, D.
//     Returns "" if start/stop are invalid or data contains invalid chars.
//
// ENCODING MODEL:
//   Element pattern is 7 chars of '0'/'1' (N/W).
//   In the bar/space alternation:
//     position 0: bar
//     position 1: space
//     position 2: bar
//     position 3: space
//     position 4: bar
//     position 5: space
//     position 6: bar
//   '0' (narrow) => 1 unit of bar or space => '1' or '0'
//   '1' (wide)   => 3 units of bar or space => '111' or '000'
//   Inter-character gap: a single narrow space '0' between characters.
//
// LEAF — imports NOTHING.

// ── Private: pattern lookup ────────────────────────────────────────────────────

// Return the 7-char NW pattern for a Codabar character.
// Returns "" for unknown characters.
fn _cb_pat(c: string) -> string
    let p = ""
    if c == "0"
        p = "0000011"
    else if c == "1"
        p = "0000110"
    else if c == "2"
        p = "0001001"
    else if c == "3"
        p = "1100000"
    else if c == "4"
        p = "0010010"
    else if c == "5"
        p = "1000010"
    else if c == "6"
        p = "0100001"
    else if c == "7"
        p = "0100100"
    else if c == "8"
        p = "0110000"
    else if c == "9"
        p = "1001000"
    else if c == "-"
        p = "0001100"
    else if c == "$"
        p = "0011000"
    else if c == ":"
        p = "1000101"
    else if c == "/"
        p = "1010001"
    else if c == "."
        p = "1110000"
    else if c == "+"
        p = "0101001"
    else if c == "A"
        p = "0011010"
    else if c == "B"
        p = "0101100"
    else if c == "C"
        p = "0001101"
    else if c == "D"
        p = "0110100"
    p

// ── Private: encode a single character to bar pattern ────────────────────────
// The 7 elements alternate: bar space bar space bar space bar (positions 0,2,4,6 = bars; 1,3,5 = spaces)
// '0' (narrow) = 1 module; '1' (wide) = 3 modules.
// Output: module string where '1'=bar and '0'=space.
fn _cb_encode_char(c: string) -> string
    let pat = _cb_pat(c)
    if len(pat) == 0
        return ""
    let out = ""
    let k = 0
    while k < 7
        let bit = slice(pat, k, k + 1)
        // Even positions (0,2,4,6) are bars; odd positions (1,3,5) are spaces
        let is_bar = 0
        if k == 0 or k == 2 or k == 4 or k == 6
            is_bar = 1
        if bit == "1"
            // wide
            if is_bar == 1
                out = out + "111"
            else
                out = out + "000"
        else
            // narrow
            if is_bar == 1
                out = out + "1"
            else
                out = out + "0"
        k = k + 1
    out

// ── Public API ────────────────────────────────────────────────────────────────

// codabar_valid_char: true if c is a valid single-char Codabar symbol.
fn codabar_valid_char(c: string) -> bool
    let p = _cb_pat(c)
    len(p) > 0

// codabar_encode: encode a full Codabar string (including start/stop letters).
// Characters are separated by a single narrow-space inter-character gap ("0").
// Returns "" if any character is invalid.
fn codabar_encode(data: string) -> string
    let n = len(data)
    if n == 0
        return ""
    let out = ""
    let i = 0
    while i < n
        let c = char_at(data, i)
        let ce = _cb_encode_char(c)
        if len(ce) == 0
            return ""
        if i > 0
            out = out + "0"
        out = out + ce
        i = i + 1
    out

// codabar_with_guards: wrap data with start/stop chars and encode.
// start and stop must be one of "A", "B", "C", "D".
// Returns "" if start/stop invalid or data contains invalid chars.
fn codabar_with_guards(data: string, start: string, stop: string) -> string
    // Validate start/stop are single A-D chars
    let sv = _cb_pat(start)
    let ev = _cb_pat(stop)
    if len(sv) == 0 or len(ev) == 0
        return ""
    // start must be A/B/C/D
    let start_ok = false
    if start == "A" or start == "B" or start == "C" or start == "D"
        start_ok = true
    let stop_ok = false
    if stop == "A" or stop == "B" or stop == "C" or stop == "D"
        stop_ok = true
    if not start_ok or not stop_ok
        return ""
    // Validate data chars
    let dn = len(data)
    let di = 0
    while di < dn
        let dc = char_at(data, di)
        let dp = _cb_pat(dc)
        if len(dp) == 0
            return ""
        di = di + 1
    // Encode: start + data + stop
    let full = start + data + stop
    codabar_encode(full)
