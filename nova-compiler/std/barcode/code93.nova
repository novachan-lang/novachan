// ============================================================================
// NOVA Standard Library — std/barcode/code93
// ============================================================================
// Code 93 — alphanumeric linear barcode, successor to Code 39.
//
// Standard: ISO/IEC 16388:2007, AIM Uniform Symbology Specification for Code 93.
//
// CHARACTER SET (47 valid chars, values 0..46):
//   0-9 (values 0..9)
//   A-Z (values 10..35)
//   -   (value 36)
//   .   (value 37)
//   space (value 38)
//   $   (value 39)
//   /   (value 40)
//   +   (value 41)
//   %   (value 42)
//   ($) (value 43) — "shift $" extended character, not printable input
//   (/) (value 44) — "shift /" extended character
//   (+) (value 45) — "shift +" extended character
//   (%) (value 46) — "shift %" extended character
//
//   For this module we only handle the 43 printable chars (values 0..42)
//   as valid input. Extended chars 43..46 are reserved for Full ASCII mode.
//
// CHECK DIGITS (two checksums, C then K):
//   Both use the same character set with values 0..46.
//   Let data[0..n-1] be the sequence of character values.
//
//   C checksum (weight from right, starting at 1, cycling through 1..20):
//     C = sum( data[n-1-i] * ((i % 20) + 1) ) for i in 0..n-1
//     C = C mod 47
//
//   K checksum (weight from right, starting at 1, cycling through 1..15):
//     Append C to the data sequence, giving n+1 values.
//     K = sum( data2[n-i] * ((i % 15) + 1) ) for i in 0..n
//       where data2 = data[0..n-1] + [C]
//     K = K mod 47
//
// PUBLIC API:
//   code93_valid_char(c)     -> int (1 if valid 0..42 data char, 0 otherwise)
//   code93_charvalue(c)      -> int (0..42 for valid char, -1 if invalid)
//   code93_checksums(text)   -> list [c_value, k_value]  (both in 0..46)
//
// LEAF — imports NOTHING.

// ── Private: the 43 printable Code 93 characters ─────────────────────────────
// Position i in this string has value i (0..42).
fn _c93_alpha() -> string
    "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-. $/+%"

// ── Private: find position of c in the 43-char alphabet ──────────────────────
// Returns -1 if not found.
fn _c93_find(c) -> int
    let alpha = _c93_alpha()
    let n = len(alpha)
    let i = 0
    let found = -1
    while i < n and found == -1
        if slice(alpha, i, i+1) == c
            found = i
        i = i + 1
    found

// ── Public API ────────────────────────────────────────────────────────────────

// Return 1 if c is a valid Code 93 data character (values 0..42), 0 otherwise.
fn code93_valid_char(c)
    let v = _c93_find(c)
    if v >= 0
        return 1
    0

// Return the Code 93 numeric value (0..42) for a valid character, -1 if invalid.
fn code93_charvalue(c) -> int
    _c93_find(c)

// Compute the two Code 93 mod-47 check characters for the given text.
// Returns a list [c_value, k_value] where both are in 0..46.
// Invalid characters are skipped.
//
// Algorithm (ANSI/AIM BC5):
//   Build the value sequence V[] from each valid character's value (0..42).
//   n = length of V[].
//
//   C checksum:
//     Weighted sum from the rightmost character, weight cycles 1..20:
//     csum = V[n-1]*1 + V[n-2]*2 + ... + V[0]*weight_of_leftmost
//     weight at position i-from-right = ((i % 20) + 1), i=0..n-1
//     C = csum mod 47
//
//   K checksum:
//     Append C to V[], giving V2[] of length n+1.
//     Weighted sum again from rightmost, weight cycles 1..15:
//     ksum = V2[n]*1 + V2[n-1]*2 + ... + V2[0]*weight_of_leftmost
//     K = ksum mod 47
fn code93_checksums(text) -> list
    // Build value sequence
    let vals = []
    let n = len(text)
    for i in 0..n
        let c = slice(text, i, i+1)
        let v = _c93_find(c)
        if v >= 0
            push(vals, v)

    let vn = len(vals)

    // Compute C: iterate rightmost to leftmost
    let csum = 0
    for j in 0..vn
        // j=0 is rightmost (weight 1), j=vn-1 is leftmost
        let weight = (j % 20) + 1
        let idx = vn - 1 - j
        csum = csum + vals[idx] * weight
    let c_val = csum % 47

    // Append c_val to values for K computation
    push(vals, c_val)
    let vn2 = vn + 1

    // Compute K: weight cycles 1..15
    let ksum = 0
    for k in 0..vn2
        let weight = (k % 15) + 1
        let idx = vn2 - 1 - k
        ksum = ksum + vals[idx] * weight
    let k_val = ksum % 47

    let result = []
    push(result, c_val)
    push(result, k_val)
    result
