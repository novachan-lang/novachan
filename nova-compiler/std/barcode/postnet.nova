// ============================================================================
// NOVA Standard Library — std/barcode/postnet
// ============================================================================
// POSTNET and PLANET US postal barcode encoding.
//
// POSTNET (POSTal Numeric Encoding Technique):
//   Used by the USPS for ZIP code automation. Encodes 5-digit ZIP (POSTNET-5),
//   9-digit ZIP+4 (POSTNET-9), or 11-digit DPBC (POSTNET-11).
//   Encoding: each digit -> 5 bars (tall=1, short=0) using the 2-of-5 table.
//   A frame bar (1) is placed before the first digit and after the check digit.
//   Total length for n digits: 2 + (n+1)*5  (n payload + 1 check digit + 2 frames).
//
// PLANET (Postal Alpha Numeric Encoding Technique):
//   Complementary format used for mail piece tracking. Uses the bitwise
//   complement of POSTNET (tall and short bars swapped).
//
// PUBLIC API:
//   postnet_check(digits: string) -> int
//     Compute the POSTNET/PLANET check digit.
//     Sum all digit values; check = (10 - sum%10) % 10.
//     Example: postnet_check("12345") == 5  (sum=15, (10-5)%10=5)
//
//   postnet_encode(zip: string) -> string
//     Encode a ZIP code to a POSTNET module pattern string.
//     Pattern is: "1" + digits[0..n-1] encoded (each 5 chars) + check(5 chars) + "1"
//     Uses the 2-of-5 table where exactly 2 of 5 bars are tall (1).
//     Example: postnet_encode("12345") is deterministic, length=32
//
//   planet_encode(digits: string) -> string
//     Encode digits to a PLANET module pattern string.
//     Same structure as POSTNET but tall/short are swapped (complement).
//
// 2-OF-5 TABLE (POSTNET):
//   Digit -> 5-bit pattern (tall=1, short=0, exactly 2 tall bits):
//   0 -> 11000, 1 -> 00011, 2 -> 00101, 3 -> 00110, 4 -> 01001
//   5 -> 01010, 6 -> 01100, 7 -> 10001, 8 -> 10010, 9 -> 10100
//
// LEAF — imports NOTHING.

// ── Private: 2-of-5 digit patterns ───────────────────────────────────────────

// Return the 5-bit POSTNET pattern for a digit 0..9.
// Exactly 2 of the 5 positions are tall (1), rest are short (0).
fn _pn_digit_pattern(d) -> string
    if d == 0 then return "11000"
    if d == 1 then return "00011"
    if d == 2 then return "00101"
    if d == 3 then return "00110"
    if d == 4 then return "01001"
    if d == 5 then return "01010"
    if d == 6 then return "01100"
    if d == 7 then return "10001"
    if d == 8 then return "10010"
    "10100"

// Return the 5-bit PLANET pattern for a digit 0..9 (complement of POSTNET).
fn _pl_digit_pattern(d) -> string
    if d == 0 then return "00111"
    if d == 1 then return "11100"
    if d == 2 then return "11010"
    if d == 3 then return "11001"
    if d == 4 then return "10110"
    if d == 5 then return "10101"
    if d == 6 then return "10011"
    if d == 7 then return "01110"
    if d == 8 then return "01101"
    "01011"

// ── Public API ───────────────────────────────────────────────────────────────

// postnet_check: compute the POSTNET/PLANET check digit.
//
// Sum all digit values in the string. check = (10 - sum%10) % 10.
// This ensures (sum + check) % 10 == 0.
//
// Examples:
//   postnet_check("12345") == 5   (sum=15, (10-5)%10=5)
//   postnet_check("55555") == 5   (sum=25, (10-5)%10=5)
//   postnet_check("00000") == 0   (sum=0,  (10-0)%10=0)
fn postnet_check(digits) -> int
    let s = 0
    let n = len(digits)
    for i in 0..n
        s += (ord(digits[i]) - 48)
    let r = s % 10
    if r == 0
        return 0
    10 - r

// postnet_encode: encode a digit string to a POSTNET module pattern.
//
// Structure: "1" + encode(digits[0]) + ... + encode(digits[n-1])
//          + encode(check_digit) + "1"
// Each digit encodes to exactly 5 characters from the 2-of-5 table.
// Total length: 2 + (n + 1) * 5 where n = len(digits).
// For a 5-digit ZIP: 2 + 6*5 = 32 characters.
//
// Example: postnet_encode("12345") has length 32, starts and ends with "1".
fn postnet_encode(zip) -> string
    let n = len(zip)
    let out = "1"
    for i in 0..n
        let d = ord(zip[i]) - 48
        out += _pn_digit_pattern(d)
    let check = postnet_check(zip)
    out += _pn_digit_pattern(check)
    out += "1"
    out

// planet_encode: encode a digit string to a PLANET module pattern.
//
// Same structure as POSTNET but using the complemented (PLANET) 2-of-5 table.
// Exactly 3 of the 5 bars per digit are tall (1), 2 are short (0).
// Total length: 2 + (n + 1) * 5 where n = len(digits).
fn planet_encode(digits) -> string
    let n = len(digits)
    let out = "1"
    for i in 0..n
        let d = ord(digits[i]) - 48
        out += _pl_digit_pattern(d)
    let check = postnet_check(digits)
    out += _pl_digit_pattern(check)
    out += "1"
    out
