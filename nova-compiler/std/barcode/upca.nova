// ============================================================================
// NOVA Standard Library — std/barcode/upca
// ============================================================================
// UPC-A (Universal Product Code, version A) barcode implementation.
//
// UPC-A is the dominant retail barcode in North America. It encodes 11 data
// digits + 1 check digit as a 95-module (bar/space) pattern — identical
// structure to EAN-13, but without the implicit first-digit parity trick.
// UPC-A IS a subset of EAN-13: prepending "0" to any UPC-A code yields a
// valid EAN-13 code.
//
// STRUCTURE:
//   - 3-module left guard  (101)
//   - 6 left data digits,  each 7 modules wide (42 modules)  [always L-coded]
//   - 5-module center guard (01010)
//   - 6 right data digits, each 7 modules wide (42 modules)  [always R-coded]
//   - 3-module right guard (101)
//   Total: 3 + 42 + 5 + 42 + 3 = 95 modules
//
// Unlike EAN-13, UPC-A does NOT use the G-code parity variation in the left
// half — all left digits are always L-coded.
//
// CHECK DIGIT ALGORITHM (GS1 Mod-10 for 11 digits):
//   Positions 1..11 from left. Odd positions (1,3,5,7,9,11) get weight 3;
//   even positions (2,4,6,8,10) get weight 1.
//   check = (10 - sum%10) % 10.
//
// UPC-A -> EAN-13 CONVERSION:
//   Prepend "0" to any 12-digit UPC-A code to obtain the 13-digit EAN-13.
//   upca_to_ean13("036000291452") == "0036000291452"
//
// PUBLIC API:
//   upca_check(digits11: string) -> int
//     Compute the check digit for an 11-digit UPC-A payload.
//     KAT: upca_check("03600029145") == 2
//
//   upca_encode(digits11: string) -> string
//     Encode 11 data digits to a 95-module bar/space pattern string.
//     "1"=bar, "0"=space. Check digit computed automatically.
//     KAT: len(upca_encode("03600029145")) == 95
//
//   upca_valid(digits12: string) -> int
//     Validate a 12-digit UPC-A string. Returns 1 if check digit matches.
//
//   upca_to_ean13(digits12: string) -> string
//     Convert a 12-digit UPC-A code to its 13-digit EAN-13 equivalent
//     by prepending "0".
//     KAT: upca_to_ean13("036000291452") == "0036000291452"
//
// Private helpers prefixed _ua_ to prevent symbol collision.
//
// LEAF — imports NOTHING.

// ── L-code patterns (odd parity, used for left 6 digits) ─────────────────────
fn _ua_L(d) -> string
    if d == 0
        return "0001101"
    if d == 1
        return "0011001"
    if d == 2
        return "0010011"
    if d == 3
        return "0111101"
    if d == 4
        return "0100011"
    if d == 5
        return "0110001"
    if d == 6
        return "0101111"
    if d == 7
        return "0111011"
    if d == 8
        return "0110111"
    "0001011"

// ── R-code patterns (complement of L, used for right 6 digits) ────────────────
fn _ua_R(d) -> string
    if d == 0
        return "1110010"
    if d == 1
        return "1100110"
    if d == 2
        return "1101100"
    if d == 3
        return "1000010"
    if d == 4
        return "1011100"
    if d == 5
        return "1001110"
    if d == 6
        return "1010000"
    if d == 7
        return "1000100"
    if d == 8
        return "1001000"
    "1110100"

// ── Public API ────────────────────────────────────────────────────────────────

// upca_check: compute the GS1 Mod-10 check digit for 11 data digits.
//
// Weights: odd positions (1,3,5,7,9,11) from left get weight 3;
//          even positions (2,4,6,8,10) get weight 1.
// check = (10 - (sum % 10)) % 10
//
// KAT: upca_check("03600029145") == 2
fn upca_check(digits11) -> int
    let total = 0
    for i in 0..11
        let d = ord(digits11[i]) - 48
        let pos = i + 1
        if pos % 2 == 1
            total = total + d * 3
        else
            total = total + d
    (10 - total % 10) % 10

// upca_encode: encode 11 data digits to a 95-module bar/space pattern.
//
// Left 6 digits are always L-coded; right 6 digits (including check) are
// always R-coded. No G-code parity variation (unlike EAN-13).
//
// Structure:
//   "101" (3) + left 6*7 (42) + "01010" (5) + right 6*7 (42) + "101" (3) = 95
//
// KAT: len(upca_encode("03600029145")) == 95
fn upca_encode(digits11) -> string
    let check = upca_check(digits11)
    let d12 = digits11 + chr(48 + check)
    let out = "101"
    for i in 0..6
        let dval = ord(d12[i]) - 48
        out = out + _ua_L(dval)
    out = out + "01010"
    for j in 0..6
        let dval2 = ord(d12[j + 6]) - 48
        out = out + _ua_R(dval2)
    out = out + "101"
    out

// upca_valid: validate a 12-digit UPC-A string.
//
// Returns 1 (true) if the 12th digit matches the computed check digit
// for the first 11 digits. Returns 0 (false) otherwise.
fn upca_valid(digits12) -> int
    let check = upca_check(slice(digits12, 0, 11))
    let last = ord(digits12[11]) - 48
    if check == last
        return 1
    0

// upca_to_ean13: convert a 12-digit UPC-A code to its 13-digit EAN-13 form.
//
// Every UPC-A code is an EAN-13 code with leading "0". Prepending "0"
// produces a valid EAN-13 with system digit 0, which selects all-L-code
// parity for the left 6 digits — exactly matching UPC-A encoding.
//
// KAT: upca_to_ean13("036000291452") == "0036000291452"
fn upca_to_ean13(digits12) -> string
    "0" + digits12
