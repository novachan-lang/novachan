// ============================================================================
// NOVA Standard Library — std/barcode/code39
// ============================================================================
// Code 39 (also called Code 3-of-9) — alphanumeric linear barcode.
//
// Standard: ISO/IEC 16388:2007, AIM Uniform Symbology Specification for Code 39.
//
// CHARACTER SET (43 valid chars, indices 0..42):
//   0-9 (indices 0..9), A-Z (indices 10..35),
//   - (36), . (37), space (38), $ (39), / (40), + (41), % (42)
//   * is the start/stop character (not in the 43-char set for data).
//
// ENCODING MODEL:
//   Each character maps to a 9-element pattern of narrow (0) and wide (1) bars.
//   Elements alternate: bar, space, bar, space, bar, space, bar, space, bar.
//   Exactly 3 of the 9 elements are wide (hence "3-of-9").
//   Characters are separated by a narrow inter-character gap (represented as "0").
//
//   The output of code39_encode is a string of "0"/"1" chars:
//     * pattern + gap + char patterns interleaved with gaps + * pattern
//
// CHECK DIGIT:
//   Each character has a value (its index 0..42).
//   Sum of all character values mod 43 gives the check character index.
//   This is OPTIONAL in Code 39 but deterministic.
//
// PUBLIC API:
//   code39_valid_char(c) -> bool    True if c is in the 43-char Code 39 set
//   code39_charvalue(c)  -> int     0..42 value for a valid char, -1 if invalid
//   code39_checkchar(text) -> string  One-char string: the mod-43 check character
//   code39_encode(text)  -> string  Full encoding with * start/stop, "0"/"1" pattern
//
// ENCODING PATTERNS (9 bits each, bar=1/space=0, elements: b s b s b s b s b):
//   Index in the pattern string below = position in the 43-char alphabet.
//   Each character's pattern is a 9-char string of "0"/"1".
//
// LEAF — imports NOTHING.

// ── Private: the 43-character Code 39 alphabet string ────────────────────────
// Characters at position i have value i in the mod-43 check calculation.
fn _c39_alpha() -> string
    "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-. $/+%"

// ── Private: 9-element encoding pattern for each character ───────────────────
// Patterns listed in the same order as _c39_alpha() (indices 0..42).
// Each pattern is 9 chars "0"/"1": bar,space,bar,space,bar,space,bar,space,bar.
// Also index 43 = pattern for the * start/stop character.
//
// Encoding reference (narrow=0, wide=1):
//   0: 000110100   1: 100100001   2: 001100001   3: 101100000
//   4: 000110001   5: 100110000   6: 001110000   7: 000100101
//   8: 100100100   9: 001100100
//   A: 100001001   B: 001001001   C: 101001000   D: 000011001
//   E: 100011000   F: 001011000   G: 000001101   H: 100001100
//   I: 001001100   J: 000011100   K: 100000011   L: 001000011
//   M: 101000010   N: 000010011   O: 100010010   P: 001010010
//   Q: 000000111   R: 100000110   S: 001000110   T: 000010110
//   U: 110000001   V: 011000001   W: 111000000   X: 010010001
//   Y: 110010000   Z: 011010000
//   -: 000101001   .: 100101000   sp:011000100   $: 010101000
//   /: 010100010   +: 010001010   %: 000101110
//   *: 010010100   (start/stop)
fn _c39_pattern(idx) -> string
    if idx == 0 then return "000110100"
    if idx == 1 then return "100100001"
    if idx == 2 then return "001100001"
    if idx == 3 then return "101100000"
    if idx == 4 then return "000110001"
    if idx == 5 then return "100110000"
    if idx == 6 then return "001110000"
    if idx == 7 then return "000100101"
    if idx == 8 then return "100100100"
    if idx == 9 then return "001100100"
    if idx == 10 then return "100001001"
    if idx == 11 then return "001001001"
    if idx == 12 then return "101001000"
    if idx == 13 then return "000011001"
    if idx == 14 then return "100011000"
    if idx == 15 then return "001011000"
    if idx == 16 then return "000001101"
    if idx == 17 then return "100001100"
    if idx == 18 then return "001001100"
    if idx == 19 then return "000011100"
    if idx == 20 then return "100000011"
    if idx == 21 then return "001000011"
    if idx == 22 then return "101000010"
    if idx == 23 then return "000010011"
    if idx == 24 then return "100010010"
    if idx == 25 then return "001010010"
    if idx == 26 then return "000000111"
    if idx == 27 then return "100000110"
    if idx == 28 then return "001000110"
    if idx == 29 then return "000010110"
    if idx == 30 then return "110000001"
    if idx == 31 then return "011000001"
    if idx == 32 then return "111000000"
    if idx == 33 then return "010010001"
    if idx == 34 then return "110010000"
    if idx == 35 then return "011010000"
    if idx == 36 then return "000101001"
    if idx == 37 then return "100101000"
    if idx == 38 then return "011000100"
    if idx == 39 then return "010101000"
    if idx == 40 then return "010100010"
    if idx == 41 then return "010001010"
    if idx == 42 then return "000101110"
    // idx == 43 => * start/stop
    "010010100"

// ── Private: find the index of character c in the 43-char alphabet ───────────
// Returns -1 if not found.
fn _c39_find(c) -> int
    let alpha = _c39_alpha()
    let n = len(alpha)
    let i = 0
    let found = -1
    while i < n and found == -1
        if slice(alpha, i, i+1) == c
            found = i
        i = i + 1
    found

// ── Public API ────────────────────────────────────────────────────────────────

// Return true (1) if c is a valid Code 39 data character (one of the 43).
fn code39_valid_char(c)
    _c39_find(c) >= 0

// Return the Code 39 numeric value (0..42) for a valid character, -1 if invalid.
fn code39_charvalue(c) -> int
    _c39_find(c)

// Compute the mod-43 check character for the given text string.
// Each character's value (0..42) is summed; result mod 43 gives the check char.
// Invalid characters are skipped.
// Returns the check character as a single-char string.
fn code39_checkchar(text) -> string
    let n = len(text)
    let i = 0
    let total = 0
    while i < n
        let c = slice(text, i, i+1)
        let v = _c39_find(c)
        if v >= 0
            total = total + v
        i = i + 1
    let chkidx = total % 43
    let alpha = _c39_alpha()
    slice(alpha, chkidx, chkidx+1)

// Encode text as a Code 39 barcode pattern string.
// Output is a string of "0" (narrow) and "1" (wide) chars:
//   * start pattern + gap + [char pattern + gap]... + * stop pattern
// Invalid characters are skipped silently.
// The inter-character gap is a single "0" (narrow bar/space separator).
fn code39_encode(text) -> string
    let star = _c39_pattern(43)
    let gap = "0"
    let result = star
    result = result + gap
    let n = len(text)
    for i in 0..n
        let c = slice(text, i, i+1)
        let v = _c39_find(c)
        if v >= 0
            result = result + _c39_pattern(v)
            result = result + gap
    result = result + star
    result
