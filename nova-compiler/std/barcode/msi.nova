// ============================================================================
// NOVA Standard Library — std/barcode/msi
// ============================================================================
// MSI Plessey barcode encoder with Mod-10 and Mod-11 check digit support.
//
// MSI Plessey (also called Modified Plessey or MSI) encodes numeric-only
// data using a 4-bit BCD representation per digit. Each bit is encoded as:
//   bit 0: "100" (narrow bar + wide space)
//   bit 1: "110" (wide bar + narrow space)
// giving 12 bar/space elements per digit.
//
// STRUCTURE:
//   Start: "110"            (3 elements)
//   Data:  12 elements per digit
//   Stop:  "1001"           (4 elements)
//
// CHECK DIGIT ALGORITHMS:
//
//   Mod-10 (Luhn-like IBM variant for MSI):
//     1. Extract odd-position digits (0-indexed: 0, 2, 4, ...) into a number.
//     2. Double that number.
//     3. Sum all digits of the doubled number.
//     4. Add the remaining (even-indexed: 1, 3, 5, ...) digits from original.
//     5. Check = (10 - (total mod 10)) mod 10.
//
//   Mod-11 (IBM variant for MSI):
//     Weights from right to left: 2, 3, 4, 5, 6, 7, then repeat 2, 3, ...
//     Sum = sum of (digit * weight)
//     Check = 11 - (sum mod 11); if result is 11 => 0; if result is 10 => special
//     Note: some implementations return 10 as-is; we clamp to 0..10.
//
// PUBLIC API:
//   msi_check_mod10(digits: string) -> int
//     Compute MSI Mod-10 (Luhn) check digit. Returns 0..9.
//
//   msi_check_mod11(digits: string) -> int
//     Compute MSI Mod-11 check digit. Returns 0..10 (10 = special "X" value).
//
//   msi_encode(digits: string) -> string
//     Encode a digit string to a bar/space pattern string.
//     Each digit produces 12 chars. Returns "" for non-digit input.
//     Pattern: start("110") + data + stop("1001").
//
// LEAF — imports NOTHING.

// ── Private: BCD bit extraction ───────────────────────────────────────────────

// Return the k-th bit (0=MSB, 3=LSB) of digit d (0..9).
fn _msi_bit(d: int, k: int) -> int
    let shifted = d
    if k == 0
        shifted = d >> 3
    else if k == 1
        shifted = d >> 2
    else if k == 2
        shifted = d >> 1
    else
        shifted = d
    shifted & 1

// ── Private: digit sum of an integer ──────────────────────────────────────────
// Sum the decimal digits of a non-negative integer.
fn _msi_digit_sum(n: int) -> int
    let total = 0
    let rem = n
    if rem == 0
        total = 0
    else
        while rem > 0
            total = total + rem - (rem / 10) * 10
            rem = rem / 10
    total

// ── Private: parse digit from char ────────────────────────────────────────────
fn _msi_digit(c: string) -> int
    ord(c) - 48

// ── Public API ────────────────────────────────────────────────────────────────

// msi_check_mod10: MSI Luhn-variant Mod-10 check digit.
// Algorithm:
//   1. Concatenate digits at even indices (0,2,4,...) into a number.
//   2. Double that number and digit-sum the result.
//   3. Add digits at odd indices (1,3,5,...) directly.
//   4. Check = (10 - (total mod 10)) mod 10.
fn msi_check_mod10(digits: string) -> int
    let n = len(digits)
    // Step 1: form the number from even-indexed digits (0,2,4,...)
    let odd_num = 0
    let i = 0
    while i < n
        let c = char_at(digits, i)
        let d = _msi_digit(c)
        odd_num = odd_num * 10 + d
        i = i + 2
    // Step 2: double it and digit-sum
    let doubled = odd_num * 2
    let dsum = _msi_digit_sum(doubled)
    // Step 3: add even-indexed digits (1,3,5,...)
    let j = 1
    while j < n
        let c2 = char_at(digits, j)
        let d2 = _msi_digit(c2)
        dsum = dsum + d2
        j = j + 2
    // Step 4: check digit
    let rem = dsum - (dsum / 10) * 10
    let chk = 0
    if rem != 0
        chk = 10 - rem
    chk

// msi_check_mod11: MSI Mod-11 check digit (IBM variant).
// Weights from right-to-left: 2, 3, 4, 5, 6, 7, 2, 3, ...
// Check = 11 - (sum mod 11); if result 11 -> 0; result 10 -> 10 (special).
fn msi_check_mod11(digits: string) -> int
    let n = len(digits)
    let total = 0
    let w = 2
    let i = n - 1
    while i >= 0
        let c = char_at(digits, i)
        let d = _msi_digit(c)
        total = total + d * w
        w = w + 1
        if w > 7
            w = 2
        i = i - 1
    let rem = total - (total / 11) * 11
    let chk = 0
    if rem == 0
        chk = 0
    else
        chk = 11 - rem
    chk

// msi_encode: encode digit string to MSI bar/space pattern.
// Start: "110" (3 chars)
// Per digit: 12 chars (4 BCD bits * 3 chars each)
// Stop: "1001" (4 chars)
// Returns "" if any character is not a digit 0..9.
fn msi_encode(digits: string) -> string
    let n = len(digits)
    if n == 0
        return ""
    // Validate all digits
    let vi = 0
    let valid = true
    while vi < n
        let vc = char_at(digits, vi)
        let vo = ord(vc)
        if vo < 48 or vo > 57
            valid = false
        vi = vi + 1
    if not valid
        return ""
    // Start pattern
    let out = "110"
    // Encode each digit
    let i = 0
    while i < n
        let c = char_at(digits, i)
        let d = _msi_digit(c)
        // 4 BCD bits MSB first
        let k = 0
        while k < 4
            let bit = _msi_bit(d, k)
            if bit == 1
                out = out + "110"
            else
                out = out + "100"
            k = k + 1
        i = i + 1
    // Stop pattern
    out = out + "1001"
    out
