// ============================================================================
// NOVA Standard Library — std/barcode/ean8
// ============================================================================
// EAN-8 (European Article Number, 8-digit short form) barcode implementation.
//
// EAN-8 is a compact barcode for small product packages where EAN-13 would
// not fit. It encodes 7 data digits + 1 check digit as a 67-module pattern.
//
// STRUCTURE:
//   - 3-module left guard  (101)
//   - 4 left data digits,  each 7 modules wide (28 modules)
//   - 5-module center guard (01010)
//   - 4 right data digits, each 7 modules wide (28 modules)
//   - 3-module right guard (101)
//   Total: 3 + 28 + 5 + 28 + 3 = 67 modules
//
// Left side always uses L-codes (odd parity). Right side always uses R-codes.
// There is no system-digit parity variation — EAN-8 is simpler than EAN-13.
//
// CHECK DIGIT ALGORITHM (GS1 Mod-10 for 7 digits):
//   Positions 1..7 from left. Odd positions (1,3,5,7) get weight 3;
//   even positions (2,4,6) get weight 1.
//   check = (10 - sum%10) % 10.
//   NOTE: EAN-8 uses the OPPOSITE weight assignment from EAN-13.
//
// PUBLIC API:
//   ean8_check(digits7: string) -> int
//     Compute the check digit for a 7-digit EAN-8 payload.
//     KAT: ean8_check("1234567") == 0
//
//   ean8_encode(digits7: string) -> string
//     Encode 7 data digits to a 67-module bar/space pattern string.
//     "1"=bar, "0"=space. Check digit computed automatically.
//     KAT: len(ean8_encode("1234567")) == 67
//
//   ean8_valid(digits8: string) -> int
//     Validate an 8-digit EAN-8 string. Returns 1 if check digit matches.
//     KAT: ean8_valid("12345670") == 1; ean8_valid("12345671") == 0
//
// ENCODING TABLES: identical L-codes and R-codes to EAN-13.
// Private helpers prefixed _e8_ to prevent symbol collision.
//
// LEAF — imports NOTHING.

// ── L-code patterns (odd parity, used for left 4 digits) ─────────────────────
fn _e8_L(d) -> string
    if d == 0
        return "0001101"
    if d == 1
        return "0011001"
    if d == 2
        return "0010011"
    if d == 3
        return "0111101"
    if d == 4
        return "0100011"
    if d == 5
        return "0110001"
    if d == 6
        return "0101111"
    if d == 7
        return "0111011"
    if d == 8
        return "0110111"
    "0001011"

// ── R-code patterns (complement of L, used for right 4 digits) ────────────────
fn _e8_R(d) -> string
    if d == 0
        return "1110010"
    if d == 1
        return "1100110"
    if d == 2
        return "1101100"
    if d == 3
        return "1000010"
    if d == 4
        return "1011100"
    if d == 5
        return "1001110"
    if d == 6
        return "1010000"
    if d == 7
        return "1000100"
    if d == 8
        return "1001000"
    "1110100"

// ── Public API ────────────────────────────────────────────────────────────────

// ean8_check: compute the GS1 Mod-10 check digit for 7 data digits.
//
// Weights: odd positions (1,3,5,7) from left get weight 3;
//          even positions (2,4,6) get weight 1.
// check = (10 - (sum % 10)) % 10
//
// This is the REVERSE weight assignment from EAN-13: in EAN-8, the shorter
// code has the first digit at an odd position weighted 3 (not 1).
//
// KAT: ean8_check("1234567") == 0
fn ean8_check(digits7) -> int
    let total = 0
    for i in 0..7
        let d = ord(digits7[i]) - 48
        let pos = i + 1
        if pos % 2 == 1
            total += d * 3
        else
            total += d
    (10 - total % 10) % 10

// ean8_encode: encode 7 data digits to a 67-module bar/space pattern.
//
// Left 4 digits (indices 0..3 of the 7-digit payload) are L-coded.
// Right 4 digits (indices 4..7 including check) are R-coded.
// The check digit is computed and appended before encoding.
//
// Structure:
//   "101" (3) + left 4*7 (28) + "01010" (5) + right 4*7 (28) + "101" (3) = 67
//
// KAT: len(ean8_encode("1234567")) == 67
fn ean8_encode(digits7) -> string
    let check = ean8_check(digits7)
    let d8 = digits7 + chr(48 + check)
    let out = "101"
    for i in 0..4
        let dval = ord(d8[i]) - 48
        out += _e8_L(dval)
    out += "01010"
    for j in 0..4
        let dval2 = ord(d8[j + 4]) - 48
        out += _e8_R(dval2)
    out += "101"
    out

// ean8_valid: validate an 8-digit EAN-8 string.
//
// Returns 1 (true) if the 8th digit matches the computed check digit
// for the first 7 digits. Returns 0 (false) otherwise.
//
// KAT: ean8_valid("12345670") == 1; ean8_valid("12345671") == 0
fn ean8_valid(digits8) -> int
    let check = ean8_check(slice(digits8, 0, 7))
    let last = ord(digits8[7]) - 48
    if check == last
        return 1
    0
