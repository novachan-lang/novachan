// ============================================================================
// NOVA Standard Library — std/functional/fzipwith.nova
// Zip-with combinators: combine lists pairwise via a function.
// Pure NOVA, no imports.
// ============================================================================

// fz_zip_with(f, a, b) — apply f(a[i], b[i]) pairwise; result length = min(len(a), len(b)).
fn fz_zip_with(f, a, b)
    let na = len(a)
    let nb = len(b)
    let n = na if na <= nb else nb
    [f(a[i], b[i]) for i in 0..n]

// fz_zip_with3(f, a, b, c) — apply f(a[i], b[i], c[i]) triplewise; result length = min of all three.
fn fz_zip_with3(f, a, b, c)
    let na = len(a)
    let nb = len(b)
    let nc = len(c)
    let n = na
    if nb < n
        n = nb
    if nc < n
        n = nc
    [f(a[i], b[i], c[i]) for i in 0..n]

// fz_zip_with_index(f, xs) — apply f(index, xs[i]) for each element; returns list of results.
fn fz_zip_with_index(f, xs)
    [f(i, xs[i]) for i in 0..len(xs)]
