// ============================================================================
// NOVA Standard Library — std/functional/func.nova
// Function combinators: identity, compose, pipe, const, apply_n, memoize1.
// Pure NOVA, no new builtins. Leaf module — imports nothing.
// ============================================================================

// f_identity(x) — returns x unchanged. Useful as a default transform.
fn f_identity(x)
    x

// f_compose(f, g) — returns fn(x) f(g(x))  (right-to-left: g applied first, then f).
// Example: f_compose(inc, double)(3) == inc(double(3)) == inc(6) == 7
fn _f_compose_call(x, f, g)
    let inner = g(x)
    f(inner)

fn f_compose(f, g)
    return fn(x) _f_compose_call(x, f, g)

// f_pipe2(f, g) — returns fn(x) g(f(x))  (left-to-right: f applied first, then g).
// Example: f_pipe2(double, inc)(3) == inc(double(3)) == inc(6) == 7
fn _f_pipe2_call(x, f, g)
    let inner = f(x)
    g(inner)

fn f_pipe2(f, g)
    return fn(x) _f_pipe2_call(x, f, g)

// f_const(k) — returns fn(_) k regardless of the argument.
// Example: f_const(9)(123) == 9
fn _f_const_call(x, k)
    k

fn f_const(k)
    return fn(x) _f_const_call(x, k)

// f_apply_n(f, x, n) — applies f to x exactly n times iteratively.
// f_apply_n(f, x, 0) == x  ;  f_apply_n(f, x, 1) == f(x)
fn f_apply_n(f, x, n)
    let v = x
    for i in 0..n
        v = f(v)
    v

// f_memoize1(f) — returns a memoized version of f (int -> int).
// The cache is a dict keyed by str(arg). First call computes and stores;
// subsequent calls with the same int arg return the cached value.
// NOTE: cache is shared across all calls to the returned closure.
fn _f_memo_call(x, cache, f)
    let k = str(x)
    if k in cache
        return cache[k]
    let v = f(x)
    cache[k] = v
    v

fn f_memoize1(f)
    let cache = {}
    return fn(x) _f_memo_call(x, cache, f)
