// ============================================================================
// NOVA Standard Library — std/functional/fgroupby.nova
// Higher-order grouping: group_by, partition_by, count_by.
// Pure NOVA, no imports. All fns take a function argument.
// ============================================================================

// fg_group_by(keyfn, xs) — group elements by integer key returned by keyfn.
// Returns list of [key, members] pairs sorted ascending by key.
// Members within each group appear in original order.
fn fg_group_by(keyfn, xs)
    // Collect unique keys (insertion order) into a list; store members in dict.
    let keys_seen = []
    let groups = {}
    for i in 0..len(xs)
        let elem = xs[i]
        let k = keyfn(elem)
        let ks = str(k)
        if not contains(groups, ks)
            push(keys_seen, k)
            groups[ks] = []
        push(groups[ks], elem)
    // Selection-sort keys ascending.
    let n = len(keys_seen)
    for si in 0..n
        let min_idx = si
        let sj = si + 1
        while sj < n
            if keys_seen[sj] < keys_seen[min_idx]
                min_idx = sj
            sj = sj + 1
        if min_idx != si
            let tmp = keys_seen[si]
            keys_seen[si] = keys_seen[min_idx]
            keys_seen[min_idx] = tmp
    // Build result list of [key, members].
    let result = []
    for ri in 0..n
        let k2 = keys_seen[ri]
        let pair = [k2, groups[str(k2)]]
        push(result, pair)
    result

// fg_partition_by(pred, xs) — split into runs of consecutive elements sharing
// the same boolean truth value of pred(elem). Returns list of sublists.
fn fg_partition_by(pred, xs)
    let result = []
    if len(xs) == 0
        return result
    let current = []
    let cur_val = pred(xs[0])
    push(current, xs[0])
    for i in 1..len(xs)
        let v = pred(xs[i])
        // Compare int representations: NOVA bools as ints (0/1).
        let cv_int = 0
        if cur_val
            cv_int = 1
        let v_int = 0
        if v
            v_int = 1
        if v_int != cv_int
            push(result, current)
            current = []
            cur_val = v
        push(current, xs[i])
    push(result, current)
    result

// fg_count_by(keyfn, xs) — count elements sharing the same integer key.
// Returns list of [key, count] pairs sorted ascending by key.
fn fg_count_by(keyfn, xs)
    let keys_seen = []
    let counts = {}
    for i in 0..len(xs)
        let k = keyfn(xs[i])
        let ks = str(k)
        if not contains(counts, ks)
            push(keys_seen, k)
            counts[ks] = 0
        counts[ks] = counts[ks] + 1
    // Selection-sort keys ascending.
    let n = len(keys_seen)
    for si in 0..n
        let min_idx = si
        let sj = si + 1
        while sj < n
            if keys_seen[sj] < keys_seen[min_idx]
                min_idx = sj
            sj = sj + 1
        if min_idx != si
            let tmp = keys_seen[si]
            keys_seen[si] = keys_seen[min_idx]
            keys_seen[min_idx] = tmp
    let result = []
    for ri in 0..n
        let k2 = keys_seen[ri]
        let pair = [k2, counts[str(k2)]]
        push(result, pair)
    result
