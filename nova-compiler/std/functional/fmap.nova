// ============================================================================
// NOVA Standard Library — std/functional/fmap.nova
// Map higher-order functions: apply a unary function over a list.
// Pure NOVA, no imports. Leaf module — imports nothing.
// ============================================================================

// fm_map(f, xs) — returns a new list with f applied to each element of xs.
fn fm_map(f, xs)
    [f(x) for x in xs]

// fm_map_indexed(f, xs) — returns a new list with f(index, value) for each element.
fn fm_map_indexed(f, xs)
    [f(i, xs[i]) for i in 0..len(xs)]

// fm_flat_map(f, xs) — applies f to each element (f must return a list) and concatenates results.
fn fm_flat_map(f, xs)
    let result = []
    for i in 0..len(xs)
        let sub = f(xs[i])
        for j in 0..len(sub)
            push(result, sub[j])
    result
