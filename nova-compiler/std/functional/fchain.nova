// ============================================================================
// NOVA Standard Library — std/functional/fchain.nova
// Function chaining: pipe2, pipe3, compose2, apply_all.
// Pure NOVA, no imports. Leaf module.
// ============================================================================

// fch_pipe2(x, f, g) — applies f then g left-to-right: g(f(x)).
fn fch_pipe2(x, f, g)
    let fx = f(x)
    g(fx)

// fch_pipe3(x, f, g, h) — applies f, g, h left-to-right: h(g(f(x))).
fn fch_pipe3(x, f, g, h)
    let fx = f(x)
    let gfx = g(fx)
    h(gfx)

// fch_compose2(x, f, g) — applies g then f right-to-left: f(g(x)).
fn fch_compose2(x, f, g)
    let gx = g(x)
    f(gx)

// fch_apply_all(x, f, g, h) — returns list [f(x), g(x), h(x)] applying each fn independently.
fn fch_apply_all(x, f, g, h)
    [f(x), g(x), h(x)]
