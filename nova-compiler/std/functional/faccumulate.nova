// ============================================================================
// NOVA Standard Library — std/functional/faccumulate.nova
// Higher-order accumulation: sum_by, product_by, max_by_value, count_where.
// Pure NOVA, no imports. Leaf module.
// ============================================================================

// fa_sum_by(f, xs) — returns the sum of f(x) for each x in xs. Empty list -> 0.
fn fa_sum_by(f, xs)
    let total = 0
    for i in 0..len(xs)
        total += f(xs[i])
    total

// fa_product_by(f, xs) — returns the product of f(x) for each x in xs. Empty list -> 1.
fn fa_product_by(f, xs)
    let result = 1
    for i in 0..len(xs)
        result = result * f(xs[i])
    result

// fa_max_by_value(f, xs) — returns the maximum value of f(x) across xs. Empty list -> 0.
fn fa_max_by_value(f, xs)
    if len(xs) == 0
        return 0
    let best = f(xs[0])
    for i in 1..len(xs)
        let v = f(xs[i])
        if v > best
            best = v
    best

// fa_count_where(pred, xs) — returns count of elements where pred(x) is true.
fn fa_count_where(pred, xs)
    len([x for x in xs if pred(x)])
