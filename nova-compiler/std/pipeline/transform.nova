// std/pipeline/transform.nova — a mutable, eagerly-run data transformation
// pipeline over a list.
//
// Representation: a dict with one entry:
//   "steps" -> list of step descriptors, each a dict:
//                {"kind": "map"|"filter"|"take"|"skip", "fn": closure-or-0, "n": int-or-0}
//
// Unlike std/stream/pipeline.nova (which builds a NEW immutable stream per
// stage and fuses map/filter/take into a single lazy pass), pt_ pipelines
// are a single mutable object you accumulate steps onto with pt_map /
// pt_filter / pt_take / pt_skip, then execute stage-by-stage over a
// concrete list with pt_run: each stage fully materializes before the next
// one runs. take(n) keeps the first n elements seen so far by that stage;
// skip(n) drops the first n.
//
// Public API (prefix pt_):
//   pt_new()                  -> dict
//   pt_map(pipeline, f)              (f: value -> value)
//   pt_filter(pipeline, f)           (f: value -> bool)
//   pt_take(pipeline, n)
//   pt_skip(pipeline, n)
//   pt_run(pipeline, data)    -> list
//   pt_count(pipeline)        -> int
//   pt_clear(pipeline)
//
// LEAF — imports nothing.

// pt_new: create an empty pipeline (no steps).
fn pt_new() -> dict
    let p = {}
    p["steps"] = []
    return p

// Private: append a step descriptor to the pipeline's step list.
fn _pt_push_step(pipeline, kind, fnval, nval)
    let steps = pipeline["steps"]
    let step = {}
    step["kind"] = kind
    step["fn"] = fnval
    step["n"] = nval
    push(steps, step)
    pipeline["steps"] = steps

// pt_map: append a value -> value transform stage.
fn pt_map(pipeline, f)
    _pt_push_step(pipeline, "map", f, 0)

// pt_filter: append a keep-if-truthy predicate stage.
fn pt_filter(pipeline, f)
    _pt_push_step(pipeline, "filter", f, 0)

// pt_take: append a "keep only the first n elements reaching this stage" step.
fn pt_take(pipeline, n)
    _pt_push_step(pipeline, "take", 0, n)

// pt_skip: append a "drop the first n elements reaching this stage" step.
fn pt_skip(pipeline, n)
    _pt_push_step(pipeline, "skip", 0, n)

// pt_run: run every step in order over data, returning the final list.
// data itself is never mutated (each stage produces a fresh list).
fn pt_run(pipeline, data) -> list
    let steps = pipeline["steps"]
    let cur = [v for v in data]
    for i in 0..len(steps)
        let step = steps[i]
        let kind = step["kind"]
        if kind == "map"
            let f = step["fn"]
            let out = []
            for v in cur
                push(out, f(v))
            cur = out
        else if kind == "filter"
            let f = step["fn"]
            let out = []
            for v in cur
                if f(v)
                    push(out, v)
            cur = out
        else if kind == "take"
            let n = step["n"]
            let out = []
            let j = 0
            while j < len(cur) and j < n
                push(out, cur[j])
                j = j + 1
            cur = out
        else if kind == "skip"
            let n = step["n"]
            let out = []
            let j = n
            if j < 0
                j = 0
            while j < len(cur)
                push(out, cur[j])
                j = j + 1
            cur = out
    return cur

// pt_count: number of steps currently in the pipeline.
fn pt_count(pipeline) -> int
    return len(pipeline["steps"])

// pt_clear: remove all steps (pipeline becomes the identity transform).
fn pt_clear(pipeline)
    pipeline["steps"] = []
