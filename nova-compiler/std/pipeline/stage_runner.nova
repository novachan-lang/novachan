// ============================================================================
// std/pipeline/stage_runner — named, fallible, short-circuiting pipeline
// ============================================================================
// std/pipeline/transform.nova runs a fixed set of list operators (map,
// filter, take, skip) eagerly over a list. This module is a different
// concern: "railway-oriented" execution of NAMED stages over a single
// value, where each stage can fail — and a failure immediately stops the
// run instead of running the remaining stages (e.g. validate -> normalize
// -> enrich -> persist, where any step can reject the input). This mirrors
// Express/Koa-style middleware chains and Rust's `?`-chained `Result`
// pipelines, but as a runtime-inspectable object: you can ask how many
// stages ran, which stage failed, and replay the same pipeline against many
// inputs.
//
// Representation:
//   pipeline  : {"stg_names": list<string>, "stg_fns": list<fn>}
//   stage fn  : value -> stage-result   (call stg_ok(v) / stg_err(msg) to build one)
//   stage result : {"stg_ok": bool, "stg_val": value-or-error}
//   run result   : {"stg_status": "ok"|"error", "stg_value": final-value-or-error,
//                    "stg_failed_at": name-of-failing-stage-or-"",
//                    "stg_trace": list<string> of stage names that ran}
//
// Public API:
//   stg_new()                 -> pipeline
//   stg_add(p, name, f)                       append a named stage (f: value -> stage-result)
//   stg_count(p)              -> int          number of stages registered
//   stg_names(p)              -> list         stage names in order
//   stg_ok(v)                  -> stage-result  build a passing stage result
//   stg_err(msg)                -> stage-result  build a failing stage result
//   stg_run(p, input)          -> run-result   execute all stages; stop at first failure
//   stg_is_ok(run_result)       -> bool
//   stg_is_error(run_result)     -> bool
//
// LEAF module — imports nothing.
// ============================================================================

// stg_new: an empty pipeline (no stages).
fn stg_new()
    let p = {}
    p["stg_names"] = []
    p["stg_fns"] = []
    return p

// stg_add: append a named stage. f takes the current value and must return
// a stage-result built with stg_ok(v) or stg_err(msg).
fn stg_add(p, name, f)
    let names = p["stg_names"]
    push(names, name)
    p["stg_names"] = names
    let fns = p["stg_fns"]
    push(fns, f)
    p["stg_fns"] = fns

// stg_count: number of stages currently registered.
fn stg_count(p)
    return len(p["stg_names"])

// stg_names: the registered stage names, in run order.
fn stg_names(p)
    return p["stg_names"]

// stg_ok: build a passing stage result carrying the next value.
fn stg_ok(v)
    let r = {}
    r["stg_ok"] = true
    r["stg_val"] = v
    return r

// stg_err: build a failing stage result carrying an error message.
fn stg_err(msg)
    let r = {}
    r["stg_ok"] = false
    r["stg_val"] = msg
    return r

// stg_run: execute every stage in order, feeding each stage's output value
// into the next stage's input. Stops immediately at the first stage whose
// result is not ok, without running any later stages.
fn stg_run(p, input)
    let names = p["stg_names"]
    let fns = p["stg_fns"]
    let cur = input
    let trace = []
    let i = 0
    let n = len(names)
    let failed = false
    let fail_name = ""
    let fail_err = ""
    while i < n and not failed
        let name = names[i]
        let f = fns[i]
        let out = f(cur)
        push(trace, name)
        if out["stg_ok"]
            cur = out["stg_val"]
        else
            failed = true
            fail_name = name
            fail_err = out["stg_val"]
        i = i + 1
    let result = {}
    if failed
        result["stg_status"] = "error"
        result["stg_value"] = fail_err
        result["stg_failed_at"] = fail_name
    else
        result["stg_status"] = "ok"
        result["stg_value"] = cur
        result["stg_failed_at"] = ""
    result["stg_trace"] = trace
    return result

// stg_is_ok: true iff a run-result completed all stages successfully.
fn stg_is_ok(run_result)
    if run_result["stg_status"] == "ok"
        return true
    return false

// stg_is_error: true iff a run-result stopped early on a failing stage.
fn stg_is_error(run_result)
    if run_result["stg_status"] == "error"
        return true
    return false
