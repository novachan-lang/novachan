// ============================================================================
// NOVA Standard Library — std/algo/longest_increasing_path
// ============================================================================
// Longest strictly-increasing path in a 2D integer grid, moving between
// 4-directionally adjacent cells only (no diagonals), where each step must
// strictly increase the cell value. Solved via DFS + memoization: memo[r][c]
// = length of the longest increasing path STARTING at (r,c).
//
// grid: a non-empty rectangular list-of-lists of integers (all rows the
// same length).
//
// Public API
//   lip_solve(grid) -> int    length of the longest increasing path anywhere
//                              in the grid (0 for an empty grid).
//   lip_path(grid)  -> list   one concrete longest increasing path, as a
//                              list of [row, col] pairs in traversal order
//                              (starting cell first). [] for an empty grid.
// ============================================================================

fn _lip_dfs(grid, memo, r, c, rows, cols) -> int
    let memoRow = memo[r]
    if memoRow[c] != 0
        return memoRow[c]
    let gridRow = grid[r]
    let here = gridRow[c]
    let best = 1
    if r > 0
        let upRow = grid[r - 1]
        if upRow[c] > here
            let v = 1 + _lip_dfs(grid, memo, r - 1, c, rows, cols)
            if v > best
                best = v
    if r < rows - 1
        let downRow = grid[r + 1]
        if downRow[c] > here
            let v = 1 + _lip_dfs(grid, memo, r + 1, c, rows, cols)
            if v > best
                best = v
    if c > 0
        if gridRow[c - 1] > here
            let v = 1 + _lip_dfs(grid, memo, r, c - 1, rows, cols)
            if v > best
                best = v
    if c < cols - 1
        if gridRow[c + 1] > here
            let v = 1 + _lip_dfs(grid, memo, r, c + 1, rows, cols)
            if v > best
                best = v
    memoRow = memo[r]
    memoRow[c] = best
    return best

fn _lip_make_memo(rows, cols) -> list
    let memo = []
    for i in 0..rows
        let row = []
        let j = 0
        while j < cols
            push(row, 0)
            j += 1
        push(memo, row)
    return memo

fn lip_solve(grid) -> int
    let rows = len(grid)
    if rows == 0
        return 0
    let cols = len(grid[0])
    if cols == 0
        return 0
    let memo = _lip_make_memo(rows, cols)
    let best = 0
    for r in 0..rows
        let c = 0
        while c < cols
            let v = _lip_dfs(grid, memo, r, c, rows, cols)
            if v > best
                best = v
            c += 1
    return best

fn lip_path(grid) -> list
    let rows = len(grid)
    if rows == 0
        return []
    let cols = len(grid[0])
    if cols == 0
        return []
    let memo = _lip_make_memo(rows, cols)
    let best = 0
    let br = 0
    let bc = 0
    for r in 0..rows
        let c = 0
        while c < cols
            let v = _lip_dfs(grid, memo, r, c, rows, cols)
            if v > best
                best = v
                br = r
                bc = c
            c += 1

    let path = []
    let r2 = br
    let c2 = bc
    push(path, [r2, c2])
    let memoRow0 = memo[r2]
    let remaining = memoRow0[c2]
    while remaining > 1
        let target = remaining - 1
        let gridRow2 = grid[r2]
        let here = gridRow2[c2]
        let moved = false
        if not moved and r2 > 0
            let upRow = grid[r2 - 1]
            let upMemoRow = memo[r2 - 1]
            if upRow[c2] > here and upMemoRow[c2] == target
                r2 -= 1
                moved = true
        if not moved and r2 < rows - 1
            let downRow = grid[r2 + 1]
            let downMemoRow = memo[r2 + 1]
            if downRow[c2] > here and downMemoRow[c2] == target
                r2 += 1
                moved = true
        if not moved and c2 > 0
            let leftMemoRow = memo[r2]
            if gridRow2[c2 - 1] > here and leftMemoRow[c2 - 1] == target
                c2 -= 1
                moved = true
        if not moved and c2 < cols - 1
            let rightMemoRow = memo[r2]
            if gridRow2[c2 + 1] > here and rightMemoRow[c2 + 1] == target
                c2 += 1
                moved = true
        push(path, [r2, c2])
        remaining -= 1
    return path
