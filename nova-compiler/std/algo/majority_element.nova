// std/algo/majority_element — Boyer-Moore majority vote algorithm and its
// n/3 generalization.
//
// DUPLICATE-SURVEY NOTE: this module replaces an originally-planned
// std/algo/huffman.nova, which turned out to be an almost total duplicate of
// the already thorough std/compress/huffman.nova (hf_build_codes/hf_encode/
// hf_decode/hf_encoded_bits, min-heap + pool-based tree, deterministic
// tie-breaking) and std/compress/adaptive_huffman.nova. A grep survey found
// NO existing module for Boyer-Moore majority voting (n/2 or n/3) anywhere
// in std/algo, std/collections, or std/statistics, so this is genuinely new
// coverage for an underserved category (std/algo had only 4 files prior to
// this campaign).
//
// Finds the element(s) that occur more than n/k times in a list using O(n)
// time and O(1) extra space (k-1 candidate "vote counter" slots) — no
// sorting, no hash-counting pass required for the candidate-finding phase
// (a verification pass over the list is still needed, since Boyer-Moore's
// first pass only produces a CANDIDATE, not a guarantee).
//
// PUBLIC API (prefix mjr_):
//   mjr_count(lst, val)  -> int    occurrences of val in lst
//   mjr_candidate(lst)   -> any    Boyer-Moore n/2 candidate (UNVERIFIED —
//                                   use mjr_find for a verified answer)
//   mjr_find(lst)        -> list   [1, value] if a strict majority element
//                                   (count > len(lst)/2) exists, else [0, 0]
//   mjr_find_n3(lst)     -> list   every distinct value occurring more than
//                                   len(lst)/3 times (0, 1, or 2 values;
//                                   this bound is mathematically guaranteed
//                                   -- at most 2 values can each exceed 1/3
//                                   of the list)
//
// LEAF — imports NOTHING.

// mjr_count: number of times val occurs in lst.
fn mjr_count(lst: list, val) -> int
    let n = len(lst)
    let count = 0
    let i = 0
    while i < n
        if lst[i] == val
            count = count + 1
        i = i + 1
    return count

// mjr_candidate: Boyer-Moore majority-vote candidate for a strict (> n/2)
// majority. Empty input returns 0 (caller-guarded by mjr_find; documented
// here since mjr_candidate is directly callable).
fn mjr_candidate(lst: list) -> any
    let n = len(lst)
    let candidate = 0
    let votes = 0
    let i = 0
    while i < n
        if votes == 0
            candidate = lst[i]
            votes = 1
        else
            if lst[i] == candidate
                votes = votes + 1
            else
                votes = votes - 1
        i = i + 1
    return candidate

// mjr_find: [1, value] if a value occurs more than len(lst)/2 times,
// else [0, 0]. Runs the candidate pass then verifies by counting.
fn mjr_find(lst: list) -> list
    let n = len(lst)
    if n == 0
        return [0, 0]
    let candidate = mjr_candidate(lst)
    let c = mjr_count(lst, candidate)
    if c * 2 > n
        return [1, candidate]
    return [0, 0]

// mjr_find_n3: every distinct value occurring more than len(lst)/3 times.
// Classic two-candidate Boyer-Moore extension: at most two values can each
// exceed a 1/3 share, so two "vote counter" slots suffice for the candidate
// pass, followed by an exact verification count for each candidate found.
fn mjr_find_n3(lst: list) -> list
    let n = len(lst)
    let result = []
    if n == 0
        return result
    let cand1 = 0
    let cnt1 = 0
    let cand2 = 0
    let cnt2 = 0
    let i = 0
    while i < n
        let v = lst[i]
        if cnt1 > 0 and v == cand1
            cnt1 = cnt1 + 1
        else
            if cnt2 > 0 and v == cand2
                cnt2 = cnt2 + 1
            else
                if cnt1 == 0
                    cand1 = v
                    cnt1 = 1
                else
                    if cnt2 == 0
                        cand2 = v
                        cnt2 = 1
                    else
                        cnt1 = cnt1 - 1
                        cnt2 = cnt2 - 1
        i = i + 1
    let threshold = n / 3
    let actual1 = mjr_count(lst, cand1)
    if actual1 > threshold
        push(result, cand1)
    if cand2 != cand1
        let actual2 = mjr_count(lst, cand2)
        if actual2 > threshold
            push(result, cand2)
    return result

fn main()
    print("std/algo/majority_element loaded")
