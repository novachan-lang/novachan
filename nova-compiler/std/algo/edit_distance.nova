// std/algo/edit_distance — Levenshtein edit distance with full operation
// reconstruction and similarity metrics.
//
// DUPLICATE-SURVEY NOTE: the raw distance number already exists as
// std/dp/dp_edit_distance.nova (ed_distance/ed_distance_costs/
// ed_lcs_distance), using a memory-efficient rolling two-row DP (no
// backtrace possible from a rolling table — the earlier rows are
// discarded). This module deliberately keeps the FULL m*n DP table so it can
// backtrack an actual edit script (edst_ops), and adds similarity metrics
// (edst_similarity, edst_is_close) that no existing module provides. It is
// independently implemented (not calling into dp_edit_distance) to stay a
// self-contained LEAF module, matching this stdlib's per-file convention.
//
// PUBLIC API (prefix edst_):
//   edst_distance(a, b)            -> int   unit-cost Levenshtein distance
//   edst_ops(a, b)                 -> list  edit script turning a into b,
//                                             each entry one of:
//                                               "MATCH c"      (kept as-is)
//                                               "SUB x->y"     (substituted)
//                                               "DEL x"        (deleted)
//                                               "INS y"        (inserted)
//                                             in left-to-right order.
//   edst_similarity(a, b)          -> int   0..100, 100 = identical
//   edst_is_close(a, b, threshold) -> int   1 if edst_distance <= threshold
//
// LEAF — imports NOTHING.

fn _edst_min3(x: int, y: int, z: int) -> int
    let m = x
    if y < m
        m = y
    if z < m
        m = z
    return m

// _edst_table: full (m+1) x (n+1) Levenshtein DP table.
// table[i][j] = edit distance between a[0..i-1] and b[0..j-1].
fn _edst_table(a: string, b: string) -> list
    let m = len(a)
    let n = len(b)
    let table = []
    let i = 0
    while i <= m
        let row = []
        let j = 0
        while j <= n
            push(row, 0)
            j += 1
        push(table, row)
        i += 1
    let i2 = 0
    while i2 <= m
        table[i2][0] = i2
        i2 += 1
    let j2 = 0
    while j2 <= n
        table[0][j2] = j2
        j2 += 1
    let ii = 1
    while ii <= m
        let jj = 1
        while jj <= n
            let cost = 1
            if a[ii - 1] == b[jj - 1]
                cost = 0
            let del_v = table[ii - 1][jj] + 1
            let ins_v = table[ii][jj - 1] + 1
            let sub_v = table[ii - 1][jj - 1] + cost
            table[ii][jj] = _edst_min3(del_v, ins_v, sub_v)
            jj += 1
        ii += 1
    return table

// edst_distance: unit-cost Levenshtein distance between strings a and b.
fn edst_distance(a: string, b: string) -> int
    let m = len(a)
    let n = len(b)
    if m == 0
        return n
    if n == 0
        return m
    let table = _edst_table(a, b)
    return table[m][n]

// edst_ops: an edit script (list of operation strings, left-to-right) that
// transforms a into b at minimum cost.
fn edst_ops(a: string, b: string) -> list
    let m = len(a)
    let n = len(b)
    if m == 0
        let ops_i = ["INS " + b[j] for j in 0..n]
        return ops_i
    if n == 0
        let ops_d = ["DEL " + a[i] for i in 0..m]
        return ops_d
    let table = _edst_table(a, b)
    let i = m
    let j = n
    let rev = []
    while i > 0 or j > 0
        if i > 0 and j > 0 and a[i - 1] == b[j - 1] and table[i][j] == table[i - 1][j - 1]
            push(rev, "MATCH " + a[i - 1])
            i -= 1
            j -= 1
        else if i > 0 and j > 0 and table[i][j] == table[i - 1][j - 1] + 1
            push(rev, "SUB " + a[i - 1] + "->" + b[j - 1])
            i -= 1
            j -= 1
        else if i > 0 and table[i][j] == table[i - 1][j] + 1
            push(rev, "DEL " + a[i - 1])
            i -= 1
        else
            push(rev, "INS " + b[j - 1])
            j -= 1
    let ops = []
    let k = len(rev) - 1
    while k >= 0
        push(ops, rev[k])
        k -= 1
    return ops

// edst_similarity: percentage similarity in [0, 100]; 100 means identical
// (including both-empty). Computed as floor(100 * (maxlen - dist) / maxlen).
fn edst_similarity(a: string, b: string) -> int
    let m = len(a)
    let n = len(b)
    if m == 0 and n == 0
        return 100
    let dist = edst_distance(a, b)
    let maxlen = m
    if n > maxlen
        maxlen = n
    let pct = ((maxlen - dist) * 100) / maxlen
    if pct < 0
        pct = 0
    return pct

// edst_is_close: 1 if a and b are within `threshold` edits of each other.
fn edst_is_close(a: string, b: string, threshold: int) -> int
    if edst_distance(a, b) <= threshold
        return 1
    return 0

fn main()
    print("std/algo/edit_distance loaded")
