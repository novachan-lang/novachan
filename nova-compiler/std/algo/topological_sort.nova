// std/algo/topological_sort — incremental-builder Kahn's-algorithm
// topological sort with layer decomposition.
//
// DUPLICATE-SURVEY NOTE: topological sort already exists TWICE —
// std/graph/topological_kahn.nova (tk_*, integer-id adjacency LIST input,
// smallest-id tie-break) and std/graph/topological.nova (tp_*, string-node
// adjacency DICT input, lexicographic tie-break). Both require the caller to
// hand-assemble the full graph structure before calling. This module adds
// two things neither of those provides: (1) an INCREMENTAL graph-builder API
// (tsrt_new/tsrt_add_edge) so callers can construct a graph edge-by-edge
// without pre-sizing an adjacency list or dict, and (2) tsrt_layers, a full
// "wave" decomposition of the DAG (every node grouped with all others that
// become ready at the same elimination step) — neither existing module
// exposes this (tp_longest_path_len only returns a single int, the length of
// the longest path, not the layer partition itself). Tie-breaking here is
// plain FIFO insertion order (the classic textbook presentation of Kahn's
// algorithm) rather than a min-search over ids or lexicographic strings —
// a third, simpler, distinct determinism rule (O(1) per ready-node instead
// of an O(n) or O(n log n) tie-break scan).
//
// Graph representation (returned by tsrt_new): a dict
//   { "nodes": list of node-name strings in first-seen order,
//     "adj":   dict node-name -> list of successor node-name strings }
// Node names are arbitrary strings; tsrt_add_edge auto-registers both
// endpoints (so isolated nodes must be added via an edge to themselves'
// component, or simply never referenced — this module has no need for a
// separate "add isolated node" call for its test surface).
//
// PUBLIC API (prefix tsrt_):
//   tsrt_new()             -> dict   a fresh empty graph
//   tsrt_add_edge(g, u, v) ->        directed edge u -> v (registers u, v)
//   tsrt_sort(g)           -> list   topological order, or [] if a cycle
//                                      exists (or the graph is empty)
//   tsrt_has_cycle(g)      -> int    1 if the graph contains a cycle, else 0
//   tsrt_layers(g)         -> list   list of layers (each a list of node
//                                      names); layer 0 = nodes with no
//                                      predecessors, layer k = nodes whose
//                                      predecessors are all in layers < k.
//                                      Stops early (fewer layers than nodes)
//                                      if a cycle prevents full placement.
//
// LEAF — imports NOTHING.

fn tsrt_new() -> dict
    return {"nodes": [], "adj": {}}

// _tsrt_ensure_node: register `name` as a known node (idempotent).
fn _tsrt_ensure_node(g: dict, name: string)
    let adj = g["adj"]
    if name not in adj
        adj[name] = []
        g["adj"] = adj
        let nodes = g["nodes"]
        push(nodes, name)

// tsrt_add_edge: add a directed edge u -> v, registering both endpoints
// as nodes if they are new (in the order first seen).
fn tsrt_add_edge(g: dict, u: string, v: string)
    _tsrt_ensure_node(g, u)
    _tsrt_ensure_node(g, v)
    let adj = g["adj"]
    let lst = adj[u]
    push(lst, v)

// _tsrt_indegree: compute in-degree of every node.
fn _tsrt_indegree(g: dict) -> dict
    let nodes = g["nodes"]
    let adj = g["adj"]
    let indeg = {}
    for i in 0..len(nodes)
        indeg[nodes[i]] = 0
    for j in 0..len(nodes)
        let u = nodes[j]
        let nbrs = adj[u]
        for k in 0..len(nbrs)
            let v = nbrs[k]
            indeg[v] += 1
    return indeg

// _tsrt_kahn: FIFO-order Kahn's algorithm. Returns the order found; if its
// length is less than the node count, the remaining nodes form a cycle.
fn _tsrt_kahn(g: dict) -> list
    let nodes = g["nodes"]
    let adj = g["adj"]
    let indeg = _tsrt_indegree(g)
    let queue = []
    for i in 0..len(nodes)
        let nd = nodes[i]
        if indeg[nd] == 0
            push(queue, nd)
    let order = []
    let qi = 0
    while qi < len(queue)
        let u = queue[qi]
        qi += 1
        push(order, u)
        let nbrs = adj[u]
        for k in 0..len(nbrs)
            let v = nbrs[k]
            indeg[v] -= 1
            if indeg[v] == 0
                push(queue, v)
    return order

// tsrt_sort: valid topological order (FIFO tie-break), or [] on a cycle.
fn tsrt_sort(g: dict) -> list
    let nodes = g["nodes"]
    let order = _tsrt_kahn(g)
    if len(order) < len(nodes)
        return []
    return order

// tsrt_has_cycle: 1 if the graph contains a cycle, else 0.
fn tsrt_has_cycle(g: dict) -> int
    let nodes = g["nodes"]
    let order = _tsrt_kahn(g)
    if len(order) < len(nodes)
        return 1
    return 0

// tsrt_layers: full BFS "wave" decomposition. layers[0] = nodes with
// in-degree 0; layers[k] = nodes whose in-degree becomes 0 only after every
// node in layers[0..k-1] is removed. If a cycle blocks progress, returns the
// layers successfully computed so far (fewer than the total node count).
fn tsrt_layers(g: dict) -> list
    let nodes = g["nodes"]
    let adj = g["adj"]
    let indeg = _tsrt_indegree(g)
    let placed = {}
    let remaining = len(nodes)
    let layers = []
    while remaining > 0
        let layer = []
        for i in 0..len(nodes)
            let nd = nodes[i]
            if nd not in placed and indeg[nd] == 0
                push(layer, nd)
        if len(layer) == 0
            return layers
        for li in 0..len(layer)
            let nd2 = layer[li]
            placed[nd2] = 1
            remaining -= 1
        for lj in 0..len(layer)
            let u = layer[lj]
            let nbrs = adj[u]
            for k in 0..len(nbrs)
                let v = nbrs[k]
                indeg[v] -= 1
        push(layers, layer)
    return layers

fn main()
    print("std/algo/topological_sort loaded")
