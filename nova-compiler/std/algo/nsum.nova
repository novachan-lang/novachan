// std/algo/nsum.nova — generalized k-sum (2Sum/3Sum/4Sum) via sort + two pointers.
// KAT: test_programs/_kat_fleet6.nova
//
// Classic "kSum" family: given a list of ints and a target, find every UNIQUE
// combination of k elements (by value, not index) that sums to target.
// All variants sort a private copy first (O(n log n)) then walk with a
// two-pointer sweep per fixed prefix (O(n) per prefix), giving the standard
// O(n^(k-1)) complexity for fixed small k, with built-in de-duplication by
// skipping over repeated values at each pointer position.
//
// NOTE: std/algo already has convex-hull (std/geometry/convexhull.nova) and
// suffix-array (std/collections/suffixarray.nova) coverage — this module
// fills a genuinely open kSum slot in the algo family.
//
// Public API:
//   nsum_has_pair(nums, target) -> bool   O(n log n) existence check (2Sum)
//   nsum_2sum(nums, target)     -> list   unique [a,b] pairs, a<=b, sum=target
//   nsum_3sum(nums, target)     -> list   unique [a,b,c] triples, a<=b<=c
//   nsum_4sum(nums, target)     -> list   unique [a,b,c,d] quadruples
//
// LEAF — imports nothing.

// _nsum_sorted_copy: ascending-sorted COPY of nums (never mutates the input).
fn _nsum_sorted_copy(nums: list) -> list
    return sort([x for x in nums])

// nsum_has_pair: true iff some pair of elements sums to exactly target.
fn nsum_has_pair(nums: list, target: int) -> bool
    let a = _nsum_sorted_copy(nums)
    let n = len(a)
    let lo = 0
    let hi = n - 1
    let found = false
    while lo < hi and not found
        let s = a[lo] + a[hi]
        if s == target
            found = true
        else if s < target
            lo += 1
        else
            hi -= 1
    return found

// nsum_2sum: every unique pair [a,b] (a<=b) summing to target, ascending by a.
fn nsum_2sum(nums: list, target: int) -> list
    let a = _nsum_sorted_copy(nums)
    let n = len(a)
    let result = []
    let lo = 0
    let hi = n - 1
    while lo < hi
        let s = a[lo] + a[hi]
        if s == target
            let pair = [a[lo], a[hi]]
            push(result, pair)
            let vlo = a[lo]
            while lo < hi and a[lo] == vlo
                lo += 1
            let vhi = a[hi]
            while lo < hi and a[hi] == vhi
                hi -= 1
        else if s < target
            lo += 1
        else
            hi -= 1
    return result

// nsum_3sum: every unique triple [a,b,c] (a<=b<=c) summing to target.
fn nsum_3sum(nums: list, target: int) -> list
    let a = _nsum_sorted_copy(nums)
    let n = len(a)
    let result = []
    for i in 0..(n - 2)
        let skip_i = false
        if i > 0 and a[i] == a[i - 1]
            skip_i = true
        if not skip_i
            let lo = i + 1
            let hi = n - 1
            let want = target - a[i]
            while lo < hi
                let s = a[lo] + a[hi]
                if s == want
                    let triple = [a[i], a[lo], a[hi]]
                    push(result, triple)
                    let vlo = a[lo]
                    while lo < hi and a[lo] == vlo
                        lo += 1
                    let vhi = a[hi]
                    while lo < hi and a[hi] == vhi
                        hi -= 1
                else if s < want
                    lo += 1
                else
                    hi -= 1
    return result

// nsum_4sum: every unique quadruple [a,b,c,d] (a<=b<=c<=d) summing to target.
fn nsum_4sum(nums: list, target: int) -> list
    let a = _nsum_sorted_copy(nums)
    let n = len(a)
    let result = []
    for i in 0..(n - 3)
        let skip_i = false
        if i > 0 and a[i] == a[i - 1]
            skip_i = true
        if not skip_i
            let j = i + 1
            while j < n - 2
                let skip_j = false
                if j > i + 1 and a[j] == a[j - 1]
                    skip_j = true
                if not skip_j
                    let lo = j + 1
                    let hi = n - 1
                    let want = target - a[i] - a[j]
                    while lo < hi
                        let s = a[lo] + a[hi]
                        if s == want
                            let quad = [a[i], a[j], a[lo], a[hi]]
                            push(result, quad)
                            let vlo = a[lo]
                            while lo < hi and a[lo] == vlo
                                lo += 1
                            let vhi = a[hi]
                            while lo < hi and a[hi] == vhi
                                hi -= 1
                        else if s < want
                            lo += 1
                        else
                            hi -= 1
                j += 1
    return result
