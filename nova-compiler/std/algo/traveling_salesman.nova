// ============================================================================
// NOVA Standard Library — std/algo/traveling_salesman
// ============================================================================
// Traveling Salesman Problem: exact solution via Held-Karp bitmask DP, plus
// a fast nearest-neighbor heuristic for comparison. Tour starts and ends at
// city 0 and visits every other city exactly once.
//
// dist: an n x n list-of-lists cost matrix (dist[i][j] = cost of i -> j).
// Not assumed symmetric. Exact solve is O(n^2 * 2^n) time / O(n * 2^n) space
// — intended for small n (roughly n <= ~16).
//
// Public API
//   tsp_solve(dist) -> dict   { "tsp_cost": int, "tsp_path": list }
//                              exact optimum via Held-Karp DP; tsp_path is a
//                              closed tour [0, ..., 0].
//   tsp_nn(dist)    -> dict   { "tsp_cost": int, "tsp_path": list }
//                              greedy nearest-neighbor heuristic tour from
//                              city 0 (fast, not guaranteed optimal).
// ============================================================================

let TSP_INF = 999999999

fn tsp_solve(dist) -> dict
    let n = len(dist)
    if n <= 1
        return {"tsp_cost": 0, "tsp_path": [0]}

    let SZ = 1 << n
    let FULL = SZ - 1

    let dp = [[TSP_INF for i in 0..n] for m in 0..SZ]
    let parent = [[-1 for i in 0..n] for m in 0..SZ]

    let dpStart = dp[1]
    dpStart[0] = 0

    for mask in 1..SZ
        if (mask & 1) == 1
            let curRow = dp[mask]
            for i in 0..n
                if (mask & (1 << i)) != 0 and curRow[i] < TSP_INF
                    let base = curRow[i]
                    for j in 0..n
                        if (mask & (1 << j)) == 0
                            let nmask = mask | (1 << j)
                            let cand = base + dist[i][j]
                            let nRow = dp[nmask]
                            if cand < nRow[j]
                                nRow[j] = cand
                                let nParentRow = parent[nmask]
                                nParentRow[j] = i

    let fullRow = dp[FULL]
    let best = TSP_INF
    let bestEnd = -1
    for e in 1..n
        if fullRow[e] < TSP_INF
            let total = fullRow[e] + dist[e][0]
            if total < best
                best = total
                bestEnd = e

    let path = []
    let curMask = FULL
    let curNode = bestEnd
    while curNode != -1
        push(path, curNode)
        let pRow = parent[curMask]
        let pnode = pRow[curNode]
        let pmask = curMask ^ (1 << curNode)
        curMask = pmask
        curNode = pnode

    let plen = len(path)
    let rev = [path[plen - 1 - idx] for idx in 0..plen]
    push(rev, 0)

    return {"tsp_cost": best, "tsp_path": rev}

fn tsp_nn(dist) -> dict
    let n = len(dist)
    if n <= 1
        return {"tsp_cost": 0, "tsp_path": [0]}

    let visited = [0 for i in 0..n]
    let path = [0]
    visited[0] = 1
    let cost = 0
    let cur = 0
    for count in 1..n
        let bestNext = -1
        let bestD = TSP_INF
        for j in 0..n
            if visited[j] == 0 and dist[cur][j] < bestD
                bestD = dist[cur][j]
                bestNext = j
        push(path, bestNext)
        visited[bestNext] = 1
        cost += bestD
        cur = bestNext
    cost += dist[cur][0]
    push(path, 0)

    return {"tsp_cost": cost, "tsp_path": path}
