// std/algo/systematic_sampling.nova — Systematic sampling and stratified
// systematic sampling.
//
// DUPLICATE-SURVEY NOTE: the originally-assigned name for this slot was
// "reservoir_sampling" (Vitter's Algorithm R, weighted reservoir sampling).
// Both already exist: std/sketch/reservoir.nova (rs_new/rs_add = Algorithm R,
// plus rs_weighted_add = weighted variant) AND std/random/sample.nova
// (rs_reservoir/rs_weighted). A third reservoir-sampling module would be
// pure duplication. This module instead covers SYSTEMATIC sampling — a
// different, deterministic-interval sampling design (pick every k-th
// element from a fixed starting offset) and its stratified extension
// (group by label, then systematic-sample within each group) — neither of
// which exists anywhere in std/ (surveyed: std/sketch/, std/random/,
// std/statistics/tdigest.nova all cover randomized/streaming sampling, none
// cover fixed-interval systematic sampling).
//
// Systematic sampling: given population size n and sample size k, the
// sampling interval is step = floor(n / k) (minimum 1). A single random
// start r in [0, step) is chosen once; every step-th unit thereafter is
// selected: r, r+step, r+2*step, .... This is the standard survey-sampling
// technique (simpler than SRS, guarantees even spatial/temporal coverage,
// at the cost of periodicity bias if the population has a matching cycle).
//
// Public API (prefix ssm_):
//   ssm_interval(n, k)                 -> int   sampling interval (>=1)
//   ssm_sample(n, k, start)            -> list  selected indices, ascending,
//                                                 length <= k, each < n
//   ssm_sample_values(values, k, start) -> list  values at the sampled indices
//   ssm_group_by(labels)               -> dict   label(string) -> list of
//                                                 original indices with that label
//   ssm_stratified_sample(labels, k_per_stratum) -> list
//       For each distinct label in `labels` (a list of strings, one per
//       item), systematic-sample up to k_per_stratum indices from that
//       stratum's index list. Returns the combined selection, sorted
//       ascending by original index.
//
// LEAF — imports NOTHING.

// ssm_interval: sampling interval for population n, sample size k.
// step = floor(n/k), clamped to >= 1. k <= 0 or n <= 0 both yield 1
// (caller-side ssm_sample will then naturally return an empty/short list).
fn ssm_interval(n, k)
    if n <= 0
        return 1
    if k <= 0
        return 1
    let step = n / k
    if step < 1
        step = 1
    return step

// ssm_sample: systematic sample of up to k indices from population size n,
// starting at (start mod step). Stops early once an index would reach n.
fn ssm_sample(n, k, start)
    let out = []
    if n <= 0 or k <= 0
        return out
    let step = ssm_interval(n, k)
    let s = start % step
    if s < 0
        s += step
    let idx = s
    let count = 0
    while idx < n and count < k
        push(out, idx)
        idx += step
        count += 1
    return out

// ssm_sample_values: values at the systematically-sampled indices of `values`.
fn ssm_sample_values(values, k, start)
    let idxs = ssm_sample(len(values), k, start)
    let out = []
    let i = 0
    let n = len(idxs)
    while i < n
        push(out, values[idxs[i]])
        i += 1
    return out

// ssm_group_by: partition item indices by their label. `labels` is a list
// of strings, one per item (item i's stratum is labels[i]).
fn ssm_group_by(labels)
    let groups = {}
    let n = len(labels)
    for i in 0..n
        let lab = labels[i]
        if lab in groups
            let existing = groups[lab]
            push(existing, i)
        else
            let fresh = []
            push(fresh, i)
            groups[lab] = fresh
    return groups

// _ssm_insert_sorted: insert v into an ascending-sorted int list (linear
// scan + shift-free rebuild — population sizes here are small/KAT-scale).
fn _ssm_insert_sorted(xs, v)
    let out = []
    let n = len(xs)
    let inserted = false
    for i in 0..n
        if not inserted and v < xs[i]
            push(out, v)
            inserted = true
        push(out, xs[i])
    if not inserted
        push(out, v)
    return out

// ssm_stratified_sample: systematic sampling applied independently within
// each stratum (as produced by ssm_group_by), then combined and sorted
// ascending by original index. Iteration order over strata is
// deterministic-within-a-run via keys(); the final result is always sorted
// regardless of that order.
fn ssm_stratified_sample(labels, k_per_stratum)
    let groups = ssm_group_by(labels)
    let ks = keys(groups)
    let combined = []
    let gi = 0
    let ng = len(ks)
    while gi < ng
        let lab = ks[gi]
        let idxs = groups[lab]
        let picked = ssm_sample(len(idxs), k_per_stratum, 0)
        let pi = 0
        let np = len(picked)
        while pi < np
            let orig_idx = idxs[picked[pi]]
            combined = _ssm_insert_sorted(combined, orig_idx)
            pi += 1
        gi += 1
    return combined
