// std/algo/gnome_sort.nova — Gnome sort (a.k.a. stupid sort): a simple
// swap-based comparison sort. The "gnome" walks forward through the array;
// whenever the current element is smaller than the previous one it swaps
// them and steps back one position (like a garden gnome sorting flower
// pots), otherwise it steps forward. Equivalent in spirit to insertion sort
// but implemented with a single index and no nested loop.
// LEAF — imports NOTHING.
//
// Public API (prefix gnm_):
//   gnm_sort(arr)         -> list  new list, sorted ascending
//   gnm_sort_desc(arr)    -> list  new list, sorted descending
//   gnm_is_sorted(arr)    -> bool  true iff arr is sorted ascending
//   gnm_swap_count(arr)   -> int   number of swaps gnm_sort would perform
//
// ALGORITHM (ascending): i = 0; while i < n: if i == 0 or arr[i] >= arr[i-1]
// then i = i + 1 (step forward — either at the start, or no inversion here)
// else swap(arr[i], arr[i-1]) and i = i - 1 (step back — an inversion was
// just fixed, so re-check the pair now behind us). The gnome never needs to
// remember where it came from, unlike insertion sort's explicit shift loop.
// Time complexity O(n^2) worst case (reverse-sorted input), O(n) best case
// (already sorted — a single forward pass, zero swaps).
//
// KNOWN ANSWERS (hand-traced against this exact algorithm):
//   gnm_sort([5,3,4,1,2])     = [1,2,3,4,5]
//   gnm_sort([4,3,2,1])       = [1,2,3,4]
//   gnm_sort([])              = []
//   gnm_sort([7])             = [7]
//   gnm_sort_desc([1,4,2])    = [4,2,1]
//   gnm_swap_count([3,2,1])   = 3
//   gnm_swap_count([1,2,3])   = 0
//   gnm_swap_count([5,3,4,1,2]) = 8

// _gnm_copy — shallow copy of a list.
fn <T> _gnm_copy(lst: list<T>) -> list<T>
    return [x for x in lst]

// gnm_sort — gnome-sort a copy of arr into ascending order.
fn <T> gnm_sort(arr: list<T>) -> list<T>
    let a = _gnm_copy(arr)
    let n = len(a)
    let i = 0
    while i < n
        if i == 0 or a[i] >= a[i - 1]
            i = i + 1
        else
            let tmp = a[i]
            a[i] = a[i - 1]
            a[i - 1] = tmp
            i = i - 1
    return a

// gnm_sort_desc — gnome-sort a copy of arr into descending order (sort
// ascending, then reverse).
fn <T> gnm_sort_desc(arr: list<T>) -> list<T>
    return reverse(gnm_sort(arr))

// gnm_is_sorted — true iff arr is sorted ascending.
fn <T> gnm_is_sorted(arr: list<T>) -> bool
    let n = len(arr)
    for i in 1..n
        if arr[i] < arr[i - 1]
            return false
    return true

// gnm_swap_count — number of swaps gnm_sort would perform on arr.
fn <T> gnm_swap_count(arr: list<T>) -> int
    let a = _gnm_copy(arr)
    let n = len(a)
    let i = 0
    let swaps = 0
    while i < n
        if i == 0 or a[i] >= a[i - 1]
            i = i + 1
        else
            let tmp = a[i]
            a[i] = a[i - 1]
            a[i - 1] = tmp
            swaps = swaps + 1
            i = i - 1
    return swaps
