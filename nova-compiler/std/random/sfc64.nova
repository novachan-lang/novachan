// std/random/sfc64 -- Small Fast Counting PRNG, 64-bit (Doty-Humphrey).
//
// SFC64 is a high-quality counter-based PRNG combining a counter, a linear
// recurrence, and a bit rotation to produce statistically excellent output.
//
// Algorithm (Doty-Humphrey sfc64):
//   tmp      = a + b + counter
//   counter += 1
//   a        = b XOR shr64(b, 11)
//   b        = c + (c << 3)
//   c        = rotl64(c, 24) + tmp
//   return tmp
//
// Seeding: a = b = c = seed, counter = 1, then 12 warm-up next() calls
// to fully mix the state before use.
//
// NOVA arithmetic notes:
//   * i64 + and * wrap mod 2^64 — exactly right for PRNG arithmetic.
//   * >> is arithmetic (sign-extending); _sfc_shr64 applies a logical mask.
//   * Constants with bit 63 set are built from 32-bit halves.
//   * sfc_next returns the full 64-bit output word (may be negative as i64).
//   * sfc_next_range masks to 63 bits before modulo for non-negative results.
//
// Public API:
//   sfc_seed(seed)          -> dict   create seeded rng state {a,b,c,counter}
//   sfc_next(rng)           -> int    advance state, return raw 64-bit output
//   sfc_next_range(rng, n)  -> int    uniform in [0, n)

// ── private helpers ──────────────────────────────────────────────────────────

// _sfc_shr64: logical (unsigned) right shift for i64.
// NOVA >> is arithmetic; this clears the sign-extended high bits.
fn _sfc_shr64(x, n)
    let mask = (1 << (64 - n)) - 1
    return (x >> n) & mask

// _sfc_rotl64: left rotation of a 64-bit value by r positions.
fn _sfc_rotl64(x, r)
    let rr = r & 63
    if rr == 0
        return x
    return (x << rr) | _sfc_shr64(x, 64 - rr)

// _sfc_m63: 2^63 - 1 mask for clearing the sign bit.
fn _sfc_m63()
    return 9223372036854775807

// ── sfc_seed ─────────────────────────────────────────────────────────────────
// Create a new SFC64 state dict seeded with `seed`.
// The state is warmed up with 12 next() calls to break structural correlations
// that arise from the a=b=c=seed initial state.
fn sfc_seed(seed)
    let st = {}
    st["a"] = seed
    st["b"] = seed
    st["c"] = seed
    st["k"] = 1
    // warm-up: 12 discarded outputs to mix state thoroughly
    for i in 0..12
        let tmp = st["a"] + st["b"] + st["k"]
        st["k"] = st["k"] + 1
        st["a"] = st["b"] ^ _sfc_shr64(st["b"], 11)
        st["b"] = st["c"] + (st["c"] << 3)
        st["c"] = _sfc_rotl64(st["c"], 24) + tmp
    return st

// ── sfc_next ─────────────────────────────────────────────────────────────────
// Advance the SFC64 state in-place; return the next raw 64-bit output word.
// The returned value may be negative (bit 63 set in signed i64 view).
fn sfc_next(rng)
    let tmp = rng["a"] + rng["b"] + rng["k"]
    rng["k"] = rng["k"] + 1
    rng["a"] = rng["b"] ^ _sfc_shr64(rng["b"], 11)
    rng["b"] = rng["c"] + (rng["c"] << 3)
    rng["c"] = _sfc_rotl64(rng["c"], 24) + tmp
    return tmp

// ── sfc_next_range ───────────────────────────────────────────────────────────
// Return a uniformly distributed int in [0, n).
// The raw 64-bit output is masked to 63 bits (clear sign bit) before modulo
// so the result is always non-negative regardless of the raw word's sign.
fn sfc_next_range(rng, n)
    let raw = sfc_next(rng)
    let m63 = _sfc_m63()
    let pos = raw & m63
    return pos % n
