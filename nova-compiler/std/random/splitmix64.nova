// std/random/splitmix64 -- SplitMix64 PRNG (Steele et al. 2014).
//
// SplitMix64 is a high-quality, fast 64-bit PRNG used as the default
// seeder for many modern generators (xoshiro256, PCG, etc.).
// State = one i64 counter; each call increments by the golden-ratio
// constant and mixes through two multiply-xorshift rounds.
//
// Algorithm (Steele et al. 2014 / Java SplittableRandom):
//   state += C1            (C1 = 0x9E3779B97F4A7C15 -- Fibonacci hashing)
//   z = state
//   z = (z ^ shr64(z,30)) * C2   (C2 = 0xBF58476D1CE4E5B9)
//   z = (z ^ shr64(z,27)) * C3   (C3 = 0x94D049BB133111EB)
//   return z ^ shr64(z,31)
//
// NOVA arithmetic notes:
//   * i64 + and * wrap mod 2^64 naturally -- correct for PRNG arithmetic.
//   * >> is arithmetic (sign-extending).  _sm_shr64 applies a logical mask.
//   * Constants > 2^63 are built from 32-bit halves to stay in i64 literals.
//   * sm_next returns the full 64-bit word (may be negative as signed i64).
//   * sm_next_range masks to 63 bits before modulo to guarantee non-negative.
//
// Public API:
//   sm_seed(seed)         -> dict   create a new SplitMix64 state dict {"s": seed}
//   sm_next(rng)          -> int    advance state, return raw 64-bit output word
//   sm_next_range(rng, n) -> int    uniform in [0, n)

// ── private helpers ──────────────────────────────────────────────────────────

// _sm_shr64: logical (unsigned) right shift for i64.
// NOVA >> is arithmetic; this masks out the sign-extended bits.
fn _sm_shr64(x, n)
    let mask = (1 << (64 - n)) - 1
    return (x >> n) & mask

// _sm_c1: Fibonacci hashing increment (0x9E3779B97F4A7C15).
// Built from two 32-bit halves to avoid literal overflow.
fn _sm_c1()
    return (0x9E3779B9 << 32) | 0x7F4A7C15

// _sm_c2: first mix multiplier (0xBF58476D1CE4E5B9).
fn _sm_c2()
    return (0xBF58476D << 32) | 0x1CE4E5B9

// _sm_c3: second mix multiplier (0x94D049BB133111EB).
fn _sm_c3()
    return (0x94D049BB << 32) | 0x133111EB

// _sm_m63: 2^63 - 1 mask for sign-bit stripping.
fn _sm_m63()
    return 9223372036854775807

// ── sm_seed ──────────────────────────────────────────────────────────────────
// Create a new SplitMix64 state dict seeded with `seed`.
// Any integer (including 0) is a valid seed; the state is the seed itself.
fn sm_seed(seed)
    return {"s": seed}

// ── sm_next ──────────────────────────────────────────────────────────────────
// Advance the PRNG state in-place; return the next raw 64-bit output.
// The returned value may be negative (bit 63 set) -- use sm_next_range for
// bounded non-negative integers.
fn sm_next(rng)
    let c1 = _sm_c1()
    let c2 = _sm_c2()
    let c3 = _sm_c3()
    let s = rng["s"] + c1
    rng["s"] = s
    let z = s
    let z2 = (z ^ _sm_shr64(z, 30)) * c2
    let z3 = (z2 ^ _sm_shr64(z2, 27)) * c3
    return z3 ^ _sm_shr64(z3, 31)

// ── sm_next_range ─────────────────────────────────────────────────────────────
// Return a uniformly distributed int in [0, n).
// The raw 64-bit output is masked to 63 bits (clearing sign) before modulo
// so the result is always non-negative regardless of the raw word's sign.
fn sm_next_range(rng, n)
    let raw = sm_next(rng)
    let m63 = _sm_m63()
    let pos = raw & m63
    return pos % n
