// std/random/lfsr -- Linear-feedback shift registers (Galois + Fibonacci, 16-bit).
//
// Two distinct LFSR engines, both 16-bit with period 65535 (maximal):
//
//   Galois LFSR  (taps 0xB400)
//     State = single 16-bit register.  Each step: shift right 1; if the evicted
//     LSB was 1, XOR the register with the polynomial mask 0xB400.
//     The generator produces one output bit per step (the evicted LSB), and the
//     register value itself is the internal state.
//
//   Fibonacci LFSR  (taps 16,14,13,11 — i.e. bits 15,13,12,10 zero-indexed)
//     Feedback = XOR of those four bits; shift left 1; insert feedback at LSB.
//
// Both have a true period of 65535 (all non-zero 16-bit states are visited).
//
// Public API:
//   galois_seed(seed)          -> dict   new Galois LFSR state (register in "r")
//   galois_next(rng)           -> int    one step; returns new 16-bit register value
//   galois_bits(rng, k)        -> int    k output bits as integer (LSB = first bit)
//   galois_next_range(rng, n)  -> int    uniform in 0..n-1 using galois_next
//
//   fib_seed(seed)             -> dict   new Fibonacci LFSR state
//   fib_next(rng)              -> int    one step; returns new 16-bit register value
//   fib_next_range(rng, n)     -> int    uniform in 0..n-1 using fib_next
//
// Seeding: seed=0 is disallowed (LFSR stuck at 0 forever); substituted with 1.
// State is masked to 16 bits (0xFFFF) at every step for portability.
//
// All state lives in a dict with key "r" (the 16-bit register).

// ── private helpers ──────────────────────────────────────────────────────────

fn _lfsr_mask(x: int) -> int
    return x & 65535

fn _lfsr_safe_seed(seed: int) -> int
    let s = _lfsr_mask(seed)
    if s == 0
        s = 1
    return s

// ── galois_seed ──────────────────────────────────────────────────────────────
// Create a Galois LFSR state dict.  seed is masked to 16 bits; 0 -> 1.
fn galois_seed(seed: int) -> dict
    let rng = {}
    rng["r"] = _lfsr_safe_seed(seed)
    return rng

// ── galois_next ──────────────────────────────────────────────────────────────
// Advance the Galois LFSR one step in place.  Returns the new 16-bit register.
// Algorithm: lsb = r & 1; r >>= 1; if lsb then r ^= 0xB400.
// The returned value is the register *after* the step.
fn galois_next(rng: dict) -> int
    let r = rng["r"]
    let lsb = r & 1
    let r2 = r >> 1
    if lsb == 1
        r2 = r2 ^ 46080
    rng["r"] = _lfsr_mask(r2)
    return _lfsr_mask(r2)

// ── galois_bits ──────────────────────────────────────────────────────────────
// Collect k output bits from the Galois LFSR, packed into an integer.
// Bit 0 of the result is the FIRST bit clocked out (LSB-first order).
// Each bit is the LSB of the register BEFORE that step's shift.
fn galois_bits(rng: dict, k: int) -> int
    let result = 0
    for i in 0..k
        let r = rng["r"]
        let bit = r & 1
        let r2 = r >> 1
        if bit == 1
            r2 = r2 ^ 46080
        rng["r"] = _lfsr_mask(r2)
        if bit == 1
            result = result | (1 << i)
    return result

// ── galois_next_range ────────────────────────────────────────────────────────
// Return a uniformly distributed int in [0, n-1] using galois_next.
// Bias is negligible when n << 65535.
fn galois_next_range(rng: dict, n: int) -> int
    let v = galois_next(rng)
    return v % n

// ── fib_seed ─────────────────────────────────────────────────────────────────
// Create a Fibonacci LFSR state dict.  seed is masked to 16 bits; 0 -> 1.
fn fib_seed(seed: int) -> dict
    let rng = {}
    rng["r"] = _lfsr_safe_seed(seed)
    return rng

// ── fib_next ─────────────────────────────────────────────────────────────────
// Advance the Fibonacci LFSR one step in place.  Returns new 16-bit register.
// Taps at bit positions 16,14,13,11 (1-indexed) = bits 15,13,12,10 (0-indexed).
// feedback = bit15 XOR bit13 XOR bit12 XOR bit10
// register = ((r << 1) & 0xFFFF) | feedback
fn fib_next(rng: dict) -> int
    let r = rng["r"]
    let b15 = (r >> 15) & 1
    let b13 = (r >> 13) & 1
    let b12 = (r >> 12) & 1
    let b10 = (r >> 10) & 1
    let fb = b15 ^ b13
    fb = fb ^ b12
    fb = fb ^ b10
    let r2 = _lfsr_mask(r << 1) | fb
    rng["r"] = r2
    return r2

// ── fib_next_range ───────────────────────────────────────────────────────────
// Return a uniformly distributed int in [0, n-1] using fib_next.
fn fib_next_range(rng: dict, n: int) -> int
    let v = fib_next(rng)
    return v % n
