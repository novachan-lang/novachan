// std/random/xoshiro128 -- xoshiro128+ PRNG (32-bit, 4x32 state).
//
// Algorithm: xoshiro128+ by Blackman & Vigna (2018)
//   next = s0 + s3  (masked to 32 bits -- the "+" scrambler)
//   t    = s1 << 9  (masked to 32 bits)
//   s2  ^= s0
//   s3  ^= s1
//   s1  ^= s2
//   s0  ^= s3
//   s2  ^= t
//   s3   = rotl32(s3, 11)
//   return next
//
// Seeding: the 4 state words are initialised via 4 consecutive SplitMix32 steps
// starting from the caller's seed (32-bit view).  SplitMix32 is the standard
// recommended seeding method for the xoshiro family.
//
// State lives in a dict: keys "s0".."s3", all ints, all masked to 0xFFFFFFFF.
//
// NOVA 32-BIT ARITHMETIC NOTES:
//   * All 32-bit values are held as i64 but kept in [0, 2^32).
//   * >> in NOVA is arithmetic (sign-extending); because we always mask to
//     0xFFFFFFFF the values are never negative, so >> behaves as logical >>.
//   * + and * wrap at 2^64 (i64); we must apply _m32 after every add/mul
//     to stay within 32 bits.
//   * XOR of two values each in [0,2^32) stays in [0,2^32) -- no extra mask.
//
// Public API:
//   xo128_seed(seed)           -> dict  create generator state dict
//   xo128_next(rng)            -> int   advance state in-place; raw 32-bit output
//   xo128_next_range(rng, n)   -> int   uniform in [0, n)

// ── 32-bit helpers ───────────────────────────────────────────────────────────

fn _m32(x)
    return x & 0xFFFFFFFF

fn _rotl32(x, r)
    let rr = r & 31
    return ((x << rr) | (x >> (32 - rr))) & 0xFFFFFFFF

// ── SplitMix32 step ──────────────────────────────────────────────────────────
// Standard 32-bit finaliser used to expand a seed into 4 independent words.
// Each call takes the previous output word and produces the next one.
fn _sm32_step(x)
    let a = _m32(x + 0x9E3779B9)
    let b = _m32((a ^ (a >> 16)) * 0x85EBCA6B)
    let c = _m32((b ^ (b >> 13)) * 0xC2B2AE35)
    return _m32(c ^ (c >> 16))

// ── xo128_seed ───────────────────────────────────────────────────────────────
// Create a new xoshiro128+ state dict, seeded deterministically from seed_int.
// seed=0 is valid (SplitMix32 handles it without degenerating).
fn xo128_seed(seed_int)
    let sv = _m32(seed_int)
    let w0 = _sm32_step(sv)
    let w1 = _sm32_step(w0)
    let w2 = _sm32_step(w1)
    let w3 = _sm32_step(w2)
    let rng = {}
    rng["s0"] = w0
    rng["s1"] = w1
    rng["s2"] = w2
    rng["s3"] = w3
    return rng

// ── xo128_next ───────────────────────────────────────────────────────────────
// Advance the generator in-place and return the next 32-bit value.
fn xo128_next(rng)
    let s0 = rng["s0"]
    let s1 = rng["s1"]
    let s2 = rng["s2"]
    let s3 = rng["s3"]
    let result = _m32(s0 + s3)
    let t = _m32(s1 << 9)
    let ns2 = (s2 ^ s0) & 0xFFFFFFFF
    let ns3 = (s3 ^ s1) & 0xFFFFFFFF
    let ns1 = (s1 ^ ns2) & 0xFFFFFFFF
    let ns0 = (s0 ^ ns3) & 0xFFFFFFFF
    let ns2b = (ns2 ^ t) & 0xFFFFFFFF
    let ns3b = _rotl32(ns3, 11)
    rng["s0"] = ns0
    rng["s1"] = ns1
    rng["s2"] = ns2b
    rng["s3"] = ns3b
    return result

// ── xo128_next_range ─────────────────────────────────────────────────────────
// Return a uniformly distributed int in [0, n).
// Uses simple modulo reduction (slight bias for non-power-of-2 n; acceptable
// for general-purpose use -- bias is < 2^-32 for n < 2^16).
fn xo128_next_range(rng, n)
    let v = xo128_next(rng)
    return v % n
