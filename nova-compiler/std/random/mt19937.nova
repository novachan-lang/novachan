// std/random/mt19937 -- Mersenne Twister MT19937 (32-bit) PRNG.
//
// Algorithm: Matsumoto & Nishimura, "Mersenne Twister: A 623-Dimensionally
// Equidistributed Uniform Pseudo-Random Number Generator", ACM TOMACS 1998.
// This is the canonical 32-bit MT19937 with the standard reference seeding.
//
// State representation — a dict with two fields:
//   "arr" -> list of 624 ints  (the MT state array, 32-bit words)
//   "idx" -> int               (current index; 624 = needs twist)
//
// On creation via mt_seed(seed), the state is fully initialised.  The first
// call to mt_next() will twist and produce word 0 of the first block.
//
// Public API:
//   mt_seed(seed)           -> dict   create a new seeded PRNG state
//   mt_next(rng)            -> int    advance state, return next 32-bit word
//   mt_next_range(rng, n)   -> int    uniform int in [0, n)
//
// ALGORITHM CONSTANTS (32-bit):
//   N            = 624
//   M            = 397
//   MATRIX_A     = 0x9908B0DF  = 2567483615
//   UPPER_MASK   = 0x80000000  = 2147483648
//   LOWER_MASK   = 0x7FFFFFFF  = 2147483647
//   TEMPER_B     = 0x9D2C5680  = 2636928640
//   TEMPER_C     = 0xEFC60000  = 4022730752
//
// NOVA arithmetic notes:
//   * NOVA integers are signed i64; 32-bit MT words are unsigned 32-bit.
//   * We call _mt_m32(x) = x & 0xFFFFFFFF after every multiply/combine to keep
//     values in [0, 2^32-1] so that >> acts as a logical right shift.
//   * Multiplication wraps naturally mod 2^64 (NOVA spec), so no mask is needed
//     on multiply inputs — just mask the OUTPUT with _mt_m32.
//   * All shift amounts for 32-bit operations are small (7, 11, 15, 18, 30).
//   * Push-then-index: initialise the list with push(0) in a loop, THEN use
//     arr[i] = value for indexed writes.

// ── Private helpers ───────────────────────────────────────────────────────────

// _mt_m32: mask to 32 bits.
fn _mt_m32(x)
    return x & 4294967295

// _mt_twist: regenerate all 624 state words (called when idx == 624).
// N=624, M=397, MATRIX_A=2567483615, UPPER_MASK=2147483648, LOWER_MASK=2147483647
fn _mt_twist(arr)
    let upper = 2147483648
    let lower = 2147483647
    let mata  = 2567483615
    let n     = 624
    let m     = 397
    let i     = 0
    while i < n
        let hi   = arr[i] & upper
        let inxt = (i + 1) % n
        let lo   = arr[inxt] & lower
        let y    = hi | lo
        let ysh  = y >> 1
        let imm  = (i + m) % n
        let base = arr[imm] ^ ysh
        let lsb  = y & 1
        if lsb == 1
            arr[i] = base ^ mata
        if lsb == 0
            arr[i] = base
        i = i + 1

// _mt_temper: apply the MT tempering transform to a 32-bit word.
// All intermediate values kept masked to 32 bits.
fn _mt_temper(y0)
    let tb = 2636928640
    let tc = 4022730752
    let y1 = y0 ^ (y0 >> 11)
    let y2 = y1 ^ ((y1 << 7) & tb)
    let y2m = _mt_m32(y2)
    let y3 = y2m ^ ((_mt_m32(y2m << 15)) & tc)
    let y4 = y3 ^ (y3 >> 18)
    return _mt_m32(y4)

// ── Public API ────────────────────────────────────────────────────────────────

// mt_seed(seed) -> dict
// Create a new MT19937 state seeded with 'seed' (any int).
// Uses the standard init_genrand seeding algorithm:
//   mt[0] = seed & 0xFFFFFFFF
//   mt[i] = _m32(1812433253 * (mt[i-1] ^ (mt[i-1] >> 30)) + i)
fn mt_seed(seed)
    let n   = 624
    let mul = 1812433253
    // Allocate state array: push 624 zeros first, then fill via indexed write.
    let arr = []
    let k   = 0
    while k < n
        arr.push(0)
        k = k + 1
    // Set first word
    arr[0] = _mt_m32(seed)
    // Fill remaining words
    let i = 1
    while i < n
        let prev = arr[i - 1]
        let xr   = prev ^ (prev >> 30)
        let val  = _mt_m32(mul * xr + i)
        arr[i]   = val
        i        = i + 1
    // idx = 624 means "twist needed before first output"
    let rng = {}
    rng["arr"] = arr
    rng["idx"] = 624
    return rng

// mt_next(rng) -> int
// Advance the MT state and return the next 32-bit word (in [0, 2^32-1]).
// Mutates rng["idx"] (and rng["arr"] during the twist step).
fn mt_next(rng)
    let idx = rng["idx"]
    if idx >= 624
        _mt_twist(rng["arr"])
        rng["idx"] = 0
        idx        = 0
    let arr = rng["arr"]
    let raw = arr[idx]
    rng["idx"] = idx + 1
    return _mt_temper(raw)

// mt_next_range(rng, n) -> int
// Return a uniform integer in [0, n).
// Uses modulo reduction (bias is negligible for small n relative to 2^32).
fn mt_next_range(rng, n)
    let v = mt_next(rng)
    return v % n
