// std/random/shuffle -- Deterministic seeded shuffling via a self-contained 64-bit LCG.
//
// All functions accept a seed (int) and return a NEW list.  No global state.
// Same seed -> same output always (deterministic / reproducible).
//
// Embedded LCG (Knuth multiplicative congruential):
//   state = (state * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF
// To keep state non-negative on NOVA's i64, we mask to 63 bits after each step
// (clear the sign bit): state & 0x7FFFFFFFFFFFFFFF.  Range reduction uses modulo.
//
// Public API:
//   sh_shuffle(items, seed) -> list        Fisher-Yates; returns NEW list, input unchanged
//   sh_shuffled_range(n, seed) -> list     shuffle of [0 .. n-1]
//   sh_choice(items, seed) -> element      uniformly random element
//   sh_sample(items, k, seed) -> list      k DISTINCT elements, no replacement
//
// NOVA GOTCHAS obeyed:
//   * >> is arithmetic -- mask with & before using as unsigned
//   * No multi-line list/dict literals
//   * '{'/'}' in strings interpolate -- avoid in module
//   * Bare complex float expr as return -> bind to let first
//   * Unused local = compile error; don't bind values you never read
//   * Integer division is truncating; no implicit int->float

// ── Private LCG helpers ──────────────────────────────────────────────────────

// _sh_lcg_step: advance one LCG step, return non-negative 63-bit int.
// We mask to 63 bits to stay positive (NOVA integers are signed i64).
fn _sh_lcg_step(state: int) -> int
    let a = 6364136223846793005
    let c = 1442695040888963407
    // Multiply then add; mask full 64 bits first to keep in range,
    // then clear sign bit to stay non-negative.
    let raw = state * a + c
    raw & 0x7FFFFFFFFFFFFFFF

// _sh_lcg_range: advance state, return [value_in_0..hi_inclusive, next_state].
// hi must be >= 0.
fn _sh_lcg_range(state: int, hi: int) -> list
    let ns = _sh_lcg_step(state)
    if hi <= 0
        return [0, ns]
    let v = ns % (hi + 1)
    [v, ns]

// ── Private list copy ────────────────────────────────────────────────────────

fn _sh_copy(xs: list) -> list
    xs[0..len(xs)]

// ── sh_shuffle ───────────────────────────────────────────────────────────────
// Fisher-Yates (Knuth) shuffle on a COPY of items.
// The original list is NOT mutated.
// Returns a new list that is a permutation of items.
fn sh_shuffle(items: list, seed: int) -> list
    let buf = _sh_copy(items)
    let n = len(buf)
    let st = seed
    let i = n - 1
    while i > 0
        let step = _sh_lcg_range(st, i)
        let j = step[0]
        st = step[1]
        let tmp = buf[i]
        buf[i] = buf[j]
        buf[j] = tmp
        i -= 1
    buf

// ── sh_shuffled_range ────────────────────────────────────────────────────────
// Build [0, 1, ..., n-1] then shuffle it.
// Returns a new list that is a permutation of [0..n-1].
fn sh_shuffled_range(n: int, seed: int) -> list
    let xs = [i for i in 0..n]
    sh_shuffle(xs, seed)

// ── sh_choice ────────────────────────────────────────────────────────────────
// Return one uniformly random element from items.
// If items is empty, returns null.
fn sh_choice(items: list, seed: int)
    let n = len(items)
    if n == 0
        return null
    let step = _sh_lcg_range(seed, n - 1)
    let idx = step[0]
    items[idx]

// ── sh_sample ────────────────────────────────────────────────────────────────
// Return k DISTINCT elements from items (without replacement).
// Uses a partial Fisher-Yates: swap into front k slots then return those.
// If k >= len(items), returns a full shuffle.
fn sh_sample(items: list, k: int, seed: int) -> list
    let n = len(items)
    if k <= 0
        return []
    let take = k
    if take > n
        take = n
    let buf = _sh_copy(items)
    let st = seed
    for i in 0..take
        // Pick j in [i, n-1] via LCG on span [0, n-1-i]
        let hi = n - 1 - i
        let step = _sh_lcg_range(st, hi)
        let jrel = step[0]
        st = step[1]
        let j = i + jrel
        let tmp = buf[i]
        buf[i] = buf[j]
        buf[j] = tmp
    // Collect first `take` elements
    buf[0..take]
