// std/random/well512 -- WELL512a (32-bit, 16-word state) PRNG.
//
// Algorithm: Panneton, L'Ecuyer, Matsumoto (2006),
//   "Improved Long-Period Generators Based on Linear Recurrences Modulo 2",
//   ACM Transactions on Mathematical Software, Vol. 32, No. 1, pp. 1-16.
//   Period: 2^512 - 1.  Passes BigCrush.  Smaller state than MT19937.
//
// WELL512a recurrence parameters:
//   R=16 (16 state words), M1=13, M2=9, M3=7
//   Output word size: 32 bits.
//
// Per-step transforms (macro expansion of reference C source):
//   z0    = state[(i+15) & 0x0f]
//   z1    = MAT0NEG(-16, V0) ^ MAT0NEG(-15, VM1)
//         = (V0 ^ (V0<<16)) ^ (VM1 ^ (VM1<<15))   [masked to 32 bits]
//   z2    = MAT0POS(11, VM2) = VM2 ^ (VM2>>11)
//   newV1 = state[i]         = z1 ^ z2
//   newV0 = state[(i+15)&0f] = MAT0NEG(-2,z0) ^ MAT0NEG(-18,z1) ^
//                              MAT3NEG(-28,z2) ^ MAT4NEG(-5,0xda442d24,VM3)
//         = (z0 ^ (z0<<2)) ^ (z1 ^ (z1<<18)) ^ (z2<<28) ^
//           (VM3 ^ ((VM3<<5) & 0xda442d24))
//   i     = (i + 15) & 0x0f
//   return state[i]   -- which is newV0
//
// Seeding: 16 words filled by an LCG  s_{k+1} = 1664525 * s_k + 1013904223 (mod 2^32).
// All state words are 32-bit values stored in i64 (always >= 0 and <= 2^32-1).
//
// State dict keys:
//   "s0".."s15"  -- the 16 state words (32-bit each, stored as non-negative i64)
//   "i"          -- current index (0..15)
//
// Public API:
//   well_seed(seed)         -> dict   create a seeded WELL512a generator
//   well_next(rng)          -> int    advance state, return 32-bit word [0, 2^32)
//   well_next_range(rng, n) -> int    uniform int in [0, n)

// ── Private helpers ───────────────────────────────────────────────────────────

// _well_m32: mask to 32 bits (keep value in [0, 2^32-1]).
fn _well_m32(x)
    return x & 4294967295

// _well_get: read state word at index k from the state dict.
fn _well_get(rng, k)
    if k == 0
        return rng["s0"]
    if k == 1
        return rng["s1"]
    if k == 2
        return rng["s2"]
    if k == 3
        return rng["s3"]
    if k == 4
        return rng["s4"]
    if k == 5
        return rng["s5"]
    if k == 6
        return rng["s6"]
    if k == 7
        return rng["s7"]
    if k == 8
        return rng["s8"]
    if k == 9
        return rng["s9"]
    if k == 10
        return rng["s10"]
    if k == 11
        return rng["s11"]
    if k == 12
        return rng["s12"]
    if k == 13
        return rng["s13"]
    if k == 14
        return rng["s14"]
    return rng["s15"]

// _well_set: write state word at index k into the state dict.
fn _well_set(rng, k, v)
    if k == 0
        rng["s0"] = v
    if k == 1
        rng["s1"] = v
    if k == 2
        rng["s2"] = v
    if k == 3
        rng["s3"] = v
    if k == 4
        rng["s4"] = v
    if k == 5
        rng["s5"] = v
    if k == 6
        rng["s6"] = v
    if k == 7
        rng["s7"] = v
    if k == 8
        rng["s8"] = v
    if k == 9
        rng["s9"] = v
    if k == 10
        rng["s10"] = v
    if k == 11
        rng["s11"] = v
    if k == 12
        rng["s12"] = v
    if k == 13
        rng["s13"] = v
    if k == 14
        rng["s14"] = v
    if k == 15
        rng["s15"] = v
    return 0

// ── Public API ────────────────────────────────────────────────────────────────

// well_seed(seed) -> dict
// Create a WELL512a generator seeded deterministically from seed.
// The 16 state words are filled via the Borland/NR LCG:
//   s_next = (1664525 * s + 1013904223) mod 2^32
fn well_seed(seed)
    let lcg_mul = 1664525
    let lcg_add = 1013904223
    let s = _well_m32(seed)
    let rng = {}
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s0"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s1"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s2"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s3"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s4"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s5"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s6"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s7"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s8"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s9"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s10"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s11"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s12"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s13"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s14"] = s
    s = _well_m32(lcg_mul * s + lcg_add)
    rng["s15"] = s
    rng["i"] = 0
    return rng

// well_next(rng) -> int
// Advance the WELL512a generator by one step; return the 32-bit output word.
// All 32-bit intermediate values are masked with _well_m32 after each left-shift
// or multiplication to prevent sign-bit contamination in NOVA's i64 arithmetic.
//
// C macro expansion (exact WELL512a from Panneton et al.):
//   z0    = state[(i+15)&0f]
//   z1    = (V0 ^ (V0<<16)) ^ (VM1 ^ (VM1<<15))   [both masked 32-bit]
//   z2    = VM2 ^ (VM2>>11)                         [>> on >=0 value = logical]
//   state[i]           = z1 ^ z2
//   state[(i+15)&0f]   = (z0 ^ (z0<<2)) ^ (z1 ^ (z1<<18)) ^
//                        (z2<<28) ^ (VM3 ^ ((VM3<<5) & 0xda442d24))
//   i     = (i+15) & 0x0f
//   return state[i]    -- this is the newV0 just written above
fn well_next(rng)
    let ci = rng["i"]
    let m1 = 13
    let m2 = 9
    let m3 = 7
    let mask_b = 3661901092

    let i15 = (ci + 15) & 15
    let im1 = (ci + m1) & 15
    let im2 = (ci + m2) & 15
    let im3 = (ci + m3) & 15

    let v0   = _well_get(rng, ci)
    let vm1  = _well_get(rng, im1)
    let vm2  = _well_get(rng, im2)
    let vm3  = _well_get(rng, im3)
    let vrm1 = _well_get(rng, i15)

    // z0 = VRm1 (read before any write)
    let z0 = vrm1

    // z1 = MAT0NEG(-16, V0) ^ MAT0NEG(-15, VM1)
    //    = (V0 ^ (V0<<16)) ^ (VM1 ^ (VM1<<15))
    let v0sh16 = _well_m32(v0 << 16)
    let v0mat  = v0 ^ v0sh16
    let vm1sh  = _well_m32(vm1 << 15)
    let vm1mat = vm1 ^ vm1sh
    let z1 = v0mat ^ vm1mat

    // z2 = MAT0POS(11, VM2) = VM2 ^ (VM2>>11)
    // vm2 is in [0, 2^32-1] so >> is logical (no sign extension)
    let z2 = vm2 ^ (vm2 >> 11)

    // newV1: state[ci] = z1 ^ z2
    let newv1 = z1 ^ z2
    _well_set(rng, ci, newv1)

    // newV0 = MAT0NEG(-2,z0) ^ MAT0NEG(-18,z1) ^ MAT3NEG(-28,z2) ^ MAT4NEG(-5,mask_b,VM3)
    //       = (z0^(z0<<2)) ^ (z1^(z1<<18)) ^ (z2<<28) ^ (vm3^((vm3<<5)&mask_b))
    let z0sh2  = _well_m32(z0 << 2)
    let z0mat  = z0 ^ z0sh2
    let z1sh18 = _well_m32(z1 << 18)
    let z1mat  = z1 ^ z1sh18
    let z2sh28 = _well_m32(z2 << 28)
    let vm3sh5 = _well_m32(vm3 << 5)
    let vm3mat = vm3 ^ (vm3sh5 & mask_b)
    let newv0  = z0mat ^ z1mat ^ z2sh28 ^ vm3mat

    // Write newV0 to state[(ci+15)&0x0f]
    _well_set(rng, i15, newv0)

    // Advance index: i = (i + 15) & 0x0f
    rng["i"] = i15

    // Return state[i] which is the newV0 just written
    return newv0

// well_next_range(rng, n) -> int
// Return a uniform integer in [0, n).
// Uses modulo reduction; bias is negligible for n << 2^32.
fn well_next_range(rng, n)
    let v = well_next(rng)
    return v % n
