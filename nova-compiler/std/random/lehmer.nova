// std/random/lehmer -- Lehmer MCG 64-bit PRNG (multiplicative congruential generator).
//
// Algorithm (Steele & Vigna 2021 / Knuth TAOCP):
//   state = state * M  (mod 2^64)
//   output_32 = state >> 32          (high 32 bits; always non-negative)
//   output_64 = state                (full 64-bit word; may be negative as signed i64)
//
// The multiplier M = 0xD1342543DE82EF95 is from Steele & Vigna "Computationally
// Easy, Spectrally Good Multipliers for Congruential Pseudorandom Number Generators"
// (2021) -- the best-known 64-bit MCG multiplier passing PractRand and BigCrush.
//
// Key properties:
//   * State is ALWAYS odd (because: odd * odd = odd in Z/2^64Z).
//     Seeding forces state = seed | 1 (never zero).
//   * Period = 2^62 (MCG with modulus 2^64 achieves period 2^62 for odd multiplier
//     and odd state -- the full period for the co-prime-to-modulus case).
//   * Output quality: high-32 output passes all statistical tests; full-64 has
//     known structure but is fast and useful as a seeder.
//   * Fastest 64-bit PRNG in NOVA (one multiply, no xors, no additions).
//
// NOVA arithmetic notes:
//   * i64 * wraps mod 2^64 automatically -- exactly right for MCG.
//   * i64 >> is ARITHMETIC (sign-extending). Use _lh_shr64 for logical right shift
//     to extract the high 32 bits when state has bit 63 set.
//   * The multiplier M > 2^63, so it must be built from two 32-bit halves.
//   * Constants: M_hi = 0xD1342543 = 3509855555; M_lo = 0xDE82EF95 = 3733122965.
//
// State dict keys:
//   "s"  -- current 64-bit state (always odd, never zero)
//
// Public API:
//   lehmer_seed(seed)          -> dict   create seeded generator
//   lehmer_next(rng)           -> int    advance state, return high 32 bits [0, 2^32)
//   lehmer_next64(rng)         -> int    advance state, return full 64-bit word (may be negative)
//   lehmer_next_range(rng, n)  -> int    uniform int in [0, n-1]

// ── private helpers ──────────────────────────────────────────────────────────

// _lh_shr64: logical (unsigned) right shift for i64.
// NOVA >> is arithmetic; mask clears sign-extended bits.
fn _lh_shr64(x, n)
    let mask = (1 << (64 - n)) - 1
    return (x >> n) & mask

// _lh_mult: the MCG multiplier 0xD1342543DE82EF95.
// Built from two 32-bit halves because the value exceeds 2^63.
// M_hi = 0xD1342543 = 3509855555, M_lo = 0xDE82EF95 = 3733122965.
fn _lh_mult()
    return (0xD1342543 << 32) | 0xDE82EF95

// _lh_mask32: mask for extracting 32-bit values.
fn _lh_mask32()
    return 4294967295

// _lh_m63: 2^63 - 1 -- for stripping the sign bit before modulo.
fn _lh_m63()
    return 9223372036854775807

// ── lehmer_seed ──────────────────────────────────────────────────────────────
// Create a new Lehmer MCG generator seeded with `seed`.
// Forces state to be odd (state = seed | 1). If that produces 0 (impossible
// for | 1 since 0 | 1 = 1), we use 1 as fallback -- never needed in practice.
// Any integer seed is valid.
fn lehmer_seed(seed)
    let st = {}
    let s = seed | 1
    if s == 0
        s = 1
    st["s"] = s
    return st

// ── lehmer_next ──────────────────────────────────────────────────────────────
// Advance the generator state and return the high 32 bits of the new state.
// Output is always in [0, 2^32-1] (non-negative).
// The state *= M multiplication wraps mod 2^64 automatically in NOVA.
fn lehmer_next(rng)
    let m = _lh_mult()
    let mask32 = _lh_mask32()
    let s = rng["s"] * m
    rng["s"] = s
    let out = _lh_shr64(s, 32) & mask32
    return out

// ── lehmer_next64 ────────────────────────────────────────────────────────────
// Advance the generator state and return the full 64-bit new state.
// The returned value may be negative (bit 63 set) when interpreted as signed i64.
// Useful as a fast seed mixer or when 64-bit output is needed.
fn lehmer_next64(rng)
    let m = _lh_mult()
    let s = rng["s"] * m
    rng["s"] = s
    return s

// ── lehmer_next_range ────────────────────────────────────────────────────────
// Return a uniformly distributed int in [0, n-1].
// Uses the 32-bit high output so the value is always non-negative.
// Bias: for n << 2^32 the modulo bias is negligible (< 1 part in 2^32 / n).
fn lehmer_next_range(rng, n)
    let v = lehmer_next(rng)
    return v % n
