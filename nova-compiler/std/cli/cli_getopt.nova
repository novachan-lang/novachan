// ============================================================================
// NOVA Standard Library — std/cli/cli_getopt
// Short-option clustering: expand '-abc' into '-a','-b','-c'.
// Pure string/list processing; no side effects, no environment access.
// ============================================================================
//
// clg_is_cluster(tok)        — bool: tok starts with single '-', len>2, no '='.
// clg_expand_clusters(argv)  — expand each cluster token in argv into individual
//                              single-char flags; long options and non-options
//                              are left untouched.
// clg_split_attached(tok)    — split '-ofile' into ['-o','file']; returns [tok]
//                              if tok is not a short-option with attached value.
// ============================================================================

// Internal: return 1 if string s starts with prefix p.
fn _clg_starts_with(s, p) -> int
    let pl = len(p)
    if pl == 0
        return 1
    if len(s) < pl
        return 0
    if slice(s, 0, pl) == p
        return 1
    return 0

// Internal: return 1 if character c (single-char string) appears in s.
fn _clg_has_char(s, c) -> int
    for i in 0..len(s)
        if slice(s, i, i+1) == c
            return 1
    return 0

// clg_is_cluster — true when tok is a short-option cluster: starts with exactly
// one '-' (not '--'), has more than 2 characters total, and contains no '='.
fn clg_is_cluster(tok) -> bool
    if len(tok) <= 2
        return false
    if _clg_starts_with(tok, "--") == 1
        return false
    if _clg_starts_with(tok, "-") == 0
        return false
    if _clg_has_char(tok, "=") == 1
        return false
    return true

// clg_expand_clusters — expand every cluster token in argv into individual
// single-char flag tokens; all other tokens pass through unchanged.
fn clg_expand_clusters(argv) -> list
    let result = []
    for i in 0..len(argv)
        let tok = argv[i]
        if clg_is_cluster(tok) == true
            // tok is like '-abc'; emit '-a', '-b', '-c'
            let j = 1
            while j < len(tok)
                push(result, "-" + slice(tok, j, j+1))
                j += 1
        else
            push(result, tok)
    return result

// clg_split_attached — split a short option with an attached value, e.g.
// '-ofile' -> ['-o','file']. Returns [tok] unchanged if tok does not look
// like a short option with an attached value (must start with '-' but not '--',
// and have length > 2).
fn clg_split_attached(tok) -> list
    let result = []
    if len(tok) <= 2
        push(result, tok)
        return result
    if _clg_starts_with(tok, "--") == 1
        push(result, tok)
        return result
    if _clg_starts_with(tok, "-") == 0
        push(result, tok)
        return result
    push(result, "-" + slice(tok, 1, 2))
    push(result, slice(tok, 2, len(tok)))
    return result
