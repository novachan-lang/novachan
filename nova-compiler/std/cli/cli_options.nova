// std/cli/cli_options -- Value-bearing option parsing. LEAF -- imports NOTHING.
//
// Options take a value, expressed as '--name value' or '--name=value'.
//
// Public API:
//   clo_get(argv, name) -> string
//     Return the value for option name, or '' if absent. '--name=value' and
//     '--name value' (next token) are both supported. First match wins.
//   clo_has(argv, name) -> bool
//     Return true if name is present in argv as a value-bearing option.
//   clo_get_default(argv, name, dflt) -> string
//     Return the value for option name, or dflt if absent.
//   clo_get_all(argv, name) -> list
//     Return all values supplied for a repeated option, in order.

// Internal: return 1 if string s starts with prefix p, else 0.
fn _clo_starts_with(s, p) -> int
    if len(p) > len(s)
        return 0
    if slice(s, 0, len(p)) == p
        return 1
    return 0

// Internal: find index of first '=' in s, return -1 if absent.
fn _clo_index_of_eq(s) -> int
    let i = 0
    while i < len(s)
        if slice(s, i, i+1) == "="
            return i
        i = i + 1
    return -1

// Internal: given a token like '--name=value', return the part before '=' excluding
// the leading '--' (i.e. 'name'). eq_pos is the index of '='.
fn _clo_tok_name(tok, eq_pos) -> string
    return slice(tok, 2, eq_pos)

// Internal: given '--name=value', return the part after '='.
fn _clo_tok_val(tok, eq_pos) -> string
    return slice(tok, eq_pos+1, len(tok))

// Internal: scan argv for option name; return value string or '' if absent.
// Returns the FIRST match.
fn _clo_scan(argv, name) -> string
    let i = 0
    let n = len(argv)
    // Build the '--name=' prefix for equality-style matching.
    let prefix_eq = name + "="
    while i < n
        let tok = argv[i]
        if tok == name
            // '--name value' form: consume next token.
            if i + 1 < n
                return argv[i+1]
            else
                return ""
        if _clo_starts_with(tok, prefix_eq) == 1
            // '--name=value' form.
            let eq_pos = _clo_index_of_eq(tok)
            return _clo_tok_val(tok, eq_pos)
        i = i + 1
    return ""

// Internal: return 1 if argv contains option name in either form.
fn _clo_present(argv, name) -> int
    let i = 0
    let n = len(argv)
    let prefix_eq = name + "="
    while i < n
        let tok = argv[i]
        if tok == name
            return 1
        if _clo_starts_with(tok, prefix_eq) == 1
            return 1
        i = i + 1
    return 0

// clo_get: return the first value for option name, or '' if absent.
fn clo_get(argv, name) -> string
    return _clo_scan(argv, name)

// clo_has: return true if option name appears in argv.
fn clo_has(argv, name) -> bool
    if _clo_present(argv, name) == 1
        return true
    return false

// clo_get_default: return the value for option name, or dflt if absent.
fn clo_get_default(argv, name, dflt) -> string
    if _clo_present(argv, name) == 1
        return _clo_scan(argv, name)
    return dflt

// clo_get_all: return all values for a repeated option, in the order they appear.
fn clo_get_all(argv, name) -> list
    let result = []
    let i = 0
    let n = len(argv)
    let prefix_eq = name + "="
    while i < n
        let tok = argv[i]
        if tok == name
            if i + 1 < n
                push(result, argv[i+1])
            else
                push(result, "")
            i = i + 2
        else
            if _clo_starts_with(tok, prefix_eq) == 1
                let eq_pos = _clo_index_of_eq(tok)
                push(result, _clo_tok_val(tok, eq_pos))
                i = i + 1
            else
                i = i + 1
    return result
