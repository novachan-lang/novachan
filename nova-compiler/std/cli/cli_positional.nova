// std/cli/cli_positional -- Positional argument extraction. LEAF -- imports NOTHING.
//
// Positional arguments are tokens that are NOT flags/options and NOT values consumed
// by value-options. This module handles '--' as the end-of-options sentinel.
//
// Public API:
//   clp_positionals(argv, value_opts) -> list
//     Extract positional arguments, skipping flags (tokens starting with '-'),
//     skipping value-options (tokens in value_opts) and their following value token,
//     and treating everything after a standalone '--' as positional.
//   clp_nth(argv, value_opts, n) -> string
//     Return the nth (0-indexed) positional argument, or '' if out of range.
//   clp_after_ddash(argv) -> list
//     Return all tokens that appear after a standalone '--' token.

// Internal: return 1 if s starts with prefix p, else 0.
fn _clp_starts_with(s, p) -> int
    if len(p) > len(s)
        return 0
    if slice(s, 0, len(p)) == p
        return 1
    return 0

// Internal: return 1 if list xs contains element v, else 0.
fn _clp_in_list(xs, v) -> int
    for i in 0..len(xs)
        if xs[i] == v
            return 1
    return 0

// Internal: return 1 if token tok is a value-option in the '--name=value' form
// where '--name' is in value_opts.
fn _clp_is_eq_opt(tok, value_opts) -> int
    if _clp_starts_with(tok, "--") == 0
        return 0
    // Find '=' in the token.
    for i in 2..len(tok)
        if slice(tok, i, i+1) == "="
            // Extract the name part including '--'.
            let nm = slice(tok, 0, i)
            return _clp_in_list(value_opts, nm)
    return 0

// clp_positionals: collect positional tokens, skipping option tokens and consumed values.
// Parsing rules (left-to-right):
//   '--'         : stop option scanning; all remaining tokens are positionals.
//   '--name=val' where '--name' in value_opts : skip (eq-form, no following token consumed).
//   token in value_opts : skip this token AND the next one (space-separated value).
//   token starting with '-' : skip (flag or unknown option).
//   otherwise : positional.
fn clp_positionals(argv, value_opts) -> list
    let result = []
    let i = 0
    let n = len(argv)
    while i < n
        let tok = argv[i]
        if tok == "--"
            // Everything after '--' is positional.
            i += 1
            while i < n
                push(result, argv[i])
                i += 1
        else
            if _clp_in_list(value_opts, tok) == 1
                // Value-option: skip this token and the following value token.
                i += 2
            else
                if _clp_is_eq_opt(tok, value_opts) == 1
                    // '--name=value' form: skip this single token.
                    i += 1
                else
                    if _clp_starts_with(tok, "-") == 1
                        // Flag or unknown option: skip.
                        i += 1
                    else
                        // Positional.
                        push(result, tok)
                        i += 1
    return result

// clp_nth: return the nth argument (0-indexed) after the first positional (command name).
// positionals[0] is treated as the command/program name; n=0 returns the first real
// argument (positionals[1]), n=1 the second (positionals[2]), etc. Returns '' if absent.
fn clp_nth(argv, value_opts, n) -> string
    let pos = clp_positionals(argv, value_opts)
    let idx = n + 1
    if idx < 0
        return ""
    if idx >= len(pos)
        return ""
    return pos[idx]

// clp_after_ddash: return all tokens after the first standalone '--' token.
fn clp_after_ddash(argv) -> list
    let result = []
    let i = 0
    let n = len(argv)
    while i < n
        if argv[i] == "--"
            i += 1
            while i < n
                push(result, argv[i])
                i += 1
            return result
        i += 1
    return result
