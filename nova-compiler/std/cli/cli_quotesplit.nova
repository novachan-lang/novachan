// ============================================================================
// NOVA Standard Library — std/cli/cli_quotesplit
// Command-line string tokeniser: splits on whitespace, respects single and
// double quoted regions, and can rejoin tokens with quoting where needed.
// Self-contained: no imports. All helpers are private (_-prefixed).
// ============================================================================

// Internal: return 1 if character at position i in s equals c, else 0.
fn _clq_char_eq(s, i, c) -> int
    if slice(s, i, i+1) == c
        return 1
    return 0

// Internal: is the character at i whitespace (space or tab)?
fn _clq_is_ws(s, i) -> int
    let ch = slice(s, i, i+1)
    if ch == " "
        return 1
    if ch == "\t"
        return 1
    return 0

// Public API ─────────────────────────────────────────────────────────────────

// clq_split: split a shell command line into tokens; quoted regions are kept
// together with the surrounding quote characters stripped.
fn clq_split(cmdline) -> list
    let tokens = []
    let n = len(cmdline)
    let i = 0
    while i < n
        // skip leading whitespace
        while i < n and _clq_is_ws(cmdline, i) == 1
            i = i + 1
        if i >= n
            return tokens
        // start of a token — collect until next unquoted whitespace
        let tok_parts = []
        let in_single = 0
        let in_double = 0
        let done = 0
        while i < n and done == 0
            let ch = slice(cmdline, i, i+1)
            if in_single == 1
                if ch == "'"
                    in_single = 0
                    i = i + 1
                else
                    push(tok_parts, ch)
                    i = i + 1
            else if in_double == 1
                if ch == "\""
                    in_double = 0
                    i = i + 1
                else
                    push(tok_parts, ch)
                    i = i + 1
            else if ch == "'"
                in_single = 1
                i = i + 1
            else if ch == "\""
                in_double = 1
                i = i + 1
            else if _clq_is_ws(cmdline, i) == 1
                done = 1
            else
                push(tok_parts, ch)
                i = i + 1
        let tok = join(tok_parts, "")
        push(tokens, tok)
    return tokens

// clq_needs_quoting: true if s contains a space or is empty (would be
// ambiguous without quotes when embedded in a command line).
fn clq_needs_quoting(s) -> bool
    if len(s) == 0
        return true
    for i in 0..len(s)
        let ch = slice(s, i, i+1)
        if ch == " "
            return true
        if ch == "\t"
            return true
    return false

// clq_join: join a list of argument strings with single spaces, wrapping any
// argument that needs quoting (see clq_needs_quoting) in double quotes.
fn clq_join(args) -> string
    let out_parts = []
    for i in 0..len(args)
        if i > 0
            push(out_parts, " ")
        let a = args[i]
        if clq_needs_quoting(a)
            push(out_parts, "\"" + a + "\"")
        else
            push(out_parts, a)
    let out = join(out_parts, "")
    return out
