// ============================================================================
// NOVA Standard Library — std/cli/cli_argparse
// Integrated argv parser. Classifies tokens as flags, value-options, or
// positionals; then provides focused accessor functions for each category.
// Self-contained: no imports.
// ============================================================================

// Internal: return 1 if string `s` starts with prefix `p`, else 0.
fn _cla_starts_with(s, p) -> int
    let pl = len(p)
    if len(s) < pl
        return 0
    if slice(s, 0, pl) == p
        return 1
    return 0

// Internal: return 1 if `name` is present in list `xs`, else 0.
fn _cla_in_list(xs, name) -> int
    let i = 0
    while i < len(xs)
        if xs[i] == name
            return 1
        i = i + 1
    return 0

// Internal: return the portion of `tok` after the first '=', or "" if absent.
fn _cla_after_eq(tok) -> string
    let i = 0
    while i < len(tok)
        if slice(tok, i, i+1) == "="
            return slice(tok, i+1, len(tok))
        i = i + 1
    return ""

// Internal: return the option name from a --name=value token (the part before
// the '='). Assumes the token starts with "--".
fn _cla_name_before_eq(tok) -> string
    let i = 0
    while i < len(tok)
        if slice(tok, i, i+1) == "="
            return slice(tok, 0, i)
        i = i + 1
    return tok

// Internal: does tok contain '='?
fn _cla_has_eq(tok) -> int
    let i = 0
    while i < len(tok)
        if slice(tok, i, i+1) == "="
            return 1
        i = i + 1
    return 0

// Public API ─────────────────────────────────────────────────────────────────

// cla_parse: parse argv using value_opts to distinguish value-options from
// boolean flags. Returns [flags_list, options_list, positionals_list] where
// flags_list = list of flag token strings (e.g. ["-v","--debug"]),
// options_list = list of [name, value] pairs for names found in value_opts,
// positionals_list = list of remaining non-option tokens.
fn cla_parse(argv, value_opts) -> list
    let flags = []
    let options = []
    let positionals = []
    let n = len(argv)
    let i = 0
    while i < n
        let tok = argv[i]
        if _cla_starts_with(tok, "-") == 1
            // option-like token
            if _cla_has_eq(tok) == 1
                // --name=value form
                let nm = _cla_name_before_eq(tok)
                let vl = _cla_after_eq(tok)
                if _cla_in_list(value_opts, nm) == 1
                    let pair = [nm, vl]
                    push(options, pair)
                else
                    // not a known value-opt: treat as flag
                    push(flags, tok)
                i = i + 1
            else if _cla_in_list(value_opts, tok) == 1
                // --name value form
                if i + 1 < n
                    let pair = [tok, argv[i+1]]
                    push(options, pair)
                    i = i + 2
                else
                    // option at end with no value — store empty string
                    let pair = [tok, ""]
                    push(options, pair)
                    i = i + 1
            else
                // boolean flag
                push(flags, tok)
                i = i + 1
        else
            push(positionals, tok)
            i = i + 1
    let result = [flags, options, positionals]
    return result

// cla_get_opt: return the value for `name` in value_opts, or '' if absent.
fn cla_get_opt(argv, value_opts, name) -> string
    let parsed = cla_parse(argv, value_opts)
    let opts = parsed[1]
    let i = 0
    while i < len(opts)
        let pair = opts[i]
        if pair[0] == name
            let pv = pair[1]
            return pv
        i = i + 1
    return ""

// cla_has_flag: true if `name` appears as a boolean flag (not a value-option).
fn cla_has_flag(argv, value_opts, name) -> bool
    let parsed = cla_parse(argv, value_opts)
    let flags = parsed[0]
    let i = 0
    while i < len(flags)
        if flags[i] == name
            return true
        i = i + 1
    return false

// cla_positionals: return the list of positional (non-option) tokens.
fn cla_positionals(argv, value_opts) -> list
    let parsed = cla_parse(argv, value_opts)
    let pos = parsed[2]
    return pos
