// std/relation/relation_set.nova — finite set algebra on subsets of {0..n-1}.
// Sets are SORTED distinct-int lists.  All operations produce sorted output.
// LEAF — imports NOTHING.

// rset_union: sorted union of two sorted int lists.
fn rset_union(a: list, b: list) -> list
    let result = []
    let i = 0
    let j = 0
    while i < len(a) and j < len(b)
        let av = a[i]
        let bv = b[j]
        if av < bv
            result.push(av)
            i += 1
        else
            if av > bv
                result.push(bv)
                j += 1
            else
                result.push(av)
                i += 1
                j += 1
    while i < len(a)
        result.push(a[i])
        i += 1
    while j < len(b)
        result.push(b[j])
        j += 1
    return result

// rset_intersect: sorted intersection of two sorted int lists.
fn rset_intersect(a: list, b: list) -> list
    let result = []
    let i = 0
    let j = 0
    while i < len(a) and j < len(b)
        let av = a[i]
        let bv = b[j]
        if av == bv
            result.push(av)
            i += 1
            j += 1
        else
            if av < bv
                i += 1
            else
                j += 1
    return result

// rset_difference: elements in a but not in b (both sorted).
fn rset_difference(a: list, b: list) -> list
    let result = []
    let i = 0
    let j = 0
    while i < len(a) and j < len(b)
        let av = a[i]
        let bv = b[j]
        if av < bv
            result.push(av)
            i += 1
        else
            if av == bv
                i += 1
                j += 1
            else
                j += 1
    while i < len(a)
        result.push(a[i])
        i += 1
    return result

// rset_symdiff: symmetric difference = elements in exactly one of a or b.
fn rset_symdiff(a: list, b: list) -> list
    let result = []
    let i = 0
    let j = 0
    while i < len(a) and j < len(b)
        let av = a[i]
        let bv = b[j]
        if av < bv
            result.push(av)
            i += 1
        else
            if av > bv
                result.push(bv)
                j += 1
            else
                i += 1
                j += 1
    while i < len(a)
        result.push(a[i])
        i += 1
    while j < len(b)
        result.push(b[j])
        j += 1
    return result

// rset_is_subset: true iff every element of a is also in b.
fn rset_is_subset(a: list, b: list) -> bool
    let i = 0
    let j = 0
    while i < len(a) and j < len(b)
        let av = a[i]
        let bv = b[j]
        if av == bv
            i += 1
            j += 1
        else
            if av < bv
                return false
            else
                j += 1
    if i < len(a)
        return false
    return true

// rset_is_disjoint: true iff a and b share no elements.
fn rset_is_disjoint(a: list, b: list) -> bool
    let i = 0
    let j = 0
    while i < len(a) and j < len(b)
        let av = a[i]
        let bv = b[j]
        if av == bv
            return false
        else
            if av < bv
                i += 1
            else
                j += 1
    return true

// rset_powerset: returns list of all 2^|elems| subsets of elems (each sorted).
// Uses iterative bit-mask enumeration: mask in 0..2^n-1; bit k set => include elems[k].
fn rset_powerset(elems: list) -> list
    let n = len(elems)
    let total = 1
    for t in 0..n
        total = total * 2
    let acc = []
    for mask in 0..total
        let sub = []
        for bit in 0..n
            if (mask >> bit) & 1 == 1
                sub.push(elems[bit])
        acc.push(sub)
    return acc

// rset_cartesian: list of all pairs [x,y] for x in a, y in b (in order).
fn rset_cartesian(a: list, b: list) -> list
    let result = []
    for i in 0..len(a)
        for j in 0..len(b)
            let pair = []
            pair.push(a[i])
            pair.push(b[j])
            result.push(pair)
    return result
