// std/relation/relation_components.nova — connected components via symmetric closure.
// Relation M is an n x n boolean matrix (list of n rows, each a list of n ints 0/1).
// Vertices are integers 0..n-1.  Union-Find with path compression and union-by-rank.
// LEAF — imports NOTHING.

// _rcmp_make_parent: create parent array (list of n ints, parent[i]=i initially).
fn _rcmp_make_parent(n: int) -> list
    let parent = []
    for i in 0..n
        parent.push(i)
    return parent

// _rcmp_make_rank: create rank array (list of n zeros).
fn _rcmp_make_rank(n: int) -> list
    let rank = []
    let i = 0
    while i < n
        rank.push(0)
        i += 1
    return rank

// _rcmp_find: iterative path-halving find.  Returns root of v in parent array.
fn _rcmp_find(parent: list, v: int) -> int
    let cur = v
    while parent[cur] != cur
        let grandparent = parent[parent[cur]]
        parent[cur] = grandparent
        cur = grandparent
    return cur

// _rcmp_union: union by rank.  Merges components of a and b.
fn _rcmp_union(parent: list, rank: list, a: int, b: int)
    let ra = _rcmp_find(parent, a)
    let rb = _rcmp_find(parent, b)
    if ra == rb
        return
    let rka = rank[ra]
    let rkb = rank[rb]
    if rka < rkb
        parent[ra] = rb
    else
        if rka > rkb
            parent[rb] = ra
        else
            parent[rb] = ra
            rank[ra] = rka + 1

// _rcmp_build_uf: build union-find from symmetric closure of M.
// We union (i,j) whenever M[i][j]==1 or M[j][i]==1.
fn _rcmp_build_uf(M: list, n: int) -> list
    let parent = _rcmp_make_parent(n)
    let rank = _rcmp_make_rank(n)
    for i in 0..n
        let j = 0
        while j < n
            if M[i][j] == 1
                _rcmp_union(parent, rank, i, j)
            j += 1
    return parent

// _rcmp_sort_ints: insertion-sort a list of ints ascending, in-place.
fn _rcmp_sort_ints(lst: list)
    let n = len(lst)
    for i in 1..n
        let key = lst[i]
        let j = i - 1
        while j >= 0 and lst[j] > key
            lst[j + 1] = lst[j]
            j -= 1
        lst[j + 1] = key

// rcmp_symmetric_closure: returns M | M^T (union of M and its transpose) as a new matrix.
fn rcmp_symmetric_closure(M: list, n: int) -> list
    let result = []
    for i in 0..n
        let row = []
        let j = 0
        while j < n
            if M[i][j] == 1 or M[j][i] == 1
                row.push(1)
            else
                row.push(0)
            j += 1
        result.push(row)
    return result

// rcmp_components: list of connected components of the symmetric closure of M.
// Each component is a sorted list of vertex ints; components sorted by smallest vertex.
fn rcmp_components(M: list, n: int) -> list
    if n == 0
        return []
    let parent = _rcmp_build_uf(M, n)
    // find root of each vertex (compress paths)
    for i in 0..n
        _rcmp_find(parent, i)
    // group vertices by root using a dict (root -> list)
    let groups = {}
    for k in 0..n
        let root = parent[k]
        let rkey = str(root)
        if rkey in groups
            groups[rkey].push(k)
        else
            let grp = []
            grp.push(k)
            groups[rkey] = grp
    // collect all groups
    let rkeys = keys(groups)
    let comps = []
    for r in 0..len(rkeys)
        let grp = groups[rkeys[r]]
        _rcmp_sort_ints(grp)
        comps.push(grp)
    // sort components by first element (smallest vertex in each)
    let nc = len(comps)
    for ii in 1..nc
        let key_comp = comps[ii]
        let key_val = key_comp[0]
        let jj = ii - 1
        while jj >= 0 and comps[jj][0] > key_val
            comps[jj + 1] = comps[jj]
            jj -= 1
        comps[jj + 1] = key_comp
    return comps

// rcmp_is_connected: true iff the undirected graph of M's symmetric closure is connected.
// n=0 is vacuously connected.
fn rcmp_is_connected(M: list, n: int) -> bool
    if n == 0
        return true
    let comps = rcmp_components(M, n)
    if len(comps) == 1
        return true
    return false

// rcmp_component_of: sorted list of vertices in the same component as v.
fn rcmp_component_of(M: list, n: int, v: int) -> list
    if n == 0
        return []
    let comps = rcmp_components(M, n)
    for i in 0..len(comps)
        let comp = comps[i]
        let j = 0
        while j < len(comp)
            if comp[j] == v
                return comp
            j += 1
    return []

// rcmp_num_components: number of connected components.
fn rcmp_num_components(M: list, n: int) -> int
    if n == 0
        return 0
    let comps = rcmp_components(M, n)
    return len(comps)
