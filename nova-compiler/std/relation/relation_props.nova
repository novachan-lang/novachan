// std/relation/relation_props.nova — Property tests for binary relations on boolean matrices.
// LEAF — imports NOTHING.
//
// A relation R on the set {0,1,...,n-1} is an n x n boolean matrix M
// (a list of n rows, each a list of n ints 0/1) where M[i][j]==1 iff (i,j) in R.
//
// Public API (prefix rpr_):
//   rpr_is_reflexive(M, n)     -> true iff all M[i][i]==1
//   rpr_is_irreflexive(M, n)   -> true iff all M[i][i]==0
//   rpr_is_symmetric(M, n)     -> true iff M[i][j]==M[j][i] for all i,j
//   rpr_is_antisymmetric(M, n) -> true iff M[i][j] and M[j][i] implies i==j
//   rpr_is_transitive(M, n)    -> true iff M[i][j] and M[j][k] implies M[i][k]
//   rpr_is_asymmetric(M, n)    -> true iff M[i][j] implies NOT M[j][i]
//   rpr_is_connex(M, n)        -> true iff for all i!=j: M[i][j] or M[j][i]

// rpr_is_reflexive — true iff every diagonal entry M[i][i]==1.
fn rpr_is_reflexive(M, n)
    let i = 0
    while i < n
        if M[i][i] == 0
            return false
        i = i + 1
    return true

// rpr_is_irreflexive — true iff every diagonal entry M[i][i]==0.
fn rpr_is_irreflexive(M, n)
    let i = 0
    while i < n
        if M[i][i] == 1
            return false
        i = i + 1
    return true

// rpr_is_symmetric — true iff M[i][j]==M[j][i] for all i,j.
fn rpr_is_symmetric(M, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if M[i][j] != M[j][i]
                return false
            j = j + 1
        i = i + 1
    return true

// rpr_is_antisymmetric — true iff M[i][j]==1 and M[j][i]==1 implies i==j.
fn rpr_is_antisymmetric(M, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if i != j
                if M[i][j] == 1 and M[j][i] == 1
                    return false
            j = j + 1
        i = i + 1
    return true

// rpr_is_transitive — true iff M[i][j]==1 and M[j][k]==1 implies M[i][k]==1.
fn rpr_is_transitive(M, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if M[i][j] == 1
                let k = 0
                while k < n
                    if M[j][k] == 1
                        if M[i][k] == 0
                            return false
                    k = k + 1
            j = j + 1
        i = i + 1
    return true

// rpr_is_asymmetric — true iff M[i][j]==1 implies M[j][i]==0 (for all i,j).
// Asymmetric = irreflexive + antisymmetric (stronger than antisymmetric).
fn rpr_is_asymmetric(M, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if M[i][j] == 1
                if M[j][i] == 1
                    return false
            j = j + 1
        i = i + 1
    return true

// rpr_is_connex — true iff for all i!=j: M[i][j]==1 or M[j][i]==1 (total/connected relation).
fn rpr_is_connex(M, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if i != j
                if M[i][j] == 0 and M[j][i] == 0
                    return false
            j = j + 1
        i = i + 1
    return true
