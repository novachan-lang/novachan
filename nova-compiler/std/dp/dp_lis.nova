// ============================================================================
// NOVA Standard Library — std/dp/dp_lis
// ============================================================================
// Longest Strictly Increasing Subsequence (LIS) for integer lists.
// Pure DP, no imports, integer-only, deterministic.
//
// Public API (all prefixed lis_):
//   lis_length(nums) -> int     Length of the longest strictly increasing
//                               subsequence. Empty input -> 0. All equal -> 1.
//   lis_one(nums) -> list       One LIS as an int list (ties resolved
//                               deterministically: leftmost-first preference).
//   lis_count(nums) -> int      Number of DISTINCT LIS sequences of maximum
//                               length. No modulus applied (exact count).
//
// Algorithms:
//   lis_length — O(n log n) patience-sort / binary-search tails array.
//     tails[k] = smallest tail element of any IS of length k+1 seen so far.
//     Binary-search for leftmost position in tails >= nums[i] (strict increase
//     means we replace the first element >= nums[i]).
//   lis_one — O(n^2) DP tracking prev[] for reconstruction (simpler than
//     combining patience-sort with back-pointers; n^2 is fine for list inputs).
//   lis_count — O(n^2) DP: dp[i]=length of LIS ending at i,
//     cnt[i]=number of such LIS. Accumulate across all j < i where
//     nums[j] < nums[i].
// ============================================================================

// _lis_lower_bound returns the leftmost index k in tails[0..sz-1] such that
// tails[k] >= target. Returns sz if all tails < target.
// Strictly increasing search for strictly increasing subsequences.
fn _lis_lb(tails, sz, target) -> int
    let lo = 0
    let hi = sz
    while lo < hi
        let mid = (lo + hi) / 2
        if tails[mid] < target
            lo = mid + 1
        else
            hi = mid
    lo

// lis_length returns the length of the longest strictly increasing subsequence.
fn lis_length(nums) -> int
    let n = len(nums)
    if n == 0
        return 0
    // tails[k] = smallest tail of any strictly-increasing subsequence of length k+1
    let tails = []
    let sz = 0
    let i = 0
    while i < n
        let x = nums[i]
        let pos = _lis_lb(tails, sz, x)
        if pos == sz
            // x extends the longest tails seen
            push(tails, x)
            sz = sz + 1
        else
            tails[pos] = x
        i = i + 1
    sz

// lis_one returns one LIS as a list. Uses O(n^2) DP with back-pointer
// reconstruction. dp[i] = length of LIS ending at index i.
fn lis_one(nums) -> list
    let n = len(nums)
    if n == 0
        return []
    // Build dp[] and prev[] (back-pointer, -1 = no predecessor).
    let dp = []
    let prev = []
    let i = 0
    while i < n
        push(dp, 1)
        push(prev, -1)
        i = i + 1
    // Fill DP: for each i, check all j < i.
    let best_len = 1
    let best_end = 0
    i = 1
    while i < n
        for j in 0..i
            if nums[j] < nums[i] and dp[j] + 1 > dp[i]
                dp[i] = dp[j] + 1
                prev[i] = j
        if dp[i] > best_len
            best_len = dp[i]
            best_end = i
        i = i + 1
    // Reconstruct path from best_end back to start.
    let rev = []
    let cur = best_end
    while cur >= 0
        push(rev, nums[cur])
        cur = prev[cur]
    // Reverse to get forward order.
    let result = []
    let k = len(rev) - 1
    while k >= 0
        push(result, rev[k])
        k = k - 1
    result

// lis_count returns the number of distinct LIS of maximum length.
// Uses O(n^2) DP: dp[i]=LIS length ending at i, cnt[i]=count of such paths.
fn lis_count(nums) -> int
    let n = len(nums)
    if n == 0
        return 0
    let dp = []
    let cnt = []
    let i = 0
    while i < n
        push(dp, 1)
        push(cnt, 1)
        i = i + 1
    i = 1
    while i < n
        for j in 0..i
            if nums[j] < nums[i]
                if dp[j] + 1 > dp[i]
                    dp[i] = dp[j] + 1
                    cnt[i] = cnt[j]
                else
                    if dp[j] + 1 == dp[i]
                        cnt[i] = cnt[i] + cnt[j]
        i = i + 1
    // Find the maximum LIS length.
    let max_len = 0
    i = 0
    while i < n
        if dp[i] > max_len
            max_len = dp[i]
        i = i + 1
    // Sum counts for all positions achieving max_len.
    let total = 0
    i = 0
    while i < n
        if dp[i] == max_len
            total = total + cnt[i]
        i = i + 1
    total

fn main()
    print("std/dp/dp_lis loaded")
