// dp_matrix_chain — Matrix-chain multiplication optimal parenthesisation via DP.
//
// dims is a list of n+1 dimensions describing n matrices:
//   matrix i has dimensions dims[i] x dims[i+1]  (0-indexed, i in 0..n-1)
// A list of fewer than 2 dimensions describes zero or one matrix (no multiplications needed).
//
// mc_min_mults(dims) — minimum scalar multiplications to compute the product.
// mc_max_mults(dims) — maximum scalar multiplications (worst parenthesisation).

// _mc_make_table(n) — allocate an n x n table of zeroes.
fn _mc_make_table(n)
    let dp = []
    for i in 0..n
        let row = []
        let j = 0
        while j < n
            push(row, 0)
            j = j + 1
        push(dp, row)
    return dp

// mc_min_mults(dims) — minimum number of scalar multiplications for optimal parenthesisation.
fn mc_min_mults(dims)
    let n = len(dims) - 1
    if n <= 1
        return 0
    let dp = _mc_make_table(n)
    // chain_len from 2 up to n (diagonal filling)
    let chain = 2
    while chain <= n
        let ii = 0
        while ii <= n - chain
            let jj = ii + chain - 1
            // initialise best using the first split point k=ii
            let first_cost = dp[ii][ii] + dp[ii+1][jj] + dims[ii] * dims[ii+1] * dims[jj+1]
            let best = first_cost
            let k = ii + 1
            while k < jj
                let cost = dp[ii][k] + dp[k+1][jj] + dims[ii] * dims[k+1] * dims[jj+1]
                if cost < best
                    best = cost
                k = k + 1
            dp[ii][jj] = best
            ii = ii + 1
        chain = chain + 1
    return dp[0][n-1]

// mc_max_mults(dims) — maximum number of scalar multiplications for worst parenthesisation.
fn mc_max_mults(dims)
    let n = len(dims) - 1
    if n <= 1
        return 0
    let dp = _mc_make_table(n)
    let chain = 2
    while chain <= n
        let ii = 0
        while ii <= n - chain
            let jj = ii + chain - 1
            // initialise worst using the first split point k=ii
            let first_cost = dp[ii][ii] + dp[ii+1][jj] + dims[ii] * dims[ii+1] * dims[jj+1]
            let worst = first_cost
            let k = ii + 1
            while k < jj
                let cost = dp[ii][k] + dp[k+1][jj] + dims[ii] * dims[k+1] * dims[jj+1]
                if cost > worst
                    worst = cost
                k = k + 1
            dp[ii][jj] = worst
            ii = ii + 1
        chain = chain + 1
    return dp[0][n-1]
