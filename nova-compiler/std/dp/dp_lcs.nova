// ============================================================================
// NOVA Standard Library — std/dp/dp_lcs
// ============================================================================
// Longest Common Subsequence (LCS) for integer lists. Pure DP, no imports,
// integer-only, deterministic. The LCS of two sequences is the longest
// subsequence that appears in both (elements need not be contiguous).
//
// Public API (all prefixed lcs_):
//   lcs_length(a, b) -> int        Length of the LCS of int lists a and b.
//   lcs_sequence(a, b) -> list     One LCS as an int list (ties resolved by
//                                  choosing the lexicographically first path
//                                  during back-tracking = top-left preference).
//
// Algorithm: standard O(m*n) DP over a (m+1)x(n+1) table stored as a flat
// 1D list of size (m+1)*(n+1) so we avoid list-of-list aliasing hazards.
// dp[i*(n+1)+j] = LCS length of a[0..i-1] and b[0..j-1].
// Reconstruction walks from dp[m*(n+1)+n] back to [0,0].
// ============================================================================

// _lcs_build fills and returns the flat DP table for lcs_length / lcs_sequence.
fn _lcs_table(a, b) -> list
    let m = len(a)
    let n = len(b)
    let w = n + 1
    let total = (m + 1) * w
    let dp = [0 for z in 0..total]
    // Fill row by row: dp[i*w+j]
    let i = 1
    while i <= m
        let j = 1
        while j <= n
            let v = 0
            if a[i - 1] == b[j - 1]
                v = dp[(i - 1) * w + (j - 1)] + 1
            else
                let up = dp[(i - 1) * w + j]
                let lf = dp[i * w + (j - 1)]
                if up > lf
                    v = up
                else
                    v = lf
            dp[i * w + j] = v
            j = j + 1
        i = i + 1
    dp

// lcs_length returns the length of the longest common subsequence of a and b.
fn lcs_length(a, b) -> int
    let m = len(a)
    let n = len(b)
    if m == 0 or n == 0
        return 0
    let dp = _lcs_table(a, b)
    dp[m * (n + 1) + n]

// lcs_sequence returns one LCS as an int list by back-tracking the DP table.
// Ties are broken by preferring the 'up' direction (i-1,j) over 'left' (i,j-1),
// which is deterministic and gives the lexicographically-stable result.
fn lcs_sequence(a, b) -> list
    let m = len(a)
    let n = len(b)
    if m == 0 or n == 0
        return []
    let dp = _lcs_table(a, b)
    let w = n + 1
    // Back-track from [m][n] to [0][0] collecting elements in reverse order.
    let rev = []
    let i = m
    let j = n
    while i > 0 and j > 0
        if a[i - 1] == b[j - 1]
            push(rev, a[i - 1])
            i = i - 1
            j = j - 1
        else
            // prefer moving up (reduces i) when up >= left
            let up = dp[(i - 1) * w + j]
            let lf = dp[i * w + (j - 1)]
            if up >= lf
                i = i - 1
            else
                j = j - 1
    // rev is in reverse order; build result by reversing it.
    let result = []
    let k = len(rev) - 1
    while k >= 0
        push(result, rev[k])
        k = k - 1
    result

fn main()
    print("std/dp/dp_lcs loaded")
