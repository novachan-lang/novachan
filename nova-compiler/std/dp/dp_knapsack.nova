// std/dp/dp_knapsack.nova — 0/1 Knapsack DP: max value, chosen indices, and item-count fit.
// weights and values are parallel lists of non-negative integers. LEAF — imports NOTHING.

// kp_max_value: maximum total value achievable by selecting a subset of items (each at most once)
//   whose total weight does not exceed capacity.  O(n * capacity).
fn kp_max_value(weights: list, values: list, capacity: int) -> int
    if capacity <= 0
        return 0
    let n = len(weights)
    if n == 0
        return 0
    let dp = [0 for z in 0..(capacity + 1)]
    for item in 0..n
        let wt = weights[item]
        let val = values[item]
        // iterate downward so each item is used at most once (0/1)
        let w = capacity
        while w >= wt
            if dp[w - wt] + val > dp[w]
                dp[w] = dp[w - wt] + val
            w -= 1
    return dp[capacity]

// _kp_build_table: internal — full n*(capacity+1) DP table for backtracking.
// table[i][w] = best value using the first i items with capacity w.
fn _kp_build_table(weights: list, values: list, capacity: int) -> list
    let n = len(weights)
    let table = [[0 for w in 0..(capacity + 1)] for i in 0..(n + 1)]
    for item in 1..(n + 1)
        let wt = weights[item - 1]
        let val = values[item - 1]
        for w in 0..(capacity + 1)
            // option A: skip this item
            table[item][w] = table[item - 1][w]
            // option B: take this item if it fits and it's better
            if w >= wt
                let with_item = table[item - 1][w - wt] + val
                if with_item > table[item][w]
                    table[item][w] = with_item
    return table

// kp_selected: list of 0-based indices of items chosen by the optimal 0/1 knapsack solution.
//   Indices are returned in ascending order.  Returns [] when capacity==0 or no items fit.
fn kp_selected(weights: list, values: list, capacity: int) -> list
    if capacity <= 0
        return []
    let n = len(weights)
    if n == 0
        return []
    let table = _kp_build_table(weights, values, capacity)
    // backtrack to find which items were included
    let chosen = []
    let rem = capacity
    let i = n
    while i >= 1
        // if value changed from row i-1 to i at this capacity, item i-1 was taken
        if table[i][rem] != table[i - 1][rem]
            push(chosen, i - 1)
            rem -= weights[i - 1]
        i -= 1
    // chosen was built in reverse (n-1 down to 0); reverse it for ascending order
    let result = []
    let k = len(chosen) - 1
    while k >= 0
        push(result, chosen[k])
        k -= 1
    return result

// kp_fits_count: maximum number of items that fit within capacity by weight alone
//   (values are ignored; greedy by inserting lightest items first).
//   Uses a simple counting DP: dp[w] = max items reachable with exactly weight w
//   combined with a 1D bottom-up pass over items sorted by weight ascending.
fn kp_fits_count(weights: list, capacity: int) -> int
    if capacity <= 0
        return 0
    let n = len(weights)
    if n == 0
        return 0
    // copy and sort weights ascending (insertion sort — n is typically small)
    let sw = [weights[k] for k in 0..n]
    for si in 1..n
        let v = sw[si]
        let sj = si - 1
        while sj >= 0
            if sw[sj] > v
                sw[sj + 1] = sw[sj]
                sj -= 1
            else
                sj = -1
        sw[sj + 1] = v
    // dp[w] = max number of items whose total weight is exactly w; -1 = unreachable
    let dp = [-1 for z in 0..(capacity + 1)]
    dp[0] = 0
    for item in 0..n
        let wt = sw[item]
        let w = capacity
        while w >= wt
            if dp[w - wt] >= 0
                let candidate = dp[w - wt] + 1
                if candidate > dp[w]
                    dp[w] = candidate
            w -= 1
    // find max count across all reachable weights 0..capacity
    let best = 0
    for w2 in 0..(capacity + 1)
        if dp[w2] > best
            best = dp[w2]
    return best
