// std/dp/dp_coin_change.nova — Coin-change DP: minimum coins, combination count, greedy.
// Coins are positive integers; amounts are non-negative integers. LEAF — imports NOTHING.

// cc_min: fewest coins (unlimited supply) that sum to amount; -1 if impossible.
//   Uses bottom-up DP O(amount * len(coins)).
fn cc_min(coins: list, amount: int) -> int
    if amount == 0
        return 0
    if amount < 0
        return -1
    let nc = len(coins)
    if nc == 0
        return -1
    // sentinel: amount+1 is safely unreachable (no solution needs more coins than amount)
    let inf = amount + 1
    let dp = []
    let i = 0
    while i <= amount
        push(dp, inf)
        i += 1
    dp[0] = 0
    let a = 1
    while a <= amount
        for c in 0..nc
            let coin = coins[c]
            if coin <= a
                if dp[a - coin] + 1 < dp[a]
                    dp[a] = dp[a - coin] + 1
        a += 1
    if dp[amount] >= inf
        return -1
    return dp[amount]

// cc_ways: number of order-independent combinations of coins that sum to amount.
//   The single empty combination counts for amount==0.  Outer loop over coins ensures
//   order-independence (each coin denomination considered once).
fn cc_ways(coins: list, amount: int) -> int
    if amount < 0
        return 0
    let nc = len(coins)
    let dp = []
    let i = 0
    while i <= amount
        push(dp, 0)
        i += 1
    dp[0] = 1
    for c in 0..nc
        let coin = coins[c]
        let a = coin
        while a <= amount
            dp[a] = dp[a] + dp[a - coin]
            a += 1
    return dp[amount]

// _cc_sort_desc: internal — insertion sort descending; returns a NEW sorted list.
fn _cc_sort_desc(xs: list) -> list
    let n = len(xs)
    let out = [xs[k] for k in 0..n]
    for i in 1..n
        let v = out[i]
        let j = i - 1
        while j >= 0
            if out[j] < v
                out[j + 1] = out[j]
                j -= 1
            else
                j = -1
        out[j + 1] = v
    return out

// cc_greedy: greedy coin count using largest coins first (may be suboptimal for some denominations).
//   Returns total number of coins used; does NOT return -1 — any remainder is ignored (best effort).
fn cc_greedy(coins: list, amount: int) -> int
    if amount <= 0
        return 0
    let nc = len(coins)
    if nc == 0
        return 0
    let sorted = _cc_sort_desc(coins)
    let rem = amount
    let total = 0
    for c in 0..nc
        let coin = sorted[c]
        if coin <= rem
            let used = rem / coin
            total += used
            rem -= used * coin
    return total
