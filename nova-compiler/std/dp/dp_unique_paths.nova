// std/dp/dp_unique_paths.nova — Unique path counting on a grid.
//
// Supports right/down paths, paths with obstacles, and right/down/diagonal paths.
// Grid cells: 0 = free, 1 = blocked (for up_with_obstacles).
//
// Public API (prefix up_):
//   up_count(m, n)                -> int   paths in m-row x n-col grid (right/down only)
//   up_with_obstacles(grid)       -> int   paths avoiding blocked cells
//   up_count_diag(m, n)           -> int   paths allowing right, down, or diagonal moves

// up_count — number of distinct right/down paths in an m-row x n-col grid.
// Formula: C(m+n-2, m-1). Evaluated as a product with early division to avoid overflow.
fn up_count(m, n) -> int
    if m <= 0 or n <= 0
        return 0
    let steps = m + n - 2
    let k = m - 1
    let k2 = k
    if steps - k < k2
        k2 = steps - k
    let result = 1
    for i in 0..k2
        result = result * (steps - i)
        result = result / (i + 1)
    return result

// up_with_obstacles — count right/down paths in a grid where 1 = blocked cell.
// grid is a list of rows (list of ints, 0=free, 1=blocked).
fn up_with_obstacles(grid) -> int
    let r = len(grid)
    if r == 0
        return 0
    let row0 = grid[0]
    let c = len(row0)
    if c == 0
        return 0
    // if start or end blocked, no paths
    let g00 = grid[0]
    let glast = grid[r - 1]
    if g00[0] == 1
        return 0
    if glast[c - 1] == 1
        return 0
    // build dp table
    let dp = []
    let i = 0
    while i < r
        let drow = []
        for j in 0..c
            push(drow, 0)
        push(dp, drow)
        i = i + 1
    // seed
    let dp0 = dp[0]
    dp0[0] = 1
    dp[0] = dp0
    // fill first row
    let j = 1
    while j < c
        let grow0 = grid[0]
        let dprow0 = dp[0]
        if grow0[j] == 0 and dprow0[j - 1] > 0
            dprow0[j] = dprow0[j - 1]
            dp[0] = dprow0
        j = j + 1
    // fill first col
    i = 1
    while i < r
        let gi = grid[i]
        let dpi = dp[i]
        let dpim1 = dp[i - 1]
        if gi[0] == 0 and dpim1[0] > 0
            dpi[0] = dpim1[0]
            dp[i] = dpi
        i = i + 1
    // fill rest
    i = 1
    while i < r
        for j2 in 1..c
            let gi2 = grid[i]
            if gi2[j2] == 0
                let dpi2 = dp[i]
                let dpim12 = dp[i - 1]
                dpi2[j2] = dpim12[j2] + dpi2[j2 - 1]
                dp[i] = dpi2
        i = i + 1
    let last = dp[r - 1]
    return last[c - 1]

// up_count_diag — number of paths from (0,0) to (m-1,n-1) using right, down, or diagonal.
// Diagonal means one step right AND one step down simultaneously.
// DP: f[i][j] = f[i-1][j] + f[i][j-1] + f[i-1][j-1]  (where valid).
fn up_count_diag(m, n) -> int
    if m <= 0 or n <= 0
        return 0
    // build dp table m x n
    let dp = []
    let i = 0
    while i < m
        let drow = [0 for j in 0..n]
        push(dp, drow)
        i = i + 1
    // seed: (0,0) = 1
    let dp0 = dp[0]
    dp0[0] = 1
    dp[0] = dp0
    // fill first row: only reachable from left
    for j in 1..n
        let dprow0 = dp[0]
        dprow0[j] = dprow0[j - 1]
        dp[0] = dprow0
    // fill first col: only reachable from above
    i = 1
    while i < m
        let dpi = dp[i]
        let dpim1 = dp[i - 1]
        dpi[0] = dpim1[0]
        dp[i] = dpi
        i = i + 1
    // fill rest: from above + from left + from diagonal
    i = 1
    while i < m
        for j2 in 1..n
            let dpi2 = dp[i]
            let dpim12 = dp[i - 1]
            dpi2[j2] = dpim12[j2] + dpi2[j2 - 1] + dpim12[j2 - 1]
            dp[i] = dpi2
        i = i + 1
    let last = dp[m - 1]
    return last[n - 1]
