// ============================================================================
// NOVA Standard Library — std/dp/dp_edit_distance
// ============================================================================
// Levenshtein (edit) distance between integer lists. Pure DP, no imports,
// integer-only, deterministic.
//
// Public API (all prefixed ed_):
//   ed_distance(a, b) -> int
//       Unit-cost Levenshtein: minimum insertions + deletions + substitutions.
//   ed_distance_costs(a, b, icost, dcost, scost) -> int
//       Weighted Levenshtein: custom positive integer costs per operation.
//   ed_lcs_distance(a, b) -> int
//       LCS-based distance: |a|+|b|-2*lcs_length(a,b).
//       Allows only insertions and deletions (no substitution); substitution
//       of one element costs 2 (one delete + one insert).
//
// Algorithm: rolling two-row DP stored as flat lists.
//   prev[j] = cost to transform a[0..i-1] into b[0..j-1]
//   We rebuild curr each row to avoid aliasing in NOVA list semantics.
// ============================================================================

// _ed_min3 returns the minimum of three integers.
fn _ed_min3(x, y, z) -> int
    let m = x
    if y < m
        m = y
    if z < m
        m = z
    m

// ed_distance returns the Levenshtein edit distance between integer lists a and b
// using unit costs (each insertion, deletion, or substitution costs 1).
fn ed_distance(a, b) -> int
    let m = len(a)
    let n = len(b)
    if m == 0
        return n
    if n == 0
        return m
    // Row 0: cost to convert "" into b[0..j-1] = j insertions.
    let prev = []
    let j = 0
    while j <= n
        push(prev, j)
        j += 1
    let i = 1
    while i <= m
        // curr[0] = cost to convert a[0..i-1] into "" = i deletions.
        let curr = []
        push(curr, i)
        let k = 1
        while k <= n
            let sub_cost = 1
            if a[i - 1] == b[k - 1]
                sub_cost = 0
            let del_v = prev[k] + 1
            let ins_v = curr[k - 1] + 1
            let sub_v = prev[k - 1] + sub_cost
            let v = _ed_min3(del_v, ins_v, sub_v)
            push(curr, v)
            k += 1
        prev = curr
        i += 1
    prev[n]

// ed_distance_costs returns the weighted Levenshtein distance with custom costs:
// icost=insertion cost, dcost=deletion cost, scost=substitution cost (all >= 0).
fn ed_distance_costs(a, b, icost, dcost, scost) -> int
    let m = len(a)
    let n = len(b)
    if m == 0
        return n * icost
    if n == 0
        return m * dcost
    // Row 0: convert "" into b[0..j-1] = j insertions each costing icost.
    let prev = []
    let j = 0
    while j <= n
        push(prev, j * icost)
        j += 1
    let i = 1
    while i <= m
        let curr = []
        push(curr, i * dcost)
        let k = 1
        while k <= n
            let sc = scost
            if a[i - 1] == b[k - 1]
                sc = 0
            let del_v = prev[k] + dcost
            let ins_v = curr[k - 1] + icost
            let sub_v = prev[k - 1] + sc
            let v = _ed_min3(del_v, ins_v, sub_v)
            push(curr, v)
            k += 1
        prev = curr
        i += 1
    prev[n]

// ed_lcs_distance returns |a|+|b|-2*lcs_length(a,b): the edit distance using
// only insertions and deletions (no substitution).  A substitution of one
// element costs exactly 2 under this metric.
fn ed_lcs_distance(a, b) -> int
    let m = len(a)
    let n = len(b)
    if m == 0
        return n
    if n == 0
        return m
    // Compute LCS length via rolling-row DP.
    let prev = []
    let j = 0
    while j <= n
        push(prev, 0)
        j += 1
    let i = 1
    while i <= m
        let curr = []
        push(curr, 0)
        let k = 1
        while k <= n
            let v = 0
            if a[i - 1] == b[k - 1]
                v = prev[k - 1] + 1
            else
                let up = prev[k]
                let lf = curr[k - 1]
                if up > lf
                    v = up
                else
                    v = lf
            push(curr, v)
            k += 1
        prev = curr
        i += 1
    let lcs_len = prev[n]
    m + n - 2 * lcs_len

fn main()
    print("std/dp/dp_edit_distance loaded")
