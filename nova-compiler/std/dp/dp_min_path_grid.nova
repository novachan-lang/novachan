// std/dp/dp_min_path_grid.nova — Min/max path sums and path counts on a grid.
//
// Movement: only RIGHT or DOWN from top-left (0,0) to bottom-right (R-1,C-1).
// Grid is a list of int rows (list of lists).
//
// Public API (prefix mp_):
//   mp_min_sum(grid)         -> int   minimum path sum top-left to bottom-right
//   mp_max_sum(grid)         -> int   maximum path sum top-left to bottom-right
//   mp_path_count(rows,cols) -> int   number of distinct right/down paths

// mp_min_sum — minimum cost path from (0,0) to (R-1,C-1) moving only right or down.
fn mp_min_sum(grid) -> int
    let r = len(grid)
    if r == 0
        return 0
    let row0 = grid[0]
    let c = len(row0)
    if c == 0
        return 0
    // build dp table: dp[i][j] = min cost to reach cell (i,j)
    let dp = []
    for i in 0..r
        let drow = []
        for j in 0..c
            push(drow, 0)
        push(dp, drow)
    // seed top-left
    let g0 = grid[0]
    let dp0 = dp[0]
    dp0[0] = g0[0]
    dp[0] = dp0
    // fill first row (can only come from left)
    for j in 1..c
        let prow = dp[0]
        let grow = grid[0]
        prow[j] = prow[j - 1] + grow[j]
        dp[0] = prow
    // fill first col (can only come from above)
    for i in 1..r
        let dpi = dp[i]
        let dpim1 = dp[i - 1]
        let gi = grid[i]
        dpi[0] = dpim1[0] + gi[0]
        dp[i] = dpi
    // fill rest
    for i in 1..r
        for j2 in 1..c
            let dpi2 = dp[i]
            let dpim12 = dp[i - 1]
            let gi2 = grid[i]
            let from_top = dpim12[j2]
            let from_left = dpi2[j2 - 1]
            let best = from_top
            if from_left < best
                best = from_left
            dpi2[j2] = best + gi2[j2]
            dp[i] = dpi2
    let last_row = dp[r - 1]
    return last_row[c - 1]

// mp_max_sum — maximum cost path from (0,0) to (R-1,C-1) moving only right or down.
fn mp_max_sum(grid) -> int
    let r = len(grid)
    if r == 0
        return 0
    let row0 = grid[0]
    let c = len(row0)
    if c == 0
        return 0
    let dp = []
    for i in 0..r
        let drow = [0 for j in 0..c]
        push(dp, drow)
    // seed top-left
    let g0b = grid[0]
    let dp0b = dp[0]
    dp0b[0] = g0b[0]
    dp[0] = dp0b
    // fill first row
    for j in 1..c
        let prow = dp[0]
        let grow = grid[0]
        prow[j] = prow[j - 1] + grow[j]
        dp[0] = prow
    // fill first col
    for i in 1..r
        let dpi = dp[i]
        let dpim1 = dp[i - 1]
        let gi = grid[i]
        dpi[0] = dpim1[0] + gi[0]
        dp[i] = dpi
    // fill rest
    for i in 1..r
        for j2 in 1..c
            let dpi2 = dp[i]
            let dpim12 = dp[i - 1]
            let gi2 = grid[i]
            let from_top = dpim12[j2]
            let from_left = dpi2[j2 - 1]
            let best = from_top
            if from_left > best
                best = from_left
            dpi2[j2] = best + gi2[j2]
            dp[i] = dpi2
    let last_row2 = dp[r - 1]
    return last_row2[c - 1]

// mp_path_count — number of distinct right/down paths in a rows x cols grid.
// Formula: C(rows+cols-2, rows-1). Uses integer combination with early division.
fn mp_path_count(rows, cols) -> int
    if rows <= 0 or cols <= 0
        return 0
    // number of steps = rows-1 down + cols-1 right = rows+cols-2 total
    // choose rows-1 positions for the down steps
    let n = rows + cols - 2
    let k = rows - 1
    // if k > n-k, use n-k instead (smaller k is faster)
    let k2 = k
    if n - k < k2
        k2 = n - k
    let result = 1
    for i in 0..k2
        result = result * (n - i)
        result = result / (i + 1)
    return result
