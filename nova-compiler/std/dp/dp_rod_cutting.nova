// dp_rod_cutting — Rod cutting DP.
//
// prices[i] = price for a piece of length i+1 (0-indexed).
// Rod length n = len(prices).
//
// rc_max_revenue(prices) — maximum revenue achievable by cutting the rod.
// rc_cuts(prices)        — list of piece lengths in an optimal cut (ascending order).

// rc_max_revenue(prices) — maximum revenue cutting a rod of length len(prices).
fn rc_max_revenue(prices)
    let n = len(prices)
    if n == 0
        return 0
    // dp[j] = max revenue for rod of length j (1-indexed lengths; dp[0]=0)
    let dp = []
    let i = 0
    while i <= n
        push(dp, 0)
        i += 1
    // fill dp[1..n]
    let j = 1
    while j <= n
        let best = 0
        let cut = 1
        while cut <= j
            let candidate = prices[cut-1] + dp[j-cut]
            if candidate > best
                best = candidate
            cut += 1
        dp[j] = best
        j += 1
    return dp[n]

// rc_cuts(prices) — list of piece lengths in an optimal cut (in order of selection).
fn rc_cuts(prices)
    let n = len(prices)
    if n == 0
        return []
    // build dp and choice tables
    let dp = []
    let choice = []
    let i = 0
    while i <= n
        push(dp, 0)
        push(choice, 0)
        i += 1
    let j = 1
    while j <= n
        let best = 0
        let best_cut = 1
        let cut = 1
        while cut <= j
            let candidate = prices[cut-1] + dp[j-cut]
            if candidate > best
                best = candidate
                best_cut = cut
            cut += 1
        dp[j] = best
        choice[j] = best_cut
        j += 1
    // reconstruct cuts by tracing choice[]
    let cuts = []
    let rem = n
    while rem > 0
        push(cuts, choice[rem])
        rem -= choice[rem]
    return cuts
