// ============================================================================
// NOVA Standard Library — std/net/smtp_data
// ============================================================================
// SMTP DATA transparency: dot-stuffing (RFC 5321 §4.5.2) and end-of-data
// detection.
//
// RFC 5321 terminates the DATA command's content with a line containing only
// a single "." — so the sender must "stuff" any line of the ACTUAL message
// that begins with "." by doubling that leading dot, and the receiver must
// reverse it (remove exactly one leading dot from each line) to recover the
// original content.
//
// PUBLIC API:
//   smtp_dot_stuff(body: string) -> string
//     Double any "." that appears as the FIRST character of a line (the very
//     start of `body` counts as a line start, and so does every position
//     right after a LF). Lines are otherwise passed through unchanged.
//
//   smtp_dot_unstuff(data: string) -> string
//     Reverse of smtp_dot_stuff: remove exactly one leading "." from each
//     line. `data` must NOT include the final ".\r\n" terminator line itself
//     — callers detect and strip that first (see smtp_data_end below; this
//     mirrors the convention already used by std/net/pop3_reply and
//     std/net/ftp_reply, whose body lists likewise exclude the terminator).
//
//   smtp_data_end(data: string) -> int
//     1 if `data` ends with the terminator sequence "\r\n.\r\n", OR `data`
//     IS exactly ".\r\n" (an entirely empty message body, terminated
//     immediately). 0 otherwise.
//
// DESIGN NOTES:
//   * CRLF = chr(13)+chr(10). Both functions treat LF (10) alone as ending a
//     line for stuffing/unstuffing purposes (a line start immediately
//     follows any LF byte, matching common lenient DATA readers); CR bytes
//     are passed through unchanged either way.
//   * Private helpers: none needed — both are simple single-pass scanners.
//
// LEAF — imports NOTHING.
// ============================================================================

// smtp_dot_stuff: double any line-leading "." in body.
fn smtp_dot_stuff(body: string) -> string
    let out = ""
    let n = len(body)
    let i = 0
    let at_line_start = 1
    while i < n
        let ch = slice(body, i, i + 1)
        if at_line_start == 1 and ch == "."
            out = out + "."
        out = out + ch
        if ch == chr(10)
            at_line_start = 1
        else
            at_line_start = 0
        i = i + 1
    out

// smtp_dot_unstuff: remove one line-leading "." from data (excludes the
// final ".\r\n" terminator line, which the caller strips beforehand).
fn smtp_dot_unstuff(data: string) -> string
    let out = ""
    let n = len(data)
    let i = 0
    let at_line_start = 1
    while i < n
        let ch = slice(data, i, i + 1)
        if at_line_start == 1 and ch == "."
            // Consume (drop) exactly one leading dot; do not emit it.
            at_line_start = 0
            i = i + 1
            continue
        out = out + ch
        if ch == chr(10)
            at_line_start = 1
        else
            at_line_start = 0
        i = i + 1
    out

// smtp_data_end: 1 if data ends with the DATA terminator sequence.
fn smtp_data_end(data: string) -> int
    let crlf_dot_crlf = chr(13) + chr(10) + "." + chr(13) + chr(10)
    if ends_with(data, crlf_dot_crlf)
        return 1
    if data == "." + chr(13) + chr(10)
        return 1
    0
