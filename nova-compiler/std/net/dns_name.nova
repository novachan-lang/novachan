// ============================================================================
// NOVA Standard Library — std/net/dns_name
// ============================================================================
// DNS name wire-format codec (RFC 1035).
//
// PUBLIC API:
//   dns_name_encode(name: string) -> bytes
//     Encode a dot-separated domain name to uncompressed DNS wire format.
//     "example.com" -> [7,e,x,a,m,p,l,e, 3,c,o,m, 0]  (13 bytes)
//     Each label is emitted as: 1 length byte (1..63) + label ASCII bytes.
//     Terminated by a 0x00 byte.
//     Empty input -> single 0x00 byte (root label).
//     Labels longer than 63 bytes -> return empty bytes (invalid).
//
//   dns_name_decode(msg: bytes, pos: int) -> list
//     Decode a DNS name from msg starting at byte offset pos.
//     Returns a two-element list: [name_string, next_pos]
//     Follows compression pointers (top 2 bits = 0b11); caps at 128 jumps to
//     prevent infinite loops on malformed input.
//     On any malformed input (out-of-bounds, bad label length, too many jumps)
//     returns ["", pos] so callers get a safe empty result.
//
// WIRE FORMAT:
//   Labels: 1 length byte (0x01..0x3F) + that many ASCII bytes.
//   Root:   0x00 byte.
//   Pointer: 2 bytes with top 2 bits = 0b11; offset = ((b0 & 0x3F)<<8)|b1.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private: encode one DNS name label sequence into bytes ─────────────────

// _dns_name_encode_label: append one label (string) to out as len+bytes.
// Returns the updated bytes, or empty bytes if label is empty or >63 chars.
fn _dns_name_encode_label(out: bytes, lbl: string) -> bytes
    let n = len(lbl)
    if n == 0
        return bytes(0)
    if n > 63
        return bytes(0)
    out = bytes_append(out, n)
    for i in 0..n
        out = bytes_append(out, ord(char_at(lbl, i)))
    out

// ── Public: encode ──────────────────────────────────────────────────────────

fn dns_name_encode(name: string) -> bytes
    let out = bytes(0)
    // Empty name = root label
    if len(name) == 0
        out = bytes_append(out, 0)
        return out
    let parts = split(name, ".")
    for i in 0..len(parts)
        let lbl = parts[i]
        let n = len(lbl)
        if n == 0 or n > 63
            return bytes(0)
        out = bytes_append(out, n)
        for j in 0..n
            out = bytes_append(out, ord(char_at(lbl, j)))
    // terminating zero
    out = bytes_append(out, 0)
    out

// ── Private: decode one name from a message buffer ─────────────────────────

// _dns_read_label: read a single label string starting at msg[pos].
// Returns [label_text, pos_after_label_bytes] or ["", pos] on error.
// Caller must have already verified msg[pos] is a length byte 1..63.
fn _dns_read_label(msg: bytes, pos: int, ln: int) -> list
    let mlen = bytes_len(msg)
    let end = pos + ln
    if end > mlen
        return ["", pos]
    let lbl = ""
    for i in pos..end
        lbl += chr(bytes_get(msg, i))
    [lbl, end]

// ── Public: decode ──────────────────────────────────────────────────────────

fn dns_name_decode(msg: bytes, pos: int) -> list
    let mlen = bytes_len(msg)
    let name = ""
    let cur = pos
    let jumps = 0
    let jumped = false
    let final_pos = pos
    while true
        if cur >= mlen
            return ["", pos]
        let b0 = bytes_get(msg, cur)
        // Compression pointer: top 2 bits = 11
        if (b0 & 0xC0) == 0xC0
            if cur + 1 >= mlen
                return ["", pos]
            let b1 = bytes_get(msg, cur + 1)
            let offset = ((b0 & 0x3F) << 8) | b1
            // Advance final_pos only on first pointer jump
            if not jumped
                final_pos = cur + 2
            jumped = true
            jumps += 1
            if jumps > 128
                return ["", pos]
            cur = offset
        else
            // Length byte: 0 = end, 1..63 = label, else malformed
            let ln = b0 & 0xFF
            if ln == 0
                // End of name
                if not jumped
                    final_pos = cur + 1
                if len(name) == 0
                    name = ""
                return [name, final_pos]
            if ln > 63
                return ["", pos]
            if cur + 1 + ln > mlen
                return ["", pos]
            let lend = cur + 1 + ln
            let lbl_parts = []
            for i in cur + 1..lend
                push(lbl_parts, chr(bytes_get(msg, i)))
            let lbl = join(lbl_parts, "")
            if len(name) == 0
                name = lbl
            else
                name += "." + lbl
            cur = lend
    ["", pos]
