// ============================================================================
// NOVA Standard Library — std/net/mimetype
// ============================================================================
// MIME type lookup by file extension with text-type classification.
//
// PUBLIC API:
//   mt_by_ext(ext: string) -> string
//     Return MIME type for the given extension.  The extension may be given
//     with or without a leading dot (e.g. "html" or ".html") and is matched
//     case-insensitively.  Returns "application/octet-stream" if not found.
//
//   mt_by_path(path: string) -> string
//     Extract the extension from path (text after the last '.' in the last
//     path segment) and delegate to mt_by_ext.
//
//   mt_is_text(mime: string) -> bool
//     Return true if the MIME type is a text-like type: starts with "text/"
//     or is application/json, application/xml, or application/javascript.
//
// DESIGN NOTES:
//   * Private helpers prefixed _mt_ to avoid cross-module symbol collisions.
//   * Extension lookup uses lower() + if-chain (no multi-line dict literal).
//   * mt_by_path handles Unix ('/') and Windows ('\') path separators.
//
// LEAF — imports NOTHING.
// ============================================================================

// _mt_strip_dot: strip a leading '.' from ext if present, then lowercase.
fn _mt_strip_dot(ext: string) -> string
    let e = lower(ext)
    let n = len(e)
    if n == 0
        return ""
    let first = slice(e, 0, 1)
    if first == "."
        return slice(e, 1, n)
    e

// _mt_lookup: return MIME type for a clean lowercase extension (no dot).
fn _mt_lookup(e: string) -> string
    // text
    if e == "html"  then return "text/html"
    if e == "htm"   then return "text/html"
    if e == "css"   then return "text/css"
    if e == "js"    then return "text/javascript"
    if e == "mjs"   then return "text/javascript"
    if e == "txt"   then return "text/plain"
    if e == "csv"   then return "text/csv"
    if e == "md"    then return "text/markdown"
    // data / scripts
    if e == "json"  then return "application/json"
    if e == "xml"   then return "application/xml"
    // images
    if e == "png"   then return "image/png"
    if e == "jpg"   then return "image/jpeg"
    if e == "jpeg"  then return "image/jpeg"
    if e == "gif"   then return "image/gif"
    if e == "svg"   then return "image/svg+xml"
    if e == "webp"  then return "image/webp"
    if e == "ico"   then return "image/x-icon"
    // documents
    if e == "pdf"   then return "application/pdf"
    // archives
    if e == "zip"   then return "application/zip"
    if e == "gz"    then return "application/gzip"
    if e == "tar"   then return "application/x-tar"
    // video
    if e == "mp4"   then return "video/mp4"
    if e == "webm"  then return "video/webm"
    // audio
    if e == "mp3"   then return "audio/mpeg"
    if e == "wav"   then return "audio/wav"
    // fonts
    if e == "woff2" then return "font/woff2"
    if e == "woff"  then return "font/woff"
    // binary
    if e == "wasm"  then return "application/wasm"
    // default
    "application/octet-stream"

// mt_by_ext: MIME type for the given extension (with or without leading dot,
// case-insensitive).  Unknown extensions return "application/octet-stream".
fn mt_by_ext(ext: string) -> string
    let e = _mt_strip_dot(ext)
    _mt_lookup(e)

// _mt_last_segment: return the portion of path after the last '/' or '\'.
fn _mt_last_segment(path: string) -> string
    let n = len(path)
    let i = n - 1
    let seg_start = 0
    let found = 0
    if i >= 0
        // walk backwards to find last separator
        let j = i
        // scan up to n chars from the end
        let limit = n
        let k = 0
        loop
            if k >= limit
                break
            let pos = n - 1 - k
            let ch = slice(path, pos, pos + 1)
            if ch == "/" or ch == "\\"
                seg_start = pos + 1
                found = 1
                k = limit
            k = k + 1
    if found == 1
        return slice(path, seg_start, n)
    path

// _mt_ext_of: extract the extension from a filename (text after the last '.').
// Returns "" if no '.' is present.
fn _mt_ext_of(filename: string) -> string
    let n = len(filename)
    let dot_pos = -1
    let k = 0
    loop
        if k >= n
            break
        let pos = n - 1 - k
        let ch = slice(filename, pos, pos + 1)
        if ch == "."
            dot_pos = pos
            k = n
        k = k + 1
    if dot_pos < 0
        return ""
    slice(filename, dot_pos, n)

// mt_by_path: extract extension from path and return MIME type.
fn mt_by_path(path: string) -> string
    let seg = _mt_last_segment(path)
    let ext = _mt_ext_of(seg)
    if ext == ""
        return "application/octet-stream"
    mt_by_ext(ext)

// mt_is_text: true iff the MIME type is text-like.
fn mt_is_text(mime: string) -> bool
    let n = len(mime)
    // check "text/" prefix
    if n >= 5
        let prefix = slice(mime, 0, 5)
        if prefix == "text/"
            return true
    if mime == "application/json"       then return true
    if mime == "application/xml"        then return true
    if mime == "application/javascript" then return true
    false
