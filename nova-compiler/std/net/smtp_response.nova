// ============================================================================
// NOVA Standard Library — std/net/smtp_response
// ============================================================================
// SMTP response-LINE parsing (RFC 5321 §4.2), one line at a time.
//
// Where std/net/smtp_line parses an entire (already-assembled) multi-line
// reply block, this module parses a SINGLE line as it is read off the wire —
// the shape a socket reader actually sees (readline in a loop). Callers read
// lines until "continued" is 0, concatenating "text" as needed.
//
// PUBLIC API:
//   smtp_resp_parse(line: string) -> dict
//     Parse one reply line into:
//       "code"      : int    — the 3-digit reply code (0 if malformed)
//       "text"      : string — the text after "code" and its separator
//       "continued" : int    — 1 if the separator is "-" (more lines follow),
//                              0 if " " (this is the last line) or malformed
//     "250-STARTTLS"  -> code=250, text="STARTTLS",  continued=1
//     "250 OK"        -> code=250, text="OK",         continued=0
//     "250"           -> code=250, text="",            continued=0
//     malformed       -> code=0,   text="",            continued=0
//
//   smtp_resp_is_ok(resp: dict) -> int
//     1 if resp["code"] is a 2xx (positive completion) reply, else 0.
//
// DESIGN NOTES:
//   * CRLF = chr(13)+chr(10). Bare LF alone is also stripped (lenient).
//   * The code is exactly 3 ASCII digits; anything else is malformed (code=0).
//   * Private helpers prefixed _smtpr_.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _smtpr_is_digit: 1 if c is ASCII digit '0'..'9'.
fn _smtpr_is_digit(c: string) -> int
    let o = ord(c)
    if o >= 48 and o <= 57
        return 1
    0

// _smtpr_strip_crlf: remove trailing CR (13) and/or LF (10) from a line.
fn _smtpr_strip_crlf(s: string) -> string
    let n = len(s)
    let stop = n
    if stop > 0 and ord(slice(s, stop - 1, stop)) == 10
        stop = stop - 1
    if stop > 0 and ord(slice(s, stop - 1, stop)) == 13
        stop = stop - 1
    slice(s, 0, stop)

// _smtpr_parse_code: parse 3-digit code from start of line, or -1.
fn _smtpr_parse_code(line: string) -> int
    let n = len(line)
    if n < 3
        return -1
    let c0 = slice(line, 0, 1)
    let c1 = slice(line, 1, 2)
    let c2 = slice(line, 2, 3)
    if _smtpr_is_digit(c0) == 0 or _smtpr_is_digit(c1) == 0 or _smtpr_is_digit(c2) == 0
        return -1
    let d0 = ord(c0) - 48
    let d1 = ord(c1) - 48
    let d2 = ord(c2) - 48
    d0 * 100 + d1 * 10 + d2

// ── Public API ───────────────────────────────────────────────────────────────

// smtp_resp_parse: parse one SMTP reply line.
fn smtp_resp_parse(line: string) -> dict
    let out = {}
    out["code"] = 0
    out["text"] = ""
    out["continued"] = 0

    let s = _smtpr_strip_crlf(line)
    let code = _smtpr_parse_code(s)
    if code < 100
        return out
    out["code"] = code

    let n = len(s)
    if n == 3
        // Bare code, no separator, no text.
        return out

    let sep = slice(s, 3, 4)
    let text = ""
    if n > 4
        text = slice(s, 4, n)
    out["text"] = text
    if sep == "-"
        out["continued"] = 1
    out

// smtp_resp_is_ok: 1 if resp's code is 2xx (positive completion).
fn smtp_resp_is_ok(resp: dict) -> int
    let code = 0
    if contains(resp, "code")
        code = resp["code"]
    if code >= 200 and code <= 299
        return 1
    0
