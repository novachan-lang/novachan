// ============================================================================
// NOVA Standard Library — std/net/smtp_auth
// ============================================================================
// SMTP AUTH mechanism helpers (RFC 4954).
//
// PUBLIC API:
//   smtp_auth_plain(user: string, pass: string) -> string
//     Build the SASL PLAIN initial-response, base64-encoded, per RFC 4616:
//     the octet string NUL + authcid + NUL + password, i.e.
//     "\0" + user + "\0" + pass, base64-encoded.
//
//   smtp_auth_parse(line: string) -> dict
//     Parse an "AUTH mechanism [initial-response]" argument into:
//       "mechanism"        : string — UPPERCASED (e.g. "PLAIN", "LOGIN")
//       "initial_response" : string — "" if absent, "" if the RFC 4954
//                             empty-response marker "=" is given verbatim,
//                             else the raw (still base64) token as sent.
//     Tolerates an optional leading "AUTH " tag (case-insensitive) so both
//     the bare argument (as returned by std/net/smtp_command's smtp_cmd_parse
//     for verb "AUTH") and the full command line are accepted.
//
// THE NUL-SAFETY HAZARD:
//   The PLAIN response embeds a literal 0x00 byte between each field. NOVA
//   strings are C-string-shaped: concatenating chr(0) into a string SILENTLY
//   TRUNCATES at that byte (see std/encoding/base64's module header). This
//   module therefore builds the raw octet string directly as a `bytes`
//   value — bytes_create(0)/bytes_append(...,0)/bytes_append_str(...) — and
//   NEVER routes it through a NOVA string, so the embedded NULs survive
//   intact into the base64 encoder.
//
// DESIGN NOTES:
//   * Private helpers prefixed _smtpa_.
//
// DEPENDS ON: std/encoding/base64 (b64_encode).
// ============================================================================

import std/encoding/base64

// ── Private helpers ──────────────────────────────────────────────────────────

fn _smtpa_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and (slice(s, start, start + 1) == " " or slice(s, start, start + 1) == chr(9))
        start += 1
    let stop = n
    while stop > start and (slice(s, stop - 1, stop) == " " or slice(s, stop - 1, stop) == chr(9))
        stop -= 1
    slice(s, start, stop)

fn _smtpa_strip_crlf(s: string) -> string
    let n = len(s)
    let stop = n
    if stop > 0 and ord(slice(s, stop - 1, stop)) == 10
        stop -= 1
    if stop > 0 and ord(slice(s, stop - 1, stop)) == 13
        stop -= 1
    slice(s, 0, stop)

// ── Public API ───────────────────────────────────────────────────────────────

// smtp_auth_plain: base64("\0" + user + "\0" + pass), NUL-safe by construction.
fn smtp_auth_plain(user: string, pass: string) -> string
    let b = bytes_create(0)
    b = bytes_append(b, 0)
    b = bytes_append_str(b, user)
    b = bytes_append(b, 0)
    b = bytes_append_str(b, pass)
    b64_encode(b)

// smtp_auth_parse: parse "[AUTH ]mechanism [initial-response]".
fn smtp_auth_parse(line: string) -> dict
    let out = {}
    out["mechanism"] = ""
    out["initial_response"] = ""

    let s = _smtpa_trim(_smtpa_strip_crlf(line))
    // Tolerate a leading "AUTH " tag.
    if len(s) >= 5 and upper(slice(s, 0, 5)) == "AUTH "
        s = _smtpa_trim(slice(s, 5, len(s)))

    let n = len(s)
    if n == 0
        return out

    let i = 0
    while i < n and slice(s, i, i + 1) != " "
        i += 1
    out["mechanism"] = upper(slice(s, 0, i))

    if i < n
        let rest = _smtpa_trim(slice(s, i + 1, n))
        if rest == "="
            out["initial_response"] = ""
        else
            out["initial_response"] = rest
    out
