// ============================================================================
// NOVA Standard Library — std/net/rate_limit
// ============================================================================
// Token-bucket rate limiter, millisecond-clock variant. The caller always
// supplies the current timestamp (now_ms) explicitly — no hidden dependency
// on a real clock, so the module is fully deterministic and unit-testable
// (mirrors the design of std/util/ratelimiter.nova, which uses a
// float-seconds clock instead).
//
// Public API:
//   rl_new(max_tokens, refill_rate_per_sec) -> dict
//   rl_try_acquire(limiter, tokens, now_ms)  -> bool  (consumes if available)
//   rl_available(limiter, now_ms)            -> int   (tokens after refill; no mutation)
//   rl_reset(limiter)                        -> dict  (refills to max)
//   rl_wait_time(limiter, tokens, now_ms)    -> int   (ms to wait; 0 if available now)
//
// Limiter dict shape: {"max_tokens": float, "tokens": float, "rate": float,
//                       "last_ms": int}
// ============================================================================

// _rl_refilled: pure helper — what the token count WOULD be at now_ms, given
// the stored tokens/last_ms/rate, clamped to max_tokens. Does not mutate.
// Clamps a backwards clock jump (now_ms < last_ms) to zero elapsed time
// rather than draining tokens.
fn _rl_refilled(limiter, now_ms) -> float
    let elapsed_ms = now_ms - limiter["last_ms"]
    if elapsed_ms < 0
        elapsed_ms = 0
    let added = (elapsed_ms * 1.0 / 1000.0) * limiter["rate"]
    let total = limiter["tokens"] + added
    let cap = limiter["max_tokens"]
    if total > cap
        total = cap
    total

// rl_new: bucket starts full.
fn rl_new(max_tokens, refill_rate_per_sec) -> dict
    let lim = {}
    let cap = max_tokens * 1.0
    lim["max_tokens"] = cap
    lim["tokens"] = cap
    lim["rate"] = refill_rate_per_sec * 1.0
    lim["last_ms"] = 0
    lim

// rl_try_acquire: refill to now_ms, then consume `tokens` if enough are
// available. Always advances last_ms (whether or not the acquire succeeds),
// matching standard token-bucket semantics.
fn rl_try_acquire(limiter, tokens, now_ms) -> bool
    let avail = _rl_refilled(limiter, now_ms)
    limiter["last_ms"] = now_ms
    let need = tokens * 1.0
    if avail >= need
        limiter["tokens"] = avail - need
        return true
    limiter["tokens"] = avail
    false

// rl_available: read-only snapshot of tokens available after refilling to
// now_ms. Does NOT mutate stored state (use rl_try_acquire to actually
// consume tokens) — floored to an int token count.
fn rl_available(limiter, now_ms) -> int
    floor(_rl_refilled(limiter, now_ms))

// rl_reset: refill to max immediately.
fn rl_reset(limiter) -> dict
    limiter["tokens"] = limiter["max_tokens"]
    limiter

// rl_wait_time: how long (ms) until `tokens` would be available, without
// mutating state. 0 if already available. If the bucket has no refill rate
// and isn't already satisfied, it will never become available — returns a
// large sentinel rather than dividing by zero.
fn rl_wait_time(limiter, tokens, now_ms) -> int
    let avail = _rl_refilled(limiter, now_ms)
    let need = tokens * 1.0
    if avail >= need
        return 0
    let rate = limiter["rate"]
    if rate <= 0.0
        return 2147483647
    let deficit = need - avail
    let secs_needed = deficit / rate
    ceil(secs_needed * 1000.0)

// ============================================================================
fn main()
    print("std/net/rate_limit loaded")
