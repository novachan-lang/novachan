// ============================================================================
// NOVA Standard Library — std/net/smtp_envelope
// ============================================================================
// SMTP envelope abstraction: bundle a sender, recipient list, and message
// body into the exact sequence of protocol lines an SMTP client sends after
// the EHLO/HELO handshake (RFC 5321 §3.3).
//
// PUBLIC API:
//   smtp_env_new(from: string, to: list, data: string) -> dict
//     "from" : string — sender address (bare, no "<>")
//     "to"   : list   — recipient addresses (bare, no "<>"), one per string
//     "data" : string — the raw message (headers + body), NOT yet
//                       dot-stuffed
//
//   smtp_env_commands(env: dict) -> list
//     The ordered command/data strings a client sends for this envelope:
//       [0]      "MAIL FROM:<from>\r\n"
//       [1..k]   "RCPT TO:<addr>\r\n" — one per entry in env["to"], in order
//       [k+1]    "DATA\r\n"
//       [k+2]    the dot-stuffed message body (env["data"] run through
//                std/net/smtp_data's smtp_dot_stuff — no trailing "." line)
//       [k+3]    ".\r\n" — the DATA terminator
//     A caller streaming this to a socket sends each element verbatim (the
//     dot-stuffed body element already ends with whatever line ending the
//     original message had; the terminator element supplies the final
//     ".\r\n" on its own).
//
// DESIGN NOTES:
//   * Command framing is delegated to std/net/smtp_command's smtp_cmd_build
//     and dot-stuffing to std/net/smtp_data's smtp_dot_stuff — this module
//     adds no new line-building logic of its own, only sequencing.
//   * Empty env["to"] produces a MAIL FROM + DATA + body + terminator
//     sequence with zero RCPT TO lines (a malformed transaction per RFC
//     5321 — at least one RCPT TO is required — but that is a protocol-
//     level validation concern for the caller/transport, not this module).
//
// DEPENDS ON: std/net/smtp_command (smtp_cmd_build), std/net/smtp_data
// (smtp_dot_stuff).
// ============================================================================

import std/net/smtp_command
import std/net/smtp_data

// smtp_env_new: build an envelope value.
fn smtp_env_new(from: string, to: list, data: string) -> dict
    let env = {}
    env["from"] = from
    env["to"] = to
    env["data"] = data
    env

// smtp_env_commands: the ordered command/data strings for this envelope.
fn smtp_env_commands(env: dict) -> list
    let crlf = chr(13) + chr(10)
    let cmds = []

    let from = ""
    if contains(env, "from")
        from = env["from"]
    push(cmds, smtp_cmd_build("MAIL", "FROM:<" + from + ">"))

    let to = []
    if contains(env, "to")
        to = env["to"]
    let n = len(to)
    let i = 0
    while i < n
        push(cmds, smtp_cmd_build("RCPT", "TO:<" + to[i] + ">"))
        i = i + 1

    push(cmds, smtp_cmd_build("DATA", ""))

    let data = ""
    if contains(env, "data")
        data = env["data"]
    push(cmds, smtp_dot_stuff(data))

    push(cmds, "." + crlf)
    cmds
