// ============================================================================
// NOVA Standard Library — std/net/httpdate
// ============================================================================
// RFC 1123 HTTP-date formatting (IMF-fixdate as used in HTTP/1.1+).
//
// PUBLIC API:
//   hd_format(epoch: int) -> string
//     Format a UTC epoch as an RFC 1123 HTTP-date string, e.g.:
//       "Sun, 06 Nov 1994 08:49:37 GMT"
//
//   hd_weekday_name(wd: int) -> string
//     Map 0..6 (0=Sun) to the 3-letter abbreviation used in HTTP-date.
//     Returns "" for out-of-range inputs.
//
//   hd_month_name(m: int) -> string
//     Map 1..12 to the 3-letter abbreviation used in HTTP-date.
//     Returns "" for out-of-range inputs.
//
// ALGORITHM:
//   Uses std/time/datetime (dt_from_epoch) for calendar decomposition.
//   dt_from_epoch returns weekday as 0=Sun, matching HTTP-date day names.
//
// FORMAT: "Day, DD Mon YYYY HH:MM:SS GMT"
//   Day  — 3-letter weekday abbreviation (Sun, Mon, …, Sat)
//   DD   — zero-padded 2-digit day-of-month
//   Mon  — 3-letter month abbreviation (Jan, …, Dec)
//   YYYY — 4-digit year
//   HH:MM:SS — zero-padded time in UTC
//   GMT  — always literal (HTTP-date is always UTC)
//
// DEPENDS ON: std/time/datetime
// ============================================================================

import std/time/datetime

// _hd_pad2: zero-pad an integer to at least 2 digits.
fn _hd_pad2(n: int) -> string
    if n < 10
        return "0" + str(n)
    str(n)

// hd_weekday_name: 0=Sun..6=Sat -> 3-letter name.
fn hd_weekday_name(wd: int) -> string
    if wd == 0
        return "Sun"
    if wd == 1
        return "Mon"
    if wd == 2
        return "Tue"
    if wd == 3
        return "Wed"
    if wd == 4
        return "Thu"
    if wd == 5
        return "Fri"
    if wd == 6
        return "Sat"
    ""

// hd_month_name: 1=Jan..12=Dec -> 3-letter name.
fn hd_month_name(m: int) -> string
    if m == 1
        return "Jan"
    if m == 2
        return "Feb"
    if m == 3
        return "Mar"
    if m == 4
        return "Apr"
    if m == 5
        return "May"
    if m == 6
        return "Jun"
    if m == 7
        return "Jul"
    if m == 8
        return "Aug"
    if m == 9
        return "Sep"
    if m == 10
        return "Oct"
    if m == 11
        return "Nov"
    if m == 12
        return "Dec"
    ""

// hd_format: format a UTC epoch as RFC 1123 HTTP-date.
// e.g. hd_format(784111777) = "Sun, 06 Nov 1994 08:49:37 GMT"
fn hd_format(epoch: int) -> string
    let r = dt_from_epoch(epoch)
    let day_name = hd_weekday_name(r["weekday"])
    let mon_name = hd_month_name(r["month"])
    let day2 = _hd_pad2(r["day"])
    let year_s = str(r["year"])
    let hour2 = _hd_pad2(r["hour"])
    let min2 = _hd_pad2(r["min"])
    let sec2 = _hd_pad2(r["sec"])
    "{day_name}, {day2} {mon_name} {year_s} {hour2}:{min2}:{sec2} GMT"
