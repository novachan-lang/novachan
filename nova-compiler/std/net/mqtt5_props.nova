// ============================================================================
// NOVA Standard Library — std/net/mqtt5_props
// ============================================================================
// MQTT 5.0 property encoding/decoding (OASIS MQTT v5.0 §2.2.2).
//
// Wire representation: byte-list = a LIST of ints 0..255.
//
// Properties wire format:
//   <varint total_length> <prop_id> <typed_value> <prop_id> <typed_value> ...
//
// Supported property types (by id):
//   0x11 (17) Session-Expiry-Interval : u32 (4 bytes big-endian)
//   0x21 (33) Receive-Maximum         : u16 (2 bytes big-endian)
//   0x27 (39) Maximum-Packet-Size     : u32 (4 bytes big-endian)
//   0x26 (38) User-Property           : two UTF-8 strings (u16-len prefix each)
//
// Other property ids not listed above are treated as u8 (1 byte value).
//
// PUBLIC API:
//   mqtt5_prop_encode(props: list) -> list
//     props = list of [prop_id, value] pairs
//       For 0x26 User-Property: value = [key_string, val_string]
//       For all others: value = integer
//     Returns the complete property set as a byte-list:
//       [varint_len, ...property_bytes...]
//     Empty props list returns [0].
//
//   mqtt5_prop_decode(pkt: list, pos: int) -> [dict, next_pos]
//     Decode properties starting at pos in pkt.
//     Returns [dict, next_pos] where dict keys are property ids (as ints)
//     mapped to their decoded values.
//     For 0x26 User-Property: value is a list of [key, val] string pairs.
//     Returns [{}, pos] on malformed input.
//
// PRIVATE helpers prefixed _m5p_.
// LEAF — imports NOTHING.
// ============================================================================

// ── Varint encoder: append varint for v into out list ─────────────────────────

fn _m5p_enc_varint(out, v)
    let done = 0
    while done == 0
        let enc_byte = v & 0x7F
        v = v >> 7
        if v > 0
            enc_byte = enc_byte | 0x80
        push(out, enc_byte)
        if v == 0
            done = 1
    out

// ── Varint decoder: [value, next_pos] ────────────────────────────────────────

fn _m5p_dec_varint(pkt, pos)
    let value = 0
    let shift = 0
    let more = 1
    let pkt_len = len(pkt)
    while more == 1 and pos < pkt_len
        let b = pkt[pos]
        pos = pos + 1
        value = value | ((b & 0x7F) << shift)
        shift = shift + 7
        if (b & 0x80) == 0
            more = 0
    let r = []
    push(r, value)
    push(r, pos)
    r

// ── u16 big-endian helpers ────────────────────────────────────────────────────

fn _m5p_push_u16(out, v)
    push(out, (v >> 8) & 0xFF)
    push(out, v & 0xFF)
    out

fn _m5p_read_u16(pkt, pos)
    ((pkt[pos] << 8) | pkt[pos + 1]) & 0xFFFF

// ── u32 big-endian helpers ────────────────────────────────────────────────────

fn _m5p_push_u32(out, v)
    push(out, (v >> 24) & 0xFF)
    push(out, (v >> 16) & 0xFF)
    push(out, (v >> 8) & 0xFF)
    push(out, v & 0xFF)
    out

fn _m5p_read_u32(pkt, pos)
    let hi = (pkt[pos] << 24) | (pkt[pos + 1] << 16)
    let lo = (pkt[pos + 2] << 8) | pkt[pos + 3]
    (hi | lo) & 0xFFFFFFFF

// ── UTF-8 string push/read (u16 length prefix) ───────────────────────────────

fn _m5p_push_str(out, s)
    let n = len(s)
    out = _m5p_push_u16(out, n)
    let i = 0
    while i < n
        push(out, ord(slice(s, i, i + 1)))
        i = i + 1
    out

fn _m5p_read_str(pkt, pos)
    let pkt_len = len(pkt)
    if pos + 1 >= pkt_len
        let fail = []
        push(fail, "")
        push(fail, pos)
        return fail
    let slen = _m5p_read_u16(pkt, pos)
    pos = pos + 2
    let s = ""
    let i = 0
    while i < slen and pos < pkt_len
        s = s + chr(pkt[pos])
        pos = pos + 1
        i = i + 1
    let r = []
    push(r, s)
    push(r, pos)
    r

// ── Encode a single property into out ─────────────────────────────────────────
// Returns updated out.

fn _m5p_enc_one(out, prop_id, value)
    push(out, prop_id & 0xFF)
    if prop_id == 0x11
        // Session-Expiry-Interval: u32
        out = _m5p_push_u32(out, value)
    else if prop_id == 0x21
        // Receive-Maximum: u16
        out = _m5p_push_u16(out, value)
    else if prop_id == 0x27
        // Maximum-Packet-Size: u32
        out = _m5p_push_u32(out, value)
    else if prop_id == 0x26
        // User-Property: two strings [key, val]
        let key = value[0]
        let val = value[1]
        out = _m5p_push_str(out, key)
        out = _m5p_push_str(out, val)
    else
        // Generic: treat value as u8
        push(out, value & 0xFF)
    out

// ============================================================================
// PUBLIC: mqtt5_prop_encode
// ============================================================================

fn mqtt5_prop_encode(props)
    let n = len(props)
    if n == 0
        let empty = []
        push(empty, 0)
        return empty

    // Build encoded property bytes
    let prop_bytes = []
    let i = 0
    while i < n
        let pair = props[i]
        let prop_id = pair[0]
        let value = pair[1]
        prop_bytes = _m5p_enc_one(prop_bytes, prop_id, value)
        i = i + 1

    // Build final output: varint(len) + prop_bytes
    let out = []
    let pb_len = len(prop_bytes)
    out = _m5p_enc_varint(out, pb_len)
    let pi = 0
    while pi < pb_len
        push(out, prop_bytes[pi])
        pi = pi + 1
    out

// ============================================================================
// PUBLIC: mqtt5_prop_decode
// ============================================================================

fn mqtt5_prop_decode(pkt, pos)
    let fail_r = []
    push(fail_r, {})
    push(fail_r, pos)
    let pkt_len = len(pkt)
    if pos >= pkt_len
        return fail_r

    // Decode the varint length prefix
    let vr = _m5p_dec_varint(pkt, pos)
    let prop_len = vr[0]
    pos = vr[1]

    let end_pos = pos + prop_len
    if end_pos > pkt_len
        return fail_r

    let result = {}

    while pos < end_pos
        let prop_id = pkt[pos]
        pos = pos + 1

        if prop_id == 0x11 or prop_id == 0x27
            // Session-Expiry-Interval / Maximum-Packet-Size: u32
            if pos + 3 >= pkt_len
                return fail_r
            let v = _m5p_read_u32(pkt, pos)
            pos = pos + 4
            result[prop_id] = v
        else if prop_id == 0x21
            // Receive-Maximum: u16
            if pos + 1 >= pkt_len
                return fail_r
            let v = _m5p_read_u16(pkt, pos)
            pos = pos + 2
            result[0x21] = v
        else if prop_id == 0x26
            // User-Property: two strings
            let sr1 = _m5p_read_str(pkt, pos)
            let key = sr1[0]
            pos = sr1[1]
            let sr2 = _m5p_read_str(pkt, pos)
            let val = sr2[0]
            pos = sr2[1]
            // Accumulate into a list of [key,val] pairs for 0x26
            if contains(result, 0x26)
                let existing = result[0x26]
                let pair = []
                push(pair, key)
                push(pair, val)
                push(existing, pair)
            else
                let up_list = []
                let pair = []
                push(pair, key)
                push(pair, val)
                push(up_list, pair)
                result[0x26] = up_list
        else
            // Unknown: treat as u8
            if pos >= pkt_len
                return fail_r
            let v = pkt[pos]
            pos = pos + 1
            result[prop_id] = v

    let r = []
    push(r, result)
    push(r, pos)
    r
