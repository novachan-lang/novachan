// ============================================================================
// NOVA Standard Library — std/net/icmp_echo
// ============================================================================
// RFC 792 — ICMP echo request/reply parse/build, operating on a plain `list`
// of byte values (0..255). See std/net/icmpecho.nova for the `bytes`-typed
// equivalent.
//
// Wire layout (8-byte fixed header + variable data):
//   Byte  0    : type       (u8)  — 8 = echo request, 0 = echo reply
//   Byte  1    : code       (u8)  — 0 for echo
//   Bytes 2-3  : checksum   (u16) — RFC 1071 over the whole message
//   Bytes 4-5  : identifier (u16)
//   Bytes 6-7  : sequence   (u16)
//   Bytes 8..  : data       (list) — arbitrary payload, echoed back verbatim
//
// PUBLIC API:
//   icmp_parse(bytes: list) -> dict
//     Returns {} if fewer than 8 bytes.
//     Keys: type, code, checksum, identifier, sequence, data (list of the
//     remaining bytes, [] if none).
//
//   icmp_build(hdr: dict) -> list
//     Builds a full ICMP echo message: 8-byte header + hdr["data"] (default
//     []), with checksum COMPUTED over the entire message (checksum field
//     zeroed during the sum) and embedded at bytes 2-3, per RFC 792.
//     hdr keys: type (default 8), code (default 0), identifier (default 0),
//     sequence (default 0), data (default []).
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

fn _ice2_get(h: dict, key: string) -> int
    if contains(h, key)
        return h[key]
    0

fn _ice2_r16(b: list, i: int) -> int
    ((b[i] & 0xFF) << 8) | (b[i + 1] & 0xFF)

fn _ice2_w16(out: list, v: int) -> list
    push(out, (v >> 8) & 0xFF)
    push(out, v & 0xFF)
    out

// RFC 1071 ones-complement checksum over a list of byte ints.
fn _ice2_checksum(b: list) -> int
    let acc = 0
    let i = 0
    let n = len(b)
    while i + 1 < n
        acc = acc + (((b[i] & 0xFF) << 8) | (b[i + 1] & 0xFF))
        i = i + 2
    if i < n
        acc = acc + ((b[i] & 0xFF) << 8)
    while (acc >> 16) != 0
        acc = (acc & 0xFFFF) + ((acc >> 16) & 0xFFFF)
    (~acc) & 0xFFFF

// ── Public API ────────────────────────────────────────────────────────────────

fn icmp_parse(bytes: list) -> dict
    if len(bytes) < 8
        return {}
    let t = bytes[0] & 0xFF
    let code = bytes[1] & 0xFF
    let csum = _ice2_r16(bytes, 2)
    let ident = _ice2_r16(bytes, 4)
    let seq = _ice2_r16(bytes, 6)
    let n = len(bytes)
    let data = [bytes[i] for i in 8..n]
    {"type": t, "code": code, "checksum": csum, "identifier": ident, "sequence": seq, "data": data}

fn icmp_build(hdr: dict) -> list
    let t = 8
    if contains(hdr, "type")
        t = hdr["type"]
    let code = _ice2_get(hdr, "code")
    let ident = _ice2_get(hdr, "identifier")
    let seq = _ice2_get(hdr, "sequence")
    let data = []
    if contains(hdr, "data")
        data = hdr["data"]
    let out = []
    push(out, t & 0xFF)
    push(out, code & 0xFF)
    push(out, 0)
    push(out, 0)
    out = _ice2_w16(out, ident & 0xFFFF)
    out = _ice2_w16(out, seq & 0xFFFF)
    let i = 0
    let n = len(data)
    while i < n
        push(out, data[i] & 0xFF)
        i = i + 1
    let csum = _ice2_checksum(out)
    out[2] = (csum >> 8) & 0xFF
    out[3] = csum & 0xFF
    out
