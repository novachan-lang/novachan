// ============================================================================
// NOVA Standard Library — std/net/imap_line
// ============================================================================
// IMAP4rev1 command/response line framing (RFC 3501 §2.2).
//
// Every IMAP line (in either direction) has the shape "tag SP ... CRLF".
// Client -> server lines are tagged with a client-generated tag (see
// std/net/imap_tag). Server -> client lines are either tagged (a completion
// result for a specific client command) or untagged ("*", for status/data
// responses and greetings) or a continuation request ("+").
//
// PUBLIC API:
//   imap_cmd_build(tag: string, cmd: string, args: string) -> string
//     Build a client command line: "tag CMD args\r\n" if args is non-empty,
//     else "tag CMD\r\n".
//
//   imap_resp_parse(line: string) -> dict
//     Parse a server response line into:
//       "tag"  : string — the tag token: a client tag, "*" (untagged), or
//                         "+" (continuation request)
//       "type" : string — "OK" / "NO" / "BAD" / "BYE" if the token right
//                         after the tag is one of those four response
//                         conditions (RFC 3501 §7.1); otherwise "DATA" for
//                         any other untagged data response (e.g. "18 EXISTS",
//                         "FLAGS (\Seen)") or a continuation payload.
//       "text" : string — everything after the tag (and, when type is one
//                         of OK/NO/BAD/BYE, after that condition word too).
//     "A001 OK LOGIN completed"   -> tag="A001", type="OK",  text="LOGIN completed"
//     "* OK IMAP4rev1 ready"      -> tag="*",    type="OK",  text="IMAP4rev1 ready"
//     "* 18 EXISTS"               -> tag="*",    type="DATA", text="18 EXISTS"
//     "+ send literal"            -> tag="+",    type="DATA", text="send literal"
//
// DESIGN NOTES:
//   * CRLF = chr(13)+chr(10). Bare LF alone is also stripped (lenient).
//   * The condition word ("OK"/"NO"/"BAD"/"BYE") is matched case-
//     insensitively but reported UPPERCASED.
//   * Private helpers prefixed _imapl_.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

fn _imapl_strip_crlf(s: string) -> string
    let n = len(s)
    let stop = n
    if stop > 0 and ord(slice(s, stop - 1, stop)) == 10
        stop -= 1
    if stop > 0 and ord(slice(s, stop - 1, stop)) == 13
        stop -= 1
    slice(s, 0, stop)

// _imapl_split_token: return [first-space-delimited token, rest-trimmed].
fn _imapl_split_token(s: string) -> list
    let n = len(s)
    let i = 0
    while i < n and slice(s, i, i + 1) != " "
        i += 1
    let tok = slice(s, 0, i)
    let rest = ""
    if i < n
        rest = slice(s, i + 1, n)
        // trim a single leading space run
        let j = 0
        let rn = len(rest)
        while j < rn and slice(rest, j, j + 1) == " "
            j += 1
        rest = slice(rest, j, rn)
    let out = []
    push(out, tok)
    push(out, rest)
    out

// ── Public API ───────────────────────────────────────────────────────────────

// imap_cmd_build: build a tagged client command line.
fn imap_cmd_build(tag: string, cmd: string, args: string) -> string
    let crlf = chr(13) + chr(10)
    if len(args) == 0
        return tag + " " + cmd + crlf
    tag + " " + cmd + " " + args + crlf

// imap_resp_parse: parse a server response line.
fn imap_resp_parse(line: string) -> dict
    let out = {}
    out["tag"] = ""
    out["type"] = "DATA"
    out["text"] = ""

    let s = _imapl_strip_crlf(line)
    if len(s) == 0
        return out

    let first = _imapl_split_token(s)
    let tag = first[0]
    let after_tag = first[1]
    out["tag"] = tag
    out["text"] = after_tag

    let second = _imapl_split_token(after_tag)
    let cond = upper(second[0])
    if cond == "OK" or cond == "NO" or cond == "BAD" or cond == "BYE"
        out["type"] = cond
        out["text"] = second[1]
    out
