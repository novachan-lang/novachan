// ============================================================================
// NOVA Standard Library — std/net/http_status
// ============================================================================
// HTTP status code utilities.
//
// PUBLIC API:
//   hs_reason(code: int) -> string
//     Return the standard reason phrase for an HTTP status code,
//     e.g. 200 -> "OK", 404 -> "Not Found". Returns "" if unknown.
//
//   hs_is_informational(code: int) -> bool
//     True iff 100 <= code <= 199.
//
//   hs_is_success(code: int) -> bool
//     True iff 200 <= code <= 299.
//
//   hs_is_redirect(code: int) -> bool
//     True iff 300 <= code <= 399.
//
//   hs_is_client_error(code: int) -> bool
//     True iff 400 <= code <= 499.
//
//   hs_is_server_error(code: int) -> bool
//     True iff 500 <= code <= 599.
//
//   hs_category(code: int) -> string
//     Returns one of: "informational" / "success" / "redirection" /
//     "client_error" / "server_error" / "unknown".
//
// DESIGN NOTES:
//   * Uses if-chains (no module-level multi-line list) per NOVA gotchas.
//   * Covers all IANA-registered status codes (RFC 9110 + common extensions).
//   * All private helpers prefixed _hs_ to avoid symbol collisions.
//
// LEAF — imports NOTHING.
// ============================================================================

// hs_reason: return the standard reason phrase for a status code.
// Returns "" if the code is not recognised.
fn hs_reason(code: int) -> string
    if code == 100 then return "Continue"
    if code == 101 then return "Switching Protocols"
    if code == 102 then return "Processing"
    if code == 103 then return "Early Hints"
    if code == 200 then return "OK"
    if code == 201 then return "Created"
    if code == 202 then return "Accepted"
    if code == 203 then return "Non-Authoritative Information"
    if code == 204 then return "No Content"
    if code == 205 then return "Reset Content"
    if code == 206 then return "Partial Content"
    if code == 207 then return "Multi-Status"
    if code == 208 then return "Already Reported"
    if code == 226 then return "IM Used"
    if code == 300 then return "Multiple Choices"
    if code == 301 then return "Moved Permanently"
    if code == 302 then return "Found"
    if code == 303 then return "See Other"
    if code == 304 then return "Not Modified"
    if code == 305 then return "Use Proxy"
    if code == 307 then return "Temporary Redirect"
    if code == 308 then return "Permanent Redirect"
    if code == 400 then return "Bad Request"
    if code == 401 then return "Unauthorized"
    if code == 402 then return "Payment Required"
    if code == 403 then return "Forbidden"
    if code == 404 then return "Not Found"
    if code == 405 then return "Method Not Allowed"
    if code == 406 then return "Not Acceptable"
    if code == 407 then return "Proxy Authentication Required"
    if code == 408 then return "Request Timeout"
    if code == 409 then return "Conflict"
    if code == 410 then return "Gone"
    if code == 411 then return "Length Required"
    if code == 412 then return "Precondition Failed"
    if code == 413 then return "Content Too Large"
    if code == 414 then return "URI Too Long"
    if code == 415 then return "Unsupported Media Type"
    if code == 416 then return "Range Not Satisfiable"
    if code == 417 then return "Expectation Failed"
    if code == 418 then return "I'm a Teapot"
    if code == 421 then return "Misdirected Request"
    if code == 422 then return "Unprocessable Content"
    if code == 423 then return "Locked"
    if code == 424 then return "Failed Dependency"
    if code == 425 then return "Too Early"
    if code == 426 then return "Upgrade Required"
    if code == 428 then return "Precondition Required"
    if code == 429 then return "Too Many Requests"
    if code == 431 then return "Request Header Fields Too Large"
    if code == 451 then return "Unavailable For Legal Reasons"
    if code == 500 then return "Internal Server Error"
    if code == 501 then return "Not Implemented"
    if code == 502 then return "Bad Gateway"
    if code == 503 then return "Service Unavailable"
    if code == 504 then return "Gateway Timeout"
    if code == 505 then return "HTTP Version Not Supported"
    if code == 506 then return "Variant Also Negotiates"
    if code == 507 then return "Insufficient Storage"
    if code == 508 then return "Loop Detected"
    if code == 510 then return "Not Extended"
    if code == 511 then return "Network Authentication Required"
    return ""

// hs_is_informational: true iff 100..199
fn hs_is_informational(code: int) -> bool
    code >= 100 and code <= 199

// hs_is_success: true iff 200..299
fn hs_is_success(code: int) -> bool
    code >= 200 and code <= 299

// hs_is_redirect: true iff 300..399
fn hs_is_redirect(code: int) -> bool
    code >= 300 and code <= 399

// hs_is_client_error: true iff 400..499
fn hs_is_client_error(code: int) -> bool
    code >= 400 and code <= 499

// hs_is_server_error: true iff 500..599
fn hs_is_server_error(code: int) -> bool
    code >= 500 and code <= 599

// hs_category: classify a code into a named category string.
fn hs_category(code: int) -> string
    if code >= 100 and code <= 199 then return "informational"
    if code >= 200 and code <= 299 then return "success"
    if code >= 300 and code <= 399 then return "redirection"
    if code >= 400 and code <= 499 then return "client_error"
    if code >= 500 and code <= 599 then return "server_error"
    return "unknown"
