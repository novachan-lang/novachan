// ============================================================================
// NOVA Standard Library — std/net/coap_block
// ============================================================================
// RFC 7959 — CoAP Block1/Block2 option value codec.
//
// Block option value encoding packs three fields into 1-3 bytes:
//   value = (NUM << 4) | (M << 3) | SZX
//     NUM : block number (variable width, the upper bits)
//     M   : "more" flag (1 = more blocks follow, 0 = last block)
//     SZX : block size exponent (3 bits, 0..6; size = 2^(SZX+4))
//
// Encoding rule (RFC 7959 §2.2):
//   - value <= 0xFF     → 1 byte
//   - value <= 0xFFFF   → 2 bytes big-endian
//   - value <= 0xFFFFFF → 3 bytes big-endian
//   (NUM is restricted to 20 bits max = 3 bytes for the full value field)
//
// Block sizes (SZX → bytes):
//   SZX=0 → 16    SZX=1 → 32    SZX=2 → 64
//   SZX=3 → 128   SZX=4 → 256   SZX=5 → 512   SZX=6 → 1024
//
// PUBLIC API:
//   coap_block_encode(num, more, szx) -> list of int (byte-list)
//     Encodes block option value as 1-3 big-endian bytes.
//     num:  block number (0..0xFFFFF, 20-bit max per RFC)
//     more: 0 = last block, 1 = more blocks follow
//     szx:  block size exponent (0..6)
//
//   coap_block_decode(bl) -> list [num, more, szx]
//     Decodes a 1-3 byte block option value from a byte-list.
//     Returns [num, more, szx].
//     Empty input returns [0, 0, 0].
//
//   block_size(szx) -> int
//     Returns the block size in bytes: 2^(szx+4).
//     szx=0 → 16, szx=6 → 1024.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Public API ────────────────────────────────────────────────────────────────

// coap_block_encode: pack (num, more, szx) into 1-3 big-endian bytes.
//
// The CoAP block option value is:
//   value = (num << 4) | ((more & 1) << 3) | (szx & 7)
//
// Byte count:
//   value fits in 8 bits  → 1 byte
//   value fits in 16 bits → 2 bytes (big-endian)
//   otherwise             → 3 bytes (big-endian)
//
// Examples:
//   coap_block_encode(0, 0, 6) → [0x06]
//     value = (0<<4)|(0<<3)|6 = 6
//   coap_block_encode(1, 1, 2) → [0x1A]
//     value = (1<<4)|(1<<3)|2 = 16+8+2 = 26 = 0x1A
//   coap_block_encode(256, 1, 6) → 2-byte encoding
//     value = (256<<4)|(1<<3)|6 = 4096+8+6 = 4110 = 0x100E
fn coap_block_encode(num, more, szx)
    let value = (num << 4) | ((more & 1) << 3) | (szx & 7)
    let out = []
    if value <= 0xFF
        push(out, value & 0xFF)
    if value > 0xFF and value <= 0xFFFF
        push(out, (value >> 8) & 0xFF)
        push(out, value & 0xFF)
    if value > 0xFFFF
        push(out, (value >> 16) & 0xFF)
        push(out, (value >> 8) & 0xFF)
        push(out, value & 0xFF)
    out

// coap_block_decode: decode a 1-3 byte block option value.
//
// Interprets the byte-list as a big-endian unsigned integer, then unpacks:
//   szx  = value & 7
//   more = (value >> 3) & 1
//   num  = value >> 4
//
// Returns list [num, more, szx].
// Empty input → [0, 0, 0].
//
// Examples:
//   coap_block_decode([0x06])   → [0, 0, 6]
//   coap_block_decode([0x1A])   → [1, 1, 2]
fn coap_block_decode(bl)
    let n = len(bl)
    let value = 0
    if n == 0
        return [0, 0, 0]
    if n == 1
        value = bl[0] & 0xFF
    if n == 2
        value = ((bl[0] & 0xFF) << 8) | (bl[1] & 0xFF)
    if n >= 3
        value = ((bl[0] & 0xFF) << 16) | ((bl[1] & 0xFF) << 8) | (bl[2] & 0xFF)
    let szx  = value & 7
    let more = (value >> 3) & 1
    let num  = value >> 4
    [num, more, szx]

// block_size: compute CoAP block size in bytes from SZX exponent.
//
// RFC 7959: block_size = 2^(szx+4)
//   szx=0 → 16, szx=1 → 32, szx=2 → 64
//   szx=3 → 128, szx=4 → 256, szx=5 → 512, szx=6 → 1024
//
// Implemented via a shift: 1 << (szx + 4).
fn block_size(szx)
    1 << (szx + 4)
