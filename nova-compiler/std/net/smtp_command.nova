// ============================================================================
// NOVA Standard Library — std/net/smtp_command
// ============================================================================
// SMTP command-line parsing and building (RFC 5321 §4.1), server-side view.
//
// Where std/net/smtp_line focuses on the CLIENT side (building commands,
// parsing server replies), this module focuses on the SERVER side: taking a
// raw command line received from a client and splitting it into its verb and
// argument, per RFC 5321 §4.1.1's "command-line = command-verb [SP
// command-arguments] CRLF" grammar.
//
// PUBLIC API:
//   smtp_cmd_parse(line: string) -> dict
//     Split a raw SMTP command line into:
//       "verb" : string — the command verb, UPPERCASED (e.g. "EHLO", "MAIL")
//       "arg"  : string — everything after the verb and its separating space,
//                         trimmed of surrounding whitespace. "" if no arg.
//     CRLF / bare LF is stripped first. The verb is only the FIRST word: for
//     compound commands like "MAIL FROM:<a@b>" the verb is "MAIL" and the arg
//     is "FROM:<a@b>" — further parsing of that arg is smtp_mailfrom's job.
//     Empty line -> verb="", arg="".
//
//   smtp_cmd_build(verb: string, arg: string) -> string
//     Build a raw command line: "VERB arg\r\n" if arg is non-empty,
//     else "VERB\r\n". No punctuation is inserted — callers that need
//     "MAIL FROM:<addr>" pass arg="FROM:<addr>" directly.
//
// DESIGN NOTES:
//   * CRLF = chr(13)+chr(10). Bare LF alone is also accepted (lenient).
//   * The verb is matched case-insensitively by convention (EHLO/ehlo/Ehlo
//     all valid per RFC 5321) — smtp_cmd_parse UPPERCASES it so callers can
//     compare against a single canonical form (the verb list this module
//     recognises structurally, not by validating against, includes EHLO,
//     HELO, MAIL, RCPT, DATA, QUIT, RSET, NOOP, VRFY, AUTH — but ANY verb
//     token is accepted; validation is the caller's responsibility).
//   * Multiple internal spaces between verb and arg are collapsed only in
//     that the FIRST space is the separator; the arg keeps any interior
//     spacing verbatim (trimmed only at its own edges).
//   * Private helpers prefixed _smtpc_.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _smtpc_strip_crlf: remove trailing CR (13) and/or LF (10) from a line.
fn _smtpc_strip_crlf(s: string) -> string
    let n = len(s)
    let stop = n
    if stop > 0 and ord(slice(s, stop - 1, stop)) == 10
        stop -= 1
    if stop > 0 and ord(slice(s, stop - 1, stop)) == 13
        stop -= 1
    slice(s, 0, stop)

// _smtpc_trim: strip leading/trailing ASCII spaces (space + tab).
fn _smtpc_trim(s: string) -> string
    let n = len(s)
    let start = 0
    while start < n and (slice(s, start, start + 1) == " " or slice(s, start, start + 1) == chr(9))
        start += 1
    let stop = n
    while stop > start and (slice(s, stop - 1, stop) == " " or slice(s, stop - 1, stop) == chr(9))
        stop -= 1
    slice(s, start, stop)

// ── Public API ───────────────────────────────────────────────────────────────

// smtp_cmd_parse: split a raw command line into verb (uppercased) + arg.
fn smtp_cmd_parse(line: string) -> dict
    let out = {}
    out["verb"] = ""
    out["arg"] = ""

    let stripped = _smtpc_trim(_smtpc_strip_crlf(line))
    let n = len(stripped)
    if n == 0
        return out

    // Find the first space separating verb from arg.
    let i = 0
    while i < n and slice(stripped, i, i + 1) != " "
        i += 1

    let verb_raw = slice(stripped, 0, i)
    out["verb"] = upper(verb_raw)

    if i < n
        out["arg"] = _smtpc_trim(slice(stripped, i + 1, n))
    out

// smtp_cmd_build: build a raw command line "VERB arg\r\n" / "VERB\r\n".
fn smtp_cmd_build(verb: string, arg: string) -> string
    let crlf = chr(13) + chr(10)
    if len(arg) == 0
        return verb + crlf
    verb + " " + arg + crlf
