// ============================================================================
// NOVA Standard Library — std/net/ipv6
// ============================================================================
// IPv6 address parsing, formatting, validation, and expansion.
//
// PUBLIC API:
//   ip6_parse(s: string) -> list
//     Parse an IPv6 address string into a list of 8 ints (each 0..65535).
//     Handles "::" zero-compression.  Returns [] on any error.
//
//   ip6_is_valid(s: string) -> bool
//     Returns true iff ip6_parse(s) produces a valid 8-element list.
//
//   ip6_format(groups: list) -> string
//     Canonical lowercase form of 8-element int list.  Strips leading zeros.
//     Compresses the FIRST longest run of >= 2 consecutive zero groups to "::".
//     Per RFC 5952: single run of >= 2 zeros -> "::"; no run -> no "::".
//
//   ip6_expand(s: string) -> string
//     Full expanded form: 8 groups of exactly 4 lowercase hex digits joined by ":".
//     Returns "" on invalid input.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// Value of one hex character: '0'-'9'->0-9, 'a'-'f'->10-15, 'A'-'F'->10-15.
// Returns -1 for non-hex characters.
fn _i6_hex_val(c: string) -> int
    let b = ord(c)
    if b >= 48 and b <= 57
        return b - 48
    if b >= 97 and b <= 102
        return b - 87
    if b >= 65 and b <= 70
        return b - 55
    -1

// Parse a single hex group string (1-4 hex chars) -> 0..65535, or -1 on error.
fn _i6_parse_group(s: string) -> int
    let n = len(s)
    if n == 0 or n > 4
        return -1
    let v = 0
    for i in 0..n
        let d = _i6_hex_val(char_at(s, i))
        if d < 0
            return -1
        v *= 16 + d
    v

// Zero-pad a string to exactly 4 characters by prepending "0"s.
fn _i6_pad4(s: string) -> string
    let n = len(s)
    if n >= 4
        return s
    if n == 3
        return "0" + s
    if n == 2
        return "00" + s
    if n == 1
        return "000" + s
    "0000"

// Count non-overlapping occurrences of sub in s.
fn _i6_count_str(s: string, sub: string) -> int
    let count = 0
    let pos = 0
    let slen = len(s)
    let sublen = len(sub)
    while pos <= slen - sublen
        let chunk = slice(s, pos, pos + sublen)
        if chunk == sub
            count += 1
            pos += sublen
        else
            pos += 1
    count

// Split a possibly-empty colon-separated string into group strings.
// Returns [] for empty input (so we can distinguish "no groups" from "one empty group").
fn _i6_split_half(s: string) -> list
    if len(s) == 0
        return []
    split(s, ":")

// Parse a list of group strings into a list of ints.
// Returns [] if any group string is invalid.
fn _i6_parse_half(parts: list) -> list
    let result = []
    for i in 0..len(parts)
        let g = _i6_parse_group(parts[i])
        if g < 0
            return []
        result.push(g)
    result

// ── Public API ────────────────────────────────────────────────────────────────

// ip6_parse: IPv6 string -> list of 8 ints, each 0..65535. Returns [] on error.
//
// Supported forms:
//   "2001:0db8:0000:0000:0000:0000:0000:0001"  (full 8-group form)
//   "2001:db8::1"       ("::" expands to enough zero groups)
//   "::1"               (loopback)
//   "::"                (all zeros)
//   "1::"               (trailing "::")
fn ip6_parse(s: string) -> list
    if len(s) == 0
        return []
    // Triple colon is always invalid
    if _i6_count_str(s, ":::") > 0
        return []
    // At most one "::" allowed
    let dc = _i6_count_str(s, "::")
    if dc > 1
        return []
    if dc == 1
        // Split on "::" — exactly one occurrence
        let dpos = find(s, "::")
        let left_str = slice(s, 0, dpos)
        let right_str = slice(s, dpos + 2, len(s))
        // Parse the left side
        let left_parts = _i6_split_half(left_str)
        let left_groups = _i6_parse_half(left_parts)
        // If left_str was non-empty, we must have parsed all parts successfully
        if len(left_str) > 0 and len(left_groups) != len(left_parts)
            return []
        if len(left_str) > 0 and len(left_parts) == 0
            return []
        // Parse the right side
        let right_parts = _i6_split_half(right_str)
        let right_groups = _i6_parse_half(right_parts)
        if len(right_str) > 0 and len(right_groups) != len(right_parts)
            return []
        if len(right_str) > 0 and len(right_parts) == 0
            return []
        // Total explicit groups must be <= 7 ("::" must expand at least 1 group)
        let total = len(left_groups) + len(right_groups)
        if total > 7
            return []
        // Build result: left groups + zero fill + right groups
        let zeros_needed = 8 - total
        let result = []
        for i in 0..len(left_groups)
            result.push(left_groups[i])
        for z in 0..zeros_needed
            result.push(0)
        for j in 0..len(right_groups)
            result.push(right_groups[j])
        return result
    // No "::" — must be exactly 8 colon-separated groups.
    // A leading or trailing bare ":" (without partner) is invalid.
    if char_at(s, 0) == ":"
        return []
    if char_at(s, len(s) - 1) == ":"
        return []
    let parts = split(s, ":")
    if len(parts) != 8
        return []
    let result = []
    for i in 0..8
        let g = _i6_parse_group(parts[i])
        if g < 0
            return []
        result.push(g)
    result

// ip6_is_valid: true iff ip6_parse produces an 8-element list.
fn ip6_is_valid(s: string) -> bool
    let groups = ip6_parse(s)
    len(groups) == 8

// ip6_format: canonical lowercase string for a list of 8 IPv6 group ints.
// Finds the FIRST longest run of >= 2 consecutive zeros and compresses to "::".
// Per RFC 5952, leading zeros in each group are stripped.
fn ip6_format(groups: list) -> string
    // Find the best (first, longest) zero run of length >= 2
    let bs = -1
    let bl = 0
    let cs = -1
    let cl = 0
    for i in 0..8
        if groups[i] == 0
            if cs < 0
                cs = i
                cl = 1
            else
                cl += 1
        else
            if cl > bl
                bs = cs
                bl = cl
            cs = -1
            cl = 0
    // Check final run
    if cl > bl
        bs = cs
        bl = cl
    // Only use "::" if run length >= 2
    if bl < 2
        bs = -1
        bl = 0
    // Case: no compression
    if bs < 0
        let out = ""
        for k in 0..8
            if k == 0
                out = hex(groups[k])
            else
                out += ":" + hex(groups[k])
        return out
    // Case: entire address is zeros
    if bs == 0 and bl == 8
        return "::"
    // Build left part: groups[0..bs-1]
    let left = ""
    for lk in 0..bs
        if lk == 0
            left = hex(groups[lk])
        else
            left += ":" + hex(groups[lk])
    // Build right part: groups[bs+bl..7]
    let right = ""
    let rk = bs + bl
    let rfirst = true
    while rk < 8
        if rfirst
            right = hex(groups[rk])
            rfirst = false
        else
            right += ":" + hex(groups[rk])
        rk += 1
    // Assemble: left + "::" + right
    if bs == 0
        // Run at start: "::right"
        return "::" + right
    if bs + bl == 8
        // Run at end: "left::"
        return left + "::"
    // Run in middle: "left::right"
    left + "::" + right

// ip6_expand: full 8-group form with exactly 4 lowercase hex digits per group.
// Returns "" on invalid input.
fn ip6_expand(s: string) -> string
    let groups = ip6_parse(s)
    if len(groups) != 8
        return ""
    let out = ""
    for i in 0..8
        let h = _i6_pad4(hex(groups[i]))
        if i == 0
            out = h
        else
            out += ":" + h
    out
