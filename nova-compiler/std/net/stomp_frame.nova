// ============================================================================
// NOVA Standard Library — std/net/stomp_frame
// ============================================================================
// STOMP 1.2 frame parser (byte-list based).
//
// STOMP frame wire format:
//   COMMAND LF
//   header-name:header-value LF
//   ... (more headers) ...
//   LF                    <- blank line separates headers from body
//   body bytes
//   NUL (0x00)            <- frame terminator
//
// LF = 0x0A (10), NUL = 0x00.
//
// PUBLIC API:
//   stomp_frame_parse(frame_bytes: list) -> dict
//     Parse a STOMP frame from a byte-list.
//     Returns a dict with:
//       "command"  -> string  (e.g. "CONNECT", "SEND")
//       "headers"  -> dict    (key -> value strings)
//       "body"     -> string  (body bytes decoded as ASCII; stops before NUL)
//     On malformed input, returns command="" headers={} body="".
//
// WIRE NOTES:
//   * Bytes are ints 0..255 in a NOVA list.
//   * Command and header lines are ASCII text.
//   * Body is ASCII text (STOMP 1.2 forbids NUL inside body without content-length).
//   * The trailing NUL (0) terminates the frame; not included in body.
//   * Blank line (LF after last header, or LF immediately after command LF if
//     no headers) separates headers from body.
//   * Private helpers prefixed _stf_.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _stf_lf: LF byte value
fn _stf_lf() -> int
    10

// _stf_nul: NUL byte value
fn _stf_nul() -> int
    0

// _stf_colon: colon ASCII code
fn _stf_colon() -> int
    58

// _stf_read_line: read bytes from pos until LF (or end), return [line_string, next_pos].
// The LF byte is consumed (not included in the string).
fn _stf_read_line(frame: list, pos: int) -> list
    let n = len(frame)
    let s = ""
    let cur = pos
    let done = 0
    while cur < n and done == 0
        let b = frame[cur]
        cur = cur + 1
        if b == _stf_lf()
            done = 1
        else
            s = s + chr(b)
    let result = []
    push(result, s)
    push(result, cur)
    result

// _stf_parse_header: parse "key:value" string into [key, value].
// Returns ["",""] if no colon found.
fn _stf_parse_header(line: string) -> list
    let n = len(line)
    let colon_pos = -1
    let i = 0
    while i < n
        let ch = slice(line, i, i + 1)
        if ord(ch) == _stf_colon()
            if colon_pos == -1
                colon_pos = i
        i = i + 1
    let result = []
    if colon_pos == -1
        push(result, "")
        push(result, "")
    else
        push(result, slice(line, 0, colon_pos))
        push(result, slice(line, colon_pos + 1, n))
    result

// _stf_read_body: read bytes from pos until NUL or end of frame, return as string.
fn _stf_read_body(frame: list, pos: int) -> string
    let n = len(frame)
    let s = ""
    let cur = pos
    let done = 0
    while cur < n and done == 0
        let b = frame[cur]
        if b == _stf_nul()
            done = 1
        else
            s = s + chr(b)
            cur = cur + 1
    s

// ── Public API ───────────────────────────────────────────────────────────────

fn stomp_frame_parse(frame_bytes: list) -> dict
    let empty_headers = {}
    let result = {}
    result["command"] = ""
    result["headers"] = empty_headers
    result["body"] = ""

    let n = len(frame_bytes)
    if n == 0
        return result

    // Step 1: read the command line (terminated by LF)
    let cmd_res = _stf_read_line(frame_bytes, 0)
    let command = cmd_res[0]
    let pos = cmd_res[1]

    if len(command) == 0
        return result

    // Step 2: read header lines until a blank line (empty line = just LF)
    let headers = {}
    let reading_headers = 1
    while reading_headers == 1 and pos < n
        let hdr_res = _stf_read_line(frame_bytes, pos)
        let hdr_line = hdr_res[0]
        pos = hdr_res[1]
        if len(hdr_line) == 0
            // blank line: end of headers
            reading_headers = 0
        else
            let kv = _stf_parse_header(hdr_line)
            let k = kv[0]
            let v = kv[1]
            if len(k) > 0
                headers[k] = v

    // Step 3: read body (until NUL)
    let body = _stf_read_body(frame_bytes, pos)

    result["command"] = command
    result["headers"] = headers
    result["body"] = body
    result
