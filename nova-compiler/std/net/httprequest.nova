// ============================================================================
// NOVA Standard Library — std/net/httprequest
// ============================================================================
// Build raw HTTP/1.1 request strings (no sockets).
//
// PUBLIC API:
//   hr_build(method, path, headers, body) -> string
//     Build a complete HTTP/1.1 request string.
//     - First line: "METHOD path HTTP/1.1" + CRLF
//     - Headers: one "Name: value" + CRLF per entry, keys SORTED for
//       deterministic output.
//     - If body is non-empty and no "Content-Length" key is present in
//       headers, "Content-Length: <len(body)>" is appended automatically
//       (inserted after the sorted user headers, before the blank line).
//     - Blank line (CRLF) separates headers from body.
//     - Body appended as-is.
//
//   hr_get(path) -> string
//     Convenience: GET <path> HTTP/1.1 with no headers and no body.
//
// CRLF is chr(13)+chr(10) per RFC 7230.
//
// DESIGN NOTES:
//   * Headers dict keys are strings.  Missing key lookup returns int 0 in
//     NOVA; we use contains() before reading string values.
//   * Keys are sorted lexicographically via sort() for determinism.
//   * Content-Length is auto-inserted only when body is non-empty and the
//     caller has not already supplied it.  A GET with an empty body gets no
//     Content-Length header (matching standard practice).
//   * "Content-Length" key comparison uses lowercase normalisation so that
//     "content-length" from the caller also suppresses auto-insert.
//
// SYMBOL COLLISION GUARD:
//   All private helpers are prefixed _hr_ to avoid clashes.
//
// LEAF — imports NOTHING.

// ── Private helpers ───────────────────────────────────────────────────────────

// _hr_crlf: the two-byte CRLF sequence.
fn _hr_crlf() -> string
    chr(13) + chr(10)

// _hr_to_lower: convert an ASCII string to lowercase.
// Used only for case-insensitive header-name comparisons.
fn _hr_to_lower(s: string) -> string
    let result = ""
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(char_at(s, i))
        // 'A'..'Z' = 65..90 -> shift +32
        if b >= 65 and b <= 90
            result = result + chr(b + 32)
        else
            result = result + char_at(s, i)
        i = i + 1
    result

// _hr_has_content_length: true if the headers dict already contains a
// Content-Length key (case-insensitive).
fn _hr_has_content_length(headers: dict) -> bool
    let ks = keys(headers)
    let i = 0
    while i < len(ks)
        let k = ks[i]
        if _hr_to_lower(k) == "content-length"
            return true
        i = i + 1
    false

// ── Public API ────────────────────────────────────────────────────────────────

// hr_build: build a raw HTTP/1.1 request string.
//
// Examples:
//   hr_build("GET", "/", {}, "")
//     -> "GET / HTTP/1.1\r\n\r\n"
//
//   hr_build("POST", "/api", {"Host":"example.com"}, "hi")
//     -> "POST /api HTTP/1.1\r\nContent-Length: 2\r\nHost: example.com\r\n\r\nhi"
//
//   hr_build("PUT", "/x", {"Content-Length":"99","Host":"h"}, "data")
//     -> "PUT /x HTTP/1.1\r\nContent-Length: 99\r\nHost: h\r\n\r\ndata"
//     (caller-supplied Content-Length wins; no duplicate auto-inserted)
fn hr_build(method: string, path: string, headers: dict, body: string) -> string
    let crlf = _hr_crlf()
    // Request line
    let result = method + " " + path + " HTTP/1.1" + crlf
    // Sort header keys for deterministic output
    let ks = keys(headers)
    sort(ks)
    // Emit sorted user-supplied headers
    let i = 0
    while i < len(ks)
        let k = ks[i]
        let v = headers[k]
        result = result + k + ": " + v + crlf
        i = i + 1
    // Auto-insert Content-Length when body is non-empty and not already set
    if len(body) > 0
        if not _hr_has_content_length(headers)
            result = result + "Content-Length: " + str(len(body)) + crlf
    // Blank line separating headers from body
    result = result + crlf
    // Body
    result = result + body
    result

// hr_get: convenience GET request with no headers and no body.
//
// Example:
//   hr_get("/")   -> "GET / HTTP/1.1\r\n\r\n"
//   hr_get("/health") -> "GET /health HTTP/1.1\r\n\r\n"
fn hr_get(path: string) -> string
    hr_build("GET", path, {}, "")
