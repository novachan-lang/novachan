// ============================================================================
// NOVA Standard Library — std/net/stomp_build
// ============================================================================
// STOMP 1.2 frame builder (byte-list based).
//
// STOMP frame wire format:
//   COMMAND LF
//   header-name:header-value LF
//   ... (more headers) ...
//   LF                    <- blank line separates headers from body
//   body bytes
//   NUL (0x00)            <- frame terminator
//
// LF = 0x0A (10), NUL = 0x00.
//
// PUBLIC API:
//   stomp_build(command: string, headers_pairs: list, body: string) -> list
//     Build a STOMP frame as a byte-list.
//     command:       the STOMP command string (e.g. "SEND", "CONNECT")
//     headers_pairs: list of 2-element lists [[key, value], ...]
//     body:          body string (may be empty)
//     Returns a byte-list representing the complete STOMP frame.
//
// EXAMPLE:
//   stomp_build("SEND", [["destination", "/q"]], "hi")
//   -> bytes for: "SEND" LF "destination:/q" LF LF "hi" NUL
//
// DESIGN NOTES:
//   * Bytes are ints 0..255 in a NOVA list.
//   * Command and headers are ASCII text; body is ASCII text.
//   * NUL (0) terminates the frame.
//   * Private helpers prefixed _stb_.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _stb_lf: LF byte value
fn _stb_lf() -> int
    10

// _stb_nul: NUL byte value
fn _stb_nul() -> int
    0

// _stb_colon: colon ASCII code
fn _stb_colon() -> int
    58

// _stb_append_string: append all bytes of a string to a byte-list.
fn _stb_append_string(out: list, s: string) -> list
    let n = len(s)
    for i in 0..n
        push(out, ord(slice(s, i, i + 1)))
    out

// ── Public API ───────────────────────────────────────────────────────────────

fn stomp_build(command: string, headers_pairs: list, body: string) -> list
    let out = []

    // Emit command + LF
    out = _stb_append_string(out, command)
    push(out, _stb_lf())

    // Emit each header pair: "key:value" LF
    let h = 0
    let num_headers = len(headers_pairs)
    while h < num_headers
        let pair = headers_pairs[h]
        let key = pair[0]
        let val = pair[1]
        out = _stb_append_string(out, key)
        push(out, _stb_colon())
        out = _stb_append_string(out, val)
        push(out, _stb_lf())
        h = h + 1

    // Emit blank line (end of headers)
    push(out, _stb_lf())

    // Emit body bytes
    out = _stb_append_string(out, body)

    // Emit NUL terminator
    push(out, _stb_nul())

    out
