// ============================================================================
// NOVA Standard Library — std/net/dns_query
// ============================================================================
// High-level DNS query/response helpers with EDNS0 (RFC 1035, RFC 6891).
//
// This module builds standard DNS queries (QR=0, RD=1, one question, one
// EDNS0 OPT pseudo-RR in the additional section) and parses DNS responses
// into a structured dict containing the answer RRs.
//
// All wire formats are big-endian.  Binary data uses the NOVA bytes type.
// Every byte read is bounds-checked; malformed input yields empty/zero results.
//
// PUBLIC API:
//
//   dns_build_query(qname: string, qtype: int, id: int) -> bytes
//     Build a complete DNS query message with:
//       - Header: id=id, QR=0, OPCODE=0, RD=1, qdcount=1, arcount=1.
//       - One Question: qname/qtype/IN.
//       - One OPT pseudo-RR (EDNS0): name=root (0x00), TYPE=41,
//         CLASS=4096 (UDP payload size), TTL=0, RDLENGTH=0.
//     Returns the wire bytes.
//     Returns bytes(0) on encoding error (e.g. invalid qname label).
//
//   dns_parse_response(b: bytes) -> dict
//     Parse a raw DNS response message.
//     Returns a dict with keys:
//       "id"      : int  — message identifier
//       "rcode"   : int  — response code (0=NOERROR, 3=NXDOMAIN, ...)
//       "answers" : list — list of answer RR dicts (see below)
//     Returns {"id":0, "rcode":0, "answers":[]} on malformed input.
//
//     Each answer RR dict has keys:
//       "name"     : string — decoded owner name
//       "type"     : int    — RR type (A=1, AAAA=28, MX=15, ...)
//       "class"    : int    — RR class (IN=1)
//       "ttl"      : int    — time-to-live (u32)
//       "rdlength" : int    — raw RDATA byte count
//       "rdata"    : bytes  — raw RDATA bytes
//
//   dns_answers(b: bytes) -> list
//     Shorthand: parse b and return only the answers list.
//     Equivalent to dns_parse_response(b)["answers"].
//
// DESIGN NOTES:
//   * All private helpers are prefixed _dqy_ to avoid symbol collisions.
//   * Name encoding is uncompressed (always valid per RFC 1035).
//   * Name decoding follows compression pointers (capped at 128 hops).
//   * EDNS0 OPT RR has zero options (RDLENGTH=0); CLASS encodes UDP payload
//     size (4096), TTL encodes extended RCODE and flags (all zero here).
//   * TTL is a u32 on the wire; NOVA ints are i64 — always mask & 0xFFFFFFFF.
//   * >> is arithmetic in NOVA; mask with &0xFF / &0xFFFF / &0xFFFFFFFF.
//
// SELF-CONTAINED — no imports from sibling dns_* modules.
// ============================================================================

// ── Private constants ─────────────────────────────────────────────────────────

let _dqy_MAX_JUMPS = 128
let _dqy_EDNS_UDP_SIZE = 4096
let _dqy_OPT_TYPE = 41

// ── Private: big-endian readers/writers ───────────────────────────────────────

// Read big-endian u16 from bytes b at offset i.
// Caller must ensure i+1 < bytes_len(b).
fn _dqy_r16(b: bytes, i: int) -> int
    ((bytes_get(b, i) << 8) | bytes_get(b, i + 1)) & 0xFFFF

// Read big-endian u32 from bytes b at offset i.
// Caller must ensure i+3 < bytes_len(b).
fn _dqy_r32(b: bytes, i: int) -> int
    ((bytes_get(b, i) << 24) | (bytes_get(b, i + 1) << 16) | (bytes_get(b, i + 2) << 8) | bytes_get(b, i + 3)) & 0xFFFFFFFF

// Append big-endian u16 to out; return updated bytes.
fn _dqy_w16(out: bytes, v: int) -> bytes
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// Append big-endian u32 to out; return updated bytes.
fn _dqy_w32(out: bytes, v: int) -> bytes
    out = bytes_append(out, (v >> 24) & 0xFF)
    out = bytes_append(out, (v >> 16) & 0xFF)
    out = bytes_append(out, (v >> 8) & 0xFF)
    out = bytes_append(out, v & 0xFF)
    out

// ── Private: DNS name encoder (uncompressed) ──────────────────────────────────

// Encode a dotted DNS name to uncompressed wire format.
// "example.com" -> [7,'e','x','a','m','p','l','e', 3,'c','o','m', 0]  (13 bytes)
// Root or empty name -> [0] (1 byte).
// Returns bytes(0) on error (empty interior label, label longer than 63 chars).
fn _dqy_name_enc(name: string) -> bytes
    let out = bytes(0)
    if len(name) == 0 or name == "."
        out = bytes_append(out, 0)
        return out
    let work = name
    let n = len(name)
    if char_at(name, n - 1) == "."
        work = slice(name, 0, n - 1)
    let parts = split(work, ".")
    for pi in 0..len(parts)
        let lbl = parts[pi]
        let ll = len(lbl)
        if ll == 0 or ll > 63
            return bytes(0)
        out = bytes_append(out, ll)
        let ci = 0
        while ci < ll
            out = bytes_append(out, ord(char_at(lbl, ci)))
            ci += 1
    out = bytes_append(out, 0)
    out

// ── Private: DNS name decoder (handles compression pointers) ──────────────────

// Decode a DNS name from msg starting at byte offset pos.
// Returns [name_string, next_pos] where next_pos is the offset in the
// *original* stream immediately after this name's wire bytes.
// Follows compression pointers (RFC 1035 §4.1.4); caps hops at 128.
// Returns ["", pos] on any malformed input.
fn _dqy_name_dec(msg: bytes, pos: int) -> list
    let mlen = bytes_len(msg)
    let name = ""
    let cur = pos
    let hops = 0
    let jumped = false
    let npos = pos
    let done = false
    while not done
        if cur < 0 or cur >= mlen
            return ["", pos]
        let b0 = bytes_get(msg, cur)
        if (b0 & 0xC0) == 0xC0
            // Compression pointer
            if cur + 1 >= mlen
                return ["", pos]
            let b1 = bytes_get(msg, cur + 1)
            if not jumped
                npos = cur + 2
            jumped = true
            hops += 1
            if hops > _dqy_MAX_JUMPS
                return ["", pos]
            cur = ((b0 & 0x3F) << 8) | b1
        else
            let ll = b0 & 0xFF
            if ll == 0
                // Terminating zero label
                if not jumped
                    npos = cur + 1
                done = true
            else
                if (b0 & 0xC0) != 0
                    // Reserved top-bit patterns (01xx or 10xx) — malformed
                    return ["", pos]
                cur += 1
                if cur + ll > mlen
                    return ["", pos]
                let lbl_parts = []
                for li in 0..ll
                    push(lbl_parts, chr(bytes_get(msg, cur + li)))
                let lbl = join(lbl_parts, "")
                if len(name) > 0
                    name += "."
                name += lbl
                cur += ll
    [name, npos]

// ── Private: decode 12-byte DNS header ───────────────────────────────────────

// Decode the 12-byte DNS header at position pos inside b.
// Returns [header_dict, pos+12] or [{}, pos] on bounds failure.
fn _dqy_hdr_dec(b: bytes, pos: int) -> list
    let empty = {}
    if bytes_len(b) < pos + 12
        return [empty, pos]
    let id    = _dqy_r16(b, pos)
    let flags = _dqy_r16(b, pos + 2)
    let qd    = _dqy_r16(b, pos + 4)
    let an    = _dqy_r16(b, pos + 6)
    let ns    = _dqy_r16(b, pos + 8)
    let ar    = _dqy_r16(b, pos + 10)
    let qr     = (flags >> 15) & 1
    let opcode = (flags >> 11) & 0xF
    let aa     = (flags >> 10) & 1
    let tc     = (flags >> 9) & 1
    let rd     = (flags >> 8) & 1
    let ra     = (flags >> 7) & 1
    let rcode  = flags & 0xF
    let hdr = {"id": id, "qr": qr, "opcode": opcode, "aa": aa, "tc": tc, "rd": rd, "ra": ra, "rcode": rcode, "qdcount": qd, "ancount": an, "nscount": ns, "arcount": ar}
    [hdr, pos + 12]

// ── Private: skip one DNS question record ────────────────────────────────────

// Skip over one DNS question record starting at pos; return next_pos.
// Returns -1 on malformed input.
fn _dqy_skip_question(msg: bytes, pos: int) -> int
    let mlen = bytes_len(msg)
    let nr = _dqy_name_dec(msg, pos)
    let nname = nr[0]
    let after = nr[1]
    if after == pos and nname == ""
        // decode error check: it is an error only if after <= pos
        if after <= pos
            return -1
    // Need 4 more bytes for QTYPE + QCLASS
    if after + 4 > mlen
        return -1
    after + 4

// ── Private: decode one RR ───────────────────────────────────────────────────

// Decode one resource record from msg at byte offset pos.
// Returns [rr_dict, next_pos] or [{}, pos] on malformed input.
fn _dqy_rr_dec(msg: bytes, pos: int) -> list
    let mlen = bytes_len(msg)
    let empty = {}
    // Decode NAME
    let nr = _dqy_name_dec(msg, pos)
    let rname = nr[0]
    let cur = nr[1]
    // Detect name-decode error: cur == pos and rname == "" and nothing consumed
    if cur == pos and rname == ""
        // Validate: if pos < mlen and byte at pos == 0, name is root, cur = pos+1
        // That case is NOT an error (cur would be pos+1 not pos)
        // So cur==pos here truly means error
        return [empty, pos]
    // Need 10 bytes: TYPE(2)+CLASS(2)+TTL(4)+RDLENGTH(2)
    if cur + 10 > mlen
        return [empty, pos]
    let rtype  = _dqy_r16(msg, cur)
    cur += 2
    let rclass = _dqy_r16(msg, cur)
    cur += 2
    let ttl    = _dqy_r32(msg, cur)
    cur += 4
    let rdlen  = _dqy_r16(msg, cur)
    cur += 2
    if cur + rdlen > mlen
        return [empty, pos]
    let rdata = bytes_slice(msg, cur, cur + rdlen)
    cur += rdlen
    let rec = {"name": rname, "type": rtype, "class": rclass, "ttl": ttl, "rdlength": rdlen, "rdata": rdata}
    [rec, cur]

// ── Public API ────────────────────────────────────────────────────────────────

// dns_build_query: build a complete DNS query message with EDNS0.
//
// Wire layout:
//   Header  (12 bytes): id=id, QR=0, RD=1, qdcount=1, arcount=1
//   Question (17+ bytes for "example.com"): qname wire + qtype u16 + class(IN=1) u16
//   OPT RR  (11 bytes): 0x00 (root name) + TYPE=41 u16 + CLASS=4096 u16 + TTL=0 u32 + RDLENGTH=0 u16
//
// Returns bytes(0) on encoding error.
fn dns_build_query(qname: string, qtype: int, id: int) -> bytes
    // ── Header ────────────────────────────────────────────────────────────────
    // flags: RD=1 => bit 8 set => 0x0100
    let flags = 0x0100
    let out = bytes(0)
    out = _dqy_w16(out, id & 0xFFFF)
    out = _dqy_w16(out, flags)
    out = _dqy_w16(out, 1)       // qdcount = 1
    out = _dqy_w16(out, 0)       // ancount = 0
    out = _dqy_w16(out, 0)       // nscount = 0
    out = _dqy_w16(out, 1)       // arcount = 1 (the OPT RR)
    // ── Question ─────────────────────────────────────────────────────────────
    let name_bytes = _dqy_name_enc(qname)
    if bytes_len(name_bytes) == 0
        return bytes(0)
    out = bytes_concat(out, name_bytes)
    out = _dqy_w16(out, qtype & 0xFFFF)
    out = _dqy_w16(out, 1)       // QCLASS = IN = 1
    // ── EDNS0 OPT pseudo-RR ──────────────────────────────────────────────────
    // NAME = root = single 0x00 byte
    out = bytes_append(out, 0)
    // TYPE = OPT = 41
    out = _dqy_w16(out, _dqy_OPT_TYPE)
    // CLASS = UDP payload size = 4096
    out = _dqy_w16(out, _dqy_EDNS_UDP_SIZE)
    // TTL = extended RCODE + flags = 0
    out = _dqy_w32(out, 0)
    // RDLENGTH = 0 (no options)
    out = _dqy_w16(out, 0)
    out

// dns_parse_response: parse a raw DNS response message.
//
// Returns dict{"id", "rcode", "answers"}.
// "answers" is a list of RR dicts, one per answer section RR.
// Each RR dict: {"name","type","class","ttl","rdlength","rdata"}.
// On malformed input returns {"id":0,"rcode":0,"answers":[]}.
fn dns_parse_response(b: bytes) -> dict
    let empty_ans = []
    let fail = {"id": 0, "rcode": 0, "answers": empty_ans}
    let mlen = bytes_len(b)
    if mlen < 12
        return fail
    // Decode header
    let hres = _dqy_hdr_dec(b, 0)
    let hdr = hres[0]
    if "id" not in hdr
        return fail
    let msg_id    = hdr["id"]
    let msg_rcode = hdr["rcode"]
    let qdcount   = hdr["qdcount"]
    let ancount   = hdr["ancount"]
    // Skip all question records
    let cur = 12
    for qi in 0..qdcount
        let nxt = _dqy_skip_question(b, cur)
        if nxt < 0
            return fail
        cur = nxt
    // Decode answer RRs
    let answers = []
    let ai = 0
    while ai < ancount
        let rres = _dqy_rr_dec(b, cur)
        let rr = rres[0]
        let nxt = rres[1]
        if nxt == cur
            // decode failed — stop collecting rather than infinite-loop
            ai = ancount
        else
            push(answers, rr)
            cur = nxt
            ai += 1
    {"id": msg_id, "rcode": msg_rcode, "answers": answers}

// dns_answers: shorthand — parse response and return only the answers list.
fn dns_answers(b: bytes) -> list
    let result = dns_parse_response(b)
    result["answers"]
