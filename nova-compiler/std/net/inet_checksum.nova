// ============================================================================
// NOVA Standard Library — std/net/inet_checksum
// ============================================================================
// RFC 1071 ones-complement 16-bit internet checksum, operating on a plain
// `list` of byte values (0..255) rather than the opaque `bytes` type — for
// callers assembling/parsing packets as raw int lists (packet-crafting /
// scripting style). See also std/net/inetchecksum.nova for the `bytes`-typed
// equivalent used by the dict-based header codecs.
//
// PUBLIC API:
//   inet_cksum(data: list) -> int
//     Ones-complement sum of 16-bit big-endian words over data (list of ints
//     0..255). Returns a 16-bit value in [0, 0xFFFF].
//     Empty input -> 0xFFFF (ones-complement of a zero sum).
//     Odd-length input: last byte is the HIGH byte of a final word (low byte
//     implicitly 0x00), per RFC 1071 §4.1.
//
//   inet_cksum_verify(data: list) -> bool
//     True iff the ones-complement sum of all 16-bit words in data equals
//     0xFFFF — i.e. a checksum field already embedded in data is correct.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// Fold a 32-bit accumulator until no carry remains above bit 15, then return
// its ones-complement masked to 16 bits.
fn _icl_fold_complement(acc: int) -> int
    while (acc >> 16) != 0
        acc = (acc & 0xFFFF) + ((acc >> 16) & 0xFFFF)
    (~acc) & 0xFFFF

// Sum all 16-bit big-endian words in data (list of byte ints); no fold/complement.
fn _icl_raw_sum(data: list) -> int
    let acc = 0
    let i = 0
    let n = len(data)
    while i + 1 < n
        acc += (((data[i] & 0xFF) << 8) | (data[i + 1] & 0xFF))
        i += 2
    if i < n
        acc += ((data[i] & 0xFF) << 8)
    acc

// ── Public API ────────────────────────────────────────────────────────────────

// inet_cksum: list of byte ints -> 16-bit RFC 1071 checksum.
fn inet_cksum(data: list) -> int
    _icl_fold_complement(_icl_raw_sum(data))

// inet_cksum_verify: true iff the ones-complement sum of all 16-bit words
// (including an already-embedded checksum field) folds to 0xFFFF.
fn inet_cksum_verify(data: list) -> bool
    let acc = _icl_raw_sum(data)
    while (acc >> 16) != 0
        acc = (acc & 0xFFFF) + ((acc >> 16) & 0xFFFF)
    acc == 0xFFFF
