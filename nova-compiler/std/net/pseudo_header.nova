// ============================================================================
// NOVA Standard Library — std/net/pseudo_header
// ============================================================================
// TCP/UDP pseudo-header construction for RFC 793/768/8200 checksum
// calculation, operating on a plain `list` of byte values (0..255).
// The pseudo-header is prepended (conceptually) to the real TCP/UDP
// segment before running std/net/inet_checksum.inet_cksum over the whole
// thing — it is never transmitted itself.
//
// Compose with std/net/ipv4_header / std/net/ipv6_header (whose src_ip/
// dst_ip fields use the same representations expected here: u32 int for
// IPv4, list of 8 groups for IPv6) and std/net/inet_checksum.
//
// PUBLIC API:
//   pseudo_v4(src_ip: int, dst_ip: int, protocol: int, length: int) -> list
//     RFC 793 §3.1 / RFC 768 IPv4 pseudo-header (12 bytes, big-endian):
//       src_ip(4) | dst_ip(4) | zero(1) | protocol(1) | length(2)
//     src_ip/dst_ip are u32 IPv4 addresses. length is the TCP/UDP segment
//     length (header + data), NOT including this pseudo-header.
//
//   pseudo_v6(src_ip: list, dst_ip: list, next_header: int, length: int) -> list
//     RFC 8200 §8.1 IPv6 pseudo-header (40 bytes, big-endian):
//       src_ip(16) | dst_ip(16) | length(4, u32) | zero(3) | next_header(1)
//     src_ip/dst_ip are each a list of 8 ints (16-bit groups); a short or
//     absent list is treated as all-zero groups.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

fn _psh_w16(out: list, v: int) -> list
    push(out, (v >> 8) & 0xFF)
    push(out, v & 0xFF)
    out

fn _psh_w32(out: list, v: int) -> list
    push(out, (v >> 24) & 0xFF)
    push(out, (v >> 16) & 0xFF)
    push(out, (v >> 8) & 0xFF)
    push(out, v & 0xFF)
    out

// Append 8 groups (16 bytes) of an IPv6 address to out; missing groups (if
// addr has fewer than 8 elements) are treated as zero.
fn _psh_w_addr6(out: list, addr: list) -> list
    let n = len(addr)
    let g = 0
    while g < 8
        let v = 0
        if g < n
            v = addr[g]
        out = _psh_w16(out, v & 0xFFFF)
        g = g + 1
    out

// ── Public API ────────────────────────────────────────────────────────────────

fn pseudo_v4(src_ip: int, dst_ip: int, protocol: int, length: int) -> list
    let out = []
    out = _psh_w32(out, src_ip & 0xFFFFFFFF)
    out = _psh_w32(out, dst_ip & 0xFFFFFFFF)
    push(out, 0)
    push(out, protocol & 0xFF)
    out = _psh_w16(out, length & 0xFFFF)
    out

fn pseudo_v6(src_ip: list, dst_ip: list, next_header: int, length: int) -> list
    let out = []
    out = _psh_w_addr6(out, src_ip)
    out = _psh_w_addr6(out, dst_ip)
    out = _psh_w32(out, length & 0xFFFFFFFF)
    push(out, 0)
    push(out, 0)
    push(out, 0)
    push(out, next_header & 0xFF)
    out
