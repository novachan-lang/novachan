// ============================================================================
// NOVA Standard Library — std/net/imap_tag
// ============================================================================
// IMAP4rev1 client command tag generation (RFC 3501 §2.2).
//
// Every client command needs a unique tag so its eventual tagged completion
// response ("tag OK/NO/BAD ...") can be matched back to the request. This
// module generates sequential tags "A001", "A002", "A003", ... via an
// explicit, immutable state value (no hidden global counter) so callers can
// run multiple independent IMAP sessions concurrently without interference.
//
// PUBLIC API:
//   imap_tag_new() -> dict
//     A fresh tag-generator state: {"counter": 0}.
//
//   imap_tag_next(state: dict) -> list
//     Advance the state and produce the next tag. Returns a 2-element list
//     [tag: string, updated_state: dict]. Tags are "A" + the counter
//     zero-padded to at least 3 digits: "A001", "A002", ..., "A999",
//     "A1000", "A1001", ... (padding never truncates — it only ever adds
//     leading zeros up to 3 digits, so counters above 999 simply grow wider).
//
//   imap_tag_is_valid(s: string) -> int
//     1 if s is a non-empty string of only ASCII letters and digits
//     (matches every tag this module generates, and rejects the reserved
//     single-character markers "*" and "+" along with anything containing
//     whitespace or IMAP special characters). 0 otherwise.
//
// DESIGN NOTES:
//   * State is a plain value the caller threads through explicitly — this
//     matches NOVA's "no hidden mutable globals" idiom and makes tag
//     generation trivially safe to use from multiple independent sessions.
//   * Private helpers prefixed _imapt_.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _imapt_pad3: zero-pad a non-negative integer's decimal form to >= 3 digits.
fn _imapt_pad3(n: int) -> string
    let s = str(n)
    while len(s) < 3
        s = "0" + s
    s

// ── Public API ───────────────────────────────────────────────────────────────

// imap_tag_new: fresh tag-generator state.
fn imap_tag_new() -> dict
    let state = {}
    state["counter"] = 0
    state

// imap_tag_next: [next tag, updated state].
fn imap_tag_next(state: dict) -> list
    let counter = 0
    if contains(state, "counter")
        counter = state["counter"]
    counter = counter + 1

    let tag = "A" + _imapt_pad3(counter)

    let updated = {}
    updated["counter"] = counter

    let out = []
    push(out, tag)
    push(out, updated)
    out

// imap_tag_is_valid: 1 if s is a non-empty run of ASCII letters/digits.
fn imap_tag_is_valid(s: string) -> int
    let n = len(s)
    if n == 0
        return 0
    for i in 0..n
        let o = ord(slice(s, i, i + 1))
        let is_digit = o >= 48 and o <= 57
        let is_upper = o >= 65 and o <= 90
        let is_lower = o >= 97 and o <= 122
        if is_digit == 0 and is_upper == 0 and is_lower == 0
            return 0
    1
