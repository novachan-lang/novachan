// ============================================================================
// NOVA Standard Library — std/net/useragent
// ============================================================================
// Heuristic User-Agent string parsing via substring matching.
//
// PUBLIC API:
//   ua_browser(s: string) -> string
//     Returns the browser name: "Edge", "Chrome", "Firefox", "Safari", or
//     "unknown". Edge is checked before Chrome because Edge UA strings contain
//     both "Edg" and "Chrome".
//
//   ua_os(s: string) -> string
//     Returns the OS name: "Android", "iOS", "Windows", "macOS", "Linux", or
//     "unknown". Android is checked before Linux (Android UAs contain "Linux").
//
//   ua_is_mobile(s: string) -> bool
//     Returns true when the UA string contains "Mobile", "Android", or "iPhone".
//
// DESIGN NOTES:
//   * Uses contains() (native builtin) throughout — no regex dependency.
//   * Edge must precede Chrome: Edge UAs embed "Chrome" in the string.
//   * Android must precede Linux: Android UAs embed "Linux" in the string.
//
// LEAF — imports NOTHING.
// ============================================================================

// ua_browser: heuristic browser detection from a User-Agent string.
fn ua_browser(s: string) -> string
    if contains(s, "Edg")
        return "Edge"
    if contains(s, "Chrome")
        return "Chrome"
    if contains(s, "Firefox")
        return "Firefox"
    if contains(s, "Safari")
        return "Safari"
    "unknown"

// ua_os: heuristic OS detection from a User-Agent string.
fn ua_os(s: string) -> string
    if contains(s, "Android")
        return "Android"
    if contains(s, "iPhone")
        return "iOS"
    if contains(s, "iPad")
        return "iOS"
    if contains(s, "Windows")
        return "Windows"
    if contains(s, "Mac OS")
        return "macOS"
    if contains(s, "Macintosh")
        return "macOS"
    if contains(s, "Linux")
        return "Linux"
    "unknown"

// ua_is_mobile: returns true if the UA string indicates a mobile device.
fn ua_is_mobile(s: string) -> bool
    if contains(s, "Mobile")
        return true
    if contains(s, "Android")
        return true
    if contains(s, "iPhone")
        return true
    false
