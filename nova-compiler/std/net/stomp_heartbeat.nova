// ============================================================================
// NOVA Standard Library — std/net/stomp_heartbeat
// ============================================================================
// STOMP 1.2 heart-beat negotiation (STOMP spec §7).
//
// STOMP heart-beat header value format:
//   "cx,cy"  where cx and cy are non-negative integers.
//   cx = smallest number of milliseconds between heart-beats this sender CAN do.
//   cy = smallest number of milliseconds between heart-beats this sender WOULD LIKE to receive.
//   "0,0" means no heart-beat.
//
// KEEPALIVE / NEWLINE FRAME:
//   STOMP 1.2 §7: "Any heart-beat from a sender MUST be in the form of
//   a single newline (LF = 0x0A) transmitted outside of any frame."
//   This is the keepalive byte sent on idle connections.
//
// PUBLIC API:
//   stomp_heartbeat_parse(header_value: string) -> list
//     Parse "cx,cy" into a 2-element list [cx, cy].
//     Both values are non-negative integers.
//     Malformed input -> [0, 0].
//
//   stomp_heartbeat_format(cx: int, cy: int) -> string
//     Format cx and cy as "cx,cy".
//
//   stomp_newline_frame() -> list
//     Return the STOMP keepalive byte-list: a single LF byte [10].
//
// DESIGN NOTES:
//   * Private helpers prefixed _sth_.
//   * stomp_heartbeat_parse splits on comma, parses each part as a decimal int.
//   * Negative values in input are clamped to 0 (STOMP spec requires >= 0).
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _sth_is_digit: 1 if char c is ASCII '0'..'9', 0 otherwise.
fn _sth_is_digit(c: string) -> int
    let o = ord(c)
    if o >= 48 and o <= 57
        return 1
    0

// _sth_parse_int: parse a decimal integer string, returning 0 for empty/invalid.
// Stops at first non-digit character.
fn _sth_parse_int(s: string) -> int
    let n = len(s)
    if n == 0
        return 0
    let val = 0
    let i = 0
    let ok = 0
    while i < n
        let ch = slice(s, i, i + 1)
        if _sth_is_digit(ch) == 1
            val = val * 10 + (ord(ch) - 48)
            ok = 1
        i = i + 1
    if ok == 0
        return 0
    val

// _sth_find_comma: return index of first comma in s, or -1 if not found.
fn _sth_find_comma(s: string) -> int
    let n = len(s)
    for i in 0..n
        if slice(s, i, i + 1) == ","
            return i
    -1

// ── Public API ───────────────────────────────────────────────────────────────

fn stomp_heartbeat_parse(header_value: string) -> list
    let result = []
    let comma = _sth_find_comma(header_value)
    if comma == -1
        // malformed: no comma
        push(result, 0)
        push(result, 0)
        return result
    let sx = slice(header_value, 0, comma)
    let sy = slice(header_value, comma + 1, len(header_value))
    let cx = _sth_parse_int(sx)
    let cy = _sth_parse_int(sy)
    if cx < 0
        cx = 0
    if cy < 0
        cy = 0
    push(result, cx)
    push(result, cy)
    result

fn stomp_heartbeat_format(cx: int, cy: int) -> string
    str(cx) + "," + str(cy)

fn stomp_newline_frame() -> list
    let frame = []
    push(frame, 10)
    frame
