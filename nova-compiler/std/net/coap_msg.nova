// ============================================================================
// NOVA Standard Library — std/net/coap_msg
// ============================================================================
// RFC 7252 — CoAP 4-byte fixed header + variable-length token codec.
//
// CoAP wire format (fixed header):
//   Byte 0: Ver(2)|Type(2)|TKL(4)
//             Ver  = protocol version, always 1
//             Type = 0 CON, 1 NON, 2 ACK, 3 RST
//             TKL  = token length (0..8 bytes)
//   Byte 1: Code  — upper 3 bits = class, lower 5 bits = detail
//             e.g. 0x01=GET, 0x02=POST, 0x03=PUT, 0x04=DELETE
//                  0x44=2.04 Changed, 0x45=2.05 Content, etc.
//   Bytes 2-3: Message ID (big-endian u16)
//   Bytes 4..(4+TKL-1): Token bytes (0..8 bytes)
//
// Type constants (use as the 'type' argument):
//   CON=0  NON=1  ACK=2  RST=3
//
// PUBLIC API:
//   coap_msg(ver, type, code, msg_id, token_bytes) -> list of int (byte-list)
//     Encodes a CoAP message header with the given parameters.
//     token_bytes is a list of ints 0..255 (length = TKL, max 8).
//     Returns the 4-byte fixed header followed by the token bytes.
//
//   coap_msg_decode(bytes_list) -> dict
//     Decodes a CoAP header from a byte-list.
//     Returns dict with keys: "ver","type","code","msg_id","token"
//       "token" is a list of ints.
//     Returns {} on input shorter than 4 bytes.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── Private helpers ───────────────────────────────────────────────────────────

// Append all elements of src list to dst list; return dst (mutated via push).
fn _cm_append_list(dst, src)
    let i = 0
    let n = len(src)
    while i < n
        push(dst, src[i])
        i += 1
    dst

// ── Public API ────────────────────────────────────────────────────────────────

// coap_msg: encode a CoAP header (4 fixed bytes + token).
//
// Parameters:
//   ver         — protocol version (always 1 per RFC 7252)
//   msg_type    — message type: CON=0, NON=1, ACK=2, RST=3
//   code        — CoAP code byte (e.g. 1=GET, 2=POST, 0x45=2.05 Content)
//   msg_id      — 16-bit message identifier (big-endian in wire bytes 2-3)
//   token_bytes — list of ints 0..255, length 0..8 (the token)
//
// Returns: list of ints representing the wire-encoded CoAP header.
//
// Example:
//   coap_msg(1, 0, 1, 0x1234, [])
//   => [0x40, 0x01, 0x12, 0x34]
//   (ver=1, type=CON, tkl=0, code=GET, msg_id=0x1234)
//
//   coap_msg(1, 0, 1, 5, [0xAB])
//   => [0x41, 0x01, 0x00, 0x05, 0xAB]
//   (ver=1, type=CON, tkl=1, code=GET, msg_id=5, token=[0xAB])
fn coap_msg(ver, msg_type, code, msg_id, token_bytes)
    let tkl = len(token_bytes)
    let byte0 = ((ver & 0x3) << 6) | ((msg_type & 0x3) << 4) | (tkl & 0xF)
    let byte1 = code & 0xFF
    let byte2 = (msg_id >> 8) & 0xFF
    let byte3 = msg_id & 0xFF
    let out = []
    push(out, byte0)
    push(out, byte1)
    push(out, byte2)
    push(out, byte3)
    for i in 0..tkl
        push(out, token_bytes[i] & 0xFF)
    out

// coap_msg_decode: decode a CoAP header from a byte-list.
//
// Decodes the 4-byte fixed header plus token bytes.
// Returns dict: {"ver","type","code","msg_id","token"}
//   "token" is a list of ints (may be empty).
// Returns {} if input is shorter than 4 bytes.
//
// Example:
//   coap_msg_decode([0x40, 0x01, 0x12, 0x34])
//   => {"ver":1, "type":0, "code":1, "msg_id":0x1234, "token":[]}
fn coap_msg_decode(bl)
    if len(bl) < 4
        return {}
    let byte0 = bl[0]
    let byte1 = bl[1]
    let byte2 = bl[2]
    let byte3 = bl[3]
    let ver   = (byte0 >> 6) & 0x3
    let mtype = (byte0 >> 4) & 0x3
    let tkl   = byte0 & 0xF
    let code  = byte1 & 0xFF
    let mid   = ((byte2 << 8) | byte3) & 0xFFFF
    let token = []
    for i in 0..tkl
        let pos = 4 + i
        if pos < len(bl)
            push(token, bl[pos] & 0xFF)
    {"ver": ver, "type": mtype, "code": code, "msg_id": mid, "token": token}
