// std/control/pid.nova — PID (Proportional-Integral-Derivative) controller.
// LEAF — imports NOTHING.
//
// State dict keys: "kp","ki","kd","integral","prev_error","last_output"
//
// Public API (prefix pid_):
//   pid_new(kp,ki,kd)            -> any   create controller state
//   pid_step(state,error,dt)     -> float compute output, update state
//   pid_reset(state)             -> any   zero integral and prev_error
//   pid_set_gains(state,kp,ki,kd)-> any   update gain parameters
//   pid_p_term(state,error)      -> float proportional contribution
//   pid_i_term(state,error,dt)   -> float integral contribution (no state update)
//   pid_d_term(state,error,dt)   -> float derivative contribution (no state update)
//   pid_with_limits(state,error,dt,lo,hi) -> float clamped output
//   pid_anti_windup(state,error,dt,lo,hi) -> float clamp + stop integrating at sat
//   pid_feedforward(state,error,dt,ff)    -> float PID + feedforward term
//   pid_output(state)            -> float last computed output
//   pid_bumpless_set_gains(state,kp,ki,kd) -> any set gains without bump

// _pid_fabs — absolute value of a float.
fn _pid_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// _pid_clamp — clamp v to [lo, hi].
fn _pid_clamp(v: float, lo: float, hi: float) -> float
    if v < lo
        return lo
    if v > hi
        return hi
    v

// pid_new — create a new PID controller state dict with given gains.
fn pid_new(kp, ki, kd)
    let s = {}
    s["kp"] = kp * 1.0
    s["ki"] = ki * 1.0
    s["kd"] = kd * 1.0
    s["integral"] = 0.0
    s["prev_error"] = 0.0
    s["last_output"] = 0.0
    return s

// pid_step — compute PID output for current error and timestep, update state.
// output = kp*e + ki*integral + kd*derivative
fn pid_step(state, error, dt)
    let kp = state["kp"] * 1.0
    let ki = state["ki"] * 1.0
    let kd = state["kd"] * 1.0
    let prev = state["prev_error"] * 1.0
    let integ = state["integral"] * 1.0
    let ef = error * 1.0
    let dtf = dt * 1.0
    let new_integ = integ + ef * dtf
    let deriv = 0.0
    if dtf > 0.0
        deriv = (ef - prev) / dtf
    let p = kp * ef
    let i = ki * new_integ
    let d = kd * deriv
    let out = p + i + d
    state["integral"] = new_integ
    state["prev_error"] = ef
    state["last_output"] = out
    return out

// pid_reset — zero the integral accumulator and previous error.
fn pid_reset(state)
    state["integral"] = 0.0
    state["prev_error"] = 0.0
    state["last_output"] = 0.0
    return state

// pid_set_gains — update kp, ki, kd without resetting state.
fn pid_set_gains(state, kp, ki, kd)
    state["kp"] = kp * 1.0
    state["ki"] = ki * 1.0
    state["kd"] = kd * 1.0
    return state

// pid_p_term — proportional contribution: kp * error.
fn pid_p_term(state, error)
    let kp = state["kp"] * 1.0
    let ef = error * 1.0
    let p = kp * ef
    return p

// pid_i_term — integral contribution if the current error were added (no state update).
fn pid_i_term(state, error, dt)
    let ki = state["ki"] * 1.0
    let integ = state["integral"] * 1.0
    let ef = error * 1.0
    let dtf = dt * 1.0
    let new_integ = integ + ef * dtf
    let result = ki * new_integ
    return result

// pid_d_term — derivative contribution: kd * (error - prev_error) / dt.
fn pid_d_term(state, error, dt)
    let kd = state["kd"] * 1.0
    let prev = state["prev_error"] * 1.0
    let ef = error * 1.0
    let dtf = dt * 1.0
    let deriv = 0.0
    if dtf > 0.0
        deriv = (ef - prev) / dtf
    let result = kd * deriv
    return result

// pid_with_limits — compute PID output then clamp to [lo, hi].
fn pid_with_limits(state, error, dt, lo, hi)
    let raw = pid_step(state, error, dt)
    let lof = lo * 1.0
    let hif = hi * 1.0
    let out = _pid_clamp(raw, lof, hif)
    state["last_output"] = out
    return out

// pid_anti_windup — clamp output and stop integrating when saturated.
// When the raw output exceeds limits, the integral is NOT updated.
fn pid_anti_windup(state, error, dt, lo, hi)
    let kp = state["kp"] * 1.0
    let ki = state["ki"] * 1.0
    let kd = state["kd"] * 1.0
    let prev = state["prev_error"] * 1.0
    let integ = state["integral"] * 1.0
    let ef = error * 1.0
    let dtf = dt * 1.0
    let lof = lo * 1.0
    let hif = hi * 1.0
    let new_integ = integ + ef * dtf
    let deriv = (ef - prev) / dtf
    let p = kp * ef
    let i_candidate = ki * new_integ
    let d = kd * deriv
    let raw = p + i_candidate + d
    let out = _pid_clamp(raw, lof, hif)
    // Only commit the new integral if output is NOT saturated
    let saturated = 0
    if raw > hif
        saturated = 1
    if raw < lof
        saturated = 1
    if saturated == 0
        state["integral"] = new_integ
    state["prev_error"] = ef
    state["last_output"] = out
    return out

// pid_feedforward — PID output plus a feedforward term.
fn pid_feedforward(state, error, dt, ff)
    let base = pid_step(state, error, dt)
    let fff = ff * 1.0
    let out = base + fff
    state["last_output"] = out
    return out

// pid_output — return the last computed output without recomputing.
fn pid_output(state)
    let v = state["last_output"] * 1.0
    return v

// pid_bumpless_set_gains — change gains without a control bump.
// Adjusts integral to compensate so the output remains continuous:
//   new_integral = old_output / new_ki  (if new_ki != 0, else keep old integral)
fn pid_bumpless_set_gains(state, kp, ki, kd)
    let old_out = state["last_output"] * 1.0
    let new_ki = ki * 1.0
    state["kp"] = kp * 1.0
    state["ki"] = new_ki
    state["kd"] = kd * 1.0
    if new_ki > 0.0000001 or new_ki < 0.0 - 0.0000001
        let adj_integ = old_out / new_ki
        state["integral"] = adj_integ
    return state
