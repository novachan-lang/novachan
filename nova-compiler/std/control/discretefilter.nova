// std/control/discretefilter.nova -- Discrete-time filters and compensators for control systems.
// LEAF -- imports NOTHING.
//
// All filters maintain state in a dict that is mutated each step. Pass the SAME
// dict to each *_step call to update running state. Use df_reset() to clear state.
//
// State dict keys (set by each *_new function):
//   lowpass/highpass: "alpha","y","kind"
//   integrator:       "dt","sum","kind"
//   differentiator:   "dt","prev","kind"
//   moving average:   "window","buf","head","count","kind"
//   lead-lag:         "alpha","beta","x_prev","y_prev","kind"
//
// Public API:
//   df_lowpass_new(alpha)           -> any    first-order IIR low-pass
//   df_lowpass_step(f,x)            -> float  y = alpha*x + (1-alpha)*y_prev
//   df_alpha_from_cutoff(fc,fs)     -> float  alpha = dt/(RC+dt)
//   df_highpass_new(alpha)          -> any    first-order IIR high-pass
//   df_highpass_step(f,x)           -> float  high-pass output
//   df_integrator_new(dt)           -> any    discrete integrator
//   df_integrator_step(f,x)         -> float  sum += x*dt
//   df_differentiator_new(dt)       -> any    first-difference differentiator
//   df_differentiator_step(f,x)     -> float  (x - x_prev) / dt
//   df_ma_new(window)               -> any    moving average over last N samples
//   df_ma_step(f,x)                 -> float  running mean
//   df_reset(f)                     -> any    clear all running state
//   df_leadlag_step(f,x)            -> float  lead-lag compensator step

// _pi_2 -- 2*pi constant.
fn _pi_2() -> float
    6.283185307179586

// df_lowpass_new -- Create a first-order IIR low-pass filter with smoothing factor alpha.
// alpha=1 passes input unchanged; alpha=0 freezes output at 0.
fn df_lowpass_new(alpha: float) -> any
    let f = {}
    f["alpha"] = alpha
    f["y"] = 0.0
    f["kind"] = 1
    f

// df_lowpass_step -- Advance one step: y = alpha*x + (1-alpha)*y_prev.
fn df_lowpass_step(f: any, x: float) -> float
    let alpha = f["alpha"] * 1.0
    let y_prev = f["y"] * 1.0
    let one_minus = 1.0 - alpha
    let y = alpha * x + one_minus * y_prev
    f["y"] = y
    y

// df_alpha_from_cutoff -- Compute alpha from cutoff frequency fc (Hz) and sample rate fs (Hz).
// RC = 1 / (2*pi*fc);  dt = 1/fs;  alpha = dt / (RC + dt).
fn df_alpha_from_cutoff(fc: float, fs: float) -> float
    let two_pi = _pi_2()
    let rc = 1.0 / (two_pi * fc)
    let dt = 1.0 / fs
    let alpha = dt / (rc + dt)
    alpha

// df_highpass_new -- Create a first-order IIR high-pass filter.
// Stored state: x_prev and y_prev for the difference equation.
fn df_highpass_new(alpha: float) -> any
    let f = {}
    f["alpha"] = alpha
    f["x_prev"] = 0.0
    f["y_prev"] = 0.0
    f["kind"] = 2
    f

// df_highpass_step -- High-pass step: y = alpha * (y_prev + x - x_prev).
fn df_highpass_step(f: any, x: float) -> float
    let alpha = f["alpha"] * 1.0
    let x_prev = f["x_prev"] * 1.0
    let y_prev = f["y_prev"] * 1.0
    let y = alpha * (y_prev + x - x_prev)
    f["x_prev"] = x
    f["y_prev"] = y
    y

// df_integrator_new -- Create a discrete integrator with timestep dt.
fn df_integrator_new(dt: float) -> any
    let f = {}
    f["dt"] = dt
    f["sum"] = 0.0
    f["kind"] = 3
    f

// df_integrator_step -- Accumulate: sum += x * dt; returns running sum.
fn df_integrator_step(f: any, x: float) -> float
    let dt = f["dt"] * 1.0
    let prev_sum = f["sum"] * 1.0
    let new_sum = prev_sum + x * dt
    f["sum"] = new_sum
    new_sum

// df_differentiator_new -- Create a first-difference differentiator with timestep dt.
fn df_differentiator_new(dt: float) -> any
    let f = {}
    f["dt"] = dt
    f["prev"] = 0.0
    f["kind"] = 4
    f

// df_differentiator_step -- Differentiate: (x - x_prev) / dt.
fn df_differentiator_step(f: any, x: float) -> float
    let dt = f["dt"] * 1.0
    let prev = f["prev"] * 1.0
    let deriv = (x - prev) / dt
    f["prev"] = x
    deriv

// df_ma_new -- Create a moving-average filter over a sliding window of N samples.
fn df_ma_new(window: int) -> any
    let f = {}
    f["window"] = window
    let buf = [0.0 for i in 0..window]
    f["buf"] = buf
    f["head"] = 0
    f["count"] = 0
    f["sum"] = 0.0
    f["kind"] = 5
    f

// df_ma_step -- Sliding window mean: replace oldest sample, return new mean.
fn df_ma_step(f: any, x: float) -> float
    let window = f["window"]
    let buf = f["buf"]
    let head = f["head"]
    let count = f["count"]
    let running_sum = f["sum"] * 1.0
    // subtract old sample at current head position
    let old_val = buf[head] * 1.0
    running_sum = running_sum - old_val
    // insert new sample
    running_sum = running_sum + x
    buf[head] = x
    let new_head = head + 1
    if new_head >= window
        new_head = 0
    f["head"] = new_head
    let new_count = count + 1
    if new_count > window
        new_count = window
    f["count"] = new_count
    f["sum"] = running_sum
    let wf = new_count * 1.0
    let mean = running_sum / wf
    mean

// df_reset -- Reset all running state (integral, filter state) to zero, keep parameters.
fn df_reset(f: any) -> any
    let kind = f["kind"]
    if kind == 1
        f["y"] = 0.0
    if kind == 2
        f["x_prev"] = 0.0
        f["y_prev"] = 0.0
    if kind == 3
        f["sum"] = 0.0
    if kind == 4
        f["prev"] = 0.0
    if kind == 5
        f["head"] = 0
        f["count"] = 0
        f["sum"] = 0.0
        let buf = f["buf"]
        let window = f["window"]
        for i in 0..window
            buf[i] = 0.0
    if kind == 6
        f["x_prev"] = 0.0
        f["y_prev"] = 0.0
    f

// df_leadlag_new_internal -- Create a lead-lag compensator (internal helper for df_reset).
// alpha = lead zero freq / lead pole freq; beta = lag zero freq / lag pole freq.
fn df_leadlag_new(alpha: float, beta: float) -> any
    let f = {}
    f["alpha"] = alpha
    f["beta"] = beta
    f["x_prev"] = 0.0
    f["y_prev"] = 0.0
    f["kind"] = 6
    f

// df_leadlag_step -- Lead-lag step: y = alpha*x - (alpha-1)*y_prev + beta*(x-x_prev).
// Implements a simplified bilinear lead-lag compensator.
fn df_leadlag_step(f: any, x: float) -> float
    let alpha = f["alpha"] * 1.0
    let beta = f["beta"] * 1.0
    let x_prev = f["x_prev"] * 1.0
    let y_prev = f["y_prev"] * 1.0
    let alpha_minus_1 = alpha - 1.0
    let y = alpha * x - alpha_minus_1 * y_prev + beta * (x - x_prev)
    f["x_prev"] = x
    f["y_prev"] = y
    y
