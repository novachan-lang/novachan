// std/control/statespace.nova — Discrete linear state-space model.
// LEAF — imports NOTHING.
//
// State-space form (discrete): x[k+1] = A*x[k] + B*u[k],  y[k] = C*x[k]
//   A: n x n (state transition), B: n x m (input), C: p x n (output)
//   All matrices stored as flat row-major lists.
//
// Public API:
//   ss_new(A,B,C,n,m,p)         -> any   create model dict
//   ss_step(model,x,u)          -> any   next state list (A*x + B*u)
//   ss_output(model,x)          -> any   output list (C*x)
//   ss_simulate(model,x0,inputs,steps) -> any  list of output lists
//   ss_is_stable(model)         -> bool  all |A[i,i]| < 1 (diagonal check)
//   ss_equilibrium(model,u)     -> any   approx equilibrium via iteration
//   ss_dim_n(model)             -> int   state dimension n
//   mat_vec(M,v,rows,cols)      -> any   flat matrix times vector
//   vec_add(a,b)                -> any   element-wise list addition
//   ss_zero_state(n)            -> any   zero vector of length n
//   ss_response_step(model,steps) -> any step response outputs (u=1 every step)
//   ss_reachable_rank_hint(model) -> int heuristic reachability rank

// _ss_fabs — float absolute value.
fn _ss_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// mat_vec — multiply flat row-major matrix M (rows x cols) by vector v (cols),
// returning a result vector of length rows.
fn mat_vec(M, v, rows, cols)
    let result = []
    for r in 0..rows
        let acc = 0.0
        let c = 0
        while c < cols
            let mval = M[r * cols + c] * 1.0
            let vval = v[c] * 1.0
            acc += mval * vval
            c += 1
        push(result, acc)
    return result

// vec_add — element-wise addition of two equal-length lists.
fn vec_add(a, b)
    let result = []
    let n = len(a)
    for i in 0..n
        let va = a[i] * 1.0
        let vb = b[i] * 1.0
        push(result, va + vb)
    return result

// ss_zero_state — create a zero vector of length n.
fn ss_zero_state(n)
    let v = [0.0 for i in 0..n]
    return v

// ss_new — create a state-space model dict.
// A is n*n, B is n*m, C is p*n (all flat, row-major).
fn ss_new(A, B, C, n, m, p)
    let d = {}
    d["A"] = A
    d["B"] = B
    d["C"] = C
    d["n"] = n
    d["m"] = m
    d["p"] = p
    return d

// ss_dim_n — return the state dimension n.
fn ss_dim_n(model)
    return model["n"]

// ss_step — compute x_next = A*x + B*u given state x (n-list) and input u (m-list).
fn ss_step(model, x, u)
    let A = model["A"]
    let B = model["B"]
    let n = model["n"]
    let m = model["m"]
    let Ax = mat_vec(A, x, n, n)
    let Bu = mat_vec(B, u, n, m)
    let x_next = vec_add(Ax, Bu)
    return x_next

// ss_output — compute y = C*x given state x (n-list).
fn ss_output(model, x)
    let C = model["C"]
    let p = model["p"]
    let n = model["n"]
    let y = mat_vec(C, x, p, n)
    return y

// ss_simulate — simulate for 'steps' steps from initial state x0.
// inputs is a list of u-vectors (one per step); if inputs is shorter, last u is reused.
// Returns a list of output vectors (one per step, length = steps).
fn ss_simulate(model, x0, inputs, steps)
    let outputs = []
    let x = x0
    let num_inputs = len(inputs)
    let i = 0
    while i < steps
        let ui = num_inputs - 1
        if i < num_inputs
            ui = i
        let u = inputs[ui]
        let y = ss_output(model, x)
        push(outputs, y)
        x = ss_step(model, x, u)
        i += 1
    return outputs

// ss_is_stable — checks stability via diagonal dominance heuristic.
// Returns true if all |A[i,i]| < 1.0 (sufficient for stable diagonal/triangular A).
// NOTE: this is NOT a general stability test; off-diagonal coupling is ignored.
// For a full test, compute all eigenvalues (outside scope of this module).
fn ss_is_stable(model)
    let A = model["A"]
    let n = model["n"]
    for i in 0..n
        let val = A[i * n + i] * 1.0
        let absval = _ss_fabs(val)
        if absval >= 1.0
            return false
    return true

// ss_equilibrium — approximate equilibrium state for constant input u.
// Iterates x[k+1] = A*x[k] + B*u until convergence (max 500 steps).
// Returns the final state (converges only if the system is stable).
fn ss_equilibrium(model, u)
    let x = ss_zero_state(model["n"])
    let n = model["n"]
    for iter in 0..500
        let x_next = ss_step(model, x, u)
        // check convergence: max |x_next - x| < 1e-8
        let converged = 1
        let k = 0
        while k < n
            let diff = x_next[k] * 1.0 - x[k] * 1.0
            if diff < 0.0
                diff = 0.0 - diff
            if diff > 0.00000001
                converged = 0
            k += 1
        x = x_next
        if converged == 1
            return x
    return x

// ss_response_step — compute step response for 'steps' steps from zero initial state.
// Input u = vector of ones (scalar systems use [1.0]).
fn ss_response_step(model, steps)
    let m = model["m"]
    let u = [1.0 for j in 0..m]
    let inputs = []
    let k = 0
    while k < steps
        push(inputs, u)
        k += 1
    let x0 = ss_zero_state(model["n"])
    return ss_simulate(model, x0, inputs, steps)

// ss_reachable_rank_hint — heuristic reachability rank via B and A*B norms.
// Returns an estimate of rank of [B AB A^2B ...]; max = n.
// Algorithm: count columns of [B, A*B, ..., A^(n-1)*B] whose norm > threshold.
fn ss_reachable_rank_hint(model)
    let A = model["A"]
    let B = model["B"]
    let n = model["n"]
    let m = model["m"]
    // collect n columns (one from each A^k * B, k=0..n-1, first column of B only)
    let rank = 0
    // extract first column of B
    let col = [B[r * m] * 1.0 for r in 0..n]
    for k in 0..n
        // compute norm of col
        let norm = 0.0
        let i = 0
        while i < n
            let vi = col[i] * 1.0
            norm += vi * vi
            i += 1
        if norm > 0.000001
            rank += 1
        // col = A * col
        col = mat_vec(A, col, n, n)
    return rank
