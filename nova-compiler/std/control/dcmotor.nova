// std/control/dcmotor.nova — DC motor model and first-order dynamic system.
// LEAF — imports NOTHING.
//
// Provides two models:
//   1. First-order system: Y(s) = K / (tau*s + 1), step response K*(1-exp(-t/tau))
//   2. DC motor (electromechanical): kt, ke, R, J, b
//      electrical: i = (V - ke*omega) / R
//      mechanical: J * d(omega)/dt = kt*i - b*omega
//
// Public API:
//   fo_new(gain, tau)            -> any   create first-order system dict
//   fo_step_response(sys, t)     -> float step response at time t
//   fo_time_constant(sys)        -> float return tau
//   fo_settling_time(sys)        -> float ~4*tau (2% criterion)
//   fo_rise_time(sys)            -> float ~2.2*tau (10%-90%)
//   fo_dc_gain(sys)              -> float return gain K
//   fo_response_at_tau(sys)      -> float value at t=tau (~0.6321*K)
//   dcmotor_new(kt,ke,R,J,b)     -> any   create motor dict
//   dcmotor_ss_step(motor,omega,voltage,dt) -> float next omega (Euler integration)
//   dcmotor_steady_speed(motor,voltage)     -> float steady-state omega
//   dcmotor_stall_torque(motor,voltage)     -> float stall torque (omega=0)
//   dcmotor_time_constant(motor)            -> float electrical time constant J*R/(kt*ke+b*R)

// _dc_fabs — float absolute value.
fn _dc_fabs(x: float) -> float
    if x < 0.0
        return 0.0 - x
    x

// fo_new — create a first-order system: Y/U = K / (tau*s + 1).
fn fo_new(gain, tau)
    let d = {}
    d["gain"] = gain * 1.0
    d["tau"] = tau * 1.0
    return d

// fo_step_response — unit step response at time t: y(t) = K*(1 - exp(-t/tau)).
// Returns 0 for t <= 0. For tau=0 returns K (instantaneous).
fn fo_step_response(sys, t)
    let K = sys["gain"] * 1.0
    let tau = sys["tau"] * 1.0
    let tf = t * 1.0
    if tf <= 0.0
        return 0.0
    if _dc_fabs(tau) < 0.000000001
        return K
    let neg_t_over_tau = 0.0 - tf / tau
    let e = exp(neg_t_over_tau)
    let out = K * (1.0 - e)
    return out

// fo_time_constant — return the time constant tau.
fn fo_time_constant(sys)
    let v = sys["tau"] * 1.0
    return v

// fo_settling_time — time to reach within 2% of final value: ~4 * tau.
fn fo_settling_time(sys)
    let tau = sys["tau"] * 1.0
    let s = 4.0 * tau
    return s

// fo_rise_time — time to go from 10% to 90% of final value: ~2.2 * tau.
fn fo_rise_time(sys)
    let tau = sys["tau"] * 1.0
    let r = 2.197 * tau
    return r

// fo_dc_gain — return the steady-state gain K.
fn fo_dc_gain(sys)
    let v = sys["gain"] * 1.0
    return v

// fo_response_at_tau — step response evaluated at t = tau = K*(1 - 1/e) ~ 0.6321*K.
fn fo_response_at_tau(sys)
    let K = sys["gain"] * 1.0
    let tau = sys["tau"] * 1.0
    let e = exp(0.0 - 1.0)
    let out = K * (1.0 - e)
    return out

// dcmotor_new — create a DC motor parameter dict.
//   kt: torque constant (N*m/A)
//   ke: back-EMF constant (V*s/rad)
//   R:  armature resistance (ohm)
//   J:  rotor inertia (kg*m^2)
//   b:  viscous friction coefficient (N*m*s/rad)
fn dcmotor_new(kt, ke, R, J, b)
    let d = {}
    d["kt"] = kt * 1.0
    d["ke"] = ke * 1.0
    d["R"] = R * 1.0
    d["J"] = J * 1.0
    d["b"] = b * 1.0
    return d

// dcmotor_ss_step — one Euler integration step.
// d(omega)/dt = (kt*(V - ke*omega)/R - b*omega) / J
// Returns omega + dt * d(omega)/dt.
fn dcmotor_ss_step(motor, omega, voltage, dt)
    let kt = motor["kt"] * 1.0
    let ke = motor["ke"] * 1.0
    let R = motor["R"] * 1.0
    let J = motor["J"] * 1.0
    let b = motor["b"] * 1.0
    let omf = omega * 1.0
    let Vf = voltage * 1.0
    let dtf = dt * 1.0
    let back_emf = ke * omf
    let current = (Vf - back_emf) / R
    let torque = kt * current
    let damping = b * omf
    let alpha = (torque - damping) / J
    let omega_next = omf + dtf * alpha
    return omega_next

// dcmotor_steady_speed — steady-state angular velocity for a given voltage.
// At steady state: d(omega)/dt = 0 => kt*(V - ke*omega)/R = b*omega
// => omega = kt*V / (kt*ke + b*R)
fn dcmotor_steady_speed(motor, voltage)
    let kt = motor["kt"] * 1.0
    let ke = motor["ke"] * 1.0
    let R = motor["R"] * 1.0
    let b = motor["b"] * 1.0
    let Vf = voltage * 1.0
    let denom = kt * ke + b * R
    if _dc_fabs(denom) < 0.000000001
        return 0.0
    let omega_ss = kt * Vf / denom
    return omega_ss

// dcmotor_stall_torque — torque produced when omega = 0 (stall condition).
// T_stall = kt * V / R
fn dcmotor_stall_torque(motor, voltage)
    let kt = motor["kt"] * 1.0
    let R = motor["R"] * 1.0
    let Vf = voltage * 1.0
    let t = kt * Vf / R
    return t

// dcmotor_time_constant — effective mechanical time constant.
// tau = J * R / (kt*ke + b*R)
fn dcmotor_time_constant(motor)
    let kt = motor["kt"] * 1.0
    let ke = motor["ke"] * 1.0
    let R = motor["R"] * 1.0
    let J = motor["J"] * 1.0
    let b = motor["b"] * 1.0
    let denom = kt * ke + b * R
    if _dc_fabs(denom) < 0.000000001
        return 0.0
    let tau = J * R / denom
    return tau
