// ============================================================================
// NOVA Standard Library — std/text/ansi
// ============================================================================
// ANSI SGR (Select Graphic Rendition) terminal styling utilities.
//
// Escape sequences follow the form: ESC [ <code> m  (CSI SGR)
// where ESC is chr(27), '[' is chr(91), and 'm' terminates the sequence.
//
// Public API:
//   ansi_color(s, code) -> str   wrap s in ESC[<code>m ... ESC[0m
//   ansi_red(s)         -> str   SGR 31 — foreground red
//   ansi_green(s)       -> str   SGR 32 — foreground green
//   ansi_yellow(s)      -> str   SGR 33 — foreground yellow
//   ansi_blue(s)        -> str   SGR 34 — foreground blue
//   ansi_bold(s)        -> str   SGR 1  — bold / bright
//   ansi_underline(s)   -> str   SGR 4  — underline
//   ansi_strip(s)       -> str   remove all CSI SGR sequences (ESC [ ... m)
//
// Design notes:
//   ESC is chr(27), which avoids any string-literal interpolation issues.
//   The reset sequence ESC[0m uses code 0 and is the standard SGR reset.
//   ansi_strip is a linear scan: O(n) in the length of the string. It handles
//   nested/stacked sequences (e.g. ansi_green(ansi_bold("z"))) correctly because
//   each ESC-[-...-m group is stripped independently.
// ============================================================================

// Internal: build the ESC+[ prefix string once per call.
fn _esc_open() -> str
    chr(27) + "["

// Internal: the reset suffix ESC[0m applied after every styled span.
fn _esc_reset() -> str
    chr(27) + "[0m"

// ── core constructor ──────────────────────────────────────────────────────────

// Wrap s in the SGR sequence for the given numeric code, followed by a reset.
// Returns: ESC [ <code> m <s> ESC [ 0 m
fn ansi_color(s, code) -> str
    _esc_open() + str(code) + "m" + s + _esc_reset()

// ── named wrappers ────────────────────────────────────────────────────────────

fn ansi_red(s) -> str
    ansi_color(s, 31)

fn ansi_green(s) -> str
    ansi_color(s, 32)

fn ansi_yellow(s) -> str
    ansi_color(s, 33)

fn ansi_blue(s) -> str
    ansi_color(s, 34)

fn ansi_bold(s) -> str
    ansi_color(s, 1)

fn ansi_underline(s) -> str
    ansi_color(s, 4)

// ── strip ─────────────────────────────────────────────────────────────────────

// Remove all CSI SGR sequences of the form ESC [ <params> m from s.
// Any byte that is not part of such a sequence is copied verbatim to the output.
// Algorithm:
//   Walk byte by byte. When byte i == ESC (27) AND byte i+1 == '[' (91):
//     enter skip mode: advance i by 2, then skip bytes until we see 'm' (109),
//     consuming it as well. All other bytes are appended to the result.
// This handles adjacent and nested sequences, any param length, and the case
// where a truncated (malformed) escape at end-of-string does not overflow.
fn ansi_strip(s) -> str
    let out_parts = []
    let i = 0
    let n = len(s)
    while i < n
        let b = ord(s[i])
        if b == 27 and i + 1 < n and ord(s[i + 1]) == 91
            // found ESC '[': skip the introducer (2 bytes) and everything up
            // through the terminating 'm'. If 'm' never appears (truncated
            // sequence) we consume to end-of-string without output.
            i = i + 2
            let done = 0
            while i < n and done == 0
                if ord(s[i]) == 109
                    // 109 == ord('m'): consume the terminator, exit skip loop
                    done = 1
                i = i + 1
        else
            push(out_parts, chr(b))
            i = i + 1
    let out = join(out_parts, "")
    out
