// ============================================================================
// NOVA Standard Library — std/text/stopwords
// ============================================================================
// Multi-language stopword sets + filtering.
//
// Public API:
//   sw_english()         -> any: ~100 common English stopwords
//   sw_spanish()         -> any: ~30 Spanish stopwords
//   sw_french()          -> any: ~30 French stopwords
//   sw_german()          -> any: ~30 German stopwords
//   sw_set(lang)         -> any: list for lang code 'en','es','fr','de'
//   sw_is_stop(word,lang) -> bool: case-insensitive membership test
//   sw_filter(tokens,lang) -> any: remove stopwords from token list
//   sw_filter_text(text,lang) -> string: tokenize, filter, rejoin with spaces
//   sw_count_stop(tokens,lang) -> int: count of stopwords in list
//   sw_count_content(tokens,lang) -> int: count of non-stopwords
//   sw_ratio(tokens,lang) -> float: stopword fraction (0.0..1.0)
//   sw_content_words(tokens,lang) -> any: only non-stopword tokens
//   sw_add(list,word) -> any: new list with word appended
//   sw_supported()    -> any: list of supported lang codes
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _sw_lower: lowercase a single ASCII character code
fn _sw_lower_char(o) -> int
    if o >= 65 and o <= 90
        return o + 32
    o

// _sw_lower: lowercase an ASCII string
fn _sw_lower(s) -> string
    let n = len(s)
    let out = ""
    for i in 0..n
        let o = ord(slice(s, i, i + 1))
        let lo = _sw_lower_char(o)
        out += chr(lo)
    out

// _sw_is_alpha: true if char code is ASCII letter
fn _sw_is_alpha(o) -> bool
    if o >= 65 and o <= 90
        return true
    if o >= 97 and o <= 122
        return true
    false

// _sw_tokenize: split text into lowercased alpha tokens
fn _sw_tokenize(text) -> any
    let result = []
    let n = len(text)
    let i = 0
    let start = 0
    let in_word = false
    while i < n
        let o = ord(slice(text, i, i + 1))
        if _sw_is_alpha(o)
            if not in_word
                start = i
                in_word = true
        else
            if in_word
                push(result, _sw_lower(slice(text, start, i)))
                in_word = false
        i += 1
    if in_word
        push(result, _sw_lower(slice(text, start, n)))
    result

// _sw_make_set: build a dict from a list for O(1) lookup
fn _sw_make_set(words) -> any
    let d = {}
    for i in 0..len(words)
        d[words[i]] = 1
    d

// ── stopword lists ───────────────────────────────────────────────────────────

