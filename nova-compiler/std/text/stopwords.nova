// ── public API ───────────────────────────────────────────────────────────────

// sw_set: return the stopword list for a lang code ('en','es','fr','de').
// Returns an empty list for unknown lang codes.
fn sw_set(lang) -> any
    if lang == "en"
        return sw_english()
    if lang == "es"
        return sw_spanish()
    if lang == "fr"
        return sw_french()
    if lang == "de"
        return sw_german()
    []

// sw_is_stop: case-insensitive stopword test for the given language.
fn sw_is_stop(word, lang) -> bool
    let lw = _sw_lower(word)
    let words = sw_set(lang)
    let d = _sw_make_set(words)
    if lw in d
        return true
    false

// sw_filter: remove stopwords (case-insensitive) from a token list.
fn sw_filter(tokens, lang) -> any
    let words = sw_set(lang)
    let d = _sw_make_set(words)
    let result = []
    for i in 0..len(tokens)
        let lw = _sw_lower(tokens[i])
        if lw not in d
            push(result, tokens[i])
    result

// sw_filter_text: tokenize text, filter stopwords, rejoin with spaces.
fn sw_filter_text(text, lang) -> string
    let tokens = _sw_tokenize(text)
    let filtered = sw_filter(tokens, lang)
    let out_parts = []
    for i in 0..len(filtered)
        if i > 0
            push(out_parts, " ")
        push(out_parts, filtered[i])
    let out = join(out_parts, "")
    out

// sw_count_stop: count how many tokens are stopwords.
fn sw_count_stop(tokens, lang) -> int
    let words = sw_set(lang)
    let d = _sw_make_set(words)
    let cnt = 0
    for i in 0..len(tokens)
        let lw = _sw_lower(tokens[i])
        if lw in d
            cnt += 1
    cnt

// sw_count_content: count how many tokens are NOT stopwords.
fn sw_count_content(tokens, lang) -> int
    len(tokens) - sw_count_stop(tokens, lang)

// sw_ratio: fraction of tokens that are stopwords. Returns 0.0 for empty list.
fn sw_ratio(tokens, lang) -> float
    let n = len(tokens)
    if n == 0
        return 0.0
    let cnt = sw_count_stop(tokens, lang)
    let result = (cnt * 1.0) / (n * 1.0)
    result

// sw_content_words: return only non-stopword tokens (case-insensitive filter).
fn sw_content_words(tokens, lang) -> any
    sw_filter(tokens, lang)

// sw_add: return a new list with word appended (for custom sets).
fn sw_add(list, word) -> any
    let result = []
    for i in 0..len(list)
        push(result, list[i])
    push(result, word)
    result

// sw_supported: return list of supported lang codes.
fn sw_supported() -> any
    let result = []
    push(result, "en")
    push(result, "es")
    push(result, "fr")
    push(result, "de")
    result

fn main()
    print("std/text/stopwords loaded")
