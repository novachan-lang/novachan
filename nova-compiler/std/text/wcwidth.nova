// wcwidth.nova — Terminal display width for codepoints and strings.
//
// ww_char_width(cp) -> int
//   Returns the terminal column width of a single Unicode codepoint:
//     -1  control characters (cp < 32 or cp == 127)
//      0  combining marks / zero-width (U+0300..U+036F, U+200B)
//      2  wide CJK and Hangul ranges
//      1  everything else (normal ASCII/Latin/etc.)
//
// ww_string_width(s) -> int
//   Sums ww_char_width over the decoded Unicode codepoints of s (UTF-8 aware,
//   via code_points()). A multi-byte UTF-8 character is one codepoint, not
//   one width unit per byte -- walking bytes directly over-counts every
//   non-ASCII character (e.g. a 3-byte CJK char would report width 3 instead
//   of the correct 2).

fn ww_char_width(cp)
    if cp < 32
        return -1
    if cp == 127
        return -1
    if cp >= 0x0300 and cp <= 0x036F
        return 0
    if cp == 0x200B
        return 0
    if cp >= 0x1100 and cp <= 0x115F
        return 2
    if cp >= 0x2E80 and cp <= 0x303E
        return 2
    if cp >= 0x3041 and cp <= 0x33FF
        return 2
    if cp >= 0x3400 and cp <= 0x4DBF
        return 2
    if cp >= 0x4E00 and cp <= 0x9FFF
        return 2
    if cp >= 0xAC00 and cp <= 0xD7A3
        return 2
    if cp >= 0xF900 and cp <= 0xFAFF
        return 2
    if cp >= 0xFF00 and cp <= 0xFF60
        return 2
    if cp >= 0xFFE0 and cp <= 0xFFE6
        return 2
    1

fn ww_string_width(s)
    let total = 0
    for cp in code_points(s)
        let w = ww_char_width(cp)
        if w > 0
            total += w
    total
