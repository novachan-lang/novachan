// std/text/porter -- Porter Stemmer (1980 classic algorithm).
//
// Reference: M.F. Porter, "An algorithm for suffix stripping",
//   Program, 14(3): 130-137, 1980.
//
// Public API:
//   pt_stem(word: string) -> string
//     Returns the stem of a lowercase word via the 5-step Porter algorithm.
//     Input must already be lowercase.  Returns the input unchanged if len < 3.
//
//   pt_stem_all(words: list) -> list
//     Applies pt_stem to every element of a list and returns the result list.
//
// Internal helpers (prefix _pt_):
//   _pt_is_vowel(w, i)          -- character at position i is a vowel
//   _pt_m(w)                    -- measure: number of VC sequences in w
//   _pt_contains_vowel(w)       -- *v* condition: stem contains a vowel
//   _pt_ends_double_c(w)        -- *d condition: ends with double consonant
//   _pt_ends_cvc(w)             -- *o condition: ends c-v-c (second c not w,x,y)
//   _pt_ends_with(w, suffix)    -- fast suffix check
//   _pt_replace(w, suffix, rep, min_m) -- replace suffix if m >= min_m
//
// LEAF -- imports NOTHING.

// ---------------------------------------------------------------------------
// Character helpers
// ---------------------------------------------------------------------------

// Return 1 if character at index i in word w is a vowel (a,e,i,o,u).
// 'y' is a vowel when preceded by a consonant (handled by callers).
fn _pt_is_vowel(w: string, i: int) -> int
    let c = char_at(w, i)
    let r = 0
    if c == "a" or c == "e" or c == "i" or c == "o" or c == "u"
        r = 1
    r

// Return 1 if character at i is a vowel considering 'y' rule:
// 'y' counts as vowel when not at position 0 and preceded by consonant.
fn _pt_is_vowel_y(w: string, i: int) -> int
    let c = char_at(w, i)
    let r = 0
    if c == "a" or c == "e" or c == "i" or c == "o" or c == "u"
        r = 1
    else if c == "y" and i > 0
        // y is vowel when preceded by a consonant
        let prev_vow = _pt_is_vowel(w, i - 1)
        if prev_vow == 0
            r = 1
    r

// ---------------------------------------------------------------------------
// Measure m(s): count VC sequences in string s
// The word is split into consonant/vowel sequences; m counts the VC pairs.
// ---------------------------------------------------------------------------
fn _pt_m(w: string) -> int
    let n = len(w)
    let count = 0
    if n == 0
        return count
    // Walk through the string counting transitions from V to C sequences.
    // State: 0 = initial/in-C-cluster, 1 = in-V-cluster
    let state = 0
    for i in 0..n
        let v = _pt_is_vowel_y(w, i)
        if state == 0
            // currently in a consonant cluster (or start)
            if v == 1
                state = 1
        else
            // currently in a vowel cluster
            if v == 0
                count += 1
                state = 0
    count

// *v* condition: stem contains at least one vowel (including y-as-vowel).
fn _pt_contains_vowel(w: string) -> int
    let n = len(w)
    let r = 0
    let i = 0
    while i < n and r == 0
        let v = _pt_is_vowel_y(w, i)
        if v == 1
            r = 1
        i += 1
    r

// *d condition: stem ends with double consonant (same letter, consonant).
fn _pt_ends_double_c(w: string) -> int
    let n = len(w)
    let r = 0
    if n >= 2
        let c1 = char_at(w, n - 1)
        let c2 = char_at(w, n - 2)
        if c1 == c2
            let v = _pt_is_vowel_y(w, n - 1)
            if v == 0
                r = 1
    r

// *o condition: stem ends with consonant-vowel-consonant
// and the last consonant is not w, x, or y.
fn _pt_ends_cvc(w: string) -> int
    let n = len(w)
    let r = 0
    if n >= 3
        let c3 = char_at(w, n - 1)
        let c2 = char_at(w, n - 2)
        let c1 = char_at(w, n - 3)
        // last char must be consonant, not w/x/y
        let last_ok = 0
        if c3 != "w" and c3 != "x" and c3 != "y"
            let v3 = _pt_is_vowel_y(w, n - 1)
            if v3 == 0
                last_ok = 1
        // middle char must be vowel
        let mid_ok = _pt_is_vowel_y(w, n - 2)
        // first of three must be consonant
        let first_ok = 0
        let v1 = _pt_is_vowel_y(w, n - 3)
        if v1 == 0
            first_ok = 1
        if last_ok == 1 and mid_ok == 1 and first_ok == 1
            r = 1
    r

// ---------------------------------------------------------------------------
// Suffix utilities
// ---------------------------------------------------------------------------

// Return 1 if w ends with suffix.
fn _pt_ends_with(w: string, suffix: string) -> int
    let wl = len(w)
    let sl = len(suffix)
    let r = 0
    if wl >= sl
        let start = wl - sl
        let sub = slice(w, start, wl)
        if sub == suffix
            r = 1
    r

// Return stem of w by removing suffix (checked externally that it exists).
fn _pt_remove_suffix(w: string, suffix: string) -> string
    let wl = len(w)
    let sl = len(suffix)
    slice(w, 0, wl - sl)

// If w ends with suffix AND m(stem) >= min_m, return stem+replacement.
// Otherwise return w unchanged.
// Returns both the new word AND a flag (packed: result always returned,
// caller checks by comparing to original).
fn _pt_replace(w: string, suffix: string, rep: string, min_m: int) -> string
    let r = w
    if _pt_ends_with(w, suffix) == 1
        let stem = _pt_remove_suffix(w, suffix)
        let m = _pt_m(stem)
        if m >= min_m
            r = stem + rep
    r

// ---------------------------------------------------------------------------
// Step 1a: plurals and -ed/-ing variants (basic)
// ---------------------------------------------------------------------------
fn _pt_step1a(w: string) -> string
    let r = w
    if _pt_ends_with(w, "sses") == 1
        r = _pt_remove_suffix(w, "sses") + "ss"
    else if _pt_ends_with(w, "ies") == 1
        r = _pt_remove_suffix(w, "ies") + "i"
    else if _pt_ends_with(w, "ss") == 1
        r = w
    else if _pt_ends_with(w, "s") == 1
        r = _pt_remove_suffix(w, "s")
    r

// ---------------------------------------------------------------------------
// Step 1b: -eed, -ed, -ing
// ---------------------------------------------------------------------------
fn _pt_step1b(w: string) -> string
    let r = w
    if _pt_ends_with(w, "eed") == 1
        let stem = _pt_remove_suffix(w, "eed")
        if _pt_m(stem) > 0
            r = stem + "ee"
    else if _pt_ends_with(w, "ed") == 1
        let stem2 = _pt_remove_suffix(w, "ed")
        if _pt_contains_vowel(stem2) == 1
            // apply step 1b sub-rules
            let w2 = stem2
            if _pt_ends_with(stem2, "at") == 1 or _pt_ends_with(stem2, "bl") == 1 or _pt_ends_with(stem2, "iz") == 1
                w2 = stem2 + "e"
            else if _pt_ends_double_c(stem2) == 1
                // remove last letter unless it's l, s, or z
                let last = char_at(stem2, len(stem2) - 1)
                if last != "l" and last != "s" and last != "z"
                    w2 = slice(stem2, 0, len(stem2) - 1)
            else if _pt_m(stem2) == 1 and _pt_ends_cvc(stem2) == 1
                w2 = stem2 + "e"
            r = w2
    else if _pt_ends_with(w, "ing") == 1
        let stem3 = _pt_remove_suffix(w, "ing")
        if _pt_contains_vowel(stem3) == 1
            let w3 = stem3
            if _pt_ends_with(stem3, "at") == 1 or _pt_ends_with(stem3, "bl") == 1 or _pt_ends_with(stem3, "iz") == 1
                w3 = stem3 + "e"
            else if _pt_ends_double_c(stem3) == 1
                let last2 = char_at(stem3, len(stem3) - 1)
                if last2 != "l" and last2 != "s" and last2 != "z"
                    w3 = slice(stem3, 0, len(stem3) - 1)
            else if _pt_m(stem3) == 1 and _pt_ends_cvc(stem3) == 1
                w3 = stem3 + "e"
            r = w3
    r

// ---------------------------------------------------------------------------
// Step 1c: -y -> -i when stem contains a vowel
// ---------------------------------------------------------------------------
fn _pt_step1c(w: string) -> string
    let r = w
    if _pt_ends_with(w, "y") == 1
        let stem = _pt_remove_suffix(w, "y")
        if _pt_contains_vowel(stem) == 1
            r = stem + "i"
    r

// ---------------------------------------------------------------------------
// Step 2: standard suffixes (m > 0)
// ---------------------------------------------------------------------------
fn _pt_step2(w: string) -> string
    let r = w
    if _pt_ends_with(w, "ational") == 1
        r = _pt_replace(w, "ational", "ate", 1)
    else if _pt_ends_with(w, "tional") == 1
        r = _pt_replace(w, "tional", "tion", 1)
    else if _pt_ends_with(w, "enci") == 1
        r = _pt_replace(w, "enci", "ence", 1)
    else if _pt_ends_with(w, "anci") == 1
        r = _pt_replace(w, "anci", "ance", 1)
    else if _pt_ends_with(w, "izer") == 1
        r = _pt_replace(w, "izer", "ize", 1)
    else if _pt_ends_with(w, "abli") == 1
        r = _pt_replace(w, "abli", "able", 1)
    else if _pt_ends_with(w, "alli") == 1
        r = _pt_replace(w, "alli", "al", 1)
    else if _pt_ends_with(w, "entli") == 1
        r = _pt_replace(w, "entli", "ent", 1)
    else if _pt_ends_with(w, "eli") == 1
        r = _pt_replace(w, "eli", "e", 1)
    else if _pt_ends_with(w, "ousli") == 1
        r = _pt_replace(w, "ousli", "ous", 1)
    else if _pt_ends_with(w, "ization") == 1
        r = _pt_replace(w, "ization", "ize", 1)
    else if _pt_ends_with(w, "ation") == 1
        r = _pt_replace(w, "ation", "ate", 1)
    else if _pt_ends_with(w, "ator") == 1
        r = _pt_replace(w, "ator", "ate", 1)
    else if _pt_ends_with(w, "alism") == 1
        r = _pt_replace(w, "alism", "al", 1)
    else if _pt_ends_with(w, "iveness") == 1
        r = _pt_replace(w, "iveness", "ive", 1)
    else if _pt_ends_with(w, "fulness") == 1
        r = _pt_replace(w, "fulness", "ful", 1)
    else if _pt_ends_with(w, "ousness") == 1
        r = _pt_replace(w, "ousness", "ous", 1)
    else if _pt_ends_with(w, "aliti") == 1
        r = _pt_replace(w, "aliti", "al", 1)
    else if _pt_ends_with(w, "iviti") == 1
        r = _pt_replace(w, "iviti", "ive", 1)
    else if _pt_ends_with(w, "biliti") == 1
        r = _pt_replace(w, "biliti", "ble", 1)
    r

// ---------------------------------------------------------------------------
// Step 3: more suffixes (m > 0)
// ---------------------------------------------------------------------------
fn _pt_step3(w: string) -> string
    let r = w
    if _pt_ends_with(w, "icate") == 1
        r = _pt_replace(w, "icate", "ic", 1)
    else if _pt_ends_with(w, "ative") == 1
        r = _pt_replace(w, "ative", "", 1)
    else if _pt_ends_with(w, "alize") == 1
        r = _pt_replace(w, "alize", "al", 1)
    else if _pt_ends_with(w, "iciti") == 1
        r = _pt_replace(w, "iciti", "ic", 1)
    else if _pt_ends_with(w, "ical") == 1
        r = _pt_replace(w, "ical", "ic", 1)
    else if _pt_ends_with(w, "ful") == 1
        r = _pt_replace(w, "ful", "", 1)
    else if _pt_ends_with(w, "ness") == 1
        r = _pt_replace(w, "ness", "", 1)
    r

// ---------------------------------------------------------------------------
// Step 4: remove more suffixes (m > 1)
// ---------------------------------------------------------------------------
fn _pt_step4(w: string) -> string
    let r = w
    if _pt_ends_with(w, "ement") == 1
        r = _pt_replace(w, "ement", "", 2)
    else if _pt_ends_with(w, "ment") == 1
        r = _pt_replace(w, "ment", "", 2)
    else if _pt_ends_with(w, "ent") == 1
        r = _pt_replace(w, "ent", "", 2)
    else if _pt_ends_with(w, "ion") == 1
        // special: stem must end in s or t
        let stem = _pt_remove_suffix(w, "ion")
        let m = _pt_m(stem)
        if m > 1
            let sl = len(stem)
            if sl > 0
                let last = char_at(stem, sl - 1)
                if last == "s" or last == "t"
                    r = stem
    else if _pt_ends_with(w, "al") == 1
        r = _pt_replace(w, "al", "", 2)
    else if _pt_ends_with(w, "er") == 1
        r = _pt_replace(w, "er", "", 2)
    else if _pt_ends_with(w, "ic") == 1
        r = _pt_replace(w, "ic", "", 2)
    else if _pt_ends_with(w, "able") == 1
        r = _pt_replace(w, "able", "", 2)
    else if _pt_ends_with(w, "ible") == 1
        r = _pt_replace(w, "ible", "", 2)
    else if _pt_ends_with(w, "ant") == 1
        r = _pt_replace(w, "ant", "", 2)
    else if _pt_ends_with(w, "ance") == 1
        r = _pt_replace(w, "ance", "", 2)
    else if _pt_ends_with(w, "ence") == 1
        r = _pt_replace(w, "ence", "", 2)
    else if _pt_ends_with(w, "ate") == 1
        r = _pt_replace(w, "ate", "", 2)
    else if _pt_ends_with(w, "iti") == 1
        r = _pt_replace(w, "iti", "", 2)
    else if _pt_ends_with(w, "ous") == 1
        r = _pt_replace(w, "ous", "", 2)
    else if _pt_ends_with(w, "ive") == 1
        r = _pt_replace(w, "ive", "", 2)
    else if _pt_ends_with(w, "ize") == 1
        r = _pt_replace(w, "ize", "", 2)
    r

// ---------------------------------------------------------------------------
// Step 5a: remove trailing -e
// ---------------------------------------------------------------------------
fn _pt_step5a(w: string) -> string
    let r = w
    if _pt_ends_with(w, "e") == 1
        let stem = _pt_remove_suffix(w, "e")
        let m = _pt_m(stem)
        if m > 1
            r = stem
        else if m == 1
            // remove only if NOT (*o)
            if _pt_ends_cvc(stem) == 0
                r = stem
    r

// ---------------------------------------------------------------------------
// Step 5b: -ll -> -l when m > 1
// ---------------------------------------------------------------------------
fn _pt_step5b(w: string) -> string
    let r = w
    let n = len(w)
    if n >= 2
        let c1 = char_at(w, n - 1)
        let c2 = char_at(w, n - 2)
        if c1 == "l" and c2 == "l"
            if _pt_m(w) > 1
                r = slice(w, 0, n - 1)
    r

// ---------------------------------------------------------------------------
// Public: pt_stem(word) -> stem
// ---------------------------------------------------------------------------
fn pt_stem(word: string) -> string
    let n = len(word)
    if n < 3
        return word
    let w = word
    w = _pt_step1a(w)
    w = _pt_step1b(w)
    w = _pt_step1c(w)
    w = _pt_step2(w)
    w = _pt_step3(w)
    w = _pt_step4(w)
    w = _pt_step5a(w)
    w = _pt_step5b(w)
    w

// ---------------------------------------------------------------------------
// Public: pt_stem_all(words_list) -> list of stems
// ---------------------------------------------------------------------------
fn pt_stem_all(words: list) -> list
    let result = []
    let i = 0
    let n = len(words)
    while i < n
        let w = str(words[i])
        result.push(pt_stem(w))
        i += 1
    result
