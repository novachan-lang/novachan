// forge_xmlparse -- a SAFE inbound XML PARSER (forge_xml.nova only SERIALIZES; this parses).
// xml_parse(text) walks the document char-by-char and returns a NODE tree, where a node is a
// plain dict {"tag":string, "attrs":dict, "children":list<node>, "text":string}. It handles
// elements, attributes (single- OR double-quoted, and valueless), self-closing <br/>, text
// content, comments <!-- -->, CDATA <![CDATA[..]]> (raw), processing instructions/prolog <?..?>,
// and the 5 predefined entities &lt; &gt; &amp; &quot; &apos; (decoded in both text and attribute
// values). Query helpers: xml_find / xml_find_all / xml_text / xml_attr.
//
// SAFE BY DEFAULT: <!DOCTYPE>/DTDs are SKIPPED, never processed, and NO custom or external entity
// is ever expanded -- an unknown "&x;" is passed through literally. This makes the classic
// billion-laughs / XXE entity-expansion attacks structurally impossible; there is no expansion
// engine to abuse. Malformed input never crashes: xml_parse returns a node carrying an "error"
// attr, and every scan is bounded (unclosed tags/comments simply stop at EOF, never loop).
// RECURSION DEPTH IS CAPPED: element parsing is mutual recursion between _xml_parse_element and
// _xml_parse_children, one native call-stack frame pair per nesting level. A crafted document
// nested thousands of levels deep (e.g. 20000x "<a>") would otherwise recurse the native stack
// into the ground (crash/UB). A `depth` counter is threaded through both functions and capped at
// 1000: past the cap an element's own tag/attrs are still parsed (so the well-formed prefix is
// preserved) but its content is not descended into -- it is flagged with attrs["error"] instead.
// Unterminated tags/attributes (EOF before a "<name...>"'s ">" is found) and mismatched closing
// tags (a "</x>" whose name doesn't match the element it closes) are likewise flagged via
// attrs["error"] rather than silently accepted as well-formed.
//
// AUDIT NOTE (CHAR-AT O(n^2) PERF-DoS, found + fixed): every scanning primitive here used to be
// char_at(text, i) where `text` is the WHOLE document and `i` is an ABSOLUTE position in it.
// char_at() decodes UTF-8 from byte offset 0 on EVERY call (nova_rt_char_at in nova_runtime.c: an
// O(index) rescan per call), so scanning forward through the document one char_at() call per
// position is O(n^2) total -- and this module made THAT call, once or more, for every single
// character of the document (skip-space, name/attr reads, the "<!--"/"<![CDATA["/"<?"/"</"
// lookahead checks run at EVERY "<", the close-tag name scan, ...). Confirmed by direct
// measurement through xmlpath's public API (which has no scanning code of its own -- it's a pure
// consumer of xml_parse): a flat (non-nested) document of n=3500/7000/14000/28000 chars took
// 55/94/208/1171 ms respectively -- textbook quadratic growth, and already within a few 2x steps
// of blowing an ordinary 15s test-runner timeout on a realistic-size document, independent of any
// adversarial deep-nesting. FIX: `text` is converted to a byte array ONCE at parse start
// (str_to_bytes, stored in the cursor state as st["bts"]) and EVERY scan below uses
// bytes_get/buffer()/buf_append_char (O(1) random access, O(1)-amortized append) instead of
// char_at()/string concatenation -- true O(n) for the whole parse. Copying raw BYTES (not
// char_at's decoded codepoints) still reconstructs multi-byte UTF-8 sequences byte-for-byte,
// because every XML delimiter byte this parser tests against (space/tab/CR/LF, `< > / = " ' & ; [
// ]`) is ASCII (< 0x80) and can therefore never collide with a UTF-8 continuation or lead byte
// (those are always >= 0x80) -- multi-byte tag/attribute/text content passes through untouched.
// _xml_decode_entities() had the same bug independently (char_at over the extracted string, which
// can itself be large for a big single text/attribute node) and is fixed the same way.
//
// NOVA-WAY: no visitor classes, no schema, no builder objects -- the parse tree is just NOVA's
// own dict/list values, so it composes directly with json_encode, forge templating, and pattern
// dispatch. The moving cursor is a state dict {"text","bts","pos","n"} threaded through recursive
// descent (dicts are reference values in NOVA, so a nested call's advance is seen by the caller)
// -- no out-params, no global mutable parser state, fully re-entrant.
//
// DRAWBACK-AVOIDED: Java's DOM/SAX/StAX + JAXB force you to pick a model and wire up factories,
// handlers, and generated bindings before reading one tag; Python's stdlib expat is UNSAFE by
// default (entity/DTD attacks) so real code needs the third-party `defusedxml` shim. NOVA gives
// one function, safe by construction, returning ordinary values.
//
// LIMITATION (flat-model, honest): a node's "text" is its concatenated DIRECT text; xml_text
// concatenates own text then descendant text. For MIXED content ("a <b/> c") the relative ORDER
// of text vs. child elements is not preserved (all direct text is collapsed together). Leaf text
// -- the common case, e.g. <b>hi</b> -- is exact. LEAF -- imports NOTHING.

// PRIVATE: a fresh empty node with the canonical 4-key shape.
fn _xml_new_node(tag: string) -> dict
    let node = {}
    node["tag"] = tag
    node["attrs"] = {}
    node["children"] = []
    node["text"] = ""
    node

// PRIVATE: a node carrying an "error" attr, returned instead of crashing on malformed input.
fn _xml_error_node(msg: string) -> dict
    let node = _xml_new_node("")
    let a = node["attrs"]
    a["error"] = msg
    node

// PRIVATE: XML whitespace test on a raw BYTE value (space 32, tab 9, LF 10, CR 13).
fn _xml_byte_is_space(b: int) -> bool
    b == 32 or b == 9 or b == 10 or b == 13

// PRIVATE: is byte `b` legal inside a tag/attribute NAME? Stops at whitespace and any XML
// delimiter byte (< > / = " '). A byte >= 0x80 (a UTF-8 continuation or lead byte) is always
// allowed, so multi-byte tag/attribute names are preserved byte-for-byte by the caller's buffer.
fn _xml_byte_is_name_char(b: int) -> bool
    if _xml_byte_is_space(b)
        return false
    if b == 60 or b == 62 or b == 47 or b == 61 or b == 34 or b == 39
        return false
    true

// PRIVATE: is byte `b` present in the small byte-set `set_bts` (length `sm`)? `sm` is always a
// tiny fixed constant (the delimiter set for one _xml_read_until call site), so this is O(1)
// amortized per outer-loop step, not a rescan of anything document-sized.
fn _xml_byte_in_set(b: int, set_bts: any, sm: int) -> bool
    let k = 0
    let found = false
    while k < sm
        if bytes_get(set_bts, k) == b
            found = true
        k = k + 1
    found

// PRIVATE: advance st["pos"] past any run of whitespace. Byte-indexed (see AUDIT NOTE) -- O(1)
// per call, no rescan of the document.
fn _xml_skip_space(st: dict)
    let bts = st["bts"]
    let n = st["n"]
    let i = st["pos"]
    while i < n and _xml_byte_is_space(bytes_get(bts, i))
        i = i + 1
    st["pos"] = i

// PRIVATE: does the byte array `bts` (length `n`) contain literal `pat` starting exactly at byte
// offset `i`? `pat` is always a short fixed literal (<= 9 bytes here), so converting it to bytes
// on each call is O(1) amortized, not the O(n^2) the old char_at-based version produced when
// called at every "<" across a large document (see AUDIT NOTE).
fn _xml_starts_with_at_b(bts: any, n: int, i: int, pat: string) -> bool
    let pbts = str_to_bytes(pat)
    let m = bytes_len(pbts)
    if i + m > n
        return false
    for j in 0..m
        if bytes_get(bts, i + j) != bytes_get(pbts, j)
            return false
    true

// PRIVATE: decode ONLY the 5 predefined entities. Any other "&name;" is left VERBATIM -- this is
// the safety boundary: with no custom/external entity expansion, entity-expansion attacks cannot
// occur. Character references are intentionally not expanded here (keeps the surface minimal/safe).
// Byte-indexed (see AUDIT NOTE) -- `s` can itself be a large extracted text/attribute value, so
// this must be O(len(s)), not O(len(s)^2).
fn _xml_decode_entities(s: string) -> string
    let bts = str_to_bytes(s)
    let n = bytes_len(bts)
    let out = buffer()
    let i = 0
    while i < n
        let b = bytes_get(bts, i)
        if b == 38
            if _xml_starts_with_at_b(bts, n, i, "&lt;")
                buf_append_char(out, 60)
                i = i + 4
            else if _xml_starts_with_at_b(bts, n, i, "&gt;")
                buf_append_char(out, 62)
                i = i + 4
            else if _xml_starts_with_at_b(bts, n, i, "&amp;")
                buf_append_char(out, 38)
                i = i + 5
            else if _xml_starts_with_at_b(bts, n, i, "&quot;")
                buf_append_char(out, 34)
                i = i + 6
            else if _xml_starts_with_at_b(bts, n, i, "&apos;")
                buf_append_char(out, 39)
                i = i + 6
            else
                buf_append_char(out, b)
                i = i + 1
        else
            buf_append_char(out, b)
            i = i + 1
    buf_to_str(out)

// PRIVATE: read raw bytes until any byte in `stops`, then entity-decode. Advances st["pos"].
fn _xml_read_until(st: dict, stops: string) -> string
    let bts = st["bts"]
    let n = st["n"]
    let i = st["pos"]
    let stop_bts = str_to_bytes(stops)
    let sm = bytes_len(stop_bts)
    let buf = buffer()
    while i < n and (not _xml_byte_in_set(bytes_get(bts, i), stop_bts, sm))
        buf_append_char(buf, bytes_get(bts, i))
        i = i + 1
    st["pos"] = i
    _xml_decode_entities(buf_to_str(buf))

// PRIVATE: read an XML name (tag or attribute name); advances past it.
fn _xml_read_name(st: dict) -> string
    let bts = st["bts"]
    let n = st["n"]
    let i = st["pos"]
    let buf = buffer()
    while i < n and _xml_byte_is_name_char(bytes_get(bts, i))
        buf_append_char(buf, bytes_get(bts, i))
        i = i + 1
    st["pos"] = i
    buf_to_str(buf)

// PRIVATE: read an attribute value. Consumes the opening quote (single OR double), reads to the
// matching quote, then entity-decodes. Unquoted values fall back to a bare name token.
fn _xml_read_attr_value(st: dict) -> string
    let bts = st["bts"]
    let n = st["n"]
    let i = st["pos"]
    if i >= n
        return ""
    let q = bytes_get(bts, i)
    if q == 34 or q == 39
        i = i + 1
        let buf = buffer()
        while i < n and bytes_get(bts, i) != q
            buf_append_char(buf, bytes_get(bts, i))
            i = i + 1
        if i < n
            i = i + 1
        st["pos"] = i
        return _xml_decode_entities(buf_to_str(buf))
    st["pos"] = i
    let name = _xml_read_name(st)
    _xml_decode_entities(name)

// PRIVATE: parse the attribute list after a tag name, up to (but NOT consuming) ">" or "/>".
// A guard bounds the loop so a stray char can never spin forever.
fn _xml_parse_attrs(st: dict, node: dict)
    let bts = st["bts"]
    let n = st["n"]
    let attrs = node["attrs"]
    let guard = 0
    while guard < 100000
        guard = guard + 1
        _xml_skip_space(st)
        let i = st["pos"]
        if i >= n
            // Ran out of input before this tag's closing ">" or "/>" was
            // found -- e.g. an unterminated attribute quote that swallowed
            // the rest of the document, or a bare "<name" with no close.
            // Flag it rather than silently returning as if well-formed.
            attrs["error"] = "unterminated tag"
            return
        let b = bytes_get(bts, i)
        if b == 62 or b == 47
            return
        let name = _xml_read_name(st)
        if name == ""
            st["pos"] = st["pos"] + 1
        else
            _xml_skip_space(st)
            let j = st["pos"]
            if j < n and bytes_get(bts, j) == 61
                st["pos"] = j + 1
                _xml_skip_space(st)
                let v = _xml_read_attr_value(st)
                attrs[name] = v
            else
                attrs[name] = ""

// PRIVATE: skip a comment <!-- ... -->. Assumes st["pos"] is at "<!--". Stops at EOF if unclosed.
fn _xml_skip_comment(st: dict)
    let bts = st["bts"]
    let n = st["n"]
    let i = st["pos"] + 4
    while i < n and (not _xml_starts_with_at_b(bts, n, i, "-->"))
        i = i + 1
    if i < n
        i = i + 3
    st["pos"] = i

// PRIVATE: skip a <!DOCTYPE ...> / <!...> declaration (SAFE: DTDs ignored, never processed).
// Tracks internal-subset "[...]" depth so a ">" inside the subset does not end it early.
fn _xml_skip_decl(st: dict)
    let bts = st["bts"]
    let n = st["n"]
    let i = st["pos"] + 2
    let depth = 0
    while i < n
        let b = bytes_get(bts, i)
        if b == 91
            depth = depth + 1
        else
            if b == 93
                if depth > 0
                    depth = depth - 1
            else
                if b == 62 and depth == 0
                    i = i + 1
                    st["pos"] = i
                    return
        i = i + 1
    st["pos"] = i

// PRIVATE: skip a processing instruction / XML prolog <? ... ?>. Advances past "?>".
fn _xml_skip_pi(st: dict)
    let bts = st["bts"]
    let n = st["n"]
    let i = st["pos"] + 2
    while i < n and (not _xml_starts_with_at_b(bts, n, i, "?>"))
        i = i + 1
    if i < n
        i = i + 2
    st["pos"] = i

// PRIVATE: read a CDATA section <![CDATA[ ... ]]> and return its RAW body (no entity decoding).
fn _xml_read_cdata(st: dict) -> string
    let bts = st["bts"]
    let n = st["n"]
    let i = st["pos"] + 9
    let buf = buffer()
    while i < n and (not _xml_starts_with_at_b(bts, n, i, "]]>"))
        buf_append_char(buf, bytes_get(bts, i))
        i = i + 1
    if i < n
        i = i + 3
    st["pos"] = i
    buf_to_str(buf)

// PRIVATE: parse one element starting at "<name ...". Assumes st["pos"] is at "<" and the tag is
// a real element (not a comment/PI/decl/closing tag). Handles self-closing and open/close forms.
// `depth` is this element's own nesting level (root == 1); mutually recursive with
// _xml_parse_children (one call-stack frame pair per level). Once depth reaches the cap, this
// element's own tag/attrs are still parsed normally (the well-formed prefix survives) but
// _xml_parse_children is NOT called -- recursion stops growing here instead of continuing down
// into a maliciously deep document (e.g. 20000x nested "<a>") and blowing the native call stack.
fn _xml_parse_element(st: dict, depth: int) -> dict
    let bts = st["bts"]
    let n = st["n"]
    st["pos"] = st["pos"] + 1
    let name = _xml_read_name(st)
    let node = _xml_new_node(name)
    _xml_parse_attrs(st, node)
    _xml_skip_space(st)
    let i = st["pos"]
    if i >= n
        return node
    let b = bytes_get(bts, i)
    if b == 47
        st["pos"] = i + 1
        let j = st["pos"]
        if j < n and bytes_get(bts, j) == 62
            st["pos"] = j + 1
        return node
    if b == 62
        st["pos"] = i + 1
        if depth >= 1000
            let a = node["attrs"]
            a["error"] = "max nesting depth exceeded"
        else
            _xml_parse_children(st, node, depth + 1)
        return node
    node

// PRIVATE: parse child content of `node` until its closing tag </...> (or EOF). Appends child
// element nodes to node["children"] and accumulates direct text into node["text"]. Comments,
// CDATA, declarations and PIs encountered inside are handled/skipped. Bounded by a guard.
// `depth` is the nesting level of the CHILDREN parsed here (passed straight through to
// _xml_parse_element for each child) -- see that function's cap on recursion depth.
fn _xml_parse_children(st: dict, node: dict, depth: int)
    let bts = st["bts"]
    let n = st["n"]
    let guard = 0
    while guard < 10000000
        guard = guard + 1
        let i = st["pos"]
        if i >= n
            // EOF reached without ever seeing this element's own closing
            // tag -- flag it instead of silently returning as well-formed.
            let a = node["attrs"]
            a["error"] = "unclosed element"
            return
        let b = bytes_get(bts, i)
        if b == 60
            if _xml_starts_with_at_b(bts, n, i, "<!--")
                _xml_skip_comment(st)
            else
                if _xml_starts_with_at_b(bts, n, i, "<![CDATA[")
                    let cd = _xml_read_cdata(st)
                    node["text"] = node["text"] + cd
                else
                    if _xml_starts_with_at_b(bts, n, i, "<!")
                        _xml_skip_decl(st)
                    else
                        if _xml_starts_with_at_b(bts, n, i, "<?")
                            _xml_skip_pi(st)
                        else
                            if _xml_starts_with_at_b(bts, n, i, "</")
                                let k = i + 2
                                let cbuf = buffer()
                                while k < n and _xml_byte_is_name_char(bytes_get(bts, k))
                                    buf_append_char(cbuf, bytes_get(bts, k))
                                    k = k + 1
                                while k < n and bytes_get(bts, k) != 62
                                    k = k + 1
                                if k < n
                                    k = k + 1
                                st["pos"] = k
                                let close_name = buf_to_str(cbuf)
                                if close_name != node["tag"]
                                    // "</other>" closed THIS element -- not a
                                    // crash risk (bounded, same as before) but
                                    // no longer silently accepted as well-formed.
                                    let a2 = node["attrs"]
                                    a2["error"] = "mismatched closing tag"
                                return
                            else
                                let child = _xml_parse_element(st, depth)
                                push(node["children"], child)
        else
            let t = _xml_read_until(st, "<")
            node["text"] = node["text"] + t

// PUBLIC: parse an XML document into a node tree. Skips the prolog / leading comments / DTDs, then
// parses the single root element. On malformed input (no root, leading text, a lone closing tag,
// empty string) returns a node whose "attrs" carries an "error" message -- it NEVER crashes.
fn xml_parse(text: string) -> dict
    let st = {}
    st["text"] = text
    st["bts"] = str_to_bytes(text)
    st["n"] = bytes_len(st["bts"])
    st["pos"] = 0
    let guard = 0
    while guard < 100000
        guard = guard + 1
        _xml_skip_space(st)
        let i = st["pos"]
        let n = st["n"]
        if i >= n
            return _xml_error_node("no root element")
        let bts = st["bts"]
        let b = bytes_get(bts, i)
        if b != 60
            return _xml_error_node("expected element")
        if _xml_starts_with_at_b(bts, n, i, "<!--")
            _xml_skip_comment(st)
        else
            if _xml_starts_with_at_b(bts, n, i, "<?")
                _xml_skip_pi(st)
            else
                if _xml_starts_with_at_b(bts, n, i, "<!")
                    _xml_skip_decl(st)
                else
                    if _xml_starts_with_at_b(bts, n, i, "</")
                        return _xml_error_node("unexpected closing tag")
                    else
                        return _xml_parse_element(st, 1)
    _xml_error_node("no root element")

// PUBLIC: concatenated text of a node -- its own direct text followed by every descendant's text,
// depth-first. Safe on null / non-node inputs (returns ""). See header LIMITATION on mixed-content
// ordering.
fn xml_text(node) -> string
    if node == null
        return ""
    if type_of(node) != "dict"
        return ""
    if not contains(node, "text")
        return ""
    let out = node["text"]
    if contains(node, "children")
        let kids = node["children"]
        for i in 0..len(kids)
            out = out + xml_text(kids[i])
    out

// PUBLIC: value of attribute `name`, or "" if the node has no such attribute. Null-safe.
fn xml_attr(node, name: string) -> string
    if node == null
        return ""
    if type_of(node) != "dict"
        return ""
    if not contains(node, "attrs")
        return ""
    let a = node["attrs"]
    if contains(a, name)
        return a[name]
    ""

// PUBLIC: first node (root included, then depth-first pre-order over children) whose tag == `tag`.
// Returns null if none match. Null-safe.
fn xml_find(node, tag: string) -> dict
    if node == null
        return null
    if type_of(node) != "dict"
        return null
    if contains(node, "tag") and node["tag"] == tag
        return node
    if not contains(node, "children")
        return null
    let kids = node["children"]
    for i in 0..len(kids)
        let r = xml_find(kids[i], tag)
        if r != null
            return r
    null

// PRIVATE: recursive collector backing xml_find_all.
fn _xml_collect(node, tag: string, out: list)
    if node == null
        return
    if type_of(node) != "dict"
        return
    if contains(node, "tag") and node["tag"] == tag
        push(out, node)
    if contains(node, "children")
        let kids = node["children"]
        for i in 0..len(kids)
            _xml_collect(kids[i], tag, out)

// PUBLIC: every node (root included) whose tag == `tag`, in document order.
fn xml_find_all(node, tag: string) -> list
    let out = []
    _xml_collect(node, tag, out)
    out
