// std/text/case -- identifier case conversion.
// Splits any input (snake, kebab, camelCase, spaces, acronym runs) into words,
// then rejoins per target convention. LEAF -- imports NOTHING.

// PRIVATE: split an identifier into lowercase words.
// Boundaries: separators _ - space ; lower/digit -> upper (camelCase);
// upper-run -> lower transition end (acronym: "XMLHttp" -> xml + http).
fn _cw_split(s: string) -> list
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let lowerd = "abcdefghijklmnopqrstuvwxyz0123456789"
    let lowers = "abcdefghijklmnopqrstuvwxyz"
    let words = []
    let cur = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = char_at(s, i)
        if c == "_" or c == "-" or c == " "
            if len(cur) > 0
                push(words, lower(cur))
                cur = ""
        else
            if i > 0 and find(upper, c) >= 0
                let prev_lowerd = find(lowerd, char_at(s, i - 1)) >= 0
                let prev_up = find(upper, char_at(s, i - 1)) >= 0
                let next_lower = i + 1 < n and find(lowers, char_at(s, i + 1)) >= 0
                if prev_lowerd or (prev_up and next_lower)
                    if len(cur) > 0
                        push(words, lower(cur))
                        cur = ""
            cur += c
        i += 1
    if len(cur) > 0
        push(words, lower(cur))
    words

fn _cw_join(words: list, sep: string) -> string
    let out = ""
    for i in 0..len(words)
        if i > 0
            out += sep
        out += words[i]
    out

fn _cw_cap(w: string) -> string
    if len(w) == 0
        return w
    upper(slice(w, 0, 1)) + slice(w, 1, len(w))

// to_snake("helloWorld") -> "hello_world"
// to_snake("HelloWorld") -> "hello_world"
// to_snake("hello-world") -> "hello_world"
// to_snake("hello world") -> "hello_world"
// to_snake("already_snake") -> "already_snake"
fn to_snake(s: string) -> string
    _cw_join(_cw_split(s), "_")

// to_kebab("helloWorld") -> "hello-world"
fn to_kebab(s: string) -> string
    _cw_join(_cw_split(s), "-")

// to_camel("hello_world") -> "helloWorld"
// to_camel("hello-world") -> "helloWorld"
fn to_camel(s: string) -> string
    let ws = _cw_split(s)
    let out = ""
    for i in 0..len(ws)
        if i == 0
            out += ws[i]
        else
            out += _cw_cap(ws[i])
    out

// to_pascal("hello_world") -> "HelloWorld"
fn to_pascal(s: string) -> string
    let ws = _cw_split(s)
    let out_parts = []
    for i in 0..len(ws)
        push(out_parts, _cw_cap(ws[i]))
    let out = join(out_parts, "")
    out

// cap_first("hello") -> "Hello"
fn cap_first(s: string) -> string
    if len(s) == 0
        return s
    upper(slice(s, 0, 1)) + slice(s, 1, len(s))
