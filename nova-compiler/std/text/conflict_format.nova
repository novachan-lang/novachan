// ============================================================================
// NOVA Standard Library — std/text/conflict_format
// ============================================================================
// Git-style conflict markers for three-way merge conflict representation.
//
// Format:
//   <<<<<<< label_mine
//   ... mine lines ...
//   =======
//   ... theirs lines ...
//   >>>>>>> label_theirs
//
// Public API:
//   conflict_wrap(mine_lines, theirs_lines, label_mine, label_theirs) -> list
//       Wraps two line-lists in standard git conflict markers.
//       Returns a flat list of strings (the conflicted file fragment).
//
//   conflict_has(lines) -> bool (1/0)
//       Returns 1 if any line in `lines` starts with "<<<<<<< ".
//
//   conflict_parse(lines) -> list of dict
//       Scans `lines` for conflict regions.  Each region becomes a dict
//       with keys "mine" (list) and "theirs" (list).
//       Multiple non-overlapping regions are supported.
//
//   conflict_take_mine(lines) -> list
//       Reconstructs the file keeping only the "mine" side of every conflict.
//       Non-conflict lines are passed through unchanged.
//
//   conflict_take_theirs(lines) -> list
//       Like conflict_take_mine but keeps the "theirs" side.
//
// Edge-cases handled:
//   - Empty mine or theirs lists produce correct (empty-section) output.
//   - No conflict regions -> conflict_has returns 0; parse returns []; take_* returns original.
//   - Malformed / unmatched markers: partial regions are silently skipped.
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

fn _cf_starts_with(s, prefix)
    let plen = len(prefix)
    if len(s) < plen
        return 0
    if slice(s, 0, plen) == prefix
        return 1
    return 0

fn _cf_is_open(line)
    _cf_starts_with(line, "<<<<<<< ")

fn _cf_is_sep(line)
    if line == "======="
        return 1
    return 0

fn _cf_is_close(line)
    _cf_starts_with(line, ">>>>>>> ")

// ── Public API ───────────────────────────────────────────────────────────────

// conflict_wrap: produce a git-conflict block from two line-lists.
fn conflict_wrap(mine_lines, theirs_lines, label_mine, label_theirs)
    let out = []
    out.push("<<<<<<< " + label_mine)
    let i = 0
    while i < len(mine_lines)
        out.push(mine_lines[i])
        i += 1
    out.push("=======")
    let j = 0
    while j < len(theirs_lines)
        out.push(theirs_lines[j])
        j += 1
    out.push(">>>>>>> " + label_theirs)
    out

// conflict_has: return 1 if any line opens a conflict region.
fn conflict_has(lines)
    for i in 0..len(lines)
        if _cf_is_open(lines[i])
            return 1
    return 0

// conflict_parse: return list of dicts, one per conflict region.
// State machine: 0=normal, 1=in-mine, 2=in-theirs.
// Each dict has "mine" -> list of strings, "theirs" -> list of strings.
fn conflict_parse(lines)
    let regions = []
    let n = len(lines)
    let i = 0
    let state = 0
    let mine = []
    let theirs = []
    while i < n
        let line = lines[i]
        if state == 0
            if _cf_is_open(line)
                mine = []
                theirs = []
                state = 1
        else
            if state == 1
                if _cf_is_sep(line)
                    state = 2
                else
                    mine.push(line)
            else
                if _cf_is_close(line)
                    let reg = {}
                    reg["mine"] = mine
                    reg["theirs"] = theirs
                    regions.push(reg)
                    state = 0
                else
                    theirs.push(line)
        i += 1
    regions

// conflict_take_mine: keep mine side of conflicts; pass non-conflict lines through.
// State: 0=normal, 1=in-mine (emit), 2=in-theirs (skip).
fn conflict_take_mine(lines)
    let out = []
    let n = len(lines)
    let i = 0
    let state = 0
    while i < n
        let line = lines[i]
        if state == 0
            if _cf_is_open(line)
                state = 1
            else
                out.push(line)
        else
            if state == 1
                if _cf_is_sep(line)
                    state = 2
                else
                    out.push(line)
            else
                if _cf_is_close(line)
                    state = 0
        i += 1
    out

// conflict_take_theirs: keep theirs side; pass non-conflict lines through.
// State: 0=normal, 1=in-mine (skip), 2=in-theirs (emit).
fn conflict_take_theirs(lines)
    let out = []
    let n = len(lines)
    let i = 0
    let state = 0
    while i < n
        let line = lines[i]
        if state == 0
            if _cf_is_open(line)
                state = 1
            else
                out.push(line)
        else
            if state == 1
                if _cf_is_sep(line)
                    state = 2
            else
                if _cf_is_close(line)
                    state = 0
                else
                    out.push(line)
        i += 1
    out
