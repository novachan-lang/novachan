// ============================================================================
// NOVA Standard Library — std/text/md_link
// ============================================================================
// Inline link conversion for Markdown-to-HTML.
//
// Public API:
//   md_link(s) -> str   Convert Markdown inline links to HTML anchor tags.
//
// Pattern:  [text](url)  ->  <a href="url">text</a>
//   where " is chr(34).
//
// Algorithm: single left-to-right scan.
//   At each position, check if '[' starts a valid [text](url) construct:
//     1. Find the matching ']' (first ']' after '[').
//     2. Immediately after ']', expect '('.
//     3. Find the matching ')' (first ')' after '(').
//     4. If all found, emit <a href="url">text</a> and advance past ')'.
//     5. Otherwise emit '[' literally and advance by 1.
//   All non-link text is emitted character by character.
// ============================================================================

// Internal: find the next occurrence of a single character c in s from position start.
// Returns the index, or -1 if not found.
fn _find_char_from(s, c, start) -> int
    let n = len(s)
    let i = start
    let result = -1
    while i < n and result == -1
        if slice(s, i, i + 1) == c
            result = i
        i += 1
    result

// Convert Markdown inline links [text](url) to <a href="url">text</a>.
fn md_link(s) -> str
    let out_parts = []
    let i = 0
    let n = len(s)
    let q = chr(34)
    while i < n
        if slice(s, i, i + 1) == "["
            // Try to parse [text](url) starting at i
            let close_bracket = _find_char_from(s, "]", i + 1)
            if close_bracket >= 0 and close_bracket + 1 < n and slice(s, close_bracket + 1, close_bracket + 2) == "("
                let open_paren = close_bracket + 1
                let close_paren = _find_char_from(s, ")", open_paren + 1)
                if close_paren >= 0
                    let text = slice(s, i + 1, close_bracket)
                    let url = slice(s, open_paren + 1, close_paren)
                    push(out_parts, "<a href=" + q + url + q + ">" + text + "</a>")
                    i = close_paren + 1
                else
                    push(out_parts, "[")
                    i += 1
            else
                push(out_parts, "[")
                i += 1
        else
            push(out_parts, slice(s, i, i + 1))
            i += 1
    let out = join(out_parts, "")
    out
