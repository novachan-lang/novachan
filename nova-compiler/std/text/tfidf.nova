// ============================================================================
// NOVA Standard Library — std/text/tfidf
// ============================================================================
// TF-IDF (Term Frequency – Inverse Document Frequency) over a small document
// corpus where each document is a list of string tokens.
//
// Public API:
//   tf_term_freq(doc_tokens, term) -> float
//       Fraction of tokens in doc_tokens that equal term.
//       Returns 0.0 if the document is empty or the term is absent.
//
//   tf_idf_raw(corpus, term) -> float
//       IDF score for term across the corpus:  ln(N / df)
//       where N = number of documents and df = number of docs containing term.
//       Returns 0.0 when term appears in every document (idf = ln(1) = 0).
//       Returns 0.0 when corpus is empty.
//       When df == 0 (term absent from all docs) returns ln(N / 1) — standard
//       smoothed fallback treating the unseen term as appearing in 1 doc.
//
//   tf_tfidf(corpus, doc_index, term) -> float
//       tf_term_freq(corpus[doc_index], term) * tf_idf_raw(corpus, term)
//
//   tf_vector(corpus, doc_index) -> dict
//       {term -> tfidf_score} for every distinct term in corpus[doc_index].
//
// Design notes:
//   - Tokens are plain strings; no lowercasing is performed (caller normalises).
//   - IDF uses the standard (non-smoothed) formula: ln(N / df).
//     When df == 0 we apply df=1 smoothing so the formula stays defined.
//   - Bare float returns are bound to a named let to avoid the float-return
//     codegen bug (reference_nova_float_codegen_geo_bearing).
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _tf_count_term returns the number of occurrences of term in a token list.
fn _tf_count_term(tokens, term) -> int
    let n = len(tokens)
    let count = 0
    for i in 0..n
        if tokens[i] == term
            count = count + 1
    count

// _tf_doc_contains returns 1 if any element of tokens equals term, else 0.
fn _tf_doc_contains(tokens, term) -> int
    let n = len(tokens)
    for i in 0..n
        if tokens[i] == term
            return 1
    0

// _tf_df returns the document frequency of term in corpus:
// the count of documents (token lists) that contain term at least once.
fn _tf_df(corpus, term) -> int
    let n = len(corpus)
    let df = 0
    for i in 0..n
        if _tf_doc_contains(corpus[i], term) == 1
            df = df + 1
    df

// ── public API ───────────────────────────────────────────────────────────────

// tf_term_freq returns the fraction of tokens in doc_tokens that equal term.
// Result is in [0.0, 1.0].  Returns 0.0 if doc is empty or term absent.
fn tf_term_freq(doc_tokens, term) -> float
    let n = len(doc_tokens)
    if n == 0
        return 0.0
    let cnt = _tf_count_term(doc_tokens, term)
    if cnt == 0
        return 0.0
    let num = cnt * 1.0
    let den = n * 1.0
    let result = num / den
    result

// tf_idf_raw returns the IDF score for term over the entire corpus.
// idf = ln(N / df).  When df == 0 (term unseen) uses df = 1 as smoothing.
// Returns 0.0 when the corpus is empty.
fn tf_idf_raw(corpus, term) -> float
    let big_n = len(corpus)
    if big_n == 0
        return 0.0
    let df = _tf_df(corpus, term)
    let df_use = df
    if df_use == 0
        df_use = 1
    let num = big_n * 1.0
    let den = df_use * 1.0
    let ratio = num / den
    let result = log(ratio)
    result

// tf_tfidf returns tf * idf for (corpus[doc_index], term).
fn tf_tfidf(corpus, doc_index, term) -> float
    let doc = corpus[doc_index]
    let tf = tf_term_freq(doc, term)
    let idf = tf_idf_raw(corpus, term)
    let result = tf * idf
    result

// tf_vector returns a dict mapping every distinct term in corpus[doc_index]
// to its TF-IDF score against the full corpus.
fn tf_vector(corpus, doc_index) -> dict
    let doc = corpus[doc_index]
    let n = len(doc)
    // collect distinct terms via a dict used as a set
    let seen = {}
    for i in 0..n
        let t = doc[i]
        if contains(seen, t) == 0
            seen[t] = 1
    // build output dict: term -> tfidf
    let out = {}
    let terms = keys(seen)
    for j in 0..len(terms)
        let t = terms[j]
        let score = tf_tfidf(corpus, doc_index, t)
        out[t] = score
    out

fn main()
    print("std/text/tfidf loaded")
