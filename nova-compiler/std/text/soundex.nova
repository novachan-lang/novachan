// std/text/soundex -- American Soundex phonetic encoding.
//
// Public API:
//   sx_soundex(s: string) -> string
//     Returns the 4-character Soundex code for s:
//     first letter uppercased + exactly 3 digits (0-padded).
//     Empty or blank input returns "0000".
//
// Rules (US Census / Knuth standard):
//   B,F,P,V       -> 1
//   C,G,J,K,Q,S,X,Z -> 2
//   D,T           -> 3
//   L             -> 4
//   M,N           -> 5
//   R             -> 6
//   A,E,I,O,U,H,W,Y -> ignored (0)
//
//   H and W are transparent: they do NOT break a same-code run.
//   Vowels (A,E,I,O,U,Y) DO break a same-code run (reset the "last code").
//   Collapse adjacent same-code digits (after H/W transparency).
//   Pad with zeros to reach 3 digits; truncate if more than 3.
//
// LEAF -- imports NOTHING.

// Map a single uppercase character to its Soundex digit (0-6).
// 0 means the character is ignored for coding purposes.
fn _sx_code(c: string) -> int
    let r = 0
    if c == "B" or c == "F" or c == "P" or c == "V"
        r = 1
    else if c == "C" or c == "G" or c == "J" or c == "K" or c == "Q" or c == "S" or c == "X" or c == "Z"
        r = 2
    else if c == "D" or c == "T"
        r = 3
    else if c == "L"
        r = 4
    else if c == "M" or c == "N"
        r = 5
    else if c == "R"
        r = 6
    r

// Return true if c is H or W (transparent separators that don't reset same-code run).
fn _sx_is_hw(c: string) -> int
    let r = 0
    if c == "H" or c == "W"
        r = 1
    r

// Uppercase a single character (A-Z only; non-alpha returned unchanged).
fn _sx_upper(c: string) -> string
    let o = ord(c)
    let r = c
    if o >= 97 and o <= 122
        r = chr(o - 32)
    r

// Compute the American Soundex code for string s.
// Returns "0000" for empty input.
fn sx_soundex(s: string) -> string
    let slen = len(s)
    let result = "0000"
    if slen > 0
        // Find first alphabetic character as the leading letter.
        let first = _sx_upper(char_at(s, 0))
        let first_code = _sx_code(first)

        // Build digit string by scanning from index 1.
        // prev_code starts as the code of the first letter (so immediately
        // adjacent same-code letters at the start are collapsed).
        let digits = ""
        let prev_code = first_code
        let i = 1
        while i < slen and len(digits) < 3
            let c = _sx_upper(char_at(s, i))
            let hw = _sx_is_hw(c)
            if hw == 0
                // Not H or W: compute code and compare.
                let code = _sx_code(c)
                if code == 0
                    // Vowel (or Y): resets the run so next same-code letter IS counted.
                    prev_code = 0
                else if code != prev_code
                    digits = digits + str(code)
                    prev_code = code
                // else: same code as previous non-HW non-vowel -> collapse (skip)
            // H or W: do NOT update prev_code (transparent)
            i = i + 1

        // Pad digits to exactly 3 characters with zeros.
        let dlen = len(digits)
        if dlen < 3
            let pad = 3 - dlen
            if pad == 3
                digits = digits + "000"
            else if pad == 2
                digits = digits + "00"
            else
                digits = digits + "0"

        // Truncate to first 3 digits if longer (shouldn't exceed 3 due to loop guard).
        result = first + slice(digits, 0, 3)
    result

// sx_encode is the canonical NARA-spec name for the Soundex function.
// Identical semantics to sx_soundex.
fn sx_encode(name: string) -> string
    sx_soundex(name)

// sx_matches returns true if two names share the same Soundex code.
fn sx_matches(a: string, b: string) -> int
    let r = 0
    if sx_soundex(a) == sx_soundex(b)
        r = 1
    r
