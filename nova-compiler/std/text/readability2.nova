// ============================================================================
// NOVA Standard Library — std/text/readability2
// ============================================================================
// Additional English readability formulas beyond Flesch/Flesch-Kincaid/ARI.
//
// Public API:
//   rd2_word_count(text) -> int
//   rd2_sentence_count(text) -> int
//   rd2_syllable_count_word(word) -> int
//   rd2_syllables(text) -> int
//   rd2_letters(text) -> int
//   rd2_complex_words(text) -> int   (words with >= 3 syllables)
//   rd2_long_words(text, minlen) -> int   (words with len >= minlen)
//   rd2_smog(text) -> float
//   rd2_gunning_fog(text) -> float
//   rd2_coleman_liau(text) -> float
//   rd2_lix(text) -> float
//   rd2_rix(text) -> float
//   rd2_forcast(text) -> float
//   rd2_dale_chall(text, hard_word_count) -> float
//   rd2_grade_consensus(text) -> float
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Return 1 if byte code b is ASCII whitespace.
fn _rd2_is_ws(b) -> int
    if b == 32
        return 1
    if b == 9
        return 1
    if b == 13
        return 1
    if b == 10
        return 1
    0

// Return 1 if single-char string c is a vowel (a e i o u y).
fn _rd2_is_vowel(c) -> int
    if c == "a"
        return 1
    if c == "e"
        return 1
    if c == "i"
        return 1
    if c == "o"
        return 1
    if c == "u"
        return 1
    if c == "y"
        return 1
    0

// Return 1 if byte code b is an ASCII letter (A-Z or a-z).
fn _rd2_is_alpha_b(b) -> int
    if b >= 65 and b <= 90
        return 1
    if b >= 97 and b <= 122
        return 1
    0

// Lowercase and strip non-alpha chars from token t.
fn _rd2_clean_word(t) -> str
    let out_parts = []
    let n = len(t)
    for i in 0..n
        let b = ord(t[i])
        if b >= 65 and b <= 90
            push(out_parts, chr(b + 32))
        else
            if b >= 97 and b <= 122
                push(out_parts, t[i])
    let out = join(out_parts, "")
    out

// Split text on whitespace; return list of non-empty tokens.
fn _rd2_split(s) -> any
    let toks = []
    let n = len(s)
    let i = 0
    let cur = ""
    while i < n
        let b = ord(s[i])
        if _rd2_is_ws(b) == 1
            if len(cur) > 0
                push(toks, cur)
                cur = ""
        else
            cur += s[i]
        i += 1
    if len(cur) > 0
        push(toks, cur)
    toks

// Count syllables in a single cleaned (lowercase, alpha-only) word.
// Uses vowel-group heuristic with silent trailing-e suppression.
fn _rd2_syl_word(word) -> int
    let n = len(word)
    if n == 0
        return 0
    let groups = 0
    let prev_was_vowel = 0
    for i in 0..n
        let c = word[i]
        let is_v = _rd2_is_vowel(c)
        if is_v == 1
            if prev_was_vowel == 0
                groups += 1
            prev_was_vowel = 1
        else
            prev_was_vowel = 0
    // Silent trailing-e: last='e', prev non-vowel, NOT ending in "le", groups>1.
    if n >= 2
        let last_c = word[n - 1]
        let prev_c = word[n - 2]
        if last_c == "e"
            if _rd2_is_vowel(prev_c) == 0
                if prev_c == "l"
                    groups = groups
                else
                    if groups > 1
                        groups -= 1
    if groups < 1
        groups = 1
    groups

// ── public API ───────────────────────────────────────────────────────────────

// Count whitespace-separated non-empty tokens in text.
fn rd2_word_count(text) -> int
    let toks = _rd2_split(text)
    len(toks)

// Count sentence terminators: '.', '!', '?'.
// Returns at least 1 for non-empty text, 0 for empty text.
fn rd2_sentence_count(text) -> int
    if len(text) == 0
        return 0
    let n = len(text)
    let count = 0
    for i in 0..n
        let b = ord(text[i])
        if b == 46
            count += 1
        if b == 33
            count += 1
        if b == 63
            count += 1
    if count < 1
        count = 1
    count

// Count syllables in a single word (auto-cleans the word first).
fn rd2_syllable_count_word(word) -> int
    let cleaned = _rd2_clean_word(word)
    if len(cleaned) == 0
        return 0
    _rd2_syl_word(cleaned)

// Count total syllables across all words in text.
fn rd2_syllables(text) -> int
    let toks = _rd2_split(text)
    let total = 0
    for i in 0..len(toks)
        let cleaned = _rd2_clean_word(toks[i])
        if len(cleaned) > 0
            total += _rd2_syl_word(cleaned)
    total

// Count ASCII letter characters in text.
fn rd2_letters(text) -> int
    let n = len(text)
    let count = 0
    for i in 0..n
        let b = ord(text[i])
        if _rd2_is_alpha_b(b) == 1
            count += 1
    count

// Count words with >= 3 syllables (complex words) in text.
fn rd2_complex_words(text) -> int
    let toks = _rd2_split(text)
    let count = 0
    for i in 0..len(toks)
        let cleaned = _rd2_clean_word(toks[i])
        if len(cleaned) > 0
            let s = _rd2_syl_word(cleaned)
            if s >= 3
                count += 1
    count

// Count words whose length (alpha chars only, before cleaning) >= minlen.
fn rd2_long_words(text, minlen) -> int
    let toks = _rd2_split(text)
    let count = 0
    for i in 0..len(toks)
        let cleaned = _rd2_clean_word(toks[i])
        if len(cleaned) >= minlen
            count += 1
    count

// SMOG index: 1.043 * sqrt(complex_words * 30 / sentences) + 3.1291.
// Returns 0.0 for empty or degenerate text.
fn rd2_smog(text) -> float
    let w = rd2_word_count(text)
    if w == 0
        return 0.0
    let s = rd2_sentence_count(text)
    if s == 0
        return 0.0
    let cw = rd2_complex_words(text)
    let ratio = (cw * 1.0) * 30.0 / (s * 1.0)
    let sq = sqrt(ratio)
    let result = 1.043 * sq + 3.1291
    result

// Gunning Fog Index: 0.4 * (words/sentences + 100 * complex/words).
// Returns 0.0 for empty text.
fn rd2_gunning_fog(text) -> float
    let w = rd2_word_count(text)
    if w == 0
        return 0.0
    let s = rd2_sentence_count(text)
    if s == 0
        return 0.0
    let cw = rd2_complex_words(text)
    let ws_ratio = (w * 1.0) / (s * 1.0)
    let cw_ratio = (cw * 1.0) / (w * 1.0)
    let result = 0.4 * (ws_ratio + 100.0 * cw_ratio)
    result

// Coleman-Liau Index: 0.0588*L - 0.296*S - 15.8
// where L = letters per 100 words, S = sentences per 100 words.
// Returns 0.0 for empty text.
fn rd2_coleman_liau(text) -> float
    let w = rd2_word_count(text)
    if w == 0
        return 0.0
    let s = rd2_sentence_count(text)
    let ltr = rd2_letters(text)
    let big_l = (ltr * 1.0) / (w * 1.0) * 100.0
    let big_s = (s * 1.0) / (w * 1.0) * 100.0
    let result = 0.0588 * big_l - 0.296 * big_s - 15.8
    result

// LIX (Lasbarhetsindex): words/sentences + 100*(long_words>=7/words).
// Returns 0.0 for empty text.
fn rd2_lix(text) -> float
    let w = rd2_word_count(text)
    if w == 0
        return 0.0
    let s = rd2_sentence_count(text)
    if s == 0
        return 0.0
    let lw = rd2_long_words(text, 7)
    let ws_ratio = (w * 1.0) / (s * 1.0)
    let lw_ratio = (lw * 1.0) / (w * 1.0)
    let result = ws_ratio + 100.0 * lw_ratio
    result

// RIX: long_words(>=7) / sentences.
// Returns 0.0 for empty text.
fn rd2_rix(text) -> float
    let s = rd2_sentence_count(text)
    if s == 0
        return 0.0
    if len(text) == 0
        return 0.0
    let lw = rd2_long_words(text, 7)
    let result = (lw * 1.0) / (s * 1.0)
    result

// FORCAST formula: 20 - (monosyllable_count_per_150_words / 10).
// Monosyllabic words = words with exactly 1 syllable.
// Returns 0.0 for empty text.
fn rd2_forcast(text) -> float
    let w = rd2_word_count(text)
    if w == 0
        return 0.0
    let toks = _rd2_split(text)
    let mono = 0
    for i in 0..len(toks)
        let cleaned = _rd2_clean_word(toks[i])
        if len(cleaned) > 0
            let s = _rd2_syl_word(cleaned)
            if s == 1
                mono += 1
    // monosyllables per 150 words
    let mono_per_150 = (mono * 1.0) / (w * 1.0) * 150.0
    let result = 20.0 - mono_per_150 / 10.0
    result

// Dale-Chall Readability Score: 0.1579*(hard/words*100) + 0.0496*(words/sentences).
// hard_word_count is the number of words the caller deems "hard" (not on the Dale-Chall easy list).
// Returns 0.0 for empty text.
fn rd2_dale_chall(text, hard_word_count) -> float
    let w = rd2_word_count(text)
    if w == 0
        return 0.0
    let s = rd2_sentence_count(text)
    if s == 0
        return 0.0
    let hard_pct = (hard_word_count * 1.0) / (w * 1.0) * 100.0
    let ws_ratio = (w * 1.0) / (s * 1.0)
    let result = 0.1579 * hard_pct + 0.0496 * ws_ratio
    result

// Grade consensus: arithmetic mean of SMOG, Gunning Fog, and Coleman-Liau.
// Returns 0.0 for empty text.
fn rd2_grade_consensus(text) -> float
    let w = rd2_word_count(text)
    if w == 0
        return 0.0
    let s1 = rd2_smog(text)
    let s2 = rd2_gunning_fog(text)
    let s3 = rd2_coleman_liau(text)
    let result = (s1 + s2 + s3) / 3.0
    result

fn main()
    print("std/text/readability2 loaded")
