// ============================================================================
// NOVA Standard Library — std/text/bbcode_quote
// ============================================================================
// Parse and build BBCode [quote] blocks, including nested quotes.
//
// Recognised opening forms: "[quote]" and "[quote=AUTHOR]". Closing form:
// "[/quote]". Tag matching is case-insensitive; extracted text/author keep
// their original casing.
//
// Public API:
//   bquo_extract_quotes(input) -> list
//       Stack-based scan that properly pairs nested [quote]...[/quote]
//       blocks. Returns a list of dicts, one per closed quote block, each
//       with keys "author" (the AUTHOR text, or "" if the tag was bare
//       "[quote]") and "text" (the raw content between the opening tag and
//       its matching "[/quote]", including any nested BBCode markup as-is).
//       Because a block is emitted when its closing tag is found, entries
//       for inner (nested) quotes appear before their enclosing quote.
//       An unmatched "[quote...]" (no closing tag) contributes no entry.
//
//   bquo_build(text, author) -> string
//       Build "[quote=author]text[/quote]". If author is "", build the bare
//       "[quote]text[/quote]" form instead.
//
//   bquo_depth(input) -> int
//       The maximum nesting depth of [quote]...[/quote] blocks in input
//       (a single top-level quote has depth 1; a quote nested one level
//       inside another has depth 2, etc). 0 if there are no quotes.
//
//   bquo_flatten(input) -> string
//       Remove every [quote]/[quote=author]/[/quote] tag (at any nesting
//       level) from input, concatenating everything else unchanged.
//
// LEAF — imports NOTHING.
// ============================================================================

// _bquo_starts_ci: 1 if s has tag_lower (already lowercase) at position i,
// compared case-insensitively; 0 if out of range or not matching.
fn _bquo_starts_ci(s, i, tag_lower) -> int
    let tlen = len(tag_lower)
    if i + tlen > len(s)
        return 0
    if lower(slice(s, i, i + tlen)) == tag_lower
        return 1
    0

// _bquo_open_len: if s has an opening "[quote]" or "[quote=...]" tag at
// position i, return the tag's total length (including brackets);
// otherwise return 0.
fn _bquo_open_len(s, i) -> int
    let n = len(s)
    if _bquo_starts_ci(s, i, "[quote") == 0
        return 0
    let after = i + 6
    if after >= n
        return 0
    let c = slice(s, after, after + 1)
    if c == "]"
        return after + 1 - i
    if c == "="
        let rest = slice(s, after + 1, n)
        let j = find(rest, "]")
        if j < 0
            return 0
        return after + 1 + j + 1 - i
    0

// _bquo_open_author: given an opening tag at position i with known total
// length taglen (as returned by _bquo_open_len), return its AUTHOR text,
// or "" for a bare "[quote]" tag.
fn _bquo_open_author(s, i, taglen) -> string
    let after = i + 6
    let c = slice(s, after, after + 1)
    if c == "="
        return slice(s, after + 1, i + taglen - 1)
    ""

// bquo_extract_quotes(input) -> list
fn bquo_extract_quotes(input) -> list
    let out = []
    let starts = []
    let authors = []
    let n = len(input)
    let i = 0
    while i < n
        let ol = _bquo_open_len(input, i)
        if ol > 0
            let author = _bquo_open_author(input, i, ol)
            push(starts, i + ol)
            push(authors, author)
            i += ol
        else if _bquo_starts_ci(input, i, "[/quote]")
            let depth = len(starts)
            if depth > 0
                let cstart = starts[depth - 1]
                let auth = authors[depth - 1]
                let text = slice(input, cstart, i)
                let d = {}
                d["author"] = auth
                d["text"] = text
                push(out, d)
                pop(starts)
                pop(authors)
            i += 8
        else
            i += 1
    out

// bquo_build(text, author) -> string
fn bquo_build(text, author) -> string
    if author == ""
        return "[quote]" + text + "[/quote]"
    "[quote=" + author + "]" + text + "[/quote]"

// bquo_depth(input) -> int
fn bquo_depth(input) -> int
    let n = len(input)
    let i = 0
    let depth = 0
    let maxd = 0
    while i < n
        let ol = _bquo_open_len(input, i)
        if ol > 0
            depth += 1
            if depth > maxd
                maxd = depth
            i += ol
        else if _bquo_starts_ci(input, i, "[/quote]")
            if depth > 0
                depth -= 1
            i += 8
        else
            i += 1
    maxd

// bquo_flatten(input) -> string
fn bquo_flatten(input) -> string
    let n = len(input)
    let out_parts = []
    let i = 0
    while i < n
        let ol = _bquo_open_len(input, i)
        if ol > 0
            i += ol
        else if _bquo_starts_ci(input, i, "[/quote]")
            i += 8
        else
            push(out_parts, slice(input, i, i + 1))
            i += 1
    let out = join(out_parts, "")
    out
