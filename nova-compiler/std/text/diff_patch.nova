// ============================================================================
// NOVA Standard Library — std/text/diff_patch
// ============================================================================
// Line-based diff and patch over lists of strings, built on the classic
// dynamic-programming Longest Common Subsequence (LCS) formulation (the same
// mathematical result Myers' O(ND) algorithm computes via a faster greedy
// edge-walk — this module trades Myers' asymptotic edge for a much simpler,
// unmistakably-correct O(n*m) table that is entirely adequate for typical
// stdlib inputs such as config files, source diffs, and small documents).
//
// ALGORITHM:
//   Let a have length n, b have length m. Build a SUFFIX table L where
//   L[i][j] = length of the LCS of a[i:] and b[j:]:
//     L[n][j] = 0 for all j;  L[i][m] = 0 for all i
//     L[i][j] = L[i+1][j+1] + 1              if a[i] == b[j]
//     L[i][j] = max(L[i+1][j], L[i][j+1])    otherwise
//   Then walk FORWARD from (0,0): at each step, if a[i]==b[j] emit an "eq"
//   op and advance both; otherwise step toward whichever neighbor
//   (L[i+1][j] vs L[i][j+1]) preserves the optimal LCS length, emitting a
//   "del" (consumes a[i]) or "ins" (consumes b[j]) op. This produces the
//   same edit script Myers' algorithm would (a minimal edit script — no
//   algorithm can do fewer ins/del operations than |n+m-2*LCS_len|), just
//   without backtracking from the end.
//
// EDIT SCRIPT REPRESENTATION:
//   A list of ops, each a dict {"op": "eq"|"del"|"ins", "text": string}.
//   "eq"  — line present in both a and b, unchanged.
//   "del" — line present only in a (removed).
//   "ins" — line present only in b (added).
//   Concatenating the "text" of every op that is NOT "del", in order,
//   reconstructs b. Concatenating every op that is NOT "ins" reconstructs a.
//   This IS the patch: dfp_apply() needs nothing but this list to rebuild b.
//
// PUBLIC API:
//   dfp_diff(a: list<string>, b: list<string>) -> list<op>
//   dfp_apply(ops: list<op>) -> list<string>          (rebuilds b from ops)
//   dfp_source(ops: list<op>) -> list<string>          (rebuilds a from ops)
//   dfp_lcs_len(a, b) -> int
//   dfp_stats(ops) -> {"ins":int, "del":int, "eq":int}
//   dfp_unified(a, b) -> string   ("  line" / "+ line" / "- line", \n-joined)
//   dfp_identical(a, b) -> bool   (true iff a and b are line-for-line equal)
//
// COMPLEXITY: dfp_diff is O(n*m) time and O(n*m) space (a full DP table).
// This is intentionally the simple/correct choice for a stdlib utility
// aimed at small-to-medium inputs, not a Git-scale diff engine.
//
// SYMBOL COLLISION GUARD: all helpers prefixed _dfp_.
// LEAF — imports NOTHING.
// ============================================================================

// _dfp_build_table: suffix-LCS-length table L, sized (n+1) x (m+1).
// L[i] is a list of length m+1; L[n] is all zeros (base case row).
fn _dfp_build_table(a, b)
    let n = len(a)
    let m = len(b)
    let table = []
    let zero_row = []
    let z = 0
    while z <= m
        zero_row.push(0)
        z = z + 1
    let r = 0
    while r <= n
        table.push(list_slice(zero_row, 0, m + 1))
        r = r + 1

    let i = n - 1
    while i >= 0
        let row_i = table[i]
        let row_i1 = table[i + 1]
        let j = m - 1
        while j >= 0
            if a[i] == b[j]
                row_i[j] = row_i1[j + 1] + 1
            else
                let opt1 = row_i1[j]
                let opt2 = row_i[j + 1]
                if opt1 > opt2
                    row_i[j] = opt1
                else
                    row_i[j] = opt2
            j = j - 1
        i = i - 1
    return table

// dfp_lcs_len: length of the longest common subsequence of a and b.
fn dfp_lcs_len(a, b)
    let table = _dfp_build_table(a, b)
    let row0 = table[0]
    return row0[0]

// dfp_diff: compute a minimal edit script transforming a into b.
fn dfp_diff(a, b)
    let n = len(a)
    let m = len(b)
    let table = _dfp_build_table(a, b)
    let ops = []
    let i = 0
    let j = 0
    while i < n and j < m
        if a[i] == b[j]
            let op = {}
            op["op"] = "eq"
            op["text"] = a[i]
            ops.push(op)
            i = i + 1
            j = j + 1
        else
            let row_i1 = table[i + 1]
            let row_i = table[i]
            let take_del = 1
            if row_i1[j] < row_i[j + 1]
                take_del = 0
            if take_del == 1
                let opd = {}
                opd["op"] = "del"
                opd["text"] = a[i]
                ops.push(opd)
                i = i + 1
            else
                let opi = {}
                opi["op"] = "ins"
                opi["text"] = b[j]
                ops.push(opi)
                j = j + 1
    while i < n
        let opd2 = {}
        opd2["op"] = "del"
        opd2["text"] = a[i]
        ops.push(opd2)
        i = i + 1
    while j < m
        let opi2 = {}
        opi2["op"] = "ins"
        opi2["text"] = b[j]
        ops.push(opi2)
        j = j + 1
    return ops

// dfp_apply: rebuild the "b" side (target) from an edit script.
fn dfp_apply(ops)
    let out = []
    let i = 0
    let n = len(ops)
    while i < n
        let o = ops[i]
        if o["op"] != "del"
            out.push(o["text"])
        i = i + 1
    return out

// dfp_source: rebuild the "a" side (original) from an edit script.
fn dfp_source(ops)
    let out = []
    let i = 0
    let n = len(ops)
    while i < n
        let o = ops[i]
        if o["op"] != "ins"
            out.push(o["text"])
        i = i + 1
    return out

// dfp_stats: count of each op kind in an edit script.
fn dfp_stats(ops)
    let ins = 0
    let del = 0
    let eq = 0
    let i = 0
    let n = len(ops)
    while i < n
        let o = ops[i]
        if o["op"] == "ins"
            ins = ins + 1
        else
            if o["op"] == "del"
                del = del + 1
            else
                eq = eq + 1
        i = i + 1
    let out = {}
    out["ins"] = ins
    out["del"] = del
    out["eq"] = eq
    return out

// dfp_unified: a compact unified-diff-style rendering, one line per op,
// prefixed "  " (context), "+ " (insertion), or "- " (deletion), \n-joined.
fn dfp_unified(a, b)
    let ops = dfp_diff(a, b)
    let lines = []
    let i = 0
    let n = len(ops)
    while i < n
        let o = ops[i]
        let prefix = "  "
        if o["op"] == "ins"
            prefix = "+ "
        else
            if o["op"] == "del"
                prefix = "- "
        lines.push(prefix + o["text"])
        i = i + 1
    return join(lines, "\n")

// dfp_identical: true iff a and b have the same lines in the same order.
fn dfp_identical(a, b)
    let n = len(a)
    let m = len(b)
    let result = true
    if n != m
        result = false
    else
        let i = 0
        while i < n and result == true
            if a[i] != b[i]
                result = false
            i = i + 1
    return result
