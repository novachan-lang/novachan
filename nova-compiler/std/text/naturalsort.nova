// std/text/naturalsort -- Natural (human) sort order.  LEAF -- imports NOTHING.
//
// Natural sort treats embedded digit runs as integers rather than character
// sequences.  "file10" > "file2" because 10 > 2.
//
// Public API:
//   ns_compare(a, b) -> int
//     Returns -1 if a < b, 0 if a == b, 1 if a > b under natural sort order.
//
//   ns_sort(lst) -> list
//     Returns a new list containing the same elements sorted ascending by
//     ns_compare.  Uses selection sort (O(n^2), stable enough for name lists).
//
// Numeric comparison of digit runs (no integer overflow for arbitrarily long
// digit sequences):
//   1. Strip leading zeros from both digit strings.
//   2. If stripped lengths differ, the shorter is numerically smaller.
//   3. If same stripped length, compare character-by-character (lex == numeric
//      for equal-length decimal strings).
//
// ASCII: '0'=48  '9'=57

// _is_digit: 1 if c is an ASCII digit, 0 otherwise.
fn _is_digit(c) -> int
    let b = ord(c)
    if b >= 48 and b <= 57
        return 1
    0

// _digit_run_end: index one past the run of digits starting at pos in s.
fn _digit_run_end(s, pos, slen) -> int
    let i = pos
    while i < slen and _is_digit(char_at(s, i)) == 1
        i = i + 1
    i

// _strip_leading_zeros: first non-zero digit index in s[start..end_pos),
// but never past end_pos-1 so a run of all zeros yields a single '0'.
fn _strip_leading_zeros(s, start, end_pos) -> int
    let i = start
    while i < end_pos - 1 and ord(char_at(s, i)) == 48
        i = i + 1
    i

// _cmp_digit_runs: compare digit substrings a[a0..a1) vs b[b0..b1).
// Returns -1, 0, or 1.
fn _cmp_digit_runs(a, a0, a1, b, b0, b1) -> int
    let as2 = _strip_leading_zeros(a, a0, a1)
    let bs2 = _strip_leading_zeros(b, b0, b1)
    let alen = a1 - as2
    let blen = b1 - bs2
    if alen < blen
        return -1
    if alen > blen
        return 1
    // Same stripped length: lex order == numeric order.
    let i = 0
    while i < alen
        let ca = ord(char_at(a, as2 + i))
        let cb = ord(char_at(b, bs2 + i))
        if ca < cb
            return -1
        if ca > cb
            return 1
        i = i + 1
    0

// ns_compare: natural sort comparison.  Returns -1, 0, or 1.
fn ns_compare(a, b) -> int
    let na = len(a)
    let nb = len(b)
    let i = 0
    let j = 0
    while i < na and j < nb
        let ca = char_at(a, i)
        let cb = char_at(b, j)
        let da = _is_digit(ca)
        let db = _is_digit(cb)
        if da == 1 and db == 1
            // Both at a digit run -- compare numerically.
            let ae = _digit_run_end(a, i, na)
            let be = _digit_run_end(b, j, nb)
            let cmp = _cmp_digit_runs(a, i, ae, b, j, be)
            if cmp != 0
                return cmp
            i = ae
            j = be
        else
            // Non-digit (or mixed): compare by ordinal.
            let oa = ord(ca)
            let ob = ord(cb)
            if oa < ob
                return -1
            if oa > ob
                return 1
            i = i + 1
            j = j + 1
    // One or both strings exhausted.
    if i < na
        return 1
    if j < nb
        return -1
    0

// _ns_min_idx: index of the minimum element in lst[start..n) by ns_compare.
fn _ns_min_idx(lst, start, n) -> int
    let mi = start
    let i = start + 1
    while i < n
        if ns_compare(lst[i], lst[mi]) == -1
            mi = i
        i = i + 1
    mi

// ns_sort: return a new list sorted ascending by ns_compare.
// Algorithm: selection sort over an index array to avoid in-place list writes.
// We track which positions have been "selected" using a parallel int list,
// then build the output by appending in sorted order.
fn ns_sort(lst) -> list
    let n = len(lst)
    if n <= 1
        let copy = []
        let k = 0
        while k < n
            copy.push(lst[k])
            k = k + 1
        return copy
    // Build a "used" marker list (0 = available, 1 = already placed).
    let used = []
    let k = 0
    while k < n
        used.push(0)
        k = k + 1
    let out = []
    let placed = 0
    while placed < n
        // Find the minimum available element.
        let mi = -1
        let i = 0
        while i < n
            if used[i] == 0
                if mi == -1
                    mi = i
                else
                    if ns_compare(lst[i], lst[mi]) == -1
                        mi = i
            i = i + 1
        out.push(lst[mi])
        // Mark mi as used by rebuilding 'used' with position mi set to 1.
        let new_used = []
        let p = 0
        while p < n
            if p == mi
                new_used.push(1)
            else
                new_used.push(used[p])
            p = p + 1
        used = new_used
        placed = placed + 1
    out

fn main()
    print("std/text/naturalsort loaded")
