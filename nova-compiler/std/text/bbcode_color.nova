// ============================================================================
// NOVA Standard Library — std/text/bbcode_color
// ============================================================================
// Parse and validate BBCode [color=...] attributes.
//
// Recognised value forms:
//   - a named color: red, green, blue, black, white, yellow, orange, purple,
//     gray, brown, pink, cyan (case-insensitive)
//   - a hex triplet: "#RGB" (3 hex digits) or "#RRGGBB" (6 hex digits)
//
// Tag matching ("[color=") is case-insensitive; extracted values keep their
// original casing.
//
// Public API:
//   bcol_is_valid_color(s) -> int
//       1 if s is a recognised named color or a well-formed "#RGB"/"#RRGGBB"
//       hex triplet, 0 otherwise.
//
//   bcol_normalize(s) -> string
//       Lowercase s. If s is a 3-digit hex color ("#abc"), expand it to the
//       6-digit form ("#aabbcc"). Does not validate — malformed input is
//       returned lowercased and otherwise unchanged.
//
//   bcol_extract(bbcode) -> list
//       Scan bbcode left to right for "[color=VALUE]" tags (case-insensitive
//       tag, any content up to the next "]") and return the list of VALUE
//       strings in order of appearance. A "[color=" with no following "]" is
//       skipped (treated as literal text).
//
//   bcol_named_to_hex(name) -> string
//       Convert a named color (case-insensitive) to its "#RRGGBB" hex form.
//       Returns "" if name is not one of the 12 recognised names.
//
// LEAF — imports NOTHING.
// ============================================================================

// _bcol_starts_ci: 1 if s has tag_lower (already lowercase) at position i,
// compared case-insensitively; 0 if out of range or not matching.
fn _bcol_starts_ci(s, i, tag_lower) -> int
    let tlen = len(tag_lower)
    if i + tlen > len(s)
        return 0
    if lower(slice(s, i, i + tlen)) == tag_lower
        return 1
    0

// _bcol_is_hexdigit: 1 if the single char c is 0-9, a-f, or A-F.
fn _bcol_is_hexdigit(c) -> int
    let o = ord(c)
    if o >= 48 and o <= 57
        return 1
    if o >= 97 and o <= 102
        return 1
    if o >= 65 and o <= 70
        return 1
    0

// _bcol_lookup: return the "#RRGGBB" hex for a lowercase named color, or ""
// if name_lower is not one of the 12 recognised names.
fn _bcol_lookup(name_lower) -> string
    let names = ["red", "green", "blue", "black", "white", "yellow", "orange", "purple", "gray", "brown", "pink", "cyan"]
    let hexes = ["#FF0000", "#008000", "#0000FF", "#000000", "#FFFFFF", "#FFFF00", "#FFA500", "#800080", "#808080", "#A52A2A", "#FFC0CB", "#00FFFF"]
    let n = len(names)
    for i in 0..n
        if names[i] == name_lower
            return hexes[i]
    ""

// bcol_is_valid_color(s) -> int
fn bcol_is_valid_color(s) -> int
    let n = len(s)
    if n == 0
        return 0
    if slice(s, 0, 1) == "#"
        let rest = slice(s, 1, n)
        let rn = len(rest)
        if rn != 3 and rn != 6
            return 0
        for i in 0..rn
            if _bcol_is_hexdigit(slice(rest, i, i + 1)) == 0
                return 0
        return 1
    let lc = lower(s)
    if _bcol_lookup(lc) != ""
        return 1
    0

// bcol_normalize(s) -> string
fn bcol_normalize(s) -> string
    let n = len(s)
    if n == 0
        return ""
    let lc = lower(s)
    if slice(lc, 0, 1) == "#"
        let rest = slice(lc, 1, len(lc))
        if len(rest) == 3
            let c0 = slice(rest, 0, 1)
            let c1 = slice(rest, 1, 2)
            let c2 = slice(rest, 2, 3)
            return "#" + c0 + c0 + c1 + c1 + c2 + c2
        return lc
    lc

// bcol_extract(bbcode) -> list
fn bcol_extract(bbcode) -> list
    let out = []
    let n = len(bbcode)
    let i = 0
    while i < n
        if _bcol_starts_ci(bbcode, i, "[color=")
            let vstart = i + 7
            let rest = slice(bbcode, vstart, n)
            let j = find(rest, "]")
            if j >= 0
                let value = slice(bbcode, vstart, vstart + j)
                push(out, value)
                i = vstart + j + 1
            else
                i += 1
        else
            i += 1
    out

// bcol_named_to_hex(name) -> string
fn bcol_named_to_hex(name) -> string
    _bcol_lookup(lower(name))
