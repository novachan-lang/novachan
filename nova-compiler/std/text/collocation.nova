// ============================================================================
// NOVA Standard Library — std/text/collocation
// ============================================================================
// Bigram collocation significance measures: PMI, NPMI, t-score, chi-square,
// log-likelihood, and ranking utilities.
//
// Public API:
//   col_bigrams(tokens)                         -> list   adjacent [w1,w2] pairs
//   col_bigram_freq(tokens)                     -> dict   'w1\x01w2' -> count
//   col_unigram_freq(tokens)                    -> dict   word -> count
//   col_pmi(f_xy,f_x,f_y,n)                     -> float  log2((f_xy*n)/(f_x*f_y))
//   col_npmi(f_xy,f_x,f_y,n)                    -> float  pmi / (-log2(f_xy/n))
//   col_t_score(f_xy,f_x,f_y,n)                 -> float  (f_xy - f_x*f_y/n) / sqrt(f_xy)
//   col_chi_square(f_xy,f_x,f_y,n)              -> float  chi-square association
//   col_log_likelihood(f_xy,f_x,f_y,n)          -> float  G2 log-likelihood ratio
//   col_score_bigram(tokens,w1,w2,measure)       -> float  score a specific bigram
//   col_top_pmi(tokens,topn,min_freq)            -> list   top-n bigrams by PMI
//   col_top_bigrams(tokens,topn)                 -> list   top-n bigrams by raw freq
//   col_filter_by_freq(bigramfreq,minf)          -> dict   filtered bigram freq dict
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _col_log2(x) computes log base-2 of x via natural log.
fn _col_log2(x) -> float
    let ln2 = 0.6931471805599453
    let r = log(x) / ln2
    r

// _col_abs(x) absolute value for float.
fn _col_abs(x) -> float
    if x < 0.0
        return 0.0 - x
    x

// _col_bigram_key builds the separator-joined key for a bigram pair.
fn _col_bigram_key(w1, w2) -> string
    w1 + chr(1) + w2

// _col_max_key_by_int returns the key with the maximum int value in dict d
// given a list of keys; returns "" if keys list is empty.
fn _col_max_key_by_int(d, ks) -> string
    let n = len(ks)
    if n == 0
        return ""
    let best = ks[0]
    let best_v = d[ks[0]]
    for i in 1..n
        let v = d[ks[i]]
        if v > best_v
            best_v = v
            best = ks[i]
    best

// _col_max_key_by_float returns the key in ks with the maximum float value
// stored in dict d (values are floats).  Returns "" if empty.
fn _col_max_key_by_float(d, ks) -> string
    let n = len(ks)
    if n == 0
        return ""
    let best = ks[0]
    let best_v = d[ks[0]]
    for i in 1..n
        let v = d[ks[i]]
        if v > best_v
            best_v = v
            best = ks[i]
    best

// _col_llterm computes the G2 term: 2 * observed * log(observed/expected).
// Returns 0.0 when observed == 0.
fn _col_llterm(obs, exp_val) -> float
    if obs <= 0.0
        return 0.0
    let ratio = obs / exp_val
    let r = 2.0 * obs * log(ratio)
    r

// ── public API ───────────────────────────────────────────────────────────────

// col_bigrams returns a list of adjacent token pairs; each pair is a 2-element list.
// Returns [] when tokens has fewer than 2 elements.
fn col_bigrams(tokens) -> any
    let result = []
    let n = len(tokens)
    for i in 0..(n - 1)
        let pair = [tokens[i], tokens[i + 1]]
        push(result, pair)
    result

// col_bigram_freq returns a dict mapping 'w1\x01w2' to co-occurrence count.
fn col_bigram_freq(tokens) -> any
    let d = {}
    let n = len(tokens)
    for i in 0..(n - 1)
        let k = _col_bigram_key(tokens[i], tokens[i + 1])
        if k in d
            d[k] = d[k] + 1
        else
            d[k] = 1
    d

// col_unigram_freq returns a dict mapping each token to its occurrence count.
fn col_unigram_freq(tokens) -> any
    let d = {}
    let n = len(tokens)
    for i in 0..n
        let w = tokens[i]
        if w in d
            d[w] = d[w] + 1
        else
            d[w] = 1
    d

// col_pmi returns the Pointwise Mutual Information in bits (log base 2).
// PMI = log2((f_xy * n) / (f_x * f_y)).
// Returns 0.0 if any frequency is zero.
fn col_pmi(f_xy, f_x, f_y, n) -> float
    if f_xy <= 0 or f_x <= 0 or f_y <= 0 or n <= 0
        return 0.0
    let num = f_xy * 1.0 * n * 1.0
    let den = f_x * 1.0 * f_y * 1.0
    let r = _col_log2(num / den)
    r

// col_npmi returns normalised PMI in [-1, 1].
// NPMI = PMI / (-log2(f_xy / n)).  Returns 0.0 if denominator is zero.
fn col_npmi(f_xy, f_x, f_y, n) -> float
    if f_xy <= 0 or f_x <= 0 or f_y <= 0 or n <= 0
        return 0.0
    let pmi = col_pmi(f_xy, f_x, f_y, n)
    let ratio = f_xy * 1.0 / (n * 1.0)
    let denom = 0.0 - _col_log2(ratio)
    if denom == 0.0
        return 0.0
    let r = pmi / denom
    r

// col_t_score returns the t-score association measure.
// t = (f_xy - f_x*f_y/n) / sqrt(f_xy).  Returns 0.0 if f_xy == 0.
fn col_t_score(f_xy, f_x, f_y, n) -> float
    if f_xy <= 0 or n <= 0
        return 0.0
    let fxy = f_xy * 1.0
    let expected = (f_x * 1.0 * f_y * 1.0) / (n * 1.0)
    let r = (fxy - expected) / sqrt(fxy)
    r

// col_chi_square returns Pearson chi-square for a 2x2 contingency table.
// Using the standard 4-cell formula for bigram association.
fn col_chi_square(f_xy, f_x, f_y, n) -> float
    if n <= 0
        return 0.0
    // O11=f_xy, O12=f_x-f_xy, O21=f_y-f_xy, O22=n-f_x-f_y+f_xy
    let o11 = f_xy * 1.0
    let o12 = (f_x - f_xy) * 1.0
    let o21 = (f_y - f_xy) * 1.0
    let o22 = (n - f_x - f_y + f_xy) * 1.0
    let fn_total = n * 1.0
    // Row/col marginals
    let r1 = o11 + o12
    let r2 = o21 + o22
    let c1 = o11 + o21
    let c2 = o12 + o22
    if r1 == 0.0 or r2 == 0.0 or c1 == 0.0 or c2 == 0.0
        return 0.0
    // Expected counts
    let e11 = r1 * c1 / fn_total
    let e12 = r1 * c2 / fn_total
    let e21 = r2 * c1 / fn_total
    let e22 = r2 * c2 / fn_total
    // Sum of (O-E)^2/E for each cell
    let chi = 0.0
    if e11 > 0.0
        let d11 = o11 - e11
        chi += (d11 * d11) / e11
    if e12 > 0.0
        let d12 = o12 - e12
        chi += (d12 * d12) / e12
    if e21 > 0.0
        let d21 = o21 - e21
        chi += (d21 * d21) / e21
    if e22 > 0.0
        let d22 = o22 - e22
        chi += (d22 * d22) / e22
    chi

// col_log_likelihood returns the G2 log-likelihood ratio (Dunning 1993).
// G2 = 2 * sum of observed * log(observed/expected) over 4 cells.
fn col_log_likelihood(f_xy, f_x, f_y, n) -> float
    if n <= 0
        return 0.0
    let o11 = f_xy * 1.0
    let o12 = (f_x - f_xy) * 1.0
    let o21 = (f_y - f_xy) * 1.0
    let o22 = (n - f_x - f_y + f_xy) * 1.0
    let fn_total = n * 1.0
    let r1 = o11 + o12
    let r2 = o21 + o22
    let c1 = o11 + o21
    let c2 = o12 + o22
    if r1 == 0.0 or r2 == 0.0 or c1 == 0.0 or c2 == 0.0
        return 0.0
    let e11 = r1 * c1 / fn_total
    let e12 = r1 * c2 / fn_total
    let e21 = r2 * c1 / fn_total
    let e22 = r2 * c2 / fn_total
    let t11 = _col_llterm(o11, e11)
    let t12 = _col_llterm(o12, e12)
    let t21 = _col_llterm(o21, e21)
    let t22 = _col_llterm(o22, e22)
    let g2 = t11 + t12 + t21 + t22
    g2

// col_score_bigram scores a specific (w1, w2) bigram in tokens.
// measure: 'pmi' | 'tscore' | 'chisq' (default returns 0.0 for unknown measure).
fn col_score_bigram(tokens, w1, w2, measure) -> float
    let uf = col_unigram_freq(tokens)
    let bf = col_bigram_freq(tokens)
    let n = len(tokens)
    if n < 2
        return 0.0
    let f_x = 0
    if w1 in uf
        f_x = uf[w1]
    let f_y = 0
    if w2 in uf
        f_y = uf[w2]
    let bk = _col_bigram_key(w1, w2)
    let f_xy = 0
    if bk in bf
        f_xy = bf[bk]
    if f_x == 0 or f_y == 0 or f_xy == 0
        return 0.0
    if measure == "pmi"
        let r = col_pmi(f_xy, f_x, f_y, n)
        return r
    if measure == "tscore"
        let r = col_t_score(f_xy, f_x, f_y, n)
        return r
    if measure == "chisq"
        let r = col_chi_square(f_xy, f_x, f_y, n)
        return r
    0.0

// col_top_pmi returns the top-n bigrams by PMI score, each with count >= min_freq.
// Returns a list of strings (the 'w1\x01w2' keys) sorted by descending PMI.
fn col_top_pmi(tokens, topn, min_freq) -> any
    let uf = col_unigram_freq(tokens)
    let bf = col_bigram_freq(tokens)
    let n = len(tokens)
    if n < 2
        return []
    // Build a dict of bigram_key -> PMI for qualifying bigrams
    let pmi_d = {}
    let bkeys = keys(bf)
    let nb = len(bkeys)
    for i in 0..nb
        let bk = bkeys[i]
        let f_xy = bf[bk]
        if f_xy >= min_freq
            // Extract w1 from the key by scanning for chr(1)
            let klen = len(bk)
            let sep = -1
            let j = 0
            while j < klen
                if ord(slice(bk, j, j + 1)) == 1
                    sep = j
                    j = klen
                j += 1
            if sep >= 0
                let w1 = slice(bk, 0, sep)
                let w2 = slice(bk, sep + 1, klen)
                let f_x = 0
                if w1 in uf
                    f_x = uf[w1]
                let f_y = 0
                if w2 in uf
                    f_y = uf[w2]
                if f_x > 0 and f_y > 0
                    let p = col_pmi(f_xy, f_x, f_y, n)
                    pmi_d[bk] = p
    // Select top-n by repeated argmax (small n expected)
    let result = []
    let remaining = keys(pmi_d)
    let got = 0
    while got < topn
        let rem_len = len(remaining)
        if rem_len == 0
            got = topn
        else
            let best = _col_max_key_by_float(pmi_d, remaining)
            push(result, best)
            // Remove best from remaining
            let next = []
            for k in 0..rem_len
                if remaining[k] != best
                    push(next, remaining[k])
            remaining = next
            got += 1
    result

// col_top_bigrams returns the top-n bigrams by raw frequency.
// Returns a list of bigram keys ('w1\x01w2') sorted by descending count.
fn col_top_bigrams(tokens, topn) -> any
    let bf = col_bigram_freq(tokens)
    let result = []
    let remaining = keys(bf)
    let got = 0
    while got < topn
        let rem_len = len(remaining)
        if rem_len == 0
            got = topn
        else
            let best = _col_max_key_by_int(bf, remaining)
            push(result, best)
            let next = [remaining[k] for k in 0..rem_len if remaining[k] != best]
            remaining = next
            got += 1
    result

// col_filter_by_freq returns a new dict containing only bigram entries with count >= minf.
fn col_filter_by_freq(bigramfreq, minf) -> any
    let out = {}
    let ks = keys(bigramfreq)
    let n = len(ks)
    for i in 0..n
        let k = ks[i]
        let v = bigramfreq[k]
        if v >= minf
            out[k] = v
    out

fn main()
    print("std/text/collocation loaded")
