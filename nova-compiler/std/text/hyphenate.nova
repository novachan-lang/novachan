// std/text/hyphenate -- Heuristic syllable-boundary hyphenation. LEAF -- imports NOTHING.
//
// Rule implemented (deterministic, heuristic — NOT full Knuth-Liang):
//
//   VCCV split: scan left-to-right for positions i where:
//     s[i-1] is a vowel   (V)
//     s[i]   is a consonant (C)
//     s[i+1] is a consonant (C)
//     s[i+2] is a vowel   (V)
//   The break is inserted AFTER s[i] (i.e. between s[i] and s[i+1]).
//   Positions are only eligible when i >= 1 and i+2 < len(s).
//   Multiple non-overlapping breaks are collected left-to-right.
//
//   Vowels: a e i o u (case-insensitive, ASCII only).
//   Consonants: any ASCII letter that is NOT a vowel.
//   Non-letter characters are treated as consonants for safety.
//
// This rule correctly handles doubled-consonant words like:
//   hello -> hel-lo   (e V, l C, l C, o V -> break after pos 2, index 3)
//   pattern -> pat-tern (a V, t C, t C, e V -> break after pos 2, index 3)
//   running -> run-ning (u V, n C, n C, i V -> break after pos 2, index 3)
// And short words / single-syllable words get no break:
//   cat -> cat   (no VCCV window fits)
//
// Public API:
//   hy_points(word: string) -> list   -- 0-based indices before which a break may be inserted
//   hy_syllables(word: string) -> list -- the syllable pieces as strings
//   hy_hyphenate(word: string, sep: string) -> string -- joined with sep at break points

fn _hy_is_vowel(c: string) -> int
    let b = ord(c)
    // lowercase: a=97 e=101 i=105 o=111 u=117
    // uppercase: A=65  E=69  I=73  O=79  U=85
    let lc = b
    if b >= 65 and b <= 90
        lc = b + 32
    if lc == 97
        return 1
    if lc == 101
        return 1
    if lc == 105
        return 1
    if lc == 111
        return 1
    if lc == 117
        return 1
    0

fn _hy_is_letter(c: string) -> int
    let b = ord(c)
    if b >= 65 and b <= 90
        return 1
    if b >= 97 and b <= 122
        return 1
    0

fn hy_points(word: string) -> list
    let n = len(word)
    let pts = []
    // Need at least 4 chars for VCCV window: positions i-1, i, i+1, i+2
    // i ranges from 1 to n-3 inclusive (so i+2 <= n-1)
    if n < 4
        return pts
    let i = 1
    while i <= n - 3
        let cv1 = char_at(word, i - 1)  // position before: must be vowel
        let cc1 = char_at(word, i)      // first consonant
        let cc2 = char_at(word, i + 1)  // second consonant
        let cv2 = char_at(word, i + 2)  // position after: must be vowel
        let v1 = _hy_is_vowel(cv1)
        let c1 = _hy_is_letter(cc1)
        let isvowel1 = _hy_is_vowel(cc1)
        let c2 = _hy_is_letter(cc2)
        let isvowel2 = _hy_is_vowel(cc2)
        let v2 = _hy_is_vowel(cv2)
        // VCCV: prev=vowel, cur=consonant, next=consonant, after=vowel
        let prev_is_v = v1
        let cur_is_c = 0
        if c1 == 1 and isvowel1 == 0
            cur_is_c = 1
        let next_is_c = 0
        if c2 == 1 and isvowel2 == 0
            next_is_c = 1
        let after_is_v = v2
        if prev_is_v == 1 and cur_is_c == 1 and next_is_c == 1 and after_is_v == 1
            // break point is AFTER position i, i.e. before position i+1
            pts.push(i + 1)
            // skip ahead past this window to avoid overlap
            i = i + 2
        else
            i = i + 1
    pts

fn hy_syllables(word: string) -> list
    let pts = hy_points(word)
    let pieces = []
    let n = len(word)
    let prev = 0
    let pi = 0
    let np = len(pts)
    while pi < np
        let bp = pts[pi]
        // slice word from prev to bp (exclusive)
        let piece_parts = []
        let j = prev
        while j < bp
            push(piece_parts, char_at(word, j))
            j = j + 1
        let piece = join(piece_parts, "")
        pieces.push(piece)
        prev = bp
        pi = pi + 1
    // append the tail
    let tail_parts = []
    let k = prev
    while k < n
        push(tail_parts, char_at(word, k))
        k = k + 1
    let tail = join(tail_parts, "")
    pieces.push(tail)
    pieces

fn hy_hyphenate(word: string, sep: string) -> string
    let parts = hy_syllables(word)
    join(parts, sep)
