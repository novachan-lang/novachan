// std/text/leetspeak.nova — leetspeak (1337) transliteration: a fixed,
// deterministic letter<->digit substitution over the six characters
// a/e/i/o/s/t (case-insensitive on encode). Distinct from std/text/rot13,
// std/cipher/caesar and std/cipher/vigenere (those are substitution CIPHERS
// keyed by a shift/key with the goal of obscuring meaning); leetspeak is a
// fixed, unkeyed, non-cryptographic stylistic transform.
// LEAF — imports NOTHING.
//
// Substitution table (encode direction, case-insensitive on the input
// letter): a->4, e->3, i->1, o->0, s->5, t->7. Every other character
// (including consonants like 'l' and all digits/punctuation) passes
// through unchanged, PRESERVING ITS ORIGINAL CASE.
//
// The decode table is the exact inverse of the six digit mappings above
// (4->a, 3->e, 1->i, 0->o, 5->s, 7->t, always producing lowercase); any
// other character passes through unchanged. Because encode lowercases the
// six substituted letters, decode(encode(x)) is a byte-exact round trip
// only when x's a/e/i/o/s/t characters were already lowercase (case on
// non-substituted characters is always preserved through both directions).
//
// PUBLIC API:
//   lspk_encode(s)          -> string  substitute a/e/i/o/s/t -> digits
//   lspk_decode(s)          -> string  substitute digits -> a/e/i/o/s/t (lowercase)
//   lspk_is_leet_char(c)    -> bool    true iff c is a substitutable letter
//                                      (case-insensitive) or one of its digits
//   lspk_count_subs(s)      -> int     count of characters lspk_encode would substitute
//   lspk_leetness_score(s)  -> float   lspk_count_subs(s) / len(s); 0.0 if s is empty
//
// KNOWN-ANSWER EXAMPLES:
//   lspk_encode("leet")      == "l337"
//   lspk_encode("test")      == "7357"
//   lspk_encode("HELLO")     == "H3LL0"     (case preserved on non-substituted chars)
//   lspk_decode("7357")      == "test"
//   lspk_decode("l337")      == "leet"
//   lspk_decode("H3LL0")     == "HeLLo"     (lossy: substituted chars come back lowercase)
//   lspk_is_leet_char("A")   == true
//   lspk_is_leet_char("4")   == true
//   lspk_is_leet_char("b")   == false
//   lspk_count_subs("hello") == 2           (e, o)
//   lspk_leetness_score("hello") == 0.4

// _lspk_lower — lowercase a single ASCII character; anything else unchanged.
fn _lspk_lower(c)
    let b = ord(c)
    if b >= 65 and b <= 90
        return chr(b + 32)
    return c

// lspk_encode — substitute a/e/i/o/s/t (case-insensitive) with digits.
fn lspk_encode(s)
    let out = []
    let n = len(s)
    for i in 0..n
        let c = slice(s, i, i + 1)
        let lc = _lspk_lower(c)
        if lc == "a"
            push(out, "4")
        else
            if lc == "e"
                push(out, "3")
            else
                if lc == "i"
                    push(out, "1")
                else
                    if lc == "o"
                        push(out, "0")
                    else
                        if lc == "s"
                            push(out, "5")
                        else
                            if lc == "t"
                                push(out, "7")
                            else
                                push(out, c)
    return join(out, "")

// lspk_decode — substitute the six leet digits back to lowercase letters.
fn lspk_decode(s)
    let out = []
    let n = len(s)
    let i = 0
    while i < n
        let c = slice(s, i, i + 1)
        if c == "4"
            push(out, "a")
        else
            if c == "3"
                push(out, "e")
            else
                if c == "1"
                    push(out, "i")
                else
                    if c == "0"
                        push(out, "o")
                    else
                        if c == "5"
                            push(out, "s")
                        else
                            if c == "7"
                                push(out, "t")
                            else
                                push(out, c)
        i += 1
    return join(out, "")

// lspk_is_leet_char — true iff c is a/e/i/o/s/t (case-insensitive) or one
// of the six leet digits 4/3/1/0/5/7.
fn lspk_is_leet_char(c)
    let lc = _lspk_lower(c)
    if lc == "a" or lc == "e" or lc == "i" or lc == "o" or lc == "s" or lc == "t"
        return true
    if c == "4" or c == "3" or c == "1" or c == "0" or c == "5" or c == "7"
        return true
    return false

// lspk_count_subs — count of characters in s that lspk_encode would substitute.
fn lspk_count_subs(s)
    let n = len(s)
    let i = 0
    let count = 0
    while i < n
        let c = slice(s, i, i + 1)
        let lc = _lspk_lower(c)
        if lc == "a" or lc == "e" or lc == "i" or lc == "o" or lc == "s" or lc == "t"
            count += 1
        i += 1
    return count

// lspk_leetness_score — fraction of s's characters that get substituted.
fn lspk_leetness_score(s)
    let n = len(s)
    if n == 0
        return 0.0
    let c = lspk_count_subs(s)
    return (c * 1.0) / (n * 1.0)
