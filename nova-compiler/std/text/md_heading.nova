// std/text/md_heading -- ATX Markdown heading -> HTML conversion. LEAF -- imports NOTHING.
//
// Public API:
//   md_heading(line: string) -> string
//     Converts a single ATX heading line to an HTML heading element.
//     A heading is 1-6 '#' characters followed by a space, then the heading text.
//     Returns "<h1>text</h1>" .. "<h6>text</h6>" accordingly.
//     If the line is NOT a valid ATX heading, returns "" (empty string).
//
// ATX heading rules applied here:
//   - Must start with 1-6 '#' characters (exactly; 7+ is not a heading).
//   - The '#' run must be followed by exactly one space ' '.
//   - The heading text is everything after the "# " prefix.
//   - Trailing '#' are NOT stripped (not required by the KAT spec).
//   - Escape of HTML special chars is NOT required per the KAT spec.

// PRIVATE: count leading '#' chars in s. Returns 0..n.
fn _mdh_count_hashes(s: string) -> int
    let n = len(s)
    let i = 0
    while i < n
        if slice(s, i, i + 1) != "#"
            return i
        i += 1
    return i

fn md_heading(line: string) -> string
    let n = len(line)
    if n == 0
        return ""
    let level = _mdh_count_hashes(line)
    // Must be 1-6 hashes
    if level < 1 or level > 6
        return ""
    // Must be followed by a space
    if level >= n
        return ""
    if slice(line, level, level + 1) != " "
        return ""
    // Text is everything after the "# " prefix
    let text = slice(line, level + 1, n)
    let lv = str(level)
    return "<h" + lv + ">" + text + "</h" + lv + ">"
