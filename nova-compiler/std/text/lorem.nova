// ============================================================================
// NOVA Standard Library — std/text/lorem
// ============================================================================
// Deterministic lorem-ipsum text generation.
//
// Uses std/util/prng (xorshift64) for reproducibility: same seed -> identical
// output every time. State is threaded explicitly — no mutable globals.
//
// Vocabulary: 20 classic lorem-ipsum words (indices 0-19).
//
// Public API:
//   lo_words(n, state) -> [string, newstate]
//       n space-joined words drawn from the vocabulary via prng.
//       n <= 0 returns ["", newstate] (one prng step consumed).
//
//   lo_sentence(state) -> [string, newstate]
//       6-word sentence, first letter capitalised, ends with ".".
//
//   lo_paragraph(nsent, state) -> [string, newstate]
//       nsent sentences joined by a single space.
//       nsent <= 0 returns ["", state] (no steps consumed).
// ============================================================================

import std/util/prng

// Map index 0-19 to a lorem word via if-chain (avoids module-level list issues).
fn _lo_vocab(i: int) -> string
    if i == 0 then return "lorem"
    if i == 1 then return "ipsum"
    if i == 2 then return "dolor"
    if i == 3 then return "sit"
    if i == 4 then return "amet"
    if i == 5 then return "consectetur"
    if i == 6 then return "adipiscing"
    if i == 7 then return "elit"
    if i == 8 then return "sed"
    if i == 9 then return "do"
    if i == 10 then return "eiusmod"
    if i == 11 then return "tempor"
    if i == 12 then return "incididunt"
    if i == 13 then return "ut"
    if i == 14 then return "labore"
    if i == 15 then return "et"
    if i == 16 then return "dolore"
    if i == 17 then return "magna"
    if i == 18 then return "aliqua"
    "enim"

// Return 1 if word w is one of the 20 lorem vocab words, else 0.
// Used for KAT assertions in tests.
fn lo_in_vocab(w: string) -> int
    if w == "lorem" then return 1
    if w == "ipsum" then return 1
    if w == "dolor" then return 1
    if w == "sit" then return 1
    if w == "amet" then return 1
    if w == "consectetur" then return 1
    if w == "adipiscing" then return 1
    if w == "elit" then return 1
    if w == "sed" then return 1
    if w == "do" then return 1
    if w == "eiusmod" then return 1
    if w == "tempor" then return 1
    if w == "incididunt" then return 1
    if w == "ut" then return 1
    if w == "labore" then return 1
    if w == "et" then return 1
    if w == "dolore" then return 1
    if w == "magna" then return 1
    if w == "aliqua" then return 1
    if w == "enim" then return 1
    0

// Split a string on spaces and return a list of tokens.
// Empty tokens (consecutive spaces) are skipped.
fn _lo_split_spaces(s: string) -> list
    let out = []
    let cur = ""
    let i = 0
    let n = len(s)
    while i < n
        let c = char_at(s, i)
        if c == " "
            if len(cur) > 0
                out = out + [cur]
                cur = ""
        else
            cur = cur + c
        i = i + 1
    if len(cur) > 0
        out = out + [cur]
    out

// Draw n words from the vocabulary using prng, joined by spaces.
// Returns [joined_string, new_prng_state].
// n <= 0: advances state once and returns "".
fn lo_words(n: int, state: int)
    if n <= 0
        let adv = prng_range(state, 0, 19)
        return ["", adv[1]]
    let st = state
    let result = ""
    let i = 0
    while i < n
        let step = prng_range(st, 0, 19)
        let idx = step[0]
        st = step[1]
        let w = _lo_vocab(idx)
        if i == 0
            result = w
        else
            result = result + " " + w
        i = i + 1
    [result, st]

// Generate a sentence: 6 words, first letter uppercased, ends with ".".
// Returns [sentence_string, new_prng_state].
fn lo_sentence(state: int)
    let r = lo_words(6, state)
    let s = r[0]
    let st = r[1]
    let first = upper(char_at(s, 0))
    let rest = slice(s, 1, len(s))
    let sentence = first + rest + "."
    [sentence, st]

// Generate a paragraph of nsent sentences, joined by spaces.
// Returns [paragraph_string, new_prng_state].
// nsent <= 0: returns ["", state].
fn lo_paragraph(nsent: int, state: int)
    if nsent <= 0
        return ["", state]
    let st = state
    let para = ""
    let i = 0
    while i < nsent
        let sr = lo_sentence(st)
        let s = sr[0]
        st = sr[1]
        if i == 0
            para = s
        else
            para = para + " " + s
        i = i + 1
    [para, st]
