// std/text/titlecase -- Title-casing with small-word rules.
// tc_title(s) -> string: capitalize each word, but keep a fixed set of
// "small" words (articles, prepositions, conjunctions) lowercase unless
// they are the first or last word of the title.  Splits on spaces.
// LEAF -- imports NOTHING.

// The canonical small-word set (APA / Chicago hybrid).
fn _tc_is_small(w: string) -> int
    if w == "a" then return 1
    if w == "an" then return 1
    if w == "and" then return 1
    if w == "as" then return 1
    if w == "at" then return 1
    if w == "but" then return 1
    if w == "by" then return 1
    if w == "for" then return 1
    if w == "if" then return 1
    if w == "in" then return 1
    if w == "of" then return 1
    if w == "on" then return 1
    if w == "or" then return 1
    if w == "the" then return 1
    if w == "to" then return 1
    if w == "via" then return 1
    return 0

// Capitalize first character of w, lowercase the rest.
fn _tc_cap(w: string) -> string
    if len(w) == 0
        return w
    return upper(slice(w, 0, 1)) + lower(slice(w, 1, len(w)))

// tc_title("the lord of the rings") -> "The Lord of the Rings"
// First and last words are always capitalized regardless of small-word status.
// All other words: capitalize unless in the small-word set.
fn tc_title(s: string) -> string
    let words = split(s, " ")
    let n = len(words)
    if n == 0
        return s
    let out = ""
    for i in 0..n
        let w = lower(words[i])
        let word_out = ""
        if i == 0
            word_out = _tc_cap(w)
        else
            if i == n - 1
                word_out = _tc_cap(w)
            else
                if _tc_is_small(w) == 1
                    word_out = w
                else
                    word_out = _tc_cap(w)
        if i == 0
            out = word_out
        else
            out = out + " " + word_out
    return out
