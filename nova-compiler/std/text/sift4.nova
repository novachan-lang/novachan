// ============================================================================
// NOVA Standard Library — std/text/sift4
// ============================================================================
// SIFT4 string distance — the "Simplest" variant by Siderite Zackwehdex (2014).
//
// Public API:
//   sf_distance(a, b, maxoffset) -> int
//       Approximate edit distance. Walks both strings with two cursors c1, c2
//       counting matching runs (lcss). On a mismatch it searches within
//       maxoffset positions on each side for a resync point. Returns
//       max(|a|, |b|) - lcss.
//
//   sf_similarity(a, b, maxoffset) -> float
//       Normalised similarity in [0.0, 1.0].
//       Returns 1 - sf_distance(a, b, maxoffset) / max(|a|, |b|).
//       Both empty -> 1.0.
//
// Algorithm — SIFT4 "Simplest":
//   lcss = 0, c1 = 0, c2 = 0
//   while c1 < |a| and c2 < |b|:
//     if a[c1] == b[c2]:
//       lcss += 1; c1 += 1; c2 += 1
//     else:
//       // search left side: try advancing c1 up to maxoffset steps
//       for i in 0..maxoffset:
//         if c1+i < |a| and a[c1+i] == b[c2]:
//           c1 += i; break
//       // search right side: try advancing c2 up to maxoffset steps
//       for i in 0..maxoffset:
//         if c2+i < |b| and a[c1] == b[c2+i]:
//           c2 += i; break
//       // if no resync found on either side, advance both
//       if a[c1] != b[c2]:
//         c1 += 1; c2 += 1
//   distance = max(|a|, |b|) - lcss
//
// KAT vectors (hand-computed against reference implementation):
//   sf_distance("abc","abc",5)      == 0
//   sf_distance("","abc",5)         == 3
//   sf_distance("abc","",5)         == 3
//   sf_distance("a","b",5)          == 1
//   sf_distance("London","Lond",5)  == 2
//   sf_distance("Chicago","Chicago",5) == 0
//   sf_similarity("abc","abc",5)    == 1.0
//
// LEAF — imports nothing.
// ============================================================================

// sf_distance returns the SIFT4 approximate edit distance between a and b.
// maxoffset is the window size for resync search (recommended: 5).
fn sf_distance(a, b, maxoffset) -> int
    let la = len(a)
    let lb = len(b)

    // Base cases
    if la == 0
        return lb
    if lb == 0
        return la

    // Two cursors and the longest-common-subsequence run count.
    let c1 = 0
    let c2 = 0
    let lcss = 0

    while c1 < la and c2 < lb
        let ca = ord(a[c1])
        let cb = ord(b[c2])
        if ca == cb
            lcss += 1
            c1 += 1
            c2 += 1
        if c1 < la and c2 < lb
            let ca2 = ord(a[c1])
            let cb2 = ord(b[c2])
            if ca2 != cb2
                // Search left side: advance c1 up to maxoffset to match b[c2].
                let found_left = 0
                let i = 1
                while i < maxoffset and found_left == 0
                    let p = c1 + i
                    if p < la
                        let cp = ord(a[p])
                        if cp == cb2
                            c1 = p
                            found_left = 1
                    i += 1

                // Search right side: advance c2 up to maxoffset to match a[c1].
                let found_right = 0
                let ca3 = ord(a[c1])
                let j = 1
                while j < maxoffset and found_right == 0
                    let q = c2 + j
                    if q < lb
                        let cq = ord(b[q])
                        if ca3 == cq
                            c2 = q
                            found_right = 1
                    j += 1

                // If still no match after search, advance both cursors.
                let ca4 = ord(a[c1])
                let cb4 = ord(b[c2])
                if ca4 != cb4
                    c1 += 1
                    c2 += 1

    // distance = max(la, lb) - lcss
    let maxlen = la
    if lb > maxlen
        maxlen = lb
    let dist = maxlen - lcss
    dist

// sf_similarity returns a normalised similarity score in [0.0, 1.0].
// Both empty strings yield 1.0.
fn sf_similarity(a, b, maxoffset) -> float
    let la = len(a)
    let lb = len(b)
    let maxlen = la
    if lb > maxlen
        maxlen = lb
    if maxlen == 0
        return 1.0
    let dist = sf_distance(a, b, maxoffset)
    let distf = dist * 1.0
    let maxf = maxlen * 1.0
    let result = 1.0 - distf / maxf
    result

fn main()
    print("std/text/sift4 loaded")
