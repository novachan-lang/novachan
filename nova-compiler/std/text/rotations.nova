// ============================================================================
// NOVA Standard Library — std/text/rotations
// ============================================================================
// String rotation utilities. A "left rotation by k" shifts every character
// k positions to the left (wrapping around), so rotate("abcde", 2) == "cdeab".
//
// Public API:
//   rt_rotate(s, k)       -> str   rotate s left by k positions (k may exceed len)
//   rt_is_rotation(a, b)  -> bool  true iff b is some left rotation of a
//   rt_all(s)             -> list  all len(s) distinct left rotations of s
//   rt_least(s)           -> str   lexicographically smallest rotation of s
//
// Complexity:
//   rt_rotate      — O(n)
//   rt_is_rotation — O(n²) via double-string substring search
//   rt_all         — O(n²) total (n rotations each O(n))
//   rt_least       — O(n²) scan across all rotations
//
// Private helpers are prefixed _rt_ to avoid collisions with other modules.
// ============================================================================

// ── _rt_substr_at ─────────────────────────────────────────────────────────────
// Return 1 if haystack contains needle starting at position pos, else 0.
// Caller guarantees pos + len(needle) <= len(haystack).
// Uses a done-flag to break early on mismatch (avoids IR label generation bugs
// from assigning the loop counter inside a nested if-body).
fn _rt_substr_at(haystack, needle, pos) -> int
    let m = len(needle)
    let ok = 1
    let i = 0
    let done = 0
    while i < m
        if done == 0
            let hc = slice(haystack, pos + i, pos + i + 1)
            let nc = slice(needle, i, i + 1)
            if hc != nc
                ok = 0
                done = 1
        i += 1
    ok

// ── _rt_contains ──────────────────────────────────────────────────────────────
// Return 1 if haystack contains needle as a substring, else 0.
// Used internally by rt_is_rotation.
fn _rt_contains(haystack, needle) -> int
    let n = len(haystack)
    let m = len(needle)
    if m == 0
        return 1
    if m > n
        return 0
    let found = 0
    let i = 0
    let limit = n - m
    while i <= limit
        if found == 0
            let hit = _rt_substr_at(haystack, needle, i)
            if hit == 1
                found = 1
        i += 1
    found

// ── rt_rotate ─────────────────────────────────────────────────────────────────
// Rotate s left by k positions. k is reduced modulo len(s) so any non-negative
// k is valid. Returns s unchanged when len(s) == 0.
//
//   rt_rotate("abcde", 2) == "cdeab"
//   rt_rotate("abcde", 0) == "abcde"
//   rt_rotate("abcde", 7) == "cdeab"   (7 % 5 == 2)
fn rt_rotate(s, k) -> str
    let n = len(s)
    if n == 0
        return s
    let r = k % n
    if r == 0
        return s
    let tail = slice(s, r, n)
    let head = slice(s, 0, r)
    tail + head

// ── rt_is_rotation ────────────────────────────────────────────────────────────
// Return true (1) iff b is some left rotation of a.
// Two strings are rotation-equivalent iff they have the same length and b
// appears as a substring of a+a.
//
//   rt_is_rotation("abcde", "cdeab") == true
//   rt_is_rotation("abcde", "abced") == false
fn rt_is_rotation(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    if na == 0
        return 1
    let doubled = a + a
    _rt_contains(doubled, b)

// ── rt_all ────────────────────────────────────────────────────────────────────
// Return a list of all len(s) left rotations of s in order:
//   rotation 0 (identity), rotation 1, ..., rotation len(s)-1.
// Returns [""] for the empty string.
//
//   rt_all("abc") == ["abc", "bca", "cab"]
fn rt_all(s) -> list
    let n = len(s)
    let result = []
    if n == 0
        result.push(s)
        return result
    for i in 0..n
        let r = rt_rotate(s, i)
        result.push(r)
    result

// ── _rt_lex_lt ────────────────────────────────────────────────────────────────
// Return 1 if string x is lexicographically strictly less than string y,
// else 0. Compares character by character up to the shorter length; shorter
// string is less if it is a prefix of the longer.
fn _rt_lex_lt(x, y) -> int
    let nx = len(x)
    let ny = len(y)
    let limit = nx
    if ny < limit
        limit = ny
    let i = 0
    let result = 0
    let decided = 0
    while i < limit
        if decided == 0
            let cx = slice(x, i, i + 1)
            let cy = slice(y, i, i + 1)
            if cx < cy
                result = 1
                decided = 1
            else
                if cx > cy
                    decided = 1
        i += 1
    if decided == 0
        if nx < ny
            result = 1
    result

// ── rt_least ──────────────────────────────────────────────────────────────────
// Return the lexicographically smallest rotation of s.
// Scans all rotations and keeps a running minimum.
//
//   rt_least("bca") == "abc"
//   rt_least("cba") == "acb"
fn rt_least(s) -> str
    let n = len(s)
    if n == 0
        return s
    let best = s
    for i in 1..n
        let r = rt_rotate(s, i)
        let lt = _rt_lex_lt(r, best)
        if lt == 1
            best = r
    best

// ============================================================================
fn main()
    print("std/text/rotations loaded")
