// ============================================================================
// NOVA Standard Library — std/text/hamming
// ============================================================================
// Hamming distance utilities: character-level string distance and bit-level
// integer distance (popcount of XOR). All functions are pure, no I/O.
//
// Public API:
//   ham_distance(a, b)          -> int   character-position difference count;
//                                        -1 if lengths differ
//   ham_distance_bits(x, y)     -> int   popcount of x XOR y (bit-level Hamming)
//   ham_similar(a, b, maxdist)  -> bool  true iff ham_distance(a,b) <= maxdist
//
// Complexity:
//   ham_distance      — O(n) single pass over character positions
//   ham_distance_bits — O(1) via native popcount builtin (LLVM ctpop i64)
//   ham_similar       — O(n) with early-exit once distance budget is exceeded

// ── ham_distance ─────────────────────────────────────────────────────────────

// ham_distance counts the number of character positions where a and b differ.
// Hamming distance is only defined for equal-length strings; returns -1 when
// lengths disagree so the caller can detect the error without exceptions.
fn ham_distance(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return -1
    let count = 0
    let i = 0
    while i < na
        if ord(a[i]) != ord(b[i])
            count = count + 1
        i = i + 1
    count

// ── ham_distance_bits ────────────────────────────────────────────────────────

// ham_distance_bits returns the number of bit positions where x and y differ,
// i.e. popcount(x XOR y). Delegates to the native popcount builtin which
// compiles to a single LLVM ctpop i64 instruction. Handles negative XOR
// results (sign bit set) correctly because popcount operates on the raw bit
// pattern of the i64, so a negative XOR value just means bit 63 is set.
fn ham_distance_bits(x, y) -> int
    let xv = x ^ y
    popcount(xv)

// ── ham_similar ──────────────────────────────────────────────────────────────

// ham_similar returns 1 (true) iff the Hamming distance between a and b is at
// most maxdist. Uses an early-exit loop: as soon as the running count exceeds
// maxdist the function returns 0 immediately, avoiding the rest of the scan.
// Returns 0 (false) if lengths differ, since Hamming is undefined there.
fn ham_similar(a, b, maxdist) -> int
    let na = len(a)
    let nb = len(b)
    if na != nb
        return 0
    let count = 0
    let i = 0
    while i < na
        if ord(a[i]) != ord(b[i])
            count = count + 1
        if count > maxdist
            return 0
        i = i + 1
    1

// ============================================================================
fn main()
    print("std/text/hamming loaded")
