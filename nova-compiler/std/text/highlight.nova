// ============================================================================
// NOVA Standard Library — std/text/highlight
// ============================================================================
// Keyword highlighting / marking in text.  Pure NOVA, no libc, no builtins
// beyond find / slice / len / split / contains.
//
// Public API:
//   hl_mark(text, keyword, pre, post) -> str
//       Wrap every non-overlapping left-to-right occurrence of `keyword` in
//       `text` with `pre` prepended and `post` appended.
//       Empty keyword or empty text -> text unchanged.
//
//   hl_mark_all(text, keywords, pre, post) -> str
//       Apply hl_mark sequentially for each keyword in the list (left to right
//       in list order).  Each keyword is marked independently in the result of
//       the previous pass.
//
//   hl_count(text, keyword) -> int
//       Count non-overlapping occurrences of `keyword` in `text` (left to
//       right, advancing past each match by len(keyword) so overlapping hits
//       are not double-counted).
//       Empty keyword -> 0.
// ============================================================================

// ── hl_mark ─────────────────────────────────────────────────────────────────
// Walk `text` from left to right; every time `keyword` is found (via find()),
// emit the gap before the match, then pre+keyword+post, then continue from
// the character after the match.  Remaining tail after the last match is
// appended verbatim.
fn hl_mark(text, keyword, pre, post) -> str
    let klen = len(keyword)
    if klen == 0
        return text
    let n = len(text)
    if n == 0
        return text
    let out = ""
    let pos = 0
    while pos <= n - klen
        let rest = slice(text, pos, n)
        let idx = find(rest, keyword)
        if idx < 0
            // no more matches: append remainder and stop
            out = out + slice(text, pos, n)
            return out
        // gap before the match
        out = out + slice(text, pos, pos + idx)
        // the wrapped match
        out = out + pre + keyword + post
        pos = pos + idx + klen
    // tail beyond the last possible match position
    out = out + slice(text, pos, n)
    out

// ── hl_mark_all ─────────────────────────────────────────────────────────────
// Apply hl_mark once per keyword in the list, threading the result through.
// Order matters: earlier keywords in the list are marked first, so their
// pre/post markers become part of the text when later keywords are scanned.
fn hl_mark_all(text, keywords, pre, post) -> str
    let result = text
    let i = 0
    let n = len(keywords)
    while i < n
        result = hl_mark(result, keywords[i], pre, post)
        i = i + 1
    result

// ── hl_count ────────────────────────────────────────────────────────────────
// Non-overlapping left-to-right count.  After each match we advance the scan
// position by klen (not by 1), so "aaaa" with keyword "aa" gives 2, not 3.
fn hl_count(text, keyword) -> int
    let klen = len(keyword)
    if klen == 0
        return 0
    let n = len(text)
    let count = 0
    let pos = 0
    while pos <= n - klen
        let rest = slice(text, pos, n)
        let idx = find(rest, keyword)
        if idx < 0
            return count
        count = count + 1
        pos = pos + idx + klen
    count
