// ============================================================================
// NOVA Standard Library — std/text/bbcode_url
// ============================================================================
// BBCode [url] link handling: extraction, construction, safety checks.
//
// Supported forms:
//   [url=http://example.com]link text[/url]   -> attribute form (URL in "=")
//   [url]http://example.com[/url]              -> bare form (URL is content)
//
// Public API:
//   burl_extract_urls(input)          -> list   all URLs found (both forms)
//   burl_build(url, text)             -> str    build a [url] tag
//   burl_is_safe(url)                 -> int    1 if http(s):// scheme, else 0
//   burl_count(input)                 -> int    number of [url] opening tags
//   burl_replace_urls(input, repl)    -> str    swap URL content, keep tags
//
// Algorithm: single left-to-right scan for the literal "[url" marker.
//   After the marker we branch on the next character:
//     '='  -> attribute form: read up to the next ']' for the URL, then skip
//             forward past the matching "[/url]" (content is untouched).
//     ']'  -> bare form: the URL is the text up to the matching "[/url]".
//   Any other character, or a missing closing tag, falls back to treating
//   "[url" as literal text so malformed input never causes data loss.
// ============================================================================

// Internal: find the next occurrence of needle in s starting at position start.
// Returns the index, or -1 if not found.
fn _burl_find_from(s, needle, start) -> int
    let n = len(s)
    let nl = len(needle)
    let i = start
    let result = -1
    while i + nl <= n and result == -1
        let cand = slice(s, i, i + nl)
        if cand == needle
            result = i
        i = i + 1
    result

// Internal: 1 if s starts with prefix, else 0.
fn _burl_starts_with(s, prefix) -> int
    let plen = len(prefix)
    if len(s) < plen
        return 0
    if slice(s, 0, plen) == prefix
        return 1
    0

// burl_extract_urls returns a list of every URL found in [url=X]...[/url]
// and [url]X[/url] tags, in left-to-right order.
fn burl_extract_urls(input) -> any
    let out = []
    let n = len(input)
    let i = 0
    while i < n
        if i + 4 <= n and slice(input, i, i + 4) == "[url"
            let after = i + 4
            if after < n and slice(input, after, after + 1) == "="
                let close_eq = _burl_find_from(input, "]", after + 1)
                if close_eq >= 0
                    let url = slice(input, after + 1, close_eq)
                    push(out, url)
                    let close_tag = _burl_find_from(input, "[/url]", close_eq + 1)
                    if close_tag >= 0
                        i = close_tag + 6
                    else
                        i = close_eq + 1
                else
                    i = after
            else
                if after < n and slice(input, after, after + 1) == "]"
                    let close_tag = _burl_find_from(input, "[/url]", after + 1)
                    if close_tag >= 0
                        let url = slice(input, after + 1, close_tag)
                        push(out, url)
                        i = close_tag + 6
                    else
                        i = after + 1
                else
                    i = i + 1
        else
            i = i + 1
    out

// burl_build wraps url/text in a [url] tag. When text is empty, emits the
// bare form [url]url[/url]; otherwise the attribute form [url=url]text[/url].
fn burl_build(url, text) -> str
    if text == ""
        return "[url]" + url + "[/url]"
    "[url=" + url + "]" + text + "[/url]"

// burl_is_safe returns 1 when url begins with "http://" or "https://",
// and 0 for every other scheme (javascript:, data:, vbscript:, relative
// paths, or anything else) — a basic XSS-prevention gate.
fn burl_is_safe(url) -> int
    if _burl_starts_with(url, "http://") == 1
        return 1
    if _burl_starts_with(url, "https://") == 1
        return 1
    0

// burl_count returns the number of [url] opening tags (both bare and
// attribute forms) in input.
fn burl_count(input) -> int
    let n = len(input)
    let i = 0
    let count = 0
    while i < n
        if i + 4 <= n and slice(input, i, i + 4) == "[url"
            let after = i + 4
            let c = ""
            if after < n
                c = slice(input, after, after + 1)
            if c == "=" or c == "]"
                count = count + 1
                i = after + 1
            else
                i = i + 1
        else
            i = i + 1
    count

// burl_replace_urls swaps every URL's content for `replacement`, leaving
// the surrounding tag structure (and, for the attribute form, the link
// text) untouched.
fn burl_replace_urls(input, replacement) -> str
    let out = ""
    let n = len(input)
    let i = 0
    while i < n
        if i + 4 <= n and slice(input, i, i + 4) == "[url"
            let after = i + 4
            if after < n and slice(input, after, after + 1) == "="
                let close_eq = _burl_find_from(input, "]", after + 1)
                if close_eq >= 0
                    out = out + "[url=" + replacement + "]"
                    i = close_eq + 1
                else
                    out = out + "[url"
                    i = after
            else
                if after < n and slice(input, after, after + 1) == "]"
                    let close_tag = _burl_find_from(input, "[/url]", after + 1)
                    if close_tag >= 0
                        out = out + "[url]" + replacement + "[/url]"
                        i = close_tag + 6
                    else
                        out = out + "[url]"
                        i = after + 1
                else
                    out = out + slice(input, i, i + 1)
                    i = i + 1
        else
            out = out + slice(input, i, i + 1)
            i = i + 1
    out
