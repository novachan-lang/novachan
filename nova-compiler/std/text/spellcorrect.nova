// ============================================================================
// NOVA Standard Library — std/text/spellcorrect
// ============================================================================
// Norvig-style spelling correction using edit-distance candidates.
//
// Public API:
//   sp_edits1(word) -> any            all edit-distance-1 candidates (strings)
//   sp_known(words, dict) -> any      subset of words list present in dict
//   sp_edit_distance(a, b) -> int     Levenshtein distance
//   sp_candidates(word, dict) -> any  known(edits1) or known(edits2) or [word]
//   sp_correct(word, dict) -> string  highest-frequency candidate
//   sp_build_dict(words) -> any       dict word->count from token list
//   sp_is_correct(word, dict) -> bool word in dict
//   sp_suggestions(word, dict, k) -> any  top-k candidates by frequency
//   sp_edits2_count(word) -> int      size of the edit-distance-2 set
//   sp_probability(word, dict) -> float  count/total
//   sp_add_word(dict, word) -> any    add/increment word in dict; return dict
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Return 1 if byte code b is a lowercase ASCII letter.
fn _sp_is_lower(b) -> int
    if b >= 97 and b <= 122
        return 1
    0

// Return 1 if byte code b is ASCII letter (upper or lower).
fn _sp_is_alpha(b) -> int
    if b >= 65 and b <= 90
        return 1
    if b >= 97 and b <= 122
        return 1
    0

// Lowercase a string.
fn _sp_lower(s) -> str
    let out = ""
    let n = len(s)
    let i = 0
    while i < n
        let b = ord(s[i])
        if b >= 65 and b <= 90
            out = out + chr(b + 32)
        else
            out = out + s[i]
        i = i + 1
    out

// Produce a string with character at position i removed.
fn _sp_delete_at(s, pos) -> str
    let n = len(s)
    let out = ""
    let i = 0
    while i < n
        if i != pos
            out = out + s[i]
        i = i + 1
    out

// Produce a string with characters at pos and pos+1 swapped.
fn _sp_swap_at(s, pos) -> str
    let n = len(s)
    let out = ""
    let i = 0
    while i < n
        if i == pos
            out = out + s[pos + 1]
        else
            if i == pos + 1
                out = out + s[pos]
            else
                out = out + s[i]
        i = i + 1
    out

// Produce a string with character at pos replaced by the char with code c.
fn _sp_replace_at(s, pos, c) -> str
    let n = len(s)
    let out = ""
    let i = 0
    while i < n
        if i == pos
            out = out + chr(c)
        else
            out = out + s[i]
        i = i + 1
    out

// Insert character with code c before position pos in s.
fn _sp_insert_at(s, pos, c) -> str
    let n = len(s)
    let out = ""
    let i = 0
    while i < pos
        out = out + s[i]
        i = i + 1
    out = out + chr(c)
    while i < n
        out = out + s[i]
        i = i + 1
    out

// Add word to seen-dict (as a de-duplicating set) and to result list.
// Returns 1 if it was new (not already in seen).
fn _sp_add_unique(result, seen, word) -> int
    if contains(seen, word) == 1
        return 0
    seen[word] = 1
    push(result, word)
    1

// ── public API ───────────────────────────────────────────────────────────────

// Generate all strings within edit-distance 1 of word.
// Operations: delete one char, transpose adjacent chars, replace a char (a-z),
// insert a char (a-z) at every position.
fn sp_edits1(word) -> any
    let result = []
    let seen = {}
    let n = len(word)
    // Deletes: remove each character.
    let i = 0
    while i < n
        let d = _sp_delete_at(word, i)
        _sp_add_unique(result, seen, d)
        i = i + 1
    // Transposes: swap adjacent pairs.
    i = 0
    while i < n - 1
        let t = _sp_swap_at(word, i)
        _sp_add_unique(result, seen, t)
        i = i + 1
    // Replaces: replace each position with each letter a-z.
    i = 0
    while i < n
        let lc = 97
        while lc <= 122
            let r = _sp_replace_at(word, i, lc)
            if r != word
                _sp_add_unique(result, seen, r)
            lc = lc + 1
        i = i + 1
    // Inserts: insert each letter a-z at each position (including end).
    i = 0
    while i <= n
        let lc = 97
        while lc <= 122
            let ins = _sp_insert_at(word, i, lc)
            _sp_add_unique(result, seen, ins)
            lc = lc + 1
        i = i + 1
    result

// Return the subset of words (a list of strings) that are in dict.
fn sp_known(words, dict) -> any
    let result = []
    let n = len(words)
    let i = 0
    while i < n
        if contains(dict, words[i]) == 1
            push(result, words[i])
        i = i + 1
    result

// Levenshtein edit distance between strings a and b.
fn sp_edit_distance(a, b) -> int
    let na = len(a)
    let nb = len(b)
    if na == 0
        return nb
    if nb == 0
        return na
    // Allocate a flat (na+1)*(nb+1) table via a list.
    // Row-major: index = row*(nb+1)+col.
    let dp = []
    let size = (na + 1) * (nb + 1)
    let k = 0
    while k < size
        push(dp, 0)
        k = k + 1
    // Initialize first row and column.
    let ci = 0
    while ci <= na
        dp[ci * (nb + 1)] = ci
        ci = ci + 1
    let cj = 0
    while cj <= nb
        dp[cj] = cj
        cj = cj + 1
    // Fill.
    let ri = 1
    while ri <= na
        let rj = 1
        while rj <= nb
            let cost = 1
            if a[ri - 1] == b[rj - 1]
                cost = 0
            let del_cost = dp[(ri - 1) * (nb + 1) + rj] + 1
            let ins_cost = dp[ri * (nb + 1) + (rj - 1)] + 1
            let sub_cost = dp[(ri - 1) * (nb + 1) + (rj - 1)] + cost
            let best = del_cost
            if ins_cost < best
                best = ins_cost
            if sub_cost < best
                best = sub_cost
            dp[ri * (nb + 1) + rj] = best
            rj = rj + 1
        ri = ri + 1
    dp[na * (nb + 1) + nb]

// Return candidate words: known(edits1) if non-empty, else known(edits2),
// else [word] (no better candidate found).
fn sp_candidates(word, dict) -> any
    let e1 = sp_edits1(word)
    let k1 = sp_known(e1, dict)
    if len(k1) > 0
        return k1
    // Compute edits2 lazily: edits1 of each edits1 candidate.
    let seen = {}
    let e2 = []
    let i = 0
    while i < len(e1)
        let inner = sp_edits1(e1[i])
        let j = 0
        while j < len(inner)
            let w = inner[j]
            if contains(seen, w) == 0
                seen[w] = 1
                push(e2, w)
            j = j + 1
        i = i + 1
    let k2 = sp_known(e2, dict)
    if len(k2) > 0
        return k2
    let fallback = []
    push(fallback, word)
    fallback

// Return the highest-frequency candidate for word given dict.
fn sp_correct(word, dict) -> string
    // If word is already known, return it (it may be highest freq already).
    if contains(dict, word) == 1
        let cands = sp_candidates(word, dict)
        let best = word
        let best_f = dict[word]
        let i = 0
        while i < len(cands)
            let w = cands[i]
            if contains(dict, w) == 1
                let f = dict[w]
                if f > best_f
                    best_f = f
                    best = w
            i = i + 1
        return best
    let cands = sp_candidates(word, dict)
    if len(cands) == 0
        return word
    let best = cands[0]
    let best_f = 0
    if contains(dict, best) == 1
        best_f = dict[best]
    let i = 1
    while i < len(cands)
        let w = cands[i]
        if contains(dict, w) == 1
            let f = dict[w]
            if f > best_f
                best_f = f
                best = w
        i = i + 1
    best

// Build a word->count dict from a list of word strings.
fn sp_build_dict(words) -> any
    let d = {}
    let n = len(words)
    let i = 0
    while i < n
        let w = words[i]
        if contains(d, w) == 1
            d[w] = d[w] + 1
        else
            d[w] = 1
        i = i + 1
    d

// Return true if word is present in dict.
fn sp_is_correct(word, dict) -> bool
    if contains(dict, word) == 1
        return true
    false

// Return top-k candidates for word sorted by frequency descending.
fn sp_suggestions(word, dict, k) -> any
    let cands = sp_candidates(word, dict)
    // Score each candidate.
    let pairs = []
    let i = 0
    while i < len(cands)
        let w = cands[i]
        let f = 0
        if contains(dict, w) == 1
            f = dict[w]
        let entry = {}
        entry["word"] = w
        entry["freq"] = f
        push(pairs, entry)
        i = i + 1
    // Insertion sort descending by freq.
    let n = len(pairs)
    let j = 1
    while j < n
        let key = pairs[j]
        let kf = key["freq"]
        let pos = j
        let ki = j - 1
        let done = false
        while ki >= 0 and done == false
            let cf = pairs[ki]["freq"]
            if cf < kf
                pairs[ki + 1] = pairs[ki]
                pos = ki
                ki = ki - 1
            else
                done = true
        pairs[pos] = key
        j = j + 1
    let result = []
    let take = k
    if take > n
        take = n
    let ri = 0
    while ri < take
        push(result, pairs[ri]["word"])
        ri = ri + 1
    result

// Count the size of the edit-distance-2 set (may be large; computed fully).
fn sp_edits2_count(word) -> int
    let e1 = sp_edits1(word)
    let seen = {}
    let count = 0
    let i = 0
    while i < len(e1)
        let inner = sp_edits1(e1[i])
        let j = 0
        while j < len(inner)
            let w = inner[j]
            if contains(seen, w) == 0
                seen[w] = 1
                count = count + 1
            j = j + 1
        i = i + 1
    count

// Return the probability (frequency / total) of word in dict.
fn sp_probability(word, dict) -> float
    let wkeys = keys(dict)
    let total = 0
    let i = 0
    while i < len(wkeys)
        total = total + dict[wkeys[i]]
        i = i + 1
    if total == 0
        return 0.0
    if contains(dict, word) == 0
        return 0.0
    let f = dict[word]
    let result = (f * 1.0) / (total * 1.0)
    result

// Add word to dict (increment count if present, set to 1 if new). Returns dict.
fn sp_add_word(dict, word) -> any
    if contains(dict, word) == 1
        dict[word] = dict[word] + 1
    else
        dict[word] = 1
    dict

fn main()
    print("std/text/spellcorrect loaded")
