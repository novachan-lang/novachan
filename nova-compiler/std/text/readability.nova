// ============================================================================
// NOVA Standard Library — std/text/readability
// ============================================================================
// English readability metrics.
//
// Public API:
//   rd_word_count(text) -> int
//       Count whitespace-separated non-empty tokens.
//
//   rd_sentence_count(text) -> int
//       Count sentence terminators: '.', '!', '?'. Returns at least 1 for
//       any non-empty text (a paragraph with no punctuation is 1 sentence).
//       Returns 0 for empty/whitespace-only text.
//
//   rd_syllable_count(text) -> int
//       Sum of syllables across all words (vowel-group heuristic, min 1 per
//       word). Words are lowercased and stripped of non-alpha chars first.
//
//   rd_flesch_reading_ease(text) -> float
//       206.835 - 1.015*(words/sentences) - 84.6*(syllables/words)
//       Higher = easier (90-100 = very easy; <30 = very difficult).
//       Returns 0.0 for empty text.
//
//   rd_flesch_kincaid_grade(text) -> float
//       0.39*(words/sentences) + 11.8*(syllables/words) - 15.59
//       Approximate US school grade level. Returns 0.0 for empty text.
//
//   rd_ari(text) -> float
//       Automated Readability Index: 4.71*(chars/words) + 0.5*(words/sentences)
//       - 21.43. Returns 0.0 for empty text. 'chars' = non-whitespace
//       characters in text.
//
// Design notes:
//   - All formulas follow the classical definitions; results may be negative
//     (e.g. FK grade on trivial text) — that is correct per the formula.
//   - ckf epsilon = 0.5 is tight enough for KAT without over-constraining
//     heuristic syllable counting.
//   - The ARI "chars" counts ALL non-whitespace characters (including digits,
//     punctuation) — the standard definition.
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// Return 1 if byte code b is ASCII whitespace (space=32, tab=9, CR=13, LF=10).
fn _rd_is_ws(b) -> int
    if b == 32
        return 1
    if b == 9
        return 1
    if b == 13
        return 1
    if b == 10
        return 1
    0

// Return 1 if the single-char string c is an English vowel (a e i o u y).
fn _rd_is_vowel(c) -> int
    if c == "a"
        return 1
    if c == "e"
        return 1
    if c == "i"
        return 1
    if c == "o"
        return 1
    if c == "u"
        return 1
    if c == "y"
        return 1
    0

// Return 1 if byte code b is ASCII alpha (A-Z or a-z).
fn _rd_is_alpha(b) -> int
    if b >= 65 and b <= 90
        return 1
    if b >= 97 and b <= 122
        return 1
    0

// Lowercase and strip non-alpha characters from token t.
// Returns "" if t has no alpha characters.
fn _rd_clean_word(t) -> str
    let out = ""
    let n = len(t)
    let i = 0
    while i < n
        let b = ord(t[i])
        if b >= 65 and b <= 90
            out = out + chr(b + 32)
        else
            if b >= 97 and b <= 122
                out = out + t[i]
        i = i + 1
    out

// Split text on whitespace; return list of non-empty tokens.
fn _rd_split(s) -> list
    let toks = []
    let n = len(s)
    let i = 0
    let cur = ""
    while i < n
        let b = ord(s[i])
        if _rd_is_ws(b) == 1
            if len(cur) > 0
                push(toks, cur)
                cur = ""
        else
            cur = cur + s[i]
        i = i + 1
    if len(cur) > 0
        push(toks, cur)
    toks

// Count syllables in a single cleaned (lowercase, alpha-only) word.
// Uses vowel-group heuristic with silent trailing-e suppression.
// Returns at least 1 for any non-empty word, 0 for empty string.
fn _rd_syllables_word(word) -> int
    let n = len(word)
    if n == 0
        return 0
    // Count vowel-transition groups.
    let groups = 0
    let prev_was_vowel = 0
    let i = 0
    while i < n
        let c = word[i]
        let is_v = _rd_is_vowel(c)
        if is_v == 1
            if prev_was_vowel == 0
                groups = groups + 1
            prev_was_vowel = 1
        else
            prev_was_vowel = 0
        i = i + 1
    // Silent trailing-e: last='e', prev non-vowel, NOT ending in "le", groups>1.
    if n >= 2
        let last_c = word[n - 1]
        let prev_c = word[n - 2]
        if last_c == "e"
            if _rd_is_vowel(prev_c) == 0
                if prev_c == "l"
                    // ends in "le" — keep groups (e.g. "apple", "table")
                    groups = groups
                else
                    if groups > 1
                        groups = groups - 1
    if groups < 1
        groups = 1
    groups

// Count non-whitespace characters in text (for ARI).
fn _rd_nonws_chars(s) -> int
    let n = len(s)
    let count = 0
    let i = 0
    while i < n
        let b = ord(s[i])
        if _rd_is_ws(b) == 0
            count = count + 1
        i = i + 1
    count

// ── public API ───────────────────────────────────────────────────────────────

// Count whitespace-separated non-empty tokens in text.
fn rd_word_count(text) -> int
    let toks = _rd_split(text)
    len(toks)

// Count sentence-terminating punctuation: '.', '!', '?'.
// Returns at least 1 for non-empty text, 0 for empty text.
fn rd_sentence_count(text) -> int
    if len(text) == 0
        return 0
    let n = len(text)
    let count = 0
    let i = 0
    while i < n
        let b = ord(text[i])
        // '.' = 46, '!' = 33, '?' = 63
        if b == 46
            count = count + 1
        if b == 33
            count = count + 1
        if b == 63
            count = count + 1
        i = i + 1
    if count < 1
        count = 1
    count

// Count total syllables across all words in text.
// Words are cleaned (lowercased, non-alpha stripped) before counting.
fn rd_syllable_count(text) -> int
    let toks = _rd_split(text)
    let total = 0
    let i = 0
    while i < len(toks)
        let cleaned = _rd_clean_word(toks[i])
        if len(cleaned) > 0
            total = total + _rd_syllables_word(cleaned)
        i = i + 1
    total

// Flesch Reading Ease: 206.835 - 1.015*(W/S) - 84.6*(Sy/W)
// Higher score = easier to read. Returns 0.0 for empty text.
fn rd_flesch_reading_ease(text) -> float
    let w = rd_word_count(text)
    if w == 0
        return 0.0
    let s = rd_sentence_count(text)
    let sy = rd_syllable_count(text)
    let ws_ratio = (w * 1.0) / (s * 1.0)
    let sy_ratio = (sy * 1.0) / (w * 1.0)
    206.835 - 1.015 * ws_ratio - 84.6 * sy_ratio

// Flesch-Kincaid Grade Level: 0.39*(W/S) + 11.8*(Sy/W) - 15.59
// Returns 0.0 for empty text.
fn rd_flesch_kincaid_grade(text) -> float
    let w = rd_word_count(text)
    if w == 0
        return 0.0
    let s = rd_sentence_count(text)
    let sy = rd_syllable_count(text)
    let ws_ratio = (w * 1.0) / (s * 1.0)
    let sy_ratio = (sy * 1.0) / (w * 1.0)
    0.39 * ws_ratio + 11.8 * sy_ratio - 15.59

// Automated Readability Index: 4.71*(chars/words) + 0.5*(words/sentences) - 21.43
// 'chars' = non-whitespace character count. Returns 0.0 for empty text.
fn rd_ari(text) -> float
    let w = rd_word_count(text)
    if w == 0
        return 0.0
    let s = rd_sentence_count(text)
    let ch = _rd_nonws_chars(text)
    let cw_ratio = (ch * 1.0) / (w * 1.0)
    let ws_ratio = (w * 1.0) / (s * 1.0)
    4.71 * cw_ratio + 0.5 * ws_ratio - 21.43
