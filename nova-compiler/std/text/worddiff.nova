// ============================================================================
// NOVA Standard Library — std/text/worddiff
// ============================================================================
// Word-level diff via Longest Common Subsequence (LCS).
//
// Public API:
//   wd_words(s) -> list of strings
//       Split s on space characters into a list of word strings.
//       wd_words("") -> []
//       wd_words("a b c") -> ["a","b","c"]
//
//   wd_diff(a, b) -> list of strings
//       Each element is prefixed:
//         " word"  — word appears in both a and b (common / context)
//         "-word"  — word appears only in a (removed)
//         "+word"  — word appears only in b (added)
//       Elements appear in the order they occur in the merged sequence.
//       Deletes precede inserts within a hunk (backtracking prefers INSERT so
//       that on reversal deletes come first).
//
// Algorithm:
//   1. Split each string on ASCII space (0x20) via wd_words.
//   2. Build the full LCS DP table (size (m+1)*(n+1), row-major flat list)
//      comparing words as strings.
//   3. Backtrack from dp[m][n] to (0,0) collecting edit steps in reverse;
//      prefer INSERT during backtrack so that in forward order deletes
//      precede inserts within a hunk.
//   4. Reverse the collected list to produce the forward edit script.
//
// Edge cases:
//   wd_diff("", "")  -> []
//   wd_diff("", "x") -> ["+x"]
//   wd_diff("x", "") -> ["-x"]
// ============================================================================

// ── Private helpers ──────────────────────────────────────────────────────────

// _split_words: split s on ASCII space (chr(32)).
// Returns a list of word strings.  The empty string returns [].
// Consecutive spaces produce empty-string tokens, matching simple split behaviour.
fn _split_words(s)
    let result = []
    let n = len(s)
    if n == 0
        return result
    let start = 0
    let i = 0
    while i < n
        if s[i] == chr(32)
            let word = slice(s, start, i)
            result.push(word)
            start = i + 1
        i += 1
    // push the last token (whatever follows the final space, or the whole
    // string if there were no spaces)
    let tail = slice(s, start, n)
    result.push(tail)
    result

// _lcs_dp_words: compute the full LCS DP table for two word lists.
// Returns a flat list of (m+1)*(n+1) ints, row-major.
// dp[i*(n+1)+j] = LCS length of a[0..i-1] and b[0..j-1].
fn _lcs_dp_words(a, b)
    let m = len(a)
    let n = len(b)
    let sz = (m + 1) * (n + 1)
    let dp = []
    for fill in 0..sz
        dp.push(0)
    let i = 1
    while i <= m
        let j = 1
        while j <= n
            let idx = i * (n + 1) + j
            if a[i - 1] == b[j - 1]
                let diag = dp[(i - 1) * (n + 1) + (j - 1)] + 1
                dp[idx] = diag
            else
                let from_top  = dp[(i - 1) * (n + 1) + j]
                let from_left = dp[i * (n + 1) + (j - 1)]
                if from_top >= from_left
                    dp[idx] = from_top
                else
                    dp[idx] = from_left
            j += 1
        i += 1
    dp

// ── Public API ───────────────────────────────────────────────────────────────

// wd_words splits s on ASCII spaces and returns a list of word strings.
fn wd_words(s)
    _split_words(s)

// wd_diff compares strings a and b word-by-word and returns an edit script.
// Each element is prefixed " " (common), "-" (removed), or "+" (added).
fn wd_diff(a, b)
    let wa = _split_words(a)
    let wb = _split_words(b)
    let m = len(wa)
    let n = len(wb)

    // Edge case: both empty strings produce empty word lists.
    if m == 0 and n == 0
        return []

    // Edge case: a is empty — all words in b are additions.
    if m == 0
        let out = []
        for j in 0..n
            out.push("+" + wb[j])
        return out

    // Edge case: b is empty — all words in a are deletions.
    if n == 0
        let out = []
        for i in 0..m
            out.push("-" + wa[i])
        return out

    // General case: build LCS DP table then backtrack.
    let dp = _lcs_dp_words(wa, wb)

    // Backtrack from dp[m][n] to (0,0) collecting edit steps in REVERSE order.
    // To produce deletes-before-inserts in the forward edit script we emit
    // INSERTs first during backtracking (they flip to after deletes on reversal).
    let rev = []
    let ci = m
    let cj = n
    while ci > 0 or cj > 0
        if ci > 0 and cj > 0 and wa[ci - 1] == wb[cj - 1]
            // Common word — diagonal step.
            rev.push(" " + wa[ci - 1])
            ci -= 1
            cj -= 1
        else
            let score_top  = 0
            let score_left = 0
            if ci > 0
                score_top = dp[(ci - 1) * (n + 1) + cj]
            if cj > 0
                score_left = dp[ci * (n + 1) + (cj - 1)]
            // Prefer INSERT (left step) on a tie so that during forward order
            // the delete precedes the insert within a hunk.
            if cj == 0 or (ci > 0 and score_top > score_left)
                // Delete wa[ci-1] — go up.
                rev.push("-" + wa[ci - 1])
                ci -= 1
            else
                // Insert wb[cj-1] — go left.
                rev.push("+" + wb[cj - 1])
                cj -= 1

    // Reverse rev to get the edit script in forward order.
    let result = []
    let ri = len(rev) - 1
    while ri >= 0
        result.push(rev[ri])
        ri -= 1
    result

// ============================================================================
fn main()
    print("std/text/worddiff loaded")
