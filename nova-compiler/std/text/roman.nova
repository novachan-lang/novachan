// std/text/roman -- Roman numeral encoding/decoding for integers 1..3999.
// Uses standard subtractive notation (IV, IX, XL, XC, CD, CM).
//
// Public API:
//   rom_from_int(n: int) -> string   -- encode n (1..3999) to Roman numerals
//   rom_to_int(s: string) -> int     -- decode Roman numeral string to int
//
// LEAF -- imports NOTHING.

// Parallel value/symbol lists for greedy decomposition.
// Ordered largest-to-smallest; subtractive pairs included explicitly.
fn _rom_vals() -> list
    [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]

fn _rom_syms() -> list
    ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]

// Encode integer n (1..3999) to a Roman numeral string.
// Returns "" for out-of-range input (0, negative, or > 3999).
fn rom_from_int(n: int) -> string
    let result = ""
    if n < 1 or n > 3999
        result = ""
    else
        let vals = _rom_vals()
        let syms = _rom_syms()
        let rem = n
        for i in 0..len(vals)
            let v = vals[i]
            let s = syms[i]
            while rem >= v
                result = result + s
                rem = rem - v
    result

// Decode a Roman numeral string to an integer.
// Standard subtractive rule: if a smaller value precedes a larger one,
// subtract the smaller; otherwise add it.
// Returns 0 for empty or invalid input.
fn rom_to_int(s: string) -> int
    let total = 0
    let slen = len(s)
    for i in 0..slen
        let cur = _rom_char_val(char_at(s, i))
        let nxt = 0
        if i + 1 < slen
            nxt = _rom_char_val(char_at(s, i + 1))
        if cur < nxt
            total = total - cur
        else
            total = total + cur
    total

// PRIVATE: map a single Roman numeral character to its base value.
// Returns 0 for unrecognised characters.
fn _rom_char_val(c: string) -> int
    let v = 0
    if c == "I"
        v = 1
    else if c == "V"
        v = 5
    else if c == "X"
        v = 10
    else if c == "L"
        v = 50
    else if c == "C"
        v = 100
    else if c == "D"
        v = 500
    else if c == "M"
        v = 1000
    v
