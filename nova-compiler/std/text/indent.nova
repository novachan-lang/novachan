// ============================================================================
// NOVA Standard Library — std/text/indent
// ============================================================================
// Multi-line text block helpers: split into lines, join, indent, and dedent.
//
// Public API:
//   splitlines(s) -> list
//       Split s on "\n". A trailing newline does NOT produce a final empty
//       element (matches Python's str.splitlines semantics). "" -> [].
//
//   join_lines(lines) -> string
//       Join a list of strings with "\n" (inverse of splitlines for clean input).
//
//   indent(s, prefix) -> string
//       Prepend prefix to every non-empty line. Empty lines are left untouched.
//
//   dedent(s) -> string
//       Remove the longest COMMON leading-whitespace prefix shared by all
//       non-empty lines. Lines that are empty (len == 0) do not participate in
//       the prefix calculation and are passed through unchanged.
//
// LEAF — imports NOTHING.

// ── private helpers ──────────────────────────────────────────────────────────

// Count how many leading space/tab characters line has. Only spaces (0x20) and
// tabs (0x09) are considered whitespace for the dedent prefix calculation.
fn _indent_leading_ws(line) -> int
    let n = len(line)
    for i in 0..n
        let b = ord(char_at(line, i))
        if b != 32 and b != 9
            return i
    // all-whitespace line: return full length so it never constrains the common
    // prefix (caller skips all-whitespace lines when they are "empty").
    n

// Return the smaller of two ints.
fn _indent_min(a, b) -> int
    if a < b
        return a
    b

// ── public API ───────────────────────────────────────────────────────────────

// splitlines(s) -> list
// Split s on "\n". A trailing "\n" does NOT produce a trailing empty element.
// splitlines("") -> [].
// splitlines("a\nb\n") -> ["a","b"].
// splitlines("a\nb\nc") -> ["a","b","c"].
fn splitlines(s) -> list
    let n = len(s)
    if n == 0
        return []
    let nl = chr(10)
    let raw = split(s, nl)
    // split("a\nb\n", "\n") -> ["a","b",""] — drop the final empty element if
    // the original string ended with a newline.
    let rlen = len(raw)
    let last = rlen - 1
    // Determine whether to include the last segment: include it only if it is
    // non-empty (i.e. the string did NOT end with "\n").
    let limit = rlen
    if rlen > 0 and len(raw[last]) == 0
        limit = last
    [raw[i] for i in 0..limit]

// join_lines(lines) -> string
// Join a list of strings with "\n". Inverse of splitlines for clean input.
// join_lines(["x","y"]) == "x\ny".
fn join_lines(lines) -> string
    let n = len(lines)
    if n == 0
        return ""
    join(lines, chr(10))

// indent(s, prefix) -> string
// Prepend prefix to every non-empty line; empty lines are left unchanged.
// indent("a\nb","  ") == "  a\n  b"
// indent("a\n\nb","  ") == "  a\n\n  b"   -- blank line untouched
fn indent(s, prefix) -> string
    let lines = splitlines(s)
    let n = len(lines)
    if n == 0
        return ""
    let pieces = [(prefix + lines[i] if len(lines[i]) > 0 else lines[i]) for i in 0..n]
    join(pieces, chr(10))

// dedent(s) -> string
// Remove the longest common leading-whitespace prefix from all non-empty lines.
// Empty lines (len == 0) are not considered when computing the common prefix,
// and are passed through unchanged in the output.
// dedent("    a\n    b") == "a\nb"
// dedent("  a\n    b") == "a\n  b"   -- common prefix = 2 spaces
fn dedent(s) -> string
    let lines = splitlines(s)
    let n = len(lines)
    if n == 0
        return ""
    // Compute the common prefix length across all non-empty lines.
    // Start with a very large sentinel (any real line is shorter).
    let common = 1000000
    let found_nonempty = 0
    for i in 0..n
        if len(lines[i]) > 0
            let ws = _indent_leading_ws(lines[i])
            if found_nonempty == 0
                common = ws
                found_nonempty = 1
            else
                common = _indent_min(common, ws)
    // If no non-empty lines were found, nothing to strip.
    if found_nonempty == 0
        return join_lines(lines)
    // If common prefix is 0, nothing to strip.
    if common == 0
        return join_lines(lines)
    // Strip exactly `common` leading characters from every non-empty line.
    let result = [(slice(line, common, len(line)) if len(line) > 0 else line) for line in lines]
    join_lines(result)
