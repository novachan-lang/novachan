// ============================================================================
// NOVA Standard Library — std/text/jarowinkler
// ============================================================================
// Jaro and Jaro-Winkler string similarity metrics.
//
// Public API:
//   jw_jaro(a, b)    -> float   Jaro similarity in [0.0, 1.0]
//   jw_winkler(a, b) -> float   Jaro-Winkler similarity in [0.0, 1.0]
//
// jw_jaro(a, b):
//   Classic Jaro similarity (Jaro 1989).
//   Match window = floor(max(|a|,|b|) / 2) - 1, minimum 0.
//   Characters at positions i (in a) and j (in b) match when they are equal
//   AND |i - j| <= window; each character matched at most once (left-to-right
//   greedy). Let m = match count, t = half-transpositions:
//     jaro = (m/|a| + m/|b| + (m - t)/m) / 3
//   Both empty -> 1.0; one empty -> 0.0; no matches -> 0.0.
//
// jw_winkler(a, b):
//   Jaro-Winkler (Winkler 1990) boosts the Jaro score for a shared prefix.
//   Let l = min(length of common prefix, 4), p = 0.1:
//     winkler = jaro + l * p * (1 - jaro)
//   The prefix bonus is applied ONLY when jaro > 0.7; otherwise winkler == jaro.
//   Max l = 4 ensures the score stays in [0.0, 1.0].
//
// KAT vectors (published):
//   jw_jaro("MARTHA","MARHTA")    ≈ 0.9444
//   jw_winkler("MARTHA","MARHTA") ≈ 0.9611
//   jw_jaro("DWAYNE","DUANE")     ≈ 0.8222
//   jw_winkler("DWAYNE","DUANE")  ≈ 0.8400
//   jw_jaro("DIXON","DICKSONX")   ≈ 0.7667
//   jw_winkler("DIXON","DICKSONX")≈ 0.8133
//
// LEAF — imports nothing.
// ============================================================================

// jw_jaro returns the Jaro similarity between strings a and b.
fn jw_jaro(a, b) -> float
    let l1 = len(a)
    let l2 = len(b)
    if l1 == 0 and l2 == 0
        return 1.0
    if l1 == 0 or l2 == 0
        return 0.0

    // Matching window: floor(max(l1,l2)/2) - 1, minimum 0.
    let mx = l1
    if l2 > mx
        mx = l2
    let window = mx / 2 - 1
    if window < 0
        window = 0

    // Allocate matched-flag lists for positions in a and b.
    let s1m = []
    let s2m = []
    let i = 0
    while i < l1
        s1m.push(0)
        i += 1
    i = 0
    while i < l2
        s2m.push(0)
        i += 1

    // Count matching characters (greedy left-to-right in a).
    let m = 0
    i = 0
    while i < l1
        let lo = i - window
        if lo < 0
            lo = 0
        let hi = i + window + 1
        if hi > l2
            hi = l2
        let jj = lo
        let found = 0
        while jj < hi and found == 0
            if s2m[jj] == 0 and ord(a[i]) == ord(b[jj])
                s1m[i] = 1
                s2m[jj] = 1
                m += 1
                found = 1
            jj += 1
        i += 1

    if m == 0
        return 0.0

    // Count transpositions: walk matched positions in a and b in order;
    // each position-order mismatch adds 1 to raw count t.
    // The classic Jaro formula uses t/2 (half-transpositions).
    let t = 0
    let kk = 0
    i = 0
    while i < l1
        if s1m[i] == 1
            while s2m[kk] == 0
                kk += 1
            if ord(a[i]) != ord(b[kk])
                t += 1
            kk += 1
        i += 1

    // Jaro formula — bind every sub-expression to a let (avoids float-return bug).
    let mf = m * 1.0
    let l1f = l1 * 1.0
    let l2f = l2 * 1.0
    let half_t = (t / 2) * 1.0
    let p1 = mf / l1f
    let p2 = mf / l2f
    let p3 = (mf - half_t) / mf
    let result = (p1 + p2 + p3) / 3.0
    result

// _jw_prefix_len returns the length of the common prefix of a and b,
// capped at 4 (the Winkler limit).
fn _jw_prefix_len(a, b) -> int
    let la = len(a)
    let lb = len(b)
    let limit = 4
    if la < limit
        limit = la
    if lb < limit
        limit = lb
    let count = 0
    for i in 0..limit and ord(a[i]) == ord(b[i])
        count += 1
    count

// jw_winkler returns the Jaro-Winkler similarity between a and b.
// It applies a prefix bonus on top of the Jaro score when jaro > 0.7.
fn jw_winkler(a, b) -> float
    let jaro = jw_jaro(a, b)
    let result = jaro
    if jaro > 0.7
        let pl = _jw_prefix_len(a, b)
        let plf = pl * 1.0
        let bonus = plf * 0.1 * (1.0 - jaro)
        result = jaro + bonus
    result

fn main()
    print("std/text/jarowinkler loaded")
