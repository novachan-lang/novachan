// ============================================================================
// NOVA Standard Library — std/text/bbcode_to_html
// ============================================================================
// Convert BBCode markup to HTML. Single left-to-right recursive-descent scan,
// implemented with slicing (no imports, no shared parser state).
//
// Public API:
//   bhtml_convert(input) -> str
//       Convert a BBCode string to HTML.
//
// Supported tags:
//   [b] [i] [u] [s]        -> <b> <i> <u> <s>            (paired)
//   [url]text[/url]        -> <a href="text">text</a>    (text doubles as href)
//   [url=X]text[/url]      -> <a href="X">text</a>        (text re-rendered)
//   [img]url[/img]         -> <img src="url">             (void element)
//   [color=X]text[/color]  -> <span style="color:X">text</span>
//   [size=X]text[/size]    -> <span style="font-size:Xpx">text</span>
//   [quote]text[/quote]    -> <blockquote>text</blockquote>
//   [code]text[/code]      -> <pre><code>text</code></pre> (literal, escaped,
//                              NOT re-rendered as BBCode)
//   [list][*]a[*]b[/list]  -> <ul><li>a</li><li>b</li></ul>
//   [*]                    -> <li>  (bare/top-level fallback, no closing tag;
//                              HTML5 auto-closes <li> at the next <li>/</ul>)
//
// Nesting: matching a tag's close respects same-name nesting depth, so
// [quote][quote]a[/quote]b[/quote] finds the OUTER [/quote], not the first
// one seen — content in between is recursively converted so nested tags
// (formatting inside a [quote], a [url=X] label, a [list] item, ...) work.
//
// Unrecognized tags, and any tag with no matching close, pass through as
// literal text (only the '[' is consumed so the rest re-scans normally —
// this matches the sibling std/text/md_link.nova convention).
//
// Escaping: plain text is HTML-escaped (& < >) as it is copied through.
// Attribute values (href/src/style) are additionally escaped for the quote
// character, since they are always emitted inside a double-quoted attribute.
// [code] content is escaped the same way as plain text (matches
// std/text/md_code_block.nova's md_code_escape convention) but is copied
// VERBATIM otherwise — no BBCode inside a code block is interpreted.
//
// LEAF — imports NOTHING.
// ============================================================================

// ── escaping ─────────────────────────────────────────────────────────────────

// Escape a single character for HTML text content. Non-special chars pass
// through unchanged.
fn _bhtml_esc_char(c) -> str
    if c == "&"
        return "&amp;"
    if c == "<"
        return "&lt;"
    if c == ">"
        return "&gt;"
    c

// HTML-escape a whole string for use as text content.
fn _bhtml_esc(s) -> str
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        out = out + _bhtml_esc_char(slice(s, i, i + 1))
        i = i + 1
    out

// HTML-escape a string for use inside a double-quoted attribute value:
// the same rules as text, plus the double-quote character itself.
fn _bhtml_esc_attr(s) -> str
    let out = ""
    let i = 0
    let n = len(s)
    let q = chr(34)
    while i < n
        let c = slice(s, i, i + 1)
        if c == q
            out = out + "&quot;"
        else
            out = out + _bhtml_esc_char(c)
        i = i + 1
    out

// ── tag matching ─────────────────────────────────────────────────────────────

// Find the absolute index of the '[' that starts the matching "[/name]" for
// an opening tag whose content begins at `pos`. Tracks nesting depth of the
// SAME tag name (bare "[name]" or parameterized "[name=value]" both count
// as opens) so nested same-name tags resolve to the correct outer close.
// Returns -1 if no matching close is found before the end of the string.
fn _bhtml_find_close(s, pos, name) -> int
    let n = len(s)
    let i = pos
    let depth = 0
    while i < n
        if slice(s, i, i + 1) == "["
            let rel = find(slice(s, i, n), "]")
            if rel < 0
                i = i + 1
            else
                let close = i + rel
                let tag_text = lower(slice(s, i + 1, close))
                if tag_text == "/" + name
                    if depth == 0
                        return i
                    depth = depth - 1
                    i = close + 1
                else
                    let is_open = 0
                    if tag_text == name
                        is_open = 1
                    else
                        if starts_with(tag_text, name + "=")
                            is_open = 1
                    if is_open == 1
                        depth = depth + 1
                    i = close + 1
        else
            i = i + 1
    -1

// Given the absolute index of the '[' of a "[/name]" close tag (as returned
// by _bhtml_find_close), return the index of the character right after its
// closing ']'.
fn _bhtml_after_close(s, close_pos) -> int
    let n = len(s)
    let rel = find(slice(s, close_pos, n), "]")
    close_pos + rel + 1

// ── simple paired tags ───────────────────────────────────────────────────────

fn _bhtml_open_tag(name) -> str
    if name == "b"
        return "<b>"
    if name == "i"
        return "<i>"
    if name == "u"
        return "<u>"
    if name == "s"
        return "<s>"
    "<blockquote>"

fn _bhtml_close_tag(name) -> str
    if name == "b"
        return "</b>"
    if name == "i"
        return "</i>"
    if name == "u"
        return "</u>"
    if name == "s"
        return "</s>"
    "</blockquote>"

// ── [list] / [*] ─────────────────────────────────────────────────────────────

// Split the raw content of a [list]...[/list] body into its top-level [*]
// items. Nested [list]...[/list] blocks are skipped over (their [*] markers
// belong to the nested list, not this one) via a depth counter. Any text
// before the first top-level [*] is discarded (no item to attach it to).
fn _bhtml_list_items(content) -> list
    let items = []
    let n = len(content)
    let i = 0
    let depth = 0
    let item_start = -1
    while i < n
        if slice(content, i, i + 1) == "["
            let rel = find(slice(content, i, n), "]")
            if rel < 0
                i = i + 1
            else
                let close = i + rel
                let lname = lower(slice(content, i + 1, close))
                if lname == "list"
                    depth = depth + 1
                    i = close + 1
                else
                    if lname == "/list"
                        depth = depth - 1
                        i = close + 1
                    else
                        if lname == "*" and depth == 0
                            if item_start >= 0
                                push(items, slice(content, item_start, i))
                            item_start = close + 1
                            i = close + 1
                        else
                            i = i + 1
        else
            i = i + 1
    if item_start >= 0
        push(items, slice(content, item_start, n))
    items

fn _bhtml_render_list(inner) -> str
    let items = _bhtml_list_items(inner)
    let out = "<ul>"
    let i = 0
    let n = len(items)
    while i < n
        out = out + "<li>" + _bhtml_render(items[i]) + "</li>"
        i = i + 1
    out + "</ul>"

// ── main recursive scanner ───────────────────────────────────────────────────

fn _bhtml_render(s) -> str
    let out_parts = []
    let n = len(s)
    let i = 0
    let q = chr(34)
    while i < n
        if slice(s, i, i + 1) == "["
            let rel = find(slice(s, i, n), "]")
            if rel < 0
                push(out_parts, "[")
                i = i + 1
            else
                let close = i + rel
                let raw_tag = slice(s, i + 1, close)
                let lname = lower(raw_tag)
                let content_start = close + 1
                if lname == "*"
                    push(out_parts, "<li>")
                    i = content_start
                else
                    if lname == "b" or lname == "i" or lname == "u" or lname == "s" or lname == "quote"
                        let cp = _bhtml_find_close(s, content_start, lname)
                        if cp < 0
                            push(out_parts, "[")
                            i = i + 1
                        else
                            let inner = _bhtml_render(slice(s, content_start, cp))
                            push(out_parts, _bhtml_open_tag(lname) + inner + _bhtml_close_tag(lname))
                            i = _bhtml_after_close(s, cp)
                    else
                        if lname == "code"
                            let cp = _bhtml_find_close(s, content_start, "code")
                            if cp < 0
                                push(out_parts, "[")
                                i = i + 1
                            else
                                let inner = slice(s, content_start, cp)
                                push(out_parts, "<pre><code>" + _bhtml_esc(inner) + "</code></pre>")
                                i = _bhtml_after_close(s, cp)
                        else
                            if lname == "list"
                                let cp = _bhtml_find_close(s, content_start, "list")
                                if cp < 0
                                    push(out_parts, "[")
                                    i = i + 1
                                else
                                    let inner = slice(s, content_start, cp)
                                    push(out_parts, _bhtml_render_list(inner))
                                    i = _bhtml_after_close(s, cp)
                            else
                                if lname == "url"
                                    let cp = _bhtml_find_close(s, content_start, "url")
                                    if cp < 0
                                        push(out_parts, "[")
                                        i = i + 1
                                    else
                                        let inner = slice(s, content_start, cp)
                                        push(out_parts, "<a href=" + q + _bhtml_esc_attr(inner) + q + ">" + _bhtml_esc(inner) + "</a>")
                                        i = _bhtml_after_close(s, cp)
                                else
                                    if starts_with(lname, "url=")
                                        let target = slice(raw_tag, 4, len(raw_tag))
                                        let cp = _bhtml_find_close(s, content_start, "url")
                                        if cp < 0
                                            push(out_parts, "[")
                                            i = i + 1
                                        else
                                            let inner = _bhtml_render(slice(s, content_start, cp))
                                            push(out_parts, "<a href=" + q + _bhtml_esc_attr(target) + q + ">" + inner + "</a>")
                                            i = _bhtml_after_close(s, cp)
                                    else
                                        if lname == "img"
                                            let cp = _bhtml_find_close(s, content_start, "img")
                                            if cp < 0
                                                push(out_parts, "[")
                                                i = i + 1
                                            else
                                                let inner = slice(s, content_start, cp)
                                                push(out_parts, "<img src=" + q + _bhtml_esc_attr(inner) + q + ">")
                                                i = _bhtml_after_close(s, cp)
                                        else
                                            if starts_with(lname, "color=")
                                                let target = slice(raw_tag, 6, len(raw_tag))
                                                let cp = _bhtml_find_close(s, content_start, "color")
                                                if cp < 0
                                                    push(out_parts, "[")
                                                    i = i + 1
                                                else
                                                    let inner = _bhtml_render(slice(s, content_start, cp))
                                                    push(out_parts, "<span style=" + q + "color:" + _bhtml_esc_attr(target) + q + ">" + inner + "</span>")
                                                    i = _bhtml_after_close(s, cp)
                                            else
                                                if starts_with(lname, "size=")
                                                    let target = slice(raw_tag, 5, len(raw_tag))
                                                    let cp = _bhtml_find_close(s, content_start, "size")
                                                    if cp < 0
                                                        push(out_parts, "[")
                                                        i = i + 1
                                                    else
                                                        let inner = _bhtml_render(slice(s, content_start, cp))
                                                        push(out_parts, "<span style=" + q + "font-size:" + _bhtml_esc_attr(target) + "px" + q + ">" + inner + "</span>")
                                                        i = _bhtml_after_close(s, cp)
                                                else
                                                    push(out_parts, "[")
                                                    i = i + 1
        else
            push(out_parts, _bhtml_esc_char(slice(s, i, i + 1)))
            i = i + 1
    let out = join(out_parts, "")
    out

// ── public API ───────────────────────────────────────────────────────────────

fn bhtml_convert(input) -> str
    _bhtml_render(input)
