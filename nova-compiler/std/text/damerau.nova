// ============================================================================
// NOVA Standard Library — std/text/damerau
// ============================================================================
// Damerau-Levenshtein edit distance (Optimal String Alignment variant).
//
// Public API:
//   dl_distance(a, b) -> int   OSA edit distance: insert/delete/substitute +
//                              transposition of two ADJACENT characters (cost 1).
//
// Algorithm — OSA DP (O(m*n) time, O(m*n) space):
//   dp[i][j] = min edit distance between a[0..i-1] and b[0..j-1].
//
//   dp[0][j] = j            (j insertions from empty string)
//   dp[i][0] = i            (i deletions to empty string)
//
//   if a[i-1] == b[j-1]:    sub_cost = 0
//   else:                    sub_cost = 1
//
//   dp[i][j] = min(
//     dp[i-1][j]   + 1,          // delete a[i-1]
//     dp[i][j-1]   + 1,          // insert b[j-1]
//     dp[i-1][j-1] + sub_cost    // substitute (or match)
//   )
//   if i > 1 and j > 1 and a[i-1] == b[j-2] and a[i-2] == b[j-1]:
//     dp[i][j] = min(dp[i][j], dp[i-2][j-2] + 1)  // transposition
//
// NOTE: This is the Optimal String Alignment (OSA) variant, not the full
// Damerau-Levenshtein distance. OSA does not allow a sub-string to be edited
// more than once, which is sufficient for all practical spell-checking uses
// and matches the published KAT vectors.
//
// Byte-level: character identity is determined by ord(s[i]) (single byte per
// index, matching NOVA's string model). Multi-byte UTF-8 sequences are treated
// as sequences of individual bytes.
// ============================================================================

// _min2 returns the smaller of two ints.
fn _min2(a: int, b: int) -> int
    if a < b
        return a
    b

// _min3 returns the smallest of three ints.
fn _min3(a: int, b: int, c: int) -> int
    let m = a
    if b < m
        m = b
    if c < m
        m = c
    m

// dl_distance computes the Optimal String Alignment (Damerau-Levenshtein)
// edit distance between strings a and b. Transpositions of adjacent characters
// cost 1, equal to an insertion, deletion, or substitution.
fn dl_distance(a: string, b: string) -> int
    let m = len(a)
    let n = len(b)

    // Base cases: one string empty.
    if m == 0
        return n
    if n == 0
        return m

    // Build a flat list representing a (m+1) x (n+1) DP table.
    // Index mapping: dp[i][j] = dp_flat[i * (n+1) + j]
    // We store the entire table because the transposition case needs dp[i-2][j-2].
    let dp_flat = []

    // Initialise the whole table to 0 first (we overwrite every cell below).
    let total = (m + 1) * (n + 1)
    for t in 0..total
        dp_flat.push(0)

    // Row 0: dp[0][j] = j
    let j = 0
    while j <= n
        dp_flat[j] = j
        j += 1

    // Column 0: dp[i][0] = i
    let i = 1
    while i <= m
        dp_flat[i * (n + 1)] = i
        i += 1

    // Fill the rest of the table.
    i = 1
    while i <= m
        let ca = ord(a[i - 1])
        j = 1
        while j <= n
            let cb = ord(b[j - 1])
            let sub_cost = 1
            if ca == cb
                sub_cost = 0

            let del_val = dp_flat[(i - 1) * (n + 1) + j] + 1
            let ins_val = dp_flat[i * (n + 1) + (j - 1)] + 1
            let rep_val = dp_flat[(i - 1) * (n + 1) + (j - 1)] + sub_cost

            let best = _min3(del_val, ins_val, rep_val)

            // Transposition: a[i-1] == b[j-2] and a[i-2] == b[j-1]
            if i > 1 and j > 1
                let ca2 = ord(a[i - 2])
                let cb2 = ord(b[j - 2])
                if ca == cb2 and ca2 == cb
                    let trans_val = dp_flat[(i - 2) * (n + 1) + (j - 2)] + 1
                    best = _min2(best, trans_val)

            dp_flat[i * (n + 1) + j] = best
            j += 1
        i += 1

    dp_flat[m * (n + 1) + n]

// ============================================================================
fn main()
    print("std/text/damerau loaded")
