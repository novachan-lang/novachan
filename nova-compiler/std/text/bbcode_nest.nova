// ============================================================================
// NOVA Standard Library — std/text/bbcode_nest
// ============================================================================
// BBCode nesting analysis: tag depth, per-tag frequency, depth-limited
// flattening, and single/all-tag content lookup & replacement.
//
// A tag is any "[...]" span. One starting with "/" (e.g. "[/b]") is a
// closing tag; every other one (e.g. "[b]", "[url=x]", "[*]") is an
// opening tag whose name is the text before "=" (or the whole span).
//
// Public API:
//   bnst_max_depth(input)                  -> int    max tag nesting depth
//   bnst_tag_counts(input)                 -> dict   tag name -> open count
//   bnst_flatten(input, max_depth)         -> str    strip tags past max_depth
//   bnst_find_tag(input, tagname)          -> str    content of first [tagname]
//   bnst_replace_tag(input, tagname, repl) -> str    replace content of all
//                                                     [tagname]...[/tagname]
// ============================================================================

// Internal: find the next occurrence of needle in s starting at position start.
// Returns the index, or -1 if not found.
fn _bnst_find_from(s, needle, start) -> int
    let n = len(s)
    let nl = len(needle)
    let i = start
    let result = -1
    while i + nl <= n and result == -1
        let cand = slice(s, i, i + nl)
        if cand == needle
            result = i
        i += 1
    result

// Internal: tag name from the text between "[" and "]" (drops "=value").
fn _bnst_tag_name(inner) -> string
    let eq = _bnst_find_from(inner, "=", 0)
    if eq >= 0
        return slice(inner, 0, eq)
    inner

// bnst_max_depth returns the maximum tag nesting depth reached in input.
// A well-formed [a][b][/b][/a] has depth 2; unclosed tags simply never
// bring the depth back down (matches "worst case observed" semantics).
fn bnst_max_depth(input) -> int
    let n = len(input)
    let i = 0
    let depth = 0
    let maxd = 0
    while i < n
        if slice(input, i, i + 1) == "["
            let close = _bnst_find_from(input, "]", i + 1)
            if close >= 0
                let inner = slice(input, i + 1, close)
                if len(inner) > 0 and slice(inner, 0, 1) == "/"
                    if depth > 0
                        depth -= 1
                else
                    depth += 1
                    if depth > maxd
                        maxd = depth
                i = close + 1
            else
                i += 1
        else
            i += 1
    maxd

// bnst_tag_counts returns a dict mapping each tag name to the number of
// times it appears as an opening tag (closing tags are not counted).
fn bnst_tag_counts(input) -> any
    let d = {}
    let n = len(input)
    let i = 0
    while i < n
        if slice(input, i, i + 1) == "["
            let close = _bnst_find_from(input, "]", i + 1)
            if close >= 0
                let inner = slice(input, i + 1, close)
                if len(inner) > 0 and slice(inner, 0, 1) == "/"
                    i = close + 1
                else
                    let name = _bnst_tag_name(inner)
                    if len(name) > 0
                        if name in d
                            d[name] = d[name] + 1
                        else
                            d[name] = 1
                    i = close + 1
            else
                i += 1
        else
            i += 1
    d

// bnst_flatten strips every tag whose nesting depth exceeds max_depth,
// keeping the text content in place. Tags at depth <= max_depth (and
// their matching close) are preserved verbatim.
fn bnst_flatten(input, max_depth) -> str
    let n = len(input)
    let i = 0
    let out = ""
    let depth = 0
    let keep_stack = []
    while i < n
        if slice(input, i, i + 1) == "["
            let close = _bnst_find_from(input, "]", i + 1)
            if close >= 0
                let inner = slice(input, i + 1, close)
                if len(inner) > 0 and slice(inner, 0, 1) == "/"
                    if len(keep_stack) > 0
                        let keep = keep_stack.pop()
                        if keep == 1
                            out += "[" + inner + "]"
                        if depth > 0
                            depth -= 1
                else
                    let new_depth = depth + 1
                    let keep = 0
                    if new_depth <= max_depth
                        keep = 1
                    push(keep_stack, keep)
                    if keep == 1
                        out += "[" + inner + "]"
                    depth = new_depth
                i = close + 1
            else
                out += "["
                i += 1
        else
            out += slice(input, i, i + 1)
            i += 1
    out

// bnst_find_tag returns the text between the first [tagname] and its
// matching [/tagname], or "" if no such (opened-and-closed) tag exists.
fn bnst_find_tag(input, tagname) -> str
    let open_tag = "[" + tagname + "]"
    let close_tag = "[/" + tagname + "]"
    let start = _bnst_find_from(input, open_tag, 0)
    if start < 0
        return ""
    let content_start = start + len(open_tag)
    let end = _bnst_find_from(input, close_tag, content_start)
    if end < 0
        return ""
    slice(input, content_start, end)

// bnst_replace_tag replaces the content of every [tagname]...[/tagname]
// span with replacement, leaving the tags themselves untouched.
fn bnst_replace_tag(input, tagname, replacement) -> str
    let open_tag = "[" + tagname + "]"
    let close_tag = "[/" + tagname + "]"
    let ol = len(open_tag)
    let cl = len(close_tag)
    let n = len(input)
    let out_parts = []
    let i = 0
    while i < n
        if i + ol <= n and slice(input, i, i + ol) == open_tag
            let close = _bnst_find_from(input, close_tag, i + ol)
            if close >= 0
                push(out_parts, open_tag + replacement + close_tag)
                i = close + cl
            else
                push(out_parts, open_tag)
                i += ol
        else
            push(out_parts, slice(input, i, i + 1))
            i += 1
    let out = join(out_parts, "")
    out
