// ============================================================================
// NOVA Standard Library — std/text/box
// ============================================================================
// Draw an ASCII box (using "+", "-", "|") around a list of text lines.
//
// Public API:
//   box_draw(lines) -> string
//       Frame `lines` (a list of strings) with a simple ASCII box.
//       Every line is padded on the right to the widest line width.
//       The result is all box rows joined by chr(10) with NO trailing newline.
//       Structure (example: box_draw(["hi"])):
//           +----+
//           | hi |
//           +----+
//
//   box_draw_titled(title, lines) -> string
//       Like box_draw but the title text is embedded in the top border:
//           +-[ Title ]-+
//           | line one  |
//           +-----------+
//
// LEAF — imports NOTHING.

// ── private helpers ──────────────────────────────────────────────────────────

// Repeat the single-character string ch exactly n times ("" if n <= 0).
fn _box_rep(ch: string, n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + ch
        i = i + 1
    out

// Left-justify text to exactly `width` chars by appending spaces on the right.
// If len(text) >= width the string is returned unchanged (never truncates).
fn _box_ljust(text: string, width: int) -> string
    let pad = width - len(text)
    if pad <= 0
        return text
    text + _box_rep(" ", pad)

// Return the larger of two ints.
fn _box_max(a: int, b: int) -> int
    if a > b
        return a
    b

// Compute the maximum length across all strings in a list (0 if list is empty).
fn _box_max_len(lines: list) -> int
    let n = len(lines)
    let mx = 0
    let i = 0
    while i < n
        let ll = len(lines[i])
        mx = _box_max(mx, ll)
        i = i + 1
    mx

// ── public API ───────────────────────────────────────────────────────────────

// box_draw(lines) -> string
// Draw a simple ASCII box around the given lines, joined by chr(10).
// Empty list produces a minimal empty box:
//     +--+
//     |  |
//     +--+
//   (well: "++" top/bot with no content lines if lines is empty)
// More precisely, if lines is empty the returned box contains only top + bot.
//
// KAT reference:
//   box_draw(["hi"]) -> "+----+\n| hi |\n+----+"
//   box_draw(["a","bbb"]) ->
//       "+-----+\n| a   |\n| bbb |\n+-----+"
fn box_draw(lines: list) -> string
    let nl = chr(10)
    let n = len(lines)
    let inner = _box_max_len(lines)
    // Each line is displayed as: "| " + content_padded_to_inner + " |"
    // The total inner span (between the corner "+") = 1 + inner + 1 = inner + 2
    let span = inner + 2
    let top = "+" + _box_rep("-", span) + "+"
    let bot = top
    let out = top
    let i = 0
    while i < n
        let content = _box_ljust(lines[i], inner)
        out = out + nl + "| " + content + " |"
        i = i + 1
    out = out + nl + bot
    out

// box_draw_titled(title, lines) -> string
// Like box_draw but the title is embedded in the top border using "[ title ]".
// The top border looks like:  +-[ Title ]---------+
// The "[ title ]" occupies 4 + len(title) chars ("[ " + title + " ]" = 4+len).
// If the title is wider than the content, the box widens to fit.
//
// KAT reference:
//   box_draw_titled("Hi", ["abc"]) ->
//       "+-[ Hi ]-+\n| abc    |\n+---------+"
//   (inner=max(3,4+2)=6, span=8 dashes around "[ Hi ]" embedded)
//
// Detailed top-border construction:
//   total span = inner + 2 (same as box_draw)
//   "[ T ]" = "[ " + title + " ]"  length = len(title) + 4
//   remaining dashes = span - (len(title) + 4)
//   top = "+-[ " + title + " ]" + _box_rep("-", remaining) + "+"
//   If title + decoration > span we widen span to fit.
fn box_draw_titled(title: string, lines: list) -> string
    let nl = chr(10)
    let n = len(lines)
    let inner = _box_max_len(lines)
    // Decoration: "-[ " + title + " ]-"  wrapping the title in top border.
    // Pattern: "+" + "-[ " + title + " ]" + dashes + "+"
    // Min needed span (chars between the two '+') = len(title) + 4 + 0 trailing
    // but we want at least one trailing dash: len(title) + 5
    // For symmetry we use exactly: "-[ " + title + " ]-" (len+4) + trailing
    let title_seg = "-[ " + title + " ]-"
    // seg_len = len(title) + 5
    let seg_len = len(title_seg)
    // span must hold: seg_len chars PLUS at least 0 more dashes
    // We also need span >= inner + 2 so lines fit.
    let min_span = _box_max(inner + 2, seg_len)
    // trailing dashes in top border = min_span - seg_len
    let trailing = min_span - seg_len
    let top = "+" + title_seg + _box_rep("-", trailing) + "+"
    let bot = "+" + _box_rep("-", min_span) + "+"
    // Actual content width = min_span - 2 (strip the two side spaces "| " and " |")
    let content_width = min_span - 2
    let out = top
    let i = 0
    while i < n
        let content = _box_ljust(lines[i], content_width)
        out = out + nl + "| " + content + " |"
        i = i + 1
    out = out + nl + bot
    out
