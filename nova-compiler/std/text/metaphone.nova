// std/text/metaphone -- Simplified Metaphone phonetic encoding.
// LEAF -- imports NOTHING.
//
// Public API:
//   meta(s: string) -> string
//     Returns the Simplified Metaphone phonetic code for s.
//     Input is treated case-insensitively (uppercased internally).
//     Empty input returns "".
//
// Algorithm (Simplified Metaphone, deterministic subset):
//   1. Uppercase all characters.
//   2. Strip non-alpha characters.
//   3. Handle leading silent pairs:
//        AE -> drop A   KN -> drop K   GN -> drop G
//        PN -> drop P   WR -> drop W
//   4. Keep initial vowel; drop all subsequent vowels.
//   5. Consonant transforms (in order of precedence):
//        PH        -> F
//        TH        -> T
//        CK        -> K
//        CH        -> X
//        QU        -> K
//        TCH       -> SK  (not implemented; rare -- T before CH handled by T+CH separately)
//        C before E/I/Y -> S   otherwise -> K
//        D before GE/GI/GY -> J  otherwise -> T
//        G before H (preceded by vowel, or at end) -> silent
//        G before H (not preceded by vowel) -> K
//        G before E/I/Y -> J
//        otherwise G -> K
//        H before vowel and not after vowel -> H
//        otherwise H -> silent
//        K after C -> silent
//        W before vowel -> W   otherwise -> silent
//        X         -> KS
//        Y before vowel -> Y   otherwise -> silent
//        Z         -> S
//        V         -> F
//        Q         -> K
//        B         -> B
//        F         -> F
//        J         -> J
//        L         -> L
//        M         -> M
//        N         -> N
//        R         -> R
//        S         -> S
//   6. Drop duplicate adjacent phonetic codes.

// Uppercase a single character (A-Z); non-alpha returned as "".
fn _mp_up(c: string) -> string
    let o = ord(c)
    let r = ""
    if o >= 65 and o <= 90
        r = c
    else if o >= 97 and o <= 122
        r = chr(o - 32)
    r

// Strip non-alpha and uppercase: return cleaned string.
fn _mp_clean(s: string) -> string
    let n = len(s)
    let out = ""
    for i in 0..n
        let uc = _mp_up(char_at(s, i))
        if len(uc) > 0
            out += uc
    out

// Return 1 if character is a vowel (AEIOU), 0 otherwise.
fn _mp_is_vowel(c: string) -> int
    let r = 0
    if c == "A" or c == "E" or c == "I" or c == "O" or c == "U"
        r = 1
    r

// Safe char_at: returns "" if index out of range.
fn _mp_at(s: string, i: int) -> string
    let r = ""
    if i >= 0 and i < len(s)
        r = char_at(s, i)
    r

// Compute the Simplified Metaphone code for string s.
fn meta(s: string) -> string
    // Clean and uppercase.
    let w = _mp_clean(s)
    let n = len(w)
    if n == 0
        return ""

    // Handle leading silent pairs.
    let start = 0
    let c0 = _mp_at(w, 0)
    let c1 = _mp_at(w, 1)
    if c0 == "K" and c1 == "N"
        start = 1
    else if c0 == "G" and c1 == "N"
        start = 1
    else if c0 == "P" and c1 == "N"
        start = 1
    else if c0 == "W" and c1 == "R"
        start = 1

    let out_parts = []
    let i = start
    let prev_out = ""

    while i < n
        let c = _mp_at(w, i)
        let nx = _mp_at(w, i + 1)
        let nx2 = _mp_at(w, i + 2)
        let prev = ""
        if i > 0
            prev = _mp_at(w, i - 1)

        // Emit a phoneme string; "" = silent.
        let emit = ""
        let skip = 0

        if c == "A" or c == "E" or c == "I" or c == "O" or c == "U"
            // Vowels: keep only if this is the first position of the output.
            if i == start
                emit = c

        else if c == "B"
            emit = "B"

        else if c == "C"
            // CK -> K (consume C, next iter handles K -> silent after C).
            // CH -> X
            // C before E/I/Y -> S
            // else -> K
            if nx == "H"
                emit = "X"
                skip = 1
            else if nx == "K"
                emit = "K"
                skip = 1
            else if nx == "E" or nx == "I" or nx == "Y"
                emit = "S"
            else
                emit = "K"

        else if c == "D"
            // D before GE/GI/GY -> J, else T
            if nx == "G" and (nx2 == "E" or nx2 == "I" or nx2 == "Y")
                emit = "J"
                skip = 2
            else
                emit = "T"

        else if c == "F"
            emit = "F"

        else if c == "G"
            // GH: if preceded by vowel -> silent; else -> K
            if nx == "H"
                if _mp_is_vowel(prev) == 1 or prev == ""
                    // silent GH when preceded by vowel or at very start
                    emit = ""
                    skip = 1
                else
                    emit = "K"
                    skip = 1
            // GN at word start already handled; mid-word GN -> N (drop G)
            else if nx == "N"
                emit = ""
            // G before E/I/Y -> J
            else if nx == "E" or nx == "I" or nx == "Y"
                emit = "J"
            else
                emit = "K"

        else if c == "H"
            // H before vowel and not after vowel -> H, else silent
            if _mp_is_vowel(nx) == 1 and _mp_is_vowel(prev) == 0
                emit = "H"

        else if c == "J"
            emit = "J"

        else if c == "K"
            // K after C -> silent
            if prev == "C"
                emit = ""
            else
                emit = "K"

        else if c == "L"
            emit = "L"

        else if c == "M"
            emit = "M"

        else if c == "N"
            emit = "N"

        else if c == "P"
            // PH -> F
            if nx == "H"
                emit = "F"
                skip = 1
            else
                emit = "P"

        else if c == "Q"
            emit = "K"

        else if c == "R"
            emit = "R"

        else if c == "S"
            // SH, SIO, SIA -> X
            if nx == "H"
                emit = "X"
                skip = 1
            else if nx == "I" and (nx2 == "A" or nx2 == "O")
                emit = "X"
            else
                emit = "S"

        else if c == "T"
            // TH -> T
            if nx == "H"
                emit = "T"
                skip = 1
            else if nx == "I" and (nx2 == "A" or nx2 == "O")
                emit = "X"
            else
                emit = "T"

        else if c == "V"
            emit = "F"

        else if c == "W"
            // W before vowel -> W, else silent
            if _mp_is_vowel(nx) == 1
                emit = "W"

        else if c == "X"
            emit = "KS"

        else if c == "Y"
            // Y before vowel -> Y, else silent
            if _mp_is_vowel(nx) == 1
                emit = "Y"

        else if c == "Z"
            emit = "S"

        // Append emit to output (drop duplicate adjacent single-char codes).
        if len(emit) > 0
            // For multi-char emits (KS, SK) we always append.
            if len(emit) > 1
                push(out_parts, emit)
                prev_out = slice(emit, len(emit) - 1, len(emit))
            else
                if emit != prev_out
                    push(out_parts, emit)
                    prev_out = emit

        i += 1 + skip

    let out = join(out_parts, "")
    out
