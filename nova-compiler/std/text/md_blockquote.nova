// ============================================================================
// NOVA Standard Library — std/text/md_blockquote
// ============================================================================
// Markdown blockquote rendering.
//
// Public API:
//   md_blockquote(text) -> string
//       Convert a block of Markdown blockquote lines to HTML.
//       Lines starting "> " have that prefix stripped; the remaining content
//       lines are joined with chr(10) and wrapped in <blockquote>...</blockquote>.
//       Lines that do NOT start with "> " are passed through unchanged as-is
//       (no wrapping).
//
// LEAF — imports NOTHING.
// ============================================================================

// _md_bq_split: split s on chr(10); trailing empty element dropped.
fn _md_bq_split(s) -> list
    let nl = chr(10)
    let raw = split(s, nl)
    let rlen = len(raw)
    if rlen > 0 and len(raw[rlen - 1]) == 0
        let out = []
        for i in 0..(rlen - 1)
            out += [raw[i]]
        return out
    raw

// md_blockquote(text) -> string
fn md_blockquote(text) -> string
    let nl = chr(10)
    let lines = _md_bq_split(text)
    let n = len(lines)
    if n == 0
        return ""
    // Collect blockquote content lines
    let content = ""
    let count = 0
    for i in 0..n
        let line = lines[i]
        if len(line) >= 2 and slice(line, 0, 2) == "> "
            let item = slice(line, 2, len(line))
            if count > 0
                content += nl + item
            else
                content = item
            count += 1
    if count == 0
        return text
    "<blockquote>" + content + "</blockquote>"
