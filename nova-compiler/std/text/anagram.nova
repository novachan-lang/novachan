// ============================================================================
// NOVA Standard Library — std/text/anagram
// ============================================================================
// Anagram utilities: signature key, membership test, and group-by clustering.
//
// Public API:
//   an_sort_key(s)          -> string
//     Returns the canonical anagram signature: lowercase alphanumeric characters
//     of s, sorted lexicographically.  "Hello" -> "ehllo",  "cba" -> "abc".
//
//   an_is_anagram(a, b)     -> int (bool)
//     Returns 1 iff a and b are anagrams (same signature after stripping
//     non-alphanumeric characters and folding case).
//
//   an_group(words)         -> list of lists
//     Groups the strings in words by anagram signature.  Each inner list is
//     sorted lexicographically; the outer list is sorted by the first element
//     of each group for full determinism.  Single-word groups are included.
//
// Design notes:
//   - Signature: O(n log n) via insertion sort on per-char list.
//   - an_group: O(w * k log k), w = word count, k = max group size.
//   - Module tag: _ang_ (all private helpers prefixed _ang_).
// ============================================================================

// ── private helpers ──────────────────────────────────────────────────────────

// _ang_is_alnum: returns 1 if ASCII code o is alphanumeric (a-z, A-Z, 0-9).
fn _ang_is_alnum(o) -> int
    let r = 0
    if o >= 48 and o <= 57
        r = 1
    else if o >= 65 and o <= 90
        r = 1
    else if o >= 97 and o <= 122
        r = 1
    r

// _ang_to_lower_code: fold uppercase A-Z to a-z; leave everything else unchanged.
fn _ang_to_lower_code(o) -> int
    let r = o
    if o >= 65 and o <= 90
        r = o + 32
    r

// _ang_insertion_sort: sort a list of single-character strings in place
// (ascending by ordinal value).  Returns the same list after sorting.
fn _ang_insertion_sort(chars) -> list
    let n = len(chars)
    for i in 1..n
        let key = chars[i]
        let ko = ord(key)
        let j = i - 1
        let done = 0
        while j >= 0 and done == 0
            if ord(chars[j]) > ko
                chars[j + 1] = chars[j]
                j -= 1
            else
                done = 1
        chars[j + 1] = key
    chars

// _ang_str_lt: returns 1 if string a is lexicographically less than string b.
fn _ang_str_lt(a, b) -> int
    let na = len(a)
    let nb = len(b)
    let limit = na
    if nb < limit
        limit = nb
    let i = 0
    let decided = 0
    let result = 0
    while i < limit and decided == 0
        let oa = ord(char_at(a, i))
        let ob = ord(char_at(b, i))
        if oa < ob
            result = 1
            decided = 1
        else if oa > ob
            decided = 1
        i += 1
    if decided == 0
        if na < nb
            result = 1
    result

// _ang_sort_strings: return a new list containing the same strings sorted
// lexicographically ascending.  Uses repeated minimum scan (selection sort)
// with a shrinking working copy to avoid in-place swap complexity.
fn _ang_sort_strings(lst) -> list
    let n = len(lst)
    // Copy lst into a mutable working array.
    let work = []
    for k in 0..n
        work.push(lst[k])
    // Repeatedly extract the minimum from work[0..remaining) into sorted output.
    let sorted = []
    let remaining = n
    while remaining > 0
        // Find index of the lexicographically smallest element.
        let mi = 0
        for i in 1..remaining
            if _ang_str_lt(work[i], work[mi]) == 1
                mi = i
        sorted.push(work[mi])
        // Shift elements after mi left by one to fill the gap.
        let fill = mi
        while fill < remaining - 1
            work[fill] = work[fill + 1]
            fill += 1
        remaining -= 1
    sorted

// ── public API ───────────────────────────────────────────────────────────────

// an_sort_key: compute the canonical anagram signature of s.
// Collects only alphanumeric characters, lowercases them, sorts the resulting
// character list, then joins it back into a string.
fn an_sort_key(s) -> string
    let slen = len(s)
    let chars = []
    for i in 0..slen
        let o = ord(char_at(s, i))
        if _ang_is_alnum(o) == 1
            let lo = _ang_to_lower_code(o)
            chars.push(chr(lo))
    _ang_insertion_sort(chars)
    let result_parts = []
    let j = 0
    let clen = len(chars)
    while j < clen
        push(result_parts, chars[j])
        j += 1
    let result = join(result_parts, "")
    result

// an_is_anagram: returns 1 iff a and b have the same anagram signature.
fn an_is_anagram(a, b) -> int
    let r = 0
    if an_sort_key(a) == an_sort_key(b)
        r = 1
    r

// an_group: group a list of strings by anagram signature.
// Each group is sorted lexicographically; the outer list is sorted by the
// first element of each inner group for full determinism.
fn an_group(words) -> list
    let n = len(words)
    // Build dict: anagram signature -> list of matching words.
    let sig_dict = {}
    for i in 0..n
        let w = words[i]
        let sig = an_sort_key(w)
        if sig in sig_dict
            sig_dict[sig].push(w)
        else
            let grp = []
            grp.push(w)
            sig_dict[sig] = grp
    // Collect all signatures and sort for deterministic outer ordering.
    let sigs = keys(sig_dict)
    let sorted_sigs = _ang_sort_strings(sigs)
    // For each signature (in sorted order), sort the group and append to result.
    let result = []
    let j = 0
    let nsigs = len(sorted_sigs)
    while j < nsigs
        let sig = sorted_sigs[j]
        let grp = sig_dict[sig]
        let sorted_grp = _ang_sort_strings(grp)
        result.push(sorted_grp)
        j += 1
    result
