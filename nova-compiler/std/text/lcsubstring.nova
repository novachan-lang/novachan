// ============================================================================
// NOVA Standard Library — std/text/lcsubstring
// ============================================================================
// Longest common SUBSTRING (contiguous, not subsequence).
//
// Public API:
//   lcstr_length(a, b)     -> int    length of the longest common substring
//   lcstr_longest(a, b)    -> string one longest common substring (first found)
//   lcstr_similarity(a, b) -> float  2*length / (len(a)+len(b)); 0.0 if both empty
//
// Algorithm: Classic O(m*n) DP.
//   dp[i*(n+1)+j] = length of longest common substring ending at a[i-1] / b[j-1].
//   When a[i-1] == b[j-1]: dp[i][j] = dp[i-1][j-1] + 1, else 0.
//   Track best length + the row i at which the best ended => extract via slice().
//
// Space: O(n) using two rolling rows for lcstr_length; O(m*n) flat list for
//   lcstr_longest (needed to recover the actual substring position).
//
// NOVA Gotchas applied here:
//   - 'and'/'or' not '&&'/'||'.
//   - Big float return needs an intermediate let (uninit-slot bug).
//   - '/' on two ints is integer division; multiply by 1.0 before dividing.
//   - No multi-line list/dict literals; build row by row.
//   - slice(s, lo, hi) end-EXCLUSIVE on strings.
//   - Every private helper prefixed with _lcstr_ (unique per-module tag).
// ============================================================================

// ── lcstr_length ──────────────────────────────────────────────────────────────

// lcstr_length returns the length of the longest common substring of a and b.
// Uses two rolling rows: O(m*n) time, O(n) space.
fn lcstr_length(a, b) -> int
    let m = len(a)
    let n = len(b)
    if m == 0 or n == 0
        return 0

    // prev row: dp[0][0..n] = all zeros (no characters consumed from a yet)
    let prev = []
    let j = 0
    while j <= n
        prev = prev + [0]
        j = j + 1

    let best = 0
    let i = 1
    while i <= m
        // curr row starts with dp[i][0] = 0
        let curr = [0]
        let ca = ord(slice(a, i - 1, i))
        let k = 1
        while k <= n
            let cb = ord(slice(b, k - 1, k))
            let v = 0
            if ca == cb
                v = prev[k - 1] + 1
            if v > best
                best = v
            curr = curr + [v]
            k = k + 1
        prev = curr
        i = i + 1
    best

// ── _lcstr_idx (private helper) ───────────────────────────────────────────────

// _lcstr_idx computes the flat-list index for dp[i][j] in an (m+1)*(n+1) table.
fn _lcstr_idx(i, n, j) -> int
    i * (n + 1) + j

// ── lcstr_longest ─────────────────────────────────────────────────────────────

// lcstr_longest returns one longest common substring of a and b.
// Builds the full (m+1)*(n+1) DP table as a flat list (O(m*n) space) so that
// the best ending position can be located and the substring sliced out.
fn lcstr_longest(a, b) -> string
    let m = len(a)
    let n = len(b)
    if m == 0 or n == 0
        return ""

    // Allocate flat table: (m+1)*(n+1) zeros, row-major.
    let dp = []
    let total = (m + 1) * (n + 1)
    let fill = 0
    while fill < total
        dp = dp + [0]
        fill = fill + 1

    let best_len = 0
    let best_end_i = 0   // row index i (1-based) where best ends in a

    let i = 1
    while i <= m
        let ca = ord(slice(a, i - 1, i))
        let k = 1
        while k <= n
            let cb = ord(slice(b, k - 1, k))
            if ca == cb
                let diag = dp[_lcstr_idx(i - 1, n, k - 1)]
                let nv = diag + 1
                let pos = _lcstr_idx(i, n, k)
                dp[pos] = nv
                if nv > best_len
                    best_len = nv
                    best_end_i = i
            k = k + 1
        i = i + 1

    if best_len == 0
        return ""

    // The substring in a ends at index best_end_i (exclusive) and has
    // length best_len, so it starts at best_end_i - best_len (0-based).
    let start = best_end_i - best_len
    slice(a, start, best_end_i)

// ── lcstr_similarity ──────────────────────────────────────────────────────────

// lcstr_similarity returns 2 * lcstr_length(a,b) / (len(a) + len(b)).
// Returns 0.0 when both strings are empty (by convention).
fn lcstr_similarity(a, b) -> float
    let la = len(a)
    let lb = len(b)
    if la == 0 and lb == 0
        return 0.0
    let llen = lcstr_length(a, b)
    let num = (2 * llen) * 1.0
    let den = (la + lb) * 1.0
    let result = num / den
    result

// ============================================================================
fn main()
    print("std/text/lcsubstring loaded")
