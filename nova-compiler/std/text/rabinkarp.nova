// ============================================================================
// NOVA Standard Library — std/text/rabinkarp
// ============================================================================
// Rabin-Karp substring search using a polynomial rolling hash.
// Hash basis: base 256 (byte values), modulus 1_000_000_007 (a large prime).
// All arithmetic stays within i64 range: max intermediate value is
//   255 * 1_000_000_007 < 2.56e11 << 2^63, so no overflow occurs.
//
// Public API:
//   rk_search(text, pat)     -> int    first index of pat in text; -1 if absent.
//                                      Verifies each hash hit char-by-char to
//                                      eliminate false positives.
//   rk_search_all(text, pat) -> list   list of ALL start indices (left to right);
//                                      [] if pat is not found.
//   rk_count(text, pat)      -> int    total count of ALL occurrences of pat
//                                      in text (including overlapping windows).
//
// Complexity:
//   rk_search     — O(n+m) expected, O(nm) worst-case (hash collisions rare).
//   rk_search_all — O(n+m) expected per match; O(n) total expected.
//   rk_count      — O(n+m) expected; slides one position at a time (counts overlaps).
//
// All private helpers are prefixed _rk_ to avoid name collisions.
// ============================================================================

// ── constants ─────────────────────────────────────────────────────────────────

// _RK_BASE: polynomial base for rolling hash (256 = one byte per position).
let _RK_BASE = 256

// _RK_MOD: large prime modulus. 1_000_000_007 ensures hash values stay
// well within i64 even after a multiply-add: 255 * 1_000_000_007 ≈ 2.55e11.
let _RK_MOD = 1000000007

// ── private helpers ───────────────────────────────────────────────────────────

// _rk_pow: compute (_RK_BASE ^ exp) mod _RK_MOD iteratively.
// Used to build the leading-digit weight pow_val = BASE^(m-1) mod MOD.
fn _rk_pow(exp) -> int
    let result = 1
    let base = _RK_BASE
    let modv = _RK_MOD
    let e = exp
    while e > 0
        result = (result * base) % modv
        e -= 1
    result

// _rk_hash: compute the Rabin hash of string s[lo .. lo+length-1] (inclusive).
// Each character ord value is folded in left-to-right:
//   h = (h * BASE + byte) mod MOD
// This gives the same result as the rolling-hash initial window.
fn _rk_hash(s, lo, length) -> int
    let h = 0
    let modv = _RK_MOD
    let base = _RK_BASE
    for i in 0..length
        let b = ord(s[lo + i])
        h = (h * base + b) % modv
    h

// _rk_match: verify that s[si .. si+m-1] == pat[0 .. m-1] character by character.
// Called after a hash match to eliminate false positives.
// Returns 1 if all characters agree, 0 otherwise.
fn _rk_match(s, si, pat, m) -> int
    let ok = 1
    let i = 0
    while i < m
        if ord(s[si + i]) != ord(pat[i])
            ok = 0
            i = m
        else
            i += 1
    ok

// ── public API ────────────────────────────────────────────────────────────────

// rk_search returns the index of the FIRST occurrence of pat in text,
// or -1 if pat is not found.
//
// Algorithm:
//   1. Compute hash of pat and hash of text[0..m-1].
//   2. Slide the window one position at a time, updating the rolling hash:
//        new_h = (BASE * (old_h - leading_byte * pow_val) + new_byte) mod MOD
//      The subtraction may go negative; we add MOD before taking mod.
//   3. On hash match, verify the window char-by-char (O(m)) to confirm.
fn rk_search(text, pat) -> int
    let n = len(text)
    let m = len(pat)
    if m == 0
        return 0
    if m > n
        return -1

    let modv = _RK_MOD
    let base = _RK_BASE
    let pow_val = _rk_pow(m - 1)
    let h_pat = _rk_hash(pat, 0, m)
    let h_txt = _rk_hash(text, 0, m)
    let result = -1
    let done = 0

    // Check the very first window.
    if h_txt == h_pat
        if _rk_match(text, 0, pat, m) == 1
            result = 0
            done = 1

    // Slide from position 1 to n-m (inclusive).
    let i = 0
    while i < n - m and done == 0
        // Remove leading character, shift, add new trailing character.
        // Rolling hash: h_new = (BASE * (h_old - lead * BASE^(m-1)) + trail) mod MOD
        // Subtract leading byte's contribution; result may be negative, so add MOD.
        let lead = ord(text[i])
        let trail = ord(text[i + m])
        let lead_contrib = (lead * pow_val) % modv
        let shifted = h_txt - lead_contrib
        if shifted < 0
            shifted += modv
        h_txt = ((base * shifted) + trail) % modv
        let next_i = i + 1
        if h_txt == h_pat
            if _rk_match(text, next_i, pat, m) == 1
                result = next_i
                done = 1
        i = next_i

    result

// rk_search_all returns a list of ALL start indices where pat occurs in text,
// including overlapping occurrences (e.g. rk_search_all("aaaa","aa") == [0,1,2]).
// Returns [] if pat is not present.
fn rk_search_all(text, pat) -> list
    let n = len(text)
    let m = len(pat)
    let hits = []
    if m == 0
        return hits
    if m > n
        return hits

    let modv = _RK_MOD
    let base = _RK_BASE
    let pow_val = _rk_pow(m - 1)
    let h_pat = _rk_hash(pat, 0, m)
    let h_txt = _rk_hash(text, 0, m)

    // Check the first window.
    if h_txt == h_pat
        if _rk_match(text, 0, pat, m) == 1
            hits.push(0)

    // Slide from position 1 to n-m (inclusive).
    let i = 0
    while i < n - m
        let lead = ord(text[i])
        let trail = ord(text[i + m])
        let lead_contrib = (lead * pow_val) % modv
        let shifted = h_txt - lead_contrib
        if shifted < 0
            shifted += modv
        h_txt = ((base * shifted) + trail) % modv
        let next_i = i + 1
        if h_txt == h_pat
            if _rk_match(text, next_i, pat, m) == 1
                hits.push(next_i)
        i = next_i

    hits

// rk_count returns the total number of occurrences of pat in text,
// including overlapping occurrences (e.g. "issi" in "mississippi" occurs at
// positions 1 and 4, so rk_count returns 2 even though those windows overlap).
// The rolling hash slides one position at a time — same as rk_search_all but
// returns the count rather than building the full list.
// Returns 0 if pat is not present.
fn rk_count(text, pat) -> int
    let n = len(text)
    let m = len(pat)
    if m == 0
        return 0
    if m > n
        return 0

    let modv = _RK_MOD
    let base = _RK_BASE
    let pow_val = _rk_pow(m - 1)
    let h_pat = _rk_hash(pat, 0, m)
    let h_txt = _rk_hash(text, 0, m)
    let count = 0

    // Check first window.
    if h_txt == h_pat
        if _rk_match(text, 0, pat, m) == 1
            count += 1

    // Slide one position at a time; count every matching window.
    let i = 0
    while i < n - m
        let lead = ord(text[i])
        let trail = ord(text[i + m])
        let lead_contrib = (lead * pow_val) % modv
        let shifted = h_txt - lead_contrib
        if shifted < 0
            shifted += modv
        h_txt = ((base * shifted) + trail) % modv
        let next_i = i + 1
        if h_txt == h_pat
            if _rk_match(text, next_i, pat, m) == 1
                count += 1
        i = next_i

    count

// ============================================================================
fn main()
    print("std/text/rabinkarp loaded")
