// ============================================================================
// NOVA Standard Library — whitespace module
// ============================================================================
// Whitespace normalization utilities. Whitespace = space (32), tab (9),
// newline (10), carriage-return (13). Pure NOVA; uses only builtin ord/chr/len
// and the native trim (which already strips all four chars) for ws_trim.
//
// Public API:
//   ws_trim(s)      -> str   leading/trailing whitespace removed
//   ws_collapse(s)  -> str   trim + collapse internal runs to a single space
//   ws_squeeze(s)   -> str   collapse internal whitespace runs to one space
//                            (no trim — leading/trailing single space kept if present)
//   ws_strip_all(s) -> str   remove ALL whitespace characters
//   ws_is_blank(s)  -> bool  true iff s is empty or contains only whitespace

// Returns true if the character at position i in s is a whitespace character.
fn _is_ws(c) -> bool
    let o = ord(c)
    if o == 32 then return true   // space
    if o == 9  then return true   // tab
    if o == 10 then return true   // newline
    if o == 13 then return true   // carriage-return
    false

// Leading/trailing whitespace removed. Delegates to the native trim builtin
// which already handles space/tab/LF/CR.
fn ws_trim(s) -> str
    trim(s)

// Trim leading/trailing whitespace, then collapse every run of one or more
// internal whitespace characters to a single space.
fn ws_collapse(s) -> str
    let t = trim(s)
    let out = ""
    let n = len(t)
    let i = 0
    let in_ws = false
    while i < n
        let ch = t[i]
        if _is_ws(ch)
            if not in_ws
                out = out + " "
                in_ws = true
        else
            out = out + ch
            in_ws = false
        i = i + 1
    out

// Collapse every run of internal whitespace to a single space. Unlike
// ws_collapse, leading/trailing whitespace is preserved as a single space
// (if present), not removed.
fn ws_squeeze(s) -> str
    let out = ""
    let n = len(s)
    let i = 0
    let in_ws = false
    while i < n
        let ch = s[i]
        if _is_ws(ch)
            if not in_ws
                out = out + " "
                in_ws = true
        else
            out = out + ch
            in_ws = false
        i = i + 1
    out

// Remove every whitespace character from s.
fn ws_strip_all(s) -> str
    let out_parts = []
    let n = len(s)
    for i in 0..n
        let ch = s[i]
        if not _is_ws(ch)
            push(out_parts, ch)
    let out = join(out_parts, "")
    out

// True iff s is empty or contains only whitespace characters.
fn ws_is_blank(s) -> bool
    let n = len(s)
    if n == 0 then return true
    for i in 0..n
        if not _is_ws(s[i])
            return false
    true
