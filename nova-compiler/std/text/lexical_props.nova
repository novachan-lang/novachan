// std/text/lexical_props.nova — pangram / isogram / palindrome-rearrangement checks.
// KAT: test_programs/_kat_fleet7.nova
// LEAF — imports NOTHING.
//
// Lexical wordplay properties over the 26 English letters. All checks fold
// case and ignore non-letter characters (digits, spaces, punctuation).
//
// Public API:
//   lxp_letter_count(s)      -> dict   a-z -> occurrence count (0 if absent)
//   lxp_is_pangram(s)        -> bool   true iff every letter a-z appears >= 1x
//   lxp_missing_letters(s)   -> string letters (a-z, ascending) absent from s;
//                                      "" iff s is already a pangram
//   lxp_is_isogram(s)        -> bool   true iff no letter appears more than once
//                                      (empty string / no letters -> true)
//   lxp_can_form_palindrome(s) -> bool true iff the letters of s can be
//                                      reordered into a palindrome, i.e. at
//                                      most one letter has an odd count
//
// Complexity: every function is O(len(s)) (one pass to build the 26-slot
// count table, one O(26) pass to answer the query).

// _lxp_alphabet — the 26 lowercase letters, ascending. Shared constant.
fn _lxp_alphabet() -> string
    return "abcdefghijklmnopqrstuvwxyz"

// lxp_letter_count — a-z -> occurrence count in s, case-folded, ignoring any
// character that is not an ASCII letter.
fn lxp_letter_count(s: string) -> dict
    let alphabet = _lxp_alphabet()
    let counts = {}
    for ai in 0..26
        counts[char_at(alphabet, ai)] = 0
    let n = len(s)
    for i in 0..n
        let c = lower(char_at(s, i))
        if find(alphabet, c) >= 0
            counts[c] = counts[c] + 1
    return counts

fn lxp_is_pangram(s: string) -> bool
    let counts = lxp_letter_count(s)
    let alphabet = _lxp_alphabet()
    for ai in 0..26
        let c = char_at(alphabet, ai)
        if counts[c] == 0
            return false
    return true

fn lxp_missing_letters(s: string) -> string
    let counts = lxp_letter_count(s)
    let alphabet = _lxp_alphabet()
    let out_parts = []
    for ai in 0..26
        let c = char_at(alphabet, ai)
        if counts[c] == 0
            push(out_parts, c)
    let out = join(out_parts, "")
    return out

fn lxp_is_isogram(s: string) -> bool
    let counts = lxp_letter_count(s)
    let alphabet = _lxp_alphabet()
    for ai in 0..26
        let c = char_at(alphabet, ai)
        if counts[c] > 1
            return false
    return true

fn lxp_can_form_palindrome(s: string) -> bool
    let counts = lxp_letter_count(s)
    let alphabet = _lxp_alphabet()
    let ai = 0
    let odd_count = 0
    while ai < 26
        let c = char_at(alphabet, ai)
        if counts[c] % 2 == 1
            odd_count += 1
        ai += 1
    return odd_count <= 1
