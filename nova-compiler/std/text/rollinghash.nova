// ============================================================================
// NOVA Standard Library — std/text/rollinghash
// ============================================================================
// Polynomial prefix-hash toolkit for O(1) substring hash comparison. This is
// a DIFFERENT tool from the existing search algorithms (kmp.nova,
// boyermoore.nova, rabinkarp.nova, zalgorithm.nova): those return match
// positions for ONE pattern scanned once. rollinghash instead precomputes a
// reusable prefix-hash table over a string so that ANY two substrings of it
// can be compared for equality in O(1) after that one-time O(n) build — the
// classic toolkit for suffix comparison, binary-search LCP, and repeated
// substring-equality queries without re-scanning characters each time.
//
// Representation (dict h):
//   "s"      -> the original string
//   "n"      -> its length
//   "prefix" -> list of int, length n+1; prefix[i] = polynomial hash of s[0..i)
//   "pow"    -> list of int, length n+1; pow[i] = base^i mod modulus
//   "base"   -> int polynomial base (131)
//   "mod"    -> int modulus (1_000_000_007)
//
// Public API (prefix rh_):
//   rh_build(s)                        -> dict
//   rh_len(h)                          -> int
//   rh_hash(h, l, r)                   -> int    (hash of s[l..r), 0<=l<=r<=n)
//   rh_equal(h, l1, r1, l2, r2)        -> bool   (O(1) substring equality)
//   rh_find(h, pattern)                -> list   (all start indices of pattern in s)
//   rh_lcp(h, i, j)                    -> int    (longest common prefix of suffixes i, j)
//
// rh_find uses the hash as a fast O(1) pre-filter but ALWAYS verifies a
// candidate with a direct character comparison before reporting it — this
// guarantees zero false positives from hash collisions (the hash only
// controls how many candidates need verifying, never correctness).
// ============================================================================

// rh_build: precompute prefix hashes and base powers for `s`.
fn rh_build(s) -> dict
    let n = len(s)
    let base = 131
    let modv = 1000000007
    let prefix = []
    let powl = []
    prefix.push(0)
    powl.push(1)
    let i = 0
    while i < n
        let c = ord(char_at(s, i)) + 1
        let prev = prefix[i]
        let np = (prev * base + c) % modv
        prefix.push(np)
        let pp = (powl[i] * base) % modv
        powl.push(pp)
        i = i + 1
    let h = {}
    h["s"] = s
    h["n"] = n
    h["prefix"] = prefix
    h["pow"] = powl
    h["base"] = base
    h["mod"] = modv
    h

// rh_len: length of the original string.
fn rh_len(h) -> int
    h["n"]

// rh_hash: hash of s[l..r) (0 <= l <= r <= n).
fn rh_hash(h, l, r) -> int
    let prefix = h["prefix"]
    let powl = h["pow"]
    let modv = h["mod"]
    let hi = prefix[r]
    let lo = (prefix[l] * powl[r - l]) % modv
    let v = (hi - lo) % modv
    if v < 0
        v = v + modv
    v

// rh_equal: O(1) equality check between s[l1..r1) and s[l2..r2).
fn rh_equal(h, l1, r1, l2, r2) -> bool
    if (r1 - l1) != (r2 - l2)
        return false
    rh_hash(h, l1, r1) == rh_hash(h, l2, r2)

// _rh_direct_eq: verify pattern == s[start .. start+m) by direct char compare.
fn _rh_direct_eq(s, start, pattern, m) -> bool
    for k in 0..m
        if char_at(s, start + k) != char_at(pattern, k)
            return false
    true

// rh_find: every start index i in h's string where s[i..i+len(pattern)) ==
// pattern, scanning left-to-right. Hash pre-filter + direct verification.
fn rh_find(h, pattern) -> list
    let n = h["n"]
    let m = len(pattern)
    let out = []
    if m == 0 or m > n
        return out
    let ph = rh_build(pattern)
    let target = rh_hash(ph, 0, m)
    let s = h["s"]
    let i = 0
    let last = n - m
    while i <= last
        if rh_hash(h, i, i + m) == target
            if _rh_direct_eq(s, i, pattern, m)
                out.push(i)
        i = i + 1
    out

// rh_lcp: longest common prefix length between suffixes s[i:] and s[j:],
// found via binary search over rh_equal (O(1) compares).
fn rh_lcp(h, i, j) -> int
    let n = h["n"]
    let maxlen = n - i
    if n - j < maxlen
        maxlen = n - j
    let lo = 0
    let hi = maxlen
    while lo < hi
        let mid = (lo + hi + 1) / 2
        if rh_equal(h, i, i + mid, j, j + mid)
            lo = mid
        else
            hi = mid - 1
    lo

// ============================================================================
fn main()
    print("std/text/rollinghash loaded")
