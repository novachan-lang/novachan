// std/lambda/lambda_subst — Capture-avoiding substitution for lambda calculus (de Bruijn)
//
// TERM REPRESENTATION (tagged lists):
//   ["var", k]    — variable with de Bruijn index k
//   ["lam", body] — lambda abstraction; body is a term
//   ["app", f, a] — application of f to a
//
// subst(j, s, t): substitute term s for the variable with index j in t.
// subst_top(s, t): beta-ready substitution = shift(-1,0,subst(0,shift(1,0,s),t)).
// All public functions are prefixed lsb_.

// _lsb_mk_var: internal helper to build a variable term.
fn _lsb_mk_var(k) -> list
    return ["var", k]

// _lsb_mk_lam: internal helper to build a lambda abstraction.
fn _lsb_mk_lam(body) -> list
    return ["lam", body]

// _lsb_mk_app: internal helper to build an application.
fn _lsb_mk_app(f, a) -> list
    return ["app", f, a]

// _lsb_shift: add d to every free variable index (>= c) in t.
// Internal copy of shift — this module is self-contained.
fn _lsb_shift(d, c, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        return _lsb_mk_var(k + d if k >= c else k)
    if tag == "lam"
        return _lsb_mk_lam(_lsb_shift(d, c + 1, t[1]))
    // tag == "app"
    return _lsb_mk_app(_lsb_shift(d, c, t[1]), _lsb_shift(d, c, t[2]))

// lsb_subst: substitute term s for variable index j in term t.
// Implements capture-avoiding substitution with de Bruijn indices.
//   subst(j,s,["var",k])   = s         if k==j
//                           = ["var",k] otherwise
//   subst(j,s,["lam",b])   = ["lam", subst(j+1, shift(1,0,s), b)]
//   subst(j,s,["app",f,a]) = ["app", subst(j,s,f), subst(j,s,a)]
fn lsb_subst(j, s, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        return s if k == j else _lsb_mk_var(k)
    if tag == "lam"
        return _lsb_mk_lam(lsb_subst(j + 1, _lsb_shift(1, 0, s), t[1]))
    // tag == "app"
    return _lsb_mk_app(lsb_subst(j, s, t[1]), lsb_subst(j, s, t[2]))

// lsb_subst_top: the full beta-reduction substitution.
// For a redex (app (lam body) s), computes:
//   shift(-1, 0, subst(0, shift(1, 0, s), body))
// This correctly substitutes s into the lambda body and removes the binder level.
fn lsb_subst_top(s, t) -> list
    let s2 = _lsb_shift(1, 0, s)
    let t2 = lsb_subst(0, s2, t)
    return _lsb_shift(-1, 0, t2)
