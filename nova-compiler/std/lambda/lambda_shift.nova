// std/lambda/lambda_shift — de Bruijn index shifting for lambda calculus terms
//
// TERM REPRESENTATION (tagged lists):
//   ["var", k]    — variable with de Bruijn index k
//   ["lam", body] — lambda abstraction; body is a term
//   ["app", f, a] — application of f to a
//
// shift(d, c, t): add d to every FREE variable (index >= c) in t.
// All public functions are prefixed lsh_.

// _lsh_mk_var: internal helper to build a variable term.
fn _lsh_mk_var(k) -> list
    let t = []
    push(t, "var")
    push(t, k)
    return t

// _lsh_mk_lam: internal helper to build a lambda abstraction.
fn _lsh_mk_lam(body) -> list
    let t = []
    push(t, "lam")
    push(t, body)
    return t

// _lsh_mk_app: internal helper to build an application.
fn _lsh_mk_app(f, a) -> list
    let t = []
    push(t, "app")
    push(t, f)
    push(t, a)
    return t

// lsh_shift: add d to every free variable index (>= c) in term t.
// d may be negative (for use in beta-contraction).
fn lsh_shift(d, c, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        if k >= c
            return _lsh_mk_var(k + d)
        return _lsh_mk_var(k)
    if tag == "lam"
        let body2 = lsh_shift(d, c + 1, t[1])
        return _lsh_mk_lam(body2)
    // tag == "app"
    let f2 = lsh_shift(d, c, t[1])
    let a2 = lsh_shift(d, c, t[2])
    return _lsh_mk_app(f2, a2)

// lsh_lift: shift all free variables up by 1 (equivalent to shift(1,0,t)).
fn lsh_lift(t) -> list
    return lsh_shift(1, 0, t)

// _lsh_free_vars_aux: collect free variable indices at binder-depth d.
// Accumulates into the acc list.
fn _lsh_free_vars_aux(t, d, acc)
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        if k >= d
            // Free variable: its top-level index is k - d
            push(acc, k - d)
    if tag == "lam"
        _lsh_free_vars_aux(t[1], d + 1, acc)
    if tag == "app"
        _lsh_free_vars_aux(t[1], d, acc)
        _lsh_free_vars_aux(t[2], d, acc)

// _lsh_sort_dedup: sort a list of integers and remove duplicates.
fn _lsh_sort_dedup(xs) -> list
    let n = len(xs)
    if n == 0
        let empty = []
        return empty
    // Insertion sort
    let sorted = []
    let i = 0
    while i < n
        push(sorted, xs[i])
        i = i + 1
    // Bubble sort (simple, correctness over performance)
    let j = 0
    while j < n
        let k = 0
        while k < n - j - 1
            if sorted[k] > sorted[k + 1]
                let tmp = sorted[k]
                sorted[k] = sorted[k + 1]
                sorted[k + 1] = tmp
            k = k + 1
        j = j + 1
    // Dedup
    let result = []
    let prev = -1
    let r = 0
    while r < n
        if sorted[r] != prev
            push(result, sorted[r])
            prev = sorted[r]
        r = r + 1
    return result

// lsh_free_vars: return sorted list of free de Bruijn indices in t (from top level).
fn lsh_free_vars(t) -> list
    let acc = []
    _lsh_free_vars_aux(t, 0, acc)
    return _lsh_sort_dedup(acc)
