// std/lambda/lambda_bool — Church booleans, conditionals, and pairs as lambda terms.
// Term representation (de Bruijn indices):
//   ["var", k]    — variable with index k (0 = innermost binder)
//   ["lam", body] — abstraction
//   ["app", f, a] — application
// Self-contained: imports nothing.  All public names prefixed lbl_.

// ── Term constructors ────────────────────────────────────────────────────────

// lbl_var: build a variable term with de Bruijn index k.
fn lbl_var(k) -> list
    let t = ["var", k]
    return t

// lbl_lam: build an abstraction term with the given body.
fn lbl_lam(body) -> list
    let t = ["lam", body]
    return t

// lbl_app: build an application term.
fn lbl_app(f, a) -> list
    let t = ["app", f, a]
    return t

// ── de Bruijn shift ──────────────────────────────────────────────────────────

// _lbl_shift: add d to every free variable (index >= c) in term t.
fn _lbl_shift(d, c, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        if k >= c
            return lbl_var(k + d)
        return lbl_var(k)
    if tag == "lam"
        return lbl_lam(_lbl_shift(d, c + 1, t[1]))
    let sf = _lbl_shift(d, c, t[1])
    let sa = _lbl_shift(d, c, t[2])
    return lbl_app(sf, sa)

// ── de Bruijn substitution ───────────────────────────────────────────────────

// _lbl_subst: substitute term s for variable index j in term t.
fn _lbl_subst(j, s, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        if k == j
            return s
        return lbl_var(k)
    if tag == "lam"
        let ns = _lbl_shift(1, 0, s)
        return lbl_lam(_lbl_subst(j + 1, ns, t[1]))
    let sf = _lbl_subst(j, s, t[1])
    let sa = _lbl_subst(j, s, t[2])
    return lbl_app(sf, sa)

// ── Beta reduction ───────────────────────────────────────────────────────────

// _lbl_beta: contract a redex ["app", ["lam", b], s] -> result term.
fn _lbl_beta(b, s) -> list
    let shifted_s = _lbl_shift(1, 0, s)
    let substituted = _lbl_subst(0, shifted_s, b)
    return _lbl_shift(-1, 0, substituted)

// ── Normal-order (leftmost-outermost) reduction ───────────────────────────────

// _lbl_step: attempt ONE normal-order reduction step; returns [changed, term].
fn _lbl_step(t) -> list
    let tag = t[0]
    if tag == "var"
        let r = [0, t]
        return r
    if tag == "lam"
        let inner = _lbl_step(t[1])
        if inner[0] == 1
            let r = [1, lbl_lam(inner[1])]
            return r
        let r = [0, t]
        return r
    // app
    let f = t[1]
    let a = t[2]
    if f[0] == "lam"
        let r = [1, _lbl_beta(f[1], a)]
        return r
    let sf = _lbl_step(f)
    if sf[0] == 1
        let r = [1, lbl_app(sf[1], a)]
        return r
    let sa = _lbl_step(a)
    if sa[0] == 1
        let r = [1, lbl_app(f, sa[1])]
        return r
    let r = [0, t]
    return r

// lbl_normalize: reduce t to normal form (up to 100000 steps).
fn lbl_normalize(t) -> list
    let cur = t
    for steps in 0..100000
        let res = _lbl_step(cur)
        if res[0] == 0
            return cur
        cur = res[1]
    return cur

// ── Church booleans ──────────────────────────────────────────────────────────

// lbl_true: TRUE = λx.λy.x = λ(λ(var 1))  (picks first argument)
fn lbl_true() -> list
    return lbl_lam(lbl_lam(lbl_var(1)))

// lbl_false: FALSE = λx.λy.y = λ(λ(var 0))  (picks second argument)
fn lbl_false() -> list
    return lbl_lam(lbl_lam(lbl_var(0)))

// ── Boolean combinators ───────────────────────────────────────────────────────

// lbl_and: AND = λp.λq. p q FALSE = λ(λ(app(app(var1,var0), false)))
// In de Bruijn: λ(λ(app(app(var1,var0), λ(λ(var0)))))
fn lbl_and() -> list
    let body = lbl_app(lbl_app(lbl_var(1), lbl_var(0)), lbl_false())
    return lbl_lam(lbl_lam(body))

// lbl_or: OR = λp.λq. p TRUE q = λ(λ(app(app(var1, true), var0)))
// In de Bruijn: λ(λ(app(app(var1, λ(λ(var1))), var0)))
fn lbl_or() -> list
    let body = lbl_app(lbl_app(lbl_var(1), lbl_true()), lbl_var(0))
    return lbl_lam(lbl_lam(body))

// lbl_not: NOT = λp. p FALSE TRUE = λ(app(app(var0, false), true))
fn lbl_not() -> list
    let body = lbl_app(lbl_app(lbl_var(0), lbl_false()), lbl_true())
    return lbl_lam(body)

// lbl_if: IF = λp.λa.λb. p a b = λ(λ(λ(app(app(var2,var1),var0))))
fn lbl_if() -> list
    let body = lbl_app(lbl_app(lbl_var(2), lbl_var(1)), lbl_var(0))
    return lbl_lam(lbl_lam(lbl_lam(body)))

// ── Church pairs ─────────────────────────────────────────────────────────────

// lbl_pair: PAIR = λa.λb.λf. f a b = λ(λ(λ(app(app(var0,var2),var1))))
fn lbl_pair() -> list
    let body = lbl_app(lbl_app(lbl_var(0), lbl_var(2)), lbl_var(1))
    return lbl_lam(lbl_lam(lbl_lam(body)))

// lbl_fst: FST = λp. p TRUE = λ(app(var0, true))
fn lbl_fst() -> list
    return lbl_lam(lbl_app(lbl_var(0), lbl_true()))

// lbl_snd: SND = λp. p FALSE = λ(app(var0, false))
fn lbl_snd() -> list
    return lbl_lam(lbl_app(lbl_var(0), lbl_false()))

// ── Term structural equality ──────────────────────────────────────────────────

// _lbl_term_eq: deep structural equality of two terms; returns 1 if equal.
fn _lbl_term_eq(a, b) -> int
    let ta = a[0]
    let tb = b[0]
    if ta != tb
        return 0
    if ta == "var"
        if a[1] == b[1]
            return 1
        return 0
    if ta == "lam"
        return _lbl_term_eq(a[1], b[1])
    // app
    if _lbl_term_eq(a[1], b[1]) == 0
        return 0
    return _lbl_term_eq(a[2], b[2])

// lbl_decode_bool: normalize a boolean term and compare to TRUE; returns NOVA bool.
fn lbl_decode_bool(t) -> int
    let nf = lbl_normalize(t)
    if _lbl_term_eq(nf, lbl_true()) == 1
        return 1
    return 0
