// std/lambda/lambda_church — Church numerals and arithmetic as lambda terms.
// Term representation (de Bruijn indices):
//   ["var", k]    — variable with index k (0 = innermost binder)
//   ["lam", body] — abstraction
//   ["app", f, a] — application
// Self-contained: imports nothing.  All public names prefixed lch_.

// ── Term constructors ────────────────────────────────────────────────────────

// lch_var: build a variable term with de Bruijn index k.
fn lch_var(k) -> list
    let t = ["var", k]
    return t

// lch_lam: build an abstraction term with the given body.
fn lch_lam(body) -> list
    let t = ["lam", body]
    return t

// lch_app: build an application term.
fn lch_app(f, a) -> list
    let t = ["app", f, a]
    return t

// ── de Bruijn shift ──────────────────────────────────────────────────────────

// _lch_shift: add d to every free variable (index >= c) in term t.
fn _lch_shift(d, c, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        if k >= c
            return lch_var(k + d)
        return lch_var(k)
    if tag == "lam"
        return lch_lam(_lch_shift(d, c + 1, t[1]))
    let sf = _lch_shift(d, c, t[1])
    let sa = _lch_shift(d, c, t[2])
    return lch_app(sf, sa)

// ── de Bruijn substitution ───────────────────────────────────────────────────

// _lch_subst: substitute term s for variable index j in term t.
fn _lch_subst(j, s, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = t[1]
        if k == j
            return s
        return lch_var(k)
    if tag == "lam"
        let ns = _lch_shift(1, 0, s)
        return lch_lam(_lch_subst(j + 1, ns, t[1]))
    let sf = _lch_subst(j, s, t[1])
    let sa = _lch_subst(j, s, t[2])
    return lch_app(sf, sa)

// ── Beta reduction ───────────────────────────────────────────────────────────

// _lch_beta: contract a redex ["app", ["lam", b], s] -> result term.
fn _lch_beta(b, s) -> list
    let shifted_s = _lch_shift(1, 0, s)
    let substituted = _lch_subst(0, shifted_s, b)
    return _lch_shift(-1, 0, substituted)

// ── Normal-order (leftmost-outermost) reduction ───────────────────────────────

// _lch_is_redex: 1 if t is a beta redex (app of lam to something).
fn _lch_is_redex(t) -> int
    if t[0] == "app"
        if t[1][0] == "lam"
            return 1
    return 0

// _lch_step: attempt ONE normal-order reduction step; returns [changed, term].
fn _lch_step(t) -> list
    let tag = t[0]
    if tag == "var"
        let r = [0, t]
        return r
    if tag == "lam"
        let inner = _lch_step(t[1])
        if inner[0] == 1
            let r = [1, lch_lam(inner[1])]
            return r
        let r = [0, t]
        return r
    // app
    let f = t[1]
    let a = t[2]
    if f[0] == "lam"
        let r = [1, _lch_beta(f[1], a)]
        return r
    // try to reduce f first (normal order: leftmost-outermost)
    let sf = _lch_step(f)
    if sf[0] == 1
        let r = [1, lch_app(sf[1], a)]
        return r
    // then try a
    let sa = _lch_step(a)
    if sa[0] == 1
        let r = [1, lch_app(f, sa[1])]
        return r
    let r = [0, t]
    return r

// _lch_normalize_max: reduce t up to max_steps steps, return normal form (or partial).
fn _lch_normalize_max(t, max_steps) -> list
    let cur = t
    let steps = 0
    while steps < max_steps
        let res = _lch_step(cur)
        if res[0] == 0
            return cur
        cur = res[1]
        steps += 1
    return cur

// lch_normalize: normalize a term with a generous step bound (100000 steps).
fn lch_normalize(t) -> list
    return _lch_normalize_max(t, 100000)

// ── Church numerals ──────────────────────────────────────────────────────────

// _lch_build_apps: build the body f^n(x) where f=var(1), x=var(0), n applications.
fn _lch_build_apps(n) -> list
    if n == 0
        return lch_var(0)
    return lch_app(lch_var(1), _lch_build_apps(n - 1))

// lch_num: build the Church numeral term for non-negative integer n.
fn lch_num(n) -> list
    return lch_lam(lch_lam(_lch_build_apps(n)))

// _lch_count_apps: count applications of var(1) wrapped around a var(0) body.
fn _lch_count_apps(t) -> int
    if t[0] == "var"
        return 0
    if t[0] == "app"
        return 1 + _lch_count_apps(t[2])
    return 0

// lch_to_int: decode a Church numeral in normal form to a NOVA int.
// Strip two lambdas, then count applications of var(1) to var(0).
fn lch_to_int(t) -> int
    if t[0] != "lam"
        return -1
    let inner1 = t[1]
    if inner1[0] != "lam"
        return -1
    return _lch_count_apps(inner1[1])

// ── Church arithmetic combinators ────────────────────────────────────────────

// lch_succ: SUCC = λn.λf.λx. f (n f x)
// de Bruijn: λ(λ(λ(app(var1, app(app(var2, var1), var0)))))
fn lch_succ() -> list
    let nx = lch_app(lch_app(lch_var(2), lch_var(1)), lch_var(0))
    let body = lch_app(lch_var(1), nx)
    return lch_lam(lch_lam(lch_lam(body)))

// lch_plus: PLUS = λm.λn.λf.λx. m f (n f x)
// de Bruijn: λ(λ(λ(λ(app(app(var3,var1), app(app(var2,var1),var0))))))
fn lch_plus() -> list
    let nfx = lch_app(lch_app(lch_var(2), lch_var(1)), lch_var(0))
    let mfx = lch_app(lch_app(lch_var(3), lch_var(1)), nfx)
    return lch_lam(lch_lam(lch_lam(lch_lam(mfx))))

// lch_mult: MULT = λm.λn.λf. m (n f)
// de Bruijn: λ(λ(λ(app(app(var2, app(var1,var0)), var0))))
// Actually MULT = λm.λn.λf.λx. m (n f) x
// de Bruijn: λ(λ(λ(λ(app(app(var3, app(var2,var1)), var0)))))
fn lch_mult() -> list
    let nf = lch_app(lch_var(2), lch_var(1))
    let mnf = lch_app(lch_var(3), nf)
    let body = lch_app(mnf, lch_var(0))
    return lch_lam(lch_lam(lch_lam(lch_lam(body))))

// lch_exp: EXP = λm.λn. n m
// de Bruijn: λ(λ(app(var0, var1)))
fn lch_exp() -> list
    return lch_lam(lch_lam(lch_app(lch_var(0), lch_var(1))))

// ── Applying combinators ─────────────────────────────────────────────────────

// lch_apply2: build and normalize (op a b), returns normal form.
fn lch_apply2(op, a, b) -> list
    let t = lch_app(lch_app(op, a), b)
    return lch_normalize(t)
