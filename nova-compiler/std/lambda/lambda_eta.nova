// std/lambda/lambda_eta — Eta reduction for lambda calculus (de Bruijn indices).
//
// TERM REPRESENTATION (tagged lists, all immutable):
//   VARIABLE:    ["var", k]      k = de Bruijn index (int), 0 = innermost binder.
//   ABSTRACTION: ["lam", body]   anonymous lambda; body is a term.
//   APPLICATION: ["app", f, a]   f and a are terms.
//
// ETA-REDEX: t = ["lam",["app", f, ["var",0]]] where 0 does NOT appear free in f.
// (Inside the lambda binder, index 0 refers to the bound variable; f must not
//  depend on this variable for the eta-law lambda x. f x = f to hold.)
//
// ETA-CONTRACT: for a valid eta-redex as above, result = shift(-1, 0, f).
//   The shift removes the outermost binder level so free variables of f
//   are adjusted correctly.
//
// All public functions are prefixed lta_.

// lta_mk_var builds a variable term ["var", k].
fn lta_mk_var(k) -> list
    let t = []
    push(t, "var")
    push(t, k)
    return t

// lta_mk_lam builds an abstraction term ["lam", body].
fn lta_mk_lam(body) -> list
    let t = []
    push(t, "lam")
    push(t, body)
    return t

// lta_mk_app builds an application term ["app", f, a].
fn lta_mk_app(f, a) -> list
    let t = []
    push(t, "app")
    push(t, f)
    push(t, a)
    return t

// lta_shift adds d to every free variable (index >= c) in term t.
fn lta_shift(d, c, t) -> list
    let tag = t[0]
    if tag == "var"
        let k = int(t[1])
        if k >= c
            return lta_mk_var(k + d)
        return lta_mk_var(k)
    if tag == "lam"
        return lta_mk_lam(lta_shift(d, c + 1, t[1]))
    return lta_mk_app(lta_shift(d, c, t[1]), lta_shift(d, c, t[2]))

// lta_is_free checks whether variable index j appears free in term t.
// Returns 1 if j appears free, 0 otherwise.
fn lta_is_free(j, t) -> int
    let tag = t[0]
    if tag == "var"
        if int(t[1]) == j
            return 1
        return 0
    if tag == "lam"
        // Under a binder, the free index we look for increases by 1.
        return lta_is_free(j + 1, t[1])
    // "app": free in either side
    if lta_is_free(j, t[1]) == 1
        return 1
    return lta_is_free(j, t[2])

// lta_is_eta_redex returns 1 iff t is a valid eta-redex.
// An eta-redex has the form ["lam", ["app", f, ["var",0]]] where 0 is NOT free in f.
fn lta_is_eta_redex(t) -> int
    if t[0] != "lam"
        return 0
    let body = t[1]
    if body[0] != "app"
        return 0
    let arg = body[2]
    if arg[0] != "var"
        return 0
    if int(arg[1]) != 0
        return 0
    // Check that index 0 is NOT free in f (the function part of the app).
    let f = body[1]
    if lta_is_free(0, f) == 1
        return 0
    return 1

// lta_eta_contract eta-contracts the top-level eta-redex of t (must be a valid redex).
// Returns shift(-1, 0, f) where f is the function part of the body application.
fn lta_eta_contract(t) -> list
    let body = t[1]
    let f = body[1]
    return lta_shift(-1, 0, f)

// lta_eta_step performs ONE leftmost-outermost eta step anywhere in t.
// Returns [changed, t2]: changed=1 if a step was taken, 0 otherwise.
fn lta_eta_step(t) -> list
    // Try the top level first (outermost).
    if lta_is_eta_redex(t) == 1
        let res = []
        push(res, 1)
        push(res, lta_eta_contract(t))
        return res
    let tag = t[0]
    if tag == "var"
        let res = []
        push(res, 0)
        push(res, t)
        return res
    if tag == "lam"
        let r = lta_eta_step(t[1])
        let res = []
        push(res, int(r[0]))
        push(res, lta_mk_lam(r[1]))
        return res
    // "app": try left then right
    let rl = lta_eta_step(t[1])
    if int(rl[0]) == 1
        let res = []
        push(res, 1)
        push(res, lta_mk_app(rl[1], t[2]))
        return res
    let rr = lta_eta_step(t[2])
    let res = []
    push(res, int(rr[0]))
    push(res, lta_mk_app(t[1], rr[1]))
    return res

// lta_eta_reduce repeatedly eta-contracts anywhere in t, bounded by max_steps.
// Returns the eta-reduced term (eta normal form if bound is large enough).
fn lta_eta_reduce(t, max_steps) -> list
    let cur = t
    let steps = 0
    let running = 1
    while running == 1 and steps < max_steps
        let r = lta_eta_step(cur)
        if int(r[0]) == 0
            running = 0
        if running == 1
            cur = r[1]
            steps = steps + 1
    return cur

// lta_eta_normal returns 1 iff t contains no eta-redex anywhere.
fn lta_eta_normal(t) -> int
    if lta_is_eta_redex(t) == 1
        return 0
    let tag = t[0]
    if tag == "var"
        return 1
    if tag == "lam"
        return lta_eta_normal(t[1])
    if lta_eta_normal(t[1]) == 0
        return 0
    return lta_eta_normal(t[2])
