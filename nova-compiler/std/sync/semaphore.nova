// std/sync/semaphore — green-task-aware counting semaphore
//
// WHAT:
//   A semaphore that parks the calling green task (or OS thread) when the permit
//   count reaches zero.  Counting semaphores are the generalisation of a mutex
//   (mutex = semaphore with n=1).
//
// NOVA WAY — a semaphore is a channel with N tokens:
//   A channel_bounded(n) pre-loaded with n integer tokens IS a counting semaphore.
//   recv(s) = acquire one permit  → parks if count is 0.
//   send(s, 1) = release one permit → wakes one parked waiter.
//   try_recv(s) = non-blocking acquire attempt.
//   The channel runtime provides park/wake for free; no scheduler changes needed.
//
// DRAWBACK AVOIDED:
//   • Java: Semaphore(n, fair) is heavyweight (AQS framework, fair-queuing state
//     machine, thread unpark overhead).  NOVA reuses the channel queue.
//   • POSIX sem_t: kernel-mode on contention (sem_wait syscall), no green-task
//     awareness.  NOVA parks only the green task, keeping the carrier OS thread
//     free to run others.
//   • C++ std::counting_semaphore (C++20): implementation-defined parking strategy;
//     may spin-wait on Windows.  NOVA guarantees a park via the channel scheduler.

// CAUTION — balance acquire/release; n is a HARD ceiling:
//   • Call sem_release(s) exactly as many times as you successfully acquired. Releasing
//     MORE than the capacity n PARKS the releaser (the bounded channel is full at n).
//   • n must be >= 1 (the max concurrent holders). Values < 1 are clamped to 1: a
//     0-permit "start-closed gate" is NOT supported by this simple form (channel_bounded(0)
//     is UNbounded), so use a channel directly if you need that pattern.

// sem_new(n) -> semaphore
//   Creates a new semaphore with n initial permits (n >= 1; n == 1 is an unlocked mutex).
fn sem_new(n)
    let cap = n
    if cap < 1
        cap = 1
    let s = channel_bounded(cap)
    for i in 0..cap
        send(s, 1)
    return s

// sem_acquire(s)
//   Consume one permit.  Parks the caller if no permits are available.
fn sem_acquire(s)
    recv(s)

// sem_release(s)
//   Return one permit.  Wakes one parked waiter (if any).
fn sem_release(s)
    send(s, 1)

// sem_try_acquire(s) -> bool (1 = acquired, 0 = no permits available)
//   Non-blocking acquire.  Returns 1 if a permit was consumed, 0 otherwise.
//   The caller MUST call sem_release(s) after a successful sem_try_acquire.
fn sem_try_acquire(s)
    let r = try_recv(s)
    return r[0]
