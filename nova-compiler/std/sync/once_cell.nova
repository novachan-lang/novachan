// std/sync/once_cell — lazily/exactly-once-initialized storage slot
//
// WHAT:
//   A cell that can be written exactly once, then read any number of times
//   (Rust once_cell::OnceCell / C++11 std::call_once storage). Unlike
//   promise, oc_get is NON-BLOCKING: it reports "not set yet" as an error
//   rather than waiting, which fits the common "compute-once cache" use
//   case (config loaded once, then read from many call sites) better than a
//   future/promise's block-until-ready contract.
//
// NOVA WAY:
//   The set flag + value are struct fields guarded by a mutex
//   (std/sync/mutex) so a race between two concurrent oc_set callers is
//   resolved deterministically: exactly one wins, the other observes
//   err(...) and its value is discarded rather than silently overwriting
//   the winner.
//
// CAUTION:
//   • oc_get never blocks — a reader that arrives before oc_set gets err(),
//     not a parked wait. Poll with a `sleep(0)` retry loop at the call site
//     if wait-until-set behavior is needed (or use promise instead).
//
// FIELD NAMING: fields are prefixed `oc_` and kept globally unique across
// ALL std/sync struct types — see std/sync/barrier.nova's header for why
// (a real compiler defect resolves struct field writes by name, not by
// (type, name), so two co-declared struct types sharing a field name can
// miscompile). Do not de-prefix until that upstream bug is fixed+reverified.
import std/sync/mutex

type OnceCell
    oc_is_set: int
    oc_value: any
    oc_m: any

// oc_new() -> OnceCell
//   Creates a new, empty cell.
fn oc_new()
    return OnceCell(0, 0, mutex_new())

// oc_set(o, val) -> Result
//   Sets the cell's value exactly once. ok(1) on success; err(...) if
//   already set (the existing value is left untouched).
fn oc_set(o, val)
    lock(o.oc_m)
    if o.oc_is_set == 1
        unlock(o.oc_m)
        return err("once_cell already set")
    o.oc_value = val
    o.oc_is_set = 1
    unlock(o.oc_m)
    return ok(1)

// oc_get(o) -> Result
//   ok(value) if set, err(...) if not yet set. Never blocks.
fn oc_get(o)
    if o.oc_is_set == 0
        return err("once_cell not set")
    return ok(o.oc_value)

// oc_is_set(o) -> bool
//   Non-blocking check: has the cell been set yet?
fn oc_is_set(o)
    return o.oc_is_set
