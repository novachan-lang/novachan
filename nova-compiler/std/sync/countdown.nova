// std/sync/countdown — one-shot countdown latch
//
// WHAT:
//   Starts at a fixed count; any number of parties call cd_decrement as
//   work completes; any number of waiters block in cd_wait until the count
//   reaches zero (Java CountDownLatch). Unlike barrier, parties do not block
//   on their own decrement call, and the latch is NOT reusable once it
//   reaches zero (a fresh cd_new is required for the next round — this is
//   the deliberate one-shot/many-to-many counterpart to barrier's cyclic
//   N-parties-block-each-other design).
//
// NOVA WAY:
//   The count is a struct field guarded by a mutex (std/sync/mutex);
//   cd_wait is a cooperative poll (`sleep(0)` yields the green task/carrier)
//   on "has count reached zero yet" — level-triggered, so a waiter arriving
//   after the count already hit zero returns immediately.
//
// CAUTION:
//   • cd_decrement below zero is a no-op (count is clamped at 0), so extra
//     decrements beyond the initial count never go negative or re-trigger.
//   • cd_wait on a latch whose count never reaches zero blocks forever.
//
// FIELD NAMING: fields are prefixed `cd_` and kept globally unique across
// ALL std/sync struct types — see std/sync/barrier.nova's header for why
// (a real compiler defect resolves struct field writes by name, not by
// (type, name), so two co-declared struct types sharing a field name can
// miscompile). Do not de-prefix until that upstream bug is fixed+reverified.
import std/sync/mutex

type Countdown
    cd_count: int
    cd_m: any

// cd_new(count) -> Countdown
//   Creates a latch starting at count (negative count is clamped to 0, i.e.
//   an already-open latch).
fn cd_new(count)
    let c = 0 if count < 0 else count
    return Countdown(c, mutex_new())

// cd_decrement(cd)
//   Decrements the count by one (no-op if already at 0). The party that
//   drives the count to 0 releases every current and future cd_wait caller.
fn cd_decrement(cd)
    lock(cd.cd_m)
    if cd.cd_count > 0
        cd.cd_count -= 1
    unlock(cd.cd_m)

// cd_wait(cd)
//   Blocks until the count reaches 0. Returns immediately if already 0.
fn cd_wait(cd)
    while cd.cd_count > 0
        sleep(0)

// cd_count(cd) -> int
//   The current count (non-blocking).
fn cd_count(cd)
    return cd.cd_count
