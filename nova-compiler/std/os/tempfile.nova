// std/os/tempfile — Temp file/dir creation, cleanup, and system temp dir lookup.
//
// API:
//   tf_temp_dir()             -> string   system temp directory (env TEMP/TMP/TMPDIR, else "/tmp")
//   tf_create(prefix)         -> string   create a uniquely-named empty temp FILE; returns its path
//   tf_create_dir(prefix)     -> string   create a uniquely-named temp DIRECTORY; returns its path
//   tf_cleanup(path)          -> bool     remove a temp file or (empty) temp directory
//
// Uniqueness comes from time_ms() mixed with a monotonically increasing in-process counter
// (module-level scalars can't be mutated from named functions in NOVA, so the counter is
// carried in a single-element list). Private helpers prefixed _tf_.

let _tf_counter = [0]

// Base-36 encode a non-negative integer, zero-padded to at least 8 characters.
fn _tf_base36(v: int) -> string
    let digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    let mask48 = 281474976710655
    let x = v
    if x < 0
        x = (x & mask48)
    if x == 0
        return "00000000"
    let out = ""
    let remaining = x
    while remaining > 0
        let rem = remaining - (remaining / 36) * 36
        out = slice(digits, rem, rem + 1) + out
        remaining /= 36
    while len(out) < 8
        out = "0" + out
    return out

// Produce the next unique suffix for this process: mix time_ms() with an incrementing counter.
fn _tf_next_suffix() -> string
    let n = _tf_counter[0] + 1
    _tf_counter[0] = n
    let mixed = (time_ms() * 1000003) + n
    if mixed < 0
        mixed = -mixed
    return _tf_base36(mixed)

// tf_temp_dir() -> string  best-effort system temp directory, "/tmp" if none of the usual
// environment variables are set.
fn tf_temp_dir() -> string
    let t = env("TEMP")
    if len(t) > 0
        return t
    let t2 = env("TMP")
    if len(t2) > 0
        return t2
    let t3 = env("TMPDIR")
    if len(t3) > 0
        return t3
    return "/tmp"

// Join a directory and a filename with a single "/".
fn _tf_join(dir: string, name: string) -> string
    if len(dir) == 0
        return name
    if char_at(dir, len(dir) - 1) == "/" or char_at(dir, len(dir) - 1) == "\\"
        return dir + name
    return dir + "/" + name

// tf_create(prefix) -> string  create a uniquely-named empty temp file; returns its full path.
// Retries with a fresh suffix in the (astronomically unlikely) case of a collision.
fn tf_create(prefix: string) -> string
    let dir = tf_temp_dir()
    let path = _tf_join(dir, prefix + _tf_next_suffix() + ".tmp")
    while file_exists(path)
        path = _tf_join(dir, prefix + _tf_next_suffix() + ".tmp")
    write_file(path, "")
    return path

// tf_create_dir(prefix) -> string  create a uniquely-named temp directory; returns its full path.
fn tf_create_dir(prefix: string) -> string
    let dir = tf_temp_dir()
    let path = _tf_join(dir, prefix + _tf_next_suffix())
    while is_dir(path) or file_exists(path)
        path = _tf_join(dir, prefix + _tf_next_suffix())
    make_dir(path)
    return path

// tf_cleanup(path) -> bool  remove a temp file or an empty temp directory. True if the path
// no longer exists afterward (including if it never existed).
fn tf_cleanup(path: string) -> bool
    if is_dir(path)
        remove_dir(path)
        return is_dir(path) == false
    if file_exists(path)
        remove_file(path)
        return file_exists(path) == false
    return true
