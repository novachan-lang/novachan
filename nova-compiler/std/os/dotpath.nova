// std/os/dotpath — dotted-path access into nested dicts.
//
// WHAT: Navigate arbitrarily deep nested dicts using a dot-separated key path.
//   dot_get(obj, path) -> any     read "a.b.c"; returns null if any segment is missing
//   dot_set(obj, path, value)     write "a.b.c"; creates intermediate dicts as needed
//   dot_has(obj, path) -> bool    true iff every segment in the path exists
//
// All keys are strings; intermediate nodes that do not exist are created as {}.
// A one-segment path like "a" is a plain dict key lookup/set/has.
// Paths must not be empty (callers own input validation).
//
// Private helpers prefixed _dp_ to avoid cross-module symbol collisions.

// Split a dot-separated path string into a list of key segments.
// "a.b.c" -> ["a","b","c"]
// "a"     -> ["a"]
fn _dp_split(path: string) -> list
    return split(path, ".")

// dot_get(obj, path) -> any
// Return the value at the dot-delimited path inside obj.
// Returns null if any intermediate key is missing or if an intermediate node is not a dict.
fn dot_get(obj: any, path: string) -> any
    let keys = _dp_split(path)
    let cur = obj
    let i = 0
    let found = 1
    while i < len(keys) and found == 1
        let k = keys[i]
        if type_of(cur) != "dict"
            found = 0
        else
            if contains(cur, k)
                cur = cur[k]
                i = i + 1
            else
                found = 0
    if found == 1
        return cur
    return null

// dot_has(obj, path) -> bool
// Return true iff every segment of path exists and leads to a defined value.
fn dot_has(obj: any, path: string) -> bool
    let keys = _dp_split(path)
    let cur = obj
    let i = 0
    let ok = 1
    while i < len(keys) and ok == 1
        let k = keys[i]
        if type_of(cur) != "dict"
            ok = 0
        else
            if contains(cur, k)
                cur = cur[k]
                i = i + 1
            else
                ok = 0
    if ok == 1
        return true
    return false

// dot_set(obj, path, value)
// Write value at the dot-delimited path inside obj.
// Creates intermediate dicts where intermediate keys are absent.
// Mutates obj in-place (dicts are reference types in NOVA).
fn dot_set(obj: any, path: string, value: any)
    let keys = _dp_split(path)
    let n = len(keys)
    if n == 0
        return
    if n == 1
        obj[keys[0]] = value
        return
    // Navigate to the parent of the final key, creating intermediates.
    let cur = obj
    for i in 0..(n - 1)
        let k = keys[i]
        if contains(cur, k)
            let child = cur[k]
            if type_of(child) != "dict"
                // Overwrite non-dict intermediate with an empty dict.
                let nd = {}
                cur[k] = nd
                cur = nd
            else
                cur = child
        else
            let nd = {}
            cur[k] = nd
            cur = nd
    cur[keys[n - 1]] = value
