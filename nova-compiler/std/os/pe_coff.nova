// std/os/pe_coff — Windows PE/COFF header parser. Pure NOVA.
//
// Parses DOS/PE/COFF headers from a buffer (list of ints 0..255).
// All fields are read little-endian per the PE/COFF specification.

// _u16le: read unsigned 16-bit little-endian int from buffer b at offset p
fn _u16le(b: any, p: int) -> int
    if len(b) < p + 2
        return 0
    return b[p] + b[p+1]*256

// _u32le: read unsigned 32-bit little-endian int from buffer b at offset p
fn _u32le(b: any, p: int) -> int
    if len(b) < p + 4
        return 0
    return b[p] + b[p+1]*256 + b[p+2]*65536 + b[p+3]*16777216

// pe_dos_check: return true if buffer starts with DOS MZ signature (0x4D, 0x5A)
fn pe_dos_check(buf: any) -> bool
    if len(buf) < 2
        return false
    if buf[0] != 77
        return false
    if buf[1] != 90
        return false
    return true

// pe_e_lfanew: return the PE header offset stored as u32le at offset 0x3C (60)
fn pe_e_lfanew(buf: any) -> int
    return _u32le(buf, 60)

// pe_nt_signature_check: return true if PE\0\0 signature exists at e_lfanew offset
fn pe_nt_signature_check(buf: any) -> bool
    let off = pe_e_lfanew(buf)
    if len(buf) < off + 4
        return false
    if buf[off] != 80
        return false
    if buf[off+1] != 69
        return false
    if buf[off+2] != 0
        return false
    if buf[off+3] != 0
        return false
    return true

// pe_machine: return COFF Machine field (u16le at e_lfanew+4)
fn pe_machine(buf: any) -> int
    let off = pe_e_lfanew(buf)
    return _u16le(buf, off + 4)

// pe_machine_name: return human-readable machine architecture string
fn pe_machine_name(buf: any) -> string
    let m = pe_machine(buf)
    if m == 332
        return "x86"
    if m == 34404
        return "x86-64"
    if m == 43620
        return "ARM64"
    return "unknown"

// pe_num_sections: return NumberOfSections (u16le at e_lfanew+6)
fn pe_num_sections(buf: any) -> int
    let off = pe_e_lfanew(buf)
    return _u16le(buf, off + 6)

// pe_timestamp: return TimeDateStamp (u32le at e_lfanew+8)
fn pe_timestamp(buf: any) -> int
    let off = pe_e_lfanew(buf)
    return _u32le(buf, off + 8)

// pe_characteristics: return Characteristics field (u16le at e_lfanew+22)
fn pe_characteristics(buf: any) -> int
    let off = pe_e_lfanew(buf)
    return _u16le(buf, off + 22)

// pe_opt_magic: return Optional Header magic (u16le at e_lfanew+24): 0x10b=PE32, 0x20b=PE32+
fn pe_opt_magic(buf: any) -> int
    let off = pe_e_lfanew(buf)
    return _u16le(buf, off + 24)

// pe_is_pe32plus: return true if Optional Header magic == 0x20b (PE32+, 64-bit)
fn pe_is_pe32plus(buf: any) -> bool
    return pe_opt_magic(buf) == 523

// pe_is_dll: return true if Characteristics bit 0x2000 is set (IMAGE_FILE_DLL)
fn pe_is_dll(buf: any) -> bool
    let ch = pe_characteristics(buf)
    let bit = ch & 0x2000
    return bit != 0

// pe_is_valid: return true if both DOS MZ and PE\0\0 signatures are valid
fn pe_is_valid(buf: any) -> bool
    if not pe_dos_check(buf)
        return false
    return pe_nt_signature_check(buf)
