// std/os/memops — Memory-block operations on byte lists. Pure NOVA.
//
// mem_copy(src) -> list            shallow copy of a byte list
// mem_fill(n, value) -> list       list of n copies of value
// mem_equal(a, b) -> bool          true if a and b are identical byte-for-byte
// mem_compare(a, b) -> int         -1/0/1 lexicographic comparison
// mem_reverse(a) -> list           reversed copy
// mem_xor(a, b) -> list            element-wise XOR (length = min(len(a), len(b)))

// mem_copy: return a copy of src byte list
fn mem_copy(src: any) -> any
    let out = []
    let i = 0
    let n = len(src)
    while i < n
        push(out, src[i])
        i = i + 1
    return out

// mem_fill: create list of n elements each set to value
fn mem_fill(n: int, value: int) -> any
    let out = []
    let i = 0
    while i < n
        push(out, value)
        i = i + 1
    return out

// mem_equal: true if a and b have same length and identical bytes
fn mem_equal(a: any, b: any) -> bool
    let an = len(a)
    let bn = len(b)
    if an != bn
        return false
    let i = 0
    while i < an
        if a[i] != b[i]
            return false
        i = i + 1
    return true

// mem_compare: lexicographic comparison of byte lists
//   returns -1 if a < b, 0 if a == b, 1 if a > b
fn mem_compare(a: any, b: any) -> int
    let an = len(a)
    let bn = len(b)
    let n = an
    if bn < n
        n = bn
    let i = 0
    while i < n
        if a[i] < b[i]
            return -1
        if a[i] > b[i]
            return 1
        i = i + 1
    // Common prefix equal; compare lengths
    if an < bn
        return -1
    if an > bn
        return 1
    return 0

// mem_reverse: return reversed copy of byte list
fn mem_reverse(a: any) -> any
    let n = len(a)
    let out = []
    let i = n - 1
    while i >= 0
        push(out, a[i])
        i = i - 1
    return out

// mem_xor: element-wise XOR; result length = min(len(a), len(b))
fn mem_xor(a: any, b: any) -> any
    let an = len(a)
    let bn = len(b)
    let n = an
    if bn < n
        n = bn
    let out = []
    let i = 0
    while i < n
        push(out, (a[i] & 0xFF) ^ (b[i] & 0xFF))
        i = i + 1
    return out
