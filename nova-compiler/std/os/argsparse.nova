// std/os/argsparse — Minimal command-line argument parser (dict-based, pure string processing).
//
// API:
//   ap_new(description)                        -> dict   a new parser handle
//   ap_add_flag(ap, name, short, help)                    boolean flag; --name / -short, default false
//   ap_add_option(ap, name, short, default, help)         value option; --name val / -short val
//   ap_add_positional(ap, name, help)                     positional argument, consumed in order
//   ap_parse(ap, args_list)                    -> dict   name -> value (bool/string) for every
//                                                         registered flag/option/positional
//   ap_usage(ap)                               -> string  human-readable usage text
//
// Long options accept both "--name value" and "--name=value". Short options accept
// "-s value". Unrecognized tokens are ignored (skipped) rather than erroring, keeping the
// parser forgiving for scripts. Private helpers prefixed _ap_.

// ap_new(description) -> dict  a fresh parser with no flags/options/positionals registered.
fn ap_new(description: string) -> any
    let ap = {}
    ap["description"] = description
    ap["flags"] = []
    ap["options"] = []
    ap["positionals"] = []
    return ap

// ap_add_flag(ap, name, short, help)  register a boolean flag (default false when unset).
fn ap_add_flag(ap: any, name: string, short: string, help: string)
    let f = {}
    f["name"] = name
    f["short"] = short
    f["help"] = help
    push(ap["flags"], f)

// ap_add_option(ap, name, short, default, help)  register a value-taking option.
fn ap_add_option(ap: any, name: string, short: string, default_value: string, help: string)
    let o = {}
    o["name"] = name
    o["short"] = short
    o["default"] = default_value
    o["help"] = help
    push(ap["options"], o)

// ap_add_positional(ap, name, help)  register a positional argument (consumed in add order).
fn ap_add_positional(ap: any, name: string, help: string)
    let p = {}
    p["name"] = name
    p["help"] = help
    push(ap["positionals"], p)

// Look up a definition list (flags or options) by a field ("name" or "short"); return the
// matching entry's "name", or "" if none matches.
fn _ap_find_in(defs: any, field: string, value: string) -> string
    for i in 0..len(defs)
        let d = defs[i]
        if d[field] == value
            return d["name"]
    return ""

// ap_parse(ap, args_list) -> dict  parse argv-style tokens into name -> value.
fn ap_parse(ap: any, args_list: any) -> any
    let result = {}
    let i = 0
    while i < len(ap["flags"])
        result[ap["flags"][i]["name"]] = false
        i += 1
    i = 0
    while i < len(ap["options"])
        result[ap["options"][i]["name"]] = ap["options"][i]["default"]
        i += 1
    i = 0
    while i < len(ap["positionals"])
        result[ap["positionals"][i]["name"]] = ""
        i += 1

    let pos_i = 0
    let idx = 0
    let n = len(args_list)
    while idx < n
        let tok = args_list[idx]
        if len(tok) >= 2 and char_at(tok, 0) == "-" and char_at(tok, 1) == "-"
            let body = slice(tok, 2, len(tok))
            let eq = find(body, "=")
            let name = body
            let inline_val = ""
            let has_inline = false
            if eq >= 0
                name = slice(body, 0, eq)
                inline_val = slice(body, eq + 1, len(body))
                has_inline = true
            let flag_name = _ap_find_in(ap["flags"], "name", name)
            if flag_name != ""
                result[flag_name] = true
                idx += 1
            else
                let opt_name = _ap_find_in(ap["options"], "name", name)
                if opt_name != ""
                    if has_inline
                        result[opt_name] = inline_val
                        idx += 1
                    else
                        if idx + 1 < n
                            result[opt_name] = args_list[idx + 1]
                            idx += 2
                        else
                            idx += 1
                else
                    idx += 1
        else
            if len(tok) > 1 and char_at(tok, 0) == "-"
                let short = slice(tok, 1, 2)
                let flag_name = _ap_find_in(ap["flags"], "short", short)
                if flag_name != ""
                    result[flag_name] = true
                    idx += 1
                else
                    let opt_name = _ap_find_in(ap["options"], "short", short)
                    if opt_name != ""
                        if idx + 1 < n
                            result[opt_name] = args_list[idx + 1]
                            idx += 2
                        else
                            idx += 1
                    else
                        idx += 1
            else
                if pos_i < len(ap["positionals"])
                    result[ap["positionals"][pos_i]["name"]] = tok
                    pos_i += 1
                idx += 1
    return result

// ap_usage(ap) -> string  render a usage/help block from the registered definitions.
fn ap_usage(ap: any) -> string
    let out = "usage: " + ap["description"] + chr(10)
    if len(ap["positionals"]) > 0
        out += chr(10) + "positional arguments:" + chr(10)
        let i = 0
        while i < len(ap["positionals"])
            let p = ap["positionals"][i]
            out += "  " + p["name"] + "  " + p["help"] + chr(10)
            i += 1
    if len(ap["options"]) > 0
        out += chr(10) + "options:" + chr(10)
        let i = 0
        while i < len(ap["options"])
            let o = ap["options"][i]
            out += "  --" + o["name"] + ", -" + o["short"] + "  " + o["help"] + " (default: " + o["default"] + ")" + chr(10)
            i += 1
    if len(ap["flags"]) > 0
        out += chr(10) + "flags:" + chr(10)
        let i = 0
        while i < len(ap["flags"])
            let f = ap["flags"][i]
            out += "  --" + f["name"] + ", -" + f["short"] + "  " + f["help"] + chr(10)
            i += 1
    return out
