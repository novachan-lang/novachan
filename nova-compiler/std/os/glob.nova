// std/os/glob — filesystem globbing, the NOVA way.
//
// WHAT: glob("src/**/*.nova") -> list of matching paths. Wildcards: `*` (any run of chars within one path
//       segment), `?` (one char), `**` (zero-or-more whole path segments — ALWAYS recursive).
//
// NOVA-way: this is NOT a new runtime builtin. It COMPOSES the orthogonal primitives that already exist —
//       list_dir + is_dir + split + char_at — into a higher-level operation. Pure NOVA, so it is the SAME
//       code on every target and needs no compiler support. (The plan's own principle: prefer combining small
//       orthogonal concepts over adding specialized features.)
//
// Drawback avoided: Python's glob has the `recursive=True` trap — `**` silently means "one segment" unless you
//       remember the keyword. Here `**` is ALWAYS recursive; there is no flag to forget. `*` and `?` never
//       cross a `/` (a segment boundary), matching every shell's behaviour.
//
// LIMITATIONS (documented, not silent):
//   - Patterns are resolved relative to the current directory. Absolute patterns ("/etc/*.conf", "C:/logs/*")
//     are not yet supported — a follow-on.
//   - Match is literal-cased (case-sensitive), like POSIX shells.
//   - `*` matches dotfiles too (no hidden "dotfiles are special" rule — one fewer surprise than POSIX/Python).
//   - Follows directory symlinks; a symlink cycle under a `**` would recurse without bound (same as naive
//     globbers). Safe on real trees; a visited-set guard is a follow-on if cycles become a concern.

// Match one path-segment name against one wildcard token (no `/` inside either). Classic *,? matcher.
fn _glob_seg(s: string, si: int, p: string, pi: int) -> bool
    let sn = len(s)
    let pn = len(p)
    if pi == pn
        return si == sn
    let pc = char_at(p, pi)
    if pc == "*"
        if _glob_seg(s, si, p, pi + 1)
            return true
        if si < sn
            return _glob_seg(s, si + 1, p, pi)
        return false
    if si >= sn
        return false
    if pc == "?"
        return _glob_seg(s, si + 1, p, pi + 1)
    if pc == char_at(s, si)
        return _glob_seg(s, si + 1, p, pi + 1)
    return false

fn _glob_base(base: string) -> string
    if base == ""
        return "."
    return base

fn _glob_join(base: string, name: string) -> string
    if base == ""
        return name
    return base + "/" + name

fn _glob_walk(base: string, segs: any, idx: int, out: any)
    if idx >= len(segs)
        return
    let seg = segs[idx]
    let is_last = idx == len(segs) - 1
    if seg == "**"
        // `**` matches zero segments: try the rest of the pattern right here...
        _glob_walk(base, segs, idx + 1, out)
        // ...and one-or-more: descend into every subdir with `**` still active (matches all depths, no dupes —
        // a file at depth k is emitted exactly once, by the zero-case after `**` has consumed its k dirs).
        for e in list_dir(_glob_base(base))
            let child = _glob_join(base, e)
            if is_dir(child)
                _glob_walk(child, segs, idx, out)
        return
    for e in list_dir(_glob_base(base))
        if _glob_seg(e, 0, seg, 0)
            let child = _glob_join(base, e)
            if is_last
                push(out, child)
            else if is_dir(child)
                _glob_walk(child, segs, idx + 1, out)

// glob(pattern) -> list<string> of matching paths (files and/or dirs). Empty list on no match (falsy).
fn glob(pattern: string) -> any
    let raw = split(pattern, "/")
    let segs = []
    for s in raw
        if s != ""
            push(segs, s)
    if len(segs) == 0
        return []
    // `**` as the final segment means "everything below" — expand to `**/*` so a follower always exists.
    if segs[len(segs) - 1] == "**"
        push(segs, "*")
    let out = []
    _glob_walk("", segs, 0, out)
    return out
