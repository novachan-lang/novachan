// std/os/structpack — Pack/unpack structured binary data with a format string. Pure NOVA.
//
// Format string:
//   First char (optional): '<' = little-endian (default), '>' = big-endian.
//   Type codes: B = u8 (1 byte), H = u16 (2 bytes), I = u32 (4 bytes).
//
// struct_pack(fmt, values) -> list of bytes
// struct_unpack(fmt, bytes)  -> list of decoded integers
// struct_size(fmt)           -> total byte count for this format

// _sp_parse: returns [endian, code_start] where endian=0 means LE, endian=1 means BE.
fn _sp_endian(fmt: string) -> int
    if len(fmt) > 0
        let fc = slice(fmt, 0, 1)
        if fc == ">"
            return 1
    return 0

// _sp_code_start: index of first type-code character (skip optional endian prefix).
fn _sp_code_start(fmt: string) -> int
    if len(fmt) > 0
        let fc = slice(fmt, 0, 1)
        if fc == "<" or fc == ">"
            return 1
    return 0

// _sp_field_size(code) -> bytes for one type code character.
fn _sp_field_size(code: string) -> int
    if code == "B"
        return 1
    if code == "H"
        return 2
    if code == "I"
        return 4
    return 0

// _sp_write_u8(v) -> list of 1 byte
fn _sp_write_u8(v: int) -> any
    let b = v & 255
    return [b]

// _sp_write_u16_le(v) -> list of 2 bytes LE
fn _sp_write_u16_le(v: int) -> any
    let b0 = v & 255
    let b1 = (v >> 8) & 255
    return [b0, b1]

// _sp_write_u16_be(v) -> list of 2 bytes BE
fn _sp_write_u16_be(v: int) -> any
    let b0 = (v >> 8) & 255
    let b1 = v & 255
    return [b0, b1]

// _sp_write_u32_le(v) -> list of 4 bytes LE
fn _sp_write_u32_le(v: int) -> any
    let b0 = v & 255
    let b1 = (v >> 8) & 255
    let b2 = (v >> 16) & 255
    let b3 = (v >> 24) & 255
    return [b0, b1, b2, b3]

// _sp_write_u32_be(v) -> list of 4 bytes BE
fn _sp_write_u32_be(v: int) -> any
    let b0 = (v >> 24) & 255
    let b1 = (v >> 16) & 255
    let b2 = (v >> 8) & 255
    let b3 = v & 255
    return [b0, b1, b2, b3]

// _sp_read_u8(bytes, pos) -> int
fn _sp_read_u8(bytes: any, pos: int) -> int
    return bytes[pos]

// _sp_read_u16_le(bytes, pos) -> int
fn _sp_read_u16_le(bytes: any, pos: int) -> int
    let lo = bytes[pos]
    let hi = bytes[pos + 1]
    return lo + hi * 256

// _sp_read_u16_be(bytes, pos) -> int
fn _sp_read_u16_be(bytes: any, pos: int) -> int
    let hi = bytes[pos]
    let lo = bytes[pos + 1]
    return hi * 256 + lo

// _sp_read_u32_le(bytes, pos) -> int
fn _sp_read_u32_le(bytes: any, pos: int) -> int
    let b0 = bytes[pos]
    let b1 = bytes[pos + 1]
    let b2 = bytes[pos + 2]
    let b3 = bytes[pos + 3]
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

// _sp_read_u32_be(bytes, pos) -> int
fn _sp_read_u32_be(bytes: any, pos: int) -> int
    let b0 = bytes[pos]
    let b1 = bytes[pos + 1]
    let b2 = bytes[pos + 2]
    let b3 = bytes[pos + 3]
    return b0 * 16777216 + b1 * 65536 + b2 * 256 + b3

// struct_size(fmt) -> int: total packed byte count for the format string.
fn struct_size(fmt: string) -> int
    let n = len(fmt)
    let start = _sp_code_start(fmt)
    let total = 0
    let i = start
    while i < n
        let code = slice(fmt, i, i + 1)
        total = total + _sp_field_size(code)
        i = i + 1
    return total

// struct_pack(fmt, values) -> list of bytes.
// Packs each value in values according to the corresponding type code in fmt.
fn struct_pack(fmt: string, values: any) -> any
    let be = _sp_endian(fmt)
    let n = len(fmt)
    let start = _sp_code_start(fmt)
    let out = []
    let vi = 0
    let i = start
    while i < n
        let code = slice(fmt, i, i + 1)
        let v = values[vi]
        if code == "B"
            let bytes = _sp_write_u8(v)
            push(out, bytes[0])
        if code == "H"
            let bytes = []
            if be == 0
                bytes = _sp_write_u16_le(v)
            else
                bytes = _sp_write_u16_be(v)
            push(out, bytes[0])
            push(out, bytes[1])
        if code == "I"
            let bytes = []
            if be == 0
                bytes = _sp_write_u32_le(v)
            else
                bytes = _sp_write_u32_be(v)
            push(out, bytes[0])
            push(out, bytes[1])
            push(out, bytes[2])
            push(out, bytes[3])
        vi = vi + 1
        i = i + 1
    return out

// struct_unpack(fmt, bytes) -> list of decoded integers.
// Reads bytes sequentially according to type codes in fmt.
fn struct_unpack(fmt: string, bytes: any) -> any
    let be = _sp_endian(fmt)
    let n = len(fmt)
    let start = _sp_code_start(fmt)
    let out = []
    let pos = 0
    let i = start
    while i < n
        let code = slice(fmt, i, i + 1)
        if code == "B"
            let v = _sp_read_u8(bytes, pos)
            push(out, v)
            pos = pos + 1
        if code == "H"
            let v = 0
            if be == 0
                v = _sp_read_u16_le(bytes, pos)
            else
                v = _sp_read_u16_be(bytes, pos)
            push(out, v)
            pos = pos + 2
        if code == "I"
            let v = 0
            if be == 0
                v = _sp_read_u32_le(bytes, pos)
            else
                v = _sp_read_u32_be(bytes, pos)
            push(out, v)
            pos = pos + 4
        i = i + 1
    return out
