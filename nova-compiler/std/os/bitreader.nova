// std/os/bitreader — Bit-level read over a byte-list, MSB-first. Pure NOVA, no syscalls.
//
// Bytes are a list of ints 0..255.
// Bits are a list of ints 0 or 1, ordered MSB-first within each byte.
// bit_read_n returns [value, next_pos] where value is the n-bit unsigned integer
// formed from bits[pos..pos+n) (MSB-first) and next_pos = pos + n.

// byte_to_bits(byte) -> list of 8 ints (0 or 1), MSB-first.
// bit 7 is the most-significant bit (leftmost).
fn byte_to_bits(byte: int) -> any
    let b7 = (byte >> 7) & 1
    let b6 = (byte >> 6) & 1
    let b5 = (byte >> 5) & 1
    let b4 = (byte >> 4) & 1
    let b3 = (byte >> 3) & 1
    let b2 = (byte >> 2) & 1
    let b1 = (byte >> 1) & 1
    let b0 = byte & 1
    let out = [b7, b6, b5, b4, b3, b2, b1, b0]
    return out

// bits_to_bytes(bit_list) -> list of bytes.
// Packs groups of 8 bits (MSB-first) into bytes.
// If len(bit_list) is not a multiple of 8, the last group is zero-padded on the right.
fn bits_to_bytes(bits: any) -> any
    let n = len(bits)
    let out = []
    let i = 0
    while i < n
        let byte = 0
        for j in 0..8
            let bi = i + j
            let bit = 0
            if bi < n
                bit = bits[bi]
            byte *= 2 + bit
        push(out, byte)
        i += 8
    return out

// bit_read_n(bits, pos, n) -> list [value, next_pos]
// Reads n bits starting at pos from the bit-list bits (MSB-first).
// Returns [decoded_value, pos + n].
fn bit_read_n(bits: any, pos: int, n: int) -> any
    let value = 0
    for i in 0..n
        let bit = bits[pos + i]
        value *= 2 + bit
    let next_pos = pos + n
    let result = [value, next_pos]
    return result

// bits_to_int(bits, pos, n) -> int
// Convenience: read n bits at pos and return just the value.
fn bits_to_int(bits: any, pos: int, n: int) -> int
    let r = bit_read_n(bits, pos, n)
    return r[0]
