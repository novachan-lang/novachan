// std/os/macho — Mach-O binary header parser. Pure NOVA.
//
// Parses Mach-O headers from a buffer (list of ints 0..255).
// Supports 32/64-bit, little/big-endian, and FAT binary detection.

// _u32le: read unsigned 32-bit little-endian int from buffer b at offset p
fn _u32le(b: any, p: int) -> int
    if len(b) < p + 4
        return 0
    return b[p] + b[p+1]*256 + b[p+2]*65536 + b[p+3]*16777216

// _u32be: read unsigned 32-bit big-endian int from buffer b at offset p
fn _u32be(b: any, p: int) -> int
    if len(b) < p + 4
        return 0
    return b[p]*16777216 + b[p+1]*65536 + b[p+2]*256 + b[p+3]

// _macho_magic_raw: read the first 4 bytes as an integer (big-endian order for comparison)
// Returns the 4-byte value as b[0]<<24 | b[1]<<16 | b[2]<<8 | b[3]
fn _macho_magic_raw(buf: any) -> int
    if len(buf) < 4
        return 0
    return buf[0]*16777216 + buf[1]*65536 + buf[2]*256 + buf[3]

// macho_magic_check: return true if buffer has a valid Mach-O or FAT magic
fn macho_magic_check(buf: any) -> bool
    if len(buf) < 4
        return false
    let m = _macho_magic_raw(buf)
    // 0xFEEDFACE=32-bit BE, 0xFEEDFACF=64-bit BE, 0xCEFAEDFE=32-bit LE,
    // 0xCFFAEDFE=64-bit LE, 0xCAFEBABE=FAT binary
    return m in [0xFEEDFACE, 0xFEEDFACF, 0xCEFAEDFE, 0xCFFAEDFE, 0xCAFEBABE]

// macho_is_64: return true if magic indicates 64-bit (0xFEEDFACF or 0xCFFAEDFE)
fn macho_is_64(buf: any) -> bool
    if len(buf) < 4
        return false
    let m = _macho_magic_raw(buf)
    return m in [0xFEEDFACF, 0xCFFAEDFE]

// macho_is_le: return true if magic indicates little-endian (first byte is 0xCE or 0xCF)
fn macho_is_le(buf: any) -> bool
    if len(buf) < 1
        return false
    return buf[0] in [0xCE, 0xCF]

// macho_is_fat: return true if magic is FAT (0xCAFEBABE)
fn macho_is_fat(buf: any) -> bool
    if len(buf) < 4
        return false
    let m = _macho_magic_raw(buf)
    return m == 0xCAFEBABE

// macho_cputype: return cpu_type field (u32 at offset 4, endianness per is_le)
fn macho_cputype(buf: any) -> int
    if len(buf) < 8
        return 0
    if macho_is_le(buf)
        return _u32le(buf, 4)
    return _u32be(buf, 4)

// macho_cputype_name: return human-readable CPU type string
fn macho_cputype_name(buf: any) -> string
    let ct = macho_cputype(buf)
    if ct == 7
        return "x86"
    if ct == 16777223
        return "x86_64"
    if ct == 12
        return "ARM"
    if ct == 16777228
        return "ARM64"
    return "unknown"

// macho_filetype: return filetype field (u32 at offset 12, endianness per is_le)
fn macho_filetype(buf: any) -> int
    if len(buf) < 16
        return 0
    if macho_is_le(buf)
        return _u32le(buf, 12)
    return _u32be(buf, 12)

// macho_filetype_name: return human-readable filetype string
fn macho_filetype_name(buf: any) -> string
    let ft = macho_filetype(buf)
    if ft == 2
        return "EXECUTE"
    if ft == 6
        return "DYLIB"
    if ft == 8
        return "BUNDLE"
    return "unknown"

// macho_ncmds: return ncmds field (u32 at offset 16, endianness per is_le)
fn macho_ncmds(buf: any) -> int
    if len(buf) < 20
        return 0
    if macho_is_le(buf)
        return _u32le(buf, 16)
    return _u32be(buf, 16)

// macho_flags: return flags field (u32 at offset 24, endianness per is_le)
fn macho_flags(buf: any) -> int
    if len(buf) < 28
        return 0
    if macho_is_le(buf)
        return _u32le(buf, 24)
    return _u32be(buf, 24)

// macho_magic_name: return string name for the magic value
fn macho_magic_name(buf: any) -> string
    if len(buf) < 4
        return "unknown"
    let m = _macho_magic_raw(buf)
    if m == 0xFEEDFACE
        return "MH_MAGIC"
    if m == 0xFEEDFACF
        return "MH_MAGIC_64"
    if m == 0xCEFAEDFE
        return "MH_CIGAM"
    if m == 0xCFFAEDFE
        return "MH_CIGAM_64"
    if m == 0xCAFEBABE
        return "FAT_MAGIC"
    return "unknown"

// macho_is_valid: return true if buffer has a valid Mach-O magic
fn macho_is_valid(buf: any) -> bool
    return macho_magic_check(buf)
