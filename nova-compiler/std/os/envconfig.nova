// std/os/envconfig — Environment-variable-backed configuration lookups.
//
// API:
//   ec_get(key, default)               -> string   env(key) if set (non-empty), else default
//   ec_get_int(key, default)           -> int       parsed int if env(key) is a valid integer,
//                                                    else default
//   ec_get_bool(key, default)          -> bool      "true"/"1" (case-insensitive) -> true,
//                                                    "false"/"0" -> false, anything else -> default
//   ec_require(key)                    -> Result    ok(value) if set (non-empty), else
//                                                    err("missing required env var: <key>")
//   ec_prefix(prefix, candidate_keys)  -> dict      "<prefix><key>" -> value for every key in
//                                                    candidate_keys whose env var is set
//
// NOTE on ec_prefix: NOVA's runtime exposes only `env(name)` (single-key lookup) — there is no
// environ()-style builtin to enumerate the whole environment table. True "every var with this
// prefix" is therefore not obtainable from pure NOVA. ec_prefix instead takes an explicit list
// of candidate key suffixes to probe (the practical, honest workaround for a config module: the
// caller already knows the set of keys it cares about). This is a documented platform
// limitation, not a partial/fake implementation of "list all env vars".
//
// Private helpers prefixed _ec_.

// ec_get(key, default) -> string
fn ec_get(key: string, default_value: string) -> string
    let v = env(key)
    if len(v) == 0
        return default_value
    return v

// _ec_is_int(s) -> bool  true iff s is a non-empty string of digits (optionally leading "-").
fn _ec_is_int(s: string) -> bool
    if len(s) == 0
        return false
    let start = 0
    if char_at(s, 0) == "-"
        start = 1
    if start >= len(s)
        return false
    let i = start
    while i < len(s)
        let c = ord(char_at(s, i))
        if c < 48 or c > 57
            return false
        i = i + 1
    return true

// ec_get_int(key, default) -> int
fn ec_get_int(key: string, default_value: int) -> int
    let v = env(key)
    if _ec_is_int(v) == false
        return default_value
    return parse_int(v)

// ec_get_bool(key, default) -> bool
fn ec_get_bool(key: string, default_value: bool) -> bool
    let v = lower(env(key))
    if v == "true" or v == "1"
        return true
    if v == "false" or v == "0"
        return false
    return default_value

// ec_require(key) -> Result  ok(value) if set and non-empty, else err(message).
fn ec_require(key: string) -> any
    let v = env(key)
    if len(v) == 0
        return err("missing required env var: " + key)
    return ok(v)

// ec_prefix(prefix, candidate_keys) -> dict  "<prefix><key>" -> value for each candidate key
// whose "<prefix><key>" env var is set (non-empty). See module header for why this takes an
// explicit candidate list rather than enumerating the whole environment.
fn ec_prefix(prefix: string, candidate_keys: any) -> any
    let out = {}
    for i in 0..len(candidate_keys)
        let key = candidate_keys[i]
        let full_key = prefix + key
        let v = env(full_key)
        if len(v) > 0
            out[full_key] = v
    return out
