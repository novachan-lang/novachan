// std/os/ini_config — INI-style config file reader/writer.
//
// API:
//   ic_parse(content)              -> dict   section -> (key -> value), both as strings
//   ic_get(cfg, section, key, def) -> string  cfg[section][key] if present, else `def`
//   ic_set(cfg, section, key, val)            mutate cfg in place, creating the section if new
//   ic_build(cfg)                  -> string  render back to INI text
//   ic_sections(cfg)               -> list    section names, in first-seen/insertion order
//
// Grammar: "[section]" starts a section; "key = value" (or "key=value") sets a key; blank
// lines and lines starting with ";" or "#" are ignored; leading whitespace is trimmed from
// every line, key, and value. Keys that appear before any "[section]" header live in the
// "" (empty-string) global section. NOVA dicts preserve insertion order (verified against the
// runtime's dense NovaDict layout), so ic_build/ic_sections reproduce the order sections and
// keys were first seen in ic_parse or added via ic_set — round-tripping is deterministic.
// Private helpers prefixed _ic_.

// ic_parse(content) -> dict
fn ic_parse(content: string) -> any
    let cfg = {}
    let normalized = replace(content, chr(13), "")
    let lines = split(normalized, chr(10))
    let section = ""
    let i = 0
    while i < len(lines)
        let line = trim(lines[i])
        if len(line) > 0
            let c0 = char_at(line, 0)
            if c0 == ";" or c0 == "#"
                i += 1
            else
                if c0 == "[" and char_at(line, len(line) - 1) == "]"
                    section = trim(slice(line, 1, len(line) - 1))
                    if section not in cfg
                        cfg[section] = {}
                    i += 1
                else
                    let eq = find(line, "=")
                    if eq >= 0
                        let key = trim(slice(line, 0, eq))
                        let val = trim(slice(line, eq + 1, len(line)))
                        if section not in cfg
                            cfg[section] = {}
                        cfg[section][key] = val
                    i += 1
        else
            i += 1
    return cfg

// ic_get(cfg, section, key, default) -> string
fn ic_get(cfg: any, section: string, key: string, default_value: string) -> string
    if section not in cfg
        return default_value
    let sec = cfg[section]
    if key not in sec
        return default_value
    return sec[key]

// ic_set(cfg, section, key, value)  mutate cfg in place; creates the section if it doesn't exist.
fn ic_set(cfg: any, section: string, key: string, value: string)
    if section not in cfg
        cfg[section] = {}
    cfg[section][key] = value

// ic_sections(cfg) -> list  section names in insertion order.
fn ic_sections(cfg: any) -> any
    return keys(cfg)

// ic_build(cfg) -> string  render cfg back to INI text. The "" section (if present) is
// emitted first with no "[...]" header, matching how ic_parse treats pre-header keys.
fn ic_build(cfg: any) -> string
    let out_parts = []
    let secs = keys(cfg)
    for i in 0..len(secs)
        let section = secs[i]
        if section != ""
            push(out_parts, "[" + section + "]" + chr(10))
        let sec_dict = cfg[section]
        let ks = keys(sec_dict)
        let j = 0
        while j < len(ks)
            let k = ks[j]
            push(out_parts, k + " = " + sec_dict[k] + chr(10))
            j += 1
    let out = join(out_parts, "")
    return out
