// std/os/lineiter — Line splitting with mixed line endings. Pure NOVA.
//
// WHAT:
//   split_lines(s)       -> list  split on LF/CRLF/CR; no trailing empty from final newline
//   join_lines(lines)    -> string  join with LF
//   count_lines(s)       -> int  number of logical lines
//   chunk_lines(lines,n) -> list  groups of n lines (last group may be smaller)
//
// Line ending rules:
//   CR+LF  (\r\n) counted as ONE line ending
//   LF     (\n) alone counted as a line ending
//   CR     (\r) alone (not followed by LF) counted as a line ending
//   A final line ending does NOT produce a trailing empty string.
//
// All helpers are prefixed _li_ to avoid cross-module collisions.

// _li_split_lines_core: shared implementation returning a list of line strings.
fn _li_split_lines_core(s: string) -> any
    let lines = []
    let n = len(s)
    let i = 0
    let start = 0
    while i < n
        let c = slice(s, i, i + 1)
        if c == chr(13)
            // CR — check for following LF
            let line = slice(s, start, i)
            push(lines, line)
            i += 1
            if i < n and slice(s, i, i + 1) == chr(10)
                i += 1
            start = i
        else
            if c == chr(10)
                let line2 = slice(s, start, i)
                push(lines, line2)
                i += 1
                start = i
            else
                i += 1
    // Remaining content after last line ending (or entire string if no endings)
    if start < n
        let last = slice(s, start, n)
        push(lines, last)
    return lines

// split_lines: split string on LF/CRLF/CR into a list of lines.
// A trailing newline does NOT produce a trailing empty string.
fn split_lines(s: string) -> any
    return _li_split_lines_core(s)

// join_lines: join a list of line strings with LF between them.
fn join_lines(lines: any) -> string
    let out_parts = []
    let n = len(lines)
    for i in 0..n
        if i > 0
            push(out_parts, chr(10))
        push(out_parts, lines[i])
    let out = join(out_parts, "")
    return out

// count_lines: number of logical lines in s (using the same rules as split_lines).
fn count_lines(s: string) -> int
    if len(s) == 0
        return 0
    let lines = _li_split_lines_core(s)
    return len(lines)

// chunk_lines: partition a list of lines into groups of at most n lines each.
// Returns a list of lists. The last group may have fewer than n elements.
fn chunk_lines(lines: any, n: int) -> any
    let groups = []
    let total = len(lines)
    let i = 0
    while i < total
        let grp = []
        let j = 0
        while j < n and i < total
            push(grp, lines[i])
            i += 1
            j += 1
        push(groups, grp)
    return groups
