// std/os/filewatch — Simple content-hash-based file change detection.
//
// API:
//   fw_snapshot(path)          -> int    djb2 hash of file content; -1 if the file doesn't exist
//   fw_changed(path, prev)     -> bool   true iff fw_snapshot(path) differs from `prev`
//                                        (a missing file is "changed" relative to any real hash,
//                                        and a file that reappears with the same content as
//                                        before is correctly reported unchanged)
//   fw_snapshot_dir(path)      -> dict   filename -> hash, for every regular file directly in
//                                        `path` (subdirectories are not recursed into)
//
// Hash is djb2 (hash = hash*33 + byte, seed 5381), masked into a stable non-negative 62-bit
// range so results are consistent regardless of host int width. This is a content-equality
// signature, not a cryptographic hash — good enough to detect edits, not to resist tampering.
// Private helpers prefixed _fw_.

// djb2 hash of a string's bytes, folded into [0, 2^62).
fn _fw_djb2(content: string) -> int
    let hash = 5381
    for i in 0..len(content)
        let c = ord(char_at(content, i))
        hash = hash * 33 + c
    if hash < 0
        hash = -hash
    let mask = 4611686018427387903
    return hash & mask

// Join a directory and an entry name with a single "/".
fn _fw_join(dir: string, name: string) -> string
    if len(dir) == 0
        return name
    if char_at(dir, len(dir) - 1) == "/" or char_at(dir, len(dir) - 1) == "\\"
        return dir + name
    return dir + "/" + name

// fw_snapshot(path) -> int
fn fw_snapshot(path: string) -> int
    if not file_exists(path)
        return -1
    return _fw_djb2(read_file(path))

// fw_changed(path, prev_hash) -> bool
fn fw_changed(path: string, prev_hash: int) -> bool
    return fw_snapshot(path) != prev_hash

// fw_snapshot_dir(path) -> dict  filename -> hash for every regular file directly under path.
fn fw_snapshot_dir(path: string) -> any
    let out = {}
    let names = list_dir(path)
    for i in 0..len(names)
        let name = names[i]
        let full = _fw_join(path, name)
        if not is_dir(full)
            out[name] = fw_snapshot(full)
    return out
