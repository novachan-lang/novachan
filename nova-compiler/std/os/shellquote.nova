// std/os/shellquote — POSIX shell quoting utilities. Pure NOVA.
//
// WHAT:
//   sh_quote(s)         -> string  wrap in single quotes when needed;
//                                  no quotes for safe chars [A-Za-z0-9_./-]
//   sh_quote_list(args) -> string  space-joined quoted tokens
//   sh_split(s)         -> list    split respecting single/double quotes
//
// All helpers are prefixed _sq_ to avoid cross-module collisions.

// _sq_is_safe_char: true iff ch is in [A-Za-z0-9_./-]
fn _sq_is_safe_char(ch: string) -> bool
    let o = ord(ch)
    if o >= 65 and o <= 90
        return true
    if o >= 97 and o <= 122
        return true
    if o >= 48 and o <= 57
        return true
    if ch == "_"
        return true
    if ch == "."
        return true
    if ch == "/"
        return true
    if ch == "-"
        return true
    return false

// _sq_all_safe: true iff every character in s is a safe-unquoted char
fn _sq_all_safe(s: string) -> bool
    let n = len(s)
    if n == 0
        return false
    for i in 0..n
        let c = slice(s, i, i + 1)
        if not _sq_is_safe_char(c)
            return false
    return true

// sh_quote: POSIX single-quote a string.
// Safe non-empty strings returned as-is. Empty string -> ''.
// Otherwise wraps in single quotes, escaping each ' as '\''
fn sh_quote(s: string) -> string
    if len(s) > 0 and _sq_all_safe(s)
        return s
    let out = "'"
    let n = len(s)
    for i in 0..n
        let c = slice(s, i, i + 1)
        if c == "'"
            out += "'\\''"
        else
            out += c
    out += "'"
    return out

// sh_quote_list: space-join a list of strings, each individually quoted.
fn sh_quote_list(args: any) -> string
    let out_parts = []
    let n = len(args)
    for i in 0..n
        if i > 0
            push(out_parts, " ")
        push(out_parts, sh_quote(args[i]))
    let out = join(out_parts, "")
    return out

// _sq_read_single: read single-quoted content starting AFTER the opening '.
// Returns [content, next_pos] where next_pos is after the closing '.
// On unclosed quote, returns what was read so far with pos = n.
fn _sq_read_single(s: string, i: int, n: int) -> any
    let tok = ""
    while i < n
        let c = slice(s, i, i + 1)
        if c == "'"
            let res = [tok, i + 1]
            return res
        tok += c
        i += 1
    let res2 = [tok, n]
    return res2

// _sq_read_double: read double-quoted content starting AFTER the opening ".
// Returns [content, next_pos]. Simplified: no backslash escaping.
fn _sq_read_double(s: string, i: int, n: int) -> any
    let tok = ""
    while i < n
        let c = slice(s, i, i + 1)
        if c == "\""
            let res = [tok, i + 1]
            return res
        tok += c
        i += 1
    let res2 = [tok, n]
    return res2

// sh_split: split a shell command string into tokens respecting quotes.
fn sh_split(s: string) -> any
    let tokens = []
    let n = len(s)
    let i = 0
    while i < n
        // Skip leading whitespace
        while i < n and (slice(s, i, i + 1) == " " or slice(s, i, i + 1) == "	")
            i += 1
        if i >= n
            return tokens
        // Collect one token
        let tok_parts = []
        let done = 0
        while i < n and done == 0
            let c = slice(s, i, i + 1)
            if c == " " or c == "	"
                done = 1
            else
                if c == "'"
                    let sq = _sq_read_single(s, i + 1, n)
                    push(tok_parts, sq[0])
                    i = sq[1]
                else
                    if c == "\""
                        let dq = _sq_read_double(s, i + 1, n)
                        push(tok_parts, dq[0])
                        i = dq[1]
                    else
                        push(tok_parts, c)
                        i += 1
        let tok = join(tok_parts, "")
        push(tokens, tok)
    return tokens
