// std/os/endian_io — Read/write integers from/to byte-lists. Pure NOVA, no syscalls.
//
// Byte lists: list of ints 0..255.
// LE = little-endian (low byte at lowest address/index).
// BE = big-endian (high byte at lowest address/index).
// All write functions return a fresh list of bytes.
// All read functions take (bytes: list, pos: int) and return the decoded integer.

// _eio_byte(v, shift): extract one byte from v at given bit-shift position.
fn _eio_byte(v: int, shift: int) -> int
    let shifted = v >> shift
    return shifted & 255

// write_u16_le(v) -> list of 2 bytes, little-endian
fn write_u16_le(v: int) -> any
    let b0 = _eio_byte(v, 0)
    let b1 = _eio_byte(v, 8)
    let out = [b0, b1]
    return out

// write_u16_be(v) -> list of 2 bytes, big-endian
fn write_u16_be(v: int) -> any
    let b0 = _eio_byte(v, 8)
    let b1 = _eio_byte(v, 0)
    let out = [b0, b1]
    return out

// write_u32_le(v) -> list of 4 bytes, little-endian
fn write_u32_le(v: int) -> any
    let b0 = _eio_byte(v, 0)
    let b1 = _eio_byte(v, 8)
    let b2 = _eio_byte(v, 16)
    let b3 = _eio_byte(v, 24)
    let out = [b0, b1, b2, b3]
    return out

// write_u32_be(v) -> list of 4 bytes, big-endian
fn write_u32_be(v: int) -> any
    let b0 = _eio_byte(v, 24)
    let b1 = _eio_byte(v, 16)
    let b2 = _eio_byte(v, 8)
    let b3 = _eio_byte(v, 0)
    let out = [b0, b1, b2, b3]
    return out

// read_u16_le(b, pos) -> unsigned 16-bit int from bytes b at position pos (little-endian)
fn read_u16_le(b: any, pos: int) -> int
    let lo = b[pos]
    let hi = b[pos + 1]
    return lo + hi * 256

// read_u16_be(b, pos) -> unsigned 16-bit int from bytes b at position pos (big-endian)
fn read_u16_be(b: any, pos: int) -> int
    let hi = b[pos]
    let lo = b[pos + 1]
    return hi * 256 + lo

// read_u32_le(b, pos) -> unsigned 32-bit int from bytes b at position pos (little-endian)
fn read_u32_le(b: any, pos: int) -> int
    let b0 = b[pos]
    let b1 = b[pos + 1]
    let b2 = b[pos + 2]
    let b3 = b[pos + 3]
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

// read_i16_le(b, pos) -> signed 16-bit int from bytes b at position pos (little-endian)
// Two's complement: if result >= 32768, subtract 65536.
fn read_i16_le(b: any, pos: int) -> int
    let u = read_u16_le(b, pos)
    if u >= 32768
        return u - 65536
    return u
