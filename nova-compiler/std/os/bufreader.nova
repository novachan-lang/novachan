// std/os/bufreader — Buffered line reader over an in-memory string (dict-based handle).
//
// API:
//   br_new(content)      -> dict     a reader positioned at offset 0 over `content`
//   br_read_line(br)     -> Result   ok(line) and advances past it; err("EOF") at end of input
//   br_peek_line(br)     -> string   next line without advancing; "" at end of input
//   br_skip(br, n)       -> unit     advance the position by n chars (clamped to [0, len])
//   br_remaining(br)     -> string   unread tail of the content
//   br_position(br)      -> int      current byte offset into content
//
// Lines are split on "\n"; a trailing "\r" (CRLF input) is stripped from each returned line.
// The final line need not end with a newline. Private helpers prefixed _br_.

// br_new(content) -> dict
fn br_new(content: string) -> any
    let br = {}
    br["content"] = content
    br["pos"] = 0
    return br

// Index of the next "\n" at or after pos; -1 if none.
fn _br_find_newline(content: string, pos: int) -> int
    for i in pos..len(content)
        if char_at(content, i) == chr(10)
            return i
    return -1

// Strip a single trailing "\r" (CRLF normalization), if present.
fn _br_strip_cr(s: string) -> string
    if len(s) > 0 and char_at(s, len(s) - 1) == chr(13)
        return slice(s, 0, len(s) - 1)
    return s

// Compute the next line starting at pos without mutating anything: shared by read/peek so
// their behavior can never drift apart. Returns {"eof": bool, "line": string, "next_pos": int}.
fn _br_scan_line(content: string, pos: int) -> any
    let n = len(content)
    let res = {}
    if pos >= n
        res["eof"] = true
        res["line"] = ""
        res["next_pos"] = pos
        return res
    let nl = _br_find_newline(content, pos)
    res["eof"] = false
    if nl < 0
        res["line"] = _br_strip_cr(slice(content, pos, n))
        res["next_pos"] = n
    else
        res["line"] = _br_strip_cr(slice(content, pos, nl))
        res["next_pos"] = nl + 1
    return res

// br_read_line(br) -> Result  ok(line), advancing past it; err("EOF") once exhausted.
fn br_read_line(br: any) -> any
    let scanned = _br_scan_line(br["content"], br["pos"])
    if scanned["eof"]
        return err("EOF")
    br["pos"] = scanned["next_pos"]
    return ok(scanned["line"])

// br_peek_line(br) -> string  next line without advancing the position; "" at EOF.
fn br_peek_line(br: any) -> string
    let scanned = _br_scan_line(br["content"], br["pos"])
    if scanned["eof"]
        return ""
    return scanned["line"]

// br_skip(br, n) -> unit  advance the position by n characters, clamped to [0, len(content)].
fn br_skip(br: any, n: int)
    let target = br["pos"] + n
    if target > len(br["content"])
        target = len(br["content"])
    if target < 0
        target = 0
    br["pos"] = target

// br_remaining(br) -> string  the unread tail of the content.
fn br_remaining(br: any) -> string
    return slice(br["content"], br["pos"], len(br["content"]))

// br_position(br) -> int  current byte offset into content.
fn br_position(br: any) -> int
    return br["pos"]
