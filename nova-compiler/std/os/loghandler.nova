// std/os/loghandler — Minimal buffered log handler (dict-based handle).
//
// API:
//   log_new(path)                 -> dict    a log handle: {"path": path, "buffer": ""}
//   log_write(lg, level, msg)               append "[TIMESTAMP] [LEVEL] msg\n" to the in-memory
//                                            buffer (does not touch disk until log_flush)
//   log_flush(lg)                 -> bool    append the buffered text to `path` on disk, then
//                                            clear the buffer; true on success
//   log_level_info()/warn()/error()/debug()  -> string   canonical level tags
//
// A log handle is a dict so it is mutated in place across calls (NOVA dicts are reference
// types) — no explicit "return the updated handle" plumbing is needed by callers.
// Private helpers prefixed _lh_.

// log_level_info/warn/error/debug: canonical level tag constants.
fn log_level_info() -> string
    return "INFO"

fn log_level_warn() -> string
    return "WARN"

fn log_level_error() -> string
    return "ERROR"

fn log_level_debug() -> string
    return "DEBUG"

// log_new(path) -> dict  new log handle for the given file path. Does not touch disk yet.
fn log_new(path: string) -> any
    let lg = {}
    lg["path"] = path
    lg["buffer"] = ""
    return lg

// log_write(lg, level, msg)  append a formatted line to the in-memory buffer.
fn log_write(lg: any, level: string, msg: string)
    let line = "[" + str(time_ms()) + "] [" + level + "] " + msg + chr(10)
    lg["buffer"] += line

// log_flush(lg) -> bool  append the buffered lines to the log file on disk and clear the
// buffer. Returns true on success (including a no-op flush of an empty buffer).
fn log_flush(lg: any) -> bool
    let buf = lg["buffer"]
    if len(buf) == 0
        return true
    if file_exists(lg["path"])
        append_file(lg["path"], buf)
    else
        write_file(lg["path"], buf)
    lg["buffer"] = ""
    return file_exists(lg["path"])
