// std/combinatorics/compositions.nova — integer compositions (ordered partitions).
// LEAF — imports NOTHING. INTEGER arithmetic only.
//
// Public API:
//   comp_all(n)              -> list  all compositions of n into positive parts (ordered)
//   comp_count(n)            -> int   2^(n-1) for n>=1; 1 for n=0
//   comp_k(n, k)             -> list  compositions of n into exactly k positive parts
//   comp_k_count(n, k)       -> int   C(n-1, k-1) — number of such compositions
//   comp_weak(n, k)          -> list  weak compositions: k non-negative parts summing to n
//   comp_weak_count(n, k)    -> int   C(n+k-1, k-1) — stars-and-bars
//   comp_bounded(n, k, maxp) -> list  compositions of n into k parts, each <= maxp
//   comp_largest_part(comp)  -> int   maximum part value in a composition

// _comp_nCr — C(n, k) using multiplicative formula. Returns 0 if k > n or k < 0.
fn _comp_nCr(n: int, k: int) -> int
    if k < 0
        return 0
    if k > n
        return 0
    if k == 0
        return 1
    let r = k
    if n - k < r
        r = n - k
    let result = 1
    for i in 0..r
        result = result * (n - i)
        result = result / (i + 1)
    result

// _comp_pow2 — 2^n via iterative doubling
fn _comp_pow2(n: int) -> int
    let v = 1
    for i in 0..n
        v = v * 2
    v

// comp_count — number of compositions of n: 2^(n-1) for n>=1, 1 for n=0.
fn comp_count(n: int) -> int
    if n == 0
        return 1
    _comp_pow2(n - 1)

// comp_k_count — C(n-1, k-1): number of compositions of n into exactly k positive parts.
fn comp_k_count(n: int, k: int) -> int
    if k <= 0
        return 0
    if n <= 0 and k > 0
        return 0
    _comp_nCr(n - 1, k - 1)

// comp_weak_count — C(n+k-1, k-1): number of weak compositions of n into k parts.
fn comp_weak_count(n: int, k: int) -> int
    if k <= 0
        return 0
    _comp_nCr(n + k - 1, k - 1)

// _comp_snap — copy slot[0..depth-1] into a fresh list
fn _comp_snap(slot, depth) -> any
    let snap = [slot[i] for i in 0..depth]
    snap

// _comp_all_gen — recursive backtracking for all compositions of n.
// slot: pre-allocated array of size n (max parts); depth: current fill level.
// Tries part values from largest to smallest so first output is [n], last is [1..1].
fn _comp_all_gen(result, slot, depth, remaining)
    if remaining == 0
        push(result, _comp_snap(slot, depth))
        return null
    let part = remaining
    while part >= 1
        slot[depth] = part
        _comp_all_gen(result, slot, depth + 1, remaining - part)
        part = part - 1

// comp_all — all compositions of n into positive parts.
// Order: [n] first (largest part), [1,1,...,1] last (all ones).
fn comp_all(n: int) -> any
    let result = []
    if n == 0
        push(result, [])
        return result
    // Pre-allocate slot of max possible depth = n
    let slot = []
    for i in 0..n
        push(slot, 0)
    _comp_all_gen(result, slot, 0, n)
    result

// _comp_k_gen — recursive backtracking for compositions of n into exactly k positive parts.
// slot: pre-allocated array of size k; depth: current fill level.
fn _comp_k_gen(result, slot, k, depth, remaining, parts_left)
    if parts_left == 0
        if remaining == 0
            push(result, _comp_snap(slot, k))
        return null
    if remaining <= 0
        return null
    let max_part = remaining - (parts_left - 1)
    if max_part < 1
        return null
    let part = 1
    while part <= max_part
        slot[depth] = part
        _comp_k_gen(result, slot, k, depth + 1, remaining - part, parts_left - 1)
        part = part + 1

// comp_k — all compositions of n into exactly k positive parts.
// Listed in lexicographic order (smallest first part first).
fn comp_k(n: int, k: int) -> any
    let result = []
    if k <= 0
        if k == 0 and n == 0
            push(result, [])
        return result
    if n <= 0
        return result
    let slot = []
    for i in 0..k
        push(slot, 0)
    _comp_k_gen(result, slot, k, 0, n, k)
    result

// _comp_weak_gen — recursive backtracking for weak compositions (parts >= 0).
// slot: pre-allocated array of size k; depth: current fill level.
fn _comp_weak_gen(result, slot, k, depth, remaining, parts_left)
    if parts_left == 0
        if remaining == 0
            push(result, _comp_snap(slot, k))
        return null
    let part = 0
    while part <= remaining
        slot[depth] = part
        _comp_weak_gen(result, slot, k, depth + 1, remaining - part, parts_left - 1)
        part = part + 1

// comp_weak — all weak compositions of n into exactly k non-negative parts.
// Listed in lexicographic order (smallest first part first).
fn comp_weak(n: int, k: int) -> any
    let result = []
    if k <= 0
        if k == 0 and n == 0
            push(result, [])
        return result
    let slot = []
    for i in 0..k
        push(slot, 0)
    _comp_weak_gen(result, slot, k, 0, n, k)
    result

// _comp_bounded_gen — recursive backtracking for bounded compositions (parts in [1..maxp]).
fn _comp_bounded_gen(result, slot, k, depth, remaining, parts_left, maxp)
    if parts_left == 0
        if remaining == 0
            push(result, _comp_snap(slot, k))
        return null
    if remaining <= 0
        return null
    let part = 1
    while part <= maxp and part <= remaining
        slot[depth] = part
        _comp_bounded_gen(result, slot, k, depth + 1, remaining - part, parts_left - 1, maxp)
        part = part + 1

// comp_bounded — compositions of n into exactly k positive parts each <= maxpart.
fn comp_bounded(n: int, k: int, maxpart: int) -> any
    let result = []
    if k <= 0 or n <= 0
        return result
    if maxpart < 1
        return result
    let slot = [0 for i in 0..k]
    _comp_bounded_gen(result, slot, k, 0, n, k, maxpart)
    result

// comp_largest_part — maximum part value in a composition. Returns 0 for empty composition.
fn comp_largest_part(comp) -> int
    let n = len(comp)
    if n == 0
        return 0
    let best = comp[0]
    for i in 1..n
        if comp[i] > best
            best = comp[i]
    best
