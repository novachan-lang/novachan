// std/combinatorics/lyndon.nova — Lyndon words, necklaces, de Bruijn sequences.
// LEAF — imports NOTHING.
//
// A Lyndon word over {0..k-1} is a word strictly smaller (lexicographically)
// than all of its proper rotations. Equivalently, it is the lexicographically
// smallest representative of its conjugacy class (cyclic equivalence class).
//
// Public API:
//   ly_is_lyndon(word)          -> bool  true iff word is a Lyndon word
//   ly_all(alphabet_size, n)    -> list  all Lyndon words of length n over {0..k-1}
//   ly_count(k, n)              -> int   |Lyndon(k,n)| = (1/n)*sum_{d|n} mu(d)*k^(n/d)
//   ly_factorize(word)          -> list  Chen-Fox-Lyndon factorization (Duval's algorithm)
//   ly_necklace_count(k, n)     -> int   (1/n)*sum_{d|n} phi(d)*k^(n/d)
//   ly_rotations(word)          -> list  all n rotations (including original) as lists
//   ly_least_rotation(word)     -> list  lex-least rotation (Booth's algorithm)
//   ly_de_bruijn(k, n)          -> list  de Bruijn sequence B(k,n) as list of ints
//
// Private helpers use the _ly_ prefix.

// _ly_dup — deep-copy a list of ints.
fn _ly_dup(a: list) -> list
    let out = []
    let i = 0
    while i < len(a)
        push(out, a[i])
        i = i + 1
    out

// _ly_lt_word — true iff list a is strictly lex-less than list b (same length assumed).
fn _ly_lt_word(a: list, b: list) -> bool
    let n = len(a)
    let i = 0
    while i < n
        if a[i] < b[i]
            return true
        if a[i] > b[i]
            return false
        i = i + 1
    false

// _ly_eq_word — true iff two lists are identical.
fn _ly_eq_word(a: list, b: list) -> bool
    let n = len(a)
    if len(b) != n
        return false
    let i = 0
    while i < n
        if a[i] != b[i]
            return false
        i = i + 1
    true

// _ly_rotate — rotate list word by r positions left.
fn _ly_rotate(word: list, r: int) -> list
    let n = len(word)
    let out = []
    let i = 0
    while i < n
        push(out, word[(i + r) % n])
        i = i + 1
    out

// ly_is_lyndon — true iff word (list of ints) is a Lyndon word.
// Empty word or length-1 word is considered Lyndon.
// word is Lyndon iff it is strictly lex-smaller than all proper rotations.
fn ly_is_lyndon(word: list) -> bool
    let n = len(word)
    if n <= 1
        return true
    let r = 1
    while r < n
        let rot = _ly_rotate(word, r)
        if not _ly_lt_word(word, rot)
            return false
        r = r + 1
    true

// ly_rotations — all n rotations of word (rotation by 0,1,...,n-1).
fn ly_rotations(word: list) -> list
    let n = len(word)
    let out = []
    let r = 0
    while r < n
        push(out, _ly_rotate(word, r))
        r = r + 1
    out

// ly_least_rotation — lex-smallest rotation (Booth's algorithm, O(n)).
// Returns the rotated list (not just the index).
// Booth's algorithm: builds failure function on doubled string to find min rotation start.
fn ly_least_rotation(word: list) -> list
    let n = len(word)
    if n == 0
        return _ly_dup(word)
    // Build doubled array w[0..2n-1] = word[i % n]
    // Booth's: f[i] = failure function, s = current best start
    let f = []
    let i = 0
    while i < 2 * n
        push(f, -1)
        i = i + 1
    let s = 0
    let j = 1
    while j < 2 * n
        let fj = f[j - s - 1]
        while fj != -1 and word[j % n] != word[(s + fj + 1) % n]
            if word[j % n] < word[(s + fj + 1) % n]
                s = j - fj - 1
            fj = f[fj]
        if word[j % n] != word[(s + fj + 1) % n]
            if word[j % n] < word[s % n]
                s = j
            f[j - s] = -1
        else
            f[j - s] = fj + 1
        j = j + 1
    _ly_rotate(word, s)

// ly_factorize — Chen-Fox-Lyndon factorization via Duval's algorithm.
// Decomposes word into Lyndon words w1 >= w2 >= ... >= wk (non-increasing lex order).
// Each factor is a Lyndon word. Returns list of lists.
fn ly_factorize(word: list) -> list
    let out = []
    let n = len(word)
    let i = 0
    while i < n
        let j = i
        let k = i + 1
        while k < n and word[j] <= word[k]
            if word[j] < word[k]
                j = i
            else
                j = j + 1
            k = k + 1
        // Lyndon word has length k - j; repeat it (k-i)/(k-j) times
        let period = k - j
        while i <= j
            let factor = []
            let t = 0
            while t < period
                push(factor, word[i + t])
                t = t + 1
            push(out, factor)
            i = i + period
    out

// _ly_pow — integer power (base^exp), iterative.
fn _ly_pow(base: int, exp: int) -> int
    let result = 1
    let b = base
    let e = exp
    while e > 0
        if e % 2 == 1
            result = result * b
        b = b * b
        e = e / 2
    result

// _ly_divisors — list of all divisors of n (including 1 and n), ascending.
fn _ly_divisors(n: int) -> list
    let out = []
    let d = 1
    while d <= n
        if n % d == 0
            push(out, d)
        d = d + 1
    out

// _ly_mobius — Mobius function mu(n): 0 if n has a squared prime factor,
// (-1)^k if n is product of k distinct primes, 1 if n==1.
fn _ly_mobius(n: int) -> int
    if n == 1
        return 1
    // factor n, count primes, detect squares
    let primes = 0
    let m = n
    let p = 2
    while p * p <= m
        if m % p == 0
            primes = primes + 1
            m = m / p
            if m % p == 0
                return 0
        p = p + 1
    if m > 1
        primes = primes + 1
    // (-1)^primes
    if primes % 2 == 0
        return 1
    return -1

// ly_count — number of Lyndon words of length n over k-letter alphabet.
// Formula: (1/n) * sum_{d|n} mu(d) * k^(n/d).  ly_count(2,3)=2.
// Special case: ly_count(k,1) = k (each singleton is Lyndon).
fn ly_count(k: int, n: int) -> int
    if n == 0
        return 0
    let divs = _ly_divisors(n)
    let total = 0
    let i = 0
    while i < len(divs)
        let d = divs[i]
        total = total + _ly_mobius(d) * _ly_pow(k, n / d)
        i = i + 1
    total / n

// _ly_euler_phi — Euler's totient phi(n).
fn _ly_euler_phi(n: int) -> int
    if n <= 1
        return n
    let result = n
    let m = n
    let p = 2
    while p * p <= m
        if m % p == 0
            while m % p == 0
                m = m / p
            result = result - result / p
        p = p + 1
    if m > 1
        result = result - result / m
    result

// ly_necklace_count — number of necklaces of length n over k letters.
// Formula: (1/n) * sum_{d|n} phi(d) * k^(n/d).
fn ly_necklace_count(k: int, n: int) -> int
    if n == 0
        return 1
    let divs = _ly_divisors(n)
    let total = 0
    let i = 0
    while i < len(divs)
        let d = divs[i]
        total = total + _ly_euler_phi(d) * _ly_pow(k, n / d)
        i = i + 1
    total / n

// _ly_fkm_gen — FKM (Fredericksen-Kessler-Maurer) algorithm generating Lyndon words.
// Generates all Lyndon words of length n over {0..k-1} in lex order by appending to out.
// a = current candidate (length n, 1-indexed internally), j = last position set.
// We implement the iterative version: generate all aperiodic necklaces = Lyndon words.
fn _ly_fkm_gen(k: int, n: int, out: list)
    if n == 0
        return 0
    // a[0..n-1] where a[i] in {0..k-1}; start with all zeros
    let a = []
    let i = 0
    while i < n
        push(a, 0)
        i = i + 1
    // Use standard FKM: a is maintained as a length-n array
    // generate loop: append a[0..n-1] if n % j == 0 (j = length of period)
    // then increment
    let j = 1
    // Use a different approach: iterate over all (k^n) words and check Lyndon via factorization
    // But for correctness and known-good behavior, use direct FKM from literature:
    // FKM generates words of length t <= n in lexicographic order.
    // We want only those of length exactly n.
    // Reset a to [0..0]
    let t = 0
    while t < n
        a[t] = 0
        t = t + 1
    // Standard FKM iteration
    // while true:
    //   if n % j == 0: output a[0..j-1] as a word of length j
    //   extend a: a[j..n-1] = a[0..n-j-1] (repeat period)
    //   find i = n-1 going left while a[i] == k-1: reset a[i]=0, i--
    //   if i < j0 (the initial j): break
    //   a[i]++; j = i+1 (or compute next j)
    // This is tricky to implement iteratively in NOVA; use explicit recursion.
    return 0

// _ly_all_rec — generate all Lyndon words of length n over {0..k-1} by FKM.
// We implement the recursive FKM approach: generate w[0..t-1] and extend.
// Based on: for each position, try all values >= a[pos % t_prev].
// Simplest correct approach: enumerate all k^n words and filter by ly_is_lyndon.
// For KAT sizes (n<=5, k<=4) this is fast enough (4^5=1024 words max).
fn _ly_all_rec(k: int, n: int, pos: int, a: list, out: list)
    if pos == n
        if ly_is_lyndon(a)
            push(out, _ly_dup(a))
        return 0
    let start = 0
    let v = start
    while v < k
        a[pos] = v
        _ly_all_rec(k, n, pos + 1, a, out)
        v = v + 1
    a[pos] = 0
    return 0

// ly_all — all Lyndon words of length n over {0..k-1}, in lexicographic order.
// Uses enumeration + is_lyndon filter (correct for KAT sizes).
// ly_all(2,3) = [[0,0,1],[0,1,1]], ly_all(2,1) = [[0],[1]].
fn ly_all(k: int, n: int) -> list
    let out = []
    if n <= 0 or k <= 0
        return out
    let a = []
    let i = 0
    while i < n
        push(a, 0)
        i = i + 1
    _ly_all_rec(k, n, 0, a, out)
    out

// ly_de_bruijn — de Bruijn sequence B(k,n) as list of ints (length k^n).
// Constructed by concatenating the Lyndon words of length dividing n in lex order.
// Each Lyndon word of length d (where d|n) is repeated n/d times conceptually,
// but the FKM algorithm does this naturally: output the word whenever at a length-d
// repetition, the repetition contributes one period to the sequence.
// Simple implementation: concatenate all Lyndon words whose length divides n,
// each word repeated once (this gives the de Bruijn sequence directly for FKM).
fn ly_de_bruijn(k: int, n: int) -> list
    let out = []
    if n <= 0 or k <= 0
        return out
    // Generate all Lyndon words of length d for each d dividing n, concatenate
    let d = 1
    while d <= n
        if n % d == 0
            let words = ly_all(k, d)
            let wi = 0
            while wi < len(words)
                let w = words[wi]
                let t = 0
                while t < len(w)
                    push(out, w[t])
                    t = t + 1
                wi = wi + 1
        d = d + 1
    out
