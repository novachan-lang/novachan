// std/combinatorics/setpartition.nova — set partitions, Bell numbers, Stirling numbers.
// LEAF — imports NOTHING.
//
// A set partition of {0..n-1} is a collection of non-empty, disjoint blocks whose
// union is {0..n-1}. Canonical form: blocks sorted by minimum element; within each
// block elements are sorted ascending.
//
// Public API:
//   sp_all(n)                  -> list  all set partitions of {0..n-1} (list of partitions)
//   sp_bell(n)                 -> int   Bell number B(n)
//   sp_stirling2(n, k)         -> int   Stirling number of 2nd kind S(n,k)
//   sp_k(n, k)                 -> list  all set partitions of {0..n-1} into exactly k blocks
//   sp_rgs(n)                  -> list  all restricted growth strings of length n
//   sp_rgs_to_partition(rgs)   -> list  convert RGS to set partition
//   sp_bell_triangle(n)        -> list  Bell triangle (n rows)
//   sp_block_count(partition)  -> int   number of blocks in a partition
//
// Private helpers use the _sp_ prefix.
//
// Restricted Growth String (RGS): a[0]=0, a[i] in {0..max(a[0..i-1])+1}.
// Each RGS encodes a unique set partition where item i goes to block a[i].

// _sp_dup_int — deep-copy a list of ints.
fn _sp_dup_int(a: list) -> list
    let out = []
    for i in 0..len(a)
        push(out, a[i])
    out

// _sp_dup_partition — deep-copy a partition (list of lists of ints).
fn _sp_dup_partition(p: list) -> list
    let out = []
    let i = 0
    while i < len(p)
        push(out, _sp_dup_int(p[i]))
        i += 1
    out

// sp_stirling2 — Stirling number of the 2nd kind S(n, k).
// S(n,k) = k*S(n-1,k) + S(n-1,k-1).  Base: S(0,0)=1, S(n,0)=0 for n>0, S(0,k)=0 for k>0.
// Uses dynamic programming table, bottom-up.
fn sp_stirling2(n: int, k: int) -> int
    if k < 0 or k > n
        return 0
    if n == 0 and k == 0
        return 1
    // dp[i][j] = S(i, j), build table up to n x k
    let dp = []
    let i = 0
    while i <= n
        let row = []
        let j = 0
        while j <= n
            push(row, 0)
            j += 1
        push(dp, row)
        i += 1
    dp[0][0] = 1
    let r = 1
    while r <= n
        let c = 1
        while c <= r
            let prev_row = dp[r - 1]
            let val = c * prev_row[c] + prev_row[c - 1]
            dp[r][c] = val
            c += 1
        r += 1
    dp[n][k]

// sp_bell — Bell number B(n) = sum_{k=0}^{n} S(n,k).
// B(0)=1, B(1)=1, B(2)=2, B(3)=5, B(4)=15, B(5)=52.
fn sp_bell(n: int) -> int
    if n <= 0
        return 1
    // Use Bell triangle for efficiency
    // Bell triangle: row 0 = [1]; row r starts with last of row r-1,
    // each next = prev in current + prev in previous row same col.
    let prev = []
    push(prev, 1)
    let r = 1
    while r <= n
        let cur = []
        push(cur, prev[len(prev) - 1])
        let c = 1
        while c <= r
            let cur_len = len(cur)
            let left = cur[cur_len - 1]
            let above = prev[c - 1]
            push(cur, left + above)
            c += 1
        prev = cur
        r += 1
    prev[0]

// sp_bell_triangle — first n rows of the Bell triangle.
// Row k has k+1 elements; first element of row k is B(k).
// sp_bell_triangle(0)=[], sp_bell_triangle(3)=[[1],[1,2],[2,3,5]].
fn sp_bell_triangle(n: int) -> list
    let tri = []
    if n <= 0
        return tri
    let row0 = []
    push(row0, 1)
    push(tri, row0)
    for r in 1..n
        let prev = tri[r - 1]
        let cur = []
        push(cur, prev[len(prev) - 1])
        let c = 1
        while c <= r
            let cur_len = len(cur)
            let left = cur[cur_len - 1]
            let above = prev[c - 1]
            push(cur, left + above)
            c += 1
        push(tri, cur)
    tri

// _sp_rgs_gen — enumerate all RGS of length n.
// An RGS a[0..n-1] satisfies: a[0]=0, a[i] <= max(a[0..i-1])+1.
// We build recursively; max_so_far = max value seen in a[0..pos-1].
fn _sp_rgs_gen(n: int, pos: int, max_so_far: int, a: list, out: list)
    if pos == n
        push(out, _sp_dup_int(a))
        return 0
    let v = 0
    while v <= max_so_far + 1
        a[pos] = v
        let new_max = max_so_far
        if v > max_so_far
            new_max = v
        _sp_rgs_gen(n, pos + 1, new_max, a, out)
        v += 1
    a[pos] = 0
    return 0

// sp_rgs — all restricted growth strings of length n.
// Count = B(n). sp_rgs(0)=[[0]] wait, n=0 is empty word: [[]] or just [[]].
// sp_rgs(1)=[[0]], sp_rgs(2)=[[0,0],[0,1]], len(sp_rgs(3))==5.
fn sp_rgs(n: int) -> list
    let out = []
    if n <= 0
        let empty = []
        push(out, empty)
        return out
    let a = []
    let i = 0
    while i < n
        push(a, 0)
        i += 1
    // First element must be 0; start from pos=1 with max_so_far=0
    a[0] = 0
    _sp_rgs_gen(n, 1, 0, a, out)
    out

// sp_rgs_to_partition — convert RGS to a set partition (list of blocks).
// Block i = list of elements j where rgs[j] == i, in order.
// sp_rgs_to_partition([0,0,1]) = [[0,1],[2]] (items 0,1 in block 0; item 2 in block 1).
fn sp_rgs_to_partition(rgs: list) -> list
    let n = len(rgs)
    if n == 0
        return []
    // Find number of blocks = max(rgs) + 1
    let num_blocks = 0
    for i in 0..n
        if rgs[i] > num_blocks
            num_blocks = rgs[i]
    num_blocks += 1
    // Build blocks
    let blocks = []
    for b in 0..num_blocks
        let blk = []
        push(blocks, blk)
    for j in 0..n
        let blk_id = rgs[j]
        push(blocks[blk_id], j)
    blocks

// sp_block_count — number of blocks in a partition.
fn sp_block_count(partition: list) -> int
    len(partition)

// sp_all — all set partitions of {0..n-1}, each as a list of blocks.
// Count = B(n). Ordered by RGS lexicographic order.
// sp_all(0)=[[]] (one partition, the empty partition), sp_all(1)=[[[0]]],
// sp_all(2)=[[[0,1]],[[0],[1]]], len(sp_all(3))==5.
fn sp_all(n: int) -> list
    let out = []
    if n <= 0
        // Empty partition: one partition with zero blocks
        let empty_part = []
        push(out, empty_part)
        return out
    let all_rgs = sp_rgs(n)
    for i in 0..len(all_rgs)
        let rgs = all_rgs[i]
        let part = sp_rgs_to_partition(rgs)
        push(out, part)
    out

// sp_k — all set partitions of {0..n-1} into exactly k non-empty blocks.
// Count = S(n, k). sp_k(3,2) has 3 elements.
fn sp_k(n: int, k: int) -> list
    let out = []
    let all = sp_all(n)
    for i in 0..len(all)
        let part = all[i]
        if len(part) == k
            push(out, part)
    out
