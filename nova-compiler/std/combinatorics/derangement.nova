// std/combinatorics/derangement.nova — derangements (permutations with no fixed points).
// LEAF — imports NOTHING.
//
// Public API:
//   der_count(n)                     -> int   subfactorial D_n; D_0=1,D_1=0,D_2=1,D_3=2,D_4=9,D_5=44
//   der_all(items)                   -> any   list of all derangements of items (lexicographic)
//   der_is_derangement(perm,orig)    -> bool  true iff no position i has perm[i]==orig[i]
//   der_nth(items,k)                 -> any   k-th derangement (0-indexed) in lexicographic order
//   der_ratio_permille(n)            -> int   D_n*1000/n! — integer approx of 1/e*1000 (~368)
//   der_partial(items,fixed_allowed) -> any   permutations where only positions NOT in fixed_allowed must be displaced
//   der_count_with_fixed(n,k)        -> int   permutations of n with exactly k fixed points = C(n,k)*D_{n-k}

// _der_factorial — n! iterative.
fn _der_factorial(n: int) -> int
    let acc = 1
    let i = 2
    while i <= n
        acc = acc * i
        i += 1
    return acc

// _der_ncr — C(n,r) binomial coefficient.
fn _der_ncr(n: int, r: int) -> int
    if r < 0
        return 0
    if r > n
        return 0
    let k = r
    if n - r < k
        k = n - r
    let result = 1
    for i in 0..k
        result = result * (n - i)
        result = result / (i + 1)
    return result

// _der_dup — deep-copy a list.
fn _der_dup(a) -> any
    let out = []
    let i = 0
    let n = len(a)
    while i < n
        push(out, a[i])
        i += 1
    return out

// _der_dup2 — deep-copy a list-of-lists.
fn _der_dup2(a) -> any
    let out = []
    let i = 0
    let n = len(a)
    while i < n
        push(out, _der_dup(a[i]))
        i += 1
    return out

// _der_swap — swap elements i and j in a list copy.
fn _der_swap(a, i: int, j: int) -> any
    let b = _der_dup(a)
    let tmp = b[i]
    b[i] = b[j]
    b[j] = tmp
    return b

// der_count — subfactorial D_n via recurrence D_n = (n-1)*(D_{n-1}+D_{n-2}).
// D_0=1, D_1=0.
fn der_count(n: int) -> int
    if n == 0
        return 1
    if n == 1
        return 0
    let d_prev2 = 1
    let d_prev1 = 0
    let i = 2
    while i <= n
        let d_cur = (i - 1) * (d_prev1 + d_prev2)
        d_prev2 = d_prev1
        d_prev1 = d_cur
        i += 1
    return d_prev1

// der_is_derangement — returns true iff perm[i] != orig[i] for all i.
fn der_is_derangement(perm, original) -> bool
    let n = len(perm)
    for i in 0..n
        if perm[i] == original[i]
            return false
    return true

// _der_gen — recursive backtracking generator; appends all derangements to out.
// cur = current partial permutation, used = list of bool flags.
fn _der_gen(items, orig, cur, used, out)
    let n = len(items)
    let pos = len(cur)
    if pos == n
        push(out, _der_dup(cur))
        return
    for i in 0..n
        if used[i] == 0
            if items[i] != orig[pos]
                used[i] = 1
                push(cur, items[i])
                _der_gen(items, orig, cur, used, out)
                let last = len(cur) - 1
                cur[last] = 0
                let cur2 = []
                let j = 0
                while j < last
                    push(cur2, cur[j])
                    j += 1
                let k = 0
                while k < last
                    cur[k] = cur2[k]
                    k += 1
                // truncate cur to `last` elements
                let tmp = _der_dup(cur2)
                let t2 = len(tmp)
                while len(cur) > t2
                    // rebuild cur from cur2
                    let ci = 0
                    let nc = []
                    while ci < t2
                        push(nc, tmp[ci])
                        ci += 1
                    let ci2 = 0
                    while ci2 < t2
                        cur[ci2] = nc[ci2]
                        ci2 += 1
                used[i] = 0

// _der_gen2 — cleaner recursive derangement generator using index tracking.
fn _der_gen2(items, orig, cur, used, pos, out)
    let n = len(items)
    if pos == n
        push(out, _der_dup(cur))
        return
    for i in 0..n
        if used[i] == 0
            if items[i] != orig[pos]
                used[i] = 1
                cur[pos] = items[i]
                _der_gen2(items, orig, cur, used, pos + 1, out)
                used[i] = 0

// der_all — all derangements of items in lexicographic order.
fn der_all(items) -> any
    let n = len(items)
    let out = []
    if n == 0
        push(out, [])
        return out
    // Build a sorted copy to generate in lexicographic order
    let sorted = _der_dup(items)
    // Bubble sort to ensure lex order
    for si in 0..(n - 1)
        let sj = 0
        while sj < n - si - 1
            if sorted[sj] > sorted[sj + 1]
                let tmp = sorted[sj]
                sorted[sj] = sorted[sj + 1]
                sorted[sj + 1] = tmp
            sj += 1
    let used = []
    let cur = []
    for i in 0..n
        push(used, 0)
        push(cur, 0)
    _der_gen2(sorted, items, cur, used, 0, out)
    return out

// der_nth — k-th derangement (0-indexed) in lexicographic order.
fn der_nth(items, k: int) -> any
    let all = der_all(items)
    if k < 0
        return []
    if k >= len(all)
        return []
    return _der_dup(all[k])

// der_ratio_permille — integer approximation: D_n * 1000 / n!
// Converges to floor(1000/e) = 367 for large n; exact small values vary.
fn der_ratio_permille(n: int) -> int
    if n == 0
        return 1000
    let dn = der_count(n)
    let fn_ = _der_factorial(n)
    return (dn * 1000) / fn_

// der_partial — permutations of items where positions listed in fixed_allowed
// MAY keep their original value; all other positions MUST be displaced.
// fixed_allowed is a list of position indices that are allowed to be fixed.
fn der_partial(items, fixed_allowed) -> any
    let n = len(items)
    let out = []
    let sorted = _der_dup(items)
    // Bubble sort
    for si in 0..(n - 1)
        let sj = 0
        while sj < n - si - 1
            if sorted[sj] > sorted[sj + 1]
                let tmp = sorted[sj]
                sorted[sj] = sorted[sj + 1]
                sorted[sj + 1] = tmp
            sj += 1
    // Build allowed-fixed set as dict for O(1) lookup
    let fa = {}
    for fi in 0..len(fixed_allowed)
        fa[str(fixed_allowed[fi])] = 1
    // Generate all permutations and filter
    let used = []
    let cur = []
    for i in 0..n
        push(used, 0)
        push(cur, 0)
    _der_partial_gen(sorted, items, cur, used, 0, fa, out)
    return out

// _der_partial_gen — backtracking generator for partial derangements.
fn _der_partial_gen(items, orig, cur, used, pos, fa, out)
    let n = len(items)
    if pos == n
        push(out, _der_dup(cur))
        return
    for i in 0..n
        if used[i] == 0
            let ok = 1
            if items[i] == orig[pos]
                // fixed point: only allow if this position is in fixed_allowed
                if fa[str(pos)] == 0
                    ok = 0
            if ok == 1
                used[i] = 1
                cur[pos] = items[i]
                _der_partial_gen(items, orig, cur, used, pos + 1, fa, out)
                used[i] = 0

// der_count_with_fixed — number of permutations of n elements with exactly k fixed points.
// Formula: C(n,k) * D_{n-k}.
fn der_count_with_fixed(n: int, k: int) -> int
    if k < 0
        return 0
    if k > n
        return 0
    return _der_ncr(n, k) * der_count(n - k)
