// std/combinatorics/powerset.nova — power set generation in multiple orders.
// LEAF — imports NOTHING.
//
// Public API:
//   ps_all(items)                  -> list  all 2^n subsets, binary-counting order
//   ps_gray(items)                 -> list  subsets in Gray-code order (adjacent differ by 1 elem)
//   ps_by_size(items)              -> list  subsets ordered by increasing cardinality
//   ps_count(n)                    -> int   2^n
//   ps_iter_mask(items, mask)      -> list  the subset corresponding to a given bitmask
//   ps_gray_code(n)                -> list  the 2^n n-bit Gray codes as integers
//   ps_subset_sum_exists(items, t) -> bool  does any subset sum to target t? (1/0)
//   ps_size(mask)                  -> int   popcount of mask (number of set bits)

// _ps_dup — shallow copy of list xs.
fn _ps_dup(xs)
    let out = []
    let i = 0
    let n = len(xs)
    while i < n
        push(out, xs[i])
        i = i + 1
    out

// ps_count(n) -> int
// Returns 2^n, the number of subsets of an n-element set.
fn ps_count(n)
    if n <= 0
        return 1
    1 << n

// ps_size(mask) -> int
// Returns the number of set bits in mask (popcount).
fn ps_size(mask)
    let m = mask
    let cnt = 0
    while m > 0
        cnt = cnt + (m & 1)
        m = m >> 1
    cnt

// ps_iter_mask(items, mask) -> list
// Returns the subset of items selected by the bitmask mask.
// Bit j set means items[j] is included.
fn ps_iter_mask(items, mask)
    let n = len(items)
    let sub = [items[j] for j in 0..n if (mask >> j) & 1 == 1]
    sub

// ps_all(items) -> list
// Returns all 2^n subsets of items in binary-counting order (mask 0 to 2^n-1).
// Subset 0 = [], subset 1 = [items[0]], ..., subset (2^n-1) = items.
fn ps_all(items)
    let n = len(items)
    let total = ps_count(n)
    let result = []
    for mask in 0..total
        push(result, ps_iter_mask(items, mask))
    result

// ps_gray_code(n) -> list
// Returns the sequence of 2^n n-bit Gray codes as integers.
// Gray code i = i XOR (i >> 1).
// For n=2: [0,1,3,2]  (binary 00,01,11,10).
fn ps_gray_code(n)
    let total = ps_count(n)
    let out = [i ^ (i >> 1) for i in 0..total]
    out

// ps_gray(items) -> list
// Returns all 2^n subsets of items in Gray-code order.
// Each consecutive pair of subsets differs by exactly one element (add or remove).
fn ps_gray(items)
    let n = len(items)
    let codes = ps_gray_code(n)
    let total = ps_count(n)
    let result = []
    for i in 0..total
        push(result, ps_iter_mask(items, codes[i]))
    result

// _ps_by_size_helper — collect all subsets of items of exactly cardinality sz.
fn _ps_by_size_helper(result, items, n, sz)
    let total = ps_count(n)
    let mask = 0
    while mask < total
        if ps_size(mask) == sz
            push(result, ps_iter_mask(items, mask))
        mask = mask + 1

// ps_by_size(items) -> list
// Returns all 2^n subsets ordered by increasing cardinality.
// Within the same cardinality, subsets appear in binary-counting (mask) order.
fn ps_by_size(items)
    let n = len(items)
    let result = []
    let sz = 0
    while sz <= n
        _ps_by_size_helper(result, items, n, sz)
        sz = sz + 1
    result

// ps_subset_sum_exists(items, target) -> int (1=true, 0=false)
// Returns 1 if some subset of items (list of ints) sums to target.
// Uses bitmask enumeration; works correctly for small n (<=20).
fn ps_subset_sum_exists(items, target)
    let n = len(items)
    let total = ps_count(n)
    for mask in 0..total
        let s = 0
        let j = 0
        while j < n
            if (mask >> j) & 1 == 1
                s = s + items[j]
            j = j + 1
        if s == target
            return 1
    0
