// std/combinatorics/catalan_struct.nova — Catalan structures: counts, generators, validators.
// LEAF — imports NOTHING.
//
// The n-th Catalan number C(n) counts many equivalent combinatorial objects:
//   balanced parenthesizations, full binary trees, Dyck paths, triangulations, ballot seqs.
// Sequence: 1, 1, 2, 5, 14, 42, 132, ... (OEIS A000108)
//
// Public API:
//   cs_catalan(n)              -> int   C(n) via iterative recurrence
//   cs_balanced_parens(n)      -> list  all balanced paren strings of n pairs (lex order)
//   cs_dyck_paths(n)           -> list  all Dyck paths of length 2n (lists of +1/-1)
//   cs_triangulations_count(n) -> int   triangulations of (n+2)-gon = C(n)
//   cs_binary_trees_count(n)   -> int   full binary trees with n+1 leaves = C(n)
//   cs_ballot_sequences(n)     -> list  all ballot sequences of length 2n
//   cs_is_balanced(s)          -> bool  true iff paren string s is balanced
//   cs_valid_dyck(path)        -> bool  true iff list of +1/-1 is a valid Dyck path
//
// Private helpers use the _cs_ prefix.

// cs_catalan — n-th Catalan number (0-indexed) via iterative recurrence.
// C(0)=1. Recurrence: C(k) = C(k-1) * 2*(2k-1) / (k+1).
// C(1)=1, C(2)=2, C(3)=5, C(4)=14, C(5)=42.
fn cs_catalan(n: int) -> int
    if n <= 0
        return 1
    let val = 1
    let k = 1
    while k <= n
        val = val * 2 * (2 * k - 1) / (k + 1)
        k = k + 1
    val

// cs_is_balanced — true iff paren string s is balanced.
// Every prefix must have >= as many '(' as ')'; total must match.
fn cs_is_balanced(s: string) -> bool
    let depth = 0
    let i = 0
    let n = len(s)
    while i < n
        let ch = s[i]
        if ch == "("
            depth = depth + 1
        else
            depth = depth - 1
        if depth < 0
            return false
        i = i + 1
    depth == 0

// _cs_dup_str — deep-copy a list of strings.
fn _cs_dup_str(a: list) -> list
    let out = []
    for i in 0..len(a)
        push(out, a[i])
    out

// _cs_bp_gen — backtrack for balanced parenthesizations.
// open = '(' remaining, close = ')' remaining to balance; cur = partial string.
fn _cs_bp_gen(open: int, close: int, cur: string, out: list)
    if open == 0 and close == 0
        push(out, cur)
        return 0
    if open > 0
        _cs_bp_gen(open - 1, close + 1, cur + "(", out)
    if close > 0
        _cs_bp_gen(open, close - 1, cur + ")", out)
    return 0

// cs_balanced_parens — all balanced parenthesizations of n pairs, lex order.
// cs_balanced_parens(0)=[""], cs_balanced_parens(1)=["()"],
// cs_balanced_parens(2)=["(())", "()()"], len(cs_balanced_parens(3))==5.
fn cs_balanced_parens(n: int) -> list
    let out = []
    if n <= 0
        push(out, "")
        return out
    _cs_bp_gen(n, 0, "", out)
    out

// cs_valid_dyck — true iff path is a valid Dyck path (list of +1/-1).
// Requirements: length even, all partial sums >= 0, total sum == 0.
fn cs_valid_dyck(path: list) -> bool
    let n = len(path)
    if n == 0
        return true
    if n % 2 != 0
        return false
    let height = 0
    for i in 0..n
        height = height + path[i]
        if height < 0
            return false
    height == 0

// _cs_dup_int — deep-copy a list of ints.
fn _cs_dup_int(a: list) -> list
    let out = []
    for i in 0..len(a)
        push(out, a[i])
    out

// _cs_dyck_rec — recursive Dyck path builder.
// up = remaining +1 steps; down = remaining -1 steps; h = current height.
// prefix accumulates the current path (passed by value via _cs_dup_int snapshots).
// We pass prefix as an immutable snapshot each level to avoid mutation aliasing.
fn _cs_dyck_rec(up: int, down: int, h: int, prefix: list, out: list)
    if up == 0 and down == 0
        push(out, _cs_dup_int(prefix))
        return 0
    if up > 0
        let p2 = _cs_dup_int(prefix)
        push(p2, 1)
        _cs_dyck_rec(up - 1, down + 1, h + 1, p2, out)
    if down > 0 and h > 0
        let p3 = _cs_dup_int(prefix)
        push(p3, -1)
        _cs_dyck_rec(up, down - 1, h - 1, p3, out)
    return 0

// cs_dyck_paths — all Dyck paths of length 2n as lists of +1 and -1, lex order.
// Count = C(n). cs_dyck_paths(0)=[[]], cs_dyck_paths(1)=[[1,-1]],
// cs_dyck_paths(2)=[[1,1,-1,-1],[1,-1,1,-1]], len(cs_dyck_paths(3))==5.
fn cs_dyck_paths(n: int) -> list
    let out = []
    if n <= 0
        let empty = []
        push(out, empty)
        return out
    let prefix = []
    _cs_dyck_rec(n, 0, 0, prefix, out)
    out

// cs_triangulations_count — triangulations of an (n+2)-gon = C(n).
// cs_triangulations_count(0)=1, cs_triangulations_count(4)=14.
fn cs_triangulations_count(n: int) -> int
    cs_catalan(n)

// cs_binary_trees_count — full binary trees with n+1 leaves = C(n).
// cs_binary_trees_count(3)=5, cs_binary_trees_count(4)=14.
fn cs_binary_trees_count(n: int) -> int
    cs_catalan(n)

// _cs_ballot_rec — generate ballot sequences.
// Ballot sequence of length 2n: n copies of 1 (A) and n copies of 2 (B) where
// at every prefix count(1) > count(2) (A always strictly ahead).
// Bijection to Dyck paths: 1<->+1, 2<->{-1}.
// ones = remaining 1s to place, twos = remaining 2s, lead = count(1)-count(2) so far.
fn _cs_ballot_rec(ones: int, twos: int, lead: int, prefix: list, out: list)
    if ones == 0 and twos == 0
        push(out, _cs_dup_int(prefix))
        return 0
    if ones > 0
        let p2 = _cs_dup_int(prefix)
        push(p2, 1)
        _cs_ballot_rec(ones - 1, twos + 1, lead + 1, p2, out)
    if twos > 0 and lead > 0
        let p3 = _cs_dup_int(prefix)
        push(p3, 2)
        _cs_ballot_rec(ones, twos - 1, lead - 1, p3, out)
    return 0

// cs_ballot_sequences — all ballot sequences of length 2n, lex order.
// A ballot sequence has candidate 1 strictly ahead at every prefix.
// Encoded as lists of {1, 2}. Count = C(n).
// cs_ballot_sequences(0)=[[]], cs_ballot_sequences(1)=[[1,2]],
// len(cs_ballot_sequences(3))==5.
fn cs_ballot_sequences(n: int) -> list
    let out = []
    if n <= 0
        let empty = []
        push(out, empty)
        return out
    let prefix = []
    _cs_ballot_rec(n, 0, 0, prefix, out)
    out
