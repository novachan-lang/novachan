// std/combinatorics/permutations.nova — all permutations and rank/unrank operations.
// LEAF — imports NOTHING. INTEGER lists only.
//
// Public API:
//   perm_all(items)       -> list  all permutations in lexicographic order (each is a list)
//   perm_count(n)         -> int   n! (number of permutations of n items)
//   perm_factorial(n)     -> int   n! (alias; same as perm_count)
//   perm_next(perm)       -> list  next lex permutation; returns same list if already last
//   perm_prev(perm)       -> list  previous lex permutation; returns same list if already first
//   perm_nth(items, k)    -> list  k-th permutation (0-indexed, lex order) of sorted items
//   perm_rank(perm)       -> int   lex rank (0-indexed) of perm among perms of its elements
//   perm_k(items, k)      -> list  all k-permutations (arrangements) of items
//   perm_is_last(perm)    -> bool  true if perm is the last lex permutation (descending)

// _perm_dup — shallow copy of a list to avoid aliasing
fn _perm_dup(src)
    let dst = []
    let i = 0
    let n = len(src)
    while i < n
        push(dst, src[i])
        i = i + 1
    dst

// _perm_swap — swap elements at indices a and b in xs in-place
fn _perm_swap(xs, a, b)
    let tmp = xs[a]
    xs[a] = xs[b]
    xs[b] = tmp

// _perm_reverse_range — reverse xs[lo..hi] in-place (inclusive both ends)
fn _perm_reverse_range(xs, lo, hi)
    let l = lo
    let h = hi
    while l < h
        _perm_swap(xs, l, h)
        l = l + 1
        h = h - 1

// perm_factorial — n! via iterative product. perm_factorial(0) = 1.
fn perm_factorial(n: int) -> int
    let acc = 1
    let i = 2
    while i <= n
        acc = acc * i
        i = i + 1
    acc

// perm_count — n! (number of permutations of n distinct items).
fn perm_count(n: int) -> int
    perm_factorial(n)

// _perm_sort_range — insertion sort arr[lo..hi] (inclusive) in ascending order
fn _perm_sort_range(arr, lo, hi)
    let i = lo + 1
    while i <= hi
        let key = arr[i]
        let j = i - 1
        while j >= lo and arr[j] > key
            arr[j + 1] = arr[j]
            j = j - 1
        arr[j + 1] = key
        i = i + 1

// _perm_is_last_arr — check if arr is in descending order (no next perm)
fn _perm_is_last_arr(arr) -> bool
    let n = len(arr)
    if n <= 1
        return true
    let i = 0
    while i < n - 1
        if arr[i] < arr[i + 1]
            return false
        i = i + 1
    true

// _perm_next_inplace — advance arr to next lex permutation in-place.
// Returns true if advanced, false if arr was already last.
fn _perm_next_inplace(arr) -> bool
    let n = len(arr)
    if n <= 1
        return false
    let i = n - 2
    while i >= 0 and arr[i] >= arr[i + 1]
        i = i - 1
    if i < 0
        return false
    let j = n - 1
    while arr[j] <= arr[i]
        j = j - 1
    _perm_swap(arr, i, j)
    _perm_reverse_range(arr, i + 1, n - 1)
    true

// perm_all — all permutations of items in lexicographic order.
// Iterates via perm_next from the sorted starting permutation.
// Returns a list of lists. perm_all([]) returns [[]] (one empty permutation).
fn perm_all(items) -> any
    let result = []
    let n = len(items)
    if n == 0
        push(result, [])
        return result
    // Start from sorted order (lex first).
    let arr = _perm_dup(items)
    _perm_sort_range(arr, 0, n - 1)
    // Collect current then advance; stop after the last permutation.
    let going = true
    while going
        push(result, _perm_dup(arr))
        if _perm_is_last_arr(arr)
            going = false
        else
            _perm_next_inplace(arr)
    result

// perm_is_last — true if perm is in descending order (last lex permutation).
fn perm_is_last(perm) -> bool
    let n = len(perm)
    if n <= 1
        return true
    let i = 0
    while i < n - 1
        if perm[i] < perm[i + 1]
            return false
        i = i + 1
    true

// perm_next — next lexicographic permutation of perm, or same list if already last.
// Uses the classic Narayana Pandita algorithm.
fn perm_next(perm) -> any
    let arr = _perm_dup(perm)
    let n = len(arr)
    if n <= 1
        return arr
    // Step 1: find largest i such that arr[i] < arr[i+1]
    let i = n - 2
    while i >= 0 and arr[i] >= arr[i + 1]
        i = i - 1
    if i < 0
        // already last permutation — return as-is
        return arr
    // Step 2: find largest j such that arr[j] > arr[i]
    let j = n - 1
    while arr[j] <= arr[i]
        j = j - 1
    // Step 3: swap arr[i] and arr[j]
    _perm_swap(arr, i, j)
    // Step 4: reverse arr[i+1..n-1]
    _perm_reverse_range(arr, i + 1, n - 1)
    arr

// perm_prev — previous lexicographic permutation of perm, or same if already first.
// Mirror of perm_next: find the largest descending run from the right.
fn perm_prev(perm) -> any
    let arr = _perm_dup(perm)
    let n = len(arr)
    if n <= 1
        return arr
    // Step 1: find largest i such that arr[i] > arr[i+1]
    let i = n - 2
    while i >= 0 and arr[i] <= arr[i + 1]
        i = i - 1
    if i < 0
        // already first permutation — return as-is
        return arr
    // Step 2: find largest j such that arr[j] < arr[i]
    let j = n - 1
    while arr[j] >= arr[i]
        j = j - 1
    // Step 3: swap
    _perm_swap(arr, i, j)
    // Step 4: reverse arr[i+1..n-1]
    _perm_reverse_range(arr, i + 1, n - 1)
    arr

// perm_nth — the k-th permutation (0-indexed) of items in lex order.
// Uses the factorial-number-system (factoradic) algorithm — O(n^2), no enumeration.
fn perm_nth(items, k: int) -> any
    let n = len(items)
    if n == 0
        return []
    // Work with a sorted copy of the items.
    let pool = _perm_dup(items)
    _perm_sort_range(pool, 0, n - 1)
    let result = []
    let remaining = k
    let i = n - 1
    while i >= 0
        let fact = perm_factorial(i)
        let idx = remaining / fact
        remaining = remaining - idx * fact
        push(result, pool[idx])
        // remove pool[idx] by shifting left
        let j = idx
        while j < len(pool) - 1
            pool[j] = pool[j + 1]
            j = j + 1
        // shrink pool by one (rebuild without last)
        let newpool = []
        let m = 0
        while m < len(pool) - 1
            push(newpool, pool[m])
            m = m + 1
        pool = newpool
        i = i - 1
    result

// perm_rank — 0-indexed lex rank of perm among all permutations of its elements.
// Uses factoradic: for each position, count how many remaining elements are smaller.
fn perm_rank(perm) -> int
    let n = len(perm)
    if n == 0
        return 0
    // Build a sorted copy of all elements as the "available" pool.
    let pool = _perm_dup(perm)
    _perm_sort_range(pool, 0, n - 1)
    let rank = 0
    let i = 0
    while i < n
        // Find index of perm[i] in pool (first occurrence).
        let idx = 0
        let j = 0
        while j < len(pool)
            if pool[j] == perm[i]
                idx = j
                j = len(pool)
            else
                j = j + 1
        rank = rank + idx * perm_factorial(n - 1 - i)
        // Remove pool[idx].
        let newpool = []
        let m = 0
        while m < len(pool)
            if m != idx
                push(newpool, pool[m])
            m = m + 1
        pool = newpool
        i = i + 1
    rank

// _perm_k_gen — recursive backtracking for k-permutations.
// Uses a pre-allocated fixed-size slot array to avoid aliasing on push/pop.
// slot[depth] is set before recursion and irrelevant values in slot[depth..k-1]
// are overwritten; only slot[0..depth-1] are live at each level.
fn _perm_k_gen(items, k, depth, slot, used, result)
    let n = len(items)
    if depth == k
        // snapshot the first k slots as a fresh list
        let snap = []
        let m = 0
        while m < k
            push(snap, slot[m])
            m = m + 1
        push(result, snap)
        return null
    let i = 0
    while i < n
        if used[i] == 0
            slot[depth] = items[i]
            used[i] = 1
            _perm_k_gen(items, k, depth + 1, slot, used, result)
            used[i] = 0
        i = i + 1

// perm_k — all k-permutations (arrangements) of items: P(n,k) results.
// Items are taken in their given order (not sorted); result is in lex index order.
fn perm_k(items, k: int) -> any
    let result = []
    let n = len(items)
    if k < 0 or k > n
        return result
    if k == 0
        push(result, [])
        return result
    let used = []
    let i = 0
    while i < n
        push(used, 0)
        i = i + 1
    // Pre-allocate slot array of size k (values are overwritten before read)
    let slot = []
    let si = 0
    while si < k
        push(slot, 0)
        si = si + 1
    _perm_k_gen(items, k, 0, slot, used, result)
    result
