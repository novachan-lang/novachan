// NOVA Concurrent Stress Test — exercises spawn, channels, closures, and data flow
// If this runs correctly, NOVA's concurrency model is real.

// ═══════════════════════════════════════════════════════════════════
// 1. BASIC SPAWN + CHANNEL — worker sends result back
// ═══════════════════════════════════════════════════════════════════
fn compute_squares(ch, start, count)
    total = 0
    i = start
    while i < start + count
        total = total + i * i
        i = i + 1
    send(ch, total)

results = channel()
spawn compute_squares(results, 1, 50)
spawn compute_squares(results, 51, 50)
r1 = receive(results)
r2 = receive(results)
print("Sum of squares 1..100 = " + str(r1 + r2))

// ═══════════════════════════════════════════════════════════════════
// 2. FAN-OUT / FAN-IN — multiple workers, single collector
// ═══════════════════════════════════════════════════════════════════
fn is_prime(n)
    if n < 2
        return 0
    if n == 2
        return 1
    if n % 2 == 0
        return 0
    d = 3
    while d * d <= n
        if n % d == 0
            return 0
        d = d + 2
    return 1

fn count_primes_range(ch, lo, hi)
    count = 0
    i = lo
    while i <= hi
        count = count + is_prime(i)
        i = i + 1
    send(ch, count)

prime_ch = channel()
spawn count_primes_range(prime_ch, 2, 2500)
spawn count_primes_range(prime_ch, 2501, 5000)
spawn count_primes_range(prime_ch, 5001, 7500)
spawn count_primes_range(prime_ch, 7501, 10000)
p1 = receive(prime_ch)
p2 = receive(prime_ch)
p3 = receive(prime_ch)
p4 = receive(prime_ch)
print("Primes up to 10000 = " + str(p1 + p2 + p3 + p4))

// ═══════════════════════════════════════════════════════════════════
// 3. PIPELINE — chain of spawn stages connected by channels
// ═══════════════════════════════════════════════════════════════════
fn generate(out, n)
    i = 2
    while i <= n
        send(out, i)
        i = i + 1
    send(out, -1)

fn filter_stage(in_ch, out, prime)
    while 1
        val = receive(in_ch)
        if val == -1
            send(out, -1)
            return 0
        if val % prime != 0
            send(out, val)

fn collect_primes(in_ch, result_ch, limit)
    count = 0
    while 1
        val = receive(in_ch)
        if val == -1
            send(result_ch, count)
            return 0
        count = count + 1
        if count >= limit
            send(result_ch, count)
            return 0

// Small pipeline sieve for first 15 primes
gen_out = channel()
spawn generate(gen_out, 50)

// Manually filter through first few primes
f2_out = channel()
spawn filter_stage(gen_out, f2_out, 2)
f3_out = channel()
spawn filter_stage(f2_out, f3_out, 3)
f5_out = channel()
spawn filter_stage(f3_out, f5_out, 5)
f7_out = channel()
spawn filter_stage(f5_out, f7_out, 7)

sieve_result = channel()
spawn collect_primes(f7_out, sieve_result, 100)
sieve_count = receive(sieve_result)
// After filtering 2,3,5,7: remaining primes from 2..50 minus composites
print("Primes remaining after sieve(2,3,5,7) from 2..50 = " + str(sieve_count))

// ═══════════════════════════════════════════════════════════════════
// 4. CHANNEL CLOSE — producer signals done via close
// ═══════════════════════════════════════════════════════════════════
fn producer(ch, n)
    i = 1
    while i <= n
        send(ch, i * 10)
        i = i + 1
    close(ch)

prod_ch = channel()
spawn producer(prod_ch, 5)
sum = 0
sum = sum + receive(prod_ch)
sum = sum + receive(prod_ch)
sum = sum + receive(prod_ch)
sum = sum + receive(prod_ch)
sum = sum + receive(prod_ch)
print("Producer sum = " + str(sum))

// ═══════════════════════════════════════════════════════════════════
// 5. CAPTURED CLOSURES IN SPAWN — verify capture semantics
// ═══════════════════════════════════════════════════════════════════
fn make_worker(multiplier)
    return fn(ch, value) send(ch, value * multiplier)

doubler = make_worker(2)
tripler = make_worker(3)
cap_ch = channel()
spawn doubler(cap_ch, 21)
spawn tripler(cap_ch, 14)
c1 = receive(cap_ch)
c2 = receive(cap_ch)
print("Closure captures: " + str(c1) + " and " + str(c2))

print("")
print("All concurrent tests passed!")
