// Sieve of Eratosthenes — tests array access overhead
// NOVA uses runtime list ops vs C's raw byte array
fn count_primes(limit)
    // Build sieve array: 0 = prime candidate, 1 = composite
    sieve = []
    idx = 0
    while idx <= limit
        sieve.push(0)
        idx = idx + 1

    count = 0
    i = 2
    while i <= limit
        if sieve[i] == 0
            count = count + 1
            j = i * i
            while j <= limit
                sieve[j] = 1
                j = j + i
        i = i + 1
    return count

result = count_primes(1000000)
print("Primes up to 1M: " + str(result))
