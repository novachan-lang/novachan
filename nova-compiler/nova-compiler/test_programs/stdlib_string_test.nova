// Test the standard library string module
import string

msg = "Hello, World!"

// Length
print(string.length(msg))

// Case conversion
print(string.upper(msg))
print(string.lower(msg))

// Trim
padded = "  hello  "
print(string.trim(padded))

// Contains
print(string.contains(msg, "World"))

// Starts/ends with
print(string.starts_with(msg, "Hello"))
print(string.ends_with(msg, "World!"))

// Find
print(string.find(msg, "World"))

// Replace
print(string.replace(msg, "World", "NOVA"))

// Repeat
print(string.repeat("ab", 3))

// Reverse
print(string.reverse("hello"))

// Is empty
print(string.is_empty(""))
print(string.is_empty("x"))

// Pad
print(string.pad_left("42", 6, "0"))
print(string.pad_right("hi", 6, "."))
