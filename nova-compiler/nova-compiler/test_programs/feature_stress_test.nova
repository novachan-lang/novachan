// NOVA Feature Stress Test — exercises every major language feature
// If this compiles and runs correctly, NOVA is a real language.

// ═══════════════════════════════════════════════════════════════════
// 1. STRING INTERPOLATION
// ═══════════════════════════════════════════════════════════════════
name = "NOVA"
version = 1
print("Welcome to {name} version {version}!")
print("2 + 2 = {2 + 2}")

// ═══════════════════════════════════════════════════════════════════
// 2. FOR-IN LOOPS (over ranges and lists)
// ═══════════════════════════════════════════════════════════════════
total = 0
for i in 1..10
    total = total + i
print("Sum 1..10 = " + str(total))

fruits = ["apple", "banana", "cherry"]
for f in fruits
    print("Fruit: " + f)

// ═══════════════════════════════════════════════════════════════════
// 3. CLOSURES (capturing outer variables)
// ═══════════════════════════════════════════════════════════════════
fn make_adder(n)
    return fn(x) n + x

add5 = make_adder(5)
print("add5(10) = " + str(add5(10)))

// List.map with lambda
nums = [1, 2, 3, 4, 5]
doubled = nums.map(fn(x) x * 2)
print(doubled)

// List.filter with lambda
evens = nums.filter(fn(x) x % 2 == 0)
print(evens)

// ═══════════════════════════════════════════════════════════════════
// 4. DICT OPERATIONS
// ═══════════════════════════════════════════════════════════════════
scores = {"alice": 95, "bob": 87, "charlie": 92}
print("Alice: " + str(scores["alice"]))
scores["diana"] = 98
print("Diana added: " + str(scores["diana"]))
print("Has bob? " + str(scores.has("bob")))
print("Dict size: " + str(len(scores)))

// ═══════════════════════════════════════════════════════════════════
// 5. MATCH EXPRESSIONS
// ═══════════════════════════════════════════════════════════════════
fn describe(n)
    return match n
        0 => "zero"
        1 => "one"
        _ => "many"

print("describe(0) = " + describe(0))
print("describe(1) = " + describe(1))
print("describe(42) = " + describe(42))

// ═══════════════════════════════════════════════════════════════════
// 6. PIPE OPERATOR
// ═══════════════════════════════════════════════════════════════════
fn double(x)
    return x * 2

fn add_one(x)
    return x + 1

result = 5 |> double |> add_one
print("5 |> double |> add_one = " + str(result))

// ═══════════════════════════════════════════════════════════════════
// 7. NESTED FUNCTIONS AND RECURSION
// ═══════════════════════════════════════════════════════════════════
fn power(base, exp)
    if exp == 0
        return 1
    return base * power(base, exp - 1)

print("2^10 = " + str(power(2, 10)))

// ═══════════════════════════════════════════════════════════════════
// 8. STRING METHODS
// ═══════════════════════════════════════════════════════════════════
greeting = "  Hello, NOVA!  "
print("trimmed: '" + greeting.trim() + "'")
print("upper: " + "hello".upper())
print("contains nova: " + str("Hello NOVA".contains("NOVA")))
print("length: " + str(len("NOVA")))

// ═══════════════════════════════════════════════════════════════════
// 9. COMPLEX EXPRESSIONS
// ═══════════════════════════════════════════════════════════════════
fn fizzbuzz(n)
    if n % 15 == 0
        return "FizzBuzz"
    if n % 3 == 0
        return "Fizz"
    if n % 5 == 0
        return "Buzz"
    return str(n)

i = 1
while i <= 20
    print(fizzbuzz(i))
    i = i + 1

print("")
print("All features passed!")
