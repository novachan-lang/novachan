// NOVA Memory Management Stress Test
// Verifies that allocation tracking + cleanup doesn't corrupt or crash
// under heavy allocation pressure.

// ═══════════════════════════════════════════════════════════════════
// 1. HEAVY STRING ALLOCATION — 1000 concatenations in a loop
// ═══════════════════════════════════════════════════════════════════

result = ""
i = 0
while i < 100
    result = result + str(i) + " "
    i = i + 1
print("String concat length: " + str(len(result)))

// ═══════════════════════════════════════════════════════════════════
// 2. MANY LISTS — create and populate 100 lists
// ═══════════════════════════════════════════════════════════════════

lists = []
j = 0
while j < 100
    inner = []
    k = 0
    while k < 10
        inner.push(j * 10 + k)
        k = k + 1
    lists.push(inner)
    j = j + 1
print("Created " + str(len(lists)) + " lists")
print("lists[50][5] = " + str(lists[50][5]))

// ═══════════════════════════════════════════════════════════════════
// 3. MANY DICTS — create 50 dicts with string keys
// ═══════════════════════════════════════════════════════════════════

fn make_config(id)
    return {id: id, name: "item_" + str(id), value: id * 100}

configs = []
m = 0
while m < 50
    configs.push(make_config(m))
    m = m + 1
print("Created " + str(len(configs)) + " configs")
c = configs[25]
print("Config 25 name: " + c.name)
print("Config 25 value: " + str(c.value))

// ═══════════════════════════════════════════════════════════════════
// 4. RECURSIVE ALLOCATION — quicksort creates temp lists per call
// ═══════════════════════════════════════════════════════════════════

fn qsort(arr)
    if len(arr) <= 1
        return arr
    pivot = arr[0]
    less = []
    equal = []
    greater = []
    i = 0
    while i < len(arr)
        v = arr[i]
        if v < pivot
            less.push(v)
        else if v == pivot
            equal.push(v)
        else
            greater.push(v)
        i = i + 1
    return qsort(less).concat(equal).concat(qsort(greater))

big = []
n = 0
while n < 200
    big.push(200 - n)
    n = n + 1
sorted = qsort(big)
print("Sorted 200 elements, first: " + str(sorted[0]) + ", last: " + str(sorted[199]))

// ═══════════════════════════════════════════════════════════════════
// 5. MAP/FILTER CHAINS — each creates new lists
// ═══════════════════════════════════════════════════════════════════

nums = []
p = 1
while p <= 50
    nums.push(p)
    p = p + 1

squared = nums.map(fn(x) x * x)
evens = squared.filter(fn(x) x % 2 == 0)
print("50 numbers squared and filtered to evens: " + str(len(evens)))

// ═══════════════════════════════════════════════════════════════════
// 6. CLOSURE ALLOCATION — many closures with captured values
// ═══════════════════════════════════════════════════════════════════

fn make_adder(n)
    return fn(x) x + n

adders = []
q = 0
while q < 50
    adders.push(make_adder(q))
    q = q + 1

total = 0
r = 0
while r < 50
    f = adders[r]
    total = total + f(100)
    r = r + 1
print("Sum of 50 adders(100): " + str(total))

print("")
print("=== MEMORY STRESS TEST PASSED ===")
