// NOVA Demo: A real program using multiple stdlib modules
// This demonstrates NOVA as a practical, usable language.

import math
import string
import io

// ── Compute statistics on a list of numbers ────────────────────────────

scores = [85, 92, 78, 95, 88, 73, 91, 87, 96, 82]

// Sum using math.sum_range-like manual computation
total = 0
i = 0
while i < len(scores)
    total = total + scores[i]
    i = i + 1

count = len(scores)
average = total / count

print("Student Score Report")
print("====================")
print(total)
print(count)
print(average)

// Find highest and lowest scores
highest = scores[0]
lowest = scores[0]
i = 0
while i < len(scores)
    s = scores[i]
    if s > highest
        highest = s
    if s < lowest
        lowest = s
    i = i + 1

print(highest)
print(lowest)

// Count passing scores (>= 80)
passing = 0
i = 0
while i < len(scores)
    if scores[i] >= 80
        passing = passing + 1
    i = i + 1

print(passing)

// ── Math computations ─────────────────────────────────────────────────

print("Math Results")
print("============")

// Fibonacci sequence
fib20 = math.fib(20)
print(fib20)

// Factorial
fact12 = math.factorial(12)
print(fact12)

// GCD and LCM
g = math.gcd(144, 60)
l = math.lcm(144, 60)
print(g)
print(l)

// Pi approximation check
pi = math.pi()
print(pi)

// ── String processing ─────────────────────────────────────────────────

print("String Results")
print("==============")

title = "  NOVA Programming Language  "
cleaned = string.trim(title)
print(cleaned)
print(string.length(cleaned))

// Build a formatted header
header = string.repeat("=", 30)
print(header)
print(cleaned)
print(header)

// String operations
lang = "NOVA is fast, safe, and simple"
print(string.upper(lang))
print(string.contains(lang, "fast"))
print(string.replace(lang, "simple", "powerful"))

// ── File I/O ──────────────────────────────────────────────────────────

print("IO Results")
print("==========")

// Write a report to file
report = "NOVA Demo Report\nScores analyzed: 10\nHighest: 96\nLowest: 73\nPassing: 8"
io.spit("demo_report.txt", report)

// Read it back
content = io.slurp("demo_report.txt")
print(content)
print("Report saved and verified!")
