// Test the standard library math module
import math

// Test constants
p = math.pi()
print(p)

// Test pure NOVA math functions
c = math.clamp(15, 0, 10)
print(c)

g = math.gcd(48, 18)
print(g)

l = math.lcm(4, 6)
print(l)

f = math.factorial(10)
print(f)

fib10 = math.fib(10)
print(fib10)

s = math.sum_range(1, 100)
print(s)

ev = math.is_even(42)
print(ev)

od = math.is_odd(7)
print(od)
