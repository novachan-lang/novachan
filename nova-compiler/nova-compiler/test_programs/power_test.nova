// NOVA Power Operator Test — integer and expression forms

// Basic integer exponentiation
print("2 ** 10 = " + str(2 ** 10))
print("3 ** 5  = " + str(3 ** 5))
print("10 ** 0 = " + str(10 ** 0))
print("7 ** 1  = " + str(7 ** 1))

// Variable exponentiation
base = 2
exp = 20
result = base ** exp
print("2 ** 20 = " + str(result))

// In expressions
fn fast_pow(b, e)
    return b ** e

print("fast_pow(5, 3) = " + str(fast_pow(5, 3)))
print("fast_pow(2, 16) = " + str(fast_pow(2, 16)))

// Pow in conditions
if 2 ** 8 == 256
    print("2^8 = 256: correct")
