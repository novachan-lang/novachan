// NOVA Self-Hosting Capability Test
// Tests every feature needed to write a compiler in NOVA

// ═══════════════════════════════════════════════════════════════════
// 1. ENUM + MATCH — Token types and AST nodes need tagged unions
// ═══════════════════════════════════════════════════════════════════

enum TokenKind
    Number(value: int)
    Word(text: string)
    Symbol(ch: string)

fn describe_token(tok)
    match tok
        Number(n) => "NUM:" + str(n)
        Word(t)   => "WORD:" + t
        Symbol(c) => "SYM:" + c
        _         => "UNKNOWN"

n = Number{value: 42}
w = Word{text: "hello"}
s = Symbol{ch: "+"}
print(describe_token(n))
print(describe_token(w))
print(describe_token(s))

// ═══════════════════════════════════════════════════════════════════
// 2. FOR-OVER-LIST — iterating token lists, AST children
// ═══════════════════════════════════════════════════════════════════

tokens = [Number{value: 1}, Word{text: "plus"}, Number{value: 2}]
descriptions = []
for tok in tokens
    descriptions.push(describe_token(tok))
print("Tokens: " + str(len(descriptions)))

// ═══════════════════════════════════════════════════════════════════
// 3. STRING INDEXING — character-by-character lexer scanning
// ═══════════════════════════════════════════════════════════════════

source = "x + 42"
chars_list = chars(source)
print("Source length: " + str(len(chars_list)))
print("First char: " + chars_list[0])
print("Third char: " + chars_list[2])
print("Last char: " + chars_list[5])

// ═══════════════════════════════════════════════════════════════════
// 4. STRING COMPARISON — keyword detection, operator matching
// ═══════════════════════════════════════════════════════════════════

fn is_keyword(word)
    if word == "fn"
        return true
    else if word == "if"
        return true
    else if word == "while"
        return true
    else if word == "return"
        return true
    return false

print("fn is keyword: " + str(is_keyword("fn")))
print("hello is keyword: " + str(is_keyword("hello")))

// ═══════════════════════════════════════════════════════════════════
// 5. RECURSIVE TREE WALKING — AST evaluation / tree traversal
// ═══════════════════════════════════════════════════════════════════

enum Expr
    Num(val: int)
    Add(left: int, right: int)
    Mul(left: int, right: int)

fn eval(expr)
    match expr
        Num(v)    => v
        Add(a, b) => a + b
        Mul(a, b) => a * b
        _         => 0

e1 = Num{val: 5}
e2 = Add{left: 3, right: 4}
e3 = Mul{left: 6, right: 7}
print("Num(5) = " + str(eval(e1)))
print("Add(3,4) = " + str(eval(e2)))
print("Mul(6,7) = " + str(eval(e3)))

// ═══════════════════════════════════════════════════════════════════
// 6. SYMBOL TABLE — dict as scope/environment
// ═══════════════════════════════════════════════════════════════════

scope = {"__parent": "none"}
scope["x"] = "42"
scope["y"] = "10"
print("x = " + scope["x"])
print("y = " + scope["y"])

// ═══════════════════════════════════════════════════════════════════
// 7. MATCH ON LITERALS — switch on characters/strings
// ═══════════════════════════════════════════════════════════════════

fn classify_char(ch)
    match ch
        "+" => "operator"
        "-" => "operator"
        "*" => "operator"
        " " => "space"
        _   => "other"

print("+ is: " + classify_char("+"))
print("  is: " + classify_char(" "))
print("a is: " + classify_char("a"))

// ═══════════════════════════════════════════════════════════════════
// 8. STRING SPLIT + PROCESSING — parsing structured text
// ═══════════════════════════════════════════════════════════════════

line = "fn add x y"
parts = split(line, " ")
print("Parts count: " + str(len(parts)))
print("First part: " + parts[0])
print("Last part: " + parts[3])

// ═══════════════════════════════════════════════════════════════════
// 9. ORD/CHR — character-to-int conversion for lexer scanning
// ═══════════════════════════════════════════════════════════════════

print("ord('A') = " + str(ord("A")))
print("ord('0') = " + str(ord("0")))
print("chr(65) = " + chr(65))
print("chr(48) = " + chr(48))

// ═══════════════════════════════════════════════════════════════════
// 10. SHORT-CIRCUIT AND/OR — guards with side-effect-free right side
// ═══════════════════════════════════════════════════════════════════

items = [1, 2, 3]
i = 0
count = 0
while i < len(items) and items[i] < 10
    count = count + 1
    i = i + 1
print("Short-circuit and: " + str(count))

x = false or true
print("false or true: " + str(x))
y = true and false
print("true and false: " + str(y))

print("")
print("=== SELF-HOST CAPABILITY TEST PASSED ===")
