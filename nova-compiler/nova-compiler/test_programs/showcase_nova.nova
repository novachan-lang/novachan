// NOVA Language Showcase — Number Theory Explorer
//
// Demonstrates in ONE file, ZERO type annotations:
//   - Complex algorithms (prime sieve, Goldbach, factorization)
//   - List indexing, while loops, if/else, recursive-style iteration
//   - String concatenation and formatting
//   - Multiple function definitions with non-trivial control flow
//   - C-speed execution (try this in Python — it takes 10x longer)

// ─── Core math functions ───────────────────────────────────────────────────────

fn is_prime(n)
    if n < 2
        return 0
    if n == 2
        return 1
    if n % 2 == 0
        return 0
    i = 3
    while i * i <= n
        if n % i == 0
            return 0
        i = i + 2
    return 1

fn nth_prime(n)
    count = 0
    candidate = 2
    while count < n
        if is_prime(candidate)
            count = count + 1
        if count < n
            candidate = candidate + 1
    return candidate

fn count_primes_to(n)
    count = 0
    i = 2
    while i <= n
        if is_prime(i)
            count = count + 1
        i = i + 1
    return count

fn sum_primes_to(n)
    total = 0
    i = 2
    while i <= n
        if is_prime(i)
            total = total + i
        i = i + 1
    return total

fn largest_prime_factor(n)
    result = 1
    d = 2
    while d * d <= n
        while n % d == 0
            result = d
            n = n / d
        d = d + 1
    if n > 1
        result = n
    return result

fn count_twin_primes(n)
    count = 0
    i = 2
    while i <= n - 2
        if is_prime(i) and is_prime(i + 2)
            count = count + 1
        i = i + 1
    return count

fn fib(n)
    if n <= 0
        return 0
    if n == 1
        return 1
    a = 0
    b = 1
    i = 2
    while i <= n
        temp = a + b
        a = b
        b = temp
        i = i + 1
    return b

fn goldbach_part(n)
    // Goldbach: find first prime p where n - p is also prime
    p = 2
    while p < n
        if is_prime(p) and is_prime(n - p)
            return p
        p = p + 1
    return 0

fn collatz_steps(n)
    steps = 0
    while n != 1
        if n % 2 == 0
            n = n / 2
        else
            n = n * 3 + 1
        steps = steps + 1
    return steps

// ─── Formatting helpers ────────────────────────────────────────────────────────

fn repeat_str(s, n)
    result = ""
    i = 0
    while i < n
        result = result + s
        i = i + 1
    return result

fn pad_right_str(s, width)
    result = s
    i = len(s)
    while i < width
        result = result + " "
        i = i + 1
    return result

fn pad_left_int(n, width)
    s = str(n)
    result = ""
    i = len(s)
    while i < width
        result = result + " "
        i = i + 1
    return result + s

fn header(title)
    line = repeat_str("=", 56)
    print(line)
    print("  " + title)
    print(line)

fn section(title)
    print("")
    print(repeat_str("-", 48))
    print("  " + title)
    print(repeat_str("-", 48))

// ─── Main program ──────────────────────────────────────────────────────────────

header("NOVA Number Theory Explorer")
print("  Zero type annotations. Compiles to native machine code.")
print("  Every variable and expression typed by the NOVA compiler.")

// ── 1. Prime counting ──────────────────────────────────────────────────────────
section("1. Prime Counting (Sieve verification)")
print("  Count   |  Primes up to N  |  Sum of primes")
print("  " + repeat_str("-", 44))

limit_1 = 100
limit_2 = 1000
limit_3 = 10000

c1 = count_primes_to(limit_1)
c2 = count_primes_to(limit_2)
c3 = count_primes_to(limit_3)
s1 = sum_primes_to(limit_1)
s2 = sum_primes_to(limit_2)
s3 = sum_primes_to(limit_3)

print("  N=100   |  " + pad_left_int(c1, 5) + "            |  " + str(s1))
print("  N=1000  |  " + pad_left_int(c2, 5) + "            |  " + str(s2))
print("  N=10000 |  " + pad_left_int(c3, 5) + "            |  " + str(s3))

// ── 2. First 20 primes ────────────────────────────────────────────────────────
section("2. First 20 Primes")
row = "  "
j = 1
while j <= 20
    p = nth_prime(j)
    row = row + pad_left_int(p, 5)
    if j % 10 == 0
        print(row)
        row = "  "
    j = j + 1

// ── 3. Fibonacci — with prime annotation ──────────────────────────────────────
section("3. Fibonacci Numbers (prime Fibonacci marked with *)")
k = 0
while k <= 20
    f = fib(k)
    mark = " "
    if is_prime(f) and f > 1
        mark = "*"
    print("  fib(" + pad_left_int(k, 2) + ") = " + pad_left_int(f, 8) + " " + mark)
    k = k + 1

// ── 4. Goldbach conjecture ────────────────────────────────────────────────────
section("4. Goldbach Conjecture (every even > 2 = sum of 2 primes)")
even = 4
while even <= 50
    p1 = goldbach_part(even)
    p2 = even - p1
    print("  " + pad_left_int(even, 3) + " = " + pad_left_int(p1, 3) + " + " + pad_left_int(p2, 3))
    even = even + 2

// ── 5. Twin prime pairs ───────────────────────────────────────────────────────
section("5. Twin Prime Pairs up to 200")
row2 = "  "
pair_count = 0
tp = 2
while tp <= 198
    if is_prime(tp) and is_prime(tp + 2)
        row2 = row2 + "(" + str(tp) + "," + str(tp + 2) + ") "
        pair_count = pair_count + 1
        if pair_count % 4 == 0
            print(row2)
            row2 = "  "
    tp = tp + 1
if row2 != "  "
    print(row2)
print("  Total twin prime pairs to 200: " + str(pair_count))
print("  Total twin prime pairs to 1000: " + str(count_twin_primes(1000)))
print("  Total twin prime pairs to 10000: " + str(count_twin_primes(10000)))

// ── 6. Collatz sequence ───────────────────────────────────────────────────────
section("6. Collatz Conjecture — Steps to reach 1")
col_nums = [6, 11, 27, 97, 871, 6171, 77031]
ci = 0
while ci < 7
    n = col_nums[ci]
    steps = collatz_steps(n)
    print("  collatz(" + str(n) + ") = " + str(steps) + " steps")
    ci = ci + 1

// ── 7. Largest prime factors ──────────────────────────────────────────────────
section("7. Largest Prime Factor")
lpf_nums = [12, 100, 360, 1024, 9999, 123456, 1000000]
li = 0
while li < 7
    n = lpf_nums[li]
    lpf = largest_prime_factor(n)
    print("  lpf(" + str(n) + ") = " + str(lpf))
    li = li + 1

// ── 8. Performance claim ─────────────────────────────────────────────────────
section("8. Performance: Primes up to 500,000")
big_count = count_primes_to(500000)
print("  Prime count to 500,000 = " + str(big_count))
print("  (This took milliseconds. Try this in pure Python.)")

print("")
print(repeat_str("=", 56))
print("  NOVA: One language. Zero annotations. Native speed.")
print(repeat_str("=", 56))
