// Worker module — exports concurrent computation functions

fn compute_sum(ch, start, end)
    total = 0
    i = start
    while i <= end
        total = total + i
        i = i + 1
    send(ch, total)

fn parallel_sum(n)
    ch = channel()
    mid = n / 2
    spawn fn()
        compute_sum(ch, 1, mid)
    spawn fn()
        compute_sum(ch, mid + 1, n)
    a = receive(ch)
    b = receive(ch)
    return a + b
