// Test the standard library io module
import io

// Write a file
io.spit("test_io_output.txt", "Hello from NOVA stdlib!")

// Read it back
content = io.slurp("test_io_output.txt")
print(content)

// Check file existence
print(io.file_exists("test_io_output.txt"))
print(io.file_exists("nonexistent_file_xyz.txt"))
