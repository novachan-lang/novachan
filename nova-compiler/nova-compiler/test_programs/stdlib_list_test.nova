// Test the standard library list module
import list

nums = [5, 3, 8, 1, 9, 2, 7, 4, 6]

// Length
print(list.length(nums))

// Sum and product
print(list.sum(nums))
print(list.product([1, 2, 3, 4, 5]))

// Min and max
print(list.min_val(nums))
print(list.max_val(nums))

// Contains and index_of
print(list.contains(nums, 8))
print(list.contains(nums, 99))
print(list.index_of(nums, 7))

// Range
r = list.range(1, 6)
print(r)

// Take and drop
print(list.take(nums, 3))
print(list.drop(nums, 6))
