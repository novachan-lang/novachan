// NOVA Mini Lexer — proves NOVA can write its own lexer
// This is the first step toward self-hosting

enum TokenKind
    Number(value: int)
    Word(text: string)
    Symbol(ch: string)

fn describe_token(tok)
    match tok
        Number(n) => "NUM:" + str(n)
        Word(t)   => "WORD:" + t
        Symbol(c) => "SYM:" + c
        _         => "UNKNOWN"

fn is_digit(ch)
    c = ord(ch)
    return c >= 48 and c <= 57

fn is_alpha(ch)
    c = ord(ch)
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_alnum(ch)
    return is_digit(ch) or is_alpha(ch)

fn lex(input)
    result = []
    chs = chars(input)
    i = 0
    while i < len(chs)
        ch = chs[i]
        if ch == " "
            i = i + 1
            continue
        if is_digit(ch)
            num = ""
            while i < len(chs) and is_digit(chs[i])
                num = num + chs[i]
                i = i + 1
            result.push(Number{value: int(num)})
        else if is_alpha(ch)
            word = ""
            while i < len(chs) and is_alnum(chs[i])
                word = word + chs[i]
                i = i + 1
            result.push(Word{text: word})
        else
            result.push(Symbol{ch: ch})
            i = i + 1
    return result

// Test 1: simple expression
lexed = lex("fn add 42 + x_1")
print("Lexed " + str(len(lexed)) + " tokens:")
for tok in lexed
    print("  " + describe_token(tok))

// Test 2: all digits
lexed2 = lex("123 456 789")
print("Numbers: " + str(len(lexed2)))

// Test 3: symbols
lexed3 = lex("a + b * c")
print("Expr: " + str(len(lexed3)))

// Test 4: keyword detection
fn is_keyword(word)
    if word == "fn"
        return true
    else if word == "if"
        return true
    else if word == "while"
        return true
    else if word == "return"
        return true
    return false

source = "fn main if x return y"
tokens = lex(source)
keywords = 0
for tok in tokens
    d = describe_token(tok)
    if starts_with(d, "WORD:")
        word = slice(d, 5, len(d))
        if is_keyword(word)
            keywords = keywords + 1
print("Keywords found: " + str(keywords))

print("")
print("=== MINI LEXER PASSED ===")
