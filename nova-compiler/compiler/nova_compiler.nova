                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
                        else if tk == "any"
                            ire_indent(e, dest + " = call i64 @nova_rt_lt(i64 " + args[0] + ", i64 " + args[1] + ")")
                        else
                            let tmp = dest + ".cmp"
                            ire_indent(e, tmp + " = icmp slt i64 " + args[0] + ", " + args[1])
                            ire_indent(e, dest + " = zext i1 " + tmp + " to i64")
            else if op == "le"
                match typ
                    IrType(tk, tn, tp, tid) =>
                        if tk == "float"
                            let af = dest + ".af"
                            let bf = dest + ".bf"
                            let tmp = dest + ".cmp"
                            if contains(value, "L")
