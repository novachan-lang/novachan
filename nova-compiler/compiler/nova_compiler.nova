                    ire_indent(e, _cfd + " = bitcast i64 " + _cfraw + " to double")
                    let _cfr = ire_emit_f32_round(e, dest, _cfd, "f32")
                    ire_indent(e, dest + " = bitcast double " + _cfr + " to i64")
