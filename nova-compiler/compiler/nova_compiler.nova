    else if name == "ptr_read_f32"
        "nova_rt_ptr_read_f32"
    else if name == "ptr_read_f64"
        "nova_rt_ptr_read_f64"
    else if name == "ptr_write_u8"
        "nova_rt_ptr_write_u8"
    else if name == "ptr_write_u16"
        "nova_rt_ptr_write_u16"
    else if name == "ptr_write_u32"
        "nova_rt_ptr_write_u32"
    else if name == "ptr_write_u64"
        "nova_rt_ptr_write_u64"
    else if name == "ptr_write_f32"
        "nova_rt_ptr_write_f32"
    else if name == "ptr_write_f64"
        "nova_rt_ptr_write_f64"
    else if name == "offheap_get_f64"
        "nova_rt_offheap_get_f64"
    else if name == "offheap_set_f64"
        "nova_rt_offheap_set_f64"
    else if name == "splitlines"
        "nova_rt_splitlines"
    else if name == "partition"
        "nova_rt_partition"
    else if name == "rpartition"
        "nova_rt_rpartition"
    else if name == "rsplit"
        "nova_rt_rsplit"
    else if name == "len"
        "nova_rt_len_any"
    else if name == "keys"
        "nova_rt_dict_keys"
    else if name == "values"
        "nova_rt_dict_values"
    else if name == "items"
        "nova_rt_dict_items"
    else if name == "has"
        "nova_rt_dict_has"
    else if name == "del"
        "nova_rt_dict_del"
    else if name == "reverse"
        "nova_rt_list_reverse"
    else if name == "sort"
        "nova_rt_list_sort"
    else if name == "map"
        "nova_rt_list_map"
    else if name == "filter"
        "nova_rt_list_filter"
    else if name == "concat"
        "nova_rt_list_concat"
    else if name == "print"
        "nova_rt_print_any"
    else if name == "str"
        "nova_rt_int_to_str"
    else
        "nova_rt_" + name

fn get_field_index(cg: CodeGen, field_name: string) -> int
    if contains(cg.field_map, field_name)
        return cg.field_map[field_name]
    return 0

// ── LLVM Module Emission ─────────────────────────────────────────────────────

fn emit_module_header(cg: CodeGen)
    emit(cg, "; NOVA Self-Hosted Compiler Output")
    emit(cg, "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"")
    emit(cg, "")
    emit(cg, "declare void @nova_rt_raise_error() nounwind")
    emit(cg, "declare i64 @nova_rt_wrap_error_context(i64, i64, i64) nounwind")
    emit(cg, "declare void @nova_rt_set_error_flag(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_take_error_flag() nounwind")
    emit(cg, "declare i64 @nova_rt_take_error_msg() nounwind")
    emit(cg, "")

