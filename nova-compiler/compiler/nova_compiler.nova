fn get_field_index(cg: CodeGen, field_name: string) -> int
    if contains(cg.field_map, field_name)
        return cg.field_map[field_name]
    return 0

// ── LLVM Module Emission ─────────────────────────────────────────────────────

fn emit_module_header(cg: CodeGen)
    emit(cg, "; NOVA Self-Hosted Compiler Output")
    emit(cg, "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"")
    emit(cg, "")
    emit(cg, "declare void @nova_rt_raise_error() nounwind")
    emit(cg, "declare i64 @nova_rt_wrap_error_context(i64, i64, i64) nounwind")
    emit(cg, "declare void @nova_rt_set_error_flag(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_take_error_flag() nounwind")
    emit(cg, "declare i64 @nova_rt_take_error_msg() nounwind")
    emit(cg, "")

fn emit_runtime_declarations(cg: CodeGen)
    emit(cg, "; Runtime declarations")
    emit(cg, "declare i32 @puts(ptr) nounwind")
    emit(cg, "declare i32 @printf(ptr, ...) nounwind")
    emit(cg, "declare i64 @nova_rt_list_create() nounwind")
    emit(cg, "declare i64 @nova_rt_deep_copy(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_list_append(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_list_append_no_rc(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_dict_set_no_rc(i64, i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_list_append_fbox(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_list_append_fraw(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_list_get_f(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_list_append_bbox(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_box_bool(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_unbox(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_unbox_elem(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_lt(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_le(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_gt(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_ge(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_list_get(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_list_len(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_dict_create() nounwind")
    emit(cg, "declare i64 @nova_rt_dict_set(i64, i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_dict_set_fbox(i64, i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_dict_set_bbox(i64, i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_box_float(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_dict_get(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_str_concat(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_int_to_str(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_bool_to_str(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_parse_int(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_len(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_len_any(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_ord(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_chr(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_contains(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_index_get(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_index_set(i64, i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_add(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_div(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_mod(i64, i64) nounwind")
    emit(cg, "declare i64 @nova_rt_neg(i64) nounwind")
    emit(cg, "declare i64 @nova_rt_truthy(i64) nounwind readonly")
    emit(cg, "declare i64 @nova_rt_eq(i64, i64) nounwind")
