// ── Edit distance for 'did you mean?' ────────────────────────────────────────

fn edit_distance(a: string, b: string) -> int
    let la = len(a)
    let lb = len(b)
    if la == 0
        return lb
    if lb == 0
        return la
    let prev = []
    let j = 0
    while j <= lb
        push(prev, j)
        j = j + 1
    let i = 1
    while i <= la
        let curr = [i]
        let j2 = 1
        while j2 <= lb
            let cost = 1
            if a[i - 1] == b[j2 - 1]
                cost = 0
            let del_cost = prev[j2] + 1
            let ins_cost = curr[j2 - 1] + 1
            let sub_cost = prev[j2 - 1] + cost
            let best = del_cost
            if ins_cost < best
                best = ins_cost
            if sub_cost < best
                best = sub_cost
            push(curr, best)
            j2 = j2 + 1
        prev = curr
        i = i + 1
    prev[lb]

fn ti_suggest_name(st: TiState, vname: string) -> string
    let best = ""
    let best_dist = 999
    let max_dist = 3
    if len(vname) <= 3
        max_dist = 1
    else if len(vname) <= 6
        max_dist = 2
    let scope = st.ti_scope
    let si = len(scope) - 1
    while si >= 0
        let frame = scope[si]
        for k in keys(frame)
            let d = edit_distance(vname, k)
            if d < best_dist and d <= max_dist and d > 0
                best_dist = d
                best = k
        si = si - 1
    for k in keys(st.ti_stdlib)
        let d = edit_distance(vname, k)
        if d < best_dist and d <= max_dist and d > 0
            best_dist = d
            best = k
    best

// ── Scope lookup ─────────────────────────────────────────────────────────────

fn ti_lookup(st: TiState, vname: string, line: int) -> NType
    let scope = st.ti_scope
    let i = len(scope) - 1
    while i >= 0
        let frame = scope[i]
        if contains(frame, vname)
            return ti_instantiate(st, frame[vname])
        i = i - 1
    let stdlib = st.ti_stdlib
    if contains(stdlib, vname)
        let scheme = stdlib[vname]
        return ti_instantiate(st, scheme)
    if vname == "__file__" or vname == "__func__"
        return nt_string()
    if vname == "__line__"
        return nt_int()
    let suggestion = ti_suggest_name(st, vname)
    let msg = "unknown identifier '" + vname + "'"
    if suggestion != ""
        msg = msg + "; did you mean '" + suggestion + "'?"
    ti_error(st, msg, line)
    nt_any()

fn ti_has_name(st: TiState, vname: string) -> int
    let scope = st.ti_scope
    let i = len(scope) - 1
    while i >= 0
        if contains(scope[i], vname)
            return 1
        i = i - 1
    if contains(st.ti_stdlib, vname)
        return 1
    if vname == "__file__" or vname == "__func__" or vname == "__line__"
        return 1
    return 0

// ── Source type annotation to NType ──────────────────────────────────────────

fn ti_ann_to_type(ann: string) -> NType
    if ann == "int" or ann == "Int"
        return nt_int()
    // LOCK-4 inc3a: sized-int annotations now carry their WIDTH in the type (u8..i64/usize/isize).
    // A default int (bare literal or plain `int`, name "") stays fully compatible — only two
    // DIFFERENT explicit widths mismatch (u8 vs i32). Long-forms normalize to the short width name.
    if _is_sized_int_name(ann)
        return nt_int_w(ann)
    if ann == "int32"
        return nt_int_w("i32")
    if ann == "int64"
        return nt_int_w("i64")
    if ann == "uint32"
        return nt_int_w("u32")
    if ann == "uint64"
        return nt_int_w("u64")
    if ann == "string" or ann == "str" or ann == "String" or ann == "Str"
        return nt_string()
    // `byval:T` is a CALLING-CONVENTION marker on an extern parameter, not a distinct type:
    // the argument is still a T. Without stripping it here the annotation resolved to
    // nt_struct("byval:Vec2") and every call failed to unify.
    if len(ann) > 6 and ann[0:6] == "byval:"
        return ti_ann_to_type(slice(ann, 6, len(ann)))
    // `T[]` is a PACKED ARRAY -- its own opaque handle type, deliberately not list<T>: its
    // element kind is fixed at creation, which is what removes the deopt-under-aliases hazard a
    // width-carrying list would have. Typed `any` so the existing tarray_* builtins accept it.
    if _ta_elem_of_ann(ann) != "" and _ta_kind_of(_ta_elem_of_ann(ann)) >= 0
        return nt_any()
    if ann == "float" or ann == "Float"
        return nt_float()
    // BOTH float widths are EXPLICIT. Mapping f64 to the width-less default would make
    // `let b: f64 = <an f32>` legal, since "" is compatible with every width by design (a
    // bare literal adopts its sized context) -- and inc3a's rule names f32-vs-f64 as a real
    // type error precisely because silent float-width mixing is a footgun. Naming f64 costs
    // nothing at codegen: _float_width_of reports only "f32", so an f64-annotated value is
    // emitted exactly like an ordinary float.
    if ann == "f64"
        return nt_float_w("f64")
    if ann == "f32"
        return nt_float_w("f32")
    if ann == "bool" or ann == "Bool"
        return nt_bool()
    if ann == "list" or ann == "List"
        return nt_list(nt_any())
    if ann == "dict" or ann == "Dict" or ann == "Map"
        return nt_dict(nt_string(), nt_any())
    if ann == "channel" or ann == "Channel"
        return nt_channel(nt_any())
    if ann == "" or ann == "any" or ann == "Any"
        return nt_any()
    // `f: fn` is the obvious way to document a higher-order parameter, and it PARSED fine — but
    // `fn` was not a known type name, so it fell through to nt_struct("fn"): a STRUCT that happens
    // to be called "fn" and can never be called. Every use failed with the self-contradictory
    // "type mismatch: expected fn, found (int) -> ?T". Treat it as "some callable" (any), which
    // unifies with a function of any arity — matching the existing HOF idiom of leaving the
    // parameter untyped, while letting the annotation be written for documentation.
    if ann == "fn" or ann == "Fn" or ann == "function" or ann == "Function"
        return nt_any()
    nt_struct(ann)

// Split a parametric annotation like "Map<string,int>" or "List<List<int>>"
// at the comma separators of the OUTER pair of angle brackets.
fn ti_split_type_args(args: string) -> list
    let parts = []
    let depth = 0
    let start = 0
    let i = 0
    while i < len(args)
        let c = args[i]
        if c == "<"
            depth = depth + 1
        else if c == ">"
            depth = depth - 1
        else if c == "," and depth == 0
            push(parts, trim(slice(args, start, i)))
            start = i + 1
        i = i + 1
    if start < len(args)
        push(parts, trim(slice(args, start, len(args))))
    parts

fn ti_ann_to_type_g(st: TiState, ann: string, gmap: dict) -> NType
    // `byval:T` is a CALLING-CONVENTION marker on an extern parameter, not a distinct type --
    // the argument is still a T. Without stripping it the annotation resolved to
    // nt_struct("byval:Vec2") and no argument could ever unify with it.
    if len(ann) > 6 and ann[0:6] == "byval:"
        return ti_ann_to_type_g(st, slice(ann, 6, len(ann)), gmap)
    // A variadic rest param `T...` is a list<T> inside the function body.
    if ends_with(ann, "...")
        return nt_list(ti_ann_to_type_g(st, slice(ann, 0, len(ann) - 3), gmap))
    // Optional sugar `T?` is Option<T> == nt_sum(T, unit), so some/none/unwrap/
    // is_some/is_none and match Some/None all type-check against it directly.
    if ends_with(ann, "?")
        return nt_sum(ti_ann_to_type_g(st, slice(ann, 0, len(ann) - 1), gmap), nt_unit())
    // LOCK-10: an all-digit annotation is a CONST GENERIC argument (the 3 in `Matrix<3,4>`),
    // not a type name. Checked before the gmap/alias lookups since a digit string can never
    // be a generic parameter name or an alias.
    if _is_const_generic_arg(ann)
        return nt_const(parse_int(ann))
    if contains(gmap, ann)
        return gmap[ann]
    // Resolve transparent type aliases (type Name = Target) before any
    // structural interpretation, so `Json` becomes `dict<string,any>` etc.
    // The bounded loop terminates a cyclic alias chain instead of looping
    // forever; a stuck name falls through to nt_struct and fails to unify.
    let resolved = ann
    let aguard = 0
    while contains(st.ti_aliases, resolved) and aguard < 64
        resolved = st.ti_aliases[resolved]
        aguard = aguard + 1
    let lt = find(resolved, "<")
    if lt < 0
        // A BARE `Result` / `Option` annotation (no type args) is a POLYMORPHIC
        // sum with a FRESH Ok-payload var — NOT nt_struct("Result"). Without this,
        // a helper typed `-> Result` (or `r: Result`) got a struct type that (a)
        // cannot match Ok/Err and (b) pins across call sites, so a reusable
        // Result-returning/-taking helper broke on its second call. This is the #1
        // high-level enabler (Result<T> already becomes nt_sum below; the bare
        // form just fell through to nt_struct). Fresh var => generalizes per call.
        if resolved == "Result"
            return nt_sum(ti_fresh(st), nt_string())
        if resolved == "Option"
            return nt_sum(ti_fresh(st), nt_unit())
        return ti_ann_to_type(resolved)
    if not ends_with(resolved, ">")
        if resolved == "Result"
            return nt_sum(ti_fresh(st), nt_string())
        if resolved == "Option"
            return nt_sum(ti_fresh(st), nt_unit())
        return ti_ann_to_type(resolved)
    let base = slice(resolved, 0, lt)
    let args_str = slice(resolved, lt + 1, len(resolved) - 1)
    let args = ti_split_type_args(args_str)
    if base == "List" or base == "list"
        if len(args) >= 1
            return nt_list(ti_ann_to_type_g(st, args[0], gmap))
        return nt_list(nt_any())
    if base == "Map" or base == "dict" or base == "Dict"
        if len(args) >= 2
            return nt_dict(ti_ann_to_type_g(st, args[0], gmap), ti_ann_to_type_g(st, args[1], gmap))
        return nt_dict(nt_string(), nt_any())
    if base == "Option"
        if len(args) >= 1
            return ti_ann_to_type_g(st, args[0], gmap)
        return nt_any()
    if base == "Result"
        // Result<T> := nt_sum(T, string); Result<T,E> := nt_sum(T,E). A SUM, not the inner type --
        // mirrors the `T?` Option sugar (-> nt_sum(T,unit)) and lets `let r: Result<T> = ...` plus
        // `match r { Ok/Err }` type-check (e.g. from_json_safe). (Collapsing to the inner type was a
        // latent bug: no real annotation used it, and it broke any Result<T>-annotated sum binding.)
        if len(args) >= 2
            return nt_sum(ti_ann_to_type_g(st, args[0], gmap), ti_ann_to_type_g(st, args[1], gmap))
        if len(args) >= 1
            return nt_sum(ti_ann_to_type_g(st, args[0], gmap), nt_string())
        return nt_any()
    if base == "Channel" or base == "channel"
        if len(args) >= 1
            return nt_channel(ti_ann_to_type_g(st, args[0], gmap))
        return nt_channel(nt_any())
    // LOCK-10 CONST GENERICS: a user generic struct's arguments were DROPPED here (`Vec<3>` became
    // a bare nt_struct("Vec")), which is why a size mismatch could never be detected — there was
    // nothing left to compare.
    // Carry the arguments ONLY when at least one is a const generic. Doing it for every generic
    // struct would switch `Box<int>` etc. from erased to structurally-checked across 1830+ stdlib
    // modules in one step — a much wider behavioural change than this item calls for. Scoping it
    // to const args gives shape checking exactly where it is wanted and leaves every existing
    // generic struct byte-identical.
    let _cg_any = false
    let _cg_i = 0
    while _cg_i < len(args)
        if _is_const_generic_arg(args[_cg_i])
            _cg_any = true
        _cg_i = _cg_i + 1
    if _cg_any
        let _cg_ps = []
        let _cg_j = 0
        while _cg_j < len(args)
            push(_cg_ps, ti_ann_to_type_g(st, args[_cg_j], gmap))
            _cg_j = _cg_j + 1
        return NType("struct", base, _cg_ps, 0)
    ti_ann_to_type(base)

fn ti_extract_generics(annotations: list) -> list
    for a in annotations
        match a
            Expr(at, av, an, ac, af, al) =>
                if at == "generics"
                    let names = []
                    for c in ac
                        match c
                            Expr(ct, cv, cn, cc, cf, cl) =>
                                push(names, cv)
                    return names
    []

fn ti_extract_bounds(annotations: list) -> dict
    for a in annotations
        match a
            Expr(at, av, an, ac, af, al) =>
                if at == "generic_bounds"
                    let bounds = {}
                    for c in ac
                        match c
                            Expr(ct, cv, cn, cc, cf, cl) =>
                                if ct == "bound" and len(cc) > 0
                                    match cc[0]
                                        Expr(bt, bv, bn, bc, bf, bl) =>
                                            bounds[cv] = bv
                    return bounds
    {}

// ── Expression inference ─────────────────────────────────────────────────────

// Compile-time constant evaluation for static_assert: folds int/bool literals,
// arithmetic, comparisons, and/or/not into a single value. ok=0 means the
// expression is NOT a compile-time constant (e.g. it references a variable), so
// the build is rejected with a clear message rather than silently accepted. NOVA
// wraps on overflow, so this mirrors runtime integer semantics. Used only by
// static_assert -> the check costs zero at runtime (no IR is emitted for it).
type ConstEval
    ok: int
    val: int

fn ti_const_eval(e: Expr) -> ConstEval
    match e
        Expr(et, ev, en, ec, ef, eln) =>
            if et == "int"
                return ConstEval(1, en)
            if et == "bool"
                return ConstEval(1, en)
            if et == "unary"
                let ux = ti_const_eval(ec[0])
                if ux.ok == 0
                    return ConstEval(0, 0)
                if ev == "-"
                    return ConstEval(1, 0 - ux.val)
                if ev == "not"
                    if ux.val == 0
                        return ConstEval(1, 1)
                    return ConstEval(1, 0)
                return ConstEval(0, 0)
            if et == "binop"
                let lc = ti_const_eval(ec[0])
                if lc.ok == 0
                    return ConstEval(0, 0)
                let rc = ti_const_eval(ec[1])
                if rc.ok == 0
                    return ConstEval(0, 0)
                let a = lc.val
                let bb = rc.val
                if ev == "+"
                    return ConstEval(1, a + bb)
                if ev == "-"
                    return ConstEval(1, a - bb)
                if ev == "*"
                    return ConstEval(1, a * bb)
                if ev == "/"
                    if bb == 0
                        return ConstEval(0, 0)
                    return ConstEval(1, a / bb)
                if ev == "%"
                    if bb == 0
                        return ConstEval(0, 0)
                    return ConstEval(1, a % bb)
                if ev == "=="
                    if a == bb
                        return ConstEval(1, 1)
                    return ConstEval(1, 0)
                if ev == "!="
                    if a != bb
                        return ConstEval(1, 1)
                    return ConstEval(1, 0)
                if ev == "<"
                    if a < bb
                        return ConstEval(1, 1)
                    return ConstEval(1, 0)
                if ev == ">"
                    if a > bb
                        return ConstEval(1, 1)
                    return ConstEval(1, 0)
                if ev == "<="
                    if a <= bb
                        return ConstEval(1, 1)
                    return ConstEval(1, 0)
                if ev == ">="
                    if a >= bb
                        return ConstEval(1, 1)
                    return ConstEval(1, 0)
                if ev == "and"
                    if a != 0 and bb != 0
                        return ConstEval(1, 1)
                    return ConstEval(1, 0)
                if ev == "or"
                    if a != 0 or bb != 0
                        return ConstEval(1, 1)
                    return ConstEval(1, 0)
                return ConstEval(0, 0)
            if et == "if_expr"
                if len(ec) >= 3
                    let cce = ti_const_eval(ec[0])
                    if cce.ok == 0
                        return ConstEval(0, 0)
                    if cce.val != 0
                        return ti_const_eval(ec[1])
                    return ti_const_eval(ec[2])
                return ConstEval(0, 0)
            if et == "if"
                if len(ec) >= 3
                    let cce = ti_const_eval(ec[0])
                    if cce.ok == 0
                        return ConstEval(0, 0)
                    if cce.val != 0
                        return ti_const_eval(ec[1])
                    return ti_const_eval(ec[2])
                return ConstEval(0, 0)
            if et == "paren"
                if len(ec) >= 1
                    return ti_const_eval(ec[0])
                return ConstEval(0, 0)
            if et == "str"
                return ConstEval(1, len(ev))
    ConstEval(0, 0)

fn _expr_contains_try_unwrap(e: Expr) -> int
    match e
        Expr(t, v, n, ch, f, ln) =>
            if t == "try_unwrap"
                return ln
            if t == "lambda" or t == "lambda_blk"
                return 0
            for c in ch
                let r = _expr_contains_try_unwrap(c)
                if r > 0
                    return r
            for fi in f
                let r2 = _expr_contains_try_unwrap(fi)
                if r2 > 0
                    return r2
    0

fn ti_infer_expr(st: TiState, expr: Expr) -> NType
    ti_infer_expr_inner(st, expr)

// #4: raw-memory primitives that can read/write ARBITRARY memory (heap-corruption footguns). Like extern
// calls, these require an enclosing `unsafe` block/expression, so "no UB in safe code" becomes a checkable
// property. Kept in sync with the registrations near reg["ptr_read"]... / reg["alloc_raw"].
fn _is_unsafe_builtin(name)
    // 7.1: `asm` is the definition of outside-the-safety-envelope — it can do literally
    // anything to the machine — so it is gated exactly like the raw-memory primitives.
    let _ub = ["ptr_read", "ptr_write", "ptr_read_u8", "ptr_read_i8", "ptr_read_u16", "ptr_read_i16", "ptr_read_u32", "ptr_read_i32", "ptr_read_u64", "ptr_read_f32", "ptr_read_f64", "ptr_write_u8", "ptr_write_u16", "ptr_write_u32", "ptr_write_u64", "ptr_write_f32", "ptr_write_f64", "ptr_add", "ptr_diff", "memcpy_unsafe", "memset_unsafe", "alloc_raw", "free_raw", "asm"]
    return contains(_ub, name)

fn ti_infer_expr_inner(st: TiState, expr: Expr) -> NType
    match expr
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "int"
                // LOCK-4 inc3a: a sized-suffix literal ("255#u8") types as the sized int;
                // a bare literal stays the default int. Codegen uses `num` (unaffected).
                let _il_sfx = _int_lit_suffix(value)
                if _il_sfx != "" and _is_sized_int_name(_il_sfx)
                    return nt_int_w(_il_sfx)
                return nt_int()
            if tag == "float"
                return nt_float()
            if tag == "str" or tag == "str_interp"
                // NOTE: interpolation parts are intentionally NOT type-checked here. NOVA's always-on
                // `{expr}` interpolation means literal braces in YAML/JSON/format strings (e.g. `{a: 1}`)
                // parse as an interpolation of `a`; inferring the parts turns every such literal-brace
                // string into an "unknown identifier" error (broke 5 existing tests + unknown user code).
                // The `{undefined}` -> silent "0" footgun needs a WARNING (or a brace-literal audit), not a
                // hard error. Tracked in the Track A backlog. See [[reference-nova-module-authoring-gotchas]].
                return nt_string()
            if tag == "bool"
                return nt_bool()
            if tag == "null"
                return nt_any()
            if tag == "named_arg"
                if len(children) > 0
                    return ti_infer_expr(st, children[0])
                return nt_any()
            if tag == "ident"
                return ti_lookup(st, value, eline)
            if tag == "call"
                if value == "static_assert"
                    // Compile-time assertion: evaluate the constant argument NOW and
                    // fail the build if it is false (or not a constant). Emits no code.
                    if len(children) == 0
                        ti_error(st, "static_assert requires a constant boolean expression argument", eline)
                    else
                        let sa_ce = ti_const_eval(children[0])
                        if sa_ce.ok == 0
                            ti_error(st, "static_assert requires a compile-time constant expression (only int/bool literals, arithmetic, comparisons, and/or/not are allowed)", eline)
                        else if sa_ce.val == 0
                            let sa_msg = "static assertion failed"
                            if len(children) >= 2
                                match children[1]
                                    Expr(smt, smv, smn, smc, smf, sml) =>
                                        if smt == "str"
                                            sa_msg = "static assertion failed: " + smv
                            ti_error(st, sa_msg, eline)
                    return nt_int()
                if not ti_has_name(st, value) and len(children) > 0
                    let _md_sole = ""
                    let _md_multi = 0
                    let _md_tkeys = keys(st.ti_type_methods)
                    for _md_tk in _md_tkeys
                        if list_contains(st.ti_type_methods[_md_tk], value)
                            if _md_sole == ""
                                _md_sole = _md_tk
                            else
                                _md_multi = 1
                    if _md_sole != "" and _md_multi == 0
                        let _md_rn = _md_sole + "__" + value
                        let _md_ft = ti_lookup(st, _md_rn, eline)
                        let _md_args = []
                        let _md_ai = 0
                        while _md_ai < len(children)
                            push(_md_args, ti_infer_expr(st, children[_md_ai]))
                            _md_ai = _md_ai + 1
                        let _md_ret = ti_fresh(st)
                        ti_constrain(st, _md_ft, nt_fn(_md_args, _md_ret), eline)
                        return _md_ret
                    if _md_multi == 1
                        let _md_ai = 0
                        while _md_ai < len(children)
                            ti_infer_expr(st, children[_md_ai])
                            _md_ai = _md_ai + 1
                        return nt_any()
                if st.ti_unsafe_depth == 0
                    if contains(st.ti_extern_fns, value)
                        ti_error(st, "calling extern function '" + value + "' requires an enclosing 'unsafe' expression (C code is outside NOVA's safety envelope; wrap the call: 'unsafe " + value + "(...)')", eline)
                    else if _is_unsafe_builtin(value)
                        ti_error(st, "calling raw-memory primitive '" + value + "' requires an enclosing 'unsafe' block/expression (it can read or write arbitrary memory -- outside NOVA's safety envelope; wrap it as 'unsafe " + value + "(...)' or put it inside an `unsafe` block)", eline)
                if value == "orm_with_tx"
                    _orm_check_tx_escape(st, children, eline)
                let fn_t = ti_lookup(st, value, eline)
                // NAMED ARGS: reorder to the DECLARED parameter order before inferring, so
                // `f(b: 2, a: 1)` checks against the right parameters. Mirrors what the IR
                // lowering already does; without it the checker compared positionally and
                // rejected a correct call whenever the reordered params had different types.
                if contains(st.ti_fn_pnames, value)
                    let _tna_has = false
                    for _tnc in children
                        match _tnc
                            Expr(_tnt, _, _, _, _, _) =>
                                if _tnt == "named_arg"
                                    _tna_has = true
                    if _tna_has
                        let _tna_map = {}
                        let _tna_pos = []
                        for _tnc2 in children
                            match _tnc2
                                Expr(_tnt2, _tnv2, _, _tnch2, _, _) =>
                                    if _tnt2 == "named_arg" and len(_tnch2) > 0
                                        _tna_map[_tnv2] = _tnch2[0]
                                    else
                                        push(_tna_pos, _tnc2)
                        let _tna_out = []
                        let _tna_pi = 0
                        for _tnpn in st.ti_fn_pnames[value]
                            if contains(_tna_map, _tnpn)
                                push(_tna_out, _tna_map[_tnpn])
                            else if _tna_pi < len(_tna_pos)
                                push(_tna_out, _tna_pos[_tna_pi])
                                _tna_pi = _tna_pi + 1
                        // Only adopt the reordering when every argument was placed; a
                        // misspelled name would otherwise silently DROP an argument and
                        // turn a clear error into a confusing arity mismatch.
                        if len(_tna_out) == len(children)
                            children = _tna_out
                let arg_types = []
                let ai = 0
                while ai < len(children)
                    push(arg_types, ti_infer_expr(st, children[ai]))
                    ai = ai + 1
                // variadic call: collapse trailing args into the rest param's list<T>
                // (each extra arg unified with the element type), so the fn type with
                // (fixed+1) params unifies against (fixed + 1 list) actuals.
                if contains(st.ti_variadic, value)
                    let v_fixed = st.ti_variadic[value]
                    if len(arg_types) >= v_fixed
                        let v_restT = ti_fresh(st)
                        let v_collapsed = []
                        let vk = 0
                        while vk < v_fixed
                            push(v_collapsed, arg_types[vk])
                            vk = vk + 1
                        let vr = v_fixed
                        while vr < len(arg_types)
                            ti_constrain(st, v_restT, arg_types[vr], eline)
                            vr = vr + 1
                        push(v_collapsed, nt_list(v_restT))
                        arg_types = v_collapsed
                if contains(st.ti_min_arity, value)
                    let full_ar = 0
                    match fn_t
                        NType(ftk, ftn, ftp, fti) =>
                            if ftk == "fn"
                                full_ar = len(ftp) - 1
                            else if ftk == "scheme"
                                match ftp[0]
                                    NType(sk, sn, sp, si) =>
                                        if sk == "fn"
                                            full_ar = len(sp) - 1
                    let min_ar = st.ti_min_arity[value]
                    if len(arg_types) < min_ar
                        ti_error(st, "function expects " + str(min_ar) + " arguments, but got " + str(len(arg_types)), eline)
                    while len(arg_types) < full_ar
                        push(arg_types, ti_fresh(st))
                let ret_var = ti_fresh(st)
                if value == "select" or value == "select_timeout"
                    return ret_var
                // L8 call-overload: if the callee is a struct with a __call method,
                // redirect type inference to Struct__call(self, args...).
                let _co_walked = ti_walk(st, fn_t)
                // L8: for `let d = Doubler(3)` the callee is STILL an unresolved type var here,
                // because ti_constrain only DEFERS -- so the struct redirect below could never
                // fire and the call fell through to the fn constraint ("expected Doubler, found
                // (int) -> ?T"). ti_solve binds + clears the deferred constraints; this is the
                // same "resolve the subject now" move the `match` paths already make.
                // Tightly gated so nothing else can be perturbed: only when the callee is
                // genuinely still a VAR (a normal `foo(1)` callee already has a fn type), and
                // only when this unit actually declares a struct with a `call` method -- if none
                // exists the redirect can never fire, so a program without call-overload compiles
                // byte-identically and pays nothing.
                match _co_walked
                    NType(_pw_k, _pw_n, _pw_p, _pw_i) =>
                        if _pw_k == "var"
                            let _pw_any = 0
                            for _pw_t in keys(st.ti_type_methods)
                                if list_contains(st.ti_type_methods[_pw_t], "call")
                                    _pw_any = 1
                            if _pw_any == 1
                                ti_solve(st)
                                _co_walked = ti_walk(st, fn_t)
                let _co_redir = 0
                match _co_walked
                    NType(_co_k, _co_n, _co_p, _co_i) =>
                        // NOTE: _co_walked is only a struct here when the callee's type is ALREADY
                        // resolved at this point (e.g. `let d: Doubler = ...`, a param, or a field).
                        // For `let d = Doubler(3)` it is still an unresolved type VARIABLE, because
                        // constraint solving is deferred — so the redirect cannot fire and the call
                        // falls through to the fn constraint below. See the limitation note on the
                        // fallback branch.
                        if _co_k == "struct" and _co_n != ""
                            let _co_call = _co_n + "__call"
                            // Resolve against ti_type_methods (type -> its method names), the same
                            // table the method-call path uses. ti_has_name only walks ti_scope +
                            // ti_stdlib, which do not carry `Type__method` entries — so the original
                            // ti_has_name guard was always 0 and this redirect never fired, leaving
                            // `d(7)` to hit the fallback and report "expected Doubler, found (int) -> ?T".
                            let _co_known = 0
                            if contains(st.ti_type_methods, _co_n)
                                if list_contains(st.ti_type_methods[_co_n], "call")
                                    _co_known = 1
                            if ti_has_name(st, _co_call) == 1
                                _co_known = 1
                            if _co_known == 1
                                let _co_ft = ti_lookup(st, _co_call, eline)
                                let _co_args = [fn_t]
                                for _co_a in arg_types
                                    push(_co_args, _co_a)
                                let _co_exp = nt_fn(_co_args, ret_var)
                                ti_constrain(st, _co_ft, _co_exp, eline)
                                _co_redir = 1
                if _co_redir == 0
                    // KNOWN LIMITATION (L8 call-overload): if fn_t is still an unresolved type
                    // variable we constrain it to a function type here, which later conflicts once
                    // it resolves to a callable struct — `let d = Doubler(3); d(7)` reports
                    // "expected Doubler, found (int) -> ?T". Annotating the binding
                    // (`let d: Doubler = Doubler(3)`) resolves the type eagerly and works today.
                    // A full fix needs the call constraint DEFERRED until fn_t is resolved (the
                    // ti_bound_checks pattern), which is inferrer-deep — tracked, not bolted on here.
                    let expected_fn = nt_fn(arg_types, ret_var)
                    ti_constrain(st, fn_t, expected_fn, eline)
                if contains(st.ti_fn_bounds, value)
                    let fn_bounds = st.ti_fn_bounds[value]
                    let bci = 0
                    while bci < len(arg_types)
                        if contains(fn_bounds, str(bci))
                            push(st.ti_bound_checks, [arg_types[bci], fn_bounds[str(bci)], eline, value])
                        bci = bci + 1
                return ret_var
            if tag == "method_call"
                if len(children) > 0
                    match children[0]
                        Expr(rtag, rval, rnum, rch, rf, rln) =>
                            if rtag == "ident" and contains(st.ti_modules, rval)
                                let mod_fns = st.ti_modules[rval]
                                if contains(mod_fns, value)
                                    // finding #4: freshen the module fn's type per call site so a
                                    // polymorphic imported fn (now carrying generic vars) is NOT pinned
                                    // by the first mod.func call. Non-generic types generalize to [] = no-op.
                                    let mfn_t = ti_instantiate(st, ti_generalize(st, mod_fns[value]))
                                    // 1.9 NAMED ARGS (TI side). ti_fn_pnames records the callee's
                                    // declared param ORDER; the same-file path reorders an
                                    // out-of-order call BEFORE unification, this one did not -- so
                                    // `mod.f(b: 2, a: 1)` was type-checked POSITIONALLY and reported
                                    // a bogus mismatch whenever the two params had different types
                                    // (and type-checked but ran wrong when they matched).
                                    let _mq_ch = []
                                    let _mq_ci = 1
                                    while _mq_ci < len(children)
                                        push(_mq_ch, children[_mq_ci])
                                        _mq_ci = _mq_ci + 1
                                    let _mq_tna = false
                                    for _mq_tc in _mq_ch
                                        match _mq_tc
                                            Expr(_mq_tct, _, _, _, _, _) =>
                                                if _mq_tct == "named_arg"
                                                    _mq_tna = true
                                    if _mq_tna and contains(st.ti_fn_pnames, value)
                                        let _mq_tpn = st.ti_fn_pnames[value]
                                        let _mq_tpos = []
                                        let _mq_tmap = {}
                                        for _mq_tc2 in _mq_ch
                                            match _mq_tc2
                                                Expr(_mq_tct2, _mq_tcv2, _, _mq_tcc2, _, _) =>
                                                    if _mq_tct2 == "named_arg"
                                                        _mq_tmap[_mq_tcv2] = _mq_tcc2[0]
                                                    else
                                                        push(_mq_tpos, _mq_tc2)
                                        let _mq_tout = []
                                        let _mq_tpi = 0
                                        for _mq_tp in _mq_tpn
                                            if contains(_mq_tmap, _mq_tp)
                                                push(_mq_tout, _mq_tmap[_mq_tp])
                                            else if _mq_tpi < len(_mq_tpos)
                                                push(_mq_tout, _mq_tpos[_mq_tpi])
                                                _mq_tpi = _mq_tpi + 1
                                        _mq_ch = _mq_tout
                                    let arg_types = []
                                    for _mq_a in _mq_ch
                                        push(arg_types, ti_infer_expr(st, _mq_a))
                                    // 1.9 VARIADIC (TI side). Mirrors ~17812: collapse the trailing
                                    // actuals into the rest param's list<T>, each unified with the
                                    // element type, so a (fixed+1)-param fn type unifies against the
                                    // call. Without it a variadic `mod.f(1,2,3)` raised E1003.
                                    if contains(st.ti_variadic, value)
                                        let _mqv_fx = st.ti_variadic[value]
                                        if len(arg_types) >= _mqv_fx
                                            let _mqv_rt = ti_fresh(st)
                                            let _mqv_col = []
                                            let _mqv_k = 0
                                            while _mqv_k < _mqv_fx
                                                push(_mqv_col, arg_types[_mqv_k])
                                                _mqv_k = _mqv_k + 1
                                            let _mqv_j = _mqv_fx
                                            while _mqv_j < len(arg_types)
                                                ti_constrain(st, _mqv_rt, arg_types[_mqv_j], eline)
                                                _mqv_j = _mqv_j + 1
                                            push(_mqv_col, nt_list(_mqv_rt))
                                            arg_types = _mqv_col
                                    // DEFAULT PARAMS ACROSS THE MODULE BOUNDARY. The bare-call path
                                    // (~17827) pads the actuals with fresh vars up to the callee's FULL
                                    // arity so an omitted defaulted arg still unifies; this path did not,
                                    // so `mod.f("x")` on `fn f(a, b = "d")` unified (string)->? against
                                    // (string,string)->string and raised E1003. Defaults were therefore
                                    // usable only within the declaring file -- the single biggest reason
                                    // a NOVA module could not present an ergonomic API to its importers.
                                    // full_ar comes from the MODULE's own fn type, so it is always right;
                                    // min_ar comes from the module-qualified key written in the import
                                    // scan, counting only params with NO default.
                                    let _mq_key = rval + "." + value
                                    if contains(st.ti_min_arity, _mq_key)
                                        let _mq_full = 0
                                        match mfn_t
                                            NType(_mqk, _mqn, _mqp, _mqi) =>
                                                if _mqk == "fn"
                                                    _mq_full = len(_mqp) - 1
                                                else if _mqk == "scheme"
                                                    match _mqp[0]
                                                        NType(_mqsk, _mqsn, _mqsp, _mqsi) =>
                                                            if _mqsk == "fn"
                                                                _mq_full = len(_mqsp) - 1
                                        let _mq_min = st.ti_min_arity[_mq_key]
                                        if len(arg_types) < _mq_min
                                            ti_error(st, "function expects " + str(_mq_min) + " arguments, but got " + str(len(arg_types)), eline)
                                        while len(arg_types) < _mq_full
                                            push(arg_types, ti_fresh(st))
                                    let ret_var = ti_fresh(st)
                                    ti_constrain(st, mfn_t, nt_fn(arg_types, ret_var), eline)
                                    return ret_var
                                else
                                    ti_error(st, "module '" + rval + "' has no exported function '" + value + "'", eline)
                                    return nt_any()
                let _mc_sole = ""
                let _mc_multi = 0
                let _mc_tkeys = keys(st.ti_type_methods)
                for _mc_tk in _mc_tkeys
                    if list_contains(st.ti_type_methods[_mc_tk], value)
                        if _mc_sole == ""
                            _mc_sole = _mc_tk
                        else
                            _mc_multi = 1
                if _mc_sole != "" and _mc_multi == 0
                    let _mc_rn = _mc_sole + "__" + value
                    let _mc_ft = ti_lookup(st, _mc_rn, eline)
                    let _mc_args = []
                    let _mc_ai = 0
                    while _mc_ai < len(children)
                        push(_mc_args, ti_infer_expr(st, children[_mc_ai]))
                        _mc_ai = _mc_ai + 1
                    let _mc_ret = ti_fresh(st)
                    ti_constrain(st, _mc_ft, nt_fn(_mc_args, _mc_ret), eline)
                    return _mc_ret
                if _mc_multi == 1
                    let _mc_ai2 = 0
                    while _mc_ai2 < len(children)
                        ti_infer_expr(st, children[_mc_ai2])
                        _mc_ai2 = _mc_ai2 + 1
                    return nt_any()
                let ufcs_arg_types = []
                let uai = 0
                while uai < len(children)
                    push(ufcs_arg_types, ti_infer_expr(st, children[uai]))
                    uai = uai + 1
                if contains(st.ti_stdlib, value)
                    let ufcs_scheme = st.ti_stdlib[value]
                    match ufcs_scheme
                        NTypeScheme(qvars, fn_type) =>
                            let fresh_fn = ti_instantiate(st, ufcs_scheme)
                            let ufcs_ret = ti_fresh(st)
                            ti_constrain(st, fresh_fn, nt_fn(ufcs_arg_types, ufcs_ret), eline)
                            return ufcs_ret
                else if contains(st.ti_fn_types, value)
                    let ufcs_fn_t = st.ti_fn_types[value]
                    let ufcs_ret = ti_fresh(st)
                    ti_constrain(st, ufcs_fn_t, nt_fn(ufcs_arg_types, ufcs_ret), eline)
                    return ufcs_ret
                return nt_any()
            if tag == "dyn_call"
                let ai = 0
                while ai < len(children)
                    ti_infer_expr(st, children[ai])
                    ai = ai + 1
                return nt_any()
            if tag == "binop"
                let left = ti_infer_expr(st, children[0])
                let right = ti_infer_expr(st, children[1])
                if value == "+" or value == "-" or value == "/" or value == "%" or value == "**"
                    ti_constrain(st, left, right, eline)
                    return left
                if value == "*"
                    let _mlk = nt_get_kind(ti_walk(st, left))
                    let _mrk = nt_get_kind(ti_walk(st, right))
                    if _mlk == "string" or _mlk == "list"
                        return left
                    else if _mrk == "string" or _mrk == "list"
                        return right
                    else
                        ti_constrain(st, left, right, eline)
                        return left
                if value == "==" or value == "!=" or value == "<" or value == ">" or value == "<=" or value == ">="
                    ti_constrain(st, left, right, eline)
                    return nt_bool()
                if value == "and" or value == "or"
                    ti_constrain(st, left, nt_bool(), eline)
                    ti_constrain(st, right, nt_bool(), eline)
                    return nt_bool()
                if value == "&" or value == "|" or value == "^" or value == "<<" or value == ">>"
                    ti_constrain(st, left, nt_int(), eline)
                    ti_constrain(st, right, nt_int(), eline)
                    return nt_int()
                if value == ".."
                    ti_constrain(st, left, nt_int(), eline)
                    ti_constrain(st, right, nt_int(), eline)
                    return nt_range()
                if value == "in"
                    return nt_bool()
                if value == "matches"
                    return nt_bool()
                return left
            if tag == "unary"
                let operand = ti_infer_expr(st, children[0])
                if value == "not"
                    ti_constrain(st, operand, nt_bool(), eline)
                    return nt_bool()
                return operand
            if tag == "list"
                // NOVA list literals may be heterogeneous (the compiler itself
                // uses them, e.g. [name, value, 0, arity]). Infer each element
                // (so errors inside elements still surface) but do NOT
                // constrain elements to each other; the list is list<any>.
                let ci = 0
                while ci < len(children)
                    ti_infer_expr(st, children[ci])
                    ci = ci + 1
                return nt_list(nt_any())
            if tag == "dict"
                return nt_dict(nt_string(), nt_any())
            if tag == "tuple"
                let elem_types = []
                for c in children
                    push(elem_types, ti_infer_expr(st, c))
                return nt_tuple(elem_types)
            if tag == "index"
                let idx_subj = ti_infer_expr(st, children[0])
                let idx_key = ti_infer_expr(st, children[1])
                let idx_w = ti_walk(st, idx_subj)
                match idx_w
                    NType(iwk, iwn, iwp, iwi) =>
                        if iwk == "int" or iwk == "float" or iwk == "bool" or iwk == "range"
                            ti_error(st, "type " + ti_type_str(idx_w) + " is not indexable; only list, dict, and string support [] access", eline)
                        else if iwk == "list" or iwk == "string"
                            // list and string both require integer indices.
                            let kw = ti_walk(st, idx_key)
                            match kw
                                NType(kwk, kwn, kwp, kwi) =>
                                    if kwk == "string" or kwk == "list" or kwk == "dict" or kwk == "struct" or kwk == "range"
                                        ti_error(st, "type " + ti_type_str(idx_w) + " requires an integer index, but found " + ti_type_str(kw), eline)
                        else if iwk == "dict" and len(iwp) > 0
                            // dict key type comes from the type parameter.
                            // Only flag when both sides are concrete and
                            // clearly disjoint kinds (int vs string is the
                            // common case).
                            let dkw = ti_walk(st, iwp[0])
                            let kw = ti_walk(st, idx_key)
                            let dk_kind = ""
                            let k_kind = ""
                            match dkw
                                NType(dkk, _, _, _) =>
                                    dk_kind = dkk
                            match kw
                                NType(kk, _, _, _) =>
                                    k_kind = kk
                            let dk_concrete = dk_kind == "int" or dk_kind == "string" or dk_kind == "float" or dk_kind == "bool"
                            let k_concrete = k_kind == "int" or k_kind == "string" or k_kind == "float" or k_kind == "bool"
                            if dk_concrete and k_concrete and dk_kind != k_kind
                                let dk_num = dk_kind == "int" or dk_kind == "float" or dk_kind == "bool"
                                let k_num = k_kind == "int" or k_kind == "float" or k_kind == "bool"
                                if not (dk_num and k_num)
                                    ti_error(st, "dict has key type " + ti_type_str(dkw) + ", but index is of type " + ti_type_str(kw), eline)
                return nt_any()
            if tag == "member"
                if len(children) > 0
                    let obj_t = ti_infer_expr(st, children[0])
                    let walked = ti_walk(st, obj_t)
                    match walked
                        NType(wk, wn, wp, wi) =>
                            if wk == "struct" and wn != "" and contains(st.ti_structs, wn)
                                let fields = st.ti_structs[wn]
                                if not contains(fields, value)
                                    ti_error(st, "struct " + ti_type_str(walked) + " has no field '" + value + "'", eline)
                                else
                                    return fields[value]
                            else if wk == "int" or wk == "float" or wk == "bool" or wk == "range"
                                ti_error(st, "type " + ti_type_str(walked) + " has no field '" + value + "' (field access requires a struct)", eline)
                return nt_any()
            if tag == "if"
                let cond = ti_infer_expr(st, children[0])
                ti_constrain(st, cond, nt_bool(), eline)
                if len(children) > 1
                    let then_t = ti_infer_expr(st, children[1])
                    if len(children) > 2
                        let else_t = ti_infer_expr(st, children[2])
                        ti_constrain(st, then_t, else_t, eline)
                    return then_t
                return nt_any()
            if tag == "lambda"
                if len(children) > 0
                    let _tl = _expr_contains_try_unwrap(children[0])
                    if _tl > 0
                        ti_error(st, "the `?` operator inside a lambda silently swallows errors instead of propagating them to the enclosing function. Use an explicit loop with `?`, or `prism_ui_collect`, or map + any_match(is_err) + map(unwrap) instead", _tl)
                return nt_any()
            if tag == "match"
                let m_subj = nt_any()
                if len(children) > 0
                    m_subj = ti_infer_expr(st, children[0])
                    // Resolve the subject's deferred constraints now so a Result/Option
                    // subject is seen as a concrete Sum when checking Ok/Err/Some/None
                    // patterns (ti_constrain only defers; ti_solve binds + clears).
                    ti_solve(st)
                let ex_pats = []
                let ex_guarded = []
                let m_result = nt_any()
                let m_first = true
                let mci = 1
                while mci < len(children)
                    match children[mci]
                        Expr(xat, xav, xan, xac, xaf, xal) =>
                            if xat == "arm" and len(xac) > 0
                                push(ex_pats, xac[0])
                                // 2.9: guard is the arm's THIRD child in the match-EXPRESSION
                                // form (parse_match_expr ~2101); a guarded arm may not fire so it
                                // cannot count as covering its variant's payload.
                                let _exg2 = 0
                                if len(xac) > 2
                                    match xac[2]
                                        Expr(_eg2t, _eg2v, _eg2n, _eg2c, _eg2f, _eg2l) =>
                                            if _eg2t != "null"
                                                _exg2 = 1
                                push(ex_guarded, _exg2)
                                ti_push_scope(st)
                                ti_infer_pattern(st, xac[0], m_subj)
                                let m_armt = nt_any()
                                if len(xac) > 1
                                    m_armt = ti_infer_expr(st, xac[1])
                                ti_pop_scope(st)
                                if m_first
                                    m_result = m_armt
                                    m_first = false
                                else
                                    ti_unify_arms(st, m_result, m_armt, xal)
                    mci = mci + 1
                ti_check_exhaustive_g(st, ex_pats, ex_guarded, eline)
                return m_result
            if tag == "for"
                return nt_any()
            if tag == "try"
                if len(children) > 0
                    return ti_infer_expr(st, children[0])
                return nt_any()
            if tag == "unsafe"
                if len(children) > 0
                    st.ti_unsafe_depth = st.ti_unsafe_depth + 1
                    let unsafe_t = ti_infer_expr(st, children[0])
                    st.ti_unsafe_depth = st.ti_unsafe_depth - 1
                    return unsafe_t
                return nt_any()
            if tag == "try_unwrap"
                // x? on a Result<T,E> (= Sum<T,E>) yields the ok type T; the error
                // path is an implicit early-return handled by codegen. On a non-Sum
                // operand we fall back to `any` (unchanged, keeps existing code valid).
                if len(children) > 0
                    let inner_t = ti_walk(st, ti_infer_expr(st, children[0]))
                    match inner_t
                        NType(ik, inm, ipar, iid) =>
                            if ik == "sum" and len(ipar) >= 1
                                return ipar[0]
                return nt_any()
            if tag == "catch"
                let catch_t = nt_any()
                if len(children) > 0
                    catch_t = ti_infer_expr(st, children[0])
                ti_push_scope(st)
                if value != ""
                    ti_define(st, value, ti_mono(nt_string()))
                if num > 0
                    for s in fields
                        ti_infer_stmt(st, s)
                else if len(children) > 1
                    ti_infer_expr(st, children[1])
                ti_pop_scope(st)
                return catch_t
            if tag == "pair"
                if len(children) > 1
                    return ti_infer_expr(st, children[1])
                return nt_any()
            return nt_any()
    nt_any()

// ── ORM compile-time column verification (the struct IS the schema) ──────────
// A typed ORM read carries BOTH halves of the contract at compile time: the SQL string literal and the
// target struct. Every other ORM discovers a mistyped column at RUNTIME (JPA/Hibernate), or needs a LIVE
// database at build time to check it (sqlx). NOVA needs neither -- the struct already IS the schema, so
// verifying `SELECT id, nmae FROM ...` against `list<Widget>` is a pure compile-time string comparison.
//
// SCOPED SO FALSE POSITIVES ARE IMPOSSIBLE, because a spurious compile error on valid SQL would be worse
// than the bug it catches:
//   * only an explicit SELECT list is inspected -- `SELECT *` is skipped entirely
//   * only a BARE identifier is considered. Anything containing '(', '.', a space, '*' or a quote is an
//     aggregate, a qualified column, an alias or an expression, and is skipped
//   * a column merely ABSENT from the struct is NOT reported. Selecting extra columns is legal and a
//     deliberate projection must keep compiling. It is reported ONLY when it is within edit-distance 1
//     of a real field -- i.e. almost certainly a typo.
// Net effect: a pure typo catcher that cannot fire on correct code.

// Index of the SQL argument for the ORM reads that take a full statement, or -1.
// Deliberately NOT orm_exec/orm_each: this check only makes sense where a target STRUCT is known.
fn _orm_sql_arg_of(fname: string) -> int
    if fname == "orm_all" or fname == "orm_rows" or fname == "orm_row" or fname == "orm_one"
        return 1
    -1

// The text between SELECT and FROM, or "" when this is not an inspectable SELECT.
fn _orm_select_list(sql: string) -> string
    let up = upper(sql)
    let t = trim(up)
    if not starts_with(t, "SELECT ")
        return ""
    let fi = find(up, " FROM ")
    if fi < 0
        return ""
    let si = find(up, "SELECT")
    if si < 0 or si + 6 >= fi
        return ""
    // slice the ORIGINAL (case-preserving) string over the offsets found in the upper-cased copy;
    // upper() must not change length for this to be sound, which holds for ASCII SQL keywords.
    trim(sql[si + 6:fi])

// A SELECT-list item reduced to a plain column name, or "" when it is not checkable.
fn _orm_plain_col(item: string) -> string
    let t = trim(item)
    if len(t) == 0
        return ""
    if find(t, "(") >= 0 or find(t, ".") >= 0 or find(t, " ") >= 0 or find(t, "*") >= 0
        return ""
    if find(t, "\"") >= 0 or find(t, "`") >= 0 or find(t, "'") >= 0
        return ""
    t

// Strip one layer of `list<...>` from an annotation, so both `let x: T` and `let xs: list<T>` resolve to T.
fn _orm_elem_of_ann(ann: string) -> string
    if len(ann) > 6 and ann[0:5] == "list<" and ann[len(ann) - 1:len(ann)] == ">"
        return ann[5:len(ann) - 1]
    ann

// Is `a` `b` with exactly ONE adjacent pair swapped? ("nmae" vs "name")
// Plain Levenshtein scores a transposition as TWO edits, so an edit-distance-1 test misses the single
// most common class of typo. Widening the threshold to 2 instead would start matching genuinely
// different short names ("ip" vs "id"), so transposition is detected exactly rather than approximated.
fn _orm_is_transposition(a: string, b: string) -> bool
    if len(a) != len(b) or len(a) < 2
        return false
    let i = 0
    while i < len(a) and a[i:i + 1] == b[i:i + 1]
        i = i + 1
    if i + 1 >= len(a)
        return false
    if a[i:i + 1] != b[i + 1:i + 2] or a[i + 1:i + 2] != b[i:i + 1]
        return false
    // everything after the swapped pair must match exactly
    a[i + 2:len(a)] == b[i + 2:len(b)]

// The struct field a mistyped column most likely meant, or "" when nothing is close enough.
fn _orm_near_field(col: string, fields: list) -> string
    // Very short names are the riskiest false-positive class: "ip" is one edit from "id" but may well be
    // a real column the struct simply does not map. Below 3 characters, stay silent.
    if len(col) < 3
        return ""
    for f in fields
        if edit_distance(col, f) == 1
            return f
    for f2 in fields
        if _orm_is_transposition(col, f2)
            return f2
    ""

// Report a mistyped column in a typed ORM read. `sname` is a struct known to st.ti_structs.
fn _orm_check_cols(st: TiState, sname: string, sql: string, line: int)
    let sel = _orm_select_list(sql)
    if sel == ""
        return
    if find(sel, "*") >= 0
        return
    let fields = keys(st.ti_structs[sname])
    if len(fields) == 0
        return
    for item in split(sel, ",")
        let col = _orm_plain_col(item)
        if col != ""
            if not list_contains(fields, col)
                // absent-but-unlike-any-field is a legal projection -> silent. Only a NEAR MISS is a typo.
                let best = _orm_near_field(col, fields)
                if best != ""
                    ti_error_full(st, "E1013", "column '" + col + "' does not exist on struct '" + sname + "'", line, "did you mean '" + best + "'? (the struct IS the schema -- verified at compile time, no database needed)")

// Entry point from the typed-let path: fires only for a `let x: T = orm_*(db, "<literal sql>", ...)`.
fn _orm_verify_typed_read(st: TiState, ann: string, e: Expr, line: int)
    let sname = _orm_elem_of_ann(ann)
    if not contains(st.ti_structs, sname)
        return
    match e
        Expr(oet, oev, oen, oec, oef, oel) =>
            if oet == "call"
                let ai = _orm_sql_arg_of(oev)
                // Phase 2.3 (W2002): fires only once we know `e` is a genuine typed ORM read call
                // (ai >= 0 recognizes orm_all/orm_rows/orm_row/orm_one) -- gating on that, not just
                // on the LHS annotation naming a known struct, avoids warning on unrelated code like
                // `let cached: list<Item> = cache.get(i)` inside a loop.
                if st.ti_orm_loop_depth > 0 and ai >= 0
                    ti_warn_full(st, "W2002", "ORM query inside a loop -- potential N+1 problem (each iteration runs a separate database round trip)", line, "use orm_in/batch query outside the loop, or orm_spec().in_(...) to fetch all rows in one query")
                if ai >= 0 and len(oec) > ai
                    match oec[ai]
                        Expr(set_, sev, sen, sec, sef, sel2) =>
                            // only a STRING LITERAL can be checked; an interpolated or computed SQL
                            // expression is not knowable here and is left alone.
                            if set_ == "str"
                                _orm_check_cols(st, sname, sev, line)
                                // NOTE: this only fires when `ann` names a known struct (the early
                                // return above) -- inherited from the typed-read path this rides on.
                                // A construct- or dialect-only lint would ideally run for every ORM
                                // call regardless of annotation, but that needs its own call site
                                // wired independently of the column-verification struct lookup;
                                // out of scope here per the task spec.
                                _orm_dialect_lint(st, sev, line)

// Phase 2.4 (W2003): static AST walk of an `orm_with_tx(db, fn(tx) ...)` lambda body, looking for
// ORM calls whose first argument is the OUTER `db` identifier instead of the transaction parameter.
// Using the outer connection inside the callback bypasses the transaction entirely -- the write
// lands on a different pooled connection and is never part of the commit/rollback. This is a
// conservative NAME match (not a value/alias analysis): it only fires when the literal identifier
// passed as the first argument to the ORM call is spelled the same as the outer `db` argument.
fn _orm_check_tx_escape(st: TiState, call_children: list, line: int)
    if len(call_children) < 2
        return
    let db_name = ""
    match call_children[0]
        Expr(dt, dv, dn, dc, df, dl) =>
            if dt == "ident"
                db_name = dv
    if db_name == ""
        return
    match call_children[1]
        Expr(lt, lv, ln2, lc, lf, ll) =>
            if lt == "lambda" and len(lc) > 0
                _orm_scan_body_for_escape(st, lc[0], db_name, line)

fn _orm_scan_body_for_escape(st: TiState, body: Expr, db_name: string, line: int)
    match body
        Expr(bt, bv, bn, bc, bf, bl) =>
            if bt == "call"
                let is_orm = starts_with(bv, "orm_") or bv == "db_all" or bv == "db_exec" or bv == "db_exec_raw" or bv == "db_query" or bv == "db_row"
                if is_orm and len(bc) > 0
                    match bc[0]
                        Expr(at, av, an, ac, af, al) =>
                            if at == "ident" and av == db_name
                                ti_warn_full(st, "W2003", "using outer connection '" + db_name + "' inside orm_with_tx -- this BYPASSES the transaction (writes go to a different connection)", bl, "use the transaction parameter instead of '" + db_name + "'")
            // NOTE: only `children` is walked, never `fields` -- `fields` holds Stmt (not Expr)
            // objects for a block-bodied `catch`, and Expr idents (lambda params) elsewhere; neither
            // is a useful or type-safe thing to recurse into here. Mirrors collect_free_vars_inner's
            // established, proven-safe walk (children only, `fields` handled per-tag if at all).
            for child in bc
                _orm_scan_body_for_escape(st, child, db_name, line)

// Non-portable SQL constructs measured on live servers -- warn (never error), so a legitimate
// dialect-specific query (see _kat_pg_copy.nova's PostgreSQL-only `||` + generate_series) still
// compiles. One warning per construct found; all under code W2001.
fn _orm_dialect_lint(st: TiState, sql: string, line: int)
    if find(sql, "||") >= 0
        ti_warn_full(st, "W2001", "`||` is string concatenation on sqlite/postgres but LOGICAL OR on mysql (returns 0)", line, "use CONCAT(a, b) -- portable across all three dialects")
    let up = upper(sql)
    if find(up, "NOW()") >= 0
        ti_warn_full(st, "W2001", "`NOW()` does not exist on sqlite (the query returns 0 rows)", line, "use CURRENT_TIMESTAMP -- portable across all three dialects")
    if find(up, "ILIKE") >= 0
        ti_warn_full(st, "W2001", "`ILIKE` does not exist on mysql (the query errors)", line, "use LOWER(col) LIKE ? with a lower-cased parameter -- portable across all three")

// ── Statement inference ──────────────────────────────────────────────────────

fn ti_infer_stmt(st: TiState, stmt: Stmt) -> NType
    ti_infer_stmt_inner(st, stmt)

fn ti_infer_stmt_inner(st: TiState, stmt: Stmt) -> NType
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "fn"
                let saved_fn = st.ti_in_fn
                st.ti_in_fn = name
                let gnames = ti_extract_generics(annotations)
                let gbounds = ti_extract_bounds(annotations)
                let gmap = {}
                for gn in gnames
                    gmap[gn] = ti_fresh(st)
                if len(gbounds) > 0
                    let fn_bounds = {}
                    let pbi = 0
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                if ptype != "" and contains(gbounds, ptype)
                                    fn_bounds[str(pbi)] = gbounds[ptype]
                        pbi = pbi + 1
                    if len(fn_bounds) > 0
                        st.ti_fn_bounds[name] = fn_bounds
                let param_types = []
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            let pt = ti_fresh(st)
                            if ptype != "" and ptype != "any"
                                pt = ti_ann_to_type_g(st, ptype, gmap)
                            push(param_types, pt)
                let ret_var = ti_fresh(st)
                // TIER 1: a function with NO concrete return annotation is "open" -> its return type
                // is inferred with a DEFERRED tolerant join (heterogeneous returns widen to `any`).
                // An explicit annotation (`-> int` OR `-> any`) constrains ret_var and is strict.
                let ret_open = true
                match expr
                    Expr(rxt, rxv, rxn, rxc, rxf, rxl) =>
                        if rxt == "rettype" and rxv != ""
                            // Constrain ret_var to the annotation for BOTH concrete types AND `any`.
                            // (Previously `-> any` was skipped, leaving ret_var a free var that bound
                            // to the first return and then FALSE-conflicted with heterogeneous returns.)
                            let ann_t = ti_ann_to_type_g(st, rxv, gmap)
                            ti_constrain(st, ret_var, ann_t, sline)
                            ret_open = false
                let fn_type = nt_fn(param_types, ret_var)
                let fn_name = name
                if fn_name == "main"
                    fn_name = "nova_user_main"
                let has_pre = false
                let scope_i = len(st.ti_scope) - 1
                while scope_i >= 0
                    if contains(st.ti_scope[scope_i], name)
                        has_pre = true
                        scope_i = -1
                    scope_i = scope_i - 1
                if has_pre
                    let pre_t = ti_lookup(st, name, sline)
                    ti_unify(st, fn_type, pre_t, sline)
                let fn_scheme = ti_mono(fn_type)
                ti_define(st, name, fn_scheme)
                let saved_ret = st.ti_ret_var
                st.ti_ret_var = ret_var
                let saved_ret_open = st.ti_ret_open
                st.ti_ret_open = ret_open
                let saved_ret_seen = st.ti_ret_seen
                st.ti_ret_seen = []
                ti_push_scope(st)
                let pi = 0
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            ti_define(st, pname, ti_mono(param_types[pi]))
                            pi = pi + 1
                let last_t = nt_unit()
                for s in body
                    last_t = ti_infer_stmt(st, s)
                let is_nothing = false
                match last_t
                    NType(lk, ln, lp, li) =>
                        if lk == "nothing"
                            is_nothing = true
                if not is_nothing
                    ti_ret_collect(st, ret_var, last_t, sline, ret_open)
                unused_check_function(body, params, name, st)
                break_continue_check(body, st)
                ti_pop_scope(st)
                st.ti_ret_var = saved_ret
                st.ti_ret_open = saved_ret_open
                // Capture this fn's collected returns, restore the outer fn's list, THEN solve.
                let my_ret_seen = st.ti_ret_seen
                st.ti_ret_seen = saved_ret_seen
                ti_solve(st)
                // TIER 1: now that ti_solve has resolved the return-expr vars, join them and bind
                // ret_var (open fns only; annotated fns already constrained ret_var strictly). If the
                // join widened to `any` because the returns genuinely DISAGREE, record the fn as
                // heterogeneous so the IR frt fixpoint keeps it `any` (correct print/box dispatch).
                if ret_open
                    let _het = ti_ret_join_bind(st, ret_var, my_ret_seen, sline)
                    if _het
                        st.ti_fn_hetero[fn_name] = 1
                let _mu_tail_set = {}
                if len(body) > 0
                    match body[len(body) - 1]
                        Stmt(_mlt, _mln, _mle, _mlb, _mlp, _mleb, _mla, _mls) =>
                            _mu_tail_set[_mls] = 1
                            if _mlt == "match"
                                _mu_tail_set = _ti_match_arm_tails(_mlb, _mu_tail_set)
                let _mu_i = 0
                while _mu_i < len(st.ti_must_use)
                    let _mu = st.ti_must_use[_mu_i]
                    let _mu_line = _mu[0]
                    if not contains(_mu_tail_set, _mu_line)
                        let _mu_name = _mu[1]
                        let _mu_resolved = ti_walk(st, _mu[2])
                        match _mu_resolved
                            NType(_mu_k, _mu_n, _mu_p, _mu_id) =>
                                if _mu_k == "sum"
                                    ti_error(st, "Result of '" + str(_mu_name) + "()' is unused -- handle the error, bind with `let`, propagate with `?`, or write `_ = " + str(_mu_name) + "(...)` to discard", _mu_line)
                    _mu_i = _mu_i + 1
                st.ti_must_use = []
                ti_define(st, name, ti_mono(nt_any()))
                let resolved = ti_zonk(st, fn_type)
                ti_define(st, name, ti_generalize(st, resolved))
                st.ti_fn_types[fn_name] = ti_to_ir_kind(ti_apply(st, ret_var))
                st.ti_fn_defer[name] = [fn_type, ret_var, fn_name]
                let min_ar = 0
                // 1.8: defaults MUST be trailing. The arity logic counts params with no default, so
                // `fn f(a, b = 5, c)` yields min_arity 2 and a call `f(x, y)` passes the check -- but
                // `y` binds POSITIONALLY to `b` and `c` is padded with a fresh type var that no
                // default can fill. Nothing rejected this; Python raises SyntaxError at def time and
                // C++ rejects it at declaration. Fail closed here, once, at registration. Variadic
                // rest params (`T...`) are exempt: a rest param is legitimately last and optional.
                let _da_seen_default = false
                let _da_bad = ""
                for mp in params
                    match mp
                        Param(mpn, mpt, mpd) =>
                            match mpd
                                Expr(mdt, mdv, mdn, mdc, mdf, mdl) =>
                                    if mdt == "null"
                                        min_ar = min_ar + 1
                                        if _da_seen_default and not ends_with(mpt, "...") and _da_bad == ""
                                            _da_bad = mpn
                                    else
                                        _da_seen_default = true
                if _da_bad != ""
                    ti_error(st, "parameter '" + _da_bad + "' has no default but follows a parameter that does; every defaulted parameter must come last", sline)
                st.ti_min_arity[name] = min_ar
                // NAMED ARGS: record the declared parameter ORDER so an out-of-order
                // call can be reordered BEFORE unification. The IR lowering already
                // reorders (via ir_fn_defaults) but the type checker did NOT, so
                // `f(b: 2, a: 1)` was type-checked POSITIONALLY and reported a bogus
                // mismatch whenever the two params had different types. With SAME-typed
                // params it type-checked and then ran correctly, which is why the gap
                // looked like it did not exist.
                let _pn_list = []
                for _pnp in params
                    match _pnp
                        Param(_pnn, _pnt, _pnd) =>
                            push(_pn_list, _pnn)
                st.ti_fn_pnames[name] = _pn_list
                // variadic fn: last param `T...` -> rest is optional, so min = fixed count
                if len(params) > 0
                    match params[len(params) - 1]
                        Param(vpn, vpt, vpd) =>
                            if ends_with(vpt, "...")
                                let fixed_ar = len(params) - 1
                                st.ti_variadic[name] = fixed_ar
                                st.ti_min_arity[name] = fixed_ar
                st.ti_in_fn = saved_fn
                return nt_unit()
            if tag == "extern_fn"
                return nt_unit()
            if tag == "type_alias"
                // Aliases are registered in the pre-scan; nothing to infer here.
                return nt_unit()
            if tag == "type"
                let tgnames = ti_extract_generics(annotations)
                let tgmap = {}
                for tgn in tgnames
                    tgmap[tgn] = ti_fresh(st)
                let field_map = {}
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            field_map[pname] = ti_ann_to_type_g(st, ptype, tgmap)
                st.ti_structs[name] = field_map
                let field_types = []
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            push(field_types, ti_ann_to_type_g(st, ptype, tgmap))
                let ctor_type = nt_fn(field_types, nt_struct(name))
                ti_solve(st)
                let resolved_ctor = ti_zonk(st, ctor_type)
                ti_define(st, name, ti_generalize(st, resolved_ctor))
                for ann in annotations
                    match ann
                        Expr(at, av, an2, ac, af, al) =>
                            if at == "impl_trait"
                                if not contains(st.ti_type_traits, name)
                                    st.ti_type_traits[name] = {}
                                st.ti_type_traits[name][av] = sline
                            if at == "ann" and av == "opaque"
                                st.ti_opaque_types[name] = 1
                return nt_unit()
            if tag == "enum"
                for variant in body
                    match variant
                        Stmt(vtag, vname, vexpr, vbody, vparams, velse, vann, vln) =>
                            if vtag == "type"
                                let vfield_map = {}
                                for vp in vparams
                                    match vp
                                        Param(vpname, vptype, vpdefault) =>
                                            vfield_map[vpname] = ti_ann_to_type_g(st, vptype, {})
                                st.ti_structs[vname] = vfield_map
                                let vfield_types = []
                                for vp in vparams
                                    match vp
                                        Param(vpname, vptype, vpdefault) =>
                                            push(vfield_types, ti_ann_to_type_g(st, vptype, {}))
                                // AN ENUM VARIANT IS A VALUE OF ITS ENUM.
                                //
                                // This constructor used to be typed `-> nt_struct(<variant name>)`,
                                // making each variant its own opaque type distinct from the enum it
                                // belongs to. An annotation naming the ENUM could therefore never
                                // accept one:
                                //
                                //     enum PtrFail
                                //         NoKey(string)
                                //     fn render(f: PtrFail) -> string
                                //     render(NoKey("k"))
                                //     -> error[E1001]: expected PtrFail, found NoKey
                                //
                                // The same for `-> PtrFail` returns. The only way to write an ADT
                                // helper was to leave its parameter and return UNTYPED -- which is
                                // what NOVA_LANGUAGE_FEATURES.md's own enum example does, and it
                                // gives up checking at every ADT boundary in the language.
                                //
                                // The variant name is a TAG, not a type. Variant identity is
                                // unaffected: `match` dispatches on the runtime tag via
                                // ti_variant_enum, exhaustiveness still reads ti_enum_variants, and
                                // payload binders still take their declared types from
                                // ti_variant_ptypes. The variant's own field map remains registered
                                // under its own name (st.ti_structs[vname] above), so field access
                                // is unchanged. `name` here is the enclosing enum's name.
                                let vctor_type = nt_fn(vfield_types, nt_struct(name))
                                ti_define(st, vname, ti_mono(vctor_type))
                return nt_unit()
            if tag == "assign"
                let rhs = ti_infer_expr(st, expr)
                // typed let: `let x: T = e` — check e against T and bind x at T
                if len(params) > 0
                    match params[0]
                        Param(la_pn, la_pty, la_pd) =>
                            if la_pty != ""
                                let la_ann = ti_ann_to_type_g(st, la_pty, {})
                                if expr != null_expr()
                                    ti_constrain(st, la_ann, rhs, sline)
                                    // ORM: the annotation names the target STRUCT and the call carries the
                                    // SQL literal, so a mistyped column is catchable HERE -- at compile
                                    // time, with no live database. See _orm_verify_typed_read.
                                    _orm_verify_typed_read(st, la_pty, expr, sline)
                                rhs = la_ann
                if name != ""
                    // A `let` inside a fn SHADOWS a top-level `let` VARIABLE (a non-fn
                    // value binding in frame 0) instead of unifying with it -- that
                    // conflation (a fn's `let g` unified with a top-level `let g` of a
                    // DIFFERENT type) was the module-scope leak (order-dependent errors +
                    // the trait-multitype crash). But a frame-0 FUNCTION / type ctor /
                    // builtin (fn-typed scheme) still BLOCKS: a local must NOT silently
                    // shadow a global fn (shadowing those crashed forge_jwt_test). Any
                    // non-frame-0 frame (outer fn locals / captures) always blocks.
                    let in_local = false
                    let _fi2 = 0
                    while _fi2 < len(st.ti_scope)
                        if contains(st.ti_scope[_fi2], name)
                            let _blocks2 = true
                            if _fi2 == 0 and len(st.ti_scope) > 1
                                match st.ti_scope[0][name]
                                    NTypeScheme(_sq2, _sb2) =>
                                        match ti_walk(st, _sb2)
                                            NType(_sk2, _sn2, _sp2, _si2) =>
                                                if _sk2 != "fn"
                                                    _blocks2 = false
                            if _blocks2
                                in_local = true
                        _fi2 = _fi2 + 1
                    if not in_local
                        ti_define(st, name, ti_mono(rhs))
                    else
                        let existing = ti_lookup(st, name, sline)
                        let we = ti_walk(st, existing)
                        let we_is_unbound_any = false
                        match we
                            NType(wk, wn, wp, wi_id) =>
                                if wk == "any" and wn == ""
                                    we_is_unbound_any = true
                        if we_is_unbound_any
                            ti_define(st, name, ti_mono(rhs))
                        else
                            ti_constrain(st, existing, rhs, sline)
                    return nt_unit()
                else if len(annotations) > 0
                    let lhs_expr = annotations[0]
                    let lhs_is_ident = false
                    let lhs_ident_name = ""
                    match lhs_expr
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                lhs_is_ident = true
                                lhs_ident_name = ev
                    if lhs_is_ident
                        let in_local = false
                        for frame in st.ti_scope
                            if contains(frame, lhs_ident_name)
                                in_local = true
                        if not in_local
                            ti_define(st, lhs_ident_name, ti_mono(rhs))
                        else
                            let existing = ti_lookup(st, lhs_ident_name, sline)
                            let we = ti_walk(st, existing)
                            let we_is_unbound_any = false
                            match we
                                NType(wk, wn, wp, wi_id) =>
                                    if wk == "any" and wn == ""
                                        we_is_unbound_any = true
                            if we_is_unbound_any
                                ti_define(st, lhs_ident_name, ti_mono(rhs))
                            else
                                ti_constrain(st, existing, rhs, sline)
                    else
                        match lhs_expr
                            Expr(let2, lev2, len2, lec2, lef2, leln2) =>
                                if let2 == "tuple"
                                    for telem in lec2
                                        match telem
                                            Expr(tet, tev, ten, tec, tef, teln) =>
                                                if tet == "ident"
                                                    ti_define(st, tev, ti_mono(nt_any()))
                                else
                                    let lhs = ti_infer_expr(st, lhs_expr)
                                    ti_constrain(st, lhs, rhs, sline)
                return nt_unit()
            if tag == "compound_assign"
                let rhs = ti_infer_expr(st, expr)
                if len(annotations) > 0
                    let lhs = ti_infer_expr(st, annotations[0])
                    ti_constrain(st, lhs, rhs, sline)
                return nt_unit()
            if tag == "multi_assign"
                for _ms in body
                    ti_infer_stmt(st, _ms)
                return nt_unit()
            if tag == "spawn"
                // `pid = spawn fn() ...` binds the process handle to `name`.
                if name != ""
                    ti_define(st, name, ti_mono(nt_any()))
                return nt_unit()
            if tag == "expr"
                let rt = ti_infer_expr(st, expr)
                match expr
                    Expr(etag, evalue, enum_val, echildren, efields, eline) =>
                        if etag == "call"
                            push(st.ti_must_use, [sline, evalue, rt])
                return rt
            if tag == "return"
                match expr
                    Expr(et, ev, en, ec, ef, eln) =>
                        if et != "null" or ev != "" or en != 0
                            let rt = ti_infer_expr(st, expr)
                            ti_ret_collect(st, st.ti_ret_var, rt, sline, st.ti_ret_open)
                            return nt_nothing()
                return nt_nothing()
            if tag == "yield"
                ti_infer_expr(st, expr)
                return nt_unit()
            if tag == "defer"
                ti_infer_expr(st, expr)
                return nt_unit()
            if tag == "unsafe_block"
                // #4: raise the unsafe depth across the whole block so raw-memory builtins (and extern
                // calls) are permitted inside, then restore it. Scoped like any block body.
                st.ti_unsafe_depth = st.ti_unsafe_depth + 1
                ti_push_scope(st)
                // Yield the LAST statement's type, exactly as a plain block does. Returning
                // unit unconditionally made inference disagree with IR lowering, which already
                // propagates an unsafe block's value in tail position -- so a function whose
                // body ENDS in an `unsafe` block was rejected with "expected int, found unit"
                // even though the emitted code returned the right value.
                let _ub_last = nt_unit()
                for s in body
                    _ub_last = ti_infer_stmt(st, s)
                ti_pop_scope(st)
                st.ti_unsafe_depth = st.ti_unsafe_depth - 1
                return _ub_last
            if tag == "const"
                let ct = ti_infer_expr(st, expr)
                ti_define(st, name, ti_mono(ct))
                return nt_unit()
            if tag == "break" or tag == "continue"
                return nt_unit()
            if tag == "if"
                let cond = ti_infer_expr(st, expr)
                ti_constrain(st, cond, nt_bool(), sline)
                ti_push_scope(st)
                let last_t = nt_unit()
                for s in body
                    last_t = ti_infer_stmt(st, s)
                ti_pop_scope(st)
                if len(else_body) > 0
                    ti_push_scope(st)
                    let else_last_t = nt_unit()
                    for s in else_body
                        else_last_t = ti_infer_stmt(st, s)
                    ti_pop_scope(st)
                    // Branches must agree in value position. ti_unify_arms is
                    // tolerant: it skips when either side is unit/any/var/
                    // nothing, so a plain control-flow if (one branch prints,
                    // the other returns) still type-checks.
                    ti_unify_arms(st, last_t, else_last_t, sline)
                return last_t
            if tag == "while"
                let cond = ti_infer_expr(st, expr)
                ti_constrain(st, cond, nt_bool(), sline)
                ti_push_scope(st)
                for s in body
                    ti_infer_stmt(st, s)
                ti_pop_scope(st)
                if len(else_body) > 0
                    ti_push_scope(st)
                    for s in else_body
                        ti_infer_stmt(st, s)
                    ti_pop_scope(st)
                let is_infinite = false
                match expr
                    Expr(et, ev, en, ec, ef, el) =>
                        if et == "int" and en != 0
                            is_infinite = true
                        if et == "bool" and ev == "true"
                            is_infinite = true
                if is_infinite
                    return nt_nothing()
                return nt_unit()
            if tag == "for"
                let iter_t = ti_infer_expr(st, expr)
                let elem_var = ti_fresh(st)
                let wi = ti_walk(st, iter_t)
                match wi
                    NType(wk, wn, wp, wi_id) =>
                        if wk == "list" and len(wp) > 0
                            ti_constrain(st, elem_var, wp[0], sline)
                        else if wk == "range"
                            ti_constrain(st, elem_var, nt_int(), sline)
                        else if wk == "string"
                            ti_constrain(st, elem_var, nt_string(), sline)
                        else if wk == "dict" and len(wp) > 0
                            ti_constrain(st, elem_var, wp[0], sline)
                        else if wk == "channel" and len(wp) > 0
                            ti_constrain(st, elem_var, wp[0], sline)
                        else if wk == "int" or wk == "float" or wk == "bool" or wk == "struct" or wk == "process"
                            ti_error(st, "cannot iterate over type " + ti_type_str(wi) + "; for-loop expects list, dict, string, range, or channel", sline)
                ti_push_scope(st)
                ti_define(st, name, ti_mono(elem_var))
                st.ti_orm_loop_depth = st.ti_orm_loop_depth + 1
                for s in body
                    ti_infer_stmt(st, s)
                ti_pop_scope(st)
                st.ti_orm_loop_depth = st.ti_orm_loop_depth - 1
                if len(else_body) > 0
                    ti_push_scope(st)
                    for s in else_body
                        ti_infer_stmt(st, s)
                    ti_pop_scope(st)
                return nt_unit()
            if tag == "match"
                let subj = ti_infer_expr(st, expr)
                // Resolve the subject's deferred constraints now (ti_constrain only
                // defers) so a Result/Option subject is a concrete Sum when checking
                // Ok/Err/Some/None patterns in ti_infer_pattern.
                ti_solve(st)
                let match_t = nt_unit()
                let match_first = true
                let ex_pats = []
                let ex_guarded = []
                for arm in body
                    match arm
                        Stmt(at, an, ae, abody, ap, aeb, aann, asln) =>
                            if at == "arm"
                                push(ex_pats, ae)
                                // 2.9: a GUARDED arm may not fire, so it cannot be counted as
                                // covering its variant's payload. The guard lives in
                                // annotations[0] (null_expr() when absent).
                                let _exg = 0
                                if len(aann) > 0
                                    match aann[0]
                                        Expr(_egt, _egv, _egn, _egc, _egf, _egl) =>
                                            if _egt != "null"
                                                _exg = 1
                                push(ex_guarded, _exg)
                                ti_push_scope(st)
                                ti_infer_pattern(st, ae, subj)
                                let arm_t = nt_unit()
                                for s in abody
                                    arm_t = ti_infer_stmt(st, s)
                                ti_pop_scope(st)
                                if match_first
                                    match_t = arm_t
                                    match_first = false
                                else
                                    ti_unify_arms(st, match_t, arm_t, asln)
                ti_check_exhaustive_g(st, ex_pats, ex_guarded, sline)
                // A match used as a function's last expression yields the
                // value of its arms; report the first arm's value type.
                return match_t
            if tag == "import"
                return nt_unit()
            if tag == "block"
                // A block normally opens a SCOPE. A desugaring that has to emit several
                // statements as one Stmt but whose bindings must stay visible to the code
                // AFTER it marks itself "transparent" in the (otherwise unused) name field.
                // Without this, `x = f() else return E` -- which lowers to bind/guard/assign
                // -- would define x inside the block and every later use of x would be
                // rejected as an unknown identifier. IR lowering is already transparent
                // (it shares the enclosing scope and opens no basic block), so inference
                // was the only place that needed to agree.
                let _blk_scoped = name != "transparent"
                if _blk_scoped
                    ti_push_scope(st)
                let last_t = nt_unit()
                for s in body
                    last_t = ti_infer_stmt(st, s)
                if _blk_scoped
                    ti_pop_scope(st)
                return last_t
            return nt_unit()
    nt_unit()

// ── Pattern inference (match arms) ───────────────────────────────────────────

fn ti_infer_pattern(st: TiState, pat: Expr, expected: NType)
    match pat
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "pat_var"
                // A bare identifier in a pattern is normally a binder, but it
                // may also name an enum variant (e.g. `match c { Red => ... }`
                // where Red is a niladic variant). In the variant case, the
                // subject must be of an enum/struct type — primitive subjects
                // are a soundness hole.
                if contains(st.ti_variant_enum, value)
                    let pv_w = ti_walk(st, expected)
                    match pv_w
                        NType(pvk, pvn, pvp, pvi) =>
                            if pvk == "int" or pvk == "float" or pvk == "bool" or pvk == "string" or pvk == "range" or pvk == "list" or pvk == "dict"
                                ti_error(st, "cannot match enum variant '" + value + "' against subject of type " + ti_type_str(pv_w), eline)
                ti_define(st, value, ti_mono(expected))
            else if tag == "pat_wild"
                return
            else if tag == "pat_tuple"
                let _tw = ti_walk(st, expected)
                let _telems = []
                match _tw
                    NType(_twk, _twn, _twp, _twi) =>
                        if _twk == "tuple"
                            for _te in _twp
                                push(_telems, _te)
                let _ti = 0
                for _tsp in children
                    if _ti < len(_telems)
                        ti_infer_pattern(st, _tsp, _telems[_ti])
                    else
                        ti_infer_pattern(st, _tsp, ti_fresh(st))
                    _ti = _ti + 1
            else if tag == "pat_lit"
                ti_constrain(st, expected, nt_int(), eline)
            else if tag == "pat_str"
                ti_constrain(st, expected, nt_string(), eline)
            else if tag == "pat_range"
                ti_constrain(st, expected, nt_int(), eline)
            else if tag == "pat_or"
                let _ori = 0
                while _ori < len(children)
                    ti_infer_pattern(st, children[_ori], expected)
                    _ori = _ori + 1
            else if tag == "pat_ctor"
                let pc_w = ti_walk(st, expected)
                // Built-in Result/Option sum-match: the subject is a Sum (or any/var
                // — e.g. list element via for-loop) and the constructor is
                // Ok/Err/Some/None (NOT shadowed by a same-named user enum variant).
                // Mark the pattern (num=1) so codegen compares the NovaResult TAG
                // (0=Ok/Some, 1=Err/None) rather than a type-name hash, and bind the
                // payload at the Sum's ok/err element type.
                let is_sum_match = false
                match pc_w
                    NType(pwk, pwn, pwp, pwi) =>
                        if (pwk == "sum" or pwk == "any" or pwk == "var") and not contains(st.ti_variant_enum, value)
                            if value == "Ok" or value == "Err" or value == "Some" or value == "None"
                                is_sum_match = true
                if is_sum_match
                    pat.num = 1
                    let payload_t = nt_any()
                    match pc_w
                        NType(pwk2, pwn2, pwp2, pwi2) =>
                            if (value == "Ok" or value == "Some") and len(pwp2) >= 1
                                payload_t = pwp2[0]
                            else if (value == "Err" or value == "None") and len(pwp2) >= 2
                                payload_t = pwp2[1]
                    for child in children
                        match child
                            Expr(ct, cv, cn, cc, cf, cln) =>
                                if ct == "pat_var"
                                    ti_define(st, cv, ti_mono(payload_t))
                                else if ct == "pat_ctor" or ct == "pat_tuple"
                                    // 2.1: `Ok(Some(x))` / `Err(MyErr(code))` -- recurse with the
                                    // sum's payload type so the inner pattern is checked and its
                                    // binders typed, rather than being silently ignored.
                                    ti_infer_pattern(st, child, payload_t)
                else
                    if contains(st.ti_variant_enum, value)
                        match pc_w
                            NType(pwk, pwn, pwp, pwi) =>
                                if pwk == "int" or pwk == "float" or pwk == "bool" or pwk == "string" or pwk == "range" or pwk == "list" or pwk == "dict"
                                    ti_error(st, "cannot match enum variant '" + value + "' against subject of type " + ti_type_str(pc_w), eline)
                    // enum payload typing: bind each positional payload binder to the variant's DECLARED field
                    // type (so payload misuse is caught) rather than a fresh var. Conservative — concrete types
                    // only; an empty/generic/unresolved annotation (kind "var") falls back to fresh (no regression).
                    let _pl_types = []
                    if contains(st.ti_variant_ptypes, value)
                        _pl_types = st.ti_variant_ptypes[value]
                    let _pl_i = 0
                    for child in children
                        match child
                            Expr(ct, cv, cn, cc, cf, cln) =>
                                if ct == "pat_var"
                                    let _bind_t = ti_fresh(st)
                                    if _pl_i < len(_pl_types) and _pl_types[_pl_i] != ""
                                        let _decl_t = ti_ann_to_type_g(st, _pl_types[_pl_i], {})
                                        match _decl_t
                                            NType(_dk, _dn, _dp, _di) =>
                                                if _dk != "var"
                                                    _bind_t = _decl_t
                                    ti_define(st, cv, ti_mono(_bind_t))
                                else if ct == "pat_ctor" or ct == "pat_tuple"
                                    // 2.1: a NESTED pattern in a payload position. Recurse with the
                                    // payload's DECLARED type as `expected`, so the inner ctor is
                                    // checked against the right enum and its own binders are typed.
                                    // Previously any non-pat_var child was silently skipped -- no
                                    // binding, no check -- which is why nesting had to be rejected at
                                    // the parser rather than merely being unsupported downstream.
                                    let _nest_t = nt_any()
                                    if _pl_i < len(_pl_types) and _pl_types[_pl_i] != ""
                                        _nest_t = ti_ann_to_type_g(st, _pl_types[_pl_i], {})
                                    ti_infer_pattern(st, child, _nest_t)
                        _pl_i = _pl_i + 1

// ── Match exhaustiveness check ───────────────────────────────────────────────

// ── 2.9: INNER exhaustiveness for NESTED constructor patterns ────────────────
//
// The outer check below verifies every variant of the scrutinee's enum is named by some
// arm. With 2.1 nested patterns that is no longer sufficient: `Wrap(IntVal(n))` and
// `Empty()` names both outer variants, so the outer check passes -- yet a
// `Wrap(StrVal(...))` value matches NO arm and falls through to "" silently, which is
// exactly the class of bug this campaign exists to remove.
//
// This is a focused version of Rust's usefulness algorithm rather than the full pattern
// matrix: group the arms by outer constructor, and for any constructor whose arms ALL
// destructure their payload with a nested ctor, require those nested ctors to cover the
// payload enum. That handles the shape real ADT code actually has (single-payload
// wrappers: Result-of-X, tree nodes, protocol frames).
//
// SOUND BY CONSTRUCTION -- it declines to check anything it cannot decide, so it can
// report a MISSING variant but never rejects a valid match. Every bail-out below is
// deliberate:
//   * a payload bound by a plain binder or `_` covers the whole payload -> nothing to check
//   * a GUARDED arm may not fire, so it is treated as covering everything (conservative;
//     the guard-vs-exhaustiveness hole is pre-existing and noted in the plan, not widened here)
//   * a variant with more than one payload field needs the cross-product of positions --
//     a real matrix -- so multi-field payloads are skipped rather than guessed
//   * inner ctors from different enums, or ones not in ti_variant_enum, are skipped
fn ti_check_nested_exhaustive(st: TiState, patterns: list, guarded: list, line: int)
    // outer ctor name -> the inner ctor names seen in its arms
    let nx_inner = {}
    // outer ctor name -> 1 when some arm covers that variant's payload wholesale
    let nx_open = {}
    let nx_names = []
    let nx_i = 0
    for pat in patterns
        match pat
            Expr(pt, pv, pn, pc, pf, pl) =>
                if pt == "pat_ctor"
                    if not contains(nx_inner, pv)
                        nx_inner[pv] = []
                        push(nx_names, pv)
                    let nx_g = false
                    if nx_i < len(guarded)
                        if guarded[nx_i] == 1
                            nx_g = true
                    if nx_g
                        nx_open[pv] = 1
                    else if len(pc) != 1
                        // 0 fields: nothing nested to check. >1 field: needs a real
                        // pattern matrix over positions -- decline.
                        nx_open[pv] = 1
                    else
                        match pc[0]
                            Expr(st0, sv0, sn0, sc0, sf0, sl0) =>
                                if st0 == "pat_ctor"
                                    push(nx_inner[pv], sv0)
                                else
                                    // binder / wildcard / literal in payload position
                                    nx_open[pv] = 1
        nx_i = nx_i + 1
    for nx_o in nx_names
        if not contains(nx_open, nx_o)
            let nx_list = nx_inner[nx_o]
            if len(nx_list) > 0
                // Every inner ctor must belong to ONE enum for the comparison to mean
                // anything; a mixed or unknown set is not decidable here.
                let nx_enum = ""
                let nx_ok = true
                for nx_c in nx_list
                    if contains(st.ti_variant_enum, nx_c)
                        let nx_e = st.ti_variant_enum[nx_c]
                        if nx_enum == ""
                            nx_enum = nx_e
                        else if nx_enum != nx_e
                            nx_ok = false
                    else
                        nx_ok = false
                if nx_ok and nx_enum != "" and contains(st.ti_enum_variants, nx_enum)
                    let nx_all = st.ti_enum_variants[nx_enum]
                    let nx_missing = []
                    for nx_v in nx_all
                        if not list_contains(nx_list, nx_v)
                            push(nx_missing, nx_v)
                    if len(nx_missing) > 0
                        let nx_msg = "non-exhaustive nested match: '" + nx_o + "' is only matched with "
                        let nx_j = 0
                        while nx_j < len(nx_list)
                            if nx_j > 0
                                nx_msg = nx_msg + ", "
                            nx_msg = nx_msg + nx_list[nx_j] + "(...)"
                            nx_j = nx_j + 1
                        nx_msg = nx_msg + ", so a '" + nx_o + "' holding "
                        let nx_k = 0
                        while nx_k < len(nx_missing)
                            if nx_k > 0
                                nx_msg = nx_msg + " or "
                            nx_msg = nx_msg + nx_missing[nx_k] + "(...)"
                            nx_k = nx_k + 1
                        nx_msg = nx_msg + " matches no arm and would fall through"
                        ti_error(st, nx_msg, line)

fn ti_check_exhaustive_g(st: TiState, patterns: list, guarded: list, line: int)
    ti_check_exhaustive(st, patterns, line)
    ti_check_nested_exhaustive(st, patterns, guarded, line)

fn ti_check_exhaustive(st: TiState, patterns: list, line: int)
    let ex_catchall = false
    let ex_covered = []
    let ex_enum = ""
    let ex_is_enum = true
    let has_ok = false
    let has_err = false
    let has_some = false
    let has_none = false
    for pat in patterns
        match pat
            Expr(pt, pv, pn, pc, pf, pl) =>
                if pt == "pat_wild"
                    ex_catchall = true
                else if pt == "pat_var"
                    if contains(st.ti_variant_enum, pv)
                        push(ex_covered, pv)
                        ex_enum = st.ti_variant_enum[pv]
                    else
                        ex_catchall = true
                else if pt == "pat_ctor"
                    if contains(st.ti_variant_enum, pv)
                        push(ex_covered, pv)
                        ex_enum = st.ti_variant_enum[pv]
                    else if pv == "Ok"
                        has_ok = true
                    else if pv == "Err"
                        has_err = true
                    else if pv == "Some"
                        has_some = true
                    else if pv == "None"
                        has_none = true
                    else
                        ex_is_enum = false
                else
                    ex_is_enum = false
    if ex_is_enum and not ex_catchall and ex_enum != ""
        let ex_all = st.ti_enum_variants[ex_enum]
        let ex_missing = []
        for ev in ex_all
            if not list_contains(ex_covered, ev)
                push(ex_missing, ev)
        if len(ex_missing) > 0
            let ex_msg = "non-exhaustive match on enum '" + ex_enum + "': missing "
            let emi = 0
            while emi < len(ex_missing)
                if emi > 0
                    ex_msg = ex_msg + ", "
                ex_msg = ex_msg + ex_missing[emi]
                emi = emi + 1
            ti_error(st, ex_msg, line)
    if not ex_catchall
        if (has_ok or has_err) and not (has_ok and has_err)
            if has_ok and not has_err
                ti_error(st, "non-exhaustive match on Result: missing Err(...) arm -- an unmatched Err will silently fall through", line)
            else
                ti_error(st, "non-exhaustive match on Result: missing Ok(...) arm -- an unmatched Ok will silently fall through", line)
        if (has_some or has_none) and not (has_some and has_none)
            if has_some and not has_none
                ti_error(st, "non-exhaustive match on Option: missing None arm -- an unmatched None will silently fall through", line)
            else
                ti_error(st, "non-exhaustive match on Option: missing Some(...) arm -- an unmatched Some will silently fall through", line)

// ── Resolved type to IR type kind ────────────────────────────────────────────

fn ti_to_ir_kind(t: NType) -> string
    match t
        NType(kind, name, params, id) =>
            if kind == "int" or kind == "bool"
                return "int"
            if kind == "float"
                return "float"
            if kind == "string"
                return "str"
            if kind == "list"
                return "list"
            if kind == "dict"
                return "dict"
            if kind == "struct"
                return "struct"
    "any"

// Like ti_to_ir_kind but preserves the struct NAME (e.g. "Point") for a struct —
// codegen needs the name to look up field types and type field access natively.
fn ti_to_ir_stype(t: NType) -> string
    match t
        NType(kind, name, params, id) =>
            if kind == "struct" and name != ""
                return name
    ti_to_ir_kind(t)

// ── Unused-variable analysis (catches typos like `counte = counter + 1`) ─────

fn unused_reads_expr(e: Expr, reads: dict)
    match e
        Expr(tag, value, num, children, fields, line) =>
            if tag == "ident"
                reads[value] = 1
            else if tag == "call"
                // Calling a fn-VALUE held in a local (`let f = ...; f()`) is a USE of
                // that local — the callee name must count as a read, else first-class
                // function values stored in locals falsely trip the unused-var check.
                // Harmless for global fn names (they match no local write).
                reads[value] = 1
            let ci = 0
            while ci < len(children)
                unused_reads_expr(children[ci], reads)
                ci = ci + 1
            let fi = 0
            while fi < len(fields)
                unused_reads_expr(fields[fi], reads)
                fi = fi + 1

fn unused_walk_stmt(s: Stmt, writes: dict, reads: dict)
    match s
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let skip_lhs_idx = -1
            if tag == "assign"
                if name != ""
                    if not contains(writes, name)
                        writes[name] = sline
                else if len(annotations) > 0
                    let lhs = annotations[0]
                    match lhs
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                if not contains(writes, ev)
                                    writes[ev] = sline
                                skip_lhs_idx = 0
            else if tag == "compound_assign"
                if len(annotations) > 0
                    let lhs = annotations[0]
                    match lhs
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                reads[ev] = 1
            else if tag == "for"
                reads[name] = 1
            else if tag == "spawn"
                if name != ""
                    if not contains(writes, name)
                        writes[name] = sline

            unused_reads_expr(expr, reads)
            let ai = 0
            while ai < len(annotations)
                if ai != skip_lhs_idx
                    unused_reads_expr(annotations[ai], reads)
                ai = ai + 1
            let bi = 0
            while bi < len(body)
                unused_walk_stmt(body[bi], writes, reads)
                bi = bi + 1
            let ebi = 0
            while ebi < len(else_body)
                unused_walk_stmt(else_body[ebi], writes, reads)
                ebi = ebi + 1
            let pi = 0
            while pi < len(params)
                match params[pi]
                    Param(ppn, ppt, ppd) =>
                        unused_reads_expr(ppd, reads)
                pi = pi + 1

// True if `name` is a module-level VARIABLE (a non-function binding in the global
// frame) — e.g. `let cache = {}` at top level. Reassigning one inside a function is a
// real side effect on shared state, so it must NOT trip the E1000 "assigned but never
// read" check (a reset function like `fn clear() { cache = {} }` is legitimate).
fn _ti_is_module_var(st: TiState, name: string) -> bool
    if len(st.ti_scope) == 0
        return false
    if not contains(st.ti_scope[0], name)
        return false
    match st.ti_scope[0][name]
        NTypeScheme(_mvq, _mvb) =>
            match ti_walk(st, _mvb)
                NType(_mvk, _mvn, _mvp, _mvi) =>
                    if _mvk != "fn"
                        return true
    return false

fn unused_check_function(body: list, params: list, fn_name: string, st: TiState)
    let writes = {}
    let reads = {}
    let param_names = {}
    let p_i = 0
    while p_i < len(params)
        match params[p_i]
            Param(ppn, ppt, ppd) =>
                param_names[ppn] = 1
        p_i = p_i + 1
    let i = 0
    while i < len(body)
        unused_walk_stmt(body[i], writes, reads)
        i = i + 1
    let wks = keys(writes)
    let ki = 0
    while ki < len(wks)
        let wn = wks[ki]
        if not contains(reads, wn) and not contains(param_names, wn) and not starts_with(wn, "_") and not _ti_is_module_var(st, wn)
            ti_error(st, "variable '" + wn + "' is assigned but never read (likely a typo)", writes[wn])
        ki = ki + 1

// ── break/continue context check ─────────────────────────────────────────────

fn break_continue_walk(s: Stmt, depth: int, st: TiState)
    match s
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "break" and depth == 0
                ti_error(st, "'break' is not allowed outside of a loop", sline)
            else if tag == "continue" and depth == 0
                ti_error(st, "'continue' is not allowed outside of a loop", sline)
            let new_depth = depth
            if tag == "for" or tag == "while"
                new_depth = depth + 1
            let bi = 0
            while bi < len(body)
                break_continue_walk(body[bi], new_depth, st)
                bi = bi + 1
            let ebi = 0
            while ebi < len(else_body)
                break_continue_walk(else_body[ebi], depth, st)
                ebi = ebi + 1

fn _ti_match_arm_tails(arms: list, tl: dict) -> dict
    let ai = 0
    while ai < len(arms)
        match arms[ai]
            Stmt(_at, _an, _ae, _ab, _ap, _aeb, _aa, _al) =>
                if len(_ab) > 0
                    match _ab[len(_ab) - 1]
                        Stmt(_bt, _bn, _be, _bb, _bp, _beb, _ba, _bl) =>
                            tl[_bl] = 1
                else
                    tl[_al] = 1
        ai = ai + 1
    tl

fn break_continue_check(body: list, st: TiState)
    let i = 0
    while i < len(body)
        break_continue_walk(body[i], 0, st)
        i = i + 1

// ── Track 8 Week 4: use-after-move check ────────────────────────────────────
// When NOVA_TRACK8=1, sending a variable on a channel transfers
// ownership: any later use of that variable in the same scope is a
// compile error. This catches the Rust-style "value moved here" / "used
// here after move" patterns at compile time. Opt-in so existing programs
// that send-then-print still compile in legacy mode.

fn move_expr_uses(e: Expr, moved: dict, errors: list)
    match e
        Expr(tag, value, num, children, fields, eline) =>
            // `send(ch, x)` — moves x. Don't traverse into the second arg
            // (its use IS the move; we add it to moved AFTER processing).
            if tag == "call" and value == "send" and len(children) >= 2
                // First arg (channel) is allowed to be a moved var? In
                // practice channels are values themselves; we conservatively
                // check it.
                move_expr_uses(children[0], moved, errors)
                match children[1]
                    Expr(at, av, an, ac, af, al) =>
                        if at == "ident" and contains(moved, av)
                            push(errors, "error[E1003]: value '" + av + "' used after move on line " + str(al))
                        else if at != "ident"
                            move_expr_uses(children[1], moved, errors)
                moved[move_arg_name(children[1])] = eline
                return 0
            if tag == "ident"
                if contains(moved, value)
                    push(errors, "error[E1003]: value '" + value + "' used after move on line " + str(eline) + " (moved earlier in this scope by send())")
                return 0
            for ch in children
                move_expr_uses(ch, moved, errors)

fn move_arg_name(e: Expr) -> string
    match e
        Expr(tag, value, _, _, _, _) =>
            if tag == "ident"
                return value
    ""

fn move_check_stmts(stmts: list, errors: list)
    let moved = {}
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "let" or tag == "assign"
                    if name != "" and contains(moved, name)
                        del(moved, name)
                    if expr != null_expr()
                        move_expr_uses(expr, moved, errors)
                else if tag == "expr"
                    if expr != null_expr()
                        move_expr_uses(expr, moved, errors)
                else if tag == "return"
                    if expr != null_expr()
                        move_expr_uses(expr, moved, errors)
                else if tag == "fn"
                    let fn_errs = []
                    move_check_stmts(body, fn_errs)
                    for fe in fn_errs
                        push(errors, fe)
                else if tag == "spawn"
                    // Fresh scope for the spawned process body
                    let sp_errs = []
                    move_check_stmts(body, sp_errs)
                    for se in sp_errs
                        push(errors, se)
                else if tag == "if" or tag == "while" or tag == "for"
                    if expr != null_expr()
                        move_expr_uses(expr, moved, errors)
                    let inner_errs = []
                    move_check_stmts(body, inner_errs)
                    for ie in inner_errs
                        push(errors, ie)
                    if len(else_body) > 0
                        let else_errs = []
                        move_check_stmts(else_body, else_errs)
                        for ee in else_errs
                            push(errors, ee)

fn move_check_program(stmts: list) -> list
    let errors = []
    move_check_stmts(stmts, errors)
    errors

// ── Main entry point: infer types for a parsed program ───────────────────────

fn ti_infer_program(stmts: list, source_lines: list) -> TiState
    ti_infer_program_named(stmts, source_lines, "")

fn ti_infer_program_named(stmts: list, source_lines: list, filename: string) -> TiState
    let st = ti_new_named(source_lines, filename)
    let seen_fns = {}
    // L11 collision detection: track the source module of each EXPORTED module fn name, so two
    // DIFFERENT modules exporting the same name are a clear error (not a silent last-wins in the
    // flat namespace / an opaque LLVM dup-symbol at link). Keyed by fn name -> source module path
    // (identity, so a re-import of the same module is not a false collision) + alias (for the message).
    let fn_src_path = {}
    let fn_src_mod = {}
    let base_dir = path_dir(filename)
    // Pre-scan transparent type aliases first, so any declaration (extern_fn,
    // fn signature, struct field) can resolve an alias regardless of where it
    // appears in source order. Aliases are compile-time-only synonyms.
    for alias_s in stmts
        match alias_s
            Stmt(a_tag, a_name, a_expr, a_body, a_params, a_else, a_anns, a_sln) =>
                if a_tag == "type_alias"
                    match a_expr
                        Expr(ae_t, ae_v, ae_n, ae_c, ae_f, ae_l) =>
                            if ae_t == "aliastype"
                                st.ti_aliases[a_name] = ae_v
    let si = 0
    while si < len(stmts)
        match stmts[si]
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "import"
                    let mod_alias = name
                    if len(annotations) > 0 and annotations[0] != ""
                        mod_alias = annotations[0]
                    let mod_path = resolve_module_file(name, base_dir)
                    if mod_path != ""
                        let mod_source = read_file(mod_path)
                        if len(mod_source) > 0
                            let mod_tokens = tokenize(mod_source)
                            let mod_pe = []
                            let mod_stmts = parse_program(mod_tokens, mod_pe)
                            let mod_fn_types = {}
                            for ms in mod_stmts
                                match ms
                                    Stmt(mtag, mname, mexpr, mbody, mparams, meb, man, msl) =>
                                        if mtag == "fn" and len(mname) > 0 and mname[0] != "_" and mname != "main"
                                            // (skip an imported module's main() -- it is not callable as a
                                            //  module API; the codegen excludes it too, see compile_module_ir)
                                            // Phase 0b soundness: type imported module fns with their REAL
                                            // annotated param + return types (was: all nt_any -> cross-module
                                            // calls were never type-checked, so a string passed where a
                                            // Response struct was expected compiled then segfaulted). gmap={}
                                            // keeps every type VAR-FREE, so the shared module fn_type cannot
                                            // be polluted across call sites. The any-vs-X escape in ti_unify
                                            // preserves loose/gradually-typed code (an arg the inferer types
                                            // as `any` still unifies with a typed param) -> only a CONCRETE
                                            // mismatch is rejected.
                                            // finding #4: type the imported fn's generic params through a
                                            // fresh-var gmap (mirroring the same-file mechanism ~13481-13485)
                                            // so a bare `T` / `Result<T,E>` param becomes a real type var,
                                            // then register a POLYMORPHIC scheme (below) instead of ti_mono.
                                            let mod_gnames = ti_extract_generics(man)
                                            let mod_gmap = {}
                                            for mgn in mod_gnames
                                                mod_gmap[mgn] = ti_fresh(st)
                                            let mod_param_types = []
                                            for mp in mparams
                                                match mp
                                                    Param(mpn, mpt, mpd) =>
                                                        if mpt != "" and mpt != "any"
                                                            push(mod_param_types, ti_ann_to_type_g(st, mpt, mod_gmap))
                                                        else
                                                            push(mod_param_types, nt_any())
                                            let mod_ret_t = nt_any()
                                            match mexpr
                                                Expr(mrt, mrv, mrn, mrc, mrf, mrl) =>
                                                    if mrt == "rettype" and mrv != "" and mrv != "any"
                                                        mod_ret_t = ti_ann_to_type_g(st, mrv, mod_gmap)
                                            let fn_type = nt_fn(mod_param_types, mod_ret_t)
                                            if contains(fn_src_path, mname) and fn_src_path[mname] != mod_path
                                                ti_error(st, "function '" + mname + "' is exported by two modules ('" + fn_src_mod[mname] + "' and '" + mod_alias + "') — NOVA modules share one flat namespace; rename one (e.g. prefix it with the module name)", msl)
                                            fn_src_path[mname] = mod_path
                                            fn_src_mod[mname] = mod_alias
                                            // finding #4: generic imported fns get a POLYMORPHIC scheme
                                            // (quantify the fresh generic vars, freshened per call site)
                                            // exactly like same-file fns (13593-13595); non-generic stay mono.
                                            if len(mod_gnames) > 0
                                                let mod_resolved = ti_zonk(st, fn_type)
                                                ti_define(st, mname, ti_generalize(st, mod_resolved))
                                            else
                                                ti_define(st, mname, ti_mono(fn_type))
                                            let _im_min_ar = 0
                                            for _im_mp in mparams
                                                match _im_mp
                                                    Param(_im_mpn, _im_mpt, _im_mpd) =>
                                                        match _im_mpd
                                                            Expr(_im_mdt, _im_mdv, _im_mdn, _im_mdc, _im_mdf, _im_mdl) =>
                                                                if _im_mdt == "null"
                                                                    _im_min_ar = _im_min_ar + 1
                                            st.ti_min_arity[mname] = _im_min_ar
                                            // ALSO record under the MODULE-QUALIFIED key. The bare key above is
                                            // shared with same-file fns, so a main-file `fn f(a, b=1)` and an
                                            // imported `fn f(a, b, c=2)` would fight over one slot and the
                                            // `mod.f(...)` arity gate would use the wrong minimum -- either a
                                            // false E1003 or (worse) a MISSED one, which then pads the missing
                                            // arg with a fresh var and lets an argument-less call through to
                                            // codegen. A `.` cannot occur in an identifier, so this key can
                                            // never collide with a bare fn name.
                                            st.ti_min_arity[mod_alias + "." + mname] = _im_min_ar
                                            // 1.9: an imported fn must also publish its declared param
                                            // ORDER and its variadic shape -- the module-call path needs
                                            // ti_fn_pnames to reorder a named-arg call before unifying,
                                            // and ti_variadic to collapse the trailing actuals into the
                                            // rest param's list. Neither was registered for imports, so
                                            // both features silently worked same-file only.
                                            let _im_pn = []
                                            for _im_pp in mparams
                                                match _im_pp
                                                    Param(_im_ppn, _im_ppt, _im_ppd) =>
                                                        push(_im_pn, _im_ppn)
                                            st.ti_fn_pnames[mname] = _im_pn
                                            if len(mparams) > 0
                                                match mparams[len(mparams) - 1]
                                                    Param(_im_vpn, _im_vpt, _im_vpd) =>
                                                        if ends_with(_im_vpt, "...")
                                                            let _im_fix = len(mparams) - 1
                                                            st.ti_variadic[mname] = _im_fix
                                                            st.ti_min_arity[mname] = _im_fix
                                                            st.ti_min_arity[mod_alias + "." + mname] = _im_fix
                                            mod_fn_types[mname] = fn_type
                                            // L11/finding-#2: an imported `Type__method` fn must ALSO register in
                                            // ti_type_methods, exactly like a main-file method (~14507), so the
                                            // method-call resolver finds it. Without this, an imported method
                                            // named like a builtin HOF (Query.map/sum/reduce/filter) missed the
                                            // ti_type_methods scan, fell through to the builtin-HOF branch, and
                                            // clashed ("container element types must match") on the first call.
                                            let _im_dunder = find(mname, "__")
                                            if _im_dunder > 0
                                                let _im_type = slice(mname, 0, _im_dunder)
                                                let _im_method = slice(mname, _im_dunder + 2, len(mname))
                                                if not contains(st.ti_type_methods, _im_type)
                                                    st.ti_type_methods[_im_type] = []
                                                if not list_contains(st.ti_type_methods[_im_type], _im_method)
                                                    push(st.ti_type_methods[_im_type], _im_method)
                                        if mtag == "enum"
                                            let _ie_vnames = []
                                            for _ie_v in mbody
                                                match _ie_v
                                                    Stmt(_ievt, _ievn, _ieve, _ievb, _ievp, _ieveb, _ievan, _ievln) =>
                                                        if _ievt == "type"
                                                            push(_ie_vnames, _ievn)
                                                            st.ti_variant_enum[_ievn] = mname
                                                            let _ie_vpts = []
                                                            for _ie_vp in _ievp
                                                                match _ie_vp
                                                                    Param(_ie_vpn, _ie_vpt, _ie_vpd) =>
                                                                        push(_ie_vpts, _ie_vpt)
                                                            st.ti_variant_ptypes[_ievn] = _ie_vpts
                                                            let _ie_vfm = {}
                                                            for _ie_vfp in _ievp
                                                                match _ie_vfp
                                                                    Param(_ie_vfn, _ie_vft, _ie_vfd) =>
                                                                        _ie_vfm[_ie_vfn] = ti_ann_to_type_g(st, _ie_vft, {})
                                                            st.ti_structs[_ievn] = _ie_vfm
                                                            let _ie_vftypes = []
                                                            for _ie_vctp in _ievp
                                                                match _ie_vctp
                                                                    Param(_ie_vcn, _ie_vct, _ie_vcd) =>
                                                                        push(_ie_vftypes, ti_ann_to_type_g(st, _ie_vct, {}))
                                                            let _ie_vctor = nt_fn(_ie_vftypes, nt_struct(mname))
                                                            ti_define(st, _ievn, ti_mono(_ie_vctor))
                                            st.ti_enum_variants[mname] = _ie_vnames
                                        if mtag == "type" and len(mname) > 0 and mname[0] != "_"
                                            // Generic imported struct (`type Box<T>`): map each type
                                            // parameter to a fresh var so the field types and the ctor
                                            // share it, then quantify -- same shape as the imported-fn
                                            // path above. A non-generic struct gets an empty map and
                                            // stays monomorphic.
                                            let _is_gnames = ti_extract_generics(man)
                                            let _is_gmap = {}
                                            for _is_gn in _is_gnames
                                                _is_gmap[_is_gn] = ti_fresh(st)
                                            let _is_fmap = {}
                                            for _is_p in mparams
                                                match _is_p
                                                    Param(_is_pn, _is_pt, _is_pd) =>
                                                        _is_fmap[_is_pn] = ti_ann_to_type_g(st, _is_pt, _is_gmap)
                                            st.ti_structs[mname] = _is_fmap
                                            // 1.2b: also DEFINE the positional constructor. The same-file
                                            // `tag == "type"` handler (~18590) does BOTH of these; this
                                            // branch previously did only the field map, so an imported
                                            // struct could be consumed (field access, match) but a bare
                                            // `Point(1, 2)` was E1002 -- every cross-module type needed a
                                            // hand-written wrapper fn per constructor. Enum VARIANT ctors
                                            // are registered in the `mtag == "enum"` branch above; this is
                                            // the plain-struct half of the same gap.
                                            let _is_ftypes = []
                                            for _is_cp in mparams
                                                match _is_cp
                                                    Param(_is_cpn, _is_cpt, _is_cpd) =>
                                                        push(_is_ftypes, ti_ann_to_type_g(st, _is_cpt, _is_gmap))
                                            let _is_ctor = nt_fn(_is_ftypes, nt_struct(mname))
                                            if len(_is_gnames) > 0
                                                ti_define(st, mname, ti_generalize(st, ti_zonk(st, _is_ctor)))
                                            else
                                                ti_define(st, mname, ti_mono(_is_ctor))
                                            // Deliberately NO ti_min_arity entry: the same-file
                                            // `tag == "type"` handler does not set one either, so a
                                            // wrong-arity ctor call is reported by unification in both
                                            // cases. Adding one here would give imported ctors a
                                            // different diagnostic than same-file ones, and would be
                                            // wrong outright if struct fields ever gain defaults.
                                            // Parity with the same-file path IS the fix.
                            st.ti_modules[mod_alias] = mod_fn_types
                if tag == "fn"
                    if contains(seen_fns, name)
                        ti_error(st, "duplicate function definition: '" + name + "' was already defined on line " + str(seen_fns[name]), sline)
                    else
                        seen_fns[name] = sline
                    let param_types = []
                    for p in params
                        push(param_types, ti_fresh(st))
                    let ret_var = ti_fresh(st)
                    ti_define(st, name, ti_mono(nt_fn(param_types, ret_var)))
                if tag == "type"
                    // Early-pass @opaque registration so that extern_fn decls
                    // that follow can see this type name as int-aliased.
                    for ann in annotations
                        match ann
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann" and av == "opaque"
                                    st.ti_opaque_types[name] = 1
                if tag == "extern_fn"
                    let ext_param_types = []
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                if ptype != "" and ptype != "any"
                                    let pt_eff = ptype
                                    if len(pt_eff) > 4 and pt_eff[0:4] == "out:"
                                        pt_eff = pt_eff[4:999999]
                                    if contains(st.ti_opaque_types, pt_eff)
                                        push(ext_param_types, nt_int())
                                    else
                                        push(ext_param_types, ti_ann_to_type_g(st, pt_eff, {}))
                                else
                                    push(ext_param_types, nt_any())
                    let ext_ret_t = nt_any()
                    match expr
                        Expr(ert, erv, ern, erc, erf, erl) =>
                            if ert == "rettype"
                                if contains(st.ti_opaque_types, erv)
                                    ext_ret_t = nt_int()
                                else
                                    ext_ret_t = ti_ann_to_type_g(st, erv, {})
                    ti_define(st, name, ti_mono(nt_fn(ext_param_types, ext_ret_t)))
                    st.ti_extern_fns[name] = 1
                if tag == "enum"
                    let variant_names = []
                    for variant in body
                        match variant
                            Stmt(vtag, vname, vexpr, vbody, vparams, velse, vann, vln) =>
                                if vtag == "type"
                                    push(variant_names, vname)
                                    st.ti_variant_enum[vname] = name
                                    // enum payload typing: record the ordered payload field type annotations
                                    // (raw strings, resolved at match time) so match binders take the DECLARED type.
                                    let _vpts = []
                                    for _vp in vparams
                                        match _vp
                                            Param(_vpn, _vpt, _vpd) =>
                                                push(_vpts, _vpt)
                                    st.ti_variant_ptypes[vname] = _vpts
                    st.ti_enum_variants[name] = variant_names
                if tag == "trait"
                    let trait_methods = []
                    let trait_defs = {}
                    let trait_arity = {}
                    let trait_ptypes = {}
                    let trait_rtype = {}
                    for tm in body
                        match tm
                            Stmt(tmt, tmn, tme, tmb, tmp, tmeb, tma, tml) =>
                                if tmt == "fn_sig" or tmt == "fn_default"
                                    let param_count = len(tmp)
                                    let has_self = false
                                    let _tr_ptl = []
                                    for tp in tmp
                                        match tp
                                            Param(tpn, tpt, tpd) =>
                                                if tpn == "self"
                                                    has_self = true
                                                else
                                                    push(_tr_ptl, tpt)          // LOCK-3: self-excluded param type annotations
                                    if has_self
                                        param_count = param_count - 1
                                    push(trait_methods, tmn)
                                    trait_arity[tmn] = param_count          // #8 S8.1: record required arity (self-excluded)
                                    trait_ptypes[tmn] = _tr_ptl
                                    let _tr_rt = ""                         // LOCK-3: return type annotation (from the rettype expr slot)
                                    match tme
                                        Expr(_ert, _erv, _ern, _erc, _erf, _erl) =>
                                            if _ert == "rettype"
                                                _tr_rt = _erv
                                    trait_rtype[tmn] = _tr_rt
                                    if tmt == "fn_default"
                                        trait_defs[tmn] = tm
                    st.ti_traits[name] = trait_methods
                    st.ti_trait_method_arity[name] = trait_arity
                    st.ti_trait_method_ptypes[name] = trait_ptypes
                    st.ti_trait_method_rtype[name] = trait_rtype
                    if len(trait_defs) > 0
                        st.ti_trait_defaults[name] = trait_defs
                if tag == "fn"
                    let dunder = find(name, "__")
                    if dunder > 0
                        let type_name = slice(name, 0, dunder)
                        let method_name = slice(name, dunder + 2, len(name))
                        if not contains(st.ti_type_methods, type_name)
                            st.ti_type_methods[type_name] = []
                        push(st.ti_type_methods[type_name], method_name)
                        // #8 S8.1: record this method's arity (self-excluded, SAME convention as the trait
                        // side) so conformance can verify the impl's arity matches the trait's required arity.
                        let _m_arity = len(params)
                        let _ty_ptl = []
                        for _mp in params
                            match _mp
                                Param(_mpn, _mpt, _mpd) =>
                                    if _mpn == "self"
                                        _m_arity = _m_arity - 1
                                    else
                                        push(_ty_ptl, _mpt)                  // LOCK-3: self-excluded impl param type annotations
                        let _tma = {}
                        if contains(st.ti_type_method_arity, type_name)
                            _tma = st.ti_type_method_arity[type_name]
                        _tma[method_name] = _m_arity
                        st.ti_type_method_arity[type_name] = _tma
                        // LOCK-3: record impl param type annotations + return type annotation for sig conformance
                        let _tpt = {}
                        if contains(st.ti_type_method_ptypes, type_name)
                            _tpt = st.ti_type_method_ptypes[type_name]
                        _tpt[method_name] = _ty_ptl
                        st.ti_type_method_ptypes[type_name] = _tpt
                        let _ty_rt = ""
                        match expr
                            Expr(_ert2, _erv2, _ern2, _erc2, _erf2, _erl2) =>
                                if _ert2 == "rettype"
                                    _ty_rt = _erv2
                        let _trt = {}
                        if contains(st.ti_type_method_rtype, type_name)
                            _trt = st.ti_type_method_rtype[type_name]
                        _trt[method_name] = _ty_rt
                        st.ti_type_method_rtype[type_name] = _trt
        si = si + 1
    si = 0
    while si < len(stmts)
        match stmts[si]
            Stmt(tt2, nn2, ee2, bb2, pp2, eb2, an2, sl2) =>
                if tt2 == "return"
                    ti_error(st, "'return' outside of a function is not allowed", sl2)
                if tt2 == "break"
                    ti_error(st, "'break' outside of a loop is not allowed", sl2)
                if tt2 == "continue"
                    ti_error(st, "'continue' outside of a loop is not allowed", sl2)
        ti_infer_stmt(st, stmts[si])
        si = si + 1
    ti_check_trait_conformance(st)
    ti_solve(st)
    let defer_names = keys(st.ti_fn_defer)
    for dn in defer_names
        let dinfo = st.ti_fn_defer[dn]
        let d_fn_type = dinfo[0]
        let d_ret_var = dinfo[1]
        let d_fn_name = dinfo[2]
        ti_define(st, dn, ti_mono(nt_any()))
        let d_resolved = ti_zonk(st, d_fn_type)
        ti_define(st, dn, ti_generalize(st, d_resolved))
        st.ti_fn_types[d_fn_name] = ti_to_ir_kind(ti_apply(st, d_ret_var))
        // S1 nominal struct-return: record the HM-resolved return struct name (ungated;
        // nothing reads ti_fn_ret_stypes unless NOVA_STRUCT_RET=1 at consumption).
        let _s1_ret_nt = ti_apply(st, d_ret_var)
        match _s1_ret_nt
            NType(_s1k, _s1n, _s1ps, _s1id) =>
                if _s1k == "struct" and _s1n != ""
                    st.ti_fn_ret_stypes[d_fn_name] = _s1n
        // Stage 1 (beat-C): export FULLY-RESOLVED param types here — after the whole
        // program is inferred + final ti_solve, an unannotated struct param (e.g. dot's
        // `a`) is now unified to its concrete struct via call sites. Codegen reads these
        // to type field access natively (a.x*b.x -> fmul). See PERFORMANCE_SPECIALIZATION.md.
        let _dpst = []
        match d_resolved
            NType(_dk, _dn2, _dps, _did) =>
                if _dk == "fn" and len(_dps) >= 1
                    let _dpi = 0
                    while _dpi < len(_dps) - 1
                        push(_dpst, ti_to_ir_stype(_dps[_dpi]))
                        _dpi = _dpi + 1
        st.ti_fn_param_types[d_fn_name] = _dpst
    ti_check_bounds(st)
    st

fn ti_check_bounds(st: TiState)
    for bc in st.ti_bound_checks
        let bc_type = bc[0]
        let bc_trait = bc[1]
        let bc_line = bc[2]
        let bc_fn = bc[3]
        let resolved = ti_apply(st, bc_type)
        match resolved
            NType(rk, rn, rp, ri) =>
                if rk == "any" or rk == "var"
                    continue
                let type_name = rk
                if rk == "struct"
                    type_name = rn
                let has_trait = false
                if contains(st.ti_type_traits, type_name)
                    if contains(st.ti_type_traits[type_name], bc_trait)
                        has_trait = true
                if not has_trait
                    ti_error(st, "type " + ti_type_str(resolved) + " does not implement trait '" + bc_trait + "' (required by " + bc_fn + ")", bc_line)

fn _sig_norm_ty(t: string) -> string
    if t == "Int" or t == "int"
        return "int"
    if t == "Float" or t == "float"
        return "float"
    if t == "Bool" or t == "bool"
        return "bool"
    if t == "String" or t == "string" or t == "str"
        return "string"
    if t == "Bytes" or t == "bytes"
        return "bytes"
    return t

fn _sig_is_known_prim(t: string) -> bool
    return t == "int" or t == "float" or t == "bool" or t == "string" or t == "bytes"

// LOCK-3 signature conformance: return false ONLY when both sides are provably-distinct primitives
// (int/float/bool/string/bytes) — the type-confusion-dangerous case for dynamic dispatch, where the
// runtime returns the impl's value reinterpreted as the trait's DECLARED type. Anything involving an
// unannotated slot, `any`, a user type, a generic parameter, or a container is treated as compatible ->
// no false positives; whole-program inference + call-site unification still guard the static-dispatch cases.
fn _sig_type_compatible(a: string, b: string) -> bool
    if a == "" or b == "" or a == "any" or b == "any"
        return true
    let na = _sig_norm_ty(a)
    let nb = _sig_norm_ty(b)
    if na == nb
        return true
    if _sig_is_known_prim(na) and _sig_is_known_prim(nb)
        return false
    return true

fn ti_check_trait_conformance(st: TiState)
    let type_names = keys(st.ti_type_traits)
    for tn in type_names
        let trait_map = st.ti_type_traits[tn]
        let trait_names = keys(trait_map)
        for trait_name in trait_names
            let decl_line = trait_map[trait_name]
            if not contains(st.ti_traits, trait_name)
                ti_error(st, "type '" + tn + "' declares conformance to unknown trait '" + trait_name + "'", decl_line)
            else
                let required = st.ti_traits[trait_name]
                let implemented = []
                if contains(st.ti_type_methods, tn)
                    implemented = st.ti_type_methods[tn]
                let has_defaults = contains(st.ti_trait_defaults, trait_name)
                let trait_def_map = {}
                if has_defaults
                    trait_def_map = st.ti_trait_defaults[trait_name]
                let missing = []
                let arity_errs = []
                let type_errs = []
                // #8 S8.1: pull the recorded per-method arities (self-excluded) for trait + impl
                let _tr_ar = {}
                if contains(st.ti_trait_method_arity, trait_name)
                    _tr_ar = st.ti_trait_method_arity[trait_name]
                let _ty_ar = {}
                if contains(st.ti_type_method_arity, tn)
                    _ty_ar = st.ti_type_method_arity[tn]
                // LOCK-3: pull the recorded per-method param/return TYPE annotations for trait + impl
                let _tr_pt = {}
                if contains(st.ti_trait_method_ptypes, trait_name)
                    _tr_pt = st.ti_trait_method_ptypes[trait_name]
                let _ty_pt = {}
                if contains(st.ti_type_method_ptypes, tn)
                    _ty_pt = st.ti_type_method_ptypes[tn]
                let _tr_rt2 = {}
                if contains(st.ti_trait_method_rtype, trait_name)
                    _tr_rt2 = st.ti_trait_method_rtype[trait_name]
                let _ty_rt2 = {}
                if contains(st.ti_type_method_rtype, tn)
                    _ty_rt2 = st.ti_type_method_rtype[tn]
                for rm in required
                    if not list_contains(implemented, rm)
                        if not contains(trait_def_map, rm)
                            push(missing, rm)
                    else
                        // the type HAS this method -> its arity must match the trait's required arity
                        // (closes the name-only conformance hole: a wrong-arity impl was silently accepted)
                        if contains(_tr_ar, rm) and contains(_ty_ar, rm)
                            if _tr_ar[rm] != _ty_ar[rm]
                                push(arity_errs, rm + "() wants " + str(_tr_ar[rm]) + " arg(s), impl has " + str(_ty_ar[rm]))
                        // LOCK-3: SIGNATURE TYPE conformance. Where both sides declare a type, a provably-distinct
                        // primitive mismatch is unsound under dynamic dispatch (the runtime returns/consumes the
                        // impl's value AS the trait's declared type). Conservative: only fires on clear primitive
                        // mismatches; unannotated/any/user-type/generic slots pass (inference guards those).
                        if contains(_tr_pt, rm) and contains(_ty_pt, rm)
                            let _tps = _tr_pt[rm]
                            let _ips = _ty_pt[rm]
                            if len(_tps) == len(_ips)
                                let _pk = 0
                                while _pk < len(_tps)
                                    if not _sig_type_compatible(_tps[_pk], _ips[_pk])
                                        push(type_errs, rm + "() param " + str(_pk + 1) + ": trait requires " + _tps[_pk] + ", impl has " + _ips[_pk])
                                    _pk = _pk + 1
                        if contains(_tr_rt2, rm) and contains(_ty_rt2, rm)
                            if not _sig_type_compatible(_tr_rt2[rm], _ty_rt2[rm])
                                push(type_errs, rm + "() returns " + _ty_rt2[rm] + ", trait requires " + _tr_rt2[rm])
                if len(missing) > 0
                    let msg = "type '" + tn + "' does not fully implement trait '" + trait_name + "': missing "
                    let mi = 0
                    while mi < len(missing)
                        if mi > 0
                            msg = msg + ", "
                        msg = msg + missing[mi] + "()"
                        mi = mi + 1
                    ti_error(st, msg, decl_line)
                if len(arity_errs) > 0
                    let amsg = "type '" + tn + "' implements trait '" + trait_name + "' with wrong method arity: "
                    let ai2 = 0
                    while ai2 < len(arity_errs)
                        if ai2 > 0
                            amsg = amsg + ", "
                        amsg = amsg + arity_errs[ai2]
                        ai2 = ai2 + 1
                    ti_error(st, amsg, decl_line)
                if len(type_errs) > 0
                    let tmsg = "type '" + tn + "' implements trait '" + trait_name + "' with an incompatible method signature: "
                    let ti3 = 0
                    while ti3 < len(type_errs)
                        if ti3 > 0
                            tmsg = tmsg + "; "
                        tmsg = tmsg + type_errs[ti3]
                        ti3 = ti3 + 1
                    ti_error(st, tmsg, decl_line)

// ── Tail Call Optimization ───────────────────────────────────────────────────

fn ir_tco_rewrite_block(label: string, insts: list, call_idx: int, params: list) -> IrBlock
    let new_insts = []
    let ii = 0
    while ii < call_idx
        push(new_insts, insts[ii])
        ii = ii + 1
    let call_line = 0
    match insts[call_idx]
        IrInst(_, _, _, cargs, _, _, _, cline) =>
            call_line = cline
            let pi = 0
            while pi < len(params)
                match params[pi]
                    IrParam(pname, ptype) =>
                        push(new_insts, IrInst("slot_store", "", ir_type_void(), [cargs[pi]], pname, 0, "side", cline))
                pi = pi + 1
    IrBlock(label, new_insts, IrInst("goto", "", ir_type_void(), [], "tco_loop", 0, "pure", call_line))

fn ir_tco(func: IrFunction) -> IrFunction
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1 or len(params) == 0 or len(blocks) == 0
                return func
            let tail_map = {}
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        match terminator
                            IrInst(top, _, _, targs, _, _, _, _) =>
                                if top == "return" and len(targs) > 0
                                    let rv = targs[0]
                                    let idx = len(insts) - 1
                                    while idx >= 0
                                        match insts[idx]
                                            IrInst(iop, idest, _, iargs, ival, _, _, _) =>
                                                if iop == "call" and ival == name and idest == rv and len(iargs) == len(params)
                                                    tail_map[label] = idx
                                                    idx = -1
                                        if idx >= 0
                                            idx = idx - 1
            if len(tail_map) == 0
                return func
            let new_blocks = []
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        if label == "entry"
                            push(new_blocks, IrBlock("entry", [], IrInst("goto", "", ir_type_void(), [], "tco_loop", 0, "pure", 0)))
                            if contains(tail_map, "entry")
                                let ci = tail_map["entry"]
                                push(new_blocks, ir_tco_rewrite_block("tco_loop", insts, ci, params))
                            else
                                push(new_blocks, IrBlock("tco_loop", insts, terminator))
                        else if contains(tail_map, label)
                            let ci = tail_map[label]
                            push(new_blocks, ir_tco_rewrite_block(label, insts, ci, params))
                        else
                            push(new_blocks, block)
            IrFunction(name, params, ret_type, new_blocks, type_params, is_extern)

// ── Dead Block Elimination ──────────────────────────────────────────────────

fn ir_dbe(func: IrFunction) -> IrFunction
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1 or len(blocks) == 0
                return func
            let reachable = {}
            let queue = []
            match blocks[0]
                IrBlock(elabel, _, _) =>
                    push(queue, elabel)
            let qi = 0
            while qi < len(queue)
                let lbl = queue[qi]
                qi = qi + 1
                if contains(reachable, lbl)
                    continue
                reachable[lbl] = 1
                for block in blocks
                    match block
                        IrBlock(blabel, _, terminator) =>
                            if blabel == lbl
                                match terminator
                                    IrInst(top, _, _, targs, tval, _, _, _) =>
                                        if top == "goto"
                                            if not contains(reachable, tval)
                                                push(queue, tval)
                                        else if top == "branch"
                                            if not contains(reachable, tval)
                                                push(queue, tval)
                                            if len(targs) > 1 and not contains(reachable, targs[1])
                                                push(queue, targs[1])
            let new_blocks = []
            for block in blocks
                match block
                    IrBlock(blabel, _, _) =>
                        if contains(reachable, blabel)
                            push(new_blocks, block)
            IrFunction(name, params, ret_type, new_blocks, type_params, is_extern)

// ── Dead Instruction Elimination ────────────────────────────────────────────

fn ir_die(func: IrFunction) -> IrFunction
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1 or len(blocks) == 0
                return func
            let used = {}
            for block in blocks
                match block
                    IrBlock(_, insts, terminator) =>
                        for inst in insts
                            match inst
                                IrInst(_, _, _, args, _, _, _, _) =>
                                    for arg in args
                                        used[arg] = 1
                        match terminator
                            IrInst(_, _, _, targs, _, _, _, _) =>
                                for targ in targs
                                    used[targ] = 1
            let new_blocks = []
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        let new_insts = []
                        for inst in insts
                            match inst
                                IrInst(op, dest, _, _, _, _, effect, line) =>
                                    if dest == "" or contains(used, dest) or effect == "side_effect" or op == "slot_store" or op == "call" or op == "index_set" or op == "field_set"
                                        push(new_insts, inst)
                        push(new_blocks, IrBlock(label, new_insts, terminator))
            IrFunction(name, params, ret_type, new_blocks, type_params, is_extern)

// ── Constant Folding + Slot Forwarding ──────────────────────────────────────

// ── Track 8 F102 Week 1: Escape Analysis ────────────────────────────────────
// Returns [n_allocs, n_escaping_allocs] for one function. An allocation is
// any make_list / make_dict / make_struct. It "escapes" if its result
// register flows to a return, a send(channel, value), a spawn capture, or
// is stored into a container that itself escapes.
//
// This is the conservative may-escape pass: when in doubt, mark as escape.
// Soundness > completeness. A later (stronger) pass can lower the
// escape count by tracking inter-procedural dataflow.
fn ir_escape_analysis(func: IrFunction) -> list
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1 or len(blocks) == 0
                return [0, 0]
            let escaping = {}
            // Phase 1: collect direct escape sites and mark their operands.
            for block in blocks
                match block
                    IrBlock(_, insts, terminator) =>
                        for inst in insts
                            match inst
                                IrInst(op, dest, _, args, value, _, _, _) =>
                                    if op == "call"
                                        if value == "nova_rt_channel_send" or value == "nova_rt_channel_send_move" or value == "nova_rt_channel_recv" or value == "send"
                                            if len(args) >= 2
                                                escaping[args[1]] = 1
                                        if value == "nova_rt_spawn" or value == "spawn"
                                            let ai = 0
                                            while ai < len(args)
                                                escaping[args[ai]] = 1
                                                ai = ai + 1
                                    // NOTE: slot_store is LOCAL by itself — the slot
                                    // lives on the current function's stack. Whether
                                    // its content escapes is determined by phase 2 (if
                                    // any reload of this slot reaches an escape point).
                                    if op == "field_set" or op == "index_set"
                                        // Storing into a container: only escapes if the
                                        // container escapes. Conservative for MVP: assume
                                        // container does escape, so the value escapes.
                                        if len(args) >= 3
                                            escaping[args[2]] = 1
                        match terminator
                            IrInst(top, _, _, targs, _, _, _, _) =>
                                if top == "return" and len(targs) > 0
                                    escaping[targs[0]] = 1
            // Phase 2: forward-propagate via copies and slot_load only.
            // A value escapes if a COPY of it escapes (same handle moves), or
            // if it's loaded from an escaping slot. Other operations produce a
            // *new* value that doesn't make the inputs escape.
            let changed = true
            while changed
                changed = false
                for block in blocks
                    match block
                        IrBlock(_, insts, _) =>
                            for inst in insts
                                match inst
                                    IrInst(op, dest, _, args, value, _, _, _) =>
                                        // dest escapes? maybe its alias-source needs to
                                        if dest != "" and contains(escaping, dest)
                                            if op == "copy" or op == "slot_load"
                                                let src_key = ""
                                                if op == "slot_load"
                                                    src_key = "slot." + value
                                                else if len(args) > 0
                                                    src_key = args[0]
                                                if src_key != "" and not contains(escaping, src_key)
                                                    escaping[src_key] = 1
                                                    changed = true
                                        // src escapes? if so the dest of a copy aliases it
                                        if op == "copy" and len(args) > 0
                                            if contains(escaping, args[0]) and dest != "" and not contains(escaping, dest)
                                                escaping[dest] = 1
                                                changed = true
                                        if op == "slot_store" and len(args) > 0
                                            // storing into a slot: if any later slot_load
                                            // of this slot escapes, the stored value escapes
                                            let slot_k = "slot." + value
                                            if contains(escaping, slot_k) and not contains(escaping, args[0])
                                                escaping[args[0]] = 1
                                                changed = true
            // Phase 3: count allocations + collect the SET of local
            // alloc destinations (the dict that codegen uses to pick
            // _no_rc runtime variants — Track 8 Week 3).
            let n_allocs = 0
            let n_escape = 0
            let local_set = {}
            for block in blocks
                match block
                    IrBlock(_, insts, _) =>
                        for inst in insts
                            match inst
                                IrInst(op, dest, _, args, _, _, _, _) =>
                                    if op == "make_list" or op == "make_dict" or op == "make_struct"
                                        n_allocs = n_allocs + 1
                                        if dest != "" and contains(escaping, dest)
                                            n_escape = n_escape + 1
                                        else
                                            if dest != ""
                                                local_set[dest] = 1
            // Encoded as a 3-element list so callers can also read it as
            // [n_allocs, n_escape] for backward compatibility — the third
            // element is the local-dest set for codegen consumption.
            [n_allocs, n_escape, local_set]

// ── Stage 4 SROA: interprocedural escape analysis ───────────────────────────
// ir_escaping_set computes the set of value-regs that ESCAPE the function, using
// an interprocedural summary for user-function calls (an arg escapes only if the
// callee's corresponding parameter escapes). Unknown/builtin callees conservatively
// escape ALL their args — this is SOUND and, for free, keeps any struct passed to a
// tag-reading runtime fn (nova_rt_eq/hash/deep_copy/type_name/print/...) on the heap
// (the MemTag guard), since those are non-summary calls. This is SEPARATE from
// ir_escape_analysis's local_set (which drives RC-elision) so it cannot perturb that.
fn ir_escaping_set(func: IrFunction, summaries: dict) -> dict
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            let escaping = {}
            for block in blocks
                match block
                    IrBlock(_, insts, terminator) =>
                        for inst in insts
                            match inst
                                IrInst(op, dest, _, args, value, _, _, _) =>
                                    if op == "call"
                                        if contains(summaries, value)
                                            let pm = summaries[value]
                                            let ai = 0
                                            while ai < len(args)
                                                if contains(pm, str(ai))
                                                    escaping[args[ai]] = 1
                                                ai = ai + 1
                                        else
                                            let bi = 0
                                            while bi < len(args)
                                                escaping[args[bi]] = 1
                                                bi = bi + 1
                                    // SOUNDNESS (attack guards 2/3): a value captured by a closure,
                                    // passed to a dyn_call, stored as a field of another struct
                                    // (nested), or put into a list/dict ESCAPES — its handle can
                                    // outlive this frame. Conservatively escape ALL args of these
                                    // ops (scalars are no-ops; struct/heap args are correctly kept
                                    // off the stack). Without this, a struct reachable via a closure
                                    // or container would be wrongly stack-allocated -> use-after-free.
                                    if op == "make_closure" or op == "dyn_call" or op == "make_struct" or op == "make_list" or op == "make_dict"
                                        let ci = 0
                                        while ci < len(args)
                                            escaping[args[ci]] = 1
                                            ci = ci + 1
                                    // MemTag guard: structural == / != lower to nova_rt_eq, which
                                    // reads the heap RC/MemTag header (ptr[-1], NOVA_STRUCT_NSLOTS)
                                    // to walk fields — a STACK struct has no such header. So any
                                    // struct operand of these ops must stay on the heap. (Scalar
                                    // operands are no-ops.) These are binary OPS, not "call"s, so the
                                    // call rule above doesn't cover them. match/type_name read the
                                    // stored slot-0 hash (present on stack structs) so are fine.
                                    if op == "eq" or op == "ne"
                                        let qi = 0
                                        while qi < len(args)
                                            escaping[args[qi]] = 1
                                            qi = qi + 1
                                    if op == "field_set" or op == "index_set"
                                        // the stored VALUE is the last arg (field_set: [obj,val];
                                        // index_set: [container,index,val]) — it escapes into the target.
                                        if len(args) >= 2
                                            escaping[args[len(args) - 1]] = 1
                                    // A struct used as a dict KEY (args[1]) is hashed via nova_rt_hash,
                                    // which reads the MemTag — keep it heap. List indices are ints (no-op).
                                    if (op == "index_get" or op == "index_set") and len(args) >= 2
                                        escaping[args[1]] = 1
                        match terminator
                            IrInst(top, _, _, targs, _, _, _, _) =>
                                if top == "return" and len(targs) > 0
                                    escaping[targs[0]] = 1
            let changed = true
            while changed
                changed = false
                for block in blocks
                    match block
                        IrBlock(_, insts, _) =>
                            for inst in insts
                                match inst
                                    IrInst(op, dest, _, args, value, _, _, _) =>
                                        if dest != "" and contains(escaping, dest)
                                            if op == "copy" or op == "slot_load"
                                                let src_key = ""
                                                if op == "slot_load"
                                                    src_key = "slot." + value
                                                else if len(args) > 0
                                                    src_key = args[0]
                                                if src_key != "" and not contains(escaping, src_key)
                                                    escaping[src_key] = 1
                                                    changed = true
                                        if op == "copy" and len(args) > 0
                                            if contains(escaping, args[0]) and dest != "" and not contains(escaping, dest)
                                                escaping[dest] = 1
                                                changed = true
                                        if op == "slot_store" and len(args) > 0
                                            let slot_k = "slot." + value
                                            if contains(escaping, slot_k) and not contains(escaping, args[0])
                                                escaping[args[0]] = 1
                                                changed = true
            escaping

// ir_escape_summaries: fixpoint over all functions computing, per function, the SET of
// parameter indices that escape. Monotonic (escapes only grow), so it converges; capped
// at 8 iterations defensively. summaries[fname] = dict of "<paramIndex>" -> 1.
fn ir_escape_summaries(all_fns: list) -> dict
    let summ = {}
    for fnx in all_fns
        match fnx
            IrFunction(fnname, _, _, _, _, fex) =>
                if fex == 0
                    summ[fnname] = {}
    let changed = true
    let iters = 0
    while changed and iters < 8
        changed = false
        iters = iters + 1
        for fnx in all_fns
            match fnx
                IrFunction(fnname, fparams, _, fblocks, _, fex) =>
                    if fex == 0 and len(fblocks) > 0
                        let esc = ir_escaping_set(fnx, summ)
                        let newpm = {}
                        let pi = 0
                        for p in fparams
                            match p
                                IrParam(pn, pt) =>
                                    if contains(esc, "%p" + str(pi)) or contains(esc, "slot." + pn)
                                        newpm[str(pi)] = 1
                            pi = pi + 1
                        let oldn = 0
                        if contains(summ, fnname)
                            oldn = len(keys(summ[fnname]))
                        if len(keys(newpm)) != oldn
                            summ[fnname] = newpm
                            changed = true
    summ

// ir_stackable_structs: make_struct dests safe to STACK-allocate — non-escaping (per the
// interprocedural escaping set) AND all-scalar-field type (no heap fields => zero RC concern
// in any mode). The all-scalar restriction + the escaping set (which keeps any struct reaching
// a runtime polymorphic/tag-reading path on the heap) make this sound for stack allocation.
fn ir_stackable_structs(func: IrFunction, summaries: dict, allscalar_types: dict) -> dict
    let esc = ir_escaping_set(func, summaries)
    let stackable = {}
    match func
        IrFunction(_, _, _, blocks, _, _) =>
            for block in blocks
                match block
                    IrBlock(_, insts, _) =>
                        for inst in insts
                            match inst
                                IrInst(op, dest, _, args, value, _, _, _) =>
                                    if op == "make_struct" and dest != ""
                                        if not contains(esc, dest) and contains(allscalar_types, value)
                                            stackable[dest] = 1
    stackable

// Track 8 W7 helper: returns 1 if any function in the program calls
// spawn (directly via "spawn" or "nova_rt_spawn"). Used by the auto-arena
// pass: if no spawn anywhere, the program is single-process and can run
// in arena mode (no RC traffic, freed at process exit). Conservative —
// indirect spawns via FFI are not detected, so this is opt-in via env.
fn ir_program_has_spawn(all_fns: list) -> int
    for f in all_fns
        match f
            IrFunction(_, _, _, blocks, _, fextern) =>
                if fextern == 0
                    for block in blocks
                        match block
                            IrBlock(_, insts, _) =>
                                for inst in insts
                                    match inst
                                        IrInst(op, _, _, _, value, _, _, _) =>
                                            if op == "call"
                                                if value == "nova_rt_spawn" or value == "spawn"
                                                    return 1
    0

fn ir_const_fold(func: IrFunction) -> IrFunction
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            if is_extern == 1 or len(blocks) == 0
                return func
            let const_vals = {}
            // LOCK-4 inc3b: which const registers carry a sized WIDTH (from a width-typed
            // const_int). A sized operand makes the fold BAIL — the add/sub/mul is left in the
            // stream so ir_infer_types propagates the width and the backend masks/wraps it.
            let const_width = {}
            let new_blocks = []
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        let slot_last = {}
                        // Track slot_addr results so calls that escape a slot
                        // address can invalidate slot_last for that slot (FFI
                        // out<T>: C writes through the pointer, NOVA must
                        // re-load the slot afterwards).
                        let addr_regs = {}
                        let slot_invalid = {}
                        let new_insts = []
                        for inst in insts
                            match inst
                                IrInst(op, dest, typ, args, value, num, effect, line) =>
                                    if op == "const_int"
                                        const_vals[dest] = num
                                        if typ.name != ""
                                            const_width[dest] = typ.name
                                        push(new_insts, inst)
                                    else if op == "slot_store"
                                        slot_last[value] = args[0]
                                        slot_invalid[value] = 0
                                        push(new_insts, inst)
                                    else if op == "slot_addr"
                                        addr_regs[dest] = value
                                        push(new_insts, inst)
                                    else if op == "call"
                                        for a in args
                                            if contains(addr_regs, a)
                                                slot_invalid[addr_regs[a]] = 1
                                        push(new_insts, inst)
                                    else if op == "slot_load"
                                        let invalidated = contains(slot_invalid, value) and slot_invalid[value] == 1
                                        if contains(slot_last, value) and not invalidated
                                            let fwd = slot_last[value]
                                            push(new_insts, IrInst("copy", dest, typ, [fwd], "", 0, "pure", line))
                                            if contains(const_vals, fwd)
                                                const_vals[dest] = const_vals[fwd]
                                            // LOCK-4 inc3c: a slot-forwarded sized value keeps its width, so a
                                            // downstream `x + 1` BAILS the fold and reaches the backend mask.
                                            if contains(const_width, fwd)
                                                const_width[dest] = const_width[fwd]
                                        else
                                            push(new_insts, inst)
                                    else if op == "add" and len(args) == 2
                                        if contains(const_width, args[0]) or contains(const_width, args[1])
                                            push(new_insts, inst)
                                        else if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = const_vals[args[0]] + const_vals[args[1]]
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else if contains(const_vals, args[0]) and const_vals[args[0]] == 0
                                            push(new_insts, IrInst("copy", dest, typ, [args[1]], "", 0, "pure", line))
                                            if contains(const_vals, args[1])
                                                const_vals[dest] = const_vals[args[1]]
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 0
                                            push(new_insts, IrInst("copy", dest, typ, [args[0]], "", 0, "pure", line))
                                            if contains(const_vals, args[0])
                                                const_vals[dest] = const_vals[args[0]]
                                        else
                                            push(new_insts, inst)
                                    else if op == "sub" and len(args) == 2
                                        if contains(const_width, args[0]) or contains(const_width, args[1])
                                            push(new_insts, inst)
                                        else if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = const_vals[args[0]] - const_vals[args[1]]
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else if args[0] == args[1]
                                            const_vals[dest] = 0
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "0", 0, "pure", line))
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 0
                                            push(new_insts, IrInst("copy", dest, typ, [args[0]], "", 0, "pure", line))
                                            if contains(const_vals, args[0])
                                                const_vals[dest] = const_vals[args[0]]
                                        else
                                            push(new_insts, inst)
                                    else if op == "mul" and len(args) == 2
                                        if contains(const_width, args[0]) or contains(const_width, args[1])
                                            push(new_insts, inst)
                                        else if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = const_vals[args[0]] * const_vals[args[1]]
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else if contains(const_vals, args[0]) and const_vals[args[0]] == 0
                                            const_vals[dest] = 0
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "0", 0, "pure", line))
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 0
                                            const_vals[dest] = 0
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "0", 0, "pure", line))
                                        else if contains(const_vals, args[0]) and const_vals[args[0]] == 1
                                            push(new_insts, IrInst("copy", dest, typ, [args[1]], "", 0, "pure", line))
                                            if contains(const_vals, args[1])
                                                const_vals[dest] = const_vals[args[1]]
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 1
                                            push(new_insts, IrInst("copy", dest, typ, [args[0]], "", 0, "pure", line))
                                            if contains(const_vals, args[0])
                                                const_vals[dest] = const_vals[args[0]]
                                        else
                                            push(new_insts, inst)
                                    else if op == "div" and len(args) == 2
                                        if contains(const_width, args[0]) or contains(const_width, args[1])
                                            push(new_insts, inst)
                                        else if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if (tk == "int" or tk == "any") and const_vals[args[1]] != 0
                                                        let result = const_vals[args[0]] / const_vals[args[1]]
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 1
                                            push(new_insts, IrInst("copy", dest, typ, [args[0]], "", 0, "pure", line))
                                            if contains(const_vals, args[0])
                                                const_vals[dest] = const_vals[args[0]]
                                        else
                                            push(new_insts, inst)
                                    else if op == "mod" and len(args) == 2
                                        if contains(const_width, args[0]) or contains(const_width, args[1])
                                            push(new_insts, inst)
                                        else if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if (tk == "int" or tk == "any") and const_vals[args[1]] != 0
                                                        let result = const_vals[args[0]] % const_vals[args[1]]
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 1
                                            const_vals[dest] = 0
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "0", 0, "pure", line))
                                        else
                                            push(new_insts, inst)
                                    else if op == "bitand" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            let result = const_vals[args[0]] & const_vals[args[1]]
                                            const_vals[dest] = result
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                        else if args[0] == args[1]
                                            push(new_insts, IrInst("copy", dest, typ, [args[0]], "", 0, "pure", line))
                                            if contains(const_vals, args[0])
                                                const_vals[dest] = const_vals[args[0]]
                                        else if contains(const_vals, args[0]) and const_vals[args[0]] == 0
                                            const_vals[dest] = 0
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "0", 0, "pure", line))
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 0
                                            const_vals[dest] = 0
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "0", 0, "pure", line))
                                        else
                                            push(new_insts, inst)
                                    else if op == "bitor" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            let result = const_vals[args[0]] | const_vals[args[1]]
                                            const_vals[dest] = result
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                        else if args[0] == args[1]
                                            push(new_insts, IrInst("copy", dest, typ, [args[0]], "", 0, "pure", line))
                                            if contains(const_vals, args[0])
                                                const_vals[dest] = const_vals[args[0]]
                                        else if contains(const_vals, args[0]) and const_vals[args[0]] == 0
                                            push(new_insts, IrInst("copy", dest, typ, [args[1]], "", 0, "pure", line))
                                            if contains(const_vals, args[1])
                                                const_vals[dest] = const_vals[args[1]]
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 0
                                            push(new_insts, IrInst("copy", dest, typ, [args[0]], "", 0, "pure", line))
                                            if contains(const_vals, args[0])
                                                const_vals[dest] = const_vals[args[0]]
                                        else
                                            push(new_insts, inst)
                                    else if op == "bitxor" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            let result = const_vals[args[0]] ^ const_vals[args[1]]
                                            const_vals[dest] = result
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                        else if args[0] == args[1]
                                            const_vals[dest] = 0
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "0", 0, "pure", line))
                                        else if contains(const_vals, args[0]) and const_vals[args[0]] == 0
                                            push(new_insts, IrInst("copy", dest, typ, [args[1]], "", 0, "pure", line))
                                            if contains(const_vals, args[1])
                                                const_vals[dest] = const_vals[args[1]]
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 0
                                            push(new_insts, IrInst("copy", dest, typ, [args[0]], "", 0, "pure", line))
                                            if contains(const_vals, args[0])
                                                const_vals[dest] = const_vals[args[0]]
                                        else
                                            push(new_insts, inst)
                                    else if op == "shl" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            let sv = const_vals[args[1]]
                                            if sv >= 0 and sv < 64
                                                let result = const_vals[args[0]] << sv
                                                const_vals[dest] = result
                                                push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                            else
                                                push(new_insts, inst)
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 0
                                            push(new_insts, IrInst("copy", dest, typ, [args[0]], "", 0, "pure", line))
                                            if contains(const_vals, args[0])
                                                const_vals[dest] = const_vals[args[0]]
                                        else if contains(const_vals, args[0]) and const_vals[args[0]] == 0
                                            const_vals[dest] = 0
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "0", 0, "pure", line))
                                        else
                                            push(new_insts, inst)
                                    else if op == "shr" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            let sv = const_vals[args[1]]
                                            if sv >= 0 and sv < 64
                                                let result = const_vals[args[0]] >> sv
                                                const_vals[dest] = result
                                                push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                            else
                                                push(new_insts, inst)
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 0
                                            push(new_insts, IrInst("copy", dest, typ, [args[0]], "", 0, "pure", line))
                                            if contains(const_vals, args[0])
                                                const_vals[dest] = const_vals[args[0]]
                                        else if contains(const_vals, args[0]) and const_vals[args[0]] == 0
                                            const_vals[dest] = 0
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "0", 0, "pure", line))
                                        else
                                            push(new_insts, inst)
                                    else if op == "eq" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] == const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_bool(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "neq" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] != const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_bool(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "lt" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] < const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_bool(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "le" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] <= const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_bool(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "gt" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] > const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_bool(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "ge" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0
                                                        if const_vals[args[0]] >= const_vals[args[1]]
                                                            result = 1
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_bool(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "neg" and len(args) == 1
                                        if contains(const_vals, args[0])
                                            match typ
                                                IrType(tk, _, _, _) =>
                                                    if tk == "int" or tk == "any"
                                                        let result = 0 - const_vals[args[0]]
                                                        const_vals[dest] = result
                                                        push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                                    else
                                                        push(new_insts, inst)
                                        else
                                            push(new_insts, inst)
                                    else if op == "not" and len(args) == 1
                                        if contains(const_vals, args[0])
                                            let result = 0
                                            if const_vals[args[0]] == 0
                                                result = 1
                                            const_vals[dest] = result
                                            push(new_insts, IrInst("const_int", dest, ir_type_bool(), [], str(result), result, "pure", line))
                                        else
                                            push(new_insts, inst)
                                    else if op == "bitnot" and len(args) == 1
                                        if contains(const_vals, args[0])
                                            let result = ~const_vals[args[0]]
                                            const_vals[dest] = result
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                        else
                                            push(new_insts, inst)
                                    else if op == "and" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            let result = 0
                                            if const_vals[args[0]] != 0 and const_vals[args[1]] != 0
                                                result = 1
                                            const_vals[dest] = result
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                        else if contains(const_vals, args[0]) and const_vals[args[0]] == 0
                                            const_vals[dest] = 0
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "0", 0, "pure", line))
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] == 0
                                            const_vals[dest] = 0
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "0", 0, "pure", line))
                                        else
                                            push(new_insts, inst)
                                    else if op == "or" and len(args) == 2
                                        if contains(const_vals, args[0]) and contains(const_vals, args[1])
                                            let result = 0
                                            if const_vals[args[0]] != 0 or const_vals[args[1]] != 0
                                                result = 1
                                            const_vals[dest] = result
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], str(result), result, "pure", line))
                                        else if contains(const_vals, args[0]) and const_vals[args[0]] != 0
                                            const_vals[dest] = 1
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "1", 1, "pure", line))
                                        else if contains(const_vals, args[1]) and const_vals[args[1]] != 0
                                            const_vals[dest] = 1
                                            push(new_insts, IrInst("const_int", dest, ir_type_int(), [], "1", 1, "pure", line))
                                        else
                                            push(new_insts, inst)
                                    else if op == "copy" and len(args) == 1
                                        if contains(const_vals, args[0])
                                            const_vals[dest] = const_vals[args[0]]
                                        // LOCK-4 inc3c-part2: a WIDTH-TYPED copy is the annotation
                                        // bridge (`let y: u8 = <e>` emits copy dest:int"u8" <- e).
                                        // const_fold runs BEFORE ir_infer_types, so without picking
                                        // the width up here the bridge was DEAD for any constant
                                        // initialiser: `let y: u8 = 255; y + 1` folded straight to
                                        // 256 and never reached the backend mask. Widths from the
                                        // source register still win; this only supplies one when the
                                        // source has none, which is exactly the annotation case.
                                        match typ
                                            IrType(_cptk, _cptn, _cptp, _cptid) =>
                                                if _cptk == "int" and _cptn != ""
                                                    const_width[dest] = _cptn
                                                    // and NARROW the folded constant to match what
                                                    // the backend will actually store.
                                                    if contains(const_vals, dest)
                                                        const_vals[dest] = _l7_mask_const(const_vals[dest], _cptn)
                                        push(new_insts, inst)
                                    else
                                        push(new_insts, inst)
                        let new_term = terminator
                        match terminator
                            IrInst(top, tdest, ttyp, targs, tval, tnum, teff, tline) =>
                                if top == "branch" and len(targs) > 0
                                    if contains(const_vals, targs[0])
                                        let cv = const_vals[targs[0]]
                                        if cv != 0
                                            new_term = IrInst("goto", "", ir_type_void(), [], tval, 0, "pure", tline)
                                        else
                                            if len(targs) > 1
                                                new_term = IrInst("goto", "", ir_type_void(), [], targs[1], 0, "pure", tline)
                        push(new_blocks, IrBlock(label, new_insts, new_term))
            IrFunction(name, params, ret_type, new_blocks, type_params, is_extern)

// IR optimizer pipeline. Slot-level dead-store elimination is intentionally
// NOT done here — slot_store/slot_load lower to LLVM alloca/store/load, and
// clang -O2's mem2reg + DSE already eliminate them completely. A NOVA-level
// DSE pass would be pure redundancy with the backend.
//
// Performance strategy (Option D):
// - readonly/readnone attributes on runtime declarations enable LLVM's
//   LICM (list_len hoisting), GVN (redundant call elimination), and CSE
// - TBAA metadata on inlined list/dict ops gives LLVM aliasing info
// - Arena mode (Option E2) eliminates all RC overhead for single-process code
fn ir_optimize(func: IrFunction) -> IrFunction
    let f = ir_tco(func)
    f = ir_const_fold(f)
    f = ir_die(f)
    f = ir_dbe(f)
    f

// ── IR Type Inference ────────────────────────────────────────────────────────

fn ir_reg_type(reg_types: dict, reg: string) -> string
    if contains(reg_types, reg)
        return reg_types[reg]
    "any"

// LOCK-4 inc3b: sized-int WIDTH of a register ("u8".."i64"/"usize", or "" = default i64).
// Tracked in a parallel "@w@"-prefixed slot of the same reg_types dict so int arithmetic
// can propagate + mask to width without changing the string-typed `rt` scheme.
fn ir_reg_width(reg_types: dict, reg: string) -> string
    let k = "@w@" + reg
    if contains(reg_types, k)
        return reg_types[k]
    ""

// Non-negativity tracking. A register/slot is "@nn@"-marked when proven to
// hold a non-negative value, so list index access can skip the negative-index
// (Python a[-1]) adjustment. Conservative: only const>=0 and add/mul of
// non-negatives; sub/div/mod/neg are never assumed non-negative.
fn ir_reg_nn(rt: dict, reg: string) -> int
    let k = "@nn@" + reg
    if contains(rt, k)
        return rt[k]
    0

// ── S4.1 single-reference taint ───────────────────────────────────────────────
// A list slot keeps its intlist/floatlist FAST read typing only while it is the SOLE
// reference to its object. The moment the object also becomes reachable through another
// name -- aliased to a second slot, passed to a user function, stored in a container,
// captured by a closure, or returned -- a heterogeneous mutation through that other
// reference (e.g. a callee appending a float into an int list: the pre-existing escape
// bug) can put a boxed pointer into a slot the compiler still believes is raw int/double,
// and the native read would reinterpret it. A compile-time proof of "stays homogeneous"
// is NOT possible without alias analysis NOVA lacks, so we INVERT it: such a slot is
// TAINTED and its reads fall back to the sound generic path (regime B). The runtime stays
// the source of truth for the kept-fast (regime A, single-reference) lists. Conservative
// by construction: only in-place ops on the slot itself are exempt; ANY escape taints
// (a false taint = slower-but-correct; never unsound).
fn ir_is_list_slotreg(rt: dict, st: dict, reg: string) -> string
    let sk = "@slot@" + reg
    if contains(rt, sk)
        let slot = rt[sk]
        if contains(st, slot)
            let t = st[slot]
            if t == "intlist" or t == "floatlist" or t == "list"
                return slot
    return ""

fn ir_taint_list_slot(st: dict, slot: string)
    if slot != ""
        st["@taint@" + slot] = "1"

// A list value's loaded register is used SAFELY (no lasting alias, no heterogeneous mutation
// reachable through another name) ONLY as the subject (args[0]) of an in-place list operation:
// index read/write, len, append, sort, print, to_str, for-iteration -- ALL of which are the
// index_get/index_set ops or calls to nova_rt_* builtins with the list at args[0] (none retain a
// lasting reference; NOVA deep-copies across channel/spawn boundaries). EVERY other position --
// a user-function argument, args[1+] of a builtin (stored INTO another container), a copy /
// slot_store into another name, a return, a struct/dict/closure capture -- makes the object
// co-reachable and is UNSAFE -> taint. Default-taint by construction (immune to op-shape changes
// from ir_optimize): a false taint is slower-but-correct; never unsound.
fn ir_safe_list_use(op: string, value: string, pos: int) -> bool
    if pos != 0
        return false
    if op == "index_get" or op == "index_set"
        return true
    if op == "call" and starts_with(value, "nova_rt_")
        // sort / sort_by RETURN THE SAME handle (in-place) -> `let ys = sort(xs)` makes ys alias xs
        // while xs keeps its untainted fast typing; mutating ys then reading xs raw would corrupt.
        // Treat them as NOT safe so xs is tainted when passed (the returned alias can escape). Every
        // other list-returning builtin (reverse/map/filter/slice/concat/repeat) builds a NEW list.
        if value == "nova_rt_list_sort" or value == "nova_rt_sort_by"
            return false
        return true
    return false

fn ir_scan_list_taint(rt: dict, st: dict, op: string, args: list, value: string)
    let i = 0
    for a in args
        let slot = ir_is_list_slotreg(rt, st, a)
        if slot != ""
            if not ir_safe_list_use(op, value, i)
                ir_taint_list_slot(st, slot)
        i = i + 1
    // Aliasing store `let ys = xs`: the stored register names a list slot AND the dest slot
    // differs -> the dest now aliases the same object; taint IT too so its own reads fall back.
    if op == "slot_store" and len(args) >= 1
        let ss_src = ir_is_list_slotreg(rt, st, args[0])
        if ss_src != "" and ss_src != value
            ir_taint_list_slot(st, value)
        // S2: a non-empty int-literal source marks its slot @hadint@ (has int elements),
        // so a subsequent float push cannot promote it to floatlist.
        if contains(rt, "@regihad@" + args[0])
            st["@hadint@" + value] = "1"

fn ir_infer_one(rt: dict, st: dict, frt: dict, inst: IrInst) -> IrInst
    match inst
        IrInst(op, dest, typ, args, value, num, effect, line) =>
            ir_scan_list_taint(rt, st, op, args, value)
            if op == "const_int"
                if typ.kind == "bool"
                    rt[dest] = "bool"
                    rt["@nn@" + dest] = 1
                    return IrInst(op, dest, typ, args, value, num, effect, line)
                rt[dest] = "int"
                if num >= 0
                    rt["@nn@" + dest] = 1
                // LOCK-4 inc3b: preserve a sized literal's width so downstream +/-/* wrap at width.
                if typ.name != ""
                    rt["@w@" + dest] = typ.name
                    return IrInst(op, dest, ir_type_int_w(typ.name), args, value, num, effect, line)
                return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
            else if op == "const_float"
                rt[dest] = "float"
                if typ.name != ""
                    rt["@w@" + dest] = typ.name
                    return IrInst(op, dest, ir_type_float_w(typ.name), args, value, num, effect, line)
                return IrInst(op, dest, ir_type_float(), args, value, num, effect, line)
            else if op == "const_str"
                rt[dest] = "str"
                return IrInst(op, dest, ir_type_str(), args, value, num, effect, line)
            else if op == "fn_ptr_of"
                rt[dest] = "int"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
            else if op == "inline_asm"
                // 7.1: always i64. Without this the result register has no recorded type and
                // downstream consumers guess -- the exact "missing type-tracking entry" class
                // that caused the emitBinary ADD segfault (compiler-architecture.md rule 2).
                rt[dest] = "int"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
            else if op == "add"
                if len(args) == 2 and ir_reg_nn(rt, args[0]) == 1 and ir_reg_nn(rt, args[1]) == 1
                    rt["@nn@" + dest] = 1
                let lt = ir_reg_type(rt, args[0])
                let rty = ir_reg_type(rt, args[1])
                if lt == "float" and rty == "float"
                    return _ir_float_res(rt, op, dest, args, "", num, effect, line)
                if lt == "float" and rty == "int"
                    return _ir_float_res(rt, op, dest, args, "R", num, effect, line)
                if lt == "int" and rty == "float"
                    return _ir_float_res(rt, op, dest, args, "L", num, effect, line)
                if lt == "int" and rty == "int"
                    rt[dest] = "int"
                    // LOCK-4 inc3b: propagate the sized width so the result wraps at width in the
                    // backend (add/sub/mul). inc3a's unifier already rejects mixed widths, so at IR
                    // level the non-default width simply wins; "" = default i64 (byte-identical codegen).
                    let _wl = ir_reg_width(rt, args[0])
                    let _wr = ir_reg_width(rt, args[1])
                    let _wres = _wl
                    if _wres == ""
                        _wres = _wr
                    if _wres != ""
                        rt["@w@" + dest] = _wres
                        return IrInst(op, dest, ir_type_int_w(_wres), args, value, num, effect, line)
                    return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
                else if lt == "str" or rty == "str"
                    rt[dest] = "str"
                    return IrInst(op, dest, ir_type_str(), args, value, num, effect, line)
                else if lt == "list" or rty == "list" or lt == "intlist" or rty == "intlist"
                    rt[dest] = "list"
                    return IrInst("call", dest, ir_type_any(), args, "nova_rt_list_concat", num, effect, line)
                rt[dest] = "any"
                return inst
            else if op == "sub" or op == "mul" or op == "div" or op == "mod"
                if op == "mul" and len(args) == 2 and ir_reg_nn(rt, args[0]) == 1 and ir_reg_nn(rt, args[1]) == 1
                    rt["@nn@" + dest] = 1
                let lt = ir_reg_type(rt, args[0])
                let rty = ir_reg_type(rt, args[1])
                if lt == "float" and rty == "float"
                    return _ir_float_res(rt, op, dest, args, "", num, effect, line)
                if lt == "float" and rty == "int"
                    return _ir_float_res(rt, op, dest, args, "R", num, effect, line)
                if lt == "int" and rty == "float"
                    return _ir_float_res(rt, op, dest, args, "L", num, effect, line)
                if lt == "int" and rty == "int"
                    rt[dest] = "int"
                    // LOCK-4 inc3b: propagate the sized width so the result wraps at width in the
                    // backend (add/sub/mul). inc3a's unifier already rejects mixed widths, so at IR
                    // level the non-default width simply wins; "" = default i64 (byte-identical codegen).
                    let _wl = ir_reg_width(rt, args[0])
                    let _wr = ir_reg_width(rt, args[1])
                    let _wres = _wl
                    if _wres == ""
                        _wres = _wr
                    if _wres != ""
                        rt["@w@" + dest] = _wres
                        return IrInst(op, dest, ir_type_int_w(_wres), args, value, num, effect, line)
                    return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
                if op == "mul" and len(args) == 2
                    if lt == "str" and rty == "int"
                        rt[dest] = "str"
                        return IrInst("call", dest, ir_type_str(), args, "nova_rt_repeat", num, "impure", line)
                    if lt == "int" and rty == "str"
                        rt[dest] = "str"
                        return IrInst("call", dest, ir_type_str(), [args[1], args[0]], "nova_rt_repeat", num, "impure", line)
                    if (lt == "list" or lt == "intlist") and rty == "int"
                        rt[dest] = "list"
                        return IrInst("call", dest, ir_type_any(), args, "nova_rt_list_repeat", num, "impure", line)
                    if lt == "int" and (rty == "list" or rty == "intlist")
                        rt[dest] = "list"
                        return IrInst("call", dest, ir_type_any(), [args[1], args[0]], "nova_rt_list_repeat", num, "impure", line)
                rt[dest] = "any"
                return IrInst(op, dest, ir_type_any(), args, value, num, effect, line)
            else if op == "neg"
                let lt = ir_reg_type(rt, args[0])
                if lt == "float"
                    return _ir_float_res(rt, op, dest, args, value, num, effect, line)
                if lt == "int"
                    rt[dest] = "int"
                    // LOCK-4 inc3b: `-x` of a sized value wraps at width (e.g. -(1u8) == 255u8).
                    let _wn = ir_reg_width(rt, args[0])
                    if _wn != ""
                        rt["@w@" + dest] = _wn
                        return IrInst(op, dest, ir_type_int_w(_wn), args, value, num, effect, line)
                    return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
                // CORE_GAP 0.3: a neg of an `any` operand (e.g. a boxed float list element) is `any`,
                // NOT int -- so print/str dispatch stays box-aware and the value isn't read as raw int.
                // (Mirrors the sub/mul/div/mod `any` fallback above.)
                rt[dest] = "any"
                return IrInst(op, dest, ir_type_any(), args, value, num, effect, line)
            else if op == "eq" or op == "neq"
                let lt = ir_reg_type(rt, args[0])
                let rty = ir_reg_type(rt, args[1])
                let itype = ir_type_any()
                let promote = ""
                if lt == "float" and rty == "float"
                    itype = ir_type_float()
                else if lt == "float" and rty == "int"
                    itype = ir_type_float()
                    promote = "R"
                else if lt == "int" and rty == "float"
                    itype = ir_type_float()
                    promote = "L"
                else if lt == "int" and rty == "int"
                    itype = ir_type_int()
                else if lt == "str" and rty == "str"
                    itype = ir_type_str()
                // Soundness: str vs a DYNAMIC operand (any/val) must NOT take the raw strcmp path
                // (`str OR str` did) — a dynamic value can hold an int (e.g. dict["missing"] -> 0), and
                // inttoptr+strcmp on that non-pointer segfaults. Fall through to itype=any -> box-aware
                // nova_rt_eq, which tag-checks (small-int operand -> returns not-equal, never derefs).
                // str==str stays the fast strcmp path; str==int is already a compile error upstream.
                // A comparison YIELDS a bool, whatever its operands are. The instruction's own
                // IrType above stays the OPERAND type (it selects the float/str/int compare
                // variant) -- only the RESULT register type changes here. Typing it "int" made
                // str()/print() render 1/0 instead of true/false: `print(x == y)` printed 1.
                rt[dest] = "bool"
                return IrInst(op, dest, itype, args, promote, num, effect, line)
            else if op == "lt" or op == "le" or op == "gt" or op == "ge"
                let lt = ir_reg_type(rt, args[0])
                let rty = ir_reg_type(rt, args[1])
                if lt == "float" and rty == "float"
                    rt[dest] = "bool"
                    return IrInst(op, dest, ir_type_float(), args, "", num, effect, line)
                if lt == "float" and rty == "int"
                    rt[dest] = "bool"
                    return IrInst(op, dest, ir_type_float(), args, "R", num, effect, line)
                if lt == "int" and rty == "float"
                    rt[dest] = "bool"
                    return IrInst(op, dest, ir_type_float(), args, "L", num, effect, line)
                // Soundness (sibling of the 0.9 eq/neq fix): str vs a DYNAMIC operand (any/val) must NOT
                // take the raw strcmp-ordering path (`str OR str` did) — a dynamic value can hold an int
                // (e.g. dict["missing"] -> 0), and inttoptr+strcmp on that non-pointer segfaults. Fall
                // through to itype=any -> box-aware nova_rt_lt/le/gt/ge (nova_rt_cmp tag-checks: strcmp
                // only when BOTH are strings, else unbox+int-compare — never derefs a small int).
                // str<str keeps the fast strcmp path; str<int (both static) is a compile error upstream.
                if lt == "str" and rty == "str"
                    rt[dest] = "bool"
                    return IrInst(op, dest, ir_type_str(), args, value, num, effect, line)
                if lt == "int" and rty == "int"
                    rt[dest] = "bool"
                    // The comparison's own IrType still carries the operand WIDTH so the backend
                    // emits the right sized compare, but the RESULT is a 0/1 bool -- it must NOT
                    // inherit @w@, or a `u8` operand would make the backend mask the boolean.
                    let _wl = ir_reg_width(rt, args[0])
                    let _wr = ir_reg_width(rt, args[1])
                    let _wres = _wl
                    if _wres == ""
                        _wres = _wr
                    if _wres != ""
                        return IrInst(op, dest, ir_type_int_w(_wres), args, value, num, effect, line)
                    return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
                rt[dest] = "bool"
                return IrInst(op, dest, ir_type_any(), args, value, num, effect, line)
            else if op == "not" or op == "and" or op == "or"
                // Logical ops yield a bool as well -- `str(not true)` printed 0, not "false".
                rt[dest] = "bool"
                return IrInst(op, dest, ir_type_int(), args, value, num, effect, line)
            else if op == "slot_load"
                let stype = "any"
                if contains(st, value)
                    stype = st[value]
                // S4.1: do NOT demote the slot's list TYPE on taint. Demoting intlist->list cascaded
                // into the int-vs-float aggregate selection (list_min/max/sum use the int variant ONLY
                // for "intlist"; "list" -> float variant -> 1 becomes 1.0) and floatlist->list mixed a
                // boxed read into raw-float math (e-156 garbage). Both broke real tests (math3d/track7).
                // Soundness for a tainted (escaped/aliased) list is enforced at the index_get READ
                // instead (see the index_get gate), which returns a generic boxed value without
                // changing the list's type. Broader consumers (print/min/max of an escaped list that
                // actually went heterogeneous) are closed in S4.2 (runtime deopt).
                rt[dest] = stype
                rt["@slot@" + dest] = value
                if contains(st, "@nn@" + value) and st["@nn@" + value] == 1
                    rt["@nn@" + dest] = 1
                // LOCK-4 inc3c-part2 — SLOT WIDTH FLOW (the core of inc3c-part2). A sized value
                // that went through a slot comes back out sized, so a RUNTIME-valued sized var
                // wraps. const-fold only covers slots it can forward a constant through; this
                // covers the general case (loop accumulators, fn results, reassignment).
                if stype == "int"
                    let _slw = "@sw@" + value
                    if contains(st, _slw)
                        let _lw = st[_slw]
                        if _lw != ""
                            rt["@w@" + dest] = _lw
                            return IrInst(op, dest, ir_type_int_w(_lw), args, value, num, effect, line)
                // inc3c f32: the same flow for FLOAT slots. Without it the operands of
                // `let c: f32 = 0.1; let d: f32 = 0.2; c + d` were each narrowed but the SUM was
                // not rounded back, giving 0.300000004470348 -- the f32 inputs added in f64 --
                // instead of the true f32 result 0.300000011920929. Only "f32" is honoured:
                // "f64" is the default representation, so claiming it would emit a no-op round
                // on ordinary float code and perturb otherwise byte-identical output.
                if stype == "float"
                    let _slfw = "@sw@" + value
                    if contains(st, _slfw)
                        if st[_slfw] == "f32"
                            rt["@w@" + dest] = "f32"
                            return IrInst(op, dest, ir_type_float_w("f32"), args, value, num, effect, line)
                return IrInst(op, dest, IrType(stype, "", [], 0), args, value, num, effect, line)
            else if op == "slot_store"
                let val_type = ir_reg_type(rt, args[0])
                rt["@slot@" + args[0]] = value
                if contains(st, value)
                    if st[value] != val_type
                        let a_listish = st[value] == "list" or st[value] == "intlist" or st[value] == "floatlist"
                        let b_listish = val_type == "list" or val_type == "intlist" or val_type == "floatlist"
                        if a_listish and b_listish
                            st[value] = "list"
                        else
                            st[value] = "any"
                else
                    st[value] = val_type
                // LOCK-4 inc3c-part2 — record the stored value's width on the SLOT, as a
                // MONOTONIC lattice: absent (unknown) -> "<width>" -> "" (conflicted, absorbing).
                // Monotonicity is what makes this terminate. ir_infer_types iterates to a fixpoint
                // (capped at 3 passes), and a slot written with two different widths would
                // otherwise flip-flop forever; sinking to "" on ANY disagreement means each slot
                // changes state at most twice and the fixpoint is always reached. "" also means
                // "unsized" downstream, i.e. plain i64 — the safe direction to fail.
                let _stw = ir_reg_width(rt, args[0])
                let _stwk = "@sw@" + value
                if contains(st, _stwk)
                    if st[_stwk] != _stw
                        st[_stwk] = ""
                else
                    st[_stwk] = _stw
                let store_nn = ir_reg_nn(rt, args[0])
                if contains(st, "@nn@" + value)
                    if store_nn == 0
                        st["@nn@" + value] = 0
                else
                    st["@nn@" + value] = store_nn
                return inst
            else if op == "call"
                // LOCK-4 inc3c: an EXPLICIT width conversion produces a value OF THAT WIDTH.
                // nova_rt_to_u8(x) already masks its argument, but the result register carried
                // no width, so `let a = u8(255); a + 1` gave 256 instead of 0 -- the conversion
                // was a one-shot mask rather than a change of type. Recording the width here
                // makes the whole existing inc3b propagate+mask chain apply to conversions, and
                // it is also what makes an ANNOTATED binding work: `let y: u8 = 255` lowers to
                // `u8(255)`, so the slot inherits the width from this one place.
                // f32()/f64() return a FLOAT. Typing their result "int" like the integer
                // conversions would make str() lower to int_to_str and print the raw double
                // bits as an integer -- f32(16777217.0) printed 4715268809856909312.
                if value == "nova_rt_to_f32" or value == "nova_rt_to_f64"
                    if dest != ""
                        rt[dest] = "float"
                        if value == "nova_rt_to_f32"
                            rt["@w@" + dest] = "f32"
                    if value == "nova_rt_to_f32"
                        return IrInst(op, dest, ir_type_float_w("f32"), args, value, num, effect, line)
                    return IrInst(op, dest, ir_type_float(), args, value, num, effect, line)
                let _cvw = _rt_conv_width(value)
                if _cvw != "" and len(args) == 1
                    if dest != ""
                        rt[dest] = "int"
                        rt["@w@" + dest] = _cvw
                    return IrInst(op, dest, ir_type_int_w(_cvw), args, value, num, effect, line)
                // S4.2 escape-survival: floatlist_view(xs) is a runtime identity whose RESULT is typed
                // "floatlist" on a fresh (untainted) register, so a post-escape xs[j] read reached via
                // this view takes the native list_get_f path (:14836). SOUND only because the compiler
                // emits it under a list_is_kind2(xs) guard (elem_kind==2 => provably all raw doubles).
                if value == "nova_rt_floatlist_view" and len(args) == 1
                    if dest != ""
