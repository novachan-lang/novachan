    // Typed Result<T,E> / Option<T>. Result := nt_sum(T,E); Option := nt_sum(T,unit).
    // The unifier already handles the "sum" kind component-wise and `any` is
    // permissive, so this catches genuine unwrap/type-mismatch errors while code
    // flowing `any` still type-checks. RT=T, RE=E, RU=U (fresh per instantiation).
    let RT = nt_var(-1)
