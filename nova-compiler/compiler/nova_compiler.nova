                // bug. NOVA wraps on overflow, so a shift that moves every bit out is 0 (shl) / sign-ext
                // (ashr). Mask the amount to 0..63 for a valid shift, then `select` the defined big-shift
                // result. LLVM -O2 constant-folds this to a bare shift when the amount is a known constant
                // (the common case), so zero runtime cost there; a variable amount keeps the guard.
                let _sh_amt = dest + ".shamt"
                ire_indent(e, _sh_amt + " = and i64 " + args[1] + ", 63")
                let _sh_big = dest + ".shbig"
                ire_indent(e, _sh_big + " = icmp uge i64 " + args[1] + ", 64")
                let _sh_val = dest + ".shval"
                ire_indent(e, _sh_val + " = shl i64 " + args[0] + ", " + _sh_amt)
                ire_indent(e, dest + " = select i1 " + _sh_big + ", i64 0, i64 " + _sh_val)
            else if op == "shr"
                let _sr_amt = dest + ".sramt"
                ire_indent(e, _sr_amt + " = and i64 " + args[1] + ", 63")
                let _sr_big = dest + ".srbig"
                ire_indent(e, _sr_big + " = icmp uge i64 " + args[1] + ", 64")
                let _sr_val = dest + ".srval"
                ire_indent(e, _sr_val + " = ashr i64 " + args[0] + ", " + _sr_amt)
                let _sr_ext = dest + ".srext"
                ire_indent(e, _sr_ext + " = ashr i64 " + args[0] + ", 63")
                ire_indent(e, dest + " = select i1 " + _sr_big + ", i64 " + _sr_ext + ", i64 " + _sr_val)
            else if op == "bitnot"
                ire_indent(e, dest + " = xor i64 " + args[0] + ", -1")
            else if op == "slot_load"
                ire_indent(e, dest + " = load i64, ptr %slot." + value + ", align 8")
                let slot_key = "slot." + value
                if contains(e.ire_reg_types, slot_key)
                    e.ire_reg_types[dest] = e.ire_reg_types[slot_key]
                // Track 8: propagate local-list status from slot to load result.
                if contains(e.ire_local_slots, value)
                    e.ire_local_lists[dest] = 1
                // Track 8 W5b: remember which slot this register came from so
                // the return-time auto-drop pass can skip freeing the slot
                // whose value is being returned.
                e.ire_load_origin[dest] = value
            else if op == "slot_addr"
                // For 'out<T>' FFI args: take the address of a NOVA variable's
                // alloca slot, as an i64. The wrapper inttoptr's it to ptr,
                // C writes through, NOVA reads via subsequent slot_load.
                ire_indent(e, dest + " = ptrtoint ptr %slot." + value + " to i64")
            else if op == "slot_store"
                // total-RC Stage 3 (NOVA_T8_FULLRC): if the pre-pass proved this slot is
                // always-OWNED + never-escaped, rc_dec the value it currently holds before the
                // overwrite -- this is what frees the previous loop iteration's allocation (the
                // headline leak). nova_rt_rc_drop_reassign skips a self-store and is
                // pointer-validated, so the only values dropped here are uniquely-owned heap
                // handles. The set is EMPTY unless NOVA_T8_FULLRC=1 -> no-op + byte-identical off.
                if contains(e.ire_fullrc_drop, value)
                    let _frc_old = ire_fresh_tmp(e, "frcold." + value)
                    ire_indent(e, _frc_old + " = load i64, ptr %slot." + value + ", align 8")
                    ire_indent(e, "call i64 @nova_rt_rc_drop_reassign(i64 " + _frc_old + ", i64 " + args[0] + ")")
                ire_indent(e, "store i64 " + args[0] + ", ptr %slot." + value + ", align 8")
                // Sound slot container-kind tracking: a slot adopts the stored value's
                // static kind, and is CLEARED (-> runtime dispatch) when that kind is
                // unknown. Previously the old kind was KEPT on an untyped store, so a
                // slot reassigned from e.g. a dict to a generic (list-returning) call
                // stayed "dict" and a later x[i]=v mis-specialized to nova_rt_dict_set
                // on a list -> segfault. Clearing forces the sound nova_rt_index_set
                // dispatcher; genuinely-typed slots (literals/list_create/typed stores)
                // keep their kind, so the inline fast path (and GATE-5 perf) is preserved.
                let _ss_cur = ""
                if contains(e.ire_reg_types, "slot." + value)
                    _ss_cur = e.ire_reg_types["slot." + value]
                if _ss_cur == "float" and contains(e.ire_reg_types, args[0]) and e.ire_reg_types[args[0]] == "float"
                    // PERF Stage 3.5: an ALWAYS-FLOAT slot (pre-marked "float" by the float-slot
                    // pre-pass — every store proven float-typed) storing a float value stays raw,
                    // so the matching slot_load skips nova_rt_unbox and LLVM mem2reg promotes the
                    // slot to a register. Only ever "float" here because the pre-pass set it.
                    e.ire_reg_types["slot." + value] = "float"
                else if contains(e.ire_reg_types, args[0]) and e.ire_reg_types[args[0]] != "float"
                    e.ire_reg_types["slot." + value] = e.ire_reg_types[args[0]]
                else
                    // Soundness: never propagate "float" onto a slot that the pre-pass did NOT
                    // prove always-float. A general slot can be reassigned a boxed value on
                    // another path; the reg-type map is flat (not control-flow sensitive), so a
                    // wrongly-"float" slot would let a later load skip the unbox on a boxed value
                    // (exactly what broke nn/stats in Stage-2 attempt 1). Container-kind
                    // (list/dict) propagation above is unaffected.
                    e.ire_reg_types["slot." + value] = ""
                // Track 8: if storing a local list into a slot, that slot
                // is now a local-list slot. Loads from it propagate.
                if contains(e.ire_local_lists, args[0])
                    e.ire_local_slots[value] = 1
                // Track 8 W5b soundness (iter-81, fixes the iter-80 blind spot): link the
                // STORED register back to its slot, so a later value-forward (the copy op at
                // a use site propagates load_origin) carries it and any escape of the
                // forwarded value marks THIS slot as non-droppable. Without this,
                // `let x = <fresh aggregate>; <wrap x into a returned/escaping aggregate>`
                // forwards the construction register (which has NO load_origin, since only
                // slot_load sets it) -> the make_list/append/call escape-mark misses -> W5b
                // frees x though it escaped -> the holder's later append overflows.
                // GUARD: only set when args[0] has no origin yet (a fresh construction
                // register). Never OVERWRITE an existing origin -- a value loaded from another
                // slot already points at its source slot, and redirecting it could drop that
                // source slot while a live alias holds the handle (a UAF -- the unsafe
                // direction). As written this only ADDS marks -> more slots skipped from the
                // W5b drop -> more leaks, NEVER fewer frees -> cannot introduce a UAF.
                // total-RC Stage 2 (iter-86) alias-gap closure: if the stored register was
                // LOADED from another slot (its ire_load_origin was set by slot_load), then this
                // store ALIASES that source slot's value (`let b = a`). The source slot must NOT
                // be dropped while this alias holds the handle -> mark the source escaped. This
                // MUST run BEFORE the origin-linking below: at this point args[0] has an origin
                // ONLY if it came from a real slot_load (a genuine alias); a fresh construction
                // register has none yet (the next block links it), so `x = [fresh]` is NOT marked
                // and stays droppable -- the whole point of the leak fix. Conservative either way:
                // marks only ever ADD to the never-drop set (more leaks, never fewer frees).
                if contains(e.ire_load_origin, args[0])
                    e.ire_slot_escaped[e.ire_load_origin[args[0]]] = 1
                if not contains(e.ire_load_origin, args[0])
                    e.ire_load_origin[args[0]] = value
            else if op == "call"
                let call_inlined = false
                // P4 distributed: a program that calls call_by_name / remote_spawn needs
                // its functions registered by name at @main init — flag it so the prologue
                // emits nova_rt_register_fn(...) for each user fn (else: zero cost).
                if value == "nova_rt_call_by_name" or value == "nova_rt_remote_spawn"
                    e.ire_uses_byname = 1
                // BEAT C: inline the float math builtins to LLVM hardware intrinsics
                // (@llvm.sqrt.f64 -> sqrtsd) when the arg is a PROVEN raw double. C compiles
                // sqrt(x) to one sqrtsd; NOVA was doing a runtime call (the math-loop gap).
                // We BEAT C here because llvm.sqrt has no libm errno-check branch. SOUNDNESS:
                // gated on ire_proven_float (set ONLY by float-PRODUCING SSA sites, never by
                // slot_load), so a wrongly-marked-float slot value is never bitcast — those
                // fall back to the defensive nova_rt_* runtime call. (An earlier version gated
                // on the flat ire_reg_types map and hung stats.nova; this is the sound fix.)
                let _mintr = ""
                if value == "nova_rt_sqrt"
                    _mintr = "llvm.sqrt.f64"
                else if value == "nova_rt_sin"
                    _mintr = "llvm.sin.f64"
                else if value == "nova_rt_cos"
                    _mintr = "llvm.cos.f64"
                else if value == "nova_rt_exp"
                    _mintr = "llvm.exp.f64"
                else if value == "nova_rt_log"
                    _mintr = "llvm.log.f64"
                else if value == "nova_rt_log2"
                    _mintr = "llvm.log2.f64"
                else if value == "nova_rt_log10"
                    _mintr = "llvm.log10.f64"
                else if value == "nova_rt_fabs"
                    _mintr = "llvm.fabs.f64"
                else if value == "nova_rt_floor"
                    _mintr = "llvm.floor.f64"
                else if value == "nova_rt_ceil"
                    _mintr = "llvm.ceil.f64"
                if _mintr != "" and len(args) == 1 and dest != "" and contains(e.ire_proven_float, args[0])
                    ire_indent(e, dest + ".ai = bitcast i64 " + args[0] + " to double")
                    ire_indent(e, dest + ".rf = call double @" + _mintr + "(double " + dest + ".ai)")
                    ire_indent(e, dest + " = bitcast double " + dest + ".rf to i64")
                    ire_mark_float(e, dest)
                    call_inlined = true
                // SOUNDNESS FIX (2026-06-22): a `call nova_rt_index_set` on a typed list USED to inline a raw
                // getelementptr+store with NO upper-bound check (it loaded size only to adjust a negative
                // index) -> xs[5000000]=999 on a 3-elem list = wild store / ACCESS_VIOLATION (confirmed under
                // ASAN). It is now NOT inlined: the call stays a real call to nova_rt_index_set, which
                // bounds-checks (nova_rt_list_set: negative-index + index>=size -> soft error, no store).
                // Reclaiming the inline-store speed SAFELY (a guarded fast-path) is the S4 typed-array follow-on.
                if value == "nova_rt_index_get" and len(args) == 2
                    let tgt_kind = ""
                    if contains(e.ire_reg_types, args[0])
                        tgt_kind = e.ire_reg_types[args[0]]
                    if tgt_kind == "list"
                        // S4.2 SOUNDNESS: this inline (originally load data[i] + nova_rt_unbox, used
                        // for tuple/destructure element reads) misreads a kind=2 raw-double list --
                        // the raw IEEE bits handed to nova_rt_unbox can collide with a box-pointer
                        // pattern (find_tag false positive -> wild deref). nova_rt_list_get_f is the
                        // EXACT kind-aware equivalent: kind=0 -> nova_rt_unbox(data[i]) (identical to
                        // the old inline), kind=2 -> the raw bits directly (no unbox, no find_tag), and
                        // it bounds/negative-index checks (which the inline lacked). Result is a raw
                        // double either way -- the existing consumer semantics are preserved.
                        ire_indent(e, dest + " = call i64 @nova_rt_list_get_f(i64 " + args[0] + ", i64 " + args[1] + ")")
                        call_inlined = true
                if (value == "nova_rt_list_create" or value == "nova_rt_list_create_filled") and dest != ""
                    e.ire_reg_types[dest] = "list"
                if (value == "nova_rt_for_iter_init" or value == "nova_rt_for_destr_init" or value == "nova_rt_for_kv_init") and len(args) == 1 and dest != ""
                    if contains(e.ire_reg_types, args[0])
                        if e.ire_reg_types[args[0]] == "list"
                            e.ire_reg_types[dest] = "list"
                if value == "nova_rt_dict_create" and dest != ""
                    e.ire_reg_types[dest] = "dict"
                if not call_inlined
                    // Track 8 Week 3 RC elision: if calling
                    // nova_rt_list_append on a list the escape analysis
                    // marked as process-local, route to the _no_rc
                    // variant (skips nova_rc_inc on the element).
                    let call_name = value
                    if value == "nova_rt_list_append" and len(args) > 0
                        if contains(e.ire_local_lists, args[0])
                            call_name = "nova_rt_list_append_no_rc"
                            // iter-82 W5b soundness: no_rc elides the INCREF (args[0] is local
                            // NOW), but args[0] may ESCAPE later (returned / wrapped in an
                            // aggregate), making the appended element reachable past this frame.
                            // The incref stays elided, but we must still mark the element's
                            // source slot so the W5b return-drop does NOT free it. This is the
                            // pvecx structural-sharing corruption: `copied` appended into a
                            // local `nc` that is then returned inside a PVec -> nc escapes, so
                            // copied is still reachable and must not be dropped. Conservative: a
                            // truly-local nc now leaks its slot-sourced elements (a leak, never
                            // a UAF). dict_set / index_set siblings were probed and are already
                            // sound (the dest is not in ire_local_lists), so only this path.
                            if len(args) >= 2 and contains(e.ire_load_origin, args[1])
                                e.ire_slot_escaped[e.ire_load_origin[args[1]]] = 1
                        else
                            // Track 8 W5b soundness: the destination escapes,
                            // so normal append took an incref on args[1]. If
                            // args[1] was loaded from a local slot, that slot
                            // now has a live reference held by the escaping
                            // container. W5b must NOT drop this slot at fn
                            // return — its value is still reachable.
                            if len(args) >= 2 and contains(e.ire_load_origin, args[1])
                                e.ire_slot_escaped[e.ire_load_origin[args[1]]] = 1
                    if value == "nova_rt_dict_set" and len(args) > 0
                        if contains(e.ire_local_lists, args[0])
                            call_name = "nova_rt_dict_set_no_rc"
                        else
                            // Same soundness rule for dict_set: the value
                            // (args[2]) was incref'd by the escaping dict.
                            if len(args) >= 3 and contains(e.ire_load_origin, args[2])
                                e.ire_slot_escaped[e.ire_load_origin[args[2]]] = 1
                    // Track 8 W5b soundness (general case): any other call may
                    // stash its arguments in the callee's data structures or
                    // return aliases of them. Be conservative — every slot
                    // that supplied an argument is considered escaped, except
                    // when the call is a _no_rc variant on a known-local
                    // container (handled above).
                    let _is_norc = call_name == "nova_rt_list_append_no_rc" or call_name == "nova_rt_dict_set_no_rc"
                    // #9 scope-exit reclamation (the leak fix): a container-MUTATOR (append/set family)
                    // RETAINS its value arg(s) into the container (rc_inc) but returns 0 and never aliases
                    // the CONTAINER out (verified: nova_rt_list_append/dict_set return 0). So args[0] (the
                    // container) does NOT escape by being mutated -- marking it escaped here is exactly what
                    // kept every push-built local list/dict from ever being reclaimed (the headline #9 leak).
                    // Skip args[0] for mutators; still mark the value arg(s) (they are now owned by the
                    // container, so must not be dropped independently). SOUND because a container that truly
                    // escapes is caught elsewhere: by the slot_store alias-mark (let y=x) above, by appearing
                    // as a VALUE arg at the site that stores it into another aggregate, or by the returned-slot
                    // guard. Monotone: this only REMOVES a spurious escape mark for a provably-non-escaping op.
                    let _is_mut = call_name == "nova_rt_list_append" or call_name == "nova_rt_list_append_fbox" or call_name == "nova_rt_list_append_bbox" or call_name == "nova_rt_list_append_fraw" or call_name == "nova_rt_dict_set" or call_name == "nova_rt_dict_set_fbox" or call_name == "nova_rt_dict_set_bbox"
                    if not _is_norc
                        let _cai = 0
                        if _is_mut
                            _cai = 1
                        while _cai < len(args)
                            if contains(e.ire_load_origin, args[_cai])
                                e.ire_slot_escaped[e.ire_load_origin[args[_cai]]] = 1
                            _cai = _cai + 1
                    // #15 S5 ABI: check if callee has by-value params
                    let _s5c_byval_list = []
                    if contains(e.ire_s5_byval, value)
                        _s5c_byval_list = e.ire_s5_byval[value]
                    // Build a quick lookup: param_idx -> struct_name
                    let _s5c_pmap = {}
                    let _s5c_bi = 0
                    while _s5c_bi < len(_s5c_byval_list)
                        let _s5c_entry = _s5c_byval_list[_s5c_bi]
                        _s5c_pmap[str(_s5c_entry[0])] = _s5c_entry[1]
                        _s5c_bi = _s5c_bi + 1
                    // GAP 2 S3 SOUNDNESS: nova_rt_list_append_fraw stores RAW double bits inline (kind=2).
                    // Its value arg may arrive BOXED-repr even though it is type `float` (e.g. a function's
                    // `-> float` return whose body went through nova_rt_mul on an `any`, or any value that
                    // flowed through a boxed slot). Storing a box POINTER as if it were raw double bits is the
                    // exact corruption the stats sort hit. Fix: float-LOAD the value to guaranteed-raw double
                    // bits first (ire_float_load is repr-aware — a no-op bitcast on a proven-raw SSA reg, an
                    // unbox on a box/unknown), then bitcast back to i64. Sound for both raw and boxed inputs.
                    if call_name == "nova_rt_list_append_fraw" and len(args) >= 2
                        let _fr_d = ire_fresh_tmp(e, "_fraw.d")
                        ire_float_load(e, _fr_d, args[1])
                        let _fr_b = ire_fresh_tmp(e, "_fraw.b")
                        ire_indent(e, _fr_b + " = bitcast double " + _fr_d + " to i64")
                        args[1] = _fr_b
                    let call_str = "call i64 @" + call_name + "("
                    let i = 0
                    let _s5c_first = 1
                    while i < len(args)
                        if contains(_s5c_pmap, str(i))
                            // Scalarize: GEP+load each field from the struct ptr
                            let _s5c_sn = _s5c_pmap[str(i)]
                            let _s5c_fields = e.ire_s5_sdefs[_s5c_sn]
                            // Get the ptr: either from ire_s5_struct_ptr (make_struct dest)
                            // or via inttoptr from the i64 value (slot-loaded struct pointer)
                            let _s5c_ptr = ""
                            if contains(e.ire_s5_struct_ptr, args[i])
                                _s5c_ptr = e.ire_s5_struct_ptr[args[i]]
                            else
                                _s5c_ptr = ire_fresh_tmp(e, "_s5c.itp")
                                ire_indent(e, _s5c_ptr + " = inttoptr i64 " + args[i] + " to ptr")
                            let _s5c_fi = 0
                            for _s5c_fp in _s5c_fields
                                match _s5c_fp
                                    Param(_s5c_fpn, _s5c_fpt, _s5c_fpd) =>
                                        if _s5c_first == 0
                                            call_str = call_str + ", "
                                        _s5c_first = 0
                                        let _s5c_slot = _s5c_fi + 1
                                        let _s5c_gep = ire_fresh_tmp(e, "_s5c.gep")
                                        let _s5c_ld = ire_fresh_tmp(e, "_s5c.ld")
                                        ire_indent(e, _s5c_gep + " = getelementptr i64, ptr " + _s5c_ptr + ", i64 " + str(_s5c_slot))
                                        ire_indent(e, _s5c_ld + " = load i64, ptr " + _s5c_gep + ", align 8")
                                        if _s5c_fpt == "float"
                                            let _s5c_bc = ire_fresh_tmp(e, "_s5c.bc")
                                            ire_indent(e, _s5c_bc + " = bitcast i64 " + _s5c_ld + " to double")
                                            call_str = call_str + "double " + _s5c_bc
                                        else
                                            call_str = call_str + "i64 " + _s5c_ld
                                _s5c_fi = _s5c_fi + 1
                        else
                            if _s5c_first == 0
                                call_str = call_str + ", "
                            _s5c_first = 0
                            call_str = call_str + "i64 " + args[i]
                        i = i + 1
                    call_str = call_str + ")"
                    if dest != ""
                        ire_indent(e, dest + " = " + call_str)
                        // Beat-C: a float-typed call (the raw-double math builtins) returns raw
                        // double bits. Mark it so a consuming float op reads it via bitcast, not
                        // a defensive nova_rt_unbox. Mirrors fmul/const_float result tracking.
                        match typ
                            IrType(_ctk, _ctn, _ctp, _ctid) =>
                                if _ctk == "float"
                                    ire_mark_float(e, dest)
                    else
                        ire_indent(e, call_str)
            else if op == "make_struct"
                let is_repr_c = contains(e.ire_repr_c_types, value)
                let is_packed = contains(e.ire_repr_packed, value)
                let field_align = 8
                if is_packed
                    field_align = 1
                if contains(e.ire_repr_align, value)
                    field_align = e.ire_repr_align[value]
                let extra_slots = 1
                if is_repr_c
                    extra_slots = 0
                let size = (num + extra_slots) * 8
                let did_hash_alloc = false      // CORE_GAP 0.8: true when this struct is HASHED (rc_free bitmap-managed)
                if contains(e.ire_stackable, dest)
                    // Stage 4 SROA: dest.ptr is an entry-block alloca (hoisted above) — no heap
                    // allocation. The hash + field stores + ptrtoint below are unchanged; the
                    // struct lives on the stack frame (reclaimed on return, beats the leak-until-
                    // exit heap). LLVM may further promote it via mem2reg/SROA once 4b lands.
                    ire_indent(e, "; sroa stack struct " + dest)
                else if contains(e.ire_repr_align, value) and e.ire_repr_align[value] > 16
                    ire_indent(e, dest + ".ptr = call ptr @nova_rt_aligned_struct_alloc(i64 " + str(size) + ", i64 " + str(e.ire_repr_align[value]) + ")")
                else if is_repr_c
                    ire_indent(e, dest + ".ptr = call ptr @nova_rt_struct_alloc(i64 " + str(size) + ")")
                else
                    // CORE_GAP 0.8: normal (non-repr_c, non-over-aligned) struct -> HASHED alloc so
                    // nova_rc_free consults the per-type managed-slot bitmap to release heap fields.
                    ire_indent(e, dest + ".ptr = call ptr @nova_rt_hashed_struct_alloc(i64 " + str(size) + ")")
                    did_hash_alloc = true
                if not is_repr_c
                    let hash_val = type_name_hash(value)
                    let hash_gep = dest + ".thash"
                    ire_indent(e, hash_gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 0")
                    ire_indent(e, "store i64 " + fmt_i64_decimal(hash_val) + ", ptr " + hash_gep + ", align 8")
                    // Record (name -> slot-0 type hash) so @main can register it for
                    // runtime reflection: type_name(struct) reads slot 0 and looks up
                    // the concrete name. Dedup via the dict; zero per-construction cost.
                    e.ire_struct_types[value] = fmt_i64_decimal(hash_val)
                // CORE_GAP 0.8: positional field types for managed-slot ownership (same source as @sfkinds@).
                let _s8_ftypes = []
                if did_hash_alloc and contains(e.ire_s5_sdefs, value)
                    for _s8p in e.ire_s5_sdefs[value]
                        match _s8p
                            Param(_s8pn, _s8pt, _s8pd) =>
                                push(_s8_ftypes, _s8pt)
                let fi = 0
                while fi < len(args)
                    let gep = dest + ".f" + str(fi)
                    let slot_off = fi + extra_slots
                    ire_indent(e, gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 " + str(slot_off))
                    ire_indent(e, "store i64 " + args[fi] + ", ptr " + gep + ", align " + str(field_align))
                    if contains(e.ire_load_origin, args[fi])
                        e.ire_slot_escaped[e.ire_load_origin[args[fi]]] = 1
                    // CORE_GAP 0.8: the struct OWNS its managed fields. SHARE (rc_inc) a slot-sourced
                    // value (may be aliased/reused); MOVE (no inc) a fresh temp (struct takes its rc=1).
                    // rc_free dec's every managed slot via the bitmap, so both balance. Skip scalar
                    // (int/float/bool) fields (never dec raw bits) and fields >=63 (bitmap caps at 63).
                    if did_hash_alloc and fi < 63 and fi < len(_s8_ftypes)
                        if ire_field_is_managed(_s8_ftypes[fi])
                            if contains(e.ire_load_origin, args[fi])
                                ire_indent(e, "call void @nova_rc_inc(i64 " + args[fi] + ")")
                    fi = fi + 1
                ire_indent(e, dest + " = ptrtoint ptr " + dest + ".ptr to i64")
                // #15 S5 ABI: record .ptr name so call-site scalarization can GEP from it.
                // Record for ALL make_struct dests (both stackable and heap) so any caller
                // that passes this struct to a by-value callee can GEP-load the fields.
                e.ire_s5_struct_ptr[dest] = dest + ".ptr"
                e.ire_owned[dest] = 1        // total-RC S1: a freshly-built struct is OWNED. Inert metadata.
            else if op == "make_list"
                ire_indent(e, dest + " = call i64 @nova_rt_list_create()")
                let i = 0
                while i < len(args)
                    // value carries per-element box-kinds from the specializer:
                    // "f" -> box float, "b" -> box bool, else append raw.
                    let ev = args[i]
                    let kc = "."
                    if i < len(value)
                        kc = slice(value, i, i + 1)
                    if kc == "f"
                        let fb = dest + ".fb" + str(i)
                        ire_indent(e, fb + " = call i64 @nova_rt_box_float(i64 " + args[i] + ")")
                        ev = fb
                    else if kc == "b"
                        let bb = dest + ".bb" + str(i)
                        ire_indent(e, bb + " = call i64 @nova_rt_box_bool(i64 " + args[i] + ")")
                        ev = bb
                    ire_indent(e, "call i64 @nova_rt_list_append(i64 " + dest + ", i64 " + ev + ")")
                    if contains(e.ire_load_origin, args[i])
                        e.ire_slot_escaped[e.ire_load_origin[args[i]]] = 1
                    i = i + 1
                e.ire_reg_types[dest] = "list"
                e.ire_owned[dest] = 1        // total-RC S1: a freshly-built list is OWNED. Inert metadata.
            else if op == "make_dict"
                ire_indent(e, dest + " = call i64 @nova_rt_dict_create()")
                e.ire_reg_types[dest] = "dict"
                e.ire_owned[dest] = 1        // total-RC S1: a freshly-built dict is OWNED. Inert metadata.
            else if op == "index_get"
                e.ire_borrow_src[dest] = 1        // total-RC S1: an element read is BORROWED (still owned by the container). Inert metadata.
                let target_kind = ""
                if contains(e.ire_reg_types, args[0])
                    target_kind = e.ire_reg_types[args[0]]
                if target_kind == "list"
                    // S4.2 SOUNDNESS: the generic "list"-typed read MUST be kind-aware. An inline
                    // load of data[i] + unbox_elem misreads a kind=2 (raw-double) list -- the raw
                    // IEEE bits are handed to unbox_elem, which treats them as an int/box pointer
                    // (e.g. q[0]+q[1] on a push-built float list became an integer add of the bit
                    // patterns). A kind=2 list can reach this path when the read fails to specialize
                    // to nova_rt_list_get_f (store-to-load forwarding can rewrite slot_load->copy and
                    // drop the floatlist slot type). Route through nova_rt_list_get instead: it is
                    // BEHAVIOR-IDENTICAL to the old inline path for kind=0/1 (returns
                    // nova_rt_unbox_elem(data[i]), with negative-index + bounds handling the inline
                    // path lacked), and box-on-egress for kind=2 (returns a proper NOVA_BOX_FLOAT so
                    // no downstream find_tag/arith ever sees raw double bits). The typed-fast float
                    // read still uses nova_rt_list_get_f (raw double, no box) -- the perf win is kept
                    // where the read specializes; correctness is now independent of specialization.
                    if value == "fl"
                        ire_indent(e, dest + " = call i64 @nova_rt_list_get_f(i64 " + args[0] + ", i64 " + args[1] + ")")
                        ire_mark_float(e, dest)
                    else
                        ire_indent(e, dest + " = call i64 @nova_rt_list_get(i64 " + args[0] + ", i64 " + args[1] + ")")
                else if target_kind == "dict"
                    ire_indent(e, dest + " = call i64 @nova_rt_dict_get(i64 " + args[0] + ", i64 " + args[1] + ")")
                else
                    ire_indent(e, dest + " = call i64 @nova_rt_index_get(i64 " + args[0] + ", i64 " + args[1] + ")")
            else if op == "field_get"
                e.ire_borrow_src[dest] = 1        // total-RC S1: a field read is BORROWED (still owned by the struct). Inert metadata.
                let ptr_name = dest + ".ptr"
                ire_indent(e, ptr_name + " = inttoptr i64 " + args[0] + " to ptr")
                let gep = dest + ".gep"
                ire_indent(e, gep + " = getelementptr i64, ptr " + ptr_name + ", i64 " + str(num))
                ire_indent(e, dest + " = load i64, ptr " + gep + ", align 8")
                // PERF Stage 3: a float field is now guaranteed to hold RAW double bits
                // (every write narrows any->raw), so mark the read result "float" — the
                // Stage-2 ire_float_load then emits bitcast-only and skips nova_rt_unbox.
                match typ
                    IrType(fg_tk, fg_tn, fg_tp, fg_tid) =>
                        if fg_tk == "float"
                            ire_mark_float(e, dest)
            else if op == "field_set"
                // CORE_GAP 0.8: a scalar (int/float/bool) field stays an INLINE store (fast; preserves
                // SROA struct-math). A managed OR unknown-typed field routes through nova_rt_field_set,
                // which self-classifies the slot via the struct's managed-slot bitmap (consistent with
                // rc_free) and does inc-new/dec-old ownership. do_inc=1 when the new value is slot-sourced
                // (SHARE, may alias); 0 for a fresh temp (MOVE).
                let _fs_kind = ""
                match typ
                    IrType(_fstk, _fstn, _fstp, _fstid) =>
                        _fs_kind = _fstk
                if _fs_kind == "int" or _fs_kind == "float" or _fs_kind == "bool"
                    let ptr_name = dest + ".ptr"
                    ire_indent(e, ptr_name + " = inttoptr i64 " + args[0] + " to ptr")
                    let gep = dest + ".gep"
                    ire_indent(e, gep + " = getelementptr i64, ptr " + ptr_name + ", i64 " + str(num))
                    ire_indent(e, "store i64 " + args[1] + ", ptr " + gep + ", align 8")
                else
                    let _fs_do_inc = "0"
                    if len(args) >= 2 and contains(e.ire_load_origin, args[1])
                        _fs_do_inc = "1"
                    let _fs_r = ire_fresh_tmp(e, "_fs.r")
                    ire_indent(e, _fs_r + " = call i64 @nova_rt_field_set(i64 " + args[0] + ", i64 " + str(num) + ", i64 " + args[1] + ", i64 " + _fs_do_inc + ")")
                // W5b soundness: a struct field now holds a pointer to args[1].
                // If args[1] came from a local slot, dropping that slot at fn
                // return would dangle the struct's field. Skip drop.
                if len(args) >= 2 and contains(e.ire_load_origin, args[1])
                    e.ire_slot_escaped[e.ire_load_origin[args[1]]] = 1
            else if op == "index_set"
                let is_target_kind = ""
                if contains(e.ire_reg_types, args[0])
                    is_target_kind = e.ire_reg_types[args[0]]
                if is_target_kind == "list"
                    // SOUNDNESS FIX (2026-06-22): the former inline store skipped the upper-bound check
                    // (xs[5000000]=999 on a 3-elem list = wild store / ACCESS_VIOLATION, confirmed under ASAN;
                    // the num==1 branch did not even load the size). Route typed-list writes through the
                    // bounds-checking nova_rt_index_set (-> nova_rt_list_set: negative-index + index>=size ->
                    // soft error, no store), mirroring the read path's nova_rt_list_get_f. Box float/bool first
                    // (identical to the untyped path below). Reclaiming the inline store SAFELY = the S4 follow-on.
                    let is_lv = args[2]
                    if value == "fbox"
                        let is_lbx = ire_fresh_tmp(e, "_is.lbx")
                        ire_indent(e, is_lbx + " = call i64 @nova_rt_box_float(i64 " + args[2] + ")")
                        is_lv = is_lbx
                    if value == "bbox"
                        let is_lbbx = ire_fresh_tmp(e, "_is.lbbx")
                        ire_indent(e, is_lbbx + " = call i64 @nova_rt_box_bool(i64 " + args[2] + ")")
                        is_lv = is_lbbx
                    let is_lcv = ire_fresh_tmp(e, "_is.lcv")
                    ire_indent(e, is_lcv + " = call i64 @nova_rt_index_set(i64 " + args[0] + ", i64 " + args[1] + ", i64 " + is_lv + ")")
                    // W5b soundness: nova_rt_index_set -> list_set increfs the stored value; if it came from a
                    // local slot, mark that slot non-droppable (more marks only ever PREVENT frees -> never a UAF).
                    if contains(e.ire_load_origin, args[2])
                        e.ire_slot_escaped[e.ire_load_origin[args[2]]] = 1
                else if is_target_kind == "dict"
                    let is_dtmp = ire_fresh_tmp(e, "_is.dv")
                    let is_dfn = "nova_rt_dict_set"
                    if value == "fbox"
                        is_dfn = "nova_rt_dict_set_fbox"
                    if value == "bbox"
                        is_dfn = "nova_rt_dict_set_bbox"
                    // Track 8: route to _no_rc variant when the dict is local.
                    if is_dfn == "nova_rt_dict_set" and contains(e.ire_local_lists, args[0])
                        is_dfn = "nova_rt_dict_set_no_rc"
                    else if is_dfn == "nova_rt_dict_set" or is_dfn == "nova_rt_dict_set_fbox" or is_dfn == "nova_rt_dict_set_bbox"
                        // Escaping dict took an incref on args[2]; if that
                        // value came from a local slot, mark the slot as
                        // non-droppable (W5b soundness, see list_append).
                        if contains(e.ire_load_origin, args[2])
                            e.ire_slot_escaped[e.ire_load_origin[args[2]]] = 1
                    ire_indent(e, is_dtmp + " = call i64 @" + is_dfn + "(i64 " + args[0] + ", i64 " + args[1] + ", i64 " + args[2] + ")")
                else
                    let is_gtmp = ire_fresh_tmp(e, "_is.gv")
                    let is_gv = args[2]
                    if value == "fbox"
                        let is_gbx = ire_fresh_tmp(e, "_is.gbx")
                        ire_indent(e, is_gbx + " = call i64 @nova_rt_box_float(i64 " + args[2] + ")")
                        is_gv = is_gbx
                    if value == "bbox"
                        let is_gbbx = ire_fresh_tmp(e, "_is.gbbx")
                        ire_indent(e, is_gbbx + " = call i64 @nova_rt_box_bool(i64 " + args[2] + ")")
                        is_gv = is_gbbx
                    ire_indent(e, is_gtmp + " = call i64 @nova_rt_index_set(i64 " + args[0] + ", i64 " + args[1] + ", i64 " + is_gv + ")")
                    // W5b soundness: nova_rt_index_set dispatches to list_set
                    // or dict_set, both of which incref. Mark args[2]'s slot.
                    if contains(e.ire_load_origin, args[2])
                        e.ire_slot_escaped[e.ire_load_origin[args[2]]] = 1
            else if op == "list_len"
                let ll_lp = dest + ".lp"
                let ll_szp = dest + ".szp"
                ire_indent(e, ll_lp + " = inttoptr i64 " + args[0] + " to ptr")
                ire_indent(e, ll_szp + " = getelementptr i64, ptr " + ll_lp + ", i64 1")
                ire_indent(e, dest + " = load i64, ptr " + ll_szp + ", align 8, !tbaa !6")
            else if op == "copy"
                ire_indent(e, dest + " = add i64 " + args[0] + ", 0")
                if len(args) == 1 and contains(e.ire_reg_types, args[0])
                    e.ire_reg_types[dest] = e.ire_reg_types[args[0]]
                // W5b soundness: propagate load_origin so escapes from aliased
                // values still mark the original slot.
                if len(args) == 1 and contains(e.ire_load_origin, args[0])
                    e.ire_load_origin[dest] = e.ire_load_origin[args[0]]
            else if op == "make_closure"
                // Allocate closure record: [trampoline_ptr, cap0, cap1, ...]
                let record_size = (1 + num) * 8
                ire_indent(e, dest + ".ptr = call ptr @nova_rt_struct_alloc(i64 " + str(record_size) + ")")
                // Store trampoline function pointer at slot 0
                let tramp_gep = dest + ".tgep"
                ire_indent(e, tramp_gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 0")
                let tramp_val = dest + ".tfn"
                ire_indent(e, tramp_val + " = ptrtoint ptr @" + value + " to i64")
                ire_indent(e, "store i64 " + tramp_val + ", ptr " + tramp_gep + ", align 8")
                // Store captures at slots 1, 2, ...
                let ci = 0
                while ci < len(args)
                    let cap_gep = dest + ".c" + str(ci)
                    ire_indent(e, cap_gep + " = getelementptr i64, ptr " + dest + ".ptr, i64 " + str(ci + 1))
                    ire_indent(e, "store i64 " + args[ci] + ", ptr " + cap_gep + ", align 8")
                    // W5b soundness: every capture is now referenced by the
                    // closure, which can outlive this function. Mark source
                    // slots as escaped so W5b does NOT drop them.
                    if contains(e.ire_load_origin, args[ci])
                        e.ire_slot_escaped[e.ire_load_origin[args[ci]]] = 1
                    ci = ci + 1
                ire_indent(e, dest + " = ptrtoint ptr " + dest + ".ptr to i64")
                e.ire_owned[dest] = 1        // total-RC S1: a freshly-built closure record is OWNED. Inert metadata.
            else if op == "dyn_call"
                // Dynamic closure call: args[0] = closure record, args[1..] = call arguments
                // num = number of actual arguments (excluding closure record)
                let rec_ptr = dest + ".rec"
                ire_indent(e, rec_ptr + " = inttoptr i64 " + args[0] + " to ptr")
                let fn_raw = dest + ".fnraw"
                ire_indent(e, fn_raw + " = load i64, ptr " + rec_ptr + ", align 8")
                let fn_ptr = dest + ".fnptr"
                ire_indent(e, fn_ptr + " = inttoptr i64 " + fn_raw + " to ptr")
                // Build call: fn_ptr(closure_record, arg0, arg1, ...)
                let call_str = "call i64 " + fn_ptr + "(i64 " + args[0]
                let ai = 1
                while ai < len(args)
                    call_str = call_str + ", i64 " + args[ai]
                    ai = ai + 1
                call_str = call_str + ")"
                // W5b soundness: dyn_call may stash any of its args. Mark all
                // slot-origin args (including the closure record itself).
                let _dai = 0
                while _dai < len(args)
                    if contains(e.ire_load_origin, args[_dai])
                        e.ire_slot_escaped[e.ire_load_origin[args[_dai]]] = 1
                    _dai = _dai + 1
                if dest != ""
                    ire_indent(e, dest + " = " + call_str)
                else
                    ire_indent(e, call_str)
            else if op == "set_error"
                // task-local error state (Stage 0): emit a helper call, not direct TLS access
                if len(args) > 0
                    ire_indent(e, "call void @nova_rt_set_error_flag(i64 " + args[0] + ")")
                else
                    ire_indent(e, "call void @nova_rt_raise_error()")
                if dest != ""
                    ire_indent(e, dest + " = add i64 0, 0")
            else if op == "is_error"
                // take_error_flag returns the flag (0/1) AND clears it
                if dest != ""
                    ire_indent(e, dest + " = call i64 @nova_rt_take_error_flag()")
                else
                    ire_indent(e, "call i64 @nova_rt_take_error_flag()")
            else if op == "load_error_msg"
                if dest != ""
                    ire_indent(e, dest + " = call i64 @nova_rt_take_error_msg()")
                else
                    ire_indent(e, "call i64 @nova_rt_take_error_msg()")
            else if op == "raise_error"
                ire_indent(e, "call void @nova_rt_raise_error()")
            else if op == "wrap_error_ctx"
                if dest != ""
                    ire_indent(e, dest + " = call i64 @nova_rt_wrap_error_context(i64 " + args[0] + ", i64 " + args[1] + ", i64 " + args[2] + ")")
                else
                    ire_indent(e, "call i64 @nova_rt_wrap_error_context(i64 " + args[0] + ", i64 " + args[1] + ", i64 " + args[2] + ")")
            else if op == "clear_is_result"
                ire_indent(e, "call void @nova_rt_clear_is_result()")
            else if op == "try_unwrap_value"
                if dest != ""
                    ire_indent(e, dest + " = call i64 @nova_rt_try_unwrap_value(i64 " + args[0] + ")")
                else
                    ire_indent(e, "call i64 @nova_rt_try_unwrap_value(i64 " + args[0] + ")")
            e.ire_dbg_loc = saved_loc

fn ire_is_loop_header(label: string) -> int
    if contains(label, "for_body") or contains(label, "while_body")
        return 1
    return 0

fn ire_is_backedge(label: string) -> int
    if contains(label, "for_hdr") or contains(label, "while_hdr") or label == "tco_loop"
        return 1
    return 0

fn ire_emit_terminator(e: IrEmitter, term: IrInst)
    match term
        IrInst(op, dest, typ, args, value, num, effect, line) =>
            let saved_loc = e.ire_dbg_loc
            if line > 0 and e.ire_fn_sp_id != 0
                let line_loc = ire_get_line_loc(e, line)
                if line_loc != 0
                    e.ire_dbg_loc = line_loc
            if op == "return"
                if e.ire_dbg_instr_enabled == 1
                    let dpf_reg = "%dbg.pf" + str(e.ire_tc)
                    e.ire_tc = e.ire_tc + 1
                    ire_indent(e, dpf_reg + " = call i64 @nova_rt_dbg_pop_frame()")
                if len(args) > 0
                    let rv = args[0]
                    if e.ire_cur_fn_lambda == 1 and contains(e.ire_reg_types, args[0]) and e.ire_reg_types[args[0]] == "float"
                        let rbx = args[0] + ".retfbox"
                        ire_indent(e, rbx + " = call i64 @nova_rt_box_float(i64 " + args[0] + ")")
                        rv = rbx
                    ire_indent(e, "ret i64 " + rv)
                else
                    ire_indent(e, "ret i64 0")
            else if op == "goto"
                if ire_is_backedge(value) == 1
                    ire_indent(e, "br label %" + value)
                else
                    ire_indent(e, "br label %" + value)
            else if op == "branch"
                let cond_cmp = dest + ".br"
                let prof_hint = ""
                if ire_is_loop_header(value) == 1
                    prof_hint = ", !prof !90"
                if cond_cmp == ".br"
                    let cond_cmp2 = "%br_" + value + str(e.ire_tc)
                    e.ire_tc = e.ire_tc + 1
                    ire_indent(e, cond_cmp2 + " = icmp ne i64 " + args[0] + ", 0")
                    ire_indent(e, "br i1 " + cond_cmp2 + ", label %" + value + ", label %" + args[1] + prof_hint)
                else
                    ire_indent(e, cond_cmp + " = icmp ne i64 " + args[0] + ", 0")
                    ire_indent(e, "br i1 " + cond_cmp + ", label %" + value + ", label %" + args[1] + prof_hint)
            e.ire_dbg_loc = saved_loc

fn ire_collect_slots(blocks: list, param_names: list) -> list
    let slots = []
    for block in blocks
        match block
            IrBlock(label, insts, terminator) =>
                for inst in insts
                    match inst
                        IrInst(op, dest, typ, args, value, num, effect, line) =>
                            if (op == "slot_store" or op == "slot_load") and value != ""
                                if not list_contains(slots, value) and not list_contains(param_names, value)
                                    push(slots, value)
    slots

// Track 8 W8: classical iterative liveness on the IR's basic-block graph.
// Returns a dict mapping each block label to the SET of slot names that
// are live at the END of that block (any successor still needs them).
//
// Algorithm (textbook backward dataflow):
//   use[B]      = slots read in B before being written in B
//   def[B]      = slots written in B
//   live_in[B]  = use[B] ∪ (live_out[B] - def[B])
//   live_out[B] = ∪ live_in[S] for each successor S of B
//
// Successors come from the block's terminator:
//   return     → no successors
//   goto L     → [L]                 (target in value)
//   branch L F → [L, F]              (true in value, false in args[1])
fn ire_liveness(blocks: list, slot_names: list) -> dict
    let n = len(blocks)
    let use_set = {}
    let def_set = {}
    let succ_map = {}
    for blk in blocks
        match blk
            IrBlock(lbl, insts, term) =>
                let bu = {}
                let bd = {}
                for inst in insts
                    match inst
                        IrInst(op, _, _, _, value, _, _, _) =>
                            if op == "slot_load" and list_contains(slot_names, value)
                                if not contains(bd, value)
                                    bu[value] = 1
                            if op == "slot_store" and list_contains(slot_names, value)
                                bd[value] = 1
                use_set[lbl] = bu
                def_set[lbl] = bd
                let succs = []
                match term
                    IrInst(top, _, _, targs, tvalue, _, _, _) =>
                        if top == "goto"
                            if tvalue != ""
                                push(succs, tvalue)
                        else if top == "branch"
                            if tvalue != ""
                                push(succs, tvalue)
                            if len(targs) >= 2
                                push(succs, targs[1])
                succ_map[lbl] = succs
    let live_in = {}
    let live_out = {}
    for blk in blocks
        match blk
            IrBlock(lbl, _, _) =>
                live_in[lbl] = {}
                live_out[lbl] = {}
    let changed = true
    let iters = 0
    while changed and iters < 64
        changed = false
        iters = iters + 1
        let i = n - 1
        while i >= 0
            match blocks[i]
                IrBlock(lbl, _, _) =>
                    let new_out = {}
                    for s in succ_map[lbl]
                        if contains(live_in, s)
                            for k in keys(live_in[s])
                                new_out[k] = 1
                    let new_in = {}
                    for k in keys(use_set[lbl])
                        new_in[k] = 1
                    for k in keys(new_out)
                        if not contains(def_set[lbl], k)
                            new_in[k] = 1
                    if len(keys(new_out)) != len(keys(live_out[lbl]))
                        changed = true
                    else
                        for k in keys(new_out)
                            if not contains(live_out[lbl], k)
                                changed = true
                    if len(keys(new_in)) != len(keys(live_in[lbl]))
                        changed = true
                    else
                        for k in keys(new_in)
                            if not contains(live_in[lbl], k)
                                changed = true
                    live_out[lbl] = new_out
                    live_in[lbl] = new_in
            i = i - 1
    live_out

fn ire_emit_function(e: IrEmitter, func: IrFunction)
    // Reset per-function state — including Track 8 W5b local slot set
    // so drops from a previous function don't leak into this one.
    e.ire_reg_types = {}
    e.ire_tc = 0
    e.ire_local_slots = {}
    e.ire_load_origin = {}
    e.ire_slot_escaped = {}
    e.ire_dropped = {}
    e.ire_borrow_src = {}        // total-RC S1: per-function reset (CVE-class -- borrow provenance must not leak across fn boundaries)
    e.ire_owned = {}             // total-RC S1: per-function reset (owned provenance must not leak across fn boundaries)
    e.ire_fullrc_drop = {}       // total-RC S3: per-function reset (recomputed by the pre-pass below when NOVA_T8_FULLRC=1)
    e.ire_s5_struct_ptr = {}     // #15 S5 ABI: per-function reset (populated by make_struct emission for stackable dests)
    match func
        IrFunction(name, params, ret_type, blocks, type_params, is_extern) =>
            // Anonymous lambdas (__lambda_*) are always called via a closure (any
            // ABI), so a float return is boxed at the return — making map(xs, fn(e) ...)
            // float results boxed (consumers unbox), which the heuristic-free collection
            // reads rely on. (Bool returns stay raw so filter predicates work.)
            e.ire_cur_fn_lambda = 0
            if starts_with(name, "__lambda_")
                e.ire_cur_fn_lambda = 1
            if is_extern == 1
                let decl = "declare i64 @" + name + "("
                let i = 0
                while i < len(params)
                    if i > 0
                        decl = decl + ", "
                    decl = decl + "i64"
                    i = i + 1
                decl = decl + ") nounwind"
                ire_line(e, decl)
                return 0
            // PERF Stage 3.5 (raw float locals): pre-pass to find ALWAYS-FLOAT slots —
            // local variables where EVERY slot_store value is float-typed in the IR. Such a
            // slot only ever holds raw double bits, so it can store/load RAW (skip
            // nova_rt_unbox) and LLVM mem2reg promotes it to a register — closing the ~2x
            // gap vs C on float-accumulator loops (sum/running-total/physics-integrate).
            // SOUND because all-stores-float guarantees no boxed value is ever read raw —
            // the unsound case the Stage-2 slot-guard conservatively blocked for untyped
            // slots. IR-typ "float" == raw double bits (a BOXED float is typ "any").
            let _ff_regty = {}
            for _ff_b in blocks
                match _ff_b
                    IrBlock(_ff_lbl, _ff_insts, _ff_term) =>
                        for _ff_i in _ff_insts
                            match _ff_i
                                IrInst(_ffo, _ffd, _fft, _ffa, _ffv, _ffn, _ffe, _ffl) =>
                                    if _ffd != ""
                                        match _fft
                                            IrType(_ffk, _fftn, _fftp, _ffti) =>
                                                _ff_regty[_ffd] = _ffk
            let _ff_any = {}
            let _ff_bad = {}
            for _fg_b in blocks
                match _fg_b
                    IrBlock(_fg_lbl, _fg_insts, _fg_term) =>
                        for _fg_i in _fg_insts
                            match _fg_i
                                IrInst(_fgo, _fgd, _fgt, _fga, _fgv, _fgn, _fge, _fgl) =>
                                    if _fgo == "slot_store" and len(_fga) >= 1
                                        _ff_any[_fgv] = 1
                                        let _fgvk = ""
                                        if contains(_ff_regty, _fga[0])
                                            _fgvk = _ff_regty[_fga[0]]
                                        if _fgvk != "float"
                                            _ff_bad[_fgv] = 1
            for _ff_s in keys(_ff_any)
                if not contains(_ff_bad, _ff_s)
                    e.ire_reg_types["slot." + _ff_s] = "float"
            // total-RC Stage 3 (NOVA_T8_FULLRC, default OFF): pre-pass over this function's IR to
            // find slots that can be soundly rc_dec'd on overwrite (the headline loop-rebind leak).
            // A slot is DROPPABLE iff: (a) every slot_store stores a freshly-OWNED value
            // (make_list/dict/struct/closure result) -> the slot uniquely owns a heap handle; AND
            // (b) it NEVER escapes -- its loaded value is used ONLY as args[0] of a safe read op
            // (list_len / index_get / field_get, which do not retain the container), and is never
            // an arg to a call/make_*/field_set/index_set-value/dyn_call, never aliased into another
            // slot (let b=a), never returned. Conservative by construction (any unrecognized use ->
            // not droppable). When the flag is OFF the set stays EMPTY -> zero drops -> codegen is
            // byte-identical. This MUST be a whole-function pre-pass: a use later in the function
            // (e.g. `return x` after the loop) must disqualify an earlier store's drop.
            let _frc_off = env("NOVA_NO_FULLRC")
            if not (len(_frc_off) > 0 and _frc_off[0] == "1")
                let _frc_owned = {}
                let _frc_loadof = {}
                let _frc_reg2slot = {}
                for _fa_b in blocks
                    match _fa_b
                        IrBlock(_fa_lbl, _fa_insts, _fa_term) =>
                            for _fa_i in _fa_insts
                                match _fa_i
                                    IrInst(_fao, _fad, _fat, _faa, _fav, _fan, _fae, _fal) =>
                                        if _fao == "make_list" or _fao == "make_dict" or _fao == "make_struct" or _fao == "make_closure"
                                            _frc_owned[_fad] = 1
                                        if _fao == "call" and (_fav == "nova_rt_channel_create" or _fav == "nova_rt_channel_bounded")
                                            _frc_owned[_fad] = 1
                                        if _fao == "slot_load"
                                            _frc_loadof[_fad] = _fav
                                        if _fao == "copy" and len(_faa) >= 1
                                            if contains(_frc_loadof, _faa[0])
                                                _frc_loadof[_fad] = _frc_loadof[_faa[0]]
                                            if contains(_frc_reg2slot, _faa[0])
                                                _frc_reg2slot[_fad] = _frc_reg2slot[_faa[0]]
                                        // BORROW taint (soundness): index_get/field_get return a BORROW of an
                                        // element/field -- the runtime (nova_rt_list_get/dict_get/field) returns
                                        // the inner pointer with NO rc_inc. If the container is a droppable
                                        // candidate slot S (its value is loadof(S) or reg2slot(S)), the borrowed
                                        // result ALIASES heap owned solely by S. Propagate S into loadof[dest] so
                                        // the existing Pass-2 escape logic marks S bad whenever the borrow escapes
                                        // (stored to another slot, returned, captured, sent). Without this, S is
                                        // wrongly proven never-escaped -> dropped on reassign -> the still-live
                                        // borrow is freed (UAF/double-free). list_len returns a scalar (no borrow)
                                        // so it is intentionally excluded.
                                        if (_fao == "index_get" or _fao == "field_get") and len(_faa) >= 1
                                            if contains(_frc_loadof, _faa[0])
                                                _frc_loadof[_fad] = _frc_loadof[_faa[0]]
                                            if contains(_frc_reg2slot, _faa[0])
                                                _frc_loadof[_fad] = _frc_reg2slot[_faa[0]]
                                        if _fao == "slot_store" and len(_faa) >= 1 and contains(_frc_owned, _faa[0])
                                            _frc_reg2slot[_faa[0]] = _fav
                let _frc_stored = {}
                let _frc_bad = {}
                for _fc_b in blocks
                    match _fc_b
                        IrBlock(_fc_lbl, _fc_insts, _fc_term) =>
                            for _fc_i in _fc_insts
                                match _fc_i
                                    IrInst(_fco, _fcd, _fct, _fca, _fcv, _fcn, _fce, _fcl) =>
                                        if _fco == "slot_store" and len(_fca) >= 1
                                            _frc_stored[_fcv] = 1
                                            if not contains(_frc_owned, _fca[0])
                                                _frc_bad[_fcv] = 1
                                            if contains(_frc_loadof, _fca[0])
                                                _frc_bad[_frc_loadof[_fca[0]]] = 1
                                            if contains(_frc_reg2slot, _fca[0]) and _frc_reg2slot[_fca[0]] != _fcv
                                                _frc_bad[_frc_reg2slot[_fca[0]]] = 1
                                                _frc_bad[_fcv] = 1
                                        else
                                            let _fc_safe = _fco == "list_len" or _fco == "index_get" or _fco == "field_get"
                                            let _fc_ai = 0
                                            while _fc_ai < len(_fca)
                                                if contains(_frc_loadof, _fca[_fc_ai])
                                                    // CORE_GAP 0.8: PRECISE borrow-escape. A field/element BORROW
                                                    // (loadof a droppable slot) escapes ONLY if it FLOWS into a location
                                                    // that outlives the statement: stored into a heap container (make_*),
                                                    // written into an object (field_set/index_set value), passed to a
                                                    // USER fn / call_by_name / dyn_call (may retain), a nova_rt_ container-
                                                    // mutator VALUE arg (ai>0), or the spawn family (MOVE-retains arg0).
                                                    // Every READ-ONLY use -- arithmetic/logical/compare ops, list_len,
                                                    // index_get/field_get, copy, and read-only nova_rt_ calls at arg0
                                                    // (len/print/get/str) -- CANNOT retain the pointer (an op yields a new
                                                    // value; a scalar element is a value copy, not a live pointer), so the
                                                    // owning struct stays droppable. (slot_store + return are handled by
                                                    // their own branches above/below.) Without this, reading a managed
                                                    // struct field via a generic call (len(y.items), y.items[i]+n,
                                                    // print(y.name)) wrongly pinned the struct as non-droppable -> it AND
                                                    // its heap fields leaked on loop-rebind: the 0.8 headline symptom.
                                                    let _fc_call_esc = _fco == "call" and (not starts_with(_fcv, "nova_rt_") or _fc_ai > 0 or contains(_fcv, "spawn") or _fcv == "nova_rt_fiber_create")
                                                    let _fc_stores = _fco == "make_struct" or _fco == "make_list" or _fco == "make_dict" or _fco == "make_closure" or _fco == "field_set" or _fco == "index_set" or _fco == "call_by_name" or _fco == "dyn_call" or _fc_call_esc
                                                    if _fc_stores
                                                        _frc_bad[_frc_loadof[_fca[_fc_ai]]] = 1
                                                if contains(_frc_reg2slot, _fca[_fc_ai])
                                                    // arg[0] of a nova_rt_* call is normally NON-escaping (the
                                                    // container mutators list_append/dict_set/set_add and
                                                    // channel_send/recv only mutate-in-place or deep-copy arg[1+]).
                                                    // EXCEPTION: the spawn family (sched_spawn/_at/_on, fiber_create)
                                                    // RETAIN the closure at arg[0] by MOVE (nova_rt_fiber_create:
                                                    // f->entry_fn = closure, NO rc_inc) -- the spawner transfers
                                                    // ownership to the not-yet-run task. If FULLRC then drops the
                                                    // slot on reassignment, it frees the closure the task still owns
                                                    // -> UAF when the task runs. So treat spawn/fiber_create arg[0]
                                                    // as ESCAPING. (Matching "spawn" broadly also covers future
                                                    // variants and the legacy deep-copy nova_rt_spawn -- the latter
                                                    // is then merely over-conservative, a missed drop, never a UAF.)
                                                    let _fc_retains = _fco == "call" and (contains(_fcv, "spawn") or _fcv == "nova_rt_fiber_create")
                                                    let _fc_esc = _fc_ai > 0 or (_fco == "call" and not starts_with(_fcv, "nova_rt_")) or _fc_retains or _fco == "call_by_name" or _fco == "make_struct" or _fco == "make_list" or _fco == "make_dict" or _fco == "make_closure"
                                                    if _fc_esc
                                                        _frc_bad[_frc_reg2slot[_fca[_fc_ai]]] = 1
                                                _fc_ai = _fc_ai + 1
                            match _fc_term
                                IrInst(_ft_o, _ft_d, _ft_t, _ft_a, _ft_v, _ft_n, _ft_e, _ft_l) =>
                                    let _ft_ai = 0
                                    while _ft_ai < len(_ft_a)
                                        if contains(_frc_loadof, _ft_a[_ft_ai])
                                            _frc_bad[_frc_loadof[_ft_a[_ft_ai]]] = 1
                                        if contains(_frc_reg2slot, _ft_a[_ft_ai])
                                            _frc_bad[_frc_reg2slot[_ft_a[_ft_ai]]] = 1
                                        _ft_ai = _ft_ai + 1
                for _frc_s in keys(_frc_stored)
                    if not contains(_frc_bad, _frc_s)
                        e.ire_fullrc_drop[_frc_s] = 1
            // #15 S5 ABI: build a lookup for this function's by-value param info
            // _s5_pmap[pi] = struct_name iff param pi is by-value eligible
            let _s5_pmap = {}
            if contains(e.ire_s5_byval, name)
                let _s5_entries = e.ire_s5_byval[name]
                let _s5_ei = 0
                while _s5_ei < len(_s5_entries)
                    let _s5_entry = _s5_entries[_s5_ei]
                    _s5_pmap[str(_s5_entry[0])] = _s5_entry[1]
                    _s5_ei = _s5_ei + 1
            let header = "define i64 @" + name + "("
            let i = 0
            let _s5_first_param = 1
            while i < len(params)
                if contains(_s5_pmap, str(i))
                    // By-value param: emit k typed params per field
                    let _s5_sn = _s5_pmap[str(i)]
                    let _s5_fields = e.ire_s5_sdefs[_s5_sn]
                    let _s5_fi = 0
                    for _s5_fp in _s5_fields
                        match _s5_fp
                            Param(_s5_fpn, _s5_fpt, _s5_fpd) =>
                                if _s5_first_param == 0
                                    header = header + ", "
                                _s5_first_param = 0
                                if _s5_fpt == "float"
                                    header = header + "double %p" + str(i) + ".f" + str(_s5_fi)
                                else
                                    header = header + "i64 %p" + str(i) + ".f" + str(_s5_fi)
                        _s5_fi = _s5_fi + 1
                else
                    if _s5_first_param == 0
                        header = header + ", "
                    _s5_first_param = 0
                    header = header + "i64 %p" + str(i)
                i = i + 1
            // uwtable: emit Windows SEH unwind info (.pdata/.xdata) for every NOVA
            // function. Without it, longjmp/RtlUnwindEx (how nova_panic contains a
            // fault) cannot unwind THROUGH a deep NOVA call chain on a green fiber and
            // the process dies with STATUS_BAD_STACK (0xC0000028) instead of cleanly
            // reporting the error. nounwind (we never C++-throw) + uwtable (frame is
            // still describable for the unwinder) is the correct pairing.
            header = header + ") nounwind uwtable"
            let has_dbg = contains(e.ire_fn_lines, name)
            if has_dbg
                let sp_id = e.ire_dbg_counter
                let loc_id = e.ire_dbg_counter + 1
                e.ire_dbg_counter = e.ire_dbg_counter + 2
                push(e.ire_dbg_entries, [sp_id, loc_id, name, e.ire_fn_lines[name]])
                header = header + " !dbg !" + str(sp_id)
                // Per-line DILocations live in a fresh map per function so they
                // are scoped to this DISubprogram. Anything stale from a prior
                // function is discarded.
                e.ire_line_locs = {}
                e.ire_fn_sp_id = sp_id
                e.ire_cur_fn_line = e.ire_fn_lines[name]   // #33: for DILocalVariable line attrs
            else
                e.ire_fn_sp_id = 0
                e.ire_cur_fn_line = 0
            header = header + " \{"
            ire_line(e, header)
            if has_dbg
                e.ire_dbg_loc = e.ire_dbg_entries[len(e.ire_dbg_entries) - 1][1]
            // Collect param names for alloca exclusion
            let param_names = []
            let pi = 0
            while pi < len(params)
                match params[pi]
                    IrParam(pname, ptype) =>
                        push(param_names, pname)
                pi = pi + 1
            // Collect all local slot names (excluding params)
            let local_slots = ire_collect_slots(blocks, param_names)
            // Track 8 W8: opt-in mid-fn liveness-based drops. Compute live_out
            // per block once; later in the block-emit loop we'll insert drops
            // for slots that are dead by the block's exit.
            let w8_env = env("NOVA_T8_W8")
            let do_w8 = len(w8_env) > 0 and w8_env[0] == "1"
            let live_out_map = {}
            if do_w8
                live_out_map = ire_liveness(blocks, local_slots)
            for block in blocks
                match block
                    IrBlock(label, insts, terminator) =>
                        ire_line(e, label + ":")
                        if label == "entry"
                            // Allocate param slots
                            let pi2 = 0
                            while pi2 < len(params)
                                match params[pi2]
                                    IrParam(pname, ptype) =>
                                        if contains(_s5_pmap, str(pi2))
                                            // #15 S5 ABI: reconstruct struct from scalarized field params
                                            let _s5r_sn = _s5_pmap[str(pi2)]
                                            let _s5r_fields = e.ire_s5_sdefs[_s5r_sn]
                                            let _s5r_nf = len(_s5r_fields)
                                            let _s5r_alloca = "%s5r." + pname + ".ptr"
                                            ire_indent(e, _s5r_alloca + " = alloca [" + str(_s5r_nf + 1) + " x i64], align 8")
                                            // Store type-hash into slot 0 (dead, DCE'd — kept for layout invariance)
                                            let _s5r_hash = type_name_hash(_s5r_sn)
                                            let _s5r_gep0 = "%s5r." + pname + ".h" + str(e.ire_tc)
                                            e.ire_tc = e.ire_tc + 1
                                            ire_indent(e, _s5r_gep0 + " = getelementptr i64, ptr " + _s5r_alloca + ", i64 0")
                                            ire_indent(e, "store i64 " + fmt_i64_decimal(_s5r_hash) + ", ptr " + _s5r_gep0 + ", align 8")
                                            // Store each field param into slots 1..k
                                            let _s5r_fi = 0
                                            for _s5r_fp in _s5r_fields
                                                match _s5r_fp
                                                    Param(_s5r_fpn, _s5r_fpt, _s5r_fpd) =>
                                                        let _s5r_slot = _s5r_fi + 1
                                                        let _s5r_gep = "%s5r." + pname + ".g" + str(_s5r_fi)
                                                        ire_indent(e, _s5r_gep + " = getelementptr i64, ptr " + _s5r_alloca + ", i64 " + str(_s5r_slot))
                                                        if _s5r_fpt == "float"
                                                            // bitcast double -> i64
                                                            let _s5r_bc = "%s5r." + pname + ".bc" + str(_s5r_fi)
                                                            ire_indent(e, _s5r_bc + " = bitcast double %p" + str(pi2) + ".f" + str(_s5r_fi) + " to i64")
                                                            ire_indent(e, "store i64 " + _s5r_bc + ", ptr " + _s5r_gep + ", align 8")
                                                        else
                                                            ire_indent(e, "store i64 %p" + str(pi2) + ".f" + str(_s5r_fi) + ", ptr " + _s5r_gep + ", align 8")
                                                _s5r_fi = _s5r_fi + 1
                                            // Set %slot.pname = ptrtoint of the alloca (the body uses this)
                                            ire_indent(e, "%slot." + pname + " = alloca i64, align 8")
                                            let _s5r_pti = "%s5r." + pname + ".pti" + str(e.ire_tc)
                                            e.ire_tc = e.ire_tc + 1
                                            ire_indent(e, _s5r_pti + " = ptrtoint ptr " + _s5r_alloca + " to i64")
                                            ire_indent(e, "store i64 " + _s5r_pti + ", ptr %slot." + pname + ", align 8")
                                            ire_emit_dbg_local(e, pname)
                                        else
                                            ire_indent(e, "%slot." + pname + " = alloca i64, align 8")
                                            ire_indent(e, "store i64 %p" + str(pi2) + ", ptr %slot." + pname + ", align 8")
                                            ire_emit_dbg_local(e, pname)
                                        match ptype
                                            IrType(pk, _, _, _) =>
                                                if pk == "list" or pk == "intlist"
                                                    e.ire_reg_types["slot." + pname] = "list"
                                                else if pk == "dict"
                                                    e.ire_reg_types["slot." + pname] = "dict"
                                pi2 = pi2 + 1
                            // Allocate local variable slots
                            for slot_name in local_slots
                                ire_indent(e, "%slot." + slot_name + " = alloca i64, align 8")
                                ire_indent(e, "store i64 0, ptr %slot." + slot_name + ", align 8")
                                ire_emit_dbg_local(e, slot_name)
                            // Stage 4 SROA: hoist stack-struct allocas to the entry block (once),
                            // reused across loop iterations (sound — a non-escaping struct never
                            // outlives an iteration, so the buffer can be overwritten each time).
                            // dest.ptr is defined here; the body's make_struct skips the heap
                            // nova_rt_struct_alloc for these dests. Stackable structs are non-repr-C
                            // all-scalar => extra_slots=1 (the leading type-hash slot), so the alloca
                            // is [nfields+1 x i64] — identical layout to the heap struct (minus the
                            // RC header, which is never read: the escape set keeps any struct that
                            // reaches a tag-reading op on the heap). Empty when SROA is off => no-op.
                            for _sab in blocks
                                match _sab
                                    IrBlock(_, _sabi, _) =>
                                        for _sai in _sabi
                                            match _sai
                                                IrInst(_saop, _sadest, _, _, _saval, _sanum, _, _) =>
                                                    if _saop == "make_struct" and contains(e.ire_stackable, _sadest)
                                                        ire_indent(e, _sadest + ".ptr = alloca [" + str(_sanum + 1) + " x i64], align 8")
                            if e.ire_dbg_instr_enabled == 1
                                let dbgf_name_str = ire_intern_string(e, name)
                                let dbgf_name_len = len(name) + 1
                                let dbgf_file_str = ire_intern_string(e, e.ire_filename)
                                let dbgf_file_len = len(e.ire_filename) + 1
                                let dbgf_np = "%dbgf.np" + str(e.ire_tc)
                                let dbgf_npi = "%dbgf.npi" + str(e.ire_tc)
                                let dbgf_fp = "%dbgf.fp" + str(e.ire_tc)
                                let dbgf_fpi = "%dbgf.fpi" + str(e.ire_tc)
                                let dbgf_call = "%dbgf.r" + str(e.ire_tc)
                                e.ire_tc = e.ire_tc + 1
                                ire_indent(e, dbgf_np + " = getelementptr inbounds [" + str(dbgf_name_len) + " x i8], ptr " + dbgf_name_str + ", i64 0, i64 0")
                                ire_indent(e, dbgf_npi + " = ptrtoint ptr " + dbgf_np + " to i64")
                                ire_indent(e, dbgf_fp + " = getelementptr inbounds [" + str(dbgf_file_len) + " x i8], ptr " + dbgf_file_str + ", i64 0, i64 0")
                                ire_indent(e, dbgf_fpi + " = ptrtoint ptr " + dbgf_fp + " to i64")
                                let dbgf_line = 0
                                if contains(e.ire_fn_lines, name)
                                    dbgf_line = e.ire_fn_lines[name]
                                ire_indent(e, dbgf_call + " = call i64 @nova_rt_dbg_push_frame(i64 " + dbgf_npi + ", i64 " + dbgf_fpi + ", i64 " + str(dbgf_line) + ", i64 0)")
                                e.ire_dbg_instr_last_line = 0
                        for inst in insts
                            ire_emit_inst(e, inst)
                        // Track 8 W8: drop slots that are dead at block exit.
                        // Skip the return block — W5b handles that. Skip any
                        // slot already in ire_dropped so we don't double-free.
                        // Also respect ire_slot_escaped: an escaped slot's
                        // value is still reachable through some container.
                        if do_w8 and contains(live_out_map, label)
                            match terminator
                                IrInst(w8_top, _, _, _, _, _, _, _) =>
                                    if w8_top != "return"
                                        let w8_live = live_out_map[label]
                                        for w8_slot in keys(e.ire_local_slots)
                                            if not contains(w8_live, w8_slot) and not contains(e.ire_slot_escaped, w8_slot) and not contains(e.ire_dropped, w8_slot)
                                                let w8_kind = ""
                                                if contains(e.ire_reg_types, "slot." + w8_slot)
                                                    w8_kind = e.ire_reg_types["slot." + w8_slot]
                                                let w8_fn = ""
                                                if w8_kind == "list"
                                                    w8_fn = "nova_rt_list_free_local"
                                                else if w8_kind == "dict"
                                                    w8_fn = "nova_rt_dict_free_local"
                                                if w8_fn != ""
                                                    let w8_reg = ire_fresh_tmp(e, "dl." + w8_slot)
                                                    ire_indent(e, w8_reg + " = load i64, ptr %slot." + w8_slot + ", align 8")
                                                    ire_indent(e, "call i64 @" + w8_fn + "(i64 " + w8_reg + ")")
                                                    e.ire_dropped[w8_slot] = 1
                        // Track 8 W5b: before any return terminator, auto-
                        // insert list_free_local / dict_free_local calls for
                        // each per-fn local slot. SKIP the slot whose value
                        // is the return value (otherwise we'd free the data
                        // before the caller can read it).
                        // W5b auto-drop: opt-in via NOVA_T8_DROP=1.
                        // As of iters 80-82 W5b is SUITE-SOUND: the value-forwarding
                        // and no_rc-append escape blind spots are closed, a
                        // W5b-compiled compiler self-compiles BYTE-IDENTICALLY, and
                        // the full regression is 431/0 under NOVA_T8_DROP=1. It stays
                        // DEFAULT OFF because it does NOT address the per-iteration
                        // headline leak (slot_store never rc_dec's the overwritten
                        // value; W5b drops are return-only) -- that needs the staged
                        // total-RC work (RC_COMPLETENESS.md). See also the inert
                        // ire_owned/ire_borrow_src provenance (Stage 1 foundation).
                        let no_t8b = env("NOVA_NO_TRACK8")
                        let no_drop = env("NOVA_T8_NO_DROP")
                        let do_w5b = true
                        if len(no_t8b) > 0 and no_t8b[0] == "1"
                            do_w5b = false
                        if len(no_drop) > 0 and no_drop[0] == "1"
                            do_w5b = false
                        if do_w5b
                            match terminator
                                IrInst(top, _, _, targs, _, _, _, _) =>
                                    if top == "return" and len(targs) > 0
                                        let ret_arg = targs[0]
                                        let returned_slot = ""
                                        if contains(e.ire_load_origin, ret_arg)
                                            returned_slot = e.ire_load_origin[ret_arg]
                                        for slot_n in keys(e.ire_local_slots)
                                            if slot_n != returned_slot
                                                // Soundness: if this slot's value was ever
                                                // appended/set into an escaping container, the
                                                // container holds a live reference. Dropping the
                                                // slot here would free data the caller can still
                                                // reach. Skip.
                                                if not contains(e.ire_slot_escaped, slot_n) and not contains(e.ire_dropped, slot_n)
                                                    let slot_kind = ""
                                                    if contains(e.ire_reg_types, "slot." + slot_n)
                                                        slot_kind = e.ire_reg_types["slot." + slot_n]
                                                    let drop_fn = ""
                                                    if slot_kind == "list"
                                                        drop_fn = "nova_rt_list_free_local"
                                                    else if slot_kind == "dict"
                                                        drop_fn = "nova_rt_dict_free_local"
                                                    if drop_fn != ""
                                                        // Unique reg per drop site so multiple return
                                                        // points in the same function don't collide on
                                                        // %dl.<slot>. Counter is per-emitter.
                                                        let dl_reg = ire_fresh_tmp(e, "dl." + slot_n)
                                                        ire_indent(e, dl_reg + " = load i64, ptr %slot." + slot_n + ", align 8")
                                                        ire_indent(e, "call i64 @" + drop_fn + "(i64 " + dl_reg + ")")
                                                        e.ire_dropped[slot_n] = 1
                        ire_emit_terminator(e, terminator)
            e.ire_dbg_loc = 0
            ire_line(e, "}")
            ire_line(e, "")

// ── Main Compiler Pipeline ───────────────────────────────────────────────────

fn compile(source: string) -> string
    let tokens = tokenize(source)
    let _cpe = []
    let stmts = parse_program(tokens, _cpe)
    let cg = new_codegen()

    // Separate functions from top-level statements
    let functions = []
    let top_stmts = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "fn"
                    push(functions, s)
                    push(cg.fn_names, name)
                else if tag == "type"
                    // Register struct fields and build field→index map
                    cg.struct_defs[name] = params
                    let fi = 0
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                cg.field_map[pname] = fi
                        fi = fi + 1
                else if tag != "import" and tag != "trait" and tag != "type_alias"
                    push(top_stmts, s)

    // Pass 1: Generate all string constants (by doing a dry-run or pre-scan)
    // For now, strings are interned during codegen

    // Emit module
    emit_module_header(cg)
    emit_runtime_declarations(cg)

    // Emit user functions
    for fn_stmt in functions
        emit_function(cg, fn_stmt)

    // Emit main
    emit_nova_main(cg, top_stmts)
    emit_main_entry(cg)

    // Emit string constants (at end, so we know all of them)
    emit_string_constants(cg)

    join(cg.output, "\n")

// ── IR-Based Compiler Pipeline ───────────────────────────────────────────────

fn compile_ir_core(source: string, base_dir: string) -> string
    compile_ir_core_named(source, base_dir, "<source>", "")

fn compile_ir_core_named(source: string, base_dir: string, filename: string, target: string) -> string
    let tokens = tokenize_file(source, filename)
    let parse_errors = []
    let stmts = parse_program(tokens, parse_errors)
    if len(parse_errors) > 0
        for perr in parse_errors
            print(perr)
        print("compilation failed: " + str(len(parse_errors)) + " error(s)")
        exit(1)

    // Split source into lines for error display
    let source_lines = split(source, "\n")

    // AST-level type inference (Hindley-Milner)
    let ti_state = ti_infer_program_named(stmts, source_lines, filename)
    if len(ti_state.ti_errors) > 0
        for err in ti_state.ti_errors
            print(err)
        print("compilation failed: " + str(len(ti_state.ti_errors)) + " error(s)")
        exit(1)

    // Track 8 Week 4: use-after-move check (opt-in via NOVA_TRACK8=1).
    // send(ch, x) moves x; any subsequent use of x is a compile error.
    let t8_env_chk = env("NOVA_TRACK8")
    if len(t8_env_chk) > 0 and t8_env_chk[0] == "1"
        let move_errs = move_check_program(stmts)
        if len(move_errs) > 0
            for me in move_errs
                print(me)
            print("compilation failed: " + str(len(move_errs)) + " move-semantics error(s)")
            exit(1)

    let b = new_ir_builder()
    b.ir_filename = filename
    b.ir_fn_param_stypes = ti_state.ti_fn_param_types
    let resolved_target = resolve_target(target)
    let e = new_ir_emitter(filename, resolved_target)
    // NOVA_COV=1 environment toggle: when set, the IR emitter injects
    // nova_rt_cov_hit(file, line) at every new source-line boundary.
    let cov_env = env("NOVA_COV")
    if len(cov_env) > 0 and cov_env[0] == "1"
        e.ire_cov_enabled = 1
    let dbg_env = env("NOVA_DBG")
    if len(dbg_env) > 0 and dbg_env[0] == "1"
        e.ire_dbg_instr_enabled = 1

    // Resolve and compile imported modules
    let import_ir_fns = resolve_and_compile_imports(b, stmts, base_dir)

    // Separate functions, types, and top-level statements
    let functions = []
    let top_stmts = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "fn"
                    push(functions, s)
                    let fn_name = name
                    if fn_name == "main"
                        fn_name = "nova_user_main"
                    push(b.ir_fnames, fn_name)
                    b.ir_fn_arity[fn_name] = len(params)
                    b.ir_fn_defaults[fn_name] = params
                    match expr
                        Expr(rtt, rtv, rtn, rtc, rtf, rtl) =>
                            if rtt == "rettype" and rtv != ""
                                let rt_base = rtv
                                let rt_lt = find(rtv, "<")
                                if rt_lt > 0
                                    rt_base = slice(rtv, 0, rt_lt)
                                b.ir_fn_returns[name] = rt_base
                                // Stage-1: a -> list<Struct> return annotation records the element
                                // struct, so json_stringify on the fn's result serializes correctly.
                                if rt_base == "list" and rt_lt > 0
                                    let _rtle = slice(rtv, rt_lt + 1, len(rtv) - 1)
                                    if contains(b.ir_sdefs, _rtle)
                                        b.ir_fn_ret_list_elem[name] = _rtle
                    // S1 nominal struct-return (NOVA_STRUCT_RET): pin an UNANNOTATED fn's struct
                    // return iff EVERY path provably returns a constructor of that one struct
                    // (fail-closed vs null-return CVE). Source annotations always win.
                    let _s1_env = env("NOVA_STRUCT_RET")
                    if len(_s1_env) > 0 and _s1_env[0] == "1"
                        if not contains(b.ir_fn_returns, name)
                            if contains(ti_state.ti_fn_ret_stypes, name)
                                let _s1_s = ti_state.ti_fn_ret_stypes[name]
                                if contains(b.ir_sdefs, _s1_s)
                                    if _fn_all_paths_return_struct(body, _s1_s, b.ir_sdefs)
                                        b.ir_fn_returns[name] = _s1_s
                    let dunder_pos = find(fn_name, "__")
                    if dunder_pos > 0
                        let method_suffix = fn_name[dunder_pos + 2:999999999]
                        b.ir_methods[method_suffix] = fn_name
                else if tag == "extern_fn"
                    push(b.ir_externs, s)
                    push(b.ir_fnames, name)
                    b.ir_fn_arity[name] = len(params)
                    // Record which params are 'out:T' (encoded by the extern
                    // parser as type_ann="out:...") so the call site can emit
                    // slot_addr for them instead of slot_load.
                    let out_idxs = []
                    let opi = 0
                    for ep0 in params
                        match ep0
                            Param(epn0, ept0, epd0) =>
                                if len(ept0) > 4 and ept0[0:4] == "out:"
                                    push(out_idxs, opi)
                        opi = opi + 1
                    if len(out_idxs) > 0
                        b.ir_extern_out_idx[name] = out_idxs
                    // Decide if we need a marshaling wrapper based on declared
                    // types — including @opaque types, which are "ptr" in C
                    // but "i64" in NOVA's calling convention.
                    let ext_ret_ll = "i64"
                    match expr
                        Expr(rxt, rxv, rxn, rxc, rxf, rxl) =>
                            if rxt == "rettype"
                                ext_ret_ll = ffi_llvm_type(rxv)
                                if contains(b.ir_opaque_types, rxv) or contains(b.ir_repr_c_types, rxv)
                                    ext_ret_ll = "ptr"
                    let ext_needs = ext_ret_ll != "i64"
                    if not ext_needs
                        for ep in params
                            match ep
                                Param(epn, ept, epd) =>
                                    let ep_ll = ffi_llvm_type(ept)
                                    if contains(b.ir_opaque_types, ept) or contains(b.ir_repr_c_types, ept)
                                        ep_ll = "ptr"
                                    if ep_ll != "i64"
                                        ext_needs = true
                    if ext_needs
                        b.ir_ffi_wrapped[name] = 1
                else if tag == "type"
                    // @opaque marks a type as an FFI handle (held as int in
                    // NOVA, passed as ptr to C). @repr(C) marks a NOVA struct
                    // as C-layout-compatible: its handle (= heap data pointer)
                    // can be passed to C as a struct pointer, fields stay
                    // accessible to NOVA. Both lower as "ptr" at the boundary.
                    for ann in annotations
                        match ann
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann" and av == "opaque"
                                    b.ir_opaque_types[name] = 1
                                if at == "ann_with_arg" and av == "repr" and len(ac) > 0
                                    match ac[0]
                                        Expr(stg, sav, sn2, sac2, saf2, sal2) =>
                                            if stg == "str" and sav == "C"
                                                b.ir_repr_c_types[name] = 1
                                            if stg == "str" and sav == "packed"
                                                b.ir_repr_c_types[name] = 1
                                                b.ir_repr_packed[name] = 1
                                            if stg == "str" and starts_with(sav, "align(")
                                                let astr = slice(sav, 6, len(sav) - 1)
                                                let aval = int(astr)
                                                if aval > 0
                                                    b.ir_repr_align[name] = aval
                    b.ir_sdefs[name] = params
                    let fi = 1
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                b.ir_fmap[pname] = fi
                                b.ir_field_types[name + "." + pname] = ptype
                        fi = fi + 1
                else if tag == "enum"
                    for variant in body
                        match variant
                            Stmt(vtag, vname, vexpr, vbody, vparams, velse, vann, vln) =>
                                if vtag == "type"
                                    b.ir_sdefs[vname] = vparams
                                    let vfi = 1
                                    for vp in vparams
                                        match vp
                                            Param(vpname, vptype, vpdefault) =>
                                                b.ir_fmap[vpname] = vfi
                                                b.ir_field_types[vname + "." + vpname] = vptype
                                        vfi = vfi + 1
                else if tag == "const"
                    // #35 const-fn-eval: fold a pure call-rooted initializer (e.g.
                    // `const X = fib(10)`) to a literal at compile time. Sound + fails
                    // closed to runtime; returns expr unchanged when not foldable.
                    let _cfe = ce_try_fold_const(expr, stmts)
                    b.ir_consts[name] = _cfe
                    // P5 const-baking: a top-level const whose value is a non-empty
                    // list literal of pure literals is built ONCE in the nova_main
                    // prologue and cached; uses load it instead of rebuilding.
                    if ir_const_bakeable(_cfe) == 1
                        b.ir_const_baked[name] = len(b.ir_const_build_order)
                        push(b.ir_const_build_order, [name, _cfe])
                else if tag != "import" and tag != "trait" and tag != "type_alias"
                    push(top_stmts, s)

    // Inject default trait methods for implementing types
    let td_trait_names = keys(ti_state.ti_trait_defaults)
    for td_tn in td_trait_names
        let td_defs = ti_state.ti_trait_defaults[td_tn]
        let td_method_names = keys(td_defs)
        let td_all_types = keys(ti_state.ti_type_traits)
        for td_type in td_all_types
            let td_tt = ti_state.ti_type_traits[td_type]
            if contains(td_tt, td_tn)
                let td_impl = []
                if contains(ti_state.ti_type_methods, td_type)
                    td_impl = ti_state.ti_type_methods[td_type]
                for td_mn in td_method_names
                    if not list_contains(td_impl, td_mn)
                        let td_def_stmt = td_defs[td_mn]
                        match td_def_stmt
                            Stmt(dft, dfn, dfe, dfb, dfp, dfeb, dfa, dfl) =>
                                let synth_name = td_type + "__" + td_mn
                                let synth_params = [Param("self", "", null_expr())]
                                for sp in dfp
                                    push(synth_params, sp)
                                let synth_fn = Stmt("fn", synth_name, dfe, dfb, synth_params, [], [], dfl)
                                push(functions, synth_fn)
                                push(b.ir_fnames, synth_name)
                                b.ir_fn_arity[synth_name] = len(synth_params)
                                b.ir_fn_defaults[synth_name] = synth_params
                                match dfe
                                    Expr(rtt2, rtv2, rtn2, rtc2, rtf2, rtl2) =>
                                        if rtt2 == "rettype" and rtv2 != ""
                                            b.ir_fn_returns[synth_name] = rtv2
                                let dd_pos = find(synth_name, "__")
                                if dd_pos > 0
                                    let dd_suffix = synth_name[dd_pos + 2:999999999]
                                    b.ir_methods[dd_suffix] = synth_name

    // Build method dispatch table: method_name → [(type_hash, fn_name), ...]
    let mdt_collect = {}
    for fn_s in functions
        match fn_s
            Stmt(ft, fn2, fe, fb, fp, feb, fa, fl) =>
                let mdt_dd = find(fn2, "__")
                if mdt_dd > 0
                    let mdt_type = slice(fn2, 0, mdt_dd)
                    let mdt_method = slice(fn2, mdt_dd + 2, len(fn2))
                    if contains(b.ir_sdefs, mdt_type) or _is_builtin_type_name(mdt_type)
                        if not contains(mdt_collect, mdt_method)
                            mdt_collect[mdt_method] = []
                        push(mdt_collect[mdt_method], [type_name_hash(mdt_type), fn2, len(fp)])
    let mdt_keys = keys(mdt_collect)
    for mk in mdt_keys
        let mdt_impls = mdt_collect[mk]
        if len(mdt_impls) > 1
            b.ir_method_dispatch[mk] = mdt_impls

    // Emit module header
    let dq = chr(34)
    ire_line(e, "; NOVA IR-Pipeline Compiler Output")
    ire_line(e, "target datalayout = " + dq + target_datalayout(e.ire_target) + dq)
    ire_line(e, "target triple = " + dq + e.ire_target + dq)
    ire_line(e, "")
    ire_line(e, "declare void @nova_rt_raise_error() nounwind")
    ire_line(e, "declare i64 @nova_rt_wrap_error_context(i64, i64, i64) nounwind")
    ire_line(e, "declare void @nova_rt_set_error_flag(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_take_error_flag() nounwind")
    ire_line(e, "declare i64 @nova_rt_take_error_msg() nounwind")
    ire_line(e, "")

    // Emit runtime declarations with LLVM optimization attributes
    // readonly = function does not write memory (enables LICM, CSE, GVN)
    // willreturn = function always returns (enables dead code elimination)
    ire_line(e, "; Runtime declarations")
    ire_line(e, "declare i32 @puts(ptr) nounwind")
    ire_line(e, "declare i32 @printf(ptr, ...) nounwind")
    ire_line(e, "declare i32 @strcmp(ptr, ptr) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_list_create() nounwind")
    ire_line(e, "declare i64 @nova_rt_deep_copy(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_create_filled(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_append(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_append_no_rc(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_set_no_rc(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_append_fbox(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_append_fraw(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_get_f(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_append_bbox(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_pop(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_insert(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_remove(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_get_default(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_box_bool(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_unbox(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_unbox_elem(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_lt(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_le(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_gt(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_ge(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_get(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_list_len(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_dict_create() nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_set(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_set_fbox(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_set_bbox(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_box_float(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_dict_get(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_str_concat(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_int_to_str(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_bool_to_str(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_parse_int(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_len(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_len_any(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_ord(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_chr(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_is_space(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_is_upper(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_is_lower(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_is_digit(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_is_alpha(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_is_alnum(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_ushr(i64, i64) nounwind readnone")
    ire_line(e, "declare i64 @nova_rt_udiv(i64, i64) nounwind readnone")
    ire_line(e, "declare i64 @nova_rt_urem(i64, i64) nounwind readnone")
    ire_line(e, "declare i64 @nova_rt_ult(i64, i64) nounwind readnone")
    ire_line(e, "declare i64 @nova_rt_ugt(i64, i64) nounwind readnone")
    ire_line(e, "declare i64 @nova_rt_ule(i64, i64) nounwind readnone")
    ire_line(e, "declare i64 @nova_rt_uge(i64, i64) nounwind readnone")
    ire_line(e, "declare i64 @nova_rt_contains(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_index_get(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_index_set(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_add(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_sub(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_mul(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_div(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_mod(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_neg(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_truthy(i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_eq(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_neq(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_any_to_str(i64) nounwind")
    ire_line(e, "declare void @nova_rt_assert(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_read_file(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_write_file(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_remove_file(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_remove_dir(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_rename_path(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_copy_file(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_size(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_mtime(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_rc_drop_reassign(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_is_dir(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_make_dir(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_chmod(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_is_file(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_write_bytes(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_read_lines(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_open(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_read_line(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_write(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_eof(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_seek(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_tell(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_flush(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_file_close(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_temp_dir() nounwind")
    ire_line(e, "declare i64 @nova_rt_args() nounwind")
    ire_line(e, "declare void @nova_rt_exit(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_split(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_join(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_splitlines(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_partition(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_rpartition(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_rsplit(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_upper(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_lower(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_normalize_nfc(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_normalize_nfd(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_trim(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_replace(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_starts_with(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_ends_with(i64, i64) nounwind readonly")
    ire_line(e, "declare i64 @nova_rt_print_intlist(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_intlist_to_str(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_print_any(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_print_bool(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_print_float(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_print_int(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_print_str(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_float_bits(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_float_to_str(i64) nounwind")
    ire_line(e, "declare ptr @nova_rt_struct_alloc(i64) nounwind")
    // CORE_GAP 0.8: struct field ownership (managed-slot bitmap model).
    ire_line(e, "declare ptr @nova_rt_hashed_struct_alloc(i64) nounwind")
    ire_line(e, "declare void @nova_rc_inc(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_field_set(i64, i64, i64, i64) nounwind")
    ire_line(e, "declare void @nova_rt_register_struct_bitmap(i64, i64) nounwind")
    // BEAT C: LLVM hardware math intrinsics (sqrtsd / native libm, no errno branch) used to
    // inline the float math builtins when the arg is a PROVEN raw double (ire_proven_float).
    ire_line(e, "declare double @llvm.sqrt.f64(double)")
    ire_line(e, "declare double @llvm.sin.f64(double)")
    ire_line(e, "declare double @llvm.cos.f64(double)")
    ire_line(e, "declare double @llvm.exp.f64(double)")
    ire_line(e, "declare double @llvm.log.f64(double)")
    ire_line(e, "declare double @llvm.log2.f64(double)")
    ire_line(e, "declare double @llvm.log10.f64(double)")
    ire_line(e, "declare double @llvm.fabs.f64(double)")
    ire_line(e, "declare double @llvm.floor.f64(double)")
    ire_line(e, "declare double @llvm.ceil.f64(double)")
    ire_line(e, "declare ptr @nova_rt_aligned_struct_alloc(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_slice(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_slice_any(i64, i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_repeat(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_list_repeat(i64, i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_chars(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_time_ms() nounwind")
    ire_line(e, "declare i64 @nova_rt_sleep_ms(i64) nounwind")
    ire_line(e, "declare i64 @nova_rt_clock_ns() nounwind")
    ire_line(e, "declare i64 @nova_rt_type_of(i64) nounwind")
