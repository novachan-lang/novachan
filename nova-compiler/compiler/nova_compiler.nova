fn _is_scalar_literal(e: Expr) -> int
    match e
        Expr(t, v, n, ch, f, ln) =>
            if t == "int" or t == "float" or t == "str" or t == "bool"
                return 1
            return 0
    return 0

// A top-level `let x = <non-scalar>` is MODULE STATE — a single shared value that
// named functions must reach (scalars are constant-propagated by inline_module_consts;
// non-scalars cannot be, since each substitution would be a fresh instance). We bake
// such an initializer into the const-store: built ONCE in the nova_main prologue, every
// use (nova_main, named fns, lambdas) loads the one shared handle. Covers the common
// shapes: a config/registry dict, a lookup list, a shared channel. Calls that are not
// `channel()` are left unchanged (their return kind is not known structurally here).
// True iff `e` is built PURELY from literals (and nested literal lists/dicts) — no
// reference to another top-level var and no call. A baked initializer is built in the
// nova_main PROLOGUE, before top_stmts run, so it must NOT depend on anything a later
// top-level statement initializes. (`let s = [i1, i2]` where i1/i2 are top-level vars
// would otherwise bake as [0,0] before i1/i2 are set — the _asn1_test regression.)
fn _expr_is_self_contained(e: Expr) -> int
    match e
        Expr(t, v, n, ch, f, ln) =>
            if t == "int" or t == "float" or t == "str" or t == "bool"
                return 1
            // "pair" wraps each dict entry [key, val]; "list"/"dict" hold element/pair children.
            if t == "list" or t == "dict" or t == "pair"
                for c in ch
                    if _expr_is_self_contained(c) == 0
                        return 0
                for c in f
                    if _expr_is_self_contained(c) == 0
                        return 0
                return 1
            return 0
    return 0

fn _is_module_state_init(e: Expr) -> int
    match e
        Expr(t, v, n, ch, f, ln) =>
            if t == "list" or t == "dict"
                return _expr_is_self_contained(e)
            if t == "call" and v == "channel"
                // channel() / channel(<literal cap>) — bake iff every arg is self-contained
                for c in ch
                    if _expr_is_self_contained(c) == 0
                        return 0
                return 1
            return 0
    return 0

fn _subst_stmt_ident(s: Stmt, old_name: string, new_e: Expr) -> Stmt
    match s
        Stmt(tag, name, expr, body, params, eb, ann, sl) =>
            let nexpr = _comp_subst(expr, old_name, new_e)
            let nbody = []
            for st in body
                push(nbody, _subst_stmt_ident(st, old_name, new_e))
            let neb = []
            for st in eb
                push(neb, _subst_stmt_ident(st, old_name, new_e))
            let nann = []
            for a in ann
                push(nann, _comp_subst(a, old_name, new_e))
            return Stmt(tag, name, nexpr, nbody, params, neb, nann, sl)
    return s

// A module-level `let` whose initializer is a scalar EXPRESSION rather than a bare literal
// used to read back as 0 from inside every function. inline_module_consts propagated only
// `_is_scalar_literal` initializers, and `_is_module_state_init` bakes only list/dict/
// channel() -- so `let PER = TOTAL / WORKERS` fell through BOTH. The identifier survived to
// codegen as a slot_load, and top-level statements execute in nova_main whose locals the
// user's `main` (nova_user_main) cannot see, so the load hit an uninitialised slot. Silent
// wrong answer -- 0 -- on a completely ordinary declaration. Even `let X = 24000000 / 8`,
// with no identifiers at all, was 0.
//
// Baking (the list/dict route) does NOT work here: the const-store prologue runs BEFORE
// top_stmts (see the note at ~5884), so a baked `B / A` would read A and B while their
// slots are still zero -- the same bug with more machinery. Fold at COMPILE TIME instead,
// in source order, over the scalars already known. Forward references are rejected by
// inference (E1002), so source order IS dependency order and one pass suffices.
//
// Deliberately CONSERVATIVE: integers only, operators + - * / %. The expression is returned
// UNCHANGED unless every leaf is a known integer -- an unknown identifier, a float, a
// string, a call, or a division by zero all decline to fold, leaving prior behaviour exactly
// as it was. A folder must never invent a value; that is how this bug class starts.
fn _fold_module_scalar(e: Expr, cmap: dict) -> Expr
    match e
        Expr(t, v, n, ch, f, ln) =>
            if t == "int"
                return e
            if t == "ident"
                if contains(cmap, v)
                    let _fm_c = cmap[v]
                    match _fm_c
                        Expr(_ct, _cv, _cn, _cch, _cf, _cl) =>
                            if _ct == "int"
                                return _fm_c
                return e
            if t == "binop" and len(ch) == 2
                let _fm_l = _fold_module_scalar(ch[0], cmap)
                let _fm_r = _fold_module_scalar(ch[1], cmap)
                let _fm_lv = 0
                let _fm_rv = 0
                let _fm_ok = 0
                match _fm_l
                    Expr(_lt, _lv2, _ln2, _lch, _lf, _ll) =>
                        if _lt == "int"
                            _fm_lv = _ln2
                            _fm_ok = _fm_ok + 1
                match _fm_r
                    Expr(_rt, _rv2, _rn2, _rch, _rf, _rl) =>
                        if _rt == "int"
                            _fm_rv = _rn2
                            _fm_ok = _fm_ok + 1
                if _fm_ok == 2
                    let _fm_res = 0
                    let _fm_have = 0
                    if v == "+"
                        _fm_res = _fm_lv + _fm_rv
                        _fm_have = 1
                    else if v == "-"
                        _fm_res = _fm_lv - _fm_rv
                        _fm_have = 1
                    else if v == "*"
                        _fm_res = _fm_lv * _fm_rv
                        _fm_have = 1
                    else if v == "/" and _fm_rv != 0
                        _fm_res = _fm_lv / _fm_rv
                        _fm_have = 1
                    else if v == "%" and _fm_rv != 0
                        _fm_res = _fm_lv % _fm_rv
                        _fm_have = 1
                    if _fm_have == 1
                        return Expr("int", str(_fm_res), _fm_res, [], [], ln)
                return e
    e

fn inline_module_consts(stmts: list) -> list
    let cmap = {}
    let cnames = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, eb, ann, sl) =>
                if tag == "assign" and name != "" and len(ann) == 0
                    // Fold first, so a COMPUTED scalar (`let PER = TOTAL / WORKERS`) becomes a
                    // literal and is then propagated exactly like a written-out one. A literal
                    // initializer folds to itself, so existing behaviour is bit-for-bit unchanged.
                    let _imc_folded = _fold_module_scalar(expr, cmap)
                    if _is_scalar_literal(_imc_folded) == 1
                        if not contains(cmap, name)
                            cmap[name] = _imc_folded
                            push(cnames, name)
    if len(cnames) == 0
        return stmts
    let out = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, eb, ann, sl) =>
                if tag == "fn"
                    let locals = collect_locals(body)
                    let pnames = []
                    for p in params
                        match p
                            Param(pn, pt, pd) =>
                                push(pnames, pn)
                    let newbody = body
                    let changed = 0
                    for cn in cnames
                        if not list_contains(locals, cn)
                            if not list_contains(pnames, cn)
                                let nb = []
                                for st in newbody
                                    push(nb, _subst_stmt_ident(st, cn, cmap[cn]))
                                newbody = nb
                                changed = 1
                    if changed == 1
                        push(out, Stmt(tag, name, expr, newbody, params, eb, ann, sl))
                    else
                        push(out, s)
                else
                    push(out, s)
    return out

// ── LLVM IR Code Generator ───────────────────────────────────────────────────

type CodeGen
    output: list
    strings: list
    str_map: dict
    reg_count: int
    label_count: int
    fn_names: list
    current_slots: dict
    current_fn: string
    struct_defs: dict
    indent: string
    loop_hdr: string
    loop_exit: string
    field_map: dict
    label_hdrs: dict
    label_exits: dict

fn new_codegen() -> CodeGen
    CodeGen([], [], {}, 0, 0, [], {}, "", {}, "  ", "", "", {}, {}, {})

fn fresh_reg(cg: CodeGen) -> string
    let r = "%r" + str(cg.reg_count)
    cg.reg_count = cg.reg_count + 1
    r

fn fresh_tmp(cg: CodeGen) -> string
    let t = "%t" + str(cg.reg_count)
    cg.reg_count = cg.reg_count + 1
    t

fn fresh_label(cg: CodeGen, prefix: string) -> string
    let l = prefix + str(cg.label_count)
    cg.label_count = cg.label_count + 1
    l

fn intern_string(cg: CodeGen, s: string) -> int
    if contains(cg.str_map, s)
        return cg.str_map[s]
    let idx = len(cg.strings)
    push(cg.strings, s)
    cg.str_map[s] = idx
    idx

fn emit(cg: CodeGen, line: string)
    push(cg.output, line)

fn emit_indent(cg: CodeGen, line: string)
    push(cg.output, cg.indent + line)

// Get or create a stack slot for a variable
fn get_slot(cg: CodeGen, name: string) -> string
    let slots = cg.current_slots
    if contains(slots, name)
        return slots[name]
    let slot = "%slot." + name
    slots[name] = slot
    slot

// ── LLVM Codegen: Expressions ────────────────────────────────────────────────

fn codegen_expr(cg: CodeGen, expr: Expr) -> string
    match expr
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "int"
                str(num)
            else if tag == "bool"
                str(num)
            else if tag == "null"
                "0"
            else if tag == "float"
                let bits = float_bits(value)
                str(bits)
            else if tag == "str"
                let idx = intern_string(cg, value)
                let r = fresh_reg(cg)
                let slen = len(value) + 1
                emit_indent(cg, r + " = getelementptr inbounds [" + str(slen) + " x i8], ptr @.str." + str(idx) + ", i64 0, i64 0")
                let r2 = fresh_reg(cg)
                emit_indent(cg, r2 + " = ptrtoint ptr " + r + " to i64")
                r2
            else if tag == "str_interp"
                let acc = ""
                let si = 0
                while si < len(children)
                    let part = children[si]
                    match part
                        Expr(ptag, pval, pnum, pch, pf, pln) =>
                            if ptag == "str"
                                let sidx = intern_string(cg, pval)
                                let sr = fresh_reg(cg)
                                let sl = len(pval) + 1
                                emit_indent(cg, sr + " = getelementptr inbounds [" + str(sl) + " x i8], ptr @.str." + str(sidx) + ", i64 0, i64 0")
                                let sr2 = fresh_reg(cg)
                                emit_indent(cg, sr2 + " = ptrtoint ptr " + sr + " to i64")
                                if acc == ""
                                    acc = sr2
                                else
                                    let cat = fresh_reg(cg)
                                    emit_indent(cg, cat + " = call i64 @nova_rt_str_concat(i64 " + acc + ", i64 " + sr2 + ")")
                                    acc = cat
                            else
                                let val_r = codegen_expr(cg, part)
                                let str_r = fresh_reg(cg)
                                emit_indent(cg, str_r + " = call i64 @nova_rt_any_to_str(i64 " + val_r + ")")
                                if acc == ""
                                    acc = str_r
                                else
                                    let cat = fresh_reg(cg)
                                    emit_indent(cg, cat + " = call i64 @nova_rt_str_concat(i64 " + acc + ", i64 " + str_r + ")")
                                    acc = cat
                    si = si + 1
                if acc == ""
                    let eidx = intern_string(cg, "")
                    let er = fresh_reg(cg)
                    emit_indent(cg, er + " = getelementptr inbounds [1 x i8], ptr @.str." + str(eidx) + ", i64 0, i64 0")
                    let er2 = fresh_reg(cg)
                    emit_indent(cg, er2 + " = ptrtoint ptr " + er + " to i64")
                    er2
                else
                    acc
            else if tag == "ident"
                let slot = get_slot(cg, value)
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = load i64, ptr " + slot + ", align 8")
                r
            else if tag == "binop"
                codegen_binop(cg, value, children[0], children[1])
            else if tag == "unary"
                codegen_unary(cg, value, children[0])
            else if tag == "call"
                codegen_call(cg, value, children)
            else if tag == "method_call"
                codegen_method_call(cg, value, children)
            else if tag == "index"
                let target_r = codegen_expr(cg, children[0])
                let idx_r = codegen_expr(cg, children[1])
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = call i64 @nova_rt_index_get(i64 " + target_r + ", i64 " + idx_r + ")")
                r
            else if tag == "member"
                let target_r = codegen_expr(cg, children[0])
                // Member access: field name is in 'value'
                // Lookup struct field index from struct_defs
                let field_idx = get_field_index(cg, value)
                let r = fresh_reg(cg)
                let ptr = fresh_tmp(cg)
                emit_indent(cg, ptr + " = inttoptr i64 " + target_r + " to ptr")
                let gep = fresh_tmp(cg)
                emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(field_idx))
                emit_indent(cg, r + " = load i64, ptr " + gep + ", align 8")
                r
            else if tag == "list"
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = call i64 @nova_rt_list_create()")
                for elem in children
                    let elem_r = codegen_expr(cg, elem)
                    let tmp = fresh_tmp(cg)
                    emit_indent(cg, tmp + " = call i64 @nova_rt_list_append(i64 " + r + ", i64 " + elem_r + ")")
                r
            else if tag == "dict"
                let r = fresh_reg(cg)
                emit_indent(cg, r + " = call i64 @nova_rt_dict_create()")
                for entry in children
                    match entry
                        Expr(et, ev, en, ec, ef, eln) =>
                            let key_r = codegen_expr(cg, ec[0])
                            let val_r = codegen_expr(cg, ec[1])
                            let tmp = fresh_tmp(cg)
                            emit_indent(cg, tmp + " = call i64 @nova_rt_dict_set(i64 " + r + ", i64 " + key_r + ", i64 " + val_r + ")")
                r
            else if tag == "if"
                codegen_if_expr(cg, children)
            else
                "0"

fn codegen_binop(cg: CodeGen, op: string, left: Expr, right: Expr) -> string
    let l = codegen_expr(cg, left)
    let r_val = codegen_expr(cg, right)
    let result = fresh_reg(cg)
    if op == "+"
        emit_indent(cg, result + " = call i64 @nova_rt_add(i64 " + l + ", i64 " + r_val + ")")
    else if op == "-"
        emit_indent(cg, result + " = sub i64 " + l + ", " + r_val)
    else if op == "*"
        emit_indent(cg, result + " = mul i64 " + l + ", " + r_val)
    else if op == "/"
        emit_indent(cg, result + " = call i64 @nova_rt_div(i64 " + l + ", i64 " + r_val + ")")
    else if op == "%"
        emit_indent(cg, result + " = call i64 @nova_rt_mod(i64 " + l + ", i64 " + r_val + ")")
    else if op == "=="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = call i64 @nova_rt_eq(i64 " + l + ", i64 " + r_val + ")")
        emit_indent(cg, result + " = and i64 " + cmp + ", 1")
        // Use result directly (already i64 0 or 1)
        return cmp
    else if op == "!="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = call i64 @nova_rt_neq(i64 " + l + ", i64 " + r_val + ")")
        return cmp
    else if op == "<"
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp slt i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == ">"
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp sgt i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == "<="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp sle i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == ">="
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp sge i64 " + l + ", " + r_val)
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == "and"
        let lbl_entry = fresh_label(cg, "and_entry")
        emit_indent(cg, "br label %" + lbl_entry)
        emit(cg, lbl_entry + ":")
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp ne i64 " + l + ", 0")
        let lbl_rhs = fresh_label(cg, "and_rhs")
        let lbl_end = fresh_label(cg, "and_end")
        emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_rhs + ", label %" + lbl_end)
        emit(cg, lbl_rhs + ":")
        let r2 = codegen_expr(cg, right)
        let lbl_rhs_done = fresh_label(cg, "and_done")
        emit_indent(cg, "br label %" + lbl_rhs_done)
        emit(cg, lbl_rhs_done + ":")
        emit_indent(cg, "br label %" + lbl_end)
        emit(cg, lbl_end + ":")
        emit_indent(cg, result + " = phi i64 [0, %" + lbl_entry + "], [" + r2 + ", %" + lbl_rhs_done + "]")
        return result
    else if op == "or"
        let lbl_entry = fresh_label(cg, "or_entry")
        emit_indent(cg, "br label %" + lbl_entry)
        emit(cg, lbl_entry + ":")
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp ne i64 " + l + ", 0")
        let lbl_rhs = fresh_label(cg, "or_rhs")
        let lbl_end = fresh_label(cg, "or_end")
        emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_end + ", label %" + lbl_rhs)
        emit(cg, lbl_rhs + ":")
        let r2 = codegen_expr(cg, right)
        let lbl_rhs_done = fresh_label(cg, "or_done")
        emit_indent(cg, "br label %" + lbl_rhs_done)
        emit(cg, lbl_rhs_done + ":")
        emit_indent(cg, "br label %" + lbl_end)
        emit(cg, lbl_end + ":")
        emit_indent(cg, result + " = phi i64 [" + l + ", %" + lbl_entry + "], [" + r2 + ", %" + lbl_rhs_done + "]")
        return result
    else if op == "<<" or op == ">>" or op == "&" or op == "|" or op == "^"
        let llvm_op = if op == "<<"
            "shl"
        else if op == ">>"
            "ashr"
        else if op == "&"
            "and"
        else if op == "|"
            "or"
        else
            "xor"
        emit_indent(cg, result + " = " + llvm_op + " i64 " + l + ", " + r_val)
    else if op == ".."
        emit_indent(cg, result + " = call i64 @nova_rt_range_from_to(i64 " + l + ", i64 " + r_val + ")")
    else
        emit_indent(cg, result + " = add i64 " + l + ", " + r_val)
    result

fn codegen_unary(cg: CodeGen, op: string, operand: Expr) -> string
    let val = codegen_expr(cg, operand)
    let result = fresh_reg(cg)
    if op == "-"
        emit_indent(cg, result + " = sub i64 0, " + val)
    else if op == "not"
        let cmp = fresh_tmp(cg)
        emit_indent(cg, cmp + " = icmp eq i64 " + val + ", 0")
        emit_indent(cg, result + " = zext i1 " + cmp + " to i64")
    else if op == "~"
        emit_indent(cg, result + " = xor i64 " + val + ", -1")
    else
        return val
    result

fn codegen_call(cg: CodeGen, name: string, args: list) -> string
    // Check if this is a struct constructor
    if contains(cg.struct_defs, name)
        let num_fields = len(args)
        let alloc_size = num_fields * 8
        let ptr = fresh_reg(cg)
        emit_indent(cg, ptr + " = call ptr @nova_rt_struct_alloc(i64 " + str(alloc_size) + ")")
        let fi = 0
        for arg in args
            let arg_r = codegen_expr(cg, arg)
            let gep = fresh_tmp(cg)
            emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(fi))
            emit_indent(cg, "store i64 " + arg_r + ", ptr " + gep + ", align 8")
            fi = fi + 1
        let result = fresh_reg(cg)
        emit_indent(cg, result + " = ptrtoint ptr " + ptr + " to i64")
        return result
    // Map NOVA stdlib names to runtime functions
    let rt_name = resolve_runtime_fn(name)
    let arg_strs = []
    for arg in args
        let a = codegen_expr(cg, arg)
        push(arg_strs, "i64 " + a)
    let result = fresh_reg(cg)
    let args_str = join(arg_strs, ", ")
    emit_indent(cg, result + " = call i64 @" + rt_name + "(" + args_str + ")")
    result

fn codegen_method_call(cg: CodeGen, method: string, args: list) -> string
    // args[0] is receiver, rest are method args
    let rt_name = resolve_method_fn(method)
    let arg_strs = []
    for arg in args
        let a = codegen_expr(cg, arg)
        push(arg_strs, "i64 " + a)
    let result = fresh_reg(cg)
    let args_str = join(arg_strs, ", ")
    emit_indent(cg, result + " = call i64 @" + rt_name + "(" + args_str + ")")
    result

fn codegen_if_expr(cg: CodeGen, parts: list) -> string
    let cond_r = codegen_expr(cg, parts[0])
    let cmp = fresh_tmp(cg)
    emit_indent(cg, cmp + " = icmp ne i64 " + cond_r + ", 0")
    let lbl_then = fresh_label(cg, "if_then")
    let lbl_else = fresh_label(cg, "if_else")
    let lbl_merge = fresh_label(cg, "if_merge")
    emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_then + ", label %" + lbl_else)
    emit(cg, lbl_then + ":")
    let then_r = codegen_expr(cg, parts[1])
    let lbl_then_done = fresh_label(cg, "if_then_done")
    emit_indent(cg, "br label %" + lbl_then_done)
    emit(cg, lbl_then_done + ":")
    emit_indent(cg, "br label %" + lbl_merge)
    emit(cg, lbl_else + ":")
    let else_r = if len(parts) > 2
        codegen_expr(cg, parts[2])
    else
        "0"
    let lbl_else_done = fresh_label(cg, "if_else_done")
    emit_indent(cg, "br label %" + lbl_else_done)
    emit(cg, lbl_else_done + ":")
    emit_indent(cg, "br label %" + lbl_merge)
    emit(cg, lbl_merge + ":")
    let result = fresh_reg(cg)
    emit_indent(cg, result + " = phi i64 [" + then_r + ", %" + lbl_then_done + "], [" + else_r + ", %" + lbl_else_done + "]")
    result

// ── LLVM Codegen: Statements ─────────────────────────────────────────────────

fn codegen_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "assign"
                let val_r = codegen_expr(cg, expr)
                if name != ""
                    let slot = get_slot(cg, name)
                    emit_indent(cg, "store i64 " + val_r + ", ptr " + slot + ", align 8")
                else if len(annotations) > 0
                    let lhs = annotations[0]
                    let lhs_is_ident = false
                    let lhs_ident_nm = ""
                    match lhs
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                lhs_is_ident = true
                                lhs_ident_nm = ev
                    if lhs_is_ident
                        let slot = get_slot(cg, lhs_ident_nm)
                        emit_indent(cg, "store i64 " + val_r + ", ptr " + slot + ", align 8")
                    else
                        codegen_assign_target(cg, lhs, val_r)
            else if tag == "compound_assign"
                let lhs = annotations[0]
                let lhs_val = codegen_expr(cg, lhs)
                let rhs_val = codegen_expr(cg, expr)
                let result = fresh_reg(cg)
                if name == "+=" or name == "+"
                    emit_indent(cg, result + " = call i64 @nova_rt_add(i64 " + lhs_val + ", i64 " + rhs_val + ")")
                else if name == "-=" or name == "-"
                    emit_indent(cg, result + " = sub i64 " + lhs_val + ", " + rhs_val)
                else if name == "*=" or name == "*"
                    emit_indent(cg, result + " = mul i64 " + lhs_val + ", " + rhs_val)
                else if name == "%="
                    emit_indent(cg, result + " = call i64 @nova_rt_mod(i64 " + lhs_val + ", i64 " + rhs_val + ")")
                else if name == "**="
                    emit_indent(cg, result + " = call i64 @nova_rt_int_pow(i64 " + lhs_val + ", i64 " + rhs_val + ")")
                else
                    emit_indent(cg, result + " = call i64 @nova_rt_div(i64 " + lhs_val + ", i64 " + rhs_val + ")")
                codegen_assign_target(cg, lhs, result)
            else if tag == "multi_assign"
                for _ms in body
                    codegen_stmt(cg, _ms)
            else if tag == "expr"
                let _discard = codegen_expr(cg, expr)
            else if tag == "return"
                let val_r = codegen_expr(cg, expr)
                emit_indent(cg, "ret i64 " + val_r)
            else if tag == "if"
                codegen_if_stmt(cg, stmt)
            else if tag == "while"
                codegen_while_stmt(cg, stmt)
            else if tag == "for"
                codegen_for_stmt(cg, stmt)
            else if tag == "match"
                codegen_match_stmt(cg, stmt)
            else if tag == "break"
                let _cg_brk = cg.loop_exit
                if name != "" and contains(cg.label_exits, name)
                    _cg_brk = cg.label_exits[name]
                emit_indent(cg, "br label %" + _cg_brk)
            else if tag == "continue"
                let _cg_cnt = cg.loop_hdr
                if name != "" and contains(cg.label_hdrs, name)
                    _cg_cnt = cg.label_hdrs[name]
                emit_indent(cg, "br label %" + _cg_cnt)

fn codegen_assign_target(cg: CodeGen, target: Expr, val_reg: string)
    match target
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                let slot = get_slot(cg, value)
                emit_indent(cg, "store i64 " + val_reg + ", ptr " + slot + ", align 8")
            else if tag == "index"
                let target_r = codegen_expr(cg, children[0])
                let idx_r = codegen_expr(cg, children[1])
                let tmp = fresh_tmp(cg)
                emit_indent(cg, tmp + " = call i64 @nova_rt_index_set(i64 " + target_r + ", i64 " + idx_r + ", i64 " + val_reg + ")")
            else if tag == "member"
                let target_r = codegen_expr(cg, children[0])
                let field_idx = get_field_index(cg, value)
                let ptr = fresh_tmp(cg)
                emit_indent(cg, ptr + " = inttoptr i64 " + target_r + " to ptr")
                let gep = fresh_tmp(cg)
                emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(field_idx))
                emit_indent(cg, "store i64 " + val_reg + ", ptr " + gep + ", align 8")

fn codegen_if_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let cond_r = codegen_expr(cg, expr)
            let cmp = fresh_tmp(cg)
            emit_indent(cg, cmp + " = icmp ne i64 " + cond_r + ", 0")
            let lbl_then = fresh_label(cg, "then")
            let lbl_else = fresh_label(cg, "else")
            let lbl_merge = fresh_label(cg, "merge")
            emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_then + ", label %" + lbl_else)
            emit(cg, lbl_then + ":")
            for s in body
                codegen_stmt(cg, s)
            emit_indent(cg, "br label %" + lbl_merge)
            emit(cg, lbl_else + ":")
            for s in else_body
                codegen_stmt(cg, s)
            emit_indent(cg, "br label %" + lbl_merge)
            emit(cg, lbl_merge + ":")

fn codegen_while_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let prev_hdr = cg.loop_hdr
            let prev_exit = cg.loop_exit
            let lbl_hdr = fresh_label(cg, "while_hdr")
            let lbl_body = fresh_label(cg, "while_body")
            let lbl_exit = fresh_label(cg, "while_exit")
            let has_else = len(else_body) > 0
            let lbl_else = ""
            let lbl_done = ""
            if has_else
                lbl_else = fresh_label(cg, "while_else")
                lbl_done = fresh_label(cg, "while_done")
            cg.loop_hdr = lbl_hdr
            cg.loop_exit = lbl_exit
            let _cw_label = ""
            for _cw_ann in annotations
                match _cw_ann
                    Expr(_cwat, _cwan, _cwav, _cwac, _cwaf, _cwal) =>
                        if _cwat == "ann_with_arg" and _cwan == "__label" and len(_cwac) > 0
                            match _cwac[0]
                                Expr(_cwst, _cwsv, _cwsn, _cwsch, _cwsf, _cwsln) =>
                                    _cw_label = _cwsv
            if _cw_label != ""
                cg.label_hdrs[_cw_label] = lbl_hdr
                cg.label_exits[_cw_label] = lbl_exit
            emit_indent(cg, "br label %" + lbl_hdr)
            emit(cg, lbl_hdr + ":")
            let cond_r = codegen_expr(cg, expr)
            let cmp = fresh_tmp(cg)
            emit_indent(cg, cmp + " = icmp ne i64 " + cond_r + ", 0")
            if has_else
                emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_body + ", label %" + lbl_else)
            else
                emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_body + ", label %" + lbl_exit)
            emit(cg, lbl_body + ":")
            for s in body
                codegen_stmt(cg, s)
            emit_indent(cg, "br label %" + lbl_hdr)
            if has_else
                emit(cg, lbl_exit + ":")
                emit_indent(cg, "br label %" + lbl_done)
                emit(cg, lbl_else + ":")
                for s in else_body
                    codegen_stmt(cg, s)
                emit_indent(cg, "br label %" + lbl_done)
                emit(cg, lbl_done + ":")
            else
                emit(cg, lbl_exit + ":")
            cg.loop_hdr = prev_hdr
            cg.loop_exit = prev_exit

fn codegen_for_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let prev_hdr = cg.loop_hdr
            let prev_exit = cg.loop_exit
            let raw_iter = codegen_expr(cg, expr)
            let iter_r = fresh_reg(cg)
            let _cg_fii = "nova_rt_for_iter_init"
            if starts_with(name, "__for_tup_")
                _cg_fii = "nova_rt_for_destr_init"
            if starts_with(name, "__for_kv_")
                _cg_fii = "nova_rt_for_kv_init"
            emit_indent(cg, iter_r + " = call i64 @" + _cg_fii + "(i64 " + raw_iter + ")")
            let len_r = fresh_reg(cg)
            emit_indent(cg, len_r + " = call i64 @nova_rt_len_any(i64 " + iter_r + ")")
            let idx_name = "__for_idx_" + str(cg.label_count)
            let idx_slot = get_slot(cg, idx_name)
            emit_indent(cg, idx_slot + " = alloca i64, align 8")
            emit_indent(cg, "store i64 0, ptr " + idx_slot + ", align 8")
            let lbl_hdr = fresh_label(cg, "for_hdr")
            let lbl_body = fresh_label(cg, "for_body")
            let lbl_exit = fresh_label(cg, "for_exit")
            let has_else = len(else_body) > 0
            let lbl_else = ""
            let lbl_done = ""
            if has_else
                lbl_else = fresh_label(cg, "for_else")
                lbl_done = fresh_label(cg, "for_done")
            cg.loop_hdr = lbl_hdr
            cg.loop_exit = lbl_exit
            let _cf_label = ""
            for _cf_ann in annotations
                match _cf_ann
                    Expr(_cfat, _cfan, _cfav, _cfac, _cfaf, _cfal) =>
                        if _cfat == "ann_with_arg" and _cfan == "__label" and len(_cfac) > 0
                            match _cfac[0]
                                Expr(_cfst, _cfsv, _cfsn, _cfsch, _cfsf, _cfsln) =>
                                    _cf_label = _cfsv
            if _cf_label != ""
                cg.label_hdrs[_cf_label] = lbl_hdr
                cg.label_exits[_cf_label] = lbl_exit
            emit_indent(cg, "br label %" + lbl_hdr)
            emit(cg, lbl_hdr + ":")
            let idx_r = fresh_reg(cg)
            emit_indent(cg, idx_r + " = load i64, ptr " + idx_slot + ", align 8")
            let cmp = fresh_tmp(cg)
            emit_indent(cg, cmp + " = icmp slt i64 " + idx_r + ", " + len_r)
            if has_else
                emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_body + ", label %" + lbl_else)
            else
                emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_body + ", label %" + lbl_exit)
            emit(cg, lbl_body + ":")
            let elem_r = fresh_reg(cg)
            emit_indent(cg, elem_r + " = call i64 @nova_rt_index_get(i64 " + iter_r + ", i64 " + idx_r + ")")
            let var_slot = get_slot(cg, name)
            emit_indent(cg, "store i64 " + elem_r + ", ptr " + var_slot + ", align 8")
            for s in body
                codegen_stmt(cg, s)
            let new_idx = fresh_reg(cg)
            let cur_idx = fresh_reg(cg)
            emit_indent(cg, cur_idx + " = load i64, ptr " + idx_slot + ", align 8")
            emit_indent(cg, new_idx + " = add i64 " + cur_idx + ", 1")
            emit_indent(cg, "store i64 " + new_idx + ", ptr " + idx_slot + ", align 8")
            emit_indent(cg, "br label %" + lbl_hdr)
            if has_else
                emit(cg, lbl_exit + ":")
                emit_indent(cg, "br label %" + lbl_done)
                emit(cg, lbl_else + ":")
                for s in else_body
                    codegen_stmt(cg, s)
                emit_indent(cg, "br label %" + lbl_done)
                emit(cg, lbl_done + ":")
            else
                emit(cg, lbl_exit + ":")
            cg.loop_hdr = prev_hdr
            cg.loop_exit = prev_exit

fn codegen_match_stmt(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let subject_r = codegen_expr(cg, expr)
            // For struct destructuring: load fields into variables
            for arm in body
                match arm
                    Stmt(at, an, pattern, arm_body, ap, ae, aa, _aln) =>
                        match pattern
                            Expr(pt, pv, pn, pchildren, pf, pln2) =>
                                if pt == "pat_ctor"
                                    // Destructure: load each field
                                    let ptr = fresh_tmp(cg)
                                    emit_indent(cg, ptr + " = inttoptr i64 " + subject_r + " to ptr")
                                    let fi = 0
                                    for field_pat in pchildren
                                        match field_pat
                                            Expr(fpt, fpv, fpn, fpc, fpf, fpln) =>
                                                if fpv != "_"
                                                    let gep = fresh_tmp(cg)
                                                    emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(fi))
                                                    let fval = fresh_reg(cg)
                                                    emit_indent(cg, fval + " = load i64, ptr " + gep + ", align 8")
                                                    let fslot = get_slot(cg, fpv)
                                                    emit_indent(cg, "store i64 " + fval + ", ptr " + fslot + ", align 8")
                                        fi = fi + 1
                                for s in arm_body
                                    codegen_stmt(cg, s)

// ── Runtime Function Resolution ──────────────────────────────────────────────

