fn emit_string_constants(cg: CodeGen)
    if len(cg.strings) > 0
        emit(cg, "; String constants")
        let i = 0
        for s in cg.strings
            let escaped = llvm_escape_string(s)
            let byte_len = len(s) + 1
            emit(cg, "@.str." + str(i) + " = private unnamed_addr constant [" + str(byte_len) + " x i8] c\"" + escaped + "\\00\"")
            i = i + 1
        emit(cg, "")

fn codegen_last_as_return(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "expr"
                let val = codegen_expr(cg, expr)
                emit_indent(cg, "ret i64 " + val)
            else if tag == "return"
                let val_r = codegen_expr(cg, expr)
                emit_indent(cg, "ret i64 " + val_r)
            else if tag == "match"
                let subject_r = codegen_expr(cg, expr)
                for arm in body
                    match arm
                        Stmt(at, an, pattern, arm_body, ap, ae, aa, _aln) =>
                            match pattern
                                Expr(pt, pv, pn, pchildren, pf, pln2) =>
                                    if pt == "pat_ctor"
                                        let ptr = fresh_tmp(cg)
                                        emit_indent(cg, ptr + " = inttoptr i64 " + subject_r + " to ptr")
                                        let fi = 0
                                        for field_pat in pchildren
                                            match field_pat
                                                Expr(fpt, fpv, fpn, fpc, fpf, fpln) =>
                                                    if fpv != "_"
                                                        let gep = fresh_tmp(cg)
                                                        emit_indent(cg, gep + " = getelementptr i64, ptr " + ptr + ", i64 " + str(fi))
                                                        let fval = fresh_reg(cg)
                                                        emit_indent(cg, fval + " = load i64, ptr " + gep + ", align 8")
                                                        let fslot = get_slot(cg, fpv)
                                                        emit_indent(cg, "store i64 " + fval + ", ptr " + fslot + ", align 8")
                                            fi = fi + 1
                                    let arm_len = len(arm_body)
                                    if arm_len > 0
                                        let ai = 0
                                        while ai < arm_len - 1
                                            codegen_stmt(cg, arm_body[ai])
                                            ai = ai + 1
                                        codegen_last_as_return(cg, arm_body[arm_len - 1])
                                    else
                                        emit_indent(cg, "ret i64 0")
            else if tag == "if"
                let cond_r = codegen_expr(cg, expr)
                let cmp = fresh_tmp(cg)
                emit_indent(cg, cmp + " = icmp ne i64 " + cond_r + ", 0")
                let lbl_then = fresh_label(cg, "ret_then")
                let lbl_else = fresh_label(cg, "ret_else")
                emit_indent(cg, "br i1 " + cmp + ", label %" + lbl_then + ", label %" + lbl_else)
                emit(cg, lbl_then + ":")
                let then_len = len(body)
                if then_len > 0
                    let ti = 0
                    while ti < then_len - 1
                        codegen_stmt(cg, body[ti])
                        ti = ti + 1
                    codegen_last_as_return(cg, body[then_len - 1])
                else
                    emit_indent(cg, "ret i64 0")
                emit(cg, lbl_else + ":")
                let else_len = len(else_body)
                if else_len > 0
                    let ei = 0
                    while ei < else_len - 1
                        codegen_stmt(cg, else_body[ei])
                        ei = ei + 1
                    codegen_last_as_return(cg, else_body[else_len - 1])
                else
                    emit_indent(cg, "ret i64 0")
            else
                codegen_stmt(cg, stmt)
                emit_indent(cg, "ret i64 0")

fn emit_function(cg: CodeGen, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            cg.current_slots = {}
            cg.reg_count = 0
            let param_strs = []
            let i = 0
            for p in params
                match p
                    Param(pname, ptype, pdefault) =>
                        push(param_strs, "i64 %p" + str(i))
                        i = i + 1
            let params_str = join(param_strs, ", ")
            emit(cg, "define i64 @" + name + "(" + params_str + ") nounwind \{")
            emit(cg, "entry:")
            i = 0
            for p in params
                match p
                    Param(pname, ptype, pdefault) =>
                        let slot = get_slot(cg, pname)
                        emit_indent(cg, slot + " = alloca i64, align 8")
                        emit_indent(cg, "store i64 %p" + str(i) + ", ptr " + slot + ", align 8")
                        i = i + 1
            let locals = collect_locals(body)
            for local_name in locals
                if not contains(cg.current_slots, local_name)
                    let slot = get_slot(cg, local_name)
                    emit_indent(cg, slot + " = alloca i64, align 8")
                    emit_indent(cg, "store i64 0, ptr " + slot + ", align 8")
            let body_len = len(body)
            if body_len > 0
                let si = 0
                while si < body_len - 1
                    codegen_stmt(cg, body[si])
                    si = si + 1
                codegen_last_as_return(cg, body[body_len - 1])
            else
                emit_indent(cg, "ret i64 0")
            emit(cg, "}")
            emit(cg, "")

fn emit_nova_main(cg: CodeGen, stmts: list)
    cg.current_slots = {}
    cg.reg_count = 0
    emit(cg, "define i64 @nova_main() nounwind \{")
    emit(cg, "entry:")
    let locals = collect_locals(stmts)
    for local_name in locals
        let slot = get_slot(cg, local_name)
        emit_indent(cg, slot + " = alloca i64, align 8")
        emit_indent(cg, "store i64 0, ptr " + slot + ", align 8")
    for s in stmts
        codegen_stmt(cg, s)
    if list_contains(cg.fn_names, "nova_user_main")
        let rn = fresh_reg(cg)
        emit_indent(cg, rn + " = call i64 @nova_user_main()")
    emit_indent(cg, "ret i64 0")
    emit(cg, "}")
    emit(cg, "")

fn emit_main_entry(cg: CodeGen)
    emit(cg, "define i32 @main(i32 %argc, ptr %argv) nounwind \{")
    emit(cg, "entry:")
    emit_indent(cg, "%argc64 = sext i32 %argc to i64")
    emit_indent(cg, "%argv64 = ptrtoint ptr %argv to i64")
    emit_indent(cg, "call void @nova_rt_init_args(i64 %argc64, i64 %argv64)")
    emit_indent(cg, "call void @nova_rt_main_dispatch(i64 ptrtoint (ptr @nova_main to i64))")
    emit_indent(cg, "call void @nova_rt_wait_all()")
    emit_indent(cg, "call void @nova_rt_cleanup()")
    emit_indent(cg, "ret i32 0")
    emit(cg, "}")

// ── Utility Functions ────────────────────────────────────────────────────────

fn extract_pattern_names(pattern: Expr) -> list
    let names = []
    match pattern
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "pat_ctor"
                for field_pat in children
                    match field_pat
                        Expr(ft, fv, fn_val, fc, ff, _fln) =>
                            if fv != "_" and fv != ""
                                push(names, fv)
    return names

fn expr_ident_name(e: Expr) -> string
    match e
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                return value
    return ""

fn collect_locals(stmts: list) -> list
    let locals = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "assign" and name != ""
                    if not list_contains(locals, name)
                        push(locals, name)
                else if tag == "assign" and len(annotations) > 0
                    let lhs_name = expr_ident_name(annotations[0])
                    if lhs_name != "" and not list_contains(locals, lhs_name)
                        push(locals, lhs_name)
                else if tag == "spawn" and name != ""
                    if not list_contains(locals, name)
                        push(locals, name)
                else if tag == "for"
                    if not list_contains(locals, name)
                        push(locals, name)
                    let sub = collect_locals(body)
                    for l in sub
                        if not list_contains(locals, l)
                            push(locals, l)
                    let sub_fe = collect_locals(else_body)
                    for l in sub_fe
                        if not list_contains(locals, l)
                            push(locals, l)
                else if tag == "while" or tag == "if"
                    let sub = collect_locals(body)
                    for l in sub
                        if not list_contains(locals, l)
                            push(locals, l)
                    let sub2 = collect_locals(else_body)
                    for l in sub2
                        if not list_contains(locals, l)
                            push(locals, l)
                else if tag == "match"
                    for arm in body
                        match arm
                            Stmt(at, an, pattern, arm_body, ap, ae, aa, _aln) =>
                                let pat_names = extract_pattern_names(pattern)
                                for pn in pat_names
                                    if not list_contains(locals, pn)
                                        push(locals, pn)
                                let sub = collect_locals(arm_body)
                                for l in sub
                                    if not list_contains(locals, l)
                                        push(locals, l)
    locals

fn stmts_has_yield(stmts: list) -> bool
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "yield"
                    return true
                if len(body) > 0
                    if stmts_has_yield(body)
                        return true
                if len(else_body) > 0
                    if stmts_has_yield(else_body)
                        return true
    false

fn list_contains(lst: list, item: string) -> bool
    for x in lst
        if x == item
            return true
    false

// ── Free Variable Analysis (for closures) ──────────────────────────────────

fn collect_free_vars_inner(expr: Expr, bound: list, free: list)
    match expr
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                if not list_contains(bound, value) and not list_contains(free, value)
                    push(free, value)
            else if tag == "call"
                if value != "" and not list_contains(bound, value) and not list_contains(free, value)
                    push(free, value)
                for child in children
                    collect_free_vars_inner(child, bound, free)
            else if tag == "lambda"
                let inner_bound = []
                for b_item in bound
                    push(inner_bound, b_item)
                for p in fields
                    match p
                        Expr(pt, pv, pn, pc, pf, pln3) =>
                            push(inner_bound, pv)
                if len(children) > 0
                    collect_free_vars_inner(children[0], inner_bound, free)
            else if tag == "for"
                let inner_bound = []
                for b_item in bound
                    push(inner_bound, b_item)
                push(inner_bound, value)
                for child in children
                    collect_free_vars_inner(child, inner_bound, free)
            else
                for child in children
                    collect_free_vars_inner(child, bound, free)

fn collect_free_vars_stmt(stmt: Stmt, bound: list, free: list)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "fn"
                let inner_bound = []
                for b_item in bound
                    push(inner_bound, b_item)
                push(inner_bound, name)
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            push(inner_bound, pname)
                for s in body
                    collect_free_vars_stmt(s, inner_bound, free)
                push(bound, name)
            else if tag == "let" or tag == "assign" or tag == "const"
                collect_free_vars_inner(expr, bound, free)
                if name != ""
                    push(bound, name)
            else if tag == "return" or tag == "expr" or tag == "defer"
                collect_free_vars_inner(expr, bound, free)
            else if tag == "for"
                collect_free_vars_inner(expr, bound, free)
                let inner_bound = []
                for b_item in bound
                    push(inner_bound, b_item)
                push(inner_bound, name)
                for s in body
                    collect_free_vars_stmt(s, inner_bound, free)
            else
                collect_free_vars_inner(expr, bound, free)
                for s in body
                    collect_free_vars_stmt(s, bound, free)
                for s in else_body
                    collect_free_vars_stmt(s, bound, free)
            for a in annotations
                collect_free_vars_inner(a, bound, free)

fn filter_captures(free: list, fnames: list, sdefs: dict) -> list
    let result = []
    for v in free
        if not list_contains(fnames, v) and resolve_runtime_fn(v) == v and not contains(sdefs, v)
            push(result, v)
    result

// ── Move-Elision Analysis ───────────────────────────────────────────────────

fn me_expr_refs(e: Expr, vn: string) -> int
    match e
        Expr(tag, value, num, children, fields, eline) =>
            let c = 0
            if tag == "ident" and value == vn
                c = 1
            for ch in children
                c = c + me_expr_refs(ch, vn)
            c

fn me_stmt_refs(s: Stmt, vn: string) -> int
    match s
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let c = me_expr_refs(expr, vn)
            for bs in body
                c = c + me_stmt_refs(bs, vn)
            for es in else_body
                c = c + me_stmt_refs(es, vn)
            if tag == "assign" and len(annotations) > 0
                let a0 = annotations[0]
                match a0
                    Expr(at, av, _, _, _, _) =>
                        if at == "ident" and av == vn
                            let ai = 1
                            while ai < len(annotations)
                                c = c + me_expr_refs(annotations[ai], vn)
                                ai = ai + 1
                        else
                            for a in annotations
                                c = c + me_expr_refs(a, vn)
            else
                for a in annotations
                    c = c + me_expr_refs(a, vn)
            c

fn ir_mark_move_sends(b: IrBuilder, stmts: list)
    let idx = 0
    while idx < len(stmts)
        let s = stmts[idx]
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "expr"
                    match expr
                        Expr(etag, evalue, enum_val, echildren, efields, eline) =>
                            if etag == "call" and evalue == "send" and len(echildren) >= 2
                                let arg2 = echildren[1]
                                match arg2
                                    Expr(a2tag, a2value, _, _, _, _) =>
                                        if a2tag == "ident"
                                            let vn = a2value
                                            let total = 0
                                            for bs in stmts
                                                total = total + me_stmt_refs(bs, vn)
                                            if total == 1
                                                b.ir_locals["__ms_" + str(eline)] = 1
        idx = idx + 1

// ── Lambda Lifting ──────────────────────────────────────────────────────────

fn ir_lift_lambda(b: IrBuilder, lam_params: list, body: Expr, captures: list) -> string
    let lname = "__lambda_" + str(b.ir_lamc)
    let tname = "__tramp_" + str(b.ir_lamc)
    b.ir_lamc = b.ir_lamc + 1

    // Build param list: captures first, then lambda params
    let all_params = []
    for fv in captures
        push(all_params, Param(fv, "", null_expr()))
    let lam_pnames = []
    for p in lam_params
        match p
            Expr(pt, pv, pn, pc, pf, pln3) =>
                push(all_params, Param(pv, "", null_expr()))
                push(lam_pnames, pv)

    // Save builder state
    let save_insts = b.ir_insts
    let save_blocks = b.ir_blocks
    let save_clabel = b.ir_clabel
    let save_rc = b.ir_rc
    let save_locals = b.ir_locals

    // Lower as function: body is a single expression → implicit return
    let body_stmt = Stmt("expr", "", body, [], [], [], [], body.eline)
    let fn_stmt = Stmt("fn", lname, null_expr(), [body_stmt], all_params, [], [], body.eline)
    let ir_fn = ir_lower_function(b, fn_stmt)
    push(b.ir_lambdas, ir_fn)
    push(b.ir_fnames, lname)
    b.ir_fn_arity[lname] = len(all_params)

    // Record trampoline spec: [tramp_name, target_name, num_captures, num_lambda_params]
    let spec = [tname, lname, len(captures), len(lam_pnames)]
    push(b.ir_tramps, spec)
    push(b.ir_fnames, tname)
    b.ir_fn_arity[tname] = 1 + len(lam_pnames)

    // Restore builder state
    b.ir_insts = save_insts
    b.ir_blocks = save_blocks
    b.ir_clabel = save_clabel
    b.ir_rc = save_rc
    b.ir_locals = save_locals

    tname

fn ir_lift_nested_fn(b: IrBuilder, orig_name: string, fn_params: list, fn_body: list, captures: list) -> string
    let lname = "__nfn_" + orig_name + "_" + str(b.ir_lamc)
    let tname = "__ntramp_" + orig_name + "_" + str(b.ir_lamc)
    b.ir_lamc = b.ir_lamc + 1
    let all_params = []
    for fv in captures
        push(all_params, Param(fv, "", null_expr()))
    let user_count = 0
    for p in fn_params
        push(all_params, p)
        user_count = user_count + 1
    let save_insts = b.ir_insts
    let save_blocks = b.ir_blocks
    let save_clabel = b.ir_clabel
    let save_rc = b.ir_rc
    let save_locals = b.ir_locals
    let fn_stmt = Stmt("fn", lname, null_expr(), fn_body, all_params, [], [], 0)
    let ir_fn = ir_lower_function(b, fn_stmt)
    push(b.ir_lambdas, ir_fn)
    push(b.ir_fnames, lname)
    b.ir_fn_arity[lname] = len(all_params)
    let spec = [tname, lname, len(captures), user_count]
    push(b.ir_tramps, spec)
    push(b.ir_fnames, tname)
    b.ir_fn_arity[tname] = 1 + user_count
    b.ir_insts = save_insts
    b.ir_blocks = save_blocks
    b.ir_clabel = save_clabel
    b.ir_rc = save_rc
    b.ir_locals = save_locals
    tname

fn llvm_escape_string(s: string) -> string
    let result = ""
    let i = 0
    while i < len(s)
        let ch = s[i]
        if ch == "\n"
            result = result + "\\0A"
        else if ch == "\r"
            result = result + "\\0D"
        else if ch == "\t"
            result = result + "\\09"
        else if ch == "\0"
            result = result + "\\00"
        else if ch == "\\"
            result = result + "\\\\"
        else if ch == "\""
            result = result + "\\22"
        else
            result = result + ch
        i = i + 1
    result

// `float_bits(s)` resolves to the int-typed builtin nova_rt_float_bits (string ->
// raw IEEE-754 i64 bits). A prior user-fn wrapper `fn float_bits -> int = parse_float(s)`
// was inferred FLOAT-typed (its body returns a float), so the literal-emission sites
// `ir_emit_inst(b, "const_float", ..., bits)` saw a float `bits`, which the value-model
// then boxed into ir_emit_inst's any-typed num param — leaking a compiler-heap box
// POINTER as the emitted float-literal constant. Using the int-typed builtin keeps
// `bits` an int (no float_to_str, no wbox boxing), so const_float emits raw bits.

// ══════════════════════════════════════════════════════════════════════════════
// TYPED IR PIPELINE — AST → IR → LLVM
// Phase 1: All values typed as "any" (equivalent to existing codegen)
// Phase 2: Type inference refines IrType.kind → "int", "str", etc.
//          enabling direct arithmetic, eliminating runtime calls
// ══════════════════════════════════════════════════════════════════════════════

fn ir_type_int() -> IrType
    IrType("int", "", [], 0)

fn ir_type_str() -> IrType
    IrType("str", "", [], 0)

fn ir_type_any() -> IrType
    IrType("any", "", [], 0)

fn ir_type_void() -> IrType
    IrType("void", "", [], 0)

fn ir_type_bool() -> IrType
    IrType("bool", "", [], 0)

fn ir_type_list() -> IrType
    IrType("list", "", [], 0)

fn ir_type_dict() -> IrType
    IrType("dict", "", [], 0)

fn ir_type_float() -> IrType
    IrType("float", "", [], 0)

fn type_name_hash(name: string) -> int
    let h = 5381
    let i = 0
    while i < len(name)
        h = h * 33 + ord(name[i])
        i = i + 1
    h

// CORE_GAP 0.8: is a struct/enum field's declared type a MANAGED heap value the struct must own
// (rc_inc on construct, bitmap dec on free)? SCALARS are non-managed. CRITICAL: field type strings
// in ir_sdefs/ir_field_types are the RAW source annotations (NOT normalized), so both cases and the
// FFI width aliases must be recognized — a `float`/`Float` field can hold raw IEEE-754 double bits,
// and feeding those to rc_dec is the kind=2 float-list hazard (wild deref). Excluding every scalar
// spelling guarantees no raw scalar is ever dec'd. Everything else (string/list/dict/bytes/user
// struct+enum names/any/generic params) is a heap pointer -> managed. This SAME predicate drives
// make_struct's inc AND @main's bitmap mask, so they cannot disagree.
fn ire_field_is_managed(t: string) -> bool
    if t == "int" or t == "Int" or t == "float" or t == "Float" or t == "bool" or t == "Bool"
        return false
    if t == "i32" or t == "int32" or t == "i64" or t == "int64" or t == "u32" or t == "uint32" or t == "u64" or t == "uint64" or t == "isize" or t == "usize"
        return false
    true

// Format an int64 as a decimal string using ONLY integer arithmetic. The generic
// str() builtin falls back to nova_rt_any_to_str for values the IR optimizer
// can't statically pin to `int`; that fallback guesses int-vs-float from the bit
// pattern and wrongly prints large integers — e.g. DJB2 type-name hashes or raw
// float bit patterns — as doubles, which is invalid as an LLVM i64 literal and
// breaks the emitted module. Integer constants we emit into LLVM MUST go through
// this helper, never str(). Digit extraction works directly on a negative value
// (only the single digit is negated) so INT_MIN is handled without overflow.
fn fmt_i64_decimal(n: int) -> string
    if n == 0
        return "0"
    let neg = false
    let v = n
    if v < 0
        neg = true
    let digits = ""
    while v != 0
        let d = v % 10
        if d < 0
            d = 0 - d
        digits = chr(48 + d) + digits
        v = v / 10
    if neg
        return "-" + digits
    digits

// ── IR Builder ───────────────────────────────────────────────────────────────

type IrBuilder
    ir_insts: list
    ir_rc: int
    ir_blocks: list
    ir_clabel: string
    ir_slots: dict
    ir_strlits: list
    ir_strmap: dict
    ir_lc: int
    ir_fnames: list
    ir_sdefs: dict
    ir_fmap: dict
    ir_loop_hdr: string
    ir_loop_exit: string
    ir_lambdas: list
    ir_lamc: int
    ir_fn_arity: dict
    ir_locals: dict
    ir_tramps: list
    ir_modules: dict
    ir_fn_defaults: dict
    ir_methods: dict
    ir_field_types: dict
    ir_externs: list
    ir_fn_returns: dict
    ir_ffi_wrapped: dict
    ir_cur_line: int
    ir_opaque_types: dict
    ir_extern_out_idx: dict
    ir_repr_c_types: dict
    ir_repr_packed: dict
    ir_repr_align: dict
    ir_method_dispatch: dict
    ir_defers: list
    ir_gen_fns: dict
    ir_consts: dict
    ir_filename: string
    ir_fn_name: string
    ir_fn_param_stypes: dict
    ir_const_baked: dict
    ir_const_build_order: list
    ir_list_elem_stype: dict
    ir_fn_ret_list_elem: dict
    ir_result_elem_stype: dict

fn new_ir_builder() -> IrBuilder
    IrBuilder([], 0, [], "entry", {}, [], {}, 0, [], {}, {}, "", "", [], 0, {}, {}, [], {}, {}, {}, {}, [], {}, {}, 0, {}, {}, {}, {}, {}, {}, [], {}, {}, "", "", {}, {}, [], {}, {}, {})

// When `match r { Ok(s) => s.field }` runs and `r` was bound `let r: Result<Struct> = ...`, the Ok
// payload IS that struct -- but the binding defaulted to `any`, so a FLOAT field read via str()/arith
// silently corrupted (the value's static struct type was lost, like the inner Ok payload). This recovers
// the payload's struct type from ir_result_elem_stype (recorded at the typed Result<Struct> let) so the
// bound var is typed correctly. Only Ok/Some carry the value payload; returns "" otherwise (-> stays any,
// byte-identical to the old behavior for every non-Result-struct match).
fn ir_match_ok_payload_stype(b: IrBuilder, subject_expr: Expr, ctor: string) -> string
    if ctor != "Ok" and ctor != "Some"
        return ""
    match subject_expr
        Expr(et, ev, en, ec, ef, el) =>
            if et == "ident" and contains(b.ir_result_elem_stype, ev)
                return b.ir_result_elem_stype[ev]
    ""

// Match-arm payload binder typing for a USER enum variant. Prior codegen emitted `field_get` as `any`
// and set ir_locals=1 for every user-variant payload, so a FLOAT payload was read as its raw IEEE-754
// i64 bits (str()/arith corruption — the Circle(radius:float) garbage). A variant IS a struct in
// b.ir_sdefs, so recover the field's DECLARED type by position (mirrors the struct field-access path):
// return the field_get IR type AND set b.ir_locals[binder] so downstream str()/arith dispatch on the
// real type. Only fires for a known variant field with a concrete primitive/struct type; otherwise the
// binder stays `any`/ir_locals=1 (byte-identical to the old behavior). `pos` is 0-based.
fn ir_bind_variant_payload_type(b: IrBuilder, variant: string, pos: int, binder: string) -> IrType
    b.ir_locals[binder] = 1
    if contains(b.ir_sdefs, variant)
        let vps = b.ir_sdefs[variant]
        if pos >= 0 and pos < len(vps)
            match vps[pos]
                Param(_vpn, _vpt, _vpd) =>
                    if _vpt == "float" or _vpt == "Float"
                        b.ir_locals[binder] = "float"
                        return ir_type_float()
                    if _vpt == "int" or _vpt == "Int"
                        return ir_type_int()
                    if _vpt == "string" or _vpt == "String"
                        b.ir_locals[binder] = "string"
                        return ir_type_str()
                    if contains(b.ir_sdefs, _vpt)
                        b.ir_locals[binder] = _vpt
    ir_type_any()

// P5 const-baking: is `e` a compile-time-constant LITERAL element (int/float/str/
// bool, or a unary-negated/notted literal)? Pure literals only — NO ident refs —
// so a bakeable const has no dependency on another const (no init ordering) and
// lowering it never re-enters the const-ident use-site (no const_get recursion).
fn ir_const_literal_elem(e: Expr) -> int
    match e
        Expr(et, ev, en, ec, ef, eln) =>
            if et == "int" or et == "float" or et == "str" or et == "bool"
                return 1
            if et == "unary" and len(ec) == 1 and (ev == "-" or ev == "not")
                return ir_const_literal_elem(ec[0])
            return 0
    0

// A const is BAKEABLE (built once + cached, not rebuilt per use) if its value is a
// NON-EMPTY list literal whose every element is a pure literal. Covers the lookup-
// table case (the Zig/C-comptime win) while staying sound: immutable shared value,
// no inter-const dependency. Empty lists / non-literal elements keep inline-rebuild.
fn ir_const_bakeable(expr: Expr) -> int
    match expr
        Expr(et, ev, en, ec, ef, eln) =>
            if et != "list"
                return 0
            if len(ec) == 0
                return 0
            for child in ec
                if ir_const_literal_elem(child) == 0
                    return 0
            return 1
    0

fn ir_fresh_reg(b: IrBuilder) -> string
    let r = "%r" + str(b.ir_rc)
    b.ir_rc = b.ir_rc + 1
    r

fn ir_fresh_label(b: IrBuilder, prefix: string) -> string
    let l = prefix + str(b.ir_lc)
    b.ir_lc = b.ir_lc + 1
    l

fn ir_emit_inst(b: IrBuilder, op: string, dest: string, typ: IrType, args: list, value: string, num: int)
    push(b.ir_insts, IrInst(op, dest, typ, args, value, num, "pure", b.ir_cur_line))

fn ir_emit_side(b: IrBuilder, op: string, dest: string, typ: IrType, args: list, value: string, num: int)
    push(b.ir_insts, IrInst(op, dest, typ, args, value, num, "side_effect", b.ir_cur_line))

fn ir_finish_block(b: IrBuilder, terminator: IrInst)
    let block = IrBlock(b.ir_clabel, b.ir_insts, terminator)
    push(b.ir_blocks, block)
    b.ir_insts = []
    b.ir_clabel = ""

fn ir_start_block(b: IrBuilder, label: string)
    b.ir_clabel = label

// ── AST → IR Lowering ────────────────────────────────────────────────────────

fn ir_resolve_op_overload(b: IrBuilder, op: string, left_expr: Expr) -> string
    let method = ""
    if op == "+"
        method = "add"
    else if op == "-"
        method = "sub"
    else if op == "*"
        let mt = ir_expr_struct_type(b, left_expr)
        if mt == "string"
            return "nova_rt_repeat"
        method = "mul"
    else if op == "/"
        method = "div"
    else if op == "%"
        method = "rem"
    else if op == "=="
        method = "eq"
    else if op == "!="
        method = "neq"
    else if op == "<"
        method = "lt"
    else if op == "<="
        method = "le"
    else if op == ">"
        method = "gt"
    else if op == ">="
        method = "ge"
    else if op == "**"
        let pt = ir_expr_struct_type(b, left_expr)
        if pt == "int"
            return "nova_rt_int_pow"
        return "nova_rt_pow"
    if method == ""
        return ""
    let recv = ir_expr_struct_type(b, left_expr)
    if recv == ""
        return ""
    let candidate = recv + "__" + method
    if list_contains(b.ir_fnames, candidate)
        return candidate
    ""

fn ir_resolve_unary_overload(b: IrBuilder, op: string, operand_expr: Expr) -> string
    let recv = ir_expr_struct_type(b, operand_expr)
    if recv == ""
        return ""
    let method = ""
    if op == "-"
        method = "neg"
    else if op == "not"
        method = "not"
    if method == ""
        return ""
    let candidate = recv + "__" + method
    if list_contains(b.ir_fnames, candidate)
        return candidate
    ""

fn ir_lower_expr(b: IrBuilder, expr: Expr) -> string
    match expr
        Expr(tag, value, num, children, fields, eline) =>
            if eline > 0
                b.ir_cur_line = eline
            if tag == "int"
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "const_int", dest, ir_type_int(), [], str(num), num)
                return dest
            else if tag == "str"
                let dest = ir_fresh_reg(b)
                if not contains(b.ir_strmap, value)
                    push(b.ir_strlits, value)
                    b.ir_strmap[value] = len(b.ir_strlits) - 1
                ir_emit_inst(b, "const_str", dest, ir_type_str(), [], value, 0)
                return dest
            else if tag == "named_arg"
                if len(children) > 0
                    return ir_lower_expr(b, children[0])
                let _na_z = ir_fresh_reg(b)
                ir_emit_inst(b, "const_int", _na_z, ir_type_int(), [], "0", 0)
                return _na_z
            else if tag == "str_interp"
                let acc = ""
                let idx = 0
                while idx < len(children)
                    let part = children[idx]
                    match part
                        Expr(ptag, pval, pnum, pch, pf, pln) =>
                            if ptag == "str"
                                let sreg = ir_fresh_reg(b)
                                if not contains(b.ir_strmap, pval)
                                    push(b.ir_strlits, pval)
                                    b.ir_strmap[pval] = len(b.ir_strlits) - 1
                                ir_emit_inst(b, "const_str", sreg, ir_type_str(), [], pval, 0)
                                if acc == ""
                                    acc = sreg
                                else
                                    let cat = ir_fresh_reg(b)
                                    ir_emit_side(b, "call", cat, ir_type_str(), [acc, sreg], "nova_rt_str_concat", 0)
                                    acc = cat
                            else if ptag == "fmt_spec"
                                idx = idx + 1
                                idx = idx - 1
                            else
                                let val_reg = ir_lower_expr(b, part)
                                let str_reg = ir_fresh_reg(b)
                                let _fspec = ""
                                if idx + 1 < len(children)
                                    match children[idx + 1]
                                        Expr(_fst, _fsv, _fsn, _fsc, _fsf, _fsl) =>
                                            if _fst == "fmt_spec"
                                                _fspec = _fsv
                                                idx = idx + 1
                                if len(_fspec) > 0
                                    let spec_reg = ir_fresh_reg(b)
                                    if not contains(b.ir_strmap, _fspec)
                                        push(b.ir_strlits, _fspec)
                                        b.ir_strmap[_fspec] = len(b.ir_strlits) - 1
                                    ir_emit_inst(b, "const_str", spec_reg, ir_type_str(), [], _fspec, 0)
                                    ir_emit_side(b, "call", str_reg, ir_type_str(), [val_reg, spec_reg], "nova_rt_format_one", 0)
                                else
                                    ir_emit_side(b, "call", str_reg, ir_type_str(), [val_reg], "nova_rt_any_to_str", 0)
                                if acc == ""
                                    acc = str_reg
                                else
                                    let cat = ir_fresh_reg(b)
                                    ir_emit_side(b, "call", cat, ir_type_str(), [acc, str_reg], "nova_rt_str_concat", 0)
                                    acc = cat
                    idx = idx + 1
                if acc == ""
                    let dest = ir_fresh_reg(b)
                    if not contains(b.ir_strmap, "")
                        push(b.ir_strlits, "")
                        b.ir_strmap[""] = len(b.ir_strlits) - 1
                    ir_emit_inst(b, "const_str", dest, ir_type_str(), [], "", 0)
                    return dest
                return acc
            else if tag == "ident"
                if value == "__file__"
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_str", dest, ir_type_str(), [], b.ir_filename, 0)
                    return dest
                if value == "__line__"
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", dest, ir_type_int(), [], str(b.ir_cur_line), b.ir_cur_line)
                    return dest
                if value == "__func__"
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_str", dest, ir_type_str(), [], b.ir_fn_name, 0)
                    return dest
                if not contains(b.ir_locals, value) and list_contains(b.ir_fnames, value)
                    // Function reference: wrap in a closure record (no captures)
                    let arity = 0
                    if contains(b.ir_fn_arity, value)
                        arity = b.ir_fn_arity[value]
                    let tname = "__fnref_" + value
                    if not list_contains(b.ir_fnames, tname)
                        let spec = [tname, value, 0, arity]
                        push(b.ir_tramps, spec)
                        push(b.ir_fnames, tname)
                        b.ir_fn_arity[tname] = 1 + arity
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "make_closure", dest, ir_type_any(), [], tname, 0)
                    return dest
                // P5 const-baking: a bakeable const aggregate loads its single
                // cached handle (built once in the nova_main prologue) instead of
                // re-lowering the literal -> rebuilding the list at every use.
                if contains(b.ir_const_baked, value)
                    let _cb_id = b.ir_const_baked[value]
                    let _cb_idr = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", _cb_idr, ir_type_int(), [], "", _cb_id)
                    let _cb_get = ir_fresh_reg(b)
                    ir_emit_inst(b, "call", _cb_get, ir_type_any(), [_cb_idr], "nova_rt_const_get", 0)
                    return _cb_get
                if contains(b.ir_consts, value)
                    return ir_lower_expr(b, b.ir_consts[value])
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "slot_load", dest, ir_type_any(), [], value, 0)
                return dest
            else if tag == "bool"
                let dest = ir_fresh_reg(b)
                let bv = if value == "true"
                    1
                else
                    0
                // Carry bool type (still a const_int op, so optimizer passes are unaffected);
                // inference reads the type so bool keeps its identity through Any/JSON.
                ir_emit_inst(b, "const_int", dest, ir_type_bool(), [], str(bv), bv)
                return dest
            else if tag == "binop"
                if value == "and"
                    let left = ir_lower_expr(b, children[0])
                    let sc_slot = "__sc_" + str(b.ir_lc)
                    b.ir_lc = b.ir_lc + 1
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [left], sc_slot, 0)
                    let rhs_label = ir_fresh_label(b, "and_rhs")
                    let merge_label = ir_fresh_label(b, "and_merge")
                    ir_finish_block(b, IrInst("branch", "", ir_type_void(), [left, merge_label], rhs_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, rhs_label)
                    let right = ir_lower_expr(b, children[1])
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [right], sc_slot, 0)
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, merge_label)
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", dest, ir_type_any(), [], sc_slot, 0)
                    return dest
                else if value == "or"
                    let left = ir_lower_expr(b, children[0])
                    let sc_slot = "__sc_" + str(b.ir_lc)
                    b.ir_lc = b.ir_lc + 1
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [left], sc_slot, 0)
                    let rhs_label = ir_fresh_label(b, "or_rhs")
                    let merge_label = ir_fresh_label(b, "or_merge")
                    ir_finish_block(b, IrInst("branch", "", ir_type_void(), [left, rhs_label], merge_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, rhs_label)
                    let right = ir_lower_expr(b, children[1])
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [right], sc_slot, 0)
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, merge_label)
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", dest, ir_type_any(), [], sc_slot, 0)
                    return dest
                let overloaded = ir_resolve_op_overload(b, value, children[0])
                if overloaded != ""
                    let ovl = ir_lower_expr(b, children[0])
                    let ovr = ir_lower_expr(b, children[1])
                    let ovd = ir_fresh_reg(b)
                    ir_emit_side(b, "call", ovd, ir_type_any(), [ovl, ovr], overloaded, 0)
                    return ovd
                let left = ir_lower_expr(b, children[0])
                let right = ir_lower_expr(b, children[1])
                let dest = ir_fresh_reg(b)
                if value == "+"
                    ir_emit_inst(b, "add", dest, ir_type_any(), [left, right], "+", 0)
                else if value == "-"
                    ir_emit_inst(b, "sub", dest, ir_type_any(), [left, right], "-", 0)
                else if value == "*"
                    ir_emit_inst(b, "mul", dest, ir_type_any(), [left, right], "*", 0)
                else if value == "/"
                    ir_emit_inst(b, "div", dest, ir_type_any(), [left, right], "/", 0)
                else if value == "%"
                    ir_emit_inst(b, "mod", dest, ir_type_any(), [left, right], "%", 0)
                else if value == "=="
                    ir_emit_inst(b, "eq", dest, ir_type_any(), [left, right], "==", 0)
                else if value == "!="
                    ir_emit_inst(b, "neq", dest, ir_type_any(), [left, right], "!=", 0)
                else if value == "<"
                    ir_emit_inst(b, "lt", dest, ir_type_any(), [left, right], "<", 0)
                else if value == "<="
                    ir_emit_inst(b, "le", dest, ir_type_any(), [left, right], "<=", 0)
                else if value == ">"
                    ir_emit_inst(b, "gt", dest, ir_type_any(), [left, right], ">", 0)
                else if value == ">="
                    ir_emit_inst(b, "ge", dest, ir_type_any(), [left, right], ">=", 0)
                else if value == "in"
                    ir_emit_side(b, "call", dest, ir_type_any(), [right, left], "nova_rt_contains", 0)
                else if value == "matches"
                    ir_emit_side(b, "call", dest, ir_type_any(), [left, right], "nova_rt_regex_match", 0)
                else if value == ".."
                    ir_emit_side(b, "call", dest, ir_type_any(), [left, right], "nova_rt_range_from_to", 0)
                else if value == "&"
                    ir_emit_inst(b, "bitand", dest, ir_type_int(), [left, right], "&", 0)
                else if value == "|"
                    ir_emit_inst(b, "bitor", dest, ir_type_int(), [left, right], "|", 0)
                else if value == "^"
                    ir_emit_inst(b, "bitxor", dest, ir_type_int(), [left, right], "^", 0)
                else if value == "<<"
                    ir_emit_inst(b, "shl", dest, ir_type_int(), [left, right], "<<", 0)
                else if value == ">>"
                    ir_emit_inst(b, "shr", dest, ir_type_int(), [left, right], ">>", 0)
                return dest
            else if tag == "unary"
                let unary_overload = ir_resolve_unary_overload(b, value, children[0])
                if unary_overload != ""
                    let uo = ir_lower_expr(b, children[0])
                    let ud = ir_fresh_reg(b)
                    ir_emit_side(b, "call", ud, ir_type_any(), [uo], unary_overload, 0)
                    return ud
                let operand = ir_lower_expr(b, children[0])
                let dest = ir_fresh_reg(b)
                if value == "-"
                    ir_emit_inst(b, "neg", dest, ir_type_any(), [operand], "-", 0)
                else if value == "not"
                    ir_emit_inst(b, "not", dest, ir_type_any(), [operand], "not", 0)
                else if value == "~"
                    ir_emit_inst(b, "bitnot", dest, ir_type_int(), [operand], "~", 0)
                return dest
            else if tag == "call"
                let fn_name = value
                if fn_name == "static_assert"
                    // Compile-time only (checked during inference); emit no runtime
                    // code -> a const 0 value that the optimizer dead-strips.
                    let sa_dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", sa_dest, ir_type_int(), [], "0", 0)
                    return sa_dest
                if _is_type_predicate(fn_name) and len(children) == 1
                    let tp_stype = ir_expr_struct_type(b, children[0])
                    let tp_result = _eval_type_pred(fn_name, tp_stype)
                    let tp_dest = ir_fresh_reg(b)
                    if tp_result >= 0
                        ir_emit_inst(b, "const_int", tp_dest, ir_type_int(), [], str(tp_result), tp_result)
                    else
                        // Undecidable at compile time (arg is 'any'/unknown): emit a REAL runtime
                        // type check nova_rt_type_pred(arg, pred_id) -> 1/0, instead of the old
                        // wrong static const 0 (which made is_dict/is_list on any always false).
                        let tp_arg = ir_lower_expr(b, children[0])
                        let tp_pid = ir_fresh_reg(b)
                        let tp_pidv = _type_pred_id(fn_name)
                        ir_emit_inst(b, "const_int", tp_pid, ir_type_int(), [], str(tp_pidv), tp_pidv)
                        ir_emit_inst(b, "call", tp_dest, ir_type_int(), [tp_arg, tp_pid], "nova_rt_type_pred", 0)
                    return tp_dest
                if fn_name == "cfg" and len(children) == 2
                    let cfg_result = 0
                    match children[0]
                        Expr(cfg_t0, cfg_k, _, _, _, _) =>
                            match children[1]
                                Expr(cfg_t1, cfg_v, _, _, _, _) =>
                                    if cfg_t0 == "str" and cfg_t1 == "str"
                                        cfg_result = _eval_cfg(cfg_k, cfg_v)
                    let cfg_dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", cfg_dest, ir_type_int(), [], str(cfg_result), cfg_result)
                    return cfg_dest
                if fn_name == "main"
                    fn_name = "nova_user_main"
                let _has_na = false
                for _nac in children
                    match _nac
                        Expr(_nat, _, _, _, _, _) =>
                            if _nat == "named_arg"
                                _has_na = true
                if _has_na and contains(b.ir_fn_defaults, fn_name)
                    let _na_params = b.ir_fn_defaults[fn_name]
                    let _na_pos = []
                    let _na_map = {}
                    for _nac2 in children
                        match _nac2
                            Expr(_nat2, _nav2, _, _nch2, _, _) =>
                                if _nat2 == "named_arg"
                                    _na_map[_nav2] = _nch2[0]
                                else
                                    push(_na_pos, _nac2)
                    let _na_out = []
                    let _na_pi = 0
                    for _nap in _na_params
                        match _nap
                            Param(_napn, _napt, _napd) =>
                                if contains(_na_map, _napn)
                                    push(_na_out, _na_map[_napn])
                                else if _na_pi < len(_na_pos)
                                    push(_na_out, _na_pos[_na_pi])
                                    _na_pi = _na_pi + 1
                    children = _na_out
                let arg_regs = []
                // For 'out:T' extern fn params, the argument must be a simple
                // identifier; we emit slot_addr (ptrtoint of the variable's
                // alloca) instead of evaluating the expression as a value.
                let out_set = {}
                if contains(b.ir_extern_out_idx, fn_name)
                    for oi in b.ir_extern_out_idx[fn_name]
                        out_set[str(oi)] = 1
                let ci = 0
                for child in children
                    if contains(out_set, str(ci))
                        match child
                            Expr(ctag, cval, cnum, cch, cfl, cln) =>
                                let dest = ir_fresh_reg(b)
                                if ctag == "ident"
                                    ir_emit_inst(b, "slot_addr", dest, ir_type_int(), [], cval, 0)
                                else
                                    ir_emit_inst(b, "slot_addr", dest, ir_type_int(), [], "__bad_out", 0)
                                push(arg_regs, dest)
                    else
                        push(arg_regs, ir_lower_expr(b, child))
                    ci = ci + 1
                // variadic call: if the callee's last param is a rest param (`T...`),
                // pack the trailing args into a single list and pass it as that param.
                if contains(b.ir_fn_defaults, fn_name)
                    let vp = b.ir_fn_defaults[fn_name]
                    let vnp = len(vp)
                    if vnp > 0
                        let v_is_var = false
                        match vp[vnp - 1]
                            Param(vpn2, vpt2, vpd2) =>
                                if ends_with(vpt2, "...")
                                    v_is_var = true
                        if v_is_var
                            let v_fix = vnp - 1
                            if len(arg_regs) >= v_fix
                                let v_packed = []
                                let v_i = 0
                                while v_i < v_fix
                                    push(v_packed, arg_regs[v_i])
                                    v_i = v_i + 1
                                let v_rest = []
                                let v_r = v_fix
                                while v_r < len(arg_regs)
                                    push(v_rest, arg_regs[v_r])
                                    v_r = v_r + 1
                                let v_lreg = ir_fresh_reg(b)
                                ir_emit_inst(b, "make_list", v_lreg, ir_type_list(), v_rest, "", len(v_rest))
                                push(v_packed, v_lreg)
                                arg_regs = v_packed
                if contains(b.ir_fn_defaults, fn_name)
                    let def_params = b.ir_fn_defaults[fn_name]
                    let di = len(arg_regs)
                    while di < len(def_params)
                        let dp = def_params[di]
                        match dp
                            Param(dpn, dpt, dpd) =>
                                match dpd
                                    Expr(dtag, dval, dnum, dch, dfl, dln) =>
                                        if dtag != "null"
                                            push(arg_regs, ir_lower_expr(b, dpd))
                        di = di + 1
                let dest = ir_fresh_reg(b)
                // NOVA way (zero annotation): str(p)/print(p) on a record struct dispatch to the
                // compiler-derived <Type>__show, synthesized for every struct in expand_derives.
                // Resolved here at codegen, where the static struct type is known (HM types are
                // deferred during inference). Gated on the __show actually existing so a struct
                // type without one (e.g. an enum value-type) falls through to the generic path.
                if (fn_name == "str" or fn_name == "print") and len(children) == 1
                    let show_sty = ir_expr_struct_type(b, children[0])
                    if show_sty != "" and list_contains(b.ir_fnames, show_sty + "__show")
                        if fn_name == "str"
                            ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, show_sty + "__show", 0)
                            return dest
                        else
                            let show_r = ir_fresh_reg(b)
                            ir_emit_side(b, "call", show_r, ir_type_any(), arg_regs, show_sty + "__show", 0)
                            ir_emit_side(b, "call", dest, ir_type_any(), [show_r], "nova_rt_print_any", 0)
                            return dest
                // Automatic serialization (DB/HTTP keystone): json_stringify(p) on a record struct
                // dispatches to the compiler-derived <Type>__to_json (zero annotation), nested structs
                // recursing through the same path. Gated on the method existing so non-derived struct
                // types fall through to the generic serializer.
                if fn_name == "json_stringify" and len(children) == 1
                    let json_sty = ir_expr_struct_type(b, children[0])
                    if json_sty != "" and list_contains(b.ir_fnames, json_sty + "__to_json")
                        ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, json_sty + "__to_json", 0)
                        return dest
                    // Stage-1 list-of-structs (DB/HTTP serialize keystone): when the arg is a list
                    // whose elements are ALL one struct, serialize as a JSON array via the proven
                    // field-level pattern -- "[" + join(map(lst, fn(e) <Elem>__to_json(e)), ",") + "]".
                    // Reconverge-safe: the compiler has no call-form json_stringify on a list-of-structs.
                    let _jls_elem = ir_list_elem_struct(b, children[0])
                    if _jls_elem != "" and list_contains(b.ir_fnames, _jls_elem + "__to_json")
                        let _jls_ln = b.ir_cur_line
                        let _jls_body = Expr("call", _jls_elem + "__to_json", 0, [Expr("ident", "_jlse", 0, [], [], _jls_ln)], [], _jls_ln)
                        let _jls_lam = Expr("lambda", "", 0, [_jls_body], [Expr("ident", "_jlse", 0, [], [], _jls_ln)], _jls_ln)
                        let _jls_map = Expr("call", "map", 0, [children[0], _jls_lam], [], _jls_ln)
                        let _jls_join = Expr("call", "join", 0, [_jls_map, Expr("str", ",", 0, [], [], _jls_ln)], [], _jls_ln)
                        let _jls_full = Expr("binop", "+", 0, [Expr("binop", "+", 0, [Expr("str", "[", 0, [], [], _jls_ln), _jls_join], [], _jls_ln), Expr("str", "]", 0, [], [], _jls_ln)], [], _jls_ln)
                        return ir_lower_expr(b, _jls_full)
                if fn_name == "fields" and len(children) == 1
                    let fl_sty = ir_expr_struct_type(b, children[0])
                    if fl_sty != "" and list_contains(b.ir_fnames, fl_sty + "__fields")
                        ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, fl_sty + "__fields", 0)
                        return dest
                if fn_name == "type_name" and len(children) == 1
                    let tn_sty = ir_expr_struct_type(b, children[0])
                    if tn_sty != "" and list_contains(b.ir_fnames, tn_sty + "__type_name")
                        ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, tn_sty + "__type_name", 0)
                        return dest
                if fn_name == "field_types" and len(children) == 1
                    let ft_sty = ir_expr_struct_type(b, children[0])
                    if ft_sty != "" and list_contains(b.ir_fnames, ft_sty + "__field_types")
                        ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, ft_sty + "__field_types", 0)
                        return dest
                    // any/cross-module path: the static struct type is unknown (a forge fn introspecting an
                    // app struct) -> read the runtime struct-meta registry (the same one json_stringify uses).
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, "nova_rt_field_types", 0)
                    return dest
                if fn_name == "field_names" and len(children) == 1
                    let fnm_sty = ir_expr_struct_type(b, children[0])
                    if fnm_sty != "" and list_contains(b.ir_fnames, fnm_sty + "__field_names")
                        ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, fnm_sty + "__field_names", 0)
                        return dest
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, "nova_rt_field_names", 0)
                    return dest
                if fn_name == "field_get" and len(children) == 2
                    let fg_sty = ir_expr_struct_type(b, children[0])
                    if fg_sty != "" and list_contains(b.ir_fnames, fg_sty + "__field_get")
                        ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, fg_sty + "__field_get", 0)
                        return dest
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, "nova_rt_field_get", 0)
                    return dest
                if contains(b.ir_methods, fn_name) and not contains(b.ir_method_dispatch, fn_name) and not list_contains(b.ir_fnames, fn_name) and not contains(b.ir_sdefs, fn_name) and resolve_runtime_fn(fn_name) == fn_name
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, b.ir_methods[fn_name], 0)
                    return dest
                if contains(b.ir_method_dispatch, fn_name) and not list_contains(b.ir_fnames, fn_name) and not contains(b.ir_sdefs, fn_name) and len(arg_regs) > 0
                    let _md_rt = ir_expr_struct_type(b, children[0])
                    if _md_rt != ""
                        let _md_tm = _md_rt + "__" + fn_name
                        if list_contains(b.ir_fnames, _md_tm)
                            ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, _md_tm, 0)
                            return dest
                if fn_name == "error"
                    ir_emit_side(b, "set_error", dest, ir_type_any(), arg_regs, "", 0)
                    return dest
                else if fn_name == "select"
                    let sel_list = ir_fresh_reg(b)
                    ir_emit_side(b, "call", sel_list, ir_type_any(), [], "nova_rt_list_create", 0)
                    for sel_ch in arg_regs
                        let sel_tmp = ir_fresh_reg(b)
                        ir_emit_side(b, "call", sel_tmp, ir_type_any(), [sel_list, sel_ch], "nova_rt_list_append", 0)
                    ir_emit_side(b, "call", dest, ir_type_any(), [sel_list], "nova_rt_select", 0)
                    return dest
                else if fn_name == "select_timeout"
                    // select_timeout(ch1, ..., chN, timeout_ms): the LAST arg is the timeout, the
                    // rest are channels. Build the channel list, call nova_rt_select_timeout(list,
                    // timeout). Returns [index, value], or [-1, 0] on timeout (same shape as select).
                    let stl = ir_fresh_reg(b)
                    ir_emit_side(b, "call", stl, ir_type_any(), [], "nova_rt_list_create", 0)
                    let stn = len(arg_regs)
                    let sti = 0
                    while sti < stn - 1
                        let sttmp = ir_fresh_reg(b)
                        ir_emit_side(b, "call", sttmp, ir_type_any(), [stl, arg_regs[sti]], "nova_rt_list_append", 0)
                        sti = sti + 1
                    ir_emit_side(b, "call", dest, ir_type_any(), [stl, arg_regs[stn - 1]], "nova_rt_select_timeout", 0)
                    return dest
                else if contains(b.ir_sdefs, fn_name)
                    ir_emit_inst(b, "make_struct", dest, ir_type_any(), arg_regs, fn_name, len(arg_regs))
                else if not contains(b.ir_locals, fn_name) and (list_contains(b.ir_fnames, fn_name) or resolve_runtime_fn(fn_name) != fn_name)
                    let rt_name = fn_name
                    if not list_contains(b.ir_fnames, fn_name)
                        rt_name = resolve_runtime_fn(fn_name)
                    if fn_name == "send" and contains(b.ir_locals, "__ms_" + str(eline))
                        rt_name = "nova_rt_channel_send_move"
                    if contains(b.ir_ffi_wrapped, fn_name)
                        rt_name = "nova_ffi_" + fn_name
                    // map() over a NAMED fn returning float: box the results so the list
                    // displays/serializes as floats (anon lambdas already box their float
                    // return; a named fn keeps its raw-float ABI, so map must box).
                    if rt_name == "nova_rt_list_map" and len(children) >= 2
                        match children[1]
                            Expr(m_et, m_ev, m_en, m_ec, m_ef, m_el) =>
                                if m_et == "ident" and contains(b.ir_fn_returns, m_ev) and b.ir_fn_returns[m_ev] == "float"
                                    rt_name = "nova_rt_list_map_fbox"
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, rt_name, 0)
                else
                    // Dynamic call: fn_name is a variable holding a closure
                    let closure_reg = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", closure_reg, ir_type_any(), [], fn_name, 0)
                    let call_args = [closure_reg]
                    for ar in arg_regs
                        push(call_args, ar)
                    ir_emit_side(b, "dyn_call", dest, ir_type_any(), call_args, "", len(arg_regs))
                return dest
            else if tag == "dyn_call"
                // Dynamic call: children[0] is callee expression, rest are args
                let callee_reg = ir_lower_expr(b, children[0])
                let arg_regs = []
                let ci = 1
                while ci < len(children)
                    push(arg_regs, ir_lower_expr(b, children[ci]))
                    ci = ci + 1
                let dest = ir_fresh_reg(b)
                let call_args = [callee_reg]
                for ar in arg_regs
                    push(call_args, ar)
                ir_emit_side(b, "dyn_call", dest, ir_type_any(), call_args, "", len(arg_regs))
                return dest
            else if tag == "lambda"
                let lam_params = fields
                let body_expr = children[0]
                let bound = []
                for p in lam_params
                    match p
                        Expr(pt, pv, pn, pc, pf, pln3) =>
                            push(bound, pv)
                let free = []
                collect_free_vars_inner(body_expr, bound, free)
                let captures = filter_captures(free, b.ir_fnames, b.ir_sdefs)
                let tramp_name = ir_lift_lambda(b, lam_params, body_expr, captures)
                let capture_regs = []
                for cap in captures
                    let cr = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", cr, ir_type_any(), [], cap, 0)
                    push(capture_regs, cr)
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "make_closure", dest, ir_type_any(), capture_regs, tramp_name, len(captures))
                return dest
            else if tag == "null"
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "const_int", dest, ir_type_any(), [], "0", 0)
                return dest
            else if tag == "float"
                let bits = float_bits(value)
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "const_float", dest, ir_type_float(), [], str(bits), bits)
                return dest
            else if tag == "method" or tag == "method_call"
                // Check if this is a module-qualified call: module.func(args)
                // children[0] is the receiver, value is the method name
                if len(children) > 0
                    match children[0]
                        Expr(rtag, rval, rnum, rch, rf, rln) =>
                            if rtag == "ident" and contains(b.ir_modules, rval)
                                let mod_fns = b.ir_modules[rval]
                                if list_contains(mod_fns, value)
                                    let arg_regs = []
                                    let ai = 1
                                    while ai < len(children)
                                        push(arg_regs, ir_lower_expr(b, children[ai]))
                                        ai = ai + 1
                                    let dest = ir_fresh_reg(b)
                                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, value, 0)
                                    return dest
                let arg_regs = []
                for child in children
                    push(arg_regs, ir_lower_expr(b, child))
                let dest = ir_fresh_reg(b)
                let resolved_method = ""
                if len(children) > 0
                    let recv_type = ir_expr_struct_type(b, children[0])
                    if recv_type != ""
                        let typed_m = recv_type + "__" + value
                        if list_contains(b.ir_fnames, typed_m)
                            resolved_method = typed_m
                if resolved_method != ""
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, resolved_method, 0)
                else if contains(b.ir_method_dispatch, value) and len(arg_regs) > 0
                    let disp_impls = b.ir_method_dispatch[value]
                    let disp_recv = arg_regs[0]
                    let disp_hash = ir_fresh_reg(b)
                    ir_emit_side(b, "call", disp_hash, ir_type_int(), [disp_recv], "nova_rt_type_hash", 0)
                    let disp_merge = ir_fresh_label(b, "dyn_merge")
                    let disp_slot = "__dyn_" + str(b.ir_lc)
                    b.ir_lc = b.ir_lc + 1
                    let disp_zero = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", disp_zero, ir_type_int(), [], "0", 0)
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [disp_zero], disp_slot, 0)
                    let di = 0
                    while di < len(disp_impls)
                        let dimp = disp_impls[di]
                        let dimp_hash = dimp[0]
                        let dimp_fn = dimp[1]
                        let disp_then = ir_fresh_label(b, "dyn_" + str(di))
                        let disp_next = ir_fresh_label(b, "dyn_try" + str(di + 1))
                        let disp_hash_c = ir_fresh_reg(b)
                        ir_emit_inst(b, "const_int", disp_hash_c, ir_type_int(), [], str(dimp_hash), dimp_hash)
                        let disp_cmp = ir_fresh_reg(b)
                        ir_emit_inst(b, "eq", disp_cmp, ir_type_int(), [disp_hash, disp_hash_c], "", 0)
                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [disp_cmp, disp_next], disp_then, 0, "pure", b.ir_cur_line))
                        ir_start_block(b, disp_then)
                        let disp_r = ir_fresh_reg(b)
                        ir_emit_side(b, "call", disp_r, ir_type_any(), arg_regs, dimp_fn, 0)
                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [disp_r], disp_slot, 0)
                        ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], disp_merge, 0, "pure", b.ir_cur_line))
                        ir_start_block(b, disp_next)
                        di = di + 1
                    let disp_fb_rt = resolve_runtime_fn(value)
                    if disp_fb_rt != value
                        let disp_fb_result = ir_fresh_reg(b)
                        ir_emit_side(b, "call", disp_fb_result, ir_type_any(), arg_regs, disp_fb_rt, 0)
                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [disp_fb_result], disp_slot, 0)
                    else if list_contains(b.ir_fnames, value)
                        let disp_fb_result = ir_fresh_reg(b)
                        ir_emit_side(b, "call", disp_fb_result, ir_type_any(), arg_regs, value, 0)
                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [disp_fb_result], disp_slot, 0)
                    else
                        // #8 S8.0 SOUNDNESS: no implementation of this method matched the receiver's runtime
                        // type, and there is no runtime builtin / free-fn fallback. The old code stored 0 and
                        // continued -> a SILENT garbage value (violates "no UB": the caller gets 0 from a method
                        // that never ran). Trap loudly instead -> a clear panic (contained in a spawned task,
                        // fatal on main, with the #5 stack trace). The store keeps the IR well-formed for the
                        // merge block (nova_rt_panic does not return).
                        let disp_fb_msg = ir_fresh_reg(b)
                        ir_emit_inst(b, "const_str", disp_fb_msg, ir_type_str(), [], "no implementation of method '" + value + "' for this value's runtime type", 0)
                        let disp_fb_panic = ir_fresh_reg(b)
                        ir_emit_side(b, "call", disp_fb_panic, ir_type_int(), [disp_fb_msg], "nova_rt_panic", 0)
                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [disp_fb_panic], disp_slot, 0)
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], disp_merge, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, disp_merge)
                    let disp_load = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", disp_load, ir_type_any(), [], disp_slot, 0)
                    return disp_load
                else if contains(b.ir_methods, value)
                    let user_method = b.ir_methods[value]
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, user_method, 0)
                else if list_contains(b.ir_fnames, value)
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, value, 0)
                else
                    let rt_name = resolve_method_fn(value)
                    ir_emit_side(b, "call", dest, ir_type_any(), arg_regs, rt_name, 0)
                return dest
            else if tag == "list" or tag == "tuple"
                let dest = ir_fresh_reg(b)
                let elem_regs = []
                for child in children
                    push(elem_regs, ir_lower_expr(b, child))
                ir_emit_inst(b, "make_list", dest, ir_type_list(), elem_regs, "", len(children))
                return dest
            else if tag == "dict"
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "make_dict", dest, ir_type_dict(), [], "", 0)
                for entry in children
                    match entry
                        Expr(et, ev, en, ec, ef, eln) =>
                            let key_r = ir_lower_expr(b, ec[0])
                            let val_r = ir_lower_expr(b, ec[1])
                            ir_emit_side(b, "call", "", ir_type_void(), [dest, key_r, val_r], "nova_rt_dict_set", 0)
                return dest
            else if tag == "struct_init"
                let sname = value
                if contains(b.ir_sdefs, sname)
                    let field_params = b.ir_sdefs[sname]
                    let nfields = len(field_params)
                    let ordered_regs = []
                    let oi = 0
                    while oi < nfields
                        push(ordered_regs, "0")
                        oi = oi + 1
                    for fi_child in children
                        match fi_child
                            Expr(fi_tag, fi_name, fi_num, fi_children, fi_fields, fi_ln) =>
                                if fi_tag == "struct_spread"
                                    let _ss_src = ir_lower_expr(b, fi_children[0])
                                    let _ss_pi = 0
                                    for _ss_fp in field_params
                                        match _ss_fp
                                            Param(_ss_pn, _ss_pt, _ss_pd) =>
                                                let _ss_dest = ir_fresh_reg(b)
                                                let _ss_fi = get_ir_field_index_for(b, sname, _ss_pn)
                                                ir_emit_inst(b, "field_get", _ss_dest, ir_type_any(), [_ss_src], _ss_pn, _ss_fi)
                                                ordered_regs[_ss_pi] = _ss_dest
                                        _ss_pi = _ss_pi + 1
                                else
                                    let fi_val = ir_lower_expr(b, fi_children[0])
                                    let pi = 0
                                    for fp in field_params
                                        match fp
                                            Param(pname, ptype, pdefault) =>
                                                if pname == fi_name
                                                    ordered_regs[pi] = fi_val
                                        pi = pi + 1
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "make_struct", dest, ir_type_any(), ordered_regs, sname, nfields)
                    return dest
                else
                    let dest = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", dest, ir_type_int(), [], "0", 0)
                    return dest
            else if tag == "index"
                let obj = ir_lower_expr(b, children[0])
                let idx = ir_lower_expr(b, children[1])
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "index_get", dest, ir_type_any(), [obj, idx], "", 0)
                return dest
            else if tag == "slice"
                let sl_obj = ir_lower_expr(b, children[0])
                let sl_start = ir_lower_expr(b, children[1])
                let sl_end = ir_lower_expr(b, children[2])
                let dest = ir_fresh_reg(b)
                ir_emit_side(b, "call", dest, ir_type_any(), [sl_obj, sl_start, sl_end], "nova_rt_slice_any", 0)
                return dest
            else if tag == "field" or tag == "member"
                let fld_type = ir_type_any()
                let recv_stype = ""
                let c0 = children[0]
                match c0
                    Expr(c0t, c0v, c0n, c0c, c0f, c0l) =>
                        if c0t == "ident" and contains(b.ir_locals, c0v)
                            let lt = b.ir_locals[c0v]
                            if lt != 1 and contains(b.ir_sdefs, lt)
                                recv_stype = lt
                        else if c0t == "call" and contains(b.ir_sdefs, c0v)
                            recv_stype = c0v
                // CHAINED base (e.g. `w.inner.v`): the base of `.v` is itself a member/field/method expr,
                // which the narrow ident/call checks above miss -> recv_stype stays "" and a FLOAT field
                // is read as `any` (raw IEEE bits -> str()/arith corruption; to_json masked it via struct
                // metadata). Fall back to the general struct-type resolver, which handles nested member
                // access. Only fires when unresolved, so existing typed reads are byte-identical.
                if recv_stype == ""
                    let _cst = ir_expr_struct_type(b, c0)
                    if contains(b.ir_sdefs, _cst)
                        recv_stype = _cst
                if recv_stype != ""
                    let ftkey = recv_stype + "." + value
                    if not contains(b.ir_field_types, ftkey)
                        print("error[E1007]: struct '" + recv_stype + "' has no field '" + value + "'")
                        print("  --> <source>")
                        print("compilation failed: 1 error(s)")
                        exit(1)
                    let ft = b.ir_field_types[ftkey]
                    if ft == "float"
                        fld_type = ir_type_float()
                    else if ft == "int"
                        fld_type = ir_type_int()
                    else if ft == "string"
                        fld_type = ir_type_str()
                let obj = ir_lower_expr(b, children[0])
                let dest = ir_fresh_reg(b)
                let fi = get_ir_field_index_for(b, recv_stype, value)
                ir_emit_inst(b, "field_get", dest, fld_type, [obj], value, fi)
                return dest
            else if tag == "if"
                let cond = ir_lower_expr(b, children[0])
                let if_slot = "__ifexpr_" + str(b.ir_lc)
                b.ir_lc = b.ir_lc + 1
                let then_label = ir_fresh_label(b, "ife_then")
                let else_label = ir_fresh_label(b, "ife_else")
                let merge_label = ir_fresh_label(b, "ife_merge")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cond, else_label], then_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, then_label)
                let then_val = ir_lower_expr(b, children[1])
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [then_val], if_slot, 0)
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, else_label)
                if len(children) > 2
                    let else_val = ir_lower_expr(b, children[2])
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [else_val], if_slot, 0)
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, merge_label)
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "slot_load", dest, ir_type_any(), [], if_slot, 0)
                return dest
            else if tag == "unsafe"
                return ir_lower_expr(b, children[0])
            else if tag == "try"
                let inner = ir_lower_expr(b, children[0])
                let dest = ir_fresh_reg(b)
                ir_emit_side(b, "is_error", dest, ir_type_int(), [inner], "", 0)
                let err_label = ir_fresh_label(b, "try_err")
                let ok_label = ir_fresh_label(b, "try_ok")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [dest, ok_label], err_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, err_label)
                ir_emit_side(b, "raise_error", "", ir_type_void(), [], "", 0)
                ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
                ir_start_block(b, ok_label)
                return inner
            else if tag == "try_unwrap"
                ir_emit_side(b, "clear_is_result", "", ir_type_void(), [], "", 0)
                let inner = ir_lower_expr(b, children[0])
                let unwrapped = ir_fresh_reg(b)
                ir_emit_side(b, "try_unwrap_value", unwrapped, ir_type_any(), [inner], "", 0)
                let err_check = ir_fresh_reg(b)
                ir_emit_side(b, "is_error", err_check, ir_type_int(), [unwrapped], "", 0)
                let err_label = ir_fresh_label(b, "try_err")
                let ok_label = ir_fresh_label(b, "try_ok")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [err_check, ok_label], err_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, err_label)
                let _ctx_fn = ir_fresh_reg(b)
                ir_emit_inst(b, "const_str", _ctx_fn, ir_type_str(), [], b.ir_fn_name, 0)
                let _ctx_line = ir_fresh_reg(b)
                ir_emit_inst(b, "const_int", _ctx_line, ir_type_int(), [], "", b.ir_cur_line)
                let _wrapped = ir_fresh_reg(b)
                ir_emit_side(b, "wrap_error_ctx", _wrapped, ir_type_any(), [inner, _ctx_fn, _ctx_line], "", 0)
                ir_emit_side(b, "raise_error", "", ir_type_void(), [], "", 0)
                ir_finish_block(b, IrInst("return", "", ir_type_void(), [_wrapped], "", 0, "pure", b.ir_cur_line))
                ir_start_block(b, ok_label)
                return unwrapped
            else if tag == "catch"
                let tried = ir_lower_expr(b, children[0])
                let catch_slot = "__catch_" + str(b.ir_lc)
                b.ir_lc = b.ir_lc + 1
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [tried], catch_slot, 0)
                let err_dest = ir_fresh_reg(b)
                ir_emit_side(b, "is_error", err_dest, ir_type_int(), [tried], "", 0)
                let err_label = ir_fresh_label(b, "catch_err")
                let ok_label = ir_fresh_label(b, "catch_ok")
                let merge_label = ir_fresh_label(b, "catch_merge")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [err_dest, ok_label], err_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, err_label)
                let msg_reg = ir_fresh_reg(b)
                ir_emit_side(b, "load_error_msg", msg_reg, ir_type_str(), [], "", 0)
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [msg_reg], value, 0)
                b.ir_locals[value] = 1
                let handler_val = ""
                if num > 0
                    let ci = 0
                    while ci < len(fields)
                        if ci == len(fields) - 1
                            match fields[ci]
                                Stmt(stag, sname, sexpr, sbody, sparams, selse, sanns, ssln) =>
                                    handler_val = ir_lower_expr(b, sexpr)
                        else
                            ir_lower_stmt(b, fields[ci])
                        ci = ci + 1
                else
                    handler_val = ir_lower_expr(b, children[1])
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [handler_val], catch_slot, 0)
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, ok_label)
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [tried], catch_slot, 0)
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], merge_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, merge_label)
                let result = ir_fresh_reg(b)
                ir_emit_inst(b, "slot_load", result, ir_type_any(), [], catch_slot, 0)
                return result
            else if tag == "spawn"
                let sp_child = children[0]
                let sp_is_call = 0
                match sp_child
                    Expr(sp_ct, sp_cv, sp_cn, sp_cc, sp_cf, sp_cln) =>
                        if sp_ct == "call"
                            sp_is_call = 1
                if sp_is_call == 1
                    let sp_call_body = [Stmt("expr", "", sp_child, [], [], [], [], b.ir_cur_line)]
                    let sp_bound = []
                    let sp_free = []
                    for sp_s in sp_call_body
                        collect_free_vars_stmt(sp_s, sp_bound, sp_free)
                    let sp_caps = filter_captures(sp_free, b.ir_fnames, b.ir_sdefs)
                    let sp_tramp = ir_lift_nested_fn(b, "__spawn_call", [], sp_call_body, sp_caps)
                    let sp_cap_regs = []
                    for sp_cap in sp_caps
                        let sp_cr = ir_fresh_reg(b)
                        ir_emit_inst(b, "slot_load", sp_cr, ir_type_any(), [], sp_cap, 0)
                        push(sp_cap_regs, sp_cr)
                    let sp_closure = ir_fresh_reg(b)
                    ir_emit_inst(b, "make_closure", sp_closure, ir_type_any(), sp_cap_regs, sp_tramp, len(sp_caps))
                    let sp_fn_ptr = ir_fresh_reg(b)
                    ir_emit_inst(b, "field_get", sp_fn_ptr, ir_type_any(), [sp_closure], "__fn_ptr", 0)
                    let sp_result = ir_fresh_reg(b)
                    ir_emit_side(b, "call", sp_result, ir_type_any(), [sp_fn_ptr, sp_closure], "nova_rt_spawn", 0)
                    return sp_result
                let sp_lambda = ir_lower_expr(b, children[0])
                let sp_fn = ir_fresh_reg(b)
                ir_emit_inst(b, "field_get", sp_fn, ir_type_any(), [sp_lambda], "__fn_ptr", 0)
                let sp_dest = ir_fresh_reg(b)
                ir_emit_side(b, "call", sp_dest, ir_type_any(), [sp_fn, sp_lambda], "nova_rt_spawn", 0)
                return sp_dest
            else if tag == "match"
                let m_subject = ir_lower_expr(b, children[0])
                let m_arm_count = len(children) - 1
                let m_exit = ir_fresh_label(b, "mexpr_exit")
                let m_slot = "__mexpr_" + str(b.ir_lc)
                b.ir_lc = b.ir_lc + 1
                let m_is_value = 0
                let m_si = 1
                while m_si < len(children)
                    match children[m_si]
                        Expr(m_at, m_av, m_an, m_ac, m_af, m_aln) =>
                            if len(m_ac) >= 1
                                match m_ac[0]
                                    Expr(m_spt, m_spv, m_spn, m_spc, m_spf, m_spln) =>
                                        if m_spt == "pat_lit" or m_spt == "pat_str" or m_spt == "pat_var" or m_spt == "pat_range" or m_spt == "pat_or"
                                            m_is_value = 1
                    m_si = m_si + 1
                let m_hash = ""
                if m_is_value == 0
                    m_hash = ir_fresh_reg(b)
                    ir_emit_inst(b, "field_get", m_hash, ir_type_int(), [m_subject], "__type_hash", 0)
                let m_arm_labels = []
                let m_aidx = 0
                while m_aidx < m_arm_count
                    push(m_arm_labels, ir_fresh_label(b, "mearm_" + str(m_aidx)))
                    m_aidx = m_aidx + 1
                let m_check_labels = []
                let m_cidx = 1
                while m_cidx < m_arm_count
                    push(m_check_labels, ir_fresh_label(b, "mechk_" + str(m_cidx)))
                    m_cidx = m_cidx + 1
                let m_fall = ir_fresh_label(b, "mexpr_fall")
                let m_arm_idx = 0
                let m_ai = 1
                while m_ai < len(children)
                    match children[m_ai]
                        Expr(m_at2, m_av2, m_an2, m_ac2, m_af2, m_aln2) =>
                            let m_pattern = m_ac2[0]
                            let m_body_expr = m_ac2[1]
                            match m_pattern
                                Expr(m_pt, m_pv, m_pn, m_pchildren, m_pf, m_pln2) =>
                                    if m_pt == "pat_ctor"
                                        if m_arm_idx > 0
                                            ir_start_block(b, m_check_labels[m_arm_idx - 1])
                                        let m_expected = type_name_hash(m_pv)
                                        if m_pn == 1
                                            m_expected = 1
                                            if m_pv == "Ok" or m_pv == "Some"
                                                m_expected = 0
                                        else if m_pv == "Ok" or m_pv == "Err"
                                            // Ok/Err are ALWAYS the built-in Result constructors (no user type is
                                            // named Ok/Err). If inference did NOT mark this match as a Result sum
                                            // (m_pn != 1 -- e.g. the subject is an `any`-typed value returned from
                                            // a `-> any` function, the common library/module case), fall back to
                                            // the Result tag (Ok->0, Err->1) instead of the bogus type-name-hash
                                            // struct path that matches NEITHER arm. Fixes `match` on an any-typed
                                            // Result inside a module fn (was: silent wrong-arm / fall-through).
                                            m_expected = 0
                                            if m_pv == "Err"
                                                m_expected = 1
                                        let m_exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", m_exp_reg, ir_type_int(), [], str(m_expected), m_expected)
                                        let m_cmp = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", m_cmp, ir_type_int(), [m_hash, m_exp_reg], "==", 0)
                                        let m_next = m_fall
                                        if m_arm_idx + 1 < m_arm_count
                                            m_next = m_check_labels[m_arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [m_cmp, m_next], m_arm_labels[m_arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, m_arm_labels[m_arm_idx])
                                        let m_fi = 1
                                        for m_fp in m_pchildren
                                            match m_fp
                                                Expr(m_fpt, m_fpv, m_fpn, m_fpc, m_fpf, m_fpln) =>
                                                    if m_fpv != "_"
                                                        let m_pstype = ir_match_ok_payload_stype(b, children[0], m_pv)
                                                        let m_fld_ty = ir_type_any()
                                                        if m_pstype != ""
                                                            b.ir_locals[m_fpv] = m_pstype
                                                        else
                                                            m_fld_ty = ir_bind_variant_payload_type(b, m_pv, m_fi - 1, m_fpv)
                                                        let m_fd = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "field_get", m_fd, m_fld_ty, [m_subject], m_fpv, m_fi)
                                                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [m_fd], m_fpv, 0)
                                            m_fi = m_fi + 1
                                    else if m_pt == "pat_lit"
                                        if m_arm_idx > 0
                                            ir_start_block(b, m_check_labels[m_arm_idx - 1])
                                        let m_exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", m_exp_reg, ir_type_int(), [], m_pv, m_pn)
                                        let m_cmp = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", m_cmp, ir_type_int(), [m_subject, m_exp_reg], "==", 0)
                                        let m_next = m_fall
                                        if m_arm_idx + 1 < m_arm_count
                                            m_next = m_check_labels[m_arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [m_cmp, m_next], m_arm_labels[m_arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, m_arm_labels[m_arm_idx])
                                    else if m_pt == "pat_str"
                                        if m_arm_idx > 0
                                            ir_start_block(b, m_check_labels[m_arm_idx - 1])
                                        let m_exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_str", m_exp_reg, ir_type_str(), [], m_pv, 0)
                                        let m_cmp = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", m_cmp, ir_type_str(), [m_subject, m_exp_reg], "==", 0)
                                        let m_next = m_fall
                                        if m_arm_idx + 1 < m_arm_count
                                            m_next = m_check_labels[m_arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [m_cmp, m_next], m_arm_labels[m_arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, m_arm_labels[m_arm_idx])
                                    else if m_pt == "pat_range"
                                        if m_arm_idx > 0
                                            ir_start_block(b, m_check_labels[m_arm_idx - 1])
                                        let m_rlo = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", m_rlo, ir_type_int(), [], m_pv, m_pn)
                                        let m_rge = ir_fresh_reg(b)
                                        ir_emit_inst(b, "ge", m_rge, ir_type_int(), [m_subject, m_rlo], ">=", 0)
                                        let m_rhi_v = ""
                                        let m_rhi_n = 0
                                        if len(m_pchildren) > 0
                                            match m_pchildren[0]
                                                Expr(_rht, _rhv, _rhn, _rhc, _rhf, _rhl) =>
                                                    m_rhi_v = _rhv
                                                    m_rhi_n = _rhn
                                        let m_rhi = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", m_rhi, ir_type_int(), [], m_rhi_v, m_rhi_n)
                                        let m_rle = ir_fresh_reg(b)
                                        ir_emit_inst(b, "le", m_rle, ir_type_int(), [m_subject, m_rhi], "<=", 0)
                                        let m_rand = ir_fresh_reg(b)
                                        ir_emit_inst(b, "and", m_rand, ir_type_int(), [m_rge, m_rle], "and", 0)
                                        let m_next = m_fall
                                        if m_arm_idx + 1 < m_arm_count
                                            m_next = m_check_labels[m_arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [m_rand, m_next], m_arm_labels[m_arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, m_arm_labels[m_arm_idx])
                                    else if m_pt == "pat_or"
                                        if m_arm_idx > 0
                                            ir_start_block(b, m_check_labels[m_arm_idx - 1])
                                        let _mo_i = 0
                                        while _mo_i < len(m_pchildren)
                                            match m_pchildren[_mo_i]
                                                Expr(_mot, _mov, _mon, _moc, _mof, _mol) =>
                                                    let _mo_ok = m_arm_labels[m_arm_idx]
                                                    let _mo_fail = m_fall
                                                    if _mo_i + 1 < len(m_pchildren)
                                                        _mo_fail = ir_fresh_label(b, "mor_" + str(m_arm_idx) + "_" + str(_mo_i + 1))
                                                    else if m_arm_idx + 1 < m_arm_count
                                                        _mo_fail = m_check_labels[m_arm_idx]
                                                    if _mot == "pat_lit"
                                                        let _mo_e = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_int", _mo_e, ir_type_int(), [], _mov, _mon)
                                                        let _mo_c = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "eq", _mo_c, ir_type_int(), [m_subject, _mo_e], "==", 0)
                                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [_mo_c, _mo_fail], _mo_ok, 0, "pure", b.ir_cur_line))
                                                    else if _mot == "pat_str"
                                                        let _mo_e = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_str", _mo_e, ir_type_str(), [], _mov, 0)
                                                        let _mo_c = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "eq", _mo_c, ir_type_str(), [m_subject, _mo_e], "==", 0)
                                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [_mo_c, _mo_fail], _mo_ok, 0, "pure", b.ir_cur_line))
                                                    else if _mot == "pat_range"
                                                        let _mo_rlo = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_int", _mo_rlo, ir_type_int(), [], _mov, _mon)
                                                        let _mo_rge = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "ge", _mo_rge, ir_type_int(), [m_subject, _mo_rlo], ">=", 0)
                                                        let _mo_rhi_v = ""
                                                        let _mo_rhi_n = 0
                                                        if len(_moc) > 0
                                                            match _moc[0]
                                                                Expr(_mrt, _mrv, _mrn, _mrc, _mrf, _mrl) =>
                                                                    _mo_rhi_v = _mrv
                                                                    _mo_rhi_n = _mrn
                                                        let _mo_rhi = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_int", _mo_rhi, ir_type_int(), [], _mo_rhi_v, _mo_rhi_n)
                                                        let _mo_rle = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "le", _mo_rle, ir_type_int(), [m_subject, _mo_rhi], "<=", 0)
                                                        let _mo_ra = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "and", _mo_ra, ir_type_int(), [_mo_rge, _mo_rle], "and", 0)
                                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [_mo_ra, _mo_fail], _mo_ok, 0, "pure", b.ir_cur_line))
                                                    else
                                                        ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], _mo_ok, 0, "pure", b.ir_cur_line))
                                                    if _mo_i + 1 < len(m_pchildren)
                                                        ir_start_block(b, _mo_fail)
                                            _mo_i = _mo_i + 1
                                        ir_start_block(b, m_arm_labels[m_arm_idx])
                                    else
                                        if m_arm_idx > 0
                                            ir_start_block(b, m_check_labels[m_arm_idx - 1])
                                        if m_pt == "pat_var" and m_pv != "_"
                                            ir_emit_inst(b, "slot_store", "", ir_type_void(), [m_subject], m_pv, 0)
                                            b.ir_locals[m_pv] = 1
                            if len(m_ac2) > 2
                                match m_ac2[2]
                                    Expr(mg_tag, mg_v, mg_n, mg_ch, mg_f, mg_ln) =>
                                        if mg_tag != "null"
                                            let mg_val = ir_lower_expr(b, m_ac2[2])
                                            let mg_ok = ir_fresh_label(b, "mguard_ok_" + str(m_arm_idx))
                                            let mg_next = m_fall
                                            if m_arm_idx + 1 < m_arm_count
                                                mg_next = m_check_labels[m_arm_idx]
                                            ir_finish_block(b, IrInst("branch", "", ir_type_void(), [mg_val, mg_next], mg_ok, 0, "pure", b.ir_cur_line))
                                            ir_start_block(b, mg_ok)
                            let m_val = ir_lower_expr(b, m_body_expr)
                            ir_emit_inst(b, "slot_store", "", ir_type_void(), [m_val], m_slot, 0)
                            if b.ir_clabel != ""
                                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], m_exit, 0, "pure", b.ir_cur_line))
                    m_arm_idx = m_arm_idx + 1
                    m_ai = m_ai + 1
                ir_start_block(b, m_fall)
                let m_zero = ir_fresh_reg(b)
                ir_emit_inst(b, "const_int", m_zero, ir_type_int(), [], "0", 0)
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [m_zero], m_slot, 0)
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], m_exit, 0, "pure", b.ir_cur_line))
                ir_start_block(b, m_exit)
                let m_result = ir_fresh_reg(b)
                ir_emit_inst(b, "slot_load", m_result, ir_type_any(), [], m_slot, 0)
                return m_result
            // Fallback
            let dest = ir_fresh_reg(b)
            ir_emit_inst(b, "const_int", dest, ir_type_any(), [], "0", 0)
            return dest

fn get_ir_field_index(b: IrBuilder, field_name: string) -> int
    if contains(b.ir_fmap, field_name)
        return b.ir_fmap[field_name]
    0

fn get_ir_field_index_for(b: IrBuilder, stype: string, field_name: string) -> int
    if stype != "" and contains(b.ir_sdefs, stype)
        let sparams = b.ir_sdefs[stype]
        // @repr(C) structs: no leading type-hash slot, so fields start at 0.
        let sfi = 1
        if contains(b.ir_repr_c_types, stype)
            sfi = 0
        for sp in sparams
            match sp
                Param(spn, spt, spd) =>
                    if spn == field_name
                        return sfi
            sfi = sfi + 1
    get_ir_field_index(b, field_name)

fn _is_builtin_type_name(n)
    n == "int" or n == "float" or n == "string" or n == "list" or n == "dict" or n == "bool"

fn ir_expr_struct_type(b: IrBuilder, expr: Expr) -> string
    match expr
        Expr(et, ev, en, ec, ef, eln) =>
            if et == "int"
                return "int"
            if et == "float"
                return "float"
            if et == "str" or et == "string"
                return "string"
            if et == "list" or et == "list_init"
                return "list"
            if et == "dict" or et == "dict_init"
                return "dict"
            if et == "bool" or (et == "ident" and (ev == "true" or ev == "false"))
                return "bool"
            if et == "struct_init" and contains(b.ir_sdefs, ev)
                return ev
            if et == "call" and contains(b.ir_sdefs, ev)
                return ev
            if et == "call" and contains(b.ir_fn_returns, ev)
                let rt = b.ir_fn_returns[ev]
                if contains(b.ir_sdefs, rt) or _is_builtin_type_name(rt)
                    return rt
            if (et == "method" or et == "method_call") and len(ec) >= 1
                // Module-qualified call `mod.fn()` is tagged `method` (receiver mod + name ev), not
                // `call`. If the receiver is an imported module and fn's return type is known
                // (ir_fn_returns, populated for imports above), resolve it -- so an unannotated
                // `let x = mod.fn()` types x PER-STRUCT (mirrors the module-call lowering ~7723).
                match ec[0]
                    Expr(rmt, rmv, rmn, rmc, rmf, rml) =>
                        if rmt == "ident" and contains(b.ir_modules, rmv) and contains(b.ir_fn_returns, ev)
                            let mrt = b.ir_fn_returns[ev]
                            if contains(b.ir_sdefs, mrt) or _is_builtin_type_name(mrt)
                                return mrt
            if et == "ident" and contains(b.ir_locals, ev)
                let lt = b.ir_locals[ev]
                if lt != 1 and (contains(b.ir_sdefs, lt) or _is_builtin_type_name(lt))
                    return lt
            if (et == "member" or et == "field") and len(ec) >= 1
                // Field access self.f: resolve the receiver's struct type, then look up the
                // declared type of field f. Enables static dispatch on nested struct fields
                // (e.g. Seg__show rendering its Point fields via a direct Point__show call,
                // instead of a runtime __type_hash probe that a tagless record struct lacks).
                let mem_recv = ir_expr_struct_type(b, ec[0])
                if mem_recv != ""
                    let mem_key = mem_recv + "." + ev
                    if contains(b.ir_field_types, mem_key)
                        let mem_ft = b.ir_field_types[mem_key]
                        if contains(b.ir_sdefs, mem_ft)
                            return mem_ft
            if et == "index" and len(ec) >= 1
                // Indexing a list-of-known-struct `xs[i]` yields that struct -> resolve the element
                // struct type so a chained `xs[i].floatField` reads the float correctly (else the index
                // result is `any` and the float field is read as raw bits). dict[k] stays dynamic (dicts
                // are heterogeneous) -> "".
                let _idx_elem = ir_list_elem_struct(b, ec[0])
                if contains(b.ir_sdefs, _idx_elem)
                    return _idx_elem
            if et == "binop" and len(ec) >= 2
                let bin_lt = ir_expr_struct_type(b, ec[0])
                if bin_lt != ""
                    let bin_m = ""
                    if ev == "+"
                        bin_m = "add"
                    else if ev == "-"
                        bin_m = "sub"
                    else if ev == "*"
                        bin_m = "mul"
                    else if ev == "/"
                        bin_m = "div"
                    else if ev == "%"
                        bin_m = "rem"
                    if bin_m != ""
                        let bin_cand = bin_lt + "__" + bin_m
                        if contains(b.ir_fn_returns, bin_cand)
                            let bin_rt = b.ir_fn_returns[bin_cand]
                            if contains(b.ir_sdefs, bin_rt)
                                return bin_rt
            if et == "method_call" and len(ec) >= 1
                let mc_recv = ir_expr_struct_type(b, ec[0])
                if mc_recv != ""
                    let mc_cand = mc_recv + "__" + ev
                    if contains(b.ir_fn_returns, mc_cand)
                        let mc_rt = b.ir_fn_returns[mc_cand]
                        if contains(b.ir_sdefs, mc_rt)
                            return mc_rt
            if et == "unary" and len(ec) >= 1
                let un_lt = ir_expr_struct_type(b, ec[0])
                if un_lt != ""
                    let un_m = ""
                    if ev == "-"
                        un_m = "neg"
                    else if ev == "not"
                        un_m = "not"
                    if un_m != ""
                        let un_cand = un_lt + "__" + un_m
                        if contains(b.ir_fn_returns, un_cand)
                            let un_rt = b.ir_fn_returns[un_cand]
                            if contains(b.ir_sdefs, un_rt)
                                return un_rt
    ""

// Stage-1 list-element-type query: if `expr` is provably a list whose elements are ALL the same
// struct type, return that struct name, else "". Conservative (never claims a type it can't prove)
// -- a list literal needs every child to be the same struct in ir_sdefs; an ident reads the
// recorded ir_list_elem_stype; a fn-call reads ir_fn_ret_list_elem (from a -> list<Struct> return
// annotation). Pure query (never mutates b). Used by the json_stringify list-of-structs dispatch.
fn ir_list_elem_struct(b: IrBuilder, expr: Expr) -> string
    match expr
        Expr(et, ev, en, ec, ef, eln) =>
            if et == "list" or et == "list_init"
                if len(ec) == 0
                    return ""
                let _les_first = ir_expr_struct_type(b, ec[0])
                if _les_first == "" or not contains(b.ir_sdefs, _les_first)
                    return ""
                let _les_i = 1
                while _les_i < len(ec)
                    let _les_ci = ir_expr_struct_type(b, ec[_les_i])
                    if _les_ci != _les_first
                        return ""
                    _les_i = _les_i + 1
                return _les_first
            if et == "ident" and contains(b.ir_list_elem_stype, ev)
                let _les_v = b.ir_list_elem_stype[ev]
                if _les_v != "" and _les_v != "!"   // "" = unknown/empty (upgradeable); "!" = heterogeneous (poisoned)
                    return _les_v
            if et == "call" and contains(b.ir_fn_ret_list_elem, ev)
                return b.ir_fn_ret_list_elem[ev]
    ""

// S1 nominal struct-return: does EVERY terminal/exit path of `body` return a direct constructor
// of struct `sname`? Maximally conservative (fail-closed): returns false on any construct not
// explicitly proven. Prevents the null-return CVE by rejecting fns where any path returns null
// or a non-struct value, so ir_fn_returns is never set for such fns.
fn _s1_expr_is_struct_ctor(e: Expr, sname: string) -> bool
    match e
        Expr(et, ev, en, ec, ef, eln) =>
            if et == "struct_init" and ev == sname
                return true
            if et == "call" and ev == sname
                return true
    return false

fn _s1_stmts_all_return_struct(stmts: list, sname: string) -> bool
    // Walk the statement list. Every explicit `return` must return a struct ctor of sname.
    // The trailing statement (if it is an expr) is an implicit return and must also be a ctor.
    // If there is no trailing expr and no return on every path, the fn falls through to null -> false.
    let n = len(stmts)
    if n == 0
        return false
    let i = 0
    while i < n
        let s = stmts[i]
        match s
            Stmt(st, sn, se, sb, sp, sel, sa, sl) =>
                if st == "return"
                    if not _s1_expr_is_struct_ctor(se, sname)
                        return false
                    // This return is good; but other paths may still exist after it (dead code),
                    // or earlier stmts may have if/match with returns. Continue scanning.
                if st == "if"
                    // An if at the tail of the block that has BOTH branches all-returning-struct
                    // covers the tail. But a mid-block if with returns only on some paths is
                    // complex; be conservative. Only handle: if/else where BOTH branches
                    // all-return-struct (recursively), which covers the remaining paths.
                    // An if WITHOUT else that doesn't return on some path => fallthrough => check tail.
                    // We don't need to mandate anything about mid-block if's that don't return,
                    // since they just fall through to the next statement.
                    // But if this if has a return in only ONE branch, the other falls through.
                    // We just continue scanning; the return-checking handles explicit returns.
                    0
                if st == "match"
                    // Same logic: match arms with returns are checked individually when we
                    // encounter `return` stmts inside them. We continue scanning.
                    0
        i = i + 1
    // After scanning all stmts, check the trailing statement. It is the implicit return
    // if there's no explicit `return` covering this path.
    let last = stmts[n - 1]
    match last
        Stmt(lt, ln2, le, lb, lp, lel, la, ll) =>
            if lt == "expr"
                return _s1_expr_is_struct_ctor(le, sname)
            if lt == "return"
                // Already checked above — if we reach here the return was good
                return _s1_expr_is_struct_ctor(le, sname)
            if lt == "if"
                // Tail if/else: both branches must all-return-struct
                if len(lel) == 0
                    return false
                if not _s1_stmts_all_return_struct(lb, sname)
                    return false
                return _s1_stmts_all_return_struct(lel, sname)
            if lt == "match"
                // All arms must all-return-struct
                if len(lb) == 0
                    return false
                for _s1_arm in lb
                    match _s1_arm
                        Stmt(_s1at, _s1an, _s1ap, _s1ab, _s1app, _s1ae, _s1aa, _s1al) =>
                            if not _s1_stmts_all_return_struct(_s1ab, sname)
                                return false
                return true
    return false

fn _fn_all_paths_return_struct(body: list, sname: string, sdefs: dict) -> bool
    if not contains(sdefs, sname)
        return false
    // First pass: check every explicit `return` in the entire body (recursively).
    // Any return of a non-sname value -> reject immediately.
    if not _s1_body_returns_ok(body, sname)
        return false
    // Second pass: check that the trailing path covers (implicit return).
    return _s1_stmts_all_return_struct(body, sname)

fn _s1_body_returns_ok(stmts: list, sname: string) -> bool
    // Recursively check that every `return` stmt in the body returns a ctor of sname.
    for s in stmts
        match s
            Stmt(st, sn, se, sb, sp, sel, sa, sl) =>
                if st == "return"
                    if not _s1_expr_is_struct_ctor(se, sname)
                        return false
                if st == "if"
                    if not _s1_body_returns_ok(sb, sname)
                        return false
                    if not _s1_body_returns_ok(sel, sname)
                        return false
                if st == "match"
                    for _s1_arm in sb
                        match _s1_arm
                            Stmt(_s1at, _s1an, _s1ap, _s1ab, _s1app, _s1ae, _s1aa, _s1al) =>
                                if not _s1_body_returns_ok(_s1ab, sname)
                                    return false
                if st == "while" or st == "for"
                    if not _s1_body_returns_ok(sb, sname)
                        return false
    return true

fn ir_lower_stmt(b: IrBuilder, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if sline > 0
                b.ir_cur_line = sline
            if tag == "expr"
                // Stage-1: track a list-of-struct local's element type through push(ident, struct_val).
                // Only simple ident targets; clear to "" on a heterogeneous push (conservative).
                match expr
                    Expr(_pe_t, _pe_v, _pe_n, _pe_c, _pe_f, _pe_l) =>
                        if _pe_t == "call" and _pe_v == "push" and len(_pe_c) == 2
                            match _pe_c[0]
                                Expr(_pe_lt, _pe_lv, _pe_ln, _pe_lc, _pe_lf, _pe_ll) =>
                                    if _pe_lt == "ident"
                                        let _pe_elem = ir_expr_struct_type(b, _pe_c[1])
                                        if _pe_elem != "" and contains(b.ir_sdefs, _pe_elem)
                                            if not contains(b.ir_list_elem_stype, _pe_lv) or b.ir_list_elem_stype[_pe_lv] == ""
                                                b.ir_list_elem_stype[_pe_lv] = _pe_elem   // first real element upgrades unknown/empty
                                            else if b.ir_list_elem_stype[_pe_lv] != _pe_elem
                                                b.ir_list_elem_stype[_pe_lv] = "!"        // differing struct -> heterogeneous, poison
                ir_lower_expr(b, expr)
            else if tag == "let"
                let val = ir_lower_expr(b, expr)
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [val], name, 0)
                let let_stype = ir_expr_struct_type(b, expr)
                if let_stype != ""
                    b.ir_locals[name] = let_stype
                else
                    b.ir_locals[name] = 1
                // Stage-1: record a homogeneous list-of-struct local's element type (or "" to FORGET
                // a stale struct if this let rebinds the name to a non-struct-list / non-list -- a
                // same-name re-let must never inherit a prior struct type, else mis-specialization).
                if let_stype == "list"
                    b.ir_list_elem_stype[name] = ir_list_elem_struct(b, expr)
                else if contains(b.ir_list_elem_stype, name)
                    b.ir_list_elem_stype[name] = ""
            else if tag == "assign"
                // Typed-let dispatch for automatic from_json: `let p: T = from_json(d)`
                // where T is a struct rewrites the call to the compiler-derived
                // <T>__from_json (inverse of the automatic <T>__to_json), zero annotation.
                let eff_expr = expr
                let fj_type = ""
                let ann_type = ""
                let fj_force_any = 0
                let fj_result_inner = ""
                let fj_list_elem = ""
                if len(params) > 0
                    match params[0]
                        Param(fj_pn, fj_pt, fj_pd) =>
                            if len(fj_pt) > 8 and fj_pt[0:7] == "Result<" and fj_pt[len(fj_pt)-1:len(fj_pt)] == ">"
                                // Typed-let over Result<T>: `let r: Result<User> = from_json_safe(s)`
                                // rewrites to <User>__from_json_safe(s) (compiler-derived, validating).
                                // The slot MUST stay SUM-typed (Result), so force_any -> never record
                                // the inner struct in ir_locals; otherwise `match r { Ok(t)/Err(e) }`
                                // would mis-dispatch (ti collapses Result<T> -> T and mistypes r).
                                let fj_inner = fj_pt[7:len(fj_pt)-1]
                                if contains(b.ir_sdefs, fj_inner)
                                    // Record the Result PAYLOAD struct so `match r { Ok(s) => s.floatField }`
                                    // recovers s's struct type (else match-Ok drops it and a float field
                                    // reads back as raw bits). Recorded for ANY Result<Struct> let, not just
                                    // from_json_safe -- purely additive (only ir_match_ok_payload_stype reads it).
                                    fj_result_inner = fj_inner
                                    match expr
                                        Expr(fs_et, fs_ev, fs_en, fs_ec, fs_ef, fs_el) =>
                                            if fs_et == "call" and fs_ev == "from_json_safe"
                                                eff_expr = Expr("call", fj_inner + "__from_json_safe", fs_en, fs_ec, fs_ef, fs_el)
                                                fj_force_any = 1
                                            else if fs_et == "call" and fs_ev == "form_as"
                                                // `let r: Result<T> = form_as(d)` -> <T>__from_dict(d)
                                                // (d = a {string:string} form/row dict). Validating, name-keyed.
                                                eff_expr = Expr("call", fj_inner + "__from_dict", fs_en, fs_ec, fs_ef, fs_el)
                                                fj_force_any = 1
                                            else if fs_et == "call" and fs_ev == "body_as"
                                                // Forge T2.1: `let u: Result<T> = body_as(req.body)` -> the SAFE
                                                // <T>__from_json_safe path (B5: never raw from_json). Args pass
                                                // straight through, exactly like the from_json_safe arm.
                                                eff_expr = Expr("call", fj_inner + "__from_json_safe", fs_en, fs_ec, fs_ef, fs_el)
                                                fj_force_any = 1
                                            else if fs_et == "call" and fs_ev == "query_as"
                                                // Forge T2.1: `let r: Result<T> = query_as(req.query)` — the ARG IS the
                                                // name-keyed dict -> <T>__from_dict(dict). Validating, fail-closed.
                                                eff_expr = Expr("call", fj_inner + "__from_dict", fs_en, fs_ec, fs_ef, fs_el)
                                                fj_force_any = 1
                                            else if fs_et == "call" and fs_ev == "db_find"
                                                // Forge T2.1: `let r: Result<T> = db_find(pool,table,id)` — the row is the
                                                // db_find RESULT, so apply <T>__from_dict to the WHOLE call (not its args).
                                                eff_expr = Expr("call", fj_inner + "__from_dict", 0, [expr], [], fs_el)
                                                fj_force_any = 1
                                            else if fs_et == "call" and fs_ev == "orm_one"
                                                // Universal ORM: `let r: Result<T> = orm_one(db, sql, params)` returns ONE
                                                // name-keyed row dict from ANY driver (sqlite/pg/...). Apply <T>__from_dict
                                                // to the whole call, exactly like db_find — DB-agnostic typed mapping.
                                                eff_expr = Expr("call", fj_inner + "__from_dict", 0, [expr], [], fs_el)
                                                fj_force_any = 1
                                            else if fs_et == "call" and fs_ev == "orm_get"
                                                // Universal ORM repository: `let u: Result<T> = orm_get(db, table, id)` ->
                                                // <T>__from_dict on the single-row result (find-by-id, no SQL to write).
                                                eff_expr = Expr("call", fj_inner + "__from_dict", 0, [expr], [], fs_el)
                                                fj_force_any = 1
                            else if contains(b.ir_sdefs, fj_pt)
                                // The typed-let's DECLARED struct type (`let x: T = ...`). Record it
                                // regardless of the RHS: it is the authoritative static type of `x`,
                                // and it lets field access resolve `x.field` PER-STRUCT (via ir_sdefs)
                                // instead of the global name->slot map, which collides when two structs
                                // share a field name (e.g. Request.headers vs Response.headers ->
                                // wrong-slot read). Used as a fallback below when RHS inference is "".
                                ann_type = fj_pt
                                match expr
                                    Expr(fj_et, fj_ev, fj_en, fj_ec, fj_ef, fj_el) =>
                                        if fj_et == "call" and fj_ev == "from_json"
                                            // from_json(jsonString) -> <T>__from_json(json_decode(jsonString))
                                            let fj_decoded = Expr("call", "json_decode", 0, fj_ec, [], fj_el)
                                            eff_expr = Expr("call", fj_pt + "__from_json", fj_en, [fj_decoded], fj_ef, fj_el)
                                            fj_type = fj_pt
                            else if len(fj_pt) > 6 and fj_pt[0:5] == "list<" and fj_pt[len(fj_pt)-1:len(fj_pt)] == ">"
                                // Forge T2.4: `let xs: list<T> = db_all(pool, table)` -> <T>__from_dict_list(db_all(...)),
                                // a generated typed loop yielding REAL <T> handles. DIRECT call (like db_find) -> no
                                // post-ti HOF/lambda typing gap (the map+lambda approach yielded list<Result<T>> garbage).
                                // `orm_all(db, sql, params)` is the universal (DB-agnostic) row source -- same rewrite.
                                let fj_le = fj_pt[5:len(fj_pt)-1]
                                if contains(b.ir_sdefs, fj_le)
                                    match expr
                                        Expr(la_et, la_ev, la_en, la_ec, la_ef, la_el) =>
                                            if la_et == "call" and (la_ev == "db_all" or la_ev == "orm_all" or la_ev == "orm_where")
                                                eff_expr = Expr("call", fj_le + "__from_dict_list", 0, [expr], [], la_el)
                                                fj_list_elem = fj_le
                let val = ir_lower_expr(b, eff_expr)
                if name != ""
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [val], name, 0)
                    if fj_result_inner != ""
                        b.ir_result_elem_stype[name] = fj_result_inner
                    if fj_list_elem != ""
                        // db_all rewrote to <T>__from_dict_list(...) (a call): mark the slot a list of
                        // the element struct so `for x in xs` types x as <T> (mirrors the list-literal
                        // path at :8785). The elements are REAL <T> handles, so this types correctly.
                        b.ir_locals[name] = "list"
                        b.ir_list_elem_stype[name] = fj_list_elem
                    if fj_force_any == 1
                        // Result<T> let-binding: keep the slot polymorphic so the sum tag survives
                        // for the downstream match (never type it as the inner struct).
                        b.ir_locals[name] = 1
                    else if fj_type != ""
                        b.ir_locals[name] = fj_type
                    else
                        let asg_stype = ir_expr_struct_type(b, eff_expr)
                        if asg_stype != ""
                            b.ir_locals[name] = asg_stype
                        else if ann_type != ""
                            b.ir_locals[name] = ann_type
                        else
                            b.ir_locals[name] = 1
                    // Stage-1: reassignment may change the list element type -> re-derive (set "" to
                    // forget a stale struct; the query treats "" as not-a-known-struct-list). BUT if the
                    // typed-let rewrite already resolved the element struct (fj_list_elem -- from a
                    // db_all/orm_all/orm_where `list<T>` let), KEEP it: re-deriving from the rewritten
                    // <T>__from_dict_list(...) call yields "" (that generated fn's return-list-elem is not
                    // registered), which would clobber the correct type and break `xs[i].field` slot
                    // resolution when the field name collides with another struct at a different index.
                    if fj_list_elem == ""
                        let _asg_lt = ir_expr_struct_type(b, eff_expr)
                        if _asg_lt == "list"
                            b.ir_list_elem_stype[name] = ir_list_elem_struct(b, eff_expr)
                        else if contains(b.ir_list_elem_stype, name)
                            b.ir_list_elem_stype[name] = ""
                else if len(annotations) > 0
                    let a0 = annotations[0]
                    let a0_is_ident = false
                    let a0_ident_name = ""
                    match a0
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                a0_is_ident = true
                                a0_ident_name = ev
                    if a0_is_ident
                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [val], a0_ident_name, 0)
                        let ann_stype = ir_expr_struct_type(b, expr)
                        if ann_stype != ""
                            b.ir_locals[a0_ident_name] = ann_stype
                        else
                            b.ir_locals[a0_ident_name] = 1
                    else
                        ir_lower_assign_target(b, a0, val)
            else if tag == "compound_assign"
                let rhs_val = ir_lower_expr(b, expr)
                if len(annotations) > 0
                    let lhs_expr = annotations[0]
                    let lhs_is_ident = false
                    let lhs_name = ""
                    match lhs_expr
                        Expr(et, ev, en, ec, ef, eln) =>
                            if et == "ident"
                                lhs_is_ident = true
                                lhs_name = ev
                    if lhs_is_ident
                        let lhs_val = ir_fresh_reg(b)
                        ir_emit_inst(b, "slot_load", lhs_val, ir_type_any(), [], lhs_name, 0)
                        let result = ir_fresh_reg(b)
                        if name == "+="
                            ir_emit_inst(b, "add", result, ir_type_any(), [lhs_val, rhs_val], "+", 0)
                        else if name == "-="
                            ir_emit_inst(b, "sub", result, ir_type_int(), [lhs_val, rhs_val], "-", 0)
                        else if name == "*="
                            ir_emit_inst(b, "mul", result, ir_type_int(), [lhs_val, rhs_val], "*", 0)
                        else if name == "%="
                            ir_emit_inst(b, "mod", result, ir_type_int(), [lhs_val, rhs_val], "%", 0)
                        else if name == "**="
                            ir_emit_side(b, "call", result, ir_type_int(), [lhs_val, rhs_val], "nova_rt_int_pow", 0)
                        else
                            ir_emit_inst(b, "div", result, ir_type_int(), [lhs_val, rhs_val], "/", 0)
                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [result], lhs_name, 0)
                    else
                        let lhs_val = ir_lower_expr(b, lhs_expr)
                        let result = ir_fresh_reg(b)
                        if name == "+="
                            ir_emit_inst(b, "add", result, ir_type_any(), [lhs_val, rhs_val], "+", 0)
                        else if name == "-="
                            ir_emit_inst(b, "sub", result, ir_type_int(), [lhs_val, rhs_val], "-", 0)
                        else if name == "*="
                            ir_emit_inst(b, "mul", result, ir_type_int(), [lhs_val, rhs_val], "*", 0)
                        else if name == "%="
                            ir_emit_inst(b, "mod", result, ir_type_int(), [lhs_val, rhs_val], "%", 0)
                        else if name == "**="
                            ir_emit_side(b, "call", result, ir_type_int(), [lhs_val, rhs_val], "nova_rt_int_pow", 0)
                        else
                            ir_emit_inst(b, "div", result, ir_type_int(), [lhs_val, rhs_val], "/", 0)
                        ir_lower_assign_target(b, lhs_expr, result)
            else if tag == "multi_assign"
                for _ms in body
                    ir_lower_stmt(b, _ms)
            else if tag == "return"
                let val = ir_lower_expr(b, expr)
                ir_emit_defers(b)
                ir_finish_block(b, IrInst("return", "", ir_type_void(), [val], "", 0, "pure", b.ir_cur_line))
            else if tag == "defer"
                push(b.ir_defers, expr)
            else if tag == "const"
                b.ir_consts[name] = expr
            else if tag == "yield"
                let yval = ir_lower_expr(b, expr)
                let ydiscard = ir_fresh_reg(b)
                ir_emit_side(b, "call", ydiscard, ir_type_any(), [yval], "nova_rt_gen_yield", 0)
            else if tag == "if"
                let cond = ir_lower_expr(b, expr)
                let then_label = ir_fresh_label(b, "then")
                let else_label = ir_fresh_label(b, "else")
                let end_label = ir_fresh_label(b, "endif")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cond, else_label], then_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, then_label)
                for s in body
                    ir_lower_stmt(b, s)
                if b.ir_clabel != ""
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], end_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, else_label)
                for s in else_body
                    ir_lower_stmt(b, s)
                if b.ir_clabel != ""
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], end_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, end_label)
            else if tag == "while"
                let hdr_label = ir_fresh_label(b, "while_hdr")
                let body_label = ir_fresh_label(b, "while_body")
                let exit_label = ir_fresh_label(b, "while_exit")
                let _wh_has_else = len(else_body) > 0
                let _wh_else_lbl = ""
                let _wh_done_lbl = ""
                if _wh_has_else
                    _wh_else_lbl = ir_fresh_label(b, "while_else")
                    _wh_done_lbl = ir_fresh_label(b, "while_done")
                let save_hdr = b.ir_loop_hdr
                let save_exit = b.ir_loop_exit
                b.ir_loop_hdr = hdr_label
                b.ir_loop_exit = exit_label
                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], hdr_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, hdr_label)
                let cond = ir_lower_expr(b, expr)
                if _wh_has_else
                    ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cond, _wh_else_lbl], body_label, 0, "pure", b.ir_cur_line))
                else
                    ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cond, exit_label], body_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, body_label)
                for s in body
                    ir_lower_stmt(b, s)
                if b.ir_clabel != ""
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], hdr_label, 0, "pure", b.ir_cur_line))
                if _wh_has_else
                    ir_start_block(b, exit_label)
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], _wh_done_lbl, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, _wh_else_lbl)
                    for s in else_body
                        ir_lower_stmt(b, s)
                    if b.ir_clabel != ""
                        ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], _wh_done_lbl, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, _wh_done_lbl)
                else
                    ir_start_block(b, exit_label)
                b.ir_loop_hdr = save_hdr
                b.ir_loop_exit = save_exit
            else if tag == "for"
                // Type the loop var from the iterable's element struct type (when iterating a known
                // list-of-struct), so `for p in xs: p.floatField` reads the float correctly -- else the
                // loop var is `any` and a float field reads as raw bits. Generators / unknown / non-struct
                // element types -> stays `any` (1). Mirrors the list-index resolution.
                let _for_elem = ir_list_elem_struct(b, expr)
                if contains(b.ir_sdefs, _for_elem)
                    b.ir_locals[name] = _for_elem
                else
                    b.ir_locals[name] = 1
                let for_is_gen = false
                match expr
                    Expr(fe_tag, fe_val, fe_n, fe_ch, fe_f, fe_ln) =>
                        if fe_tag == "call" and contains(b.ir_gen_fns, fe_val)
                            for_is_gen = true
                if for_is_gen
                    let gen_r = ir_lower_expr(b, expr)
                    let hdr_label = ir_fresh_label(b, "gfor_hdr")
                    let body_label = ir_fresh_label(b, "gfor_body")
                    let exit_label = ir_fresh_label(b, "gfor_exit")
                    let _ge_has_else = len(else_body) > 0
                    let _ge_else_lbl = ""
                    let _ge_done_lbl = ""
                    if _ge_has_else
                        _ge_else_lbl = ir_fresh_label(b, "gfor_else")
                        _ge_done_lbl = ir_fresh_label(b, "gfor_done")
                    let save_hdr = b.ir_loop_hdr
                    let save_exit = b.ir_loop_exit
                    b.ir_loop_hdr = hdr_label
                    b.ir_loop_exit = exit_label
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], hdr_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, hdr_label)
                    let gn_r = ir_fresh_reg(b)
                    ir_emit_side(b, "call", gn_r, ir_type_int(), [gen_r], "nova_rt_gen_next", 0)
                    let gn_zero = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", gn_zero, ir_type_int(), [], "0", 0)
                    let gn_cmp = ir_fresh_reg(b)
                    ir_emit_inst(b, "eq", gn_cmp, ir_type_int(), [gn_r, gn_zero], "==", 0)
                    if _ge_has_else
                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [gn_cmp, _ge_else_lbl], body_label, 0, "pure", b.ir_cur_line))
                    else
                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [gn_cmp, exit_label], body_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, body_label)
                    let gv_r = ir_fresh_reg(b)
                    ir_emit_side(b, "call", gv_r, ir_type_any(), [gen_r], "nova_rt_gen_value", 0)
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [gv_r], name, 0)
                    for s in body
                        ir_lower_stmt(b, s)
                    if b.ir_clabel != ""
                        ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], hdr_label, 0, "pure", b.ir_cur_line))
                    if _ge_has_else
                        ir_start_block(b, exit_label)
                        ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], _ge_done_lbl, 0, "pure", b.ir_cur_line))
                        ir_start_block(b, _ge_else_lbl)
                        for s in else_body
                            ir_lower_stmt(b, s)
                        if b.ir_clabel != ""
                            ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], _ge_done_lbl, 0, "pure", b.ir_cur_line))
                        ir_start_block(b, _ge_done_lbl)
                    else
                        ir_start_block(b, exit_label)
                    b.ir_loop_hdr = save_hdr
                    b.ir_loop_exit = save_exit
                else
                    let raw_iter = ir_lower_expr(b, expr)
                    let iter_reg = ir_fresh_reg(b)
                    let _fii_fn = "nova_rt_for_iter_init"
                    if starts_with(name, "__for_tup_")
                        _fii_fn = "nova_rt_for_destr_init"
                    if starts_with(name, "__for_kv_")
                        _fii_fn = "nova_rt_for_kv_init"
                    ir_emit_side(b, "call", iter_reg, ir_type_any(), [raw_iter], _fii_fn, 0)
                    let len_reg = ir_fresh_reg(b)
                    ir_emit_side(b, "call", len_reg, ir_type_int(), [iter_reg], "nova_rt_len_any", 0)
                    let idx_slot = "__for_idx_" + str(b.ir_lc)
                    let zero_r = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", zero_r, ir_type_int(), [], "0", 0)
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [zero_r], idx_slot, 0)
                    let hdr_label = ir_fresh_label(b, "for_hdr")
                    let body_label = ir_fresh_label(b, "for_body")
                    let inc_label = ir_fresh_label(b, "for_inc")
                    let exit_label = ir_fresh_label(b, "for_exit")
                    let _fe_has_else = len(else_body) > 0
                    let _fe_else_lbl = ""
                    let _fe_done_lbl = ""
                    if _fe_has_else
                        _fe_else_lbl = ir_fresh_label(b, "for_else")
                        _fe_done_lbl = ir_fresh_label(b, "for_done")
                    let save_hdr = b.ir_loop_hdr
                    let save_exit = b.ir_loop_exit
                    b.ir_loop_hdr = inc_label
                    b.ir_loop_exit = exit_label
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], hdr_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, hdr_label)
                    let idx_r = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", idx_r, ir_type_int(), [], idx_slot, 0)
                    let cmp_r = ir_fresh_reg(b)
                    ir_emit_inst(b, "lt", cmp_r, ir_type_int(), [idx_r, len_reg], "<", 0)
                    if _fe_has_else
                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_r, _fe_else_lbl], body_label, 0, "pure", b.ir_cur_line))
                    else
                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_r, exit_label], body_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, body_label)
                    let elem_r = ir_fresh_reg(b)
                    ir_emit_inst(b, "index_get", elem_r, ir_type_any(), [iter_reg, idx_r], "", 0)
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [elem_r], name, 0)
                    for s in body
                        ir_lower_stmt(b, s)
                    if b.ir_clabel != ""
                        ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], inc_label, 0, "pure", b.ir_cur_line))
                    ir_start_block(b, inc_label)
                    let next_idx = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", next_idx, ir_type_int(), [], idx_slot, 0)
                    let inc_r = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", inc_r, ir_type_int(), [], "1", 1)
                    let new_idx = ir_fresh_reg(b)
                    ir_emit_inst(b, "add", new_idx, ir_type_int(), [next_idx, inc_r], "+", 0)
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [new_idx], idx_slot, 0)
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], hdr_label, 0, "pure", b.ir_cur_line))
                    if _fe_has_else
                        ir_start_block(b, exit_label)
                        ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], _fe_done_lbl, 0, "pure", b.ir_cur_line))
                        ir_start_block(b, _fe_else_lbl)
                        for s in else_body
                            ir_lower_stmt(b, s)
                        if b.ir_clabel != ""
                            ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], _fe_done_lbl, 0, "pure", b.ir_cur_line))
                        ir_start_block(b, _fe_done_lbl)
                    else
                        ir_start_block(b, exit_label)
                    b.ir_loop_hdr = save_hdr
                    b.ir_loop_exit = save_exit
            else if tag == "match"
                let subject = ir_lower_expr(b, expr)
                let exit_label = ir_fresh_label(b, "match_exit")
                let sm_is_value = 0
                for sm_scan in body
                    match sm_scan
                        Stmt(sm_at, sm_an, sm_pat, sm_ab, sm_ap, sm_ae, sm_aa, sm_sl) =>
                            match sm_pat
                                Expr(sm_pt, sm_pv, sm_pn, sm_pc, sm_pf, sm_pln) =>
                                    if sm_pt == "pat_lit" or sm_pt == "pat_str" or sm_pt == "pat_var" or sm_pt == "pat_range" or sm_pt == "pat_or"
                                        sm_is_value = 1
                let hash_reg = ""
                if sm_is_value == 0
                    hash_reg = ir_fresh_reg(b)
                    ir_emit_inst(b, "field_get", hash_reg, ir_type_int(), [subject], "__type_hash", 0)
                let arm_count = len(body)
                let arm_idx = 0
                let arm_labels = []
                let aidx = 0
                while aidx < arm_count
                    push(arm_labels, ir_fresh_label(b, "marm_" + str(aidx)))
                    aidx = aidx + 1
                let check_labels = []
                let cidx = 1
                while cidx < arm_count
                    push(check_labels, ir_fresh_label(b, "mchk_" + str(cidx)))
                    cidx = cidx + 1
                let fall_label = ir_fresh_label(b, "match_fall")
                for arm in body
                    match arm
                        Stmt(at, an, pattern, arm_body, ap, ae, aa, _aln) =>
                            match pattern
                                Expr(pt, pv, pn, pchildren, pf, pln2) =>
                                    if pt == "pat_ctor"
                                        if arm_idx > 0
                                            ir_start_block(b, check_labels[arm_idx - 1])
                                        // pn==1 marks a Result/Option sum-match (set by the
                                        // inferrer): compare the NovaResult tag (Ok/Some=0,
                                        // Err/None=1) instead of a type-name hash.
                                        let expected = type_name_hash(pv)
                                        if pn == 1
                                            expected = 1
                                            if pv == "Ok" or pv == "Some"
                                                expected = 0
                                        else if pv == "Ok" or pv == "Err"
                                            // Ok/Err are ALWAYS the built-in Result constructors. If inference
                                            // did not mark this as a Result sum (pn != 1 -- e.g. the subject is
                                            // an `any`-typed value from a `-> any` fn, common in a module), use
                                            // the Result tag (Ok->0, Err->1) not the bogus type-name-hash path.
                                            expected = 0
                                            if pv == "Err"
                                                expected = 1
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", exp_reg, ir_type_int(), [], str(expected), expected)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_int(), [hash_reg, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = check_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                        let fi = 1
                                        for field_pat in pchildren
                                            match field_pat
                                                Expr(fpt, fpv, fpn, fpc, fpf, fpln) =>
                                                    if fpv != "_"
                                                        let s_pstype = ir_match_ok_payload_stype(b, expr, pv)
                                                        let s_fld_ty = ir_type_any()
                                                        if s_pstype != ""
                                                            b.ir_locals[fpv] = s_pstype
                                                        else
                                                            s_fld_ty = ir_bind_variant_payload_type(b, pv, fi - 1, fpv)
                                                        let fd = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "field_get", fd, s_fld_ty, [subject], fpv, fi)
                                                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [fd], fpv, 0)
                                            fi = fi + 1
                                    else if pt == "pat_lit"
                                        if arm_idx > 0
                                            ir_start_block(b, check_labels[arm_idx - 1])
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", exp_reg, ir_type_int(), [], pv, pn)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_int(), [subject, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = check_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else if pt == "pat_str"
                                        if arm_idx > 0
                                            ir_start_block(b, check_labels[arm_idx - 1])
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_str", exp_reg, ir_type_str(), [], pv, 0)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_str(), [subject, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = check_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else if pt == "pat_range"
                                        if arm_idx > 0
                                            ir_start_block(b, check_labels[arm_idx - 1])
                                        let pr_lo = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", pr_lo, ir_type_int(), [], pv, pn)
                                        let pr_ge = ir_fresh_reg(b)
                                        ir_emit_inst(b, "ge", pr_ge, ir_type_int(), [subject, pr_lo], ">=", 0)
                                        let pr_hi_v = ""
                                        let pr_hi_n = 0
                                        if len(pchildren) > 0
                                            match pchildren[0]
                                                Expr(_prt, _prv, _prn, _prc, _prf, _prl) =>
                                                    pr_hi_v = _prv
                                                    pr_hi_n = _prn
                                        let pr_hi = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", pr_hi, ir_type_int(), [], pr_hi_v, pr_hi_n)
                                        let pr_le = ir_fresh_reg(b)
                                        ir_emit_inst(b, "le", pr_le, ir_type_int(), [subject, pr_hi], "<=", 0)
                                        let pr_and = ir_fresh_reg(b)
                                        ir_emit_inst(b, "and", pr_and, ir_type_int(), [pr_ge, pr_le], "and", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = check_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [pr_and, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else if pt == "pat_or"
                                        if arm_idx > 0
                                            ir_start_block(b, check_labels[arm_idx - 1])
                                        let _so_i = 0
                                        while _so_i < len(pchildren)
                                            match pchildren[_so_i]
                                                Expr(_sot, _sov, _son, _soc, _sof, _sol) =>
                                                    let _so_ok = arm_labels[arm_idx]
                                                    let _so_fail = fall_label
                                                    if _so_i + 1 < len(pchildren)
                                                        _so_fail = ir_fresh_label(b, "sor_" + str(arm_idx) + "_" + str(_so_i + 1))
                                                    else if arm_idx + 1 < arm_count
                                                        _so_fail = check_labels[arm_idx]
                                                    if _sot == "pat_lit"
                                                        let _so_e = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_int", _so_e, ir_type_int(), [], _sov, _son)
                                                        let _so_c = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "eq", _so_c, ir_type_int(), [subject, _so_e], "==", 0)
                                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [_so_c, _so_fail], _so_ok, 0, "pure", b.ir_cur_line))
                                                    else if _sot == "pat_str"
                                                        let _so_e = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_str", _so_e, ir_type_str(), [], _sov, 0)
                                                        let _so_c = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "eq", _so_c, ir_type_str(), [subject, _so_e], "==", 0)
                                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [_so_c, _so_fail], _so_ok, 0, "pure", b.ir_cur_line))
                                                    else if _sot == "pat_range"
                                                        let _so_rlo = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_int", _so_rlo, ir_type_int(), [], _sov, _son)
                                                        let _so_rge = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "ge", _so_rge, ir_type_int(), [subject, _so_rlo], ">=", 0)
                                                        let _so_rhi_v = ""
                                                        let _so_rhi_n = 0
                                                        if len(_soc) > 0
                                                            match _soc[0]
                                                                Expr(_srt, _srv, _srn, _src, _srf, _srl) =>
                                                                    _so_rhi_v = _srv
                                                                    _so_rhi_n = _srn
                                                        let _so_rhi = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_int", _so_rhi, ir_type_int(), [], _so_rhi_v, _so_rhi_n)
                                                        let _so_rle = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "le", _so_rle, ir_type_int(), [subject, _so_rhi], "<=", 0)
                                                        let _so_ra = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "and", _so_ra, ir_type_int(), [_so_rge, _so_rle], "and", 0)
                                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [_so_ra, _so_fail], _so_ok, 0, "pure", b.ir_cur_line))
                                                    else
                                                        ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], _so_ok, 0, "pure", b.ir_cur_line))
                                                    if _so_i + 1 < len(pchildren)
                                                        ir_start_block(b, _so_fail)
                                            _so_i = _so_i + 1
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else
                                        if arm_idx > 0
                                            ir_start_block(b, check_labels[arm_idx - 1])
                                        if pt == "pat_var" and pv != "_"
                                            ir_emit_inst(b, "slot_store", "", ir_type_void(), [subject], pv, 0)
                                            b.ir_locals[pv] = 1
                            if len(aa) > 0
                                match aa[0]
                                    Expr(gtag, gv, gn, gch, gf, gln) =>
                                        if gtag != "null"
                                            let guard_val = ir_lower_expr(b, aa[0])
                                            let guard_ok = ir_fresh_label(b, "guard_ok_" + str(arm_idx))
                                            let guard_next = fall_label
                                            if arm_idx + 1 < arm_count
                                                guard_next = check_labels[arm_idx]
                                            ir_finish_block(b, IrInst("branch", "", ir_type_void(), [guard_val, guard_next], guard_ok, 0, "pure", b.ir_cur_line))
                                            ir_start_block(b, guard_ok)
                            for s in arm_body
                                ir_lower_stmt(b, s)
                            if b.ir_clabel != ""
                                ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], exit_label, 0, "pure", b.ir_cur_line))
                    arm_idx = arm_idx + 1
                ir_start_block(b, fall_label)
                if b.ir_clabel != ""
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], exit_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, exit_label)
            else if tag == "spawn"
                let sp_bound = []
                for sp_p in params
                    match sp_p
                        Param(sp_pn, sp_pt, sp_pd) =>
                            push(sp_bound, sp_pn)
                let sp_free = []
                for sp_s in body
                    collect_free_vars_stmt(sp_s, sp_bound, sp_free)
                let sp_caps = filter_captures(sp_free, b.ir_fnames, b.ir_sdefs)
                let sp_tramp = ir_lift_nested_fn(b, "__spawn", params, body, sp_caps)
                let sp_cap_regs = []
                for sp_cap in sp_caps
                    let sp_cr = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", sp_cr, ir_type_any(), [], sp_cap, 0)
                    push(sp_cap_regs, sp_cr)
                let sp_closure = ir_fresh_reg(b)
                ir_emit_inst(b, "make_closure", sp_closure, ir_type_any(), sp_cap_regs, sp_tramp, len(sp_caps))
                let sp_fn_ptr = ir_fresh_reg(b)
                ir_emit_inst(b, "field_get", sp_fn_ptr, ir_type_any(), [sp_closure], "__fn_ptr", 0)
                let sp_result = ir_fresh_reg(b)
                ir_emit_side(b, "call", sp_result, ir_type_any(), [sp_fn_ptr, sp_closure], "nova_rt_spawn", 0)
                if name != ""
                    b.ir_locals[name] = 1
                    ir_emit_inst(b, "slot_store", "", ir_type_void(), [sp_result], name, 0)
            else if tag == "break"
                if b.ir_loop_exit != ""
                    ir_emit_defers(b)
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], b.ir_loop_exit, 0, "pure", b.ir_cur_line))
            else if tag == "continue"
                if b.ir_loop_hdr != ""
                    ir_emit_defers(b)
                    ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], b.ir_loop_hdr, 0, "pure", b.ir_cur_line))
            else if tag == "fn"
                let fn_bound = []
                push(fn_bound, name)
                for p in params
                    match p
                        Param(pname, ptype, pdefault) =>
                            push(fn_bound, pname)
                let free = []
                for s in body
                    collect_free_vars_stmt(s, fn_bound, free)
                let captures = filter_captures(free, b.ir_fnames, b.ir_sdefs)
                let tramp_name = ir_lift_nested_fn(b, name, params, body, captures)
                let capture_regs = []
                for cap in captures
                    let cr = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", cr, ir_type_any(), [], cap, 0)
                    push(capture_regs, cr)
                let dest = ir_fresh_reg(b)
                ir_emit_inst(b, "make_closure", dest, ir_type_any(), capture_regs, tramp_name, len(captures))
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [dest], name, 0)
                b.ir_locals[name] = 1
            else if tag == "block" or tag == "unsafe_block"
                // A compound statement: lower each child in order, sharing the enclosing scope
                // (no new basic block). Used by desugarings that must return ONE Stmt holding a
                // sequence (e.g. selective `receive`), and by the #4 `unsafe` block (transparent at
                // codegen -- safety is enforced at inference, not lowering). Inference already scopes it.
                for _blk_s in body
                    ir_lower_stmt(b, _blk_s)

fn ir_lower_last_stmt(b: IrBuilder, stmt: Stmt)
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            if tag == "expr" and b.ir_clabel != ""
                let val = ir_lower_expr(b, expr)
                ir_emit_defers(b)
                ir_finish_block(b, IrInst("return", "", ir_type_void(), [val], "", 0, "pure", b.ir_cur_line))
            else if tag == "return"
                ir_lower_stmt(b, stmt)
            else if tag == "match"
                let subject = ir_lower_expr(b, expr)
                let arm_count = len(body)
                let rm_is_value = 0
                for rm_scan in body
                    match rm_scan
                        Stmt(rm_at, rm_an, rm_pat, rm_ab, rm_ap, rm_ae, rm_aa, rm_sl) =>
                            match rm_pat
                                Expr(rm_pt, rm_pv, rm_pn, rm_pc, rm_pf, rm_pln) =>
                                    if rm_pt == "pat_lit" or rm_pt == "pat_str" or rm_pt == "pat_var" or rm_pt == "pat_range" or rm_pt == "pat_or"
                                        rm_is_value = 1
                let arm_labels = []
                let aidx = 0
                while aidx < arm_count
                    push(arm_labels, ir_fresh_label(b, "rmarm_" + str(aidx)))
                    aidx = aidx + 1
                let rcheck_labels = []
                let rcidx = 1
                while rcidx < arm_count
                    push(rcheck_labels, ir_fresh_label(b, "rchk_" + str(rcidx)))
                    rcidx = rcidx + 1
                let fall_label = ir_fresh_label(b, "rmatch_fall")
                let hash_reg = ""
                if rm_is_value == 0
                    hash_reg = ir_fresh_reg(b)
                    ir_emit_inst(b, "field_get", hash_reg, ir_type_int(), [subject], "__type_hash", 0)
                let arm_idx = 0
                for arm in body
                    match arm
                        Stmt(at, an, pattern, arm_body, ap, ae, aa, _aln) =>
                            match pattern
                                Expr(pt, pv, pn, pchildren, pf, pln2) =>
                                    if pt == "pat_ctor"
                                        if arm_idx > 0
                                            ir_start_block(b, rcheck_labels[arm_idx - 1])
                                        let expected = type_name_hash(pv)
                                        if pn == 1
                                            expected = 1
                                            if pv == "Ok" or pv == "Some"
                                                expected = 0
                                        else if pv == "Ok" or pv == "Err"
                                            // Ok/Err are ALWAYS the built-in Result constructors. If inference
                                            // did not mark this a Result sum (pn != 1 -- any-typed `-> any`
                                            // subject in a module), use the Result tag (Ok->0, Err->1).
                                            expected = 0
                                            if pv == "Err"
                                                expected = 1
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", exp_reg, ir_type_int(), [], str(expected), expected)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_int(), [hash_reg, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = rcheck_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                        let fi = 1
                                        for field_pat in pchildren
                                            match field_pat
                                                Expr(fpt, fpv, fpn, fpc, fpf, fpln) =>
                                                    if fpv != "_"
                                                        let r_pstype = ir_match_ok_payload_stype(b, expr, pv)
                                                        let r_fld_ty = ir_type_any()
                                                        if r_pstype != ""
                                                            b.ir_locals[fpv] = r_pstype
                                                        else
                                                            r_fld_ty = ir_bind_variant_payload_type(b, pv, fi - 1, fpv)
                                                        let fd = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "field_get", fd, r_fld_ty, [subject], fpv, fi)
                                                        ir_emit_inst(b, "slot_store", "", ir_type_void(), [fd], fpv, 0)
                                            fi = fi + 1
                                    else if pt == "pat_lit"
                                        if arm_idx > 0
                                            ir_start_block(b, rcheck_labels[arm_idx - 1])
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", exp_reg, ir_type_int(), [], pv, pn)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_int(), [subject, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = rcheck_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else if pt == "pat_str"
                                        if arm_idx > 0
                                            ir_start_block(b, rcheck_labels[arm_idx - 1])
                                        let exp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_str", exp_reg, ir_type_str(), [], pv, 0)
                                        let cmp_reg = ir_fresh_reg(b)
                                        ir_emit_inst(b, "eq", cmp_reg, ir_type_str(), [subject, exp_reg], "==", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = rcheck_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cmp_reg, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else if pt == "pat_range"
                                        if arm_idx > 0
                                            ir_start_block(b, rcheck_labels[arm_idx - 1])
                                        let rp_lo = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", rp_lo, ir_type_int(), [], pv, pn)
                                        let rp_ge = ir_fresh_reg(b)
                                        ir_emit_inst(b, "ge", rp_ge, ir_type_int(), [subject, rp_lo], ">=", 0)
                                        let rp_hi_v = ""
                                        let rp_hi_n = 0
                                        if len(pchildren) > 0
                                            match pchildren[0]
                                                Expr(_rpt2, _rpv2, _rpn2, _rpc2, _rpf2, _rpl2) =>
                                                    rp_hi_v = _rpv2
                                                    rp_hi_n = _rpn2
                                        let rp_hi = ir_fresh_reg(b)
                                        ir_emit_inst(b, "const_int", rp_hi, ir_type_int(), [], rp_hi_v, rp_hi_n)
                                        let rp_le = ir_fresh_reg(b)
                                        ir_emit_inst(b, "le", rp_le, ir_type_int(), [subject, rp_hi], "<=", 0)
                                        let rp_and = ir_fresh_reg(b)
                                        ir_emit_inst(b, "and", rp_and, ir_type_int(), [rp_ge, rp_le], "and", 0)
                                        let next_label = fall_label
                                        if arm_idx + 1 < arm_count
                                            next_label = rcheck_labels[arm_idx]
                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [rp_and, next_label], arm_labels[arm_idx], 0, "pure", b.ir_cur_line))
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else if pt == "pat_or"
                                        if arm_idx > 0
                                            ir_start_block(b, rcheck_labels[arm_idx - 1])
                                        let _ro_i = 0
                                        while _ro_i < len(pchildren)
                                            match pchildren[_ro_i]
                                                Expr(_rot, _rov, _ron, _roc, _rof, _rol) =>
                                                    let _ro_ok = arm_labels[arm_idx]
                                                    let _ro_fail = fall_label
                                                    if _ro_i + 1 < len(pchildren)
                                                        _ro_fail = ir_fresh_label(b, "ror_" + str(arm_idx) + "_" + str(_ro_i + 1))
                                                    else if arm_idx + 1 < arm_count
                                                        _ro_fail = rcheck_labels[arm_idx]
                                                    if _rot == "pat_lit"
                                                        let _ro_e = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_int", _ro_e, ir_type_int(), [], _rov, _ron)
                                                        let _ro_c = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "eq", _ro_c, ir_type_int(), [subject, _ro_e], "==", 0)
                                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [_ro_c, _ro_fail], _ro_ok, 0, "pure", b.ir_cur_line))
                                                    else if _rot == "pat_str"
                                                        let _ro_e = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_str", _ro_e, ir_type_str(), [], _rov, 0)
                                                        let _ro_c = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "eq", _ro_c, ir_type_str(), [subject, _ro_e], "==", 0)
                                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [_ro_c, _ro_fail], _ro_ok, 0, "pure", b.ir_cur_line))
                                                    else if _rot == "pat_range"
                                                        let _ro_rlo = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_int", _ro_rlo, ir_type_int(), [], _rov, _ron)
                                                        let _ro_rge = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "ge", _ro_rge, ir_type_int(), [subject, _ro_rlo], ">=", 0)
                                                        let _ro_rhi_v = ""
                                                        let _ro_rhi_n = 0
                                                        if len(_roc) > 0
                                                            match _roc[0]
                                                                Expr(_rrt, _rrv, _rrn, _rrc, _rrf, _rrl) =>
                                                                    _ro_rhi_v = _rrv
                                                                    _ro_rhi_n = _rrn
                                                        let _ro_rhi = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "const_int", _ro_rhi, ir_type_int(), [], _ro_rhi_v, _ro_rhi_n)
                                                        let _ro_rle = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "le", _ro_rle, ir_type_int(), [subject, _ro_rhi], "<=", 0)
                                                        let _ro_ra = ir_fresh_reg(b)
                                                        ir_emit_inst(b, "and", _ro_ra, ir_type_int(), [_ro_rge, _ro_rle], "and", 0)
                                                        ir_finish_block(b, IrInst("branch", "", ir_type_void(), [_ro_ra, _ro_fail], _ro_ok, 0, "pure", b.ir_cur_line))
                                                    else
                                                        ir_finish_block(b, IrInst("goto", "", ir_type_void(), [], _ro_ok, 0, "pure", b.ir_cur_line))
                                                    if _ro_i + 1 < len(pchildren)
                                                        ir_start_block(b, _ro_fail)
                                            _ro_i = _ro_i + 1
                                        ir_start_block(b, arm_labels[arm_idx])
                                    else
                                        if arm_idx > 0
                                            ir_start_block(b, rcheck_labels[arm_idx - 1])
                                        if pt == "pat_var" and pv != "_"
                                            ir_emit_inst(b, "slot_store", "", ir_type_void(), [subject], pv, 0)
                                            b.ir_locals[pv] = 1
                            if len(aa) > 0
                                match aa[0]
                                    Expr(rg_tag, rg_v, rg_n, rg_ch, rg_f, rg_ln) =>
                                        if rg_tag != "null"
                                            let rg_val = ir_lower_expr(b, aa[0])
                                            let rg_ok = ir_fresh_label(b, "rguard_ok_" + str(arm_idx))
                                            let rg_next = fall_label
                                            if arm_idx + 1 < arm_count
                                                rg_next = rcheck_labels[arm_idx]
                                            ir_finish_block(b, IrInst("branch", "", ir_type_void(), [rg_val, rg_next], rg_ok, 0, "pure", b.ir_cur_line))
                                            ir_start_block(b, rg_ok)
                            let arm_len = len(arm_body)
                            if arm_len > 0
                                let ai = 0
                                while ai < arm_len - 1
                                    ir_lower_stmt(b, arm_body[ai])
                                    ai = ai + 1
                                ir_lower_last_stmt(b, arm_body[arm_len - 1])
                            else
                                if b.ir_clabel != ""
                                    ir_emit_defers(b)
                                    ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
                    arm_idx = arm_idx + 1
                ir_start_block(b, fall_label)
                if b.ir_clabel != ""
                    ir_emit_defers(b)
                    ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
            else if tag == "if"
                let cond = ir_lower_expr(b, expr)
                let then_label = ir_fresh_label(b, "retthen")
                let else_label = ir_fresh_label(b, "retelse")
                ir_finish_block(b, IrInst("branch", "", ir_type_void(), [cond, else_label], then_label, 0, "pure", b.ir_cur_line))
                ir_start_block(b, then_label)
                let then_len = len(body)
                if then_len > 0
                    let ti = 0
                    while ti < then_len - 1
                        ir_lower_stmt(b, body[ti])
                        ti = ti + 1
                    ir_lower_last_stmt(b, body[then_len - 1])
                else
                    if b.ir_clabel != ""
                        ir_emit_defers(b)
                        ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
                ir_start_block(b, else_label)
                let else_len = len(else_body)
                if else_len > 0
                    let ei = 0
                    while ei < else_len - 1
                        ir_lower_stmt(b, else_body[ei])
                        ei = ei + 1
                    ir_lower_last_stmt(b, else_body[else_len - 1])
                else
                    if b.ir_clabel != ""
                        ir_emit_defers(b)
                        ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
            else
                ir_lower_stmt(b, stmt)
                if b.ir_clabel != ""
                    ir_emit_defers(b)
                    ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))

fn ir_lower_assign_target(b: IrBuilder, target: Expr, val_reg: string)
    match target
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                ir_emit_inst(b, "slot_store", "", ir_type_void(), [val_reg], value, 0)
                b.ir_locals[value] = 1
            else if tag == "index"
                let target_r = ir_lower_expr(b, children[0])
                let idx_r = ir_lower_expr(b, children[1])
                ir_emit_side(b, "index_set", "", ir_type_void(), [target_r, idx_r, val_reg], "", 0)
            else if tag == "member"
                let target_r = ir_lower_expr(b, children[0])
                let mstype = ""
                match children[0]
                    Expr(mc0t, mc0v, mc0n, mc0c, mc0f, mc0l) =>
                        if mc0t == "ident" and contains(b.ir_locals, mc0v)
                            let mlt = b.ir_locals[mc0v]
                            if mlt != 1 and contains(b.ir_sdefs, mlt)
                                mstype = mlt
                        else if mc0t == "call" and contains(b.ir_sdefs, mc0v)
                            mstype = mc0v
                let fi = get_ir_field_index_for(b, mstype, value)
                let ptr_reg = ir_fresh_reg(b)
                // CORE_GAP 0.8: thread the field's declared type (kind slot of typ) so the emitter can
                // keep scalar writes inline and route managed/unknown writes through nova_rt_field_set.
                // "" (receiver type unknown, e.g. arr[i].f=x) is treated as non-scalar -> the runtime
                // helper self-classifies via the struct's bitmap.
                let _fs_ftype = ""
                if mstype != "" and contains(b.ir_field_types, mstype + "." + value)
                    _fs_ftype = b.ir_field_types[mstype + "." + value]
                ir_emit_inst(b, "field_set", ptr_reg, IrType(_fs_ftype, "", [], 0), [target_r, val_reg], value, fi)
            else if tag == "tuple"
                let ti = 0
                for tc in children
                    let idx_reg = ir_fresh_reg(b)
                    ir_emit_inst(b, "const_int", idx_reg, ir_type_int(), [], str(ti), ti)
                    let elem_reg = ir_fresh_reg(b)
                    ir_emit_side(b, "call", elem_reg, ir_type_any(), [val_reg, idx_reg], "nova_rt_index_get", 0)
                    ir_lower_assign_target(b, tc, elem_reg)
                    ti = ti + 1

fn ir_emit_defers(b: IrBuilder)
    let di = len(b.ir_defers) - 1
    while di >= 0
        let _df = ir_lower_expr(b, b.ir_defers[di])
        di = di - 1

fn ir_flush_pending_block(b: IrBuilder)
    if b.ir_clabel != ""
        ir_emit_defers(b)
        ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))

fn source_type_to_ir(t: string) -> IrType
    if t == "int"
        ir_type_int()
    else if t == "string" or t == "str"
        ir_type_str()
    else if t == "list"
        IrType("list", "", [], 0)
    else if t == "dict"
        IrType("dict", "", [], 0)
    else if t == "bool"
        ir_type_int()
    else
        ir_type_any()

// Returns the target variable of an assignment/let statement. Handles both
// parser forms: name-based (Stmt.name set) and the IDENT-led form where name
// is "" and the LHS identifier is annotations[0]. "" if not a simple
// single-identifier assignment.
fn fl_assign_var(stmt: Stmt) -> string
    let result = ""
    match stmt
        Stmt(t, n, e, sb, sp, seb, sa, sl) =>
            if t == "let" or t == "assign"
                if n != ""
                    result = n
                else if len(sa) == 1
                    match sa[0]
                        Expr(at, av, an, ac, af, al) =>
                            if at == "ident"
                                result = av
    result

// List-fill loop optimization. Recognizes the exact pattern
//   L = []
//   CV = 0
//   while CV <= LIMIT   (or <)
//       L.push(Vconst)
//       CV = CV + 1
// at body[i..i+2] and replaces it with a single bulk allocation:
//   L  = nova_rt_list_create_filled(LIMIT+1, Vconst)
//   CV = max(0, LIMIT+1)
// LIMIT must be a plain identifier (loop-invariant, side-effect-free) distinct
// from L and CV. The transformation is semantically exact for any LIMIT value
// (create_filled clamps count<0 to 0; max gives CV its true final value).
// Returns 3 if matched and emitted, 0 otherwise. Conservative by design:
// any deviation from the exact pattern yields 0 (no change).
fn ir_try_fill_loop(b: IrBuilder, body: list, i: int) -> int
    if b.ir_clabel == ""
        return 0
    if i + 3 >= len(body)
        return 0
    let s0 = body[i]
    let s1 = body[i + 1]
    let s2 = body[i + 2]
    // stmt 0:  L = []
    let lname = fl_assign_var(s0)
    if lname == ""
        return 0
    let s0_ok = 0
    match s0
        Stmt(t0, n0, e0, sb0, sp0, seb0, sa0, sl0) =>
            match e0
                Expr(et0, ev0, en0, ec0, ef0, eel0) =>
                    if et0 == "list" and len(ec0) == 0
                        s0_ok = 1
    if s0_ok == 0
        return 0
    // stmt 1:  CV = 0
    let cvname = fl_assign_var(s1)
    if cvname == ""
        return 0
    let s1_ok = 0
    match s1
        Stmt(t1, n1, e1, sb1, sp1, seb1, sa1, sl1) =>
            match e1
                Expr(et1, ev1, en1, ec1, ef1, eel1) =>
                    if et1 == "int" and en1 == 0
                        s1_ok = 1
    if s1_ok == 0
        return 0
    if cvname == lname
        return 0
    // stmt 2:  while CV <op> LIMIT { L.push(Vint); CV = CV + 1 }
    let fl_matched = 0
    let limitname = ""
    let fl_op = ""
    let fl_vnum = 0
    match s2
        Stmt(t2, n2, e2, sb2, sp2, seb2, sa2, sl2) =>
            if t2 == "while" and len(sb2) == 2
                match e2
                    Expr(et2, ev2, en2, ec2, ef2, eel2) =>
                        if et2 == "binop" and (ev2 == "<=" or ev2 == "<") and len(ec2) == 2
                            let lhs_is_cv = 0
                            match ec2[0]
                                Expr(clt, clv, cln, clc, clf, cll) =>
                                    if clt == "ident" and clv == cvname
                                        lhs_is_cv = 1
                            let rhs_name = ""
                            match ec2[1]
                                Expr(crt, crv, crn, crc, crf, crl) =>
                                    if crt == "ident"
                                        rhs_name = crv
                            if lhs_is_cv == 1 and rhs_name != "" and rhs_name != cvname and rhs_name != lname
                                let push_ok = 0
                                let inc_ok = 0
                                match sb2[0]
                                    Stmt(pt, pn, pe, pb, pp, peb, pa, pl) =>
                                        if pt == "expr"
                                            match pe
                                                Expr(met, mev, men, mec, mef, mel) =>
                                                    if (met == "method" or met == "method_call") and mev == "push" and len(mec) == 2
                                                        let recv_is_l = 0
                                                        match mec[0]
                                                            Expr(rct, rcv, rcn, rcc, rcf, rcl) =>
                                                                if rct == "ident" and rcv == lname
                                                                    recv_is_l = 1
                                                        let arg_is_int = 0
                                                        let arg_num = 0
                                                        match mec[1]
                                                            Expr(aat, aav, aan, aac, aaf, aal) =>
                                                                if aat == "int"
                                                                    arg_is_int = 1
                                                                    arg_num = aan
                                                        if recv_is_l == 1 and arg_is_int == 1
                                                            push_ok = 1
                                                            fl_vnum = arg_num
                                match sb2[1]
                                    Stmt(gstag, gsname, gsexpr, gsbody, gsparams, gselse, gsann, gsline) =>
                                        if fl_assign_var(sb2[1]) == cvname
                                            match gsexpr
                                                Expr(iet, iev, ien, iec, ief, iel) =>
                                                    if iet == "binop" and iev == "+" and len(iec) == 2
                                                        let inc_l = 0
                                                        match iec[0]
                                                            Expr(ilt, ilv, iln, ilc, ilf, ill) =>
                                                                if ilt == "ident" and ilv == cvname
                                                                    inc_l = 1
                                                        let inc_r = 0
                                                        match iec[1]
                                                            Expr(irt, irv, irn, irc, irf, irl) =>
                                                                if irt == "int" and irn == 1
                                                                    inc_r = 1
                                                        if inc_l == 1 and inc_r == 1
                                                            inc_ok = 1
                                if push_ok == 1 and inc_ok == 1
                                    fl_matched = 1
                                    limitname = rhs_name
                                    fl_op = ev2
    if fl_matched == 0
        return 0
    // emit: count = LIMIT (+1 for <=)
    let limit_reg = ir_fresh_reg(b)
    ir_emit_inst(b, "slot_load", limit_reg, ir_type_int(), [], limitname, 0)
    let count_reg = limit_reg
    if fl_op == "<="
        let one_reg = ir_fresh_reg(b)
        ir_emit_inst(b, "const_int", one_reg, ir_type_int(), [], "1", 1)
        let cnt_reg = ir_fresh_reg(b)
        ir_emit_inst(b, "add", cnt_reg, ir_type_int(), [limit_reg, one_reg], "+", 0)
        count_reg = cnt_reg
    // emit: V (fill value)
    let v_reg = ir_fresh_reg(b)
    ir_emit_inst(b, "const_int", v_reg, ir_type_int(), [], str(fl_vnum), fl_vnum)
    // emit: L = nova_rt_list_create_filled(count, V)
    let l_reg = ir_fresh_reg(b)
    ir_emit_side(b, "call", l_reg, ir_type_list(), [count_reg, v_reg], "nova_rt_list_create_filled", 0)
    ir_emit_inst(b, "slot_store", "", ir_type_void(), [l_reg], lname, 0)
    b.ir_locals[lname] = 1
    // emit: CV = max(0, count)  -- exact final counter value
    let zero_reg = ir_fresh_reg(b)
    ir_emit_inst(b, "const_int", zero_reg, ir_type_int(), [], "0", 0)
    let cv_reg = ir_fresh_reg(b)
    ir_emit_side(b, "call", cv_reg, ir_type_int(), [zero_reg, count_reg], "nova_rt_max", 0)
    ir_emit_inst(b, "slot_store", "", ir_type_void(), [cv_reg], cvname, 0)
    b.ir_locals[cvname] = 1
    return 3

// ── S4.2 escape-versioning pre-pass (see S4_TYPED_ARRAYS_DESIGN.md §AUTO-TRANSFORM) ──────────────────
// A float array that ESCAPES (passed to a fn) is demoted floatlist->val by taint, so a later hot
// `xs[j]` read falls to the boxed path (160xC). This pre-pass wraps such a loop in
// `if list_is_kind2(xs) == 1: <fast clone> else: <original>`; the fast clone shadows xs via
// `floatlist_view(xs)` (typed floatlist on a fresh reg) and ALPHA-RENAMES every local it declares/writes
// (NOVA uses name-based slots -> a shared name = shared boxed slot = no win). SOUND by construction (the
// runtime guard yields the fast path ONLY for a kind-2 list, else the byte-identical original). BOUNDED:
// bails (-> original) on any tag/shape it does not fully handle. Stmt fields are polymorphic per tag, so
// body is always Stmt-list; else_body is Stmt-list ONLY for while/if (Expr-list [LHS] for indexed-assign).

fn s4_stmt_is_block(tag: string) -> int
    if tag == "while" or tag == "if" or tag == "for"
        return 1
    return 0

// Typed accessors: a list element (body[i]/children[i]/else_body[i]) is `any`; field access `.tag` on
// `any` reads a wrong offset. Passing it through a typed param coerces it (same as ir_lower_stmt(body[i]))
// so the field read is correct. ALWAYS route list-element field reads through these.
fn s4_et(e: Expr) -> string
    return e.tag
fn s4_ev(e: Expr) -> string
    return e.value
fn s4_st(s: Stmt) -> string
    return s.tag
fn s4_child0(e: Expr) -> Expr
    return e.children[0]

// does Expr e read `var[...]` anywhere?
fn s4_e_reads_idx(e: Expr, var: string) -> int
    if e.tag == "index" and len(e.children) >= 1
        let h0 = s4_child0(e)
        if h0.tag == "ident" and h0.value == var
            return 1
    for c in e.children
        if s4_e_reads_idx(c, var) == 1
            return 1
    for f in e.fields
        if s4_e_reads_idx(f, var) == 1
            return 1
    return 0

// does Stmt s (recursively) read `var[...]`?
fn s4_s_reads_idx(s: Stmt, var: string) -> int
    if s4_e_reads_idx(s.expr, var) == 1
        return 1
    for bs in s.body
        if s4_s_reads_idx(bs, var) == 1
            return 1
    if s4_stmt_is_block(s.tag) == 1
        for es in s.else_body
            if s4_s_reads_idx(es, var) == 1
                return 1
    return 0

// does Expr e use `var` as a plain call ARGUMENT (an escape)? (var appearing as an ident child of a
// "call" -- excludes `var[j]` which is an "index" node, not a call arg)
fn s4_e_escapes(e: Expr, var: string) -> int
    if e.tag == "call"
        for a in e.children
            if s4_et(a) == "ident" and s4_ev(a) == var
                return 1
    for c in e.children
        if s4_e_escapes(c, var) == 1
            return 1
    for f in e.fields
        if s4_e_escapes(f, var) == 1
            return 1
    return 0

fn s4_s_escapes(s: Stmt, var: string) -> int
    if s4_e_escapes(s.expr, var) == 1
        return 1
    for bs in s.body
        if s4_s_escapes(bs, var) == 1
            return 1
    if s4_stmt_is_block(s.tag) == 1
        for es in s.else_body
            if s4_s_escapes(es, var) == 1
                return 1
    return 0

// does Stmt s mutate `var` in place? push(var,..) OR var[i]=.. (index-set). Over-detect -> safer bail.
fn s4_s_mutates(s: Stmt, var: string) -> int
    // indexed-assign: Stmt("assign", "", rhs, .., else_body=[LHS index Expr])
    if s.tag == "assign" and s.name == ""
        for lhs in s.else_body
            if s4_et(lhs) == "index" and s4_e_reads_idx(lhs, var) == 1
                return 1
    if s4_e_mutates(s.expr, var) == 1
        return 1
    for bs in s.body
        if s4_s_mutates(bs, var) == 1
            return 1
    if s4_stmt_is_block(s.tag) == 1
        for es in s.else_body
            if s4_s_mutates(es, var) == 1
                return 1
    return 0

fn s4_e_mutates(e: Expr, var: string) -> int
    // push(var, ..) / insert / remove / sort / index_set-style builtins with var as arg0
    if e.tag == "call" and len(e.children) >= 1
        let a0 = s4_child0(e)
        if a0.tag == "ident" and a0.value == var
            let fn2 = e.value
            if fn2 == "push" or fn2 == "pop" or fn2 == "insert" or fn2 == "remove" or fn2 == "sort" or fn2 == "sort_by" or fn2 == "reverse" or fn2 == "clear" or fn2 == "extend" or fn2 == "append" or fn2 == "set"
                return 1
    for c in e.children
        if s4_e_mutates(c, var) == 1
            return 1
    for f in e.fields
        if s4_e_mutates(f, var) == 1
            return 1
    return 0

// is Stmt s in the fully-handled tag set (so the alpha-rename below is total over it)? Exprs are handled
// uniformly by s4_rename_e (rename idents, recurse) -- EXCEPT nodes carrying Stmt children (lambda/closure)
// which we reject here so the rename never mis-walks a Stmt as an Expr.
fn s4_s_ok(s: Stmt) -> int
    let t = s.tag
    if t != "assign" and t != "while" and t != "if" and t != "for" and t != "expr" and t != "return" and t != "break" and t != "continue"
        return 0
    if s4_e_ok(s.expr) == 0
        return 0
    for bs in s.body
        if s4_s_ok(bs) == 0
            return 0
    if s4_stmt_is_block(t) == 1
        for es in s.else_body
            if s4_s_ok(es) == 0
                return 0
    else
        for ex in s.else_body
            if s4_e_ok(ex) == 0
                return 0
    for pp in s.params
        if s4_e_ok(pp) == 0
            return 0
    for an in s.annotations
        if s4_e_ok(an) == 0
            return 0
    return 1

fn s4_e_ok(e: Expr) -> int
    if e.tag == "lambda" or e.tag == "closure" or e.tag == "fn" or e.tag == "match" or e.tag == "block"
        return 0
    for c in e.children
        if s4_e_ok(c) == 0
            return 0
    for f in e.fields
        if s4_e_ok(f) == 0
            return 0
    return 1

// collect assignment TARGET names (both `let` and reassign use tag "assign" with name) into acc
fn s4_collect_writes(s: Stmt, acc: list)
    if s.tag == "assign" and s.name != ""
        if not contains(acc, s.name)
            push(acc, s.name)
    if s.tag == "for" and s.name != ""
        if not contains(acc, s.name)
            push(acc, s.name)
    for bs in s.body
        s4_collect_writes(bs, acc)
    if s4_stmt_is_block(s.tag) == 1
        for es in s.else_body
            s4_collect_writes(es, acc)

// bounded alpha-rename: clone e/s renaming any ident/target whose name is a key of map m
fn s4_rename_e(e: Expr, m: dict) -> Expr
    let nv = e.value
    if e.tag == "ident" and contains(m, e.value)
        nv = m[e.value]
    let nc = []
    for c in e.children
        push(nc, s4_rename_e(c, m))
    let nf = []
    for f in e.fields
        push(nf, s4_rename_e(f, m))
    return Expr(e.tag, nv, e.num, nc, nf, e.eline)

fn s4_rename_s(s: Stmt, m: dict) -> Stmt
    let nn = s.name
    if s.name != "" and contains(m, s.name)
        nn = m[s.name]
    let nexpr = s4_rename_e(s.expr, m)
    let nbody = []
    for bs in s.body
        push(nbody, s4_rename_s(bs, m))
    let neb = []
    if s4_stmt_is_block(s.tag) == 1
        for es in s.else_body
            push(neb, s4_rename_s(es, m))
    else
        for ex in s.else_body
            push(neb, s4_rename_e(ex, m))
    let nparams = []
    for pp in s.params
        push(nparams, s4_rename_e(pp, m))
    let nann = []
    for an in s.annotations
        push(nann, s4_rename_e(an, m))
    return Stmt(s.tag, nn, nexpr, nbody, nparams, neb, nann, s.sline)

// collect the base var names of index reads `V[..]` in an Expr/Stmt
fn s4_idx_bases_e(e: Expr, acc: list)
    if e.tag == "index" and len(e.children) >= 1
        let b0 = s4_child0(e)
        if b0.tag == "ident" and not contains(acc, b0.value)
            push(acc, b0.value)
    for c in e.children
        s4_idx_bases_e(c, acc)
    for f in e.fields
        s4_idx_bases_e(f, acc)

fn s4_idx_bases_s(s: Stmt, acc: list)
    s4_idx_bases_e(s.expr, acc)
    for bs in s.body
        s4_idx_bases_s(bs, acc)
    if s4_stmt_is_block(s.tag) == 1
        for es in s.else_body
            s4_idx_bases_s(es, acc)

// build the guarded/versioned replacement for a qualifying loop reading escaped float array `xs`.
// prevars = var names in scope BEFORE this loop (params + earlier top-level assigns) -> loop-carried.
fn s4_make_versioned(lp: Stmt, xs: string, prevars: list) -> Stmt
    let ln = lp.sline
    let sfx = "__s4f" + str(ln)
    let writes = []
    s4_collect_writes(lp, writes)
    let m = {}
    m[xs] = xs + sfx
    for w in writes
        m[w] = w + sfx
    let fast = []
    for w in writes
        if w != xs and contains(prevars, w)
            push(fast, Stmt("assign", w + sfx, Expr("ident", w, 0, [], [], ln), [], [], [], [], ln))
    push(fast, Stmt("assign", xs + sfx, Expr("call", "floatlist_view", 0, [Expr("ident", xs, 0, [], [], ln)], [], ln), [], [], [], [], ln))
    push(fast, s4_rename_s(lp, m))
    for w in writes
        if w != xs and contains(prevars, w)
            push(fast, Stmt("assign", w, Expr("ident", w + sfx, 0, [], [], ln), [], [], [], [], ln))
    let guard = Expr("call", "list_is_kind2", 0, [Expr("ident", xs, 0, [], [], ln)], [], ln)
    let slow = []
    push(slow, lp)
    return Stmt("if", "", guard, fast, [], slow, [], ln)

// the pre-pass: transform each qualifying top-level loop in a function body. Gated OFF by default
// (NOVA_S4_ESCAPE=1) so the default build stays byte-identical until validated.
fn s4_versioning(body: list, pnames: list) -> list
    let prevars = []
    for pn in pnames
        push(prevars, pn)
    let out = []
    let k = 0
    let n = len(body)
    while k < n
        let s = body[k]
        let stag = s4_st(s)
        let did = 0
        if (stag == "while" or stag == "for") and s4_s_ok(s) == 1
            let bases = []
            s4_idx_bases_s(s, bases)
            let chosen = ""
            for xs in bases
                // qualify: xs not mutated in the loop, AND xs is not passed to a function INSIDE the
                // loop (a callee could mutate/alias it mid-loop -> deopt elem_kind 2->0 -> a subsequent
                // fast read would unbox a non-float = corruption; s4_s_mutates only catches builtin
                // mutators, so this escape-in-loop guard closes the user-function case). `f(xs[j])` passes
                // an element (an index node), not xs, so it does NOT trip this.
                if chosen == "" and s4_s_mutates(s, xs) == 0 and s4_s_escapes(s, xs) == 0
                    let esc = 0
                    let j = 0
                    while j < k
                        if s4_s_escapes(body[j], xs) == 1
                            esc = 1
                        j = j + 1
                    if esc == 1
                        chosen = xs
            if chosen != ""
                push(out, s4_make_versioned(s, chosen, prevars))
                did = 1
        if did == 0
            push(out, s)
        s4_collect_writes(s, prevars)
        k = k + 1
    return out

fn ir_lower_function(b: IrBuilder, stmt: Stmt) -> IrFunction
    match stmt
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            let ir_params = []
            b.ir_locals = {}
            b.ir_list_elem_stype = {}   // CVE-critical: reset per-fn so a list-local elem type never leaks across functions (same-name collision -> mis-specialization)
            // Inferred param struct-types (Stage 1): the HM inferer already knows an
            // unannotated param's struct type; use it so field access lowers natively
            // (a.x*b.x -> fmul, not nova_rt_mul). See PERFORMANCE_SPECIALIZATION.md.
            let _fnkey = name
            if _fnkey == "main"
                _fnkey = "nova_user_main"
            let _inf_pst = []
            if contains(b.ir_fn_param_stypes, _fnkey)
                _inf_pst = b.ir_fn_param_stypes[_fnkey]
            let _pidx = 0
            let _s4_pnames = []
            for p in params
                match p
                    Param(pname, ptype, pdefault) =>
                        push(ir_params, IrParam(pname, source_type_to_ir(ptype)))
                        push(_s4_pnames, pname)
                        if ptype != "" and (contains(b.ir_sdefs, ptype) or _is_builtin_type_name(ptype))
                            b.ir_locals[pname] = ptype
                        else if _pidx < len(_inf_pst) and contains(b.ir_sdefs, _inf_pst[_pidx])
                            b.ir_locals[pname] = _inf_pst[_pidx]
                        else
                            b.ir_locals[pname] = 1
                        _pidx = _pidx + 1
            let dunder = find(name, "__")
            if dunder > 0
                let self_type = slice(name, 0, dunder)
                if contains(b.ir_sdefs, self_type)
                    b.ir_locals["self"] = self_type
            b.ir_insts = []
            b.ir_blocks = []
            b.ir_clabel = "entry"
            b.ir_rc = 0
            b.ir_defers = []
            b.ir_fn_name = name
            ir_mark_move_sends(b, body)
            let is_gen = stmts_has_yield(body) and not starts_with(name, "__nfn_")
            if is_gen
                b.ir_gen_fns[name] = 1
                let gen_captures = []
                for gp in params
                    match gp
                        Param(gpn, gpt, gpd) =>
                            push(gen_captures, gpn)
                let gen_tramp = ir_lift_nested_fn(b, name + "_gen", [], body, gen_captures)
                let gen_cap_regs = []
                for gc in gen_captures
                    let gcr = ir_fresh_reg(b)
                    ir_emit_inst(b, "slot_load", gcr, ir_type_any(), [], gc, 0)
                    push(gen_cap_regs, gcr)
                let gen_clo = ir_fresh_reg(b)
                ir_emit_inst(b, "make_closure", gen_clo, ir_type_any(), gen_cap_regs, gen_tramp, len(gen_captures))
                let gen_fib = ir_fresh_reg(b)
                ir_emit_side(b, "call", gen_fib, ir_type_any(), [gen_clo], "nova_rt_fiber_create", 0)
                ir_emit_defers(b)
                ir_finish_block(b, IrInst("return", "", ir_type_void(), [gen_fib], "", 0, "pure", b.ir_cur_line))
            else
                // S4.2 escape-versioning pre-pass. DEFAULT-ON (transparent perf): wraps a hot loop over an
                // escaped float array in a list_is_kind2 guard + fast clone -> auto ~160x->~1.2x C on
                // escaped float-array reads, sound (guard yields the fast path only for a runtime kind-2
                // list), bounded (bails to byte-identical original otherwise, ~4-8% .ll bloat on programs
                // that have qualifying loops, 0% otherwise). Set NOVA_S4_ESCAPE=0 to disable.
                let s4body = body
                if env("NOVA_S4_ESCAPE") != "0"
                    s4body = s4_versioning(body, _s4_pnames)
                let n_body = len(s4body)
                if n_body > 0
                    let i = 0
                    while i < n_body - 1
                        let consumed = ir_try_fill_loop(b, s4body, i)
                        if consumed > 0
                            i = i + consumed
                        else
                            ir_lower_stmt(b, s4body[i])
                            i = i + 1
                    ir_lower_last_stmt(b, s4body[n_body - 1])
            ir_flush_pending_block(b)
            if len(b.ir_blocks) == 0
                ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
            let emit_name = name
            if emit_name == "main"
                emit_name = "nova_user_main"
            IrFunction(emit_name, ir_params, ir_type_any(), b.ir_blocks, [], 0)

// ══════════════════════════════════════════════════════════════════════════════
// AST-Level Type Inferrer (Hindley-Milner with constraint solving)
// Runs between parsing and IR lowering. Produces function return types
// and type errors. Feeds into the IR pipeline for better codegen.
// ══════════════════════════════════════════════════════════════════════════════

// ── NType: Structural type representation ────────────────────────────────────
// kind: "int","float","string","bool","unit","any","nothing","range",
//       "list","dict","tuple","channel","fn","struct","sum","process","var"
// params: child NTypes (semantics depend on kind)
//   list → [elem], dict → [key, val], fn → [p1..pN, ret], channel → [payload]
//   sum → [ok, err], process → [yield], tuple → elements
// id: TypeVar id (kind=="var" only)
// name: struct name (kind=="struct" only)

type NType
    kind: string
    name: string
    params: list
    id: int

type NTypeScheme
    quantified: list
    body: NType

type NConstraint
    a: NType
    b: NType
    line: int

type TiState
    ti_next_id: int
    ti_bindings: dict
    ti_constraints: list
    ti_errors: list
    ti_scope: list
    ti_structs: dict
    ti_fn_types: dict
    ti_ret_var: NType
    ti_in_fn: string
    ti_stdlib: dict
    ti_unify_count: int
    ti_budget_reported: bool    // #16: per-drain flag — fail-closed budget error emitted at most once per ti_solve drain
    ti_strict: bool             // #16: NOVA_TI_STRICT opt-in — per-drain budget reset + fail-closed exhaustion. OFF = historical fail-open (byte-identical).
    ti_source_lines: list
    ti_min_arity: dict
    ti_enum_variants: dict
    ti_variant_enum: dict
    ti_filename: string
    ti_modules: dict
    ti_traits: dict
    ti_type_traits: dict
    ti_type_methods: dict
    ti_fn_defer: dict
    ti_fn_bounds: dict
    ti_bound_checks: list
    ti_extern_fns: dict
    ti_unsafe_depth: int
    ti_opaque_types: dict
    ti_trait_defaults: dict
    ti_aliases: dict
    ti_variadic: dict
    ti_must_use: list
    ti_fn_param_types: dict
    ti_trait_method_arity: dict
    ti_type_method_arity: dict
    ti_fn_ret_stypes: dict
    ti_ret_open: bool           // TIER 1: current fn has NO concrete return annotation -> DEFERRED tolerant return join (collect returns, widen to `any` only on genuine concrete conflict AFTER ti_solve resolves them). Preserves the inferred concrete type when returns agree.
    ti_ret_seen: list           // TIER 1: collected return-expression types for the current open fn (joined + bound to ret_var after ti_solve).
    ti_fn_hetero: dict          // TIER 1: fn name -> 1 if its return type was widened to `any` because its returns GENUINELY DISAGREE (heterogeneous). The IR frt fixpoint must NOT refine these back to a first-return concrete type (else print/box dispatch on a non-primary-type return is wrong). Distinct from an incomplete `any` (which the IR MAY refine).
    ti_trait_method_ptypes: dict   // LOCK-3: trait -> {method -> [self-excluded param type annotations]} for signature conformance
    ti_trait_method_rtype: dict    // LOCK-3: trait -> {method -> return type annotation} for signature conformance
    ti_type_method_ptypes: dict    // LOCK-3: impl type -> {method -> [self-excluded param type annotations]}
    ti_type_method_rtype: dict     // LOCK-3: impl type -> {method -> return type annotation}
    ti_variant_ptypes: dict        // enum payload typing: variant name -> [ordered payload field type annotations] so match binders take the DECLARED type (not a fresh var)

// ── NType constructors ───────────────────────────────────────────────────────

fn nt_int() -> NType
    NType("int", "", [], 0)

fn nt_float() -> NType
    NType("float", "", [], 0)

fn nt_string() -> NType
    NType("string", "", [], 0)

fn nt_bool() -> NType
    NType("bool", "", [], 0)

fn nt_unit() -> NType
    NType("unit", "", [], 0)

fn nt_any() -> NType
    NType("any", "", [], 0)

fn nt_nothing() -> NType
    NType("nothing", "", [], 0)

fn nt_range() -> NType
    NType("list", "", [NType("int", "", [], 0)], 0)

fn nt_list(elem: NType) -> NType
    NType("list", "", [elem], 0)

fn nt_dict(k: NType, v: NType) -> NType
    NType("dict", "", [k, v], 0)

fn nt_tuple(elems: list) -> NType
    NType("tuple", "", elems, 0)

fn nt_channel(payload: NType) -> NType
    NType("channel", "", [payload], 0)

fn nt_fn(ps: list, ret: NType) -> NType
    NType("fn", "", ps + [ret], 0)

fn nt_struct(sname: string) -> NType
    NType("struct", sname, [], 0)

fn nt_var(vid: int) -> NType
    NType("var", "", [], vid)

fn nt_process(yt: NType) -> NType
    NType("process", "", [yt], 0)

fn nt_sum(ok: NType, err: NType) -> NType
    NType("sum", "", [ok, err], 0)

fn nt_get_kind(t: NType) -> string
    match t
        NType(k, n, p, i) =>
            return k
    return ""

// ── TiState: inference state ─────────────────────────────────────────────────

fn ti_new(source_lines: list) -> TiState
    ti_new_named(source_lines, "")

fn ti_new_named(source_lines: list, filename: string) -> TiState
    let stdlib = ti_build_stdlib()
    // TIER 1.2: STRICT is now the DEFAULT (sound path: per-drain budget + FAIL-CLOSED on exhaustion,
    // so the checker never silently stops checking). Unblocked by 1.0 (return-inference) — strict now
    // self-compiles the compiler with 0 errors. Opt OUT with NOVA_TI_STRICT=0 (the old fail-open path).
    let _ti_strict_env = env("NOVA_TI_STRICT")
    let _ti_strict = not (len(_ti_strict_env) > 0 and _ti_strict_env[0] == "0")
    TiState(1, {}, [], [], [{}], {}, {}, nt_unit(), "", stdlib, 0, false, _ti_strict, source_lines, {}, {}, {}, filename, {}, {}, {}, {}, {}, {}, [], {}, 0, {}, {}, {}, {}, [], {}, {}, {}, {}, false, [], {}, {}, {}, {}, {}, {})

fn ti_fresh(st: TiState) -> NType
    let vid = st.ti_next_id
    st.ti_next_id = vid + 1
    nt_var(vid)

fn ti_push_scope(st: TiState)
    push(st.ti_scope, {})

fn ti_pop_scope(st: TiState)
    if len(st.ti_scope) > 1
        let ns = []
        let i = 0
        while i < len(st.ti_scope) - 1
            push(ns, st.ti_scope[i])
            i = i + 1
        st.ti_scope = ns

fn ti_define(st: TiState, vname: string, scheme: NTypeScheme)
    let top = st.ti_scope[len(st.ti_scope) - 1]
    top[vname] = scheme

fn ti_mono(t: NType) -> NTypeScheme
    NTypeScheme([], t)

// ── Union-Find ───────────────────────────────────────────────────────────────

fn ti_walk_depth(st: TiState, t: NType, depth: int) -> NType
    if depth > 500
        return nt_any()
    match t
        NType(kind, name, params, id) =>
            if kind != "var"
                return t
            let key = str(id)
            if contains(st.ti_bindings, key)
                return ti_walk_depth(st, st.ti_bindings[key], depth + 1)
            return t
    t

fn ti_walk(st: TiState, t: NType) -> NType
    ti_walk_depth(st, t, 0)

fn ti_bind(st: TiState, vid: int, t: NType)
    st.ti_bindings[str(vid)] = t

fn ti_occurs(st: TiState, vid: int, t: NType) -> bool
    let w = ti_walk(st, t)
    match w
        NType(wk, wn, wp, wi) =>
            if wk == "var"
                return wi == vid
            for p in wp
                if ti_occurs(st, vid, p)
                    return true
    false

// ── Constraint & error management ────────────────────────────────────────────

fn ti_constrain(st: TiState, a: NType, b: NType, line: int)
    push(st.ti_constraints, NConstraint(a, b, line))

// TIER 1: return-position handling. A function WITH a concrete return annotation (is_open=false)
// is STRICT — a `-> int` that returns a string must error, so we add the normal constraint.
// An UN-annotated function (is_open=true) DEFERS: we COLLECT the return-expr type (which is often
// an unresolved type var at this point) and do the join later, in ti_ret_join_bind, AFTER the
// function's ti_solve has resolved those vars. (An earlier EAGER attempt bound ret_var to the first
// return here and skipped var-typed returns -> float fns mis-typed -> boxed garbage. Deferring fixes that.)
fn ti_ret_collect(st: TiState, retvar: NType, rt: NType, line: int, is_open: bool)
    if not is_open
        ti_constrain(st, retvar, rt, line)
        return
    push(st.ti_ret_seen, rt)

// TIER 1: after the open function's ti_solve, JOIN the now-resolved collected return types and
// bind ret_var once. First concrete kind seen wins; a second DIFFERENT concrete kind widens to
// `any` (genuinely heterogeneous returns are legal — NOVA's zero-annotation, first-class `any`
// thesis). any/var/unit/nothing are absorbed (an early `return 0` in an otherwise-unit procedure
// keeps its inferred type; a dynamic/boxed path doesn't force widening). When all concrete returns
// AGREE the concrete type is preserved (no perf/typing loss). Only binds if ret_var is still an
// unbound var (a recursion/annotation may have already resolved it — leave that alone).
// Returns true iff the return type was widened to `any` because the returns GENUINELY DISAGREE
// (heterogeneous) — the caller records that so the IR frt fixpoint won't refine it back.
fn ti_ret_join_bind(st: TiState, retvar: NType, seen: list, line: int) -> bool
    let wret = ti_walk(st, retvar)
    match wret
        NType(wk, wn, wp, wid) =>
            if wk != "var"
                return false
            // int/float/bool are mutually-coercible numerics (mirror the IR join + ti_unify's
            // numeric rule): a fn returning float in one branch and int in another is FLOAT, not
            // `any`. Non-numeric concrete kinds must match; numeric+non-numeric or two different
            // non-numerics -> `any`.
            let has_float = false
            let has_int = false
            let has_fn = false
            let has_any = false             // a return is genuinely `any` (e.g. a list element / dynamic
                                            // value) -> the whole return is `any` (DOMINANT). Distinct
                                            // from unit/nothing/var (no-value/unresolved = absorbed).
            let chosen_fn = nt_any()        // a function return is CALLABLE; `return f ... 0` is the
                                            // `fn OR null` idiom (NOVA has no null for fns) -> keep the
                                            // fn type, treat int/float as null-ish. Distinct from mixed
                                            // DATA returns (int+str) which are genuinely heterogeneous.
            let nonnum = ""
            let chosen_nonnum = nt_any()    // preserve the full first non-numeric NType (keeps list<T> etc.)
            let nonnum_conflict = false
            for t in seen
                let wt = ti_walk(st, t)
                match wt
                    NType(tk, tn, tp, tid) =>
                        if tk == "float"
                            has_float = true
                        else if tk == "int" or tk == "bool"
                            has_int = true
                        else if tk == "fn"
                            has_fn = true
                            chosen_fn = wt
                        else if tk == "any"
                            has_any = true
                        else if tk != "var" and tk != "unit" and tk != "nothing"
                            if nonnum == ""
                                nonnum = tk
                                chosen_nonnum = wt
                            else if nonnum != tk
                                nonnum_conflict = true
            let has_num = has_float or has_int
            // A genuinely-`any` return (dynamic value) makes the whole result `any` — it dominates a
            // concrete fallback (e.g. `return list_elem ... 0`: the fn stays callable/dynamic, not int).
            if has_any
                ti_bind(st, wid, nt_any())
                return false
            if nonnum_conflict
                ti_bind(st, wid, nt_any())
                return true
            if has_fn
                // fn + another non-numeric DATA kind (list/str/...) is genuinely mixed -> any.
                // fn + int/float (null-ish) keeps the callable fn type.
                if nonnum != ""
                    ti_bind(st, wid, nt_any())
                    return true
                ti_bind(st, wid, chosen_fn)
                return false
            if nonnum != "" and has_num
                ti_bind(st, wid, nt_any())
                return true
            if nonnum != ""
                ti_bind(st, wid, chosen_nonnum)
                return false
            if has_float
                ti_bind(st, wid, nt_float())
                return false
            if has_int
                ti_bind(st, wid, nt_int())
                return false
            ti_bind(st, wid, nt_any())
            return false
    false

fn ti_error_full(st: TiState, code: string, msg: string, line: int, help: string)
    let out = ""
    let in_fn = ""
    if st.ti_in_fn != ""
        in_fn = " (in function '" + st.ti_in_fn + "')"
    let header_code = code
    if header_code == ""
        header_code = "E1000"
    out = out + "error[" + header_code + "]: " + msg + in_fn + "\n"
    let file_loc = st.ti_filename
    if file_loc == ""
        file_loc = "<source>"
    out = out + "  --> " + file_loc + ":" + str(line) + "\n"
    if line > 0 and len(st.ti_source_lines) >= line
        let src = st.ti_source_lines[line - 1]
        let lnum = str(line)
        let pad = ""
        let pi = 0
        while pi < len(lnum)
            pad = pad + " "
            pi = pi + 1
        out = out + " " + pad + " |\n"
        out = out + " " + lnum + " | " + src + "\n"
        out = out + " " + pad + " |\n"
    if help != ""
        out = out + "  = help: " + help + "\n"
    push(st.ti_errors, out)

fn ti_error(st: TiState, msg: string, line: int)
    let code = "E1000"
    let help = ""
    if starts_with(msg, "unknown identifier")
        code = "E1002"
        if contains(msg, "did you mean")
            help = "check the spelling, or import a module that defines this name"
        else
            help = "this name is not defined; declare it with `let`, `fn`, or import it"
    else if starts_with(msg, "function expects")
        code = "E1003"
        help = "check the function signature and supply the correct number of arguments"
    else if starts_with(msg, "type mismatch")
        code = "E1001"
        if contains(msg, "found string") or contains(msg, "expected string")
            help = "use str() to convert to string, or int()/float() to convert from string"
        else if contains(msg, "found int") and contains(msg, "expected float")
            help = "int and float are auto-coerced in NOVA; this may be a container type mismatch"
        else if contains(msg, "List<") or contains(msg, "Dict<")
            help = "container element types must match; check that both sides use the same element type"
        else
            help = "these types are incompatible; check that both sides of the expression have the same type"
    else if contains(msg, "does not fully implement trait")
        code = "E1006"
        help = "add the missing method(s) as TypeName__method_name functions"
    else if contains(msg, "incompatible method signature")
        code = "E1006"
        help = "the impl's parameter/return types must match the trait's declared signature (dynamic dispatch relies on it)"
    else if contains(msg, "wrong method arity")
        code = "E1006"
        help = "the impl must take the same number of arguments as the trait method declares"
    else if contains(msg, "unknown trait")
        code = "E1007"
        help = "declare the trait with `trait Name` before implementing it"
    else if starts_with(msg, "cannot iterate")
        code = "E1008"
        help = "for-loops work with list, dict, string, and range values"
    else if starts_with(msg, "non-exhaustive match")
        code = "E1009"
        help = "add the missing variant(s) to your match expression, or add a wildcard `_ =>` arm"
    else if contains(msg, "has no field")
        code = "E1010"
        help = "check the struct definition for available fields"
    else if contains(msg, "is not indexable")
        code = "E1011"
        help = "only list, dict, and string support [] indexing"
    else if contains(msg, "duplicate function")
        code = "E1012"
        help = "rename one of the functions, or remove the duplicate"
    ti_error_full(st, code, msg, line, help)

// ── Type display ─────────────────────────────────────────────────────────────

fn ti_type_str(t: NType) -> string
    match t
        NType(kind, name, params, id) =>
            if kind == "var"
                return "?T" + str(id)
            if kind == "list" and len(params) > 0
                return "List<" + ti_type_str(params[0]) + ">"
            if kind == "dict" and len(params) >= 2
                return "Dict<" + ti_type_str(params[0]) + ", " + ti_type_str(params[1]) + ">"
            if kind == "fn" and len(params) > 0
                let ret = params[len(params) - 1]
                let ps = []
                let i = 0
                while i < len(params) - 1
                    push(ps, ti_type_str(params[i]))
                    i = i + 1
                return "(" + join(ps, ", ") + ") -> " + ti_type_str(ret)
            if kind == "channel" and len(params) > 0
                return "Channel<" + ti_type_str(params[0]) + ">"
            if kind == "struct"
                return name
            if kind == "sum" and len(params) >= 2
                return ti_type_str(params[0]) + " | " + ti_type_str(params[1])
            if kind == "tuple"
                let ps = []
                for p in params
                    push(ps, ti_type_str(p))
                return "(" + join(ps, ", ") + ")"
            if kind == "process" and len(params) > 0
                return "Process<" + ti_type_str(params[0]) + ">"
            return kind
    "any"

// ── Instantiation ────────────────────────────────────────────────────────────

fn ti_instantiate(st: TiState, scheme: NTypeScheme) -> NType
    match scheme
        NTypeScheme(q, b) =>
            let b2 = ti_zonk(st, b)
            if len(q) == 0
                return b2
            let subst = {}
            let qi = 0
            while qi < len(q)
                let qw = ti_walk(st, nt_var(q[qi]))
                match qw
                    NType(qwk, qwn, qwp, qwi) =>
                        if qwk == "var"
                            subst[str(qwi)] = ti_fresh(st)
                qi = qi + 1
            return ti_subst(b2, subst)
    nt_any()

fn ti_subst(t: NType, subst: dict) -> NType
    match t
        NType(kind, name, params, id) =>
            if kind == "var"
                let key = str(id)
                if contains(subst, key)
                    return subst[key]
                return t
            if len(params) == 0
                return t
            let np = []
            for p in params
                push(np, ti_subst(p, subst))
            return NType(kind, name, np, id)
    t

// ── Generalization ───────────────────────────────────────────────────────────

fn ti_collect_fv(st: TiState, t: NType, out: list, seen: dict)
    let w = ti_walk(st, t)
    match w
        NType(wk, wn, wp, wi) =>
            if wk == "var"
                let key = str(wi)
                if not contains(seen, key)
                    seen[key] = 1
                    push(out, wi)
                return
            for p in wp
                ti_collect_fv(st, p, out, seen)

fn ti_scope_fv(st: TiState) -> dict
    let ids = {}
    for frame in st.ti_scope
        for k in keys(frame)
            let scheme = frame[k]
            match scheme
                NTypeScheme(sq, sb) =>
                    let fv = []
                    ti_collect_fv(st, sb, fv, {})
                    for vid in fv
                        ids[str(vid)] = 1
    ids

fn ti_generalize(st: TiState, t: NType) -> NTypeScheme
    let sfv = ti_scope_fv(st)
    let tfv = []
    ti_collect_fv(st, t, tfv, {})
    let quantified = []
    for vid in tfv
        if not contains(sfv, str(vid))
            push(quantified, vid)
    NTypeScheme(quantified, t)

// ── Apply (resolve all type vars to concrete types) ──────────────────────────

fn ti_apply(st: TiState, t: NType) -> NType
    let w = ti_walk(st, t)
    match w
        NType(wk, wn, wp, wi) =>
            if wk == "var"
                return nt_any()
            if len(wp) == 0
                return w
            let np = []
            for p in wp
                push(np, ti_apply(st, p))
            return NType(wk, wn, np, wi)
    nt_any()

// ── Zonk (resolve bindings, keep unbound vars as vars) ───────────────────────

fn ti_zonk(st: TiState, t: NType) -> NType
    let w = ti_walk(st, t)
    match w
        NType(wk, wn, wp, wi) =>
            if wk == "var"
                return w
            if len(wp) == 0
                return w
            let np = []
            for p in wp
                push(np, ti_zonk(st, p))
            return NType(wk, wn, np, wi)
    nt_any()

// ── Unification ──────────────────────────────────────────────────────────────

fn ti_unify_d(st: TiState, a: NType, b: NType, line: int, depth: int)
    st.ti_unify_count = st.ti_unify_count + 1
    // TIER 1.2: STRICT is now the DEFAULT. The per-ti_solve-drain budget reset lives in ti_solve
    // (1.1, applied in BOTH modes); here STRICT raises the per-drain cap to 1,000,000 and makes
    // exhaustion FAIL-CLOSED (a type error, not a silent-accept), while the depth bound stays silent
    // (deep type = incompleteness, not a mismatch). Opt OUT with NOVA_TI_STRICT=0 (historical
    // fail-open path: global-accumulate, silent-skip). The old "IrInst arity 2-vs-8" note was STALE —
    // 1.0 (return-inference) removed those false-rejections; strict self-compiles the compiler 0-error.
    if st.ti_strict
        if depth > 50
            return
        if st.ti_unify_count > 1000000
            if not st.ti_budget_reported
                st.ti_budget_reported = true
                ti_error(st, "type inference budget exhausted: this declaration is too large or too deeply constrained to fully type-check", line)
            return
    else
        if depth > 50 or st.ti_unify_count > 5000
            return
    let wa = ti_walk(st, a)
    let wb = ti_walk(st, b)
    match wa
        NType(wak, wan, wap, wai) =>
            match wb
                NType(wbk, wbn, wbp, wbi) =>
                    if wak == wbk
                        if wak == "int" or wak == "float" or wak == "string" or wak == "bool" or wak == "unit" or wak == "nothing" or wak == "any" or wak == "range"
                            return
                        if wak == "var"
                            if wai == wbi
                                return
                            ti_bind(st, wai, wb)
                            return
                        if wak == "struct"
                            if wan == wbn
                                return
                            ti_error(st, "type mismatch: expected " + ti_type_str(wa) + ", found " + ti_type_str(wb), line)
                            return
                        if wak == "list" or wak == "dict" or wak == "tuple" or wak == "channel" or wak == "fn" or wak == "sum" or wak == "process"
                            if len(wap) == len(wbp)
                                let i = 0
                                while i < len(wap)
                                    ti_unify_d(st, wap[i], wbp[i], line, depth + 1)
                                    i = i + 1
                                return
                            if wak == "fn"
                                ti_error(st, "function expects " + str(len(wap) - 1) + " arguments, but got " + str(len(wbp) - 1) + ": expected " + ti_type_str(wa) + ", found " + ti_type_str(wb), line)
                            else
                                ti_error(st, "type mismatch: expected " + ti_type_str(wa) + ", found " + ti_type_str(wb), line)
                            return
                    if wak == "var"
                        if ti_occurs(st, wai, wb)
                            // TIER 1.3: occurs-check failure = a genuinely INFINITE type (a value that
                            // would contain itself, e.g. `let x = [x]`). Was silently skipped (var left
                            // unbound -> degraded to `any`); now diagnosed. Nominal recursive structs
                            // (`type Node ... next: Node`) don't create var-cycles, so they're unaffected.
                            ti_error(st, "recursive type: this expression would have an infinite type (a value cannot contain itself)", line)
                            return
                        ti_bind(st, wai, wb)
                        return
                    if wbk == "var"
                        if ti_occurs(st, wbi, wa)
                            ti_error(st, "recursive type: this expression would have an infinite type (a value cannot contain itself)", line)
                            return
                        ti_bind(st, wbi, wa)
                        return
                    if wak == "nothing" or wbk == "nothing"
                        return
                    if wak == "any" or wbk == "any"
                        return
                    // int / float / bool are all mutually compatible in NOVA
                    // (numeric coercion + C-style truthiness).
                    let a_num = wak == "int" or wak == "float" or wak == "bool"
                    let b_num = wbk == "int" or wbk == "float" or wbk == "bool"
                    if a_num and b_num
                        return
                    // Catch-all: any remaining kind disagreement is a genuine
                    // type error. Without this, incompatible types unified
                    // silently and the type checker caught nothing.
                    ti_error(st, "type mismatch: expected " + ti_type_str(wa) + ", found " + ti_type_str(wb), line)

fn ti_unify(st: TiState, a: NType, b: NType, line: int)
    ti_unify_d(st, a, b, line, 0)

// Tolerant arm-vs-arm unification for match expressions / branches.
// Only enforces equality when BOTH sides are concrete, non-any, non-unit,
// non-nothing. This catches arms that disagree on a real type (e.g. one arm
// returns string, another returns int) while letting control-flow arms
// (one prints, one returns a value — different "value-ness") pass through.
fn ti_unify_arms(st: TiState, a: NType, b: NType, line: int)
    let wa = ti_walk(st, a)
    let wb = ti_walk(st, b)
    let a_ok = false
    let b_ok = false
    match wa
        NType(wak, wan, wap, wai) =>
            if wak != "any" and wak != "var" and wak != "unit" and wak != "nothing"
                a_ok = true
    match wb
        NType(wbk, wbn, wbp, wbi) =>
            if wbk != "any" and wbk != "var" and wbk != "unit" and wbk != "nothing"
                b_ok = true
    if a_ok and b_ok
        ti_constrain(st, a, b, line)

fn ti_solve(st: TiState)
    // TIER 1.1: per-drain budget reset in BOTH modes. ti_solve is the unit at which constraints are
    // batch-resolved (it clears ti_constraints below), so the budget must be fresh here — otherwise
    // it accumulates across the whole compile and STARVES later declarations, silently skipping their
    // mismatch checks (the fail-open soundness hole: the compiler's own 9,664-unification self-compile
    // left its later code unchecked under the old global 5,000 cap). Now each declaration gets its own
    // ~5,000-unification budget (default: still silent-skip past it; strict: fail-closed at 1M). This
    // was previously gated to strict-only to keep DEFAULT byte-identical; the return-inference fix
    // (1.0) removed the false-rejections that resetting used to surface, so it is now safe by default.
    st.ti_unify_count = 0
    if st.ti_strict
        st.ti_budget_reported = false
    let total = len(st.ti_constraints)
    let i = 0
    while i < total
        let c = st.ti_constraints[i]
        match c
            NConstraint(ca, cb, cline) =>
                ti_unify(st, ca, cb, cline)
        i = i + 1
    st.ti_constraints = []

// ── Stdlib type registry ─────────────────────────────────────────────────────

fn ti_build_stdlib() -> dict
    let reg = {}
    let T = nt_var(-1)
    let U = nt_var(-2)
    reg["print"] = NTypeScheme([-1], nt_fn([T], nt_unit()))
    reg["copy"] = NTypeScheme([-1], nt_fn([T], T))
    reg["input"] = NTypeScheme([], nt_fn([], nt_string()))
    reg["read_line"] = NTypeScheme([], nt_fn([], nt_string()))
    reg["read_file"] = NTypeScheme([], nt_fn([nt_string()], nt_string()))
    reg["write_file"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_unit()))
    reg["remove_file"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["remove_dir"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["rename_path"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_int()))
    reg["copy_file"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_int()))
    reg["file_size"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["file_mtime"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["is_dir"] = NTypeScheme([], nt_fn([nt_string()], nt_bool()))
    reg["make_dir"] = NTypeScheme([], nt_fn([nt_string()], nt_bool()))
    reg["file_chmod"] = NTypeScheme([], nt_fn([nt_string(), nt_int()], nt_bool()))
    reg["is_file"] = NTypeScheme([], nt_fn([nt_string()], nt_bool()))
    reg["write_bytes"] = NTypeScheme([], nt_fn([nt_string(), nt_any()], nt_int()))
    reg["read_lines"] = NTypeScheme([], nt_fn([nt_string()], nt_list(nt_string())))
    reg["file_open"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_int()))
    reg["file_read_line"] = NTypeScheme([], nt_fn([nt_int()], nt_string()))
    reg["file_read_bytes"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_any()))
    reg["file_write"] = NTypeScheme([], nt_fn([nt_int(), nt_string()], nt_int()))
    reg["file_eof"] = NTypeScheme([], nt_fn([nt_int()], nt_bool()))
    reg["file_seek"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_int()))
    reg["file_tell"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["file_flush"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["file_close"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["temp_dir"] = NTypeScheme([], nt_fn([], nt_string()))
    reg["str"] = NTypeScheme([-1], nt_fn([T], nt_string()))
    reg["int"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["float"] = NTypeScheme([-1], nt_fn([T], nt_float()))
    reg["bool"] = NTypeScheme([-1], nt_fn([T], nt_bool()))
    reg["type_of"] = NTypeScheme([-1], nt_fn([T], nt_string()))
    reg["type"] = NTypeScheme([-1], nt_fn([T], nt_string()))
    reg["fields"] = NTypeScheme([-1], nt_fn([T], nt_list(nt_string())))
    reg["field_types"] = NTypeScheme([-1], nt_fn([T], nt_list(nt_string())))
    reg["field_names"] = NTypeScheme([-1], nt_fn([T], nt_list(nt_string())))
    reg["type_name"] = NTypeScheme([-1], nt_fn([T], nt_string()))
    reg["field_get"] = NTypeScheme([-1], nt_fn([T, nt_string()], nt_any()))
    reg["cfg"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_int()))
    reg["is_int"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["is_float"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["is_string"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["is_list"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["is_dict"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["is_bool"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["is_struct"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["is_numeric"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["len"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["range"] = NTypeScheme([], nt_fn([nt_int()], nt_list(nt_int())))
    reg["push"] = NTypeScheme([-1], nt_fn([nt_list(T), T], nt_unit()))
    reg["pop"] = NTypeScheme([-1], nt_fn([nt_list(T)], T))                          // remove + return the last element
    reg["insert"] = NTypeScheme([-1], nt_fn([nt_list(T), nt_int(), T], nt_unit()))  // insert v at index i, shifting right
    reg["remove"] = NTypeScheme([-1], nt_fn([nt_list(T), T], nt_int()))             // delete first element == v; 1 if removed else 0
    reg["get"] = NTypeScheme([-1, -2], nt_fn([nt_dict(T, U), T, U], U))             // dict value for key, or the default if absent
    reg["keys"] = NTypeScheme([-1, -2], nt_fn([nt_dict(T, U)], nt_list(T)))
    reg["values"] = NTypeScheme([-1, -2], nt_fn([nt_dict(T, U)], nt_list(U)))
    reg["items"] = NTypeScheme([-1, -2], nt_fn([nt_dict(T, U)], nt_list(nt_list(nt_any()))))
    reg["__destr_iter"] = NTypeScheme([-1], nt_fn([T], nt_list(nt_any())))
    reg["sort"] = NTypeScheme([-1], nt_fn([nt_list(T)], nt_list(T)))
    reg["contains"] = NTypeScheme([-1, -2], nt_fn([T, U], nt_bool()))
    reg["del"] = NTypeScheme([-1, -2], nt_fn([nt_dict(T, U), T], nt_unit()))
    reg["map"] = NTypeScheme([-1, -2], nt_fn([nt_list(T), nt_fn([T], U)], nt_list(U)))
    reg["filter"] = NTypeScheme([-1], nt_fn([nt_list(T), nt_fn([T], nt_bool())], nt_list(T)))
    reg["split"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_list(nt_string())))
    reg["join"] = NTypeScheme([], nt_fn([nt_list(nt_string()), nt_string()], nt_string()))
    reg["splitlines"] = NTypeScheme([], nt_fn([nt_string()], nt_list(nt_string())))                  // split on \n, strip \r (CRLF), no trailing empty
    reg["partition"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_list(nt_string())))       // [before, sep, after] at first sep
    reg["rpartition"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_list(nt_string())))      // [before, sep, after] at last sep
    reg["rsplit"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_list(nt_string())))          // split (from the right; == split with no maxsplit)
    reg["trim"] = NTypeScheme([], nt_fn([nt_string()], nt_string()))
    reg["upper"] = NTypeScheme([], nt_fn([nt_string()], nt_string()))
    reg["lower"] = NTypeScheme([], nt_fn([nt_string()], nt_string()))
    reg["normalize_nfc"] = NTypeScheme([], nt_fn([nt_string()], nt_string()))
    reg["normalize_nfd"] = NTypeScheme([], nt_fn([nt_string()], nt_string()))
    reg["replace"] = NTypeScheme([], nt_fn([nt_string(), nt_string(), nt_string()], nt_string()))
    reg["starts_with"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_bool()))
    reg["ends_with"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_bool()))
    reg["slice"] = NTypeScheme([], nt_fn([nt_string(), nt_int(), nt_int()], nt_string()))
    reg["find"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_int()))
    reg["repeat"] = NTypeScheme([], nt_fn([nt_string(), nt_int()], nt_string()))
    reg["chars"] = NTypeScheme([], nt_fn([nt_string()], nt_list(nt_string())))
    reg["args"] = NTypeScheme([], nt_fn([], nt_list(nt_string())))
    reg["abs"] = NTypeScheme([-1], nt_fn([T], T))
    reg["max"] = NTypeScheme([-1], nt_fn([T, T], T))
    reg["min"] = NTypeScheme([-1], nt_fn([T, T], T))
    reg["sqrt"] = NTypeScheme([], nt_fn([nt_float()], nt_float()))
    reg["pow"] = NTypeScheme([], nt_fn([nt_float(), nt_float()], nt_float()))
    reg["round"] = NTypeScheme([], nt_fn([nt_float()], nt_int()))
    reg["floor"] = NTypeScheme([], nt_fn([nt_float()], nt_int()))
    reg["ceil"] = NTypeScheme([], nt_fn([nt_float()], nt_int()))
    ti_build_stdlib_ext(reg)
    return reg

fn ti_build_stdlib_ext(reg: dict)
    let T = nt_var(-1)
    let U = nt_var(-2)
    let f1 = NTypeScheme([], nt_fn([nt_float()], nt_float()))
    let f2 = NTypeScheme([], nt_fn([nt_float(), nt_float()], nt_float()))
    reg["sin"] = f1
    reg["cos"] = f1
    reg["tan"] = f1
    reg["asin"] = f1
    reg["acos"] = f1
    reg["atan"] = f1
    reg["atan2"] = f2
    reg["exp"] = f1
    reg["log"] = f1
    reg["log2"] = f1
    reg["log10"] = f1
    reg["sinh"] = f1
    reg["cosh"] = f1
    reg["tanh"] = f1
    reg["cbrt"] = f1
    reg["hypot"] = f2
    reg["fmod"] = f2
    reg["isnan"] = NTypeScheme([], nt_fn([nt_float()], nt_bool()))
    reg["isinf"] = NTypeScheme([], nt_fn([nt_float()], nt_bool()))
    reg["clamp"] = NTypeScheme([], nt_fn([nt_float(), nt_float(), nt_float()], nt_float()))
    reg["copysign"] = f2
    reg["fma"] = NTypeScheme([], nt_fn([nt_float(), nt_float(), nt_float()], nt_float()))
    reg["nextafter"] = f2
    reg["lgamma"] = f1
    reg["erf"] = f1
    reg["rng_new"] = NTypeScheme([], nt_fn([nt_int()], nt_any()))
    reg["rng_next"] = NTypeScheme([], nt_fn([nt_any()], nt_int()))
    reg["rng_int"] = NTypeScheme([], nt_fn([nt_any(), nt_int()], nt_int()))
    reg["rng_float"] = NTypeScheme([], nt_fn([nt_any()], nt_float()))
    reg["pi"] = NTypeScheme([], nt_fn([], nt_float()))
    reg["e"] = NTypeScheme([], nt_fn([], nt_float()))
    reg["gcd"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_int()))
    reg["lcm"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_int()))
    reg["popcount"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["clz"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["ctz"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["rotl"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_int()))
    reg["rotr"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_int()))
    reg["htons"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["ntohs"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["htonl"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["ntohl"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["char_count"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["char_at"] = NTypeScheme([], nt_fn([nt_string(), nt_int()], nt_string()))
    reg["code_points"] = NTypeScheme([], nt_fn([nt_string()], nt_list(nt_int())))
    reg["from_codepoint"] = NTypeScheme([], nt_fn([nt_int()], nt_string()))
    reg["is_valid_utf8"] = NTypeScheme([], nt_fn([nt_string()], nt_bool()))
    reg["channel"] = NTypeScheme([-1], nt_fn([], nt_channel(T)))
    reg["channel_bounded"] = NTypeScheme([-1], nt_fn([nt_int()], nt_channel(T)))
    reg["send"] = NTypeScheme([-1], nt_fn([nt_channel(T), T], nt_unit()))
    reg["receive"] = NTypeScheme([-1], nt_fn([nt_channel(T)], T))
    reg["recv"] = NTypeScheme([-1], nt_fn([nt_channel(T)], T))
    reg["try_recv"] = NTypeScheme([-1], nt_fn([nt_channel(T)], nt_any()))            // non-blocking recv -> [got, value] (got=1/0)
    reg["try_send"] = NTypeScheme([-1], nt_fn([nt_channel(T), T], nt_int()))         // non-blocking send -> 1 if sent, 0 if full/closed
    reg["cpu_count"] = NTypeScheme([], nt_fn([], nt_int()))
    reg["ord"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["chr"] = NTypeScheme([], nt_fn([nt_int()], nt_string()))
    reg["is_space"] = NTypeScheme([], nt_fn([nt_string()], nt_bool()))             // char-class: first char is whitespace
    reg["is_upper"] = NTypeScheme([], nt_fn([nt_string()], nt_bool()))             // first char is A-Z
    reg["is_lower"] = NTypeScheme([], nt_fn([nt_string()], nt_bool()))             // first char is a-z
    reg["is_digit"] = NTypeScheme([], nt_fn([nt_string()], nt_bool()))             // first char is 0-9 (user fn shadows)
    reg["is_alpha"] = NTypeScheme([], nt_fn([nt_string()], nt_bool()))             // first char is a letter (user fn shadows)
    reg["is_alnum"] = NTypeScheme([], nt_fn([nt_string()], nt_bool()))             // first char is letter/digit (user fn shadows)
    reg["ushr"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_int()))           // logical (unsigned) right shift -- `>>` is arithmetic
    reg["udiv"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_int()))           // unsigned divide (div0 -> 0)
    reg["urem"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_int()))           // unsigned remainder (div0 -> 0)
    reg["ult"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_bool()))           // unsigned less-than
    reg["ugt"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_bool()))           // unsigned greater-than
    reg["ule"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_bool()))           // unsigned less-or-equal
    reg["uge"] = NTypeScheme([], nt_fn([nt_int(), nt_int()], nt_bool()))           // unsigned greater-or-equal
    reg["time_ms"] = NTypeScheme([], nt_fn([], nt_int()))
    reg["clock_ns"] = NTypeScheme([], nt_fn([], nt_int()))
    reg["sleep"] = NTypeScheme([], nt_fn([nt_int()], nt_unit()))
    reg["exit"] = NTypeScheme([], nt_fn([nt_int()], nt_nothing()))
    reg["assert"] = NTypeScheme([], nt_fn([nt_bool(), nt_string()], nt_unit()))
    reg["system"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["exec"] = NTypeScheme([], nt_fn([nt_string()], nt_string()))
    reg["proc_open"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["proc_write_stdin"] = NTypeScheme([], nt_fn([nt_int(), nt_string()], nt_int()))
    reg["proc_read_stdout"] = NTypeScheme([], nt_fn([nt_int()], nt_string()))
    reg["proc_close_stdin"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["proc_wait"] = NTypeScheme([], nt_fn([nt_int()], nt_int()))
    reg["json_parse"] = NTypeScheme([-1], nt_fn([nt_string()], T))
    reg["json_stringify"] = NTypeScheme([-1], nt_fn([T], nt_string()))
    reg["append_file"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_unit()))
    reg["file_exists"] = NTypeScheme([], nt_fn([nt_string()], nt_bool()))
    reg["memo_cache"] = NTypeScheme([], nt_fn([nt_string()], nt_any()))
    reg["memo_lock"] = NTypeScheme([], nt_fn([], nt_int()))
    reg["memo_unlock"] = NTypeScheme([], nt_fn([], nt_int()))
    reg["http_get"] = NTypeScheme([], nt_fn([nt_string()], nt_string()))
    reg["http_post"] = NTypeScheme([], nt_fn([nt_string(), nt_string(), nt_string()], nt_string()))
    reg["mkdir"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["mkdir_p"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["path_join"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_string()))
    reg["path_exists"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["path_parent"] = NTypeScheme([], nt_fn([nt_string()], nt_string()))
    reg["path_name"] = NTypeScheme([], nt_fn([nt_string()], nt_string()))
    reg["serialize"] = NTypeScheme([-1], nt_fn([T], nt_any()))
    reg["deserialize"] = NTypeScheme([-1], nt_fn([nt_any()], T))
    // from_json(d): generic decoder; the result type comes from the let annotation
    // (`let p: T = from_json(d)`), and codegen dispatches to the derived <T>__from_json.
