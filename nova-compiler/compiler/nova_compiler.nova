    ire_line(e, "")

    // FFI: emit declares for extern functions, with synthesized i64-calling-
    // convention wrappers when the C signature uses non-i64 types. NOVA's
    // internal calling convention is i64-everywhere; the wrappers bridge to
    // each C function's real signature using LLVM bitcast / inttoptr.
    if len(b.ir_externs) > 0
        ire_line(e, "; Extern (FFI) declarations")
        // Emit LINK_LIB comments for any @link("libname") annotations on extern
        // declarations. The build script greps these and adds -l<libname> to
        // clang. Dedupe so the same lib only appears once.
        let seen_libs = {}
        let seen_src = {}
        let seen_obj = {}
        for ext_stmt in b.ir_externs
            match ext_stmt
                Stmt(elt, eln, elexpr, elbody, elparams, eleselse, elann, elsline) =>
                    for ea in elann
                        match ea
                            Expr(eat, eav, ean2, eac, eaf, eal) =>
                                if eat == "ann_with_arg" and len(eac) > 0
                                    match eac[0]
                                        Expr(satg, sav, san2, sac, saf, sal) =>
                                            // @link("m") -> -lm ; @link_source("foo.c") -> compile+link foo.c
                                            // on demand ; @link_object("foo.o") -> link a prebuilt object.
                                            // nova_link consumes these markers. Dedupe each kind.
                                            if satg == "str" and eav == "link" and not contains(seen_libs, sav)
                                                seen_libs[sav] = 1
                                                ire_line(e, "; LINK_LIB: " + sav)
                                            else if satg == "str" and eav == "link_source" and not contains(seen_src, sav)
                                                seen_src[sav] = 1
                                                ire_line(e, "; LINK_SOURCE: " + sav)
                                            else if satg == "str" and eav == "link_object" and not contains(seen_obj, sav)
                                                seen_obj[sav] = 1
                                                ire_line(e, "; LINK_OBJECT: " + sav)
        for ext_stmt in b.ir_externs
            match ext_stmt
                Stmt(et, en, eexpr, ebody, eparams, eelse, eann, esline) =>
                    let real_ret = "i64"
                    let ret_struct = ""
                    let ret_cls = ""
                    match eexpr
                        Expr(rxt, rxv, rxn, rxc, rxf, rxl) =>
                            if rxt == "rettype"
                                real_ret = ffi_llvm_type(rxv)
                                let _rbv = _abi_byval_type(rxv)
                                if _rbv != ""
                                    // LOCK-11: RETURN the struct BY VALUE, lowered for this target.
                                    let _rcls = _abi_struct_ret_type(b, _rbv, e.ire_target)
                                    if _rcls == ""
                                        ire_line(e, "; LOCK-11: cannot classify byval return " + _rbv)
                                        real_ret = "ptr"
                                    else
                                        ret_struct = _rbv
                                        ret_cls = _rcls
                                        if _rcls == "sret"
                                            real_ret = "void"
                                        else
                                            real_ret = _rcls
                                else if contains(b.ir_opaque_types, rxv) or contains(b.ir_repr_c_types, rxv)
                                    real_ret = "ptr"
                    let real_arg_types = []
                    let real_arg_structs = []
                    for p in eparams
                        match p
                            Param(pn, pt, pd) =>
                                let pll = ffi_llvm_type(pt)
                                let pstruct = ""
                                let _bvt = _abi_byval_type(pt)
                                if _bvt != ""
                                    // LOCK-11: pass this @repr(C) struct BY VALUE, lowered for
                                    // THIS target. Handing it over as a pointer instead is right
                                    // only by accident on Win64 (>8-byte structs really are passed
                                    // by reference) and silently wrong on SysV and AAPCS64.
                                    let _abil = _abi_struct_param_types(b, _bvt, e.ire_target)
                                    if _abil == ""
                                        ire_line(e, "; LOCK-11: cannot classify byval type " + _bvt + " for " + e.ire_target)
                                        pll = "ptr"
                                    else if _abil == "byval"
                                        pll = "ptr byval(" + _abi_struct_llty(b, _bvt) + ") align 8"
                                        pstruct = _bvt
                                    else if _abil == "copyptr"
                                        pll = "ptr"
                                        pstruct = _bvt
                                    else
                                        pll = _abil
                                        pstruct = _bvt
                                else if contains(b.ir_opaque_types, pt) or contains(b.ir_repr_c_types, pt)
                                    // UNCHANGED contract: a plain @repr(C) (or @opaque) parameter
                                    // passes the heap data pointer, so C can read AND write the
                                    // NOVA struct in place.
                                    pll = "ptr"
                                push(real_arg_types, pll)
                                push(real_arg_structs, pstruct)
                    let needs_wrapper = real_ret != "i64"
                    let ai = 0
                    while ai < len(real_arg_types) and not needs_wrapper
                        if real_arg_types[ai] != "i64"
                            needs_wrapper = true
                        ai = ai + 1
                    // A by-value RETURN always needs the wrapper too, and the `real_ret != "i64"`
                    // test above does NOT catch it: on Win64 a <=8-byte struct comes back as a
                    // bare i64. The wrapper is what allocates the NOVA struct the raw result is
                    // materialised into, so without this the call site referenced an undefined
                    // nova_ffi_ symbol.
                    if ret_struct != ""
                        needs_wrapper = true
                    // LOCK-11: a by-value @repr(C) struct ALWAYS needs the wrapper, even when its
                    // lowered form happens to be a bare i64 (a one-int-field struct on Win64).
                    // NOVA holds the struct as a HANDLE; the wrapper is what loads the field out
                    // of it. Without this the call site emitted nova_ffi_<name> while no wrapper
                    // was defined -- "use of undefined value" at link time.
                    let asx = 0
                    while asx < len(real_arg_structs) and not needs_wrapper
                        if real_arg_structs[asx] != ""
                            needs_wrapper = true
                        asx = asx + 1

                    // Emit the raw C function declare with native types.
                    // Skip if a runtime auto-declare already covers this name
                    // (puts/printf/strcmp/nova_rt_*) — LLVM rejects duplicate
                    // declares with conflicting signatures.
                    let already_declared = en == "puts" or en == "printf" or en == "strcmp"
                    // The comment above always CLAIMED nova_rt_* was covered here, but the check
                    // never existed -- so `extern fn nova_rt_sched_slot_count()` (in _mn_churn)
                    // emitted a SECOND declare of a symbol the runtime preamble already declares,
                    // and LLVM rejects the whole module: "invalid redefinition of function".
                    // Dedupe against what THIS module actually emitted rather than a hardcoded
                    // name list, so any extern that shadows a runtime symbol is handled, not just
                    // the three that happened to be known.
                    if not already_declared
                        let _dneedle = "@" + en + "("
                        for _ol in e.ire_out
                            if starts_with(_ol, "declare ") and contains(_ol, _dneedle)
                                already_declared = true
                    let real_arg_sig = ""
                    let aj = 0
                    while aj < len(real_arg_types)
                        if aj > 0
                            real_arg_sig = real_arg_sig + ", "
                        real_arg_sig = real_arg_sig + real_arg_types[aj]
                        aj = aj + 1
                    // An sret return prepends a hidden pointer parameter that the CALLER owns.
                    if ret_cls == "sret"
                        let _sr = "ptr sret(" + _abi_struct_llty(b, ret_struct) + ") align 8"
                        if real_arg_sig == ""
                            real_arg_sig = _sr
                        else
                            real_arg_sig = _sr + ", " + real_arg_sig
                    if not already_declared
                        ire_line(e, "declare " + real_ret + " @" + en + "(" + real_arg_sig + ") nounwind")

                    // If non-i64 types are involved, emit a NOVA-callable wrapper
                    // that takes i64 args and marshals them to/from the C types.
                    if needs_wrapper
                        let nova_args = ""
                        let ak = 0
                        while ak < len(real_arg_types)
                            if ak > 0
                                nova_args = nova_args + ", "
                            nova_args = nova_args + "i64 %a" + str(ak)
                            ak = ak + 1
                        ire_line(e, "define i64 @nova_ffi_" + en + "(" + nova_args + ") nounwind uwtable \{")
                        ire_line(e, "entry:")
                        // Marshal each arg from i64 to its real LLVM type
                        let am = 0
                        let call_args = ""
                        while am < len(real_arg_types)
                            if am > 0
                                call_args = call_args + ", "
                            let rt = real_arg_types[am]
                            if real_arg_structs[am] != ""
                                // Load each field out of the NOVA struct and hand it over in the
                                // lowered form. A @repr(C) struct carries NO leading type-hash
                                // slot -- field j sits at slot j -- which is why the GEP index is
                                // the field index itself and not j+1.
                                let _sn = real_arg_structs[am]
                                let _kinds = _abi_field_kinds(b, _sn)
                                ire_line(e, "  %sp" + str(am) + " = inttoptr i64 %a" + str(am) + " to ptr")
                                if starts_with(rt, "ptr byval(")
                                    // SysV MEMORY class: LLVM performs the stack copy for us, so
                                    // the live pointer plus the byval attribute is correct.
                                    call_args = call_args + rt + " %sp" + str(am)
                                else if rt == "ptr"
                                    // Win64 / AAPCS64 overflow: the CALLER owns the copy. Make one
                                    // on the wrapper's stack so a callee that writes through the
                                    // pointer cannot mutate NOVA's live heap object.
                                    let _cpn = len(_kinds) * 8
                                    ire_line(e, "  %sc" + str(am) + " = alloca " + _abi_struct_llty(b, _sn) + ", align 8")
                                    ire_line(e, "  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %sc" + str(am) + ", ptr align 8 %sp" + str(am) + ", i64 " + str(_cpn) + ", i1 false)")
                                    call_args = call_args + "ptr %sc" + str(am)
                                else if starts_with(rt, "[")
                                    // AAPCS64 spells both HFA and general-register aggregates as an
                                    // array; load the whole thing in one go from the same storage.
                                    ire_line(e, "  %sv" + str(am) + " = load " + rt + ", ptr %sp" + str(am) + ", align 8")
                                    call_args = call_args + rt + " %sv" + str(am)
                                else
                                    let _fi = 0
                                    let _fargs = ""
                                    while _fi < len(_kinds)
                                        let _fll = "i64"
                                        if _kinds[_fi] == "f"
                                            _fll = "double"
                                        let _gp = "%sg" + str(am) + "_" + str(_fi)
                                        let _fv = "%sf" + str(am) + "_" + str(_fi)
                                        ire_line(e, "  " + _gp + " = getelementptr inbounds " + _fll + ", ptr %sp" + str(am) + ", i64 " + str(_fi))
                                        ire_line(e, "  " + _fv + " = load " + _fll + ", ptr " + _gp + ", align 8")
                                        if _fi > 0
                                            _fargs = _fargs + ", "
                                        _fargs = _fargs + _fll + " " + _fv
                                        _fi = _fi + 1
                                    call_args = call_args + _fargs
                            else if rt == "i64"
                                call_args = call_args + "i64 %a" + str(am)
                            else if rt == "double"
                                ire_line(e, "  %f" + str(am) + ".ub = call i64 @nova_rt_unbox(i64 %a" + str(am) + ")")
                                ire_line(e, "  %f" + str(am) + " = bitcast i64 %f" + str(am) + ".ub to double")
                                call_args = call_args + "double %f" + str(am)
                            else if rt == "ptr"
                                ire_line(e, "  %p" + str(am) + " = inttoptr i64 %a" + str(am) + " to ptr")
                                call_args = call_args + "ptr %p" + str(am)
                            else if rt == "i32" or rt == "i16" or rt == "i8"
                                // Narrow integer args need explicit truncation
                                // from NOVA's i64 calling convention to the C
                                // function's signature.
                                ire_line(e, "  %n" + str(am) + " = trunc i64 %a" + str(am) + " to " + rt)
                                call_args = call_args + rt + " %n" + str(am)
                            else
                                call_args = call_args + rt + " %a" + str(am)
                            am = am + 1
                        // Call the real C function
                        if ret_struct != ""
                            // Allocate the NOVA @repr(C) struct FIRST. Those carry no leading
                            // type-hash slot, so their data pointer IS the C struct layout --
                            // which means the sret case can hand the callee this very pointer
                            // and write the result straight into its final home, no copy.
                            let _rsz = len(_abi_field_kinds(b, ret_struct)) * 8
                            let _rk = _abi_field_kinds(b, ret_struct)
                            ire_line(e, "  %robj = call ptr @nova_rt_struct_alloc(i64 " + str(_rsz) + ")")
                            if ret_cls == "sret"
                                let _sa = "ptr sret(" + _abi_struct_llty(b, ret_struct) + ") align 8 %robj"
                                if call_args == ""
                                    ire_line(e, "  call void @" + en + "(" + _sa + ")")
                                else
                                    ire_line(e, "  call void @" + en + "(" + _sa + ", " + call_args + ")")
                            else
                                ire_line(e, "  %rv = call " + ret_cls + " @" + en + "(" + call_args + ")")
                                if starts_with(ret_cls, "\{") or starts_with(ret_cls, "[")
                                    // register-pair / HFA: unpack each element into its slot
                                    let _ri = 0
                                    while _ri < len(_rk)
                                        let _ell = "i64"
                                        if _rk[_ri] == "f"
                                            _ell = "double"
                                        if starts_with(ret_cls, "[")
                                            _ell = "i64"
                                            if allfloat_ret(_rk)
                                                _ell = "double"
                                        ire_line(e, "  %rx" + str(_ri) + " = extractvalue " + ret_cls + " %rv, " + str(_ri))
                                        ire_line(e, "  %rg" + str(_ri) + " = getelementptr " + _ell + ", ptr %robj, i64 " + str(_ri))
                                        ire_line(e, "  store " + _ell + " %rx" + str(_ri) + ", ptr %rg" + str(_ri) + ", align 8")
                                        _ri = _ri + 1
                                else
                                    // single register: `double` or `i64`. Win64 hands back a
                                    // <=8-byte struct as raw i64 BITS even for a double field,
                                    // so storing the i64 into the slot is exactly right there.
                                    ire_line(e, "  store " + ret_cls + " %rv, ptr %robj, align 8")
                            ire_line(e, "  %rip = ptrtoint ptr %robj to i64")
                            ire_line(e, "  ret i64 %rip")
                        else if real_ret == "void"
                            ire_line(e, "  call void @" + en + "(" + call_args + ")")
                            ire_line(e, "  ret i64 0")
                        else if real_ret == "double"
                            ire_line(e, "  %r = call double @" + en + "(" + call_args + ")")
                            ire_line(e, "  %ri = bitcast double %r to i64")
                            ire_line(e, "  ret i64 %ri")
                        else if real_ret == "ptr"
                            ire_line(e, "  %r = call ptr @" + en + "(" + call_args + ")")
                            ire_line(e, "  %ri = ptrtoint ptr %r to i64")
                            ire_line(e, "  ret i64 %ri")
                        else if real_ret == "i32"
                            ire_line(e, "  %r = call i32 @" + en + "(" + call_args + ")")
                            ire_line(e, "  %ri = sext i32 %r to i64")
                            ire_line(e, "  ret i64 %ri")
                        else
                            ire_line(e, "  %r = call " + real_ret + " @" + en + "(" + call_args + ")")
                            ire_line(e, "  ret i64 %r")
                        ire_line(e, "\}")
        ire_line(e, "")

    // Pass 1: Lower all functions to IR (start with imported module functions)
    let ir_fns = []
    for imp_fn in import_ir_fns
        push(ir_fns, imp_fn)
    for fn_stmt in functions
        let ir_fn = ir_optimize(ir_lower_function(b, fn_stmt))
        push(ir_fns, ir_fn)
        match fn_stmt
            Stmt(ftag, fname, fexpr, fbody, fparams, felse, fanns, fsline) =>
                let ir_name = fname
                if fname == "main"
                    ir_name = "nova_user_main"
                e.ire_fn_lines[ir_name] = fsline

    // Include lambdas generated during function lowering
    for lam_fn in b.ir_lambdas
        push(ir_fns, lam_fn)
    let lambdas_before_main = len(b.ir_lambdas)

    // Lower nova_main (top-level statements) before analysis
    b.ir_insts = []
    b.ir_blocks = []
    b.ir_clabel = "entry"
    b.ir_rc = 0
    b.ir_locals = {}
    b.ir_list_elem_stype = {}   // CVE-critical: reset for the top-level scope too
    // P5 const-baking: build each bakeable const aggregate ONCE here, at the very
    // start of nova_main (before top_stmts and the user-main call -> before any
    // use), and cache the handle. The literal expr is lowered with the normal
    // make_list path (correct element boxing); nova_rt_const_set stores it with a
    // permanent reference. Use-sites load it via nova_rt_const_get. Empty when no
    // const is bakeable -> nova_main is unchanged.
    for _cb in b.ir_const_build_order
        let _cb_name = _cb[0]
        let _cb_expr = _cb[1]
        let _cb_id = b.ir_const_baked[_cb_name]
        let _cb_h = ir_lower_expr(b, _cb_expr)
        let _cb_idr = ir_fresh_reg(b)
        ir_emit_inst(b, "const_int", _cb_idr, ir_type_int(), [], "", _cb_id)
        let _cb_sr = ir_fresh_reg(b)
        ir_emit_side(b, "call", _cb_sr, ir_type_any(), [_cb_idr, _cb_h], "nova_rt_const_set", 0)
    for s in top_stmts
        ir_lower_stmt(b, s)
    if list_contains(b.ir_fnames, "nova_user_main")
        let umr = ir_fresh_reg(b)
        ir_emit_side(b, "call", umr, ir_type_any(), [], "nova_user_main", 0)
    ir_flush_pending_block(b)
    if len(b.ir_blocks) == 0
        ir_finish_block(b, IrInst("return", "", ir_type_void(), ["0"], "", 0, "pure", b.ir_cur_line))
    let main_fn = IrFunction("nova_main", [], ir_type_any(), b.ir_blocks, [], 0)

    // Build all_fns for inter-procedural analysis
    let all_fns = []
    for f in ir_fns
        push(all_fns, f)
    push(all_fns, main_fn)
    let mi = lambdas_before_main
    while mi < len(b.ir_lambdas)
        push(all_fns, b.ir_lambdas[mi])
        mi = mi + 1

    // Pass 2: Return types + parameter types (combined inter-procedural fixpoint).
    // Combined because a function's return type can depend on its own parameter
    // types (e.g. make_mat returns a list whose element type depends on its
    // `seed` parameter), and parameter types depend on callee return types.
    let frt = {}
    for ti_fname in keys(ti_state.ti_fn_types)
        frt[ti_fname] = ti_state.ti_fn_types[ti_fname]
    // EXTERNS. ti returns nt_unit() for `extern_fn` without recording a signature, so an
    // extern never reached ti_fn_types and therefore never reached frt -- its call result
    // stayed untyped and `str()` lowered to any_to_str, which runs find_tag on raw double
    // bits, finds no heap object, and renders them as an INTEGER (a C fn returning 3.75
    // printed 4615626668101337088 -- exactly 3.75's bit pattern).
    //
    // The key detail that made four earlier attempts fail: when an extern needs a marshalling
    // wrapper the CALL SITE emits `nova_ffi_<name>`, NOT `<name>`, so seeding frt under the
    // bare NOVA name never matched. Seed BOTH spellings.
    //
    // `@raw@` is required as well: it is what tells the caller the value is raw double bits
    // rather than a box, which is exactly an extern's float ABI. Without it rtype=="float"
    // alone does not set _rawfloat, and int_to_str is never rewritten to float_to_str.
    // EXTERNS ONLY. b.ir_fn_returns holds EVERY function's declared return type, so
    // iterating it seeded @raw@ for every user fn declared `-> float` -- asserting they
    // return raw double bits when they may return a BOX. That is exactly the hazard the
    // @raw@ gate below exists to prevent ("bitcasting a box pointer as double is the
    // 2.6e-311 bug"), and doing it broke 93 tests. Restrict to declared externs, whose
    // float ABI genuinely IS raw double bits.
    let _xnames = {}
    for _xs in b.ir_externs
        match _xs
            Stmt(_xst, _xsn, _xse, _xsb, _xsp, _xsel, _xsa, _xsl) =>
                _xnames[_xsn] = 1
    for _xn in keys(_xnames)
        if contains(b.ir_fn_returns, _xn)
            let _xr = b.ir_fn_returns[_xn]
            let _xk = ""
            if _xr == "float"
                _xk = "float"
            else if _xr == "int" or _xr == "bool"
                _xk = "int"
            else if _xr == "string"
                _xk = "str"
            if _xk != ""
                if not contains(frt, _xn)
                    frt[_xn] = _xk
                if not contains(frt, "nova_ffi_" + _xn)
                    frt["nova_ffi_" + _xn] = _xk
                if _xk == "float"
                    frt["@raw@" + _xn] = 1
                    frt["@raw@nova_ffi_" + _xn] = 1
    let _sft_keys = keys(b.ir_field_types)
    for _sfk in _sft_keys
        frt["@sf@" + _sfk] = b.ir_field_types[_sfk]
    // PERF Stage 3 (Representation Inference): per-struct POSITIONAL float-field map.
    // "@sfkinds@<Struct>" -> a string with one char per field in declaration order:
    // "f" if that field is float, "." otherwise. make_struct args are positional, but
    // field types in frt are keyed by name; this gives the coercion pass position->kind
    // so it can narrow an `any` (boxed) arg destined for a float field back to raw bits.
    let _sd_keys = keys(b.ir_sdefs)
    for _sdn in _sd_keys
        let _sfkinds = ""
        for _sfp in b.ir_sdefs[_sdn]
            match _sfp
                Param(_pn, _pt, _pd) =>
                    if _pt == "float"
                        _sfkinds = _sfkinds + "f"
                    else
                        _sfkinds = _sfkinds + "."
        frt["@sfkinds@" + _sdn] = _sfkinds
    let fpt = {}
    // #14 (S5 HOF mono, gated NOVA_S5_HOF): map trampoline name -> [lambda_body, ncap]
    // so ir_collect_param_types can specialize an inline map/filter lambda's param to the
    // list's element kind. Flag OFF => empty map => no HOF harvest => byte-identical codegen.
    let _s5_tramp_map = {}
    let _s5_hof_flag = env("NOVA_S5_HOF")
    if len(_s5_hof_flag) > 0 and _s5_hof_flag[0] == "1"
        for _s5_sp in b.ir_tramps
            _s5_tramp_map[_s5_sp[0]] = [_s5_sp[1], _s5_sp[2]]
    let changed = true
    let pass_count = 0
    while changed and pass_count < 6
        changed = false
        pass_count = pass_count + 1
        fpt = ir_collect_param_types(all_fns, frt, _s5_tramp_map)
        for ir_fn in all_fns
            match ir_fn
                IrFunction(fname, fp, fret, fblocks, ftp, fex) =>
                    let old_type = "any"
                    if contains(frt, fname)
                        old_type = frt[fname]
                    let new_type = ir_analyze_return_type(ir_fn, frt, fpt)
                    // TIER 1: a GENUINELY heterogeneous fn (ti_ widened its return to `any` on a real
                    // conflict) must STAY `any` — do not refine it to a first-return concrete type, or
                    // callers mis-dispatch print/box on the non-primary-type returns. (Incomplete-`any`
                    // fns are NOT in ti_fn_hetero, so the IR may still refine those for perf.)
                    if new_type != old_type and new_type != "any" and not contains(ti_state.ti_fn_hetero, fname)
                        frt[fname] = new_type
                        changed = true
    fpt = ir_collect_param_types(all_fns, frt, _s5_tramp_map)

    // PERF P1 (beat-C struct math): mark every float-returning user fn that PROVABLY
    // returns raw double bits as "@raw@<fn>" in frt. ir_infer_one then types calls to
    // such fns float -> the emitter reads the result via bitcast, dropping the per-call
    // defensive nova_rt_unbox (the dot-product gap vs C). Small monotonic fixpoint so a
    // fn returning another raw fn's result is also caught (transitive). Only float-typed,
    // not-yet-marked fns are analysed, so the cost is bounded (most fns are skipped).
    let raw_changed = true
    let raw_pass = 0
    while raw_changed and raw_pass < 4
        raw_changed = false
        raw_pass = raw_pass + 1
        for ir_fn in all_fns
            match ir_fn
                IrFunction(rfname, rfp, rfret, rfblocks, rftp, rfex) =>
                    if contains(frt, rfname) and frt[rfname] == "float" and not contains(frt, "@raw@" + rfname)
                        if ir_returns_raw_double(ir_fn, frt, fpt) == 1
                            frt["@raw@" + rfname] = 1
                            raw_changed = true

    // Stage 4 SROA (Step A — analysis only, no codegen change yet): the set of all-scalar
    // struct types (every field int/float/bool => no heap fields => zero RC concern in any
    // mode) + the interprocedural escape summary. Together they drive ir_stackable_structs,
    // emitted below as ; STACKABLE comments so the analysis can be validated before the
    // alloca codegen is wired (which will be gated behind NOVA_SROA=1).
    let _allscalar = {}
    for _sdt in keys(b.ir_sdefs)
        // Exclude @repr(C)/aligned structs: their FFI layout (no type-hash slot, custom
        // alignment) must stay heap. Plain all-scalar structs (every field int/float/bool)
        // are stack-allocatable — no heap fields => zero RC concern, fixed extra_slots=1.
        if not contains(b.ir_repr_c_types, _sdt) and not contains(b.ir_repr_align, _sdt)
            let _allsc = 1
            for _sfp in b.ir_sdefs[_sdt]
                match _sfp
                    Param(_apn, _apt, _apd) =>
                        if _apt != "int" and _apt != "float" and _apt != "bool"
                            _allsc = 0
            if _allsc == 1
                _allscalar[_sdt] = 1
    let _esumm = ir_escape_summaries(all_fns)

    // ── #15 S5 ABI: compute by-value-eligible callee set (NOVA_S5_ABI=1) ──────
    // A param i of f is by-value-eligible iff:
    //   (1) fpt (the sound use-set from ir_collect_param_types) gives a concrete
    //       struct name S for that param (not "any" = conflict, not a scalar type)
    //   (2) S is in _allscalar (all fields int/float/bool)
    //   (3) param i does NOT escape inside f (per _esumm)
    // Then a global address-taken guard removes any f that is referenced anywhere
    // other than as the direct callee of an op=="call" instruction.
    let _s5_abi_env = env("NOVA_S5_ABI")
    let do_s5abi = len(_s5_abi_env) > 0 and _s5_abi_env[0] == "1"
    let _s5_byval = {}
    if do_s5abi
        // Edit 1: eligibility from the SOUND use-set (fpt), NOT ir_fn_param_stypes
        for _s5_fn in all_fns
            match _s5_fn
                IrFunction(_s5_fname, _s5_fparams, _, _, _, _s5_fex) =>
                    if _s5_fex == 0
                        let _s5_idxs = []
                        let _s5_pi = 0
                        for _s5_p in _s5_fparams
                            match _s5_p
                                IrParam(_s5_pn, _s5_pt) =>
                                    let _s5_pst = ""
                                    if contains(fpt, _s5_fname) and contains(fpt[_s5_fname], str(_s5_pi))
                                        _s5_pst = fpt[_s5_fname][str(_s5_pi)]
                                    // Require: concrete struct name in _allscalar, not "any"/scalar
                                    let _s5_esc = contains(_esumm, _s5_fname) and contains(_esumm[_s5_fname], str(_s5_pi))
                                    if _s5_pst != "" and _s5_pst != "any" and _s5_pst != "int" and _s5_pst != "float" and _s5_pst != "str" and _s5_pst != "list" and _s5_pst != "dict" and _s5_pst != "bool" and _s5_pst != "intlist" and _s5_pst != "floatlist" and contains(_allscalar, _s5_pst) and not _s5_esc
                                        push(_s5_idxs, [_s5_pi, _s5_pst])
                            _s5_pi = _s5_pi + 1
                        if len(_s5_idxs) > 0
                            _s5_byval[_s5_fname] = _s5_idxs

        // Edit 2: global address-taken guard — remove any f that appears as
        // anything other than the callee value of a direct op=="call".
        // Build the set of fnames that are address-taken (referenced indirectly).
        let _s5_taken = {}
        for _s5g_fn in all_fns
            match _s5g_fn
                IrFunction(_, _, _, _s5g_blocks, _, _) =>
                    for _s5g_blk in _s5g_blocks
                        match _s5g_blk
                            IrBlock(_, _s5g_insts, _s5g_term) =>
                                for _s5g_inst in _s5g_insts
                                    match _s5g_inst
                                        IrInst(_s5g_op, _, _, _s5g_args, _s5g_val, _, _, _) =>
                                            if _s5g_op == "call"
                                                // In a direct call, value is the callee name.
                                                // Args are the arguments — if any arg is an fname
                                                // in _s5_byval, it is address-taken (passed as value).
                                                let _s5g_ai = 0
                                                while _s5g_ai < len(_s5g_args)
                                                    if contains(_s5_byval, _s5g_args[_s5g_ai])
                                                        _s5_taken[_s5g_args[_s5g_ai]] = 1
                                                    _s5g_ai = _s5g_ai + 1
                                            else if _s5g_op == "make_closure" or _s5g_op == "call_by_name" or _s5g_op == "dyn_call"
                                                // value field references a function name (closure target,
                                                // call_by_name target, etc.)
                                                if contains(_s5_byval, _s5g_val)
                                                    _s5_taken[_s5g_val] = 1
                                                // Also check all args
                                                let _s5g_bi = 0
                                                while _s5g_bi < len(_s5g_args)
                                                    if contains(_s5_byval, _s5g_args[_s5g_bi])
                                                        _s5_taken[_s5g_args[_s5g_bi]] = 1
                                                    _s5g_bi = _s5g_bi + 1
                                            else
                                                // Any other op: if value or any arg is an fname, it's taken
                                                if contains(_s5_byval, _s5g_val)
                                                    _s5_taken[_s5g_val] = 1
                                                let _s5g_ci = 0
                                                while _s5g_ci < len(_s5g_args)
                                                    if contains(_s5_byval, _s5g_args[_s5g_ci])
                                                        _s5_taken[_s5g_args[_s5g_ci]] = 1
                                                    _s5g_ci = _s5g_ci + 1
                                match _s5g_term
                                    IrInst(_s5g_top, _, _, _s5g_targs, _s5g_tval, _, _, _) =>
                                        // Terminators (return, branch, etc.)
                                        if contains(_s5_byval, _s5g_tval)
                                            _s5_taken[_s5g_tval] = 1
                                        let _s5g_di = 0
                                        while _s5g_di < len(_s5g_targs)
                                            if contains(_s5_byval, _s5g_targs[_s5g_di])
                                                _s5_taken[_s5g_targs[_s5g_di]] = 1
                                            _s5g_di = _s5g_di + 1
        // Remove address-taken fns from _s5_byval
        for _s5_tk in keys(_s5_taken)
            if contains(_s5_byval, _s5_tk)
                _s5_byval[_s5_tk] = []
        // Clean up empty entries
        let _s5_final = {}
        for _s5_fk in keys(_s5_byval)
            if len(_s5_byval[_s5_fk]) > 0
                _s5_final[_s5_fk] = _s5_byval[_s5_fk]
        _s5_byval = _s5_final

    // Pass 3: Infer types with inter-procedural info and emit
    // Plumb @repr(C) type set from the IR builder into the LLVM emitter so
    // make_struct can skip the type-hash slot for C-layout structs.
    for k in keys(b.ir_repr_c_types)
        e.ire_repr_c_types[k] = 1
    for k in keys(b.ir_repr_packed)
        e.ire_repr_packed[k] = 1
    for k in keys(b.ir_repr_align)
        e.ire_repr_align[k] = b.ir_repr_align[k]
    // #15 S5 ABI: plumb the by-value-eligible set and struct defs into the emitter
    e.ire_s5_byval = _s5_byval
    e.ire_s5_sdefs = b.ir_sdefs

    // ── Wave-B #6 part 4: WHOLE-PROGRAM "returns a FRESH allocation" proof ──────────────
    // The last leak column is `push(xs, mk(i))` — inserting a USER call's result. To MOVE that
    // value the caller must know the callee returned a +1 it OWNS, not a BORROW: a fn returning
    // `xs[0]` or `self.name` hands back a pointer its container still owns, and dropping that
    // would be CORE_GAP 0.10 (use-after-free).
    // Fail-closed, like the existing _s1 struct-return prover: a fn qualifies ONLY if EVERY
    // `return` hands back a register whose DEFINING instruction in that same function is itself
    // a proven fresh allocation. A param, slot_load, index_get/field_get, unproven call or bare
    // constant leaves the register out of the def set and disqualifies the function. No fixpoint
    // over call chains — a fn returning another user fn's result is simply not proven.
    // NOTE all_fns holds PRE-inference IR, where a string `+` is an untyped `add`. The str type
    // that identifies it as a fresh allocation is assigned by ir_infer_types, so the prover must
    // run on the TYPED form — otherwise `return "item-" + str(i)` looks like a plain add and the
    // function is (silently, safely) rejected. Same typing the emit loop applies.
    for _fr_f0 in all_fns
        let _fr_f = ir_infer_types(_fr_f0, frt, fpt)
        match _fr_f
            IrFunction(_fr_name, _fr_params, _fr_ret, _fr_blocks, _fr_tp, _fr_ext) =>
                if _fr_ext == 0
                    let _fr_defs = {}
                    for _fr_b in _fr_blocks
                        match _fr_b
                            IrBlock(_fr_l, _fr_insts, _fr_t) =>
                                for _fr_i in _fr_insts
                                    match _fr_i
                                        IrInst(_fro, _frd, _frty, _fra, _frv, _frn, _fre, _frln) =>
                                            if _fro == "call" and _frd != "" and _wb6_is_fresh_alloc(_frv)
                                                _fr_defs[_frd] = 1
                                            if _fro == "add" and _frd != ""
                                                match _frty
                                                    IrType(_frtk, _frtn, _frtp, _frtid) =>
                                                        if _frtk == "str"
                                                            _fr_defs[_frd] = 1
                    let _fr_ok = 1
                    let _fr_n = 0
                    for _fr_b2 in _fr_blocks
                        match _fr_b2
                            IrBlock(_fr_l2, _fr_in2, _fr_t2) =>
                                match _fr_t2
                                    IrInst(_fr_to, _fr_td, _fr_tty, _fr_ta, _fr_tv, _fr_tn, _fr_te, _fr_tl) =>
                                        if _fr_to == "return"
                                            _fr_n = _fr_n + 1
                                            if len(_fr_ta) == 0
                                                _fr_ok = 0
                                            else if not contains(_fr_defs, _fr_ta[0])
                                                _fr_ok = 0
                    if _fr_ok == 1 and _fr_n > 0
                        e.ire_s5_byval["@fresh@" + _fr_name] = 1
    // Track 8 escape analysis + W3 RC elision: ON by default (the perf moat).
    // NOVA_NO_TRACK8=1 disables both for bisection / backward-compat. The
    // existing NOVA_TRACK8=1 env still works (now also enables W4 strict
    // move check, which is the only stricter-semantic feature in Track 8).
    let esc_env = env("NOVA_ESCAPE_STATS")
    let no_t8 = env("NOVA_NO_TRACK8")
    let t8_off = len(no_t8) > 0 and no_t8[0] == "1"
    let want_escape = (not t8_off) or (len(esc_env) > 0 and esc_env[0] == "1")
    let want_elision = not t8_off
    // Stage 4 SROA (Step B): stack-allocate non-escaping all-scalar structs — DEFAULT ON
    // (beat-C on struct-construction loops, 17x->~1.04x C). The interprocedural escape
    // analysis keeps any struct that escapes or reaches a MemTag-reading op (call/closure/
    // container/eq-ne/dict-key/return/send/spawn) on the heap, so this is sound. Validated:
    // full regression 394/394 with SROA + escape stress tests + bootstrap-on-itself. Escape
    // hatch: NOVA_NO_SROA=1 disables it (bisection / safety).
    let _nosroa_env = env("NOVA_NO_SROA")
    let do_sroa = not (len(_nosroa_env) > 0 and _nosroa_env[0] == "1")
    let total_allocs = 0
    let total_escape = 0
    for ir_fn in ir_fns
        let typed_fn = ir_infer_types(ir_fn, frt, fpt)
        if want_escape
            let ea = ir_escape_analysis(typed_fn)
            total_allocs = total_allocs + ea[0]
            total_escape = total_escape + ea[1]
            if want_elision
                // Per-function reset to avoid cross-function pollution
                // (SSA reg names like %r0 repeat in different functions).
                e.ire_local_lists = {}
                let local_set = ea[2]
                for k in keys(local_set)
                    e.ire_local_lists[k] = 1
            match typed_fn
                IrFunction(fname, _, _, _, _, _) =>
                    ire_line(e, "; ESCAPE " + fname + ": allocs=" + str(ea[0]) + " escape=" + str(ea[1]) + " local=" + str(ea[0] - ea[1]))
                    let _stk = ir_stackable_structs(typed_fn, _esumm, _allscalar)
                    if len(keys(_stk)) > 0
                        let _sl = "; STACKABLE " + fname + ":"
                        for _sk in keys(_stk)
                            _sl = _sl + " " + _sk
                        ire_line(e, _sl)
        e.ire_stackable = {}
        if do_sroa and want_escape
            e.ire_stackable = ir_stackable_structs(typed_fn, _esumm, _allscalar)
        ire_emit_function(e, typed_fn)

    // Emit nova_main
    let typed_main = ir_infer_types(main_fn, frt, fpt)
    if want_escape
        let ea_main = ir_escape_analysis(typed_main)
        total_allocs = total_allocs + ea_main[0]
        total_escape = total_escape + ea_main[1]
        if want_elision
            e.ire_local_lists = {}
            let local_set_m = ea_main[2]
            for k in keys(local_set_m)
                e.ire_local_lists[k] = 1
        ire_line(e, "; ESCAPE nova_main: allocs=" + str(ea_main[0]) + " escape=" + str(ea_main[1]) + " local=" + str(ea_main[0] - ea_main[1]))
        let _stkm = ir_stackable_structs(typed_main, _esumm, _allscalar)
        if len(keys(_stkm)) > 0
            let _slm = "; STACKABLE nova_main:"
            for _skm in keys(_stkm)
                _slm = _slm + " " + _skm
            ire_line(e, _slm)
    e.ire_stackable = {}
    if do_sroa and want_escape
        e.ire_stackable = ir_stackable_structs(typed_main, _esumm, _allscalar)
    ire_emit_function(e, typed_main)

    // Emit any lambdas generated during nova_main lowering
    let mi2 = lambdas_before_main
    while mi2 < len(b.ir_lambdas)
        let lam_fn = b.ir_lambdas[mi2]
        let typed_lam = ir_infer_types(lam_fn, frt, fpt)
        if want_escape
            let ea_lam = ir_escape_analysis(typed_lam)
            total_allocs = total_allocs + ea_lam[0]
            total_escape = total_escape + ea_lam[1]
            if want_elision
                e.ire_local_lists = {}
                let local_set_l = ea_lam[2]
                for k in keys(local_set_l)
                    e.ire_local_lists[k] = 1
            match typed_lam
                IrFunction(lname, _, _, _, _, _) =>
                    ire_line(e, "; ESCAPE " + lname + ": allocs=" + str(ea_lam[0]) + " escape=" + str(ea_lam[1]) + " local=" + str(ea_lam[0] - ea_lam[1]))
        e.ire_stackable = {}
        ire_emit_function(e, typed_lam)
        mi2 = mi2 + 1
    if want_escape
        let pct_local = 0
        if total_allocs > 0
            pct_local = (100 * (total_allocs - total_escape)) / total_allocs
        ire_line(e, "; ESCAPE SUMMARY: allocs=" + str(total_allocs) + " escape=" + str(total_escape) + " local=" + str(total_allocs - total_escape) + " (" + str(pct_local) + "% local, RC-elidable)")

    // Emit trampolines
    for spec in b.ir_tramps
        let tname = spec[0]
        let target = spec[1]
        let ncap = spec[2]
        let npar = spec[3]
        let hdr = "define i64 @" + tname + "(i64 %record"
        let pi = 0
        while pi < npar
            hdr = hdr + ", i64 %p" + str(pi)
            pi = pi + 1
        hdr = hdr + ") nounwind uwtable \{"
        ire_line(e, hdr)
        ire_line(e, "entry:")
        if ncap > 0
            ire_indent(e, "%rec_ptr = inttoptr i64 %record to ptr")
            let ci = 0
            while ci < ncap
                let gep_name = "%cap" + str(ci) + "_ptr"
                ire_indent(e, gep_name + " = getelementptr i64, ptr %rec_ptr, i64 " + str(ci + 1))
                ire_indent(e, "%cap" + str(ci) + " = load i64, ptr " + gep_name + ", align 8")
                ci = ci + 1
        let call_str = "call i64 @" + target + "("
        let first_arg = 1
        let ci2 = 0
        while ci2 < ncap
            if first_arg == 0
                call_str = call_str + ", "
            call_str = call_str + "i64 %cap" + str(ci2)
            first_arg = 0
            ci2 = ci2 + 1
        let pi2 = 0
        while pi2 < npar
            if first_arg == 0
                call_str = call_str + ", "
            call_str = call_str + "i64 %p" + str(pi2)
            first_arg = 0
            pi2 = pi2 + 1
        call_str = call_str + ")"
        ire_indent(e, "%result = " + call_str)
        // CYCLE 2 — BOX AT THE TRAMPOLINE. A float-returning callback returns RAW IEEE-754 bits
        // (the raw-float ABI), but every HOF (map/filter/reduce/sort_by) stores the trampoline's
        // result into an `any` container. Storing raw bits there means the value is later read back
        // as an int: `map(get_price)` yielded 4617878467915022336 instead of 20.25.
        // The trampoline is the single any-widen point every callback flows through, so boxing here
        // covers named fns, lambdas and the `xs.map(f)` method path uniformly.
        // Gated on the TARGET's analyzed return type being exactly "float": an "any" return is
        // already boxed by its own producer, so this never double-boxes.
        let _tr_boxes = 0
        if contains(frt, target)
            if frt[target] == "float"
                _tr_boxes = 1
        if _tr_boxes == 1
            ire_indent(e, "%boxed = call i64 @nova_rt_box_float(i64 %result)")
            ire_indent(e, "ret i64 %boxed")
        else
            ire_indent(e, "ret i64 %result")
        ire_line(e, "}")
        ire_line(e, "")

    // Track 8 W7: auto-arena. When NOVA_AUTO_ARENA=1 is set AND the program
    // never calls spawn (direct or via runtime), enable arena mode at the very
    // start of main. This eliminates all RC traffic globally — memory frees on
    // process exit via OS teardown. Safe for short-lived programs; long-running
    // single-process programs would leak, so this stays opt-in.
    let auto_arena_env = env("NOVA_AUTO_ARENA")
    let want_auto_arena = len(auto_arena_env) > 0 and auto_arena_env[0] == "1"
    let do_auto_arena = 0
    if want_auto_arena
        if ir_program_has_spawn(all_fns) == 0
            do_auto_arena = 1

    // #25 C-ABI @export: if any fn carries @export, this translation unit is a C-callable
    // LIBRARY. Emit the runtime-init/dispatch entry under a NON-`main` symbol so a C host can
    // provide its own `main` with no link clash; the host calls nova_rt_init() once, then the
    // exported NOVA functions directly (a NOVA `int` param/return is i64 == C int64_t, so the
    // uniform ABI is already C-compatible for int-typed exports). Exported fns emit as plain
    // external `@<name>` (verified: `@novalib_add` etc.). With NO @export this is byte-identical.
    let _has_c_export = false
    // LOCK-6 Phase 2: names of fns carrying @cdecl (C-callback entry points).
    let _cdecl_fns = []
    let _cdecl_arity = {}
    for _xfs in stmts
        match _xfs
            Stmt(_xt, _xn, _xe, _xb, _xp, _xeb, _xanns, _xsl) =>
                if _xt == "fn"
                    for _xa in _xanns
                        match _xa
                            Expr(_xat, _xav, _xan, _xac, _xaf, _xal) =>
                                if _xat == "ann" and _xav == "export"
                                    _has_c_export = true
                                if _xat == "ann" and _xav == "cdecl"
                                    push(_cdecl_fns, _xn)
                                    _cdecl_arity[_xn] = len(_xp)

    // LOCK-6 Phase 2 — @cdecl C-CALLBACK ENTRY POINTS.
    // A NOVA fn marked @cdecl is meant to be handed to C as a function pointer (qsort's
    // comparator, a Win32 WNDPROC, a signal/thread proc, any C library callback). Two things make
    // that unsafe without a wrapper:
    //   1. C may invoke it BEFORE any NOVA code has run, and on a FOREIGN thread, so the runtime
    //      may be uninitialized. nova_rt_ensure_init() is the idempotent once-guard for that
    //      (nova_rt_init itself is NOT idempotent — it initializes critical sections).
    //   2. The callback must be a STABLE external symbol; the NOVA fn itself may be internal.
    // The value ABI already lines up: a NOVA `int` param/return is i64 == C int64_t, and on
    // x86-64 a pointer argument is passed exactly like an i64 — the same equivalence @export
    // already documents and relies on. So the wrapper is a pure pass-through plus the init guard.
    //
    // KNOWN LIMITATION (owner's call, deliberately NOT invented here): a C callback whose
    // prototype returns 32-bit `int` gets an i64 return. On x86-64 the low 32 bits are what the
    // caller reads, so it works in practice, but it is not ABI-correct in general. Expressing an
    // exact C prototype needs a signature on the annotation (e.g. @cdecl("i32(ptr,ptr)")), which
    // is a public-API design decision, not an implementation detail.
    for _cdn in _cdecl_fns
        let _cda = _cdecl_arity[_cdn]
        let _cdh = "define i64 @" + _cdn + "__cdecl("
        let _cdi = 0
        while _cdi < _cda
            if _cdi > 0
                _cdh = _cdh + ", "
            _cdh = _cdh + "i64 %a" + str(_cdi)
            _cdi = _cdi + 1
        _cdh = _cdh + ") nounwind uwtable \{"
        ire_line(e, _cdh)
        ire_line(e, "entry:")
        ire_indent(e, "call void @nova_rt_ensure_init()")
        let _cdc = "call i64 @" + _cdn + "("
        let _cdj = 0
        while _cdj < _cda
            if _cdj > 0
                _cdc = _cdc + ", "
            _cdc = _cdc + "i64 %a" + str(_cdj)
            _cdj = _cdj + 1
        _cdc = _cdc + ")"
        ire_indent(e, "%r = " + _cdc)
        ire_indent(e, "ret i64 %r")
        ire_line(e, "}")
        ire_line(e, "")
    let _entry_name = "main"
    if _has_c_export
        _entry_name = "__nova_export_init"
    // Emit main entry point (renamed away from `main` in @export library mode)
    ire_line(e, "define i32 @" + _entry_name + "(i32 %argc, ptr %argv) nounwind uwtable \{")
    ire_line(e, "entry:")
    ire_indent(e, "%argc64 = sext i32 %argc to i64")
    ire_indent(e, "%argv64 = ptrtoint ptr %argv to i64")
    ire_indent(e, "call void @nova_rt_init_args(i64 %argc64, i64 %argv64)")
    if do_auto_arena == 1
        ire_line(e, "  ; AUTO-ARENA: no spawn detected, RC overhead globally eliminated")
        ire_indent(e, "call void @nova_rt_set_arena_mode(i64 1)")
    // Register struct type names for runtime reflection (type_name -> concrete name).
    // One registration per struct type (deduped via the dict, accumulated as structs
    // were lowered) — built once here at init, looked up by slot-0 type hash. Zero
    // per-construction cost. The registry stays empty for programs with no structs.
    if len(keys(e.ire_struct_types)) > 0
        ire_line(e, "  ; RTTI: register struct type names + field metadata (hash-keyed, for json/show through any)")
        let sreg_i = 0
        let fld_i = 0
        for st_name in keys(e.ire_struct_types)
            let st_hash = e.ire_struct_types[st_name]
            let st_str = ire_intern_string(e, st_name)
            let st_len = len(st_name) + 1
            let sp_reg = "%sreg.p" + str(sreg_i)
            let spi_reg = "%sreg.pi" + str(sreg_i)
            ire_indent(e, sp_reg + " = getelementptr inbounds [" + str(st_len) + " x i8], ptr " + st_str + ", i64 0, i64 0")
            ire_indent(e, spi_reg + " = ptrtoint ptr " + sp_reg + " to i64")
            ire_indent(e, "call void @nova_rt_register_struct_name(i64 " + st_hash + ", i64 " + spi_reg + ")")
            // Field metadata, keyed on the same slot-0 hash so json/show/from_json recover
            // the struct shape when the static type is lost to `any`. Reuses spi_reg (the
            // interned type-name pointer). Declaration order == slot order (make_struct
            // stores field i at slot i+1). Field name/type strings are interned constants.
            if contains(b.ir_sdefs, st_name)
                let _flds = b.ir_sdefs[st_name]
                ire_indent(e, "call void @nova_rt_register_struct_meta(i64 " + st_hash + ", i64 " + spi_reg + ", i64 " + str(len(_flds)) + ")")
                // CORE_GAP 0.8: per-type MANAGED-SLOT bitmap. Bit (field_i + 1) set iff the field is
                // managed (type not in {int,float,bool}) -> nova_rc_free dec's ONLY those pointer slots.
                // Physical slot = field_i + 1 (slot 0 = type hash). Cap at 63 (uint64 bitmap; fields >=63
                // stay non-owning, a safe rare leak). Registered only when non-empty (else lookup -> 0).
                let _bmask = 0
                let _bfi = 0
                for _bfp in _flds
                    match _bfp
                        Param(_bpn, _bpt, _bpd) =>
                            if _bfi < 63 and ire_field_is_managed(_bpt)
                                _bmask = _bmask + (1 << (_bfi + 1))
                            _bfi = _bfi + 1
                if _bmask != 0
                    ire_indent(e, "call void @nova_rt_register_struct_bitmap(i64 " + st_hash + ", i64 " + fmt_i64_decimal(_bmask) + ")")
                if contains(b.ir_sredact, st_name)
                    ire_indent(e, "call void @nova_rt_register_struct_redact(i64 " + st_hash + ", i64 " + fmt_i64_decimal(b.ir_sredact[st_name]) + ")")
                // L10 Drop: if the type declares a `drop` method, register its address so
                // rc_free can run it before releasing the fields. Registered by ADDRESS (not
                // name) so destruction needs no lookup on the hot path.
                if list_contains(b.ir_fnames, st_name + "__drop")
                    ire_indent(e, "call void @nova_rt_register_struct_drop(i64 " + st_hash + ", i64 ptrtoint (ptr @" + st_name + "__drop to i64))")
                let _fi = 0
                for _fp in _flds
                    match _fp
                        Param(_pn, _pt, _pd) =>
                            let _fn_str = ire_intern_string(e, _pn)
                            let _fn_len = len(_pn) + 1
                            let _ft_str = ire_intern_string(e, _pt)
                            let _ft_len = len(_pt) + 1
                            let _np = "%sfld.n" + str(fld_i)
                            let _npi = "%sfld.ni" + str(fld_i)
                            let _tp = "%sfld.t" + str(fld_i)
                            let _tpi = "%sfld.ti" + str(fld_i)
                            ire_indent(e, _np + " = getelementptr inbounds [" + str(_fn_len) + " x i8], ptr " + _fn_str + ", i64 0, i64 0")
                            ire_indent(e, _npi + " = ptrtoint ptr " + _np + " to i64")
                            ire_indent(e, _tp + " = getelementptr inbounds [" + str(_ft_len) + " x i8], ptr " + _ft_str + ", i64 0, i64 0")
                            ire_indent(e, _tpi + " = ptrtoint ptr " + _tp + " to i64")
                            ire_indent(e, "call void @nova_rt_register_struct_field(i64 " + st_hash + ", i64 " + str(_fi) + ", i64 " + _npi + ", i64 " + _tpi + ")")
                            _fi = _fi + 1
                            fld_i = fld_i + 1
            sreg_i = sreg_i + 1
    // P4 distributed: register every user function by name so call_by_name /
    // remote_spawn can resolve it at runtime. Emitted ONLY when the program uses
    // them (e.ire_uses_byname) — otherwise zero cost and no address-taking that
    // would pin otherwise-dead functions. Runs here at @main init, single-threaded
    // before nova_rt_main_dispatch, so the registry is immutable during execution
    // (lock-free reads). Mirrors the struct-name registration pattern above.
    if e.ire_uses_byname == 1
        ire_line(e, "  ; FN-REGISTRY: register user functions for call_by_name / remote_spawn")
        let freg_i = 0
        for rf in all_fns
            match rf
                IrFunction(rfn, rfp, rfr, rfb, rftp, rfex) =>
                    if rfex == 0
                        let rf_str = ire_intern_string(e, rfn)
                        let rf_len = len(rfn) + 1
                        let frp_reg = "%freg.p" + str(freg_i)
                        let frpi_reg = "%freg.pi" + str(freg_i)
                        ire_indent(e, frp_reg + " = getelementptr inbounds [" + str(rf_len) + " x i8], ptr " + rf_str + ", i64 0, i64 0")
                        ire_indent(e, frpi_reg + " = ptrtoint ptr " + frp_reg + " to i64")
                        ire_indent(e, "call void @nova_rt_register_fn(i64 " + frpi_reg + ", i64 ptrtoint (ptr @" + rfn + " to i64), i64 " + str(len(rfp)) + ")")
                        freg_i = freg_i + 1
    // Pre-register all coverage-instrumented lines so the report shows
    // hit/total properly (lines never executed still appear as uncovered).
    if e.ire_cov_enabled == 1 and len(keys(e.ire_cov_lines)) > 0
        let cov_fn_str = ire_intern_string(e, e.ire_filename)
        let cov_fn_len = len(e.ire_filename) + 1
        ire_indent(e, "%covr.p = getelementptr inbounds [" + str(cov_fn_len) + " x i8], ptr " + cov_fn_str + ", i64 0, i64 0")
        ire_indent(e, "%covr.pi = ptrtoint ptr %covr.p to i64")
        let cri = 0
        for lk in keys(e.ire_cov_lines)
            let cr_reg = "%covr.r" + str(cri)
            ire_indent(e, cr_reg + " = call i64 @nova_rt_cov_register(i64 %covr.pi, i64 " + lk + ")")
            cri = cri + 1
    if e.ire_dbg_instr_enabled == 1
        ire_indent(e, "%dbgen = call i64 @nova_rt_dbg_enable()")
    ire_indent(e, "call void @nova_rt_main_dispatch(i64 ptrtoint (ptr @nova_main to i64))")
    ire_indent(e, "call void @nova_rt_wait_all()")
    ire_indent(e, "call void @nova_rt_cleanup()")
    ire_indent(e, "ret i32 0")
    ire_line(e, "}")
    ire_line(e, "")

    // Emit string constants
    if len(e.ire_strs) > 0
        ire_line(e, "; String constants")
        for sc in e.ire_strs
            ire_line(e, sc)
        ire_line(e, "")

    // Emit debug metadata
    let lb = chr(123)
    let rb = chr(125)
    if len(e.ire_dbg_entries) > 0
        ire_line(e, "; Debug metadata")
        ire_line(e, "!llvm.dbg.cu = !" + lb + "!100" + rb)
        ire_line(e, "!llvm.module.flags = !" + lb + "!102, !103" + rb)
        ire_line(e, "")
        let _ek = "LineTablesOnly"
        if e.ire_dwarf_vars == 1
            _ek = "FullDebug"
        ire_line(e, "!100 = distinct !DICompileUnit(language: DW_LANG_C99, file: !101, producer: " + dq + "NOVA Compiler" + dq + ", isOptimized: false, emissionKind: " + _ek + ")")
        ire_line(e, "!101 = !DIFile(filename: " + dq + e.ire_filename + dq + ", directory: " + dq + "." + dq + ")")
        if target_is_windows(e.ire_target) == 1 and e.ire_dwarf_vars == 0
            ire_line(e, "!102 = !" + lb + "i32 2, !" + dq + "CodeView" + dq + ", i32 1" + rb)
        else
            // #33: variable-debug mode emits DWARF even on Windows so lldb (which `nova debug`
            // launches) can read locals; flag-off Windows keeps CodeView -> byte-identical.
            ire_line(e, "!102 = !" + lb + "i32 7, !" + dq + "Dwarf Version" + dq + ", i32 4" + rb)
        ire_line(e, "!103 = !" + lb + "i32 2, !" + dq + "Debug Info Version" + dq + ", i32 3" + rb)
        ire_line(e, "!104 = !DISubroutineType(types: !105)")
        ire_line(e, "!105 = !" + lb + "null" + rb)
        for dbg_entry in e.ire_dbg_entries
            let sp_id = dbg_entry[0]
            let loc_id = dbg_entry[1]
            let dbg_name = dbg_entry[2]
            let dbg_line = dbg_entry[3]
            ire_line(e, "!" + str(sp_id) + " = distinct !DISubprogram(name: " + dq + dbg_name + dq + ", scope: !101, file: !101, line: " + str(dbg_line) + ", type: !104, scopeLine: " + str(dbg_line) + ", spFlags: DISPFlagDefinition, unit: !100)")
            ire_line(e, "!" + str(loc_id) + " = !DILocation(line: " + str(dbg_line) + ", column: 0, scope: !" + str(sp_id) + ")")
        // Per-statement DILocations (one per unique line per function scope).
        // Stepping the debugger through compiled code lands on these lines
        // instead of always reporting the function's start line.
        for loc_entry in e.ire_loc_entries
            let pl_id = loc_entry[0]
            let pl_sp = loc_entry[1]
            let pl_line = loc_entry[2]
            ire_line(e, "!" + str(pl_id) + " = !DILocation(line: " + str(pl_line) + ", column: 0, scope: !" + str(pl_sp) + ")")
        // #33: variable debug info (DILocalVariable + a nova_value base type) when enabled.
        if e.ire_dwarf_vars == 1
            // A typedef (not a bare DIBasicType) so lldb preserves the name "nova_value"
            // for type-summary matching — a DW_ATE_signed/64 base type is displayed as
            // "long long" and the custom name is lost.
            ire_line(e, "!106 = !DIDerivedType(tag: DW_TAG_typedef, name: " + dq + "nova_value" + dq + ", baseType: !107)")
            ire_line(e, "!107 = !DIBasicType(name: " + dq + "i64" + dq + ", size: 64, encoding: DW_ATE_signed)")
            for dv in e.ire_dbg_vars
                ire_line(e, "!" + str(dv[0]) + " = !DILocalVariable(name: " + dq + dv[1] + dq + ", scope: !" + str(dv[2]) + ", file: !101, line: " + str(dv[3]) + ", type: !106)")
        ire_line(e, "")

    // Emit TBAA and loop metadata
    ire_line(e, "; TBAA metadata")
    ire_line(e, "!0 = !" + lb + "!" + dq + "NOVA TBAA" + dq + rb)
    ire_line(e, "!1 = !" + lb + "!" + dq + "list_data_ptr" + dq + ", !0" + rb)
    ire_line(e, "!2 = !" + lb + "!1, !1, i64 0" + rb)
    ire_line(e, "!3 = !" + lb + "!" + dq + "list_elem" + dq + ", !0" + rb)
    ire_line(e, "!4 = !" + lb + "!3, !3, i64 0" + rb)
    ire_line(e, "!5 = !" + lb + "!" + dq + "list_size" + dq + ", !0" + rb)
    ire_line(e, "!6 = !" + lb + "!5, !5, i64 0" + rb)
    ire_line(e, "!90 = !" + lb + "!" + dq + "branch_weights" + dq + ", i32 2000, i32 1" + rb)
    // Loop metadata removed: !llvm.loop.unroll.enable caused 693x unrolling,
    // producing 2.1MB assembly vs 7.8KB without hints. LLVM default heuristics
    // produce identical is_prime assembly and correct loop optimization.
    ire_line(e, "")

    join(e.ire_out, "\n")

fn compile_ir(source: string) -> string
    compile_ir_core(source, "")

// ── Entry Point ──────────────────────────────────────────────────────────────

fn path_dir(path: string) -> string
    let last_sep = -1
    let i = 0
    while i < len(path)
        if path[i] == "/" or path[i] == "\\"
            last_sep = i
        i = i + 1
    if last_sep < 0
        return ""
    slice(path, 0, last_sep + 1)

fn resolve_module_file(name: string, base_dir: string) -> string
    let candidate = base_dir + name + ".nova"
    let content = read_file(candidate)
    if len(content) > 0
        return candidate
    candidate = name + ".nova"
    content = read_file(candidate)
    if len(content) > 0
        return candidate
    candidate = path_join(path_join("nova_packages", name), name + ".nova")
    content = read_file(candidate)
    if len(content) > 0
        return candidate
    candidate = path_join("nova_packages", name + ".nova")
    content = read_file(candidate)
    if len(content) > 0
        return candidate
    // Toolchain stdlib search path: $NOVA_HOME/lib/<name>.nova. An installed framework (forge,
    // and future bundled libraries) resolves from ANY working directory, so a `nova new`
    // project created anywhere on disk can `import forge` with no local copy. Tried LAST, so a
    // local or vendored module always wins -- existing imports resolve exactly as before; this
    // is a pure additive fallback.
    let nova_home = env("NOVA_HOME")
    if len(nova_home) > 0
        // NOVA STANDARD LIBRARY (LOCK-1): `import std/<category>/<name>` -> $NOVA_HOME/std/<category>/<name>.nova.
        // The std/ tree is bundled with the toolchain (synced like forge/ -> lib/) so any project resolves it
        // from any directory. Path segments use '/'. Tried before lib/ so a std/ path always wins for its name.
        candidate = nova_home + "/" + name + ".nova"
        content = read_file(candidate)
        if len(content) > 0
            return candidate
        candidate = path_join(path_join(nova_home, "lib"), name + ".nova")
        content = read_file(candidate)
        if len(content) > 0
            return candidate
    // Install-relative discovery: mirror nova_find_runtime()'s exe-relative pattern so
    // `import std/core/str` and `import forge` resolve from ANY working directory with no
    // NOVA_HOME required. gen3_test.exe sits in test_programs/; std/ and lib/ are siblings
    // at parent level (nova-compiler/std/, nova-compiler/lib/). An installed nova.exe has
    // std/ and lib/ as direct siblings.
    let exe = self_exe_path()
    if len(exe) > 0
        let exe_dir = path_parent(exe)
        candidate = path_join(path_parent(exe_dir), name + ".nova")
        content = read_file(candidate)
        if len(content) > 0
            return candidate
        candidate = path_join(path_join(path_parent(exe_dir), "lib"), name + ".nova")
        content = read_file(candidate)
        if len(content) > 0
            return candidate
        candidate = path_join(exe_dir, name + ".nova")
        content = read_file(candidate)
        if len(content) > 0
            return candidate
        candidate = path_join(path_join(exe_dir, "lib"), name + ".nova")
        content = read_file(candidate)
        if len(content) > 0
            return candidate
    return ""

fn compile_module_ir(b: IrBuilder, mod_source: string, mod_name: string, visited: dict, mod_base_dir: string) -> list
    let tokens = tokenize(mod_source)
    let _mpe = []
    let stmts = parse_program(tokens, _mpe)
    let transitive_fns = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "import"
                    let sub_mod = name
                    let sub_alias = sub_mod
                    if len(annotations) > 0
                        sub_alias = annotations[0]
                    if not contains(visited, sub_mod)
                        visited[sub_mod] = sub_alias
                        let sub_path = resolve_module_file(sub_mod, mod_base_dir)
                        if sub_path != ""
                            let sub_source = read_file(sub_path)
                            let sub_dir = path_dir(sub_path)
                            let sub_fns = compile_module_ir(b, sub_source, sub_alias, visited, sub_dir)
                            for sf in sub_fns
                                push(transitive_fns, sf)
                        else
                            if not contains(visited, sub_mod)
                                visited[sub_mod] = sub_alias
    // Every identifier referenced from inside this module's own FUNCTION bodies. A top-level
    // `let`/`const` is baked (below) only if it appears here -- see the gate note in the "assign"
    // branch for why baking an unreferenced name corrupts importers' lambda captures.
    let _mod_fn_refs = []
    for _mfs in stmts
        match _mfs
            Stmt(_ftag, _fname, _fexpr, _fbody, _fparams, _feb, _fann, _fsl) =>
                if _ftag == "fn"
                    collect_free_vars_stmt(_mfs, [], _mod_fn_refs)
    let mod_fns = []
    let exported = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "fn" and name != "main"
                    // An imported module's main() is its standalone-run/self-test entry, NOT the program
                    // entry -- skip it on import (else it lowers to nova_user_main and collides with the
                    // importer's main). Lets every module be BOTH importable AND `nova run`-nable.
                    push(mod_fns, s)
                    push(b.ir_fnames, name)
                    b.ir_fn_arity[name] = len(params)
                    b.ir_fn_defaults[name] = params
                    // ── Register an imported module's METHODS, exactly as the main module does (~24714).
                    // Its absence here is the root cause of the long-standing `@nova_rt_sql` LINK
                    // failures. `fn OrmQuery.sql()` lowers to the flat name `OrmQuery__sql`; the main
                    // module records suffix -> mangled name in ir_methods so that a call `q.sql()` still
                    // resolves when the inferrer cannot pin `q` down to OrmQuery. For an IMPORTED module
                    // that registration never happened, so the dot-call fell past every resolution branch
                    // to resolve_method_fn's catch-all, which fabricates `@nova_rt_sql` -- a symbol that
                    // does not exist. The failure therefore surfaced at LINK, never at type-check, and
                    // only for receivers the inferrer could not type (a directly-constructed OrmQuery
                    // worked fine, which is why it looked ORM-specific rather than structural).
                    // Same omission class as the module-level let/const gap fixed in b37f501d: this
                    // function performs a SUBSET of the registrations the main-module path performs.
                    // COLLISION-SAFE, unlike the main-module path: `ir_methods` is keyed by the
                    // BARE suffix, so two types each defining `.size()` would make one silently win
                    // and a call on the other receiver would jump into the WRONG type's method --
                    // type confusion, i.e. a crash or silent corruption rather than a link error.
                    // The main module accepts that risk for its own handful of methods; registering
                    // EVERY imported module's methods widens it across the whole dependency graph,
                    // so an ambiguous suffix is DROPPED here instead of guessed. A dropped suffix
                    // simply falls through to the pre-existing resolution paths -- exactly today's
                    // behaviour -- so this can only ever be as good as before, never worse.
                    let mod_dunder = find(name, "__")
                    if mod_dunder > 0
                        let mod_msuffix = name[mod_dunder + 2:999999999]
                        if contains(b.ir_methods, mod_msuffix)
                            if b.ir_methods[mod_msuffix] != name
                                b.ir_methods_ambig[mod_msuffix] = 1
                        if not contains(b.ir_methods_ambig, mod_msuffix)
                            b.ir_methods[mod_msuffix] = name
                    // TRACK-A: register the imported fn's RETURN type (mirrors the main module at
                    // ~16008) so an unannotated `let x = mod.fn()` resolves x's struct type via
                    // ir_expr_struct_type -> ir_fn_returns, and field access uses the PER-STRUCT
                    // slot. Without this, x was untyped and x.field fell back to the GLOBAL
                    // name->slot map (last-registered wins) -> wrong slot when two modules' structs
                    // share a field name.
                    match expr
                        Expr(rtt, rtv, rtn, rtc, rtf, rtl) =>
                            if rtt == "rettype" and rtv != ""
                                let rt_base = rtv
                                // `byval:T` is a CALLING CONVENTION marker, not part of the type --
                                // at NOVA level the function returns a T. Leaving the prefix on made
                                // every field access on the result miss, because ir_fn_returns is
                                // what tells the builder the result is a struct at all.
                                if len(rt_base) > 6 and rt_base[0:6] == "byval:"
                                    rt_base = slice(rt_base, 6, len(rt_base))
                                let rt_lt = find(rt_base, "<")
                                if rt_lt > 0
                                    rt_base = slice(rt_base, 0, rt_lt)
                                b.ir_fn_returns[name] = rt_base
                                if rt_base == "list" and rt_lt > 0
                                    let _rle = slice(rtv, rt_lt + 1, len(rtv) - 1)
                                    if contains(b.ir_sdefs, _rle)
                                        b.ir_fn_ret_list_elem[name] = _rle
                    if len(name) > 0 and name[0] != "_"
                        push(exported, name)
                else if tag == "extern_fn"
                    // Modular FFI: register an IMPORTED module's extern declarations into the
                    // same builder state the same-file path uses (15854-15892), so a wrapper
                    // body in the imported module resolves its extern call to `call @name`
                    // (not a stray %slot) + emits the declare + the right marshaling. @opaque
                    // types are registered in the type case below; source order (types before
                    // externs, the convention) makes them visible here.
                    push(b.ir_externs, s)
                    push(b.ir_fnames, name)
                    b.ir_fn_arity[name] = len(params)
                    let out_idxs = []
                    let opi = 0
                    for ep0 in params
                        match ep0
                            Param(epn0, ept0, epd0) =>
                                if len(ept0) > 4 and ept0[0:4] == "out:"
                                    push(out_idxs, opi)
                        opi = opi + 1
                    if len(out_idxs) > 0
                        b.ir_extern_out_idx[name] = out_idxs
                    let ext_ret_ll = "i64"
                    match expr
                        Expr(rxt, rxv, rxn, rxc, rxf, rxl) =>
                            if rxt == "rettype"
                                ext_ret_ll = ffi_llvm_type(rxv)
                                if contains(b.ir_opaque_types, rxv) or contains(b.ir_repr_c_types, rxv)
                                    ext_ret_ll = "ptr"
                                // A by-value RETURN needs the wrapper on its own: the wrapper is
                                // what allocates the NOVA struct the result is materialised into.
                                // Without this an extern with no struct PARAMS (abi_r_i1(int)) was
                                // called directly and the call site's nova_ffi_ name had no
                                // definition.
                                if _abi_byval_type(rxv) != ""
                                    ext_ret_ll = "byval"
                    let ext_needs = ext_ret_ll != "i64"
                    if not ext_needs
                        for ep in params
                            match ep
                                Param(epn, ept, epd) =>
                                    let ep_ll = ffi_llvm_type(ept)
                                    if contains(b.ir_opaque_types, ept) or contains(b.ir_repr_c_types, ept)
                                        ep_ll = "ptr"
                                    if _abi_byval_type(ept) != ""
                                        ep_ll = "byval"
                                    if ep_ll != "i64"
                                        ext_needs = true
                    if ext_needs
                        b.ir_ffi_wrapped[name] = 1
                else if tag == "type"
                    // Register @opaque / @repr(C) annotations (mirrors 15899-15916) so imported
                    // FFI handle types lower as ptr at the C boundary.
                    for ann in annotations
                        match ann
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann" and av == "opaque"
                                    b.ir_opaque_types[name] = 1
                                if at == "ann_with_arg" and av == "repr" and len(ac) > 0
                                    match ac[0]
                                        Expr(stg, sav, sn2, sac2, saf2, sal2) =>
                                            if stg == "str" and sav == "C"
                                                b.ir_repr_c_types[name] = 1
                                            if stg == "str" and sav == "packed"
                                                b.ir_repr_c_types[name] = 1
                                                b.ir_repr_packed[name] = 1
                    b.ir_sdefs[name] = params
                    let fi = 1
                    let _fm_isc = contains(b.ir_repr_c_types, name)
                    for p in params
                        match p
                            Param(pname, ptype, pdefault) =>
                                if _fm_isc
                                    b.ir_fmap_reprc[pname] = 1
                                if contains(b.ir_fmap, pname) and b.ir_fmap[pname] != fi
                                    b.ir_fmap_collision[pname] = 1
                                b.ir_fmap[pname] = fi
                                b.ir_field_types[name + "." + pname] = ptype
                        fi = fi + 1
                else if tag == "enum"
                    for variant in body
                        match variant
                            Stmt(vtag, vname, vexpr, vbody, vparams, velse, vann, vln) =>
                                if vtag == "type"
                                    b.ir_sdefs[vname] = vparams
                                    let vfi = 1
                                    for vp in vparams
                                        match vp
                                            Param(vpname, vptype, vpdefault) =>
                                                if contains(b.ir_fmap, vpname) and b.ir_fmap[vpname] != vfi
                                                    b.ir_fmap_collision[vpname] = 1
                                                b.ir_fmap[vpname] = vfi
                                                b.ir_field_types[vname + "." + vpname] = vptype
                                        vfi = vfi + 1
                else if tag == "const"
                    // An imported module's top-level `const X = [...]` had NO branch in this loop
                    // at all, so it was never baked into the const store. Every reference to it
                    // inside that module's own functions then fell back to a zero-initialized
                    // local slot -- i.e. SILENTLY an empty collection, with no error. Mirrors the
                    // main-module path (~24810). `stmts` is this module's own statement list, so
                    // the const fold resolves in the right scope.
                    // Gated on _mod_fn_refs (see below) for the same anti-pollution reason.
                    let _mcfe = ce_try_fold_const(expr, stmts)
                    if list_contains(_mod_fn_refs, name)
                        b.ir_consts[name] = _mcfe
                        if ir_const_bakeable(_mcfe) == 1
                            if not contains(b.ir_const_baked, name)
                                b.ir_const_baked[name] = len(b.ir_const_build_order)
                                push(b.ir_const_build_order, [name, _mcfe])
                else if tag == "assign" and name != "" and _is_module_state_init(expr) == 1
                    // Same hole for a top-level `let X = [...]` / `{...}` / `channel()` -- module
                    // STATE. Baking it is what makes every function in the module reach the ONE
                    // shared instance: a counter box `let BX = [0]` must be shared, or a write
                    // `BX[0] = v` lands in a per-function zero copy and is silently dropped. This
                    // was breaking shipped code -- forge's set_max_body() was a no-op.
                    //
                    // ── GATED ON _mod_fn_refs, AND THAT GATE IS LOAD-BEARING ──────────────────
                    // Baking inserts `name` into b.ir_const_baked, which is a FLAT, PROGRAM-WIDE
                    // map -- and filter_captures (12332) uses it to DROP a name from a lambda's
                    // capture list on the grounds that a baked const is reachable globally. So
                    // baking a name the module does not actually need makes every IMPORTER with a
                    // same-named LOCAL silently lose that local from its lambda captures, and the
                    // lambda then reads the imported module's value instead. Measured, not
                    // theorized: baking ungated broke _coro_test, whose function-local `sbox` /
                    // `fbox` / `abox` collided with top-level names in std/util/coro.nova's own
                    // TEST section -- two generators silently shared one state box.
                    // Restricting to names the module's own FUNCTIONS reference keeps genuine
                    // module state working (that is the whole point) while leaving a module's
                    // top-level test scaffolding out of every importer's namespace.
                    // FIRST DEFINITION WINS on a name clash, matching the main-module guard.
                    if list_contains(_mod_fn_refs, name)
                        if not contains(b.ir_const_baked, name)
                            b.ir_const_baked[name] = len(b.ir_const_build_order)
                            push(b.ir_const_build_order, [name, expr])
    let ir_fns = []
    for fn_stmt in mod_fns
        let ir_fn = ir_lower_function(b, fn_stmt)
        push(ir_fns, ir_fn)
    for lam_fn in b.ir_lambdas
        push(ir_fns, lam_fn)
    b.ir_lambdas = []
    b.ir_modules[mod_name] = exported
    for tf in transitive_fns
        push(ir_fns, tf)
    ir_fns

fn resolve_and_compile_imports(b: IrBuilder, stmts: list, base_dir: string) -> list
    let all_ir_fns = []
    let visited = {}
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                if tag == "import"
                    let mod_name = name
                    let alias = mod_name
                    if len(annotations) > 0
                        alias = annotations[0]
                    if not contains(visited, mod_name)
                        visited[mod_name] = alias
                        let mod_path = resolve_module_file(mod_name, base_dir)
                        if mod_path == ""
                            print("error: cannot find module '" + mod_name + "'")
                            exit(1)
                        let mod_source = read_file(mod_path)
                        let mod_dir = path_dir(mod_path)
                        let mod_fns = compile_module_ir(b, mod_source, alias, visited, mod_dir)
                        for mf in mod_fns
                            push(all_ir_fns, mf)
                    else
                        let first_alias = visited[mod_name]
                        if contains(b.ir_modules, first_alias) and alias != first_alias
                            b.ir_modules[alias] = b.ir_modules[first_alias]
    all_ir_fns

fn nova_replace_ext(path: string, old_ext: string, new_ext: string) -> string
    if ends_with(path, old_ext)
        return slice(path, 0, len(path) - len(old_ext)) + new_ext
    return path + new_ext

// Newest mtime across `path` and every module it transitively imports.
//
// The incremental-build check needs to know "is the cached output older than ANY of
// its inputs", and the entry file is only one input. Scanning is LEXICAL, not a parse:
// this runs before parsing on purpose (skipping the parse is the point of the cache),
// and `import <name>` at the start of a line is enough to find the file set.
//
// FAILS SAFE. Returns 0 if the entry file has no readable mtime, or if any import
// cannot be resolved to a file — and the caller treats 0 as "cache not usable", so an
// unknown dependency forces a rebuild instead of trusting a stale artifact. Being
// wrong here costs a recompile; being wrong the other way silently runs old code.
//
// `seen` guards against import cycles and re-walking a diamond dependency.
fn nova_newest_source_mtime_rec(path: string, seen: dict) -> int
    if contains(seen, path)
        return 0
    seen[path] = 1
    let mt = build_file_mtime(path)
    if mt <= 0
        return 0
    let src = read_file(path)
    if len(src) == 0
        return mt
    let dir = path_dir(path)
    let newest = mt
    for line in split(src, "\n")
        let t = trim(line)
        if starts_with(t, "import ")
            // `import name` / `import name as alias` -- the module name is the first token.
            let rest = trim(slice(t, 7, len(t)))
            let mod_name = rest
            let sp = find(rest, " ")
            if sp > 0
                mod_name = trim(slice(rest, 0, sp))
            if len(mod_name) > 0
                let dep = resolve_module_file(mod_name, dir)
                if dep == ""
                    // Unresolvable here (alias/edge case): do NOT claim freshness.
                    return 0
                let dep_mt = nova_newest_source_mtime_rec(dep, seen)
                if dep_mt == 0
                    return 0
                if dep_mt > newest
                    newest = dep_mt
    newest

fn nova_newest_source_mtime(path: string) -> int
    nova_newest_source_mtime_rec(path, {})

fn nova_compile_file(input_path: string, output_path: string, use_ir: int, target: string) -> string
    if not file_exists(input_path)
        print("error: cannot read '" + input_path + "': file not found")
        exit(1)
    // Incremental compilation: if the output .ll exists and is newer than every
    // source that feeds it, skip the compile. Honors NOVA_NO_CACHE=1 to force
    // a rebuild (useful when nova_compiler itself or the runtime changed).
    //
    // ⚠ THE ENTRY FILE IS NOT THE ONLY INPUT. This compared ONLY the entry file's
    // mtime, so editing an IMPORTED module while the entry file stayed untouched
    // left the cache "valid" and served a STALE build — silently, with no warning.
    // Reproduced: app.nova imports helper.nova; change helper's return 41 -> 99 ->
    // 777 and `nova run app.nova` keeps printing the previous value. That hits every
    // multi-file project, which is to say every real one: edit a library module, run
    // your app, get the old behaviour and no indication why.
    //
    // Fix: compare against the NEWEST mtime across the entry file and its transitive
    // imports. The dependency scan is lexical (`import <name>` lines) rather than a
    // parse — the whole point of this check is to run BEFORE parsing, and a scan is
    // enough to find the file set. It fails SAFE: an import that cannot be resolved
    // makes the scan return 0, which forces a rebuild rather than trusting the cache.
    if file_exists(output_path) and env("NOVA_NO_CACHE") != "1" and env("NOVA_COV") != "1"
        let in_mt = nova_newest_source_mtime(input_path)
        let out_mt = build_file_mtime(output_path)
        if in_mt > 0 and out_mt >= in_mt
            return output_path
    let source = read_file(input_path)
    let base_dir = path_dir(input_path)
    nova_check_version_compat(base_dir)
    let llvm_ir = if use_ir == 1
        compile_ir_core_named(source, base_dir, input_path, target)
    else
        compile(source)
    write_file(output_path, llvm_ir)
    return output_path

// nova check — fast pre-flight: parse + type-check only, no IR generation.
// Returns the number of errors. Useful for IDEs and CI that just want to
// know "is this file valid NOVA?" without paying for codegen + link.
fn nova_check_file(path: string) -> int
    if not file_exists(path)
        print("error: cannot read '" + path + "': file not found")
        return 1
    let source = read_file(path)
    let tokens = tokenize_file(source, path)
    let parse_errors = []
    let stmts = parse_program(tokens, parse_errors)
    if len(parse_errors) > 0
        for perr in parse_errors
            print(perr)
        print(path + ": parse failed (" + str(len(parse_errors)) + " error(s))")
        return len(parse_errors)
    let source_lines = split(source, "\n")
    let ti_state = ti_infer_program_named(stmts, source_lines, path)
    // Non-fatal diagnostics print regardless of error outcome and never affect the return code.
    if len(ti_state.ti_warnings) > 0
        for wterr in ti_state.ti_warnings
            print(wterr)
    if len(ti_state.ti_errors) > 0
        for terr in ti_state.ti_errors
            print(terr)
        print(path + ": type-check failed (" + str(len(ti_state.ti_errors)) + " error(s))")
        return len(ti_state.ti_errors)
    print(path + ": ok")
    return 0

fn nova_find_runtime() -> string
    // Honor explicit overrides first so users in arbitrary cwds can build:
    //   NOVA_RUNTIME=/full/path/to/nova_runtime.c     ← exact file
    //   NOVA_HOME=/install/dir                        ← we append /output/nova_runtime.c
    let env_rt = env("NOVA_RUNTIME")
    if len(env_rt) > 0 and len(read_file(env_rt)) > 100
        return env_rt
    let nh = env("NOVA_HOME")
    if len(nh) > 0
        // CANONICAL FIRST. The runtime moved to compiler/ (nova_compiler.nova's sibling), but
        // pre-move copies still sit at NOVA_HOME/nova_runtime.c and NOVA_HOME/output/. Probing
        // those first let a STALE leftover shadow the live runtime: the REPL gate linked the old
        // flat copy and died on `undefined symbol: nova_rt_rc_drop_temp` -- a symbol the live
        // runtime has had since Wave-B #6. Ordering by canonical-ness makes a leftover harmless
        // instead of silently authoritative.
        let cand4 = path_join(nh, "compiler/nova_runtime.c")
        if len(read_file(cand4)) > 100
            return cand4
        let cand3 = path_join(nh, "test_programs/compiler/nova_runtime.c")
        if len(read_file(cand3)) > 100
            return cand3
        let cand = path_join(nh, "output/nova_runtime.c")
        if len(read_file(cand)) > 100
            return cand
        let cand2 = path_join(nh, "nova_runtime.c")
        if len(read_file(cand2)) > 100
            return cand2
    // Install-relative discovery: the runtime ships alongside the nova executable, so this works
    // from ANY cwd with NO env var -- the first-download experience (`nova run` in a fresh project).
    // gen3_test.exe / nova.exe sits next to output/nova_runtime.c (and a flat nova_runtime.c on install).
    let exe = self_exe_path()
    if len(exe) > 0
        let exe_dir = path_parent(exe)
        let e0 = path_join(exe_dir, "compiler/nova_runtime.c")
        if len(read_file(e0)) > 100
            return e0
        // gen3_test.exe sits in test_programs/, its sibling compiler/ holds the runtime (../compiler/)
        let e0b = path_join(path_parent(exe_dir), "compiler/nova_runtime.c")
        if len(read_file(e0b)) > 100
            return e0b
        let e1 = path_join(exe_dir, "output/nova_runtime.c")
        if len(read_file(e1)) > 100
            return e1
        let e2 = path_join(exe_dir, "nova_runtime.c")
        if len(read_file(e2)) > 100
            return e2
    let candidates = ["compiler/nova_runtime.c", "../compiler/nova_runtime.c", "test_programs/compiler/nova_runtime.c", "output/nova_runtime.c", "test_programs/output/nova_runtime.c", "nova_runtime.c"]
    for c in candidates
        let content = read_file(c)
        if contains(content, "nova_rt_system")
            return c
    for c in candidates
        let content = read_file(c)
        if len(content) > 100
            return c
    return "nova_runtime.c"

fn _clang_exe_name() -> string
    if os_name() == "windows"
        return "clang.exe"
    return "clang"

// Locate the clang binary NOVA should invoke for every codegen/linking step. Mirrors
// nova_find_runtime()'s resolution order, adapted for a binary (not a text source file):
// NOVA_CLANG exact path -> NOVA_HOME-relative bundled toolchain -> install-relative
// (self_exe_path()) bundled toolchain -> cwd-relative -> PATH via which(). The bundled
// toolchain path is deliberately UNVERSIONED here: only the installer deals with
// versions (staging a download, then updating the stable toolchains/clang/ this function
// actually probes), so a version bump never requires touching this lookup.
fn nova_find_clang() -> string
    let exe_name = _clang_exe_name()
    let env_clang = env("NOVA_CLANG")
    if len(env_clang) > 0 and path_exists(env_clang) == 1
        return env_clang
    let nh = env("NOVA_HOME")
    if len(nh) > 0
        let cand = path_join(nh, "toolchains/clang/bin/" + exe_name)
        if path_exists(cand) == 1
            return cand
    let exe = self_exe_path()
    if len(exe) > 0
        let exe_dir = path_parent(exe)
        let e0 = path_join(exe_dir, "toolchains/clang/bin/" + exe_name)
        if path_exists(e0) == 1
            return e0
        let e0b = path_join(path_parent(exe_dir), "toolchains/clang/bin/" + exe_name)
        if path_exists(e0b) == 1
            return e0b
    let cwd_cand = path_join("toolchains/clang/bin", exe_name)
    if path_exists(cwd_cand) == 1
        return cwd_cand
    let on_path = which("clang")
    if len(on_path) > 0
        return on_path
    print("warning: no clang found (checked NOVA_CLANG, NOVA_HOME/toolchains/clang/bin, install-relative toolchains/clang/bin, ./toolchains/clang/bin, and PATH). Run `nova toolchain status` for details, or install clang and put it on PATH.")
    return "clang"

// Locate the single-source-of-truth VERSION file (repo root's nova-compiler/VERSION, or its
// installed sibling next to the nova binary). Mirrors nova_find_runtime()'s resolution so a
// release bump never requires touching this lookup or hunting for hardcoded literals -- only
// the VERSION file itself changes.
fn nova_find_version() -> string
    let nh = env("NOVA_HOME")
    if len(nh) > 0
        let cand = path_join(nh, "VERSION")
        if path_exists(cand) == 1
            return trim(read_file(cand))
    let exe = self_exe_path()
    if len(exe) > 0
        let exe_dir = path_parent(exe)
        let e0 = path_join(exe_dir, "VERSION")
        if path_exists(e0) == 1
            return trim(read_file(e0))
        let e0b = path_join(path_parent(exe_dir), "VERSION")
        if path_exists(e0b) == 1
            return trim(read_file(e0b))
    if path_exists("VERSION") == 1
        return trim(read_file("VERSION"))
    return "0.1.0"

// Locate the reusable JS-managed linear-memory runtime (_wasm_runtime.cjs) that
// provides nova_rt_* imports for wasm32 programs. Mirrors nova_find_runtime().
fn nova_find_wasm_runtime() -> string
    let nh = env("NOVA_HOME")
    if len(nh) > 0
        let cand = path_join(nh, "output/_wasm_runtime.cjs")
        if contains(read_file(cand), "createRuntime")
            return cand
        let cand2 = path_join(nh, "_wasm_runtime.cjs")
        if contains(read_file(cand2), "createRuntime")
            return cand2
    let candidates = ["output/_wasm_runtime.cjs", "test_programs/_wasm_runtime.cjs", "_wasm_runtime.cjs"]
    for c in candidates
        if contains(read_file(c), "createRuntime")
            return c
    return ""

// Reject paths containing shell-active characters before they are interpolated into a
// system() command line for @link_source/@link_object. Quoting alone is not safe across
// cmd.exe AND POSIX sh, so we refuse anything that could break out of the quotes or inject
// a command at build time. Legitimate C source/object paths use none of these.
fn _link_path_safe(p: string) -> bool
    if len(p) == 0
        return false
    let bad = ["\"", "'", "`", "$", ";", "|", "&", "<", ">", "(", ")", "*", "?", "^", "%", "!", "\{", "\}", "~", "#", "\n", "\r", "\t"]
    for c in bad
        if contains(p, c)
            return false
    // '[' and ']' are checked separately: as elements of a list literal they collide
    // with the literal's own delimiters, but they are equally shell-active (glob).
    if contains(p, "[") or contains(p, "]")
        return false
    return true

// Windows cmd.exe quirk: when a command begins with a quoted, space-containing path (e.g.
// the clang executable at "C:\Program Files\LLVM\bin\clang.exe") followed by more
// arguments, cmd.exe mis-parses it unless the ENTIRE command line is wrapped in one more
// outer pair of quotes. This is a real-world case, not a hypothetical: it is the default
// LLVM install location on Windows. POSIX sh has no such quirk. Every system()/exec() call
// that starts with a resolved (possibly space-containing) clang path must route through
// this before invocation.
fn _win_wrap_cmd(cmd: string) -> string
    if os_name() == "windows"
        return "\"" + cmd + "\""
    return cmd

fn nova_warmup_runtime() -> int
    let rt = nova_find_runtime()
    let rt_o = replace(rt, ".c", ".o")
    let c_mt = build_file_mtime(rt)
    let o_mt = build_file_mtime(rt_o)
    if o_mt >= 0 and c_mt <= o_mt
        return 0
    let clang = nova_find_clang()
    let cc = "\"" + clang + "\" -c -O2 -w -D_CRT_SECURE_NO_WARNINGS"
    // See the matching comment in nova_link()'s rt_cc: nova_runtime.c's __try/__except
    // (fiber stack-overflow containment) needs -fms-extensions to compile at all on
    // Windows, confirmed by direct testing against the bundled mingw toolchain.
    if os_name() == "windows"
        cc = cc + " -fms-extensions"
    cc = cc + " \"" + rt + "\" -o \"" + rt_o + "\""
    let ret = system(_win_wrap_cmd(cc))
    return ret

fn nova_link(ll_path: string, exe_path: string, opt_level: string, target: string) -> int
    let rt = nova_find_runtime()
    let clang = nova_find_clang()
    let resolved = resolve_target(target)
    let ll_content = read_file(ll_path)
    let ll_lines = split(ll_content, "\n")
    let extra_libs = ""
    let seen = {}
    let needs_ssl = 0
    let needs_sqlite = 0
    let link_srcs = []
    let link_objs = []
    for line in ll_lines
        let t = trim(line)
        if starts_with(t, "; LINK_LIB:")
            let libname = trim(slice(t, 11, len(t)))
            if libname == "m" or libname == "pthread" or libname == "dl" or libname == "rt"
                if target_is_windows(resolved) == 1
                    libname = ""
            if len(libname) > 0 and not contains(seen, libname)
                seen[libname] = 1
                extra_libs = extra_libs + " -l" + libname
        else if starts_with(t, "; LINK_SOURCE:")
            let sp = trim(slice(t, 14, len(t)))
            if len(sp) > 0 and not contains(link_srcs, sp)
                push(link_srcs, sp)
        else if starts_with(t, "; LINK_OBJECT:")
            let op = trim(slice(t, 14, len(t)))
            if len(op) > 0 and not contains(link_objs, op)
                push(link_objs, op)
        if contains(line, "call ") and (contains(line, "@nova_rt_tls_") or contains(line, "@nova_rt_http_get"))
            needs_ssl = 1
        if contains(line, "call ") and contains(line, "@sqlite3_")
            needs_sqlite = 1
    let rt_link = rt
    let is_cross = target != "" and target != "native" and target != "windows" and target != "win"
    let use_ssl_define = needs_ssl == 1 and target_is_windows(resolved) == 0
    if not is_cross and use_ssl_define == 0
        let rt_o = replace(rt, ".c", ".o")
        let c_mt = build_file_mtime(rt)
        let o_mt = build_file_mtime(rt_o)
        if o_mt < 0 or c_mt > o_mt
            let rt_cc = "\"" + clang + "\" -c -O2 -w -D_CRT_SECURE_NO_WARNINGS"
            if target_is_windows(resolved) == 1
                // nova_runtime.c uses __try/__except (SEH) to catch a fiber's hardware
                // stack overflow and contain it to that task instead of crashing the
                // whole process. clang only recognizes this MS-specific syntax with
                // -fms-extensions -- confirmed by direct testing against the bundled
                // mingw toolchain (fails with "use of undeclared identifier '__try'"
                // without it, compiles clean with it). Win64 SEH unwind tables are a
                // generic PE/ABI requirement, not an MSVC-only mechanism, so this is
                // safe/correct under the GNU/mingw target, not a hack.
                rt_cc = rt_cc + " -fms-extensions"
            rt_cc = rt_cc + " \"" + rt + "\" -o \"" + rt_o + "\""
            let rt_ret = system(_win_wrap_cmd(rt_cc))
            if rt_ret != 0
                rt_link = rt
            else
                rt_link = rt_o
        else
            rt_link = rt_o
    let cmd = "\"" + clang + "\" " + opt_level + " -w"
    if opt_level == "-O0"
        cmd = cmd + " -g"
    if is_cross
        cmd = cmd + " --target=" + resolved
    cmd = cmd + " \"" + ll_path + "\" \"" + rt_link + "\" -o \"" + exe_path + "\""
    if target_is_windows(resolved) == 1
        cmd = cmd + " -lws2_32 -lwinhttp -ladvapi32 -lbcrypt"
        // rt_link is nova_runtime.c ITSELF (not a prebuilt .o) whenever the cached-object
        // fast path above was skipped -- which is exactly the is_cross case, i.e. any
        // build that names an explicit --target. That means this command, not rt_cc,
        // is what compiles the __try/__except fiber-guard, so it needs -fms-extensions
        // too or every explicit-target Windows build fails where a plain `nova build`
        // succeeds. Harmless when rt_link is already an object: clang only warns about
        // an unused compile flag, and -w is already in effect.
        cmd = cmd + " -fms-extensions"
    else
        // nova_runtime.c ALWAYS references libm (sin/cos/tan/fmod/hypot/... back the
        // math builtins), and on Unix libm is a separate archive -- clang's driver does
        // not add -lm for C on its own. Without this, EVERY `nova build` on Linux dies
        // with "undefined symbol: sin / cos / fmod / ...". This went unnoticed because
        // Linux was only ever exercised through bootstrap_linux.sh, which passes
        // "-lpthread -ldl -lm" in its own hand-written clang command -- `nova build`
        // itself was never run there. (See the "Linux-only bugs are invisible" lesson:
        // the Windows gate cannot see this class of defect at all.)
        cmd = cmd + " -lm"
        // pthread/dl back the concurrency runtime and dynamic FFI loading. Both are
        // Linux-specific spellings: on macOS the pthread and dlopen families live in
        // libSystem, there is no libdl.dylib at all, and `-ldl` is a hard "library not
        // found" link error -- so this must NOT be widened to all non-Windows targets.
        if contains(resolved, "linux")
            cmd = cmd + " -lpthread -ldl"
    if use_ssl_define
        extra_libs = extra_libs + " -DNOVA_HAVE_OPENSSL -lssl -lcrypto"
    if needs_sqlite == 1
        let rt_dir = path_parent(rt)
        let sq_c = path_join(rt_dir, "sqlite3.c")
        let sq_o = path_join(rt_dir, "sqlite3.o")
        if len(read_file(sq_o)) < 100
            system(_win_wrap_cmd("\"" + clang + "\" -c -O2 -DSQLITE_THREADSAFE=0 \"" + sq_c + "\" -o \"" + sq_o + "\" -D_CRT_SECURE_NO_WARNINGS -w"))
        extra_libs = extra_libs + " \"" + sq_o + "\""
    // General FFI: @link_source("x.c") compiles each C source on demand into a cached
    // <src>.o (rebuilt only when the .o is missing or the source is newer -- correct
    // incremental caching, since a user's foo.c is edited unlike the frozen sqlite
    // amalgamation). @link_object("x.o") links a prebuilt object directly. Both paths come
    // from a user string literal interpolated into system(), so each is rejected unless it
    // is free of shell metacharacters (no build-time command injection) and exists.
    for sp in link_srcs
        if not _link_path_safe(sp)
            print("link error: @link_source path rejected (unsafe characters): " + sp)
            return 1
        let src_mt = build_file_mtime(sp)
        if src_mt < 0
            print("link error: @link_source file not found: " + sp)
            return 1
        let obj = sp + ".o"
        let obj_mt = build_file_mtime(obj)
        if obj_mt < 0 or src_mt > obj_mt
            let rc = system(_win_wrap_cmd("\"" + clang + "\" -c -O2 \"" + sp + "\" -o \"" + obj + "\" -D_CRT_SECURE_NO_WARNINGS -w"))
            if rc != 0
                print("link error: failed to compile @link_source: " + sp)
                return 1
        extra_libs = extra_libs + " \"" + obj + "\""
    for op in link_objs
        if not _link_path_safe(op)
            print("link error: @link_object path rejected (unsafe characters): " + op)
            return 1
        if build_file_mtime(op) < 0
            print("link error: @link_object file not found: " + op)
            return 1
        extra_libs = extra_libs + " \"" + op + "\""
    cmd = cmd + extra_libs + " -D_CRT_SECURE_NO_WARNINGS 2>&1"
    let ret = system(_win_wrap_cmd(cmd))
    return ret

// ── Package Manager ─────────────────────────────────────────────────────────

fn nova_toml_default(name: string) -> string
    let ver = nova_find_version()
    let content = "[package]\n"
    content = content + "name = \"" + name + "\"\n"
    content = content + "version = \"0.1.0\"\n"
    content = content + "nova-version = \"" + ver + "\"\n"
    content = content + "description = \"\"\n"
    content = content + "author = \"\"\n"
    content = content + "license = \"\"\n"
    content = content + "\n"
    content = content + "[dependencies]\n"
    content

fn _sv_cmp_triple(a_maj: int, a_min: int, a_pat: int, b_maj: int, b_min: int, b_pat: int) -> int
    if a_maj != b_maj
        return a_maj - b_maj
    if a_min != b_min
        return a_min - b_min
    a_pat - b_pat

fn _sv_parse_triple(s: string) -> list
    let parts = split(s, ".")
    let maj = 0
    let min = 0
    let pat = 0
    if len(parts) >= 1
        let v = parse_int(parts[0])
        if v >= 0
            maj = v
    if len(parts) >= 2
        let v2 = parse_int(parts[1])
        if v2 >= 0
            min = v2
    if len(parts) >= 3
        let core = parts[2]
        let dash = find(core, "-")
        if dash > 0
            core = slice(core, 0, dash)
        let v3 = parse_int(core)
        if v3 >= 0
            pat = v3
    [maj, min, pat]

fn nova_check_version_compat(input_dir: string)
    let toml_path = path_join(input_dir, "nova.toml")
    let toml = read_file(toml_path)
    if len(toml) == 0
        return 0
    let required = nova_toml_scalar(toml, "nova-version")
    if len(required) == 0
        return 0
    let compiler_ver = nova_find_version()
    let req = _sv_parse_triple(required)
    let cur = _sv_parse_triple(compiler_ver)
    let cmp = _sv_cmp_triple(cur[0], cur[1], cur[2], req[0], req[1], req[2])
    if cmp < 0
        print("warning: nova.toml requires nova-version " + required + " but this compiler is " + compiler_ver)
        print("  upgrade your NOVA toolchain or adjust nova-version in " + toml_path)

fn nova_pkg_init()
    let existing = read_file("nova.toml")
    if len(existing) > 0
        print("nova.toml already exists")
        return 0
    let content = nova_toml_default("my-project")
    write_file("nova.toml", content)
    print("Created nova.toml")

// ── `nova new` Forge scaffolder ───────────────────────────────────────────────
// Generates a working, compilable Forge project so the FIRST thing a developer who downloads
// NOVA builds is a real app (CLAUDE.md's defining promise). `import forge` resolves from the
// bundled toolchain stdlib ($NOVA_HOME/lib), so the generated project needs no package install.
fn nn_sub(s: string, from: string, to: string) -> string
    let parts = split(s, from)
    let out = ""
    let i = 0
    while i < len(parts)
        if i > 0
            out = out + to
        out = out + parts[i]
        i = i + 1
    out

fn nn_write(dir: string, rel: string, content: string)
    let full = dir + "/" + rel
    let last = -1
    let i = 0
    while i < len(full)
        if full[i] == "/"
            last = i
        i = i + 1
    if last >= 0
        mkdir_p(slice(full, 0, last))
    write_file(full, content)
    print("  + " + rel)

fn nn_api_main() -> string
    ```
    // A NOVA REST API built with Forge. Handlers return a domain value -- a struct, a list, or a
    // Response -- and Forge produces the right JSON automatically ("return your type"). Run with
    // --check to dispatch one request through the full pipeline (no socket) for CI/containers.
    import forge

    type Todo
        id: int
        title: string
        done: bool

    type Health
        status: string
        service: string

    fn seed() -> list
        [Todo(1, "Learn NOVA", true), Todo(2, "Build with Forge", false)]

    fn health(req: Request) -> Health
        Health("ok", "api")

    fn list_todos(req: Request) -> list
        seed()

    fn get_todo(req: Request) -> Response
        let id = req.params["id"]
        for t in seed()
            if str(t.id) == id
                return forge.resp_json(200, t)
        forge.resp_json(404, Health("not found", "api"))

    // POST a JSON body -> a typed Todo, rebuilt by field name -> 201. Inbound "return your type".
    fn create_todo(req: Request) -> Response
        let t: Todo = from_json(req.body)
        forge.resp_json(201, t)

    fn build_app()
        let a = forge.app()
        forge.use(a, forge.mw_log())
        forge.use(a, forge.mw_cors_origin("*"))
        forge.get(a, "/health", health)
        forge.get(a, "/todos", list_todos)
        forge.get(a, "/todos/:id", get_todo)
        forge.post(a, "/todos", create_todo)
        a

    fn _port() -> int
        let pe = env("PORT")
        if len(pe) > 0
            return parse_int(pe)
        8080

    fn main()
        let a = build_app()
        let av = args()
        if len(av) > 1 and av[1] == "--check"
            let r: Response = forge.dispatch_req(a, forge.build_request("GET /health HTTP/1.1\r\n\r\n", 0))
            print("selfcheck status=" + str(r.status))
            if r.status >= 400
                exit(1)
            return
        let p = _port()
        print("api listening on http://localhost:" + str(p))
        forge.serve_req(a, p)
    ```

fn nn_micro_main() -> string
    ```
    // A minimal NOVA microservice. Each request is handled in a MONITORED process: a handler
    // panic becomes a 500 and the server lives on ("let it crash", at native AOT speed).
    import forge

    type Status
        status: string

    type Echo
        echo: string

    fn health(req: Request) -> Status
        Status("ok")

    fn ready(req: Request) -> Status
        Status("ready")

    fn echo(req: Request) -> Echo
        Echo(req.body)

    fn build_app()
        let a = forge.app()
        forge.use(a, forge.mw_log())
        forge.get(a, "/health", health)
        forge.get(a, "/ready", ready)
        forge.post(a, "/echo", echo)
        a

    fn _port() -> int
        let pe = env("PORT")
        if len(pe) > 0
            return parse_int(pe)
        8081

    fn main()
        let a = build_app()
        let av = args()
        if len(av) > 1 and av[1] == "--check"
            let r: Response = forge.dispatch_req(a, forge.build_request("GET /health HTTP/1.1\r\n\r\n", 0))
            print("selfcheck status=" + str(r.status))
            if r.status >= 400
                exit(1)
            return
        let p = _port()
        print("microservice listening on http://localhost:" + str(p) + " (crash-isolated)")
        forge.serve_safe_req(a, p)
    ```

fn nn_frontend_main() -> string
    ```
    // A NOVA static frontend. Assets in public/ are served traversal-safe (no .., no dotfiles,
    // no path can escape the mount). One binary serves your SPA.
    import forge

    fn build_app()
        let a = forge.app()
        forge.static(a, "/", "public")
        a

    fn _port() -> int
        let pe = env("PORT")
        if len(pe) > 0
            return parse_int(pe)
        8080

    fn main()
        let a = build_app()
        let av = args()
        if len(av) > 1 and av[1] == "--check"
            let r: Response = forge.dispatch_req(a, forge.build_request("GET / HTTP/1.1\r\n\r\n", 0))
            print("selfcheck status=" + str(r.status))
            if r.status >= 400
                exit(1)
            return
        let p = _port()
        print("frontend on http://localhost:" + str(p))
        forge.serve_req(a, p)
    ```

fn nn_fullstack_main() -> string
    ```
    // A NOVA full-stack app: a JSON API under /api AND a static frontend, in ONE binary, one
    // run. Backend + frontend, one language, no glue -- the NOVA identity use case.
    import forge

    type Todo
        id: int
        title: string
        done: bool

    type Health
        status: string

    fn seed() -> list
        [Todo(1, "Learn NOVA", true), Todo(2, "Ship with Forge", false)]

    fn api_todos(req: Request) -> list
        seed()

    fn api_health(req: Request) -> Health
        Health("ok")

    fn build_app()
        let a = forge.app()
        forge.use(a, forge.mw_log())
        let api = forge.group(a, "/api")
        forge.get(api, "/todos", api_todos)
        forge.get(api, "/health", api_health)
        // Explicit /api routes win; everything else is served from public/.
        forge.static(a, "/", "public")
        a

    fn _port() -> int
        let pe = env("PORT")
        if len(pe) > 0
            return parse_int(pe)
        8080

    fn main()
        let a = build_app()
        let av = args()
        if len(av) > 1 and av[1] == "--check"
            let r: Response = forge.dispatch_req(a, forge.build_request("GET /api/todos HTTP/1.1\r\n\r\n", 0))
            print("selfcheck status=" + str(r.status))
            if r.status >= 400
                exit(1)
            return
        let p = _port()
        print("fullstack on http://localhost:" + str(p) + " (API at /api, frontend at /)")
        forge.serve_req(a, p)
    ```

fn nn_index_html(name: string) -> string
    let t = ```
    <!doctype html>
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>__APP__</title>
        <link rel="stylesheet" href="/style.css" />
      </head>
      <body>
        <main>
          <h1>__APP__</h1>
          <p>Served by NOVA Forge -- one binary, zero runtime dependencies.</p>
          <pre id="out">loading...</pre>
        </main>
        <script src="/app.js"></script>
      </body>
    </html>
    ```
    nn_sub(t, "__APP__", name)

fn nn_app_js() -> string
    ```
    fetch("/api/todos")
      .then(function (r) { return r.json(); })
      .then(function (todos) {
        document.getElementById("out").textContent = JSON.stringify(todos, null, 2);
      })
      .catch(function () {
        document.getElementById("out").textContent = "static frontend ready";
      });
    ```

fn nn_style_css() -> string
    ```
    :root { color-scheme: light dark; }
    body { font-family: system-ui, sans-serif; margin: 0; display: grid; place-items: center; min-height: 100vh; }
    main { max-width: 40rem; padding: 2rem; }
    h1 { margin: 0 0 .5rem; }
    pre { background: rgba(127,127,127,.15); padding: 1rem; border-radius: .5rem; overflow: auto; }
    ```

fn nn_lib_module() -> string
    ```
    // A reusable NOVA library. `import <name>` from any project (vendored, or installed to
    // $NOVA_HOME/lib). Pure, fully type-inferred -- no annotations needed at the call site.
    fn add(a: int, b: int) -> int
        a + b

    fn scale(xs: list, k: int) -> list
        [x * k for x in xs]
    ```

fn nn_lib_test(name: string) -> string
    let t = ```
    import __APP__

    fn main()
        assert(__APP__.add(2, 3) == 5, "add")
        let s = __APP__.scale([1, 2, 3], 10)
        assert(s[1] == 20, "scale")
        print("__APP__ tests passed")
    ```
    nn_sub(t, "__APP__", name)

fn nn_gitignore() -> string
    "*.ll\n*.exe\n*.exp\n*.lib\nnova_packages/\n"

fn nn_readme(name: string, kind: string, run_hint: string) -> string
    let t = ```
    # __APP__

    A NOVA project (__KIND__) built with Forge. One language, one binary, zero runtime deps.

    ## Run

    __RUN__

    ## Build a single static binary

        nova build            # produces a native binary -- ship it anywhere, no deps

    forge is bundled in the NOVA toolchain, so `import forge` resolves with no package install.
    ```
    nn_sub(nn_sub(nn_sub(t, "__APP__", name), "__KIND__", kind), "__RUN__", run_hint)

// Generate a Forge project of the given kind. Returns 0 on success, 1 on a bad kind.
fn nn_new_project(kind: string, name: string) -> int
    if path_exists(name) == 1
        print("error: '" + name + "' already exists")
        exit(1)
    mkdir_p(name)
    write_file(path_join(name, "nova.toml"), nova_toml_default(name))
    nn_write(name, ".gitignore", nn_gitignore())
    print("Creating " + name + "/ (" + kind + ")")
    if kind == "api"
        nn_write(name, "src/main.nova", nn_api_main())
        nn_write(name, "README.md", nn_readme(name, "api", "    nova run            # serve on :8080  (PORT env overrides)"))
    else if kind == "microservice"
        nn_write(name, "src/main.nova", nn_micro_main())
        nn_write(name, "README.md", nn_readme(name, "microservice", "    nova run            # serve on :8081 (crash-isolated)"))
    else if kind == "frontend"
        nn_write(name, "src/main.nova", nn_frontend_main())
        nn_write(name, "public/index.html", nn_index_html(name))
        nn_write(name, "public/app.js", nn_app_js())
        nn_write(name, "public/style.css", nn_style_css())
        nn_write(name, "README.md", nn_readme(name, "frontend", "    nova run            # serve public/ on :8080"))
    else if kind == "fullstack"
        nn_write(name, "src/main.nova", nn_fullstack_main())
        nn_write(name, "public/index.html", nn_index_html(name))
        nn_write(name, "public/app.js", nn_app_js())
        nn_write(name, "public/style.css", nn_style_css())
        nn_write(name, "README.md", nn_readme(name, "fullstack", "    nova run            # API at /api, frontend at / on :8080"))
    else if kind == "lib"
        nn_write(name, name + ".nova", nn_lib_module())
        nn_write(name, name + "_test.nova", nn_lib_test(name))
        nn_write(name, "README.md", nn_readme(name, "lib", "    nova test           # compile + run " + name + "_test.nova"))
    else
        print("unknown project type: --" + kind)
        print("expected one of: --api --microservice --frontend --fullstack --lib")
        return 1
    print("Done. Next: cd " + name)
    0

fn nova_pkg_new(project_name: string)
    if path_exists(project_name) == 1
        print("error: '" + project_name + "' already exists")
        exit(1)
    mkdir_p(project_name)
    mkdir_p(path_join(project_name, "src"))
    mkdir_p(path_join(project_name, "tests"))
    write_file(path_join(project_name, "nova.toml"), nova_toml_default(project_name))
    let main_src = "fn main()\n    print(" + chr(34) + "Hello from " + project_name + "!" + chr(34) + ")\n"
    write_file(path_join(project_name, "src/main.nova"), main_src)
    let test_src = "fn main()\n    assert(1 + 1 == 2, " + chr(34) + "math works" + chr(34) + ")\n    print(" + chr(34) + "ok" + chr(34) + ")\n"
    write_file(path_join(project_name, "tests/example_test.nova"), test_src)
    let gitignore = "*.ll\n*.exe\n*.exp\n*.lib\nnova_packages/\n"
    write_file(path_join(project_name, ".gitignore"), gitignore)
    print("Created project '" + project_name + "':")
    print("  " + project_name + "/nova.toml")
    print("  " + project_name + "/src/main.nova")
    print("  " + project_name + "/tests/example_test.nova")
    print("  " + project_name + "/.gitignore")
    print("")
    print("Next steps:")
    print("  cd " + project_name)
    print("  nova run             # run main")
    print("  nova test            # run all tests")

fn nova_pkg_entry() -> string
    if path_exists("src/main.nova") == 1
        return "src/main.nova"
    if path_exists("main.nova") == 1
        return "main.nova"
    return ""

// Minimal NOVA formatter: normalizes whitespace without changing structure.
//  - tabs -> 4 spaces
//  - trim trailing whitespace per line
//  - collapse 3+ blank lines to 2
//  - file ends with exactly one newline
fn nova_fmt_trim_trailing_ws(s: string) -> string
    let n = len(s)
    while n > 0
        let c = s[n - 1]
        if c == " " or c == "\t" or c == "\r"
            n = n - 1
        else
            break
    if n == len(s)
        return s
    if n == 0
        return ""
    slice(s, 0, n)

// Minimal NOVA linter: text-only static checks. Reports style/sanity issues
// per line. Exit code 1 if any 'error'-severity finding; 0 otherwise.
//  - tab character           [warn] (NOVA convention is 4 spaces)
//  - trailing whitespace     [warn]
//  - CRLF line endings       [warn] (NOVA convention is LF)
//  - line longer than 120    [warn]
//  - TODO/FIXME/XXX comment  [info]
fn _lint_is_upper(c: string) -> bool
    let code = ord(c)
    code >= 65 and code <= 90

fn _lint_is_lower(c: string) -> bool
    let code = ord(c)
    code >= 97 and code <= 122

fn _lint_is_digit(c: string) -> bool
    let code = ord(c)
    code >= 48 and code <= 57

fn _lint_has_upper(s: string) -> bool
    let i = 0
    while i < len(s)
        if _lint_is_upper(s[i])
            return true
        i = i + 1
    false

fn _lint_is_snake_case(name: string) -> bool
    if len(name) == 0
        return true
    if _lint_is_upper(name[0])
        return false
    let i = 0
    while i < len(name)
        let c = name[i]
        if not _lint_is_lower(c) and not _lint_is_digit(c) and c != "_"
            return false
        i = i + 1
    true

fn _lint_extract_name(line: string, after_kw: int) -> string
    let s = trim(slice(line, after_kw, len(line)))
    let i = 0
    while i < len(s)
        let c = s[i]
        if c == "(" or c == " " or c == "\t" or c == "\n" or c == ":"
            return slice(s, 0, i)
        i = i + 1
    s

fn nova_lint_file(path: string) -> int
    let content = read_file(path)
    if len(content) == 0
        print("error: file not found or empty: " + path)
        return 1
    let lines = split(content, "\n")
    let warnings = 0
    let i = 0
    while i < len(lines)
        let raw = lines[i]
        let line_no = str(i + 1)
        let has_cr = false
        let l = raw
        if len(l) > 0 and l[len(l) - 1] == "\r"
            has_cr = true
            l = slice(l, 0, len(l) - 1)
        if has_cr
            print(path + ":" + line_no + ": warn: CRLF line ending (NOVA prefers LF)")
            warnings = warnings + 1
        if find(l, "\t") >= 0
            print(path + ":" + line_no + ": warn: tab character (use 4 spaces)")
            warnings = warnings + 1
        let n = len(l)
        if n > 0 and (l[n - 1] == " " or l[n - 1] == "\t")
            print(path + ":" + line_no + ": warn: trailing whitespace")
            warnings = warnings + 1
        if n > 120
            print(path + ":" + line_no + ": warn: line is " + str(n) + " chars (max 120)")
            warnings = warnings + 1
        let tdo = find(l, "TODO")
        let fix = find(l, "FIXME")
        let xxx = find(l, "XXX")
        if tdo >= 0 or fix >= 0 or xxx >= 0
            print(path + ":" + line_no + ": info: TODO/FIXME/XXX comment")
        let lt = trim(l)
        if starts_with(lt, "fn ") and not starts_with(lt, "fn main(")
            let fname = _lint_extract_name(lt, 3)
            if len(fname) > 0 and not starts_with(fname, "_")
                if not _lint_is_snake_case(fname)
                    print(path + ":" + line_no + ": warn: function '" + fname + "' should be snake_case")
                    warnings = warnings + 1
        if starts_with(lt, "type ") or starts_with(lt, "enum ")
            let kw_len = 5
            let tname = _lint_extract_name(lt, kw_len)
            if len(tname) > 0 and not _lint_is_upper(tname[0])
                print(path + ":" + line_no + ": warn: type '" + tname + "' should start with uppercase (PascalCase)")
                warnings = warnings + 1
        i = i + 1
    print(path + ": " + str(warnings) + " warning(s)")
    return 0

// ── #34 AST-reprint formatter ──────────────────────────────────────────────
// Parses to AST and reprints canonical NOVA source FROM the AST, with an absolute
// safety guarantee via a dual gate + fallback to the whitespace normalizer:
//   Gate A (faithfulness): parse(orig) == parse(reprint)  (structural AST equality)
//   Gate B (comments):     comment multiset preserved
//   Any unhandled node / trailing comment / parse error -> fall back (no regression).

// Raw parse: parse_program WITHOUT the desugaring pipeline (trail_fns/destruct/
// multiclause/ensures/memo/derives) so the AST round-trips at the source level.
fn fmt_parse_raw(tokens: list, pe: list) -> list
    let stmts = []
    let pos = skip_nl(tokens, 0)
    while tk(tokens, pos) != "EOF"
        let prev_pe_len = len(pe)
        let sr = parse_stmt(tokens, pos, pe)
        let new_pos = skip_nl(tokens, sr.pos)
        if len(pe) > prev_pe_len and new_pos <= pos and tk(tokens, pos) != "EOF"
            pos = pos + 1
        else
            pos = new_pos
        match sr.stmt
            Stmt(stag, sn, se, sb, sp2, seb, sa, sl) =>
                if stag != "error"
                    push(stmts, sr.stmt)
    stmts

// Re-escape a decoded string for emission as a "double-quoted" literal. Falls back
// (sets unsupported) on braces — the lexer treats { } as interpolation — and NULs.
fn fmt_escape_str(s: string, ctx: dict) -> string
    let out = ""
    let i = 0
    while i < len(s)
        let c = s[i]
        let o = ord(c)
        if c == "\\"
            out = out + "\\\\"
        else if c == "\""
            out = out + "\\\""
        else if c == "\n"
            out = out + "\\n"
        else if c == "\t"
            out = out + "\\t"
        else if c == "\r"
            out = out + "\\r"
        else if o == 123 or o == 125 or o == 0
            ctx["unsupported"] = 1
            return ""
        else
            out = out + c
        i = i + 1
    out

fn fmt_rp_prec(op: string) -> int
    if op == "or"
        return 1
    if op == "and"
        return 2
    if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" or op == "in" or op == "is" or op == "matches"
        return 3
    if op == "|"
        return 4
    if op == "^"
        return 5
    if op == "&"
        return 6
    if op == "<<" or op == ">>"
        return 7
    if op == "+" or op == "-"
        return 8
    if op == "*" or op == "/" or op == "%"
        return 9
    if op == "**"
        return 10
    return 0

fn fmt_rp_indent(level: int) -> string
    let s = ""
    let i = 0
    while i < level
        s = s + "    "
        i = i + 1
    s

fn fmt_rp_expr(e: Expr, ctx: dict) -> string
    if ctx["unsupported"] == 1
        return ""
    match e
        Expr(et, ev, en, ec, ef, eln) =>
            if et == "int"
                return str(en)
            if et == "float"
                return ev
            if et == "str"
                let esc = fmt_escape_str(ev, ctx)
                if ctx["unsupported"] == 1
                    return ""
                return chr(34) + esc + chr(34)
            if et == "bool"
                return ev
            if et == "null"
                return "null"
            if et == "ident"
                return ev
            if et == "binop"
                if len(ec) < 2
                    ctx["unsupported"] = 1
                    return ""
                let left = ec[0]
                let right = ec[1]
                let ls = ""
                let rs = ""
                let my_prec = fmt_rp_prec(ev)
                match left
                    Expr(lt, lv, ln2, lc, lf, ll) =>
                        if lt == "binop" and fmt_rp_prec(lv) < my_prec
                            ls = "(" + fmt_rp_expr(left, ctx) + ")"
                        else
                            ls = fmt_rp_expr(left, ctx)
                match right
                    Expr(rt, rv, rn2, rc, rf, rl) =>
                        if rt == "binop"
                            let rp = fmt_rp_prec(rv)
                            if ev == "**"
                                if rp < my_prec
                                    rs = "(" + fmt_rp_expr(right, ctx) + ")"
                                else
                                    rs = fmt_rp_expr(right, ctx)
                            else
                                if rp <= my_prec
                                    rs = "(" + fmt_rp_expr(right, ctx) + ")"
                                else
                                    rs = fmt_rp_expr(right, ctx)
                        else
                            rs = fmt_rp_expr(right, ctx)
                if ctx["unsupported"] == 1
                    return ""
                return ls + " " + ev + " " + rs
            if et == "unary"
                if len(ec) < 1
                    ctx["unsupported"] = 1
                    return ""
                let operand = fmt_rp_expr(ec[0], ctx)
                if ctx["unsupported"] == 1
                    return ""
                if ev == "not"
                    return "not " + operand
                return ev + operand
            if et == "call"
                let args = ""
                let ai = 0
                while ai < len(ec)
                    if ai > 0
                        args = args + ", "
                    args = args + fmt_rp_expr(ec[ai], ctx)
                    if ctx["unsupported"] == 1
                        return ""
                    ai = ai + 1
                return ev + "(" + args + ")"
            if et == "method_call"
                if len(ec) < 1
                    ctx["unsupported"] = 1
                    return ""
                let recv = fmt_rp_expr(ec[0], ctx)
                if ctx["unsupported"] == 1
                    return ""
                let margs = ""
                let mi = 1
                while mi < len(ec)
                    if mi > 1
                        margs = margs + ", "
                    margs = margs + fmt_rp_expr(ec[mi], ctx)
                    if ctx["unsupported"] == 1
                        return ""
                    mi = mi + 1
                return recv + "." + ev + "(" + margs + ")"
            if et == "member"
                if len(ec) < 1
                    ctx["unsupported"] = 1
                    return ""
                let obj = fmt_rp_expr(ec[0], ctx)
                if ctx["unsupported"] == 1
                    return ""
                return obj + "." + ev
            if et == "index"
                if len(ec) < 2
                    ctx["unsupported"] = 1
                    return ""
                let tgt = fmt_rp_expr(ec[0], ctx)
                let idx = fmt_rp_expr(ec[1], ctx)
                if ctx["unsupported"] == 1
                    return ""
                return tgt + "[" + idx + "]"
            if et == "list"
                let elems = ""
                let li = 0
                while li < len(ec)
                    if li > 0
                        elems = elems + ", "
                    elems = elems + fmt_rp_expr(ec[li], ctx)
                    if ctx["unsupported"] == 1
                        return ""
                    li = li + 1
                return "[" + elems + "]"
            if et == "dict"
                let lb = chr(123)
                let rb = chr(125)
                let entries = ""
                let di = 0
                while di < len(ec)
                    if di > 0
                        entries = entries + ", "
                    match ec[di]
                        Expr(pt, pv, pn, pc, pf, pl) =>
                            if pt == "pair" and len(pc) >= 2
                                let pk = fmt_rp_expr(pc[0], ctx)
                                let pval = fmt_rp_expr(pc[1], ctx)
                                if ctx["unsupported"] == 1
                                    return ""
                                entries = entries + pk + ": " + pval
                            else
                                ctx["unsupported"] = 1
                                return ""
                    di = di + 1
                return lb + entries + rb
            ctx["unsupported"] = 1
            return ""

fn fmt_rp_param(p: Param, ctx: dict) -> string
    match p
        Param(pn, pt, pd) =>
            match pd
                Expr(dt, dv, dn, dc, df, dl) =>
                    if dt != "null"
                        ctx["unsupported"] = 1
                        return ""
            if pt != ""
                return pn + ": " + pt
            return pn

fn fmt_rp_stmt(s: Stmt, indent: int, ctx: dict) -> string
    if ctx["unsupported"] == 1
        return ""
    let pad = fmt_rp_indent(indent)
    match s
        Stmt(st, sn, se, sb, sp, sel, san, sl) =>
            if st == "fn"
                if len(san) > 0 or len(sel) > 0
                    ctx["unsupported"] = 1
                    return ""
                let header = pad + "fn " + sn + "("
                let pi = 0
                while pi < len(sp)
                    if pi > 0
                        header = header + ", "
                    header = header + fmt_rp_param(sp[pi], ctx)
                    if ctx["unsupported"] == 1
                        return ""
                    pi = pi + 1
                header = header + ")"
                match se
                    Expr(ret_tag, ret_val, ret_num, ret_c, ret_f, ret_ln) =>
                        if ret_tag == "rettype"
                            header = header + " -> " + ret_val
                let result = header + "\n"
                let bi = 0
                while bi < len(sb)
                    result = result + fmt_rp_stmt_c(sb[bi], indent + 1, ctx)
                    if ctx["unsupported"] == 1
                        return ""
                    bi = bi + 1
                return result
            if st == "type"
                if len(san) > 0
                    ctx["unsupported"] = 1
                    return ""
                let result = pad + "type " + sn + "\n"
                let fi = 0
                while fi < len(sp)
                    match sp[fi]
                        Param(fn2, ft, fd) =>
                            if ft != ""
                                result = result + fmt_rp_indent(indent + 1) + fn2 + ": " + ft + "\n"
                            else
                                result = result + fmt_rp_indent(indent + 1) + fn2 + "\n"
                    fi = fi + 1
                return result
            if st == "const"
                let val = fmt_rp_expr(se, ctx)
                if ctx["unsupported"] == 1
                    return ""
                return pad + "const " + sn + " = " + val + "\n"
            if st == "assign"
                if sn != ""
                    let type_ann = ""
                    if len(sp) > 0
                        match sp[0]
                            Param(pn, pt, pd) =>
                                if pt != ""
                                    type_ann = pt
                    let has_init = true
                    match se
                        Expr(set2, sev, sen, sec, sef, seln) =>
                            if set2 == "null" and seln == 0
                                has_init = false
                    if has_init
                        let val = fmt_rp_expr(se, ctx)
                        if ctx["unsupported"] == 1
                            return ""
                        if type_ann != ""
                            return pad + "let " + sn + ": " + type_ann + " = " + val + "\n"
                        return pad + "let " + sn + " = " + val + "\n"
                    else
                        if type_ann != ""
                            return pad + "let " + sn + ": " + type_ann + "\n"
                        return pad + "let " + sn + "\n"
                else
                    if len(san) < 1
                        ctx["unsupported"] = 1
                        return ""
                    let target = fmt_rp_expr(san[0], ctx)
                    let val = fmt_rp_expr(se, ctx)
                    if ctx["unsupported"] == 1
                        return ""
                    return pad + target + " = " + val + "\n"
            if st == "return"
                match se
                    Expr(ret, rv, rn, rc, rf, rln) =>
                        if ret == "null" and rln == 0
                            return pad + "return\n"
                let val = fmt_rp_expr(se, ctx)
                if ctx["unsupported"] == 1
                    return ""
                return pad + "return " + val + "\n"
            if st == "if"
                let cond = fmt_rp_expr(se, ctx)
                if ctx["unsupported"] == 1
                    return ""
                let result = pad + "if " + cond + "\n"
                let bi = 0
                while bi < len(sb)
                    result = result + fmt_rp_stmt_c(sb[bi], indent + 1, ctx)
                    if ctx["unsupported"] == 1
                        return ""
                    bi = bi + 1
                if len(sel) == 1
                    match sel[0]
                        Stmt(elt, eln2, ele, elb, elp, elel, elan, ell) =>
                            if elt == "if"
                                let nested = fmt_rp_stmt(sel[0], indent, ctx)
                                if ctx["unsupported"] == 1
                                    return ""
                                result = result + pad + "else " + slice(nested, len(pad), len(nested))
                                return result
                            else
                                result = result + pad + "else\n" + fmt_rp_stmt_c(sel[0], indent + 1, ctx)
                                if ctx["unsupported"] == 1
                                    return ""
                                return result
                else if len(sel) > 1
                    result = result + pad + "else\n"
                    let ei = 0
                    while ei < len(sel)
                        result = result + fmt_rp_stmt_c(sel[ei], indent + 1, ctx)
                        if ctx["unsupported"] == 1
                            return ""
                        ei = ei + 1
                return result
            if st == "while"
                let cond = fmt_rp_expr(se, ctx)
                if ctx["unsupported"] == 1
                    return ""
                let result = pad + "while " + cond + "\n"
                let bi = 0
                while bi < len(sb)
                    result = result + fmt_rp_stmt_c(sb[bi], indent + 1, ctx)
                    if ctx["unsupported"] == 1
                        return ""
                    bi = bi + 1
                return result
            if st == "for"
                let iter = fmt_rp_expr(se, ctx)
                if ctx["unsupported"] == 1
                    return ""
                let result = pad + "for " + sn + " in " + iter + "\n"
                let bi = 0
                while bi < len(sb)
                    result = result + fmt_rp_stmt_c(sb[bi], indent + 1, ctx)
                    if ctx["unsupported"] == 1
                        return ""
                    bi = bi + 1
                if len(sel) > 0
                    result = result + pad + "else\n"
                    let ei = 0
                    while ei < len(sel)
                        result = result + fmt_rp_stmt_c(sel[ei], indent + 1, ctx)
                        if ctx["unsupported"] == 1
                            return ""
                        ei = ei + 1
                return result
            if st == "expr"
                let val = fmt_rp_expr(se, ctx)
                if ctx["unsupported"] == 1
                    return ""
                return pad + val + "\n"
            if st == "break"
                return pad + "break\n"
            if st == "continue"
                return pad + "continue\n"
            if st == "import"
                if len(san) > 0
                    let alias = str(san[0])
                    if alias != "" and alias != sn
                        return pad + "import " + sn + " as " + alias + "\n"
                return pad + "import " + sn + "\n"
            ctx["unsupported"] = 1
            return ""

// Collect comment-only lines: line_number -> text. Sets unsupported on a trailing
// code-line comment or a block comment (we only safely preserve own-line comments).
fn fmt_collect_comments(source: string, ctx: dict) -> dict
    let comments = {}
    let lines = split(source, "\n")
    let li = 0
    while li < len(lines)
        let line = lines[li]
        let trimmed = trim(line)
        let line_num = li + 1
        if len(trimmed) >= 2 and slice(trimmed, 0, 2) == "//"
            comments[str(line_num)] = trimmed
        else if len(trimmed) > 0
            let ci = 0
            let in_str = false
            while ci < len(trimmed)
                let ch = trimmed[ci]
                if ch == "\"" and (ci == 0 or trimmed[ci - 1] != "\\")
                    in_str = not in_str
                else if not in_str and ch == "/" and ci + 1 < len(trimmed) and trimmed[ci + 1] == "/"
                    ctx["unsupported"] = 1
                    ci = len(trimmed)
                ci = ci + 1
            if find(trimmed, "/*") >= 0
                ctx["unsupported"] = 1
        li = li + 1
    comments

fn fmt_comment_texts(comments: dict) -> list
    let texts = []
    let ks = keys(comments)
    for k in ks
        push(texts, comments[k])
    sort(texts)

fn fmt_ast_equal_expr(a: Expr, b: Expr) -> bool
    match a
        Expr(at, av, an, ac, af, al) =>
            match b
                Expr(bt, bv, bn, bc, bf, bl) =>
                    if at != bt
                        return false
                    if av != bv
                        return false
                    if an != bn
                        return false
                    if len(ac) != len(bc)
                        return false
                    let ci = 0
                    while ci < len(ac)
                        if not fmt_ast_equal_expr(ac[ci], bc[ci])
                            return false
                        ci = ci + 1
                    if len(af) != len(bf)
                        return false
                    let fi = 0
                    while fi < len(af)
                        if not fmt_ast_equal_expr(af[fi], bf[fi])
                            return false
                        fi = fi + 1
                    return true

fn fmt_ast_equal_params(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        match a[i]
            Param(an, at, ad) =>
                match b[i]
                    Param(bn, bt, bd) =>
                        if an != bn
                            return false
                        if at != bt
                            return false
                        if not fmt_ast_equal_expr(ad, bd)
                            return false
        i = i + 1
    true

fn fmt_ast_equal_stmt(a: Stmt, b: Stmt) -> bool
    match a
        Stmt(at, an, ae, ab, ap, ael, aan, asl) =>
            match b
                Stmt(bt, bn, be, bb, bp, bel, ban, bsl) =>
                    if at != bt
                        return false
                    if an != bn
                        return false
                    if not fmt_ast_equal_expr(ae, be)
                        return false
                    if not fmt_ast_equal_list(ab, bb)
                        return false
                    if not fmt_ast_equal_params(ap, bp)
                        return false
                    if not fmt_ast_equal_list(ael, bel)
                        return false
                    if len(aan) != len(ban)
                        return false
                    if at == "import"
                        let ai = 0
                        while ai < len(aan)
                            if str(aan[ai]) != str(ban[ai])
                                return false
                            ai = ai + 1
                    else
                        let ai = 0
                        while ai < len(aan)
                            if not fmt_ast_equal_expr(aan[ai], ban[ai])
                                return false
                            ai = ai + 1
                    return true

fn fmt_ast_equal_list(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if not fmt_ast_equal_stmt(a[i], b[i])
            return false
        i = i + 1
    true

// Comment-aware stmt wrapper: emits own-line comments anchored BEFORE this stmt's
// source line (re-indented to the stmt's level) via a shared cursor in ctx, then the
// stmt — so comments interleave at EVERY nesting level, not just the top level.
fn fmt_rp_stmt_c(s: Stmt, indent: int, ctx: dict) -> string
    if ctx["unsupported"] == 1
        return ""
    let pad = fmt_rp_indent(indent)
    let sline = 0
    match s
        Stmt(st, sn, se, sb, sp, sel, san, sl) =>
            sline = sl
    let pre = ""
    let clines = ctx["clines"]
    while ctx["ccur"] < len(clines) and clines[ctx["ccur"]] < sline
        let cl = clines[ctx["ccur"]]
        pre = pre + pad + ctx["comments"][str(cl)] + "\n"
        ctx["ccur"] = ctx["ccur"] + 1
    pre + fmt_rp_stmt(s, indent, ctx)

// Reprint stmts, interleaving own-line comments anchored by source line number.
fn fmt_reprint(stmts: list, comments: dict, ctx: dict) -> string
    let comment_lines = []
    let ks = keys(comments)
    for k in ks
        push(comment_lines, int(k))
    comment_lines = sort(comment_lines)
    ctx["comments"] = comments
    ctx["clines"] = comment_lines
    ctx["ccur"] = 0
    let result = ""
    let si = 0
    while si < len(stmts)
        if ctx["unsupported"] == 1
            return ""
        result = result + fmt_rp_stmt_c(stmts[si], 0, ctx)
        if ctx["unsupported"] == 1
            return ""
        match stmts[si]
            Stmt(st2, sn2, se2, sb2, sp2, sel2, san2, sl2) =>
                if st2 == "fn" or st2 == "type"
                    result = result + "\n"
        si = si + 1
    while ctx["ccur"] < len(ctx["clines"])
        result = result + ctx["comments"][str(ctx["clines"][ctx["ccur"]])] + "\n"
        ctx["ccur"] = ctx["ccur"] + 1
    result

fn nova_fmt_file_ast(path: string)
    let content = read_file(path)
    if len(content) == 0
        print("error: file not found or empty: " + path)
        exit(1)
    let tokens1 = tokenize(content)
    let pe1 = []
    let stmts1 = fmt_parse_raw(tokens1, pe1)
    if len(pe1) > 0
        nova_fmt_file(path)
        return 0
    let ctx = {}
    ctx["unsupported"] = 0
    let comments1 = fmt_collect_comments(content, ctx)
    if ctx["unsupported"] == 1
        nova_fmt_file(path)
        return 0
    let src2 = fmt_reprint(stmts1, comments1, ctx)
    if ctx["unsupported"] == 1
        nova_fmt_file(path)
        return 0
    if len(src2) == 0 and len(stmts1) > 0
        nova_fmt_file(path)
        return 0
    let tokens2 = tokenize(src2)
    let pe2 = []
    let stmts2 = fmt_parse_raw(tokens2, pe2)
    if len(pe2) > 0
        nova_fmt_file(path)
        return 0
    if not fmt_ast_equal_list(stmts1, stmts2)
        nova_fmt_file(path)
        return 0
    let ctx2 = {}
    ctx2["unsupported"] = 0
    let comments2 = fmt_collect_comments(src2, ctx2)
    if ctx2["unsupported"] == 1
        nova_fmt_file(path)
        return 0
    let texts1 = fmt_comment_texts(comments1)
    let texts2 = fmt_comment_texts(comments2)
    if len(texts1) != len(texts2)
        nova_fmt_file(path)
        return 0
    let ti = 0
    while ti < len(texts1)
        if texts1[ti] != texts2[ti]
            nova_fmt_file(path)
            return 0
        ti = ti + 1
    write_file(path, src2)
    print("Formatted (AST): " + path)

fn nova_fmt_file(path: string)
    let content = read_file(path)
    if len(content) == 0
        print("error: file not found or empty: " + path)
        exit(1)
    let lines = split(content, "\n")
    let result = ""
    let blank_run = 0
    let li = 0
    let last_non_blank_idx = -1
    let kept = []
    while li < len(lines)
        let l = replace(lines[li], "\t", "    ")
        l = nova_fmt_trim_trailing_ws(l)
        if len(l) == 0
            blank_run = blank_run + 1
            if blank_run <= 2
                push(kept, l)
        else
            blank_run = 0
            last_non_blank_idx = len(kept)
            push(kept, l)
        li = li + 1
    let ki = 0
    let upto = last_non_blank_idx + 1
    if upto < 0
        upto = 0
    while ki < upto
        result = result + kept[ki] + "\n"
        ki = ki + 1
    write_file(path, result)
    print("Formatted: " + path)

fn nova_pkg_clean()
    let removed = 0
    let dirs = ["."]
    for d in dirs
        let files = list_dir(d)
        for f in files
            if ends_with(f, ".ll") or ends_with(f, ".exe") or ends_with(f, ".exp") or ends_with(f, ".lib") or ends_with(f, ".pdb")
                let full = path_join(d, f)
                system("del " + chr(34) + full + chr(34) + " >nul 2>&1")
                removed = removed + 1
    if path_exists("src") == 1
        let sfiles = list_dir("src")
        for f in sfiles
            if ends_with(f, ".ll") or ends_with(f, ".exe")
                let full = path_join("src", f)
                system("del " + chr(34) + full + chr(34) + " >nul 2>&1")
                removed = removed + 1
    print("Cleaned " + str(removed) + " artifact(s)")

fn nova_pkg_test()
    let test_files = []
    if path_exists("tests") == 1
        let files = list_dir("tests")
        for f in files
            if ends_with(f, "_test.nova") or ends_with(f, "_tests.nova")
                push(test_files, path_join("tests", f))
    if path_exists(".") == 1
        let cfiles = list_dir(".")
        for f in cfiles
            if ends_with(f, "_test.nova")
                push(test_files, f)
    if len(test_files) == 0
        print("No test files found (looking for *_test.nova in ./ or tests/)")
        return 0
    print("Running " + str(len(test_files)) + " test file(s)...")
    let passed = 0
    let failed = 0
    for tf in test_files
        let exe_path = nova_replace_ext(tf, ".nova", ".exe")
        let ll_path = nova_replace_ext(tf, ".nova", ".ll")
        nova_compile_file(tf, ll_path, 1, "")
        let link_ret = nova_link(ll_path, exe_path, "-O2", "")
        if link_ret != 0
            print("  FAIL link: " + tf)
            failed = failed + 1
        else
            let run_ret = system(chr(34) + exe_path + chr(34))
            if run_ret == 0
                print("  PASS: " + tf)
                passed = passed + 1
            else
                print("  FAIL run: " + tf + " (exit " + str(run_ret) + ")")
                failed = failed + 1
        system("del " + chr(34) + ll_path + chr(34) + " >nul 2>&1")
        system("del " + chr(34) + exe_path + chr(34) + " >nul 2>&1")
    print("")
    print("Test results: " + str(passed) + " passed, " + str(failed) + " failed")
    if failed > 0
        exit(1)

fn nova_parse_toml_deps(content: string) -> dict
    let deps = {}
    let lines = split(content, "\n")
    let in_deps = 0
    let idx = 0
    while idx < len(lines)
        let trimmed = trim(lines[idx])
        if trimmed == "[dependencies]"
            in_deps = 1
        else if len(trimmed) > 0
            let first_ch = slice(trimmed, 0, 1)
            if first_ch == "["
                in_deps = 0
            else if in_deps == 1 and first_ch != "#"
                let eq_pos = find(trimmed, "=")
                if eq_pos >= 0
                    let key = trim(slice(trimmed, 0, eq_pos))
                    let val = trim(slice(trimmed, eq_pos + 1, len(trimmed)))
                    // End a quoted version at its CLOSING quote, not at end-of-line, so
                    // `greet = "0.1.0"  # pinned` yields 0.1.0 and not `0.1.0"  # pinned`.
                    if len(val) >= 1 and slice(val, 0, 1) == "\""
                        let vrest = slice(val, 1, len(val))
                        let vclose = find(vrest, "\"")
                        if vclose >= 0
                            val = slice(vrest, 0, vclose)
                        else
                            val = vrest
                    else
                        let vhash = find(val, "#")
                        if vhash >= 0
                            val = trim(slice(val, 0, vhash))
                    deps[key] = val
        idx = idx + 1
    deps

// Registry base. NOVA_REGISTRY overrides the default so a user can point at their own host
// (or a vendored/air-gapped copy) WITHOUT rebuilding the compiler. Two forms are accepted:
//   https://host/path/   -> fetched over HTTP
//   /some/dir  or  C:\d  -> read straight off the filesystem
// The filesystem form is what makes `nova install` work with zero network: point it at this
// repo's own `packages/registry/` and the bundled packages resolve offline.
fn nova_registry_url() -> string
    let env_reg = env("NOVA_REGISTRY")
    if len(env_reg) > 0
        if ends_with(env_reg, "/") or ends_with(env_reg, "\\")
            return env_reg
        return env_reg + "/"
    "https://bitbucket.org/manemangesh/packages/raw/main/registry/"

fn nova_registry_is_http(base: string) -> int
    if starts_with(base, "http://") or starts_with(base, "https://")
        return 1
    0

// Read `rel` from the registry, over HTTP or off disk depending on the base form.
// Returns "" when absent -- callers treat empty as "not in this registry" and fall back.
fn nova_registry_fetch(rel: string) -> string
    let base = nova_registry_url()
    if nova_registry_is_http(base) == 1
        return http_get(base + rel)
    let p = base + rel
    if path_exists(p) == 1
        return read_file(p)
    ""

// Resolve a package's `source` field. An absolute http(s) URL is fetched as-is; anything else
// is treated as RELATIVE TO THE REGISTRY, so a registry can vendor `<pkg>/<pkg>.nova` right
// next to its index.toml instead of needing one hosted repo per package.
fn nova_registry_fetch_source(src: string, pkg_name: string) -> string
    if starts_with(src, "http://") or starts_with(src, "https://")
        return http_get(src)
    nova_registry_fetch(src)

// Pull `key = "value"` out of a flat TOML-ish line set.
// A QUOTED value ends at its closing quote, so a trailing `# comment` is discarded rather than
// swallowed into the value (that bug made `source = "a/b.nova"  # note` resolve to the literal
// string `a/b.nova"   # note`). An unquoted value runs to an unquoted `#` or end of line.
fn nova_toml_scalar(content: string, key: string) -> string
    let out = ""
    for line in split(content, "\n")
        let trimmed = trim(line)
        let eq = find(trimmed, "=")
        if eq >= 0
            let lhs = trim(slice(trimmed, 0, eq))
            if lhs == key
                let v = trim(slice(trimmed, eq + 1, len(trimmed)))
                if len(v) >= 1 and slice(v, 0, 1) == "\""
                    let rest = slice(v, 1, len(v))
                    let close = find(rest, "\"")
                    if close >= 0
                        out = slice(rest, 0, close)
                    else
                        out = rest
                else
                    let hash = find(v, "#")
                    if hash >= 0
                        v = trim(slice(v, 0, hash))
                    out = v
    out

fn nova_pkg_is_valid_source(content: string) -> int
    if len(content) == 0
        return 0
    let t = trim(content)
    if starts_with(t, "<") or starts_with(t, "<!") or starts_with(t, "404")
        return 0
    if starts_with(t, "fn ") or starts_with(t, "//") or starts_with(t, "let ") or starts_with(t, "type ") or starts_with(t, "import ") or starts_with(t, "enum ")
        return 1
    if find(t, "fn ") >= 0
        return 1
    return 0

// A package's OWN dependencies, read from its registry index.toml `[dependencies]` section.
// Returns {} when the package declares none (or is not in this registry). This is what makes
// TRANSITIVE resolution possible -- see nova_pkg_resolve_all.
fn nova_pkg_deps_of(pkg_name: string) -> dict
    let index_content = nova_registry_fetch(pkg_name + "/index.toml")
    if len(index_content) == 0
        return {}
    if nova_pkg_is_valid_source(index_content) == 1
        return {}
    nova_parse_toml_deps(index_content)

fn nova_pkg_download(pkg_name: string, pkg_version: string) -> int
    let pkg_dir = path_join("nova_packages", pkg_name)
    let marker = path_join(pkg_dir, pkg_name + ".nova")
    if path_exists(marker) == 1
        return 1
    mkdir_p(path_join("nova_packages", pkg_name))
    let index_content = nova_registry_fetch(pkg_name + "/index.toml")
    if len(index_content) > 0 and nova_pkg_is_valid_source(index_content) == 0
        let src_url = nova_toml_scalar(index_content, "source")
        if len(src_url) > 0
            let content = nova_registry_fetch_source(src_url, pkg_name)
            if nova_pkg_is_valid_source(content) == 1
                write_file(marker, content)
                print("  Downloaded " + pkg_name)
                return 1
            else
                print("  warning: " + pkg_name + " source '" + src_url + "' returned invalid content")
        // No `source` key: fall back to the convention that a registry vendors the package
        // source beside its index as <pkg>/<pkg>.nova.
        let vendored = nova_registry_fetch(pkg_name + "/" + pkg_name + ".nova")
        if nova_pkg_is_valid_source(vendored) == 1
            write_file(marker, vendored)
            print("  Downloaded " + pkg_name)
            return 1
    let gh_url = "https://bitbucket.org/manemangesh/pkg-" + pkg_name + "/raw/main/" + pkg_name + ".nova"
    let content = http_get(gh_url)
    if nova_pkg_is_valid_source(content) == 1
        write_file(marker, content)
        print("  Downloaded " + pkg_name + " (direct repo)")
        return 1
    print("  error: could not download " + pkg_name + " — not found in registry " + nova_registry_url())
    print("  Set NOVA_REGISTRY to a reachable registry, or place " + pkg_name + ".nova in nova_packages/" + pkg_name + "/ manually")
    return 0

// Transitive closure of `direct` over each package's declared dependencies.
// Worklist, not recursion: a package already in `seen` is never revisited, so a dependency
// CYCLE terminates instead of hanging. First-writer-wins on version, matching the existing
// direct-dep behavior; a real SAT/semver solver is the follow-up, but this at least stops
// silently ignoring everything below depth 1.
fn nova_pkg_resolve_all(direct: dict) -> dict
    let seen = {}
    let queue = []
    for k in keys(direct)
        push(queue, k)
        seen[k] = direct[k]
    let qi = 0
    while qi < len(queue)
        let name = queue[qi]
        qi = qi + 1
        let sub = nova_pkg_deps_of(name)
        for dep in keys(sub)
            if not contains(seen, dep)
                seen[dep] = sub[dep]
                push(queue, dep)
    seen

fn nova_pkg_install()
    let toml = read_file("nova.toml")
    if len(toml) == 0
        print("error: no nova.toml found. Run nova init first")
        exit(1)
    // Reproducible installs (#26): if nova.lock exists, honor its EXACT pinned versions (like
    // `npm ci` / `cargo --locked`) so every machine + CI resolves identically. Otherwise resolve
    // from nova.toml and WRITE nova.lock, pinning the resolution for next time.
    let locked = lockfile_read("nova.lock")
    let use_lock = 0
    if locked != 0
        if len(keys(locked)) > 0
            use_lock = 1
    let deps = {}
    if use_lock == 1
        deps = locked
        print("Installing from nova.lock (pinned versions)...")
    else
        // Resolve TRANSITIVELY. Before this, only the packages literally listed in nova.toml were
        // fetched, so a dependency-of-a-dependency silently never arrived and the build failed at
        // `import` with no hint why. A lockfile is already a full closure, so it is used verbatim.
        let direct = nova_parse_toml_deps(toml)
        deps = nova_pkg_resolve_all(direct)
        let extra = len(keys(deps)) - len(keys(direct))
        if extra > 0
            print("Resolved " + str(extra) + " transitive dependency(ies)")
    let dep_keys = keys(deps)
    if len(dep_keys) == 0
        print("No dependencies to install")
        return 0
    if use_lock == 0
        print("Installing " + str(len(dep_keys)) + " package(s)...")
    let installed = 0
    let resolved = {}
    for pkg_name in dep_keys
        let version = deps[pkg_name]
        let ok = nova_pkg_download(pkg_name, version)
        if ok == 1
            installed = installed + 1
            resolved[pkg_name] = version
    print("Installed " + str(installed) + "/" + str(len(dep_keys)) + " packages")
    // Pin the resolution so the next install is byte-reproducible (only when we resolved from toml).
    if use_lock == 0 and installed > 0
        if lockfile_write("nova.lock", resolved) == 1
            print("Wrote nova.lock (" + str(len(keys(resolved))) + " packages pinned)")

fn nova_pkg_get(pkg_spec: string)
    let pkg_name = pkg_spec
    let pkg_version = "*"
    let at_pos = find(pkg_spec, "@")
    if at_pos >= 0
        pkg_name = slice(pkg_spec, 0, at_pos)
        pkg_version = slice(pkg_spec, at_pos + 1, len(pkg_spec))
    let toml = read_file("nova.toml")
    if len(toml) == 0
        print("error: no nova.toml found. Run nova init first")
        exit(1)
    let deps = nova_parse_toml_deps(toml)
    if contains(deps, pkg_name)
        print("Package " + pkg_name + " already in dependencies")
        return 0
    let dep_line = pkg_name + " = " + chr(34) + pkg_version + chr(34) + "\n"
    let new_toml = toml + dep_line
    write_file("nova.toml", new_toml)
    print("Added " + pkg_name + "@" + pkg_version + " to nova.toml")
    nova_pkg_download(pkg_name, pkg_version)

// ── LSP Server ──────────────────────────────────────────────────────────────

fn lsp_read_message() -> string
    let content_length = 0
    let line = read_line()
    while line != "" and line != "\r" and line != "\r\n"
        if starts_with(line, "Content-Length:")
            let num_str = trim(slice(line, 15, len(line)))
            num_str = replace(num_str, "\r", "")
            num_str = replace(num_str, "\n", "")
            content_length = int(num_str)
        line = read_line()
    if content_length <= 0
        return ""
    stdin_read_n(content_length)

fn lsp_send(msg: string)
    let body = msg
    let header = "Content-Length: " + str(len(body)) + "\r\n\r\n"
    stdout_write(header + body)

fn lsp_respond(id, result: string)
    lsp_send("\{\"jsonrpc\":\"2.0\",\"id\":" + str(id) + ",\"result\":" + result + "\}")

fn lsp_notify(method: string, params: string)
    lsp_send("\{\"jsonrpc\":\"2.0\",\"method\":\"" + method + "\",\"params\":" + params + "\}")

fn lsp_error_response(id, code: int, msg: string)
    lsp_send("\{\"jsonrpc\":\"2.0\",\"id\":" + str(id) + ",\"error\":\{\"code\":" + str(code) + ",\"message\":\"" + msg + "\"\}\}")

fn lsp_escape_json(s: string) -> string
    let out = ""
    let i = 0
    while i < len(s)
        let c = s[i]
        if c == "\\"
            out = out + "\\\\"
        else if c == "\""
            out = out + "\\\""
        else if c == "\n"
            out = out + "\\n"
        else if c == "\r"
            out = out + "\\r"
        else if c == "\t"
            out = out + "\\t"
        else
            out = out + c
        i = i + 1
    out

fn lsp_collect_diagnostics(source: string, filename: string) -> list
    let diags = []
    let tokens = tokenize(source)
    let parse_errors = []
    let stmts = parse_program(tokens, parse_errors)
    for pe in parse_errors
        let pe_line = 0
        let pe_col = 0
        let arrow_idx = find(pe, "--> ")
        if arrow_idx >= 0
            let after = slice(pe, arrow_idx + 4, len(pe))
            let num_end = find(after, "\n")
            if num_end < 0
                num_end = len(after)
            let loc_part = slice(after, 0, num_end)
            let last_colon = str_last_index_of(loc_part, ":")
            if last_colon > 0
                let before_col = slice(loc_part, 0, last_colon)
                let line_colon = str_last_index_of(before_col, ":")
                if line_colon > 0
                    let num_str = slice(loc_part, line_colon + 1, last_colon)
                    num_str = trim(num_str)
                    pe_line = int(num_str) - 1
                    if pe_line < 0
                        pe_line = 0
                    let col_str = trim(slice(loc_part, last_colon + 1, len(loc_part)))
                    pe_col = int(col_str) - 1
                    if pe_col < 0
                        pe_col = 0
        push(diags, [pe_line, pe_col, lsp_escape_json(pe), 1, pe_col + 1])
    let source_lines = split(source, "\n")
    let ti_state = ti_infer_program_named(stmts, source_lines, filename)
    for te in ti_state.ti_errors
        let te_line = 0
        let arrow_idx = find(te, "--> ")
        if arrow_idx >= 0
            let after = slice(te, arrow_idx + 4, len(te))
            let num_end = find(after, "\n")
            if num_end < 0
                num_end = len(after)
            let loc_part = slice(after, 0, num_end)
            let colon_idx = str_last_index_of(loc_part, ":")
            if colon_idx > 0
                let num_str = slice(loc_part, colon_idx + 1, len(loc_part))
                num_str = trim(num_str)
                te_line = int(num_str) - 1
                if te_line < 0
                    te_line = 0
        let msg_end = find(te, "\n")
        let msg = te
        if msg_end > 0
            msg = slice(te, 0, msg_end)
        push(diags, [te_line, 0, lsp_escape_json(msg), 1, 999])
    // Warnings (severity 2 = Warning, shows as orange/yellow instead of red)
    for tw in ti_state.ti_warnings
        let tw_line = 0
        let tw_arrow = find(tw, "--> ")
        if tw_arrow >= 0
            let tw_after = slice(tw, tw_arrow + 4, len(tw))
            let tw_nend = find(tw_after, "\n")
            if tw_nend < 0
                tw_nend = len(tw_after)
            let tw_loc = slice(tw_after, 0, tw_nend)
            let tw_colon = str_last_index_of(tw_loc, ":")
            if tw_colon > 0
                let tw_num = trim(slice(tw_loc, tw_colon + 1, len(tw_loc)))
                tw_line = int(tw_num) - 1
                if tw_line < 0
                    tw_line = 0
        let tw_msg_end = find(tw, "\n")
        let tw_msg = tw
        if tw_msg_end > 0
            tw_msg = slice(tw, 0, tw_msg_end)
        push(diags, [tw_line, 0, lsp_escape_json(tw_msg), 2, 999])
    diags

fn lsp_publish_diagnostics(uri: string, source: string, filename: string)
    let diags = lsp_collect_diagnostics(source, filename)
    let items = ""
    let di = 0
    for d in diags
        let line = d[0]
        let col = d[1]
        let msg = d[2]
        let sev = d[3]
        let ecol = d[4]
        if di > 0
            items = items + ","
        items = items + "\{\"range\":\{\"start\":\{\"line\":" + str(line) + ",\"character\":" + str(col) + "\},\"end\":\{\"line\":" + str(line) + ",\"character\":" + str(ecol) + "\}\},\"severity\":" + str(sev) + ",\"source\":\"nova\",\"message\":\"" + msg + "\"\}"
        di = di + 1
    lsp_notify("textDocument/publishDiagnostics", "\{\"uri\":\"" + lsp_escape_json(uri) + "\",\"diagnostics\":[" + items + "]\}")

fn lsp_uri_to_path(uri: string) -> string
    if starts_with(uri, "file:///")
        let path = slice(uri, 8, len(uri))
        path = replace(path, "%20", " ")
        path = replace(path, "%3A", ":")
        path = replace(path, "%5C", "\\")
        return path
    uri

fn lsp_get_word_at(docs: dict, uri: string, line_num: int, col: int) -> string
    if not contains(docs, uri)
        return ""
    let source = docs[uri]
    let lines = split(source, "\n")
    if line_num >= len(lines)
        return ""
    let line = lines[line_num]
    if col >= len(line)
        return ""
    let start = col
    while start > 0
        let ch = ord(line[start - 1])
        if ch == 32 or ch == 34 or ch == 39 or ch == 40 or ch == 41 or ch == 44 or ch == 58 or ch == 61 or ch == 46 or ch == 91 or ch == 93 or ch == 123 or ch == 125
            break
        start = start - 1
    let wend = col
    while wend < len(line)
        let ch = ord(line[wend])
        if ch == 32 or ch == 34 or ch == 39 or ch == 40 or ch == 41 or ch == 44 or ch == 58 or ch == 61 or ch == 46 or ch == 91 or ch == 93 or ch == 123 or ch == 125
            break
        wend = wend + 1
    if start >= wend
        return ""
    slice(line, start, wend)

fn lsp_infer_type_hint(docs: dict, uri: string, word: string) -> string
    if not contains(docs, uri)
        return ""
    let source = docs[uri]
    let lines = split(source, "\n")
    let i = 0
    while i < len(lines)
        let line = trim(lines[i])
        if starts_with(line, "fn " + word + "(") or starts_with(line, "fn " + word + "<")
            // #32: show the REAL signature (params + return type), not bare "function".
            // NOVA is indentation-based (no trailing brace), so the line IS the signature.
            return trim(slice(line, 3, len(line)))
        if starts_with(line, "type " + word)
            return "type " + word
        if starts_with(line, "let " + word + " ")
            let eq_pos = find(line, "=")
            if eq_pos > 0
                let rhs = trim(slice(line, eq_pos + 1, len(line)))
                if len(rhs) > 0
                    let fc = ord(rhs[0])
                    if fc == 91
                        return "list"
                    if fc == 123
                        return "dict"
                    if fc >= 48 and fc <= 57
                        return "number"
                if rhs == "true" or rhs == "false"
                    return "bool"
                return "variable"
        i = i + 1
    ""

fn lsp_find_definition(docs: dict, uri: string, word: string) -> int
    if word == "" or not contains(docs, uri)
        return -1
    let source = docs[uri]
    let lines = split(source, "\n")
    let i = 0
    while i < len(lines)
        let raw = lines[i]
        let line = trim(raw)
        if starts_with(line, "fn " + word + "(") or starts_with(line, "fn " + word + " ") or starts_with(line, "fn " + word + "<")
            return i
        if starts_with(line, "type " + word + " ") or starts_with(line, "type " + word + "<") or line == "type " + word
            return i
        if starts_with(line, "let " + word + " ") or starts_with(line, "let " + word + "=") or starts_with(line, "let " + word + ":")
            return i
        if starts_with(line, "enum " + word + " ") or starts_with(line, "enum " + word + "<") or line == "enum " + word
            return i
        if starts_with(line, "trait " + word + " ") or starts_with(line, "trait " + word + "<") or line == "trait " + word
            return i
        if starts_with(line, "fn ") and (contains(line, "." + word + "(") or contains(line, "." + word + "<"))
            return i
        if (starts_with(raw, "    ") or starts_with(raw, "\t")) and starts_with(line, word + ":") and not starts_with(line, "let ")
            return i
        i = i + 1
    -1

fn lsp_path_dir(path: string) -> string
    let last = -1
    let k = 0
    while k < len(path)
        let c = path[k]
        if c == "/" or c == "\\"
            last = k
        k = k + 1
    if last < 0
        return ""
    slice(path, 0, last + 1)

fn lsp_find_in_imports(docs: dict, uri: string, word: string) -> dict
    let empty = {}
    empty["found"] = 0
    empty["line"] = 0
    empty["uri"] = ""
    if word == "" or not contains(docs, uri)
        return empty
    let source = docs[uri]
    let src_path = lsp_uri_to_path(uri)
    let src_dir = lsp_path_dir(src_path)
    let lines = split(source, "\n")
    for raw_line in lines
        let trimmed = trim(raw_line)
        if not starts_with(trimmed, "import ")
            continue
        let rest = trim(slice(trimmed, 7, len(trimmed)))
        let module_name = rest
        let space_pos = find(rest, " ")
        if space_pos >= 0
            module_name = slice(rest, 0, space_pos)
        if len(module_name) == 0
            continue
        let file_path = src_dir + module_name + ".nova"
        let content = ""
        if file_exists(file_path)
            content = read_file(file_path)
        if len(content) == 0
            continue
        let mod_docs = {}
        let mod_uri = "file:///" + file_path
        mod_docs[mod_uri] = content
        let found_line = lsp_find_definition(mod_docs, mod_uri, word)
        if found_line >= 0
            let result = {}
            result["found"] = 1
            result["line"] = found_line
            result["uri"] = mod_uri
            return result
    empty

fn lsp_get_completions(docs: dict, uri: string, builtin_names: list) -> string
    let items = []
    // 1. NOVA keywords
    let kws = ["fn", "return", "if", "else", "for", "while", "match", "break", "continue", "type", "enum", "spawn", "send", "receive", "channel", "import", "true", "false", "null", "in", "as", "select", "try", "catch", "trait", "matches", "yield", "let", "extern", "unsafe", "with", "defer", "const", "unless", "until", "loop"]
    for kw in kws
        push(items, "\{\"label\":\"" + kw + "\",\"kind\":14,\"sortText\":\"2_" + kw + "\"\}")
    // 2. Builtin functions (~1335)
    for bn in builtin_names
        push(items, "\{\"label\":\"" + lsp_escape_json(bn) + "\",\"kind\":3,\"sortText\":\"3_" + lsp_escape_json(bn) + "\"\}")
    // 3. Current file declarations
    if contains(docs, uri)
        let source = docs[uri]
        let flines = split(source, "\n")
        let i = 0
        while i < len(flines)
            let fline = trim(flines[i])
            if starts_with(fline, "fn ")
                let paren = find(fline, "(")
                let langle = find(fline, "<")
                let stop = len(fline)
                if paren > 3 and paren < stop
                    stop = paren
                if langle > 3 and langle < stop
                    stop = langle
                let fname = trim(slice(fline, 3, stop))
                if len(fname) > 0 and find(fname, " ") < 0 and find(fname, ".") < 0
                    let fsig = ""
                    if paren > 0
                        fsig = trim(slice(fline, 3, len(fline)))
                    push(items, "\{\"label\":\"" + lsp_escape_json(fname) + "\",\"kind\":3,\"detail\":\"" + lsp_escape_json(fsig) + "\",\"sortText\":\"0_" + lsp_escape_json(fname) + "\"\}")
            else if starts_with(fline, "type ")
                let trest = trim(slice(fline, 5, len(fline)))
                let tstop = len(trest)
                let tsp = find(trest, " ")
                let tla = find(trest, "<")
                if tsp > 0 and tsp < tstop
                    tstop = tsp
                if tla > 0 and tla < tstop
                    tstop = tla
                let tname = slice(trest, 0, tstop)
                if len(tname) > 0
                    push(items, "\{\"label\":\"" + lsp_escape_json(tname) + "\",\"kind\":22,\"sortText\":\"0_" + lsp_escape_json(tname) + "\"\}")
            else if starts_with(fline, "enum ")
                let erest = trim(slice(fline, 5, len(fline)))
                let estop = len(erest)
                let esp = find(erest, " ")
                let ela = find(erest, "<")
                if esp > 0 and esp < estop
                    estop = esp
                if ela > 0 and ela < estop
                    estop = ela
                let ename = slice(erest, 0, estop)
                if len(ename) > 0
                    push(items, "\{\"label\":\"" + lsp_escape_json(ename) + "\",\"kind\":13,\"sortText\":\"0_" + lsp_escape_json(ename) + "\"\}")
            else if starts_with(fline, "trait ")
                let trrest = trim(slice(fline, 6, len(fline)))
                let trstop = len(trrest)
                let trsp = find(trrest, " ")
                if trsp > 0 and trsp < trstop
                    trstop = trsp
                let trname = slice(trrest, 0, trstop)
                if len(trname) > 0
                    push(items, "\{\"label\":\"" + lsp_escape_json(trname) + "\",\"kind\":8,\"sortText\":\"0_" + lsp_escape_json(trname) + "\"\}")
            i = i + 1
    // 4. Imported file declarations
    if contains(docs, uri)
        let source = docs[uri]
        let src_path = lsp_uri_to_path(uri)
        let src_dir = lsp_path_dir(src_path)
        for raw_line in split(source, "\n")
            let trimmed = trim(raw_line)
            if not starts_with(trimmed, "import ")
                continue
            let rest = trim(slice(trimmed, 7, len(trimmed)))
            let module_name = rest
            let space_pos = find(rest, " ")
            if space_pos >= 0
                module_name = slice(rest, 0, space_pos)
            if len(module_name) == 0
                continue
            let file_path = src_dir + module_name + ".nova"
            if file_exists(file_path)
                let mcontent = read_file(file_path)
                if len(mcontent) > 0
                    for d in _lsp_decls_in(mcontent)
                        let nm = d[0]
                        let kind = d[1]
                        push(items, "\{\"label\":\"" + lsp_escape_json(nm) + "\",\"kind\":" + str(kind) + ",\"detail\":\"(" + lsp_escape_json(module_name) + ")\",\"sortText\":\"1_" + lsp_escape_json(nm) + "\"\}")
    join(items, ",")

// ── Document symbols (outline) — Ctrl+O "Quick Outline" ─────────────────────
// Text-scan based (same style as lsp_find_definition), since Stmt tracks only
// a start line (sline), not a column — re-deriving the column from the raw
// line text is simpler and matches the rest of this file's approach.
fn lsp_get_document_symbols(docs: dict, uri: string) -> string
    if not contains(docs, uri)
        return "[]"
    let source = docs[uri]
    let lines = split(source, "\n")
    let items = []
    let i = 0
    while i < len(lines)
        let raw = lines[i]
        let line = trim(raw)
        let sym_name = ""
        let sym_kind = 0
        if starts_with(line, "fn ")
            let after = slice(line, 3, len(line))
            let stop = len(after)
            let paren = find(after, "(")
            let langle = find(after, "<")
            if paren >= 0 and paren < stop
                stop = paren
            if langle >= 0 and langle < stop
                stop = langle
            let cand = trim(slice(after, 0, stop))
            if len(cand) > 0 and find(cand, " ") < 0
                sym_name = cand
                if find(cand, ".") >= 0
                    sym_kind = 6
                else
                    sym_kind = 12
        else if starts_with(line, "type ")
            let after = trim(slice(line, 5, len(line)))
            let stop = len(after)
            let sp = find(after, " ")
            let langle = find(after, "<")
            if sp >= 0 and sp < stop
                stop = sp
            if langle >= 0 and langle < stop
                stop = langle
            let cand = slice(after, 0, stop)
            if len(cand) > 0
                sym_name = cand
                sym_kind = 23
        else if starts_with(line, "enum ")
            let after = trim(slice(line, 5, len(line)))
            let stop = len(after)
            let sp = find(after, " ")
            let langle = find(after, "<")
            if sp >= 0 and sp < stop
                stop = sp
            if langle >= 0 and langle < stop
                stop = langle
            let cand = slice(after, 0, stop)
            if len(cand) > 0
                sym_name = cand
                sym_kind = 10
        else if starts_with(line, "trait ")
            let after = trim(slice(line, 6, len(line)))
            let stop = len(after)
            let sp = find(after, " ")
            if sp >= 0 and sp < stop
                stop = sp
            let cand = slice(after, 0, stop)
            if len(cand) > 0
                sym_name = cand
                sym_kind = 11
        if len(sym_name) > 0
            let col = find(raw, sym_name)
            if col < 0
                col = 0
            let name_end = col + len(sym_name)
            let sym = "\{\"name\":\"" + lsp_escape_json(sym_name) + "\",\"kind\":" + str(sym_kind) + ",\"range\":\{\"start\":\{\"line\":" + str(i) + ",\"character\":0\},\"end\":\{\"line\":" + str(i) + ",\"character\":" + str(len(raw)) + "\}\},\"selectionRange\":\{\"start\":\{\"line\":" + str(i) + ",\"character\":" + str(col) + "\},\"end\":\{\"line\":" + str(i) + ",\"character\":" + str(name_end) + "\}\}\}"
            push(items, sym)
        i = i + 1
    "[" + join(items, ",") + "]"

// ── Find references / rename — token-based (not text-scan) ─────────────────
// Uses the real tokenizer so string/comment contents are never mistaken for
// identifier usages (a plain text scan would match "where" inside a comment
// or a string literal; IDENT tokens cannot appear there). SAME-FILE scope
// only: a correct workspace-wide index is a separate, larger effort (would
// need tokenizing every file in the project on every request) and is not
// attempted here — this is intentionally scoped, not a silent gap.
fn lsp_find_references(docs: dict, uri: string, word: string) -> list
    let refs = []
    if word == "" or not contains(docs, uri)
        return refs
    let source = docs[uri]
    let tokens = tokenize(source)
    for tok in tokens
        match tok
            Token(tk_kind, tk_val, tk_line, tk_col) =>
                if tk_kind == "IDENT" and tk_val == word
                    push(refs, [tk_line - 1, tk_col - 1, len(word)])
    refs

fn lsp_references_response(docs: dict, uri: string, word: string) -> string
    let refs = lsp_find_references(docs, uri, word)
    let items = []
    for r in refs
        let rl = r[0]
        let rc = r[1]
        let rlen = r[2]
        push(items, "\{\"uri\":\"" + lsp_escape_json(uri) + "\",\"range\":\{\"start\":\{\"line\":" + str(rl) + ",\"character\":" + str(rc) + "\},\"end\":\{\"line\":" + str(rl) + ",\"character\":" + str(rc + rlen) + "\}\}\}")
    "[" + join(items, ",") + "]"

fn lsp_rename_response(docs: dict, uri: string, word: string, new_name: string) -> string
    let refs = lsp_find_references(docs, uri, word)
    if len(refs) == 0
        return "null"
    let edits = []
    for r in refs
        let rl = r[0]
        let rc = r[1]
        let rlen = r[2]
        push(edits, "\{\"range\":\{\"start\":\{\"line\":" + str(rl) + ",\"character\":" + str(rc) + "\},\"end\":\{\"line\":" + str(rl) + ",\"character\":" + str(rc + rlen) + "\}\},\"newText\":\"" + lsp_escape_json(new_name) + "\"\}")
    "\{\"changes\":\{\"" + lsp_escape_json(uri) + "\":[" + join(edits, ",") + "]\}\}"

// ── Document highlight — highlights every occurrence of the symbol under the
// cursor, in the current file. Reuses the same token-based scan as references. ──
fn lsp_highlight_response(docs: dict, uri: string, word: string) -> string
    let refs = lsp_find_references(docs, uri, word)
    let items = []
    for r in refs
        let rl = r[0]
        let rc = r[1]
        let rlen = r[2]
        push(items, "\{\"range\":\{\"start\":\{\"line\":" + str(rl) + ",\"character\":" + str(rc) + "\},\"end\":\{\"line\":" + str(rl) + ",\"character\":" + str(rc + rlen) + "\}\},\"kind\":1\}")
    "[" + join(items, ",") + "]"

// ── Prepare rename — returns the exact word-range under the cursor so the
// editor can show what will be renamed before the user types a new name. ──
fn lsp_word_range_at(docs: dict, uri: string, line_num: int, col: int) -> list
    if not contains(docs, uri)
        return []
    let source = docs[uri]
    let lines = split(source, "\n")
    if line_num >= len(lines)
        return []
    let line = lines[line_num]
    if col > len(line)
        return []
    let start = col
    while start > 0
        let ch = ord(line[start - 1])
        if ch == 32 or ch == 34 or ch == 39 or ch == 40 or ch == 41 or ch == 44 or ch == 58 or ch == 61 or ch == 46 or ch == 91 or ch == 93 or ch == 123 or ch == 125
            break
        start = start - 1
    let wend = col
    while wend < len(line)
        let ch = ord(line[wend])
        if ch == 32 or ch == 34 or ch == 39 or ch == 40 or ch == 41 or ch == 44 or ch == 58 or ch == 61 or ch == 46 or ch == 91 or ch == 93 or ch == 123 or ch == 125
            break
        wend = wend + 1
    if start >= wend
        return []
    [start, wend]

fn lsp_prepare_rename_response(docs: dict, uri: string, line_num: int, col: int) -> string
    let range = lsp_word_range_at(docs, uri, line_num, col)
    if len(range) == 0
        return "null"
    let start_col = range[0]
    let end_col = range[1]
    "\{\"range\":\{\"start\":\{\"line\":" + str(line_num) + ",\"character\":" + str(start_col) + "\},\"end\":\{\"line\":" + str(line_num) + ",\"character\":" + str(end_col) + "\}\}\}"

// ── Folding ranges — NOVA is indentation-based (no braces), so a foldable
// region is exactly: a line, followed by one or more lines indented DEEPER
// than it. The fold spans from that line to the last contiguous line at (or
// below, via nesting) that deeper indent -- i.e. everything before the next
// line that returns to the original indent level or shallower. ──
fn _lsp_indent_of(line: string) -> int
    let i = 0
    let n = len(line)
    while i < n
        let c = line[i]
        if c != " " and c != "\t"
            break
        i = i + 1
    i

fn lsp_folding_ranges(docs: dict, uri: string) -> string
    if not contains(docs, uri)
        return "[]"
    let source = docs[uri]
    let lines = split(source, "\n")
    let n = len(lines)
    let indents = []
    let i = 0
    while i < n
        let trimmed = trim(lines[i])
        if len(trimmed) == 0
            push(indents, -1)
        else
            push(indents, _lsp_indent_of(lines[i]))
        i = i + 1
    let items = []
    i = 0
    while i < n
        let cur = indents[i]
        if cur >= 0
            let j = i + 1
            let deepest_end = i
            while j < n
                let ind = indents[j]
                if ind == -1
                    j = j + 1
                    continue
                if ind > cur
                    deepest_end = j
                    j = j + 1
                else
                    break
            if deepest_end > i
                push(items, "\{\"startLine\":" + str(i) + ",\"endLine\":" + str(deepest_end) + "\}")
        i = i + 1
    "[" + join(items, ",") + "]"

// ── Signature help — parameter hints while typing a function call. Scans
// backward from the cursor on the CURRENT LINE ONLY (multi-line call sites
// are a known, intentionally scoped-out limitation) to find the enclosing
// unmatched '(' and count top-level commas before the cursor for the active
// parameter index, then looks up the callee's signature the same way hover
// already does (a same-file "fn name(" line scan). ──
fn lsp_find_fn_line(docs: dict, uri: string, name: string) -> string
    if not contains(docs, uri)
        return ""
    let source = docs[uri]
    let lines = split(source, "\n")
    let i = 0
    while i < len(lines)
        let line = trim(lines[i])
        if starts_with(line, "fn " + name + "(") or starts_with(line, "fn " + name + "<")
            return line
        i = i + 1
    ""

fn lsp_signature_help_response(docs: dict, uri: string, line_num: int, col: int) -> string
    if not contains(docs, uri)
        return "null"
    let source = docs[uri]
    let lines = split(source, "\n")
    if line_num >= len(lines)
        return "null"
    let line = lines[line_num]
    let prefix = slice(line, 0, col)
    let depth = 0
    let call_start = -1
    let active_param = 0
    let i = len(prefix) - 1
    while i >= 0
        let c = prefix[i]
        if c == ")"
            depth = depth + 1
        else if c == "("
            if depth == 0
                call_start = i
                break
            depth = depth - 1
        else if c == "," and depth == 0
            active_param = active_param + 1
        i = i - 1
    if call_start < 0
        return "null"
    let ident_end = call_start
    let ident_start = ident_end
    while ident_start > 0
        let ch = ord(prefix[ident_start - 1])
        let is_id = (ch >= 48 and ch <= 57) or (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or ch == 95
        if not is_id
            break
        ident_start = ident_start - 1
    let fn_name = slice(prefix, ident_start, ident_end)
    if len(fn_name) == 0
        return "null"
    let sig_line = lsp_find_fn_line(docs, uri, fn_name)
    if len(sig_line) == 0
        return "null"
    let paren = find(sig_line, "(")
    let close = find(sig_line, ")")
    if paren < 0 or close < 0 or close < paren
        return "null"
    let params_str = slice(sig_line, paren + 1, close)
    let param_parts = split(params_str, ",")
    let param_items = []
    for p in param_parts
        let pt = trim(p)
        if len(pt) > 0
            push(param_items, "\{\"label\":\"" + lsp_escape_json(pt) + "\"\}")
    let sig_label = lsp_escape_json(sig_line)
    "\{\"signatures\":[\{\"label\":\"" + sig_label + "\",\"parameters\":[" + join(param_items, ",") + "]\}],\"activeParameter\":" + str(active_param) + ",\"activeSignature\":0\}"

// ── Formatting — string-in/string-out wrapper over the #34 AST-reprint formatter.
// nova_fmt_file_ast is hardwired to read_file/write_file (it was built CLI-only),
// so this mirrors its EXACT gate sequence against an in-memory buffer instead:
//   Gate A (faithfulness): parse(orig) == parse(reprint)  -- structural AST equality
//   Gate B (comments):     comment multiset preserved
// Any gate failure returns "" meaning "decline to format" -- the LSP then sends no
// edit at all, which is strictly safer than the CLI's whitespace-normalizer fallback
// (silently reflowing a file the user asked to format is fine; silently reflowing on
// every editor save is not). ──
fn lsp_format_source(source: string) -> string
    if len(source) == 0
        return ""
    let tokens1 = tokenize(source)
    let pe1 = []
    let stmts1 = fmt_parse_raw(tokens1, pe1)
    if len(pe1) > 0
        return ""
    let ctx = {}
    ctx["unsupported"] = 0
    let comments1 = fmt_collect_comments(source, ctx)
    if ctx["unsupported"] == 1
        return ""
    let src2 = fmt_reprint(stmts1, comments1, ctx)
    if ctx["unsupported"] == 1
        return ""
    if len(src2) == 0 and len(stmts1) > 0
        return ""
    let tokens2 = tokenize(src2)
    let pe2 = []
    let stmts2 = fmt_parse_raw(tokens2, pe2)
    if len(pe2) > 0
        return ""
    if not fmt_ast_equal_list(stmts1, stmts2)
        return ""
    let ctx2 = {}
    ctx2["unsupported"] = 0
    let comments2 = fmt_collect_comments(src2, ctx2)
    if ctx2["unsupported"] == 1
        return ""
    let texts1 = fmt_comment_texts(comments1)
    let texts2 = fmt_comment_texts(comments2)
    if len(texts1) != len(texts2)
        return ""
    let ti = 0
    while ti < len(texts1)
        if texts1[ti] != texts2[ti]
            return ""
        ti = ti + 1
    src2

fn lsp_formatting_response(docs: dict, uri: string) -> string
    if not contains(docs, uri)
        return "null"
    let source = docs[uri]
    let formatted = lsp_format_source(source)
    if len(formatted) == 0
        return "null"
    if formatted == source
        return "[]"
    // One whole-document replace. The end position is deliberately far past any real
    // line/column so the edit covers the entire buffer regardless of its length.
    let lines = split(source, "\n")
    let last_line = len(lines)
    "[\{\"range\":\{\"start\":\{\"line\":0,\"character\":0\},\"end\":\{\"line\":" + str(last_line) + ",\"character\":0\}\},\"newText\":\"" + lsp_escape_json(formatted) + "\"\}]"

// ── Workspace-wide index ───────────────────────────────────────────────────
// dir_walk returns every file AND directory under the root, full-path, flattened.
// We filter to .nova sources and skip the directories a source index must never
// descend into (VCS internals, build output, vendored deps) -- dir_walk itself
// skips only "." and "..", so without this a workspace scan would read thousands
// of irrelevant files and blow up the request latency.
fn _lsp_ws_skip(path: string) -> bool
    contains(path, "\\.git\\") or contains(path, "/.git/") or contains(path, "\\node_modules\\") or contains(path, "/node_modules/") or contains(path, "\\build\\") or contains(path, "/build/") or contains(path, "\\.gradle\\") or contains(path, "/.gradle/") or contains(path, "\\output\\") or contains(path, "/output/") or contains(path, "\\nova_packages\\") or contains(path, "/nova_packages/")

fn lsp_workspace_nova_files(root: string) -> list
    if len(root) == 0
        return []
    let all = dir_walk(root)
    [f for f in all if ends_with(f, ".nova") and not _lsp_ws_skip(f)]

fn _lsp_path_to_uri(path: string) -> string
    let p = replace(path, "\\", "/")
    if not starts_with(p, "/")
        p = "/" + p
    "file://" + p

// Every top-level declaration in `source`, as [name, kind, line] triples. Shared by
// workspace/symbol and the cross-file reference/rename scan so one definition of
// "what counts as a declaration" serves both.
fn _lsp_decls_in(source: string) -> list
    let out = []
    let lines = split(source, "\n")
    let i = 0
    while i < len(lines)
        let line = trim(lines[i])
        let nm = ""
        let kind = 0
        if starts_with(line, "fn ")
            let after = slice(line, 3, len(line))
            let stop = len(after)
            let paren = find(after, "(")
            let langle = find(after, "<")
            if paren >= 0 and paren < stop
                stop = paren
            if langle >= 0 and langle < stop
                stop = langle
            let cand = trim(slice(after, 0, stop))
            if len(cand) > 0 and find(cand, " ") < 0
                nm = cand
                if find(cand, ".") >= 0
                    kind = 6
                else
                    kind = 12
        else if starts_with(line, "type ") or starts_with(line, "enum ") or starts_with(line, "trait ")
            let kw_len = 5
            if starts_with(line, "trait ")
                kw_len = 6
            let after = trim(slice(line, kw_len, len(line)))
            let stop = len(after)
            let sp = find(after, " ")
            let langle = find(after, "<")
            if sp >= 0 and sp < stop
                stop = sp
            if langle >= 0 and langle < stop
                stop = langle
            let cand = slice(after, 0, stop)
            if len(cand) > 0
                nm = cand
                if starts_with(line, "type ")
                    kind = 23
                else if starts_with(line, "enum ")
                    kind = 10
                else
                    kind = 11
        if len(nm) > 0
            push(out, [nm, kind, i])
        i = i + 1
    out

// workspace/symbol — Ctrl+T "jump to any symbol in the project". `query` is matched
// case-insensitively as a SUBSTRING (what editors expect from this endpoint), and
// results are capped so a one-character query on a large repo cannot return tens of
// thousands of entries and stall the editor. The cap is reported honestly in the
// server log rather than silently truncating.
fn lsp_workspace_symbols(root: string, query: string) -> string
    let files = lsp_workspace_nova_files(root)
    let q = lower(query)
    let items = []
    let cap = 500
    for f in files
        if len(items) >= cap
            break
        let content = read_file(f)
        if len(content) == 0
            continue
        let uri = _lsp_path_to_uri(f)
        for d in _lsp_decls_in(content)
            if len(items) >= cap
                break
            let nm = d[0]
            if len(q) > 0 and not contains(lower(nm), q)
                continue
            let kind = d[1]
            let ln = d[2]
            push(items, "\{\"name\":\"" + lsp_escape_json(nm) + "\",\"kind\":" + str(kind) + ",\"location\":\{\"uri\":\"" + lsp_escape_json(uri) + "\",\"range\":\{\"start\":\{\"line\":" + str(ln) + ",\"character\":0\},\"end\":\{\"line\":" + str(ln) + ",\"character\":0\}\}\}\}")
    if len(items) >= cap
        write_raw("[nova-lsp] workspace/symbol: capped at " + str(cap) + " results for query '" + query + "'\n")
    "[" + join(items, ",") + "]"

// Token-based occurrences of `word` in one source string (same rule as the
// same-file scan: IDENT tokens only, so comments/strings can never match).
fn _lsp_refs_in_source(source: string, word: string) -> list
    let refs = []
    let tokens = tokenize(source)
    for tok in tokens
        match tok
            Token(tk_kind, tk_val, tk_line, tk_col) =>
                if tk_kind == "IDENT" and tk_val == word
                    push(refs, [tk_line - 1, tk_col - 1])
    refs

// Workspace-wide references. `docs` takes precedence over on-disk content for any
// file that is currently OPEN in the editor -- otherwise an unsaved buffer would be
// scanned in its stale on-disk form and the user would get wrong positions.
// Applies the SAME import-scope filter as lsp_workspace_rename (see the long note
// there): a file that merely reuses the identifier for its own local is not a
// reference to THIS symbol, so listing it would be a false positive.
fn lsp_workspace_references(docs: dict, root: string, word: string, decl_uri: string) -> string
    if len(word) == 0
        return "[]"
    let decl_mod = _lsp_module_name_of(lsp_uri_to_path(decl_uri))
    let files = lsp_workspace_nova_files(root)
    let items = []
    for f in files
        let uri = _lsp_path_to_uri(f)
        let content = ""
        if contains(docs, uri) and len(docs[uri]) > 0
            content = docs[uri]
        else
            content = read_file(f)
        if len(content) == 0
            continue
        let is_decl_file = (_lsp_module_name_of(f) == decl_mod)
        if not is_decl_file and not _lsp_imports_module(content, decl_mod)
            continue
        for r in _lsp_refs_in_source(content, word)
            let rl = r[0]
            let rc = r[1]
            push(items, "\{\"uri\":\"" + lsp_escape_json(uri) + "\",\"range\":\{\"start\":\{\"line\":" + str(rl) + ",\"character\":" + str(rc) + "\},\"end\":\{\"line\":" + str(rl) + ",\"character\":" + str(rc + len(word)) + "\}\}\}")
    "[" + join(items, ",") + "]"

// The module name a file provides, i.e. its basename without ".nova" -- that is
// exactly what another file writes after `import`.
fn _lsp_module_name_of(path: string) -> string
    let last = -1
    let k = 0
    while k < len(path)
        let c = path[k]
        if c == "/" or c == "\\"
            last = k
        k = k + 1
    let base = slice(path, last + 1, len(path))
    if ends_with(base, ".nova")
        return slice(base, 0, len(base) - 5)
    base

// Does `source` import module `mod_name`?
fn _lsp_imports_module(source: string, mod_name: string) -> bool
    for raw in split(source, "\n")
        let t = trim(raw)
        if not starts_with(t, "import ")
            continue
        let rest = trim(slice(t, 7, len(t)))
        let name = rest
        let sp = find(rest, " ")
        if sp >= 0
            name = slice(rest, 0, sp)
        if name == mod_name
            return true
        // `import a/b/c` -- the module's own name is the last path segment.
        let seg_last = -1
        let i = 0
        while i < len(name)
            if name[i] == "/"
                seg_last = i
            i = i + 1
        if seg_last >= 0 and slice(name, seg_last + 1, len(name)) == mod_name
            return true
    false

// Workspace-wide rename: one WorkspaceEdit with a per-file edit list. Same
// open-buffer-wins rule as references above.
//
// SCOPE SAFETY -- the reason this is not just "rename every matching IDENT":
// occurrences are matched by NAME, and NOVA has no cross-file scope resolution
// here, so a local variable in an unrelated file that happens to share the name
// would be silently renamed too (measured: renaming a fn `count` also rewrote 4
// occurrences of an unrelated local `count` in another file). Renaming a common
// name like `count`/`result` across a large repo would corrupt many files at once
// and the user would have no idea until compile time.
// So the edit set is restricted to files that can actually SEE the declaration:
//   - the file that declares it, and
//   - files that `import` that module.
// A file that merely happens to use the same identifier for its own local is left
// alone. This under-approximates in one direction only (it may MISS a rename in a
// file that reaches the symbol some other way) which is the safe direction to err:
// a missed rename is a compile error the user sees immediately, whereas a wrong
// rename is silent corruption.
fn lsp_workspace_rename(docs: dict, root: string, word: string, new_name: string, decl_uri: string) -> string
    if len(word) == 0 or len(new_name) == 0
        return "null"
    let decl_path = lsp_uri_to_path(decl_uri)
    let decl_mod = _lsp_module_name_of(decl_path)
    let files = lsp_workspace_nova_files(root)
    let file_entries = []
    let skipped = 0
    for f in files
        let uri = _lsp_path_to_uri(f)
        let content = ""
        if contains(docs, uri) and len(docs[uri]) > 0
            content = docs[uri]
        else
            content = read_file(f)
        if len(content) == 0
            continue
        let refs = _lsp_refs_in_source(content, word)
        if len(refs) == 0
            continue
        // Only the declaring file itself, or a file importing that module, may be edited.
        let is_decl_file = (_lsp_module_name_of(f) == decl_mod)
        if not is_decl_file and not _lsp_imports_module(content, decl_mod)
            skipped = skipped + 1
            continue
        let edits = []
        for r in refs
            let rl = r[0]
            let rc = r[1]
            push(edits, "\{\"range\":\{\"start\":\{\"line\":" + str(rl) + ",\"character\":" + str(rc) + "\},\"end\":\{\"line\":" + str(rl) + ",\"character\":" + str(rc + len(word)) + "\}\},\"newText\":\"" + lsp_escape_json(new_name) + "\"\}")
        push(file_entries, "\"" + lsp_escape_json(uri) + "\":[" + join(edits, ",") + "]")
    if skipped > 0
        write_raw("[nova-lsp] rename '" + word + "': skipped " + str(skipped) + " file(s) that use the name but do not import '" + decl_mod + "' (out of scope)\n")
    if len(file_entries) == 0
        return "null"
    "\{\"changes\":\{" + join(file_entries, ",") + "\}\}"

// ── Semantic tokens — IDENT classification for rich syntax highlighting ────
// Classifies identifiers as function/type/variable/property by cross-referencing
// against the builtin registry, file-local declarations, and positional context.
// Token type legend (indices must match the capability advertisement):
//   0=keyword 1=type 2=function 3=variable 4=property 5=enumMember 6=number 7=string 8=decorator
fn lsp_semantic_tokens(docs: dict, uri: string, builtin_set: dict) -> string
    if not contains(docs, uri)
        return "\{\"data\":[]}"
    let source = docs[uri]
    let tokens = tokenize(source)
    // Build sets of type names and function names from declarations
    let type_set = {}
    let fn_set = {}
    let slines = split(source, "\n")
    let si = 0
    while si < len(slines)
        let sline = trim(slines[si])
        if starts_with(sline, "type ") or starts_with(sline, "enum ") or starts_with(sline, "trait ")
            let skw = 5
            if starts_with(sline, "trait ")
                skw = 6
            let safter = trim(slice(sline, skw, len(sline)))
            let sstop = len(safter)
            let ssp = find(safter, " ")
            let sla = find(safter, "<")
            if ssp > 0 and ssp < sstop
                sstop = ssp
            if sla > 0 and sla < sstop
                sstop = sla
            let snm = slice(safter, 0, sstop)
            if len(snm) > 0
                type_set[snm] = 1
        else if starts_with(sline, "fn ")
            let safter = slice(sline, 3, len(sline))
            let sstop = len(safter)
            let spa = find(safter, "(")
            let sla = find(safter, "<")
            if spa > 0 and spa < sstop
                sstop = spa
            if sla > 0 and sla < sstop
                sstop = sla
            let snm = trim(slice(safter, 0, sstop))
            if len(snm) > 0 and find(snm, " ") < 0
                // Strip the type prefix for methods like Type.method
                let sdot = find(snm, ".")
                if sdot < 0
                    fn_set[snm] = 1
                else
                    fn_set[snm] = 1
                    let meth_part = slice(snm, sdot + 1, len(snm))
                    if len(meth_part) > 0
                        fn_set[meth_part] = 1
        si = si + 1
    // Pass 1: collect classified tokens as [line, col, len, type] inside match (push only)
    let raw_st = []
    for tok in tokens
        match tok
            Token(tk_kind, tk_val, tk_line, tk_col) =>
                let ttype = -1
                if tk_kind == "KW"
                    ttype = 0
                else if tk_kind == "IDENT"
                    if contains(type_set, tk_val)
                        ttype = 1
                    else if contains(fn_set, tk_val) or contains(builtin_set, tk_val)
                        ttype = 2
                    else
                        ttype = 3
                else if tk_kind == "INT" or tk_kind == "FLOAT"
                    ttype = 6
                else if tk_kind == "AT"
                    ttype = 8
                if ttype >= 0
                    push(raw_st, [tk_line - 1, tk_col - 1, len(tk_val), ttype])
    // Pass 2: delta-encode with explicit int() casts (any -> int)
    let st_parts = []
    let sti = 0
    while sti < len(raw_st)
        let cur = raw_st[sti]
        let cl = int(cur[0])
        let cc = int(cur[1])
        let clen = int(cur[2])
        let ctype = int(cur[3])
        let p_l = 0
        let p_c = 0
        if sti > 0
            let prev = raw_st[sti - 1]
            p_l = int(prev[0])
            p_c = int(prev[1])
        let dl = cl - p_l
        let dc = cc
        if dl == 0
            dc = cc - p_c
        push(st_parts, str(dl) + "," + str(dc) + "," + str(clen) + "," + str(ctype) + ",0")
        sti = sti + 1
    "\{\"data\":[" + join(st_parts, ",") + "]\}"

fn lsp_server_main()
    write_raw("NOVA LSP server started\n")
    let docs = {}
    // Build the stdlib once at startup — used for completions and semantic tokens
    let stdlib = ti_build_stdlib()
    let builtin_names = keys(stdlib)
    let builtin_set = {}
    for bn in builtin_names
        builtin_set[bn] = 1
    write_raw("[nova-lsp] loaded " + str(len(builtin_names)) + " builtins for completions\n")
    // Workspace root, captured from the initialize request. Empty until then, and the
    // workspace-wide handlers degrade to "no results" rather than scanning the whole
    // filesystem if the client never sends one.
    let ws_root = ""
    let running = true
    while running
        let body = lsp_read_message()
        if body == ""
            continue
        let msg = json_parse(body)
        let method = ""
        let id = 0
        let has_id = false
        if contains(msg, "method")
            method = msg["method"]
        if contains(msg, "id")
            id = msg["id"]
            has_id = true
        if method == "initialize"
            // Capture the workspace root for the workspace-wide handlers. Prefer
            // workspaceFolders[0] (the modern field) and fall back to the deprecated
            // rootUri, which older clients still send.
            if contains(msg, "params")
                let iparams = msg["params"]
                if contains(iparams, "workspaceFolders")
                    let folders = iparams["workspaceFolders"]
                    if len(folders) > 0
                        let f0 = folders[0]
                        if contains(f0, "uri")
                            ws_root = lsp_uri_to_path(f0["uri"])
                if ws_root == "" and contains(iparams, "rootUri")
                    let ru = iparams["rootUri"]
                    if ru != ""
                        ws_root = lsp_uri_to_path(ru)
                if ws_root == "" and contains(iparams, "rootPath")
                    ws_root = iparams["rootPath"]
            write_raw("[nova-lsp] workspace root: " + ws_root + "\n")
            if ws_root != "" and env("NOVA_HOME") == ""
                let nh_candidate = path_join(ws_root, "nova-compiler")
                if path_exists(path_join(nh_candidate, "lib"))
                    set_env("NOVA_HOME", nh_candidate)
                    write_raw("[nova-lsp] auto-set NOVA_HOME=" + nh_candidate + "\n")
                else
                    let parent = path_parent(ws_root)
                    if parent != "" and parent != ws_root
                        let nh_parent = path_join(parent, "nova-compiler")
                        if path_exists(path_join(nh_parent, "lib"))
                            set_env("NOVA_HOME", nh_parent)
                            write_raw("[nova-lsp] auto-set NOVA_HOME=" + nh_parent + " (from parent)\n")
            let caps = "\{\"capabilities\":\{\"textDocumentSync\":\{\"openClose\":true,\"change\":1,\"save\":\{\"includeText\":true\}\},\"hoverProvider\":true,\"definitionProvider\":true,\"completionProvider\":\{\"triggerCharacters\":[\".\"],\"resolveProvider\":false\},\"documentSymbolProvider\":true,\"referencesProvider\":true,\"renameProvider\":\{\"prepareProvider\":true\},\"documentHighlightProvider\":true,\"foldingRangeProvider\":true,\"signatureHelpProvider\":\{\"triggerCharacters\":[\"(\",\",\"]\},\"documentFormattingProvider\":true,\"workspaceSymbolProvider\":true,\"semanticTokensProvider\":\{\"legend\":\{\"tokenTypes\":[\"keyword\",\"type\",\"function\",\"variable\",\"property\",\"enumMember\",\"number\",\"string\",\"decorator\"],\"tokenModifiers\":[\"declaration\",\"definition\"]\},\"full\":true\}\}\}"
            lsp_respond(id, caps)
        else if method == "initialized"
            write_raw("NOVA LSP initialized\n")
        else if method == "shutdown"
            lsp_respond(id, "null")
        else if method == "exit"
            running = false
        else if method == "textDocument/didOpen"
            let params = msg["params"]
            let td = params["textDocument"]
            let uri = td["uri"]
            let text = td["text"]
            docs[uri] = text
            let fpath = lsp_uri_to_path(uri)
            lsp_publish_diagnostics(uri, text, fpath)
        else if method == "textDocument/didChange"
            let params = msg["params"]
            let td = params["textDocument"]
            let uri = td["uri"]
            let changes = params["contentChanges"]
            if len(changes) > 0
                let text = changes[0]["text"]
                docs[uri] = text
                let fpath = lsp_uri_to_path(uri)
                lsp_publish_diagnostics(uri, text, fpath)
        else if method == "textDocument/didSave"
            let params = msg["params"]
            let td = params["textDocument"]
            let uri = td["uri"]
            if contains(params, "text")
                docs[uri] = params["text"]
            if contains(docs, uri)
                let fpath = lsp_uri_to_path(uri)
                lsp_publish_diagnostics(uri, docs[uri], fpath)
        else if method == "textDocument/didClose"
            let params = msg["params"]
            let td = params["textDocument"]
            let uri = td["uri"]
            if contains(docs, uri)
                docs[uri] = ""
            lsp_notify("textDocument/publishDiagnostics", "\{\"uri\":\"" + lsp_escape_json(uri) + "\",\"diagnostics\":[]\}")
        else if method == "textDocument/hover"
            if has_id
                let hparams = msg["params"]
                let htd = hparams["textDocument"]
                let huri = htd["uri"]
                let hpos = hparams["position"]
                let hline = hpos["line"]
                let hcol = hpos["character"]
                let hword = lsp_get_word_at(docs, huri, hline, hcol)
                if hword != ""
                    let htype = lsp_infer_type_hint(docs, huri, hword)
                    if htype != ""
                        let hover_md = "```nova\n" + hword + " : " + htype + "\n```"
                        lsp_respond(id, "\{\"contents\":\{\"kind\":\"markdown\",\"value\":\"" + lsp_escape_json(hover_md) + "\"\}\}")
                    else
                        lsp_respond(id, "\{\"contents\":\{\"kind\":\"markdown\",\"value\":\"" + lsp_escape_json(hword) + "\"\}\}")
                else
                    lsp_respond(id, "null")
        else if method == "textDocument/definition"
            if has_id
                let dparams = msg["params"]
                let dtd = dparams["textDocument"]
                let duri = dtd["uri"]
                let dpos = dparams["position"]
                let dline = dpos["line"]
                let dcol = dpos["character"]
                let dword = lsp_get_word_at(docs, duri, dline, dcol)
                let ddef = lsp_find_definition(docs, duri, dword)
                if ddef >= 0
                    let dloc = "\{\"uri\":\"" + lsp_escape_json(duri) + "\",\"range\":\{\"start\":\{\"line\":" + str(ddef) + ",\"character\":0\},\"end\":\{\"line\":" + str(ddef) + ",\"character\":0\}\}\}"
                    lsp_respond(id, dloc)
                else
                    let dcross = lsp_find_in_imports(docs, duri, dword)
                    if dcross["found"] == 1
                        let cross_uri = dcross["uri"]
                        let cross_line = dcross["line"]
                        let dloc = "\{\"uri\":\"" + lsp_escape_json(cross_uri) + "\",\"range\":\{\"start\":\{\"line\":" + str(cross_line) + ",\"character\":0\},\"end\":\{\"line\":" + str(cross_line) + ",\"character\":0\}\}\}"
                        lsp_respond(id, dloc)
                    else
                        lsp_respond(id, "null")
        else if method == "textDocument/completion"
            if has_id
                let cparams = msg["params"]
                let ctd = cparams["textDocument"]
                let curi = ctd["uri"]
                let citems = lsp_get_completions(docs, curi, builtin_names)
                lsp_respond(id, "\{\"isIncomplete\":false,\"items\":[" + citems + "]\}")
        else if method == "textDocument/documentSymbol"
            if has_id
                let sparams = msg["params"]
                let std = sparams["textDocument"]
                let suri = std["uri"]
                lsp_respond(id, lsp_get_document_symbols(docs, suri))
        else if method == "textDocument/references"
            if has_id
                let rparams = msg["params"]
                let rtd = rparams["textDocument"]
                let ruri = rtd["uri"]
                let rpos = rparams["position"]
                let rline = rpos["line"]
                let rcol = rpos["character"]
                let rword = lsp_get_word_at(docs, ruri, rline, rcol)
                if rword != ""
                    // Workspace-wide when we know the root; same-file otherwise.
                    if ws_root != ""
                        lsp_respond(id, lsp_workspace_references(docs, ws_root, rword, ruri))
                    else
                        lsp_respond(id, lsp_references_response(docs, ruri, rword))
                else
                    lsp_respond(id, "[]")
        else if method == "textDocument/rename"
            if has_id
                let nparams = msg["params"]
                let ntd = nparams["textDocument"]
                let nuri = ntd["uri"]
                let npos = nparams["position"]
                let nline = npos["line"]
                let ncol = npos["character"]
                let nnew = nparams["newName"]
                let nword = lsp_get_word_at(docs, nuri, nline, ncol)
                if nword != "" and nnew != ""
                    if ws_root != ""
                        lsp_respond(id, lsp_workspace_rename(docs, ws_root, nword, nnew, nuri))
                    else
                        lsp_respond(id, lsp_rename_response(docs, nuri, nword, nnew))
                else
                    lsp_respond(id, "null")
        else if method == "textDocument/prepareRename"
            if has_id
                let pparams = msg["params"]
                let ptd = pparams["textDocument"]
                let puri = ptd["uri"]
                let ppos = pparams["position"]
                let pline = ppos["line"]
                let pcol = ppos["character"]
                lsp_respond(id, lsp_prepare_rename_response(docs, puri, pline, pcol))
        else if method == "textDocument/documentHighlight"
            if has_id
                let hlparams = msg["params"]
                let hltd = hlparams["textDocument"]
                let hluri = hltd["uri"]
                let hlpos = hlparams["position"]
                let hlline = hlpos["line"]
                let hlcol = hlpos["character"]
                let hlword = lsp_get_word_at(docs, hluri, hlline, hlcol)
                if hlword != ""
                    lsp_respond(id, lsp_highlight_response(docs, hluri, hlword))
                else
                    lsp_respond(id, "[]")
        else if method == "textDocument/foldingRange"
            if has_id
                let fparams = msg["params"]
                let ftd = fparams["textDocument"]
                let furi = ftd["uri"]
                lsp_respond(id, lsp_folding_ranges(docs, furi))
        else if method == "textDocument/signatureHelp"
            if has_id
                let shparams = msg["params"]
                let shtd = shparams["textDocument"]
                let shuri = shtd["uri"]
                let shpos = shparams["position"]
                let shline = shpos["line"]
                let shcol = shpos["character"]
                lsp_respond(id, lsp_signature_help_response(docs, shuri, shline, shcol))
        else if method == "textDocument/formatting"
            if has_id
                let fmparams = msg["params"]
                let fmtd = fmparams["textDocument"]
                let fmuri = fmtd["uri"]
                lsp_respond(id, lsp_formatting_response(docs, fmuri))
        else if method == "workspace/symbol"
            if has_id
                let wsparams = msg["params"]
                let wsq = ""
                if contains(wsparams, "query")
                    wsq = wsparams["query"]
                if ws_root == ""
                    lsp_respond(id, "[]")
                else
                    lsp_respond(id, lsp_workspace_symbols(ws_root, wsq))
        else if method == "textDocument/semanticTokens/full"
            if has_id
                let stparams = msg["params"]
                let sttd = stparams["textDocument"]
                let sturi = sttd["uri"]
                lsp_respond(id, lsp_semantic_tokens(docs, sturi, builtin_set))
        else if has_id
            lsp_error_response(id, -32601, "Method not found: " + method)

// #30 real interpreter: a tree-walking evaluator over the AST — instant expression eval with
// NO LLVM compile (the `nova eval` command + the foundation for an interpreted REPL/notebook).
// Returns an `any` (int/float/str/bool), reusing NOVA's dynamic operators on the evaluated
// operands. env maps variable name -> value (empty for a single `nova eval`; the REPL session
// would thread accumulated bindings). Unsupported forms report and return 0 (fall back to
// `nova run` for full programs).
fn eval_expr(env: dict, e: Expr) -> any
    match e
        Expr(et, ev, en, ec, ef, eln) =>
            if et == "int"
                return en
            if et == "float"
                return parse_float(ev)
            if et == "str" or et == "string"
                return ev
            if et == "bool"
                if ev == "true"
                    return true
                return false
            if et == "ident"
                if ev == "true"
                    return true
                if ev == "false"
                    return false
                if contains(env, ev)
                    return env[ev]
                print("eval error: unknown variable '" + ev + "'")
                return 0
            if et == "unary"
                let uv = eval_expr(env, ec[0])
                if ev == "-"
                    return 0 - uv
                if ev == "not"
                    return not uv
                return uv
            if et == "binop"
                let lv = eval_expr(env, ec[0])
                let rv = eval_expr(env, ec[1])
                if ev == "+"
                    return lv + rv
                if ev == "-"
                    return lv - rv
                if ev == "*"
                    return lv * rv
                if ev == "/"
                    return lv / rv
                if ev == "%"
                    return lv % rv
                if ev == "<"
                    return lv < rv
                if ev == ">"
                    return lv > rv
                if ev == "<="
                    return lv <= rv
                if ev == ">="
                    return lv >= rv
                if ev == "=="
                    return lv == rv
                if ev == "!="
                    return lv != rv
                if ev == "and"
                    return lv and rv
                if ev == "or"
                    return lv or rv
                print("eval error: unsupported operator '" + ev + "'")
                return 0
            if et == "call"
                if ev == "str" and len(ec) == 1
                    return str(eval_expr(env, ec[0]))
                if ev == "len" and len(ec) == 1
                    return len(eval_expr(env, ec[0]))
                if ev == "abs" and len(ec) == 1
                    let cv = eval_expr(env, ec[0])
                    if cv < 0
                        return 0 - cv
                    return cv
                print("eval error: cannot interpret call '" + ev + "()' — use `nova run` for full programs")
                return 0
            print("eval error: cannot interpret this expression — use `nova run`")
            return 0

// ── #35 compile-time const evaluation (const-fn-eval) ──────────────────────
// A kind-tracking tree interpreter for folding `const X = <pure call>` to a literal
// at compile time. SOUNDNESS by construction: values are computed with NOVA's OWN
// operators (identical runtime semantics incl. i64 wraparound), and the KIND is tracked
// through evaluation (not introspected — is_int/etc. are compile-time-only and bools are
// raw i64 at the `any` level, indistinguishable from ints). v1 folds INT results only.
// Fails CLOSED on anything uncertain (unknown ident/call/stmt, complex assign, arity
// mismatch, div-by-zero, side-effecting builtins, budget exhaustion) → runtime fallback.
type CeVal
    kind: string
    v: any

fn ce_fail(ctl: dict) -> CeVal
    ctl["failed"] = true
    CeVal("fail", 0)

fn ce_budget_ok(ctl: dict) -> bool
    if ctl["failed"]
        return false
    let b = ctl["budget"]
    if b <= 0
        ctl["failed"] = true
        return false
    ctl["budget"] = b - 1
    true

fn ce_eval_expr(ctl: dict, env: dict, fns: dict, e: Expr) -> CeVal
    if not ce_budget_ok(ctl)
        return CeVal("fail", 0)
    match e
        Expr(et, ev, en, ec, ef, eln) =>
            if et == "int"
                return CeVal("int", en)
            if et == "float"
                return CeVal("float", parse_float(ev))
            if et == "str" or et == "string"
                return CeVal("str", ev)
            if et == "bool"
                if ev == "true"
                    return CeVal("bool", true)
                return CeVal("bool", false)
            if et == "ident"
                if ev == "true"
                    return CeVal("bool", true)
                if ev == "false"
                    return CeVal("bool", false)
                if contains(env, ev)
                    return env[ev]
                return ce_fail(ctl)
            if et == "unary"
                let u = ce_eval_expr(ctl, env, fns, ec[0])
                if ctl["failed"]
                    return u
                if ev == "-"
                    if u.kind == "int"
                        return CeVal("int", 0 - u.v)
                    if u.kind == "float"
                        return CeVal("float", 0.0 - u.v)
                    return ce_fail(ctl)
                if ev == "not"
                    return CeVal("bool", not u.v)
                return ce_fail(ctl)
            if et == "binop"
                if ev == "and"
                    let la = ce_eval_expr(ctl, env, fns, ec[0])
                    if ctl["failed"]
                        return la
                    if not la.v
                        return CeVal("bool", false)
                    let ra = ce_eval_expr(ctl, env, fns, ec[1])
                    if ctl["failed"]
                        return ra
                    if ra.v
                        return CeVal("bool", true)
                    return CeVal("bool", false)
                if ev == "or"
                    let lo = ce_eval_expr(ctl, env, fns, ec[0])
                    if ctl["failed"]
                        return lo
                    if lo.v
                        return CeVal("bool", true)
                    let ro = ce_eval_expr(ctl, env, fns, ec[1])
                    if ctl["failed"]
                        return ro
                    if ro.v
                        return CeVal("bool", true)
                    return CeVal("bool", false)
                let l = ce_eval_expr(ctl, env, fns, ec[0])
                if ctl["failed"]
                    return l
                let r = ce_eval_expr(ctl, env, fns, ec[1])
                if ctl["failed"]
                    return r
                if ev == "<"
                    return CeVal("bool", l.v < r.v)
                if ev == ">"
                    return CeVal("bool", l.v > r.v)
                if ev == "<="
                    return CeVal("bool", l.v <= r.v)
                if ev == ">="
                    return CeVal("bool", l.v >= r.v)
                if ev == "=="
                    return CeVal("bool", l.v == r.v)
                if ev == "!="
                    return CeVal("bool", l.v != r.v)
                let rk = "int"
                if l.kind == "float" or r.kind == "float"
                    rk = "float"
                if l.kind == "str" or r.kind == "str"
                    rk = "str"
                if ev == "+"
                    return CeVal(rk, l.v + r.v)
                if ev == "-"
                    return CeVal(rk, l.v - r.v)
                if ev == "*"
                    return CeVal(rk, l.v * r.v)
                if ev == "/"
                    if rk == "int" and r.v == 0
                        return ce_fail(ctl)
                    return CeVal(rk, l.v / r.v)
                if ev == "%"
                    if r.v == 0
                        return ce_fail(ctl)
                    return CeVal(rk, l.v % r.v)
                return ce_fail(ctl)
            if et == "call"
                return ce_eval_call(ctl, env, fns, ev, ec)
            return ce_fail(ctl)

fn ce_eval_call(ctl: dict, env: dict, fns: dict, fname: string, argexprs: list) -> CeVal
    if fname == "abs" and len(argexprs) == 1
        let a = ce_eval_expr(ctl, env, fns, argexprs[0])
        if ctl["failed"]
            return a
        if a.kind == "int"
            if a.v < 0
                return CeVal("int", 0 - a.v)
            return CeVal("int", a.v)
        return ce_fail(ctl)
    if contains(fns, fname)
        let fstmt = fns[fname]
        match fstmt
            Stmt(st, sn, se, sb, sp, sel, san, sl) =>
                if len(sp) != len(argexprs)
                    return ce_fail(ctl)
                let callenv = {}
                let ai = 0
                for p in sp
                    match p
                        Param(pn, pt, pd) =>
                            let av = ce_eval_expr(ctl, env, fns, argexprs[ai])
                            if ctl["failed"]
                                return av
                            callenv[pn] = av
                    ai = ai + 1
                ctl["ret"] = false
                ce_eval_block(ctl, callenv, fns, sb)
                if ctl["failed"]
                    return CeVal("fail", 0)
                if not ctl["ret"]
                    return ce_fail(ctl)
                let rv = ctl["retval"]
                ctl["ret"] = false
                return rv
    ce_fail(ctl)

fn ce_eval_block(ctl: dict, env: dict, fns: dict, stmts: list)
    for s in stmts
        if ctl["failed"] or ctl["ret"]
            return
        if not ce_budget_ok(ctl)
            return
        match s
            Stmt(st, sn, se, sb, sp, sel, san, sl) =>
                if st == "assign"
                    let av = ce_eval_expr(ctl, env, fns, se)
                    if ctl["failed"]
                        return
                    if sn != ""
                        // `let x = v` declaration form
                        env[sn] = av
                    else
                        // reassignment `x = v`: target Expr lives in the ann field.
                        // Only simple-ident targets that are ALREADY a known local
                        // (param/prior let) — globals/index/member targets fail closed.
                        if len(san) != 1
                            ctl["failed"] = true
                            return
                        let tname = ""
                        match san[0]
                            Expr(tt, tv, tn2, tc2, tf2, tl2) =>
                                if tt == "ident"
                                    tname = tv
                        if tname == "" or not contains(env, tname)
                            ctl["failed"] = true
                            return
                        env[tname] = av
                else if st == "return"
                    let rv = ce_eval_expr(ctl, env, fns, se)
                    if ctl["failed"]
                        return
                    ctl["retval"] = rv
                    ctl["ret"] = true
                    return
                else if st == "if"
                    let c = ce_eval_expr(ctl, env, fns, se)
                    if ctl["failed"]
                        return
                    if c.v
                        ce_eval_block(ctl, env, fns, sb)
                    else
                        ce_eval_block(ctl, env, fns, sel)
                else if st == "while"
                    while true
                        if ctl["failed"] or ctl["ret"]
                            break
                        if not ce_budget_ok(ctl)
                            break
                        let wc = ce_eval_expr(ctl, env, fns, se)
                        if ctl["failed"]
                            break
                        if not wc.v
                            break
                        ce_eval_block(ctl, env, fns, sb)
                else if st == "expr"
                    ce_eval_expr(ctl, env, fns, se)
                    if ctl["failed"]
                        return
                else
                    ctl["failed"] = true
                    return

// Try to fold a top-level const initializer. Only attempts call-rooted initializers
// (literal/list/scalar-arith consts already have existing paths / LLVM folds them).
// Returns a literal Expr on success, else the original expr unchanged.
fn ce_try_fold_const(expr: Expr, stmts: list) -> Expr
    let is_call = false
    match expr
        Expr(et, ev, en, ec, ef, eln) =>
            if et == "call"
                is_call = true
    if not is_call
        return expr
    let fns = {}
    for s in stmts
        match s
            Stmt(st, sn, se, sb, sp, sel, san, sl) =>
                if st == "fn"
                    fns[sn] = s
    let ctl = {}
    ctl["budget"] = 2000000
    ctl["failed"] = false
    ctl["ret"] = false
    ctl["retval"] = CeVal("int", 0)
    let env = {}
    let cv = ce_eval_expr(ctl, env, fns, expr)
    if ctl["failed"]
        return expr
    if cv.kind == "int"
        return Expr("int", str(cv.v), cv.v, [], [], 0)
    return expr

fn compiler_main()
    let arguments = args()
    if len(arguments) < 2
        print("NOVA Programming Language v0.1.0")
        print("Usage: nova <command> [options] [file.nova]")
        print("")
        print("Project commands:")
        print("  new <name>            Create a new project skeleton")
        print("  init                  Create nova.toml in current directory")
        print("  build [file]          Build project (or specific file) to executable")
        print("  run [file]            Build and run project (or specific file)")
        print("  watch <file.nova>     Rebuild + rerun on every save (watches *.nova beside it)")
        print("  test                  Run all *_test.nova files in tests/ and ./")
        print("  clean                 Remove .ll, .exe build artifacts")
        print("  fmt <file.nova>       Format source (whitespace normalization)")
        print("  lint <file.nova>      Static checks (tabs, line length, TODOs)")
        print("  check <file.nova>     Parse + type-check only (no codegen) — fast")
        print("  repl                  Start interactive shell (compiles + runs repl.nova)")
        print("  debug <file.nova>     Build with debug info and launch lldb")
        print("  bench <file.nova>     Build then time N runs (min/mean/max)")
        print("  cov <file.nova>       Build with coverage and run; per-line report on exit")
        print("")
        print("Single-file commands:")
        print("  compile <file.nova>   Compile to LLVM IR only")
        print("  emit <file.nova>      Print generated LLVM IR to stdout (inspect codegen)")
        print("  wasm <file.nova>      Compile to a runnable WebAssembly bundle (.wasm + JS loader)")
        print("")
        print("Package commands:")
        print("  get <package>[@ver]   Add a dependency to nova.toml")
        print("  install               Download all dependencies from nova.toml")
        print("")
        print("Tools:")
        print("  setup                 Pre-compile build cache (one-time, makes builds instant)")
        print("  version               Show version")
        print("  self-test             Run compiler self-test")
        print("  lsp                   Start LSP server (for IDE integration)")
        print("")
        print("Options:")
        print("  -O0                   Disable optimizations (nova run default)")
        print("  -O2                   Full optimizations (nova build default)")
        print("  -o <output>           Output file path")
        print("  --target <target>     Cross-compile target:")
        print("    linux, linux-arm64, macos, macos-arm64, windows, windows-msvc, wasm")
        print("    (windows = GNU/mingw ABI, the self-contained default; windows-msvc requires")
        print("     your own separately-installed MSVC/Visual Studio Build Tools)")
        print("  --old                 Use legacy non-IR compiler")
        exit(0)
    let cmd = arguments[1]
    if cmd == "version" or cmd == "--version"
        print("NOVA v" + nova_find_version() + " (self-hosted, IR pipeline)")
        exit(0)
    if cmd == "self-test"
        run_self_test()
        exit(0)
    if cmd == "lsp" or cmd == "--lsp"
        lsp_server_main()
        exit(0)
    if cmd == "setup"
        print("Preparing build cache...")
        let sr = nova_warmup_runtime()
        if sr == 0
            print("Build cache ready. Every build will be instant.")
        else
            print("warning: runtime cache build failed (builds will still work, just slower)")
        let setup_clang = nova_find_clang()
        if setup_clang == "clang" and len(which("clang")) == 0
            print("warning: no clang toolchain found. Run `nova toolchain status` for details.")
        exit(sr)
    if cmd == "toolchain"
        let tc_sub = "status"
        if len(arguments) > 2
            tc_sub = arguments[2]
        if tc_sub == "path"
            print(nova_find_clang())
            exit(0)
        if tc_sub == "status"
            let found = nova_find_clang()
            let on_path = which("clang")
            if found == "clang" and len(on_path) == 0
                print("clang: NOT FOUND")
                print("  Checked: NOVA_CLANG, NOVA_HOME/toolchains/clang/bin, install-relative toolchains/clang/bin, ./toolchains/clang/bin, PATH")
                print("  Run the platform installer (install.sh / install.ps1), or install clang and put it on PATH.")
                exit(1)
            if contains(found, "toolchains")
                print("clang: " + found + " (bundled toolchain)")
            else
                print("clang: " + found + " (system PATH -- not the bundled toolchain)")
            exit(0)
        if tc_sub == "install"
            print("Toolchain auto-install isn't available from inside `nova` yet.")
            print("Run the platform installer instead:")
            print("  Linux/macOS: curl -fsSL https://novachan.org/install.sh | sh")
            print("  Windows:     iwr https://novachan.org/install.ps1 -useb | iex")
            print("Or set NOVA_CLANG to an existing clang binary, or place one at $NOVA_HOME/toolchains/clang/bin/.")
            exit(1)
        print("Usage: nova toolchain <status|path|install>")
        exit(1)
    if cmd == "init"
        nova_pkg_init()
        nova_warmup_runtime()
        exit(0)
    if cmd == "new"
        if len(arguments) < 3
            print("Usage: nova new <name> [--api|--microservice|--frontend|--fullstack|--lib]")
            print("  default: --api (a working Forge REST API)")
            exit(1)
        let nn_name = ""
        let nn_kind = "api"
        let ni = 2
        while ni < len(arguments)
            let arg = arguments[ni]
            if starts_with(arg, "--")
                nn_kind = slice(arg, 2, len(arg))
            else
                nn_name = arg
            ni = ni + 1
        if nn_name == ""
            print("Usage: nova new <name> [--api|--microservice|--frontend|--fullstack|--lib]")
            exit(1)
        let nrc = nn_new_project(nn_kind, nn_name)
        if nrc == 0
            print("Preparing build cache...")
            nova_warmup_runtime()
        exit(nrc)
    if cmd == "clean"
        nova_pkg_clean()
        exit(0)
    if cmd == "test"
        nova_pkg_test()
        exit(0)
    if cmd == "eval"
        if len(arguments) < 3
            print("Usage: nova eval \"<expression>\"")
            exit(1)
        // #30: interpret a single expression instantly (tree-walk, no LLVM compile).
        let _ev_toks = tokenize(arguments[2])
        let _ev_pe = []
        let _ev_pr = parse_expr(_ev_toks, 0, 0, _ev_pe)
        if len(_ev_pe) > 0
            print("eval: could not parse expression")
            exit(1)
        let _ev_res = eval_expr({}, _ev_pr.expr)
        print(str(_ev_res))
        exit(0)
    if cmd == "fmt" or cmd == "format"
        if len(arguments) < 3
            print("Usage: nova fmt <file.nova>")
            exit(1)
        nova_fmt_file_ast(arguments[2])
        exit(0)
    if cmd == "lint"
        if len(arguments) < 3
            print("Usage: nova lint <file.nova>")
            exit(1)
        exit(nova_lint_file(arguments[2]))
    if cmd == "check"
        if len(arguments) < 3
            print("Usage: nova check <file.nova>")
            exit(1)
        let errs = nova_check_file(arguments[2])
        if errs > 0
            exit(1)
        exit(0)
    // ── `nova watch <file.nova>` (4.6) ───────────────────────────────────────────
    // Turns the 170ms self-compile into something you can FEEL: save the file, see it
    // run. The speed already existed; nothing surfaced it.
    //
    // Watches every .nova file in the entry file's DIRECTORY, not just the entry file
    // — a project's imports normally sit beside it, and a watcher that misses them
    // silently reruns stale code, which is worse than not watching at all.
    //
    // Re-invokes `self run <file>` via system() rather than compiling in-process: a
    // compile error, a panic, or a runtime crash then kills only the child, so the
    // watcher survives and keeps watching. That is the whole point — the loop must be
    // the one thing that cannot die.
    if cmd == "watch"
        if len(arguments) < 3
            print("Usage: nova watch <file.nova>")
            exit(1)
        let w_in = arguments[2]
        if not file_exists(w_in)
            print("error: cannot read '" + w_in + "': file not found")
            exit(1)
        let w_self = arguments[0]
        let w_dir = path_dir(w_in)
        if w_dir == ""
            w_dir = "."
        // Poll interval: 150ms is under the ~200ms that reads as instant, and a
        // handful of mtime stats per tick is far cheaper than the compile it guards.
        let w_poll = 150
        // Sum of mtimes over the watched set: changes when any file is edited, and
        // when one is added or removed. Cheap, and no per-file bookkeeping.
        let w_prev = 0 - 1
        print("nova watch: " + w_in + "  (watching *.nova in " + w_dir + ", ctrl-c to stop)")
        loop
            let w_files = list_dir(w_dir)
            let w_stamp = 0
            for w_f in w_files
                if ends_with(w_f, ".nova")
                    w_stamp = w_stamp + build_file_mtime(w_dir + "/" + w_f)
            if w_stamp != w_prev
                if w_prev != 0 - 1
                    print("")
                    print("nova watch: change detected, rebuilding...")
                w_prev = w_stamp
                let w_t0 = time_ms()
                // Plain `self run <file>` — no NOVA_NO_CACHE wrapper. The incremental
                // check now takes the newest mtime across the entry file AND its
                // transitive imports (nova_newest_source_mtime), so editing an imported
                // module correctly invalidates the cache. An earlier version forced
                // NOVA_NO_CACHE through a `cmd /c "set X=1 && ..."` wrapper; the nested
                // quoting silently failed to pass the variable, which is what exposed
                // the stale-import-cache bug in the first place. Dropping the wrapper
                // removes the fragile quoting AND keeps warm rebuilds fast.
                // `cmd /c ""prog" "args""` — the doubled outer quotes are REQUIRED on
                // Windows: cmd strips them when a command both begins and ends with a
                // quote, so the bare `"exe" run "file"` form fails instantly (exit 1 in
                // ~45ms, before any compile). Same shape the `cov` command already uses.
                let w_rc = system("cmd /c \"\"" + w_self + "\" run \"" + w_in + "\"\"")
                let w_ms = time_ms() - w_t0
                if w_rc == 0
                    print("nova watch: ok in " + str(w_ms) + " ms")
                else
                    print("nova watch: exited " + str(w_rc) + " after " + str(w_ms) + " ms")
            sleep(w_poll)
        exit(0)
    if cmd == "cov" or cmd == "coverage"
        // Build with coverage and run. We re-invoke ourselves through cmd.exe
        // with NOVA_COV=1 set in the env so compile_ir_core_named will
        // toggle ire_cov_enabled. This works even before set_env existed in
        // the stdlib (avoids bootstrap chicken-and-egg).
        if len(arguments) < 3
            print("Usage: nova cov <file.nova>")
            exit(1)
        let cov_in = arguments[2]
        let cov_ll = nova_replace_ext(cov_in, ".nova", ".ll")
        let cov_exe = nova_replace_ext(cov_in, ".nova", ".exe")
        let self_exe = arguments[0]
        let cov_compile = "cmd /c \"set NOVA_COV=1 && \"" + self_exe + "\" compile -o \"" + cov_ll + "\" \"" + cov_in + "\"\""
        let crc = system(cov_compile)
        if crc != 0
            print("error: coverage compile failed (exit " + str(crc) + ")")
            exit(1)
        let cret = nova_link(cov_ll, cov_exe, "-O0", "")
        if cret != 0
            print("error: coverage link failed")
            exit(1)
        let cnorm = replace(cov_exe, "/", "\\")
        let cprefix = ".\\"
        if starts_with(cnorm, "\\") or starts_with(cnorm, ".\\")
            cprefix = ""
        if len(cnorm) >= 2 and slice(cnorm, 1, 2) == ":"
            cprefix = ""
        exit(system(chr(34) + cprefix + cnorm + chr(34)))
    if cmd == "bench"
        // Build once -O2, then run N times and report wall-time stats.
        // Useful for verifying NOVA's perf claims on real workloads without
        // pulling in a separate hyperfine-style tool.
        if len(arguments) < 3
            print("Usage: nova bench <file.nova> [-n iterations]")
            exit(1)
        let bench_in = ""
        let bench_iters = 10
        let bi = 2
        while bi < len(arguments)
            let ba = arguments[bi]
            if ba == "-n"
                bi = bi + 1
                if bi < len(arguments)
                    bench_iters = parse_int(arguments[bi])
            else
                bench_in = ba
            bi = bi + 1
        if bench_in == ""
            print("error: no input file")
            exit(1)
        let bench_ll = nova_replace_ext(bench_in, ".nova", ".ll")
        let bench_exe = nova_replace_ext(bench_in, ".nova", ".exe")
        nova_compile_file(bench_in, bench_ll, 1, "")
        let bret = nova_link(bench_ll, bench_exe, "-O2", "")
        if bret != 0
            print("error: bench link failed")
            exit(1)
        let bnorm = replace(bench_exe, "/", "\\")
        let bprefix = ".\\"
        if starts_with(bnorm, "\\") or starts_with(bnorm, ".\\")
            bprefix = ""
        if len(bnorm) >= 2 and slice(bnorm, 1, 2) == ":"
            bprefix = ""
        let bcmd = chr(34) + bprefix + bnorm + chr(34) + " >nul 2>&1"
        print("Running " + str(bench_iters) + " iterations of " + bench_exe + "...")
        let times = []
        let bk = 0
        let min_t = 999999999
        let max_t = 0
        let sum_t = 0
        while bk < bench_iters
            let t0 = time_ms()
            system(bcmd)
            let t1 = time_ms()
            let dt = t1 - t0
            push(times, dt)
            if dt < min_t
                min_t = dt
            if dt > max_t
                max_t = dt
            sum_t = sum_t + dt
            bk = bk + 1
        let mean_t = sum_t / bench_iters
        print("  min:  " + str(min_t) + " ms")
        print("  mean: " + str(mean_t) + " ms")
        print("  max:  " + str(max_t) + " ms")
        print("  iter: " + str(bench_iters))
        exit(0)
    if cmd == "debug"
        if len(arguments) < 3
            print("Usage: nova debug <file.nova>")
            exit(1)
        let dbg_in = arguments[2]
        let dbg_ll = nova_replace_ext(dbg_in, ".nova", ".ll")
        let dbg_exe = nova_replace_ext(dbg_in, ".nova", ".exe")
        let self_exe = arguments[0]
        let dbg_compile = "cmd /c \"set NOVA_DBG=1 && \"" + self_exe + "\" compile -o \"" + dbg_ll + "\" \"" + dbg_in + "\"\""
        let drc = system(dbg_compile)
        if drc != 0
            print("error: debug compile failed (exit " + str(drc) + ")")
            exit(1)
        let dret = nova_link(dbg_ll, dbg_exe, "-O0", "")
        if dret != 0
            print("error: debug link failed (exit " + str(dret) + ")")
            exit(1)
        print("NOVA interactive debugger")
        print("  Commands:  s=step  n=next  o=out  c=continue  bt=backtrace  locals  p VAR  bp LINE  q=quit")
        let dnorm = replace(dbg_exe, "/", "\\")
        let dprefix = ".\\"
        if starts_with(dnorm, "\\") or starts_with(dnorm, ".\\")
            dprefix = ""
        if len(dnorm) >= 2 and slice(dnorm, 1, 2) == ":"
            dprefix = ""
        exit(system(chr(34) + dprefix + dnorm + chr(34)))
    if cmd == "repl"
        // Bundled interactive shell. Looks for repl.nova via the same
        // discovery convention as the runtime: NOVA_HOME first, then a few
        // relative candidates. We compile + link + exec it.
        let repl_path = ""
        let nh = env("NOVA_HOME")
        if len(nh) > 0
            let c = path_join(nh, "repl.nova")
            if path_exists(c) == 1
                repl_path = c
        if repl_path == ""
            let candidates = ["repl.nova", "test_programs/repl.nova"]
            for c in candidates
                if path_exists(c) == 1
                    repl_path = c
                    break
        if repl_path == ""
            print("error: repl.nova not found. Set NOVA_HOME or run from nova-compiler/test_programs.")
            exit(1)
        let ll = nova_replace_ext(repl_path, ".nova", ".ll")
        let exe = nova_replace_ext(repl_path, ".nova", ".exe")
        nova_compile_file(repl_path, ll, 1, "")
        let lret = nova_link(ll, exe, "-O2", "")
        if lret != 0
            print("error: repl link failed (exit " + str(lret) + ")")
            exit(1)
        let norm_exe = replace(exe, "/", "\\")
        let prefix = ".\\"
        if starts_with(norm_exe, "\\") or starts_with(norm_exe, ".\\")
            prefix = ""
        if len(norm_exe) >= 2 and slice(norm_exe, 1, 2) == ":"
            prefix = ""
        exit(system(chr(34) + prefix + norm_exe + chr(34)))
    if cmd == "get"
        if len(arguments) < 3
            print("Usage: nova get <package>[@version]")
            exit(1)
        nova_pkg_get(arguments[2])
        exit(0)
    if cmd == "install"
        nova_pkg_install()
        exit(0)
    if cmd == "wasm"
        // Compile a NOVA source to a RUNNABLE WebAssembly bundle:
        //   <base>.wasm        -- WebAssembly binary (NOVA logic)
        //   <base>.run.cjs     -- Node loader
        //   _wasm_runtime.cjs  -- reusable JS-managed linear-memory runtime (copied alongside)
        // Run with: node <base>.run.cjs   (works for programs using the covered builtins:
        // lists/strings/floats/print; an uncovered builtin fails with a clear named error).
        let wasm_in = ""
        let wasm_out = ""
        let wasm_opt = "-O2"
        let wi = 2
        while wi < len(arguments)
            let wa = arguments[wi]
            if wa == "-o"
                wi = wi + 1
                if wi < len(arguments)
                    wasm_out = arguments[wi]
            else if wa == "-O0"
                wasm_opt = "-O0"
            else if wa == "-O1"
                wasm_opt = "-O1"
            else
                wasm_in = wa
            wi = wi + 1
        if wasm_in == ""
            print("Usage: nova wasm <file.nova> [-o output_base] [-O0]")
            print("  Produces <base>.wasm + <base>.run.cjs + _wasm_runtime.cjs")
            print("  Run with: node <base>.run.cjs")
            exit(1)
        if not file_exists(wasm_in)
            print("error: cannot read '" + wasm_in + "': file not found")
            exit(1)
        let wasm_base = wasm_out
        if wasm_base == ""
            wasm_base = nova_replace_ext(wasm_in, ".nova", "")
        // Distinct .wasm.ll intermediate avoids cache collision with a native <base>.ll
        // (nova_compile_file caches by output_path+mtime, target-agnostic).
        let wasm_ll = wasm_base + ".wasm.ll"
        let wasm_path = wasm_base + ".wasm"
        let wasm_loader = wasm_base + ".run.cjs"
        let wasm_dir = path_dir(wasm_path)
        nova_compile_file(wasm_in, wasm_ll, 1, "wasm")
        // One clang call drives wasm-ld internally (resolved via nova_find_clang(), same
        // as every other codegen/linking path -- no longer requires clang on PATH).
        let q = chr(34)
        let wasm_clang = nova_find_clang()
        let wlink = q + wasm_clang + q + " --target=wasm32 " + wasm_opt + " -nostdlib"
        wlink = wlink + " -Wl,--no-entry -Wl,--export=nova_user_main"
        wlink = wlink + " -Wl,--export=__heap_base -Wl,--allow-undefined -Wl,--gc-sections"
        wlink = wlink + " " + q + wasm_ll + q + " -o " + q + wasm_path + q + " -w 2>&1"
        let wret = system(_win_wrap_cmd(wlink))
        if wret != 0
            print("error: wasm link failed (exit " + str(wret) + ")")
            print("  command: " + wlink)
            print("  Ensure clang supports --target=wasm32 (LLVM 8+).")
            exit(1)
        let wrt_src = nova_find_wasm_runtime()
        if wrt_src == ""
            print("error: _wasm_runtime.cjs not found. Set NOVA_HOME or run from the nova-compiler tree.")
            exit(1)
        let wrt_dst = "_wasm_runtime.cjs"
        if len(wasm_dir) > 0
            wrt_dst = wasm_dir + "_wasm_runtime.cjs"
        copy_file(wrt_src, wrt_dst)
        // Emit the <base>.run.cjs loader (resolves the runtime + wasm relative to __dirname).
        let wasm_stem = nova_replace_ext(path_name(wasm_path), ".wasm", "")
        let nl = chr(10)
        // Single brace-free loader line. NOVA treats { } inside string literals as
        // interpolation, so all the brace-containing logic lives in _wasm_runtime.cjs's
        // runFile(); the emitted loader just calls it with the wasm path.
        let ldr = "require(require(" + q + "path" + q + ").join(__dirname, " + q + "_wasm_runtime.cjs" + q + ")).runFile(require(" + q + "path" + q + ").join(__dirname, " + q + wasm_stem + ".wasm" + q + "))" + nl
        write_file(wasm_loader, ldr)
        print("WASM bundle built:")
        print("  " + wasm_path)
        print("  " + wasm_loader)
        print("  " + wrt_dst)
        print("Run with: node " + wasm_loader)
        exit(0)
    // Parse: nova run/build/compile [--old] [-O0] [-o out] [--target T] <file>
    if cmd == "emit"
        // Compile to LLVM IR (default) or native assembly (--asm) and print to
        // stdout. --target selects the triple. `nova emit file.nova` = IR;
        // `nova emit file.nova --asm` = native assembly via clang -S.
        let emit_in = ""
        let emit_target = ""
        let emit_asm = 0
        let ei = 2
        while ei < len(arguments)
            let ea = arguments[ei]
            if ea == "--target"
                ei = ei + 1
                if ei < len(arguments)
                    emit_target = arguments[ei]
            else if ea == "--asm"
                emit_asm = 1
            else
                emit_in = ea
            ei = ei + 1
        if emit_in == ""
            print("Usage: nova emit <file.nova> [--asm] [--target <t>]")
            print("  --asm    Emit native assembly instead of LLVM IR")
            exit(1)
        let emit_ll = nova_replace_ext(emit_in, ".nova", ".ll")
        nova_compile_file(emit_in, emit_ll, 1, emit_target)
        if emit_asm == 1
            let emit_clang = nova_find_clang()
            let asm_out = exec(_win_wrap_cmd("\"" + emit_clang + "\" -S -O2 -o - " + emit_ll + " -D_CRT_SECURE_NO_WARNINGS -w"))
            print(asm_out)
        else
            print(read_file(emit_ll))
        exit(0)
    if cmd == "run" or cmd == "build" or cmd == "compile"
        let use_ir = 1
        let opt_level = if cmd == "run"
            "-O0"
        else
            "-O2"
        let output_file = ""
        let input_file = ""
        let target = ""
        let i = 2
        while i < len(arguments)
            let a = arguments[i]
            if a == "--old"
                use_ir = 0
            else if a == "-O0"
                opt_level = "-O0"
            else if a == "-O2"
                opt_level = "-O2"
            else if a == "-o"
                i = i + 1
                if i < len(arguments)
                    output_file = arguments[i]
            else if a == "--target"
                i = i + 1
                if i < len(arguments)
                    target = arguments[i]
            else
                input_file = a
            i = i + 1
        if input_file == ""
            input_file = nova_pkg_entry()
        if input_file == ""
            print("error: no input file and no src/main.nova found in project")
            exit(1)
        if cmd == "compile"
            let ll = if output_file != ""
                output_file
            else
                nova_replace_ext(input_file, ".nova", ".ll")
            nova_compile_file(input_file, ll, use_ir, target)
            print("Compiled: " + input_file + " -> " + ll + " (target: " + resolve_target(target) + ")")
        else if cmd == "build"
            let ll = nova_replace_ext(input_file, ".nova", ".ll")
            let exe = if output_file != ""
                output_file
            else
                nova_replace_ext(input_file, ".nova", ".exe")
            nova_compile_file(input_file, ll, use_ir, target)
            let ret = nova_link(ll, exe, opt_level, target)
            if ret == 0
                print("Built: " + exe + " (target: " + resolve_target(target) + ")")
            else
                print("error: linking failed (exit " + str(ret) + ")")
                exit(1)
        else if cmd == "run"
            let ll = nova_replace_ext(input_file, ".nova", ".ll")
            let exe = nova_replace_ext(input_file, ".nova", ".exe")
            nova_compile_file(input_file, ll, use_ir, target)
            let ret = nova_link(ll, exe, opt_level, target)
            if ret != 0
                print("error: linking failed (exit " + str(ret) + ")")
                exit(1)
            let norm_exe = replace(exe, "/", "\\")
            let prefix = ".\\"
            if starts_with(norm_exe, "\\") or starts_with(norm_exe, ".\\")
                prefix = ""
            if len(norm_exe) >= 2 and slice(norm_exe, 1, 2) == ":"
                prefix = ""
            let run_cmd = chr(34) + prefix + norm_exe + chr(34)
            let run_ret = system(run_cmd)
            exit(run_ret)
        exit(0)
    // Legacy mode: nova <file.nova> [output.ll]
    let use_ir = 1
    let file_idx = 1
    if arguments[1] == "--old"
        use_ir = 0
        file_idx = 2
    else if arguments[1] == "--ir"
        file_idx = 2
    if file_idx >= len(arguments)
        print("error: no input file")
        exit(1)
    let input_path = arguments[file_idx]
    let output_path = if file_idx + 1 < len(arguments)
        arguments[file_idx + 1]
    else
        nova_replace_ext(input_path, ".nova", ".ll")
    nova_compile_file(input_path, output_path, use_ir, "")
    if use_ir == 1
        print("Compiled (IR): " + input_path + " -> " + output_path)
    else
        print("Compiled: " + input_path + " -> " + output_path)

// ── Self-Test ────────────────────────────────────────────────────────────────

fn run_self_test()
    let tokens = tokenize("let x = 42 + 3")
    let non_nl = []
    for t in tokens
        match t
            Token(kind, value, line, col) =>
                if kind != "NEWLINE" and kind != "EOF"
                    push(non_nl, t)
    assert(len(non_nl) == 6, "lexer: expected 6 tokens, got " + str(len(non_nl)))
    match non_nl[0]
        Token(k, v, l, c) => assert(k == "KW" and v == "let", "lexer: t0 " + k + ":" + v)
    match non_nl[1]
        Token(k, v, l, c) => assert(k == "IDENT" and v == "x", "lexer: t1 " + k + ":" + v)
    match non_nl[2]
        Token(k, v, l, c) => assert(k == "ASSIGN" and v == "=", "lexer: t2 " + k + ":" + v)
    match non_nl[3]
        Token(k, v, l, c) => assert(k == "INT" and v == "42", "lexer: t3 " + k + ":" + v)
    match non_nl[4]
        Token(k, v, l, c) => assert(k == "OP" and v == "+", "lexer: t4 " + k + ":" + v)
    match non_nl[5]
        Token(k, v, l, c) => assert(k == "INT" and v == "3", "lexer: t5 " + k + ":" + v)

    let tokens2 = tokenize("x = 10\ny = x + 5\nprint(y)")
    let _tpe = []
    let stmts = parse_program(tokens2, _tpe)
    assert(len(stmts) == 3, "parser: expected 3 stmts, got " + str(len(stmts)))

    let source = "x = 42\nprint(x)"
    let result = compile(source)
    assert(contains(result, "define i64 @nova_main"), "codegen: has nova_main")
    assert(contains(result, "nova_rt_print_any"), "codegen: has print call")

    // Test function compilation
    let fn_source = "fn add(a, b)\n    return a + b\nresult = add(3, 4)\nprint(result)"
    let fn_result = compile(fn_source)
    assert(contains(fn_result, "define i64 @add"), "codegen: has user function")

    // Test string literal compilation (full pipeline)
    let str_source = "x = \"hello\"\nprint(x)"
    let str_result = compile(str_source)
    assert(contains(str_result, "@.str."), "codegen: has string constant")
    assert(contains(str_result, "nova_rt_print_any"), "codegen: string print call")

    print("NOVA Self-Hosting Compiler: ALL TESTS PASSED")

compiler_main()
