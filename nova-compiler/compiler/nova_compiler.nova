    // 7.1 INLINE ASM. `asm(template, constraints) -> int` emits an LLVM inline-asm call:
    //     %r = call i64 asm sideeffect "<template>", "<constraints>"()
    // Both arguments must be STRING LITERALS -- they become part of the emitted module,
    // not runtime values, so a computed string is rejected at lowering rather than
    // silently producing garbage IR. `sideeffect` is always set: the optimizer must never
    // delete or reorder an asm block it cannot reason about (rdtsc, cpuid, fences).
    // Returns i64; use constraint "=r" to take a result, or "" for a pure side effect.
    // Gated by `unsafe` (see _is_unsafe_builtin) -- this is the least safe thing NOVA can do.
    reg["asm"] = NTypeScheme([], nt_fn([nt_string(), nt_string()], nt_int()))
