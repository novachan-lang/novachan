fn resolve_method_fn(name: string) -> string
    if name == "push"
        "nova_rt_list_append"
    else if name == "pop"
        "nova_rt_list_pop"
    else if name == "insert"
        "nova_rt_list_insert"
    else if name == "remove"
        "nova_rt_list_remove"
    else if name == "get"
