// ══════════════════════════════════════════════════════════════════════════════
// NOVA Self-Hosting Compiler — Phase 7
// Compiles NOVA source → LLVM IR text → native binary (via clang)
//
// Architecture: Source → Lexer → Parser → LLVM Codegen → .ll file
// All values are i64 (matching the Kotlin compiler's convention).
// Links against nova_runtime.c for string/list/dict/IO operations.
// ══════════════════════════════════════════════════════════════════════════════

// ── Data Types ───────────────────────────────────────────────────────────────

type Token
    kind: string
    value: string
    line: int
    col: int

type Expr
    tag: string
    value: string
    num: int
    children: list
    fields: list
    eline: int

type Stmt
    tag: string
    name: string
    expr: Expr
    body: list
    params: list
    else_body: list
    annotations: list
    sline: int

type Param
    name: string
    type_ann: string
    default_val: Expr

type ParseResult
    expr: Expr
    pos: int

type StmtParseResult
    stmt: Stmt
    pos: int

// ── IR Types ─────────────────────────────────────────────────────────────────

type IrType
    kind: string
    name: string
    params: list
    id: int

type IrInst
    op: string
    dest: string
    type: IrType
    args: list
    value: string
    num: int
    effect: string
    line: int

type IrBlock
    label: string
    insts: list
    terminator: IrInst

type IrParam
    name: string
    type: IrType

type IrFunction
    name: string
    params: list
    ret_type: IrType
    blocks: list
    type_params: list
    is_extern: int

type IrModule
    functions: list
    structs: list
    globals: list
    string_constants: list

// ── Lexer ────────────────────────────────────────────────────────────────────

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn is_ws(ch: string) -> bool
    ch == " " or ch == "\t" or ch == "\r"

// L13: keywords that CANNOT be a variable name — the hard statement/expression keywords
// whose dedicated parse branches make `let <kw> = ...` silently mis-codegen. Deliberately
// EXCLUDES contextual keywords (`matches`, `as`, `in`, `and`, `or`, `not`, ...) which real
// code legitimately uses as identifiers (e.g. `let matches = []`). Conservative by design:
// only rejects names with zero legitimate identifier use; extend as more are verified.
fn _is_hard_reserved(word: string) -> bool
    (word == "match" or word == "loop" or word == "type" or word == "unsafe")

fn is_keyword(word: string) -> bool
    (word == "fn" or word == "return" or word == "if" or word == "else" or word == "for" or word == "while" or word == "match" or word == "break" or word == "continue" or word == "type" or word == "enum" or word == "spawn" or word == "send" or word == "receive" or word == "channel" or word == "or" or word == "and" or word == "not" or word == "import" or word == "true" or word == "false" or word == "null" or word == "in" or word == "as" or word == "select" or word == "try" or word == "catch" or word == "trait" or word == "matches" or word == "yield" or word == "let" or word == "extern" or word == "unsafe" or word == "with" or word == "defer" or word == "const" or word == "unless" or word == "until" or word == "loop")

fn lex_error(code: string, msg: string, line: int, col: int, help: string)
    lex_error_file(code, msg, "", line, col, help)

fn lex_error_file(code: string, msg: string, filename: string, line: int, col: int, help: string)
    let fname = filename
    if fname == ""
        fname = "<source>"
    print("error[" + code + "]: " + msg)
    print("  --> " + fname + ":" + str(line) + ":" + str(col))
    print_source_snippet(filename, line, col)
    if help != ""
        print("  = help: " + help)
    print("compilation failed: 1 error(s)")
    exit(1)

// Read source file and print a snippet of the line where the error occurred.
// Silently does nothing if filename is empty or unreadable.
fn print_source_snippet(filename: string, line: int, col: int)
    if filename != "" and file_exists(filename) and line > 0
        let content = read_file(filename)
        if len(content) > 0
            let lines = split(content, "\n")
            if line <= len(lines)
                let snippet = lines[line - 1]
                let lnum = str(line)
                let pad = ""
                let pi = 0
                while pi < len(lnum)
                    pad = pad + " "
                    pi = pi + 1
                print("  " + pad + " |")
                print("  " + lnum + " | " + snippet)
                print("  " + pad + " |")

// Returns a formatted source snippet string (line with surrounding bars).
fn format_source_snippet(filename: string, line: int) -> string
    if filename != "" and file_exists(filename) and line > 0
        let content = read_file(filename)
        if len(content) > 0
            let lines = split(content, "\n")
            if line <= len(lines)
                let snippet = lines[line - 1]
                let lnum = str(line)
                let pad = ""
                let pi = 0
                while pi < len(lnum)
                    pad = pad + " "
                    pi = pi + 1
                return "  " + pad + " |\n" + "  " + lnum + " | " + snippet + "\n" + "  " + pad + " |\n"
    ""

// Skip tokens forward to the next top-level sync point (next statement boundary).
// Tracks bracket depth so error recovery inside a multi-line list/dict/call
// doesn't jump past the closing bracket and corrupt the rest of the parse.
fn sync_to_stmt(tokens: list, pos: int) -> int
    let p = pos
    let depth = 0
    while p < len(tokens) - 1
        let kind = tk(tokens, p)
        if kind == "EOF"
            return p
        let val = tv(tokens, p)
        if kind == "DELIM" and (val == "[" or val == "(" or val == "\{")
            depth = depth + 1
        if kind == "DELIM" and (val == "]" or val == ")" or val == "\}")
            if depth > 0
                depth = depth - 1
        if depth == 0
            let col = tok_col(tokens, p)
            if col <= 1 and kind == "NEWLINE"
                return p + 1
            if col <= 1 and kind == "KW"
                return p
        p = p + 1
    len(tokens) - 1

// Dummy "error" statement returned when a parse error occurs and recovery skips a construct.
fn error_stmt(line: int) -> Stmt
    Stmt("error", "", Expr("null", "", 0, [], [], 0), [], [], [], [], line)

fn int_fits_i64(s: string) -> bool
    if len(s) == 0
        return true
    if len(s) < 19
        return true
    if len(s) > 19
        return false
    s <= "9223372036854775807"

// count of leading ASCII spaces in a line
fn _leading_ws(s: string) -> int
    let i = 0
    let n = len(s)
    while i < n and s[i] == " "
        i = i + 1
    return i

// Text-block dedent: strip the minimal common leading indentation from a multi-line
// `\`\`\`...\`\`\`` body, dropping the optional leading/trailing blank lines (so the
// opening/closing fences on their own lines don't contribute content). Blank lines
// collapse to empty (never under-indent). Java/Swift/Kotlin text-block semantics.
fn _dedent_block(body: string) -> string
    let lines = split(body, "\n")
    let lo = 0
    let hi = len(lines)
    if hi > 0 and _leading_ws(lines[0]) == len(lines[0])
        lo = 1
    if hi > lo and _leading_ws(lines[hi - 1]) == len(lines[hi - 1])
        hi = hi - 1
    let minind = -1
    let i = lo
    while i < hi
        let ln = lines[i]
        if _leading_ws(ln) < len(ln)
            let ind = _leading_ws(ln)
            if minind < 0 or ind < minind
                minind = ind
        i = i + 1
    if minind < 0
        minind = 0
    let out = ""
    let j = lo
    while j < hi
        if j > lo
            out = out + "\n"
        let ln2 = lines[j]
        if _leading_ws(ln2) < len(ln2)
            out = out + slice(ln2, minind, len(ln2))
        j = j + 1
    return out

// L7: detect a sized-numeric suffix at source[pos..] (u8/u16/u32/u64/i8/i16/i32/i64/
// f32/f64/usize/isize). Returns the matched suffix, or "" if none. Only matches when the
// character AFTER the suffix is not an identifier char, so `255u8` is a suffix but
// `255u8x` / `255i32foo` are not (the trailing chars lex as a separate identifier, which
// keeps existing tokenisation of e.g. `5in` / `5items` unchanged).
fn _lex_num_suffix(source: string, pos: int, length: int) -> string
    let cands = ["usize", "isize", "u16", "u32", "u64", "i16", "i32", "i64", "u8", "i8", "f32", "f64"]
    let ci = 0
    let found = ""
    while ci < len(cands) and found == ""
        let c = cands[ci]
        let cl = len(c)
        if pos + cl <= length and slice(source, pos, pos + cl) == c
            let after_ok = true
            if pos + cl < length
                let nc = source[pos + cl]
                if is_alpha(nc) or is_digit(nc) or nc == "_"
                    after_ok = false
            if after_ok
                found = c
        ci = ci + 1
    found

// L7: max value permitted for a sized-int suffix (-1 = no range check: value only needs
// to fit i64, already enforced by the lexer). Increment 1 range-checks the small widths.
fn _num_suffix_max(suffix: string) -> int
    if suffix == "u8"
        return 255
    if suffix == "u16"
        return 65535
    if suffix == "u32"
        return 4294967295
    if suffix == "i8"
        return 127
    if suffix == "i16"
        return 32767
    if suffix == "i32"
        return 2147483647
    return 0 - 1

fn tokenize(source: string) -> list
    tokenize_file(source, "")

fn tokenize_file(source: string, filename: string) -> list
    let tokens = []
    let pos = 0
    let line = 1
    let col = 1
    let length = len(source)
    // Skip UTF-8 BOM if present (EF BB BF = ord 239, 187, 191)
    if length >= 3 and ord(source[0]) == 239 and ord(source[1]) == 187 and ord(source[2]) == 191
        pos = 3

    while pos < length
        let ch = source[pos]

        if ch == "\n"
            push(tokens, Token("NEWLINE", "\\n", line, col))
            line = line + 1
            col = 1
            pos = pos + 1
        else if is_ws(ch)
            while pos < length and is_ws(source[pos])
                pos = pos + 1
                col = col + 1
        else if ch == "/" and pos + 1 < length and source[pos + 1] == "/"
            while pos < length and source[pos] != "\n"
                pos = pos + 1
                col = col + 1
        else if ch == "/" and pos + 1 < length and source[pos + 1] == "*"
            pos = pos + 2
            col = col + 2
            let depth = 1
            while pos < length and depth > 0
                if source[pos] == "/" and pos + 1 < length and source[pos + 1] == "*"
                    depth = depth + 1
                    pos = pos + 2
                    col = col + 2
                else if source[pos] == "*" and pos + 1 < length and source[pos + 1] == "/"
                    depth = depth - 1
                    pos = pos + 2
                    col = col + 2
                else if source[pos] == "\n"
                    line = line + 1
                    col = 1
                    pos = pos + 1
                else
                    pos = pos + 1
                    col = col + 1
        else if ch == "@"
            push(tokens, Token("AT", "@", line, col))
            pos = pos + 1
            col = col + 1
        else if is_alpha(ch)
            let start_col = col
            let word = ""
            while pos < length and is_alnum(source[pos])
                word = word + source[pos]
                pos = pos + 1
                col = col + 1
            if word == "f" and pos < length and source[pos] == "\""
                pos = pos + 1
                col = col + 1
                let fstr = ""
                let has_interp = false
                while pos < length and source[pos] != "\""
                    if source[pos] == "\\" and pos + 1 < length
                        let esc = source[pos + 1]
                        if esc == "\{"
                            fstr = fstr + "\{"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\}"
                            fstr = fstr + "\}"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "n"
                            fstr = fstr + "\n"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "t"
                            fstr = fstr + "\t"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "r"
                            fstr = fstr + "\r"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\\"
                            fstr = fstr + "\\"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\""
                            fstr = fstr + "\""
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\{"
                            fstr = fstr + "\{"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "\}"
                            fstr = fstr + "\}"
                            pos = pos + 2
                            col = col + 2
                        else if esc == "u" and pos + 2 < length and source[pos + 2] == "\{"
                            pos = pos + 3
                            col = col + 3
                            let _fucp = 0
                            while pos < length and source[pos] != "\}"
                                let _fuc = source[pos]
                                if is_digit(_fuc)
                                    _fucp = _fucp * 16 + (ord(_fuc) - ord("0"))
                                else if _fuc == "a" or _fuc == "b" or _fuc == "c" or _fuc == "d" or _fuc == "e" or _fuc == "f"
                                    _fucp = _fucp * 16 + (ord(_fuc) - ord("a") + 10)
                                else if _fuc == "A" or _fuc == "B" or _fuc == "C" or _fuc == "D" or _fuc == "E" or _fuc == "F"
                                    _fucp = _fucp * 16 + (ord(_fuc) - ord("A") + 10)
                                pos = pos + 1
                                col = col + 1
                            if pos < length
                                pos = pos + 1
                                col = col + 1
                            if _fucp < 128
                                fstr = fstr + chr(_fucp)
                            else if _fucp < 2048
                                fstr = fstr + chr(192 + _fucp / 64) + chr(128 + _fucp - (_fucp / 64) * 64)
                            else if _fucp < 65536
                                let _fu2 = _fucp / 64
                                let _fu1 = _fu2 / 64
                                fstr = fstr + chr(224 + _fu1) + chr(128 + _fu2 - _fu1 * 64) + chr(128 + _fucp - _fu2 * 64)
                            else
                                let _fu3 = _fucp / 64
                                let _fu2b = _fu3 / 64
                                let _fu1b = _fu2b / 64
                                fstr = fstr + chr(240 + _fu1b) + chr(128 + _fu2b - _fu1b * 64) + chr(128 + _fu3 - _fu2b * 64) + chr(128 + _fucp - _fu3 * 64)
                        else
                            fstr = fstr + source[pos]
                            pos = pos + 1
                            col = col + 1
                    else if source[pos] == "\{"
                        if not has_interp
                            push(tokens, Token("INTERP_START", fstr, line, start_col))
                        else
                            push(tokens, Token("INTERP_MID", fstr, line, col))
                        fstr = ""
                        has_interp = true
                        pos = pos + 1
                        col = col + 1
                        let depth = 1
                        let interp_src = ""
                        let _fs_pd = 0
                        let _fs_bd = 0
                        let _fs_spec = ""
                        let _fs_in_spec = false
                        while pos < length and depth > 0
                            if source[pos] == "\{"
                                depth = depth + 1
                                if _fs_in_spec
                                    _fs_spec = _fs_spec + source[pos]
                                else
                                    interp_src = interp_src + source[pos]
                            else if source[pos] == "\}"
                                depth = depth - 1
                                if depth > 0
                                    if _fs_in_spec
                                        _fs_spec = _fs_spec + source[pos]
                                    else
                                        interp_src = interp_src + source[pos]
                            else if source[pos] == "\\" and pos + 1 < length and source[pos + 1] == "\""
                                if _fs_in_spec
                                    _fs_spec = _fs_spec + "\""
                                else
                                    interp_src = interp_src + "\""
                                pos = pos + 1
                                col = col + 1
                            else if source[pos] == ":" and depth == 1 and _fs_pd == 0 and _fs_bd == 0 and not _fs_in_spec
                                _fs_in_spec = true
                            else
                                if _fs_in_spec
                                    _fs_spec = _fs_spec + source[pos]
                                else
                                    if source[pos] == "("
                                        _fs_pd = _fs_pd + 1
                                    else if source[pos] == ")"
                                        _fs_pd = _fs_pd - 1
                                    else if source[pos] == "["
                                        _fs_bd = _fs_bd + 1
                                    else if source[pos] == "]"
                                        _fs_bd = _fs_bd - 1
                                    interp_src = interp_src + source[pos]
                            if depth > 0
                                pos = pos + 1
                                col = col + 1
                        pos = pos + 1
                        col = col + 1
                        let inner_tokens = tokenize(interp_src)
                        for itk in inner_tokens
                            match itk
                                Token(ik, iv, il, ic) =>
                                    if ik != "EOF"
                                        push(tokens, Token(ik, iv, line, ic))
                        if len(_fs_spec) > 0
                            push(tokens, Token("INTERP_SPEC", _fs_spec, line, col))
                    else
                        fstr = fstr + source[pos]
                        pos = pos + 1
                        col = col + 1
                if pos < length
                    pos = pos + 1
                    col = col + 1
                if has_interp
                    push(tokens, Token("INTERP_END", fstr, line, col))
                else
                    push(tokens, Token("STR", fstr, line, start_col))
            else if is_keyword(word)
                push(tokens, Token("KW", word, line, start_col))
            else
                push(tokens, Token("IDENT", word, line, start_col))
        else if is_digit(ch)
            let start_col = col
            if ch == "0" and pos + 1 < length and (source[pos + 1] == "x" or source[pos + 1] == "X")
                pos = pos + 2
                col = col + 2
                let hval = 0
                while pos < length
                    let hc = source[pos]
                    if is_digit(hc)
                        hval = hval * 16 + (ord(hc) - ord("0"))
                    else if hc == "a" or hc == "b" or hc == "c" or hc == "d" or hc == "e" or hc == "f"
                        hval = hval * 16 + (ord(hc) - ord("a") + 10)
                    else if hc == "A" or hc == "B" or hc == "C" or hc == "D" or hc == "E" or hc == "F"
                        hval = hval * 16 + (ord(hc) - ord("A") + 10)
                    else if hc == "_"
                        pos = pos + 1
                        col = col + 1
                        continue
                    else
                        break
                    pos = pos + 1
                    col = col + 1
                push(tokens, Token("INT", str(hval), line, start_col))
            else if ch == "0" and pos + 1 < length and (source[pos + 1] == "b" or source[pos + 1] == "B")
                pos = pos + 2
                col = col + 2
                let bval = 0
                while pos < length and (source[pos] == "0" or source[pos] == "1" or source[pos] == "_")
                    if source[pos] != "_"
                        bval = bval * 2 + (ord(source[pos]) - ord("0"))
                    pos = pos + 1
                    col = col + 1
                push(tokens, Token("INT", str(bval), line, start_col))
            else
                let num = ""
                let is_float = false
                while pos < length and (is_digit(source[pos]) or (source[pos] == "." and pos + 1 < length and is_digit(source[pos + 1])) or source[pos] == "_" or source[pos] == "e" or source[pos] == "E")
                    if source[pos] == "." or source[pos] == "e" or source[pos] == "E"
                        is_float = true
                    if source[pos] != "_"
                        num = num + source[pos]
                    pos = pos + 1
                    col = col + 1
                if is_float and len(num) > 0 and num[len(num) - 1] == "."
                    num = slice(num, 0, len(num) - 1)
                    is_float = false
                    pos = pos - 1
                    col = col - 1
                // L7: optional sized-numeric suffix (u8/u16/u32/u64/i8/i16/i32/i64/f32/f64,
                // usize/isize). Recognized ONLY when it directly follows the digits and is
                // not part of a longer identifier (e.g. `255u8` but not `255uu`/`3xyz`).
                // The suffix is carried on the token value as "<num>#<suffix>"; the parser
                // splits it back out into a type annotation on the literal. Purely additive:
                // no existing literal has a suffix, so tokenisation of current code is unchanged.
                let _numsuffix = _lex_num_suffix(source, pos, length)
                if _numsuffix != ""
                    // consume the suffix chars
                    let _sfi = 0
                    while _sfi < len(_numsuffix)
                        pos = pos + 1
                        col = col + 1
                        _sfi = _sfi + 1
                    if slice(_numsuffix, 0, 1) == "f"
                        is_float = true
                    num = num + "#" + _numsuffix
                if is_float
                    push(tokens, Token("FLOAT", num, line, start_col))
                else
                    let _digits = num
                    if find(num, "#") != -1
                        _digits = slice(num, 0, find(num, "#"))
                    if not int_fits_i64(_digits)
                        lex_error_file("E0012", "integer literal '" + _digits + "' is too large for i64", filename, line, start_col, "i64 max is 9223372036854775807 (19 digits); use a smaller value")
                    push(tokens, Token("INT", num, line, start_col))
        else if ch == "\"" and pos + 2 < length and source[pos + 1] == "\"" and source[pos + 2] == "\""
            let start_col = col
            let start_line = line
            pos = pos + 3
            col = col + 3
            let _tq = ""
            while pos < length and not (source[pos] == "\"" and pos + 2 < length and source[pos + 1] == "\"" and source[pos + 2] == "\"")
                if source[pos] == "\n"
                    line = line + 1
                    col = 1
                else
                    col = col + 1
                _tq = _tq + source[pos]
                pos = pos + 1
            if pos >= length
                lex_error_file("E0010", "unterminated triple-quoted string", filename, start_line, start_col, "string opened with triple-quote was never closed")
            pos = pos + 3
            col = col + 3
            push(tokens, Token("STR", _dedent_block(_tq), line, start_col))
        else if ch == "\""
            let start_col = col
            let start_line = line
            pos = pos + 1
            col = col + 1
            let fstr = ""
            let has_interp = false
            while pos < length and source[pos] != "\""
                if source[pos] == "\n"
                    lex_error_file("E0010", "unterminated string literal", filename, start_line, start_col, "string literals must be closed with \" before the end of the line; use \\n for embedded newlines")
                if source[pos] == "\\" and pos + 1 < length
                    let esc = source[pos + 1]
                    if esc == "\{"
                        fstr = fstr + "\{"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "\}"
                        fstr = fstr + "\}"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "n"
                        fstr = fstr + "\n"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "t"
                        fstr = fstr + "\t"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "r"
                        fstr = fstr + "\r"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "\\"
                        fstr = fstr + "\\"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "\""
                        fstr = fstr + "\""
                        pos = pos + 2
                        col = col + 2
                    else if esc == "0"
                        fstr = fstr + "\0"
                        pos = pos + 2
                        col = col + 2
                    else if esc == "u" and pos + 2 < length and source[pos + 2] == "\{"
                        pos = pos + 3
                        col = col + 3
                        let _ucp = 0
                        while pos < length and source[pos] != "\}"
                            let _uc = source[pos]
                            if is_digit(_uc)
                                _ucp = _ucp * 16 + (ord(_uc) - ord("0"))
                            else if _uc == "a" or _uc == "b" or _uc == "c" or _uc == "d" or _uc == "e" or _uc == "f"
                                _ucp = _ucp * 16 + (ord(_uc) - ord("a") + 10)
                            else if _uc == "A" or _uc == "B" or _uc == "C" or _uc == "D" or _uc == "E" or _uc == "F"
                                _ucp = _ucp * 16 + (ord(_uc) - ord("A") + 10)
                            else
                                lex_error_file("E0011", "invalid hex digit '" + _uc + "' in \\u\{...\} escape", filename, line, col, "unicode escapes use hex digits: \\u\{0041\} for 'A'")
                            pos = pos + 1
                            col = col + 1
                        if pos < length
                            pos = pos + 1
                            col = col + 1
                        if _ucp < 128
                            fstr = fstr + chr(_ucp)
                        else if _ucp < 2048
                            fstr = fstr + chr(192 + _ucp / 64) + chr(128 + _ucp - (_ucp / 64) * 64)
                        else if _ucp < 65536
                            let _u2 = _ucp / 64
                            let _u1 = _u2 / 64
                            fstr = fstr + chr(224 + _u1) + chr(128 + _u2 - _u1 * 64) + chr(128 + _ucp - _u2 * 64)
                        else
                            let _u3 = _ucp / 64
                            let _u2b = _u3 / 64
                            let _u1b = _u2b / 64
                            fstr = fstr + chr(240 + _u1b) + chr(128 + _u2b - _u1b * 64) + chr(128 + _u3 - _u2b * 64) + chr(128 + _ucp - _u3 * 64)
                    else
                        lex_error_file("E0011", "invalid escape sequence '\\" + esc + "' in string", filename, line, col, "valid escapes are: \\n \\t \\r \\\\ \\\" \\0 \\u\{XXXX\} \\\{ \\\}")
                else if source[pos] == "\{"
                    if not has_interp
                        push(tokens, Token("INTERP_START", fstr, line, start_col))
                    else
                        push(tokens, Token("INTERP_MID", fstr, line, col))
                    fstr = ""
                    has_interp = true
                    pos = pos + 1
                    col = col + 1
                    let depth = 1
                    let interp_src = ""
                    let _is_pd = 0
                    let _is_bd = 0
                    let _is_spec = ""
                    let _is_in_spec = false
                    while pos < length and depth > 0
                        if source[pos] == "\{"
                            depth = depth + 1
                            if _is_in_spec
                                _is_spec = _is_spec + source[pos]
                            else
                                interp_src = interp_src + source[pos]
                        else if source[pos] == "\}"
                            depth = depth - 1
                            if depth > 0
                                if _is_in_spec
                                    _is_spec = _is_spec + source[pos]
                                else
                                    interp_src = interp_src + source[pos]
                        else if source[pos] == "\\" and pos + 1 < length and source[pos + 1] == "\""
                            if _is_in_spec
                                _is_spec = _is_spec + "\""
                            else
                                interp_src = interp_src + "\""
                            pos = pos + 1
                            col = col + 1
                        else if source[pos] == ":" and depth == 1 and _is_pd == 0 and _is_bd == 0 and not _is_in_spec
                            _is_in_spec = true
                        else
                            if _is_in_spec
                                _is_spec = _is_spec + source[pos]
                            else
                                if source[pos] == "("
                                    _is_pd = _is_pd + 1
                                else if source[pos] == ")"
                                    _is_pd = _is_pd - 1
                                else if source[pos] == "["
                                    _is_bd = _is_bd + 1
                                else if source[pos] == "]"
                                    _is_bd = _is_bd - 1
                                interp_src = interp_src + source[pos]
                        if depth > 0
                            pos = pos + 1
                            col = col + 1
                    pos = pos + 1
                    col = col + 1
                    let inner_tokens = tokenize(interp_src)
                    for itk in inner_tokens
                        match itk
                            Token(ik, iv, il, ic) =>
                                if ik != "EOF"
                                    push(tokens, Token(ik, iv, line, ic))
                    if len(_is_spec) > 0
                        push(tokens, Token("INTERP_SPEC", _is_spec, line, col))
                else
                    fstr = fstr + source[pos]
                    pos = pos + 1
                    col = col + 1
            if pos >= length
                lex_error_file("E0010", "unterminated string literal", filename, start_line, start_col, "string literal opened with \" was never closed")
            pos = pos + 1
            col = col + 1
            if has_interp
                push(tokens, Token("INTERP_END", fstr, line, col))
            else
                push(tokens, Token("STR", fstr, line, start_col))
        else if ch == "`"
            let start_col = col
            let start_line = line
            // Triple-backtick raw TEXT BLOCK: ```...``` with common-indent stripping
            // (multi-line, raw — no escape/interp processing — for embedded SQL/HTML/
            // regex/JSON). Lowers to the same RAW_STR token after dedent.
            if pos + 2 < length and source[pos + 1] == "`" and source[pos + 2] == "`"
                pos = pos + 3
                col = col + 3
                let tb = ""
                while pos < length and not (source[pos] == "`" and pos + 2 < length and source[pos + 1] == "`" and source[pos + 2] == "`")
                    if source[pos] == "\n"
                        line = line + 1
                        col = 1
                    else
                        col = col + 1
                    tb = tb + source[pos]
                    pos = pos + 1
                if pos >= length
                    lex_error_file("E0010", "unterminated text block", filename, start_line, start_col, "text block opened with ``` was never closed")
                pos = pos + 3
                col = col + 3
                push(tokens, Token("RAW_STR", _dedent_block(tb), line, start_col))
            else
                pos = pos + 1
                col = col + 1
                let raw = ""
                while pos < length and source[pos] != "`"
                    if source[pos] == "\n"
                        line = line + 1
                        col = 1
                    else
                        col = col + 1
                    raw = raw + source[pos]
                    pos = pos + 1
                if pos >= length
                    lex_error_file("E0010", "unterminated raw string literal", filename, start_line, start_col, "raw string opened with ` was never closed")
                pos = pos + 1
                col = col + 1
                push(tokens, Token("RAW_STR", raw, line, start_col))
        else if ch == "(" or ch == ")" or ch == "[" or ch == "]" or ch == "\{" or ch == "\}"
            push(tokens, Token("DELIM", ch, line, col))
            pos = pos + 1
            col = col + 1
        else if ch == ","
            push(tokens, Token("COMMA", ",", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == ":"
            // `:name` atom literal vs the COLON used for type annotations / dict
            // keys. It is an atom when ':' is immediately followed by an identifier
            // char AND the previous token is not a value (we are in value position).
            // Every type/dict colon in NOVA follows an IDENT/STR/value, so those
            // stay COLON; atoms appear after '(', ',', '=', '[', '=>', return, etc.
            let atom_next = pos + 1 < length and is_alpha(source[pos + 1])
            let prev_val = false
            if len(tokens) > 0
                match tokens[len(tokens) - 1]
                    Token(ptk, ptv, ptl, ptc) =>
                        if ptk == "IDENT" or ptk == "INT" or ptk == "FLOAT" or ptk == "STR" or ptk == "RAW_STR" or ptk == "ATOM"
                            prev_val = true
                        else if ptk == "DELIM" and (ptv == ")" or ptv == "]" or ptv == "\}")
                            prev_val = true
                        else if ptk == "KW" and (ptv == "true" or ptv == "false" or ptv == "null")
                            prev_val = true
            if atom_next and not prev_val
                let astart = pos + 1
                let ap = astart
                while ap < length and is_alnum(source[ap])
                    ap = ap + 1
                push(tokens, Token("ATOM", slice(source, astart, ap), line, col))
                col = col + (ap - pos)
                pos = ap
            else
                push(tokens, Token("COLON", ":", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "."
            if pos + 1 < length and source[pos + 1] == "."
                push(tokens, Token("DOTDOT", "..", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("DOT", ".", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "+"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "+=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "+", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "-"
            if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("ARROW", "->", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "-=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "-", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "*"
            if pos + 1 < length and source[pos + 1] == "*" and pos + 2 < length and source[pos + 2] == "="
                push(tokens, Token("OP", "**=", line, col))
                pos = pos + 3
                col = col + 3
            else if pos + 1 < length and source[pos + 1] == "*"
                push(tokens, Token("OP", "**", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "*=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "*", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "/"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "/=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "/", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "%"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "%=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "%", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "="
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "==", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("FAT_ARROW", "=>", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("ASSIGN", "=", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "!"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "!=", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "!", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "<"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", "<=", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == "<"
                push(tokens, Token("OP", "<<", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "<", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == ">"
            if pos + 1 < length and source[pos + 1] == "="
                push(tokens, Token("OP", ">=", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("OP", ">>", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", ">", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "&"
            push(tokens, Token("OP", "&", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "|"
            if pos + 1 < length and source[pos + 1] == ">"
                push(tokens, Token("PIPE_GT", "|>", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("OP", "|", line, col))
                pos = pos + 1
                col = col + 1
        else if ch == "^"
            push(tokens, Token("OP", "^", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "~"
            push(tokens, Token("OP", "~", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "?"
            if pos + 1 < length and source[pos + 1] == "."
                push(tokens, Token("QDOT", "?.", line, col))
                pos = pos + 2
                col = col + 2
            else if pos + 1 < length and source[pos + 1] == "?"
                push(tokens, Token("QQUEST", "??", line, col))
                pos = pos + 2
                col = col + 2
            else
                push(tokens, Token("QUESTION", "?", line, col))
                pos = pos + 1
                col = col + 1
        else
            lex_error_file("E0013", "unexpected character '" + ch + "' (code " + str(ord(ch)) + ") in source", filename, line, col, "NOVA source must be ASCII; statements end with newlines, not semicolons or other punctuation")

    push(tokens, Token("EOF", filename, line, col))
    tokens

// ── Parser Utilities ─────────────────────────────────────────────────────────

// Token accessors clamp an out-of-range pos to the always-present EOF sentinel.
// The lexer appends exactly one EOF token, so a parser that advances past it (e.g.
// during error recovery inside an unclosed '(' that swallows tokens past EOF) must
// still read EOF — NOT index out of bounds. nova_rt_list_get returns 0 for an OOB
// index, and `match 0` against Token(...) dereferences null (0xC0000005). Clamping
// turns that crash into graceful EOF termination so multiple parse errors report.
fn tok_at(tokens: list, pos: int) -> Token
    let p = pos
    if p >= len(tokens)
        p = len(tokens) - 1
    tokens[p]

fn tk(tokens: list, pos: int) -> string
    let p = pos
    if p >= len(tokens)
        p = len(tokens) - 1
    match tokens[p]
        Token(kind, value, line, col) => kind

fn tv(tokens: list, pos: int) -> string
    let p = pos
    if p >= len(tokens)
        p = len(tokens) - 1
    match tokens[p]
        Token(kind, value, line, col) => value

fn tl(tokens: list, pos: int) -> int
    let p = pos
    if p >= len(tokens)
        p = len(tokens) - 1
    match tokens[p]
        Token(kind, value, line, col) => line

fn skip_nl(tokens: list, pos: int) -> int
    while tk(tokens, pos) == "NEWLINE"
        pos = pos + 1
    pos

fn tok_line(tokens: list, pos: int) -> int
    let p = pos
    if p >= len(tokens)
        p = len(tokens) - 1
    match tokens[p]
        Token(kind, value, line, col) => line

fn tok_col(tokens: list, pos: int) -> int
    let p = pos
    if p >= len(tokens)
        p = len(tokens) - 1
    match tokens[p]
        Token(kind, value, line, col) => col

// Read filename from the EOF token's value, if present.
fn tok_filename(tokens: list) -> string
    let n = len(tokens)
    if n == 0
        return ""
    match tokens[n - 1]
        Token(k, v, l, c) =>
            if k == "EOF"
                return v
    ""

// Records a syntax error (accumulate all, not exit-on-first).
// Returns the position of the next top-level sync token for recovery.
fn syntax_error(tokens: list, pos: int, msg: string, pe: list) -> int
    let ln = tok_line(tokens, pos)
    let cl = tok_col(tokens, pos)
    let raw_fname = tok_filename(tokens)
    let fname = raw_fname
    if fname == ""
        fname = "<source>"
    let help = ""
    if contains(msg, "expected ')'")
        help = "you may be missing a closing ')' or have an unbalanced expression"
    else if contains(msg, "expected '('")
        help = "function calls and parameter lists require parentheses"
    else if contains(msg, "expected ','")
        help = "list and argument items must be separated by commas"
    else if contains(msg, "expected ':'")
        help = "type annotations and dict literals use ':' between name and value"
    else if contains(msg, "unexpected")
        help = "check that the surrounding syntax (parens, braces, indentation) is balanced"
    else if contains(msg, "reserved keyword")
        help = "rename the variable (reserved words include match, loop, type, in, unsafe, del, with, defer)"
    let out = "error[E0001]: " + msg + "\n  --> " + fname + ":" + str(ln) + ":" + str(cl) + "\n" + format_source_snippet(raw_fname, ln)
    if help != ""
        out = out + "  = help: " + help + "\n"
    push(pe, out)
    sync_to_stmt(tokens, pos)

fn expect(tokens: list, pos: int, expected_val: string, pe: list) -> int
    if tv(tokens, pos) != expected_val
        return syntax_error(tokens, pos, "expected '" + expected_val + "' but found '" + tv(tokens, pos) + "'", pe)
    pos + 1

// ── Operator Precedence (Pratt Parser) ───────────────────────────────────────

fn prefix_bp(op: string) -> int
    if op == "-" or op == "not" or op == "~"
        27
    else
        0

fn infix_bp(op: string) -> list
    if op == "catch"
        [2, 3]
    else if op == "or"
        [3, 4]
    else if op == "and"
        [5, 6]
    else if op == "|"
        [7, 8]
    else if op == "^"
        [9, 10]
    else if op == "&"
        [11, 12]
    else if op == "==" or op == "!=" or op == "matches"
        [13, 14]
    else if op == "<" or op == ">" or op == "<=" or op == ">=" or op == "in"
        [15, 16]
    else if op == "<<" or op == ">>"
        [17, 18]
    else if op == "+" or op == "-"
        [19, 20]
    else if op == "*" or op == "/" or op == "%"
        [21, 22]
    else if op == "**"
        [24, 23]
    else if op == "|>"
        [2, 3]
    else if op == ".."
        [1, 2]
    else
        [0, 0]

fn is_infix_op(tokens: list, pos: int) -> bool
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)
    if kind == "OP"
        let bp = infix_bp(val)
        bp[0] > 0
    else if kind == "KW" and (val == "and" or val == "or" or val == "in" or val == "matches" or val == "catch")
        true
    else if kind == "DOTDOT"
        true
    else if kind == "PIPE_GT"
        true
    else
        false

fn get_infix_op(tokens: list, pos: int) -> string
    tv(tokens, pos)

// ── Expression Parser ────────────────────────────────────────────────────────

fn null_expr() -> Expr
    Expr("null", "", 0, [], [], 0)

fn parse_expr(tokens: list, pos: int, min_bp: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let left_r = parse_prefix(tokens, pos, pe)
    let left = left_r.expr
    let cur = left_r.pos

    while cur < len(tokens) and tk(tokens, cur) != "EOF"
        if tk(tokens, cur) == "NEWLINE"
            let _nlp = skip_nl(tokens, cur)
            if tk(tokens, _nlp) == "DOT" or tk(tokens, _nlp) == "PIPE_GT"
                cur = _nlp
            else
                break
        if tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "("
            let call_r = parse_call_args(tokens, cur, left, pe)
            left = call_r.expr
            cur = call_r.pos
        else if tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "["
            let idx_r = parse_index(tokens, cur, left, pe)
            left = idx_r.expr
            cur = idx_r.pos
        else if tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "\{"
            match left
                Expr(ltag, lval, lnum, lchildren, lfields, lln) =>
                    if ltag == "ident"
                        let struct_fields = []
                        let sp = cur + 1
                        while sp < len(tokens) and tv(tokens, sp) != "\}" and tk(tokens, sp) != "EOF"
                            if len(struct_fields) > 0
                                sp = expect(tokens, sp, ",", pe)
                                if tv(tokens, sp) == "\}" or tk(tokens, sp) == "EOF"
                                    break
                            if tk(tokens, sp) == "DOTDOT" and tk(tokens, sp + 1) == "DOT"
                                sp = sp + 2
                                let _ss_r = parse_expr(tokens, sp, 0, pe)
                                push(struct_fields, Expr("struct_spread", "", 0, [_ss_r.expr], [], ln))
                                sp = _ss_r.pos
                            else
                                let fname = tv(tokens, sp)
                                sp = sp + 1
                                sp = expect(tokens, sp, ":", pe)
                                let fval_r = parse_expr(tokens, sp, 0, pe)
                                push(struct_fields, Expr("field_init", fname, 0, [fval_r.expr], [], ln))
                                sp = fval_r.pos
                        sp = expect(tokens, sp, "\}", pe)
                        left = Expr("struct_init", lval, 0, struct_fields, [], ln)
                        cur = sp
                    else
                        break
        else if tk(tokens, cur) == "DOT"
            cur = cur + 1
            let member_name = tv(tokens, cur)
            cur = cur + 1
            // Check for method call: obj.method(args)
            if cur < len(tokens) and tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "("
                let method_r = parse_call_args(tokens, cur, Expr("member", member_name, 0, [left], [], ln), pe)
                left = method_r.expr
                cur = method_r.pos
            else
                left = Expr("member", member_name, 0, [left], [], ln)
        else if tk(tokens, cur) == "QUESTION"
            left = Expr("try_unwrap", "", 0, [left], [], ln)
            cur = cur + 1
        else if tk(tokens, cur) == "QDOT"
            cur = cur + 1
            let _qd_mn = tv(tokens, cur)
            cur = cur + 1
            let _qd_unwrapped = Expr("call", "unwrap", 0, [left], [], ln)
            if cur < len(tokens) and tk(tokens, cur) == "DELIM" and tv(tokens, cur) == "("
                let _qd_mcall = parse_call_args(tokens, cur, Expr("member", _qd_mn, 0, [_qd_unwrapped], [], ln), pe)
                left = Expr("if", "", 0, [Expr("call", "is_some", 0, [left], [], ln), Expr("call", "some", 0, [_qd_mcall.expr], [], ln), Expr("call", "none", 0, [], [], ln)], [], ln)
                cur = _qd_mcall.pos
            else
                let _qd_fld = Expr("member", _qd_mn, 0, [_qd_unwrapped], [], ln)
                left = Expr("if", "", 0, [Expr("call", "is_some", 0, [left], [], ln), Expr("call", "some", 0, [_qd_fld], [], ln), Expr("call", "none", 0, [], [], ln)], [], ln)
        else if tk(tokens, cur) == "QQUEST"
            cur = cur + 1
            let _qq_rhs = parse_expr(tokens, cur, 2, pe)
            left = Expr("if", "", 0, [Expr("call", "is_some", 0, [left], [], ln), Expr("call", "unwrap", 0, [left], [], ln), _qq_rhs.expr], [], ln)
            cur = _qq_rhs.pos
        else if tk(tokens, cur) == "KW" and tv(tokens, cur) == "not" and cur + 1 < len(tokens) and tk(tokens, cur + 1) == "KW" and tv(tokens, cur + 1) == "in" and min_bp <= 15
            cur = cur + 2
            let _ni_rhs = parse_expr(tokens, cur, 16, pe)
            left = Expr("unary", "not", 0, [Expr("binop", "in", 0, [left, _ni_rhs.expr], [], ln)], [], ln)
            cur = _ni_rhs.pos
        else if tk(tokens, cur) == "FAT_ARROW" and min_bp <= 1
            cur = cur + 1
            let body_r = parse_expr(tokens, cur, 0, pe)
            match left
                Expr(ltag, lval, lnum, lchildren, lfields, lln) =>
                    if ltag == "ident"
                        left = Expr("lambda", "", 0, [body_r.expr], [left], ln)
                    else if ltag == "tuple"
                        left = Expr("lambda", "", 0, [body_r.expr], lchildren, ln)
                    else
                        left = Expr("lambda", "", 0, [body_r.expr], [left], ln)
            cur = body_r.pos
        else if is_infix_op(tokens, cur)
            let op = get_infix_op(tokens, cur)
            let bp = infix_bp(op)
            let lbp = bp[0]
            let rbp = bp[1]
            if lbp < min_bp
                break
            cur = cur + 1
            if op == "catch"
                let err_var = tv(tokens, cur)
                cur = cur + 1
                let pre_nl = cur
                cur = skip_nl(tokens, cur)
                if pre_nl != cur and tk(tokens, cur) != "EOF"
                    let body_col = tok_col(tokens, cur)
                    let body_stmts = []
                    // NOTE: this loop skips newlines to find its next handler statement, so on
                    // exit `cur` sits DIRECTLY on the following token rather than on a NEWLINE
                    // (unlike every other statement). See _tf_is_trailing — that difference is
                    // what let a following `fn` declaration be mistaken for a trailing lambda.
                    while tk(tokens, cur) != "EOF" and tok_col(tokens, cur) >= body_col
                        let sr = parse_stmt(tokens, cur, pe)
                        push(body_stmts, sr.stmt)
                        cur = skip_nl(tokens, sr.pos)
                    if len(body_stmts) > 1
                        left = Expr("catch", err_var, len(body_stmts), [left], body_stmts, ln)
                    else if len(body_stmts) == 1
                        match body_stmts[0]
                            Stmt(stag, sname, sexpr, sbody, sparams, selse, sanns, ssln) =>
                                left = Expr("catch", err_var, 0, [left, sexpr], [], ln)
                    else
                        left = Expr("catch", err_var, 0, [left, null_expr()], [], ln)
                else
                    // Inline handler: `EXPR catch e => handler`. Consume the optional `=>` (the
                    // documented concise form) before parsing the handler expression -- without this
                    // the parser hit the FAT_ARROW as an unexpected token ("unexpected FAT_ARROW '=>'
                    // in expression"). `EXPR catch e handler` (no arrow) still works too.
                    if tk(tokens, cur) == "FAT_ARROW"
                        cur = cur + 1
                    let handler_r = parse_expr(tokens, cur, 0, pe)
                    left = Expr("catch", err_var, 0, [left, handler_r.expr], [], ln)
                    cur = handler_r.pos
            else if op == "|>"
                let right_r = parse_expr(tokens, cur, rbp, pe)
                let _pr = right_r.expr
                cur = right_r.pos
                match _pr
                    Expr(_pt, _pv, _pn, _pc, _pf, _pl) =>
                        if _pt == "call"
                            let _pargs = [left]
                            for _pa in _pc
                                push(_pargs, _pa)
                            left = Expr("call", _pv, 0, _pargs, _pf, ln)
                        else if _pt == "method_call"
                            let _pargs2 = [left]
                            for _pa2 in _pc
                                push(_pargs2, _pa2)
                            left = Expr("method_call", _pv, 0, _pargs2, _pf, ln)
                        else if _pt == "ident"
                            left = Expr("call", _pv, 0, [left], [], ln)
                        else
                            left = Expr("call", "", 0, [_pr, left], [], ln)
            else
                let right_r = parse_expr(tokens, cur, rbp, pe)
                left = Expr("binop", op, 0, [left, right_r.expr], [], ln)
                cur = right_r.pos
                // Chained comparisons: a < b < c  =>  a < b and b < c
                if op == "<" or op == ">" or op == "<=" or op == ">=" or op == "==" or op == "!="
                    let _cc_mid = right_r.expr
                    while cur < len(tokens) and is_infix_op(tokens, cur)
                        let _cc_op2 = get_infix_op(tokens, cur)
                        if _cc_op2 != "<" and _cc_op2 != ">" and _cc_op2 != "<=" and _cc_op2 != ">=" and _cc_op2 != "==" and _cc_op2 != "!="
                            break
                        cur = cur + 1
                        let _cc_right = parse_expr(tokens, cur, rbp, pe)
                        let _cc_cmp = Expr("binop", _cc_op2, 0, [_cc_mid, _cc_right.expr], [], ln)
                        left = Expr("binop", "and", 0, [left, _cc_cmp], [], ln)
                        _cc_mid = _cc_right.expr
                        cur = _cc_right.pos
        else
            break

    if min_bp == 0 and cur > 0 and tk(tokens, cur) == "KW" and tv(tokens, cur) == "if" and tl(tokens, cur) == tl(tokens, cur - 1)
        let _tern_cp = cur + 1
        let _tern_cond = parse_expr(tokens, _tern_cp, 0, pe)
        _tern_cp = _tern_cond.pos
        if tk(tokens, _tern_cp) == "KW" and tv(tokens, _tern_cp) == "else"
            _tern_cp = _tern_cp + 1
            let _tern_else = parse_expr(tokens, _tern_cp, 0, pe)
            left = Expr("if", "", 0, [_tern_cond.expr, left, _tern_else.expr], [], ln)
            cur = _tern_else.pos
    ParseResult(left, cur)

fn _comp_subst(e: Expr, old_name: string, new_e: Expr) -> Expr
    match e
        Expr(t, v, n, ch, f, ln) =>
            if t == "ident" and v == old_name
                return new_e
            let nc = []
            for c in ch
                push(nc, _comp_subst(c, old_name, new_e))
            let nf = []
            for fi in f
                push(nf, _comp_subst(fi, old_name, new_e))
            return Expr(t, v, n, nc, nf, ln)
    return e

fn parse_prefix(tokens: list, pos: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)

    if kind == "INT"
        // L7 increment 1: split an optional sized suffix ("255#u8") off the digits and
        // range-check the small widths. The value is produced as a normal i64 literal
        // (full sized-type propagation + wrapping arithmetic is increment 2); a sized
        // literal that overflows its width is a clean parse error rather than a footgun.
        let _digits = val
        let _isuf = ""
        let _hash = find(val, "#")
        if _hash != 0 - 1
            _digits = slice(val, 0, _hash)
            _isuf = slice(val, _hash + 1, len(val))
            let _mx = _num_suffix_max(_isuf)
            if _mx >= 0 and int(_digits) > _mx
                let _rc = syntax_error(tokens, pos, "integer literal '" + _digits + _isuf + "' is out of range for " + _isuf + " (max " + str(_mx) + ")", pe)
                return ParseResult(Expr("int", "0", 0, [], [], ln), _rc)
        // LOCK-4 inc3b (crash fix): carry the sized suffix in the VALUE string as "<digits>#<suffix>"
        // (the token's own form; the numeric value lives in `num`). The Expr `fields` list is walked
        // GENERICALLY as child Exprs by the s4 loop pass (s4_e_ok / s4_rename_e do `for f in e.fields`
        // and treat each as an Expr) -> a bare suffix STRING there is dereferenced as an Expr and
        // crashes on a sized literal inside a loop. The value string is a scalar, only read by the
        // literal-suffix helpers. Plain literals keep `val == digits` (unchanged); sized carry a "#".
        ParseResult(Expr("int", val, int(_digits), [], [], ln), pos + 1)
    else if kind == "FLOAT"
        // A float literal's `num` field is otherwise unused (all three consumers read only
        // `value`), so the f32 suffix rides there: 1 = f32, 0 = default f64. It must NOT go
        // in `fields` -- the s4 loop pass walks an Expr's fields GENERICALLY as child Exprs,
        // and storing a bare string there is what segfaulted the compiler during inc3b.
        ParseResult(Expr("float", _float_digits(val), _float_is_f32(val), [], [], ln), pos + 1)
    else if kind == "STR"
        ParseResult(Expr("str", val, 0, [], [], ln), pos + 1)
    else if kind == "RAW_STR"
        ParseResult(Expr("str", val, 0, [], [], ln), pos + 1)
    else if kind == "KW" and val == "true"
        ParseResult(Expr("bool", "true", 1, [], [], ln), pos + 1)
    else if kind == "KW" and val == "false"
        ParseResult(Expr("bool", "false", 0, [], [], ln), pos + 1)
    else if kind == "KW" and val == "null"
        ParseResult(Expr("null", "", 0, [], [], ln), pos + 1)
    else if kind == "IDENT"
        ParseResult(Expr("ident", val, 0, [], [], ln), pos + 1)
    else if kind == "ATOM"
        // `:name` interned-symbol literal — lowered to the canonical string ":name"
        // so it works in ==, print, match and as a map key. Distinct from a plain
        // string by its leading ':' (full type-distinctness is a future refinement).
        ParseResult(Expr("str", ":" + val, 0, [], [], ln), pos + 1)
    else if kind == "OP" and val == "-"
        if tk(tokens, pos + 1) == "FLOAT"
            let fv = tv(tokens, pos + 1)
            ParseResult(Expr("float", "-" + _float_digits(fv), _float_is_f32(fv), [], [], ln), pos + 2)
        else
            let rbp = prefix_bp("-")
            let operand_r = parse_expr(tokens, pos + 1, rbp, pe)
            ParseResult(Expr("unary", "-", 0, [operand_r.expr], [], ln), operand_r.pos)
    else if kind == "KW" and val == "not"
        let rbp = prefix_bp("not")
        let operand_r = parse_expr(tokens, pos + 1, rbp, pe)
        ParseResult(Expr("unary", "not", 0, [operand_r.expr], [], ln), operand_r.pos)
    else if kind == "OP" and val == "~"
        let rbp = prefix_bp("~")
        let operand_r = parse_expr(tokens, pos + 1, rbp, pe)
        ParseResult(Expr("unary", "~", 0, [operand_r.expr], [], ln), operand_r.pos)
    else if kind == "OP" and val == "|"
        let _sl_p = pos + 1
        let _sl_params = []
        if not (tk(tokens, _sl_p) == "OP" and tv(tokens, _sl_p) == "|")
            push(_sl_params, Expr("ident", tv(tokens, _sl_p), 0, [], [], ln))
            _sl_p = _sl_p + 1
            while tk(tokens, _sl_p) == "COMMA"
                _sl_p = _sl_p + 1
                push(_sl_params, Expr("ident", tv(tokens, _sl_p), 0, [], [], ln))
                _sl_p = _sl_p + 1
        _sl_p = expect(tokens, _sl_p, "|", pe)
        let _sl_body_r = parse_expr(tokens, _sl_p, 0, pe)
        ParseResult(Expr("lambda", "", 0, [_sl_body_r.expr], _sl_params, ln), _sl_body_r.pos)
    else if kind == "DELIM" and val == "("
        // Grouped expression or tuple
        let inner_r = parse_expr(tokens, pos + 1, 0, pe)
        if tk(tokens, inner_r.pos) == "COMMA"
            // Tuple literal
            let elements = [inner_r.expr]
            let p = inner_r.pos
            while tv(tokens, p) == "," and tk(tokens, p) != "EOF"
                p = p + 1
                let elem_r = parse_expr(tokens, p, 0, pe)
                push(elements, elem_r.expr)
                p = elem_r.pos
            p = expect(tokens, p, ")", pe)
            ParseResult(Expr("tuple", "", 0, elements, [], ln), p)
        else
            let p2 = expect(tokens, inner_r.pos, ")", pe)
            ParseResult(inner_r.expr, p2)
    else if kind == "DELIM" and val == "["
        // List literal — trailing comma allowed: [1, 2, 3,] — OR a comprehension:
        //   [ EXPR for VAR in ITER (if COND)? ]
        // The comprehension desugars (parse-time, no new IR) to map/filter over the
        // source so it reuses NOVA's first-class functions: with a filter it becomes
        //   map(filter(ITER, fn(VAR) COND), fn(VAR) EXPR)
        // and without, just map(ITER, fn(VAR) EXPR). (ITER is a list/range in v1.)
        let p = skip_nl(tokens, pos + 1)
        if tv(tokens, p) == "]"
            ParseResult(Expr("list", "", 0, [], [], ln), p + 1)
        else
            let _sp_first = false
            if tk(tokens, p) == "DOTDOT" and tk(tokens, p + 1) == "DOT"
                _sp_first = true
                p = p + 2
            let first_r = parse_expr(tokens, p, 0, pe)
            p = skip_nl(tokens, first_r.pos)
            if not _sp_first and tk(tokens, p) == "KW" and tv(tokens, p) == "for"
                let cvars = []
                let citers = []
                let cfilters = []
                let cdestr = []
                while tk(tokens, p) == "KW" and tv(tokens, p) == "for"
                    p = p + 1
                    let _cd_vars = []
                    let cvar = ""
                    if tk(tokens, p) == "DELIM" and tv(tokens, p) == "("
                        p = p + 1
                        while not (tk(tokens, p) == "DELIM" and tv(tokens, p) == ")") and tk(tokens, p) != "EOF"
                            if tk(tokens, p) == "IDENT"
                                push(_cd_vars, tv(tokens, p))
                                p = p + 1
                            if tv(tokens, p) == ","
                                p = p + 1
                        p = p + 1
                        cvar = "__comp_tup_" + str(ln)
                    else
                        cvar = tv(tokens, p)
                        p = p + 1
                    p = expect(tokens, p, "in", pe)
                    let iter_r = parse_expr(tokens, p, 0, pe)
                    p = iter_r.pos
                    let _cd_iter = iter_r.expr
                    if len(_cd_vars) > 0
                        _cd_iter = Expr("call", "__destr_iter", 0, [iter_r.expr], [], ln)
                    let myfilters = []
                    while tk(tokens, p) == "KW" and tv(tokens, p) == "if"
                        p = p + 1
                        let cond_r = parse_expr(tokens, p, 0, pe)
                        push(myfilters, cond_r.expr)
                        p = cond_r.pos
                    push(cvars, cvar)
                    push(citers, _cd_iter)
                    push(cfilters, myfilters)
                    push(cdestr, _cd_vars)
                p = expect(tokens, p, "]", pe)
                let nclauses = len(cvars)
                let result = null_expr()
                let idx = nclauses - 1
                while idx >= 0
                    let cv = cvars[idx]
                    let src = citers[idx]
                    let _cd_body = first_r.expr
                    if len(cdestr[idx]) > 0
                        let _cdi = 0
                        while _cdi < len(cdestr[idx])
                            let _cd_repl = Expr("index", "", 0, [Expr("ident", cv, 0, [], [], ln), Expr("int", "", _cdi, [], [], ln)], [], ln)
                            _cd_body = _comp_subst(_cd_body, cdestr[idx][_cdi], _cd_repl)
                            _cdi = _cdi + 1
                    for fcond in cfilters[idx]
                        let _fc = fcond
                        if len(cdestr[idx]) > 0
                            let _fci = 0
                            while _fci < len(cdestr[idx])
                                let _fc_repl = Expr("index", "", 0, [Expr("ident", cv, 0, [], [], ln), Expr("int", "", _fci, [], [], ln)], [], ln)
                                _fc = _comp_subst(_fc, cdestr[idx][_fci], _fc_repl)
                                _fci = _fci + 1
                        src = Expr("call", "filter", 0, [src, Expr("lambda", "", 0, [_fc], [Expr("ident", cv, 0, [], [], ln)], ln)], [], ln)
                    if idx == nclauses - 1
                        result = Expr("call", "map", 0, [src, Expr("lambda", "", 0, [_cd_body], [Expr("ident", cv, 0, [], [], ln)], ln)], [], ln)
                    else
                        let mapped = Expr("call", "map", 0, [src, Expr("lambda", "", 0, [result], [Expr("ident", cv, 0, [], [], ln)], ln)], [], ln)
                        result = Expr("call", "flatten", 0, [mapped], [], ln)
                    idx = idx - 1
                ParseResult(result, p)
            else
                let elements = [first_r.expr]
                let _sp_flags = [_sp_first]
                let _has_spread = _sp_first
                while tv(tokens, p) != "]" and tk(tokens, p) != "EOF"
                    p = expect(tokens, p, ",", pe)
                    p = skip_nl(tokens, p)
                    if tv(tokens, p) == "]" or tk(tokens, p) == "EOF"
                        break
                    let _sp = false
                    if tk(tokens, p) == "DOTDOT" and tk(tokens, p + 1) == "DOT"
                        _sp = true
                        _has_spread = true
                        p = p + 2
                    let elem_r = parse_expr(tokens, p, 0, pe)
                    push(elements, elem_r.expr)
                    push(_sp_flags, _sp)
                    if elem_r.pos <= p
                        break
                    p = skip_nl(tokens, elem_r.pos)
                p = expect(tokens, p, "]", pe)
                if not _has_spread
                    ParseResult(Expr("list", "", 0, elements, [], ln), p)
                else
                    let _sp_parts = []
                    let _sp_group = []
                    let _sp_i = 0
                    while _sp_i < len(elements)
                        if _sp_flags[_sp_i]
                            if len(_sp_group) > 0
                                push(_sp_parts, Expr("list", "", 0, _sp_group, [], ln))
                                _sp_group = []
                            push(_sp_parts, elements[_sp_i])
                        else
                            push(_sp_group, elements[_sp_i])
                        _sp_i = _sp_i + 1
                    if len(_sp_group) > 0
                        push(_sp_parts, Expr("list", "", 0, _sp_group, [], ln))
                    let _sp_outer = Expr("list", "", 0, _sp_parts, [], ln)
                    ParseResult(Expr("call", "flatten", 0, [_sp_outer], [], ln), p)
    else if kind == "DELIM" and val == "\{"
        let p = skip_nl(tokens, pos + 1)
        if tv(tokens, p) == "\}"
            ParseResult(Expr("dict", "", 0, [], [], ln), p + 1)
        else
            let _ds_first = false
            if tk(tokens, p) == "DOTDOT" and tk(tokens, p + 1) == "DOT"
                _ds_first = true
                p = p + 2
            if _ds_first
                let _ds_expr0 = parse_expr(tokens, p, 0, pe)
                p = _ds_expr0.pos
                let _ds_parts = [_ds_expr0.expr]
                let _ds_flags = [true]
                while tv(tokens, p) != "\}" and tk(tokens, p) != "EOF"
                    p = expect(tokens, p, ",", pe)
                    if tv(tokens, p) == "\}" or tk(tokens, p) == "EOF"
                        break
                    if tk(tokens, p) == "DOTDOT" and tk(tokens, p + 1) == "DOT"
                        p = p + 2
                        let _ds_sp = parse_expr(tokens, p, 0, pe)
                        push(_ds_parts, _ds_sp.expr)
                        push(_ds_flags, true)
                        p = _ds_sp.pos
                    else
                        let _ds_k = parse_expr(tokens, p, 0, pe)
                        p = expect(tokens, _ds_k.pos, ":", pe)
                        let _ds_v = parse_expr(tokens, p, 0, pe)
                        push(_ds_parts, Expr("pair", "", 0, [_ds_k.expr, _ds_v.expr], [], ln))
                        push(_ds_flags, false)
                        p = _ds_v.pos
                p = expect(tokens, p, "\}", pe)
                let _ds_segs = []
                let _ds_grp = []
                let _ds_j = 0
                while _ds_j < len(_ds_parts)
                    if _ds_flags[_ds_j]
                        if len(_ds_grp) > 0
                            push(_ds_segs, Expr("dict", "", 0, _ds_grp, [], ln))
                            _ds_grp = []
                        push(_ds_segs, _ds_parts[_ds_j])
                    else
                        push(_ds_grp, _ds_parts[_ds_j])
                    _ds_j = _ds_j + 1
                if len(_ds_grp) > 0
                    push(_ds_segs, Expr("dict", "", 0, _ds_grp, [], ln))
                let _ds_result = _ds_segs[0]
                let _ds_k2 = 1
                while _ds_k2 < len(_ds_segs)
                    _ds_result = Expr("call", "dict_merge", 0, [_ds_result, _ds_segs[_ds_k2]], [], ln)
                    _ds_k2 = _ds_k2 + 1
                ParseResult(_ds_result, p)
            else
                let key0 = parse_expr(tokens, p, 0, pe)
                p = key0.pos
                if tv(tokens, p) != ":"
                    // Not a dict (no ':' after the first expr): SET literal {a, b, c} or SET
                    // comprehension {EXPR for V in IT (if C)?}. Both desugar (parse-time, no new
                    // IR) to set_from_list(<list>), reusing the list-comprehension machinery.
                    if tk(tokens, p) == "KW" and tv(tokens, p) == "for"
                        let scvars = []
                        let sciters = []
                        let scfilters = []
                        let scdestr = []
                        while tk(tokens, p) == "KW" and tv(tokens, p) == "for"
                            p = p + 1
                            let _scd_vars = []
                            let scvar = ""
                            if tk(tokens, p) == "DELIM" and tv(tokens, p) == "("
                                p = p + 1
                                while not (tk(tokens, p) == "DELIM" and tv(tokens, p) == ")") and tk(tokens, p) != "EOF"
                                    if tk(tokens, p) == "IDENT"
                                        push(_scd_vars, tv(tokens, p))
                                        p = p + 1
                                    if tv(tokens, p) == ","
                                        p = p + 1
                                p = p + 1
                                scvar = "__scomp_tup_" + str(ln)
                            else
                                scvar = tv(tokens, p)
                                p = p + 1
                            p = expect(tokens, p, "in", pe)
                            let siter_r = parse_expr(tokens, p, 0, pe)
                            p = siter_r.pos
                            let _scd_iter = siter_r.expr
                            if len(_scd_vars) > 0
                                _scd_iter = Expr("call", "__destr_iter", 0, [siter_r.expr], [], ln)
                            let smyfilters = []
                            while tk(tokens, p) == "KW" and tv(tokens, p) == "if"
                                p = p + 1
                                let scond_r = parse_expr(tokens, p, 0, pe)
                                push(smyfilters, scond_r.expr)
                                p = scond_r.pos
                            push(scvars, scvar)
                            push(sciters, _scd_iter)
                            push(scfilters, smyfilters)
                            push(scdestr, _scd_vars)
                        p = expect(tokens, p, "\}", pe)
                        let snclauses = len(scvars)
                        let sresult = null_expr()
                        let sidx = snclauses - 1
                        while sidx >= 0
                            let scv = scvars[sidx]
                            let ssrc = sciters[sidx]
                            let _scd_body = key0.expr
                            if len(scdestr[sidx]) > 0
                                let _scdi = 0
                                while _scdi < len(scdestr[sidx])
                                    let _scd_repl = Expr("index", "", 0, [Expr("ident", scv, 0, [], [], ln), Expr("int", "", _scdi, [], [], ln)], [], ln)
                                    _scd_body = _comp_subst(_scd_body, scdestr[sidx][_scdi], _scd_repl)
                                    _scdi = _scdi + 1
                            for sfcond in scfilters[sidx]
                                let _sfc = sfcond
                                if len(scdestr[sidx]) > 0
                                    let _sfci = 0
                                    while _sfci < len(scdestr[sidx])
                                        let _sfc_repl = Expr("index", "", 0, [Expr("ident", scv, 0, [], [], ln), Expr("int", "", _sfci, [], [], ln)], [], ln)
                                        _sfc = _comp_subst(_sfc, scdestr[sidx][_sfci], _sfc_repl)
                                        _sfci = _sfci + 1
                                ssrc = Expr("call", "filter", 0, [ssrc, Expr("lambda", "", 0, [_sfc], [Expr("ident", scv, 0, [], [], ln)], ln)], [], ln)
                            if sidx == snclauses - 1
                                sresult = Expr("call", "map", 0, [ssrc, Expr("lambda", "", 0, [_scd_body], [Expr("ident", scv, 0, [], [], ln)], ln)], [], ln)
                            else
                                let smapped = Expr("call", "map", 0, [ssrc, Expr("lambda", "", 0, [sresult], [Expr("ident", scv, 0, [], [], ln)], ln)], [], ln)
                                sresult = Expr("call", "flatten", 0, [smapped], [], ln)
                            sidx = sidx - 1
                        return ParseResult(Expr("call", "set_from_list", 0, [sresult], [], ln), p)
                    else
                        let _set_elems = [key0.expr]
                        while tv(tokens, p) != "\}" and tk(tokens, p) != "EOF"
                            p = expect(tokens, p, ",", pe)
                            if tv(tokens, p) == "\}" or tk(tokens, p) == "EOF"
                                break
                            let _se_r = parse_expr(tokens, p, 0, pe)
                            push(_set_elems, _se_r.expr)
                            if _se_r.pos <= p
                                break
                            p = _se_r.pos
                        p = expect(tokens, p, "\}", pe)
                        return ParseResult(Expr("call", "set_from_list", 0, [Expr("list", "", 0, _set_elems, [], ln)], [], ln), p)
                p = expect(tokens, p, ":", pe)
                let val0 = parse_expr(tokens, p, 0, pe)
                p = skip_nl(tokens, val0.pos)
                if tk(tokens, p) == "KW" and tv(tokens, p) == "for"
                    let cvars = []
                    let citers = []
                    let cfilters = []
                    let cdestr = []
                    while tk(tokens, p) == "KW" and tv(tokens, p) == "for"
                        p = p + 1
                        let _cd_vars = []
                        let cvar = ""
                        if tk(tokens, p) == "DELIM" and tv(tokens, p) == "("
                            p = p + 1
                            while not (tk(tokens, p) == "DELIM" and tv(tokens, p) == ")") and tk(tokens, p) != "EOF"
                                if tk(tokens, p) == "IDENT"
                                    push(_cd_vars, tv(tokens, p))
                                    p = p + 1
                                if tv(tokens, p) == ","
                                    p = p + 1
                            p = p + 1
                            cvar = "__comp_tup_" + str(ln)
                        else
                            cvar = tv(tokens, p)
                            p = p + 1
                        p = expect(tokens, p, "in", pe)
                        let iter_r = parse_expr(tokens, p, 0, pe)
                        p = iter_r.pos
                        let _cd_iter = iter_r.expr
                        if len(_cd_vars) > 0
                            _cd_iter = Expr("call", "__destr_iter", 0, [iter_r.expr], [], ln)
                        let myfilters = []
                        while tk(tokens, p) == "KW" and tv(tokens, p) == "if"
                            p = p + 1
                            let cond_r = parse_expr(tokens, p, 0, pe)
                            push(myfilters, cond_r.expr)
                            p = cond_r.pos
                        push(cvars, cvar)
                        push(citers, _cd_iter)
                        push(cfilters, myfilters)
                        push(cdestr, _cd_vars)
                    p = expect(tokens, p, "\}", pe)
                    let pairexpr = Expr("list", "", 0, [key0.expr, val0.expr], [], ln)
                    let nclauses = len(cvars)
                    let result = null_expr()
                    let idx = nclauses - 1
                    while idx >= 0
                        let cv = cvars[idx]
                        let src = citers[idx]
                        let _cd_pair = pairexpr
                        if len(cdestr[idx]) > 0
                            let _cdi = 0
                            while _cdi < len(cdestr[idx])
                                let _cd_repl = Expr("index", "", 0, [Expr("ident", cv, 0, [], [], ln), Expr("int", "", _cdi, [], [], ln)], [], ln)
                                _cd_pair = _comp_subst(_cd_pair, cdestr[idx][_cdi], _cd_repl)
                                _cdi = _cdi + 1
                        for fcond in cfilters[idx]
                            let _fc = fcond
                            if len(cdestr[idx]) > 0
                                let _fci = 0
                                while _fci < len(cdestr[idx])
                                    let _fc_repl = Expr("index", "", 0, [Expr("ident", cv, 0, [], [], ln), Expr("int", "", _fci, [], [], ln)], [], ln)
                                    _fc = _comp_subst(_fc, cdestr[idx][_fci], _fc_repl)
                                    _fci = _fci + 1
                            src = Expr("call", "filter", 0, [src, Expr("lambda", "", 0, [_fc], [Expr("ident", cv, 0, [], [], ln)], ln)], [], ln)
                        if idx == nclauses - 1
                            result = Expr("call", "map", 0, [src, Expr("lambda", "", 0, [_cd_pair], [Expr("ident", cv, 0, [], [], ln)], ln)], [], ln)
                        else
                            let mapped = Expr("call", "map", 0, [src, Expr("lambda", "", 0, [result], [Expr("ident", cv, 0, [], [], ln)], ln)], [], ln)
                            result = Expr("call", "flatten", 0, [mapped], [], ln)
                        idx = idx - 1
                    ParseResult(Expr("call", "dict_from_pairs", 0, [result], [], ln), p)
                else
                    let entries = [Expr("pair", "", 0, [key0.expr, val0.expr], [], ln)]
                    let _ds2_has_sp = false
                    let _ds2_flags = [false]
                    let _ds2_parts = [Expr("pair", "", 0, [key0.expr, val0.expr], [], ln)]
                    while tv(tokens, p) != "\}" and tk(tokens, p) != "EOF"
                        p = expect(tokens, p, ",", pe)
                        p = skip_nl(tokens, p)
                        if tv(tokens, p) == "\}" or tk(tokens, p) == "EOF"
                            break
                        if tk(tokens, p) == "DOTDOT" and tk(tokens, p + 1) == "DOT"
                            _ds2_has_sp = true
                            p = p + 2
                            let _ds2_sp = parse_expr(tokens, p, 0, pe)
                            push(_ds2_parts, _ds2_sp.expr)
                            push(_ds2_flags, true)
                            push(entries, Expr("pair", "", 0, [null_expr(), null_expr()], [], ln))
                            p = _ds2_sp.pos
                        else
                            let key_r = parse_expr(tokens, p, 0, pe)
                            p = expect(tokens, key_r.pos, ":", pe)
                            let val_r = parse_expr(tokens, p, 0, pe)
                            push(entries, Expr("pair", "", 0, [key_r.expr, val_r.expr], [], ln))
                            push(_ds2_parts, Expr("pair", "", 0, [key_r.expr, val_r.expr], [], ln))
                            push(_ds2_flags, false)
                            if val_r.pos <= p
                                break
                            p = skip_nl(tokens, val_r.pos)
                    p = expect(tokens, p, "\}", pe)
                    if not _ds2_has_sp
                        ParseResult(Expr("dict", "", 0, entries, [], ln), p)
                    else
                        let _ds2_segs = []
                        let _ds2_grp = []
                        let _ds2_j = 0
                        while _ds2_j < len(_ds2_parts)
                            if _ds2_flags[_ds2_j]
                                if len(_ds2_grp) > 0
                                    push(_ds2_segs, Expr("dict", "", 0, _ds2_grp, [], ln))
                                    _ds2_grp = []
                                push(_ds2_segs, _ds2_parts[_ds2_j])
                            else
                                push(_ds2_grp, _ds2_parts[_ds2_j])
                            _ds2_j = _ds2_j + 1
                        if len(_ds2_grp) > 0
                            push(_ds2_segs, Expr("dict", "", 0, _ds2_grp, [], ln))
                        let _ds2_result = _ds2_segs[0]
                        let _ds2_k = 1
                        while _ds2_k < len(_ds2_segs)
                            _ds2_result = Expr("call", "dict_merge", 0, [_ds2_result, _ds2_segs[_ds2_k]], [], ln)
                            _ds2_k = _ds2_k + 1
                        ParseResult(_ds2_result, p)
    else if kind == "INTERP_START"
        let parts = []
        push(parts, Expr("str", val, 0, [], [], ln))
        let p = pos + 1
        let interp_expr_r = parse_expr(tokens, p, 0, pe)
        push(parts, interp_expr_r.expr)
        p = interp_expr_r.pos
        if p < len(tokens) and tk(tokens, p) == "INTERP_SPEC"
            push(parts, Expr("fmt_spec", tv(tokens, p), 0, [], [], ln))
            p = p + 1
        while p < len(tokens) and tk(tokens, p) == "INTERP_MID"
            push(parts, Expr("str", tv(tokens, p), 0, [], [], ln))
            p = p + 1
            let next_r = parse_expr(tokens, p, 0, pe)
            push(parts, next_r.expr)
            p = next_r.pos
            if p < len(tokens) and tk(tokens, p) == "INTERP_SPEC"
                push(parts, Expr("fmt_spec", tv(tokens, p), 0, [], [], ln))
                p = p + 1
        if p < len(tokens) and tk(tokens, p) == "INTERP_END"
            push(parts, Expr("str", tv(tokens, p), 0, [], [], ln))
            p = p + 1
        ParseResult(Expr("str_interp", "", 0, parts, [], ln), p)
    else if kind == "KW" and val == "try"
        let inner_r = parse_expr(tokens, pos + 1, 5, pe)
        ParseResult(Expr("try", "", 0, [inner_r.expr], [], ln), inner_r.pos)
    else if kind == "KW" and val == "unsafe"
        let unsafe_r = parse_expr(tokens, pos + 1, 5, pe)
        ParseResult(Expr("unsafe", "", 0, [unsafe_r.expr], [], ln), unsafe_r.pos)
    else if kind == "KW" and val == "if"
        parse_if_expr(tokens, pos, pe)
    else if kind == "KW" and val == "match"
        parse_match_expr(tokens, pos, pe)
    else if kind == "KW" and val == "for"
        parse_for_expr(tokens, pos, pe)
    else if kind == "KW" and (val == "send" or val == "receive" or val == "select" or val == "close" or val == "matches" or val == "monitor" or val == "recv" or val == "recv_timeout")
        ParseResult(Expr("ident", val, 0, [], [], ln), pos + 1)
    else if kind == "KW" and val == "fn"
        let fp = pos + 1
        fp = expect(tokens, fp, "(", pe)
        let fn_params = []
        while not (tk(tokens, fp) == "DELIM" and tv(tokens, fp) == ")") and tk(tokens, fp) != "EOF"
            if len(fn_params) > 0
                fp = expect(tokens, fp, ",", pe)
                if tk(tokens, fp) == "EOF"
                    break
            push(fn_params, Expr("ident", tv(tokens, fp), 0, [], [], ln))
            fp = fp + 1
        fp = expect(tokens, fp, ")", pe)
        let fn_body_r = parse_expr(tokens, fp, 0, pe)
        ParseResult(Expr("lambda", "", 0, [fn_body_r.expr], fn_params, ln), fn_body_r.pos)
    else if kind == "KW" and val == "channel"
        let ch_p = pos + 1
        if ch_p < len(tokens) and tk(tokens, ch_p) == "DELIM" and tv(tokens, ch_p) == "("
            ch_p = expect(tokens, ch_p + 1, ")", pe)
            ParseResult(Expr("call", "channel", 0, [], [], ln), ch_p)
        else
            ParseResult(Expr("ident", "channel", 0, [], [], ln), ch_p)
    else if kind == "KW" and val == "spawn"
        let sp_r = parse_expr(tokens, pos + 1, 0, pe)
        ParseResult(Expr("spawn", "", 0, [sp_r.expr], [], ln), sp_r.pos)
    else if kind == "KW" and val == "yield"
        let yd_r = parse_expr(tokens, pos + 1, 0, pe)
        ParseResult(Expr("call", "yield", 0, [yd_r.expr], [], ln), yd_r.pos)
    else if kind == "KW" and val == "trait"
        ParseResult(Expr("ident", "trait", 0, [], [], ln), pos + 1)
    else
        let erp = syntax_error(tokens, pos, "unexpected " + kind + " '" + val + "' in expression", pe)
        ParseResult(null_expr(), erp)

// MULTI-LINE LAMBDA in argument position:
//
//     http.serve(8080, routes =>
//         routes.get("/health", handler)
//         routes.get("/data", other)
//     )
//
// Returns a "lambda_blk" node when `pos` starts `p =>` or `(a, b) =>` whose body is an
// INDENTED BLOCK rather than a single expression; otherwise a ParseResult whose pos is
// unchanged, so the caller parses the argument normally. The newline after `=>` is the whole
// discriminator -- a single-expression lambda keeps its body on the same line and is untouched.
//
// The block's statements ride in `fields`, mirroring how `catch` already carries a
// multi-statement handler. They are lifted out again before any later pass runs (see
// _lift_block_lambdas), so no consumer of the AST ever sees Stmts inside an Expr.
fn _parse_block_lambda(tokens: list, pos: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let bp = pos
    let bparams = []
    if tk(tokens, bp) == "IDENT" and tk(tokens, bp + 1) == "FAT_ARROW"
        push(bparams, Expr("ident", tv(tokens, bp), 0, [], [], ln))
        bp = bp + 2
    else if tk(tokens, bp) == "DELIM" and tv(tokens, bp) == "("
        let cp = bp + 1
        while tk(tokens, cp) == "IDENT"
            push(bparams, Expr("ident", tv(tokens, cp), 0, [], [], ln))
            cp = cp + 1
            if tk(tokens, cp) == "COMMA"
                cp = cp + 1
        if not (tk(tokens, cp) == "DELIM" and tv(tokens, cp) == ")")
            return ParseResult(null_expr(), pos)
        if tk(tokens, cp + 1) != "FAT_ARROW"
            return ParseResult(null_expr(), pos)
        bp = cp + 2
    else
        return ParseResult(null_expr(), pos)
    if tk(tokens, bp) != "NEWLINE"
        return ParseResult(null_expr(), pos)
    let bp2 = skip_nl(tokens, bp)
    if tk(tokens, bp2) == "EOF"
        return ParseResult(null_expr(), pos)
    let body_col = tok_col(tokens, bp2)
    let bstmts = []
    while tk(tokens, bp2) != "EOF" and tok_col(tokens, bp2) >= body_col
        if tk(tokens, bp2) == "DELIM" and tv(tokens, bp2) == ")"
            break
        let bsr = parse_stmt(tokens, bp2, pe)
        push(bstmts, bsr.stmt)
        if bsr.pos <= bp2
            break
        bp2 = skip_nl(tokens, bsr.pos)
    if len(bstmts) == 0
        return ParseResult(null_expr(), pos)
    ParseResult(Expr("lambda_blk", "", len(bstmts), bparams, bstmts, ln), bp2)

fn parse_call_args(tokens: list, pos: int, callee: Expr, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let cargs = []
    // Terminate on a real DELIM ')' — NOT any token merely VALUED ")" (e.g. a STR
    // literal `")"` passed as an argument, which otherwise ended the arg list early
    // and orphaned the real ')' -> bogus "inconsistent indentation". Parens are DELIM.
    while not (tk(tokens, p) == "DELIM" and tv(tokens, p) == ")") and tk(tokens, p) != "EOF"
        if len(cargs) > 0
            p = expect(tokens, p, ",", pe)
            if tk(tokens, p) == "EOF"
                break
        // NAMED ARGUMENT. Two spellings are accepted because the spec and the
        // implementation drifted apart: the spec's ten founding programs write
        // `supervise(w, restart = "always")` while the implementation only ever
        // parsed `restart: "always"`. Both are unambiguous here -- NOVA has no
        // assignment-EXPRESSION, so an IDENT followed by `=` inside an argument
        // list cannot be anything but a named argument -- so rather than break
        // one side, accept both and let usage settle the canonical spelling.
        let _na_sep = tk(tokens, p + 1) == "COLON" or tk(tokens, p + 1) == "ASSIGN"
        if tk(tokens, p) == "IDENT" and p + 1 < len(tokens) and _na_sep and p + 2 < len(tokens) and tk(tokens, p + 2) != "NEWLINE" and tk(tokens, p + 2) != "EOF"
            let _na_name = tv(tokens, p)
            let _na_p = p + 2
            let _na_r = parse_expr(tokens, _na_p, 0, pe)
            push(cargs, Expr("named_arg", _na_name, 0, [_na_r.expr], [], ln))
            p = _na_r.pos
        else
            // A multi-line lambda argument must be recognised BEFORE parse_expr, whose
            // FAT_ARROW handler parses a single body EXPRESSION and therefore dies on the
            // newline -- "unexpected NEWLINE in expression", the founding programs 5/8/10.
            let _bl = _parse_block_lambda(tokens, p, pe)
            if _bl.pos > p
                push(cargs, _bl.expr)
                p = _bl.pos
            else
                let arg_r = parse_expr(tokens, p, 0, pe)
                push(cargs, arg_r.expr)
                if arg_r.pos <= p
                    break
                p = arg_r.pos
    p = expect(tokens, p, ")", pe)
    // Determine call name from callee
    match callee
        Expr(tag, value, num, children, fields, eline) =>
            if tag == "ident"
                let _cn = value
                if _cn == "strip"
                    _cn = "trim"
                if _cn == "reversed"
                    _cn = "reverse"
                if _cn == "sorted"
                    _cn = "sort"
                if _cn == "min" and len(cargs) == 1
                    _cn = "list_min"
                if _cn == "max" and len(cargs) == 1
                    _cn = "list_max"
                ParseResult(Expr("call", _cn, 0, cargs, [], ln), p)
            else if tag == "member"
                // Method call: children[0] is receiver
                let all_args = [children[0]]
                for a in cargs
                    push(all_args, a)
                ParseResult(Expr("method_call", value, 0, all_args, [], ln), p)
            else
                ParseResult(Expr("dyn_call", "", 0, [callee] + cargs, [], ln), p)

fn parse_index(tokens: list, pos: int, target: Expr, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    if tk(tokens, p) == "COLON"
        p = p + 1
        let end_r = parse_expr(tokens, p, 0, pe)
        p = expect(tokens, end_r.pos, "]", pe)
        return ParseResult(Expr("slice", "", 0, [target, Expr("int", "0", 0, [], [], ln), end_r.expr], [], ln), p)
    let idx_r = parse_expr(tokens, p, 0, pe)
    match idx_r.expr
        Expr(_ir_tag, _ir_val, _ir_n, _ir_ch, _ir_f, _ir_ln) =>
            if _ir_tag == "binop" and _ir_val == ".."
                let _ir_p2 = expect(tokens, idx_r.pos, "]", pe)
                return ParseResult(Expr("slice", "", 0, [target, _ir_ch[0], _ir_ch[1]], [], ln), _ir_p2)
    if tk(tokens, idx_r.pos) == "COLON"
        let p2 = idx_r.pos + 1
        if tk(tokens, p2) == "DELIM" and tv(tokens, p2) == "]"
            p2 = p2 + 1
            return ParseResult(Expr("slice", "", 0, [target, idx_r.expr, Expr("int", "999999999", 999999999, [], [], ln)], [], ln), p2)
        let end_r = parse_expr(tokens, p2, 0, pe)
        p2 = expect(tokens, end_r.pos, "]", pe)
        return ParseResult(Expr("slice", "", 0, [target, idx_r.expr, end_r.expr], [], ln), p2)
    p = expect(tokens, idx_r.pos, "]", pe)
    ParseResult(Expr("index", "", 0, [target, idx_r.expr], [], ln), p)

fn parse_if_expr(tokens: list, pos: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let cond_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, cond_r.pos)
    let then_r = parse_expr(tokens, p2, 0, pe)
    let p3 = skip_nl(tokens, then_r.pos)
    if tk(tokens, p3) == "KW" and tv(tokens, p3) == "else"
        let p4 = skip_nl(tokens, p3 + 1)
        let else_r = parse_expr(tokens, p4, 0, pe)
        ParseResult(Expr("if", "", 0, [cond_r.expr, then_r.expr, else_r.expr], [], ln), else_r.pos)
    else
        ParseResult(Expr("if", "", 0, [cond_r.expr, then_r.expr], [], ln), p3)

fn parse_match_expr(tokens: list, pos: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let subject_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, subject_r.pos)
    let arms = []
    let arm_col = tok_col(tokens, p2)
    while tk(tokens, p2) != "EOF"
        if len(arms) > 0 and tok_col(tokens, p2) < arm_col
            break
        let cur_kind = tk(tokens, p2)
        let _neg_start = cur_kind == "OP" and tv(tokens, p2) == "-" and p2 + 1 < len(tokens) and tk(tokens, p2 + 1) == "INT"
        if cur_kind != "IDENT" and cur_kind != "INT" and cur_kind != "STR" and cur_kind != "ATOM" and not _neg_start
            break
        let pat_r = parse_pattern(tokens, p2, pe)
        p2 = pat_r.pos
        let _or_pats = [pat_r.expr]
        while tk(tokens, p2) == "OP" and tv(tokens, p2) == "|"
            p2 = p2 + 1
            let _or_next = parse_pattern(tokens, p2, pe)
            push(_or_pats, _or_next.expr)
            p2 = _or_next.pos
        let _final_pat = pat_r.expr
        if len(_or_pats) > 1
            _final_pat = Expr("pat_or", "", 0, _or_pats, [], ln)
        p2 = skip_nl(tokens, p2)
        let guard_expr = null_expr()
        if tk(tokens, p2) == "KW" and tv(tokens, p2) == "if"
            p2 = p2 + 1
            let guard_r = parse_expr(tokens, p2, 2, pe)
            guard_expr = guard_r.expr
            p2 = skip_nl(tokens, guard_r.pos)
        p2 = expect(tokens, p2, "=>", pe)
        p2 = skip_nl(tokens, p2)
        let body_r = parse_expr(tokens, p2, 0, pe)
        push(arms, Expr("arm", "", 0, [_final_pat, body_r.expr, guard_expr], [], ln))
        p2 = skip_nl(tokens, body_r.pos)
    ParseResult(Expr("match", "", 0, [subject_r.expr] + arms, [], ln), p2)

fn parse_pattern(tokens: list, pos: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)
    // TUPLE PATTERN (p1, p2, ...). Tuples already work everywhere else -- literal,
    // index and let-destructure -- only match arms lacked them, which is what stops
    // GATE 1 FizzBuzz (match on a two-element tuple) from compiling.
    if kind == "DELIM" and val == "("
        let _tp = pos + 1
        let _tsub = []
        while not (tk(tokens, _tp) == "DELIM" and tv(tokens, _tp) == ")") and tk(tokens, _tp) != "EOF"
            if len(_tsub) > 0
                if tk(tokens, _tp) == "COMMA"
                    _tp = _tp + 1
                else
                    break
            let _tr = parse_pattern(tokens, _tp, pe)
            if _tr.pos <= _tp
                break
            push(_tsub, _tr.expr)
            _tp = _tr.pos
        if tk(tokens, _tp) == "DELIM" and tv(tokens, _tp) == ")"
            _tp = _tp + 1
        return ParseResult(Expr("pat_tuple", "", 0, _tsub, [], ln), _tp)
    if kind == "IDENT"
        if pos + 1 < len(tokens) and tv(tokens, pos + 1) == "("
            // Constructor pattern: Name(field1, field2, ...)
            let name = val
            let p = pos + 2
            let fields = []
            while not (tk(tokens, p) == "DELIM" and tv(tokens, p) == ")") and tk(tokens, p) != "EOF"
                if len(fields) > 0
                    p = expect(tokens, p, ",", pe)
                    if tk(tokens, p) == "EOF"
                        break
                // 2.1 NESTED PATTERNS. This used to read exactly ONE token per field and
                // always wrap it as a binder, so `Wrap(IntVal(n))` read `IntVal` as a
                // variable name and then met `(` where it expected `,` or `)`. Recursing
                // into parse_pattern makes every pattern form legal in a field position --
                // pat_var, pat_wild, pat_lit, pat_str, pat_tuple and pat_ctor itself -- so
                // nesting composes to any depth for free. A bare identifier still parses to
                // pat_var, so every existing flat pattern is unchanged.
                let _fp_r = parse_pattern(tokens, p, pe)
                push(fields, _fp_r.expr)
                p = _fp_r.pos
            p = expect(tokens, p, ")", pe)
            ParseResult(Expr("pat_ctor", name, 0, fields, [], ln), p)
        else if val == "_"
            ParseResult(Expr("pat_wild", "_", 0, [], [], ln), pos + 1)
        else if val == "None"
            // `None` is the nullary Option constructor: match it as a ctor (tag
            // dispatch, no payload), not a variable binding. Some/Ok/Err always carry
            // a payload so they already parse as pat_ctor via the `(` form above.
            ParseResult(Expr("pat_ctor", "None", 0, [], [], ln), pos + 1)
        else
            ParseResult(Expr("pat_var", val, 0, [], [], ln), pos + 1)
    else if kind == "INT"
        if pos + 2 < len(tokens) and tk(tokens, pos + 1) == "DOTDOT" and tk(tokens, pos + 2) == "INT"
            let _rlo = int(val)
            let _rhi_v = tv(tokens, pos + 2)
            let _rhi = int(_rhi_v)
            ParseResult(Expr("pat_range", val, _rlo, [Expr("pat_lit", _rhi_v, _rhi, [], [], ln)], [], ln), pos + 3)
        else
            ParseResult(Expr("pat_lit", val, int(val), [], [], ln), pos + 1)
    else if kind == "STR"
        ParseResult(Expr("pat_str", val, 0, [], [], ln), pos + 1)
    else if kind == "ATOM"
        ParseResult(Expr("pat_str", ":" + val, 0, [], [], ln), pos + 1)
    else if kind == "OP" and val == "-" and pos + 1 < len(tokens) and tk(tokens, pos + 1) == "INT"
        let _nv = tv(tokens, pos + 1)
        let _nn = 0 - int(_nv)
        let _ns = "-" + _nv
        if pos + 3 < len(tokens) and tk(tokens, pos + 2) == "DOTDOT"
            if tk(tokens, pos + 3) == "INT"
                let _nrhi_v = tv(tokens, pos + 3)
                let _nrhi = int(_nrhi_v)
                ParseResult(Expr("pat_range", _ns, _nn, [Expr("pat_lit", _nrhi_v, _nrhi, [], [], ln)], [], ln), pos + 4)
            else if tk(tokens, pos + 3) == "OP" and tv(tokens, pos + 3) == "-" and pos + 4 < len(tokens) and tk(tokens, pos + 4) == "INT"
                let _nrhi_v2 = tv(tokens, pos + 4)
                let _nrhi2 = 0 - int(_nrhi_v2)
                let _nrhi_s = "-" + _nrhi_v2
                ParseResult(Expr("pat_range", _ns, _nn, [Expr("pat_lit", _nrhi_s, _nrhi2, [], [], ln)], [], ln), pos + 5)
            else
                ParseResult(Expr("pat_lit", _ns, _nn, [], [], ln), pos + 2)
        else
            ParseResult(Expr("pat_lit", _ns, _nn, [], [], ln), pos + 2)
    else
        ParseResult(Expr("pat_wild", "_", 0, [], [], ln), pos)

fn parse_for_expr(tokens: list, pos: int, pe: list) -> ParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let var_name = tv(tokens, p)
    p = p + 1
    p = skip_nl(tokens, p)
    if tk(tokens, p) == "KW" and tv(tokens, p) == "in"
        p = p + 1
    let iter_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, iter_r.pos)
    let body_r = parse_expr(tokens, p2, 0, pe)
    ParseResult(Expr("for", var_name, 0, [iter_r.expr, body_r.expr], [], ln), body_r.pos)

// ── Statement Parser ─────────────────────────────────────────────────────────

fn parse_block(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let stmts = []
    let p = skip_nl(tokens, pos)
    while tk(tokens, p) != "EOF" and tk(tokens, p) != "KW"
        let sr = parse_stmt(tokens, p, pe)
        push(stmts, sr.stmt)
        p = skip_nl(tokens, sr.pos)
        // Heuristic: stop block at dedent (no explicit INDENT/DEDENT in this tokenizer)
        // For now: parse one statement per block-line
        break
    StmtParseResult(Stmt("block", "", null_expr(), stmts, [], [], [], ln), p)

fn _maybe_where(tokens: list, spr: StmtParseResult, pe: list) -> StmtParseResult
    let _wp = spr.pos
    if _wp > 0 and _wp + 1 < len(tokens) and tk(tokens, _wp) == "IDENT" and tv(tokens, _wp) == "where" and tl(tokens, _wp) == tl(tokens, _wp - 1)
        _wp = _wp + 1
        if tk(tokens, _wp) == "IDENT" and tk(tokens, _wp + 1) == "ASSIGN"
            let _wbinds = []
            while _wp < len(tokens) and tk(tokens, _wp) == "IDENT"
                let _wbname = tv(tokens, _wp)
                _wp = _wp + 1
                _wp = expect(tokens, _wp, "=", pe)
                let _wbr = parse_expr(tokens, _wp, 0, pe)
                push(_wbinds, Stmt("assign", _wbname, _wbr.expr, [], [], [], [], tl(tokens, _wp)))
                _wp = _wbr.pos
                if _wp < len(tokens) and tk(tokens, _wp) == "COMMA"
                    _wp = _wp + 1
                else
                    break
            let _wbody = [spr.stmt]
            for _wb in _wbinds
                push(_wbody, _wb)
            return StmtParseResult(Stmt("where_wrap", "", null_expr(), _wbody, [], [], [], tl(tokens, spr.pos)), _wp)
        let _wp2 = skip_nl(tokens, _wp)
        if _wp2 < len(tokens) and tl(tokens, _wp2) != tl(tokens, _wp - 1) and tk(tokens, _wp2) == "IDENT"
            let _wp3 = _wp2 + 1
            if _wp3 < len(tokens) and tk(tokens, _wp3) == "ASSIGN"
                let _wbinds2 = []
                let _wb_col = tok_col(tokens, _wp2)
                while _wp2 < len(tokens) and tk(tokens, _wp2) == "IDENT" and tok_col(tokens, _wp2) >= _wb_col
                    let _wbname2 = tv(tokens, _wp2)
                    _wp2 = _wp2 + 1
                    _wp2 = expect(tokens, _wp2, "=", pe)
                    let _wbr2 = parse_expr(tokens, _wp2, 0, pe)
                    push(_wbinds2, Stmt("assign", _wbname2, _wbr2.expr, [], [], [], [], tl(tokens, _wp2)))
                    _wp2 = _wbr2.pos
                    _wp2 = skip_nl(tokens, _wp2)
                let _wbody2 = [spr.stmt]
                for _wb2 in _wbinds2
                    push(_wbody2, _wb2)
                return StmtParseResult(Stmt("where_wrap", "", null_expr(), _wbody2, [], [], [], tl(tokens, spr.pos)), _wp2)
        spr
    else
        spr

// Loop dispatch for a LABELED loop: picks the right parser by keyword and hands it
// the label's column as the body-indent reference. Kept as its own function so only
// the matching parser runs (calling the wrong one would push spurious syntax errors).
fn _ll_parse_loop(tokens: list, pos: int, pe: list, ref_col: int, kw: string) -> StmtParseResult
    if kw == "for"
        return parse_for_stmt(tokens, pos, pe, ref_col)
    if kw == "loop"
        return parse_loop_stmt(tokens, pos, pe, ref_col)
    parse_while_stmt(tokens, pos, pe, ref_col)

fn parse_stmt(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let kind = tk(tokens, pos)
    let val = tv(tokens, pos)

    if kind == "IDENT" and pos + 2 < len(tokens) and tk(tokens, pos + 1) == "COLON" and tk(tokens, pos + 2) == "KW"
        let _ll_kw = tv(tokens, pos + 2)
        if _ll_kw == "while" or _ll_kw == "for" or _ll_kw == "loop"
            let _ll_label = val
            // Dispatch to the loop parsers DIRECTLY with the LABEL's column as the
            // body-indent reference. Going through parse_stmt(pos + 2) made them use
            // the keyword's column, which sits right of the label — so a body indented
            // past the label (the natural way to write it) was rejected as "empty body".
            let _ll_col = tok_col(tokens, pos)
            let _ll_inner = _ll_parse_loop(tokens, pos + 2, pe, _ll_col, _ll_kw)
            match _ll_inner.stmt
                Stmt(_ll_tag, _ll_name, _ll_expr, _ll_body, _ll_params, _ll_else, _ll_anns, _ll_sl) =>
                    let _ll_new_anns = [Expr("ann_with_arg", "__label", 0, [Expr("str", _ll_label, 0, [], [], ln)], [], ln)]
                    for _ll_a in _ll_anns
                        push(_ll_new_anns, _ll_a)
                    return StmtParseResult(Stmt(_ll_tag, _ll_name, _ll_expr, _ll_body, _ll_params, _ll_else, _ll_new_anns, _ll_sl), _ll_inner.pos)
    if kind == "AT"
        // Annotation: @name [( "stringarg" | IDENT )] followed by statement.
        // Both string and bare-ident args are accepted for ergonomic forms
        // like @repr(C) (no quotes) and @link("m") (string).
        let ann_name = tv(tokens, pos + 1)
        if ann_name == "derive"
            // NOVA has no @derive. Show and serialization are automatic for every struct
            // (str/print and json_stringify just work), equality (==) and hash are universal
            // structural operations, and clone is copy(). Borrowed annotations are not a NOVA
            // feature — guide the developer to the automatic way instead of silently ignoring.
            syntax_error(tokens, pos, "@derive is not a NOVA feature -- show/serialize are automatic (str, print, json_stringify work on any struct), == and hash are universal structural operations, and clone is copy(). Remove the @derive annotation.", pe)
        let ann_arg = ""
        let p = pos + 2
        if tk(tokens, p) == "DELIM" and tv(tokens, p) == "("
            p = p + 1
            if tk(tokens, p) == "STR" or tk(tokens, p) == "IDENT" or tk(tokens, p) == "INT" or tk(tokens, p) == "FLOAT"
                ann_arg = tv(tokens, p)
                p = p + 1
            p = expect(tokens, p, ")", pe)
        p = skip_nl(tokens, p)
        let inner_r = parse_stmt(tokens, p, pe)
        match inner_r.stmt
            Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
                let new_anns = []
                if ann_arg == ""
                    push(new_anns, Expr("ann", ann_name, 0, [], [], ln))
                else
                    push(new_anns, Expr("ann_with_arg", ann_name, 0, [Expr("str", ann_arg, 0, [], [], ln)], [], ln))
                for a in annotations
                    push(new_anns, a)
                StmtParseResult(Stmt(tag, name, expr, body, params, else_body, new_anns, sline), inner_r.pos)
    else if kind == "KW" and val == "fn"
        parse_fn_decl(tokens, pos, pe)
    else if kind == "KW" and val == "extern"
        parse_extern_decl(tokens, pos, pe)
    else if kind == "KW" and val == "type"
        parse_type_decl(tokens, pos, pe)
    else if kind == "KW" and val == "trait"
        parse_trait_decl(tokens, pos, pe)
    else if kind == "KW" and val == "enum"
        parse_enum_decl(tokens, pos, pe)
    else if kind == "KW" and val == "spawn"
        let spawn_col = tok_col(tokens, pos)
        let sp = pos + 1
        if tk(tokens, sp) == "KW" and tv(tokens, sp) == "fn"
            sp = sp + 1
            sp = expect(tokens, sp, "(", pe)
            let sp_params = []
            while not (tk(tokens, sp) == "DELIM" and tv(tokens, sp) == ")") and tk(tokens, sp) != "EOF"
                if len(sp_params) > 0
                    sp = expect(tokens, sp, ",", pe)
                let sp_pname = tv(tokens, sp)
                sp = sp + 1
                push(sp_params, Param(sp_pname, "", null_expr()))
            sp = expect(tokens, sp, ")", pe)
            let sp2 = skip_nl(tokens, sp)
            let sp_body = []
            while tk(tokens, sp2) != "EOF"
                if tok_col(tokens, sp2) <= spawn_col
                    break
                let sp_r = parse_stmt(tokens, sp2, pe)
                push(sp_body, sp_r.stmt)
                sp2 = skip_nl(tokens, sp_r.pos)
            StmtParseResult(Stmt("spawn", "", null_expr(), sp_body, sp_params, [], [], ln), sp2)
        else if tk(tokens, sp) == "NEWLINE" or tk(tokens, sp) == "NL"
            let sp2 = skip_nl(tokens, sp)
            if tk(tokens, sp2) != "EOF" and tok_col(tokens, sp2) > spawn_col
                let sp_body = []
                while tk(tokens, sp2) != "EOF"
                    if tok_col(tokens, sp2) <= spawn_col
                        break
                    let sp_r = parse_stmt(tokens, sp2, pe)
                    push(sp_body, sp_r.stmt)
                    sp2 = skip_nl(tokens, sp_r.pos)
                StmtParseResult(Stmt("spawn", "", null_expr(), sp_body, [], [], [], ln), sp2)
            else
                let sp_expr = parse_expr(tokens, sp2, 0, pe)
                StmtParseResult(Stmt("expr", "", Expr("spawn", "", 0, [sp_expr.expr], [], ln), [], [], [], [], ln), sp_expr.pos)
        else
            let sp_expr = parse_expr(tokens, sp, 0, pe)
            StmtParseResult(Stmt("expr", "", Expr("spawn", "", 0, [sp_expr.expr], [], ln), [], [], [], [], ln), sp_expr.pos)
    else if kind == "KW" and val == "if"
        parse_if_stmt(tokens, pos, pe)
    else if kind == "KW" and val == "unless"
        let _un_p = pos + 1
        let _un_cond = parse_expr(tokens, _un_p, 0, pe)
        let _un_neg = Expr("unary", "not", 0, [_un_cond.expr], [], ln)
        let _un_p2 = skip_nl(tokens, _un_cond.pos)
        let _un_body = []
        let _un_col = tok_col(tokens, pos)
        while tk(tokens, _un_p2) != "EOF" and tok_col(tokens, _un_p2) > _un_col
            let _un_sr = parse_stmt(tokens, _un_p2, pe)
            push(_un_body, _un_sr.stmt)
            _un_p2 = skip_nl(tokens, _un_sr.pos)
        let _un_else = []
        if tk(tokens, _un_p2) == "KW" and tv(tokens, _un_p2) == "else" and tok_col(tokens, _un_p2) == _un_col
            _un_p2 = skip_nl(tokens, _un_p2 + 1)
            while tk(tokens, _un_p2) != "EOF" and tok_col(tokens, _un_p2) > _un_col
                let _un_esr = parse_stmt(tokens, _un_p2, pe)
                push(_un_else, _un_esr.stmt)
                _un_p2 = skip_nl(tokens, _un_esr.pos)
        StmtParseResult(Stmt("if", "", _un_neg, _un_body, [], _un_else, [], ln), _un_p2)
    else if kind == "KW" and val == "while"
        parse_while_stmt(tokens, pos, pe, tok_col(tokens, pos))
    else if kind == "KW" and val == "loop"
        parse_loop_stmt(tokens, pos, pe, tok_col(tokens, pos))
    else if kind == "KW" and val == "unsafe" and tk(tokens, pos + 1) == "NEWLINE"
        // #4: `unsafe` BLOCK (a NEWLINE right after `unsafe` => indented region). The same-line
        // `unsafe <expr>` form has its operand on this line (no NEWLINE here), so it is unaffected and
        // falls through to the expression-statement path. Body gathered by column (model: `loop`);
        // inference raises ti_unsafe_depth across it so raw-memory builtins are permitted; codegen
        // lowers it transparently (same as a plain "block").
        let _us_p = skip_nl(tokens, pos + 1)
        let _us_body = []
        let _us_col = tok_col(tokens, pos)
        while tk(tokens, _us_p) != "EOF" and tok_col(tokens, _us_p) > _us_col
            let _us_sr = parse_stmt(tokens, _us_p, pe)
            push(_us_body, _us_sr.stmt)
            _us_p = skip_nl(tokens, _us_sr.pos)
        StmtParseResult(Stmt("unsafe_block", "", null_expr(), _us_body, [], [], [], ln), _us_p)
    else if kind == "KW" and val == "until"
        let _ut_p = pos + 1
        let _ut_cond = parse_expr(tokens, _ut_p, 0, pe)
        let _ut_neg = Expr("unary", "not", 0, [_ut_cond.expr], [], ln)
        let _ut_p2 = skip_nl(tokens, _ut_cond.pos)
        let _ut_body = []
        let _ut_col = tok_col(tokens, pos)
        while tk(tokens, _ut_p2) != "EOF" and tok_col(tokens, _ut_p2) > _ut_col
            let _ut_sr = parse_stmt(tokens, _ut_p2, pe)
            push(_ut_body, _ut_sr.stmt)
            _ut_p2 = skip_nl(tokens, _ut_sr.pos)
        StmtParseResult(Stmt("while", "", _ut_neg, _ut_body, [], [], [], ln), _ut_p2)
    else if kind == "KW" and val == "for"
        parse_for_stmt(tokens, pos, pe, tok_col(tokens, pos))
    else if kind == "KW" and val == "return"
        let p = pos + 1
        if tk(tokens, p) == "NEWLINE" or tk(tokens, p) == "EOF"
            StmtParseResult(Stmt("return", "", null_expr(), [], [], [], [], ln), p)
        else
            let expr_r = parse_expr(tokens, p, 0, pe)
            return _maybe_where(tokens, StmtParseResult(Stmt("return", "", expr_r.expr, [], [], [], [], ln), expr_r.pos), pe)
    else if kind == "KW" and val == "yield"
        let expr_r = parse_expr(tokens, pos + 1, 0, pe)
        StmtParseResult(Stmt("yield", "", expr_r.expr, [], [], [], [], ln), expr_r.pos)
    else if kind == "KW" and val == "defer"
        let expr_r = parse_expr(tokens, pos + 1, 0, pe)
        StmtParseResult(Stmt("defer", "", expr_r.expr, [], [], [], [], ln), expr_r.pos)
    else if kind == "KW" and val == "break"
        let _brk_label = ""
        let _brk_next = pos + 1
        if _brk_next < len(tokens) and tk(tokens, _brk_next) == "IDENT" and tv(tokens, _brk_next) != "if" and tv(tokens, _brk_next) != "else"
            _brk_label = tv(tokens, _brk_next)
            _brk_next = _brk_next + 1
        StmtParseResult(Stmt("break", _brk_label, null_expr(), [], [], [], [], ln), _brk_next)
    else if kind == "KW" and val == "continue"
        let _cnt_label = ""
        let _cnt_next = pos + 1
        if _cnt_next < len(tokens) and tk(tokens, _cnt_next) == "IDENT" and tv(tokens, _cnt_next) != "if" and tv(tokens, _cnt_next) != "else"
            _cnt_label = tv(tokens, _cnt_next)
            _cnt_next = _cnt_next + 1
        StmtParseResult(Stmt("continue", _cnt_label, null_expr(), [], [], [], [], ln), _cnt_next)
    else if kind == "KW" and val == "import"
        parse_import_stmt(tokens, pos)
    else if kind == "KW" and val == "match"
        parse_match_stmt(tokens, pos, pe)
    else if kind == "KW" and val == "receive" and not (tk(tokens, pos + 1) == "DELIM" and tv(tokens, pos + 1) == "(")
        parse_receive_stmt(tokens, pos, pe)
    else if kind == "KW" and val == "with"
        parse_with_stmt(tokens, pos, pe)
    else if kind == "KW" and val == "const"
        let cname = tv(tokens, pos + 1)
        let cp = pos + 2
        if tk(tokens, cp) == "ASSIGN"
            cp = cp + 1
        let cexpr_r = parse_expr(tokens, cp, 0, pe)
        StmtParseResult(Stmt("const", cname, cexpr_r.expr, [], [], [], [], ln), cexpr_r.pos)
    else if kind == "KW" and val == "let" and tk(tokens, pos + 1) == "DELIM" and tv(tokens, pos + 1) == "("
        let _ld_p = pos + 2
        let _ld_names = []
        while tk(tokens, _ld_p) == "IDENT" or tv(tokens, _ld_p) == "_"
            push(_ld_names, tv(tokens, _ld_p))
            _ld_p = _ld_p + 1
            if tk(tokens, _ld_p) == "COMMA"
                _ld_p = _ld_p + 1
        _ld_p = expect(tokens, _ld_p, ")", pe)
        _ld_p = expect(tokens, _ld_p, "=", pe)
        let _ld_r = parse_expr(tokens, _ld_p, 0, pe)
        StmtParseResult(Stmt("let_destruct", "", _ld_r.expr, [], _ld_names, [], [], ln), _ld_r.pos)
    else if kind == "KW" and val == "let" and tk(tokens, pos + 1) == "IDENT" and tk(tokens, pos + 2) == "COMMA"
        let _ml_p = pos + 1
        let _ml_names = []
        while tk(tokens, _ml_p) == "IDENT"
            push(_ml_names, tv(tokens, _ml_p))
            _ml_p = _ml_p + 1
            if tk(tokens, _ml_p) == "COMMA"
                _ml_p = _ml_p + 1
            else
                break
        _ml_p = expect(tokens, _ml_p, "=", pe)
        let _ml_exprs = []
        let _ml_er = parse_expr(tokens, _ml_p, 0, pe)
        push(_ml_exprs, _ml_er.expr)
        _ml_p = _ml_er.pos
        while tk(tokens, _ml_p) == "COMMA"
            _ml_p = _ml_p + 1
            _ml_er = parse_expr(tokens, _ml_p, 0, pe)
            push(_ml_exprs, _ml_er.expr)
            _ml_p = _ml_er.pos
        let _ml_list = Expr("list", "", 0, _ml_exprs, [], ln)
        StmtParseResult(Stmt("let_destruct", "", _ml_list, [], _ml_names, [], [], ln), _ml_p)
    else if kind == "KW" and val == "let"
        // L6: `let mut name = expr` marks the binding as mutable. Plain `let` = immutable.
        // `mut` is a contextual keyword (lexed as IDENT). If `let` is followed by IDENT "mut"
        // and then another IDENT (the variable name), it's a mutable binding.
        let _is_mut = 0
        if tk(tokens, pos + 1) == "IDENT" and tv(tokens, pos + 1) == "mut" and tk(tokens, pos + 2) == "IDENT"
            _is_mut = 1
        // L13: a HARD reserved keyword cannot be a variable name. Earlier branches already
        // handled `let (`-destructure and `let IDENT,`-destructure. If the token after `let`
        // is one of the hard statement/expression keywords (which have dedicated parse
        // branches and silently mis-codegen when used as a binding — e.g. `let match = ...`),
        // reject cleanly. CONTEXTUAL keywords (`matches`, `as`, `and`, `or`, `not`, ...) are
        // deliberately NOT rejected — they are legitimately usable as identifiers (e.g.
        // `let matches = []`), which real code relies on.
        let _let_off = 1
        if _is_mut == 1
            _let_off = 2
        if tk(tokens, pos + _let_off) == "KW" and _is_hard_reserved(tv(tokens, pos + _let_off))
            let _bad_kw = tv(tokens, pos + _let_off)
            let _kw_sync = syntax_error(tokens, pos + _let_off, "'" + _bad_kw + "' is a reserved keyword and cannot be used as a variable name", pe)
            return StmtParseResult(error_stmt(ln), _kw_sync)
        let name = tv(tokens, pos + _let_off)
        let p = pos + _let_off + 1
        let let_type = ""
        if tk(tokens, p) == "COLON"
            p = p + 1
            let_type = tv(tokens, p)
            p = p + 1
            // `T[]` -- a PACKED array of T. Recorded as the string "T[]" so the annotation
            // bridge below can recognise it; the empty-bracket pair is consumed here because
            // the generic capture that follows only understands `<...>`.
            if tk(tokens, p) == "DELIM" and tv(tokens, p) == "[" and tk(tokens, p + 1) == "DELIM" and tv(tokens, p + 1) == "]"
                let_type = let_type + "[]"
                p = p + 2
            if tk(tokens, p) == "OP" and tv(tokens, p) == "<"
                // capture nested generic args (mirrors the param-type capture)
                let_type = let_type + "<"
                let ldepth = 1
                p = p + 1
                while ldepth > 0 and tk(tokens, p) != "EOF" and tk(tokens, p) != "NEWLINE"
                    let ltkk = tk(tokens, p)
                    let ltvv = tv(tokens, p)
                    if ltkk == "OP" and ltvv == "<"
                        ldepth = ldepth + 1
                        let_type = let_type + "<"
                    else if ltkk == "OP" and ltvv == ">"
                        ldepth = ldepth - 1
                        let_type = let_type + ">"
                    else if ltkk == "OP" and ltvv == ">>"
                        ldepth = ldepth - 2
                        let_type = let_type + ">>"
                    else if ltkk == "COMMA"
                        let_type = let_type + ","
                    // LOCK-10: a NUMBER inside type args is a CONST GENERIC (the 3 in `Vec<3>`). This loop appended only IDENTs, so the number was silently DROPPED and `Vec<3>` became `Vec<>` — the same shape as the CLUSTER B comma-drop. Without this the const never reaches the type.
                    else if ltkk == "INT"
                        let_type = let_type + ltvv
                    else if ltkk == "IDENT"
                        let_type = let_type + ltvv
                    p = p + 1
            if tk(tokens, p) == "QUESTION"
                // `let x: T?` optional sugar -> Option<T>. Mirror the param/field handling; the let-type
                // parser previously dropped the `?`. ti_ann_to_type_g maps the "?" suffix to nt_sum(T, unit).
                let_type = let_type + "?"
                p = p + 1
        let let_params = []
        if let_type != ""
            push(let_params, Param(name, let_type, null_expr()))
        if tk(tokens, p) == "ASSIGN"
            p = p + 1
            if tk(tokens, p) == "KW" and tv(tokens, p) == "spawn" and tk(tokens, p + 1) == "KW" and tv(tokens, p + 1) == "fn"
                let spawn_col = tok_col(tokens, p)
                let sp = p + 2
                sp = expect(tokens, sp, "(", pe)
                let sp_params = []
                while not (tk(tokens, sp) == "DELIM" and tv(tokens, sp) == ")") and tk(tokens, sp) != "EOF"
                    if len(sp_params) > 0
                        sp = expect(tokens, sp, ",", pe)
                    push(sp_params, Param(tv(tokens, sp), "", null_expr()))
                    sp = sp + 1
                sp = expect(tokens, sp, ")", pe)
                let sp2 = skip_nl(tokens, sp)
                let sp_body = []
                while tk(tokens, sp2) != "EOF"
                    if tok_col(tokens, sp2) <= spawn_col
                        break
                    let sp_r = parse_stmt(tokens, sp2, pe)
                    push(sp_body, sp_r.stmt)
                    sp2 = skip_nl(tokens, sp_r.pos)
                StmtParseResult(Stmt("spawn", name, null_expr(), sp_body, sp_params, [], [], ln), sp2)
            else
                let expr_r = parse_expr(tokens, p, 0, pe)
                if tk(tokens, expr_r.pos) == "KW" and tv(tokens, expr_r.pos) == "fn"
                    _parse_trail_fn(tokens, expr_r.pos, tok_col(tokens, pos), pe, "trail_fn_let", name, expr_r.expr, ln)
                else
                    _maybe_where(tokens, _parse_else_tail(tokens, expr_r.pos, _ta_ann_build(let_type, expr_r.expr, ln), name, let_params, [], ln, pe), pe)
        else
            StmtParseResult(Stmt("assign", name, null_expr(), [], let_params, [], [], ln), p)
    else if kind == "IDENT"
        if tk(tokens, pos + 1) == "ASSIGN" and tk(tokens, pos + 2) == "KW" and tv(tokens, pos + 2) == "spawn" and tk(tokens, pos + 3) == "KW" and tv(tokens, pos + 3) == "fn"
            let sa_name = tv(tokens, pos)
            // Body must be indented past the STATEMENT start (the lhs name), not past
            // the `spawn` keyword — `spawn` sits mid-line (e.g. col 6) so using its
            // column made an indented body (col 5) fall below it and the body loop
            // exit immediately, silently dropping the body onto the main thread.
            let spawn_col = tok_col(tokens, pos)
            let sp = pos + 4
            sp = expect(tokens, sp, "(", pe)
            let sp_params = []
            while not (tk(tokens, sp) == "DELIM" and tv(tokens, sp) == ")") and tk(tokens, sp) != "EOF"
                if len(sp_params) > 0
                    sp = expect(tokens, sp, ",", pe)
                push(sp_params, Param(tv(tokens, sp), "", null_expr()))
                sp = sp + 1
            sp = expect(tokens, sp, ")", pe)
            let sp2 = skip_nl(tokens, sp)
            let sp_body = []
            while tk(tokens, sp2) != "EOF"
                if tok_col(tokens, sp2) <= spawn_col
                    break
                let sp_r = parse_stmt(tokens, sp2, pe)
                push(sp_body, sp_r.stmt)
                sp2 = skip_nl(tokens, sp_r.pos)
            StmtParseResult(Stmt("spawn", sa_name, null_expr(), sp_body, sp_params, [], [], ln), sp2)
        else
            let expr_r = parse_expr(tokens, pos, 0, pe)
            let p = expr_r.pos
            if tk(tokens, p) == "ASSIGN"
                p = p + 1
                let rhs_r = parse_expr(tokens, p, 0, pe)
                _maybe_where(tokens, _parse_else_tail(tokens, rhs_r.pos, rhs_r.expr, "", [], [expr_r.expr], ln, pe), pe)
            else if tk(tokens, p) == "COMMA"
                let _ma_lhs = [expr_r.expr]
                while tk(tokens, p) == "COMMA"
                    p = p + 1
                    let _mr = parse_expr(tokens, p, 0, pe)
                    push(_ma_lhs, _mr.expr)
                    p = _mr.pos
                p = p + 1
                let _ma_rhs = []
                let _mr2 = parse_expr(tokens, p, 0, pe)
                push(_ma_rhs, _mr2.expr)
                p = _mr2.pos
                while tk(tokens, p) == "COMMA"
                    p = p + 1
                    let _mr3 = parse_expr(tokens, p, 0, pe)
                    push(_ma_rhs, _mr3.expr)
                    p = _mr3.pos
                let _mab = []
                let _mi = 0
                while _mi < len(_ma_rhs)
                    push(_mab, Stmt("assign", "_ma" + str(ln) + "_" + str(_mi), _ma_rhs[_mi], [], [], [], [], ln))
                    _mi = _mi + 1
                _mi = 0
                while _mi < len(_ma_lhs)
                    push(_mab, Stmt("assign", "", Expr("ident", "_ma" + str(ln) + "_" + str(_mi), 0, [], [], ln), [], [], [], [_ma_lhs[_mi]], ln))
                    _mi = _mi + 1
                StmtParseResult(Stmt("multi_assign", "", null_expr(), _mab, [], [], [], ln), p)
            else if tk(tokens, p) == "OP" and (tv(tokens, p) == "+=" or tv(tokens, p) == "-=" or tv(tokens, p) == "*=" or tv(tokens, p) == "/=" or tv(tokens, p) == "%=" or tv(tokens, p) == "**=")
                let op = tv(tokens, p)
                p = p + 1
                let rhs_r = parse_expr(tokens, p, 0, pe)
                StmtParseResult(Stmt("compound_assign", op, rhs_r.expr, [], [], [], [expr_r.expr], ln), rhs_r.pos)
            else if tk(tokens, p) == "KW" and tv(tokens, p) == "fn" and _tf_is_trailing(tokens, p, tok_col(tokens, pos))
                _parse_trail_fn(tokens, p, tok_col(tokens, pos), pe, "trail_fn_expr", "", expr_r.expr, ln)
            else
                _maybe_where(tokens, _parse_else_expr_stmt(tokens, p, expr_r.expr, ln, pe), pe)
    else
        let expr_r = parse_expr(tokens, pos, 0, pe)
        if tk(tokens, expr_r.pos) == "ASSIGN"
            let dp = expr_r.pos + 1
            let rhs_r = parse_expr(tokens, dp, 0, pe)
            _maybe_where(tokens, StmtParseResult(Stmt("assign", "", rhs_r.expr, [], [], [], [expr_r.expr], ln), rhs_r.pos), pe)
        else if tk(tokens, expr_r.pos) == "KW" and tv(tokens, expr_r.pos) == "fn"
            _parse_trail_fn(tokens, expr_r.pos, tok_col(tokens, pos), pe, "trail_fn_expr", "", expr_r.expr, ln)
        else
            _maybe_where(tokens, _parse_else_expr_stmt(tokens, expr_r.pos, expr_r.expr, ln, pe), pe)

// A trailing function (`process(xs) fn(x) ...`) belongs to the statement, so its `fn`
// must sit INDENTED PAST the statement's own column. A `fn` at a column <= stmt_col is
// the next top-level DECLARATION, not a trailing lambda.
//
// This normally cannot be confused, because a statement's expression parse stops ON the
// NEWLINE — the caller sees NEWLINE, not `fn`. But the multi-line `catch` handler loop
// advances past newlines while scanning for its next handler statement, so when it exits
// it leaves the cursor sitting DIRECTLY on the following token. A bare-expression `catch`
// as a function's last statement therefore handed the next `fn` straight to the trailing-fn
// path, which swallowed the following function ("expected '(' but found 'g'").
// Returning "not a trailing fn" here lets the statement close normally and the fn-body loop
// break on the column, so the declaration parses as itself.
fn _tf_is_trailing(tokens: list, fn_pos: int, stmt_col: int) -> bool
    tok_col(tokens, fn_pos) > stmt_col

fn _parse_trail_fn(tokens: list, fn_pos: int, stmt_col: int, pe: list, ttag: string, tname: string, call_expr: Expr, sline: int) -> StmtParseResult
    let _tf_p = fn_pos + 1
    _tf_p = expect(tokens, _tf_p, "(", pe)
    let _tf_ps = []
    while not (tk(tokens, _tf_p) == "DELIM" and tv(tokens, _tf_p) == ")") and tk(tokens, _tf_p) != "EOF"
        if len(_tf_ps) > 0
            _tf_p = expect(tokens, _tf_p, ",", pe)
        push(_tf_ps, Param(tv(tokens, _tf_p), "", null_expr()))
        _tf_p = _tf_p + 1
    _tf_p = expect(tokens, _tf_p, ")", pe)
    let _tf_p2 = skip_nl(tokens, _tf_p)
    let _tf_bd = []
    while tk(tokens, _tf_p2) != "EOF" and tok_col(tokens, _tf_p2) > stmt_col
        let _tf_sr = parse_stmt(tokens, _tf_p2, pe)
        push(_tf_bd, _tf_sr.stmt)
        _tf_p2 = skip_nl(tokens, _tf_sr.pos)
    StmtParseResult(Stmt(ttag, tname, call_expr, _tf_bd, _tf_ps, [], [], sline), _tf_p2)

fn ffi_llvm_type(ann: string) -> string
    if ann == "float"
        return "double"
    if ann == "string" or ann == "str"
        return "ptr"
    if ann == "void" or ann == "unit"
        return "void"
    if ann == "i32" or ann == "int32"
        return "i32"
    // out:T params are always pointer-typed at the C ABI (the C function
    // writes through the pointer). The wrapper handles slot alloca + load-back.
    if len(ann) > 4 and ann[0:4] == "out:"
        return "ptr"
    "i64"

fn parse_extern_decl(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    if tk(tokens, p) != "KW" or tv(tokens, p) != "fn"
        p = syntax_error(tokens, p, "expected 'fn' after 'extern'", pe)
        return StmtParseResult(error_stmt(ln), p)
    p = p + 1
    let name = tv(tokens, p)
    p = p + 1
    p = expect(tokens, p, "(", pe)
    let params = []
    while not (tk(tokens, p) == "DELIM" and tv(tokens, p) == ")") and tk(tokens, p) != "EOF"
        if len(params) > 0
            p = expect(tokens, p, ",", pe)
            if tk(tokens, p) == "EOF"
                break
        let param_name = tv(tokens, p)
        p = p + 1
        let type_ann = ""
        if tk(tokens, p) == "COLON"
            p = p + 1
            type_ann = tv(tokens, p)
            p = p + 1
            // out<T>: parametric type. Encode as "out:T" — downstream FFI emit
            // and call-site IR check for this prefix to trigger pointer marshaling.
            // ('<' and '>' are lexed as OP tokens, not DELIM.)
            // LOCK-11 adds `byval<T>` alongside `out<T>`, using the SAME source form and the
            // same "<prefix>:T" internal encoding rather than inventing a second syntax:
            // `byval<Vec2>` says "pass this @repr(C) struct by value", mirroring a C
            // declaration like `double vec2_sum(Vec2 v)`. A plain @repr(C) parameter keeps
            // meaning "pass the heap data pointer", which is what lets C write through it.
            if (type_ann == "out" or type_ann == "byval") and tk(tokens, p) == "OP" and tv(tokens, p) == "<"
                let _pfx = type_ann
                p = p + 1
                let inner_t = tv(tokens, p)
                p = p + 1
                if tk(tokens, p) == "OP" and tv(tokens, p) == ">"
                    p = p + 1
                type_ann = _pfx + ":" + inner_t
        push(params, Param(param_name, type_ann, null_expr()))
    p = expect(tokens, p, ")", pe)
    let ret_ann = ""
    if tk(tokens, p) == "ARROW"
        p = p + 1
        if tk(tokens, p) == "IDENT"
            ret_ann = tv(tokens, p)
        // `-> byval<T>` mirrors the parameter form: the C function returns T BY VALUE. A plain
        // `-> T` keeps meaning "returns a POINTER to a T", which is also a real C signature
        // (`Vec2* make_vec2(void)`) and what existing code expects, so this stays opt-in for
        // exactly the reason the parameter side did.
        if ret_ann == "byval" and tk(tokens, p + 1) == "OP" and tv(tokens, p + 1) == "<"
            p = p + 2
            ret_ann = "byval:" + tv(tokens, p)
            p = p + 1
            if tk(tokens, p) == "OP" and tv(tokens, p) == ">"
                p = p + 1
        else
            while tk(tokens, p) == "IDENT" or tk(tokens, p) == "DELIM"
                p = p + 1
    let ret_expr = null_expr()
    if ret_ann != ""
        ret_expr = Expr("rettype", ret_ann, 0, [], [], ln)
    let ext_ann = []
    push(ext_ann, Expr("extern", "", 0, [], [], ln))
    StmtParseResult(Stmt("extern_fn", name, ret_expr, [], params, [], ext_ann, ln), p)

fn parse_fn_decl(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let generic_params = []
    let generic_bounds = {}
    if tk(tokens, p) == "OP" and tv(tokens, p) == "<"
        p = p + 1
        while tv(tokens, p) != ">" and tk(tokens, p) != "EOF"
            if len(generic_params) > 0
                p = expect(tokens, p, ",", pe)
                if tk(tokens, p) == "EOF"
                    break
            let gp_name = tv(tokens, p)
            push(generic_params, gp_name)
            p = p + 1
            if tk(tokens, p) == "COLON"
                p = p + 1
                generic_bounds[gp_name] = tv(tokens, p)
                p = p + 1
        if tk(tokens, p) != "EOF"
            p = p + 1
    let name = tv(tokens, p)
    p = p + 1
    let is_method = false
    if tk(tokens, p) == "DOT"
        is_method = true
        p = p + 1
        let method_name = tv(tokens, p)
        name = name + "__" + method_name
        p = p + 1
    p = expect(tokens, p, "(", pe)
    let params = []
    while not (tk(tokens, p) == "DELIM" and tv(tokens, p) == ")") and tk(tokens, p) != "EOF"
        if len(params) > 0
            p = expect(tokens, p, ",", pe)
            if tk(tokens, p) == "EOF"
                break
        let param_name = tv(tokens, p)
        p = p + 1
        let type_ann = ""
        let default_val = null_expr()
        if tk(tokens, p) == "COLON"
            p = p + 1
            type_ann = tv(tokens, p)
            p = p + 1
            if tk(tokens, p) == "OP" and tv(tokens, p) == "<"
                // Capture nested generic args into the type_ann string.
                // Handles `>>` (right-shift token) as two-level close.
                type_ann = type_ann + "<"
                let pdepth = 1
                p = p + 1
                while pdepth > 0 and tk(tokens, p) != "EOF" and tk(tokens, p) != "NEWLINE"
                    let tkk = tk(tokens, p)
                    let tvv = tv(tokens, p)
                    if tkk == "OP" and tvv == "<"
                        pdepth = pdepth + 1
                        type_ann = type_ann + "<"
                    else if tkk == "OP" and tvv == ">"
                        pdepth = pdepth - 1
                        type_ann = type_ann + ">"
                    else if tkk == "OP" and tvv == ">>"
                        pdepth = pdepth - 2
                        type_ann = type_ann + ">>"
                    else if tkk == "COMMA" and tvv == ","
                        type_ann = type_ann + ","
                    // LOCK-10: NUMBER = const-generic arg (see the note at the first capture loop).
                    else if tkk == "INT"
                        type_ann = type_ann + tvv
                    else if tkk == "IDENT"
                        type_ann = type_ann + tvv
                    p = p + 1
        // optional sugar: `name: T?` -> the param type is Option<T>.
        if tk(tokens, p) == "QUESTION"
            type_ann = type_ann + "?"
            p = p + 1
        // variadic rest param: `name: T...` -> the param is a list<T> that collects
        // the trailing call arguments (lexer yields DOTDOT then DOT for "...").
        if tk(tokens, p) == "DOTDOT" and tk(tokens, p + 1) == "DOT"
            type_ann = type_ann + "..."
            p = p + 2
        if tk(tokens, p) == "ASSIGN"
            p = p + 1
            let def_r = parse_expr(tokens, p, 0, pe)
            default_val = def_r.expr
            p = def_r.pos
        push(params, Param(param_name, type_ann, default_val))
    p = expect(tokens, p, ")", pe)
    if is_method
        let has_self = false
        if len(params) > 0
            match params[0]
                Param(pn, pt, pd) =>
                    if pn == "self"
                        has_self = true
        if not has_self
            let self_params = [Param("self", "", null_expr())]
            for ep in params
                push(self_params, ep)
            params = self_params
    // Capture return type annotation (full parametric type after ->)
    let ret_ann = ""
    if tk(tokens, p) == "ARROW"
        p = p + 1
        if tk(tokens, p) == "IDENT"
            ret_ann = tv(tokens, p)
            p = p + 1
            if tk(tokens, p) == "OP" and tv(tokens, p) == "<"
                ret_ann = ret_ann + "<"
                let rdepth = 1
                p = p + 1
                while rdepth > 0 and tk(tokens, p) != "EOF" and tk(tokens, p) != "NEWLINE"
                    let rtkk = tk(tokens, p)
                    let rtvv = tv(tokens, p)
                    if rtkk == "OP" and rtvv == "<"
                        rdepth = rdepth + 1
                        ret_ann = ret_ann + "<"
                    else if rtkk == "OP" and rtvv == ">"
                        rdepth = rdepth - 1
                        ret_ann = ret_ann + ">"
                    else if rtkk == "OP" and rtvv == ">>"
                        rdepth = rdepth - 2
                        ret_ann = ret_ann + ">>"
                    else if rtkk == "COMMA" and rtvv == ","
                        ret_ann = ret_ann + ","
                    // LOCK-10: NUMBER = const-generic arg (see the note at the first capture loop).
                    else if rtkk == "INT"
                        ret_ann = ret_ann + rtvv
                    else if rtkk == "IDENT"
                        ret_ann = ret_ann + rtvv
                    p = p + 1
            if tk(tokens, p) == "QUESTION"
                ret_ann = ret_ann + "?"
                p = p + 1
            // `-> T or E` -- the spec's spelling for a fallible return (GATE 1 program 9
            // declares `fn push(rb: RingBuffer, val: byte) -> bool or Error`). It desugars
            // to Result<T, E>, which the annotation resolver already handles, so this is
            // purely a nicer surface: the failure type stays visible at the declaration
            // without generic-bracket ceremony. Placed AFTER the generic capture and the
            // `?` suffix so `-> list<int> or Error` and `-> int? or Error` both work.
            if tk(tokens, p) == "KW" and tv(tokens, p) == "or" and tk(tokens, p + 1) == "IDENT"
                ret_ann = "Result<" + ret_ann + "," + tv(tokens, p + 1) + ">"
                p = p + 2
    // Optional clause guard: `fn f(params) when <expr>` (contextual, not a keyword).
    // Multiple same-name/arity heads with guards are fused post-parse into one fn
    // whose body is a guard if/else chain (Elixir/Erlang-style clause dispatch).
    let fn_guard = null_expr()
    if tk(tokens, p) == "IDENT" and tv(tokens, p) == "when"
        p = p + 1
        let guard_r = parse_expr(tokens, p, 0, pe)
        fn_guard = guard_r.expr
        p = guard_r.pos
    // Optional design-by-contract clauses (contextual idents, any order, repeatable):
    // `requires <expr>` (precondition) and `ensures <expr>` (postcondition, where `result`
    // names the return value). requires injects an entry assert here; ensures is carried on
    // the fn (annotations) and lowered post-parse by inject_ensures (wrapper/impl split) so
    // the postcondition is checked on EVERY return path with zero ceremony.
    let fn_requires = []
    let fn_ensures = []
    while tk(tokens, p) == "IDENT" and (tv(tokens, p) == "requires" or tv(tokens, p) == "ensures")
        let clause_kind = tv(tokens, p)
        p = p + 1
        let clause_r = parse_expr(tokens, p, 0, pe)
        if clause_kind == "requires"
            push(fn_requires, clause_r.expr)
        else
            push(fn_ensures, clause_r.expr)
        p = clause_r.pos
    let fn_memo = false
    if tk(tokens, p) == "IDENT" and tv(tokens, p) == "memo"
        fn_memo = true
        p = p + 1
    let fn_col = 1
    let fn_tok = tokens[pos]
    match fn_tok
        Token(fk, fv, fline, fcol) =>
            fn_col = fcol
    let p2 = skip_nl(tokens, p)
    let body = []
    let body_col = -1
    while tk(tokens, p2) != "EOF"
        let cur_tok = tokens[p2]
        let cur_col = -1
        match cur_tok
            Token(k, v, line, col) =>
                if col <= fn_col
                    break
                cur_col = col
        if body_col < 0
            body_col = cur_col
        else if cur_col != body_col
            p2 = syntax_error(tokens, p2, "inconsistent indentation in body of function '" + name + "' (expected column " + str(body_col) + ", got " + str(cur_col) + "); check for mixed tabs and spaces", pe)
            break
        let sr = parse_stmt(tokens, p2, pe)
        push(body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    if len(body) == 0
        syntax_error(tokens, pos, "function '" + name + "' has an empty body; function bodies must be indented past the 'fn' keyword and contain at least one statement", pe)
    // Inject preconditions as entry asserts (prepended, so the body's implicit return is
    // unaffected). Params are in scope at entry, so `requires x > 0` lowers to assert(x > 0).
    if len(fn_requires) > 0
        let req_body = []
        for rq in fn_requires
            let rq_msg = Expr("str", "precondition failed in '" + name + "'", 0, [], [], ln)
            push(req_body, Stmt("expr", "", Expr("call", "assert", 0, [rq, rq_msg], [], ln), [], [], [], [], ln))
        for bs in body
            push(req_body, bs)
        body = req_body
    let ret_expr = null_expr()
    if ret_ann != ""
        ret_expr = Expr("rettype", ret_ann, 0, [], [], ln)
    let annotations = []
    if len(generic_params) > 0
        let gen_children = []
        for g in generic_params
            push(gen_children, Expr("ident", g, 0, [], [], ln))
        push(annotations, Expr("generics", "", 0, gen_children, [], ln))
        if len(generic_bounds) > 0
            let bound_children = []
            for bk in keys(generic_bounds)
                push(bound_children, Expr("bound", bk, 0, [Expr("ident", generic_bounds[bk], 0, [], [], ln)], [], ln))
            push(annotations, Expr("generic_bounds", "", 0, bound_children, [], ln))
    // Carry the clause guard (if any) in the fn Stmt's else_body slot (unused for fns).
    let fn_else = []
    if fn_guard != null_expr()
        push(fn_else, Stmt("guard", "", fn_guard, [], [], [], [], ln))
    // Carry postcondition exprs on the fn (annotations); inject_ensures lowers them post-parse.
    if len(fn_ensures) > 0
        push(annotations, Expr("ensures", "", 0, fn_ensures, [], ln))
    if fn_memo
        push(annotations, Expr("memo", "", 0, [], [], ln))
    StmtParseResult(Stmt("fn", name, ret_expr, body, params, fn_else, annotations, ln), p2)

fn parse_type_decl(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let name = tv(tokens, p)
    p = p + 1
    // Transparent type alias:  type Name = TargetType
    // (e.g. `type Json = dict<string, any>`). The target's full parametric
    // form is captured into a string, mirroring the param/return-type capture
    // in parse_fn_decl, and resolved to its underlying NType during inference
    // (ti_ann_to_type_g) — zero runtime cost, the name is purely a synonym.
    if tk(tokens, p) == "ASSIGN"
        p = p + 1
        // `type Name = distinct Target` — a distinct newtype (UserId != int).
        let is_distinct = false
        if tk(tokens, p) == "IDENT" and tv(tokens, p) == "distinct"
            is_distinct = true
            p = p + 1
        let target = tv(tokens, p)
        p = p + 1
        if tk(tokens, p) == "OP" and tv(tokens, p) == "<"
            target = target + "<"
            let adepth = 1
            p = p + 1
            while adepth > 0 and tk(tokens, p) != "EOF" and tk(tokens, p) != "NEWLINE"
                let atkk = tk(tokens, p)
                let atvv = tv(tokens, p)
                if atkk == "OP" and atvv == "<"
                    adepth = adepth + 1
                    target = target + "<"
                else if atkk == "OP" and atvv == ">"
                    adepth = adepth - 1
                    target = target + ">"
                else if atkk == "OP" and atvv == ">>"
                    adepth = adepth - 2
                    target = target + ">>"
                else if atkk == "COMMA" and atvv == ","
                    target = target + ","
                // LOCK-10: NUMBER = const-generic arg (see the note at the first capture loop).
                else if atkk == "INT"
                    target = target + atvv
                else if atkk == "IDENT"
                    target = target + atvv
                p = p + 1
        if is_distinct
            // Desugar to a single-field struct `value: <target>`. This yields type
            // distinctness (UserId != int), construction `UserId(x)`, `.value`
            // extraction, and structural ==/print — all via the struct machinery.
            // (Zero-cost erasure to the underlying is a tracked future refinement.)
            let nt_field = Param("value", target, null_expr())
            return StmtParseResult(Stmt("type", name, null_expr(), [], [nt_field], [], [], ln), skip_nl(tokens, p))
        let alias_expr = Expr("aliastype", target, 0, [], [], ln)
        return StmtParseResult(Stmt("type_alias", name, alias_expr, [], [], [], [], ln), skip_nl(tokens, p))
    let type_generics = []
    if tk(tokens, p) == "OP" and tv(tokens, p) == "<"
        p = p + 1
        while tv(tokens, p) != ">" and tk(tokens, p) != "EOF"
            if len(type_generics) > 0
                p = expect(tokens, p, ",", pe)
                if tk(tokens, p) == "EOF"
                    break
            push(type_generics, tv(tokens, p))
            p = p + 1
        if tk(tokens, p) != "EOF"
            p = p + 1
    let impl_traits = []
    if tk(tokens, p) == "COLON"
        p = p + 1
        push(impl_traits, tv(tokens, p))
        p = p + 1
        while tv(tokens, p) == ","
            p = p + 1
            push(impl_traits, tv(tokens, p))
            p = p + 1
    let p2 = skip_nl(tokens, p)
    let fields = []
    let redact_idx = []          // LOCK-7 @redact: indices of secret fields
    let redact_pending = 0
    while tk(tokens, p2) != "EOF"
        let cur_tok = tokens[p2]
        match cur_tok
            Token(k, v, line, col) =>
                if col <= 1 and k != "IDENT"
                    break
                if col <= 1 and k == "IDENT"
                    if p2 + 1 < len(tokens) and tk(tokens, p2 + 1) == "COLON"
                        let fname = tv(tokens, p2)
                        p2 = p2 + 2
                        let ftype = tv(tokens, p2)
                        p2 = p2 + 1
                        if tk(tokens, p2) == "OP" and tv(tokens, p2) == "<"
                            ftype = ftype + "<"
                            let fdepth = 1
                            p2 = p2 + 1
                            while fdepth > 0 and tk(tokens, p2) != "EOF" and tk(tokens, p2) != "NEWLINE"
                                let ftkk = tk(tokens, p2)
                                let ftvv = tv(tokens, p2)
                                if ftkk == "OP" and ftvv == "<"
                                    fdepth = fdepth + 1
                                    ftype = ftype + "<"
                                else if ftkk == "OP" and ftvv == ">"
                                    fdepth = fdepth - 1
                                    ftype = ftype + ">"
                                else if ftkk == "OP" and ftvv == ">>"
                                    fdepth = fdepth - 2
                                    ftype = ftype + ">>"
                                else if ftkk == "COMMA"
                                    ftype = ftype + ","
                                // LOCK-10: NUMBER = const-generic arg (see the note at the first capture loop).
                                else if ftkk == "INT"
                                    ftype = ftype + ftvv
                                else if ftkk == "IDENT"
                                    ftype = ftype + ftvv
                                p2 = p2 + 1
                        if tk(tokens, p2) == "QUESTION"
                            // `T?` optional sugar in a struct field -> Option<T>. Mirror the param-type
                            // handling; the field parser previously dropped the `?` -> spurious 'missing
                            // closing )'. ti_ann_to_type_g maps the "?" suffix to nt_sum(T, unit).
                            ftype = ftype + "?"
                            p2 = p2 + 1
                        if redact_pending == 1
                            push(redact_idx, len(fields))
                            redact_pending = 0
                        push(fields, Param(fname, ftype, null_expr()))
                        p2 = skip_nl(tokens, p2)
                    else
                        break
                else if k == "AT" and p2 + 1 < len(tokens) and tv(tokens, p2 + 1) == "redact"
                    // LOCK-7 @redact: the NEXT field is a secret. Only a FLAG is set -- `fields`
                    // must stay a clean list of real Params, because the TYPE CHECKER reads
                    // Stmt.params directly for constructor arity, so a marker Param would
                    // silently add a phantom constructor argument.
                    redact_pending = 1
                    p2 = p2 + 2
                    p2 = skip_nl(tokens, p2)
                else if k == "IDENT" or (k == "KW" and p2 + 1 < len(tokens) and tk(tokens, p2 + 1) == "COLON")
                    // A field name may be a KEYWORD (e.g. `type`, `value`) when followed by `:`
                    // — without this, an indented keyword-named field silently TRUNCATED the
                    // struct at that field (the inferer then saw a short constructor type; the
                    // bug was masked at runtime because construction/matching are positional).
                    let fname = tv(tokens, p2)
                    p2 = p2 + 1
                    if tk(tokens, p2) == "COLON"
                        p2 = p2 + 1
                        let ftype = tv(tokens, p2)
                        p2 = p2 + 1
                        if tk(tokens, p2) == "OP" and tv(tokens, p2) == "<"
                            ftype = ftype + "<"
                            let fdepth = 1
                            p2 = p2 + 1
                            while fdepth > 0 and tk(tokens, p2) != "EOF" and tk(tokens, p2) != "NEWLINE"
                                let ftkk = tk(tokens, p2)
                                let ftvv = tv(tokens, p2)
                                if ftkk == "OP" and ftvv == "<"
                                    fdepth = fdepth + 1
                                    ftype = ftype + "<"
                                else if ftkk == "OP" and ftvv == ">"
                                    fdepth = fdepth - 1
                                    ftype = ftype + ">"
                                else if ftkk == "OP" and ftvv == ">>"
                                    fdepth = fdepth - 2
                                    ftype = ftype + ">>"
                                else if ftkk == "COMMA"
                                    ftype = ftype + ","
                                // LOCK-10: NUMBER = const-generic arg (see the note at the first capture loop).
                                else if ftkk == "INT"
                                    ftype = ftype + ftvv
                                else if ftkk == "IDENT"
                                    ftype = ftype + ftvv
                                p2 = p2 + 1
                        if tk(tokens, p2) == "QUESTION"
                            // `T?` optional sugar in a struct field -> Option<T>. Mirror the param-type
                            // handling; the field parser previously dropped the `?` -> spurious 'missing
                            // closing )'. ti_ann_to_type_g maps the "?" suffix to nt_sum(T, unit).
                            ftype = ftype + "?"
                            p2 = p2 + 1
                        if redact_pending == 1
                            push(redact_idx, len(fields))
                            redact_pending = 0
                        push(fields, Param(fname, ftype, null_expr()))
                    p2 = skip_nl(tokens, p2)
                else
                    break
    let type_annotations = []
    if len(type_generics) > 0
        let tg_children = []
        for g in type_generics
            push(tg_children, Expr("ident", g, 0, [], [], ln))
        push(type_annotations, Expr("generics", "", 0, tg_children, [], ln))
    for it in impl_traits
        push(type_annotations, Expr("impl_trait", it, 0, [], [], ln))
    for ri in redact_idx
        push(type_annotations, Expr("redact", str(ri), 0, [], [], ln))
    StmtParseResult(Stmt("type", name, null_expr(), [], fields, [], type_annotations, ln), p2)

fn parse_trait_decl(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let name = tv(tokens, p)
    p = p + 1
    let p2 = skip_nl(tokens, p)
    let trait_col = 1
    let trait_tok = tokens[pos]
    match trait_tok
        Token(tk2, tv2, tl2, tc2) =>
            trait_col = tc2
    let methods = []
    while tk(tokens, p2) != "EOF"
        if tk(tokens, p2) == "NEWLINE"
            p2 = p2 + 1
            continue
        let cur_tok = tokens[p2]
        let cur_col = 0
        match cur_tok
            Token(k, v, line, col) =>
                cur_col = col
        if cur_col <= trait_col
            break
        if tk(tokens, p2) == "KW" and tv(tokens, p2) == "fn"
            let mln = tl(tokens, p2)
            p2 = p2 + 1
            let mname = tv(tokens, p2)
            p2 = p2 + 1
            let mparams = []
            if tk(tokens, p2) == "DELIM" and tv(tokens, p2) == "("
                p2 = p2 + 1
                while not (tk(tokens, p2) == "DELIM" and tv(tokens, p2) == ")") and tk(tokens, p2) != "EOF"
                    if len(mparams) > 0
                        if tv(tokens, p2) == ","
                            p2 = p2 + 1
                    let mpn = tv(tokens, p2)
                    p2 = p2 + 1
                    let mpt = ""
                    if tk(tokens, p2) == "COLON"
                        p2 = p2 + 1
                        mpt = tv(tokens, p2)
                        p2 = p2 + 1
                    push(mparams, Param(mpn, mpt, null_expr()))
                if tv(tokens, p2) == ")"
                    p2 = p2 + 1
            let mret = ""
            if tk(tokens, p2) == "ARROW"
                p2 = p2 + 1
                mret = tv(tokens, p2)
                p2 = p2 + 1
            let p3 = skip_nl(tokens, p2)
            let mbody = []
            if tk(tokens, p3) != "EOF"
                let bt = tokens[p3]
                let btc = 0
                match bt
                    Token(btk, btv, btl, btcol) =>
                        btc = btcol
                if btc > cur_col
                    while tk(tokens, p3) != "EOF"
                        if tk(tokens, p3) == "NEWLINE"
                            p3 = p3 + 1
                            continue
                        let bt2 = tokens[p3]
                        let btc2 = 0
                        match bt2
                            Token(b2k, b2v, b2l, b2c) =>
                                btc2 = b2c
                        if btc2 <= cur_col
                            break
                        let sr = parse_stmt(tokens, p3, pe)
                        push(mbody, sr.stmt)
                        p3 = skip_nl(tokens, sr.pos)
                    p2 = p3
            if len(mbody) > 0
                push(methods, Stmt("fn_default", mname, Expr("rettype", mret, 0, [], [], mln), mbody, mparams, [], [], mln))
            else
                push(methods, Stmt("fn_sig", mname, Expr("rettype", mret, 0, [], [], mln), [], mparams, [], [], mln))
        else
            p2 = p2 + 1
    StmtParseResult(Stmt("trait", name, null_expr(), methods, [], [], [], ln), p2)

fn parse_enum_decl(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let enum_name = tv(tokens, p)
    p = p + 1
    let p2 = skip_nl(tokens, p)
    let variant_stmts = []
    while tk(tokens, p2) != "EOF"
        let cur_tok = tokens[p2]
        match cur_tok
            Token(k, v, line, col) =>
                if col <= 1 and k != "IDENT"
                    break
                if k == "IDENT"
                    let vname = tv(tokens, p2)
                    p2 = p2 + 1
                    let vfields = []
                    if p2 < len(tokens) and tk(tokens, p2) == "DELIM" and tv(tokens, p2) == "("
                        p2 = p2 + 1
                        while not (tk(tokens, p2) == "DELIM" and tv(tokens, p2) == ")") and tk(tokens, p2) != "EOF"
                            if len(vfields) > 0
                                p2 = expect(tokens, p2, ",", pe)
                                if tk(tokens, p2) == "EOF"
                                    break
                            let fname = tv(tokens, p2)
                            p2 = p2 + 1
                            let ftype = ""
                            if tk(tokens, p2) == "COLON"
                                p2 = p2 + 1
                                ftype = tv(tokens, p2)
                                p2 = p2 + 1
                            else
                                ftype = "any"
                            push(vfields, Param(fname, ftype, null_expr()))
                        p2 = expect(tokens, p2, ")", pe)
                    push(variant_stmts, Stmt("type", vname, null_expr(), [], vfields, [], [], ln))
                    p2 = skip_nl(tokens, p2)
                else
                    break
    StmtParseResult(Stmt("enum", enum_name, null_expr(), variant_stmts, [], [], [], ln), p2)

// `EXPR else FALLBACK` -- NOVA's one-word error handling, on the RHS of an assignment.
// `let x = f() else d` and `x = f() else d` both land here (a `let` parses to the same
// "assign" statement). Two forms:
//
//   value  : `port = parse_int(env("PORT")) else 8080`
//              -> port = unwrap_or(parse_int(...), 8080)
//   escape : `user = parse_json(j) else return Error("bad json")`
//              -> bind once, return on Err, otherwise unwrap
//
// The escape form is real control flow and so cannot be an expression; it lowers to a
// TRANSPARENT block (see ti_infer_stmt) that binds the subject to a temp first. Both
// forms evaluate the subject EXACTLY ONCE. That is why neither reuses the `??` shape
// is_some(x) ? unwrap(x) : d -- that mentions x twice, so `read_file(p) else d` would
// read the file twice.
//
// Disambiguation against `if c then x = a else y = b`, whose `else` also follows a
// complete assignment RHS: it is told apart by what comes AFTER the fallback expression.
// An ASSIGN there means the `else` opened another assignment and therefore belongs to the
// `if`, so the fallback is abandoned and the tokens are handed back untouched.
// `EXPR else FALLBACK` as a bare EXPRESSION STATEMENT, e.g. the last line of a function:
//     fn push(rb: RingBuffer, val: byte) -> bool or Error
//         buffer_push(rb._handle, val) else Error("buffer full")
// The assignment form lives in _parse_else_tail; this is the same operator where the result
// is the statement's own value rather than something being bound. Both founding programs 9
// and 10 use it, and it is the natural spelling once a function's last expression IS its
// return value.
//
// The escape form (`else return X`) lowers to a transparent block for the same reason the
// assignment form does: it is control flow, so it cannot be an expression.
// Is there a top-level (paren/bracket depth 0) `else` between `pos` and the end of the line?
fn _scan_line_else(tokens: list, pos: int) -> bool
    let q = pos
    let depth = 0
    while tk(tokens, q) != "NEWLINE" and tk(tokens, q) != "EOF"
        let kq = tk(tokens, q)
        let vq = tv(tokens, q)
        if kq == "DELIM" and (vq == "(" or vq == "[")
            depth = depth + 1
        else if kq == "DELIM" and (vq == ")" or vq == "]")
            depth = depth - 1
        else if depth == 0 and kq == "KW" and vq == "else"
            return true
        q = q + 1
    false

fn _parse_else_expr_stmt(tokens: list, rpos: int, e: Expr, ln: int, pe: list) -> StmtParseResult
    if not (tk(tokens, rpos) == "KW" and tv(tokens, rpos) == "else")
        return StmtParseResult(Stmt("expr", "", e, [], [], [], [], ln), rpos)
    if tk(tokens, rpos + 1) == "KW" and tv(tokens, rpos + 1) == "return"
        let _er = parse_expr(tokens, rpos + 2, 0, pe)
        let _etmp = "__elx" + str(ln)
        let _eref = Expr("ident", _etmp, 0, [], [], ln)
        let _ebind = Stmt("assign", _etmp, e, [], [], [], [], ln)
        let _eret = Stmt("return", "", _er.expr, [], [], [], [], ln)
        let _eguard = Stmt("if", "", Expr("call", "is_err", 0, [_eref], [], ln), [_eret], [], [], [], ln)
        let _efin = Stmt("expr", "", Expr("call", "unwrap", 0, [_eref], [], ln), [], [], [], [], ln)
        return StmtParseResult(Stmt("block", "transparent", null_expr(), [_ebind, _eguard, _efin], [], [], [], ln), _er.pos)
    let _fb = parse_expr(tokens, rpos + 1, 0, pe)
    // Same disambiguation as the assignment form: an ASSIGN after the fallback means this
    // `else` opened another assignment and therefore belongs to an enclosing `if ... then`.
    if tk(tokens, _fb.pos) == "ASSIGN"
        return StmtParseResult(Stmt("expr", "", e, [], [], [], [], ln), rpos)
    StmtParseResult(Stmt("expr", "", Expr("call", "unwrap_or", 0, [e, _fb.expr], [], ln), [], [], [], [], ln), _fb.pos)

fn _parse_else_tail(tokens: list, rpos: int, rhs: Expr, aname: string, aparams: list, atargets: list, ln: int, pe: list) -> StmtParseResult
    if not (tk(tokens, rpos) == "KW" and tv(tokens, rpos) == "else")
        return StmtParseResult(Stmt("assign", aname, rhs, [], aparams, [], atargets, ln), rpos)
    if tk(tokens, rpos + 1) == "KW" and tv(tokens, rpos + 1) == "return"
        let _er = parse_expr(tokens, rpos + 2, 0, pe)
        let _etmp = "__els" + str(ln)
        let _eref = Expr("ident", _etmp, 0, [], [], ln)
        let _ebind = Stmt("assign", _etmp, rhs, [], [], [], [], ln)
        let _eret = Stmt("return", "", _er.expr, [], [], [], [], ln)
        let _eguard = Stmt("if", "", Expr("call", "is_err", 0, [_eref], [], ln), [_eret], [], [], [], ln)
        let _efin = Stmt("assign", aname, Expr("call", "unwrap", 0, [_eref], [], ln), [], aparams, [], atargets, ln)
        return StmtParseResult(Stmt("block", "transparent", null_expr(), [_ebind, _eguard, _efin], [], [], [], ln), _er.pos)
    let _fb = parse_expr(tokens, rpos + 1, 0, pe)
    if tk(tokens, _fb.pos) == "ASSIGN"
        return StmtParseResult(Stmt("assign", aname, rhs, [], aparams, [], atargets, ln), rpos)
    StmtParseResult(Stmt("assign", aname, Expr("call", "unwrap_or", 0, [rhs, _fb.expr], [], ln), [], aparams, [], atargets, ln), _fb.pos)

fn parse_if_chain(tokens: list, pos: int, base_col: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    if tk(tokens, p) == "KW" and tv(tokens, p) == "let"
        p = p + 1
        let _il_pat = parse_pattern(tokens, p, pe)
        p = _il_pat.pos
        p = expect(tokens, p, "=", pe)
        let _il_expr = parse_expr(tokens, p, 0, pe)
        let p2 = skip_nl(tokens, _il_expr.pos)
        let _il_then = []
        while tk(tokens, p2) != "EOF"
            if tok_col(tokens, p2) <= base_col
                break
            let sr = parse_stmt(tokens, p2, pe)
            push(_il_then, sr.stmt)
            p2 = skip_nl(tokens, sr.pos)
        let _il_else = []
        if tk(tokens, p2) == "KW" and tv(tokens, p2) == "else" and tok_col(tokens, p2) == base_col
            p2 = p2 + 1
            if tk(tokens, p2) == "KW" and tv(tokens, p2) == "if"
                let nested_r = parse_if_chain(tokens, p2, base_col, pe)
                push(_il_else, nested_r.stmt)
                p2 = nested_r.pos
            else
                p2 = skip_nl(tokens, p2)
                while tk(tokens, p2) != "EOF"
                    if tok_col(tokens, p2) <= base_col
                        break
                    let sr = parse_stmt(tokens, p2, pe)
                    push(_il_else, sr.stmt)
                    p2 = skip_nl(tokens, sr.pos)
        let _il_match_arm = Stmt("arm", "", _il_pat.expr, _il_then, [], [], [null_expr()], ln)
        let _il_wild_arm = Stmt("arm", "", Expr("pat_wild", "_", 0, [], [], ln), _il_else, [], [], [null_expr()], ln)
        return StmtParseResult(Stmt("match", "", _il_expr.expr, [_il_match_arm, _il_wild_arm], [], [], [], ln), p2)
    let cond_r = parse_expr(tokens, p, 0, pe)
    // One-line sugar: `if <cond> then <stmt>` (optional `else <stmt>`), all on one line.
    // `then` is not a keyword — it lexes as a bare IDENT sitting immediately after the
    // condition (SAME line: a newline would put an NL token here instead, so the block
    // form below is unaffected). Only an exact `then` IDENT triggers this branch.
    // Inline if-EXPRESSION in statement position: `if a > b a else b`, the form GATE 1
    // program 3 uses for max(). It already worked after `=` and after `return` (both are
    // expression contexts); a statement STARTING with `if` was always parsed as an if
    // STATEMENT, so the `a else b` tail produced "unexpected KW 'else' in expression".
    // Detect it by speculation: the next token is on the SAME line (a newline would put an
    // NL token here and mean the block form), it is not the `then` sugar, and an `else`
    // follows the branch expression. Only commit if that `else` is actually there, so a
    // malformed one-liner still falls through to the existing block path and its error.
    if tk(tokens, cond_r.pos) != "NEWLINE" and tk(tokens, cond_r.pos) != "EOF" and not (tk(tokens, cond_r.pos) == "IDENT" and tv(tokens, cond_r.pos) == "then")
        let _ie_then = parse_expr(tokens, cond_r.pos, 0, pe)
        if _ie_then.pos > cond_r.pos and tk(tokens, _ie_then.pos) == "KW" and tv(tokens, _ie_then.pos) == "else"
            let _ie_else = parse_expr(tokens, _ie_then.pos + 1, 0, pe)
            let _ie_expr = Expr("if", "", 0, [cond_r.expr, _ie_then.expr, _ie_else.expr], [], ln)
            return StmtParseResult(Stmt("expr", "", _ie_expr, [], [], [], [], ln), _ie_else.pos)
    if tk(tokens, cond_r.pos) == "IDENT" and tv(tokens, cond_r.pos) == "then"
        // `EXPR else FALLBACK` is now also an expression-statement form, so a bare-expression
        // then-part would swallow this `if`'s own `else`. Detect that exact shape -- a top-level
        // `else` later on the line, and a then-part that is neither an assignment nor a
        // statement keyword -- and parse the then-part as an EXPRESSION, which stops at `else`.
        let _thp = cond_r.pos + 1
        let _th_kw = tk(tokens, _thp) == "KW"
        let _th_assign = tk(tokens, _thp) == "IDENT" and tk(tokens, _thp + 1) == "ASSIGN"
        let _th_else = _scan_line_else(tokens, _thp)
        if _th_else and not _th_kw and not _th_assign
            let _ter = parse_expr(tokens, _thp, 0, pe)
            let sthen2 = [Stmt("expr", "", _ter.expr, [], [], [], [], ln)]
            let selse2 = []
            let sp2 = _ter.pos
            if tk(tokens, sp2) == "KW" and tv(tokens, sp2) == "else"
                let esr2 = parse_stmt(tokens, sp2 + 1, pe)
                push(selse2, esr2.stmt)
                sp2 = esr2.pos
            return StmtParseResult(Stmt("if", "", cond_r.expr, sthen2, [], selse2, [], ln), sp2)
        let tsr = parse_stmt(tokens, cond_r.pos + 1, pe)
        let sthen = [tsr.stmt]
        let selse = []
        let sp = tsr.pos
        if tk(tokens, sp) == "KW" and tv(tokens, sp) == "else"
            let esr = parse_stmt(tokens, sp + 1, pe)
            push(selse, esr.stmt)
            sp = esr.pos
        return StmtParseResult(Stmt("if", "", cond_r.expr, sthen, [], selse, [], ln), sp)
    let p2 = skip_nl(tokens, cond_r.pos)
    let then_body = []
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) <= base_col
            break
        let sr = parse_stmt(tokens, p2, pe)
        push(then_body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    let else_body = []
    if tk(tokens, p2) == "KW" and tv(tokens, p2) == "else" and tok_col(tokens, p2) == base_col
        p2 = p2 + 1
        if tk(tokens, p2) == "KW" and tv(tokens, p2) == "if"
            let nested_r = parse_if_chain(tokens, p2, base_col, pe)
            push(else_body, nested_r.stmt)
            p2 = nested_r.pos
        else
            p2 = skip_nl(tokens, p2)
            while tk(tokens, p2) != "EOF"
                if tok_col(tokens, p2) <= base_col
                    break
                let sr = parse_stmt(tokens, p2, pe)
                push(else_body, sr.stmt)
                p2 = skip_nl(tokens, sr.pos)
    StmtParseResult(Stmt("if", "", cond_r.expr, then_body, [], else_body, [], ln), p2)

fn parse_if_stmt(tokens: list, pos: int, pe: list) -> StmtParseResult
    parse_if_chain(tokens, pos, tok_col(tokens, pos), pe)

// `loop` = `while true`. Split out of parse_stmt so a labeled `outer: loop` can pass
// the LABEL's column as the body-indent reference (see parse_while_stmt).
fn parse_loop_stmt(tokens: list, pos: int, pe: list, ref_col: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let _lp_p = skip_nl(tokens, pos + 1)
    let _lp_body = []
    while tk(tokens, _lp_p) != "EOF" and tok_col(tokens, _lp_p) > ref_col
        let _lp_sr = parse_stmt(tokens, _lp_p, pe)
        push(_lp_body, _lp_sr.stmt)
        _lp_p = skip_nl(tokens, _lp_sr.pos)
    StmtParseResult(Stmt("while", "", Expr("bool", "true", 1, [], [], ln), _lp_body, [], [], [], ln), _lp_p)

// `ref_col` is the column the BODY must be indented past. Normally that is the
// `while` keyword's own column, but for a labeled loop (`outer: while ...`) the
// label starts the statement and the keyword sits further right — the body is
// indented past the LABEL, so the caller passes the label's column instead.
fn parse_while_stmt(tokens: list, pos: int, pe: list, ref_col: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let kw_col = ref_col
    let p = pos + 1
    if tk(tokens, p) == "KW" and tv(tokens, p) == "let"
        p = p + 1
        let _wl_pat = parse_pattern(tokens, p, pe)
        p = _wl_pat.pos
        p = expect(tokens, p, "=", pe)
        let _wl_expr = parse_expr(tokens, p, 0, pe)
        let p2 = skip_nl(tokens, _wl_expr.pos)
        let _wl_body = []
        while tk(tokens, p2) != "EOF"
            if tok_col(tokens, p2) <= kw_col
                break
            let sr = parse_stmt(tokens, p2, pe)
            push(_wl_body, sr.stmt)
            p2 = skip_nl(tokens, sr.pos)
        let _wl_pat_arm = Stmt("arm", "", _wl_pat.expr, _wl_body, [], [], [null_expr()], ln)
        let _wl_break = Stmt("break", "", null_expr(), [], [], [], [], ln)
        let _wl_wild = Stmt("arm", "", Expr("pat_wild", "_", 0, [], [], ln), [_wl_break], [], [], [null_expr()], ln)
        let _wl_match = Stmt("match", "", _wl_expr.expr, [_wl_pat_arm, _wl_wild], [], [], [], ln)
        return StmtParseResult(Stmt("while", "", Expr("bool", "true", 1, [], [], ln), [_wl_match], [], [], [], ln), p2)
    let cond_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, cond_r.pos)
    let body = []
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) <= kw_col
            break
        let sr = parse_stmt(tokens, p2, pe)
        push(body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    if len(body) == 0
        syntax_error(tokens, pos, "while loop has an empty body; loop body must be indented past the 'while' keyword and contain at least one statement", pe)
    let _we = []
    if tk(tokens, p2) == "KW" and tv(tokens, p2) == "else" and tok_col(tokens, p2) == kw_col
        p2 = skip_nl(tokens, p2 + 1)
        while tk(tokens, p2) != "EOF" and tok_col(tokens, p2) > kw_col
            let _wes = parse_stmt(tokens, p2, pe)
            push(_we, _wes.stmt)
            p2 = skip_nl(tokens, _wes.pos)
    StmtParseResult(Stmt("while", "", cond_r.expr, body, [], _we, [], ln), p2)

// See parse_while_stmt for what `ref_col` means (labeled-loop body indentation).
fn parse_for_stmt(tokens: list, pos: int, pe: list, ref_col: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let kw_col = ref_col
    let p = pos + 1
    let var_name = ""
    let _fd_vars = []
    let _fiv_auto_enum = false
    if tk(tokens, p) == "DELIM" and tv(tokens, p) == "("
        p = p + 1
        while not (tk(tokens, p) == "DELIM" and tv(tokens, p) == ")") and tk(tokens, p) != "EOF"
            push(_fd_vars, tv(tokens, p))
            p = p + 1
            if tv(tokens, p) == ","
                p = p + 1
        p = p + 1
        var_name = "__for_tup_" + str(ln)
    else if tk(tokens, p) == "IDENT" and p + 3 < len(tokens) and tk(tokens, p + 1) == "COMMA" and tk(tokens, p + 2) == "IDENT" and tk(tokens, p + 3) == "KW" and tv(tokens, p + 3) == "in"
        push(_fd_vars, tv(tokens, p))
        push(_fd_vars, tv(tokens, p + 2))
        var_name = "__for_kv_" + str(ln)
        _fiv_auto_enum = true
        p = p + 4
    else
        var_name = tv(tokens, p)
        p = p + 1
    if not _fiv_auto_enum
        if tk(tokens, p) == "KW" and tv(tokens, p) == "in"
            p = p + 1
    let iter_r = parse_expr(tokens, p, 0, pe)
    let _for_iter_expr = iter_r.expr
    let _fg_cond = null_expr()
    let _fg_has = false
    let _fg_end = iter_r.pos
    if tk(tokens, _fg_end) == "KW" and tv(tokens, _fg_end) == "if" and tl(tokens, _fg_end) == ln
        let _fg_r = parse_expr(tokens, _fg_end + 1, 0, pe)
        _fg_cond = _fg_r.expr
        _fg_has = true
        _fg_end = _fg_r.pos
    let p2 = skip_nl(tokens, _fg_end)
    let body = []
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) <= kw_col
            break
        let sr = parse_stmt(tokens, p2, pe)
        push(body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    if len(body) == 0
        syntax_error(tokens, pos, "for loop has an empty body; loop body must be indented past the 'for' keyword and contain at least one statement", pe)
    if _fg_has
        body = [Stmt("if", "", _fg_cond, body, [], [], [], ln)]
    if len(_fd_vars) > 0
        let _fd_idx = len(_fd_vars) - 1
        while _fd_idx >= 0
            let _fd_v = _fd_vars[_fd_idx]
            let _fd_access = Expr("index", "", 0, [Expr("ident", var_name, 0, [], [], ln), Expr("int", "", _fd_idx, [], [], ln)], [], ln)
            let _fd_stmt = Stmt("assign", _fd_v, _fd_access, [], [], [], [], ln)
            let _fd_new_body = [_fd_stmt]
            for _fd_s in body
                push(_fd_new_body, _fd_s)
            body = _fd_new_body
            _fd_idx = _fd_idx - 1
    let _fe = []
    if tk(tokens, p2) == "KW" and tv(tokens, p2) == "else" and tok_col(tokens, p2) == kw_col
        p2 = skip_nl(tokens, p2 + 1)
        while tk(tokens, p2) != "EOF" and tok_col(tokens, p2) > kw_col
            let _fes = parse_stmt(tokens, p2, pe)
            push(_fe, _fes.stmt)
            p2 = skip_nl(tokens, _fes.pos)
    StmtParseResult(Stmt("for", var_name, _for_iter_expr, body, [], _fe, [], ln), p2)

fn parse_match_stmt(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let subject_r = parse_expr(tokens, p, 0, pe)
    let p2 = skip_nl(tokens, subject_r.pos)
    let arms = []
    let arm_ref_col = tok_col(tokens, p2)
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) < arm_ref_col
            break
        let pat_start = p2
        let pat_r = parse_pattern(tokens, p2, pe)
        let arm_col = tok_col(tokens, p2)
        p2 = pat_r.pos
        if p2 <= pat_start
            p2 = syntax_error(tokens, p2, "invalid match arm pattern; expected a pattern, got '" + tv(tokens, p2) + "'", pe)
            break
        let _smo_pats = [pat_r.expr]
        while tk(tokens, p2) == "OP" and tv(tokens, p2) == "|"
            p2 = p2 + 1
            let _smo_next = parse_pattern(tokens, p2, pe)
            push(_smo_pats, _smo_next.expr)
            p2 = _smo_next.pos
        if len(_smo_pats) > 1
            pat_r = ParseResult(Expr("pat_or", "", 0, _smo_pats, [], ln), p2)
        let arm_guard = null_expr()
        if tk(tokens, p2) == "KW" and tv(tokens, p2) == "if"
            p2 = p2 + 1
            let guard_r = parse_expr(tokens, p2, 2, pe)
            arm_guard = guard_r.expr
            p2 = guard_r.pos
        if tk(tokens, p2) == "FAT_ARROW"
            p2 = p2 + 1
        p2 = skip_nl(tokens, p2)
        let arm_body = []
        while tk(tokens, p2) != "EOF"
            if tok_col(tokens, p2) <= arm_col
                break
            let sr = parse_stmt(tokens, p2, pe)
            push(arm_body, sr.stmt)
            p2 = skip_nl(tokens, sr.pos)
        push(arms, Stmt("arm", "", pat_r.expr, arm_body, [], [], [arm_guard], ln))
    if len(arms) == 0
        syntax_error(tokens, pos, "match has no arms; provide at least one pattern arm", pe)
    // TUPLE PATTERNS desugar HERE, in ONE place, instead of in each of the ~10 match
    // lowering sites. A tuple arm becomes a WILDCARD arm whose GUARD compares the literal
    // elements, with variable sub-patterns turned into bindings prefixed onto the body.
    // The match is wrapped in a block that binds the subject to a temp FIRST, so the
    // subject is evaluated exactly ONCE -- referencing the subject expression inside each
    // guard would re-evaluate it and break anything with side effects.
    // The binding tag is "assign": that is what a let-binding parses to, and what ti
    // defines variables under. Emitting Stmt("let", ...) is silently IGNORED by ti, which
    // is why the first attempt failed with "unknown identifier".
    let _mt_any = false
    for _ma in arms
        match _ma
            Stmt(_mat, _man, _mapat, _mab, _map, _mae, _maann, _mal) =>
                match _mapat
                    Expr(_mpt, _mpv, _mpn, _mpc, _mpf, _mpl) =>
                        if _mpt == "pat_tuple"
                            _mt_any = true
    if not _mt_any
        return StmtParseResult(Stmt("match", "", subject_r.expr, arms, [], [], [], ln), p2)
    let _mt_name = "__mtup" + str(ln)
    let _mt_ref = Expr("ident", _mt_name, 0, [], [], ln)
    let _mt_arms = []
    for _ma2 in arms
        match _ma2
            Stmt(_mat2, _man2, _mapat2, _mab2, _map2, _mae2, _maann2, _mal2) =>
                let _newpat = _mapat2
                let _newbody = _mab2
                let _newguard = null_expr()
                if len(_maann2) > 0
                    _newguard = _maann2[0]
                match _mapat2
                    Expr(_mpt2, _mpv2, _mpn2, _mpc2, _mpf2, _mpl2) =>
                        if _mpt2 == "pat_tuple"
                            _newpat = Expr("pat_wild", "_", 0, [], [], ln)
                            let _binds = []
                            let _conds = []
                            let _tj = 0
                            for _sub in _mpc2
                                let _elem = Expr("index", "", 0, [_mt_ref, Expr("int", "", _tj, [], [], ln)], [], ln)
                                match _sub
                                    Expr(_st, _sv, _sn, _sc, _sf, _sl) =>
                                        if _st == "pat_lit"
                                            push(_conds, Expr("binop", "==", 0, [_elem, Expr("int", "", _sn, [], [], ln)], [], ln))
                                        else if _st == "pat_str"
                                            push(_conds, Expr("binop", "==", 0, [_elem, Expr("str", _sv, 0, [], [], ln)], [], ln))
                                        else if _st == "pat_var" and _sv != "_"
                                            push(_binds, Stmt("assign", _sv, _elem, [], [], [], [], ln))
                                _tj = _tj + 1
                            let _cond = null_expr()
                            for _c in _conds
                                match _cond
                                    Expr(_ct, _cv, _cn, _cc, _cf, _cl) =>
                                        if _ct == "null"
                                            _cond = _c
                                        else
                                            _cond = Expr("binop", "and", 0, [_cond, _c], [], ln)
                            match _cond
                                Expr(_ct2, _cv2, _cn2, _cc2, _cf2, _cl2) =>
                                    if _ct2 != "null"
                                        match _newguard
                                            Expr(_gt, _gv, _gn, _gc, _gf, _gl) =>
                                                if _gt == "null"
                                                    _newguard = _cond
                                                else
                                                    _newguard = Expr("binop", "and", 0, [_cond, _newguard], [], ln)
                            if len(_binds) > 0
                                let _mergedb = []
                                for _bb in _binds
                                    push(_mergedb, _bb)
                                for _ob in _mab2
                                    push(_mergedb, _ob)
                                _newbody = _mergedb
                push(_mt_arms, Stmt("arm", "", _newpat, _newbody, [], [], [_newguard], ln))
    let _mt_let = Stmt("assign", _mt_name, subject_r.expr, [], [], [], [], ln)
    let _mt_match = Stmt("match", "", _mt_ref, _mt_arms, [], [], [], ln)
    StmtParseResult(Stmt("block", "", null_expr(), [_mt_let, _mt_match], [], [], [], ln), p2)

// Erlang frontier Stage-1: selective receive. `receive <pat => body ...>` (column-aligned arms like
// match, no subject) DESUGARS to a poll loop that reuses the proven match codegen + a per-task
// save-queue (Erlang semantics: a message no arm matches is deferred, in order, for future receives):
//   __recv_begin()
//   while true:
//       match __recv_next():        # save-queue first (in order), then a blocking mailbox pull
//           <arm.pat> [if g] => __recv_commit(); <arm.body...>; break
//           _              => __recv_defer()      # stash the candidate into the save-queue
fn parse_receive_stmt(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p2 = skip_nl(tokens, pos + 1)
    let arms = []
    let arm_ref_col = tok_col(tokens, p2)
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) < arm_ref_col
            break
        let cur_kind = tk(tokens, p2)
        let _neg = cur_kind == "OP" and tv(tokens, p2) == "-" and tk(tokens, p2 + 1) == "INT"
        if cur_kind != "IDENT" and cur_kind != "INT" and cur_kind != "STR" and cur_kind != "ATOM" and not _neg
            break
        let pat_start = p2
        let pat_r = parse_pattern(tokens, p2, pe)
        let arm_col = tok_col(tokens, p2)
        p2 = pat_r.pos
        if p2 <= pat_start
            break
        let _pats = [pat_r.expr]
        while tk(tokens, p2) == "OP" and tv(tokens, p2) == "|"
            p2 = p2 + 1
            let _nx = parse_pattern(tokens, p2, pe)
            push(_pats, _nx.expr)
            p2 = _nx.pos
        let _pat = pat_r.expr
        if len(_pats) > 1
            _pat = Expr("pat_or", "", 0, _pats, [], ln)
        let arm_guard = null_expr()
        if tk(tokens, p2) == "KW" and tv(tokens, p2) == "if"
            p2 = p2 + 1
            let gr = parse_expr(tokens, p2, 2, pe)
            arm_guard = gr.expr
            p2 = gr.pos
        if tk(tokens, p2) == "FAT_ARROW"
            p2 = p2 + 1
        p2 = skip_nl(tokens, p2)
        let arm_body = []
        while tk(tokens, p2) != "EOF"
            if tok_col(tokens, p2) <= arm_col
                break
            let sr = parse_stmt(tokens, p2, pe)
            push(arm_body, sr.stmt)
            p2 = skip_nl(tokens, sr.pos)
        let _commit = Stmt("expr", "", Expr("call", "__recv_commit", 0, [], [], ln), [], [], [], [], ln)
        let _brk = Stmt("break", "", null_expr(), [], [], [], [], ln)
        let _wrapped_body = [_commit] + arm_body + [_brk]
        push(arms, Stmt("arm", "", _pat, _wrapped_body, [], [], [arm_guard], ln))
    if len(arms) == 0
        syntax_error(tokens, pos, "receive has no arms; provide at least one pattern arm", pe)
    // Stage-2: an optional trailing `after <ms>` clause (dedented from the arms, like Erlang's
    // `after Timeout -> Body`). `after 0` = drain-then-timeout (non-blocking poll). The timeout body
    // is indented past the `after` keyword.
    let has_after = false
    let timeout_expr = null_expr()
    let after_body = []
    if tk(tokens, p2) == "IDENT" and tv(tokens, p2) == "after"
        has_after = true
        let after_col = tok_col(tokens, p2)
        p2 = p2 + 1
        let te = parse_expr(tokens, p2, 0, pe)
        timeout_expr = te.expr
        p2 = te.pos
        if tk(tokens, p2) == "FAT_ARROW"
            p2 = p2 + 1
        p2 = skip_nl(tokens, p2)
        while tk(tokens, p2) != "EOF"
            if tok_col(tokens, p2) <= after_col
                break
            let asr = parse_stmt(tokens, p2, pe)
            push(after_body, asr.stmt)
            p2 = skip_nl(tokens, asr.pos)
    // append the catch-all defer arm: _ => __recv_defer()
    let _defer = Stmt("expr", "", Expr("call", "__recv_defer", 0, [], [], ln), [], [], [], [], ln)
    push(arms, Stmt("arm", "", Expr("pat_wild", "_", 0, [], [], ln), [_defer], [], [], [null_expr()], ln))
    if has_after
        // Timed desugar: bind the candidate, branch on timeout BEFORE matching (so the timeout
        // sentinel never lives in the message value-space), else match as usual.
        //   __recv_begin_timed(<ms>)
        //   while true:
        //       let __recv_m = __recv_next_timed()
        //       if __recv_timed_out(): <after_body>; break
        //       match __recv_m: <arms>
        let _letm = Stmt("assign", "__recv_m", Expr("call", "__recv_next_timed", 0, [], [], ln), [], [], [], [], ln)
        let _tbrk = Stmt("break", "", null_expr(), [], [], [], [], ln)
        let _to_body = after_body + [_tbrk]
        let _ifto = Stmt("if", "", Expr("call", "__recv_timed_out", 0, [], [], ln), _to_body, [], [], [], ln)
        let _matcht = Stmt("match", "", Expr("ident", "__recv_m", 0, [], [], ln), arms, [], [], [], ln)
        let _loopt = Stmt("while", "", Expr("bool", "true", 1, [], [], ln), [_letm, _ifto, _matcht], [], [], [], ln)
        let _begint = Stmt("expr", "", Expr("call", "__recv_begin_timed", 0, [timeout_expr], [], ln), [], [], [], [], ln)
        return StmtParseResult(Stmt("block", "", null_expr(), [_begint, _loopt], [], [], [], ln), p2)
    let _match = Stmt("match", "", Expr("call", "__recv_next", 0, [], [], ln), arms, [], [], [], ln)
    let _loop = Stmt("while", "", Expr("bool", "true", 1, [], [], ln), [_match], [], [], [], ln)
    let _begin = Stmt("expr", "", Expr("call", "__recv_begin", 0, [], [], ln), [], [], [], [], ln)
    StmtParseResult(Stmt("block", "", null_expr(), [_begin, _loop], [], [], [], ln), p2)

// Build the nested-match desugaring of a `with` chain. Each bind `pat <- expr`
// becomes `match expr { Ok(pat) => <rest>, Err(errname) => <else_body> }`; the
// innermost Ok arm runs the with body. Reuses the (now working) Result/Option
// match-on-Sum machinery — no new IR/runtime. The else body is shared by every
// Err arm (only one fires per run).
fn build_with_match(binds: list, idx: int, body: list, err_name: string, else_body: list, ln: int) -> list
    if idx >= len(binds)
        return body
    let bind = binds[idx]
    let pat_name = bind[0]
    let src_expr = bind[1]
    let inner = build_with_match(binds, idx + 1, body, err_name, else_body, ln)
    let ok_pat = Expr("pat_ctor", "Ok", 0, [Expr("pat_var", pat_name, 0, [], [], ln)], [], ln)
    let ok_arm = Stmt("arm", "", ok_pat, inner, [], [], [null_expr()], ln)
    let err_pat = Expr("pat_ctor", "Err", 0, [Expr("pat_var", err_name, 0, [], [], ln)], [], ln)
    let err_arm = Stmt("arm", "", err_pat, else_body, [], [], [null_expr()], ln)
    [Stmt("match", "", src_expr, [ok_arm, err_arm], [], [], [], ln)]

// `with pat <- expr, pat2 <- expr2` <body> `else errname` <else-body>
// Elixir-style happy-path chaining: run each fallible step; on the first Err,
// bind it to `errname` and run the else block. Desugars to nested Ok/Err match.
fn parse_with_stmt(tokens: list, pos: int, pe: list) -> StmtParseResult
    let ln = tl(tokens, pos)
    let with_col = tok_col(tokens, pos)
    let p = pos + 1
    let binds = []
    while tk(tokens, p) != "EOF" and tk(tokens, p) != "NEWLINE"
        let pat_name = tv(tokens, p)
        p = p + 1
        if tk(tokens, p) == "OP" and tv(tokens, p) == "<"
            p = p + 1
        if tk(tokens, p) == "OP" and tv(tokens, p) == "-"
            p = p + 1
        let src_r = parse_expr(tokens, p, 0, pe)
        push(binds, [pat_name, src_r.expr])
        p = src_r.pos
        if tk(tokens, p) == "COMMA"
            p = p + 1
        else
            break
    let p2 = skip_nl(tokens, p)
    let body = []
    while tk(tokens, p2) != "EOF"
        if tok_col(tokens, p2) <= with_col
            break
        let sr = parse_stmt(tokens, p2, pe)
        push(body, sr.stmt)
        p2 = skip_nl(tokens, sr.pos)
    let err_name = "_"
    let else_body = []
    if tk(tokens, p2) == "KW" and tv(tokens, p2) == "else" and tok_col(tokens, p2) == with_col
        p2 = p2 + 1
        if tk(tokens, p2) == "IDENT"
            err_name = tv(tokens, p2)
            p2 = p2 + 1
        p2 = skip_nl(tokens, p2)
        while tk(tokens, p2) != "EOF"
            if tok_col(tokens, p2) <= with_col
                break
            let sr = parse_stmt(tokens, p2, pe)
            push(else_body, sr.stmt)
            p2 = skip_nl(tokens, sr.pos)
    else
        syntax_error(tokens, p2, "with-chain requires an 'else' block (aligned with 'with') to handle the error case", pe)
    if len(binds) == 0
        syntax_error(tokens, pos, "with-chain needs at least one 'pat <- expr' binding", pe)
    let desugared = build_with_match(binds, 0, body, err_name, else_body, ln)
    StmtParseResult(desugared[0], p2)

fn parse_import_stmt(tokens: list, pos: int) -> StmtParseResult
    let ln = tl(tokens, pos)
    let p = pos + 1
    let module_name = tv(tokens, p)
    p = p + 1
    // LOCK-1 module namespacing: allow a `/`-path so the NOVA standard library can be organized by
    // category — `import std/numeric/bignum` resolves std/numeric/bignum.nova. A bare `import forge`
    // (no following `/`) is unchanged. The default alias is the LAST path component (bignum).
    while tv(tokens, p) == "/"
        p = p + 1
        module_name = module_name + "/" + tv(tokens, p)
        p = p + 1
    let alias = module_name
    let _seg_start = 0
    let _seg_i = 0
    while _seg_i < len(module_name)
        if module_name[_seg_i] == "/"
            _seg_start = _seg_i + 1
        _seg_i = _seg_i + 1
    if _seg_start > 0
        alias = slice(module_name, _seg_start, len(module_name))
    if tk(tokens, p) == "KW" and tv(tokens, p) == "as"
        p = p + 1
        alias = tv(tokens, p)
        p = p + 1
    StmtParseResult(Stmt("import", module_name, null_expr(), [], [], [], [alias], ln), p)

// ── Automatic structural rendering (Structural Value Identity, D1) ────────────
// EVERY record struct gets a compiler-synthesized <Type>__show that renders it as
// "TypeName { field: value, ... }" — zero annotation (NOVA has no @derive). It is built
// as ordinary AST and fed through the normal pipeline (type inference + lowering), so it
// reuses field access, str(), and concat — no bespoke IR. str(p)/print(p) dispatch to it
// at codegen (where the static struct type is known), and it is dead-strippable: kept only
// if a struct is actually shown. Scalar fields render via str(self.f); struct fields render
// recursively via self.f.show() (resolved statically to the field type's __show).
fn _is_valid_struct_name(s: string) -> int
    // Guards automatic derivation against a parser artifact: a struct FIELD whose name is a
    // keyword (e.g. `type: IrType`) breaks the field loop, leaving a stray top-level type decl
    // whose name is the colon token's value ":". Those phantom types must never be derived for
    // (":__show" would collide). Only derive for names that begin like a real identifier.
    if len(s) == 0
        return 0
    if is_alpha(s[0]) or s[0] == "_"
        return 1
    return 0

fn _make_show_method(tname: string, fields: list, derived: dict, redacted: dict, ln: int) -> Stmt
    let acc = Expr("str", tname + " \{", 0, [], [], ln)
    let i = 0
    let n = len(fields)
    while i < n
        match fields[i]
            Param(fname, ftype, fdef) =>
                let sep = ", "
                if i == 0
                    sep = " "
                acc = Expr("binop", "+", 0, [acc, Expr("str", sep + fname + ": ", 0, [], [], ln)], [], ln)
                let memb = Expr("member", fname, 0, [Expr("ident", "self", 0, [], [], ln)], [], ln)
                let rendered = Expr("call", "str", 0, [memb], [], ln)
                // LOCK-7 @redact: a secret field renders as a MASK. The field is never read,
                // so the value cannot reach a log line even via a partial render.
                if contains(redacted, str(i))
                    rendered = Expr("str", chr(34) + "***" + chr(34), 0, [], [], ln)
                else if ftype == "bool"
                    // bool field accesses are i64 0/1 at the IR level (bool-ness is
                    // erased on member load); index a {false,true} table by the value
                    // so it renders true/false robustly.
                    rendered = Expr("index", "", 0, [Expr("list", "", 0, [Expr("str", "false", 0, [], [], ln), Expr("str", "true", 0, [], [], ln)], [], ln), memb], [], ln)
                else if contains(derived, ftype)
                    rendered = Expr("method_call", "show", 0, [memb], [], ln)
                acc = Expr("binop", "+", 0, [acc, rendered], [], ln)
        i = i + 1
    let closing = " \}"
    if n == 0
        closing = "\}"
    acc = Expr("binop", "+", 0, [acc, Expr("str", closing, 0, [], [], ln)], [], ln)
    let ret_stmt = Stmt("return", "", acc, [], [], [], [], ln)
    // self is typed as the struct so field accesses resolve to their declared types
    // (so str(self.flag) dispatches bool->true/false, self.val float->float_to_str).
    Stmt("fn", tname + "__show", null_expr(), [ret_stmt], [Param("self", tname, null_expr())], [], [], ln)

// Automatic to_json: renders the struct as a JSON object derived from its structure.
// Field VALUES go through json_stringify (handles int/float/string-escaping/list/dict);
// nested struct fields recurse via self.f.to_json(). Keys are built with chr(34) (literal
// quote) so no string-escape ambiguity. The DB/HTTP serialize keystone — zero annotation.
fn _make_to_json_method(tname: string, fields: list, jsonset: dict, redacted: dict, ln: int) -> Stmt
    let acc = Expr("str", "\{", 0, [], [], ln)
    let i = 0
    let n = len(fields)
    while i < n
        match fields[i]
            Param(fname, ftype, fdef) =>
                let key = chr(34) + fname + chr(34) + ":"
                if i > 0
                    key = "," + key
                acc = Expr("binop", "+", 0, [acc, Expr("str", key, 0, [], [], ln)], [], ln)
                let memb = Expr("member", fname, 0, [Expr("ident", "self", 0, [], [], ln)], [], ln)
                let jval = Expr("call", "json_stringify", 0, [memb], [], ln)
                // LOCK-7 @redact: mask the VALUE, keep the KEY -- consumers still get a
                // well-formed object of the expected shape.
                if contains(redacted, str(i))
                    jval = Expr("str", chr(34) + "***" + chr(34), 0, [], [], ln)
                else if ftype == "bool"
                    // bool erases to i64 0/1 on member load; index a {false,true}
                    // table -> a valid JSON true/false token.
                    jval = Expr("index", "", 0, [Expr("list", "", 0, [Expr("str", "false", 0, [], [], ln), Expr("str", "true", 0, [], [], ln)], [], ln), memb], [], ln)
                else if ftype == "float"
                    // json_stringify is type-erased (float -> raw bits); str() of a
                    // typed-float field -> float_to_str -> a valid JSON number.
                    jval = Expr("call", "str", 0, [memb], [], ln)
                else if contains(jsonset, ftype)
                    jval = Expr("method_call", "to_json", 0, [memb], [], ln)
                else
                    let les_j = _list_struct_elem(ftype, jsonset)
                    if les_j != ""
                        // list<Struct>: "[" + join(map(self.f, fn(e) <Elem>__to_json(e)), ",") + "]"
                        let jlam_body = Expr("call", les_j + "__to_json", 0, [Expr("ident", "e", 0, [], [], ln)], [], ln)
                        let jlam = Expr("lambda", "", 0, [jlam_body], [Expr("ident", "e", 0, [], [], ln)], ln)
                        let jmap = Expr("call", "map", 0, [memb, jlam], [], ln)
                        let jjoin = Expr("call", "join", 0, [jmap, Expr("str", ",", 0, [], [], ln)], [], ln)
                        jval = Expr("binop", "+", 0, [Expr("binop", "+", 0, [Expr("str", "[", 0, [], [], ln), jjoin], [], ln), Expr("str", "]", 0, [], [], ln)], [], ln)
                acc = Expr("binop", "+", 0, [acc, jval], [], ln)
        i = i + 1
    acc = Expr("binop", "+", 0, [acc, Expr("str", "\}", 0, [], [], ln)], [], ln)
    let ret_stmt = Stmt("return", "", acc, [], [], [], [], ln)
    Stmt("fn", tname + "__to_json", null_expr(), [ret_stmt], [Param("self", tname, null_expr())], [], [], ln)

// If ftype is `list<Struct>` for a known struct, return the element struct name (else "").
// Used by from_json to deep-reconstruct a list-of-structs field via map + recursion.
fn _list_struct_elem(ftype: string, structset: dict) -> string
    let n = len(ftype)
    if n < 7
        return ""
    if ftype[0:5] == "list<" and ftype[n - 1:n] == ">"
        let inner = ftype[5:n - 1]
        if contains(structset, inner)
            return inner
    ""

// Automatic from_json: the INVERSE of _make_to_json_method — reconstructs a struct
// from a json-decoded dict (dict<string, any>) by reading each field by name and
// passing it positionally to the constructor. NOVA-way (zero annotation): completes
// bidirectional structural serialization (you already get to_json for free). Each
// primitive field flows straight through — a dict read already unboxes a float to the
// raw bits a float field stores, json ints/bools are raw i64, strings are pointers —
// a STRUCT-typed field recurses via its own <FieldType>__from_json, and a list<Struct>
// field maps each element through <Elem>__from_json. Dispatched at a typed let
// (`let p: T = from_json(d)`) by the genius compiler.
// A crash-safe DEFAULT for a field ABSENT from the decoded JSON dict. Without this, from_json read
// d[fname] for a missing key and stored the (wrong-type) result into a typed slot -> a later read
// of a string/list/struct field deref'd garbage and SEGFAULTED (a remote DoS when from_json runs on
// an untrusted request body). The default is type-correct AND erased to match the present-case
// type so the local var unifies with no HM conflict: a struct field recurses on {} (-> a fully
// defaulted struct, typed <T>); a list<Struct> field defaults to [] (typed list, matching map());
// everything else gets a type-correct literal BOX-ERASED to `any` via [lit][0] (NOVA list elements
// are `any`) to match d[f], which is also `any`.
fn _fj_default(ftype: string, structset: dict, ln: int) -> Expr
    if contains(structset, ftype)
        return Expr("call", ftype + "__from_json", 0, [Expr("dict", "", 0, [], [], ln)], [], ln)
    if _list_struct_elem(ftype, structset) != ""
        return Expr("list", "", 0, [], [], ln)
    let lit = Expr("null", "", 0, [], [], ln)
    if ftype == "string" or ftype == "String"
        lit = Expr("str", "", 0, [], [], ln)
    else if ftype == "float" or ftype == "Float"
        lit = Expr("float", "0.0", 0, [], [], ln)
    else if ftype == "int" or ftype == "Int" or ftype == "bool" or ftype == "Bool"
        lit = Expr("int", "0", 0, [], [], ln)
    else if len(ftype) >= 4 and ftype[0:4] == "list"
        lit = Expr("list", "", 0, [], [], ln)
    else if ftype == "dict"
        lit = Expr("dict", "", 0, [], [], ln)
    Expr("index", "", 0, [Expr("list", "", 0, [lit], [], ln), Expr("int", "0", 0, [], [], ln)], [], ln)

fn _make_from_json_method(tname: string, fields: list, structset: dict, ln: int) -> Stmt
    let body = []
    // SOUNDNESS: from_json on VALID-but-non-dict JSON (e.g. `42`, `[1,2]`, `"hi"`) decodes to a bare
    // int/list/string, and contains(d, field) on a non-dict wild-derefs (strstr on a fake pointer --
    // the int/pointer CVE class). Coerce a non-dict `d` to {} up front so every contains/index below
    // runs on a dict -> all fields safely default. Remote-crash fix (a client controls req.body).
    let _nd_cond = Expr("binop", "!=", 0, [Expr("call", "type_name", 0, [Expr("ident", "d", 0, [], [], ln)], [], ln), Expr("str", "dict", 0, [], [], ln)], [], ln)
    push(body, Stmt("if", "", _nd_cond, [Stmt("assign", "d", Expr("dict", "", 0, [], [], ln), [], [], [], [], ln)], [], [], [], ln))
    let ctor_args = []
    let i = 0
    let n = len(fields)
    while i < n
        match fields[i]
            Param(fname, ftype, fdef) =>
                let local = "_fj_" + fname
                let key = Expr("str", fname, 0, [], [], ln)
                let elem = Expr("index", "", 0, [Expr("ident", "d", 0, [], [], ln), key], [], ln)
                let real = elem
                if contains(structset, ftype)
                    real = Expr("call", ftype + "__from_json", 0, [elem], [], ln)
                else if ftype == "float" or ftype == "Float"
                    // A JSON integer (5, not 5.0) decodes to a RAW i64; reading it straight into a
                    // float field stores the bits without i2f -> garbage (~2.5e-323). float() is
                    // box-aware AND converts a raw int -> the right double. {"price":5} -> 5.0.
                    real = Expr("call", "float", 0, [elem], [], ln)
                else
                    let les = _list_struct_elem(ftype, structset)
                    if les != ""
                        // list<Struct>: map(d[f], fn(e) <Elem>__from_json(e))
                        let lam_body = Expr("call", les + "__from_json", 0, [Expr("ident", "e", 0, [], [], ln)], [], ln)
                        let lam = Expr("lambda", "", 0, [lam_body], [Expr("ident", "e", 0, [], [], ln)], ln)
                        real = Expr("call", "map", 0, [elem, lam], [], ln)
                // _fj_<f> = <default> ; if contains(d, "<f>"): _fj_<f> = <real>   (missing -> safe default)
                push(body, Stmt("assign", local, _fj_default(ftype, structset, ln), [], [], [], [], ln))
                let has = Expr("call", "contains", 0, [Expr("ident", "d", 0, [], [], ln), key], [], ln)
                let setreal = Stmt("assign", local, real, [], [], [], [], ln)
                push(body, Stmt("if", "", has, [setreal], [], [], [], ln))
                push(ctor_args, Expr("ident", local, 0, [], [], ln))
        i = i + 1
    let ctor = Expr("call", tname, 0, ctor_args, [], ln)
    push(body, Stmt("return", "", ctor, [], [], [], [], ln))
    Stmt("fn", tname + "__from_json", null_expr(), body, [Param("d", "dict", null_expr())], [], [], ln)

// <T>__from_json_safe(s) -- the VALIDATING counterpart of the unsafe from_json. It parses, then
// REQUIRES a JSON object (dict); non-object / empty / garbage input -> Err(message) instead of a
// silently-defaulted struct. Returns Result<T, string>: ok(<T>__from_json(d)) on a dict, else err.
// Pure NOVA (no runtime edit): json_decode returns a dict ONLY for objects (non-objects decode to
// int/list/string, empty/garbage -> int), so `type_name(d) != "dict"` is a real validity gate.
// (Brace-started malformed like `{bad` decodes to an empty dict -> ok(defaults); documented v1 gap.)
// Consumed by the typed-let rewrite (`let r: Result<T> = from_json_safe(s)`); the slot stays
// SUM-typed so `match r { Ok(t) => .. Err(e) => .. }` tag-dispatches.
fn _make_from_json_safe_method(tname: string, fields: list, structset: dict, ln: int) -> Stmt
    let body = []
    let dec = Expr("call", "json_decode", 0, [Expr("ident", "_fjss", 0, [], [], ln)], [], ln)
    push(body, Stmt("assign", "_fjsd", dec, [], [], [], [], ln))
    let cond = Expr("binop", "!=", 0, [Expr("call", "type_name", 0, [Expr("ident", "_fjsd", 0, [], [], ln)], [], ln), Expr("str", "dict", 0, [], [], ln)], [], ln)
    let errret = Stmt("return", "", Expr("call", "err", 0, [Expr("str", "expected a JSON object for " + tname, 0, [], [], ln)], [], ln), [], [], [], [], ln)
    push(body, Stmt("if", "", cond, [errret], [], [], [], ln))
    let fi = 0
    let fn2 = len(fields)
    while fi < fn2
        match fields[fi]
            Param(fname, ftype, fdef) =>
                let key = Expr("str", fname, 0, [], [], ln)
                let dref = Expr("ident", "_fjsd", 0, [], [], ln)
                let has = Expr("call", "contains", 0, [dref, key], [], ln)
                let valexpr = Expr("index", "", 0, [Expr("ident", "_fjsd", 0, [], [], ln), key], [], ln)
                let got = Expr("call", "type_name", 0, [valexpr], [], ln)
                let inner = []
                if ftype == "int" or ftype == "Int"
                    let bad = Expr("binop", "!=", 0, [got, Expr("str", "int", 0, [], [], ln)], [], ln)
                    let emsg = Expr("binop", "+", 0, [Expr("str", "field '" + fname + "': expected int, got ", 0, [], [], ln), Expr("call", "type_name", 0, [Expr("index", "", 0, [Expr("ident", "_fjsd", 0, [], [], ln), key], [], ln)], [], ln)], [], ln)
                    push(inner, Stmt("if", "", bad, [Stmt("return", "", Expr("call", "err", 0, [emsg], [], ln), [], [], [], [], ln)], [], [], [], ln))
                else if ftype == "float" or ftype == "Float"
                    let gotf = Expr("call", "type_name", 0, [Expr("index", "", 0, [Expr("ident", "_fjsd", 0, [], [], ln), key], [], ln)], [], ln)
                    let notfloat = Expr("binop", "!=", 0, [gotf, Expr("str", "float", 0, [], [], ln)], [], ln)
                    let gotf2 = Expr("call", "type_name", 0, [Expr("index", "", 0, [Expr("ident", "_fjsd", 0, [], [], ln), key], [], ln)], [], ln)
                    let notint = Expr("binop", "!=", 0, [gotf2, Expr("str", "int", 0, [], [], ln)], [], ln)
                    let both = Expr("binop", "and", 0, [notfloat, notint], [], ln)
                    let emsg = Expr("binop", "+", 0, [Expr("str", "field '" + fname + "': expected float, got ", 0, [], [], ln), Expr("call", "type_name", 0, [Expr("index", "", 0, [Expr("ident", "_fjsd", 0, [], [], ln), key], [], ln)], [], ln)], [], ln)
                    push(inner, Stmt("if", "", both, [Stmt("return", "", Expr("call", "err", 0, [emsg], [], ln), [], [], [], [], ln)], [], [], [], ln))
                else if ftype == "string" or ftype == "String"
                    let bad = Expr("binop", "!=", 0, [got, Expr("str", "string", 0, [], [], ln)], [], ln)
                    let emsg = Expr("binop", "+", 0, [Expr("str", "field '" + fname + "': expected string, got ", 0, [], [], ln), Expr("call", "type_name", 0, [Expr("index", "", 0, [Expr("ident", "_fjsd", 0, [], [], ln), key], [], ln)], [], ln)], [], ln)
                    push(inner, Stmt("if", "", bad, [Stmt("return", "", Expr("call", "err", 0, [emsg], [], ln), [], [], [], [], ln)], [], [], [], ln))
                else if contains(structset, ftype)
                    let bad = Expr("binop", "!=", 0, [got, Expr("str", "dict", 0, [], [], ln)], [], ln)
                    let emsg = Expr("binop", "+", 0, [Expr("str", "field '" + fname + "': expected object, got ", 0, [], [], ln), Expr("call", "type_name", 0, [Expr("index", "", 0, [Expr("ident", "_fjsd", 0, [], [], ln), key], [], ln)], [], ln)], [], ln)
                    push(inner, Stmt("if", "", bad, [Stmt("return", "", Expr("call", "err", 0, [emsg], [], ln), [], [], [], [], ln)], [], [], [], ln))
                if len(inner) > 0
                    push(body, Stmt("if", "", has, inner, [], [], [], ln))
        fi = fi + 1
    let okval = Expr("call", "ok", 0, [Expr("call", tname + "__from_json", 0, [Expr("ident", "_fjsd", 0, [], [], ln)], [], ln)], [], ln)
    push(body, Stmt("return", "", okval, [], [], [], [], ln))
    Stmt("fn", tname + "__from_json_safe", null_expr(), body, [Param("_fjss", "string", null_expr())], [], [], ln)

// A list literal of the given string values -- the bool accept-set for <T>__from_dict, tested with a
// single `contains([..], raw)` membership call (one builtin, no multi-block `or` short-circuit chain).
fn _fd_str_list(values: list, ln: int) -> Expr
    let elems = []
    for v in values
        push(elems, Expr("str", v, 0, [], [], ln))
    Expr("list", "", 0, elems, [], ln)

// Coercion statements for ONE field of <T>__from_dict (run inside `if contains(d, "<f>")`). String->typed
// with VALIDATION: a non-coercible value -> `return err("field '<f>': <reason>")` (never a silent default
// past empty). Empty string -> keep the type-correct default (a NULL column reads as "" via cstr_to_string,
// and a blank form field is "absent"); only a genuinely-malformed non-empty value errors. FLOAT binds the
// VALUE via float(raw) (the proven path; the parse_float_safe Ok payload would lose float typing) and only
// uses parse_float_safe for the Err gate. Uses match Ok/Err (no is_ok/unwrap) so the shadow surface stays ok/err.
fn _fd_coerce_field(local: string, fname: string, ftype: string, structset: dict, ln: int) -> list
    let stmts = []
    let rawname = "_fdraw_" + fname
    let rawget = Expr("index", "", 0, [Expr("ident", "d", 0, [], [], ln), Expr("str", fname, 0, [], [], ln)], [], ln)
    push(stmts, Stmt("assign", rawname, rawget, [], [], [], [], ln))
    let errprefix = "field '" + fname + "': "
    if ftype == "string" or ftype == "String"
        push(stmts, Stmt("assign", local, Expr("ident", rawname, 0, [], [], ln), [], [], [], [], ln))
        return stmts
    let inner = []
    if ftype == "int" or ftype == "Int"
        let vn = "_fdv_" + fname
        let en = "_fde_" + fname
        let okp = Expr("pat_ctor", "Ok", 0, [Expr("pat_var", vn, 0, [], [], ln)], [], ln)
        let oka = Stmt("arm", "", okp, [Stmt("assign", local, Expr("ident", vn, 0, [], [], ln), [], [], [], [], ln)], [], [], [null_expr()], ln)
        let erp = Expr("pat_ctor", "Err", 0, [Expr("pat_var", en, 0, [], [], ln)], [], ln)
        let emsg = Expr("binop", "+", 0, [Expr("str", errprefix, 0, [], [], ln), Expr("ident", en, 0, [], [], ln)], [], ln)
        let era = Stmt("arm", "", erp, [Stmt("return", "", Expr("call", "err", 0, [emsg], [], ln), [], [], [], [], ln)], [], [], [null_expr()], ln)
        push(inner, Stmt("match", "", Expr("call", "parse_int_safe", 0, [Expr("ident", rawname, 0, [], [], ln)], [], ln), [oka, era], [], [], [], ln))
    else if ftype == "float" or ftype == "Float"
        let vn = "_fdv_" + fname
        let en = "_fde_" + fname
        let okp = Expr("pat_ctor", "Ok", 0, [Expr("pat_var", vn, 0, [], [], ln)], [], ln)
        let oka = Stmt("arm", "", okp, [Stmt("assign", local, Expr("call", "float", 0, [Expr("ident", rawname, 0, [], [], ln)], [], ln), [], [], [], [], ln)], [], [], [null_expr()], ln)
        let erp = Expr("pat_ctor", "Err", 0, [Expr("pat_var", en, 0, [], [], ln)], [], ln)
        let emsg = Expr("binop", "+", 0, [Expr("str", errprefix, 0, [], [], ln), Expr("ident", en, 0, [], [], ln)], [], ln)
        let era = Stmt("arm", "", erp, [Stmt("return", "", Expr("call", "err", 0, [emsg], [], ln), [], [], [], [], ln)], [], [], [null_expr()], ln)
        push(inner, Stmt("match", "", Expr("call", "parse_float_safe", 0, [Expr("ident", rawname, 0, [], [], ln)], [], ln), [oka, era], [], [], [], ln))
    else if ftype == "bool" or ftype == "Bool"
        // contains([accept-set], raw) -- single membership call (avoids a multi-block `or` short-circuit
        // chain whose interaction with the nested if/else mis-sequenced the branches).
        let istrue = Expr("call", "contains", 0, [_fd_str_list(["true", "1", "t", "yes", "on", "True", "TRUE"], ln), Expr("ident", rawname, 0, [], [], ln)], [], ln)
        let isfalse = Expr("call", "contains", 0, [_fd_str_list(["false", "0", "f", "no", "off", "False", "FALSE"], ln), Expr("ident", rawname, 0, [], [], ln)], [], ln)
        let setfalse = Stmt("assign", local, Expr("int", "0", 0, [], [], ln), [], [], [], [], ln)
        let errb = Stmt("return", "", Expr("call", "err", 0, [Expr("str", errprefix + "not a boolean", 0, [], [], ln)], [], ln), [], [], [], [], ln)
        let elseif = Stmt("if", "", isfalse, [setfalse], [], [errb], [], ln)
        // int literal value lives in the `en` (numeric) field, NOT the string -- `Expr("int","1",1,...)`.
        let settrue = Stmt("assign", local, Expr("int", "1", 1, [], [], ln), [], [], [], [], ln)
        push(inner, Stmt("if", "", istrue, [settrue], [], [elseif], [], ln))
    else
        // struct/list/dict field from a FLAT dict: no flat coercion -> keep the type-correct default.
        return stmts
    // non-string: empty string -> keep the default (NULL column / blank form field), else coerce-or-err.
    let nonempty = Expr("binop", "!=", 0, [Expr("ident", rawname, 0, [], [], ln), Expr("str", "", 0, [], [], ln)], [], ln)
    push(stmts, Stmt("if", "", nonempty, inner, [], [], [], ln))
    stmts

// <T>__from_dict(d): NAME-KEYED typed extraction from a {string:string} dict (a DB row via
// pool_query_dicts, or a form body). Returns Result<T, string>: ok(T) when every present field coerces,
// else err("field '<f>': <reason>"). The shared core of query_as<T> and form_as<T>. Name-keyed (not
// positional) by design -- column/form order is irrelevant, so a migration cannot silently shift fields.
// Missing key OR empty value -> the field's type-correct default (absence != malformed; NULL-safe).
fn _make_from_dict_method(tname: string, fields: list, structset: dict, ln: int) -> Stmt
    let body = []
    let nd_cond = Expr("binop", "!=", 0, [Expr("call", "type_name", 0, [Expr("ident", "d", 0, [], [], ln)], [], ln), Expr("str", "dict", 0, [], [], ln)], [], ln)
    push(body, Stmt("if", "", nd_cond, [Stmt("assign", "d", Expr("dict", "", 0, [], [], ln), [], [], [], [], ln)], [], [], [], ln))
    let ctor_args = []
    let i = 0
    let n = len(fields)
    while i < n
        match fields[i]
            Param(fname, ftype, fdef) =>
                let local = "_fd_" + fname
                push(body, Stmt("assign", local, _fj_default(ftype, structset, ln), [], [], [], [], ln))
                let key = Expr("str", fname, 0, [], [], ln)
                let has = Expr("call", "contains", 0, [Expr("ident", "d", 0, [], [], ln), key], [], ln)
                let coerce = _fd_coerce_field(local, fname, ftype, structset, ln)
                push(body, Stmt("if", "", has, coerce, [], [], [], ln))
                push(ctor_args, Expr("ident", local, 0, [], [], ln))
        i = i + 1
    let ctor = Expr("call", tname, 0, ctor_args, [], ln)
    push(body, Stmt("return", "", Expr("call", "ok", 0, [ctor], [], ln), [], [], [], [], ln))
    Stmt("fn", tname + "__from_dict", null_expr(), body, [Param("d", "dict", null_expr())], [], [], ln)

// Forge T2.4: <T>__from_dict_list(rows) -> list<T>. A TYPED loop (no HOF) that maps the
// Result-returning <T>__from_dict over each row dict and collects the Ok payloads, skipping
// malformed rows. This produces REAL <T> handles (unlike map(rows, __from_dict), which yields
// list<Result<T>> and reads back as garbage). The db.all<T> let-site rewrite calls this directly
// (like db_find's __from_dict). All nodes are fresh (no shared Expr).
fn _make_from_dict_list_method(tname: string, ln: int) -> Stmt
    let body = []
    push(body, Stmt("assign", "out", Expr("list", "", 0, [], [], ln), [], [], [], [], ln))
    let lb = []
    push(lb, Stmt("assign", "one", Expr("call", tname + "__from_dict", 0, [Expr("ident", "r", 0, [], [], ln)], [], ln), [], [], [], [], ln))
    let push_ok = Stmt("expr", "", Expr("call", "push", 0, [Expr("ident", "out", 0, [], [], ln), Expr("call", "unwrap", 0, [Expr("ident", "one", 0, [], [], ln)], [], ln)], [], ln), [], [], [], [], ln)
    // A row that fails to map used to VANISH with no signal at all. That is DATA LOSS wearing the
    // costume of a short result: one nullable integer column once made whole rows disappear from a
    // typed read while orm_count still saw them, and nothing anywhere reported a problem. The mapping
    // stays lenient (one bad row must not abort a page of results), but it is no longer SILENT -- the
    // drop is announced with the struct name and the mapper's own reason, so the failure is findable.
    let _fdl_msg = Expr("str", "[nova] " + tname + "__from_dict_list: DROPPED an unmappable row: ", 0, [], [], ln)
    let _fdl_why = Expr("call", "unwrap_err", 0, [Expr("ident", "one", 0, [], [], ln)], [], ln)
    let _fdl_warn = Stmt("expr", "", Expr("call", "print", 0, [Expr("binop", "+", 0, [_fdl_msg, _fdl_why], [], ln)], [], ln), [], [], [], [], ln)
    push(lb, Stmt("if", "", Expr("call", "is_ok", 0, [Expr("ident", "one", 0, [], [], ln)], [], ln), [push_ok], [], [_fdl_warn], [], ln))
    push(body, Stmt("for", "r", Expr("ident", "rows", 0, [], [], ln), lb, [], [], [], ln))
    push(body, Stmt("return", "", Expr("ident", "out", 0, [], [], ln), [], [], [], [], ln))
    Stmt("fn", tname + "__from_dict_list", null_expr(), body, [Param("rows", "list", null_expr())], [], [], ln)

// ── Multi-clause function heads (Erlang/Elixir-style guard dispatch) ──────────
// Several same-name/same-arity `fn f(...) when <guard>` heads are fused into ONE
// function whose body is a guard if/else chain (last unguarded head = catch-all;
// if all heads are guarded, a no-clause-matched assert is the final else). Heads
// share parameter names (guards/bodies reference the same params). Runs post-parse
// (before expand_derives + inference) so the rest of the pipeline sees one fn. The
// compiler's own source has no guards/duplicate names, so this is a no-op for
// self-compilation (bootstrap-safe).
fn _fn_guard_of(s: Stmt) -> Expr
    match s
        Stmt(gtag, gname, gexpr, gbody, gparams, gelse, ganns, gsline) =>
            if len(gelse) > 0
                match gelse[0]
                    Stmt(gt2, gn2, ge2, gb2, gp2, geb2, ga2, gl2) =>
                        if gt2 == "guard"
                            return ge2
    null_expr()

fn _clause_fail_stmt(name: string, ln: int) -> Stmt
    let cond = Expr("bool", "false", 0, [], [], ln)
    let msg = Expr("str", "no matching clause for " + name, 0, [], [], ln)
    let call = Expr("call", "assert", 0, [cond, msg], [], ln)
    Stmt("expr", "", call, [], [], [], [], ln)

fn _fuse_heads(heads: list, name: string, params: list, ret_expr: Expr, anns: list, ln: int) -> Stmt
    let chain = [_clause_fail_stmt(name, ln)]
    let i = len(heads) - 1
    while i >= 0
        let h = heads[i]
        let g = _fn_guard_of(h)
        let hbody = []
        match h
            Stmt(ht, hn, he, hb, hp, heb, ha, hl) =>
                hbody = hb
        if g == null_expr()
            chain = hbody
        else
            chain = [Stmt("if", "", g, hbody, [], chain, [], ln)]
        i = i - 1
    Stmt("fn", name, ret_expr, chain, params, [], anns, ln)


// Lift every "lambda_blk" out of an expression into a real named function declared just
// BEFORE the statement that contained it, replacing the node with a reference to that name.
//
// This is the same lambda-lifting the trailing-`fn` form already uses (_desugar_trail_fns),
// and it is chosen over inventing a block-EXPRESSION node for one decisive reason: the lifted
// function is emitted as a SIBLING statement, so it is a NESTED function and NOVA's existing
// closure conversion gives it real capture of the enclosing scope. Verified rather than
// assumed -- a trailing-fn block reads an enclosing local correctly today. A block-expression
// node would have meant teaching inference, IR lowering, capture analysis and the s4 renamer
// about an Expr that carries Stmts, for identical observable behaviour.
//
// Runs BEFORE every other pass, so "lambda_blk" never reaches inference, the IR builder or s4.
fn _lift_e(e: Expr, out_fns: list, ctr: list) -> Expr
    match e
        Expr(tag, value, num, children, fields, eln) =>
            if tag == "lambda_blk"
                ctr[0] = ctr[0] + 1
                let fname = "__lam_" + str(eln) + "_" + str(ctr[0])
                let fparams = []
                for c in children
                    match c
                        Expr(_pt, _pv, _pn, _pc, _pf, _pl) =>
                            push(fparams, Param(_pv, "", null_expr()))
                // recurse FIRST so a lambda_blk nested inside this one is lifted too, and so
                // the inner function is declared before the outer one that references it.
                let fbody = _lift_stmts(fields, out_fns, ctr)
                push(out_fns, Stmt("fn", fname, null_expr(), fbody, fparams, [], [], eln))
                return Expr("ident", fname, 0, [], [], eln)
            let nch = []
            for c in children
                push(nch, _lift_e(c, out_fns, ctr))
            // `fields` is only walked for tags whose fields hold EXPRESSIONS. catch/lambda/
            // closure/fn/match/struct_init carry Stmts or Params there, and walking those as
            // Exprs is the bug class that segfaulted the compiler during inc3b.
            let nf = fields
            if tag != "catch" and tag != "lambda" and tag != "closure" and tag != "fn" and tag != "struct_init" and tag != "match"
                let nf2 = []
                for f in fields
                    push(nf2, _lift_e(f, out_fns, ctr))
                nf = nf2
            Expr(tag, value, num, nch, nf, eln)

fn _lift_stmts(stmts: list, out_fns: list, ctr: list) -> list
    let out = []
    for st in stmts
        match st
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                let mine = []
                let nexpr = _lift_e(expr, mine, ctr)
                let nbody = _lift_stmts(body, out_fns, ctr)
                let nelse = _lift_stmts(else_body, out_fns, ctr)
                // the lifted functions are emitted immediately before the statement that
                // uses them, so the reference is always in scope at the point of use.
                for f in mine
                    push(out, f)
                push(out, Stmt(tag, name, nexpr, nbody, params, nelse, anns, sline))
    out

fn _lift_block_lambdas(stmts: list) -> list
    let ctr = [0]
    let top = []
    let res = _lift_stmts(stmts, top, ctr)
    let out = []
    for f in top
        push(out, f)
    for r in res
        push(out, r)
    out

fn _desugar_trail_fns(stmts: list) -> list
    let _dt_out = []
    for _dt_s in stmts
        match _dt_s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "trail_fn_let" or tag == "trail_fn_expr"
                    let _dt_fn = "__tfn_" + str(sline)
                    let _dt_nb = _desugar_trail_fns(body)
                    push(_dt_out, Stmt("fn", _dt_fn, null_expr(), _dt_nb, params, [], [], sline))
                    match expr
                        Expr(et, ev, en, ec, ef, el) =>
                            let _dt_args = []
                            for _dt_a in ec
                                push(_dt_args, _dt_a)
                            push(_dt_args, Expr("ident", _dt_fn, 0, [], [], sline))
                            let _dt_call = Expr(et, ev, en, _dt_args, ef, el)
                            if tag == "trail_fn_let"
                                push(_dt_out, Stmt("assign", name, _dt_call, [], [], [], [], sline))
                            else
                                push(_dt_out, Stmt("expr", "", _dt_call, [], [], [], [], sline))
                else
                    let _dt_nb2 = body
                    let _dt_ne2 = else_body
                    if len(body) > 0
                        _dt_nb2 = _desugar_trail_fns(body)
                    if len(else_body) > 0
                        _dt_ne2 = _desugar_trail_fns(else_body)
                    push(_dt_out, Stmt(tag, name, expr, _dt_nb2, params, _dt_ne2, anns, sline))
    _dt_out

fn _expand_destruct_list(stmts: list) -> list
    let out = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "let_destruct"
                    let _dt_tmp = "__let_tup_" + str(sline)
                    push(out, Stmt("assign", _dt_tmp, expr, [], [], [], [], sline))
                    let _dt_i = 0
                    for _dt_n in params
                        if _dt_n != "_"
                            let _dt_acc = Expr("index", "", 0, [Expr("ident", _dt_tmp, 0, [], [], sline), Expr("int", "", _dt_i, [], [], sline)], [], sline)
                            push(out, Stmt("assign", _dt_n, _dt_acc, [], [], [], [], sline))
                        _dt_i = _dt_i + 1
                else if tag == "where_wrap"
                    let _whi = 1
                    while _whi < len(body)
                        push(out, body[_whi])
                        _whi = _whi + 1
                    push(out, body[0])
                else
                    let _ed_nb = body
                    let _ed_ne = else_body
                    if len(body) > 0
                        _ed_nb = _expand_destruct_list(body)
                    if len(else_body) > 0
                        _ed_ne = _expand_destruct_list(else_body)
                    push(out, Stmt(tag, name, expr, _ed_nb, params, _ed_ne, anns, sline))
    out

fn fuse_multiclause(stmts: list) -> list
    let group_guarded = {}
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "fn"
                    if _fn_guard_of(s) != null_expr()
                        group_guarded[name + "/" + str(len(params))] = 1
    let out = []
    let emitted = {}
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "fn" and contains(group_guarded, name + "/" + str(len(params)))
                    let key = name + "/" + str(len(params))
                    if not contains(emitted, key)
                        emitted[key] = 1
                        let heads = []
                        for s2 in stmts
                            match s2
                                Stmt(t2, n2, e2, b2, p2x, eb2, a2, l2) =>
                                    if t2 == "fn" and n2 == name and len(p2x) == len(params)
                                        push(heads, s2)
                        push(out, _fuse_heads(heads, name, params, expr, anns, sline))
                else
                    push(out, s)
    out

fn inject_memo(stmts: list) -> list
    let out = []
    for s in stmts
        let handled = false
        match s
            Stmt(tag, name, ret_expr, body, params, fn_else, anns, sline) =>
                if tag == "fn"
                    let is_memo = false
                    let other_anns = []
                    for a in anns
                        match a
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "memo"
                                    is_memo = true
                                else
                                    push(other_anns, a)
                    if is_memo
                        handled = true
                        let impl_name = name + "__memo_impl"
                        push(out, Stmt("fn", impl_name, ret_expr, body, params, fn_else, other_anns, sline))
                        let arg_idents = []
                        for pp in params
                            match pp
                                Param(ppn, ppt, ppd) =>
                                    push(arg_idents, Expr("ident", ppn, 0, [], [], sline))
                        let cache_init = Expr("call", "memo_cache", 0, [Expr("str", name, 0, [], [], sline)], [], sline)
                        let cache_bind = Stmt("assign", "__mc", cache_init, [], [], [], [], sline)
                        let cache_id = Expr("ident", "__mc", 0, [], [], sline)
                        let memo_key = null_expr()
                        if len(params) == 1
                            memo_key = Expr("call", "str", 0, [arg_idents[0]], [], sline)
                        else
                            let key_parts = []
                            let _mk_first = true
                            for _mk_a in arg_idents
                                if _mk_first
                                    push(key_parts, Expr("call", "str", 0, [_mk_a], [], sline))
                                    _mk_first = false
                                else
                                    push(key_parts, Expr("str", ",", 0, [], [], sline))
                                    push(key_parts, Expr("call", "str", 0, [_mk_a], [], sline))
                            memo_key = key_parts[0]
                            let _mk_i = 1
                            while _mk_i < len(key_parts)
                                memo_key = Expr("binop", "+", 0, [memo_key, key_parts[_mk_i]], [], sline)
                                _mk_i = _mk_i + 1
                        let has_check = Expr("call", "contains", 0, [cache_id, memo_key], [], sline)
                        let cache_get = Expr("index", "", 0, [cache_id, memo_key], [], sline)
                        // 0E: bracket the cache LOOKUP and the INSERT with memo_lock/unlock (the gated,
                        // reused monitor lock) so two carriers running the same @memo'd fn cannot race the
                        // cache dict (heap corruption on a concurrent insert/rehash). The lock is RELEASED
                        // across the compute -> recursive @memo is deadlock-free, and the only TOCTOU (a
                        // benign double-compute of a pure fn) just re-stores the same value. Each lock call
                        // is a FRESH node (never share Expr nodes in a generator).
                        let hit_bind = Stmt("assign", "__memo_v", cache_get, [], [], [], [], sline)
                        let hit_unlock = Stmt("expr", "", Expr("call", "memo_unlock", 0, [], [], sline), [], [], [], [], sline)
                        let hit_ret = Stmt("return", "", Expr("ident", "__memo_v", 0, [], [], sline), [], [], [], [], sline)
                        let check_stmt = Stmt("if", "", has_check, [hit_bind, hit_unlock, hit_ret], [], [], [], sline)
                        let lock_a = Stmt("expr", "", Expr("call", "memo_lock", 0, [], [], sline), [], [], [], [], sline)
                        let unlock_a = Stmt("expr", "", Expr("call", "memo_unlock", 0, [], [], sline), [], [], [], [], sline)
                        let call_impl = Expr("call", impl_name, 0, arg_idents, [], sline)
                        let bind_result = Stmt("assign", "__memo_r", call_impl, [], [], [], [], sline)
                        let lock_b = Stmt("expr", "", Expr("call", "memo_lock", 0, [], [], sline), [], [], [], [], sline)
                        let cache_lhs = Expr("index", "", 0, [cache_id, memo_key], [], sline)
                        let store_stmt = Stmt("assign", "", Expr("ident", "__memo_r", 0, [], [], sline), [], [], [], [cache_lhs], sline)
                        let unlock_b = Stmt("expr", "", Expr("call", "memo_unlock", 0, [], [], sline), [], [], [], [], sline)
                        let ret_stmt = Stmt("return", "", Expr("ident", "__memo_r", 0, [], [], sline), [], [], [], [], sline)
                        push(out, Stmt("fn", name, ret_expr, [cache_bind, lock_a, check_stmt, unlock_a, bind_result, lock_b, store_stmt, unlock_b, ret_stmt], params, [], other_anns, sline))
        if not handled
            push(out, s)
    out

// L1 (declarative multiplier) Phase-1: @test compile-time test discovery. Every top-level fn annotated
// `@test` (which SHOULD be `fn foo() -> bool`, true = pass) is collected at compile time; a generated
// `__nova_run_tests() -> int` calls each in turn, tallies the passes, prints "P/N tests passed", and
// returns the pass count. This is Rust's #[test] with ZERO runtime reflection -- the annotation is read
// at compile time and the wiring is emitted as ordinary NOVA AST (the same mechanism as @memo/@ensures).
// The @test annotation is left on the fn (harmless -- unrecognized annotations are erased downstream).
// NOTE: single-module scope for now -- with @test fns across multiple modules the generated runner name
// would collide (the L11 symbol-namespacing item); a single test module is the supported Phase-1 shape.
fn inject_tests(stmts: list, pe: list) -> list
    let test_names = []
    let test_lines = []
    let _seen = {}
    for s in stmts
        match s
            Stmt(tag, name, ret_expr, body, params, fn_else, anns, sline) =>
                // Skip compiler-generated split impls: inject_ensures/inject_memo copy the wrapper's
                // annotations (incl. @test) onto <name>__ens_impl/__memo_impl, so collecting those would
                // double-count the test AND run its body twice. Collect each USER fn AT MOST ONCE (via
                // _seen) so a fn carrying two @test annotations doesn't get counted twice either.
                if tag == "fn" and not ends_with(name, "__ens_impl") and not ends_with(name, "__memo_impl")
                    for a in anns
                        match a
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann" and av == "test" and not contains(_seen, name)
                                    _seen[name] = 1
                                    // Enforce the @test contract at COMPILE TIME: `fn name() -> bool`
                                    // (true = pass). NOVA's uniform i64 lowering means a void/int return
                                    // would otherwise slip through the generated `if name()` and silently
                                    // report a passing test as failed (void->0) or invert it (int); so
                                    // reject a non-bool return, or any parameters (the runner calls with
                                    // no args), with a clear diagnostic rather than a silent wrong tally.
                                    let _rt_ok = false
                                    match ret_expr
                                        Expr(_rtt, _rtv, _rtn, _rtc, _rtf, _rtl) =>
                                            if _rtt == "rettype" and _rtv == "bool"
                                                _rt_ok = true
                                    if not _rt_ok
                                        push(pe, "error[E1301]: @test function '" + name + "' must return bool (declare `fn " + name + "() -> bool`, true = pass) [line " + str(sline) + "]")
                                    else if len(params) != 0
                                        push(pe, "error[E1302]: @test function '" + name + "' must take no parameters (it is called with no arguments) [line " + str(sline) + "]")
                                    push(test_names, name)
                                    push(test_lines, sline)
    if len(test_names) == 0
        return stmts
    let ln = 0
    let rbody = []
    let _one = Expr("int", "1", 1, [], [], ln)
    let _zero = Expr("int", "0", 0, [], [], ln)
    push(rbody, Stmt("assign", "__t_pass", Expr("int", "0", 0, [], [], ln), [], [], [], [], ln))
    push(rbody, Stmt("assign", "__t_fail", Expr("int", "0", 0, [], [], ln), [], [], [], [], ln))
    push(rbody, Stmt("assign", "__t_skip", Expr("int", "0", 0, [], [], ln), [], [], [], [], ln))
    push(rbody, Stmt("assign", "__t_filter", Expr("call", "env", 0, [Expr("str", "NOVA_TEST_FILTER", 0, [], [], ln)], [], ln), [], [], [], [], ln))
    let _ti = 0
    while _ti < len(test_names)
        let tn = test_names[_ti]
        let tln = test_lines[_ti]
        let callc = Expr("call", tn, 0, [], [], tln)
        let inc_p = Stmt("assign", "", Expr("binop", "+", 0, [Expr("ident", "__t_pass", 0, [], [], ln), _one], [], ln), [], [], [], [Expr("ident", "__t_pass", 0, [], [], ln)], ln)
        let inc_f = Stmt("assign", "", Expr("binop", "+", 0, [Expr("ident", "__t_fail", 0, [], [], ln), _one], [], ln), [], [], [], [Expr("ident", "__t_fail", 0, [], [], ln)], ln)
        let inc_s = Stmt("assign", "", Expr("binop", "+", 0, [Expr("ident", "__t_skip", 0, [], [], ln), _one], [], ln), [], [], [], [Expr("ident", "__t_skip", 0, [], [], ln)], ln)
        let pass_msg = Stmt("expr", "", Expr("call", "print", 0, [Expr("binop", "+", 0, [Expr("str", "  PASS ", 0, [], [], ln), Expr("str", tn, 0, [], [], ln)], [], ln)], [], ln), [], [], [], [], ln)
        let fail_msg = Stmt("expr", "", Expr("call", "print", 0, [Expr("binop", "+", 0, [Expr("str", "  FAIL ", 0, [], [], ln), Expr("str", tn, 0, [], [], ln)], [], ln)], [], ln), [], [], [], [], ln)
        let then_pass = [inc_p, pass_msg]
        let then_fail = [inc_f, fail_msg]
        let inner_if = Stmt("if", "", callc, then_pass, [], then_fail, [], ln)
        let filter_empty = Expr("binop", "==", 0, [Expr("call", "len", 0, [Expr("ident", "__t_filter", 0, [], [], ln)], [], ln), _zero], [], ln)
        let filter_match = Expr("call", "contains", 0, [Expr("str", tn, 0, [], [], ln), Expr("ident", "__t_filter", 0, [], [], ln)], [], ln)
        let filter_cond = Expr("binop", "or", 0, [filter_empty, filter_match], [], ln)
        push(rbody, Stmt("if", "", filter_cond, [inner_if], [], [inc_s], [], ln))
        _ti = _ti + 1
    let total_expr = Expr("binop", "+", 0, [Expr("ident", "__t_pass", 0, [], [], ln), Expr("ident", "__t_fail", 0, [], [], ln)], [], ln)
    let pass_str = Expr("call", "str", 0, [Expr("ident", "__t_pass", 0, [], [], ln)], [], ln)
    let total_str = Expr("call", "str", 0, [total_expr], [], ln)
    let m1 = Expr("binop", "+", 0, [pass_str, Expr("str", "/", 0, [], [], ln)], [], ln)
    let m2 = Expr("binop", "+", 0, [m1, total_str], [], ln)
    let m3 = Expr("binop", "+", 0, [m2, Expr("str", " tests passed", 0, [], [], ln)], [], ln)
    push(rbody, Stmt("expr", "", Expr("call", "print", 0, [m3], [], ln), [], [], [], [], ln))
    let skip_gt0 = Expr("binop", ">", 0, [Expr("ident", "__t_skip", 0, [], [], ln), _zero], [], ln)
    let skip_str = Expr("call", "str", 0, [Expr("ident", "__t_skip", 0, [], [], ln)], [], ln)
    let sm1 = Expr("binop", "+", 0, [Expr("str", "  (", 0, [], [], ln), skip_str], [], ln)
    let sm2 = Expr("binop", "+", 0, [sm1, Expr("str", " skipped by filter)", 0, [], [], ln)], [], ln)
    let skip_print = Stmt("expr", "", Expr("call", "print", 0, [sm2], [], ln), [], [], [], [], ln)
    push(rbody, Stmt("if", "", skip_gt0, [skip_print], [], [], [], ln))
    push(rbody, Stmt("return", "", Expr("ident", "__t_pass", 0, [], [], ln), [], [], [], [], ln))
    let runner = Stmt("fn", "__nova_run_tests", Expr("rettype", "int", 0, [], [], ln), rbody, [], [], [], ln)
    let has_main = false
    let out = []
    for s in stmts
        push(out, s)
        match s
            Stmt(stag, sname, _sr, _sb, _sp, _se, _sa, _sl) =>
                if stag == "fn" and sname == "main"
                    has_main = true
    push(out, runner)
    if not has_main
        push(out, Stmt("expr", "", Expr("call", "__nova_run_tests", 0, [], [], ln), [], [], [], [], ln))
    out

// L1 (declarative multiplier) Phase-1: declarative HTTP routing. A handler `fn h(req) -> string` annotated
// `@get("/path")` / `@post` / `@put` / `@delete` / `@patch` is collected at compile time; a generated
// `fn __nova_register_routes(a)` registers each on the Forge app `a` via the public get/post/... API and
// returns `a`. Spring's @GetMapping / ASP.NET's [HttpGet] in NOVA with zero runtime cost -- the annotation
// is read at IR-gen and the wiring emitted as ordinary NOVA AST (same mechanism as @test/@memo). Usage:
//   let a = app(); a = __nova_register_routes(a); serve_app(a, 8080)
// The generated get/post calls resolve to Forge's public API, so a routed program imports forge (routing
// IS a Forge feature). Single-module scope (multi-module runner-name collision is the L11 item).
fn inject_routes(stmts: list, pe: list) -> list
    let r_methods = []
    let r_paths = []
    let r_handlers = []
    for s in stmts
        match s
            Stmt(tag, name, ret_expr, body, params, fn_else, anns, sline) =>
                // Skip compiler-generated split impls: inject_ensures/inject_memo copy the wrapper's
                // route annotation onto <name>__ens_impl/__memo_impl too. Registering that raw impl
                // ahead of the wrapper (first-match-wins dispatch) would silently BYPASS the ensures
                // postcondition / memo cache on exactly the HTTP path. Register only the wrapper.
                if tag == "fn" and not ends_with(name, "__ens_impl") and not ends_with(name, "__memo_impl")
                    for an in anns
                        match an
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann_with_arg" and (av == "get" or av == "post" or av == "put" or av == "delete" or av == "patch")
                                    if len(ac) > 0
                                        match ac[0]
                                            Expr(pt, pv, pn2, pc, pf, pl) =>
                                                if pt == "str"
                                                    push(r_methods, av)
                                                    push(r_paths, pv)
                                                    push(r_handlers, name)
                                else if at == "ann" and (av == "get" or av == "post" or av == "put" or av == "delete" or av == "patch")
                                    // A routing annotation with NO path parses to a bare `ann` and would
                                    // otherwise be silently dropped -- the handler compiles but no route
                                    // is registered (a 404 with zero feedback). Reject it with guidance.
                                    push(pe, "error[E1310]: routing annotation @" + av + " on '" + name + "' requires a string path, e.g. @" + av + "(\"/path\") [line " + str(sline) + "]")
    if len(r_methods) == 0
        return stmts
    let ln = 0
    let rbody = []
    let i = 0
    while i < len(r_methods)
        // <method>(a, "<path>", <handler>)   e.g. get(a, "/hello", h_hello)
        let call = Expr("call", r_methods[i], 0, [Expr("ident", "a", 0, [], [], ln), Expr("str", r_paths[i], 0, [], [], ln), Expr("ident", r_handlers[i], 0, [], [], ln)], [], ln)
        push(rbody, Stmt("expr", "", call, [], [], [], [], ln))
        i = i + 1
    push(rbody, Stmt("return", "", Expr("ident", "a", 0, [], [], ln), [], [], [], [], ln))
    let rparams = [Param("a", "", null_expr())]
    let runner = Stmt("fn", "__nova_register_routes", null_expr(), rbody, rparams, [], [], ln)
    let out = []
    for s in stmts
        push(out, s)
    push(out, runner)
    out

// Design-by-contract postconditions (`ensures <expr>`, where `result` names the return
// value). For each fn carrying an "ensures" annotation, split it into <name>__ens_impl
// (the original body, untouched) plus a thin WRAPPER under the original name that runs the
// body, asserts each postcondition on `result`, and returns it. This checks the contract
// on EVERY return path (early returns, nested returns, implicit last-expr) for free —
// they all flow through the impl's single return value — with no return-rewriting. Runs
// post-parse, before expand_derives. The compiler's own source has no `ensures`, so this
// is a no-op for self-compilation (bootstrap-safe).
fn inject_ensures(stmts: list) -> list
    let out = []
    for s in stmts
        let handled = false
        match s
            Stmt(tag, name, ret_expr, body, params, fn_else, anns, sline) =>
                if tag == "fn"
                    let ens_exprs = []
                    let other_anns = []
                    for a in anns
                        match a
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ensures"
                                    for e in ac
                                        push(ens_exprs, e)
                                else
                                    push(other_anns, a)
                    if len(ens_exprs) > 0
                        handled = true
                        let impl_name = name + "__ens_impl"
                        push(out, Stmt("fn", impl_name, ret_expr, body, params, fn_else, other_anns, sline))
                        let arg_idents = []
                        for pp in params
                            match pp
                                Param(ppn, ppt, ppd) =>
                                    push(arg_idents, Expr("ident", ppn, 0, [], [], sline))
                        let wbody = [Stmt("assign", "result", Expr("call", impl_name, 0, arg_idents, [], sline), [], [], [], [], sline)]
                        for en in ens_exprs
                            let en_msg = Expr("str", "postcondition failed in '" + name + "'", 0, [], [], sline)
                            push(wbody, Stmt("expr", "", Expr("call", "assert", 0, [en, en_msg], [], sline), [], [], [], [], sline))
                        push(wbody, Stmt("return", "", Expr("ident", "result", 0, [], [], sline), [], [], [], [], sline))
                        push(out, Stmt("fn", name, ret_expr, wbody, params, [], other_anns, sline))
        if not handled
            push(out, s)
    out

fn _make_fields_method(tname: string, fields: list, ln: int) -> Stmt
    let elems = []
    for f in fields
        match f
            Param(fname, ftype, fdef) =>
                push(elems, Expr("str", fname, 0, [], [], ln))
    let list_expr = Expr("list", "", 0, elems, [], ln)
    let ret_stmt = Stmt("return", "", list_expr, [], [], [], [], ln)
    Stmt("fn", tname + "__fields", null_expr(), [ret_stmt], [Param("self", tname, null_expr())], [], [], ln)

fn _make_type_name_method(tname: string, ln: int) -> Stmt
    let ret_stmt = Stmt("return", "", Expr("str", tname, 0, [], [], ln), [], [], [], [], ln)
    Stmt("fn", tname + "__type_name", null_expr(), [ret_stmt], [Param("self", tname, null_expr())], [], [], ln)

fn _make_field_get_method(tname: string, fields: list, ln: int) -> Stmt
    // Returns the value of field `name` from `self`. Because fields may have
    // different types (string/int/bool), we push the value into a temp list (which
    // type-erases to `any`) and return list[0], avoiding HM unification conflicts.
    let box_var = "_fg_box"
    let box_init = Stmt("assign", box_var, Expr("list", "", 0, [], [], ln), [], [], [], [], ln)
    let body = [box_init]
    let box_id = Expr("ident", box_var, 0, [], [], ln)
    for f in fields
        match f
            Param(fname, ftype, fdef) =>
                let cond = Expr("binop", "==", 0, [Expr("ident", "name", 0, [], [], ln), Expr("str", fname, 0, [], [], ln)], [], ln)
                let memb = Expr("member", fname, 0, [Expr("ident", "self", 0, [], [], ln)], [], ln)
                let do_push = Stmt("expr", "", Expr("call", "push", 0, [box_id, memb], [], ln), [], [], [], [], ln)
                let do_ret = Stmt("return", "", Expr("index", "", 0, [box_id, Expr("int", "0", 0, [], [], ln)], [], ln), [], [], [], [], ln)
                push(body, Stmt("if", "", cond, [do_push, do_ret], [], [], [], ln))
    push(body, Stmt("return", "", Expr("null", "", 0, [], [], ln), [], [], [], [], ln))
    Stmt("fn", tname + "__field_get", null_expr(), body, [Param("self", tname, null_expr()), Param("name", "string", null_expr())], [], [], ln)

fn _make_field_types_method(tname: string, fields: list, ln: int) -> Stmt
    let elems = []
    for f in fields
        match f
            Param(fname, ftype, fdef) =>
                push(elems, Expr("str", ftype, 0, [], [], ln))
    let list_expr = Expr("list", "", 0, elems, [], ln)
    let ret_stmt = Stmt("return", "", list_expr, [], [], [], [], ln)
    Stmt("fn", tname + "__field_types", null_expr(), [ret_stmt], [Param("self", tname, null_expr())], [], [], ln)

// Reflection: field_names(x) -> [field name strings], the name-companion to field_types.
// Compiler-derived per struct (zero annotation), completing the reflection trio with
// type_name + field_get for serialization frameworks. NOT Java's full reflect — just enough.
fn _make_field_names_method(tname: string, fields: list, ln: int) -> Stmt
    let elems = []
    for f in fields
        match f
            Param(fname, ftype, fdef) =>
                push(elems, Expr("str", fname, 0, [], [], ln))
    let list_expr = Expr("list", "", 0, elems, [], ln)
    let ret_stmt = Stmt("return", "", list_expr, [], [], [], [], ln)
    Stmt("fn", tname + "__field_names", null_expr(), [ret_stmt], [Param("self", tname, null_expr())], [], [], ln)

fn expand_derives(stmts: list) -> list
    // NOVA way (not Rust/Python): the genius compiler derives a value's textual form (show) and
    // its JSON encoding (to_json) from its STRUCTURE (innovation D1) — zero annotation, for EVERY
    // record struct. Equality (==), hash and clone(copy) are universal structural runtime
    // operations, so they need no per-type generation at all. Every struct goes in showset/jsonset
    // so nested struct fields render/serialize recursively via the same derived path. (Skip parser
    // phantoms from keyword-named fields — see _is_valid_struct_name.)
    let showset = {}
    let jsonset = {}
    for s in stmts
        match s
            Stmt(stag, sname, sexpr, sbody, sparams, selse, sanns, sln) =>
                if stag == "type"
                    if _is_valid_struct_name(sname) == 1
                        showset[sname] = 1
                        jsonset[sname] = 1
    let user_fns = {}
    for s in stmts
        match s
            Stmt(stag, sname, sexpr, sbody, sparams, selse, sanns, sln) =>
                if stag == "fn"
                    user_fns[sname] = 1
    let generated = []
    for s in stmts
        match s
            Stmt(stag, sname, sexpr, sbody, sparams, selse, sanns, sln) =>
                if stag == "type"
                    if _is_valid_struct_name(sname) == 1
                        // LOCK-7 @redact: field indices carried on the type's annotations.
                        // from_json is deliberately NOT redacted -- it PARSES input rather
                        // than disclosing a stored secret.
                        let _redset = {}
                        for _ra in sanns
                            match _ra
                                Expr(_rat, _rav, _ran, _rac, _raf, _ral) =>
                                    if _rat == "redact"
                                        _redset[_rav] = 1
                        if contains(user_fns, sname + "__show") == 0
                            push(generated, _make_show_method(sname, sparams, showset, _redset, sln))
                        if contains(user_fns, sname + "__to_json") == 0
                            push(generated, _make_to_json_method(sname, sparams, jsonset, _redset, sln))
                        if contains(user_fns, sname + "__from_json") == 0
                            push(generated, _make_from_json_method(sname, sparams, jsonset, sln))
                        // __from_json_safe is built from the `ok`/`err` Result constructors. If THIS
                        // unit shadows either with a user fn (a legal feature -- see shadow_test), the
                        // generated body would bind the wrong fn and fail to type-check. Skip it then:
                        // a unit that redefines the Result constructor cannot sensibly use a
                        // Result-returning extractor, and every normal unit (no shadow) still gets it
                        // unconditionally, so cross-module from_json_safe keeps working.
                        if contains(user_fns, sname + "__from_json_safe") == 0 and contains(user_fns, "ok") == 0 and contains(user_fns, "err") == 0
                            push(generated, _make_from_json_safe_method(sname, sparams, jsonset, sln))
                        // <T>__from_dict (query_as/form_as core) -- same ok/err shadow gate.
                        if contains(user_fns, sname + "__from_dict") == 0 and contains(user_fns, "ok") == 0 and contains(user_fns, "err") == 0
                            push(generated, _make_from_dict_method(sname, sparams, jsonset, sln))
                        // <T>__from_dict_list (db.all<T> core) -- needs __from_dict + is_ok/unwrap unshadowed.
                        // `unwrap_err` joins the gate because the drop path now REPORTS the mapper's
                        // reason instead of discarding the row silently.
                        if contains(user_fns, sname + "__from_dict_list") == 0 and contains(user_fns, "ok") == 0 and contains(user_fns, "err") == 0 and contains(user_fns, "is_ok") == 0 and contains(user_fns, "unwrap") == 0 and contains(user_fns, "unwrap_err") == 0
                            push(generated, _make_from_dict_list_method(sname, sln))
                        if contains(user_fns, sname + "__fields") == 0
                            push(generated, _make_fields_method(sname, sparams, sln))
                        if contains(user_fns, sname + "__type_name") == 0
                            push(generated, _make_type_name_method(sname, sln))
                        if contains(user_fns, sname + "__field_types") == 0
                            push(generated, _make_field_types_method(sname, sparams, sln))
                        if contains(user_fns, sname + "__field_names") == 0
                            push(generated, _make_field_names_method(sname, sparams, sln))
                        if contains(user_fns, sname + "__field_get") == 0
                            push(generated, _make_field_get_method(sname, sparams, sln))
    if len(generated) == 0
        return stmts
    let out = []
    for s in stmts
        push(out, s)
    for g in generated
        push(out, g)
    out

fn parse_program(tokens: list, pe: list) -> list
    let stmts = []
    let pos = skip_nl(tokens, 0)
    while tk(tokens, pos) != "EOF"
        let prev_pe_len = len(pe)
        let sr = parse_stmt(tokens, pos, pe)
        let new_pos = skip_nl(tokens, sr.pos)
        // If a parse error was recorded and pos didn't advance, force forward
        if len(pe) > prev_pe_len and new_pos <= pos and tk(tokens, pos) != "EOF"
            pos = pos + 1
        else
            pos = new_pos
        match sr.stmt
            Stmt(stag, sn, se, sb, sp2, seb, sa, sl) =>
                if stag != "error"
                    push(stmts, sr.stmt)
    let _p0 = fuse_multiclause(_expand_destruct_list(_desugar_trail_fns(_lift_block_lambdas(stmts))))
    let _p1 = inject_routes(inject_tests(inject_memo(inject_ensures(_p0)), pe), pe)
    let _p2 = inject_entity(inject_service(inject_middleware(inject_inject(inject_deprecated(inject_comptime(_p1))))))
    let _p3 = inject_builder(inject_validate(inject_log(inject_retry(inject_timeout(inject_singleton(_p2))))))
    let _p4 = inject_observable(inject_async(inject_cache(inject_event(_p3))))
    inline_module_consts(expand_derives(_p4))

fn _to_lower_char(ch: string) -> string
    let lc = {}
    lc["A"] = "a"
    lc["B"] = "b"
    lc["C"] = "c"
    lc["D"] = "d"
    lc["E"] = "e"
    lc["F"] = "f"
    lc["G"] = "g"
    lc["H"] = "h"
    lc["I"] = "i"
    lc["J"] = "j"
    lc["K"] = "k"
    lc["L"] = "l"
    lc["M"] = "m"
    lc["N"] = "n"
    lc["O"] = "o"
    lc["P"] = "p"
    lc["Q"] = "q"
    lc["R"] = "r"
    lc["S"] = "s"
    lc["T"] = "t"
    lc["U"] = "u"
    lc["V"] = "v"
    lc["W"] = "w"
    lc["X"] = "x"
    lc["Y"] = "y"
    lc["Z"] = "z"
    if contains(lc, ch) == true
        return lc[ch]
    return ch

fn _snake_case(name: string) -> string
    let result = ""
    let i = 0
    while i < len(name)
        let ch = slice(name, i, i + 1)
        if ch >= "A" and ch <= "Z"
            if i > 0
                result = result + "_"
            result = result + _to_lower_char(ch)
        else
            result = result + ch
        i = i + 1
    return result

// L1a @entity annotation: for each `type` annotated @entity (or @entity("table_name")),
// generates ORM helper methods: <T>__table_name, <T>__primary_key, <T>__columns.
// Works on the struct's Param list (field names + types).
fn inject_entity(stmts: list) -> list
    let entities = []
    let entity_tables = {}
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "type"
                    for an in anns
                        match an
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann" and av == "entity"
                                    push(entities, s)
                                    let tbl = _snake_case(name)
                                    entity_tables[name] = tbl
                                else if at == "ann_with_arg" and av == "entity"
                                    push(entities, s)
                                    if len(ac) > 0
                                        match ac[0]
                                            Expr(pt, pv, pn2, pc, pf, pl) =>
                                                entity_tables[name] = pv
    if len(entities) == 0
        return stmts
    let generated = []
    for e in entities
        match e
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                let tbl = entity_tables[name]
                let ln = sline
                let tbl_body = [Stmt("return", "", Expr("str", tbl, 0, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__table_name", null_expr(), tbl_body, [], [], [], ln))
                let pk_body = [Stmt("return", "", Expr("str", "id", 0, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__primary_key", null_expr(), pk_body, [], [], [], ln))
                let col_parts = []
                for p in params
                    match p
                        Param(pn, pt, pd) =>
                            push(col_parts, pn)
                let cols_str = ""
                let ci = 0
                while ci < len(col_parts)
                    if ci > 0
                        cols_str = cols_str + ", "
                    cols_str = cols_str + col_parts[ci]
                    ci = ci + 1
                let cols_body = [Stmt("return", "", Expr("str", cols_str, 0, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__columns", null_expr(), cols_body, [], [], [], ln))
    let out = []
    for s in stmts
        push(out, s)
    for g in generated
        push(out, g)
    out

fn inject_service(stmts: list) -> list
    let services = []
    let svc_names = {}
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "type"
                    for an in anns
                        match an
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann" and av == "service"
                                    push(services, s)
                                    svc_names[name] = _snake_case(name)
                                else if at == "ann_with_arg" and av == "service"
                                    push(services, s)
                                    if len(ac) > 0
                                        match ac[0]
                                            Expr(pt, pv, pn2, pc, pf, pl) =>
                                                svc_names[name] = pv
    if len(services) == 0
        return stmts
    let generated = []
    for sv in services
        match sv
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                let sn = svc_names[name]
                let ln = sline
                let nm_body = [Stmt("return", "", Expr("str", sn, 0, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__service_name", null_expr(), nm_body, [], [], [], ln))
                let is_body = [Stmt("return", "", Expr("int", "1", 1, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__is_service", null_expr(), is_body, [], [], [], ln))
                let dep_parts = []
                for p in params
                    match p
                        Param(pn, pt, pd) =>
                            push(dep_parts, pt)
                let deps_str = ""
                let di = 0
                while di < len(dep_parts)
                    if di > 0
                        deps_str = deps_str + ", "
                    deps_str = deps_str + dep_parts[di]
                    di = di + 1
                let deps_body = [Stmt("return", "", Expr("str", deps_str, 0, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__dependencies", null_expr(), deps_body, [], [], [], ln))
    let out = []
    for s in stmts
        push(out, s)
    for g in generated
        push(out, g)
    out

fn inject_deprecated(stmts: list) -> list
    let out = []
    for s in stmts
        let added = 0
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "fn"
                    for an in anns
                        match an
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann" and av == "deprecated" and added == 0
                                    let ln = sline
                                    let msg = "this function is deprecated"
                                    let warn_call = Stmt("expr", "", Expr("call", "deprecated_warn", 0, [Expr("str", name, 0, [], [], ln), Expr("str", msg, 0, [], [], ln)], [], ln), [], [], [], [], ln)
                                    let new_body = [warn_call]
                                    let bi = 0
                                    while bi < len(body)
                                        push(new_body, body[bi])
                                        bi = bi + 1
                                    push(out, Stmt(tag, name, expr, new_body, params, else_body, anns, sline))
                                    added = 1
                                else if at == "ann_with_arg" and av == "deprecated" and added == 0
                                    let ln = sline
                                    let msg = "this function is deprecated"
                                    if len(ac) > 0
                                        match ac[0]
                                            Expr(pt, pv, pn2, pc, pf, pl) =>
                                                msg = pv
                                    let warn_call = Stmt("expr", "", Expr("call", "deprecated_warn", 0, [Expr("str", name, 0, [], [], ln), Expr("str", msg, 0, [], [], ln)], [], ln), [], [], [], [], ln)
                                    let new_body = [warn_call]
                                    let bi = 0
                                    while bi < len(body)
                                        push(new_body, body[bi])
                                        bi = bi + 1
                                    push(out, Stmt(tag, name, expr, new_body, params, else_body, anns, sline))
                                    added = 1
        if added == 0
            push(out, s)
    out

fn inject_inject(stmts: list) -> list
    let injects = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "type"
                    for an in anns
                        match an
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann" and av == "inject"
                                    push(injects, s)
    if len(injects) == 0
        return stmts
    let generated = []
    for inj in injects
        match inj
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                let ln = sline
                let is_body = [Stmt("return", "", Expr("int", "1", 1, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__is_injectable", null_expr(), is_body, [], [], [], ln))
                let dep_parts = []
                for p in params
                    match p
                        Param(pn, pt, pd) =>
                            push(dep_parts, pn + ":" + pt)
                let deps_str = ""
                let di = 0
                while di < len(dep_parts)
                    if di > 0
                        deps_str = deps_str + ", "
                    deps_str = deps_str + dep_parts[di]
                    di = di + 1
                let deps_body = [Stmt("return", "", Expr("str", deps_str, 0, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__inject_deps", null_expr(), deps_body, [], [], [], ln))
                let nm_body = [Stmt("return", "", Expr("str", _snake_case(name), 0, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__inject_name", null_expr(), nm_body, [], [], [], ln))
    let out = []
    for s in stmts
        push(out, s)
    for g in generated
        push(out, g)
    out

fn inject_middleware(stmts: list) -> list
    let mws = []
    let mw_names = {}
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "fn"
                    for an in anns
                        match an
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann" and av == "middleware"
                                    push(mws, s)
                                    mw_names[name] = name
                                else if at == "ann_with_arg" and av == "middleware"
                                    push(mws, s)
                                    if len(ac) > 0
                                        match ac[0]
                                            Expr(pt, pv, pn2, pc, pf, pl) =>
                                                mw_names[name] = pv
    if len(mws) == 0
        return stmts
    let generated = []
    for mw in mws
        match mw
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                let mname = mw_names[name]
                let ln = sline
                let nm_body = [Stmt("return", "", Expr("str", mname, 0, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__middleware_name", null_expr(), nm_body, [], [], [], ln))
                let is_body = [Stmt("return", "", Expr("int", "1", 1, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__is_middleware", null_expr(), is_body, [], [], [], ln))
    let out = []
    for s in stmts
        push(out, s)
    for g in generated
        push(out, g)
    out

fn _ct_eval_expr(expr: any, env: dict, ct_fns: dict) -> any
    match expr
        Expr(tag, val, num, children, fields, ln) =>
            if tag == "str"
                return val
            if tag == "int"
                return num
            if tag == "ident"
                if contains(env, val) == true
                    return env[val]
                return 0
            if tag == "binop"
                let left = _ct_eval_expr(children[0], env, ct_fns)
                let right = _ct_eval_expr(children[1], env, ct_fns)
                if val == "+"
                    if type_of(left) == "string"
                        return left + right
                    let il = int(str(left))
                    let ir = int(str(right))
                    return il + ir
                if val == "-"
                    let sl = int(str(left))
                    let sr = int(str(right))
                    return sl - sr
                if val == "*"
                    let ml = int(str(left))
                    let mr = int(str(right))
                    return ml * mr
                if val == "/"
                    let dl = int(str(left))
                    let dr = int(str(right))
                    if dr != 0
                        return dl / dr
                    return 0
                if val == "=="
                    if str(left) == str(right)
                        return 1
                    return 0
                if val == "!="
                    if str(left) != str(right)
                        return 1
                    return 0
                if val == ">"
                    let gl = int(str(left))
                    let gr = int(str(right))
                    if gl > gr
                        return 1
                    return 0
                if val == "<"
                    let ll = int(str(left))
                    let lr = int(str(right))
                    if ll < lr
                        return 1
                    return 0
                if val == ">="
                    let gel = int(str(left))
                    let ger = int(str(right))
                    if gel >= ger
                        return 1
                    return 0
                if val == "<="
                    let lel = int(str(left))
                    let ler = int(str(right))
                    if lel <= ler
                        return 1
                    return 0
                if val == "and"
                    if left != 0 and right != 0
                        return 1
                    return 0
                if val == "or"
                    if left != 0 or right != 0
                        return 1
                    return 0
                return 0
            if tag == "unary" and val == "-"
                let operand = _ct_eval_expr(children[0], env, ct_fns)
                return 0 - int(str(operand))
            if tag == "unary" and val == "not"
                let operand = _ct_eval_expr(children[0], env, ct_fns)
                if operand == 0
                    return 1
                return 0
            if tag == "call"
                if val == "len"
                    if len(children) > 0
                        let larg = _ct_eval_expr(children[0], env, ct_fns)
                        if type_of(larg) == "string"
                            return len(larg)
                        return 0
                if val == "str"
                    if len(children) > 0
                        let sarg = _ct_eval_expr(children[0], env, ct_fns)
                        return str(sarg)
                    return ""
                if val == "contains"
                    if len(children) >= 2
                        let carg1 = _ct_eval_expr(children[0], env, ct_fns)
                        let carg2 = _ct_eval_expr(children[1], env, ct_fns)
                        if type_of(carg1) == "string" and type_of(carg2) == "string"
                            if contains(carg1, carg2) == true
                                return 1
                            return 0
                    return 0
                if val == "slice"
                    if len(children) >= 3
                        let slarg = _ct_eval_expr(children[0], env, ct_fns)
                        let slstart = int(str(_ct_eval_expr(children[1], env, ct_fns)))
                        let slend = int(str(_ct_eval_expr(children[2], env, ct_fns)))
                        if type_of(slarg) == "string"
                            return slice(slarg, slstart, slend)
                    return ""
                if val == "upper"
                    if len(children) > 0
                        let uarg = _ct_eval_expr(children[0], env, ct_fns)
                        if type_of(uarg) == "string"
                            return upper(uarg)
                    return ""
                if val == "lower"
                    if len(children) > 0
                        let larg2 = _ct_eval_expr(children[0], env, ct_fns)
                        if type_of(larg2) == "string"
                            return lower(larg2)
                    return ""
                if contains(ct_fns, val) == true
                    let ct_fn = ct_fns[val]
                    let fn_env = {}
                    match ct_fn
                        Stmt(ft, fn2, fe, fb, fp, feb, fa, fl) =>
                            let pi = 0
                            for p in fp
                                match p
                                    Param(pn, pt, pd) =>
                                        if pi < len(children)
                                            fn_env[pn] = _ct_eval_expr(children[pi], env, ct_fns)
                                        pi = pi + 1
                            return _ct_eval_body(fb, fn_env, ct_fns)
                return 0
    return 0

fn _ct_eval_body(body: list, env: dict, ct_fns: dict) -> any
    let _ct_sentinel = "__ct_no_return__"
    for s in body
        match s
            Stmt(tag, name, expr, sb, sp, seb, sa, sl) =>
                if tag == "assign"
                    if name != ""
                        env[name] = _ct_eval_expr(expr, env, ct_fns)
                    else if len(sa) > 0
                        match sa[0]
                            Expr(et, ev, en, ec, ef, el) =>
                                if et == "ident"
                                    env[ev] = _ct_eval_expr(expr, env, ct_fns)
                if tag == "return"
                    return _ct_eval_expr(expr, env, ct_fns)
                if tag == "if"
                    let cond = _ct_eval_expr(expr, env, ct_fns)
                    if cond != 0
                        let r = _ct_eval_body(sb, env, ct_fns)
                        if type_of(r) != "string" or r != _ct_sentinel
                            return r
                    else
                        if len(seb) > 0
                            let r2 = _ct_eval_body(seb, env, ct_fns)
                            if type_of(r2) != "string" or r2 != _ct_sentinel
                                return r2
                if tag == "while"
                    let _ct_iters = 0
                    while _ct_iters < 10000
                        let wc = _ct_eval_expr(expr, env, ct_fns)
                        if wc == 0
                            break
                        let wr = _ct_eval_body(sb, env, ct_fns)
                        if type_of(wr) != "string" or wr != _ct_sentinel
                            return wr
                        _ct_iters = _ct_iters + 1
                if tag == "expr"
                    _ct_eval_expr(expr, env, ct_fns)
    return _ct_sentinel

fn _ct_replace_expr(expr: any, ct_fns: dict) -> any
    match expr
        Expr(tag, val, num, children, fields, ln) =>
            if tag == "call" and contains(ct_fns, val) == true
                let env = {}
                let result = _ct_eval_expr(expr, env, ct_fns)
                if type_of(result) == "string" and result != "__ct_no_return__"
                    return Expr("str", result, 0, [], [], ln)
                if type_of(result) == "string" and result == "__ct_no_return__"
                    return Expr("int", "0", 0, [], [], ln)
                let int_str = str(result)
                return Expr("int", int_str, int(int_str), [], [], ln)
            if len(children) > 0
                let nc = []
                let ci = 0
                while ci < len(children)
                    push(nc, _ct_replace_expr(children[ci], ct_fns))
                    ci = ci + 1
                return Expr(tag, val, num, nc, fields, ln)
            return expr
    return expr

fn _ct_replace_in_stmt(s: any, ct_fns: dict) -> any
    match s
        Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
            let new_expr = _ct_replace_expr(expr, ct_fns)
            let new_body = []
            let bi = 0
            while bi < len(body)
                push(new_body, _ct_replace_in_stmt(body[bi], ct_fns))
                bi = bi + 1
            let new_else = []
            let ei = 0
            while ei < len(else_body)
                push(new_else, _ct_replace_in_stmt(else_body[ei], ct_fns))
                ei = ei + 1
            return Stmt(tag, name, new_expr, new_body, params, new_else, anns, sline)
    return s

fn inject_comptime(stmts: list) -> list
    let ct_fns = {}
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "fn"
                    for an in anns
                        match an
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann" and av == "comptime"
                                    ct_fns[name] = s
    if len(ct_fns) == 0
        return stmts
    let out = []
    for s in stmts
        let is_ct = 0
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "fn" and contains(ct_fns, name) == true
                    is_ct = 1
        if is_ct == 0
            push(out, _ct_replace_in_stmt(s, ct_fns))
    out

fn inject_validate(stmts: list) -> list
    let types = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "type"
                    for an in anns
                        match an
                            Expr(at, av, an2, ac, af, al) =>
                                if (at == "ann" or at == "ann_with_arg") and av == "validate"
                                    push(types, s)
    if len(types) == 0
        return stmts
    let generated = []
    for t in types
        match t
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                let ln = sline
                let is_body = [Stmt("return", "", Expr("int", "1", 1, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__has_validation", null_expr(), is_body, [], [], [], ln))
                let field_parts = []
                let ftype_parts = []
                for p in params
                    match p
                        Param(pn, pt, pd) =>
                            push(field_parts, pn)
                            push(ftype_parts, pn + ":" + pt)
                let fields_str = ""
                let fi = 0
                while fi < len(field_parts)
                    if fi > 0
                        fields_str = fields_str + ", "
                    fields_str = fields_str + ftype_parts[fi]
                    fi = fi + 1
                let vf_body = [Stmt("return", "", Expr("str", fields_str, 0, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__validate_fields", null_expr(), vf_body, [], [], [], ln))
                let ct_body = [Stmt("return", "", Expr("int", str(len(field_parts)), len(field_parts), [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__field_count", null_expr(), ct_body, [], [], [], ln))
    let out = []
    for s in stmts
        push(out, s)
    for g in generated
        push(out, g)
    out

fn inject_builder(stmts: list) -> list
    let types = []
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "type"
                    for an in anns
                        match an
                            Expr(at, av, an2, ac, af, al) =>
                                if (at == "ann" or at == "ann_with_arg") and av == "builder"
                                    push(types, s)
    if len(types) == 0
        return stmts
    let generated = []
    for t in types
        match t
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                let ln = sline
                let field_names = []
                let field_types = []
                for p in params
                    match p
                        Param(pn, pt, pd) =>
                            push(field_names, pn)
                            push(field_types, pt)
                let init_stmts = [Stmt("assign", "b", Expr("dict", "", 0, [], [], ln), [], [], [], [], ln)]
                let fi = 0
                while fi < len(field_names)
                    let key = Expr("str", field_names[fi], 0, [], [], ln)
                    let val = Expr("str", "", 0, [], [], ln)
                    let idx = Expr("index", "", 0, [Expr("ident", "b", 0, [], [], ln), key], [], ln)
                    push(init_stmts, Stmt("assign", "", val, [], [], [], [idx], ln))
                    fi = fi + 1
                push(init_stmts, Stmt("return", "", Expr("ident", "b", 0, [], [], ln), [], [], [], [], ln))
                push(generated, Stmt("fn", name + "__builder", null_expr(), init_stmts, [], [], [], ln))
                let si = 0
                while si < len(field_names)
                    let fname = field_names[si]
                    let set_params = [Param("b", "dict", null_expr()), Param("val", "any", null_expr())]
                    let set_key = Expr("str", fname, 0, [], [], ln)
                    let set_idx = Expr("index", "", 0, [Expr("ident", "b", 0, [], [], ln), set_key], [], ln)
                    let set_body = [Stmt("assign", "", Expr("ident", "val", 0, [], [], ln), [], [], [], [set_idx], ln), Stmt("return", "", Expr("ident", "b", 0, [], [], ln), [], [], [], [], ln)]
                    push(generated, Stmt("fn", name + "__set_" + fname, null_expr(), set_body, set_params, [], [], ln))
                    si = si + 1
                let build_params = [Param("b", "dict", null_expr())]
                let build_args = []
                let bi = 0
                while bi < len(field_names)
                    let bkey = Expr("str", field_names[bi], 0, [], [], ln)
                    push(build_args, Expr("index", "", 0, [Expr("ident", "b", 0, [], [], ln), bkey], [], ln))
                    bi = bi + 1
                let build_call = Expr("call", name, 0, build_args, [], ln)
                let build_body = [Stmt("return", "", build_call, [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__build", null_expr(), build_body, build_params, [], [], ln))
    let out = []
    for s in stmts
        push(out, s)
    for g in generated
        push(out, g)
    out

fn inject_log(stmts: list) -> list
    let out = []
    for s in stmts
        let added = 0
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "fn"
                    for an in anns
                        match an
                            Expr(at, av, an2, ac, af, al) =>
                                if (at == "ann" or at == "ann_with_arg") and av == "log" and added == 0
                                    let ln = sline
                                    let entry_call = Stmt("expr", "", Expr("call", "log_fn_entry", 0, [Expr("str", name, 0, [], [], ln)], [], ln), [], [], [], [], ln)
                                    let new_body = [entry_call]
                                    let bi = 0
                                    while bi < len(body)
                                        push(new_body, body[bi])
                                        bi = bi + 1
                                    push(out, Stmt(tag, name, expr, new_body, params, else_body, anns, sline))
                                    added = 1
        if added == 0
            push(out, s)
    out

fn inject_retry(stmts: list) -> list
    let fns = []
    let fn_counts = {}
    for s in stmts
        match s
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                if tag == "fn"
                    for an in anns
                        match an
                            Expr(at, av, an2, ac, af, al) =>
                                if at == "ann" and av == "retry"
                                    push(fns, s)
                                    fn_counts[name] = 3
                                else if at == "ann_with_arg" and av == "retry"
                                    push(fns, s)
                                    if len(ac) > 0
                                        match ac[0]
                                            Expr(pt, pv, pn2, pc, pf, pl) =>
                                                fn_counts[name] = int(pv)
    if len(fns) == 0
        return stmts
    let generated = []
    for f in fns
        match f
            Stmt(tag, name, expr, body, params, else_body, anns, sline) =>
                let ln = sline
                let count = fn_counts[name]
                let count_str = str(count)
                let mr_body = [Stmt("return", "", Expr("int", count_str, count, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__max_retries", null_expr(), mr_body, [], [], [], ln))
                let is_body = [Stmt("return", "", Expr("int", "1", 1, [], [], ln), [], [], [], [], ln)]
                push(generated, Stmt("fn", name + "__is_retryable", null_expr(), is_body, [], [], [], ln))
    let out = []
    for s in stmts
        push(out, s)
    for g in generated
        push(out, g)
    out

