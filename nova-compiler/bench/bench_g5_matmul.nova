// GATE 5 — G5-1: Matrix multiply 300x300
// Tests list indexing at scale. Inner loop does 27M multiply-adds.
// List IndexGet/IndexSet is fully inlined (GEP + load/store, no call).

fn make_mat(n, seed)
    m = []
    i = 0
    while i < n * n
        m.push(seed + i % 7)
        i = i + 1
    return m

fn mat_mul(a, b, n)
    c = []
    k = 0
    while k < n * n
        c.push(0)
        k = k + 1
    i = 0
    while i < n
        j = 0
        while j < n
            s = 0
            k = 0
            while k < n
                s = s + a[i * n + k] * b[k * n + j]
                k = k + 1
            c[i * n + j] = s
            j = j + 1
        i = i + 1
    return c

n = 300
a = make_mat(n, 1)
b = make_mat(n, 2)
c = mat_mul(a, b, n)

total = 0
i = 0
while i < n * n
    total = total + c[i]
    i = i + 1
print("Matmul 300x300 checksum: " + str(total))
