// HTTP client test — fetches a public API

// Test 1: Simple GET to a public JSON API
print("Fetching from httpbin.org...")
response = http_get("https://httpbin.org/get") catch e
    print("GET failed: " + e)
    ""

if len(response) > 0
    print("T1 GET response length: " + str(len(response)))
    print("T1 first 80 chars: " + response)
else
    print("T1 skipped (no network)")

// Test 2: POST with JSON body
print("Posting to httpbin.org...")
post_body = chr(123) + chr(34) + "msg" + chr(34) + ":" + chr(34) + "hello from NOVA" + chr(34) + chr(125)
post_resp = http_post("https://httpbin.org/post", post_body, "application/json") catch e
    print("POST failed: " + e)
    ""

if len(post_resp) > 0
    print("T2 POST response length: " + str(len(post_resp)))
else
    print("T2 skipped (no network)")

// Test 3: Invalid URL with error handling
bad_resp = http_get("https://this-domain-does-not-exist-xyz.invalid/api") catch e
    print("T3 caught: " + e)
    "error handled"

print("T3 result: " + bad_resp)

// Test 4: GET + JSON parse pipeline
print("Fetching IP info...")
ip_resp = http_get("https://httpbin.org/ip") catch e
    ""

if len(ip_resp) > 0
    ip_data = json_parse(ip_resp)
    origin = ip_data["origin"]
    print("T4 your IP: " + origin)
else
    print("T4 skipped (no network)")

print("HTTP tests complete!")
