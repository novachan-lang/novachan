// NOVA Full-Stack Demo: Real API client + JSON + File I/O + Error Handling
// One language. One file. Real network I/O. Zero dependencies.

print("=== NOVA Full-Stack Demo ===")
print("")

// === Part 1: Live API fetch + JSON processing ===
print("[1] Fetching from httpbin.org...")
resp = http_get("https://httpbin.org/get") catch e
    print("  Network error: " + e)
    ""

if len(resp) > 0
    data = json_parse(resp)
    origin = data["origin"]
    url_val = data["url"]
    print("  Origin IP: " + origin)
    print("  Request URL: " + url_val)
    print("  Response size: " + str(len(resp)) + " bytes")

    // Save response
    write_file("api_response.json", resp)
    print("  Saved to api_response.json")
else
    print("  Skipped (no network)")

print("")

// === Part 2: POST with JSON body ===
print("[2] Posting JSON data...")
q = chr(34)
lb = chr(123)
rb = chr(125)
body = lb + q + "language" + q + ":" + q + "NOVA" + q + "," + q + "version" + q + ":" + q + "0.6" + q + rb
post_resp = http_post("https://httpbin.org/post", body, "application/json") catch e
    print("  POST failed: " + e)
    ""

if len(post_resp) > 0
    print("  POST succeeded (" + str(len(post_resp)) + " bytes)")
    post_data = json_parse(post_resp)
    print("  Server echoed URL: " + post_data["url"])
else
    print("  Skipped (no network)")

print("")

// === Part 3: Error resilience ===
print("[3] Error handling demo...")
r1 = http_get("https://no-such-domain-xyz.invalid") catch e
    "caught: " + e
print("  Bad domain: " + r1)

r2 = read_file("nonexistent_file.dat") catch e
    "caught: " + e
print("  Missing file: " + r2)

r3 = json_parse("not valid json!") catch e
    "caught: " + e
print("  Bad JSON: " + r3)

print("")

// === Part 4: File pipeline ===
print("[4] File I/O pipeline...")
write_file("output.txt", "NOVA Full-Stack Demo Results\n")
append_file("output.txt", "============================\n")
append_file("output.txt", "API fetch: OK\n")
append_file("output.txt", "JSON parse: OK\n")
append_file("output.txt", "HTTP POST: OK\n")
append_file("output.txt", "Error handling: OK\n")
append_file("output.txt", "File I/O: OK\n")

contents = read_file("output.txt")
print(contents)

// Verify file exists
print("  output.txt exists: " + str(file_exists("output.txt")))
print("  phantom.txt exists: " + str(file_exists("phantom.txt")))

print("")
print("=== All systems operational ===")
print("NOVA: one language, zero dependencies, real programs.")
