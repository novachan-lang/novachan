// JSON edge case tests — adversarial inputs

// Test 1: empty object
e1 = json_parse(chr(123) + chr(125))
print("T1 empty obj: " + json_stringify(e1))

// Test 2: empty array
e2 = json_parse("[]")
print("T2 empty arr: " + json_stringify(e2))

// Test 3: nested arrays
e3 = json_parse("[[1,2],[3,4]]")
print("T3 nested: " + json_stringify(e3))

// Test 4: negative numbers
e4 = json_parse("[-1, -42, 0]")
print("T4 negative: " + json_stringify(e4))

// Test 5: invalid JSON with catch
r5 = json_parse("") catch e
    "err5: " + e
print("T5: " + r5)

// Test 6: truncated true
r6 = json_parse("tru") catch e
    "err6: " + e
print("T6: " + r6)

// Test 7: truncated false
r7 = json_parse("fal") catch e
    "err7: " + e
print("T7: " + r7)

// Test 8: just whitespace
r8 = json_parse("   ") catch e
    "err8: " + e
print("T8: " + r8)

// Test 9: deeply nested (should not crash)
deep = "[[[[[[[[[[1]]]]]]]]]]"
r9 = json_parse(deep)
print("T9 deep: " + json_stringify(r9))

// Test 10: string with escapes
q = chr(34)
bs = chr(92)
esc_json = q + "hello" + bs + "n" + "world" + q
r10 = json_parse(esc_json)
print("T10 escaped: " + r10)

print("Edge tests complete!")
