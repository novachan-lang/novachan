// Test value types / escape analysis
// Structs created and used locally should be stack-allocated (alloca, not malloc)
// This test verifies correctness — the performance benefit is that no malloc/free
// is needed for local-only structs.

type Point
    x: int
    y: int

type Color
    r: int
    g: int
    b: int

// Test 1: Simple local struct — should be stack-allocated
fn test_local_struct()
    p = Point{x: 10, y: 20}
    result = p.x + p.y
    print("Local struct: " + str(result))
    return result

// Test 2: Struct passed to function — must be heap-allocated (escapes)
fn sum_point(p)
    return p.x + p.y

fn test_escaped_struct()
    p = Point{x: 5, y: 15}
    result = sum_point(p)
    print("Escaped struct: " + str(result))
    return result

// Test 3: Multiple local structs
fn test_multiple_locals()
    a = Point{x: 1, y: 2}
    b = Point{x: 3, y: 4}
    result = a.x + a.y + b.x + b.y
    print("Multiple locals: " + str(result))
    return result

// Test 4: Struct field mutation (local)
fn test_field_mutation()
    p = Point{x: 0, y: 0}
    p.x = 42
    p.y = 58
    result = p.x + p.y
    print("Field mutation: " + str(result))
    return result

// Test 5: Nested struct access
fn test_color()
    c = Color{r: 255, g: 128, b: 64}
    total = c.r + c.g + c.b
    print("Color total: " + str(total))
    return total

// Test 6: Struct in a loop (create many, all local)
fn test_loop_structs()
    total = 0
    i = 0
    while i < 1000
        p = Point{x: i, y: i * 2}
        total = total + p.x + p.y
        i = i + 1
    print("Loop structs total: " + str(total))
    return total

// Test 7: Enum variant (uses MakeRecord internally)
enum Shape
    Circle(r: int)
    Rect(w: int, h: int)

fn area(s)
    match s
        Circle(r) => r * r * 3
        Rect(w, h) => w * h

fn test_enum_local()
    c = Circle{r: 10}
    a = area(c)
    print("Circle area: " + str(a))
    return a

// Run all tests
r1 = test_local_struct()
r2 = test_escaped_struct()
r3 = test_multiple_locals()
r4 = test_field_mutation()
r5 = test_color()
r6 = test_loop_structs()
r7 = test_enum_local()

// Verify results
ok = r1 == 30 and r2 == 20 and r3 == 10 and r4 == 100 and r5 == 447 and r6 == 1498500 and r7 == 300
if ok
    print("ALL VALUE TYPE TESTS PASSED")
else
    print("SOME TESTS FAILED")
