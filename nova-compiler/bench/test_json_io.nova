// Phase 6 Stdlib Test: JSON parsing + file I/O + error handling

// Build a JSON object string using chr() for braces and quotes
q = chr(34)
lb = chr(123)
rb = chr(125)

// {"name":"NOVA","version":1,"active":true}
json_str = lb + q + "name" + q + ":" + q + "NOVA" + q + "," + q + "version" + q + ":1," + q + "active" + q + ":true" + rb

// Test 1: write to file
write_file("test_output.json", json_str)
print("Test1: wrote JSON file")

// Test 2: read back
content = read_file("test_output.json")
print("Test2: " + content)

// Test 3: parse JSON
obj = json_parse(content)
print("Test3: parsed OK")

// Test 4: dict access
name = obj["name"]
print("Test4: name = " + name)

// Test 5: stringify
output = json_stringify(obj)
print("Test5: " + output)

// Test 6: read nonexistent file with catch
bad = read_file("ghost_file.txt") catch e
    "caught: " + e

print("Test6: " + bad)

// Test 7: invalid JSON with catch
broken_str = json_parse("xyz") catch e
    "err: " + e

print("Test7: " + broken_str)

// Test 8: file_exists
e1 = file_exists("test_output.json")
e2 = file_exists("nope.xyz")
print("Test8: " + str(e1) + " " + str(e2))

// Test 9: append
write_file("append_test.txt", "hello")
append_file("append_test.txt", " world")
result9 = read_file("append_test.txt")
print("Test9: " + result9)

// Test 10: JSON array
arr = json_parse("[10, 20, 30]")
print("Test10: len=" + str(len(arr)))

print("DONE")
