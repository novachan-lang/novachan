// GATE 5 — G5-3: Parallel prime counting via spawn + channel
// 4 workers each count primes in a 250K range, fan-in via channel.
// Proves: concurrency overhead is acceptable, workers run truly parallel.

fn is_prime(n)
    if n < 2
        return 0
    if n == 2
        return 1
    if n % 2 == 0
        return 0
    d = 3
    while d * d <= n
        if n % d == 0
            return 0
        d = d + 2
    return 1

fn count_range(lo, hi)
    count = 0
    n = lo
    while n <= hi
        if is_prime(n)
            count = count + 1
        n = n + 1
    return count

ch = channel()

spawn fn()
    send(ch, count_range(2, 250000))

spawn fn()
    send(ch, count_range(250001, 500000))

spawn fn()
    send(ch, count_range(500001, 750000))

spawn fn()
    send(ch, count_range(750001, 1000000))

total = receive(ch) + receive(ch) + receive(ch) + receive(ch)
print("Primes 1-1000000 (parallel): " + str(total))
