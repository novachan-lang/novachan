// Test error handling: try / catch / else

fn safe_divide(a, b)
    if b == 0
        error("division by zero")
    else
        a / b

fn parse_positive(n)
    if n < 0
        error("negative number")
    else
        n * 2

fn do_work(a, b)
    result = try safe_divide(a, b)
    result + 100

// Test 1: else error-default (already worked before)
result1 = safe_divide(10, 0) else -1
print("Test1 else: " + str(result1))

// Test 2: catch with message binding — error path
result2 = safe_divide(10, 0) catch e
    print("Test2 caught: " + e)
    -2

print("Test2 result: " + str(result2))

// Test 3: catch — success path (handler should NOT run)
result3 = safe_divide(10, 2) catch e
    print("SHOULD NOT SEE THIS: " + e)
    -3

print("Test3 success: " + str(result3))

// Test 4: try propagation — success path
work_ok = do_work(20, 4) else -1
print("Test4 ok: " + str(work_ok))

// Test 5: try propagation — error propagated to caller
work_err = do_work(20, 0) else -1
print("Test5 propagated error: " + str(work_err))

// Test 6: catch with string interpolation
result6 = parse_positive(-5) catch e
    print("Test6 caught: {e}")
    0

print("Test6 result: " + str(result6))
