// Test reference counting: verify mid-program memory reclamation
// With RC, live object count should stabilize because temporaries
// created inside functions are freed when the function returns.

fn make_temp_strings(n)
    i = 0
    while i < n
        s = "hello" + str(i) + " world" + str(i * 2)
        i = i + 1
    return n

fn make_temp_lists(n)
    i = 0
    while i < n
        lst = [i, i+1, i+2, i+3, i+4]
        i = i + 1
    return n

// The key metric: live object count (objects not yet freed by RC)
before = nova_rt_live_count()
print("Live objects before: " + str(before))

make_temp_strings(1000)
after1 = nova_rt_live_count()
print("Live after 1000 string ops: " + str(after1))

make_temp_strings(1000)
after2 = nova_rt_live_count()
print("Live after 2000 string ops: " + str(after2))

make_temp_lists(500)
after3 = nova_rt_live_count()
print("Live after list ops: " + str(after3))

make_temp_lists(500)
after4 = nova_rt_live_count()
print("Live after more list ops: " + str(after4))

// Check that RC is working: the growth should slow or stabilize
// compared to running without any reclamation
total_allocs = nova_rt_alloc_count()
print("Total historical allocations: " + str(total_allocs))
print("Live objects at end: " + str(after4))

// With RC, live count should be much less than total allocations
reclaim_rate = total_allocs - after4
print("Objects reclaimed by RC: " + str(reclaim_rate))

if reclaim_rate > 0
    print("RC TEST PASSED - " + str(reclaim_rate) + " objects freed mid-program")
else
    print("RC TEST FAILED - no objects reclaimed")
