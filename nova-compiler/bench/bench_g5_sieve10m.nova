// GATE 5 — G5-2: Sieve of Eratosthenes at 10M
// Scale check: GATE 4 showed 2.5% overhead at 1M. Does it hold at 10M?

fn count_primes(limit)
    sieve = []
    idx = 0
    while idx <= limit
        sieve.push(0)
        idx = idx + 1
    count = 0
    i = 2
    while i <= limit
        if sieve[i] == 0
            count = count + 1
            j = i * i
            while j <= limit
                sieve[j] = 1
                j = j + i
        i = i + 1
    return count

result = count_primes(10000000)
print("Primes up to 10M: " + str(result))
