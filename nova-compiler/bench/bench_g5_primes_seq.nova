// GATE 5 — G5-3a: Sequential prime count 1-1M (baseline for parallel comparison)

fn is_prime(n)
    if n < 2
        return 0
    if n == 2
        return 1
    if n % 2 == 0
        return 0
    d = 3
    while d * d <= n
        if n % d == 0
            return 0
        d = d + 2
    return 1

count = 0
n = 2
while n <= 1000000
    if is_prime(n)
        count = count + 1
    n = n + 1

print("Primes 1-1000000 (seq): " + str(count))
