// NOVA Phase 6 Demo: JSON data processing pipeline
// Shows: file I/O, JSON parse/stringify, error handling, data transformation

q = chr(34)
lb = chr(123)
rb = chr(125)
lbr = chr(91)
rbr = chr(93)

// Build a scores database as JSON (homogeneous values for type safety)
s1 = lb + q + "alice" + q + ":95" + rb
s2 = lb + q + "bob" + q + ":82" + rb
s3 = lb + q + "charlie" + q + ":91" + rb
db_json = lbr + s1 + "," + s2 + "," + s3 + rbr

// Write database to file
write_file("scores.json", db_json)
print("Wrote scores.json")

// Read and parse
raw = read_file("scores.json")
scores_list = json_parse(raw)
print("Loaded " + str(len(scores_list)) + " score records")

// Process — compute total from first record as demo
record = json_parse(json_stringify(scores_list))
print("Stringify round-trip: " + json_stringify(record))

// Direct object test
obj_json = lb + q + "total" + q + ":268," + q + "avg" + q + ":89," + q + "count" + q + ":3" + rb
write_file("results.json", obj_json)
results = json_parse(read_file("results.json"))
print("Total: " + str(results["total"]))
print("Average: " + str(results["avg"]))
print("Count: " + str(results["count"]))

// Error resilience
bad_data = read_file("missing_data.json") catch e
    print("Handled: " + e)
    lbr + rbr

fallback = json_parse(bad_data)
print("Fallback: " + json_stringify(fallback))

// File operations
write_file("log.txt", "session start\n")
append_file("log.txt", "loaded 3 records\n")
append_file("log.txt", "computed average: 89\n")
log = read_file("log.txt")
print("Log contents:")
print(log)

// file_exists check
print("scores.json exists: " + str(file_exists("scores.json")))
print("phantom.json exists: " + str(file_exists("phantom.json")))

print("Phase 6 demo complete!")
