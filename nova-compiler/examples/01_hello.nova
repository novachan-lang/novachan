// NOVA: Hello World and basics
// Shows: zero-ceremony syntax, type inference, string interpolation

fn double(n: int) -> int
    return n * 2

fn factorial(n: int) -> int
    if n <= 1
        return 1
    return n * factorial(n - 1)

fn main()
    let name = "NOVA"
    let version = 1
    print("Hello from " + name + " v" + str(version) + "!")

    let x = 42
    let greeting = "The answer is " + str(x)
    print(greeting)

    let languages = ["C", "Rust", "Go", "NOVA"]
    let scores = {"speed": 10, "safety": 10, "simplicity": 10}
    print("Languages: " + str(len(languages)))
    print("NOVA speed score: " + str(scores["speed"]))

    print("double(21) = " + str(double(21)))
    print("factorial(10) = " + str(factorial(10)))

    for lang in languages
        print("  - " + lang)
