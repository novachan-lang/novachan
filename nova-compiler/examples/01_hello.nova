// NOVA: Hello World and basics
// Shows: zero-ceremony syntax, type inference, string interpolation, float math

fn double(n: int) -> int
    return n * 2

fn factorial(n: int) -> int
    if n <= 1
        return 1
    return n * factorial(n - 1)

fn main()
    let name = "NOVA"
    let version = 1
    print("Hello from {name} v{version}!")

    let x = 42
    let pi = 3.14159
    print("The answer is {x} and pi is {pi}")
    print("pi * 2 = {pi * 2}")
    print("pi + 1 = {pi + 1}")

    let languages = ["C", "Rust", "Go", "NOVA"]
    let scores = {"speed": 10, "safety": 10, "simplicity": 10}
    print("Languages: {len(languages)}")
    print("NOVA speed score: {scores["speed"]}")

    print("double(21) = {double(21)}")
    print("factorial(10) = {factorial(10)}")

    for lang in languages
        print("  - {lang}")
