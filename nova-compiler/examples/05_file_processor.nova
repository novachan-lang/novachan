// NOVA: File Processing Tool
// Shows: file I/O, directory walking, string processing

fn count_lines(content: string) -> int
    let count = 1
    for ch in content
        if ch == "\n"
            count = count + 1
    return count

fn file_extension(path: string) -> string
    let parts = split(path, ".")
    if len(parts) > 1
        return parts[len(parts) - 1]
    return ""

fn main()
    let files = dir_walk(".")
    let n_files = len(files)
    print("Scanning current directory (" + str(n_files) + " entries)")

    let ext_counts = {}
    let nova_files = []

    for path in files
        let ext = file_extension(path)
        if ext != ""
            if contains(ext_counts, ext)
                ext_counts[ext] = ext_counts[ext] + 1
            else
                ext_counts[ext] = 1
            if ext == "nova"
                push(nova_files, path)

    let exts = keys(ext_counts)
    print("File types found: " + str(len(exts)))
    for ext in exts
        print("  ." + ext + ": " + str(ext_counts[ext]) + " files")

    print("")
    let n_nova = len(nova_files)
    print("NOVA source files: " + str(n_nova))
    let total_lines = 0
    let read_count = 0
    for f in nova_files
        if read_count < 20
            if file_exists(f)
                let content = read_file(f)
                let lines = count_lines(content)
                total_lines = total_lines + lines
                read_count = read_count + 1

    print("Lines in first " + str(read_count) + " files: " + str(total_lines))
    print("Content hash: " + slice(sha256(str(total_lines)), 0, 16))
