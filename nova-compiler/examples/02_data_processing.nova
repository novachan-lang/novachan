// NOVA: Data Processing Pipeline
// Shows: type definitions, pattern matching, higher-order functions

type User
    name: String
    age: Int
    role: String

fn categorize(user)
    match user.role
        "admin" => "full-access"
        "editor" => "write-access"
        _ => "read-only"

fn main()
    let users = [User { name: "Alice", age: 30, role: "admin" }, User { name: "Bob", age: 17, role: "viewer" }, User { name: "Charlie", age: 25, role: "editor" }, User { name: "Diana", age: 16, role: "viewer" }, User { name: "Eve", age: 35, role: "admin" }]

    let adults = filter(users, fn(u) u.age >= 18)
    print("Adults: " + str(len(adults)) + " / " + str(len(users)))

    for user in adults
        let access = categorize(user)
        print("  " + user.name + " (" + str(user.age) + "): " + access)

    let total_age = 0
    for u in users
        total_age = total_age + u.age
    let avg = total_age / len(users)
    print("Average age: " + str(avg))

    let data = {"users": len(users), "adults": len(adults), "avg_age": avg}
    let json = json_stringify(data)
    print("JSON: " + json)
