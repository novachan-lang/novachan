// NOVA: Cryptographic Token Generation
// Shows: SHA-256, HMAC-SHA256, base64, hex encoding, UUID

fn make_json_header() -> string
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)
    let h = lb + q + "alg" + q + ":" + q + "HS256" + q + rb
    return base64_encode(h)

fn make_json_payload(user_id: string) -> string
    let q = chr(34)
    let lb = chr(123)
    let rb = chr(125)
    let now = datetime_timestamp()
    let p = lb + q + "sub" + q + ":" + q + user_id + q + "," + q + "iat" + q + ":" + str(now) + rb
    return base64_encode(p)

fn create_token(user_id: string, secret: string) -> string
    let header = make_json_header()
    let payload = make_json_payload(user_id)
    let signing_input = header + "." + payload
    let signature = hmac_sha256(secret, signing_input)
    return signing_input + "." + signature

fn verify_token(token: string, secret: string) -> bool
    let parts = split(token, ".")
    if len(parts) != 3
        return false
    let signing_input = parts[0] + "." + parts[1]
    let expected_sig = hmac_sha256(secret, signing_input)
    return parts[2] == expected_sig

fn main()
    let secret = "nova-secret-key-2026"
    let users = ["alice", "bob", "charlie"]
    let tokens = []

    for user in users
        let token = create_token(user, secret)
        push(tokens, token)
        print("Token for " + user + ": " + slice(token, 0, 40) + "...")
        print("  fingerprint: " + slice(sha256(token), 0, 16))

    print("")
    for i in range(len(users))
        let valid = verify_token(tokens[i], secret)
        print(users[i] + " valid: " + str(valid))

    let tampered = tokens[0] + "x"
    print("tampered valid: " + str(verify_token(tampered, secret)))

    print("")
    print("Request IDs:")
    for i in range(3)
        print("  " + uuid4())
