// NOVA: Concurrency with Processes and Channels
// Shows: spawn, channel, send, receive, parallel computation

fn fib(n: int) -> int
    if n <= 1
        return n
    return fib(n - 1) + fib(n - 2)

fn main()
    let ch = channel()
    let n_workers = 4

    // Spawn workers that compute fibonacci in parallel
    let i = 0
    while i < n_workers
        let n = 25 + i
        spawn fn()
            let result = fib(n)
            send(ch, result)
        i = i + 1

    // Collect results from all workers
    let total = 0
    let count = 0
    while count < n_workers
        let result = receive(ch)
        print("  fib result: " + str(result))
        total = total + result
        count = count + 1

    print("Sum of fib values: " + str(total))
    print("Workers: " + str(n_workers))
    print("CONCURRENCY PASSED")
