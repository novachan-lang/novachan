// map() over a NAMED fn returning float now BOXES the results, so the result list
// renders/serializes as floats instead of raw IEEE bits shown as giant ints. (An
// untyped anonymous lambda whose body isn't statically float is a separate, broader
// value-model residual — the widen-boxing overhaul — tracked, not this fix.)

fn scale(x: float) -> float
    x * 1.5

fn main()
    let xs = [2.0, 4.0, 6.0]
    let ys = map(xs, scale)
    // values are correct either way (arithmetic reads the raw bits fine)
    assert_near(ys[0], 3.0, 0.0001)
    assert_near(ys[1], 6.0, 0.0001)
    assert_near(ys[2], 9.0, 0.0001)
    // and the list now RENDERS as floats (previously [4613937818241073152, ...])
    assert_eq(str(ys), "[3.0, 6.0, 9.0]")
    print("mapfbox passed")
