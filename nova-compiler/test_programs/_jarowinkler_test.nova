// KAT test for std/text/jarowinkler
// Published reference values from Jaro (1989) and Winkler (1990).
import std/text/jarowinkler

// ckf: assert float within eps; prints FAIL and exits(1) on mismatch.
fn ckf(label, got, expected, eps)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// cki: assert integer equality.
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// ── KAT 1: jw_jaro("MARTHA","MARHTA") == 0.944444 ──────────────────────────
let r1 = jw_jaro("MARTHA", "MARHTA")
ckf("jaro_martha_marhta", r1, 0.944444, 0.001)

// ── KAT 2: jw_winkler("MARTHA","MARHTA") == 0.961111 ───────────────────────
let r2 = jw_winkler("MARTHA", "MARHTA")
ckf("winkler_martha_marhta", r2, 0.961111, 0.001)

// ── KAT 3: jw_jaro("DWAYNE","DUANE") == 0.822222 ───────────────────────────
let r3 = jw_jaro("DWAYNE", "DUANE")
ckf("jaro_dwayne_duane", r3, 0.822222, 0.001)

// ── KAT 4: jw_winkler("DWAYNE","DUANE") == 0.840000 ────────────────────────
let r4 = jw_winkler("DWAYNE", "DUANE")
ckf("winkler_dwayne_duane", r4, 0.840000, 0.001)

// ── KAT 5: jw_jaro("DIXON","DICKSONX") == 0.766667 ─────────────────────────
let r5 = jw_jaro("DIXON", "DICKSONX")
ckf("jaro_dixon_dicksonx", r5, 0.766667, 0.001)

// ── KAT 6: jw_winkler("DIXON","DICKSONX") == 0.813333 ──────────────────────
let r6 = jw_winkler("DIXON", "DICKSONX")
ckf("winkler_dixon_dicksonx", r6, 0.813333, 0.001)

// ── KAT 7: identical strings -> 1.0 ─────────────────────────────────────────
let r7 = jw_jaro("abc", "abc")
ckf("jaro_identical", r7, 1.0, 0.001)

// ── KAT 8: completely different short strings -> 0.0 ────────────────────────
let r8 = jw_jaro("abc", "xyz")
ckf("jaro_no_match", r8, 0.0, 0.001)

// ── KAT 9: both empty -> 1.0 ────────────────────────────────────────────────
let r9 = jw_jaro("", "")
ckf("jaro_both_empty", r9, 1.0, 0.001)

// ── KAT 10: one empty -> 0.0 ────────────────────────────────────────────────
let r10 = jw_jaro("hello", "")
ckf("jaro_one_empty", r10, 0.0, 0.001)

// ── KAT 11: winkler both empty -> 1.0 ───────────────────────────────────────
let r11 = jw_winkler("", "")
ckf("winkler_both_empty", r11, 1.0, 0.001)

// ── KAT 12: winkler identical -> 1.0 ────────────────────────────────────────
let r12 = jw_winkler("hello", "hello")
ckf("winkler_identical", r12, 1.0, 0.001)

print("_jarowinkler_test passed")
