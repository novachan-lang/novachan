import forge_align
fn main()
    for p in [["GATTACA","GCATGCU"],["","" ],["abc",""],["","abc"],["same","same"],["a","b"],["kitten","sitting"],["AAAA","AA"]]
        let r = align_global(p[0], p[1], 1, 0 - 1, 0 - 1)
        print("[" + p[0] + "|" + p[1] + "] score=" + str(r[0]) + " a=" + r[1] + " b=" + r[2])
        print("   score_only=" + str(align_score(p[0], p[1], 1, 0 - 1, 0 - 1)))
    // different scoring schemes must still work
    print(str(align_global("GATTACA", "GCATGCU", 2, 0 - 3, 0 - 2)))
    print(str(align_global("abc", "abc", 5, 0 - 1, 0 - 10)))
    print("EXERCISE-DONE")
