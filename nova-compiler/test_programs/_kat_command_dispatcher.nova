import forge_command_dispatcher

fn main()
    let s = cd_new()
    assert(cd_device_count(s) == 0, "0 devices")

    s = cd_register(s, "d1")
    assert(cd_device_count(s) == 1, "1 device")

    let p0 = cd_pending(s, "d1")
    assert(is_ok(p0), "pending ok")
    assert(unwrap(p0) == 0, "0 pending initially")

    let sr1 = cd_send(s, "d1", "reboot", "")
    assert(is_ok(sr1), "send1 ok")
    let id1 = unwrap(sr1)
    assert(id1 == "cmd1", "id1 cmd1")

    let sr2 = cd_send(s, "d1", "update", "v2")
    assert(is_ok(sr2), "send2 ok")
    let id2 = unwrap(sr2)
    assert(id2 == "cmd2", "id2 cmd2")

    let p1 = cd_pending(s, "d1")
    assert(unwrap(p1) == 2, "2 pending")

    let n1 = cd_next(s, "d1")
    assert(is_ok(n1), "next1 ok")
    assert(unwrap(n1) == "cmd1|reboot|", "next1 content")

    let a1 = cd_ack(s, "d1", "cmd1")
    assert(is_ok(a1), "ack1 ok")

    let p2 = cd_pending(s, "d1")
    assert(unwrap(p2) == 1, "1 pending after ack1")

    let n2 = cd_next(s, "d1")
    assert(is_ok(n2), "next2 ok")
    assert(unwrap(n2) == "cmd2|update|v2", "next2 content")

    let n3 = cd_next(s, "d1")
    assert(is_err(n3), "no more pending commands")

    let a2 = cd_ack(s, "d1", "cmd2")
    assert(is_ok(a2), "ack2 ok")

    let p3 = cd_pending(s, "d1")
    assert(unwrap(p3) == 0, "0 pending after ack2")

    assert(cd_total_sent(s) == 2, "2 total sent")
    assert(cd_total_acked(s) == 2, "2 total acked")
    assert(cd_device_count(s) == 1, "still 1 device")

    let sbad = cd_send(s, "d2", "reboot", "")
    assert(is_err(sbad), "unregistered device send err")

    let abad = cd_ack(s, "d1", "cmd99")
    assert(is_err(abad), "unknown command ack err")

    let adouble = cd_ack(s, "d1", "cmd1")
    assert(is_err(adouble), "double ack err")

    print("COMMAND-DISPATCHER KAT PASS")
