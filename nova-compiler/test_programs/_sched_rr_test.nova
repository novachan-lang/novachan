import std/scheduling/sched_rr

fn cki(name: string, got: int, want: int)
    if got != want
        print("FAIL sched_rr " + name + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(name: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL sched_rr " + name + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL sched_rr " + name + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: canonical RR example — arrive 0, bursts 24,3,3, q=4
    // Hand-trace:
    //  t=0-4:   P0 runs 4 (rem=20). Queue after: new-arrivals(none) then P0 re-queued -> [P1,P2,P0]
    //  t=4-7:   P1 runs 3 (done, comp=7). Queue: [P2,P0]
    //  t=7-10:  P2 runs 3 (done, comp=10). Queue: [P0]
    //  t=10-30: P0 runs in 4-unit slices: 14,18,22,26,30 (done, comp=30)
    // completions = [30,7,10], waiting = [6,4,7]
    let p1 = [[0,24],[0,3],[0,3]]
    let ct1 = rr_completion_times(p1, 4)
    let wt1_want = []
    push(wt1_want, 6)
    push(wt1_want, 4)
    push(wt1_want, 7)
    let ct1_want = []
    push(ct1_want, 30)
    push(ct1_want, 7)
    push(ct1_want, 10)
    ckl("completion_times q=4", ct1, ct1_want)
    let wt1 = rr_waiting_times(p1, 4)
    ckl("waiting_times q=4", wt1, wt1_want)

    // KAT 2: single process — should complete immediately, waiting=0
    let p2 = [[0,5]]
    let ct2 = rr_completion_times(p2, 3)
    cki("single proc completion", ct2[0], 5)
    let wt2 = rr_waiting_times(p2, 3)
    cki("single proc waiting", wt2[0], 0)

    // KAT 3: quantum >= burst — behaves like FCFS, no preemption
    // All arrive 0, bursts 3,2,1, q=10
    // Order: P0 (burst=3, comp=3), P1 (burst=2, comp=5), P2 (burst=1, comp=6)
    let p3 = [[0,3],[0,2],[0,1]]
    let ct3 = rr_completion_times(p3, 10)
    cki("fcfs-like ct[0]", ct3[0], 3)
    cki("fcfs-like ct[1]", ct3[1], 5)
    cki("fcfs-like ct[2]", ct3[2], 6)

    // KAT 4: staggered arrivals — P0 arrives 0, P1 arrives 5
    // burst 4,4, q=3
    // t=0: queue=[P0]. P0 runs 0-3 (rem=1). At t=3 no new arrivals. Queue=[P0]
    // t=3-4: P0 runs 1 (rem=0, comp=4). Queue empty. t=4.
    // t=4: no one, advance to P1 arrival=5. t=5. Queue=[P1].
    // t=5-8: P1 runs 3 (rem=1). Queue=[P1].
    // t=8-9: P1 runs 1 (comp=9). done.
    let p4 = [[0,4],[5,4]]
    let ct4 = rr_completion_times(p4, 3)
    cki("staggered ct[0]", ct4[0], 4)
    cki("staggered ct[1]", ct4[1], 9)
    let wt4 = rr_waiting_times(p4, 3)
    cki("staggered wt[0]", wt4[0], 0)
    cki("staggered wt[1]", wt4[1], 0)

    // KAT 5: context switches for canonical example (p1, q=4)
    // switches: P0->P1=1, P1->P2=2, P2->P0=3. Total=3
    let sw = rr_context_switches(p1, 4)
    cki("context_switches", sw, 3)

    // KAT 6: single process, no switches (never changes)
    let sw2 = rr_context_switches(p2, 3)
    cki("single_proc_switches", sw2, 0)

    print("PASS _sched_rr_test")
