import forge_pohlig as ph

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

fn powmod(base: int, exp: int, m: int) -> int
    let r = 1 % m
    let b = ((base % m) + m) % m
    let e = exp
    while e > 0
        if e % 2 == 1
            r = (r * b) % m
        b = (b * b) % m
        e = e / 2
    return r

// TEST 1: factor_order
let f12 = ph.factor_order(12)
// 12 = 2^2 * 3
check(len(f12) == 2, "factor 12 has 2 prime factors")
check(f12[0][0] == 2 and f12[0][1] == 2, "12: 2^2")
check(f12[1][0] == 3 and f12[1][1] == 1, "12: 3^1")

let f100 = ph.factor_order(100)
// 100 = 2^2 * 5^2
check(f100[0][0] == 2 and f100[0][1] == 2, "100: 2^2")
check(f100[1][0] == 5 and f100[1][1] == 2, "100: 5^2")

// TEST 2: Small discrete log. p=1019 (prime), g=2. Find x with 2^x = h mod 1019.
// p-1 = 1018 = 2 * 509. 509 is prime, so smooth-ish. Let's use a fully smooth prime.
// Use p = 31 (p-1 = 30 = 2*3*5, very smooth). g=3 is a primitive root mod 31.
let p1 = 31
let g1 = 3
// Pick x=17, compute h = 3^17 mod 31
let h1 = powmod(g1, 17, p1)
let x1 = ph.discrete_log_smooth(g1, h1, p1)
check(powmod(g1, x1, p1) == h1, "solve 3^x=h mod 31 verifies")
check(x1 == 17, "3^17 discrete log = 17")

// TEST 3: p=101 (p-1=100=2^2*5^2, smooth). g=2 is a primitive root mod 101.
let p2 = 101
let g2 = 2
let x2_true = 47
let h2 = powmod(g2, x2_true, p2)
let x2 = ph.discrete_log_smooth(g2, h2, p2)
check(powmod(g2, x2, p2) == h2, "solve 2^x=h mod 101 verifies")
check(x2 == x2_true, "2^47 discrete log = 47")

// TEST 4: p=1009 (p-1 = 1008 = 2^4 * 3^2 * 7, very smooth). g=11 is a primitive root.
let p3 = 1009
let g3 = 11
let x3_true = 500
let h3 = powmod(g3, x3_true, p3)
let x3 = ph.discrete_log_smooth(g3, h3, p3)
check(powmod(g3, x3, p3) == h3, "solve 11^x=h mod 1009 verifies")
check(x3 == x3_true, "11^500 discrete log = 500")

// TEST 5: h = 1 -> x = 0
let x_one = ph.discrete_log_smooth(g3, 1, p3)
check(x_one == 0, "discrete log of 1 = 0")

// TEST 6: h = g -> x = 1
let x_g = ph.discrete_log_smooth(g3, g3, p3)
check(x_g == 1, "discrete log of g = 1")

// TEST 7: DECISIVE cross-check: for prime p=101, generator g=2, solve for ALL exponents 0..99
// and verify that g^(result) == g^(exponent) mod p (result is a valid log)
let ok = true
let e = 0
while e < 100
    let target = powmod(2, e, 101)
    let got = ph.discrete_log_smooth(2, target, 101)
    if got < 0
        ok = false
        print("no solution for e=" + str(e))
    else
        if powmod(2, got, 101) != target
            ok = false
            print("wrong log e=" + str(e) + " got=" + str(got))
    e = e + 1
check(ok, "Pohlig-Hellman solves ALL exponents 0..99 mod 101")

// TEST 8: Another prime p=1013 (p-1 = 1012 = 2^2 * 11 * 23). g=3.
// Verify a few
let p4 = 1013
let g4 = 3
let ok4 = true
let ee = 0
while ee < 50
    let tgt = powmod(g4, ee * 20, p4)
    let got4 = ph.discrete_log_smooth(g4, tgt, p4)
    if got4 < 0
        ok4 = false
    else
        if powmod(g4, got4, p4) != tgt
            ok4 = false
            print("p4 wrong at ee=" + str(ee))
    ee = ee + 1
check(ok4, "Pohlig-Hellman mod 1013 verifies sampled exponents")

// TEST 9: explicit pohlig_hellman with provided factors
let facts = ph.factor_order(100)
let x9 = ph.pohlig_hellman(2, powmod(2, 33, 101), 101, facts)
check(x9 == 33, "explicit pohlig_hellman with factors gives 33")

print("forge_pohlig: KAT done")
