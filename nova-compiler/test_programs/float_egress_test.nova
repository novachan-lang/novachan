// #13 S0 corruption oracle: push float-array elements through EVERY egress sink where
// a float value can leak to an `any` context. This MUST pass today (the conservative
// any-typed path is sound) and is the guard that any future floatlist promotion (S2)
// cannot reintroduce the 2026-06-20 corruption (stats median / geox haversine: raw
// IEEE-754 bits read as a box pointer at call-arg / comparison / index_set sinks).

type FPair
    a: float
    b: float

fn take_any(v)
    v

fn main()
    // a push-built float array — the exact case S2 promotion would target
    let fl = []
    push(fl, 1.5)
    push(fl, 2.5)
    push(fl, 3.5)

    // sink 1: call-argument bound to an any/val parameter (the 06-20 corruptor)
    let a = take_any(fl[0])
    assert(a == 1.5, "call-arg any param preserves float")

    // sink 2: cross-block comparison
    if fl[1] > 2.0
        assert(fl[1] == 2.5, "comparison-true branch sees correct float")
    else
        assert(1 == 0, "comparison took the wrong branch (corruption)")

    // sink 3: index_set of the value into a plain (any) list
    let xs = []
    push(xs, 0)
    xs[0] = fl[2]
    assert(xs[0] == 3.5, "index_set into any list preserves float")

    // sink 4: struct field store
    let p = FPair { a: fl[0], b: fl[1] }
    assert(p.a == 1.5, "struct field a preserves float")
    assert(p.b == 2.5, "struct field b preserves float")

    // sink 5: dict value store (any container)
    let d = {}
    d["k"] = fl[1]
    assert(d["k"] == 2.5, "dict value preserves float")

    // sink 6: native arithmetic then escape through an any parameter
    let s = fl[0] + fl[1] + fl[2]
    assert(s == 7.5, "float-array arithmetic = 7.5")
    let b = take_any(s)
    assert(b == 7.5, "arithmetic result through any param preserved")

    // sink 7: stringify must not corrupt the underlying value
    let str0 = str(fl[0])
    assert(fl[0] == 1.5, "value intact after str()")
    assert(len(str0) > 0, "str of float non-empty")

    // sink 8: return-through-any round trip in a list of mixed origin
    let mix = []
    push(mix, take_any(fl[0]))
    push(mix, take_any(fl[2]))
    assert(mix[0] == 1.5, "mixed list elem 0")
    assert(mix[1] == 3.5, "mixed list elem 1")

    print("float_egress_test: all passed")
