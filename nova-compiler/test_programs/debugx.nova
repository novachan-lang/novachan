/// debugx.nova — NOVA interactive debugger module
/// Provides instrumentation-based debugging with breakpoints, stepping,
/// variable inspection, and call stack display.
///
/// Usage:
///   dbg_set_bp("file.nova", 42)   — set breakpoint at file:line
///   dbg_enable()                   — enable step-mode (stop at every hook)
///   dbg_hook("file.nova", 10, locals) — check breakpoints, stop if triggered
///   dbg_push_frame("fn_name", "file.nova", 10, locals) — push call frame
///   dbg_pop_frame()                — pop call frame
///   dbg_backtrace()                — get call stack as list of [fn,file,line]
///
/// When stopped, interactive commands:
///   c/continue  s/step  n/next  o/out  bt  locals  p <name>  bp <line>  q

fn _dbg_capture_locals(names, values)
    let d = {}
    let i = 0
    while i < len(names) and i < len(values)
        d[names[i]] = values[i]
        i = i + 1
    d

fn dbg_trace_fn(name, file, line, local_names, local_values)
    let locals = _dbg_capture_locals(local_names, local_values)
    dbg_push_frame(name, file, line, locals)
    dbg_hook(file, line, locals)

fn dbg_trace_line(file, line, local_names, local_values)
    let locals = _dbg_capture_locals(local_names, local_values)
    dbg_hook(file, line, locals)

fn dbg_trace_return()
    dbg_pop_frame()

fn dbg_print_bt()
    let frames = dbg_backtrace()
    for f in frames
        print("  #" + str(f[2]) + "  " + str(f[0]) + " (" + str(f[1]) + ":" + str(f[2]) + ")")

fn dbg_print_bps()
    let bps = dbg_list_bps()
    if len(bps) == 0
        print("  (no breakpoints)")
    else
        for bp in bps
            print("  [" + str(bp[0]) + "] " + str(bp[1]) + ":" + str(bp[2]))

fn test_dbg_infrastructure()
    let id = dbg_set_bp("test.nova", 10)
    assert(id >= 0, "set bp returns id")
    let bps = dbg_list_bps()
    assert(len(bps) == 1, "one bp set")
    assert(bps[0][2] == 10, "bp at line 10")
    dbg_remove_bp(id)
    let bps2 = dbg_list_bps()
    assert(len(bps2) == 0, "bp removed")
    print("  breakpoint set/remove: PASS")

fn test_dbg_frames()
    dbg_push_frame("main", "test.nova", 1, {})
    dbg_push_frame("helper", "test.nova", 10, {})
    let bt = dbg_backtrace()
    assert(len(bt) == 2, "two frames: " + str(len(bt)))
    assert(str(bt[0][0]) == "helper", "top frame is helper")
    assert(str(bt[1][0]) == "main", "bottom frame is main")
    dbg_pop_frame()
    let bt2 = dbg_backtrace()
    assert(len(bt2) == 1, "one frame after pop")
    dbg_pop_frame()
    print("  frame push/pop/bt: PASS")

fn test_dbg_hook_no_bp()
    let r = dbg_hook("test.nova", 5, {})
    assert(r == 0, "hook returns 0 when no bp set and not stepping")
    print("  hook skips when inactive: PASS")

fn test_dbg_locals_capture()
    let locals = _dbg_capture_locals(["x", "y", "name"], [42, 3.14, "hello"])
    assert(locals["x"] == 42, "x=42")
    assert(locals["name"] == "hello", "name=hello")
    assert(len(keys(locals)) == 3, "3 locals captured")
    print("  locals capture: PASS")

fn main()
    test_dbg_infrastructure()
    test_dbg_frames()
    test_dbg_hook_no_bp()
    test_dbg_locals_capture()
    print("debugx: all passed")
