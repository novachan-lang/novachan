// _solutions_test.nova — KAT for std/chem/solutions
//
// Known answers:
//   molarity(2.0, 1.0)          = 2.0 mol/L
//   molality(2.0, 0.5)          = 4.0 mol/kg
//   dilution_c2(6.0, 1.0, 3.0) = 2.0 mol/L
//   mass_percent(10.0, 100.0)   = 10.0 %
//   ppm(0.001, 1.0)             = 1000.0 ppm

import std/chem/solutions

fn approx(a, b, tol)
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad > tol
        print("FAIL approx: got " + str(a) + " expected " + str(b) + " tol " + str(tol))
        exit(1)
    return 0

fn main()
    // KAT 1: molarity(2.0, 1.0) = 2.0
    let v1 = molarity(2.0, 1.0)
    approx(v1, 2.0, 0.001)

    // KAT 2: molality(2.0, 0.5) = 4.0
    let v2 = molality(2.0, 0.5)
    approx(v2, 4.0, 0.001)

    // KAT 3: dilution_c2(6.0, 1.0, 3.0) = 2.0
    let v3 = dilution_c2(6.0, 1.0, 3.0)
    approx(v3, 2.0, 0.001)

    // KAT 4: mass_percent(10.0, 100.0) = 10.0
    let v4 = mass_percent(10.0, 100.0)
    approx(v4, 10.0, 0.001)

    // KAT 5: ppm(0.001, 1.0) = 0.001 / 1.0 * 1e6 = 1000.0
    let v5 = ppm(0.001, 1.0)
    approx(v5, 1000.0, 0.01)

    // KAT 6: dilution_c2(6.0, 1.0, 3.0) = 2.0 (canonical from spec)
    let v6 = dilution_c2(6.0, 1.0, 3.0)
    approx(v6, 2.0, 0.001)

    // KAT 7: mass_percent(10.0, 100.0) = 10.0 (canonical from spec)
    let v7 = mass_percent(10.0, 100.0)
    approx(v7, 10.0, 0.001)

    print("PASS _solutions_test")
