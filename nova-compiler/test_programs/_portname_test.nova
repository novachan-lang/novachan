import std/net/portname

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // pn_service KATs (spec-required)
    cks("svc(22)",   pn_service(22),   "ssh")
    cks("svc(80)",   pn_service(80),   "http")
    cks("svc(443)",  pn_service(443),  "https")
    cks("svc(5432)", pn_service(5432), "postgresql")
    cks("svc(6379)", pn_service(6379), "redis")
    cks("svc(9999)", pn_service(9999), "")

    // pn_service — full coverage
    cks("svc(20)",    pn_service(20),    "ftp-data")
    cks("svc(21)",    pn_service(21),    "ftp")
    cks("svc(23)",    pn_service(23),    "telnet")
    cks("svc(25)",    pn_service(25),    "smtp")
    cks("svc(53)",    pn_service(53),    "dns")
    cks("svc(110)",   pn_service(110),   "pop3")
    cks("svc(143)",   pn_service(143),   "imap")
    cks("svc(993)",   pn_service(993),   "imaps")
    cks("svc(995)",   pn_service(995),   "pop3s")
    cks("svc(3306)",  pn_service(3306),  "mysql")
    cks("svc(8080)",  pn_service(8080),  "http-alt")
    cks("svc(27017)", pn_service(27017), "mongodb")
    cks("svc(0)",     pn_service(0),     "")
    cks("svc(-1)",    pn_service(-1),    "")

    // pn_port KATs (spec-required)
    cki("port(ssh)",     pn_port("ssh"),     22)
    cki("port(https)",   pn_port("https"),   443)
    cki("port(unknown)", pn_port("unknown"), -1)

    // pn_port — full coverage
    cki("port(ftp-data)",    pn_port("ftp-data"),    20)
    cki("port(ftp)",         pn_port("ftp"),         21)
    cki("port(telnet)",      pn_port("telnet"),      23)
    cki("port(smtp)",        pn_port("smtp"),        25)
    cki("port(dns)",         pn_port("dns"),         53)
    cki("port(http)",        pn_port("http"),        80)
    cki("port(pop3)",        pn_port("pop3"),        110)
    cki("port(imap)",        pn_port("imap"),        143)
    cki("port(imaps)",       pn_port("imaps"),       993)
    cki("port(pop3s)",       pn_port("pop3s"),       995)
    cki("port(mysql)",       pn_port("mysql"),       3306)
    cki("port(postgresql)",  pn_port("postgresql"),  5432)
    cki("port(redis)",       pn_port("redis"),       6379)
    cki("port(http-alt)",    pn_port("http-alt"),    8080)
    cki("port(mongodb)",     pn_port("mongodb"),     27017)
    cki("port()",            pn_port(""),            -1)

    print("_portname_test passed")
