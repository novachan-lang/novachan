import std/statistics/stat_shape

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let xs = [1, 2, 3, 4, 5]
    ckf("skewness_sym", ssh_skewness(xs), 0.0)
    ckf("kurtosis_12345", ssh_kurtosis(xs), 1.7)
    ckf("excess_kurtosis_12345", ssh_excess_kurtosis(xs), -1.3)
    let rs = [1, 1, 1, 10]
    ckf("skewness_right", ssh_skewness(rs), 1.1547)
    let cv = [2, 2, 2]
    ckf("skewness_const", ssh_skewness(cv), 0.0)
    let em = []
    ckf("skewness_empty", ssh_skewness(em), 0.0)
    ckf("kurtosis_empty", ssh_kurtosis(em), 0.0)
    ckf("excess_kurtosis_empty", ssh_excess_kurtosis(em), 0.0)
    let si = [5]
    ckf("skewness_single", ssh_skewness(si), 0.0)
    print("PASS _stat_shape_test")
