// KAT for std/text/md_image
import std/text/md_image

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL md_image " + label + ": got [" + got + "]")
        exit(1)

fn main()
    let q = chr(34)

    // Basic: ![cat](c.png) -> <img src="c.png" alt="cat">
    cks("basic", md_image("![cat](c.png)"), "<img src=" + q + "c.png" + q + " alt=" + q + "cat" + q + ">")

    // Empty alt
    cks("empty_alt", md_image("![](logo.svg)"), "<img src=" + q + "logo.svg" + q + " alt=" + q + "" + q + ">")

    // Text without an image is returned unchanged
    cks("no_image", md_image("just some text"), "just some text")

    // Image embedded in text
    cks("inline", md_image("See ![icon](icon.png) here"), "See <img src=" + q + "icon.png" + q + " alt=" + q + "icon" + q + "> here")

    // Empty src
    cks("empty_src", md_image("![]()"), "<img src=" + q + "" + q + " alt=" + q + "" + q + ">")

    // md_image_all replaces multiple
    let s2 = "![a](a.png) and ![b](b.png)"
    let want2 = "<img src=" + q + "a.png" + q + " alt=" + q + "a" + q + "> and <img src=" + q + "b.png" + q + " alt=" + q + "b" + q + ">"
    cks("all_two", md_image_all(s2), want2)

    // md_image only replaces first
    let s3 = "![a](a.png) ![b](b.png)"
    let want3 = "<img src=" + q + "a.png" + q + " alt=" + q + "a" + q + "> ![b](b.png)"
    cks("first_only", md_image(s3), want3)

    print("PASS _md_image_test")
