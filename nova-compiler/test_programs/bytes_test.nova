// Byte array test

// Create a byte array of 10 bytes (all zeros)
buf = bytes(10)
assert(bytes_len(buf) == 10, "initial size 10")
assert(bytes_get(buf, 0) == 0, "initial zero")

// Set some values
bytes_set(buf, 0, 72)
bytes_set(buf, 1, 101)
bytes_set(buf, 2, 108)
bytes_set(buf, 3, 108)
bytes_set(buf, 4, 111)

assert(bytes_get(buf, 0) == 72, "H = 72")
assert(bytes_get(buf, 4) == 111, "o = 111")

// Convert to string
text = bytes_to_str(bytes_slice(buf, 0, 5))
assert(text == "Hello", "bytes to str")

// String to bytes
data = str_to_bytes("NOVA")
assert(bytes_len(data) == 4, "str_to_bytes len")
assert(bytes_get(data, 0) == 78, "N = 78")
assert(bytes_get(data, 1) == 79, "O = 79")
assert(bytes_get(data, 2) == 86, "V = 86")
assert(bytes_get(data, 3) == 65, "A = 65")

// Slice
sub = bytes_slice(data, 1, 3)
assert(bytes_len(sub) == 2, "slice len")
assert(bytes_to_str(sub) == "OV", "slice content")

// Overflow protection (byte is 0-255)
bytes_set(buf, 5, 256)
assert(bytes_get(buf, 5) == 0, "overflow wraps to 0")

bytes_set(buf, 6, 300)
assert(bytes_get(buf, 6) == 44, "300 & 0xFF = 44")

print("BYTES: ALL PASSED")
