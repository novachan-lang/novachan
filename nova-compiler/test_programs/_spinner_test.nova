import std/term/spinner

fn assert_eq_str(got, want, label)
    if got == want
        let _ok = 1
    else
        print("FAIL spinner " + label + ": got=" + got + " want=" + want)
        exit(1)

fn assert_eq_int(got, want, label)
    if got == want
        let _ok = 1
    else
        print("FAIL spinner " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- line spinner frame-by-frame ---
    assert_eq_str(spinner_at("line", 0), "|", "line[0]")
    assert_eq_str(spinner_at("line", 1), "/", "line[1]")
    assert_eq_str(spinner_at("line", 2), "-", "line[2]")
    assert_eq_str(spinner_at("line", 3), chr(92), "line[3]")

    // --- wrap: index 4 == index 0 ---
    assert_eq_str(spinner_at("line", 4), "|", "line[4 wraps to 0]")

    // --- count ---
    assert_eq_int(spinner_count("line"), 4, "line count")

    // --- arrow is non-empty ---
    let af = spinner_frames("arrow")
    let ac = len(af)
    if ac < 1
        print("FAIL spinner arrow frames non-empty: got=" + str(ac))
        exit(1)

    // --- dots is non-empty ---
    let df = spinner_frames("dots")
    let dc = len(df)
    if dc < 1
        print("FAIL spinner dots frames non-empty: got=" + str(dc))
        exit(1)

    // --- bounce is non-empty ---
    let bf = spinner_frames("bounce")
    let bc = len(bf)
    if bc < 1
        print("FAIL spinner bounce frames non-empty: got=" + str(bc))
        exit(1)

    // --- unknown style falls back gracefully (non-empty) ---
    let uf = spinner_frames("unknown_xyz")
    let uc = len(uf)
    if uc < 1
        print("FAIL spinner unknown fallback: got empty list")
        exit(1)

    // --- spinner_count matches len(spinner_frames) for each style ---
    assert_eq_int(spinner_count("dots"),   dc, "dots count consistency")
    assert_eq_int(spinner_count("arrow"),  ac, "arrow count consistency")
    assert_eq_int(spinner_count("bounce"), bc, "bounce count consistency")

    // --- arrow frame wrap ---
    let a0 = spinner_at("arrow", 0)
    let aw = spinner_at("arrow", ac)
    assert_eq_str(aw, a0, "arrow wrap")

    // --- verify backslash is exactly 1 char ---
    let bs = chr(92)
    assert_eq_int(len(bs), 1, "backslash len")
    assert_eq_str(spinner_at("line", 3), bs, "line[3] == backslash")

    print("PASS _spinner_test")
