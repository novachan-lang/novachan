// KAT test for std/os/glob.nova — REAL filesystem globbing (list_dir + is_dir composition).
// Named `_osglob_test` (not `_glob_test`) because `_glob_test.nova` already exists and covers a
// DIFFERENT module (std/parsing/glob.nova — pure-string glob_match/brace_expand). This test targets
// std/os/glob.nova (the `glob(pattern) -> list<string>` filesystem walker).
//
// LIMITATION DISCOVERED (documented in glob.nova's own header, and reconfirmed here empirically):
// glob() does NOT support absolute patterns. `_glob_walk` always starts from base="" (-> "."), and
// glob() splits the WHOLE pattern on "/" including a leading drive letter, so an absolute pattern like
// "C:/Users/.../*.txt" gets treated as segment "C:" matched as a WILDCARD against entries of the
// CURRENT directory (never matches) — this was verified by an earlier version of this test that used
// an absolute base path and got count=0 on every query. This is not a bug in glob.nova; it is the
// documented, current limitation ("Absolute patterns ... are not yet supported — a follow-on").
// So this test uses a RELATIVE path instead (relative to CWD), which is what glob() actually supports.
// It is still deterministic and self-contained: `_run1.ps1` always sets CWD to test_programs/ before
// running the exe, the tree is built fresh under a basename not used by any other test
// (`_osglob_kat_tree`, distinct from `_glob_probe.nova`'s `_globtree`), and it is torn down before AND
// after the run so re-running the test is idempotent.
import std/os/glob

fn _has(xs: any, x: string) -> bool
    for e in xs
        if e == x
            return true
    return false

fn _fail_count(name: string, got: int, want: int)
    print("FAIL " + name + ": got count=" + str(got) + " want=" + str(want))
    exit(1)

fn _fail_member(name: string, path: string)
    print("FAIL " + name + ": missing expected path " + path)
    exit(1)

fn main()
    let base = "_osglob_kat_tree"

    // Best-effort teardown of any stale tree from a previous run.
    remove_file(base + "/a.txt")
    remove_file(base + "/b.txt")
    remove_file(base + "/sub/c.txt")
    remove_dir(base + "/sub")
    remove_dir(base)

    // Build a small real tree: 2 top-level .txt files + 1 nested one under sub/.
    make_dir(base)
    make_dir(base + "/sub")
    write_file(base + "/a.txt", "hello")
    write_file(base + "/b.txt", "world")
    write_file(base + "/sub/c.txt", "nested")

    // glob("<base>/*.txt") -> the 2 TOP-LEVEL files only (sub/c.txt must NOT appear — `*` does not
    // cross a path segment boundary).
    let top = glob(base + "/*.txt")
    if len(top) != 2
        _fail_count("glob top *.txt", len(top), 2)
    if not _has(top, base + "/a.txt")
        _fail_member("glob top *.txt", base + "/a.txt")
    if not _has(top, base + "/b.txt")
        _fail_member("glob top *.txt", base + "/b.txt")
    if _has(top, base + "/sub/c.txt")
        print("FAIL glob top *.txt: sub/c.txt leaked into non-recursive match")
        exit(1)

    // glob("<base>/**/*.txt") -> ALL 3 files, at every depth (0-segment and 1-segment via `**`).
    let deep = glob(base + "/**/*.txt")
    if len(deep) != 3
        _fail_count("glob **/*.txt", len(deep), 3)
    if not _has(deep, base + "/a.txt")
        _fail_member("glob **/*.txt", base + "/a.txt")
    if not _has(deep, base + "/b.txt")
        _fail_member("glob **/*.txt", base + "/b.txt")
    if not _has(deep, base + "/sub/c.txt")
        _fail_member("glob **/*.txt", base + "/sub/c.txt")

    // glob of a path that does not exist on disk -> empty list, no crash (list_dir on a missing dir
    // returns [] rather than erroring — glob composes that safely).
    let missing = glob(base + "/does_not_exist_dir/*.txt")
    if len(missing) != 0
        _fail_count("glob missing dir -> empty", len(missing), 0)

    // Cleanup so the test is idempotent on re-run.
    remove_file(base + "/a.txt")
    remove_file(base + "/b.txt")
    remove_file(base + "/sub/c.txt")
    remove_dir(base + "/sub")
    remove_dir(base)

    print("PASS _osglob_test")
