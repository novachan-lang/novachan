import std/util/snowflake

fn cki(got: int, exp: int, label: str)
    if got != exp
        print("FAIL " + label + ": got " + str(got) + " expected " + str(exp))
        exit(1)

fn main()
    // KAT 1: basic round-trip — timestamp=1000, machine=5, sequence=7
    let id1 = sf_make(1000, 5, 7)
    cki(sf_timestamp(id1), 1000, "sf_timestamp(id1)==1000")
    cki(sf_machine(id1), 5, "sf_machine(id1)==5")
    cki(sf_sequence(id1), 7, "sf_sequence(id1)==7")

    // KAT 2: zero id
    let id_zero = sf_make(0, 0, 0)
    cki(id_zero, 0, "sf_make(0,0,0)==0")

    // KAT 3: max sequence
    let id_maxseq = sf_make(0, 0, 4095)
    cki(sf_sequence(id_maxseq), 4095, "sf_sequence(max_seq)==4095")

    // KAT 4: max machine
    let id_maxmc = sf_make(0, 1023, 0)
    cki(sf_machine(id_maxmc), 1023, "sf_machine(max_mc)==1023")

    // KAT 5: ordering — sf_make(2,0,0) > sf_make(1,1023,4095)
    let id_high = sf_make(2, 0, 0)
    let id_low = sf_make(1, 1023, 4095)
    if id_high <= id_low
        print("FAIL ordering: sf_make(2,0,0) should be > sf_make(1,1023,4095)")
        exit(1)

    // KAT 6: sf_decode round-trip
    let id2 = sf_make(999999, 512, 2048)
    let dec = sf_decode(id2)
    let dec_ts = dec["timestamp"]
    let dec_mc = dec["machine"]
    let dec_sq = dec["sequence"]
    cki(dec_ts, 999999, "decode_ts==999999")
    cki(dec_mc, 512, "decode_mc==512")
    cki(dec_sq, 2048, "decode_sq==2048")

    // KAT 7: known absolute value — sf_make(1,0,0) = 1 * 4194304
    cki(sf_make(1, 0, 0), 4194304, "sf_make(1,0,0)==4194304")

    // KAT 8: machine bits don't bleed into timestamp field
    let id3 = sf_make(0, 1023, 4095)
    cki(sf_timestamp(id3), 0, "ts_of_all_low_bits==0")

    print("_snowflake_test passed")
