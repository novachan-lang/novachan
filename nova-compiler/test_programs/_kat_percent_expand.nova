// KAT for std/encoding/percent (expanded API) — pct_encode_component,
// pct_encode_path, pct_encode_query, pct_decode, pct_encode_form,
// pct_decode_form. Round-trips for paths, queries, form data, Unicode,
// and edge cases (empty, already-encoded, double-encode).
import std/encoding/percent

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn main()
    // ── pct_encode_component ────────────────────────────────────────────
    cks("component-basic", pct_encode_component("hello world"), "hello%20world")
    cks("component-reserved", pct_encode_component("a/b?c=d"), "a%2Fb%3Fc%3Dd")
    cks("component-unreserved", pct_encode_component("abc-._~XYZ019"), "abc-._~XYZ019")
    cks("component-empty", pct_encode_component(""), "")
    cks("component-plus", pct_encode_component("a+b"), "a%2Bb")

    // ── pct_encode_path (preserves '/') ─────────────────────────────────
    cks("path-basic", pct_encode_path("/a/b c/d"), "/a/b%20c/d")
    cks("path-reserved", pct_encode_path("a/b?c"), "a/b%3Fc")
    cks("path-empty", pct_encode_path(""), "")
    cks("path-only-slashes", pct_encode_path("///"), "///")

    // ── pct_encode_query (preserves '&' and '=') ────────────────────────
    cks("query-basic", pct_encode_query("q=hello world&lang=en"), "q=hello%20world&lang=en")
    cks("query-slash", pct_encode_query("a=b/c"), "a=b%2Fc")
    cks("query-empty", pct_encode_query(""), "")
    cks("query-multi-amp", pct_encode_query("a=1&b=2&c=3"), "a=1&b=2&c=3")

    // ── pct_decode ───────────────────────────────────────────────────────
    cks("decode-basic", pct_decode("hello%20world"), "hello world")
    cks("decode-reserved", pct_decode("a%2Fb%3Fc%3Dd"), "a/b?c=d")
    cks("decode-percent-literal", pct_decode("100%25"), "100%")
    cks("decode-plain", pct_decode("already-plain"), "already-plain")
    cks("decode-lowercase-hex", pct_decode("%2f%3f"), "/?")
    cks("decode-empty", pct_decode(""), "")
    cks("decode-plus-not-space", pct_decode("a+b"), "a+b")
    cks("decode-lone-percent", pct_decode("100% off"), "100% off")
    cks("decode-malformed-tail", pct_decode("abc%2"), "abc%2")
    cks("decode-malformed-nonhex", pct_decode("abc%zz"), "abc%zz")

    // ── pct_encode_form / pct_decode_form ───────────────────────────────
    cks("form-space", pct_encode_form("hello world"), "hello+world")
    cks("form-plus-escaped", pct_encode_form("a+b"), "a%2Bb")
    cks("form-reserved", pct_encode_form("q=1&r=2"), "q%3D1%26r%3D2")
    cks("form-decode-space", pct_decode_form("hello+world"), "hello world")
    cks("form-decode-plus", pct_decode_form("a%2Bb"), "a+b")
    cks("form-decode-reserved", pct_decode_form("q%3D1%26r%3D2"), "q=1&r=2")
    cks("form-empty-enc", pct_encode_form(""), "")
    cks("form-empty-dec", pct_decode_form(""), "")

    // ── Round-trips ──────────────────────────────────────────────────────
    // Path round-trip
    let p = "/users/john doe/profile?tab=info"
    cks("roundtrip-path", pct_decode(pct_encode_path(p)), p)

    // Query round-trip
    let q = "name=John Doe&city=New York&note=100% sure"
    cks("roundtrip-query", pct_decode(pct_encode_query(q)), q)

    // Component round-trip with reserved chars
    let c = "a/b?c=d&e f#g"
    cks("roundtrip-component", pct_decode(pct_encode_component(c)), c)

    // Form round-trip
    let f = "first name=Jane & last=Smith+Jones"
    cks("roundtrip-form", pct_decode_form(pct_encode_form(f)), f)

    // Unicode round-trip (multi-byte UTF-8 characters get byte-encoded)
    let u = "héllo wörld — café 中文"
    cks("roundtrip-unicode-component", pct_decode(pct_encode_component(u)), u)
    cks("roundtrip-unicode-form", pct_decode_form(pct_encode_form(u)), u)

    // Double-encode is stable to decode-once (decoding an encoded '%' just
    // yields a literal '%', which is exactly what pct_encode_component
    // produced for the original '%' byte — so decode(encode(x)) always
    // recovers x, even when x itself already contains percent-escapes).
    let already = "100%25off"
    let enc_once = pct_encode_component(already)
    cks("double-encode-percent-escaped", enc_once, "100%2525off")
    cks("double-encode-decode-once", pct_decode(enc_once), already)
    cks("double-encode-decode-twice", pct_decode(pct_decode(enc_once)), "100%off")

    // Original percent_encode/percent_decode (bytes side) still work —
    // confirms the expansion did not disturb the existing API.
    let raw = bytes(0)
    raw = bytes_append(raw, 0)
    raw = bytes_append(raw, 255)
    raw = bytes_append(raw, 65)
    let enc = percent_encode(raw)
    cks("legacy-bytes-encode", enc, "%00%FFA")
    let dec = percent_decode(enc)
    if bytes_len(dec) != 3
        print("FAIL legacy-bytes-decode-len: got " + str(bytes_len(dec)))
        exit(1)
    if bytes_get(dec, 0) != 0 or bytes_get(dec, 1) != 255 or bytes_get(dec, 2) != 65
        print("FAIL legacy-bytes-decode-content")
        exit(1)

    print("PERCENT KAT PASS")
