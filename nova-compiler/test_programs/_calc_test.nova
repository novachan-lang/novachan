import std/parsing/calc

fn main()
    // KAT vectors from spec
    let v1 = calc("2+3*4")
    if v1 == 14
        print("ok calc 2+3*4")
    else
        print("FAIL calc 2+3*4: got "+str(v1)+" want 14")
        exit(1)

    let v2 = calc("(2+3)*4")
    if v2 == 20
        print("ok calc (2+3)*4")
    else
        print("FAIL calc (2+3)*4: got "+str(v2)+" want 20")
        exit(1)

    let v3 = calc("2^10")
    if v3 == 1024
        print("ok calc 2^10")
    else
        print("FAIL calc 2^10: got "+str(v3)+" want 1024")
        exit(1)

    let v4 = calc("-5+3")
    if v4 == -2
        print("ok calc -5+3")
    else
        print("FAIL calc -5+3: got "+str(v4)+" want -2")
        exit(1)

    let v5 = calc("17%5")
    if v5 == 2
        print("ok calc 17%5")
    else
        print("FAIL calc 17%5: got "+str(v5)+" want 2")
        exit(1)

    let v6 = calc("100/7")
    if v6 == 14
        print("ok calc 100/7")
    else
        print("FAIL calc 100/7: got "+str(v6)+" want 14")
        exit(1)

    // Right-associative power: 2^3^2 = 2^(3^2) = 2^9 = 512
    let v7 = calc("2^3^2")
    if v7 == 512
        print("ok calc 2^3^2")
    else
        print("FAIL calc 2^3^2: got "+str(v7)+" want 512")
        exit(1)

    let v8 = calc("((1+2)*(3+4))")
    if v8 == 21
        print("ok calc ((1+2)*(3+4))")
    else
        print("FAIL calc ((1+2)*(3+4)): got "+str(v8)+" want 21")
        exit(1)

    // calc_ok on invalid expression
    let ok1 = calc_ok("2+")
    if ok1 == false
        print("ok calc_ok 2+ false")
    else
        print("FAIL calc_ok 2+: got true want false")
        exit(1)

    // calc_ok on valid expression
    let ok2 = calc_ok("2+3")
    if ok2 == true
        print("ok calc_ok 2+3 true")
    else
        print("FAIL calc_ok 2+3: got false want true")
        exit(1)

    // Additional robustness: empty string
    let v9 = calc("")
    if v9 == 0
        print("ok calc empty->0")
    else
        print("FAIL calc empty: got "+str(v9)+" want 0")
        exit(1)

    let ok3 = calc_ok("")
    if ok3 == false
        print("ok calc_ok empty false")
    else
        print("FAIL calc_ok empty: got true want false")
        exit(1)

    // Malformed: unmatched paren
    let v10 = calc("(2+3")
    if v10 == 0
        print("ok calc unmatched paren->0")
    else
        print("FAIL calc unmatched paren: got "+str(v10)+" want 0")
        exit(1)

    // Whitespace handling
    let v11 = calc("3 + 4 * 2")
    if v11 == 11
        print("ok calc whitespace")
    else
        print("FAIL calc whitespace: got "+str(v11)+" want 11")
        exit(1)

    // Division by zero -> error (0)
    let v12 = calc("10/0")
    if v12 == 0
        print("ok calc div-by-zero->0")
    else
        print("FAIL calc div-by-zero: got "+str(v12)+" want 0")
        exit(1)

    // Unary minus chained
    let v13 = calc("--5")
    if v13 == 5
        print("ok calc double unary minus")
    else
        print("FAIL calc double unary minus: got "+str(v13)+" want 5")
        exit(1)

    // Unknown character
    let ok4 = calc_ok("2@3")
    if ok4 == false
        print("ok calc_ok unknown char false")
    else
        print("FAIL calc_ok unknown char: got true want false")
        exit(1)

    print("PASS _calc_test")
