import forge_cosine

fn ap(a: float, b: float) -> string
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < 0.0001
        return "ok"
    "FAIL(" + str(a) + ")"

fn main()
    // identical -> 1.0
    print("identical=" + ap(cosine_similarity(["a", "b", "c"], ["a", "b", "c"]), 1.0))
    // orthogonal (no shared terms) -> 0.0
    print("orthogonal=" + ap(cosine_similarity(["a", "b"], ["c", "d"]), 0.0))
    // partial overlap: {a,b} vs {a,c} -> 1/2 = 0.5
    print("half=" + ap(cosine_similarity(["a", "b"], ["a", "c"]), 0.5))
    // repeated terms: {a:2,b:1} vs {a:1,b:2} -> 4/5 = 0.8
    print("weighted=" + ap(cosine_similarity(["a", "a", "b"], ["a", "b", "b"]), 0.8))
    // length-independent: doc vs itself doubled -> still 1.0
    print("scale=" + ap(cosine_similarity(["a", "b"], ["a", "a", "b", "b"]), 1.0))
    // empty -> 0.0
    print("empty=" + ap(cosine_similarity([], ["a"]), 0.0))
