// KAT: named arguments must reorder to the DECLARED parameter order.
// The IR lowering always reordered, but the TYPE CHECKER compared positionally, so an
// out-of-order call was rejected whenever the swapped params had different types.
// Same-typed params type-checked and ran correctly, which hid the gap.
fn mk(host: string, port: int, secure: bool) -> string
    host + ":" + str(port) + (if secure "/s" else "/p")

fn sub(a: int, b: int) -> int
    a - b

fn main()
    let ok = 0
    let fail = 0

    if mk(host: "a.com", port: 80, secure: true) == "a.com:80/s"
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL in-order named args")

    // out of order AND differently typed -- this used to be a bogus type error
    if mk(port: 443, host: "b.org", secure: false) == "b.org:443/p"
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL out-of-order named args with differing types")

    // same-typed swap: must bind by NAME, not position
    if sub(b: 3, a: 10) == 7
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL same-typed named swap bound positionally")

    // mixing a positional arg with trailing named args
    if mk("c.net", port: 8080, secure: true) == "c.net:8080/s"
        ok = ok + 1
    else
        fail = fail + 1
        print("FAIL positional + named mix")

    print("ok=" + str(ok) + " fail=" + str(fail))
    if fail == 0
        print("KAT named_args PASS")
    else
        print("KAT named_args FAIL")
