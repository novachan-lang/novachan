import forge_quota_enforcer

fn main()
    let q = qe_new()
    q = qe_set_quota(q, "user-a", 100)
    q = qe_set_quota(q, "user-b", 50)

    let r1 = qe_use(q, "user-a", 30)
    q = r1["q"]
    assert(r1["ok"] == 1, "30 ok")
    assert(qe_remaining(q, "user-a") == 70, "70 remaining")
    assert(qe_utilization(q, "user-a") == 30, "30% util")

    let r2 = qe_use(q, "user-a", 80)
    q = r2["q"]
    assert(r2["ok"] == 0, "80 exceeds")
    assert(r2["reason"] == "exceeded", "exceeded reason")
    assert(qe_total_violations(q) == 1, "1 violation")

    let r3 = qe_use(q, "unknown", 10)
    q = r3["q"]
    assert(r3["ok"] == 0, "no quota")
    assert(r3["reason"] == "no_quota", "no_quota reason")

    q = qe_reset(q, "user-a")
    assert(qe_remaining(q, "user-a") == 100, "reset to full")

    print("QUOTA-ENFORCER KAT PASS")
