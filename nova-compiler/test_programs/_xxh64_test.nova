// _xxh64_test.nova — KAT for std/hash/xxh64
//
// Canonical vectors from the official xxHash reference implementation:
//   h_xxh64(bytes(0), 0)              = 0xEF46DB3751D8E999
//   h_xxh64(str_to_bytes("abc"), 0)   = 0x44BC2CF5AD770999
//
// The constants above have bit 63 clear so they fit as positive i64 literals;
// but we build them via 32-bit halves for safety and clarity.

import std/hash/xxh64

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL xxh64 " + label + ": got " + xxh64_hex(got) + " want " + xxh64_hex(want))
        exit(1)

fn main()
    // KAT 1: empty input, seed=0
    // 0xEF46DB3751D8E999 = bit 63 set; build from halves.
    let want1 = (0xEF46DB37 << 32) | 0x51D8E999
    cki("empty_seed0", h_xxh64(bytes(0), 0), want1)

    // KAT 2: "abc", seed=0
    // 0x44BC2CF5AD770999 = bit 63 clear; fits as positive literal, but use halves.
    let want2 = (0x44BC2CF5 << 32) | 0xAD770999
    cki("abc_seed0", h_xxh64(str_to_bytes("abc"), 0), want2)

    // KAT 3: empty input, seed=1 (different seed => different result)
    let seed1_empty = h_xxh64(bytes(0), 1)
    if seed1_empty == want1
        print("FAIL xxh64 seed_differs: seed=1 gave same result as seed=0 for empty input")
        exit(1)

    // KAT 4: determinism — calling twice gives identical result
    cki("det_abc", h_xxh64(str_to_bytes("abc"), 0), want2)

    // KAT 5: single byte "a" (0x61) — just check it doesn't crash and differs from "abc"
    let ha = h_xxh64(str_to_bytes("a"), 0)
    if ha == want2
        print("FAIL xxh64 single_byte_differs: 'a' and 'abc' gave same hash")
        exit(1)

    // KAT 6: input longer than 32 bytes exercises the stripe loop.
    // "12345678901234567890123456789012" = 32 chars, seed=0.
    // We just verify it runs and produces a non-zero result.
    let long32 = str_to_bytes("12345678901234567890123456789012")
    let hlong = h_xxh64(long32, 0)
    if hlong == 0
        print("FAIL xxh64 long32_nonzero: 32-byte input gave hash 0")
        exit(1)

    // KAT 7: 40-byte input exercises both stripe loop and 8-byte tail.
    let long40 = str_to_bytes("12345678901234567890123456789012extra!!!")
    let hlong40 = h_xxh64(long40, 0)
    if hlong40 == 0
        print("FAIL xxh64 long40_nonzero: 40-byte input gave hash 0")
        exit(1)

    // KAT 8: seed changes the result for the same non-empty input
    let habc_seed1 = h_xxh64(str_to_bytes("abc"), 1)
    if habc_seed1 == want2
        print("FAIL xxh64 seed_changes_result: seed=1 gave same hash as seed=0 for 'abc'")
        exit(1)

    print("PASS _xxh64_test")
