import std/text/wraphard

// ── helpers ───────────────────────────────────────────────────────────────────

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

// Compare two lists of strings element-by-element.
fn cklist(label, got, expected)
    if len(got) != len(expected)
        print("FAIL " + label + ": len got=" + str(len(got)) + " expected=" + str(len(expected)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != expected[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + got[i] + " expected=" + expected[i])
            exit(1)
        i = i + 1

// ── KAT 1: wh_break_word basic ───────────────────────────────────────────────
// wh_break_word("abcdefgh", 3) -> ["abc","def","gh"]
let bw1 = wh_break_word("abcdefgh", 3)
cklist("break_word_abcdefgh_3", bw1, ["abc","def","gh"])

// ── KAT 2: wh_break_word exact multiple ──────────────────────────────────────
// wh_break_word("abcdef", 3) -> ["abc","def"]
let bw2 = wh_break_word("abcdef", 3)
cklist("break_word_abcdef_3", bw2, ["abc","def"])

// ── KAT 3: wh_break_word shorter than width ──────────────────────────────────
// wh_break_word("hi", 5) -> ["hi"]
let bw3 = wh_break_word("hi", 5)
cklist("break_word_hi_5", bw3, ["hi"])

// ── KAT 4: wh_wrap words all fit ─────────────────────────────────────────────
// wh_wrap("aa bb cc", 5) -> ["aa bb","cc"]
let w1 = wh_wrap("aa bb cc", 5)
cklist("wrap_aa_bb_cc_5", w1, ["aa bb","cc"])

// ── KAT 5: wh_wrap single long word ──────────────────────────────────────────
// wh_wrap("verylongword", 4) -> ["very","long","word"]
let w2 = wh_wrap("verylongword", 4)
cklist("wrap_verylongword_4", w2, ["very","long","word"])

// ── KAT 6: wh_wrap mixed short and long words ────────────────────────────────
// wh_wrap("a verylongword b", 4) -> ["a","very","long","word","b"]
let w3 = wh_wrap("a verylongword b", 4)
cklist("wrap_mixed_4", w3, ["a","very","long","word","b"])

// ── KAT 7: wh_fill joins with newline ────────────────────────────────────────
// wh_fill("aa bb", 5) -> "aa bb"  (single line, no newline needed)
let f1 = wh_fill("aa bb", 5)
cks("fill_aa_bb_5", f1, "aa bb")

// ── KAT 8: wh_wrap empty string ──────────────────────────────────────────────
// wh_wrap("", 5) -> []
let w4 = wh_wrap("", 5)
cklist("wrap_empty", w4, [])

// ── KAT 9: wh_fill multi-line ────────────────────────────────────────────────
// wh_fill("aa bb cc", 5) -> "aa bb\ncc"
let f2 = wh_fill("aa bb cc", 5)
let expected_f2 = "aa bb" + chr(10) + "cc"
cks("fill_aa_bb_cc_5", f2, expected_f2)

// ── KAT 10: wh_break_word single char width ──────────────────────────────────
// wh_break_word("abc", 1) -> ["a","b","c"]
let bw4 = wh_break_word("abc", 1)
cklist("break_word_abc_1", bw4, ["a","b","c"])

print("_wraphard_test passed")
