fn metrics_new()
  let m = {}
  m["counters"] = {}
  m["gauges"] = {}
  m["histograms"] = {}
  m

fn counter_inc(m, name)
  let counters = m["counters"]
  if contains(counters, name)
    counters[name] = counters[name] + 1
  else
    counters[name] = 1

fn counter_add(m, name, n)
  let counters = m["counters"]
  if contains(counters, name)
    counters[name] = counters[name] + n
  else
    counters[name] = n

fn counter_get(m, name)
  let counters = m["counters"]
  if contains(counters, name)
    return counters[name]
  0

fn gauge_set(m, name, value)
  m["gauges"][name] = value

fn gauge_get(m, name)
  let gauges = m["gauges"]
  if contains(gauges, name)
    return gauges[name]
  0

fn histogram_observe(m, name, value)
  let histograms = m["histograms"]
  if not contains(histograms, name)
    histograms[name] = []
  push(histograms[name], value)

fn histogram_count(m, name)
  let histograms = m["histograms"]
  if contains(histograms, name)
    return len(histograms[name])
  0

fn histogram_sum(m, name)
  let histograms = m["histograms"]
  if contains(histograms, name)
    let vals = histograms[name]
    let total = 0
    for v in vals
      total = total + v
    return total
  0

fn histogram_avg(m, name)
  let count = histogram_count(m, name)
  if count == 0
    return 0
  histogram_sum(m, name) / count

fn metrics_report(m)
  let lines = []
  let ckeys = keys(m["counters"])
  for k in ckeys
    push(lines, "counter:" + k + "=" + str(m["counters"][k]))
  let gkeys = keys(m["gauges"])
  for k in gkeys
    push(lines, "gauge:" + k + "=" + str(m["gauges"][k]))
  let hkeys = keys(m["histograms"])
  for k in hkeys
    let hc = histogram_count(m, k)
    let hs = histogram_sum(m, k)
    push(lines, "histogram:" + k + " count=" + str(hc) + " sum=" + str(hs))
  join(lines, "\n")

fn main()
  let m = metrics_new()

  counter_inc(m, "requests")
  counter_inc(m, "requests")
  counter_inc(m, "requests")
  assert(counter_get(m, "requests") == 3, "counter 3")

  counter_add(m, "bytes", 1024)
  counter_add(m, "bytes", 2048)
  assert(counter_get(m, "bytes") == 3072, "counter add")

  gauge_set(m, "temperature", 72)
  assert(gauge_get(m, "temperature") == 72, "gauge set")
  gauge_set(m, "temperature", 68)
  assert(gauge_get(m, "temperature") == 68, "gauge update")

  histogram_observe(m, "latency", 10)
  histogram_observe(m, "latency", 20)
  histogram_observe(m, "latency", 30)
  assert(histogram_count(m, "latency") == 3, "hist count")
  assert(histogram_sum(m, "latency") == 60, "hist sum")
  assert(histogram_avg(m, "latency") == 20, "hist avg")

  assert(counter_get(m, "nonexist") == 0, "missing counter")
  assert(gauge_get(m, "nonexist") == 0, "missing gauge")
  assert(histogram_count(m, "nonexist") == 0, "missing hist")

  let report = metrics_report(m)
  assert(contains(report, "counter:requests=3"), "report counter")
  assert(contains(report, "gauge:temperature=68"), "report gauge")
  assert(contains(report, "histogram:latency"), "report histogram")

  print("metrx: all passed")
