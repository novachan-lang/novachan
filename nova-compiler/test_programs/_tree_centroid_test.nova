// KAT test for std/tree/tree_centroid.
import std/tree/tree_centroid

fn cki(name, got, want)
    if got != want
        print("FAIL " + name + ": got " + str(got) + " want " + str(want))
        exit(1)
    print("ok " + name)

fn ckl(name, got, want)
    if len(got) != len(want)
        print("FAIL " + name + ": len got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + name + ": got[" + str(i) + "]=" + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1
    print("ok " + name)

fn main()
    // KAT 1: path of 3 nodes: adj=[[1],[0,2],[1]], n=3 -> centroid=1
    let a1 = []
    let r1a = []
    r1a.push(1)
    a1.push(r1a)
    let r1b = []
    r1b.push(0)
    r1b.push(2)
    a1.push(r1b)
    let r1c = []
    r1c.push(1)
    a1.push(r1c)
    cki("path3 centroid", tc_centroid(a1, 3), 1)
    let cs1 = tc_centroids(a1, 3)
    ckl("path3 centroids", cs1, [1])

    // KAT 2: path of 4 nodes: adj=[[1],[0,2],[1,3],[2]], n=4 -> centroids=[1,2]
    let a2 = []
    let r2a = []
    r2a.push(1)
    a2.push(r2a)
    let r2b = []
    r2b.push(0)
    r2b.push(2)
    a2.push(r2b)
    let r2c = []
    r2c.push(1)
    r2c.push(3)
    a2.push(r2c)
    let r2d = []
    r2d.push(2)
    a2.push(r2d)
    let cs2 = tc_centroids(a2, 4)
    ckl("path4 centroids", cs2, [1, 2])

    // KAT 3: star of 4 nodes: adj=[[1,2,3],[0],[0],[0]], n=4 -> centroid=0
    let a3 = []
    let r3a = []
    r3a.push(1)
    r3a.push(2)
    r3a.push(3)
    a3.push(r3a)
    let r3b = []
    r3b.push(0)
    a3.push(r3b)
    let r3c = []
    r3c.push(0)
    a3.push(r3c)
    let r3d = []
    r3d.push(0)
    a3.push(r3d)
    cki("star4 centroid", tc_centroid(a3, 4), 0)

    // KAT 4: single node: adj=[[]], n=1 -> centroid=0
    let a4 = []
    let r4a = []
    a4.push(r4a)
    cki("single centroid", tc_centroid(a4, 1), 0)
    let cs4 = tc_centroids(a4, 1)
    ckl("single centroids", cs4, [0])

    // KAT 5: path5: nodes 0-1-2-3-4, centroid = 2
    let a5 = []
    let p5_0 = []
    p5_0.push(1)
    a5.push(p5_0)
    let p5_1 = []
    p5_1.push(0)
    p5_1.push(2)
    a5.push(p5_1)
    let p5_2 = []
    p5_2.push(1)
    p5_2.push(3)
    a5.push(p5_2)
    let p5_3 = []
    p5_3.push(2)
    p5_3.push(4)
    a5.push(p5_3)
    let p5_4 = []
    p5_4.push(3)
    a5.push(p5_4)
    cki("path5 centroid", tc_centroid(a5, 5), 2)
    let cs5 = tc_centroids(a5, 5)
    ckl("path5 centroids", cs5, [2])

    // KAT 6: two nodes: adj=[[1],[0]], n=2 -> both centroids
    let a6 = []
    let r6a = []
    r6a.push(1)
    a6.push(r6a)
    let r6b = []
    r6b.push(0)
    a6.push(r6b)
    let cs6 = tc_centroids(a6, 2)
    ckl("path2 centroids", cs6, [0, 1])

    print("PASS _tree_centroid_test")
