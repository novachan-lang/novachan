import forge_dijkstra

fn tf(b: bool) -> string
    if b
        return "T"
    "F"
fn joinl(xs: list) -> string
    let s = ""
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ">"
        s = s + xs[i]
        i = i + 1
    s

fn main()
    // A->B(1) A->C(4) B->C(2) B->D(5) C->D(1). shortest A->D = A>B>C>D = 4
    let g = wgraph_new()
    wgraph_edge(g, "A", "B", 1)
    wgraph_edge(g, "A", "C", 4)
    wgraph_edge(g, "B", "C", 2)
    wgraph_edge(g, "B", "D", 5)
    wgraph_edge(g, "C", "D", 1)
    let dist = dijkstra_dist(g, "A")
    print("dA=" + str(dist["A"]) + " dB=" + str(dist["B"]) + " dC=" + str(dist["C"]) + " dD=" + str(dist["D"]))
    print("path=" + joinl(dijkstra_path(g, "A", "D")))
    // unreachable node X
    wgraph_edge(g, "X", "Y", 1)
    let d2 = dijkstra_dist(g, "A")
    print("unreach=" + tf(d2["X"] >= 1000000000))
    print("nopath=" + tf(len(dijkstra_path(g, "A", "X")) == 0))
    // start == goal
    print("self=" + joinl(dijkstra_path(g, "A", "A")))
