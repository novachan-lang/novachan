import forge_chaos_engine

fn main()
    let c = ce_new()
    assert(ce_experiment_count(c) == 0, "starts with 0 experiments")

    c = ce_add_experiment(c, "kill-primary", "db-node-1", "kill")
    c = ce_add_experiment(c, "delay-api", "api-gateway", "delay")
    c = ce_add_experiment(c, "corrupt-payload", "queue-worker", "corrupt")
    assert(ce_experiment_count(c) == 3, "3 experiments")

    let rs0 = ce_status(c, "kill-primary")
    assert(is_ok(rs0), "status ok")
    assert(unwrap(rs0) == "pending", "starts pending")

    let rsmiss = ce_status(c, "ghost")
    assert(is_err(rsmiss), "status on unknown errs")

    let rcomplete_early = ce_complete(c, "kill-primary", 1)
    assert(is_err(rcomplete_early), "cannot complete a pending experiment")

    let rstart = ce_start(c, "kill-primary")
    assert(is_ok(rstart), "start ok")
    assert(ce_running_count(c) == 1, "1 running")

    let rstartagain = ce_start(c, "kill-primary")
    assert(is_err(rstartagain), "cannot start twice")

    let rstartmiss = ce_start(c, "ghost")
    assert(is_err(rstartmiss), "start on unknown errs")

    let rs1 = ce_status(c, "kill-primary")
    assert(unwrap(rs1) == "running", "now running")

    let rcomp1 = ce_complete(c, "kill-primary", 1)
    assert(is_ok(rcomp1), "complete ok")
    assert(ce_running_count(c) == 0, "0 running after complete")
    assert(ce_passed_count(c) == 1, "1 passed")
    assert(ce_failed_count(c) == 0, "0 failed")

    let rs2 = ce_status(c, "kill-primary")
    assert(unwrap(rs2) == "passed", "status passed")

    let rstart2 = ce_start(c, "delay-api")
    assert(is_ok(rstart2), "start delay-api ok")
    let rcomp2 = ce_complete(c, "delay-api", 0)
    assert(is_ok(rcomp2), "complete delay-api ok")
    assert(ce_failed_count(c) == 1, "1 failed")

    let rcompagain = ce_complete(c, "delay-api", 1)
    assert(is_err(rcompagain), "cannot complete an already-completed experiment")

    let rstart3 = ce_start(c, "corrupt-payload")
    assert(is_ok(rstart3), "start corrupt-payload ok")
    assert(ce_running_count(c) == 1, "1 running (corrupt-payload)")

    let rpr = ce_pass_rate(c)
    assert(is_ok(rpr), "pass_rate ok (2 completed so far)")
    assert(unwrap(rpr) == 50, "1/2 = 50pct")

    let c2 = ce_new()
    let rprmiss = ce_pass_rate(c2)
    assert(is_err(rprmiss), "pass_rate errs with no completed experiments")

    print("CHAOS-ENGINE KAT PASS")
