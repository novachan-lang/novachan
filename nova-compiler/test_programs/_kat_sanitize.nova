import forge_sanitize

fn main()
    // Safe tags preserved, attributes stripped
    let r1 = sanitize("<b onclick='x'>hi</b>")
    assert(r1 == "<b>hi</b>", "safe tag kept, attr stripped")

    // Dangerous tags removed entirely
    let r2 = sanitize("<script>alert(1)</script>")
    assert(r2 == "alert(1)", "script tag removed")

    // Mixed content
    let r3 = sanitize("<p>hello</p><script>bad</script><em>world</em>")
    assert(r3 == "<p>hello</p>bad<em>world</em>", "mixed sanitize")

    // Closing tags preserved for safe tags
    let r4 = sanitize("<strong>bold</strong>")
    assert(r4 == "<strong>bold</strong>", "closing safe tag ok")

    // strip_tags removes all tags
    let r5 = strip_tags("<b>hello</b> <em>world</em>")
    assert(r5 == "hello world", "all tags stripped")

    // Unclosed < treated as literal
    let r6 = sanitize("5 < 10")
    assert(find(r6, "5 < 10") >= 0, "unclosed bracket literal")

    print("SANITIZE KAT PASS")
