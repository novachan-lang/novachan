import std/lambda/lambda_church

// ── Check helpers ────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL _lambda_church_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        let gs = "false"
        let ws = "false"
        if got
            gs = "true"
        if want
            ws = "true"
        print("FAIL _lambda_church_test " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // KAT 1: lch_to_int(lch_num(0)) = 0
    cki("num0", lambda_church.lch_to_int(lambda_church.lch_num(0)), 0)

    // KAT 2: lch_to_int(lch_num(3)) = 3
    cki("num3", lambda_church.lch_to_int(lambda_church.lch_num(3)), 3)

    // KAT 3: lch_to_int(lch_num(1)) = 1
    cki("num1", lambda_church.lch_to_int(lambda_church.lch_num(1)), 1)

    // KAT 4: plus(2, 3) = 5
    let plus5 = lambda_church.lch_apply2(lambda_church.lch_plus(), lambda_church.lch_num(2), lambda_church.lch_num(3))
    cki("plus2p3", lambda_church.lch_to_int(plus5), 5)

    // KAT 5: mult(2, 3) = 6
    let mult6 = lambda_church.lch_apply2(lambda_church.lch_mult(), lambda_church.lch_num(2), lambda_church.lch_num(3))
    cki("mult2x3", lambda_church.lch_to_int(mult6), 6)

    // KAT 6: exp(2, 3) = 8  (2^3)
    let exp8 = lambda_church.lch_apply2(lambda_church.lch_exp(), lambda_church.lch_num(2), lambda_church.lch_num(3))
    cki("exp2p3", lambda_church.lch_to_int(exp8), 8)

    // KAT 7: succ(4) = 5 — build and normalize app(succ, num(4))
    let succ_app = lambda_church.lch_app(lambda_church.lch_succ(), lambda_church.lch_num(4))
    let succ5 = lambda_church.lch_normalize(succ_app)
    cki("succ4", lambda_church.lch_to_int(succ5), 5)

    // KAT 8: plus(0, 0) = 0
    let plus0 = lambda_church.lch_apply2(lambda_church.lch_plus(), lambda_church.lch_num(0), lambda_church.lch_num(0))
    cki("plus0p0", lambda_church.lch_to_int(plus0), 0)

    // KAT 9: mult(0, 5) = 0
    let mult0 = lambda_church.lch_apply2(lambda_church.lch_mult(), lambda_church.lch_num(0), lambda_church.lch_num(5))
    cki("mult0x5", lambda_church.lch_to_int(mult0), 0)

    // KAT 10: exp(3, 2) = 9
    let exp9 = lambda_church.lch_apply2(lambda_church.lch_exp(), lambda_church.lch_num(3), lambda_church.lch_num(2))
    cki("exp3p2", lambda_church.lch_to_int(exp9), 9)

    print("PASS _lambda_church_test")
