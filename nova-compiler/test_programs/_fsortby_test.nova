import std/functional/fsortby

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": index " + str(i) + " got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

// ── helpers ──────────────────────────────────────────────────────────────────
fn neg(x)
    0 - x

fn absval(x)
    if x < 0
        return 0 - x
    x

fn identity(x)
    x

fn main()
    // ── fs_sort_by ───────────────────────────────────────────────────────────

    // KAT: fs_sort_by(neg,[3,1,2])=[3,2,1]  (descending by value)
    let s1 = fs_sort_by(neg, [3, 1, 2])
    ckl("sort_by neg", s1, [3, 2, 1])

    // KAT: fs_sort_by(absval,[-3,1,-2])=[1,-2,-3]
    let s2 = fs_sort_by(absval, [-3, 1, -2])
    ckl("sort_by absval", s2, [1, -2, -3])

    // KAT: fs_sort_by(identity,[3,1,2])=[1,2,3]
    let s3 = fs_sort_by(identity, [3, 1, 2])
    ckl("sort_by identity", s3, [1, 2, 3])

    // KAT: empty list
    let se = fs_sort_by(identity, [])
    cki("sort_by empty len", len(se), 0)

    // KAT: single element
    let ss = fs_sort_by(identity, [42])
    cki("sort_by single len", len(ss), 1)
    cki("sort_by single[0]", ss[0], 42)

    // KAT: already sorted
    let sa = fs_sort_by(identity, [1, 2, 3, 4, 5])
    ckl("sort_by already_sorted", sa, [1, 2, 3, 4, 5])

    // KAT: reverse sorted
    let sr = fs_sort_by(identity, [5, 4, 3, 2, 1])
    ckl("sort_by reverse", sr, [1, 2, 3, 4, 5])

    // KAT: duplicates
    let sd = fs_sort_by(identity, [3, 1, 2, 1, 3])
    ckl("sort_by dups", sd, [1, 1, 2, 3, 3])

    // KAT: stability — equal keys should preserve order (checked via absval on [2,-2,1,-1])
    // absval gives [2,2,1,1]; stable sort by absval should give [1,-1,2,-2]
    let sstab = fs_sort_by(absval, [2, -2, 1, -1])
    cki("sort_by stable len", len(sstab), 4)
    cki("sort_by stable[0]", sstab[0], 1)
    cki("sort_by stable[1]", sstab[1], -1)
    cki("sort_by stable[2]", sstab[2], 2)
    cki("sort_by stable[3]", sstab[3], -2)

    // ── fs_min_by ────────────────────────────────────────────────────────────

    // KAT: fs_min_by(absval,[-3,1,-2])=1  (absval: 3,1,2 → min key=1 → elem=1)
    let mn1 = fs_min_by(absval, [-3, 1, -2])
    cki("min_by absval", mn1, 1)

    // KAT: fs_min_by(identity,[3,1,2])=1
    let mn2 = fs_min_by(identity, [3, 1, 2])
    cki("min_by identity", mn2, 1)

    // KAT: single element
    let mn3 = fs_min_by(identity, [7])
    cki("min_by single", mn3, 7)

    // KAT: neg key — min of neg keys = most negative neg → largest positive
    // neg([3,1,2]): keys=-3,-1,-2; min key=-3 → elem=3
    let mn4 = fs_min_by(neg, [3, 1, 2])
    cki("min_by neg", mn4, 3)

    // ── fs_max_by ────────────────────────────────────────────────────────────

    // KAT: fs_max_by(absval,[-3,1,-2])=-3  (absval: 3,1,2 → max key=3 → elem=-3)
    let mx1 = fs_max_by(absval, [-3, 1, -2])
    cki("max_by absval", mx1, -3)

    // KAT: fs_max_by(identity,[3,1,2])=3
    let mx2 = fs_max_by(identity, [3, 1, 2])
    cki("max_by identity", mx2, 3)

    // KAT: single element
    let mx3 = fs_max_by(identity, [7])
    cki("max_by single", mx3, 7)

    // KAT: neg key — max of neg keys = least negative → smallest positive
    // neg([3,1,2]): keys=-3,-1,-2; max key=-1 → elem=1
    let mx4 = fs_max_by(neg, [3, 1, 2])
    cki("max_by neg", mx4, 1)

    print("PASS _fsortby_test")

main()
