// Monitor multiple processes — use select to detect first completion
ch1 = channel()
ch2 = channel()

p1 = spawn fn()
    send(ch1, 10)

p2 = spawn fn()
    send(ch2, 20)

m1 = monitor(p1)
m2 = monitor(p2)

// Both processes finish normally — collect their results and monitor statuses
v1 = receive(ch1)
v2 = receive(ch2)
s1 = receive(m1)
s2 = receive(m2)
print(v1 + v2)
print(s1 + s2)
