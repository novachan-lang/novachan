import forge_usage_meter

fn main()
    let um = um_new()
    um = um_define_meter(um, "compute", "cpu-hours", 10)
    um = um_define_meter(um, "storage", "gb-months", 5)
    assert(um_meter_count(um) == 2, "2 meters")

    um = um_record(um, "tenant-a", "compute", 100, 1000)
    um = um_record(um, "tenant-a", "compute", 50, 2000)
    um = um_record(um, "tenant-a", "storage", 200, 1000)
    um = um_record(um, "tenant-b", "compute", 30, 1500)
    assert(um_event_count(um) == 4, "4 events")

    assert(um_usage(um, "tenant-a", "compute") == 150, "a compute=150")
    assert(um_usage(um, "tenant-a", "storage") == 200, "a storage=200")
    assert(um_usage(um, "tenant-b", "compute") == 30, "b compute=30")
    assert(um_usage(um, "tenant-b", "storage") == 0, "b storage=0")

    assert(um_cost(um, "tenant-a", "compute") == 1500, "a compute cost=1500")
    assert(um_cost(um, "tenant-a", "storage") == 1000, "a storage cost=1000")
    assert(um_total_cost(um, "tenant-a") == 2500, "a total=2500")
    assert(um_total_cost(um, "tenant-b") == 300, "b total=300")

    let summary = um_tenant_summary(um, "tenant-a")
    assert(summary["compute"]["quantity"] == 150, "summary compute qty")
    assert(summary["compute"]["cost"] == 1500, "summary compute cost")

    assert(um_cost(um, "tenant-a", "nonexistent") == 0, "no meter=0 cost")

    print("USAGE-METER KAT PASS")
