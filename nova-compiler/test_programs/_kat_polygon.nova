import forge_polygon

fn tf(b: bool) -> string
    if b
        return "T"
    "F"
fn approx(a: float, b: float) -> string
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < 0.0001
        return "T"
    "F"

fn main()
    let sq = [[0.0, 0.0], [4.0, 0.0], [4.0, 4.0], [0.0, 4.0]]
    print("sq_in=" + tf(point_in_polygon(2.0, 2.0, sq)))
    print("sq_out_far=" + tf(point_in_polygon(5.0, 5.0, sq)))
    print("sq_out_above=" + tf(point_in_polygon(2.0, 5.0, sq)))
    print("sq_out_left=" + tf(point_in_polygon(0.0 - 1.0, 2.0, sq)))
    print("sq_area=" + approx(polygon_area(sq), 16.0))
    let tri = [[0.0, 0.0], [4.0, 0.0], [2.0, 4.0]]
    print("tri_in_low=" + tf(point_in_polygon(2.0, 1.0, tri)))
    print("tri_in_high=" + tf(point_in_polygon(2.0, 3.0, tri)))
    print("tri_out_left=" + tf(point_in_polygon(0.5, 3.0, tri)))
    print("tri_out_right=" + tf(point_in_polygon(3.5, 3.0, tri)))
    print("tri_area=" + approx(polygon_area(tri), 8.0))
    // concave (arrow / chevron): point in the notch is OUTSIDE
    let cc = [[0.0, 0.0], [4.0, 0.0], [4.0, 4.0], [2.0, 1.0], [0.0, 4.0]]
    print("cc_notch_out=" + tf(point_in_polygon(2.0, 3.0, cc)))
    print("cc_body_in=" + tf(point_in_polygon(1.0, 1.0, cc)))
    // degenerate
    print("degen=" + tf(point_in_polygon(1.0, 1.0, [[0.0, 0.0], [1.0, 1.0]])))
