import std/bio/seqstats

fn approx(a, b, tol) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return true
    return false

fn fail(label, got, want)
    print("FAIL seqstats " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)

fn main()
    // KAT 1: gc_content('GGCC') == 1.0
    let gc1 = gc_content("GGCC")
    if not approx(gc1, 1.0, 0.0001)
        fail("gc_content GGCC", gc1, 1.0)

    // KAT 2: gc_content('AATT') == 0.0
    let gc2 = gc_content("AATT")
    if not approx(gc2, 0.0, 0.0001)
        fail("gc_content AATT", gc2, 0.0)

    // KAT 3: gc_content('ATGC') == 0.5
    let gc3 = gc_content("ATGC")
    if not approx(gc3, 0.5, 0.0001)
        fail("gc_content ATGC", gc3, 0.5)

    // KAT 4: gc_skew('GGGC') = (3-1)/(3+1) = 0.5
    let gs1 = gc_skew("GGGC")
    if not approx(gs1, 0.5, 0.0001)
        fail("gc_skew GGGC", gs1, 0.5)

    // KAT 5: gc_skew('AATT') == 0.0 (no G or C)
    let gs2 = gc_skew("AATT")
    if not approx(gs2, 0.0, 0.0001)
        fail("gc_skew no GC", gs2, 0.0)

    // KAT 6: cpg_count('CGCGCG') == 3 (positions 0,2,4 are CG)
    let cpg1 = cpg_count("CGCGCG")
    if cpg1 != 3
        print("FAIL seqstats cpg_count: got=" + str(cpg1) + " want=3")
        exit(1)

    // KAT 7: at_skew('AAAT') = (3-1)/(3+1) = 0.5
    let as1 = at_skew("AAAT")
    if not approx(as1, 0.5, 0.0001)
        fail("at_skew AAAT", as1, 0.5)

    // KAT 8: at_skew('GGCC') == 0.0 (no A or T)
    let as2 = at_skew("GGCC")
    if not approx(as2, 0.0, 0.0001)
        fail("at_skew no AT", as2, 0.0)

    // KAT 9: melting_temp_wallace('ATGC') = 2*2 + 4*2 = 12.0
    // A=1, T=1, G=1, C=1 => AT=2, GC=2 => 2*2 + 4*2 = 4+8 = 12.0
    let mt1 = melting_temp_wallace("ATGC")
    if not approx(mt1, 12.0, 0.0001)
        fail("melting_temp_wallace ATGC", mt1, 12.0)

    // KAT 10: melting_temp_wallace('AAAA') = 2*4 = 8.0
    let mt2 = melting_temp_wallace("AAAA")
    if not approx(mt2, 8.0, 0.0001)
        fail("melting_temp_wallace AAAA", mt2, 8.0)

    // KAT 11: purine_fraction('AGGG') = 4/4 = 1.0
    let pf1 = purine_fraction("AGGG")
    if not approx(pf1, 1.0, 0.0001)
        fail("purine_fraction AGGG", pf1, 1.0)

    // KAT 12: purine_fraction('TTCC') = 0/4 = 0.0
    let pf2 = purine_fraction("TTCC")
    if not approx(pf2, 0.0, 0.0001)
        fail("purine_fraction TTCC", pf2, 0.0)

    // KAT 13: purine_fraction('ATGC') = 2/4 = 0.5
    let pf3 = purine_fraction("ATGC")
    if not approx(pf3, 0.5, 0.0001)
        fail("purine_fraction ATGC", pf3, 0.5)

    // KAT 14: shannon_entropy('AAAA') == 0.0 (single base)
    let se1 = shannon_entropy("AAAA")
    if not approx(se1, 0.0, 0.0001)
        fail("shannon_entropy uniform", se1, 0.0)

    // KAT 15: shannon_entropy('ACGT') = -4*(0.25*log2(0.25)) = -4*(0.25*(-2)) = 2.0 bits
    let se2 = shannon_entropy("ACGT")
    if not approx(se2, 2.0, 0.001)
        fail("shannon_entropy ACGT", se2, 2.0)

    // KAT 16: sequence_complexity('AAAA') = 1 distinct 2-mer / 3 total = 0.333...
    let sc1 = sequence_complexity("AAAA")
    if not approx(sc1, 0.3333, 0.001)
        fail("sequence_complexity AAAA", sc1, 0.3333)

    // KAT 17: sequence_complexity('ACGT') = 3 distinct 2-mers / 3 total = 1.0
    let sc2 = sequence_complexity("ACGT")
    if not approx(sc2, 1.0, 0.0001)
        fail("sequence_complexity ACGT", sc2, 1.0)

    // KAT 18: base_composition contains each base in 'ATGC'
    let bc1 = base_composition("ATGC")
    let fA = bc1["A"]
    if not approx(fA, 0.25, 0.0001)
        fail("base_comp A", fA, 0.25)

    // KAT 19: cpg_observed_expected('CGCG') => count_CG=1, len=4, count_C=1, count_G=1... wait:
    // 'CGCG': C at 0, G at 1, C at 2, G at 3. CG at pos 0-1 and 2-3 => count_CG=2, len=4, count_C=2, count_G=2
    // O/E = (2*4)/(2*2) = 8/4 = 2.0
    let cpg_oe = cpg_observed_expected("CGCG")
    if not approx(cpg_oe, 2.0, 0.0001)
        fail("cpg_observed_expected CGCG", cpg_oe, 2.0)

    // KAT 20: cumulative_gc_skew returns a list of length equal to seq length
    let cgs1 = cumulative_gc_skew("GCGC")
    let cgs_len = len(cgs1)
    if cgs_len != 4
        print("FAIL seqstats cumulative_gc_skew length: got=" + str(cgs_len) + " want=4")
        exit(1)

    // KAT 21: dinucleotide_freq('AAAA') -> only 'AA' with count 3
    let df1 = dinucleotide_freq("AAAA")
    let cnt_AA = df1["AA"]
    if cnt_AA != 3
        print("FAIL seqstats dinucleotide_freq AA: got=" + str(cnt_AA) + " want=3")
        exit(1)

    // KAT 22: molecular_weight_dna('A') = 313.2 - 61.96 = 251.24
    let mw1 = molecular_weight_dna("A")
    if not approx(mw1, 251.24, 0.01)
        fail("molecular_weight_dna A", mw1, 251.24)

    // KAT 23: molecular_weight_dna('ATGC') = 313.2+304.2+329.2+289.2 - 61.96 = 1173.84
    // 313.2+304.2 = 617.4; 329.2+289.2 = 618.4; total = 1235.8 - 61.96 = 1173.84
    let mw2 = molecular_weight_dna("ATGC")
    if not approx(mw2, 1173.84, 0.01)
        fail("molecular_weight_dna ATGC", mw2, 1173.84)

    // KAT 24: molecular_weight_dna('') == 0.0 (FIX 3 — empty guard)
    let mw_empty = molecular_weight_dna("")
    if not approx(mw_empty, 0.0, 0.0001)
        fail("molecular_weight_dna empty", mw_empty, 0.0)

    print("PASS _seqstats_test")
