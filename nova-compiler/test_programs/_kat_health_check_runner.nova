import forge_health_check_runner

fn main()
    let h = hcr_new()
    h = hcr_add_check(h, "db", "http://db:5432/health")
    h = hcr_add_check(h, "cache", "http://cache:6379/ping")
    assert(hcr_check_count(h) == 2, "2 checks")

    let st = hcr_status(h, "db")
    assert(is_ok(st), "status ok")
    assert(unwrap(st) == "unknown", "unknown initially")

    let r1 = hcr_report(h, "db", 1)
    assert(is_ok(r1), "report ok")
    h = unwrap(r1)
    let st2 = hcr_status(h, "db")
    assert(unwrap(st2) == "healthy", "db healthy")

    let r2 = hcr_report(h, "cache", 0)
    h = unwrap(r2)
    let st3 = hcr_status(h, "cache")
    assert(unwrap(st3) == "unhealthy", "cache unhealthy")

    assert(hcr_total_runs(h) == 2, "2 runs")
    assert(hcr_healthy_runs(h) == 1, "1 healthy")
    assert(hcr_unhealthy_runs(h) == 1, "1 unhealthy")

    let ep = hcr_endpoint(h, 0)
    assert(unwrap(ep) == "http://db:5432/health", "db endpoint")

    let bad = hcr_report(h, "nope", 1)
    assert(is_err(bad), "not found")

    print("HEALTH-CHECK-RUNNER KAT PASS")
