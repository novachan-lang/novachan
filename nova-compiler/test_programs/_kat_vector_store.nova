import forge_vector_store

fn main()
    let s = vs_new(3)
    assert(vs_dimensions(s) == 3, "dims 3")
    assert(vs_count(s) == 0, "count 0")

    let a1 = vs_add(s, "v1", "1,2,3")
    assert(is_ok(a1), "add v1 ok")
    let a2 = vs_add(s, "v2", "4,5,6")
    assert(is_ok(a2), "add v2 ok")
    let a3 = vs_add(s, "v3", "1,2,3")
    assert(is_ok(a3), "add v3 ok")
    let a4 = vs_add(s, "v4", "0,0,1")
    assert(is_ok(a4), "add v4 ok")
    assert(vs_count(s) == 4, "count 4")

    let bad = vs_add(s, "bad", "2,3")
    assert(is_err(bad), "wrong dims rejected")

    assert(vs_has(s, "v1") == 1, "has v1")
    assert(vs_has(s, "nope") == 0, "no nope")

    let g = vs_get(s, "v1")
    assert(is_ok(g), "get v1 ok")
    assert(unwrap(g) == "1,2,3", "v1 csv correct")

    let gm = vs_get(s, "nope")
    assert(is_err(gm), "get missing errs")

    let d1 = vs_dot(s, "v1", "v2")
    assert(is_ok(d1), "dot ok")
    assert(unwrap(d1) == 32, "dot v1.v2 = 32")

    let dm = vs_dot(s, "v1", "nope")
    assert(is_err(dm), "dot missing errs")

    let mag = vs_magnitude(s, "v1")
    assert(is_ok(mag), "magnitude ok")
    assert(unwrap(mag) == 14, "magnitude v1 = 14")

    // vs_nearest ranks candidates by raw dot product (highest wins), not
    // cosine similarity, so the larger-magnitude v2 (dot=32) outranks the
    // direction-identical-but-smaller v3 (dot=14) here.
    let n1 = vs_nearest(s, "v1", "v2,v3,v4")
    assert(is_ok(n1), "nearest ok")
    assert(unwrap(n1) == "v2", "nearest to v1 by dot product is v2 (highest dot=32)")

    let n1b = vs_nearest(s, "v1", "v3,v4")
    assert(unwrap(n1b) == "v3", "among v3/v4, v3 has higher dot product (14 > 3)")

    let n2 = vs_nearest(s, "v1", "nonexistent")
    assert(is_err(n2), "nearest with no valid candidates errs")

    let rm = vs_remove(s, "v2")
    assert(is_ok(rm), "remove v2 ok")
    assert(vs_count(s) == 3, "count 3 after remove")
    assert(vs_has(s, "v2") == 0, "v2 gone")

    let rm2 = vs_remove(s, "v2")
    assert(is_err(rm2), "remove missing errs")

    print("VECTOR-STORE KAT PASS")
