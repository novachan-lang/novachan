import std/numeral/bijective26

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL bijective26 " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL bijective26 " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gs = "false"
    if got
        gs = "true"
    let ws = "false"
    if want
        ws = "true"
    if got != want
        print("FAIL bijective26 " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn main()
    // bj_to_col KAT
    cks("to_col(1)",   bj_to_col(1),   "A")
    cks("to_col(26)",  bj_to_col(26),  "Z")
    cks("to_col(27)",  bj_to_col(27),  "AA")
    cks("to_col(52)",  bj_to_col(52),  "AZ")
    cks("to_col(702)", bj_to_col(702), "ZZ")
    cks("to_col(703)", bj_to_col(703), "AAA")

    // bj_from_col KAT
    cki("from_col(A)",  bj_from_col("A"),  1)
    cki("from_col(Z)",  bj_from_col("Z"),  26)
    cki("from_col(AA)", bj_from_col("AA"), 27)
    cki("from_col(AZ)", bj_from_col("AZ"), 52)
    cki("from_col(ZZ)", bj_from_col("ZZ"), 702)

    // bj_is_valid KAT
    ckb("valid(A)",   bj_is_valid("A"),   true)
    ckb("valid(ZZ)",  bj_is_valid("ZZ"),  true)
    ckb("valid()",    bj_is_valid(""),    false)
    ckb("valid(a)",   bj_is_valid("a"),   false)
    ckb("valid(A1)",  bj_is_valid("A1"),  false)

    // Round-trip: bj_from_col(bj_to_col(n)) == n
    cki("roundtrip(1)",     bj_from_col(bj_to_col(1)),     1)
    cki("roundtrip(26)",    bj_from_col(bj_to_col(26)),    26)
    cki("roundtrip(27)",    bj_from_col(bj_to_col(27)),    27)
    cki("roundtrip(702)",   bj_from_col(bj_to_col(702)),   702)
    cki("roundtrip(703)",   bj_from_col(bj_to_col(703)),   703)
    cki("roundtrip(12345)", bj_from_col(bj_to_col(12345)), 12345)
    cki("roundtrip(1)",     bj_from_col(bj_to_col(1)),     1)

    print("PASS _bijective26_test")
