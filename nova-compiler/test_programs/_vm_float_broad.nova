let fails = []

fn chk(label: string, cond: bool)
    if cond
        print("PASS " + label)
    else
        print("FAIL " + label)
        push(fails, label)

// list of floats: element read, arithmetic, comparison
let xs = [1.5, 2.5, 3.5]
chk("list elem read", str(xs[0]) == "1.5")
chk("list elem arith", xs[0] + xs[1] == 4.0)
chk("list elem cmp eq", xs[1] == 2.5)
chk("list elem cmp lt", xs[0] < xs[1])
chk("list elem mul", xs[1] * 2.0 == 5.0)

// iterate a float list, accumulate
let total = 0.0
for v in xs
    total = total + v
chk("iterate sum", total == 7.5)

// print each (box-aware render)
for v in xs
    print("  elem=" + str(v))

// dict of floats
let d = {}
d["a"] = 1.25
d["b"] = 2.75
chk("dict float read", str(d["a"]) == "1.25")
chk("dict float arith", d["a"] + d["b"] == 4.0)
chk("dict float cmp", d["b"] == 2.75)

// mixed int/float list
let mix = [1, 2.5, 3]
chk("mixed int elem", str(mix[0]) == "1")
chk("mixed float elem", str(mix[1]) == "2.5")
chk("mixed int elem2", str(mix[2]) == "3")

// float() of a list element (the old float(xs[i]) bug)
chk("float of elem", float(xs[2]) == 3.5)

// nested list of floats
let nl = [[1.5, 2.5], [3.5, 4.5]]
chk("nested float read", str(nl[1][0]) == "3.5")
chk("nested float arith", nl[0][0] + nl[1][1] == 6.0)

// re-store an element into another container
let ys = []
push(ys, xs[1])
chk("restore elem", str(ys[0]) == "2.5")

print("")
if len(fails) == 0
    print("ALL FLOAT-BROAD CELLS PASS")
else
    print("FLOAT-BROAD FAILURES: " + str(len(fails)))
    exit(1)
