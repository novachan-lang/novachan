// KAT for std/text/indent — splitlines/join_lines/indent/dedent.
import std/text/indent

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn cklist(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": len " + str(len(got)) + " != " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + " [" + str(i) + "]: '" + got[i] + "' != '" + want[i] + "'")
            exit(1)
        i = i + 1

fn main()
    let nl = chr(10)
    cklist("split1", splitlines("a" + nl + "b" + nl + "c"), ["a", "b", "c"])
    cklist("split2", splitlines("a" + nl + "b" + nl), ["a", "b"])
    cklist("split3", splitlines(""), [])
    cks("indent1", indent("a" + nl + "b", "  "), "  a" + nl + "  b")
    cks("indent-blank", indent("a" + nl + nl + "b", "  "), "  a" + nl + nl + "  b")
    cks("dedent1", dedent("    a" + nl + "    b"), "a" + nl + "b")
    cks("dedent2", dedent("  a" + nl + "    b"), "a" + nl + "  b")
    cks("join", join_lines(["x", "y"]), "x" + nl + "y")
    print("_indent_test passed")
