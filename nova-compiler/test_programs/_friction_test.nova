// KAT for std/physics/friction
// Tests: friction_force, kinetic_friction, incline_normal, incline_gravity_component
import std/physics/friction

fn approx(a, b)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    let result = d < 0.0001
    result

fn main()
    // KAT 1: friction_force(0.5, 100.0) == 50.0
    let ff = friction_force(0.5, 100.0)
    let ok1 = approx(ff, 50.0)
    if ok1 != true
        print("FAIL friction friction_force(0.5,100): got=" + str(ff) + " want=50.0")
        exit(1)

    // KAT 2: friction_force(0.0, 100.0) == 0.0  (zero friction)
    let ff0 = friction_force(0.0, 100.0)
    let ok2 = approx(ff0, 0.0)
    if ok2 != true
        print("FAIL friction friction_force(0.0,100): got=" + str(ff0) + " want=0.0")
        exit(1)

    // KAT 3: kinetic_friction(0.3, 50.0) == 15.0
    let kf = kinetic_friction(0.3, 50.0)
    let ok3 = approx(kf, 15.0)
    if ok3 != true
        print("FAIL friction kinetic_friction(0.3,50): got=" + str(kf) + " want=15.0")
        exit(1)

    // KAT 4: incline_normal(1.0, 0.0) == 9.81  (flat surface: full weight is normal)
    let n0 = incline_normal(1.0, 0.0)
    let ok4 = approx(n0, 9.81)
    if ok4 != true
        print("FAIL friction incline_normal(1,0): got=" + str(n0) + " want=9.81")
        exit(1)

    // KAT 5: incline_normal(1.0, 90.0) ~ 0.0  (vertical wall: no normal component)
    let n90 = incline_normal(1.0, 90.0)
    let lo5 = 0.0 - 0.0001
    let hi5 = 0.0001
    if n90 < lo5
        print("FAIL friction incline_normal(1,90): got=" + str(n90) + " want~0")
        exit(1)
    if n90 > hi5
        print("FAIL friction incline_normal(1,90): got=" + str(n90) + " want~0")
        exit(1)

    // KAT 6: incline_gravity_component(1.0, 0.0) ~ 0.0  (flat: no gravity along surface)
    let fg0 = incline_gravity_component(1.0, 0.0)
    let lo6 = 0.0 - 0.0001
    let hi6 = 0.0001
    if fg0 < lo6
        print("FAIL friction incline_gravity(1,0): got=" + str(fg0) + " want~0")
        exit(1)
    if fg0 > hi6
        print("FAIL friction incline_gravity(1,0): got=" + str(fg0) + " want~0")
        exit(1)

    // KAT 7: incline_gravity_component(1.0, 90.0) == 9.81  (vertical: full weight)
    let fg90 = incline_gravity_component(1.0, 90.0)
    let ok7 = approx(fg90, 9.81)
    if ok7 != true
        print("FAIL friction incline_gravity(1,90): got=" + str(fg90) + " want=9.81")
        exit(1)

    // KAT 8: incline_normal(2.0, 30.0) == 2*9.81*cos(30) ~ 16.9914
    // cos(30deg) ~ 0.866025403784; 19.62 * 0.866025 = 16.9914
    let n30 = incline_normal(2.0, 30.0)
    let ok8 = approx(n30, 16.9914)
    if ok8 != true
        print("FAIL friction incline_normal(2,30): got=" + str(n30) + " want~16.9914")
        exit(1)

    print("PASS _friction_test")
