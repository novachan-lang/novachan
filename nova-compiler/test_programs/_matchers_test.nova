// KAT for std/testing/matchers.
// Asserts return values of all public matchr_ functions.
import std/testing/matchers

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // matchr_is_empty
    ckb("is_empty_empty_list",  matchr_is_empty([]), 1)
    ckb("is_empty_nonempty_list", matchr_is_empty([1]), 0)
    ckb("is_empty_empty_str",   matchr_is_empty(""), 1)
    ckb("is_empty_nonempty_str", matchr_is_empty("x"), 0)
    let ed = {}
    ckb("is_empty_empty_dict",  matchr_is_empty(ed), 1)
    let ned = {}
    ned["a"] = 1
    ckb("is_empty_nonempty_dict", matchr_is_empty(ned), 0)

    // matchr_is_sorted
    ckb("is_sorted_asc",    matchr_is_sorted([1, 2, 3]), 1)
    ckb("is_sorted_unsorted", matchr_is_sorted([1, 3, 2]), 0)
    ckb("is_sorted_empty",  matchr_is_sorted([]), 1)
    ckb("is_sorted_single", matchr_is_sorted([5]), 1)
    ckb("is_sorted_equal",  matchr_is_sorted([2, 2, 3]), 1)
    ckb("is_sorted_desc",   matchr_is_sorted([3, 2, 1]), 0)

    // matchr_is_unique
    ckb("is_unique_yes",   matchr_is_unique([1, 2, 3]), 1)
    ckb("is_unique_no",    matchr_is_unique([1, 2, 2]), 0)
    ckb("is_unique_empty", matchr_is_unique([]), 1)
    ckb("is_unique_dup_first", matchr_is_unique([5, 5, 6]), 0)

    // matchr_in_range
    ckb("in_range_mid",   matchr_in_range(5, 1, 10), 1)
    ckb("in_range_above", matchr_in_range(11, 1, 10), 0)
    ckb("in_range_lo",    matchr_in_range(1, 1, 10), 1)
    ckb("in_range_hi",    matchr_in_range(10, 1, 10), 1)
    ckb("in_range_below", matchr_in_range(0, 1, 10), 0)

    // matchr_has_key
    let d = {}
    d["foo"] = 42
    ckb("has_key_yes", matchr_has_key(d, "foo"), 1)
    ckb("has_key_no",  matchr_has_key(d, "bar"), 0)

    // matchr_length
    ckb("length_list_yes", matchr_length([1, 2, 3], 3), 1)
    ckb("length_list_no",  matchr_length([1, 2, 3], 4), 0)
    ckb("length_str_yes",  matchr_length("hello", 5), 1)
    ckb("length_empty",    matchr_length([], 0), 1)

    // matchr_starts_with
    ckb("starts_with_yes",    matchr_starts_with("hello", "he"), 1)
    ckb("starts_with_no",     matchr_starts_with("hello", "wo"), 0)
    ckb("starts_with_empty",  matchr_starts_with("hello", ""), 1)
    ckb("starts_with_exact",  matchr_starts_with("hi", "hi"), 1)
    ckb("starts_with_longer", matchr_starts_with("hi", "hil"), 0)

    // matchr_between
    ckb("between_yes",    matchr_between(5, 1, 10), 1)
    ckb("between_at_lo",  matchr_between(1, 1, 10), 0)
    ckb("between_at_hi",  matchr_between(10, 1, 10), 0)
    ckb("between_below",  matchr_between(0, 1, 10), 0)
    ckb("between_above",  matchr_between(11, 1, 10), 0)

    print("_matchers_test passed")
