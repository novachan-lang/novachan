// _bearing_test.nova — KAT for std/geo/bearing
import std/geo/bearing

fn check(label, got, expected, tol)
    let d = got - expected
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad > tol
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // Due north: (0,0) -> (1,0) = 0 degrees
    let bn = bearing(0.0, 0.0, 1.0, 0.0)
    check("bearing due north", bn, 0.0, 0.5)

    // Due east: (0,0) -> (0,1) = 90 degrees
    let be = bearing(0.0, 0.0, 0.0, 1.0)
    check("bearing due east", be, 90.0, 0.5)

    // Due south: (0,0) -> (-1,0) = 180 degrees
    let bs = bearing(0.0, 0.0, -1.0, 0.0)
    check("bearing due south", bs, 180.0, 0.5)

    print("PASS _bearing_test")
