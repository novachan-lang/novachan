import std/core/retry

fn main() -> int
    let fails = 0

    let cfg = retry_config(5, 100, 2000)

    // exponential backoff: 100, 200, 400, 800, 1600, then capped at 2000
    if retry_delay(cfg, 0) != 100
        print("FAIL delay attempt 0")
        fails = fails + 1
    if retry_delay(cfg, 1) != 200
        print("FAIL delay attempt 1")
        fails = fails + 1
    if retry_delay(cfg, 2) != 400
        print("FAIL delay attempt 2")
        fails = fails + 1
    if retry_delay(cfg, 3) != 800
        print("FAIL delay attempt 3")
        fails = fails + 1
    if retry_delay(cfg, 4) != 1600
        print("FAIL delay attempt 4")
        fails = fails + 1
    if retry_delay(cfg, 5) != 2000
        print("FAIL delay attempt 5 (capped)")
        fails = fails + 1
    if retry_delay(cfg, 9) != 2000
        print("FAIL delay attempt 9 (deep capped)")
        fails = fails + 1

    // should_retry boundary: attempt < max_attempts
    if retry_should_retry(cfg, 0) != 1
        print("FAIL should_retry 0")
        fails = fails + 1
    if retry_should_retry(cfg, 4) != 1
        print("FAIL should_retry 4")
        fails = fails + 1
    if retry_should_retry(cfg, 5) != 0
        print("FAIL should_retry boundary 5")
        fails = fails + 1
    if retry_should_retry(cfg, 6) != 0
        print("FAIL should_retry past boundary")
        fails = fails + 1

    // full delay sequence
    let delays = retry_delays(cfg)
    let expected = [100, 200, 400, 800, 1600]
    if len(delays) != len(expected)
        print("FAIL delays length")
        fails = fails + 1
    else
        for i in 0..len(expected)
            if delays[i] != expected[i]
                print("FAIL delays[{i}] = {delays[i]}")
                fails = fails + 1

    // budget-constrained delays: 100+200+400 = 700 fits, +800 = 1500 doesn't
    let budgeted = retry_with_budget(cfg, 700)
    let expected_budget = [100, 200, 400]
    if len(budgeted) != len(expected_budget)
        print("FAIL budget length")
        fails = fails + 1
    else
        for i in 0..len(expected_budget)
            if budgeted[i] != expected_budget[i]
                print("FAIL budgeted[{i}] = {budgeted[i]}")
                fails = fails + 1

    // budget too small for even the first delay -> empty list
    let none_fit = retry_with_budget(cfg, 50)
    if len(none_fit) != 0
        print("FAIL budget too small should be empty")
        fails = fails + 1

    // budget covering everything -> full sequence
    let all_fit = retry_with_budget(cfg, 100000)
    if len(all_fit) != len(expected)
        print("FAIL budget covering all")
        fails = fails + 1

    // circuit breaker: closed -> open at threshold -> closed on success
    let cb = circuit_state_new(3, 5000)
    if circuit_is_open(cb) != 0
        print("FAIL circuit starts closed")
        fails = fails + 1

    cb = circuit_record_failure(cb)
    if circuit_is_open(cb) != 0
        print("FAIL circuit still closed after 1 failure")
        fails = fails + 1
    if cb["failures"] != 1
        print("FAIL circuit failures count 1")
        fails = fails + 1

    cb = circuit_record_failure(cb)
    if circuit_is_open(cb) != 0
        print("FAIL circuit still closed after 2 failures")
        fails = fails + 1

    cb = circuit_record_failure(cb)
    if circuit_is_open(cb) != 1
        print("FAIL circuit should open at threshold")
        fails = fails + 1
    if cb["state"] != "open"
        print("FAIL circuit state field should be open")
        fails = fails + 1

    // further failures keep it open
    cb = circuit_record_failure(cb)
    if circuit_is_open(cb) != 1
        print("FAIL circuit should stay open")
        fails = fails + 1

    // success resets to closed
    cb = circuit_record_success(cb)
    if circuit_is_open(cb) != 0
        print("FAIL circuit should close on success")
        fails = fails + 1
    if cb["failures"] != 0
        print("FAIL circuit failures should reset to 0")
        fails = fails + 1

    // one more failure after reset should NOT immediately reopen (threshold=3)
    cb = circuit_record_failure(cb)
    if circuit_is_open(cb) != 0
        print("FAIL circuit reopened too early after reset")
        fails = fails + 1

    if fails == 0
        print("RETRY KAT PASS")
    else
        print("FAILED _kat_retry")
    return 0
