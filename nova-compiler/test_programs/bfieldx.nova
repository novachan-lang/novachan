// bfieldx -- bitfields with a target-stable layout. Define a record layout once
// ([[name, width], ...]); pack a {name: value} dict into a deterministic big-endian
// bit-packed byte list, and unpack bytes back into a {name: value} dict. Layout is
// explicit + portable (no compiler/ABI-dependent field ordering), so the same bytes
// are produced on every target -- ideal for wire protocols and binary file headers.

type BitField
    layout: list

fn bitfield(layout)
    return BitField(layout)

fn bf_width(bf)
    let t = 0
    for f in bf.layout
        t = t + f[1]
    return t

fn bf_pack(bf, values)                 // {name: value} -> byte list
    let acc = 0
    let nbits = 0
    let out = []
    for f in bf.layout
        let name = f[0]
        let width = f[1]
        let v = 0
        if contains(values, name)
            v = values[name]
        let i = width - 1
        while i >= 0
            let bit = (v >> i) & 1
            acc = (acc << 1) | bit       // MSB-first (big-endian, target-stable)
            nbits = nbits + 1
            if nbits == 8
                push(out, acc)
                acc = 0
                nbits = 0
            i = i - 1
    if nbits > 0
        acc = acc << (8 - nbits)
        push(out, acc)
    return out

fn bf_unpack(bf, bytes)                // byte list -> {name: value}
    let result = {}
    let bytepos = 0
    let bitpos = 0
    for f in bf.layout
        let name = f[0]
        let width = f[1]
        let value = 0
        let k = 0
        while k < width
            let bit = 0
            if bytepos < len(bytes)
                bit = (bytes[bytepos] >> (7 - bitpos)) & 1
            value = (value << 1) | bit
            bitpos = bitpos + 1
            if bitpos == 8
                bitpos = 0
                bytepos = bytepos + 1
            k = k + 1
        result[name] = value
    return result

fn main()
    // an IPv4-style header prefix: version:4, ihl:4, tos:8, total_length:16
    let ip = bitfield([["version", 4], ["ihl", 4], ["tos", 8], ["total_length", 16]])
    assert_eq(bf_width(ip), 32)
    let packed = bf_pack(ip, {"version": 4, "ihl": 5, "tos": 0, "total_length": 1500})
    assert_eq(packed, [69, 0, 5, 220])              // 0x45 0x00 0x05 0xDC
    let f = bf_unpack(ip, packed)
    assert_eq(f["version"], 4)
    assert_eq(f["ihl"], 5)
    assert_eq(f["tos"], 0)
    assert_eq(f["total_length"], 1500)

    // a compact flags+counter record: enabled:1, mode:3, count:12 (16 bits)
    let rec = bitfield([["enabled", 1], ["mode", 3], ["count", 12]])
    assert_eq(bf_width(rec), 16)
    let p2 = bf_pack(rec, {"enabled": 1, "mode": 5, "count": 2047})
    let g2 = bf_unpack(rec, p2)
    assert_eq(g2["enabled"], 1)
    assert_eq(g2["mode"], 5)
    assert_eq(g2["count"], 2047)

    // missing field defaults to 0; round-trips deterministically
    let p3 = bf_pack(rec, {"mode": 2})
    let g3 = bf_unpack(rec, p3)
    assert_eq(g3["enabled"], 0)
    assert_eq(g3["mode"], 2)
    assert_eq(g3["count"], 0)

    print("bfieldx passed")
