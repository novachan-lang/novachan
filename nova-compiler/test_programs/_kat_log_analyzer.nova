import forge_log_analyzer

fn main()
    let s = la_new()
    s = la_ingest(s, "info", "server started", "web1")
    s = la_ingest(s, "info", "request handled", "web1")
    s = la_ingest(s, "warn", "slow query", "db1")
    s = la_ingest(s, "error", "connection refused", "db1")
    s = la_ingest(s, "error", "timeout", "web1")
    s = la_ingest(s, "fatal", "out of memory", "web2")

    assert(la_total_entries(s) == 6, "6 entries ingested")
    assert(la_count_by_level(s, "info") == 2, "2 info")
    assert(la_count_by_level(s, "warn") == 1, "1 warn")
    assert(la_count_by_level(s, "error") == 2, "2 error")
    assert(la_count_by_level(s, "fatal") == 1, "1 fatal")
    assert(la_count_by_level(s, "debug") == 0, "unknown level counts 0")

    let er = la_error_rate(s)
    assert(is_ok(er), "error rate ok")
    assert(unwrap(er) == 50, "3 of 6 = 50% error+fatal")

    let le = la_last_error(s)
    assert(is_ok(le), "last error ok")
    assert(unwrap(le) == "out of memory", "last error/fatal message")

    assert(la_source_count(s, "web1") == 3, "3 entries from web1")
    assert(la_source_count(s, "db1") == 2, "2 entries from db1")
    assert(la_source_count(s, "web2") == 1, "1 entry from web2")
    assert(la_source_count(s, "ghost") == 0, "0 entries from unseen source")

    assert(la_has_fatal(s) == 1, "has_fatal true")

    let e0 = la_entry_at(s, 0)
    assert(is_ok(e0), "entry 0 ok")
    assert(unwrap(e0) == "info:server started", "entry 0 content")

    let e5 = la_entry_at(s, 5)
    assert(unwrap(e5) == "fatal:out of memory", "entry 5 content")

    let ebad = la_entry_at(s, 99)
    assert(is_err(ebad), "out-of-bounds index errors")

    let eneg = la_entry_at(s, -1)
    assert(is_err(eneg), "negative index errors")

    // fresh analyzer: no fatal, no errors, empty error_rate
    let s2 = la_new()
    assert(la_has_fatal(s2) == 0, "fresh analyzer has no fatal")
    let er2 = la_error_rate(s2)
    assert(is_err(er2), "error rate on empty analyzer errs")
    let le2 = la_last_error(s2)
    assert(is_err(le2), "last error on empty analyzer errs")

    print("LOG-ANALYZER KAT PASS")
