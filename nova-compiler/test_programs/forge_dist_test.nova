// Forge S11: distribution protocol (the unit-testable layer). The fn-id registry resolves a name to a
// function and calls it (the indirection that lets functions "ship by name"); the spawn-request and
// message envelopes round-trip through JSON. The live 2-node run is deferred (DISTRIBUTION_DESIGN.md).
// Socketless, deterministic.
import forge_dist

fn greet(x)
    "hi " + x

fn main()
    // registry: register a fn by name, look it up, CALL it
    let reg = dist_registry()
    dist_register(reg, "greet", greet)
    let f = dist_lookup(reg, "greet")
    if f("bob") != "hi bob"
        print("FAIL: registry lookup + call")
        exit(1)

    // spawn request round-trips
    let dec = dist_decode_spawn(dist_encode_spawn("greet", ["bob", "42"]))
    if dec[0] != "greet" or len(dec[1]) != 2 or dec[1][0] != "bob" or dec[1][1] != "42"
        print("FAIL: spawn request round-trip")
        exit(1)

    // message envelope round-trips
    let mdec = dist_decode_msg(dist_encode_msg(7, "ping"))
    if mdec[0] != 7 or mdec[1] != "ping"
        print("FAIL: msg envelope round-trip")
        exit(1)

    print("PASS forge_dist (fn-id registry call + spawn/msg envelope JSON round-trip)")
