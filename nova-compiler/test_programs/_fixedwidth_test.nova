// KAT test for std/data/fixedwidth
// All assertions are against published / hand-verified vectors.
// Any failure prints a message and exits with code 1.

import std/data/fixedwidth

// ── Helper ────────────────────────────────────────────────────────────────────

fn cks(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got=" + got + " expected=" + expected)
        exit(1)

fn cki(got, expected, label)
    if got != expected
        print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn check_list_eq(got, expected, label)
    let ng = len(got)
    let ne = len(expected)
    if ng != ne
        print("FAIL " + label + " length: got=" + str(ng) + " expected=" + str(ne))
        exit(1)
    let i = 0
    while i < ng
        let gv = got[i]
        let ev = expected[i]
        if gv != ev
            print("FAIL " + label + "[" + str(i) + "]: got=" + gv + " expected=" + ev)
            exit(1)
        i = i + 1

// ── KAT 1: fxw_parse basic three-column record ────────────────────────────────
// "Alice  30NYC    " with widths [7,2,7]
// Column 0: "Alice  " -> "Alice"
// Column 1: "30"       -> "30"
// Column 2: "NYC    " -> "NYC"
let w1 = [7, 2, 7]
let r1 = fxw_parse("Alice  30NYC    ", w1)
let e1 = ["Alice", "30", "NYC"]
check_list_eq(r1, e1, "KAT1_parse_three_cols")

// ── KAT 2: fxw_format basic two-column record ─────────────────────────────────
// fields=["Bob","25"], widths=[5,3]
// "Bob" padded to 5 -> "Bob  "
// "25"  padded to 3 -> "25 "
// combined: "Bob  25 "
let f2 = ["Bob", "25"]
let w2 = [5, 3]
let r2 = fxw_format(f2, w2)
cks(r2, "Bob  25 ", "KAT2_format_two_cols")

// ── KAT 3: fxw_parse two equal-width columns ──────────────────────────────────
// "ab  cd  " with widths [4,4]
// Column 0: "ab  " -> "ab"
// Column 1: "cd  " -> "cd"
let w3 = [4, 4]
let r3 = fxw_parse("ab  cd  ", w3)
let e3 = ["ab", "cd"]
check_list_eq(r3, e3, "KAT3_parse_equal_widths")

// ── KAT 4: fxw_format truncation when field exceeds width ─────────────────────
// fields=["toolong"], widths=[4]
// "toolong" has 7 chars; width=4 -> truncate to "tool"
let f4 = ["toolong"]
let w4 = [4]
let r4 = fxw_format(f4, w4)
cks(r4, "tool", "KAT4_format_truncate")

// ── KAT 5: fxw_parse_all two-line input ──────────────────────────────────────
// "aa01\nbb02" with widths [2,2]
// row 0: "aa01" -> ["aa","01"]
// row 1: "bb02" -> ["bb","02"]
let nl = chr(10)
let text5 = "aa01" + nl + "bb02"
let w5 = [2, 2]
let rows5 = fxw_parse_all(text5, w5)
cki(len(rows5), 2, "KAT5_parse_all_len")
let e5a = ["aa", "01"]
let e5b = ["bb", "02"]
check_list_eq(rows5[0], e5a, "KAT5_row0")
check_list_eq(rows5[1], e5b, "KAT5_row1")

// ── KAT 6: fxw_parse_all skips blank lines ───────────────────────────────────
// A trailing newline produces an empty line which must be skipped.
let text6 = "xx99" + nl + nl + "yy88" + nl
let w6 = [2, 2]
let rows6 = fxw_parse_all(text6, w6)
cki(len(rows6), 2, "KAT6_skip_blank")
let e6a = ["xx", "99"]
let e6b = ["yy", "88"]
check_list_eq(rows6[0], e6a, "KAT6_row0")
check_list_eq(rows6[1], e6b, "KAT6_row1")

// ── KAT 7: fxw_parse short line (line shorter than total width) ───────────────
// "Hi" with widths [5,5]: both columns effectively get "" after trim
let r7 = fxw_parse("Hi", [5, 5])
cks(r7[0], "Hi", "KAT7_col0")
cks(r7[1], "", "KAT7_col1")

// ── KAT 8: fxw_format exact-fit (no padding, no truncation) ──────────────────
// fields=["ABC"], widths=[3] -> "ABC" (exact, no change)
let r8 = fxw_format(["ABC"], [3])
cks(r8, "ABC", "KAT8_exact_fit")

print("_fixedwidth_test passed")
