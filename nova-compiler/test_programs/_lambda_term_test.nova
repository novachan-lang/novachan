import std/lambda/lambda_term

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn ckb(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// ckt: structural term equality check using lmt_equal
fn ckt(label, a, b)
    let eq = lambda_term.lmt_equal(a, b)
    if eq == 0
        print("FAIL " + label + ": terms not equal")
        exit(1)

fn main()
    // KAT 1: lmt_var(0) == ["var",0]
    let v0 = lambda_term.lmt_var(0)
    let exp_v0 = []
    push(exp_v0, "var")
    push(exp_v0, 0)
    ckt("lmt_var(0)", v0, exp_v0)

    // KAT 2: lmt_is_lam(lmt_lam(lmt_var(0))) = true (1)
    let id_lam = lambda_term.lmt_lam(lambda_term.lmt_var(0))
    cki("lmt_is_lam_true", lambda_term.lmt_is_lam(id_lam), 1)

    // KAT 3: lmt_equal(lmt_lam(lmt_var(0)), lmt_lam(lmt_var(0))) = true
    let id2 = lambda_term.lmt_lam(lambda_term.lmt_var(0))
    cki("lmt_equal_lam_lam", lambda_term.lmt_equal(id_lam, id2), 1)

    // KAT 4: lmt_equal(lmt_var(0), lmt_var(1)) = false
    let v1 = lambda_term.lmt_var(1)
    cki("lmt_equal_var_diff", lambda_term.lmt_equal(v0, v1), 0)

    // KAT 5: lmt_size(["app",["lam",["var",0]],["var",1]]) = 4
    // Build: app (lam (var 0)) (var 1)
    let inner_lam = lambda_term.lmt_lam(lambda_term.lmt_var(0))
    let outer_var1 = lambda_term.lmt_var(1)
    let app_term = lambda_term.lmt_app(inner_lam, outer_var1)
    cki("lmt_size_app_lam_var", lambda_term.lmt_size(app_term), 4)

    // KAT 6: lmt_is_closed(["lam",["var",0]]) = true
    // lambda x.x — var 0 is bound by the lambda
    let closed_id = lambda_term.lmt_lam(lambda_term.lmt_var(0))
    cki("lmt_is_closed_id", lambda_term.lmt_is_closed(closed_id), 1)

    // KAT 7: lmt_is_closed(["var",0]) = false
    // A bare var 0 at depth 0 is free
    cki("lmt_is_closed_var0", lambda_term.lmt_is_closed(lambda_term.lmt_var(0)), 0)

    // KAT 8: lmt_is_closed(["lam",["var",1]]) = false
    // Under the lam (depth=1), var 1 has index >= 1, so it is free
    let bad_lam = lambda_term.lmt_lam(lambda_term.lmt_var(1))
    cki("lmt_is_closed_lam_var1", lambda_term.lmt_is_closed(bad_lam), 0)

    // Additional: lmt_is_var, lmt_is_app checks
    cki("lmt_is_var_true", lambda_term.lmt_is_var(v0), 1)
    cki("lmt_is_var_lam", lambda_term.lmt_is_var(id_lam), 0)
    cki("lmt_is_app_true", lambda_term.lmt_is_app(app_term), 1)
    cki("lmt_is_app_lam", lambda_term.lmt_is_app(id_lam), 0)

    // Size of a simple var = 1
    cki("lmt_size_var", lambda_term.lmt_size(lambda_term.lmt_var(5)), 1)
    // Size of a lam = 1 + size of body
    cki("lmt_size_lam", lambda_term.lmt_size(id_lam), 2)

    // lmt_is_closed for a closed nested term: lambda x. lambda y. x = ["lam",["lam",["var",1]]]
    // Under outer lam (d=1), under inner lam (d=2), var 1 < 2 => bound
    let kxy = lambda_term.lmt_lam(lambda_term.lmt_lam(lambda_term.lmt_var(1)))
    cki("lmt_is_closed_kxy", lambda_term.lmt_is_closed(kxy), 1)

    print("PASS _lambda_term_test")

main()
