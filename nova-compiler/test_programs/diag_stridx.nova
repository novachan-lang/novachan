// Diagnostic: heavy string indexing (the core lexer pattern)

fn tokenize_heavy(source: string) -> list
    let tokens = []
    let pos = 0
    let length = len(source)

    while pos < length
        let ch = source[pos]
        if ch == " "
            pos = pos + 1
        else if ch == "\n"
            pos = pos + 1
        else if ch == "/"
            if pos + 1 < length and source[pos + 1] == "/"
                while pos < length and source[pos] != "\n"
                    pos = pos + 1
            else
                pos = pos + 1
        else if ch == "\""
            pos = pos + 1
            let s = ""
            while pos < length and source[pos] != "\""
                if source[pos] == "\\"
                    pos = pos + 1
                    if pos < length
                        let esc = source[pos]
                        if esc == "n"
                            s = s + "\n"
                        else if esc == "t"
                            s = s + "\t"
                        else
                            s = s + esc
                else
                    s = s + source[pos]
                pos = pos + 1
            if pos < length
                pos = pos + 1
            push(tokens, s)
        else if ch == "=" and pos + 1 < length and source[pos + 1] == ">"
            push(tokens, "=>")
            pos = pos + 2
        else if ch == "!" and pos + 1 < length and source[pos + 1] == "="
            push(tokens, "!=")
            pos = pos + 2
        else if ch == "<" and pos + 1 < length and source[pos + 1] == "="
            push(tokens, "<=")
            pos = pos + 2
        else if ch == ">" and pos + 1 < length and source[pos + 1] == "="
            push(tokens, ">=")
            pos = pos + 2
        else
            let word = ""
            while pos < length and source[pos] != " " and source[pos] != "\n"
                word = word + source[pos]
                pos = pos + 1
            push(tokens, word)

    tokens

// Test with a multi-line source containing strings, comments, operators
let source = "fn hello(name)\n    // greet\n    let msg = \"Hello \" + name\n    if x >= 10 and y != 5\n        return msg\n    else\n        return \"default\"\n"
let toks = tokenize_heavy(source)
print(len(toks))
for t in toks
    print(t)
print("DONE")
