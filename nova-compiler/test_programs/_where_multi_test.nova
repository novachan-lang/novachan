let area = width * height where
    width = 10
    height = 20
assert(area == 200, "multi-line where basic")

let vol = l * w * h where
    l = 3
    w = 4
    h = 5
assert(vol == 60, "multi-line where 3 bindings")

let msg = upper(s) where
    s = "hello"
assert(msg == "HELLO", "multi-line where function call")

let total = a + b where a = 1, b = 2
assert(total == 3, "single-line where still works")

let doubled = map(nums, fn(x) x * 2) where
    nums = [1, 2, 3]
assert(doubled == [2, 4, 6], "multi-line where lambda")

let hyp = sqrt(dx * dx + dy * dy) where
    dx = 3.0
    dy = 4.0
assert(hyp == 5.0, "multi-line where math")

print("all multi-line where tests passed")
