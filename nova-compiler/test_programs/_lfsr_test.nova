// KAT for std/random/lfsr
//
// Anchors verified against a Python reference implementation:
//   galois seed=0xACE1 (44257), poly=0xB400 (46080)
//     step 1 register = 57968  (0xE270)  [lsb=1 -> r>>1 ^ 0xB400]
//     step 2 register = 28984  (0x7138)
//     step 3 register = 14492  (0x389C)
//   galois_bits(seed=44257, k=8) = 225   (0xE1, LSB-first)
//     register after 8 bits = 49860    (0xC2C4)
//   galois period from 0xACE1 = 65535 (maximal)
//
//   fibonacci seed=0xACE1 (44257), taps 16,14,13,11
//     step 1 register = 22979  (0x59C3)
//     step 2 register = 45959  (0xB387)
//     step 3 register = 26383  (0x670F)
//   fib period from 0xACE1 = 65535 (maximal)
//
//   galois_next_range(seed=44257, n=10) = 57968 % 10 = 8
//   fib_next_range(seed=44257, n=10)   = 22979 % 10 = 9

import std/random/lfsr

fn main()
    // ── KAT 1: galois step 1 concrete register value ────────────────────────
    let g1 = galois_seed(44257)
    let gv1 = galois_next(g1)
    if gv1 != 57968
        print("FAIL lfsr KAT1: galois step1 got " + str(gv1) + " want 57968")
        exit(1)

    // ── KAT 2: galois step 2 concrete register value ────────────────────────
    let gv2 = galois_next(g1)
    if gv2 != 28984
        print("FAIL lfsr KAT2: galois step2 got " + str(gv2) + " want 28984")
        exit(1)

    // ── KAT 3: galois step 3 concrete register value ────────────────────────
    let gv3 = galois_next(g1)
    if gv3 != 14492
        print("FAIL lfsr KAT3: galois step3 got " + str(gv3) + " want 14492")
        exit(1)

    // ── KAT 4: determinism — two galois generators seeded the same ──────────
    let ga = galois_seed(44257)
    let ga1 = galois_next(ga)
    let ga2 = galois_next(ga)
    let gb = galois_seed(44257)
    let gb1 = galois_next(gb)
    let gb2 = galois_next(gb)
    if ga1 != gb1
        print("FAIL lfsr KAT4a: determinism galois step1 " + str(ga1) + " != " + str(gb1))
        exit(1)
    if ga2 != gb2
        print("FAIL lfsr KAT4b: determinism galois step2 " + str(ga2) + " != " + str(gb2))
        exit(1)

    // ── KAT 5: galois_bits(seed=44257, k=8) = 225 ──────────────────────────
    let gb8 = galois_seed(44257)
    let bits8 = galois_bits(gb8, 8)
    if bits8 != 225
        print("FAIL lfsr KAT5: galois_bits k=8 got " + str(bits8) + " want 225")
        exit(1)

    // ── KAT 6: galois register after galois_bits 8 = 49860 ──────────────────
    let reg_after = gb8["r"]
    if reg_after != 49860
        print("FAIL lfsr KAT6: register after galois_bits(8) got " + str(reg_after) + " want 49860")
        exit(1)

    // ── KAT 7: galois_next_range in [0, n) for n=10 ─────────────────────────
    let gr10 = galois_seed(44257)
    let rv10 = galois_next_range(gr10, 10)
    if rv10 != 8
        print("FAIL lfsr KAT7: galois_next_range(10) got " + str(rv10) + " want 8")
        exit(1)

    // ── KAT 8: galois_next_range stays in bounds over 1000 steps ────────────
    let gr_stress = galois_seed(12345)
    let gi = 0
    while gi < 1000
        let rv = galois_next_range(gr_stress, 100)
        if rv < 0
            print("FAIL lfsr KAT8a: galois_next_range < 0 at step " + str(gi))
            exit(1)
        if rv > 99
            print("FAIL lfsr KAT8b: galois_next_range >= 100 at step " + str(gi))
            exit(1)
        gi = gi + 1

    // ── KAT 9: galois period = 65535 (returns to seed after 65535 steps) ────
    let gp = galois_seed(44257)
    let period_i = 0
    galois_next(gp)
    period_i = 1
    while gp["r"] != 44257
        galois_next(gp)
        period_i = period_i + 1
        if period_i > 65536
            print("FAIL lfsr KAT9: galois period exceeded 65536 (stuck or wrong poly)")
            exit(1)
    if period_i != 65535
        print("FAIL lfsr KAT9: galois period got " + str(period_i) + " want 65535")
        exit(1)

    // ── KAT 10: galois seed=0 promoted to 1 ─────────────────────────────────
    let g0 = galois_seed(0)
    let g0r = g0["r"]
    if g0r != 1
        print("FAIL lfsr KAT10: galois_seed(0) register got " + str(g0r) + " want 1")
        exit(1)

    // ── KAT 11: fib step 1 concrete register value ──────────────────────────
    let f1 = fib_seed(44257)
    let fv1 = fib_next(f1)
    if fv1 != 22979
        print("FAIL lfsr KAT11: fib step1 got " + str(fv1) + " want 22979")
        exit(1)

    // ── KAT 12: fib step 2 concrete register value ──────────────────────────
    let fv2 = fib_next(f1)
    if fv2 != 45959
        print("FAIL lfsr KAT12: fib step2 got " + str(fv2) + " want 45959")
        exit(1)

    // ── KAT 13: fib step 3 concrete register value ──────────────────────────
    let fv3 = fib_next(f1)
    if fv3 != 26383
        print("FAIL lfsr KAT13: fib step3 got " + str(fv3) + " want 26383")
        exit(1)

    // ── KAT 14: fib determinism ─────────────────────────────────────────────
    let fa = fib_seed(44257)
    let fa1 = fib_next(fa)
    let fa2 = fib_next(fa)
    let fb2 = fib_seed(44257)
    let fb1v = fib_next(fb2)
    let fb2v = fib_next(fb2)
    if fa1 != fb1v
        print("FAIL lfsr KAT14a: fib determinism step1 " + str(fa1) + " != " + str(fb1v))
        exit(1)
    if fa2 != fb2v
        print("FAIL lfsr KAT14b: fib determinism step2 " + str(fa2) + " != " + str(fb2v))
        exit(1)

    // ── KAT 15: fib_next_range = 9 ──────────────────────────────────────────
    let fr10 = fib_seed(44257)
    let frv10 = fib_next_range(fr10, 10)
    if frv10 != 9
        print("FAIL lfsr KAT15: fib_next_range(10) got " + str(frv10) + " want 9")
        exit(1)

    // ── KAT 16: fib_next_range stays in bounds over 1000 steps ─────────────
    let fr_stress = fib_seed(99999)
    let fi = 0
    while fi < 1000
        let frv = fib_next_range(fr_stress, 100)
        if frv < 0
            print("FAIL lfsr KAT16a: fib_next_range < 0 at step " + str(fi))
            exit(1)
        if frv > 99
            print("FAIL lfsr KAT16b: fib_next_range >= 100 at step " + str(fi))
            exit(1)
        fi = fi + 1

    // ── KAT 17: fib period = 65535 ──────────────────────────────────────────
    let fp = fib_seed(44257)
    let fperiod = 0
    fib_next(fp)
    fperiod = 1
    while fp["r"] != 44257
        fib_next(fp)
        fperiod = fperiod + 1
        if fperiod > 65536
            print("FAIL lfsr KAT17: fib period exceeded 65536")
            exit(1)
    if fperiod != 65535
        print("FAIL lfsr KAT17: fib period got " + str(fperiod) + " want 65535")
        exit(1)

    // ── KAT 18: different seeds produce different sequences ──────────────────
    let gx = galois_seed(1)
    let gy = galois_seed(2)
    let gxv = galois_next(gx)
    let gyv = galois_next(gy)
    if gxv == gyv
        print("FAIL lfsr KAT18: galois seed 1 and 2 produced same first output " + str(gxv))
        exit(1)

    // ── KAT 19: galois_bits k=0 returns 0 ───────────────────────────────────
    let gb0 = galois_seed(44257)
    let bits0 = galois_bits(gb0, 0)
    if bits0 != 0
        print("FAIL lfsr KAT19: galois_bits(0) got " + str(bits0) + " want 0")
        exit(1)

    // ── KAT 20: 16-bit output — galois_next always in [0, 65535] ────────────
    let grange = galois_seed(7)
    let gri = 0
    while gri < 100
        let gout = galois_next(grange)
        if gout < 0
            print("FAIL lfsr KAT20a: galois_next < 0 at step " + str(gri))
            exit(1)
        if gout > 65535
            print("FAIL lfsr KAT20b: galois_next > 65535 at step " + str(gri))
            exit(1)
        gri = gri + 1

    print("PASS _lfsr_test")
