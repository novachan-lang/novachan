import forge_majority

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn joinl(xs: list) -> string
    let out = ""
    let i = 0
    while i < len(xs)
        if i > 0
            out = out + ","
        out = out + str(xs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    // majority element
    let m1 = majority_element([3, 3, 4, 2, 3, 3, 3])
    fails = fails + expect("maj_yes", str(m1[0]) + ":" + str(m1[1]), "1:3")
    let m2 = majority_element([1, 2, 3, 4])
    fails = fails + expect("maj_no", str(m2[0]), "0")
    let m3 = majority_element([2, 2, 1, 1, 1, 2, 2])
    fails = fails + expect("maj_2", str(m3[0]) + ":" + str(m3[1]), "1:2")
    let m4 = majority_element([5])
    fails = fails + expect("maj_single", str(m4[0]) + ":" + str(m4[1]), "1:5")
    let m5 = majority_element([7, 7, 7, 7])
    fails = fails + expect("maj_all", str(m5[0]) + ":" + str(m5[1]), "1:7")
    // exactly half is NOT a majority (strictly more than half required)
    let m6 = majority_element([1, 1, 2, 2])
    fails = fails + expect("maj_half", str(m6[0]), "0")

    // has_majority
    fails = fails + expect("has_yes", str(has_majority([1, 1, 2])), "true")
    fails = fails + expect("has_no", str(has_majority([1, 2, 3])), "false")

    // frequent over a third (0, 1 or 2 values)
    fails = fails + expect("f3_one", joinl(frequent_over_third([1, 1, 1, 2, 3, 4, 5])), "1")
    fails = fails + expect("f3_two", joinl(frequent_over_third([1, 2, 1, 2, 1, 2, 3])), "1,2")
    fails = fails + expect("f3_none", joinl(frequent_over_third([1, 2, 3, 4, 5, 6])), "")
    fails = fails + expect("f3_all", joinl(frequent_over_third([3, 3, 3, 3])), "3")
    fails = fails + expect("f3_two_ordered", joinl(frequent_over_third([9, 8, 9, 8, 9, 8])), "8,9")

    if fails == 0
        print("forge_majority: all passed")
    else
        print("forge_majority: " + str(fails) + " FAILED")
