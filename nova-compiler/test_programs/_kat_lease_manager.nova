import forge_lease_manager

fn main()
    let lm = lm_new()
    let ok = lm_acquire(lm, "db-lock", "node-1", 100, 1000)
    assert(ok == 1, "acquired")
    assert(lm_owner(lm, "db-lock") == "node-1", "owner is node-1")
    assert(lm_is_held(lm, "db-lock", 1050) == 1, "still held at 1050")
    assert(lm_ttl_remaining(lm, "db-lock", 1050) == 50, "50 remaining")

    let fail = lm_acquire(lm, "db-lock", "node-2", 100, 1050)
    assert(fail == 0, "node-2 cant acquire held lease")

    let reacq = lm_acquire(lm, "db-lock", "node-1", 200, 1050)
    assert(reacq == 1, "owner can reacquire")

    let expired = lm_is_held(lm, "db-lock", 1500)
    assert(expired == 0, "expired at 1500")
    let take = lm_acquire(lm, "db-lock", "node-2", 100, 1500)
    assert(take == 1, "node-2 takes expired lease")
    assert(lm_owner(lm, "db-lock") == "node-2", "new owner")

    let renewed = lm_renew(lm, "db-lock", "node-2", 200, 1500)
    assert(renewed == 1, "renewed")
    assert(lm_ttl_remaining(lm, "db-lock", 1550) == 150, "150 after renew")

    let wrong = lm_renew(lm, "db-lock", "node-1", 100, 1500)
    assert(wrong == 0, "cant renew others lease")

    let rel = lm_release(lm, "db-lock", "node-2")
    assert(rel == 1, "released")
    assert(lm_is_held(lm, "db-lock", 1500) == 0, "not held after release")

    assert(lm_owner(lm, "missing") == "", "no owner for missing")
    assert(lm_is_held(lm, "missing", 0) == 0, "missing not held")

    print("LEASE-MANAGER KAT PASS")
