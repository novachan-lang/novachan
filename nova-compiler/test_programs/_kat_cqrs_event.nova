import forge_cqrs_event

fn main()
    let store = es_store_new()
    let d1 = {}
    d1["name"] = "Alice"
    d1["email"] = "alice@test.com"
    store = es_append(store, "user-1", "UserCreated", d1)

    let d2 = {}
    d2["email"] = "alice@new.com"
    store = es_append(store, "user-1", "EmailChanged", d2)

    let d3 = {}
    d3["name"] = "Bob"
    store = es_append(store, "user-2", "UserCreated", d3)

    assert(es_count(store) == 3, "3 events")
    assert(es_latest_version(store) == 3, "version 3")

    let u1_events = es_events_for(store, "user-1")
    assert(len(u1_events) == 2, "user-1 has 2 events")
    assert(u1_events[0]["type"] == "UserCreated", "first event")
    assert(u1_events[1]["type"] == "EmailChanged", "second event")

    let created = es_events_by_type(store, "UserCreated")
    assert(len(created) == 2, "2 UserCreated events")

    let init = {}
    let state = es_project(store, "user-1", init)
    assert(state["name"] == "Alice", "projected name")
    assert(state["email"] == "alice@new.com", "projected email (latest)")

    let snap_state = {}
    snap_state["name"] = "Alice"
    snap_state["email"] = "alice@test.com"
    store = es_snapshot(store, "user-1", snap_state, 1)

    let snap = es_get_snapshot(store, "user-1")
    assert(snap["version"] == 1, "snapshot at v1")
    assert(snap["state"]["name"] == "Alice", "snapshot name")

    let since = es_events_since(store, "user-1", 1)
    assert(len(since) == 1, "1 event since v1")
    assert(since[0]["type"] == "EmailChanged", "EmailChanged since v1")

    let missing_snap = es_get_snapshot(store, "user-99")
    assert(missing_snap["version"] == 0, "no snapshot = v0")

    print("CQRS-EVENT KAT PASS")
