// KAT test for std/util/idgen
//
// Hand-computed expected values:
//
//   g = ig_new("item-")        => {prefix:"item-", n:0}
//   ig_next(g)                 => n becomes 1, returns "item-1"
//   ig_next(g)                 => n becomes 2, returns "item-2"
//   ig_current(g)              => 2 (no side effect)
//   ig_next_padded(g, 4)       => n becomes 3, pad(3,4)="0003", returns "item-0003"
//   g2 = ig_new("")            => {prefix:"", n:0}
//   ig_next(g2)                => n becomes 1, returns "" + "1" = "1"
//   ig_reset(g)                => g.n = 0
//   ig_current(g)              => 0
//   ig_next(g)                 => n becomes 1 again, returns "item-1"

import std/util/idgen

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got [" + got + "] want [" + want + "]")
        exit(1)

fn main()
    // ── Construct ─────────────────────────────────────────────────────────────
    let g = ig_new("item-")
    cki("initial_n", ig_current(g), 0)

    // ── ig_next produces sequential strings ───────────────────────────────────
    let v1 = ig_next(g)
    cks("next1", v1, "item-1")
    cki("after_next1", ig_current(g), 1)

    let v2 = ig_next(g)
    cks("next2", v2, "item-2")
    cki("after_next2", ig_current(g), 2)

    // ── ig_current is a pure read — does not advance ──────────────────────────
    cki("current_idempotent_a", ig_current(g), 2)
    cki("current_idempotent_b", ig_current(g), 2)

    // ── ig_next_padded zero-pads ──────────────────────────────────────────────
    let v3 = ig_next_padded(g, 4)
    cks("next_padded_4", v3, "item-0003")
    cki("after_padded", ig_current(g), 3)

    // ── Padding does not truncate when n >= 10^width ──────────────────────────
    // Verify for small n: pad(9,2)->"09", pad(10,2)->"10", pad(11,2)->"11"
    let gp = ig_new("")
    // advance to 8
    let ia = 0
    while ia < 8
        ig_next(gp)
        ia = ia + 1
    // current = 8; next_padded(2) should give "09"
    let vp9 = ig_next_padded(gp, 2)
    cks("padded_09", vp9, "09")
    // current = 9; next_padded(2) -> "10" (no truncation)
    let vp10 = ig_next_padded(gp, 2)
    cks("padded_10", vp10, "10")
    // current = 10; next_padded(2) -> "11"
    let vp11 = ig_next_padded(gp, 2)
    cks("padded_11", vp11, "11")

    // ── Empty prefix ─────────────────────────────────────────────────────────
    let g2 = ig_new("")
    let v_empty = ig_next(g2)
    cks("empty_prefix_next", v_empty, "1")

    // ── ig_reset restores n to 0 ──────────────────────────────────────────────
    ig_reset(g)
    cki("after_reset", ig_current(g), 0)

    // ── After reset, ig_next starts from 1 again ──────────────────────────────
    let v_after_reset = ig_next(g)
    cks("next_after_reset", v_after_reset, "item-1")
    cki("n_after_reset_next", ig_current(g), 1)

    // ── Multiple independent generators don't interfere ───────────────────────
    let ga = ig_new("a-")
    let gb = ig_new("b-")
    let a1 = ig_next(ga)
    let b1 = ig_next(gb)
    let a2 = ig_next(ga)
    cks("multi_a1", a1, "a-1")
    cks("multi_b1", b1, "b-1")
    cks("multi_a2", a2, "a-2")
    cki("multi_ga_n", ig_current(ga), 2)
    cki("multi_gb_n", ig_current(gb), 1)

    print("_idgen_test passed")
