import std/greedy/candy

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _candy_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + ".len", len(got), len(want))
    let i = 0
    while i < len(want)
        cki(label + "[" + str(i) + "]", got[i], want[i])
        i = i + 1

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _candy_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // KAT: cd_min_candies
    cki("kat_123",   cd_min_candies([1, 0, 2]),       5)
    cki("kat_122",   cd_min_candies([1, 2, 2]),       4)
    cki("kat_13221", cd_min_candies([1, 3, 2, 2, 1]), 7)
    cki("kat_single", cd_min_candies([1]),             1)
    cki("kat_empty",  cd_min_candies([]),              0)

    // KAT: cd_distribution [1,0,2] -> [2,1,2]
    let dist = cd_distribution([1, 0, 2])
    ckl("kat_dist_102", dist, [2, 1, 2])

    // Verify [1,2,2]: left pass gives [1,2,1], right pass: i=1>i=2? no; i=0>i=1? no; stays [1,2,1] -> sum=4
    let d122 = cd_distribution([1, 2, 2])
    cki("dist_122_sum", d122[0] + d122[1] + d122[2], 4)
    // each must be >= 1
    cki("dist_122_0ge1", d122[0] >= 1, 1)
    cki("dist_122_1ge1", d122[1] >= 1, 1)
    cki("dist_122_2ge1", d122[2] >= 1, 1)
    // rating[1]>rating[0] so candy[1]>candy[0]
    cki("dist_122_neighbor", d122[1] > d122[0], 1)
    // rating[2]==rating[1] so no strict constraint between them

    // Verify [1,3,2,2,1]: sum=7
    let d5 = cd_distribution([1, 3, 2, 2, 1])
    let s5 = d5[0] + d5[1] + d5[2] + d5[3] + d5[4]
    cki("dist_5_sum", s5, 7)
    // neighbor constraints: rating[1]=3>rating[0]=1 so d5[1]>d5[0]
    cki("dist_5_01", d5[1] > d5[0], 1)
    // rating[1]=3>rating[2]=2 so d5[1]>d5[2]
    cki("dist_5_12", d5[1] > d5[2], 1)
    // rating[4]=1<rating[3]=2 no constraint on d5[4] vs d5[3]
    // rating[3]=2>rating[4]=1 so d5[3]>d5[4]
    cki("dist_5_34", d5[3] > d5[4], 1)

    // Edge: all same ratings [3,3,3] -> each gets 1 candy, total=3
    cki("all_same", cd_min_candies([3, 3, 3]), 3)

    // Edge: strictly ascending [1,2,3,4] -> [1,2,3,4] total=10
    cki("ascending", cd_min_candies([1, 2, 3, 4]), 10)

    // Edge: strictly descending [4,3,2,1] -> [4,3,2,1] total=10
    cki("descending", cd_min_candies([4, 3, 2, 1]), 10)

    // Edge: two children equal ratings -> [1,1] total=2
    cki("two_equal", cd_min_candies([5, 5]), 2)

    // Edge: two children ascending [1,2] -> [1,2] total=3
    cki("two_asc", cd_min_candies([1, 2]), 3)

    print("PASS _candy_test")
