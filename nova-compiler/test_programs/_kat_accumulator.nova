import forge_accumulator

fn main()
    let a = acc_new()
    a = acc_add(a, 10)
    a = acc_add(a, 20)
    a = acc_add(a, 30)
    assert(acc_sum(a) == 60, "sum 60")
    assert(acc_count(a) == 3, "count 3")

    let m = acc_mean(a)
    assert(is_ok(m), "mean ok")
    assert(unwrap(m) == 20, "mean 20")

    let mn = acc_min(a)
    assert(is_ok(mn), "min ok")
    assert(unwrap(mn) == 10, "min 10")

    let mx = acc_max(a)
    assert(is_ok(mx), "max ok")
    assert(unwrap(mx) == 30, "max 30")

    let rg = acc_range(a)
    assert(is_ok(rg), "range ok")
    assert(unwrap(rg) == 20, "range 20")

    let empty = acc_new()
    assert(is_err(acc_mean(empty)), "empty mean err")

    print("ACCUMULATOR KAT PASS")
