import forge_event_bus

fn main()
    let s = eb_new()
    assert(eb_topic_count(s) == 0, "0 topics")
    assert(eb_has_topic(s, "orders") == 0, "no orders yet")

    s = eb_create_topic(s, "orders")
    s = eb_create_topic(s, "payments")
    assert(eb_topic_count(s) == 2, "2 topics")
    assert(eb_has_topic(s, "orders") == 1, "has orders")

    let sub1 = eb_subscribe(s, "orders", "svc-a")
    assert(is_ok(sub1), "sub svc-a ok")
    let sub2 = eb_subscribe(s, "orders", "svc-b")
    assert(is_ok(sub2), "sub svc-b ok")

    let dup = eb_subscribe(s, "orders", "svc-a")
    assert(is_err(dup), "dup subscribe errs")

    let subm = eb_subscribe(s, "missing", "svc-c")
    assert(is_err(subm), "subscribe missing topic errs")

    let sc = eb_subscriber_count(s, "orders")
    assert(is_ok(sc), "subscriber count ok")
    assert(unwrap(sc) == 2, "2 subscribers on orders")

    let p1 = eb_publish(s, "orders", "order-created")
    assert(is_ok(p1), "publish ok")
    let p2 = eb_publish(s, "orders", "order-shipped")
    assert(is_ok(p2), "publish ok 2")
    let p3 = eb_publish(s, "payments", "payment-received")
    assert(is_ok(p3), "publish payments ok")

    let pm = eb_publish(s, "missing", "x")
    assert(is_err(pm), "publish missing topic errs")

    let mc = eb_message_count(s, "orders")
    assert(is_ok(mc), "message count ok")
    assert(unwrap(mc) == 2, "orders has 2 messages")

    assert(eb_total_messages(s) == 3, "3 total messages")

    let un1 = eb_unsubscribe(s, "orders", "svc-a")
    assert(is_ok(un1), "unsubscribe ok")
    let sc2 = eb_subscriber_count(s, "orders")
    assert(unwrap(sc2) == 1, "1 subscriber left")

    let un2 = eb_unsubscribe(s, "orders", "svc-a")
    assert(is_err(un2), "unsubscribe again errs")

    let unm = eb_unsubscribe(s, "missing", "svc-a")
    assert(is_err(unm), "unsubscribe missing topic errs")

    print("EVENT-BUS KAT PASS")
