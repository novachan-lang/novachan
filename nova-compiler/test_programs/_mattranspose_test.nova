// _mattranspose_test.nova — KAT for std/matrix/mattranspose
import std/matrix/mattranspose

// Helper: check two floats within tol.
fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    d < tol

// Helper: fail with a label.
fn fail(label: string)
    print("FAIL _mattranspose_test " + label)
    exit(1)

// Helper: compare two matrices element-wise within tol.
fn mat_eq(a: any, b: any, tol: float) -> bool
    let r = a["r"]
    let c = a["c"]
    let ok = true
    let i = 0
    while i < r
        let j = 0
        while j < c
            let av = mt_get(a, i, j)
            let bv = mt_get(b, i, j)
            if not approx(av, bv, tol)
                ok = false
            j = j + 1
        i = i + 1
    ok

fn main()
    // ── KAT 1: mt_transpose [[1,2,3],[4,5,6]] == [[1,4],[2,5],[3,6]] ─────────
    // Build 2×3 matrix
    let d23 = []
    push(d23, 1.0)
    push(d23, 2.0)
    push(d23, 3.0)
    push(d23, 4.0)
    push(d23, 5.0)
    push(d23, 6.0)
    let M23 = mt_make(2, 3, d23)
    let T = mt_transpose(M23)
    // T should be 3×2
    let tr = T["r"]
    let tc = T["c"]
    if tr != 3
        fail("transpose_r")
    if tc != 2
        fail("transpose_c")
    if not approx(mt_get(T, 0, 0), 1.0, 0.0001)
        fail("T[0,0]")
    if not approx(mt_get(T, 0, 1), 4.0, 0.0001)
        fail("T[0,1]")
    if not approx(mt_get(T, 1, 0), 2.0, 0.0001)
        fail("T[1,0]")
    if not approx(mt_get(T, 1, 1), 5.0, 0.0001)
        fail("T[1,1]")
    if not approx(mt_get(T, 2, 0), 3.0, 0.0001)
        fail("T[2,0]")
    if not approx(mt_get(T, 2, 1), 6.0, 0.0001)
        fail("T[2,1]")

    // ── KAT 2: mt_transpose(mt_transpose(A)) == A ────────────────────────────
    let TT = mt_transpose(T)
    if not mat_eq(TT, M23, 0.0001)
        fail("double_transpose")

    // ── KAT 3: mt_trace [[1,2],[3,4]] == 5.0 ────────────────────────────────
    let d22 = []
    push(d22, 1.0)
    push(d22, 2.0)
    push(d22, 3.0)
    push(d22, 4.0)
    let M22 = mt_make(2, 2, d22)
    let tr22 = mt_trace(M22)
    if not approx(tr22, 5.0, 0.0001)
        fail("trace")

    // ── KAT 4: mt_is_symmetric [[1,2],[2,1]] == true ────────────────────────
    let ds = []
    push(ds, 1.0)
    push(ds, 2.0)
    push(ds, 2.0)
    push(ds, 1.0)
    let Msym = mt_make(2, 2, ds)
    if not mt_is_symmetric(Msym, 0.0001)
        fail("is_symmetric_true")

    // ── KAT 5: mt_is_symmetric [[1,2],[3,4]] == false ───────────────────────
    if mt_is_symmetric(M22, 0.0001)
        fail("is_symmetric_false")

    // ── KAT 6: mt_is_diagonal [[2,0],[0,3]] == true ─────────────────────────
    let dd = []
    push(dd, 2.0)
    push(dd, 0.0)
    push(dd, 0.0)
    push(dd, 3.0)
    let Mdiag = mt_make(2, 2, dd)
    if not mt_is_diagonal(Mdiag, 0.0001)
        fail("is_diagonal_true")

    // ── KAT 7: mt_is_diagonal M22 == false ──────────────────────────────────
    if mt_is_diagonal(M22, 0.0001)
        fail("is_diagonal_false")

    // ── KAT 8: mt_diagonal [[1,2],[3,4]] == [1.0, 4.0] ─────────────────────
    let diag = mt_diagonal(M22)
    if not approx(diag[0] * 1.0, 1.0, 0.0001)
        fail("diagonal[0]")
    if not approx(diag[1] * 1.0, 4.0, 0.0001)
        fail("diagonal[1]")

    // ── KAT 9: mt_is_upper_triangular [[1,2],[0,3]] == true ─────────────────
    let dut = []
    push(dut, 1.0)
    push(dut, 2.0)
    push(dut, 0.0)
    push(dut, 3.0)
    let Mut = mt_make(2, 2, dut)
    if not mt_is_upper_triangular(Mut, 0.0001)
        fail("is_upper_tri_true")

    // ── KAT 10: M22 is NOT upper triangular ──────────────────────────────────
    if mt_is_upper_triangular(M22, 0.0001)
        fail("is_upper_tri_false")

    // ── KAT 11: mt_submatrix([[1,2,3],[4,5,6],[7,8,9]],0,0) == [[5,6],[8,9]]
    let d33 = []
    push(d33, 1.0)
    push(d33, 2.0)
    push(d33, 3.0)
    push(d33, 4.0)
    push(d33, 5.0)
    push(d33, 6.0)
    push(d33, 7.0)
    push(d33, 8.0)
    push(d33, 9.0)
    let M33 = mt_make(3, 3, d33)
    let Sub = mt_submatrix(M33, 0, 0)
    let subr = Sub["r"]
    let subc = Sub["c"]
    if subr != 2
        fail("submatrix_r")
    if subc != 2
        fail("submatrix_c")
    if not approx(mt_get(Sub, 0, 0), 5.0, 0.0001)
        fail("sub[0,0]")
    if not approx(mt_get(Sub, 0, 1), 6.0, 0.0001)
        fail("sub[0,1]")
    if not approx(mt_get(Sub, 1, 0), 8.0, 0.0001)
        fail("sub[1,0]")
    if not approx(mt_get(Sub, 1, 1), 9.0, 0.0001)
        fail("sub[1,1]")

    // ── KAT 12: mt_is_identity on a 2x2 identity ─────────────────────────────
    let di2 = []
    push(di2, 1.0)
    push(di2, 0.0)
    push(di2, 0.0)
    push(di2, 1.0)
    let I2 = mt_make(2, 2, di2)
    if not mt_is_identity(I2, 0.0001)
        fail("is_identity_true")
    if mt_is_identity(M22, 0.0001)
        fail("is_identity_false")

    // ── KAT 13: mt_is_lower_triangular ───────────────────────────────────────
    let dlt = []
    push(dlt, 1.0)
    push(dlt, 0.0)
    push(dlt, 3.0)
    push(dlt, 4.0)
    let Mlt = mt_make(2, 2, dlt)
    if not mt_is_lower_triangular(Mlt, 0.0001)
        fail("is_lower_tri_true")
    if mt_is_lower_triangular(Mut, 0.0001)
        fail("is_lower_tri_false")

    // ── KAT 14: mt_swap_rows ─────────────────────────────────────────────────
    let dswap = []
    push(dswap, 1.0)
    push(dswap, 2.0)
    push(dswap, 3.0)
    push(dswap, 4.0)
    let Mswap = mt_make(2, 2, dswap)
    let Msr = mt_swap_rows(Mswap, 0, 1)
    if not approx(mt_get(Msr, 0, 0), 3.0, 0.0001)
        fail("swap_rows[0,0]")
    if not approx(mt_get(Msr, 0, 1), 4.0, 0.0001)
        fail("swap_rows[0,1]")
    if not approx(mt_get(Msr, 1, 0), 1.0, 0.0001)
        fail("swap_rows[1,0]")

    // ── KAT 15: mt_swap_cols ─────────────────────────────────────────────────
    let Msc = mt_swap_cols(Mswap, 0, 1)
    if not approx(mt_get(Msc, 0, 0), 2.0, 0.0001)
        fail("swap_cols[0,0]")
    if not approx(mt_get(Msc, 0, 1), 1.0, 0.0001)
        fail("swap_cols[0,1]")

    print("PASS _mattranspose_test")
