import forge_object_pool

fn main()
    let p = op_new(3)
    p = op_add(p, "conn-1")
    p = op_add(p, "conn-2")
    p = op_add(p, "conn-3")
    assert(op_available_count(p) == 3, "3 available")
    assert(op_in_use_count(p) == 0, "0 in use")

    p = op_add(p, "conn-4")
    assert(op_available_count(p) == 3, "still 3 - max reached")

    let r1 = op_acquire(p)
    p = r1["p"]
    assert(r1["ok"] == 1, "acquired 1")
    assert(op_in_use_count(p) == 1, "1 in use")
    assert(op_utilization(p) == 33, "33% util")

    let r2 = op_acquire(p)
    p = r2["p"]
    let r3 = op_acquire(p)
    p = r3["p"]
    assert(op_available_count(p) == 0, "0 available")
    assert(op_utilization(p) == 100, "100% util")

    let r4 = op_acquire(p)
    p = r4["p"]
    assert(r4["ok"] == 0, "pool exhausted")

    p = op_release(p, r1["name"])
    assert(op_available_count(p) == 1, "1 available after release")
    assert(op_total_acquired(p) == 3, "3 total acquired")

    print("OBJECT-POOL KAT PASS")
