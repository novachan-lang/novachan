import forge_object_pool

fn main()
    let p = pool_new(3)
    let r1 = pool_add(p, "conn1")
    assert(is_ok(r1), "add conn1")
    p = unwrap(r1)
    let r2 = pool_add(p, "conn2")
    assert(is_ok(r2), "add conn2")
    p = unwrap(r2)
    assert(pool_available(p) == 2, "2 available")

    let r3 = pool_borrow(p)
    assert(is_ok(r3), "borrow ok")
    assert(pool_in_use(p) == 1, "1 in use")
    assert(pool_utilization(p) == 50, "50% util")

    let r4 = pool_return_item(p, "conn1")
    assert(is_ok(r4), "return ok")
    p = unwrap(r4)
    assert(pool_available(p) == 2, "2 available again")

    let r5 = pool_add(p, "conn3")
    assert(is_ok(r5), "add conn3")
    p = unwrap(r5)
    let r6 = pool_add(p, "conn4")
    assert(is_err(r6), "pool full")

    print("OBJECT-POOL KAT PASS")
