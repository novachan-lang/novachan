// Does the DOCUMENTED guard form express what `match true` was reaching for?
// Spec: `match EXPR` then arms `PAT (| PAT)* (if GUARD)? => body`
// So a comparison belongs in the GUARD, with `_` as the pattern -- not in the pattern slot.
fn classify(n: int) -> string
    match true
        _ if n < 0 => "negative"
        _ if n == 0 => "zero"
        _ => "positive"

// The subject of the test: does anything after the match still parse?
fn after_it(x: int) -> int
    x * 2

type GPt
    gp_x: int
    gp_y: int

fn struct_after(p: GPt) -> int
    p.gp_x + p.gp_y

fn main()
    assert_eq(classify(0 - 5), "negative")
    assert_eq(classify(0), "zero")
    assert_eq(classify(7), "positive")
    assert_eq(after_it(21), 42)
    assert_eq(struct_after(GPt{gp_x: 3, gp_y: 4}), 7)
    print("_mt_guard_probe passed")
