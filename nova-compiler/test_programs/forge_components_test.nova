import forge_components

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0

    // two clusters: a-b-c and d-e
    let two = [["a", "b"], ["b", "c"], ["d", "e"]]
    fails = fails + expect("two_count", str(component_count(two)), "2")
    fails = fails + expect("two_largest", str(largest_component_size(two)), "3")
    fails = fails + expect_true("two_same_abc", same_component(two, "a", "c"))
    fails = fails + expect_true("two_not_ad", same_component(two, "a", "d") == false)
    fails = fails + expect_true("two_notconnected", is_connected(two) == false)

    // fully connected chain
    let chain = [["a", "b"], ["b", "c"], ["c", "d"]]
    fails = fails + expect("chain_count", str(component_count(chain)), "1")
    fails = fails + expect_true("chain_connected", is_connected(chain))

    // undirected: edge direction doesn't matter (b->a same as a->b)
    let undir = [["a", "b"], ["c", "b"]]
    fails = fails + expect("undir_count", str(component_count(undir)), "1")
    fails = fails + expect_true("undir_same_ac", same_component(undir, "a", "c"))

    // three separate islands
    let three = [["a", "b"], ["c", "d"], ["e", "f"]]
    fails = fails + expect("three_count", str(component_count(three)), "3")
    fails = fails + expect("three_largest", str(largest_component_size(three)), "2")

    // star: one hub connects all -> 1 component
    let star = [["h", "a"], ["h", "b"], ["h", "c"], ["h", "d"]]
    fails = fails + expect("star_count", str(component_count(star)), "1")
    fails = fails + expect("star_largest", str(largest_component_size(star)), "5")

    // cycle -> 1 component
    let cyc = [["a", "b"], ["b", "c"], ["c", "a"]]
    fails = fails + expect("cycle_count", str(component_count(cyc)), "1")

    // components partition all nodes
    let comps = connected_components(two)
    let total = 0
    let i = 0
    while i < len(comps)
        total = total + len(comps[i])
        i = i + 1
    fails = fails + expect("partition", str(total), "5")

    if fails == 0
        print("forge_components: all passed")
    else
        print("forge_components: " + str(fails) + " FAILED")
