import std/proof/proof_terms

fn cki(label, got, want)
    if got != want
        print("FAIL _proof_terms_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL _proof_terms_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL _proof_terms_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // Build formula helpers
    let fA = ppt_var("A")
    let fB = ppt_var("B")
    let fC = ppt_var("C")

    // === KAT 1: identity proof ===
    // plam("x", A, pv("x")) should prove imp(A, A)
    let id_term = ppt_mk_plam("x", fA, ppt_mk_pv("x"))
    let ctx0 = []
    let expected_AtoA = ppt_imp(fA, fA)
    // Check inferred == imp(A,A)
    ckb("id_AtoA_check", ppt_check(ctx0, id_term, expected_AtoA), true)

    // === KAT 2: K combinator — plam("x",A, plam("y",B, pv("x"))) proves imp(A, imp(B, A)) ===
    let K_term = ppt_mk_plam("x", fA, ppt_mk_plam("y", fB, ppt_mk_pv("x")))
    let expected_K = ppt_imp(fA, ppt_imp(fB, fA))
    ckb("K_combinator", ppt_check(ctx0, K_term, expected_K), true)
    // Should NOT prove imp(A, imp(B, B)) — that is the I applied differently
    let wrong_K = ppt_imp(fA, ppt_imp(fB, fB))
    ckb("K_wrong_target", ppt_check(ctx0, K_term, wrong_K), false)

    // === KAT 3: papp of proof of imp(A,B) and proof of A gives B ===
    // Build a context where we have x:imp(A,B) and y:A
    let fAB = ppt_imp(fA, fB)
    let entry_x = []
    push(entry_x, "x")
    push(entry_x, fAB)
    let entry_y = []
    push(entry_y, "y")
    push(entry_y, fA)
    let ctx_xy = []
    push(ctx_xy, entry_x)
    push(ctx_xy, entry_y)
    // papp(pv("x"), pv("y")) should give B
    let app_term = ppt_mk_papp(ppt_mk_pv("x"), ppt_mk_pv("y"))
    ckb("papp_AtoB_A_gives_B", ppt_check(ctx_xy, app_term, fB), true)
    ckb("papp_gives_wrong", ppt_check(ctx_xy, app_term, fC), false)

    // === KAT 4: ppt_check with wrong formula returns false ===
    // plam("x", A, pv("x")) does NOT prove imp(A, B)  (unless A==B but here A!=B)
    let imp_AB = ppt_imp(fA, fB)
    ckb("id_not_AtoB", ppt_check(ctx0, id_term, imp_AB), false)

    // === KAT 5: variable not in context => FAIL ===
    let pv_z = ppt_mk_pv("z")
    let inf_z = ppt_infer(ctx0, pv_z)
    cks("unbound_var_is_FAIL", inf_z, "FAIL")

    // === KAT 6: S combinator ===
    // plam("x",A->B->C, plam("y",A->B, plam("z",A, papp(papp(x,z),papp(y,z))))) proves (A->B->C)->(A->B)->A->C
    let fBC = ppt_imp(fB, fC)
    let fABC = ppt_imp(fA, fBC)
    let fAB2 = ppt_imp(fA, fB)
    let xterm = ppt_mk_pv("x")
    let yterm = ppt_mk_pv("y")
    let zterm = ppt_mk_pv("z")
    let inner_app = ppt_mk_papp(ppt_mk_papp(xterm, zterm), ppt_mk_papp(yterm, zterm))
    let S_term = ppt_mk_plam("x", fABC, ppt_mk_plam("y", fAB2, ppt_mk_plam("z", fA, inner_app)))
    let expected_S = ppt_imp(fABC, ppt_imp(fAB2, ppt_imp(fA, fC)))
    ckb("S_combinator", ppt_check(ctx0, S_term, expected_S), true)

    // === KAT 7: shadow context (newest-first) ===
    // plam("x", A, plam("x", B, pv("x"))) the inner x has type B; should prove A->(B->B)
    let shadow_term = ppt_mk_plam("x", fA, ppt_mk_plam("x", fB, ppt_mk_pv("x")))
    let expected_shadow = ppt_imp(fA, ppt_imp(fB, fB))
    ckb("shadow_context", ppt_check(ctx0, shadow_term, expected_shadow), true)

    // === CROSS-CHECK: every closed proof term's inferred formula is a classical tautology ===
    // id: A->A
    ckb("taut_id", ppt_is_tautology(ppt_imp(fA, fA)), true)
    // K: A->(B->A)
    ckb("taut_K", ppt_is_tautology(ppt_imp(fA, ppt_imp(fB, fA))), true)
    // S: (A->B->C)->(A->B)->A->C
    ckb("taut_S", ppt_is_tautology(expected_S), true)
    // shadow result: A->(B->B)
    ckb("taut_shadow", ppt_is_tautology(expected_shadow), true)

    // === CROSS-CHECK: ill-typed "proof" does not infer something we call tautology ===
    // pv("w") in empty context => FAIL, not a formula
    let pv_w = ppt_mk_pv("w")
    let inf_w = ppt_infer(ctx0, pv_w)
    cks("unbound_w_FAIL", inf_w, "FAIL")

    // === Tautology oracle sanity: NOT a tautology ===
    ckb("not_taut_A", ppt_is_tautology(fA), false)
    ckb("not_taut_AtoB", ppt_is_tautology(ppt_imp(fA, fB)), false)

    print("PASS _proof_terms_test")
