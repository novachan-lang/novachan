import forge_count_min_sketch

fn main()
    let c = cms_new(100, 3)
    c = cms_add(c, "apple", 5)
    c = cms_add(c, "banana", 3)
    c = cms_add(c, "apple", 2)
    assert(cms_total(c) == 10, "total 10")

    let est = cms_estimate(c, "apple")
    assert(est >= 7, "apple >= 7")

    let est2 = cms_estimate(c, "banana")
    assert(est2 >= 3, "banana >= 3")

    let est3 = cms_estimate(c, "not_here")
    assert(est3 == 0, "not_here = 0")

    print("COUNT-MIN-SKETCH KAT PASS")
