// functional: gRPC framing + routing + unary dispatch + malformed rejection
import forge_grpc

fn _echo(payload: list) -> list
    payload

fn main()
    if str(grpc_frame([1, 2, 3])) != str([0, 0, 0, 0, 3, 1, 2, 3])
        print("FAIL frame")
        exit(1)
    let df = grpc_deframe([0, 0, 0, 0, 3, 1, 2, 3], 0)
    if str(df) != str([[1, 2, 3], 8, 0])
        print("FAIL deframe = " + str(df))
        exit(1)
    if grpc_path_service("/echo.Echo/Say") != "echo.Echo"
        print("FAIL svc")
        exit(1)
    if grpc_path_method("/echo.Echo/Say") != "Say"
        print("FAIL method")
        exit(1)
    let m = grpc_register(grpc_service_map(), "/echo.Echo/Say", _echo)
    let ok = grpc_dispatch(m, "/echo.Echo/Say", grpc_frame([1, 2, 3]))
    if str(ok["framed"]) != str([0, 0, 0, 0, 3, 1, 2, 3])
        print("FAIL dispatch framed")
        exit(1)
    if ok["status"] != 0
        print("FAIL dispatch status")
        exit(1)
    let miss = grpc_dispatch(m, "/no.Such/M", grpc_frame([1]))
    if miss["status"] != 12
        print("FAIL unimpl")
        exit(1)
    let bad = grpc_dispatch(m, "/echo.Echo/Say", [0, 0, 0])
    if bad["status"] != 3
        print("FAIL malformed status = " + str(bad["status"]))
        exit(1)
    let dfbad = grpc_deframe([0, 0, 0], 0)
    if dfbad[2] != -1
        print("FAIL deframe sentinel")
        exit(1)
    print("PASS forge_grpc")
