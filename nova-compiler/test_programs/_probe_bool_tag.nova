// Does a bool survive being stored in a list / passed as an arg?
fn takes_untyped(v) -> string
    "untyped: type_name={type_name(v)} is_bool={is_bool(v)}"

fn takes_typed(v: bool) -> string
    "typed(bool): type_name={type_name(v)} val={v}"

fn main()
    let direct = true
    print("1. bare literal      : type_name={type_name(direct)} is_bool={is_bool(direct)}")

    let states = [true, false]
    print("2. from list index   : type_name={type_name(states[0])} is_bool={is_bool(states[0])}")

    for i, s in states
        print("3. from for i,v loop : [{i}] type_name={type_name(s)} is_bool={is_bool(s)}")

    print("4. {takes_untyped(states[0])}")
    print("5. {takes_typed(states[0])}")

    // does a dict behave differently?
    let d = {"a": true}
    print("6. from dict         : type_name={type_name(d[\"a\"])} is_bool={is_bool(d[\"a\"])}")

    // does the VALUE still work correctly in a ternary even if mistagged?
    let glyph = "[ON]" if states[0] else "[OFF]"
    print("7. ternary on list bool = {glyph}  (expect [ON])")
    let glyph2 = "[ON]" if states[1] else "[OFF]"
    print("8. ternary on false     = {glyph2}  (expect [OFF])")
