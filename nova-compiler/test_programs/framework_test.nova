// Test framework self-test

fn test_arithmetic()
    assert_eq(2 + 3, 5)
    assert_eq(10 - 7, 3)
    assert_eq(6 * 7, 42)
    assert_eq(100 / 5, 20)

fn test_string_ops()
    assert_eq(len("hello"), 5)
    assert_eq(upper("abc"), "ABC")
    assert_eq(lower("XYZ"), "xyz")
    assert_eq(trim("  hi  "), "hi")

fn test_list_ops()
    let items = [1, 2, 3]
    assert_eq(len(items), 3)
    push(items, 4)
    assert_eq(len(items), 4)
    assert_eq(items[3], 4)

fn test_assert_ne()
    assert_ne(1, 2)
    assert_ne("a", "b")
    assert_ne([1], [2])

fn test_booleans()
    assert_true(1 > 0)
    assert_true(10 == 10)
    assert_false(0)
    assert_false(1 > 2)

fn test_result_types()
    let r = ok(99)
    assert_true(is_ok(r))
    assert_false(is_err(r))
    assert_eq(unwrap(r), 99)
    let e = err("bad")
    assert_true(is_err(e))
    assert_eq(unwrap_err(e), "bad")

fn test_iterators()
    let s = iter_sum(iter_range(1, 11))
    assert_eq(s, 55)
    let c = iter_count(iter_filter(iter_range(1, 21), fn(x) x % 2 == 0))
    assert_eq(c, 10)

fn main()
    test_run("integer equality", fn() assert_eq(42, 42))
    test_run("string equality", fn() assert_eq("hello", "hello"))
    test_run("list equality", fn() assert_eq([1, 2, 3], [1, 2, 3]))
    test_run("assert_ne", fn() test_assert_ne())
    test_run("boolean checks", fn() test_booleans())
    test_run("arithmetic", fn() test_arithmetic())
    test_run("string ops", fn() test_string_ops())
    test_run("list ops", fn() test_list_ops())
    test_run("result types", fn() test_result_types())
    test_run("iterators", fn() test_iterators())
    test_summary()
