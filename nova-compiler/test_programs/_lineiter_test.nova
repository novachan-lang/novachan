// KAT for std/os/lineiter — line splitting with mixed endings.
import std/os/lineiter

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL lineiter " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL lineiter " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn list_str_eq(a: any, b: any) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    return true

fn main()
    let LF = chr(10)
    let CR = chr(13)

    // KAT 1: split_lines with LF and CRLF mixed
    // "a\nb\r\nc" -> ["a","b","c"]
    let s1 = "a" + LF + "b" + CR + LF + "c"
    let r1 = split_lines(s1)
    let want1 = []
    push(want1, "a")
    push(want1, "b")
    push(want1, "c")
    if not list_str_eq(r1, want1)
        print("FAIL lineiter split_mixed: got len=" + str(len(r1)))
        exit(1)

    // KAT 2: trailing newline does NOT produce trailing empty
    // "a\n" -> ["a"]
    let s2 = "a" + LF
    let r2 = split_lines(s2)
    let want2 = []
    push(want2, "a")
    if not list_str_eq(r2, want2)
        print("FAIL lineiter split_trailing_LF: got len=" + str(len(r2)))
        exit(1)

    // KAT 3: trailing CR does NOT produce trailing empty
    // "a\r" -> ["a"]
    let s3 = "a" + CR
    let r3 = split_lines(s3)
    let want3 = []
    push(want3, "a")
    if not list_str_eq(r3, want3)
        print("FAIL lineiter split_trailing_CR: got len=" + str(len(r3)))
        exit(1)

    // KAT 4: lone CR line ending
    // "x\ry" -> ["x","y"]
    let s4 = "x" + CR + "y"
    let r4 = split_lines(s4)
    let want4 = []
    push(want4, "x")
    push(want4, "y")
    if not list_str_eq(r4, want4)
        print("FAIL lineiter split_lone_CR: got len=" + str(len(r4)))
        exit(1)

    // KAT 5: count_lines
    // "a\nb" -> 2
    let s5 = "a" + LF + "b"
    cki("count_lines_2", count_lines(s5), 2)

    // KAT 6: count_lines empty string -> 0
    cki("count_lines_empty", count_lines(""), 0)

    // KAT 7: count_lines single line no newline -> 1
    cki("count_lines_1", count_lines("hello"), 1)

    // KAT 8: count_lines trailing newline does not add extra
    cki("count_lines_trailing", count_lines("a" + LF), 1)

    // KAT 9: join_lines
    let jl = []
    push(jl, "a")
    push(jl, "b")
    let joined = join_lines(jl)
    cks("join_lines", joined, "a" + LF + "b")

    // KAT 10: join_lines single element
    let jl1 = []
    push(jl1, "hello")
    cks("join_single", join_lines(jl1), "hello")

    // KAT 11: join_lines empty list -> ""
    let jl0 = []
    cks("join_empty", join_lines(jl0), "")

    // KAT 12: chunk_lines basic — ["a","b","c"] in groups of 2 -> 2 groups
    let cl = []
    push(cl, "a")
    push(cl, "b")
    push(cl, "c")
    let chunks = chunk_lines(cl, 2)
    cki("chunk_count", len(chunks), 2)
    cki("chunk0_len", len(chunks[0]), 2)
    cki("chunk1_len", len(chunks[1]), 1)

    // KAT 13: chunk_lines exact multiple — 4 lines, n=2 -> 2 groups of 2
    let cl2 = []
    push(cl2, "a")
    push(cl2, "b")
    push(cl2, "c")
    push(cl2, "d")
    let chunks2 = chunk_lines(cl2, 2)
    cki("chunk2_count", len(chunks2), 2)
    cki("chunk2_0_len", len(chunks2[0]), 2)
    cki("chunk2_1_len", len(chunks2[1]), 2)

    // KAT 14: chunk_lines n=1 -> one group per line
    let cl3 = []
    push(cl3, "x")
    push(cl3, "y")
    let chunks3 = chunk_lines(cl3, 1)
    cki("chunk_n1", len(chunks3), 2)

    // KAT 15: roundtrip split then join
    let orig = "line1" + LF + "line2" + LF + "line3"
    let lns = split_lines(orig)
    let rt = join_lines(lns)
    cks("roundtrip", rt, orig)

    print("PASS _lineiter_test")
