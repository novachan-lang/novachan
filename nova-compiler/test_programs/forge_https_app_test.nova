// A real ROUTED Forge app served over HTTPS: two routes (a static path and a :param path) dispatched
// through forge's router inside TLS 1.3. Proves the HTTPS app bridge: method+path routing, :param binding,
// and multi-connection serving (n=2) with a fresh ephemeral key per connection. Fetched by curl.
import forge
import forge_https

fn app_hello(req)
    text(200, "Routed Forge app over HTTPS!")

fn app_echo(req)
    let p = req["params"]
    text(200, "echo: " + p["x"])

fn main()
    let a = app()
    get(a, "/hello", app_hello)
    get(a, "/echo/:x", app_echo)
    forge_serve_tls_app_n(a, 44332, 2)
    print("HTTPS-APP-DONE")
