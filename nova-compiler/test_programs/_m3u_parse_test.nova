// KAT test for std/data/m3u_parse
import std/data/m3u_parse

fn cki(label, got, expected)
    if got != expected
        print("FAIL m3u_parse " + label + ": got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL m3u_parse " + label + ": got=" + got + " expected=" + expected)
        exit(1)

// ── KAT: from the spec ────────────────────────────────────────────────────────
let lf = chr(10)
let text1 = "#EXTM3U" + lf + "#EXTINF:123,Song A" + lf + "http://x/a.mp3" + lf + "http://x/b.mp3" + lf
let entries = m3u_parse(text1)

cki("len", len(entries), 2)
cki("e0_duration", entries[0]["duration"], 123)
cks("e0_title", entries[0]["title"], "Song A")
cks("e0_url", entries[0]["url"], "http://x/a.mp3")
cki("e1_duration", entries[1]["duration"], -1)
cks("e1_title", entries[1]["title"], "")
cks("e1_url", entries[1]["url"], "http://x/b.mp3")

// ── KAT: plain URL only (no header) ─────────────────────────────────────────
let text2 = "http://example.com/stream.mp3" + lf
let e2 = m3u_parse(text2)
cki("plain_len", len(e2), 1)
cki("plain_dur", e2[0]["duration"], -1)
cks("plain_url", e2[0]["url"], "http://example.com/stream.mp3")

// ── KAT: multiple EXTINF entries ─────────────────────────────────────────────
let text3 = "#EXTM3U" + lf + "#EXTINF:60,Track 1" + lf + "http://a/1.mp3" + lf + "#EXTINF:90,Track 2" + lf + "http://a/2.mp3" + lf
let e3 = m3u_parse(text3)
cki("multi_len", len(e3), 2)
cki("multi_e0_dur", e3[0]["duration"], 60)
cks("multi_e0_title", e3[0]["title"], "Track 1")
cki("multi_e1_dur", e3[1]["duration"], 90)
cks("multi_e1_title", e3[1]["title"], "Track 2")

// ── KAT: negative duration (-1 in EXTINF) ────────────────────────────────────
let text4 = "#EXTINF:-1,Live Stream" + lf + "http://live/stream" + lf
let e4 = m3u_parse(text4)
cki("neg_dur", e4[0]["duration"], -1)
cks("neg_title", e4[0]["title"], "Live Stream")

// ── KAT: empty input ─────────────────────────────────────────────────────────
let e5 = m3u_parse("")
cki("empty_len", len(e5), 0)

print("PASS _m3u_parse_test")
