import forge_notification_queue

fn main()
    let n = nq_new()
    n = nq_send(n, "alice", "order shipped", 1)
    n = nq_send(n, "bob", "payment received", 3)
    n = nq_send(n, "alice", "welcome", 2)
    assert(nq_total(n) == 3, "3 notifications")
    assert(nq_unread_count(n) == 3, "3 unread")

    let r1 = nq_read(n, 0)
    assert(is_ok(r1), "read ok")
    assert(unwrap(r1) == "order shipped", "msg 0")
    assert(nq_unread_count(n) == 2, "2 unread after read")

    let rcpt = nq_recipient(n, 1)
    assert(is_ok(rcpt), "recipient ok")
    assert(unwrap(rcpt) == "bob", "bob")

    let pri = nq_priority(n, 1)
    assert(is_ok(pri), "priority ok")
    assert(unwrap(pri) == 3, "priority 3")

    let hp = nq_highest_priority(n)
    assert(is_ok(hp), "highest ok")
    assert(unwrap(hp) == 1, "index 1 highest")

    assert(nq_total_sent(n) == 3, "3 sent")

    let bad = nq_read(n, 10)
    assert(is_err(bad), "out of range")

    print("NOTIFICATION-QUEUE KAT PASS")
