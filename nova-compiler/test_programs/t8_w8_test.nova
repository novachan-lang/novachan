// Track 8 W8: liveness-based mid-fn drops. The local list `big` is built
// inside the if-branch and never referenced after it. With NOVA_T8_W8=1
// and NOVA_T8_DROP=1, the compiler's liveness pass should emit a
// list_free_local at the end of the then-block, not wait for the function
// return. Output must match the un-elided path.

fn process(cond: int) -> int
    let result = 0
    if cond > 0
        let big = []
        let i = 0
        while i < 100
            big.push(i)
            i = i + 1
        result = len(big)
    let other = result * 2
    other

fn main()
    print(process(1))
    print(process(0))
