import std/vector/vec_arith

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// ckl: compare two integer lists element-by-element
fn ckl(label: string, got: list, want: list)
    if len(got) != len(want)
        print("FAIL " + label + ": length got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // va_add
    let a1 = [1, 2, 3]
    let b1 = [4, 5, 6]
    ckl("va_add([1,2,3],[4,5,6])", va_add(a1, b1), [5, 7, 9])

    // va_sub
    let a2 = [5, 5]
    let b2 = [1, 2]
    ckl("va_sub([5,5],[1,2])", va_sub(a2, b2), [4, 3])

    // va_scale
    let a3 = [1, 2, 3]
    ckl("va_scale([1,2,3],2)", va_scale(a3, 2), [2, 4, 6])

    // va_negate
    let a4 = [1, 0-2, 3]
    ckl("va_negate([1,-2,3])", va_negate(a4), [0-1, 2, 0-3])

    // va_zeros
    ckl("va_zeros(3)", va_zeros(3), [0, 0, 0])

    // va_add with zero vectors
    let z2 = [0, 0]
    ckl("va_add([0,0],[0,0])", va_add(z2, z2), [0, 0])

    // edge: va_add mismatched lengths uses min
    let am = [1, 2, 3]
    let bm = [10, 20]
    let rm = va_add(am, bm)
    cki("va_add_mismatch_len", len(rm), 2)
    cki("va_add_mismatch_0", rm[0], 11)
    cki("va_add_mismatch_1", rm[1], 22)

    // va_scale by 0
    ckl("va_scale([1,2,3],0)", va_scale(a1, 0), [0, 0, 0])

    // va_scale by -1 == va_negate
    let neg1 = va_scale([3, 0-5, 0], 0-1)
    ckl("va_scale_neg1", neg1, [0-3, 5, 0])

    // va_zeros(0)
    cki("va_zeros(0)_len", len(va_zeros(0)), 0)

    print("PASS _vec_arith_test")
