import forge_bayes

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0
    let m = bayes_new()

    // train spam vs ham
    bayes_train(m, "spam", ["buy", "cheap", "viagra", "now"])
    bayes_train(m, "spam", ["cheap", "meds", "buy", "cheap"])
    bayes_train(m, "spam", ["free", "money", "buy", "now"])
    bayes_train(m, "ham", ["meeting", "schedule", "project", "monday"])
    bayes_train(m, "ham", ["project", "deadline", "meeting", "review"])
    bayes_train(m, "ham", ["lunch", "meeting", "team", "project"])

    fails = fails + expect("doc_count", str(bayes_doc_count(m)), "6")
    fails = fails + expect_true("classes2", len(bayes_classes(m)) == 2)

    // classify clearly-spam text
    fails = fails + expect("spam1", bayes_classify(m, ["buy", "cheap", "now"]), "spam")
    fails = fails + expect("spam2", bayes_classify(m, ["free", "money"]), "spam")

    // classify clearly-ham text
    fails = fails + expect("ham1", bayes_classify(m, ["meeting", "project", "monday"]), "ham")
    fails = fails + expect("ham2", bayes_classify(m, ["deadline", "review"]), "ham")

    // unseen words fall back to prior (Laplace smoothing keeps it defined, no crash)
    let r = bayes_classify(m, ["xyzzy", "qwerty"])
    fails = fails + expect_true("unseen_defined", r == "spam" or r == "ham")

    // scores: spam text scores higher under spam than ham
    let ss = bayes_score(m, "spam", ["buy", "cheap"])
    let hs = bayes_score(m, "ham", ["buy", "cheap"])
    fails = fails + expect_true("score_ordering", ss > hs)

    // sentiment example (2nd model)
    let s = bayes_new()
    bayes_train(s, "pos", ["great", "love", "excellent", "amazing"])
    bayes_train(s, "pos", ["love", "wonderful", "best", "great"])
    bayes_train(s, "neg", ["terrible", "hate", "awful", "worst"])
    bayes_train(s, "neg", ["hate", "bad", "disappointing", "terrible"])
    fails = fails + expect("sent_pos", bayes_classify(s, ["love", "great"]), "pos")
    fails = fails + expect("sent_neg", bayes_classify(s, ["hate", "awful"]), "neg")

    // untrained model
    let e = bayes_new()
    fails = fails + expect("untrained", bayes_classify(e, ["x"]), "")

    if fails == 0
        print("forge_bayes: all passed")
    else
        print("forge_bayes: " + str(fails) + " FAILED")
