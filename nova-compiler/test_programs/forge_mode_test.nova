import forge_mode

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn main()
    let fails = 0

    // clear mode: 3 appears most
    fails = fails + expect("mode_3", str(mode([1, 2, 2, 3, 3, 3])), "3")
    // string mode
    fails = fails + expect("mode_str", mode(["a", "b", "b", "c"]), "b")
    // count_of
    fails = fails + expect("count", str(count_of([1, 2, 2, 3, 3, 3], 3)), "3")
    fails = fails + expect("count_0", str(count_of([1, 2, 3], 9)), "0")

    // frequency
    let f = frequency([1, 1, 2, 3, 3, 3])
    fails = fails + expect("freq_1", str(f["1"]), "2")
    fails = fails + expect("freq_3", str(f["3"]), "3")

    // bimodal: 1 and 2 both appear twice -> modes = [1,2]
    let m = modes([1, 1, 2, 2, 3])
    fails = fails + expect("bimodal_count", str(len(m)), "2")
    fails = fails + expect_true("bimodal_has1", m[0] == 1 or m[1] == 1)
    fails = fails + expect_true("bimodal_has2", m[0] == 2 or m[1] == 2)

    // single mode via modes()
    fails = fails + expect("single_mode", str(len(modes([5, 5, 5, 1, 2]))), "1")

    // all distinct -> all are modes (each freq 1)
    fails = fails + expect("all_distinct", str(len(modes([1, 2, 3, 4]))), "4")

    // empty
    fails = fails + expect_true("empty_mode", mode([]) == null)
    fails = fails + expect("empty_modes", str(len(modes([]))), "0")

    // tie broken by first-to-reach: [2,2,1,1] -> 2 (reaches count 2 first)
    fails = fails + expect("tie_first", str(mode([2, 2, 1, 1])), "2")

    if fails == 0
        print("forge_mode: all passed")
    else
        print("forge_mode: " + str(fails) + " FAILED")
