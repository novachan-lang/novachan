// _dist_chisq_test.nova — KAT for std/numeric/dist_chisq
import std/numeric/dist_chisq

fn approx(a, b, tol) -> float
    let af = a * 1.0
    let bf = b * 1.0
    let tf = tol * 1.0
    let d = af - bf
    if d < 0.0
        d = 0.0 - d
    if d < tf
        return 1.0
    return 0.0

fn check(name, got, want, tol)
    let af = got * 1.0
    let bf = want * 1.0
    let tf = tol * 1.0
    let ok = approx(af, bf, tf)
    if ok < 1.0
        print("FAIL " + name + ": got=" + str(af) + " want=" + str(bf))
        exit(1)

fn main()
    // chisq_mean(5.0) == 5.0
    let m5 = chisq_mean(5.0)
    check("chisq_mean(5)", m5, 5.0, 0.001)

    // chisq_mean(2.0) == 2.0
    let m2 = chisq_mean(2.0)
    check("chisq_mean(2)", m2, 2.0, 0.001)

    // pdf returns 0 for x < 0
    let pneg = chisq_pdf(0.0 - 1.0, 2.0)
    check("chisq_pdf(-1, 2) == 0", pneg, 0.0, 0.001)

    // pdf at x=0 is 0 for df >= 2
    let p0 = chisq_pdf(0.0, 4.0)
    check("chisq_pdf(0, 4) == 0", p0, 0.0, 0.001)

    // chisq_pdf(2.0, 2.0) = 0.5 * exp(-1) ~ 0.1839
    let p22 = chisq_pdf(2.0, 2.0)
    check("chisq_pdf(2,2)", p22, 0.1839, 0.005)

    // chisq_cdf(0.0, 2.0) ~ 0.0
    let c00 = chisq_cdf(0.0, 2.0)
    check("chisq_cdf(0,2) ~= 0", c00, 0.0, 0.001)

    // For df=2: chisq_cdf(x,2) = 1 - exp(-x/2)
    // chisq_cdf(2.0, 2.0) ~ 1 - exp(-1) ~ 0.6321
    let c22 = chisq_cdf(2.0, 2.0)
    check("chisq_cdf(2,2) ~= 0.6321", c22, 0.6321, 0.01)

    // chisq_cdf(4.0, 2.0) ~ 1 - exp(-2) ~ 0.8647
    let c42 = chisq_cdf(4.0, 2.0)
    check("chisq_cdf(4,2) ~= 0.8647", c42, 0.8647, 0.01)

    // chisq_cdf for large x should approach 1
    let clarge = chisq_cdf(30.0, 2.0)
    check("chisq_cdf(30,2) ~= 1.0", clarge, 1.0, 0.01)

    // CDF is monotone: cdf(2) < cdf(4)
    let mono1 = c22
    let mono2 = c42
    if mono1 >= mono2
        print("FAIL chisq_cdf not monotone")
        exit(1)

    // chisq_cdf with df=5 at x=11.07 ~ 0.95
    let c_5_1107 = chisq_cdf(11.07, 5.0)
    check("chisq_cdf(11.07,5) ~= 0.95", c_5_1107, 0.95, 0.02)

    print("PASS _dist_chisq_test")
