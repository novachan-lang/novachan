import std/game/hanoi

fn chk_int(name: string, got: int, want: int)
    if got != want
        print("FAIL hanoi " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn chk_bool(name: string, got: bool, want: bool)
    if got != want
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL hanoi " + name + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // --- hanoi_count ---
    chk_int("count(0)", hanoi_count(0), 0)
    chk_int("count(1)", hanoi_count(1), 1)
    chk_int("count(2)", hanoi_count(2), 3)
    chk_int("count(3)", hanoi_count(3), 7)
    chk_int("count(4)", hanoi_count(4), 15)
    chk_int("count(10)", hanoi_count(10), 1023)

    // --- hanoi_moves length matches hanoi_count ---
    let m1 = hanoi_moves(1, 0, 2, 1)
    chk_int("moves(1) len", len(m1), 1)

    let m2 = hanoi_moves(2, 0, 2, 1)
    chk_int("moves(2) len", len(m2), 3)

    let m3 = hanoi_moves(3, 0, 2, 1)
    chk_int("moves(3) len", len(m3), 7)

    let m4 = hanoi_moves(4, 0, 2, 1)
    chk_int("moves(4) len", len(m4), 15)

    // --- hanoi_moves(1,0,2,1) == [[0,2]] ---
    let mv1 = m1[0]
    chk_int("moves(1)[0][0]", mv1[0], 0)
    chk_int("moves(1)[0][1]", mv1[1], 2)

    // --- first move of hanoi_moves(2,0,2,1) is [0,1] ---
    let first2 = m2[0]
    chk_int("moves(2) first from", first2[0], 0)
    chk_int("moves(2) first to", first2[1], 1)

    // --- first move of hanoi_moves(3,0,2,1) is [0,2] ---
    let first3 = m3[0]
    chk_int("moves(3) first from", first3[0], 0)
    chk_int("moves(3) first to", first3[1], 2)

    // --- verify n=0 returns empty list ---
    let m0 = hanoi_moves(0, 0, 2, 1)
    chk_int("moves(0) len", len(m0), 0)

    // --- simulate the moves to verify correctness for n=3 ---
    // Pegs as lists of disks; peg[0]=source has [3,2,1] (3 on bottom, 1 on top)
    let peg0 = []
    let peg1 = []
    let peg2 = []
    push(peg0, 3)
    push(peg0, 2)
    push(peg0, 1)

    let pegs = []
    push(pegs, peg0)
    push(pegs, peg1)
    push(pegs, peg2)

    let mi = 0
    let valid = true
    while mi < 7
        let mv = m3[mi]
        let fp = mv[0]
        let tp = mv[1]
        let src = pegs[fp]
        let dst = pegs[tp]
        let slen = len(src)
        // must have disk to move
        if slen == 0
            valid = false
        let disk = src[slen - 1]
        // destination must be empty or top disk larger
        let dlen = len(dst)
        if dlen > 0
            let top = dst[dlen - 1]
            if top < disk
                valid = false
        // do the move: pop from src, push to dst
        let new_src = []
        let si = 0
        while si < slen - 1
            push(new_src, src[si])
            si = si + 1
        pegs[fp] = new_src
        push(dst, disk)
        mi = mi + 1

    chk_bool("simulate valid", valid, true)
    // All 3 disks should be on peg 2 now
    let final_peg = pegs[2]
    chk_int("final peg len", len(final_peg), 3)
    chk_int("final peg[0]", final_peg[0], 3)
    chk_int("final peg[1]", final_peg[1], 2)
    chk_int("final peg[2]", final_peg[2], 1)

    print("PASS _hanoi_test")
