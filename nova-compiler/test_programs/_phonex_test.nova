import std/phonetic/phonex

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL phonex " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL phonex " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ---- px_encode reference vectors ----
    // Peter: P + E(reset) T(3) E(reset) R(6) -> P360
    cks("Peter",   px_encode("Peter"),   "P360")
    // Robert: R + O(reset) B(1) E(reset) R(6) T(3) -> R163
    cks("Robert",  px_encode("Robert"),  "R163")
    // Jackson: J + A(reset) C(2) K(2=dup) S(2=dup) O(reset) N(5) -> J250
    cks("Jackson", px_encode("Jackson"), "J250")
    // Knight: KN->N, then N + I(reset) G(2) H(reset) T(3) -> N230
    cks("Knight",  px_encode("Knight"),  "N230")
    // Wright: WR->R, then R + I(reset) G(2) H(reset) T(3) -> R230
    cks("Wright",  px_encode("Wright"),  "R230")

    // ---- px_preprocess rules ----
    // Trailing S removal.
    cks("preproc_trailing_s", px_preprocess("Peters"), "PETER")
    // KN -> N
    cks("preproc_kn", px_preprocess("Knight"), "NIGHT")
    // WR -> R
    cks("preproc_wr", px_preprocess("Wright"), "RIGHT")
    // PH -> F
    cks("preproc_ph", px_preprocess("Phelps"), "FELP")
    // Leading H removal
    cks("preproc_h", px_preprocess("Howard"), "OWARD")
    // AE -> E (leading silent AE); trailing S also removed -> AENEAS -> AENEA -> ENEA
    cks("preproc_ae", px_preprocess("Aeneas"), "ENEA")
    // Lowercase handled
    cks("preproc_lower", px_preprocess("robert"), "ROBERT")

    // ---- px_first ----
    cks("first_Robert", px_first("Robert"), "R")
    cks("first_Knight", px_first("Knight"), "N")
    cks("first_Wright", px_first("Wright"), "R")

    // ---- px_digit ----
    // Raw code for a non-duplicate: prev=0, no non-zero collision.
    cki("digit_B", px_digit("B", 0), 1)
    cki("digit_R", px_digit("R", 0), 6)
    cki("digit_A", px_digit("A", 0), 0)
    cki("digit_L", px_digit("L", 0), 4)
    // Dedup contract: a non-zero code equal to prev returns -1.
    cki("digit_B_dup", px_digit("B", 1), 0 - 1)
    cki("digit_D_dup", px_digit("D", 3), 0 - 1)
    cki("digit_R_dup", px_digit("R", 6), 0 - 1)
    // Silent letters stay 0 even when prev is 0 (not -1).
    cki("digit_A_silent", px_digit("A", 0), 0)
    cki("digit_H_silent", px_digit("H", 0), 0)
    // A non-zero code different from prev returns the raw code.
    cki("digit_B_ne", px_digit("B", 2), 1)

    // ---- format check: always Letter+3digits ----
    cki("len_Peter",   len(px_encode("Peter")),   4)
    cki("len_Robert",  len(px_encode("Robert")),  4)
    cki("len_Jackson", len(px_encode("Jackson")), 4)
    cki("len_Knight",  len(px_encode("Knight")),  4)
    cki("len_Wright",  len(px_encode("Wright")),  4)

    // ---- empty input ----
    cks("empty", px_encode(""), "0000")

    // ---- additional correctness checks ----
    // Lee -> L + E(0-reset) E(0-reset) -> L000
    cks("Lee", px_encode("Lee"), "L000")
    // Euler -> trailing R not S -> EULER; E first, code=0.
    // E + U(0) L(4) E(0 reset) R(6) -> E460
    cks("Euler", px_encode("Euler"), "E460")

    print("PASS _phonex_test")
