import forge_edge

fn main()
    let f = edge_fleet()
    f = edge_register(f, "sensor-01", "temperature")
    f = edge_register(f, "sensor-02", "humidity")
    f = edge_register(f, "cam-01", "camera")

    assert(edge_device_count(f) == 3, "3 devices")

    let online = edge_online_devices(f)
    assert(len(online) == 3, "all online")

    f = edge_set_status(f, "sensor-02", "offline")
    let online2 = edge_online_devices(f)
    assert(len(online2) == 2, "2 online")
    let offline = edge_offline_devices(f)
    assert(len(offline) == 1, "1 offline")

    f = edge_heartbeat(f, "sensor-02", 1000)
    let online3 = edge_online_devices(f)
    assert(len(online3) == 3, "all back online")

    f = edge_tag(f, "sensor-01", "floor-1")
    f = edge_tag(f, "sensor-01", "zone-a")

    f = edge_send_command(f, "cam-01", "snapshot", "high-res")
    assert(len(f["commands"]) == 1, "1 command")
    assert(f["commands"][0]["command"] == "snapshot", "snapshot cmd")

    f = edge_report_telemetry(f, "sensor-01", "temp", 23)
    f = edge_report_telemetry(f, "sensor-01", "temp", 24)
    f = edge_report_telemetry(f, "sensor-02", "humidity", 65)

    let t1 = edge_get_telemetry(f, "sensor-01")
    assert(len(t1) == 2, "2 telemetry for sensor-01")
    let t2 = edge_get_telemetry(f, "sensor-02")
    assert(len(t2) == 1, "1 telemetry for sensor-02")

    f = edge_set_firmware(f, "cam-01", "2.1.0")
    assert(f["devices"]["cam-01"]["firmware"] == "2.1.0", "firmware updated")

    print("EDGE KAT PASS")
