import std/collections/fenwick

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // Build a tree of size 5 and populate with known values
    let fw = fw_new(5)
    fw_update(fw, 1, 3)
    fw_update(fw, 2, 2)
    fw_update(fw, 3, 5)

    // KAT 1: prefix sum 1..3 = 3+2+5 = 10
    cki("prefix(3)", fw_prefix(fw, 3), 10)

    // KAT 2: prefix sum 1..1 = 3
    cki("prefix(1)", fw_prefix(fw, 1), 3)

    // KAT 3: range sum 2..3 = 2+5 = 7
    cki("range(2,3)", fw_range(fw, 2, 3), 7)

    // KAT 4: point query at index 3 = 5
    cki("get(3)", fw_get(fw, 3), 5)

    // KAT 5: update index 2 by +1 (element 2 becomes 3); prefix(2) = 3+3 = 6
    fw_update(fw, 2, 1)
    cki("prefix(2) after update", fw_prefix(fw, 2), 6)

    // KAT 6: range(1,5) = 3+3+5+0+0 = 11
    cki("range(1,5)", fw_range(fw, 1, 5), 11)

    // KAT 7: fw_size returns n
    cki("fw_size", fw_size(fw), 5)

    // KAT 8: point query at index 1 unchanged = 3
    cki("get(1)", fw_get(fw, 1), 3)

    print("_fenwick_test passed")
