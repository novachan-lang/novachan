fn limit_new(max_calls, max_time_ms)
  let lim = {}
  lim["max_calls"] = max_calls
  lim["max_time_ms"] = max_time_ms
  lim["calls"] = 0
  lim["start"] = time_ms()
  lim

fn limit_check(lim)
  lim["calls"] = lim["calls"] + 1
  if lim["calls"] > lim["max_calls"]
    return err("call limit exceeded: " + str(lim["calls"]) + "/" + str(lim["max_calls"]))
  let elapsed = time_ms() - lim["start"]
  if lim["max_time_ms"] > 0 and elapsed > lim["max_time_ms"]
    return err("time limit exceeded: " + str(elapsed) + "ms/" + str(lim["max_time_ms"]) + "ms")
  ok(lim["calls"])

fn limit_remaining_calls(lim)
  lim["max_calls"] - lim["calls"]

fn limit_elapsed(lim)
  time_ms() - lim["start"]

fn limit_reset(lim)
  lim["calls"] = 0
  lim["start"] = time_ms()

fn main()
  let lim = limit_new(3, 5000)
  assert(limit_remaining_calls(lim) == 3, "3 remaining")

  let r1 = limit_check(lim)
  assert(is_ok(r1), "call 1 ok")
  let r2 = limit_check(lim)
  assert(is_ok(r2), "call 2 ok")
  let r3 = limit_check(lim)
  assert(is_ok(r3), "call 3 ok")

  let r4 = limit_check(lim)
  assert(is_err(r4), "call 4 = limit exceeded")
  assert(contains(unwrap_err(r4), "call limit"), "error message")

  limit_reset(lim)
  assert(limit_remaining_calls(lim) == 3, "reset works")
  let r5 = limit_check(lim)
  assert(is_ok(r5), "after reset ok")

  let time_lim = limit_new(1000, 50)
  let _c1 = limit_check(time_lim)
  sleep(60)
  let c2 = limit_check(time_lim)
  assert(is_err(c2), "time limit exceeded")

  print("rlimitx: all passed")
