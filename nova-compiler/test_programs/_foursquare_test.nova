// KAT test for std/cipher/foursquare
import std/cipher/foursquare

fn cks(label, got, want)
    if got != want
        print("FAIL foursquare " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // ── KAT 1: hand-verified encrypt vector ──────────────────────────────────
    // Manually verified with I=J squares:
    //   TR(EXAMPLE): EXAMP/LBCDF/GHIKN/OQRST/UVWYZ
    //   BL(KEYWORD): KEYWO/RDABC/FGHIL/MNPQS/TUVXZ
    //   std:         ABCDE/FGHIK/LMNOP/QRSTU/VWXYZ
    // HE->FY  LP->NF  ME->NE  OB->HW  IW->BX  AN->AF => "FYNFNEHWBXAF"
    cks("known_enc", foursquare_encrypt("HELPMEOBIWAN", "EXAMPLE", "KEYWORD"), "FYNFNEHWBXAF")

    // ── KAT 2: decrypt the known vector ──────────────────────────────────────
    cks("known_dec", foursquare_decrypt("FYNFNEHWBXAF", "EXAMPLE", "KEYWORD"), "HELPMEOBIWAN")

    // ── KAT 3: round-trip with distinct keys ──────────────────────────────────
    let pt3 = "THEQUICKBROWNFOX"
    let enc3 = foursquare_encrypt(pt3, "NOVA", "CIPHER")
    let dec3 = foursquare_decrypt(enc3, "NOVA", "CIPHER")
    cks("roundtrip_distinct", dec3, pt3)

    // ── KAT 4: round-trip with equal keys ─────────────────────────────────────
    let pt4 = "ATTACKATDAWN"
    let enc4 = foursquare_encrypt(pt4, "SECRET", "SECRET")
    let dec4 = foursquare_decrypt(enc4, "SECRET", "SECRET")
    cks("roundtrip_equal_keys", dec4, pt4)

    // ── KAT 5: odd-length input padded with X -> round-trip includes trailing X
    // "HELLO" normalises to "HELLO" (len 5, odd) -> padded to "HELLOX"
    // After encrypt+decrypt we get back "HELLOX"
    let enc5 = foursquare_encrypt("HELLO", "NOVA", "WORLD")
    let dec5 = foursquare_decrypt(enc5, "NOVA", "WORLD")
    cks("odd_roundtrip", dec5, "HELLOX")

    // ── KAT 6: even-length input round-trip ───────────────────────────────────
    let pt6 = "NOVAISLOVE"
    let enc6 = foursquare_encrypt(pt6, "QUANTUM", "COMPUTING")
    let dec6 = foursquare_decrypt(enc6, "QUANTUM", "COMPUTING")
    cks("even_roundtrip", dec6, pt6)

    // ── KAT 7: empty input -> empty output ───────────────────────────────────
    cks("empty_enc", foursquare_encrypt("", "KEY", "WORD"), "")
    cks("empty_dec", foursquare_decrypt("", "KEY", "WORD"), "")

    // ── KAT 8: J is treated as I (I/J merge) ─────────────────────────────────
    // "JUMP" normalises to "IUMP" (J->I); encrypt then decrypt returns "IUMP"
    let enc8 = foursquare_encrypt("JUMP", "NOVA", "CIPHER")
    let dec8 = foursquare_decrypt(enc8, "NOVA", "CIPHER")
    cks("j_to_i", dec8, "IUMP")

    // ── KAT 9: non-letter characters are dropped ──────────────────────────────
    // "HE LP" normalises to "HELP" (len 4, even); round-trip gives "HELP"
    let enc9 = foursquare_encrypt("HE LP", "EXAMPLE", "KEYWORD")
    let dec9 = foursquare_decrypt(enc9, "EXAMPLE", "KEYWORD")
    cks("nonletter_drop", dec9, "HELP")

    // ── KAT 10: lowercase input normalised to uppercase ───────────────────────
    // lowercase "helpmeobiwan" should produce the same ciphertext as uppercase
    let enc10a = foursquare_encrypt("helpmeobiwan", "example", "keyword")
    let enc10b = foursquare_encrypt("HELPMEOBIWAN", "EXAMPLE", "KEYWORD")
    cks("lowercase_enc", enc10a, enc10b)

    // ── KAT 11: round-trip with long text ────────────────────────────────────
    // J is normalised to I, so the round-trip result uses I not J
    let pt11 = "THEFIVEBOKSINGIOCKSNUDGETHEWIZARDQUIETLY"
    let enc11 = foursquare_encrypt(pt11, "SPHINX", "WALTZ")
    let dec11 = foursquare_decrypt(enc11, "SPHINX", "WALTZ")
    cks("long_roundtrip", dec11, pt11)

    // ── KAT 12: key with duplicate letters handled correctly ──────────────────
    // "AABABC" as key -> deduped to ABC; should produce same as key "ABC"
    let enc12a = foursquare_encrypt("TESTME", "AABABC", "KEYWORD")
    let enc12b = foursquare_encrypt("TESTME", "ABC", "KEYWORD")
    cks("key_dedup", enc12a, enc12b)

    // ── KAT 13: single-pair sanity check (hand-traced) ────────────────────────
    // HE -> TR[1][4]=F, BL[0][2]=Y => FY; round-trip verifies
    let enc13 = foursquare_encrypt("HE", "EXAMPLE", "KEYWORD")
    cks("single_pair_he_enc", enc13, "FY")
    cks("single_pair_dec", foursquare_decrypt("FY", "EXAMPLE", "KEYWORD"), "HE")

    // ── KAT 14: key containing J -> J treated as I in key square ─────────────
    // Key "JAB" -> J becomes I -> effectively key "IAB"
    let enc14a = foursquare_encrypt("NOVA", "JAB", "WORD")
    let enc14b = foursquare_encrypt("NOVA", "IAB", "WORD")
    cks("key_j_to_i", enc14a, enc14b)

    print("PASS _foursquare_test")
