import std/devtool/gitignore_match

fn main()
    // --- gim_test: basic unanchored glob ---
    let r1 = gim_test("*.log", "test.log", 0)
    if r1 != 1
        print("FAIL gim_test-basic-match: got " + str(r1) + " want 1")
        exit(1)

    let r2 = gim_test("*.log", "test.txt", 0)
    if r2 != 0
        print("FAIL gim_test-basic-nomatch: got " + str(r2) + " want 0")
        exit(1)

    let r3 = gim_test("*.log", "a/b/test.log", 0)
    if r3 != 1
        print("FAIL gim_test-unanchored-basename: got " + str(r3) + " want 1")
        exit(1)

    // --- gim_test: directory-only ---
    let r4 = gim_test("build/", "build", 1)
    if r4 != 1
        print("FAIL gim_test-dironly-isdir: got " + str(r4) + " want 1")
        exit(1)

    let r5 = gim_test("build/", "build", 0)
    if r5 != 0
        print("FAIL gim_test-dironly-notdir: got " + str(r5) + " want 0")
        exit(1)

    // --- gim_test: anchored segment match ---
    let r6 = gim_test("src/*.rs", "src/main.rs", 0)
    if r6 != 1
        print("FAIL gim_test-anchored-match: got " + str(r6) + " want 1")
        exit(1)

    let r7 = gim_test("src/*.rs", "lib/main.rs", 0)
    if r7 != 0
        print("FAIL gim_test-anchored-wrongprefix: got " + str(r7) + " want 0")
        exit(1)

    // --- gim_test: negation prefix stripped, body still matches ---
    let r8 = gim_test("!*.log", "test.log", 0)
    if r8 != 1
        print("FAIL gim_test-negated-still-matches: got " + str(r8) + " want 1")
        exit(1)

    // --- gim_test: adjacent probes ---
    // "?" single-char wildcard
    let r9 = gim_test("a?c", "abc", 0)
    if r9 != 1
        print("FAIL gim_test-qmark-match: got " + str(r9) + " want 1")
        exit(1)
    let r10 = gim_test("a?c", "abbc", 0)
    if r10 != 0
        print("FAIL gim_test-qmark-nomatch: got " + str(r10) + " want 0")
        exit(1)

    // character class
    let r11 = gim_test("*.[oa]", "lib.o", 0)
    if r11 != 1
        print("FAIL gim_test-class-o: got " + str(r11) + " want 1")
        exit(1)
    let r12 = gim_test("*.[oa]", "lib.a", 0)
    if r12 != 1
        print("FAIL gim_test-class-a: got " + str(r12) + " want 1")
        exit(1)
    let r13 = gim_test("*.[oa]", "lib.c", 0)
    if r13 != 0
        print("FAIL gim_test-class-nomatch: got " + str(r13) + " want 0")
        exit(1)

    // range class
    let r14 = gim_test("[a-c]og", "bog", 0)
    if r14 != 1
        print("FAIL gim_test-range-match: got " + str(r14) + " want 1")
        exit(1)
    let r15 = gim_test("[a-c]og", "dog", 0)
    if r15 != 0
        print("FAIL gim_test-range-nomatch: got " + str(r15) + " want 0")
        exit(1)

    // negated class
    let r16 = gim_test("[!a-c]og", "dog", 0)
    if r16 != 1
        print("FAIL gim_test-negclass-match: got " + str(r16) + " want 1")
        exit(1)
    let r17 = gim_test("[!a-c]og", "bog", 0)
    if r17 != 0
        print("FAIL gim_test-negclass-nomatch: got " + str(r17) + " want 0")
        exit(1)

    // globstar leading: "**/foo" matches "foo" and "a/b/foo"
    let r18 = gim_test("**/foo", "foo", 0)
    if r18 != 1
        print("FAIL gim_test-globstar-leading-bare: got " + str(r18) + " want 1")
        exit(1)
    let r19 = gim_test("**/foo", "a/b/foo", 0)
    if r19 != 1
        print("FAIL gim_test-globstar-leading-deep: got " + str(r19) + " want 1")
        exit(1)

    // globstar trailing: "foo/**" matches "foo/a/b" but not "foo" itself
    let r20 = gim_test("foo/**", "foo/a/b", 0)
    if r20 != 1
        print("FAIL gim_test-globstar-trailing-match: got " + str(r20) + " want 1")
        exit(1)
    let r21 = gim_test("foo/**", "foo", 1)
    if r21 != 0
        print("FAIL gim_test-globstar-trailing-selfnomatch: got " + str(r21) + " want 0")
        exit(1)

    // globstar middle: "a/**/b" matches "a/b" and "a/x/y/b"
    let r22 = gim_test("a/**/b", "a/b", 0)
    if r22 != 1
        print("FAIL gim_test-globstar-middle-zero: got " + str(r22) + " want 1")
        exit(1)
    let r23 = gim_test("a/**/b", "a/x/y/b", 0)
    if r23 != 1
        print("FAIL gim_test-globstar-middle-many: got " + str(r23) + " want 1")
        exit(1)
    let r24 = gim_test("a/**/b", "a/x/y/c", 0)
    if r24 != 0
        print("FAIL gim_test-globstar-middle-nomatch: got " + str(r24) + " want 0")
        exit(1)

    // --- gim_classify ---
    let c1 = gim_classify("!build/")
    if c1[0] != "build" or c1[1] != 1 or c1[2] != 1 or c1[3] != 0
        print("FAIL gim_classify-negdir: got [" + c1[0] + "," + str(c1[1]) + "," + str(c1[2]) + "," + str(c1[3]) + "]")
        exit(1)

    let c2 = gim_classify("src/*.rs")
    if c2[0] != "src/*.rs" or c2[1] != 0 or c2[2] != 0 or c2[3] != 1
        print("FAIL gim_classify-anchored: got [" + c2[0] + "," + str(c2[1]) + "," + str(c2[2]) + "," + str(c2[3]) + "]")
        exit(1)

    let c3 = gim_classify("*.log")
    if c3[0] != "*.log" or c3[1] != 0 or c3[2] != 0 or c3[3] != 0
        print("FAIL gim_classify-plain: got [" + c3[0] + "," + str(c3[1]) + "," + str(c3[2]) + "," + str(c3[3]) + "]")
        exit(1)

    // --- gim_filter ---
    let pats1 = []
    push(pats1, "*.log")
    push(pats1, "!important.log")
    let f1 = gim_filter(pats1, "important.log", 0)
    if f1 != 0
        print("FAIL gim_filter-negation-wins: got " + str(f1) + " want 0")
        exit(1)

    let f2 = gim_filter(pats1, "other.log", 0)
    if f2 != 1
        print("FAIL gim_filter-ignored: got " + str(f2) + " want 1")
        exit(1)

    let empty_pats = []
    let f3 = gim_filter(empty_pats, "anything.log", 0)
    if f3 != 0
        print("FAIL gim_filter-empty: got " + str(f3) + " want 0")
        exit(1)

    // last-match-wins ordering: later plain pattern re-ignores after an earlier negation
    let pats2 = []
    push(pats2, "*.log")
    push(pats2, "!important.log")
    push(pats2, "important.log")
    let f4 = gim_filter(pats2, "important.log", 0)
    if f4 != 1
        print("FAIL gim_filter-reignored: got " + str(f4) + " want 1")
        exit(1)

    // --- gim_matching_patterns ---
    let m1 = gim_matching_patterns(pats1, "important.log", 0)
    if len(m1) != 2 or m1[0] != 0 or m1[1] != 1
        print("FAIL gim_matching_patterns-both: got len=" + str(len(m1)))
        exit(1)

    let pats3 = []
    push(pats3, "*.log")
    push(pats3, "*.txt")
    let m2 = gim_matching_patterns(pats3, "readme.txt", 0)
    if len(m2) != 1 or m2[0] != 1
        print("FAIL gim_matching_patterns-onlyone: got len=" + str(len(m2)))
        exit(1)

    print("PASS _gitignore_match_test")
