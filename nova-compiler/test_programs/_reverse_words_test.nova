import std/text/reverse_words

// ── check helpers ─────────────────────────────────────────────────────────────
fn cks(label, got, exp)
    if got != exp
        print("FAIL " + label + ": got=" + got + " expected=" + exp)
        exit(1)

// ── rw_reverse_words ──────────────────────────────────────────────────────────
// Spec KATs
cks("spec1",  rw_reverse_words("the quick brown fox"), "fox brown quick the")
cks("spec2",  rw_reverse_words("  a  b "),             "b a")
cks("spec3",  rw_reverse_words("single"),              "single")

// Additional edge cases
cks("empty",       rw_reverse_words(""),               "")
cks("two words",   rw_reverse_words("hello world"),    "world hello")
cks("trailing sp", rw_reverse_words("a b "),           "b a")
cks("leading sp",  rw_reverse_words("  foo"),          "foo")
cks("three words", rw_reverse_words("one two three"),  "three two one")

// ── rw_reverse_each ───────────────────────────────────────────────────────────
// Spec KAT
cks("each_spec",   rw_reverse_each("hello world"),     "olleh dlrow")

// Additional cases
cks("each_single", rw_reverse_each("abc"),             "cba")
cks("each_empty",  rw_reverse_each(""),                "")
cks("each_three",  rw_reverse_each("one two three"),   "eno owt eerht")
cks("each_palind", rw_reverse_each("racecar"),         "racecar")
cks("each_spaces", rw_reverse_each("  a  b "),         "a b")

// ── rw_reverse_string ─────────────────────────────────────────────────────────
// Spec KATs
cks("rev_abc",     rw_reverse_string("abc"),           "cba")
cks("rev_empty",   rw_reverse_string(""),              "")

// Additional cases
cks("rev_single",  rw_reverse_string("x"),             "x")
cks("rev_hello",   rw_reverse_string("hello"),         "olleh")
cks("rev_palind",  rw_reverse_string("racecar"),       "racecar")
cks("rev_nums",    rw_reverse_string("12345"),         "54321")
cks("rev_spaces",  rw_reverse_string("a b c"),         "c b a")

print("_reverse_words_test passed")
