// Minimal repro: a struct field holding a CLOSURE, then called.
// Expected: prints 7 then 12.
// Bug: `c.op(...)` lowers to `call @nova_rt_op(...)` — a runtime builtin that
// does not exist — so the program fails to LINK.
type Calc
    op: any
    label: string

fn direct_call_test()
    let c = Calc(fn(a, b) a + b, "add")
    // 1) call through a local binding — the pattern that is believed to work
    let f = c.op
    print(f(3, 4))

fn field_call_test()
    let c = Calc(fn(a, b) a + b, "add")
    // 2) call the field DIRECTLY — this is the shape forge uses (ws.recv_fn())
    print(c.op(5, 7))

fn main()
    direct_call_test()
    field_call_test()
