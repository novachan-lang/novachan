fn main()
  let t = {}
  t["frames"] = []
  let f = {}
  f["name"] = "main"
  f["enter_ms"] = time_ms()
  f["exit_ms"] = 0
  push(t["frames"], f)
  let frames = t["frames"]
  let i = len(frames) - 1
  while i >= 0
    if frames[i]["exit_ms"] == 0
      frames[i]["exit_ms"] = time_ms()
    i = i - 1
  print("r2 ok")
