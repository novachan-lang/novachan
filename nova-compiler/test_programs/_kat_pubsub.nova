import forge_pubsub

fn main()
    let p = ps_new()
    let r1 = ps_create_topic(p, "events")
    assert(is_ok(r1), "create topic ok")
    p = unwrap(r1)
    assert(ps_topic_count(p) == 1, "1 topic")

    let dup = ps_create_topic(p, "events")
    assert(is_err(dup), "duplicate topic")

    let r2 = ps_subscribe(p, "events", "worker1")
    assert(is_ok(r2), "subscribe ok")
    p = unwrap(r2)
    let r3 = ps_subscribe(p, "events", "worker2")
    assert(is_ok(r3), "subscribe 2 ok")
    p = unwrap(r3)
    assert(ps_subscriber_count(p, "events") == 2, "2 subscribers")

    let r4 = ps_publish(p, "events", "hello")
    assert(is_ok(r4), "publish ok")
    p = unwrap(r4)
    assert(ps_total_published(p) == 1, "1 published")
    assert(ps_total_delivered(p) == 2, "2 delivered")

    let bad = ps_publish(p, "nope", "x")
    assert(is_err(bad), "unknown topic")

    print("PUBSUB KAT PASS")
