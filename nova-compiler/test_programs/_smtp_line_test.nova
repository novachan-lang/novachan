// KAT for std/net/smtp_line — SMTP line codec (RFC 5321).
import std/net/smtp_line

// ── Assert helpers ───────────────────────────────────────────────────────────

fn assert_s(label: string, got: string, want: string)
    if got != want
        print("FAIL smtp_line " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn assert_i(label: string, got: int, want: int)
    if got != want
        print("FAIL smtp_line " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let crlf = chr(13) + chr(10)

    // ── KAT 1: single-line parse "250 OK" ────────────────────────────────────
    let r1 = smtp_reply_parse("250 OK")
    assert_i("single-code",     r1["code"],     250)
    assert_i("single-complete", r1["complete"],   1)
    let r1lines = r1["lines"]
    assert_i("single-lines-len", len(r1lines), 1)
    assert_s("single-lines-0",   r1lines[0], "OK")

    // ── KAT 2: multi-line EHLO reply ─────────────────────────────────────────
    let multi = "250-mail.example.com" + crlf + "250-STARTTLS" + crlf + "250 SIZE 10240000"
    let r2 = smtp_reply_parse(multi)
    assert_i("multi-code",     r2["code"],     250)
    assert_i("multi-complete", r2["complete"],   1)
    let r2lines = r2["lines"]
    assert_i("multi-lines-len", len(r2lines), 3)
    assert_s("multi-lines-0",   r2lines[0], "mail.example.com")
    assert_s("multi-lines-1",   r2lines[1], "STARTTLS")
    assert_s("multi-lines-2",   r2lines[2], "SIZE 10240000")

    // ── KAT 3: smtp_ehlo_caps extracts capabilities (skipping greeting) ───────
    let caps = smtp_ehlo_caps(multi)
    assert_i("caps-len", len(caps), 2)
    assert_s("caps-0", caps[0], "STARTTLS")
    assert_s("caps-1", caps[1], "SIZE 10240000")

    // ── KAT 4: smtp_command with path arg (MAIL FROM) ─────────────────────────
    let cmd1 = smtp_command("MAIL FROM", "<a@b>")
    assert_s("cmd-mailfrom", cmd1, "MAIL FROM:<a@b>" + crlf)

    // ── KAT 5: smtp_command with no arg (QUIT) ────────────────────────────────
    let cmd2 = smtp_command("QUIT", "")
    assert_s("cmd-quit", cmd2, "QUIT" + crlf)

    // ── KAT 6: smtp_is_positive — 2xx is positive ─────────────────────────────
    assert_i("pos-250", smtp_is_positive(250), 1)
    assert_i("pos-220", smtp_is_positive(220), 1)
    assert_i("pos-200", smtp_is_positive(200), 1)
    assert_i("pos-354", smtp_is_positive(354), 1)
    assert_i("pos-399", smtp_is_positive(399), 1)

    // ── KAT 7: smtp_is_positive — 4xx/5xx/1xx are NOT positive ───────────────
    assert_i("neg-550", smtp_is_positive(550), 0)
    assert_i("neg-421", smtp_is_positive(421), 0)
    assert_i("neg-100", smtp_is_positive(100), 0)
    assert_i("neg-400", smtp_is_positive(400), 0)
    assert_i("neg-500", smtp_is_positive(500), 0)

    // ── KAT 8: smtp_command with non-path arg (EHLO domain) ──────────────────
    let cmd3 = smtp_command("EHLO", "mail.example.com")
    assert_s("cmd-ehlo", cmd3, "EHLO mail.example.com" + crlf)

    // ── KAT 9: smtp_command RCPT TO with path arg ────────────────────────────
    let cmd4 = smtp_command("RCPT TO", "<user@domain.org>")
    assert_s("cmd-rcptto", cmd4, "RCPT TO:<user@domain.org>" + crlf)

    // ── KAT 10: smtp_command no-arg commands ─────────────────────────────────
    let cmd5 = smtp_command("DATA", "")
    assert_s("cmd-data", cmd5, "DATA" + crlf)
    let cmd6 = smtp_command("RSET", "")
    assert_s("cmd-rset", cmd6, "RSET" + crlf)
    let cmd7 = smtp_command("NOOP", "")
    assert_s("cmd-noop", cmd7, "NOOP" + crlf)

    // ── KAT 11: malformed reply → code=0, complete=0 ─────────────────────────
    let rbad = smtp_reply_parse("hello world")
    assert_i("bad-code",     rbad["code"],     0)
    assert_i("bad-complete", rbad["complete"],  0)

    // ── KAT 12: partial multi-line (no terminator) → complete=0 ──────────────
    let partial = "250-mail.example.com" + crlf + "250-STARTTLS"
    let rp = smtp_reply_parse(partial)
    assert_i("partial-code",     rp["code"],    250)
    assert_i("partial-complete", rp["complete"],  0)

    // ── KAT 13: single-line with CRLF terminator ─────────────────────────────
    let r13 = smtp_reply_parse("220 ESMTP ready" + crlf)
    assert_i("crlf-code",     r13["code"],     220)
    assert_i("crlf-complete", r13["complete"],   1)
    let r13lines = r13["lines"]
    assert_s("crlf-text", r13lines[0], "ESMTP ready")

    // ── KAT 14: error reply parse ─────────────────────────────────────────────
    let r14 = smtp_reply_parse("550 No such user here")
    assert_i("err-code",     r14["code"],     550)
    assert_i("err-complete", r14["complete"],   1)
    let r14lines = r14["lines"]
    assert_s("err-text", r14lines[0], "No such user here")

    // ── KAT 15: 4xx transient error ──────────────────────────────────────────
    let r15 = smtp_reply_parse("421 Service temporarily unavailable")
    assert_i("4xx-code",     r15["code"],     421)
    assert_i("4xx-complete", r15["complete"],   1)
    assert_i("4xx-positive", smtp_is_positive(421), 0)

    // ── KAT 16: smtp_ehlo_caps on single-line reply → empty list ─────────────
    let caps2 = smtp_ehlo_caps("250 OK")
    assert_i("caps-single-len", len(caps2), 0)

    // ── KAT 17: round-trip parse-and-verify on multi ─────────────────────────
    // Ensure that parse(multi) captures all three lines correctly.
    let r17 = smtp_reply_parse(multi)
    assert_i("rt-code", r17["code"], 250)
    assert_i("rt-complete", r17["complete"], 1)
    let r17lines = r17["lines"]
    assert_i("rt-len", len(r17lines), 3)

    print("PASS _smtp_line_test")
