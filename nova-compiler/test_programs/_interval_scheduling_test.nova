import std/interval/interval_scheduling

// _is_iv_eq: compare two intervals by value
fn _is_iv_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    if a[0] != b[0]
        return false
    if a[1] != b[1]
        return false
    return true

// _is_nonoverlap: true if all intervals in list are mutually non-overlapping
// (uses strict: for scheduling, [a,b] and [b,c] are compatible because b <= b)
fn _is_nonoverlap(ivs: list) -> bool
    let n = len(ivs)
    let i = 0
    while i < n
        let j = i + 1
        while j < n
            let a = ivs[i]
            let b = ivs[j]
            // overlap if a_lo < b_hi and b_lo < a_hi (strict interior overlap)
            // for scheduling touching is ok: a_hi <= b_lo means NO overlap
            // overlap means NOT (a[1] <= b[0] or b[1] <= a[0])
            let no_overlap = false
            if a[1] <= b[0]
                no_overlap = true
            if b[1] <= a[0]
                no_overlap = true
            if not no_overlap
                return false
            j = j + 1
        i = i + 1
    return true

fn _fail(label: string, msg: string)
    print("FAIL isch_" + label + ": " + msg)
    exit(1)

fn main()
    // KAT 1: isch_count([[1,3],[2,4],[3,5]]) == 2
    // Greedy by finish: pick [1,3], skip [2,4] (overlaps), pick [3,5] => 2
    let ivs1 = []
    let iv1a = []
    push(iv1a, 1)
    push(iv1a, 3)
    push(ivs1, iv1a)
    let iv1b = []
    push(iv1b, 2)
    push(iv1b, 4)
    push(ivs1, iv1b)
    let iv1c = []
    push(iv1c, 3)
    push(iv1c, 5)
    push(ivs1, iv1c)
    let cnt1 = isch_count(ivs1)
    if cnt1 != 2
        _fail("count1", "got=" + str(cnt1) + " want=2")

    // KAT 2: isch_max_nonoverlap([[1,2],[2,3],[3,4]]) == [[1,2],[2,3],[3,4]] (all 3)
    let ivs2 = []
    let iv2a = []
    push(iv2a, 1)
    push(iv2a, 2)
    push(ivs2, iv2a)
    let iv2b = []
    push(iv2b, 2)
    push(iv2b, 3)
    push(ivs2, iv2b)
    let iv2c = []
    push(iv2c, 3)
    push(iv2c, 4)
    push(ivs2, iv2c)
    let sel2 = isch_max_nonoverlap(ivs2)
    if len(sel2) != 3
        _fail("max_nonoverlap2_len", "got=" + str(len(sel2)) + " want=3")
    if not _is_iv_eq(sel2[0], iv2a)
        _fail("max_nonoverlap2[0]", "got=" + str(sel2[0]) + " want=[1,2]")
    if not _is_iv_eq(sel2[1], iv2b)
        _fail("max_nonoverlap2[1]", "got=" + str(sel2[1]) + " want=[2,3]")
    if not _is_iv_eq(sel2[2], iv2c)
        _fail("max_nonoverlap2[2]", "got=" + str(sel2[2]) + " want=[3,4]")

    // KAT 3: isch_count([[1,4],[2,3],[3,5],[0,6]]) == 2
    let ivs3 = []
    let iv3a = []
    push(iv3a, 1)
    push(iv3a, 4)
    push(ivs3, iv3a)
    let iv3b = []
    push(iv3b, 2)
    push(iv3b, 3)
    push(ivs3, iv3b)
    let iv3c = []
    push(iv3c, 3)
    push(iv3c, 5)
    push(ivs3, iv3c)
    let iv3d = []
    push(iv3d, 0)
    push(iv3d, 6)
    push(ivs3, iv3d)
    let cnt3 = isch_count(ivs3)
    if cnt3 != 2
        _fail("count3", "got=" + str(cnt3) + " want=2")

    // KAT 4: isch_min_rooms([[1,4],[2,5],[7,8]]) == 2
    let ivs4 = []
    let iv4a = []
    push(iv4a, 1)
    push(iv4a, 4)
    push(ivs4, iv4a)
    let iv4b = []
    push(iv4b, 2)
    push(iv4b, 5)
    push(ivs4, iv4b)
    let iv4c = []
    push(iv4c, 7)
    push(iv4c, 8)
    push(ivs4, iv4c)
    let rooms4 = isch_min_rooms(ivs4)
    if rooms4 != 2
        _fail("min_rooms4", "got=" + str(rooms4) + " want=2")

    // KAT 5: isch_min_rooms([[1,2],[3,4]]) == 1 (disjoint)
    let ivs5 = []
    let iv5a = []
    push(iv5a, 1)
    push(iv5a, 2)
    push(ivs5, iv5a)
    let iv5b = []
    push(iv5b, 3)
    push(iv5b, 4)
    push(ivs5, iv5b)
    let rooms5 = isch_min_rooms(ivs5)
    if rooms5 != 1
        _fail("min_rooms5", "got=" + str(rooms5) + " want=1")

    // KAT 6: isch_weighted([[1,3],[2,5],[4,6]], [5,6,5]) == 10
    // Sorting by finish: [1,3](w5), [2,5](w6), [4,6](w5)
    // [1,3]+[4,6]=10 vs [2,5]=6 => 10
    let ivs6 = []
    let iv6a = []
    push(iv6a, 1)
    push(iv6a, 3)
    push(ivs6, iv6a)
    let iv6b = []
    push(iv6b, 2)
    push(iv6b, 5)
    push(ivs6, iv6b)
    let iv6c = []
    push(iv6c, 4)
    push(iv6c, 6)
    push(ivs6, iv6c)
    let wts6 = []
    push(wts6, 5)
    push(wts6, 6)
    push(wts6, 5)
    let wval6 = isch_weighted(ivs6, wts6)
    if wval6 != 10
        _fail("weighted6", "got=" + str(wval6) + " want=10")

    // KAT 7: isch_is_compatible([1,3],[3,5]) == true (touching allowed)
    let a7 = []
    push(a7, 1)
    push(a7, 3)
    let b7 = []
    push(b7, 3)
    push(b7, 5)
    let compat7 = isch_is_compatible(a7, b7)
    if compat7 != true
        _fail("is_compatible7_touching", "got=false want=true")

    // KAT 8: isch_is_compatible([1,4],[3,5]) == false (overlapping)
    let a8 = []
    push(a8, 1)
    push(a8, 4)
    let b8 = []
    push(b8, 3)
    push(b8, 5)
    let compat8 = isch_is_compatible(a8, b8)
    if compat8 != false
        _fail("is_compatible8_overlap", "got=true want=false")

    // KAT 9: isch_sort_by_finish produces ascending finish order
    let ivs9 = []
    let iv9a = []
    push(iv9a, 1)
    push(iv9a, 5)
    push(ivs9, iv9a)
    let iv9b = []
    push(iv9b, 2)
    push(iv9b, 3)
    push(ivs9, iv9b)
    let iv9c = []
    push(iv9c, 0)
    push(iv9c, 7)
    push(ivs9, iv9c)
    let sorted9 = isch_sort_by_finish(ivs9)
    if sorted9[0][1] != 3
        _fail("sort_by_finish9[0]", "finish got=" + str(sorted9[0][1]) + " want=3")
    if sorted9[1][1] != 5
        _fail("sort_by_finish9[1]", "finish got=" + str(sorted9[1][1]) + " want=5")
    if sorted9[2][1] != 7
        _fail("sort_by_finish9[2]", "finish got=" + str(sorted9[2][1]) + " want=7")

    // KAT 10: isch_min_rooms with all overlapping => n rooms
    let ivs10 = []
    let iv10a = []
    push(iv10a, 1)
    push(iv10a, 10)
    push(ivs10, iv10a)
    let iv10b = []
    push(iv10b, 2)
    push(iv10b, 9)
    push(ivs10, iv10b)
    let iv10c = []
    push(iv10c, 3)
    push(iv10c, 8)
    push(ivs10, iv10c)
    let rooms10 = isch_min_rooms(ivs10)
    if rooms10 != 3
        _fail("min_rooms10_all_overlap", "got=" + str(rooms10) + " want=3")

    // KAT 11: isch_count empty == 0
    let cnt11 = isch_count([])
    if cnt11 != 0
        _fail("count11_empty", "got=" + str(cnt11) + " want=0")

    // KAT 12: isch_min_rooms empty == 0
    let rooms12 = isch_min_rooms([])
    if rooms12 != 0
        _fail("min_rooms12_empty", "got=" + str(rooms12) + " want=0")

    // KAT 13: result of isch_max_nonoverlap is actually non-overlapping
    let sel1 = isch_max_nonoverlap(ivs1)
    if not _is_nonoverlap(sel1)
        _fail("max_nonoverlap1_valid", "result has overlapping intervals: " + str(sel1))

    // KAT 14: isch_weighted empty == 0
    let wval14 = isch_weighted([], [])
    if wval14 != 0
        _fail("weighted14_empty", "got=" + str(wval14))

    // KAT 15: isch_weighted single interval
    let ivs15 = []
    let iv15 = []
    push(iv15, 1)
    push(iv15, 5)
    push(ivs15, iv15)
    let wts15 = []
    push(wts15, 42)
    let wval15 = isch_weighted(ivs15, wts15)
    if wval15 != 42
        _fail("weighted15_single", "got=" + str(wval15) + " want=42")

    print("PASS _interval_scheduling_test")
