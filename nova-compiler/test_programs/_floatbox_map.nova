let xs = [1.5, 2.5, 3.5]

print("direct element print:")
print(xs[1])

print("bound element print:")
let y = xs[1]
print(y)

print("element arithmetic:")
let z = xs[1] + 0.0
print(z)

print("element compare:")
if xs[1] == 2.5
    print("eq-ok")
else
    print("eq-BAD")

print("element in fn:")
let s = str(xs[1])
print(s)
