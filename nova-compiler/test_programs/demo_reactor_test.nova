// NOVA Reactor v0.1 demo: a tiny ASCII Game-of-Life-ish simulation
// driven through reactor.run_n_ticks. Verifies the state evolves
// deterministically and the frame renderer produces the expected
// ASCII grid.
import reactor

// Glider-style toroidal pattern in a 5x5 grid; each tick rotates by 1.
fn update(state: list) -> list
    let n = len(state)
    let new_state = []
    let i = 0
    while i < n
        let prev = (i + n - 1) % n
        new_state.push(state[prev])
        i = i + 1
    new_state

fn main()
    // Initial grid: 5x5, single live cell at index 0
    let initial = []
    let i = 0
    while i < 25
        if i == 0
            initial.push(1)
        else
            initial.push(0)
        i = i + 1

    // After 7 ticks, the live cell should be at index 7
    let s = reactor.run_n_ticks(initial, update, 7)
    assert_eq(s[7], 1)
    assert_eq(s[0], 0)
    assert_eq(s[6], 0)

    // Render the frame — should be a 5x5 grid with a single # at position 7
    let frame = reactor.frame_to_str(s, 5, 5)
    // Row 0: 5 chars, all . (index 7 is in row 1)
    if find(frame, "..#..") < 0
        print("FAIL frame missing live cell marker: " + frame)
        exit(1)

    print("REACTOR v0.1 demo passed: 7-tick state evolution + ASCII frame render — game loop pattern works")
