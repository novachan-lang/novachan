// Diagnostic: exact pattern from run_self_test

type Token
    kind: string
    value: string
    line: int
    col: int

fn is_alpha(ch: string) -> bool
    let c = ord(ch)
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_"

fn is_digit(ch: string) -> bool
    let c = ord(ch)
    c >= 48 and c <= 57

fn is_alnum(ch: string) -> bool
    is_alpha(ch) or is_digit(ch)

fn is_ws(ch: string) -> bool
    ch == " " or ch == "\t" or ch == "\r"

fn is_keyword(word: string) -> bool
    (word == "fn" or word == "return" or word == "if" or word == "else" or word == "for" or word == "while" or word == "match" or word == "break" or word == "continue" or word == "type" or word == "enum" or word == "spawn" or word == "send" or word == "receive" or word == "channel" or word == "or" or word == "and" or word == "not" or word == "copy" or word == "import" or word == "true" or word == "false" or word == "in" or word == "as" or word == "select" or word == "try" or word == "catch" or word == "trait" or word == "matches" or word == "yield" or word == "let")

fn tokenize(source: string) -> list
    let tokens = []
    let pos = 0
    let line = 1
    let col = 1
    let length = len(source)

    while pos < length
        let ch = source[pos]

        if ch == "\n"
            push(tokens, Token("NEWLINE", "\\n", line, col))
            line = line + 1
            col = 1
            pos = pos + 1
        else if is_ws(ch)
            while pos < length and is_ws(source[pos])
                pos = pos + 1
                col = col + 1
        else if ch == "/" and pos + 1 < length and source[pos + 1] == "/"
            while pos < length and source[pos] != "\n"
                pos = pos + 1
                col = col + 1
        else if is_alpha(ch)
            let start_col = col
            let word = ""
            while pos < length and is_alnum(source[pos])
                word = word + source[pos]
                pos = pos + 1
                col = col + 1
            if is_keyword(word)
                push(tokens, Token("KW", word, line, start_col))
            else
                push(tokens, Token("IDENT", word, line, start_col))
        else if is_digit(ch)
            let start_col = col
            let num = ""
            while pos < length and is_digit(source[pos])
                num = num + source[pos]
                pos = pos + 1
                col = col + 1
            push(tokens, Token("INT", num, line, start_col))
        else if ch == "="
            push(tokens, Token("ASSIGN", "=", line, col))
            pos = pos + 1
            col = col + 1
        else if ch == "+"
            push(tokens, Token("OP", "+", line, col))
            pos = pos + 1
            col = col + 1
        else
            pos = pos + 1
            col = col + 1

    push(tokens, Token("EOF", "", line, col))
    tokens

// Exact self-test pattern
let tokens = tokenize("let x = 42 + 3")
let non_nl = []
for t in tokens
    match t
        Token(kind, value, line, col) =>
            if kind != "NEWLINE" and kind != "EOF"
                push(non_nl, t)

print(len(non_nl))
assert(len(non_nl) == 6, "expected 6 tokens, got " + str(len(non_nl)))

match non_nl[0]
    Token(k, v, l, c) => assert(k == "KW" and v == "let", "t0: " + k + ":" + v)
match non_nl[1]
    Token(k, v, l, c) => assert(k == "IDENT" and v == "x", "t1: " + k + ":" + v)
match non_nl[2]
    Token(k, v, l, c) => assert(k == "ASSIGN" and v == "=", "t2: " + k + ":" + v)
match non_nl[3]
    Token(k, v, l, c) => assert(k == "INT" and v == "42", "t3: " + k + ":" + v)
match non_nl[4]
    Token(k, v, l, c) => assert(k == "OP" and v == "+", "t4: " + k + ":" + v)
match non_nl[5]
    Token(k, v, l, c) => assert(k == "INT" and v == "3", "t5: " + k + ":" + v)

print("ALL LEXER TESTS PASSED")
