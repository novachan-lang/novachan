import std/devtool/gitignore_validate

fn main()
    // --- giv_check_pattern: clean pattern, no issues ---
    let c1 = giv_check_pattern("*.log")
    if len(c1) != 0
        print("FAIL giv_check_pattern-clean: got len=" + str(len(c1)))
        exit(1)

    // --- giv_check_pattern: lone "/" is an error ---
    let c2 = giv_check_pattern("/")
    if len(c2) != 1 or c2[0][0] != "error"
        print("FAIL giv_check_pattern-lone-slash: got len=" + str(len(c2)))
        exit(1)

    // --- giv_check_pattern: bare "*" is a warning ---
    let c3 = giv_check_pattern("*")
    if len(c3) != 1 or c3[0][0] != "warning"
        print("FAIL giv_check_pattern-bare-star: got len=" + str(len(c3)))
        exit(1)

    // --- giv_check_pattern: trailing whitespace is a warning ---
    let c4 = giv_check_pattern("*.log ")
    if len(c4) != 1 or c4[0][0] != "warning"
        print("FAIL giv_check_pattern-trailing-ws: got len=" + str(len(c4)))
        exit(1)

    // --- giv_check_pattern: backslash is a warning ---
    let c5 = giv_check_pattern("src\\file.txt")
    if len(c5) != 1 or c5[0][0] != "warning"
        print("FAIL giv_check_pattern-backslash: got len=" + str(len(c5)))
        exit(1)

    // --- giv_check_pattern: normal anchored pattern, no issues ---
    let c6 = giv_check_pattern("src/*.rs")
    if len(c6) != 0
        print("FAIL giv_check_pattern-anchored-clean: got len=" + str(len(c6)))
        exit(1)

    // --- giv_validate: duplicate pattern ---
    let v1 = giv_validate("*.log\n*.log\n")
    let found_dup = 0
    let i = 0
    let n1 = len(v1)
    while i < n1
        if v1[i][1] == "warning" and find(v1[i][2], "duplicate") != -1
            found_dup = 1
        i = i + 1
    if found_dup != 1
        print("FAIL giv_validate-duplicate: not found in " + giv_format_issues(v1))
        exit(1)
    if v1[len(v1) - 1][0] != 2
        print("FAIL giv_validate-duplicate-lineno: got " + str(v1[len(v1) - 1][0]) + " want 2")
        exit(1)

    // --- giv_validate: lone "/" error ---
    let v2 = giv_validate("/\n")
    if len(v2) != 1 or v2[0][1] != "error" or v2[0][0] != 1
        print("FAIL giv_validate-lone-slash: got " + giv_format_issues(v2))
        exit(1)

    // --- giv_validate: trailing whitespace warning ---
    let v3 = giv_validate("*.log  \n")
    if len(v3) != 1 or v3[0][1] != "warning" or v3[0][0] != 1
        print("FAIL giv_validate-trailing-ws: got " + giv_format_issues(v3))
        exit(1)

    // --- giv_validate: blank lines and comments are skipped entirely ---
    let v4 = giv_validate("\n# a comment\n   \n*.log\n")
    if len(v4) != 0
        print("FAIL giv_validate-blanks-comments: got " + giv_format_issues(v4))
        exit(1)

    // --- giv_validate: negation with no prior pattern ---
    let v5 = giv_validate("!foo.log\n")
    let found_neg = 0
    let j = 0
    let n5 = len(v5)
    while j < n5
        if v5[j][1] == "warning" and find(v5[j][2], "negates") != -1
            found_neg = 1
        j = j + 1
    if found_neg != 1
        print("FAIL giv_validate-dangling-negation: not found in " + giv_format_issues(v5))
        exit(1)

    // --- giv_validate: negation WITH a prior pattern raises no dangling-negation warning ---
    let v6 = giv_validate("foo.log\n!foo.log\n")
    let bad_neg = 0
    let k = 0
    let n6 = len(v6)
    while k < n6
        if find(v6[k][2], "negates") != -1
            bad_neg = 1
        k = k + 1
    if bad_neg != 0
        print("FAIL giv_validate-valid-negation-falsepositive: got " + giv_format_issues(v6))
        exit(1)

    // --- giv_validate: CRLF line endings handled ---
    let v7 = giv_validate("*.log\r\n*.log\r\n")
    let found_dup2 = 0
    let m = 0
    let n7 = len(v7)
    while m < n7
        if find(v7[m][2], "duplicate") != -1
            found_dup2 = 1
        m = m + 1
    if found_dup2 != 1
        print("FAIL giv_validate-crlf-duplicate: got " + giv_format_issues(v7))
        exit(1)

    // --- giv_has_errors ---
    let empty_issues = []
    if giv_has_errors(empty_issues) != 0
        print("FAIL giv_has_errors-empty: want 0")
        exit(1)

    if giv_has_errors(v2) != 1
        print("FAIL giv_has_errors-witherror: want 1")
        exit(1)

    if giv_has_errors(v3) != 0
        print("FAIL giv_has_errors-onlywarning: want 0")
        exit(1)

    // --- giv_format_issues ---
    let fmt_empty = giv_format_issues(empty_issues)
    if len(fmt_empty) == 0
        print("FAIL giv_format_issues-empty: got empty string")
        exit(1)

    let fmt_v2 = giv_format_issues(v2)
    if len(fmt_v2) == 0 or find(fmt_v2, "error") == -1
        print("FAIL giv_format_issues-nonempty: got '" + fmt_v2 + "'")
        exit(1)

    print("PASS _gitignore_validate_test")
