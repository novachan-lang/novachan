// KAT for std/text/acronym
import std/text/acronym

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // ac_acronym basic KAT vectors
    cks("png",      ac_acronym("Portable Network Graphics"), "PNG")
    cks("yolo",     ac_acronym("you only live once"),        "YOLO")
    cks("spaces",   ac_acronym("  multiple   spaces  here "), "MSH")
    cks("empty",    ac_acronym(""),                           "")
    cks("single",   ac_acronym("hello"),                      "H")
    cks("mixed",    ac_acronym("National Aeronautics and Space Administration"), "NAASA")

    // ac_initials KAT vectors
    cks("jrr",      ac_initials("John Ronald Reuel", "."), "J.R.R.")
    cks("init_sp",  ac_initials("Alan Mathison Turing", "."), "A.M.T.")
    cks("init_dash",ac_initials("Grace Murray Hopper", "-"), "G-M-H-")

    // ac_abbreviate KAT vectors — skip=1 omits a/an/the/of/and/for/to/in/on
    cks("lotr",     ac_abbreviate("The Lord of the Rings", 1),   "LR")
    cks("sa",       ac_abbreviate("The Sound of Music", 1),      "SM")
    cks("noskip",   ac_abbreviate("The Lord of the Rings", 0),   "TLOTR")
    cks("abbr_yolo",ac_abbreviate("you only live once", 1),      "YOLO")

    print("_acronym_test passed")
