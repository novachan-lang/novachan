// DNS resolution (cat-13): dns_resolve_all returns ALL IPv4 addresses for a host as a
// list of dotted-quad strings; reverse_dns does a PTR (address->name) lookup. localhost
// resolves deterministically to the loopback 127.0.0.1 (IPv4 forced). reverse_dns's exact
// name is environment-dependent, so we assert only that it returns a string (never crashes).

fn _contains_addr(xs, target) -> int
    for a in xs
        if a == target
            return 1
    return 0

fn main()
    // all addresses for localhost include the IPv4 loopback
    let addrs = dns_resolve_all("localhost")
    assert_eq(type_of(addrs), "list")
    assert_eq(_contains_addr(addrs, "127.0.0.1"), 1)

    // empty/invalid host -> empty list, never a crash
    let none = dns_resolve_all("")
    assert_eq(type_of(none), "list")
    assert_eq(len(none), 0)

    // reverse_dns returns a string (value is environment-dependent), total/never crashes
    let name = reverse_dns("127.0.0.1")
    assert_eq(type_of(name), "string")
    // invalid input -> "" (deterministic failure)
    assert_eq(reverse_dns("not-an-ip"), "")

    print("dns_test passed")
