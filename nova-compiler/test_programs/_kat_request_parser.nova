import forge_request_parser

fn main()
    let crlf = chr(13) + chr(10)
    let raw = "GET /search?q=nova+lang&page=2 HTTP/1.1" + crlf + "Host: example.com" + crlf + "User-Agent: kat-client" + crlf + "Accept: */*" + crlf + crlf + "ignored-for-get"
    let r = rp_parse(raw)
    assert(is_ok(r), "parse ok")
    let st = unwrap(r)

    assert(rp_method(st) == "GET", "method GET")
    assert(rp_path(st) == "/search", "path /search")
    assert(rp_version(st) == "HTTP/1.1", "version HTTP/1.1")
    assert(rp_query_string(st) == "q=nova+lang&page=2", "raw query string")
    assert(rp_body(st) == "ignored-for-get", "body")
    assert(rp_header_count(st) == 3, "3 headers")

    let hh = rp_get_header(st, "Host")
    assert(is_ok(hh), "host header ok")
    assert(unwrap(hh) == "example.com", "host == example.com")

    let hua = rp_get_header(st, "User-Agent")
    assert(unwrap(hua) == "kat-client", "user-agent value")

    let hmiss = rp_get_header(st, "X-Nope")
    assert(is_err(hmiss), "missing header err")

    assert(rp_has_header(st, "Accept") == 1, "has accept")
    assert(rp_has_header(st, "X-Nope") == 0, "no X-Nope")

    let qq = rp_get_query(st, "q")
    assert(is_ok(qq), "query q ok")
    assert(unwrap(qq) == "nova lang", "q decoded == 'nova lang'")

    let qp = rp_get_query(st, "page")
    assert(unwrap(qp) == "2", "page == 2")

    let qmiss = rp_get_query(st, "nope")
    assert(is_err(qmiss), "missing query param err")

    // POST with a body and no query string
    let raw2 = "POST /api/items HTTP/1.1" + crlf + "Content-Type: application/json" + crlf + "Content-Length: 13" + crlf + crlf + "{\"a\":1}extra"
    let r2 = rp_parse(raw2)
    assert(is_ok(r2), "parse2 ok")
    let st2 = unwrap(r2)
    assert(rp_method(st2) == "POST", "method POST")
    assert(rp_path(st2) == "/api/items", "path /api/items")
    assert(rp_query_string(st2) == "", "no query string")
    assert(rp_body(st2) == "{\"a\":1}extra", "body2")
    assert(rp_header_count(st2) == 2, "2 headers on req2")

    // malformed request line
    let bad = rp_parse("garbage" + crlf + crlf)
    assert(is_err(bad), "malformed request line rejected")

    // empty request
    let empty = rp_parse("")
    assert(is_err(empty), "empty request rejected")

    print("REQUEST-PARSER KAT PASS")
