import std/text/lcsubstring

fn main()
    // KAT 1: length of longest common substring for GeeksforGeeks / GeeksQuiz == 5
    let r1 = lcstr_length("GeeksforGeeks", "GeeksQuiz")
    if r1 != 5
        print("FAIL KAT1: lcstr_length(GeeksforGeeks,GeeksQuiz) expected 5 got " + str(r1))
        exit(1)

    // KAT 2: actual substring for GeeksforGeeks / GeeksQuiz == "Geeks"
    let r2 = lcstr_longest("GeeksforGeeks", "GeeksQuiz")
    if r2 != "Geeks"
        print("FAIL KAT2: lcstr_longest(GeeksforGeeks,GeeksQuiz) expected Geeks got " + r2)
        exit(1)

    // KAT 3: length for abcdxyz / xyzabcd == 4
    let r3 = lcstr_length("abcdxyz", "xyzabcd")
    if r3 != 4
        print("FAIL KAT3: lcstr_length(abcdxyz,xyzabcd) expected 4 got " + str(r3))
        exit(1)

    // KAT 4: longest for abcdxyz / xyzabcd == "abcd"
    let r4 = lcstr_longest("abcdxyz", "xyzabcd")
    if r4 != "abcd"
        print("FAIL KAT4: lcstr_longest(abcdxyz,xyzabcd) expected abcd got " + r4)
        exit(1)

    // KAT 5: no common substring between abc and xyz => 0
    let r5 = lcstr_length("abc", "xyz")
    if r5 != 0
        print("FAIL KAT5: lcstr_length(abc,xyz) expected 0 got " + str(r5))
        exit(1)

    // KAT 6: longest common substring of "aaa" and "aa" == "aa" (length 2)
    let r6 = lcstr_longest("aaa", "aa")
    if r6 != "aa"
        print("FAIL KAT6: lcstr_longest(aaa,aa) expected aa got " + r6)
        exit(1)

    // KAT 7: empty string gives length 0
    let r7 = lcstr_length("", "abc")
    if r7 != 0
        print("FAIL KAT7: lcstr_length(empty,abc) expected 0 got " + str(r7))
        exit(1)

    // KAT 8: similarity for identical strings == 1.0
    let r8 = lcstr_similarity("hello", "hello")
    if r8 < 0.999
        print("FAIL KAT8: lcstr_similarity(hello,hello) expected ~1.0 got " + str(r8))
        exit(1)

    // KAT 9: similarity for no overlap == 0.0
    let r9 = lcstr_similarity("abc", "xyz")
    if r9 > 0.001
        print("FAIL KAT9: lcstr_similarity(abc,xyz) expected 0.0 got " + str(r9))
        exit(1)

    print("_lcsubstring_test passed")
