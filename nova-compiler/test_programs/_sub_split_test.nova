// KAT: std/data/sub_split
import std/data/sub_split

fn cki(label, got, want)
    if got != want
        print("FAIL sub_split " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label, got, want)
    if got != want
        print("FAIL sub_split " + label + ": got=[" + got + "] want=[" + want + "]")
        exit(1)

// ── Helper: build cue ────────────────────────────────────────────────────────
fn mk(idx, s, e, txt) -> dict
    let d = {}
    d["index"] = idx
    d["start"] = s
    d["end"] = e
    d["text"] = txt
    d

// ── Test 1: sub_split_at splits a spanning cue ───────────────────────────────
// Cue 1000-5000 split at 3000 → two cues: 1000-3000 and 3000-5000
let cue_span = mk(0, 1000, 5000, "Hello world")
let single_list = []
single_list.push(cue_span)

let split_result = sub_split_at(single_list, 3000)
cki("split_at_len",    len(split_result),        2)
cki("split_at_0_start", split_result[0]["start"], 1000)
cki("split_at_0_end",   split_result[0]["end"],   3000)
cki("split_at_1_start", split_result[1]["start"], 3000)
cki("split_at_1_end",   split_result[1]["end"],   5000)
cks("split_at_0_text",  split_result[0]["text"],  "Hello world")
cks("split_at_1_text",  split_result[1]["text"],  "Hello world")
cki("split_at_0_idx",   split_result[0]["index"], 0)
cki("split_at_1_idx",   split_result[1]["index"], 1)

// ── Test 2: sub_split_at does not split non-spanning cues ────────────────────
let cue_before = mk(0, 100, 500, "Before")
let cue_after  = mk(1, 6000, 9000, "After")
let multi = []
multi.push(cue_before)
multi.push(cue_span)
multi.push(cue_after)

let split_multi = sub_split_at(multi, 3000)
// cue_before (100-500): does not span 3000 → unchanged
// cue_span (1000-5000): spans 3000 → 2 parts
// cue_after (6000-9000): does not span 3000 → unchanged
// total = 4 cues
cki("split_multi_len",    len(split_multi), 4)
cki("split_multi_0_start", split_multi[0]["start"], 100)
cki("split_multi_0_end",   split_multi[0]["end"],   500)
cki("split_multi_1_start", split_multi[1]["start"], 1000)
cki("split_multi_1_end",   split_multi[1]["end"],   3000)
cki("split_multi_2_start", split_multi[2]["start"], 3000)
cki("split_multi_2_end",   split_multi[2]["end"],   5000)
cki("split_multi_3_start", split_multi[3]["start"], 6000)
// indices reassigned 0-3
cki("split_multi_3_idx",   split_multi[3]["index"], 3)

// ── Test 3: sub_split_at boundary time (not inside) → no split ───────────────
// time_ms == cue.start → not strictly inside → pass through
let cue_boundary = mk(0, 3000, 5000, "Boundary")
let blist = []
blist.push(cue_boundary)
let no_split = sub_split_at(blist, 3000)
cki("no_split_at_start_len", len(no_split), 1)

// ── Test 4: sub_split_at empty input ─────────────────────────────────────────
let empty_split = sub_split_at([], 1000)
cki("split_empty_len", len(empty_split), 0)

// ── Test 5: sub_split_long — long cue split into 3 equal parts ───────────────
// Cue 1000-9000 = 8000ms, max=3000 → ceil(8000/3000)=3 parts
// part_dur = 8000/3 = 2666ms
// parts: 1000-3666, 3666-6332, 6332-9000
let long_cue = mk(0, 1000, 9000, "Long")
let long_list = []
long_list.push(long_cue)

let split_long = sub_split_long(long_list, 3000)
cki("split_long_len",    len(split_long),        3)
cki("split_long_0_start", split_long[0]["start"], 1000)
cki("split_long_2_end",   split_long[2]["end"],   9000)
// each part should be <= 3000ms
let p0_dur = split_long[0]["end"] - split_long[0]["start"]
let p1_dur = split_long[1]["end"] - split_long[1]["start"]
let p2_dur = split_long[2]["end"] - split_long[2]["start"]
if p0_dur > 3000
    print("FAIL sub_split split_long_p0_dur too large: " + str(p0_dur))
    exit(1)
if p1_dur > 3000
    print("FAIL sub_split split_long_p1_dur too large: " + str(p1_dur))
    exit(1)
if p2_dur > 3000
    print("FAIL sub_split split_long_p2_dur too large: " + str(p2_dur))
    exit(1)
// Last part ends exactly at original end.
cki("split_long_last_end", split_long[2]["end"], 9000)
// Parts contiguous: end of k == start of k+1.
cki("split_long_contiguous_01", split_long[0]["end"], split_long[1]["start"])
cki("split_long_contiguous_12", split_long[1]["end"], split_long[2]["start"])
// text preserved in all parts
cks("split_long_0_text", split_long[0]["text"], "Long")
cks("split_long_2_text", split_long[2]["text"], "Long")

// ── Test 6: sub_split_long — cue within limit → unchanged ────────────────────
let short_cue = mk(0, 500, 2000, "Short")
let short_list = []
short_list.push(short_cue)

let no_long_split = sub_split_long(short_list, 3000)
cki("no_long_split_len",   len(no_long_split),        1)
cki("no_long_split_start", no_long_split[0]["start"], 500)
cki("no_long_split_end",   no_long_split[0]["end"],   2000)

// ── Test 7: sub_split_long exactly at limit → unchanged ──────────────────────
let exact_cue = mk(0, 0, 3000, "Exact")
let exact_list = []
exact_list.push(exact_cue)
let exact_split = sub_split_long(exact_list, 3000)
cki("exact_limit_len", len(exact_split), 1)

// ── Test 8: sub_split_long empty input ───────────────────────────────────────
let empty_long = sub_split_long([], 1000)
cki("split_long_empty_len", len(empty_long), 0)

// ── Test 9: sub_split_lines — 2-line cue → 2 cues ────────────────────────────
let two_line_txt = "Line one" + chr(10) + "Line two"
let two_line_cue = mk(0, 2000, 5000, two_line_txt)
let line_split = sub_split_lines(two_line_cue)
cki("split_lines_len",    len(line_split),        2)
cks("split_lines_0_text", line_split[0]["text"],  "Line one")
cks("split_lines_1_text", line_split[1]["text"],  "Line two")
cki("split_lines_0_start", line_split[0]["start"], 2000)
cki("split_lines_0_end",   line_split[0]["end"],   5000)
cki("split_lines_1_start", line_split[1]["start"], 2000)
cki("split_lines_1_end",   line_split[1]["end"],   5000)
cki("split_lines_0_idx",   line_split[0]["index"], 0)
cki("split_lines_1_idx",   line_split[1]["index"], 1)

// ── Test 10: sub_split_lines — single line → 1 cue ───────────────────────────
let single_line_cue = mk(0, 1000, 3000, "Solo line")
let solo_split = sub_split_lines(single_line_cue)
cki("solo_line_len",   len(solo_split),        1)
cks("solo_line_text",  solo_split[0]["text"],  "Solo line")

// ── Test 11: sub_split_lines — 3 lines ───────────────────────────────────────
let three_txt = "A" + chr(10) + "B" + chr(10) + "C"
let three_cue = mk(0, 0, 4000, three_txt)
let three_split = sub_split_lines(three_cue)
cki("three_lines_len",   len(three_split),       3)
cks("three_lines_0",     three_split[0]["text"], "A")
cks("three_lines_1",     three_split[1]["text"], "B")
cks("three_lines_2",     three_split[2]["text"], "C")

print("PASS _sub_split_test")
