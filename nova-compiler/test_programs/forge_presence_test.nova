// Forge S5: presence tracker actor. join (idempotent) / leave / list per topic, race-free via a
// single-owner loop. Socketless (actor over channels), deterministic, kill-on-timeout.
import forge_otp

fn main()
    let pr = presence()
    presence_join(pr, "room1", "alice")
    presence_join(pr, "room1", "bob")
    presence_join(pr, "room2", "carol")
    presence_join(pr, "room1", "alice")        // duplicate -> idempotent

    let r1 = presence_list(pr, "room1")
    if len(r1) != 2 or contains(r1, "alice") == false or contains(r1, "bob") == false
        print("FAIL room1: expected alice+bob, count=" + str(len(r1)))
        exit(1)
    let r2 = presence_list(pr, "room2")
    if len(r2) != 1 or contains(r2, "carol") == false
        print("FAIL room2: expected carol, count=" + str(len(r2)))
        exit(1)

    presence_leave(pr, "room1", "alice")
    let r3 = presence_list(pr, "room1")
    if len(r3) != 1 or contains(r3, "bob") == false or contains(r3, "alice")
        print("FAIL after leave: expected bob only, count=" + str(len(r3)))
        exit(1)

    let r4 = presence_list(pr, "nonexistent")
    if len(r4) != 0
        print("FAIL empty topic: count=" + str(len(r4)))
        exit(1)

    print("PASS forge_presence (join idempotent + multi-topic + leave + empty-topic)")
