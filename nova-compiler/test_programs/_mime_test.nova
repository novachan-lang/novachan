import std/net/mime

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // KAT: required spec assertions
    cks("html",         mime_type("index.html"),      "text/html")
    cks("PNG-upper",    mime_type("a.PNG"),            "image/png")
    cks("css",          mime_type("style.css"),        "text/css")
    cks("json",         mime_type("data.json"),        "application/json")
    cks("jpeg",         mime_type("photo.jpeg"),       "image/jpeg")
    cks("noext",        mime_type("noext"),            "")
    cks("zip",          mime_type("archive.zip"),      "application/zip")
    cks("mime_ext_html",mime_ext("text/html"),         "html")

    // Additional known-answer checks
    cks("htm",          mime_type("page.htm"),         "text/html")
    cks("jpg",          mime_type("photo.jpg"),        "image/jpeg")
    cks("js",           mime_type("app.js"),           "application/javascript")
    cks("svg",          mime_type("logo.svg"),         "image/svg+xml")
    cks("mp4",          mime_type("movie.mp4"),        "video/mp4")
    cks("mp3",          mime_type("song.mp3"),         "audio/mpeg")
    cks("pdf",          mime_type("doc.pdf"),          "application/pdf")
    cks("gif",          mime_type("anim.gif"),         "image/gif")
    cks("txt",          mime_type("readme.txt"),       "text/plain")
    cks("csv",          mime_type("data.CSV"),         "text/csv")
    cks("xml",          mime_type("feed.xml"),         "application/xml")
    cks("unknown_ext",  mime_type("file.xyz123"),      "")
    cks("dotfile",      mime_type(".gitignore"),       "")
    cks("multi_dot",    mime_type("archive.tar.gz"),   "application/gzip")
    cks("wasm",         mime_type("app.wasm"),         "application/wasm")

    // mime_ext reverse lookups
    cks("ext_css",      mime_ext("text/css"),          "css")
    cks("ext_json",     mime_ext("application/json"),  "json")
    cks("ext_png",      mime_ext("image/png"),         "png")
    cks("ext_jpeg",     mime_ext("image/jpeg"),        "jpg")
    cks("ext_mp4",      mime_ext("video/mp4"),         "mp4")
    cks("ext_mp3",      mime_ext("audio/mpeg"),        "mp3")
    cks("ext_pdf",      mime_ext("application/pdf"),   "pdf")
    cks("ext_zip",      mime_ext("application/zip"),   "zip")
    cks("ext_unknown",  mime_ext("application/x-unknown"), "")

    print("_mime_test passed")
