// Test: while loops, if/else, comparison operators
fn fizzbuzz(n)
    let i = 1
    let result = ""
    while i <= n
        if i % 15 == 0
            result = result + "FizzBuzz "
        else if i % 3 == 0
            result = result + "Fizz "
        else if i % 5 == 0
            result = result + "Buzz "
        else
            result = result + str(i) + " "
        i = i + 1
    return result

let out = fizzbuzz(15)
print(out)
