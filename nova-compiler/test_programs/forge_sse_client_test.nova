// forge_sse_client_test -- the SSE CONSUME client (D7r.4): forge_http_client.sse_connect/sse_next consume a
// Forge sse() endpoint end-to-end. A subscriber opens the stream via the API; a publisher POSTs to /pub
// (-> sse_send); the subscriber's sse_next returns exactly the published data. Uses sse() (no keepalive) so
// no comment events interleave.
import forge
import forge_http_client

fn _pub(req: Request, h)
    forge.sse_send(h, req.body)
    forge.resp_text(200, "ok")

fn _server(port: int)
    let a = forge.app()
    let h = forge.hub()
    forge.sse(a, "/events", h)
    forge.post(a, "/pub", fn(req) _pub(req, h))
    forge.serve_req_n(a, port, 3)   // SSE subscriber (long-lived) + 2 POST publishers = 3 connections

fn _post(port: int, body: string)
    let s = tcp_connect("127.0.0.1", port)
    tcp_send(s, "POST /pub HTTP/1.0\r\nContent-Length: " + str(len(body)) + "\r\n\r\n" + body)
    tcp_recv(s)
    tcp_close(s)

fn main()
    let port = 19387
    let p = port
    spawn fn()
        _server(p)
    sleep(300)

    // subscriber via the CONSUME API
    let sc = forge_http_client.sse_connect("http://127.0.0.1:" + str(port) + "/events")
    assert(is_ok(sc), "sse_connect opened the stream (200 text/event-stream)")
    let stream = unwrap(sc)
    print("PASS: sse_connect opened the SSE stream")
    sleep(150)   // let the subscriber register with the hub before publishing

    _post(port, "hello-from-sse-consume")
    let ev = forge_http_client.sse_next(stream)
    assert(is_ok(ev), "sse_next returned an event")
    assert(unwrap(ev) == "hello-from-sse-consume", "event data == published body [" + unwrap(ev) + "]")
    print("PASS: sse_next consumed the published event data")

    // a second event on the same stream
    _post(port, "second-event")
    let ev2 = forge_http_client.sse_next(stream)
    assert(is_ok(ev2) and unwrap(ev2) == "second-event", "sse_next consumed a 2nd event on the same stream")
    print("PASS: sse_next consumed a second event (stream state persists)")

    forge_http_client.sse_close(stream)
    print("forge_sse_client_test passed")
