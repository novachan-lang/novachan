fn config_new()
  let c = {}
  c

fn config_set(c, key, value)
  c[key] = value

fn config_get(c, key, default_val)
  if contains(c, key)
    return c[key]
  default_val

fn config_has(c, key)
  contains(c, key)

fn config_merge(base, overlay)
  let result = {}
  let bks = keys(base)
  for k in bks
    result[k] = base[k]
  let oks = keys(overlay)
  for k in oks
    result[k] = overlay[k]
  result

fn config_from_env(prefix, cfg_keys)
  let result = {}
  for k in cfg_keys
    let env_key = prefix + "_" + upper(k)
    let val = env(env_key)
    if val != ""
      result[k] = val
  result

fn config_to_logfmt(c)
  let parts = []
  let ks = keys(c)
  for k in ks
    push(parts, k + "=" + str(c[k]))
  join(parts, " ")

fn config_keys(c)
  keys(c)

fn config_size(c)
  len(keys(c))

fn main()
  let c = config_new()
  config_set(c, "host", "localhost")
  config_set(c, "port", 8080)
  config_set(c, "debug", 1)

  assert(config_get(c, "host", "") == "localhost", "get host")
  assert(config_get(c, "port", 0) == 8080, "get port")
  assert(config_get(c, "missing", "default") == "default", "get default")
  assert(config_has(c, "host") == 1, "has host")
  assert(config_has(c, "missing") == 0, "has missing")

  let overlay = config_new()
  config_set(overlay, "port", 3000)
  config_set(overlay, "workers", 4)

  let merged = config_merge(c, overlay)
  assert(config_get(merged, "host", "") == "localhost", "merge keeps base")
  assert(config_get(merged, "port", 0) == 3000, "merge overrides")
  assert(config_get(merged, "workers", 0) == 4, "merge adds new")

  set_env("APP_HOST", "0.0.0.0")
  set_env("APP_PORT", "9090")
  let env_cfg = config_from_env("APP", ["host", "port", "workers"])
  assert(config_get(env_cfg, "host", "") == "0.0.0.0", "env host")
  assert(config_get(env_cfg, "port", "") == "9090", "env port")
  assert(config_has(env_cfg, "workers") == 0, "env missing = not set")

  assert(config_size(c) == 3, "size 3")

  let logfmt = config_to_logfmt(c)
  assert(contains(logfmt, "host=localhost"), "logfmt has host")
  assert(contains(logfmt, "port=8080"), "logfmt has port")

  print("configx: all passed")
