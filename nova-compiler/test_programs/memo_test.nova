fn fib(n: int) -> int memo
    if n <= 1
        n
    else
        fib(n - 1) + fib(n - 2)

fn factorial(n: int) -> int memo
    if n <= 1
        1
    else
        n * factorial(n - 1)

fn add(a: int, b: int) -> int memo
    a + b

fn main()
    assert_eq(fib(0), 0)
    assert_eq(fib(1), 1)
    assert_eq(fib(10), 55)
    assert_eq(fib(30), 832040)
    assert_eq(fib(10), 55)

    assert_eq(factorial(0), 1)
    assert_eq(factorial(5), 120)
    assert_eq(factorial(10), 3628800)

    assert_eq(add(3, 4), 7)
    assert_eq(add(3, 4), 7)
    assert_eq(add(10, 20), 30)

    print("memo_test: all passed")
