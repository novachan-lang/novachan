fn fnv1a(text)
  let h = 2166136261
  let bytes = str_to_bytes(text)
  let i = 0
  while i < bytes_len(bytes)
    let b = bytes_get(bytes, i)
    h = h ^ b
    h = h * 16777619
    h = h & 4294967295
    i = i + 1
  h

fn djb2(text)
  let h = 5381
  let bytes = str_to_bytes(text)
  let i = 0
  while i < bytes_len(bytes)
    h = ((h << 5) + h) + bytes_get(bytes, i)
    h = h & 4294967295
    i = i + 1
  h

fn sdbm(text)
  let h = 0
  let bytes = str_to_bytes(text)
  let i = 0
  while i < bytes_len(bytes)
    let b = bytes_get(bytes, i)
    h = b + (h << 6) + (h << 16) - h
    h = h & 4294967295
    i = i + 1
  h

fn hash_combine(a, b)
  a ^ (b + 2654435769 + (a << 6) + (a >> 2))

fn hash_bucket(key, num_buckets)
  let h = fnv1a(key)
  h % num_buckets

fn main()
  let h1 = fnv1a("hello")
  let h2 = fnv1a("hello")
  assert(h1 == h2, "fnv1a deterministic")
  assert(fnv1a("hello") != fnv1a("world"), "fnv1a different inputs")
  assert(fnv1a("") != 0, "fnv1a empty is offset basis")

  let d1 = djb2("hello")
  let d2 = djb2("world")
  assert(d1 != d2, "djb2 different")
  assert(djb2("hello") == djb2("hello"), "djb2 deterministic")

  let s1 = sdbm("hello")
  assert(s1 != 0, "sdbm nonzero")
  assert(sdbm("abc") != sdbm("xyz"), "sdbm different")

  let c = hash_combine(12345, 67890)
  assert(c != 12345 and c != 67890, "combine mixes")

  let b1 = hash_bucket("user1", 10)
  assert(b1 >= 0 and b1 < 10, "bucket in range")
  let b2 = hash_bucket("user1", 10)
  assert(b1 == b2, "bucket deterministic")

  print("hashx: all passed")
