// KAT test for std/text/manacher
import std/text/manacher

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // ── mn_length KAT vectors ──────────────────────────────────────────────

    // "babad" -> "bab" or "aba", both length 3
    cki("mn_length_babad",         mn_length("babad"), 3)

    // "cbbd" -> "bb", length 2
    cki("mn_length_cbbd",          mn_length("cbbd"), 2)

    // "forgeeksskeegfor" -> "geeksskeeg", length 10
    cki("mn_length_forgeeksskeeg", mn_length("forgeeksskeegfor"), 10)

    // single char -> length 1
    cki("mn_length_single",        mn_length("a"), 1)

    // palindrome string -> full length
    cki("mn_length_racecar",       mn_length("racecar"), 7)

    // all same chars -> full string is the palindrome
    cki("mn_length_aaaa",          mn_length("aaaa"), 4)

    // two-char non-palindrome -> 1
    cki("mn_length_ab",            mn_length("ab"), 1)

    // two-char palindrome -> 2
    cki("mn_length_aa",            mn_length("aa"), 2)

    // ── mn_count KAT vectors ───────────────────────────────────────────────

    // "aaa": "a"x3 + "aa"x2 + "aaa"x1 = 6
    cki("mn_count_aaa",            mn_count("aaa"), 6)

    // single char -> 1
    cki("mn_count_single",         mn_count("a"), 1)

    // "ab" -> "a","b" = 2
    cki("mn_count_ab",             mn_count("ab"), 2)

    // "aab" -> "a","a","aa","b" = 4
    cki("mn_count_aab",            mn_count("aab"), 4)

    // "abba" -> "a","b","b","a","bb","abba" = 6
    cki("mn_count_abba",           mn_count("abba"), 6)

    // ── mn_is_palindrome KAT vectors ──────────────────────────────────────

    cki("mn_is_palindrome_racecar", mn_is_palindrome("racecar"), 1)
    cki("mn_is_palindrome_abc",     mn_is_palindrome("abc"), 0)
    cki("mn_is_palindrome_a",       mn_is_palindrome("a"), 1)
    cki("mn_is_palindrome_aa",      mn_is_palindrome("aa"), 1)
    cki("mn_is_palindrome_ab",      mn_is_palindrome("ab"), 0)
    cki("mn_is_palindrome_abacaba", mn_is_palindrome("abacaba"), 1)

    // ── mn_longest KAT vectors ────────────────────────────────────────────

    // "cbbd" -> "bb" (first longest)
    cks("mn_longest_cbbd",         mn_longest("cbbd"), "bb")

    // single char stays itself
    cks("mn_longest_single",       mn_longest("x"), "x")

    // "racecar" -> full string
    cks("mn_longest_racecar",      mn_longest("racecar"), "racecar")

    // "aaaa" -> full string
    cks("mn_longest_aaaa",         mn_longest("aaaa"), "aaaa")

    // "forgeeksskeegfor" -> "geeksskeeg"
    cks("mn_longest_forgeek",      mn_longest("forgeeksskeegfor"), "geeksskeeg")

    print("_manacher_test passed")
