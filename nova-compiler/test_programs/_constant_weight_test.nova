// KAT test for std/coding/constant_weight.
// Verifies code parameters, encode/decode round-trip, cw_next, cw_all, cw_first.
import std/coding/constant_weight

fn list_eq(a: list, b: list) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn assert_int(label: string, got: int, want: int)
    if got != want
        print("FAIL constant_weight " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn assert_bool(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL constant_weight " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // --- cw_count KAT ---
    assert_int("count_5_2", cw_count(5, 2), 10)
    assert_int("count_4_2", cw_count(4, 2), 6)
    assert_int("count_6_3", cw_count(6, 3), 20)
    assert_int("count_n_0", cw_count(5, 0), 1)
    assert_int("count_n_n", cw_count(3, 3), 1)

    // --- cw_weight KAT ---
    let w3 = []
    push(w3, 1)
    push(w3, 0)
    push(w3, 1)
    push(w3, 1)
    push(w3, 0)
    assert_int("weight_3", cw_weight(w3), 3)

    let w0 = []
    push(w0, 0)
    push(w0, 0)
    push(w0, 0)
    assert_int("weight_0", cw_weight(w0), 0)

    // --- cw_is_valid KAT ---
    let v2 = []
    push(v2, 1)
    push(v2, 1)
    push(v2, 0)
    push(v2, 0)
    assert_bool("isvalid_true", cw_is_valid(v2, 2), true)

    let v3 = []
    push(v3, 1)
    push(v3, 1)
    push(v3, 1)
    push(v3, 0)
    assert_bool("isvalid_false", cw_is_valid(v3, 2), false)

    // --- cw_first KAT ---
    let first42 = cw_first(4, 2)
    // [1,1,0,0] — m=2 ones then n-m=2 zeros
    let want_first = []
    push(want_first, 1)
    push(want_first, 1)
    push(want_first, 0)
    push(want_first, 0)
    if not list_eq(first42, want_first)
        print("FAIL cw_first(4,2): got=" + str(first42[0]) + str(first42[1]) + str(first42[2]) + str(first42[3]))
        exit(1)

    // --- cw_encode KAT ---
    // Index 0 for (4,2) should be [1,1,0,0]
    let enc0 = cw_encode(0, 4, 2)
    if not list_eq(enc0, want_first)
        print("FAIL cw_encode(0,4,2): wrong result")
        exit(1)

    // cw_encode(0,4,2) == cw_first(4,2)
    if not list_eq(enc0, first42)
        print("FAIL cw_encode(0,4,2) != cw_first(4,2)")
        exit(1)

    // --- ROUND-TRIP: cw_decode(cw_encode(i,5,2)) == i for all i in 0..9 ---
    let i = 0
    while i < 10
        let cw = cw_encode(i, 5, 2)
        let back = cw_decode(cw)
        if back != i
            print("FAIL roundtrip i=" + str(i) + " got=" + str(back))
            exit(1)
        i = i + 1

    // --- cw_all KAT ---
    let all42 = cw_all(4, 2)
    assert_int("all_4_2_len", len(all42), 6)

    // Verify no duplicates in cw_all(4,2) by checking all decoded ranks are distinct
    let seen = []
    let j = 0
    while j < 6
        push(seen, 0)
        j = j + 1
    j = 0
    while j < 6
        let rank = cw_decode(all42[j])
        if rank < 0 or rank >= 6
            print("FAIL all_4_2 rank out of range: " + str(rank))
            exit(1)
        if seen[rank] == 1
            print("FAIL all_4_2 duplicate rank: " + str(rank))
            exit(1)
        seen[rank] = 1
        j = j + 1

    // All entries have exactly 2 ones
    j = 0
    while j < 6
        if not cw_is_valid(all42[j], 2)
            print("FAIL all_4_2 invalid weight at index " + str(j))
            exit(1)
        j = j + 1

    // --- cw_next KAT ---
    // [1,1,0,0] -> [1,0,1,0]
    let cw110 = []
    push(cw110, 1)
    push(cw110, 1)
    push(cw110, 0)
    push(cw110, 0)
    let next1 = cw_next(cw110)
    let want_next1 = []
    push(want_next1, 1)
    push(want_next1, 0)
    push(want_next1, 1)
    push(want_next1, 0)
    if not list_eq(next1, want_next1)
        print("FAIL cw_next([1,1,0,0])")
        exit(1)

    // Last codeword [0,0,1,1] -> [] (empty)
    let last42 = []
    push(last42, 0)
    push(last42, 0)
    push(last42, 1)
    push(last42, 1)
    let next_last = cw_next(last42)
    if len(next_last) != 0
        print("FAIL cw_next last should return empty, got len=" + str(len(next_last)))
        exit(1)

    // cw_next advances through all 6 codewords of (4,2)
    let cw_cur = cw_first(4, 2)
    let cnt = 1
    let nxt = cw_next(cw_cur)
    while len(nxt) > 0
        cnt = cnt + 1
        cw_cur = nxt
        nxt = cw_next(cw_cur)
    if cnt != 6
        print("FAIL cw_next traversal: count=" + str(cnt) + " want=6")
        exit(1)

    // --- Zero message: codeword of all zeros has weight 0 ---
    let allzero = []
    push(allzero, 0)
    push(allzero, 0)
    push(allzero, 0)
    push(allzero, 0)
    assert_int("weight_allzero", cw_weight(allzero), 0)
    assert_bool("isvalid_allzero_m0", cw_is_valid(allzero, 0), true)
    assert_bool("isvalid_allzero_m1", cw_is_valid(allzero, 1), false)

    print("PASS _constant_weight_test")
