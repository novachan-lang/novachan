// KAT for std/semver/semver_parse — SemVer 2.0.0 parsing and validation.
// All expected values are hand-verified against the spec.
import std/semver/semver_parse

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _semver_parse_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _semver_parse_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _semver_parse_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label: string, got: list, want: list)
    cki(label + ".len", len(got), len(want))
    let i = 0
    while i < len(want)
        if str(got[i]) != str(want[i])
            print("FAIL _semver_parse_test " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // sv_parse('1.2.3') = [1,2,3,'','']
    let p1 = sv_parse("1.2.3")
    ckl("parse_1.2.3", p1, [1, 2, 3, "", ""])

    // sv_parse('1.2.3-alpha.1+build.5') = [1,2,3,'alpha.1','build.5']
    let p2 = sv_parse("1.2.3-alpha.1+build.5")
    ckl("parse_pre_build", p2, [1, 2, 3, "alpha.1", "build.5"])

    // sv_major('1.2.3') = 1
    cki("major_1.2.3", sv_major("1.2.3"), 1)

    // sv_minor('1.2.3') = 2
    cki("minor_1.2.3", sv_minor("1.2.3"), 2)

    // sv_patch('1.2.3') = 3
    cki("patch_1.2.3", sv_patch("1.2.3"), 3)

    // sv_prerelease('1.2.3-rc.1') = 'rc.1'
    cks("prerelease_rc.1", sv_prerelease("1.2.3-rc.1"), "rc.1")

    // sv_prerelease('1.2.3') = ''
    cks("prerelease_absent", sv_prerelease("1.2.3"), "")

    // sv_build('1.2.3+b') = 'b'
    cks("build_b", sv_build("1.2.3+b"), "b")

    // sv_build('1.2.3') = ''
    cks("build_absent", sv_build("1.2.3"), "")

    // sv_is_valid('1.0.0') = true
    ckb("valid_1.0.0", sv_is_valid("1.0.0"), true)

    // sv_is_valid('1.2') = false (missing patch)
    ckb("invalid_1.2", sv_is_valid("1.2"), false)

    // sv_is_valid('01.2.3') = false (leading zero on major)
    ckb("invalid_01.2.3", sv_is_valid("01.2.3"), false)

    // sv_is_valid('1.2.x') = false (non-numeric patch)
    ckb("invalid_1.2.x", sv_is_valid("1.2.x"), false)

    // Additional correctness checks
    // Parse with build only (no prerelease)
    let p3 = sv_parse("2.0.0+build.123")
    cki("build_only_major", p3[0], 2)
    cks("build_only_pre", str(p3[3]), "")
    cks("build_only_build", str(p3[4]), "build.123")

    // sv_is_valid with prerelease and build
    ckb("valid_pre_build", sv_is_valid("1.0.0-alpha.1+build.5"), true)

    // sv_is_valid leading zero on minor
    ckb("invalid_lead_zero_minor", sv_is_valid("1.01.3"), false)

    // sv_is_valid leading zero on patch
    ckb("invalid_lead_zero_patch", sv_is_valid("1.2.03"), false)

    // sv_is_valid: '0.0.0' is valid (all-zero is fine)
    ckb("valid_0.0.0", sv_is_valid("0.0.0"), true)

    // sv_is_valid: major alone is not valid
    ckb("invalid_major_only", sv_is_valid("1"), false)

    // sv_is_valid: empty prerelease identifier '1.0.0-' is invalid
    ckb("invalid_empty_pre", sv_is_valid("1.0.0-"), false)

    // Large version numbers
    let pL = sv_parse("100.200.300")
    cki("large_major", pL[0], 100)
    cki("large_minor", pL[1], 200)
    cki("large_patch", pL[2], 300)

    print("PASS _semver_parse_test")
