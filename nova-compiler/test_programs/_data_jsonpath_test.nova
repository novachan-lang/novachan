// KAT for std/data/jsonpath (jsonpath_query / jsonpath_first)
// Exercises: root/.key child, [n] index incl negative, [*]/.* wildcard,
// ..recursive descent, [start:end] slice, ["key"] double-quoted bracket key,
// non-existent path -> [], and binary/empty/type edge cases.
import std/data/jsonpath

fn same_list_of_int(got, want)
    let r = 1
    if len(got) != len(want)
        r = 0
    else
        let i = 0
        while i < len(want)
            if got[i] != want[i]
                r = 0
            i = i + 1
    return r

fn same_list_of_str(got, want)
    let r = 1
    if len(got) != len(want)
        r = 0
    else
        let i = 0
        while i < len(want)
            if got[i] != want[i]
                r = 0
            i = i + 1
    return r

fn main()
    let doc = "\{\"store\":\{\"book\":[\{\"title\":\"A\",\"price\":5\},\{\"title\":\"B\",\"price\":9\}],\"bicycle\":\{\"price\":20\}\}\}"
    let root = json_decode(doc)

    // KAT 1: $.store.book[0].title -> ["A"]
    let r1 = jsonpath_query(root, "$.store.book[0].title")
    if same_list_of_str(r1, ["A"]) == 0
        print("FAIL kat1 got_len="+str(len(r1)))
        exit(1)

    // KAT 2: $.store.book[*].price -> [5,9]
    let r2 = jsonpath_query(root, "$.store.book[*].price")
    if same_list_of_int(r2, [5, 9]) == 0
        print("FAIL kat2 got_len="+str(len(r2)))
        exit(1)

    // KAT 2b: .* wildcard form (bare dot-star) on book[0] -> 2 children (title,price)
    let r2b = jsonpath_query(root, "$.store.book[0].*")
    if len(r2b) != 2
        print("FAIL kat2b got_len="+str(len(r2b)))
        exit(1)

    // KAT 3: $..price -> [5,9,20] recursive descent, document order
    let r3 = jsonpath_query(root, "$..price")
    if same_list_of_int(r3, [5, 9, 20]) == 0
        print("FAIL kat3 got_len="+str(len(r3)))
        exit(1)

    // KAT 4: $.store.book[-1].title -> ["B"] negative index
    let r4 = jsonpath_query(root, "$.store.book[-1].title")
    if same_list_of_str(r4, ["B"]) == 0
        print("FAIL kat4 got_len="+str(len(r4)))
        exit(1)

    // KAT 5: $.store.book[0:1] slice -> [ {title:A,price:5} ] (one element)
    let r5 = jsonpath_query(root, "$.store.book[0:1]")
    if len(r5) != 1
        print("FAIL kat5 len got="+str(len(r5)))
        exit(1)
    let r5t = r5[0]["title"]
    if r5t != "A"
        print("FAIL kat5 title got="+str(r5t))
        exit(1)

    // KAT 5b: full-range slice [0:2] -> both books
    let r5b = jsonpath_query(root, "$.store.book[0:2]")
    if len(r5b) != 2
        print("FAIL kat5b len got="+str(len(r5b)))
        exit(1)

    // KAT 5c: open-ended slice [1:] -> just book B
    let r5c = jsonpath_query(root, "$.store.book[1:]")
    if len(r5c) != 1
        print("FAIL kat5c len got="+str(len(r5c)))
        exit(1)
    if r5c[0]["title"] != "B"
        print("FAIL kat5c title got="+str(r5c[0]["title"]))
        exit(1)

    // KAT 5d: open-start slice [:1] -> just book A
    let r5d = jsonpath_query(root, "$.store.book[:1]")
    if len(r5d) != 1
        print("FAIL kat5d len got="+str(len(r5d)))
        exit(1)
    if r5d[0]["title"] != "A"
        print("FAIL kat5d title got="+str(r5d[0]["title"]))
        exit(1)

    // KAT 5e: slice past bounds clamps, does not crash: [0:99] -> both books
    let r5e = jsonpath_query(root, "$.store.book[0:99]")
    if len(r5e) != 2
        print("FAIL kat5e len got="+str(len(r5e)))
        exit(1)

    // KAT 5f: negative-end slice [0:-1] -> just book A (all but last)
    let r5f = jsonpath_query(root, "$.store.book[0:-1]")
    if len(r5f) != 1
        print("FAIL kat5f len got="+str(len(r5f)))
        exit(1)
    if r5f[0]["title"] != "A"
        print("FAIL kat5f title got="+str(r5f[0]["title"]))
        exit(1)

    // KAT 6: non-existent path -> [] (no crash) -- missing key
    let r6 = jsonpath_query(root, "$.store.nope.zzz")
    if len(r6) != 0
        print("FAIL kat6 got_len="+str(len(r6)))
        exit(1)

    // KAT 6b: non-existent path -> [] -- out-of-range index
    let r6b = jsonpath_query(root, "$.store.book[99].title")
    if len(r6b) != 0
        print("FAIL kat6b got_len="+str(len(r6b)))
        exit(1)

    // KAT 6c: non-existent path -> [] -- indexing into a scalar
    let r6c = jsonpath_query(root, "$.store.bicycle.price.zzz")
    if len(r6c) != 0
        print("FAIL kat6c got_len="+str(len(r6c)))
        exit(1)

    // KAT 6d: empty path -> [] (no crash)
    let r6d = jsonpath_query(root, "")
    if len(r6d) != 0
        print("FAIL kat6d got_len="+str(len(r6d)))
        exit(1)

    // KAT 7: double-quoted bracket key ["store"]["bicycle"]["price"] -> [20]
    let r7 = jsonpath_query(root, "$[\"store\"][\"bicycle\"][\"price\"]")
    if same_list_of_int(r7, [20]) == 0
        print("FAIL kat7 got_len="+str(len(r7)))
        exit(1)

    // KAT 7b: single-quoted bracket key still works (regression) -- ['store']['book']
    let r7b = jsonpath_query(root, "$['store']['book'][0]['title']")
    if same_list_of_str(r7b, ["A"]) == 0
        print("FAIL kat7b got_len="+str(len(r7b)))
        exit(1)

    // KAT 8: jsonpath_first matches jsonpath_query[0] and returns null on miss
    let f1 = jsonpath_first(root, "$..price")
    if f1 != 5
        print("FAIL kat8 first got="+str(f1))
        exit(1)
    let f2 = jsonpath_first(root, "$.zzz.nope")
    if f2 != null
        print("FAIL kat8b first-miss got="+str(f2))
        exit(1)

    // KAT 9: empty list / empty dict inputs -- no crash
    let empty_list = []
    let r9 = jsonpath_query(empty_list, "$[0]")
    if len(r9) != 0
        print("FAIL kat9 empty-list got_len="+str(len(r9)))
        exit(1)
    let empty_dict = {}
    let r9b = jsonpath_query(empty_dict, "$.anything")
    if len(r9b) != 0
        print("FAIL kat9b empty-dict got_len="+str(len(r9b)))
        exit(1)

    // KAT 10: scalar root -- $ alone returns the scalar itself; deeper path -> []
    let r10 = jsonpath_query(42, "$")
    if same_list_of_int(r10, [42]) == 0
        print("FAIL kat10 got_len="+str(len(r10)))
        exit(1)
    let r10b = jsonpath_query(42, "$.x")
    if len(r10b) != 0
        print("FAIL kat10b got_len="+str(len(r10b)))
        exit(1)

    print("PASS jsonpath_query KAT")
    return 0
