import forge_state_snapshot

fn main()
    let s = ss_new()
    assert(ss_snapshot_count(s) == 0, "no snapshots")
    assert(ss_current_size(s) == 0, "empty state")

    s = ss_set(s, "users", "100")
    s = ss_set(s, "orders", "50")
    assert(ss_get(s, "users") == "100", "get users")
    assert(ss_current_size(s) == 2, "2 keys")

    s = ss_take_snapshot(s, "baseline")
    assert(ss_snapshot_count(s) == 1, "1 snapshot")
    assert(ss_snapshot_label(s, 0) == "baseline", "label = baseline")
    assert(ss_snapshot_value(s, 0, "users") == "100", "snap users 100")

    s = ss_set(s, "users", "200")
    s = ss_set(s, "products", "75")
    s = ss_take_snapshot(s, "after-growth")
    assert(ss_snapshot_count(s) == 2, "2 snapshots")
    assert(ss_snapshot_value(s, 1, "users") == "200", "snap1 users 200")
    assert(ss_snapshot_value(s, 0, "users") == "100", "snap0 still 100")
    assert(ss_snapshot_value(s, 1, "products") == "75", "snap1 products")

    assert(ss_snapshot_label(s, -1) == "", "neg index empty")
    assert(ss_snapshot_label(s, 99) == "", "out of range empty")
    assert(ss_get(s, "missing") == "", "missing key empty")
    assert(ss_snapshot_value(s, 0, "missing") == "", "missing snap key")

    // ---- everything below was added by the adversarial verification pass, 2026-08-05 ----
    // Up to here this KAT covered ONLY the pre-raise API. It passed with _ss_reserved() emptied out --
    // i.e. with the metadata-key filter completely removed and "label"/"key_count" leaking into
    // ss_snapshot_keys -- because it never called ss_snapshot_keys, ss_changed_keys, ss_diff or any
    // _checked form. Proven by negative control. The raise's whole surface was ungated.

    // The reserved-name filter. This is the assertion the mutation above must break.
    let ks0 = sort(ss_snapshot_keys(s, 0))
    assert(join(ks0, ",") == "orders,users", "snap0 keys are exactly the user keys")
    let ks1 = sort(ss_snapshot_keys(s, 1))
    assert(join(ks1, ",") == "orders,products,users", "snap1 keys are exactly the user keys")
    assert("label" not in ks1, "label must not leak into snapshot keys")
    assert("key_count" not in ks1, "key_count must not leak into snapshot keys")

    // key_count is real storage, read back as an INT (it is written as len(keys), not a string).
    assert(ss_snapshot_key_count(s, 0) == 2, "snap0 captured 2 keys")
    assert(ss_snapshot_key_count(s, 1) == 3, "snap1 captured 3 keys")
    assert(ss_snapshot_key_count(s, 1) + 1 == 4, "key_count arithmetic is integer, not string")

    // EMPTY vs MISSING must be distinguishable -- the sentinel collision the raise closed. An
    // empty container from the adapter must mean "none", and err must mean "no such snapshot".
    assert(is_ok(ss_snapshot_keys_checked(s, 0)), "existing snapshot -> ok")
    assert(is_err(ss_snapshot_keys_checked(s, 99)), "missing snapshot -> err")
    assert(is_err(ss_snapshot_keys_checked(s, -1)), "negative index -> err")
    assert(unwrap_err(ss_snapshot_keys_checked(s, 99)) == "no snapshot at index 99", "err names the index")
    assert(is_err(ss_changed_keys_checked(s, 99)), "changed_keys missing -> err")
    assert(is_err(ss_diff_checked(s, 99)), "diff missing -> err")
    assert(is_err(ss_snapshot_key_count_checked(s, 99)), "key_count missing -> err")
    assert(unwrap_err(ss_diff_checked(s, 99)) == "no snapshot at index 99", "diff err message")
    // a snapshot that captured ZERO keys is ok-with-empty, NOT err -- the two used to be the same []
    let z = ss_take_snapshot(ss_new(), "zero")
    assert(is_ok(ss_snapshot_keys_checked(z, 0)), "zero-key snapshot -> ok")
    assert(len(unwrap(ss_snapshot_keys_checked(z, 0))) == 0, "zero-key snapshot -> empty list")
    assert(is_err(ss_snapshot_keys_checked(z, 77)), "nonexistent snapshot -> err, not empty")
    assert(ss_snapshot_key_count(z, 0) == 0, "zero-key snapshot key_count 0")

    // checked forms of the pre-existing accessors distinguish bad index from bad key
    assert(unwrap_err(ss_snapshot_value_checked(s, 99, "users")) == "no snapshot at index 99", "value bad index")
    assert(unwrap_err(ss_snapshot_value_checked(s, 0, "missing")) == "no key 'missing'", "value bad key")
    assert(unwrap(ss_snapshot_label_checked(s, 0)) == "baseline", "label checked ok")
    assert(is_err(ss_snapshot_label_checked(s, 99)), "label checked bad index")
    // a value that is legitimately "" must be ok, not err
    let e = ss_take_snapshot(ss_set(ss_new(), "blank", ""), "")
    assert(is_ok(ss_snapshot_value_checked(e, 0, "blank")), "empty-string value is ok, not err")
    assert(is_ok(ss_snapshot_label_checked(e, 0)), "empty label is ok, not err")

    // DIFF DETECTION -- the feature the module was named for. Against snapshot 0
    // (users=100, orders=50) the live state is users=200, orders=50, products=75:
    // "users" is altered, "products" is added, nothing is removed.
    let ch = sort(ss_changed_keys(s, 0))
    assert(join(ch, ",") == "products,users", "changed vs snap0 = users(altered) + products(added)")
    assert(len(ss_changed_keys(s, 1)) == 0, "snap1 equals live -> nothing changed")
    let d = ss_diff(s, 0)
    assert(len(keys(d)) == 2, "diff has 2 entries")
    assert(d["users"][0] == "100" and d["users"][1] == "200", "diff pair is [snapshot, live]")
    assert(d["products"][0] == "" and d["products"][1] == "75", "added key has empty snapshot side")
    assert(len(keys(ss_diff(s, 1))) == 0, "diff vs snap1 is empty")
    // keys containing "_" must round-trip: the "<idx>_<key>" prefix is anchored, not a split
    let u = ss_take_snapshot(ss_set(ss_set(ss_new(), "a_b", "1"), "0_x", "2"), "under")
    assert(join(sort(ss_snapshot_keys(u, 0)), ",") == "0_x,a_b", "underscored keys round-trip")
    assert(ss_snapshot_value(u, 0, "a_b") == "1" and ss_snapshot_value(u, 0, "0_x") == "2", "underscored values")

    print("STATE-SNAPSHOT KAT PASS")
