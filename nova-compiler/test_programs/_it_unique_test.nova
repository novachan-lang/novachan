import std/itertools/it_unique

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckflat(label: string, got, want)
    let gn = len(got)
    let wn = len(want)
    if gn != wn
        print("FAIL " + label + "_len: got=" + str(gn) + " want=" + str(wn))
        exit(1)
    let i = 0
    while i < wn
        if got[i] != want[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // --- itu_unique ---
    // basic: [1,2,1,3,2] -> [1,2,3]
    let u1 = itu_unique([1, 2, 1, 3, 2])
    ckflat("unique_basic", u1, [1, 2, 3])
    // empty
    cki("unique_empty", len(itu_unique([])), 0)
    // already unique
    let u2 = itu_unique([10, 20, 30])
    ckflat("unique_already", u2, [10, 20, 30])
    // all same
    let u3 = itu_unique([5, 5, 5])
    ckflat("unique_allsame", u3, [5])
    // single
    let u4 = itu_unique([7])
    ckflat("unique_single", u4, [7])
    // order preserved: last occurrence is NOT kept, first is
    let u5 = itu_unique([3, 1, 2, 1, 3])
    ckflat("unique_order", u5, [3, 1, 2])

    // --- itu_count_distinct ---
    cki("cdist_basic", itu_count_distinct([1, 2, 1, 3, 2]), 3)
    cki("cdist_empty", itu_count_distinct([]), 0)
    cki("cdist_allsame", itu_count_distinct([9, 9, 9]), 1)
    cki("cdist_alldiff", itu_count_distinct([1, 2, 3, 4]), 4)
    cki("cdist_single", itu_count_distinct([42]), 1)

    // --- itu_duplicates ---
    // [1,2,1,3,2,2] -> [1,2]  (first extra occurrence order; each dup listed once)
    let dups1 = itu_duplicates([1, 2, 1, 3, 2, 2])
    ckflat("dups_basic", dups1, [1, 2])
    // no dups
    cki("dups_nodups", len(itu_duplicates([1, 2, 3])), 0)
    // empty
    cki("dups_empty", len(itu_duplicates([])), 0)
    // all same -> one entry for that value
    let dups2 = itu_duplicates([4, 4, 4])
    ckflat("dups_allsame", dups2, [4])
    // multiple dups, order by first re-occurrence
    let dups3 = itu_duplicates([1, 2, 3, 2, 1])
    ckflat("dups_order", dups3, [2, 1])

    // --- itu_is_unique ---
    cki("isuniq_yes", itu_is_unique([1, 2, 3]), 1)
    cki("isuniq_no", itu_is_unique([1, 1]), 0)
    cki("isuniq_empty", itu_is_unique([]), 1)
    cki("isuniq_single", itu_is_unique([99]), 1)
    cki("isuniq_first_dup", itu_is_unique([2, 2, 3, 4]), 0)
    cki("isuniq_last_dup", itu_is_unique([1, 2, 3, 3]), 0)

    // --- ROUND-TRIP: itu_unique(itu_unique(xs)) == itu_unique(xs) (idempotent) ---
    let xs = [3, 1, 2, 1, 3, 2]
    let u_once = itu_unique(xs)
    let u_twice = itu_unique(u_once)
    ckflat("unique_idempotent", u_twice, u_once)

    print("PASS _it_unique_test")
