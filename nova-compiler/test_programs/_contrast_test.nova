import std/color/contrast

// KAT check helpers

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ckb(label: str, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got " + str(gi) + " want " + str(wi))
        exit(1)

// ckf: check float within eps tolerance
fn ckf(label: str, got: float, want: float, eps: float)
    let diff = got - want
    let adiff = diff
    if diff < 0.0
        let neg = diff * -1.0
        adiff = neg
    if adiff > eps
        print("FAIL " + label + ": got " + str(got) + " want " + str(want) + " eps " + str(eps))
        exit(1)

fn main()
    // KAT 1: black vs white contrast = 21.0
    let ratio_bw = cst_ratio([0, 0, 0], [255, 255, 255])
    ckf("ratio_black_white", ratio_bw, 21.0, 0.1)

    // KAT 2: white vs white contrast = 1.0
    let ratio_ww = cst_ratio([255, 255, 255], [255, 255, 255])
    ckf("ratio_white_white", ratio_ww, 1.0, 0.05)

    // KAT 3: luminance of white = 1.0
    let lum_white = cst_luminance([255, 255, 255])
    ckf("luminance_white", lum_white, 1.0, 0.05)

    // KAT 4: luminance of black = 0.0
    let lum_black = cst_luminance([0, 0, 0])
    ckf("luminance_black", lum_black, 0.0, 0.05)

    // KAT 5: black vs white passes AA
    ckb("passes_aa_black_white", cst_passes_aa([0, 0, 0], [255, 255, 255]), true)

    // KAT 6: #777 vs white does NOT pass AA (ratio ~3.97 < 4.5)
    ckb("passes_aa_777_white", cst_passes_aa([119, 119, 119], [255, 255, 255]), false)

    // KAT 7: best text on white background = black [0,0,0]
    let best_on_white = cst_best_text([255, 255, 255])
    cki("best_text_white_r", best_on_white[0], 0)
    cki("best_text_white_g", best_on_white[1], 0)
    cki("best_text_white_b", best_on_white[2], 0)

    // KAT 8: best text on black background = white [255,255,255]
    let best_on_black = cst_best_text([0, 0, 0])
    cki("best_text_black_r", best_on_black[0], 255)
    cki("best_text_black_g", best_on_black[1], 255)
    cki("best_text_black_b", best_on_black[2], 255)

    // Extra: black vs white passes AAA (ratio 21 >= 7.0)
    ckb("passes_aaa_black_white", cst_passes_aaa([0, 0, 0], [255, 255, 255]), true)

    // Extra: #777 vs white does NOT pass AAA
    ckb("passes_aaa_777_white", cst_passes_aaa([119, 119, 119], [255, 255, 255]), false)

    print("_contrast_test passed")
