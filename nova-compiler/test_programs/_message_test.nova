// _message_test.nova — KAT for std/midi/message
//
// Known-answer tests for MIDI channel voice message encode/decode.
//
// HAND-VERIFIED VECTORS:
//
//   note_on(0, 60, 100):
//     status = (0x9 << 4) | 0 = 0x90 = 144
//     [144, 60, 100]
//
//   note_off(1, 60, 64):
//     status = (0x8 << 4) | 1 = 0x81 = 129
//     [129, 60, 64]
//
//   control_change(0, 7, 127):
//     status = (0xB << 4) | 0 = 0xB0 = 176
//     [176, 7, 127]
//
//   program_change(2, 40):
//     status = (0xC << 4) | 2 = 0xC2 = 194
//     [194, 40]
//
//   pitch_bend(0, 8192) — center:
//     lsb7 = 8192 & 0x7F = 0
//     msb7 = (8192 >> 7) & 0x7F = 64
//     status = (0xE << 4) | 0 = 0xE0 = 224
//     [224, 0, 64]
//
//   pitch_bend(0, 0) — minimum:
//     lsb7 = 0, msb7 = 0
//     [224, 0, 0]
//
//   msg_decode([0x90, 60, 100]):
//     type="note_on", channel=0, note=60, velocity=100
//
// Round-trip: encode -> decode -> re-encode -> same bytes.

import std/midi/message

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label, got, want)
    if got != want
        print("FAIL message " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl3(label, lst, b0, b1, b2)
    if len(lst) != 3
        print("FAIL message " + label + " len: got=" + str(len(lst)) + " want=3")
        exit(1)
    if lst[0] != b0
        print("FAIL message " + label + "[0]: got=" + str(lst[0]) + " want=" + str(b0))
        exit(1)
    if lst[1] != b1
        print("FAIL message " + label + "[1]: got=" + str(lst[1]) + " want=" + str(b1))
        exit(1)
    if lst[2] != b2
        print("FAIL message " + label + "[2]: got=" + str(lst[2]) + " want=" + str(b2))
        exit(1)

fn ckl2(label, lst, b0, b1)
    if len(lst) != 2
        print("FAIL message " + label + " len: got=" + str(len(lst)) + " want=2")
        exit(1)
    if lst[0] != b0
        print("FAIL message " + label + "[0]: got=" + str(lst[0]) + " want=" + str(b0))
        exit(1)
    if lst[1] != b1
        print("FAIL message " + label + "[1]: got=" + str(lst[1]) + " want=" + str(b1))
        exit(1)

fn main()
    // ── KAT 1: note_on(0, 60, 100) = [0x90, 60, 100] ────────────────────────
    let n1 = note_on(0, 60, 100)
    ckl3("note_on basic", n1, 144, 60, 100)

    // ── KAT 2: note_off(1, 60, 64) = [0x81, 60, 64] ─────────────────────────
    let n2 = note_off(1, 60, 64)
    ckl3("note_off ch1", n2, 129, 60, 64)

    // ── KAT 3: control_change(0, 7, 127) = [0xB0, 7, 127] ───────────────────
    let n3 = control_change(0, 7, 127)
    ckl3("cc volume", n3, 176, 7, 127)

    // ── KAT 4: program_change(2, 40) = [0xC2, 40] ───────────────────────────
    let n4 = program_change(2, 40)
    ckl2("prog_change ch2", n4, 194, 40)

    // ── KAT 5: pitch_bend(0, 8192) = [0xE0, 0x00, 0x40] ─────────────────────
    let n5 = pitch_bend(0, 8192)
    ckl3("pitch_bend center", n5, 224, 0, 64)

    // ── KAT 6: pitch_bend(0, 0) = [0xE0, 0, 0] ──────────────────────────────
    let n6 = pitch_bend(0, 0)
    ckl3("pitch_bend min", n6, 224, 0, 0)

    // ── KAT 7: pitch_bend(0, 16383) = [0xE0, 127, 127] ──────────────────────
    // 16383 & 0x7F = 127; (16383 >> 7) & 0x7F = 127
    let n7 = pitch_bend(0, 16383)
    ckl3("pitch_bend max", n7, 224, 127, 127)

    // ── KAT 8: poly_aftertouch(3, 48, 64) = [0xA3, 48, 64] ──────────────────
    let n8 = poly_aftertouch(3, 48, 64)
    ckl3("poly_at ch3", n8, 163, 48, 64)

    // ── KAT 9: channel_aftertouch(5, 100) = [0xD5, 100] ─────────────────────
    let n9 = channel_aftertouch(5, 100)
    ckl2("chan_at ch5", n9, 213, 100)

    // ── KAT 10: msg_decode([0x90, 60, 100]) ──────────────────────────────────
    let dec_bytes = [144, 60, 100]
    let d = msg_decode(dec_bytes)
    cki("decode note_on type", d["type"], "note_on")
    cki("decode note_on channel", d["channel"], 0)
    cki("decode note_on note", d["note"], 60)
    cki("decode note_on velocity", d["velocity"], 100)

    // ── KAT 11: msg_decode round-trip note_off ────────────────────────────────
    let enc_off = note_off(1, 60, 64)
    let d_off = msg_decode(enc_off)
    cki("rt note_off type", d_off["type"], "note_off")
    cki("rt note_off channel", d_off["channel"], 1)
    cki("rt note_off note", d_off["note"], 60)
    cki("rt note_off velocity", d_off["velocity"], 64)

    // ── KAT 12: msg_decode round-trip control_change ──────────────────────────
    let enc_cc = control_change(0, 7, 127)
    let d_cc = msg_decode(enc_cc)
    cki("rt cc type", d_cc["type"], "control_change")
    cki("rt cc channel", d_cc["channel"], 0)
    cki("rt cc controller", d_cc["controller"], 7)
    cki("rt cc value", d_cc["value"], 127)

    // ── KAT 13: msg_decode round-trip program_change ──────────────────────────
    let enc_pc = program_change(2, 40)
    let d_pc = msg_decode(enc_pc)
    cki("rt pc type", d_pc["type"], "program_change")
    cki("rt pc channel", d_pc["channel"], 2)
    cki("rt pc program", d_pc["program"], 40)

    // ── KAT 14: msg_decode round-trip pitch_bend center ───────────────────────
    let enc_pb = pitch_bend(0, 8192)
    let d_pb = msg_decode(enc_pb)
    cki("rt pb type", d_pb["type"], "pitch_bend")
    cki("rt pb channel", d_pb["channel"], 0)
    cki("rt pb value", d_pb["value"], 8192)

    // ── KAT 15: msg_decode round-trip pitch_bend max ──────────────────────────
    let enc_pbm = pitch_bend(15, 16383)
    let d_pbm = msg_decode(enc_pbm)
    cki("rt pb_max type", d_pbm["type"], "pitch_bend")
    cki("rt pb_max channel", d_pbm["channel"], 15)
    cki("rt pb_max value", d_pbm["value"], 16383)

    // ── KAT 16: msg_decode round-trip poly_aftertouch ─────────────────────────
    let enc_pat = poly_aftertouch(3, 48, 64)
    let d_pat = msg_decode(enc_pat)
    cki("rt poly_at type", d_pat["type"], "poly_aftertouch")
    cki("rt poly_at channel", d_pat["channel"], 3)
    cki("rt poly_at note", d_pat["note"], 48)
    cki("rt poly_at pressure", d_pat["pressure"], 64)

    // ── KAT 17: msg_decode round-trip channel_aftertouch ─────────────────────
    let enc_cat = channel_aftertouch(5, 100)
    let d_cat = msg_decode(enc_cat)
    cki("rt chan_at type", d_cat["type"], "channel_aftertouch")
    cki("rt chan_at channel", d_cat["channel"], 5)
    cki("rt chan_at pressure", d_cat["pressure"], 100)

    // ── KAT 18: data byte clamping (safety bounds) ────────────────────────────
    // note value 200 must clamp to 127
    let clamped = note_on(0, 200, 128)
    cki("clamp note >127", clamped[1], 127)
    cki("clamp vel >127", clamped[2], 127)

    // ── KAT 19: channel clamping ──────────────────────────────────────────────
    // channel 20 must clamp to 15 (status & 0xF = 15)
    let cc20 = note_on(20, 60, 64)
    // status = (9<<4)|15 = 144|15 = 159
    cki("clamp ch >15 status", cc20[0], 159)

    // ── KAT 20: malformed input (empty list) ──────────────────────────────────
    let bad = []
    let d_bad = msg_decode(bad)
    cki("decode empty type", d_bad["type"], "unknown")

    // ── KAT 21: malformed input (data byte as first byte) ────────────────────
    let bad2 = [60, 0, 0]
    let d_bad2 = msg_decode(bad2)
    cki("decode no-status-bit type", d_bad2["type"], "unknown")

    print("PASS _message_test")
