// KAT for std/crypto/commitment — round-trip + property tests for hash-based commitments.
import std/crypto/commitment

fn check_b(label: string, got: bool, want: bool)
    if got != want
        print("FAIL commitment " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn check_i(label: string, got: int, want: int)
    if got != want
        print("FAIL commitment " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn check_s(label: string, got: string, want: string)
    if got != want
        print("FAIL commitment " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // --- BINDING: commit_open(commit(v,n), v, n) == true ---
    let c1 = commit("vote-yes", "nonce123")
    check_b("binding-correct", commit_open(c1, "vote-yes", "nonce123"), true)

    // --- BINDING: different value with same nonce == false ---
    check_b("binding-wrong-value", commit_open(c1, "vote-no", "nonce123"), false)

    // --- HIDING: same value, wrong nonce == false ---
    check_b("binding-wrong-nonce", commit_open(c1, "vote-yes", "wrongnonce"), false)

    // --- commit_str: 16 hex chars ---
    let cs = commit_str("vote-yes", "nonce123")
    check_i("commit_str-len", len(cs), 16)

    // --- commit_str determinism ---
    let cs2 = commit_str("vote-yes", "nonce123")
    check_s("commit_str-determinism", cs, cs2)

    // --- commit_str changes with different value ---
    let cs3 = commit_str("vote-no", "nonce123")
    if cs == cs3
        print("FAIL commitment commit_str-binding: same hex for different values")
        exit(1)

    // --- commit_int round-trip ---
    let ci = commit_int(42, "nonce42")
    let ci2 = commit_int(42, "nonce42")
    check_i("commit_int-determinism", ci, ci2)
    let ci3 = commit_int(43, "nonce42")
    if ci == ci3
        print("FAIL commitment commit_int-binding: same hash for 42 vs 43")
        exit(1)

    // --- commit_bytes round-trip ---
    let bts = [1, 2, 3, 4, 5]
    let cb1 = commit_bytes(bts, "nonce-b")
    let cb2 = commit_bytes(bts, "nonce-b")
    check_i("commit_bytes-determinism", cb1, cb2)
    let bts2 = [1, 2, 3, 4, 6]
    let cb3 = commit_bytes(bts2, "nonce-b")
    if cb1 == cb3
        print("FAIL commitment commit_bytes-binding: same hash for different bytes")
        exit(1)

    // --- gen_nonce_from_seed: deterministic ---
    let n1 = gen_nonce_from_seed(42)
    let n2 = gen_nonce_from_seed(42)
    check_i("gen_nonce_from_seed-determinism", n1, n2)
    // different seeds -> different nonces
    let n3 = gen_nonce_from_seed(43)
    if n1 == n3
        print("FAIL commitment gen_nonce_from_seed: seed 42 and 43 collide")
        exit(1)

    // --- batch_commit / batch_verify round-trip ---
    let vals = []
    push(vals, "alpha")
    push(vals, "beta")
    push(vals, "gamma")
    let nonces = []
    push(nonces, "n1")
    push(nonces, "n2")
    push(nonces, "n3")
    let batch = batch_commit(vals, nonces)
    check_b("batch_verify-correct", batch_verify(batch, vals, nonces), true)

    // tamper one value -> batch_verify must return false
    let vals2 = []
    push(vals2, "alpha")
    push(vals2, "TAMPERED")
    push(vals2, "gamma")
    check_b("batch_verify-tampered", batch_verify(batch, vals2, nonces), false)

    // --- commit_chain round-trip ---
    let chain_vals = []
    push(chain_vals, "block0")
    push(chain_vals, "block1")
    push(chain_vals, "block2")
    let final_hash = commit_chain(chain_vals)
    check_b("commit_chain_verify-correct", commit_chain_verify(chain_vals, final_hash), true)

    // tamper middle element -> chain must differ
    let chain_vals2 = []
    push(chain_vals2, "block0")
    push(chain_vals2, "TAMPERED")
    push(chain_vals2, "block2")
    check_b("commit_chain_verify-tampered", commit_chain_verify(chain_vals2, final_hash), false)

    // chain is deterministic
    let final_hash2 = commit_chain(chain_vals)
    check_i("commit_chain-determinism", final_hash, final_hash2)

    // --- commit_equal ---
    let ca = commit("same", "nn")
    let cb = commit("same", "nn")
    let cc = commit("diff", "nn")
    check_b("commit_equal-same", commit_equal(ca, cb), true)
    check_b("commit_equal-diff", commit_equal(ca, cc), false)

    // --- empty chain ---
    let empty_chain = []
    let ef = commit_chain(empty_chain)
    check_b("commit_chain_verify-empty", commit_chain_verify(empty_chain, ef), true)

    // --- single-element chain ---
    let one_chain = []
    push(one_chain, "only")
    let of = commit_chain(one_chain)
    check_b("commit_chain_verify-single", commit_chain_verify(one_chain, of), true)

    // --- commit is not trivially equal across nonces ---
    let ca2 = commit("value", "nonceA")
    let cb2 = commit("value", "nonceB")
    if ca2 == cb2
        print("FAIL commitment nonce-independence: different nonces give same commit")
        exit(1)

    print("PASS _commitment_test")
