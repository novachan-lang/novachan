fn apply(f, x)
    f(x)

fn double(n)
    n * 2

fn square(n)
    n * n

print(apply(double, 5))
print(apply(square, 4))
print(apply(double, 0))

fn map_first(f, a, b)
    (f(a), f(b))

(p, q) = map_first(double, 3, 7)
print(p)
print(q)

fn compose(f, g, x)
    f(g(x))

print(compose(double, square, 3))
print(compose(square, double, 3))

add3 = x => x + 3
print(apply(add3, 10))

multiplier = 5
times5 = x => x * multiplier
print(apply(times5, 7))

fn make_adder(n)
    x => x + n

add10 = make_adder(10)
print(add10(3))
print(apply(add10, 20))
