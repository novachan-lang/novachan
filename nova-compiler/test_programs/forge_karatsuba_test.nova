import forge_karatsuba as kt
import forge_bignum as bn

fn check(cond: bool, label: str)
    if cond == false
        print("FAIL: " + label)

// TEST 1: small products verifiable against native i64
check(kt.kmul("0", "12345") == "0", "0 * x = 0")
check(kt.kmul("12345", "0") == "0", "x * 0 = 0")
check(kt.kmul("1", "999") == "999", "1 * 999 = 999")
check(kt.kmul("7", "8") == "56", "7 * 8 = 56")
check(kt.kmul("123", "456") == "56088", "123 * 456 = 56088")
check(kt.kmul("999", "999") == "998001", "999 * 999 = 998001")
check(kt.kmul("12345", "67890") == "838102050", "12345 * 67890 = 838102050")

// TEST 2: values that trigger the Karatsuba recursion (>8 digits)
// 123456789 * 987654321 = 121932631112635269
check(kt.kmul("123456789", "987654321") == "121932631112635269", "big product 1")

// 1000000000 * 1000000000 = 10^18
check(kt.kmul("1000000000", "1000000000") == "1000000000000000000", "10^9 * 10^9 = 10^18")

// TEST 3: DECISIVE cross-check against forge_bignum.big_mul (independent schoolbook) on many pairs
fn make_num(seed: int, digits: int) -> str
    let s = ""
    let sd = seed
    let i = 0
    while i < digits
        sd = (sd * 1103515245 + 12345) % 2147483648
        let d = sd % 10
        // avoid leading zero on first digit
        if i == 0 and d == 0
            d = 1
        s = s + chr(48 + d)
        i = i + 1
    return s

let ok = true
let seed = 42
let t = 0
while t < 60
    seed = (seed * 1103515245 + 12345) % 2147483648
    let da = seed % 25 + 1
    seed = (seed * 1103515245 + 12345) % 2147483648
    let db = seed % 25 + 1
    let a = make_num(seed + t, da)
    let b = make_num(seed + t * 7 + 3, db)
    let kres = kt.kmul(a, b)
    let bres = bn.big_mul(a, b)
    if kres != bres
        ok = false
        print("MISMATCH a=" + a + " b=" + b + " karatsuba=" + kres + " schoolbook=" + bres)
    t = t + 1
check(ok, "DECISIVE: Karatsuba matches forge_bignum.big_mul on 60 random big-number pairs")

// TEST 4: very long numbers (50+ digits each) - deep recursion
let long_a = "12345678901234567890123456789012345678901234567890"
let long_b = "98765432109876543210987654321098765432109876543210"
let long_k = kt.kmul(long_a, long_b)
let long_b_school = bn.big_mul(long_a, long_b)
check(long_k == long_b_school, "50-digit product matches schoolbook")

// TEST 5: asymmetric lengths (one long, one short)
let asym_k = kt.kmul("123456789012345678901234567890", "7")
let asym_s = bn.big_mul("123456789012345678901234567890", "7")
check(asym_k == asym_s, "asymmetric length product matches")

let asym2_k = kt.kmul("99", "123456789012345678901234567890")
let asym2_s = bn.big_mul("99", "123456789012345678901234567890")
check(asym2_k == asym2_s, "asymmetric length product 2 matches")

// TEST 6: powers of 2 (repeated squaring style)
let p = "2"
let i = 0
while i < 8
    let p_school = bn.big_mul(p, p)
    let p_kara = kt.kmul(p, p)
    if p_school != p_kara
        check(false, "power-of-2 squaring mismatch at i=" + str(i))
    p = p_kara
    i = i + 1
// 2^256 after 8 squarings of 2 -> 2, 4, 16, 256, ... 2^256
check(len(p) == 78, "2^256 has 78 decimal digits")

print("forge_karatsuba: KAT done")
