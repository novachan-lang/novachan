// KAT for std/grammar/grammar_cyk
// Hopcroft-Ullman CYK example: S->AB|BC, A->BA|a, B->CC|b, C->AB|a
import std/grammar/grammar_cyk

fn cki(label, got, want)
    if got != want
        print("FAIL _grammar_cyk_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL _grammar_cyk_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // Build the Hopcroft-Ullman CNF grammar:
    //   S -> A B | B C
    //   A -> B A | a
    //   B -> C C | b
    //   C -> A B | a
    let p1 = ["S", ["A", "B"]]
    let p2 = ["S", ["B", "C"]]
    let p3 = ["A", ["B", "A"]]
    let p4 = ["A", ["a"]]
    let p5 = ["B", ["C", "C"]]
    let p6 = ["B", ["b"]]
    let p7 = ["C", ["A", "B"]]
    let p8 = ["C", ["a"]]
    let prods = []
    push(prods, p1)
    push(prods, p2)
    push(prods, p3)
    push(prods, p4)
    push(prods, p5)
    push(prods, p6)
    push(prods, p7)
    push(prods, p8)

    // KAT 1: grcyk_is_cnf(prods) = true
    ckb("is_cnf_valid", grcyk_is_cnf(prods), 1)

    // KAT 2: non-CNF grammar (A -> a S b has RHS length 3) = false
    let bad1 = ["S", ["a", "S", "b"]]
    let bad_prods = []
    push(bad_prods, bad1)
    ckb("is_cnf_bad_len3", grcyk_is_cnf(bad_prods), 0)

    // KAT 3: non-CNF grammar (A -> B where B is a single nonterminal) = false
    let bad2 = ["S", ["A"]]
    let bad_prods2 = []
    push(bad_prods2, bad2)
    ckb("is_cnf_bad_unit", grcyk_is_cnf(bad_prods2), 0)

    // KAT 4: non-CNF — epsilon production (RHS length 0) = false
    let bad3 = ["S", []]
    let bad_prods3 = []
    push(bad_prods3, bad3)
    ckb("is_cnf_bad_eps", grcyk_is_cnf(bad_prods3), 0)

    // Build token lists for CYK recognition
    let tok_baaba = []
    push(tok_baaba, "b")
    push(tok_baaba, "a")
    push(tok_baaba, "a")
    push(tok_baaba, "b")
    push(tok_baaba, "a")

    let tok_ab = []
    push(tok_ab, "a")
    push(tok_ab, "b")

    let tok_a = []
    push(tok_a, "a")

    // KAT 5: grcyk_recognize(prods, "S", ["b","a","a","b","a"]) = true (baaba in language)
    ckb("recognize_baaba", grcyk_recognize(prods, "S", tok_baaba), 1)

    // KAT 6: grcyk_recognize(prods, "S", ["a","b"]) = true (ab derives S via S->AB, A->a, B->? wait: need B)
    // S->AB: A∈{A,C} from "a", B must be in "b" cell = {B}. A->BA needs B first. S->BC: B in "a"? No.
    // Actually "a" gives {A,C}, "b" gives {B}. S->AB: need A in left, B in right. A∈left, B∈right. YES.
    // Also C->AB: A∈left, B∈right. YES. So cell(0,1)={S,C}. S∈cell → true.
    ckb("recognize_ab", grcyk_recognize(prods, "S", tok_ab), 1)

    // KAT 7: grcyk_recognize(prods, "S", ["a"]) = false (single 'a' -> {A,C}, S not in it)
    ckb("recognize_single_a", grcyk_recognize(prods, "S", tok_a), 0)

    // KAT 8: grcyk_table returns correct length-1 entries
    let tbl = grcyk_table(prods, tok_baaba)
    // tbl[0][0] should contain "B" (token "b" derives B via B->b)
    let cell00 = tbl[0][0]
    let found_B = 0
    let ci = 0
    while ci < len(cell00)
        if cell00[ci] == "B"
            found_B = 1
        ci = ci + 1
    ckb("table_cell00_has_B", found_B, 1)

    // tbl[1][1] should contain "A" and "C" (token "a" derives A->a and C->a)
    let cell11 = tbl[1][1]
    let found_A = 0
    let found_C = 0
    let ci2 = 0
    while ci2 < len(cell11)
        if cell11[ci2] == "A"
            found_A = 1
        if cell11[ci2] == "C"
            found_C = 1
        ci2 = ci2 + 1
    ckb("table_cell11_has_A", found_A, 1)
    ckb("table_cell11_has_C", found_C, 1)

    // KAT 9: full-span cell tbl[0][4] should contain "S" for "baaba"
    let cell04 = tbl[0][4]
    let found_S = 0
    let ci3 = 0
    while ci3 < len(cell04)
        if cell04[ci3] == "S"
            found_S = 1
        ci3 = ci3 + 1
    ckb("table_cell04_has_S", found_S, 1)

    // KAT 10: grcyk_is_nonterminal tests
    ckb("is_nt_S", grcyk_is_nonterminal("S"), 1)
    ckb("is_nt_a", grcyk_is_nonterminal("a"), 0)
    ckb("is_nt_id", grcyk_is_nonterminal("id"), 0)
    ckb("is_nt_empty", grcyk_is_nonterminal(""), 0)

    // KAT 11: empty token list -> false (nothing to derive)
    let tok_empty = []
    ckb("recognize_empty", grcyk_recognize(prods, "S", tok_empty), 0)

    print("PASS _grammar_cyk_test")
