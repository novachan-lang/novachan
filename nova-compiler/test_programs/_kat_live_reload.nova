import forge_live_reload

fn main()
    let lr = lr_new()
    assert(lr_watch_count(lr) == 0, "no watches")
    assert(lr_change_count(lr) == 0, "no changes")

    lr = lr_watch(lr, "src/", "*.nova")
    lr = lr_watch(lr, "templates/", "*.html")
    assert(lr_watch_count(lr) == 2, "2 watches")

    lr = lr_record_change(lr, "src/main.nova", "modified", 100)
    lr = lr_record_change(lr, "src/util.nova", "created", 101)
    assert(lr_change_count(lr) == 2, "2 changes")
    assert(lr_pending_changes(lr) == 2, "2 pending")

    lr = lr_set_debounce(lr, 50)
    assert(lr_should_reload(lr, 0) == 0, "too soon (debounce)")
    assert(lr_should_reload(lr, 100) == 1, "ready to reload")

    lr = lr_trigger_reload(lr, 1000)
    assert(lr_reload_count(lr) == 1, "1 reload")
    assert(lr_pending_changes(lr) == 0, "0 pending after reload")

    lr = lr_record_change(lr, "src/api.nova", "modified", 2000)
    assert(lr_pending_changes(lr) == 1, "1 new pending")
    assert(lr_should_reload(lr, 1020) == 0, "debounce blocks")
    assert(lr_should_reload(lr, 2000) == 1, "ready again")

    lr = lr_trigger_reload(lr, 3000)
    assert(lr_reload_count(lr) == 2, "2 reloads")

    let recent = lr_recent_changes(lr, 1500)
    assert(len(recent) == 1, "1 recent change")
    assert(recent[0]["path"] == "src/api.nova", "correct path")

    let all = lr_recent_changes(lr, 0)
    assert(len(all) == 3, "all 3 changes")

    print("LIVE-RELOAD KAT PASS")
