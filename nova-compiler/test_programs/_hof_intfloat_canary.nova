// CVE ORACLE for deferred scalar monomorphization (S3). A HOF applied at BOTH int and float must keep
// both correct. Naive scalar type-flow corrupts one (the 1.97e-323 int-bits-as-double bug). Guards
// that scalar mono never silently sneaks in unsound.
fn apply(f, x)
    f(x)
fn dbl_int(n)
    n * 2
fn dbl_float(z)
    z * 2.0
fn main() -> int
    let a = apply(dbl_int, 21)
    let b = apply(dbl_float, 1.5)
    if a != 42
        print("FAIL int HOF: " + str(a))
        exit(1)
    assert_near(b, 3.0, 0.001)
    print("PASS hof_intfloat_canary")
    return 0
