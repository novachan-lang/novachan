fn streak_new()
  let s = {}
  s["current"] = 0
  s["best"] = 0
  s["total_wins"] = 0
  s["total_plays"] = 0
  s

fn streak_win(s)
  s["current"] = s["current"] + 1
  s["total_wins"] = s["total_wins"] + 1
  s["total_plays"] = s["total_plays"] + 1
  if s["current"] > s["best"]
    s["best"] = s["current"]

fn streak_lose(s)
  s["current"] = 0
  s["total_plays"] = s["total_plays"] + 1

fn streak_current(s)
  s["current"]

fn streak_best(s)
  s["best"]

fn streak_win_rate(s)
  if s["total_plays"] == 0
    return 0
  s["total_wins"] * 100 / s["total_plays"]

fn main()
  let s = streak_new()
  assert(streak_current(s) == 0, "initial 0")
  assert(streak_best(s) == 0, "best 0")

  streak_win(s)
  streak_win(s)
  streak_win(s)
  assert(streak_current(s) == 3, "3 wins")
  assert(streak_best(s) == 3, "best 3")

  streak_lose(s)
  assert(streak_current(s) == 0, "reset on lose")
  assert(streak_best(s) == 3, "best preserved")

  streak_win(s)
  streak_win(s)
  assert(streak_best(s) == 3, "best still 3")

  streak_win(s)
  streak_win(s)
  assert(streak_best(s) == 4, "new best 4")

  assert(streak_win_rate(s) == 87, "7/8 = 87%")

  print("streakx: all passed")
