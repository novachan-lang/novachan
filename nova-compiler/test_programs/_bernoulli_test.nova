// _bernoulli_test.nova — KAT for std/math/bernoulli
// Tests be_number(n) and be_is_zero(n) against published OEIS A027641/A027642 values.
import std/math/bernoulli

// cki — assert int equality
fn cki(label: string, got: int, expected: int)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// --- KAT: be_number(n) ---

// be_number(0) = [1, 1]
let b0 = be_number(0)
cki("b0 num", b0[0], 1)
cki("b0 den", b0[1], 1)

// be_number(1) = [-1, 2]
let b1 = be_number(1)
cki("b1 num", b1[0], -1)
cki("b1 den", b1[1], 2)

// be_number(2) = [1, 6]
let b2 = be_number(2)
cki("b2 num", b2[0], 1)
cki("b2 den", b2[1], 6)

// be_number(3) = [0, 1]  (odd n > 1 => zero)
let b3 = be_number(3)
cki("b3 num", b3[0], 0)
cki("b3 den", b3[1], 1)

// be_number(4) = [-1, 30]
let b4 = be_number(4)
cki("b4 num", b4[0], -1)
cki("b4 den", b4[1], 30)

// be_number(6) = [1, 42]
let b6 = be_number(6)
cki("b6 num", b6[0], 1)
cki("b6 den", b6[1], 42)

// be_number(8) = [-1, 30]
let b8 = be_number(8)
cki("b8 num", b8[0], -1)
cki("b8 den", b8[1], 30)

// be_number(10) = [5, 66]
let b10 = be_number(10)
cki("b10 num", b10[0], 5)
cki("b10 den", b10[1], 66)

// be_number(12) = [-691, 2730]
let b12 = be_number(12)
cki("b12 num", b12[0], -691)
cki("b12 den", b12[1], 2730)

// --- KAT: be_is_zero(n) ---

// be_is_zero(3) = true  (odd, n > 1)
let iz3 = be_is_zero(3)
cki("be_is_zero(3)", iz3, 1)

// be_is_zero(5) = true
let iz5 = be_is_zero(5)
cki("be_is_zero(5)", iz5, 1)

// be_is_zero(2) = false  (even, non-zero)
let iz2 = be_is_zero(2)
cki("be_is_zero(2)", iz2, 0)

// be_is_zero(0) = false  (B_0 = 1)
let iz0 = be_is_zero(0)
cki("be_is_zero(0)", iz0, 0)

// be_is_zero(1) = false  (B_1 = -1/2)
let iz1 = be_is_zero(1)
cki("be_is_zero(1)", iz1, 0)

// be_is_zero(7) = true  (odd, n > 1)
let iz7 = be_is_zero(7)
cki("be_is_zero(7)", iz7, 1)

print("_bernoulli_test passed")
