// S4.1 adversary follow-up guards (devils-advocate review of the taint):
//  A. index_set THROUGH an alias must be visible reading the source slot (the source-not-tainted
//     attack; refuted because default-taint-at-use taints the source on `let ys = xs`).
//  B. sort() RETURNS THE SAME handle -> `let ws = sort(zs)` aliases zs while zs would keep its
//     untainted fast typing; mutating ws then reading zs raw would corrupt. The fix taints any list
//     passed to sort/sort_by. Both cases must read correctly (generic path), not a heap pointer.

fn main()
    // A. alias + index_set heterogeneous write, read through the original name.
    let xs = [1, 2, 3]
    let ys = xs
    ys[0] = 3.14
    assert(xs[0] == 3.14, "alias index_set seen through xs")
    assert(xs[1] == 2, "alias: other ints intact")

    // B. sort() return-alias: ws and zs are the SAME object; a heterogeneous push via ws must be
    //    seen correctly through zs (zs must have been tainted by being passed to sort).
    let zs = [3, 1, 2]
    let ws = sort(zs)
    push(ws, 9.5)
    assert(zs[0] == 1, "sort-alias: sorted int head")
    assert(zs[3] == 9.5, "sort-alias: float seen through zs (not a heap pointer)")

    print("S4_ADV_INT2_OK")
