type Point
    x: int
    y: int

type Color
    r: int
    g: int
    b: int

fn main()
    let p = Point { x: 1, y: 2 }
    let p2 = Point { ...p, x: 10 }
    assert_eq(p2.x, 10)
    assert_eq(p2.y, 2)

    let p3 = Point { ...p, y: 99 }
    assert_eq(p3.x, 1)
    assert_eq(p3.y, 99)

    assert_eq(p.x, 1)
    assert_eq(p.y, 2)

    let red = Color { r: 255, g: 0, b: 0 }
    let pink = Color { ...red, g: 128, b: 128 }
    assert_eq(pink.r, 255)
    assert_eq(pink.g, 128)
    assert_eq(pink.b, 128)

    let c2 = Color { ...red }
    assert_eq(c2.r, 255)
    assert_eq(c2.g, 0)
    assert_eq(c2.b, 0)

    print("struct_spread_test: all passed")
