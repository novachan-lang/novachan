import sqlitex
fn main()
    let db = sqlitex.db_open(":memory:")
    sqlitex.db_exec(db, "CREATE TABLE t (x INTEGER)")
    sqlitex.db_query(db, "INSERT INTO t VALUES (?)", [42])
    let r = sqlitex.db_query(db, "SELECT x FROM t", [])
    print("nova-build sqlite auto-link: x = " + r[0][0])
    sqlitex.db_close(db)
