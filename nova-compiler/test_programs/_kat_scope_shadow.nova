// Module-scope leak regression: a fn's local `let` SHADOWS a top-level `let`
// VARIABLE of the same name (even a DIFFERENT type), not conflating types.
// (Reads of top-level vars are done at top level, not inside a fn, to avoid the
// separate module-level-storage limitation.)
let g = 5
let name = "top"
type Box
    n: int
let b = Box(7)
fn shadows() -> string
    let g = "hi"
    let name = 99
    return g + "/" + str(name)
fn uses_b(s: string) -> int
    let b = 100
    return b + len(s)
assert(shadows() == "hi/99", "local g/name shadow top-level, distinct types")
assert(uses_b("xy") == 102, "local b (int) shadows top-level b (Box)")
assert(g == 5, "top-level g intact")
assert(b.n == 7, "top-level b intact (read at top level)")
print("PASS _kat_scope_shadow")
