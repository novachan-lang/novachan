import std/scheduling/page_fifo

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL page_fifo " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT refs = [1,2,3,4,1,2,5,1,2,3,4,5]
    let refs = []
    push(refs, 1)
    push(refs, 2)
    push(refs, 3)
    push(refs, 4)
    push(refs, 1)
    push(refs, 2)
    push(refs, 5)
    push(refs, 1)
    push(refs, 2)
    push(refs, 3)
    push(refs, 4)
    push(refs, 5)

    // pf_faults(refs, 3) = 9
    let f3 = pf_faults(refs, 3)
    cki("faults_3frames", f3, 9)

    // pf_faults(refs, 4) = 10  — Belady's anomaly: MORE frames, MORE faults
    let f4 = pf_faults(refs, 4)
    cki("faults_4frames_belady", f4, 10)

    // pf_faults([1,2,3,4], 2) = 4
    let refs2 = []
    push(refs2, 1)
    push(refs2, 2)
    push(refs2, 3)
    push(refs2, 4)
    let f2 = pf_faults(refs2, 2)
    cki("faults_1234_2frames", f2, 4)

    // pf_hits(refs, 3) = 3
    let h3 = pf_hits(refs, 3)
    cki("hits_3frames", h3, 3)

    // edge: empty refs
    let empty = []
    cki("faults_empty", pf_faults(empty, 3), 0)
    cki("hits_empty", pf_hits(empty, 3), 0)

    print("PASS _page_fifo_test")
