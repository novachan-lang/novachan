// KAT for std/textlayout/textcolumns — multi-column text layout.
import std/textlayout/textcolumns

fn cks(label, got, want)
    if got != want
        print("FAIL textcolumns " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL textcolumns " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL textcolumns " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── tc_max_width ─────────────────────────────────────────────────────────
    // ['a','bbb','cc'] -> max len = 3 (from 'bbb')
    let items1 = ["a", "bbb", "cc"]
    cki("tc_max_width-3", tc_max_width(items1), 3)
    // empty list
    cki("tc_max_width-empty", tc_max_width([]), 0)
    // single item
    cki("tc_max_width-single", tc_max_width(["hello"]), 5)

    // ── tc_rows_needed ───────────────────────────────────────────────────────
    // ceil(5/2) = 3
    cki("tc_rows_needed-5-2", tc_rows_needed(5, 2), 3)
    cki("tc_rows_needed-4-2", tc_rows_needed(4, 2), 2)
    cki("tc_rows_needed-6-3", tc_rows_needed(6, 3), 2)
    cki("tc_rows_needed-1-1", tc_rows_needed(1, 1), 1)
    cki("tc_rows_needed-0-2", tc_rows_needed(0, 2), 0)

    // ── tc_columns ───────────────────────────────────────────────────────────
    // items=['a','bb','ccc','d'], ncols=2
    // max_width=3 (from 'ccc'), nrows=2
    // Row 0: ljust('a',3)+'  '+ljust('bb',3) = 'a    bb ' -> trailing space stripped
    // Row 1: ljust('ccc',3)+'  '+ljust('d',3) = 'ccc  d  ' -> trailing spaces stripped
    let items2 = ["a", "bb", "ccc", "d"]
    let want_cols = "a    bb" + chr(10) + "ccc  d"
    cks("tc_columns-2col", tc_columns(items2, 2), want_cols)

    // single column: trailing padding stripped from each line
    let want_1col = "a" + chr(10) + "bb" + chr(10) + "ccc" + chr(10) + "d"
    cks("tc_columns-1col", tc_columns(items2, 1), want_1col)

    // all items in one row (ncols >= nitems)
    // items=['a','bb','ccc','d'], ncols=4, max_width=3
    // Row 0: 'a  '+'  '+'bb '+'  '+'ccc'+'  '+'d  '
    let want_4col = "a    bb   ccc  d"
    cks("tc_columns-4col", tc_columns(items2, 4), want_4col)

    // empty items
    cks("tc_columns-empty", tc_columns([], 2), "")

    // ── tc_column_major ──────────────────────────────────────────────────────
    // items=['a','bb','ccc','d'], ncols=2, nrows=2, max_width=3
    // Column-major: col0=[items[0],items[2]], col1=[items[1],items[3]]
    //   i.e. col c, row r => index = c*nrows + r
    //   col0 row0 = idx 0 = 'a  ', col1 row0 = idx 2 = 'ccc'
    //   col0 row1 = idx 1 = 'bb ', col1 row1 = idx 3 = 'd  '
    // Row 0: 'a  '+'  '+'ccc' = 'a    ccc'
    // Row 1: 'bb '+'  '+'d  ' = 'bb   d  '
    let want_cm = "a    ccc" + chr(10) + "bb   d"
    cks("tc_column_major-2col", tc_column_major(items2, 2), want_cm)

    // ── tc_side_by_side ──────────────────────────────────────────────────────
    // left='a'+chr(10)+'b', right='x'+chr(10)+'y', gap=1
    // llines=['a','b'], rlines=['x','y'], lw=1
    // Row 0: ljust('a',1)+' '+'x' = 'a'+'  x' — NO: gap=1 → ' '
    // Row 0: 'a' + ' ' + 'x' = 'a x'
    // Row 1: 'b' + ' ' + 'y' = 'b y'
    let left1 = "a" + chr(10) + "b"
    let right1 = "x" + chr(10) + "y"
    let want_sbs = "a x" + chr(10) + "b y"
    cks("tc_side_by_side-gap1", tc_side_by_side(left1, right1, 1), want_sbs)

    // gap=2
    let want_sbs2 = "a  x" + chr(10) + "b  y"
    cks("tc_side_by_side-gap2", tc_side_by_side(left1, right1, 2), want_sbs2)

    // unequal line counts: left has 3 lines, right has 2
    // left = 'aa' + chr(10) + 'bbb' + chr(10) + 'c'
    // right = 'xx' + chr(10) + 'y'
    // lw = max(2,3,1) = 3
    // Row 0: ljust('aa',3) + ' ' + 'xx'  = 'aa ' + ' ' + 'xx' = 'aa  xx'
    // Row 1: ljust('bbb',3) + ' ' + 'y'  = 'bbb' + ' ' + 'y'  = 'bbb y'
    // Row 2: ljust('c',3) + ' ' + ''    = 'c  ' + ' ' + ''   = 'c   '
    let left2 = "aa" + chr(10) + "bbb" + chr(10) + "c"
    let right2 = "xx" + chr(10) + "y"
    let want_sbs3 = "aa  xx" + chr(10) + "bbb y" + chr(10) + "c   "
    cks("tc_side_by_side-unequal", tc_side_by_side(left2, right2, 1), want_sbs3)

    print("PASS _textcolumns_test")
