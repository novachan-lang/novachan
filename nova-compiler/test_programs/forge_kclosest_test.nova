import forge_kclosest

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn render(pts: list) -> string
    let out = ""
    let i = 0
    while i < len(pts)
        if i > 0
            out = out + " "
        out = out + str(pts[i][0]) + "," + str(pts[i][1])
        i = i + 1
    out

fn main()
    let fails = 0

    let p1 = []
    push(p1, [1, 3])
    push(p1, [0 - 2, 2])
    fails = fails + expect("k1", render(k_closest_points(p1, 1)), "-2,2")

    let p2 = []
    push(p2, [3, 3])
    push(p2, [5, 0 - 1])
    push(p2, [0 - 2, 4])
    // dist^2: 18, 26, 20 -> closest 2 = [3,3](18),[-2,4](20)
    fails = fails + expect("k2", render(k_closest_points(p2, 2)), "3,3 -2,4")

    // all in order
    fails = fails + expect("k_all", render(k_closest_points(p2, 5)), "3,3 -2,4 5,-1")

    // k larger than count
    fails = fails + expect("k_over", str(len(k_closest_points(p1, 10))), "2")

    // closest to a target point
    let p3 = []
    push(p3, [0, 0])
    push(p3, [10, 10])
    push(p3, [5, 5])
    push(p3, [6, 6])
    // closest to (5,5): [5,5](0), [6,6](2), then [0,0]/(10,10) both 50 (tie, original order 0,0 first)
    fails = fails + expect("to_target", render(k_closest_to(p3, 5, 5, 3)), "5,5 6,6 0,0")

    // increasing distance property (first is nearest)
    let p4 = []
    push(p4, [9, 9])
    push(p4, [1, 1])
    push(p4, [4, 4])
    push(p4, [2, 2])
    let r = k_closest_points(p4, 4)
    fails = fails + expect("nearest_first", str(r[0][0]) + "," + str(r[0][1]), "1,1")
    fails = fails + expect("farthest_last", str(r[3][0]) + "," + str(r[3][1]), "9,9")

    if fails == 0
        print("forge_kclosest: all passed")
    else
        print("forge_kclosest: " + str(fails) + " FAILED")
