import std/config/dotenv

// KAT for std/config/dotenv.nova
// All expected values are hand-computed from the spec rules.

fn cks(label, got, expected)
    if got == expected
        return
    print("FAIL " + label + ": got=" + got + " expected=" + expected)
    exit(1)

fn cki(label, got, expected)
    if got == expected
        return
    print("FAIL " + label + ": got=" + str(got) + " expected=" + str(expected))
    exit(1)

fn main()
    // Build test input via chr(10) newlines (no bare backslash-n in NOVA string literals).
    // Lines:
    //   A=1
    //   B=hello world
    //   # c=3        <- comment, must be ignored
    //   export C=3   <- leading "export " stripped -> key=C value=3
    //   D="quoted"   <- double-quoted value -> stripped to: quoted
    //   (blank line) <- ignored
    let nl = chr(10)
    let dq = chr(34)
    let t = "A=1" + nl + "B=hello world" + nl + "# c=3" + nl + "export C=3" + nl + "D=" + dq + "quoted" + dq + nl + "" + nl

    let parsed = dotenv.de_parse(t)

    // KAT 1: A=1 -> value "1"
    cks("A value", parsed["A"], "1")

    // KAT 2: B=hello world -> value keeps internal space
    cks("B value with space", parsed["B"], "hello world")

    // KAT 3: export C=3 -> key is "C" (export stripped), value "3"
    cks("C value from export", parsed["C"], "3")

    // KAT 4: D="quoted" -> outer double-quotes stripped -> "quoted"
    cks("D value double-quoted", parsed["D"], "quoted")

    // KAT 5: comment line "# c=3" must NOT insert key "c" (lowercase)
    let has_c = 0
    if contains(parsed, "c")
        has_c = 1
    cki("comment key c absent", has_c, 0)

    // KAT 6: de_get convenience wrapper returns value for known key
    cks("de_get A", dotenv.de_get(parsed, "A"), "1")

    // KAT 7: de_get returns "" for missing key (not crash)
    cks("de_get missing", dotenv.de_get(parsed, "NOTEXIST"), "")

    // KAT 8: blank lines do not insert keys (dict should have exactly 4 keys: A,B,C,D)
    let k = keys(parsed)
    cki("key count", len(k), 4)

    // KAT 9: single-quoted value stripped
    let sq = chr(39)
    let t2 = "E=" + sq + "single" + sq
    let p2 = dotenv.de_parse(t2)
    cks("E single-quoted", p2["E"], "single")

    // KAT 10: value with internal spaces and surrounding whitespace trimmed from value, not interior
    let t3 = "F=  hello world  "
    let p3 = dotenv.de_parse(t3)
    cks("F trim outer spaces only", p3["F"], "hello world")

    // KAT 11: key with surrounding whitespace trimmed
    let t4 = "  G  =7"
    let p4 = dotenv.de_parse(t4)
    cks("G key trimmed", p4["G"], "7")

    // KAT 12: line without '=' is silently skipped (no crash, no key added)
    let t5 = "NOEQUALSSIGN" + nl + "H=8"
    let p5 = dotenv.de_parse(t5)
    cks("H after no-equals line", p5["H"], "8")
    let has_noeq = 0
    if contains(p5, "NOEQUALSSIGN")
        has_noeq = 1
    cki("no-equals line skipped", has_noeq, 0)

    print("_dotenv_test passed")
