import std/greedy/min_platforms

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _min_platforms_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _min_platforms_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // KAT 1: 6 trains, expected 3 platforms
    let a1 = [900, 940, 950, 1100, 1500, 1800]
    let d1 = [910, 1200, 1120, 1130, 1900, 2000]
    cki("kat1_count",       mp_count(a1, d1),       3)
    cki("kat1_max_overlap", mp_max_overlap(a1, d1), 3)

    // KAT 2: 3 trains, no overlap, expected 1 platform
    let a2 = [900, 1100, 1235]
    let d2 = [1000, 1200, 1240]
    cki("kat2_count",       mp_count(a2, d2),       1)
    cki("kat2_max_overlap", mp_max_overlap(a2, d2), 1)

    // KAT 3: 6 trains, expected 2 platforms
    let a3 = [200, 210, 300, 320, 350, 500]
    let d3 = [230, 340, 320, 430, 400, 520]
    cki("kat3_count",       mp_count(a3, d3),       2)
    cki("kat3_max_overlap", mp_max_overlap(a3, d3), 2)

    // Edge: empty inputs
    let ae = []
    let de = []
    cki("empty_count", mp_count(ae, de), 0)

    // Edge: single train
    let as1 = [100]
    let ds1 = [200]
    cki("single_count", mp_count(as1, ds1), 1)

    // Edge: all trains overlap completely (3 trains, same window)
    let ac = [100, 100, 100]
    let dc = [200, 200, 200]
    cki("all_overlap", mp_count(ac, dc), 3)

    // Edge: trains touch exactly (arrival == departure of previous): can share (departure frees first)
    let at = [100, 110]
    let dt = [110, 200]
    cki("exact_touch", mp_count(at, dt), 1)

    print("PASS _min_platforms_test")
