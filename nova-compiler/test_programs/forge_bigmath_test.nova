import forge_bigmath
import forge_bignum

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // gcd
    fails = fails + expect("gcd_48_36", big_gcd("48", "36"), "12")
    fails = fails + expect("gcd_1071_462", big_gcd("1071", "462"), "21")
    fails = fails + expect("gcd_coprime", big_gcd("17", "5"), "1")
    fails = fails + expect("gcd_zero", big_gcd("42", "0"), "42")
    // gcd of a huge number: 2^100 is 2-divisible not 3 -> gcd(2^100, 6) = 2
    fails = fails + expect("gcd_big", big_gcd(big_pow("2", 100), "6"), "2")

    // lcm
    fails = fails + expect("lcm_4_6", big_lcm("4", "6"), "12")
    fails = fails + expect("lcm_21_6", big_lcm("21", "6"), "42")
    fails = fails + expect("lcm_zero", big_lcm("5", "0"), "0")

    // modular inverse -- known values
    fails = fails + expect("inv_3_11", big_modinv("3", "11"), "4")
    fails = fails + expect("inv_10_17", big_modinv("10", "17"), "12")
    fails = fails + expect("inv_7_26", big_modinv("7", "26"), "15")
    // no inverse when not coprime
    fails = fails + expect("inv_none", big_modinv("6", "9"), "0")

    // verify a * inv(a) mod m == 1 for several, including a large modulus
    let m = "1000000007"
    let a = "65537"
    let inv = big_modinv(a, m)
    fails = fails + expect("inv_verify_big", big_mod(big_mul(a, inv), m), "1")

    let inv2 = big_modinv("123456789", "998244353")
    fails = fails + expect("inv_verify_big2", big_mod(big_mul("123456789", inv2), "998244353"), "1")

    if fails == 0
        print("forge_bigmath: all passed")
    else
        print("forge_bigmath: " + str(fails) + " FAILED")
