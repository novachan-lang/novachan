import forge_transreduce

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn edges_str(ee) -> string
    let parts = []
    let i = 0
    while i < len(ee)
        push(parts, ee[i][0] + ">" + ee[i][1])
        i = i + 1
    join(parts, ",")

fn has_edge(ee, u, v) -> bool
    let f = false
    let i = 0
    while i < len(ee)
        if ee[i][0] == u and ee[i][1] == v
            f = true
        i = i + 1
    f

fn main()
    let fails = 0

    // a->b, b->c, a->c : the a->c edge is redundant -> keep a->b, b->c
    let redundant = [["a", "b"], ["b", "c"], ["a", "c"]]
    fails = fails + expect("triangle_count", str(reduction_edge_count(redundant)), "2")
    let r = transitive_reduction(redundant)
    fails = fails + expect_true("keeps_ab", has_edge(r, "a", "b"))
    fails = fails + expect_true("keeps_bc", has_edge(r, "b", "c"))
    fails = fails + expect_true("drops_ac", has_edge(r, "a", "c") == false)

    // chain a->b->c->d : no redundant edges, all 3 kept
    let chain = [["a", "b"], ["b", "c"], ["c", "d"]]
    fails = fails + expect("chain_count", str(reduction_edge_count(chain)), "3")

    // a->b, a->c, a->d, b->d, c->d : a->d redundant (a->b->d), keep 4
    let multi = [["a", "b"], ["a", "c"], ["a", "d"], ["b", "d"], ["c", "d"]]
    fails = fails + expect("multi_count", str(reduction_edge_count(multi)), "4")
    let rm = transitive_reduction(multi)
    fails = fails + expect_true("multi_drops_ad", has_edge(rm, "a", "d") == false)
    fails = fails + expect_true("multi_keeps_ab", has_edge(rm, "a", "b"))

    // diamond a->b, a->c, b->d, c->d : nothing redundant (a->d not direct), keep all 4
    let diamond = [["a", "b"], ["a", "c"], ["b", "d"], ["c", "d"]]
    fails = fails + expect("diamond_count", str(reduction_edge_count(diamond)), "4")

    // long redundancy: a->b->c->d + a->d (redundant) + a->c (redundant) -> keep only the chain (3)
    let longr = [["a", "b"], ["b", "c"], ["c", "d"], ["a", "d"], ["a", "c"]]
    fails = fails + expect("long_count", str(reduction_edge_count(longr)), "3")

    // no edges
    fails = fails + expect("empty", str(reduction_edge_count([])), "0")

    // single edge kept
    fails = fails + expect("single", str(reduction_edge_count([["x", "y"]])), "1")

    if fails == 0
        print("forge_transreduce: all passed")
    else
        print("forge_transreduce: " + str(fails) + " FAILED")
