import prism_ui_carousel
import prism_node

fn assert_eq(a, b, msg: string)
    if a != b
        print("FAIL " + msg + ": got '" + str(a) + "' expected '" + str(b) + "'")
    else
        print("  ok  " + msg)

fn main()
    print("== KAT prism_ui_carousel ==")
    let mut passed = 0
    let mut failed = 0

    let s1 = prism_ui_carousel.prism_csl_slide("Title1", "Content1", "img.png")
    if prism_ui_carousel.prism_csl_slide_title(s1) == "Title1"
        print("  ok  slide_title")
        passed += 1
    else
        print("FAIL slide_title")
        failed += 1

    if prism_ui_carousel.prism_csl_slide_content(s1) == "Content1"
        print("  ok  slide_content")
        passed += 1
    else
        print("FAIL slide_content")
        failed += 1

    if prism_ui_carousel.prism_csl_slide_image(s1) == "img.png"
        print("  ok  slide_image")
        passed += 1
    else
        print("FAIL slide_image")
        failed += 1

    if prism_ui_carousel.prism_csl_prev(0, 3) == 2
        print("  ok  prev_wrap_to_last")
        passed += 1
    else
        print("FAIL prev_wrap_to_last")
        failed += 1

    if prism_ui_carousel.prism_csl_prev(2, 3) == 1
        print("  ok  prev_normal")
        passed += 1
    else
        print("FAIL prev_normal")
        failed += 1

    if prism_ui_carousel.prism_csl_prev(1, 3) == 0
        print("  ok  prev_to_zero")
        passed += 1
    else
        print("FAIL prev_to_zero")
        failed += 1

    if prism_ui_carousel.prism_csl_next(2, 3) == 0
        print("  ok  next_wrap_to_first")
        passed += 1
    else
        print("FAIL next_wrap_to_first")
        failed += 1

    if prism_ui_carousel.prism_csl_next(0, 3) == 1
        print("  ok  next_normal")
        passed += 1
    else
        print("FAIL next_normal")
        failed += 1

    if prism_ui_carousel.prism_csl_next(1, 3) == 2
        print("  ok  next_middle")
        passed += 1
    else
        print("FAIL next_middle")
        failed += 1

    let s2 = prism_ui_carousel.prism_csl_slide("Title2", "Content2", "")
    let s3 = prism_ui_carousel.prism_csl_slide("Title3", "Content3", "img3.png")
    let slides = [s1, s2, s3]

    let r1 = prism_ui_carousel.prism_csl_carousel(slides, 0)
    if is_ok(r1)
        print("  ok  carousel_ok_idx0")
        passed += 1
        let node = unwrap(r1)
        if prism_node.prism_node_kind_str(node) == "stack"
            print("  ok  carousel_is_stack")
            passed += 1
        else
            print("FAIL carousel_is_stack: got " + prism_node.prism_node_kind_str(node))
            failed += 1
        let ch = prism_node.prism_node_children(node)
        if len(ch) == 2
            print("  ok  carousel_2_children")
            passed += 1
        else
            print("FAIL carousel_2_children: got " + str(len(ch)))
            failed += 1
    else
        print("FAIL carousel_ok_idx0: " + unwrap_err(r1))
        failed += 1
        failed += 2

    let r2 = prism_ui_carousel.prism_csl_carousel(slides, 1)
    if is_ok(r2)
        print("  ok  carousel_ok_idx1")
        passed += 1
    else
        print("FAIL carousel_ok_idx1: " + unwrap_err(r2))
        failed += 1

    let r3 = prism_ui_carousel.prism_csl_carousel(slides, 2)
    if is_ok(r3)
        print("  ok  carousel_ok_idx2")
        passed += 1
    else
        print("FAIL carousel_ok_idx2: " + unwrap_err(r3))
        failed += 1

    let r4 = prism_ui_carousel.prism_csl_carousel([], 0)
    if is_err(r4)
        print("  ok  carousel_err_empty")
        passed += 1
    else
        print("FAIL carousel_err_empty")
        failed += 1

    let r5 = prism_ui_carousel.prism_csl_carousel(slides, 5)
    if is_err(r5)
        print("  ok  carousel_err_oob")
        passed += 1
    else
        print("FAIL carousel_err_oob")
        failed += 1

    let r6 = prism_ui_carousel.prism_csl_carousel(slides, -1)
    if is_err(r6)
        print("  ok  carousel_err_neg_idx")
        passed += 1
    else
        print("FAIL carousel_err_neg_idx")
        failed += 1

    let r7 = prism_ui_carousel.prism_csl_carousel(["not_a_slide"], 0)
    if is_err(r7)
        print("  ok  carousel_err_wrong_type")
        passed += 1
    else
        print("FAIL carousel_err_wrong_type")
        failed += 1

    let r8 = prism_ui_carousel.prism_csl_filmstrip(slides, 1)
    if is_ok(r8)
        print("  ok  filmstrip_ok")
        passed += 1
        let fnode = unwrap(r8)
        if prism_node.prism_node_kind_str(fnode) == "band"
            print("  ok  filmstrip_is_band")
            passed += 1
        else
            print("FAIL filmstrip_is_band: got " + prism_node.prism_node_kind_str(fnode))
            failed += 1
        let fch = prism_node.prism_node_children(fnode)
        if len(fch) == 3
            print("  ok  filmstrip_3_children")
            passed += 1
        else
            print("FAIL filmstrip_3_children: got " + str(len(fch)))
            failed += 1
    else
        print("FAIL filmstrip_ok: " + unwrap_err(r8))
        failed += 1
        failed += 2

    let r9 = prism_ui_carousel.prism_csl_filmstrip([], 0)
    if is_err(r9)
        print("  ok  filmstrip_err_empty")
        passed += 1
    else
        print("FAIL filmstrip_err_empty")
        failed += 1

    let r10 = prism_ui_carousel.prism_csl_filmstrip(slides, 10)
    if is_err(r10)
        print("  ok  filmstrip_err_oob")
        passed += 1
    else
        print("FAIL filmstrip_err_oob")
        failed += 1

    let r11 = prism_ui_carousel.prism_csl_carousel(slides, 0)
    if is_ok(r11)
        let cnode = unwrap(r11)
        let cch = prism_node.prism_node_children(cnode)
        let indicator = cch[1]
        if prism_node.prism_node_attr_str(indicator, "text", "") == "1 / 3"
            print("  ok  indicator_text_1of3")
            passed += 1
        else
            print("FAIL indicator_text_1of3: got '" + prism_node.prism_node_attr_str(indicator, "text", "") + "'")
            failed += 1
    else
        print("FAIL indicator_text_1of3: carousel failed")
        failed += 1

    let r12 = prism_ui_carousel.prism_csl_carousel(slides, 2)
    if is_ok(r12)
        let cnode2 = unwrap(r12)
        let cch2 = prism_node.prism_node_children(cnode2)
        let indicator2 = cch2[1]
        if prism_node.prism_node_attr_str(indicator2, "text", "") == "3 / 3"
            print("  ok  indicator_text_3of3")
            passed += 1
        else
            print("FAIL indicator_text_3of3: got '" + prism_node.prism_node_attr_str(indicator2, "text", "") + "'")
            failed += 1
    else
        print("FAIL indicator_text_3of3: carousel failed")
        failed += 1

    let r13 = prism_ui_carousel.prism_csl_carousel([s2], 0)
    if is_ok(r13)
        print("  ok  carousel_no_image_slide")
        passed += 1
    else
        print("FAIL carousel_no_image_slide: " + unwrap_err(r13))
        failed += 1

    let mut cur = 0
    cur = prism_ui_carousel.prism_csl_next(cur, 3)
    cur = prism_ui_carousel.prism_csl_next(cur, 3)
    cur = prism_ui_carousel.prism_csl_next(cur, 3)
    if cur == 0
        print("  ok  roundtrip_next_3_wraps")
        passed += 1
    else
        print("FAIL roundtrip_next_3_wraps: got " + str(cur))
        failed += 1

    cur = 0
    cur = prism_ui_carousel.prism_csl_prev(cur, 3)
    cur = prism_ui_carousel.prism_csl_prev(cur, 3)
    cur = prism_ui_carousel.prism_csl_prev(cur, 3)
    if cur == 0
        print("  ok  roundtrip_prev_3_wraps")
        passed += 1
    else
        print("FAIL roundtrip_prev_3_wraps: got " + str(cur))
        failed += 1

    print("== " + str(passed) + " passed, " + str(failed) + " failed ==")
    if failed > 0
        exit(1)
