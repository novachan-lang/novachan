import std/typesystem/type_scheme

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _type_scheme_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _type_scheme_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL _type_scheme_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Helper: structural type equality (no alpha-equiv needed here since we control ids)
fn type_eq(a, b) -> int
    if a[0] != b[0]
        return 0
    let tag = a[0]
    if tag == "tvar"
        if a[1] == b[1]
            return 1
        return 0
    if tag == "arr"
        if type_eq(a[1], b[1]) == 0
            return 0
        return type_eq(a[2], b[2])
    if tag == "con"
        if a[1] != b[1]
            return 0
        let aa = a[2]
        let ba = b[2]
        if len(aa) != len(ba)
            return 0
        let i = 0
        while i < len(aa)
            if type_eq(aa[i], ba[i]) == 0
                return 0
            i = i + 1
        return 1
    0

// Helper: check scheme quantified vars list
fn scheme_qs_eq(sc, want_qs) -> int
    let qs = sc[1]
    if len(qs) != len(want_qs)
        return 0
    let i = 0
    while i < len(qs)
        if qs[i] != want_qs[i]
            return 0
        i = i + 1
    1

fn main()
    // --- tsch_mono ---
    // mono(tvar(5)) => forall [] tvar(5)
    let tv5 = tyc_tvar(5)
    let m5 = tsch_mono(tv5)
    cks("mono_tag", m5[0], "forall")
    cki("mono_qs_len", len(m5[1]), 0)
    cki("mono_body_is_tvar5", type_eq(m5[2], tv5), 1)

    // mono(arr(tvar(0), tvar(1))) => forall [] arr(tv0,tv1)
    let tv0 = tyc_tvar(0)
    let tv1 = tyc_tvar(1)
    let arr01 = tyc_arr(tv0, tv1)
    let marr = tsch_mono(arr01)
    cks("mono_arr_tag", marr[0], "forall")
    cki("mono_arr_qs_len", len(marr[1]), 0)
    cki("mono_arr_body", type_eq(marr[2], arr01), 1)

    // --- tsch_generalize ---
    // KAT: generalize([], arr(tv0, tv0)) quantifies [0]
    let t_aa = tyc_arr(tyc_tvar(0), tyc_tvar(0))
    let sc_aa = tsch_generalize([], t_aa)
    cks("gen_aa_tag", sc_aa[0], "forall")
    cki("gen_aa_qs_len", len(sc_aa[1]), 1)
    cki("gen_aa_qs_0", sc_aa[1][0], 0)
    cki("gen_aa_body", type_eq(sc_aa[2], t_aa), 1)

    // KAT: generalize(env=[["x", tvar(0)]], arr(tv0, tv1)) quantifies only [1]
    // env has tv0 free so tv0 should NOT be generalized
    let env1 = []
    let bind_x = []
    push(bind_x, "x")
    push(bind_x, tyc_tvar(0))
    push(env1, bind_x)
    let t_01 = tyc_arr(tyc_tvar(0), tyc_tvar(1))
    let sc_01 = tsch_generalize(env1, t_01)
    cks("gen_01_tag", sc_01[0], "forall")
    cki("gen_01_qs_len", len(sc_01[1]), 1)
    cki("gen_01_qs_0", sc_01[1][0], 1)

    // generalize([], con("int",[])) => no quantified vars (no tvars at all)
    let empty_args = []
    let t_int = tyc_con("int", empty_args)
    let sc_int = tsch_generalize([], t_int)
    cki("gen_int_qs_len", len(sc_int[1]), 0)
    cki("gen_int_body", type_eq(sc_int[2], t_int), 1)

    // generalize([], arr(tv0, con("bool",[]))) => quantifies [0]
    let empty_args2 = []
    let t_bool = tyc_con("bool", empty_args2)
    let t_a_bool = tyc_arr(tyc_tvar(0), t_bool)
    let sc_ab = tsch_generalize([], t_a_bool)
    cki("gen_abool_qs_len", len(sc_ab[1]), 1)
    cki("gen_abool_qs_0", sc_ab[1][0], 0)

    // --- tsch_ftv ---
    // ftv of forall [0]. arr(tv0, tv0) => [] (all bound)
    let ftv_aa = tsch_ftv(sc_aa)
    cki("ftv_aa_len", len(ftv_aa), 0)

    // ftv of mono(arr(tv0,tv1)) => [0, 1]
    let ftv_marr = tsch_ftv(marr)
    cki("ftv_marr_len", len(ftv_marr), 2)

    // ftv of forall [1]. arr(tv0,tv1) => [0] (only tv1 is bound, tv0 is free)
    let ftv_01 = tsch_ftv(sc_01)
    cki("ftv_01_len", len(ftv_01), 1)
    cki("ftv_01_0", ftv_01[0], 0)

    // --- tsch_instantiate ---
    // KAT: instantiate forall [0]. arr(tv0,tv0) with fresh ctr gives arr(tvN, tvN)
    // The two tvars in the result must be the SAME fresh id (alpha-equal to a->a).
    let ctr = [100]
    let inst = tsch_instantiate(sc_aa, ctr)
    // inst should be arr(tvar(100), tvar(100))
    cks("inst_aa_tag", inst[0], "arr")
    cks("inst_aa_left_tag", inst[1][0], "tvar")
    cks("inst_aa_right_tag", inst[2][0], "tvar")
    // Both sides must be the same fresh id
    cki("inst_aa_same_id", inst[1][1], inst[2][1])
    // ctr should have advanced by 1
    cki("inst_ctr_advanced", ctr[0], 101)

    // instantiate forall [0,1]. arr(tv0, arr(tv1, tv0)) with ctr=[0]
    // => arr(tvN, arr(tvM, tvN)) with N,M fresh and N != M
    let t_ktype = tyc_arr(tyc_tvar(0), tyc_arr(tyc_tvar(1), tyc_tvar(0)))
    let sc_k = tsch_generalize([], t_ktype)
    let ctr2 = [0]
    let inst_k = tsch_instantiate(sc_k, ctr2)
    cks("inst_k_tag", inst_k[0], "arr")
    // outer domain (tvN) must differ from inner domain (tvM)
    cki("inst_k_n_and_m_differ", inst_k[1][1] != inst_k[2][1][1], 1)
    // outer domain (tvN) must equal inner codomain (also tvN)
    cki("inst_k_first_eq_last", inst_k[1][1], inst_k[2][2][1])
    cki("inst_k_ctr", ctr2[0], 2)

    // instantiate a mono scheme does not change the type
    let ctr3 = [50]
    let inst_int = tsch_instantiate(sc_int, ctr3)
    cki("inst_mono_body", type_eq(inst_int, t_int), 1)
    cki("inst_mono_ctr_unchanged", ctr3[0], 50)

    print("PASS _type_scheme_test")

main()
