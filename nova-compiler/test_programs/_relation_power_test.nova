import std/relation/relation_power

fn cki(label, got, want)
    if got != want
        print("FAIL _relation_power_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label, got, want)
    if got != want
        print("FAIL _relation_power_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL _relation_power_test " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL _relation_power_test " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn ckm(label, A, B, n)
    let i = 0
    while i < n
        let j = 0
        while j < n
            if A[i][j] != B[i][j]
                print("FAIL _relation_power_test " + label + " at [" + str(i) + "][" + str(j) + "]: got=" + str(A[i][j]) + " want=" + str(B[i][j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // ==========================================================================
    // KAT 1: M = {(0,1),(1,2)} on n=3.
    // M[0][1]=1, M[1][2]=1, all others 0.
    // ==========================================================================
    let r0 = []
    push(r0, 0)
    push(r0, 1)
    push(r0, 0)
    let r1 = []
    push(r1, 0)
    push(r1, 0)
    push(r1, 1)
    let r2 = []
    push(r2, 0)
    push(r2, 0)
    push(r2, 0)
    let M = []
    push(M, r0)
    push(M, r1)
    push(M, r2)

    // M^2 = {(0,2)}: M^2[0][2]=1, all others 0
    let m2 = rpow_power(M, 3, 2)
    cki("power2_0_0", m2[0][0], 0)
    cki("power2_0_1", m2[0][1], 0)
    cki("power2_0_2", m2[0][2], 1)
    cki("power2_1_0", m2[1][0], 0)
    cki("power2_1_2", m2[1][2], 0)
    cki("power2_2_2", m2[2][2], 0)

    // M^3 = empty (no path of length 3 in a 3-node chain)
    let m3 = rpow_power(M, 3, 3)
    cki("power3_0_0", m3[0][0], 0)
    cki("power3_0_2", m3[0][2], 0)
    cki("power3_1_2", m3[1][2], 0)

    // M^0 = identity
    let m0 = rpow_power(M, 3, 0)
    cki("power0_0_0", m0[0][0], 1)
    cki("power0_1_1", m0[1][1], 1)
    cki("power0_2_2", m0[2][2], 1)
    cki("power0_0_1", m0[0][1], 0)
    cki("power0_0_2", m0[0][2], 0)

    // M^1 = M
    let m1 = rpow_power(M, 3, 1)
    cki("power1_0_1", m1[0][1], 1)
    cki("power1_1_2", m1[1][2], 1)
    cki("power1_0_0", m1[0][0], 0)
    cki("power1_0_2", m1[0][2], 0)

    // reachable(M,3,0) = [1,2]
    let reach0 = rpow_reachable(M, 3, 0)
    let want_r0 = []
    push(want_r0, 1)
    push(want_r0, 2)
    ckl("reachable_from_0", reach0, want_r0)

    // reachable(M,3,1) = [2]
    let reach1 = rpow_reachable(M, 3, 1)
    let want_r1 = []
    push(want_r1, 2)
    ckl("reachable_from_1", reach1, want_r1)

    // reachable(M,3,2) = [] (2 has no outgoing edges)
    let reach2 = rpow_reachable(M, 3, 2)
    let want_r2 = []
    ckl("reachable_from_2", reach2, want_r2)

    // is_reachable(M,3,0,2) = 1
    cki("is_reachable_0_2", rpow_is_reachable(M, 3, 0, 2), 1)

    // is_reachable(M,3,2,0) = 0
    cki("is_reachable_2_0", rpow_is_reachable(M, 3, 2, 0), 0)

    // is_reachable(M,3,0,0) = 0 (no self-loop and transitive closure is 1+ steps)
    cki("is_reachable_0_0", rpow_is_reachable(M, 3, 0, 0), 0)

    // ==========================================================================
    // KAT 2: Transitive reduction of {(0,1),(1,2),(0,2)} on n=3.
    // The transitive closure of M and of TR(M) must be the same.
    // (0,2) is redundant (path 0->1->2 exists), so TR = {(0,1),(1,2)}.
    // ==========================================================================
    let tr0 = []
    push(tr0, 0)
    push(tr0, 1)
    push(tr0, 1)
    let tr1 = []
    push(tr1, 0)
    push(tr1, 0)
    push(tr1, 1)
    let tr2 = []
    push(tr2, 0)
    push(tr2, 0)
    push(tr2, 0)
    let Mtr = []
    push(Mtr, tr0)
    push(Mtr, tr1)
    push(Mtr, tr2)

    let red = rpow_transitive_reduction(Mtr, 3)
    // Should be: (0,1) stays, (1,2) stays, (0,2) removed
    cki("tr_red_0_1", red[0][1], 1)
    cki("tr_red_1_2", red[1][2], 1)
    cki("tr_red_0_2", red[0][2], 0)
    cki("tr_red_0_0", red[0][0], 0)
    cki("tr_red_1_0", red[1][0], 0)

    // ==========================================================================
    // KAT 3: Compose test. A: 0->1, B: 1->2. B∘A: 0->2.
    // ==========================================================================
    let ca0 = []
    push(ca0, 0)
    push(ca0, 1)
    push(ca0, 0)
    let ca1 = []
    push(ca1, 0)
    push(ca1, 0)
    push(ca1, 0)
    let ca2 = []
    push(ca2, 0)
    push(ca2, 0)
    push(ca2, 0)
    let compA = []
    push(compA, ca0)
    push(compA, ca1)
    push(compA, ca2)

    let cb0 = []
    push(cb0, 0)
    push(cb0, 0)
    push(cb0, 0)
    let cb1 = []
    push(cb1, 0)
    push(cb1, 0)
    push(cb1, 1)
    let cb2 = []
    push(cb2, 0)
    push(cb2, 0)
    push(cb2, 0)
    let compB = []
    push(compB, cb0)
    push(compB, cb1)
    push(compB, cb2)

    let AB = rpow_compose(compA, compB, 3)
    cki("compose_0_2", AB[0][2], 1)
    cki("compose_0_0", AB[0][0], 0)
    cki("compose_0_1", AB[0][1], 0)
    cki("compose_1_2", AB[1][2], 0)

    // ==========================================================================
    // KAT 4: Cyclic relation n=3: 0->1->2->0. All nodes mutually reachable.
    // ==========================================================================
    let cy0 = []
    push(cy0, 0)
    push(cy0, 1)
    push(cy0, 0)
    let cy1 = []
    push(cy1, 0)
    push(cy1, 0)
    push(cy1, 1)
    let cy2 = []
    push(cy2, 1)
    push(cy2, 0)
    push(cy2, 0)
    let cyc = []
    push(cyc, cy0)
    push(cyc, cy1)
    push(cyc, cy2)

    cki("cyc_reach_0_1", rpow_is_reachable(cyc, 3, 0, 1), 1)
    cki("cyc_reach_0_2", rpow_is_reachable(cyc, 3, 0, 2), 1)
    cki("cyc_reach_0_0", rpow_is_reachable(cyc, 3, 0, 0), 1)
    cki("cyc_reach_2_1", rpow_is_reachable(cyc, 3, 2, 1), 1)

    let reach_c0 = rpow_reachable(cyc, 3, 0)
    let want_c0 = []
    push(want_c0, 0)
    push(want_c0, 1)
    push(want_c0, 2)
    ckl("cyc_reachable_from_0", reach_c0, want_c0)

    // ==========================================================================
    // KAT 5: n=0 edge cases
    // ==========================================================================
    let empty = []
    let e0 = rpow_power(empty, 0, 0)
    cki("n0_power0_len", len(e0), 0)
    let e1 = rpow_compose(empty, empty, 0)
    cki("n0_compose_len", len(e1), 0)

    // ==========================================================================
    // KAT 6: n=1 trivial (single element, no self-loop).
    // ==========================================================================
    let s0 = []
    push(s0, 0)
    let single = []
    push(single, s0)

    let sp0 = rpow_power(single, 1, 0)
    cki("n1_power0_0_0", sp0[0][0], 1)
    let sp1 = rpow_power(single, 1, 1)
    cki("n1_power1_0_0", sp1[0][0], 0)
    cki("n1_is_reachable_0_0", rpow_is_reachable(single, 1, 0, 0), 0)

    let reach_s0 = rpow_reachable(single, 1, 0)
    let want_s0 = []
    ckl("n1_reachable_from_0_empty", reach_s0, want_s0)

    // ==========================================================================
    // KAT 7: MULTI-HOP reachability with pivot-order sensitivity (Floyd-Warshall
    // regression). Edges 0->3, 3->1, 1->2 on n=4: node 0 reaches 1,2,3 — but the
    // path 0->3->1->2 is only found if the closure uses the evolving tc[k][j], not M.
    // ==========================================================================
    let mh = []
    let r0 = []
    push(r0, 0)
    push(r0, 0)
    push(r0, 0)
    push(r0, 1)
    push(mh, r0)
    let r1 = []
    push(r1, 0)
    push(r1, 0)
    push(r1, 1)
    push(r1, 0)
    push(mh, r1)
    let r2 = []
    push(r2, 0)
    push(r2, 0)
    push(r2, 0)
    push(r2, 0)
    push(mh, r2)
    let r3 = []
    push(r3, 0)
    push(r3, 1)
    push(r3, 0)
    push(r3, 0)
    push(mh, r3)
    let reach0 = rpow_reachable(mh, 4, 0)
    let want0 = []
    push(want0, 1)
    push(want0, 2)
    push(want0, 3)
    ckl("multihop_reachable_0", reach0, want0)
    cki("multihop_is_reachable_0_2", rpow_is_reachable(mh, 4, 0, 2), 1)
    cki("multihop_is_reachable_2_0", rpow_is_reachable(mh, 4, 2, 0), 0)

    print("PASS _relation_power_test")
