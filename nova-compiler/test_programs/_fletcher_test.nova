// _fletcher_test.nova — KAT for std/hash/fletcher
// Tests h_fletcher16 and h_fletcher32 against PUBLISHED vectors.
//
// Hand-trace for "abc" (Fletcher-16):
//   start: s1=0, s2=0
//   byte 97 ('a'): s1=(0+97)%255=97,   s2=(0+97)%255=97
//   byte 98 ('b'): s1=(97+98)%255=195, s2=(97+195)%255=37
//   byte 99 ('c'): s1=(195+99)%255=39, s2=(37+39)%255=76
//   result = (76<<8)|39 = 19495  (0x4C27)
//
// Hand-trace for "ab" (Fletcher-32):
//   one pair: b0=97, b1=98, word=97+98*256=25185
//   s1=(0+25185)%65535=25185, s2=(0+25185)%65535=25185
//   result = (25185<<16)|25185 = 1650549345  (0x62616261)

import std/hash/fletcher

// Helper: check int equals expected, print FAIL and exit(1) on mismatch.
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// Helper: check string equals expected.
fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + got + " expected " + expected)
        exit(1)

// ---------------------------------------------------------------------------
// Fletcher-16 KAT — PUBLISHED vectors
// ---------------------------------------------------------------------------

// Empty string must return 0 (both accumulators stay 0)
cki("f16_empty", h_fletcher16(""), 0)

// PUBLISHED: "abcde" => 0xC8F0 = 51440
cki("f16_abcde", h_fletcher16("abcde"), 51440)

// PUBLISHED: "abcdef" => 0x2057 = 8279
cki("f16_abcdef", h_fletcher16("abcdef"), 8279)

// PUBLISHED: "abcdefgh" => 0x0627 = 1575
cki("f16_abcdefgh", h_fletcher16("abcdefgh"), 1575)

// Hand-traced: "abc" => (76<<8)|39 = 19495  (0x4C27)
cki("f16_abc", h_fletcher16("abc"), 19495)

// Determinism: same string called twice must give the same result
cki("f16_determinism", h_fletcher16("nova"), h_fletcher16("nova"))

// Single character: 'A' (byte 65). s1=(0+65)%255=65, s2=(0+65)%255=65.
// result = (65<<8)|65 = 16705  (0x4141)
cki("f16_single_A", h_fletcher16("A"), 16705)

// ---------------------------------------------------------------------------
// Fletcher-32 KAT — hand-verified
// ---------------------------------------------------------------------------

// Empty string must return 0
cki("f32_empty", h_fletcher32(""), 0)

// Hand-traced: "ab" => 0x62616261 = 1650549345
cki("f32_ab", h_fletcher32("ab"), 1650549345)

// hand-verified (PowerShell reference): "abcde" => 4031760169 (0xF04FC729)
cki("f32_abcde", h_fletcher32("abcde"), 4031760169)

// hand-verified: "abcdef" => 1448095018 (0x56502D2A)
cki("f32_abcdef", h_fletcher32("abcdef"), 1448095018)

// hand-verified: "abcdefgh" => 3957429649 (0xEBE19591)
cki("f32_abcdefgh", h_fletcher32("abcdefgh"), 3957429649)

// Determinism: same string called twice must give the same result
cki("f32_determinism", h_fletcher32("nova"), h_fletcher32("nova"))

print("_fletcher_test passed")
