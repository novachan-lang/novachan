// KAT for std/text/spellcorrect
import std/text/spellcorrect

fn cki(label, got, want) -> int
    if got == want
        return 0
    print("FAIL spellcorrect " + label + ": got=" + str(got) + " want=" + str(want))
    exit(1)
    0

fn cks(label, got, want) -> int
    if got == want
        return 0
    print("FAIL spellcorrect " + label + ": got=" + got + " want=" + want)
    exit(1)
    0

fn main()
    // Build dict from a small, unambiguous corpus.
    let tokens = []
    push(tokens, "spelling")
    push(tokens, "spelling")
    push(tokens, "hello")
    push(tokens, "world")
    push(tokens, "the")
    push(tokens, "the")
    push(tokens, "the")
    let dict = sp_build_dict(tokens)

    // sp_is_correct: known word
    if sp_is_correct("hello", dict) != true
        print("FAIL spellcorrect is_correct_hello")
        exit(1)

    // sp_is_correct: unknown word
    if sp_is_correct("xyz123", dict) != false
        print("FAIL spellcorrect is_correct_unknown")
        exit(1)

    // sp_correct("the", dict) == "the" (already correct, highest freq)
    cks("correct_the", sp_correct("the", dict), "the")

    // sp_correct("speling", dict) == "spelling" (one delete: speling -> spelling)
    cks("correct_speling", sp_correct("speling", dict), "spelling")

    // sp_correct("helo", dict) == "hello" (one insert: helo -> hello)
    cks("correct_helo", sp_correct("helo", dict), "hello")

    // sp_edit_distance("abc", "abc") == 0
    cki("edit_dist_same", sp_edit_distance("abc", "abc"), 0)

    // sp_edit_distance("kitten", "sitting") == 3 (classic)
    cki("edit_dist_kitten_sitting", sp_edit_distance("kitten", "sitting"), 3)

    // sp_edit_distance("", "abc") == 3
    cki("edit_dist_empty_abc", sp_edit_distance("", "abc"), 3)

    // sp_edit_distance("abc", "") == 3
    cki("edit_dist_abc_empty", sp_edit_distance("abc", ""), 3)

    // sp_edit_distance("a", "b") == 1 (one substitution)
    cki("edit_dist_a_b", sp_edit_distance("a", "b"), 1)

    // "spelling" must be in sp_edits1("speling")
    // speling -> spelling: insert 'l' between e and i: "spe" + "l" + "ling"
    let edits = sp_edits1("speling")
    let found_spelling = 0
    let ei = 0
    while ei < len(edits)
        if edits[ei] == "spelling"
            found_spelling = 1
        ei = ei + 1
    cki("edits1_contains_spelling", found_spelling, 1)

    // sp_edits1 on empty word should produce a-z inserts (26 words of length 1)
    let empty_edits = sp_edits1("")
    if len(empty_edits) < 26
        print("FAIL spellcorrect edits1_empty_length: got=" + str(len(empty_edits)))
        exit(1)

    // sp_known: filter to known words
    let words_to_check = []
    push(words_to_check, "hello")
    push(words_to_check, "xyz")
    push(words_to_check, "the")
    let known = sp_known(words_to_check, dict)
    cki("known_count", len(known), 2)

    // sp_probability: "the" has count 3/7
    let prob = sp_probability("the", dict)
    // 3/7 ~= 0.4285; check it's in (0.4, 0.5)
    if prob <= 0.4
        print("FAIL spellcorrect prob_the_low: got=" + str(prob))
        exit(1)
    if prob >= 0.5
        print("FAIL spellcorrect prob_the_high: got=" + str(prob))
        exit(1)

    // sp_probability of unknown word == 0.0
    let prob_unk = sp_probability("unknownword", dict)
    if prob_unk != 0.0
        print("FAIL spellcorrect prob_unknown: got=" + str(prob_unk))
        exit(1)

    // sp_add_word: add a new word
    let dict2 = sp_add_word(dict, "nova")
    if sp_is_correct("nova", dict2) != true
        print("FAIL spellcorrect add_word_nova")
        exit(1)

    // sp_add_word: increment existing
    let old_count = dict["the"]
    let dict3 = sp_add_word(dict, "the")
    let new_count = dict3["the"]
    if new_count != old_count + 1
        print("FAIL spellcorrect add_word_the: got=" + str(new_count) + " want=" + str(old_count + 1))
        exit(1)

    // sp_suggestions: top-k candidates
    let sugg = sp_suggestions("speling", dict, 2)
    if len(sugg) == 0
        print("FAIL spellcorrect suggestions_nonempty")
        exit(1)
    cks("suggestions_top", sugg[0], "spelling")

    // sp_edits2_count: should be positive for any non-empty word
    let e2cnt = sp_edits2_count("hi")
    if e2cnt <= 0
        print("FAIL spellcorrect edits2_count: got=" + str(e2cnt))
        exit(1)

    // sp_candidates: for a correct word, should include the word itself
    let cands = sp_candidates("hello", dict)
    let found_hello = 0
    let ci = 0
    while ci < len(cands)
        if cands[ci] == "hello"
            found_hello = 1
        ci = ci + 1
    cki("candidates_hello", found_hello, 1)

    print("PASS _spellcorrect_test")
