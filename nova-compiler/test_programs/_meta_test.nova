// _meta_test.nova — KAT for std/midi/meta
//
// HAND-VERIFIED VECTORS:
//
// meta_end_of_track() = [0xFF, 0x2F, 0x00]
//
// meta_tempo(500000):
//   500000 = 0x07A120
//   data = [0x07, 0xA1, 0x20] = [7, 161, 32]
//   result = [0xFF, 0x51, 0x03, 0x07, 0xA1, 0x20]
//
// meta_track_name("Piano"):
//   "Piano" = [80, 105, 97, 110, 111]  (5 bytes)
//   result = [0xFF, 0x03, 0x05, 80, 105, 97, 110, 111]
//
// meta_time_sig(4, 4, 24, 8):
//   den=4 -> log2(4)=2
//   result = [0xFF, 0x58, 0x04, 0x04, 0x02, 0x18, 0x08]
//          = [255, 88, 4, 4, 2, 24, 8]
//
// meta_key_sig(0, false):
//   sf=0, mi=0
//   result = [0xFF, 0x59, 0x02, 0x00, 0x00]
//
// Round-trip: meta_decode(meta_tempo(500000), 0) -> dict with us_per_quarter=500000

import std/midi/meta

fn cki(label, got, want)
    if got != want
        print("FAIL meta " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_list(label, got, want)
    let gl = len(got)
    let wl = len(want)
    if gl != wl
        print("FAIL meta " + label + ": length got=" + str(gl) + " want=" + str(wl))
        exit(1)
    let i = 0
    loop
        if i >= gl
            break
        if got[i] != want[i]
            print("FAIL meta " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

fn main()
    // ── meta_end_of_track ────────────────────────────────────────────────────
    let eot = meta_end_of_track()
    let eot_want = [255, 47, 0]
    ck_list("end_of_track", eot, eot_want)

    // ── meta_tempo(500000) ───────────────────────────────────────────────────
    // 500000 = 0x07A120: bytes [7, 161, 32]
    let tempo = meta_tempo(500000)
    let tempo_want = [255, 81, 3, 7, 161, 32]
    ck_list("tempo_500000", tempo, tempo_want)

    // ── meta_track_name("Piano") ─────────────────────────────────────────────
    // 'P'=80 'i'=105 'a'=97 'n'=110 'o'=111
    let tname = meta_track_name("Piano")
    let tname_want = [255, 3, 5, 80, 105, 97, 110, 111]
    ck_list("track_name_Piano", tname, tname_want)

    // ── meta_time_sig(4, 4, 24, 8) ──────────────────────────────────────────
    // den=4 -> log2=2; [0xFF,0x58,0x04,4,2,24,8]
    let tsig = meta_time_sig(4, 4, 24, 8)
    let tsig_want = [255, 88, 4, 4, 2, 24, 8]
    ck_list("time_sig_4_4_24_8", tsig, tsig_want)

    // ── meta_key_sig(0, false) ───────────────────────────────────────────────
    let ksig = meta_key_sig(0, false)
    let ksig_want = [255, 89, 2, 0, 0]
    ck_list("key_sig_0_major", ksig, ksig_want)

    // ── meta_text ────────────────────────────────────────────────────────────
    // "Hi" = [72, 105]
    let txt = meta_text("Hi")
    let txt_want = [255, 1, 2, 72, 105]
    ck_list("text_Hi", txt, txt_want)

    // ── meta_marker ──────────────────────────────────────────────────────────
    // "A" = [65]
    let mkr = meta_marker("A")
    let mkr_want = [255, 6, 1, 65]
    ck_list("marker_A", mkr, mkr_want)

    // ── round-trip: meta_decode(meta_tempo(500000), 0) ──────────────────────
    let tlist = meta_tempo(500000)
    let decoded = meta_decode(tlist, 0)
    let dinfo = decoded[0]
    let dnext = decoded[1]
    cki("rt_tempo_type", dinfo["type"], 81)
    cki("rt_tempo_us", dinfo["us_per_quarter"], 500000)
    cki("rt_tempo_next", dnext, 6)

    // ── round-trip: meta_decode(meta_time_sig(4,4,24,8), 0) ─────────────────
    let tslist = meta_time_sig(4, 4, 24, 8)
    let tsd = meta_decode(tslist, 0)
    let tsinfo = tsd[0]
    cki("rt_tsig_num", tsinfo["numerator"], 4)
    cki("rt_tsig_den", tsinfo["denominator"], 4)
    cki("rt_tsig_clocks", tsinfo["clocks"], 24)
    cki("rt_tsig_n32", tsinfo["n32"], 8)

    // ── round-trip: meta_decode(meta_track_name("Piano"), 0) ────────────────
    let tnlist = meta_track_name("Piano")
    let tnd = meta_decode(tnlist, 0)
    let tninfo = tnd[0]
    cki("rt_name", tninfo["name"], "Piano")

    // ── round-trip: meta_decode(meta_key_sig(0,false), 0) ───────────────────
    let kslist = meta_key_sig(0, false)
    let ksd = meta_decode(kslist, 0)
    let ksinfo = ksd[0]
    cki("rt_ksig_sharps", ksinfo["sharps"], 0)
    cki("rt_ksig_minor", ksinfo["is_minor"], 0)

    // ── meta_key_sig negative (flats): -2 flats ─────────────────────────────
    // sharps=-2 -> sf = -2 & 0xFF = 254
    let kflat = meta_key_sig(-2, false)
    let kflat_want = [255, 89, 2, 254, 0]
    ck_list("key_sig_neg2_major", kflat, kflat_want)

    // round-trip decode of flats
    let kfd = meta_decode(kflat, 0)
    let kfinfo = kfd[0]
    cki("rt_ksig_flats_sharps", kfinfo["sharps"], -2)

    // ── meta_decode on malformed: too short ──────────────────────────────────
    let bad = [255]
    let badd = meta_decode(bad, 0)
    let badnext = badd[1]
    // next_pos should equal original pos (0) on failure
    cki("decode_bad_next", badnext, 0)

    // ── meta_decode: wrong first byte ────────────────────────────────────────
    let bad2 = [0x90, 0x51, 0x03, 7, 161, 32]
    let bad2d = meta_decode(bad2, 0)
    cki("decode_bad_ff_next", bad2d[1], 0)

    // ── meta_time_sig den=8 -> log2=3 ────────────────────────────────────────
    let tsig8 = meta_time_sig(6, 8, 24, 8)
    let tsig8_want = [255, 88, 4, 6, 3, 24, 8]
    ck_list("time_sig_6_8_24_8", tsig8, tsig8_want)

    print("PASS _meta_test")
