// httpx — pure-NOVA HTTP request/response helpers: Cookie parsing, Set-Cookie
// building, Authorization (Basic/Bearer) decoding, and Content-Type parsing.
// Operates on raw header strings + dicts (no server coupling, no new builtins),
// so it composes with any handler. Closes the table-stakes "HTTP depth" gaps
// (cookies / sessions / auth) the audit flagged for the full-stack web identity.

// Parse a Cookie header value ("a=1; b=2") into a dict of name -> value.
fn cookie_parse(header: string) -> dict
    let out: dict<string, string> = {}
    if len(header) == 0
        return out
    for part in split(header, ";")
        let p = trim(part)
        let eq = find(p, "=")
        if eq >= 0
            let k = trim(slice(p, 0, eq))
            let v = trim(slice(p, eq + 1, len(p)))
            if len(k) > 0
                out[k] = v
    return out

// Fetch one cookie value, or "" if absent.
fn cookie_get(header: string, name: string) -> string
    let jar = cookie_parse(header)
    if jar.has(name)
        return jar[name]
    return ""

// Build a Set-Cookie header value. path "" and max_age < 0 are omitted.
fn set_cookie(name: string, value: string, path: string, max_age: int) -> string
    let s = name + "=" + value
    if len(path) > 0
        s = s + "; Path=" + path
    if max_age >= 0
        s = s + "; Max-Age=" + str(max_age)
    return s

// Decode an "Authorization: Basic <base64(user:pass)>" header.
// Returns {"user":..,"pass":..}, or {} if the header is not well-formed Basic.
fn parse_basic_auth(header: string) -> dict
    let out: dict<string, string> = {}
    if not starts_with(header, "Basic ")
        return out
    let enc = trim(slice(header, 6, len(header)))
    let dec = base64_decode(enc)
    let ci = find(dec, ":")
    if ci < 0
        return out
    out["user"] = slice(dec, 0, ci)
    out["pass"] = slice(dec, ci + 1, len(dec))
    return out

// Extract the token from an "Authorization: Bearer <token>" header, or "".
fn parse_bearer(header: string) -> string
    if not starts_with(header, "Bearer ")
        return ""
    return trim(slice(header, 7, len(header)))

// Base media type of a Content-Type header (drops parameters like charset).
fn content_type_base(header: string) -> string
    let semi = find(header, ";")
    if semi >= 0
        return trim(slice(header, 0, semi))
    return trim(header)

fn main()
    // --- cookies ---
    let jar = cookie_parse("session=abc123; theme=dark; lang=en")
    assert_eq(len(jar), 3)
    assert_eq(jar["session"], "abc123")
    assert_eq(jar["theme"], "dark")
    assert_eq(cookie_get("a=1; b=2", "b"), "2")
    assert_eq(cookie_get("a=1; b=2", "z"), "")
    assert_eq(len(cookie_parse("")), 0)

    // --- set-cookie building ---
    assert_eq(set_cookie("sid", "xyz", "/", 3600), "sid=xyz; Path=/; Max-Age=3600")
    assert_eq(set_cookie("sid", "xyz", "", -1), "sid=xyz")

    // --- basic auth: base64("user:pass") = "dXNlcjpwYXNz" ---
    let ba = parse_basic_auth("Basic dXNlcjpwYXNz")
    assert_eq(ba["user"], "user")
    assert_eq(ba["pass"], "pass")
    assert_eq(len(parse_basic_auth("Bearer x")), 0)

    // --- bearer ---
    assert_eq(parse_bearer("Bearer tok_42"), "tok_42")
    assert_eq(parse_bearer("Basic abc"), "")

    // --- content type ---
    assert_eq(content_type_base("text/html; charset=utf-8"), "text/html")
    assert_eq(content_type_base("application/json"), "application/json")

    print("httpx passed")
