import std/relation/relation_closure

// cki — integer known-answer check.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ckb — boolean known-answer check (1=true, 0=false).
fn ckb(label, got, want)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

// ckl — integer-list known-answer check.
fn ckl(label, got, want)
    if len(got) != len(want)
        print("FAIL " + label + ": len got=" + str(len(got)) + " want=" + str(len(want)))
        exit(1)
    let i = 0
    while i < len(got)
        if got[i] != want[i]
            print("FAIL " + label + ": idx=" + str(i) + " got=" + str(got[i]) + " want=" + str(want[i]))
            exit(1)
        i = i + 1

// ckm — matrix known-answer check.
fn ckm(label, A, B)
    let n = len(A)
    if len(B) != n
        print("FAIL " + label + ": row count got=" + str(n) + " want=" + str(len(B)))
        exit(1)
    let i = 0
    while i < n
        let j = 0
        while j < len(A[i])
            if A[i][j] != B[i][j]
                print("FAIL " + label + ": [" + str(i) + "][" + str(j) + "] got=" + str(A[i][j]) + " want=" + str(B[i][j]))
                exit(1)
            j = j + 1
        i = i + 1

fn main()
    // ── KAT 1: transitive closure of {(0,1),(1,2)} on n=3 ──────────────────────
    // Expected: {(0,1),(1,2),(0,2)}
    let M1 = []
    let r1a = []
    r1a.push(0)
    r1a.push(1)
    r1a.push(0)
    M1.push(r1a)
    let r1b = []
    r1b.push(0)
    r1b.push(0)
    r1b.push(1)
    M1.push(r1b)
    let r1c = []
    r1c.push(0)
    r1c.push(0)
    r1c.push(0)
    M1.push(r1c)
    let TC1 = rcl_transitive_closure(M1, 3)
    // Expected matrix: row0=[0,1,1], row1=[0,0,1], row2=[0,0,0]
    let E1 = []
    let e1a = []
    e1a.push(0)
    e1a.push(1)
    e1a.push(1)
    E1.push(e1a)
    let e1b = []
    e1b.push(0)
    e1b.push(0)
    e1b.push(1)
    E1.push(e1b)
    let e1c = []
    e1c.push(0)
    e1c.push(0)
    e1c.push(0)
    E1.push(e1c)
    ckm("tc_chain_3", TC1, E1)

    // ── KAT 2: transitive closure of 3-cycle {(0,1),(1,2),(2,0)} = universal ──
    let M2 = []
    let r2a = []
    r2a.push(0)
    r2a.push(1)
    r2a.push(0)
    M2.push(r2a)
    let r2b = []
    r2b.push(0)
    r2b.push(0)
    r2b.push(1)
    M2.push(r2b)
    let r2c = []
    r2c.push(1)
    r2c.push(0)
    r2c.push(0)
    M2.push(r2c)
    let TC2 = rcl_transitive_closure(M2, 3)
    // Expected: all 9 pairs (universal relation on {0,1,2})
    let E2 = []
    let e2a = []
    e2a.push(1)
    e2a.push(1)
    e2a.push(1)
    E2.push(e2a)
    let e2b = []
    e2b.push(1)
    e2b.push(1)
    e2b.push(1)
    E2.push(e2b)
    let e2c = []
    e2c.push(1)
    e2c.push(1)
    e2c.push(1)
    E2.push(e2c)
    ckm("tc_3cycle_universal", TC2, E2)

    // ── KAT 3: reflexive closure of {} on n=3 = identity ───────────────────────
    let M3 = []
    let r3a = []
    r3a.push(0)
    r3a.push(0)
    r3a.push(0)
    M3.push(r3a)
    let r3b = []
    r3b.push(0)
    r3b.push(0)
    r3b.push(0)
    M3.push(r3b)
    let r3c = []
    r3c.push(0)
    r3c.push(0)
    r3c.push(0)
    M3.push(r3c)
    let RC3 = rcl_reflexive_closure(M3, 3)
    // Expected: identity matrix
    let E3 = []
    let e3a = []
    e3a.push(1)
    e3a.push(0)
    e3a.push(0)
    E3.push(e3a)
    let e3b = []
    e3b.push(0)
    e3b.push(1)
    e3b.push(0)
    E3.push(e3b)
    let e3c = []
    e3c.push(0)
    e3c.push(0)
    e3c.push(1)
    E3.push(e3c)
    ckm("rc_empty_n3_identity", RC3, E3)

    // ── KAT 4: symmetric closure of {(0,1)} = {(0,1),(1,0)} ───────────────────
    let M4 = []
    let r4a = []
    r4a.push(0)
    r4a.push(1)
    M4.push(r4a)
    let r4b = []
    r4b.push(0)
    r4b.push(0)
    M4.push(r4b)
    let SC4 = rcl_symmetric_closure(M4)
    let E4 = []
    let e4a = []
    e4a.push(0)
    e4a.push(1)
    E4.push(e4a)
    let e4b = []
    e4b.push(1)
    e4b.push(0)
    E4.push(e4b)
    ckm("sc_01_pair", SC4, E4)

    // ── KAT 5: rcl_is_closed_transitive on transitive closure = 1 ──────────────
    let TC1b = rcl_transitive_closure(M1, 3)
    cki("tc_chain_is_transitive", rcl_is_closed_transitive(TC1b, 3), 1)

    // ── KAT 6: rcl_is_closed_transitive on {(0,1),(1,2)} (not transitive) = 0 ──
    cki("chain_not_transitive", rcl_is_closed_transitive(M1, 3), 0)

    // ── KAT 7: rcl_is_closed_transitive on 3-cycle original (not transitive) = 0
    cki("3cycle_not_transitive", rcl_is_closed_transitive(M2, 3), 0)

    // ── KAT 8: rcl_is_closed_transitive on universal (all 1s) = 1 ──────────────
    cki("universal_is_transitive", rcl_is_closed_transitive(TC2, 3), 1)

    // ── KAT 9: reflexive_transitive_closure of chain {(0,1),(1,2)} ─────────────
    // Expected: identity + {(0,1),(1,2),(0,2)}
    let RTC = rcl_reflexive_transitive_closure(M1, 3)
    let E9 = []
    let e9a = []
    e9a.push(1)
    e9a.push(1)
    e9a.push(1)
    E9.push(e9a)
    let e9b = []
    e9b.push(0)
    e9b.push(1)
    e9b.push(1)
    E9.push(e9b)
    let e9c = []
    e9c.push(0)
    e9c.push(0)
    e9c.push(1)
    E9.push(e9c)
    ckm("rtc_chain_3", RTC, E9)

    // ── KAT 10: n=0 edge case ──────────────────────────────────────────────────
    let M0 = []
    let TC0 = rcl_transitive_closure(M0, 0)
    cki("tc_n0_len", len(TC0), 0)
    let RC0 = rcl_reflexive_closure(M0, 0)
    cki("rc_n0_len", len(RC0), 0)
    let SC0 = rcl_symmetric_closure(M0)
    cki("sc_n0_len", len(SC0), 0)

    // ── KAT 11: n=1 single element ─────────────────────────────────────────────
    let M11 = []
    let r11a = []
    r11a.push(0)
    M11.push(r11a)
    let RC11 = rcl_reflexive_closure(M11, 1)
    cki("rc_n1", RC11[0][0], 1)
    let TC11 = rcl_transitive_closure(M11, 1)
    cki("tc_n1_no_self", TC11[0][0], 0)
    let RTC11 = rcl_reflexive_transitive_closure(M11, 1)
    cki("rtc_n1_self", RTC11[0][0], 1)

    // ── KAT 12: symmetric closure is idempotent ────────────────────────────────
    let SC4b = rcl_symmetric_closure(SC4)
    ckm("sc_idempotent", SC4b, SC4)

    // ── KAT 13: reflexive closure is idempotent ────────────────────────────────
    let RC3b = rcl_reflexive_closure(RC3, 3)
    ckm("rc_idempotent", RC3b, RC3)

    print("PASS _relation_closure_test")

main()
