import std/game/elo_expected

// approx: check two floats are within tolerance
fn approx(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn chk(name: string, got: float, want: float, tol: float)
    if not approx(got, want, tol)
        print("FAIL elo_expected " + name + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // Equal ratings: 50% chance
    let e1 = elo_expected(1500.0, 1500.0)
    chk("equal_ratings", e1, 0.5, 0.0001)

    // 400-point advantage: ~90.91%
    let e2 = elo_expected(1900.0, 1500.0)
    chk("400pt_advantage", e2, 0.9091, 0.001)

    // Symmetry: e(a,b) + e(b,a) == 1.0
    let e3 = elo_expected(1600.0, 1400.0)
    let e4 = elo_expected(1400.0, 1600.0)
    let esum = e3 + e4
    chk("symmetry", esum, 1.0, 0.0001)

    // Underdog: e(1200,1800) ~0.0307 (1/(1+10^(600/400)))
    let e5 = elo_expected(1200.0, 1800.0)
    chk("underdog_lt_half", e5, 0.0307, 0.001)

    // 200-point advantage
    let e6 = elo_expected(1700.0, 1500.0)
    chk("200pt_advantage", e6, 0.7597, 0.001)

    print("PASS _elo_expected_test")
