// KAT for std/textlayout/textfill — paragraph fill / justify / indent utilities.
import std/textlayout/textfill

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL textfill " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    let nl = chr(10)

    // tf_fill: whitespace-collapse + greedy wrap
    cks("fill_basic", tf_fill("the  quick   brown fox", 10), "the quick" + nl + "brown fox")
    cks("fill_4",     tf_fill("aaaa bbbb cccc", 4),          "aaaa" + nl + "bbbb" + nl + "cccc")
    cks("fill_empty", tf_fill("", 10),                        "")
    cks("fill_one",   tf_fill("hello", 20),                   "hello")
    cks("fill_longword", tf_fill("superlongword ok", 5),      "superlongword" + nl + "ok")

    // tf_normalize_ws
    cks("ws_collapse", tf_normalize_ws("a   b  c"), "a b c")
    cks("ws_trim",     tf_normalize_ws("  hi  "),   "hi")
    cks("ws_tabs",     tf_normalize_ws("a" + chr(9) + "b"), "a b")
    cks("ws_empty",    tf_normalize_ws(""),          "")

    // tf_fill_indent: each line prefixed with indent
    cks("fill_indent_basic", tf_fill_indent("a b c", 3, "> "), "> a" + nl + "> b" + nl + "> c")
    cks("fill_indent_para",  tf_fill_indent("hello world", 12, "  "), "  hello" + nl + "  world")
    cks("fill_indent_empty", tf_fill_indent("", 10, "  "), "")

    // tf_fill_justify: all but last line stretched to width
    // "abc def" width 10: one line "abc def" (last line → not justified)
    cks("justify_oneline", tf_fill_justify("abc def", 10), "abc def")
    // "ab cd ef" width 5: words ab(2) cd(2) ef(2)
    // "ab cd"=5 fits, "ef" next line. Last line not justified.
    // Line 0 "ab cd" justified to 5 = "ab  cd" (1 gap, need 2 spaces between)?
    // Actually: word_chars=2+2=4, gaps=1, total_spaces=5-4=1, base_sp=1, extra=0 => "ab cd"
    cks("justify_twolines", tf_fill_justify("ab cd ef", 5), "ab cd" + nl + "ef")

    // tf_fill_first_indent: different indent for line 0 vs rest
    // text="one two three", width=10, first=">> ", rest="   "
    // first_width=10-3=7, rest_width=10-3=7
    // words=[one,two,three]. "one"=3, "one two"=7 fits, "three"=7+1+5=13>7 flush.
    // Line 0: ">> one two", Line 1: "   three"
    let fi_want = ">> one two" + nl + "   three"
    cks("first_indent", tf_fill_first_indent("one two three", 10, ">> ", "   "), fi_want)
    cks("first_indent_empty", tf_fill_first_indent("", 10, "> ", "  "), "")

    print("PASS _textfill_test")
