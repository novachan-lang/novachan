// KAT for prism_ui_search: search/filter bar composites.
// Verified against nova-compiler/lib/prism_node.nova, prism_interact.nova, prism_arrange.nova,
// prism_content.nova at KAT-authoring time: kind strings are "band"/"stack"/"gap"/"label"/
// "press"/"entry" (prism_node_kind_name, exhaustive match); label/press store their text under
// attr "text"; entry stores "prompt"/"kind"/"value"; gap exposes prism_gap_is_flexible/
// prism_gap_size accessors instead of a generic attr read.

import prism_node
import prism_arrange
import prism_content
import prism_interact
import prism_ui_search

fn chk(cond: bool, msg: string) -> int
    if cond
        print("PASS: " + msg)
        return 1
    print("FAIL: " + msg)
    return 0

fn main()
    let mut total = 0
    let mut pass = 0

    let placeholder = "Search products"
    let filters = ["All", "Active", "Archived", "Deleted"]
    let active_filter = "Active"

    // ── 1. prism_sr_search ────────────────────────────────────────────────────────────────
    let r1 = prism_ui_search.prism_sr_search(placeholder)
    total += 1
    pass += chk(is_ok(r1), "search: ok on valid placeholder")

    let n1 = unwrap(r1)
    total += 1
    pass += chk(prism_node.prism_node_kind_str(n1) == "band", "search: kind == band")

    let c1 = prism_node.prism_node_children(n1)
    total += 1
    pass += chk(len(c1) == 2, "search: 2 children")

    let c1_entry = c1[0]
    let c1_btn = c1[1]
    total += 1
    pass += chk(prism_node.prism_node_kind_str(c1_entry) == "entry", "search: child0 kind == entry")
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c1_entry, "prompt", "") == placeholder, "search: entry prompt == placeholder")
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c1_entry, "kind", "") == "search", "search: entry kind == search")
    total += 1
    pass += chk(prism_node.prism_node_kind_str(c1_btn) == "press", "search: child1 kind == press")
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c1_btn, "text", "") == "Search", "search: button text == Search")

    let c1_btn_children = prism_node.prism_node_children(c1_btn)
    total += 1
    pass += chk(len(c1_btn_children) == 1, "search: button has 1 child (label)")
    total += 1
    pass += chk(prism_node.prism_node_kind_str(c1_btn_children[0]) == "label", "search: button child kind == label")
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c1_btn_children[0], "text", "") == "Search", "search: button label text == Search")

    let r1e = prism_ui_search.prism_sr_search("")
    total += 1
    pass += chk(is_err(r1e), "search: err on empty placeholder")
    total += 1
    pass += chk(contains(unwrap_err(r1e), "prism_sr_search"), "search: err message names function")

    // ── 2. prism_sr_clearable ─────────────────────────────────────────────────────────────
    let r2t = prism_ui_search.prism_sr_clearable(placeholder, true)
    total += 1
    pass += chk(is_ok(r2t), "clearable(true): ok")

    let n2t = unwrap(r2t)
    total += 1
    pass += chk(prism_node.prism_node_kind_str(n2t) == "band", "clearable(true): kind == band")

    let c2t = prism_node.prism_node_children(n2t)
    total += 1
    pass += chk(len(c2t) == 3, "clearable(true): 3 children")
    total += 1
    pass += chk(prism_node.prism_node_kind_str(c2t[0]) == "entry", "clearable(true): child0 kind == entry")
    total += 1
    pass += chk(prism_node.prism_node_kind_str(c2t[1]) == "press", "clearable(true): child1 kind == press")
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c2t[1], "text", "") == "Clear search", "clearable(true): child1 text == Clear search")
    total += 1
    pass += chk(prism_node.prism_node_kind_str(c2t[2]) == "press", "clearable(true): child2 kind == press")
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c2t[2], "text", "") == "Search", "clearable(true): child2 text == Search")

    let r2f = prism_ui_search.prism_sr_clearable(placeholder, false)
    total += 1
    pass += chk(is_ok(r2f), "clearable(false): ok")

    let n2f = unwrap(r2f)
    let c2f = prism_node.prism_node_children(n2f)
    total += 1
    pass += chk(len(c2f) == 2, "clearable(false): 2 children")
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c2f[1], "text", "") == "Search", "clearable(false): child1 text == Search")

    let r2et = prism_ui_search.prism_sr_clearable("", true)
    total += 1
    pass += chk(is_err(r2et), "clearable(true): err on empty placeholder")

    let r2ef = prism_ui_search.prism_sr_clearable("", false)
    total += 1
    pass += chk(is_err(r2ef), "clearable(false): err on empty placeholder")
    total += 1
    pass += chk(contains(unwrap_err(r2ef), "prism_sr_clearable"), "clearable: err message names function")

    // ── 3. prism_sr_filters ───────────────────────────────────────────────────────────────
    let r3 = prism_ui_search.prism_sr_filters(filters, active_filter)
    total += 1
    pass += chk(is_ok(r3), "filters: ok on valid filters")

    let n3 = unwrap(r3)
    total += 1
    pass += chk(prism_node.prism_node_kind_str(n3) == "band", "filters: kind == band")

    let c3 = prism_node.prism_node_children(n3)
    total += 1
    pass += chk(len(c3) == 4, "filters: 4 children (one per filter)")

    // index 1 ("Active") is the active filter -- expects "> " prefix
    total += 1
    pass += chk(prism_node.prism_node_kind_str(c3[1]) == "press", "filters: active child kind == press")
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c3[1], "text", "") == "Filter by Active", "filters: active child accessible text")

    let c3_1_children = prism_node.prism_node_children(c3[1])
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c3_1_children[0], "text", "") == "> Active", "filters: active label has '> ' prefix")

    let c3_0_children = prism_node.prism_node_children(c3[0])
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c3_0_children[0], "text", "") == "  All", "filters: inactive 'All' has '  ' prefix")

    let c3_2_children = prism_node.prism_node_children(c3[2])
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c3_2_children[0], "text", "") == "  Archived", "filters: inactive 'Archived' has '  ' prefix")

    let c3_3_children = prism_node.prism_node_children(c3[3])
    total += 1
    pass += chk(prism_node.prism_node_attr_str(c3_3_children[0], "text", "") == "  Deleted", "filters: inactive 'Deleted' has '  ' prefix")

    let empty_filters = []
    let r3e1 = prism_ui_search.prism_sr_filters(empty_filters, active_filter)
    total += 1
    pass += chk(is_err(r3e1), "filters: err on empty filters list")
    total += 1
    pass += chk(contains(unwrap_err(r3e1), "prism_sr_filters"), "filters: empty-list err names function")

    let bad_filters_int = [42, "x"]
    let r3e2 = prism_ui_search.prism_sr_filters(bad_filters_int, "x")
    total += 1
    pass += chk(is_err(r3e2), "filters: err on non-string filter (int at idx 0)")
    total += 1
    pass += chk(contains(unwrap_err(r3e2), "got int"), "filters: err names actual type 'int'")

    let bad_filters_float = ["ok", 3.14]
    let r3e3 = prism_ui_search.prism_sr_filters(bad_filters_float, "ok")
    total += 1
    pass += chk(is_err(r3e3), "filters: err on non-string filter (float at idx 1)")
    total += 1
    pass += chk(contains(unwrap_err(r3e3), "got float"), "filters: err names actual type 'float'")

    // ── 4. prism_sr_combo ─────────────────────────────────────────────────────────────────
    let r4 = prism_ui_search.prism_sr_combo(placeholder, filters, active_filter)
    total += 1
    pass += chk(is_ok(r4), "combo: ok on valid inputs")

    let n4 = unwrap(r4)
    total += 1
    pass += chk(prism_node.prism_node_kind_str(n4) == "stack", "combo: kind == stack")

    let c4 = prism_node.prism_node_children(n4)
    total += 1
    pass += chk(len(c4) == 3, "combo: 3 children (search, gap, filters)")
    total += 1
    pass += chk(prism_node.prism_node_kind_str(c4[0]) == "band", "combo: child0 (search) kind == band")
    total += 1
    pass += chk(prism_node.prism_node_kind_str(c4[1]) == "gap", "combo: child1 kind == gap")
    total += 1
    pass += chk(prism_arrange.prism_gap_is_flexible(c4[1]) == false, "combo: gap is fixed, not flexible")
    total += 1
    pass += chk(prism_arrange.prism_gap_size(c4[1], -1) == 8, "combo: gap size == 8")
    total += 1
    pass += chk(prism_node.prism_node_kind_str(c4[2]) == "band", "combo: child2 (filters) kind == band")

    let c4_2_children = prism_node.prism_node_children(c4[2])
    total += 1
    pass += chk(len(c4_2_children) == 4, "combo: filter band has 4 children")

    let r4e1 = prism_ui_search.prism_sr_combo("", filters, active_filter)
    total += 1
    pass += chk(is_err(r4e1), "combo: err on empty placeholder")
    total += 1
    pass += chk(contains(unwrap_err(r4e1), "prism_sr_combo"), "combo: empty-placeholder err names function")

    let r4e2 = prism_ui_search.prism_sr_combo(placeholder, empty_filters, active_filter)
    total += 1
    pass += chk(is_err(r4e2), "combo: err on empty filters")
    total += 1
    pass += chk(contains(unwrap_err(r4e2), "prism_sr_combo"), "combo: empty-filters err names function")

    // ── 5. prism_sr_count ─────────────────────────────────────────────────────────────────
    let r5a = prism_ui_search.prism_sr_count(0)
    total += 1
    pass += chk(is_ok(r5a), "count(0): ok")

    let n5a = unwrap(r5a)
    total += 1
    pass += chk(prism_node.prism_node_kind_str(n5a) == "label", "count(0): kind == label")
    total += 1
    pass += chk(prism_node.prism_node_attr_str(n5a, "text", "") == "No results", "count(0): text == 'No results'")

    let r5b = prism_ui_search.prism_sr_count(5)
    total += 1
    pass += chk(is_ok(r5b), "count(5): ok")

    let n5b = unwrap(r5b)
    total += 1
    pass += chk(prism_node.prism_node_attr_str(n5b, "text", "") == "5 results", "count(5): text == '5 results'")

    let r5c = prism_ui_search.prism_sr_count(1)
    total += 1
    pass += chk(is_ok(r5c), "count(1): ok")

    let n5c = unwrap(r5c)
    total += 1
    pass += chk(prism_node.prism_node_attr_str(n5c, "text", "") == "1 results", "count(1): text == '1 results' (no singular special-case)")

    let r5e = prism_ui_search.prism_sr_count(-1)
    total += 1
    pass += chk(is_err(r5e), "count(-1): err on negative count")
    total += 1
    pass += chk(contains(unwrap_err(r5e), "prism_sr_count"), "count(-1): err message names function")

    // ── summary ───────────────────────────────────────────────────────────────────────────
    print("")
    print(str(pass) + "/" + str(total) + " assertions passed")
    if pass == total
        print("_kat_prism_ui_search: ALL PASS")
    else
        print("_kat_prism_ui_search: FAILURES PRESENT")
