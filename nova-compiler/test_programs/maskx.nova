fn mask_email(email)
  let at = -1
  let i = 0
  while i < len(email)
    if slice(email, i, i + 1) == "@"
      at = i
      i = len(email)
    i = i + 1
  if at <= 0
    return "***"
  let local = slice(email, 0, at)
  let domain = slice(email, at, len(email))
  if len(local) <= 2
    return "**" + domain
  slice(local, 0, 1) + "***" + slice(local, len(local) - 1, len(local)) + domain

fn mask_card(number)
  let digits = ""
  let i = 0
  while i < len(number)
    let ch = slice(number, i, i + 1)
    let cp = code_points(ch)
    if cp[0] >= 48 and cp[0] <= 57
      digits = digits + ch
    i = i + 1
  let n = len(digits)
  if n < 4
    return "****"
  let last4 = slice(digits, n - 4, n)
  let masked = ""
  let j = 0
  while j < n - 4
    masked = masked + "*"
    j = j + 1
  masked + last4

fn mask_phone(phone)
  let n = len(phone)
  if n <= 4
    return "****"
  let visible = slice(phone, n - 4, n)
  let masked = ""
  let i = 0
  while i < n - 4
    let ch = slice(phone, i, i + 1)
    let cp = code_points(ch)
    if cp[0] >= 48 and cp[0] <= 57
      masked = masked + "*"
    else
      masked = masked + ch
    i = i + 1
  masked + visible

fn mask_middle(text, show_start, show_end)
  let n = len(text)
  if n <= show_start + show_end
    return text
  let start = slice(text, 0, show_start)
  let end_part = slice(text, n - show_end, n)
  let mid = ""
  let i = 0
  while i < n - show_start - show_end
    mid = mid + "*"
    i = i + 1
  start + mid + end_part

fn main()
  assert(mask_email("alice@example.com") == "a***e@example.com", "mask email")
  assert(mask_email("ab@x.com") == "**@x.com", "mask short email")
  assert(mask_email("noat") == "***", "mask no-at")

  assert(mask_card("4111111111111111") == "************1111", "mask card")
  assert(mask_card("4111-1111-1111-1111") == "************1111", "mask card with dashes")
  assert(mask_card("123") == "****", "mask short card")

  assert(mask_phone("+1-555-123-4567") == "+*-***-***-4567", "mask phone")
  assert(mask_phone("1234") == "****", "mask short phone")

  assert(mask_middle("secret-token-value", 3, 3) == "sec************lue", "mask middle")
  assert(mask_middle("hi", 3, 3) == "hi", "mask middle short")

  print("maskx: all passed")
