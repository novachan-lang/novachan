// KAT test for std/data/feed_roundtrip — feed dispatch and detection
import std/data/feed_roundtrip

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let dq = chr(34)

    // ── KAT 1: detect_feed_type RSS ──────────────────────────────────────────
    let rss_xml = "<rss version=" + dq + "2.0" + dq + "><channel><title>T</title></channel></rss>"
    cks("kat1-detect-rss", detect_feed_type(rss_xml), "rss")
    print("KAT 1 PASS: detect_feed_type rss")

    // ── KAT 2: detect_feed_type Atom ─────────────────────────────────────────
    let atom_xml = "<feed xmlns=" + dq + "http://www.w3.org/2005/Atom" + dq + "><title>AF</title></feed>"
    cks("kat2-detect-atom", detect_feed_type(atom_xml), "atom")
    print("KAT 2 PASS: detect_feed_type atom")

    // ── KAT 3: detect_feed_type OPML ─────────────────────────────────────────
    let opml_xml = "<opml><head><title>S</title></head><body></body></opml>"
    cks("kat3-detect-opml", detect_feed_type(opml_xml), "opml")
    print("KAT 3 PASS: detect_feed_type opml")

    // ── KAT 4: detect_feed_type unknown ──────────────────────────────────────
    let html_xml = "<html><body>not a feed</body></html>"
    cks("kat4-detect-unknown", detect_feed_type(html_xml), "unknown")
    print("KAT 4 PASS: detect_feed_type unknown")

    // ── KAT 5: feed_titles for 2-item RSS ────────────────────────────────────
    let rss2 = "<rss><channel><title>Feed</title><item><title>Alpha</title></item><item><title>Beta</title></item></channel></rss>"
    let titles5 = feed_titles(rss2)
    cki("kat5-count", len(titles5), 2)
    cks("kat5-t0", titles5[0], "Alpha")
    cks("kat5-t1", titles5[1], "Beta")
    print("KAT 5 PASS: feed_titles 2-item RSS")

    // ── KAT 6: feed_titles for Atom ──────────────────────────────────────────
    let atom2 = "<feed xmlns=" + dq + "http://www.w3.org/2005/Atom" + dq + "><title>AF</title><entry><title>Gamma</title><id>g1</id><updated>2024-01-01</updated></entry></feed>"
    let titles6 = feed_titles(atom2)
    cki("kat6-count", len(titles6), 1)
    cks("kat6-t0", titles6[0], "Gamma")
    print("KAT 6 PASS: feed_titles Atom")

    // ── KAT 7: feed_titles unknown → empty list ───────────────────────────────
    let titles7 = feed_titles(html_xml)
    cki("kat7-count", len(titles7), 0)
    print("KAT 7 PASS: feed_titles unknown returns empty list")

    // ── KAT 8: feed_parse RSS type field ─────────────────────────────────────
    let parsed8 = feed_parse(rss_xml)
    cks("kat8-type", parsed8["type"], "rss")
    cks("kat8-title", parsed8["title"], "T")
    print("KAT 8 PASS: feed_parse RSS type field")

    // ── KAT 9: feed_parse Atom type field ────────────────────────────────────
    let parsed9 = feed_parse(atom_xml)
    cks("kat9-type", parsed9["type"], "atom")
    cks("kat9-title", parsed9["title"], "AF")
    print("KAT 9 PASS: feed_parse Atom type field")

    // ── KAT 10: feed_parse OPML type field ───────────────────────────────────
    let parsed10 = feed_parse(opml_xml)
    cks("kat10-type", parsed10["type"], "opml")
    cks("kat10-title", parsed10["title"], "S")
    print("KAT 10 PASS: feed_parse OPML type field")

    // ── KAT 11: feed_parse unknown type ──────────────────────────────────────
    let parsed11 = feed_parse(html_xml)
    cks("kat11-type", parsed11["type"], "unknown")
    print("KAT 11 PASS: feed_parse unknown type")

    print("PASS _feed_roundtrip_test")
