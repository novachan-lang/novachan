// functional: saga success path + failure path with reverse compensation
import forge_saga

fn _act_ok(ctx)
    ok(ctx)

fn _act_boom(ctx)
    err("boom")

fn _comp_count(ctx)
    atomic_add(ctx["cc"], 1)
    ctx

fn main()
    let s = saga_new()
    saga_step(s, "a", _act_ok, _comp_count)
    saga_step(s, "b", _act_ok, _comp_count)
    if saga_len(s) != 2
        print("FAIL len")
        exit(1)
    if is_ok(saga_run(s, {})) != true
        print("FAIL success path")
        exit(1)
    let s2 = saga_new()
    let cnt = atomic_new(0)
    saga_step(s2, "a", _act_ok, _comp_count)
    saga_step(s2, "boom", _act_boom, _comp_count)
    let ctx2 = {}
    ctx2["cc"] = cnt
    if is_err(saga_run(s2, ctx2)) != true
        print("FAIL should fail")
        exit(1)
    if atomic_get(cnt) != 1
        print("FAIL comp count = " + str(atomic_get(cnt)))
        exit(1)
    print("PASS forge_saga")
