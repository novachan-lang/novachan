import forge_maxrect

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// brute-force largest rectangle in histogram
fn brute_hist(h: list) -> int
    let best = 0
    let l = 0
    while l < len(h)
        let minh = h[l]
        let r = l
        while r < len(h)
            if h[r] < minh
                minh = h[r]
            let area = minh * (r - l + 1)
            if area > best
                best = area
            r = r + 1
        l = l + 1
    best

fn main()
    let fails = 0

    // largest rectangle in histogram
    fails = fails + expect("hist_classic", str(largest_rectangle_histogram([2, 1, 5, 6, 2, 3])), "10")
    fails = fails + expect("hist_flat", str(largest_rectangle_histogram([2, 4])), "4")
    fails = fails + expect("hist_single", str(largest_rectangle_histogram([5])), "5")
    fails = fails + expect("hist_empty", str(largest_rectangle_histogram([])), "0")
    fails = fails + expect("hist_valley", str(largest_rectangle_histogram([6, 2, 5, 4, 5, 1, 6])), "12")
    fails = fails + expect("hist_incr", str(largest_rectangle_histogram([1, 2, 3, 4, 5])), "9")
    fails = fails + expect("hist_zeros", str(largest_rectangle_histogram([0, 0, 0])), "0")

    // brute-force cross-check on several histograms
    let ok = 1
    let hs = []
    push(hs, [3, 1, 3, 2, 2])
    push(hs, [4, 2, 0, 3, 2, 4, 3, 4])
    push(hs, [1, 1, 1, 1])
    push(hs, [5, 4, 3, 2, 1])
    let t = 0
    while t < len(hs)
        if largest_rectangle_histogram(hs[t]) != brute_hist(hs[t])
            ok = 0
        t = t + 1
    fails = fails + expect("hist_brute", str(ok), "1")

    // maximal rectangle in a binary matrix (classic LeetCode example -> 6)
    let mat = []
    push(mat, [1, 0, 1, 0, 0])
    push(mat, [1, 0, 1, 1, 1])
    push(mat, [1, 1, 1, 1, 1])
    push(mat, [1, 0, 0, 1, 0])
    fails = fails + expect("mat_classic", str(maximal_rectangle(mat)), "6")

    // all zeros -> 0
    let m0 = []
    push(m0, [0, 0])
    push(m0, [0, 0])
    fails = fails + expect("mat_zero", str(maximal_rectangle(m0)), "0")

    // all ones -> full area
    let m1 = []
    push(m1, [1, 1, 1])
    push(m1, [1, 1, 1])
    fails = fails + expect("mat_ones", str(maximal_rectangle(m1)), "6")

    // single row
    let mr = []
    push(mr, [1, 1, 0, 1, 1, 1])
    fails = fails + expect("mat_row", str(maximal_rectangle(mr)), "3")

    if fails == 0
        print("forge_maxrect: all passed")
    else
        print("forge_maxrect: " + str(fails) + " FAILED")
