// KAT for std/net/ipv6hdr — RFC 8200 40-byte IPv6 fixed header codec.
import std/net/ipv6hdr

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL ipv6hdr " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── Build known src and dst addresses ────────────────────────────────────
    // src = 2001:db8::1  -> byte0=0x20, byte1=0x01, byte2=0x0d, byte3=0xb8, byte15=0x01
    let src = bytes(16)
    bytes_set(src, 0, 0x20)
    bytes_set(src, 1, 0x01)
    bytes_set(src, 2, 0x0d)
    bytes_set(src, 3, 0xb8)
    bytes_set(src, 15, 0x01)
    // dst = ::1 -> byte15=0x01
    let dst = bytes(16)
    bytes_set(dst, 15, 0x01)

    // ── Vector 1: encode a TCP-over-IPv6 packet header ───────────────────────
    // version=6, tc=0, flow_label=0, payload_length=0x14=20,
    // next_header=6 (TCP), hop_limit=64
    let h1 = {"version": 6, "traffic_class": 0, "flow_label": 0, "payload_length": 20, "next_header": 6, "hop_limit": 64, "src": src, "dst": dst}
    let enc1 = ipv6_encode(h1)

    // Must be exactly 40 bytes
    cki("enc1_len",   bytes_len(enc1), 40)

    // byte0: version=6 in top nibble -> (6<<4)|(0>>4) = 0x60
    cki("enc1_b0",    bytes_get(enc1, 0),  0x60)
    // byte1: ((tc&0xF)<<4)|((flow_label>>16)&0xF) = 0
    cki("enc1_b1",    bytes_get(enc1, 1),  0x00)
    // byte2: (flow_label>>8)&0xFF = 0
    cki("enc1_b2",    bytes_get(enc1, 2),  0x00)
    // byte3: flow_label&0xFF = 0
    cki("enc1_b3",    bytes_get(enc1, 3),  0x00)

    // payload_length u16 BE at bytes 4-5: 0x0014
    let pl_wire = (bytes_get(enc1, 4) << 8) | bytes_get(enc1, 5)
    cki("enc1_payload_len", pl_wire, 0x14)
    cki("enc1_b4",    bytes_get(enc1, 4),  0x00)
    cki("enc1_b5",    bytes_get(enc1, 5),  0x14)

    // next_header byte6 = 6 (TCP)
    cki("enc1_next_hdr",  bytes_get(enc1, 6), 6)
    // hop_limit byte7 = 64
    cki("enc1_hop_limit", bytes_get(enc1, 7), 64)

    // src bytes at 8..23
    cki("enc1_src_b0",  bytes_get(enc1, 8),  0x20)
    cki("enc1_src_b1",  bytes_get(enc1, 9),  0x01)
    cki("enc1_src_b2",  bytes_get(enc1, 10), 0x0d)
    cki("enc1_src_b3",  bytes_get(enc1, 11), 0xb8)
    cki("enc1_src_b15", bytes_get(enc1, 23), 0x01)

    // dst bytes at 24..39: ::1 => byte39=1 all others 0
    cki("enc1_dst_b0",  bytes_get(enc1, 24), 0x00)
    cki("enc1_dst_b15", bytes_get(enc1, 39), 0x01)

    // ── Vector 2: non-zero traffic_class and flow_label ───────────────────────
    // version=6, tc=0xAB, flow_label=0x12345, payload_length=0x100,
    // next_header=17 (UDP), hop_limit=128
    // First word: (6<<28)|(0xAB<<20)|(0x12345)
    //   byte0 = (6<<4)|(0xAB>>4) = 0x60|0x0A = 0x6A
    //   byte1 = ((0xAB&0xF)<<4)|((0x12345>>16)&0xF) = (0xB<<4)|0x1 = 0xB1
    //   byte2 = (0x12345>>8)&0xFF = 0x23
    //   byte3 = 0x12345&0xFF = 0x45
    let h2 = {"version": 6, "traffic_class": 0xAB, "flow_label": 0x12345, "payload_length": 0x100, "next_header": 17, "hop_limit": 128, "src": bytes(16), "dst": bytes(16)}
    let enc2 = ipv6_encode(h2)
    cki("enc2_len",  bytes_len(enc2), 40)
    cki("enc2_b0",   bytes_get(enc2, 0), 0x6A)
    cki("enc2_b1",   bytes_get(enc2, 1), 0xB1)
    cki("enc2_b2",   bytes_get(enc2, 2), 0x23)
    cki("enc2_b3",   bytes_get(enc2, 3), 0x45)
    // payload_length 0x100 -> byte4=1, byte5=0
    cki("enc2_b4",   bytes_get(enc2, 4), 0x01)
    cki("enc2_b5",   bytes_get(enc2, 5), 0x00)
    cki("enc2_b6",   bytes_get(enc2, 6), 17)
    cki("enc2_b7",   bytes_get(enc2, 7), 128)

    // ── Decode enc1 and verify every field ───────────────────────────────────
    let dec1 = ipv6_decode(enc1)
    cki("dec1_version",       dec1["version"],       6)
    cki("dec1_traffic_class", dec1["traffic_class"],  0)
    cki("dec1_flow_label",    dec1["flow_label"],     0)
    cki("dec1_payload_len",   dec1["payload_length"], 20)
    cki("dec1_next_header",   dec1["next_header"],    6)
    cki("dec1_hop_limit",     dec1["hop_limit"],      64)
    // verify src bytes from decoded header
    let dec1_src = dec1["src"]
    cki("dec1_src_b0",  bytes_get(dec1_src, 0),  0x20)
    cki("dec1_src_b1",  bytes_get(dec1_src, 1),  0x01)
    cki("dec1_src_b2",  bytes_get(dec1_src, 2),  0x0d)
    cki("dec1_src_b3",  bytes_get(dec1_src, 3),  0xb8)
    cki("dec1_src_b15", bytes_get(dec1_src, 15), 0x01)
    // verify dst bytes from decoded header
    let dec1_dst = dec1["dst"]
    cki("dec1_dst_b0",  bytes_get(dec1_dst, 0),  0x00)
    cki("dec1_dst_b15", bytes_get(dec1_dst, 15), 0x01)

    // ── Decode enc2 and verify non-trivial tc/flow_label round-trip ──────────
    let dec2 = ipv6_decode(enc2)
    cki("dec2_version",       dec2["version"],       6)
    cki("dec2_traffic_class", dec2["traffic_class"],  0xAB)
    cki("dec2_flow_label",    dec2["flow_label"],     0x12345)
    cki("dec2_payload_len",   dec2["payload_length"], 0x100)
    cki("dec2_next_header",   dec2["next_header"],    17)
    cki("dec2_hop_limit",     dec2["hop_limit"],      128)

    // ── Full round-trip: all distinct field values ────────────────────────────
    let rt_src = bytes(16)
    bytes_set(rt_src, 0, 0xFE)
    bytes_set(rt_src, 1, 0x80)
    bytes_set(rt_src, 15, 0x42)
    let rt_dst = bytes(16)
    bytes_set(rt_dst, 0, 0xFF)
    bytes_set(rt_dst, 1, 0x02)
    bytes_set(rt_dst, 15, 0x01)
    let rt_in = {"version": 6, "traffic_class": 0x10, "flow_label": 0xABCDE, "payload_length": 0x5678, "next_header": 58, "hop_limit": 255, "src": rt_src, "dst": rt_dst}
    let rt_enc = ipv6_encode(rt_in)
    let rt_dec = ipv6_decode(rt_enc)
    cki("rt_version",       rt_dec["version"],       6)
    cki("rt_traffic_class", rt_dec["traffic_class"],  0x10)
    cki("rt_flow_label",    rt_dec["flow_label"],     0xABCDE)
    cki("rt_payload_len",   rt_dec["payload_length"], 0x5678)
    cki("rt_next_header",   rt_dec["next_header"],    58)
    cki("rt_hop_limit",     rt_dec["hop_limit"],      255)
    let rt_dec_src = rt_dec["src"]
    let rt_dec_dst = rt_dec["dst"]
    cki("rt_src_b0",  bytes_get(rt_dec_src, 0),  0xFE)
    cki("rt_src_b1",  bytes_get(rt_dec_src, 1),  0x80)
    cki("rt_src_b15", bytes_get(rt_dec_src, 15), 0x42)
    cki("rt_dst_b0",  bytes_get(rt_dec_dst, 0),  0xFF)
    cki("rt_dst_b1",  bytes_get(rt_dec_dst, 1),  0x02)
    cki("rt_dst_b15", bytes_get(rt_dec_dst, 15), 0x01)

    // ── Bounds-safety: short buffer returns empty dict ────────────────────────
    let short_buf = bytes(20)
    let dec_short = ipv6_decode(short_buf)
    let has_version = 0
    if contains(dec_short, "version")
        has_version = 1
    cki("short_empty", has_version, 0)

    // ── Empty buffer returns empty dict ──────────────────────────────────────
    let empty_buf = bytes(0)
    let dec_empty = ipv6_decode(empty_buf)
    let has_ver2 = 0
    if contains(dec_empty, "version")
        has_ver2 = 1
    cki("empty_dict", has_ver2, 0)

    print("PASS _ipv6hdr_test")
