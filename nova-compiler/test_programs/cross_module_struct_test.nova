// cross_module_struct_test -- permanent guard for the cross-module struct field-resolution
// fix (nova_compiler.nova typed-let: honor the declared struct type). XS is defined in an
// imported module (_xs_mod); a SECOND struct YS there shares the field name "a" at a DIFFERENT
// slot. Field access x.a must resolve PER-STRUCT (XS.a = slot 1 = 7), NOT via a global
// name->slot map (which YS.a would overwrite -> wrong slot -> CVE-class wrong read / segfault).
// The typed-let `let x: XS` makes the access resolve correctly.
import _xs_mod

fn main()
    let x: XS = _xs_mod.mk_xs()
    assert(x.a == 7, "XS.a per-struct slot (not YS.a's slot)")
    assert(x.b == "hi", "XS.b")
    assert(len(keys(x.c)) == 1, "XS.c dict")
    print("cross_module_struct_test passed")
