import forge_intervaltree

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// render a list of [s,e] intervals sorted by (start,end) for comparison
fn render_sorted(ivs: list) -> string
    // insertion sort a COPY by start then end, using parallel scalar arrays
    let ss = []
    let ee = []
    let i = 0
    while i < len(ivs)
        push(ss, ivs[i][0])
        push(ee, ivs[i][1])
        i = i + 1
    let a = 1
    while a < len(ss)
        let ks = ss[a]
        let ke = ee[a]
        let b = a - 1
        while b >= 0 and (ss[b] > ks or (ss[b] == ks and ee[b] > ke))
            ss[b + 1] = ss[b]
            ee[b + 1] = ee[b]
            b = b - 1
        ss[b + 1] = ks
        ee[b + 1] = ke
        a = a + 1
    let out = ""
    let j = 0
    while j < len(ss)
        if j > 0
            out = out + " "
        out = out + str(ss[j]) + "-" + str(ee[j])
        j = j + 1
    out

// brute force: intervals overlapping [qs,qe]
fn brute(ivs: list, qs: int, qe: int) -> list
    let out = []
    let i = 0
    while i < len(ivs)
        if ivs[i][0] <= qe and ivs[i][1] >= qs
            push(out, ivs[i])
        i = i + 1
    out

fn main()
    let fails = 0

    let ivs = []
    push(ivs, [1, 5])
    push(ivs, [3, 7])
    push(ivs, [10, 15])
    push(ivs, [12, 20])
    push(ivs, [8, 9])
    let tree = itree_build(ivs)

    // point stabbing
    fails = fails + expect("stab6", render_sorted(itree_stab(tree, 6)), "3-7")
    fails = fails + expect("stab4", render_sorted(itree_stab(tree, 4)), "1-5 3-7")
    fails = fails + expect("stab13", render_sorted(itree_stab(tree, 13)), "10-15 12-20")
    fails = fails + expect("stab_none", render_sorted(itree_stab(tree, 0)), "")

    // range overlap
    fails = fails + expect("ov_9_11", render_sorted(itree_overlap(tree, 9, 11)), "8-9 10-15")
    fails = fails + expect("ov_all", render_sorted(itree_overlap(tree, 0, 100)), "1-5 3-7 8-9 10-15 12-20")
    fails = fails + expect("ov_none", render_sorted(itree_overlap(tree, 21, 30)), "")

    // brute-force cross-check over many queries
    let ok = 1
    let qs = 0 - 2
    while qs <= 22
        let qe = qs
        while qe <= 22
            if render_sorted(itree_overlap(tree, qs, qe)) != render_sorted(brute(ivs, qs, qe))
                ok = 0
            qe = qe + 1
        qs = qs + 1
    fails = fails + expect("brute_cross", str(ok), "1")

    // overlapping/nested intervals cross-check
    let ivs2 = []
    push(ivs2, [1, 100])
    push(ivs2, [5, 10])
    push(ivs2, [50, 60])
    push(ivs2, [8, 55])
    push(ivs2, [90, 95])
    let t2 = itree_build(ivs2)
    let ok2 = 1
    let a = 0
    while a <= 105
        if render_sorted(itree_stab(t2, a)) != render_sorted(brute(ivs2, a, a))
            ok2 = 0
        a = a + 1
    fails = fails + expect("brute_cross2", str(ok2), "1")

    if fails == 0
        print("forge_intervaltree: all passed")
    else
        print("forge_intervaltree: " + str(fails) + " FAILED")
