import forge_kfold

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name)
    1

fn join_ints(lst) -> string
    let parts = []
    let i = 0
    while i < len(lst)
        push(parts, str(lst[i]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // 10 items, 5 folds: fold 0 test = [0,1], fold 2 test = [4,5]
    fails = fails + expect("f0_test", join_ints(kfold_test_indices(10, 5, 0)), "0,1")
    fails = fails + expect("f2_test", join_ints(kfold_test_indices(10, 5, 2)), "4,5")
    fails = fails + expect("f4_test", join_ints(kfold_test_indices(10, 5, 4)), "8,9")

    // fold 0 split: train = [2..9]
    let s0 = kfold_split(10, 5, 0)
    fails = fails + expect("f0_train", join_ints(s0[0]), "2,3,4,5,6,7,8,9")
    fails = fails + expect("f0_sizes", str(len(s0[0])) + "/" + str(len(s0[1])), "8/2")

    // remainder: 11 items, 5 folds -> sizes [3,2,2,2,2], fold 0 test = [0,1,2]
    fails = fails + expect("rem_f0", join_ints(kfold_test_indices(11, 5, 0)), "0,1,2")
    fails = fails + expect("rem_f1", join_ints(kfold_test_indices(11, 5, 1)), "3,4")

    // partition property: every index in exactly one test fold, folds cover all n
    let covered = {}
    let dup = false
    let f = 0
    while f < 5
        let ti = kfold_test_indices(10, 5, f)
        let i = 0
        while i < len(ti)
            let key = str(ti[i])
            if contains(covered, key)
                dup = true
            covered[key] = 1
            i = i + 1
        f = f + 1
    fails = fails + expect_true("no_dup", dup == false)
    fails = fails + expect("covers_all", str(len(keys(covered))), "10")

    // train_test_split: 20% of 10 = 2 test, 8 train, disjoint, union covers all
    let tt = train_test_split(10, 0.2, 42)
    fails = fails + expect("tt_sizes", str(len(tt[0])) + "/" + str(len(tt[1])), "8/2")
    // reproducible: same seed -> same split
    let tt2 = train_test_split(10, 0.2, 42)
    fails = fails + expect("tt_reproducible", join_ints(tt[1]), join_ints(tt2[1]))
    // different seed -> (very likely) different order; check union still covers all
    let allset = {}
    let a = 0
    while a < len(tt[0])
        allset[str(tt[0][a])] = 1
        a = a + 1
    let b = 0
    while b < len(tt[1])
        allset[str(tt[1][b])] = 1
        b = b + 1
    fails = fails + expect("tt_covers_all", str(len(keys(allset))), "10")

    // shuffle is a permutation (all 10 distinct)
    let sh = shuffle_indices(10, 7)
    let shset = {}
    let c = 0
    while c < len(sh)
        shset[str(sh[c])] = 1
        c = c + 1
    fails = fails + expect("shuffle_perm", str(len(keys(shset))), "10")

    if fails == 0
        print("forge_kfold: all passed")
    else
        print("forge_kfold: " + str(fails) + " FAILED")
