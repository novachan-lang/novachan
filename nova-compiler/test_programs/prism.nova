// NOVA PRISM — minimal terminal UI helpers (framework 5 per strategy doc).
// v0.1 ships text-mode (ANSI escape) helpers because the target machine
// has no wgpu/Vulkan SDK installed; v0.2+ will add GPU-accelerated GUI
// rendering via FFI to wgpu. The API SHAPE is the same: build a frame
// string, write it to the screen.
//
// Public API (v0.1):
//   prism.clear()              -> ANSI "clear screen + home" sequence
//   prism.move(x, y)           -> ANSI cursor-to-position
//   prism.color_fg(r, g, b)    -> 24-bit foreground color escape
//   prism.color_bg(r, g, b)    -> 24-bit background color escape
//   prism.reset()              -> reset all attributes
//   prism.box(w, h)            -> ASCII-art box (w x h) as a string
//   prism.table(headers, rows) -> simple aligned table render

fn _esc() -> string
    chr(27) + "["

fn clear() -> string
    _esc() + "2J" + _esc() + "H"

fn move(x: int, y: int) -> string
    _esc() + str(y) + ";" + str(x) + "H"

fn color_fg(r: int, g: int, b: int) -> string
    _esc() + "38;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m"

fn color_bg(r: int, g: int, b: int) -> string
    _esc() + "48;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m"

fn reset() -> string
    _esc() + "0m"

fn _repeat_char(c: string, n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + c
        i = i + 1
    out

fn box(w: int, h: int) -> string
    let top = "+" + _repeat_char("-", w - 2) + "+\n"
    let middle = "|" + _repeat_char(" ", w - 2) + "|\n"
    let out = top
    let i = 1
    while i < h - 1
        out = out + middle
        i = i + 1
    out = out + "+" + _repeat_char("-", w - 2) + "+\n"
    out

fn _max_int(a: int, b: int) -> int
    if a > b
        return a
    b

fn table(headers: list, rows: list) -> string
    let cols = len(headers)
    let widths = []
    let ci = 0
    while ci < cols
        widths.push(len(headers[ci]))
        ci = ci + 1
    for row in rows
        let i = 0
        while i < cols and i < len(row)
            widths[i] = _max_int(widths[i], len(row[i]))
            i = i + 1
    let out = ""
    let i = 0
    while i < cols
        out = out + headers[i]
        let pad = widths[i] - len(headers[i]) + 2
        out = out + _repeat_char(" ", pad)
        i = i + 1
    out = out + "\n"
    let separator = ""
    let j = 0
    while j < cols
        separator = separator + _repeat_char("-", widths[j]) + "  "
        j = j + 1
    out = out + separator + "\n"
    for row in rows
        let k = 0
        while k < cols and k < len(row)
            out = out + row[k]
            let pad = widths[k] - len(row[k]) + 2
            out = out + _repeat_char(" ", pad)
            k = k + 1
        out = out + "\n"
    out

// ── v0.2 additions ───────────────────────────────────────────────────────

// Horizontal line of given width using the given character.
fn hline(w: int, ch: string) -> string
    _repeat_char(ch, w)

// Vertical line of given height (newline-separated).
fn vline(h: int, ch: string) -> string
    let out = ""
    let i = 0
    while i < h
        out = out + ch + "\n"
        i = i + 1
    out

// Progress bar: [#####-----] 50%.
fn progress_bar(pct: int, width: int) -> string
    let filled = (pct * width) / 100
    if filled < 0
        filled = 0
    if filled > width
        filled = width
    let out = "["
    out = out + _repeat_char("#", filled)
    out = out + _repeat_char("-", width - filled)
    out = out + "] " + str(pct) + "%"
    out

// Spinner frame at index i (rotates through |, /, -, \).
fn spinner(i: int) -> string
    let frames = ["|", "/", "-", "\\"]
    frames[i % 4]

// Bold/italic/underline wrappers using ANSI SGR.
fn bold(s: string) -> string
    _esc() + "1m" + s + _esc() + "22m"

fn italic(s: string) -> string
    _esc() + "3m" + s + _esc() + "23m"

fn underline(s: string) -> string
    _esc() + "4m" + s + _esc() + "24m"

// Hyperlink (OSC 8). Terminal-emulator dependent; falls back gracefully.
fn link(url: string, label: string) -> string
    chr(27) + "]8;;" + url + chr(7) + label + chr(27) + "]8;;" + chr(7)
