import forge_pascal

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn join_ints(lst) -> string
    let parts = []
    let i = 0
    while i < len(lst)
        push(parts, str(lst[i]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0

    // known rows
    fails = fails + expect("row0", join_ints(pascal_row(0)), "1")
    fails = fails + expect("row1", join_ints(pascal_row(1)), "1,1")
    fails = fails + expect("row4", join_ints(pascal_row(4)), "1,4,6,4,1")
    fails = fails + expect("row6", join_ints(pascal_row(6)), "1,6,15,20,15,6,1")

    // triangle
    let t = pascal_triangle(5)
    fails = fails + expect("tri_count", str(len(t)), "5")
    fails = fails + expect("tri_row2", join_ints(t[2]), "1,2,1")
    fails = fails + expect("tri_row4", join_ints(t[4]), "1,4,6,4,1")

    // pascal_value = C(n,k)
    fails = fails + expect("val_5_2", str(pascal_value(5, 2)), "10")
    fails = fails + expect("val_10_5", str(pascal_value(10, 5)), "252")
    fails = fails + expect("val_edge", str(pascal_value(7, 0)), "1")
    fails = fails + expect("val_oor", str(pascal_value(5, 6)), "0")
    fails = fails + expect("val_symm", str(pascal_value(6, 4)), "15")

    // each interior entry is the sum of the two above (Pascal's rule)
    let r5 = pascal_row(5)
    let r6 = pascal_row(6)
    let rule_ok = true
    let k = 1
    while k < len(r6) - 1
        if r6[k] != r5[k - 1] + r5[k]
            rule_ok = false
        k = k + 1
    let rule_str = "ok"
    if rule_ok == false
        rule_str = "BAD"
    fails = fails + expect("pascal_rule", rule_str, "ok")

    // row sum = 2^n
    fails = fails + expect("rowsum_4", str(pascal_row_sum(4)), "16")
    fails = fails + expect("rowsum_10", str(pascal_row_sum(10)), "1024")

    if fails == 0
        print("forge_pascal: all passed")
    else
        print("forge_pascal: " + str(fails) + " FAILED")
