// ══════════════════════════════════════════════════════════════════════════════
// unitext — Unicode canonical (NFC/NFD-aware) string equality for NOVA (#39)
//
// The runtime has normalize_nfc / normalize_nfd, but `==` compares raw bytes, so two
// canonically-equivalent strings ("é" precomposed U+00E9  vs  "e"+U+0301) are NOT ==.
// unitext provides EXPLICIT canonical comparison.
//
// Why not make `==` auto-normalize? That would run an O(n) normalization pass on every
// string comparison in the language — a hidden cost on the hot path, against NOVA's
// "no hidden costs" principle — and silently change `==` semantics. So canonical
// equality is opt-in and explicit here (the cost is visible where you ask for it).
//
//   unitext.nfc_eq(a, b)   // true if a and b are canonically equivalent (NFC)
//   unitext.canon_eq(a, b) // recommended default (alias for nfc_eq)
// ══════════════════════════════════════════════════════════════════════════════

fn nfc(s: string) -> string
    normalize_nfc(s)

fn nfd(s: string) -> string
    normalize_nfd(s)

// canonically equivalent under NFC (the recommended form). True when a and b denote
// the same abstract text even if their byte encodings differ.
fn nfc_eq(a: string, b: string) -> int
    if normalize_nfc(a) == normalize_nfc(b)
        return 1
    0

// canonical equivalence checked via the fully-decomposed form (same result as nfc_eq
// for canonical equivalence; provided for callers that work in NFD).
fn nfd_eq(a: string, b: string) -> int
    if normalize_nfd(a) == normalize_nfd(b)
        return 1
    0

// recommended default canonical equality
fn canon_eq(a: string, b: string) -> int
    nfc_eq(a, b)

// is the string already in NFC (no normalization would change it)?
fn is_nfc(s: string) -> int
    if normalize_nfc(s) == s
        return 1
    0

// is the string already in NFD?
fn is_nfd(s: string) -> int
    if normalize_nfd(s) == s
        return 1
    0

// caseless canonical equality: fold ASCII case then compare canonically. (Full
// Unicode caseless folding is casefoldx.casefold; this covers the common ASCII case
// without a cross-module dependency.)
fn ci_canon_eq(a: string, b: string) -> int
    if normalize_nfc(lower(a)) == normalize_nfc(lower(b))
        return 1
    0

fn main()
    assert(nfc_eq("hello", "hello") == 1, "same strings equal")
    assert(is_nfc("hello") == 1, "ascii is nfc")
    print("unitext: passed")
