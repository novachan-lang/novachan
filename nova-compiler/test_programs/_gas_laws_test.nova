// _gas_laws_test.nova — KAT for std/chem/gas_laws
//
// Known answers:
//   boyles_p2(100.0, 2.0, 4.0)  = 100*2/4 = 50.0
//   charles_v2(1.0, 300.0, 600.0) = 1.0*600/300 = 2.0
//   ideal_gas_pressure(1.0, 273.0, 22.4) = 1*8.314*273/22.4 = 101.33... (reasonable ~100 Pa)
//   ideal_gas_volume(1.0, 273.0, 101325.0) = 1*8.314*273/101325 ≈ 0.02241 m^3
//   combined_gas(100.0, 2.0, 300.0, 600.0, 200.0) = 100*2*600/(300*200) = 2.0

import std/chem/gas_laws

fn approx(a, b, tol)
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    if ad > tol
        print("FAIL approx: got " + str(a) + " expected " + str(b) + " tol " + str(tol))
        exit(1)
    return 0

fn approx_rel(a, b, rel_tol)
    let d = a - b
    let ad = d
    if d < 0.0
        ad = 0.0 - d
    let ref_b = b
    if ref_b < 0.0
        ref_b = 0.0 - ref_b
    let threshold = ref_b * rel_tol
    if ad > threshold
        print("FAIL approx_rel: got " + str(a) + " expected " + str(b) + " rel " + str(rel_tol))
        exit(1)
    return 0

fn main()
    // KAT 1: Boyle's law P2 = P1*V1/V2 = 100*2/4 = 50.0
    let v1 = boyles_p2(100.0, 2.0, 4.0)
    approx(v1, 50.0, 0.001)

    // KAT 2: Charles's law V2 = V1*T2/T1 = 1.0*600/300 = 2.0
    let v2 = charles_v2(1.0, 300.0, 600.0)
    approx(v2, 2.0, 0.001)

    // KAT 3: ideal_gas_pressure(1.0, 273.0, 22.4) = 1*8.314*273/22.4 ~ 101.33
    let v3 = ideal_gas_pressure(1.0, 273.0, 22.4)
    approx_rel(v3, 101.33, 0.01)

    // KAT 4: ideal_gas_volume(1.0, 273.0, 101325.0) ~ 0.02241 m^3
    let v4 = ideal_gas_volume(1.0, 273.0, 101325.0)
    approx_rel(v4, 0.02241, 0.01)

    // KAT 5: combined_gas P1=100,V1=2,T1=300,T2=600,P2=200 -> V2=100*2*600/(300*200)=2.0
    let v5 = combined_gas(100.0, 2.0, 300.0, 600.0, 200.0)
    approx(v5, 2.0, 0.001)

    // KAT 6: R() returns 8.314
    let v6 = R()
    approx(v6, 8.314, 0.0001)

    print("PASS _gas_laws_test")
