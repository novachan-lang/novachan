// KAT for std/time/cron — 5-field cron expression parser + matcher + next-fire
// + describe. (Superseded the old raw-string-field API with the expanded
// value-list API; see _kat_cron.nova for the fuller adversarial suite.)
import std/time/cron

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // ── cron_parse KATs ───────────────────────────────────────────────────────
    let p = cron_parse("0 12 * * *")
    cki("parse-min-count", len(p["minute"]), 1)
    cki("parse-min-0", p["minute"][0], 0)
    cki("parse-hour-count", len(p["hour"]), 1)
    cki("parse-hour-0", p["hour"][0], 12)
    cki("parse-dom-count", len(p["day_of_month"]), 31)
    cki("parse-month-count", len(p["month"]), 12)
    cki("parse-dow-count", len(p["day_of_week"]), 7)

    let p2 = cron_parse("*/5 0-6 1,15 3 1")
    cki("parse2-min-count", len(p2["minute"]), 12)
    cki("parse2-hour-count", len(p2["hour"]), 7)
    cki("parse2-dom-count", len(p2["day_of_month"]), 2)
    cki("parse2-dom-0", p2["day_of_month"][0], 1)
    cki("parse2-dom-1", p2["day_of_month"][1], 15)
    cki("parse2-month-count", len(p2["month"]), 1)
    cki("parse2-month-0", p2["month"][0], 3)
    cki("parse2-dow-count", len(p2["day_of_week"]), 1)
    cki("parse2-dow-0", p2["day_of_week"][0], 1)

    // ── cron_matches KATs ─────────────────────────────────────────────────────
    // "0 12 * * *" = noon every day.
    let noon = cron_parse("0 12 * * *")
    ckb("cm-noon-yes",  cron_matches(noon, 0,  12, 5, 6, 3), true)
    ckb("cm-noon-no",   cron_matches(noon, 30, 12, 5, 6, 3), false)
    ckb("cm-noon-hr",   cron_matches(noon, 0,  11, 5, 6, 3), false)

    // "*/15 * * * *" = every 15 minutes.
    let every15 = cron_parse("*/15 * * * *")
    ckb("cm-15m-0",   cron_matches(every15, 0,  9, 1, 1, 1), true)
    ckb("cm-15m-30",  cron_matches(every15, 30, 9, 1, 1, 1), true)
    ckb("cm-15m-31",  cron_matches(every15, 31, 9, 1, 1, 1), false)

    // "0 0 1 1 *" = midnight on Jan 1st.
    let jan1 = cron_parse("0 0 1 1 *")
    ckb("cm-jan1-yes", cron_matches(jan1, 0, 0, 1, 1, 3), true)
    ckb("cm-jan1-dom", cron_matches(jan1, 0, 0, 2, 1, 3), false)
    ckb("cm-jan1-mon", cron_matches(jan1, 0, 0, 1, 2, 3), false)

    // "30 8 * * 1" = Monday 8:30 AM.
    let mon830 = cron_parse("30 8 * * 1")
    ckb("cm-mon830-yes",  cron_matches(mon830, 30, 8, 15, 4, 1), true)
    ckb("cm-mon830-dow",  cron_matches(mon830, 30, 8, 15, 4, 2), false)
    ckb("cm-mon830-min",  cron_matches(mon830, 0,  8, 15, 4, 1), false)

    // ── cron_next / cron_describe smoke KATs ─────────────────────────────────
    let nxt = cron_next(every15, 2026, 1, 1, 9, 0)
    cki("next-15m-minute", nxt["minute"], 15)
    cki("next-15m-hour", nxt["hour"], 9)

    cks("describe-15m", cron_describe("*/15 * * * *"), "every 15 minutes")

    print("_cron_test passed")
