// KAT for std/time/cron — minimal 5-field cron expression matcher.
import std/time/cron

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    if got
        gi = 1
    let wi = 0
    if want
        wi = 1
    if gi != wi
        let gs = "false"
        if got
            gs = "true"
        let ws = "false"
        if want
            ws = "true"
        print("FAIL " + label + ": got=" + gs + " want=" + ws)
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // ── cron_field_matches KATs ───────────────────────────────────────────────

    // Wildcard: * matches anything.
    ckb("wildcard-5",  cron_field_matches("*", 5),  true)
    ckb("wildcard-0",  cron_field_matches("*", 0),  true)
    ckb("wildcard-59", cron_field_matches("*", 59), true)

    // Exact number.
    ckb("exact-match",   cron_field_matches("5", 5), true)
    ckb("exact-nomatch", cron_field_matches("5", 6), false)
    ckb("exact-zero",    cron_field_matches("0", 0), true)

    // Comma list.
    ckb("list-match",   cron_field_matches("1,3,5", 3), true)
    ckb("list-nomatch", cron_field_matches("1,3,5", 4), false)
    ckb("list-first",   cron_field_matches("1,3,5", 1), true)
    ckb("list-last",    cron_field_matches("1,3,5", 5), true)

    // Range a-b.
    ckb("range-mid",    cron_field_matches("10-20", 15), true)
    ckb("range-nomatch",cron_field_matches("10-20", 25), false)
    ckb("range-lo",     cron_field_matches("10-20", 10), true)
    ckb("range-hi",     cron_field_matches("10-20", 20), true)
    ckb("range-below",  cron_field_matches("10-20", 9),  false)

    // Step */n.
    ckb("step-match",   cron_field_matches("*/15", 30), true)
    ckb("step-nomatch", cron_field_matches("*/15", 31), false)
    ckb("step-zero",    cron_field_matches("*/15", 0),  true)
    ckb("step-15",      cron_field_matches("*/15", 15), true)
    ckb("step-45",      cron_field_matches("*/15", 45), true)
    ckb("step-1-match", cron_field_matches("*/1",  7),  true)

    // ── cron_parse KATs ───────────────────────────────────────────────────────
    let p = cron_parse("0 12 * * *")
    cks("parse-min",   p["min"],   "0")
    cks("parse-hour",  p["hour"],  "12")
    cks("parse-dom",   p["dom"],   "*")
    cks("parse-month", p["month"], "*")
    cks("parse-dow",   p["dow"],   "*")

    let p2 = cron_parse("*/5 0-6 1,15 3 1")
    cks("parse2-min",   p2["min"],   "*/5")
    cks("parse2-hour",  p2["hour"],  "0-6")
    cks("parse2-dom",   p2["dom"],   "1,15")
    cks("parse2-month", p2["month"], "3")
    cks("parse2-dow",   p2["dow"],   "1")

    // ── cron_matches KATs ─────────────────────────────────────────────────────
    // "0 12 * * *" = noon every day.
    ckb("cm-noon-yes",  cron_matches("0 12 * * *", 0,  12, 5, 6, 3), true)
    ckb("cm-noon-no",   cron_matches("0 12 * * *", 30, 12, 5, 6, 3), false)
    ckb("cm-noon-hr",   cron_matches("0 12 * * *", 0,  11, 5, 6, 3), false)

    // "*/15 * * * *" = every 15 minutes.
    ckb("cm-15m-0",   cron_matches("*/15 * * * *", 0,  9, 1, 1, 1), true)
    ckb("cm-15m-30",  cron_matches("*/15 * * * *", 30, 9, 1, 1, 1), true)
    ckb("cm-15m-31",  cron_matches("*/15 * * * *", 31, 9, 1, 1, 1), false)

    // "0 0 1 1 *" = midnight on Jan 1st.
    ckb("cm-jan1-yes", cron_matches("0 0 1 1 *", 0, 0, 1, 1, 3), true)
    ckb("cm-jan1-dom", cron_matches("0 0 1 1 *", 0, 0, 2, 1, 3), false)
    ckb("cm-jan1-mon", cron_matches("0 0 1 1 *", 0, 0, 1, 2, 3), false)

    // "30 8 * * 1" = Monday 8:30 AM.
    ckb("cm-mon830-yes",  cron_matches("30 8 * * 1", 30, 8, 15, 4, 1), true)
    ckb("cm-mon830-dow",  cron_matches("30 8 * * 1", 30, 8, 15, 4, 2), false)
    ckb("cm-mon830-min",  cron_matches("30 8 * * 1", 0,  8, 15, 4, 1), false)

    print("_cron_test passed")
