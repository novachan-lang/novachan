// KAT test for std/text/lcs
import std/text/lcs

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn ckf(label, got, expected, eps)
    let diff = got - expected
    if diff < 0.0
        diff = 0.0 - diff
    if diff > eps
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT 1: classic ABCBDAB / BDCAB -> LCS length 4
    let r1 = lcs_length("ABCBDAB", "BDCAB")
    cki("lcs_length ABCBDAB/BDCAB", r1, 4)

    // KAT 2: identical strings -> LCS = full length
    let r2 = lcs_length("abc", "abc")
    cki("lcs_length abc/abc", r2, 3)

    // KAT 3: disjoint alphabets -> LCS = 0
    let r3 = lcs_length("abc", "xyz")
    cki("lcs_length abc/xyz", r3, 0)

    // KAT 4: AGGTAB / GXTXAYB -> LCS length 4
    let r4 = lcs_length("AGGTAB", "GXTXAYB")
    cki("lcs_length AGGTAB/GXTXAYB", r4, 4)

    // KAT 5: empty string -> LCS = 0
    let r5 = lcs_length("", "abc")
    cki("lcs_length empty/abc", r5, 0)

    // KAT 6: lcs_string length matches lcs_length
    let s6 = lcs_string("ABCBDAB", "BDCAB")
    let l6 = len(s6)
    cki("lcs_string len ABCBDAB/BDCAB", l6, 4)

    // KAT 7: lcs_similarity identical strings
    let f7 = lcs_similarity("abc", "abc")
    ckf("lcs_similarity identical", f7, 1.0, 0.001)

    // KAT 8: lcs_similarity disjoint
    let f8 = lcs_similarity("abc", "xyz")
    ckf("lcs_similarity disjoint", f8, 0.0, 0.001)

    // KAT 9: lcs_similarity both empty -> 0.0
    let f9 = lcs_similarity("", "")
    ckf("lcs_similarity both empty", f9, 0.0, 0.001)

    // KAT 10: lcs_string reconstructed string chars all appear in order in both inputs
    let s10 = lcs_string("AGGTAB", "GXTXAYB")
    let l10 = len(s10)
    cki("lcs_string len AGGTAB/GXTXAYB", l10, 4)

    print("_lcs_test passed")
