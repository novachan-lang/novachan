import forge_combinatorics

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // factorial
    fails = fails + expect("f0", str(factorial(0)), "1")
    fails = fails + expect("f1", str(factorial(1)), "1")
    fails = fails + expect("f5", str(factorial(5)), "120")
    fails = fails + expect("f10", str(factorial(10)), "3628800")
    fails = fails + expect("f20", str(factorial(20)), "2432902008176640000")
    fails = fails + expect("f_neg", str(factorial(-3)), "0")

    // permutations
    fails = fails + expect("p52", str(n_perm(5, 2)), "20")
    fails = fails + expect("p10_3", str(n_perm(10, 3)), "720")
    fails = fails + expect("p_n0", str(n_perm(9, 0)), "1")
    fails = fails + expect("p_full", str(n_perm(5, 5)), "120")
    fails = fails + expect("p_over", str(n_perm(3, 5)), "0")

    // combinations (the exact multiplicative core)
    fails = fails + expect("c6_2", str(n_choose(6, 2)), "15")
    fails = fails + expect("c10_3", str(n_choose(10, 3)), "120")
    fails = fails + expect("c10_5", str(n_choose(10, 5)), "252")
    fails = fails + expect("c20_10", str(n_choose(20, 10)), "184756")
    fails = fails + expect("c52_5", str(n_choose(52, 5)), "2598960")
    fails = fails + expect("c_symm", str(n_choose(52, 47)), "2598960")
    fails = fails + expect("c_edge0", str(n_choose(10, 0)), "1")
    fails = fails + expect("c_edgen", str(n_choose(10, 10)), "1")
    fails = fails + expect("c_over", str(n_choose(5, 8)), "0")

    // multichoose
    fails = fails + expect("mc3_2", str(n_multichoose(3, 2)), "6")
    fails = fails + expect("mc5_3", str(n_multichoose(5, 3)), "35")

    // catalan
    fails = fails + expect("cat0", str(catalan(0)), "1")
    fails = fails + expect("cat1", str(catalan(1)), "1")
    fails = fails + expect("cat2", str(catalan(2)), "2")
    fails = fails + expect("cat3", str(catalan(3)), "5")
    fails = fails + expect("cat4", str(catalan(4)), "14")
    fails = fails + expect("cat5", str(catalan(5)), "42")
    fails = fails + expect("cat10", str(catalan(10)), "16796")

    if fails == 0
        print("forge_combinatorics: all passed")
    else
        print("forge_combinatorics: " + str(fails) + " FAILED")
