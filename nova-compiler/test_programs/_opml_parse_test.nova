// KAT test for std/data/opml_parse — OPML parser
import std/data/opml_parse

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // ── KAT 1: spec vector — nested outline ──────────────────────────────────
    let dq = chr(34)
    let xml1 = "<opml><head><title>Subs</title></head><body><outline text=" + dq + "Tech" + dq + "><outline text=" + dq + "NOVA" + dq + " xmlUrl=" + dq + "http://x/f" + dq + "/></outline></body></opml>"
    let doc1 = opml_parse(xml1)
    cks("kat1-title", doc1["title"], "Subs")
    let tops = doc1["outlines"]
    cki("kat1-top-count", len(tops), 1)
    let tech = tops[0]
    cks("kat1-tech-text", tech["text"], "Tech")
    let techkids = tech["children"]
    cki("kat1-tech-children-count", len(techkids), 1)
    let nova_outline = techkids[0]
    cks("kat1-nova-text", nova_outline["text"], "NOVA")
    cks("kat1-nova-xmlUrl", nova_outline["xmlUrl"], "http://x/f")
    cki("kat1-nova-no-children", len(nova_outline["children"]), 0)
    print("KAT 1 PASS: spec vector nested outline")

    // ── KAT 2: multiple top-level outlines ───────────────────────────────────
    let xml2 = "<opml><head><title>Feeds</title></head><body><outline text=" + dq + "A" + dq + " xmlUrl=" + dq + "http://a" + dq + "/><outline text=" + dq + "B" + dq + " xmlUrl=" + dq + "http://b" + dq + "/></body></opml>"
    let doc2 = opml_parse(xml2)
    cks("kat2-title", doc2["title"], "Feeds")
    let tops2 = doc2["outlines"]
    cki("kat2-count", len(tops2), 2)
    cks("kat2-a-text", tops2[0]["text"], "A")
    cks("kat2-a-xmlUrl", tops2[0]["xmlUrl"], "http://a")
    cks("kat2-b-text", tops2[1]["text"], "B")
    cks("kat2-b-xmlUrl", tops2[1]["xmlUrl"], "http://b")
    print("KAT 2 PASS: multiple top-level outlines")

    // ── KAT 3: outline without xmlUrl ────────────────────────────────────────
    let xml3 = "<opml><head><title>Cat</title></head><body><outline text=" + dq + "Category" + dq + "></outline></body></opml>"
    let doc3 = opml_parse(xml3)
    cks("kat3-title", doc3["title"], "Cat")
    let tops3 = doc3["outlines"]
    cki("kat3-count", len(tops3), 1)
    cks("kat3-text", tops3[0]["text"], "Category")
    cks("kat3-xmlUrl-empty", tops3[0]["xmlUrl"], "")
    cki("kat3-children-count", len(tops3[0]["children"]), 0)
    print("KAT 3 PASS: outline without xmlUrl")

    // ── KAT 4: empty body ────────────────────────────────────────────────────
    let xml4 = "<opml><head><title>Empty</title></head><body></body></opml>"
    let doc4 = opml_parse(xml4)
    cks("kat4-title", doc4["title"], "Empty")
    cki("kat4-count", len(doc4["outlines"]), 0)
    print("KAT 4 PASS: empty body")

    // ── KAT 5: title extraction ───────────────────────────────────────────────
    let xml5 = "<opml version=" + dq + "2.0" + dq + "><head><title>My Subs</title></head><body></body></opml>"
    let doc5 = opml_parse(xml5)
    cks("kat5-title", doc5["title"], "My Subs")
    print("KAT 5 PASS: title with version attribute on opml tag")

    print("PASS _opml_parse_test")
