// _progression_test.nova — KAT for std/music/progression
//
// Known-answer tests for Roman-numeral chord progressions in a major key.
//
// HAND-VERIFIED VECTORS (C major, key_root = 60 = C4)
//   Major scale offsets: I=0, ii=2, iii=4, IV=5, V=7, vi=9, vii=11
//
//   roman_to_root(60,"I")   = 60 + 0  = 60
//   roman_to_root(60,"ii")  = 60 + 2  = 62
//   roman_to_root(60,"iii") = 60 + 4  = 64
//   roman_to_root(60,"IV")  = 60 + 5  = 65
//   roman_to_root(60,"V")   = 60 + 7  = 67
//   roman_to_root(60,"vi")  = 60 + 9  = 69
//   roman_to_root(60,"vii") = 60 + 11 = 71
//
//   roman_to_chord(60,"I")   major: 60+[0,4,7] = [60,64,67]
//   roman_to_chord(60,"ii")  minor: 62+[0,3,7] = [62,65,69]
//   roman_to_chord(60,"iii") minor: 64+[0,3,7] = [64,67,71]
//   roman_to_chord(60,"IV")  major: 65+[0,4,7] = [65,69,72]
//   roman_to_chord(60,"V")   major: 67+[0,4,7] = [67,71,74]
//   roman_to_chord(60,"vi")  minor: 69+[0,3,7] = [69,72,76]
//   roman_to_chord(60,"vii") dim:   71+[0,3,6] = [71,74,77]
//
//   roman_quality: I/IV/V="major", ii/iii/vi="minor", vii="dim"
//
//   progression(60,["I","IV","V"]) = [[60,64,67],[65,69,72],[67,71,74]]

import std/music/progression

// ── check helpers ─────────────────────────────────────────────────────────────

fn cks(label, got, want)
    if got != want
        print("FAIL progression " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL progression " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_list(label, got, want)
    let ok = 1
    if len(got) != len(want)
        ok = 0
    else
        let i = 0
        while i < len(got)
            if got[i] != want[i]
                ok = 0
            i = i + 1
    if ok == 0
        let gs = "["
        let i = 0
        while i < len(got)
            if i > 0
                gs = gs + ","
            gs = gs + str(got[i])
            i = i + 1
        gs = gs + "]"
        let ws = "["
        let i2 = 0
        while i2 < len(want)
            if i2 > 0
                ws = ws + ","
            ws = ws + str(want[i2])
            i2 = i2 + 1
        ws = ws + "]"
        print("FAIL progression " + label + ": got=" + gs + " want=" + ws)
        exit(1)

// ── main ─────────────────────────────────────────────────────────────────────

fn main()
    // ── roman_to_root (spec KAT) ──────────────────────────────────────────────

    cki("roman_to_root(60,I)",   roman_to_root(60, "I"),   60)
    cki("roman_to_root(60,IV)",  roman_to_root(60, "IV"),  65)
    cki("roman_to_root(60,V)",   roman_to_root(60, "V"),   67)
    cki("roman_to_root(60,vi)",  roman_to_root(60, "vi"),  69)

    // Additional degree roots in C major.
    cki("roman_to_root(60,ii)",  roman_to_root(60, "ii"),  62)
    cki("roman_to_root(60,iii)", roman_to_root(60, "iii"), 64)
    cki("roman_to_root(60,vii)", roman_to_root(60, "vii"), 71)

    // Unknown returns -1.
    cki("roman_to_root(60,VIII)", roman_to_root(60, "VIII"), -1)
    cki("roman_to_root(60,)",     roman_to_root(60, ""),     -1)

    // Different key: G major (key_root = 67 = G4).
    // V of G major = D = 67 + 7 = 74
    cki("roman_to_root(67,V)", roman_to_root(67, "V"), 74)
    // IV of G major = C = 67 + 5 = 72
    cki("roman_to_root(67,IV)", roman_to_root(67, "IV"), 72)

    // ── roman_quality ─────────────────────────────────────────────────────────

    cks("roman_quality(I)",   roman_quality("I"),   "major")
    cks("roman_quality(IV)",  roman_quality("IV"),  "major")
    cks("roman_quality(V)",   roman_quality("V"),   "major")
    cks("roman_quality(ii)",  roman_quality("ii"),  "minor")
    cks("roman_quality(iii)", roman_quality("iii"), "minor")
    cks("roman_quality(vi)",  roman_quality("vi"),  "minor")
    cks("roman_quality(vii)", roman_quality("vii"), "dim")
    cks("roman_quality(X)",   roman_quality("X"),   "unknown")

    // ── roman_to_chord (spec KAT) ─────────────────────────────────────────────

    // KAT: roman_to_chord(60,"V") == [67,71,74]
    let v_want = []
    push(v_want, 67)
    push(v_want, 71)
    push(v_want, 74)
    ck_list("roman_to_chord(60,V)", roman_to_chord(60, "V"), v_want)

    // KAT: roman_to_chord(60,"I") == [60,64,67]
    let i_want = []
    push(i_want, 60)
    push(i_want, 64)
    push(i_want, 67)
    ck_list("roman_to_chord(60,I)", roman_to_chord(60, "I"), i_want)

    // ii chord: minor triad on D4 = 62 + [0,3,7] = [62,65,69]
    let ii_want = []
    push(ii_want, 62)
    push(ii_want, 65)
    push(ii_want, 69)
    ck_list("roman_to_chord(60,ii)", roman_to_chord(60, "ii"), ii_want)

    // iii chord: minor triad on E4 = 64 + [0,3,7] = [64,67,71]
    let iii_want = []
    push(iii_want, 64)
    push(iii_want, 67)
    push(iii_want, 71)
    ck_list("roman_to_chord(60,iii)", roman_to_chord(60, "iii"), iii_want)

    // IV chord: major triad on F4 = 65 + [0,4,7] = [65,69,72]
    let iv_want = []
    push(iv_want, 65)
    push(iv_want, 69)
    push(iv_want, 72)
    ck_list("roman_to_chord(60,IV)", roman_to_chord(60, "IV"), iv_want)

    // vi chord: minor triad on A4 = 69 + [0,3,7] = [69,72,76]
    let vi_want = []
    push(vi_want, 69)
    push(vi_want, 72)
    push(vi_want, 76)
    ck_list("roman_to_chord(60,vi)", roman_to_chord(60, "vi"), vi_want)

    // vii chord: dim triad on B4 = 71 + [0,3,6] = [71,74,77]
    let vii_want = []
    push(vii_want, 71)
    push(vii_want, 74)
    push(vii_want, 77)
    ck_list("roman_to_chord(60,vii)", roman_to_chord(60, "vii"), vii_want)

    // Unknown roman -> empty list.
    let unk = roman_to_chord(60, "IX")
    cki("roman_to_chord(60,IX) empty", len(unk), 0)

    // ── progression (spec KAT) ────────────────────────────────────────────────

    // KAT: progression(60, ["I","IV","V"]) has 3 chords; first == [60,64,67]
    let romans = []
    push(romans, "I")
    push(romans, "IV")
    push(romans, "V")
    let prog = progression(60, romans)

    cki("progression len", len(prog), 3)

    // First chord: I == [60,64,67]
    let p0 = prog[0]
    let p0_want = []
    push(p0_want, 60)
    push(p0_want, 64)
    push(p0_want, 67)
    ck_list("progression[0] I", p0, p0_want)

    // Second chord: IV == [65,69,72]
    let p1 = prog[1]
    let p1_want = []
    push(p1_want, 65)
    push(p1_want, 69)
    push(p1_want, 72)
    ck_list("progression[1] IV", p1, p1_want)

    // Third chord: V == [67,71,74]
    let p2 = prog[2]
    let p2_want = []
    push(p2_want, 67)
    push(p2_want, 71)
    push(p2_want, 74)
    ck_list("progression[2] V", p2, p2_want)

    // Extra progression: I-vi-IV-V (common pop progression)
    let romans2 = []
    push(romans2, "I")
    push(romans2, "vi")
    push(romans2, "IV")
    push(romans2, "V")
    let prog2 = progression(60, romans2)
    cki("progression2 len", len(prog2), 4)

    // I == [60,64,67]
    let p2_0 = prog2[0]
    ck_list("prog2[0] I", p2_0, p0_want)

    // vi == [69,72,76]
    let p2_1 = prog2[1]
    let vi2_want = []
    push(vi2_want, 69)
    push(vi2_want, 72)
    push(vi2_want, 76)
    ck_list("prog2[1] vi", p2_1, vi2_want)

    // Empty progression returns empty list.
    let empty_rom = []
    let empty_prog = progression(60, empty_rom)
    cki("progression empty len", len(empty_prog), 0)

    // progression in a different key: D major (key_root = 62)
    // I of D = 62, major: [62,66,69]
    // V of D = 69, major: [69,73,76]
    let romans3 = []
    push(romans3, "I")
    push(romans3, "V")
    let prog3 = progression(62, romans3)
    cki("D prog len", len(prog3), 2)

    let d_I_want = []
    push(d_I_want, 62)
    push(d_I_want, 66)
    push(d_I_want, 69)
    ck_list("D prog[0] I", prog3[0], d_I_want)

    let d_V_want = []
    push(d_V_want, 69)
    push(d_V_want, 73)
    push(d_V_want, 76)
    ck_list("D prog[1] V", prog3[1], d_V_want)

    print("PASS _progression_test")
