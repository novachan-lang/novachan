import std/collections/ostree

// Helper: check int equality, print FAIL and exit on mismatch.
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)
    return 0

// Build the tree with keys 10 20 30 40 50 (inserted in sorted order —
// worst-case for an unbalanced BST; AVL balancing must handle this).
let t = ost_new()
ost_insert(t, 10)
ost_insert(t, 20)
ost_insert(t, 30)
ost_insert(t, 40)
ost_insert(t, 50)

// KAT 1: ost_size == 5
cki("size", ost_size(t), 5)

// KAT 2: ost_select(t, 0) == 10  (0-th smallest)
cki("select0", ost_select(t, 0), 10)

// KAT 3: ost_select(t, 2) == 30  (2nd smallest)
cki("select2", ost_select(t, 2), 30)

// KAT 4: ost_select(t, 4) == 50  (4th smallest)
cki("select4", ost_select(t, 4), 50)

// KAT 5: ost_rank(t, 30) == 2  (10 and 20 are strictly less)
cki("rank30", ost_rank(t, 30), 2)

// KAT 6: ost_rank(t, 35) == 3  (10, 20, 30 strictly less)
cki("rank35", ost_rank(t, 35), 3)

// KAT 7: ost_rank(t, 10) == 0  (nothing strictly less than minimum)
cki("rank10", ost_rank(t, 10), 0)

// KAT 8: ost_contains(t, 40) == 1
cki("contains40", ost_contains(t, 40), 1)

// KAT 9: ost_contains(t, 99) == 0
cki("contains99", ost_contains(t, 99), 0)

// KAT 10: duplicate insert is a no-op — size stays 5
ost_insert(t, 30)
cki("size_after_dup", ost_size(t), 5)

// KAT 11: select still correct after duplicate no-op
cki("select1_after_dup", ost_select(t, 1), 20)

// KAT 12: rank of a value larger than all elements == size
cki("rank_beyond", ost_rank(t, 100), 5)

print("_ostree_test passed")
