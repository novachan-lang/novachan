// parsec.nova — Parser combinator library (typed, composable, zero new runtime)
// A parser = fn(input: string, pos: int) -> [ok: int, val: any, pos: int]
// ok=1 on success (val = parsed value, pos = new position)
// ok=0 on failure (val = error message, pos = original position)

fn p_ok(val, pos: int) -> list
    return [1, val, pos]

fn p_err(msg: string, pos: int) -> list
    return [0, msg, pos]

fn p_is_ok(r: list) -> int
    return r[0] == 1

fn p_val(r: list)
    return r[1]

fn p_pos(r: list) -> int
    return r[2]

// ── Primitive parsers ──────────────────────────────────────────────────────

fn p_char(input: string, pos: int, expected: string) -> list
    if pos < len(input) and input[pos:pos + 1] == expected
        return p_ok(expected, pos + 1)
    return p_err("expected '" + expected + "'", pos)

fn p_satisfy(input: string, pos: int, pred, desc: string) -> list
    if pos < len(input)
        let c = input[pos:pos + 1]
        if pred(c)
            return p_ok(c, pos + 1)
    return p_err("expected " + desc, pos)

fn p_string(input: string, pos: int, expected: string) -> list
    let elen = len(expected)
    if pos + elen <= len(input) and input[pos:pos + elen] == expected
        return p_ok(expected, pos + elen)
    return p_err("expected '" + expected + "'", pos)

fn p_eof(input: string, pos: int) -> list
    if pos >= len(input)
        return p_ok("", pos)
    return p_err("expected end of input", pos)

// ── Character class parsers ────────────────────────────────────────────────

fn _is_digit(c: string) -> int
    let o = ord(c)
    return o >= 48 and o <= 57

fn _is_alpha(c: string) -> int
    let o = ord(c)
    return (o >= 65 and o <= 90) or (o >= 97 and o <= 122)

fn _is_alnum(c: string) -> int
    return _is_alpha(c) or _is_digit(c)

fn _is_space(c: string) -> int
    return c == " " or c == "\t" or c == "\n" or c == "\r"

fn p_digit(input: string, pos: int) -> list
    return p_satisfy(input, pos, _is_digit, "digit")

fn p_alpha(input: string, pos: int) -> list
    return p_satisfy(input, pos, _is_alpha, "letter")

fn p_alnum(input: string, pos: int) -> list
    return p_satisfy(input, pos, _is_alnum, "alphanumeric")

fn p_space(input: string, pos: int) -> list
    return p_satisfy(input, pos, _is_space, "whitespace")

// ── Combinators ────────────────────────────────────────────────────────────

fn p_many(input: string, pos: int, parser) -> list
    let results = []
    let cur = pos
    while 1
        let r = parser(input, cur)
        if not p_is_ok(r)
            return p_ok(results, cur)
        push(results, p_val(r))
        cur = p_pos(r)

fn p_many1(input: string, pos: int, parser) -> list
    let first = parser(input, pos)
    if not p_is_ok(first)
        return first
    let results = [p_val(first)]
    let cur = p_pos(first)
    while 1
        let r = parser(input, cur)
        if not p_is_ok(r)
            return p_ok(results, cur)
        push(results, p_val(r))
        cur = p_pos(r)

fn p_optional(input: string, pos: int, parser) -> list
    let r = parser(input, pos)
    if p_is_ok(r)
        return r
    return p_ok("", pos)

fn p_or(input: string, pos: int, pa, pb) -> list
    let ra = pa(input, pos)
    if p_is_ok(ra)
        return ra
    return pb(input, pos)

fn p_or3(input: string, pos: int, pa, pb, pc) -> list
    let ra = pa(input, pos)
    if p_is_ok(ra)
        return ra
    let rb = pb(input, pos)
    if p_is_ok(rb)
        return rb
    return pc(input, pos)

fn p_seq2(input: string, pos: int, pa, pb) -> list
    let ra = pa(input, pos)
    if not p_is_ok(ra)
        return ra
    let rb = pb(input, p_pos(ra))
    if not p_is_ok(rb)
        return rb
    return p_ok([p_val(ra), p_val(rb)], p_pos(rb))

fn p_seq3(input: string, pos: int, pa, pb, pc) -> list
    let ra = pa(input, pos)
    if not p_is_ok(ra)
        return ra
    let rb = pb(input, p_pos(ra))
    if not p_is_ok(rb)
        return rb
    let rc = pc(input, p_pos(rb))
    if not p_is_ok(rc)
        return rc
    return p_ok([p_val(ra), p_val(rb), p_val(rc)], p_pos(rc))

fn p_map(input: string, pos: int, parser, f) -> list
    let r = parser(input, pos)
    if p_is_ok(r)
        return p_ok(f(p_val(r)), p_pos(r))
    return r

fn p_between(input: string, pos: int, open, parser, close) -> list
    let ro = open(input, pos)
    if not p_is_ok(ro)
        return ro
    let rm = parser(input, p_pos(ro))
    if not p_is_ok(rm)
        return rm
    let rc = close(input, p_pos(rm))
    if not p_is_ok(rc)
        return rc
    return p_ok(p_val(rm), p_pos(rc))

fn p_sep_by(input: string, pos: int, parser, sep) -> list
    let first = parser(input, pos)
    if not p_is_ok(first)
        return p_ok([], pos)
    let results = [p_val(first)]
    let cur = p_pos(first)
    while 1
        let rs = sep(input, cur)
        if not p_is_ok(rs)
            return p_ok(results, cur)
        let rn = parser(input, p_pos(rs))
        if not p_is_ok(rn)
            return p_ok(results, cur)
        push(results, p_val(rn))
        cur = p_pos(rn)

fn p_skip_spaces(input: string, pos: int) -> list
    let cur = pos
    while cur < len(input) and _is_space(input[cur:cur + 1])
        cur = cur + 1
    return p_ok("", cur)

// ── Derived parsers ────────────────────────────────────────────────────────

fn p_integer(input: string, pos: int) -> list
    let r = p_many1(input, pos, p_digit)
    if not p_is_ok(r)
        return p_err("expected integer", pos)
    let digits = p_val(r)
    let s = ""
    for d in digits
        s = s + d
    return p_ok(int(s), p_pos(r))

fn p_word(input: string, pos: int) -> list
    let r = p_many1(input, pos, p_alpha)
    if not p_is_ok(r)
        return p_err("expected word", pos)
    let chars = p_val(r)
    let s = ""
    for c in chars
        s = s + c
    return p_ok(s, p_pos(r))

fn p_identifier(input: string, pos: int) -> list
    let first = p_alpha(input, pos)
    if not p_is_ok(first)
        return p_err("expected identifier", pos)
    let s = p_val(first)
    let cur = p_pos(first)
    while cur < len(input) and (_is_alnum(input[cur:cur + 1]) or input[cur:cur + 1] == "_")
        s = s + input[cur:cur + 1]
        cur = cur + 1
    return p_ok(s, cur)

fn p_take_while(input: string, pos: int, pred) -> list
    let cur = pos
    while cur < len(input) and pred(input[cur:cur + 1])
        cur = cur + 1
    if cur == pos
        return p_err("expected at least one match", pos)
    return p_ok(input[pos:cur], cur)

fn p_take_until(input: string, pos: int, stop: string) -> list
    let cur = pos
    while cur < len(input) and input[cur:cur + 1] != stop
        cur = cur + 1
    return p_ok(input[pos:cur], cur)

// ── Tests ──────────────────────────────────────────────────────────────────

fn main()
    // p_char
    let r1 = p_char("abc", 0, "a")
    assert(p_is_ok(r1), "char a")
    assert(p_val(r1) == "a", "char val")
    assert(p_pos(r1) == 1, "char pos")

    let r2 = p_char("abc", 0, "b")
    assert(not p_is_ok(r2), "char fail")

    // p_string
    let r3 = p_string("hello world", 0, "hello")
    assert(p_is_ok(r3), "string match")
    assert(p_val(r3) == "hello", "string val")
    assert(p_pos(r3) == 5, "string pos")

    // p_digit
    let r4 = p_digit("3abc", 0)
    assert(p_is_ok(r4), "digit ok")
    assert(p_val(r4) == "3", "digit val")

    // p_many
    let r5 = p_many("aaa123", 0, p_alpha)
    assert(p_is_ok(r5), "many ok")
    assert(len(p_val(r5)) == 3, "many count")
    assert(p_pos(r5) == 3, "many pos")

    // p_many1 (fail case)
    let r6 = p_many1("123", 0, p_alpha)
    assert(not p_is_ok(r6), "many1 fail")

    // p_integer
    let r7 = p_integer("42abc", 0)
    assert(p_is_ok(r7), "int ok")
    assert(p_val(r7) == 42, "int val")
    assert(p_pos(r7) == 2, "int pos")

    // p_or
    let pa_w = fn(inp, p) p_string(inp, p, "world")
    let pa_h = fn(inp, p) p_string(inp, p, "hello")
    let r8 = p_or("hello", 0, pa_w, pa_h)
    assert(p_is_ok(r8), "or ok")
    assert(p_val(r8) == "hello", "or val")

    // p_seq2
    let pa_a = fn(inp, p) p_char(inp, p, "a")
    let pa_b = fn(inp, p) p_char(inp, p, "b")
    let r9 = p_seq2("ab", 0, pa_a, pa_b)
    assert(p_is_ok(r9), "seq2 ok")
    let s9 = p_val(r9)
    assert(s9[0] == "a", "seq2 fst")
    assert(s9[1] == "b", "seq2 snd")

    // p_between (parens)
    let pa_op = fn(inp, p) p_char(inp, p, "(")
    let pa_cl = fn(inp, p) p_char(inp, p, ")")
    let r10 = p_between("(42)", 0, pa_op, p_integer, pa_cl)
    assert(p_is_ok(r10), "between ok")
    assert(p_val(r10) == 42, "between val")

    // p_sep_by (comma-separated integers)
    let pa_comma = fn(inp, p) p_char(inp, p, ",")
    let r11 = p_sep_by("1,2,3", 0, p_integer, pa_comma)
    assert(p_is_ok(r11), "sep_by ok")
    let vals = p_val(r11)
    assert(len(vals) == 3, "sep_by count")
    assert(vals[0] == 1, "sep_by 0")
    assert(vals[1] == 2, "sep_by 1")
    assert(vals[2] == 3, "sep_by 2")

    // p_word
    let r12 = p_word("hello123", 0)
    assert(p_is_ok(r12), "word ok")
    assert(p_val(r12) == "hello", "word val")

    // p_identifier
    let r13 = p_identifier("my_var123 rest", 0)
    assert(p_is_ok(r13), "ident ok")
    assert(p_val(r13) == "my_var123", "ident val")

    // p_skip_spaces
    let r14 = p_skip_spaces("   abc", 0)
    assert(p_pos(r14) == 3, "skip spaces")

    // p_eof
    assert(p_is_ok(p_eof("", 0)), "eof empty")
    assert(p_is_ok(p_eof("ab", 2)), "eof at end")
    assert(not p_is_ok(p_eof("ab", 0)), "eof not at end")

    // p_take_while
    let is_a = fn(c) c == "a"
    let r15 = p_take_while("aaabbb", 0, is_a)
    assert(p_is_ok(r15), "take_while ok")
    assert(p_val(r15) == "aaa", "take_while val")

    // p_take_until
    let r16 = p_take_until("hello;world", 0, ";")
    assert(p_is_ok(r16), "take_until ok")
    assert(p_val(r16) == "hello", "take_until val")

    // Compose: parse "key=value" pairs
    let kv_input = "name=Alice"
    let kr = p_take_until(kv_input, 0, "=")
    assert(p_is_ok(kr), "kv key ok")
    let eq = p_char(kv_input, p_pos(kr), "=")
    assert(p_is_ok(eq), "kv eq ok")
    let not_eq = fn(c) c != "="
    let vr = p_take_while(kv_input, p_pos(eq), not_eq)
    assert(p_is_ok(vr), "kv val ok")
    assert(p_val(kr) == "name", "kv key")
    assert(p_val(vr) == "Alice", "kv val")

    print("parsec: all passed")
