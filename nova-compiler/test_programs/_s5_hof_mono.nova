// #14 oracle: scalar inline-lambda HOF monomorphization (NOVA_S5_HOF).
// Output MUST be byte-identical with the flag ON vs OFF. Specialized (inline) and
// dynamic (variable-bound) paths both checked.
fn _near(a: float, b: float) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < 0.0000001
        return 1
    0

fn main()
    // float inline lambda -> param specialized to float (fmul), result boxed on egress
    let xs = [1.5, 2.5, 3.5, 4.5]
    let sq = map(xs, fn(x) x * x)
    assert(_near(sq[0], 2.25), "sq0 2.25")
    assert(_near(sq[1], 6.25), "sq1 6.25")
    assert(_near(sq[2], 12.25), "sq2 12.25")
    assert(_near(sq[3], 20.25), "sq3 20.25")

    // float predicate (fcmp), truthy i64 return
    let big = filter(xs, fn(x) x > 3.0)
    assert(len(big) == 2, "filter len 2")
    assert(_near(big[0], 3.5), "filter0 3.5")
    assert(_near(big[1], 4.5), "filter1 4.5")

    // int inline lambda -> param specialized to int (mul i64)
    let ns = [1, 2, 3, 4, 5]
    let dbl = map(ns, fn(x) x * 2)
    assert(dbl[0] == 2, "dbl0")
    assert(dbl[2] == 6, "dbl2")
    assert(dbl[4] == 10, "dbl4")

    // int filter
    let evens = filter(ns, fn(x) x > 2)
    assert(len(evens) == 3, "evens len 3")
    assert(evens[0] == 3, "evens0")

    // ADVERSARIAL: a variable-bound lambda reused over BOTH an int list and a float
    // list. v1 skips variable-bound lambdas (it's a slot_load at the call, not an
    // inline make_closure) -> stays dynamic -> must be correct on both element kinds.
    let f = fn(x) x + x
    let fi = map(ns, f)
    assert(fi[0] == 2, "fi0")
    assert(fi[4] == 10, "fi4")
    let ff = map(xs, f)
    assert(_near(ff[0], 3.0), "ff0 3.0")
    assert(_near(ff[3], 9.0), "ff3 9.0")

    print("s5_hof_mono: all passed")
