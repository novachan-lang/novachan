// KAT for std/data/query
// Tests qr_where, qr_select, qr_order_by, qr_limit, qr_pluck, qr_count
// against hand-computed values.
import std/data/query

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn cks(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got [" + got + "] expected [" + expected + "]")
        exit(1)

fn main()
    // ── Build test rows ─────────────────────────────────────────────────────
    // rows = [{"name":"a","age":30}, {"name":"b","age":25}, {"name":"c","age":35}]
    let r0 = {}
    r0["name"] = "a"
    r0["age"] = 30
    let r1 = {}
    r1["name"] = "b"
    r1["age"] = 25
    let r2 = {}
    r2["name"] = "c"
    r2["age"] = 35
    let rows = []
    rows.push(r0)
    rows.push(r1)
    rows.push(r2)

    // ── KAT 1: qr_count ─────────────────────────────────────────────────────
    // rows has 3 elements
    cki("count_3", qr_count(rows), 3)

    // ── KAT 2: qr_where gt ──────────────────────────────────────────────────
    // qr_where(rows,"age","gt",28) -> rows where age > 28 -> a(30) and c(35) = 2 rows
    let w_gt = qr_where(rows, "age", "gt", 28)
    cki("where_gt_len", qr_count(w_gt), 2)

    // ── KAT 3: qr_where eq ──────────────────────────────────────────────────
    // qr_where(rows,"age","eq",25) -> only b -> 1 row
    let w_eq = qr_where(rows, "age", "eq", 25)
    cki("where_eq_len", qr_count(w_eq), 1)
    let eq_row = w_eq[0]
    cks("where_eq_name", eq_row["name"], "b")

    // ── KAT 4: qr_order_by ascending + qr_pluck ─────────────────────────────
    // qr_order_by(rows,"age",1) -> sorted by age ascending: b(25),a(30),c(35)
    // qr_pluck(...,"name") -> ["b","a","c"]
    let ordered = qr_order_by(rows, "age", 1)
    let names = qr_pluck(ordered, "name")
    cki("order_len", len(names), 3)
    cks("order_0", names[0], "b")
    cks("order_1", names[1], "a")
    cks("order_2", names[2], "c")

    // ── KAT 5: qr_select ─────────────────────────────────────────────────────
    // qr_select(rows, ["name"]) -> each row has only "name", no "age"
    let sel = qr_select(rows, ["name"])
    cki("select_len", len(sel), 3)
    let sel0 = sel[0]
    // "name" key must exist
    cki("select_has_name", contains(sel0, "name"), 1)
    // "age" key must NOT exist
    cki("select_no_age", contains(sel0, "age"), 0)
    cks("select_name_val", sel0["name"], "a")

    // ── KAT 6: qr_limit ─────────────────────────────────────────────────────
    // qr_limit(rows, 2) -> first 2 rows
    let lim = qr_limit(rows, 2)
    cki("limit_len", len(lim), 2)
    // First row must still be r0 (name="a")
    let lim0 = lim[0]
    cks("limit_row0_name", lim0["name"], "a")

    // ── KAT 7: qr_order_by descending ────────────────────────────────────────
    // qr_order_by(rows,"age",0) -> c(35),a(30),b(25)
    let desc = qr_order_by(rows, "age", 0)
    let dnames = qr_pluck(desc, "name")
    cks("desc_0", dnames[0], "c")
    cks("desc_1", dnames[1], "a")
    cks("desc_2", dnames[2], "b")

    // ── KAT 8: qr_where ne ───────────────────────────────────────────────────
    // qr_where(rows,"age","ne",30) -> b(25) and c(35) = 2 rows
    let w_ne = qr_where(rows, "age", "ne", 30)
    cki("where_ne_len", qr_count(w_ne), 2)

    // ── KAT 9: qr_where missing key excluded ─────────────────────────────────
    // row with no "score" key -> excluded silently
    let w_miss = qr_where(rows, "score", "gt", 0)
    cki("where_missing_key", qr_count(w_miss), 0)

    // ── KAT 10: qr_pluck on original rows ────────────────────────────────────
    let ages = qr_pluck(rows, "age")
    cki("pluck_age_0", ages[0], 30)
    cki("pluck_age_1", ages[1], 25)
    cki("pluck_age_2", ages[2], 35)

    // ── KAT 11: qr_limit larger than rows ────────────────────────────────────
    let lim_big = qr_limit(rows, 100)
    cki("limit_big", len(lim_big), 3)

    print("_query_test passed")

main()
