import std/text/md_blockquote

fn cks(got, expected, label)
    if got != expected
        print("FAIL md_blockquote " + label + ": got [" + got + "]")
        exit(1)

fn main()
    let nl = chr(10)

    // KAT-1: single blockquote line
    let r1 = md_blockquote("> quote")
    let e1 = "<blockquote>quote</blockquote>"
    cks(r1, e1, "single line")

    // KAT-2: two blockquote lines joined with nl
    let r2 = md_blockquote("> a" + nl + "> b")
    let e2 = "<blockquote>a" + nl + "b</blockquote>"
    cks(r2, e2, "two lines")

    // KAT-3: three blockquote lines
    let r3 = md_blockquote("> one" + nl + "> two" + nl + "> three")
    let e3 = "<blockquote>one" + nl + "two" + nl + "three</blockquote>"
    cks(r3, e3, "three lines")

    // KAT-4: content with punctuation preserved
    let r4 = md_blockquote("> Hello, world!")
    let e4 = "<blockquote>Hello, world!</blockquote>"
    cks(r4, e4, "punctuation preserved")

    print("PASS _md_blockquote_test")
