import otp

// counter GenServer: req {"op":"inc","by":n} mutates state; {"op":"get"} replies state.
fn counter_handler(state, req)
    let op = req["op"]
    if op == "inc"
        return {"state": state + req["by"], "reply": 0}
    {"state": state, "reply": state}

// bank GenServer: deposit/withdraw with a reply indicating success.
fn bank_handler(state, req)
    let op = req["op"]
    if op == "deposit"
        return {"state": state + req["amt"], "reply": 1}
    if op == "withdraw"
        if state >= req["amt"]
            return {"state": state - req["amt"], "reply": 1}
        return {"state": state, "reply": 0}
    {"state": state, "reply": state}

// flaky worker: fails on attempts 0,1; succeeds on attempt 2 with payload 100+attempt.
fn flaky_worker(report_ch, attempt)
    if attempt < 2
        send(report_ch, 0)
    else
        send(report_ch, 100 + attempt)

// worker that succeeds immediately.
fn good_worker(report_ch, attempt)
    send(report_ch, 7)

fn main()
    // GenServer: casts then a call, in order (serialized loop).
    let c = otp.gen_start(0, counter_handler)
    otp.gen_cast(c, {"op": "inc", "by": 5})
    otp.gen_cast(c, {"op": "inc", "by": 3})
    let v = otp.gen_call(c, {"op": "get"})
    assert(v == 8, "counter serialized to 8")
    let v2 = otp.gen_call(c, {"op": "get"})
    assert(v2 == 8, "still 8 (get does not mutate)")
    otp.gen_stop(c)

    // GenServer call returning a status, with state transitions.
    let acct = otp.gen_start(100, bank_handler)
    assert(otp.gen_call(acct, {"op": "withdraw", "amt": 40}) == 1, "withdraw 40 ok")
    assert(otp.gen_call(acct, {"op": "withdraw", "amt": 100}) == 0, "overdraw rejected")
    assert(otp.gen_call(acct, {"op": "deposit", "amt": 50}) == 1, "deposit ok")
    assert(otp.gen_call(acct, {"op": "balance"}) == 110, "balance = 100-40+50 = 110")
    otp.gen_stop(acct)

    // Supervisor: recovers after exactly 2 restarts.
    let r = otp.supervise(flaky_worker, 5)
    assert(r["ok"] == 1, "supervised worker recovered")
    assert(r["payload"] == 102, "success payload 102")
    assert(r["restarts"] == 2, "after exactly 2 restarts")

    // Supervisor: immediate success, 0 restarts.
    let r2 = otp.supervise(good_worker, 5)
    assert(r2["ok"] == 1, "good worker ok")
    assert(r2["payload"] == 7, "payload 7")
    assert(r2["restarts"] == 0, "no restarts needed")

    // Named registry: register a GenServer pid under a name, look it up, USE the
    // looked-up pid (exercises a channel stored in registry state + returned via call).
    let reg = otp.registry_start()
    let svc = otp.gen_start(0, counter_handler)
    assert(otp.reg_register(reg, "counter", svc) == 1, "registered")
    assert(otp.reg_whereis(reg, "missing") == 0, "absent name -> 0")
    let found = otp.reg_whereis(reg, "counter")
    otp.gen_cast(found, {"op": "inc", "by": 10})
    otp.gen_cast(found, {"op": "inc", "by": 4})
    assert(otp.gen_call(found, {"op": "get"}) == 14, "looked-up pid is the real process (state=14)")
    // and the original handle sees the same state (same process)
    assert(otp.gen_call(svc, {"op": "get"}) == 14, "original handle agrees (one process)")
    otp.gen_stop(svc)
    otp.gen_stop(reg)

    print("otp_lib_test: all passed")
