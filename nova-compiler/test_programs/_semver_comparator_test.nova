import std/semver/semver_comparator

fn ckb(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got '" + got + "' want '" + want + "'")
        exit(1)

// --- svcmp_satisfies KAT vectors (from spec) ---
ckb("svcmp_satisfies_1", svcmp_satisfies("1.5.0", ">=1.2.3"), 1)
ckb("svcmp_satisfies_2", svcmp_satisfies("1.2.3", ">1.2.3"), 0)
ckb("svcmp_satisfies_3", svcmp_satisfies("1.9.9", "<2.0.0"), 1)
ckb("svcmp_satisfies_4", svcmp_satisfies("1.2.3", "=1.2.3"), 1)
ckb("svcmp_satisfies_5", svcmp_satisfies("2.0.0", "<=1.5.0"), 0)
ckb("svcmp_satisfies_6", svcmp_satisfies("1.2.3", "1.2.3"), 1)

// --- svcmp_operator KAT vectors (from spec) ---
cks("svcmp_op_gte", svcmp_operator(">=1.2.3"), ">=")
cks("svcmp_op_gt",  svcmp_operator(">1.2.3"),  ">")
cks("svcmp_op_lte", svcmp_operator("<=1.5.0"), "<=")
cks("svcmp_op_lt",  svcmp_operator("<2.0.0"),  "<")
cks("svcmp_op_eq",  svcmp_operator("=1.2.3"),  "=")
cks("svcmp_op_bare", svcmp_operator("1.2.3"),  "=")

// --- svcmp_version KAT vectors (from spec) ---
cks("svcmp_ver_gte",  svcmp_version(">=1.2.3"), "1.2.3")
cks("svcmp_ver_gt",   svcmp_version(">2.0.0"),  "2.0.0")
cks("svcmp_ver_lte",  svcmp_version("<=1.5.0"), "1.5.0")
cks("svcmp_ver_lt",   svcmp_version("<2.0.0"),  "2.0.0")
cks("svcmp_ver_eq",   svcmp_version("=1.2.3"),  "1.2.3")
cks("svcmp_ver_bare", svcmp_version("1.2.3"),   "1.2.3")

// --- additional boundary tests ---
// >= at exact boundary: true
ckb("svcmp_gte_exact", svcmp_satisfies("1.2.3", ">=1.2.3"), 1)
// > at exact boundary: false
ckb("svcmp_gt_exact", svcmp_satisfies("1.2.3", ">1.2.3"), 0)
// <= at exact boundary: true
ckb("svcmp_lte_exact", svcmp_satisfies("1.5.0", "<=1.5.0"), 1)
// < at exact boundary: false
ckb("svcmp_lt_exact", svcmp_satisfies("2.0.0", "<2.0.0"), 0)
// version lower than >=: false
ckb("svcmp_gte_below", svcmp_satisfies("1.2.2", ">=1.2.3"), 0)
// bare version mismatch: false
ckb("svcmp_bare_mismatch", svcmp_satisfies("1.2.4", "1.2.3"), 0)
// pre-release lower than release of same triple
ckb("svcmp_pre_lt_release", svcmp_satisfies("1.2.3-alpha", ">1.2.3-0"), 1)
// with-pre < no-pre per SemVer §11.3
ckb("svcmp_pre_lt_nopre", svcmp_satisfies("1.2.3-alpha", "<1.2.3"), 1)

print("PASS _semver_comparator_test")
