import std/util/graphviz

// ── helpers ───────────────────────────────────────────────────────────────────

// Return 1 if needle appears anywhere in haystack, else 0.
fn gvt_contains(haystack: str, needle: str) -> int
    let hlen = len(haystack)
    let nlen = len(needle)
    if nlen == 0
        return 1
    if nlen > hlen
        return 0
    let i = 0
    let found = 0
    while i <= hlen - nlen
        let match_here = 1
        let j = 0
        while j < nlen
            if haystack[i + j] != needle[j]
                match_here = 0
                j = nlen
            j = j + 1
        if match_here == 1
            found = 1
            i = hlen
        i = i + 1
    found

fn cks(label: str, got: str, want: str)
    if got != want
        print("FAIL " + label + ": got=" + got + " want=" + want)
        exit(1)

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckc(label: str, haystack: str, needle: str)
    if gvt_contains(haystack, needle) != 1
        print("FAIL " + label + ": <" + needle + "> not found in DOT output")
        print("DOT was: " + haystack)
        exit(1)

// ── main KATs ─────────────────────────────────────────────────────────────────
fn main()
    // ── KAT 1: directed graph header ─────────────────────────────────────────
    let g = gv_new(1)
    gv_add_edge(g, "A", "B")
    gv_add_edge(g, "B", "C")
    let dot = gv_to_dot(g)
    ckc("digraph_header", dot, "digraph")

    // ── KAT 2: directed edge A -> B ──────────────────────────────────────────
    ckc("directed_edge_AB", dot, "A -> B")

    // ── KAT 3: directed edge B -> C ──────────────────────────────────────────
    ckc("directed_edge_BC", dot, "B -> C")

    // ── KAT 4: undirected graph header ───────────────────────────────────────
    let u = gv_new(0)
    gv_add_edge(u, "X", "Y")
    let ud = gv_to_dot(u)
    ckc("graph_header", ud, "graph")

    // ── KAT 5: undirected edge X -- Y ────────────────────────────────────────
    ckc("undirected_edge_XY", ud, "X -- Y")

    // ── KAT 6: labeled edge contains the label ───────────────────────────────
    gv_add_labeled_edge(g, "C", "D", "next")
    let dot2 = gv_to_dot(g)
    ckc("labeled_edge_label", dot2, "next")

    // ── KAT 7: labeled edge still uses -> (directed) ─────────────────────────
    ckc("labeled_edge_arrow", dot2, "C -> D")

    // ── KAT 8: explicit node appears in output ────────────────────────────────
    let g2 = gv_new(1)
    gv_add_node(g2, "Orphan")
    let dot3 = gv_to_dot(g2)
    ckc("explicit_node", dot3, "Orphan")

    // ── KAT 9: closing brace present ─────────────────────────────────────────
    cki("closing_brace", gvt_contains(dot, chr(125)), 1)

    // ── KAT 10: undirected header is NOT "digraph" ────────────────────────────
    cki("undirected_not_digraph", gvt_contains(ud, "digraph"), 0)

    print("_graphviz_test passed")
