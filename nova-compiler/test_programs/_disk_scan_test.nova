import std/scheduling/disk_scan

fn cki(got, want, label)
    if got != want
        print("FAIL disk_scan " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // KAT 1: ds_scan([5,25,18,3],10,30,1) = 47
    // Going up from 10 to disk_max=30: (30-10)=20
    // Going down from 30 to min(3)=3: (30-3)=27
    // Total = 47
    let req1 = []
    push(req1, 5)
    push(req1, 25)
    push(req1, 18)
    push(req1, 3)
    cki(ds_scan(req1, 10, 30, 1), 47, "scan_up_basic")

    // KAT 2: ds_look([5,25,18,3],10,1) = 37
    // Going up from 10 to last request (25): (25-10)=15
    // Going down from 25 to min(3)=3: (25-3)=22
    // Total = 37
    cki(ds_look(req1, 10, 1), 37, "look_up_basic")

    // KAT 3: ds_scan going DOWN from head=20, disk_max=30, requests=[5,10,25,28]
    // Going down from 20 to 0: 20
    // Going up from 0 to max(28)=28: 28
    // Total = 48
    let req3 = []
    push(req3, 5)
    push(req3, 10)
    push(req3, 25)
    push(req3, 28)
    cki(ds_scan(req3, 20, 30, 0), 48, "scan_down")

    // KAT 4: ds_look going DOWN from head=20, requests=[5,10,25,28]
    // Going down from 20 to min of reqs<=20 = 5: (20-5)=15
    // Going up from 5 to max of reqs>20 = 28: (28-5)=23
    // Total = 38
    cki(ds_look(req3, 20, 0), 38, "look_down")

    // KAT 5: ds_cscan([5,25,18,3],10,30)
    // sweep up: 10->30 = 20; jump 30->0 = 30 (costs disk_max=30); then 0->5 = 5
    // Total = 20+30+5 = 55
    cki(ds_cscan(req1, 10, 30), 55, "cscan_basic")

    // KAT 6: ds_scan all requests already above head (no below)
    // head=5, disk_max=30, requests=[10,20,25], direction=1
    // up to 30: 25; down from 30: no requests below 5 (none), so just 30-5=25
    // Wait: min_req=10 which is >=5, but SCAN goes to disk_max=30 then sweeps down to min request
    // Total = (30-5) + (30-10) = 25 + 20 = 45
    let req6 = []
    push(req6, 10)
    push(req6, 20)
    push(req6, 25)
    cki(ds_scan(req6, 5, 30, 1), 45, "scan_all_above")

    // KAT 7: empty requests => 0
    cki(ds_scan([], 10, 30, 1), 0, "scan_empty")
    cki(ds_look([], 10, 1), 0, "look_empty")
    cki(ds_cscan([], 10, 30), 0, "cscan_empty")

    // KAT 8: ds_cscan no requests below head
    // head=15, disk_max=30, requests=[20,25]
    // sweep up 15->30: 15; no below-head requests, no jump
    // Total = 15
    let req8 = []
    push(req8, 20)
    push(req8, 25)
    cki(ds_cscan(req8, 15, 30), 15, "cscan_no_below")

    // KAT 9: ds_look with no requests in current direction — only below head, direction=1
    // head=20, requests=[5,10], direction=1
    // farthest >= 20: none, so farthest stays at head=20, movement going up = 0
    // nearest below: 5; movement down = 20-5 = 15
    let req9 = []
    push(req9, 5)
    push(req9, 10)
    cki(ds_look(req9, 20, 1), 15, "look_only_below")

    print("PASS _disk_scan_test")
