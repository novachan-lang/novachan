import forge_feature_experiment

fn main()
    let e = exp_new("button-color", 3)
    assert(exp_name(e) == "button-color", "name")
    assert(exp_is_active(e) == 1, "active")
    assert(exp_total_assigned(e) == 0, "0 assigned")

    e = exp_assign(e, "user-1", 0)
    e = exp_assign(e, "user-2", 1)
    e = exp_assign(e, "user-3", 2)
    e = exp_assign(e, "user-4", 0)
    assert(exp_total_assigned(e) == 4, "4 assigned")

    assert(exp_get_variant(e, "user-1") == 0, "user-1 = 0")
    assert(exp_get_variant(e, "user-2") == 1, "user-2 = 1")
    assert(exp_get_variant(e, "unknown") == -1, "unknown = -1")

    e = exp_convert(e, "user-1")
    e = exp_convert(e, "user-4")
    e = exp_convert(e, "user-2")
    assert(exp_conversion_count(e, 0) == 2, "variant 0: 2 conversions")
    assert(exp_conversion_count(e, 1) == 1, "variant 1: 1 conversion")
    assert(exp_conversion_count(e, 2) == 0, "variant 2: 0 conversions")

    e = exp_stop(e)
    assert(exp_is_active(e) == 0, "stopped")
    e = exp_assign(e, "user-5", 1)
    assert(exp_total_assigned(e) == 4, "no assignment when stopped")

    assert(exp_conversion_count(e, -1) == 0, "neg variant = 0")
    assert(exp_conversion_count(e, 99) == 0, "out of range = 0")

    print("FEATURE-EXPERIMENT KAT PASS")
