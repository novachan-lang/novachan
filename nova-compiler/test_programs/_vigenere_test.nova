// KAT test for std/encoding/vigenere
import std/encoding/vigenere

// Helper: check string equality
fn cks(label, got, want)
    if got == want
        return null
    print("FAIL " + label + ": got=" + got + " want=" + want)
    exit(1)

// ── KAT 1: canonical published vector (uppercase, key=LEMON) ─────────────────
cks("enc_ATTACKATDAWN", vg_encrypt("ATTACKATDAWN", "LEMON"), "LXFOPVEFRNHR")

// ── KAT 2: decrypt the same vector back ──────────────────────────────────────
cks("dec_LXFOPVEFRNHR", vg_decrypt("LXFOPVEFRNHR", "LEMON"), "ATTACKATDAWN")

// ── KAT 3: encrypt HELLO with KEY ────────────────────────────────────────────
// H(7)+K(10)=17->R, E(4)+E(4)=8->I, L(11)+Y(24)=35%26=9->J,
// L(11)+K(10)=21->V, O(14)+E(4)=18->S => RIJVS
cks("enc_HELLO_KEY", vg_encrypt("HELLO", "KEY"), "RIJVS")

// ── KAT 4: decrypt RIJVS with KEY ────────────────────────────────────────────
cks("dec_RIJVS_KEY", vg_decrypt("RIJVS", "KEY"), "HELLO")

// ── KAT 5: lowercase letters with same-length key ────────────────────────────
// a(0)+a(0)=0->a, b(1)+b(1)=2->c, c(2)+c(2)=4->e => "ace"
cks("enc_abc_abc", vg_encrypt("abc", "abc"), "ace")

// ── KAT 6: decrypt lowercase back ────────────────────────────────────────────
cks("dec_ace_abc", vg_decrypt("ace", "abc"), "abc")

// ── KAT 7: non-letters pass through, key NOT consumed ────────────────────────
// "A B" with key "B": A(0)+B(1)=1->B, space passes, B(1)+B(1)=2->C => "B C"
cks("enc_with_spaces", vg_encrypt("A B", "B"), "B C")

// ── KAT 8: round-trip with mixed case and punctuation ────────────────────────
let plain8 = "Hello, World!"
let enc8 = vg_encrypt(plain8, "KEY")
let dec8 = vg_decrypt(enc8, "KEY")
cks("roundtrip_mixed", dec8, plain8)

print("_vigenere_test passed")
