fn greet(name, greeting = "Hello")
    greeting + ", " + name + "!"

fn make_point(x, y, z = 0)
    [x, y, z]

fn add3(a, b, c)
    a + b + c

fn main()
    let v1 = greet("Alice")
    assert(v1 == "Hello, Alice!", "default greeting")

    let v2 = greet("Bob", "Hi")
    assert(v2 == "Hi, Bob!", "positional greeting")

    let v3 = greet(name: "Charlie")
    assert(v3 == "Hello, Charlie!", "named name only")

    let v4 = greet(name: "Dave", greeting: "Hey")
    assert(v4 == "Hey, Dave!", "both named")

    let v5 = greet(greeting: "Yo", name: "Eve")
    assert(v5 == "Yo, Eve!", "reversed named")

    let v6 = greet("Frank", greeting: "Sup")
    assert(v6 == "Sup, Frank!", "mixed positional+named")

    let p1 = make_point(1, 2)
    assert(p1[0] == 1 and p1[1] == 2 and p1[2] == 0, "point default z")

    let p2 = make_point(x: 10, y: 20, z: 30)
    assert(p2[0] == 10 and p2[1] == 20 and p2[2] == 30, "point all named")

    let p3 = make_point(y: 5, x: 3)
    assert(p3[0] == 3 and p3[1] == 5 and p3[2] == 0, "point reversed named+default")

    let v7 = add3(c: 100, a: 1, b: 10)
    assert(v7 == 111, "all named no defaults")

    let v8 = add3(1, c: 100, b: 10)
    assert(v8 == 111, "mixed positional+named no defaults")

    print("named_args_test: all passed")
