import std/poly/polyeval

fn cki(label, got, want)
    if got != want
        print("FAIL polyeval " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ckf(label, got, want, tol)
    if approx(got, want, tol) == 0
        print("FAIL polyeval " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let eps = 0.0001

    // pe_eval_int([1,2,3], 2) = 1 + 2*2 + 3*4 = 17
    let p1 = [1, 2, 3]
    let r1 = pe_eval_int(p1, 2)
    cki("eval_int_1_2_3_at_2", r1, 17)

    // pe_eval_int([6,-5,1], 2) = 6 - 10 + 4 = 0
    let p2 = [6, -5, 1]
    let r2 = pe_eval_int(p2, 2)
    cki("eval_int_6m5_1_at_2_root", r2, 0)

    // pe_eval_int([6,-5,1], 3) = 6 - 15 + 9 = 0
    let r3 = pe_eval_int(p2, 3)
    cki("eval_int_6m5_1_at_3_root", r3, 0)

    // pe_eval_int([5], 7) = 5  (constant)
    let p4 = [5]
    let r4 = pe_eval_int(p4, 7)
    cki("eval_int_const_5_at_7", r4, 5)

    // pe_eval_int([0,1], 10) = 0 + 10 = 10  (p=x)
    let p5 = [0, 1]
    let r5 = pe_eval_int(p5, 10)
    cki("eval_int_x_at_10", r5, 10)

    // pe_sum_coeffs([1,2,3]) = 6 = p(1)
    let r6 = pe_sum_coeffs(p1)
    cki("sum_coeffs_1_2_3", r6, 6)

    // pe_alt_sum([1,2,3]) = 1 - 2 + 3 = 2 = p(-1)
    let r7 = pe_alt_sum(p1)
    cki("alt_sum_1_2_3", r7, 2)

    // pe_eval_deriv([1,2,3], 1.0) = p'(x)=2+6x; p'(1)=8
    let r8f = pe_eval_deriv(p1, 1.0)
    ckf("eval_deriv_1_2_3_at_1", r8f, 8.0, eps)

    // pe_eval_all([0,1], [1,2,3]) should give [1.0, 2.0, 3.0]
    let px = [0, 1]
    let xs = [1, 2, 3]
    let res9 = pe_eval_all(px, xs)
    let v9a = res9[0] * 1.0
    let v9b = res9[1] * 1.0
    let v9c = res9[2] * 1.0
    ckf("eval_all_x_at_1", v9a, 1.0, eps)
    ckf("eval_all_x_at_2", v9b, 2.0, eps)
    ckf("eval_all_x_at_3", v9c, 3.0, eps)

    // pe_horner alias check
    let rh = pe_horner(p1, 2.0)
    ckf("horner_1_2_3_at_2", rh, 17.0, eps)

    // pe_eval_monomials([1,2,3], 2.0) = [1, 4, 12]
    let pm = pe_eval_monomials(p1, 2.0)
    let vm0 = pm[0] * 1.0
    let vm1 = pm[1] * 1.0
    let vm2 = pm[2] * 1.0
    ckf("monomials_0", vm0, 1.0, eps)
    ckf("monomials_1", vm1, 4.0, eps)
    ckf("monomials_2", vm2, 12.0, eps)

    // empty poly evals to 0
    let pempty = []
    let re = pe_eval(pempty, 5.0)
    ckf("eval_empty", re, 0.0, eps)

    print("PASS _polyeval_test")
