import forge_markdown

fn has(s: string, sub: string) -> string
    if find(s, sub) >= 0
        return "T"
    "F"

fn main()
    let h = markdown_to_html("This is ~~gone~~ text")
    print("del=" + has(h, "<del>gone</del>"))
    // existing rules still work (regression)
    print("h1=" + has(markdown_to_html("# Hi"), "<h1>Hi</h1>"))
    print("bold=" + has(markdown_to_html("a **b** c"), "<strong>b</strong>"))
    print("italic=" + has(markdown_to_html("a *b* c"), "<em>b</em>"))
    print("code=" + has(markdown_to_html("a `x` c"), "<code>x</code>"))
    // combined strike + bold
    print("combo=" + has(markdown_to_html("~~old~~ and **new**"), "<del>old</del>"))
