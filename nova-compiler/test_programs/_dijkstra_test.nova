// _dijkstra_test.nova — KAT for std/graph/dijkstra
//
// Example graph (directed, weighted, non-negative):
//   A --1--> B --5--> D
//   A --4--> C
//   B --2--> C
//   C --1--> D
//   D (no outgoing edges)
//
// Shortest paths from A:
//   A->A = 0
//   A->B = 1  (A->B)
//   A->C = 3  (A->B->C, weight 1+2=3; not A->C direct which is 4)
//   A->D = 4  (A->B->C->D, weight 1+2+1=4; not A->B->D which is 1+5=6)
//
// D has no outgoing edges, so D->A is unreachable (-1).

import std/graph/dijkstra

// Integer known-answer check.
fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

// String-list known-answer check.
fn cks(label: str, got: list, want: list)
    if got != want
        let gs = str(got)
        let ws = str(want)
        print("FAIL " + label + ": got " + gs + " want " + ws)
        exit(1)

fn main()
    // Build the example graph
    let g = {}
    g["A"] = [["B", 1], ["C", 4]]
    g["B"] = [["C", 2], ["D", 5]]
    g["C"] = [["D", 1]]
    g["D"] = []

    // KAT 1: A->D shortest distance = 4 (via A->B->C->D)
    cki("dist_A_D", dj_distance(g, "A", "D"), 4)

    // KAT 2: A->C shortest distance = 3 (via A->B->C, not direct A->C=4)
    cki("dist_A_C", dj_distance(g, "A", "C"), 3)

    // KAT 3: A->B shortest distance = 1 (direct edge)
    cki("dist_A_B", dj_distance(g, "A", "B"), 1)

    // KAT 4: dj_shortest map has D=4
    let dm = dj_shortest(g, "A")
    cki("shortest_D", dm["D"], 4)

    // KAT 5: shortest path A->D = [A, B, C, D]
    cks("path_A_D", dj_path(g, "A", "D"), ["A", "B", "C", "D"])

    // KAT 6: A->A = 0 (source to itself)
    cki("dist_A_A", dj_distance(g, "A", "A"), 0)

    // KAT 7: D->A = -1 (D has no outgoing edges, so A is unreachable from D)
    cki("dist_D_A", dj_distance(g, "D", "A"), -1)

    // KAT 8: path from D to A is [] (unreachable)
    cks("path_D_A", dj_path(g, "D", "A"), [])

    print("_dijkstra_test passed")
