import forge_cache_manager

fn main()
    let c = cm_new()
    assert(cm_total_count(c) == 0, "starts empty")
    assert(cm_hit_count(c) == 0, "no hits yet")
    assert(cm_miss_count(c) == 0, "no misses yet")

    c = cm_set(c, "user:1", "alice", "l1")
    c = cm_set(c, "user:2", "bob", "l2")
    c = cm_set(c, "user:3", "carol", "l3")
    assert(cm_tier_count(c, "l1") == 1, "l1 has 1")
    assert(cm_tier_count(c, "l2") == 1, "l2 has 1")
    assert(cm_tier_count(c, "l3") == 1, "l3 has 1")
    assert(cm_total_count(c) == 3, "3 total")

    let g1 = cm_get(c, "user:1")
    assert(is_ok(g1) == true, "user:1 hits")
    assert(unwrap(g1) == "alice", "user:1 value")

    let g2 = cm_get(c, "user:2")
    assert(is_ok(g2) == true, "user:2 hits from l2")
    assert(unwrap(g2) == "bob", "user:2 value")

    let g3 = cm_get(c, "user:3")
    assert(is_ok(g3) == true, "user:3 hits from l3")
    assert(unwrap(g3) == "carol", "user:3 value")

    let miss = cm_get(c, "user:99")
    assert(is_err(miss) == true, "unknown key misses")

    assert(cm_hit_count(c) == 3, "3 hits recorded")
    assert(cm_miss_count(c) == 1, "1 miss recorded")

    let rate = cm_hit_rate(c)
    assert(is_ok(rate) == true, "hit rate computable")
    assert(unwrap(rate) == 75, "hit rate is 75%")

    assert(cm_has(c, "user:1") == 1, "has user:1")
    assert(cm_has(c, "user:99") == 0, "does not have user:99")

    let inv = cm_invalidate(c, "user:1")
    assert(is_ok(inv) == true, "invalidate user:1 ok")
    assert(cm_has(c, "user:1") == 0, "user:1 gone after invalidate")
    assert(cm_tier_count(c, "l1") == 0, "l1 count dropped")
    assert(cm_total_count(c) == 2, "total dropped to 2")

    let after = cm_get(c, "user:1")
    assert(is_err(after) == true, "user:1 now misses")

    let inv_missing = cm_invalidate(c, "not-there")
    assert(is_err(inv_missing) == true, "invalidating absent key errs")

    // overwrite in place should not double-count the tier
    c = cm_set(c, "user:2", "bobby", "l2")
    assert(cm_tier_count(c, "l2") == 1, "l2 still 1 after overwrite")
    let g2b = cm_get(c, "user:2")
    assert(unwrap(g2b) == "bobby", "user:2 updated value")

    let empty = cm_new()
    let empty_rate = cm_hit_rate(empty)
    assert(is_err(empty_rate) == true, "no gets yet -> hit rate errs")

    print("CACHE-MANAGER KAT PASS")
