// KAT for std/hash/crc16 — CRC-16 checksum variants.
//
// Check string: "123456789" (9 ASCII bytes 0x31..0x39)
//   h_crc16_ccitt  (CCITT-FALSE): 0x29B1 = 10673
//   h_crc16_xmodem (XMODEM)     : 0x31C3 = 12739
//   h_crc16_modbus (MODBUS)     : 0x4B37 = 19255
//   h_crc16_arc    (ARC)        : 0xBB3D = 47933
//   h_crc16_ccitt  (empty)      : 0xFFFF = 65535
import std/hash/crc16

fn ck(label: string, got: int, want: int)
    if got != want
        print("FAIL crc16 " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let b9 = str_to_bytes("123456789")
    let bempty = bytes(0)

    // KAT 1: CCITT-FALSE check value
    ck("ccitt-check", h_crc16_ccitt(b9), 10673)

    // KAT 2: XMODEM check value
    ck("xmodem-check", h_crc16_xmodem(b9), 12739)

    // KAT 3: MODBUS check value
    ck("modbus-check", h_crc16_modbus(b9), 19255)

    // KAT 4: ARC check value (0xBB3D = 47933)
    ck("arc-check", h_crc16_arc(b9), 47933)

    // KAT 5: CCITT-FALSE empty == init 0xFFFF
    ck("ccitt-empty", h_crc16_ccitt(bempty), 65535)

    // KAT 6: XMODEM empty == init 0x0000
    ck("xmodem-empty", h_crc16_xmodem(bempty), 0)

    // KAT 7: MODBUS empty == init 0xFFFF
    ck("modbus-empty", h_crc16_modbus(bempty), 65535)

    // KAT 8: ARC empty == init 0x0000
    ck("arc-empty", h_crc16_arc(bempty), 0)

    print("PASS _crc16_test")
