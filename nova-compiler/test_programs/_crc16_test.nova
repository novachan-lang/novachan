// KAT probe for std/encoding/crc16 — CRC-16 checksum variants.
// Known-answer values from the authoritative CRC catalogue
// (https://crccalc.com / Williams "A Painless Guide to CRC Error Detection Algorithms").
//
// Standard check string: "123456789" (9 ASCII bytes, 0x31..0x39)
//   CRC-16/CCITT-FALSE : 0x29B1 = 10673
//   CRC-16/XMODEM      : 0x31C3 = 12739
//   CRC-16/MODBUS      : 0x4B37 = 19255
import std/encoding/crc16

// ── Helpers ───────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// Build bytes from ASCII string (reuses the module's _bytes logic inline so
// the test has no dependency on the private helper being exported).
fn mk_bytes(s: string) -> any
    let out = bytes(0)
    let i = 0
    let n = len(s)
    while i < n
        out = bytes_append(out, ord(char_at(s, i)) & 0xFF)
        i = i + 1
    out

// ── KAT 1: CCITT-FALSE standard check value ──────────────────────────────────
fn kat1()
    let b = mk_bytes("123456789")
    let got = c16_ccitt_false(b)
    cki("kat1-ccitt-false-check", got, 10673)
    print("KAT 1 PASS: c16_ccitt_false('123456789') == 0x29B1 (10673)")

// ── KAT 2: XMODEM standard check value ───────────────────────────────────────
fn kat2()
    let b = mk_bytes("123456789")
    let got = c16_xmodem(b)
    cki("kat2-xmodem-check", got, 12739)
    print("KAT 2 PASS: c16_xmodem('123456789') == 0x31C3 (12739)")

// ── KAT 3: MODBUS standard check value ───────────────────────────────────────
fn kat3()
    let b = mk_bytes("123456789")
    let got = c16_modbus(b)
    cki("kat3-modbus-check", got, 19255)
    print("KAT 3 PASS: c16_modbus('123456789') == 0x4B37 (19255)")

// ── KAT 4: CCITT-FALSE empty input == init value 0xFFFF ──────────────────────
fn kat4()
    let b = bytes(0)
    let got = c16_ccitt_false(b)
    cki("kat4-ccitt-false-empty", got, 65535)
    print("KAT 4 PASS: c16_ccitt_false('') == 0xFFFF (65535)")

// ── KAT 5: XMODEM empty input == init value 0x0000 ───────────────────────────
fn kat5()
    let b = bytes(0)
    let got = c16_xmodem(b)
    cki("kat5-xmodem-empty", got, 0)
    print("KAT 5 PASS: c16_xmodem('') == 0x0000 (0)")

// ── KAT 6: MODBUS single byte 0x01 ───────────────────────────────────────────
// Hand-computed: init=0xFFFF, XOR low byte with 0x01 -> 0xFFFE
// 8 LSB-first iterations on 0xFFFE:
//   bit0: lsb=0, crc=0x7FFF,  no XOR  -> 0x7FFF
//   bit1: lsb=1, crc=0x3FFF,  XOR A001-> 0x9FFE
//   bit2: lsb=0, crc=0x4FFF,  no XOR  -> 0x4FFF
//   bit3: lsb=1, crc=0x27FF,  XOR A001-> 0x87FE
//   bit4: lsb=0, crc=0x43FF,  no XOR  -> 0x43FF
//   bit5: lsb=1, crc=0x21FF,  XOR A001-> 0x81FE  (wait: 0x21FF^A001=0x81FE)
//   bit6: lsb=0, crc=0x40FF,  no XOR  -> 0x40FF
//   bit7: lsb=1, crc=0x207F,  XOR A001-> 0x807E  (0x207F^A001=0x807E? 0x207F=0010.0000.0111.1111 XOR A001=1010.0000.0000.0001 = 1000.0000.0111.1110 = 0x807E)
// Actually let's just verify against the known online value for [0x01]: 0x807E
fn kat6()
    let b = bytes(0)
    b = bytes_append(b, 1)
    let got = c16_modbus(b)
    cki("kat6-modbus-byte1", got, 0x807E)
    print("KAT 6 PASS: c16_modbus([0x01]) == 0x807E (32894)")

// ── KAT 7: CCITT-FALSE single byte 0x00 ──────────────────────────────────────
// init=0xFFFF, XOR high byte with 0x00 -> 0xFFFF, then 8 MSB-first bits:
// all 8 bits of 0xFF are 1 -> poly applied 8 times to init
// Hand-trace: crc=0xFFFF XOR (0x00<<8)=0xFFFF
//   bit0: msb=1, crc=(0xFFFF<<1)&0xFFFF=0xFFFE, XOR 1021 -> 0xEFDF
//   bit1: msb=1, crc=0xDFBE, XOR 1021 -> 0xCF9F
//   bit2: msb=1, crc=0x9F3E, XOR 1021 -> 0x8F1F
//   bit3: msb=1, crc=0x1E3E, XOR 1021 -> 0x0E1F (msb of 0x8F1F = 1)
//         0x8F1F<<1=0x1E3E, XOR 1021=0x0E1F
//   bit4: msb=0 (0x0E1F>>15=0), crc=0x1C3E, no XOR
//   bit5: msb=0, crc=0x387C, no XOR
//   bit6: msb=0, crc=0x70F8, no XOR
//   bit7: msb=0, crc=0xE1F0, no XOR
// Result: 0xE1F0 = 57840
// Verify via known reference: CRC-16/CCITT-FALSE of [0x00] = 0xE1F0 ✓
fn kat7()
    let b = bytes(0)
    b = bytes_append(b, 0)
    let got = c16_ccitt_false(b)
    cki("kat7-ccitt-false-byte0", got, 0xE1F0)
    print("KAT 7 PASS: c16_ccitt_false([0x00]) == 0xE1F0 (57840)")

// ── KAT 8: XMODEM "A" (0x41) ─────────────────────────────────────────────────
// init=0, XOR high with 0x41 -> 0x4100, 8 MSB-first bits:
// 0x4100 = 0100 0001 0000 0000
//   bit0: msb=0, crc=0x8200, no XOR
//   bit1: msb=1, crc=0x0400, XOR 1021 -> 0x1421
//   bit2: msb=0, crc=0x2842, no XOR
//   bit3: msb=0, crc=0x5084, no XOR
//   bit4: msb=0, crc=0xA108, no XOR
//   bit5: msb=1, crc=0x4210, XOR 1021 -> 0x5231
//   bit6: msb=0, crc=0xA462, no XOR
//   bit7: msb=1, crc=0x48C4, XOR 1021 -> 0x58E5
// c16_xmodem("A") = 0x58E5 = 22757
fn kat8()
    let b = mk_bytes("A")
    let got = c16_xmodem(b)
    cki("kat8-xmodem-A", got, 0x58E5)
    print("KAT 8 PASS: c16_xmodem('A') == 0x58E5 (22757)")

// ── KAT 9: CCITT-FALSE two-byte input "AB" (0x41 0x42) ───────────────────────
// Verified by running the algorithm: c16_ccitt_false("AB") = 0x4B74 = 19316
fn kat9()
    let b = mk_bytes("AB")
    let got = c16_ccitt_false(b)
    cki("kat9-ccitt-false-AB", got, 0x4B74)
    print("KAT 9 PASS: c16_ccitt_false('AB') == 0x4B74 (19316)")

// ── KAT 10: MODBUS empty == 0xFFFF ───────────────────────────────────────────
fn kat10()
    let b = bytes(0)
    let got = c16_modbus(b)
    cki("kat10-modbus-empty", got, 0xFFFF)
    print("KAT 10 PASS: c16_modbus('') == 0xFFFF (65535)")

fn main()
    kat1()
    kat2()
    kat3()
    kat4()
    kat5()
    kat6()
    kat7()
    kat8()
    kat9()
    kat10()
    print("_crc16_test passed")
