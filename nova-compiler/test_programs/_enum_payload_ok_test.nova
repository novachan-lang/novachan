// enum payload typing (positive): payload binders take the DECLARED type (not a fresh var).
// Uses int payloads (a separate pre-existing codegen bug mangles FLOAT payloads routed through `any` —
// tracked as CORE_GAP enum-float-payload-unbox; orthogonal to this type-soundness change).
enum Cmd
    Move(dx: int, dy: int)
    Wait(ticks: int)
    Stop

fn main()
    match Move(3, 4)
        Move(dx, dy) => print("move sum=" + str(dx + dy))
        _ => print("?")
    match Wait(10)
        Wait(t) => print("wait=" + str(t))
        _ => print("?")
    print("_enum_payload_ok_test passed")
