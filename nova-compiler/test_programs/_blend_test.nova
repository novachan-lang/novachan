// KAT for std/color/blend — color blending / mixing.
// All known-answer values verified by hand against spec formulas.
import std/color/blend

// ckc — check a [r,g,b] list matches expected r,g,b values.
fn ckc(label: str, got: list, wr: int, wg: int, wb: int)
    let gr = got[0]
    let gg = got[1]
    let gb = got[2]
    if gr != wr
        print("FAIL " + label + ".r: got " + str(gr) + " want " + str(wr))
        exit(1)
    if gg != wg
        print("FAIL " + label + ".g: got " + str(gg) + " want " + str(wg))
        exit(1)
    if gb != wb
        print("FAIL " + label + ".b: got " + str(gb) + " want " + str(wb))
        exit(1)

fn main()
    // KAT 1: blnd_mix([0,0,0],[255,255,255],0.5)==[128,128,128]
    // 0 + 0.5*(255-0) = 127.5 -> round = 128
    let black = []
    black.push(0)
    black.push(0)
    black.push(0)
    let white = []
    white.push(255)
    white.push(255)
    white.push(255)
    let mix1 = blnd_mix(black, white, 0.5)
    ckc("blnd_mix_half", mix1, 128, 128, 128)

    // KAT 2: blnd_mix([0,0,0],[100,100,100],0.0)==[0,0,0]
    // t=0 => pure a
    let c100 = []
    c100.push(100)
    c100.push(100)
    c100.push(100)
    let mix2 = blnd_mix(black, c100, 0.0)
    ckc("blnd_mix_zero_t", mix2, 0, 0, 0)

    // KAT 3: blnd_multiply([255,255,255],[128,64,32])==[128,64,32]
    // 255*128/255=128, 255*64/255=64, 255*32/255=32
    let a3 = []
    a3.push(255)
    a3.push(255)
    a3.push(255)
    let b3 = []
    b3.push(128)
    b3.push(64)
    b3.push(32)
    let mul1 = blnd_multiply(a3, b3)
    ckc("blnd_multiply_white_base", mul1, 128, 64, 32)

    // KAT 4: blnd_multiply([0,0,0],[128,128,128])==[0,0,0]
    // 0*128/255=0 for all channels
    let b4 = []
    b4.push(128)
    b4.push(128)
    b4.push(128)
    let mul2 = blnd_multiply(black, b4)
    ckc("blnd_multiply_black_base", mul2, 0, 0, 0)

    // KAT 5: blnd_screen([0,0,0],[128,64,32])==[128,64,32]
    // 255-(255-0)*(255-128)/255 = 255-255*127/255 = 255-127=128
    // 255-(255-0)*(255-64)/255  = 255-255*191/255 = 255-191=64
    // 255-(255-0)*(255-32)/255  = 255-255*223/255 = 255-223=32
    let b5 = []
    b5.push(128)
    b5.push(64)
    b5.push(32)
    let scr1 = blnd_screen(black, b5)
    ckc("blnd_screen_black_base", scr1, 128, 64, 32)

    // KAT 6: blnd_add([200,200,200],[100,100,100])==[255,255,255]
    // 200+100=300, clamped to 255
    let a6 = []
    a6.push(200)
    a6.push(200)
    a6.push(200)
    let b6 = []
    b6.push(100)
    b6.push(100)
    b6.push(100)
    let add1 = blnd_add(a6, b6)
    ckc("blnd_add_clamp", add1, 255, 255, 255)

    // KAT 7: blnd_average([100,200,50],[200,0,150])==[150,100,100]
    // (100+200)/2=150, (200+0)/2=100, (50+150)/2=100
    let a7 = []
    a7.push(100)
    a7.push(200)
    a7.push(50)
    let b7 = []
    b7.push(200)
    b7.push(0)
    b7.push(150)
    let avg1 = blnd_average(a7, b7)
    ckc("blnd_average", avg1, 150, 100, 100)

    // KAT 8: blnd_mix([0,0,0],[255,255,255],1.0)==[255,255,255] (t=1 => pure b)
    let mix3 = blnd_mix(black, white, 1.0)
    ckc("blnd_mix_full_t", mix3, 255, 255, 255)

    // KAT 9: blnd_screen([255,255,255],[128,64,32])==[255,255,255]
    // 255-(255-255)*(255-128)/255 = 255-0=255 for all channels
    let a9 = []
    a9.push(255)
    a9.push(255)
    a9.push(255)
    let b9 = []
    b9.push(128)
    b9.push(64)
    b9.push(32)
    let scr2 = blnd_screen(a9, b9)
    ckc("blnd_screen_white_base", scr2, 255, 255, 255)

    // KAT 10: blnd_overlay([128,64,32],[255,255,255])
    // channel 128: a>=128 -> 255 - 2*(255-128)*(255-255)/255 = 255-0 = 255
    // channel 64:  a<128  -> 2*64*255/255 = 128
    // channel 32:  a<128  -> 2*32*255/255 = 64
    let a10 = []
    a10.push(128)
    a10.push(64)
    a10.push(32)
    let b10 = []
    b10.push(255)
    b10.push(255)
    b10.push(255)
    let ov1 = blnd_overlay(a10, b10)
    ckc("blnd_overlay_white_blend", ov1, 255, 128, 64)

    print("_blend_test passed")
