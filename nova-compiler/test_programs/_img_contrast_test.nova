// KAT for std/image/img_contrast — contrast adjustment and threshold.
import std/image/img_contrast

fn chk_list(label: str, got: list, want: list)
    let ng = len(got)
    let nw = len(want)
    if ng != nw
        print("FAIL " + label + " len: got " + str(ng) + " want " + str(nw))
        exit(1)
    let i = 0
    while i < nw
        let gv = got[i]
        let wv = want[i]
        if gv != wv
            print("FAIL " + label + "[" + str(i) + "]: got " + str(gv) + " want " + str(wv))
            exit(1)
        i = i + 1

fn main()
    // KAT 1: img_contrast([128,128], 200) == [128,128]
    // pivot at 128: (128-128)*200/100 = 0 -> 128+0 = 128
    let px1 = []
    px1.push(128)
    px1.push(128)
    let c1 = img_contrast(px1, 200)
    let w1 = []
    w1.push(128)
    w1.push(128)
    chk_list("contrast_pivot_unchanged", c1, w1)

    // KAT 2: img_contrast([100,156], 200) == [72,184]
    // 100: 128 + (100-128)*200/100 = 128 + (-28)*2 = 128-56 = 72
    // 156: 128 + (156-128)*200/100 = 128 + 28*2 = 128+56 = 184
    let px2 = []
    px2.push(100)
    px2.push(156)
    let c2 = img_contrast(px2, 200)
    let w2 = []
    w2.push(72)
    w2.push(184)
    chk_list("contrast_double", c2, w2)

    // KAT 3: img_threshold([100,200], 128) == [0,255]
    // 100 < 128 -> 0; 200 >= 128 -> 255
    let px3 = []
    px3.push(100)
    px3.push(200)
    let t3 = img_threshold(px3, 128)
    let w3 = []
    w3.push(0)
    w3.push(255)
    chk_list("threshold_basic", t3, w3)

    // KAT 4: img_contrast([0,255], 100) == [0,255]  (identity factor)
    // 0: 128 + (0-128)*100/100 = 128-128 = 0
    // 255: 128 + (255-128)*100/100 = 128+127 = 255
    let px4 = []
    px4.push(0)
    px4.push(255)
    let c4 = img_contrast(px4, 100)
    let w4 = []
    w4.push(0)
    w4.push(255)
    chk_list("contrast_identity", c4, w4)

    // KAT 5: img_contrast([0,255], 200) clamped extremes
    // 0: 128 + (0-128)*2 = 128-256 = -128 -> clamp 0
    // 255: 128 + (255-128)*2 = 128+254 = 382 -> clamp 255
    let px5 = []
    px5.push(0)
    px5.push(255)
    let c5 = img_contrast(px5, 200)
    let w5 = []
    w5.push(0)
    w5.push(255)
    chk_list("contrast_clamp_extremes", c5, w5)

    // KAT 6: img_threshold([127,128,0,255], 128) == [0,255,0,255]
    // 127<128->0; 128>=128->255; 0<128->0; 255>=128->255
    let px6 = []
    px6.push(127)
    px6.push(128)
    px6.push(0)
    px6.push(255)
    let t6 = img_threshold(px6, 128)
    let w6 = []
    w6.push(0)
    w6.push(255)
    w6.push(0)
    w6.push(255)
    chk_list("threshold_boundary", t6, w6)

    // KAT 7: img_contrast([64,192], 50) half-contrast
    // 64: 128 + (64-128)*50/100 = 128 + (-64)*50/100 = 128 + (-3200/100) = 128-32 = 96
    // 192: 128 + (192-128)*50/100 = 128 + 64*50/100 = 128+32 = 160
    let px7 = []
    px7.push(64)
    px7.push(192)
    let c7 = img_contrast(px7, 50)
    let w7 = []
    w7.push(96)
    w7.push(160)
    chk_list("contrast_half", c7, w7)

    print("PASS _img_contrast_test")
