// TCP socket test — loopback echo
// This test spawns a server that accepts one connection, echoes data, and closes.

fn run_server(port)
    server = tcp_listen(port)
    client = tcp_accept(server)
    data = tcp_recv(client)
    tcp_send(client, "ECHO:" + data)
    tcp_close(client)
    tcp_close(server)

// Use a high port to avoid conflicts
port = 19876

// Spawn server in a separate process
spawn fn()
    run_server(port)

// Give server time to start
sleep(100)

// Client connects
sock = tcp_connect("127.0.0.1", port)
tcp_send(sock, "hello")
reply = tcp_recv(sock)
tcp_close(sock)

assert(reply == "ECHO:hello", "tcp echo")
print("TCP: ALL PASSED")
