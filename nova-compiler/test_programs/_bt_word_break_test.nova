import std/backtracking/bt_word_break

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL _bt_word_break_test " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL _bt_word_break_test " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL _bt_word_break_test " + label + ": got=" + got + " want=" + want)
        exit(1)

fn main()
    // --- wb_can_break ---
    // "leetcode" with ["leet","code"] => true (leet+code)
    let d1 = ["leet", "code"]
    ckb("can_leetcode", wb_can_break("leetcode", d1), true)

    // "catsand" with ["cat","dog"] => false (no "sand" or "and")
    let d2 = ["cat", "dog"]
    ckb("can_catsand_false", wb_can_break("catsand", d2), false)

    // empty string is always breakable
    ckb("can_empty", wb_can_break("", d1), true)

    // single word in dict
    let d3 = ["hello"]
    ckb("can_hello", wb_can_break("hello", d3), true)
    ckb("can_hell_no", wb_can_break("hell", d3), false)

    // --- wb_count ---
    // "catsanddog" with ["cat","cats","and","sand","dog"] = 2
    // segmentations: "cat sand dog" and "cats and dog"
    let d4 = ["cat", "cats", "and", "sand", "dog"]
    cki("count_catsanddog", wb_count("catsanddog", d4), 2)

    // empty string = 1 (the empty segmentation)
    cki("count_empty", wb_count("", d4), 1)

    // "aaa" with ["a","aa"] = 3: "a a a", "a aa", "aa a"
    let d5 = ["a", "aa"]
    cki("count_aaa", wb_count("aaa", d5), 3)

    // impossible string = 0
    let d6 = ["foo", "bar"]
    cki("count_impossible", wb_count("xyz", d6), 0)

    // --- wb_all_breaks (exact results for small inputs) ---
    // "leetcode" has exactly 1 segmentation: "leet code"
    let breaks1 = wb_all_breaks("leetcode", d1)
    cki("all_leetcode_len", len(breaks1), 1)
    cks("all_leetcode_0", breaks1[0], "leet code")

    // empty string has 1 segmentation: ""
    let breaks_empty = wb_all_breaks("", d1)
    cki("all_empty_len", len(breaks_empty), 1)
    cks("all_empty_0", breaks_empty[0], "")

    // "ab" not in dict = no segmentations
    let d7 = ["a"]
    let breaks_no = wb_all_breaks("ab", d7)
    cki("all_no_len", len(breaks_no), 0)

    // "aa" with ["a","aa"] = ["a a","aa"] — 2 results in DFS order
    let breaks_aa = wb_all_breaks("aa", d5)
    cki("all_aa_len", len(breaks_aa), 2)
    cks("all_aa_0", breaks_aa[0], "a a")
    cks("all_aa_1", breaks_aa[1], "aa")

    print("PASS _bt_word_break_test")
