import forge_request_log

fn main()
    let rl = rl_new()
    assert(rl_total(rl) == 0, "empty")

    rl = rl_log(rl, "GET", "/api/users", 200, 15)
    rl = rl_log(rl, "POST", "/api/users", 201, 45)
    rl = rl_log(rl, "GET", "/api/items", 200, 8)
    rl = rl_log(rl, "GET", "/api/missing", 404, 5)
    rl = rl_log(rl, "POST", "/api/crash", 500, 200)
    assert(rl_total(rl) == 5, "5 requests")

    let gets = rl_by_method(rl, "GET")
    assert(len(gets) == 3, "3 GETs")

    let posts = rl_by_method(rl, "POST")
    assert(len(posts) == 2, "2 POSTs")

    let ok = rl_by_status(rl, 200)
    assert(len(ok) == 2, "2 x 200")

    let errs = rl_errors(rl)
    assert(len(errs) == 2, "2 errors (404+500)")
    assert(rl_error_count(rl) == 2, "error count=2")

    let avg = rl_avg_duration(rl)
    assert(avg == 54, "avg=54ms (273/5)")

    let slowest = rl_slowest(rl)
    assert(slowest["duration_ms"] == 200, "slowest=200ms")
    assert(slowest["path"] == "/api/crash", "slowest path")

    let last2 = rl_last_n(rl, 2)
    assert(len(last2) == 2, "last 2")
    assert(last2[1]["status"] == 500, "last=500")

    let last10 = rl_last_n(rl, 10)
    assert(len(last10) == 5, "all 5 returned")

    print("REQUEST-LOG KAT PASS")
