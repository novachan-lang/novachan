// KAT for std/chem/nuclear — nuclear decay and radioactivity formulas.
import std/chem/nuclear

// approx — float equality within tolerance.
fn approx(a, b, tol)
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    return d < tol

fn ckf(label, got, want, tol)
    if not approx(got, want, tol)
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn main()
    // decay_remaining: after 1 half-life -> 50% remains
    ckf("decay_remaining(100,10,10)", decay_remaining(100.0, 10.0, 10.0), 50.0, 0.01)
    // after 2 half-lives -> 25% remains
    ckf("decay_remaining(100,10,20)", decay_remaining(100.0, 10.0, 20.0), 25.0, 0.01)
    // after 0 time -> 100% remains
    ckf("decay_remaining(100,10,0)", decay_remaining(100.0, 10.0, 0.0), 100.0, 0.01)
    // after 3 half-lives -> 12.5% remains
    ckf("decay_remaining(100,10,30)", decay_remaining(100.0, 10.0, 30.0), 12.5, 0.01)

    // half_lives_elapsed: 30 / 10 = 3.0
    ckf("half_lives_elapsed(30,10)", half_lives_elapsed(30.0, 10.0), 3.0, 0.001)
    ckf("half_lives_elapsed(0,10)", half_lives_elapsed(0.0, 10.0), 0.0, 0.001)
    ckf("half_lives_elapsed(5,10)", half_lives_elapsed(5.0, 10.0), 0.5, 0.001)

    // decay_constant: 0.693 / half_life
    // half_life=0.693 -> lambda = 0.693/0.693 = 1.0
    ckf("decay_constant(0.693)", decay_constant(0.693), 1.0, 0.01)
    // half_life=1.386 -> lambda = 0.693/1.386 = 0.5
    ckf("decay_constant(1.386)", decay_constant(1.386), 0.5, 0.01)

    // activity: A = N * lambda
    ckf("activity(1000,0.5)", activity(1000.0, 0.5), 500.0, 0.001)
    ckf("activity(0,1.0)", activity(0.0, 1.0), 0.0, 0.001)

    print("PASS _nuclear_test")
