// Real TLS client oracle: a genuine HTTPS request to example.com.
// Oracle: the decrypted response MUST start with "HTTP/" — only possible
// if the TLS handshake + record decryption are real (a plaintext stub fails).
fn main()
    let conn = tls_connect("www.example.com", 443)
    assert_eq(conn != 0, true)
    print("TLS handshake OK")
    let req = "GET / HTTP/1.1\r\nHost: www.example.com\r\nConnection: close\r\n\r\n"
    let sent = tls_send(conn, req)
    assert_eq(sent > 0, true)
    let resp = tls_recv(conn, 65536)
    let head = slice(resp, 0, 15)
    print("decrypted response starts: {head}")
    assert_eq(starts_with(resp, "HTTP/"), true)
    tls_close(conn)
    print("TLS client test passed: real HTTPS response decrypted")
