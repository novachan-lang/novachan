import std/compress/gzip_member

fn main()
    let buf = []
    push(buf, 31)
    push(buf, 139)
    push(buf, 8)
    push(buf, 8)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 0)
    push(buf, 3)
    let f = gz_flags(buf)
    print("flags=" + str(f))
    let fb = f & 8
    print("f&8=" + str(fb))
    if (f & 8) == 8
        print("fname IS set")
    else
        print("fname NOT set")
    print("PASS _gzdbg_test")
