// KAT for std/textlayout/textcenter — centering utilities.
import std/textlayout/textcenter

fn cks(label, got, want)
    if got != want
        print("FAIL textcenter " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL textcenter " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    let nl = chr(10)

    // tcen_offset
    cki("offset1", tcen_offset(2, 6), 2)
    cki("offset2", tcen_offset(2, 5), 1)
    cki("offset3", tcen_offset(3, 3), 0)
    cki("offset4", tcen_offset(0, 4), 2)

    // tcen_center: right-heavy (odd extra goes right)
    cks("ctr1", tcen_center("hi", 6), "  hi  ")
    cks("ctr2", tcen_center("hi", 5), " hi  ")
    cks("ctr3", tcen_center("abc", 3), "abc")
    cks("ctr4", tcen_center("x", 4), " x  ")
    cks("ctr5", tcen_center("ab", 2), "ab")

    // tcen_center_left_bias: odd extra goes left
    cks("lbias1", tcen_center_left_bias("hi", 5), "  hi ")
    cks("lbias2", tcen_center_left_bias("hi", 6), "  hi  ")

    // tcen_pad_both
    cks("pad1", tcen_pad_both("x", 2, 3), "  x   ")
    cks("pad2", tcen_pad_both("ab", 0, 0), "ab")

    // tcen_center_in: custom fill char
    cks("cin1", tcen_center_in("hi", 6, "*"), "**hi**")
    cks("cin2", tcen_center_in("hi", 5, "*"), "*hi**")
    cks("cin3", tcen_center_in("abc", 3, "-"), "abc")

    // tcen_banner: alias for center_in
    cks("banner1", tcen_banner("AB", 6, "-"), "--AB--")
    cks("banner2", tcen_banner("AB", 8, "="), "===AB===")

    // tcen_center_block: each line centered independently
    let block = tcen_center_block("a" + nl + "bb", 4)
    let lines = split(block, nl)
    // "a" in width 4: 3 total pad, left=1, right=2 -> " a  "
    cks("block_line0", lines[0], " a  ")
    // "bb" in width 4: 2 total pad, left=1, right=1 -> " bb "
    cks("block_line1", lines[1], " bb ")

    print("PASS _textcenter_test")
