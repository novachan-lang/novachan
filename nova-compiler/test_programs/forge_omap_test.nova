import forge_omap

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn expect_true(name: string, cond: bool) -> int
    if cond
        return 0
    print("FAIL " + name + ": expected true")
    1

fn expect_false(name: string, cond: bool) -> int
    if cond
        print("FAIL " + name + ": expected false")
        return 1
    0

// render a pair or null
fn pstr(p) -> string
    if p == null
        return "nil"
    str(p[0]) + "=" + str(p[1])


fn join_ints(lst) -> string
    let parts = []
    let i = 0
    while i < len(lst)
        push(parts, str(lst[i]))
        i = i + 1
    join(parts, ",")

fn main()
    let fails = 0
    let m = omap_new()

    // insert out of order
    omap_set(m, 5, "five")
    omap_set(m, 1, "one")
    omap_set(m, 7, "seven")
    omap_set(m, 3, "three")
    fails = fails + expect("len4", str(omap_len(m)), "4")
    fails = fails + expect("sorted_keys", join_ints(omap_keys(m)), "1,3,5,7")
    fails = fails + expect("sorted_vals", join(omap_values(m), ","), "one,three,five,seven")

    // get
    fails = fails + expect("get5", str(omap_get(m, 5)), "five")
    fails = fails + expect("get1", str(omap_get(m, 1)), "one")
    fails = fails + expect_true("get_missing", omap_get(m, 4) == null)

    // update in place
    omap_set(m, 5, "FIVE")
    fails = fails + expect("update", str(omap_get(m, 5)), "FIVE")
    fails = fails + expect("update_len", str(omap_len(m)), "4")

    // has
    fails = fails + expect_true("has3", omap_has(m, 3))
    fails = fails + expect_false("has4", omap_has(m, 4))

    // floor: keys 1,3,5,7
    fails = fails + expect("floor4", pstr(omap_floor(m, 4)), "3=three")
    fails = fails + expect("floor_exact", pstr(omap_floor(m, 5)), "5=FIVE")
    fails = fails + expect("floor_below", pstr(omap_floor(m, 0)), "nil")
    fails = fails + expect("floor_above", pstr(omap_floor(m, 10)), "7=seven")

    // ceiling
    fails = fails + expect("ceil4", pstr(omap_ceiling(m, 4)), "5=FIVE")
    fails = fails + expect("ceil_exact", pstr(omap_ceiling(m, 3)), "3=three")
    fails = fails + expect("ceil_above", pstr(omap_ceiling(m, 8)), "nil")
    fails = fails + expect("ceil_below", pstr(omap_ceiling(m, 0)), "1=one")

    // min/max
    fails = fails + expect("min", pstr(omap_min(m)), "1=one")
    fails = fails + expect("max", pstr(omap_max(m)), "7=seven")

    // range [2,6] -> keys 3,5
    let rg = omap_range(m, 2, 6)
    fails = fails + expect("range", str(rg[0][0]) + "," + str(rg[1][0]), "3,5")
    fails = fails + expect("range_len", str(len(rg)), "2")

    // delete
    fails = fails + expect_true("del3", omap_del(m, 3))
    fails = fails + expect_false("has3_after", omap_has(m, 3))
    fails = fails + expect("del_keys", join_ints(omap_keys(m)), "1,5,7")
    fails = fails + expect_false("del_missing", omap_del(m, 99))

    // empty map queries
    let e = omap_new()
    fails = fails + expect_true("empty_get", omap_get(e, 1) == null)
    fails = fails + expect_true("empty_floor", omap_floor(e, 1) == null)
    fails = fails + expect_true("empty_min", omap_min(e) == null)
    fails = fails + expect("empty_len", str(omap_len(e)), "0")

    // STRING keys (lexicographic)
    let s = omap_new()
    omap_set(s, "banana", 2)
    omap_set(s, "apple", 1)
    omap_set(s, "cherry", 3)
    fails = fails + expect("str_keys", join(omap_keys(s), ","), "apple,banana,cherry")
    fails = fails + expect("str_get", str(omap_get(s, "banana")), "2")
    fails = fails + expect("str_floor", pstr(omap_floor(s, "carrot")), "banana=2")
    fails = fails + expect("str_ceil", pstr(omap_ceiling(s, "aardvark")), "apple=1")

    if fails == 0
        print("forge_omap: all passed")
    else
        print("forge_omap: " + str(fails) + " FAILED")
