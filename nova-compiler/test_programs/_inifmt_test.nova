// KAT probe for std/encoding/inifmt — INI config parser/serializer.
// All expected values are HAND-COMPUTED from the spec.
import std/encoding/inifmt

fn cks(label, got, want)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// ── KAT 1-3: spec example parse ──────────────────────────────────────────────
// "[a]\nx=1\ny=2\n; c\n[b]\nz=3"
// Hand-computed:
//   section "a": x->1, y->2
//   section "b": z->3
//   "; c" is a comment line — ignored
fn kat1_3()
    let nl = chr(10)
    let text = "[a]" + nl + "x=1" + nl + "y=2" + nl + "; c" + nl + "[b]" + nl + "z=3"
    let p = ini_parse(text)
    cks("kat1-a-x", ini_get(p, "a", "x"), "1")
    print("KAT 1 PASS: ini_get(p,'a','x') == '1'")
    cks("kat2-a-y", ini_get(p, "a", "y"), "2")
    print("KAT 2 PASS: ini_get(p,'a','y') == '2'")
    cks("kat3-b-z", ini_get(p, "b", "z"), "3")
    print("KAT 3 PASS: ini_get(p,'b','z') == '3'")

// ── KAT 4: ini_sections includes "a" and "b" ─────────────────────────────────
// Same parse. Hand-computed: exactly 2 sections: "a" and "b".
fn kat4()
    let nl = chr(10)
    let text = "[a]" + nl + "x=1" + nl + "y=2" + nl + "; c" + nl + "[b]" + nl + "z=3"
    let p = ini_parse(text)
    let secs = ini_sections(p)
    cki("kat4-sec-count", len(secs), 2)
    // Verify "a" and "b" are in the list
    let found_a = 0
    let found_b = 0
    let i = 0
    while i < len(secs)
        if secs[i] == "a"
            found_a = 1
        if secs[i] == "b"
            found_b = 1
        i = i + 1
    cki("kat4-has-a", found_a, 1)
    cki("kat4-has-b", found_b, 1)
    print("KAT 4 PASS: ini_sections includes 'a' and 'b', count=2")

// ── KAT 5: round-trip parse(serialize(p)) preserves values ───────────────────
// Hand-computed: serialize produces valid INI text; re-parsing yields same values.
fn kat5()
    let nl = chr(10)
    let text = "[a]" + nl + "x=1" + nl + "y=2" + nl + "; c" + nl + "[b]" + nl + "z=3"
    let p = ini_parse(text)
    let serialized = ini_serialize(p)
    let p2 = ini_parse(serialized)
    cks("kat5-rt-a-x", ini_get(p2, "a", "x"), "1")
    cks("kat5-rt-a-y", ini_get(p2, "a", "y"), "2")
    cks("kat5-rt-b-z", ini_get(p2, "b", "z"), "3")
    print("KAT 5 PASS: round-trip parse(serialize(p)) preserves all values")

// ── KAT 6: default section "" for pre-section keys ───────────────────────────
// Input: "foo=bar\n[s]\nk=v"
// Hand-computed: section "" has foo->bar; section "s" has k->v
fn kat6()
    let nl = chr(10)
    let text = "foo=bar" + nl + "[s]" + nl + "k=v"
    let p = ini_parse(text)
    cks("kat6-default-foo", ini_get(p, "", "foo"), "bar")
    cks("kat6-s-k", ini_get(p, "s", "k"), "v")
    print("KAT 6 PASS: default section '' captures pre-header keys")

// ── KAT 7: missing section/key returns "" ────────────────────────────────────
// Hand-computed: no section "z" and no key "nope" in "a" -> both return ""
fn kat7()
    let nl = chr(10)
    let text = "[a]" + nl + "x=1"
    let p = ini_parse(text)
    cks("kat7-missing-sec", ini_get(p, "z", "x"), "")
    cks("kat7-missing-key", ini_get(p, "a", "nope"), "")
    print("KAT 7 PASS: missing section and missing key both return ''")

// ── KAT 8: whitespace trimming around keys and values ────────────────────────
// Input: "[sect]\n  key  =  value  \n"
// Hand-computed: key="key", value="value" (trimmed on both sides)
fn kat8()
    let nl = chr(10)
    let text = "[sect]" + nl + "  key  =  value  " + nl
    let p = ini_parse(text)
    cks("kat8-trimmed-key", ini_get(p, "sect", "key"), "value")
    print("KAT 8 PASS: whitespace around key and value is trimmed")

// ── KAT 9: '#' comment and blank lines are ignored ───────────────────────────
// Input: "# header comment\n\n[sec]\n# another comment\nk=hello\n\n"
// Hand-computed: section "sec" has k->hello; comments and blanks skipped
fn kat9()
    let nl = chr(10)
    let text = "# header comment" + nl + nl + "[sec]" + nl + "# another comment" + nl + "k=hello" + nl + nl
    let p = ini_parse(text)
    cks("kat9-k", ini_get(p, "sec", "k"), "hello")
    let secs = ini_sections(p)
    cki("kat9-sec-count", len(secs), 1)
    print("KAT 9 PASS: '#' comments and blank lines correctly ignored")

// ── KAT 10: CRLF line endings work the same as LF ───────────────────────────
// Input uses cr+lf between lines. Hand-computed: same parse result as LF.
fn kat10()
    let nl = chr(13) + chr(10)
    let text = "[cfg]" + nl + "host=localhost" + nl + "port=8080" + nl
    let p = ini_parse(text)
    cks("kat10-host", ini_get(p, "cfg", "host"), "localhost")
    cks("kat10-port", ini_get(p, "cfg", "port"), "8080")
    print("KAT 10 PASS: CRLF line endings parsed correctly")

fn main()
    kat1_3()
    kat4()
    kat5()
    kat6()
    kat7()
    kat8()
    kat9()
    kat10()
    print("_inifmt_test passed")
