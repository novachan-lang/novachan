fn main()
    let d = {}
    d["n"] = null
    print("null value   : type_name={type_name(d["n"])} str={str(d["n"])} is_null={d["n"] == null}")
    print("missing key  : type_name={type_name(d["gone"])} str={str(d["gone"])} is_null={d["gone"] == null}")
    print("keys present : {str(keys(d))}")
    print("'n' in d     : {"n" in d}")
    print("'gone' in d  : {"gone" in d}")
