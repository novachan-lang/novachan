// More compute tests for WASM verification

fn gcd(a: int, b: int) -> int
    if b == 0
        return a
    return gcd(b, a - (a / b) * b)

fn is_prime(n: int) -> int
    if n < 2
        return 0
    let i = 2
    while i * i <= n
        if n - (n / i) * i == 0
            return 0
        i = i + 1
    return 1

fn count_primes(limit: int) -> int
    let cnt = 0
    let i = 2
    while i <= limit
        if is_prime(i) == 1
            cnt = cnt + 1
        i = i + 1
    return cnt

fn main()
    let g = gcd(48, 18)
    let p = count_primes(100)
    return g * 1000 + p
