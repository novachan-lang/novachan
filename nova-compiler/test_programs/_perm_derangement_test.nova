import std/permutation/perm_derangement

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckb(label: string, got: bool, want: bool)
    let gi = 0
    let wi = 0
    if got
        gi = 1
    if want
        wi = 1
    if gi != wi
        print("FAIL " + label + ": got=" + str(gi) + " want=" + str(wi))
        exit(1)

fn main()
    // --- pd_is_derangement ---
    // [1,2,0]: 0->1,1->2,2->0 => no fixed points => true
    ckb("is_der([1,2,0])", pd_is_derangement([1, 2, 0]), true)

    // [0,2,1]: 0->0 => fixed point => false
    ckb("is_der([0,2,1])", pd_is_derangement([0, 2, 1]), false)

    // [1,0,3,2]: 0->1,1->0,2->3,3->2 => no fixed points => true
    ckb("is_der([1,0,3,2])", pd_is_derangement([1, 0, 3, 2]), true)

    // identity [0,1,2] => all fixed => false
    ckb("is_der(identity)", pd_is_derangement([0, 1, 2]), false)

    // empty permutation [] => vacuously true (no elements to be fixed)
    ckb("is_der([])", pd_is_derangement([]), true)

    // single element [0] => 0 maps to 0 => fixed point => false
    ckb("is_der([0])", pd_is_derangement([0]), false)

    // [2,0,1]: 0->2,1->0,2->1 => no fixed points => true
    ckb("is_der([2,0,1])", pd_is_derangement([2, 0, 1]), true)

    // --- pd_fixed_free (alias) ---
    ckb("fixed_free([1,2,0])", pd_fixed_free([1, 2, 0]), true)
    ckb("fixed_free([0,2,1])", pd_fixed_free([0, 2, 1]), false)
    ckb("fixed_free([1,0,3,2])", pd_fixed_free([1, 0, 3, 2]), true)

    // --- pd_count ---
    // D_0=1, D_1=0, D_2=1, D_3=2, D_4=9, D_5=44
    cki("count(0)", pd_count(0), 1)
    cki("count(1)", pd_count(1), 0)
    cki("count(2)", pd_count(2), 1)
    cki("count(3)", pd_count(3), 2)
    cki("count(4)", pd_count(4), 9)
    cki("count(5)", pd_count(5), 44)
    // D_6 = 5*(44+9) = 5*53 = 265
    cki("count(6)", pd_count(6), 265)
    // D_7 = 6*(265+44) = 6*309 = 1854
    cki("count(7)", pd_count(7), 1854)
    // D_8 = 7*(1854+265) = 7*2119 = 14833
    cki("count(8)", pd_count(8), 14833)

    print("PASS _perm_derangement_test")
