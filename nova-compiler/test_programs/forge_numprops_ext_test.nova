import forge_numprops

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

fn main()
    let fails = 0

    // digit_count
    fails = fails + expect("dc0", str(digit_count(0)), "1")
    fails = fails + expect("dc5", str(digit_count(5)), "1")
    fails = fails + expect("dc123", str(digit_count(123)), "3")
    fails = fails + expect("dc_neg", str(digit_count(0 - 4567)), "4")
    fails = fails + expect("dc_big", str(digit_count(1000000)), "7")

    // reverse_digits
    fails = fails + expect("rev123", str(reverse_digits(123)), "321")
    fails = fails + expect("rev1230", str(reverse_digits(1230)), "321")
    fails = fails + expect("rev_neg", str(reverse_digits(0 - 45)), "-54")
    fails = fails + expect("rev_single", str(reverse_digits(7)), "7")
    fails = fails + expect("rev_zero", str(reverse_digits(0)), "0")
    fails = fails + expect("rev_palin", str(reverse_digits(12321)), "12321")

    // nth_digit (0-indexed from right)
    fails = fails + expect("nd0", str(nth_digit(4567, 0)), "7")
    fails = fails + expect("nd1", str(nth_digit(4567, 1)), "6")
    fails = fails + expect("nd2", str(nth_digit(4567, 2)), "5")
    fails = fails + expect("nd3", str(nth_digit(4567, 3)), "4")
    fails = fails + expect("nd_oob", str(nth_digit(4567, 5)), "0")
    fails = fails + expect("nd_neg", str(nth_digit(0 - 89, 1)), "8")

    if fails == 0
        print("forge_numprops_ext: all passed")
    else
        print("forge_numprops_ext: " + str(fails) + " FAILED")
