// Bootstrap test 10: match/pattern matching on structs
type Token
    kind: string
    value: string

fn describe(tok: Token) -> string
    match tok
        Token(k, v) =>
            return k + ":" + v
    return "unknown"

let t = Token("ident", "hello")
print(describe(t))

let t2 = Token("num", "42")
print(describe(t2))
