// showcase_shapes — SHOWCASE + gated type-system stress test.
// Dogfoods NOVA's TYPE-SYSTEM features together, the feature-combination no isolated test covers:
//   - enum/ADT with payloads      (Shape = Circle | Rect | Triangle)
//   - exhaustive pattern matching  (area via `match`)
//   - traits + method dispatch     (Describable, TypeName__method)
//   - generics with a trait bound  (fn<T: Describable> render)
//   - the built-in Result ADT      (ok/err + match Ok/Err) for a validating constructor
//   - enum values stored in a list, retrieved, and re-matched
// Also exercises sqrt-in-a-helper (Heron's formula) — a known float-return-uninit (0.11) hot spot.

enum Shape
    Circle(r: float)
    Rect(w: float, h: float)
    Triangle(a: float, b: float, c: float)

// Heron's area. sqrt bound to a `let` before return (the 0.11-safe pattern).
fn tri_area(a: float, b: float, c: float) -> float
    let s = (a + b + c) / 2.0
    let inside = s * (s - a) * (s - b) * (s - c)
    let ar = sqrt(inside)
    return ar

fn area(shape) -> float
    match shape
        Circle(r) => 3.141592653589793 * r * r
        Rect(w, h) => w * h
        Triangle(a, b, c) => tri_area(a, b, c)

// A validating constructor that returns Result: degenerate triangles become Err, never a bad Shape.
fn make_triangle(a: float, b: float, c: float)
    if a + b <= c
        return err("degenerate")
    if a + c <= b
        return err("degenerate")
    if b + c <= a
        return err("degenerate")
    return ok(Triangle(a, b, c))

fn result_tag(r) -> string
    match r
        Ok(v) => "ok"
        Err(e) => "err:" + e

// trait + a type implementing it + generic dispatch
trait Describable
    fn describe(self) -> string

type Labeled : Describable
    label: string
    value: float

fn Labeled__describe(self: Labeled) -> string
    return self.label + "=" + str(self.value)

fn<T: Describable> render(item: T) -> string
    return item.describe()

fn ckf(label: string, got: float, want: float)
    let d = got - want
    if d < 0.0
        d = 0.0 - d
    if d > 0.001
        print("FAIL " + label + ": " + str(got) + " != " + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    // (1) enum + exhaustive match: areas
    ckf("circle", area(Circle(2.0)), 12.566370614)
    ckf("rect", area(Rect(3.0, 4.0)), 12.0)
    ckf("triangle", area(Triangle(3.0, 4.0, 5.0)), 6.0)

    // (2) enum values stored in a list, retrieved, re-matched
    let shapes = []
    shapes.push(Circle(1.0))
    shapes.push(Rect(2.0, 3.0))
    shapes.push(Triangle(3.0, 4.0, 5.0))
    let total = 0.0
    let i = 0
    while i < len(shapes)
        total = total + area(shapes[i])
        i = i + 1
    ckf("total", total, 3.141592653589793 + 6.0 + 6.0)

    // (3) trait + generic dispatch
    let lab = Labeled("mass", 5.5)
    let r = render(lab)
    if find(r, "mass=") < 0
        print("FAIL render label: " + r)
        exit(1)
    if find(r, "5.5") < 0
        print("FAIL render value: " + r)
        exit(1)

    // (4) Result ADT: valid vs degenerate constructors
    cks("valid-tri", result_tag(make_triangle(3.0, 4.0, 5.0)), "ok")
    cks("degenerate-tri", result_tag(make_triangle(1.0, 1.0, 5.0)), "err:degenerate")

    print("areas: circle(2)=" + str(area(Circle(2.0))) + " rect(3x4)=" + str(area(Rect(3.0, 4.0))) + " tri(3,4,5)=" + str(area(Triangle(3.0, 4.0, 5.0))))
    print("total of 3 shapes = " + str(total))
    print("render(Labeled) = " + r)
    print("showcase_shapes_test passed")
