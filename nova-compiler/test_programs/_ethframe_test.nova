// KAT: std/net/ethframe — Ethernet II + 802.1Q frame header codec
// Known-answer tests with exact byte vectors.
import std/net/ethframe

fn main()
    // ── Build canonical test MACs ─────────────────────────────────────────────
    // dst: FF:FF:FF:FF:FF:FF  (broadcast)
    let dst = bytes(6)
    bytes_set(dst, 0, 0xFF)
    bytes_set(dst, 1, 0xFF)
    bytes_set(dst, 2, 0xFF)
    bytes_set(dst, 3, 0xFF)
    bytes_set(dst, 4, 0xFF)
    bytes_set(dst, 5, 0xFF)

    // src: 00:00:00:00:00:01
    let src = bytes(6)
    bytes_set(src, 0, 0x00)
    bytes_set(src, 1, 0x00)
    bytes_set(src, 2, 0x00)
    bytes_set(src, 3, 0x00)
    bytes_set(src, 4, 0x00)
    bytes_set(src, 5, 0x01)

    // ── Test 1: eth_encode length ─────────────────────────────────────────────
    let hdr14 = eth_encode(dst, src, 0x0800)
    if bytes_len(hdr14) != 14
        print("FAIL ethframe eth_encode len: got " + str(bytes_len(hdr14)) + " want 14")
        exit(1)

    // ── Test 2: dst bytes 0..5 all 0xFF ──────────────────────────────────────
    let d0 = bytes_get(hdr14, 0)
    let d1 = bytes_get(hdr14, 1)
    let d2 = bytes_get(hdr14, 2)
    let d3 = bytes_get(hdr14, 3)
    let d4 = bytes_get(hdr14, 4)
    let d5 = bytes_get(hdr14, 5)
    if d0 != 255
        print("FAIL ethframe dst[0]: got " + str(d0) + " want 255")
        exit(1)
    if d1 != 255
        print("FAIL ethframe dst[1]: got " + str(d1) + " want 255")
        exit(1)
    if d2 != 255
        print("FAIL ethframe dst[2]: got " + str(d2) + " want 255")
        exit(1)
    if d3 != 255
        print("FAIL ethframe dst[3]: got " + str(d3) + " want 255")
        exit(1)
    if d4 != 255
        print("FAIL ethframe dst[4]: got " + str(d4) + " want 255")
        exit(1)
    if d5 != 255
        print("FAIL ethframe dst[5]: got " + str(d5) + " want 255")
        exit(1)

    // ── Test 3: src bytes 6..11 ───────────────────────────────────────────────
    let s0 = bytes_get(hdr14, 6)
    let s5 = bytes_get(hdr14, 11)
    if s0 != 0
        print("FAIL ethframe src[0]: got " + str(s0) + " want 0")
        exit(1)
    if s5 != 1
        print("FAIL ethframe src[5]: got " + str(s5) + " want 1")
        exit(1)

    // ── Test 4: ethertype at bytes 12-13 == 0x0800 ───────────────────────────
    let et_hi = bytes_get(hdr14, 12)
    let et_lo = bytes_get(hdr14, 13)
    if et_hi != 8
        print("FAIL ethframe ethertype hi: got " + str(et_hi) + " want 8")
        exit(1)
    if et_lo != 0
        print("FAIL ethframe ethertype lo: got " + str(et_lo) + " want 0")
        exit(1)

    // ── Test 5: eth_encode_vlan length ───────────────────────────────────────
    let hdr18 = eth_encode_vlan(dst, src, 100, 0x0800)
    if bytes_len(hdr18) != 18
        print("FAIL ethframe eth_encode_vlan len: got " + str(bytes_len(hdr18)) + " want 18")
        exit(1)

    // ── Test 6: TPID at bytes 12-13 == 0x8100 ────────────────────────────────
    let tpid_hi = bytes_get(hdr18, 12)
    let tpid_lo = bytes_get(hdr18, 13)
    if tpid_hi != 0x81
        print("FAIL ethframe TPID hi: got " + str(tpid_hi) + " want 129")
        exit(1)
    if tpid_lo != 0x00
        print("FAIL ethframe TPID lo: got " + str(tpid_lo) + " want 0")
        exit(1)

    // ── Test 7: TCI low 12 bits == 100 (vid) ─────────────────────────────────
    let tci_hi = bytes_get(hdr18, 14)
    let tci_lo = bytes_get(hdr18, 15)
    let tci = ((tci_hi << 8) | tci_lo) & 0xFFFF
    let vid_decoded = tci & 0x0FFF
    if vid_decoded != 100
        print("FAIL ethframe VID: got " + str(vid_decoded) + " want 100")
        exit(1)

    // ── Test 8: real ethertype at bytes 16-17 == 0x0800 ──────────────────────
    let ret_hi = bytes_get(hdr18, 16)
    let ret_lo = bytes_get(hdr18, 17)
    if ret_hi != 8
        print("FAIL ethframe vlan ethertype hi: got " + str(ret_hi) + " want 8")
        exit(1)
    if ret_lo != 0
        print("FAIL ethframe vlan ethertype lo: got " + str(ret_lo) + " want 0")
        exit(1)

    // ── Test 9: round-trip plain Ethernet II ─────────────────────────────────
    let dec14 = eth_decode(hdr14)
    if contains(dec14, "ethertype") == 0
        print("FAIL ethframe decode plain: missing ethertype key")
        exit(1)
    let rt_etype = dec14["ethertype"]
    if rt_etype != 0x0800
        print("FAIL ethframe rt ethertype: got " + str(rt_etype) + " want 2048")
        exit(1)
    let rt_vlan = dec14["vlan"]
    if rt_vlan != -1
        print("FAIL ethframe rt vlan (plain): got " + str(rt_vlan) + " want -1")
        exit(1)
    // check dst in decoded result
    let rt_dst = dec14["dst"]
    if bytes_len(rt_dst) != 6
        print("FAIL ethframe rt dst len: got " + str(bytes_len(rt_dst)) + " want 6")
        exit(1)
    if bytes_get(rt_dst, 0) != 0xFF
        print("FAIL ethframe rt dst[0]: got " + str(bytes_get(rt_dst, 0)) + " want 255")
        exit(1)
    if bytes_get(rt_dst, 5) != 0xFF
        print("FAIL ethframe rt dst[5]: got " + str(bytes_get(rt_dst, 5)) + " want 255")
        exit(1)
    // check src in decoded result
    let rt_src = dec14["src"]
    if bytes_len(rt_src) != 6
        print("FAIL ethframe rt src len: got " + str(bytes_len(rt_src)) + " want 6")
        exit(1)
    if bytes_get(rt_src, 0) != 0
        print("FAIL ethframe rt src[0]: got " + str(bytes_get(rt_src, 0)) + " want 0")
        exit(1)
    if bytes_get(rt_src, 5) != 1
        print("FAIL ethframe rt src[5]: got " + str(bytes_get(rt_src, 5)) + " want 1")
        exit(1)

    // ── Test 10: round-trip 802.1Q VLAN ──────────────────────────────────────
    let dec18 = eth_decode(hdr18)
    if contains(dec18, "vlan") == 0
        print("FAIL ethframe decode vlan: missing vlan key")
        exit(1)
    let rt_vlan18 = dec18["vlan"]
    if rt_vlan18 != 100
        print("FAIL ethframe rt vlan: got " + str(rt_vlan18) + " want 100")
        exit(1)
    let rt_etype18 = dec18["ethertype"]
    if rt_etype18 != 0x0800
        print("FAIL ethframe rt vlan ethertype: got " + str(rt_etype18) + " want 2048")
        exit(1)

    // ── Test 11: short input returns empty dict ───────────────────────────────
    let short_b = bytes(6)
    let dec_short = eth_decode(short_b)
    if contains(dec_short, "ethertype")
        print("FAIL ethframe short decode: should return empty dict")
        exit(1)

    // ── Test 12: bad MAC length returns empty bytes ───────────────────────────
    let bad_mac = bytes(3)
    let bad_enc = eth_encode(bad_mac, src, 0x0800)
    if bytes_len(bad_enc) != 0
        print("FAIL ethframe bad dst len: got " + str(bytes_len(bad_enc)) + " want 0")
        exit(1)

    // ── Test 13: VLAN out-of-range returns empty ──────────────────────────────
    let bad_vlan_enc = eth_encode_vlan(dst, src, 5000, 0x0800)
    if bytes_len(bad_vlan_enc) != 0
        print("FAIL ethframe vid out of range: got " + str(bytes_len(bad_vlan_enc)) + " want 0")
        exit(1)

    // ── Test 14: exact byte-level vector for plain header ─────────────────────
    // dst=FF:FF:FF:FF:FF:FF src=00:00:00:00:00:01 etype=0x0800
    // expected wire: FF FF FF FF FF FF 00 00 00 00 00 01 08 00
    let v0 = bytes_get(hdr14, 0)
    let v12 = bytes_get(hdr14, 12)
    let v13 = bytes_get(hdr14, 13)
    if v0 != 0xFF
        print("FAIL ethframe vector byte0: got " + str(v0) + " want 255")
        exit(1)
    if v12 != 0x08
        print("FAIL ethframe vector byte12: got " + str(v12) + " want 8")
        exit(1)
    if v13 != 0x00
        print("FAIL ethframe vector byte13: got " + str(v13) + " want 0")
        exit(1)

    // ── Test 15: ARP EtherType round-trip ────────────────────────────────────
    let hdr_arp = eth_encode(dst, src, 0x0806)
    let dec_arp = eth_decode(hdr_arp)
    let arp_etype = dec_arp["ethertype"]
    if arp_etype != 0x0806
        print("FAIL ethframe ARP ethertype: got " + str(arp_etype) + " want 2054")
        exit(1)

    print("PASS _ethframe_test")
