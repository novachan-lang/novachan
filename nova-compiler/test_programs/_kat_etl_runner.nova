import forge_etl_runner

fn main()
    let e = etl_new()
    e = etl_add_step(e, "read_csv", "extract")
    e = etl_add_step(e, "clean", "transform")
    e = etl_add_step(e, "write_db", "load")
    assert(etl_step_count(e) == 3, "3 steps")

    let n = etl_step_name(e, 0)
    assert(is_ok(n), "step name ok")
    assert(unwrap(n) == "read_csv", "step 0 name")

    let r1 = etl_run_step(e)
    assert(is_ok(r1), "run step 1 ok")
    e = unwrap(r1)
    assert(etl_progress(e) == 33, "33%")

    let r2 = etl_run_step(e)
    e = unwrap(r2)
    let r3 = etl_run_step(e)
    e = unwrap(r3)
    assert(etl_status(e) == "done", "done")
    assert(etl_progress(e) == 100, "100%")

    let r4 = etl_run_step(e)
    assert(is_err(r4), "no more steps is err")

    let bad = etl_step_name(e, 99)
    assert(is_err(bad), "out of range is err")

    print("ETL-RUNNER KAT PASS")
