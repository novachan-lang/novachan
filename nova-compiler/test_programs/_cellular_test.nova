import std/automata/cellular

fn lists_equal(a, b) -> int
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    return 1

fn main()
    // KAT 1: ca_from_string then ca_step rule 90 then ca_to_string.
    // ".#." -> [0,1,0]; step rule 90 -> [1,0,1]; to_string -> "#.#"
    let cells1 = cellular.ca_from_string(".#.")
    let stepped1 = cellular.ca_step(cells1, 90)
    let s1 = cellular.ca_to_string(stepped1)
    if s1 != "#.#"
        print("FAIL KAT1: ca_to_string(ca_step(ca_from_string('.#.'),90)) expected '#.#' got " + s1)
        exit(1)

    // KAT 2: ca_step([0,1,0], 30) == [1,1,1]
    // pattern for cell0: left=0,c=0,r=1 -> 1 -> rule30 bit1 = (30>>1)&1=1
    // pattern for cell1: left=0,c=1,r=0 -> 2 -> rule30 bit2 = (30>>2)&1=1
    // pattern for cell2: left=1,c=0,r=0 -> 4 -> rule30 bit4 = (30>>4)&1=1
    let start2 = [0, 1, 0]
    let stepped2 = cellular.ca_step(start2, 30)
    let expected2 = [1, 1, 1]
    if lists_equal(stepped2, expected2) == 0
        print("FAIL KAT2: ca_step([0,1,0],30) expected [1,1,1]")
        exit(1)

    // KAT 3: ca_to_string(ca_from_string("#.#")) == "#.#"
    let cells3 = cellular.ca_from_string("#.#")
    let s3 = cellular.ca_to_string(cells3)
    if s3 != "#.#"
        print("FAIL KAT3: ca_to_string(ca_from_string('#.#')) expected '#.#' got " + s3)
        exit(1)

    // KAT 4: ca_from_string("101") == [1,0,1]
    let cells4 = cellular.ca_from_string("101")
    let expected4 = [1, 0, 1]
    if lists_equal(cells4, expected4) == 0
        print("FAIL KAT4: ca_from_string('101') expected [1,0,1]")
        exit(1)

    // KAT 5: len(ca_run([0,1,0], 90, 5)) == 5
    let start5 = [0, 1, 0]
    let gens = cellular.ca_run(start5, 90, 5)
    if len(gens) != 5
        print("FAIL KAT5: len(ca_run([0,1,0],90,5)) expected 5 got " + str(len(gens)))
        exit(1)

    // KAT 6: rule 0 makes everything 0: ca_step([1,1,1], 0) == [0,0,0]
    // rule 0: all 8 neighborhoods map to 0 -> every cell becomes 0
    let start6 = [1, 1, 1]
    let stepped6 = cellular.ca_step(start6, 0)
    let expected6 = [0, 0, 0]
    if lists_equal(stepped6, expected6) == 0
        print("FAIL KAT6: ca_step([1,1,1],0) expected [0,0,0]")
        exit(1)

    // KAT 7: rule 255 makes everything 1: ca_step([0,0,0], 255) == [1,1,1]
    // rule 255: all 8 neighborhoods map to 1 -> every cell becomes 1
    let start7 = [0, 0, 0]
    let stepped7 = cellular.ca_step(start7, 255)
    let expected7 = [1, 1, 1]
    if lists_equal(stepped7, expected7) == 0
        print("FAIL KAT7: ca_step([0,0,0],255) expected [1,1,1]")
        exit(1)

    print("_cellular_test passed")
