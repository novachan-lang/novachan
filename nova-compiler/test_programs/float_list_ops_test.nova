// Oracle for box-aware list ops (sort / any / all) on float and bool lists.
// Pre-fix (2026-05-29): sort compared raw int64/box-pointer bits (garbage order on
// floats); any/all read a boxed `false` as a non-null pointer => wrongly truthy.
// Expected values are hand-ordered / boolean logic (independent authority).
fn main()
    // sort a PUSH-built float list (boxed floats)
    let xs = []
    xs.push(3.5)
    xs.push(1.5)
    xs.push(2.5)
    let s = sort(xs)
    assert_near(s[0], 1.5, 0.001)
    assert_near(s[1], 2.5, 0.001)
    assert_near(s[2], 3.5, 0.001)

    // sort a LITERAL float list (raw IEEE bits) incl. a negative
    let ys = sort([9.0, 0.5, -4.0, 4.0])
    assert_near(ys[0], -4.0, 0.001)
    assert_near(ys[1], 0.5, 0.001)
    assert_near(ys[2], 4.0, 0.001)
    assert_near(ys[3], 9.0, 0.001)

    // int sort must still be exact
    let zs = sort([30, 10, 20])
    assert_eq(zs[0], 10)
    assert_eq(zs[1], 20)
    assert_eq(zs[2], 30)

    // any/all over RAW bool literals
    assert_eq(any([false, false, true]), true)
    assert_eq(any([false, false, false]), false)
    assert_eq(all([true, true, false]), false)
    assert_eq(all([true, true, true]), true)

    // any/all over BOXED bools (the actual bug: boxed false must be falsy)
    let bs = []
    bs.push(false)
    bs.push(false)
    assert_eq(any(bs), false)
    bs.push(true)
    assert_eq(any(bs), true)

    // sum/min/max over floats: PUSH-built (boxed) and LITERAL (raw bits)
    let fs = []
    fs.push(1.5)
    fs.push(2.5)
    fs.push(4.0)
    assert_near(sum(fs), 8.0, 0.001)
    assert_near(list_min(fs), 1.5, 0.001)
    assert_near(list_max(fs), 4.0, 0.001)
    assert_near(sum([0.5, 1.5, 2.0]), 4.0, 0.001)
    assert_near(list_min([9.0, 0.5, 4.0]), 0.5, 0.001)
    assert_near(list_max([9.0, 0.5, 4.0]), 9.0, 0.001)

    // int sum/min/max must stay exact (integer path)
    assert_eq(sum([10, 20, 30]), 60)
    assert_eq(list_min([3, 1, 2]), 1)
    assert_eq(list_max([3, 1, 2]), 3)

    print("float list ops test passed")
