// _distinctcount_test.nova — KAT for std/sketch/distinctcount
//
// Tests INVARIANTS and DETERMINISM for Linear Counting and Flajolet-Martin.

import std/sketch/distinctcount

fn ck(label, got, want)
    if got != want
        print("FAIL distinctcount " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_range(label, got, lo, hi)
    if got < lo or got > hi
        print("FAIL distinctcount " + label + ": got=" + str(got) + " want in [" + str(lo) + ".." + str(hi) + "]")
        exit(1)

fn ck_float_near(label, got, want, tol)
    let diff = got - want
    if diff < 0.0
        diff = 0.0 - diff
    if diff > tol
        print("FAIL distinctcount " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- fm_trailing_zeros ---
    ck("ftz_zero", fm_trailing_zeros(0), 62)
    ck("ftz_one",  fm_trailing_zeros(1), 0)
    ck("ftz_8",    fm_trailing_zeros(8), 3)
    ck("ftz_2",    fm_trailing_zeros(2), 1)
    ck("ftz_4",    fm_trailing_zeros(4), 2)
    ck("ftz_16",   fm_trailing_zeros(16), 4)

    // --- lc_new structure ---
    let lc = lc_new(1024)
    ck("lc_new_m",     lc["m"], 1024)
    ck("lc_new_zeros", lc_zeros(lc), 1024)

    // --- lc_zeros decreases as items are added ---
    lc = lc_add(lc, "alpha")
    lc = lc_add(lc, "beta")
    let z2 = lc_zeros(lc)
    // at least one bit was set (the two hashes may land on same bucket but usually not)
    if z2 >= 1024
        print("FAIL distinctcount zeros_decrease: zeros=" + str(z2) + " expected <1024 after adds")
        exit(1)

    // --- lc_count: add 100 distinct items -> within ~20% of 100 [70..140] ---
    let lc2 = lc_new(1024)
    let i = 0
    while i < 100
        lc2 = lc_add(lc2, "distinct" + str(i))
        i = i + 1
    let cnt100 = lc_count(lc2)
    ck_range("lc_count_100", cnt100, 70, 140)

    // --- lc_count: add same item repeatedly -> count near 1 ---
    let lc3 = lc_new(1024)
    let j = 0
    while j < 100
        lc3 = lc_add(lc3, "same")
        j = j + 1
    // same item sets same bit(s) -> zeros barely changes -> estimate near 1
    let cnt_same = lc_count(lc3)
    ck_range("lc_count_same", cnt_same, 1, 5)

    // --- lc_load increases as items are added ---
    let lc4 = lc_new(1024)
    let load0 = lc_load(lc4)
    let k = 0
    while k < 50
        lc4 = lc_add(lc4, "load_item" + str(k))
        k = k + 1
    let load50 = lc_load(lc4)
    if load50 <= load0
        print("FAIL distinctcount lc_load_increases: load0=" + str(load0) + " load50=" + str(load50))
        exit(1)

    // --- lc_merge: union has >= as many set bits as either input ---
    let la = lc_new(64)
    let lb = lc_new(64)
    let mi = 0
    while mi < 20
        la = lc_add(la, "a" + str(mi))
        mi = mi + 1
    let mj = 0
    while mj < 20
        lb = lc_add(lb, "b" + str(mj))
        mj = mj + 1
    let merged = lc_merge(la, lb)
    let z_a = lc_zeros(la)
    let z_b = lc_zeros(lb)
    let z_m = lc_zeros(merged)
    // merged has fewer or equal zeros than either (i.e., >= set bits)
    if z_m > z_a or z_m > z_b
        print("FAIL distinctcount lc_merge_zeros: zm=" + str(z_m) + " za=" + str(z_a) + " zb=" + str(z_b))
        exit(1)

    // --- Determinism: two identical LC runs give same count ---
    let ld1 = lc_new(1024)
    let ld2 = lc_new(1024)
    let di = 0
    while di < 50
        ld1 = lc_add(ld1, "det" + str(di))
        ld2 = lc_add(ld2, "det" + str(di))
        di = di + 1
    ck("lc_determinism", lc_count(ld1), lc_count(ld2))

    // --- fm_new structure ---
    let fm = fm_new()
    ck("fm_new_bm", fm["bm"], 0)

    // --- fm_estimate on fresh state = 1 (2^0 / 0.77351 ~ 1.29 -> rounds to 1) ---
    let fm_est0 = fm_estimate(fm_new())
    ck_range("fm_estimate_empty", fm_est0, 1, 2)

    // --- fm_add + fm_estimate: adding 100 distinct items -> some positive estimate ---
    let fm2 = fm_new()
    let fi = 0
    while fi < 100
        fm2 = fm_add(fm2, "fm_item" + str(fi))
        fi = fi + 1
    let fm_cnt = fm_estimate(fm2)
    // FM is rough (factor of 2x) but should be positive and at least 10 for 100 items
    if fm_cnt < 1
        print("FAIL distinctcount fm_estimate_positive: got=" + str(fm_cnt))
        exit(1)

    // --- Determinism: two FM runs ---
    let fm3 = fm_new()
    let fm4 = fm_new()
    let fdi = 0
    while fdi < 40
        fm3 = fm_add(fm3, "fmdet" + str(fdi))
        fm4 = fm_add(fm4, "fmdet" + str(fdi))
        fdi = fdi + 1
    ck("fm_determinism", fm_estimate(fm3), fm_estimate(fm4))

    print("PASS _distinctcount_test")
