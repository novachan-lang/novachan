// Chained field access through a NESTED struct must preserve a float field's type for str()/arith
// (was silent corruption: w.inner.v read the raw IEEE bits -> 3.5 became 4615063718147915776; to_json
// masked it). Covers direct construction, from_json, and form_as (the typed-extraction consumers).
type Inner
    v: float
    k: int
type Outer
    name: string
    inner: Inner

fn main()
    let q = chr(34)

    // direct construction -> chained float read
    let a = Outer("x", Inner(3.5, 7))
    assert(str(a.inner.v) == "3.5", "direct chained float via str (got " + str(a.inner.v) + ")")
    assert(a.inner.v * 2.0 > 6.9 and a.inner.v * 2.0 < 7.1, "direct chained float arithmetic")
    assert(a.inner.k == 7, "chained int field intact")
    print("PASS: direct chained float (" + str(a.inner.v) + ")")

    // from_json -> chained float read
    let body = "\{" + q + "name" + q + ":" + q + "y" + q + "," + q + "inner" + q + ":\{" + q + "v" + q + ":1.25," + q + "k" + q + ":3\}\}"
    let b: Outer = from_json(body)
    assert(str(b.inner.v) == "1.25", "from_json chained float via str (got " + str(b.inner.v) + ")")
    assert(b.inner.k == 3, "from_json chained int")
    print("PASS: from_json chained float (" + str(b.inner.v) + ")")

    // from_json_safe + match-Ok -> chained float read (the full typed-extraction path)
    let r: Result<Outer> = from_json_safe(body)
    match r
        Ok(o) =>
            assert(str(o.inner.v) == "1.25", "from_json_safe match-Ok chained float (got " + str(o.inner.v) + ")")
            print("PASS: from_json_safe match-Ok chained float (" + str(o.inner.v) + ")")
        Err(e) =>
            assert(false, "unexpected err: " + e)

    print("nested_struct_float_test passed")
