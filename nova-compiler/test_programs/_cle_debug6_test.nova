fn main()
    let options = []
    let p1 = ["--port", "8080"]
    push(options, p1)
    let p2 = ["--host", "localhost"]
    push(options, p2)
    let i = 0
    while i < len(options)
        let pair = options[i]
        print("pair[0]='" + pair[0] + "' pair[1]='" + pair[1] + "'")
        i = i + 1
