// PROBE: field-slot collision across modules (WEAPON_PARITY_PLAN 1.4).
//
// `xs_shared` is slot 1 in XsAlpha and slot 3 in XsBeta. `ir_fmap` is a flat
// field_name -> slot map with no struct qualification, so one of these two reads is
// resolved with the OTHER struct's slot whenever the receiver's type cannot be
// inferred statically.
//
// The TYPED reads (via a declared local) must always be right -- they go through
// get_ir_field_index_for with a known struct type. The UNTYPED reads (through a
// list, whose element type is erased) are the ones that expose the bug.
//
// Expected, if slots were resolved per-struct:
//   typed_a=1 typed_b=3   untyped_a=1 untyped_b=3
// Under the flat map, ONE of the untyped pair reads the wrong slot and prints a
// value belonging to a different field (200/300 or 10/20).
import _xm_slot_mod_a
import _xm_slot_mod_b

fn main()
    // ── typed receivers: the compiler knows the struct, so these are the control ──
    let a = _xm_slot_mod_a.xs_alpha_make(1)
    let b = _xm_slot_mod_b.xs_beta_make(3)
    print("typed_a=" + str(a.xs_shared))
    print("typed_b=" + str(b.xs_shared))

    // ── untyped receivers: element type erased through `list` ──
    let la = _xm_slot_mod_a.xs_alpha_boxed(1)
    let lb = _xm_slot_mod_b.xs_beta_boxed(3)
    print("untyped_a=" + str(la[0].xs_shared))
    print("untyped_b=" + str(lb[0].xs_shared))

    // ── WRITES through an un-inferrable receiver ──
    // A wrong-slot write is worse than a wrong-slot read: it CORRUPTS a neighbouring
    // field. So assert both the value written AND that the neighbour is untouched --
    // pre-fix, `la[0].xs_shared = 91` lands in slot 3 (xs_a_three), so reading
    // xs_shared back through the same wrong slot LOOKS correct while xs_a_three is
    // silently destroyed. Checking only the write-back would pass on a broken build.
    la[0].xs_shared = 91
    lb[0].xs_shared = 93
    print("wrote_a=" + str(la[0].xs_shared))
    print("wrote_b=" + str(lb[0].xs_shared))
    // xs_a_three / xs_b_one are NOT ambiguous names, so these reads use the normal
    // per-struct slot and act as an independent witness.
    print("intact_a=" + str(la[0].xs_a_three))
    print("intact_b=" + str(lb[0].xs_b_one))
