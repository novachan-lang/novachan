import forge_config_validator

fn main()
    let cv = cv_new()
    cv = cv_required(cv, "host", "string")
    cv = cv_required(cv, "port", "int")
    cv = cv_optional(cv, "debug", "int", 0)
    cv = cv_optional(cv, "name", "string", "default-app")
    assert(cv_field_count(cv) == 4, "4 fields")

    let req = cv_required_fields(cv)
    assert(len(req) == 2, "2 required")

    let c1 = {}
    c1["host"] = "localhost"
    c1["port"] = 8080
    let v1 = cv_validate(cv, c1)
    assert(v1["valid"] == 1, "valid config")
    assert(len(v1["warnings"]) == 2, "2 warnings for defaults")

    let c2 = {}
    c2["port"] = 8080
    let v2 = cv_validate(cv, c2)
    assert(v2["valid"] == 0, "missing host")
    assert(len(v2["errors"]) >= 1, "has error")

    let c3 = {}
    let v3 = cv_validate(cv, c3)
    assert(v3["valid"] == 0, "all missing")
    assert(len(v3["errors"]) == 2, "2 errors (host+port)")

    let c4 = {}
    c4["host"] = "localhost"
    c4["port"] = 8080
    let filled = cv_apply_defaults(cv, c4)
    assert(filled["debug"] == 0, "debug default=0")
    assert(filled["name"] == "default-app", "name default")
    assert(filled["host"] == "localhost", "host preserved")

    print("CONFIG-VALIDATOR KAT PASS")
