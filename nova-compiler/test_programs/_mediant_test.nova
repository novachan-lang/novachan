import std/math/mediant

// KAT helper: check integer equality
fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

// --- KAT 1: md_mediant(1,2,1,3) == [2,5] ---
let r1 = md_mediant(1, 2, 1, 3)
cki("kat1_num", r1[0], 2)
cki("kat1_den", r1[1], 5)

// --- KAT 2: md_mediant(0,1,1,1) == [1,2] ---
let r2 = md_mediant(0, 1, 1, 1)
cki("kat2_num", r2[0], 1)
cki("kat2_den", r2[1], 2)

// --- KAT 3: md_mediant(1,3,1,2) == [2,5] ---
let r3 = md_mediant(1, 3, 1, 2)
cki("kat3_num", r3[0], 2)
cki("kat3_den", r3[1], 5)

// --- KAT 4: md_mediant(2,4,2,6) == [2,5]
// 2/4=1/2, 2/6=1/3, mediant=(2+2)/(4+6)=4/10 -> reduced 2/5
let r4 = md_mediant(2, 4, 2, 6)
cki("kat4_num", r4[0], 2)
cki("kat4_den", r4[1], 5)

// --- KAT 5: md_reduce(4,10) == [2,5] ---
let r5 = md_reduce(4, 10)
cki("kat5_num", r5[0], 2)
cki("kat5_den", r5[1], 5)

// --- KAT 6: md_compare(1,2,1,3) == 1  (1/2 > 1/3) ---
let r6 = md_compare(1, 2, 1, 3)
cki("kat6", r6, 1)

// --- KAT 7: md_compare(1,3,1,2) == -1  (1/3 < 1/2) ---
let r7 = md_compare(1, 3, 1, 2)
cki("kat7", r7, -1)

// --- KAT 8: md_compare(2,4,1,2) == 0  (2/4 == 1/2) ---
let r8 = md_compare(2, 4, 1, 2)
cki("kat8", r8, 0)

// --- KAT 9: md_between(1,3,1,2) == 1  (mediant 2/5 is strictly between 1/3 and 1/2) ---
let r9 = md_between(1, 3, 1, 2)
cki("kat9", r9, 1)

// --- KAT 10: md_reduce(6,4) == [3,2] ---
let r10 = md_reduce(6, 4)
cki("kat10_num", r10[0], 3)
cki("kat10_den", r10[1], 2)

// --- KAT 11: md_reduce(0,5) == [0,1] ---
let r11 = md_reduce(0, 5)
cki("kat11_num", r11[0], 0)
cki("kat11_den", r11[1], 1)

print("_mediant_test passed")
