// showcase_calc -- a recursive-descent arithmetic expression evaluator in pure NOVA. A SIXTH
// subsystem mix: string tokenizing, mutual RECURSION (expr -> term -> factor -> expr), a mutable
// cursor threaded through the parse, integer arithmetic with precedence + parentheses, and error
// handling for malformed input. Cursor/error are 1-element lists (by-reference) so the recursion can
// advance them. Deliberately avoids the dict-key/list-element aliasing of CORE_GAP 0.10. Self-verifying.

fn is_digit(c: string) -> int
    if len(c) == 1 and find("0123456789", c) >= 0
        return 1
    return 0

fn tokenize(s: string) -> list
    let toks = []
    let i = 0
    while i < len(s)
        let c = slice(s, i, i + 1)
        if c == " "
            i = i + 1
        else if is_digit(c) == 1
            let num = ""
            while i < len(s) and is_digit(slice(s, i, i + 1)) == 1
                num = num + slice(s, i, i + 1)
                i = i + 1
            push(toks, num)
        else
            push(toks, c)
            i = i + 1
    return toks

fn cur(toks: list, pos: list) -> string
    if pos[0] < len(toks)
        return toks[pos[0]]
    return ""

// factor := number | '(' expr ')'
fn parse_factor(toks: list, pos: list, err: list) -> int
    let t = cur(toks, pos)
    if t == "("
        pos[0] = pos[0] + 1
        let v = parse_expr(toks, pos, err)
        if cur(toks, pos) != ")"
            err[0] = 1
            return 0
        pos[0] = pos[0] + 1
        return v
    if t != "" and is_digit(slice(t, 0, 1)) == 1
        pos[0] = pos[0] + 1
        return parse_int(t)
    err[0] = 1
    return 0

// term := factor (('*' | '/') factor)*
fn parse_term(toks: list, pos: list, err: list) -> int
    let v = parse_factor(toks, pos, err)
    while cur(toks, pos) == "*" or cur(toks, pos) == "/"
        let op = cur(toks, pos)
        pos[0] = pos[0] + 1
        let r = parse_factor(toks, pos, err)
        if op == "*"
            v = v * r
        else
            if r == 0
                err[0] = 1
                return 0
            v = v / r
    return v

// expr := term (('+' | '-') term)*
fn parse_expr(toks: list, pos: list, err: list) -> int
    let v = parse_term(toks, pos, err)
    while cur(toks, pos) == "+" or cur(toks, pos) == "-"
        let op = cur(toks, pos)
        pos[0] = pos[0] + 1
        let r = parse_term(toks, pos, err)
        if op == "+"
            v = v + r
        else
            v = v - r
    return v

// evaluate; returns the value. sets ok[0]=0 on any parse error or trailing garbage.
fn eval(s: string, ok: list) -> int
    let toks = tokenize(s)
    let pos = [0]
    let err = [0]
    let v = parse_expr(toks, pos, err)
    if err[0] == 1
        ok[0] = 0
        return 0
    if pos[0] != len(toks)      // trailing tokens = malformed
        ok[0] = 0
        return 0
    ok[0] = 1
    return v

fn main()
    let ok = [0]
    // valid expressions with precedence + parens + left-assoc
    let cases = ["2+3*4", "(2+3)*4", "10-2-3", "2*3+4", "100/5/2", "((1+2)*(3+4))", "7", "2*(3+4*(5-1))"]
    let wants = [14, 20, 5, 10, 10, 21, 7, 38]
    let i = 0
    while i < len(cases)
        let got = eval(cases[i], ok)
        print(cases[i] + " = " + str(got) + " (want " + str(wants[i]) + ")")
        assert(ok[0] == 1, "valid expr parses: " + cases[i])
        assert(got == wants[i], "correct value: " + cases[i])
        i = i + 1

    // malformed inputs must be rejected (ok=0), not crash
    let bad = ["2+", "(2+3", "2**3", ")", "2 3", ""]
    let j = 0
    while j < len(bad)
        let _g = eval(bad[j], ok)
        print("reject " + q_or_empty(bad[j]) + " -> ok=" + str(ok[0]))
        assert(ok[0] == 0, "malformed rejected: " + bad[j])
        j = j + 1

    // divide-by-zero is an error, not a crash
    let _d = eval("5/0", ok)
    assert(ok[0] == 0, "division by zero rejected")

    print("showcase_calc_test passed -- recursive-descent evaluator: precedence, parens, errors, pure NOVA")

fn q_or_empty(s: string) -> string
    if s == ""
        return "(empty)"
    return s
