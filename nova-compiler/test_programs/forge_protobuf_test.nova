// functional: protobuf wire vectors (varint/zigzag/tag/field round-trip)
import forge_protobuf

fn main()
    if str(pb_encode_varint([], 300)) != str([172, 2])
        print("FAIL varint300")
        exit(1)
    if str(pb_decode_varint([172, 2], 0)) != str([300, 2])
        print("FAIL decode300")
        exit(1)
    if pb_zigzag_encode(-1) != 1
        print("FAIL zz-1")
        exit(1)
    if pb_zigzag_encode(1) != 2
        print("FAIL zz1")
        exit(1)
    if pb_zigzag_encode(-2) != 3
        print("FAIL zz-2")
        exit(1)
    if pb_zigzag_decode(3) != -2
        print("FAIL zzd3")
        exit(1)
    if pb_tag(1, 0) != 8
        print("FAIL tag10")
        exit(1)
    if pb_tag(2, 2) != 18
        print("FAIL tag22")
        exit(1)
    if str(pb_encode_field_varint([], 1, 300)) != str([8, 172, 2])
        print("FAIL field")
        exit(1)
    print("PASS forge_protobuf")
