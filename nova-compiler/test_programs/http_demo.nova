// HTTP server framework in pure NOVA, built on top of the runtime's
// http_listen / http_accept_raw / http_send_raw primitives.

type Request
    method: string
    path: string
    query: string
    version: string
    headers: dict
    body: string

type Response
    status: int
    headers: dict
    body: string

// ── Parsing ─────────────────────────────────────────────────────────────────

fn http_parse_request(raw: string) -> Request
    let header_end = find(raw, "\r\n\r\n")
    let header_part = raw
    let body = ""
    if header_end >= 0
        header_part = slice(raw, 0, header_end)
        body = slice(raw, header_end + 4, len(raw))

    let lines = split(header_part, "\r\n")
    let method = ""
    let path = ""
    let query = ""
    let version = "HTTP/1.1"

    if len(lines) > 0
        let first = lines[0]
        let parts = split(first, " ")
        if len(parts) >= 1
            method = parts[0]
        if len(parts) >= 2
            let p = parts[1]
            let q_pos = find(p, "?")
            if q_pos >= 0
                path = slice(p, 0, q_pos)
                query = slice(p, q_pos + 1, len(p))
            else
                path = p
        if len(parts) >= 3
            version = parts[2]

    let headers = {}
    let i = 1
    while i < len(lines)
        let line = lines[i]
        let colon = find(line, ":")
        if colon > 0
            let k = lower(trim(slice(line, 0, colon)))
            let v = trim(slice(line, colon + 1, len(line)))
            headers[k] = v
        i = i + 1

    Request(method, path, query, version, headers, body)

fn http_parse_query(query: string) -> dict
    let result = {}
    if len(query) == 0
        return result
    let pairs = split(query, "&")
    for pair in pairs
        let eq = find(pair, "=")
        if eq >= 0
            let k = slice(pair, 0, eq)
            let v = slice(pair, eq + 1, len(pair))
            result[k] = v
        else
            result[pair] = ""
    result

// ── Response building ───────────────────────────────────────────────────────

fn http_status_text(status: int) -> string
    if status == 200
        return "OK"
    if status == 201
        return "Created"
    if status == 204
        return "No Content"
    if status == 301
        return "Moved Permanently"
    if status == 302
        return "Found"
    if status == 400
        return "Bad Request"
    if status == 401
        return "Unauthorized"
    if status == 403
        return "Forbidden"
    if status == 404
        return "Not Found"
    if status == 405
        return "Method Not Allowed"
    if status == 500
        return "Internal Server Error"
    if status == 503
        return "Service Unavailable"
    return "OK"

fn http_build_response(r: Response) -> string
    let status_text = http_status_text(r.status)
    let body_len = len(r.body)
    let header_str = ""
    let has_ct = r.headers.has("content-type") or r.headers.has("Content-Type")
    let has_cl = r.headers.has("content-length") or r.headers.has("Content-Length")
    let hk = keys(r.headers)
    for k in hk
        let v = r.headers[k]
        header_str = header_str + k + ": " + v + "\r\n"
    if not has_ct
        header_str = header_str + "Content-Type: text/plain; charset=utf-8\r\n"
    if not has_cl
        header_str = header_str + "Content-Length: " + str(body_len) + "\r\n"
    header_str = header_str + "Connection: close\r\n"
    "HTTP/1.1 " + str(r.status) + " " + status_text + "\r\n" + header_str + "\r\n" + r.body

// ── Response helpers ────────────────────────────────────────────────────────

fn resp_ok(body: string) -> Response
    Response(200, {}, body)

fn json_response(status: int, body: string) -> Response
    let h = {}
    h["Content-Type"] = "application/json; charset=utf-8"
    Response(status, h, body)

fn not_found(body: string) -> Response
    Response(404, {}, body)

// ── Handler dispatch (using dict-based router) ──────────────────────────────

fn dispatch(req: Request) -> Response
    let key = req.method + " " + req.path
    if key == "GET /"
        return resp_ok("Welcome to NOVA HTTP! Try GET /hello, GET /add?a=2&b=3, POST /echo")
    if key == "GET /hello"
        let q = http_parse_query(req.query)
        let name = "world"
        if q.has("name")
            name = q["name"]
        return json_response(200, "\{\"greeting\": \"hello, {name}!\"\}")
    if key == "GET /add"
        let q = http_parse_query(req.query)
        let a = 0
        let b = 0
        if q.has("a")
            a = parse_int(q["a"])
        if q.has("b")
            b = parse_int(q["b"])
        let result = a + b
        return json_response(200, "\{\"a\": {a}, \"b\": {b}, \"sum\": {result}\}")
    if key == "POST /echo"
        let body_len = len(req.body)
        return json_response(200, "\{\"you_sent\": \"{req.body}\", \"bytes\": {body_len}\}")
    if key == "GET /stop"
        return resp_ok("stopping")
    not_found("404 Not Found: {req.method} {req.path}")

// ── Main serve loop ─────────────────────────────────────────────────────────

fn serve(port: int)
    let sock = http_listen(port)
    print("Server listening on http://127.0.0.1:{port}")
    let running = 1
    while running == 1
        let conn = http_accept_raw(sock)
        if len(conn) == 0
            continue
        let client = conn[0]
        let raw = conn[1]
        let req = http_parse_request(raw)
        let resp = dispatch(req)
        let out = http_build_response(resp)
        http_send_raw(client, out)
        if req.path == "/stop"
            running = 0
    print("Server stopped")

fn main()
    let port = 8765
    let argv = args()
    if len(argv) > 1
        port = parse_int(argv[1])
    serve(port)
