import std/net/ipv4hdr

fn main()
    // ── KAT 1: encode known vector ───────────────────────────────────────────
    // RFC 1071 canonical: flags=2 (DF), no frag, TTL=64, proto=17 (UDP)
    // src=192.168.0.1 (0xC0A80001), dst=192.168.0.199 (0xC0A800C7)
    // Expected 20 bytes: 45 00 00 73 00 00 40 00 40 11 B8 61 C0 A8 00 01 C0 A8 00 C7
    let h = {"version": 4, "ihl": 5, "tos": 0, "total_length": 0x73, "id": 0, "flags": 2, "frag_offset": 0, "ttl": 64, "protocol": 17, "src": 0xC0A80001, "dst": 0xC0A800C7}
    let enc = ipv4_encode(h)

    // Verify length
    let elen = bytes_len(enc)
    if elen != 20
        print("FAIL ipv4hdr length: got " + str(elen) + " want 20")
        exit(1)

    // Verify byte 0: version=4, ihl=5 -> 0x45
    let b0 = bytes_get(enc, 0)
    if b0 != 0x45
        print("FAIL ipv4hdr byte0: got " + str(b0) + " want 69")
        exit(1)

    // Verify TOS = 0x00
    let b1 = bytes_get(enc, 1)
    if b1 != 0
        print("FAIL ipv4hdr byte1 TOS: got " + str(b1) + " want 0")
        exit(1)

    // Verify total_length = 0x0073
    let tl_hi = bytes_get(enc, 2)
    let tl_lo = bytes_get(enc, 3)
    if tl_hi != 0
        print("FAIL ipv4hdr byte2 tlen_hi: got " + str(tl_hi) + " want 0")
        exit(1)
    if tl_lo != 0x73
        print("FAIL ipv4hdr byte3 tlen_lo: got " + str(tl_lo) + " want 115")
        exit(1)

    // Verify ID = 0x0000
    let id_hi = bytes_get(enc, 4)
    let id_lo = bytes_get(enc, 5)
    if id_hi != 0
        print("FAIL ipv4hdr byte4 id_hi: got " + str(id_hi) + " want 0")
        exit(1)
    if id_lo != 0
        print("FAIL ipv4hdr byte5 id_lo: got " + str(id_lo) + " want 0")
        exit(1)

    // Verify flags=2 (DF bit), frag_offset=0 -> bytes 6-7 = 0x40 0x00
    let f_hi = bytes_get(enc, 6)
    let f_lo = bytes_get(enc, 7)
    if f_hi != 0x40
        print("FAIL ipv4hdr byte6 flags: got " + str(f_hi) + " want 64")
        exit(1)
    if f_lo != 0
        print("FAIL ipv4hdr byte7 foff: got " + str(f_lo) + " want 0")
        exit(1)

    // Verify TTL = 64 = 0x40
    let ttl_b = bytes_get(enc, 8)
    if ttl_b != 64
        print("FAIL ipv4hdr byte8 TTL: got " + str(ttl_b) + " want 64")
        exit(1)

    // Verify protocol = 17 = 0x11
    let proto_b = bytes_get(enc, 9)
    if proto_b != 17
        print("FAIL ipv4hdr byte9 protocol: got " + str(proto_b) + " want 17")
        exit(1)

    // Verify checksum = 0xB861 at bytes 10-11
    let cs_hi = bytes_get(enc, 10)
    let cs_lo = bytes_get(enc, 11)
    if cs_hi != 0xB8
        print("FAIL ipv4hdr byte10 csum_hi: got " + str(cs_hi) + " want 184")
        exit(1)
    if cs_lo != 0x61
        print("FAIL ipv4hdr byte11 csum_lo: got " + str(cs_lo) + " want 97")
        exit(1)

    // Verify src = 0xC0A80001: C0 A8 00 01
    let s0 = bytes_get(enc, 12)
    let s1 = bytes_get(enc, 13)
    let s2 = bytes_get(enc, 14)
    let s3 = bytes_get(enc, 15)
    if s0 != 0xC0
        print("FAIL ipv4hdr byte12 src[0]: got " + str(s0) + " want 192")
        exit(1)
    if s1 != 0xA8
        print("FAIL ipv4hdr byte13 src[1]: got " + str(s1) + " want 168")
        exit(1)
    if s2 != 0
        print("FAIL ipv4hdr byte14 src[2]: got " + str(s2) + " want 0")
        exit(1)
    if s3 != 1
        print("FAIL ipv4hdr byte15 src[3]: got " + str(s3) + " want 1")
        exit(1)

    // Verify dst = 0xC0A800C7: C0 A8 00 C7
    let d0 = bytes_get(enc, 16)
    let d1 = bytes_get(enc, 17)
    let d2 = bytes_get(enc, 18)
    let d3 = bytes_get(enc, 19)
    if d0 != 0xC0
        print("FAIL ipv4hdr byte16 dst[0]: got " + str(d0) + " want 192")
        exit(1)
    if d1 != 0xA8
        print("FAIL ipv4hdr byte17 dst[1]: got " + str(d1) + " want 168")
        exit(1)
    if d2 != 0
        print("FAIL ipv4hdr byte18 dst[2]: got " + str(d2) + " want 0")
        exit(1)
    if d3 != 0xC7
        print("FAIL ipv4hdr byte19 dst[3]: got " + str(d3) + " want 199")
        exit(1)

    // ── KAT 2: decode round-trip ─────────────────────────────────────────────
    let dec = ipv4_decode(enc)

    let got_ver = dec["version"]
    if got_ver != 4
        print("FAIL ipv4hdr decode version: got " + str(got_ver) + " want 4")
        exit(1)

    let got_ihl = dec["ihl"]
    if got_ihl != 5
        print("FAIL ipv4hdr decode ihl: got " + str(got_ihl) + " want 5")
        exit(1)

    let got_tos = dec["tos"]
    if got_tos != 0
        print("FAIL ipv4hdr decode tos: got " + str(got_tos) + " want 0")
        exit(1)

    let got_tlen = dec["total_length"]
    if got_tlen != 0x73
        print("FAIL ipv4hdr decode total_length: got " + str(got_tlen) + " want 115")
        exit(1)

    let got_id = dec["id"]
    if got_id != 0
        print("FAIL ipv4hdr decode id: got " + str(got_id) + " want 0")
        exit(1)

    let got_flags = dec["flags"]
    if got_flags != 2
        print("FAIL ipv4hdr decode flags: got " + str(got_flags) + " want 2")
        exit(1)

    let got_foff = dec["frag_offset"]
    if got_foff != 0
        print("FAIL ipv4hdr decode frag_offset: got " + str(got_foff) + " want 0")
        exit(1)

    let got_ttl = dec["ttl"]
    if got_ttl != 64
        print("FAIL ipv4hdr decode ttl: got " + str(got_ttl) + " want 64")
        exit(1)

    let got_proto = dec["protocol"]
    if got_proto != 17
        print("FAIL ipv4hdr decode protocol: got " + str(got_proto) + " want 17")
        exit(1)

    let got_csum = dec["checksum"]
    if got_csum != 0xB861
        print("FAIL ipv4hdr decode checksum: got " + str(got_csum) + " want 47201")
        exit(1)

    let got_src = dec["src"]
    if got_src != 0xC0A80001
        print("FAIL ipv4hdr decode src: got " + str(got_src) + " want 3232235521")
        exit(1)

    let got_dst = dec["dst"]
    if got_dst != 0xC0A800C7
        print("FAIL ipv4hdr decode dst: got " + str(got_dst) + " want 3232235719")
        exit(1)

    // ── KAT 3: ipv4_src_str / ipv4_dst_str ──────────────────────────────────
    let src_str = ipv4_src_str(dec)
    if src_str != "192.168.0.1"
        print("FAIL ipv4hdr src_str: got " + src_str + " want 192.168.0.1")
        exit(1)

    let dst_str = ipv4_dst_str(dec)
    if dst_str != "192.168.0.199"
        print("FAIL ipv4hdr dst_str: got " + dst_str + " want 192.168.0.199")
        exit(1)

    // ── KAT 4: short-input safety ────────────────────────────────────────────
    let short = bytes(10)
    let short_dec = ipv4_decode(short)
    let short_keys = keys(short_dec)
    let short_len = len(short_keys)
    if short_len != 0
        print("FAIL ipv4hdr short_input: got " + str(short_len) + " keys want 0")
        exit(1)

    // ── KAT 5: MF flag encode/decode ─────────────────────────────────────────
    // flags=1 (MF), frag_offset=185 -> flagsfoff = (1<<13)|185 = 8377 = 0x20B9
    let h2 = {"version": 4, "ihl": 5, "tos": 0, "total_length": 100, "id": 0x1234, "flags": 1, "frag_offset": 185, "ttl": 128, "protocol": 6, "src": 0x0A000001, "dst": 0x0A000002}
    let enc2 = ipv4_encode(h2)
    let dec2 = ipv4_decode(enc2)

    let got2_flags = dec2["flags"]
    if got2_flags != 1
        print("FAIL ipv4hdr MF flags: got " + str(got2_flags) + " want 1")
        exit(1)

    let got2_foff = dec2["frag_offset"]
    if got2_foff != 185
        print("FAIL ipv4hdr MF frag_offset: got " + str(got2_foff) + " want 185")
        exit(1)

    let got2_id = dec2["id"]
    if got2_id != 0x1234
        print("FAIL ipv4hdr MF id: got " + str(got2_id) + " want 4660")
        exit(1)

    print("PASS _ipv4hdr_test")
