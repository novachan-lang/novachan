// Regression: bytes_append_str O(n) string builder (perf gap #5 fix).
fn main()
    let b = bytes(0)
    bytes_append_str(b, "Hello, ")
    bytes_append_str(b, "World")
    bytes_append_str(b, "!")
    let s = bytes_to_str(b)
    if s == "Hello, World!"
        print("PASS build")
    else
        print("FAIL build: " + s)
    // O(n): 100k appends must be fast (< 100ms; naive O(n^2) would be seconds)
    let sb = bytes(0)
    let i = 0
    while i < 100000
        bytes_append_str(sb, "x")
        i = i + 1
    if len(bytes_to_str(sb)) == 100000
        print("PASS bigbuild len=100000")
    else
        print("FAIL bigbuild")
