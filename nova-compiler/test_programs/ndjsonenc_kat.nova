// KAT probe for std/encoding/ndjson — Newline-Delimited JSON (jsonlines.org)
//
// All expected values are hand-computed. Uses chr(34)/chr(123)/chr(125) to
// build JSON text without triggering NOVA string-brace interpolation.
import std/encoding/ndjson

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    let q  = chr(34)
    let lb = chr(123)
    let rb = chr(125)
    let nl = chr(10)
    let cr = chr(13)

    // ── KAT 1-3: parse 3 lines, third value's string contains an escaped
    //             \n (two source bytes: backslash + n) which json_decode
    //             turns into a real 0x0A *inside* the decoded string --
    //             it must NOT cause a fourth line / extra split.
    //   Line 1: {"a":1}
    //   Line 2: {"b":[2,3]}
    //   Line 3: {"c":"x\ny"}     <- \n here is the two-byte escape "\" + "n"
    let line1 = lb + q + "a" + q + ":1" + rb
    let line2 = lb + q + "b" + q + ":[2,3]" + rb
    let line3 = lb + q + "c" + q + ":" + q + "x" + chr(92) + "n" + "y" + q + rb
    let text3 = line1 + nl + line2 + nl + line3 + nl

    let parsed3 = ndjson_parse(text3)
    cki("kat1-len", len(parsed3), 3)
    print("KAT 1 PASS: ndjson_parse of 3 lines -> list length 3")

    let v0 = parsed3[0]
    cks("kat2-type0", type_of(v0), "dict")
    cki("kat2-a", v0["a"], 1)
    print("KAT 2 PASS: parsed[0].a == 1")

    let v1 = parsed3[1]
    cks("kat2b-type1", type_of(v1), "dict")
    let b_list = v1["b"]
    cki("kat2b-len", len(b_list), 2)
    cki("kat2b-b0", b_list[0], 2)
    cki("kat2b-b1", b_list[1], 3)
    print("KAT 2b PASS: parsed[1].b == [2,3]")

    let v2 = parsed3[2]
    cks("kat3-type2", type_of(v2), "dict")
    let c_val = v2["c"]
    // c_val must be exactly "x" + real-newline + "y" (3 chars), NOT split
    // into two ndjson records.
    cki("kat3-clen", len(c_val), 3)
    let expected_c = "x" + nl + "y"
    cks("kat3-c-eq", c_val, expected_c)
    print("KAT 3 PASS: parsed[2].c == 'x\\ny' as ONE value (embedded real newline, not split)")

    // ── KAT 4: blank lines (empty + whitespace-only) are skipped ────────────
    let text_blanks = "" + nl + line1 + nl + nl + "   " + nl + line2 + nl
    let parsed4 = ndjson_parse(text_blanks)
    cki("kat4-len", len(parsed4), 2)
    cki("kat4-a", parsed4[0]["a"], 1)
    let b4 = parsed4[1]["b"]
    cki("kat4-b0", b4[0], 2)
    print("KAT 4 PASS: blank + whitespace-only lines skipped")

    // ── KAT 5: CRLF line endings handled ─────────────────────────────────────
    let text_crlf = line1 + cr + nl + line2 + cr + nl
    let parsed5 = ndjson_parse(text_crlf)
    cki("kat5-len", len(parsed5), 2)
    cki("kat5-a", parsed5[0]["a"], 1)
    cki("kat5-b0", parsed5[1]["b"][0], 2)
    print("KAT 5 PASS: CRLF line endings parsed correctly")

    // ── KAT 6: no trailing newline still parses the last line ───────────────
    let text_notrail = line1 + nl + line2
    let parsed6 = ndjson_parse(text_notrail)
    cki("kat6-len", len(parsed6), 2)
    cki("kat6-lastb1", parsed6[1]["b"][1], 3)
    print("KAT 6 PASS: missing trailing newline still yields last record")

    // ── KAT 7: empty input -> [] ──────────────────────────────────────────
    let parsed7 = ndjson_parse("")
    cki("kat7-empty", len(parsed7), 0)
    print("KAT 7 PASS: ndjson_parse('') == []")

    // ── KAT 8: ndjson_write round-trips through ndjson_parse ────────────────
    let written = ndjson_write(parsed3)
    // Must end with exactly one trailing "\n"
    let wlen = len(written)
    cki("kat8-ends-nl", ord(written[wlen - 1]), 10)
    let roundtrip = ndjson_parse(written)
    cki("kat8-rt-len", len(roundtrip), 3)
    cki("kat8-rt-a", roundtrip[0]["a"], 1)
    cki("kat8-rt-b0", roundtrip[1]["b"][0], 2)
    cki("kat8-rt-b1", roundtrip[1]["b"][1], 3)
    let rt_c = roundtrip[2]["c"]
    cks("kat8-rt-c", rt_c, expected_c)
    print("KAT 8 PASS: ndjson_write -> ndjson_parse round-trip preserves all 3 values")

    // ── KAT 9: ndjson_write([]) == "" ────────────────────────────────────────
    let empty_out = ndjson_write([])
    cks("kat9-empty-write", empty_out, "")
    print("KAT 9 PASS: ndjson_write([]) == ''")

    // ── KAT 10: ndjson_write of a single value has exactly one trailing \n,
    //           no leading/extra newlines.
    // NOTE: values list is JSON *values*, not raw text -- use a decoded dict.
    let single_val = ndjson_parse(line1)
    let one_out = ndjson_write(single_val)
    let want_one = line1 + nl
    cks("kat10-single", one_out, want_one)
    print("KAT 10 PASS: ndjson_write of a single value == json_stringify + trailing newline")

    print("ndjsonenc_kat passed")
