// KAT for std/net/syslog5424 — RFC 5424 syslog parser and builder.
import std/net/syslog5424

// ── Assertion helpers ────────────────────────────────────────────────────────

fn chk_i(label: string, got: int, want: int)
    if got != want
        print("FAIL syslog5424 " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn chk_s(label: string, got: string, want: string)
    if got != want
        print("FAIL syslog5424 " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn main()
    // ── pri_make / pri_split ─────────────────────────────────────────────────
    chk_i("pri_make(4,2)", pri_make(4, 2), 34)
    chk_i("pri_make(0,0)", pri_make(0, 0), 0)
    chk_i("pri_make(23,7)", pri_make(23, 7), 191)
    chk_i("pri_make(1,6)", pri_make(1, 6), 14)

    let sp34 = pri_split(34)
    chk_i("pri_split(34)[0]", sp34[0], 4)
    chk_i("pri_split(34)[1]", sp34[1], 2)

    let sp0 = pri_split(0)
    chk_i("pri_split(0)[0]", sp0[0], 0)
    chk_i("pri_split(0)[1]", sp0[1], 0)

    let sp191 = pri_split(191)
    chk_i("pri_split(191)[0]", sp191[0], 23)
    chk_i("pri_split(191)[1]", sp191[1], 7)

    // ── syslog5424_parse: RFC 5424 KAT vector ────────────────────────────────
    // The canonical test line from the spec section.
    let kat_line = "<34>1 2003-10-11T22:14:15.003Z mymachine su - ID47 - BOM'su root' failed"
    let p = syslog5424_parse(kat_line)
    chk_i("kat-pri",      p["pri"],      34)
    chk_i("kat-facility", p["facility"], 4)
    chk_i("kat-severity", p["severity"], 2)
    chk_i("kat-version",  p["version"],  1)
    chk_s("kat-timestamp", p["timestamp"], "2003-10-11T22:14:15.003Z")
    chk_s("kat-hostname",  p["hostname"],  "mymachine")
    chk_s("kat-appname",   p["appname"],   "su")
    chk_s("kat-procid",    p["procid"],    "-")
    chk_s("kat-msgid",     p["msgid"],     "ID47")
    chk_s("kat-sd",        p["sd"],        "-")
    chk_s("kat-msg",       p["msg"],       "BOM'su root' failed")

    // ── syslog5424_parse: second RFC 5424 example (structured data) ──────────
    // <165>1 2003-08-24T05:14:15.000003-07:00 192.0.2.1 myproc 8710 - [exampleSDID@32473 iut="3" eventSource="Application" eventID="1011"] An application event log entry...
    let sd_line = "<165>1 2003-08-24T05:14:15.000003-07:00 192.0.2.1 myproc 8710 - [exampleSDID@32473 iut=\"3\"] msg here"
    let p2 = syslog5424_parse(sd_line)
    chk_i("sd-pri",      p2["pri"],      165)
    chk_i("sd-facility", p2["facility"], 20)
    chk_i("sd-severity", p2["severity"], 5)
    chk_s("sd-hostname", p2["hostname"], "192.0.2.1")
    chk_s("sd-appname",  p2["appname"],  "myproc")
    chk_s("sd-procid",   p2["procid"],   "8710")
    chk_s("sd-msgid",    p2["msgid"],    "-")
    chk_s("sd-msg",      p2["msg"],      "msg here")

    // ── syslog5424_parse: no MSG field ──────────────────────────────────────
    let no_msg = "<0>1 - - - - - -"
    let p3 = syslog5424_parse(no_msg)
    chk_i("nomsg-pri",   p3["pri"],  0)
    chk_s("nomsg-msg",   p3["msg"],  "")
    chk_s("nomsg-sd",    p3["sd"],   "-")

    // ── syslog5424_parse: malformed (no <) returns pri==-1 ──────────────────
    let bad = "NOT A SYSLOG LINE"
    let pb = syslog5424_parse(bad)
    chk_i("bad-pri", pb["pri"], -1)

    // ── syslog5424_parse: empty string returns pri==-1 ───────────────────────
    let pe = syslog5424_parse("")
    chk_i("empty-pri", pe["pri"], -1)

    // ── syslog5424_build: build the KAT vector ───────────────────────────────
    let f = {}
    f["pri"] = 34
    f["version"] = 1
    f["timestamp"] = "2003-10-11T22:14:15.003Z"
    f["hostname"] = "mymachine"
    f["appname"] = "su"
    f["procid"] = "-"
    f["msgid"] = "ID47"
    f["sd"] = "-"
    f["msg"] = "BOM'su root' failed"
    let built = syslog5424_build(f)
    chk_s("build-kat", built, "<34>1 2003-10-11T22:14:15.003Z mymachine su - ID47 - BOM'su root' failed")

    // ── Round-trip: parse then build then parse ──────────────────────────────
    let rt1 = syslog5424_parse(built)
    chk_i("rt-pri",      rt1["pri"],      34)
    chk_s("rt-hostname", rt1["hostname"], "mymachine")
    chk_s("rt-msg",      rt1["msg"],      "BOM'su root' failed")

    // ── syslog5424_build: missing fields default to NILVALUE ─────────────────
    let f2 = {}
    f2["pri"] = 14
    f2["version"] = 1
    let built2 = syslog5424_build(f2)
    // Should produce: <14>1 - - - - - -   (no msg, no trailing space)
    chk_s("build-defaults", built2, "<14>1 - - - - - -")

    // ── syslog5424_build: derive pri from facility+severity ───────────────────
    let f3 = {}
    f3["facility"] = 4
    f3["severity"] = 2
    f3["version"] = 1
    f3["timestamp"] = "2003-10-11T22:14:15.003Z"
    f3["hostname"] = "mymachine"
    f3["appname"] = "su"
    f3["procid"] = "-"
    f3["msgid"] = "ID47"
    f3["sd"] = "-"
    f3["msg"] = "BOM'su root' failed"
    let built3 = syslog5424_build(f3)
    chk_s("build-fac-sev", built3, "<34>1 2003-10-11T22:14:15.003Z mymachine su - ID47 - BOM'su root' failed")

    // ── Round-trip: second example (SD element) ──────────────────────────────
    // Build from the parsed p2 fields and re-parse
    let f4 = {}
    f4["pri"] = p2["pri"]
    f4["version"] = p2["version"]
    f4["timestamp"] = p2["timestamp"]
    f4["hostname"] = p2["hostname"]
    f4["appname"] = p2["appname"]
    f4["procid"] = p2["procid"]
    f4["msgid"] = p2["msgid"]
    f4["sd"] = p2["sd"]
    f4["msg"] = p2["msg"]
    let built4 = syslog5424_build(f4)
    let rt2 = syslog5424_parse(built4)
    chk_i("rt2-pri",     rt2["pri"],     p2["pri"])
    chk_s("rt2-hostname", rt2["hostname"], p2["hostname"])
    chk_s("rt2-appname",  rt2["appname"],  p2["appname"])
    chk_s("rt2-msg",      rt2["msg"],      p2["msg"])

    // ── pri_split(pri_make(x,y)) == [x,y] for multiple values ───────────────
    let ps1 = pri_split(pri_make(0, 0))
    chk_i("roundtrip-pm0-fac", ps1[0], 0)
    chk_i("roundtrip-pm0-sev", ps1[1], 0)

    let ps2 = pri_split(pri_make(10, 3))
    chk_i("roundtrip-pm10-fac", ps2[0], 10)
    chk_i("roundtrip-pm10-sev", ps2[1], 3)

    let ps3 = pri_split(pri_make(23, 7))
    chk_i("roundtrip-pm23-fac", ps3[0], 23)
    chk_i("roundtrip-pm23-sev", ps3[1], 7)

    print("PASS _syslog5424_test")
