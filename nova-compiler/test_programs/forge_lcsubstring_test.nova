import forge_lcsubstring

fn expect(name: string, got: string, want: string) -> int
    if got == want
        return 0
    print("FAIL " + name + ": got=" + got + " want=" + want)
    1

// brute-force LCS-substring length
fn brute(a: string, b: string) -> int
    let best = 0
    let i = 0
    while i < len(a)
        let j = 0
        while j < len(b)
            let k = 0
            while i + k < len(a) and j + k < len(b) and char_at(a, i + k) == char_at(b, j + k)
                k = k + 1
            if k > best
                best = k
            j = j + 1
        i = i + 1
    best

fn main()
    let fails = 0

    fails = fails + expect("abc", str(longest_common_substring("abcdef", "zabcf")), "3")
    fails = fails + expect("abc_str", longest_common_substring_str("abcdef", "zabcf"), "abc")
    fails = fails + expect("ab", str(longest_common_substring("abcde", "abfce")), "2")
    fails = fails + expect("none", str(longest_common_substring("abc", "xyz")), "0")
    fails = fails + expect("none_str", longest_common_substring_str("abc", "xyz"), "")
    fails = fails + expect("same", str(longest_common_substring("hello", "hello")), "5")
    fails = fails + expect("same_str", longest_common_substring_str("hello", "hello"), "hello")
    fails = fails + expect("empty", str(longest_common_substring("", "abc")), "0")
    fails = fails + expect("gtu", longest_common_substring_str("GeeksforGeeks", "GeeksQuiz"), "Geeks")

    // brute-force cross-check
    let ok = 1
    let pairs_a = ["abcdxyz", "zxabcdezy", "mississippi", "aaa"]
    let pairs_b = ["xyzabcd", "yzabcdefg", "issippimiss", "aa"]
    let t = 0
    while t < len(pairs_a)
        if longest_common_substring(pairs_a[t], pairs_b[t]) != brute(pairs_a[t], pairs_b[t])
            ok = 0
        t = t + 1
    fails = fails + expect("brute_cross", str(ok), "1")

    if fails == 0
        print("forge_lcsubstring: all passed")
    else
        print("forge_lcsubstring: " + str(fails) + " FAILED")
