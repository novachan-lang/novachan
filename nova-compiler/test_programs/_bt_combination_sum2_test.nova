import std/backtracking/bt_combination_sum2

// cki — assert integer equality
fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// list_str — render int list as "[a,b,...]"
fn list_str(xs)
    let s = "["
    let i = 0
    let n = len(xs)
    while i < n
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

// list_eq — true if two int lists are equal element-wise
fn list_eq(a, b) -> bool
    if len(a) != len(b)
        return false
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return false
        i = i + 1
    true

// results_contains — true if results contains a combo equal to want
fn results_contains(results, want) -> bool
    let i = 0
    while i < len(results)
        if list_eq(results[i], want)
            return true
        i = i + 1
    false

// ck_contains — assert results contains the expected combo
fn ck_contains(label: string, results, want)
    if not results_contains(results, want)
        print("FAIL " + label + ": result set does not contain " + list_str(want))
        exit(1)

// cknest — assert outer length matches want_len
fn cknest(label: string, results, want_len: int)
    if len(results) != want_len
        print("FAIL " + label + "_len: got=" + str(len(results)) + " want=" + str(want_len))
        exit(1)

fn main()
    // --- cs2_count basic KATs ---
    // [10,1,2,7,6,1,5] target=8: [1,7],[1,2,5],[2,6],[1,1,6] => 4
    cki("cs2_count_10127615_8", cs2_count([10, 1, 2, 7, 6, 1, 5], 8), 4)

    // [2,5,2,1,2] target=5: [1,2,2] and [5] => 2
    cki("cs2_count_25212_5", cs2_count([2, 5, 2, 1, 2], 5), 2)

    // [1,1] target=2: only [1,1] => 1
    cki("cs2_count_11_2", cs2_count([1, 1], 2), 1)

    // [3] target=5: 3<5, 3+3=6 but each used once => 0
    cki("cs2_count_3_5", cs2_count([3], 5), 0)

    // --- cs2_solve correctness ---
    // [10,1,2,7,6,1,5] target=8 => 4 combos
    let r8 = cs2_solve([10, 1, 2, 7, 6, 1, 5], 8)
    cknest("cs2_solve_10127615_8", r8, 4)
    ck_contains("contains_17", r8, [1, 7])
    ck_contains("contains_125", r8, [1, 2, 5])
    ck_contains("contains_26", r8, [2, 6])
    ck_contains("contains_116", r8, [1, 1, 6])

    // [2,5,2,1,2] target=5 => [1,2,2] and [5]
    let r5 = cs2_solve([2, 5, 2, 1, 2], 5)
    cknest("cs2_solve_25212_5", r5, 2)
    ck_contains("contains_122", r5, [1, 2, 2])
    ck_contains("contains_5", r5, [5])

    // [1,1] target=2 => [1,1]
    let r2 = cs2_solve([1, 1], 2)
    cknest("cs2_solve_11_2", r2, 1)
    ck_contains("contains_11", r2, [1, 1])

    // edge: empty candidates => 0
    cki("cs2_count_empty", cs2_count([], 3), 0)

    // edge: target=0 => 1 empty combo
    let r0 = cs2_solve([1, 2], 0)
    cknest("cs2_solve_target0", r0, 1)
    ck_contains("contains_empty0", r0, [])

    // edge: negative target => 0
    cki("cs2_count_neg", cs2_count([1, 2], -1), 0)

    // [1,2,3] target=6: [1,2,3] only (each once) => 1
    cki("cs2_count_123_6", cs2_count([1, 2, 3], 6), 1)
    let r6 = cs2_solve([1, 2, 3], 6)
    cknest("cs2_solve_123_6", r6, 1)
    ck_contains("contains_123", r6, [1, 2, 3])

    // [1,2,3,4,5] target=5: [5],[1,4],[2,3],[1,2,... wait: 1+4=5, 2+3=5, 5=5, 1+2+... 1+2+3=6>5 no
    // [5],[1,4],[2,3] => 3
    cki("cs2_count_12345_5", cs2_count([1, 2, 3, 4, 5], 5), 3)

    print("PASS _bt_combination_sum2_test")
