// KAT: dynamic dispatch CORRECTNESS across many impls. The dispatch is now a balanced
// binary search over hash-sorted implementations (O(log N)), so every type must still
// reach its OWN method — a mis-built tree would silently call the wrong one.
type A
    a_v: int
type B
    b_v: int
type C
    c_v: int
type D
    d_v: int
type E
    e_v: int
type F
    f_v: int
type G
    g_v: int

fn A.tag(self) -> int
    return 100
fn B.tag(self) -> int
    return 200
fn C.tag(self) -> int
    return 300
fn D.tag(self) -> int
    return 400
fn E.tag(self) -> int
    return 500
fn F.tag(self) -> int
    return 600
fn G.tag(self) -> int
    return 700

fn main() -> int
    let xs = []
    xs.push(A(1))
    xs.push(B(2))
    xs.push(C(3))
    xs.push(D(4))
    xs.push(E(5))
    xs.push(F(6))
    xs.push(G(7))
    // each element must dispatch to ITS OWN impl
    assert(xs[0].tag() == 100, "A dispatch")
    assert(xs[1].tag() == 200, "B dispatch")
    assert(xs[2].tag() == 300, "C dispatch")
    assert(xs[3].tag() == 400, "D dispatch")
    assert(xs[4].tag() == 500, "E dispatch")
    assert(xs[5].tag() == 600, "F dispatch")
    assert(xs[6].tag() == 700, "G dispatch")
    // and the sum pins that no arm was skipped or doubled
    let total = 0
    let i = 0
    while i < 7
        total = total + xs[i].tag()
        i = i + 1
    assert(total == 2800, "all seven dispatched exactly once")
    print("PASS _kat_dispatch")
    return 0

main()
