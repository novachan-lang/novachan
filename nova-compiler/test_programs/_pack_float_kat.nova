import std/encoding/pack

let _c = [0, 0]

fn chk(label, got, expected)
    if got == expected
        _c[0] = _c[0] + 1
    else
        _c[1] = _c[1] + 1
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))

fn bytes_eq(label, a, b, n)
    let i = 0
    while i < n
        if bytes_get(a, i) != bytes_get(b, i)
            _c[1] = _c[1] + 1
            print("FAIL " + label + " byte " + str(i) + ": got " + str(bytes_get(a, i)) + " expected " + str(bytes_get(b, i)))
            return 0
        i = i + 1
    _c[0] = _c[0] + 1
    1

// ── f64 BE: 1.0 = 0x3FF0000000000000 → [63,240,0,0,0,0,0,0] ──
let p1 = pack_f64_be(1.0)
chk("f64be_1.0_len", bytes_len(p1), 8)
chk("f64be_1.0_b0", bytes_get(p1, 0), 63)
chk("f64be_1.0_b1", bytes_get(p1, 1), 240)
chk("f64be_1.0_b2", bytes_get(p1, 2), 0)
chk("f64be_1.0_b7", bytes_get(p1, 7), 0)

let v1 = unpack_f64_be(p1, 0)
let p1r = pack_f64_be(v1)
bytes_eq("f64be_1.0_rt", p1, p1r, 8)

// ── f64 LE: 1.0 → reversed bytes ──
let p2 = pack_f64_le(1.0)
chk("f64le_1.0_b0", bytes_get(p2, 0), 0)
chk("f64le_1.0_b6", bytes_get(p2, 6), 240)
chk("f64le_1.0_b7", bytes_get(p2, 7), 63)
let v2 = unpack_f64_le(p2, 0)
let p2r = pack_f64_le(v2)
bytes_eq("f64le_1.0_rt", p2, p2r, 8)

// ── f64 BE: -1.0 = 0xBFF0000000000000 → [191,240,0,...] ──
let p3 = pack_f64_be(-1.0)
chk("f64be_neg1_b0", bytes_get(p3, 0), 191)
chk("f64be_neg1_b1", bytes_get(p3, 1), 240)
chk("f64be_neg1_b2", bytes_get(p3, 2), 0)
let v3 = unpack_f64_be(p3, 0)
let p3r = pack_f64_be(v3)
bytes_eq("f64be_neg1_rt", p3, p3r, 8)

// ── f64 BE: 0.5 = 0x3FE0000000000000 → [63,224,0,...] ──
let p4 = pack_f64_be(0.5)
chk("f64be_0.5_b0", bytes_get(p4, 0), 63)
chk("f64be_0.5_b1", bytes_get(p4, 1), 224)
let v4 = unpack_f64_be(p4, 0)
let p4r = pack_f64_be(v4)
bytes_eq("f64be_0.5_rt", p4, p4r, 8)

// ── f64 BE: 0.0 = all zeros ──
let p0 = pack_f64_be(0.0)
chk("f64be_0.0_b0", bytes_get(p0, 0), 0)
chk("f64be_0.0_b7", bytes_get(p0, 7), 0)

// ── f32 BE: 1.0 = 0x3F800000 → [63,128,0,0] ──
let q1 = pack_f32_be(1.0)
chk("f32be_1.0_len", bytes_len(q1), 4)
chk("f32be_1.0_b0", bytes_get(q1, 0), 63)
chk("f32be_1.0_b1", bytes_get(q1, 1), 128)
chk("f32be_1.0_b2", bytes_get(q1, 2), 0)
chk("f32be_1.0_b3", bytes_get(q1, 3), 0)
let q1v = unpack_f32_be(q1, 0)
let q1r = pack_f32_be(q1v)
bytes_eq("f32be_1.0_rt", q1, q1r, 4)

// ── f32 LE: 1.0 → reversed ──
let q2 = pack_f32_le(1.0)
chk("f32le_1.0_b0", bytes_get(q2, 0), 0)
chk("f32le_1.0_b3", bytes_get(q2, 3), 63)
let q2v = unpack_f32_le(q2, 0)
let q2r = pack_f32_le(q2v)
bytes_eq("f32le_1.0_rt", q2, q2r, 4)

// ── f32 BE: -1.0 = 0xBF800000 → [191,128,0,0] ──
let q3 = pack_f32_be(-1.0)
chk("f32be_neg1_b0", bytes_get(q3, 0), 191)
chk("f32be_neg1_b1", bytes_get(q3, 1), 128)
let q3v = unpack_f32_be(q3, 0)
let q3r = pack_f32_be(q3v)
bytes_eq("f32be_neg1_rt", q3, q3r, 4)

// ── f32 BE: 0.5 = 0x3F000000 → [63,0,0,0] ──
let q4 = pack_f32_be(0.5)
chk("f32be_0.5_b0", bytes_get(q4, 0), 63)
chk("f32be_0.5_b1", bytes_get(q4, 1), 0)
let q4v = unpack_f32_be(q4, 0)
let q4r = pack_f32_be(q4v)
bytes_eq("f32be_0.5_rt", q4, q4r, 4)

// ── format string: ">df" = f64 then f32 ──
let fb = pack_fmt(">df", [1.0, 0.5])
chk("fmt_df_len", bytes_len(fb), 12)
chk("fmt_df_d_b0", bytes_get(fb, 0), 63)
chk("fmt_df_d_b1", bytes_get(fb, 1), 240)
chk("fmt_df_f_b8", bytes_get(fb, 8), 63)
chk("fmt_df_f_b9", bytes_get(fb, 9), 0)

let fv = unpack_fmt(">df", fb)
let fb2 = pack_fmt(">df", fv)
bytes_eq("fmt_df_rt", fb, fb2, 12)

// ── LE format string ──
let flb = pack_fmt("<df", [1.0, 0.5])
chk("fmt_le_df_len", bytes_len(flb), 12)
chk("fmt_le_d_b7", bytes_get(flb, 7), 63)
chk("fmt_le_f_b11", bytes_get(flb, 11), 63)
let flv = unpack_fmt("<df", flb)
let flb2 = pack_fmt("<df", flv)
bytes_eq("fmt_le_df_rt", flb, flb2, 12)

// ── mixed int+float format ──
let mb = pack_fmt(">Id", [42, 2.5])
chk("fmt_Id_len", bytes_len(mb), 12)
let mv = unpack_fmt(">Id", mb)
chk("fmt_Id_int", mv[0], 42)
let mb2 = pack_fmt(">Id", mv)
bytes_eq("fmt_Id_rt", mb, mb2, 12)

print("pack_float_kat: " + str(_c[0]) + " passed, " + str(_c[1]) + " failed")
if _c[1] > 0
    exit(1)
