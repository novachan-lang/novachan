// KAT test for std/util/objectpool
import std/util/objectpool

fn cki(label, got, expected)
    if got != expected
        print("FAIL " + label + ": got " + str(got) + " expected " + str(expected))
        exit(1)

fn main()
    // KAT 1: basic acquire and in_use/available
    let p = pool_new(3)
    let a = pool_acquire(p)
    let b = pool_acquire(p)
    cki("in_use_after_2_acquire", pool_in_use(p), 2)
    cki("available_after_2_acquire", pool_available(p), 1)

    // KAT 2: release returns a handle
    pool_release(p, a)
    cki("available_after_release", pool_available(p), 2)

    // KAT 3: acquire after release
    let c = pool_acquire(p)
    let d = pool_acquire(p)

    // KAT 4: exhausted pool returns -1
    let e = pool_acquire(p)
    cki("exhausted_returns_neg1", e, 0 - 1)

    // KAT 5: capacity unchanged
    cki("capacity", pool_capacity(p), 3)

    // KAT 6: in_use when full
    cki("in_use_when_full", pool_in_use(p), 3)

    let _ = b
    let _ = c
    let _ = d

    print("_objectpool_test passed")
