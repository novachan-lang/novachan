import std/algo/strand_sort as strn

fn main()
    assert_eq(strn.strn_sort([5,3,4,1,2]), [1,2,3,4,5])
    assert_eq(strn.strn_strand_count([5,3,4,1,2]), 3)
    assert_eq(strn.strn_strand_count([1,2,3]), 1)
    assert_eq(strn.strn_strand_count([3,2,1]), 3)
    assert_eq(strn.strn_sort([]), [])
    assert_eq(strn.strn_sort_desc([1,4,2]), [4,2,1])
    assert_true(strn.strn_is_sorted([1,2,3]))
    assert_true(not strn.strn_is_sorted([3,2,1]))
    assert_eq(strn.strn_sort(["banana","apple","cherry"]), ["apple","banana","cherry"])
    print("ALL OK")
