import std/combinatorics/nextperm

// cki — check integer equality
fn cki(label, got, want)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// list_eq — returns 1 if two int lists are equal, 0 otherwise
fn list_eq(a, b)
    if len(a) != len(b)
        return 0
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        i = i + 1
    1

// list_str — render int list as "[a,b,c]"
fn list_str(xs)
    let s = "["
    let i = 0
    while i < len(xs)
        if i > 0
            s = s + ","
        s = s + str(xs[i])
        i = i + 1
    s + "]"

fn ck_list(label, got, want)
    if list_eq(got, want) == 0
        print("FAIL " + label + ": got=" + list_str(got) + " want=" + list_str(want))
        exit(1)

fn main()
    // --- np_next_permutation ---
    let a123 = [1, 2, 3]
    let n1 = np_next_permutation(a123)
    ck_list("next_perm([1,2,3])", n1, [1, 3, 2])

    let a132 = [1, 3, 2]
    let n2 = np_next_permutation(a132)
    ck_list("next_perm([1,3,2])", n2, [2, 1, 3])

    let a321 = [3, 2, 1]
    let n3 = np_next_permutation(a321)
    ck_list("next_perm([3,2,1])=unchanged", n3, [3, 2, 1])

    // chain: step through all 6 perms of [1,2,3]
    let p = [1, 2, 3]
    p = np_next_permutation(p)
    ck_list("step1", p, [1, 3, 2])
    p = np_next_permutation(p)
    ck_list("step2", p, [2, 1, 3])
    p = np_next_permutation(p)
    ck_list("step3", p, [2, 3, 1])
    p = np_next_permutation(p)
    ck_list("step4", p, [3, 1, 2])
    p = np_next_permutation(p)
    ck_list("step5", p, [3, 2, 1])
    p = np_next_permutation(p)
    ck_list("step6_last", p, [3, 2, 1])

    // --- np_prev_permutation ---
    let pv = np_prev_permutation([1, 3, 2])
    ck_list("prev_perm([1,3,2])", pv, [1, 2, 3])

    let pv2 = np_prev_permutation([1, 2, 3])
    ck_list("prev_perm([1,2,3])=unchanged", pv2, [1, 2, 3])

    let pv3 = np_prev_permutation([3, 1, 2])
    ck_list("prev_perm([3,1,2])", pv3, [2, 3, 1])

    // --- np_next_combination ---
    let c01 = np_next_combination([0, 1], 3)
    ck_list("next_comb([0,1],3)", c01, [0, 2])

    let c02 = np_next_combination([0, 2], 3)
    ck_list("next_comb([0,2],3)", c02, [1, 2])

    let c12 = np_next_combination([1, 2], 3)
    ck_list("next_comb([1,2],3)=unchanged", c12, [1, 2])

    // size-1 combos: [0]->[1]->[2]->[2](last)
    let c0 = np_next_combination([0], 3)
    ck_list("next_comb([0],3)", c0, [1])
    let c1 = np_next_combination([1], 3)
    ck_list("next_comb([1],3)", c1, [2])
    let c2 = np_next_combination([2], 3)
    ck_list("next_comb([2],3)=unchanged", c2, [2])

    // --- np_next_subset_mask ---
    cki("mask(0,3)", np_next_subset_mask(0, 3), 1)
    cki("mask(6,3)", np_next_subset_mask(6, 3), 7)
    cki("mask(7,3)=last", np_next_subset_mask(7, 3), 7)
    cki("mask(3,4)", np_next_subset_mask(3, 4), 4)

    // --- np_kth_permutation ---
    let k0 = np_kth_permutation(3, 0)
    ck_list("kth_perm(3,0)", k0, [0, 1, 2])

    let k5 = np_kth_permutation(3, 5)
    ck_list("kth_perm(3,5)", k5, [2, 1, 0])

    let k1 = np_kth_permutation(3, 1)
    ck_list("kth_perm(3,1)", k1, [0, 2, 1])

    let k3 = np_kth_permutation(3, 3)
    ck_list("kth_perm(3,3)", k3, [1, 2, 0])

    // n=4: 24 permutations; check a few
    let k4_0 = np_kth_permutation(4, 0)
    ck_list("kth_perm(4,0)", k4_0, [0, 1, 2, 3])

    let k4_23 = np_kth_permutation(4, 23)
    ck_list("kth_perm(4,23)", k4_23, [3, 2, 1, 0])

    // --- np_permutation_index ---
    cki("perm_idx([0,1,2])", np_permutation_index([0, 1, 2]), 0)
    cki("perm_idx([2,1,0])", np_permutation_index([2, 1, 0]), 5)
    cki("perm_idx([0,2,1])", np_permutation_index([0, 2, 1]), 1)
    cki("perm_idx([1,2,0])", np_permutation_index([1, 2, 0]), 3)

    // roundtrip: kth_permutation(3, k) should have index k
    cki("roundtrip_k0", np_permutation_index(np_kth_permutation(3, 0)), 0)
    cki("roundtrip_k3", np_permutation_index(np_kth_permutation(3, 3)), 3)
    cki("roundtrip_k5", np_permutation_index(np_kth_permutation(3, 5)), 5)

    // --- np_has_next_perm ---
    cki("has_next([1,2,3])", np_has_next_perm([1, 2, 3]), 1)
    cki("has_next([3,2,1])", np_has_next_perm([3, 2, 1]), 0)
    cki("has_next([1])", np_has_next_perm([1]), 0)
    cki("has_next([])", np_has_next_perm([]), 0)
    cki("has_next([2,3,1])", np_has_next_perm([2, 3, 1]), 1)

    // --- np_next_multiset_perm ---
    // [1,1,2] -> [1,2,1]
    let m1 = np_next_multiset_perm([1, 1, 2])
    ck_list("multi_next([1,1,2])", m1, [1, 2, 1])

    let m2 = np_next_multiset_perm([1, 2, 1])
    ck_list("multi_next([1,2,1])", m2, [2, 1, 1])

    let m3 = np_next_multiset_perm([2, 1, 1])
    ck_list("multi_next([2,1,1])=unchanged", m3, [2, 1, 1])

    // count distinct multiset perms of [1,1,2] = 3!/2! = 3
    let mp = [1, 1, 2]
    let mc = 1
    let mp2 = np_next_multiset_perm(mp)
    if list_eq(mp2, mp) == 0
        mc = mc + 1
        let mp3 = np_next_multiset_perm(mp2)
        if list_eq(mp3, mp2) == 0
            mc = mc + 1
    cki("multiset_count_112", mc, 3)

    print("PASS _nextperm_test")
