import forge_release_manager

fn main()
    let rm = rm_new()
    rm = rm_create(rm, "1.0.0", "Initial release")
    rm = rm_create(rm, "1.1.0", "Feature update")
    assert(rm_release_count(rm) == 2, "2 releases")
    assert(rm_has_release(rm, "1.0.0") == 1, "has 1.0.0")
    assert(rm_has_release(rm, "2.0.0") == 0, "no 2.0.0")

    let d1 = rm_description(rm, "1.0.0")
    assert(unwrap(d1) == "Initial release", "desc ok")

    let a1 = rm_add_artifact(rm, "1.0.0", "nova-linux-x64")
    rm = unwrap(a1)
    let a2 = rm_add_artifact(rm, "1.0.0", "nova-win-x64")
    rm = unwrap(a2)
    let ac = rm_artifact_count(rm, "1.0.0")
    assert(unwrap(ac) == 2, "2 artifacts")

    let p1 = rm_publish(rm, "1.0.0")
    rm = unwrap(p1)
    let st = rm_status(rm, "1.0.0")
    assert(unwrap(st) == "published", "published")

    let cur = rm_current(rm)
    assert(unwrap(cur) == "1.0.0", "current 1.0.0")

    let st2 = rm_status(rm, "1.1.0")
    assert(unwrap(st2) == "draft", "1.1.0 draft")

    let dup = rm_publish(rm, "1.0.0")
    assert(is_err(dup), "double publish")

    let bad = rm_status(rm, "9.9.9")
    assert(is_err(bad), "not found")

    print("RELEASE-MANAGER KAT PASS")
