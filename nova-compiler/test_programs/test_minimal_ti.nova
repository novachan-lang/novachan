// Minimal test: reproduce the same types as the full compiler

type Token
    kind: string
    value: string
    line: int
    col: int

type Expr
    tag: string
    value: string
    num: int
    children: list
    fields: list
    eline: int

type Stmt
    tag: string
    name: string
    expr: Expr
    body: list
    params: list
    else_body: list
    annotations: list
    sline: int

type Param
    name: string
    type_ann: string
    default_val: Expr

type ParseResult
    expr: Expr
    pos: int

type StmtParseResult
    stmt: Stmt
    pos: int

type IrType
    kind: string
    name: string
    params: list
    id: int

type IrInst
    op: string
    dest: string
    type: IrType
    args: list
    value: string
    num: int
    effect: string

type IrBlock
    label: string
    insts: list
    terminator: IrInst

type IrParam
    name: string
    type: IrType

type IrFunction
    name: string
    params: list
    ret_type: IrType
    blocks: list
    type_params: list
    is_extern: int

type IrModule
    functions: list
    structs: list
    globals: list
    string_constants: list

type NType
    kind: string
    name: string
    params: list
    id: int

type NTypeScheme
    quantified: list
    body: NType

type NConstraint
    a: NType
    b: NType
    line: int

type TiState
    ti_next_id: int
    ti_bindings: dict
    ti_constraints: list
    ti_errors: list
    ti_scope: list
    ti_structs: dict
    ti_fn_types: dict
    ti_ret_var: NType
    ti_in_fn: string
    ti_stdlib: dict
    ti_unify_count: int
    ti_source_lines: list

// NType constructors
fn nt_int() -> NType
    NType("int", "", [], 0)

fn nt_float() -> NType
    NType("float", "", [], 0)

fn nt_string() -> NType
    NType("string", "", [], 0)

fn nt_bool() -> NType
    NType("bool", "", [], 0)

fn nt_unit() -> NType
    NType("unit", "", [], 0)

fn nt_any() -> NType
    NType("any", "", [], 0)

fn nt_var(vid: int) -> NType
    NType("var", "", [], vid)

fn nt_fn(p: list, ret: NType) -> NType
    let combined = []
    for x in p
        push(combined, x)
    push(combined, ret)
    NType("fn", "", combined, 0)

fn nt_list(elem: NType) -> NType
    NType("list", "", [elem], 0)

// Build stdlib exactly like the compiler
fn ti_build_stdlib() -> dict
    let reg = {}
    let T = nt_var(-1)
    let U = nt_var(-2)
    reg["print"] = NTypeScheme([-1], nt_fn([T], nt_unit()))
    reg["input"] = NTypeScheme([], nt_fn([], nt_string()))
    reg["str"] = NTypeScheme([-1], nt_fn([T], nt_string()))
    reg["int"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["float"] = NTypeScheme([-1], nt_fn([T], nt_float()))
    reg["len"] = NTypeScheme([-1], nt_fn([T], nt_int()))
    reg["push"] = NTypeScheme([-1], nt_fn([nt_list(T), T], nt_unit()))
    reg["ord"] = NTypeScheme([], nt_fn([nt_string()], nt_int()))
    reg["chr"] = NTypeScheme([], nt_fn([nt_int()], nt_string()))
    return reg

fn ti_subst(t: NType, subst: dict) -> NType
    match t
        NType(kind, name, params, id) =>
            if kind == "var"
                let key = str(id)
                if contains(subst, key)
                    return subst[key]
                return t
            if len(params) == 0
                return t
            let np = []
            for p in params
                push(np, ti_subst(p, subst))
            return NType(kind, name, np, id)
    t

fn test_ntype()
    print("Creating NType objects...")
    let t1 = nt_int()
    let t2 = nt_string()
    let t3 = nt_unit()
    let t4 = nt_var(-1)
    let t5 = nt_var(-2)

    // Test pattern matching
    match t1
        NType(k, n, p, i) =>
            print("t1 kind: " + k)

    match t4
        NType(k, n, p, i) =>
            print("t4 kind: " + k + " id: " + str(i))

    // Test NTypeScheme
    let scheme = NTypeScheme([-1], nt_fn([t4], t3))
    match scheme
        NTypeScheme(q, b) =>
            match b
                NType(k, n, p, i) =>
                    print("scheme body kind: " + k)

    // Test ti_build_stdlib
    print("Building stdlib...")
    let stdlib = ti_build_stdlib()
    print("Stdlib built with " + str(len(stdlib)) + " entries")

    // Test ti_subst
    let sub = {}
    sub["-1"] = nt_int()
    let result = ti_subst(nt_var(-1), sub)
    match result
        NType(k, n, p, i) =>
            print("Substituted: " + k)

    print("All NType tests passed!")

// Also test Expr and Stmt to check for cross-type issues
fn test_expr_stmt()
    let e = Expr("ident", "x", 0, [], [], 42)
    match e
        Expr(tag, value, num, children, fields, eline) =>
            print("Expr tag: " + tag + " eline: " + str(eline))

    let null_e = Expr("null", "", 0, [], [], 0)
    let s = Stmt("let", "x", null_e, [], [], [], [], 10)
    match s
        Stmt(tag, name, expr, body, params, else_body, annotations, sline) =>
            print("Stmt tag: " + tag + " sline: " + str(sline))

    print("Expr/Stmt tests passed!")

// Test Token
fn test_token()
    let tok = Token("IDENT", "hello", 1, 5)
    match tok
        Token(kind, value, line, col) =>
            print("Token kind: " + kind + " line: " + str(line))
    print("Token tests passed!")

// Test IrType (same fields as NType!)
fn test_irtype()
    let ir = IrType("int", "", [], 0)
    match ir
        IrType(kind, name, params, id) =>
            print("IrType kind: " + kind)
    print("IrType tests passed!")

// Entry point
test_token()
test_irtype()
test_ntype()
test_expr_stmt()
print("ALL TESTS PASSED")
