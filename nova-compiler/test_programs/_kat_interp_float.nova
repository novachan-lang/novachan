// KAT: string interpolation of floats/bools/format-specs must render the VALUE, not raw bits.
// Regression for the dogfood-found soundness bug: "{floatvar}" printed the IEEE-754 int64 bit
// pattern (150.0 -> 4639481672377565184) because interpolation lowered to nova_rt_any_to_str /
// nova_rt_format_one with a RAW (unboxed) float, violating the "float boxed at every any-widen
// point" invariant. Fix: specialize any_to_str(float)->float_to_str, any_to_str(bool)->bool_to_str
// in ir_infer_one; box the float for format_one (and exclude format_one from the generic fpt
// boxing branch, which mis-classified the concrete-float param as "callee reads raw bits").
// Asserts compare the INTERPOLATED STRING to its expected literal -> catches value corruption,
// not just display, and fails the gate (non-zero exit via nova_panic) on any regression.
type Priced
    price: float

fn main() -> int
    // bare float, and with a literal prefix/suffix (different concat paths)
    let a = 150.0
    assert("{a}" == "150.0", "bare float interp")
    assert("v={a}" == "v=150.0", "prefix float interp")
    assert("{a}!" == "150.0!", "suffix float interp")

    // a non-round float (fractional digits must survive)
    let b = 9.99
    assert("{b}" == "9.99", "fractional float interp")

    // format specs on a float
    assert("{a:.2f}" == "150.00", "fmt .2f float interp")
    assert("{a:f}" == "150.000000", "fmt f float interp")
    assert("{b:.1f}" == "10.0", "fmt .1f rounds")

    // bool interpolation renders true/false (matches str()/print()), not 1/0
    let flag = true
    assert("{flag}" == "true", "bool true interp")
    let flag2 = false
    assert("{flag2}" == "false", "bool false interp")

    // int and string interpolation must still be correct (no regression)
    let n = 42
    assert("{n}" == "42", "int interp")
    assert("{n:d}" == "42", "int fmt d")
    let s = "hi"
    assert("{s}" == "hi", "string interp")

    // struct FLOAT FIELD interpolation (Gap 1) -- the field read is a raw double
    let p = Priced(19.99)
    assert("{p.price}" == "19.99", "struct float field interp")
    assert("price={p.price}" == "price=19.99", "struct float field prefix interp")

    print("PASS _kat_interp_float")
    return 0

main()
