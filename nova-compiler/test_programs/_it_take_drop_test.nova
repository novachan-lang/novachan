import std/itertools/it_take_drop

// ── helpers ──────────────────────────────────────────────────────────────────

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ckflat(label: string, got, wantlist)
    let wn = len(wantlist)
    if len(got) != wn
        print("FAIL " + label + " len: got=" + str(len(got)) + " want=" + str(wn))
        exit(1)
    let i = 0
    while i < wn
        if got[i] != wantlist[i]
            print("FAIL " + label + "[" + str(i) + "]: got=" + str(got[i]) + " want=" + str(wantlist[i]))
            exit(1)
        i = i + 1

fn main()
    let xs = [1, 2, 3, 4, 5]

    // ── itt_take ──────────────────────────────────────────────────────────
    ckflat("take_3", itt_take(xs, 3), [1, 2, 3])
    ckflat("take_0", itt_take(xs, 0), [])
    ckflat("take_5", itt_take(xs, 5), [1, 2, 3, 4, 5])
    // n > len: clamp to whole list
    ckflat("take_over", itt_take([1, 2], 5), [1, 2])
    // empty
    ckflat("take_empty", itt_take([], 3), [])
    // n < 0: []
    ckflat("take_neg", itt_take(xs, -1), [])

    // ── itt_drop ──────────────────────────────────────────────────────────
    ckflat("drop_2", itt_drop(xs, 2), [3, 4, 5])
    ckflat("drop_0", itt_drop(xs, 0), [1, 2, 3, 4, 5])
    ckflat("drop_5", itt_drop(xs, 5), [])
    // n > len: []
    ckflat("drop_over", itt_drop(xs, 10), [])
    // empty
    ckflat("drop_empty", itt_drop([], 2), [])
    // n < 0: same as drop(0)
    ckflat("drop_neg", itt_drop([1, 2, 3], -1), [1, 2, 3])

    // ── itt_take_last ─────────────────────────────────────────────────────
    ckflat("take_last_2", itt_take_last(xs, 2), [4, 5])
    ckflat("take_last_1", itt_take_last(xs, 1), [5])
    ckflat("take_last_5", itt_take_last(xs, 5), [1, 2, 3, 4, 5])
    // n > len: whole list
    ckflat("take_last_over", itt_take_last([1, 2, 3], 10), [1, 2, 3])
    // n=0: []
    ckflat("take_last_0", itt_take_last(xs, 0), [])
    // empty
    ckflat("take_last_empty", itt_take_last([], 3), [])

    // ── itt_drop_last ─────────────────────────────────────────────────────
    ckflat("drop_last_2", itt_drop_last(xs, 2), [1, 2, 3])
    ckflat("drop_last_0", itt_drop_last(xs, 0), [1, 2, 3, 4, 5])
    ckflat("drop_last_5", itt_drop_last(xs, 5), [])
    // n > len: []
    ckflat("drop_last_over", itt_drop_last(xs, 10), [])
    // empty
    ckflat("drop_last_empty", itt_drop_last([], 2), [])

    // ── itt_slice ─────────────────────────────────────────────────────────
    ckflat("slice_1_4", itt_slice(xs, 1, 4), [2, 3, 4])
    ckflat("slice_0_3", itt_slice(xs, 0, 3), [1, 2, 3])
    ckflat("slice_full", itt_slice(xs, 0, 5), [1, 2, 3, 4, 5])
    // empty range
    ckflat("slice_empty_range", itt_slice(xs, 2, 2), [])
    // start >= stop: []
    ckflat("slice_inverted", itt_slice(xs, 4, 2), [])
    // clamp to len
    ckflat("slice_clamp", itt_slice(xs, 3, 99), [4, 5])
    // start < 0: treated as 0
    ckflat("slice_neg_start", itt_slice(xs, -1, 3), [1, 2, 3])
    // empty list
    ckflat("slice_empty_list", itt_slice([], 0, 3), [])

    // ── itt_step ─────────────────────────────────────────────────────────
    ckflat("step_2", itt_step([1, 2, 3, 4, 5, 6], 2), [1, 3, 5])
    ckflat("step_1", itt_step([1, 2, 3], 1), [1, 2, 3])
    ckflat("step_3", itt_step([1, 2, 3, 4, 5, 6, 7], 3), [1, 4, 7])
    // step > len: single element
    ckflat("step_over", itt_step([1, 2, 3], 10), [1])
    // step <= 0: []
    ckflat("step_0", itt_step([1, 2, 3], 0), [])
    ckflat("step_neg", itt_step([1, 2, 3], -1), [])
    // empty: []
    ckflat("step_empty", itt_step([], 2), [])

    // ── round-trip: take(n) + drop(n) == original ─────────────────────────
    let rt = [10, 20, 30, 40, 50]
    let n_rt = 3
    let taken = itt_take(rt, n_rt)
    let dropped = itt_drop(rt, n_rt)
    cki("rt_take_len", len(taken), n_rt)
    cki("rt_drop_len", len(dropped), len(rt) - n_rt)
    cki("rt_take_0", taken[0], rt[0])
    cki("rt_drop_0", dropped[0], rt[n_rt])

    // round-trip: take_last(n) + drop_last(n) == original
    let tl = itt_take_last(rt, n_rt)
    let dl = itt_drop_last(rt, n_rt)
    cki("rt_take_last_len", len(tl), n_rt)
    cki("rt_drop_last_len", len(dl), len(rt) - n_rt)
    cki("rt_take_last_0", tl[0], rt[len(rt) - n_rt])
    cki("rt_drop_last_last", dl[len(dl) - 1], rt[len(rt) - n_rt - 1])

    print("PASS _it_take_drop_test")
