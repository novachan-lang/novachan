import std/os/memops

fn ck_int(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ck_bool(label: string, got: bool, want: bool)
    if got != want
        print("FAIL " + label + ": got " + str(got) + " want " + str(want))
        exit(1)

fn ck_list(label: string, got: any, want: any)
    if len(got) != len(want)
        print("FAIL " + label + ": length got " + str(len(got)) + " want " + str(len(want)))
        exit(1)
    let i = 0
    while i < len(want)
        if got[i] != want[i]
            print("FAIL " + label + ": index " + str(i) + " got " + str(got[i]) + " want " + str(want[i]))
            exit(1)
        i = i + 1

// KAT: mem_fill(3,7)==[7,7,7]
ck_list("mem_fill_basic", mem_fill(3,7), [7,7,7])

// KAT: mem_fill(0,5)==[]
ck_list("mem_fill_zero", mem_fill(0,5), [])

// KAT: mem_equal([1,2],[1,2])==true
ck_bool("mem_equal_true", mem_equal([1,2],[1,2]), true)

// KAT: mem_equal([1,2],[1,3])==false
ck_bool("mem_equal_false", mem_equal([1,2],[1,3]), false)

// KAT: mem_equal different lengths
ck_bool("mem_equal_diff_len", mem_equal([1,2],[1,2,3]), false)

// KAT: mem_equal empty lists
ck_bool("mem_equal_empty", mem_equal([],[]), true)

// KAT: mem_compare([1,2],[1,3])==-1
ck_int("mem_compare_lt", mem_compare([1,2],[1,3]), -1)

// KAT: mem_compare([1,2],[1,2])==0
ck_int("mem_compare_eq", mem_compare([1,2],[1,2]), 0)

// KAT: mem_compare([1,3],[1,2])==1
ck_int("mem_compare_gt", mem_compare([1,3],[1,2]), 1)

// KAT: mem_compare shorter < longer with same prefix
ck_int("mem_compare_short_lt", mem_compare([1,2],[1,2,3]), -1)

// KAT: mem_compare longer > shorter
ck_int("mem_compare_long_gt", mem_compare([1,2,3],[1,2]), 1)

// KAT: mem_compare empty vs empty
ck_int("mem_compare_empty", mem_compare([],[]), 0)

// KAT: mem_reverse([1,2,3])==[3,2,1]
ck_list("mem_reverse_basic", mem_reverse([1,2,3]), [3,2,1])

// KAT: mem_reverse single element
ck_list("mem_reverse_one", mem_reverse([5]), [5])

// KAT: mem_reverse empty
ck_list("mem_reverse_empty", mem_reverse([]), [])

// KAT: mem_xor([1,2],[3,3])==[2,1]
ck_list("mem_xor_basic", mem_xor([1,2],[3,3]), [2,1])

// KAT: mem_xor identity (XOR with 0)
ck_list("mem_xor_zero", mem_xor([5,6,7],[0,0,0]), [5,6,7])

// KAT: mem_xor self == all zeros
ck_list("mem_xor_self", mem_xor([5,6,7],[5,6,7]), [0,0,0])

// KAT: mem_xor truncates to shorter length
let xr = mem_xor([1,2,3],[4,5])
ck_int("mem_xor_trunc_len", len(xr), 2)

// KAT: mem_copy produces equal but independent list
let src = [10,20,30]
let cp = mem_copy(src)
ck_list("mem_copy_eq", cp, [10,20,30])
// Mutate copy; original unchanged
cp[0] = 99
ck_int("mem_copy_independent", src[0], 10)

print("PASS _memops_test")
