// pins the 0.9 SIBLING fix: ordering (< <= > >=) of a DYNAMIC value (any/val) vs a string must NOT
// crash. Before: `str OR str` -> raw strcmp-ordering derefs a non-pointer (dict["missing"]->0) -> segv.
// After: str-vs-dynamic routes to box-aware nova_rt_lt/le/gt/ge (nova_rt_cmp: strcmp only when both
// strings, else unbox+int-compare). str<str keeps the fast path.
fn main()
    let d = {}
    d["k"] = "m"
    let miss = d["missing"]          // any holding int 0
    // (1) any(0) vs string: must not crash (result is deterministic; we only assert no-segv here)
    let a1 = miss < "x"
    let a2 = miss > "x"
    let a3 = miss <= "x"
    let a4 = miss >= "x"
    print("any(0) vs str ok: " + str(a1) + str(a2) + str(a3) + str(a4))
    // (2) any holding a string vs strings: correct lexicographic order
    let hit = d["k"]                 // any holding "m"
    assert((hit < "n") == 1, "any('m') < 'n'")
    assert((hit > "a") == 1, "any('m') > 'a'")
    assert((hit <= "m") == 1, "any('m') <= 'm'")
    assert((hit >= "m") == 1, "any('m') >= 'm'")
    // (3) plain typed strings keep correct ordering
    let s = "hello"
    assert((s < "world") == 1, "str < str")
    assert((s > "abc") == 1, "str > str")
    assert((s < "abc") == 0, "str not < smaller")
    // (4) any-vs-any (two dict-sourced strings)
    let e = {}
    e["p"] = "apple"
    e["q"] = "banana"
    assert((e["p"] < e["q"]) == 1, "any('apple') < any('banana')")
    print("ord_mixed_test passed -- ordering of dynamic-vs-string is box-aware, no deref crash")
