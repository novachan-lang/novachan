// KAT for std/encoding/base45 — RFC 9285 (binary-safe).
import std/encoding/base45

fn _b(s: string) -> any
    let o = bytes(0)
    let i = 0
    while i < len(s)
        o = bytes_append(o, ord(char_at(s, i)))
        i = i + 1
    return o

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": '" + got + "' != '" + want + "'")
        exit(1)

fn main()
    cks("AB", base45_encode(_b("AB")), "BB8")
    cks("Hello", base45_encode(_b("Hello!!")), "%69 VD92EX0")
    cks("base-45", base45_encode(_b("base-45")), "UJCLQE7W581")
    cks("ietf", base45_encode(_b("ietf!")), "QED8WEX0")
    cks("empty", base45_encode(_b("")), "")
    // binary round-trip [0x00,0xFF,0x00]
    let bin = bytes(0)
    bin = bytes_append(bin, 0)
    bin = bytes_append(bin, 255)
    bin = bytes_append(bin, 0)
    let dec = base45_decode(base45_encode(bin))
    if bytes_len(dec) != 3
        print("FAIL bin len " + str(bytes_len(dec)))
        exit(1)
    if bytes_get(dec, 0) != 0 or bytes_get(dec, 1) != 255 or bytes_get(dec, 2) != 0
        print("FAIL bin content")
        exit(1)
    print("_base45_test passed")
