fn main()
    let found_i = 0
    let found_j = 0
    outer: while true
        found_i = found_i + 1
        let j = 0
        while j < 10
            j = j + 1
            if found_i == 3 and j == 5
                found_j = j
                break outer
    assert(found_i == 3, "labeled break outer i")
    assert(found_j == 5, "labeled break outer j")

    let sum = 0
    let k = 0
    outer2: while k < 5
        k = k + 1
        let m = 0
        while m < 5
            m = m + 1
            if m == 3
                continue outer2
            sum = sum + 1
    assert(sum == 10, "labeled continue outer sum")

    print("LABELED BREAK/CONTINUE PASS")
