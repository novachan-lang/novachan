// KAT for std/net/cookie — HTTP cookie parse/build/set-cookie.
import std/net/cookie

fn cks(label: string, got: string, want: string)
    if got != want
        print("FAIL " + label + ": got='" + got + "' want='" + want + "'")
        exit(1)

fn cki(label: string, got: int, want: int)
    if got != want
        print("FAIL " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

// _contains_str: returns 1 if sub is found anywhere in s, else 0.
fn _contains_str(s: string, sub: string) -> int
    let sn = len(s)
    let subn = len(sub)
    if subn == 0
        return 1
    if subn > sn
        return 0
    let i = 0
    while i <= sn - subn
        let j = 0
        let ok = 1
        while j < subn
            if char_at(s, i + j) != char_at(sub, j)
                ok = 0
                j = subn
            else
                j = j + 1
        if ok == 1
            return 1
        i = i + 1
    0

fn main()
    // ── ck_parse: two-pair Cookie header ─────────────────────────────────────
    let p1 = ck_parse("a=1; b=2")
    cks("parse-a", p1["a"], "1")
    cks("parse-b", p1["b"], "2")

    // ── ck_parse: single cookie ───────────────────────────────────────────────
    let p2 = ck_parse("session=abc123")
    cks("parse-session", p2["session"], "abc123")

    // ── ck_parse: value with spaces (not trimmed from value itself) ───────────
    let p3 = ck_parse("x=hello world")
    cks("parse-value-space", p3["x"], "hello world")

    // ── ck_parse: extra spaces around pairs ──────────────────────────────────
    let p4 = ck_parse("  a=1  ;  b=2  ")
    cks("parse-trim-a", p4["a"], "1")
    cks("parse-trim-b", p4["b"], "2")

    // ── ck_parse: empty header -> empty dict ─────────────────────────────────
    let p5 = ck_parse("")
    cki("parse-empty", len(keys(p5)), 0)

    // ── ck_parse: cookie with no '=' gets value "" ───────────────────────────
    let p6 = ck_parse("bare")
    cks("parse-bare", p6["bare"], "")

    // ── ck_build: two-pair dict (sorted) ─────────────────────────────────────
    let d1 = {}
    d1["a"] = "1"
    d1["b"] = "2"
    cks("build-plain", ck_build(d1), "a=1; b=2")

    // ── ck_build: keys sorted even if inserted reverse order ─────────────────
    let d2 = {}
    d2["z"] = "9"
    d2["a"] = "1"
    cks("build-sorted", ck_build(d2), "a=1; z=9")

    // ── ck_build: empty dict -> "" ────────────────────────────────────────────
    let d3 = {}
    cks("build-empty", ck_build(d3), "")

    // ── ck_set_cookie: minimal (no opts) ─────────────────────────────────────
    let sc1 = ck_set_cookie("sid", "xyz", {})
    cks("setcookie-basic", sc1, "sid=xyz")

    // ── ck_set_cookie: with path ──────────────────────────────────────────────
    let o2 = {}
    o2["path"] = "/"
    let sc2 = ck_set_cookie("sid", "xyz", o2)
    cks("setcookie-path", sc2, "sid=xyz; Path=/")

    // ── ck_set_cookie: with HttpOnly ──────────────────────────────────────────
    let o3 = {}
    o3["HttpOnly"] = 1
    let sc3 = ck_set_cookie("sid", "xyz", o3)
    cks("setcookie-httponly", sc3, "sid=xyz; HttpOnly")

    // ── ck_set_cookie: path + HttpOnly (KAT contains checks) ─────────────────
    let o4 = {}
    o4["path"] = "/"
    o4["HttpOnly"] = 1
    let sc4 = ck_set_cookie("sid", "xyz", o4)
    cki("setcookie-ph-has-sid",    _contains_str(sc4, "sid=xyz"), 1)
    cki("setcookie-ph-has-path",   _contains_str(sc4, "Path=/"), 1)
    cki("setcookie-ph-has-ho",     _contains_str(sc4, "HttpOnly"), 1)

    // ── ck_set_cookie: full opts ──────────────────────────────────────────────
    let o5 = {}
    o5["path"] = "/"
    o5["domain"] = "example.com"
    o5["max_age"] = "3600"
    o5["HttpOnly"] = 1
    o5["Secure"] = 1
    o5["samesite"] = "Strict"
    let sc5 = ck_set_cookie("a", "b", o5)
    cks("setcookie-full", sc5, "a=b; Path=/; Domain=example.com; Max-Age=3600; HttpOnly; Secure; SameSite=Strict")

    // ── ck_set_cookie: Secure with truthy string ──────────────────────────────
    let o6 = {}
    o6["Secure"] = "yes"
    let sc6 = ck_set_cookie("tok", "val", o6)
    cks("setcookie-secure-str", sc6, "tok=val; Secure")

    // ── ck_set_cookie: HttpOnly=0 -> bare flag NOT emitted ───────────────────
    let o7 = {}
    o7["HttpOnly"] = 0
    let sc7 = ck_set_cookie("x", "y", o7)
    cks("setcookie-ho-falsy", sc7, "x=y")

    // ── ck_set_cookie: samesite only ──────────────────────────────────────────
    let o8 = {}
    o8["samesite"] = "Lax"
    let sc8 = ck_set_cookie("c", "d", o8)
    cks("setcookie-samesite", sc8, "c=d; SameSite=Lax")

    print("_cookie_test passed")
