import std/search/rotated_search

fn cki(label: str, got: int, want: int)
    if got != want
        print("FAIL rotated_search " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn main()
    // --- rs_search ---
    // KAT: rs_search([4,5,6,7,0,1,2],0)=4
    let a1 = [4, 5, 6, 7, 0, 1, 2]
    cki("search([4,5,6,7,0,1,2],0)", rs_search(a1, 0), 4)
    // KAT: rs_search([4,5,6,7,0,1,2],3)=-1
    cki("search([4,5,6,7,0,1,2],3)", rs_search(a1, 3), -1)
    // KAT: rs_search([4,5,6,7,0,1,2],6)=2
    cki("search([4,5,6,7,0,1,2],6)", rs_search(a1, 6), 2)
    // search for first element
    cki("search([4,5,6,7,0,1,2],4)", rs_search(a1, 4), 0)
    // search for last element
    cki("search([4,5,6,7,0,1,2],2)", rs_search(a1, 2), 6)
    // search for pivot element
    cki("search([4,5,6,7,0,1,2],7)", rs_search(a1, 7), 3)
    cki("search([4,5,6,7,0,1,2],1)", rs_search(a1, 1), 5)
    // not found below range
    cki("search([4,5,6,7,0,1,2],-1)", rs_search(a1, -1), -1)
    // not found above range
    cki("search([4,5,6,7,0,1,2],8)", rs_search(a1, 8), -1)
    // non-rotated array (pivot=0)
    let a_sorted = [1, 2, 3, 4, 5]
    cki("search([1,2,3,4,5],3)", rs_search(a_sorted, 3), 2)
    cki("search([1,2,3,4,5],6)", rs_search(a_sorted, 6), -1)
    // single element
    let a_single = [42]
    cki("search([42],42)", rs_search(a_single, 42), 0)
    cki("search([42],1)", rs_search(a_single, 1), -1)
    // empty
    let a_empty = []
    cki("search([],1)", rs_search(a_empty, 1), -1)
    // rotated at first position: [2,3,4,5,1] -> pivot at 4
    let a2 = [2, 3, 4, 5, 1]
    cki("search([2,3,4,5,1],1)", rs_search(a2, 1), 4)
    cki("search([2,3,4,5,1],5)", rs_search(a2, 5), 3)
    cki("search([2,3,4,5,1],0)", rs_search(a2, 0), -1)

    // --- rs_find_min ---
    // KAT: rs_find_min([4,5,6,7,0,1,2])=0
    cki("find_min([4,5,6,7,0,1,2])", rs_find_min(a1), 0)
    // KAT: rs_find_min([1,2,3])=1
    let a_sorted3 = [1, 2, 3]
    cki("find_min([1,2,3])", rs_find_min(a_sorted3), 1)
    // single element
    cki("find_min([42])", rs_find_min(a_single), 42)
    // rotated by 1: [3,1,2]
    let a3 = [3, 1, 2]
    cki("find_min([3,1,2])", rs_find_min(a3), 1)

    // --- rs_min_index ---
    // KAT: rs_min_index([4,5,6,7,0,1,2])=4
    cki("min_index([4,5,6,7,0,1,2])", rs_min_index(a1), 4)
    // KAT: rs_min_index([1,2,3])=0
    cki("min_index([1,2,3])", rs_min_index(a_sorted3), 0)
    // single element -> index 0
    cki("min_index([42])", rs_min_index(a_single), 0)
    // [3,1,2] -> min at index 1
    cki("min_index([3,1,2])", rs_min_index(a3), 1)
    // rotated by 1 at end: [2,3,4,5,1]
    cki("min_index([2,3,4,5,1])", rs_min_index(a2), 4)

    print("PASS _rotated_search_test")
