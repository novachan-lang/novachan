// KAT: multi-line lambda bodies in ARGUMENT position -- the last language gap the ten
// founding programs exercised (programs 5, 8 and 10 all use it).
//
//     http.serve(8080, routes =>
//         routes.get("/health", handler)
//     )
//
// Implemented by LIFTING the block into a nested named function and passing a reference,
// which is the same lambda-lifting the trailing-`fn` form already uses. That choice is what
// makes CAPTURE work for free: the lifted function is a SIBLING statement, so NOVA's existing
// closure conversion applies. The alternative -- a block-EXPRESSION node -- would have needed
// inference, IR lowering, capture analysis and the s4 renamer all taught about an Expr that
// carries Stmts, for the same observable behaviour.
//
// Also covers `EXPR else FALLBACK` as a bare EXPRESSION STATEMENT (founding programs 9/10),
// and an `unsafe` block used as a function's value.

fn run1(n: int, f) -> int
    f(n)

fn run2(a: int, b: int, f) -> int
    f(a, b)

fn halve(n: int) -> Result
    if n % 2 == 1
        return err("odd")
    ok(n / 2)

// expression-statement `else`: the function's last expression IS its return value
fn half_or(n: int, d: int) -> int
    halve(n) else d

fn tail_unsafe(n: int) -> int
    unsafe
        let a = n * 2
        a + 1

fn main()
    let ok_n = 0
    let fail = 0
    let base = 100

    // ── block lambda, single param, capturing an enclosing local ─────────
    let r = run1(5, x =>
        let y = x * 2
        y + base
    )
    if r == 110
        ok_n = ok_n + 1
        print("ok: block lambda captures the enclosing scope")
    else
        fail = fail + 1
        print("FAIL capture: " + str(r))

    // ── two-parameter form ──────────────────────────────────────────────
    let r2 = run2(3, 4, (a, b) =>
        let s = a + b
        s * 10
    )
    if r2 == 70
        ok_n = ok_n + 1
        print("ok: two-parameter block lambda")
    else
        fail = fail + 1
        print("FAIL two-param: " + str(r2))

    // ── single-EXPRESSION lambdas must be completely unaffected ──────────
    let r3 = run1(7, x => x + 1)
    let r4 = run2(2, 3, (a, b) => a * b)
    if r3 == 8 and r4 == 6
        ok_n = ok_n + 1
        print("ok: single-expression lambdas unchanged")
    else
        fail = fail + 1
        print("FAIL single-expr: " + str(r3) + " " + str(r4))

    // ── nesting: a block lambda inside a block lambda, both capturing ────
    let r5 = run1(2, x =>
        let inner = run1(x, y =>
            let z = y * y
            z + base
        )
        inner + 1
    )
    if r5 == 105
        ok_n = ok_n + 1
        print("ok: nested block lambdas, both capturing")
    else
        fail = fail + 1
        print("FAIL nested: " + str(r5))

    // ── `EXPR else FALLBACK` as an expression statement ──────────────────
    if half_or(10, -1) == 5 and half_or(7, -1) == -1
        ok_n = ok_n + 1
        print("ok: `else` fallback as a bare expression statement")
    else
        fail = fail + 1
        print("FAIL expr-stmt else: " + str(half_or(10, -1)) + " " + str(half_or(7, -1)))

    // ── unsafe block in value position ──────────────────────────────────
    if tail_unsafe(5) == 11
        ok_n = ok_n + 1
        print("ok: `unsafe` block yields its last expression")
    else
        fail = fail + 1
        print("FAIL unsafe value: " + str(tail_unsafe(5)))

    // ── the `if c then A else B` sugar must still work ───────────────────
    let msg = ""
    if base > 5 then msg = "big" else msg = "small"
    let n2 = 0
    if base > 5 then n2 = 1
    if msg == "big" and n2 == 1
        ok_n = ok_n + 1
        print("ok: `if c then ... else ...` sugar unaffected")
    else
        fail = fail + 1
        print("FAIL then-sugar: " + msg + " " + str(n2))

    print("ok=" + str(ok_n) + " fail=" + str(fail))
    assert(fail == 0, "block_lambda: all checks pass")
    assert(ok_n == 7, "block_lambda: all 7 checks ran")
    print("KAT block_lambda PASS")
