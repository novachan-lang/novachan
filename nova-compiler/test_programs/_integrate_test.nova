// KAT test for std/numeric/integrate.nova
// Tests: trapezoid, simpson on sampled values
import std/numeric/integrate

fn approx(a, b, tol) -> int
    let d = a - b
    if d < 0.0
        d = 0.0 - d
    if d < tol
        return 1
    return 0

fn ckf(label, got, expected, tol)
    if approx(got, expected, tol) == 0
        print("FAIL: " + label + " got=" + str(got) + " expected=" + str(expected))
        exit(1)

fn main()
    let eps = 0.001

    // KAT 1: trapezoid of constant [2,2,2] dx=1 -> 4.0
    // Exact: integral of 2 from 0 to 2 = 4
    let yconst = [2.0, 2.0, 2.0]
    let t1 = integrate.trapezoid(yconst, 1.0)
    ckf("kat1 trapezoid const = 4.0", t1, 4.0, eps)

    // KAT 2: trapezoid of x^2 at x=0,0.25,0.5,0.75,1.0 dx=0.25
    // y values: [0, 0.0625, 0.25, 0.5625, 1.0]
    // Exact = 1/3; trapezoidal error for x^2 with h=0.25 is ~0.0104
    // Actual value = 0.34375; tolerance 0.015 covers the known trapezoidal bias
    let yquad = [0.0, 0.0625, 0.25, 0.5625, 1.0]
    let t2 = integrate.trapezoid(yquad, 0.25)
    ckf("kat2 trapezoid x^2 ~0.34375", t2, 0.34375, 0.0001)

    // KAT 3: simpson of x^2 at x=0,0.25,0.5,0.75,1.0 dx=0.25
    // Exact = 1/3 = 0.3333; Simpson's rule is exact for degree <= 3
    let yq3 = [0.0, 0.0625, 0.25, 0.5625, 1.0]
    let s3 = integrate.simpson(yq3, 0.25)
    ckf("kat3 simpson x^2 = 0.3333", s3, 0.3333, eps)

    // KAT 4: trapezoid of linear [0,1,2,3,4] dx=1 -> exact integral of x from 0..4 = 8
    let ylin = [0.0, 1.0, 2.0, 3.0, 4.0]
    let t4 = integrate.trapezoid(ylin, 1.0)
    ckf("kat4 trapezoid linear = 8.0", t4, 8.0, eps)

    // KAT 5: simpson of linear [0,1,2,3,4] dx=1 -> exact = 8.0 (Simpson exact on linear)
    let ylin5 = [0.0, 1.0, 2.0, 3.0, 4.0]
    let s5 = integrate.simpson(ylin5, 1.0)
    ckf("kat5 simpson linear = 8.0", s5, 8.0, eps)

    // KAT 6: two-point trapezoid (minimal case)
    // [0, 1] dx=1 -> 0.5
    let ytwo = [0.0, 1.0]
    let t6 = integrate.trapezoid(ytwo, 1.0)
    ckf("kat6 trapezoid 2pts = 0.5", t6, 0.5, eps)

    // KAT 7: simpson of [0,1] dx=1 -> 0.5 (fallback to trapezoid)
    let ytwo7 = [0.0, 1.0]
    let s7 = integrate.simpson(ytwo7, 1.0)
    ckf("kat7 simpson 2pts = 0.5", s7, 0.5, eps)

    // KAT 8: simpson of sin sampled at 5 points over [0, pi]
    // x = 0, pi/4, pi/2, 3pi/4, pi
    // y = sin(0), sin(pi/4), sin(pi/2), sin(3pi/4), sin(pi)
    //   = 0, 0.70711, 1.0, 0.70711, 0.0 (approx)
    // dx = pi/4 ~ 0.7854; integral sin on [0,pi] = 2.0 exactly
    let ysin = [0.0, 0.70711, 1.0, 0.70711, 0.0]
    let pi_over_4 = 0.7854
    let s8 = integrate.simpson(ysin, pi_over_4)
    ckf("kat8 simpson sin [0,pi] ~ 2.0", s8, 2.0, 0.006)

    print("PASS _integrate_test")
