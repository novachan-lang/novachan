import forge_inbox_outbox

fn main()
    let io = io_new()
    io = io_add(io, "m1", "orders", "order-created")
    io = io_add(io, "m2", "notifications", "email-queued")
    io = io_add(io, "m3", "analytics", "event-tracked")
    assert(io_total_count(io) == 3, "3 messages")
    assert(io_pending_count(io) == 3, "3 pending")

    io = io_relay_next(io)
    assert(io_sent_count(io) == 1, "1 sent")
    assert(io_pending_count(io) == 2, "2 pending")

    io = io_relay_next(io)
    assert(io_sent_count(io) == 2, "2 sent")

    io = io_relay_fail(io, "m3")
    assert(io_failed_count(io) == 1, "1 failed")
    let m3 = io_get(io, "m3")
    assert(m3["status"] == "failed", "m3 failed")
    assert(m3["retries"] == 1, "1 retry")

    io = io_retry_failed(io)
    assert(io_pending_count(io) == 1, "1 pending after retry-failed")

    io = io_relay_next(io)
    assert(io_sent_count(io) == 3, "3 sent after re-relay")

    let missing = io_get(io, "nonexistent")
    assert(missing["id"] == "", "missing returns empty")

    print("INBOX-OUTBOX KAT PASS")
