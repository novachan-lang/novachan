import std/poly/polyadd

fn list_eq(a, b) -> bool
    let la = len(a)
    let lb = len(b)
    if la != lb
        return false
    let i = 0
    while i < la
        if a[i] != b[i]
            return false
        i = i + 1
    true

fn ck_list(label, got, want)
    if list_eq(got, want) == false
        let gs = str(len(got))
        let ws = str(len(want))
        print("FAIL polyadd " + label + ": len got=" + gs + " want=" + ws)
        exit(1)

fn ck_int(label, got, want)
    if got != want
        print("FAIL polyadd " + label + ": got=" + str(got) + " want=" + str(want))
        exit(1)

fn ck_bool(label, got, want)
    if got != want
        print("FAIL polyadd " + label + ": bool mismatch")
        exit(1)

fn main()
    // pa_add basic
    let a1 = [1, 2]
    let b1 = [3, 4]
    let r1 = pa_add(a1, b1)
    let w1 = [4, 6]
    ck_list("pa_add [1,2]+[3,4]", r1, w1)

    // pa_add with different lengths
    let a2 = [1, 2, 3]
    let b2 = [1]
    let r2 = pa_add(a2, b2)
    let w2 = [2, 2, 3]
    ck_list("pa_add [1,2,3]+[1]", r2, w2)

    // pa_sub
    let a3 = [5, 5]
    let b3 = [1, 2]
    let r3 = pa_sub(a3, b3)
    let w3 = [4, 3]
    ck_list("pa_sub [5,5]-[1,2]", r3, w3)

    // pa_scale
    let a4 = [1, 2, 3]
    let r4 = pa_scale(a4, 2)
    let w4 = [2, 4, 6]
    ck_list("pa_scale [1,2,3]*2", r4, w4)

    // pa_add to zero (normalization)
    let a5 = [1, 2]
    let b5 = [-1, -2]
    let r5 = pa_add(a5, b5)
    let w5 = []
    ck_list("pa_add to zero normalized", r5, w5)

    // pa_degree
    let p6 = [6, -5, 1]
    let d6 = pa_degree(p6)
    ck_int("pa_degree [6,-5,1]==2", d6, 2)

    let p7 = [5]
    let d7 = pa_degree(p7)
    ck_int("pa_degree [5]==0", d7, 0)

    let p8 = []
    let d8 = pa_degree(p8)
    ck_int("pa_degree []==-1", d8, -1)

    // pa_normalize
    let p9 = [1, 2, 0, 0]
    let r9 = pa_normalize(p9)
    let w9 = [1, 2]
    ck_list("pa_normalize [1,2,0,0]", r9, w9)

    // pa_shift
    let p10 = [1, 1]
    let r10 = pa_shift(p10, 2)
    let w10 = [0, 0, 1, 1]
    ck_list("pa_shift [1,1] by 2", r10, w10)

    // pa_neg
    let p11 = [1, -2, 3]
    let r11 = pa_neg(p11)
    let w11 = [-1, 2, -3]
    ck_list("pa_neg [1,-2,3]", r11, w11)

    // pa_is_zero
    let z1 = []
    let iz1 = pa_is_zero(z1)
    ck_bool("pa_is_zero []", iz1, true)
    let z2 = [0, 0]
    let iz2 = pa_is_zero(z2)
    ck_bool("pa_is_zero [0,0]", iz2, true)
    let nz = [0, 1]
    let inz = pa_is_zero(nz)
    ck_bool("pa_is_zero [0,1]", inz, false)

    // pa_equal
    let e1 = [1, 2, 0]
    let e2 = [1, 2]
    let eq = pa_equal(e1, e2)
    ck_bool("pa_equal [1,2,0]==[1,2]", eq, true)
    let neq = pa_equal([1, 2], [1, 3])
    ck_bool("pa_equal [1,2]!=[1,3]", neq, false)

    // pa_leading
    let pl = [3, 0, 5]
    let lc = pa_leading(pl)
    ck_int("pa_leading [3,0,5]==5", lc, 5)
    let lz = pa_leading([])
    ck_int("pa_leading []==0", lz, 0)

    // pa_zero
    let pz = pa_zero()
    let pzl = len(pz)
    ck_int("pa_zero len==0", pzl, 0)

    // pa_constant
    let pc = pa_constant(7)
    let pcl = len(pc)
    ck_int("pa_constant(7) len==1", pcl, 1)
    if pc[0] != 7
        print("FAIL polyadd pa_constant(7) val")
        exit(1)
    let pc0 = pa_constant(0)
    let pc0l = len(pc0)
    ck_int("pa_constant(0) len==0", pc0l, 0)

    // pa_shift zero polynomial
    let psh0 = pa_shift([], 3)
    let psh0l = len(psh0)
    ck_int("pa_shift [] by 3 == []", psh0l, 0)

    // pa_sub resulting in zero
    let ps1 = [1, 1, 1]
    let ps2 = [1, 1, 1]
    let rs = pa_sub(ps1, ps2)
    ck_bool("pa_sub identical == zero", pa_is_zero(rs), true)

    print("PASS _polyadd_test")
